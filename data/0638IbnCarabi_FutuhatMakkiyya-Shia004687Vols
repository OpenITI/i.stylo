ة فيظهر بها من له هذا القبول من المخلوقين كالارواح والمتروحنين من الاناسي كقضيب البان وشبهه يقول الله تعالي في اي صورة ما شاء ركبك فسواه وعدله علي مزاج يقبل كل صورة اذا شاء الحق وجعل التركيب لله لا له وفي نسبة الصور لله يقال في اي صورة شاء ظهر من غير جعل جاعل فلا يلتبس عليك الامر في ذلك ولما لم يكن له تعالي ظهور الي خلقه الا في صورة وصوره مختلفة في كل تجل لا تتكرر صورة فانه سبحانه لا يتجلي في صورة مرتين ولا في صورة واحدة لشخصين ولما كان الامر كذلك لم ينضبط للعقل ولا للعين ما هو الامر عليه ولا يمكن للعقل تقييده بصورة ما من تلك الصور فانه ينتقض له ذلك التقييد في التجلي الاخر بالصورة الاخري وهو الله في ذلك كله لا يشك ولا يرتاب الا اذا تجلي له في غير معتقده فانه يتعوذ منه كما ورد في صحيح الاخبار فيعلم ان ثم في نفس الامر عينا تقبل الظهور في هذه الصور المختلفة لا يعرف لها ماهية اصلا ولا كيفية واذا حكم ولا بد بكيفية فيقول الكيفية ظهورها فيما شاء من الصور فتكون الصور مشاءة وكل مشاء معدوم بلا شك فما ظهر لك الا حادث في عين قديم فما رايت الا حادثا مثلك لانك ما رايت الا صورة يقيدها نظرك ببصر هو الحق في عين هو الحق اعني في العين التي ظهرت في تلك الصورة فهو مدرك عينا في الاخرة والنوم وعلما وشرعا وغير مدرك علما ولا نشك ايمانا وكشفا لا عقلا ان بهويته ادرك المدرك جميع ما يدرك سواء ادرك جميع ما يدرك او بعضه علي اي حالة يكون استعداد المدرك اسم مفعول فالبصر من المدرك اسم فاعل هوية الحق لا بد من ذلك وهكذا جميع ما ينسب الي هذه الالات من القوي ما هي سوي هوية الحق اذ يستحيل خلاف ذلك فالالات ومحلها احكام اعيان الممكنات في عين الوجود الحق وهو لها كالروح للصورة التي لا يمسك عليها ذلك النظام الا هو ولا تدرك تلك الصورة شيءا الا به حسا وخيالا والكل بحمد الله خيال في نفس الامر لانه لا ثبات لها داءما علي حال واحدة والناس نيام وكل ما يراه الناءم قد عرف ما يري وفي اي حضرة يري فاذا ماتوا انتبهوا من هذا النوم في النوم فما برحوا 
 ناءمين فما برحوا في رءيا فما برحوا في انفسهم من هذا التنوع وما برح ما يدركونه في اعينهم من التنوع فلم يزل الامر كذلك ولا يزال الامر في الحياة الدنيا وفي الاخرة هكذا كما اوردناه وذكرناه والله يقول الحق وهو يهدي السبيل (الباب الخامس عشر واربعماءة في معرفة منازلة من دعاني فقد ادي حق عبوديته ومن انصف نفسه فقد انصفني) اذا ما دعوت الله من غير امره * فلست له عبد او ما انصف العبد واصبحت عبدا للحظوظ وما لنا * وفاء ولا عهد وقد ثبت العهد ولولا قيام العبد في عهد ربه * لما صح اوفوا بالعقود ولا وعد وليس سوي التكليف قربا مخصصا * يعينه امر ويثبته عقد وقامت حقوق الحق من كل جانب * علينا ولولا القرب ما عرف البعد فمن انصف الاكوان انصف ربه * وكان له في ذات خالقه الخلد وصح له مجد تليد وطارف * وكان له بين الملاءكة الحمد الا انما العبد الذي لم يزل به * يموت ويحيا والوقوف له حد وما كلف الرحمن نفسا سوي الذي * تقوم به فاجهد فقد ينفع الجهد فمن قام بالرحمن كان له الجد * ومن قام للرحمن كان له الجد وخصص بالايات في عين نفسه * وافاقه فاحمد بما حمد الحمد قال الله تعالي ادعوني استجب لكم وقال ان الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين فوصفهم بانهم لا يخرجون عن العبودية وان الذلة حقيقتهم وهو قوله داخرين فمن لم يرد ان يكون عبدا لي كما هو في نفس الامر فانه سيكون عبد الطبيعة التي هي جهنم ويذل تحت سلطانها كما هو ليس هو في نفس الامر فترك العلم واتصف بالجهل فلو علم لكان عبدا لي وما دعا غيري كما هو في نفس الامر عبد لي احب ام كره وجهل او علم واذا كان عبدا لي بدعاءه اياي ولم يتكبر في نفسه ان يكون عبد الي عند نفسه اعطيته التصريف في الطبيعة فكان سيدا لها وعليها ومصرفا لها ومتصرفا فيها وكانت امته فانظر ما فاته من العز والسلطان من استكبر عن عبادتي ولم يدعني في السراء وكشف الضر تعبدته الاسباب فكان من الجاهلين ومما يءيد ان الحق عين قوي العبد فالتصريف له لان العبد لا تصرفه الا قواه ولا يصرفه الا الحق فقواه عين الحق دليلنا ما قالته الرسل سلام الله عليهم في ذلك فاخبر محمد ص عن الله انه قال كنت سمعه وبصره ويده يعني العبد اذا تقرب اليه بالنوافل حتي يحبه وذكر قواه التي تصرفه ونزل في القران تصديق هذا القول وهو قوله والله خلقكم وما تعملون والعمل ليس لجسم الانسان بما هو جسم وانما العمل فيه لقواه وقد اخبر ان العمل الذي يظهر من الانسان المضاف اليه انه لله خلق فالحق قواه واما موسي فاخذ العالم في ماهية الحق لما دعا فرعون الي الله رب العالمين فقال له فرعون وما رب العالمين يساله عن الماهية فقال له موسي ع رب السماوات والارض وما بينهما ان كنتم موقنين يقول ان استقر في قلوبكم ما يعطيه الدليل والنظر الصحيح من الدال فاخذ موسي ع العالم في التعريف بماهية الحق والرسل عندنا اعلم الخلق بالله فقال فرعون وقد علم ان الحق مع موسي فيما اجابه به الا انه اوهم الحاضرين واستخفهم لان السءال منه انما وقع بما طابقه الحق وهو قوله وما رب العالمين فما ساله الا بذكر العالمين فطابق الجواب السءال فقال فرعون لقومه الا تستمعون اساله عن الماهية فيجيبني بالامور الاضافية فغالطهم وهو ما سال الا عن الرب المضاف فقال له موسي ربكم ورب اباءكم الاولين فخصص الاضافة لدعوي فرعون في قومه انه ربهم الاعلي فقال فرعون ان رسولكم الذي ارسل اليكم لمجنون اي قد ستر عنه عقله لان العاقل لا يسال عن ماهية شء فيجيب بمثل هذا الجواب فقال له موسي لقرينة حال اقتضاها المجلس ما قال ابراهيم ع لنمرود رب المشرق والمغرب وما بينهما ان كنتم تعقلون ولو لم يقل هنا 
 وما بينهما لجاز لانه ليس بينهما شء وذلك لان عين حال الشروق في ذلك الحيز هو عين استواءها هو عين غروبها فكل حركة واحدة منها في حيز واحد شروق واستواء وغروب فما ثم ما ينبغي ان يقال ما بينهما لكنه قال وما بينهما لغموضه علي الحاضرين فانهم لا يعرفون ما فصلناه في اجمال وما بينهما فجاء بالمشرق والمغرب المعروف في العرف ثم قال لهم ان كنتم تعقلون فاحالهم علي النظر العقلي فما عرف الحق الا بنا ولا وجد الخلق الا به فمنه الينا ومنا اليه * فيثني علينا ونثني عليه وكذا ذكر ابراهيم ع الذي ذكر الله عنه انه اتاه الحجة علي قومه وجهت وجهي للذي فطر السماوات والارض فما ذكره الا بالعالم فالعالم ظاهره خلق وباطنه حق ومن حكم باطنه يتصرف وما يءثر في باطنه التصرف الا تصرف في ظاهر من باطن فما تصرف في باطنه الذي هو الحق الا الحق لا غير فتصريفه حكم عليه بالتصريف فالصورة الظاهرة مماثلة للصورة الباطنة حتي ان بعض المتكلمين ذهب في كتابة القران وفي تلاوته المحدثة ان لكل حرف يكتبه الكاتب من القران او يتلوه التالي من القران في ذلك الحرف المنطوق به الحادث او المكتوب حرف مثله هو قديم واضطره الي ذلك كون الحادث لا يستقل في وجوده فلا بد من استصحاب القديم له وهذا مذهب رءيس من رءساء المعتزلة ثم ان هذا القديم ان لم يكن علي صورة ما خرج عنه وظهر وهو الحادث والا فليس هو له ولذلك كان العالم علي صورة الحق وكان الانسان الكامل علي صورة العالم وصورة الحق وهو قوله ان الله خلق ادم علي صورته فليس في الامكان ابدع ولا اكمل من هذا العالم اذ لو كان لكان في الامكان ما هو اكمل من الله فان ادم وهو من العالم قد خلقه الله علي صورته واكمل من صورة الحق فلا يكون وذلك ان ظهور العالم عن الحق ظهور ذاتي فالحق مراة للعالم ظهر فيها صور العالم فرات الممكنات نفسها في مراة الحق الوجود فتوقفت في الوجود عليه وتوقف في العلم به علي العلم بها فلم يكن الا بها * ولم تكن الا به * فما لها من مشبه * وما له من مشبه يا غافلا عن قولنا * فكن بها تكن به فاذا كان الامر كما ذكرناه فمن انصف نفسه واعطاها حقها فانما انصف الحق واعطاه حقه لانه افرد نفسه بما يستحقه وافرد ربه بما يستحقه ومن تميز عن شء فما هو عينه ولا مثله فيما تتميز به عنه لكنه مثله في كونه تميز فافهم والله يقول الحق وهو يهدي السبيل واجعل بالك في كل منظوم في اول كل باب من ابواب هذا الكتاب فانه يتضمن من علوم ذلك الباب علي قدر ما اردت ان انبه فيه عليها تجد في النظم ما ليس في الكلام في ذلك الباب فتزيد علما بما هو عليه ما ذكرته في النظم وعلي الله قصد السبيل (الباب السادس عشر واربعماءة في معرفة منازلة عين القلب) عين القلوب من الوجود الناظر * وعليه سادات الطريق تناظر فانظره في تقليبها متقلبا * ومقلبا فهو الوجود الحاضر ما ثم الا ما يعاين وقته * والماضي والاتي حديث ساءر الظرف في الاكوان ليس بكاءن * ما ثم ثم وثم حكم قاصر هذا هو الحق الذي ظهرت به * اعياننا وانا العليم الخابر لو قلت ما هو لم تسعه عقولكم * اين العقول وليس ثم مغاير قال الله تعالي الذين امنوا وتطمءن قلوبهم بذكر الله الذي ذكرها به الا بذكر الله الذي ذكرها به اذا كانت مءمنة تطمءن القلوب في تقلبها فتسكن الي التقليب مع الانفاس وتعلم ان الثبات علي حال واحدة لا يصح فان صورة الحق لا تعطي الضيق ولا اتساع لها ولا مجال الا في التقليب ولا تقليب للحق الا في اعيان الممكنات واعيان الممكنات لا نهاية لها فالتقليب الالهي فيها لا يتناهي فهو كل يوم في شان حيث كان فما زال الامر مذ كان ولا يزال من حال الي حال فالعين 
 الة وبالبصر يقع الادراك للمبصر وهو الحق فبه تبصر ومن ابصر امرا فقد علمه واذا علمه فقد سكن اليه فابصر التقليب داءما فعلمه داءما فاطمان به وسكن اليه فهو في كل نفس ينظر الي اثار ربه في قلبه فيما يقيمه وفيما خرج عنه ما يعطيه فيه وينبهه به عليه فلا يزال صاحب هذا المقام في كل نفس في علم جديد فهو في خلق جديد وغيره في لبس من هذا الخلق الجديد امر الله تبارك وتعالي نبيه ص ان يقول رب زدني علما اي ارفع عني اللبس الذي يحول بيني وبين العلم بالخلق الجديد فيفوتني خير كثير حصل في الوجود لا اعلمه والحجاب ليس الا التشابه والتماثل ولولا ذلك لما التبس علي احد الخلق الجديد الذي لله في العالم في كل نفس بكل شان وما تنبه لهذا من الطواءف الا القاءلون بتجديد العالم في كل زمان فرد وهم طاءفة يقال لهم الحسبانية ولم يبلغوا فيه مبلغ الامر علي ما هو عليه لكنهم قاربوا كما قارب القاءلون بان العرض لا يبقي زمانين والعرض كل ما لا قيام له بنفسه فهءلاء ايضا قاربوا الامر وما بلغوا فيه ما هو الامر عليه الا القاضي ابو بكر بن الطيب فانه قارب في بعض الامر في موضعين الموضع الواحد قوله في الاكوان انها نسب لا عين لها وقوله فيما نسب الي الحق من صفة ان ذلك الحكم لمعني ما هو عين المعني الاخر الذي اعطي حكما اخر فقارب ايضا ولم يبلغ فيه ما هو الامر عليه وانما تميز عمن يقول ان سمع الحق وبصره عين علمه والباقلاني لا يقول بهذا ورايت بفاس ابا عبد الله الكناني امام اهل الكلام في زمانه بالمغرب وقد سالني يوما في الصفات الالهية فقلت له ما هو الامر عليه عندنا ثم قلت له فما قولك انت فيها هل انت مع المتكلمين او تخالفهم في شء مما ذهبوا اليه فيها فقال لي انا اقول لك ما عندي اما اثبات الزاءد علي الذات المسمي صفة فلا بد منه عندي وعند الجماعة واما كون ذلك الزاءد عينا واحدة لها احكام مختلفة كثيرة او لكل حكم معني زاءد اوجبه ما عندنا دليل علي احديته ولا علي تكثره هذا هو الانصاف عندي في هذه المسالة وكل من تكلف في غير هذا دليلا فهو مدخول والزاءد لا بد منه غير انا نقول ما هو هو ولا هو غيره لما قد علمت يا سيدنا من مذهب اهل هذا الشان في الغيرين فقلت له يا ابا عبد الله اقول لك ما قال رسول الله ص لابي بكر في تعبيره الرءيا اصبت بعضا واخطات بعضا فقال لي لا اتهمك والله فيما تعلمه ولا اقدر ارجع عن الحكم بالزاءد الا ان فتح الله لي بما فتح الله به عليك مع اختلاف اهل النظر فيما ذهبت اليه هذا قوله فتعجبت من انصافه ومن تصميمه مع شهادته علي نفسه انه ما يتهمني وهو يخالفني فاشبه من اضله الله علي علم ولكن لا يقدح ذلك عندي في ايمانه وانما يقدح في عقله ثم نرجع ونقول ان عين القلب ليس الا ما هو الحق عليه في احوال العالم ظاهرا وباطنا واولا واخرا وان تعددت الاسماء فالمسمي واحد والمفهوم ليس بواحد فيحار الداعي اذا دعا ما يدري ما يدعو هل يدعو المسمي او يدعو المفهوم فان الاسماء الالهية ما تعددت جزافا فلا بد من نسب تعقل لتعددها فالمفهوم من العالم ما هو عين المفهوم من الحي والحي هو العالم فالحي عين العالم والمفهوم من الحي ما هو المفهوم من العالم ولا القادر ولا العزيز ولا العالي ولا المتعالي ولا الكبير ولا المتكبر ولم نقل هذا عنه ولا سميته بهذا بل هو سمي لي نفسه بهذا فهل هو اسم له او لما هو المفهوم منه وهل المفهوم منه امر وجودي او نسبة ثم مشاركتنا اياه في هذه الاسماء الواردة الالهية كلها من اعجب ما في الامر ثم رفع المماثلة بيني وبينه فتعلم قطعا ان هذه الاسماء من حيث المفهوم لا ترفع المماثلة فقد حرنا وقد حارا * فمن حار فما جارا * فقد ابعدني عينا * وقد قربني جارا وقد عين لي دارا * وقد عينني دارا * له يسكنها خلدا * فدارنا حيث ما دارا فمن اصغي ومن قال * ومن كسري ومن دارا * مليك ما له ملك * محال حار من حارا ونادي من اتي يبغي * فكانت داره النارا فما عينني دار الا له فبه اسمع وبه ابصر وقد وسعه قلبي وما عين لي دارا الا هو فيه اقيم وبه انزل وهو يسترني بهويته عن خلقه فهو الظاهر وانا مخبوء في كنفه فاذا سمع بالالة او بالنسب فبي يسمع وبي يبصر علي ذلك كما اسمع به وابصر به فهو في بالنوافل فانه الاصل وانا الزاءد فان ظاهر الصورة عيني وانا فيه بالفراءض فبي يسمع وبي يبصر فمن كان سمع الحق فالحق سامع * ومن كان عين الحق فالحق ناظر 
 فيختلف التقليب والعين واحد * علي مثل هذا كل عبد يثابر (الباب السابع عشر واربعماءة في معرفة منازلة من اجره علي الله) ان الرسالة اجرها متحقق * لكن علي الله الذي يستخدمه هذا هو العدل الذي قامت به * اعيان كون لم يزل يستلزمه العفو والصلح الجميل يزيل ما * قد كان من حق علي من يحكمه العفو ان خصصته نزر وعفو * الله كنز عند من يستفهمه قال الله تعالي فمن عفا واصلح فاجره علي الله وقال عز وجل ومن يخرج من بيته مهاجرا الي الله ورسوله ثم يدركه الموت فقد وقع اجره علي الله واخبر الله في كتابه عن كل رسول من رسله ع انه قال لامته وما اسالكم عليه من اجر فيما بلغه عن الله اليهم ان اجري الا علي الله فانه تعالي هو الذي استخدمه في التبليغ فاعلم ان الله تعالي له المنة علي عباده بان هداهم للايمان برسله فوجب عليهم شكر الله وحلاوة الرسول فيضمنها الله عنهم بان جعل اجر رسوله ص وضم في ذلك الاجر ما يجب علي المءمنين من الحلاوة له لما هداهم الله به فانزله ص منزلة من له تضاعف الاجر اجر التبليغ واجر ما قام فيه الحق خليفة عن المءمنين اذ هو الوكيل تعالي عن امره ايانا بقوله فاتخذه وكيلا من غير ان ينقص مما هو للمءمنين شيءا من نعيمهم فاعلم ان اجر التبليغ علي قدر ما ناله في البلاغ من المشقة من المخالفين له من امته التي بعث اليها ولما قاساه ولا يعلم قدر ذلك من كل رسول الا الله ولا يتعين واما الذي يعطيه مما كان ينبغي ان يقابله به المءمنون فهو علي نوعين النوع الواحد علي قدر معرفتهم بمنزلته ممن ارسله اليهم وهو الله فان الله تعالي فضل بعضهم علي بعض والنوع الثاني علي قدر ما جاء به في رسالته مما هو بشري لصاحب تلك الصفة التي من قامت به كان سعيدا عند الله فما كان ينبغي ان يقابله به ذلك الرجل هو الذي يعطيه الحق فان ساوي حال المءمن قدر الرسالة كان وان قصر حاله عما تقتضيه تلك الرسالة من التعظيم فان الله بكرمه لا ينظر الي جهل الجاهل بعظيم قدرها فيوفيه الحق تعالي علي قدر علمه فيها ولا نشك ان الله قد جعل المفاضلة في كل شء والعالي والاعلي وان كان الايمان بالله وبرسوله وبما جاء به عاليا فانه يتفاضل بتفاضل شعبه وابوا به فان الايمان بضع وسبعون شعبة وادناها اماطة الاذي عن الطريق وارفعها قول لا اله الا الله وما بينهما فمن جمع شعب الايمان كلها فجزاء الرسول من الله عن هذا الشخص الجامع علي قدر منازلها عند الله العالم بالعالي منها وبالاعلي فانظر ما للرسول ع من الاجور فاجر التبليغ اجر استحقاق فان رسول الله ص يقول ان احق ما اخذتم عليه اجرا كتاب الله واما من سال من الصحابة عن امر ما من الامور مما لم ينزل فيه قران فنزل فيه قران من اجل سءاله فان للرسول علي ذلك الساءل اجر استحقاق ينوب الله عنه فيه زاءدا علي الاجر الذي له من الله واما من رد رسالته من امته التي بعث اليها فان له عند الله ايضا اجر المصيبة وللمصاب فيما يحب اجر فاجره علي الله ايضا علي عدد من رد ذلك من امته بلغوا ما بلغوا وله من اجر المصاب اجر مصاءب العصاة فانه نوع من انواع الرزايا في حقه فانه ما جاء بامر يطلب العمل به الا والذي يترك العمل به قد عصي فللرسول اجر المصيبة والرزية وهذا كله علي الله الوفاء به لكل رسول (النوع الثاني) ممن اجره علي الله وهو المهاجر يموت قبل وصوله الي المنزل الذي هاجر اليه فان اجره علي الله علي قدر الباعث الذي بعثه علي الهجرة والناس في ذلك متفاضلون ثم ان الله ينوب عن رسوله فيما يعطيه من الاجر فانه خرج مهاجرا الي الله ورسوله ثم ان له اجر الفوت بالموت الذي ادركه وذلك من الله فانه الذي رزاه وحال بينه وبين الوصول الي مهاجره فالدية عليه فان كان هذا الذي يموت عالما عاقلا فاعظم من لقاء الله ورءيته فما يكون وقد حصل له ذلك بالموت فهو افضل في حقه من انه يعيش حتي يصل فانه لا يدري ما دام في الحياة الدنيا ما يتقلب عليه من الاحوال فانه في محل خطر سريع التبديل وص عن رسول الله ص في هذا الباب ما خرجه البخاري عن عمر بن الخطاب رضي الله عنه عن رسول الله ص 
 انه قال انما الاعمال بالنيات وانما لامرء ما نوي فمن كانت هجرته الي الله ورسوله فهجرته الي الله ورسوله ومن كانت هجرته لدنيا يصيبها او امراة يتزوجها فهجرته الي ما هاجر اليه ثم يضاف الي هذه الاجور قدر كرم المعطي وغناه وهذا يدخل تحت قوله ص ان في الجنة ما لا عين رات ولا اذن سمعت ولا خطر علي قلب بشر يعني من المجزيين وتحت قوله وزيادة من قوله للذين احسنوا الحسني وزيادة وهذه الزيادة ما عينها الحق لا حد واكد هذا الاجر علي غيره ممن له اجر علي الله بالوقوع وهو الوجوب فان الاجر قد يقتضيه الكرم من غير وجوب وقد يقتضيه الوجوب والذي يقتضيه الوجوب اعلي كما ان الفراءض اعلي واحب الي الله من النوافل صح في الخبر ان الله تعالي يقول ما نقرب الي احد باحب الي مما افترضته عليه فجعله احب اليه ثم قال ولا يزال العبد يتقرب الي بالنوافل حتي احبه فاذا احببته كنت سمعه وبصره فهذا نتيجة النوافل فما ظنك بنتيجة الفراءض وهي ان يكون العبد سمع الحق وبصره وقد بينا صورة ذلك فيما تقدم فيريد الحق بارادة العبد وهذا المقام ذكرته العرب في حق محمد ص وفي النوافل يريد العبد بارادة الحق ويظهر معني ما ذهبنا اليه في اتصاف الحق بنعوت المخلوق وفي الوجه الاخر اتصاف العبد بصفات الحق وهذا في الشرع موجود (النوع الثالث) ممن اجره علي الله وهو من عفا عمن اساء اليه واصلح يعني حال من اساء اليه بالاحسان فاصلح منه ما كان اوجب الاساءة اليه منه فما اراد هنا باصلح الا هذا ولا يحصل في هذا المقام الا من له همة عالية فان الله قد اباح له ان يجازي المسء باساءته علي وزنها فانف علي نفسه ان يكون محلا للاتصاف بما سماه الحق سيءة نفس الكريم كريمة في كل ما * تجري به الاهواء والاقدار والله يحكم في النفوس بقدرها * وهو الذي من حكمه يختار فيجء ذو اللب المجوز عقله * غير الذي حكمت به فيحار يقول الله تعالي في هذا المقام ادفع بالتي هي احسن يعني قوله واصلح السيءة فاذا الذي بينك وبينه عداوة كانه ولي حميم وما يلقاها يعني هذه الصفة الا الذين صبروا حبسوا انفسهم عن ان يجاز والمسء باساءته اساءة ولو علم الناس قدر ما نبهنا عليه في هذه المسالة ما جازي احد من اساء اليه باساءة فما كنت تري في العالم الا عفوا مصلحا لكن الحجب علي اعين البصاءر كثيفة وليست سوي الاغراض واستعجال التشفي والمءاخذة ولو نظر هذا الناظر لما اساء هو علي الله في رد ما كلفه به وركوبه الخطر في ذلك وامهال الحق له وتجاوزه عنه في هذه الدار حتي يكون هو الذي يكشف نفسه حتي تقام عليه الحدود ويرمي نفسه في المهالك كما قال الصاحب لقد ستر الله عليه لو ستر علي نفسه في المعترف بالزني وان الملاءكة الكتاب لا يكتبون علي العبد من افعاله السيءة الا ما تكلم بها وهو قوله ما يلفظ من قول الا لديه رقيب عتيد وهو الكاتب وان كانوا يعلمون ما تفعلون ما قال يكتبون ثم انه من كرم الله ان الكشف اعطي وقد ورد به خبر ان العبد اذا عمل السيءة قال الملك لصاحبه الذي امره الحق ان يستاذنه في كتاب السيءة ااكتب فيقول له لا تكتب وانظره الي ست ساعات من وقت عمله السيءة فان تاب او استغفر فلا تكتبها وان مرت عليه ست ساعات ولم يستغفر فاكتبها سيءة واحدة ولا نكتبها الا اذا تلفظ بها بان يقول فعلت كذا او تكون السيءة في القول فتكتب بعد مضي هذا القدر من الزمان واي مءمن تمضي عليه ست ساعات لا يستغفر الله فيها فلهذا النوع اجر علي الله من وجهين اجر العفو واجر العفو من الله كثير فانه من الاضداد واجر الاصلاح وهو الاحسان اليه المزيل لما قام به من الموجب للاساءة اليه والله يحب المحسنين ولو لم يكن في احسانه المعبر عنه بالاصلاح الا حصول حب الله اياه الذي لا يعدله شء لكان عظيما فيكون اجر من هذا صفته علي الله اجر محب لمحبوب وكفي بما تعطيه منزلة الحب فما يقدر احد ان يقدر اجر ما يعطيه المحب لمحبوبه فهذا قد اومانا الي من له اجر علي الله باوجز عبارة طلبا للاختصار فان المقام عظيم والمنازلة كبيرة والله يقول الحق وهو يهدي السبيل (الباب الثامن عشر واربعماءة في معرفة منازلة من لم يفهم لا يوصل اليه شء) 
 من يفهم الامر فذاك الذي * خاطبه الرحمن من كل عين وهو الذي دار عليه الوري * وهو الذي في حكمه كل اين ان اياسا خص من باقل * لما حوته حكمة القبضتين قد اوضح الله لنا حكمه * في كل ما في الكون من فرقتين والضد لا يعرفه ضده * والحق معلوم لنا دون مين قد ثبت المثل له وانتفي * عني ذاك المثل من بعد بين قال الله تعالي وقالوا قلوبنا في اكنة مما تدعونا اليه اعلم ان الكلام علي قسمين كلام في مواد تسمي حروفا وهو علي قسمين اما مرقومة اعني الحروف وتسمي كتابا او متلفظا بها وتسمي قولا وكلاما والنوع الثاني كلام ليس في مواد فذاك الكلام الذي لا يكون في مواد يعلم ولا يقال فيه يفهم فيتعلق به العلم من السامع الذي لا يسمع بالة بل يسمع بحق مجرد عن الالة كما اذا كان الكلام في غير مادة فلا يسمع الا بما يناسبه والذي في المادة يتعلق به الفهم وهو تعلق خاص في العلم فاذا علم السامع اللفظة من اللافظ بها او يري الكتابة فان علم مراد المتكلم في تلك الكلمة مع تضمنها في الاصطلاح معاني كثيرة خلاف مراد المتكلم بها فذلك الفهم وان لم يعلم مراد المتكلم من تلك الكلمة علي التفصيل واحتمل عنده فيها وجوه كثيرة مما تدل عليه تلك الكلمة ولا يعلم علي التعيين مراد المتكلم من تلك الوجوه ولاهل ارادها كلها او اراد وجها واحدا او ما كان فمع هذا العلم بمدلول تلك الكلمة لا يقال فيه انه اعطي الفهم فيها وانما اعطي العلم بمدلولاتها كلها لعلمه بالاصطلاح لان المتكلم بها عند السامع الغالب عليه امران الواحد القصور عن معرفة مدلولات تلك الكلمة في اللسان والامر الاخر انه وان عرف جميع مدلولاتها فانه لا يتكلم بها الا لمعني تقتضيه قرينة الحال فالذي يفهم مراده بها فذلك الذي اوتي الفهم فيها ومن لم يعلم ذلك فما فهم فكان المتكلم ما اوصل اليه شيءا في كلامه ذلك واما كلام الله اذا نزل بلسان قوم فاختلف اهل ذلك اللسان في الفهم عن الله ما اراده بتلك الكلمة او الكلمات مع اختلاف مدلولاتها فكل واحد منهم وان اختلفوا فقد فهم عن الله ما اراده فانه عالم بجميع الوجوه تعالي وما من وجه الا وهو مقصود لله تعالي بالنسبة الي هذا الشخص المعين ما لم يخرج من اللسان فان خرج من اللسان فلا فهم ولا علم وكذلك اصحاب الاخذ بالاشارات فان ادراكهم لذلك في باب الاشارات في كلام الله تعالي خاصة فهم فيه لانه مقصود لله تعالي في حق هذا المشار اليه بذلك الكلام وكلام المخلوق ما له هذه المنزلة فمن اوتي الفهم عن الله من كل وجه فقد اوتي الحكمة وفصل الخطاب وهو تفصيل الوجوه والمرادات في تلك الكلمة ومن اوتي الحكمة فقد اوتي خيرا كثيرا فكثره لما فيها من الوجوه فمن كان قلبه في كن او كان عليه قفل او كان اعمي البصيرة او كان صاديا او كان علي قلبه ران فان الله قد حال بينه وبين الفهم عن الله تعالي وان تاوله ولهذا يتخذ ايات الله هزوا ودينه لهوا ولعبا لعدم فهمه عن الله ما خاطب به عباده فلهذا قال من لم يفهم لم يوصل اليه شء فاما الران فهو صدا وطخا وليس الا ما تجلي في مراة القلب من صور ما لم يدع الله الي رءيتها وجلاءها من ذلك بالذكر والتلاوة واما الكن فهو كالمقصورات في الخيام فهو في بيت الطبيعة مشغول بامه ما عنده خبر بابيه الذي هو روح الله فلا يزال في ظلمة الكن وهي حجاب الطبيعة فهو في حجابين كن وظلمة فهو يسمع ولا يفهم كما قال الله فيهم ولا تكونوا كالذين قالوا سمعنا وهم لا يسمعون اي لا يفهمون واما ان يكون في اذنيه وقر او صمم فان كان وقر فهو ثقل الاسباب الدنياوية التي تصرفه عن الاخرة وان كان طخا فهو قساوة قلبه ان يءثر فيه قبول ما يخطر له حديث النفس من النظر والاصغاء الي هذا الداعي الذي هو الشارع وهو قوله تعالي والغوا فيه لعلكم تغلبون حتي لا يسمعوا دعاء فلا يرجعون ولا يعقلون لانه بلسانهم خاطبهم صم بكم عمي فهم لا يرجعون صم بكم عمي فهم لا يعقلون فاصمهم الله واعمي ابصارهم وختم علي السنتهم فما تلفظوا بما دعاهم اليه ان يتلفظوا به واما القفل فهو لاهل الاعتذار يوم القيامة يقولون نحن ما قفلنا علي قلوبنا وانما وجدناها مقفلا عليها وهذا من الجدال الذي قال الله عنهم فيه 
