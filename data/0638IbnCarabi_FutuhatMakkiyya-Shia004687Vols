 لتعين الشكر ولو تعين الشكر لزال المكر فلا بذل فلا فضل فمن شكر مكر لذا قرن الله الزيادة بالشكر لما فيها من المكر فناط به الزيادة وخاطب بذلك عباده فقال ولءن شكرتم لازيدنكم ولءن كفرتم ان عذابي لشديد وما قال لانقصنكم فاشكر للمزيد في حق الحق والعبيد فاذا شكر الحق زاد العبد في عمله واذا شكر العبد زاده الحق فوق امله بقول الله يخاطب عباده للذين احسنوا الحسني وزيادة وهي جزاء الشكر فلا تامن المكر ومن ذلك الغرام اصطلام من الباب  نار المحبة لا تخمد ودمعها لا تنفد وقلقه لا يبعد وحرقه لا يبعد في التراب ينام وان كان صاحب اصطلام فان الغرام رغام الذلة بالمحب صاحب الغرام منوطة والمسكنة به مشروطه ونفسه ابدا مقبوضة غير مبسوطة وعقده براحات الاماني انشوطه يسرع اليها الانحلال وهي وان كانت مقيمة في زوال فهي كالظل اذا فاء وكالقاصر المشية اذا شاء الاصطلام نار لها اضطرام تشعلها الاهواء الا انه تطفءها بتواليها الانواء فتلحقها بالرغام فلذلك حكمنا بالاصطلام علي المنعوت بين المحبين بالغرام ومن ذلك الراغب طالب من الباب  كم بين الرغبة عنه والرغبة فيه عبد مصطفي وعبد لا يصطفيه عناية ازلية بسعادة ابدية وخذلان سبق وكل ذلك حق احق ما قال العبد وكلنا لك عبد فجمع بين المطرود والمجتبي ومن اطاع ومن ابي في عبودية القصاص لا في عبودة الاختصاص عبد يصلح الله بينه وبين خصمه فيسعده وعبد يامر به الي النار بعد له وحكمه فيبعده مع القول بعدم الاستحقاق ومفارقة الوفاق وكلاهما عاصيان وما هما سيان يا ليت شعري لم كان ذلك عاص ناج وعاص هالك عبدان لمالك واحد وما ثم امر زاءد ان كان لعمارة الدار فلما ذا يخرج بالشفاعة ولا يبقي مع الجماعة ما ذاك الا لما قيل في بعض الاشعار ماء ونار ما التقيا الا لامر كبار ومن ذلك قول العلام لا رهبانية في الاسلام من الباب الاحد والاربعين وماءتين الراهب يترك بحكم الحق وما انقطع اليه ولم يكفره بل سلم له ما هو عليه ما ذاك الا لانفراده وانتزاحه عن عباده فانبانا هذا الدليل الواضح ان التكليف شرع للمصالح فلو دخل مع الجماعة في العمل لا لحقه في الحكم ممن اسر وقتل فلا تتعرضوا لاصحاب الصوامع فان نفوسهم سوامع تري اعينهم عند السمع تفيض من الدمع ما لهم علم بما هم عليه الناس من الالتباس تجنبوا الحيف وتدرعوا بالخوف وتركوا نجدا واستوطنوا الخيف لمعرفتهم ضعفهم وعدم قوتهم فاختاروا السهل من الارض وقالوا هذا هو الفرض فان الحق امر في الدين بالرفق فمن رفق بنفسه فقد وفاها ما عين الحق لها وما جار عليها وما خذلها فمن رهب سلم وما عطب ومن ذلك التوصل توسل من الباب  الفضيلة عند من ابتغي الي الله الوسيلة في التعمل وان لم يعمل تحصيل ما لديه مع كونه ما وصل اليه ما تحصل نتيجة العمل لمن لم يعمل الا لمن اجتهد ولم يكسل واما مع الكسل فما وصل ولا توصل ابذل المجهود وما عليك ان لا تتصف بالوجود انت الواجد وان لم تعرف عند الذاءق المنصف لما لم يعمل جهل الميزان فجهل ما وجده لعدم معرفة الاوزان وما علم ما حصل له بذل المجهود من الوجود فهو علم ذوق لا يءكل الا من فوق ولو اكل من تحت رجله لوزنه من العمل بمثله فعلم قدره وعرف امره فالتعمل من اقامة الكتب وبه تحصل الرتب ومن ذلك الوجد فقد من الباب  الوجد فجاة فتح الباب فان كان عن تواجد فهو حجاب من لم يجد لم يجد لا بل من لم يجد لم يجد دليل الكرم البذل وبرهان العدل اعطاء الفضل وهو الاتم عند اصحاب الهمم فما اعطي الله الا الفضل الذي قال فيه وابتغوا من فضل الله ولهذه الاثار استحال عليه الايثار فعطاء الله كله فضل وهو اعلي البذل من اثر علي نفسه فهو الخاسر وان نجا فانه ترك الاولي عند ما وقع اليه الالتجاء لو كان مءمنا لعلم انه قد باع نفسه من الله والمبيوع لمن اشتراه وحق الله احق من حق الخلق لكن الدعوي اوقعته في هذه البلوي فسمي مءثرا وميز مءثرا والجار احق بصقبه والصدقة مضاعفة في رحمه ونسبه ومن ذلك من شهد وجد من الباب  ما حصل علي الوجود الا من زهد في الموجود من راي للكون عينا مستقلة فهو صاحب علة وليس بصاحب نحلة ما قال بالعلل الا القاءل بان العالم لم يزل فاني للعالم بالقدم وما له في الوجوب النفسي الوجودي قدم انما له الرتبة الثانية وهي الباقية الفانية 
 لو ثبت للعالم القدم لاستحال عليه العدم والعدم ممكن بل واقع عند العالم الجامع لكن اكثر العبيد في لبس من خلق جديد فما عرف تجدد الاعيان الا اهل الحسبان واثبت ذلك الاشعري في العرض وتخيل الفيلسوف فيه انه صاحب مرض فجهله بسواد الزنجي وصفرة الذهب وذهب به مثل هذا المذهب ومن ذلك من عنت فقد وقت من الباب  الوقت سيف ومنه الخوف كل الخوف زمانك حالك وفي اقامتك ارتحالك فسيرك يا هذا كسير سفينة * بقوم قعود والقلاع تطير المسافر بمركبه جاهل بمذهبه رحله ريح بالمكان الفسيح راسه في الماء ورجلاه في الهواء فمشيه مقلوب وهو المطلوب لولا قلبه ما مشي ولولا قلبه ما وشي الا لراحة قلبه وما علم ما احتقبه من ذنبه لو كتم العبد سرا ما قيل له لقد جءت شيءا امرا ولا جءت شيءا نكرا ولا اقام لذلك عذرا حتي قال ذلك تاويل ما لم تستطع عليه صبرا فلو ترك السر مخزونا ما كان الكليم مفتونا ان هي الا فتنتك عن ذوق مع شدة الشوق ومن ذلك لا تهب لما تغلب من الباب  من هابك غلبته ومن استضعفك قويته الهيبة خيبه ولا تكون الا مع الغيبة الظهور للحضور ما طاب من هاب ومن هاب لم يلتذ بوصال الاحباب بل هو في عذاب جمعه كفرقه وحقه في حقه لا تهاب خوفا من الذهاب لو كان للمهابة حكم ما تجلي ولا رءي عبد باسماءه تحلي ولا قيل في عبد انه بربه تخلي ولا دنا ولا تدلي ولا نزل الي قوله فاعرض عمن تولي ما ثم سوي عينك فلا تكن جاهلا بكونك لا تغلوا في دينكم ولا تقولوا علي الله الا الحق فقد الحق الخلق بالحق قال اين هذا التعالي وما ثم اعلي من الله المتعالي فالنزول علو والبعد دنو ومن ذلك الانس في الياس من الباب  العذاب الحاضر تعلق الخاطر من يءس استراح وحرج من القيد وراح الانس بالمشاكل والمشاكل مماثل والمثل ضد والضدية بعد والانس بالقرب فما ثم انس ليس في الانس خير لما فيه من اثبات الغير من انس بنفسه فقد جعلها اجنبية وهذا غاية النفس الابية ومن تغرب عن نفسه جهل في جنسه واستوحش في انسه الانس بالانس لا يكون الا لمغبون والكتاب المكنون لا يمسه الا المطهرون وما ثم الا الجنة وهم منا في اجنة فهم اهل الكمون وعما نالهم كالبطون هو اعلم لكم اذ انشاكم من الارض بابيكم واذ انتم اجنة في بطون امهاتكم ببنيكم فاين التزكية مع هذه التخلية ومن ذلك من جل مل من الباب  الاستبلال لا يرد الا علي الاعتلال ومن قال بالحلول فهو معلول وهو مرض لا دواء لداءه ولا طبيب يسعي في شفاءه مريض الكون اذا بل اعل فان الحدوث له لازم به وقاءم فمرضه داءم لا يزال علي فراشه ملقي ومن سهام نواءب زمانه غير موقي فلا يزال غرضا ماءلا وهدفا ناءلا فهو الصحيح العليل والكثيب المهيل علته صحيحه والسن عباراتها بالحال عنها فصيحة فان كان الحق قواه فقد برء من علته وقواه فان الحق سمعه فانجبر صدعه وانه بصره فقد نفذ نظره وانه لسانه فقد فهم بيانه وانه رجله فقد استقام ميلة وانه يده فما يطلب من يعضده فمن عرف هذه النحل فقد برء من جميع العلل فالله شفاءه وهو داءه فالمتكبر مقصوم ومن كان الحق صفته فهو معصوم ومن ذلك من تجمل استعمل من الباب  المتجمل مءتمن ولهذا يغتبن يظهر الجمال وان كان كاسف البال التجمل مروة ولا يكون الا من اهل الفتوة من الحق البنوة بالنبوة فقد ضاعف الله سموه العلو زيادة في الواجب في اصح المذاهب الهيبة من اثار الجمال علي كل حال الجمال محبوب وهو اعز مصحوب من صحبه الجمال لم يزل في اعتلال من زاد شهوده في غلته زاد في علته ان الله جميل يحب الجمال فلا تضربوا لله الامثال وانما ضرب الله تعالي لنفسه الامثال لانه يعلم ونحن لا نعلم ومن اعلمه الله فليكتم لءلا يجرا فياثم فاستعذ بالله من المغرم والماثم كما استعاذ به من ثم ومن ذلك ما مال من اتصف بالكمال من الباب  الكمال في البرزخ وهو المقام الاشمخ لو مال ما اتصف بالاعتدال مرج البحرين بينهما برزخ لا يبغيان ومن البغي ما هو طغيان من بغي طغي من بغي عليه لينصرنه الله ولو بعد حين فاعبد ربك حتي ياتيك اليقين فاذا اتاك جاء النصر فترمي الباغي بشرر كالقصر كانها جمالات صفر فتخرج من المكان الاضيق الي المنزل الافيح والشذي الاعطر الافوح فعطر النادي ذلك الشذا 
 وقال المنادي من ذا فقال هذا الذي بغي عليه قد نزل الحق اليه فاكرمه بنزوله وشرف محله بحلوله فوسعه وقد ضاق عنه المتسع وكان الفضاء الاوسع فعلمنا من خفي حكمته ان قلب المءمن اوسع من رحمته مع انه من الاشياء التي وسعته ومن الامور التي جمعته فما وسعه الا بها وكماله بسببها ومن ذلك من طاب غاب من الباب الاحد والخمسين وماءتين  من سمع طاب ومن طاب غاب والغاءب اءب فانه في اوبته الي ربه ذاهب فانه تركه في الاهل خليفة شفقة عليهم وحذر او خيفة وما خاف عليهم الا منه لانه ما يصدر شء الا عنه اذا كان السيد راعي الغنم فما جار وما ظلم وما ينال منها الا ما يقوته وقوته ما يفوته قوته اثار اسماءه في عباده وبها عمارة بلاده فحراثة وزراعة وتجارة وبضاعة لذلك وصف باليدين واظهر في الكون النجدين فالواحدة باءعة والاخري مبتاعة الي قيام الساعة ولكل يد طريق هذا هو التحقيق فان حكم المشتري ما هو حكم الباءع وهذا ما لا شك فيه من غير مانع ولا منازع اءبون تاءبون وهو التواب واليه الماب ومن ذلك من حضر نظر من الباب  الحضور اين وما ثم سوي عين عين لا يحصرها ظرف ولا يسعها حرف نزل لها بذاتها عليها وما يخرج منها وينزل يعرج اليها وهذه عبارات تطلب الاينية وتثبت البينية وهذا هو بعينه اعتقاد الثنوية وانت تقول الامر واحد وقد كذبك الشاهد فالعروج والنزول يطلب الطريق وليس هذا في الالهيات منهج التحقق وقد ورد فلا بد من معرفة ما قصد فان القول الالهي حق وكلامه صدق ولا بد من اذن واعية لهذه الداعية وما خاطب بها الا الحاضر فهو الناظر فان كان السامع غير القاءل فلا بد ان يصيب ويخطء وان كان عين القاءل فصوابه يسرع ولا يبطء بل كلامه عين جوابه فهو المتكلم السامع في احبابه ومن ذلك من فكر سكر من الباب  الفكرة سكرة الا ان شرابها ممزوج وخلقها مخدوج وليس الخداج الا من المزاج وهذا شراب الابرار ومعاطاة الفجار عينا يشرب بها عباد الله يفجرونها تفجيرا وتفجيرهم اياها عين المزاج لمن كان بما قلته خبيرا فلو جرت من غير تفجير من كونه علي كل شء قدير لكان شراب المقربين الاتي من تسنيم علي البار المنعم بالتنعيم فبين المقرب والبار ما بين الاعين والاثار الاثار تدل والعين تشهد ولا نمل الباب قد فتح والواهب قد منح والامر قد شرح فظهرت خفايا الامور في شرح الصدور انشرحت معانيها وهي ما حصل الحق فيها فلاحت المخبات عند رفع الكلل وهي ما ظهر في العالم من النحل في الاعتقادات والملل فانظر واستر ومن ذلك من نحا صحا من الباب  لا يزهد في فكرته الا من صحا من سكرته ما كل شراب مسكر ولا كل قول منكر وما كل مزاج يشكر ولا كل سامع ينكر الانكار من ضيق العطن فكن اللبيب الفطن وسع كل شء علما وضع لكل نازلة حكما فان الله كذا شرع فاتبع فقد اصاب من اتبع من تاسي بالحق اصاب علي انه مصاب حيث راه غير او اعتقد شرا وخيرا فتلي فرقانا لا قرانا فمن قرا استبرا ومن تلا الفرقان فهو صاحب نظر في برهان فلا بد من الحيرة لانه اثبت غيره ومن هنا اتصف من اتصف بالغيرة ان تتقوا الله يجعل لكم فرقانا يخاطب مءمنا وايمانا ما ايه الا بالمءمن والناس والمءتين ما ايه باصحاب العين انتهي السفر الرابع والثلاثون يتلوه الخامس والثلاثون ومن ذلك من جاء من فوق فهو صاحب ذوق من الباب  هو القاهر فوق عباده حكم عرشه في مهاده فلا يعرف علم الفوق الا بالذوق وهو لمن اقام الكتب وميز الرتب واما من اقامها وما ميز اعلامها اكل من تحت رجله مما تيقن انه من رجله وهذا حال الورعين المطيعين ياكلون من كسب ايديهم ولهذا لا يكتسبون من العلم الا ما سمعوه في ناديهم فيعلم بعضهم بعضا ويقرضون الله قرضا وهءلاء اتباع الرسل واصحاب السبل واما الرسل فهم اصحاب الاطواق ولهم الاذواق فهم علي بصيرة ومن اتبعهم مثلهم في دعواهم فهم علي احسن سيرة فهم في جنات ونهر اي في ستر وسعة لما عندهم من الدعة في مقعد صدق عند مليك مقتدر في حضرة منيعة لا يصل اليها 
