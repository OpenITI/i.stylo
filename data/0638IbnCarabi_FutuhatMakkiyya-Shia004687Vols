 يتعين والاحوال كلها تطلبه والازمان وفيه علم ما يقع به الاكتفاء من الثناء فلا يقبل المزيد وفيه علم حكم الكثير حكم الواحد عند الواحد واستناد الكثير الي الكثير واستناد الكثير الي الواحد وفيه علم التناكح للتناسل ولغير التناسل وما هو الاعلي منهما وفيه علم ما يشترك فيه الحق والباطل وليس ذلك الا في الخيال وفيه علم ما هو علم وليس بعلم والله يقول الحق وهو يهدي السبيل (الباب الرابع والخمسون وثلاثماءة في معرفة المنزل الاقصي السرياني وهو من الحضرة المحمدية) معدن الايات في العجم * وجماع الخير في الكلم فطرة الرحمن تطلبني * بصنوف الحكم والحكم فلتكن في راس مرقبة * كشهاب لاح في علم فهو المزجي سحاءبه * في غمام النور والظلم واتبع ما انت طالبه * وارتفع عن موضع التهم هذي وصية صدرت * من حديد الطرف غير عم اعلم ايدك الله بروح منه ان التنزيه في العبد نظير التنزيه في الحق سواء فمن نزه الحق عند اداء ما اوجب الله عليه من العبادات في العهد الذي اخذه عليه عقلا وشرعا اشرك الله نفسه مع عبده في هذا الحكم بما اوجبه علي نفسه له بما كتبه علي نفسه من الرحمة به والوفاء بعهده وبراه عن اداء ما اوجب عليه بان كشف له عن قيام الحق عنه فيما كلفه من العمل الذي كان اهل الحجاب ينسبونه اليه ويقولون ان فلانا من الذين يوفون بعهد الله ولا ينقضون الميثاق فبراه الله مما قالوا وكان عند الله لهذه البراءة وجيها فقالوا عند هذا الشهود بنور الايمان لا فاعل الا الله فقالوا قولا سديدا وبمثل هذا القول امر الله عباده المءمنين ان يقولوه فاذا قالوه اصلح لهم اعمالهم وغفر لهم ذنوبهم ومن يطع الله 
 ورسوله فقد فاز فوزا عظيما فالسعيد من حال الله بينه وبين ربوبيته واقامه عبدا في جميع احيانه يخاف ويرجو ايمانا ولا يخاف ولا يرجي عيانا انما العبد من يخاف ويرجو * ليس بالعبد من يخاف ويرجي ولهذا من كل سوء يوقي * ولهذا عن كل فعل يزجي فتراه بكل وجه سعيدا * واذا زل بالقضاء ينجي يحشر العبد في الوفود اليه * واذا لم يكن بعبد فيرجي فاذا ما نجا الذي يتقيه * فالذي قام في المعارف انجي كل من تدرك الحقاءق منه * ما لديه مما لها فمنجي اعلم ايدك الله ان العالم عند الله من علم علم الظاهر والباطن ومن لم يجمع بينهما فليس بعالم خصوصي ولا مصطفي وسبب ذلك ان حقيقة العلم تمنع صاحبها ان يقوم في احواله بما يخالف علمه فكل من ادعي علما وعمل بخلافه في الحال الذي يجب عليه عقلا وشرعا العمل به فليس بعالم ولا ظاهر بصورة عالم ولا تغالط نفسك فان وبال ذلك ما يعود علي احد الا عليك فان قلت قد نجد من يعلم ولا يرزق التوفيق للعمل بعلمه فقد يكون العلم ولا عمل قلنا هذا غلط من القاءل به لتعلم ان مسمي العلم ينطلق اسمه علي ما هو علم وما ليس بعلم فان الله تعالي يقول فاعرض عمن تولي عن ذكرنا ولم يرد الا الحياة الدنيا ذلك مبلغهم من العلم فاعلمنا انهم عملوا بما علموا ولكن لا اريد بالعلم الا ما حصل عن مشاهدة المعلوم فان حصل عن دليل فكري فليس بعلم حقيقي وان كان في نفس الامر علما كما قال النبي ص حين ذكر سورة في القران ولم يسمها ليختبر اصحابه فوقع في نفس بعض اصحابه انها ربما تكون الفاتحة فاخبر النبي ص انها الفاتحة ولم تقع للصاحب علي جهة القطع فقال له رسول الله ص حين اخبره بما وقع له ليهنك العلم فهو علم في نفس الامر لا عند هذا الصاحب الذي وقع له ذلك فلما كان هذا كذلك ذهب من ذهب الي القول بالعمل بخلاف العلم مع وجود العلم والصحيح اذا اختبرته وبحثت عليه وجدت الحق فيما ذهبنا اليه ولهذا قال رسول الله ص لمن فهم عنه ان الله اذا اراد مضاء قضاءه وقدره سلب ذوي العقول عقولهم حتي اذا امضي فيهم قضاءه وقدره ردها عليهم ليعتبروا وليس سوي ذهاب العلم عنهم والاعتبار عمل اوجبه العلم فهذا عين ما ذهبنا اليه قال تعالي في حق قوم يعلمون ظاهرا من الحياة الدنيا فعملوا بما علموا وهم عن الاخرة هم غافلون فلم يعملوا لها فانه اغفلهم عنها فنسوا اخرتهم فتركوا العمل لها ان في ذلك لذكري لمن كان له قلب او القي السمع وهو شهيد قال تعالي امرا وذكر يعني بالعلم من غفل عنه او نسيه فان الذكري تنفع المءمنين وهم الذين علموا ما ثم بنور الايمان كشفا ثم انهم غفلوا فحيل بينهم وبين ما علموه من ذلك وكان المشهود لهم ما كانوا به عالمين في وقت نسيانهم فاذا ذكروا تذكروا وقام لهم شهود ما قد كانوا علموه فنفعتهم الذكري فعملوا بما علموا فشهد الله ان الذكري تنفع المءمنين فاذا رايت من يدعي الايمان ويذكر فلا يقع له نفع بما ذكر به علمت انه في الحال ليس بعالم بما امن به فليس بمءمن اصلا فان شهادة الله حق وهو صادق وقد اعلمنا ان المءمن ينتفع بالذكري وشهدنا ان هذا لم ينتفع بالذكري فلا بد ان نزيل عنه الايمان تصديقا لله ولا معني للنفع الا وجود العمل منه بما علم وما نري احدا يتوقف بالعمل فيما يزعم انه عالم به الا وفي نفسه احتمال ومن قام له في شء احتمال فليس بعالم به ولا بمءمن بمن اخبره بذلك ايمانا يوجب له العلم مع انك لو سالته لقال لك ما نشك في ان ما جاء به هذا الشخص حق يعني الرسول ع وانا به مءمن فهذا قول ليس بصحيح الا في وقت دعواه عند بعض الناس ثم اذا خلي بفكره قام معه الاحتمال فكان ذلك الذي تخيل انه علم امر عرض له وبعضهم لا يزول عنه الاحتمال في وقت شهادته ان هذا حق صريح مع وجود الاحتمال وسبب هذه الشهادة بذلك ان الامر اذا كان يحتمل ان يكون صدقا ويحتمل ان يكون كذبا فتجلي له في الوقت صدق ورده وتصديقه لذلك الذي هو به مءمن احد محتملات ذلك الخبر وهو كونه صدقا هذا هو المشهود له في ذلك الحال فيقطع في ذلك الوقت بصدقه 
 وبانه لا يشك فيه وما علم ان ذلك من تجلي احد محتملاته فاذا غاب عنه ذلك الوارد قامت معه المحتملات علي السواء فلم يترجح عنده ذلك الا بطريق الظن لا بالعلم فانظر يا اخي ما اخفي غواءل النفس وما اعظم حجاب الجهل مع كونه عدما فكيف بنا لو كان وجود فلله الحمد والمنة وانما نبهناك علي هذا لتعلم حظك من الايمان ومنزلتك فان النبي ص يقول في الحديث الصحيح عنه لا يزني الزاني حين يزني وهو مءمن اي مصدق بالعقاب عليه فانه تعالي قد يغفر وان الايمان اذا لم يعط الكشف الذي يعطيه العلم فليس بايمان فاعلم ان العلم يعطي العمل من خلف حجاب رقيق وفي حديث اخر عن رسول الله ص في الزاني اذا زني خرج عنه الايمان حتي صار عليه كالظلة ولنا فيه تاويل حسن وهو ان الزاني قد تعرض لبلاء من الله ينزل عليه فيخرج الايمان حتي يصير عليه كالظلة يمنع نزول ذلك البلاء عليه ان نزل فلا تغفل يا ولي عن هذا القدر الذي نبهتك عليه الا تري الله تعالي ما نصب الايات وكثرها الا ليحصل بها العلم لعلمه ان العلم اذا حصل لزم العمل الا تري الي شارب الدواء وهو عمل ما شربه وتجرع مرارته الا لعلمه ان ثم دواء مزيلا لهذه العلة التي يشكو منها فيقول عسي يكون ذلك الدواء عين هذا الذي شربته فيشربه بالامكان والترجي فكيف به لو علم انه عين الدواء بلا شك لسارع اليه فهذا حاله مع الترجي والامكان فان قلت فقوله تعالي واضله الله علي علم في حق من اتخذ الهه هواه قلنا ان الاله له القوة في المالوه واله هذا هو هواه فحكم عليه واضله عن سبيل الله واما قوله علي علم يعني من انه اضله الله علي علم لا ان الضال علي علم فان الضال هو الحاءر الذي لا يعرف في اي جهة هو مطلوبه فمتعلق علي علم اضله وهو العامل فيه وهو فعل الله تعالي والذي علي الله انما هو البيان خاصة قال تعالي وما كان الله ليضل قوما بعد اذ هداهم حتي يبين لهم ما يتقون اي ليحير قوما بعد ان هداهم في اخذ الميثاق والفطرة التي ولدوا عليها حتي يبين لهم ما يتقون فاذا ابان لهم حيرهم فمنهم من حيره بالواسطة فشك في النبوة وحار فيها وما تحقق ان هذا نبي فتوقف في الاخذ عنه ومنهم من حيره في اصل النبوة هل لها وجود ام لا ومنهم من حيره فيما جاء به هذا النبي مما تحيله الادلة النظرية فاورثهم البيان الالهي هذه الحيرة وذلك لعدم الايمان فلم يكن لهم نور ايمان يكشف لهم عن حقيقة ما قاله الله وابان عنه ومن لم يجعل الله له نورا هنا من ايمانه فما له من نور في القيامة ان الله بكل شء عليم فيعمل بما علم انه يكون كونه وما علم انه لا يكون لم يكونه فكان عمله بعلمه قل انزله بعلمه والانزال عمل اوجده العلم فلما ابان الحق ما ابانه لعباده فمنهم من رزقه الله العلم فعمل به ومنهم من حرمه الله العلم فضل وحار وشك وارتاب وتوقف واما قوله تعالي الذين اتيناهم الكتاب يعرفونه كما يعرفون ابناءهم فانهم مصدقون بكتابهم وهذا النعت فيه وقد ابصروه فيعلمون انه عين هذا النعت ولا يعرفون الشخص الذي قام به هذا النعت لجواز انه يقوم ذلك النعت باشخاص كثيرين فدخلهم الاحتمال في الشخص لا في النعت واما قوله تعالي وان فريقا منهم ليكتمون الحق وهم يعلمون انه الحق فيكتمونه عن مقلديهم وعن النبي ع انهم عرفوه انه صاحب هذا النعت ولا يلزم من العالم بالحق الاقرار به في الظاهر وانما يستلزمه التصديق به في الباطن فهو مصدق به وان كذبه باللسان فقد عمل بما علم وهو التصديق وقوله تعالي في مثل هذا واستيقنتها انفسهم انها ايات فعلموا وعملوا بما علموا وهو التيقن الذي هو استقرار العلم في النفس فلو لا ما علموا ما تيقنوا وما كل عمل يعطي عموم النجاة بل يعطي من النجاة قدرا مخصوصا من عموم او خصوص فان قلت فان اهل النار قد علموا صدق الله في انفاذ الوعيد وقالوا ربنا اخرجنا نعمل صالحا غير الذي كنا نعمل فلا نشك انهم في هذه الحال حصل لهم العلم والله يقول ولو ردوا لعادوا لما نهوا عنه مع هذا العلم الذوقي الذي حصل لهم قلنا لما علم الله ان هذه الدار الدنيا جعلها الله علي طبيعة مخصوصة وجعل نشاة الانسان علي مزاج يقبل النسيان والغفلة وحب العاجلة ويقبل ضد هذا علي حسب ما يقام فيه فعلم سبحانه ان نشاة هءلاء الذين عينهم انهم لو ردوا الي الدنيا في نشاتهم التي كانوا عليها في الدنيا لعادوا الي نسيان ما كانوا قد علموا وجعل علي اعينهم غطاء علي ما لو شهدوه لعلموا الامر فعملوا له فهذا معني لعادوا لما نهوا عنه لان النشاة ليست الا تلك فلو بقي لهم هذا العلم لما عادوا الا تري النبي ص يقول في الصحيح عنه انه يءتي في القيامة بانعم 
 اهل الدنيا فيغمس في النار غمسة فيقال له هل رايت نعيما قط فيقول لا والله ومعلوم انه راي نعيما ولكن حجبه شاهد الحال عن ذلك النعيم فنسيه وكذلك صاحب البءس اذا غمس في الجنة غمسة يقال له هل رايت بءسا قط فيقول لا والله ما رايت بءسا قط فكذلك لو ردوا لكانوا بحسب النشاة والحال التي يردون فيها واما عصاة المءمنين فانهم عالمون بانفاذ الوعيد ولكن لا يعلمون فيمن فلو تعين لواحد منهم انه هو الذي ينفذ فيه الوعيد لما قدم علي سببه الذي علم انه يحصل له انفاذ الوعيد به واذا جبر في اختياره فذلك لا يعلمه لانه لا يجد ذلك من نفسه فان الامر في ذلك مشترك وقد تقدم قبل هذا الكلام عليه في بعض المنازل فمن شهد الجبر في اختياره علما من طريق الكشف والشهود اتي المخالفة بحكم التقدير لا بحكم الانتهاك فكان عاملا بما علم فلم يضره ذلك العمل بل هو مغفور له واعلم ان هذا القدر الذي ذكرناه في هذه المسالة هو من العلم الذي ورد فيه الخبر الذي لفظه ان من العلم كهيءة المكنون لا يعلمه الا العالمون بالله فاذا نطقوا به لم ينكره عليهم الا اهل الغرة بالله وهذا من طريق الكشف عند اهله حديث صحيح مجمع عليه عندهم خاصة عرفوه وتحققوه فجعله كهيءة المكنون ما جعله مكنونا اذ لو كان مكنونا لانفرد به تعالي فلما لم يعلمه الا العلماء بالله علمنا ان العلم بالله يورث العلم بما يعلمه الله فهو مستور عن العموم معلوم للخصوص ومعني العلم بالله انه لا يعلم فقد علمنا ان ثم ما لا يعلم علي التعيين وما عداه فيمكن العلم به فاكنة هذا العلم قلوب العلماء بالله فاذا نطقوا به فيما بينهم اذ لا يصح النطق به الا علي هذا الحد واتفق ان يكون في المجلس من ليس من اهله ولا من اهل الله فان اهل الله هم اهل الذكر وهم العلماء بالله انكره عليهم اهل الغرة بالله فاضاف اهليتهم الي الغرة وهم الذين يزعمون انهم عرفوا الله فمن العلم الذي هو كهيءة المكنون وما هو بمكنون هذا العلم فان العلم المكنون يعلم شهودا ولا ينقال بخلاف علوم الفكر فانها كلها تنقال فاذا حصلت ايضا لصاحب الكشف من غير فكر ولا روية فانها تنقال من غير دليل فيقبلها منه العالم بالدليل فهذا العلم هو الذي كهيءة المكنون لان العالم به غير عالم بالدليل فاعلم ان الديار داران دار تسكنها الارواح الناطقة وهو البدن الطبيعي المسوي المعدل الذي خلقه الله بيديه ووجه عليه صفتيه فلما انشاه اسكنه دار اخري هي دار الدار وقسم سبحانه دار الدار قسمين قسما سماه الدنيا وقسما سماه الاخرة ثم علم ما يصلح لسكني كل دار من الساكنين الذين هم ديار النفوس الناطقة فخلق للدار الدنيا لفناءها وذهاب عينها وتبدل صورتها ووضعها وشكلها وخفاء حياتها ساكنا هو هذه الدار التي اسكنها النفس الناطقة فجعل هذه النشاة مثل دار سكناها خفية الحياة فانية ذاهية العين متبدلة الصورة والوضع والشكل فاتصف ساكنها وهو النفس الناطقة بالجهل والحجاب والشك والظن والكفر والايمان وذلك لكثافة هذه الدار التي هي نشاته البدنية وحال بينه وبين شهود الله وجعله في حجر امه ترضعه وتقوم به فما شهد من حين اسكن هذه النشاة سوي عين امه حتي انه جهل اباه بعض الساكنين ولولا ان الله من عليه بالنوم وجعل له في ذلك امرا يسمي الرءيا في قوة تسمي الخيال فاذا نام كانه خرج عن هذه النشاة فنظر اليه ابوه وسر به والقي اليه روحا وانسه وبادرت اليه الارواح وتراءي له الحق من تنزيهه وبدا له ذلك كله في اجساد الف شهودها من جنس دار نشاته التي فارقها بالنوم فيظن في النوم انه في دار نشاته التي الفها ويعرفها ويظن في كل ما يراه في تلك المواد انها علي حسب ما شهدها فهذا القدر هو الذي له في هذه النشاة الدنيا من الانس بابيه واخوانه من الارواح ومن الانس بربه ومنهم من يتقوي في ذلك بحيث انه يري ذلك في يقظته واعطاه علما سماه علم التعبير عبر به في مشاهدة تلك الصور الي معانيها فاذا اراد الله ان يخلي هذه الدار الدنيا من هذه النشاة التي هي دار النفس الناطقة ارحل عن هذه النشاة روحها المدبر لها واسكنه صورة برزخية من الصور التي كان يلبسها في حال النوم فاذا كان يوم القيامة واراد الله ان ينقله الي الدار الاخري دار الحيوان وهي دار ناطقة ظاهرة الحياة ثابتة العين غير زاءلة انشا لهذه النفس الناطقة دارا من جنس هذه الدار الاخري مجانسة لها في صفتها لانها لا تقبل ساكنا لا يناسبها فخلق نشاة بدنية طبيعية للسعداء عنصرية للاشقياء فسواها فعدلها ثم اسكنها هذه النفس الناطقة فازال عنها حجب العمي والجهل والشك والظن وجعلها صاحبة علم ونعيم داءم واراها اباها ففرحت به واراها خالقها ورازقها وعرف بينها وبين اخوتها وانتظم الشمل بالاحباب 
 واشهدها كل شء كان في الدار الاولي غاءبا واسكن هذه النشاة الدار الاخري المسماة جنة منها فانه قسم الدار الاخري الي منزلين هذا هو المنزل الواحد والمنزل الاخر المسمي جهنم جعل نشاة بدن انفسها الناطقة عنصرية تقبل التغيير واصحبها الجهل وسلب عنها العلم فاعطي جهل المءمنين من اهل التقليد من كان من اهل هذه الدار دار الشقاء عالما بدقاءق الامور فدخل بذلك الجهل النار اذ كان من اهلها وهي لا تقبل العلماء واعطي هذا العالم الذي كان في الدنيا عالما بدقاءق الامور ولم يكن من اهل الجنة جهل المءمن المقلد فان الجنة ليست بدار جهل فيري المءمن الابله المقلد ما كان عليه من الجهل علي ذلك العالم فيستعيذ بالله من تلك الصفة ويري قبحها ويشكر الله علي نعمته التي اعطاه اياها بما كساه وخلع عليه من علم ذلك العالم الذي هو من اهل النار وينظر اليه ذلك العالم فيزيد حسرة الي حسرته ويعلم ان الدار اعطت هذه الحقاءق لنفسها فيقول يا ليتنا نرد ولا نكذب بايات ربنا ونكون من المءمنين لعلمهم اذ كانوا مءمنين وان كانوا جاهلين انهم اذا انتقلوا الي دار السعادة خلعت عنهم ثياب الجهالة وخلع عليهم خلع العلم فلا يبالون بما كانوا عليه من الجهل في الدنيا لحسن العاقبة وما علموا انهم لو ردوا الي الدنيا في النشاة التي كانوا عليها لعادوا الي حكمها فان الفعل بالخاصية لا يتبدل فما تكلموا بما تكلموا به من هذا التمني الا بلسان النشاة التي هم فيها وتخيلوا ان ذلك العلم يبقي عليهم وما جعل الله في هذه النشاة الدنيا النسيان للعلماء بالشء فيما قد علموه ويعلمون انهم قد كانوا علموا امرا فيطلبون استحضاره فلا يجدونه بعد ما كانوا عالمين به الا اعلاما وتنبيها انه علي كل شء قدير بان يسلب عنهم العلم بما كانوا به عالمين اذا دخلوا النار يختص برحمته من يشاء وهو قوله تعالي قل اللهم مالك الملك تءتي الملك من تشاء واي ملك اعظم من العلم وهو ما اعطاه من العلم للمءمن المقلد الجاهل السعيد في الدار الاخرة وتنزع الملك ممن تشاء واي ملك افضل من العلم فينزعه من العالم غير المءمن الذي هو من اهل النار وتعز من تشاء بذلك العلم وتذل من تشاء بانتزاع ذلك العلم منه لما علمت بان الله كلفني * علمت اني مسءول ومقصود وانني لا ازال الدهر اعبده * دنيا واخرة والحق معبود وما تجلي لشء من خليقته * الا ويشهد ان الحق مشهود من عين صورته لا من حقيقته * فالامر والشان موجود ومفقود لاننا بعيون الوجه نبصره * وكلنا وجهه والوجه محدود هو الوجود ومن في الكون صورته * فليس ثم سوي الرحمن موجود الدار داران دار الدار يعمرها * دار اللطيف فما في الكون تجريد ولولا ان الحقاءق تعطي ان المال الي الرحمة في الدار الاخري فيرحمه معني وحسا فثم من تكون الرحمة به عين العافية لا غير وارتفاع الالام وهذا مخصوص باهل النار الذين هم اهلها فهم لا يموتون فيها لما حصل لهم فيها من العافية بزوال الالام فاستعذبوا ذلك فهم اصحاب عذاب لا اصحاب الم ولا يحيون اي ما لهم نعيم كنعيم اهل الجنان الذي هو امر زاءد علي كونهم عافاهم من دار الشقاء في القلب منك لهيب ليس يطفيه * الا الذي بشهود الحس ينشيه اني اخاف علي الاشراف من شرف * فمن يمر علي قلبي فينبيه اذا اتي صاحب العاهات يطلبه * فانه بشهود الحال يبريه وما يعيد علي قلبي تنعمه * الا الذي كان قبل اليوم يبديه واعلم انه من زعم اليوم ان العلم هو السعادة فانه صادق بان العلم هو السعادة وبه اقول ولكن فاته ما ادركه اهل الكشف وهو انه اذا اراد الله شقاوة العبد ازال عنه العلم فانه لم يكن العلم له ذاتيا بل اكتسبه وما كان مكتسبا فجاءز زواله ويكسوه حلة الجهل فان عين انتزاع العلم جهل ولا يبقي عليه من العلم الا العلم بانه قد انتزع عنه العلم فلو لم يبق الله تعالي عليه هذا العلم 
 بانتزاع العلم لما تعذب فان الجاهل الذي لا يعلم انه جاهل فارح مسرور لكونه لا يدري ما فاته فلو علم انه قد فاته خير كثير ما فرح بحاله ولتالم من حينه فما تالم الا بعلمه ما فاته او مما كان عليه فسلبه ولقد اصابني الم في ذراعي فرجعت الي الله بالشكوي رجوع ايوب ع ادبا مع الله حتي لا اقاوم القهر الالهي كما يفعله اهل الجهل بالله ويدعون في ذلك انهم اهل تسليم وتفويض وعدم اعتراض فجمعوا بين جهالتين ولما تحققت ما حققني الله به في ذلك الوجع قلت شكوت منه ومن ذراعي * وذاك مني لضيق باعي فقلت للنفس تدعيه * فاين دعواك في اتساعي قالت انا اشتكيك منه * له فضري عين انتفاعي لولا التشكي مما اقاسي * خرجت عنه وعن طباعي وذاك جهل يدريه قلب * صاحب حال بالاتباع لولا شر ودي عنه بجهلي * لما دعاني اليه داع فقلت لبيك من دعاني * فقال ابغي عين المتاع قد نفق الشوق فاغتنمه * فعين وصلي عين انقطاعي فخف عني ما كنت اجده وغاب عني ما كنت اشهده فلو لا وجود العقل ما كنت ادريه * ولولا وجود اللوح ما كنت امليه ولولا شهود الكون ما كنت اوفيه * ولولا حصول العلم ما كنت اجريه فمن قال ان الخلق يعرف كونه * فما عنده علم بما حقه فيه ويكفيه هذا القدر من جهله بما * هو الامر في عين الحقيقة يكفيه اذا انكشفت الحقاءق فلا ريب ولا مين وبان صبحها لذي عينين كان الاطلاع وارتفع النزاع وحصل الاستماع ولكن بينك وبين هذه الحال مفاوز مهلكة وبيداء معطشة وطرق دارسة واثار طامسة يحار فيها الخريت فلا يقطعها الا من يحيي ويميت لا من يحيا ويموت فكيف حال من يقاسي هذه الشداءد ويسلك هذه المضايق ولكن علي قدر الام المشقات يكون النعيم بالراحات وما ثم بيداء ولا مفازة سواك فانت حجابك عنك فزل انت وقد سهل الامر فمن علم الخلق علم الحق ومن جهل البعض من هذا الشان جهل الكل فان البعض من الكل فيه عين الكل من حيث لا يدري فلو علم البعض من جميع وجوهه علم الكل فان من وجوه كونه بعضا علم الكل وهذا المنزل من المنازل التي كثرت اياتها واتضحت دلالاتها ولكن الابصار في حكم اغطيتها والقلوب في اكنتها والعقول مشغولة بمحاربة الاهواء فلا تتفرع للنظر المطلوب منها وفي هذا المنزل من العلوم علم مقاومة الاعداء وتقابل الاهواء بالاهواء فان العقول ان لم تدفع الهوي بالهوي لم تحصل علي المقصود فان النفوس ما اعتادت الا الاخذ عن هواها فاذا كان العقل عالما بالسياسة حاذقا في انشاء الصور انشا للنفس