 البله : الغفلة عن الشر وان لا يحسنه ، بله بلها ، وهو ابله ، وابتله كبله ، وانشد ابن الاعرابي :
  ان الذي يامل الدنيا لمبتله  وكل ذي امل عنها سيشتغل  والبلهاء من النساء : الكريمة المزيرة الغيرة المغفلة .
 والتباله ، والتبله : استعمال البله .
 والتبله : تطلب الضالة .
 والتبله : تعقب الطريق من غير هداية ولا مسالة ، الاخيرة عن ابي علي .
 والبلهنية : الرخاء وسعد العيش .
 وعيش ابله : واسع .
 وبله كلمة معناها : دع ، قال كعب بن مالك الانصاري :
  تذر الجماجم ضاحيا هاماتها   بله الاكف كانها لم تخلق  يقول : هي تقطع الهام فدع الاكف ، اي فهي اجدر ان تقطع الاكف ، وفي المثل : تحرقك النار ان تراها بله ان تصلاها يقول : تحرقك النار من بعيد فدع ان تدخلها ، ومن العرب من يجربها يجعلها مصدرا ، كانه قال : ترك ، وقوله صلي الله ليه وسلم : يقول الله تعالي : اعددت لعبادي الصالحين ما لا عين رات ، ولا اذن سمعت ، ولا خطر علي قلب بشر ، بله ما اطلعتهم عليه قال ابو عبيد : قال الاحمر وغيره : بله معناها : كيف ، وقيل معناه : دع ما اطلعتهم عليه .
 والبلهاء : ناقة ، واياها عني قيس بن عيزارة الهذلي بقوله :
  وقالوا : لنا البلهاء اول سءلة  واغراسها والله عني يدافع  
   ( الهاء واللام والميم )
 الهليم : اللاصق من كل شء ، عن كراع .
 والهلام : طعام يتخذ من لحم عجلة بجلدها .
 والهلمان : الشء الكثير ، وقيل : هو الخير الكثير ، قال ابن جني : انما هو الهلمان علي مثل فركان .
 وهلم : بمعني اقبل ، وهذه الكلمة تركيبية من ها التي للتنبيه ، ومن لم ولكنها استعملت استعمال الكلمة المفردة البسيطة ، قال سيبويه : هلم في لغة اهل الحجاز تكون للواحد والاثنين والجميع والذكر والانثي بلفظ واحد . واما في لغة بني تميم فانهم يجرونه مجري قولك : رد ، يقولون للواحد : هلم ، كقولك : رد ، وللاثنين هلما كقولك : ردا ، وللجمع هلموا كقولك : ردوا ، وللانثي هلمي كقولك : ردي وللثنتين : كالاثنين ، ولجماعة الاناث هلممن كقولك : ارددن . قال : وزعم الخليل انها لم لحقتها الهاء للتنبيه في اللغتين جميعا ، قال : ولا تدخل النون الخفيفة ولا الثقيلة عليها ، لانها ليست بفعل ، وانما هي اسم للفعل ، يريد ان النون الثقيلة انما تدخل الافعال دون الاسماء ، واما في لغة بني تميم فتدخلها الخفيفة والثقيلة ، لانهم قد اجروها مجري الفعل ، ولها تعليل طويل لا يليق بهذا الكتاب . قال اللحياني : ومن العرب من يقول : هلم . فنصب اللام ، قال : ومن قال : هلمي وهلموا ، فكذلك يقول : هلمي وهلموا . وحكي : الي ما اهلم ، واهلم ، ولست من الاخيرة علي ثقة ، وقد هلممت فماذا وهلممت بالرجل : قلت له هلم ، قال ابن جني : هلممت كصعررت وشمللت ، واصله قبل غير هذا ، انما هو اول ها للتنبيه لحقت مثال اللام للمواجهة توكيدا ، فاصلها هالم فكثر استعمالها وخلطت ها بلم توكيدا للمعني بشدة الاتصال ، فحذفت الالف لذلك ، ولان لام لم في الاصل ساكنة ، الا تري ان تقديرها اول المم وكذلك يقولها اهل الحجاز ، ثم زال هذا كله بقولهم هلممت ، فصارت كانها فعللت من لفظ الهلمان ، وتنوسيت حال التركيب ، وحكي اللحياني : من كان عنده شء فليهلمه ، اي فليءته .
   ( مقلوبه : ) ه م ل ( )
 الهمل : السدي المتروك ليلا او نهارا . هملت الابل تهمل ، وبعير هامل من ابل هوامل وهمل وهمل ، وهو اسم الجمع  كراءح وروح ، لان فاعلا ليس مما يكسر علي فعل ، وقد اهملها ، ولا يكون ذلك في الغنم .
 واهمل امره : لم يحكمه .
 وهملت عينه تهمل وتهمل هملا وهمولا وهملانا ، وانهملت : سالت . )
 وهملت السماء هملا وهملانا وانهملت : دام مطرها مع سكون وضعف .
 وثوب هماليل : مخرق .
 وكساء همل : خلق .
 والهمل : الكبير السن .
 والهمل : الليف المنتزع ، واحدته هملة ، حكاه ابو حنيفة .
 وهميل ، وهمال : اسمان .
   ( مقلوبه : ) ل ه م ( )
 لهم الشء لهما ولهما ، وتلهمه والتهمه : ابتلعه بمرة .
 ورجل لهم ، ولهم ، ولهوم : اكول .
 ولهم الماء لهما : جرعه ، قال : جاب لها لقمان في قلاتها ماء نقوعا لصدي هاماتها تلهمه لهما بجحفلاتها وجيش لهام : كثير يلتهم كل شء ويغتمر من دخل فيه ، اي يغيبه ويستغرقه .
 واللهيم ، وام اللهيم : المنية ، لانها تلتهم كل احد .
 وام اللهيم : الداهية ، وام اللهيم : الحمي ، كلاهما علي التشبيه بالمنية .
 واللهم من الرجال : الرغيب الراي الكافي العظيم ، وقيل : هو الجواد ، والجمع لهمون ، ولا يوصف به النساء .
 وفرس لهم علي لفظ ما تقدم ولهميم ولهموم : جواد سابق . وحكي سيبويه : لهمم وقال : هو ملحق بزهلق ، ولذلك لم يدغم ، وعليه وجه قول غيلان : شاو مدل سابق اللهامم  قال : ظهر في الجمع لان مثل واحد هذا لا يدغم .
 واللهموم من الاخراج : الواسع .
 وناقة لهموم : غزيرة .
 ورجل لهم ولهموم : غزير الخير . )
 وسحابة لهموم : غزيرة القطر ، وعدد لهموم : كثير ، وكذلك جيش لهموم .
 وجمل لهميم : عظيم الجوف .
 وبحر لهم : كثير الماء .
 والهمه الله خيرا : لقنه اياه .
 واستلهمه اياه : ساله ان يلهمه اياه .
 واللهم : المسن من كل شء ، وقيل : اللهم : الثور المسن ، والجمع من كل ذلك لهوم ، قال صخر الغي يصف وعلا :
  بها كان طفلا ثم اسدس فاستوي   فاصبح لهما في لهوم قراهب  وملهم : ارض ، قال طرفة :
  يظل نساء الحي يعكفن حوله  يقلن عسيب من سرارة ملهما   واللهيماء : موضع من نعمان .
 ويوم اللهيما : يوم كان فيه وقعة هناك .
   ( مقلوبه : ) م ه ل ( )
 المهل ، والمهل ، والمهلة كله : السكينة والرفق .
 وامهله : رفق به ولم يعجل عليه .
 ومهله : اجله .
 وتمهل في عمله : اتاد .
 وكل ترفق : تمهل .
 ورزق مهلا : ركب الذنوب والخطايا فمهل ولم يعجل . 
 ومهلت الغنم ، اذا ارعت بالليل او بالنهار علي مهلها .
 والمهل : اسم يجمع معد نيات الجواهر نحو الذهب ، والفضة ، والرصاص ، والحديد . وقيل : هو خبث الجواهر .
 والمهل : ما ذاب من صفر او حديد ، وهكذا فسر في التنزيل ، والله اعلم .
 والمهل والمهلة : ضرب من القطران ما هي رقيق يشبه الزيت ، وهو يضرب الي الصفرة من مهاواته ، تدهن به الابل في الشتاء . وقيل : هو دردي الزيت ، وقيل هو العكر المغلي ، وقيل : هو )
 رقيق الزيت ، وقيل : هو عامته .
 والمهل : ما يتحات عن الخبزة من الرماد ونحوه اذا اخرجت من الملة ، قال ابو حنيفة : المهل : بقية جمر في الرماد تبينه اذا حركته .
 والمهل ، والمهل ، والمهلة : صديد الميت ، وفي الحديث : انما هو للمهلة والتراب وقيل : هو القيح والصديد عامة .
 والمهلة ، والمهلة ، كالمهلة .
 والمهل ، والتمهل : التقدم .
 وتمهل في الامر : تقدم فيه .
   ( مقلوبه : ) م ل ه ( )
 وجل ملي ه ، وممتله : ذاهب العقل .
 وسليه مليه : لا طعم له ، كقولهم : سليخ مليخ ، وقيل : مليه اتباع ، حكاه ثعلب .
   ( الهاء والنون والفاء )
 الهنوف والهناف : ضحك فوق التبسم ، وخص بعضهم به ضحك النساء .
 وتهانف به : تضاحك قال الفرزدق :
  من اللف افخاذا تهانف للصبي   اذا اقبلت كانت لطيفا هضيمها   وقيل : تهانف به : تضاحك وتعجب ، عن ثعلب ، وقيل : هو الضحك الخفي .
 والمهانفة : الملاعبة . 
 واهنف الصبي ، وتهانف : تهيا للبكاء ، كاجهش ، وقد يكون التهانف بكاء غير الطفل ، انشد ثعلب :
  تهانفت واستبكاك رسم المنازل  بسوقه اهوي او بقارة حاءل  فهذا هاهنا انما هو للرجال دون الاطفال ، لان الاطفال لا تبكي علي المنازل والاطلال ، وقد يكون قوله تهانفت تشبهت بالاطفال في بكاءك ، كقول الكميت :
  اشيخا كالوليد برسم دار  تساءل ما اصم عن السءول  اصم : اي صم .
   ( مقلوبه : ) ن ف ه ( )
 نفهت نفسي : اعيت وكلت . )
 وبعير نافه : كال معي ، والجمع نفه .
 ونفهه : اتعبه حتي انقطع ، قال :
  ولليل حظ من بكانا ووجدنا   كما نفه الهيماء في الذود رادع  ويروي في الدور .
 ورجل منفوه : ضعيف الفءاد جبان ، وقد نفه ونفه .
   ( الهاء والنون والباء )
 امراة هنباء : ورهاء ، تمد وتقصر .
 وهنب : اسم رجل ، وهو هنب بن افصي بن دعمي .
 وبنو هنب : حي من ربيعة .
   ( مقلوبه : ) ن ه ب ( )
 النهب : الغنيمة ، والجمع نهاب .
 ونهب النهب ينهبه نهبا وانتهبه : اخذه ، وانهبه غيره : عرضه له .
 والنهبة والنهبي ، والنهيبي ، والنهيبي كله : اسم الانتهاب والنهب ، وقال اللحياني :  النهب : ما انتهبت : والنهبة والنهبي ، اسم الانتهاب .
 وكان للفرز بنون يرعون معزاة ، فتواكلوا يوما ، اي ابوا ان يسرحوها ، قال : فساقها ، فاخرجها ثم قال للناس : هي النهيبي ، وروي بالتخفيف ، اي لا يحل لاحد ان ياخذ منها اكثر من واحد ، ومنه المثل : لا تجمع ذلك حتي تجمع معزي الفزر .
 وتناهبت الابل الارض : اخذت بقواءمها منها اخذا كثيرا .
 والمناهبة : المباراة في الحضر والجري .
 وتناهب الفرسان : ناهب كل واحد منهما صاحبه .
 وفرس منهب ، علي طرح الزاءد ، او علي انه نوهب فنهب ، قال العجاج : وان تناهبه تجده منهبا ومنهب : فرس عوية بن سلمي .
 وانتهب الفرس الشوط : استولي عليه .
 ومنهب : ابو قبيلة . )
   ( مقلوبه : ) ب ه ن ( )
 البهنانة : الضحاكة ، وقيل : هي الطيبة الريح ، وقيل : هي اللينة في عملها ومنطقها ، فاما قول عاهان ابن كعب ، انشده ابن الاعرابي :
  الا قالت بهان ولم تابق  نعمت ولا يليق بك النعيم  فانه قال : بهان اراد به بهنانة ، وعندي انه اسم علم ، كحذام وقطام .
 والباهين : ضب من التمر ، عن ابي حنيفة ، وقال مرة : اخبرني بعض اعراب عمان ان بهجر نخلة يقال لها : الباهين ، لا يزال عليها السنة كلها طلع جديد ، وكباءس مبسرة ، واخر مرطبة ومثمرة .
 والبهنوي من الابل : ما يكون بين الكرمانية والعربية ، وهو دخيل في العربية .
   ( مقلوبه : ) ن ب ه ( )
 النبه : القيام من النوم ، وقد نبهه وانبهه ، فتنبه وانتبه ، قال :  انا شماطيط الذي حدثت به متي انبه للغداء انتبه ثم انز حوله واحتبه حتي يقال سيد ولست به وكان حكمه ان يقول : اتنبه ، لانه قد قال : انبه ومطاوع فعل انما تفعل ، ولكن لما كان انبه في معني انبه جاء بالمطاوع عليه ، فافهم ، وقوله : ثم انز معطوف علي قوله انتبه احتمل الخبن في قوله زحوله لان الاعرابي البدوي لا يبالي الزحاف ، ولو قال انزي حوله لكمل الوزن ولم يك هناك زحاف ، الا انه من باب الضرورة ، ولا يجوز القطع في انزي في باب السعة والاختيار ، لان بعده مجزوما ، وهو قوله : و احتبه ومحال ان تقطع احد الفعلين ثم ترجع في الفعل الثاني الي العطف ، لا يجوز : ان تاتني اكرمك وافضل عليك برفع اكرمك وجزم افضل ، فتفهم .
 ونبهه من الغفلة فانتبه وتنبه : ايقظه .
 وتنبه علي الامر : شعر به .
 وهذا الامر منبهة علي هذا ، اي مشعر به ومنبهة له : اي مشعر لقدره ومعل له ، ومنه قوله : المال منبهة للكريم ، ويستغني به عن اللءيم .
 وما نبه له نبها : اي ما فطن ، والاسم النبه . )
 والنبه : الضالة توجد علي غفلة ، قال ذو الرمة يصف ظبيا :
  كانه دملج من فضة نبه  في ملعب من عذاري الحي مفصوم  نبه هنا : بدل من دملج .
 واضله نبها : لم يدر متي ضل .
 وانبه حاجته : نسيها .
 والنباهة : ضد الخمول ، نبه نباهة ، فهو نابه ، ونبيه ، ونبه ، وقوم نبه ، كالواحد ، عن ابن الاعرابي ، كانه اسم للجمع . 
 ونبه باسمه : جعله مذكورا .
 وانه لمنبوه الاسم : معروفه ، عن ابن الاعرابي .
 وامر نابه : عظيم جليل .
 ونابه ، ونبيه ، ومنبه : اسماء .
   ( الهاء والنون والميم )
 الهنم : ضرب من التمر . وقيل : التمر كله ، قال : مالك لا تطعمنا من الهنم وقد اتاك التمر في الشهر الاصم ويروي : و قد اتتك العير .
 والهنمة : الخرز التي يءخذ بها النساء ازواجهن . حكي اللحياني عن العامرية انهن يقلن : اخذته بالهنمه ، بالليل زوج وبالنهار امه .
 وهانمه بحديث : ناجاه .
 والهينم والهينمة ، والهينام ، والهينوم ، والهينمان ، كله : الكلام الخفي ، وقيل : الصوت الخفي ، وقد هينم .
 والمهينم : النمام .
 وبنو هنام : حي من الجن ، وقد جاء في الشعر الفصيح .
   ( مقلوبه : ) ه م ن ( )
 المهيمن ، والمهيمن : اسم من اسماء الله عز وجل في الكتب القديمة ، وفي التنزيل : ) و مهيمنا عليه ( )
 قال بعضهم : معناه : وشاهدا عليه ، وقيل : رقيبا عليه ، وقيل : مءتمنا عليه . وقال بعضهم : مهيمن في معني مءيمن ، والهاء بدل من الهمزة ، كما قالوا : هرقت وارقت ، وكما قالوا : اياك وهياك .
   ( مقلوبه : ) ن ه م ( )
 النهم والنهامة : افراط الشهوة في الطعام ، وان لا تمتلء عين الاكل ولا يشبع ، ورجل نهم ، ونهيم ، ومنهوم ، وقيل : المنهوم : الرغيب الذي يمتلء بطنه ولا تنتهي نفسه  وقد نهم ، وانكرها بعضهم .
 والنهمة : الحاجة ، وقيل : بلوغ الهمة والشهوة في الشء .
 ورجل منهوم بكذا : مولع به .
 ونهم ينهم نهيما ، وهو صوت كانه زحير ، وقيل : هو صوت فوق الزءير .
 والنهم والنهيم : صوت وتوعد وزجر ، وقد نهم ينهم .
 ونهمة الرجل والاسد : نامتها ، وقال بعضهم : نهمة الاسد بدل من نامته .
 والنهام : الاسد ، لصوته .
 والناهم : الصارخ .
 ونهم الابل ينهمها وينهمها نهما ونهيما ونهمة ، الاخيرة عن سيبويه : زجرها بصوت لتمضي .
 وابل مناهيم : تطيع علي النهم ، قال : الا انهماها انها مناهيم والنهامي : الراهب ، لانه ينهم ، اي يدعو .
 والنهام والنهامي : الحداد ، وقيل : النهامي : النجار ، والفتح في كل ذلك لغة عن ابن الاعرابي .
 والمنهمة : موضع النجر .
 وطريق نهامي ونهام : بين واضح .
 ونهم الحصي ونحوه ينهمه نهما : قذفه ، قال : ينهمن في الدار الحصي المنهوما والنهام : طاءر يشبه الهام ، وقيل : هو البوم ، وقيل : سمي بذلك لانه ينهم بالليل ، وليس هذا الاشتقاق بقوي ، قال الطرماح : 
  فتلاقته فلاثت به  لعوة تضبح ضبح النهام  والجمع نهم . )
 ونهم : صنم ، وبه سمي الرجل عبد نهم .
 ونهم : اسم رجل ، وهو ابو بطن منهم ، ونهم : اسم شيطان ، ووفد علي النبي صلي الله عليه وسلم حي من العرب ، فقال : بنو من انتم فقالوا : بنو نهم ، فقال : نهم شيطان ، وانتم بنو عبد الله .
