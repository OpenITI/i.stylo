 و درين تاريخ ثقب كردن و نظم «هارات» بيشتر در بغداد ميكنند [ ق] و پيش ازين در خوزستان و سيلاف كرده. و تجار قديم در كيش و بحرين ميخريدهاند و بدين شهرها مي اورده و انجا هاريات و غير ان ترتيب ميكرده و تصرفاتي كه در ان بايد كرد و توان [كرد] كردهاند. در تاريخ قديم در كيش و بحرين ثقاب و نظام نبودست.
 همچنان كه قيمت جواهر را ضابطي زيادتي نيست در مرواريد همان حكم است. كه به سبب عزت وجود و حسب هر بلادي و وقتي و قبول ملوك قيمت مرواريد زيادتي و نقصان مي پذيرد.
 رسم در اعتبار وزن مرواريد كنند كه قيمت كنند. در «دانه شمار» مثقال است و در «وزني» در خراسان به درم سنگ قيمت مرواريد كنند، و در خراسان به وزن نيسابور كنند، و در بغداد زر اميري، درست خليفتي.
 و بعضي جوهريان قيمت مرواريد را ضابطي نهادهاند و قياس ان به مرواريد عيون و نجم كنند كه ان را «مد حرج» خوانند. و در عراق و شام مرواريد را به حساب عقد قيمت كنند، چنان كه ياد كرده شد. هر عقدي سي و شش دانه وزني و دانهشمار، هر جنس كه باشد خواه بزرگ باشد [ ق]، خواه خرد ان را به حساب عقود قيمت كنند. چنان كه گويند مثلا عقدي دو مثقال به



![image file](./JawhariNayshaburi.JawahirNamaNizami_.png)
 چندين، و عقدي پنج مثقال به چندين  عليها عليها. و انچه به عدد كمتر از عقدي باشد يا بيشتر از ان، ان را هم به حساب عقد قيمت كنند. چنان كه مثلا گويند پنج دانه به وزن چندين مثلا، ان پنج دانه به چندين ارزد. بدين نسبت قيمت كنند. و در كتب متقدمان اوردهاند كه قيمت يك دانه مرواريد به وزن يك مثقال چون مدحرج و عيون و خوش اب و تنك سوراخ و با طراوت و سپيدي بي عيب باشد به هزار دينار زر نيسابوري قيمت ان باشد، و چون به وزن پنج دانگ بود هشتصد دينار قيمت بود، و چون چهار دانگ باشد پانصد دينار، و چون نيم مثقال باشد دويست دينار، و چون دو دانگ بود پنجاه دينار، و قيمت دانگنيم بيست دينار، و قيمت دانگي پنج دينار، و قيمت سه تسوا سه دينار، و قيمت نيم دانگ دينار. و درين وزنها كه برشمرده امد بايد كه ان كمال كه در دانها يك مثقال ياد كرده شده باشد، با ان قيمت مذكور توان كرد. و قيمت دانها غلامي [ق] به هر وزن كه باشد نيمها قيمت دانها عيون [و ]نجم بود هم بدان وزن، و اين قيمت كه ياد كرده شد قيمت قديم است و درين تاريخ تفاوت بسيار كردست و تفاوت قيمت مضبوط نيست در زيادت و نقصان. و يعقوب اسحق كندي گويد قيمت مرواريد «هم برد» نيمها قيمت مدحرج بود چون به



![image file](./JawhariNayshaburi.JawahirNamaNizami_.png)
 وزن برابر باشد. و «هم برد» دانهاي را ميگويند كه ان را شكلي معين نباشد كه از ان عبارتي توان كرد. و قيمت مزنر وخيزراني غير قيمت مدحرج باشد چون وزن برابر باشد.
 و هر دانه عيون با كمال چنان كه ياد كرده شد به وزن دو مثقال باشد به حقيقت ان را قيمت نباشد، چنان كه خواهي ان را قيمت توان كرد كه در ان هيچ حرج نباشد.
 وقيمت دانها بيضي كمتراز عيون،
 و قيمت دهلي كمتر از لوزي و زيتوني باشد.
 و همچنين قيمت لوزي از مخروط كمتر باشد.
 و قيمت خنبي و دفي از قاعد و عدسي كمتر باشد.
 و در الوان همچنين در قيمت تفاوت بسيارست و ان را حدي نيست و در كتاب دشوار توان اورد و تفاوت [ق] ان از روي بصيرت و ممارست ديدن و قياس يكي با ديگري توان كرد.
 و جماعتي از جوهريان گفتهاند كه قياس قيمت در وزن به عيون كنند و اعتبار قيمت بر قيمت بحرين است، و وسط قيمت بحرين اين است كه مرواريدي كه به وزن دانگي باشد قيمت ان دو دينار باشد يا سه دينار، و هرچه به وزن دو دانگ باشد از ده دينار تا بيست دينار، و هرچه به وزن نيم مثقال باشد قيمت ان از دويست دينار باشد تا سيصد دينار. و تفاوت ميكند در قيمت به حسب كمال شكل و لون و طراوت، و ان تفاوت جز جوهري نداند. و بعد از ان كه مثقال، هر دانگي كه در وزن مرواريد ميافزايد صد دينار در قيمت مي افزايد، چندان كه وزن ان به يك مثقال و نيم رسد، ان گاه هر دانگي در وزن مرواريد ميافزايد به صد و پنجاه دينار ميافزايد در قيمت، و چون دو مثقال بود دو هزار دينار



![image file](./JawhariNayshaburi.JawahirNamaNizami_.png)
 باشد، و چون سه مثقال باشد و نجم و عيون و مدحرج و سپيد و خوش اب و بي عيب بود ان را به حقيقت قيمت [ ق] نيست. زيادت ازين كسي نشان نمي دهد از مرواريد نجم و عيون بي عيب خوش اب، مگر دانههاي قلزمي بيش ازين به وزن بسيار ديدهاند. اما ان را با مرواريد «بحري» هيچ نسبت نيست.
 و هر مرواريد كه از دريا[ي] قلزم و هندوستان باشد لفظ «بحري» بر ان اطلاق نكنند.
 و قيمت مرواريد دهلي هرچه دانگي باشد دو دينار بود و دو دانگ را ده دينار. و مرواريد قلزمي انچه درست و بي عيب بود قيمت يك مثقال ان بيست دينار بود تا پنجاه دينار، و هرچند به وزن بيشتر ميشود قيمت ان زيادت ميگردد چون بي عيب باشد. و از مرواريد قلزمي به وزن دو مثقال و سه مثقال و زيادت بسيار افتد. اما رصاصي رنگ و سيمابي بود تهي باشد و عيبناك بود، و بيشتر غلامي شكل و لوزي شكل و مضرس باشد، و البته مدحرج و عيون و خوش اب نباشد و بدين سبب قيمت ان بسيار نبود.
 و انچه بي عيب باشد املس بود و املس ان بود كه در شكل ان تقعري و نتوي بود، وليكن هيچ خشونت نباشد [ ق] در ان. و معني ملاست سطح، ان را حاصل بود.
 و قيمت يك هار صدي كه وزن قديم ان ياد كرده شدست از صد و بيست دينار خراجي بودست تا صد و پنجاه دينار.
 و نقد كيش و بحرين زر خراجي بودست، و زر خراجي زر جعفري است و از ان اببي و الوي باشد كه از ان ستانند درين دو موضع و قيمت مرواريد بدان كنند و مرواريد را بدان نقد فروشند، و هر درستي از ان پنج دانگ و سه تسو باشد به وزن مكه.
 و هرچه ازين وزن بيشتر يا كمتر بود ان را بستانند و يا عيار ان نقصان نهند. ان زر هر ده دينار و چهار دانگ زر نيسابوري زيادت باشد، و هشتادي به صد دينار، و چهلي بيست وپنج دينار، و سيي و بيست و پنجي چندين دينار، و گزي گزي دينار.



![image file](./JawhariNayshaburi.JawahirNamaNizami_.png)
 و قيمت و شرط هاريات درين تاريخ در بغداد چندين است: صدي پنجاه دينار، هشتادي بيست و پنج دينار، شستي يازده دينار، چهلي پنج دينار. و اغلب اين سه بابت ميكنند، و از گزي عشرة دراهم دينار و نصف، و هو اعلم. در ميان عادت چنان رفته است كه فساد به حيوان زود راه يابد، از ان كه به نبات، و نبات فساد زودتر گيرد از ان كه جماد.
 و فساد هر چيزي به مقدار رطوبت ان چيز باشد، و هر چند رطوبت زيادت باشد در چيزي، ان چيز قابل فساد زودتر بود و عفونت زودتر پذيرد. و مرواريد حجري است حيواني يا جزوي است از اجزاي حيوان و با استخوان حيوان مشابهتي دارد، و چون چنين باشد لابد مرور زمان و تاثير طبايع را در ان تاثيري باشد و ان را از لون طبيعي خويش تغييري كند، و هر فساد كه در جزء ماهيت و نفس و حقيقت او راه يابد كه دشوار صلاح پذيرد، و عوارضي كه بر سطح ظاهر وي در ايد يمكن كه ان را اصلاح تواذ كرد، و مرواريد به سبب حرارت بشرها ادمي و عرق و وسخ او تباه گردد، و به حرارت گرمابه و رسيدن چربيها به وي تباه گردد، و بسياري در ريسمان و سفرها زركشيدن و تركيب كردن بر مرصعات تباه گردد، و به مصادمت اجرام صلب بر سطح ظاهر وي افو ق] فرسوده شود و اب و طراوت ان برود. هرگاه كه فساد عارضي از سبب ظاهر گردد كه خارج نفس و حقيقت وي باشد و ان را از پيش در سطح ظاهر نباشد چون اثر عرق و وسخ و بخار و روغن و بوي خوش. و بهترين علاجها ان باشد كه طبقها عليا[ي] فساد [كه] برو بود از وي جدا كنند.



![image file](./JawhariNayshaburi.JawahirNamaNizami_.png)

 و گفتهاند كه هر مرواريدي كه به دست گيرند در وي احساس حرارتي كند زيادت، چنان كه در ديگر مرواريدها ان حرارت احساس نكند. دليل كند ان حرارت [را] كه در جوف ان مرواريد كرمي باشد. و ان غريب نيست كه در گوشت و پشم و استخوان است. كرم به وي بسيار تولد كند، و چون مرواريد نيز حيواني باشد حدوث حيواني ديگر در وي بعيد نيست.
 و بسيار باشد كه مرواريد را افتها رسد در ميان صدف، چون فساد غذاي صدف و مجاورت زمينها[ي] عفن و غير ان.
 و بسيار باشد كه در ميان [مرواريد] اب باشد ناخوشبوي گشته، و باشد كه در ميان گلي باشد سياه و لون ان بر ظاهر مرواريد ميتابد و لون ان را به تغير ميدارد. چون ان را سوراخ كنند و ميان ان را به مصطكي [ ق] و سپيدها قلعي بياكنند ان سياهي كه بر ظاهر ان ميتافته باشد و به سبب ان، ان مرواريد سياه اب نمايد، چون اين تدبير كرده باشند اب و طراوت به قرار اصل باز شود. و مرواريد قلزمي از اين جنس بسيار باشد.
 و هيچ تدبير اصلاح مرواريد فاسد  كه فساد بر ظاهر ان باشد  چنان نيست كه ان را پوست باز كنند. و اگر ميان تهي باشد ماهي به غايت باريك وسخي گوشتي كه در ميان ان باشد از انجا بيرون كنند، و اگر حاجت باشد بعد از ان ميان ان را بازكنند، چنان كه ياد كرده شد.
 و اگر سوراخ مرواريد فراخ شده باشد به سبب ان كه ان را در زركشيده باشند و ان عيبي بزرگ است مرواريد را، و اصلاح ان ان باشد كه دو دانه مرواريد خرد را بگيرند، چنان كه هم اب ان دانه باشد و ان را [با] سوراخ ان سازند و انگاه به مصطكي مدبر كه شرح ان كرده شده است الصاق كنند، و يا دو پاره صدف را در پهني بسايند و با سوراخ ان بسازند و به مصطكي مدبر الصاق كنند و بعد از ان چنان كه خواهند سوراخ كنند.



![image file](./JawhariNayshaburi.JawahirNamaNizami_.png)
 و اگر سوراخ بيش از حد فراخ [ ق] باشد دو نيم روي هم طبع هم اب به دست ارند وبدان سوراخ بسازند والصاق كنند. و اگر بر دانها مرواريد خردگي باشد يا شكستگي و خواهند كه ان را اصلاح كنند بگيرند پارهاي از نيم روي. اگر ان عيب بر راستي مخروطي دانه باشد ان پاره بايد هم برين صفت بود و ان را به هم سازند و وصل كنند و روي ان را به سنگي كه از مكه اورده باشند نرم كنند، يا به سنگ چيني. و بعد از ان به چوب خرزهره و جلاي پيروزه ان را جلا دهند و ان چوبي است معروف و در حدود خانقين از ان درخت بسيارست.
 و اگر درازگوش برگ ان درخت بخورد در حال بميرد و خرزهره ان را بدين سبب مي گويند. و من ديدم كه اسبي از ان برگ بخورد در حال بمرد.
 و اگر ان به زير يا بر بالاي مرواريد باشد چنان كه بر موازات سوراخ مرواريد باشد ان وصل ناپيداتر ايد، و چنان وصل بتوان كرد كه كم كسي واقف شود كه اين را وصل كردهاند.
 و طريق ان اين باشد كه نيم روي هم بدان اب به دست ارند و گرداگرد ان را به اندازها ان عيب مدور كنند و ان عيب را نيز به چرخ عقرب تيز مدور كنند [ ق] و هردو را بههم راست كنند و به مصطكي مدبر كه ياد كرده شدست وصل كنند، و اگر با مصطكي مدبر اندك مايه سپيدها ارزيز نرم سوده بياميزند وصل خوبتر ايد و به رنگ مرواريد نزديكتر باشد. و اگر مرواريدي باشد لنگ و لنگ عيب باشد بزرگ. بدان كه سوراخ ان كژ باشد. يعني كه چون در يك ريسمان كشند و بگردانند در يك نيمه ميگردد و راست نهاستد، و چون خواهند كه اصلاح ان كنند طريق ان است كه هر دو طرف سوراخ را به صدف يا به پارهاي از مرواريد ديگر هم اب يكديگر استوار كنند و روي ان را استوار كنند. بعد از ان سوراخ كنند چنان كه در ريسمان راست باستد.



![image file](./JawhariNayshaburi.JawahirNamaNizami_.png)

 و مرواريد باشد كه به روي زيادت باشد، يا شكل ان كژي دارد، يا عيبي باشد بر وي كه ان را به مبرد يا به سنگ راست كنند. و بعد از ان به سنگ مكي نرم كنند و به چوب خرزهره جلا دهند. باشد كه هيچ اثر نماند و از ان عيب پاك شود. و موضع سودن و اصلاح كردن را لون و اب جمله مرواريد باشد، و نتوان دانست كه ان را عيبي بودست و اصلاح كردهاند. و باشد كه چون [ق] بسايند موضع سودن را لون و اب مرواريد نباشد، و اين نوع را «سوهاني» خوانند.
 و در اصلاح مرواريد انواع تصرفات باشد كه هر يك در قلم نتوان اورد به سبب ان كه تصرفي عملي باشد و كمال و نقصان ان تصرفات به كمال و نقصان صنعت حكاكان باشد. هرچند كه حكاك ماهرتر ان تصرف كه كند كامل تر. و طريق ان كه معلوم كنند كه دانها مرواريد را پوست باز ميبايد كرديا ني، ان است كه سر مثقبي به غايت باريك بر طرف مرواريد نهند و قدري فرو برند يا بخراشند تا معلوم شود كه طبقها زيرين خوش اب هست يا ني. اگر خوش اب بود پوست باز كنند، و اگر طبقها زيرين را لون تيره باشد رها كتند. اصلاح مرواريد زرد و سياه و صرخ اب و خشك اب [را پوست] باز كردن اگر صلاحيت باشد كه تفاوت خواهد كرد در كمال، هيچ تدبير كه مجرب ما باشد نيست.
 و در كتب متقدمان سخنها[ي] بسيار گفتهاند و اهل تجارت را از جوهريان و حكاكان معلوم باشد كه ان جنس [را] اصلاح از تجربه و تحقيق دورست و استحالت ان ظاهرست. اما چون استادان و بزرگان اصحاب [ ق] صنعت اوردهاند بعضي از ان كه به تجربه نزديك است هر چند مجرب اهل اين زمان نيست اورده شود.
