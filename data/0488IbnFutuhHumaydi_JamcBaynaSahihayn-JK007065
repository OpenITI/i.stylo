   الرابع والثمانون بعد الماءة : عن سفيان عن ابي الزناد عن الاعرج عن  ابي هريرة رواية قال : ' لله تسعة وتسعون اسما ، ماءة الا واحدا ، لا يحفظها واحد  الا دخل الجنة . وهو وتر يحب الوتر ' .
 وفي رواية زهير وعمرو الناقد عن سفيان ان النبي صلي الله عليه وسلم قال :
 ان لله تسعة  وتسعين اسما من حفظها دخل الجنة ، والله وتر يجب الوتر ' . وفي رواية ابن ابي  عمر عن سفيان : ' من احصاها ' .
 واخرجه البخاري من حديث شعيب بن ابي حمزة عن ابي الزناد عن الاعرج  عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال :
 ان لله تسعة وتسعين اسما  ماءة الا  واحدا ، من احصاها دخل الجنة . ' قال البخاري احصاها : حفظها .
 واخرجه مسلم من حديث محمد بن سيرين عن ابي هريرة بنحوه مسندا ،  وليس عنده فيه :
 وتر يحب الوتر . ' ومن حديث همام عن ابي هريرة بنحوه ، وزاد  عن النبي صلي الله عليه وسلم انه قال : ' انه وتر يحب الوتر ' .   
   الخامس والثمانون بعد الماءة : عن نافع بن جبير بن مطعم عن ابي  هريرة الدوسي قال : خرج النبي صلي الله عليه وسلم في طاءفة من النهار ، لا يكلمني ولا اكلمه  حتي اتي سوق بني قينقاع ، فجلس بفناء بيت فاطمة فقال ' اثم لكع ؟ ' فحبسته  شيءا ، فظننت انها تلبسه سخابا او تغسله ، فجاء يشتد حتي عانقه وقبله  وقال : ' اللهم احبه ، واحب من يحبه ' .
 وفي رواية ابن ابي عمر عن سفيان : فقال رسول الله صلي الله عليه وسلم
 اني احبه ، فاحبه ،  واحب من يحبه ' .
 وفي حديث ورقاء بن عمر عن عبيد الله بن ابي يزيد عن نافع ان ابا هريرة  قال :
 كنت مع رسول الله صلي الله عليه وسلم في سوق من اسواق المدينة فانصرف وانصرفت ،  فقال : ' اي لكع  ثلاثا ، ادع الحسن بن علي ' فقام الحسن يمشي وفي عنقه  السخاب فقال النبي صلي الله عليه وسلم بيده هكذا ، وقال الحسن بيده هكذا ، فالتزمه ، وقال : 
 اللهم اني احبه ، فاحببه واحب من يحبه ' .
 قال ابو هريرة :
 فما كان احد احب الي من الحسن بن علي بعدما قال رسول  الله صلي الله عليه وسلم ما قال .
 وليس لنافع بن جبير عن ابي هريرة في الصحيحين غير هذا الحديث الواحد . 
   السادس والثمانون بعد الماءة : عن ابي عبد الرحمن طاوس بن كيسان  عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم ' نحن الاخرون السابقون يوم القيامة ،  اوتوا الكتاب من قبلنا ، واتيناه من بعدهم ، فهذا اليوم الذي اختلفوا فيه ، فهدانا  الله ، فغدا لليهود ، وبعد غد للنصاري ' ، فسكت ثم قال : ' حق علي كل مسلم ان    يغتسل في كل سبعة ايام يوما ، يغسل فيه راسه وجسده ' وليس فيه عند مسلم ذكر  الغسل .
 وفي حديث موسي بن اسماعيل عن وهيب نحوه ، وفيه ذكر الغسل ،  وفيه :
 بيد كل امة اوتوا الكتاب من قبلنا . . . ' .
 واخرجه البخاري من حديث مجاهد عن طاوس تعليقا في الغسل فقط .
 واخرجه بالاسناد من حديث شعيب بن ابي حمزة عن ابي الزناد عن الاعرج  عن ابي هريرة انه سمع رسول الله صلي الله عليه وسلم يقول :
 نحن الاخرون السابقون يوم  القيامة ، بيد انهم اوتوا الكتاب من قبلنا ، ثم هذا يومهم الذي فرض عليهم  فاختلفوا فيه ، فهدانا الله ، فالناس لنا فيه تبع ، اليهود غدا والنصاري بعد غد ' .
 وقد اخرج البخاري قوله عليه السلام ' نحن الاخرون السابقون يوم القيامة ' لم  يزد . من حديث همام وغيره مسندا ' .
 ولمسلم من حديث سفيان بن عيينه عن ابي الزناد عن الاعرج عن ابي هريرة ،  وابن طاوس عن ابيه عن ابي هريرة قال :
 قال رسول الله صلي الله عليه وسلم : ' نحن الاخرون  ونحن السابقون يوم القيامة ، بيد ان كل امة اوتيت الكتاب من قبلنا واوتيناه من  بعدهم ، ثم هذا اليوم الذي كتبه الله علينا ، هدانا الله له ، فالناس لنا فيه تبع ،  اليهود غدا ، والنصاري بعد غد . ' ولم يذكر الغسل .  
 ومن حديث الاعمش عن ابي صالح عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : 
 نحن الاخرون الاولون يوم القيامة ، ونحن اول من يدخل الجنة ، بيد انهم اوتوا  الكتاب من قبلنا . . . ' ثم ذكر نحوه .
 ومن حديث همام بن منبه عن ابي هريرة قال :
 قال رسول الله صلي الله عليه وسلم ، ' نحن  الاخرون السابقون يوم القيامة ، بيد انهم اوتوا الكتاب من قبلنا واوتيناه من  بعدهم ، هذا يومهم الذي فرض عليهم واختلفوا فيه ، فهدانا الله له ، فهم لنا تبع ، فاليهود غدا والنصاري بعد غد ' اغفله ابو مسعود ولم يذكره في ترجمة همام .
 ومن حديث ابي حازم وسلمان مولي عزة عن ابي هريرة ، وعن ربعي بن  حراش عن حذيفة قالا : قال رسول الله صلي الله عليه وسلم :
 اضل الله عن الجمعة من كان  قبلنا ، فكان لليهود يوم السبت ، وكان للنصاري يوم الاحد ، فجاء الله بنا ، فهدانا  الله ليوم الجمعة ، فجعل الجمعة والسبت والاحد ، وكذلك هم تبع لنا يوم القيامة ،  نحن الاخرون من اهل الدنيا ، والاولون يوم القيامة ، المقضي لهم قبل الخلاءق ،  وفي رواية واصل بن عبد الاعلي : ' المقضي بينهم ' . 
   السابع والثمانون بعد الماءة : عن طاوس عن ابي هريرة قال : ضرب  رسول الله صلي الله عليه وسلم مثل البخيل والمتصدق كمثل رجلين عليهما جنتان من حديد ، قد  اضطرت ايديهما الي ثديهما وتراقيهما ، فجعل المتصدق كلما تصدق انبسطت عليه  حتي تغشي انامله ، وتعفو اثره ، وجعل البخيل كلما هم بصدقة قلصت ، واخذت  كل حلقة بمكانها ' . قال : فانا رايت رسول الله صلي الله عليه وسلم يقول باصبعه في جيبه ، فلو  رايته يوسعها ولا توسع .  
 وفي حديث ابن طاوس عن ابيه نحوه ، في اخره قال : فسمع النبي صلي الله عليه وسلم يقول : 
 فيجهد ان يوسعها ولا تتسع ' .
 واخرجه البخاري من حديث شعيب بن ابي حمزة عن ابي الزناد عن الاعرج  عن ابي هريرة عن النبي صلي الله عليه وسلم بنحوه .
 واخرجه تعليقا من حديث الليث عن جعفر بن ربيعة عن الاعرج عن ابي هريرة  عن النبي صلي الله عليه وسلم .
 واخرجه مسلم من حديث سفيان بن عيينة عن ابي الزناد عن الاعرج عن  ابي هريرة عن النبي صلي الله عليه وسلم قال :
 مثل البخيل والمتصدق كمثل رجل عليه جنتان او  جبتان . . ' ثم ذكر معناه . 
   الثامن والثمانون بعد الماءة : عن طاوس عن ابي هريرة عن النبي صلي الله عليه وسلم  قال : ' يحشر الناس علي ثلاث طراءق : راغبين وراهبين ، واثنان علي بعير وثلاثة  علي بعير ، واربعة علي بعير ، وعشرة علي بعير ، وتحشر بقيتهم النار ، تقيل معهم  حيث قالوا : وتبيت حيث باتوا ، وتصبح معهم حيث اصبحوا ، وتمسي معهم  حيث امسوا ' . 
   التاسع والثمانون بعد الماءة : عن طاوس بن كيسان عن ابي هريرة  قال : ' ارسل ملك الموت الي موسي ، فلما جاءه صكه ففقا عينه فرجع الي ربه  قال : ارسلتني الي عبد لا يريد الموت ، فرد الله اليه عينه ، وقال : ارجع اليه فقل له  يضع يده علي متن ثور ، وله بكل ما غطت يده بكل شعرة سنة . قال : اي رب ،  ثم ماذا ؟ قال ثم الموت . قال : فالان ، فسال الله ان يدنيه من الارض المقدسه رمية    بحجر ' فقال رسول الله صلي الله عليه وسلم :
 فلو كنت ثم لاريتكم قبره الي جانب الطريق تحت  الكثيب الاحمر ' .
 واخرجه مسلم من حديث همام بن منبه عن ابي هريرة عن رسول الله صلي الله عليه وسلم  قال :
 جاء ملك الموت الي موسي فقال : اجب ربك . قال : فلطم موسي عين  ملك الموت ففقاها . . . ' ثم ذكره بمعناه . 
   التسعون بعد الماءة : عن طاوس من رواية ابنه عنه عن ابي هريرة قال :  قال سليمان بن داود لاطوفن الليلة بماءة امراة ، تلد كل امراة منهن غلاما يقاتل في  سبيل الله ، فقال له الملك : قل : ان شاء الله . فلم يقل ونسي ، فاطاف بهن ولم  تلد منهن الا امراة نصف انسان . قال النبي صلي الله عليه وسلم : ' لو قال : ان شاء الله ، لم  يحنث ، وكان ارجي لحاجته ' .
 وفي حديث علي بن المديني عن سفيان نحوه وقال :
 تسعين امراة ' وقال : ' ولو  قال : ان شاء الله لم يحنث ، وكان دركا له في حاجته ' قال : وقال مرة قال رسول  الله صلي الله عليه وسلم : ' لو استثني ' .
 وفي رواية ابن ابي عمر : ' سبعين امراة ' .
 واخرجاه من حديث سفيان عن ابي الزناد عن الاعرج عن ابي هريرة عن  النبي صلي الله عليه وسلم مثله او نحوه . اللفظ لمسلم .
 واخرجاه من حديث محمد بن سيرين عن ابي هريرة قال :
 كان لسليمان ستون  امراة ، فقال : لاطوفن عليهن الليلة . . . ' وذكر نحوه ، وفي اخره : فقال رسول  الله صلي الله عليه وسلم : ' ولو كان استثني لولدت كل واحدة منهن غلاما فارسا يقاتل في سبيل  الله ' .  
 واخرجه البخاري تعليقا من حديث جعفر بن ربيعة عن الاعرج عن ابي هريرة  عن رسول الله صلي الله عليه وسلم قال : ' قال سليمان بن داود :
 لاطوفن الليلة علي ماءة امراة   او تسع وتسعين كلهن ياتي بفارس يجاهد في سبيل الله . فقال له صاحبه : قل : ان  شاء الله ، فلم يقل : ان شاء الله ، فلم تحمل منهن الا امراة واحدة ، جاءت بشق  رجل ، والذي نفس محمد بيده لو قال : ان شاء الله ، لجاهدوا في سبيل الله فرسانا  اجمعون ' .
 ومن حديث المغيرة بن عبد الرحمن عن ابي الزناد عن الاعرج عن ابي هريرة  عن النبي صلي الله عليه وسلم قال : قال سليمان بن داود :
 لاطوفن الليلة علي سبعين امراة ،  تحمل كل امراة فارسا يجاهد في سبيل الله ، فقال له صاحبه : ان شاء الله ، فلم  يقل ، فلم تحمل شيءا ، الا واحدا ساقطا احد شقيه ' .
 فقال النبي صلي الله عليه وسلم :
 لو قالها لجاهدوا في سبيل الله ' قال البخاري : وقال شعيب  وابن ابي الزناد : تسعين ، وهو اصح .
 واخرجه بالاسناد من حديث شعيب بن ابي حمزة عن ابي الزناد عن الاعرج  عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : قال سليمان عليه السلام : لاطوفن  الليلة علي تسعين امراة ، كل امراة تاتي بفارس يجاهد في سبيل الله . . ' فذكره ،  وفيه : ' وايم الذي نفسي بيده لو قال : ان شاء الله ، لجاهدوا في سبيل الله فرسانا  اجمعون ' .
 واخرجه مسلم من حديث موسي بن عقبة وورقاء بن عمر عن ابي الزناد عن  الاعرج عن ابي هريرة عن النبي صلي الله عليه وسلم قال :
 قال سليمان . . ' بنحوه ، وكلاهما  قال : تسعين امراة . وفي حديث موسي : ' كلها تحمل غلاما يجاهد في سبيل  الله ' .   
   الحادي والتسعون بعد الماءة : عن طاوس عن ابي هريرة عن النبي صلي الله عليه وسلم  قال : ' فتح اليوم من ردم ياجوج وماجوج مثل هذه ' وعقد وهيب بيده  تسعين .
 وفي حديث مسلم بن ابراهيم عن وهيب ان النبي صلي الله عليه وسلم قال :
 فتح الله من ردم  ياجوج وماجوج مثل هذا ' وعقد بيده تسعين . 
   الثاني والتسعون بعد الماءة : عن نعيم بن عبد الله المجمر عن ابي هريرة  عن النبي صلي الله عليه وسلم قال : ' ان امتي يدعون يوم القيامة غرا محجلين من اثار الوضوء ،  فمن استطاع منكم ان يطيل غرته فليفعل ' .
 وفي رواية عمارة بن غزية الانصاري عن نعيم قال :
 رايت ابا هريرة يتوضا ،  فغسل وجهه ، فاسبغ الوضوء ، ثم غسل يده اليمني حتي اشرع في العضد ، ثم يده  اليسري حتي اشرع في العضد ، ثم مسح راسه ، ثم غسل رجله اليمني حتي اشرع  في الساق ، ثم غسل رجله اليسري حتي اشرع في الساق ، ثم قال : هكذا رايت  رسول الله صلي الله عليه وسلم يتوضا ، وقال : قال رسول الله صلي الله عليه وسلم : ' انتم الغر المحجلون يوم  القيامة من اسباغ الوضوء ، فمن استطاع منكم فليطل غرته وتحجيله ' .
 وفي حديث عمرو بن الحارث عن سعيد بن ابي هلال عن نعيم :
 انه راي ابا  هريرة يتوضا ، فغسل وجهه ويديه حتي كاد يبلغ المنكبين ، ثم غسل رجليه حتي  رفع الي الساقين ، ثم قال : سمعت رسول الله صلي الله عليه وسلم يقول :
 ان امتي ياتون يوم  القيامة غرا محجلين من اثر الوضوء ، فمن استطاع منكم ان يطيل غرته  فليفعل . ' .  
 واخرجه مسلم من حديث ابي حازم سلمان مولي عزة عن ابي هريرة ، وفي  الالفاظ اختلاف بين الرواة : ففي رواية خلف بن خليفة عن ابي مالك الاشجعي  عن ابي حازم انه قال :
 كنت خلف ابي هريرة وهو يتوضا للصلاة ، فكان يمد يده  يده حتي يبلغ ابطه ، فقلت : يا ابا هريرة ، ما هذا الوضوء ؟ فقال : يا بني فروخ ،  انتم ها هنا ؟ لو علمت انكم ها هنا ما توضات هذا الوضوء ، سمعت خليلي صلي الله عليه وسلم  يقول : ' تبلغ الحلية من المءمن حيث يبلغ الوضوء ' لم يزد .
 وفي رواية ابن فضيل عن ابي مالك ان رسول الله صلي الله عليه وسلم قال :
 ترد علي امتي  الحوض وانا اذود الناس عنه كما يذود الرجل ابل الرجل عن ابله ' قالوا : يا  نبي الله ، تعرفنا ؟ قال : ' نعم ، لكم سيما ليست لاحد غيركم ، تردون علي غرا  محجلين من اثار الوضوء ، وليصدن عني طاءفة منكم فلا يصلون ، فاقول : يا رب ،  هءلاء من اصحابي ، فيجيبني ملك فيقول : وهل تدري ما احدثوا بعدك ' .
 وفي رواية مروان الفزاري عن ابي مالك ان رسول الله صلي الله عليه وسلم قال :
 ان حوضي  ابعد من ايلة من عدن ، فهو اشد بياضا من الثلج ، واحلي من العسل باللبن ،  ولانيته اكثر من عدد النجوم ، واني لاصد الناس عنه كما يصد الرجل ابل الناس  عن حوضه ' قالوا : يا رسول الله ، اتعرفنا يومءذ ؟ قال : ' نعم ، لكم سيما ليست  لاحد من الامم ، تردون علي غرا محجلين من اثر الوضوء ' .
 ومن حديث مالك وعبد العزيز بن محمد الدراوردي واسماعيل بن جعفر عن  العلاء بن عبد الرحمن عن ابيه عن ابي هريرة ان رسول الله صلي الله عليه وسلم
 اتي المقبرة فقال :  ' السلام عليكم دار قوم مءمنين ، وانا ان شاء الله بكم للاحقون ، وددت انا قد    راينا اخواننا ' قالوا : اولسنا اخوانك يا رسول الله ؟ قال : ' انتم اصحابي ، واخواننا  الذين لم ياتوا بعد ' قالوا : كيف تعرف من لم يات بعد من امتك يا رسول الله ؟  فقال :
 ارايت لو ان رجلا له خيل غر محجلة بين ظهري خيل دهم بهم ، الا  يعرف خيله ؟ قالوا : بلي يا رسول الله . قال : ' فانهم ياتون غرا محجلين من  الوضوء ، وانا فرطهم علي الحوض . الا ليزادن رجال عن حوضي كما يزاد البعير  الضال ، اناديهم : الا هلم ، فيقال : انهم قد بدلوا بعدك . فاقول : سحقا  سحقا ' .
 وفي حديث مالك :
 فليزدان رجال عن حوضي ' . 
   الثالث والتسعون بعد الماءة : عن نعيم المجمر من رواية مالك عنه عن  ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : ' علي انقاب المدينة ملاءكة لا يدخلها  الطاعون ولا الدجال ' .
 واخرجه مسلم في الدجال بمعناه من حديث اسماعيل بن جعفر عن العلاء بن  عبد الرحمن عن ابيه عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال :
 ياتي المسيح من  قبل المشرق ، وهمته المدينة حتي ينزل دبر احد ، ثم تصرف الملاءكة وجهه قبل  الشام ، وهنالك يهلك ' . 
   الرابع والتسعون بعد الماءة : عن ابي ادريس عاءذ بن عبد الله الخولاني  عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : ' من توضا فليستنثر ، ومن استجمر  فليوتر ' .  
 وفي رواية حرملة عن ابن وهب ان ابا ادريس الخولاني قال :
 انه سمع ابا  هريرة وابا سعيد الخدري يقولان : قال رسول صلي الله عليه وسلم . . . بمثله .
 واخرجه البخاري بزيادة من حديث مالك عن ابي الزناد عن الاعرج عن ابي  هريرة ان رسول الله صلي الله عليه وسلم قال :
 اذا توضا احدكم فليجعل في انفه ، ثم لينثر . ومن  استجمر فليوتر ' واذا استيقظ احدكم من نومه فليغسل يده قبل ان يدخلها في  وضوءه ، فان احدكم لا يدري اين باتت يده ' .
 وهذا الفصل في غسل اليد عند الاستيقاظ من النوم قد اخرجه مسلم من  حديث المغيرة بن عبد الرحمن عن ابي الزناد عن الاعرج . ومن رواية جماعة عن  ابي هريرة . وقد ذكرنا ذلك في اول افراد مسلم ، فهذا الفصل وحده من المتفق  عليه من هذا الوجه .
 واخرج مسلم من حديث سفيان بن عيينه عن ابي الزناد عن الاعرج يبلغ به  النبي صلي الله عليه وسلم قال :
 اذا استجمر احدكم فليستجمر وترا ، واذا توضا احدكم فليجعل  في انفه ماء ثم لينتثر ' .
 ومن حديث همام بن منبه عن ابي هريرة عن رسول الله صلي الله عليه وسلم انه قال :
 اذا  توضا احدكم فليستنشق بمنخريه من الماء ثم لينتثر ' . 
   الخامس والتسعون بعد الماءة : عن عراك بن مالك الغفاري عن ابي  هريرة عن النبي صلي الله عليه وسلم قال : ' ليس علي المسلم صدقه في عبده ولا فرسه '  وفي حديث مخرمة بن بكير عن ابيه ان رسول الله صلي الله عليه وسلم قال :
 ليس في العبد  صدقة الا صدقة الفطر ' .   
   السادس والتسعون بعد الماءة : عن عراك بن مالك عن ابي هريرة عن  النبي صلي الله عليه وسلم قال :
 لا ترغبوا عن اباءكم ، فمن رغب عن ابيه فهو كفر ' . 
   السابع والتسعون بعد الماءة : عن ابي سفيان مولي ابن ابي احمد  عن  ابي هريرة قال : رخص النبي صلي الله عليه وسلم في بيع العرايا بخرصها من الثمر ، ما دون خمسة  اوسق ، او في خمسة او سبعة ' شك داود بن الحصين الراوي عن ابي سفيان . 
   الثامن والتسعون بعد الماءة : عن ثابت بن عياض الاعرج مولي عبد  الرحمن بن زيد بن الخطاب ، انه سمع ابا هريرة يقول : قال رسول الله صلي الله عليه وسلم :  ' يسلم الراكب علي الماشي ، والماشي علي القاعد ، والقليل علي الكثير ' .
 واخرجه البخاري تعليقا من حديث عطاء بن يسار عن ابي هريرة قال : قال  رسول الله صلي الله عليه وسلم :
 يسلم الصغير علي الكبير ، والمار علي القاعد ، والقليل علي  الكثير ' .
 وبالاسناد من حديث همام بن منبه عن ابي هريرة عن النبي صلي الله عليه وسلم بنحوه  ومعناه . 
   التاسع والتسعون بعد الماءة : عن الاعمش ، سليمان بن مهران عن ابي  صالح ذكوان عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم :
 صلاة الرجل في  الجماعة تضعف علي صلاته في بيته وفي سوقه خمسا وعشرين ضعفا ، وذلك انه  اذا توضا فاحسن الوضوء ، ثم خرج الي المسجد لا يخرجه الا الصلاة ، لم يخط  خطوة الا رفعت له بها درجة وحط عنه بها خطيءة ، فاذا صلي لم نزل الملاءكة    تصلي عليه ما دام في مصلاة :
 اللهم صل عليه ، اللهم ارحمه ، فلا يزال احدكم  في مصلاة ما انتظر الصلاة ' .
 وفي حديث ابي كريب وغيره عن ابي معاوية عن الاعمش نحوه ، الا انه قال  فيه
 فاذا دخل المسجد كان في صلاة ما كانت الصلاة تحبسه ' . وزاد في دعاء  الملاءكة : ' اللهم اغفر له ، اللهم تب عليه ، ما لم يءذ فيه ، ما لم يحدث فيه ' .
 واخرجا جميعا فصلا منه في انتظار الصلاة من حديث مالك عن ابي الزناد عن  الاعرج عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال :
 لا يزال احدكم في صلاة ما  دامت الصلاة تحبسه ، لا يمنعه ان ينقلب الي اهله الا الصلاة ' .
 وفي اول حديث البخاري زيادة ليست عند مسلم بهذا الاسناد : ان رسول الله  صلي الله عليه وسلم : قال :
 الملاءكة تصلي علي احدكم ما دام في مصلاه ما لم يحدث : اللهم اغفر  له ، اللهم ارحمه ' ثم قال متصلا به : ' لا يزال احدكم في صلاة ' وذكر الفصل  الاخر الي اخره .
 وجعل هذا ابو مسعود من افراد مسلم وهما منه ، ولم يتامل ما بعد الزيادة التي  في اول حديث البخاري ، وهو الذي اخرج مسلم بعينه ، فصح انه لهما ، والزيادة  من افراد البخاري بهذا الاسناد .
 واخرجه البخاري من حديث عبد الرحمن بن ابي عمرة عن ابي هريرة عن  النبي صلي الله عليه وسلم قال :
 احدكم في صلاة ما دامت الصلاة تحبسه ، والملاءكة تقول : اللهم  اغفر له وارحمه ، ما لم يقم من مصلاه او يحدث ' .  
 ومن حديث سعيد بن ابي سعيد المقبري عن ابي هريرة قال : قال النبي صلي الله عليه وسلم : 
 لا يزال العبد في صلاة ما كان في المسجد ينتظر الصلاة ما لم يحدث ' فقال رجل  اعجمي : ما الحدث يا ابا هريرة ؟ قال : الصوت ، يعني الضرطة .
 واخرجه مسلم من حديث ايوب عن محمد بن سيرين عن ابي هريرة قال : قال  رسول الله صلي الله عليه وسلم :
 الملاءكة تصلي علي احدكم ما دام في مجلسه ، تقول : اللهم  اغفر له ، اللهم ارحمه ، ما لم يحدث ، واحدكم في صلاة ما كانت الصلاة  تحبسه ' .
 ومن حديث ابي رافع الصاءغ عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال :
 لا يزال  العبد في صلاة ما كان في مصلاه ينتظر الصلاة ، فتقول الملاءكة : اللهم اغفر له ،  اللهم ارحمه ، حتي ينصرف او يحدث . ' قلت : ما يحدث ؟ قال : يفسو او  يضرط .
 ومن حديث الزهري عن الاعرج عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال : 
 احدكم ما قعد ينتظر الصلاة في صلاة ما لم يحدث ، تدعو له الملاءكة : اللهم اغفر  له ، اللهم ارحمه ' .
 ومن حديث همام بن منبه عن ابي هريرة عن النبي صلي الله عليه وسلم بنحوه .
 وحكي ابو مسعود ان فيه : ان النبي صلي الله عليه وسلم قال :
 الملاءكة تصلي علي احدكم ما  دام في مصلاه . ' 
   الماءتان : عن الاعمش عن ابي صالح عن ابي هريرة قال : قال رسول  الله صلي الله عليه وسلم : ' لعن الله السارق يسرق البيضه فتقطع يده ، ويسرق الحبل فتقطع يده '    زاد في رواية حفص بن غياث : قال الاعمش : كانوا يرون انه بيض  الحديد ، والحبل كانوا يرون انه منها ما يساوي دراهم . 
   الاول بعد الماءتين : عن سليمان الاعمش عن ذكوان بن صالح عن ابي  هريرة عن النبي صلي الله عليه وسلم قال : ' من تردي من حبل فقتل نفسه فهو في نار جهنم يتردي  فيها خالدا مخلدا فيها ابدا ، ومن تحسي سما فقتل نفسه فسمه في يده يتحساه في  نار جهنم خالدا مخلدا فيها ابدا ، ومن قتل نفسه بحديدة فحديدته في يده  يتوجا بها في بطنه في نار جهنم خالدا مخلدا فيها ابدا ' . 
   الثاني بعد الماءتين : عن الاعمش عن ابي صالح عن ابي هريرة قال :  قال رسول الله صلي الله عليه وسلم : ' ثلاثة لا يكلمهم الله يوم القيامة ، ولا ينظر اليهم ، ولا  يزكيهم ، ولهم عذاب اليم : رجل علي فضل ماء بالفلاة يمنعه من ابن السبيل .
 ورجل بايع رجلا بسلعة بعد العصر فحلف له بالله لاخذها بكذا وكذا ، فصدقه ،  وهو علي غير ذلك . ورجل بايع اماما ، لا يبايعه الا لدنيا ، فان اعطاه منها وفي ،  وان لم يعطه منها لم يف ' وفي حديث جرير بن عبد الحميد : :
 ورجل ساوم رجلا  بسلعة ' . وفي حديث عبد الواحد بن زياد : ' وان اعطاه منها رضي ، وان لم يعطه  منها سخط ' .
 واخرجاه من حديث عمرو بن دينار عن ابي صالح السمان عن ابي هريرة عن  النبي صلي الله عليه وسلم قال :
 ثلاثة لا يكلمهم الله ولا ينظر اليهم : رجل حلف علي سلعة : لقد  اعطي بها اكثر مما اعطي وهو كاذب ، ورجل حلف علي يمين كاذبة بعد العصر  ليقتطع بها مال امرء مسلم ، ورجل منع فضل ماء ، فيقول الله له : اليوم امنعك  فضلي كما منعت فضل ما لم تعمل يداك ' لفظ حديث عبد الله بن محمد عن    سفيان . قال البخاري : وقال علي : حدثنا سفيان غير مرة عن عمرو سمع ابا  صالح يبلغ به النبي صلي الله عليه وسلم . وقال عمرو الناقد عنه : اراه مرفوعا .
 وليس لعمرو بن دينار عن ابي صالح في مسند ابي هريرة من الصحيحين غير  هذا الحديث الواحد . 
   الثالث بعد الماءتين : عن الاعمش ابي صالح عن ابي هريرة عن النبي  صلي الله عليه وسلم قال : ' بين النفختين اربعون ' قالوا : يا ابا هريرة ، اربعين يوما ؟ قال : ابيت .
 قالوا : اربعون سنة ؟ قال ابيت . قالوا : اربعون شهرا ؟ قال : ابيت . ' ويبلي كل  شء من الانسان الا عجب ذنبه ، فيه يركب الخلق ' .
 زاد في حديث ابي معاوية عن الاعمش قال :
 ثم ينزل الله من السماء ماء ،  فينبتون كما ينبت البقل ، ليس من الانسان شء الا يبلي ، الا عظما واحدا وهو  عجب الذنب ، ومنه يركب الخلق يوم القيامة ' .
 واخرج مسلم منه طرفا من حديث المغيرة الحزامي عن ابي الزناد عن الاعرج  عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال :
 كل ابن ادم ياكله التراب الا عجب  الذنب ، منه خلق وفيه يركب ' .
 ومن حديث همام بن منبه عن ابي هريرة عن رسول الله صلي الله عليه وسلم قال :
 ان في  الانسان عظما لا تاكله الارض ابدا ، فيه يركب يوم القيامة ' . قالوا : اي عظم هو  يا رسول الله ؟ قال : ' عجب الذنب ' .   
   الرابع بعد الماءتين : عن الاعمش عن ابي صالح عن ابي هريرة قال :  قال رسول الله صلي الله عليه وسلم : ' اثقل صلاة علي المنافقين صلاة العشاء وصلاة الفجر ، لو  يعلمون ما فيهما لاتوهما ولو حبوا ، ولقد هممت ان امر بالصلاة فتقام ، ثم امر  رجلا يصلي بالناس ، ثم انطلق معي برجال معهم حزم من حطب الي قوم  لا يشهدون الصلاة ، فاحرق عليهم بيوتهم بالنار ' وفي حديث حفص بن غياث عن  الاعمش نحوه ، وقال في اخره : ' فاحرق علي من لا يخرج الي الصلاة ويقدر ' .
 واخرج البخاري الفصل الثاني من حديث مالك عن ابي الزناد عن الاعرج عن  ابي هريرة ان رسول الله صلي الله عليه وسلم قال :
 والذي نفسي بيده ، لقد هممت ان امر بحطب  فيحطب ، ثم امر بالصلاة فيءذن لها ، ثم امر رجلا يءم الناس ، ثم اخالف الي  رجال فاحرق عليهم بيوتهم . والذي نفسي بيده ، لو يعلم احدهم انه يجد عرقا  سمينا ، او مرماتين لشهد العشاء ' .
 ومن حديث سعد بن ابراهيم عن حميد بن عبد الرحمن عن ابي هريرة عن  النبي صلي الله عليه وسلم قال :
 لقد هممت ان امر بالصلاة فتقام ، ثم اخالف الي منازل قوم لا  يشهدون الصلاة فاحرق عليهم لم يزد .
 واخرجه مسلم من حديث سفيان بن عيينة عن ابي الزناد عن الاعرج عن ابي  هريرة : ان رسول الله صلي الله عليه وسلم
 فقد ناسا في بعض الصلوات فقال : ' لقد هممت ان  امر رجلا يصلي بالناس ، ثم اخالف الي رجال يتخلفون عنها فامر بهم فيحرقوا  عليهم بحزم الحطب بيوتهم ، ولو علم احدهم انه يجد عظما سمينا لشهدها ' يعني  صلاة العشاء .  
 ومن حديث همام بن منبه عن ابي هريرة عن رسول الله صلي الله عليه وسلم :
 لقد هممت ان  امر فتياني ان يستعدوا لي بحزم من حطب ، ثم امر رجلا يصلي بالناس ، ثم تحرق  بيوت علي من فيها ' .
 ومن حديث يزيد بن الاصم عن ابي هريرة عن النبي صلي الله عليه وسلم بنحوه . 
   الخامس بعد الماءتين : عن الاعمش عن ابي صالح عن ابي هريرة قال :  سمعت رسول الله صلي الله عليه وسلم يقول : ' لا يصومون احدكم يوم الجمعة الا يوما قبله او  بعده ' .
 وفي حديث ابي معاوية عن الاعمش :
 لا يصم احدكم يوم الجمعة الا ان  يصوم قبله او بعده ' .
 واخرج مسلم من حديث محمد بن سيرين عن ابي هريرة عن النبي صلي الله عليه وسلم قال : 
 لا تختصوا ليلة الجمعة بقيام من بين الليالي ، ولا تختصوا يوم الجمعة بصيام من  بين الايام ، الا ان يكون في صوم يصوم احدكم ' . 
   السادس بعد الماءتين : عن الاعمش عن ابي صالح عن ابي هريرة قال :  قال رسول الله صلي الله عليه وسلم : ' لان يمتلء جوف احدكم قيحا يريه خير من ان يمتلء  شعرا ' . 
   السابع بعد الماءتين : عن عبد الله بن دينار عن ابي صالح عن ابي هريرة  عن النبي صلي الله عليه وسلم قال : ' الايمان بضع وستون شعبة ، والحياء شعبة من الايمان ' .
 وفي حديث سليمان بن بلال عن عبد الله بن دينار :
 بضع وسبعون ' . وفي  رواية سهيل عن عبد الله بن دينار : ' الايمان بضع وسبعون او بضع وستون    شعبة ، فافضلها قول لا اله الا الله ، وادناها اماطة الاذي عن الطريق ، والحياء  شعبة من الايمان ' . 
   الثامن بعد الماءتين : عن عبد الله بن دينار عن ابي صالح عن ابي هريرة  ان رسول الله صلي الله عليه وسلم قال : ' ان مثلي ومثل الانبياء من قبلي كمثل رجل بني بيتا  فاحسنه واجمله ، الا موضع لبنة من زاوية من زواياه ، فجعل الناس يطوفون  ويعجبون له ويقولن : هلا وضعت هذه اللبنة ؟ قال : فانا اللبنة ، وانا خاتم  النبين ' .
 وقد رواه ابو صالح عن ابي سعيد الخدري .
 واخرجه مسلم من حديث سفيان بن عيينة عن ابي الزناد عن الاعرج عن ابي  هريرة عن النبي صلي الله عليه وسلم بنحوه الي قوله :
 فكنت انا اللبنة ' .
 ومن حديث همام بن منبه عن ابي هريرة عن النبي صلي الله عليه وسلم قال :
 مثلي ومثل  الانبياء من قبلي كمثل رجل ابتني بيوتا فاحسنها واجملها واكملها ، الا موضع لبنة  من زاوية من زواياها ، فجعل الناس يطوفون ويعجبهم البنيان ، فيقولون : الا  وضعت ها هنا لبنة فيتم بنيانك ' . فقال محمد صلي الله عليه وسلم : ' وكنت انا اللبنة ' . 
   التاسع بعد الماءتين : عن سمي مولي ابي بكر بن عبد الرحمن عن ابي  صالح السمان عن ابي هريرة ان النبي صلي الله عليه وسلم قال : ' السفر قطعة من العذاب ، يمنع  احدكم نومه وطعامه ، فاذا قضي نهمته من وجهه فليعجل الي اهله ' .   
   العاشر بعد الماءتين : عن ابي صالح عن ابي هريرة عن النبي صلي الله عليه وسلم قال :  تعوذوا بالله من جهد البلاء ، ودرك الشقاء ، وسوء القضاء ، وشماتة الاعداء ' لفظ  حديث مسدد عن سفيان لم يزد .
 وفي رواية علي بن عبد الله قال : قال سفيان :
 الحديث ثلاث ، وزدت انا  واحدة لا ادري ايتهن . وقال عمرو الناقد : قال سفيان : اشك اني زدت واحدة  منها . 
   الحادي عشر بعد الماءتين : عن سمي عن ابي صالح عن ابي هريرة ان  رسول الله صلي الله عليه وسلم : ' العمرة الي العمرة كفارة لما بينهما ، والحج المبرور ليس له جزاء  الا الجنة ' .
 واخرجاه بمعناه من حديث ابي حازم مولي عزة عن ابي هريرة قال : سمعت  النبي صلي الله عليه وسلم يقول :
 من حج لله عز وجل فلم يرفث ولم يفسق رجع كيوم ولدته  امه ' . 
   الثاني عشر بعد الماءتين : عن سمي مولي ابي بكر بن عبد الرحمن عن  ابي صالح عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال : بينما رجل يمشي بطريق اشتد  عليه العطش ، فوجد بءرا ، فنزل فيها فشرب ، ثم خرج ، فاذا كلب يلهث ياكل  الثري من العطش ، فقال الرجل : لقد بلغ هذا الكلب من العطش مثل الذي كان  بلغ مني ، فنزل البءر فملا خفه ماء ، ثم امسكه بفيه حتي رقي ، فسقي الكلب  فشكر الله له فغفر له ' قالوا : يا رسول الله ، وان لنا في البهاءم اجرا ' ؟ فقال : ' في  كل كبد رطبة اجر ' .  
 واخرجاه من حديث محمد بن سيرين عن ابي هريرة عن النبي صلي الله عليه وسلم :
 ان امراة  بغيا رات كلبا في يوم حار يطيف ببءر ، قد ادلع لسانه من العطش ، فنزعت له  موقها ، فغفر لها ' .
 وفي حديث ايوب عن محمد بن سيرين ، ' بينما كلب يطيف بركية قد كاد  يقتله العطش ، اذ راته بغي من بغايا بني اسراءيل ، فنزعت موقها فاستقت له به ،  فسقته اياه ، فغفر لها به ' .
 واخرج البخاري من حديث عبد الله بن دينار عن ابي صالح عن ابي هريرة عن  النبي صلي الله عليه وسلم :
 ان رجلا راي كلبا ياكل الثري من العطش ، فاخذ الرجل خفه ، فجعل  يغرف له به حتي ارواه ، فشكر الله له فادخله الجنة ' . 
   الثالث عشر بعد الماءتين : عن سمي عن ابي صالح عن ابي هريرة ان  رسول الله صلي الله عليه وسلم قال : ' لو يعلم الناس ما في النداء والصف الاول ثم لم يجدوا الا  ان يستهموا عليه لاستهموا . ولو يعملون ما في التهجير لاستبقوا اليه . ولو  يعلمون ما في العتمة والصبح لاتوهما ولو حبوا ' .
 وفي حديث قتيبة عن مالك عن سمي باطول من هذا : ان رسول الله صلي الله عليه وسلم قال : 
 بينما رجل يمشي بطريق وجد غصن شوك علي الطريق فاخره ، فشكر الله له فغفر  له ' . ثم قال : ' الشهداء خمسة : المطعون ، والمبطون ، والغريق ، وصاحب الهدم ،    والشهيد في سبيل الله ' قال :
 ولو يعلم الناس ما في النداء والصف الاول ' ثم  ذكر مثل ما تقدم في هذين ، وفي التهجير والعتمة والصبح .
 وهو ايضا عن يحيي بن يحيي عن مالك بطوله في الخمسة فصول ، ولكن فرقه  مسلم .
 واخرج مسلم حديث الصف من رواية ابي رافع الصاءغ عن ابي هريرة ان  رسول الله صلي الله عليه وسلم قال :
 لو تعلمون  او يعلمون  ما في الصف المقدم لكانت قرعة '  وفي حديث محمد بن حرب الواسطي : ' ما في الصف الاول ما كانت الا  قرعة ' .
 وليس لمحمد بن حرب في صحيح مسلم غير هذا الحديث الواحد ، وهو  شيخه .
 ولمسلم ايضا من حديث عبد العزيز بن محمد وجرير بن عبد الحميد عن سهيل  ابن ابي صالح عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم :
 خير صفوف الرجال  اولها ، وشرها اخرها ، وخير صفوف النساء اخرها ، وشرها اولها ' . 
   الرابع عشر بعد الماءتين : عن سمي عن ابي صالح عن ابي هريرة قال :  ' من قال : لا اله الا الله وحده لا شريك له ، له الملك وله الحمد وهو علي كل  شء قدير ، في يوم ماءة مرة كانت له عدل عشر رقاب ، وكتبت له ماءة حسنة ،  ومحيت عنه ماءة سيءة ، وكانت له حرزا من الشيطان يومه ذاك حتي يمسي ، ولم    يات احد بافضل مما جاء به الا رجل عمل اكثر منه .
 ومن قال سبحان الله  وبحمده ، في يوم ماءة مرة ، حطت خطاياه وان كانت مثل زبد البحر ' .
 وفي حديث سهيل عن سمي ان رسول الله صلي الله عليه وسلم قال :
 من قال حين يصبح  وحين يمسي : سبحان الله وبحمده  ماءة مرة ، لم يات احد يوم القيامة بافضل مما  جاء به ، الا احد قال مثل ما قال او زاد عليه ' . 
   الخامس عشر بعد الماءتين : عن سمي عن ابي صالح عن ابي هريرة ان  رسول الله صلي الله عليه وسلم قال : اذا قال الامام : سمع الله لمن حمده ، فقولوا اللهم ربنا لك  الحمد ، فانه من وافق قوله قول الملاءكة غفر ما تقدم من ذنبه ' .
 واخرجه مسلم من حديث يعقوب بن عبد الرحمن عن سهيل عن ابيه عن ابي  هريرة عن النبي صلي الله عليه وسلم بمعني حديث سمي . 
   السادس عشر بعد الماءتين : عن سمي عن ابي صالح عن ابي هريرة :  ان فقراء المهاجرين اتوا رسول الله صلي الله عليه وسلم فقالوا : ذهب اهل الدثور بالدرجات  العلي والنعيم المقيم ، فقال : ' وما ذاك ؟ ' قالوا : يصلون كما نصلي ، ويصومون  كما نصوم ، ويتصدقون ولا نتصدق ، ويعتقون ولا نعتق . فقال رسول الله صلي الله عليه وسلم :  ' افلا اعلمكم شيءا تدركون به من سبقكم ، وتسبقون به من بعدكم ، ولا يكون  احد افضل منكم ، الا من صنع مثل ما صنعتم ؟ ' قالوا : بلي يا رسول الله . قال : 
 تسبحون وتكبرون وتحمدون دبر كل صلاة ثلاثا وثلاثين مرة ' .  
 قال ابو صالح : فرجع فقراء المهاجرين الي رسول الله صلي الله عليه وسلم فقالوا :
 سمع  اخواننا اهل الاموال بما فعلنا ففعلوا مثله . فقال رسول الله صلي الله عليه وسلم : ' ذلك فضل الله  يءتيه من يشاء ' .
 قال سمي : فحدثت بعض اهل هذا الحديث فقال : وهمت ؛ انما قال لك : 
 تسبح الله ثلاثا وثلاثين ، وتحمد الله ثلاثا وثلاثين ، وتكبر الله ثلاثا وثلاثين ' .
 فرجعت الي ابي صالح فقلت ذلك . فاخذ بيدي فقال : الله اكبر ، وسبحان الله ،  والحمد لله ، والله اكبر ، وسبحان الله ، والحمد لله ، حتي تبلغ من جميعهم ثلاثة  وثلاثين .
 قال ابن عجلان : فحدثت بهذا الحديث رجاء بن حيوة ، فحدثني بمثله عن ابي  صالح عن ابي هريرة عن رسول الله صلي الله عليه وسلم . لفظ حديث مسلم .
 وليس عند البخاري قول ابي صالح : فرجع فقراء المهاجرين ، وما قالوا ، وما قال  لهم رسول الله صلي الله عليه وسلم . وعنده بعد قوله :
 تسبحون وتحمدون وتكبرون خلف كل  صلاة ثلاثا وثلاثين ' فاختلفنا بيننا ، فقال بعضنا : نسبح ثلاثا وثلاثين ، ونحمد  ثلاثا وثلاثين ، ونكبر اربعا وثلاثين . فرجعت اليه فقال : تقول سبحان الله ،  والحمد لله ، والله اكبر ، حتي يكون منهن كلهن ثلاث وثلاثون .
 وللبخاري من حديث ورقاء عن سمي عن ابي صالح عن ابي هريرة قال : 
 قالوا : يا رسول الله ، ذهب اهل الدثور بالدرجات والنعيم المقيم . . وذكر نحوه  الي قوله : ' افلا اخبركم بامر تدركون به من كان قبلكم ، وتسبقون من جاء  بعدكم ، ولا ياتي احد مثل ما جءتم به الا من جاء بمثله ؟ تسبحون في دبر كل صلاة  عشرا ، وتحمدون عشرا . وتكبرون عشرا ' .  
 قال البخاري : تابعه عبيد الله بن عمر عن سمي ، ورواه ابن عجلان عن سمي ،  ورجاء بن حيوة ، ورواه جرير بن عبد العزيز بن رفيع عن ابي صالح عن ابي  الدرداء . ورواه سهيل عن ابيه عن ابي هريرة عن النبي صلي الله عليه وسلم . انتهي كلام  البخاري .
 واخرجه مسلم من حديث روح بن القاسم عن سهيل عن ابيه عن ابي هريرة  انهم قالوا :
 يا رسول الله ذهب اهل الدثور بالدرجات العلي والنعيم المقيم  ثم ذكر  مثل ما في الحديث الاول ، وادرج في حديث ابي هريرة قول ابي صالح : ثم رجع  فقراء المهاجرين  ولم يجعله من قول ابي صالح ، وذكره ، وزاد في اخره : يقول  سهيل : احدي عشرة ، احدي عشرة ، احدي عشرة .
 ومن حديث عطاء بن يزيد الليثي عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : 
 من سبح لله في دبر كل صلاة ثلاثا وثلاثين ، وحمد الله ثلاثا وثلاثين ، وكبر الله  ثلاثا وثلاثين ، فذلك تسعة وتسعون ، وقال تمام الماءة : لا اله الا الله وحده  لا شريك له ، له الملك وله الحمد وهو علي كل شء قدير ، غفرت له خطاياه وان  كانت مثل زبد البحر ' . 
   السابع عشر بعد الماءتين : عن يحيي بن سعيد الانصاري قال : حدثني  ابو صالح عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : ' لولا ان اشق علي المسلمين  ما تخلفت عن سرية ، ولكن لا اجد حمولة ولا اجد ما احملهم عليه ، ويشق علي  ان يتخلفوا عني ، ولوددت اني قاتلت في سبيل الله فقتلت ثم احييت ، ثم قتلت  ثم احييت . ' لفظ حديث البخاري . وقد ادرجه مسلم علي ما قبله .
 وليس ليحيي بن سعيد الانصاري في المتفق عليه من مسند ابي هريرة غير  هذا .  
 واخرجه البخاري من حديث سعيد بن المسيب وابي سلمة عن ابي هريرة قال : 
 سمعت رسول الله صلي الله عليه وسلم يقول : ' والذي نفسي بيده ، لولا ان رجالا من المءمنين  لا تطيب انفسهم بان يتخلفوا عني ، ولا اجد ما احملهم عليه ، ما تخلفت عن  سرية تغزو في سبيل الله . والذي نفسي بيده لوددت اني اقتل في سبيل الله ثم  احيا ، ثم اقتل ثم احيا ، ثم اقتل ثم احيا ، ثم اقتل ' .
 وقد اخرج البخاري منه طرفا من حديث مالك عن ابي الزناد عن الاعرج عن  ابي هريرة ان رسول الله صلي الله عليه وسلم قال :
 والذي نفسي بيده لوددت اني اقاتل في سبيل  الله فاقتل ثم احيا ثم اقتل ، ثم احيا ثم اقتل ' فكان ابو هريرة يقوله ثلاثا اشهد  بالله .
 واخرجاه من حديث ابي زرعة هرم بن عمرو عن ابي هريرة : فاما البخاري  فاخرجه في ' الايمان ' متصلا بحديث اخر ، اوله :
 انتدب الله لمن خرج في  سبيله ' .
 واما مسلم فاخرجه في اول ' الجهاد ' مع حديثين متصلين به في اوله من  حديث ابي زرعة ايضا عن ابي هريرة عن رسول الله صلي الله عليه وسلم . ثم قال :
 والذي نفس  محمد بيده ، لولا ان يشق علي المسلمين ما قعدت خلاف سرية تغزو في سبيل الله  ابدا ، ولكن لا اجد سعة فاحملهم ، ولا تجدون سعة ويشق عليهم ان يتخلفوا  عني . والذي نفس محمد بيده ، لوددت اني اغزو في سبيل الله فاقتل ، ثم اغزو  فاقتل ، ثم اغزو فاقتل ' لفظ حديث مسلم .  
 واخرجه مسلم ايضا من حديث همام بن منبه عن ابي هريرة عن رسول الله  صلي الله عليه وسلم قال :
 والذي نفس محمد في يده ، لولا ان اشق علي المءمنين ، ما قعدت  خلف سرية تغزو في سبيل الله ، ولكن لا اجد سعة فاحملهم ، ولا يجدون سعة  فيتبعوني ، ولا تطيب انفسهم ان يقعدوا بعدي ' . 
   الثامن عشر بعد الماءتين : عن زيد بن اسلم عن ابي صالح السمان عن  ابي هريرة ان رسول الله صلي الله عليه وسلم قال : ' الخيل لثلاثة : لرجل اجر ، ولرجل ستر ،  وعلي رجل وزر . فاما الذي له اجر فرجل ربطها في سبيل الله ' زاد حفص بن  ميسرة : ' لاهل الاسلام ، فاطال لها في مرج او روضة ، فما اصابت في طيلها  ذلك من المرج او الروضة كانت له حسنات ، ولو انه انقطع طيلها فاسنتت شرفا  او شرفين كانت له اثارها واوراثها حسنات ، ولو انها مرت بنهر فشربت منه ولم  يرد ان يسقيها كان ذلك حسنات له ، فهي لذلك الرجل اجر . ورجل ربطها تغنيا  وتعففا ، ثم لم ينس حق الله في رقابها ولا ظهورها ، فهي لذلك ستر . ورجل  ربطها فخرا ورياء ونواء لاهل الاسلام  وقال حفص الصنعاني : ' علي اهل  الاسلام  فهي علي ذلك وزر ' .
 وسءل رسول الله صلي الله عليه وسلم عن الحمر فقال :
 ما انزل علي فيها شء الا هذه الاية  الجامعة الفاذة : @QB@ فمن يعمل مثقال ذرة خيرا يره ومن يعمل مثقال ذرة شرا يره @QE@  [ الزلزلة ] .
 وفي حديث حفص بن ميسرة :
 فما اكلت من ذلك المرج او الروضة من شء  الا كتب له عدد ما اكلت حسنات ، وكتب له عدد ارواثها وابوالها حسنات ،    ولا تقطع طولها فاسنتت شرفا او شرفين الا كتب له عدد اثارها وارواثها حسنات ،  ولا مر بها صاحبها علي نهر فشربت منه ، ولا يريد ان يسقيها الا كتب له عدد ما  شربت حسنات ' ثم ذكر نحوه . . .
 وفي اول هذا الحديث لمسلم زيادة في مانع الزكاة يتصل به ، لم يذكرها ابو  مسعود في ترجمة زيد بن اسلم عن ابي صالح ، ولا نبه عليها . واولها : قال رسول  الله صلي الله عليه وسلم :
