 $ الصميل بن حاتم بن عمر بن جذع بن شمر بن ذي الجوشن الضبابي الكلبي «»
 وهو من اشراف عرب الكوفة.
 اوليته: قال صاحب الكتاب «الخزاءني» : جده «» احد قتلة الحسين بن علي والذي قدم براسه علي يزيد بن معاوية، فلما قام المختار «» ثاءرا بالحسين فر عنه شمر ولحق بالشام فاقام بها في عز ومنعة. ولما خرج كلثوم بن عياض غازيا الي المغرب، كان الصميل ممن ضرب عليه البعث في اشراف اهل الشام. ودخل الاندلس في طالعة بلج بن بشر القشيري، فشرف ببدنه الي شرف تقدم له، ورد ابن حيان هذا. وقال في كتاب «بهجة الانفس، وروضة الانس» : كان الصميل بن حاتم هذا جده شمر قاتل الحسين، رضي الله عنه، من اهل الكوفة، فلما قتله، تمكن منه المختار فقتله، وهدم داره، فارتحل ولده من الكوفة، فراس بالاندلس، وفاق اقرانه بالنجدة والسخاء.
 حاله: قال «» : كان شجاعا، نجدا، جوادا، كريما، الا انه كان رجلا اميا لا يقرا ولا يكتب، وكان «» له في قلب الدول وتدبير الحروب، اخبار مشهورة.
 من اخباره: حكي ابن القوطية، قال «» : مر الصميل بمعلم يتلو: وتلك الايام نداولها بين الناس «» ، فوقف يسمع، ونادي بالمعلم: يا هناه، كذا نزلت
 
 هذه الاية؟ فقال: نعم، فقال: اري والله ان سيشركنا في هذا الامر العبيد والاراذل والسفلة.
 خبره في الجود: قال: كان ابو الاجرب الشاعر «» وقفا علي امداح الصميل، وهو القاءل: [الوافر]
 بني لك حاتم بيتا رفيعا ~ رايناه علي عمد طوال
 وقد كان ابتني شمر وعمرو ~ بيوتا غير ضاحية الظلال
 فانت ابن الاكارم من معد ~ تعلج للاباطح «» والرمال
 وقارضه باجزاله لعطاءه وانتماءه في ثوابه، بان اغلظ القسم علي نفسه بان لا يراه الا اعطاه ما حضره، فكان ابو الاجرب قد اعتمد اجتنابه في اللقاء حياء منه وابقاء علي ماله، فكان لا يزوره الا في العيدين قاضيا لحقه. وقد لقيه يوما مواجهة ببعض الطريق، والصميل راكب، ومعه ابناه، فلم يحضره ما يعطيه، فارجل احد ابنيه، واعطاه دابته، فضرب في صنعه، وفيه يقول من قصيدة:
 [الكامل]
 دون الصميل شريعة مورودة ~ لا يستطيع لها العدو ورودا
 فت الوري وجمعت اشتات العلا ~ وحويت مجدا لا ينال وجودا
 فاذا هلكت فلا تحمل فارس ~ سيفا ولا حمل النساء وليدا
 وكان صاحب امره ولاه الاندلس قبل الامويين؛ لهم الاسماء وله معني الامرة، وكان مظفر الحروب، سديد الراي، شهير الموقف، عظيم الصبر. واوقع باليمانية وقاءع كثيرة، منها وقيعة شقندة، ولم يكن بالاندلس مثلها، اثخن فيها القتل باليمانية.
 انفته: قال: وكان ابيا للضيم، محاميا عن العشيرة، كلم ابا الخطار الامير في رجل من قومه انتصر به، فافجمه، ورد عليه، فامر به، فتعتع ومالت عمامته، فلما خرج قال له بعض من علي باب الامير: يا ابا الجوشن، ما باب عمامتك ماءلة؟
 فقال: ان كان لي قوم فسيقيمونها، وخرج من ليلته، فافسد ملكه.
 
 وفاءه: وخبر وفاءه مشهور، فيما كان من جوابه لرسولي عبد الرحمن بن معاوية اليه، بما قطع به رجاء الهوادة في امر اميره يوسف بن عبد الرحمن الفهري، والتستر مع ذلك عليهما، فلينظر في كتاب «المقتبس» .
 دخوله غرناطة: ولما صار الامر الي عبد الرحمن بن معاوية، صقر بني امية، وقهر الامير يوسف الفهري ووزيره الصميل، اذ عزله الناس، ورجع معه يوسف الفهري والصميل الي قرطبة، ولم يلبثا ان نكثا، ولحقا فحص غرناطة، ونازلهما الامير عبد الرحمن بن معاوية في خبر طويل، واستنزلهما عن عهد، وعاد الجميع الي قرطبة، وكان يوسف والصميل يركبان الي القصر كل جمعة الي ان مضيا لسبيلهما. وكان عبد الرحمن بن معاوية يسترجع ويقول: ما رايت مثله رجلا. لقد صحبني من البيرة الي قرطبة، فما مست ركبتي ركبته، ولا خرجت دابته عن دابتي.
  ومن الكتاب والشعراء
 $ صفوان بن ادريس بن ابراهيم بن عبد الرحمن بن عيسي ابن ادريس التجيبي «»
 من اهل مرسية، يكني ابا بجر «» .
 حاله: كان «» اديبا، حسيبا جليلا، اصيلا، ممتعا من الظرف، ريان من الادب، حافظا، حسن الخط، سريع البديهة، ترف النشاة، علي تصاون وعفاف، جميلا سريا، سمحا ذكيا، مليح العشرة، طيب النفس، ممن تساوي حظه في النظم والنثر، علي تباين الناس في ذلك.
 مشيخته: روي عن ابيه وخاله، ابن عم ابيه القاضي ابي القاسم بن ادريس، وابي بكر بن مغاور، وابي الحسن بن القاسم، وابي رجال بن غلبون، وابي عبد الله بن حميد، وابي العباس بن مضاء، وابي القاسم بن حبيش، وابي محمد الحجري، وابن حوط الله، وابي الوليد بن رشد، واجاز له ابو القاسم بن بشكوال.
 
 من روي عنه: ابو اسحاق اليابري، وابو الربيع بن سالم، وابو عبد الله بن ابي البقاء، وابو عمرو بن سالم، ومحمد بن محمد بن عيشون.
 تواليفه: له تواليف ادبية منها، «زاد المسافر» ، وكتاب «الرحلة» ، وكتاب «العجالة» سفران يتضمنان من نظمه ونثره ادبا لا كفاء له. وانفرد من تابين الحسين، رضي الله عنه، وبكاء اهل البيت، بما ظهرت عليه بركته في «» حكايات كثيرة.
 شعره: ثبت من ذلك في العجالة قوله «» : [الكامل]
 جاد الزمان بانة الجرعاء ~ توقان من دمعي وغيث سماء «»
 فالدمع يقضي عندها حق الهوي ~ والغيم حق البانة الغيناء «»
 خلت الصدور من القلوب كما خلت ~ تلك المقاصر من مها وظباء
 ولقد اقول لصاحبي وانما ~ ذخر الصديق لامجد «» الاشياء
 يا صاحبي، ولا اقل اذا انا ~ ناديت من ان تصغيا لنداءي «»
 عوجا بحار «» الغيم في سقي الحما ~ حتي تري «» كيف انسكاب الماء
 ونسن في سقي المنازل سنة ~ نمضي بها حكما علي الظرفاء
 يا منزلا نشطت اليه عبرتي ~ حتي تبسم زهره لبكاءي «»
 ما كنت قبل مزار ربعك عالما ~ ان المدامع اصدق الانواء
 يا ليت شعري والزمان تنقل ~ والدهر ناسخ شدة برخاء
 هل نلتقي في روضة موشية ~ خفاقة الاغصان والافياء؟
 وننال فيها من تالفنا ولو ~ ما فيه سخمة «» اعين الرقباء؟
 في حيث اتلعت الغصون سوالفا ~ قد قلدت بلالء الانداء
 وجرت «» ثغور الياسمين فقبلت ~ عني «» عذار الاسة الميساء
 
 والورد في شط الخليج كانه ~ رمد الم بمقلة زرقاء
 وكان غصن «» الزهر في خضر الربي ~ زهر النجوم تلوح بالخضراء
 وكانما جاء النسيم مبشرا ~ للروض يخبره بطول بقاء
 فكساه خلعة طيبه ورمي له ~ بدراهم الازهار رمي سخاء
 وكانما احتقر الصنيع فبادرت ~ بالعذر «» عنه نغمة الورقاء
 والغصن يرقص في حلي اوراقه ~ كالخود في موشية خضراء
 وافتر ثغر الاقحوان بما راي ~ طربا وقهقه منه جري الماء
 افديه من انس تصرم فانقضي ~ فكانه قد كان في الاغفاء
 لم يبق منه غير ذكر او مني ~ وكلاهما سبب لطول عناء
 او رقعة من صاحب هي تحفة ~ ان الرقاع لتحفة النبهاء
 كبطاقة الوسمي «» اذ حيا بها ~ ان الكتاب تحية الظرفاء «»
 وهي طويلة «» . وقال مراجعا عن كتاب ايضا: [الوافر]
 الا سمح الزمان به كتابا ~ ذري بوروده انسي قبابا
 فلا ادري اكانا تحت وعد ~ دعا بهما لبرءي فاستجابا؟
 وقد ظفرت يدي بالغنم منه ~ فليت الدهر سني لي ايابا
 فلو لم استفد شيءا سواه ~ قنعت بمثله علقا لبابا
 اذا احرزت هذا في اغترابي ~ فدعني اقطع العمر اغترابا
 رجمت بانسه شيطان همي ~ فهل وجهت طرسا ام شهابا؟
 رشفت به رضاب الود عذبا ~ يذكرني شماءلك العذابا
 وكدت اجر اذيالي نشاطا ~ ولكن خلت قولهم تصابا
 فضضت ختامه عني كاني ~ فتحت بفضه للروض بابا
 فكدت ابثه في جفن عيني ~ لكي استودع الزهر السحابا
 وكنت اصونه في القلب لكن ~ خشيت عليه ان يفني التهابا
 ولو ان الليالي سامحتني ~ لكنت علي كتابكم الجوابا
 
 فابلي عندكم بالشكر عذرا ~ واجزل من ثناءكم الثوابا
 ولكن الليالي قيدتني ~ وقيد عدتي «» الا الخطابا 
 فما تلقاني الاحباب الا ~ سلاما او مناما او كتابا
 لامر ما يقص الدهر ريشي ~ لان السهم مهما ريش صابا
 وعاذلة تقول ولست اصغي ~ ولو اصغيت لم ارفع جوابا
 تخوفني الدواهي وهي عندي ~ اقل من ان اضيق بها جنابا
 اذا طرقت اعد لها قراها ~ وقارا واحتسابا واصطبارا
 وما مثلي يخوف بالدواهي ~ عرين الليث لا يخشي الذبابا
 تعاتبني فلا يرتد طرفي ~ وهل تسترقص الريح الهضابا؟
 ولو ان العتاب يفيد شيءا ~ ملات مسامع الدنيا عتابا
 وقد وصيتها بالصمت عني ~ فما صمتت ولا قالت صوابا
 تعنفني علي تركي بلادا ~ عهدت بها القرارة والشبابا
 تقول: وهل يضر السيف الا ~ اذا ما فارق السيف القرابا
 فقلت: وهل يضر السيف فل ~ اذا قط الجماجم والرقابا؟
 بخوض الهول تكتسب المعالي ~ يحل السهل من ركب الصعابا
 فليث الغاب يفترس الاناسي ~ وليث البيت يفترس الذبابا
 ولو كان انقضاض الطير سهلا ~ لكانت كل طاءرة عقابا
 دعيني والنهار اسير فيه ~ اسير عزاءم تفري الصلابا
 اغازل من غزالته فتاة ~ تبيض فودها هرما وشابا
 اذا شاءت مواصلتي تجلت ~ وان ملت توارت لي احتجابا
 واسري الليل لا الوي عنانا ~ ولو نيل الاماني ما «» اصابا
 اطارح من كواكبه كماما ~ وازجر من دجنته غرابا
 واركب اشهبا «» غبرا كباعي ~ وخضرا مثل خاطري انسيابا
 واخذ من بنات الدهر حقي ~ جهاز البيت استلب استلابا
 ولست اذيل بالمدح القوافي ~ ولا ارضي بخطتها اكتسابا
 
 اامدح من به اهجو مديحي ~ اذا طيبت بالمسك الكلاما
 ساخزنها عن الاسماع حتي ~ ارد الصمت بينهما حجابا
 فلست بمادح ما عشت الا ~ سيوفا او جيادا او صحابا
 ابا موسي، واني ذو «» وداد ~ اناجي لو سمعت اذا اجابا
 ولكن دون ذلك مهمه لو ~ طوته الريح لم ترج الايابا
 اخي، بر المودة كل بر ~ اذا بر الاشقا «» الانتسابا
 بعثت اليك من نظمي بدر ~ شققت عليه من فكري عبابا
 عداني الدهر ان يلقاك شخصي ~ فاغني الشعر عن شخصي ونابا
 وقال في الغرض الذي نظم فيه الرصافي «» من وصف بلده، وذكر اخوانه ومعاهده، مساجلا في العروض والروي، عقب رسالة سماها «رسالة طراد الجياد في الميدان، وتنازع اللدان والاخوان، في تنفيق مرسية علي غيرها من البلدان» «» :
 [الطويل]
 لعل «» رسول البرق يغتنم الاجرا ~ فينثر «» عني ماء عبرته نثرا!
 معاملة اربو «» بها غير مذنب ~ فاقضيه دمع العين من نقطة بحرا
 ليسقي «» من تدمير قطرا محببا ~ يقر بعين القطر ان تشرب القطرا
 ويقرضه ذوب اللجين وانما ~ توفيه عيني من مدامعها تبرا
 وما ذاك تقصيرا بها غير انه ~ سجية ماء البحر ان يذوي الزهرا
 خليلي، قوما فاحبسا طرق الصبا ~ مخافة ان تحمي «» بزفرتي الحري
 فان الصبا ريح علي كريمة ~ باية ما تسري من الجنة الصغري
 
 خليلي، اعني ارض مرسية المني ~ ولولا توخي الصدق سميتها الكبري
 محلي بل جوي الذي عبقت به ~ نواسم ادابي معطرة نشرا
 ووكري الذي منه درجت فليتني ~ فجعت بريش العزم كي الزم الوكرا
 وما روضة الخضراء قد مثلت بها ~ مجرتها نهرا وانجمها زهرا
 بابهج منها والخليج مجرة ~ وقد فضحت ازهار ساحتها الزهرا
 وقد اسكرت ازهار «» اغصانها الصبا ~ وما كنت اعتد الصبا قبلها خمرا
 هنالك بين الغصن والقطر والصبا ~ وزهر الربي ولدت ادابي الغرا
 اذا نظم الغصن الحيا قال خاطري ~ تعلم نظام النثر من ههنا شعرا
 وان نثرت ريح الصبا زهر الربي ~ تعلمت حل الشعر اسبكه نثرا
 فواءد اسحار هناك اقتبستها ~ ولم ار روضا غيره يقرء السحرا
 كان هزيز الريح يمدح روضها ~ فتملا فاه من ازاهر ها درا «»
 ايا زنقات «» الحسن، هل فيك نظرة ~ من الجرف الاعلي الي السكة الغرا؟
 فانظر من هذي لتلك كانما ~ اغير اذ غازلتها اختها الاخري
 هي الكاعب الحسناء تمم حسنها ~ وقدت لها اوراقها حللا خضرا
 اذا خطبت اعطت دراهم زهرها ~ وما عادة الحسناء ان تنقد المهرا
 وقامت بعرس الانس قينة ايكة «» ~ اغاريدها تسترقص الغصن النضرا
 فقل في خليج يلبس الحوت درعه ~ ولكنه لا يستطيع بها قصرا «»
 اذا ما بدا فيها الهلال رايته ~ كصفحة سيف وسمها قبعة صفرا
 وان لاح فيها البدر شبهت متنه ~ بسطر «» لجين ضم من ذهب عشرا
 وفي جرفي روض هناك تجافيا ~ لنهر «» يود الافق لو زاره فجرا 
 كانهما خلا صفاء تعاتبا ~ وقد بكيا من رقة ذلك النهرا
 وكم لي بالباب الجديد «» عشية ~ من الانس ما فيه سوي انه مرا
 
 عشايا «» كان الدهر غص «» بحسنها ~ فاجلت سياط «» البرق افراسها الشقرا «»
 عليهن اجري خيل دمعي بوجنتي ~ اذا ركبت حمرا ميادينها الصفرا
 اعهدي بالغرس المنعم دوحه ~ سقتك دموعي انها مزنة شكري «»
 فكم فيك من يوم اغر محجل ~ تقضت امانيه فخلدتها ذكرا
 علي مذنب كالنحر «» من فرط حسنه ~ تود الثريا ان تكون «» له نحرا
 سقت ادمعي والقطر ايهما انبري ~ نقا الرملة البيضاء فالنهر فالجسرا
 واخوان صدق لو قضيت حقوقهم ~ لما فارقت عيني وجوههم الزهرا
 ولو كنت اقضي حق نفسي ولم اكن ~ لما بت استحلي فراقهم المرا
 وما اخترت هذا البعد الا ضروة ~ وهل تستجير العين ان تفقد الشفرا «» ؟
 قضي الله ان يناي «» بي الدهر عنهم ~ اراد بذاك الله ان اعتب الدهرا
 وو الله لو نلت المني ما حمدتها ~ وما عادة المشغوف ان يحمد الهجرا
 ايانس باللذات قلبي ودونهم ~ مرام يجد الركب «» في طيها شهرا؟
 ويصحب هادي الليل راء وحرفة ~ وصادا ونونا قد تقوس «» واصفرا
 فديتهم بانوا وضنوا بكتبهم ~ فلا خبرا منهم لقيت ولا خبرا
 ولولا علا هماتهم لعتبتهم ~ ولكن عراب الخيل لا تحمل الزجرا
 ضربت غبار البيد في مهرق السري ~ بحيث جعلت الليل في ضربه حبرا
 وحققت ذاك الضرب جمعا وعدة ~ وطرحا وتجميلا فاخرج لي صفرا
 كان زماني حاسب متعسف ~ يطارحني كسرا، اما يحسن الجبرا؟
 فكم عارف بي وهو يحسب «» رتبتي ~ فيمدحني سرا ويشتمني جهرا
 
 لذلك ما اعطيت نفسي حقها ~ وقلت لسرب الشعر: لا ترم «» الفكرا «»
 فما برحت فكري عذاري قصاءدي ~ ومن خلق العذراء ان تالف الخدرا
 ولست وان طاشت سهامي بايس ~ فان مع العذر «» الذي يتقي يسرا
 ومن مقطوعاته «» : [السريع]
 يا قمرا مطلعه اضلعي ~ له سواد القلب منها «» غسق
 وربما استوقد نار الهوي ~ فناب فيها لونها عن شفق
 ملكتني في «» دولة من صبا ~ وصدتني في «» شرك من حدق
 عندي من حبك «» ما لو سرت ~ في البحر منه شعلة لاحترق
 ومن مقطوعاته ايضا «» : [الكامل]
 قد كان لي قلب فلما فارقوا ~ سوي جناحا للغرام وطارا
 وجرت سحاب بالدموع «» فاوقدت ~ بين الجوانح لوعة واوارا
 ومن العجاءب ان فيض مدامعي ~ ماء ويثمر «» في ضلوعي نارا
 وشعره الرمل والقطر كثرة، فلنختم له المقطوعات بقوله «» : [المنسرح]
 قالوا وقد طال بي مدي خطءي ~ ولم ازل في تجرمي ساهي «»
 اعددت شيءا ترجو النجاة به؟ ~ فقلت: اعددت رحمة الله
 نثره: كتب يهنء «» قاضي الجماعة ابا القاسم بن بقي من رسالة «» : لان «» قدره «» دام عمره، وامتثل نهيه الشرعي وامره، اعلي رتبة واكرم محلا، من ان
 
 يتحلي بخطة هي به تتحلي. كيف يهنا بالقعود لسماع دعوة «» الباطل، ولمعاناة «» الانصاف الممطول من الماطل، والتعب في المعادلة، بين ذوي المجادلة. اما لو علم المتشوقون «» الي خطة الاحكام، المستشرفون الي ما لها من التبسط والاحتكام، ما يجب لها من اللوازم، والشروط الجوازم، كبسط الكنف، ورفع الجنف، والمساواة بين العدو وذي الذنب، والصاحب بالجنب، وتقديم ابن السبيل، علي ذي الرحم والقبيل، وايثار الغريب، علي القريب، والتوسع في الاخلاق، حتي لمن ليس له من خلاق، الي غير ذلك مما علم قاضي الجماعة احصاه، واستعمل لخلقه «» الفاضل ادناه واقصاه، لجعلوا خمولهم مامولهم، واضربوا عن ظهورهم «» ، فنبذوه وراء ظهورهم «» ، اللهم الا من اوتي بسطة في العلم، ورسا طودا في ساحة الحلم، وتساوي ميزانه في الحرب والسلم، وكان كقاضي الجماعة «» ، في المماثلة بين اجناس الناس، فقصاراه ان يتقلد الاحكام للاجر، لا للتعسف «» والزجر، ويتولاها للثواب، لا للغلظة في رد الجواب، وياخذها لحسن الجزاء، لا لقبح «» الاستهزاء، ويلتزمها لجزيل الذخر، لا للازراء والسخر. فاذا كان كذلك، وسلك المتولي هذا السالك «» ، وكان كقاضي «» الجماعة ولا مثل له، ونفع الحق به علله، ونقع غلله، فيومءذ تهنا «» به خطة القضاء، ويعرف ما لله عليه «» من اليد البيضاء.
 ومحاسنه في النثر ايضا جمة.
 ومن اخباره «» انه رحل الي مراكش متسببا «» في جهاز بنت بلغت التزويج، وقصد دار الامارة مادحا، فما تيسر له شء من امله، ففكر في خيبة قصده، وقال:
 لو كنت تاملت «» جهة الله، ومدحت المصطفي «» صلي الله عليه وسلم، وال بيته الطاهرين، لبلغت املي بمحمود عملي. ثم استغفر الله «» في توجهه الاول، وعلم ان ليس علي غير
 
 الثاني من «» معول، فلم يكن الا ان صوب نحو هذا القصد سهمه، وامضي فيه عزمه، واذا به قد وجه عنه، وادخل «» علي الخليفة، فساله عن مقصده، فاخبره مفصحا به، فانفذه وزاده عليه، واخبره ان ذلك لرءيا رسول الله صلي الله عليه وسلم، في النوم يامره «» بقضاء حاجته. فانفصل موفي الاغراض، واستمر في مدح اهل البيت حتي اشتهر في ذلك «» .
 وفاته: سنة ثمان وتسعين وخمسماءة، وسنه دون الاربعين سنة، وصلي عليه ابوه، فانه كان بمكان من الدين «» والفضل، رحمة الله عليه، وتلقيت من جهات انه دخل غرناطة، لما امتدح القاءد ابا عبد الله بن صناديد بمدينة جيان، حسبما يظهر من عجالته، من غير تحقيق لذلك.
 $ صالح بن يزيد بن صالح بن موسي بن ابي القاسم ابن علي بن شريف النفزي «»
 من اهل رندة، يكني ابا الطيب.
 حاله: قال ابن الزبير: شاعر مجيد في المدح والغزل، وغير ذلك. وعنده مشاركة في الحساب والفراءض. نظم في ذلك. وله تواليف ادبية، وقصاءد زهدية، وجزء علي حديث جبريل عليه السلام، وغير ذلك مما روي عنه. وكان في الجملة معدودا في اهل الخير، وذوي الفضل والدين. تكرر لقاءي اياه، وقد اقام بمالقة اشهرا، ايام اقراءي. وكان لا يفارق مجالس اقراءي، وانشدني كثيرا من شعره.
 وقال ابن عبد الملك «» : كان خاتمة الادباء بالاندلس، بارع التصرف في منظوم الكلام ومنثوره، فقيها حافظا، فرضيا، متفننا في معارف شتي «» ، نبيل المقاصد «» ، متواضعا، مقتصدا في احواله. وله مقامات بديعة في اغراض شتي، وكلامه، نظما ونثرا، مدون.
 
 مشيخته: روي «» عن اباء الحسن: ابيه، والدباج، وابن الفخار الشريشي، وابن قطرال، وابي الحسن بن زرقون، وابي القاسم ابن الجد «» .
 تواليفه: الف جزءا علي حديث جبريل، وتصنيفا في الفراءض واعمالها، واخر في العروض، واخر في صنعة الشعر سماه «الوافي «» ، في علم القوافي» .
 وله كتاب كبير سماه «روضة الانس، ونزهة النفس» .
 دخوله غرناطة: وكان كثير الوفادة علي غرناطة، والتردد اليها، يسترفد ملوكها، وينشد امراءها، والقصيدة التي اولها: «اواصلتي يوما وهاجرتي الفا» «» ، اخبرني شيخنا ابو عبد الله اللوشي انه نظمها باقتراح السلطان، رحمه الله، وقد اوعز اليه الا يخرج عن بعض بساتين الملك حتي يكملها في معارضة محمد بن هاني الالبيري.
 شعره: وهو كثير، سهل الماخذ، عذب اللفظ، راءق المعني، غير مءثر للجزالة. فمن ذلك قوله، رحمه الله، في غرض المدح من السلطانيات «» : [الوافر]
 سري والحب امر لا يرام ~ وقد اغري به الشوق الغرام «»
 واغفي اهلها الا وشاة ~ اذا نام الحوادث لا تنام
 وما اخفاه «» بين القوم الا ~ ضني ولربما «» نفع السقام
 فنال بها علي قدر مناه ~ وبين القبض والبسط القوام
 واشهي الوصل ما كان اختلاسا ~ وخير الحب ما فيه اختتام
 وما احلي الوصال لو ان شيءا ~ من الدنيا للذته دوام
 بكيت من الفراق بغير ارضي ~ وقد يبكي الغريب المستهام
 اعاذلتي، وقد فارقت الفي ~ امثلي في صبابته يلام؟
 اافقده فلا ابكي عليه؟ ~ يكون ارق من قلبي الحمام
 اانساه فاحسبه كصبري ~ وهل ينسي لمحبوب ذمام؟
 
 رويدا، ان بعض اللوم لوم ~ ومثلي لا ينهنهه الملام
 ويوم نوي وضعت الكف فيه ~ علي قلب يطير به الهيام
 ولولا ان سفحت به جفونا ~ تفيض دما لاحرقها الضرام «»
 وليل بته «» كالدهر طولا ~ تنكر لي وعرفه التمام
 كان سماءه «» زهر «» تجلي ~ بزهر الزهر والشرق «» الكمام
 كان البدر تحت الغيم وجه ~ عليه من ملاحته لثام
 كان الكوكب الدري كاس ~ وقد رق الزجاجة والمدام
 كان سطور افلاك الدراري ~ قسي والرجوم لها سهام
 كان مدار قطب بنات نعش ~ ندي والنجوم به ندام
 كان بناته الكبري جوار ~ جوار والسهي فيها غلام
 كان بناته الصغري جمان ~ علي لباتها منها «» نظام
 كواكب بت ارعاهن حتي ~ كاني عاشق وهي الذمام
 الي ان مزقت كف الثريا ~ جيوب الافق وانجاب الظلام
 فما خلت انصداع الفجر الا ~ قرابا ينتضي منه حسام
 وما شبهت وجه الشمس الا ~ لوجهك «» ايها الملك الهمام
 وان شبهته بالبدر يوما ~ فللبدر الملاحة والتمام
 تهلل منه حسن الدهر حتي ~ كانك في محياه ابتسام
 وعرف ما تنكر من معال ~ كانك لاسمها الف ولام
 وملء العين منك جلال مولي ~ صناءعه كغرته وسام
 اذا ما قيل في يده غمام ~ فقد بخست وقد خدع الغمام
 وحشو الدرع اروع غالبي ~ يراع بذكره الجيش اللهام
 اذا ما سل سيف العزم يوما ~ علي امر فسلم يا سلام
 
 تناهي مجده كرما وباسا ~ فما يدري امحيا ام حمام
 نمته للمكارم والمعالي ~ سراة من بني نصر كرام
 هم الانصار هم نصروا واووا ~ ولولا المسك ما طاب الختام
 وهم قادوا الجيوش لكل فتح ~ ولولا الجد ما قطع الحسام
 وهم منحوا الجزيرة من حماهم ~ جوارا لا يذم ولا يضام
 فمن حرب تشيب له النواصي ~ وسلم تحيته سلام
 بسعدك، يا محمد، عز دين ~ له بعد «» الاله بك اعتصام
 وباسمك تم للاسلام سلم ~ وغب السلم نصر مستدام
 وكان مرامه صعبا ولكن ~ بحمد الله قد سهل المرام
 ادام الله امرك من امير ~ ففيه لكل مكرمة دوام
 وانت العروة الوثقي تماما ~ وما للعروة الوثقي انفصام
 وروح انت والجسم المعالي ~ ومعني انت واللفظ «» الانام
 اذا ما ضاقت الدنيا بحر ~ كفاه لثم كفك والسلام
 ومن شعره ايضا: [الطويل]
 اواصلتي يوما وهاجرتي الفا ~ وصالك ما احلي وهجرك ما اجفا!
 ومن عجب للطيف ان جاء واهتدي ~ فعاد عليلا عاد كالطيف ام اخفي
 فيا ساءرا، لولا التخيل ما سري ~ ويا شاهدا، لولا التعلل ما اغفي
 الم فاحياني وولي فراعني ~ ولم ار اجفي منك طبعا ولا اشفي
 بعيني شكواي للغرام وتيهه ~ الي ان تثني عطفه فانثني عطفا
 فعانقته شوقا وقبلته هوي ~ ولا قبلة تكفي ولا لوعة تطفا
 ومن نزعاته العجيبة قوله، وقد سبق الي غرضه غيره: [البسيط]
 يا طلعة الشمس الا انه قمر ~ اما هواك فلا يبقي ولا يذر
 كيف التخلص من عينيك لي ومتي ~ وفيهما القاتلان الغنج والحور
 وكيف يسلي فءادي عن صبابته ~ ولو نهي الناهيان الشيب والكبر
 انت المني والمنايا فيك قد جمعت ~ وعندك الحالتان النفع والضرر
 
 ولي من الشوق ما لا دواء له ~ ومنك لي الشافيان القرب والنظر
 وفي وصالك ما ابقي به رمقي ~ لو ساعد المسعدان الذكر والقدر
 وكان طيف خيال منك يقنعني ~ لو يذهب المانعان الدمع والسهر
 يا نابيا، لم يكن الا ليملكني ~ من بعده المهلكان الغم والغير
 ما غبت الا وغاب الجنس اجمعه ~ واستوحش المءنسان السمع والبصر
 بما تكن ضلوعي في هواك بمن ~ يعنو له الساجدان النجم والشجر
 ادرك بقية نفس لست مدركها ~ اذا مضي الهاديان العين والاثر
 ودل حيرة مهجور بلا سبب ~ يبكي له القاسيان الدهر والحجر
 وان ابيت فلي من ليس يسلمني ~ اذا نبا المذهبان الورد والصدر
 مءيدا لملك بالاراء يحكمها ~ في ضمنها المبهجان اليمن والظفر
 من كالامير ابي عبد الاله اذا ما ~ خانت القدمان البيض والسمر
 الواهب الخيل الافا وفارسها ~ اذا استوي المهطعان الصر والصبر
 والمشبه الليث في باس وفي خطر ~ ونعمت الحليتان الباس والخفر
 تامن الناس في ايامه ومشوا ~ كما مشي الصاحبان الشاة والنمر
 وزال ما كان من خوف ومن حذر ~ فما يري الدايلان الخوف والحذر
 رايت منه الذي كنت اسمعه ~ وحبذا الطيبان الخبر والخبر
 ما شءت من شيم عليا ومن شيم ~ كانها الراءقان الظل والزهر
 وما اردت من احسان ومن كرم ~ ينسي به الاجودان البحر والمطر
 وغرة يتلالا من سماحتها ~ كانها النهران الشمس والقمر
 ايه، فلولا دواع من محبته ~ لم يسهل الاصعبان البين والخطر
 نايت عنه اضطرارا ثم عدت له ~ كما اقتضي المبرمان الحل والسفر
 فان قضي الله ان يقضي به املي ~ فحسبي المحسبان الظل والثمر
 ولست ابعد اذ والحال متسع ~ ان يبلغ الغاءبان السءل والوطر
 ومن شعره في اغراض متعددة، قال في الليل والسهر: [مجزوء السريع]
 اطال ليلي الكمد ~ فالدهر عندي سرمد
 وما اظن انه ~ ليلة الهجر غد
 يا ناءما عن لوعتي ~ عوفيت مما اجد
 ارقد هنيا انني ~ لا استطيع ارقد
 لواعج ما تنطفي ~ وادمع تضطرد
 
 وكبدي كبد الهوي ~ واين مني الكبد؟
 ولا تسل عن جلدي ~ والله ما لي جلد
 ومن شعره ايضا في المقطوعات: [السريع]
 وليلة قصر من طولها ~ بزورة من رشا نافر
 استوفر الدهر بها غالطا ~ فادغم الاول والاخر
 وقال من قصيدة مغربة في الاحسان «» : [السريع]
 وليلة نبهت اجفانها ~ والفجر قد فجر نهر النهار
 والليل كالمهزوم يوم «» الوغا ~ والشهب مثل الشهب «» عند الفرار
 كانما استخفي السها خيفة ~ وطولب النجم بثار فثار
 لذاك ما شابت نواصي الدجي ~ وطارح النسر اخاه فطار
 وفي الثريا قمر سافر ~ عن غرة غير منها الشفار «»
 كان عنقودا بها ماثل «» ~ اذ صار كالعرجون عند السرار
 كانها تسبك ديناره ~ وكفها تفتل منه سوار «»
 كانما الظلماء مظلومة ~ تحكم الفجر عليها فجار
 كانما الصبح لمشتاقه ~ اقبال دنيا «» بعد ذل افتقار
 كانما الشمس وقد اشرقت ~ وجه ابي عبد الاله استنار
 وفي وصف البحر والانهار وما في معني ذلك: [البسيط]
 البحر اعظم مما انت تحسبه ~ من لم ير البحر يوما ما راي عجبا
 طام له حبب طاف علي زورق ~ مثل السماء اذا ما ملءت شهبا
 وقال في وصف نهر: [الطويل]
 وازرق محفوف بزهر كانه ~ نجوم باكناف المجرة تزهر
 يسيل علي مثل الجمان مسلسلا ~ كما سل عن غمد حسام مجوهر
 
 وقد صافح الادواح من صفحاته ~ وحتي «» حباب بالنسيم مكسر
 فما كان في عطف الخليج قلامة ~ وما كان في وجه الغدير فمغفر
 وفي العقل والتغرب: [السريع]
 ما احسن العقل واثاره ~ لو لازم الانسان ايثاره
 يصون بالعقل الفتي نفسه ~ كما يصوم الحر اسراره
 لا سيما ان كان في غربة ~ يحتاج ان يعرف مقداره
 ومن وصفه الجيش والسلاح: [الكامل]
 وكتيبة بالدارعين كثيفة ~ جرت ديول الجحفل الجرار
 روض المنايا بينها القضب التي ~ زفت بها الرايات كالازهار
 فيها الكماة بنو الكماة كانهم ~ اسد الشري بين القنا الخطار
 متهللين لدي اللقاء كانهم ~ خلقت وجوههم من الاقمار
 من كل ليث فوق برق خاطف ~ بيمينه قدر من الاقدار
 من كل ماض قد تقلد مثله ~ فيصب اجالا علي الاعمار
 لبسوا القلوب علي الدروع واسرعوا ~ لاكفهم نارا لاهل النار
 وتقدموا ولهم علي اعداءهم ~ حنق العدا وحمية الانصار
 فارتاع ناقوس بخلع لسانه ~ وبكي الصليب لذلة الكفار
 ثم انثنوا عنه وعن عباده و ~ قد اصبحوا خبرا من الاخبار
 وفي السيف: [البسيط]
 وابيض صيغ من ماء ومن لهب ~ علي اعتدال فلم يخمد ولم يسل
 ماضي الغرار يهاب العمر صولته ~ كانما هو مطبوع من الاجل
 ابهي من الوصل بعد الهجر منظره ~ حسنا واقطع من دين علي ملل «»
 واسمر ظن ان «» ما كل سابغة ~ فخاض كالايم يستشفي من النهل
 هام الكماة به حبا ولا عجب ~ من لوعة بمليح القد معتدل
 اذا الطعين تلقاه وارعفه ~ حسبته عاشقا يبكي علي طلل
 
 ومن ذلك قوله في وصف قوس: [الوافر]
 تنكبها كحاجبه وسوي ~ باهداب الجفون لها نبالا
 فلم ار قبله بدرا منيرا ~ تحمل فوق عاتقه هلالا
 ومن ذلك في وصف قلم: [المتقارب]
 واصفر كالصب في رونق ~ تظن به الحب ممن نحل
 بديع الصفات حديد السبات ~ يطول الرماح وان لم يطل
 يعبر عما وراء الضمير ~ ويفعل فعل «» الظبا والذبل
 ومن ذلك قوله فيما يظهر منها: [البسيط]
 تفاخر السيف فيما قيل والقلم ~ والفصل بينهما لا شك منفهم
 كلاهما شرف لله «» درهما ~ وحبذ الخطتان الحكم والحكم
 ومن ذلك قوله في سكين الدواة: [الخفيف]
 انا صمصامة الكتابة ما لي ~ من شبيه في المرهفات الرقاق
 فكاني في الحسن يوم وصال ~ وكاني في القطع يوم فراق
 ومن ذلك قوله في المقص: [الوافر]
 ومعتنقين ما اشتهرا بعشق ~ وان وصفا بضم واعتناق
 لعمر ابيك ما اعتنقا لمعني ~ سوي معني القطيعة والفراق
 ومن ذلك قوله في الورد: [مخلع البسيط]
 الورد سلطان كل زهر ~ لو انه داءم الورود
 بعد خدود الملاح شء ~ ما اشبه الورد بالخدود
 ومن ذلك قوله في الخيري: [السريع]
 وازرق كمثل السماء ~ فيه لمن ينظر سر عجيب
 شح مع الصبح بانفاسه ~ كانما الصبح عليه رقيب
 وباح بالليل باسراره ~ لما راي الليل نهار الاريب
 
 ومن ذلك قوله في الريحان: [الوافر]
 واخضر فستقي اللون غض ~ يروق بحسن منظره العيونا
 اغار علي الترنج وقد حكاه ~ وزاد علي اسمه الفا ونونا
 وقال من جملة قصاءده المطولات التي تفنن فيها، رحمه الله: [الطويل]
 وغانية يغني عن العود صوتها ~ وجارية تسقي وساقية تجري
 بحيث يجر النهر ذيل مجرة ~ يرف علي حافاتها الزهر كالزهر
 وقد هزت الارواح خصر كتاءب ~ بالوية بيض علي اسل سمر
 رمي قزح نبلا اليها فجردت ~ سيوف سواقيها علي دارع النهر
 وهبت صبا نجد فجرت غلاءلا ~ تجفف دمع الطل عن وجنة الزهر
 كان بصفح الروض وشي صحيفة ~ وكالالفات القضب والطرس كالتبر
 كان به الاقحوان خواتما ~ مفضضة فيها فصوص من التبر
 كان به النرجس الغض اعيا ~ ترقرق في اجفانها ادمع القطر
 كان شذا الخيري زورة عاشق ~ يري ان جنح الليل اكتم للسر
 وقال في وصف الرمان: [البسيط]
 لله رمانة قد راق منظرها ~ فمثلها ببديع الحسن منعوت
 القشر حق لها قد ضم داخله ~ والشحم قطن لها «» والحب ياقوت
 ومن ذلك قوله في الجزر: [البسيط]
 انظر الي جزر «» في اللون مختلف ~ البعض من سبج والبعض من ذهب
 ان قلت: قصب فقل: قصب بلا زهر ~ او قلت: شمع فقل: شمع بلا لهب
 وفي الاغتراب وما يتعلق به مما يقرب من المطولات: [الوافر]
 غريب كلما يلقي غريب ~ فلا وطن لديه ولا حبيب
 تذكر اصله فبكي اشتياقا ~ وليس غريبا ان يبكي غريب
 ومما هاج اشواقي حديث ~ جري فجري له الدمع السكوب
 
 ذكرت به الشباب فشق قلبي ~ الم تر كيف تنشق القلوب؟
 علي زمن الصبا فليبك مثلي ~ فما زمن الصبا الا عجيب
 جهلت شبيبتي حتي تولت ~ وقدر الشء يعرف اذ يغيب
 الا ذكر الاله بكل خير ~ بلادا لا يضيع بها اديب
 بلاد ماءها عذب زلال ~ وريح هواءها مسك رطيب
 بها قلبي الذي قلبي المعني ~ يكاد من الحنين له يذوب
 رزقت الصبر بلين ابي وامي ~ كلانا بعد صاحبه كثيب
 الا فتوخ بعدي من اءاخي ~ ودع ما لا يريب لما يريب
 ولا تحكم باول ما تراه ~ فان الفجر اوله كذوب
 الا انا خلقنا في زمان ~ يشيب بهوله من لا يشيب
 وقد لذ الحمام وطاب عندي ~ وعيشي لا يلذ ولا يطيب
 لحي الله الضرورة فهي بلوي ~ تهين الحر والبلوي ضروب
 رايت المال يستر كل عيب ~ ولا تخفي مع الفقر العيوب
 وفقد المال في التحقيق عندي ~ كفقد الروح ذا من ذا قريب
 وقد اجهدت نفسي في اجتهاد ~ وما ان كل مجتهد مصيب
 وقد تجري الامور علي قياس ~ ولو تجري لعاش بها اللبيب
 كان العقل للدنيا عدو ~ فما يقضي بها اربا اريب
 اذا لم يرزق الانسان بختا ~ فما حسناته الا ذنوب
 ومن نسيبه قوله في بادرة من حمام: [الكامل]
 برزت من الحمام تمسح وجهها ~ عن مثل ماء الورد بالعناب
 والماء يقطر من ذواءب شعرها ~ كالطل يسقط من جناح غراب
 فكانها الشمس المنيرة في الضحي ~ طلعت علينا من خلال سحاب
 ومن مقطوعاته ايضا قوله: [الكامل]
 ومتيم لو كان صور نفسه ~ ما زادها شيءا سوي الاشفاق
 ما كان يرضي بالصدود وانما ~ كثرت عليه مساءل العشاق
 وقال: [مخلع البسيط]
 وافي وقد زانه جمال ~ فيه لعشاقه اعتذار
 
 ثلاثة ما لها مثال: ~ الوجه والخد والعذار
 فمن راه راي رياضا: ~ الورد والاس والبهار
 ومن ذلك قوله في ذم اخوة السوء: [الكامل]
 ليس الاخوة «» باللسان اخوة ~ فاذا تراد اخوتي لا تنفع
 لا انت في الدنيا تفرج كربه ~ عني ولا يوم القيامة تشفع
 وقال كذلك: [الكامل]
 ولقد عرفت الدهر حين خبرته ~ وبلوت بالحاجات اهل زمان
 فاذا الاخوة باللسان كثيرة ~ واذا الدراهم ميلق الاخوان
 ومن ذلك قوله في ثقيل: [المتقارب]
 تزلزلت الارض زلزالها ~ فقلت لسكانها: ما لها؟
 فقالوا: اتانا ابو عامر ~ فاخرجت الارض اثقالها
 ومن ذلك قوله في الصبر: [السريع]
 الدهر لا يبقي علي حالة ~ لكنه يقبل او يدبر
 فان تلقاك بمكروهه ~ فاصبر فان الدهر لا يصبر
 ومن ذلك قوله في الموت: [السريع]
 الموت سر الله في خلقه ~ وحكمة دلت علي قهره
 ما اصعب الموت وما بعده ~ لو فكر الانسان في امره
 ايام طاعات الفتي وحدها ~ هي التي تحسب من عمره
 لا تلهك الدنيا ولذاتها ~ عن نهي مولاك ولا امره
 وانظر الي من ملك الارض هل ~ صح له منها سوي قبره؟
 نثره: قال في كتاب «روضة الانس» ما نصه: «ويتعلق بهذا الباب ما خاطبني به الفقيه الكاتب الجليل ابو بكر البرذعي، من اهل بلدنا، اعزه الله: اخبرك بعجاب، اذ لا سر دونك ولا حجاب، بعد ان اتقدم اليك ان لا تعجل باللوم الي، قبل علم ما لدي، فان الدهر اخدع من كفة الحابل،
 
 وقلب الانسان للافات قابل. مشيت يوما الي سوق الرقيق، لاخذ حق فءاد عتيق، فرايت بها جارية عسجدية اللون، حديثة عهد بالصون، متمايلة القد، قاءمة النهد، بلحظ قد اوتي من السحر اوفر حظ، وفم كشرطة رشحت بدم، داخله سمطان لولا هما ما عرف النظم، ولا حكم علي الدر للعظم، في صدغها لامان ما خط شكلهما قلم، ولا قص مثلهما حلم. لها جيد تتمناه الغيد، وخصر هو قبضة الكف في الحصر، وردف يظلمه من يشبه به بالحقف، ويدان خلقا للوشي، وقدمان اهلتا للثم لا للمشي، فتطاولت اليه الاعناق، وبذلت فيها الاعلاق، والمياسير عليها مغرم في القوم، وتسوم اهل السوم، وكل فيها يزيد، ليبلغ ما يريد، الي ان جاء فتي صادق في حبه، لا يبالي بفساد ماله في صلاح قلبه، فعد المال عدا، ولم يجد غيره من التسليم بدا. فلما فاتتني، تركت الاشواق واتتني، وانتقضت عزاءم صبري فما اتتني، فالله الله، تدارك اخاك سريعا، قبل ان تلفيه من الوجد صريعا، واستنزله خادما، قبل ان تصبح عليه نادما، ولن احتاج ان اصفها اليك، مع ما قصصته عليك، وقد اهديتها دررا، فخذها علي جهة الفكاهة والدعابة: [الوافر]
 ولا تطلع اخا جهل عليها ~ فمن لم يدر قدر الشء عابه
 فاجبته: نعم نعم، انعم الله بالك، وسني امالك، انا بحول الله ارتاد لك من نحو هاتيك، ما يسليك ويءاتيك، والا فبيضا كاللجين، هل القلب والعين، زهرة غصن في روضة حسن، ذات ذواءب، كانها الليل علي نهار، او بنفسج في بهار.
 لها وجه ابهي من الغنا، واشهي من نيل المني، فيه حاجبان كانهما قوس صنعت من السبح، ورصعت بعاج من البلح، علي عينين ساحرتين، بالعقل ساخرتين، بهما تصاب الكبود، وتشق القلوب قبل الجلود، الي فم كانه ختام مسك، علي نظام سلك، سقاه الحسن رحيقه، فانبتت درره وعقيقه، وجيد في الحسن وحيد علي صدر كانه من مرمر، فيه حقتا عاج طوقتا بعنبر، قد خلقتا للعض، في جسم غض، له خصر مدمج، وردفه يتموج، واطراف كالعنم، رقمت رقم القلم، من اللاءي شهدن ابن المءمل، وقال في مثلها الاول، ان هي تاهت فمثلها تاها، او هي باهت فمثلها باها، من اين للغصن مثل قامتها او اين للبدر مثل مراها، ما فعلت في العقول صابية ما فعلت في العقول عيناها، تملكني بالهوي واملكها، فهانا عبدها ومولاها، فايهما لست بذلت فيه الجهد، وارقيت للمجد والود ان شاء الله تعالي.
 وانا فيما عرض لسيدي، حفظه الله، علي ما يحب، اعذره ولا اعذله، وانصره ولا اخذله، لكني اقول كما قال بعض الحكماء: لا ينبغي لمن قلبه رقيق، ان يدخل سوق الرقيق، الا ان يكون قد جمع بين المال، والجمال يتنافس في العالي،
 
 ويسترخص بالثمن الغالي، ولا يبالي بما قال الاءمة، اذا وجد من يلاءمه، كما قال الشاعر: [الخفيف]
 ما انتفاع المحب بالمال اذ «» لم ~ يتوصل به لوصل الحبيب
 انما ينبغي بحكم الهوي ان ~ ينفق المال في صلاح القلوب
 والسلام علي سيدي، ما كانت الفكاهة من شان الوفاء، والمداعبة من شيم الظرفاء، ورحمة الله وبركاته.
