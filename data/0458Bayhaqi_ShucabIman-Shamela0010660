 وهكذا رواه سهل بن بكار، عن ابي عوانة بهذا المعني، وزاد قال: ولكن احدثكم عن يوم الجمعة وقد
    
 اخبرناه ابو عبد الله الحافظ، حدثنا ابو العباس، حدثنا ابو قلابة، حدثنا يحيي بن حماد، حدثنا ابو عوانة، فذكره باسناده غير انه قال: قلت الله ورسوله اعلم، قال: " هو اليوم الذي جمع فيه بين ابويكم لا يتوضا عبد مسلم فيحسن الوضوء، ثم ياتي المسجد لجمعة، الا كانت كفارة ما بينها، وبين الجمعة الاخري، ما اجتنبت المقتلة " " والاول اصح "
 
    
 اخبرنا ابو عبد الله الحافظ، ومحمد بن موسي، قالا: حدثنا ابو العباس الاصم، حدثنا احمد بن عبد الجبار، حدثنا ابو معاوية، عن الاعمش، عن ابي صالح، عن ابي هريرة، قال: قال رسول الله صلي الله عليه وسلم: " من توضا فاحسن الوضوء ثم اتي الجمعة فدنا وانصت واستمع، غفر له من الجمعة الي الجمعة، وزيادة ثلاثة ايام ومن مس الحصا فقد لغا " رواه مسلم، عن يحيي بن يحيي وغيره، عن ابي معاوية
 
    
 اخبرنا ابو عبد الله الحافظ، حدثنا احمد بن جعفر القطيعي، حدثنا عبد الله بن احمد بن حنبل، حدثني ابي، حدثنا اسماعيل بن ابراهيم، عن محمد بن اسحاق، قال: حدثني محمد بن ابراهيم، عن ابي سلمة بن عبد الرحمن، وابي امامة بن سهل، عن ابي هريرة، وابي سعيد، قالا: سمعنا رسول الله صلي الله عليه وسلم يقول: " من اغتسل يوم الجمعة، واستن، ومس من طيب ان كان عنده ولبس احسن ثيابه، ثم جاء الي المسجد، ولم يتخط رقاب الناس ثم ركع ما شاء الله ان يركع، ثم انصت اذا خرج الامام حتي يصلي كانت كفارة لما بينها وبين الجمعة التي كانت قبلها " يقول ابو هريرة: " وزاد ثلاثة ايام ان الله قد جعل الحسنة بعشر امثالها "
 
    
 اخبرنا ابو عبد الله الحافظ، حدثنا الحسن بن حليم المروزي، حدثنا ابو الموجه،
  [ص: ]
 حدثنا عبدان، حدثنا عبد الله، حدثنا الاوزاعي، حدثنا حسان بن عطية، حدثني ابو الاشعث الصنعاني، حدثني اوس الثقفي، قال: سمعت رسول الله صلي الله عليه وسلم يقول: " من غسل واغتسل يوم الجمعة ثم بكر وابتكر فدنا واستمع ولم يلغ كان له بكل خطوة يخطوها عمل سنة اجر صيامها وقيامها " قال البيهقي رضي الله عنه: " قوله غسل يريد والله اعلم راسه من الدهن والخطيم وما كانوا يجعلونه في رءوسهم "
 
    
 واخبرنا ابو علي الروذباري، حدثنا ابو بكر بن داسة، حدثنا ابو داود، حدثنا محمود بن خالد الدمشقي، حدثنا مروان، حدثنا علي بن حوشب، قال: سالت مكحولا عن هذا القول غسل واغتسل، فقال: " غسل راسه وجسده " قال ابو داود: وحدثنا محمد بن الوليد الدمشقي، حدثنا ابو مسهر، عن سعيد بن عبد العزيز في غسل واغتسل، فقال سعيد: " غسل راسه وغسل جسده " قال البيهقي رحمه الله: " وقد روينا في بعض طرق هذا الحديث من غسل راسه يوم الجمعة واغتسل "
 
    
 اخبرنا ابو طاهر الفقيه، اخبرنا ابو حامد بن بلال، حدثنا ابو الازهر، حدثنا يعقوب بن ابراهيم بن سعد، حدثني ابي، عن ابن اسحاق، حدثني محمد بن مسلم بن عبيد الله بن شهاب الزهري، عن طاووس اليماني، قال: قلت لعبد الله بن عباس زعموا ان رسول الله صلي الله عليه وسلم قال: " اغتسلوا يوم الجمعة، واغسلوا رءوسكم، وان لم تكونوا جنبا ومسوا من الطيب " قال: فقال ابن عباس: اما الطيب فلا ادري، واما الغسل فنعم
  [ص: ]
 وكذا رواه شعيب بن ابي حمزة، عن الزهري ومن ذلك الوجه اخرجه البخاري وفيه تاكيد ما قلنا من معني قوله من غسل وقد قيل من غسل بالتشديد، واغتسل يعني اوجب الغسل علي امراته بوطءها، " والاول اصح " واما الحديث الذي
 
    
 اخبرنا ابو عبد الله الحافظ، وابو عبد الرحمن السلمي، واحمد بن الحسن، قالوا: حدثنا ابو العباس الاصم، حدثنا ابو عتبة، حدثنا بقية، حدثنا برد بن سنان، عن بكير بن فيروز، عن ابي هريرة، قال: قال رسول الله صلي الله عليه وسلم: " ايعجز احدكم ان يجامع اهله في كل جمعة فان له اجرين اجر غسله، واجر غسل امراته " قال البيهقي رضي الله عنه: " وفي روايات بقية نظر، فان صح ففيه المعني المنقول في الخبر، وايضا فانه اذا فعل ذلك كان اغض للبصر حال الرواح الي الجمعة ففي القديم كن النساء يحضرن الجمعة والله اعلم "
 
    
 اخبرنا ابو عبد الله الحافظ، اخبرنا ابو جعفر محمد بن محمد البغدادي،
  [ص: ]
 حدثنا يحيي بن عثمان بن صالح، حدثنا ابي، حدثنا ابن لهيعة، حدثنا عقيل، ان ابن شهاب، اخبره، عن انس، ان رسول الله صلي الله عليه وسلم قال: " في جمعة من الجمع يا معشر المسلمين ما علي احدكم ان يتخذ ثوبين لجمعته سوي ثوبي مهنته ويمس من طيب ان كان لاهله، وعليكم بالسواك "
 
    
 اخبرنا ابو زكريا بن ابي اسحاق، اخبرنا احمد بن محمد بن عبدوس، حدثنا عثمان بن سعيد، حدثنا يحيي بن بكير، حدثنا مالك، قال: وحدثنا القعنبي، فيما قرا علي مالك، عن سمي، مولي ابي بكر بن عبد الرحمن، عن ابي صالح السمان، عن ابي هريرة، ان رسول الله صلي الله عليه وسلم قال: " من اغتسل يوم الجمعة غسل الجنابة، ثم راح فكانما قرب بدنة، ومن راح في الساعة الثانية، فكانما قرب بقرة، ومن راح في الساعة الثالثة، فكانما قرب كبشا، ومن راح في الساعة الرابعة، فكانما قرب دجاجة، ومن راح في الساعة الخامسة، فكانما قرب بيضة، فاذا خرج الامام حضرت الملاءكة يستمعون الذكر "
    
 اخبرنا ابو عبد الله الحافظ، اخبرني احمد بن محمد بن الحسين الخسروجردي، حدثنا داود بن الحسين بن عقيل، حدثنا يحيي بن يحيي، وقتيبة بن سعيد، عن مالك بن انس، فذكره باسناده، مثله، رواه البخاري في الصحيح، عن عبد الله بن يوسف
  [ص: ]
 ورواه مسلم، عن قتيبة كلاهما، عن مالك
 
    
 اخبرنا ابو الحسن محمد بن الحسين العلوي، حدثنا ابو الفضل العباس بن محمد بن قوهيار، حدثنا علي بن الحسن بن ابي عيسي الدرابجردي، حدثنا عبد المجيد بن عبد العزيز بن ابي رواد، حدثنا مروان بن سالم، عن الاعمش، عن ابراهيم، عن علقمة بن قيس، قال: رحت مع عبد الله بن مسعود الي الجمعة فوجد ثلاثة سبقوه، فقال: رابع اربعة، وما رابع اربعة ببعيد ثم قال: اني سمعت رسول الله صلي الله عليه وسلم يقول: " ان الناس يجلسون يوم القيامة من الله علي قدر رواحهم الي الجمعة الاول، ثم الثاني، ثم الثالث، ثم الرابع، قال: رابع اربعة وما رابع اربعة ببعيد " قال البيهقي رضي الله عنه: " يحتمل ان يريد به من عرش الله، او من كرامة الله "
 
    
 اخبرنا علي بن احمد بن عبدان، اخبرنا احمد بن عبيد الصفار، حدثنا يوسف القاضي، حدثنا ابو الربيع، حدثنا يعقوب القمي، حدثنا عيسي بن جارية، عن جابر بن عبد الله، قال: دخل ابن مسعود المسجد والنبي صلي الله عليه وسلم يخطب فجلس الي جنب ابي فساله عن شء، او كلمه بشء، فلم يرد عليه، فظن ابن مسعود انه من موجدة عليه فمكث حتي صلي رسول الله صلي الله عليه وسلم فدخل فقال ابن مسعود: يا ابي ما منعك ان ترد علي؟ قال: " انك لم تشهد معنا الجمعة " قال: ولم؟ قال: " تكلمت والنبي صلي الله عليه وسلم يخطب "، فقام ابن مسعود فدخل علي النبي صلي الله عليه وسلم فذكر له الذي ذكر ابي فقال النبي صلي الله عليه وسلم: " صدق ابي  او اطع ابيا  " هكذا روي عن جابر
 
 ورواه عطاء بن يسار، عن ابي ذر، انه قال: دخلت المسجد يوم الجمعة والنبي صلي الله عليه وسلم يخطب فجلست قريبا من ابي بن كعب فقرا النبي صلي الله عليه وسلم سورة براءة، فقلت لابي: متي نزلت هذه السورة؟ فحصر ولم يكلمني، فلما صلي رسول الله صلي الله عليه وسلم صلاته، قلت لابي: اني سالتك فنجهتني ولم تكلمني، فقال ابي: " ما لك من صلاتك الا ما لغوت "، فذهبت الي النبي صلي الله عليه وسلم فذكرت ذلك له فقال النبي صلي الله عليه وسلم: " صدق ابي "
  [ص: ]
    
 اخبرنا ابو عبد الله الحافظ، قال: اخبرني ابو اسحاق ابراهيم بن محمد بن حاتم الزاهد، حدثنا الفضل بن محمد الشعراني، حدثنا سعيد بن ابي مريم، حدثنا محمد بن جعفر بن ابي كثير، حدثنا شريك بن عبد الله بن ابي نمر، عن عطاء بن يسار، عن ابي ذر، فذكره
 
    
 اخبرنا ابو عبد الله الحافظ، وابو بكر القاضي، قالا: حدثنا ابو العباس محمد بن يعقوب، حدثنا احمد بن عبد الجبار، حدثنا ابن فضيل، عن داود بن ابي هند، عن بكر بن عبد الله المزني، قال: اتيت المدينة فامرت اصحابنا بشء من امرهم، ثم اتيت المسجد فجلست فجاء صاحبي الذي اوصيته، فجعل يحدثني كيف صنع وانا ساكت، ثم
  [ص: ]
 قلت له: اسكت فلما انصرفت اتيت عبد الله بن عمر فذكرت ذلك له فقال: " اما انت فلا جمعة لك، واما صاحبك فحمار " قال البيهقي رحمه الله: ويشبه ان يكون ابن عمر اخذ هذا من الحديث الثابت عن النبي صلي الله عليه وسلم: " اذا قلت لصاحبك انصت يوم الجمعة والامام يخطب فقد لغوت "
    
 اخبرنا ابو عبد الله الحافظ، حدثنا احمد بن سلمان، حدثنا احمد بن ابراهيم بن ملحان، حدثنا يحيي بن بكير، حدثنا الليث، عن عقيل، عن ابن شهاب، انه قال: اخبرني سعيد بن المسيب، ان ابا هريرة، اخبره ان رسول الله صلي الله عليه وسلم قال، فذكره غير انه لم يذكر قوله: والامام يخطب، وذكره غيره اخرجاه في الصحيح
  [ص: ]
 قال البيهقي رحمه الله: " ويشبه ان يكون في قوله: لا جمعة لك اي لا اجر لك، ولا يريد به وجوب الاعادة "
 
    
 اخبرنا ابو نصر منصور بن الحسين المفسر المقرء، حدثنا ابو العباس الاصم، حدثنا سعد بن محمد، قاضي بيروت، حدثنا ابن ابي السري، حدثنا رشدين بن سعد، حدثنا زبان بن فاءد، عن سهل بن معاذ، عن ابيه، قال: قال رسول الله صلي الله عليه وسلم: " من تخطي رقاب الناس يوم الجمعة اتخذ له جسرا الي جهنم " ورواه ايضا، عن ابن لهيعة، عن زبان بن فاءد
 
    
 اخبرنا علي بن احمد بن عبدان، حدثنا احمد بن عبيد، حدثنا ابن ابي قماش، ومحمد بن عبد الله الدينوري، قالا: حدثنا سعيد بن سليمان، عن موسي بن خلف العمي، عن القاسم العجلي، عن انس بن مالك، قال: بينما رسول الله صلي الله عليه وسلم يخطب اذ جاء رجل يتخطي رقاب الناس، ويءذيهم، فلما قضي رسول الله صلي الله عليه وسلم الصلاة قال: " يا فلان ما يمنعك ان تجمع معنا "، قال: يا رسول الله، لقد حرصت ان اضع نفسي بالمكان الذي رايتني، قال: " قد رايتك تتخطي رقاب الناس وتءذيهم، من اذي المسلمين فقد اذاني، ومن اذاني فقد اذي الله عز وجل "
 
    
 اخبرنا ابو نصر بن قتادة، حدثنا ابو الحسن محمد بن الحسن بن اسماعيل السراج، حدثنا ابو شعيب عبد الله بن احمد الحراني، حدثنا احمد بن ابي عبيد الله البصري، حدثنا يزيد بن زريع، حدثنا حبيب المعلم، عن عمرو بن شعيب، عن ابيه، عن جده، عن النبي صلي الله عليه وسلم قال: " يحضر الجمعة ثلاثة نفر رجل حضرها بلهو فهو حظه
