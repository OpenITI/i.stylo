  في الكتاب اذا اشترطت الا يبيع الا بنسيءة فباع بنقد لا يكون هذا القراض جاءزا لانه شرط علي خلاف العقد قال غيره هو متعد كما لو اشترطت الا يشتري الا صنفا فاشتري غيره ضمن والفضل والوضيعة لك وعليك ولا اجرة له في الوضيعة وله في الفضل قراض مثله لان اجرة مثله قد تذهب بالفضل كله وبنصف راس المال وهو متعد فيكون نال بتعديه ما طلب قال التونسي ولم يجب ابن القاسم ماذا يكون اذا نزل وعنده اذا امر رجلا ببيع
 
 سلعة نسيءة فباع بنقد ففاتت ضمن قيمتها نقدا فان باعها نقدا باكثر من قيمتها او قيمتها لم يضمن لان ما سمي من الاجل لا عبرة به ومن مذهبه في التحجير في القراض يرد الي اجرة المثل فلما امره الا يبيع ما اشتري الا بنسيءة فقد اذن في الشراء فهو غير متعد فيه فله اجرته في الشراء ويفسخ القراض فان باع بنسيءة فلا تعد فله اجرة مثله ويفسخ ويقتضي رب المال الثمن او ينقد فسخ ان كانت قاءمة فان فاتت وما باع به ثمنها لم يضمن شيءا ولا اجرة له في بيعها لانك تقول اغرمك قيمتها يوم التعدي فلا شء علي من اجارة البيع وعليك اجرة الشراء قال صاحب النكت اذا باع بالنقد خيرت بين اجارة البيع وله اجرة مثله في الشراء والبيع بالغة ما بلغت وبين رده وله اجرة مثله في الشراء دون البيع فان فاتت عند المشتري خيرت بين تضمينه قيمتها وله اجرة مثله في الشراء او تاخذ الثمن وله اجرة مثله في الشراء او البيع هذا الذي يجري علي مذهب ابن القاسم
