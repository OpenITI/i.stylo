 في الكتاب يجوز كتابة جماعة كتابة واحدة وعند ش قولان ووافقنا ح لنا قوله تعالي {فكاتبوهم} الاية وهي عامة من غير تفصيل ولان البدل معلوم والعقل بالتفصيل كما لو باعهم في عقد واحد احتجوا بانه لما كان العامل متعددا صارت في معني الصفقات والجهل بكل صفقة يجب فسادها كما لو باعهم لثلاثة من غير تفصيل لكل واحد عقل فان العقل يفسد ولان ما يلزم كل واحد مجهول فلا يدري بما كوتب والجواب عن الاول ان السيد واحد وهو المعتق الباءع مال نفسه بمال نفسه ولذلك جبرهم علي الكتابة علي الصحيح ولانه لو باع من ثلاثة دارا واحدث بثمن واحد فانه يجوز وان كاتب صفقات ولو باع ثلاثة اعبد مستوية من ثلاثة جاز عندنا او مختلفة وتراضوا بتسمية كل عبد منهم لكل واحد فانه يجوز نقله ابن القصار مع ان الفرق ان الكتابة يعتق فيها بالكتابة
 
 الفاسدة فيعتق بالمجهول ولان مقصوده المبايعة بالثمن ففسد بالجهالة ومقصود الكتابة العتق فلا يضر بالجهل كالانكاح والخلع والجواب عن الثاني انه يوزع بقدر القوة
  (تفريع)
 في الكتاب يضمن كل واحد منهم عن بقيتهم وان لم يشترط ذلك بخلاف حمالة الديون لان المقصود في العقد العتق فيبالغ في التوسل اليه ولا يعتق احد منهم الا باداء الجميع وللسيد اخذهم بذلك واخذ الملء بالجميع ولا يوضع منهم شء لموت احدهم لانهم كالرجل الواحد ويرجع المءدي علي المءدي عنه بحصته بعد قسمة الكتابة بقدر القوة علي الاداء يوم الكتابة لا علي قيمة الرقاب ولا يرجع علي من يعتق عليه ان لو ملكه الحر لان الاصل لا يملكه فكذلك بدله الذي هو العوض فان ادي حالا رجع بحصصهم علي النجوم لانهم انما التزموا ذلك وان زمن احدهما فادي الصحيح رجع عليه بحصته بما ينوبه يوم العقد ولك عتق الزمن قبل الاداء فانكره الصحيح لانه لا نفع له فيه وتبقي جميع الكتابة علي الصحيح وان ادي وعتق لم يرجع بشء عليه لانه لم يعتق بالاداء تبرعا منك وليس لك عتق قوي علي السعي ويرد ان فعلت لان فيه تعجيزا لهم فان ادوا عتقوا او عجز فالزمت ما صنعت من العتق كمن اخدم عبده او اجره ثم اعتقه فلم يجز ذلك للمخدم او المءاجر فاذا تمت المدة عتق وكمن رد غرماءه عتقه ثم ايسر قبل بيعه فادي الدين فان اجازوا عتقك وهم اقوياء علي السعاية جاز ويوضع عنهم حصة للمعتق لانه موجب العقد ويسعون فيما بقي فان اجازوا علي ان يسعي المعتق معهم امتنع العتق وسعوا كلهم في جميع الكتابة وان دبرت احدهم بعد الكتابة ثم
 
 عجز والزمت تدبيرك ولزمت قبل العجز والثلث يحمله وهو قوي علي الاداء حين مت لم يعتق الا برضا اصحابه وان كان زمنا عتق في الثلث ولا يوضع عن اصحابه شيءا لان من لا قوة له من صغير او زمن يجوز عتقه وان كرهوا ولا يوضع عنهم شء في الثلث قيل اذا لم يجبر واعتق القوي وادوا لم يرجع المعتق عليك بشء لانك اخرته بوجه جاءز ولو كان يرجع عليك سقط علي المكاتبين اولا وقال بعض شيوخنا اذا اعتقت زمنا لا حجة لهم بانهم اذا ادوا رجعوا عليه لان نفقة الذين تلزمهم ورفها بالعتق انفع لهم من اتباعه فانه قد لا يتيسر له شء قال ابن يونس قال محمد ولك كتابة كل عبد بكتابة ويتحمل بعضهم ببعض ولا يتبع كل واحد منهم ولا تنقضي كتابته ولا يعتقه بغير اذن صاحبه واسقاط ضمانه قال ابو محمد يعني ان ذلك في عقد واحد ويلزم علي ما قال ان يءدي واحد قبل الاخر ولا يعتق حتي يءدي الاخر ويجوز ان يتحمل عبدك بمكاتبك بخلاف الاجنبي وقال عبد الملك يقسم الكتابة بالحصة علي العدد لا بحسب القوة كما قال ابن القاسم وكذلك ان استحق احد اربعة سقط الربع وقال ش علي قدر القيمة دون القوة والعدد لنا ان وضع عقد الكتابة القدرة والكسب وان السادات يوصفون الخراج والكتابة والكسب لا بكسب القيمة واذا كان هو المقصود دون غيره احتجوا بان الكتابة تجري مجري البيع والاثمان تتبع القيم وجوابهم ان مقصودها العتق لا البيع لثبوت الولاء ودخول الغرر وبيع ماله بماله
 
 والعتق في فسادها كصحيحها قال ابن يونس وقوله اذا ادي احدهم الكتابة رجع بحصصهم علي النجوم يريد علي ما يقع علي كل واحد منهم من الكتابة يوم العقد ويجري فيه الخلاف المتقدم وعن ابن القاسم يرجع علي قدر قوتهم وقال اشهب علي قيمتهم يوم كوتبوا وقال اصبغ علي قدر قيمتهم يوم عتقوا وعنه يوم كوتبوا وحالهم يوم عتقوا ان لو كانت حالهم يوم كوتبوا قال اشهب ان كان فيهم صغير فبلغ السعي قبل ان يءدوا فعليه بقدر ما يطيق يوم وقعت الكتابة علي حاله قال محمد علي حاله يوم الحكم لو كان هذا يوم الكتابة وقال علي قدر طاقته يوم بلغ السعي ان لو كان بهذا الحال يوم الكتابة قال محمد اذا ادي الكتابة وعتقوا فان كانت الكتابة قد حلت رجع بذلك حالا والا رجع به علي النجوم والحمالة باقية عليهم للسيد قال ابن القاسم وان فلس احدهم حاص بما ادي عنهم غرماءه لانه سلف اخرجه عنهم من ماله بخلاف السيد في الكتابة والقطاعة قال محمد وانما يرجع عليهم اذا ادي جميع الكتابة وعتقوا واما ما لا يعتقون به فلا يرجع بذلك عليهم الا بعد العتاقة لان احدهم قبلها يضعفهم قال اللخمي قال مالك اذا مات احدهم لا يحط عنهم والقياس الحط عن كل واحد ما ينوبه لان واحدا اشتري نفسه بما ينوبه من تلك الكتابة وان استحق احدهم بحرية او بملك سقط ما ينوبه عنهم لانه تبين ان السيد عقد علي غير مالك ولا تلزمهم الحمالة بملك الغير وان غاب بعضهم او عجز لم يسقط عن الباقي شء فان عجز البعض وادي الاخر جميع الكتابة قال مطرف يرجع بقيمتهم يوم عتقوا وقال اشهب يوم كوتبوا قال والقياس بما كانوا يءدونه لو لم يعجز علي صفة القبض الاول قبل العجز لانه الذي كانت الحمالة به وان كان احدهم صغيرا ومضت الكتابة وهو غير قادر علي السعي لم يتبع بشء فان قوي بعد مضي بعض النجوم قال اشهب عليه بقدر ما يطيق يوم وقعت الكتابة علي حاله وقال محمد يوم الحكم لو كان يوم الكتابة بالغا وقال اصبغ علي قدر طاقته يوم بلغ السعي لو كان بحاله تلك يوم وقعت الكتابة لانه يومءذ وقعت عليه حمالة الكتابة
 
 وان ولد بعد الكتابة للمكاتب من امته او المكاتبة ثم بلغ السعي قبل انقضاء الكتابة فلا سبيل لهم عليه في السعاية ولا في المال الذي في يديه اذا كانت الام او الاب في كتابة فان احتاجوا سعي معهم او اخذو المال من يده وقيل تفض الكتابة عليه وعليهم كالموجود يوم العتق وان كان الصغير قاردا علي السعي يوم الكتابة فض عليه كما يفض علي الكبير علي قدر قوته فللصغير ثلاثة احوال يعتق بعتقهم ولا يتبع ولا يسعي معهم والثانية ان يسعي معهم ويفض عليه والحالة الثالثة لا يسعي ولا يءخذ ماله الا ان يحتاج اليه والزمن كالصغير في احواله ان كان زمنا يوم العقد واستم لم يتبع وان بقيت الزمانة قبل الاداء وكانت يوجادها بها حين العقد فعليه السعي ويختلف فيما يحمل عليه كما تقدم في الصغير وان كان مما لا يرجي وصار ذا قوة ومال لم يكن عليه شء الا ان يحتاج الي معونة والي ما في يديه وعلي القوة الاخر بعض الباقي عليه وعليهم وكذلك ان كان فيهم شيخ لا يقدر علي السعي عتق بعتقهم وان وهب له مال بعد ذلك لم يتبع بشء وان وهب له قبل ان يصير للعتق جري علي الخلاف اذا حدث الولد بعد الكتابة ولا تجوز كتابتك لعبدين لا شركة ساداتهما فيهما فان ترك هل يمضي ويفض عليهما وتسقط حمالة احدهما عن الاخر او يفسخ ما لم يءد نجما اوصل رامن الكتابة علي الخلاف في الشروط الفاسدة في الكتابة اذا استثني ما يولد او شرط الوطء وان كاتبت عبديك فاعتقت احدهما ورضي الاخر والمعتق ادناهما في السعاية جاز وسقط عن الباقي نصيب المعتق او اقواهما او مسا واجازه ابن القاسم اذا امن العجز ومنعه غيره لانه
 
 وسيلة للعجز والعبد ممنوع من الرضا بالعجز وان قويا وزمنا فاعتقت القوي فعلي القولين وان كانا كبيرا وصغيرا والصغير يبلغ السعي قبل انقضاء الكتابة لم يعتق الا برضا صاحبه ويحط لاجله وان ولد بعد العقد وبلغ او صار له ما لم يعتق الا برضا من معه لان ماله قوة لهم ان احتيج اليه ولا يحط لاجله شء لانه لم يكن عليه عند العقد شء وان اعتقت الاب قبل بلوغ الولد السعي رد عتقك لانه يرق الابن الا ان يكون عتقه بعد زمانة ونحوها فيرق الابن اذا لم يكن في يد الاب مال او كان له من المال ما لا يفي بالنجوم الا ان يبلغ الابن السعي فان كان له ما يفي بالنجوم اديت عنه وهل يقبضها السيد او يوقف خلاف قال ابن يونس اذا زمن احد المكاتبين فادي الاخر عنه وعن نفسه فاعتقت الزمن قبل تمام الكتابة قال ابو عمران يرجع عليه لانك اسقطت عنه باقي الكتابة وما اداه كدين لزمه قبل العتق قال ابن حبيب اذا اعتقت احد المكاتبين ولم يجز الباقون قيل يجري فيه القولان فيمن اجر عبده ثم اعتقه انه اذا قال اردت عتقه الان كانت بقية الاجارة للعبد فكذلك المكاتب اذا قصد عتقه للوقت فما اخذه منه يرده علي العبد قال سحنون في عتق احد المكاتبين ينبغي ان ينظر ان اذنهم للسيد انفع لهم ام لا والضعيف ينبغي ان يعتبر اذنهم فيه بخلاف القوي وان دبرت احدهما ثم مات السيد لم يعتق الا برضاء الاخر ويكون في الثلث الاقل من قيمته او ما يقع عليه من بقية الكتابة وقيل ان دبرت من لا سعاية فيه جعل قيمة الرقبة دون الكتابة لعجزه عنها وقيل هما سواء لان الكتابة قاءمة ورفقاءه يءدون عنه قال وهو الصواب وان كاتبت ثلاثة فابق احدهم وعجزهم السلطان فقدم الابق قويا والسلطان الذي عجزهم قاءم قال المغيرة القادم باق علي كتابته ان عتق هو والمكاتبون معه ويرجع عليهم بما ادي وقيل انما ذلك اذا لم يعلم الغاءب او
 
 جهل وجه الحكم فعجز اصحابه دونه فوجب نقض الحكم اما لو علم وتلوم له ثم عجز الجميع مضي الحكم عليه وعلي اصحابه قال محمد واذا زمن احدهما فقلت له ان عجزت فانت حر عتق الان لانه يقنع في توقيفه وكذلك الصبي
  (فرع)
