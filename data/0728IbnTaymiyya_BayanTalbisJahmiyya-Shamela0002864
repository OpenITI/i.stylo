 لا يعلم فيسلم ولا تكلم بما يعلم فيغنم تصرخ منه الدماء وتبكي منه الفروج الحرام ومن احق الناس بهذا هءلاء المتكلمون في اصول الدين بغير كتاب الله وسنة رسوله ويوقعون بين الامة العداوة والبغضاء بما لا اصل له حتي قد يكفرون من خالفهم ويبيحون قتلهم وقتالهم كما يفعل اهل الاهواء من الخوارج
 
 والرافضة والجهمية والمعتزلة كما فعله هذا المءسس في كتابه هذا وامثاله حيث كفر الذين خالفوه وهم احق بالايمان بالله ورسوله منه بدرجات لا تحصي ولا حول ولا قوة الا بالله ولهذا كان التكفير لمن يخالفهم من اهل السنة والجماعة من شعار المارقين كما قال النبي صلي الله عليه وسلم فيما استفاض عنه من الاحاديث الصحيحة في صفة الخوارج يحقر احدكم صلاته مع صلاتهم وصيامه مع صيامهم وقراءته مع قراءتهم يقرءون القران لا يجاوز حناجرهم يمرقون من الاسلام كما يمرق السهم من الرمية وفي رواية يقتلون اهل الايمان ويدعون اهل 
 
 الاوثان وهءلاء الذين يدعون الايمان لانفسهم دون اهل السنة والجماعة من المسلمين كالخوارج والروافض والجهمية والمعتزلة لهم نصيب من قوله تعالي وقالوا لن يدخل الجنة الا من كان هودا او نصاري تلك امانيهم قل هاتوا برهانكم ان كنتم صادقين {} بلي من اسلم وجهه لله وهو محسن فله اجره عند ربه ولا خوف عليهم ولا هم يحزنون {} [البقرة ] وبعضهم مع بعض كما قال الله تعالي وقالت اليهود ليست النصاري علي شء وقالت النصاري ليست اليهود علي شء وهم يتلون الكتاب كذلك قال الذين لا يعلمون مثل قولهم فالله يحكم بينهم يوم القيامة فيما كانوا فيه يختلفون {} [البقرة ] فهم كما قال الامام احمد مختلفون في الكتاب مخالفون
 
 للكتاب مجمعون علي مفارقة الكتاب قد جمعوا وصفي الاختلاف الذي ذمه الله في كتابه فانه ذم الذين خالفوا الانبياء والذين اختلفوا علي الانبياء فامن كل منهم ببعض وكفر ببعض قال في الاولين جاءتهم البينات ولكن اختلفوا فمنهم من امن ومنهم من كفر ولو شاء الله ما اقتتلوا ولكن الله يفعل ما يريد {} [البقرة ] وقال في الثاني قال تعالي ذلك بان الله نزل الكتاب بالحق وان الذين اختلفوا في الكتاب لفي شقاق بعيد {} [البقرة ] وقال تعالي ولا تكونوا كالذين تفرقوا واختلفوا من بعد ما جاءهم البينات واولءك لهم عذاب عظيم {} [ال عمران ] وقال ان الذين فرقوا دينهم وكانوا شيعا لست منهم في شء انما امرهم الي الله [الانعام ] وقال ولا يزالون مختلفين {} الا من رحم ربك ولذلك خلقهم وتمت كلمة ربك لاملان جهنم من الجنة والناس اجمعين {} [هود ] وهءلاء الجهمية معروفون بمفارقة السنة والجماعة وتكفير من خالفهم واستحلال دمه كما نعت النبي صلي الله عليه وسلم الخوارج لكن قولهم في الله اقبح من قول الخوارج وان كان للخوارج من المباينة للجماعة والمقاتلة لهم ما ليس لهم مع ان اهل المقالات ذكروا ان قول الخوارج في الصفات هو قول الجهمية والمعتزلة هذا ذكره الاشعري وغيره من المعتزلة وهذا
 
 والله اعلم يكون قول من تاخر من الخوارج الي ان حدث التجهم في اول الماءة الثانية واما الخوارج الذين كانوا في زمن الصحابة وكبار التابعين فاولءك لم يكن قد ظهر في زمنهم التجهم اصلا ولا عرف في الامة اذ ذاك من كان ينكر الصفات او ينكر ان يكون علي العرش او يقول ان القران مخلوق او ينكر رءية الله تعالي ونحو ذلك مما ابتدعته الجهمية من هذه الامة وقد تكلمنا علي هذه الحجة في غير هذا الموضع بما فيه كفاية ونذكر ما يليق بهذا الموضع وذلك من وجوه احدها ان قوله لو كان حصوله في جهة لكان اما ان يكون في اكثر من حيز واحد او لا يكون الا في حيز واحد
 
 يقال له اما الذين يقولون انه فوق العرش وليس بجسم وهو اءمة اصحابك والكلابية وطواءف كثيرة من الفقهاء واهل الحديث والصوفية وقد ذكر الاشعري انه قول اهل السنة واصحاب الحديث فيمنعون التلازم ويقولون لا نسلم انه اذا كان في جهة بمعني انه نفسه فوق العرش لكان اما ان يكون في حيز واحد او في اكثر من حيز فان هذا التلازم انما فيما اذا كان الذي فوق العالم جسما اما اذا وافقتمونا علي انه ليس بجسم فان التقدير يكون اذا كان فوق العالم ما ليس بجسم او اذا كان في الجهة ما ليس بجسم فانه اما ان يكون في حيز واحد او اكثر ومعلوم ان ما ليس بجسم لا يكون في الحيز الاصطلاحي لا في واحد ولا في اكثر وهذا ظاهر واضح فان قلت هذا متناقض فانه اذا كان فوق العالم او في الجهة وجب ان يكون جسما قيل لك اولا قد صدرت الكلام في هذه المسالة بانه لا يلزم من نفي كون الشء جسما نفي اختصاصه بالحيز واذا سلمت لهم لم يكن لك ان تنازعهم فيه فان هذا راس المسالة فيكون التقدير باتفاق منك ومنهم ان
 
 ما ليس بجسم اذا كان في الجهة بمعني انه يكون فوق العالم هل يكون في حيز واحد او في حيزين يعني الحيز الاصطلاحي وهم يقولون انه لا يكون في الحيز الاصطلاحي مع كونه فوق العالم ومع كونه في الجهة وهي جهة العلو الوجه الثاني ان يقال قولك في حيز واحد او في اكثر من حيز يقتضي تعدد الاحياز وذلك ممنوع فان الاحياز اما ان تكون وجودية او عدمية وهي ليست وجودية كما قررته في هذه الحجة وفي غيرها واذا كانت عدمية فالعدم المحض لا يتعدد ولا يقال فيه اما ان يكون واحدا او اثنين فامتنع ان يقال اما ان يكون في حيز واحد او في حيزين ويتقوي هذا بالوجه الثالث وهو ان الحيز اما ان يكون وجوديا او عدميا فان كان وجوديا جاز اختصاصه بامر وجودي علي سبيل الوجوب كاختصاصه بصفاته الواجبة له
 
 الوجودية وحينءذ فيبطل ما ذكره في الحجة من امتناع كونه في الحيز واجبا او جاءزا وان كان الحيز عدميا لم يصح ان يقال اما ان يكون في حيز واحد او في حيزين وهذا يقتضي بطلان احد طريقيه اللذين ذكرهما في هذه الحجة احدهما اما ان يكون في حيز او حيزين والثاني امتناع كونه واجبا او جاءزا يوضح هذا الوجه الرابع وهو ان احياز المتحيز الوجودية اللازمة له هي حدوده ونهايته والعدمية هي ما يقال انه تقدير المكان فان اراد بالحيز الامر الوجودي منعت الحجة التي منع فيها ان يكون له حيز واجب وان اراد به الامر العدمي منع انقسامه الي واحد وكثير فان قيل الحيز العدمي الذي هو تقدير المكان يتحدد ويتعدد باتحاد الحال وتعدده فاذا كان الحال فيه جوهرا واحدا كان واحدا وان كان جواهر متعددة كان متعددا قيل الجواب عن هذا هو الوجه الخامس وهو ان هذه المسالة قد صدرها بالكلام في الحيز مع من يقول انه ليس بجسم ومع هذا فانه يكون مختصا بالجهة وقد قال هو لما ذكر الحجة اذا ثبت ذلك ثبت انه لا يلزم من نفي كون الشء جسما نفي اختصاصه بالجهة والحيز
 
 واذا كان كذلك فيقال اما ان يكون الحيز مستلزما لكون الحال فيه جسما او جوهرا فردا او لا يستلزم ذلك فان كان الحيز مستلزما لذلك لم يكن المختص بالحيز الا جسما او جوهرا فردا وحينءذ فيلزم من نفي كونه جسما وكونه جوهرا فردا ان لا يكون متحيزا كما قد بفعله المءسس وغيره احيانا وهو خلاف الفرض فان الفرض نفي الحيز والجهة بدون البناء علي نفي الجسمية خلافا لمن يقول ليس بجسم ولكنه في الحيز والجهة فاذا كان هذا الدليل لا يتم الا بنفي الجسمية بطل هذا الدليل من اصله ومتي كان الحيز مستلزما للجسم او للجوهر الفرد لزم من نفي اللازم وهو الجسم والجوهر الفرد نفي الملزوم وهو الحيز وان كان الحيز ليس مستلزما للجسم والجوهر الفرد لم يلزم ان يكون الحال فيه جسما ولا جوهرا فردا وحينءذ فلا يلزم ان يقال ينقسم بانقسام الحال فيه ان كان جوهرا فردا كان الحيز واحدا وان كان جسما كان او اكثر من واحد فان الحال فيه علي هذا التقدير لا يكون جسما ولا جوهرا فردا وان كان كذلك ظهر ان تقسيمه الحيز الي واحد اكثر من واحد غير لازم علي هذا التقدير ولا يصح الدليل علي التقدير الاول وذلك يظهر بطلانه علي التقديرين الوجه السادس ان يقال هب انه لم يسلم ان الحيز مستلزم لكون الحال فيه جسما ولم يسلم ان نفي الجسم لا يستلزم نفي
 
 الحيز لكن يقال انقسام الحيز الي واحد او اكثر من واحد اما ان لا يعلم الا بان يعلم ان محله جسم او جوهر او يعلم قبل العلم بحاله محله فان لم يعلم اتحاده وتعدده الا بالحال فيه لم يلزم اذا قيل ان الله في حيز ان يكون الحيز منقسما الي واحد وعدد حتي يثبت انه يجب ان يكون الله جسما او جوهرا فردا فيكون العلم بانقسام الحيز الي واحد وعدد متوقفا علي العلم بان الباري تعالي يجب ان يكون علي هذا التقدير جسما او جوهرا فردا وهو لم يبين ذلك واذا تبين ذلك كان نفي الجسم كافيا له في نفي كونه متحيزا فلم يحتج حينءذ الي تقسيم الحيز الي واحد او اكثر من ذلك فظهر ان هذا الذي ذكره لم يذكر عليه حجة ولو ذكر عليه حجة لم يحتج الي ذكره وعلي التقديرين فلا يصلح ذكره لا مع الحجة ولا بدون الحجة علي هذا التقدير وان كان العلم بانقسامه الي واحد او عدد يعلم بدون ان يعلم ان محله جوهر او جسم فليذكر ذلك او لم يذكره فيتوجه المنع ثم انه لا يصلح ان تحتج علي ذلك الا بكون الحيز ينقسم بانقسام الحال فيه والحال فيه لا يكون الا جوهرا او جسما لان التقدير ان انقسامه لا يتوقف العلم به علي هذه الحجة الوجه السابع ان يقال وصف الشء بانه واحد وبانه اكثر من واحد اما ان يستلزم كونه موجودا او لا يستلزم كونه موجودا فان استلزم كونه موجودا لزم من هذا التقسيم ان يكون وجوديا وانت قد ذكرت في تمام الحجة انه ليس بوجودي وان كان الوصف بان وجودي وان كان الوصف بانه واحد وباكثر من
 
 واحد لا يستلزم انه موجود بطل ما ذكره فيما تقدم حكايته عنه من ان الجسم منقسم ليس بواحد فانه بني ذلك علي ان الوحدة صفة قاءمة بالجسم قال والعرض لا يحدث في المحل ولا يحصل فيه الا اذا كان المحل متعينا متميزا عن غيره فانه اذا ثبت ان كون الموصوف واحدا او اكثر لا يستلزم ان يكون موجودا لم يلزم ان تكون الوحدة والكثرة صفة وجودية فان المعدوم لا يوصف بالصفة الوجودية فاذا لم يجب ان تكون الوحدة وجودية لم يجب ان تقوم بالجسم ولا ان يكون عرضا فلا يمتنع ان يكون الجسم واحدا واذا كان الجسم واحدا مع عظمته ولم يكن فيه كثرة وجودية لم يصح ان يستدل بحلوله في الحيز علي انقسام الحيز وتعدده وحينءذ فاذا لم يلزم من حلول الجسم في الحيز ان يكون الحيز متعددا منقسما في نفسه لم يلزم من حلول الرب في الحيز ان يكون منقسما وجاز حلوله في الحيز الذي لا يقال انه اكثر من واحد ولا يكون اقل القليل ولا يكون جوهرا فردا وبالجملة فاذا لم يكن الجسم مشتملا علي كثرة مع كونه في الحيز فالباري اولي ان يكون كذلك وحيزه اولي بذلك وهو يبطل ما ذكره الوجه الثامن ان يقال الحيز في نفسه ليس الا واحدا
 
 وليس هو في نفسه منقسما ولا متكثرا واذا كان كذلك لم يصح ان يكون الحال فيه اما ان يحل في حيز واحد او في احياز متعددة فان هذا مقتضي ان الحيز فيه كثرة وهذا ممنوع وتوجيه ذلك ان الناس قد تنازعوا في الجسم هل هو واحد في نفسه او هو متكثر فيه انقسامات حاصلة علي قول كما تقدم حكايته وتقدم ان المءسس لم يذكر علي انقسامه وعدمه وحدته حجة واذا كان الامر كذلك مع ان الجسم يقبل الانقسام بلا نزاع فالحيز الذي لا يعقل فيه وجود الانقسام اولي ان لا يكون فيه كثرة ولا انقسام وهذا ظاهر بل يقال في الوجه التاسع ان انقسام الحيز في نفسه قبل حلول شء فيه ممتنع قطعا سواء قيل ان الجسم واحد او منقسم في نفسه وذلك لان الحيز هنا ليس المراد به شيءا موجودا كما قد قرره وانما هو تقدير المكان وهذا هو مسمي الحيز في اصطلاح كثير من المتكلمين واذا كان كذلك فمن الممتنع ان يتميز بعضه عن بعض قبل حلول ما يتقد ربه وهذا معلوم بالحس والضرورة العقلية ولا يقول قاءل ان ذلك يتميز بالاشارة فان الاشارة الي العدم محال وانما يشار الي موجود واذا كان الحيز لا يتعدد ولا ينقسم قبل حلول الحال
 
 فيه كان تعدده تابعا لتعدد الحال فيه فان لم يثبت كون الحال فيه جسما منقسما لم يكن منقسما واذا كان المنازع له يقول ان الحال فيه ليس هو جسما او هو جسم وليس بمنقسم في نفسه بطل انقسام الحيز ومن المعلوم ان القاءلين بانه متحيز يقولون هذا تارة وهذا تارة كما تقدم ذكر ذلك عنهم ومن قال انه منقسم بمعني يتميز بعضه عن بعض فجوابهم ما يقال في الوجه العاشر ان يقال الحيز الواحد هو ما يحل فيه الجوهر الفرد كما فسرته فيما بعد فان الحال فيه يكون اقل القليل ويتعالي الله عن ذلك واذا كان كذلك كان ثبوته مبنيا علي ثبوت الجوهر الفرد وانت قد اعترفت انك واذكياء الطواءف متوقفون فيه لتعارض الادلة فيه واذا لم يعلم ثبوت الجوهرالفرد لم يعلم ثبوت حيز واحد بهذا الصغر واذا لم يعلم ذلك بطل العلم بان الحيز اما واحدا بهذا التفسير واما اكثر من واحد
 
 الوجه الحادي عشر ان يقال لك ما مرادك بالحيز الواحد وباي شء يتميز الحيز الواحد عما هو اكثر منه فان اردت به ما يحله الجوهر الفرد لم يثبت توحد الحيز حتي يثبت الجوهر الفرد ويثبت حلوله فيه ومن المعلوم ان الجوهر الفرد لو كان ثابتا في نفس الامر فليس هو مما يحس به حتي يعلم حلوله في الحيز او عدم حلوله بل اكثر ما يقال انه داخل الجسم في حيز قد علمنا ان الجواهر التي خلقت فيه ايضا لكن هذا لا يفيد تميز الحيز الواحد عن غيره ولا العلم به واذا كان الحيز الواحد الذي اردته لا يتميز ولا يعلم به كان العلم بحلول الشء فيه او عدم حلوله باطلا لان العلم بحلول الشء في محله فرع تصور المحل فاذا كان المحل لا يعلم توحده ولا يتميز كان الحكم بثبوت الحلول فيه او عدمه حكما باطلا فيكون الدليل باطلا الوجه الثاني عشر ان يقول لك المنازع اما ان تريد بالحيز الواحد ما يحل فيه الجوهر الفرد او ما هو اكبر منه فان اردت الاول فحلول الرب فيه محال كما ذكرته وكان المنازع يقول لك يحل في اكثر من واحد بهذا التفسير
 
 واما قولك الحاصل في احد الحيزين اما ان يكون هو الحاصل في الاخر او غيره يقال لك لا هو هو ولا هو غيره او لا يقال هو هو ولا هو غيره كما تقدم تقرير ذلك علي اصل كثير من متكلمي الصفاتية او اكثرهم غير مرة بان الغيرين ما جاز وجود احدهما دون الاخر او ما جاز مفارقته له في مكان او زمان او وجود فحينءذ لا يرد ما ذكرته علي كونه هو هو وكونه غيره وان اردت بالواحد ما هو اكبر من محل الجوهر الفرد لم يكن الحال مستلزما لان يكون اقل القليل وقد بطل حجة الصغير وسياتي الكلام علي الوجوب والجواز الوجه الثالث عشر ان يقال هذه الحجة مشتملة علي حجتين احداهما حجة الانقسام او الصغر وهي تعم الاقسام والثانية ما يخص قسما قسما مع ذلك ونحن نتكلم علي الحجتين جميعا فاحداهما حجة الانقسام والتركيب والاخري هي من جنس حجة تماثل الاجسام وهاتان الحجتان هي جماع ما يذكره النفاة في هذا الباب فانه يعود الي ما يذكره من التركيب والي ما يذكره من التمثيل وقد تقدم فيما يمتنع من ذلك وما لا يمتنع وبينا ان سورة الاخلاص قل هو الله
 
 احد {} الله الصمد {} [الاخلاص ] تنزهه عن الممتنع من هذين فاسمه الاحد منع التشبيه الممتنع عليه واسمه الصمد منع الانقسام والتركيب الممتنع عليه ولكن هءلاء النفاة غلوا في ذلك وتعدوا حدود الله فيه فزادوا علي الحق من الباطل شيءا كثيرا كما ان من المثبتة من غلا في الاثبات وتعدي حدود الله حتي زاد علي اثبات الحق زيادات باطلة والله يهدينا الصراط المستقيم وليس هذا موضع الشرح والبسط لما تضمنته هذه السورة العظيمة من اصول التوحيد والايمان فانها كثيرة عظيمة اذ الاحدية والصمدية ينتظمان اصول التوحيد والايمان والدين فاسماء الله وصفاته من دينه اذ دينه الحق يتبع ما هو عليه سبحانه في نفسه ولما كان الدين عند الله هو الاسلام والاسلام هو الاستسلام لله وحده وله ضدان الاشراك والاستكبار فالمستكبر استكبر عن الاسلام له والمشرك استسلم لغيره وان كان قد استسلم له فمعني الاحد يوجب الاخلاص لله المنافي للشرك ومعني الصمد يوجب الاستسلام لله وحده المنافي للاستكبار فان الصمد يتضمن صمود كل شء اليه وفقره اليه وايضا فدين الله واحد لا تفرق فيه والصمد يناسب اجتماعه فالله سبحانه وتعالي هو الاله الواحد ودينه واحد
 
 وعباده المءمنون مجتمعون يعتصمون بحبله غير مفترقين واسمه الاحد يقتضي التوحيد والصمد يقتضي الاجتماع وعدم التفرق فان الصمد فيه معني الاجتماع وعدم التفريق والتوحيد ابدا قرين الاجتماع لان الاجتماع فيه الوحدة والتفرق لابد فيه من التثنية والتعدد كما ان الاشراك مقرون بالتفرق قال
 
 تعالي فاقم وجهك للدين حنيفا فطرة الله التي فطر الناس عليها لا تبديل لخلق الله ذلك الدين القيم ولكن اكثر الناس لا يعلمون {} منيبين اليه واتقوه واقيموا الصلاة ولا تكونوا من المشركين {} من الذين فرقوا دينهم وكانوا شيعا كل حزب بما لديهم فرحون {} [الروم ] ولهذا كان شعار الطاءفة الناجية هو السنة والجماعة دون البدعة والفرقة فان اصل السنة توحيد الله وعبادته وحده لا شريك له واصل البدع الاشراك بالله شركا اصغر او اكبر وهءلاء الملبسون يقولون لا ينقسم او لا يتجزا او لا يتبعض ونحو ذلك ولو لم يريدوا الا ما هو حق لكانوا محسنين لكن حقيقة قولهم انه ليس هناك شء يتصور ان يكون مجتمعا فضلا ان يكون متفرقا ولا شء موجود يتميز عن غيره فضلا عن ان يكون منقسما فاخذوا لفظ التفرق والانقسام فوضعوه علي غير المعاني المعروفة ونفوا به ما يستلزم نفي الحقيقة بالكلية كما فعل غيرهم في نفي العلم والقدرة ونحوهما او نفي الاسماء كالحي والعليم والقدير ونحو ذلك فنفي الصفات يستلزم نفي الاسماء كما قد ذكرناه في غير هذا الموضع
 
 والمقصود هنا الكلام علي هاتين الحجتين الانقسام والحيز بحسب ما ذكره في نهايته وان كان قد تقدم الكلام عليها فنقول قوله اذا كان في اكثر من حيز لزم انقسامه لا نسلم انه يستلزم انقسامه ولا نسلم ايضا ان الحيز ينقسم حتي يكون ما فيه منقسما ولو كان هو منقسما لم نسلم ان كل ما كان في المنقسم يجب ان يكون منقسما الوجه الرابع عشر انه قد تقدم غير مرة ان هذا الانقسام اكثر ما يراد به امتياز بعضه عن بعض وبينا ان هذا مثل امتياز الصفات وبينا ان هذا مما يجب ان يقر به كل احد في كل موجود وان نفي هذا يستلزم جحد الموجودات جميعها الواجب والممكن وبينا ان ما يذكر في ذلك من الافتقار
 
 والغير والحيز فهي الفاظ مجملة مشتركة مشتبهة يراد بها حق وباطل فيجب ان ينفي ما فيها من الباطل دون الحق الذي يريده بعض الناس بهذه الالفاظ وقد تقدم بسط ذلك بما يغني عن اعادته وهو احال علي ما تقدم فاحلنا ايضا عليه الوجه الخامس عشر ان المنازع يقول له هب انه في حيز واحد فلم قلت ان ذلك محال قولك انه يكون اقل القليل ويتعالي الله عنه يقال لا نسلم ان ما هو حيز واحد لا يتسع الا مقدار الجوهر الفرد بل يكون واحدا وهو عظيم وهذا في الحيز اولي منه في الجسم فاذا كان قد قال
 
 طواءف ان الجسم يكون عظيما ويكون واحدا فالحيز اولي وايضا فمن قال انه فوق العرش وهو عظيم وليس بجسم او هو جسم وليس بمركب فانه يقول بثبوت حيز واحد عظيم الوجه السادس عشر ان المنازع يقول الجوهر الفرد لا يخلو اما ان يكون ثابتا او لا يكون فان كان ثابتا لم تكن قد ذكرت دليلا عقليا علي نفي كونه بقدره كما اعترفت بذلك فيما تقدم في نهايتك في المسلك الثاني علي نفي الجسم ان المنازع اذا اصر علي المطالبة بالدليل علي انه حال كونه بقدر الجوهر فطريق دفعه ان يتمسك بالوجوه التي يستدل بها علي نفي الجزء الذي لا يتجزا حتي تنقطع المطالبة واذا
 
 لم يكن لك طريق الا هذا فهذا الطريق باطلة اذا قدر ثبوت الجوهر الفرد فانه بتقدير ثبوته تكون الوجوه التي احتج بها علي نفيه باطلة واذا لم يكن الجوهر الفرد ثابتا لم يجز ان يقال ان الحال في الجزء الواحد هو اقل القليل بل لم يكن للحيز الواحد اذا فسر بذلك وجود اصلا واذا كان كذلك فعلي التقديرين لا تكون قد ذكرت حجة علي انه لا يكون في الحيز الواحد وانما تعتصم في مثل ذلك بالاجماع اجماع العقلاء واجماع المسلمين داخل في ذلك فيقال لك هءلاء المنازعون يقول ون انه عظيم في نفسه اعظم من كل عظيم واكبر من كل كبير واعلي من كل عال قد وسع كرسيه السموات السبع والارضين السبع ويقولون لك وما قدروا الله حق قدره والارض جميعا قبضته يوم القيامة والسماوات مطويات بيمينه [الزمر ] قال ابن عباس ما السموات السبع والارضون السبع وما بينهما في يد الرحمن الا كخردلة في يد احدكم او كما قال فهذا مستند ثان نفي كونه بقدر الجوهر الفرد فان سلمت ذلك لم يكن لك
 
 ان تقول ليس فوق العرش ولا هو في نفسه كبير وعظيم ولم يكن ما سلمتموه يستلزم ان لا يكون فوق العرش وان قيل انه في حيز واحد او جهة واحدة وان لم تسلم ذلك بل زعمت انما فوق السموات رب ولا هناك اله اصلا وان محمدا لم يعرج به الي الله تعالي بل صعد الي علو العالم فقط وان رب العالمين ليس داخل العالم ولا خارجه قالوا لك نحن نقول ان من وصفه بهذا فقد جعله معدوما والمعدوم احقر من الجوهر الفرد واذا كان كذلك لم نسلم لك ما دمت مصرا علي هذا النفي انه احقر من الجوهر الفرد فان ذلك يستلزم تسليم النقيضين فنكون قد سلمنا انه معدوم وانه احقر من الجوهر الفرد وذلك باطل واذا لم نسلم له علي هذا التقدير انه احقر من الجوهر الفرد لم يكن له ان يحتج بالاجماع كما تقدم نظير هذا وتقدم ما قرره في اول نهايته ان الاحتجاج بمثل هذا الاجماع الذي يختلف فيه الماخذ لا يصح نظرا ولا مناظرة فان المناظر ليس له ان يحتج بموافقة موافق بناء علي ماخذ لا يعتقد صحته والمناظر يجيبه خصمه بانك ان وافقتني علي الماخذ والا منعتك الحكم علي هذا التقدير لانه عندي تقدير غير واقع فلا يكون له حجة بحال ولو احتج بها في الفطرة في
 
 اعظام الله ان يكون كذلك قيل له هذه الفطرة التي فيها ان الله تعالي فوق العالم وهي تحيل ان يقال انه ليس فوق العالم ولا داخله ولا خارجه كما تحيل ان يقال هو بقدر الجوهر الفرد فان كان ما في الفطرة من هذا حقا فكذلك الاخر وحينءذ فلا يبقي معه حجة علي نفي كونه بقدر الجوهر الفرد لا عقلية ولا سمعية لان السمع اما نص واما اجماع والسمعيات التي وصف الله فيها نفسه بانه علي وعظيم وكبير معناها عندهم القدرة والقهر لا يعنون بها عظم قدره في نفسه فلا ينافي ما زعموه صغر المقدار لاسيما مع ما يعتمدونه من القول بان الملك العظيم والادمي العظيم يكون بقدر الجوهر الفرد لان الحياة ولازمها لا تحل الا في قدر ذلك كما تقدم واذا لم يكن لهم علي ذلك حجة بطلت هذه الحجج التي ذكرها وظهر عجزهم عن تنزيه الله عن صغر القدر كما عجزوا عن تنزيه الله تعالي ان يكون فيه نقص فلا يقدرون ان ينزهوه علي اصولهم العقلية عن نقص ولا عن صغر الوجه السابع عشر قوله في الحجة الثانية حصوله في ذلك الحيز اما واجب واما جاءز يقال ان اريد بالحيز ما
 
 هو داخل في مسمي اسمه مثل ما يدخل في صفاته في مسمي اسمه ومثل ما يدخل حدود الشء ونهايته في مسمي اسمه فيقال حصوله فيه واجب ويكون وجوديا والكلام في قوله يكون منقسما قد تقدم غير مرة بان الانقسام لفظ مجمل تختلف فيه الاصطلاحات فهو منفي بالمعني الذي لا يلزم من هذا والمعني الذي يلزم لا محذور فيه بل هو واجب لكل موجود الوجه الثامن عشر قول من يقول لا يجوز عليه الحركة والانتقال فانه يقول حصوله في الحيز المعين يكون واجبا واما قوله لو كان كذلك لكانت حقيقة ذلك الحيز مخالفة لحقيقة غيره فيكون وجوديا يقول لا نسلم وذلك لان الاختصاص لا يجب ان يكون لمعني في الحيز بل يجوز ان
 
 يكون لمعني في الرب وهو ما توافقهم عليه من امتناع الحركة والانتقال وعدم ذلك ليس بنقص عندك ولا عندهم كما تقدم وتقدم ان ما الزمتهم من كونه يكون كالزمن هو لك الزم ايضا فانت وهو مشتركون في ذلك وهو بك الصق منه بهم الوجه التاسع عشر ان يقال هب ان وجودي وحقيقته مخالفة لحقيقة غيره وانه يمكن الاشارة الحسية اليه فقولك انه ان كان منقسما كان الباري فيه الحال منقسما يمنعون الملازمة كما تقدم ويقولون في الانقسام بما تقدم من الجواب المفصل الوجه العشرون قولك او لا يكون منقسما فيكون مختصا بجهة دون جهة فيكون للحيز حيز اخر ويلزم التسلسل يقال هب ان هذا الحيز امر وجودي فلم لا يجوز ان يكون حيز هو عدمي والتسلسل انما يلزم ان لو كان لكل حيز وجودي حيز وجودي الوجه الحادي والعشرون قولك وان لم تمكن الاشارة
 
 الحسية الي الحيز الذي حصل فيه الباري وجب استحالة الاشارة الي الباري لانا نعلم بالضرورة ان ما لا تمكن الاشارة الحسية الي جهته استحالت الاشارة الحسية اليه فاذا لا يكون الباري في الجهة يقال لك الضروري بان ما لا يشار الي جهته لا يشار اليه ليس باعظم من ان ما لا يشار اليه لا يشار الي جهته ثم كثير من الناس وانت من هءلاء في كثير من المواضع يقولون ذلك مثل العلم الضروري بان ما يشار اليه والي جهته لا يكون الا جسما وكثير من الناس بل اكثرهم يقولون ان ذلك مثل العلم الضروري بان ما لا يشار اليه ولا الي جهته ولا يكون داخل العالم ولا خارجه لا يكون الا معدوما بل المقرون بان هذا علم ضروري اعظم من المقرين بذلك واذا كان كذلك فان نازعتهم في هذا العلم الضروري لم يكن عليهم ان يسلموا لك ذلك العلم الضروري الذي يلزمهم بتسليمه نفي هذا العلم الضروري لان تسليم العلم الضروري الذي يستلزم نفي علم ضروري تسليم لتنافي العلمين الضروريين وذلك باطل فلا يجب تسليم الباطل وان لم
 
 تنازعهم في هذا العلم الضروري لم يكن ما ذكرته حجة عليهم فانه اذا سلم انه فوق العالم وانه يمتنع ان يكون لا داخل العالم ولا خارجه حصل المطلوب الوجه الثاني والعشرون قولك وان لم يكن حصوله في الجهة واجبا فاختصاصه بها لابد ان يكون لفاعل مختار فاختصاص الباري به محدث فهو في الازل ما كان في الحيز والذي يكون كذلك يستحيل ان يصير حاصلا في الحيز وفي نسخة محتاجا الي الحيز فيقال لك اذا كان الحيز امرا وجوديا كالعرش والغمام كان اختصاص الله بكونه فوق العرش تابعا لخلقه العرش وذلك حاصل بمشيءته واختياره وهو محدث وهو ان لم يكن في الازل علي العرش لكن لم قلت اذا لم يكن في الازل علي العرش انه يستحيل ان يصير بعد ذلك علي العرش هذا لم تذكر عليه دليلا واما ان كان المدعي انه يستحيل ان يصير محتاجا الي الحيز فهذا حق لكن كونه فوق العرش لا يوجب
 
 احتياجه الي شء بل هو الحامل بقدرته للعرش ولكل شء الوجه الثالث والعشرون ان يقال العلو علي العرش للناس فيه قولان مشهوران احدهما انه نسبة واضافة بينه وبين العرش من غير فعل محدث يقوم بذات الرب وهءلاء قد يقولون الاستواء من صفات الذات وعلي هذا التقدير فتجديده بخلق العرش كتجديد ساءر النسب والاضافات وذلك جاءز باتفاق العقلاء كتجدد المعية والثاني انه استوي علي العرش بعد ان لم يكن مستويا عليه كما دل علي ذلك القران والذي قال هذا يقول في استواءه الي السماء ونزوله ومجيءه واتيانه ونحو ذلك مثلما يقول في الاستواء وان ذلك من افعال ذات الله تعالي وهءلاء هم جمهور اهل الحديث وكثير من اهل الكلام والفقهاء والصوفية
 
 وغيرهم وعامة كلام السلف يدل علي هذا وهذا متصل بمسالة حلول الحوادث به وهو قد ذكر انه ليس في الادلة العقلية ما ينفي حلول الحوادث به وذكر ان الطواءف جميعهم يلزمهم القول به واذا كان كذلك لم يمتنع ان يستوي عليه بعد ان لم يكن مستويا واذا كان علي القولين لا يمتنع ان يصير فوق العرش وان لم يكن في الازل عرش يكون الله فوقه بطل ما ادعاه من انه اذا كان اختصاص الباري بالحيز محدثا فهو اذا في الازل ما كان حاصلا في الحيز والشء الذي يكون كذلك استحال ان يصير
 
 حاصلا في الحيز فان ذلك لا يستحيل علي الوجه الذي بيناه واما ان كان قد قال استحال ان يصير محتاجا الي الحيز فهذا حق لكن تجدد الامور الجاءزة لا يقتضي انه محتاج اليها الوجه الرابع والعشرون انه يقال قولك في اصل هذه الحجة الثانية حصوله في الحيز اما ان يكون واجبا او غير واجب يقال لك اتريد بالحيز نوع الحيز ام تريد الحيز المعين فان اللام تكون للجنس وتكون للحيز المعين فان اردت به النوع لم يصح ما ذكرته في القسم الاول وهو قولك لو صح حصوله في ذلك الحيز وامتنع حصوله في ساءر الاحياز لكانت حقيقته مخالفة لحقيقة غيره لان الحيز علي هذا التقدير هو النوع ولا يختص بشء دون شء كما ان القاءل اذا قال لو كان الجسم مختصا بالحيز لم يرد به حيزا بعينه بل يريد به انه مختص بانه لا يكون الا متحيزا فيمتنع ان يكون غير متحيز وان اردت به الحيز المعين لم يصح ما ذكرته في القسم الثاني وهو انما كان كذلك ما كان في الازل حاصلا في
 
 الحيز المعين والذي يكون كذلك يستحيل ان يصير حاصلا في الحيز وذلك ان الحيز تقدير المكان ليس امرا موجودا فلم قلت انه اذا لم يكن في الازل في حيز معين امتنع ان يكون بعد ذلك في حيز معين فان هذا مبني علي مسالة حلول الحوادث وقد تقدم القول فيه الوجه الخامس والعشرون ان قولك والشء الذي يكون كذلك استحال ان يصير حاصلا في الحيز يمنعه المنازع ويقول لا نسلم ان كل اختصاص بحيز معين وهو تقدير المكان يكون محدثا وانه يمتنع ان يصير في حيز لم يكن فيه بل الحي القادر سبحانه يختص بما يشاء من الاحياز ولا يلزم من ذلك اختصاصه بحيز معين ولا يلزم من ذلك ان اصل التحيز محدث بل هو سبحانه وتعالي يخلق ما يشاء من الاجسام ولا يكون الجسم مخلوقا في حيز ولا يختص بحيز بل له ان ينقله من حيز الي حيز وهءلاء يقولون حياته وقدرته توجب ذلك ونفي امكان
 
 ذلك يقتضي نفي حياته وقدرته كما تقدم حكاية قولهم ويقولون اختصاصه بحيز دون حيز هو نسبة واضافة الي ذلك الحيز والامور الاضافية لا يمنع تجددها ولا زوال المتقدم منها باتفاق العقلاء فان الحيز العدمي الذي هو تقدير المكان يجري فيه القولان في العرش ونحوه فمن قال الاستواء عليه مجرد نسبة امكن ان يقول ذلك هنا ومن قال ان فيه حركة قال بذلك هنا الوجه السادس والعشرون قولك حصوله في الحيز اما ان يكون واجبا واما ان يكون غير واجب يقول لك المنازع قولا مفصلا الاختصاص باصل الحيز واجب اما تعين حيز دون حيز فهو ممكن ليس بواجب وذلك لان الحيز في الاصطلاح المشهور للمتكلمين هو تقدير المكان وهم يقولون ان كل متحيز يستلزم نوع التحيز واما الحيز المعين فيجوز ان ينتقل عنه المتحيز كما لو شاء الله تحويل العالم من حيز الي حيز ثم لهم هنا قولان
 
 احدهما ان اختصاصه بذلك الحيز المعين مجرد نسبة واضافة واذا كان تجدد النسب والاضافات له وزوالها من الامور الموجودة جاءز باتفاق العقلاء فحدوث هذه النسب وزوالها عما هو تقدير المكان بطريق الاولي والاحري الثاني ان يقال اكثر ما في ذلك الحركة وهذا جاءز كما تقدم في قولهم استوي علي العرش بعد ان لم يكن مستويا عليه وانه يجء يوم القيامة وياتي ونحو ذلك
 
 فصل قال الرازي الفصل الخامس في حكاية الشبه العقلية في كونه تعالي مختصا بالحيز والجهة الشبهة الاولي لهم انهم قالوا العالم موجود والباري موجود وكل موجودين فلابد ان يكون احدهما محايثا للاخر او مباينا عنه بجهة من الجهات الست ولما لم يكن الباري محايثا للعالم وجب كونه تعالي مباينا عن العالم بجهة من الجهات الست واذا ثبت ذلك وجب كونه تعالي مختصا بجهة الفوق
 
 اما قولهم ان كل موجودين فلابد ان يكون احدهما محايثا للاخر او مباينا عنه بجهة فلهم فيه طريقان الطريق الاولي ادعاء البديهة الا انه سبق الكلام علي هذه الطريقة في اول الكتاب الطريق الثاني انهم يستدلون عليه وهو الطريق الذي اختاره ابن الهيصم في المناظرة التي حكاها عن نفسه مع ابن فورك قال الرازي انا اذكر محصل تلك الكلمات علي
 
 الترتيب الصحيح من احسن وجه يمكن تقرير تلك الشبهة به وهو ان يقال لا شك ان كل موجودين في الشاهد فان احدهما لابد وان يكون محايثا للاخر او مباينا عنه بالجهة وكون كل موجودين في الشاهد كذلك اما ان يكون لخصوص كونه جوهرا او لخصوص كونه عرضا او لامر مشترك بين الجوهر والعرض وذلك المشترك اما الحدوث واما الوجود والكل باطل سوي الوجود فوجب ان تكون العلة لذلك الحكم هو الوجود والباري تعالي موجود فوجب الجزم بانه تعالي اما ان يكون محايثا للعالم او مباينا عنه بالجهة قال واعلم ان هذا الكلام لا يتم الا بتقرير مقدمات نحن نذكرها وتلك الوجوه التي يمكن ذكرها في تقرير تلك المقدمات اما المقدمة الاولي وهي قولنا ان كل موجودين في الشاهد فلابد وان يكون احدهما محايثا للاخر او مباينا عنه
 
 بالجهة لابد له من علة والدليل عليه هو ان المعدومات لا يصح فيها هذا الحكم وهذه الموجودات يصح فيها هذا الحكم فلولا امتياز ما صح فيه هذا الحكم عما لا يصح فيه هذا الحكم بامر من الامور والا لما كان هذا الامتياز واقعا واما المقدمة الثانية فهي في بيان ان هذا الحكم لا يمكن تعليله بخصوص كونه جوهرا ولا بخصوص كونه عرضا فالدليل عليه ان المقتضي لهذا الحكم لو كان هو كونه جوهرا لصدق علي الجوهر ان ينقسم الي ما يكون محايثا لغيره والي ما يكون مباينا عنه ومعلوم ان ذلك محال لان الجوهر يمتنع ان يكون محايثا لغيره وبهذا الطريق تبين ان المقتضي لهذا الحكم ليس كونه عرضا لامتناع ان يكون العرض مباينا لغيره بالجهة المقدمة الثالثة في بيان ان هذا الحكم غير معلل بالحدوث ويدل عليه وجوه الاول ان الحدوث عبارة عن وجود سبقه عدم والعدم غير داخل في العلة واذا سقط العدم عن درجة الاعتبار لم يبق
 
 الا الوجود والثاني وهو الذي عول عليه ابن الهيصم في المناظرة التي زعم انها دارت بينه وبين ابن فورك فقال لو كلن هذا الحكم معللا بالحدوث لكان الجاهل بكون السماء حادثة جاهلا بان السماء بالنسبة الي ساءر الموجودات التي في العالم اما ان تكون محايثة لها او مباينة عنها بالجهة لان المقتضي للحكم اذا كان امرا معينا فالجاهل بذلك المقتضي يجب ان يكون جاهلا بذلك الحكم الا تري الوجود لما كان هو المستدعي للتقسيم الي القديم والمحدث لا جرم كان اعتقاد انه غير موجود مانعا من التقسيم بالقدم والحدوث فلما كان التقسيم الي الاسود والابيض معلقا بكونه كان ملونا كان اعتقاد ان الشء غير ملون مانعا من اعتقاد التقسيم الي الاسود والابيض ولما راينا الدهري الذي يعتقد قدم السموات
 
 والارض لا يمنعه ذلك من اعتقاد ان السموات والارضين اما ان تكون محايثة واما ان تكون مباينة بالجهة علمنا ان هذا الحكم غير معلل بالحدوث الوجه الثالث في بيان ان المقتضي هذا الحكم ليس هو الحدوث وقد ذكره ابن الهيصم ايضا في تلك المناظرة وتقريره ان كونه محدثا وصف يعلم بالاستدلال وكونه بحيث يجب ان يكون اما محايثا او مباينا بالجهة حكم معلوم بالضرورة والوصف المعلوم الثبوت بالاستدلال لا يجوز ان يكون اصلا للحكم الذي يعلم ثبوته بالضرورة فثبت بهذه
 
 الوجوه ان المقتضي لهذا الحكم ليس هو الحدوث المقدمة الرابعة وهي في بيان انه لما كان المقتضي لهذا الحكم في الشاهد هو الوجود والباري موجود وكان المقتضي لكونه تعالي اما محايثا للعالم او مباينا عنه بالجهة حاصلا في حقه فكان هذا الحكم حاصلا هناك واعلم انا نفتقر في هذه المقدمة الي بيان ان الوجود حقيقة واحدة في الشاهد والغاءب وذلك يقتضي كون وجوده تعالي زاءدا علي حقيقته فانه ما لم يثبت هذا الاصل لم يحصل المقصود فهذا غاية ما يمكن ذكره في تقرير هذه الشبهة ومن نظر في تقريرنا لهذه الشبهة وتقريرهم لها علم ان التفاوت بينهما كبير قال والجواب ان مدار هذه الشبهة علي ان كل موجودين في الشاهد فلابد ان يكون احدهما محايثا للاخر او
 
 مباينا عنه بالجهة وهذه المقدمة ممنوعة وبيانه من وجوه الاول ان جمهور الفلاسفة يثبتون موجودات غير محايثة لهذا العالم الجسماني ولا مباينا عنه بالجهة وذلك لانهم يثبتون العقول والنفوس الفلكية والنفوس الناطقة
 
 ويثبتون الهيولي ويزعمون ان هذه الاشياء موجودات غير متحيزة
 
 ولا حالة في المتحيز فلا يصدق عليها انها محايثة لهذا العالم ولا مباينة عنه بالجهة وما لم يبطلوا هذا المذهب بالدليل لا يصح القول بان كل موجودين في الشاهد اما ان يكون احدهما محايثا للاخر او مباينا عنه الثاني ان جمهور المعتزلة يثبتون ارادات وكراهات موجودة لا في محل ويثبتون فناء لا في محل وتلك الاشياء لا يصدق عليها انها محايثة للعالم او مباينة عن العالم بالجهة فما لم يبطلوا ذلك لا تتم دعواهم الثالث انا نقيم الدليل علي ان الاضافات اعراض موجودات في الاعيان ثم نبين انها تمتنع ان تكون محايثة للعالم او مباينة عنه بالجهة وذلك يبطل كلامهم وانما قلنا ان
 
 الاضافات اعراض موجودات في الاعيان وذلك لان المعقول من كون الانسان ابا لغيره مغاير لذاته المخصوصة بدليل انه يمكن ان يعقل ذاته مع الذهول عن كونه ابا وابنا والمعلوم غير ما هو غير معلوم وايضا فانه يمكن ثبوت ذاته منفكة عن الابوة والبنوة مثل عيسي عليه السلام فانه ما كان ابا لاحد ولا ابنا لاحد من الذكور والثابت غير ما هو غير ثابت فكونه ابا وابنا مغايرا لذاته المخصوصة ثم هذا المغاير اما ان يكون وصفا سلبيا او ثبوتيا والاول باطل لان عدم الابوة هو الوصف السلبي والابوة رافعة له ورافع العدم الوجود فثبت ان
 
 الابوة وصف وجودي مغاير لذات الاب اذا ثبت هذا فنقول انه مستحيل ان يقال الابوة محايثة لذات الاب والا لزم ان يقال انه قاءم بنصف الاب نصف الابوة وبثلثه ثلث الابوة ومعلوم ان ذلك باطل ومحال ان يقال انها مباينة عن ذات الاب مباينة بالجهة والحيز والا لزم كون الابوة جوهرا قاءما بذاته مباينا عن ذات الاب بالجهة وذلك ايضا محال فثبت بهذا الدليل وجود موجود لا يمكن ان يقال انه محايث للعالم ولا ان يقال مباين عنه بالجهة واذا ثبت هذا بطل قولهم السءال الثاني سلمنا ان كل موجودين في الشاهد فلابد ان يكون احدهما محايثا للاخر او مباينا عنه بالجهة لكن كون الشء بحيث يصدق عليه قولنا اما ان يكون واما ان لا يكون اشارة الي كونه قابلا للانقسام اليهما لكن قبول القسمة حكم عدمي والعدم لا يعلل وانما قلنا ان قبول القسمة حكم عدمي لان اصل القبول حكم عدمي فوجب ان يكون قبول القسمة حكما عدميا وانما قلنا ان اصل القبول حكم عدمي لانه لو كان امرا ثابتا لكان صفة من صفات الشء المحكوم عليه
 
 بكونه قابلا والذات قابلة للصفة القاءمة بهاق يكون قبول ذلك القبول زاءدا عليه ولزم التسلسل وانما قلنا انه لما كان اصل القبول عدميا كان قبول القسمة ايضا كذلك لان القبول للقسمة قبول مخصوص فتلك الخصوصية ان كانت صفة موجودة لزم قيام الوجود بالعدم وهو محال وان كانت عدمية لزم القطع بان قبول القسمة عدمي واذا ثبت انه حكم عدمي امتنع تعليله لان العدم نفي محض فكان التاثير فيه محالا فثبت ان قبول القسمة لا يمكن تعليله السءال الثالث هب انه من الاحكام الوجودية فلم لا يجوز ان يكون معللا بخصوص كونه جوهرا او بخصوص كونه عرضا قوله لان كونه جوهريا يمنع من المحايثة وكونه عرضا بمنع من المباينة بالجهة وما كان علة لقبول الانقسام الي قسمين يمنع كونه مانعا من احد القسمين قلنا ما الذي تريدون بقولكم الوجود في الشاهد ينقسم الي المحايث والي المباين بالجهة ان اردتم ان الوجود في الشاهد قسمان
 
 احدهما ان يكون محايثا لغيره بالجهة وهو العرض والثاني ان يكون مباينا لغيره بالجهة وهو الجوهر وهذا مسلم لكنه في الحقيقة اشارة الي حكمين مختلفين معللين بعلتين مختلفتين فان عندنا وجوب كونه محايثا لغيره معلل بكونه عرضا ووجوب كون القسم الثاني مباينا عن غيره بالجهة معلل بكونه جوهرا فبطل قولكم ان خصوص كونه عرضا وجوهرا لا يصلحان لعلة هذا الحكم وان اردتم به ان امكان الانقسام الي هذين القسمين حكم واحد وانه ثابت في جميع الموجودات التي في الشاهد فهو باطل لان امكان الانقسام الي هذين القسمين لم يثبت في شء من الموجودات التي في الشاهد فضلا عن ان يثبت في جميعها لان كل موجود في الشاهد فهم اما جوهر واما عرض فان كان جوهرا امتنع ان يكون محايثا لغيره بالجهة فلم يكن قابلا لهذا الانقسام فثبت بما ذكرنا ان الذي قالوه مغالطة والحاصل ان هذا المستدل اوهم ان
 
 قوله الموجود في الشاهد اما ان يكون محايثا لغيره او يكون مباينا عنه بالجهة اشارة الي حكم واحد ثم بني عليه انه لا يمكن ان يعلل هذا الحكم بخصوص كونه جوهرا لا بخصوص كونه عرضا ونحن بينا انه اشارة الي حكمين مختلفين معللين بعلتين مختلفتين السءال الرابع سلمنا انه لا يمكن تعليل هذا الحكم بخصوص كونه جوهرا ولا بخصوص كونه عرضا فلم قلتم انه لابد من تعليله اما بالحدوث واما بالوجود وما الدليل علي هذا الحصر اقصي ما في الباب ان يقال سبرنا وبحثنا فلم نجد قسما اخر الا انا بينا في الكتب المطولة ان عدم الوجدان لا يدل علي عدم الوجود وشرحنا ان هذا السءال هادم لكل دليل مبني علي تقسيمات منتشرة غير محصورة بين النفي والاثبات
 
 السءال الخامس سلمنا ان عدم الوجدان يدل علي عدم الوجود لكن لا نسلم قولكم انا ما وجدنا لهذا الحكم علة سوي الحدوث والوجود بيانه من وجهين احدهما ان من المحتمل ان يقال المقتضي لقولنا ان الشء اما ان يكون محايثا للعالم او مباينا عنه هو كونه بحيث تصح الاشارة الحسية اليه وذلك لان كل شيءين تصح الاشارة الحسية اليهما فاما ان تكون الاشارة الي احدهما عين الاشارة الي الاخر وذلك كما في اللون والمتلون وهذا هو المحايثة واما ان تكون الاشارة الي احدهما غير الاشارة الي الاخر وهذا هو المباينة بالجهة فثبت ان المقتضي لقبول هذه القسمة هو كون الشء مشارا اليه بحسب الحس وعلي هذا التقدير ما لم يقيموا الدلالة علي انه تعالي مشار اليه بحسب الحس لا يمكن ان يقال انه يجب ان يكون محايثا للعالم او مباينا عنه بالجهة لكن كونه تعالي مشارا اليه بحسب الحس وهو مما وقع النزاع فيه وحينءذ يتوقف صحة الدليل علي صحة
 
 المطلوب وذلك يفضي الي الدور وهو باطل الثاني لاشك ان ما سوي الله تعالي اما ان يكون محايثا لغيره او مباينا عن غيره بالجهة ولا شك ان الله تعالي مخالف لهذين القسمين بحقيقته المخصوصة اذ لو لم يكن مخالفا لهما بحقيقته المخصوصة لكان مثلا للجواهر والاعراض ويلزم منه كونه تعالي محدثا كما ان الاعراض والجواهر محدثة وذلك محال واذا ثبت هذا فنقول ان الجواهر والاعراض يشتركان في الامر الذي وقعت به المخالفة
 
 بينهما وبين ذات الباري فلم لا يجوز ان يكون المقتضي لقبول الانقسام الي المحايث والي المباين هو ذلك الامر وعلي هذا التقدير سقط هذا السءال لانه لا مشترك بين الجواهر والاعراض الا الحدوث السءال السادس سلمنا الحصر فلم لا يجوز ان يكون المقتضي لهذا الحكم هو الحدوث قوله اولا الحدوث ماهية مركبة من العدم والوجود قلنا كل محدث فانه يصدق عليه كونه قابلا للعدم والوجود وايضا كون الشء منقسما الي المحايث والمباين معناه كونه قابلا للانقسام الي هذين القسمين فالقابلية ان كانت صفة وجودية كانت في الموضعين كذلك وان كانت عدمية فكذلك ولا يبعد تعليل عدم بعدم اما قوله ثانيا لو كان المقتضي لهذا الحكم هو الحدوث لكان الجهل بحدوث الشء يوجب الجهل بهذا الحكم قلنا الكلام عليه من وجهين الاول لم قلتم ان الجهل بالمءثر يوجب الجهل بالاثر الا تري ان جهل الانسان باسباب المرض والصحة وجهل نفاة الاعراض بالمعاني الموجبة لتغير احوال الاجسام لا يوجب جهلهم بتلك التغيرات وجهل الدهري بكونه تعالي قادرا علي الخلق والتكوين لا يوجب
 
 جهله بوجود هذا العالم الثاني لوكان الجهل بالعلة يوجب الجهل بالمعلول لكان العلم بالعلة يوجب العلم بالمعلول وعلي هذا التقدير لو كان المقتضي لكون الموجودين في الشاهد اما متحايثين او متباينين بالجهة هو الوجود لزم ان من علم كون الشء موجودا ان يعلم وجوب كونه محايثا للعالم او مباينا له لكن الجمهور الاعظم وهم اهل التوحيد يعتقدون انه تعالي موجود ولا يعلمون انه تعالي لابد وان يكون اما محايثا للعالم او مباينا له فوجب علي هذا المساق ان لا يكون المقتضي لهذا الحكم هو كونه موجودا وهذا السءال قد اورده الاستاذ ابن فورك من اصحابنا علي ابن الهيصم ولم يقدر ان يذكر عنه جوابا سوي ان قال يمتنع ان يحصل العلم بالاثر مع الجهل بالمءثر وطال كلامه في تقرير هذا الفرق ولم يظهر منه شء معلوم يمكن حكايته قوله ثالثا كونه محدثا وصف استدلالي وكونه اما
 
 محايثا او مباينا امر معلوم بالبديهة والوصف الاستدلالي لا يجوز ان يكون علة للحكم المعلوم بالبديهة قلنا ممنوع فانا بينا ان المءثر في كثير من الاشياء استدلالي والاثر بديهي السءال السابع سلمنا ان المءثر في هذا الحكم ليس هو الحدوث وانه هو الوجود لكن لم قلتم انه يلزم حصوله في حق الله تعالي وبيانه ان المطلوب انما يلزم لوكان الوجود امرا واحدا في الشاهد والغاءب اما اذا لم يكن الامر كذلك بل كان وقوع لفظ الوجود علي الشاهد والغاءب ليس الا بالاشراك اللفظي كان هذا الدليل ساقطا بالكلية ثم ان الكرامية لا يمكنهم ان يقولوا بان الوجود في
 
 الغاءب الشاهد واحد اذ لو كان كذلك لزمهم اما القول بكون الباري تعالي مثلا للمحدثات من جميع الوجوه او القول بان وجوده زاءد علي ماهيته والقوم لا يقولون بهذا الكلام السءال الثامن سلمنا ان ما ذكرتم يدل علي ان الوجود هو العلة لهذا الحكم لكن هاهنا دليل اخر يمنع منه وهو ان المقتضي لقبول الانقسام في الجوهر والعرض لو كان هو الوجود لزم في الجوهر وحده ان يقبل الانقسام الي الجوهر والعرض وانه محال ولزم ايضا في العرض وحده ان يقبل الانقسام الي الجوهر والعرض ومعلوم ان ذلك محال فان قالوا ان كل جوهر وعرض فانه يصح كونه منقسما الي هذين القسمين نظرا الي كونه موجودا وانما يمتنع ذلك الانقسام نظرا الي مانع منفك وهو خصوصية ماهيته قلنا هذا اعتراف بانه لا يلزم من كونه الوجود علة لصحة امر من الامور ان يصح ذلك الحكم علي كل ما كان موصوفا بالوجود لاحتمال ان
 
 تكون ماهيته المخصوصة مانعة من ذلك الحكم واذا كان كذلك فلم لا يجوز ان يقال الوجود وان اقتضي كون الشء اما محايثا لغيره او مباينا عنه الا ان خصوصية ذاته تعالي كانت مانعة من هذا الحكم فلم يلزم من كونه تعالي موجودا كونه بحيث يكون اما محايثا للعالم او مباينا عنه بالجهة السءال التاسع ان ما ذكرتموه من الدليل قاءم في صور كثيرة مع ان النتيجة اللازمة عنه باطلة قطعا وذلك يدل علي ان هذا الدليل منقوض وبيانه من وجوه الاول ان كل ما سوي الله فهو محدث فتكون صحة الحدوث حكما مشتركا بينهما فنقول هذه الصحة حكم مشترك فلابد لها من علة مشتركة والمشترك اما الحدوث او الوجود ولا يمكن ان يكون المقتضي لصحة الحدوث هو الحدوث لان صحة الحدوث سابقة علي الحدوث بالرتبة والسابق بالرتبة علي الشء لا يمكن تعليله بالمتاخر عن الشء فثبت ان صحة الحدوث غير معللة بالحدوث فوجب كونها معللة بالوجود والله تعالي موجود فوجب ان يثبت في حقه صحة الحدوث وهو محال الثاني ان كل موجود في الشاهد فهو اما حجم او قاءم
 
 بالحجم ثم يذكر التقسيم الي اخره حتي يكون الباري تعالي اما حجما او قاءما بالحجم والقوم لا يقولون به الثالث ان كل موجودين في الشاهد فلابد وان يكون احدهما محايثا للاخر او مباينا عنه في اي جهة كان ثم يذكر التقسيم المتقدم حتي يظهر ان هذا الحكم معلل بالوجود والباري تعالي موجود فوجب ان يصح علي الباري كونه محايثا للعالم او مباينا عنه في اي جهة كان من الجوانب التي للعالم وذلك يقتضي ان لا يكون اختصاص الله بجهة فوق بل يلزم صحة الحركة علي ذات الله تعالي من الفوق الي السفل وكل ذلك عند القوم محال الرابع ان كل موجودين في الشاهد فانه يجب ان يكون احدهما محايثا للاخر او مباينا عنه بالجهة والمباين بالجهة لابد وان يكون جوهرا فردا او يكون مركبا من الجواهر وكون كل
 
 موجودين في الشاهد علي احد هذه الاقسام الثلاثة اعني كونه عرضا او جوهرا فردا او جسما مءتلفا لابد وان يكون معللا بالوجود فوجب ان يكون الباري تعالي علي احد هذه الاقسام الثلاثة والقوم ينكرون ذلك لانه تعالي عندهم ليس بغرض ولا بجوهر ولا بجسم مءتلف مركب من الاجزاء والابعاض الخامس ان كل موجود يفرض مع العالم فهو اما ان يكون مساويا للعالم او زاءدا عليه في المقدار او انقص منه في المقدار وانقسام الوجود في الشاهد الي هذه الاقسام الثلاثة حكم لابد له من علة ولا علة الا بالوجود والباري تعالي موجود فوجب ان يكون الباري تعالي علي احد هذه الاقسام الثلاثة والقوم لا يقولون به فثبت بما ذكرنا ان هذه الشبهة منقوضة قال واعلم انا انما طولنا في الكلام علي هذه الشبهة لان القوم يعولون عليها ويظنون انها حجة قاهرة ونحن بعد ان بالغنا في تنقيحها وتقريرها اوردنا عليها هذه الاسولة
 
 القاهرة والاعتراضات القادحة ونسال الله تعالي ان يجعل هذه التحقيقات والتدقيقات سببا لمزيد الاجر والثواب بمنه وفضله اه قلت والكلام علي هذا مع العلم بان المقصود ذكر القول الفصل والحكم العادل فيما يذكره النفاة من الحجج والجواب عما ذكره من جهة منازعيه ليس المقصود استيفاء حجج المثبتة بل اذا تبين ان هذا الذي هو الامام المطلق في المتاخرين من هءلاء النفاة المتكلمين والفلاسفة وعرف فرط معاداته لهءلاء المثبتة الذين ذكرهم وذكر حججهم مع ما هم عليه من ضعف الحجج وقلة المعرفة بالسنن ومذاهب السلف ومع ما فيهم من الانحراف ثم تبين ظهور حججهم العقلية التي ذكرها مع السمعية علي ما استوفاه من حجج النفاة العقلية والسمعية مع استعانته بكل من هو من النفاة حتي المشركين الصابءين مثل ارسطو وابي معشر وشيعتهما من الفلاسفة
 
 والمنجمين والمعتزلة وغيرهم ومع انه لم يبق ممكنا فيما فيه شبهة حجة عرف من الحق ما يهدي به الله من يشاء من عباده والعاقبة للمتقين ولا حول ولا قوة الا بالله وقد ذكر ان لهم طريقين علي ان كل موجودين فلابد وان يكون احدهما محايثا للاخر او مباينا له احدهما ادعاء البديهة وقد ذكر انه سبق الكلام في ذلك فاحال علي ما تقدم وقد قدمنا القول علي ما ذكره هناك في مقدمة كتابه مما يبين الحق لمن له ادني نظر ولاحول ولا قوة الا بالله وما ذكره هنا من حكاية كلام ابن الهيصم في مناظرته لابن فورك لم يبلغنا علي الوجه المفصل لكن ذكر بعض المصنفين من النفاة ايضا انهما تناظرا بحضرة ولي السلطان محمود بن
 
 سبكتكين وكان من احسن ملوك اهل المشرق اسلاما وعقلا ودينا وجهادا وملكا في اخر الماءة الرابعة وكانت ملوك في خلافة القادر وكانت قد انتشرت اذ ذاك دعوة الملاحدة المنافقين الذين كانوا اذ ذاك بمصر وفد بنوا القاهرة وغيرها ولهم دعاة من اقاصي الارض بالمشرق وغيره وكان والد ابن
 
 سينا منهم وقال ابن سينا وبسبب ذلك اشتغلت في علوم الاواءل وكان بعض المشرق وكثير من جنده يميل اليهم وفي ذلك الوقت صنف الناس الكتب في كشف اسرارهم وهتك استارهم مثل الكتاب الذي صنفه القاضي ابو بكر
 
 الباقلاني وغيره وقد صنف مثل ذلك وبعضه كتب اخر وانماالمقصود التنبيه علي ما يتعلق بما نحن فيه وكان هذا مما دعا القادر الي اظهار السنة وقمع اهل البدع فكتب الاعتقاد القادري المنسوب اليه وهو في الاصل من جمع الشيخ ابي احمد القصاب وهو من اجل المشايخ
 
 واعلمهم وله لسان صدق عظيم وامر القادر باستتابة من خالف ذلك من المعتزلة وغيرهم وقام الشيخ ابوحامد الاسفراييني امام الشافعية والشيخ ابو عبد الله بن حامد امام الحنابلة علي
 
 ابن الباقلاني بسبب ما ينسب اليه من بدعة الاشعري وجبت امور بلغتنا مجملة غير مفصلة وصنف ابن الباقلاني كتابه المعروف في الرد علي من ينسب الي الاشعري خلاف قوله واعتمد السلطان محمود بن سبكتكين في مملكته نحو هذا وزاد عليه بان امر بلعنة اهل البدع علي المنابر فلعنت الجهمية والرافضة والحرورية والمعتزلة والقدرية ولعنت ايضا الاشعرية حتي جري بسبب ذلك نزاع وفتنة بين الشافعية
 
 والحنفية وغيرهم قوم يقولون هم من اهل البدع فيلعنون وقوم يقولون ليسوا من اهل البدع فلا يلعنون وجرت لابن فورك محنة باصبهان وجرت له مناظرة مع ابن الهيصم بحضرة هذا السلطان محمود وكان يحب الاسلام والسنة مستنصرا بالاسلام عارفا به غزا المشركين من اهل الهند وفتح الهند وروي انه قتل عشرة الاف زنديق فكان مما حكاه ميمون النسفي الحنفي في
 
 كتابه وهو من نفاة العلو ان السلطان فهم كلام الطاءفتين وفهم ما ذكرته المثبتة من ان اقوال النفاة توجب تعطيله وانهم قالوا لو اردنا ان نصف المعدوم لم نصفه الا بهذه الصفة بانه لا داخل العالم ولا خارجه او كلاما هذا معناه وابن فورك عجز عن جواب هذا حتي كتب فيه علي ابي اسحاق الاسفراييني وان الاسفراييني لم يجب ايضا بما يدفع به ذلك
 
 الا ان قال يلزم من الاثبات ان يكون جسما او نحو هذا مع ان المعروف عن ابي بكر بن فورك هو ما عليه الاشعري واءمة اصحابه من اثبات ان الله فوق العرش كما ذكر ذلك في غير موضع من كتبه وحكاه عن الاشعري وابن كلاب وارتضاه وذكر البيهقي عنه في كتاب الصفات انه قال استوي بمعني علا وقال في قوله اامنتم من في السماء [الملك ]
 
 اي من فوق السماء واحتج البيهقي لذلك بقول النبي صلي الله عليه وسلم لسعد بن معاذ حين حكم في بني قريظة لقد حكمت فيهم
 
 بحكم الله الذي حكم به فوق سبع سموات وبقول ابن عباس ان بين السماء السابعة الي كرسيه سبعة الاف نور وهو فوق ذلك
 
 وابو بكر محمد بن الحسن الحضرمي القيرواني الذي له
 
 الرسالة التي سماها برسالة الايماء الي مسالة الاستواء لما ذكر اختلاف المتاخرين في الاستواء وذكر اقوالا متعددة قول الطبري ابي جعفر محمد بن جرير صاحب التفسير وابي محمد بن ابي زيد والقاضي
 
 عبد الوهاب وجماعة من شيوخ الحديث والفقه قال وهو ظاهر بعض كتب القاضي ابي بكر وابي الحسن يعني الاشعري وحكاه عنه اعني القاضي ابي بكر والقاضي عبد الوهاب نصا وهو انه سبحانه وتعالي مستو علي عرشه بذاته قال واطلقوا القول في بعض الاماكن فوق عرشه قال ابو بكر الحضرمي وهو الصحيح الذي اقول به من غير تحديد ولا تمكن في مكان ولا كون فيه ولا مماسة
 
 قال ابو عبد الله القرطبي صاحب التفسير الكبير في كتاب شرح الاسماء الحسني بعد ان حكي كلام الحضرمي هذا قول القاضي ابي بكر في كتاب تمهيد الاواءل له وقاله الاستاذ ابن فورك في شرح اواءل الادلة وهو قول ابي عمربن عبد البر
 
 والطلمنكي وغيرهما من الاندلسيين وقول الخطابي في شعار الدين ثم قال بعد ان ذكر في الاستواء اربعة عشر
 
 قولا واظهر الاقوال ما تظاهرت عليه الاي والاخبار والفضلاء الاخيار ان الله علي عرشه كما اخبر في كتابه وعلي لسان نبيه بلا كيف باءن من جميع خلقه هذا مذهب السلف الصالح فيما نقل عنهم الثقاة ونقل ابو بكر بن فورك في كتاب مقالة ابي محمد عبد الله بن سعيد بن كلاب وموافقته الاشعري وما بينهما من النزاع اليسير او اللفظي فقال الفصل الاول في ذكر ما حكي شيخنا ابو الحسن رضي الله عنه في كتاب المقالات من جمل مذاهب اصحاب الحديث وابان ما ابان في اخره انه يقول بجميع ذلك ثم سرد ابن فورك المقالة التي تقدم ذكرنا لها من كلام الاشعري بعينها وما قيها من ذكر العرش واستواء الله عليه والصفات الخبرية وغير ذلك كما تقدم ثم قال في اخرها فهذا يحقق لك من الفاظه انه يعتقد لهذه الاصول التي هي قواعد اصحاب الحديث واساس توحيدهم ولا ريب ان هذا قول الاشعرية المتقدمين واءمتهم كلهم
 
 ما علمت بينهم في ذلك نزاعا وانما انكر ذلك من انكره من متاخريهم وجميع كتب الاشعري تنطق بذلك كما ذكرناه فيما تقدم من كتبه وفيما لم يصل الينا مما يحيل هو عليه مثل ما ذكره ابو القاسم بن عساكر في تبيين كذب المفتري فيما نسب الي ابي الحسن الاشعري بعد ان قال فلا بد ان نحكي عنه معتقده علي وجهه بالامانة ليعلم حاله في صحة عقيدته في الديانة فاسمع ما ذكره في الابانة فانه قال الحمد لله الواحد العزيز الماجد المتفرد بالتوحيد المتمجد بالتمجيد الذي لا تبلغه صفات العبيد وليس له مثل ولا نديد وذكر تمام الخطبة الي ان قال فان قال قاءل قد انكرتم قول المعتزلة والقدرية والجهمية والحرورية والرافضة والمرجءة فعرفونا
 
 قولكم الذي به تقولون وديانتكم التي بها تدينون قيل له قولنا الذي نقول به وديانتنا التي بها ندين التمسك بكتاب الله وسنة نبيه صلي الله عليه وسلم وما روي عن الصحابة والتابعين واءمة الحديث ونحن بذلك معتصمون وبما كان عليه الامام احمد بن حنبل نضر الله وجهه قاءلون ولمن خالف قوله مخالفون لانه الامام الفاضل والرءيس الكامل الذي ابان الله به الحق عند ظهور الضلال واوضح به المنهاج وقمع به بدع المبتدعين وزيغ الزاءغين وشك الشاكين فرحمة الله عليه من امام مقدم وكبير مفهم وعلي جميع اءمة المسلمين وذكر تمام الاعتقاد كما ذكرناه عنه فيما تقدم لما ذكر ما ذكره الاشعري في الابانة ثم قال ابن عساكر بعد ان فرغ من سياق ذلك فتاملوا رحمكم الله هذا الاعتقاد ما اوضحه وابينه واعترفوا بفضل هذا الامام الذي شرحه وبينه قال الحافظ ابن عساكر قال ابو الحسن في كتابه الذي سماه العمد في الرءية الفنا كتابا كبيرا في الصفات تكلمنا
 
 فيه علي اصناف المعتزلة والجهمية في فنون كثيرة من الصفات في اثبات الوجه لله واليدين وفي استواءه علي العرش ولشهرة هذا من مذهب الاشعري قال ابوالحسن علي بن مهدي الطبري المتكلم صاحب ابي الحسن الاشعري في كتابه الذي الفه في مشكل الايات في باب قوله الرحمن علي العرش استوي {} [طه ] اعلم ان الله سبحانه وتعالي في السماء فوق كل شء علي عرشه بمعني انه عال عليه ومعني الاستواء الاعتلاء كما تقول العرب استويت علي ظهر الدابة واستويت علي السطح بمعني علوته واستوي الشمس علي راسي واستوي الطير علي قمة راسي بمعني علا في الجو فوجد فوق راسي فالقديم جل جلاله عال علي عرشه قوله اامنتم من في السماء [الملك ] وقوله يا عيسي اني متوفيك ورافعك الي [ال عمران ] وقوله اليه يصعد الكلم الطيب
 
 [فاطر ] وقوله يدبر الامر من السماء الي الارض ثم يعرج اليه [السجدة ] قال وزعم البلخي ان استواء الله علي العرش هو الاستيلاء عليه ماخوذ من قول العرب استوي بشر علي العراق استولي عليها وقال ان العرش يكون الملك
 
 فيقال ما انكرت ان يكون عرش الله جسما خلقه وامر ملاءكته بحمله قال ويحمل عرش ربك فوقهم يومءذ ثمانية {} [الحاقة ] وامية يقول مجدوا الله فهو للمجد اهل ربنا في السماء امسي كبيرا بالبناء الاعلي الذي سبق الناس وسوي فوق السماء سريرا قال ومما يدل علي ان الاستواء هاهنا ليس بالاستيلاء لانه لو كان كذلك لم ينبغ ان يخص العرش بالاستيلاء عليه دون ساءر خلقه اذ هو مستول علي العرش وعلي ساءر خلقه وليس للعرش مزية علي ما وصفته فبان بذلك فساد قوله ثم يقال له ايضا ان الاستواء ليس هو الاستيلاء الذي من قول العرب استوي فلان علي كذا اي استولي اذا تمكن فيه بعد ان لم يكن متمكنا فلما كان الباري لا يوصف بالتمكن بعد
 
 ان لم يكن متمكنا لم يصرف معني الاستواء الي الاستيلاء ثم قال حدثنا ابو عبد الله نفطويه ثنا ابوسليمان قال كنا عند ابن الاعرابي فاتاه رجل فقال ما معني
 
 الرحمن علي العرش استوي {} [طه ] قال هو علي عرشه كما اخبر فقال ليس هو كذلك انما معناه استولي قال ابن الاعرابي اسكت ما يدريك ما هذا العرب لا تقول للرجل استولي علي الشء حتي يكون له فيه مضاد فايهما غلب قيل استولي عليه والله لا مضاد له وهو علي عرشه كما اخبر
 
 قال ابو الحسن بن مهدي الطبري فان قيل فما تقولون في قوله اامنتم من في السماء [الملك ] قيل له معني ذلك انه فوق السماء علي العرش كما قال فسيحوا في الارض [التوبة ] بمعني علي الارض وقال ولاصلبنكم في جذوع النخل [طه ] اي علي جذوع النخل فكذلك قوله اامنتم من في السماء قال فان قيل فما تقولون في قوله تعالي وهو الله في السماوات وفي الارض يعلم سركم وجهركم [الانعام ] قيل له ان بعض القراء يجعل الوقف في السماوات ثم يبتدي وفي الارض يعلم سركم وجهركم وكيفما كان فلو ان قاءلا قال فلان بالشام والعراق ملك لدل علي الملك بالشام والعراق لا ان ذاته فيهما قال فان قيل ما تقول في قوله ما يكون من نجوي ثلاثة الا هو رابعهم [المجادلة ] الاية قيل له كون
 
 الشء مع الشء علي وجوه منها بالنصر ومنها بالصحبة ومنها بالمماسة ومنها بالعلم فمعني هذا عندنا ان الله تعالي مع كل الخلق بالعلم قال قال البلخي فان قيل لنا ما معني رفع ايدينا الي السماء وقوله والعمل الصالح يرفعه [فاطر ] قلنا تاويل ذلك ارزاق العباد لما كانت تاتي من السماء جاز ان نرفع ايدينا الي السماء عند الدعاء وجاز ان يقال اعمالنا ترفع الي الله لما كان حفظة الاعمال انما مساكنهم في السماء قيل له ان كانت العلة في رفع ايدينا الي السماء ان الارزاق فيها
 
 وان الحفظة مساكنهم في السماء جاز ان نخفض ايدينا في الدعاء نحو الارض من اجل ان الله يحدث فيها النبات والاقوات المعاش وانها قرارهم ومنها خلقوا او لان الملاءكة معهم في الارض فلم تكن العلة في السماء بما وصفه وانما امرنا الله تعالي برفع ايدينا قاصدين اليه لرفعها نحو العرش الذي هو مستو عليه فاذا كان ابن فورك وساءر اءمة الاشعرية موافقين الكرامية وغيرهم علي ان الله عز وجل نفسه فوق العرش وهم جميعا متفقون علي مخالفة المعتزلة الذين ينفون ذلك ويتاولون الاستواء بمعني الاستيلاء ونحو ذلك وهم جميعا متفقون علي الاستدلال علي ان الله فوق العالم بالايات التي ذكرها هذا الرازي من ناحية مخالفيه مثل قوله اليه يصعد الكلم الطيب والعمل الصالح يرفعه [فاطر ] وقوله يا عيسي اني متوفيك ورافعك الي ومطهرك [ال عمران ] وقوله اامنتم من في السماء ان يخسف بكم الارض [الملك ] ومثل ذلك في الايات كما ذكرنا بعض ذلك وقد تنازع ابن فورك واصحابه مع ابن الهيصم واصحابه فاما
 
 ان يكون نزاعهم لفظيا او معنويا فان كان لفظيا لم يكن ذلك منافيا لاتفاقهم من جهة المعني وان كانت المعاني متفقة لم يضر اختلاف الالفاظ الا اذا كان منهيا عنها في الشريعة وان كان النزاع معنويا فهو ايضا قسمان احدهما اختلاف تنوع بان يكون هءلاء يثبتون شيءا لا ينفيه هءلاء وهءلاء ينفون شيءا لا يثبته هءلاء فهذا ايضا ليس باختلاف معلوم الا اذا كان كل منهما يدفع ما يقوله الاخر من الحق فاذا كان احدهما يثبت حقا والاخر ينفي باطلا كان علي كل منهما ان يوافق الاخر واذا اختلفا كانا جميعا مذمومين وهذا من الاختلاف الذي ذمه الله تعالي في كتابه حيث قال سبحانه وتعالي وان الذين اختلفوا في الكتاب لفي شقاق بعيد {} [البقرة ] وقال ولا تكونوا كالذين تفرقوا واختلفوا من بعد ما جاءهم البينات [ال عمران ] وامثال ذلك وان كانا قد تنازعا حقيقيا هما فيه متناقضان علي حقيقة التناقض بحيث ان يكون احدهما ينفي ما اثبته الاخر فهذا بعد اتفاقهم علي اثبات انه فوق العرش فوق العالم ومخالفتهم جميعا للمعتزلة الذين سلك هذا الرازي وامثاله مسلكهم في كتابه هذا التاسيس انما يكون بان يقول المثبت كونه فوق
 
 العرش يستلزم ان يكون في جهة او يكون متحيزا او ان يكون منقسما ونحو ذلك ويقول الثاني كونه علي العرش لا يستلزم ذلك بل يجوز ان يكون علي العرش ولا يكون جسما وهذا الثاني قول الاشعرية فالخلاف بينهم وبين الاشعرية انه اذا كان علي العرش هل يستلزم ذلك ان يكون جسما او لا يستلزم ذلك فان كان هذا هو الخلاف المحقق بين ابن فورك واصحابه وبين ابن الهيصم واصحابه فاما ان يكون الصواب مع ابن فورك او مع ابن الهيصم فان كان الصواب مع ابن فورك ثبت حينءذ انه اذا كان علي العرش لم يستلزم ذلك ان يكون جسما ولا يكون مركبا ولا منقسما ولا غير ذلك واذا صح هذا بطل ما ذكره هذا المءسس وامثاله من ان كونه فوق العرش يستلزم التجسيم وحينءذ فيبطل جميع ما ذكره من الحجج في هذا الكتاب علي ابطال كونه علي العرش واذا اقر بانه فوق العرش فهو اعظم المقصود وحينءذ يكون كلامه من جنس الاشعرية الاكابر
 
 المتقدمين وان كان الصواب مع ابن الهيصم وهو ان كونه فوق العرش يستلزم ان يكون جسما وهذا هو الذي يقوله هذا المءسس وامثاله من الاشعرية المتاخرين وهو الذي يقوله المعتزلة والفلاسفة والجهمية وامثالهم فيكون هذا المءسس وهءلاء كلهم متفقون علي ان الصواب في المناظرة كان لابن الهيصم دون ابن فورك ومعلوم ان اهل الاثبات الذين يقولون هو علي العرش ولا يتكلمون في الجسم بنفي ولا اثبات لا ينفون هذا الكلام ايضا وان خالفهم بعضهم لفظا فيها ولا ينازع في ذلك نزاعا معنويا فيكون جماهير الخلاءق من مثبتة الصفات ونفاتها مع ابن الهيصم فقد ظهر بما ذكره ان تصويب ابن فورك ومتقدمي الاشعرية يقتضي تخطءة الرازي ومتاخري الاشعرية الذين خالفوا متقدميهم في قولهم ان الله ليس علي العرش وان تصويب ابن الهيصم وتخطءة ابن فورك هو اولي بتخطءة هءلاء المتاخرين النفاة لكونه علي العرش واذا كان كذلك ثبت خطا هذا الرازي وذويه سواء كان المصيب هو ابن فورك او هو ابن الهيصم وثبت اتفاق الطاءفتين المتقدمتين من الاشعرية
 
 والكرامية علي خطا هءلاء المتاخرين من الاشعرية الموافقين للمعتزلة في نفي ان يكون الله فوق العرش وهذا هو المقصود الاكبر فيما ذكرناه وايضا فهذا الرازي وذووه يقولون هم وغيرهم ان العلم بان كونه علي العرش يستلزم ان يكون متحيزا او ان يكون جسما علم ضروري واذا كان كذلك كانوا مقرين بان الكرامية اصوب من شيوخهم المتقدمين وان ذلك معلوم بالاضطرار واذا كان كذلك ثبت ان قول الكرامية هو الصواب دون قولهم وقول شيوخهم المتقدمين وذلك ايضا يستلزم ان يكون الله فوق العرش وهذا يبين ان ما تنازع فيه متقدمو الاشعرية ومتاخروهم ثبت به خطا احدي الطاءفتين منهم ولم يثبت خطا الكرامية في قولهم ان الله فوق العرش فانه ان كان الصواب مع متقدميهم فهم والكرامية متفقون علي ان الله فوق العرش وان كانت الكرامية مخطءة علي هذا التقدير في قولهم هو جسم فهذا لا يضر وان كان الصواب مع متاخريهم ان كونه علي العرش يستلزم التجسيم فهم والمتقدمون من الاشعرية متفقون علي ان الله تعالي فوق العرش فيكون التجسيم حينءذ لازما للطاءفتين جميعا فلا تكون احداهما مصيبة والاخري مخطءة واذا ثبت خطا احدي طاءفتي الاشعرية تيقنا بالاتفاق ان
 
 الصواب مع اما مثبتو العلو واما الملازمون بين العلو والجسم ولم يثبت خطا الكرامية المنازعين لهم في قولهم انه علي العرش لا علي قول الاولين المثبتين العلو ولا علي قول الاخرين الملازمين بين العلو والجسم ظهر ان الكرامية المنازعين الاشعرية في مسالة العلو والجسم اقرب الي الصواب منهم فان من ظهر خطءه علي كل تقدير اولي بالخطا ممن لم يظهر خطءه في المسالة الواحدة وهي المقصودة الكبري علي التقديرين جميعا وخطءه في المسالة الاخري وهي مسالة الجسم انما يظهر علي احدي التقديرين فقط وهذا بين ظاهر فان الاشعرية قد ثبت لزوم الخطا لهم بالضرورة اما لاوليهم واما لاخريهم اذا كان النزاع معنويا تضادا كما تقدم واما الكرامية فهم في مسالة كونه علي العرش لم يظهر خطءهم علي التقديرين جميعا وفي مسالة الجسم انما يكونون مخطءين علي قول الاولين فقط اذ الاخرون من الاشعرية يوافقونهم علي ان العلو يستلزم التجسيم وظهر بذلك ان كل ما تنازع فيه هءلاء لم يظهر فيه نفي ان يكون الله علي العرش وذلك لان هذا هو الحق الذي جاء به الرسول صلي الله عليه وسلم وهو القاءل سبحانه وتعالي هو الذي ارسل رسوله بالهدي ودين الحق ليظهره علي الدين كله [الصف ] الاية ودين الحق الذي بعث به رسوله ظاهر علي كل تقدير
 
 وايضا فان هذا معلوم بالفطرة والبديهة وقد ظهر بذلك ان متقدمي الاشعرية واءمتهم هم اولي بالحق والصواب من متاخريهم وان كان فو قولهم ما يذكر انه خطا فالخطا الذي مع المستاخرين اعظم واكثر وهذا لان الكلام الذي فيه بدعة كلما كان اقرب الي الفطرة والشرعة كان اقرب الي الهدي ودين الحق وكلما بعدت البدعة عن ذلك تغلظت وهذا مما يبين ان فطر الناس وبداءههم ممن ليس به هوي ولا تقليد سواء كان في الامراء او الملوك او غيرهم فانهم يعرفون بفطرتهم وبديهة عقولهم ان ما ذكره من انه لا داخل العالم ولا خارجه انما هو صفة المعدوم وان الموجودين لابد ان يكون احدهما قاءما بالاخر محايثا له اي يكون حيث هو يكون او يكون مباينا له منفصلا عنه في جهة غير جهته وما زال اءمة السنة يذكرون هذا مثل ما ذكره عبد العزيز الكناني صاحب الشافعي صاحب الحيدة المشهور بالرد
 
 علي الجهمية والقدرية وغيرهم قال في رده علي الجهمية باب قول الجهمي في قول الله عز وجل الرحمن علي العرش استوي {} [طه ] زعمت الجهمية انما قول الله الرحمن علي العرش استوي {} انما المعني استولي كقول العرب استوي فلان علي مصر استوي فلان علي الشام يريد استولي عليها باب البيان لذلك يقال له هل يكون خلق من خلق الله اتت عليه مدة ليس الله بمستول عليه فاذا قال لا قيل له فمن زعم ذلك فهو كافر ويقال له يلزمك ان تقول ان العرش قد اتت عليه مدة ليس الله بمستول عليه وذلك ان الله اخبر انه خلق العرش بل خلق السموات والارض قال الله تعالي وهو الذي خلق السماوات والارض في ستة ايام وكان عرشه علي الماء [هود ] فاخبر
 
 ان العرش كان علي الماء قبل خلق السموات والارض ثم قال الذي خلق السماوات والارض وما بينهما في ستة ايام ثم استوي علي العرش الرحمن فاسال به خبيرا {} [الفرقان ] وقوله الذين يحملون العرش ومن حوله يسبحون بحمد ربهم [غافر ] وقوله عز وجل ثم استوي الي السماء وهي دخان [فصلت ] وقوله عز وجل ثم استوي الي السماء فسواهن سبع سماوات [البقرة ] فاخبر انه استوي علي العرش فيلزمك ان تقول المدة التي كان العرش فيها قبل خلق السموات والارض ليس الله بمستول عليه اذا كان استوي علي معناه عندك استولي فانما استولي بزعمه في ذلك الوقت لا قبل قال وقد روي عمران بن الحصين عن النبي صلي الله عليه وسلم انه قال اقبلوا البشري يا بني تميم قالوا قد بشرتنا فاعطنا قال اقبلوا البشري يا اهل اليمن قالوا قد قبلنا فاخبرنا عن اول هذا الامر كيف كان قال كان الله قبل كل شء وكان عرشه علي الماء وكتب في اللوح ذكر كل شء وروي عن ابي
 
 رزين العقيلي وكان يعجب النبي صلي الله عليه وسلم من مسالته انه قال يا رسول الله اين كان الله قبل ان يخلق السموات والارض قال كان في عماء فوقه هواء وتحته هواء ثم خلق عرشه علي الماء
 
 قال فقال الجهمي اخبرني كيف استوي علي العرش اهو كما تقول العرب استوي فلان علي السرير فيكون السرير حوي فلانا وحده اذا كان عليه فيلزمك ان تقول ان العرش قد حوي الله وحده اذا كان عليه لانا لا نعقل الشء علي الشء الا هكذا باب من البيان لذلك يقال له اما قولك كيف استوي فان الله لا يجري عليه كيف وقد اخبرنا انه استوي علي العرش ولم يخبرنا كيف استوي فوجب علي المءمنين ان يصدقوا ربهم باستواءه علي العرش وحرم عليهم ان يصفوا كيف استوي لانه لم يخبرهم كيف كذلك ولم تره العيون في الدنيا فتصفه بما رات وحرم عليهم ان يقولوا عليه من حيث لا يعلمون فامنوا بخبره عن الاستواء ثم ردوا علم كيف استوي الي الله ولكن يلزمك انت ايها الجهمي ان تقول ان الله محدود وقد حوته الاماكن اذ زعمت في دعواك انه في الاماكن لانه لا يعقل شء في مكان الا والمكان قد
 
 حواه كما تقول العرب فلان في البيت والماء في الحب فالبيت قد حوي فلانا والحب قد حوي الماء ويلزمك اشنع من ذلك لانك قلت اشنع من ذلك لانك قلت افظع مما قالت به النصاري وذلك انهم قالوا ان الله حل في عيسي وعيسي بدن انسان واحد فكفروا بذلك وقيل لهم ما اعظمتم الله تعالي اذ جعلتموه في بطن مريم وانتم تقولون انه في كل مكان وفي بطون النساء كلهن وبدن عيسي وابدان الناس كلهم ويلزمك ايضا ان تقول انه في اجواف الكلاب والخنازير لانها اماكن وعندك انه في كل مكان تعالي الله عن ذلك علوا كبيرا قال فلما شنعت مقالته قال اقول بان الله في كل مكان لا كالشء في الشء ولا كالشء علي الشء ولا كالشء مع
 
 الشء خارجا عن الشء ولا مباينا للشء باب البيان لذلك يقال له ان اصل قولك القياس والمعقول علي انك لا تعبد شيءا لانه لو كان شيءا داخلا فمن القياس والمعقول ان يكون داخلا في الشء او خارجا عنه فلما لم يكن في ذلك شيءا استحال ان يكون كالشء او خارجا عن الشء فوصفت لعمري ملتبسا لا وجود له وهو دينك واصل مقالتك التعطيل واما الحجة التي ذكرها عن ابن الهيصم فلم يذكر الفاظها لكن ذكر انه نظمها احسن من نظمه ونحن في جميع ما نورده نحكي الفاظ المحتجين بعينها فان التصرف في ذلك قد يدخله خروج عن الصدق والعدل اما عمدا واما خطا فان الانسان ان لم يتعمد ان يلوي لسانه بالكذب او يكتم بعض ما يقوله غيره لكن المذهب الذي يقصد الانسان افساده لا يكون في قلبه من المحبة له ما يدعوه الي صوغ ادلته علي الوجه الاحسن حتي ينظمها نظما ينتصر به فكيف اذا كان مبغضا
 
 لذلك والله اعلم بحقيقة ما قاله ابن الهيصم ومانقله هذا عنه لكن نحن نتكلم علي ما وجدناه مع العلم بان الكرامية فيهم نوع بدعة في مسالة الايمان وغيرها كما في الاشعرية ايضا بدعة لكن المقصود في هذا المقام ذكر كلامهم وكلام النفاة ولا ريب ان اءمة الاشعرية وهم الذين كانوا اهل العراق كابي الحسن الكبير وابي الحسن الباهلي وابي عبد الله بن
 
 مجاهد وصاحبه القاضي ابي بكر وابي علي بن شاذان ونحوهم لم يكونوا في النفي كاشعرية خراسان مثل ابي بكر ابن فورك ونحوه بل زاد اولءك في النفي اشياء علي مذهب ابي الحسن ونقصوا من اثباته اشياء ولهذا يوجد في كلام ابي الحسن الاشعري وكلام ابي سعيد بن كلاب الذي ذكره ابو بكر ابن فورك فيما جمعه من كلامهما وبيان مذهبهما اشياء تخالف
 
 ما انتصر له ابن فورك في مواضع وهذه الحجة القياسية التي ذكرها عن ابن الهيصم هي
 
 ماخوذة من حجة اهل الاثبات في مسالة رءية الله وانهم كانوا يحتجون علي جواز رءية الله بان الله قادر علي ان يرينا نفسه لانه موجود وما لم تمكن رءيته لا يكون الا معدوما وهذه الحجة كانوا يتكلمون فيها كنحو كلام اهل الاثبات في مسالة العلو تارة يحتجون فيها بالعلم الضروري بان الله تعالي قادر علي ذلك وتارة يثبتون ذلك بالقياس فان الرءية مما يشترك فيها الجواهر والاعراض فيكون عليها امر مشترك بينهما ولا مشترك الا الوجود والحدوث لا يكون علة فثبت ان المصحح للرءية هو الوجود وهذه الطريقة القياسية مشهورة عن ابي الحسن الاشعري وللناس عليها اعتراضات معروفة كما ذكر ذلك الشهرستاني وغيره ولذلك عدل طاءفة من اتباعه كالقاضي
 
 ابي لكر الي ان اثبتوا امكان الرءية بالسمع كما ان وقوعها معلوم بالسمع بلا نزاع وابو عبد الله الرازي قد ذكر طريقة الاشعري هذه في الرءية في نهايته وذكر ما فيها من القوادح التي تظهر معها وهاها واذا علم ذلك فينبغي ان يعلم الامران احدهما ان الطريقة التي سلكها اهل الاثبات في مسالة العلو بدعوة الضرورة تارة وبالقياس الذي احتج به ابن الهيصم وغيره تارة اصح من الطريقة التي يسلكونها في مسالة الرءية بدعوي الضرورة تارة وبالقياس اخري كما قد ذكرنا فيما قبل ان العلم بان الله تعالي فوق خلقه اعرف في الفطرة واشهر في الشريعة واعظم استقرارا عند سلف الامة واءمتها من العلم بانه يري وان الجهمية كانوا يكتمون انكار ذلك ويتظاهرون بانكار الرءية ونحوها ليتوسلوا بما يظهرونه من انكار الرءية والقول بخلق القران علي ما يكتمونه من انكار وجود الله فوق العرش وكان اءمة السلف يعلمون ذلك منهم فيعرفونهم في لحن القول ويستدلون بما
 
 اظهروه علي ما اسروه لعلمهم باصل كلامهم وانهم انما انكروا رءيته وانكروا انه يتكلم حقيقة لان رءيته وكلامه مستلزم لوجوده فوق العالم فاذا سلموا الكلام والرءية وغيرهما لزمهم تسليم انه فوق العرش اذا انكروا ذلك ووافقهم عليه من وافقهم توسلوا بذلك لانكار علوه علي العرش وغير ذلك اذ يقال لو كان علي العرش لجازت رءيته ولكان متكلما وما لا يجوز ان يري يمتنع ان يكون فوق العرش فلما كانت مسالة العلو هي في نفسها اعظم وادلتها اقوي واكثر والمقرون بها اكثر واكثر من السلف والاءمة والعامة كانت الطريقة التي يسلكها اهل الاثبات فيها اقوي من الطريقة التي يسلكونها في مسالة الرءية وبيان ذلك ان اعتراف الفطر بان الله فوق العالم اعظم من اعترافها بانه يري ودلالة الكتاب والسنة واجماع سلف الامة علي ذلك اعظم من دلالة هذه الاصول علي رءية الله تعالي واعتراف القلوب بان ما لا يكون داخل العالم ولا خارجه لا يكون الا معدوما اعظم من اعترافها بان ما لا يمكن رءيته لا يكون الا معدوما وما في القلوب من البديهة والضرروة الي الاول اعظم مما فيها من الضرورة والبديهة الي الثاني كذلك اعترافها بديهة وضرورة بان كل موجودين لابد ان يكونا متباينين
 
 او متحايثين اعظم من اعترافها بان كل موجود فلابد وان تمكن رءيته واذا كان الامر كذلك ظهر ان الطريقة القياسية التي سلكها ابن الهيصم ونحوه في مسالة العلو اقوي من الطريقة التي سلكها الاشعري ونحوه وابن الهيصم ايضا في عين مسالة الرءية وكلاهما سلك طريقة ينصر بها الاثبات الذي جاء به الكتاب والسنة واتفق عليه سلف الامة وكل ما ذكره الرازي من القوادح في هذه الطريقة التي سلكها ابن الهيصم فانما هي قدح في الاصول العقلية التي سلكها اءمة الاشعرية وغيرهم فهدمه وهدم ابن فورك ونحوه بما ذكروه لاصول اصحابهم واءمتهم اعظم من هدمهم للاصول التي تذكرها الكرامية وغيرهم في مسالة العرش وهذا بين يعرفه من شدي شيءا من النظر في هذه المواضع ومن عرف ما اعتمده
 
 من الاصول في مسالة الرءية وعلم ما اعتمده هءلاء في مسالة العرش الامر الثاني انا نذكر ان الطريقة التي سلكها اهل الاثبات في الرءية ليست من الضعف كما يظنه اتباع الاشعري مثل الشهرستاني والرازي وغيرهما بل لم يفهموا قعرها ولم يقدروا الاشعري قدره بل قدروا مقدار كلامه وحججه وكان هو اعظم منهم قدرا واعلم بالمعقولات والمنقولات ومذاهب الناس من الاولين والاخرين كما تشهد به كتبه التي بلغتنا دع ما لم يبلغنا فمن راي ما في كتبه من ذكر المقالات والحجج وراي ما في كلام هءلاء راي بونا عظيما واذا ظهر ان طريقهم في الرءية اقوي مما يظنه هءلاء كان ذلك تنبيها علي ان طريقة ابن الهيصم في العلو اولي ان تكون اقوي منها وان يكون القدح فيها دون القدح في تلك ثم نبين ان شاء الله تعالي بالكلام المفصل ان عامة ما ذكره الرازي من
 
 القدح فيها قدح باطل ولا حول ولا قوة الا بالله والله هو المسءول ان يوفقنا للكلم الطيب والعمل الصالح وهو الذي يقوله وان كان فيه حكم بين هءلاء الذين يخوضون احيانا بكلام مذموم عند السلف لكن قد ذكرنا غير مرة ان من حكم الشريعة اعطاء كل ذي حق حقه كما في السنن عن عاءشة قالت امرنا رسول الله صلي الله عليه وسلم ان ننزل الناس منازلهم وان من كان منهم اقرب الي الحق والسنة عرفت مرتبته ووجب تقديمه في ذلك الامر علي ما كان ابعد عن الحق والسنة منه قال تعالي عن نبيه صلي الله عليه وسلم وامرت لاعدل بينكم [الشوري ] وقال تعالي يا ايها الذين امنوا كونوا قوامين بالقسط شهداء لله [النساء ] وقال في حق اهل الكتاب وان حكمت فاحكم بينهم بالقسط [الماءدة ] وقال فاحكم بينهم بما انزل الله ولا تتبع اهواءهم عما جاءك من الحق [الماءدة ] فكيف الحال بين طواءف اهل القبلة بل الحكم بين من فيه فجور ومن فيه بدعة بالعدل ووضعهم مراتبهم وترجيح هذا من الوجه
 
 الذي هو فيه اعظم موافقة للشريعة والحق امر واجب ومن عدل عن ذلك ظانا انه ينبغي الاعراض عن الجميع بالكلية فهو جاهل ظالم وقد يكون اعظم بدعة وفجورا من بعضهم قال ابو الحسن الاشعري في الابانة بعد ان احتج بحجج كثيرة جيدة علي اثبات الرءية من الكتاب والسنة والاجماع ومقصوده الاكبر في الابانة ذكر الحجج السمعية دون القياسية المبنية علي الكلام في الجواهر والاعراض فانه يختصرها فقال بعد ذلك ومما يدل علي جواز رءية الله بالابصار انه ليس موجودا الا وجايز ان يريناه وانما لا يجوز ان يري المعدوم فلما كان الله موجودا مثبتا كان غير مستحيل ان يرينا نفسه عز وجل وانما اراد من نفي الرءية لله عز وجل بالابصار التعطيل فلما لم يمكنهم ذلك صراحا اظهروا ما يءول الي التعطيل وجحدوا الله تعالي تعالي الله عما يقول الظالمون علوا كبيرا قال ومما يدل علي جواز رءية الله تعالي بالابصار ان الله تعالي يري الاشياء واذا كان للاشياء راءيا وليس يجوز ان يري الاشياء من لا يري نفسه واذا كان لنفسه راءيا فجاءز ان يرينا
 
 نفسه وذلك انه من لا يعلم نفسه لا يعلم شيءا فما كان الله تعالي عالما بالاشياء كان عالما بنفسه فكذلك من لا يري نفسه لا يري الاشياء فلما كان الله راءيا للاشياء كان راءيا لنفسه واذا كان راءيا لها فجاءز ان يرينا نفسه كما انه لما كان عالما بنفسه جاز ان يعلمناها وقد قال الله عز وجل انني معكما اسمع واري {} [طه ] فاخبر انه سمع كلامهما ويراهما ومن زعم ان الله لا يري بالابصار يلزمه ان لا يجوز ان يكون الله عز وجل عالما ولا قادرا ولا راءيا لان العالم القادر الراءي جاءز ان يري قلت وهذا المعني الذي ذكره الاشعري من ان الموجود يقدر الله علي ان يريناه وان المعدوم هو الذي لا يجوز رءيته فنفي الرءية يستلزم نفي الوجود هو ماخوذ من كلام السلف والاءمة كما ذكره حنبل عن الامام احمد ورواه الخلال عن
 
 في كتاب السنة قال القوم يرجعون الي التعطيل في كونهم ينكرون الرءية وذلك ان الله علي كل شء قدير وهذا لفظ عام لا تخصيص فيه فاما الممتنع لذاته فليس بشء باتفاق العقلاء وذلك انه متناقض لا يعقل وجوده فلا يدخل في مسمي الشء حتي يكون داخلا في العموم مثل ان يقول القاءل هل يقدر ان يعدم نفسه او يخلق مثله فان القدرة تستلزم وجود القادر وعدمه ينافي وجوده فكانه قيل هل يكون موجودا معدوما وهذا متناقض في نفسه لا حقيقة له وليس بشء اصلا وكذلك وجود مثله يستلزم ان يكون الشء موجودا معدوما فان مثل الشء ما يسد مسده ويقوم مقامه فيجب ان يكون الشء موجودا معدوما قبل وجوده مفتقرا مربوبا فاذا قدر انه مثل الخالق تعالي لزم ان يكون واجبا قديما لم يزل موجودا غنيا ربا ويكون الخالق فقيرا ممكنا معدوما مفتقرا مربوبا فيكون الشء الواحد قديما محدثا فقيرا مستغنيا واجبا ممكنا موجودا معدوما ربا مربوبا وهذا متناقض لا حقيقة له وليس بشء اصلا فلا يدخل في العموم وامثال ذلك اما خلق قوة في العباد يقدرون به علي رءيته فان ذلك يقتضي كمال قدرته وما من موجود قاءم بنفسه الا والله قادر علي ان يرينا اياه بل قد يقال ذلك في كل موجود سواء قام بنفسه او قام بغيره
 
 وهنا طريقة اخري وهي ان نقول كل موجود فالله قادر علي ان يجعلنا نحسه باحد الحواس الخمس وما لا يكون مكنا احساسه باحدي الحواس الخمس فانه معدوم وهذه الطريقة مما بين الاءمة ان جهما يقول ان الله معدوم لما زعم انه لا يحس بشء من الحواس لان الموجود لابد ان يمكن احساسه باحدي الحواس كما ذكر الامام احمد اصل قوم جهم قال وكذلك الجهم وشيعته دعوا الناس الي المتشابه من القران والحديث واضلوا بكلامهم بشرا كثيرا فكان مما بلغنا من امر الجهم عدو الله انه كان صاحب خصومات وكلام وكان اكثر كلامه في الله فلقي اناسا من المشركين يقال لهم السمنية فعرفوا الجهم فقالوا نكلمك فان ظهرت حجتنا
 
 عليك دخلت في ديننا وان ظهرت حجتك علينا دخلنا في دينك وكان مما كلموا به الجهم ان قالوا الست تزعم ان لك الها قال الجهم نعم فقالوا له فهل رايت الهك قال لا قالوا فهل سمعت كلامه قال لا قالوا فشممت راءحة قال لا قالوا فوجدت له حسا قال لا قالوا له فوجدت له مجسا قال لا قالوا فما يدريك انه اله قال فتحير الجهم فلم يدر من يعبد اربعين يوما ثم انه استدرك حجة مثل زنادقة النصاري وذلك ان زنادقة النصاري يزعمون ان الروح الذي في عيسي هي روح الله من ذات الله فاذا اراد ان يحدث امرا دخل في بعض خلقه فتكلم علي لسان خلقه فيامر بما شاء وينهي عما شاء وهو روح غاءب عن الابصار فاستدرك الجهم حجة مثل هذه الحجة فقال للسمني الست تزعم ان فيك روحا قال نعم فقال هل رايت روحك قال لا قال فهل سمعت كلامه قال لا قال فوجدت له حسا او مجسا قال لا قال فكذلك الله لا يري له وجه ولا يسمع له صوت ولا يشم له راءحة وهو غاءب عن الابصار ولا يكون في مكان دون مكان ووجد ثلاث ايات من المتشابه من القران قوله ليس كمثله شء [الشوري ] وهو
 
 الله في السماوات وفي الارض [الانعام ] لا تدركه الابصار وهو يدرك الابصار [الانعام ] فبني اصل اضلاله علي هءلاء الايات وتاول القران علي غير تاويله وكذب باحاديث رسول الله صلي الله عليه وسلم وزعم ان من وصف الله بشء مما وصف به نفسه في كتابه او حدث به رسوله كان كافرا وكان من المشبهة فاضل بكلامه بشرا كثيرا واتبعه علي قوله رجال من اصحاب ابي حنيفة واصحاب عمرو بن عبيد بالبصرة ووضع دين الجهمية فاذا سالهم الناس عن قول الله عز وجل ليس كمثله شء [الشوري ] يقولون ليس كمثله شء من الاشياء وهو تحت الارضين السابعة كما هو علي العرش ولا يخلو منه مكان ولا يكون في مكان دون مكان
 
 ولا يكلم ولا يتكلم ولا ينظر اليه احد في الدنيا ولا في الاخرة ولا يوصف بصفة ولا بفعل ولا له غاية ولا له منتهي ولا يدرك بعقل وذكر تمام كلامه وقد كتبناه قبل هذا الي ان قال فعند ذلك تبين لناس انهم لا يثبتون شيءا ولكن يدفعون عن انفسهم الشنعة بما يقرون في العلانية وذكر تمام الكلام والمقصود انه بين ان وصفه بانه لا يعرف بشء من الحواس هو اصل كلامه الذي لزم به التعطيل وانه لا يثبت شيءا لان ما يكون كذلك لا يكون شيءا وهذا امر مستقر في فطر المءمنين لا يشكون في ان الله تعالي قادر علي ان يريهم نفسه وانما يشكون هل يكون ذلك او لا يكون كما سال المءمنون النبي صلي الله عليه وسلم هل نري ربنا يوم القيامة فقال نعم هل تضارون في رءية الشمس وهذا ثابت في الاحاديث الصحيحة المستفيضة المتواترة فانما كانوا شاكين هل يرون ربهم لم يكونوا شاكين هل يقدر علي ان يريهم نفسه وكذلك في المعاد يعلمون انهم عاجزون عن رءيته كما انهم عاجزون عن ان
 
 يقدروا بسمعهم وببصرهم علي اكثر مما هم قادرون عليه كما يعجزون عن رءية الاشياء البعيدة والاشياء اللطيفة مع علمهم ان الله قادر ان يريهم ذلك وكذلك من قبلهم من الامم ولهذا سال موسي ربه الرءية وسال قومه ان يروا الله جهرة كما سالوا ساءر الايات فانهم وان كانوا مذمومين علي مسالة الايات فليسوا مذمومين علي علمهم بان الله قادر عليها كما قد يسال الرجل ما لا يصلح وهو من الاعتداء في الدعاء مثل ان يسال منازل الانبياء ونحو ذلك فان الله قادر علي ذلك ولكن مسالة هذا عدوان ولهذا لا يوجد احدا من الامم السليمة الفطرة قال ان رءية الله ممتنعة عليه يعني انه لا يجوز ان يكون مرءيا بحال وليس في مقدوره ان يري احدا نفسه بل هم اذا نفوا الرءية كان لعظمته من جهة القدر او الوصف مثل قوله لا تدركه الابصار [الانعام ] اي لا تحيط به ومثل قوله صلي الله عليه وسلم نور اني اراه وقال رايت
 
 نورا وهذا في المخلوقات فالخالق اعظم فان السماء ينتفي عنها ادراك البصر لسعتها والشمس لبرهانها وشعاعها الذي يعشي البصر فيكون ذلك لعجز البصر عن وصف المرءي وقدره اما ان يقال ان موجودا عظيما يمتنع في نفسه ان يكون مرءيا كما يمتنع ذلك في المعدوم فهذا خلاف ما فطر الله عليه عباده بل حيث كان الوجود اكمل كان احق بان يجوز ان يري ويشهد لكن بشرط قوي الراءي وكماله ولهذا قال النبي صلي الله عليه وسلم في الاحاديث الصحيحة انكم ترون ربكم كما ترون الشمس والقمر لا تضامون في رءيته وفي رواية كما ترون الشمس صحوا ليس دونها سحاب فقوله لا تضامون
 
 ولا تضارون نفي ان يلحقهم ضيم او ضير كما يلحقهم في الدنيا في رءية الشء اما لظهوره كالشمس او لخفاءه كالهلال واما المعدوم فالاحساس به برءية او غيرها يقتضي ان يكون موجودا معدوما فان كان معدوما يقتضي انه ليس في الخارج فرءيته في الخارج يقتضي انه في الخارج فيقتضي الجمع بين النقيضين الوجود والعدم وهذا باطل ممتنع لا حقيقة له اصلا فلا يدخل في مسمي الشء حتي يقال ان الله عليه قدير فانه سبحانه علي كل شء قدير وهذا ليس بشء اصلا نعم صورة المعدوم الثابتة في العلم قد تنازع الناس في
 
 جواز رءيتها وتنازعوا كذلك في جواز رءية الله للمعدومات لثبوتها في علمه والنزاع فيها مشهور واما الحجة القياسية المشهورة في هذا الباب التي احتج بها الاشعري وغيره فان هذا الرازي قد ذكرها في نهايته واورد عليها اعتراضات كثيرة تهدمها وكذلك من قبله كالشهرستاني وغيره ولم يقفوا علي غورها ولا اعطوها حقها وليس هذا موضع بسطها لكن ننبه عليها فانا قد قدمنا فيما تقدم ان الامثال المضروبة اذا كانت من باب الاولي جاز استعمالها في حق الله تعالي كما ورد به القران والسنة
 
 واستعملها السلف والاءمة كما يقال اذا كان العبد ينزه نفسه عن شريك او انثي فتنزيه ربه اولي واذا كان العبد عالما قادرا فالله اولي وكذلك هذه فان حاصلها انه اذا جاز رءية الموجود المحدث الممكن فرءية الموجود الواجب القديم اولي واذا كان المخلوق الناقص في وجوده يجوز ان يري ويحس به فالرب الكامل في وجوده احق بان يري فان كون الشء بحيث يري كمال في حقه لا نقص لان كونه لا يري ولا يحس به لا يثبت في الشاهد الا للمعدوم فكل صفة لم نعلمها تثبت الا لمعدوم لا تكون صفة كمال بخلاف الصفات التي تثبت للموجود دون المعدوم فانها لا تكون صفة نقص الا بالنسبة الي وجود اخر هو اكمل منها وكل صفة لا تثبت للمعدوم ولا يختص بها الناقص فانها لا تكون الا صفة كمال وهذه الطريقة في المسالة يتبين بها ان جواز الرءية من صفات الكمال التي هو الباري احق بها من المخلوقات ونظيرها في مسالة العلو ان علة الشء بنفسه علي غيره صفة كمال كما ان قدرته عليه صفة كمال واذا كامن كذلك فالله احق بهذه الصفة من جميع ما يوصف بها غيره فيجب ان يكون عاليا بنفسه وكذلك تميزه بذاته عن غيره هي صفة
 
 لا يوصف بها المعدوم ولا تختص بالناقصات فتكون صفة كمال فيجب اتصاف الله بها وذلك يوجب مباينته للعالم لكن قد علمنا انا لم نكتب هنا ما يحتج به اهل الاثبات ولكن تكلمنا علي ما ذكره الرازي ولوازمه فبينا ان هذه الحجة القياسية المذكورة في الرءية مضمونها انا انما نري الاشياء لكونها موجودة والله سبحانه وتعالي موجود بل هو اكمل في الوجود فيجب ان تكون رءيته جاءزة وتلخيصها ان يقال لا ريب انا نري الموجودات من الجواهر والاعراض كالالوان والمقادير مثل الطول والقصر ونحوهما دون المعدومات واختصاص الرءية الموجود دون المعدوم يقتضي ان المقتضي لجواز الرءية مختص الوجود ومعني هذا انه لا يجوز ان يكون الموجود والمعدوم في الرءية سواء اذ لو كانا متماثلين في ذلك لم يجز اختلافهما في رءية احدهما دون الاخر فليس المراد بقولنا ان علة الرءية او المقتضي لها مختص بالوجود اثبات علة او سبب زاءد علي حقيقة الموجود مقتض لصحة رءيته كما توهمه من قال في الاحكام ما يعلل منها وما لا يعلل فيجوز ان تكون الرءية من الاحكام التي لا تعلل بل المراد ان كون احد الجنسين تصح رءيته دون الاخر يقتضي اختلافهما في ذلك وعدم تماثلهما
 
