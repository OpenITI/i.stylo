 اخرج ابن جرير وابن المنذر وابن ابي حاتم وابو الشيخ عن ابن عباس في قوله @QB@ فان تولوا فقل حسبي الله @QE@ يعني الكفار تولوا عن النبي صلي الله عليه وسلم وهذه في المءمنين
 واخرج ابو الشيخ عن محمد بن كعب قال : خرجت سرية الي ارض الروم فسقط رجل منهم فانكسرت فخذه فلم يستطيعوا ان يحملوه فربطوا فرسه عنده ووضعوا عنده شيءا من ماء وزاد فلما ولوا اتاه ات فقال له : ما لك ههنا قال : انكسرت فخذي فتركني اصحابي
 فقال : ضع يدك حيث تجد الالم
 فقل @QB@ فان تولوا فقل حسبي الله لا اله الا هو عليه توكلت وهو رب العرش العظيم @QE@ قال : فوضع يده فقرا هذه الاية فصح مكانه وركب فرسه وادرك اصحابه
 واخرج ابو داود عن ابي الدرداء موقوفا وابن السني عن ابي الدرداء قال : قال رسول الله صلي الله عليه وسلم من قال حين يصبح وحين يمسي @QB@ حسبي الله لا اله الا هو عليه توكلت وهو رب العرش العظيم @QE@ سبع مرات كفاه الله ما اهمه من امر الدنيا والاخرة
 واخرج ابن النجار في تاريخه عن الحسن قال : من قال حين يصبح سبع مرات @QB@ حسبي الله لا اله الا هو عليه توكلت وهو رب العرش العظيم @QE@ لم يصبه ذلك اليوم ولا تلك الليلة كرب ولا سلب ولا غرق
 اما قوله تعالي : @QB@ وهو رب العرش العظيم @QE@ اخرج ابن ابي حاتم عن ابن عباس قال : انما سمي العرش عرشا لارتفاعه
 واخرج ابن المنذر وابن ابي حاتم وابو الشيخ في العظمة عن سعد الطاءي قال : العرش ياقوتة حمراء
 واخرج ابن ابي حاتم وابو الشيخ في العظمة عن وهب بن منبه قال : ان الله تعالي خلق العرش والكرسي من نوره فالعرش ملتصق بالكرسي والملاءكة في جوف الكرسي وحوله العرش اربعة انهار نهر من نور يتلالا ونهر من نار تتلظي ونهر من ثلج ابيض تلتمع منه الابصار ونهر من ماء والملاءكة قيام في تلك الانهار  يسبحون الله تعالي وللعرش السنة بعدد السنة الخلق كلهم فهو يسبح الله تعالي ويذكره بتلك الالسنة
 واخرج ابو الشيخ عن الشعبي قال : قال رسول الله صلي الله عليه وسلم العرش ياقوتة حمراء وان ملكا من الملاءكة نظر اليه والي عظمه فاوحي الله اليه : اني قد جعلت فيك قوة سبعين الف ملك لكل ملك سبعون الف جناح فطر
 فطار الملك بما فيه من القوة والاجنحة ما شاء الله ان يطير فوقف فنظر فكانه لم يرم
 واخرج ابو الشيخ عن حماد قال : خلق الله العرش من زمردة خضراء وخلق له اربع قواءم من ياقوتة حمراء وخلق له الف لسان وخلق في الارض الف امة كل امة تسبح الله بلسان من السن العرش
 واخرج الطبراني وابو الشيخ عن عبد الله بن عمرو بن العاصي قال : ان العرش مطوق بحية والوحي ينزل في السلاسل
 واخرج ابن المنذر عن عطاء قال : كانوا يرون ان العرش علي الحرم
 واخرج ابن ابي حاتم وابو الشيخ عن ابن عباس قال : ما يقدر قدر العرش الا الذي خلقه وان السموات في خلق العرش مثل قبة في صحراء
 واخرج سعيد بن منصور وابن ابي حاتم وابو الشيخ عن مجاهد قال : ما اخذت السموات والارض من العرش الا كما تاخذ الحلقة من ارض الفلاة
 واخرج ابن ابي حاتم عن كعب قال : ان السموات في العرش كالقنديل معلقا بين السماء والارض
 واخرج ابن ابي حاتم عن عمر بن يزيد البصري قال : في كتاب ما تنبا عليه هرون النبي عليه الصلاة والسلام : ان بحرنا هذا خليج من نبطس ونبطس وراءه وهو محيط بالارض فالارض وما فوقها من البحار عند نبطس كعين علي سيف البحر وخلف نبطس قينس محيط بالارض فنبطس وما دونه عنده كعين علي سيف البحر وخلف قينس الاصم محيط بالارض فقينس وما دونه عنده كعين علي سيف البحر وخلف الاصم المظلم محيط بالارض فالاصم وما دونه عنده كعين علي سيف البحر : وخلف المظلم جبل من الماس محيط بالارض فالمظلم وما دونه عنده كعين علي سيف البحر وخلف الماس الباكي وهو ماء عذب محيط بالارض امر الله نصفه ان يكون تحت العرش فاراد ان يستجمع فزجره فهو باك  يستغفر الله فالماس وما دونه عنده كعين علي سيف البحر والعرش خلف ذلك محيط بالارض فالباكي وما دونه عنده كعين علي سيف البحر
 واخرج ابو الشيخ عن عبد الرحمن بن زيد اسلم عن ابيه ان رسول الله صلي الله عليه وسلم قال : ما السموات السبع في الكرسي الا كدراهم سبعة القيت في ترس
 قال ابن زيد : قال ابو ذر عن النبي صلي الله عليه وسلم ما الكرسي في العرش الا كحلقة من حديد القيت بين ظهري فلاة من الارض والكرسي موضع القدمين
 واخرج ابو الشيخ عن وهب رضي الله عنه قال : خلق الله العرش وللعرش سبعون الف ساق كل ساق كاستدارة السماء والارض
 واخرج عبد بن حميد وابو الشيخ والبيهقي في الاسماء والصفات عن مجاهد رضي الله عنه قال : بين الملاءكة وبين العرش سبعون حجابا حجاب من نور وحجاب من ظلمة وحجاب من نور وحجاب من ظلمة

 واخرج ابن ابي شيبة والبخاري ومسلم والترمذي والنساءي وابن ماجة والبيهقي في الاسماء والصفات عن ابن عباس رضي الله عنهما قال : كان النبي صلي الله عليه وسلم يقول عند الكرب لا اله الا الله العظيم الحليم لا اله الا الله رب العرش العظيم لا اله الا الله رب السموات ورب الارضين ورب العرش الكريم 
 واخرج النساءي والحاكم والبيهقي عن عبد الله بن جعفر رضي الله قال : علمني علي رضي الله عنه كلمات علمهن رسول الله صلي الله عليه وسلم اياه يقولهن عند الكرب والشء يصيبه لا اله الا الله الحليم الكريم سبحان الله وتبارك الله رب العرش العظيم والحمد لله رب العالمين
 واخرج الحكيم الترمذي من طريق اسحاق بن عبد الله بن جعفر عن ابيه قال : كان رسول الله صلي الله عليه وسلم يقول لقنوا موتاكم لا اله الا الله الحليم الكريم سبحان الله رب السموات السبع ورب العرش العظيم الحمد لله رب العالمين
 قالوا : يا رسول الله فكيف هي للحي قال : اجود واجود
 واخرج ابن ابي شيبة عن عبد الله بن جعفر انه زوج ابنته فخلا بها فقال : اذا نزل بك الموت او امر من امور الدنيا فظيع فاستقبليه بان تقولي لا اله الا الله الحليم الكريم سبجان الله رب العرش العظيم الحمد لله رب العالمين
 واخرج احمد في الزهد وابو الشيخ في العظمة عن وهب بن منبه رضي الله عنه
  ان حزقيل كان في سبا بختنصر مع دانيال من بيت المقدس فزعم حزقيل انه كان ناءما علي شاطء الفرات فاتاه ملك وهو ناءم فاخذ براسه فاحتمله حتي وضعه في خزانة بيت المقدس قال : فرفعت راسي الي السماء فاذا السموات منفرجات دون العرش قال : فبدا لي العرش ومن حوله فنظرت اليهم من تلك الفرجة فاذا العرش  اذا نظرت اليه  مظل علي السموات والارض واذا نظرت الي السموات والارض رايتهن متعلقات ببطن العرش واذا الحملة اربعة من الملاءكة لكل ملك منهم اربعة وجوه وجه انسان ووجه نسر ووجه اسد ووجه ثور فلما اعجبني ذلك منهم نظرت الي اقدامهم فاذا هي في الارض علي عجل تدور بها واذا ملك قاءم بين يدي العرش له ستة اجنحة لها لون كلون فرع لم يزل ذلك مقامه منذ خلق الله الخلق الي ان تقوم الساعة فاذا هو جبريل عليه السلام واذا ملك اسفل من ذلك اعظم شء رايته من الخلق فاذا هو ميكاءيل وهو خليفة علي ملاءكة السماء واذا ملاءكة يطوفون بالعرش منذ خلق الله الخلق الي ان تقوم الساعة يقولون : قدوس قدوس ربنا الله القوي ملات عظمته السموات والارض واذا ملاءكة اسفل من ذلك لكل ملك منهم ستة اجنحة جناحان يستر بهما وجهه من النور وجناحان يغطي بهما جسده وجناحان يطير بهما
 واذا هم الملاءكة المقربون واذا ملاءكة اسفل من ذلك سجود مذ خلق الله الخلق الي ان ينفخ في الصور فاذا نفخ في الصور رفعوا رءوسهم فاذا نظروا الي العرش قالوا : سبحانك ما كنا نقدرك حق قدرتك ثم رايت العرش تدلي من تلك الفرجة فكان قدرها ثم افضي الي ما بين السماء والارض فكان يلي ما بينهما ثم دخل من باب الرحمة فكان قدره ثم افضي الي المسجد فكان قدره ثم وقع علي الصخرة فكان قدرها ثم قال : يا ابن ادم
 فصعقت وسمعت صوتا لم اسمع مثله قط فذهبت اقدر ذلك الصوت فاذا قدره كعسكر اجتمعوا فاجلبوا بصوت واحد او كفءة اجتمعت فتدافعت واتي بعضها بعضا او اعظم من ذلك
 قال حزقيل : فلما صعقت قال : انعشوه فانه ضعيف خلق من طين ثم قال : اذهب الي قومك فانت طليعتي عليهم كطليعة الجيش من دعوته منهم فاجابك واهتدي بهداك فلك مثل اجره ومن غفلت عنه حتي يموت ضالا فعليك مثل وزره لا يخفف ذلك من اوزارهم شيءا ثم عرج بالعرش واحتملت حتي رددت الي  شاطء الفرات فبينما انا ناءم علي شاطء الفرات اذ اتاني ملك فاخذ براسي فاحتملني حتي ادخلني جنب بيت المقدس فاذا انا بحوض ماء لا يجوز قدمي ثم افضيت منه الي الجنة فاذا شجرها علي شطوط انهارها واذا هو شجر لا يتناثر ورقه ولا يفني عمره فاذا فيه الطلع والقضيب والبيع والقطيف قلت : فما لباسها قال : هو ثياب كثياب الحور يتفلق علي اي لون شاء صاحبه
 قلت : فما ازواجها فعرضن علي فذهبت لاقيس حسن وجوههنفاذا هن لو جمع الشمس والقمر كان وجه احداهن اضوا منهما واذا لحم احداهن لايواري عظمها واذا عظمها لا يواري مخها واذا هي اذا نام عنها صاحبها استيقظ وهي بكر فعجبت من ذلك

 فقيل لي : لم تعجب من هذا فقلت : وما لي لا اعجب قال : فانه من اكل من هذه الثمار التي رايت خلد ومن تزوج من هذه الازواج انقطع عنه الهم والحزن قال : ثم اخذ براسي فردني حيث كنت
 قال حزقيل : فبينا انا ناءم علي شاطء الفرات اذ اتاني ملك فاخذ براسي فاحتملني حتي وضعني بقاع من الارض قد كانت معركة واذا فيه عشرة الاف قتيل قد بددت الطيور والسباع لحومهم وفرقت بين اوصالهم ثم قال لي : ان قوما يزعمون انه من مات منهم او قتل فقد انفلت مني وذهبت عنه قدرتي فادعهم
 قال حزقيل : فدعوتهم فاذا كل عظم قد اقبل الي مفصله الذي منه انقطع ما رجل بصاحبه باعرف من العظم بمفصله الذي فارق حتي ام بعضها بعضا ثم نبت عليها اللحم ثم نبتت العروق ثم انبسطت الجلود وانا انظر الي ذلك ثم قال : ادع لي ارواحهم
 قال حزقيل : فدعوتها واذا كل روح قد اقبل الي جسده الذي فارق فلما جلسوا سالتهم فيم كنتم قالوا : انا لما متنا وفارقنا الحياة لقينا ملك يقال له ميكاءيل قال : هلموا اعمالكم وخذوا اجوركم كذلك سنتنا فيكم وفيمن كان قبلكم وفيمن هو كاءن بعدكم
 فنظر في اعمالنا فوجدنا نعبد الاوثان فسلط الدود علي اجسادنا وجعلت الارواح تالمه وسلط الغم علي ارواحنا وجعلت اجسادنا تالمه فلم نزل كذلك نعذب حتي دعوتنا
 قال : ثم احتملني فردني حيث كنت
