 واخرج عبد بن حميد وابن جرير وابن المنذر عن قتادة قال : الخشوع في القلب هو الخوف وغض البصر في الصلاة
 واخرج ابن ابي شيبة وعبد بن حميد وابن جرير عن ابراهيم @QB@ الذين هم في صلاتهم خاشعون @QE@ قال : الخشوع في القلب
 وقال : ساكتون
 واخرج ابن جرير وابن ابي حاتم عن الحسن في قوله @QB@ الذين هم في صلاتهم خاشعون @QE@ قال : كان خشوعهم في قلوبهم فغضوا بذلك ابصارهم وخفضوا لذلك الجناح
  واخرج عبد الرزاق وعبد بن حميد وابن جرير وابن ابي حاتم عن الزهري @QB@ الذين هم في صلاتهم خاشعون @QE@ قال : هو سكون المرء في صلاته
 واخرج ابن المبارك وعبد الرزاق وعبد بن حميد وابن جرير وابن المنذر عن مجاهد في الاية قال : الخشوع في الصلاة السكوت فيها
 واخرج ابن سعد وابن ابي شيبة واحمد في الزهد عن مجاهد عن عبد الله بن الزبير
 انه كان يقوم للصلاة كانه عود وكان ابو بكر رضي الله عنه يفعل ذلك
 وقال مجاهد : هو الخشوع في الصلاة
 واخرج الحكيم الترمذي من طريق القاسم بن محمد عن اسماء بنت ابي بكر عن ام رومان والدة عاءشة قالت : راني ابو بكر الصديق رضي الله عنه اتميل في صلاتي فزجرني زجرة كدت انصرف من صلاتي قال : سمعت رسول الله  صلي الله عليه وسلم  يقول اذا قام احدكم في الصلاة فليسكن اطرافه لا يتميل اليهود فان سكون الاطراف في الصلاة من تمام الصلاة
 واخرج الحكيم الترمذي عن ابي هريرة عن رسول الله  صلي الله عليه وسلم  انه راي رجلا يعبث بحليته في صلاته فقال : لو خشع قلب هذا خشعت جوارحه
 واخرج ابن سعد عن ابي قلابة قال : سالت مسلم بن يسار عن الخشوع في الصلاة فقال : تضع بصرك حيث تسجد
 واخرج ابن ابي شيبة والبخاري وابو داود والنساءي عن عاءشة قالت : سالت رسول الله  صلي الله عليه وسلم  عن الالتفات في الصلاة فقال : هو اختلاس يختلسه الشيطان من صلاة العبد
 واخرج ابن ابي شيبة عن ابي هريرة انه قال في مرضه ( اقعدوني اقعدوني فان عندي وديعة اودعتها رسول الله  صلي الله عليه وسلم  قال : لا يلتفت احدكم في صلاته فان كان لا بد فاعلا ففي غير ما افترض الله عليه
 واخرج عبد الرزاق وابن ابي شيبة من طريق عطاء قال سمعت ابا هريرة يقول : اذا صليت فان ربك امامك وانت مناجيه فلا تلتفت
 قال عطاء : وبلغني ان الرب يقول : يا ابن ادم الي من تلتفت انا خير لك ممن تلتفت اليه
 واخرج ابن ابي شيبة عن ابي الدرداء قال : اياكم والالتفاف في الصلاة فانه لا صلاة للمتلفت واذا غلبتم علي تطوع فلا تغلبوا علي المكتوبة
 واخرج ابن ابي شيبة عن ابن مسعود قال : ان الله لا يزال مقبلا علي العبد  ما دام في صلاته ما لم يحدث او يلتفت
 واخرج ابن ابي شيبة عن عبد الله بن منقذ قال : اذا قام الرجل الي الصلاة اقبل الله عليه بوجهه فاذا التفت اعرض عنه
 واخرج ابن ابي شيبة عن كعب قال : اذا قام الرجل في الصلاة اقبل الله عليه بوجهه ما لم يلتفت
 واخرج ابن ابي شيبة عن الحكم قال : ان من تمام الصلاة ان لا تعرف من عن يمينك ولا من عن شمالك
 واخرج الحاكم وصححه من طريق جبير بن نفير بن عوف بن مالك ان رسول الله  صلي الله عليه وسلم  نظر الي السماء يوما فقال : هذا اوان ما يرفع العلم فقال له رجل من الانصار يقال له ابن لبيد : يا رسول الله كيف يرفع وقد اثبت في الكتب ووعته القلوب فقال : ان كنت لا حسبك من افقه اهل المدينة ثم ذكر ضلالة اليهود والنصاري علي ما في ايديهم من كتاب الله قال : فلقيت شداد بن اوس فحدثته فقال : صدق عوف الا اخبرك باول ذلك
 قلت : بلي قال : الخشوع حتي لا تري خاشعا
 واخرج الحاكم وصححه من طريق جبير بن نفير عن ابي الدرداء قال كنا مع رسول الله  صلي الله عليه وسلم  فشخص ببصره الي السماء ثم قال : هذا اوان يختلس العلم من الناس حتي لا يقدروا منه علي شء فقال زياد بن لبيد : يا رسول الله وكيف يختلس العلم منا وقد قرانا القران فو الله لنقرانه ولنقرءنه نساءنا وابناءنا فقال : ثكلتك امك يا زياد ان كنت لا عدك من فقهاء اهل المدينة هذا التوراة والانجيل عند اليهود والنصاري فماذا يغني عنهم فلقيت عبادة بن الصامت فقلت له : الا تسمع ما يقول اخوك ابو الدرداء واخبرته
 فقال صدق وان شءت لاحدثنك باول علم يرفع من الناس الخشوع
 يوشك ان تدخل المسجد فلا تري فيه رجلا خاشعا
 واخرج ابن ابي شيبة واحمد في الزهد والحاكم وصححه عن حذيفة قال : اول ما تفقدون من دينكم الخشوع واخر ما تفقدون من دينكم الصلاة
 ولتنقضن عرا الاسلام عروة عروة وليصلين النساء وهن حيض ولتسلكن طريق من كان قبلكم حذو القذة بالقذة وحذو النعل بالنعل لا تخطو طريقهم ولا تخطء بكم حتي تبقي فرقتان من فرق كثيرة تقول احداهما : ما بال الصلاة الخمس لقد ضل من كان قبلنا انما قال الله @QB@ واقم الصلاة طرفي النهار وزلفا من الليل @QE@ هود
 الاية  لا تصلوا الا ثلاثا
 وتقول الاخري : انما المءمنون بالله  كايمان الملاءكة لا فينا كافر ولا منافق حق علي الله ان يحشرها مع الدجال
 واخرج احمد عن ابي اليسر ان رسول الله صلي الله عليه وسلم قال : منكم من يصلي الصلاة كاملة ومنكم من يصلي النصف والثلث والربع حتي بلغ العشر
 واخرج ابن ابي شيبة ومسلم وابن ماجة عن جابر بن سمرة قال : قال رسول الله صلي الله عليه وسلم : لينتهين قوم يرفعون ابصارهم الي السماء في الصلاة او لا ترجع اليهم
 واخرج ابن ابي شيبة والبخاري وابو داود والنساءي وابن ماجة عن انس بن مالك ان النبي صلي الله عليه وسلم قال : ما بال اقوام يرفعون ابصارهم الي السماء في صلاتهم فاشتد في ذلك حتي قال : لينتهن عن ذلك او لتخطفن ابصارهم
 واخرج ابن ابي شيبة عن ابن مسعود قال : لينتهين اقوام يرفعون ابصارهم الي السماء في الصلاة او لا ترجع اليهم
 واخرج ابن ابي شيبة عن حذيفة قال : اما يخشي احدكم اذا رفع بصره الي السماء ان لا يرجع اليه بصره يعني وهو في الصلاة
