 واخرج ابن جرير وابن المنذر عن مجاهد في قوله @QB@ ليس بامانيكم ولا اماني اهل الكتاب @QE@ قال : قريش وكعب بن الاشرف
 واخرج ابن ابي شيبة عن الحسن قال : ان الايمان ليس بالتحلي ولا بالتمني ان الايمان ما وقر في القلب وصدقه العمل
 واخرج عبد بن حميد وابن ابي حاتم عن ابن عباس قال : قالت اليهود والنصاري : لا يدخل الجنة غيرنا
 وقالت قريش : لا نبعث
 فانزل الله @QB@ ليس بامانيكم ولا اماني اهل الكتاب من يعمل سوءا يجز به @QE@  والسوء : الشرك
 واخرج احمد وهناد وعبد بن حميد والحكيم الترمذي وابن جرير وابو يعلي وابن المنذر وابن حبان وابن السني في عمل اليوم والليلة والحاكم وصححه والبيهقي في شعب الايمان والضياء في المختارة عن ابي بكر الصديق انه قال : يا رسول الله كيف الصلاح بعد هذه الاية @QB@ ليس بامانيكم ولا اماني اهل الكتاب من يعمل سوءا يجز به @QE@ فكل سوء جزينا به فقال النبي صلي الله عليه وسلم : غفر الله لك يا ابا بكر الست تنصب الست تمرض الست تحزن الست تصيبك اللاواء قال : بلي
 قال : فهو ما تجزون به
 واخرج احمد والبزار وابن جرير وابن مردويه والخطيب في المتفق والمفترق عن ابن عمر قال : سمعت ابا بكر يقول : قال رسول الله صلي الله عليه وسلم : من يعمل سوءا يجز به في الدينا
 واخرج ابن سعيد والترمذي الحكيم والبزار وابن المنذر والحاكم عن ابن عمر انه مر بعبد الله بن الزبير وهو مصلوب فقال : رحمك الله يا ابا خبيب سمعت اباك الزبير يقول : سمعت رسول الله صلي الله عليه وسلم يقول : من يعمل سوءا يجز به في الدينا
 واخرج عبد بن حميد والترمذي وابن المنذر عن ابي بكر الصديق قال : كنت عند النبي صلي الله عليه وسلم فنزلت هذه الاية @QB@ من يعمل سوءا يجز به ولا يجد له من دون الله وليا ولا نصيرا @QE@ فقال رسول الله صلي الله عليه وسلم : يا ابا بكر الا اقرءك اية نزلت علي قلت : بلي يا رسول الله فاقرانيها فلا اعلم الا اني وجدت انقصاما في ظهري حتي تمطيت لها فقال رسول الله صلي الله عليه وسلم : مالك يا ابا بكر قلت : بابي وامي يا رسول الله واينا لم يعمل السوء وانا لمجزيون بكل سوء عملناه فقال رسول الله صلي الله عليه وسلم : اما انت واصحابك يا ابا بكر المءمنون فتجزون بذلك في الدينا حتي تلقوا الله ليس لكم ذنوب واما الاخرون فيجمع لهم ذلك حتي يجزوا به يوم القيامة
 واخرج ابن جرير عن عاءشة عن ابي بكر قال : لما نزلت @QB@ من يعمل سوءا يجز به @QE@ قال ابو بكر : يا رسول الله كل ما نعمل نءاخذ به فقال : يا ابا بكر اليس يصيبك كذا وكذا

 فهو كفارة
 واخرج سعيد بن منصور وهناد وابن جرير وابو نعيم في الحلية وابن مردويه عن مسروق قال : قال ابو بكر : يا رسول الله ما اشد هذه الاية @QB@ من يعمل سوءا يجز به @QE@  فقال رسول الله صلي الله عليه وسلم : المصاءب والامراض والاحزان في الدينا جزاء
 واخرج سعيد بن منصور واحمد والبخاري في تاريخه وابو يعلي وابن جرير والبيهقي في شعب الايمان بسند صحيح عن عاءشة ان رجلا تلا هذه الاية @QB@ من يعمل سوءا يجز به @QE@ قال : انا لنجزي بكل ما عملناه هلكنا اذن فبلغ ذلك رسول الله صلي الله عليه وسلم قال : نعم يجزي به المءمن في الدينا في نفسه في جسده فيما يءذيه
 واخرج ابو داود وابن جرير وابن ابي حاتم وابن مردويه والبيهقي عن عاءشة قالت : قلت : يا رسول الله اني لاعلم اشد اية في القران قال : ما هي يا عاءشة قلت : @QB@ من يعمل سوءا يجز به @QE@ فقال : هو ما يصيب العبد من السوء حتي النكبة ينكبها يا عاءشة من نوقش هلك ومن حوسب عذب
 فقلت : يا رسول الله اليس الله يقول ( فسوف يحاسب حسابا يسيرا ) قال : ذاك العرض يا عاءشة من نوقش الحساب عن هذه الاية @QB@ من يعمل سوءا يجز به @QE@ قال : ان المءمن يءجر في كل شء حتي في الغط عند الموت
 واخرج احمد عن عاءشة قالت : قال رسول الله صلي الله عليه وسلم : اذا كثرت ذنوب العبد ولم يكن له ما يكفرها ابتلاه الله بالحزن ليكفرها
 واخرج ابن راهويه في مسنده وعبد بن حميد وابن جرير والحاكم وصححه عن ابي المهلب قال : رحلت الي عاءشة في هذه الاية @QB@ من يعمل سوءا يجز به @QE@ قالت : هو ما يصيبكم في الدينا
 واخرج سعيد بن منصور وابن ابي شيبة ومسلم والترمذي والنساءي وابن جرير وابن المنذر وابن مردويه والبيهقي في سننه عن ابي هريرة قال : لما نزلت @QB@ من يعمل سوءا يجز به @QE@ شق ذلك علي المسلمين وبلغت منهم ما شاء الله فشكوا ذلك الي رسول الله صلي الله عليه وسلم فقال : سددوا وقاربوا فان في كل ما اصاب المسلم كفارة حتي الشوكة يشاكها والنكبة ينكبها
 وفي لفظ عند ابن مردويه : بكينا وحزنا وقلنا : يا رسول الله ما ابقت هذه الاية من شء قال : اما والذي نفسي بيده انها لكما نزلت ولكن ابشروا وقاربوا وسددوا انه لا يصيب احد منكم من مصيبة في الدينا الا كفر الله بها خطيءته حتي الشوكة يشاكها احدكم في قدمه
 واخرج ابن ابي شيبة واحمد والبخاري ومسلم عن ابي هريرة وابي سعيد انهما  سمعا رسول الله صلي الله عليه وسلم يقول : ما يصيب المءمن من وصب ولا نصب ولا سقم ولا حزن حتي الهم يهمه الا كفر الله به من سيءاته
 واخرج احمد ومسدد وابن ابي الدينا في الكفارات وابو يعلي وابن حبان والطبراني في الاوسط والحاكم وصححه والبيهقي عن ابي سعيد قال : قال رجل : يا رسول الله ارايت هذه الامراض التي تصيبنا ما لنا بها قال : كفارات
 قال ابي : وان قلت قال : وان شوكة فما فوقها
 واخرج ابن راهويه في مسنده عن محمد بن المنتشر قال : قال رجل لعمر ابن الخطاب : اني لا اعرف اشد اية في كتاب الله
 فاهوي عمر فضربه بالدرة وقال : مالك نقبت عنها فانصرف حتي كان الغد قال له عمر : الاية التي ذكرت بالامس فقال @QB@ من يعمل سوءا يجز به @QE@ فما منا احد يعمل سوءا الا جزي به
 فقال عمر : لبثنا حين نزلت ما ينفعنا طعام ولا شراب حتي انزل الله بعد ذلك ورخص وقال : ( ومن يعمل سوءا او يظلم نفسه ثم يستغفر الله يجد الله غفورا رحيما ) ( النساء الاية  )
 واخرج الطيالسي واحمد والترمذي وحسنه والبيهقي عن امية بنت عبد الله قالت : سالت عاءشة عن هذه الاية @QB@ من يعمل سوءا يجز به @QE@ فقالت : لقد سالتني عن شء ما سالني عنه احد بعد ان سالت عنه رسول الله صلي الله عليه وسلم سالت رسول الله صلي الله عليه وسلم فقال : يا عاءشة هذه مبايعة الله العبد بما يصيبه من الحمي والحزن والنكبة حتي البضاعة يضعها في كمه فيفقدها فيفزع لها فيجدها تحت ضبنه حتي ان العبد ليخرج من ذنوبه كما يخرج التبر الاحمر من الكير
 واخرج عبد بن حميد وابن ابي الدينا وابن جرير والبيهقي عن زياد بن الربيع قال : قلت لابي بن كعب : اية في كتاب الله قد احزنتني قال : ما هي قلت @QB@ من يعمل سوءا يجز به @QE@ قال : ما كنت اراك الا افقه مما اري ان المءمن لا تصيبه مصيبة عثرة قدم ولا اختلاج عرق ولا نحبة نملة الا بذنب وما يعفوه الله عنه اكثر حتي اللدغة والنفحة
 واخرج هناد وابو نعيم في الحلية عن ابراهيم بن مرة قال : جاء رجل الي ابي فقال :  يا ابا المنذر اية في كتاب الله قد غمتني قال : اي اية قال @QB@ من يعمل سوءا يجز به @QE@ قال : ذاك العبد المءمن ما اصابته من نكبة مصيبة فيصبر فليقي الله عز وجل ولا ذنب له
 واخرج ابن جرير عن عطاء بن ابي رباح قال : لما نزلت @QB@ من يعمل سوءا يجز به @QE@ قال ابو بكر : جاءت قاصمة الظهر
 فقال رسول الله صلي الله عليه وسلم : انما هي المصيبات في الدينا
 واخرج ابن المنذر عن ابن عباس ان ابن عمر لقيه حزينا فساله عن هذه الاية @QB@ ليس بامانيكم ولا اماني اهل الكتاب من يعمل سوءا يجز به @QE@ فقال : ما لكم ولهذه انما هذه للمشركين قريش واهل الكتاب
 واخرج ابن جرير وابن المنذر عن ابن عباس @QB@ من يعمل سوءا يجز به @QE@ يقول من يشرك يجز به وهو السوء @QB@ ولا يجد له من دون الله وليا ولا نصيرا @QE@ الا ان يتوب قبل موته فيتوب الله عليه
 واخرج سعيد بن منصور وابن ابي شيبة وهناد والحكيم الترمذي والبيهقي عن الحسن في قوله @QB@ من يعمل سوءا يجز به @QE@ قال : انما ذاك لمن اراد الله هوانه فاما من اراد الله كرامته فانه يتجاوز عن سيءاته في اصحاب الجنة وعد الصدق الذي كانوا يوعدون
 واخرج البيهقي عن انس قال : اتي رسول الله صلي الله عليه وسلم شجرة فهزها حتي تساقط من ورقها ما شاء الله ان يتساقط ثم قال : الاوجاع والمصيبات اسرع في ذنوب بني ادم مني في هذه الشجرة
 واخرج ابن ابي شيبة وعبد بن حميد عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : لا يزال البلاء بالمءمن والمءمنة في نفسه وفي ولده وماله حتي يلقي الله وما عليه من خطيءة
 واخرج احمد عن الساءب بن خلاد ان  رسول الله صلي الله عليه وسلم قال : ما من شء يصيب المءمن حتي الشوكة تصيبه الا كتب الله له بها حسنة وحط عنه بها خطيءة
 واخرج احمد والبخاري ومسلم عن عاءشة قالت : قال النبي صلي الله عليه وسلم : ما من مصيبة تصيب المسلم الا كفر الله بها عنه حتي الشوكة يشاكها
 واخرج ابن ابي شيبة واحمد ومسلم والحكيم الترمذي عن عاءشة قالت : قال رسول الله صلي الله عليه وسلم : لا يصيب المءمن شوكة فما فوقها الا رفعه الله بها درجة وحط عنه بها خطيءة
 واخرج احمد عن عاءشة ان رسول الله صلي الله عليه وسلم طرقه وجع فجعل يشتكي ويتقلب علي فراشه فقالت عاءشة : لو صنع هذا بعضنا لوجدت عليه فقال النبي صلي الله عليه وسلم : ان الصالحين يشدد عليهم وانه لا يصيب مءمنا نكبة من شوكة فما فوق ذلك الا حطت به عنه خطيءة ورفع له بها درجة
 واخرج احمد والبخاري ومسلم والترمذي عن ابي سعيد الخدري قال : قال رسول الله صلي الله عليه وسلم : ما يصيب المءمن من نصب ولا وصب ولا هم ولا حزن ولا اذي ولا غم حتي الشوكة يشاكها الا كفر الله من خطاياه
 واخرج احمد وهناد في الزهد معا عن ابي بكر الصديق قال : ان المسلم ليءجر في كل شء حتي في النكبة وانقطاع شسعه والبضاعة تكون في كمه فيفقدها فيفزع لها فيجدها في ضبنه
 واخرج ابن ابي شيبة عن سعد بن ابي وقاص قال : قلت : يا رسول الله اي الناس اشد بلاء قال : النبيون ثم الامثل من الناس فما يزال بالعبد البلاء حتي يلقي الله وما عليه من خطيءة
 واخرج ابن ابي شيبة واحمد والبيهقي عن معاوية : سمعت رسول الله صلي الله عليه وسلم يقول : ما من شء يصيب المءمن في جسده يءذيه الا كفر الله عنه به من سيءاته
 واخرج ابن ابي الدنيا والبيهقي عن ابي سعيد الخدري قال : قال رسول الله صلي الله عليه وسلم : صداع المءمن او شوكة يشاكها او شء يءذيه يرفعه الله بها يوم القيامة درجة ويكفر عنه بها ذنوبه
 واخرج ابن ابي الدنيا والبيهقي عن بريدة الاسلمي سمعت رسول الله صلي الله عليه وسلم يقول : ما اصاب رجلا من المسلمين نكبة فما فوقها  حتي ذكر الشوكة  الا لاحدي خصلتين : الا ليغفر الله من الذنوب ذنبا لم يكن ليغفر الله له الا بمثل ذلك او يبلغ به من الكرامة كرامة لم يكن يبلغها الا بمثل ذلك
 واخرج ابن ابي شيبة والبيهقي عن ابن مسعود قال : ان الوجع لا يكتب به الاجر انما الاجر في العمل ولكن يكفر الله به الخطايا
 واخرج ابن سعد والبيهقي عن عبد الله بن اياس بن ابي فاطمة عن ابيه عن جده  عن رسول الله صلي الله عليه وسلم قال : ايكم يحب ان يصح فلا يسقم قالوا : كلنا يا رسول الله قال : اتحبون ان تكونوا كالحمير الضالة
 وفي لفظ : الصيالة الا تحبون ان تكونوا اصحاب بلاء واصحاب كفارات والذي نفسي بيده ان الله ليبتلي المءمن وما يبتليه الا لكرامته عليه وان العبد لتكون له الدرجة في الجنة لا يبلغها بشء من عمله حتي يبتليه بالبلاء ليبلغ به تلك الدرجة
 واخرج احمد وابن ابي الدينا والبيهقي عن محمد بن خالد السلمي عن ابيه عن جده وكانت له صحبة قال : سمعت رسول الله صلي الله عليه وسلم يقول : اذا سبقت للعبد من الله منزلة لم يبلغها بعمله ابتلاه الله في جسده او في ماله او في ولده ثم صبره حتي يبلغه المنزلة التي سبقت له من الله
 واخرج البيهقي عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : ان الرجل لتكون له المنزلة عند الله فما يبلغها بعمل فما يزال يبتليه بما يكره حتي يبلغه ذلك
 واخرج البيهقي من طريق احمد بن ابي الحواري قال : سمعت ابا سليمان يقول : مر موسي عليه السلام علي رجل في متعبد له ثم مر به بعد ذلك وقد مزقت السباع لحمه فراس ملقي وفخذ ملقي وكبد ملقي فقال موسي : يا رب عبدك كان يطيعك فابتليه بهذا فاوحي الله اليه : يا موسي انه سالني درجة لم يبلغها بعمله فابتليه بهذا لابلغه بذلك الدرجة
 واخرج البيهقي عن عاءشة : سمعت رسول الله صلي الله عليه وسلم يقول : ما ضرب من مءمن عرق الا حط الله به عنه خطيءة وكتب له به حسنة ورفع له به درجة
 واخرج البيهقي عن ابي هريرة : سمعت رسول الله صلي الله عليه وسلم يقول : ان الله ليبتلي عبده بالسقم حتي يكفر كل ذنب
 واخرج البيهقي عن عبد الله بن عمرو قال : قال رسول الله صلي الله عليه وسلم : من صدع في سبيل الله ثم احستب غفر الله له ما كان قبل ذلك من ذنب
 واخرج ابن ابي الدينا والبيهقي عن يزيد بن ابي حبيب قال : قال رسول الله صلي الله عليه وسلم : لا يزال الصداع والمليلة بالمرء المسلم حتي يدعه مثل الفضة البيضاء
 واخرج ابن ابي الدينا والبيهقي عن عامر اخي الخضر قال : اني لبارض محارب اذا رايات والوية فقلت : ما هذا قالوا : رسول الله صلي الله عليه وسلم
 فجلست اليه وهو في ظل شجرة قد بسط له كساء وحوله اصحابه فذكروا الاسقام فقال : ان العبد  المءمن اذا اصابه سقم ثم عافاه الله كان كفارة لما مضي من ذنوبه وموعظة له فيما يستقبل من عمره وان المنافق اذا مرض وعوفي كان كالبعير عقله اهله ثم اطلقوه لا يدري فيما عقلوه ولا فيما اطلقوه
 فقال رجل : يا رسول الله ما الاسقام قال : او ما سقمت قط قال : لا
 قال : فقم عنا فلست منا
 واخرج البيهقي عن ابي امامة عن رسول الله صلي الله عليه وسلم قال : ما من عبد يصرع صرعة من مرض الا بعثه منه طاهرا
 واخرج ابن ابي الدينا والبيهقي عن ابي امامة قال : قال رسول الله صلي الله عليه وسلم : ان العبد اذا مرض اوحي الله الي ملاءكته : يا ملاءكتي اذا قيدت عبدي بقيد من قيودي فان اقبضه اغفر له وان اعافه فجسده مغفور لا ذنب له
 وقال رسول الله صلي الله عليه وسلم : ان الله ليجرب احدكم بالبلاء  وهو اعلم  كما يجرب احدكم ذهبه بالنار فمنهم من يخرج كالذهب الابريز فذلك الذي نجاه الله من السيءات ومنهم من يخرج كالذهب دون ذلك فذلك الذي يشك بعض الشك ومنهم من يخرج كالذهب الاسود فذلك الذي قد افتتن
 واخرج ابن ابي الدينا والبيهقي من طريق بشير بن عبد الله بن ابي ايوب الانصاري عن ابيه عن جده قال : عاد رسول الله صلي الله عليه وسلم رجلا من الانصار فاكب عليه فساله فقال : يا نبي الله ما غمضت منذ سبع ليال ولا احد يحضرني
 فقال رسول الله صلي الله عليه وسلم : اي اخي اصبر اي اخي اصبر تخرج من ذنوبك كما دخلت فيها فقال رسول الله صلي الله عليه وسلم : ساعات الامراض يذهبن ساعات الخطايا
 واخرج ابن ابي الدينا والبيهقي عن الحسن قال : قال رسول الله صلي الله عليه وسلم : ساعات الاذي يذهبن ساعات الخطايا
 واخرج البيهقي عن الحكم بن عتبة رفعه قال : اذا كثرت ذنوب العبد ولم يكن له من العمل ما يكفر ذنوبه ابتلاه الله بالهم يكفر به ذنوبه
 واخرج ابن عدي والبيهقي وضعفه عن ابن عمر قال : قال رسول الله صلي الله عليه وسلم : ان الله ليبتلي عبده بالبلاء والالم حتي يتركه من ذنبه كالفضة المصفاة
 واخرج البيهقي عن المسيب بن رافع ان ابا بكر الصديق قال : ان المرء المسلم يمشي في الناس وما عليه خطيءة
 قيل : ولم ذلك يا ابا بكر قال : بالمصاءب والحجر والشوكة والسشع ينقطع
  واخرج احمد عن ابي الدرداء سمعت رسول الله صلي الله عليه وسلم يقول : ان الصداع والمليلة لا يزال بالمءمن وان ذنبه مثل احد فما يتركه وعليه من ذلك مثقال حبة من خردل
 واخرج احمد عن خالد بن عبد الله القسري عن جده يزيد بن اسد انه سمع النبي صلي الله عليه وسلم يقول : المريض تحات خطاياه كما يتحات ورق الشجر
 واخرج ابن ابي شيبة عن ابي الدرداء قال : ما يسرني بليلة امرضها حمر النعم
 واخرج ابن ابي شيبة عن عياض بن غضيف قال : دخلنا علي ابي عبيدة بن الجراح نعوده فاذا وجهه مما يلي الجدار وامراته قاعدة عند راسه قلت : كيف بات ابو عبيدة قالت : بات باجر
 فاقبل علينا بوجهه فقال : اني لم ابت باجر ومن ابتلاه الله ببلاء في جسده فهو له حطة
 واخرج ابن ابي شيبة عن سلمان قال : ان المءمن يصيبه الله بالبلاء ثم يعافيه فيكون كفارة لسيءاته ومستعتبا فيما بقي وان الفاجر يصيبه الله بالبلاء ثم يعافيه فيكون كالبعير عقله اهله لا يدري لم عقلوه ثم ارسلوه فلا يدري لم ارسلوه
 واخرج ابن ابي شيبة عن عمار انه كان عنده اعرابي فذكروا الوجع فقال عمار : ما اشتكيت قط قال : لا
 فقال عمار : لست منا ما من عبد يبتلي الا حط عنه خطاياه كما تحط الشجرة ورقها وان الكافر يبتلي فمثله مثل البعير عقل فلم يدر لم عقل واطلق فلم يدر لم اطلق
 واخرج ابن جرير وابن ابي حاتم عن ابن عباس في قوله @QB@ من يعمل سوءا يجز به @QE@ قال : الشرك
 واخرج ابن جرير عن سعيد بن جبير
 مثله
