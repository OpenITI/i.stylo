 اخرج عبد الرزاق والفريابي وعبد بن حميد وابن ابي حاتم عن علي رضي الله عنه في قوله : @QB@ فاخلع نعليك @QE@ قال : كانتا من جلد حمار ميت فقيل له اخعلهما
 واخرج عبد بن حميد عن الحسن رضي الله عنه قال : ما بال خلع النعلين في الصلاة انما امر موسي بخلع نعليه انهما كانتا من جلد حمار ميت
  واخرج عبد بن حميد عن كعب رضي الله عنه في قوله : @QB@ فاخلع نعليك @QE@ قال : كان نعلا موسي من جلد حمار ميت فاراد ربك ان يمسه القدس كله
 واخرج ابن ابي حاتم الزهري في قوله : @QB@ فاخلع نعليك @QE@ قال : كانتا من جلد حمار اهلي
 واخرج ابن ابي حاتم عن مجاهد رضي الله عنه قال : كانت نعلا موسي التي قيل له اخعلهما : من جلد خنزير
 واخرج عبد بن حميد وابن ابي حاتم عن عكرمة رضي الله عنه في قوله : @QB@ فاخلع نعليك @QE@ قال كي تمس راحة قدميك الارض الطيبة
 واخرج الطبراني عن علقمة ان ابن مسعود اتي ابا موسي الاشعري منزله فحضرت الصلاة فقال ابو موسي رضي الله عنه :  تقدم يا ابا عبد الرحمن فانك اقدم سنا واعلم
 قال : لا
 بل تقدم انت فانما اتيناك في منزلك فتقدم ابو موسي رضي الله عنه فخلع نعليه فلما صلي قال له ابن مسعود رضي الله عنه :  لم خلعت نعليك ابالواد المقدس انت لقد رايت رسول الله صلي الله عليه وسلم يصلي في الخفين والنعلين
 واخرج ابن المنذر وابن ابي حاتم عن ابن عباس رضي الله عنهما في قوله : @QB@ انك بالواد المقدس @QE@ قال : المبارك @QB@ طوي @QE@ قال : اسم الوادي
  واخرج ابن ابي حاتم عن عكرمة  رضي الله عنه  في قوله : @QB@ بالواد المقدس @QE@ قال : الطاهر
 واخرج ابن ابي حاتم عن الحسن رضي الله عنه في قوله : @QB@ بالواد المقدس @QE@ قال : واد بلفلسطين قدس مرتين
 واخرج ابن ابي حاتم عن ابن عباس  رضي الله عنهما  في قوله : @QB@ بالواد المقدس طوي @QE@ يعني الارض المقدسي وذلك انه مر بواديها ليلا فطوي
 يقال : طويت وادي كذا وكذا والطاوي من الليل وارتفع الي اعلي الوادي وذلك نبي الله موسي عليه السلام
 واخرج ابن ابي شيبة وعبد بن حميد وابن المنذر عن مجاهد رضي الله عنه في قوله : @QB@ انك بالواد المقدس @QE@ قال : المبارك : @QB@ طوي @QE@ قال : اسم الوادي
 واخرج ابن ابي حاتم عن مبشر بن عبيد @QB@ طوي @QE@ بغير نون واد بايلة زعم انه طوي بالبركة مرتين
 واخرج ابن جرير عن ابن عباس رضي الله عنهما في قوله : @QB@ طوي @QE@ قال : طا الوادي
 واخرج عبد بن حميد وابن المنذر وابن ابي حاتم عن ابن ابي نجيح رضي الله عنه في قوله : @QB@ طوي @QE@ قال طا الارض حافيا كما تدخل الكعبة حافيا
 يقول : من بركة الوادي هذا قول سعيد بن جبير
 قال : وكان مجاهد رضي الله عنه يقول : @QB@ طوي @QE@ اسم الوادي
 واخرج عبد بن حميد عن قتادة رضي الله عنه في قوله : @QB@ بالواد المقدس طوي @QE@ قال : واد قدس مرتين واسمه @QB@ طوي @QE@
 واخرج عبد بن حميد عن عاصم انه قرا @QB@ طوي @QE@ برفع الطاء وبنون فيها
 واخرج ابو الشيخ عن ابن عباس  رضي الله عنهما : ان رسول الله صلي الله عليه وسلم قال : مكتوب علي باب الجنة : انني انا الله لا اله الا انا لا اعذب من قالها
 واخرج ابن سعد وابو يعلي والحاكم والبيهقي في الدلاءل عن انس رضي الله عنه قال : خرج عمر متقلدا بالسيف فاقيه رجل من بني زهرة فقال له : اين تغدو يا عمر قال : اريد ان اقتل محمدا
 قال : وكيف تامن بني هاشم وبني زهرة فقال له عمر : ما اراك الا قد صبات وتركت دينك قال : افلا ادلك علي العجب ان اختك وختنك قد صبا وتركا دينك فمشي عمرا زاءرا حتي اتاهما وعندهما خباب فلما سمع خباب بحس عمر تواري في البيت فدخل عليهما فقال : ما هذه الهينمة التي سمعتها عندكم وكانوا يقراون @QB@ طه @QE@ فقالا : ما عدا حديثا تحدثنا به
 قال : فلعلكما قد صباتما
 فقال له خنته : يا عمر ان كان الحق في غير دينك فوثب عمر علي خنته فوطءه وطا شديدا : فجاءت اخته لتدفعه عن زوجها فنفخها نفخة بيده فدمي وجهها
 فقال عمر : اعطوني الكتاب الذي هو عندكم فاقراه فقالت اخته : انك رجس وانه ( لا يمسه الا المطهرون ) ( الواقعة اية  ) فقم فتوضا فقام فتوضا ثم اخذ الكتاب فقرا @QB@ طه @QE@ حتي انتهي الي @QB@ انني انا الله لا اله الا انا فاعبدني واقم الصلاة لذكري @QE@  فقال عمر : دلوني علي محمد فلما سمع خباب قول عمر خرج من البيت فقال : ابشر يا عمر فاني ارجو ان تكون دعوة رسول الله صلي الله عليه وسلم لك  ليلة الخميس  اللهم اعز الاسلام بعمر بن الخطاب او بعمر بن هشام فخرج حتي اتي رسول الله صلي الله عليه وسلم
 واخرج ابو نعيم في الحلية عن علي بن ابي طالب رضي الله عنه قال : حدثنا رسول الله صلي الله عليه وسلم عن جبريل عليه السلام قال : قال الله عز وجل @QB@ انني انا الله لا اله الا انا فاعبدني @QE@ من جاءني منكم بشهادة ان لا اله الا الله بالاخلاص دخل حصني ومن دخل حصني امن عذابي
 واخرج ابن ابي شيبة وعبد بن حميد وابن المنذر وابن ابي حاتم عن مجاهد رضي الله عنه في قوله : @QB@ واقم الصلاة لذكري @QE@ قال : اذا صلي عبد ذكر ربه
 واخرج عبد بن حميد عن ابراهيم في قوله : @QB@ واقم الصلاة لذكري @QE@ قال : حين تذكر
 واخرج احمد وعبد بن حميد والبخاري ومسلم وابو داود وابن مردويه عن انس : ان رسول الله صلي الله عليه وسلم قال : اذا رقد احدكم عن الصلاة او غفل عنها فليصلها اذا ذكرها فان الله قال اقم الصلاة لذكري
 واخرج الترمذي وابن ماجة وابن المنذر وابن ابي حاتم وابن حبان وابن مردويه عن ابي هريرة رضي الله عنه قال : لما قفل رسول الله صلي الله عليه وسلم من خيبر اسري ليلة حتي ادركه الكري اناخ فعرس ثم قال : يا بلال اكلانا الليلة قال : فصلي بلال ثم تساند الي راحلته مستقبل الفجر فغلبته عيناه فنام فلم يستيقظ احد منهم حتي ضربتهم الشمس وكان اولهم استيقاظا النبي صلي الله عليه وسلم فقال : اي بلال فقال بلال : بابي انت يا رسول الله اخذ بنفسي الذي اخذ بنفسك فقال رسول الله صلي الله عليه وسلم : اقتادوا ثم اناخ فتوضا واقام الصلاة ثم صلي مثل صلاته للوقت في تمكث ثم قال : من نسي صلاة فليصلها اذا ذكرها فان الله قال : @QB@ واقم الصلاة لذكري @QE@ وكان ابن شهاب يقرءها للذكري
 واخرج الطبراني وابن مردويه عن عبادة بن الصامت قال : سءل رسول الله صلي الله عليه وسلم عن رجل غفل عن الصلاة حتي طلعت الشمس او غربت ما  كفارتها قال : يتقرب الي الله ويحسن وضوءه ويصلي الصلاة ويستغفر الله فلا كفارة لها الا ذلك ان الله يقول : @QB@ واقم الصلاة لذكري @QE@
 واخرج سعيد بن منصور وابن المنذر عن سمرة بن يحيي قال : نسيت صلاة العتمة حتي اصبحت فغدوت الي ابن عباس فاخبرته فقال : قم فصلها ثم قرا @QB@ واقم الصلاة لذكري @QE@
 واخرج عبد بن حميد عن ابن عباس رضي الله عنهما قال : اذا نسيت صلاة فاقضها متي ذكرت
 واخرج ابن ابي شيبة عن الشعبي وابراهيم في قوله : @QB@ واقم الصلاة لذكري @QE@
 قالا : صلها اذا ذكرتها وقد نسيتها
 واخرج ابن ابي شيبة عن ابراهيم قال : من نام عن صلاة او نسيها يصلي متي ذكرها عند طلوع الشمس وعند غروبها ثم قرا @QB@ واقم الصلاة لذكري @QE@ قال : اذا ذكرتها فصلها في اي ساعة كنت
 واخرج ابن ابي شيبة عن عبد الله بن مسعود رضي الله عنه قال : اقبلنا مع رسول الله صلي الله عليه وسلم من الحديبية فنزلنا دهاسا من الارض  والدهاس الرمل  فقال رسول الله صلي الله عليه وسلم : من يكلءنا قال بلال : انا فناموا حتي طلعت عليهم الشمس فقال النبي صلي الله عليه وسلم : افعلوا كما كنتم تفعلون كذلك لمن نام او نسي
 واخرج ابن ابي شيبة عن ابي جحيفة قال : كان رسول الله صلي الله عليه وسلم في سفره الذي ناموا فيه حتي طلعت الشمس ثم قال : انكم كنتم امواتا فرد الله اليكم ارواحكم فمن نام عن الصلاة او نسي صلاة فليصلها اذا ذكرها واذا استيقظ
