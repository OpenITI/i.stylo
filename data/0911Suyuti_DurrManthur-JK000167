 اخرج ابن جرير وابن ابي حاتم عن ابن عباس رضي الله عنهما في قوله @QB@ قل يا عبادي الذين اسرفوا علي انفسهم @QE@ في مشركي اهل مكة
 واخرج ابن جرير وابن المنذر والطبراني والحاكم وصححه وابن مردويه والبيهقي في الدلاءل عن ابن عمر رضي الله عنهما [ ] فكتبتها بيدي ثم بعثت الي هشام بن العاصي
 واخرج الطبراني وابن مردويه والبيهقي في شعب الايمان بسند لين عن ابن عباس رضي الله عنهما قال : بعث رسول الله صلي الله عليه وسلم الي وحشي بن حرب قاتل حمزة يدعوه الي الاسلام فارسل اليه : يا محمد كيف تدعوني وانت تزعم ان من قتل او اشرك او زني ( يلق اثاما ) ( يضاعف له العذاب يوم القيامة ويخلد فيه مهانا ) ( الفرقان  ) وانا صنعت ذلك فهل تجد لي من رخصة فانزل الله ( الا من تاب وامن وعمل عملا صالحا فاولءك يبدل الله سيءاتهم حسنات وكان الله غفورا رحيما ) ( الفرقان  ) فقال وحشي : هذا شرط شديد ( الا من تاب وامن وعمل عملا صالحا ) ( الفرقان  ) فلعلي لا اقدر علي هذا
 فانزل الله ( ان الله لا يغفر ان يشرك به ويغفر ما دون ذلك لمن يشاء ) ( النساء  ) فقال وحشي : هذا اري بعد مشيءة فلا يدري يغفر لي ام لا فهل غير هذا فانزل الله @QB@ يا عبادي الذين اسرفوا علي انفسهم @QE@ الاية قال وحشي : هذا فهم
 فاسلم فقال الناس : يا رسول الله : انا اصبنا ما اصاب وحشي قال : بلي للمسلمين عامة
 واخرج ابن ابي حاتم وابن مردويه عن ابي سعيد قال : لما اسلم وحشي انزل الله ( والذين لا يدعون مع الله الها اخر ولا يقتلون النفس التي حرم الله الا بالحق ) ( الفرقان  ) قال وحشي واصحابه : فنحن قد ارتكبنا هذا كله
 فانزل الله @QB@ قل يا عبادي الذين اسرفوا علي انفسهم @QE@ الاية
 واخرج محمد بن نصر في كتاب الصلاة عن وحشي قال : لما كان في امر حمزة  ما كان القي الله خوف محمد صلي الله عليه وسلم في قلبي خرجت هاربا اكمن النهار واسير الليل حتي صرت الي اقاويل حمير فنزلت فيهم فاقمت حتي اتاني رسول رسول الله صلي الله عليه وسلم يدعوني الي الاسلام قلت : وما الاسلام قال : تءمن بالله ورسوله وتترك الشرك بالله وقتل النفس التي حرم الله وشرب الخمر والزنا والفواحش كلها وتستحم من الجنابة وتصلي الخمس
 قال : ان الله قد انزل هذه الاية @QB@ يا عبادي الذين اسرفوا علي انفسهم @QE@ فقلت : اشهد ان لا اله الا الله وان محمدا عبده ورسوله فصافحني وكناني بابي حرب
 واخرج البخاري في الادب المفرد عن ابي هريرة قال : خرج النبي صلي الله عليه وسلم علي رهط من اصحابه يضحكون فقال : والذي نفسي بيده لو تعلمون ما اعلم لضحكتم قليلا ولبكيتم كثيرا
 ثم انصرف وبكي القوم فاوحي الله اليه : يا محمد لم تقنط عبادي فرجع النبي صلي الله عليه وسلم وقال : ابشروا وقربوا وسددوا
 واخرج ابن مردويه والبيهقي في سننه عن عمر بن الخطاب قال : اتفقت انا وعياش بن ابي ربيعة وهشام بن العاصي بن واءل ان نهاجر الي المدينة
 فخرجت انا وعياش بن ابي ربيعة وهشام بن العاصي بن واءل ان نهاجر الي المدينة
 فخرجت انا وعياش وفتن هشام فافتتن فقدم علي عياش اخوه ابو جهل والحارث بن هشام فقالا : ان امك قد نذرت ان لا يظلها ظل ولا يمس راسها غسل حتي تراك
 فقلت : والله ان يريداك الا ان يفتناك عن دينك وخرجا به
 وفتنوه فافتتن قال : فنزلت @QB@ يا عبادي الذين اسرفوا علي انفسهم لا تقنطوا من رحمة الله @QE@ قال : عمر رضي الله عنه : فكتبت الي هشام فقدم
 واخرج ابن جرير وابن مردويه عن ابن عباس في قوله @QB@ يا عبادي الذين اسرفوا علي انفسهم لا تقنطوا من رحمة الله @QE@ وذلك ان اهل مكة قالوا : يزعم محمد ان من عبد الاوثان ودعا مع الله الها اخر وقتل النفس التي حرم الله لم يغفر له فكيف نهاجر ونسلم وقد عبدنا الالهة وقتلنا النفس ونحن اهل الشرك فانزل الله @QB@ يا عبادي الذين اسرفوا علي انفسهم لا تقنطوا من رحمة الله ان الله يغفر الذنوب جميعا @QE@ وقال ( وانيبوا الي ربكم واسلموا له ) وانما يعاتب الله اولي الالباب وانما الحلال والحرام لاهل الايمان فاياهم عاتب واياهم امر اذا اسرف احدهم علي نفسه ان لا يقنط من رحمة الله وان يتوب ولا يضن بالتوبة علي لك الاسراف  والذنب الذي عمل وقد ذكر الله تعالي في سورة ال عمران المءمنين حين سالوا المغفرة فقالوا : ( ربنا اغفر لنا ذنوبنا واسرافنا في امرنا ) ( ال عمران  ) فينبغي ان يعلم انهم كانوا يصيبون الامرين فامرهم بالتوبة
 واخرج ابن جرير عن عطاء بن يسار قال : نزلت هذه الايات الثلاث بالمدينة في وحشي واصحابه @QB@ يا عبادي الذين اسرفوا علي انفسهم @QE@ الي قوله ( وانتم لا تشعرون ) ( النساء  )
 واخرج ابن جرير عن ابن عمر قال : نزلت هذه الاية في عياش بن ابي ربيعة والوليد بن الوليد ونفر من المسلمين كانوا اسلموا ثم فتنوا وعذبوا فافتتنوا فكنا نقول : لا يقبل الله من هءلاء صرفا ولا عدلا ابدا
 اقوام اسلموا ثم تركوا دينهم بعذاب عذبوه فنزلت هءلاء الايات وكان عمر بن الخطاب كاتبا فكتبها بيده ثم كتب بها الي عياش والوليد والي اولءك النفر
 فاسلموا وهاجروا
 واخرج احمد وابن جرير وابن ابي حاتم وابن مردويه والبيهقي في شعب الايمان عن ثوبان قال : سمعت رسول الله صلي الله عليه وسلم يقول : ما احب ان لي الدنيا وما فيها بهذه الاية @QB@ يا عبادي الذين اسرفوا علي انفسهم @QE@ الي اخر الاية
 فقال رجل : يا رسول الله فمن اشرك فسكت النبي صلي الله عليه وسلم قال : الا ومن اشرك ثلاث مرات
 واخرج احمد وعبد بن حميد وابو داود والترمذي وحسنه وابن المنذر وابن الانباري في المصاحف والحاكم وابن مردويه عن اسماء بنت يزيد سمعت رسول الله صلي الله عليه وسلم يقرا @QB@ يا عبادي الذين اسرفوا علي انفسهم لا تقنطوا من رحمة الله ان الله يغفر الذنوب جميعا @QE@ ولا يبالي انه هو الغفور الرحيم
 واخرج ابن ابي شيبة وعبد بن حميد وابن ابي الدنيا في حسن الظن وابن جرير وابن ابي حاتم والطبراني والبيهقي في شعب الايمان عن ابن مسعود انه مر علي قاص يذكر الناس فقال : يا مذكر الناس لا تقنط الناس ثم قرا @QB@ يا عبادي الذين اسرفوا علي انفسهم لا تقنطوا من رحمة الله @QE@
 واخرج ابن جرير عن ابن سيرين قال : قال علي اي اية اوسع فجعلوا يذكرون ايات من القران ( من يعمل سوء او يظلم نفسه ) ( النساء  )
 ونحوها
 فقال علي  رضي الله عنه : ما في القران اوسع اية من @QB@ يا عبادي الذين اسرفوا علي انفسهم @QE@
 واخرج ابن جرير وابن المنذر عن ابن عباس رضي الله عنهما في قوله @QB@ يا عبادي الذين اسرفوا علي انفسهم @QE@
 قد دعا الله الي مغفرته من زعم ان المسيح هو الله ومن زعم ان المسيح ابن الله ومن زعم ان عزيرا ابن الله ومن زعم ان الله فقير ومن زعم ان يد الله مغلولة ومن زعم ان الله ثالث ثلاثة
 يقول الله تعالي لهءلاء ( افلا يتوبون الي الله ويستغفرونه والله غفور رحيم ) ( الماءدة  ) ثم دعا الي توبته من هو اعظم قولا من هءلاء
 من قال ( انا ربكم الاعلي ) ( النازعات  ) وقال ( ما علمت لكم من اله غيري ) ( القصص  ) قال ابن عباس رضي الله عنهما : من ايس العباد من التوبة بعد هذا فقد جحد كتاب الله ولكن لا يقدر العبد ان يتوب حتي يتوب الله عليه
 واخرج ابن المنذر وابن ابي حاتم عن عبيد بن عمير رضي الله عنه قال : ان ابليس قال : يا رب زدني قال : صدوركم مساكن لكم وتجرون منهم مجري الدم قال : يا رب زدني
 قال : ( اجلب عليهم بخيلك ورجلك وشاركهم في الاموال والاولاد وعدهم وما يعدهم الشيطان الا غرورا ) ( الاسراء  ) فقال ادم عليه السلام : يا رب قد سلطته علي واني لا امتنع منه الا بك فقال : لا يولد لك ولد الا وكلت به من يحفظه من قرناء السوء
 قال : يا رب زدني
 قال : الحسنة عشرا او ازيد والسيءة واحدة او امحوها قال : يا رب زدني قال : باب التوبة مفتوح ما كان الروح في الجسد
 قال : يا رب زدني قال @QB@ يا عبادي الذين اسرفوا علي انفسهم لا تقنطوا من رحمة الله ان الله يغفر الذنوب جميعا انه هو الغفور الرحيم @QE@
 واخرج احمد وابو يعلي والضياء عن انس رضي الله عنه قال : سمعت رسول الله صلي الله عليه وسلم يقول : والذي نفسي بيده لو اخطاتم حتي تملا خطاياكم ما بين السماء والارض ثم استغفرتم لغفر لكم
 والذي نفس محمد بيده لو لم تخطءوا لجاء الله بقوم يخطءون ثم يستغفرون فيغفر لهم
 واخرج ابن ابي شيبة ومسلم عن ابي ايوب الانصاري رضي الله عنه : سمعت رسول الله صلي الله عليه وسلم يقول : لولا انكم تذنبون لخلق الله خلقا يذنبون فيغفر لهم
 واخرج الخطيب عن ابن عمر رضي الله عنهما قال : اوحي الله الي داود عليه  السلام : يا داود ان العبد من عبيدي لياتيني بالحسنة فاحكمه في
 قال داود عليه السلام : وما تلك الحسنة قال : كربة فرجها عن مءمن قال داود عليه السلام : اللهم حقيق علي من عرفك حق معرفتك ان لا يقنط منك
 واخرج الحكيم الترمذي عن جابر بن عبد الله رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : قال لي جبريل عليه السلام : يا محمد ان الله يخاطبني يوم القيامة فيقول : يا جبريل ما لي اري فلان بن فلان في صفوف اهل النار فاقول : يا رب انا لم نجد له حسنة يعود عليه خيرها اليوم
 فيقول الله : اني سمعته في دار الدنيا يقول : يا حنان يا منان فاته فاساله فيقول وهل من حنان ومنان غيري فاخذ بيده من صفوف اهل النار فادخله في صفوف اهل الجنة
 واخرج ابن الضريس وابو القسام بن بشير في اماليه عن علي بن ابي طالب رضي الله عنه قال : ان الفقيه كل الفقيه من لم يقنط الناس من رحمة الله تعالي ولم يرخص لهم في معاصيه ولم يءمنهم عذاب الله ولم يدع القران رغبة منه الي غيره انه لا خير في عبادة لا علم فيها ولا علم لا فهم فيه ولا قراءة لا تدبر فيها
 واخرج ابن ابي شيبة عن عطاء بن يسار رضي الله عنه قال : ان للمتقنطين جسرا يطا الناس يوم القيامة علي اعناقهم
 واخرج عبد الرزاق وابن المنذر عن عاءشة رضي الله عنها انها قالت : الم احدث انك تعظ الناس قال : بلي
 قالت : فاياك واهلاك الناس وتقنيطهم
 واخرج عبد الرزاق وابن المنذر عن زيد بن اسلم رضي الله عنه ان رجلا كان في الامم الماضية يجتهد في العبادة ويشدد علي نفسه ويقنط الناس من رحمة الله تعالي ثم مات فقال : اي رب ما لي عندك قال : النار قال : فاين عبادتي واجتهادي فقيل له كنت تقنط الناس من رحمتي وانا اقنطك اليوم من رحمتي
 واخرج عبد الرزاق وعبد بن حميد وابن جرير وابن المنذر عن قتادة رضي الله عنه قال : ذكر لنا ان ناسا اصابوا في الشرك عظاما فكانوا يخافون ان لا يغفر لهم فدعاهم الله لهذه الاية @QB@ يا عبادي الذين اسرفوا @QE@
 واخرج عبد بن حميد عن ابي مجلز لاحق بن حميد السدوسي قال : لما انزل الله علي نبيه صلي الله عليه وسلم @QB@ قل يا عبادي الذين اسرفوا علي انفسهم لا تقنطوا من رحمة الله ان الله يغفر الذنوب جميعا @QE@  الي اخر الاية قام نبي الله صلي الله عليه وسلم فخطب الناس وتلا عليهم
 فقام رجل فقال : يا رسول الله والشرك بالله فسكت فاعاد ذلك ما شاء الله فانزل الله ( ان الله لا يغفر ان يشرك به ويغفر ما دون ذلك لمن يشاء ) ( النساء  )
 واخرج عبد بن حميد عن عكرمة رضي الله عنه @QB@ يا عبادي الذين اسرفوا علي انفسهم @QE@ الي قوله ( وانيبوا الي ربكم واسلموا له ) ( الزمر  ) قال عكرمة رضي الله عنه : قال ابن عباس رضي الله عنهما فيها علقة ( وانيبوا الي ربكم )
