 اخرج ابن جرير وابن المنذر وابن ابي حاتم وابن مردويه والبيهقي في الدلاءل عن ابن عباس رضي الله عنهما في قوله @QB@ واخرون اعترفوا بذنوبهم خلطوا عملا صالحا واخر سيءا @QE@ قال كانوا عشرة رهط تخلفوا عن رسول الله صلي الله عليه وسلم في غزوة تبوك فلما حضر رجوع رسول الله صلي الله عليه وسلم اوثق سبعة منهم انفسهم بسواري المسجد وكان ممر النبي صلي الله عليه وسلم اذا رجع في المسجد عليهم فلما راهم قال : من هءلاء الموثقون انفسهم قالوا : هذا ابو لبابة واصحاب له تخلفوا عنك يا رسول الله اوثقوا انفسهم وحلفوا انهم لا يطلقهم احد حتي يطلقهم النبي صلي الله عليه وسلم ويعذرهم
 قال : وانا اقسم بالله لا اطلقهم ولا اعذرهم حتي يكون الله تعالي هو الذي يطلقهم رغبوا عني وتخلفوا عن الغزو مع المسلمين فلما بلغهم ذلك قالوا : ونحن لا نطلق انفسنا حتي يكون الله هو الذي يطلقنا
 فانزل الله عز وجل @QB@ واخرون اعترفوا بذنوبهم خلطوا عملا صالحا واخر سيءا عسي الله ان يتوب عليهم @QE@ وعسي من الله وانه هو التواب الرحيم فلما نزلت ارسل اليهم النبي صلي الله عليه وسلم فاطلقهم وعذرهم فجاءوا باموالهم فقالوا : يا رسول الله هذه اموالنا فتصدق بها عنا واستغفر لنا
 قال : ما امرت ان اخذ اموالكم
 فانزل الله عز وجل @QB@ خذ من اموالهم صدقة تطهرهم وتزكيهم بها وصل عليهم @QE@ يقول : استغفر لهم ان @QB@ صلاتك سكن لهم @QE@ يقول : رحمة لهم فاخذ منهم الصدقة واستغفر لهم وكان ثلاثة نفر منهم لم يوثقوا انفسهم بالسواري فارجءوا سنة لا يدرون ايعذبون او يتاب عليهم فانزل الله عز وجل ( لقد تاب الله علي النبي والمهاجرين والانصار الذين اتبعوه في ساعة العسرة ) ( التوبة الاية  ) الي اخر الاية ( وعلي الثلاثة الذين  خلفوا ) ( التوبة الاية  ) الي ( ثم تاب عليهم ليتوبوا ان الله هو التواب الرحيم ) يعني ان استقاموا
 واخرج ابو الشيخ عن الضحاك رضي الله عنه
 مثله سواء
 واخرج ابن ابي شيبة وابن المنذر وابن ابي حاتم والبيهقي في الدلاءل عن مجاهد في قوله @QB@ فاعترفوا بذنبهم @QE@ قال : هو ابو لبابة اذ قال لقريظة ما قال واشار الي حلقه بان محمد يذبحكم ان نزلتم علي حكمه
 واخرج البيهقي عن سعيد بن المسيب
 ان بني قريظة كانوا حلفاء لابي لبابة فاطلعوا اليه وهو يدعوهم الي حكم رسول الله صلي الله عليه وسلم فقالوا : يا ابا لبابة اتامرنا ان ننزل فاشار بيده الي حلقه انه الذبح فاخبر عنه رسول الله صلي الله عليه وسلم بذلك فقال له رسول الله صلي الله عليه وسلم احسبت ان الله غفل عن يدك حين تشير اليهم بها الي حلقك فلبث حينا حتي غزا رسول الله صلي الله عليه وسلم تبوك  وهي غزوة العسرة  فتخلف عنه ابو لبابة فيمن تخلف فلما قفل رسول الله صلي الله عليه وسلم منها جاءه ابو لبابة يسلم عليه فاعرض عنه رسول الله صلي الله عليه وسلم ففزع ابو لبابة فارتبط بسارية التوبة التي عند باب ام سلمة سبعا بين يوم وليلة في حر شديد لا ياكل فيهن ولا يشرب قطرة قال : لا يزال هذا مكاني حتي افارق الدنيا او يتوب الله علي
 فلم يزل كذلك حتي ما يسمع الصوت من الجهد ورسول الله صلي الله عليه وسلم ينظر اليه بكرة وعشية ثم تاب الله عليه فنودي ان الله قد تاب عليك فارسل اليه رسول الله صلي الله عليه وسلم ليطلق عنه رباطه فابي ان يطلقه احد الا رسول الله صلي الله عليه وسلم فجاءه رسول الله صلي الله عليه وسلم فاطلقه عنه بيده فقال ابو لبابة حين افاق : يا رسول الله اني اهجر دار قومي التي اصبت فيها الذنب وانتقل اليك فاساكنك واني اختلع من مالي صدقة الي الله ورسوله صلي الله عليه وسلم
 فقال : يجزي عنك الثلث
 فهجر ابو لبابة دار قومه وساكن رسول الله صلي الله عليه وسلم وتصدق بثلث ماله ثم تاب فلم ير منه في الاسلام بعد ذلك الا خيرا حتي فارق الدنيا
 واخرج ابن جرير وابن ابي حاتم وابن مردويه عن ابن عباس قال ان رسول الله صلي الله عليه وسلم غزا غزوة تبوك فتخلف ابو لبابة ورجلان معه عن النبي صلي الله عليه وسلم ثم ان ابا لبابة ورجلين معه تفكروا وندموا وايقنوا بالهلكة وقالوا : نحن في الظل والطمانينة مع النساء ورسول الله صلي الله عليه وسلم والمءمنون معه في الجهاد والله لنوثقن انفسنا بالسواري فلا نطلقها حتي يكون رسول الله صلي الله عليه وسلم هو الذي يطلقنا ويعذرنا فانطلق ابو لبابة فاوثق  نفسه ورجلان معه بسواري المسجد وبقي ثلاثة لم يوثقوا انفسهم فرجع رسول الله صلي الله عليه وسلم من غزوته وكان طريقه في المسجد فمر عليهم فقال : من هءلاء الموثقون انفسهم بالسواري فقال رجل : هذا ابو لبابة وصاحبان له تخلفوا عن رسول الله صلي الله عليه وسلم فعاهدوا الله لا يطلقون انفسهم حتي تكون الذي انت تطلقهم وترضي عنهم وقد اعترفوا بذنوبهم
 فقال رسول الله صلي الله عليه وسلم : والله لا اطلقهم حتي اءمر باطلاقهم ولا اعذرهم حتي يكون الله يعذرهم وقد تخلفوا ورغبوا عن المسلمين بانفسهم وجهادهم فانزل الله تعالي @QB@ واخرون اعترفوا بذنوبهم @QE@ الاية
 وعسي من الله واجب فلما نزلت الاية اطلقهم رسول الله صلي الله عليه وسلم وعذرهم فانطلق ابو لبابة وصاحباه باموالهم فاتوا بها رسول الله صلي الله عليه وسلم فقالوا : خذ من اموالنا فتصدق بها عنا وصل علينا
 يقولون : استغفر لنا وطهرنا
 فقال : لا اخذ منها شيءا حتي اءمر به
 فانزل الله خذ من اموالهم صدقة

 الاية
 قال : وبقي الثلاثة الذين خالفوا ابا لبابة ولم يتوبوا ولم يذكروا بشء ولم ينزل عذرهم وضاقت عليهم الارض بما رحبت وهم الذين قال الله @QB@ واخرون مرجون لامر الله @QE@ ( التوبة الاية  ) الاية
 فجعل الناس يقولون : هلكوا اذا لم ينزل لهم عذر وجعل اخرون يقولون : عسي الله ان يتوب عليهم
 فصاروا مرجءين لامر الله حتي نزلت ( لقد تاب الله علي النبي ) ( التوبة الاية  ) الي قوله ( وعلي الثلاثة الذين خلفوا ) ( التوبة الاية  ) يعني المرجءين لامر الله نزلت عليهم التوبة فعملوا بها
 واخرج ابن ابي حاتم عن ابن زيد في قوله @QB@ واخرون اعترفوا بذنوبهم @QE@ قال : هم الثمانية الذين ربطوا انفسهم بالسواري منهم كردم ومرداس وابو لبابة
 واخرج ابن ابي حاتم وابو الشيخ عن قتادة في قوله @QB@ واخرون اعترفوا بذنوبهم خلطوا عملا صالحا واخر سيءا @QE@ قال : ذكر لنا انهم كانوا سبعة رهط تخلفوا عن غزوة تبوك منهم اربعة خلطوا عملا صالحا واخر سيءا : جد بن قيس وابو لبابة وحرام واوس كلهم من الانصار تيب عليهم وهم الذين قيل @QB@ خذ من اموالهم صدقة @QE@ 
 واخرج ابن ابي حاتم عن السدي في قوله @QB@ خلطوا عملا صالحا واخر سيءا @QE@ قال : غزوهم مع رسول الله صلي الله عليه وسلم @QB@ واخر سيءا @QE@ قال تخلفهم عنه
 واخرج ابن ابي شيبة وابن ابي الدنيا في التوبة وابن جرير وابن المنذر وابو الشيخ والبيهقي في شعب الايمان عن ابي عثمان النهدي قال : ما في القران اية ارجي عندي لهذه الامة من قوله @QB@ واخرون اعترفوا بذنوبهم خلطوا عملا صالحا واخر سيءا @QE@ الاية
 واخرج ابو الشيخ والبيهقي عن مطرف قال : اني لاستلقي من الليل علي فراشي واتدبر القران فاعرض اعمالي علي اعمال اهل الجنة فاذا اعمالهم شديدة ( كانوا قليلا من الليل ما يهجعون ) ( الذاريات الاية  )
 ( يبيتون لربهم سجدا وقياما ) ( الفرقان الاية  )
 ( امن هو قانت اناء الليل ساجدا وقاءما ) ( الزمر الاية  ) فلا اراني منهم

 فاعرض نفسي علي هذه الاية ( ما سلككم في سقر ) ( قالوا لم نك من المصلين ) ( المدثر الاية    ) الي قوله ( نكذب بيوم الدين ) فاري القوم مكذبين فلا اراني منهم فامر بهذه الاية @QB@ واخرون اعترفوا بذنوبهم خلطوا عملا صالحا واخر سيءا @QE@ فارجو ان اكون انا وانتم يا اخوتاه منهم
 واخرج ابو الشيخ وابن منده وابو نعيم في المعرفة وابن عساكر بسند قوي عن جابر بن عبد الله قال : كان ممن تخلف عن رسول الله صلي الله عليه وسلم في غزوة تبوك ستة : ابو لبابة واوس بن جذام وثعلبة بن وديعة وكعب بن مالك ومرارة بن الربيع وهلال بن امية
 فجاء ابو لبابة واوس بن جذام وثعلبة فربطوا انفسهم بالسواري وجاءوا باموالهم فقالوا : يا رسول الله خذ هذا الذي حبسنا عنك
 فقال رسول الله صلي الله عليه وسلم لا احلهم حتي يكون قتال
 فنزل القران @QB@ خلطوا عملا صالحا واخر سيءا @QE@ الاية
 وكان ممن ارجء عن التوبة وخلف كعب بن مالك ومرارة بن الربيع وهلال بن امية
 فارجءوا اربعين يوما فخرجوا وضربوا فساطيطهم واعتزلوهم نساءهم ولم يتولهم المسلمون ولم يقربوا منهم فنزل فيهم ( وعلي الثلاثة الذين خلفوا ) ( التوبة الاية  ) الي قوله ( التواب الرحيم ) فبعثت ام سلمة الي كعب فبشرته
 واخرج ابن ابي حاتم عن ابن شوذب قال : قال الاحنف بن قيس : عرضت نفسي علي القران فلم اجدني باية اشبه مني بهذه الاية @QB@ واخرون اعترفوا بذنوبهم خلطوا عملا صالحا واخر سيءا @QE@ الاية 
 واخرج ابو الشيخ عن مالك بن دينار قال : سالت الحسن عن قول الله @QB@ واخرون اعترفوا بذنوبهم خلطوا عملا صالحا واخر سيءا @QE@ فقال : يا مالك تابوا عسي الله ان يتوب عليهم وعسي من الله واجبة
 واخرج البخاري ومسلم والترمذي والنساءي وابن مردويه عن سمرة بن جندب قال كان رسول الله صلي الله عليه وسلم ممن يكثر ان يقول لاصحابه : هل راي احد منكم رءيا وانه قال لنا ذات غداة : انه اتاني الليلة اتيان فقالا لي : انطلق
 فانطلقت معهما فاخرجاني الي الارض المقدسة فاتينا علي رجل مضطجع واذا اخر قاءم عليه بصخرة واذا هو يهوي بالصخرة لراسه فيثلغ راسه فيتدهده الحجر ههنا فيتبع الحجر فياخذه فلا يرجع اليه حتي يصح راسه كما كان ثم يعود اليه فيفعل به مثل ما فعل في المرة الاولي
 قلت لهما : سبحان الله ما هذان

 قالا لي : انطلق
 فانطلقنا فاتينا علي رجل مستلق لقفاه واخر قاءم عليه بكلوب من حديد واذا هو ياتي احد شقي وجهه فيشرشر شدقه الي قفاه ومنخره الي قفاه وعينه الي قفاه ثم يتحول الي الجانب الاخر فيفعل به مثل ما فعل بالجانب الاول فما يفرغ من ذلك الجانب حتي يصبح ذلك الجانب كما كان ثم يعود عليه فيفعل مثل ما فعل في المرة الاولي
 قلت : سبحان الله ما هذان

 قالا لي : انطلق
 فانطلقنا فاتينا علي مثل التنور فاذا فيه لغط واصوات فاطلعنا فيه فاذا فيه رجال ونساء عراة فاذا هم ياتيهم لهب من اسفل منهم فاذا اتاهم ذلك اللهب ضوضوا قلت : ما هءلاء

 فقالا لي : انطلق
 فانطلقنا فاتينا علي نهر احمر مثل الدم واذا في النهر رجل سابح يسبح واذا علي شاطء النهر رجل عنده حجارة كثيرة واذا ذلك السابح يسبح ما يسبح ثم ياتي الذي قد جمع عنده الحجارة فيفغر له فاه فيلقمه حجر فينطلق فيسبح ثم يرجع اليه كلما رجع فغر له فاه فالقمه حجرا
 قلت لهما : ما هذان

 قالا لي : انطلق
 فانطلقنا فاتينا علي رجل كريه المراة كاكره ما انت راء واذا هو عنده نار يحشها ويسعي حولها
 قلت لهما : ما هذا

 قالا لي : انطلق
 فانطلقنا فاتينا علي روضة معتمة فيها من كل نور الربيع واذا بين ظهري الروضة رجل طويل لا اكاد اري راسه طولا في السماء واذا حول الرجل من اكثر ولدان رايتهم قط
 قالا لي : انطلق
 فانطلقنا فانتهينا الي روضة عظيمة لم ار قط روضة  اعظم منها ولا احسن
 قالا لي : ارق فيها
 فارتقينا فيها فانتهينا الي مدينة مبنية بلبن ذهب ولبن فضة فاتينا باب المدينة فاستفتحنا ففتح لنا فدخلناها فتلقانا فيها رجال شطر من خلقهم كاحسن ما انت راء وشطر كاقبح ما انت راء
 قالا لهم : اذهبوا فقعوا في ذلك النهر
 فاذا نهر معترض يجري كان ماءه المخض في البياض فذهبوا فوقعوا فيه ثم رجعوا الينا فذهب السوء عنهم فصاروا في احسن صورة

 قالا لي : هذه جنة عدن وهذاك منزلك فسما بصري صعدا فاذا قصر مثل الربابة البيضاء قالا لي : هذا منزلك
 قلت لهما : بارك الله فيكما ذراني فادخله
 قالا : اما الان فلا وانت داخله
 قلت لهما : فاني رايت منذ الليلة عجبا فما هذا الذي رايت قالا لي : اما الرجل الاول الذي اتيت عليه يثلغ راسه بالحجر فانه الرجل ياخذ القران فيرفضه وينام عن الصلاة المكتوبة يفعل به الي يوم القيامة
 واما الرجل الذي اتيت عليه يشرشر شدقه الي قفاه ومنخراه الي قفاه وعينه الي قفاه فانه الرجل يغدو من بيته فيكذب الكذبة تبلغ الافاق فيصنع به الي يوم القيامة
 واما الرجال والنساء العراة الذين في مثل التنور فانهم الزناة والزواني
 واما الرجل الذي اتيت عليه يسبح في النهر ويلقم الحجارة فانه اكل الربا
 واما الرجل الكريه المراة الذي عنده النار يحشها فانه مالك خازن النار
 واما الرجل الطويل الذي في الروضة فانه ابراهيم عليه السلام
 واما الولدان الذين حوله فكل مولود مات علي الفطرة
 واما القوم الذين كانوا شطر منهم حسن وشطر منهم قبيح فانهم قوم خلطوا عملا صالحا واخر سيءا تجاوز الله عنهم وانا جبريل وهذا ميكاءيل
 واخرج الخطيب في تاريخه عن ابي موسي ان رسول الله صلي الله عليه وسلم قال : رايت رجالا تقرض جلودهم بمقاريض من نار
 قلت : ما هءلاء قال : هءلاء الذين يتزينون الي ما لا يحل لهم
 ورايت خباء خبيث الريح وفيه صباح
 قلت : ما هذا قال : هن نساء يتزين الي ما لا يحل لهن
 ورايت قوما اغتسلوا من ماء الجناة
 قلت : ما هءلاء قال : هم قوم خلطوا عملا صالحا واخر سيءا
 واخرج ابن سعد عن الاسود بن قيس العبدي قال : لقي الحسن بن علي يوما حبيب بن مسلمة فقال : يا حبيب رب ميسر لك في غير طاعة الله
 فقال : اما ميسري الي ابيك فليس من ذلك قال : بلي ولكنك اطعت معاوية علي دنيا قليلة  زاءلة فلءن قام بك في دنياك لقد قعد بك في دينك ولو كنت اذ فعلت شرا قلت خيرا كان ذلك كما قال الله @QB@ خلطوا عملا صالحا واخر سيءا @QE@ ولكنك كما قال الله ( كلا بل ران علي قلوبهم ما كانوا يكسبون ) ( المطففين الاية  )
