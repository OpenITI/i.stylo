 واخرج عبد بن حميد وابن جرير وابن المنذر والطبراني والبيهقي في الشعب من طرق عن ابن عباس قال : كل ما نهي الله عنه فهو كبيرة وقد ذكرت الطرفة يعني النظرة
 واخرج ابن جرير عن ابي الوليد قال : سالت ابن عباس عن الكباءر فقال : كل شء عصي الله فيه فهو كبيرة
 واخرج ابن ابي حاتم عن ابن عباس قال : كل ما وعد الله عليه النار كبيرة
 واخرج ابن جرير عن ابن عباس قال : الكباءر كل ذنب ختمه الله بنار او غضب او لعنة او عذاب
 واخرج ابن جرير عن سعيد بن جبير قال : كل ذنب نسبه الله الي النار فهو من الكباءر
 واخرج ابن جرير عن الضحاك قال : الكباءر كل موجبة اوجب الله لاهلها النار وكل عمل يقام به الحد فهو من الكباءر
 واخرج عبد الرزاق وعبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم والبيهقي في شعب الايمان من طرق عن ابن عباس انه سءل عن الكباءر اسبع هي قال : هي الي السبعين اقرب 
  واخرج ابن جرير وابن المنذر وابن ابي حاتم من طريق سعيد بن جبير ان رجلا سال ابن عباس كم الكباءر سبع هي قال الي سبعماءة اقرب منها الي سبع غير انه لا كبيرة مع استغفار ولا صغيرة مع اصرار
 واخرج البيهقي في الشعب من طريق قيس بن سعد قال : قال ابن عباس : كل ذنب اصر عليه العبد كبير وليس بكبير ما تاب منه العبد
 واخرج البخاري ومسلم وابو داود والنساءي وابن ابي حاتم عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : اجتنبوا السبع الموبقات
 قالوا : وما هن يا رسول الله قال : الشرك بالله وقتل النفس التي حرم الله الا بالحق والسحر واكل الربا ومال اليتيم والتولي يوم الزحف وقذف المحصنات الغافلات المءمنات
 واخرج البزار وابن المنذر وابن ابي حاتم عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال : الكباءر سبع : اولها الاشراك بالله ثم قتل النفس بغير حقها واكل الربا واكل مال اليتيم الي ان يكبر والفرار من الزحف ورمي المحصنات والانقلاب علي الاعراب بعد الهجرة
 واخرج علي بن الجعد في الجعديات عن طيسلة قال : سالت ابن عمر عن الكباءر فقال : سمعت رسول الله صلي الله عليه وسلم يقول : هن تسع : الاشراك بالله وقذف المحصنة وقتل النفس المءمنة والفرار من الزحف والسحر واكل الربا واكل مال اليتيم وعقوق الوالدين والالحاد بالبيت الحرام قبلتكم احياء وامواتا
 واخرج ابن راهويه والبخاري في الادب المفرد وعبد بن حميد وابن المنذر والقاضي اسماعيل في احكام القران وابن المنذر بسند حسن من طريق طيسلة عن ابن عمر قال : الكباءر تسع : الاشراك بالله وقتل النسمة يعني بغير حق وقذف المحصنة والفرار من الزحف واكل الربا واكل مال اليتيم والذي يستسحر والحاد في المسجد الحرام وانكاء الوالدين من العقوق
 واخرج ابو داود والنساءي وابن جرير وابن ابي حاتم والطبراني والحاكم وابن مردويه عن عمير الليثي قال : قال رسول الله صلي الله عليه وسلم : ان اولياء الله المصلون ومن يقيم الصلوات الخمس التي كتبها الله علي عباده ومن يءدي زكاة ماله طيبة بها نفسه ومن يصوم رمضان يحتسب صومه ويجتنب الكباءر
 فقال رجل من الصحابة : يا رسول الله وكم الكباءر قال : هن تسع : اعظمهن الاشراك بالله وقتل المءمن بغير  الحق والفرار يوم الزحف وقذف المحصنة والسحر واكل مال اليتيم واكل الربا وعقوق الوالدين المسلمين واستحلال البيت الحرام قبلتكم احياء وامواتا
 واخرج ابن المنذر والطبراني وابن مردويه عن ابن عمرو عن النبي صلي الله عليه وسلم قال : من صلي الصلوات الخمس واجتنب الكباءر السبع نودي من ابواب الجنة ادخل بسلام
 قيل اسمعت رسول الله صلي الله عليه وسلم يذكرهن قال : نعم عقوق الوالدين والاشراك بالله وقتل النفس وقذف المحصنات واكل مال اليتيم والفرار من الزحف واكل الربا
 واخرج احمد والنساءي وابن جرير وابن المنذر وابن حبان والحاكم وصححه عن ابي ايوب قال : قال رسول الله صلي الله عليه وسلم : من عبد الله لا يشرك به شيءا واقام الصلاة واتي الزكاة وصام رمضان واجتنب الكباءر فله الجنة
 فساله رجل ما الكباءر قال : الشرك بالله وقتل نفس مسلمة والفرار يوم الزحف
 واخرج ابن حبان وابن مردويه عن ابي بكر بن محمد بن عمرو بن حزم عن ابيه عن جده قال : كتب رسول الله صلي الله عليه وسلم الي اهل اليمن كتابا فيه الفراءض والسنن والديات وبعث به مع عمرو بن حزم قال : وكان في الكتاب : ان اكبر الكباءر عند الله يوم القيامة الاشراك بالله وقتل النفس المءمنة بغير حق والفرار يوم الزحف وعقوق الوالدين ورمي المحصنة وتعلم السحر واكل الربا واكل مال اليتيم
 واخرج احمد وعبد بن حميد والبخاري ومسلم والترمذي والنساءي وابن جرير وابن ابي حاتم عن انس قال : ذكر رسول الله صلي الله عليه وسلم الكباءر فقال : الشرك بالله وقتل النفس وعقوق الوالدين وقال : الا انبءكم باكبرالكباءر قول الزور او شهادة الزور
 واخرج الشيخان والترمذي وابن المنذر عن ابي بكرة قال : قال النبي صلي الله عليه وسلم : الا انبءكم باكبر الكباءر قلنا : بلي يا رسول الله
 قال : الاشراك بالله وعقوق الوالدين وكان متكءا فجلس فقال : الا وقول الزور
 الا وشهادة الزور فما زال يكررها حتي قلنا ليته سكت
 واخرج ابن ابي حاتم عن ابن عمرو انه سءل عن الخمر فقال : سالت عنها رسول الله صلي الله عليه وسلم فقال : هي اكبر الكباءر وام الفواحش من شرب الخمر ترك الصلاة ووقع علي امه وخالته وعمته
  واخرج ابن ابي حاتم عن ابن عباس انه كان يعد الخمر اكبر الكباءر
 واخرج عبد بن حميد في كتاب الايمان عن شعبة مولي ابن عباس قال : قلت لابن عباس : ان الحسن بن علي سءل عن الخمر امن الكباءر هي فقال : لا
 فقال ابن عباس : قد قالها النبي صلي الله عليه وسلم : اذا شرب سكر وزني وترك الصلاة فهي من الكباءر
 واخرج احمد والبخاري الترمذي والنساءي وابن جرير عن ابن عمرو عن النبي صلي الله عليه وسلم قال : الكباءر : الاشراك بالله وعقوق الوالدين او قتل النفس  شك شعبة  واليمين الغموس
 واخرج احمد وعبد بن حميد والترمذي وحسنه وابن المنذر وابن ابي حاتم وابن حبان والطبراني في الاوسط والبيهقي عن عبد الله بن انيس الجهني قال : قال رسول الله صلي الله عليه وسلم : ان من اكبر الكباءر الشرك بالله وعقوق الوالدين واليمين الغموس وما حلف حالف بالله يمين صبر فادخل فيها مثل جناح بعوضة الا جعلت نكتة في قلبه الي يوم القيامة
 واخرج ابن ابي شيبة وعبد بن حميد والبخاري ومسلم والترمذي وابن المنذر وابن ابي حاتم عن ابن عمرو قال : قال رسول الله صلي الله عليه وسلم : من اكبر الكباءر ان يلعن الرجل والديه
 قالوا : وكيف يلعن الرجل والديه قال : يسب ابا الرجل فيسب اباه ويسب امه فيسب امه
 واخرج او داود وابن ابي حاتم وابن مردويه عن ابي هريرة عن النبي صلي الله عليه وسلم قال : من اكبر الكباءر استطالة المرء في عرض رجل مسلم بغير حق ومن الكباءر السبتان بالسبة
 واخرج الترمذي والحاكم وابن ابي حاتم عن ابن عباس عن النبي صلي الله عليه وسلم قال : من جمع بين الصلاتين من غير عذر فقد اتي بابا من ابواب الكباءر
 واخرج ابن ابي شيبة عن ابي موسي قال : الجمع بين الصلاتين من غير عذر من الكباءر
 واخرج ابن ابي حاتم عن ابي قتادة العدوي قال : قرء علينا كتاب عمر من الكباءر جمع بين الصلاتين
 يعني بغير عذر والفرار من الزحف والنميمة
 واخرج البزار وابن ابي حاتم والطبراني في الاوسط وابن ابي حاتم بسند حسن  عن ابن عباس قال : سءل رسول الله صلي الله عليه وسلم : ما الكباءر فقال : الشرك بالله والياس من روح الله والامن من مكر الله
 واخرج عبد الرزاق وعبد بن حميد وابن جرير وابن المنذر والطبراني وابن ابي الدنيا في التوبة عن ابن مسعود قال : اكبر الكباءر الاشراك بالله والاياس من روح الله والقنوط من رحمة الله والامن من مكر الله
 واخرج ابن المنذر عن علي انه سءل ما اكبر الكباءر فقال : الامن لمكر الله والاياس من روح الله والقنوط من رحمة الله
 واخرج ابن جرير بسند حسن عن ابي امامة ان ناسا من اصحاب رسول الله صلي الله عليه وسلم ذكروا الكباءر وهو متكء فقالوا : الشرك بالله واكل مال اليتيم وفرار يوم الزحف وقذف المحصنة وعقوق الوالدين وقول الزور والغلول والسحر واكل الربا فقال رسول الله صلي الله عليه وسلم : فاين تجعلون ( ان الذين يشترون بعهد الله وايمانهم ثمنا قليلا ) ( ال عمران الاية  ) الي اخر الاية
 واخرج ابن ابي حاتم عن ابن عباس مرفوعا الضرار في الوصية من الكباءر
 واخرج ابن ابي حاتم عن علي قال : الكباءر : الشرك بالله وقتل النفس واكل مال اليتيم وقذف المحصنة والفرار من الزحف والتعرب بعد الهجرة والسحر وعقوق الوالدين واكل الربا وفراق الجماعة ونكث الصفقة
 واخرج البزار وابن المنذر بسند ضعيف عن بريدة ان رسول الله صلي الله عليه وسلم قال ان اكبر الكباءر الاشراك بالله وعقوق الوالدين ومنع فضل الماء ومنع الفحل
 واخرج ابن ابي حاتم عن بريدة قال : ان اكبر الكباءر الشرك بالله وعقوق الوالدين ومنع فضول الماء بعد الري ومنع طروق الفحل الا بجعل
 واخرج ابن ابي حاتم وابن مردويه عن عاءشة قالت : ما اخذ علي النساء فمن الكباءر
 يعني قوله ( ان لا يشركن بالله شيءا ولا يسرقن ولا يزنين

 ) ( المتحنة الاية  ) الاية
 واخرج البخاري في الادب المفرد والطبراني والبيهقي عن عمران بن حصين قال : قال رسول الله صلي الله عليه وسلم : ارايتم الزاني والسارق وشارب الخمر ما تقولون فيهم قالوا : الله ورسوله اعلم
 قال : هن فواحش وفيهن عقوبة الا انبءكم  باكبر الكباءر الاشراك بالله ثم قرا ( ومن يشرك بالله فقد افتري اثما عظيما ) ( النساء الاية  ) وعقوق الوالدين ثم قرا ( ان اشكر لي ولوالديك الي المصير ) ( لقمان الاية  ) وكان متكءا فاحتفز فقال : الا وقول الزور
 واخرج عبد بن حميد عن ابن مسعود قال : ان من اكبر الذنب عند الله ان يقول لصاحبه اتق الله فيقول : عليك نفسك من انت تامرني
 واخرج ابن المنذر عن سالم بن عبد الله التمار عن ابيه ان ابا بكر وعمر واناسا من الصحابة بعد وفاة رسول الله صلي الله عليه وسلم ذكروا اعظم الكباءر فلم يكن عندهم فيها علم ينتهون اليه فارسلوني الي عبد الله بن عمرو بن العاص اساله عن ذلك فاخبرني ان اعظم الكباءر شرب الخمر فاتيتهم فاخبرتهم فانكروا ذلك وتواثبوا اليه جميعا حتي اتوه في داره فاخبرهم انهم تحدثوا عند رسول الله صلي الله عليه وسلم : ان ملكا من بني اسراءيل اخذ رجلا فخيره ان يشرب الخمر او يقتل نفسا او يزني او ياكل لحم خنزير او يقتله ان ابي
 فاختار شرب الخمر وانه لما شربها لم يمتنع من شء اراده منه وان رسول الله صلي الله عليه وسلم قال : ما احد يشربها فيقبل الله له صلاة اربعين ليلة ولا يموت وفي مثانته منها شء الا حرمت عليه الجنة وان مات في الاربعين مات ميتة جاهلية
 واخرج ابن جرير وابن المنذر وابن ابي حاتم والطبراني وابن مردويه عن ابن عباس قال : الكباءر الاشراك بالله لان الله يقول ( لا يياس من روح الله الا القوم الكافرون ) ( يوسف الاية  ) والامن لمكر الله لان الله يقول ( فلا يامن مكر الله الا القوم الخاسرون ) ( الاعراف الاية  ) وعقوق الوالدين لان الله جعل العاق جبارا عصيا وقتل النفس التي حرم الله لان الله يقول ( فجزاءه جهنم

 ) ( النساء الاية  ) الي اخر الاية وقذف المحصنات لان الله يقول ( لعنوا في الدنيا والاخرة ولهم عذاب عظيم ) ( النور الاية  ) واكل  مال اليتيم لان الله يقول ( انما ياكلون في بطونهم نارا وسيصلون سعيرا ) ( النساء الاية  ) والفرار من الزحف لان الله يقول ( ومن يولهم يومءذ دبره

 ) الي قوله ( وبءس المصير ) ( الانفال الاية  ) واكل الربا لان الله يقول ( الذين ياكلون الربا لا يقومون

 ) ( البقرة الاية  ) الاية والسحر لان الله يقول ( ولقد علموا لمن اشتراه ما له في الاخرة من خلاق ) ( البقرة الاية  ) والزنا لان الله يقول ( يلق اثاما ) ( الفرقان الاية  ) الاية واليمين الغموس الفاجرة لان الله يقول ( ان الذين يشترون بعهد الله وايمانهم

 ) ( ال عمران الاية  ) الاية والغلول لان الله يقول ( ومن يغلل يات بما غل يوم القيامة ) ( ال عمران الاية  ) ومنع الزكاة المفروضة لان الله يقول ( فتكوي بها جباههم

 ) ( التوبة الاية  ) الاية وشهادة الزور وكتمان الشهادة لان الله يقول ( ومن يكتمها فانه اثم قلبه ) ( البقرة الاية  ) وشرب الخمر لان الله عدل بها الاوثان وترك الصلاة متعمدا لان رسول الله صلي الله عليه وسلم قال : من ترك الصلاة متعمدا فقد برء من ذمة الله ورسوله ونقض العهد وقطيعة الرحم لان الله يقول ( لهم اللعنة ولهم سوء الدار ) ( الرعد الاية  )
 واخرد عبد بن حميد والبزار والطبراني عن ابن مسعود انه سءل عن الكباءر قال : ما بين اول سورة النساء الي راس ثلاثين اية منها
 واخرج عبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم عن ابن مسعود قال : الكباءر من اول سورة النساء الي قوله @QB@ ان تجتنبوا كباءر ما تنهون عنه @QE@
 واخرج عبد بن حميد عن ابن مسعود انه سءل عن الكباءر فقال : افتتحوا سورة النساء فكل شء نهي الله عنه حتي تاتوا ثلاثين اية فهو كبيرة ثم قرا مصداق ذلك @QB@ ان تجتنبوا كباءر ما تنهون عنه @QE@ الاية
  واخرج ابن المنذر عن ابن عباس انه قرا من النساء حتي بلغ ثلاثين اية منها ثم قرا @QB@ ان تجتنبوا كباءر ما تنهون عنه @QE@ مما في اول السورة الي حيث بلغ
 واخرج عبد بن حميد وابن جرير عن ابراهيم قال : كانوا يرون ان الكباءر فيما بين اول هذه السورة سورة النساء الي هذه الموضع @QB@ ان تجتنبوا كباءر ما تنهون عنه @QE@
 واخرج ابن جرير عن ابن سيرين قال : سالت عبيدة عن الكباءر فقال : الاشراك بالله وقتل النفس التي حرم الله بغير حقها وفرار يوم الزحف واكل مال اليتيم بغير حقه واكل الربا والبهتان ويقولون اعرابية بعد الهجرة
 قيل لابن سيرين : فالسحر

 قال : ان البهتان يجمع شرا كثيرا
 واخرج ابن ابي حاتم عن مغيرة قال : كان يقال : شتم ابي بكر وعمر رضي الله عنهما من الكباءر
 واخرج ابن ابي الدنيا في التوبة والبيهقي في الشعب عن الاوزاعي قال : كان يقال : من الكباءر ان يعمل الرجل الذنب فيحتقره
 واخرج البيهقي في الشعب عن ابن عباس قال : لا كبيرة بكبيرة مع الاستغفار ولا صغيرة بصغيرة مع الاصرار
 واخرج عبد بن حميد عن ابن عباس
 انه قرا تكفر بالتاء ونصب الفاء
 واخرج عبد بن حميد عن قتادة في قوله @QB@ ان تجتنبوا كباءر ما تنهون عنه نكفر عنكم سيءاتكم @QE@ قال : انما وعد الله المغفرة لمن اجتنب الكباءر
 واخرج ابن جرير وابن ابي حاتم عن السدي في قوله @QB@ نكفر عنكم سيءاتكم @QE@ قال : الصغار @QB@ وندخلكم مدخلا كريما @QE@ قال : الكريم : هو الحسن في الجنة
 واخرج ابن المنذر وابن ابي حاتم عن قتادة انه كان يقول : المدخل الكريم
 هو الجنة
 واخرج عبد بن حميد عن ابن عباس انه قرا @QB@ مدخلا @QE@ بضم الميم
