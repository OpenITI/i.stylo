 واخرج عبد الرزاق واحمد وعبد بن حميد وابن المنذر والطبراني وابو الشيخ وابن مردويه وابو نعيم في الدلاءل والخطيب عن ابن عباس رضي الله عنهما في قوله @QB@ واذ يمكر بك الذين كفروا ليثبتوك @QE@  قال : تشاورت قريش ليلة بمكة فقال بعضهم : اذا اصبح فاثبتوه بالوثاق  يريدون النبي صلي الله عليه وسلم  وقال بعضهم : بل اقتلوه وقال بعضهم : بل اخرجوه
 فاطلع الله نبيه صلي الله عليه وسلم علي ذلك فبات علي رضي الله عنه علي فراش النبي وخرج النبي صلي الله عليه وسلم حتي لحق بالغار وبات المشركون يحرسون عليا رضي الله عنه يحسبونه النبي صلي الله عليه وسلم فلما اصبحوا ثاروا اليه فلما راوه عليا رضي الله عنه رد الله مكرهم فقالوا : اين صاحبك هذا قال : لا ادري

 فاقتصوا اثره فلما بلغوا الجبل اختلط عليهم فصعدوا في الجبل فراوا علي بابه نسج العنكبوت فقالوا : لو دخل هنا لم يكن نسج العنكبوت علي بابه فمكث فيه ثلاث ليال
 واخرج ابن اسحق وابن جرير وابن المنذر وابن ابي حاتم وابو نعيم والبيهقي معا في الدلاءل عن ابن عباس رضي الله عنهما
 ان نفرا من قريش ومن اشراف كل قبيلة اجتمعوا ليدخلوا دار الندوة واعترضهم ابليس في صورة شيخ جليل فلما راوه قالوا : من انت قال : شيخ من اهل نجد سمعت بما اجتمعتم له فاردت ان احضركم ولن يعدمكم مني راي ونصح
 قالوا : اجل فادخل فدخل معهم فقال : انظروا في شان هذا الرجل  فوالله  ليوشكن ان يواتيكم في امركم بامره
 فقال قاءل : احبسوه في وثاق ثم تربصوا به المنون حتي يهلك كما هلك من كان قبله من الشعراء : زهير ونابغة فانما هو كاحدهم فقال عدو الله الشيخ النجدي : لا والله ما هذا لكم براي والله ليخرجن راءد من محبسه لاصحابه فليوشكن ان يثبوا عليه حتي ياخذوه من ايديكم ثم يمنعوه منكم فما امن عليكم ان يخرجوكم من بلادكم فانظروا في غير هذا الراي
 فقال قاءل : فاخرجوه من بين اظهركم فاستريحوا منه فانه اذا خرج لم يضركم ما صنع واين وقع واذا غاب عنكم اذاه استرحتم منه فانه اذا خرج لم يضركم ما صنع وكان امره في غيركم
 فقال الشيخ النجدي : لا والله ما هذا لكم براي الم تروا حلاوة قوله وطلاقة لسانه واخذه القلوب بما تستمع من حديث والله لءن فعلتم ثم استعرض العرب لتجتمعن اليه ثم ليسيرن اليكم حتي يخرجكم من بلادكم ويقتل اشرافكم
 قالوا : صدق  والله  فانظروا رايا غير هذا
 فقال ابو جهل : والله لاشيرن عليكم براي ما اري غيره
 قالوا : وما هذا قال : تاخذوا من كل قبيلة غلاما وسطا شابا مهدا ثم يعطي كل غلام منهم سيفا  صارما ثم يضربوه به  يعني ضربة رجل واحد  فاذا قتلتموه تفرق دمه في القباءل كلها فلا اظن هذا الحي من بني هاشم يقدرون علي حرب قريش كلهم وانهم اذا ارادوا ذلك قبلوا العقل واسترحنا وقطعنا عنا اذاه
 فقال الشيخ النجدي : هذا  والله  هو الراي القول ما قال الفتي لا اري غيره فتفرقوا علي ذلك وهم مجتمعون له
 فاتي جبريل عليه السلام رسول الله صلي الله عليه وسلم فامره ان لا يبيت في مضجعه الذي كان يبيت فيه واخبره بمكر القوم فلم يبت رسول الله صلي الله عليه وسلم في بيته تلك الليلة واذن الله له عند ذلك في الخروج وامرهم بالهجرة وافترض عليهم القتال فانزل الله ( اذن للذين يقاتلون ) ( الحج الاية  ) فكانت هاتان الايتان اول ما نزل في الحرب وانزل بعد قدومه المدينة يذكره نعمته عليه @QB@ واذ يمكر بك الذين كفروا @QE@ الاية
 واخرج سنيد وابن جرير وابن المنذر وابن ابي حاتم وابو الشيخ عن عبيد بن عمير رضي الله عنه قال لما اءتمروا بالنبي صلي الله عليه وسلم ليثبتوه او يقتلوه او يخرجوه قال له عمه ابو طالب : هل تدري ما اءتمروا بك قال : يريدون ان يسجنوني او يقتلوني او يخرجوني
 قال : من حدثك بهذا قال : ربي
 قال : نعم الرب ربك استوص به خيرا

 قال : انا استوصي به بل هو يستوصي بي
 واخرج ابن جرير من طريق عبيد بن عمير رضي الله عنه عن المطلب بن ابي وداعة انا ابا طالب قال للنبي صلي الله عليه وسلم : ما ياتمر بك قومك قال : يريدون ان يجسنوني او يقتلوني او يخرجوني
 قال : من حدثك بهذا قال : ربي
 قال : نعم الرب ربك فاستوص به خيرا

 قال : انا استوصي به بل هو يستوصي بي : فنزلت @QB@ واذ يمكر بك الذين كفروا @QE@
 واخرج ابن جرير وابو الشيخ عن ابن جريج رضي الله عنه @QB@ واذ يمكر بك الذين كفروا @QE@ قال : هي مكية
 واخرج ابن مردويه عن انس بن مالك رضي الله عنه قال : سءل النبي صلي الله عليه وسلم عن الايام سءل عن يوم السبت فقال هو يوم مكر وخديعة
 قالوا : وكيف ذاك يا رسول الله قال : فيه مكرت قريش في دار الندوة اذ قال الله @QB@ واذ يمكر بك الذين كفروا ليثبتوك او يقتلوك او يخرجوك ويمكرون ويمكر الله والله خير الماكرين @QE@
  واخرج ابن جرير وابن المنذر وابن ابي حاتم عن ابن عباس رضي الله عنهما @QB@ ليثبتوك @QE@ يعني ليوثقوك
 واخرج عبد الرزاق وعبد بن حميد عن قتادة رضي الله عنه قال : دخلوا دار الندوة ياتمرون بالنبي صلي الله عليه وسلم فقالوا : لا يدخل عليكم احد ليس منكم فدخل معهم الشيطان في صورة شيخ من اهل نجد فتشاوروا فقال احدهم : نخرجه : فقال الشيطان : بءسما راي هذا هو قد كاد ان يفسد فيما بينكم وهو بين اظهركم فكيف اذا اخرجتموه فافسد الناس ثم حملهم عليكم يقاتلونكم
 قالوا : نعم ما راي هذا

 فاطلع الله نبيه صلي الله عليه وسلم علي ذلك فخرج هو وابو بكر رضي الله عنه الي غار في جبل يقال ثور وقام علي بن ابي طالب علي فراش النبي وباتوا يحرسونه يحسبون انه النبي صلي الله عليه وسلم فلما اصبحوا ثاروا اليه فاذا هم بعلي رضي الله عنه
 فقالوا : اين صاحبك فقال : لا ادري

 فاقتصوا اثره حتي بلغوا الغار ثم رجعوا ومكث فيه هو وابو بكر رضي الله عنه ثلاث ليال
 واخرج عبد بن حميد عن معاوية بن قرة رضي الله عنه
 ان قريشا اجتمعت في بيت وقالوا : لا يدخل معكم اليوم الا من هو منكم فجاء ابليس فقال له : من انت قال : شيخ من اهل نجد وانا ابن اختكم
 فقالوا : ابن اخت القوم منهم
 فقال بعضهم : اوثقوه
 فقال : ايرضي بنو هاشم بذلك فقال بعضهم : اخرجوه
 فقال : يءويه غيركم
 فقال ابو جهل : ليجتمع من كل بني اب رجل فيقتلوه
 فقال ابليس : هذا الامر الذي قال الفتي
 فانزل الله تعالي هذه الاية @QB@ واذ يمكر بك الذين كفروا ليثبتوك @QE@ الي اخر الاية
 واخرج عبد بن حميد وابن جرير وابو الشيخ عن مجاهد رضي الله عنه في قوله @QB@ ليثبتوك او يقتلوك او يخرجوك @QE@ قال : كفار قريش ارادوا ذلك بمحمد صلي الله عليه وسلم قبل ان يخرج من مكة
 واخرج الحاكم وصححه عن ابن عباس رضي الله عنهما قال : شري علي رضي الله عنه نفسه ولبس ثوب النبي صلي الله عليه وسلم ثم نام مكانه وكان المشركون يحسبون انه رسول الله صلي الله عليه وسلم وكانت قريش تريد ان تقتل النبي صلي الله عليه وسلم فجعلوا يرمقون عليا ويرونه النبي صلي الله عليه وسلم وجعل علي رضي الله يتصور فاذا هو علي رضي الله عنه فقالوا : انك للءيم انك لتتصور وكان صاحبك لا يتصورك ولقد استنكرناه منك
  واخرج الحاكم وصححه عن علي بن الحسين رضي الله عنه وقال في ذلك : وقيت بنفسي خير من وطء الحصي * ومن طاف بالبيت العتيق والحجر رسول الله خاف ان يمكروا به * فنجاه ذو الطول الاله من المكر وبات رسول الله في الغار امنا * وفي حفظ من الله وفي ستر وبت اراعيه وما يتهمونني * وقد وطنت نفسي علي القتل والاسر <
