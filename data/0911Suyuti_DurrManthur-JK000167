 اخرج الفريابي وعبد بن حميد وابن جرير وابن المنذر عن مجاهد في قوله : @QB@ وانفقوا مما جعلكم مستخلفين فيه @QE@ قال : معمرين فيه بالرزق وفي قوله : @QB@ وقد اخذ ميثاقكم @QE@ قال : في ظهر ادم وفي قوله : @QB@ ليخرجكم من الظلمات الي النور @QE@ قال : من الضلالة الي الهدي
 واخرج سعيد بن منصور وابن المنذر وعبد بن حميد عن مجاهد في قوله : @QB@ لا يستوي منكم من انفق من قبل الفتح @QE@ يقول : من اسلم @QB@ وقاتل اولءك اعظم درجة من الذين انفقوا من بعد وقاتلوا @QE@ يعني اسلموا يقول ليس من هاجر كمن لم يهاجر @QB@ وكلا وعد الله الحسني @QE@ قال : الجنة
 واخرج عبد الرزاق وعبد بن حميد وابن المنذر عن قتادة في قوله : @QB@ لا يستوي منكم من انفق من قبل الفتح @QE@ الاية قال : كان قتالان احدهما افضل من الاخر وانت نفقتان احدهما افضل من الاخري قال : كانت النفقة والقتال قبل الفتح فتح مكة افضل من النفقة والقتال بعد ذلك @QB@ وكلا وعد الله الحسني @QE@ قال : الجنة
 واخرج عبد بن حميد وابن المنذر عن عكرمة قال : لما نزلت هذه الاية @QB@ لا يستوي منكم من انفق من قبل الفتح وقاتل @QE@ قال ابو الدحداح : والله لانفقن اليوم نفقة ادرك بها من قبلي ولا يسبقني بها احد بعدي فقال : اللهم كل شء يملكه ابو الدحداح فان نصفه لله حتي بلغ فرد نعله ثم قال : وهذا
 واخرج سعيد بن منصور عن زيد بن اسلم قال : قال رسول الله صلي الله عليه وسلم : ياتيكم قوم من ههنا واشار بيده الي اليمن تحقرون اعمالكم عند اعمالهم قالوا : فنحن خير ام هم قال : بل انتم فلو ان احدهم انفق مثل احد ذهبا ما ادرك احدكم ولا  نصيفه فصلت هذه الاية بيننا وبين الناس @QB@ لا يستوي منكم من انفق من قبل الفتح وقاتل اولءك اعظم درجة من الذين انفقوا من بعد وقاتلوا @QE@
 واخرج ابن جرير وابن ابي حاتم وابن مردويه وابو نعيم في الدلاءل من طريق زيد بن اسلم عن عطاء بن يسار عن ابي سعيد الخدري رضي الله عنه قال : خرجنا مع رسول الله صلي الله عليه وسلم عام الحديبية اذا كان بعسفان قال رسول الله صلي الله عليه وسلم يوشك ان ياتي قوم تحقرون اعمالكم مع اعمالهم قلنا : من هم يا رسول الله اقريش قال : لا ولكنهم اهل اليمن هم ارق افءدة والين قلوبا فقلنا : اهم خير منا يا رسول الله قال : لو كان لاحدهم جبل من ذهب فانفقه ما ادرك مد احدكم ولا نصيفه الا ان هذا فصل ما بيننا وبين الناس @QB@ لا يستوي منكم من انفق من قبل الفتح وقاتل @QE@ الاية
 واخرج احمد عن انس قال : كان بين خالد بن الوليد وبين عبد الرحمن بن عوف كلام فقال خالد لعبد الرحمن بن عوف : تستطيلون علينا بايام سبقتمونا بها فبلغ النبي صلي الله عليه وسلم فقال : دعوا لي اصحابي فوالذي نفسي بيده لو انفقتم مثل احد او مثل الجبال ذهبا ما بلغتم اعمالهم
 واخرج احمد عن يوسف بن عبد الله بن سلام قال : سءل رسول الله صلي الله عليه وسلم : انحن خير ام من بعدنا فقال رسول الله صلي الله عليه وسلم : لو انفق احدهم احدا ذهبا ما بلغ مد احدكم ولا نصيفه
 واخرج ابن بي شيبة والبخاري ومسلم وابو داود والترمذي عن ابي سعيد رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم لا تسبوا اصحابي فوالذي نفسي بيده لو ان احدكم انفق مثل احد ذهبا ما ادرك مد احدهم ولا نصيفه
 واخرج ابن ابي شيبة عن ابن عمر قال : لا تسبوا اصحاب محمد صلي الله عليه وسلم فلمقام احدهم ساعة خير من عمل احدكم عمره
