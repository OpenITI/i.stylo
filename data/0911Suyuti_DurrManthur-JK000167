 واخرج ابن المنذر وابو نعيم عن الحسن ومحمد بن سيرين في قوله @QB@ والسابقون الاولون @QE@ قالوا : هم الذين صلوا القبلتين جميعا وهم اهل بدر
 واخرج ابن مردويه عن ابن عباس @QB@ والسابقون الاولون من المهاجرين @QE@ قال : ابو بكر وعمر وعلي وسلمان وعمار بن ياسر
 واخرج ابن ابي شيبة وابن المنذر وابن ابي حاتم وابن مردويه وابو الشيخ وابو نعيم في المعرفة عن الشعبي في قوله @QB@ والسابقون الاولون @QE@ قال : من ادرك بيعة الرضوان واول من بايع بيعة الرضوان سنان بن وهب الاسدي
  واخرج ابن مردويه عن غيلان بن جرير قال : قلت لانس بن مالك هذا الاسم الانصار انتم سيتموه انفسكم او الله تعالي سماكم من السماء قال : الله تعالي سمانا من السماء
 واخرج ابن ابي شيبة واحمد والنساءي عن معاوية بن ابي سفيان سمعت رسول الله صلي الله عليه وسلم يقول : من احب الانصار احبه الله ومن ابغض الانصار ابغضه الله
 واخرج احمد والبخاري ومسلم عن انس قال : قال رسول الله صلي الله عليه وسلم اية الايمان حب الانصار واية النفاق بغض الانصار
 واخرج احمد عن انس عن النبي صلي الله عليه وسلم انه قال اللهم اغفر للانصار ولابناء الانصار ولازواج الانصار ولذراري الانصار الانصار كرشي وعيبتي ولو ان الناس اخذوا شعبا واخذت الانصار شعبا لاخذت شعب الانصار ولولا الهجرة كنت امرا من الانصار
 واخرج ابن ابي شيبة واحمد عن الحارث بن زياد قال : قال رسول الله صلي الله عليه وسلم من احب الانصار احبه الله حين يلقاه ومن ابغض الانصار ابغضه الله حين يلقاه
 واخرج ابن ابي شيبة عن قيس بن سعد بن عبادة عن النبي صلي الله عليه وسلم
 انه قال اللهم صل علي الانصار وعلي ذرية الانصار وعلي ذرية ذرية الانصار
 واخرج ابن ابي شيبة عن ابي سعيد الخدري رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم لو سلك الناس واديا وشعبا وسلكتم واديا وشعبا لسلكت واديكم وشعبكم انتم شعار والناس دثار ولولا الهجرة لكنت امرا من الانصار ثم رفع يديه حتي اني لاري بياض ابطيه فقال : اللهم اغفر للانصار ولابناء الانصار ولابناء ابناء الانصار
 واخرج ابن ابي شيبة والبخاري ومسلم والترمذي والنساءي وابن ماجة عن البراء بن عازب رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم الانصار لا يحبهم الا مءمن ولا يبغضهم الا منافق ومن احبهم احبه الله ومن ابغضهم ابغضه الله
 واخرج ابن ابي شيبة والترمذي وحسنه عن ابي سعيد الخدري رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم الا ان عيبتي التي اوي اليها اهل بيتي وان كرشي الانصار فاعفوا عن مسيءهم واقبلوا من محسنهم
  واخرج ابن ابي شيبة عن سعد بن عبادة رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم ان هذا الحي من الانصار حبهم ايمان وبغضهم نفاق
 واخرج ابن ابي شيبة عن انس رضي الله عنه سمعت النبي صلي الله عليه وسلم يقول : اللهم اغفر للانصار ولابناء الانصار ولنساء الانصار ولنساء ابناء الانصار ولنساء ابناء ابناء الانصار
 واخرج ابن ابي شيبة والترمذي وحسنه والنساءي عن ابن عباس رضي الله عنهما قال : قال رسول الله صلي الله عليه وسلم : لا يبغض الانصار رجل يءمن بالله واليوم الاخر
 واخرج ابن ابي شيبة عن معاذ بن رفاعة عن ابيه قال : قال رسول الله صلي الله عليه وسلم اللهم اغفر للانصار ولذراري الانصار ولذراري ذراريهم ولمواليهم ولجيرانهم
 واخرج ابن ابي شيبة والبخاري ومسلم عن ابي هريرة رضي الله عنه عن النبي صلي الله عليه وسلم قال قريش والانصار وجهينة ومزينة واسلم وغفار موالي الله ورسوله لا مولي لهم غيره
 واخرج ابن ابي شيبة ومسلم عن ابي سعيد الخدري رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم لا يبغض الانصار رجل يءمن بالله واليوم الاخر
 واخرج الطبراني عن الساءب بن يزيد رضي الله عنه ان رسول الله صلي الله عليه وسلم قسم الفء الذي افاء الله بحنين في اهل مكة من قريش وغيرهم فغضبت الانصار فاتاهم فقال : يا معشر الانصار قد بلغني من حديثكم في هذه المغانم التي اثرت بها اناسا اتالفهم علي الاسلام لعلهم ان يشهدوا بعد اليوم وقد ادخل الله قلوبهم الاسلام يا معشر الانصار الم يمن الله عليكم بالايمان وخصكم بالكرامة وسماكم باحسن الاسماء انصار الله وانصار رسوله ولولا الهجرة لكنت امرا من الانصار ولو سلك الناس واديا وسلكتم واديا لسلكت واديكم
 افلا ترضون ان يذهب الناس بهذه الغناءم والشاء والنعم والبعير وتذهبون برسول الله صلي الله عليه وسلم فقالوا : رضينا
 فقال : اجيبوني فيما قلت
 قالوا : يا رسول الله وجدتنا في ظلمة فاخرجنا الله بك الي النور ووجدتنا علي شفا حفرة من النار فانقذنا الله بك ووجدتنا ضلالا فهدانا الله بك
 فرضينا بالله ربا وبالاسلام دينا وبمحمد نبيا
 فقال : اما والله لو اجبتموني بغير هذا القول لقلت صدقتم لو قلت الم تاتنا طريدا فاويناك ومكذبا فصدقناك ومخذولا  فنصرناك وقبلنا ما رد الناس عليك لو قلتم هذا لصدقتم
 قالوا : بل لله ورسوله المن والفضل علينا وعلي غيرنا
 واخرج ابن ابي حاتم عن عبد الرحمن بن ابي ليلي رضي الله عنه قال : كان الناس علي ثلاث منازل
 المهاجرون الاولون والذين اتبعوهم باحسان والذين جاءوا من بعدهم يقولون : ربنا اغفر لنا ولاخواننا الذين سبقونا بالايمان
 فاحسن ما يكون ان يكون بهذه المنزلة
 واخرج ابن ابي حاتم عن ابن عباس رضي الله عنهما
 انه اتاه رجل فذكر بعض الصحابة فتنقصه فقال ابن عباس @QB@ والسابقون الاولون من المهاجرين والانصار والذين اتبعوهم باحسان @QE@
 واخرج عن ابن زيد في قوله @QB@ والذين اتبعوهم باحسان @QE@ قال : من بقي من اهل الاسلام الي ان تقوم الساعة
 واخرج ابو الشيخ عن عصمة رضي الله عنه قال : سالت سفيان عن التابعين قال : هم الذين ادركوا اصحاب النبي صلي الله عليه وسلم ولم يدركوا النبي صلي الله عليه وسلم سالته عن الذين اتبعوهم باحسان قال : من يجء بعدهم
 قلت : الي يوم القيامة قال : ارجو
 واخرج ابو الشيخ وابن عساكر عن ابي صخر حميد بن زياد قال : قلت لمحمد بن كعب القرظي رضي الله عنه : اخبرني عن اصحاب رسول الله صلي الله عليه وسلم وانما اريد الفتن فقال : ان الله قد غفر لحميع اصحاب النبي صلي الله عليه وسلم واوجب لهم الجنة في كتابه محسنهم ومسيءهم قلت له : وفي اي موضع اوجب الله لهم الجنة في كتابهم قال : الا تقرا @QB@ والسابقون الاولون @QE@ الاية
 اوجب لجميع اصحاب النبي صلي الله عليه وسلم الجنة والرضوان وشرط علي التابعين شرطا لم يشترطه فيهم قلت : وما اشترط عليهم قال : اشترط عليهم ان يتبعوهم باحسان
 يقول : يقتدون بهم في اعمالهم الحسنة ولا يقتدون بهم في غير ذلك
 قال ابو صخر : لكاني لم اقراها قبل ذلك وما عرفت تفسيرها حتي قراها علي محمد بن كعب
 واخرج ابن مردويه من طريق الاوزاعي حدثني يحيي بن ابي كثير والقاسم ومكحول وعبدة بن ابي لبابة وحسان بن عطية
 انهم سمعوا جماعة من اصحاب النبي صلي الله عليه وسلم يقولون لما انزلت هذه الاية @QB@ والسابقون الاولون @QE@ الي قوله @QB@ ورضوا عنه @QE@ قال رسول الله صلي الله عليه وسلم هذا لامتي كلهم وليس بعد الرضا سخط
