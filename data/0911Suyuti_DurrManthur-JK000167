 اخرج عبد الرزاق وسعيد بن منصور واحمد وعبد بن حميد والبخاري ومسلم وابو داود والترمذي والنساءي وابن ماجة وابن جرير وابن المنذر وابن ابي حاتم والبيهقي في الشعب عن ابن مسعود قال : قال رسول الله صلي الله عليه وسلم : من حلف علي يمين هو فيها فاجر ليقتطع بها مال امرء مسلم لقي الله وهو عليه غضبان
 فقال الاشعث بن قيس :  في  والله  كان ذلك كان بيني وبين رجل من اليهود ارض فجحدني فقدمته الي النبي صلي الله عليه وسلم فقال لي رسول اله صلي الله عليه وسلم : الك بينة

 قلت : لا
 فقال لليهودي : احلف

 فقلت : يا رسول الله اذن يحلف فيذهب مالي
 فانزل الله @QB@ ان الذين يشترون بعهد الله وايمانهم ثمنا قليلا @QE@ الي اخر الاية
 واخرج عبد بن حميد والبخاري وابن المنذر وابن ابي حاتم عن عبد الله بن ابي اوفي ان رجلا اقام سلعة له في السوق فحلف بالله لقد اعطي بها ما لم يعطه ليوقع فيها رجلا من المسلمين
 فنزلت هذه الاية @QB@ ان الذين يشترون بعهد الله وايمانهم ثمنا قليلا @QE@ الي اخر الاية
 واخرج احمد وعبد بن حميد والنساءي وابن جرير وابن المنذر والطبراني والبيهقي في الشعب وابن عساكر عن عدي بن بحيرة قال كان بين امرء القيس ورجل من حضرموت خصومة فارتفعا الي النبي صلي الله عليه وسلم فقال للحضرمي : بينتك والا فيمينه قال : يا رسول الله ان حلف ذهب بارضي فقال رسول الله صلي الله عليه وسلم : من حلف علي يمين كاذبة ليقتطع بها حق اخيه لقي الله وهو عليه غضبان
 فقال امرء القيس : يا رسول الله فما لمن تركها وهو يعلم انها حق قال : الجنة

 فقال : اشهدك اني قد تركتها
 فنزلت هذه الاية @QB@ ان الذين يشترون بعهد الله وايمانهم ثمنا قليلا @QE@ الي اخر الاية
 لفظ ابن جرير
 واخرج ابن جرير عن ابن جريج ان الاشعث بن قيس اختصم هو ورجل الي رسول الله صلي الله عليه وسلم في ارض كانت في يده لذلك الرجل اخذها في الجاهلية فقال رسول الله صلي الله عليه وسلم : اقم بينتك قال الرجل : ليس يشهد لي احد علي الاشعث قال : فلك يمينه فقال الاشعث : نحلف
 فانزل الله @QB@ ان الذين يشترون بعهد الله @QE@ الاية
 فنكل الاشعث وقال : اني اشهد الله واشهدكم ان خصمي صادق فرد اليه ارضه وزاده من ارض نفسه زيادة كثيرة
 واخرج ابن جرير عن الشعبي ان رجلا اقام سلعته من اول النهار فلما كان اخره جاء رجل يساومه فحلف لقد منعها اول النهار من كذا ولولا المساء ما باعها به
 فانزل الله @QB@ ان الذين يشترون بعهد الله وايمانهم ثمنا قليلا @QE@
 واخرج ابن جرير عن مجاهد
 نحوه
 واخرج ابن جرير عن عكرمة قال : نزلت هذه الاية @QB@ ان الذين يشترون بعهد الله وايمانهم ثمنا قليلا @QE@  في ابي رافع وكنانة بن ابي الحقيق وكعب بن الاشرف وحيي بن اخطب
 واخرج ابن ابي شيبة من طريق ابن عون عن ابراهيم ومحمد والحسن في قوله @QB@ ان الذين يشترون بعهد الله وايمانهم ثمنا قليلا @QE@ قالوا : هو الرجل يقتطع مال الرجل بيمينه
 واخرج مسلم وابو داود والترمذي عن واءل بن حجر قال جاء رجل من حضرموت ورجل من كندة الي النبي صلي الله عليه وسلم فقال الحضرمي : يا رسول الله ان هذا قد غلبني علي ارض كانت لابي
 قال الكندي : هي ارض كانت في يدي ازرعها ليس له فيها حق فقال النبي صلي الله عليه وسلم للحضرمي : الك بينة قال : لا
 قال : فلك يمينه فقال : يا رسول الله ان الرجل فاجر لا يبالي ما حلف عليه وليس يتورع عن شء فقال : ليس لك منه الا ذلك فانطلق ليحلف فقال رسول الله صلي الله عليه وسلم لما ادبر : لءن حلف علي مال لياكله ظلما ليلقين الله وهو عنه معرض
 واخرج ابو داود وابن ماجة عن الاشعث بن قيس ان رجلا من كندة واخر من حضرموت اختصما الي رسول الله صلي الله عليه وسلم في ارض من اليمن فقال الحضرمي : يا رسول الله ان ارضي اغتصبها ابو هذا وهي في يده فقال : هل لك بينة قال : لا ولكن احلفه والله ما يعلم انها ارضي اغتصبها ابوه
 فتهيا الكندي لليمين فقال رسول الله صلي الله عليه وسلم : لا يقتطع احد مالا بيمين الا لقي الله وهو اجذم فقال الكندي : هي ارضه
 واخرج احمد والبزار وابو يعلي والطبراني بسند حسن عن ابي موسي قال : اختصم رجلان الي النبي صلي الله عليه وسلم في ارض احدهما من حضرموت فجعل يمين احدهما فضج الاخر وقال : اذن يذهب بارضي فقال : ان هو اقتطعها بيمينه ظلما كان ممن لا ينظر الله اليه يوم القيامة ولا يزكيه وله عذاب اليم قال : وورع الاخر فردها
 واخرج احمد بن منيع في مسنده والحاكم وصححه والبيهقي في سننه عن ابن مسعود قال : كنا نعد من الذنب الذي ليس له كفارة اليمين الغموس قيل : وما اليمين الغموس فقال : الرجل يقتطع بيمينه مال الرجل
 واخرج ابن حبان والطبراني والحاكم وصححه عن الحرث بن البرصاء : سمعت  رسول الله صلي الله عليه وسلم في الحج بين الجمرتين وهو يقول : من اقتطع مال اخيه بيمين فاجرة فليتبوا مقعده من النار ليبلغ شاهدكم غاءبكم مرتين او ثلاثا
 واخرج البزار عن عبد الرحمن بن عوف ان النبي صلي الله عليه وسلم قال : اليمين الفاجرة تذهب بالمال
 واخرج البيهقي عن ابي هريرة قال قال رسول الله صلي الله عليه وسلم : ليس مما عصي الله به هو اعجل عقابا من البغي وما من شء اطيع الله فيه اسرع ثوابا من الصلة
 واليمين الفاجرة تدع الديار بلاقع
 واخرج الحرث بن ابي اسامة والحاكم وصححه عن كعب بن مالك سمعت رسول الله صلي الله عليه وسلم يقول : من اقتطع مال امرء مسلم بيمين كاذبة كانت نكتة سوداء في قلبه لا يغيرها شء الي يوم القيامة
 واخرج الطبراني والحاكم وصححه عن جابر بن عتيك قال قال رسول الله صلي الله عليه وسلم : من اقتطع مال مسلم بيمينه حرم الله عليه الجنة واوجب له النار
 فقيل : يا رسول الله وان شيءا يسيرا قال : وان سواكا
 واخرج مالك وابن سعد واحمد ومسلم والنساءي وابن ماجة عن ابي امامة اياس ابن ثعلبة الحارثي ان رسول الله صلي الله عليه وسلم قال : من اقتطع حق امرء مسلم بيمينه فقد اوجب الله له النار وحرم الله عليه الجنة
 قالوا : وان كان شيءا يسيرا يا رسول الله قال : وان كان قضيبا من اراك ثلاثا
 واخرج ابن ماجة بسند صحيح عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : لا يحلف عند هذا المنبر عبد ولا امة علي يمين اثمة ولو علي سواك رطبة الا وجبت له النار
 واخرج ابن ماجة وابن حبان عن جابر بن عبد الله قال : قال رسول الله صلي الله عليه وسلم : من حلف علي يمين اثمة عند منبري هذا فليتبوا مقعده من النار ولو علي سواك اخضر
 قال ابو عبيد والخطابي : كانت اليمين علي عهده صلي الله عليه وسلم عند المنبر
 واخرج عبد الرزاق عن ابي هريرة قال قال رسول الله صلي الله عليه وسلم : ان اليمين الكاذبة تنفق السلعة وتمحق الكسب
 واخرج عبد الرزاق عن ابي سويد قال : سمعت رسول الله صلي الله عليه وسلم يقول : ان اليمين الفاجرة تعقم الرحم وتقل العدد وتدع الديار بلاقع
  واخرج البخاري ومسلم والبيهقي في الاسماء والصفات عن ابي هريرة عن النبي صلي الله عليه وسلم قال : ثلاثة لا يكلمهم الله ولا ينظر اليهم ولهم عذاب اليم : رجل حلف يمينا علي مال مسلم فاقتطعه ورجل حلف علي يمين بعد العصر انه اعطي بسلعته اكثر مما اعطي وهو كاذب ورجل منع فضل ماء فان الله سبحانه يقول : اليوم امنعك فضلي كما منعت فضل ما لم تعمل يداك
 واخرج عبد الرزاق وعبد بن حميد وابو داود وابن جرير والحاكم وصححه عن عمران بن حصين انه كان يقول : من حلف علي يمين فاجرة يقتطع بها مال اخيه فليتبوا مقعده من النار
 فقال له قاءل : شء سمعته من رسول الله صلي الله عليه وسلم قال لهم : انكم لتجدون ذلك ثم قرا @QB@ ان الذين يشترون بعهد الله وايمانهم @QE@ الاية
 واخرج البخاري عن ابن ابي مليكة ان امراتين كانتا تخرزان في بيت فخرجت احداهما وقد انفذ باشفاء في كفها فادعت علي الاخري فرفع الي ابن عباس فقال ابن عباس : قال رسول الله صلي الله عليه وسلم : لو يعطي الناس بدعواهم لذهب دماء قوم واموالهم ذكروها بالله واقرووا عليها @QB@ ان الذين يشترون بعهد الله @QE@ الاية
 فذكروها فاعترفت
