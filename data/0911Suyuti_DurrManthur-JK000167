 واخرج الفريابي عن مجاهد رضي الله عنه في قوله @QB@ لقد نصركم الله في مواطن كثيرة @QE@ قال : هي اول ما انزل الله تعالي من سورة براءة
 واخرج ابن ابي شيبة وسنيد وابن حرب وابن المنذر وابن ابي حاتم عن مجاهد رضي الله عنه قال : اول ما نزل من براءة @QB@ لقد نصركم الله في مواطن كثيرة @QE@ يعرفهم نصره ويوطنهم لغزوة تبوك
 واخرج ابو الشيخ عن الضحاك رضي الله عنه في قوله @QB@ لقد نصركم الله في مواطن كثيرة @QE@ قال : هذا مما يمن الله به عليهم من نصره اياهم في مواطن كثيرة
 واخرج ابن ابي حاتم وابو الشيخ عن قتادة رضي الله عنه قال @QB@ حنين @QE@ ماء بين مكة والطاءف قاتل النبي صلي الله عليه وسلم هوازن وثقيف وعلي هوازن مالك بن عوف وعلي ثقيف عبد يا ليل بن عمرو الثقفي
 واخرج ابن ابي حاتم عن عروة رضي الله عنه ان النبي صلي الله عليه وسلم اقام عام الفتح نصف شهر ولم يزد علي ذلك حتي جاءته هوازن وثقيف فنزلوا بحنين وحنين واد الي جنب ذي المجاز
 واخرج ابن المنذر عن الحسن رضي الله عنه قال لما اجتمع اهل مكة واهل المدينة قالوا : الان والله نقاتل حين اجتمعنا فكره رسول الله صلي الله عليه وسلم ما قالوا وما اعجبهم من كثرتهم فالتقوا فهزمهم الله حتي ما يقوم منهم احد علي احد حتي جعل رسول الله صلي الله عليه وسلم ينادي احياء العرب الي فوالله ما يعرج اليه احد حتي اعري موضعه فالتفت الي الانصار وهم ناحية ناحية فناداهم : يا انصار الله وانصار رسوله الي عباد الله انا رسول الله فعطفوا وقالوا : يا رسول الله ورب الكعبة اليك والله فنكسوا رءوسهم يبكون وقدموا اسيافهم يضربون بين يدي رسول الله صلي الله عليه وسلم حتي فتح الله عليهم
 واخرج البيهقي في الدلاءل عن الربيع رضي الله عنه ان رجلا قال يوم حنين : لن نغلب من قلة
 فشق ذلك علي رسول الله صلي الله عليه وسلم فانزل الله عز وجل @QB@ ويوم حنين اذ اعجبتكم كثرتكم @QE@  قال الربيع : وكانوا اثني عشر الفا منهم الفان من اهل مكة
 واخرج ابن سعد وابن ابي شيبة واحمد البغوي في معجمه وابن مردويه والبيهقي في الدلاءل عن ابي عبد الرحمن الفهري رضي الله عنه قال : كنا مع رسول الله صلي الله عليه وسلم في حنين فسرنا في يوم قاءظ شديد الحر فنزلنا تحت ظلال الشجر فلما زالت الشمس لبست لامتي وركبت فرسي فاتيت رسول الله صلي الله عليه وسلم فقلت : السلام عليك يا رسول الله ورحمة الله وبركاته قد حان الرواح يا رسول الله
 قال اجل ثم قال رسول الله صلي الله عليه وسلم : يا بلال

 فثار من تحت سمرة كان ظله ظل طاءر فقال : لبيك وسعديك وانا فداءك
 ثم قال : اسرج لي فرسي
 فاتاه بدفتين من ليف ليس فيهما اشر ولا بطر قال : فركب فرسه ثم سرنا يومنا فلقينا العدو وتشامت الخيلان فقاتلناهم فولي المسلمون مدبرين كما قال الله عز وجل فجعل رسول الله صلي الله عليه وسلم يقول : يا عباد الله انا عبد الله ورسوله فاقتحم رسول الله صلي الله عليه وسلم عن فرسه وحدثني من كان اقرب اليه مني : انه اخذ حفنة من تراب فحثاها في وجوه القوم وقال : شاهت الوجوه

 قال يعلي بن عطاء رضي الله عنه : فاخبرنا ابناءهم عن اباءهم انهم قالوا : ما بقي منا احد الا امتلات عيناه وفمه من التراب وسمعنا صلصلة من السماء كمر الحديد علي الطست الحديد فهزمهم الله عز وجل
 واخرج الطبراني والحاكم وابو نعيم والبيهقي في الدلاءل عن عبد الله بن مسعود رضي الله عنه قال : كنت مع رسول الله صلي الله عليه وسلم يوم حنين فولي الناس عنه وبقيت معه في ثمانين رجلا من المهاجرين والانصار فكنا علي اقدامنا نحو من ثمانين قدما ولم نولهم الدبر وهم الذين انزل الله عليهم السكينة ورسول الله صلي الله عليه وسلم علي بغلته فمضي قدما فقال ناولني كفا من تراب
 فناولته فضرب وجوههم فامتلات اعينهم ترابا وولي المشركون ادبارهم
 واخرج ابن ابي شيبة واحمد والحاكم وصححه وابن مردويه والبيهقي في الدلاءل عن انس رضي الله عنه
 ان هوازن جاءت يوم حنين بالنساء والصبيان والابل والغنم فجعلوهم صفوفا ليكثروا علي رسول الله صلي الله عليه وسلم فالتقي المسلمون والمشركون فولي المسلمون مدبرين كما قال الله عز وجل فقال رسول الله صلي الله عليه وسلم يا عباد الله انا عبد الله ورسوله ثم قال : يا معشر الانصار انا عبد الله ورسوله فهزم الله المشركين ولم يضرب بسيف ولم يطعن برمح
  واخرج عبد الرزاق وابن سعد واحمد ومسلم والنساءي وابن المنذر وابن ابي حاتم والحاكم وصححه وابن مردويه عن العباس بن عبد المطلب قال شهدت مع رسول الله صلي الله عليه وسلم يوم حنين فلقد رايت النبي صلي الله عليه وسلم وما معه الا انا وابو سفيان بن الحرث بن عبد المطلب فلزمنا رسول الله صلي الله عليه وسلم فلم نفارقه وهو علي بلغته الشهباء التي اهداها له فروة بن معاوية الجذامي فلما التقي المسلمون والمشركون ولي المسلمون مدبرين وطفق النبي صلي الله عليه وسلم يركض بغلته قبل الكفار وانا اخذ بلجامها اكفها ارادة ان لا تسرع وهو لا يالو ما اسرع نحو المشركين وابو سفيان بن الحرث اخذ بغرز رسول الله صلي الله عليه وسلم
 فقال رسول الله صلي الله عليه وسلم : يا عباس نادي اصحاب السمرة يا اصحاب سورة البقرة فوالله لكاني عطفتهم حين سمعوا صوتي عطفة البقر علي اولادها ينادون يا لبيك يا لبيك فاقبل المسلمون فاقتتلوا هم والكفار وارتفعت الاصوات وهم يقولون : يا معشر الانصار يا معشر الانصار
 ثم قصرت الدعوة علي بني الحرث بن الخزرج فتطاول رسول الله صلي الله عليه وسلم وهو علي بغلته فقال : هذا حين حمي الوطيس ثم اخذ رسول الله صلي الله عليه وسلم حصيات فرمي بهن وجوه الكفار ثم قال : انهزموا ورب الكعبة
 فذهبت انظر فاذا القتال علي هيءته فيما اري فما هو الا ان رماهم رسول الله صلي الله عليه وسلم بحصيات فما زلت اري حدهم كليلا وامرهم مدبرا حتي هزمهم الله عز وجل
 واخرج الحاكم وصححه عن جابر رضي الله عنه قال : ندب رسول الله صلي الله عليه وسلم يوم حنين الانصار فقال : يا معشر الانصار
 فاجابوه لبيك  بابينا انت وامنا  يا رسول الله
 قال اقبلوا بوجوهكم الي الله ورسوله يدخلكم جنات تجري من تحتها الانهار
 فاقبلوا ولهم حنين حتي احدقوا به كبكبة تحاك مناكبهم يقاتلون حتي هزم الله المشركين
 واخرج ابو الشيخ والحاكم وصححه وابن مردويه عن انس رضي الله عنه قال : لما اجتمع يوم حنين اهل مكة واهل المدينة اعجبتهم كثرتهم فقال القوم : اليوم والله نقاتل فلما التقوا واشتد القتال ولوا مدبرين فندب رسول الله صلي الله عليه وسلم الانصار فقال : يا معشر المسلمين الي عباد الله انا رسول الله
 فقالوا : اليك  والله  جءنا فنكسوا رءوسهم ثم قاتلوا حتي فتح الله عليهم
 واخرج الحاكم عن عبادة بن الصامت رضي الله عنه قال اخذ رسول الله صلي الله عليه وسلم يوم حنين وبرة من بعير ثم قال : ايها الناس انه لا يحل لي مما افاء الله عليكم قدر  هذه الا الخمس والخمس مردود عليكم فادوا الخيط والمخيط واياكم والغلول فانه عار علي اهله يوم القيامة وعليكم بالجهاد في سبيل الله فانه باب من ابواب الجنة يذهب الله به الهم والغم وكان رسول الله صلي الله عليه وسلم يكره الانفال ويقول : ليرد قوي المءمنين علي ضعيفهم
 واخرج ابن مردويه عن ابن عمر رضي الله عنهما قال : رايتنا يوم حنين وان الفءتين لموليتان وعن عكرمة قال : لما كان يوم حنين ولي المسلمون وولي المشركون وثبت رسول الله صلي الله عليه وسلم فقال انا محمد رسول الله ثلاث مرات  والي جنبه عمه العباس  فقال النبي صلي الله عليه وسلم لعمه : يا عباس اذن يا اهل الشجرة فاجابوه من كل مكان لبيك لبيك حتي اظلوه برماحهم ثم مضي فوهب الله له الظفر فانزل الله @QB@ ويوم حنين اذ اعجبتكم كثرتكم @QE@ الاية
 واخرج ابو الشيخ عن محمد بن عبيد الله بن عمير الليثي رضي الله عنه قال كان مع النبي صلي الله عليه وسلم اربعة الاف من الانصار والف من جهينة والف من مزينة والف من اسلم والف من غفار والف من اشجع والف من المهاجرين وغيرهم فكان معه عشرة الاف
 وخرج باثني عشر الفا وفيها قال الله تعالي في كتابه @QB@ ويوم حنين اذ اعجبتكم كثرتكم فلم تغن عنكم شيءا @QE@
 واخرج ابن سعد وابن ابي شيبة والبخاري ومسلم وابن مردويه عن البراء بن عازب رضي الله عنه
 انه قيل له : هل كنتم وليتم يوم حنين قال : والله ما ولي رسول الله صلي الله عليه وسلم ولكن خرج شبان اصحابه واخفاءهم حسرا ليس عليهم سلاح فلقوا جمعا رماة هوازن وبني النضر ما يكاد يسقط لهم سهم فرشقوهم رشقا ما كادوا يخطءون فاقبلوا هنالك الي رسول الله صلي الله عليه وسلم وهو علي بغلته البيضاء وابن عمه ابو سفيان بن الحرث بن عبد المطلب يقود به فنزل ودعا واستنصر ثم قال : انا النبي لا كذب * انا ابن عبد المطلب ثم صف اصحابه
 واخرج ابن ابي حاتم عن السدي رضي الله عنه في قوله @QB@ وانزل جنودا لم تروها وعذب الذين كفروا @QE@ قال : قتلهم بالسيف
 واخرج ابن ابي حاتم عن سعيد بن جبير رضي الله عنه قال : في يوم حنين امد  الله رسوله صلي الله عليه وسلم بخمسة الاف من الملاءكة مسومين ويومءذ سمي الله تعالي الانصار مءمنين قال @QB@ ثم انزل الله سكينته علي رسوله وعلي المءمنين @QE@
 واخرج ابن اسحق وابن المنذر وابن مردويه وابو نعيم والبيهقي عن جبير بن مطعم رضي الله عنه قال : رايت قبل هزيمة القوم  والناس يقتتلون  مثل البجاد الاسود اقبل من السماء حتي سقط بين القوم فنظرت فاذا نمل اسود مبثوث قد ملا الوادي لم اشك انها الملاءكة عليهم السلام ولم يكن الا هزيمة القوم

 واخرج ابن ابي شيبة وابن المنذر وابن ابي حاتم وابو الشيخ عن سعيد بن جبير رضي الله عنه في قوله @QB@ وعذب الذين كفروا @QE@ قال : بالهزيمة
 واخرج ابن المنذر وابن ابي حاتم عن ابن ابزي رضي الله عنه في قوله @QB@ وعذب الذين كفروا @QE@ قال : بالهزيمة والقتل
 وفي قوله @QB@ ثم يتوب الله من بعد ذلك علي من يشاء @QE@ قال : علي الذين انهزموا عن النبي صلي الله عليه وسلم يوم حنين
 واخرج ابن سعد والبخاري في التاريخ والحاكم وصححه والبيهقي في الدلاءل عن عبد الله بن عياض بن الحرث عن ابيه
 قال : ان رسول صلي الله عليه وسلم اتي هوازن في اثني عشر الفا فقتل من الطاءف يوم حنين مثل قتلي يوم بدر واخذ رسول الله صلي الله عليه وسلم كفا من حصباء فرمي بها وجوهنا فانهزمنا
 واخرج احمد ومسلم عن سلمة بن الاكوع رضي الله عنه قال : غزونا مع رسول الله صلي الله عليه وسلم حنينا فلما واجهنا العدو وتقدمت فاعلو ثنية فاستقبلني رجل من العدو فارميته بسهم فتواري عني فما دريت ما صنع فنظرت الي القوم فاذا هم قد طلعوا من ثنية اخري فالتقوا هم واصحاب والنبي صلي الله عليه وسلم وانا متزر وارجع منهزما وعلي بردتان متزرا باحدهما مرتديا بالاخري فاستطلق ازاري فجمعتهما جميعا ومررت علي رسول الله صلي الله عليه وسلم منهزما وهو علي بغلته الشهباء فقال رسول الله صلي الله عليه وسلم لقد راي ابن الاكوع فزعا فلما غشوا رسول الله صلي الله عليه وسلم نزل عن البغلة ثم قبض قبضة من تراب من الارض ثم استقبل به وجوههم فقال : شاهت الوجوه
 فما خلق الله منهم انسانا الا ملا عينيه ترابا بتلك القبضة فولوا مدبرين فهزمهم الله تعالي وقسم رسول الله صلي الله عليه وسلم غناءمهم بين المسلمين
 واخرج البخاري في التاريخ والبيهقي في الدلاءل عن عمرو بن سفيان الثقفي رضي  الله عنه قال قبض رسول الله صلي الله عليه وسلم يوم حنين قبضة من الحصي فرمي بها في وجوهنا فانهزمنا فما خيل الينا الا ان كل حجر او شجر فارس يطلبنا
 واخرج البخاري في التاريخ وابن مردويه والبيهقي عن يزيد بن عامر السواءي  وكان شهد حنينا مع المشركين ثم اسلم  قال : اخذ رسول الله صلي الله عليه وسلم يوم حنين قبضة من الارض فرمي بها في وجوه المشركين وقال : ارجعوا شاهت الوجوه فما احد يلقاه اخوه الا وهو يشكو قذي في عينيه ويمسح عينيه
 واخرج مسدد في مسنده والبيهقي وابن عساكر عن عبد الرحمن مولي ام برثن قال : حدثني رجل كان من المشركين يوم حنين قال : لما التقينا نحن واصحاب رسول الله صلي الله عليه وسلم لم يقوموا لنا حلب شاة الا كفيناهم فبينا نحن نسوقهم في ادبارهم اذ التقينا الي صاحب البغلة البيضاء فاذا هو رسول الله صلي الله عليه وسلم فتلقتنا عنده رجال بيض حسان الوجوه قالوا لنا : شاهت الوجوه ارجعوا
 فرجعنا وركبوا اكتافنا وكانت اياها
 واخرج البيهقي من طريق ابن اسحق حدثنا امية بن عبد الله بن عمرو بن عثمان بن عفان انه حدث ان مالك بن عوف رضي الله عنه بعث عيونا فاتوه وقد تقطعت اوصالهم فقال : ويلكم ما شانكم فقالوا : اتانا رجال بيض علي خيل بلق فوالله ما تماسكنا ان اصابنا ما تري
 واخرج ابن مردويه والبيهقي وابن عساكر عن مصعب بن شيبة بن عثمان الحجبي عن ابيه قال خرجت مع النبي صلي الله عليه وسلم يوم حنين والله ما خرجت اسلاما ولكن خرجت اتقاء ان تظهر هوازن علي قريش فوالله اني لواقف مع رسول الله صلي الله عليه وسلم اذ قلت : يا نبي الله اني لاري خيلا بلقا

 قال : يا شيبة انه لا يراها الا كافر
 فضرب بيده عند صدري حتي ما اجد من خلق الله تعالي احب الي منه فقال : فالتقي المسلمون فقتل من قتل ثم اقبل النبي وعمر رضي الله عنه اخذ باللجام والعباس اخذ بالغرز فنادي العباس رضي الله عنه : اين المهاجرون اين اصحاب سورة البقرة  بصوت عال  هذا رسول الله صلي الله عليه وسلم
 فاقبل الناس والنبي صلي الله عليه وسلم يقول : انا النبي غير كذب * انا ابن عبد المطلب فاقبل المسلمون فاصطكوا بالسيوف فقال النبي صلي الله عليه وسلم : الان حمي الوطيس
