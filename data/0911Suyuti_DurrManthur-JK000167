 واخرج عبد الرزاق واحمد وعبد بن حميد ومسلم وابن جرير وابن المنذر والترمذي وابن مردويه والبيهقي في الدلاءل عن انس قال : سال اهل مكة النبي صلي الله عليه وسلم اية فانشق القمر بمكة فرقتين فنزلت @QB@ اقتربت الساعة وانشق القمر @QE@ الي قوله @QB@ سحر مستمر @QE@ اي ذاهب
 واخرج البخاري ومسلم وابن جرير عن انس ان اهل مكة سالوا رسول الله صلي الله عليه وسلم ان يريهم اية فاراهم القمر شقتين حتي راوا حراء بينهما
 واخرج عبد بن حميد والحاكم وصححه وابن مردويه والبيهقي في الدلاءل من طريق مجاهد عن ابي معمر عن ابن مسعود قال : رايت القمر منشقا شقتين بمكة قبل ان يخرج النبي صلي الله عليه وسلم شقة علي ابي قبيس وشقة علي السويداء فقالوا : سحر القمر فنزلت @QB@ اقتربت الساعة وانشق القمر @QE@ قال مجاهد : يقول كما رايتم القمر منشقا فان الذي اخبركم عن @QB@ اقتربت الساعة @QE@ حق
 واخرج عبد بن حميد والبخاري ومسلم والترمذي وابن جرير وابن مردويه من طريق ابي معمر عن ابن مسعود قال : انشق القمر علي عهد رسول الله صلي الله عليه وسلم فرقتين فرقة فوق الجبل وفرقة دونه فقال رسول الله صلي الله عليه وسلم : اشهدوا
 واخرج احمد وعبد بن حميد وابن جرير والحاكم وصححه وابن مردويه وابو نعيم في الدلاءل من طريق الاسود عن عبد الله قال : رايت القمر علي الجبل وقد انشق فابصرت الجبل من بين فرجتي القمر
 واخرج ابن جرير وابن المنذر وابن مردويه وابو نعيم والبيهقي كلاهما في الدلاءل من طريق مسروق عن ابن مسعود قال : انشق القمر علي عهد النبي صلي الله عليه وسلم فقالت قريش : هذا سحر ابن ابي كبشة فقالوا : انتظروا ما ياتيكم به السفار فان محمدا لا يستطيع ان يسحر الناس كلهم فجاء السفار فسالوهم فقالوا : نعم قد رايناه فانزل الله @QB@ اقتربت الساعة وانشق القمر @QE@
  واخرج البخاري ومسلم وابن مردويه والبيهقي في الدلاءل عن ابن عباس قال : انشق القمر في زمان النبي صلي الله عليه وسلم
 واخرج ابن مردويه وابو نعيم في الدلاءل من طريق علقمة عن ابن مسعود قال : كنا مع النبي صلي الله عليه وسلم بمني فانشق القمر حتي صار فرقتين فتوارت فرقة خلف الجبل فقال النبي صلي الله عليه وسلم : اشهدوا
 واخرج مسلم والترمذي وابن جرير وابن المنذر وابن مردويه والحاكم والبيهقي وابو نعيم في الدلاءل من طريق مجاهد عن ابن عمر في قوله @QB@ اقتربت الساعة وانشق القمر @QE@ قال : كان ذلك علي عهد رسول الله صلي الله عليه وسلم انشق فرقتين فرقة من دون الجبل وفرقة خلفه فقال النبي صلي الله عليه وسلم : اللهم اشهد
 واخرج احمد وعبد بن حميد والترمذي وابن جرير والحاكم وابو نعيم والبيهقي عن جبير بن مطعم في قوله @QB@ وانشق القمر @QE@ قال : انشق القمر ونحن بمكة علي عهد رسول الله صلي الله عليه وسلم حتي صار فرقتين فرقة علي هذا الجبل وفرقة علي هذا الجبل فقال الناس : سحرنا محمد فقال رجل : ان كان سحركم فانه لا يستطيع ان يسحر الناس كلهم
 واخرج ابن جرير وابن مردويه وابو نعيم في الدلاءل عن ابن عباس في قوله @QB@ اقتربت الساعة وانشق القمر @QE@ قال : قد مضي ذلك قبل الهجرة انشق القمر حتي راوا شقيه
 واخرج الطبراني وابن مردويه من طريق عكرمة عن ابن عباس قال : كسف القمر علي عهد رسول الله صلي الله عليه وسلم فقالوا : سحر القمر فنزلت @QB@ اقتربت الساعة وانشق القمر @QE@ الي قوله @QB@ مستمر @QE@
 واخرج ابو نعيم في الحلية من طريق عطاء والضحاك عن ابن عباس في قوله @QB@ اقتربت الساعة وانشق القمر @QE@ قال : اجتمع المشركون علي عهد رسول الله صلي الله عليه وسلم منهم الوليد بن المغيرة وابو جهل بن هشام والعاصي بن واءل والعاصي بن هشام والاسود بن عبد يغوث والاسود بن المطلب وزمعة بن الاسود والنضر بن الحرث فقالوا للنبي صلي الله عليه وسلم : ان كنت صادقا فشق لنا القمر فرقتين نصفا علي ابي قبيس ونصفا علي قعيقعان فقال لهم النبي صلي الله عليه وسلم : ان فعلت تءمنوا قالوا : نعم وكانت ليلة بدر فسال رسول الله صلي الله عليه وسلم ربه ان يعطيه ما سالوا فامسي القمر قد مثل نصفا علي ابي  قبيس ونصفا علي قعيقعان ورسول الله صلي الله عليه وسلم ينادي يا ابا سلمة بن عبد الاسد والارقم بن ابي الارقم اشهدوا
 واخرج ابو نعيم من طريق عطاء عن ابن عباس قال : انتهي اهل مكة الي النبي صلي الله عليه وسلم فقالوا : هل من اية نعرف بها انك رسول الله فهبط جبريل فقال : يا محمد قل : يا اهل مكة ان تختلفوا هذه الليلة فسترون اية فاخبرهم رسول الله صلي الله عليه وسلم بمقالة جبريل فخرجوا ليلة اربع عشرة فانشق القمر نصفين نصفا علي الصفا ونصفا علي المروة فنظروا ثم مالوا بابصارهم فمسحوها ثم اعادوا النظر فنظروا ثم مسحوا اعينهم ثم نظروا فقالوا : يا محمد ما هذا الا سحر ذاهب فانزل الله @QB@ اقتربت الساعة وانشق القمر @QE@
 واخرج ابو نعيم من طريق الضحاك عن ابن عباس قال : جاءت احبار اليهود الي رسول الله صلي الله عليه وسلم فقالوا : ارنا اية حتي نءمن فسال النبي صلي الله عليه وسلم ربه ان يريه اية فاراهم القمر قد انشق فصار قمرين احدهما علي الصفا والاخر علي المروة قدر ما بين العصر الي الليل ينظرون اليه ثم غاب القمر فقالوا : هذا @QB@ سحر مستمر @QE@
 واخرج ابن ابي شيبة وعبد بن حميد وعبد الله بن احمد في زواءد الزهد وابن جرير وابن مردويه وابو نعيم عن ابي عبد الرحمن السلمي قال : خطبنا حذيفة بن اليمان بالمداءن فحمد الله واثني عليه ثم قال @QB@ اقتربت الساعة وانشق القمر @QE@ الا وان الساعة قد اقتربت الا وان القمر قد انشق علي عهد رسول الله صلي الله عليه وسلم الا وان الدنيا قد اذنت بفراق الا وان اليوم الضمار وغدا السباق
 واخرج ابن المنذر عن حذيفة انه قرا [ اقتربت الساعة وقد انشق القمر ]
 واخرج ابن المنذر عن الضحاك قال : كان انشقاق القمر ورسول الله صلي الله عليه وسلم بمكة قبل ان يهاجر فقالوا : هذا سحر اسحر السحرة فاقلعوا كما فعل المشركون اذا كسف القمر ضربوا بطساسهم وعما اصفر احبارهم وقالوا : هذا فعل السحر وذلك قوله @QB@ وان يروا اية يعرضوا ويقولوا سحر مستمر @QE@
 واخرج ابن مردويه عن ابن عباس قال : ثلاث ذكرهن الله في القران قد مضين @QB@ اقتربت الساعة وانشق القمر @QE@ قد انشق القمر علي عهد رسول الله صلي الله عليه وسلم شقتين  حتي راه الناس ( سيهزم الجمع ويولون الدبر ) ( سورة القمر  ) وقد ( فتحنا عليهم بابا ذا عذاب شديد ) ( سورة المءمنون  )
 واخرج الفريابي وعبد بن حميد وابن جرير عن مجاهد في قوله @QB@ اقتربت الساعة وانشق القمر @QE@ قال : راوه منشقا فقالوا : هذا سحر ذاهب
 واخرج ابن ابي حاتم عن مجاهد @QB@ وكل امر مستقر @QE@ قال : يوم القيامة
 واخرج ابن المنذر عن ابن جريج @QB@ وكل امر مستقر @QE@ قال : باهله
 واخرج عبد بن حميد وابن المنذر وابن جرير عن قتادة @QB@ وكل امر مستقر @QE@ قال : مستقر باهل الخير الخير وباهل الشر الشر
