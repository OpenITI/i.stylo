 واخرج سعيد بن منصور وابن جرير وابن ابي حاتم عن عكرمة رضي الله عنه قال : لا يعيبن احدكم دابته ولا ثوبه فان كل شء يسبح بحمده
 واخرج ابن المنذر وابن ابي حاتم وابو الشيخ والخطيب عن ابي صالح رضي الله عنه قال : ذكر لنا ان صرير الباب تسبيحه
 واخرج ابن ابي حاتم عن ابي غالب الشيباني رضي الله عنه قال : صوت البحر تسبيحه وامواجه صلاته
 واخرج ابن ابي حاتم عن النخعي رضي الله عنه قال : الطعام تسبيح
 واخرج ابن ابي شيبة واحمد في الزهد وابو الشيخ عن ميمون بن مهران رضي الله عنه قال : اتي ابو بكر الصديق رضي الله عنه بغراب وافر الجناحين فجعل ينشر جناحه ويقول : ما صيد من صيد ولا عضدت من شجرة الا بما ضيعت من التسبيح
 واخرج ابن راهويه في مسنده من طريق الزهري رضي الله عنه قال : اتي ابو بكر الصديق رضي الله عنه بغراب وافر الجناحين فقال : سمعت رسول الله صلي الله عليه سلم يقول : ما صيد من صيد ولا عضدت عضاة ولا قطعت وشيجة الا بقلة التسبيح
 واخرج ابو نعيم في الحلية وابن مردويه عن ابي هريرة رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : ما صيد من صيد ولا وشج من وشج الا بتضييعه التسبيح
 واخرج عن ابن مسعود رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : ما صيد من طير في السماء ولا سمك في الماء حتي يدع ما افترض الله عليه من التسبيح
 واخرج ابو الشيخ عن ابي الدرداء رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : ما اخذ طاءر ولا حوت الا بتضييع التسبيح
  واخرج ابو الشيخ عن مرثد بن ابي مرثد عن النبي صلي الله عليه وسلم : لا يصطاد شء من الطير والحيتان الا بما يضيع من تسبيح الله
 واخرج ابن عساكر من طريق يزيد بن مرثد عن النبي صلي الله عليه وسلم قال : ما اصطيد طير في بر ولا بحر الا بتضييعه التسبيح
 واخرج العقيلي في الضعفاء وابو الشيخ والديلمي عن انس رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : اجال البهاءم كلها وخشاش الارض والنمل والبراغيث والجراد والخيل والبغال والدواب كلها وغير ذلك اجالها في التسبيح فاذا انقضي تسبيحها قبض الله ارواحها وليس الي ملك الموت منها شء
 واخرج عبد الرزاق وابن جرير وابن المنذر وابن ابي حاتم عن قتادة في قوله : @QB@ وان من شء الا يسبح بحمده @QE@ قال : ما من شء في اصله الاول لن يموت الا وهو يسبح بحمده
 واخرج ابن ابي حاتم عن السدي في قوله : @QB@ وان من شء الا يسبح بحمده @QE@ قال : ما من شء في اصله الاول لن يموت الا وهو يسبح بحمده
 واخرج ابن ابي حاتم عن ابن شوذب قال : جلس الحسن مع اصحابه علي ماءدة فقال بعضهم : هذه الماءدة تسبح الان فقال الحسن : كلا انما ذاك كل شء علي اصله
 واخرج ابن جرير وابن ابي حاتم عن ابراهيم قال الطعام تسبيح
 واخرج ابن المنذر وابن ابي حاتم عن عبد الله بن عمرو بن العاص قال : لا تقتلوا الضفادع فان اصواتها تسبيح
 واخرج ابن ابي الدنيا وابن ابي حاتم وابو الشيخ والبيهقي في شعب الايمان عن انس بن مالك رضي الله عنه قال : ظن داود عليه السلام ان احدا لم يمدح خالقه افضل مما مدحه وان ملكا نزل وهو قاعد في المحراب والبركة الي جانبه فقال : يا داود افهم الي ما تصوت به الضفدع فانصت داود عليه السلام فاذا الضفدع يمدحه بمدحة لم يمدحه بها داود عليه السلام فقال له الملك : كيف تراه يا داود قال : افهمت ما قالت قال : نعم
 قال : ماذا قالت قال : قالت : سبحانك وبحمدك منهتي علملك يا رب
 قال داود عليه السلام : والذي جعلني نبيه اني لم امدحه بهذا
  واخرج البيهقي في شعب الايمان عن صدقة بن يسار رضي الله عنه قال : كان داود عليه السلام في محرابه فابصر درة صغيرة ففكر في خلقها وقال : ما يعبا الله بخلق هذه فانطقها الله فقالت : يا داود اتعجبك نفسك لانا علي قدر ما اتاني الله اذكر لله واشكر له منك علي ما اتاك الله
 قال الله : @QB@ وان من شء الا يسبح بحمده @QE@
 واخرج ابن المنذر عن الحسن رضي الله عنه قال : هذه الاية في التوراة كقدر الف اية @QB@ وان من شء الا يسبح بحمده @QE@ قال في التوراة : تسبح له الجبال ويسبح له الشجر ويسبح له كذا ويسبح له كذا
 واخرج احمد في الزهد وابو الشيخ عن شهر بن حوشب رضي الله عنه قال : كان داود عليه السلام يسمي النواح في كتاب الله عز وجل وانه انطلق حتي اتي البحر فقال : ايها البحر اني هارب
 قال : من الطالب الذي لا يناي طلبه
 قال : فاجعلني قطرة من ماءك او دابة مما فيك او تربة من تربتك او صخرة من صخرك
 قال : ايها العبد الهارب الفار من الطالب الذي لا يناي طلبه ارجع من حيث جءت فانه ليس مني شء الا بارز ينظر الله عز وجل اليه قد احصاه وعده عدا فلست استطيع ذلك ثم انطلق حتي اتي الجبل فقال : ايها الجبل اجعلني حجر من حجارتك او تربة من تربتك او صخرة من صخرك او شيءا مما في جوفك
 فقال : ايها العبد الهارب الفار من الطالب الذي لا يناي طلبه انه ليس مني شء الا يراه الله وينظر اليه وقد احصاه وعده عدا فلست استطيع ذلك
 ثم انطلق حتي اتي علي الارض يعني الرمل فقال : ايها الرمل اجعلني تربة من تربك او صخرة من صخرك او شيءا مما في جوفك
 فاوحي الله اليه اجبه
 فقال : ايها العبد الفار من الطالب الذي لا يناي طلبه ارجع من حيث جءت فاجعل عملك لقمسين : لرغبة او لرهبة فعلي ايهما اخذك ربك لم تبال وخرج فاتي البحر في ساعة فصلي فيه فنادته ضفدعة فقالت : يا داود انك حدثت نفسك انك قد سبحت في ساعة ليس يذكر الله فيها غيرك واني في سبعين الف ضفدعة كلها قاءمة علي رجل تسبح الله تعالي وتقدسه
 واخرج احمد وابو الشيخ عن ابن عباس رضي الله عنهما قال : صلي داود عليه السلام ليلة حتي اصبح فلما ان اصبح وجد في نفسه غرورا فنادته ضفدعة  يا داود كنت اداب منك قد اغفيت اغفاءة
 واخرج ابو الشيخ في العظمة عن ابي بردة عن ابي موسي رضي الله عنه قال : بلغني انه ليس شء اكثر تسبيحا من هذه الدودة الحمراء
 واخرج ابو الشيخ عن الحسن رضي الله عنه قال : التراب يسبح فاذا بني فيه الحاءط سبح
 واخرج ابو الشيخ عن عكرمة رضي الله عنه قال : اذا سمعت تغيضا من البيت او من الخشب والجدر فهو تسبيح
 واخرج ابو الشيخ عن خيثمة رضي الله عنه قال : كان ابو الدرداء يطبخ قدرا فوقعت علي وجهها فعلت تسبح
 واخرج ابو الشيخ عن سليمان بن المغيرة قال : كان مطرف رضي الله عنه اذا دخل بيته فسبح سبحت معه انية بيته
 واخرج ابو الشيخ عن الحسن رضي الله عنه قال : لولا ما غمي عليكم من تسبيح ما معكم في البيوت ما تقاررتم
 واخرج ابو الشيخ عن مسعر رضي الله عنه قال : لولا ما غمي عليكم من تسبيح خلقه ما تقاررتم
 واخرج ابو الشيخ عن الحسن رضي الله عنه في قوله : @QB@ وان من شء الا يسبح بحمده @QE@ قال : كل شء فيه الروح يسبح
 واخرج ابو الشيخ عن مجاهد رضي الله عنه @QB@ وان من شء الا يسبح بحمده @QE@ قال : صلاة الخلق تسبيحهم سبحان الله وبحمده
 واخرج النساءي وابن مردويه عن ابن مسعود رضي الله عنه قال : كنا اصحاب محمد صلي الله عليه وسلم نعد الايات بركة وانتم تعدونها تخويا بينما نحن مع رسول الله صلي الله عليه وسلم ليس معنا ماء فقال لنا : اطلبوا من معه فضل ماء فاتي بماء فوضعه في اناء ثم وضع يده فيه فجعل الماء يخرج من بين اصابعه
 ثم قال : حي علي الطهور المبارك والبركة من الله فشربنا منه
 قال عبد الله : كنا نسمع صوت الماء وتسبيحه وهو يشرب
 واخرج ابو الشيخ في العظمة وابن مردويه عن ابن مسعود قال : كنا ناكل مع النبي صلي الله عليه وسلم فنسمع تسبيح الطعام وهو يءكل
  واخرج ابو الشيخ عن انس قال : اتي رسول الله صلي الله عليه وسلم بطعام ثريد فقال : ان هذا الطعام يسبح قالوا : يا رسول الله وتفقه تسبيحه قال : نعم
 ثم قال لرجل : ادن هذه القصعة من هذا الرجل فادناها منه فقال : نعم يا رسول الله هذا الطعام يسبح فقال : ادنها من اخر وادناها منه فقال : هذا الطعام يسبح
 ثم قال : ردها فقال رجل : يا رسول الله لو امرت علي القوم جميعا فقال : لا انها لو سكتت عند رجل لقالوا من ذنب ردها فردها
 واخرج ابو الشيخ وابو نعيم في الحلية عن ابي حمزة الثمالي قال : قال محمد بن علي بن الحسين رضي الله عنه وسمع عصافير يصحن قال : تدري ما يقلن قلت : لا
 قال : يسبحن ربهن عز وجل ويسالن قوت يومهن
 واخرج الخطيب عن ابي حمزة قال : كنا مع علي بن الحسين رضي الله عنه فمر بنا عصافير يصحن فقال : اتدرون ما تقول هذه العصافير فقلنا : لا
 قال : اما اني ما اقول انا نعلم الغيب ولكني سمعت ابي يقول : سمعت علي بن ابي طالب امير المءمنين رضي الله عنه يقول : ان الطير اذا اصبحت سبحت ربها وسالته قوت يومها وان هذه تسبح ربها وتساله قوت يومها
 واخرج الخطيب في تاريخه عن عاءشة قالت : دخل علي رسول الله صلي الله عليه وسلم فقال لي : يا عاءشة اغسلي هذين البردين فقلت : يا رسول الله بالامس غسلتهما فقال لي : اما علمت ان الثوب يسبح فاذا اتسخ انقطع تسبيحه
 واخرج ابن جرير وابن ابي حاتم عن قتادة رضي الله عنه في قوله : @QB@ انه كان حليما غفورا @QE@ قال : حليما عن خلقه فلا يعجل كعجلة بعضهم علي بعض غفورا لهم اذا ثابوا
 واخرج ابو يعلي وابن ابي حاتم وصححه وابن مردويه وابو نعيم والبيهقي معا في الدلاءل عن اسماء بنت ابي بكر رضي الله عنهما قالت : لما نزلت ( تبت يدا ابي لهب ) ( المسد اية  ) اقبلت العوراء ام جميل ولها ولولة وفي يدها فهر وهي تقول : مذمما ابينا * ودينه قلينا * وامره عصينا
  ورسول الله صلي الله عليه وسلم جالس وابو بكر رضي الله عنه الي جنبه فقال ابو بكر : لقد اقبلت هذه وانا اخاف ان تراك فقال : انها لن تراني وقرا قرانا اعتصم به
 كما قال تعالي : @QB@ واذا قرات القران جعلنا بينك وبين الذين لا يءمنون بالاخرة حجابا مستورا @QE@ فجاءت حتي قامت علي ابي بكر رضي الله عنه : فلم تر النبي صلي الله عليه وسلم فقالت : يا ابا بكر بلغني ان صاحبك هجاني فقال ابو بكر رضي الله عنه : لا ورب هذا البيت ما هجاك فانصرفت وهي تقول : قد علمت قريش اني بنت سيدها
 واخرج ابن مردويه والبيهقي في الدلاءل من وجه اخر عن اسماء بنت ابي بكر رضي الله عنهما : ان ام جميل دخلت علي ابي بكر وعنده رسول الله صلي الله عليه وسلم فقالت : يا ابن ابي قحافة ما شان صاحبك ينشد في الشعر فقال : والله ما صاحبي بشاعر وما يدري ما الشعر
 فقالت : اليس قد قال : ( في جيدها حبل من مسد ) ( المسد اية  ) فما يدريه ما في جيدي فقال النبي صلي الله عليه وسلم : قل لها : هل ترين عندي احدا فانها لن تراني جعل بيني وبينها حجاب فقال لها ابو بكر رضي الله عنه : فقالت : اتهزا بي والله ما اري عندك احدا
 واخرج ابن مردويه عن ابي بكر الصديق رضي الله عنه قال : كنت جالسا عند المقام ورسول الله صلي الله عليه وسلم في ظل الكعبة بين يدي اذ جاءت ام جميل بنت حرب بن امية زوجة ابي لهب ومعها فهران فقالت : اين الذي هجاني وهجا زوجي والله لءن رايته لارضن انثييه بهذين الفهرين
 وذلك عند نزول ( تبت يدا ابي لهب ) قال ابو بكر رضي الله عنه : فقلت له : يا ام جميل ما هجاك ولا هجا زوجك
 قالت : والله ما انت بكذاب وان الناس ليقولون ذلك ثم ولت ذاهبة
 فقلت : يا رسول الله انها لم ترك فقال النبي صلي الله عليه وسلم : حال بيني وبينها جبريل
 واخرج ابن ابي شيبة والدارقطني في الافراد وابو نعيم في الدلاءل عن ابن عباس رضي الله عنهما قال : لما نزلت ( تبت يدا ابي لهب ) جاءت امراة ابي لهب فقال ابو بكر رضي الله عنه : يا رسول الله لو تنحيت عنها فانها امراة بذية فقال : انه سيحال بيني وبينها فلا تراني فقال : يا ابا بكر هجانا صاحبك  قال : والله ما ينطق بالشعر ولا يقوله 
 فقال : انك لمصدق فاندفعت راجعة
 فقال ابو بكر رضي الله عنه : يا رسول الله ما راتك قال : كان بيني وبينها ملك يسترني بجناحه حتي ذهبت
 واخرج ابن اسحق وابن المنذر عن ابن شهاب رضي الله عنه قال : كان رسول الله صلي الله عليه وسلم اذا تلا القران علي مشركي قريش ودعاهم الي الله قالوا : يهزءون به ( قلوبنا في اكنة بما تدعونا اليه وفي اذاننا وقر ومن بيننا وبينك حجاب ) ( السجدة اية  ) فانزل الله في ذلك من قولهم @QB@ واذا قرات القران @QE@ الايات
 واخرج ابن عساكر وولده القاسم في كتاب ايات الحرز عن العباس بن محمد المنقري رضي الله عنه قال : قدم حسين بن زيد بن علي بن الحسين بن علي بن ابي طالب رضي الله عنه المدينة حاجا فاحتجنا الي ان نوجه رسولا وكان في الخوف فابي الرسول ان يخرج وخاف علي نفسه من الطريق فقال الحسين رضي الله عنه : انا اكتب لك رقعة فيها حرز لن يضرك شء ان شاء الله تعالي فكتب له رقعة وجعلها الرسول في صورته فذهب الرسول فلم يلبث ان جاء سالما فقال : مررت بالاعراب يمينا وشمالا فما هيجني منهم احد والحرز عن جعفر بن محمد بن علي بن الحسين عن ابيه عن جده عن علي بن ابي طالب وان هذا الحرز كان الانبياء يتحرزون به من الفراعنة : ( بسم الله الرحمن الرحيم ) ( قال اخسءوا فيها ولا تكلمون ) ( المءمنون اية  ) ( اني اعوذ بالرحمن منك ان كنت تقيا ) ( مريم اية  ) اخذت بسمع الله وبصره وقوته علي اسماعكم وابصاركم وقوتكم يا معشر الجن والانس والشياطين والاعراب والسباع والهوام واللصوص مما يخاف ويحذر فلان بن فلان سترت بينه وبينكم بستر النبوة التي استتروا بها من سطوات الفراعنة جبريل عن ايمانكم وميكاءيل عن شماءاكم ومحمد صلي الله عليه وسلم امامكم والله سبحانه وتعالي من فوقكم يمنعكم من فلان بن فلان في نفسه وولده واهله وشعره وبشره وماله وما عليه وما معه وما تحته وما فوقه
