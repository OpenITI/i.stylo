  اخرج اللالكاءي في السنة والبيهقي في البعث عن عمر بن الخطاب قال بينا نحن جلوس عند النبي صلي الله عليه وسلم في اناس اذ جاء رجل ليس عليه سحناء سفر وليس من اهل البلد يتخطي حتي ورك بين يدي رسول الله صلي الله عليه وسلم كما يجلس احدنا في الصلاة ثم وضع يده علي ركبتي رسول الله صلي الله عليه وسلم فقال : يا محمد ما الاسلام قال : الاسلام ان تشهد ان لا اله الا الله وان محمد رسول الله وان تقيم الصلاة وتءتي الزكاة وتحج وتعتمر وتغتسل من الجنابة وتتم الوضوء وتصوم رمضان
 قال : فان فعلت هذا فانا مسلم قال : نعم
 قال : صدقت يا محمد قال : ما الايمان قال : الايمان ان تءمن بالله وملاءكته وكتبه ورسله وتءمن بالجنة والنار والميزان وتءمن بالبعث بعد الموت وتءمن بالقدر خيره وشره
 قال : فاذا فعلت هذا فانا مءمن قال : نعم
 قال : صدقت
 واخرج ابن المنذر وابن ابي حاتم وابو الشيخ عن مجاهد في قوله @QB@ والوزن يومءذ الحق @QE@ قال : العدل @QB@ فمن ثقلت موازينه @QE@ قال : حسناته @QB@ ومن خفت موازينه @QE@ قال : حسناته
 واخرج ابن ابي شيبة وابن ابي حاتم عن عبد الله بن العيزار قال : ان الاقدام يوم القيامة لمثل النبل في القرن والسعيد من وجد لقدميه موضعا وعند الميزان ملك  ينادي : الا ان فلان بن فلان ثقلت موازينه وسعد سعادة لن يشقي بعدها ابدا الا ان فلان بن فلان خفت موازينه وشقي شقاء لن يسعد بعده ابدا
 واخرج ابن ابي حاتم عن السدي في قوله @QB@ والوزن يومءذ الحق @QE@ قال : توزن الاعمال
 واخرج عبد الرزاق وابن المنذر وابن ابي حاتم وابو نعيم في الحلية عن وهب بن منبه قال : انما يوزن من الاعمال خواتيمها فمن اراد الله به خيرا ختم له بخير عمله ومن اراد به شرا ختم له بشر عمله
 واخرج ابن ابي حاتم عن الحارث الاعور قال : ان الحق ليثقل علي اهل الحق كثقله في الميزان وان الحق ليخف علي اهل الباطل كخفته في الميزان
 واخرج ابن المنذر واللالكاءي عن عبد الملك بن ابي سليمان قال : ذكر الميزان عند الحسن فقال : له لسان وكفتان
 واخرج ابو الشيخ عن كعب قال : يوضع الميزان بين شجرتين عند بيت المقدس
 واخرج ابن ابي الدنيا وابن جرير واللالكاءي عن حذيفة قال : صاحب الموازين يوم القيامة جبريل عليه السلام يرد بعضهم علي بعض فيءخذ من حسنات الظالم فترد علي المظلوم فان لم تكن له حسنات اخذ من سيءات المظلوم فردت علي الظالم
 واخرج ابو الشيخ عن الكلبي في قوله @QB@ والوزن يومءذ الحق @QE@ قال : اخبرني ابو صالح عن ابن عباس انه قال : له لسان وكفتان يوزن فمن ثقلت موازينه فاولءك هم المفلحون ومن خفت موازينه فاولءك الذين خسروا انفسهم ومنازلهم في الجنة بما كانوا باياتنا تظلمون
 واخرج عبد الرزاق وابن المنذر عن قتادة في قوله @QB@ فمن ثقلت موازينه فاولءك هم المفلحون @QE@ قال : قال للنبي صلي الله عليه وسلم بعض اهله : يا رسول الله هل يذكر الناس اهليهم يوم القيامة قال اما في ثلاث مواطن فلا
 عند الميزان وعند تطاير الصحف في الايدي وعند الصراط
 واخرج ابن ابي حاتم عن ابن عباس قال : يحاسب الناس يوم القيامة فمن كانت حسناته اكثر من سيءاته بواحدة دخل الجنة ومن كانت سيءاته اكثر من حسناته بواحدة دخل النار ثم قرا @QB@ فمن ثقلت موازينه @QE@ الايتين
 ثم قال
 ان  الميزان يخف بمثقال حبة ويرجح ومن استوت حسناته وسيءاته كان من اصحاب الاعراف فوقفوا علي الاعراف
 واخرج ابن ابي الدنيا في كتاب الاخلاص عن علي بن ابي طالب قال : من كان ظاهره ارجح من باطنه خف ميزانه يوم القيامة ومن كان باطنه ارجح من ظاهره ثقل ميزانه يوم القيامة
 واخرج ابو الشيخ عن جابر قال : قال رسول الله صلي الله عليه وسلم يوضع الميزان يوم القيامة فيوزن الحسنات والسيءات فمن رجحت حسناته علي سيءاته دخل الجنة ومن رجحت سيءاته علي حسناته دخل النار
 واخرج البزار وابن مردويه واللالكاءي والبيهقي عن انس رفعه قال : ان ملكا موكل بالميزان فيءتي بالعبد يوم القيامة فيوقف بين كفتي الميزان فان ثقل ميزانه نادي الملك بصوت يسمع الخلاءق : سعد فلان بن فلان سعادة لا يشقي بعدها ابدا وان خفت ميزانه نادي الملك : شقي فلان شقاوة لا يسعد بعدها ابدا
 واخرج ابن ابي شيبة وعبد بن حميد وابو داود والاجري في الشريعة والحاكم وصححه والبيهقي في البعث عن عاءشة
 انها ذكرت النار فبكت فقال رسول الله صلي الله عليه وسلم مالك

 قالت : ذكرت النار فبكيت فهل تذكرون اهليكم يوم القيامة قال : اما في ثلاث مواطن فلا يذكر احدا احدا حيث توضع الميزان حتي يعلم اتخف ميزانه ام تثقل وعند تطاير الكتب حين يقال @QB@ هاءم اقرءوا كتابيه @QE@ الحاقة الاية  حتي يعلم اين يقع كتابه افي يمينه ام في شماله او من وراء ظهره وعند الصراط اذا وضع بين ظهري جهنم حافتاه كلاليب كثيرة وحسك كثير يحبس الله بها من شاء من خلقه حتي يعلم اينجو ام لا
 واخرج الحاكم وصححه عن سلمان عن النبي صلي الله عليه وسلم قال يوضع الميزان يوم القيامة فلو وزن فيه السموات والارض لوسعت فتقول الملاءكة : يا رب لمن يزن هذا فيقول الله : لمن شءت من خلقي
 فتقول الملاءكة : سبحانك

 ما عبدناك حق عبادتك ويوضع الصراط مثل حد الموس فتقول الملاءكة : من تنحي علي هذا فيقول : من شءت من خلقي
 فيقولون : سبحانك

 ما عبدناك حق عبادتك
  واخرج ابن المبارك في الزهد والاجري في الشريعة واللالكاءي عن سلمان قال : يوضع الميزان وله كفتان لو وضع في احداهما السموات والارض ومن فيهن لوسعه فتقول الملاءكة : من يزن هذا فيقول : من شءت من خلقي
 فتقول الملاءكة : سبحانك

 ما عبدناك حق عبادتك
 واخرج ابن مردويه عن عاءشة سمعت رسول الله صلي الله عليه وسلم يقول : خلق الله كفتي الميزان مثل السموات والارض
 فقالت الملاءكة : يا ربنا من تزن بهذا قال : ازن به من شءت
 وخلق الله الصراط كحد السيف فقالت الملاءكة : يا ربنا من تجيز علي هذا قال : اجيز عليه من شءت
 واخرج البيهقي في شعب الايمان عن ابن عباس قال : الميزان له لسان وكفتان يوزن فيه الحسنات والسيءات فيءتي بالحسنات في احسن صورة فتوضع في كفة الميزان فتثقل علي السيءات فتءحذ فتوضع في الجنة عند منازله ثم يقال للمءمن : الحق بعملك
 فينطلق الي الجنة فيعرف منازله بعمله ويءتي بالسيءات في اقبح صورة فتوضع في كفة الميزان فتخف  والباطل خفيف  فتطرح في جهنم الي منازله فيها ويقال له : الحق بعملك الي النار
 فياتي النار فيعرف منازله بعمله وما اعد الله له فيها من الوان العذاب
 قال ابن عباس : فلهم اعرف بمنازلهم في الجنة والنار بعملهم من القوم ينصرفون يوم الجمعة راجعين الي منازلهم
 واخرج الترمذي وحسنه والبيهقي في البعث عن انس قال : سالت النبي صلي الله عليه وسلم ان يشفع لي يوم القيامة فقال انا فاعل
 قلت : يا رسول الله اين اطلبك قال : اطلبني اول ما تطلبني علي الصراط
 قلت : فان لم القك علي الصراط قال : فاطلبني عند الميزان
 قلت : فان لم القك عند الميزان قال : فاطلبني عند الحوض فاني لا اخطء هذه الثلاثة مواطن
 واخرج احمد والترمذي وابن ماجة وابن حبان والحاكم وصححه وابن مردويه واللالكاءي والبيهقي في البعث عن عبد الله بن عمرو قال : قال رسول الله صلي الله عليه وسلم يصاح برجل من امتي علي رءوس الخلاءق يوم القيامة فينشر له تسعة وتسعون سجلا كل سجل منها مد البصر فيقول : اتنكر من هذا شيءا اظلمك كتبتي الحافظون فيقول : لا يا رب
 فيقول : افلك عذرا وحسنة فيهاب الرجل فيقول : لا يا رب
 فيقول : بلي ان لك عندنا حسنة وانه لا ظلم عليك اليوم
 فيخرج له  بطاقة فيها : اشهد ان لا اله الا الله واشهد ان محمد عبده ورسوله
 فيقول : يا رب ما هذه البطاقة مع هذه السجلات فيقال : انك لا تظلم
 فتوضع السجلات في كفة والبطاقة في كفة فطاشت السجلات وثقلت البطاقة ولا يثقل مع اسم الله شء
 واخرج احمد بسند حسن عن عبد الله بن عمرو قال : قال رسول الله صلي الله عليه وسلم توضع الموازين يوم القيامة فيءتي بالرجل فيوضع في كفه ويوضع ما احصي عليه فتمايل به الميزان فيبعث به الي النار فاذا ادبر به صاءح يصيح من عند الرحمن : لا تعجلوا لا تعلجوا فانه قد بقي له
 فيءتي ببطاقة فيها : لا اله الا الله
 فتوضع مع الرجل في كفة حتي تميل به الميزان
 واخرج ابن ابي الدنيا والنميري في كتاب الاعلام عن عبد الله بن عمرو قال ان لادم عليه السلام من الله عز وجل موقفا في فسح من العرش عليه ثوبان اخضران كانه سحوق ينظر الي من ينطلق به من ولده الي الجنة وينظر الي من ينطلق به من ولده الي النار فبينا ادم علي ذلك اذا نظر الي رجل من امة محمد صلي الله عليه وسلم ينطلق به الي النار فينادي ادم : يا احمد يا احمد
 فيقول : لبيك يا ابا البشر
 فيقول : هذا رجل من امتك ينطلق به الي النار فاشد المءزر واسرع في اثر الملاءكة واقول : يا رسل ربي قفوا
 فيقولون : نحن الغلاظ الشداد الذين لا نعصي الله ما امرنا ونفعل ما نءمر 
 فاذا ايس النبي صلي الله عليه وسلم قبض علي لحيته بيده اليسري واستقبل العرش بوجهه فيقول : يا رب قد وعدتني ان لا تخزيني في امتي قياتي النداء من عند العرش : اطيعوا محمدا وردوا هذا العبد الي المقام
 فاخرج من حجزتي بطاقة بيضاء كالانملة فالقيها في كفة الميزان اليمني وانا اقول : بسم الله
 فترجح الحسنات علي السيءات فينادي سعد وسعد جده وثقلت موازينه : انطلقوا به الي الجنة فيقول : يا رسل ربي قفوا حتي اسال هذا العبد الكريم علي ربه
 فيقول : بابي انت وامي ما احسن وجهك واحسن خلقك من انت فقد : اقلتني عثرتي
 فيقول : انا نبيك محمد وهذه صلاتك التي كنت تصلي علي وافتك احوج ما تكون اليها
 واخرج الطبراني في الاوسط عن جابر عن النبي صلي الله عليه وسلم قال اول ما يوضع في ميزان العبد نفقته علي اهله
 واخرج البخاري ومسلم والترمذي والنساءي وابن ماجة واللالكاءي عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم كلمتان خفيفتان علي اللسان ثقيلتان في الميزان حبيبتان الي  الرحمن : سبحان الله وبحمده سبحان الله العظيم
 واخرج الطبراني عن ابن عباس قال : قال رسول الله صلي الله عليه وسلم والذي نفسي بيده لو جء بالسموات والارض ومن فيهن وما بينهن وما تحتهن فوضعن في كفة الميزان ووضعت شهادة ان لا اله الا الله في الكفة الاخري لرجحت بهن
 واخرج ابن ابي الدنيا والبزار وابو يعلي والطبراني والبيهقي بسند جيد عن انس قال : لقي رسول الله صلي الله عليه وسلم ابا ذر فقال الا ادلك علي خصلتين هما خفيفتان علي الظهر واثقل في الميزان من غيرهما قال : بلي يا رسول الله
 قال : عليك بحسن الخلق وطول الصمت فوالذي نفسي بيده ما عمل الخلاءق بمثلهما
 واخرج ابن ابي شيبة عن ميمون بن مهران قال : قلت لام الدرداء : اما سمعت من النبي صلي الله عليه وسلم شيءا قالت : نعم دخلت عليه فسمعته يقول اول ما يوضع في الميزان الخلق الحسن
 واخرج ابو داود والترمذي وصحح وابن حبان واللالكاءي عن ابي الدرداء قال : قال رسول الله صلي الله عليه وسلم ما من شء يوضع في الميزان يوم القيامة اثقل من خلق حسن
 واخرج الطبراني في الاوسط عن عمر بن الخطاب قال : اعطيت ناقة في سبيل الله فاردت ان اشتري من نسلها فسالت النبي صلي الله عليه وسلم فقال دعها تاتي يوم القيامة هي واولادها جميعا في ميزانك
 واخرج ابو نعيم عن ابن عمر قال : قال رسول الله صلي الله عليه وسلم من قضي لاخيه حاجة كنت واقفا عند ميزانه فان رجح والا شفعت
 واخرج ابن ابي شيبة واحمد في الزهد عن مغيث بن سمي وعن مسروق قالا : تعبد راهب في صومعة ستين سنة فنظر يوما في غب السماء فقال : لو نزلت فاني لا اري احدا فشربت من الماء وتوضات ثم رجعت الي مكاني فتعرضت له امراة فتكشفت له فلم يملك نفسه ان وقع عليها فدخل بعض تلك الغدران يغتسل فيه وادركه الموت وهو علي تلك الحال ومر به ساءل فاوما اليه ان خذ الرغيف رغيفا كان في كساءه فاخذ المسكين الرغيف ومات فجء بعمل ستين سنة فوضع في كفة وجء بخطيءته فوضعت في كفة فرجحت بعمله حتي جء بالرغيف فوضع مع عمله فرجح بخطيءته
 واخرج الطبراني في الاوسط عن سفينة قال : قال رسول الله صلي الله عليه وسلم بخ بخ  خمس ما اثقلهن في الميزان
 سبحان الله ولا اله الا الله والحمد لله والله اكبر وفرط صالح يفرطه المسلم
 واخرج ابو يعلي وابن حبان عن عمرو بن حريث ان رسول الله صلي الله عليه وسلم قال : ما انفقت عن خادمك من عمله كان لك اجره في موازينك
 واخرج ابن عساكر بسند ضغيف عن ابي هريرة عن رسول الله صلي الله عليه وسلم قال من توضا فمسح بثوب نظيف فلا باس به ومن لم يفعل فهو افضل لان الوضوء يوزن يوم القيامة مع ساءر الاعمال
 واخرج ابن ابي شيبة في المصنف عن سعيد بن المسيب انه كره المنديل بعد الوضوء وقال : هو يوزن
 واخرج الترمذي والبيهقي في شعب الايمان عن الزهري قال : انما كره المنديل بعد الوضوء لان كل قطرة توزن
 واخرج المرهبي في فضل العلم عن عمران بن حصين رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم يوزن يوم القيامة مداد العلماء ودماء الشهداء فيرجح مداد العلماء علي دماء الشهداء
 واخرج الديلمي من حديث ابن عمر وابن عمرو
 مثله
 واخرج عبد البر في فضل العلم عن ابراهيم النخعي قال : يجاء بعمل الرجل فيوضع في كفة ميزانه يوم القيامة فيخف فيجاء بشء امثال الغمام فيوضع في كفة ميزانه فترجح فيقال له : اتدري ما هذا فيقول : لا
 فيقال له : هذا فضل العلم الذي كنت تعلمه الناس
 واخرج ابن المبارك في الزهد عن حماد بن ابي سليمان قال : يجء رجل يوم القيامة فيري عمله محتقرا فبينما هو كذلك اذ جاءه مثل السحاب حتي يقع في ميراثه فيقال : هذا ما كنت تعلم الناس من الخير فورث بعدك فاجرت فيه
 واخرج ابن المبارك عن ابي الدرداء قال : من كان الاجوفان همه خسر ميزانه يوم القيامة
 واخرج الاصبهاني في الترغيب عن ليث قال : قال عيسي بن مريم عليه السلام : امة محمد اثقل الناس في الميزان ذلت السنتهم بكلمة ثقلت علي من كان قبلهم : لا اله الا الله
  واخرج الحكيم الترمذي في نوادر الاصول عن ايوب قال : سمعت من غير واحد من اصحابنا : ان العبد يوقف علي الميزان يوم القيامة فينظر في الميزان وينظر الي صاحب الميزان فيقول صاحب الميزان : يا عبد الله اتفقد من عملك ذلك شيءا فيقول : نعم
 فيقول : ماذا فيقول : لا اله الا الله وحده لا شريك له
 فيقول صاحب الميزان : هي اعظم من ان توضع في الميزان
 قال موسي بن عبيدة : سمعت انها تاتي يوم القيامة تجادل عمن كان يقولها في الدنيا جدال الخصم
 واخرج ابو داود والحاكم عن ابي الازهر زهير الانماري قال : كان رسول الله صلي الله عليه وسلم اذا اخذ مضجعه قال اللهم اغفر لي واخس شيطاني وفك رهاني وثقل ميزاني واجعلني في الندي الاعلي
