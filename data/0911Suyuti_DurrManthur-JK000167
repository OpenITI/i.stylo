  اخرج ابن جرير وابن المنذر وابن ابي حاتم والبيهقي في الاسماء والصفات عن ابن  عباس @QB@ وكذلك نري ابراهيم ملكوت السماوات والارض @QE@ قال : الشمس والقمر والنجوم
 واخرج ابن ابي حاتم وابو الشيخ عن ابن عباس @QB@ وكذلك نري ابراهيم ملكوت السماوات والارض @QE@ قال : كشف ما بين السموات والارض حتي نظر اليهن علي صخرة والصخرة علي حوت وهو الحوت الذي منه طعام الناس والحوت في سلسلة والسلسلة في خاتم العزة
 واخرج ابو الشيخ عن ابن عباس @QB@ ملكوت السماوات والارض @QE@ قال : ملك السموات والارض قال : سلطانهما
 واخرج عبد بن حميد وابن المنذر وابن ابي حاتم عن عكرمة في قوله @QB@ وكذلك نري ابراهيم ملكوت السماوات والارض @QE@ قال : انما هو ملك السموات والارض ولكنه بلسان النبطية ملكوثا
 واخرج ادم بن ابي اياس وابن المنذر وابن حاتم وابو الشيخ والبيهقي في الاسماء والصفات عن مجاهد في قوله @QB@ وكذلك نري ابراهيم ملكوت السماوات والارض @QE@ قال : ايات فرجت له السموات السبع فنظر الي ما فيهن حتي انتهي بصره الي العرش وفرجت له الارضون السبع فنظر الي ما فيهن
 واخرج سعيد بن منصور وابن المنذر وابن ابي حاتم عن السدي في قوله @QB@ وكذلك نري ابراهيم ملكوت السماوات والارض @QE@ قال : قام علي صخرة ففرجت له السموات السبع حتي نظر الي العرش والي منزله من الجنة ثم فرجت له الارضون السبع حتي نظر الي الصخرة التي عليها الارضون كذلك قوله @QB@ واتيناه اجره في الدنيا @QE@ العنكبوت الاية 
 واخرج احمد وابن جرير وابن مردويه والبيهقي في الاسماء والصفات عن عبد الرحمن بن عاءش الحضرمي عن بعض اصحاب النبي صلي الله عليه وسلم قال سمعت رسول الله صلي الله عليه وسلم يقول : رايت ربي في احسن صورة فقال : فيم يختصم الملا الاعلي يا محمد قال : قلت انت اعلم اي رب

 قال : فوضع يده بين كتفي فوجدت بردها بين ثديي
 قال : فعلمت ما في السموات والارض ثم تلا هذه الاية @QB@ وكذلك نري ابراهيم ملكوت السماوات والارض وليكون من الموقنين @QE@ ثم قال : يا محمد فيم  يختصم الملا الاعلي قال : قلت : في الدرجات والكفارات
 قال : وما الكفارات قلت : نقل الاقدام الي الجماعات والمجالس في المساجد خلاف الصلوات وابلاغ الوضوء اماكنه في المكروه فمن يفعل ذلك يعش بخير ويمت بخير ويكن من خطيءته كهيءته يوم ولدته امه واما الدرجات فبذل السلام واطعام الطعام والصلاة بالليل والناس نيام
 قال : قل اللهم اني اسالك الطيبات وترك المنكرات وحب المساكين وان تغفر لي وترحمني واذا اردت فتنة في قوم فتوفني غير مفتون
 فقال رسول الله صلي الله عليه وسلم : تعلموهن فانهن حق
 واخرج ابن مردويه عن علي بن ابي طالب قال : قال رسول الله صلي الله عليه وسلم لما راي ابراهيم ملكوت السموات والارض اشرف علي رجل علي معصية من معاصي الله فدعا عليه فهلك ثم اشرف علي اخر علي معصية من معاصي الله فدعا فهلك ثم اشرف علي اخر فذهب يدعو عليه فاوحي الله اليه : ان يا ابراهيم انك رجل مستجاب الدعوة فلا تدع علي عبادي فانهم مني علي ثلاث
 اما ان يتوب فاتوب عليه واما ان اخرج من صلبه نسمة تملا الارض بالتسبيح واما ان اقبضه الي فان شءت عفوت وان شءت عاقبت
 واخرج عبد بن حميد وابو الشيخ عن عطاء قال : لما رفع ابراهيم الي ملكوت السموات اشرف علي عبد يزني فدعا عليه فاهلك ثم رفع ايضا فاشرف علي عبد يزني فدعا عليه فاهلك ثم رفع ايضا فاشرف علي عبد يزني فاراد ان يدعو عليه فقال له ربه : علي رسلك يا ابراهيم فانك عبد مستجاب لك واني من عبدي علي احدي ثلاث خلال
 اما ان يتوب الي فاتوب عليه واما ان اخرج منه ذرية طيبة واما ان يتمادي فيما هو فيه فانا من وراءه
 واخرج عبد بن حميد وابن ابي حاتم عن شهر بن حوشب في قوله @QB@ وكذلك نري ابراهيم ملكوت السماوات والارض @QE@ قال : رفع ابراهيم الي السماء فنظر اسفل منه فراي رجلا علي فاحشة فدعا فخسف به حتي دعا علي سبعة كلهم يخسف به فنودي يا ابراهيم رفه عن عبادي ثلاث مرار اني من عبدي بين ثلاث اما ان يتوب فاتوب عليه واما ان استخرج من صلبه ذرية مءمنة واما ان يكفر فحسبه جهنم
 واخرج ابو الشيخ وابن مردويه والبيهقي في الشعب من طريق شهر بن حوشب عن  معاذ بن جبل عن النبي صلي الله عليه وسلم قال لما راي ابراهيم ملكوت السموات والارض ابصر عبدا علي خطيءة فدعا عليه ثم ابصر عبدا علي خطيءة فدعا عليه فاوحي الله اليه : يا ابرهيم انك عبد مستجاب الدعوة فلا تدع علي احد فاني من عبدي علي ثلاث اما ان اخرج من صلبه ذرية تعبدني واما ان يتوب في اخر عمره فاتوب عليه واما ان يتولي فان جهنم من وراءه
 واخرج سعيد بن منصور وابن ابي شيبة وابن المنذر وابو الشيخ عن سلمان الفارسي قال : لما راي ابراهيم ملكوت السموات والارض راي رجلا علي فاحشة فدعا عليه فهلك ثم راي اخر علي فاحشة فدعا عليه فهلك ثم راي اخر علي فاحشة فدعا عليه فاوحي الله اليه : ان يا ابراهيم مهلا فانك رجل مستجاب لك واني من عبدي علي ثلاث خصال
 اما ان يتوب قبل الموت فاتوب عليه واما ان اخرج من صلبه ذرية يذكروني واما ان يتولي فجهنم من وراءه
 واخرج البيهقي في الشعب عن عطاء قال : لما رفع ابراهيم في ملكوت السموات راي رجلا يزني فدعا عليه فهلك ثم رفع فراي رجلا يزني فدعا عله فهلك ثم رفع فراي رجلا يزني فدعا عليه فهلك ثم راي رجلا يزني فدعا عليه فهلك
 فقيل : علي رسلك يا ابراهيم انك عبد يستجاب لك واني من عبدي علي ثلاث اما ان يتوب الي فاتوب عليه واما ان اخرج منه ذرية طيبة تعبدني واما ان يتمادي فيما هو فيه فان جهنم من وراءه
 واخرج ابن جرير وابن ابي حاتم عن ابن عباس في قوله @QB@ وكذلك نري ابراهيم ملكوت السماوات والارض @QE@ قال : يعني خلق السموات والارض @QB@ وليكون من الموقنين @QE@ فانه جلا له الامر سره وعلانيته فلم يخف عليه شء من اعمال الخلاءق فلما جعل يلعن اصحاب الذنوب قال الله : انك لا تستطيع هذا فرده الله كما كان قبل ذلك
 واخرج عبد بن حميد وابن المنذر وابن ابي حاتم وابو الشيخ عن قتادة في الاية قال : ذكر لنا ان ابراهيم عليه السلام فر به من جبار مترف فجعل في سرب وجعل رزقه في اطرافه فجعل لا يمص اصبعا من اصابعه الا جعل الله له فيها رزقا فلما خرج من ذلك السرب اراه الله ملكوت السموات والارض واراه شمسا وقمرا ونجوما وسحابا وخلقا عظيما واراه ملكوت الارض فراي جبالا وبحورا وانهارا وشجرا  ومن كل الدواب وخلقا عظيما @QB@ فلما جن عليه الليل راي كوكبا @QE@ ذكر لنا ان الكوكب الذي راي الزهرة طلعت عشاء @QB@ قال هذا ربي فلما افل قال لا احب الافلين @QE@ علم ان ربه داءم لا يزول @QB@ فلما راي القمر بازغا قال هذا ربي @QE@ راي خلقا اكبر من الخلق الاول @QB@ فلما افل قال لءن لم يهدني ربي لاكونن من القوم الضالين فلما راي الشمس بازغة قال هذا ربي هذا اكبر @QE@ اي اكبر خلقا من الخلقين الاولين وابهي وانور
 واخرج ابن ابي حاتم عن السدي قال : كان من شان ابراهيم عليه السلام ان اول ملك ملك في الارض شرقها وغربها نمرود بن كنعان بن كوش بن سام بن نوح وكانت الملوك الذين ملكوا الارض كلها اربعة
 بن كنعان وسليمان بن داود وذو القرنين وبختنصر
 مسلمين وكافرين وانه طلع كوكب علي نمرود ذهب بضوءالشمس والقمر ففزع من ذلك فدعا السحرة والكهنة والقافة والحازة فسالهم عن ذلك فقالوا : يخرج من ملكك رجل يكون علي وجهه هلاكك وهلاك ملكك وكان مسكنه ببابل الكوفة فخرج من قريته الي قرية اخري واخرج الرجال وترك النساء وامر ان لا يولد مولود ذكر الا ذبحه فذبح اولادهم
 ثم انه بدت له حاجة في المدينة لم يامن عليها الا ازر ابا ابراهيم فدعاه فارسله فقال له : انظر لا تواقع اهلك
 فقال له ازر انا اضن بديني من ذلك فلما دخل القرية نظر الي اهله فلم يملك نفسه ان وقع عليها ففر بها الي قرية بين الكوفة والبصرة يقال لها ادر فجعلها في سرب فكان يتعهدها بالطعام وما يصلحها وان الملك لما طال عليه الامر قال : قول سحرة كذابين ارجعوا الي بلدكم فرجعوا وولد ابراهيم فكان في كل يوم يمر به كانه جمعة والجمعة كالشهر من سرعة شبابه ونسي الملك ذاك وكبر ابراهيم ولا يري ان احدا من الخلق غيره وغير ابيه وامه فقال ابو ابراهيم لاصحابه : ان لي ابنا وقد خباته فتخافون عليه الملك ان انا جءت به قالوا : لا فاءت به
 فانطلق فاخرجه فلما خرج الغلام من السرب نظر الي الدواب والبهاءم والخلق فجعل يسال اباه فيقول : ما هذا فيخبره عن البعير انه بعير وعن البقرة انها بقرة وعن الفرس انها فرس وعن الشاة انها شاة
 فقال : ما لهءلاء بد من ان يكون لهم رب
 وكان خروجه حين خرج من السرب بعد غروب الشمس فرفع راسه الي السماء  فاذا هو بالكوكب وهو المشتري فقال : هذا ربي
 فلم يلبث ان غاب قال : لا احب ربا يغيب
 قال ابن عباس : وخرج في اخر الشهر فلذلك لم ير القمر قبل الكوكب فلما كان اخر الليل راي القمر بازغا قد طلع قال : هذا ربي
 فلما افل  يقول غاب @QB@ قال لءن لم يهدني ربي لاكونن من القوم الضالين @QE@ فلما اصبح راي الشمس بازغة @QB@ قال هذا ربي هذا اكبر فلما افلت قال يا قوم اني برء مما تشركون @QE@ قال الله له : اسلم
 قال : اسلمت لرب العالمين
 فجعل ابراهيم يدعو قومه وينذرهم وكان ابوه يصنع الاصنام فيعطيها اولاده فيبيعونها وكان يعطيه فينادي من يشتري ما يضره ولا ينفعه فيرجع اخوته وقد باعوا اصنامهم ويرجع ابراهيم باصنامه كما هي ثم دعا اباه فقال @QB@ يا ابت لم تعبد ما لا يسمع ولا يبصر ولا يغني عنك شيءا @QE@ مريم الاية  ثم رجع ابراهيم الي بيت الالهة فاذا هن في بهو عظيم مستقبل باب البهو صنم عظيم الي جنبه اصغر منه بعضها الي جنب بعض كل صنم يليه اصغر منه حتي بلغوا باب البهو واذا هم قد جعلوا طعاما بين يدي الالهة وقالوا : اذا كان حين نرجع رجعنا وقد برحت الالهة من طعامنا فاكلنا فلما نظر اليهم ابراهيم والي ما بين ايديهم من الطعام قال : الا تاكلون فلما لم تجبه قال : ما لكم لا تنطقون ثم ان ابراهيم اتي قومه فدعاهم فجعل يدعو قومه وينذرهم فحبسوه في بيت وجمعوا له الحطب حتي ان المراة لتمرض فتقول : لءن عافاني الله لاجمعن لابراهيم حطبا فلما جمعوا له واكثروا من الحطب حتي ان كان الطير ليمر بها فيحترق من شدة وهجها وحرها فعمدوا اليه فرفعوه الي راس البنيان فرفع ابراهيم راسه الي السماء فقالت السماء والارض والجبال والملاءكة : ربنا ابراهيم يحرق فيك
 قال : انا اعلم به فان دعاكم فاغيثوه
 وقال ابراهيم حين رفع راسه الي السماء : اللهم انت الواحد في السماء وانا الواحد في الارض ليس احد يعبدك غيري حسبي الله ونعم الوكيل
