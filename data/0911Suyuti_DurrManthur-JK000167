 اخرج سنيد وابن جرير وابن المنذر وابن ابي حاتم وابو الشيخ عن مجاهد رضي الله عنه في قوله @QB@ يا ايها الذين امنوا ما لكم اذا قيل لكم انفروا @QE@ الاية
 قال : هذا حين امروا بغزوة تبوك بعد الفتح وحنين امرهم بالنفير في الصيف حين خرقت الارض فطابت الثمار واشتهوا الظلال وشق عليهم المخرج فانزل الله سبحانه وتعالي ( انفروا خفافا وثقالا ) ( التوبة الاية  )
 قوله تعالي : @QB@ ارضيتم بالحياة الدنيا من الاخرة فما متاع الحياة الدنيا في الاخرة الا قليل @QE@ واخرج الحاكم وصححه عن المستور رضي الله عنه قال : كنا عند النبي صلي الله عليه وسلم فتذاكروا الدنيا والاخرة فقال بعضهم : انما الدنيا بلاغ للاخرة فيها العمل وفيها الصلاة وفيها الزكاة وقالت طاءفة منهم : الاخرة فيها الجنة
 وقالوا ما شاء الله فقال رسول الله صلي الله عليه وسلم ما الدنيا في الاخرة الا كما يمشي احدكم الي اليم فادخل اصبعه فيه فما خرج منه فهي الدنيا
 واخرجه احمد والترمذي وحسنه وابن ماجة عن المستور بن شداد رضي الله عنه قال : كنت في ركب مع رسول الله صلي الله عليه وسلم اذ مر بسخلة ميتة فقال اترون هذه هانت علي اهلها حين القوها قالوا : من هوانها القوها يا رسول الله قال : فالدنيا اهون علي الله من هذه علي اهلها
 واخرج الحاكم وصححه عن ابن مسعود رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم ان الله جعل الدنيا قليلا وما بقي منها الا القليل كالثعلب في الغدير شرب صفوه وبقي كدره
  واخرج الحاكم وصححه عن ابن عباس رضي الله عنهما قال : دخل عمر رضي الله عنه علي النبي صلي الله عليه وسلم وهو علي حصير قد اثر في جنبه فقال : يا رسول الله لو اتخذت فرشا اوثر من هذا فقال ما لي وللدنيا وما للدنيا وما لي والذي نفسي بيده ما مثلي ومثل الدنيا الا كراكب سار في يوم صاءف فاستظل تحت شجرة ساعة ثم راح وتركها
 واخرج ابن ابي شيبة واحمد والترمذي وصححه وابن ماجة والحاكم عن ابن مسعود رضي الله عنه ان النبي صلي الله عليه وسلم نام علي حصير فقام وقد اثر في جنبه فقلنا يا رسول الله : لو اتخذنا لك فقال : ما لي وللدنيا ما انا في الدنيا الا كراكب استظل تحت ظل شجرة ثم راح وتركها
 واخرج الحاكم وصححه عن سهل رضي الله عنه قال : مر رسول الله صلي الله عليه وسلم بذي الحليفة فراي شاة شاءلة برجلها فقال اترون هذه الشاة هينة علي صاحبها قالوا : نعم يا رسول الله
 قال : والذي نفسي بيده للدنيا اهون علي الله من هذه علي صاحبها ولو كانت تعدل عند الله جناح بعوضة ما سقي الكافر منها شربة ماء
 واخرج الحاكم وصححه والبيهقي في الاسماء والصفات عن ابي موسي الاشعري رضي الله عنه ان رسول الله صلي الله عليه وسلم قال : من احب دنياه اضر باخرته ومن احب اخرته اضر بدنياه فاثروا ما يبقي علي ما يفني
 واخرج الحكيم الترمذي في نوادر الاصول وابن ابي الدنيا في كتاب المنامات والحاكم وصححه والبيهقي عن النعمان بن بشير رضي الله عنه سمعت رسول الله صلي الله عليه وسلم يقول : انه لم يبق من الدنيا الا مثل الذباب تمور في جوها فالله الله في اخوانكم من اهل القبور فان اعمالكم تعرض عليهم
 واخرج الترمذي والحاكم وصححه والبيهقي عن قتادة بن النعمان رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم اذا احب الله عبدا حماه من الدنيا كما يحمي احدكم مريضه الماء
 واخرج احمد والحاكم وصححه والبيهقي عن ابي مالك الاشعري رضي الله عنه سمعت رسول الله صلي الله عليه وسلم يقول : حلوة الدنيا مرة الاخرة ومرة الدنيا حلوة الاخرة
 واخرج الحاكم وصححه والبيهقي عن ابي جحيفة قال : اكلت لحما كثيرا وثريدا ثم جءت فقعدت قبال النبي صلي الله عليه وسلم فجعلت اتجشا فقال اقصر من جشاءك فان اكثر الناس شبعا في الدنيا اكثرهم جوعا في الاخرة
  واخرج الحاكم وصححه والبيهقي عن عاءشة رضي الله عنها قالت : قال النبي صلي الله عليه وسلم يا عاءشة ان اردت اللحوق بي فليكفك من الدنيا كزاد الراكب ولا تستخلفي ثوبا حتي ترقعيه واياك ومجالسة الاغنياء
 واخرج الحاكم وصححه وضعفه الذهبي عن سعد بن طارق رضي الله عنه عن ابيه قال : قال رسول الله صلي الله عليه وسلم نعمت الدار الدنيا لمن تزود منها لاخرته حتي يرضي ربه وبءست الدار لمن صدته عن اخرته وقصرت به عن رضا ربه واذا قال العبد : قبح الله الدنيا
 قالت الدنيا : قبح الله اعصانا لربه
 واخرج ابن ماجة والحاكم وصححه والبيهقي عن سهل بن سعد رضي الله عنه ان النبي صلي الله عليه وسلم وعظ فقال : ازهد الدنيا يحبك الله وازهد فيما في ايدي الناس يحبك الناس
 واخرج احمد والحاكم عن عبد الله بن عمر رضي الله عنهما قال : قال رسول الله صلي الله عليه وسلم الدنيا سجن المءمن وسننه فاذا خرج من الدنيا فارق السجن والسنة
 واخرج الحاكم والبيهقي عن حذيفة رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم من اصبح والدنيا اكبر همه فليس من الله في شء ومن لم يهتم للمسلمين فليس منهم
 واخرج ابن ابي شيبة والحاكم وصححه عن الاعمش عن ابي سفيان رضي الله عنه عن اشياخه قال : دخل سعد رضي الله عنه علي سلمان يعوده فبكي فقال سعد : ما يبكيك يا ابا عبد الله قال : توفي رسول الله صلي الله عليه وسلم وهو عنك راض وترد عليه الحوض وتلقي اصحابك
 قال : ما ابكي جزعا من الموت ولا حرصا علي الدنيا ولكن رسول الله صلي الله عليه وسلم عهد الينا عهدا
 قال ليكن بلغة احدكم من الدنيا كزاد الراكب
 وحولي هذه الاساودة وانما حوله اجانة وجفنة ومطهرة
 واخرج الحاكم وصححه عن انس قال : قال رسول الله صلي الله عليه وسلم ياتي علي الناس زمان يتحلقون في مساجدهم وليس همهم الا الدنيا ليس لله فيهم حاجة فلا تجالسوهم
 واخرج الحاكم وصححه وضعفه الذهبي عن ابن مسعود قال : قال رسول الله صلي الله عليه وسلم اقتربت الساعة ولا يزداد الناس علي الدنيا الا حرصا ولا يزدادون من الله الا بعدا
  واخرج ابن ابي شيبة واحمد في الزهد عن سفيان قال : كتب عمر الي ابي موسي الاشعري قال : لو كانت الدنيا تزن عند الله جناح ذبابة ما سقي منها كافرا شربة ماء
 واخرج ابن ابي شيبة واحمد ومسلم والترمذي والنساءي وابن ابي حاتم وابن مردويه عن المستور قال : قال رسول الله صلي الله عليه وسلم ما الدنيا في الاخرة الا كما يجعل احدكم اصبعه في اليم ثم يرفعها فلينظر ثم يرجع
 واخرج عبد الله بن احمد في زواءد الزهد وابن ابي حاتم وابن مردويه عن ابي عثمان النهدي قال : قلت يا ابا هريرة : سمعت اخواني بالبصرة يزعمون انك تقول : سمعت نبي الله صلي الله عليه وسلم يقول ان الله يجزي بالحسنة الف الف حسنة فقال ابو هريرة : سمعت رسول الله صلي الله عليه وسلم يقول : ان الله يجزي بالحسنة الفي الف حسنة ثم تلا هذه الاية @QB@ فما متاع الحياة الدنيا في الاخرة الا قليل @QE@ فالدنيا ما مضي منها الي ما بقي منها عند الله قليل وقال ( من ذا الذي يقرض الله قرضا حسنا فيضاعفه له اضعافا كثيرة ) ( البقرة الاية  ) فكيف الكثير عند الله تعالي اذا كانت الدنيا ما مضي منها وما بقي عند الله قليل
 واخرج ابن ابي حاتم عن الاعمش في قوله @QB@ فما متاع الحياة الدنيا في الاخرة الا قليل @QE@ كزاد الراعي
 واخرج ابن ابي حاتم عن ابي حازم قال : لما حضرت عبد العزيز بن مروان الوفاة قال : اءتوني بكفني الذي اكفن فيه انظر اليه فلما وضع بين يديه نظر اليه فقال : امالي كثير ما اخلف من الدنيا الا هذا ثم ولي ظهره وبكي وقال : اف لك من دار ان كان كثيرك القليل وان كان قليلك الكثير وان كنا منك لفي غرور
