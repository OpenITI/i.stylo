 واخرج ابن جرير عن ابن مسعود في قوله @QB@ الذين يءمنون بالغيب @QE@ قال : هم المءمنون من العرب قال : و @QB@ الايمان @QE@ التصديق و @QB@ الغيب @QE@ ما غاب عن العباد من امر الجنة والنار وما ذكر الله في القران لم يكن تصديقهم بذلك من قبل اصحاب الكتاب او علم كان عندهم @QB@ والذين يءمنون بما انزل اليك @QE@ هم المءمنون من اهل الكتاب ثم جمع الفريقين فقال @QB@ اولءك علي هدي @QE@ الاية
 واخرج ابن جرير وابن ابي حاتم عن ابي العالية في قوله @QB@ الذين يءمنون بالغيب @QE@ قال : بالله وملاءكته ورسله واليوم الاخر وجنته وناره ولقاءه والحياة بعد الموت
 واخرج عبد بن حميد وابن جريرعن قتادة في قوله @QB@ الذين يءمنون بالغيب @QE@ قال : امنوا بالبعث بعد الموت والحساب والجنة والنار وصدقوا بموعود الله الذي وعد في هذا القران
 واخرج الطستي في مساءله عن ابن عباس ان نافع بن الازرق قال له : اخبرني عن قوله عز وجل @QB@ الذين يءمنون بالغيب @QE@ قال : ما غاب عنهم من امر الجنة والنار قال وهل تعرف العرب ذلك قال : نعم
 اما سمعت ابا سفيان بن الحرث يقول :  وبالغيب امنا وقد كان قومنا يصلون للاوثان قبل محمد واخرج ابن ابي حاتم والطبراني وابن منده وابو نعيم كلاهما في معرفة الصحابة عن تويلة بنت اسلم قال : صليت الظهر او العصر في مسجد بني حارثة فاستقبلنا مسجد ايلياء فصلينا سجدتين ثم جاءنا من يخبرنا ان رسول الله صلي الله عليه وسلم قد استقبل البيت الحرام فتحول الرجال مكان النساء والنساء مكان الرجال فصلينا السجدتين الباقيتين ونحن مستقبلو البيت الحرام
 فبلغ رسول الله صلي الله عليه وسلم ذلك فقال اولءك قوم امنوا بالغيب
 واخرج سفيان بن عيينة وسعيد بن منصور واحمد بن منيع في مسنده وابن ابي حاتم وابن الانباري في المصاحف والحاكم وصححه وابن مردويه عن الحرث بن قيس انه قال لابن مسعود : عند الله يحتسب ما سبقتمونا به يا اصحاب محمد من رءية رسول الله صلي الله عليه وسلم
 فقال ابن مسعود : عند الله يحتسب ايمانكم بمحمد صلي الله عليه وسلم ولم تروه ان امر محمد كان بيننا لمن راه
 والذي لا اله غيره
 ما امن احد افضل من ايمان بغيب
 ثم قرا ( الم ذلك الكتاب لا ريب فيه ) ( البقرة الاية    ) الي قوله ( المفلحون ) ( البقرة الاية  )
 واخرج البزار وابو يعلي والمرهبي في فضل العلم والحاكم وصححه عن عمر بن الخطاب قال كنت جالسا مع النبي صلي الله عليه وسلم فقال انبءوني بافضل اهل الايمان ايمانا قالوا : يا رسول الله الملاءكة

 قال : هم كذلك ويحق لهم وما يمنعهم وقد انزلهم الله المنزلة التي انزلهم بها قالوا : يا رسول الله الانبياء الذين اكرمهم الله برسالاته والنبوة قال : هم كذلك ويحق لهم وما يمنعهم وقد انزلهم الله المنزلة التي انزلهم بها قالوا : يا رسول الله الشهداء الذين استشهدوا مع الانبياء

 قال : هم كذلك ويحق لهم وما يمنعهم وقد اكرمهم الله بالشهادة مع الانبياء
 بل غيرهم قالوا : فمن يا رسول الله قال : اقوام في اصلاب الرجال ياتون من بعدي يءمنون بي ولم يروني ويصدقوني ولم يروني يجدون الورق المعلق فيعملون بما فيه فهءلاء افضل اهل الايمان ايمانا
 واخرج الحسن بن عروة في حزبه المشهور والبيهقي في الدلاءل والاصبهاني في الترغيب عن عمرو بن شعيب عن ابيه عن جده قال : قال رسول الله صلي الله عليه وسلم اي  الخلق اعجب اليكم ايمانا قالوا : الملاءكة

 قال : وما لهم لايءمنون وهم عند ربهم
 قالوا : فالانبياء

 قال : فما لهم لا يءمنون والوحي ينزل عليهم
 قالوا : فنحن

 قال : وما لكم لاتءمنون وانا بين اظهركم الا ان اعجب الخلق الي ايمانا لقوم يكونون من بعدكم يجدون صحفا فيها كتاب يءمنون بما فيه
 واخرج الطبراني عن ابن عباس قال : اصبح رسول الله صلي الله عليه وسلم يوما فقال ما من ماء ما من ماء قالوا : لا
 قال : فهل من شن فجاءا بالشن فوضع بين يدي رسول الله صلي الله عليه وسلم ووضع يده عليه ثم فرق اصابعه فنبع الماء مثل عصا موسي من بين اصابع رسول الله صلي الله عليه وسلم فقال : يا بلال اهتف بالناس بالوضوء فاقبلوا يتوضءن من بين اصابع رسول الله صلي الله عليه وسلم وكانت همة ابن مسعود الشرب فلما توضءا صلي بهم الصبح ثم قعد للناس فقال : يا ايها الناس من اعجب الخلق ايمانا قالوا : الملاءكة
 قال : كيف لا تءمن الملاءكة وهم يعاينون الامر قالوا : فالنبيون يا رسول الله
 قال : كيف لا يءمن النبيون والوحي ينزل عليهم من السماء قالوا : فاصحابك يا رسول الله
 فقال : وكيف لا تءمن اصحابي وهم يرون ما يرون ولكن اعجب الناس ايمانا قوم يجيءون بعدي يءمنون بي ولم يروني ويصدقوني ولم يروني اولءك اخواني
 واخرج الاسماعيلي في معجمه عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم اي شء اعجب ايمانا قيل : الملاءكة

 فقال : كيف وهم في السماء يرون من الله ما لا ترون قيل : فالانبياء

 قال : كيف وهم يايتهم الوحي قالوا : فنحن

 قال : كيف وانتم تتلي عليكم ايات الله وفيكم رسوله ولكن قوم ياتون من بعدي يءمنون بي ولم يروني اولءك اعجب ايمانا واولءك اخواني وانتم اصحابي
 واخرج البزار عن انس قال : قال رسول الله صلي الله عليه وسلم اي الخلق اعجب ايمانا قالوا : الملاءكة
 قال : الملاءكة

 كيف لا يءمنون قالوا : النبيون

 قال : النبيون يوحي اليهم فكيف لا يءمنون ولكن اعجب الناس ايمانا قوم يجيءون من بعدكم فيجدون كتابا من الوحي فيءمنون به ويتبعونه
 فهءلاء اعجب الناس ايمانا
 واخرج ابن ابي شيبة في مسنده عن عوف بن مالك قال : قال رسول الله صلي الله عليه وسلم يا ليتني قد لقيت اخواني قالوا يا رسول الله السنا اخوانك واصحابك قال :  بلي
 ولكن قوما يجيءون من بعدكم يءمنون بي ايمانكم ويصدقوني تصديقكم وينصروني نصركم
 فيا ليتني قد لقيت اخواني
 واخرج ابن عساكر في الاربعين السباعية من طريق ابي هدبة وهو كذاب عن انس قال : قال رسول الله صلي الله عليه وسلم ليتني قد لقيت اخواني فقال له رجل من اصحابه : اولسنا اخوانك قال : بلي
 انتم اصحابي واخواني قوم ياتون من بعدي يءمنون بي ولم يروني ثم قرا @QB@ الذين يءمنون بالغيب ويقيمون الصلاة @QE@
 واخرج احمد والدارمي والباوردي وابن قانع معا في معجم الصحابة والبخاري في تاريخه والطبراني والحاكم عن ابي جمعة الانصاري قال قلنا يار سول الله هل من قوم اعظم منا اجرا امنا بك واتبعناك
 قال : ما يمنعكم من ذلك ورسول الله بين اظهركم ياتيكم الوحي من السماء بل قوم ياتون من بعدي ياتيهم كتاب بين لوحين فيءمنون به ويعملون بما فيه اولءك اعظم منكم اجرا
 واخرج ابن ابي شيبة وابن ابي عمر واحمد والحاكم عن ابي عبد الرحمن الجهني قال بينما نحن مع رسول الله صلي الله عليه وسلم اذ طلع راكبان فقال رسول الله صلي الله عليه وسلم كنديان او مذحجيان حتي اتيا فاذا رجلان من مذحج
 فدنا احدهما ليبايعه فلما اخذ بيده قال : يا رسول الله ارايت من امن بك واتبعك وصدقك فماذا له قال : طوبي له فمسح علي يده وانصرف
 ثم جاء الاخر ختي اخذ علي يده ليبايعه فقال : يا رسول الله ارايت من امن بك وصدقك واتبعك ولم يرك قال : طوبي له
 ثم طوبي له
 ثم مسح علي يده وانصرف
 واخرج الطيالسي واحمد والبخاري في تاريخه والطبراني والحاكم عن ابي امامة الباهلي قال : قال رسول الله صلي الله عليه وسلم طوبي لمن راني وامن بي وطوبي لمن امن بي ولم يرني سبع مرات
 واخرج احمد وابن حبان عن ابي سعيد الخدري عن رسول الله صلي الله عليه وسلم ان رجلا قال : يا رسول الله طوبي لمن راك و امن بك
 قال : طوبي لمن راني وامن بي وطوبي ثم طوبي ثم طوبي لمن امن بي ولم يرني
 واخرج الطيالسي وعبد بن حميد عن نافع قال : جاء رجل الي ابن عمر  فقال : يا ابا عبد الرحمن رايتم رسول الله صلي الله عليه وسلم باعينكم هذه قال : نعم
 قال : طوبي لكم
 فقال ابن عمر : الا اخبرك بشء سمعته من رسول الله صلي الله عليه وسلم قال : بلي
 قال : سمعته يقول قال طوبي لمن راني وامن بي وطوبي لمن امن بي ولم يرني ثلاث مرات
 واخرج احمد وابو يعلي والطبراني عن انس قال : قال رسول الله صلي الله عليه وسلم طوبي لمن راني وامن بي وطوبي لمن امن بي ولم يرني سبع مرات
 واخرج الحاكم عن ابي هريرة مرفوعا ان ناسا من امتي ياتون بعدي يود احدهم لو اشتري رءيتي باهله وماله
 واخرج ابن جرير وابن ابي حاتم وابن اسحاق عن ابن عباس في قوله @QB@ ويقيمون الصلاة @QE@ قال : الصلوات الخمس @QB@ ومما رزقناهم ينفقون @QE@ قال : زكاة اموالهم
 واخرج ابن اسحاق وابن جرير وابن ابي حاتم عن ابن عباس في قوله @QB@ ويقيمون الصلاة @QE@ قال : يقيمونها بفروضها @QB@ ومما رزقناهم ينفقون @QE@ قال : يءدون الزكاة احتسابا لها
 واخرج ابن جريرعن ابن عباس قال : اقامة الصلاة اتمام الركوع والسجود والتلاوة والخشوع والاقبال عليها فيها
 واخرج عبد بن حميد عن قتادة في قوله @QB@ يقيمون الصلاة @QE@ قال : اقامة الصلاة المحافظة علي مواقيتها ووضءءها وركوعها وسجودها @QB@ ومما رزقناهم ينفقون @QE@ قال : انفقوا في فرءض الله التي افترض الله عليهم في طاعته وسبيله
 واخرج ابن المنذر عن سعيد بن جبير في قوله @QB@ ومما رزقناهم ينفقون @QE@ قال : انما يعني الزكاة خاصة دون ساءر النفقات
 لا يذكر الصلاة الا ذكر معها الزكاة فاذا لم يسم الزكاة قال في اثر ذكر الصلاة @QB@ ومما رزقناهم ينفقون @QE@
 واخرج ابن جرير عن ابن مسعود في قوله @QB@ ومما رزقناهم ينفقون @QE@ قال : هي نفقة الرجل علي اهله
 واخرج ابن جرير عن الضحاك في قوله @QB@ ومما رزقناهم ينفقون @QE@ قال : كانت النفقات قربانا يتقربون بها الي الله علي قدر ميسورهم وجهدهم حتي نزلت فراءض الصدقات في سورة براءة
