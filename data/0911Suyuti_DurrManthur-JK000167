  اخرج البخاري ومسلم وعبد الرزاق وعبد بن حميد والنساءي وابن جرير وابن المنذر وابن ابي حاتم وابو الشيخ وابن مردويه عن سعيد بن المسيب قال : البحيرة
 التي يمنع درها للطواغيت ولا يحلبها احد من الناس والساءبة : كانوا يسيبونها لالهتهم  لا يحمل عليها شء
 قال : وقال ابو هريرة : قال رسول الله صلي الله عليه وسلم رايت عمرو بن عامر الخزاعي يجر قصبه في النار كان اول من سيب السواءب قال ابن المسيب : والوصيلة
 الناقة البكر تبكر في اول نتاج الابل ثم تثني بعد بانثي وكانوا يسيبونها لطواغيتهم ان وصلت احداهما بالاخري ليس بينهما ذكر والحامي : فحل الابل يضرب الضراب المعدود فاذا قضي ضرابه ودعوه للطواغيت واعفوه من الحمل فلم يحمل شء وسموه الحتمي
 واخرج احمد وعبد بن حميد والحكيم الترمذي في نوادر الاصول وابن جرير وابن المنذر وابن ابي حاتم والبيهقي في الاسماء والصفات عن ابي الاحوص عن ابيه قال : اتيت رسول الله صلي الله عليه وسلم في خلقان من الثياب فقال لي : هل لك من مال قلت : نعم
 قال : من اي مال قلت : من كل المال من الابل والغنم والخيل والرقيق
 قال : فاذا اتاك الله مالا فلير عليك ثم قال : تنتج ابلك رافية اذانها قلت : نعم وهل تنتج الابل الا كذلك قال : فلعلك تاخذ موسي قتقطع اذان طاءفة منها وتقول : هذه بحر وتشق اذان طاءفة منها وتقول : هذه الصرم قلت : نعم
 قال : فلا تفعل ان كل ما اتاك الله لك حل ثم قال @QB@ ما جعل الله من بحيرة ولا ساءبة ولا وصيلة ولا حام @QE@ قال ابو الاحوص : اما البحيرة فهي التي يجدعون اذانها فلا تنتفع امراته ولا بناته ولا احد من اهل بيته بصوفها ولا اوبارها ولا اشعارها ولا البانها فاذا ماتت اشتركوا فيها
 واما الساءبة : فهي التي يسيبون لالهتهم
 واما الوصيلة : فالشاة تلد ستة ابطن وتلد السابع جديا وعناقا فيقولون : قد وصلت فلا يذبحونها ولا تضرب ولا تمنع مهما وردت علي حوض واذا ماتت كانوا فيها سواء
 والحام من الابل اذا ادرك له عشرة من صلبه كلها تضرب حمي ظهره فسمي الحام فلا ينتفع له بوبر ولا ينحر ولا يركب له ظهر فاذا مات كانوا فيه سواء
 واخرج ابن جرير وابن المنذر وابن ابي حاتم من طريق علي بن ابي طلحة عن ابن عباس قال : البحيرة
 هي الناقة اذا انتجت خمسة ابطن نظروا الي الخامس فان كان ذكرا ذبحوه فاكله الرجال دون النساء وان كانت انثي جدعوا اذانها فقالوا : هذه بحيرة
 واما الساءبة : فكانوا يسيبون من انعامهم لالهتهم لا يركبون لها ظهرا ولا يحلبون لها لبنا ولا يجزون لها وبرا ولا يحملون عليها شيءا
 واما  الوصيلة : فالشاة اذا انتجت سبعة ابطن نظروا السابع فان كان ذكرا او انثي وهو ميت اشترك فيه الرجال دون النساء وان كانت انثي اسحيوها وان كان ذكرا وانثي في بطن استحيوهما وقالوا : وصلته اخته فحرمته علينا
 واما الحام : فالفحل من الابل اذا ولد لولده قالوا : حمي هذا ظهره فلا يحملون عليه شيءا ولا يجزون له وبرا ولا يمنعونه من حمي رعي ولا من حوض يشرب منه وان كان الحوض لغير صاحبه
 واخرج ابن جرير وابن ابي حاتم وابن مردويه من طريق العوفي عن ابن عباس في قوله @QB@ ما جعل الله من بحيرة @QE@ قال : البحيرة الناقة كان الرجل اذا ولدت خمسة فيعمد الي الخامسة فما لم تكن سقيا فيبتك اذانها ولا يجز لها وبرا ولا يذوق لها لبنا فتلك البحيرة @QB@ ولا ساءبة @QE@ كان الرجل يسيب من ماله ما شاء @QB@ ولا وصيلة @QE@ فهي الشاة اذا ولدت سبعا عمد الي السابع فان كان ذكرا ذبح وان كانت انثي تركت وان كان في بطنها اثنان ذكر وانثي فولدتهما قالوا : وصلت اخاها فيتركان جميعا لا يذبحان فتلك الوصيلة @QB@ ولا حام @QE@ كان الرجل يكون له الفحل فاذا القح عشرا قيل : حام فاتركوه
 واخرج عبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم عن مجاهد في قوله @QB@ ما جعل الله من بحيرة @QE@ الاية
 قال : البحيرة من الابل كان اهل الجاهلية يحرمون وبرها وظهرها ولحمها ولبنها الا علي الرجال فما ولدت من ذكر وانثي فهو علي هيءتها فان ماتت اشترك الرجال والنساء في اكل لحمها فاذا ضرب من ولد البحيرة فهو الحامي والساءبة من الغنم علي نحو ذلك الا انها ما ولدت من ولد بينها وبين ستة اولاد كان علي هيءتها فاذا ولدت في السابع ذكرا او انثي او ذكرين ذبحوه فاكله رجالهم دون نساءهم وان توامت انثي وذكر فهي وصيلة ترك ذبح الذكر بالانثي وان كانتا انثيين تركتا
 واخرج ابن المنذر عن ابي سعيد الخدري قال صلي بنا رسول الله صلي الله عليه وسلم الظهر فاستاخر عن قبلته واعرض بوجهه وتعوذ بالله ثم دنا من قبلته حتي رايناه يتناول بيده فلما سلم رسول الله صلي الله عليه وسلم قلنا : يا نبي الله لقد صنعت اليوم في صلاتك شيءا ماكنت تصنعه
 قال : نعم عرضت علي في مقامي هذا الجنة والنار فرايت في النار ما لا يعلمه الا الله ورايت فيها الحميرية صاحبة الهرة التي ربطتها فلم  تطعمها ولم تسقها ولم ترسلها فتاكل من خشاش الارض حتي ماتت في رباطها ورايت فيها عمرو بن لحي يجر قصبه في النار وهو الذي سيب السواءب وبحر البحيرة ونصب الاوثان وغير دين اسماعيل ورايت فيها عمران الغفاري معه محجنه الذي كان يسرق به الحاج
 قال : وسمي لي الرابع فنسيته
 ورايت الجنة فلم ار مثل ما فيها فتناولت منها قطفا لاريكموه فحيل بيني وبينه فقال رجل من القوم : كيف تكون الحبة منه قال : كاعظم دلو فرته امك قط
 قال محمد بن اسحاق : فسالت عن الرابع فقال : هو صاحب ثنيتي رسول الله صلي الله عليه وسلم الذي نزعهما
 واخرج البخاري وابن مردويه عن عاءشة قالت : قال رسول الله صلي الله عليه وسلم رايت جهنم يحطم بعضها بعضا ورايت عمرا يجر قصبه في النار وهو اول من سيب السواءب
 واخرج ابن ابي شيبة وابن جرير وابن مردويه والحاكم وصححه عن ابي هريرة قال سمعت رسول الله صلي الله عليه وسلم يقول لاكتم بن الجون : يا اكتم عرضت علي النار فرايت فيها عمرو بن لحي بن قمعة بن خندف يجر قصبه في النار فما رايت رجلا اشبه برجل منك به ولا به منك
 فقال اكتم : اخشي ان يضرني شبهه يا رسول الله فقال رسول الله صلي الله عليه وسلم : لا انك مءمن وهو كافر انه اول من غير دين ابراهيم وبحر البحيرة وسيب الساءبة وحمي الحامي
 واخرج احمد وعبد بن حميد وابن مردويه عن ابن مسعود عن النبي صلي الله عليه وسلم قال ان اول من سيب السواءب وعبد الاصنام ابو خزاعة عمرو بن عامر واني رايته يجر امعاءه في النار
 واخرج عبد الرزاق وابن ابي شيبة وعبد بن حميد وابن جرير عن زيد بن اسلم قال : قال رسول الله صلي الله عليه وسلم اني لاعرف اول من سيب السواءب ونصب النصب واول من غير دين ابراهيم قالوا : من هو يا رسول الله قال : عمرو بن لحي اخو بني كعب لقد رايته يجر قصبه في النار يءذي اهل النار ريح قصبه واني لاعرف من بحر البحاءر
 قالوا : من هو يا رسول الله قال : رجل من بني مدلج كانت له ناقتان فجدع اذانهما وحرم البانهما وظهورهما وقال : هاتان لله ثم احتاج اليهما فشرب البانهما وركب ظهورهما قال : فلقد رايته في النار وهما يقضمانه بافواههما ويطانه باخفافهما
  واخرج احمد والحاكم وصححه عن ابي بن كعب قال : بينا نحن مع رسول الله صلي الله عليه وسلم في صلاة الظهر والناس في الصفوف خلفه فرايناه تناول شيءا فجعل يتناوله فتاخر فتاخر الناس ثم تاخر الثانية فتاخر الناس فقلت : يا رسول الله رايناك صنعت اليوم شيءا ما كنت تصنعه في الصلاة فقال : انه عرضت علي الجنة بما فيها من الزهرة والنضرة فتناولت قطفا من عنبها ولو اخذته لاكل منه من بين السماء والارض لا ينقصونه فحيل بيني وبينه وعرضت علي النار فلما وجدت سفعتها تاخرت عنها واكثر من رايت فيها النساء ان اءتمن افشين وان سالن الحفن واذا سءلن بخلن واذا اعطين لم يشكرن ورايت فيها عمرو بن لحي يجر قصبه في النار واشبه من رايت به معبد بن اكتم الخزاعي فقال معبد : يا رسول الله اتخشي علي من شبهه قال : لا انت مءمن وهو كافر وهو اول من حمل العرب علي عبادة الاصنام
 واخرج عبد بن حميد وابو الشيخ عن قتادة @QB@ ولكن الذين كفروا يفترون علي الله الكذب واكثرهم لا يعقلون @QE@ قال : لا يعقلون تحريم الشيطان الذي يحرم عليهم
 واخرج ابو الشيخ عن محمد بن ابي موسي في الاية قال : الاباء جعلوا هذا وماتوا ونشا الابناء وظنوا ان الله هو جعل هذا فقال الله @QB@ ولكن الذين كفروا يفترون علي الله الكذب @QE@ الاباء فالاباء افتروا علي الله الكذب والابناء اكثرهم لا يعقلون يظنون الله هو الذي جعله
 واخرج ابن ابي شيبة وابن جرير وابن المنذر وابن ابي حاتم وابو الشيخ عن محمد بن ابي موسي في قوله @QB@ ولكن الذين كفروا يفترون علي الله الكذب @QE@ قال : هم اهل الكتاب @QB@ واكثرهم لا يعقلون @QE@ قال : هم اهل الاوثان
 واخرج ابن جرير وابن المنذر وابن ابي حاتم عن الشعبي في قوله @QB@ ولكن الذين كفروا يفترون علي الله الكذب واكثرهم لا يعقلون @QE@ قال : الذين لا يعقلوهم الاتباع واما الذين افتروا فعقلوا انهم افتروا
