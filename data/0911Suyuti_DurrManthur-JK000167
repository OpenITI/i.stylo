 اخرج عبد بن حميد وابن المنذر عن قتادة رضي الله عنه في قوله : @QB@ للفقراء المهاجرين الذين اخرجوا @QE@ الاية قال : هءلاء المهاجرون تركوا الديار والاموال والاهلين والعشاءر وخرجوا حبا لله ولرسوله واختاروا الاسلام علي ما كان فيه من شدة حتي لقد ذكر لنا ان الرجل كان يعصب الحجر علي بطنه ليقيم به صلبه من الجوع وان كان الرجل ليتخذ الحفر في الشتاء ما له دثار غيرها
 قوله تعالي : @QB@ والذين تبوءوا الدار والايمان @QE@
 اخرج عبد بن حميد وابن المنذر عن قتادة في قوله : @QB@ والذين تبوءوا الدار والايمان @QE@ الي اخر الاية قال : هم هذا الحي من الانصار اسلموا في ديارهم وابتنوا المساجد قبل قدوم النبي صلي الله عليه وسلم بسنتين واحسن الله عليهم الثناء في ذلك وهاتان الطاءفتان الاولتان من هذه الاية اخذتا بفضلهما ومضنا علي مهلهما واثبت الله حظهما في هذا الفء ثم ذكر الطاءفة الثالثة فقال : @QB@ والذين جاءوا من بعدهم يقولون ربنا اغفر لنا ولاخواننا @QE@ الي اخر الاية
 قال : انما امروا ان يستغفروا لاصحاب النبي صلي الله عليه وسلم ولم يءمروا بسبهم
 واخرج عبد بن حميد وابن المنذر عن مجاهد @QB@ والذين تبوءوا الدار والايمان من قبلهم @QE@  قال : الانصار نعت سخاوة انفسهم عندما راي من ذلك وايثارهم اياهم ولم يصب الانصار من ذلك الفء شء
 واخرج عبد بن حميد وابن المنذر عن يزيد بن الاصم ان الانصار قالوا : يا رسول الله اقسم بيننا وبين اخواننا المهاجرين الارض نصفين قال : لا ولكن يكفونكم المءنة وتقاسمونهم الثمرة والارض ارضكم قالوا : رضينا فانزل الله @QB@ والذين تبوءوا الدار والايمان من قبلهم @QE@ الي اخر الاية
 اخرج عبد الرزاق وابن ابي شيبة وعبد بن حميد وابن المنذر عن الحسن قال : فضل المهاجرين علي الانصار فلم يجدوا في صدورهم حاجة قال : الحسد
 واخرج ابن ابي شيبة والبخاري وابن مردويه عن عمر انه قال : اوصي الخليفة بعدي بالمهاجرين الاولين ان يعرف لهم حقهم ويحفظ لهم حرمتهم واوصيه بالانصار الذين تبوءا الدار والايمان من قبل ان يهاجر النبي صلي الله عليه وسلم ان يقبل من محسنهم ويعفو عن مسيءهم
 واخرج الزبير بن بكار في اخبار المدينة عن زيد بن اسلم قال : قال رسول الله صلي الله عليه وسلم : للمدينة عشرة اسماء هي المدينة وهي طيبة وطابة ومسكينة وجابرة ومجبورة وتبدد ويثرب والدار
 قوله تعالي : @QB@ ويءثرون علي انفسهم ولو كان بهم خصاصة @QE@
 اخرج ابن ابي شيبة والبخاري ومسلم والترمذي والنساءي وابن جرير وابن المنذر والحاكم وابن مردويه البيهقي في الاسماء والصفات عن ابي هريرة رضي الله عنه قال : اتي رجل لرسول الله صلي الله عليه وسلم فقال : يا رسول الله اصابني الجهد فارسل الي نساءه فلم يجد عندهن شيءا فقال : الا رجل يضيف هذا الليلة رحمه الله تعالي فقال رجل من الانصار وفي رواية فقال ابو طلحة الانصاري : انا يا رسول الله فذهب به الي اهله فقال لامراته : اكرمي ضيف رسول الله صلي الله عليه وسلم لا تدخرين شيءا
 قالت : والله ما عندي الا قوت الصبية
 قال : فاذا اراد الصبية العشاء فنوميهم وتعالي فاطفءي السراج ونطوي بطوننا الليلة لضيف رسول الله صلي الله عليه وسلم ففعلت ثم غدا الضيف علي النبي صلي الله عليه وسلم فقال : لقد عجب الله من فلان وفلانة وانزل الله فيهما @QB@ ويءثرون علي انفسهم ولو كان بهم خصاصة @QE@
 واخرج مسدد في مسنده وابن ابي الدنيا في كتاب قري الضيف وابن المنذر عن  ابي المتوكل الناجي رضي الله عنه ان رجلا من المسلمين مكث صاءما ثلاثة ايام يمسي فلا يجد ما يفطر فيصبح صاءما حتي فطن له رجل من الانصار يقال له ثابت بن قيس رضي الله عنه فقال لاهله : اني ساجء الليلة بضيف لي فاذا وضعتم طعامكم فليقم بعضكم الي كانه يصلحه فليطفءه ثم اضربوا بايدكم الي الطعام كانكم تاكلون فلا تاكلوا حتي يشبع ضيفنا فلما امسي ذهب به فوضعوا طعامهم فقامت امراته الي السراج كانها تصلحه فاطفاته ثم جعلوا يضربون ايديهم في الطعام كانهم ياكلون ولا ياكلون حتي شبع ضيفهم وانما كان طعامهم ذلك خبزة هي قوتهم فلما اصبح ثابت غدا الي رسول الله صلي الله عليه وسلم فقال : يا ثابت لقد عجب الله البارحة منكم ومن ضيفكم فنزلت فيه هذه الاية @QB@ ويءثرون علي انفسهم ولو كان بهم خصاصة @QE@
 واخرج الحاكم وصححه وابن مردويه والبيهقي في شعب الايمان عن ابن عمر رضي الله عنه قال : اهدي لرجل من اصحاب رسول الله صلي الله عليه وسلم راس شاة فقال : ان اخي فلانا وعياله احوج الي هذا منا فبعث به اليهم فلم يزل يبعث به واحدا الي اخر حتي تداولها اهل سبعة ابيات حتي رجعت الي الاول فنزلت @QB@ ويءثرون علي انفسهم ولو كان بهم خصاصة @QE@
 واخرج ابن ابي حاتم عن مقاتل رضي الله عنه في قوله : @QB@ ولو كان بهم خصاصة @QE@ قال : فاقة
 قوله تعالي : @QB@ ومن يوق شح نفسه فاولءك هم المفلحون @QE@
 اخرج الفريابي وسعيد بن منصور وابن ابي شيبة وعبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم والطبراني والحاكم وصححه وابن مردويه والبيهقي في شعب الايمان عن ابن مسعود رضي الله عنه ان رجلا قال له : اني اخاف ان اكون قد هلكت قال : وما ذاك قال : اني سمعت الله يقول : @QB@ ومن يوق شح نفسه فاولءك هم المفلحون @QE@ وانا رجل شحيح لا يكاد يخرج مني شء فقال له ابن مسعود رضي الله عنه : ليس ذاك بالشح ولكنه البخل ولا خير في البخل وان الشح الذي ذكره الله في القران ان تاكل مال اخيك ظلما
 واخرج عبد بن حميد وابن المنذر وابن مردويه عن ابن عمر رضي الله عنه في قوله : @QB@ ومن يوق شح نفسه @QE@ قال : ليس الشحيح ان يمنع الرجل ماله ولكنه  البخل وانه لشر انما الشح ان تطمح عين الرجل الي ما ليس له واخرج ابن المنذر عن الحسن رضي الله عنه قال : النظر الي المراة لا يملكها من الشح
 واخرج ابن المنذر عن طاووس رضي الله عنه قال : البخلان يبخل الانسان بما في يديه والشح ان يشح علي ما في ايدي الناس
 واخرج ابن جرير وابن المنذر وابن عساكر عن عبد الرحمن بن عوف انه كان يطوف بالبيت يقول : اللهم قني شح نفسي
 لا يزيد علي ذلك فقيل له فقال : اذا وقيت شح نفسي لا اسرق ولا ازني ولم افعل شيءا
 واخرج عبد بن حميد وابن المنذر عن سعيد بن جبير في قوله : @QB@ ومن يوق شح نفسه @QE@ قال : ادخال الحرام ومنع الزكاة
 واخرج ابن االمنذر عن علي بن ابي طالب قال : من ادي زكاة ماله فقد وقي شح نفسه
 واخرج الخراءطي في مساوء الاخلاق عن ابن عمرو قال : الشح اشد من البخل لان الشحيح يشح علي ما في يديه فيحبسه ويشح علي ما في ايدي الناس حتي ياخذه وان البخيل انما يبخل علي ما في يديه
 واخرج ابن ابي الدنيا في كتاب ذم البخل عن انس رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : خلق الله جنة عدن ثم قال لها : انطقي فقالت : ( قد افلح المءمنون ) ( سورة المءمنون الاية ) فقال الله : وعزتي وجلالي لا يجاورني فيك بخيل ثم تلا رسول الله صلي الله عليه وسلم @QB@ ومن يوق شح نفسه فاولءك هم المفلحون @QE@
 واخرج ابن مردويه عن جابر بن عبد الله رضي الله عنه : سمعت رسول الله صلي الله عليه وسلم يقول : ثلاث من كن فيه فقد برء من الشح من ادي زكاة ماله وقري الضيف واعطي في النواءب
 واخرج الحكيم الترمذي وابو يعلي وابن مردويه عن انس رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : ما محق الاسلام محق الشح شء قط واخرج ابن مردويه عن ابي زرعة قالك قال رسول الله صلي الله عليه وسلم : من كان الفقر في قلبه فلا يغنيه ما اكثر له في الدنيا وانما يضر نفسه شحها
  واخرج عبد بن حميد عن مجمع بن يحيي بن جارية قال : حدثني عمي خالد بن يزيد بن جارية رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : برء من الشح من ادي الزكاة وقري الضيف وادي في الناءبة
 واخرج ابن ابي شيبة والنساءي والحاكم وصححه والبيهقي في الشعب عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : لا يجتمع غبار في سبيل الله ودخان جهنم في جوف عبد ابدا ولا يجتمع الشح والايمان في قلب عبد ابدا
 واخرج الترمذي والبيهقي عن ابي سعيد الخدري قال : قال رسول الله صلي الله عليه وسلم : خصلتان لا يجتمعان في جوف مسلم البخل وسوء الظن
 واخرج ابن ابي شيبة وابو داود وابن مردويه والبيهقي عن ابي هريرة رضي الله عنه عن النبي صلي الله عليه وسلم قال : شر ما في رجل شح هالع وجبن خالع
 واخرج احمد والبخاري في الادب ومسلم والبيهقي عن جابر بن عبد الله ان رسول الله صلي الله عليه وسلم قال : اتقوا الظلم فان الظلم ظلمات يوم القيامة واتقوا الشح فان الشح اهلك من كان قبلكم حملهم علي ان سفكوا دماءهم واستحلوا محارمهم
 واخرج ابن مردويه والبيهقي عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال : اياكم والشح والبخل فانه دعا من قبلكم الي ان يقطعوا ارحامهم فقطعوها ودعاهم الي ان يستحلوا محارمهم فاستحلوها ودعاهم الي ان يسفكوا دماءهم فسفكوها
 واخرج الترمذي والبيهقي عن انس رضي الله عنه ان رجلا توفي فقالوا : ابشر بالجنة فقال رسول الله صلي الله عليه وسلم : او لا تدرون فلعله قد تكلم بما لا يعنيه او بخل بما لا ينفعه
 واخرج البيهقي من وجه اخر عن انس رضي الله عنه قال : اصيب رجل يوم احد فجاءت امراة فقالت : يا بني لتهنك الشهادة فقال لها رسول الله صلي الله عليه وسلم : وما يدريك لعله كان يتكلم بما لا يعنيه ويبخل بما لا يغنيه
 واخرج البيهقي عن ابن عمرو رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : خلقان يحبهما الله وخلقان يبغضهما الله
 فاما اللذان يحبها الله فالسخاء والسماحة واما اللذان يبغضهما الله فسوء الخلق والبخل فاذا اراد الله بعبد خيرا استعمله علي قضاء حواءج الناس
 واخرج ابن جرير وابن مردويه والبيهقي عن انس رضي الله عنه قال : قال رسول  الله صلي الله عليه وسلم : برء من الشح من ادي الزكاة وقري الضيف وادي في الناءبة
 واخرج البيهقي وضعفه عن ابن مسعود قال : قال رسول الله صلي الله عليه وسلم : لا يذهب السخاء علي الله السخي قريب من الله فاذا لقيه يوم القيامة اخذ بيده فاقله عثرته
 واخرج البيهقي عن عمرو بن شعيب عن ابيه عن جده رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : صلاح اول هذه الامة بالزهد والتقوي وهلاك اخرها بالبخل والفجور
 واخرج البيهقي وضعفه عن عاءشة رضي الله عنها قالت : قال رسول الله صلي الله عليه وسلم : السخي قريب من الله قريب من الجنة بعيد من النار والبخيل بعيد من الله بعيد من الجنة قريب من النار والجاهل السخي احب الي الله من العابد البخيل
 واخرج البيهقي عن جابر بن عبد الله قال : قال رسول الله صلي الله عليه وسلم : السخي قريب من الله قريب من الجنة قريب من الناس بعيد من النار والبخيل بعيد من الله بعيد من الجنة بعيد من الناس قريب من النار ولجاهل سخي احب الي الله من عابد بخيل
 واخرج ابن عدي في الكامل والبيهقي وضعفه عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : السخي قريب من الله قريب من الجنة قريب من الناس بعيد من النار والبخيل بعيد من الله بعيد من الجنة بعيد من الناس قريب من النار ولفاجر سخي احب الي الله من عابد بخيل واي داء ادوا من البخل
 واخرج البيهقي عن ابي هريرة رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : يا بني سلمة من سيدكم اليوم قالوا : الجد بن قيس ولكنا نبخله قال : واي داء ادوا من البخل ولكن سيدكم عمرو بن الجموح
 واخرج البيهقي عن جابر رضي الله عنه قال : لما قدم رسول الله صلي الله عليه وسلم قال : يا بني سلمة من سيدكم قالوا : الجد بن قيس وانا لنبخله
 قال : واي داء ادوا من البخل بل سيدكم الخير الابيض عمرو بن الجموح قال : وكان علي اضيافهم في الجاهلية قال : وكان يولم علي رسول الله صلي الله عليه وسلم اذا تزوج
 واخرج البيهقي من طريق الزهري عن عبد الرحمن بن عبد الله بن كعب بن مالك رضي الله عنه ان النبي صلي الله عليه وسلم قال : من سيدكم يا بني سلمة قالوا : الجد بن  قيس قال : وبم تسودونه قالوا : بانه اكثرنا مالا وانا علي ذلك لنزنه بالبخل فقال رسول الله صلي الله عليه وسلم : واي داء ادوا من البخل ليس ذاك سيدكم
 قالوا : فمن سيدنا يا رسول الله قال : سيدكم البراء بن معرور قال البيهقي مرسل
 واخرج الحاكم عن ابي هريرة رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : من سيدكم يا بني عبيد قالوا : الجد بن قيس علي ان فيه بخلا قال : واي داء ادوا من البخل بل سيدكم وابن سيدكم بشر بن البراء بن معرور
 واخرج البيهقي عن ابي بكر الصديق رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : لا يدخل الجنة بخيل ولا خب ولا خاءن ولا سء الملكة واول من يقرع باب الجنة المملوكون واذا احسنوا فيما بينهم وبين الله وبين مواليهم
 واخرج البيهقي عن ابي سهل الواسطي رفع الحديث قال : ان الله اصطنع هذا الدين لنفسه وانما صلاح هذا الدين بالسخاء وحسن الخلق فاكرموه بهما
 واخرج البيهقي من طرق وضعفه عن جابر بن عبد الله قال : قال رسول الله صلي الله عليه وسلم : قال لي جبريل : قال الله تعالي : ان هذا الدين ارتضيته لنفسي ولا يصلحه الا السخاء وحسن الخلق فاكرموه بهما ما صحبتموه
 واخرج البيهقي وضعفه عن عبد الله بن جراد قال : قال رسول الله صلي الله عليه وسلم : اذا ابتغيتم المعروف فابتغوه في حسان الوجوه فوالله لا يلج النار الا بخيل ولا يلج الجنة شحيح ان السخاء شجرة في الجنة تسمي السخاء وان الشح شجرة في النار تسمي الشح
 واخرج البيهقي وضعفه عن جعفر بن محمد عن ابيه عن جده قال : قال رسول الله صلي الله عليه وسلم : السخاء من شجر الجنة اغصانها متدليات في الدنيا من اخذ بغصن منها قاده ذلك الغصن الي الجنة والبخل شجرة من شجر النار اغصانها متدليات في الدنيا من اخذ بغصن منها قاده ذلك الغصن الي النار
 واخرج البيهقي عن ابي هريرة رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : السخاء شجرة في الجنة فمن كان سخيا اخذ بغصن منها فلم يتركه الغصن حتي يدخله الجنة والشح شجرة في النار فمن كان شحيحا اخذ بغصن منها فلم يتركه الغصن حتي يدخله النار
 واخرج البيهقي وضعفه عبن ابن عباس رضي الله عنهما قال : كنت قاعدا مع  النبي صلي الله عليه وسلم فجاء ثلاثة عشر رجلا عليهم ثياب السفر فسلموا علي رسول الله صلي الله عليه وسلم ثم قالوا : من السيد من الرجال يا رسول الله قال : ذاك يوسف بن يعقوب بن اسحاق بن ابراهيم
 قالوا : ما في امتك سيد قال : بلي رجل اعطي مالا حلالا ورزق سماحة فادني الفقير فقلت شكايته في الناس
 واخرج البخاري ومسلم والنساءي عن ابي هريرة قال : ضرب رسول الله صلي الله عليه وسلم مثل البخيل والمتصدق كمثل رجلين عليهما جبتان من حديد قد اضطرت ايديهما الي ثديهما وتراقيهما فجعل كلما تصدق بصدقة انبسطت عنه حتي تغشي انامله وتعفو اثره وجعل البخيل كلما هم بصدقة قلصت واخذت كل حلقة مكانها فهو يوسعها ولا تتسع
 واخرج الزبير بن بكار في الموفقيات عن عبد الله بن ابي عبيدة بن محمد بن عمار بن ياسر قال : قدم خالد بن الوليد من ناحية ارض الروم علي النبي صلي الله عليه وسلم باسري فعرض عليهم الاسلام فابوا فامر ان تضرب اعناقهم حتي اذا جاء الي اخرهم قال النبي صلي الله عليه وسلم : يا خالد كف عن الرجل قال : يا رسول الله ما كان في القوم اشد علي منه
 قال : هذا جبريل يخبرني عن الله انه كان سخيا في قومه فكف عنه واسلم الرومي
