  اخرج ابن جرير وابن ابي حاتم وابو الشيخ عن مجاهد في قوله @QB@ ولو انهم اقاموا التوراة والانجيل @QE@ الاية
 قال : اما اقامتهم التوراة والانجيل فالعمل بهما واما @QB@ وما انزل اليهم من ربهم @QE@ فمحمد صلي الله عليه وسلم وماانزل عليه واما @QB@ لاكلوا من فوقهم @QE@ فارسلت عليه مطرا واما @QB@ ومن تحت ارجلهم @QE@ يقول : لانبت لهم من الارض من رزقي ما يغنيهم @QB@ منهم امة مقتصدة @QE@ وهم مسلمة اهل الكتاب
 واخرج ابن جرير وابن ابي حاتم عن ابن عباس @QB@ لاكلوا من فوقهم @QE@ يعني لارسل عليهم السماء مدرارا @QB@ ومن تحت ارجلهم @QE@ قال : تخرج الارض من بركاتها
 واخرج ابن جرير عن ابن عباس في الاية يقول : لاكلوا من الرزق الذي ينزل من السماء والذي والذي ينبت من الارض
 واخرج عبد بن حميد وابن جرير وابو الشيخ عن قتادة @QB@ لاكلوا من فوقهم ومن تحت ارجلهم @QE@ يقول لاعطتهم السماء بركاتها والارض نباتها @QB@ منهم امة مقتصدة @QE@ علي كتاب الله قد امنوا ثم ذم اكثر القوم فقال @QB@ وكثير منهم ساء ما يعملون @QE@
 واخرج ابن جرير وابو الشيخ عن الربيع بن انس قال : الامة المقتصدة
 الذين لاهم فسقوا في الدين ولاهم غلوا
 قال : والغلو الرغبة والفسق التقصير عنه
 واخرج ابو الشيخ عن السدي @QB@ امة مقتصدة @QE@ يقول مءمنة
  واخرج ابن ابي حاتم عن جبير بن نفير
 ان رسول الله صلي الله عليه وسلم قال : يوشك ان يرفع العلم
 قلت : كيف وقد قرانا القران وعلمناه ابناءنا فقال : ثكلتك امك يا ابن نفير ان كنت لاراك من افقه اهل المدينة اوليست التوراة والانجيل بايدي اليهود والنصاري فما اغني عنهم حين تركوا امر الله ثم قرا @QB@ ولو انهم اقاموا التوراة والانجيل @QE@ الاية
 واخرج احمد وابن ماجة من طريق ابن ابي الجعد عن زياد بن لبيد قال ذكر النبي صلي الله عليه وسلم شيءا فقال : وذلك عند ذهاب ابناءنا يارسول الله وكيف يذهب العلم ونحن نقرا القران ونقرءه ابناءنا ويقرءه ابناءنا ابناءهم الي يوم القيامة قال : ثكلتك امك يا ابن ام لبيد
 ان كنت لاراك من افقه رجل بالمدينة اوليس هذه اليهود والنصاري يقرءون التوراة والانجيل ولاينتفعون مما فيهما بشء
 واخرج ابن مردويه من طريق يعقوب بن زيد بن طلحة عن زيد بن اسلم عن انس بن مالك قال : كنا عند رسول الله صلي الله عليه وسلم فذكر حديثا قال : ثم حدثهم النبي صلي الله عليه وسلم فقال : تفرقت امة موسي علي احدي وسبعين ملة سبعون منها في النار وواحدة منها في الجنة
 وتفرقت امة عيسي علي اثنين وسبعين ملة واحدة منها في الجنة واحدي وسبعون في النار
 وتعلوا انتم علي الفريقين جميعا بملة واحدة في الجنة واثنتان وسبعون في النار قالوا : من هم يارسول الله قال : الجماعات الجماعات
 قال يعقوب بن زيد : كان علي بن ابي طالب اذا حدث بهذا الحديث عن رسول الله صلي الله عليه وسلم تلا فيه قرانا @QB@ ولو ان اهل الكتاب امنوا واتقوا @QE@ الي قوله @QB@ ساء ما يعملون @QE@ وتلا ايضا @QB@ وممن خلقنا امة يهدون بالحق وبه يعدلون @QE@ الاعراف الاية  يعني امة محمد صلي الله عليه وسلم
 < <
  الماءدة : (  ) يا ايها الرسول . . . . .
 > > <
 >  قوله تعالي : يا ايها الرسول بلغ ما انزل اليك من ربك وان لم تفعل فما بلغت رسالته والله يعصمك من الناس ان الله لا يهدي القوم الكافرين
  اخرج ابو الشيخ عن الحسن ان رسول الله صلي الله عليه وسلم قال ان الله بعثني برسالة فضقت  بها ذرعا وعرفت ان الناس مكذبي فوعدني لابلغن او ليعذبني فانزل @QB@ يا ايها الرسول بلغ ما انزل اليك من ربك @QE@
 واخرج عبد بن حميد وابن جرير وابن ابي حاتم وابو الشيخ عن مجاهد قال : لما نزلت @QB@ بلغ ما انزل اليك من ربك @QE@ قال : يارب انما انا واحد كيف اصنع ليجتمع علي الناس فنزلت @QB@ وان لم تفعل فما بلغت رسالته @QE@ واخرج ابن ابي حاتم وابن مردويه وابن عساكر عن ابي سعيد الخدري قال : نزلت هذه الاية @QB@ يا ايها الرسول بلغ ما انزل اليك من ربك @QE@ علي رسول الله صلي الله عليه وسلم يوم غدير خم في علي بن ابي طالب
 واخرج ابن مردويه عن ابن مسعود قال : كنا نقرا علي عهد رسول الله صلي الله عليه وسلم @QB@ يا ايها الرسول بلغ ما انزل اليك من ربك @QE@ ان عليا مولي المءمنين @QB@ وان لم تفعل فما بلغت رسالته والله يعصمك من الناس @QE@
 واخرج ابن ابي حاتم عن عنترة
 انه قال لعلي هل عندكم شء لم يبده رسول الله صلي الله عليه وسلم للناس فقال : الم تعلم ان الله قال @QB@ يا ايها الرسول بلغ ما انزل اليك من ربك @QE@ والله ماورثنا رسول الله صلي الله عليه وسلم سوداء في بيضاء
 اما قوله تعالي : @QB@ والله يعصمك من الناس @QE@
 اخرج ابن مردويه والضياء في المختارة عن ابن عباس قال : سءل رسول الله صلي الله عليه وسلم اي اية انزلت من السماء اشد عليك فقال كنت بمني ايام موسم واجتمع مشركوا العرب وافناء الناس في الموسم فنزل علي جبريل فقال @QB@ يا ايها الرسول بلغ ما انزل اليك من ربك وان لم تفعل فما بلغت رسالته والله يعصمك من الناس @QE@ قال : فقمت عند العقبة فناديت : ياايها الناس من ينصرني علي ان ابلغ رسالة ربي ولكم الجنة ايها الناس قولوا لا اله الا الله وانا رسول الله اليكم وتنجحوا ولكم الجنة
 قال : فما بقي رجل ولا امراة ولا صبي الا يرمون علي بالتراب والحجارة ويبصقون في وجهي ويقولون : كذاب صابء فعرض علي عارض فقال : يامحمد ان كنت رسول الله فقد ان لك ان تدعو عليهم كما دعا نوح علي قومه بالهلاك
 فقال النبي صلي الله عليه وسلم : اللهم اهد قومي فانهم لايعلمون وانصرني عليهم ان يجيبوني الي طاعتك فجاء العباس عمه فانقذه منهم وطردهم عنه قال : الاعمش فبذلك تفتخر بنوالعباس ويقولون : فيهم نزلت @QB@ انك لا تهدي من احببت ولكن الله يهدي من يشاء @QE@  القصص الاية  هوي النبي صلي الله عليه وسلم ابا طالب وشاء الله عباس بن عبد المطلب
 واخرج عبد بن حميد والترمذي وابن جرير وابن المنذر وابن ابي حاتم وابو الشيخ والحاكم وابو نعيم والبيهقي كلاهما في الدلاءل وابن مردويه عن عاءشة قالت : كان النبي صلي الله عليه وسلم يحرس حتي نزلت @QB@ والله يعصمك من الناس @QE@ فاخرج راسه من القبة فقال : ايها الناس انصرفوا فقد عصمني الله
 واخرج الطبراني وابن مردويه عن ابي سعيد الخدري قال : كان العباس عم النبي صلي الله عليه وسلم فيمن يحرسه فلما نزلت @QB@ والله يعصمك من الناس @QE@ ترك رسول الله صلي الله عليه وسلم الحرس
 واخرج ابن مردويه عن جابر بن عبد الله قال كان رسول الله صلي الله عليه وسلم اذا خرج بعث معه ابو طالب من يكلءه حتي نزلت @QB@ والله يعصمك من الناس @QE@ فذهب ليبعث معه فقال : ياعم ان الله قد عصمني لاحاجة لي الي من تبعث
 واخرج الطبراني وابو الشيخ وابو نعيم في الدلاءل وابن مردويه وابن عساكر عن ابن عباس قال كان النبي صلي الله عليه وسلم يحرس وكان يرسل معه عمه ابو طالب كل يوم رجلا من بني هاشم يحرسونه فقال : ياعم ان الله قد عصمني لاحاجة لي الي من تبعث
 واخرج ابو نعيم في الدلاءل عن ابي ذر قال : كان رسول الله صلي الله عليه وسلم لاينام الا ونحن حوله من مخافة الغواءل حتي نزلت اية العصمة @QB@ والله يعصمك من الناس @QE@
 واخرج الطبراني وابن مردويه عن عصمة بن مالك الخطمي قال كنا نحرس رسول الله صلي الله عليه وسلم بالليل حتي نزلت @QB@ والله يعصمك من الناس @QE@ فترك الحرس
 واخرج ابن ابي حاتم عن جابر بن عبد الله قال : لما غزا رسول الله صلي الله عليه وسلم بني انمار نزل ذات الرقاع باعلي نخل فبينا هو جالس علي راس بءر قد دلي رجليه فقال غورث بن الحرث : لاقتلن محمد فقال له اصحابه : كيف تقتله قال : اقول له اعطيني سيفك فاذا اعطانيه قتلته به
 فاتاه فقال : يامحمد اعطني سيفك اشمه  فاعطاه اياه فرعدت يده فقال رسول الله صلي الله عليه وسلم : حال الله بينك وبين ماتريد فانزل الله @QB@ يا ايها الرسول بلغ ما انزل اليك من ربك @QE@ الاية
 واخرج ابن حبان وابن مردويه عن ابي هريرة قال كنا اذا صحبنا رسول الله صلي الله عليه وسلم في سفر تركنا له اعظم دوحة واظلها فينزل تحتها فنزل ذات يوم تحت شجرة وعلق سيفه فيها فجاء رجل فاخذه فقال : يامحمد من يمنعك مني فقال رسول الله صلي الله عليه وسلم : الله ينمعني منك ضع عنك السيف فوضعه فنزلت @QB@ والله يعصمك من الناس @QE@
 واخرج احمدعن جعدة بن خالد بن الصمة الجشمي قال : اتي النبي صلي الله عليه وسلم برجل فقيل : هذا اراد ان يقتلك
 فقال له النبي صلي الله عليه وسلم : الم ترع
 ولو اردت ذلك لم يسلطك الله علي
 واخرج عبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم وابو الشيخ عن قتادة في الاية قال : اخبر الله نبيه صلي الله عليه وسلم انه سيكفيه الناس ويعصمه منهم وامره بالبلاغ وذكر لنا ان نبي الله صلي الله عليه وسلم قيل له : لو احتجت فقال : والله لايدع الله عقبي للناس ما صاحبتهم
 واخرج ابن جرير وابو الشيخ عن سعيد بن جبير قال : لما نزلت @QB@ يا ايها الرسول @QE@ الي قوله @QB@ والله يعصمك من الناس @QE@ قال رسول الله صلي الله عليه وسلم : لا تحرسوني ان ربي قد عصمني
 واخرج ابن جرير وابن مردويه عن عبد الله بن شقيق قال ان رسول الله صلي الله عليه وسلم كان يتعقبه ناس من اصحابه فلما نزلت @QB@ والله يعصمك من الناس @QE@ فخرج فقال : ياايها الناس الحقوا بملاحقكم فان الله قد عصمني من الناس
 واخرج عبد بن حميد وابن جرير وابو الشيخ عن محمد بن كعب القرظي ان رسول الله صلي الله عليه وسلم ما زال يحرس يحارسه اصحابه حتي انزل الله @QB@ والله يعصمك من الناس @QE@ فترك الحرس حين اخبره انه سيعصمه من الناس
 واخرج ابن جرير عن محمد بن كعب القرظي قال كان رسول الله صلي الله عليه وسلم اذا نزل منزلا اختار له اصحابه شجرة ظليلة فيقيل تحتها فاتاه اعرابي فاخترط سيفه ثم قال : من يمنعك مني قال : الله فرعدت يد الاعرابي وسقط السيف منه قال : وضرب براسه الشجرة حتي انتثرت دماغه فانزل الله @QB@ والله يعصمك من الناس @QE@
  واخرج ابن جرير عن ابن جريج قال كان النبي صلي الله عليه وسلم يهاب قريشا فانزل الله @QB@ والله يعصمك من الناس @QE@ فاستلقي ثم قال : من شاء فليخذلني مرتين او ثلاثا
 واخرج عبد بن حميد وابن مردويه عن الربيع بن انس قال كان النبي صلي الله عليه وسلم يحرسه اصحابه حتي نزلت هذه الاية @QB@ يا ايها الرسول بلغ ما انزل اليك @QE@ الاية
 فخرج اليهم فقال : لاتحرسوني فان الله قد عصمني من الناس
 < <
  الماءدة : (    ) قل يا اهل . . . . .
 > > <
 >  قوله تعالي : قل يا اهل الكتاب لستم علي شء حتي تقيموا التوراة والانجيل وما انزل اليكم من ربكم وليزيدن كثيرا منهم ما انزل اليك من ربك طغيانا وكفرا فلا تاس علي القوم الكافرين * ان الذين امنوا والذين هادوا والصابءون والنصاري من امن بالله واليوم الاخر وعمل صالحا فلا خوف عليهم ولا هم يحزنون * لقد اخذنا ميثاق بني اسراءيل وارسلنا اليهم رسلا كلما جاءهم رسول بما لا تهوي انفسهم فريقا كذبوا وفريقا يقتلون
  اخرج ابن اسحاق وابن جرير وابن المنذر وابن ابي حاتم وابو الشيخ عن ابن عباس قال : جاء رافع بن حارثة وسلام بن مشكم ومالك بن الصيف ورافع بن حرملة قالوا : يامحمد الست تزعم انك علي ملة ابراهيم ودينه وتءمن بما عندنا من التوراة وتشهد انها من حق الله فقال النبي صلي الله عليه وسلم بلي ولكنكم احدثتم وجحدتم مافيها مما اخذ عليكم من الميثاق كتمتم منها ما امرتم ان تبينوا للناس فبرءت من احداثكم
 قالوا : فانا ناخذ مما في ايدينا فانا علي الهدي والحق ولا نءمن بك ولا نتبعك فانزل الله فيهم @QB@ قل يا اهل الكتاب لستم علي شء حتي تقيموا التوراة والانجيل @QE@ الي قوله @QB@ القوم الكافرين @QE@
  < <
  الماءدة : (  ) وحسبوا الا تكون . . . . .
 > > <
 >  قوله تعالي : وحسبوا الا تكون فتنة فعموا وصموا ثم تاب الله عليهم ثم عموا وصموا كثير منهم والله بصير بما يعملون
  اخرج ابن جرير عن مجاهد @QB@ وحسبوا الا تكون فتنة @QE@ قال : يهود
 واخرج ابن جرير وابن المنذر وابن ابي حاتم وابو الشيخ عن الحسن في قوله @QB@ وحسبوا الا تكون فتنة @QE@ قال : بلاء
 واخرج عبد بن حميد وابن جرير وابن ابي حاتم وابو الشيخ عن قتادة @QB@ وحسبوا الا تكون فتنة @QE@ قال : حسب القوم ان لا يكون بلاء @QB@ فعموا وصموا @QE@ قال : كلما عرض لهم بلاء ابتلوا به هلكوا فيه
 واخرج ابن جرير وابن ابي حاتم وابو الشيخ عن السدي @QB@ وحسبوا الا تكون فتنة @QE@ قال : حسبوا ان لا يبتلوا فعموا عن الحق
 < <
  الماءدة : (    ) لقد كفر الذين . . . . .
 > > <
 >  قوله تعالي : لقد كفر الذين قالوا ان الله هو المسيح ابن مريم وقال المسيح يا بني اسراءيل اعبدوا الله ربي وربكم انه من يشرك بالله فقد حرم الله عليه الجنة وماواه النار وما للظالمين من انصار * لقد كفر الذين قالوا ان الله ثالث ثلاثة وما من اله الا اله واحد وان لم ينتهوا عما يقولون ليمسن الذين كفروا منهم عذاب اليم * افلا يتوبون الي الله ويستغفرونه والله غفور رحيم * ما المسيح ابن مريم الا رسول قد خلت من قبله الرسل وامه صديقة كانا ياكلان الطعام انظر كيف نبين لهم الايات ثم انظر اني يءفكون * قل اتعبدون من دون الله ما لا يملك لكم ضرا ولا نفعا والله هو السميع العليم 
  اخرج ابن المنذر عن محمد بن كعب قال : لما رفع الله عيسي بن مريم اجتمع من علماء بني اسراءيل ماءة رجل فقال بعضهم : انتم كثير نتخوف الفرقة اخرجوا عشرة فاخرجوا عشرة ثم قالوا : انتم كثير نتخوف الفرقة اخرجوا عشرة فاخرجوا عشرة ثم قالوا : انتم كثير فاخرجوا عشرة فاخرجوا عشرة ثم قالوا : انتم كثير فاخرجوا عشرة حتي بقي عشرة فقالوا : انتم كثير حتي الان فاخرجوا ستة وبقي اربعة فقال بعضهم : ماتقولون في عيسي فقال رجل منهم : اتعلمون انه لايعلم الغيب الا الله قالوا : لا
 فقال الرجل : هو الله كان في الارض ما بدا له ثم صعد الي السماء حين بدا له
