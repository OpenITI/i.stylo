 اخرج سعيد بن منصور والبخاري تعليقا وعبد بن حميد والنساءي وابن ماجة وابن المنذر وابن مردويه والبيهقي في سننه عن عاءشة قالت : الحمد لله الذي وسع سمعه  الاصوات لقد جاءت المجادلة الي النبي صلي الله عليه وسلم تكلمه وانا في ناحية البيت لا اسمع ما تقول فانزل الله @QB@ قد سمع الله قول التي تجادلك في زوجها @QE@ الي اخر الاية
 واخرج ابن ماجة ابن ابي حاتم والحاكم وصححه وابن مردويه والبيهقي عن عاءشة قالت : تبارك الذي وسع سمعه كل شء اني لاسمع كلام خولة بنت ثعلبة ويخفي علي بعضه وهي تشتكي زوجها الي رسول الله صلي الله عليه وسلم وهي تقول : يا رسول الله اكل شبابي ونثرت له بطني حتي اذا كبر سني وانقطع ولدي ظاهر مني اللهم اني اشكو اليك فما برحت حتي نزل جبريل بهءلاء الايات @QB@ قد سمع الله قول التي تجادلك في زوجها @QE@ وهو اوس بن الصامت
 واخرج ابن ابي حاتم والبيهقي في الاسماء والصفات عن ابن زيد قال : لقي عمر بن الخطاب امراة يقال لها خولة وهو يسير مع الناس فاستوقفته فوقف لها ودنا منها واصغي اليها راسه ووضع يديه علي منكبيها حتي قضت حاجتها وانصرفت فقال له رجل يا امير المءمنين : حبست رجال قريش علي هذه العجوز قال : ويحك وتدري من هذه قال : لا قال : هذه امراة سمع الله شكواها من فوق سبع سموات هذه خولة بنت ثعلبة والله لو لم تنصرف عني الي الليل ما انصرفت حتي تقضي حاجتها
 واخرج البخاري في تاريخه وابن مردويه عن ثمامة بن حزن قال : بينما عمر بن الخطاب يسير علي حماره لقيته امراة فقالت : قف يا عمر فوقف فاغلظت له القول فقال رجل : يا امير المءمنين ما رايت كاليوم فقال : وما يمنعني ان استمع اليها وهي التي استمع الله لها انزل فيها ما نزل @QB@ قد سمع الله قول التي تجادلك في زوجها @QE@
 واخرج احمد وابو داود وابن المنذر والطبراني وابن مردويه والبيهقي من طريق يوسف بن عبد الله بن سلام قال : حدثتني خولة بنت ثعلبة قالت : في والله وفي اوس بن الصامت انزل الله صدر سورة المجادلة قالت : كنت عنده وكان شيخا كبيرا قد ساء خلقه فدخل علي يوما فراجعته بشء فغضب فقال : انت علي كظهر امي ثم رجع فجلس في نادي قومه ساعة ثم دخل علي فاذا هو يريدني عن نفسي قلت : كلا والذي نفس خولة بيده لا تصل الي وقد قلت ما قلت حتي يحكم الله ورسوله فينا ثم جءت الي رسول الله صلي الله عليه وسلم فذكرت له ذلك فما  برحت حتي نزل القران فتغشي رسول الله صلي الله عليه وسلم ما كان يتغشاه ثم سري عنه فقال لي : يا خولة قد انزل الله فيك وفي صاحبك ثم قرا علي رسول الله صلي الله عليه وسلم @QB@ قد سمع الله قول التي تجادلك في زوجها @QE@ الي قوله : @QB@ عذاب اليم @QE@ فقال لي رسول الله صلي الله عليه وسلم : مريه فليعتق رقبة قلت يا رسول الله : ما عنده ما يعتق قال : فليصم شهرين متتابعين قلت : والله انه لشيخ كبير ما به من صيام قال : فليطعم ستين مسكينا وسقا من تمر قلت : والله ما ذاك عنده قال رسول الله صلي الله عليه وسلم : فانا سنعينه بعرق من تمر قلت : وانا يا رسول الله ساعينه بعرق اخر قال : فقد اصبت واحسنت فاذهبي فتصدقي به عنه ثم استوصي بابن عمك خيرا
 قالت : ففعلت
 واخرج سعيد بن منصور وابن مردويه والبيهقي عن عطاء بن يسار ان اوس بن الصامت ظاهر من امراته خولة بنت ثعلبة فجاءت الي رسول الله صلي الله عليه وسلم فاخبرته وكان اوس به لمم فنزل القران @QB@ والذين يظاهرون من نساءهم ثم يعودون لما قالوا فتحرير رقبة من قبل ان يتماسا @QE@ فقال لامراته : مريه فليعتق رقبة فقالت يا رسول الله : والذي اعطاك ما اعطاك ما جءت الا رحمة له ان له في منافع والله ما عنده رقبة ولا يملكها قالت : فنزل القران وهي عنده في البيت قال : مريه فليصم شهرين متتابعين فقالت : والذي اعطاك ما اعطاك ما قدر عليه فقال : مريه فليتصدق علي ستين مسكينا فقالت : يا رسول الله ما عنده ما يتصدق به فقال : يذهب الي فلان الانصاري فان عنده شطر وسق تمر اخبرني انه يريد ان يتصدق به فلياخذ منه ثم ليتصدق علي ستين مسكينا
 واخرج عبد بن حميد وابن المنذر وابن مردويه والحاكم وصححه والبيهقي في السنن عن عاءشة ان خولة كانت امراة اوس بن الصامت وكان امرا به لمم فاذا اشتد لممه ظاهر من امراته فانزل الله فيه كفارة الظهار
 واخرج النحاس وابن مردويه والبيهقي من طريق عكرمة عن ابن عابس قال : كان الرجل في الجاهلية لو قال لامراته : انت علي كظهر امي حرمت عليه وكان اول من ظاهر في الاسلام اوس بن الصامت وكانت تحته ابنة عم له يقال لها خولة فظاهر منها فاسقط في يده وقال : ما اراك الا قد حرمت علي فانطلقي الي النبي صلي الله عليه وسلم فاساليه فاتت النبي صلي الله عليه وسلم فوجدت عنده ماشطة تمشط راسه فاخبرته فقال : يا خولة ما امرنا في امرك بشء فانزل الله علي النبي صلي الله عليه وسلم فقال : يا خولة  ابشري قالت : خيرا قال : خيرا فانزل الله علي النبي صلي الله عليه وسلم فقرا عليها @QB@ قد سمع الله قول التي تجادلك في زوجها @QE@ الايات
 واخرج ابن مردويه عن ابن عباس ان خولة او خويلة اتت النبي صلي الله عليه وسلم فقالت : يا رسول الله ان زوجي ظاهر مني فقال لها النبي صلي الله عليه وسلم : ما اراك الا قد حرمت عليه فقالت اشكو الي الله فاقتي فانزل الله @QB@ قد سمع الله قول التي تجادلك في زوجها وتشتكي الي الله @QE@
 واخرج ابن مردويه عن ابن عباس قال في القران [ ] ما انزل الله جملة واحدة @QB@ قد سمع الله قول التي تجادلك في زوجها وتشتكي الي الله @QE@ كان هذا قبل ان تخلق خولة لو ان خولة ارادت ان لا تجادل لم يكن ذلك لان الله كان قد قدر ذلك عليها قبل ان يخلقها
 واخرج ابن مردويه عن ابن عباس في قوله : @QB@ قد سمع الله قول التي تجادلك في زوجها @QE@ وذلك ان خولة امراة من الانصار ظاهر منها زوجها فقال : انت علي كظهر امي فاتت رسول الله صلي الله عليه وسلم فقالت : ان زوجي كان تزوجني وانا احب الناس اليه حتي اذا كبرت ودخلت في السن قال : انت علي كظهر امي وتركني الي غير احد فان كنت تجد لي رخصة يا رسول الله تنعشني واياه بها فحدثني بها قال : والله ما امرت في شانك بشء حتي الان ولكن ارجعي الي بيتك فان اومر بشء لا اعميه عليك ان شاء الله فرجعت الي بيتها فانزل الله علي رسوله صلي الله عليه وسلم في الكتاب رخصتها ورخصة زوجها فقال : @QB@ قد سمع الله قول التي تجادلك في زوجها @QE@ الي قوله : @QB@ عذاب اليم @QE@ فارسل الي زوجها فقال : هل تستطيع ان تعتق رقبة قال : اذن يذهب مالي كله الرقبة غالية وانا قليل المال قال : هل تستطيع ان تصوم شهرين متتابعين قال : والله لولا اني اكل كل يوم ثلاث مرات لكل بصري قال : هل تستطيع ان تطعم ستين مسكينا قال : لا والله الا ان تعينني قال : اني معينك بخمسة عشر صاعا
 واخرج ابن مردويه عن انس رضي الله عنه ان اوس بن الصامت ظاهر من امراته خولة بنت ثعلبة فشكت ذلك الي رسول الله صلي الله عليه وسلم فقالت : ظاهر مني زوجي حين كبر سني ودق عظمي فانزل الله اية الظهار فقال رسول الله صلي الله عليه وسلم : اعتق رقبة قال : مالي بذلك يدان فصم شهرين متتابعين قال : اني اذا اخطاني ان اكل في  اليوم ثلاث مرات يكل بصري فاطعم ستين مسكينا قال : ما اجد الا ان تعينني فدعا رسول الله صلي الله عليه وسلم خمسة عشر صاعا حتي جمع الله له اهله
 واخرج ابن مردويه عن الشعبي قال : المراة التي جادلت في زوجها خولة بنت ثعلبة وامها معاذة التي انزل الله فيها ( ولا تكرهوا فيتاتكم علي البغاء ) ( سورة النور الاية  ) وكانت امة لعبد الله بن ابي
 واخرج عبد بن حميد وابن مردويه عن محمد بن سيرين قال : ان اول من ظاهر في الاسلام زوج خويلة فاتت النبي صلي الله عليه وسلم فقالت : ان زوجي ظاهر مني وجعلت تشكو الي الله فقال لها النبي صلي الله عليه وسلم : ما جاءني في هذا شء قالت : فالي من يا رسول الله ان زوجي ظاهر مني فبينما هي كذلك اذ نزل الوحي @QB@ قد سمع الله قول التي تجادلك في زوجها @QE@ حتي بلغ @QB@ فتحرير رقبة من قبل ان يتماسا @QE@ ثم حبس الوحي فانصرف اليها رسول الله صلي الله عليه وسلم فتلاها عليها فقال النبي صلي الله عليه وسلم : هو ذاك فبينما هي كذلك اذا نزل الوحي @QB@ فمن لم يجد فصيام شهرين متتابعين من قبل ان يتماسا @QE@ ثم حبس الوحي فانصرف اليها رسول الله صلي الله عليه وسلم فتلاها عليها فقالت : لا يستطيع ان يصوم يوما واحدا قال : هو ذاك فبينما هي كذلك اذ نزل الوحي @QB@ فمن لم يستطع فاطعام ستين مسكينا @QE@ فانصرف اليها رسول الله صلي الله عليه وسلم فتلاها عليها فقالت : لا يجد يا رسول الله قال : انا سنعينه
 واخرج عبد بن حميد عن عطاء الخراساني قال : اعانه النبي صلي الله عليه وسلم بخمسة عشر صاعا
 واخرج عبد بن حميد عن ابي زيد المدني رضي الله عنه ان امراة جاءت بشطر وسق من شعير فاعطاه النبي صلي الله عليه وسلم اي مدين من شعير مكان مد من بر
 واخرج عبد بن حميد عن عبد الرحمن بن ابي ليلي ان النبي صلي الله عليه وسلم اعانه بخمسة عشر صاعا من شعير
 واخرج عبد بن حميد عن الحسن رضي الله عنه ان رجلا ظاهر من امراته علي عهد النبي صلي الله عليه وسلم وكان الظهار اشد من الطلاق واحرم الحرام اذا ظاهر من امراته لم ترجع اليه ابدا فاتت النبي صلي الله عليه وسلم فقالت : يانبي الله ان زوجي وابا ولدي  ظاهر مني وما يطلع الا الله علي ما يدخل علي من فراقه فقال لها النبي صلي الله عليه وسلم : قد قال ما قال : قالت : فكيف اصنع ودعت الله واشتكت اليه فانزل الله @QB@ قد سمع الله قول التي تجادلك في زوجها وتشتكي الي الله @QE@ الي اخر الايات فدعا رسول الله صلي الله عليه وسلم زوجها فقال : تعتق رقبة : قال : ما في الارض رقبة املكها قال : تستطيع ان تصوم شهرين متتابعين قال يا رسول الله : اني بلغت سنا وبي دوران فاذا لم اكل في اليوم مرارا ادير علي حتي اقع قال : تستطيع ان تطعم ستين مسكينا قال : والله ما اجد فقال رسول الله صلي الله عليه وسلم : سنعينك
 واخرج عبد بن حميد عن عكرمة رضي الله عنه ان امراة اخي عبادة بن الصامت جاءت الي رسول الله صلي الله عليه وسلم تشكو زوجها تظاهر عنها وامراة تفلي راس رسول الله صلي الله عليه وسلم او قال : تدهنه فرفع رسول الله صلي الله عليه وسلم نظره الي السماء فقالت التي تفلي لامراة اخي عبادة بن الصامت رضي الله عنه واسمها خولة بنت ثعلبة يا خولة الا تسكتي فقد ترينه ينظر الي السماء فانزل الله فيها @QB@ قد سمع الله قول التي تجادلك في زوجها @QE@ فعرض عليه رسول الله صلي الله عليه وسلم عتق رقبة فقال : لا اجد فعرض عليه صيام شهرين متتابعين فقال : لا اطيق ان لم اكل كل يوم ثلاث مرات شق بي فقال له النبي صلي الله عليه وسلم فاطعم ستين مسكينا قال : لا اجد فاتي النبي صلي الله عليه وسلم بشء من تمر فقال له : خذ هذا فاقسمه فقال الرجل : ما بين لابتيها افقر مني فقال له النبي صلي الله عليه وسلم : كله انت واهلك
 واخرح عبد بن حميد عن يزيد بن زيد الهمداني في قوله : @QB@ قد سمع الله قول التي تجادلك في زوجها @QE@ قال : هي خولة بنت الصامت وكان زوجها مريضا فدعاها فلم تجبه وابطات عليه فقال : انت علي كظهر امي فاتت النبي صلي الله عليه وسلم فنزلت هذه الاية @QB@ فتحرير رقبة @QE@ فقال له النبي صلي الله عليه وسلم : اعتق رقبة قال : لا اجد قال : فصم شهرين متتابعين قال : لا استطيع قال : فاطعم ستين مسكينا قال : لا والله ما عندي الا ان تعينني فاعانه النبي صلي الله عليه وسلم بخمسة عشر صاعا فقال : والله ما في المدينة احوج اليها مني فقال النبي صلي الله عليه وسلم : فكلها انت واهلك
 واخرج ابن سعد عن عمران بن انس قال : كان اول من ظاهر في الاسلام اوس بن الصامت وكان به لمم وكان يفيق احيانا فلاح امراته خولة بنت ثعلبة في بعض صحواته فقال : انت علي كظهر امي ثم ندم فقال : ما اراك الا قد  حرمت علي قالت : ما ذكرت طلاقا فاتت النبي صلي الله عليه وسلم فاخبرته بما قال قال : وجادلت رسول الله صلي الله عليه وسلم مرارا ثم قالت : اللهم اني اشكو اليك شدة وحدتي وما يشق علي من فراقه قالت عاءشة : فلقد بكيت وبكي من كان في البيت رحمة لها ورقة عليها ونزل علي رسول الله صلي الله عليه وسلم الوحي فسري عنه وهو يبتسم فقال : يا خولة قد انزل الله فيك وفيه @QB@ قد سمع الله قول التي تجادلك في زوجها @QE@ ثم قال : مريه ان يعتق رقبة قالت : لا يجد قال : فمريه ان يصوم شهرين متتابعين قالت : لا يطيق ذلك قال : فمريه فليطعم ستين مسكينا قالت : واني له فمريه فليات ام المنذر بنت قيس فلياخذ منها شطر وسق تمر فليتصدق به علي ستين مسكينا فرجعت الي اوس فقال : ما وراءك قالت : خير وانت ذميم ثم اخبرته فاتي ام المنذر فاخذ ذلك منها فجعل يطعم مدين من تمر كل مسكين واخرج عبد بن حميد عن ابي قلابة قال : انما كان طلاقهم في الجاهلية الظهار والايلاء حتي قال ما سمعت
 واخرج عبد الرزاق وعبد بن حميد وابن المنذر عن قتادة في قوله : @QB@ وانهم ليقولون منكرا من القول وزورا @QE@ قال : الزور الكذب
 واخرج ابن المنذر والبيهقي في سننه عن ابن عباس في قوله : @QB@ والذين يظاهرون من نساءهم ثم يعودون لما قالوا @QE@ قال : هو الرجل يقول لامراته : انت علي كظهر امي فاذا قال ذلك : فليس له ان يقربها بنكاح ولاغيره حتي يكفر بعتق رقبة فان لم يجد فصيام شهرين متتابعين من قبل ان يتماسا والمس النكاح فان لم يستطع فاطعام ستين مسكيناوان هو قال لها : انت علي كظهر اميفاذا قال : ان فعلت كذا فليس يقع في ذلك ظهار حتي يحنث فلا يقربها حتي يكفر ولا يقع في الظهار طلاق
 واخرج عبد الرزاق وابن المنذر عن قتادة رضي الله عنه @QB@ ثم يعودون لما قالوا @QE@ قال : يعود لمسها
 واخرج عبد الرزاق وعبد بن حميد وابن المنذر عن طاووس @QB@ ثم يعودون لما قالوا @QE@ قال : الوطء
 واخرج ابن المنذر عن طاووس قال : اذا اكلم الرجل بالظهار المنكر والزور فقد وجبت عليه الكفارة حنث او لم يحنث
  واخرج عبد الرزاق عن طاووس قال : كان طلاق اهل الجاهلية الظهار فظاهر رجل في الاسلام وهو يريد الطلاق فانزل الله فيه الكفارة
 واخرج عبد الرزاق وعبد بن حميد عن عطاء انه سءل عن هذه الاية من قبل ان يتماسا قال : هو الجماع
 واخرج عبد بن حميد عن مجاهد @QB@ فاطعام ستين مسكينا @QE@ قال : كهيءة الطعام في اليمين مدين لكل مسكين
 واخرج ابن المنذر عن ابي هريرة قال : ثلاث فيهن مد كفارة اليمين وكفارة الظهار وكفارة الصيام
 واخرج ابن مردويه عن ابي هريرة ان النبي صلي الله عليه وسلم امر الذي اتي اهله في رمضان بكفارة الظهار
 واخرج عبد الرزاق عن عطاء والزهري وقتادة قالوا : العتق في الظهار والصيام والطعام كل ذلك من قبل ان يتماسا
 واخرج الطبراني عن ابن عباس قال : كان الظهار في الجاهلية يحرم النساء فكان اول من ظاهر في الاسلام اوس بن الصامت وكانت امراته خولة بنت خويلد وكان الرجل ضعيفا وكانت المراة جلدة فلما تكلم بالظهار قال : لا اراك الا قد حرمت علي فانطلقي الي رسول الله صلي الله عليه وسلم لعلك تبتغي شيءا يردك علي فانطلقت وجلس ينتظرها فاتت النبي صلي الله عليه وسلم وماشطة تمشط راسه فقالت : يا رسول الله ان اوس بن الصامت من قد علمت من ضعف رايه وعجز مقدرته وقد ظاهر مني فابتغ لي يا رسول الله شيءا اليه يا خويلة : ما امرنا بشء في امرك وان نءمر فساخبرك فبينا ماشطته قد فزعت من شق راسه واخذت في الشق الاخر انزل الله عز وجل وكان اذا انزل عليه الوحي تربد لذلك وجهه حتي يجد بردة فاذا سري عنه عاد وجهه ابيض كالقلب ثم تكلم بما امر به فقالت ما شطته : يا خويلة اني لاظنه الان في شانك فاخذها افكل ( هكذا في الاصل ولعلها افك ) ثم قالت : اللهم بك اعوذ ان تنزل في الا خيرا فاني لم ابغ من رسولك الا خيرا فلما سري عنه قال : يا خويلة قد انزل الله فيك وفي صاحبك فقرا @QB@ قد سمع الله قول التي تجادلك في زوجها وتشتكي الي الله @QE@ الي قوله : @QB@ فتحرير رقبة من قبل ان يتماسا @QE@ فقالت : والله يا رسول الله ماله خادم غيري ولا لي خادم غيره قال : @QB@ فمن لم يجد فصيام شهرين متتابعين @QE@ قالت : والله انه اذا لم  ياكل في اليوم مرتين يسدر بصره قال : @QB@ فمن لم يستطع فاطعام ستين مسكينا @QE@ قالت : والله ما لنا في اليوم الا وقية قال : فمريه فليطلق الي فلان فلياخذ منه شطر وسق من تمر فليتصدق به علي ستين مسكينا وليراجعك
 واخرج عبد الرزاق في المصنف من طريق ابي سلمة بن عبد الرحمن عن سلمة بن صخر الانصاري انه جعل امراته عليه كظهر امه حتي يمضي رمضان فسمنت وتربصت فوقع عليها في النصف من رمضان فاتي النبي صلي الله عليه وسلم كانه يعظم ذلك فقال له النبي صلي الله عليه وسلم : اتستطيع ان تعتق رقبة فقال : لا قال : افتستطيع ان تصوم شهرين متتابعين قال : لا قال : افتستطيع ان تطعم ستين مسكينا قال : لا فقال النبي صلي الله عليه وسلم : يا فروة بن عمرو اعطه ذلك العرق وهو مكتل ياخذ خمسة عشر او ستة عشر صاعا فليطعمه ستين مسكينا فقال : اعلي افقر مني فوالذي بعثك بالحق ما بين لا بتيها اهل بيت احوج اليه منا فضحك رسول الله صلي الله عليه وسلم ثم قال : اذهب به الي اهلك
 واخرج عبد بن حميد وابن مردويه والبيهقي في السنن عن ابي العالية قال : كانت خولة بنت ودبيج تحت رجل من الانصار وكان سيء الخلق ضرير البصر فقيرا وكانت الجاهلية اذا اراد الرجل ان يفارق امراته قال : انت علي كظهر امي فادارعته بعض الشء فقال : انت علي كظهر امي وكان له عيل او عيلان فلما سمعته يقول ما قال احتملت صبيانها فانطلقت تسعي الي رسول الله صلي الله عليه وسلم فوافقته عند عاءشة واذا عاءشة تغسل شق راس رسول الله صلي الله عليه وسلم فقامت عليه ثم قالت : يا رسول الله ان زوجي فقير ضرير البصر سيء الخلق واني نازعته في شء فقال : انت علي كظهر امي ولم يرد الطلاق فرفع النبي صلي الله عليه وسلم راسه فقال : ما اعلم الا قد حرمت عليه فاستكانت وقالت : اشتكي الي الله ما نزل بي ومصيبتي وتحولت عاءشة تغسل شق راسه الاخر فتحولت معها فقالت : مثل ذلك قالت : ولي منه عيل او عيلان فرفع النبي راسه اليها فقال : ما اعلم الا قد حرمت عليه فبكت وقالت : اشتكي الي رسول الله صلي الله عليه وسلم مصيبتي وتغير وجه رسول الله صلي الله عليه وسلم فقالت عاءشة : وراءك فتنحت ومكث رسول الله صلي الله عليه وسلم ما شاء الله ثم انقطع الوحي فقال يا عاءشة : اين المراة قالت : هاهي قال : ادعيها فدعتها فقال النبي صلي الله عليه وسلم : اذهبي فجيءي بزوجك فانطلقت تسعي فلم تلبث ان جاءت  فادخلته علي النبي صلي الله عليه وسلم فاذا هو كما قالت : ضرير فقير سيء الخلق فقال النبي صلي الله عليه وسلم : استعيذ بالسميع العليم من الشيطان الرجيم @QB@ قد سمع الله قول التي تجادلك في زوجها وتشتكي @QE@ الي اخر الاية فقال له النبي صلي الله عليه وسلم : اتجد رقبة قال : لا قال : افتستطيع صوم شهرين متتابعين قال : والذي بعثك بالحق اني اذا لم اكل المرة والمرتين والثلاثة يكاد يغشي علي قال : افتستطيع ان تطعم ستين مسكينا قال : لا الا ان تعينني فيها فاعانه رسول الله صلي الله عليه وسلم فكفر يمينه
 واخرج البزار والحاكم والطبراني وابن مردويه والبيهقي عن ابن عباس قال : اتي رجل النبي صلي الله عليه وسلم فقال : اني ظاهرت من امراتي فرايت بياض خلخالها في ضوء القمر فاعجبتني فوقعت عليها قبل ان اكفر فقال النبي صلي الله عليه وسلم : الم يقل الله @QB@ من قبل ان يتماسا @QE@ قال : قد فعلت يا رسول الله قال : امسك حتي تكفر
 واخرج عبد الرزاق وابو داود والترمذي والنساءي وابن ماجة والحاكم والبيهقي من طريق عكرمة عن ابن عباس ان رجلا قال : يا رسول الله اني ظاهرت من امراتي فوقعت عليها قبل ان اكفر قال : وما حملك علي ذلك قال : ضوء خلخالها في ضوء القمر قال : فلا تقربها حتي تفعل ما امرك الله
 واخرج عبد الرزاق وعبد بن حميد واحمد وابو داود والترمذي وحسنه وابن ماجة والطبراني والبغوي في معجمه والحاكم وصححه والبيهقي عن سلمة بن صخر الانصاري قال : كنت رجلا قد اوتيت من جماع النساء ما لم يءت غيري فلما دخل رمضان ظاهرت من امراتي حتي ينسلخ رمضان فرقا من ان اصيب منها في ليلي فاتتابع في ذلك ولا استطيع ان انزع حتي يدركني الصبح فبينما هي تخدمني ذات ليلة اذ انكشف لي منها شء فوثبت عليها فلما اصبحت غدوت علي قومي فاخبرتهم خبري فقلت : انطلقوا معي الي رسول الله صلي الله عليه وسلم فاخبره بامري فقالوا : لا والله لا نفعل نتخوف ان ينزل فينا القران او يقول فينا رسول الله صلي الله عليه وسلم مقالة يبقي علينا عارها ولكن اذهب انت فاصنع ما بدا لك فخرجت فاتيت رسول الله صلي الله عليه وسلم فاخبرته خبري فقال : انت بذاك قلت : انا بذاك قال : انت بذاك قلت : انا بذاك قال : انت بذاك قلت : انا بذاك وها انا ذا فامض في حكم الله فاني صابر لذلك قال : اعتق رقبة فضربت صفحة عنقي بيدي قلت : لا والذي بعثك بالحق ما اصبحت املك غيرها فصم شهرين متتابعين قلت : وهل اصابني ما  اصابني الا في الصيام قال : فاطعم ستين مسكينا قلت : والذي بعثك بالحق لقد بتنا ليلتنا هذه وبني ما لنا عشاء قال : اذهب الي صاحب صدقة بني زريق فقل له فليدفعها اليك فاطعم عنك منها وسقا ستين مسكينا ثم استعن بساءرها عليك وعلي عيالك فرجعت الي قومي فقلت : وجدت عندكم الضيق وسوء الراي ووجدت عند رسول الله صلي الله عليه وسلم السعة والبركة امر لي بصدقتكم فدفعوها اليه
