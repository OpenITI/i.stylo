  اخرج ابن المنذر وابن ابي حاتم وابو الشيخ عن عكرمة قال : دخلت علي ابن عباس وهو يقرا هذه الاية @QB@ واسالهم عن القرية التي كانت حاضرة البحر @QE@ قال : يا عكرمة هل تدري اي قرية هذه قلت : لا
 قال : هي ايلة
 واخرج ابن ابي حاتم عن ابن شهاب @QB@ واسالهم عن القرية @QE@ هي طبرية
 واخرج ابن ابي حاتم عن ابن زيد @QB@ واسالهم عن القرية @QE@ قال : هي قرية يقال لها مقنا بين مدين وعينونا
 واخرج عبد بن حميد عن سعيد بن جبير @QB@ واسالهم عن القرية @QE@ هي مدين
 واخرج ابن جرير عن ابن عباس في قوله @QB@ اذ يعدون في السبت @QE@ قال : يظلمون
 واخرج ابن جرير عن ابن عباس في قوله @QB@ شرعا @QE@ يقول : من كل مكان
 واخرج ابن جرير عن ابن عباس في قوله @QB@ شرعا @QE@ قال : ظاهرة علي الماء
 واخرج ابن المنذر عن ابن عباس في قوله @QB@ شرعا @QE@ قال : واردة
 واخرج ابن جرير وابن المنذر وابن ابي حاتم عن ابن عباس في قوله @QB@ واسالهم عن القرية التي كانت حاضرة البحر @QE@ قال : هي قرية علي شاطء البحر بين مصر  والمدينة يقال لها ايلة فحرم الله عليهم الحيتان يوم سبتهم فكانت تاتيهم يوم سبتهم شرعا في ساحل البحر فاذا مضي يوم السبت لم يقدروا عليها فمكثوا كذلك ما شاء الله ثم ان طاءفة منهم اخذوا الحيتان يوم سبتهم فنهتهم طاءفة فلم يزدادوا الا غيا
 فقالت طاءفة من النهاة : تعلمون ان هءلاء قوم قد حق عليهم العذاب @QB@ لم تعظون قوما الله مهلكهم @QE@ وكانوا اشد غضبا من الطاءفة الاخري وكل قد كانوا ينهون فلما وقع عليهم غضب الله نجت الطاءفتان اللتان قالتا : لم تعظون والذين @QB@ قالوا معذرة الي ربكم @QE@ واهلك الله اهل معصيته الذين اخذوا الحيتان فجعلهم قردة
 واخرج ابن جرير وابن ابي حاتم وابو الشيخ عن ابن عباس في قوله @QB@ واسالهم عن القرية @QE@ الاية
 قال : ان الله انما افترض علي بني اسراءيل اليوم الذي افترض عليكم يوم الجمعة فخالفوا الي يوم السبت فعظموه وتركوا ما امروا به فلما ابتدعوا السبت ابتلوا فيه فحرمت عليهم الحيتان وهي قرية يقال لها مدين ايلة والطور فكانوا اذا كان يوم السبت شرعت لهم الحيتان ينظرون اليها في البحر فاذا انقضي السبت ذهبت فلم تر حتي مثله من السبت المقبل فاذا جاء السبت عادت شرعا ثم ان رجلا منهم اخذ حوتا فحزمه بخيط ثم ضرب له وتدا في الساحل وربطه وتركه في الماء فلما كان الغد جاء فاخذه فاكله سرا ففعلوا ذلك وهم ينظرون ولا يتناهون الا بقية منهم فنهوهم حتي اذا ظهر ذلك في الاسواق علانية قالت طاءفة للذين ينهونهم @QB@ لم تعظون قوما الله مهلكهم او معذبهم عذابا شديدا @QE@ قالوا @QB@ معذرة الي ربكم @QE@ في سخطنا اعمالهم @QB@ ولعلهم يتقون @QE@ فكانوا اثلاثا
 ثلثا نهي وثلثا قالوا @QB@ لم تعظون @QE@ وثلثا اصحاب الخطيءة فما نجا الا الذين نهوا وهلك ساءرهم فاصبح الذين نهوا ذات غداة في مجالسهم يتفقدون الناس لا يرونهم وقد باتوا من ليلتهم وغلقوا عليهم دورهم فجعلوا يقولون : ان للناس شانا فانظروا ما شانهم فاطلعوا في دورهم فاذا القوم قد مسخوا يعرفون الرجل بعينه وانه لقرد والمراة بعينها وانها لقردة
 واخرج عبد الرزاق وابن جرير وابن ابي حاتم والبيهقي في سننه عن عكرمة قال : جءت ابن عباس يوما وهو يبكي واذا المصحف في حجره فقلت : ما يبكيك يا ابن عباس فقال : هءلاء الورقات
 واذا في سورة الاعراف قال : تعرف ايلة قلت : نعم
 قال : فانه كان بها حي من يهود سيقت الحيتان اليهم يوم السبت  ثم غاصت لا يقدرون عليها حتي يغوصوا عليها بعد كد ومءنة شديدة وكانت تاتيهم يوم السبت شرعا بيضا سمانا كانها الماخض فكانوا كذلك برهة من الدهر ثم ان الشيطان اوحي اليهم فقال : انما نهيتم عن اكلها يوم السبت فخذوها فيه وكلوها في غيره من الايام
 فقالت : ذلك طاءفة منهم وقالت طاءفة : بل نهيتم عن اكلها واخذها وصيدها في يوم السبت فعدت طاءفة بانفسها وابناءها ونساءها واعتزلت طاءفة ذات اليمين وتنحت واعتزلت طاءفة ذات اليسار وسكتت وقال الايمنون : ويلكم

 لا تتعرضوا لعقوبة الله وقال الايسرون @QB@ لم تعظون قوما الله مهلكهم او معذبهم عذابا شديدا @QE@ قال الايمنون : @QB@ معذرة الي ربكم ولعلهم يتقون @QE@ ان ينتهوا فهو احب الينا ان لا يصابوا ولا يهلكوا وان لم ينتهوا فمعذرة الي ربكم
 فمضوا علي الخطيءة وقال الايمنون : قد فعلتم يا اعداء الله والله لنبايننكم الليلة في مدينتكم والله ما اراكم تصبحون حتي يصبحكم الله بخسف او قذف او بعض ما عنده من العذاب فلما اصبحوا ضربوا عليهم الباب ونادوا فلم يجابوا فوضعوا سلما وعلوا سور المدينة رجلا فالتفت اليهم فقال : اي عباد الله قردة  والله  تعاوي لها اذناب

 ففتحوا فدخلوا عليهم فعرفت القردة انسابها من الانس ولا تعرف الانس انسابها من القردة فجعلت القرود تاتي نسيبها من الانس فتشم ثيابه وتبكي فيقول : الم ننهكم فتقول براسها : اي نعم
 ثم قرا ابن عباس @QB@ فلما نسوا ما ذكروا به انجينا الذين ينهون عن السوء واخذنا الذين ظلموا بعذاب بءيس @QE@ قال : اليم وجيع
 قال : فاري الذين نهوا قد نجوا ولا اري الاخرين ذكروا ونحن نري اشياء ننكرها ولا نقول فيها
 قلت : اي جعلني الله فداك الا تري انهم كرهوا ما هم عليه وخالفوهم وقالوا @QB@ لم تعظون قوما الله مهلكهم @QE@ قال : فامر بي فكسيت ثوبين غليظين
 واخرج عبد بن حميد عن عكرمة قال : كانت قرية علي ساحل البحر يقال لها ايلة وكان علي ساحل البحر صنمان من حجارة مستقبلان الماء يقال لاحدهما لقيم والاخر لقمانة فاوحي الله الي السمك : ان حج يوم السبت الي الصنمين واوحي الي اهل القرية : اني قد امرت السمك ان يحجوا الي الصنمين يوم السبت فلا تعرضوا للسمك يوم لا يمتنع منكم فاذا ذهب السبت فشانكم به فصيدوه فكان اذا طلع الفجر يوم السبت اقبل السمك شرعا الي الصنمين لا يمتنع من اخذ ياخذه فظهر  يوم السبت شء من السمك في القرية فقالوا : ناخذه يوم السبت فناكله يوم الاحد فلما كان يوم السبت الاخر ظهر اكثر من ذلك فلما كان السبت الاخر ظهر السمك في القرية فقام اليهم قوم منهم فوعظوهم فقالوا : اتقوا الله
 فقام اخرون فقالوا @QB@ لم تعظون قوما الله مهلكهم او معذبهم عذابا شديدا قالوا معذرة الي ربكم ولعلهم يتقون @QE@ فلما كان سبت من تلك الاسبات فشي السمك في القرية فقام الذين نهوا عن السوء فقالوا : لا نبيت معكم الليلة في هذه القرية
 فقيل لهم : لو اصبحتم فانقلبتم بذراريكم ونساءكم
 قالوا : لا نبيت معكم الليلة في هذه القرية فان اصبحنا غدونا فاخرجنا ذرارينا وامتعتنا من بين ظهرانيكم وكان القوم شاتين فلما امسوا اغلقوا ابوابهم فلما اصبحوا لم يسمع القوم لهم صوتا ولم يروا سرجا خرج من القرية

 قالوا : قد اصاب اهل القرية شر

 فبعثوا رجلا منهم ينظر اليهم فلما اتي القرية اذا الابواب مغلقة عليهم فاطلع في دار فاذا هم قرود كلهم المراة انثي والرجل ذكر ثم اطلع في دار اخري فاذا هم كذلك الصغير صغير والكبير كبير ورجع الي القوم فقال : يا قوم نزل باهل القرية ما كنتم تحذرون اصبحوا قردة كلهم لا يستطيعون ان يفتحوا الابواب فدخلوا عليهم فاذا هم قردة كلهم فجعل الرجل يومء الي القرد منهم انت فلان فيومء براسه : نعم
 وهم يبكون فقالوا : ابعدكم الله قد حذرناكم هذا ففتحوا لهم الابواب فخرجوا فلحقوا بالبرية
 واخرج عبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم وابو الشيخ عن ابن عباس قال : نجا الناهون وهلك الفاعلون ولا ادري ما صنع بالساكتين
 واخرج عبد بن حميد وابو الشيخ عن ابن عباس قال : والله لءن اكون علمت ان القوم الذين قالوا @QB@ لم تعظون قوما @QE@ نجوا مع الذين نهوا عن السوء احب الي ما عدل به
 وفي لفظ : من حمر النعم
 ولكني اخاف ان تكون العقوبة نزلت بهم جميعا
 واخرج عبد بن حميد وابن جرير وابن المنذر عن عكرمة قال : قال ابن عباس : ما ادري انجا الذين قالوا لم تعظون قوما ام لا قال : فما زلت ابصره حتي عرف انهم قد نجوا فكساني حلة
 واخرج عبد بن حميد عن ليث بن ابي سليم قال : مسخوا حجارة الذين قالوا @QB@ لم تعظون قوما الله مهلكهم @QE@
  واخرج ابن ابي شيبة وعبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم وابو الشيخ عن الحسن في قوله @QB@ واسالهم عن القرية @QE@ الاية
 قال : كان حوتا حرمه الله عليهم في يوم واحله لهم فيما سوي ذلك فكان ياتيهم في اليوم الذي حرمه الله عليهم كانه المخاض ما يمتنع من احد فجعلوا يهمون ويمسكون وقلما رايت احدا اكثر الاهتمام بالذنب الا واقعه فجعلوا يهمون ويمسكون حتي اخذوه فاكلو بها  والله  اوخم اكلة اكلها قوم قط ابقاه خزيا في الدنيا واشده عقوبة في الاخرة وايم الله للمءمن اعظم حرمة عند الله من حوت ولكن الله عز وجل جعل موعد قوم الساعة والساعة ادهي وامر
 واخرج ابن ابي شيبة وابن المنذر عن ابن عباس قال : اخذ موسي عليه السلام رجلا يحمل حطبا يوم السبت وكان موسي يسبت فصلبه
 واخرج ابو الشيخ عن ابن عباس قال : احتطب رجل في السبت وكان داود عليه السلام يسبت فصلبه
 واخرج عبد بن حميد عن ابي بكر بن عياش قال : كان حفظي عن عاصم ( بعذاب بءيس ) علي معني فعيل ثم دخلني منها شك فتركت روايتها عن عاصم واخذتها عن الاعمش ( بعذاب بءيس ) علي معني فعيل
 واخرج ابو الشيخ عن ابن عباس في قوله @QB@ بعذاب بءيس @QE@ قال : لا رحمة فيه
 واخرج عبد الرزاق وعبد بن حميد وابن جرير عن قتادة @QB@ بعذاب بءيس @QE@ قال : وجيع
 واخرج عبد بن حميد وابن ابي حاتم عن مجاهد في قوله @QB@ بعذاب بءيس @QE@ قال : اليم بشدة
 واخرج ابن ابي حاتم عن عطاء قال : نودي الذين اعتدوا في السبت ثلاثة اصوات نودوا يا اهل القرية فانتبهت طاءفة ثم نودوا يا اهل القرية فانتبهت طاءفة اكثر من الاولي ثم نودوا يا اهل القرية فانتبه الرجال والنساء والصبيان فقال الله لهم @QB@ كونوا قردة خاسءين @QE@ البقرة اية  فجعل الذين نهوهم يدخلون عليهم فيقولون : يا فلان الم ننهكم فيقولون برءوسهم : اي بلي
  واخرج عبد بن حميد عن سعيد بن جبير وماهان الحنفي قال : لما مسخوا جعل الرجل يشبه الرجل وهو قرد فيقال : انت فلان

 فيومء الي يديه بما كسبت يداي
 واخرج ابن بطة عن ابي هريرة رضي الله عنه ان رسول الله صلي الله عليه وسلم قال : لا ترتكبوا ما ارتكبت اليهود فتستحلوا محارم الله بادني الحيل
 واخرج ابو الشيخ عن سفيان قال : قالوا لعبد الله بن عبد العزيز العمري في الامر بالمعروف والنهي عن المنكر : تامر من لا يقبل منك قال : يكون معذرة وقرا @QB@ قالوا معذرة الي ربكم @QE@
