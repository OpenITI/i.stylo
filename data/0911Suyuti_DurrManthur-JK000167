  اخرج ابن جرير وابن ابي حاتم وابو الشيخ وابن مردويه عن عاءشة قالت : قال رسول الله صلي الله عليه وسلم الطوفان : الموت
 واخرج عبد بن حميد وابن جرير وابو الشيخ عن عطاء قال @QB@ الطوفان @QE@ الموت
 واخرج عبد بن حميد وابن جرير وابو الشيخ عن مجاهد قال @QB@ الطوفان @QE@ الموت علي كل حال
 واخرج ابو الشيخ عن ابن عباس قال @QB@ الطوفان @QE@ الغرق
 واخرج ابن ابي حاتم وابو الشيخ عن ابن عباس قال @QB@ الطوفان @QE@ ان يمطروا داءما بالليل والنهار ثمانية ايام والقمل الجراد الذي ليس له اجنحة
  واخرج ابن جرير وابن المنذر وابن ابي حاتم عن ابن عباس قال : @QB@ الطوفان @QE@ امر من امر ربك ثم قرا @QB@ فطاف عليها طاءف من ربك @QE@ القلم الاية   واخرج ابن جرير وابن ابي حاتم عن ابن عباس قال : ارسل الله علي قوم فرعون الطوفان  وهو المطر  فقالوا : يا موسي ادع لنا ربك يكشف عنا المطر فنءمن لك ونرسل معك بني اسراءيل فدعا ربه فكشف عنهم فانبت الله لهم في تلك السنة شيءا لم ينبته قبل ذلك من الزرع والكلا فقالوا : هذا ما كنا نتمني فارسل الله عليهم الجراد فسلطه عليهم فلما راوه عرفوا انه لا يبقي الزرع قالوا
 مثل ذلك فدعا ربه فكشف عنهم الجراد فداسوه واحرزوه في البيوت فقالوا : قد احرزنا فارسل الله عليهم القمل : وهو السوس الذي يخرج من الحنطة فكان الرجل يخرج بالحنطة عشرة اجربة الي الرحا فلا يرد منها بثلاثة اقفزة فقالوا مثل ذلك فكشف عنهم فابوا ان يرسلوا معه بني اسراءيل فبينا موسي عند فرعون اذ سمع نقيق ضفدع من نهر فقال : يا فرعون ما تلقي انت وقومك من هذا الضفدع فقال : وما عسي ان يكون عند هذا الضفدع فما امسوا حتي كان الرجل يجلس الي ذقنه في الضفادع وما منهم من احد يتكلم الا وثب ضفدع في فيه وما من شء من انيتهم الا وهي ممتلءة من الضفادع
 فقالوا مثل ذلك فكشف عنهم فلم يفوا فارسل الله عليهم الدم فصارت انهارهم دما وصارت ابارهم دما فشكوا الي فرعون ذلك فقال : ويحكم قد سحركم فقالوا : ليس نجد من ماءنا شيءا في اناء ولا بءر ولا نهر الا ونجده طعم الدم العبيط فقال فرعون : يا موسي ادع لنا ربك يكشف عنهم الدم فلم يفوا
 واخرج ابن المنذر وابن ابي حاتم عن ابن عباس في قوله @QB@ فارسلنا عليهم الطوفان @QE@ وهو المطر حتي خافوا الهلاك فاتوا موسي فقالوا : يا موسي ادع لنا ربك ان يكشف عنا  المطر فانا نءمن لك ونرسل معك بني اسراءيل فدعا ربه فكشف عنهم المطر فانبت الله به حرثهم واخصبت بلادهم فقالوا : ما نحب انا لم نمطر ولن نترك الهنا ونءمن بك ولن نرسل معك بني اسراءيل
 فارسل الله عليهم الجراد فاسرع في فساد زروعهم وثمارهم قالوا : يا موسي ادع لنا ربك ان يكشف عنا الجراد فانا سنءمن لك ونرسل معك بني اسراءيل
 فدعا ربه فكشف عنهم الجراد وكان قد بقي من زرعهم ومعاءشهم بقايا فقالوا : قد بقي لنا ما هو كافينا فلن نءمن لك ولن نرسل معك بني اسراءيل
 فارسل الله عليهم القمل وهو الدبا فتتبع ما كان ترك الجراد فجزعوا وخشوا الهلاك فقالوا : يا موسي ادع لنا ربك يكشف عنا الدبا فانا سنءمن لك ونرسل معك بني اسراءيل
 فدعا ربه فكشف عنهم الدبا فقالوا : ما نحن لك بمءمنين ولا مرسلين معك بني اسراءيل
 فارسل الله عليهم الضفادع فملا بيوتهم منها ولقوا منها اذي شديدا لم يلقوا مثله فيما كان قبله كانت تثب في قدورهم فتفسد عليهم طعامهم وتطفء نيرانهم قالوا : يا موسي ادع لنا ربك ان يكشف عنا الضفادع فقد لقينا منها بلاء واذي فانا سنءمن لك ونرسل معك بني اسراءيل
 فدعا ربه فكشف عنهم الضفادع فقالوا : لا نءمن لك ولا نرسل معك بني اسراءيل
 فارسل الله عليهم الدم فجعلوا لا ياكلون الا الدم ولا يشربون الا الدم قالوا : يا موسي ادع لنا ربك ان يكشف عنا الدم فانا سنءمن لك ونرسل معك بني اسراءيل
 فدعا ربه فكشف عنهم الدم فقالوا : يا موسي لن نءمن لك ولن نرسل معك بني اسراءيل  فكانت ايات مفصلات بعضها اثر بعض لتكون لله الحجة عليهم فاخذهم الله بذنوبهم فاغرقهم في اليم
 واخرج ابن ابي شيبة وعبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم وابو الشيخ عن مجاهد في قوله @QB@ فارسلنا عليهم الطوفان @QE@ قال : الماء والطاعون والجراد
 قال : تاكل مسامير رتجهم : يعني ابوابهم وثيابهم والقمل الدبا والضفادع تسقط علي فرشهم وفي اطعمتهم والدم يكون في ثيابهم وماءهم وطعامهم
 واخرج ابو الشيخ عن عطاء قال : بلغني ان الجراد لما سلط علي بني اسراءيل اكل ابوابهم حتي اكل مساميرهم
 واخرج ابن ابي حاتم عن ابن عباس قال : الجراد نترة من حوت في البحر
 واخرج العقيلي في كتاب الضعفاء وابو الشيخ في العظمة عن ابي هريرة ان النبي صلي الله عليه وسلم سءل عن الجراد فقال : ان مريم سالت الله ان يطعمها لحما لا دم فيه فاطعمها الجراد
 واخرج الطبراني والبيهقي في سننه عن ابي امامة الباهلي ان النبي صلي الله عليه وسلم قال : ان مريم بنت عمران سالت ربها ان يطعمها لحما لا دم فيه فاطعمها الجراد فقالت :  اللهم اعشه بغير رضاع وتابع بينه بغير شياع  يعني الصون  قال الذهبي : اسناده انظف من الاول
 واخرج البيهقي في سننه عن زينب ربيبة رسول الله صلي الله عليه وسلم قالت : ان نبيا من الانبياء سال الله لحم طير لا ذكاة له فرزقه الله الحيتان والجراد
 واخرج ابو داود وابن ماجة وابو الشيخ في العظمة والطبراني وابن مردويه والبيهقي عن سلمان قال : سءل رسول الله صلي الله عليه وسلم عن الجراد فقال اكثر جنود الله لا اكله ولا احرمه
 واخرج ابو بكر البرقي في معرفة الصحابة والطبراني وابو الشيخ في العظمة والبيهقي في شعب الايمان عن ابي زهير النميري قال : قال رسول الله صلي الله عليه وسلم لا تقاتلوا الجراد فانه جند من جند الله الاعظم قال البيهقي : هذا ان صح اراد به اذا لم يتعرض لافساد المزارع فاذا تعرض له جاز دفعه بما يقع به الدفع من القتال والقتل او اراد به تعذر مقاومته بالقتال والقتل
 واخرج البيهقي من طريق الفضيل بن عياض عن مغيرة عن ابراهيم عن عبد الله قال : وقعت جرادة بين يدي رسول الله صلي الله عليه وسلم فقالوا : الا نقتلها يا رسول الله فقال من قتل جرادة فكانما قتل غوريا قال البيهقي : هذا ضعيف بجهالة بعض رواته وانقطاع ما بين ابراهيم وابن مسعود
 واخرج الحاكم في تاريخه والبيهقي بسند فيه مجهول عن ابن عمر قال : وقعت جرادة بين يدي رسول الله صلي الله عليه وسلم فاحتملها فاذا مكتوب في جناحها بالعبرانية : لا يعني جنيني ولا يشبع اكلي نحن جند الله الاكبر لنا تسع وتسعون بيضة ولو تمت لنا الماءة لاكلنا الدنيا بما فيها
 فقال النبي صلي الله عليه وسلم اللهم اهلك الجراد اقتل كبارها وامت صغارها وافسد بيضها وسد افواهها عن مزارع المسلمين وعن معايشهم انك سميع الدعاء فجاءه جبريل فقال : انه قد استجيب لك في بعض قال البيهقي : هذا حديث منكر
 واخرج الطبراني واسمعيل بن عبد الغافر الفارسي في الاربعين والبيهقي عن الحسين بن علي قال : كنا علي ماءدة انا واخي محمد بن الحنيفة وبني عمي عبد الله بن عباس وقثم والفضل فوقعت جرادة فاخذها عبد الله بن عباس فقال للحسين : تعلم ما مكتوب علي جناح الجرادة فقال : سالت ابي فقال : سالت  رسول الله صلي الله عليه وسلم فقال لي علي جناح الجرادة مكتوب : اني انا الله لا اله الا انا رب الجرادة ورازقها اذا شءت بعثتها رزقا لقوم وان شءت علي قوم بلاء
 فقال ابن عباس : هذا والله من مكنون العلم
 واخرج ابو نعيم في الحلية عن عكرمة قال : قال لي ابن عباس : مكتوب علي الجرادة بالسريانية : اني انا الله لا اله الا انا وحدي لا شريك لي الجراد جند من جندي اسلطه علي من اشاء من عبادي
 واخرج ابو الشيخ في العظمة عن سعيد بن المسيب قال : لما خلق الله ادم فضل من طينته شء فخلق منه الجراد
