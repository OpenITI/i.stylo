 اخرج عبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم عن مجاهد في قوله @QB@ وما انفقتم من نفقة او نذرتم من نذر فان الله يعلمه @QE@ قال : يحصيه
 واخرج عبد الرزاق والبخاري من طريق ابن شهاب عن عوف بن الحرث بن الطفيل وهو ابن اخي عاءشة لامها
 ان عاءشة رضي الله عنها حدثت : ان عبد الله بن  الزبير قال في بيع او عطاء اعطته عاءشة : والله لتنتهين عاءشة او لاحجرن عليها
 فقالت : اهو قال هذا قالوا نعم
 قالت عاءشة : فهو لله نذر ان لا اكلم ابن الزبير كلمة ابدا
 فاستشفع ابن الزبير بالمهاجرين حين طالت هجرتها اياه
 فقالت : والله لا اشفع فيه احدا ابدا ولا احنث نذري الذي نذرت ابدا فلما طال علي ابن الزبير كلم المسور بن مخرمة وعبد الرحمن بن الاسود بن عبد يغوث وهما من بني زهرة فقال لهما : انشدكما الله الا ادخلتماني علي عاءشة فانها لا يحل لها ان تنذر قطيعتي فاقبل به المسور وعبد الرحمن مشتملين عليه بارديتهما حتي استاذنا علي عاءشة فقالا : السلام علي النبي ورحمة الله و بركاته اندخل فقالت عاءشة : ادخلوا
 قالوا : اكلنا يا ام المءمنين قالت : نعم ادخلوا كلكم
 ولا تعلم عاءشة ان معهما ابن الزبير فلما دخلوا دخل ابن الزبير في الحجاب و اعتنق عاءشة وطفق يناشدها ويبكي وطفق المسور وعبد الرحمن يناشدان عاءشة الا كلمته وقبلت منه ويقولان : قد علمت ان رسول الله صلي الله عليه وسلم نهي عما قد علمت من الهجرة و انه لا يحل للرجل ان يهجر اخاه فوق ثلاث ليال فلما اكثروا التذكير والتحريج طفقت تذكرهم وتبكي وتقول : اني قد نذرت والنذر شديد فلم يزالوا بها حتي كلمت ابن الزبير ثم اعتقت بنذرها اربعين رقبة لله ثم كانت تذكر بعدما اعتقت اربعين رقبة فتبكي حتي تبل دموعها خمارها
 واخرج ابن ابي حاتم عن عبد الله بن حجيرة الاكبر
 ان رجلا اتاه فقال : اني نذرت ان لا اكلم اخي فقال : ان الشيطان ولد له ولد فسماه نذرا وان من قطع ما امر الله به ان يوصل فقد حلت عليه اللعنة
 واخرج مالك وابن ابي شيبة والبخاري وابو داود والترمذي والنساءي وابن ماجه عن عاءشة ان رسول الله صلي الله عليه وسلم قال : من نذر ان يطيع الله فليطعه ومن نذر ان يعصيه فلا يعصيه
 و اخرج ابو داود والترمذي والنساءي وابن ماجه عن عاءشة ان رسول الله صلي الله عليه وسلم قال : من نذر ان يطيع الله فليطعه ومن نذر ان يعصيه فلا يعصيه
 واخرج ابو داود والترمذي والنساءي وابن ماجه عن عاءشة ان النبي صلي الله عليه وسلم قال : لا نذر في معصية وكفارته كفارة يمين
 واخرج ابن ابي شيبة ومسلم وابو داود والنساءي وابن ماجه عن عمران بن  حصين قال : اسرت امراة من الانصار فاصيبت العضباء فقعدت في عجزها ثم زجرتها فانطلقت و نذرت ان نجاها الله عليها لتنحرنها فلما قدمت المدينة راها الناس فقالوا : العضباء ناقة رسول الله صلي الله عليه وسلم فقالت : انها نذرت ان نجاها الله عليها لتنحرنها فاتوا رسول الله صلي الله عليه وسلم فذكروا ذلك له فقال : سبحان الله

 بءس ما جزتها نذرت لله ان نجاها الله عليها لتنحرنها لا وفاء لنذر في معصية الله ولا فيما لا يملك العبد
 واخرج ابن ابي شيبة ومسلم وابو داود والترمذي والنساءي وابن ماجه عن عقبة بن عامر ان رسول الله صلي الله عليه وسلم قال : كفارة النذر اذا لم يسم كفارة اليمين
 واخرج البخاري ومسلم وابو داود والترمذي والنساءي وابن ماجه عن ثابت بن الضحاك عن النبي صلي الله عليه وسلم قال : ليس علي العبد نذر فيما لا يملك
 واخرج البخاري ومسلم وابو داود والترمذي والنساءي وابن ماجه عن ابن عمر ان النبي صلي الله عليه وسلم نهي عن النذر وقال : انه لا ياتي بخير وانما يستخرج به من البخيل
 واخرج مسلم والترمذي والنساءي عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال : لا تنذروا فان النذر لا يغني من القدر شيءا وانما يستخرج من البخيل
 واخرج البخاري ومسلم وابن ماجه عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : لا ياتي ابن ادم النذر بشء لم اكن قدرته ولكن يلقيه النذر الي القدر قد قدرته فيستخرج الله به من البخيل فيءتيني عليه ما لم يكن يءتيني عليه من قبل
 واخرج البخاري ومسلم وابو داود والترمذي والنساءي عن انس ان النبي صلي الله عليه وسلم راي شيخا يهادي بين ابنيه فقال : ما بال هذا قالوا : نذر ان يمشي الي الكعبة
 قال : ان الله عن تعذيب هذا نفسه لغني وامره ان يركب
 واخرج مسلم وابن ماجه عن ابي هريرة ان النبي صلي الله عليه وسلم ادرك شيخا يمشي بين ابنيه يتوكا عليهما
 فقال : ما شان هذا قال ابناه : يا رسول الله كان عليه نذر
 فقال النبي صلي الله عليه وسلم : اركب ايها الشيخ فان الله غني عنك وعن نذرك
 واخرج البخاري ومسلم وابو داود والنساءي عن عقبة بن عامر قال : نذرت اختي ان تمشي الي بيت الله حافية فامرتني ان استفتي لها رسول الله صلي الله عليه وسلم فاستفتيته فقال : لتمش ولتركب
  واخرج ابو داود عن ابن عباس ان اخت عقبة بن عامر نذرت ان تحج ماشية وانها لا تطيق ذلك فقال النبي صلي الله عليه وسلم : ان الله لغني عن مشي اختك فلتركب ولتهد بدنة
 واخرج ابو داود والحاكم وصححه عن ابن عباس قال : جاء رجل الي النبي صلي الله عليه وسلم فقال : يا رسول الله ان اختي نذرت ان تحج ماشية
 فقال النبي صلي الله عليه وسلم : ان الله لا يصنع بشقاء اختك شيءا فلتحج راكبة وتكفر عن يمينها
 واخرج ابو داود والنساءي وابن ماجه عن عقبة بن عامر انه سال النبي صلي الله عليه وسلم عن اخت له نذرت ان تحج حافية غير مختمرة
 فقال : مروها فلتختمر ولتركب ولتصم ثلاثة ايام
 واخرج البخاري وابو داود وابن ماجه عن ابن عباس قال بينما النبي صلي الله عليه وسلم يخطب اذا هو برجل قاءم في الشمس فسال عنه فقالوا : هذا ابو اسراءيل نذر ان يقوم ولا يقعد لا يستظل ولا يتكلم ويصوم
 فقال النبي صلي الله عليه وسلم : مروه فليتكلم وليستظل وليقعد وليتم صومه
 واخرج ابو داود وابن ماجه عن ابي عباس ان رسول الله صلي الله عليه وسلم قال : من نذر نذرا لم يسمه فكفارته كفارة يمين ومن نذر نذرا في معصية فكفارته كفارة يمين ومن نذر نذرا لا يطيقه فكفارته كفارة يمين ومن نذر نذرا اطاقه فليوف به
 واخرج النساءي عن عمران بن حصين سمعت رسول الله صلي الله عليه وسلم يقول : النذر نذران
 فما كان من نذر في طاعة الله فذلك لله وفيه الوفاء وما كان من نذر في معصية الله فذلك للشيطان ولا وفاء فيه ويكفره ما يكفر اليمين
 واخرج ابن ابي شيبة والنساءي والحاكم عن عمران بن حصين قال : قال رسول الله صلي الله عليه وسلم : لا نذر في معصية ولا غضب وكفارته كفارة يمين
 واخرج الحاكم وصححه عن عمران بن حصين قال ما خطبنا رسول الله صلي الله عليه وسلم خطبة الا امرنا بالصدقة ونهانا عن المثلة
 قال : وان المثلة ان يخرم انفه وان ينذر ان يحج ماشيا فمن نذر ان يحج ماشيا فليهد هديا وليركب
 واخرج ابن ابي شيبة عن سعيد بن جبير قال جاء رجل الي ابن عباس فقال : اني نذرت ان اقوم علي قعيقعان عريانا الي الليل
 فقال : اراد الشيطان ان يبدي عورتك وان يضحك الناس بك البس ثيابك وصل عند الحجر ركعتين
  واخرج عبد الرزاق وابن ابي شيبة عن ابن عباس قال : النذور اربعة : فمن نذر نذرا لم يسمه فكفارته كفارة يمين ومن نذر في معصية فكفارته كفارة يمين ومن نذر نذرا فيما لا يطيق فكفارته كفارة يمين ومن نذر نذرا فيما يطيق فليوف بنذره
 و اما قوله تعالي : @QB@ وما للظالمين من انصار @QE@ اخرج ابن ابي حاتم عن شريح قال : الظالم ينتظر العقوبة والمظلوم ينتظر النصر
 واخرج البخاري ومسلم والترمذي عن ابن عمر قال : قال رسول الله صلي الله عليه وسلم : الظلم ظلمات يوم القيامة
 واخرج البخاري في الادب ومسلم والبيهقي في الشعب عن جابر ان رسول الله صلي الله عليه وسلم قال : اتقوا الظلم فان الظلم ظلمات يوم القيامة واتقوا الشح فان الشح اهلك من كان قبلكم حملهم علي ان سفكوا دماءهم واستحلوا محارمهم
 واخرج البخاري في الادب وابن حبان والحاكم وصححه والبيهقي في الشعب عن ابي هريرة يبلغ به النبي صلي الله عليه وسلم قال : اياكم والظلم فان الظلم هو الظلمات يوم القيامة واياكم والفحش فان الله لا يحب الفاحش المتفحش واياكم والشح فان الشح دعا من كان قبلكم فسفكوا دماءهم واستحلوا محارمهم وقطعوا ارحامهم
 واخرج الحاكم والبيهقي في الشعب عن عبد الله بن عمرو قال : قال رسول الله صلي الله عليه وسلم : اياكم و الظلم فان الظلم ظلمات يوم القيامة واياكم والفحش والتفحش واياكم والشح فانما هلك من كان قبلكم بالشح امرهم بالقطيعة فقطعوا وامرهم بالبخل فبخلوا وامرهم بالفجور ففجروا
 واخرج الطبراني عن الهرماس بن زياد قال رايت رسول الله صلي الله عليه وسلم يخطب علي ناقته فقال : اياكم والخيانة فانها بءست البطانة واياكم والظلم فانه ظلمات يوم القيامة واياكم والشح فانما اهلك من كان قبلكم الشح حتي سفكوا دماءهم وقطعوا ارحامهم
 واخرج الاصبهاني من حديث عمر بن الخطاب
 مثله
 واخرج الطبراني عن ابن مسعود ان النبي صلي الله عليه وسلم قال : لا تظلموا فتدعوا فلا يستجاب لكم و تستسقوا فلا تسقوا وتستنصروا فلا تنصروا
  واخرج الطبراني عن ابي امامة قال : قال رسول الله صلي الله عليه وسلم : صنفان من امتي لن تنالهم شفاعتي : امام ظلوم غشوم وكل غال مارق
 واخرج الحاكم وصححه عن ابن عمر قال : قال رسول الله صلي الله عليه وسلم : اتقوا دعوة المظلوم فانها تصعد الي السماء كانها شرارة
 واخرج الطبراني عن عقبة بن عامر الجهني قال : قال رسول الله صلي الله عليه وسلم : ثلاثة تستجاب دعوتهم : الوالد والمسافر والمظلوم
 واخرج احمد عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : دعوة المظلوم مستجابة وان كان فاجرا ففجوره علي نفسه
 واخرج الطبراني والاصبهاني عن ابن عباس قال : قال رسول الله صلي الله عليه وسلم : دعوتان ليس بينهما وبين الله حجاب
 دعوة المظلوم ودعوة المرء لاخيه بظهر الغيب
 واخرج الطبراني عن خزيمة بن ثابت قال : قال رسول الله صلي الله عليه وسلم : اتقوا دعوة المظلوم فانها تحمل علي الغمام يقول الله : وعزتي وجلالي لانصرنك ولو بعد حين
 واخرج احمد عن انس بن مالك قال : قال رسول الله صلي الله عليه وسلم : اتقوا دعوة المظلوم وان كان كافرا فانه ليس دونها حجاب
 واخرج الطبراني في الاوسط عن علي قال : قال رسول الله صلي الله عليه وسلم : يقول الله : اشتد غضبي علي من ظلم من لا يجد له ناصرا غيري
 واخرج ابو الشيخ بن حبان في كتاب التوبيخ عن ابن عباس قال : قال رسول الله صلي الله عليه وسلم : قال الله تبارك وتعالي : وعزتي وجلالي لانتقمن من الظالم في عاجله واجله ولانتقمن ممن راي مظلوما فقدر ان ينصره فلم يفعل
 واخرج الاصبهاني عن عبد الله بن سلام قال : ان الله لما خلق الخلق فاستووا علي اقدامهم رفعوا رءوسهم فقالوا : يا رب مع من انت قال : انا مع المظلوم حتي يءدي اليه حقه
 واخرج ابن مردويه والاصبهاني في الترغيب عن ابن عباس ان ملكا من الملوك خرج يسير في مملكته وهو مستخف من الناس حتي نزل علي رجل له بقرة فراحت عليه تلك البقرة فحلبت فاذا حلابها مقدار حلاب ثلاثين بقرة فحدث الملك نفسه ان ياخذها فلما كان الغد غدت البقرة الي مرعاها ثم راحت فحلبت فنقص لبنها علي النصف وجاء مقدار حلاب خمس عشرة بقرة فدعا الملك صاحب  منزله فقال : اخبرني عن بقرتك ارعت اليوم في غيرمرعاها بالامس وشربت من غير مشربها بالامس فقال : ما رعت في غير مرعاها بالامس ولا شربت في غير مشربها بالامس
 فقال : ما بال حلابها علي النصف فقال : اري الملك هم باخذها فنقص لبنها فان الملك اذا ظلم او هم بالظلم ذهبت البركة
 قال : وانت من اين يعرفك الملك قال : هو ذاك كما قلت لك
 قال : فعاهد الملك ربه في نفسه ان لا يظلم ولا ياخذها ولا يملكها ولا تكون في ملكه ابدا
 قال : فغدت فرعت ثم راحت ثم حلبت فاذا لبنها قد عاد علي مقدار ثلاثين بقرة
 فقال الملك بينه وبين نفسه واعتبر : اري الملك اذا ظلم او هم بظلم ذهبت البركة لا جرم لاعدلن فلاكونن علي افضل العدل
 واخرج الاصبهاني عن سعيد بن عبد العزيز : من احسن فليرج الثواب ومن اساء فلا يستنكر الجزاء ومن اخذ عزا بغير حق اورثه الله ذلا بحق ومن جمع مالا بظلم اورثه الله فقرا بغير ظلم
 واخرج احمد في الزهد عن وهب بن منبه قال : ان الله عز وجل قال : من استغني باموال الفقراء افقرته وكل بيت يبني بقوة الضعفاء اجعل عاقبته الي خراب
