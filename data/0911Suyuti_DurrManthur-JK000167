 اخرج عبد الرزاق والفريابي وسعيد بن منصور والحارث بن ابي اسامة وابن جرير وابن المنذر وابن ابي حاتم وابن الانباري في المصاحف والحاكم وصححه البيهقي في شعب الايمان من طرق عن علي بن ابي طالب رضي الله عنه في قوله @QB@ والذاريات ذروا @QE@ قال : الرياح @QB@ فالحاملات وقرا @QE@ قال : السحاب @QB@ فالجاريات يسرا @QE@ قال : السفن @QB@ فالمقسمات امرا @QE@ قال : الملاءكة
 واخرج البزار والدارقطني في الافراد وابن مردويه وابن عساكر عن سعيد بن المسيب قال : جاء صبيغ التميمي الي عمر بن الخطاب رضي الله عنه فقال : اخبرني عن @QB@ والذاريات ذروا @QE@ قال : هي الرياح ولولا اني سمعت رسول الله صلي الله عليه وسلم يقوله ما قلته قال : فاخبرني عن @QB@ فالحاملات وقرا @QE@ قال : هي السحاب ولولا اني سمعت رسول الله صلي الله عليه وسلم يقوله ما قلته قال : فاخبرني عن @QB@ فالجاريات يسرا @QE@ قال : هي السفن ولولا اني سمعت رسول الله صلي الله عليه وسلم يقوله ما قلته
 قال : فاخبرني عن @QB@ فالمقسمات امرا @QE@ قال : هن الملاءكة ولولا اني سمعت رسول الله صلي الله عليه وسلم يقوله ما قلته ثم امر به فضرب ماءة وجعل في بيت فلما برا دعاه فضرب ماءة اخري وحمله علي قتب وكتب الي ابي موسي الاشعري امنع الناس من مجالسته فلم يزالوا كذلك حتي اتي ابا موسي فحلف له بالايمان المغلظة ما يجد في نفسه مما كان يجد شيءا فكتب في ذلك الي عمر فكتب عمر : ما اخاله الا وقد صدق فحل بينه وبين مجالسة الناس
 واخرج الفريابي عن الحسن قال : سال صبيغ التميمي عمر بن الخطاب رضي الله عنه عن @QB@ والذاريات ذروا @QE@ وعن @QB@ والمرسلات عرفا @QE@ وعن @QB@ والنازعات غرقا @QE@ فقال عمر رضي الله عنه : اكشف راسك فاذا له ضفيرتان فقال : والله لو وجدتك محلوقا لضربت عنقك
 ثم كتب الي ابي موسي الاشعري ان لا يجالسه مسلم ولا يكلمه
 واخرج الفريابي وابن المنذر عن سعيد بن جبير قال : سالت ابن عباس رضي الله عنهما عن @QB@ والذاريات ذروا @QE@ فقال : الرياح @QB@ فالحاملات وقرا @QE@ قال : السحاب @QB@ فالجاريات يسرا @QE@ قال : السفن
 واخرج ابن جرير وابن نصر وابن المنذر عن ابن عباس رضي الله عنهما في قوله @QB@ كانوا قليلا من الليل ما يهجعون @QE@ يقول : قليلا ما كانوا ينامون
  واخرج ابو داود وابن جرير وابن ابي حاتم والحاكم وصححه وابن مردويه والبيهقي في سننه عن انس رضي الله عنه في قوله @QB@ كانوا قليلا من الليل ما يهجعون @QE@ قال : كانوا يصلون بين المغرب والعشاء وكذلك ( تتجافي جنوبهم ) ( البقرة الاية  )
 واخرج ابن ابي شيبة وابن جرير عن ابي العالية في قوله @QB@ كانوا قليلا من الليل ما يهجعون @QE@ قال : لا ينامون عن العشاء الاخرة
 واخرج ابن ابي شيبة وابن نصر وابن المنذر عن عطاء في قوله @QB@ كانوا قليلا من الليل ما يهجعون @QE@ قال : ذلك اذ امروا بقيام الليل وكان ابو ذر يعتمد علي العصا فمكثوا شهرين ثم نزلت الرخصة ( فاقراوا ما تيسر منه ) ( الماءدة الاية  )
 واخرج ابن جرير وابن المنذر عن الضحاك في الاية قال : كانوا قليلا من الناس الذين يفعلون ذلك اذ ذاك
 واخرج ابن ابي شيبة عن الضحاك في الاية قال : المتقين هم القليل كانوا من الناس قليلا
 واخرج ابن جرير ومحمد بن نصر عن الضحاك في قوله @QB@ كانوا قليلا @QE@ يقول : المحسنون كانوا قليلا هذه مفصولة ثم استانف فقال : @QB@ من الليل ما يهجعون @QE@ الهجوع النوم
 واخرج ابن ابي شيبة وابن نصر عن مجاهد رضي الله عنه في الاية قال : كانوا لا ينامون الليل كله
 واخرج ابن ابي شيبة وابن جرير عن قتادة في قوله @QB@ كانوا قليلا من الليل ما يهجعون @QE@ قال : كان الحسن يقول : كانوا قليلا من الليل ما ينامون وكان مطرف بن عبد الله يقول : كانوا قل ليلة لا يصيبون منها وكان محمد بن علي يقول : لا ينامون حتي يصلوا العتمة
 واخرج ابن ابي شيبة وابن المنذر وابن مردويه من طريق الحسن عن عبد الله بن رواحة رضي الله عنه في قوله @QB@ كانوا قليلا من الليل ما يهجعون @QE@ قال : هجعوا قليلا ثم مدوها الي السحر
  واخرج ابن مردويه عن انس رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : ان اخر الليل في التهجد احب الي من اوله لان الله يقول @QB@ وبالاسحار هم يستغفرون @QE@
 واخرج ابن مردويه عن ابن عمر رضي الله عنهما عن النبي صلي الله عليه وسلم في قوله @QB@ وبالاسحار هم يستغفرون @QE@ قال : يصلون
 واخرج عبد الرزاق وابن ابي شيبة وابن جرير وابن المنذر وابن ابي حاتم وابن مردويه عن ابن عمر رضي الله عنهما في قوله @QB@ وبالاسحار هم يستغفرون @QE@ قال : يصلون
 واخرج ابن ابي شيبة وابن نصر وابن جرير وابن المنذر عن الحسن في الاية قال : صلوا فلما كان السحر استغفروا
 واخرج ابن ابي حاتم عن ابن عباس رضي الله عنهما في قوله @QB@ وفي اموالهم حق @QE@ قال : سوي الزكاة يصل بها رحما او يقري بها ضيفا او يعين بها محروما
 واخرج ابن ابي شيبة وعبد بن حميد وابن المنذر عن مجاهد في قوله @QB@ وفي اموالهم حق @QE@ قال : سوي الزكاة
 واخرج ابن ابي شيبة عن ابراهيم قال : كانوا يرون في اموالهم حقا سوي الزكاة
 واخرج سعيد بن منصور وابن جرير وابن المنذر وابن ابي حاتم عن ابن عباس انه سءل عن الساءل والمحروم قال : الساءل الذي يسال الناس والمحروم الذي ليس له سهم في المسلمين
 واخرج ابن ابي شيبة وابن جرير وابن المنذر وابن ابي حاتم وابن مردويه عن الحسن بن محمد بن الحنفية قال : بعث رسول الله صلي الله عليه وسلم سرية فاصابوا وغنموا فجاء قوم بعد ما فرغوا فنزلت @QB@ في اموالهم حق معلوم للساءل والمحروم @QE@
 واخرج ابن ابي حاتم عن ابن عباس رضي الله عنهما قال : المحروم هو المحارف الذي يطلب الدنيا وتدبر عنه ولا يسال الناس فامر الله المءمنين برفده
 واخرج ابن ابي حاتم عن عروة قال : سالت عاءشة رضي الله عنها عن المحروم في هذه الاية فقالت : هو المحارف الذي لا يكاد يتيسر له مكسبه
 واخرج ابن ابي شيبة وابن جرير عن ابن عباس رضي الله عنهما قال : المحروم المحارف الذي ليس له في الاسلام سهم
  واخرج ابن ابي شيبة عن مجاهد رضي الله عنه قال : المحروم الذي ليس في الغنيمة شء
 واخرج ابن ابي شيبة عن ابراهيم مثله
 واخرج ابن المنذر عن ابي قلابة قال : كان رجل باليمامة فجاء السيل فذهبت بماله فقال رجل من اصحاب النبي صلي الله عليه وسلم : هذا المحروم فاعطوه
 واخرج ابن جرير وابن المنذر عن قتادة رضي الله عنه قال : الساءل الذي يسال بكفه والمحروم المتعفف
 واخرج عبد بن حميد عن ابي العالية قال : المحروم المحارف
 واخرج عبد بن حميد عن عكرمة قال : المحروم المحارف الذي لا يثبت له مال
 واخرج عبد بن حميد وابن جرير عن الضحاك قال : المحروم الذي لا ينمو له مال في قضاء الله
 واخرج عبد بن حميد عن عامر قال : هو المحارف وتلا هذه الاية ( انا لمغرمون بل نحن محرمون ) ( الواقعة الاية    ) قال : هلكت ثمارهم وحرموا بركة ارضهم
 واخرج عبد بن حميد عن قزعة ان رجلا سال ابن عمر رضي الله عنهما عن قوله @QB@ في اموالهم حق معلوم @QE@ قال : هي الزكاة وفي سوي ذلك حقوق
 واخرج عبد بن حميد وابن جرير عن مجاهد في قوله @QB@ للساءل والمحروم @QE@ قال : الساءل الذي يسال بكفه والمحروم المحارف
 واخرج عبد بن حميد عن الشعبي قال : اعياني اعلم ما المحروم
 واخرج عبد بن حميد وابن جرير عن ابي بشر قال : سالت سعيد بن جبير عن المحروم فلم يقل فيه شيءا وسالت عطاء فقال : هو المحدود وزعم ان المحدود المحارف
 واخرج ابن جرير وابن حبان وابن مردويه عن ابي هريرة رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : ليس المسكين الذي ترده التمرة والتمرتان ولا الاكلة والاكلتان قالوا : فمن المسكين قال : الذي ليس له ما يغنيه ولا يعلم مكانه فيتصدق عليه فذلك المحروم
  واخرج العسكري في المواعظ وابن مردويه عن انس بن مالك رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : يا انس ويل للاغنياء من الفقراء يوم القيامة يقولون : ربنا ظلمونا حقوقنا التي فرضت لنا عليهم فيقول : وعزتي وجلالي لاقربنكم ولاباعدنهم قال : وتلا رسول الله صلي الله عليه وسلم @QB@ في اموالهم حق معلوم للساءل والمحروم @QE@
 واخرج البيهقي في سننه عن فاطمة بنت قيس انها سالت النبي صلي الله عليه وسلم عن هذه الاية @QB@ في اموالهم حق معلوم @QE@ قال : ان في المال حقا سوي الزكاة وتلا هذه الاية ( ليس البر ان تولوا وجوهكم ) الي قوله ( وفي الرقاب واقام الصلاة واتي الزكاة ) ( البقرة  ) والله سبحانه وتعالي اعلم
