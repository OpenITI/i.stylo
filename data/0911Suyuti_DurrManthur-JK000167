 اخرج عبد بن حميد عن قتادة في قوله @QB@ واستعينوا بالصبر والصلاة @QE@ قال : انهما معونتان من الله فاستعينوا بهما
 واخرج ابن ابي الدنيا في كتاب العزاء وابن ابي حاتم عن سعيد بن جبير قال : الصبر اعتراف العبد لله بما اصاب منه واحتسابه عند الله رجاء ثوابه وقد يجزع الرجل وهو متجلد لا يري منه الا الصبر
 واخرج ابن ابي حاتم عن عمر بن الخطاب قال : الصبر صبران : صبر عند المصيبة حسن واحسن منه الصبر عن محارم الله
 واخرج ابن ابي حاتم عن ابن زيد قال : الصبر بابين الصبر لله فيما احب وان ثقل علي الانفس والابدان والصبر عما كره وان نازعت اليه الاهواء فمن كان هكذا فهو من الصابرين الذين يسلم عليهم ان شاء الله تعالي
 واخرج ابن ابي الدنيا في كتاب الصبر وابو الشيخ في الثواب والديلمي في مسند الفردوس عن علي قال : قال رسول الله صلي الله عليه وسلم الصبر ثلاثة فصبر علي المصيبة وصبر علي الطاعة وصبر علي المعصية
 واخرج احمد وعبد بن حميد في مسنده والترمذي وحسنه وابن مردويه والبيهقي في شعب الايمان وفي الاسماء والصفات عن ابن عباس قال : كنت رديف رسول الله صلي الله عليه وسلم فقال يا غلام الا اعلمك كلمات ينفعك الله بهن قلت : بلي
 قال : احفظ الله يحفظك احفظ الله تجده امامك تعرف الي الله في الرخاء يعرفك في الشدة واعلم ان ما اصابك لم يكن ليخطءك وان ما اخطاك لم يكن ليصيبك وان الخلاءق لو اجتمعوا علي ان يعطوك شيءا لم يرد الله ان يعطيكه لم يقدروا علي ذلك او ان يصرفوا عنك شيءا اراد اله ان يعطيكه لم يقدروا علي ذلك وان قد جف القلم بما هو كاءن الي يوم القيامة فاذا سالت فسال الله واذا استعنت فاستعن بالله واذا اعتصمت فاعتصم بالله واعمل لله بالشكر في اليقين واعلم ان الصبر علي ما تكره خير كثير وان النصر مع الصبر وان الفرج مع الكرب ان مع العسر يسرا
 واخرج الدارقطني في الافراد وابن مردويه والبيهقي والاصبهاني في الترغيب عن  سهل بن سعد الساعدي
 ان رسول الله صلي الله عليه وسلم قال لعبد الله بن عباس الا اعلمك كلمات تنتفع بهن قال : بلي يا رسول الله
 قال : احفظ الله يحفظك احفظ الله تجده امامك تعرف الي الله في الرخاء يعرفك في الشدة فاذا سالت فسال الله واذا استعنت فاستعن بالله جف القلم بما هو كاءن فلو جهد العباد ان ينفعوك بشء لم يكتبه الله عليك لم يقدروا عليه ولو جهد العباد ان يضروك بشء لم يكتبه الله عليك لم يقدروا عليه فان استطعت ان تعمل لله بالصدق في اليقين فافعل فان لم تستطع فان في الصبر علي ما تكره خيرا كثيرا واعلم ان النصر مع الصبر وان الفرج مع الكرب وان مع العسر يسرا
 واخرج الحكيم والترمذي في نوادر الاصول عن ابن عباس قال : كنت ذات يوم رديف رسول الله صلي الله عليه وسلم قال الا اعلمك خصالا ينفعك اله بهن قلت : بلي
 قال : عليك بالعلم فان العلم خليل المءمن والحلم وزيره والعقل دليله والعمل قيمه والرفق ابوه واللين اخوه والصبر امير جنوده
 واخرج البيهقي في شعب الايمان والخراءطي في كتاب الشكر عن انس قال : قال رسول الله صلي الله عليه وسلم الايمان نصفان
 فنصف في الصبر ونصف في الشكر
 واخرج البيهقي عن ابن مسعود قال : قال رسول الله صلي الله عليه وسلم الصبر نصف الايمان واليقين الايمان كله
 واخرج سعيد بن منصور وعبد بن حميد والطبراني والبيهقي عن ابن مسعود موقوفا مثله
 وقال البيهقي : انه المحفوظ
 واخرج البيهقي عن علي بن ابي طالب قال : الايمان علي اربع دعاءم
 علي الصبر والعدل واليقين والجهاد
 واخرج ابن ابي شيبة والبيهقي عن جابر بن عبد الله قال : قيل يا رسول الله اي الايمان افضل قال : الصبر والسماحة
 قيل : فاي المءمنين اكمل ايمانا قال : احسنهم خلقا
 واخرج البيهقي عن عبد الله بن عبيد بن عمير الليثي عن ابيه عن جده قال : بينا انا عند رسول الله صلي الله عليه وسلم اذا جاءه رجل فقال : يا رسول الله ما الايمان قال : الصبر والسماحة
 قال : فاي الاسلام افضل قال : من سلم المسلمون من لسانه ويده
 قال : فاي الهجرة افضل قال : من هجر السوء
 قال : فاي الجهاد افضل  قال : من اهرق دمه وعقر جواده
 قال : فاي الصدقة احسن افضل قال : جهد المقل
 قال : فاي الصلاة افضل قال : طول القنوت
 واخرج احمد والبيهقي عن عبادة بن الصامت قال : قال رجل يا رسول الله اي العمل افضل قال : الصبر والسماحة
 قال : اريد افضل من ذلك
 قال : لا تتهم الله في شء من قضاءه
 واخرج البيهقي عن الحسن قال : الايمان الصبر والسماحة الصبر عن محارم الله واداء فراءض الله
 واخرج ابن ابي شيبة في كتاب الايمان والبيهقي عن علي قال : الصبر من الايمان بمنزلة الراس من الجسد اذا قطع الراس نتن باقي الجسد ولا ايمان لمن لا صبر له
 واخرج ابن ابي الدنيا والبيهقي عن الحسن
 ان رسول الله صلي الله عليه وسلم قال ادخل نفسك في هموم الدنيا واخرج منها بالصب وليردك عن الناس ما تعلم من نفسك
 واخرج البيهقي عن البراء بن عازب قال : قال رسول الله صلي الله عليه وسلم من قضي نهمته في الدنيا حيل بينه وبين شهوته في الاخرة ومن مد عينيه الي زينة المترفين كان مهينا في ملكوت السماء ومن صبر علي القوت الشديد اسكنه الله الفردوس حيث شاء
 واخرج احمد ومسلم والترمذي وابن ماجه والبيهقي واللفظ له عن ابن عمر عن رسول الله صلي الله عليه وسلم انه قال قد افلح من اسلم وكان رزقه كفافا وصبر علي ذلك
 واخرج البيهقي عن ابي الحويرث ان رسول الله صلي الله عليه وسلم قال طوبي لمن رزقه الله الكفاف وصبر عليه
 واخرج البيهقي عن عسعس ان رسول الله صلي الله عليه وسلم فقد رجلا فسال عنه فجاء فقال : يا رسول الله اني اردت ان اتي هذا الجبل فاخلو فيه واتعبد فقال رسول الله صلي الله عليه وسلم : لصبر احدكم ساعة علي ما يكره في بعض مواطن الاسلام خير من عبادته خاليا اربعين سنة
 واخرج البيهقي من طريق عسعس بن سلامة عن ابي حاضر الاسدي ان رسول الله صلي الله عليه وسلم فقد رجلا فسال عنه فقيل : انه قد تفرد يتعبد
 فبعث اليه فاتي اليه فقال : رسول الله صلي الله عليه وسلم الا ان موطنا من مواطن المسلمين افضل من عبادة الرجل وحده ستين سنة
 قالها ثلاثا
 واخرج البخاري في الادب والترمذي وابن ماجه عن ابن عمر عن النبي صلي الله عليه وسلم  قال المسلم الذي يخالط الناس ويصبر علي اذاهم خير من المسلم الذي لا يخالط الناس ولا يصبر علي اذاهم
 واخرج البيهقي عن ابن عباس قال : قال رسول الله صلي الله عليه وسلم ايكم يسره ان يقيه الله من فيح حهنم ثم قال : الا ان عمل الجنة خزن بربوة ثلاثا الا ان عمل النهار سهل لشهوة ثلاثا والسعيد من وقي الفتن ومن ابتلي فصبر فيا لها ثم يا لها

 واخرج البيهقي وضعفه عن ابن عباس قال : قال رسول الله صلي الله عليه وسلم ما صبر اهل بيت علي جهد ثلاثا الا اتاهم الله برزق
 واخرج الحكيم الترمذي في نوادر الاصول من حديث ابن عمر
