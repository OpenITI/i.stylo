 > قوله تعالي : هو الذي خلق لكم ما في الارض جميعا ثم استوي الي السماء فسواهن سبع سموات وهو بكل شء عليم
 اخرج عبد بن حميد وابن جرير عن قتادة في قوله @QB@ هو الذي خلق لكم ما في الارض جميعا @QE@ قال : سخر لكم ما في الارض جميعا كرامة من الله ونعمة لابن ادم
 متاعا وبلغة ومنفعة الي اجل
 واخرج عبد الرزاق وعبد بن حميد وابن جرير وابن ابي حاتم وابو الشيخ في العظمة عن مجاهد في قوله @QB@ هو الذي خلق لكم ما في الارض جميعا @QE@ قال : سخر لكم ما في الارض جميعا @QB@ ثم استوي الي السماء @QE@ قال : خلق الله الارض قبل السماء فلما خلق الارض ثار منها دخان فذلك قوله @QB@ ثم استوي الي السماء فسواهن سبع سماوات @QE@ يقول : خلق سبع سموات بعضهن فوق بعض وسبع ارضين بعضهن تحت بعض
 واخرج ابن جرير وابن المنذر وابن ابي حاتم والبيهقي في الاسماء والصفات من طريق السدي عن ابي مالك وعن ابي صالح عن ابن عباس وعن مرة الهمداني عن ابن مسعود وعن ناس من اصحاب رسول الله صلي الله عليه وسلم في قوله قوله تعالي : @QB@ هو الذي خلق لكم ما في الارض جميعا ثم استوي الي السماء فسواهن سبع سماوات @QE@ قال : ان الله كان عرشه علي الماء ولم يخلق شيءا قبل الماء فلما اراد ان يخلق اخرج من الماء دخانا فارتفع فوق الماء فسما سماء ثم ايبس الماء فجعله ارضا فتقها واحدة ثم فتقها فجعلها سبع ارضين في يومين
 في الاحد والاثنين فخلق الارض علي حوت وهو الذي ذكره في قوله ( ن والقلم ) والحوت في الماء والماء علي ظهر صفاة والصفاة علي ظهر ملك والملك علي صخرة والصخرة في الريح وهي الصخرة التي ذكرها لقمان
 ليست في السماء ولا في الارض فتحرك الحوت فاضطرب  فتزلزلت الارض فارسي عليها الجبال فالجبال تفخر علي الارض
 فذلك قوله ( وجعل لها رواسي ان تميد بكم ) وخلق الجبال فيها واقوات اهلها وشجرها وما ينبغي لها في يومين : في الثلاثاء والاربعاء وذلك قوله ( انكم لتكفرون بالذي خلق الارض ) الي قوله ( وبارك فيها ) يقول : انبت شجرها وقدر فيها اقواتها يقول لاهلها ( في اربعة ايام سواء للساءلين ) يقول : من سال فهكذا الامر @QB@ ثم استوي الي السماء وهي دخان @QE@ وكان ذلك الدخان من تنفس الماء حين تتنفس ثم جعلها سماء واحدة ثم فتقها فجعلها سبع سموات في يومين : في الخميس والجمعة وانما سمي يوم الجمعة لانه جمع فيه خلق السموات والارض ( واوحي في كل سماء امرها ) قال : خلق في كل سماء خلقها
 من الملاءكة والخلق الذي فيها من البحار وجبال البرد ومما لا يعلم
 ثم زين السماء بالكواكب فجعلها زينة وحفظا من الشياطين فلما فرغ من خلق ما احب استوي علي العرش
 واخرج البيهقي في الاسماء والصفات عن ابن عباس في قوله @QB@ ثم استوي الي السماء @QE@ يعني خلق سبع سموات قال : اجري النار علي الماء فبخر البحر فصعد في الهواء فجعل السموات منها
 واخرج ابن جرير وابن ابي حاتم والبيهقي عن ابي العالية في قوله @QB@ ثم استوي الي السماء @QE@ قال : ارتفع
 وفي قوله @QB@ فسواهن @QE@ قال : سوي خلقهن
 واخرج عثمان بن سعيد الدارمي في كتاب الرد علي الجهمية عن عبد الله بن عمرو قال : لما اراد الله ان يخلق الاشياء اذا كان عرشه علي الماء واذ لا ارض ولا سماء
 خلق الريح فسلطها علي الماء حتي اضطربت امواجه واثار ركامه فاخرج من الماء دخانا وطينا وزبدا فامر الدخان فعلا وسمل ونما فخلق منه السموات وخلق من الطين الارضين وخلق من الزبد الجبال
 واخرج احمد والبخاري في التاريخ ومسلم والنساءي وابن المنذر وابو الشيخ في العظمة وابن مردويه والبيهقي في كتاب الاسماء والصفات عن ابي هريرة قال اخذ النبي صلي الله عليه وسلم بيدي فقال : خلق الله التربة يوم السبت وخلق الجبال يوم الاحد وخلق الشجر يوم الاثنين وخلق المكروه يوم الثلاثاء وخلق النور يوم الاربعاء وبث فيها الدواب يوم الخميس وخلق ادم يوم الجمعة بعد العصر
 واخرج احمد وعبد بن حميد وابو داود والترمذي وحسنه وابن ماجه وعثمان بن  سعيد الدارمي في الرد علي الجهمية وابن ابي الدنيا في كتاب المطر وابن ابي عاصم في السنة وابو يعلي وابن خزيمة في التوحيد وابن ابي حاتم وابو احمد والحاكم في الكني والطبراني في الكبير وابو الشيخ في العظمة والحاكم وصححه واللالكاءي في السنة والبيهقي في الاسماء والصفات عن العباس بن عبد المطلب قال كنا عند النبي صلي الله عليه وسلم فقال : هل تدرون كم بين السماء والارض قلنا : الله ورسوله اعلم قال : بينهما مسيرة خمسماءة عام ومن مسيرة سماء الي سماء مسيرة خمسماءة عام وكثف كل سماء خمسماءة سنة وفوق السماء السابعة بحر
 بين اعلاه واسفله كما بين السماء وارض ثم فوق ذلك ثمانية اوعال بين وركهن واظلافهن كما بين السماء والارض ثم فوق ذلك العرش بين اسفله واعلاه ما بين السماء والارض والله سبحانه وتعالي علمه فوق ذلك وليس يخفي عليه من اعمال بني ادم شء
 واخرج اسحاق بن راهويه فس مسنده والبزار وابو الشيخ في العظمة وابن مردويه والبيهقي عن ابي ذر قال قال رسول الله صلي الله عليه وسلم : ما بين السماء والارض مسيرة خمسماءة عام كذلك الي السماء السابعة
 والارضون مثل ذلك وما بين السماء السابعة الي العرش مثل جميع ذلك ولو حفرتم لصاحبكم ثم دليتموه لوجد الله ثمة يعني علمه
 واخرج الترمذي وابو الشيخ وابن مردويه عن ابي هريرة قال كنا جلوسا مع رسول الله صلي الله عليه وسلم فمرت سحابة فقال : اتدرون ما هذه قالوا : الله ورسوله اعلم فقال : هذه الغبابة هذه روايا الارض يسوقها الله الي بلد لا يعبدونه ولا يشكرونه
 هل تدرون ما فوق ذلك قالوا : الله ورسوله اعلم قال : فان فوق ذلك سماء
 هل تدرون ما فوق ذلك قالوا : الله ورسوله اعلم قال : فان فوق ذلك موجا مكفوفا وسقفا محفوظا
 هل تدروت ما فوق ذلك قالوا : الله ورسوله اعلم قال : فان فوق ذلك سماء
 هل تدرون ما فوق ذلك قالوا : الله ورسوله اعلم قال : فان فوق ذلك سماء اخري
 هل تدرون كم ما بينهما قالوا : الله ورسوله اعلم قال : فان بينهما مسيرة خمسماءة عام حتي عد سبع سموات بين كل سماءين مسيرة خمسماءة عام ثم قال : هل تدرون ما فوق ذلك قالوا : الله ورسوله اعلم قال : فان فوق ذلك العرش
 فهل تدرون كم بينهما قالوا : الله ورسوله اعلم قال : فان بين ذلك كما بين السماءين ثم قال : هل تدرون ما هذه هذه ارض
 هل تدرون ماتحتها  قالوا : الله ورسوله اعلم قال : ارض اخري وبينهما مسيرة خمسماءة عام حتي عد سبع ارضين بين كل ارضين مسيرة خمسماءة عام
 واخرج عثمان بن سعيد الدارمي في الرد علي الجهمية وابن المنذر والطبراني وابو الشيخ وابن مردويه واللالكاءي والبيهقي عن ابن مسعود قال : بين السماء والارض خمسماءة عام وما بين كل سماءين خمسماءة عام ومصير كل سماء  يعني غلظ ذلك  مسيرة خمسماءة عام وما بين السماء الي الكرسي مسيرة خمسماءة عام وما بين الكرسي والماء مسيرة خمسماءة عام
 والعرش علي الماء والله فوق العرش وهو يعلم ما انتم عليه
 واخرج البيهقي عن عبد الله بن عمرو بن العاص انه نظر الي السماء فقال : تبارك الله ما اشد بياضها والثانية اشد بياضها منها ثم كذلك حتي بلغ سبع سموات
 وخلق فوق السابعة الماء وجعل فوق الماء العرش وجعل فوق السماء الدنيا الشمس والقمر والنجوم والرجوم
 واخرج ابن ابي حاتم وابو الشيخ وابن مردويه عن ابن عباس قال قال رجل : يا رسول الله ما هذه السماء قال : هذه موج مكفوف عنكم
 واخرج اسحاق بن راهويه في مسنده وابن المنذر وابن ابي حاتم والطبراني في الاوسط وابو الشيخ عن الربيع بن انس قال : السماء الدنيا موج مكفوف والثانية مرمرة بيضاء والثالثة حديد والرابعة نحاس والخامسة فضة والسادسة ذهب والسابعة ياقوتة حمراء وما فوق ذلك صحاري من نور ولا يعلم ما فوق ذلك الا الله وملك موكل بالحجب يقال له ميطاطروش
 واخرج ابو الشيخ عن سلمان الفارسي قال : السماء الدنيا من زمردة خضراء واسمها رقيعاء والثانية من فضة بيضاء واسمها ازقلون والثالثة من ياقوتة حمراء واسمها قيدوم والرابعة من درة بيضاء واسمها ماعونا والخامسة من ذهبة حمراء واسمها ريقا والسادسة من ياقوتة صفراء واسمها دقناء والسابعة من نور واسمها عريبا
 واخرج ابو الشيخ عن علي بن ابي طالب قال : اسم السماء الدنيا رقيع واسم السابعة الصراخ
 واخرج عثمان ابن سعيد الدارمي في كتاب الرد علي الجهمية وابن المنذر عن ابن عباس قال : سيد السموات السماء التي فيها العرش وسيد الارضين الارض التي انتم عليها
  واخرج ابن ابي حاتم عن الشعبي قال : كتب ابن عباس الي ابي الجلد يساله عن السماء من اي شء هي فكتب اليه : ان السماء من موج مكفوف
 واخرج ابن ابي حاتم عن حبة العوفي قال : سمعت عليا ذات يوم يحلف والذي خلق السماء من دخان وماء
 واخرج ابن ابي حاتم وابو الشيخ عن كعب قال : السماء اشد بياضا من اللبن
 واخرج عبد الرزاق وابن ابي حاتم عن سفيان الثوري قال : تحت الارضين صخرة بلغنا ان تلك الصخرة منها خضرة السماء
 واخرج ابو الشيخ في العظمة والبيهقي في الاسماء والصفات عن ابن عباس قال : تفكروا في كل شء ولا تفكروا في ذات الله فان بين السماء السابعة الي كرسيه سبعة الاف نور
 وهو فوق ذلك
 واخرج عبد الرزاق وابن جرير عن قتادة في قوله @QB@ فسواهن سبع سماوات @QE@ قال : بعضهن فوق بعض بين كل سماءين مسيرة خمسماءة عام
 اما قوله تعالي : @QB@ وهو بكل شء عليم @QE@ اخرج ابن الضريس عن ابن مسعود قال : ان اعدل اية في القران اخرها اسم من اسماء الله تعالي
