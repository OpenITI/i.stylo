 واخرج ابن جرير وابن المنذر وابن ابي حاتم عن ابن عباس رضي الله عنهما في قوله @QB@ وقليل من عبادي الشكور @QE@ يقول : قليل من عبادي الموحدين توحيدهم
  واخرج ابن ابي شيبه وعبد بن حميد وابن المنذر عن ابراهيم التيمي رضي الله عنه قال : قال رجل عند عمر رضي الله عنه : اللهم اجعلني من القليل
 فقال عمر رضي الله عنه : ما هذا الدعاء الذي تدعو به قال : اني سمعت الله يقول @QB@ وقليل من عبادي الشكور @QE@ فانا ادعوا الله ان يجعلني من ذلك القليل فقال عمر رضي الله عنه : كل الناس اعلم من عمر
 < <
  سبا : (  ) فلما قضينا عليه . . . . .
 > > <
 >  قوله تعالي : فلما قضينا عليه بالموت ما دلهم علي موته الا دابة الارض تاكل منساته فلما خر تبينت الجن ان لو كانوا يعلمون الغيب ما لبثوا في العذاب المهين
 اخرج ابن ابي حاتم عن السدي رضي الله عنه قال : كان سليمان عليه السلام يخلو في بيت المقدس السنة والسنتين والشهر والشهرين واقل من ذلك واكثر ويدخل طعامه وشرابه فادخله في المرة التي مات فيها وكان بدء ذلك انه لم يكن يوما يصبح فيه الا نبتت في بيت المقدس شجرة فياتيها فيسالها ما اسمك فتقول : الشجرة اسمي كذا وكذا

 فيقول لها : لاي شء نبت فتقول : نبت لكذا وكذا

 فيامر بها فتقطع
 فان كانت نبتت لغرس غرسها وان كانت نبتت دواء قالت : نبت دواء لكذا وكذا
 فيجعلها لذلك حتي نبتت شجرة يقال لها الخرنوبة قال لها : لاي شء نبت قالت : نبت لخراب هذا المسجد فقال سليمان عليه السلام : ما كان الله ليخربه وانا حي انت الذي علي وجهك هلاكي وخراب بيت المقدس فنزعها فغرسها في حاءط له ثم دخل المحراب فقام يصلي متكءا علي عصا فمات ولا تعلم به الشياطين في ذلك وهم يعملون له مخافة ان يخرج فيعاقبهم
 وكانت الشياطين حول المحراب يجتمعون وكان المحراب له كوا من بين يديه ومن خلفه وكان الشيطان المريد الذي يريد ان يخلع يقول : الست جليدا ان دخلت فخرجت من ذلك الجانب فيدخل حتي يخرج من الجانب  الاخر فدخل شيطان من اولءك فمر ولم يكن شيطان ينظر الي سليمان الا احترق فمر ولم يسمع صوت سليمان ثم رجع فلم يسمع صوته ثم عاد فلم يسمع ثم رجع فوقع في البيت ولم يحترق ونظر الي سليمان قد سقط ميتا فخرج فاخبر الناس : ان سليمان قد مات ففتحوا عنه فاخرجوه فوجدوا منساته  وهي العصا بلسان الحبشة  قد اكلتها الارضة ولم يعلموا منذ كم مات فوضعوا الارضة علي العصا فاكلت منها يوم وليلة ثم حسبوا علي نحو ذلك فوجدوه قد مات منذ سنة
 وهي في قراءة ابن مسعود ( فمكثوا يدينون له من بعد موته حولا كاملا ) فايقن الناس عند ذلك ان الجن كانوا يكذبون ولو انهم علموا الغيب لعلموا بموت سليمان عليه السلام ولما لبثوا في العذاب سنة يعملون له ولو كنت تشربين اتيناك باطيب الشراب ولكننا ننقل اليك الطين والماء فهم ينقلون اليها حيث كانت الم تر الي الطين الذي يكون في جوف الخشب فهو مما ياتيها الشياطين شكرا لها
 واخرج ابن جرير وابن المنذر وابن ابي حاتم عن ابن عباس @QB@ دابة الارض تاكل منساته @QE@ عصاه
 واخرج سعيد بن منصور وعبد بن حميد وابن المنذر وابن ابي حاتم عن ابن عباس قال : لبث سليمان عليه السلام علي عصاه حولا بعدما مات ثم خر علي راس الحول فاخذت الانس عصا مثل عصاه ودابة مثل دابته فارسلوها عليها فاكلتها في سنة
 وكان ابن عباس يقرا ( فلما خر تبينت الانس ان لو كان الجن يعلمون الغيب ما لبثوا في العذاب المهين سنة ) قال سفيان : وفي قراءة ابن مسعود ( وهم يدابون له حولا )
 واخرج البزار وابن جرير وابن المنذر وابن ابي حاتم والطبراني وابن السني في الطب النبوي وابن مردويه عن ابن عباس عن النبي صلي الله عليه وسلم قال : كان سليمان عليه السلام اذا صلي راي شجرة نابتة بين يديه فيقول لها : ما اسمك فتقول : كذا وكذا
 فان كانت لغرس غرست وان كانت لدواء نبتت
 فصلي ذات يوم فاذا شجرة نابتة بين يديه فقال : لها : ما اسمك قالت : الخرنوب
 قال : لاي شء انت قالت : لخراب هذا البيت فقال سليمان عليه السلام : اللهم عم عن الجن موتي  حتي يعلم الانس
 ان الجن لا يعلمون الغيب فاخذ عصا فتوكا عليها وقبضه الله وهو متكء فمكث حينا ميتا والجن تعمل فاكلتها الارضة فسقطت فعلموا عند ذلك بموته فتبينت الانس
 ان الجن لو كانوا يعلمون الغيب ما لبثوا حولا في العذاب المهين
 وكان ابن عباس يقراها كذلك فشكرت الجن الارضة فاينما كانت ياتونها بالماء
 واخرج البزار والحاكم وصححه وابن مردويه عن ابن عباس
 موقوفا
 واخرج الديلمي عن زيد بن ارقم
 مرفوعا
 يقول الله اني تفضلت علي عبادي بثلاث
 القيت الدابة علي الحبة ولولا ذلك لكنزتها الملوك كما يكنزون الذهب والفضة
 والقيت النتن علي الجسد ولولا ذلك لم يدفن حبيب حبيبه واسليت الحزين ولولا ذلك لذهب التسلي
 واخرج عبد بن حميد عن قتادة قال : كانت الجن تخبر الانس انهم يعلمون من الغيب اشياء وانهم يعلمون ما في غد فابتلوا بموت سليمان عليه الصلاة والسلام فمات فلبث سنة علي عصاه وهم لا يشعرون بموته وهم مسخرون تلك السنة ويعملون داءبين @QB@ فلما خر تبينت الجن @QE@ وفي بعض القراءة ( فلما خر تبينت الانس ان لو كان الجن يعلمون الغيب ما لبثوا في العذاب المهين ) وقد لبثوا يدابون ويعملون له حولا بعد موته
 واخرج عبد بن حميد من طريق قيس بن سعد عن ابن عباس رضي الله عنهما قال : كانت الانس تقول في زمن سليمان عليه السلام : ان الجن تعلم الغيب فلما مات سليمان عليه السلام مكث قاءما علي عصاه ميتا حولا والجن تعمل بقيامه ( فلما خر تبينت الانس ان لو كان الجن يعلمون الغيب ما لبثوا في العذاب المهين ) كان ابن عباس رضي الله عنهما كذلك يقراها قال قيس بن سعد رضي الله عنه : وهي قراءة ابي بن كعب رضي الله عنه كذلك
 واخرج ابن ابي حاتم عن ابن زيد رضي الله عنه قال : قال سليمان عليه السلام لملك الموت : اذا امرت بي فاعلمني فاتاه فقال : يا سليمان قد امرت بك قد بقيت لك سويعة فدعا الشياطين فبنوا عليه صرحا من قوارير ليس عليه باب فقام يصلي فاتكا علي عصاه فدخل عليه ملك الموت عليه السلام فقبض  روحه وهو متكء علي عصاه ولم يصنع ذلك فرارا من الموت قال : والجن تعمل بين يديه وينظرون يحسبون انه حي فبعث الله @QB@ دابة الارض @QE@ دابة تاكل العيدان يقال لها : القادح فدخلت فيها فاكلتها حتي اذا اكلت جوف العصا ضعفت وثقل عليها فخر ميتا فلما رات ذلك الجن انفضوا وذهبوا
 فذلك قوله @QB@ ما دلهم علي موته الا دابة الارض تاكل منساته @QE@
 واخرج عبد الرزاق وعبد بن حميد وابن المنذر عن عكرمة رضي الله عنه قال : لما رد الله الخاتم اليه لم يصل صلاة الصبح يوما الا نظر وراءه فاذا هو بشجرة خضراء تهتز فيقول : يا شجرة اما ياكلنك جن ولا انس ولا طير ولا هوام ولا بهاءم فتقول : اني لم اجعل رزقا لشء ولكن دواء من كذا
 ودواء من كذا
 فقام الانس والجن يقطعونها ويجعلونها في الدواء فصلي الصبح ذات يوم والتفت فاذا بشجرة وراءه قال : ما انت يا شجرة قالت : انا الخرنوبة قال : والله ما الخرنوبة الا خراب بيت المقدس والله لا يخرب ما كنت حيا ولكني اموت فدعا بحنوط فتحنط وتكفن ثم جلس علي كرسيه ثم جمع كفيه علي طرف عصاه ثم جعلها تحت ذقنه ومات فمكث الجن سنة يحسبون انه حي وكانت لا ترفع ابصارها اليه وبعث الله الارضة فاكلت طرف العصا فخر منكبا علي وجهه فعلمت الجن انه قد مات
 فذلك قوله @QB@ تبينت الجن @QE@ ولقد كانت الجن تعلم انها لا تعلم الغيب ولكن في القراءة الاولي ( تبينت الانس ان لو كانت الجن يعلمون الغيب ما لبثوا في العذاب المهين )
 واخرج عبد بن حميد وابن المنذر عن ابن عباس رضي الله عنهما قال : بلغت نصف العصا فتركوها في النصف الباقي فاكلتها في حول فقالوا : مات عام اول
 واخرج عبد بن حميد عن ابن مسعود رضي الله عنه قال : مكث سليمان بن داود عليه السلام حولا علي عصاه متكءا حتي اكلتها الارضة فخر
 واخرج الفريابي وعبد بن حميد وابن جرير عن مجاهد رضي الله عنه في قوله @QB@ الا دابة الارض تاكل منساته @QE@ قال : عصاه
 واخرج عبد الرزاق وعبد بن حميد وابن جرير عن قتادة رضي الله عنه قال : الارضة اكلت عصاه حتي خر
  واخرج عبد بن حميد عن سعيد بن جبير رضي الله عنه @QB@ تاكل منساته @QE@ قال : العصا
 واخرج عبد بن حميد وابن المنذر عن عكرمة رضي الله عنه انه سءل عن المنساة قال : هي العصا وانشد فيها شعرا قاله عبد المطلب : امن اجل حبل لا ابالك صدته * بمنساة قد جر حبلك احبلا واخرج ابن جرير عن السدي رضي الله عنه قال : المنساة العصا بلسان الحبشة
 < <
  سبا : (    ) لقد كان لسبا . . . . .
 > > <
 >  قوله تعالي : لقد كان لسبا في مساكنهم اية جنتان عن يمين وشمال كلوا من رزق ربكم واشكروا له بلدة طيبة ورب غفور * فاعرضوا فارسلنا عليهم سيل العرم وبدلناهم بجنتيهم جنتين ذواتي اكل خمط واثل وشء من سدر قليل * ذلك جزيناهم بما كفروا وهل نجازي الا الكفور * وجعلنا بينهم وبين القري التي باركنا فيها قري ظاهرة وقدرنا فيها السير سيروا فيها ليالي واياما امنين * فقالوا ربنا باعد بين اسفارنا وظلموا انفسهمفجعلناهم احاديث ومزقناهم كل ممزق ان في ذلك لايات لكل صبار شكور
 اخرج احمد وعبد بن حميد والبخاري في تاريخه والترمذي وحسنه وابن المنذر والحاكم وصححه وابن مردويه عن فروة بن مسيك المرادي رضي الله عنه قال : اتيت النبي صلي الله عليه وسلم فقلت : يا رسول الله الا اقاتل من ادبر من قومي بمن اقبل منهم فاذن لي في قتالهم وامرني فلما خرجت من عنده ارسل في اثري فردني فقال ادع القوم فمن اسلم منهم فاقبل منه ومن لم يسلم فلا تعجل حتي احدث اليك وانزل في سبا ما انزل فقال رجل : يا رسول الله وما سبا ارض ام امراة قال : ليس بارض ولا امراة ولكنه رجل ولد عشرة من العرب فتيامن منهم  ستة وتشاءم منهم اربعة فاما الذين تشاءموا فلخم وجذام وغسان وعاملة
 واما الذين تيامنوا فالازد والاشعريون وحمير وكندة ومذحج وانمار
 فقال رجل : يا رسول الله وما انمار قال : الذين منهم خثعم وبجيلة
 واخرج احمد وعبد بن حميد والطبراني وابن ابي حاتم وابن عدي والحاكم وصححه وابن مردويه عن ابن عباس رضي الله عنهما ان رجلا سال النبي صلي الله عليه وسلم عن سبا ارجل هو او امراة ام ارض فقال : بل هو رجل ولد عشرة فسكن اليمن منهم ستة وبالشام منهم اربعة فاما اليمانيون فمذحج وكندة والازد والاشعريون وانمار وحمير
 واما الشاميون فلخم وجذام وعاملة وغسان
 واخرج الحاكم عن ابن عمر رضي الله عنهما ان رسول الله صلي الله عليه وسلم قرا @QB@ لقد كان لسبا في مسكنهم @QE@
 واخرج عبد بن حميد عن عاصم رضي الله عنه انه قرا ( لقد كان لسبا ) بالخفض منونة مهموزة ( في مساكنهم ) علي الجماع بالالف
 واخرج الفريابي عن يحيي بن وثاب انه يقراها @QB@ لقد كان لسبا في مسكنهم @QE@
 واخرج عبد بن حميد عن قتادة رضي الله عنه قال : كان لسا جنتان بين جبلين فكانت المراة تمر ومكتلها علي راسها فتمشي بين جبلين فتمتلء فاكهة وما مسته بيدها فلما طغوا بعث الله عليهم دابة يقال لها : الجرذ فنقب عليهم فغرقهم فما بقي منهم الا اثل وشء من سدر قليل
 واخرج ابن ابي حاتم عن ابن زيد رضي الله عنه في قوله @QB@ لقد كان لسبا في مسكنهم @QE@
 قال لم يكن يري في قريتهم بعوضة قط ولا ذباب ولا برغوث ولا عقرب ولا حية وان الركب لياتون في ثيابهم القمل والدواب فما هو الا ان ينظروا الي بيوتها فتموت تلك الدواب وان كان الانسان ليدخل الجنتين فيمسك القفة علي راسه ويخرج حين يخرج وقد امتلات تلك القفة من انواع الفاكهة ولم يتناول منها شيءا بيده
 واخرج عبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم عن قتادة رضي الله عنه في قوله @QB@ بلدة طيبة ورب غفور @QE@ قال : هذه البلد طيبة وربكم غفور لذنوبكم
 وفي قوله @QB@ فاعرضوا @QE@ قال : بطر القوم امر الله وكفروا نعمته
  واخرج ابن ابي حاتم عن السدي رضي الله عنه قال : كان اهل سبا اعطوا ما لم يعطه احد من اهل زمانهم فكانت المراة تخرج علي راسها المكتل فتريد حاجتها فلا تبلغ مكانها الذي تريد حتي يمتلء مكتلها من انواع الفاكهة فاجمعوا ذلك فكذبوا رسلهم وقد كان السيل ياتيهم من مسيرة عشرة ايام حتي يستقر في واديهم فيجمع الماء من تلك السيول والجبال في ذلك الوادي وكانوا قد حفروه بمسناة  وهم يسمون المسناة العرم  وكانوا يفتحون اذا شاءا من ذلك الماء فيسقون جنانهم اذا شاءوا فلما غضب الله عليهم واذن في هلاكهم دخل رجل الي جنته  وهو عمرو بن عامر فيما بلغنا وكان كاهنا  فنظر الي جرذة تنقل اولادها من بطن الوادي الي اعلي الجبل فقال : ما نقلت هذه اولادها من ههنا الا وقد حضر اهل هذه البلاد عذاب ويقدر انها خرقت ذلك العرم فنقبت نقبا فسال ذلك النقب ماء الي جنته فامر عمرو بن عامر بذلك النقب فسد فاصبح وقد انفجر باعظم ما كان فامر به ايضا فسد ثم انفجر باعظم ما كان فلما راي ذلك دعا ابن اخيه فقال : اذا انا جلست العشية في نادي قومي فاءتني فقل : علام تحبس علي مالي فاني ساقول ليس لك عندي مال ولا ترك ابوك شيءا وانك لكاذب
 فاذا انا كذبتك فكذبني واردد علي مثل ما قلت لك فاذا فعلت ذلك فاني ساشتمك فاشتمني
 فاذا انت شتمتني لطمتك فاذا انا لطمتك فقم فالطمني
 قال : ما كنت لاستقبلك بذلك يا عم قال : بلي
 فافعل فاني اريد بها صلاحك وصلاح اهل بيتك فقال الفتي فلطمه فقال الشيخ : يا معشر بني فلان الطم فيكم لا سكنت في بلد لطمني فيه فلان ابدا من يبتاع مني
 فلما عرف القوم منه الجد اعطوه فنظر الي افضلهم عطية فاوجب له البيع فدعا بالمال فنقده وتحمل هو وبنوه من ليلته فتفرقوا
 واخرج ابن المنذر وابن ابي حاتم عن عكرمة رضي الله عنه قال : كان في سبا كهنة وكانت الشياطين يسترقون السمع فاخبروا الكهنة بشء من اخبار السماء وكان فيهم رجل كاهن شريف كثير المال انه اخبر ان زوال امرهم قد دنا وان العذاب قد اظلهم فلم يدر كيف يصنع لانه كان له مال كثير من عقر فقال لرجل  من بنيه وهو اعزهم اخوالا : اذا كان غدا وامرتك بامر فلا تفعله فاذا نهرتك فانتهرني فاذا تناولتك فالطمني قال : يا ابت لا تفعل ان هذا امر عظيم وامر شديد قال : يا بني قد حدث امر لا بد منه فلم يزل حتي هياه علي ذلك فلما اصبحوا واجتمع الناس قال : يا بني افعل كذا وكذا
 فابي فانتهره ابوه فاجابه فلم يزل ذلك بينهما حتي تناوله ابوه فوثب علي ابيه فلطمه فقال : ابني يلطمني علي بالشفرة قالوا : وما تصنع بالشفرة قال : اذبحه قالوا : تذبح ابنك الطمه واصنع ما بدا لك فابي الا ان يذبحه فارسلوا الي اخواله فاعلموهم بذلك فجاء اخواله فقالوا : خذ منا ما بدا لك فابي الا ان يذبحه قالوا : فلتموتن قبل ان تدعوه قال : اشتروا مني دوري اشتروا مني ارضي فلم يزل حتي باع دوره وارضه وعقاره
 فلما صار الثمن في يده واحرزه قال : اي قوم ان العذاب قد اظلكم وزوال امركم قد دنا فمن اراد منكم دارا جديدا وجملا شديدا وسفرا فليلحق بعمان ومن اراد منكم الخمر والخمير والعصير فليلحق ببصري
 ومن اراد منكم الراسخات في الوحل المطعمات في المحل المقيمات في الضحل فليلحق بيثرب ذات نخل فاطاعه قوم فخرج اهل عمان الي عمان وخرجت غسان الي بصري وخرجت الاوس والخزرج وبنو كعب بن عمرو الي يثرب فلما كانوا ببطن نخل قال بنو كعب : هذا مكان صالح لا نبتغي به بدلا فاقاموا فلذلك سموا خزاعة لانهم انخزعوا عن اصحابهم واقبلت الاوس والخزرج حتي نزلوا بيثرب
 واخرج ابن المنذر عن عكرمة رضي الله عنه في قوله @QB@ لقد كان لسبا @QE@
 قال : كان لهم مجلس مشيد بالمرمر فاتاهم ناس من النصاري فقالوا : اشكروا الله الذي اعطاكم هذا قالوا : ومن اعطاناه انما كان لاباءنا فورثناه فسمع ذلك ذو يزن فعرف انه سيكون لكلمتهم تلك خبر فقال لابنه : كلامك علي حرام ذلك ذو يزن فعرف انه سيكون لكلمتهم تلك خبر فقال لابنه : كلامك علي حرام ان لم تات غدا وانا في مجلس قومي فتصك وجهي ففعل ذلك فقال : لا اقيم بارض فعل هذا ابني بي فيها الا من بيتاع مني مالي فابتدره الناس فابتاعوه  فبعث الله جرذا اعمي يقال له الخلد من جرذان عمي فلم يزل يحفر السد حتي خرقه فانهدم وذهب الماء بالجنتين
 واخرج ابن جرير وابن ابي حاتم عن وهب بن منبه رضي الله عنه قال : لقد بعث الله الي سبا ثلاثة عشر نبيا فكذبوهم وكان لهم سد كانوا قد بنوه بنيانا ابدا وهو الذي كان يرد عنهم السيل اذا جاء ان يغشي اموالهم وكان فيما يزعمون في علمهم من كهانتهم انه انما يخرب سدهم ذلك فارة فلم يتركوا فرجة بين حجرين الا ربطو عندها هرة فلما جاء زمانه وما اراد الله بهم من التفريق اقبلت فيما يذكرون فارة حمراء الي هرة من تلك الهرر فساورنها حتي استاخرت عنها الهرة فدخلت في الفرجة التي كانت عندها فتغلغلت بالسد فحفرت فيه حتي رققته للسيل وهم لا يدرون فلما ان جاء السيل وجد عللا فدخل فيه حتي قلع السد وفاض علي الاموال فاحتملها فلم يبق منها الا ما ذكر عن الله تبارك وتعالي
 واخرج ابن جرير وابن المنذر عن الضحاك رضي الله عنه في الاية قال : كانت اودية اليمن تسيل الي وادي سبا وهو واد بين جبلين فعمد اهل سبا فسدوا ما بين الجبلين بالقير والحجارة وتركوا ما شاءوا لجناتهم فعاشوا بذلك زمانا من الدهر ثم انهم عتوا وعملوا بالمعاصي فبعث الله علي ذلك السد جرذا فنقبه عليهم فعرض الله مساكنهم وجناتهم وبدلهم بمكان جنتهم جنتين خمط والخمط الاراك واءل الاثل القصير من الشجر الذي يصنعون منه الاقداح
 واخرج ابن جرير وابن المنذر وابن ابي حاتم عن ابن عباس رضي الله عنهما في قوله @QB@ سيل العرم @QE@ قال : الشديد
 واخرج سعيد بن منصور وعبد بن حميد وابن جرير وابن المنذر عن عمرو بن شرحبيل رضي الله عنه @QB@ سيل العرم @QE@ قال : المنساة بلحن اليمن
 واخرج ابن ابي حاتم عن مجاهد رضي الله عنه في قوله @QB@ سيل العرم @QE@ قال : @QB@ العرم @QE@ بالحبشة وهي المنساة التي يجتمع فيها الماء ثم ينشف
 واخرج ابن ابي حاتم عن عطاء رضي الله عنه قال @QB@ العرم @QE@ اسم الوادي
 واخرج ابن جرير عن ابن عباس رضي الله عنهما @QB@ سيل العرم @QE@ قال : واد كان باليمن كان يسيل الي مكة
  واخرج ابن جرير عن الضحاك رضي الله عنه قال : وادي سبا يدعي @QB@ العرم @QE@
 واخرج الفريابي وعبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم عن مجاهد رضي الله عنه في قوله @QB@ سيل العرم @QE@ السد ماء احمر ارسله الله في السد فشقه وهمه وحفر الوادي عن الجنتين فارتفعا وغار عنهما الماء فيبستا ولم يكن الماء الاحمر من السد كان شيءا ارسله الله عليهم
 وفي قوله @QB@ اكل خمط @QE@ قال : الخمط الاراك
 واخرج ابن جرير وابن المنذر وابن ابي حاتم عن ابن عباس ارسله الله عليهم
 وفي قوله ( اكل خمط ) قال : ( الخمط ) الاراك
 واخرج ابن جرير وابن المنذر وابن ابي حاتم عن ابن عباس رضي الله عنهما في قوله @QB@ اكل خمط @QE@ قال : الاراك @QB@ واثل @QE@ قال : الطرفاء
 واخرج الطستي عن ابن عباس رضي الله عنهما ان نافع بن الازرق قال له : اخبرني عن قوله @QB@ اكل خمط @QE@ قال : الاراك قال : وهل تعرف العرب ذلك قال : نعم
 اما سمعت الشاعر يقول : ما معول فود تراعي بعينها * اغن غضيض الطرف من خلل الخمط واخرج ابن ابي حاتم عن عمرو بن شرحبيل رضي الله عنه في قوله @QB@ واثل @QE@ قال الاثل شجر لا ياكلها شء وانما هي حطب
 واخرج ابن ابي حاتم عن السدي في الاية قال الخمط الاراك و الاثل النضار و السدر النبق
 واخرج عبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم عن قتادة في قوله @QB@ لقد كان لسبا في مسكنهم @QE@
 قال : قوم اعطاهم الله نعمة وامرهم بطاعته ونهاهم عن معصيته قال الله @QB@ فاعرضوا @QE@ قال : ترك القوم امر الله @QB@ فارسلنا عليهم سيل العرم @QE@ ذكر لنا @QB@ العرم @QE@ وادي سبا كانت تجتمع اليه مسايل من اودية شتي فعمدوا فسدوا ما بين الجبلين بالقير والحجارة وجعلوا عليه ابوابا وكانوا ياخذون من ماءة ما احتاجوا اليه ويسدون عنهم ما لم يعبءا به من ماءة فلما تركوا امر الله بعث الله عليهم جرذا فنقبه من اسفله فاتسع حتي غرق الله به حروثهم وخرب به اراضيهم عقوبة باعمالهم قال الله @QB@ وبدلناهم بجنتيهم جنتين ذواتي اكل خمط @QE@  والخمط الاراك و @QB@ اكل @QE@ بربرة و @QB@ واثل وشء من سدر قليل @QE@ بينما شجر القوم من خير الشجر اذ صيره الله من شر الشجر عقوبة باعمالهم قال الله @QB@ ذلك جزيناهم بما كفروا وهل نجازي الا الكفور @QE@ ان الله اذا اراد بعبد كرامة او خيرا تقبل حسناته واذا اراد بعبد هوانا امسك عليه بذنبه
 واخرج عبد بن حميد عن عكرمة رضي الله عنه قال : الخمط هو الاراك
 واخرج عبد بن حميد عن الحسن وابي مالك
 مثله
 واخرج ابن المنذر عن ابن عباس في قوله @QB@ وهل نجازي الا الكفور @QE@ قال : تلك المناقشة
 واخرج عبد الرزاق وعبد بن حميد وابن المنذر وابن ابي حاتم عن طاوس @QB@ وهل نجازي الا الكفور @QE@ قال : هو المناقشة في الحساب ومن نوقش الحساب عذب وهو الكافر لا يغفر له
 واخرج الفريابي وعبد بن حميد وابن المنذر وابن ابي حاتم عن ابي حيوة وكان من اصحاب علي قال : جزاء المعصية الوهن في العبادة والضيق في المعيشة والمنغص في اللذة قيل : وما المنغص قال : لا يصادف لذة حلال الا جاءه من ينغصه اياها
 واخرج ابن جرير عن مجاهد @QB@ القري التي باركنا فيها @QE@ قال : الشام
 واخرج عبد الرزاق وعبد بن حميد وابن جرير عن قتادة @QB@ وجعلنا بينهم وبين القري التي باركنا فيها @QE@ قال : هي قري الشام
 واخرج عبد الرزاق وعبد بن حميد عن سعيد بن جبير
 مثله
 واخرج عبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم عن الحسن في قوله @QB@ وجعلنا بينهم وبين القري التي باركنا فيها قري ظاهرة @QE@ قال : كان فيما بين اليمن الي الشام قري متواصلة و @QB@ القري التي باركنا فيها @QE@ الشام
 كان الرجل يغدو فيقبل في القرية ثم يروح فيبيت في القرية الاخري وكانت المراة تخرج وزنبيلها علي راسها فما تبلغ حتي يمتلء من كل الثمار
 واخرج سعيد بن منصور وعبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم عن ابن ابي ملكية في قوله @QB@ وجعلنا بينهم وبين القري التي باركنا فيها قري ظاهرة @QE@  قال : كانت قراهم متصلة ينظر بعضهم الي بعض وثمرهم متدل فبطروا
 واخرج ابن المنذر عن الضحاك في قوله @QB@ وقدرنا فيها السير @QE@ قال : دانينا فيها السير
 واخرج اسحاق بن بشر وابن عساكر عن ابن عباس في قوله @QB@ وجعلنا بينهم @QE@ يعني بين مساكنهم @QB@ وبين القري التي باركنا فيها @QE@ يعني الارض المقدسة @QB@ قري @QE@ فيما بين منازلهم مساكنهم وبين ارض الشام @QB@ سيروا فيها @QE@ يعني اذا ظعنوا من منازلهم الي ارض الشام من الارض المقدسة
 واخرج ابن عساكر عن زيد بن اسلم في قوله @QB@ ظاهرة @QE@ قال : قري بالشام
 واخرج عبد الرزاق وعبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم عن قتادة رضي الله عنه في قوله @QB@ سيروا فيها ليالي واياما امنين @QE@ قال : لا يخافون جوعا ولا ظما انما يغدون فيقيلون في قرية ويروحون فيبيتون في قرية اهل جنة ونهر حتي ذكر لنا : ان المراة كانت تضع مكتلها علي راسها فيمتلء قبل ان ترجع الي اهلها وكان الرجل يسافر لا يحمل معه زادا فبطروا النعمة @QB@ فقالوا ربنا باعد بين اسفارنا @QE@ فمزقوا @QB@ كل ممزق @QE@ وجعلوا احاديث
 واخرج ابن المنذر عن الضحاك في قوله @QB@ فقالوا ربنا باعد بين اسفارنا @QE@ قال : قالوا يا ليت هذه القري يبعد بعضها عن بعض فنسير علي نجاءبنا
 واخرج ابن ابي حاتم عن يحيي بن يعمر رضي الله عنه انه قرا ( قالوا ربنا بعد بين اسفارنا ) مثقلة قال : لم يدعوا علي انفسهم ولكن شكوا ما اصابهم
 واخرج عبد بن حميد عن الكلبي رضي الله عنه انه قرا ( قالوا ربنا بعد بين اسفارنا ) مثقلة علي معني فعل
 واخرج عبد بن حميد عن سعيد بن ابي الحسن رضي الله عنه انه قرا ( بعد بين اسفارنا ) بنصب الباء ورفع العين
 واخرج عبد بن حميد عن عاصم رضي الله عنه انه قرا ( ربنا ) بالنصب ( باعد ) بنصب الباء وكسر العين علي الدعاء
 واخرج عبد بن حميد وابن المنذر وابن ابي حاتم عن الشعبي رضي الله عنه في  قوله @QB@ ومزقناهم كل ممزق @QE@ قال : اما غسان فلحقوا بالشام واما الانصار فلحقوا بيثرب واما خزاعة فلحقوا بتهامة واما الازد فلحقوا بعمان
 فمزقهم الله كل ممزق
 واخرج عبد بن حميد وابن جرير وابن ابي حاتم عن قتادة رضي الله عنه في قوله @QB@ ان في ذلك لايات لكل صبار شكور @QE@ قال : مطرف في قوله @QB@ ان في ذلك لايات @QE@ نعم العبد الصبار الشكور الذي اذا اعطي شكر واذا ابتلي صبر
 واخرج ابن ابي الدنيا وابن جرير والبيهقي في شعب الايمان عن عامر رضي الله عنه قال : الشكر نصف الايمان والصبر نصف الايمان واليقين الايمان كله
 واخرج البيهقي عن ابي الدرداء قال : سمعت ابا القاسم صلي الله عليه وسلم يقول : ان الله قال : يا عيسي بن مريم اني باعث بعدك امة ان اصابهم ما يحبون حمدوا وشكروا وان اصابهم ما يكرهون احتسبوا وصبروا ولا حلم ولا علم
 قال : يا رب كيف يكون هذا لهم ولا حلم ولا علم قال : اعطيهم من حلمي وعلمي
 واخرج احمد ومسلم والبيهقي في شعب الايمان والدارمي وابن حبان عن صهيب قال : قال رسول الله صلي الله عليه وسلم : عجبا لامر المءمن امر المءمن كله خير ان اصابته سراء شكر كان خيرا وان اصابته ضراء صبر كان خيرا
 واخرج احمد والبيهقي عن سعد بن ابي وقاص قال : قال رسول الله صلي الله عليه وسلم : عجبت للمءمن ان اعطي قال الحمد لله فشكر وان ابتلي قال الحمد لله فصبر فالمءمن يءجر علي كل حال حتي اللقمة يرفعها الي فيه
 واخرج البيهقي في الشعب وابو نعيم عن انس رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم من نظر في الدين الي من هو فوقه وفي الدنيا الي من هو تحته كتبه الله صابرا وشاكرا ومن نظر في الدين الي من هو تحته ونظر في الدنيا الي من هو فوقه لم يكتبه الله صابرا ولا شاكرا والله سبحانه وتعالي اعلم
