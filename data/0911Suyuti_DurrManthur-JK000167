 اخرج الطبراني وابن مردويه عن ابن عباس رضي الله عنهما عن النبي صلي الله عليه وسلم : لا تسبوا تبعا فانه قد اسلم
 واخرج احمد والطبراني وابن ابي حاتم وابن مردويه عن سهل بن سعد الساعدي رضي الله عنه قال : قال رسول الله صلي الله عليه وسلم : لا تسبوا تبعا فانه كان قد اسلم
 واخرج ابن عساكر عن ابن عباس رضي الله عنهما قال : لا يشتبهن عليكم امر تبع فانه كان مسلما
 واخرج ابن مردويه عن ابن عباس رضي الله عنهما قال : لا تقولوا لتبع الا خيرا فانه قد حج البيت وامن بما جاء به عيسي بن مريم
 واخرج عبد بن حميد وابن جرير عن كعب رضي الله عنه قال : لا تقولوا لتبع الا خيرا فانه قد حج البيت وامن بما جاء به عيسي بن مريم
 واخرج عبد بن حميد وابن جرير عن كعب رضي الله عنه قال : ان تبعا نعت الرجل الصالح ذم الله قومه ولم يذمه
 قال : وكانت عاءشة رضي الله عنها تقول : لا تسبوا تبعا فانه كان رجلا صالحا
 واخرج الحاكم وصححه عن عاءشة رضي الله عنها قالت : كان تبع رجلا صالحا الا تري ان الله ذم قومه ولم يذمه واخرج ابن عساكر عن عطاء بن ابي رباح رضي الله عنه قال : لا تسبوا تبعا فان رسول الله صلي الله عليه وسلم نهي عن سبه
 واخرج ابن المنذر وابن عساكر عن وهب بن منبه قال : نهي رسول الله صلي الله عليه وسلم عن سب اسعد وهو تبع
 قيل : وما كان اسعد قال : كان علي دين ابراهييم وكان ابراهيم يصلي كل يوم صلاة ولم تكن شريعة
 واخرج ابن مردويه عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : لا تسبوا اسعد الحميري وقال : هو اول من كسا الكعبة
 واخرج ابن المنذر وابن عساكر عن سعيد بن جبير قال : ان تبعا كسا البيت
 واخرج ابن عساكر عن سعيد بن عبد العزيز قال : كان تبع اذا عرض الخيل قاموا صفا من دمشق الي صنعاء اليمن
 واخرج ابن المنذر وابن عساكر عن ابن عباس قال : سالت كعبا عن تبع فاني اسمع الله يذكر في القران قوم تبع ولا يذكر تبعا فقال : ان تبعا كان رجلا من اهل اليمن ملكا منصورا فسار بالجيوش حتي انتهي الي سمرقند رجع فاخذ طريق  الشام فاسر بها احبارا فانطلق بهم نحو اليمن  حتي اذا دنا من ملكه طار في الناس انه هادم الكعبة فقال له الاحبار : ما هذا الذي تحدث به نفسك فان هذا البيت لله وانك لن تسلط عليه فقال : ان هذا لله وانا احق من حرمه فاسلم من مكانه واحرم فدخلها محرما فقضي نسكه ثم انصرف نحو اليمن راجعا حتي قدم علي قومه فدخل عليه اشرافهم فقالوا : يا تبع انت سيدنا وابن سيدنا خرجت من عندنا علي دين وجءت علي غيره فاختر منا احد امرين اما ان تخلينا وملكنا وتعبد ما شءت واما ان تذر دينك الذي احدثت  وبينهم يومءذ نار تنزل من السماء  فقال الاحبار عند ذلك : اجعل بينك وبينهم النار فتواعد القوم عند ذلك جميعا علي ان يجعلوا بينهم النار فجء بالاحبار وكتبهم وجء بالاصنام وعمارها وقدموا جميعا الي النار وقامت الرجال خلفهم بالسيوف فهدرت النار هدير الرعد ورمت شعاعا لها فنكص اصحاب الاصنام واقبلت النار فاحرقت الاصنام وعمالها وسلم الاخرون فاسلم قوم واستسلم قوم فلبثوا بعد ذلك عمر تبع حتي اذا نزل بتبع الموت استخلف اخاه وهلك فقتلوا اخاه وكفروا صفقة واحدة
 واخرج ابن سعد وابن عساكر عن ابي بن كعب قال : لما قدم تبع المدينة ونزل بفناه بعث الي احبار يهود فقال : اني مخرب هذا البلد حتي لا تقوم به يهودية ويرجع الامر الي دين العرب
 فقال له شابور اليهودي :  وهو يومءذ اعلمهم  ايها الملك ان هذا بلد يكون اليه مهاجر نبي من بني اسماعيل مولده بمكة اسمه احمد وهذه دار هجرته ان منزلك هذا الذي نزلت به يكون من القتال والجراح امر كثير في اصحابه وفي عدوهم
 قال تبع : ومن يقاتله يومءذ وهو نبي كما تزعم قال : يسير اليه قومه فيقتتلون ههنا
 قال : فاين قبره قال : بهذا البلد
 قال : فاذا قوتل لمن تكون الدبرة قال : تكون عليه مرة وله مرة وبهذا المكان الذي انت به يكون عليه ويقتل به اصحابه مقتلة عظيمة لم تقتل في موطن ثم تكون العاقبة له ويظهر فلا ينازعه هذا الامر احد
 قال : وما صفته قال : رجل ليس بالقصير ولا بالطويل في عينيه حمرة يركب البعير ويلبس الشملة سيفه علي عاتقه ولا يبالي من لاقي حتي يظهر امره
 فقال تبع : ما الي هذا البلد من سبيل وما كان ليكون خرابها علي يدي فرجع تبع منصرفا الي اليمن
 واخرج ابن عساكر عن عباد بن زياد المري عمن ادرك [ ] قال : اقبل تبع يفتتح  المداءن ويعمل العرب حتي نزل المدينة واهلها يومءذ يهود فظهر علي اهلها وجمع احبار اليهود فاخبروه انه سيخرج نبي بمكة يكون قراره بهذا البلد اسمه احمد واخبروه انه لا يدركه فقال تبع للاوس والخزرج : اقيموا بهذا البلد فان خرج فيكم فازروه وصدقوه وان لم يخرج فاوصوا بذلك اولادكم وقال في شعره : حدثت ان رسول المليك * يخرج حقا بارض الحرم ولو مد دهري الي دهره * لكنت وزيرا له وابن عم واخرج ابو نعيم في الدلاءل عن عبد الله بن سلام قال : لم يمت تبع حتي صدق بالنبي صلي الله عليه وسلم لما كان يهود يثرب يخبرونه
 واخرج ابن عساكر عن ابن اسحق قال : اري تبع في منامه ان يكسو البيت فكساه الخصف ثم اري ان يكسوه احسن من ذلك فكساه العافر ثم اري ان يكسوه احسن من ذلك فكساه الوصاءل وصاءل اليمن فكان تبع فيما ذكر لي اول من كساه واوصي بها ولاته من جرهم وامر بتطهيره وجعل له بابا ومفتاحا
 واخرج عبد بن حميد ابن جرير عن قتادة @QB@ ان يوم الفصل ميقاتهم اجمعين @QE@ قال يوم يفصل بين الناس باعمالهم يوفي فيه للاولين والاخرين @QB@ يوم لا يغني مولي عن مولي شيءا @QE@ قال : انقطعت الاسباب يومءذ وذهبت الاصار وصار الناس الي اعمالهم فمن اصاب يومءذ خيرا سعد به ومن اصاب يومءذ شرا شقي به
