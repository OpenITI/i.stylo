 اخرج ابن جرير عن مجاهد قال : تلوت هذه الاية علي عبد الله بن عمر فقال : اتدري يا مجاهد من الذي اشار بتحريق ابراهيم بالنار قلت : لا
 قال : رجل من اعراب فارس يعني الاكراد
 واخرج ابن ابي حاتم عن ابن عباس قال : لما جمع لابراهيم عليه السلام ما جمع والقي في النار جعل خازن المطر يقول : متي اومر بالمطر فارسله فكان امر الله اسرع قال الله : @QB@ كوني بردا وسلاما @QE@ فلم يبق في الارض نار الا طفءت
 واخرج احمد والطبراني وابو يعلي وابن ابي حاتم عن عاءشة ان رسول الله صلي الله عليه وسلم قال : ان ابراهيم حين القي في النار لم تكن في الارض دابة الا تطفء عنه النار غير الوزغ فانه كان ينفخ علي ابراهيم فامر رسول الله صلي الله عليه وسلم بقتله
  واخرج ابن مردويه عن ام شريك ان النبي صلي الله عليه وسلم امر بقتل الاوزاغ وقال : كانت تنفخ علي ابراهيم صلي الله عليه وسلم
 واخرج عبد الرزاق في المصنف اخبرنا معمر عن قتادة عن بعضهم عن النبي صلي الله عليه وسلم قال : كانت الضفدع تطفء النار عن ابراهيم وكانت الوزغ تنفخ عليه ونهي عن قتل هذا وامر بقتل هذا
 واخرجه ابن المنذر فقال : اخبرنا ابو سعيد الشامي عن ابان عن انس قال : قال رسول الله صلي الله عليه وسلم : لا تسبوا الضفدع فانه صوته تسبيح وتقديس وتكبير ان البهاءم استاذنت ربها في ان تطفء النار عن ابراهيم فاذن للضفادع فتراكبت عليه فابدلها الله بحر النار برد الماء
 واخرج ابو يعلي وابو نعيم وابن مردويه والخطيب عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : لما القي ابراهيم في النار قال : اللهم انك في السماء واحد وانا في الارض واحد اعبدك
 واخرج ابن ابي شيبة في المصنف وابن المنذر عن ابن عمرو قال : اول كلمة قالها ابراهيم حين القي في النار حسبنا الله ونعم الوكيل
 واخرج ابن ابي شيبة وابن جرير وابن المنذر عن كعب قال : ما احرقت النار من ابراهيم الا وثاقه
 واخرج ابن جرير وابن ابي حاتم عن المنهال بن عمرو قال : اخبرت ان ابراهيم القي في النار فكان فيها اما خمسين واما اربعين قال : ما كنت اياما وليالي قط اطيب عيشا اذ كنت فيها وددت ان عيشي وحياتي كلها مثل عيشي اذ كنت فيها
 واخرج ابن جرير عن سعيد بن جبير قال : لما القي ابراهيم خليل الرحمن في النار قال الملك خازن المطر : يا رب ان خليلك ابراهيم رجا ان يءذن له فيرسل المطر فكان امر الله اسرع من ذلك فقال : @QB@ يا نار كوني بردا وسلاما علي ابراهيم @QE@ فلم يبق في الارض نار الا طفءت
 واخرج ابن جرير وابن ابي حاتم عن شعيب الجباءي قال : الذي قال حرقوه هبون
 فخسف الله به الارض فهو يتجلجل فيها الي يوم القيامة
 واخرج ابن جرير وابن ابي حاتم عن السدي في قوله : @QB@ قلنا يا نار @QE@ قال : كان جبريل هو الذي قالها
  واخرج الفريابي وعبد بن حميد وابن جرير وابن ابي حاتم عن ابن عباس قال : لو لم يتبع بردها @QB@ سلاما @QE@ لمات ابراهيم من بردها فلم يبق في الارض يومءذ نار الا طفءت ظننت انها هي تعني
 واخرج الفريابي وابن ابي شيبة واحمد في الزهد وعبد بن حميد وابن المنذر عن علي في قوله : @QB@ قلنا يا نار كوني بردا وسلاما @QE@ قال : لولا انه قال : @QB@ وسلاما @QE@ لقتله بردها
 واخرج ابن ابي حاتم عن شمر بن عطية قال : لما ارادوا ان يلقوا ابراهيم في النار نادي الملك الذي يرسل المطر : رب خليلك رجا ان يءذن له فيرسل المطر فقال الله : @QB@ يا نار كوني بردا وسلاما علي ابراهيم @QE@ فلم يبق في الارض يومءذ نار الا بردت
 واخرج احمد في الزهد وعبد بن حميد من طريق ابي هلال عن بكر بن عبد الله المزني قال : لما ارادوا ان يلقوا ابراهيم في النار جاءت عامة الخليقة فقالت : يا رب خليلك يلقي في النار فاءذن لنا نطفء عنه
 قال : هو خليلي ليس لي في الارض خليل غيره وانا الهه ليس له اله غيري فان استغاثكم فاغيثوه والا فدعوه قال : وجاء ملك القطر قال : يا رب خليلك يلقي في النار فاءذن لي ان اطفء عنه بالقطر
 قال : هو خليلي ليس لي في الارض خليل غيره وانا الهه ليس له اله غيري فان استعان بك فاعنه والا فدعه
 قال : فلما القي في النار دعا بدعاء نسيه ابو هلال فقال الله عز وجل : @QB@ يا نار كوني بردا وسلاما علي ابراهيم @QE@ قال : فبردت في المشرق والمغرب فما انضجت يومءذ كراعا
 واخرج عبد الرزاق وعبد بن حميد وابن جرير عن قتادة قال : قال كعب : ما انتفع احد من اهل الارض يومءذ بنار ولا احرقت النار يومءذ شيءا الا وثاق ابراهيم
 وقال قتادة : لم تات دابة يومءذ الا اطفات عنه النار الا الوزغ
 واخرج ابن ابي حاتم عن الضحاك قال : يذكرون ان جبريل كان مع ابراهيم في النار يمسح عنه العرق
 واخرج ابن ابي حاتم عن عطية قال : لما القي ابراهيم في النار قعد فيها  فارسلوا الي ملكهم فجاء ينظر متعجبا

 فطارت منه شرارة فوقعت علي ابهام رجله فاشتعل كما تشتعل الصوفة
 واخرج ابن المنذر عن ابن جريج قال : خرج ابراهيم من النار يعرق لم تحرق النار الا وثاقه فاخذوا شيخا منهم فجعلوه علي نار كذلك فاحترق
 واخرج عبد بن حميد عن سليمان بن صرد
 وكان قد ادرك النبي صلي الله عليه وسلم ان ابراهيم لما ارادوا ان يلقوه في النار جعلوا يجمعون له الحطب فجعلت المراة العجوز تحمل علي ظهرها فيقال لها : اين تريدين فتقول : اذهب الي هذا الذي يذكر الهتنا
 فلما ذهب به ليطرح في النار ( قال : اني ذاهب الي ربي سيهدين ) ( الصافات اية  ) فلما طرح في النار قال : حسبي الله ونعم الوكيل
 فقال الله : @QB@ يا نار كوني بردا وسلاما علي ابراهيم @QE@ فقال ابو لوط  وكان عمه  ان النار لم تحرقه من اجل قرابته مني
 فارسل الله عنقا من النار فاحرقته
 واخرج الفريابي وابن ابي شيبة وابن جرير عن علي بن ابي طالب في قوله : @QB@ قلنا يا نار كوني بردا @QE@ قال : بردت عليه حتي كانت تءذيه حتي قيل : @QB@ وسلاما @QE@ قال : لا تءذيه
 واخرج الفريابي وابن ابي حاتم عن ابن عباس قال : لو لم يقل : @QB@ وسلاما @QE@ لقتله البرد
 واخرج ابن جرير وابن ابي حاتم عن ابي هريرة قال : ان احسن شء قاله ابو ابراهيم لما رفع عنه الطبق وهو في النار وجده يرشح جبينه فقال عند ذلك : نعم الرب ربك يا ابراهيم
 واخرج ابن جرير عن شعيب الجباءي قال : القي ابراهيم في النار وهو ابن ست عشرة سنة وذبح اسحق وهو ابن سبع سنين
 واخرج ابن جرير عن معتمر بن سليمان التيمي عن بعض اصحابه قال : جاء جبريل الي ابراهيم وهو يوثق ليلقي في النار قال : يا ابراهيم الك حاجة قال : اما اليك فلا
 واخرج ابن جرير عن ارقم ان ابراهيم عليه السلام قال : حين جعلوا يوثقونه  ليلقوه في النار : لا اله الا انت سبحانك رب العالمين لك الحمد ولك الملك لا شريك لك
 واخرج ابن جرير عن ابي العالية في قوله : @QB@ قلنا يا نار كوني بردا وسلاما @QE@ قال : السلام لا يءذيه بردها ولولا انه قال : @QB@ سلاما @QE@ لكان البرد اشد عليه من الحر
 واخرج ابن جرير عن ابن جريج في قوله : @QB@ وارادوا به كيدا فجعلناهم الاخسرين @QE@ قال : القوا شيخا في النار منهم لان يصيبوا نجاته كما نجا ابراهيم فاحترق
 واخرج ابن ابي شيبة عن ابي مالك في قوله : @QB@ الي الارض التي باركنا فيها للعالمين @QE@ قال : الشام
 واخرج ابن ابي حاتم عن ابي بن كعب في قوله : @QB@ الي الارض التي باركنا فيها للعالمين @QE@ قال : الشام
 وما من ماء عذب الا يخرج من تلك الصخرة التي ببيت المقدس يهبط من السماء الي الصخرة ثم يتفرق في الارض
 واخرج ابن عساكر عن عبد الله بن سلام قال : بالشام من قبور الانبياء الفا قبر وسبعماءة قبر وان دمشق معقل الناس في اخر الزمان من الملاحم
 واخرج الحاكم وصححه عن ابن عباس قال لوط : كان ابن اخي ابراهيم عليهما السلام
 واخرج ابن سعد عن ابن عباس قال : لما هرب ابراهيم من كوثي وخرج من النار ولسانه يومءذ سرياني فلما عبر الفرات من حران غير الله لسانه فقلب عبرانيا حيث عبر الفرات وبعث ثمرود في نحو اثره وقال : لا تدعوا احدا يتكلم بالسريانية الا جءتموني به فلقوا ابراهيم يتكلم بالعبرانية فتركوه ولم يعرفوا لغته
 واخرج ابن عساكر عن حسان بن عطية قال : اغار ملك نبط علي لوط عليه السلام فسباه واهله فبلغ ذلك ابراهيم فاقبل في طلبه في عدة اهل بدر ثلاثماءة وثلاثة عشر فالتقي هو وتلك النبط في صحراء معفور فعبي ابراهيم ميمنة وميسرة وقلبا وكان اول من عبي الحرب هكذا فاقتتلوا فهزمهم ابراهيم واستنقذ لوطا واهله
 واخرج عبد بن حميد عن ابي العالية @QB@ ونجيناه @QE@ يعني ابراهيم @QB@ ولوطا الي الارض التي باركنا فيها للعالمين @QE@  قال : هي الارض المقدسة التي بارك الله فيها للعالمين لان كل ماء عذب في الارض منها يخرج يعني من اصل الصخرة التي في بيت المقدس يهبط من السماء الي الصخرة ثم يتفرق في الارض
 واخرج عبد بن حميد وابن المنذر وابن ابي حاتم وابن عساكر عن قتادة رضي الله عنه @QB@ ونجيناه ولوطا @QE@ قال : كانا بارض العراق فانجيا الي ارض الشام
 وكان يقال : الشام عماد دار الهجرة وما نقص من الارض زيد في الشام وما نقص من الشام زيد في فلسطين
 وكان يقال : هي ارض المحشر والمنشر وفيها ينزل عيسي ابن مريم عليه السلام وبها يهلك الله شيخ الضلالة الدجال
 واخرج ابن المنذر عن مجاهد رضي الله عنه في قوله : @QB@ الي الارض التي باركنا فيها @QE@ قال : الشام
 واخرج ابن ابي حاتم عن كعب رضي الله عنه في قوله : @QB@ الي الارض التي باركنا فيها @QE@ قال : الي حران
 واخرج ابن جرير عن ابن عباس رضي الله عنهما @QB@ ووهبنا له اسحاق @QE@ قال : ولدا @QB@ ويعقوب نافلة @QE@ قال : ابن ابن
 واخرج ابن ابي شيبة وعبد بن حميد وابن جرير وابن المنذر وابن ابي حاتم عن مجاهد رضي الله عنه @QB@ ووهبنا له اسحاق @QE@ قال : اعطاه @QB@ ويعقوب نافلة @QE@ قال : عطية
 واخرج عبد الرزاق وابن المنذر عن الكلبي في الاية قال : دعا بالحق فاستجيب له وزيد يعقوب
 واخرج ابن المنذر وابن ابي حاتم عن الحكم قال : النافلة ابن الابن
 واخرج ابن جرير وابن المنذر وابن ابي حاتم عن قتادة رضي الله عنه في قوله : @QB@ وجعلناهم اءمة يهدون @QE@ الاية
 قال : جعلهم الله اءمة يقتدي بهم في امر الله
