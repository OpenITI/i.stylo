 واخرج عبد بن حميد وابن جرير وابن جرير وابن الانباري في كتاب الاضداد عن قتادة في قوله @QB@ هذا الذي رزقنا من قبل @QE@ اي في الدنيا @QB@ واتوا به متشابها @QE@ قال : يشبه ثمار الدنيا غير ان ثمر الجنة اطيب
 واخرج مسدد وهناد في الزهد وابن جرير وابن المنذر وابن ابي حاتم والبيهقي في البعث عن ابن عباس قال : ليس في الدنيا مما في الجنة شءالا الاسماء
 واخرج الديلمي عن عمر سمعت رسول الله صلي الله عليه وسلم يقول : في طعام العرس مثقال من ريح الجنة
 واخرج عبد بن حميد عن عكرمة في قوله @QB@ هذا الذي رزقنا من قبل @QE@ قال : قولهم من قبل معناه
 مثل الذي كان بالامس
 واخرج ابن جرير عن يحيي بن كثير قال : يءتي احدهم بالصحفة فياكل منها ثم يءتي باخري فيقول : هذا الذي اتينا به من قبل فيقول الملك : كل اللون واحد والطعم مختلف
 واخرج وكيع وعبد الرزاق وعبد بن حميد وابن جرير عن مجاهد في قوله @QB@ واتوا به متشابها @QE@ قال : متشابها في اللون مختلفا في الطعم
 مثل الخيار من القثاء
 واخرج عبد بن حميد وابن جرير عن قتادة في قوله @QB@ واتوا به متشابها @QE@ قال : خيارا كله لا رذل فيه
 واخرج عبد بن حميد وابن جرير عن الحسن في قوله @QB@ واتوا به متشابها @QE@ قال : خيار كله يشبه بعضه بعضا لا رذل فيه
 الم تر الي ثمار الدنيا كيف ترذلون بعضه
  واخرج البزار والطبراني عن ثوبان
 انه سمع رسول الله صلي الله عليه وسلم يقول لاينزع رجل من اهل الجنة من ثمره الا اعيد في مكانها مثلاها
 واخرج ابن عساكر في تاريخه من طريق ابن حيوة عن خالد بن يزيد بن معاوية ابن ابي سفيان قال : بينا اسير في ارض الجزيرة اذ مررت برهبان وقسيسين واساقفة فسلمت فردوا السلام فقلت : اين تريدون فقالوا : نريد راهبا في هذا الدير ناتيه في كل عام فيخبرنا بما يكون في ذلك العام لمثله من قابل فقلت : لاتين هذا الراهب فلانظرن ما عنده  وكنت معنيا بالكتب  فاتيته وهوعلي باب ديره فسلمت فرد السلام ثم قال : ممن انت فقلت : من المسلمين قال : امن امة محمد فقلت : نعم
 فقال : من علماءهم انت ام من جهالهم قلت : ما انا من علماءهم ولا من جهالهم قال : فانكم تزعمون انكم تدخلون الجنة فتاكلون من طعامها وتشربون من شرابها ولا تبولوا ولا تتغوطون قلت : نحن نقول ذلك وهو كذلك قال : فان له مثلا في الدنيا فاخبرني ماهو قلت : مثله كمثل الجنين في بطن امه انه ياتيه رزق الله ولا يبول ولا يتغوط
 قال : فتربد وجهه ثم قال لي : اما اخبرتني انك لست من علماءهم قلت : ما كذبتك قال : فانكم تزعمون انكم تدخلون الجنة فتاكلون من طعامها وتشربون من شرابها ولا ينقص ذلك منها شيءا قلت : نحن نقول ذلك وهو كذلك قال : فان له مثلا في الدنيا فاخبرني ما هو قلت : مثله في الدنيا كمثل الحكمة لو تعلم منها الخلق اجمعون لم ينقص ذلك منها شيءا فتربد وجهه ثم قال : اما اخبرتني انك لست من علماءهم قلت : وما كذبتك ما انا من علماءهم ولا من جهالهم
 واخرج الحاكم وابن مردويه وصححه عن ابي سعيد الخدري عن النبي صلي الله عليه وسلم في قوله @QB@ ولهم فيها ازواج مطهرة @QE@ قال : من الحيض والغاءط والنخامة والبزاق
 واخرج ابن جرير وابن ابي حاتم وابن المنذر عن ابن عباس في قوله @QB@ ولهم فيها ازواج مطهرة @QE@ قال : من القذر والاذي
 واخرج ابن جرير عن ابن مسعود في قوله @QB@ ولهم فيها ازواج مطهرة @QE@ قال : لا يحضن ولا يحدثن ولا يتنخمن
  واخرج وكيع وعبد الرزاق وهناد في الزهد وعبد بن حميد وابن جرير عن مجاهد في قوله @QB@ ولهم فيها ازواج مطهرة @QE@ قال : من الحيض والغاءط والبول والمخاط والنخامة والبزاق والمني والولد
 واخرج وكيع وهناد عن عطاء في قوله @QB@ ولهم فيها ازواج مطهرة @QE@ قال : لا يحضن ولايمنين ولايلدن ولايتغوطن ولايبلن ولايبزقن
 واخرج عبد الرزاق وعبد بن حميد وابن جرير عن قتادة في قوله @QB@ ولهم فيها ازواج مطهرة @QE@ قال : طهرهن الله من كل بول وغاءط وقذر وماثم
 واخرج ابن ابي شيبة واحمد والبخاري ومسلم وابن ماجه والبيهقي في البعث عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم اول زمرة تلج الجنة صورتهم علي صورة القمر ليلة البدر لايبصقون فيها ولايتمخطون ولايتغوطون انيتهم وامشاطهم من الذهب والفضة ومجامرهم من الالوة ورضخهم المسك ولكل واحد مهم زوجتان يري مخ ساقها من وراء اللحم من الحسن لااختلاف بينهم ولا تباغض قلوبهم علي قلب رجل واحد يسبحون الله بكرة وعشيا
 واخرج ابن ابي شيبة واحمد والترمذي وصححه والبيهقي في البعث عن ابي سعيد الخدري قال : قال رسول الله صلي الله عليه وسلم اول زمرة تدخل الجنة وجوههم كالقمر ليلة البدر
 والزمرة الثانية احسن كوكب دري في السماء لكل امرء زوجتان علي كل زوجة سبعون حلة يري مخ ساقهن من وراء الحلل
 واخرج احمد والترمذي عن ابي سعيد الخدري
 ان رسول الله صلي الله عليه وسلم قال ان ادني اهل الجنة منزلة الذي له ثمانون الف خادم واثنتان وسبعون زوجة ومنصب له قبة من لءلء وياقوت وزبرجد كما بين الجابية وصنعاء
 واخرج احمد والبخاري ومسلم والبيقهي في النعت عن ابي هريرة انهم تذاكروا الرجال اكثر في الجنة ام النساء فقال : الم يقل رسول الله صلي الله عليه وسلم ما في الجنة احد الا له زوجتان
 انه ليري مخ ساقهما من وراء سبعين حلة ما فيها عزب
 واخرج الترمذي وصححه والبزار عن انس عن النبي صلي الله عليه وسلم قال يزوج العبد في الجنة سبعين زوجة فقيل : يارسول الله يطيقها قال : يعطي قوة ماءة
  واخرج ابن السكن في المعرفة وابن عساكر في تاريخه عن حاطب بن ابي بلتعة سمعت رسول الله صلي الله عليه وسلم يقول يزوج المءمن في الجنة اثنتين وسبعين زوجة من نساء الاخرة واثنتين من نساء الدنيا
 واخرج ابن ماجه وابن عدي في الكامل والبيهقي في البعث عن ابي امامة الباهلي قال : قال رسول الله صلي الله عليه وسلم ما من احد يدخله الله الجنة الا زوجه اثنتين وسبعين زوجة
 اثنتين من الحور العين وسبعين من ميراثه من اهل الجنة ما منهن واحدة الا ولها قبل شهي وله ذكر لا ينثني
 واخرج احمد عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم ان ادني اهل الجنة منزلة من له سبع درجات وهو علي السادسة وفوقه السابعة وان له لثلثماءة خادم ويغدي عليه كل يوم ويراح بثلثماءة صحفة من ذهب في كل صحفة لون ليس في الاخري وانه ليلذ اوله كما يلذ اخره وانه ليقول : يا رب لو اذنت لي لاطعمت اهل الجنة وسقيتهم لم ينقص مما عندي شء وان له من الحور العين لاثنتين وسبعين زوجة وان الواحدة منهن لتاخذ مقعدتها قدر ميل من الارض
 واخرج البيهقي في البعث عن ابي عبد الله بن ابي اوفي قال : قال رسول الله صلي الله عليه وسلم يزوج كل رجل من اهل الجنة باربعة الاف بكر وثمانية الاف ايم وماءة حوراء
 فيجتمعن في كل سبعة ايام فيقلن باصوات حسان لم يسمع الخلاءق بمثلهن : نحن الخالدات فلا نبيد ونحن الناعمات فلانباس ونحن الراضيات فلا نسخط ونحن المقيمات فلا نظعن طوبي لمن كان لنا وكنا له
 واخرج احمد والبخاري عن انس
 ان رسول الله صلي الله عليه وسلم قال : غدوة في سبيل الله او روحة خير من الدنيا وما فيها ولقاب قوس احدكم في الجنة خير من الدنيا وما فيها ولو ان امراة من نساء اهل الجنة اطلعت الي الارض لاضاءت ما بينهما ولملات ما بينهما ريحا ولنصيفها علي راسها  يعني الخمار  خير من الدنيا وما فيها
 واخرج ابن ابي الدنيا في صفة الجنة عن ابن عباس
 لو ان امراة من نساء اهل الجنة بصقت في سبعة ابحر كانت تلك الابحر احلي من العسل
 واخرج احمد في الزهد عن عمر بن الخطاب
 سمعت رسول الله صلي الله عليه وسلم يقول لو اطلعت امراة من نساء اهل الجنة الي الارض لملات الارض ريح مسك
 واخرج ابن ابي شيبة وهناد بن السري عن كعب قال : لو ان امراة من اهل  الجنة اطلعت كفها لاضاء ما بين السماء والارض
 واخرج ابن ابي شيبة واحمد وهناد بن السري في الزهد والنساءي وعبد بن حميد في مسنده وابن المنذر وابن ابي حاتم قال : جاء رجل من اهل الكتاب الي رسول الله صلي الله عليه وسلم قال يا ابا القاسم تزعم ان اهل الجنة ياكلون ويشربون فقال : والذي نفسي بيده ان الرجل ليءتي قوة ماءة رجل منكم
 في الاكل والشرب والجماع والشهوة قال : فان الذي ياكل ويشرب يكون له الحاجة والجنة طاهرة ليس فيها قذر ولا اذي فقال رسول الله صلي الله عليه وسلم : حاجتهم عرق يفيض مثل ريح مسك فاذا كان ذلك ضمر له بطنه
 واخرج ابو يعلي والطبراني وابن عدي في الكامل والبيهقي في البعث عن ابي امامة ان رجلا سال رسول الله صلي الله عليه وسلم هل تتناكح اهل الجنة فقال : دحاما دحاما

 لا مني ولا منية
 واخرج البزار والطبراني والخطيب والبغدادي في تاريخه عن ابي هريرة قال قيل يا رسول الله هل نصل الي نساءنا في الجنة فقال : ان الرجل ليصل في اليوم الي ماءة عذراء
 واخرج ابو يعلي والبيهقي في البعث عن ابن عباس قال قيل يا رسول الله انفضي الي نساءنا في الجنة كما نفضي اليهن في الدنيا قال : والذي نفس محمد بيده ان الرجل ليفضي في الغداة الواحدة الي ماءة عذراء
 واخرج ابن ابي حاتم والطبراني عن ابي امامة قال سءل رسول الله صلي الله عليه وسلم تتناك اهل الجنة فقال : نعم
 بفرج لا يمل وذكر لا ينثني وشهوة لا تنقطع دحما دحما
 واخرج عبد بن حميد وابن ابي الدنيا والبزار عن ابي هريرة قال سءل رسول الله صلي الله عليه وسلم هل تمس اهل الجنة ازواجهم قال : نعم
 بذكر لا يمل وفرج لا يحفي وشهوة لا تنقطع
 واخرج الحرث بن ابي اسامة وابن ابي حاتم عن سليم بن عامر والهيثم الطاءي ان النبي صلي الله عليه وسلم سءل عن البضع في الجنة قال : نعم بقبل شهي وذكر لا يمل وان الرجل ليتكء فيها المتكا مقدار اربعين سنة لا يتحول عنه ولا يمله ياتيه فيه ما اشتهت نفسه ولذت عينه
  واخرج البيهقي في البعث وابن عساكر في تاريخه عن خارجة العذري قال : سمعت رجلا بتبوك قال يا رسول الله ايباضع اهل الجنة قال : يعطي الرجل منهم من القوة في اليوم الواحد افضل من سبعين منكم
 واخرج الطبراني عن زيد بن ارقم
 ان النبي صلي الله عليه وسلم قال ان البول والجنابة عرق يسيل من تحت ذواءبهم الي اقدامهم مسك
 واخرج عبد الرزاق وعبد بن حميد والاصبهاني في الترغيب عن ابي الدرداء قال : ليس في الجنة مني ولا منية انما يدحمونهن دحما
 واخرج عبد الرزاق وعبد بن حميد عن طاوس قال : اهل الجنة ينكحون النساء ولا يلدن ليس فيها مني ولا منية
 واخرج عبد الرزاق وعبد بن حميد عن عطاء الخراساني
 مثله
 واخرج وكيع وعبد الرزاق وهناد وابن ابي شيبة وعبد بن حميد عن ابراهيم النخعي قال : في الجنة جماع ما شءت ولا ولد قال : فيلتفت فينظر النظرة فتنشا له الشهوة ثم ينظر النظرة فتنشا له شهوة اخري
 واخرج الضياء المقدسي في صفة الجنة عن ابي هريرة عن رسول الله صلي الله عليه وسلم انه سءل انطا في الجنة قال : نعم
 والذي نفسي بيده دحما دحما

 فاذا قام عنها رجعت مطهرة بكرا
 واخرج البزار والطبراني في الصغير وابو الشيخ في العظمة عن ابي سعيد الخدري قال : قال رسول الله صلي الله عليه وسلم اهل الجنة اذا جامعوا نساءهم عادوا ابكارا
 واخرج عبد بن حميد واحمد بن حنبل في زواءد الزهد وابن المنذر عن عبد الله ابن عمرو قال : ان المءمن كلما اراد زوجته وجدها بكرا
 واخرج ابن ابي شيبة عن سعيد بن جبير قال : طول الرجل من اهل الجنة تسعون ميلا
 وطول المراة ثلاثون ميلا
 ومقعدتها جريب وان شهوته لتجري في جسدها سبعين عاما تجد اللذة
 واخرج احمد والترمذي وحسنه وابن ماجه وابن ابي داود في البعث عن معاذ ابن جبل عن النبي صلي الله عليه وسلم قال لا تءذي امراة زوجها في الدنيا الا قالت زوجته من الحور العين : قاتلك الله فانما هو عندك دخيل يوشك ان يفارقك الينا
 اما قوله تعالي : @QB@ وهم فيها خالدون @QE@  اخرج ابن اسحاق وابن ابي حاتم عن ابن عباس في قوله @QB@ وهم فيها خالدون @QE@ اي خالدون ابدا
 يخبرهم ان الثواب بالخير والشر مقيم علي اهله لا انقطاع له
 واخرج احمد وابن ابي حاتم عن سعيد بن جبير في قوله @QB@ وهم فيها خالدون @QE@ يعني لا يموتون
 واخرج الطستي في مساءله عن ابن عباس ان نافع بن الازرق قال له : اخبرني عن قوله عز وجل وهم فيها خالدون قال : ماكثون لا يخرجون منها ابدا قال : وهل تعرف العرب ذلك قال : نعم
 اما سمعت قول عدي بن زيد : فهل من خالد اما هلكنا * وهل بالموت يا للناس عار واخرج عبد بن حميد والبخاري ومسلم وابن مردويه عن عمر عن النبي صلي الله عليه وسلم قال يدخل اهل الجنة الجنة واهل النار النار
 ثم يقول مءذن بينهم : يا اهل النار لا موت ويا اهل الجنة لا موت كل خالد فيما هو فيه
 واخرج البخاري عن ابي هريرة قال : قال النبي صلي الله عليه وسلم يقال لاهل الجنة خلود ولا موت ولاهل النار خلود ولا موت
 واخرج عبد بن حميد وابن ماجه والحاكم وصححه وابن مردويه عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم يءتي بالموت في هيءة كبش املح فيوقف علي الصراط فيقال : يا اهل الجنة
 فيطلعون خاءفين وجلين مخافة ان يخرجوا مما هم فيه فيقال : تعرفون هذا فيقولون : نعم هذا الموت فيقال : يا اهل النار
 فيطلعون مستبشرين فرحين ان يخرجوا مما هم فيه
 فيقال : اتعرفون هذا فيقولون : نعم
 هذا الموت
 فيءمر به فيذبح علي الصراط فيقال للفريقين : خلود فيما تجدون لا موت فيها ابدا
 واخرج الطبراني والحاكم وصححه عن معاذ بن جبل ان رسول الله صلي الله عليه وسلم بعثه الي اليمن فلما قدم عليهم قال : يا ايها الناس اني رسول رسول الله اليكم ان المرد الي الله الي جنة او نار خلود بلا موت واقامة بلا ظعن واجساد لا تموت
 واخرج الطبراني وابن مردويه وابو نعيم عن ابن مسعود قال : قال رسول الله صلي الله عليه وسلم لو قيل لاهل النار ماكثون في النار عدد كل حصاة في الدنيا لفرحوا بها ولو قيل لاهل الجنة انكم ماكثون عدد كل حصاة لحزنوا ولكن جعل لهم الابد
