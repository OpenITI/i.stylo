 قال محمد بن عمر وحدثني محمد عبدالله بن اخي الزهري عن ابيه عن  عبدالله بن ثعلبة بن صعير العذري قال قال ابو طالب
 يا ابن اخي والله لولا رهبة ان تقول قريش وهرني الجزع فتكون سبة عليك وعلي بني ابيك لفعلت الذي تقول واقررت عينك لما اري من شكرك ووجدك ونصيحتك لي
 ثم ان ابا طالب دعا بني عبدالمطلب فقال لن تزالوا بخير ما سمعتم من محمد وما اتبعتم امره فاتبعوه واعينوه ترشدوا
 فقال رسول الله صلي الله عليه وسلم ( لم تامرهم بها وتدعها لنفسك )
 فقال ابو طالب اما انك لو سالتني الكلمة وانا صحيح لتابعتك علي الذي تقول ولكني اكره ان اجزع عند الموت فتري قريش اني اخذتها جزعا ورددتها في صحتي
 قال محمد بن عمر وحدثني معاوية بن عبدالله بن عبيدالله بن ابي رافع عن ابيه عن جده عن علي رضي الله عنه قال
 اخبرت رسول الله صلي الله عليه وسلم بموت ابي طالب فبكي ثم قال
 ( اذهب فاغسله وكفنه وواره غفر الله له ورحمه )
 قال ففعلت قال وجعل رسول الله صلي الله عليه وسلم يستغفر له اياما ولا يخرج من بيته حتي نزل عليه جبريل عليه السلام بهذه الاية @QB@ ما كان للنبي والذين امنوا ان يستغفروا للمشركين ولو كانوا اولي قربي @QE@ 
 قال علي وامرني رسول الله صلي الله عليه وسلم فاغتسلت
 قال محمد واخبرنا الفضل بن دكين قال حدثنا سفيان عن ابي اسحاق عن ناجية بن كعب عن علي رضي الله عنه قال
 اتيت النبي صلي الله عليه وسلم فقلت ان عمك الشيخ الضال قد مات
 قال ( اذهب فواره ولا تحدثن شيءا حتي تاتيني )
 فاتيته فقلت له فامرني فاغتسلت ثم دعا لي بدعوات ما يسرني ما عوض بهن من شء
 اخبرنا ابن الحصين قال اخبرنا ابن المذهب قال اخبرنا احمد بن جعفر قال حدثنا عبدالله بن احمد قال حدثني ابي قال اخبرنا ابراهيم ابن ابي العباس قال اخبرنا الحسن بن يزيد الاصم قال سمعت اسماعيل السدي يذكر عن ابي عبدالرحمن السلمي عن علي قال
 لما توفي ابو طالب اتيت النبي صلي الله عليه وسلم فقلت ان عمك الشيخ قد مات قال اذهب فواره ولا تحدث شيءا حتي تاتيني
 قال فاغتسلت ثم اتيته فدعا لي بدعوات ما يسرني اني لي بها حمر النعم وسودها
 قال وكان علي رضي الله عنه اذا غسل الميت اغتسل
 وقال ابن عباس عارض رسول الله صلي الله عليه وسلم جنازة ابي طالب وقال
 ( وصلت رحمك جزاك الله خيرا يا عم ) 
  وفاة خديجة رضي الله عنها
 ومن الحوادث وفاة خديجة رضي الله عنها بعد ابي طالب بايام
 اخبرنا ابن عبدالباقي قال اخبرنا الجوهري قال اخبرنا ابن حيويه قال اخبرنا احمد ابن معروف قال اخبرنا الحارث بن ابي امامة قال اخبرنا محمد بن سعد قال حدثنا محمد ابن عمر بن واقد عن محمد بن صالح بن دينار وعبدالرحمن بن عبدالعزيز والمنذر بن عبدالله عن بعض اصحابه عن حكيم بن حزام قال وحدثنا محمد بن عبدالله عن ابيه عن عبدالله بن ثعلبة بن صعير قال
 لما توفي ابو طالب وخديجة وكان بينهما شهر وخمسة ايام اجتمعت علي رسول الله صلي الله عليه وسلم مصيبتان فلزم بيته واقل الخروج ونالت منه قريش ما لم تكن تنال ولا تطمع به فبلغ ذلك ابا لهب فجاءه فقال يا محمد امض لما اردت وما كنت صانعا اذ كان ابو طالب حيا فاصنعه لا واللات لا يوصل اليك حتي اموت وسب ابن العيطلة النبي صلي الله عليه وسلم فاقبل عليه ابو لهب فنال منه فولي وهو يصيح يا معشر قريش صبا ابو عتبة 
 فاقبلت قريش حتي وقفوا علي ابي لهب فقال ما فارقت دين عبدالمطلب ولكني امنع ابن اخي ان يضام حتي يمضي لما يريد فقالوا قد احسنت واجملت ووصلت الرحم فمكث رسول الله صلي الله عليه وسلم كذلك اياما يذهب وياتي لا يعترض له احد من قريش وهابوا ابا لهب الي ان جاء عقبة بن ابي معيط وابو جهل الي ابي لهب فقالا له اخبرك ابن اخيك اين مدخل ابيك فقال له ابو لهب يا محمد اين مدخل عبدالمطلب قال ( مع قومه )
 قال فخرج اليهما ابو لهب وقال قد سالته فقال مع قومه
 فقالا انه يزعم انه في النار فقال يا محمد ايدخل عبدالمطلب النار
 فقال رسول الله صلي الله عليه وسلم ( نعم ومن مات علي مثل ما مات عليه عبدالمطلب دخل النار )
 فقال ابو لهب والله لا برحت لك عدوا ابدا وانت تزعم ان عبدالمطلب في النار فاشتد عليه هو وساءر قريش
 قال محمد بن عمر وحدثني عبدالرحمن بن عبدالعزيز عن ابي الحويرث عن محمد بن جبير بن مطعم قال
 لما توفي ابو طالب تناولت قريش من رسول الله صلي الله عليه وسلم فخرج حينءذ الي الطاءف ومعه زيد بن حارثة في ليال بقين من شوال سنة عشر
 قال محمد بن عمر بغير هذا الاسناد فاقام بالطاءف عشرة ايام
 وقال غيره شهرا لا يدع احدا من اشرافهم الا جاءه وكلمه فلم يجيبوه وخافوا علي احداثهم فقالوا يا محمد اخرج من بلدنا والحق لمجابك من الارض واغروا به سفهاءهم فجعلوا يرمونه بالحجارة حتي ان رجليه لتدميان وزيد بن حارثة يقيه بنفسه  حتي لقد شج في راسه شجاجا فانصرف رسول الله صلي الله عليه وسلم من الطاءف راجعا الي مكة وهو محزون فلما نزل نخلة قام يصلي فصرف اليه نفر من الجن سبعة من اهل نصيبين فاستمعوا واقاموا بنخلة اياما
 فقال له زيد كيف تدخل عليهم وهم اخرجوك
 فارسل رجلا من خزاعة الي مطعم بن عدي ادخل في جوارك قال نعم
 قال محمد بن كعب القرظي لما انتهي رسول الله صلي الله عليه وسلم الي الطاءف عمد الي نفر من ثقيف وهم قادة ثقيف واشرافهم يومءذ وهم اخوة ثلاثة عبد يا ليل ومسعود وحبيب اولاد عمرو بن عمير فجلس اليهم فدعاهم الي الله عز وجل وكلمهم بما جاء له من نصرته علي الاسلام والقيام معه علي من خالفه من قومه فقال احدهم هو يمرط ثياب الكعبة ان كان الله ارسلك
 وقال اخر اما وجد الله احدا يرسله غيرك
 وقال الثالث والله لا اكلمك كلمة ابدا لءن كنت رسولا من الله كما تقول لانت اعظم خطرا من ان ارد عليك الكلام ولءن كنت تكذب علي الله ما ينبغي لي ان اكلمك
 فقام رسول الله صلي الله عليه وسلم من عندهم وقد يءس من نصر ثقيف واغروا به سفهاءهم يسبونه ويصيحون به حتي اجتمع اليه الناس والجاوه الي حاءط لعتبة بن  ربيعة وشيبة بن ربيعة وهما فيه ورجع عنه من سفهاء ثقيف من كان يتبعه فعمد الي ظل حبلة من عنب فجلس فيه وابنا ربيعة ينظران اليه ويريان ما لقي من سفهاء ثقيف فلما اطمان قال فيما ذكر لي
 ( اللهم اليك اشكو ضعف قوتي وقلة حيلتي وهواني علي الناس يا ارحم الراحمين انت رب المستضعفين وانت ربي الي من تكلني الي بعيد فيجهمني ام الي عدو ملكته امري فان لم يكن بك علي غضب فلا ابالي ولكن عافيتك هي اوسع لي اعوذ بنور وجهك الذي اشرقت له الظلمات وصلح عليه امر الدنيا والاخرة من ان تنزل بي غضبك او تحل علي سخطك لك الرضي حتي ترضي لا حول ولا قوة الا بك )
 فلما راي ابنا ربيعة عتبة وشيبة ما لقي تحركت له رحمهما فدعوا غلاما لهما نصرانيا يقال له عداس وقالا له خذ قطفا من هذا العنب وضعه في ذلك الطبق ثم اذهب به الي ذلك الرجل فقل له ياكل منه ففعل ثم اقبل به حتي وضعه بين يدي رسول الله صلي الله عليه وسلم فلما رفع رسول الله صلي الله عليه وسلم يده قال ( بسم الله ) ثم اكل
 فنظر عداس الي وجهه ثم قال والله ان هذا الكلام ما يقوله اهل هذه البلدة
 فقال له رسول الله صلي الله عليه وسلم ( ومن اي البلاد انت وما دينك )
 قال انا نصراني وانا رجل من اهل نينوي
 فقال له رسول الله صلي الله عليه وسلم ( امن قرية الرجل الصالح يونس بن متي )
 قال له وما يدريك ما يونس بن متي
 قال ( ذاك اخي كان نبيا وانا نبي ) 
 فاكب عداس علي راس رسول الله صلي الله عليه وسلم يقبل راسه ويديه ورجليه
 قال يقول ابنا ربيعة احدهما لصاحبه اما غلامك فقد افسده عليك فلما جاءهما قالا له ويلك يا عداس ما لك تقبل راس هذا الرجل ويديه وقدميه
 قال يا سيدي ما في الارض شء خير من هذا لقد اخبرني بامر لا يعلمه الا نبي
  رجوعه صلي الله عليه وسلم من الطاءف
 ومن الحوادث انه لما رجع من الطاءف لم يمكنه دخول مكة الا بجوار وذلك انه لما دنا من مكة علم ان قومه اشد عليه مما كانوا فارسل بعض اهل مكة الي الاخنس بن شريق فقال له هل انت مجيري حتي ابلغ رسالة ربي
 فقل له الاخنس ان الحليف لا يجير علي الصريح
 قال فاتي النبي صلي الله عليه وسلم فاخبره فقال تعود قال نعم قال فات سهيل بن عمرو فقل له ان محمدا يقول لك هل انت مجيري حتي ابلغ رسالات ربي فقال له ذلك فقال ان بني عامر بن لءي لا تجير علي بني كعب فرجع الي النبي صلي الله عليه وسلم فاخبره قال تعود قال نعم قال اءت المطعم بن عدي فقال له ان محمدا يقول لك هل انت مجيري حتي ابلغ رسالات ربي قال نعم فليدخل
 فرجع فاخبره واصبح المطعم بن عدي قد لبس سلاحه هو وبنوه وبنو اخيه فدخلوا المسجد فلما راه ابو جهل قال امجير ام متابع قال بل مجير قال اجرنا من اجرت 
 فدخل النبي صلي الله عليه وسلم مكة واقام بها وكان يقف بالموسم علي القباءل فيقول ( يا بني فلان اني رسول الله اليكم يامركم ان تعبدوا الله ولا تشركوا به شيءا ) فكان يمشي خلفه ابو لهب فيقول لا تطيعوه
 واتي رسول الله كندة في منازلهم فدعاهم الي الله عز وجل فابوا واتي كلبا في منازلهم فلم يقبلوا منه واتي بني حنيفة في منازلهم فردوا عليه اقبح رد واتي بني عامر بن صعصعة وكان لا يسمع بقادم من العرب له اسم وشرف الا دعاه وعرض عليه ما عنده
 وقال جابر بن عبدالله مكث رسول الله صلي الله عليه وسلم بمكة عشر سنين يتبع الناس في منازلهم بعكاظ ومجنة وفي المواسم يقول من يءويني من ينصرني حتي ابلغ رسالة ربي وله الجنة حتي بعثنا الله اليه فاويناه وصدقناه
  تزويج رسول الله صلي الله عليه وسلم عاءشة رضي الله عنها
 ومن الحوادث في هذه السنة تزويج رسول الله صلي الله عليه وسلم عاءشة وسودة وكانت عاءشة بنت ست سنين حينءذ
 اخبرنا هبة الله بن الحصين قال اخبرنا ابن المذهب قال اخبرنا احمد بن جعفر قال اخبرنا عبدالله بن احمد بن حنبل قال حدثني ابي قال حدثنا محمد بن بشير قال اخبرنا محمد بن عمرو قال اخبرنا ابو سلمة ويحيي قالا
 لما هلكت خديجة رضي الله عنها جاءت خولة بنت حكيم امراة عثمان بن مظعون فقالت يا رسول الله الا تتزوج قال من قالت ان شءت بكرا وان شءت ثيبا قال ( من البكر ) قالت ابنة احب خلق الله عز وجل اليك عاءشة بنت ابي بكر  قال ( ومن الثيب ) قالت سودة بنت زمعة قد امنت بك واتبعتك علي ما تقول قال فاذهبي فاذكريهما علي
 فدخلت بيت ابي بكر فقالت يا ام رومان ماذا ادخل الله عز وجل عليكم من الخير والبركة قالت وما ذاك قالت ارسلني رسول الله صلي الله عليه وسلم اخطب عليه عاءشة قالت انتظري ابا بكر حتي ياتي فجاء ابو بكر فقالت يا ابا بكر ماذا ادخل الله عليكم من الخير والبركة قال وما ذاك قالت ارسلني رسول الله صلي الله عليه وسلم اخطب عليه عاءشة قال وهل تصلح له انما هي ابنة اخيه فرجعت الي رسول الله صلي الله عليه وسلم فذكرت له ذلك قال ( ارجعي اليه فقولي له انا اخوك وانت اخي في الاسلام وابنتك تصلح لي )
 فرجعت فذكرت ذلك له فقال انتظري وخرج
 قالت ام رومان ان مطعم بن عدي كان قد ذكرها علي ابنه فوالله ما وعد وعدا قط فاخلفه تعني ابا بكر
 فدخل ابو بكر علي مطعم بن عدي وعنده امراته ام الفتي فقالت يا ابن ابي قحافة لعلك مصبي صاحبنا ومدخله في دينك الذي انت عليه ان تزوج اليك قال ابو بكر للمطعم بن عدي ابقول هذه تقول قال انها تقول ذلك فخرج من عنده وقد اذهب الله عز وجل ما كان في نفسه من عدته التي وعده فرجع فقال لخولة ادعي لي رسول الله صلي الله عليه وسلم فدعته فزوجها اياه وعاءشة يومءذ بنت ست سنين
 ثم خرجت فدخلت علي سودة بنت زمعة وقالت ماذا ادخل الله عز وجل عليك من الخير والبركة قالت وما ذاك قالت ارسلني رسول الله صلي الله عليه وسلم اخطبك عليه قالت وددت ادخلي الي ابي فاذكري ذلك له وكان شيخا كبيرا قد ادركه السن قد تخلف عن الحج فدخلت عليه فحيته بتحية الجاهلية فقال من هذه قالت خولة بنت حكيم قال فما شانك قالت ارسلني محمد بن عبدالله اخطب عليه  سودة قال كفء كريم ماذا تقول صاحبتك قالت تحب ذلك قال ادعيها لي فدعوتها فقال يا بنية ان هذه تزعم ان محمدا بن عبدالله بن عبدالمطلب قد ارسل يخطبك وهو كفء كريم اتحبين ان ازوجكه قالت نعم قال ادعيه لي فجاء رسول الله صلي الله عليه وسلم فزوجها اياه
  ذكر من توفي في هذه السنة من الاكابر

    خديجة بنت خويلد بن اسد بن عبد العزي بن قصي وتكني ام هند
 اخبرنا يحيي بن علي بن المدبر قال اخبرنا ابو منصور بن عبدالعزيز العكبري قال اخبرنا ابو احمد عبيدالله بن محمد القرشي قال حدثنا جعفر بن محمد الكالدي قال حدثني محمد بن احمد السجستاني قال اخبرنا عمرو بن اسماعيل بن مجالد قال اخبرني ابي عن مجالد عن الشعبي عن عاءشة رضي الله عنها قالت
 كان رسول الله صلي الله عليه وسلم لا يكاد يخرج من البيت حتي يذكر خديجة فيحسن عليها الثناء فذكرها يوما من الايام فادركتني الغيرة فقلت هل كانت الا عجوزا قد اخلف الله لك خيرا منها
 قالت فغضب حتي اهتز مقدم شعره من الغضب ثم قال ( لا والله ما اخلف الله لي خيرا منها لقد امنت اذ كفر الناس وصدقتني اذ كذبني الناس وواستني بمالها اذ حرمني ورزقني الله اولادها اذ حرمني اولاد النساء )
 قالت فقلت بيني وبين نفسي لا اذكرها بسوء ابدا
 انبانا يحيي بن الحسين البنا قال اخبرنا ابو جعفر قال اخبرنا المخلص  قال اخبرنا احمد بن سليمان الطوسي قال حدثنا الزبير بن بكار قال حدثني محمد بن حسن عن علي بن المغيرة عن ابن ابي داوود قال
 دخل رسول الله صلي الله عليه وسلم علي خديجة بنت خويلد وهي في مرضها الذي توفيت فيه فقال لها ( يا لكره مني ما اري منك يا خديجة وقد يجعل الله في الكره خيرا كثيرا اما علمت ان الله قد زوجني معك في الجنة مريم ابنة عمران وكلثم اخت موسي واسيا امراة فرعون )
 قالت وقد فعل الله ذلك يا رسول الله
 قال نعم
 قالت بالرفاء والبنين
 قال مءلف الكتاب توفيت خديجة في هذه السنة وهي بنت خمس وستين
 ودفنت بالحجون ونزل رسول الله صلي الله عليه وسلم في حفرتها ولم يكن يومءذ سنة الجنازة الصلاة عليها
  السكران بن عمرو بن عبد شمس بن عبد ود
 اسلم قديما بمكة وهاجر الي الحبشة ومعه امراته سودة بنت زمعة فمات في هذه السنة بارض الحبشة
 وقيل بمكة فتزوج رسول الله صلي الله عليه وسلم سودة
    عبد مناف ابو طالب
 عم رسول الله صلي الله عليه وسلم وقد سبق ذكره 
  ذكر الحوادث سنة احدي عشرة من النبوة

  بدء اسلام الانصار
 من ذلك
 خرج رسول الله صلي الله عليه وسلم في الموسم يعرض نفسه علي القباءل كما كان يصنع في كل موسم فبينا هو عند العقبة لقي رهطا من الخزرج فقال ( من انتم ) قالوا من الخزرج قال ( افلا تجلسون اكلمكم ) قالوا بلي
 فجلسوا معه فدعاهم الي الله عز وجل وعرض عليهم الاسلام وتلي عليهم القران وكان اولءك يسمعون من اليهود انه قد اظل زمان نبي يبعث فلما كلمهم قال بعضهم لبعض والله انه النبي الذي يعدكم به يهود فلا تسبقنكم اليه فاجابوه وانصرفوا راجعين الي بلادهم وقد امنوا وكانوا ستة وهم
 اسعد بن زرارة وعوف بن الحارث وهو ابن عفراء ورافع بن مالك بن العجلان وقطبة بن عامر بن حديدة وعقبة بن عامر بن نابي وجابر بن عبدالله بن رءاب 
 فلما قدموا المدينة الي قومهم ذكروا لهم رسول الله ودعوهم الي الاسلام حتي فشا فيهم فلم تبق دار من دور الانصار الا وفيها ذكر رسول الله صلي الله عليه وسلم
 وروي ابو هلال الحسن بن عبدالله بن سهل العسكري قال اخبرنا ابو احمد العسكري قال اخبرنا صالح بن احمد بن ابي مقاتل البغدادي قال اخبرنا عبدالجبار بن كثير بن سيار التميمي قال حدثنا محمد بن بشران الصنعاني قال اخبرنا ابان بن عبدالله البجلي عن ابان بن ثعلب عن عكرمة عن ابن عباس قال حدثنا علي بن ابي طالب رضي الله عنه قال
 لما امر الله تعالي رسول الله صلي الله عليه وسلم ان يعرض نفسه علي قباءل العرب خرج وانا معه وابو بكر حتي دفعنا الي مجلس من مجالس العرب فتقدم ابو بكر فسلم ووقفت انا مع رسول الله صلي الله عليه وسلم
 قال علي وكان ابو بكر مقدما في كل خير وكان رجلا نسابة فقال ممن القوم قالوا من ربيعة قال واي ربيعة انتم قالوا ذهل الاكبر قال ابو بكر امن هامتها او من لهازمها قالوا بل من هامتها العظمي قال فمنكم عوف الذي يقال له لا حر بوادي عوف قالوا لا قال فمنكم بسطام بن قيس ابو اللواء ومنتهي الاحياء قالوا لا قال فمنكم جساس بن مرة حامي الذمار ومانع الجار قالوا لا قال فمنكم الحوفزان قاتل الملوك وسالبها انفسها قالوا لا قال فمنكم المزدلف صاحب العمامة الفردة قالوا لا قال فمنكم اخوال الملوك من كندة قالوا لا قال فمنكم اصهار الملوك من لخم قالوا لا قال فلستم من ذهل  الاكبر انتم من ذهل الاصغر فقام اليه غلام من بني شيبان يقال له دغفل حين بقل عارضه فقال
 ( ان علي ساءلنا ان نساله   والعبولا تعرفه او تحمله )
 يا هذا انك قد سالتنا فاخبرناك ولم نكتمك شيءا فممن الرجل فقال ابو بكر من قريش فقال الفتي بخ بخ اهل الشرف والرءاسة فمن اي قريش انت قال من ولد تيم بن مرة فقال الفتي امكنت والله الرامي من سواء النقرة فمنكم قصي الذي جمع القباءل من فهر فكان يدعي في قريش مجمعا قال لا قال فمنكم هاشم الذي هشم الثريد لقومه فقيل فيه بيت
 ( عمرو العلا هشم الثريد لقومه   ورجال مكة مسنتون عجاف )
 قال لا قال فمنكم شيبة الحمد عبدالمطلب مطعم طير السماء الذي كان وجهه يضء في الليلة الظلماء قال لا قال افمن الندوة انت قال لا قال افمن اهل الحجابة انت قال لا قال فمن اهل السقاية انت قال لا قال فمن اهل الافاضة بالناس انت قال لا
 وزاد غيره قال فانت اذا من زمعات قريش
 قال فاجتذب ابو بكر زمام الناقة ورجع الي رسول الله صلي الله عليه وسلم فقال الغلام 
 ( صادف در السيل درا يدفعه   يهيضه حينا وحينا يصدعه )
 اما والله لو ثبت فتبسم رسول الله صلي الله عليه وسلم
 قال علي رضي الله عنه فقلت يا ابا بكر لقد وقعت من الاعرابي علي باقعة قال اجل يا ابا الحسن ما من طامة الا وفوقها طامة والبلاء موكل بالمنطق
 قال فدفعنا الي مجلس اخر عليهم السكينة والوقار فتقدم ابو بكر فسلم ودنا فقال ممن القوم قالوا من شيبان بن ثعلبة
 فقال يا رسول الله ما وراء هءلاء من قومهم شء هءلاء غرر الناس وفيهم مفروق بن عمرو وهانء بن قبيصة والمثني بن حارثة والنعمان بن شريك فقال ابو بكر كيف العدد فيكم قال مفروق انا لنزيد علي الف ولن تغلب الف من قلة فقال ابو بكر فكيف المنعة فيكم قال علينا الجهد ولكل قوم جهد قال كيف الحرب بينكم قال انا لاشد ما نكون غضبا حين نلقي واشد ما نكون لقاء حين نغضب وانا لنءثر الجياد علي الاولاد والسلاح علي اللقاح والنصر من الله عز وجل يديلنا مرة ويديل علينا اخري لعلك اخو قريش قال ابو بكر رضي الله عنه وقد بلغكم انه رسول الله فها هوذا قال مفروق بلغنا انه يذكر ذلك فالي ما يدعو يا اخا قريش
 فتقدم رسول الله صلي الله عليه وسلم فجلس وقام ابو بكر يظله بثوبه فقال
 ( ادعوكم الي شهادة ان لا اله الا الله وحده لا شريك له واني رسول الله والي  ان تءوني وتنصروني فان قريشا قد تظاهرت علي امر الله وكذبت رسله وامتنعت بالباطل عن الحق والله هو الغني الحميد )
 فقال مفروق والي ما تدعونا ايضا
 فقال رسول الله صلي الله عليه وسلم @QB@ قل تعالوا اتل ما حرم ربكم عليكم الا تشركوا به شيءا @QE@ الاية
 فقال مفروق الي ما تدعونا ايضا فوالله ما سمعت كلاما هو اجمل من هذا ولو كان من كلام اهل الارض لفهمناه
 قال رسول الله صلي الله عليه وسلم @QB@ ان الله يامر بالعدل والاحسان @QE@ الاية
 فقال مفروق دعوت والله الي مكارم الاخلاق ومحاسن الاعمال ولقد افك قوم كذبوك وظاهروا عليك وهذا هانء بن قبيصة شيخنا وصاحب ديننا
 فقال ابن قبيصة قد سمعت مقالتك يا اخا قريش واني اري تركنا ديننا واتباعنا اياك ولكن نرجع وترجع وننظر وتنظر وهذا المثني بن حارثة شيخنا وصاحب حربنا
 فقال المثني قد سمعت مقالتك يا اخا قريش والجواب جواب هانء بن قبيصة وانا انما نزلنا بين صريي اليمامة
 فقال رسول الله صلي الله عليه وسلم ( وما هاتان الصريان )
 قال مياه العرب ما كان منها مما يلي انهار كسري فذنب صاحبه غير مغفور وعذره غير مقبول وانما نزلنا علي عهد اخذه كسري علينا ان لا نحدث حدثا ولا نءوي محدثا فانا اري ان هذا الامر الذي تدعونا اليه تكرهه الملوك فان  شءت نءويك وننصرك مما يلي مياه العرب فعلنا
 فقال رسول الله صلي الله عليه وسلم ما اساتم في الرد اذ افصحتم بالصدق وان دين الله تعالي لن ينصره الا من احاطه من جميع جوانبه ارايتم ان لم تلبثوا الا قليلا حتي يورثكم الله ارضهم وديارهم واموالهم ويفرشكم نساءهم اتسبحون الله وتقدسونه
 فقال النعمان بن شريك اللهم لك ذلك
 فتلي رسول الله صلي الله عليه وسلم @QB@ انا ارسلناك شاهدا ومبشرا ونذيرا وداعيا الي الله باذنه وسراجا منيرا @QE@ ثم نهض قابضا علي يد ابي بكر وهو يقول اية اخلاق في الجاهلية ما اشرفها يدفع الله بها باس بعضهم عن بعض وبها يتحاجزون فيما بينهم
 فما برحنا حتي بايعوا رسول الله صلي الله عليه وسلم وكانوا صدقا صبرا
