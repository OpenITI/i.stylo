  صفحة فارغة  بسم الله الرحمن الرحيم رب يسر واعن الحمد لله المستعلي عن الشبيه والنظير ، المستغني عن المشير والظهير ، البعيد بجلاله وكبرياءه ، القريب بعطفه علي اولياءه ، السميع بلا جارحة واعية ، البصير الذي لا تخفي عنه خافية . احمده علي صدق اليقين ، واساله شكر الموحدين المتقين ، واستمده الرشاد والهداية ، واومن بالاعادة كما كانت منه البداية ، واعوذ به ان اتخذ الهوي الها ، وان اجعل له اندادا واشباها . والصلاة علي نبينا المصطفي ، ورسوله المجتبي ، المبعوث جلاء للافهام من صدا الارتياب ، وشفاء للاوهام من علل الشبهات والاوصاب ، وعلي اله مصابيح كل ليل داج مظلم ، ومفاتيح كل مشكل مستبهم . 
  الباب السابع والعشرون في الاوصاف والنعوت
 في الكتاب العزيز رواءع من التشبيهات ، وبداءع من الاوصاف ، وانا الم بذكر شء منها ثم اعود الي انواع ما جاء في هذا المعني مضيفا كل معني الي جنسه . فمن ذلك قوله تعالي في صفة الافعال : ' مثل الذين كفروا بربهم اعمالهم كرماد اشتدت به الريح في يوم عاصف ' ابراهيم :  . وقوله عز وجل : ' والذين كفروا اعمالهم كسراب بقيعة يحسبه الظمان ماء حتي اذا جاءه لم يجده شيءا ' النور :  . وقوله عز وجل : ' والقمر قدرناه منازل حتي عاد كالعرجون القديم ' يس :  ، وقوله سبحانه وتعالي : ' الله نور السموات والارض مثل نوره كمشكاة فيها مصباح ، والمصباح في زجاجة ، الزجاجة كانها كوكب دري يوقد من شجرة مباركة زيتونة لا شرقية ولا غربية يكاد زيتها يضء ولو لم تمسسه نار ، نور علي نور ' النور :  . ويشتمل هذا الباب علي اربعين نوعا : الخيل وما يتبعها . وصف البغال والحمير . الابل . الفيل . الاسد . وحش الفلاة وسباعها . القنص والاته واماكنه من الحيوان . الطير . انواع شتي من الحيوان . الحية . الهوام والحشرات . النساء : لباسهن وزينتهن . الغلمان السودان . السماء والنجوم وما يتعلق بها . الليل والصبح وما جاء في طول الليل وقصره . السحاب والغيث وما كان مهما . الرياح . الخصب والمحل . المياه والغدران والانهار . السفن والبحر . الرياض  والازهار . النخل والشجر . الحرب والجيش . السلاح والجنن . انواع القتل والجرح . الابنية والمعاقل . الديار والرسوم . الفلاة . السير والسري . البيان والمحاورة . القوافي . الكتاب والقلم والاتهما . النار والحر وما يتنوع منهما . القر والصلا . الماكل والاكول . القدر . الملاهي . الشواذ . النوادر . وصل الخيل قال رسول الله صلي الله عليه وسلم : الخيل معقود في نواصيها الخير . وخص الناصية من بين ساءر الاعضاء لان العرب تقول : فلان مغضور الناصية اي مباركها . وقال صلي الله عليه وسلم ، وذكر الخيل : بطونها كنز وظهورها حرز وروي عن مكحول قال : سبق رسول الله صلي الله عليه وسلم علي فرس فجثا علي ركبتيه وقال : انه لبحر . فقال عمر ، رضي الله عنه : كذب الحطيءة حيث يقول : وان جياد الحيل لا تستفزناولا جاعلات الريط فوق المعاصم وقد امر الله عز وجل باعدادها ارهابا لاعداءه . وكانت العرب تفتخر بارتباطها وتراه من اسري ماثرها وتجيع لها العيال . والاخبار في ذلك تجء في اماكنها . وهذا موضع اثبات ما جاءفي اوصافها من معني بديع ولفظ بليغ .  والمقدم في ذلك قول امرء القيس ، وليس اخلاقه بتداول الالسن بمانعه من هذه الرتبة : وقد اغتدي والطير في وكناتهابمنجرد قيد الاوابد هيكل مكر مفر مقبل مدبر معاكجلمود صخر حطه السيل من عل له ابطلا ظبي وساقا نعامةوارخاء سرحان وتقريب تتفل وقال بشر بن ابي خازم الاسدي يصف جملة خيل : متي ما ادع في اسد تجبنيعلي خيل مسومة صيام تراها نحو داعيها سراعاكما انسل الفريد من النظام وقال الاسعر بن ابي حمران الجعفي : باعوا جوادهم لتسمن امهمولكي يعود علي فراشهم فتي لكن قعيدة بيتنا مجفوةباد جناجن صدرها ولها غني تقفي بغيبة اهلها وثابةاو جرشع عبل المحازم والشني ولقد علمت علي تجشمي الرديان الحصون الخيل لا مدر القري راحوا بصاءرهم علي اكتافهموبصيرتي يعدو بها عتد واي  نهد المراكل مدمج ارساغهعبل المعاقم لا يبالي ما اتي اني وجدت الخيل عزا ظاهراتنجي من الغمي ويكشفن الدجي ويبتن بالثغر المخوف طليعةويبتن للصعلوك حكة ذي الغني يحرجن من خلل الغبار عوابساكاصابع المقرور اقعي فاصطلي وقال مزرد بن ضرار اخو الشماخ : وعندي اذا الحرب العوان تلقحتوابدت هواديها الخطوب الزلازل اجش صريحي كان صهيلهمزامير شرب جاوبتها جلاجل متي ير مركوبا تقل باز قانصوفي مشيه عند القياد تساتل تقول اذا ابصرته وهو صاءمخباء علي نشز او السيد ماثل خروج اضاميم واحصن معقلاذا لم يكن الا الجياد معاقل يري طامح العينين يرنو كانهمءانس ذعر فهو بالانس خاتل وصم الحوامي ما يبالي اذا عدااوعث نقا عنت له ام جنادل وقال جرير يصف حالا منها : وطوي الطراد مع القياد بطونهاطي التجار بحضرموت برودا وقيل لاعرابي : كيف عدو فرسك ؟ فقال : يعدو ما وجد ارضا .  وقال زهير بن ابي سلمي : صبحت بمشتد النواشر سابحممر اسيل نهد مراكله امين شظاه لم يخرق صفاقهبمنقبة ولم تقطع اباجله اذا ما غدونا نبتغي الصيد مرةمتي نره فاننا لا تخاتله فبتنا عراة عند راس جوادنايزاولنا عن نفسه ونزاوله فنضربه حتي اطمان قذالهولم يطمءن قلبه وخصاءله النواشر : عروق الذراع ، واحدها ناشرة ، والنهد : الضخم ، والممر : المفتول ، والشظا : عظم ملصق بالذراع ، وبعضهم يقول : الشظايا : انشقاق العصب . والصفاق : الجلدة السفلي تحت الجلد عليه الشعر . المنقب : حيث ينقب البيطار من البطن ، والمنقبة حديدة ينقب بها البيطار ، وتقال منقبة بكسر الميم ، والخصاءل جمع خصيلة وكل لحمة في عصبة خصيلة . وقال زهير ايضا : ولقد غدوت علي القنيص بسابحمثل الوذيلة جرشع لام قيد الاوابد ما يغيبهاكالسيف ولا ضرع ولا قحم صعل كسافلة القانة من ال . . . مران ينفي الخيل بالعذم الوذيلة : الفضبة شبه بريقه وصفاءه بها ، والجرشع : الضخم الجنبين واللام : الملتءم الشديد والسيد : الذءب ، والضرع : الصغير السن . القحم : الكبير . والصعل : الدقيق العنق الصغير الراس . والمران : شجر تتخذ منه الرماح . والعذم : العض .  وقال اخر : جاء كلمع البرق جاش ما طرهتسبح اولاه ويطفو اخره فما يمس الارض منه حافره وصف عبد الحميد فرسا ركبها فقال : همها امامها ، وسوطها عنانها ، وما ضربت قط الا ظلما . وصف ابن القرية فرسا اهداه الحجاج الي عبد الملك بن مروان فقال : قد وجهت اليك بفرس اسيل الخد ، حسن القد ، يسبق الطرف ، ويستغرق الوصف . وقال عبد العزيز الحمصي في وصف فرس : كانه الا علا دعاء ، واذا هبط قضاء . وقال النجاشي الحارثي : ونجي ابن حرب سابح ذو علالةاجش هزيم والرماح دواني من الاعوجيات الطوال كانهعلي شرف التقريب شاة اران شديد علي فاس اللجام شكيمهيفرج عنه الربو بالعسلان كان عقابا كاسرا تحت سرجهيحاول قرب الوكر بالطيران اذا قلت اطراف العوالي ينلنهمرته به الساقان والقدمان  اذا ابتل بالماء الحميم رايتهكقادمة الشءبوب ذي النفيان كان جنابي سرجه ولجامهمن الماء ثوب ماتح خضلان جزاه بنعمي كان قدمها لهبما كان قبل الحرب غير مهان وقال ابو تمام في وصف فرس اصفر : يكاد يجري الجادي من ماء عطفي . . . ه ويجني من متنه الورس هذب في جنسه ونال المديبنفسه فهو وحده جنس ضمخ من لونه فجاء كانقد كشفت في اديمه الشمس وقال البحتري في مثله : شية تخدع العيون تري ان . . . ن عليه مها سحالة تبر صبغة الافق بين اخر ليلمنقض شانه واول فجر وقال ابو تمام : تري رزان القوم قد اسمحتعيونهم في حسنه فهي شوس كانما لاح لهم بارقفي المحل او زفت اليهم عروس سام اذا استعرضته زانهاعلي رطيب وقرار يبيس كانما خامره اولقاو غازلت هامته الخندريس عوذه الحاسد بخلا بهورفرفت خوفا عليه النفوس وقال البحتري وكان وصافا للخيل :  اما الجواد فقد بلونا يومهوكفي بيوم مخبرا عن عامه جاري الجياد فطار عن اوهامهاسبقا وكاد يطير عن اوهامه جذلان تلطمه جوانب غرةجاءت مجء البدر عند تمامه واسود ثم صفت لعيني ناظرجنباته فاضاء في اظلامه مالت نواحي عرفه فكانهاعذبات اثل مال تحت حمامه وكان فارسه وراء قذالهردف فلست تراه من قدامه لانت معاطفه فخيل انهللخيزران مناسب بعظامه في شعلة كالشيب مر بمفرقيغزل لها عن شيبه بغرامه وكان صهلته اذا استعلي بهارعد يقعقع في ازدحام غمامه مثل الغراب مشي يباري صحبهبسواد صبغته وحسن قوامه والطرف اجلب زاءر لمءونةما لم تزره بسرجه ولجامه وقال يستهدي ابن حمدي فرسا : فاعن علي غزو العدو بمنطواحشاءه طي الكتاب المدرج اما باشقر ساطع اغشي الوغيمنه بمثل الكوكب المتاجج متسربل شية طلت اعطافهبدم فما يلقاك غير مضرج او ادهم صافي السواد كانهتحت الكمي مظهر بيرندج ضرم يهيج السوط من شءبوبههيج الجناءب من حريق العرفج خفت مواقع وطءه فلو انهيجري برملة عالج لم يرهج او اشهب يقق يضء وراءهمتن كمتن اللجة المترجرج يخفي الحجول ولو بلغن لبانهفي ابلق متالق كالدملج اوفي بعرف اسود متغربفيما يليه وحافر فيروزجي  او ابلق يلقي العيون اذا بدامن كل لون معجب بنموذج ارمي به شوك القنا واردهكالسمع اثر فيه شوك العوسج وقال : واغر في الزمن القديم محجلقد رحت منه علي محجل كالهيكل المبني الا انهللحسن جاء كصورة في هيكل ذنب كما سحب الرداء فذب عنعرف وعرف كالقناع المسبل تتوهم الجوزاء في ارساغهوالبدر غرة وجهه المتهلل صافي الاديم كانما عنيت بهلصفاء نقبته مداوس صيقل وكانما نقضت عليه صبغهاصهباء للبردان او قطربل وتخاله كسي الخدود نواعمامهما تواصلها بلحظ تخجل ملك العيون فان بدا اعطيتهنظر المحب الي الحبيب المقبل هزج الصهيل كان في نغماتهنبرات معبد في الثقيل الاول وقال ابن المعتز : اسرع من ماء الي تصويبومن وقوع لحظة المريب ومن نفوذ الفكر في القلوب وقال : قد ضحكت غرته في موضع التقطيب  وقال ابو الفرج الببغا : ان لاح قلت ادمية ام هيكلاو عن قلت اسابح ام اجدل تتخاذل الالحاظ في ادراكهويحار فيه الناظر المتامل فكانه في اللطف فهم ثاقبوكانه في الحسن حظ مقبل وقال محمد بن هانء واغرق في المبالغة : عرفت بساحة سبقها لا انهاعلقت بها يوم الرهان عيون فاجل علم البرق فيها انهامرت بجانحتيه وهي ظنون ويستحب العرب في الخيل ان يطول بطنه ، ويقصر ظهره ، ويشرف منسجه ، وتعرض اوظفة رجليه ، وتحدب اوظفة يديه ، ويدق زوره وهو الصدر ، وتعظم بركته ، والبركة عظم الصدر وما عليه من اللحم ، فاذا اسقطوا الهاء فتحوا الباء فقالوا بركا ، وكان يقال لزياد اشعر بركا ، وكان كثير شعر الصدر ، وان يرهل منكباه ، ويتسع جلده ، ويرق اديمه ، وتقصر شعرته ، ويطول عنقه ، ويعرض منخره ، ويدق مذبحه ، ويلهز ماضغه ، اي يغلظ فيكثر عصبه ، وان يعرض خداه ، ويرق مستطعمه اي جحافله ، ويتسع منخره ، ويرحب شدقاه ، ويجشع حجاجه ، ويحد كعبه وطرفه وعرقوبه ، وتءلل اذنه ، وتتسع ضلوعه ، وتقصر طفطفته ، ويعرض كتفه ووركه وجبهته ، ويلحب متنه فيقل لحمه وتظما فصوصه ، وتتمحص قواءمه ، وتمكن ارساغه ،  ويشتد صهيله ويضحي عجانه ، اي يظهر ، وتحبط قصيراه ، وهي اخر الاضلاع اي ينتفج جنباه ، ويشرف عنقه ، والتحنيب في الرجلين شبه الروح ، وهو ان يكون فيهما ميل الي وحشيهما . ويستحب طول الوظيفين في الرجلين ، وقصر الوظيفين في اليدين . ويكره في الخيل الهضم وهو اضطمار الجنبين ، والقنا وه احديداب الانف ، وعظم الزور ، وقصر العصبة ، وغلظ العنق ، واضطراب الاذن ، طول اشعر ، وكثرة لحم المتن ، وقصر الضلع ، وطول العسيب ، وضيق الجلد علي الكتف ، وضيقه علي العضد ، وغظ الذفري والجفحلة ، وكثرة لحم الوجه ، واستدارة القواءم ، واضطراب الحوافر ورححها ، واستواء مقدمه ومءخره ، وظهور النسور ، وقلة الدماع ، وضعف الضرس ، واصطراب المتن ، ودنو الصدر من الارض ، ونكس الجاعرة ، وطمانينة القطاة ، وضيق الشدق ، وانمساخ الحماة ، اي اضطمارها ، وموج الربلة ، وطول النسا ، والفحج الفاحش ، والبدد في اليدين ، وهو تباعد ما بين الركبتين والاقعاد في الرجلين ، وهو ان تفرش جدا فلا ينتصب ، ويقال مفروش الرجلين ، والعزل وهو ميل في الذنب في احد الشقين . وهذا القدر كاف ليعرف المحمود منها فتصفه والمذموم فتجتنبه ، ولا نتعداه الي ذكر انساب الخيل ، واسماء المشهورة منها ، وانواع مشيها وجرها ، والعيوب في كل عضو من اعضاءها ، واصناف الوانها وشياتها واسنانها ، فنخرج عن فن الكتاب ومقصده . ونعود الي ما قيل في وصفها : قال ابن نباتة السعدي :  يا ايها الملك الذي اخلاقهمن خلقة ورواءه من راءه قد جاءنا الطرف الذي اهديتههاديه يعقد ارضه بسماءه اولاية اوليتنا فبعثتهرمحا سبيب العرف عقد لواءه تختال منه علي اغر محجلماء الدياجي قطرة من ماءه وكانما لطم الصباح جبينهفاقتص منه وخاض في احشاءه متهللا متمهلا والبرق من اسماءهمتبرقعا والحسن من اكفاءه ما كانت النيران يكمن حرهالو كان للنيران بعض ذكاءه لا تعلق الالحاظ في اعطافهالا اذا كفكفت من غلواءه فهناك تنتهب العيون كانماوقف الوجيه عليه من اباءه لا يكمل الطرف المحاسن كلهاحتي يكون الطرف من اسراءه اشتري شاب من العرب فرسا فجاء الي امه وقد كف بصرها فقال : يا اماه ، قد ابتعت فرسا . قالت : صفه لي ، قال : اذا استقبل فظبي ناصب ، واذا استدبر فهقل خاضب ، واذا استعرض فسيد قارب ، مءلل المسمعين ، طامح الناظرين ، مذعلق الصبيين . قالت : اجودت ان كنت اعربت ، قال : انه مشرف التليل ، سبط الخصيل ، وهواه الصهيل ، قالت : اكرمت فارتبط . الهقل : الذكر من النعام ، والانثي هقلة . والخاضب : الذي اكل الربيع فاحمرت ظنبوباه واطراف ريشه . والسيد : الذءب ، ومءلل : محدد ، وطامح : مشرف ، والذعلوق : نبت يشبه الكراث يلتوي وهو طيب للاكل . والصبيان : مجتمع لحييه من مقدميهما . قال ابو عبيدة : الصبيان العظمان المنحنيان من حرفي وسط اللحيين من ظاهرهما عليهما لحم ، والحصيل : كل ما انماز من لحم الفخذ بعضه من بعض ، والوهوهة : صوت تقطعه .  وقال شاعر : فوق طرف كالطرف في سرعة الشد . . . د وكالقلب قلبه في الذكاء ما تراه العيون الا خيالاوهو مثل الخيال في الانطواء وقال عبد الكريم بن ابراهيم النهشلي المغربي : بيوم تسامي فيه ورد مسومواشقر بعبوب وسابحة حجر ودهم كان الليل القي رداءهعليها فمرفوع النواحي ومنجز وقبلها ضوء الصباح كرامةفهم الي التحجيل مرثومة غر وبلق تقاسمن الدجنة والضحيفمن هذه شطر ومن هذه شطر ولاحقة الاقراب لو جازت الصباكبت خلفها واعتاق ريح الصبا حسر كراءم مكتوم ابوها ومذهبيلوح عليهن المشابه والنجر مجزعة غر كان جلودهاتجزع فيها اللءلء الرطب والشذر وصفر كان الزعفران خضابهاوالا فمن ماء العقيق لها قشر وشهب من اللج استعيرت متونهاومن طرر الاقمار اوجهها القمر اذا هزها مشي العرضنة عارضتقدود العذاري هز اعطافها السكر سوابق بشرن الربيع منوراعليك يباهيه ربيعك والنشر وقال ابن ميخاءيل المغربي : ولقد ذعرت الوحش وهي كوانسبوثيق اوظفة اليدين اذا ارتمي من نسل اعوج هيجته فكانماحاولت برقا لاح او غيثا همي ذي غرة محفوفةبسواده كالنجم اشرق في ظلام ادهما  يجري لغاية ما اريد كانهعلم المراد فما يريد معلما وقال غيلان بن الحريث : قد اغتدي والليل داج سترهوالصبح قد كادت تضء طرره باعوجي حسن معذرهمرتفع الحارك وحف عذره يكاد مما يزدهيه اشرهيطير لولا اننا نوقره جاءت فرس لهشام سابقة ، فامر الشعراء ان يقولوا فيها ، فاستمهلوا ، فقال ابو النجم : بل لك من ينقدك اذا استنساوك ؟ قال : هات ، فقال : اشاع للغراء فينا ذكرهاقواءم عوج اطعن امرها ملبوة شد المليك اسرهااسفها وبطنها وظهرها يكاد هاديها يكون شطرها وقال محمد بن هانء : ان شيم اقبل عارضا متهللااو ريع اقبل خاضبا اجفيلا صلتان يعنف بالبروق لوامعاولقد يكون لامهن سليلا يستغرق الشاو البعيد معنقاويجء سابق حلبة مشكولا ونتبع هذا الفصل ما جاء في :  وصف البغال والحمير : قال البحتري يذكر بغلا : واقب نهد للصواهل شطرهيوم الفخار وشطره للشحج خرق يتيه علي ابيه ويدعيعصيبة لبني الضبيب واعوج مثل المذرع جاء بين عمومةفي غافق وخءولة في الخزرج وقال الحطيءة في حمار : رباع ابوه اخدري وامهمن الحقب فحاش علي العرس باسل عبد الكريم بن ابراهيم النهشلي المغربي يصف حمار الوحش : واخرج صلصال لاخدر ينتميامين الفصوص لم يدمث له ظهر كان العيون النجل صيغت بجلدهرات رقباء فهي مشطورة خزر تولع منها الجلد حتي كانماصباح وليل فيه حطهما قدر تعاطي لباس الخيل فاختال راكضاله حلة لا تدعي لبسها الحمر كان الحجار الصلبية قدرتفجاءت لها وفقا حوافره الحفر اذا اختال واستولي به رديانهتوالي صفير منه ترجيعه تبر وقال بعضهم : اذا اشتريت بغلة فاشترها طويلة العنق  تجده  في نجاءها ، مشرفة الهادي  تجده في طاعتها ، مجفرة الجوف  تجده في صبرها . كان خالد بن صفوان والفضل بن عيسي الرقاشي يختاران ركوب الحمار ويجعلان ابا سيارة الذي يضرب المثل بحماره فيقال : اصح من عير ابي سيارة قدوة لهما وحجة . وقيل للفضل لم تركبه ؟ فقال : لانه اقل الدواب مءونة ، واكثرها معونة ، واسلمها جماحا ، واخفضها مهوي ، واقربها مرتقي ، يزهي راكبه وقد تواضع بركوبه ، ويدعي مقتصدا وقد اسرف في ثمنه ، ولو شاء ابو سيارة لركب جملا مهريا ، او فرسا عربيا ولكنه امتطي عيرا اربعين سنة . وقال خالد بن صفوان : عير من نسل الكداد ، اصحر السربال ، محملج القواءم ، مفتول الاجلاد ، ويحمل الرحلة ، ويبلغ العقبة ، ويقل داءه ، ويخف دواءه ، ويمنعني ان اكون جبارا عنيدا ، ولولا ما في الحمار من المنافع ما امتطاه ابو سيارة اربعين سنة . فعارضهما اعرابي فقال : الحمار ان ركبته ادلي ، وان تركته ولي ، كثير الروث ، قليل الغوث ، سريع الي الغرارة ، بطء في الغارة ، لا ترقا به الدماء ، ولا تمهر به النساء ، ولا يحلب في الاناء . صفات الابل قال عبدة بن طبيب : وقام الي وجناء كالفحل حرةبثني زمام بعد ما كان يشرق  رجيع براها الكور الا جناجنافقد جعلت في صفرة النسع تقلق لها عجز كالباب سد رتاجهيطوف به بوابه وهو مغلق وزور كطي البءر جاب ضلوعهوابط ودف كالخليط ومرفق ومستنتل كالكور فعم يزينهدسيع بصفقيه وداي موثق المستنتل : المتقدم ، يعني متقدم سنامها وفعم ممتلء ، والدسيع : مغرز العنق في الزور ، وصفقاه جانباه . واتلع فيه بالزمام نحيلهيضايقه منها اذا شاء مصدق وساجيتان يطحران قذاهماووجه عليه نقبة العنق تبرق النقبة : ها هنا الاثر ، وهي في غير هذا اللون ، وهي الجرب ايضا . نجاة اذا كلت كان صريفهاوقد قلقت انساعها فهي محنق ترنم خطاف بحبلي محالةله محور يجري بدلوين اخلق شبه صرير انيابها بصوت خطاف البكرة ، واخلق : املس ، يعني المحور . وعوج تحاسي بالحصي كل وجهةولاء كما ارفض الزجاج المفلق تحاسي : اي ترمي به حسا ، اي فردا ، في كل ناحية . ترد يداها خلفها ما اصابتاوتنجر رجلاها نفيا فيلحق وتعطيه منها كلما جد جدهاهويا كتخليط المءارب ادفق النفي : ما تطاير منه ، والمءارب : الضارب بالقداح ، ورفع ادفق علي الاستءناف . وقال الاقرع بن معاذ القشيري : مذكرة الثنيا مساندة القراجمالية تجتب ثم تنيب مخيسة ذلا ونتحسب انهااذا ما بدت للناظرين قضيب  كمثل اتان الوحش اما فءادهافصعب واما ظهرها فركوب تري ظلها عند الرواح كانهاالي جنبها رال يخب جنيب يشج بها الموماة مستحكم القويله من اخلاء الصفاء حبيب متين حبال الود مطلع العدااكول علي غيظ الرجال شروب وقال زهير بن ابي سلمي : ثنت اربعا منها علي ثني اربعفهن بمثنياتهن ثماني اليك من الغور اليماني تدافعتيداها ونسعا غرضها قلقان تظل تمطي في الزمام كانهااذا بركت قوس من الشريان نهوز بلحييها امام سفارهاومعتلة ان شءت في الجمزان الغرض : حزام الرحل ، والشريان : شجر تتخذ منه القسي ، وحرك الراء . والنهوز : التي تمد عنقها تنهز به الزمام من نشاطها . والسفار : حديدة تجعل علي انف البعير مثل الحكمة ، وجماعها سفر . وقال ذو الرمة : كان راكبها يهوي بمنخرقمن الجنوب اذا ما ركبها نصبوا تشكو الخشاش ومجري النسعتين كماان الجريح الي عواده الوصب لا تشتكي سقطة منها وقد سقطتبها المفارز حتي ظهرها حدب تخدي بمنخرق السربال منصلتمثل الحسام اذا اصحابه شحبوا تصغي اذا شدها بالكر جانحةحتي اذا ما استوي في غرزها تثب وقال :  سري ثم اغفي عند روعاء حرةتري خدها في ظلمة الليل يبرق رجيعة اسفار كان زمامهاشجاع لدي يسري الذراعين مطرق وقال ايضا : المت بشعث كالسيوف واينقحراجيج من نسل الجديل وداعر جذبن البري حتي شدقن واصعرتانوف المهاري لقوة في المناخر شدقن : مله ، يقول ما لعنقها حتي كان به لقوة ، والحراجيج : الطوال واحدها حرجوج . وقال الشماخ : كان ذراعيها ذراعا مدلةبعيد السباب حاولت ان تعذرا كان بذفرها مناديل فارقتاكف رجال يعصرون الصنوبرا كان ابن اوي موثق تحت غرضهااذا هو لم يكلم بنابيه ظفرا شبه يديها بيدي مدلة بجمال ومنصب قد سابت واقبلت تعتذر ، ووصفها بسواد الذفري وهي اعلي القفا ، ووصفها بانها ليست تستقر فكان ابن اوي يعضها بنابيه . ومثل البيت الاول قول الاخر : كان ذراعيها ذراعا بذيةمفجعة لاقت ضراءر عن عفر وقال بشامة بن الغدير :  كان يديها اذا ارقلتوقد جرن ثم اهتدين السبيلا يدا سابح خر في غمرةوقد شارف الموت الا قليلا اذا اقبلت قلت مشحونةاطاعت لها الريح قلعا جفولا وان ادبرت قلت مذعورةمن الربد تتبع هيقا ذمولا وقال الاخطل : ومهمه طامس تخشي غواءلهقطعته بكلوء العين مسفار بحرة كاتان الضحل اضمرهابعد الربالة ترحالي وتسياري الضحل : الماء القليل . والربالة : السمن . اخت الفلاة اذا شدت معاقدهازلت قوي النسع عن كبداء ميهار كانها برج رومي يشيدهلز بجص واجر واحجار وقال في ذلك ايضا : ومحبوسة في الحي ضامنة القرياذا الليل وافاها باشعث ساغب معقرة لا يدرك السيف وسطهااذا لم يكن فيها معس لحالب مرازيح في الماوي اذا هبت الصباتطيف اوابيها باكلف ثالب  اذا ما الدم خودر عزمه وناب رهناها باعلي النواءب وقال كثير : المت بنا والعيس تسري كانهااهلة محل زل عنها قتامها وقال القطامي : يمشين رهوا فلا الاعجاز خاذلةولا الصدور علي الاعجاز تتكل فهن معترضات والحصي رمضوالريح ساكنة والظل معتدل وقال ايضا : اذا بركت خرت علي ثفناتهامجافية صلبا كقنطرة الجسر كان يديها حين تجري ضفورهاطريدان والرجلان طالبتا وتر وقال عنترة بن عبفس النميري من ابيات : فراحت ترامي في الزمان كانهاسحابة صيف اخر الليل امطرا وقال الفرزدق : تنفي يداها الحصي في كل هاجرةنفي الدراهم تنقاد الصياريف وقال اخر ويروي للقصافي ، وهو عمر بن نصر التميمي :  قال دعبل : ان القصافي قال الشعر ستين سنة ، فلم يعرف له الا هذا البيت : خمص نواج اذا حث الحداة بهاحسبت ارجلها قدام ايديها وقال الغطمش الضبي : كان يديها حين جد نجاءهايدا سابح في غمرة يتبوع وقال رءبة : كان ايديهن بالقاع القرقايدي جوار يتعاطين الورق وقال مروان بن ابي حفصة : يتبعن جاهلة الزمام كانهااحدي القناطر وهي حرف ضامر وقال بشار : واذا المطي متحن في اعطافهفات المطي بكاهل وتليل وكانه والناعجات يردنهقدح تطلع من قداح مجيل وقال سالم بن عمرو الخاسر : وكانهن من الكلال اهلةاو مثلهن عواطف الاقواس  قود طواها ما طوت من مهمهنابي الصوي ومناهج ادراس وقال العتابي يصف كلالها : اذ الركاءب مخسوف نوظرهاكما تضمنت الدهن القوارير وقال ابو نواس : الا حبذا عيش الوحاد وضجعةالي جنب مقلاق الوضين سعوم الوضين للبعير مثل الحزام للدابة . والسعوم : الواسعة الخطو . ترامت بها الاهوال حتي كانمانحيف من اقطارها بقدوم وقال في سرعتها : وتجشمت بي هول كل تنوفةهوجاء فيها جراة اقدام تذر المطي وراءها وكانهاصنف تقدمهن وهي امام وقال الرضي : قعدت بها الاخفاف من طول السريمحسورة ومشت بها الاعراق وقال ابو تمام : اتينا القادسية وهي ترنوالي بعين شيطان رجيم فما بلغت بنا عسفان حتيرنت بلحاظ لقمان الحكيم  وبدلها السري بالجهل حلماوقد اديمها قد الاديم بدت كالبدر وافي ليل سعدوابت مثل عرجون قديم وقال البحتري : يترقرقن كالسراب وقد خض . . . ن غمارا من السحاب الجاري كالقسي المعطلات بل الاس . . . هم مبرية بل الاوتار وقال ايضا : كالربي في الربي ويحسبن احيانا نسوعا مجدولة في نسوع وقال ابن المعتز : ترنو بناظرة كان حجاجهاوقب اناف بشاهق لم يحلل وكان مسقطها اذا ما عرستاثار مسقط ساجد متبتل وكان اثار النسوع بدفهامسري الاساود في هيام اهيل قال الاصميع : وصف اعرابي ناقة فقال : تقطع الارض عرضا ، وترض الحجارة رضا ، وتنهض في الزمام نهضا ، سريعة الوثوب ، بطيءة النكوب ، مدلاج سروب . وقال اعرابي اخر : اذا اكحالت عينها ، واللت اذنها ، وسجح خدها ، وهدل مشفرها ، واستدارت جمجمتها ، فهي الكريمة .  وقال اعرابي : انزع بدلويك لحمر كالضربفهي صواف لونها من الرتب كالفضة البيضاء حيصت بالذهببنات ذيال صهابي اقب حناجر يوعبن احرار القلبكالوحد الاحقب او ثور العرب او كاديم الصرف او عرق النجب وصف الفيل : قال عبد الصمد بن بابك : وممسك البردين فيشبه النقا شية وقدا فكانما نسجت علي . . . ه يد السحاب الجون جلدا واذا لوتك صفاتهاعطتك متن الدرع نقدا فكان معصم غادةفي ماضغيه اذا تصدي وكان عودا عاطلافي صفحتيه اذا تبدي جاب المطوق قد تفر . . . رد بالكرامة واستبدا فاذا تجلل هضبةفكان جنح الليل مدا واذا هوي فكان رك . . . نا من عماية قد تردي واذا استقل رايت في اعطافه هزلا وجدا ابو محمد الخازن :  من كل جهم خلته يوم الوغي غولا تصدي وعليه طارونية يزها بها حرا وبردا وكانما خرطومهراووق خمر مد مدا وكانما انقلبت عصا موسي غداة بها تحدي يكسي الحداد وتارةيكسي نسيج الدرع سردا كفل تموج كالكثي . . . ب يميله صوبا وصعدا وكانه يوم الوغييكسي من الخيلاء بردا وما وجدت للعرب شعرا في صفة الفيل الا ما لا طاءل فيه مثل قول رءبة : اجرد كالحصن طويل النابينمشرف اللحي صغير الفقمين عليه اذنان كفضل البردين وكقول ابي الحلال الهدادي : وما كنت يوم الفيل فوق مطيةولكن علي وطفاء جون ربابها وقد واقعه قوم منهم في الاسلام ، وذكروا شجاعتهم في قتاله ، لكنهم لم يصفوه ، وهاتان القطعتان من الشعر فيه سببهما ان الصاحب ابا القاسم ابن عباد حصل علي الفيل في وقعة كانت بجرجان ، فامر الشعراء ان يصفه ، وكان ابو القاسم عبد الصمد بن بابك عنده وهو يتهمه بالانتحال ، وقد انتدب له عدو  ينسبه الي انتحال شعر ابن نباتة ، فامره الصاحب ان يصف الفيل في شعر علي وزن قول عمر بن معد يكرب : اعددت للحدثان سا . . . بغة وعداء علندا فقال ، وقالت الشعراء ، فكانت قصيدته مفضلة علي غيرها ، فحينءذ عرف الصاحب موضعه من الفضل ، وزالت الشبهة في حقه . فقال عدوه : ايها الصاحب هذا معه ستون قصيدة لابن نباتة في نعت الفيل علي هذا الوزن . وقال عبد الكريم النهشلي المغربي : واضخم هندي النجار تعدهملوك بني ساسان ان رابها دهر من الروق لا من ضربة الورق يرتعياضاخ ولا من ورده الخمس والعشر يجء كطود جاءل فوق اربعمضبرة لمت كما لمت الصخر له فخذان كالكثيبين لبداوصدر كما اوفي من الهضبة الصدر ووجه به انف كراووق خمرةينال به ما تدرك الانمل العشر وجنبان لا يروي القليب صداهماولو انه بالقاع منهرت جفر واذن كنصف البرد تسمعه النداخفيا وطرف ينفض الغيب مزور ونابان شقا لا يريد سواهماقناتين سمراوين طعنتهما نتر له لون ما بين الصباح وليلهاذا نطق العصفور او غرد الصقر نعت الاسد قال زهير بن ابي سلمي : ورد غراض الساعدين حدي . . . د الناب بين ضراغم غثر  يصطاد احدان الرجال فماتنفك اجريه علي ذخر وقال مالك بن خالد الهذلي : ليث هزبر مدل عند خيستهبالرقمتن له اجر واعراس احمي الصريمة احدان الرجال لهصيد ومستمع بالليل هجاس وصعب البديهة مشبوب اظافره . . . مواثب اهرت الشدقين هراس دخل ابو زبيد الطاءي علي عثمان رحمه الله فاستنشده فانشده قوله : من مبلغ قومي الناءين اذ شحطواان الفءاد اليهم شيق ولع ووصف الاسد فقال له عثمان : تالله تفتا تذكر الاسد ما حييت ، والله اني لاحسبك جبانا هدانا ، فقال : كلا يا امير المءمنين ، ولكني رايت منه منظرا ، وشهدت مشهدا ، لا يبرح ذكره يتردد ويتجدد في قلبي ، ومعذور انا يا امير المءمنين غير ملوم . فقال له عثمان : واني كان ذلك ؟ قال : خرجت في صيابة  اشراف من افناء قباءل العرب ذوي هيءة وشارة حسنة ، ترتمي بنا المهاري ونحن نريد الحارث بن ابي شمر الغساني ملك الشام ، فاخروط بنا السير في حمارة القيظ حتي اذا عصبت الافواه ، وذبلت الشفاه ، وشولت المياه ، واذكت الجوزاء المعزاء ، وذاب الصيهد ، وصر الجندب ، وضاف العصور الضب وجاوره في جحره ، وقال قاءل : ايها الركب غوروا بنا في ضوج هذا الوادي ، واذا واد قد بدا لنا كثير الدغل ، داءم الغلل ، شجراءه مغنة ، واطياره مرنة ، فحططنا رحالنا باصول دوحات كنهبلات متهدلات ، فاصبنا من فضلات المزاود واتبعناها الماء السلس البارد ، فانا لنصف حر يومنا ومماطلته ، اذ صر اقصي الخيل اذنيه ، وفحص الارض بيديه ، فوالله ما لبث ان جال ثم حمحم فبال ، ثم فعل فعله الفرس الذي يليه واحدا فواحدا ، فتضعضعت الخيل ، وتكعكعت الابل ، وتقهقرت البغال ، فمن نافر بشكاله ، وناهض بعقاله ، فعلمنا ان قد اتينا ، وعلمنا انه السبع ، ففزع كل رجل منا الي سيفه فاستله من جرابه ووقفننا رزدقا ، فاقبل يتظالع كانه مجنوب او في هجار ، لصدره نحيط ، ولبلاعمه غطيط ، ولطرفه وميض ، ولارساغه نقيض ، كانما يخبط هشيما ، ويطا صريما ، واذا هامة كالمجن ، وخد كالمسن ، وعينان سجراوان ، وكانهما سارجان يقدان ، وقصرة ربلة ، وكتد معبط ، وزور مفرط ، وساعد مجدول ، وعضد مفتول ، وكف شثنة البراثن ، الي مخالب كالمحاجن ، فضرب بيده فارهج ، وكشر فافرج عن انياب كالمعاول مصقولة غير مفلولة ، وفم اشدق ، كالغار الاخرق ، ثم تمطي فاشرع بيديه ، وحفز وركيه برجليه ، حتي صار ظله مثليه ، ثم اقعي فاقشعر ، ثم مثل فاكفهر ، ثم تجهم فزبار ، فلا وذو بيته في السماء ما اتقيناه الا باخ لنا من فزارة ، كان ضخم الجزارة ، فوقصه ثم نفضه نفضة  فقضقض متنيه ، وجعل يلغ في دمه . فذمرت اصحابي فبعد لاي ما استقدموا ، فهجهجنا به فكر مقشعرا كان به شيهما حوليا ، فاختلج رجلا اعجز ذا حوايا فنفضه نفضة تزايلت لها مفاصله ، ثم نهم فقرقر ، ثم زفر فبربر ، ثم زار فجرجر ، ثم لحظ ، فوالله لخلت البرق يتطاير من تحت جفونه ، من عن شماله ويمينه ، فارعشت الايدي ، واصطكت الارجل ، واطت الاضلاع ، وارتجت الاسماع ، وشخصت العيون ، وانخزلت المتون ، وساءت الظنون . فقال له عثمان : اسكت قطع الله لسانك فقد ارعبت قلوب المءمنين . قال شعبة ، قلت للطرماح بن حكيم : ما شان ابي زبيد وشان الاسد ؟ فقال : انه لقيه بالنجف ، فلما راه سلح من فرقه ، فكان بعد ذلك يصفه كما رايت . نعت وحش الفلاة وسباعها قال الاخطل يذكر الثور الوحشي : فما به غير موشي اكارعهاذا احس بشخص نابء مثلا كان عطارة باتت تطيف بهحتي تسربل ماء الورس وانتعلا من خضب نور خزامي قد اطاع لهاصاب بالقفر من وسميه خضلا بات الي حقف ارطاة يلوذ بهااذا احس بسيل تحته انتقلا كانه ساجد من نضخ ديمتهمقدس قام تحت الليل فابتهلا ينفي التراب بروقيه وكلكلهكما استماز رءيس المقنب النفلا  وله في مثله : او مقفر خاضب الاظلاف جاد لهغيث تظاهر من ميثاء مبكار بات الي جنب ارطاة تكفءهريح شامية هبت بامطار اذا اراد بها التغميض ارقهسيل يدبب بهدم الترب موار حتي اذا انجاب عنه الليل وانكشفتسماءه عن اديم مصحر عار انس صوت قنيص او احس بهمكالجن يهفون من جرم وانمار فانصاع كالكوكب الدري ميعتهغضبان يخلط من معج واحضار فارسلوهن يذرين التراب كمايذري سباءخ قطن ندف اوتار حتي اذا قلت نالته سوابقها وارهقته بانياب واظفار انحي اليهن عينا غير غافلةوطعن محتقر الاقران كرار تضمه الضاريات اللاحقات بهضم الغريب قداحا بين ايسار وقال ذو الرمة يصف عدو ثورين : لا يذخران من الايغال باقيةحتي تكاد تفري عنهما الاهب وقال ايضا ، ويروي لعدي بن الرقاع في مثله : يتعاوران من الغبار ملاءةبيضاء محكمة هما نسجاها  تطوي اذا وردا مكانا جاسياواذا السنابك اسهلت نشراها خلف الاحمر في مثله : كالكوكب الدري مبتذلاشدا يفوت الطرف اسرعه فكانما جهدت اليتهالا تمس الارض اكرعه وقال الطرماح في مسافر : يبدو وتضمره البلاد كانهسيف علي شرف يسل ويغمد وقال النابغة الذبياني : كانها ذو وشوم بات منكرسافي ليلة من جمادي اخضلت ديما منكرس : منقبض . بات بحقف من البقار يهدمهاذا استكف قليلا تربه انهدما البقار : ارض ذات رمال ، والحقف من الرمل ما استدار . تقال الريح روقيه وكلكلهكالهبرقي تنحي ينفخ الفحما وقال اوس بن حجر يذكر ثورا والكلاب تتبعه : ففاتهم وازمعن اللحاق بهكانهن بجنبيه الزنابير  حتي اذا قلت نالته اواءلهاولو يشاء لنجته المثابير كر عليها ولم يفشل يمارسهاكانه بتواليهن مسرور يشكها بذليق حده سلبكانه حين يعلوهن موتور ثم استمر يباري ظله جذلاكانه مرزبان فاز محبور وقال الشماخ يصف فحل العانة : فوجهها قوارب فاتلابتله مثل القنا المتاودات يعض علي ذوات الضغن منهاكما عض الثقاف علي القناة وهن يثرن بالمعزاء نقعانري منه لهن سرادقات وقال ابو ذءيب يذكره والاتن تتبعه : فكانهن ربابة وكانهيسر يفيض علي القداح ويصدع وكانما هو مدوس متقلببالكف الا انه هو اضلع المدوس : حجر تسن به السيوف . والاضلع والضليع : الغليظ الشديد . وقال الشماخ في الاروي : وما اروي وان كرمت علينابادني من موقفة حرون تطيف بها الرماة وتتفيهمباوعال معطفة القرون  وقال تميم بن ابي بن مقبل يصف الثور : يظل بها ذب الرياد كانهسرادق اغراب بحبلين مطنب تحدر صبيان الصبا فوق متنهكما لاح في سلك جمان مثقب لياح تظل الابدات يسفنهكسوف العذاري ذا القرابة منجب الذب : الذي لا يستقر ، والاغراب : جمع غرب اي قوم غربوا ، صبيان الصبا : صغار القطر ، ولياح : ابيض ، اراد لياح منجب . وقال حميد بن ثور : تري طرفيه يعسلان كلاهماكما اهتز عود الساسم المتتابع ينام باحدي مقلتيه ويتقيبالاخري الاعادي فهو يقظان هاجع نعت القنص والاته واماكنه قال ابن ابي كريمة في الفهد : مدنرة ورق كان عيونهاحواجل تستذري متون الرواكب  اذا قلبتها في العجاج حسبتهاسنا ضرم في ظلمة الليل ثاقب مولعة فطح الجباه عوابستخال علي اشداقها خط كاتب ذوات اشاف ركبت في اكفهانوافذ في صم الصخور نواشب معقفة الترهيف عوج كانهاتعقرب اصداغ الملاح الكواعب توسد اجياد الفراءس اذرعامرملة تحكي عناق الحباءب وقال عبد الصمد في مثله : كانها والخزر من احداقهاوالخطط السود علي اشداقها ترك جري الاثمد في اماقها وقال ابن طاهر فيه : وليس للطراد الا فهدكانما القت عليه الكرد من خلقها او ولدته الاسدوهو كفيل النجح حين يعدو وقال ذو الرمة وذكر كلبا : كانه كوكب في اثر عفريةمسوم في سواد الليل منقضب وقال اخر فيه : تفوت خطاها الطرف سبقا كانهاسهام مغال او رجوم الكواكب  كان بنات القفر حين تفرقتغدون عليها بالمنايا الشواعب وقال ابو نواس فيه : كان متنيه لدي انسلابهمتنا شجاع لج في انسيابه كانما الاظفار في قنابهموسي صناع رد في نصابه تراه في الحضر اذا هاها بهيكاد ان يخرج من اهابه وقال ايضا : ارسله كالسهم غذ غالي بهيسبق طرف العين في التهابه كلمعان البرق في سحابه وقال ابن المعتز : وكلبة يغدو به فتياناطلقهم من يده الزمان كانها اذا تمطت جاناو صعدة وخطمها السنان ونجمت للحظها الغزلانفلحت ما لحق العيان  وقال ايضا : وابصرت سربا من الظباءفغادرتهن بلا اعياء ترضي من اللحوم بالدماء وقال ابو نواس : تحمل حملاقا سريع الطحركانه مكتحل بتبر في هامة لمت كلم الفهروجءجء كالحجر القهقر القهقر : الصلب . وعين طحور : اذا كانت تخرج القذي . وقال : ومنسر اكلف فيه شغاكانه عقد ثمانينا وقال ابن المعتز : ونذعر الصيد بباز اقمركانه في جوشن مزرر وجءجء منمنم محبركانه رق خفي الاسطر وقال ايضا : غدوت في ثوب من الليل خلقبطارح النظرة في كل افق ومقلة تصدقه اذا رمقمبارك اذا راي فقد رزق  وقال ايضا : قد اغتدي في نفس الصباحبقرم للصيد ذي ارتياح معلق الالحاظ بالاشباحعليه منه كحباب الراح وقال ايضا : وزرق ريان من شبابهكان سلخ الايم من اثوابه وقال ايضا : وفتيان غدوا والليل داجوضوء الصبح متهم الطلوع كانه بزاتهم امراء جيشعلي اكتافهم صدا الدروع وقال ابو ذءيب الهذلي في تشبيه الصاءد : حتي استبانت مع الاصباح صاءدهاكانه في حواشي ثوبه صرد وقال ابن الرومي في قوس البندق : متاح لراميها المنايا كانمادعاها له داعي المنايا فاسمعا تقلب نحو الجو عينا بصيرةكعينك بل اذكي ذكاء واسرعا  يحاذرها العفريت عند انصلاتهافيعجله الاشفاق ان يتسمعا لها عولة اولي بها من تصيبهواجدر بالاعوال من كان موجعا وهذا المعني ينظر الي قوله ايضا وذكر امراة : يشكو المحب وتشكو وهي ظالمةكالقوس تصمي الرماية وهي مرنان قال اخر : قد اغتدي ملث الظلام بفتيةللرمي قد حسروا له عن اذرع متنكبين خراءطا لبنادقمن بين مضفور وبين مرصع باكفهم قضبان روض قد غدواللطير قبل نهوضها للمرتع تقذي منيات الطيور عيونهايوما اذا رمدت بايدي النزع صفر البطون كان ليط ظهورهاسرق الحرير نواظر لم تسمع وكتب ابو اسحاق الصابي الي محمد بن العباس بن فسانجس في صفة رمي البندق والته : مارب الناس  اطال الله بقاء سيدنا الوزير  منزلة بحسب قربها من هزل او جد ، ومرتبة علي قدر استحقاقها من ذم او حمد . فاذا وقع المتامل عليها وجد اولاها بان تعتده الخاصة نشوة وملعبا ، والعامة حرفة ومكسبا ، الصيد الذي فاتحته طلاب لذة ووطر ، وخاتمته حصول مغنم وظفر . وقد اشتركت الملوك والسوقة في استجماله ، واتفقت الشراءع المختلفة علي استحلاله ، ونطقت الكتب المنزلة بالرخصة فيه ، وبعثت المروءات علي مزاولته وتعاطيه . وهو راءض للابدان وجامع لشمل الاخوان ، وداع الي اتصال العشرة  منهم والصحبة ، وموجب لاستكمال الالفة بينهم والمحبة . ولما كانت الجوارح المثمنة لكل الناس غير ممكنة ، بل لمن جل منهم قدره ، وعلا فيهم خطره ، وعظم شانه وحاله ، وجم وفره وماله ، جعلت القول مقصورا علي قسي البندق التي لا تتعذر علي مكثر ولا مملق ، ولا تضيق علي اتخاذها يد موسر ولا معسر ، ولو لم افعل ذلك لبلغ الاسف من العادم الفاقد ، اكثر من الجذل من القادر الواجد . لكنني اعتمدت الذي يتوافق في استطاعته الادني والاشرف ، ويتلاحق في التمكن منه الاقوي والاضعف ، فانا اكتفي في ترغيب من كان عنه منحرفا ، وتثبيت من كان اليه تشوفا ، بوصف موقف منه شهدته ، ومنظر استحسنته ، في بعض ظواهر مدينة السلام : هناك غيضة ذات ماء صاف ازرق ، وشجر مرجحن مورق ، فبينا انا ماثل فيها ، متنزه في نواحيها ، وقد تضوعت بالارج ارجاءها ، وتاودت في حلل الورد شجراءها ، وتفاوحت بفواءح المسك انوارها ، وتفاوضت بغراءب النطق اطيارها ، اذ ابلت رفقة من الرماة قد برزت قبل الذرور للشروق ، وشمرت عن الاذرع والسوق ، متقلدين خراءط شاكلت السيوف بحماءلها ونياطانها ، وناسبتها في اثارها ونكاياتها ، تحمل من البندق الملموم ، ما هو في الصحة والاستدارة كاللءلء المنظوم ، كانما خرج بالجهر ، فجاء كبنات الفهر ، قد اختير طينه ، وملك عجينه ، فهو كالكافور الصاعد في الملمس والمنظر ، وكالعنبر الاذفر الا في المشم والمخبر ، ماخوذ من خير مواطنه ، مجلوب من اطيب معادنه ، كافل بمطاعم حاملين ، محقق لامال امليه ، ضامن لحمام الحمام ، متناول لها من ابعد مرام ، يعوج اليها وهو سم ناقع ، ويهبط بها وهي رزق نافع . وبايديهم قسي مكسوة باغشية السندس ، مشتملة منها بافخر ملبس ، مثل الكماة في  جواشنها ودروعها ، والجياد في جلالها وقطوعها ، حتي اذ جردت من تلك المطارف ، وانتضيت من تلك الملاحف ، رايت منها قدودا مخطفة رشيقة ، والوانا معجبة انيقة ، صليبة المكاسر والمعاجم ، نجية المنابت والمناجم ، خطية الانتماء والمناسب ، سمهرية الاعتزاء والمناصب ، تركبت من شظايا الرماح الداعسة ، وقرون الاوعال الناخسة ، فحازت الشرف من طرفيها ، واحتوت عليه بكلتا يديها ، قد تحنت تحني المشيخة النساك ، وصالت صيال الفتية الفتاك ، واستبدلت من قديمها في هز الفوارس ، بحديثها في قبض المعاجس ، وانتقلت عن جدها في طرد الغارات ، الي هزلها في طرد المتنزهات . ظواهرها صفر وارسة ، ودواخلها سود دامسة ، كان شمس اصيل طلعت علي متونها ، او جنح ليل اعتكر في بطونها ، او زعفرانا جري فوق مناكبها ، او غالية جمدت عفي تراءبها ، او هي قضبان فضة اذهب شطرها واحرق شطر ، او حيات رمل اعتنق السود منها والصفر . فلما توسطوا تلك الروضة ، وانتشروا علي اكناف تلك الغيضة ، وثبتت للرمي اقدامهم ، وشخصت الي الطير ابصارهم ، وتروها بكل وتر فوق سهمه منه ، ومفارق للسهم وخارج عنه ، مضاعف عليها من وترين ، كانه برد ذو جسدين ، او عناق ضم ضجيعين ، في وسطه عين كشريحة كيس مختوم ، او سرة بطن خميص مهضوم ، محولة عن المحاذاة ، مزورة عن الموازاة ، كانها متخازر ينظر شزرا ، او مصغ يسمع رزا ، تروع قلوب الطير بالانباض ، وتصيب منهم مواقع الاعراض . فلم يزل القوم يرمون ويصيبون ، وينجحون ولا يخيبون ، حتي خلت من البندق خراءطهم ، وامتلات بالصيد حقاءبهم . فكم من افرخ زغب ايتموها فضاعت ، ومن اباء لها وامهات استجابوها فاطاعت ، قد انقادت نوافرها صعرا ، واقتسرت اوابيها قسرا ، وكسرت اجنحتها وجاجيها ، واستطارت في الجو قوادمها وخوافيها ، فاصبحت بين عاثر لا ينهض من عثاره ، ومهيض لا يطمع في انجباره ، يداوي جريحها بالاجهاز ، ويتلافي عقيرها بالتذكية والانجاز ، تعاجل قبل فناء ذماءها ، وبصير ريشها كالمجاسد من  دماءها ، مصرعة شر مصارعها ، مستقرة في اخفي مضاجعها ، محمولة علي حكم الكفار ، اذ يقتلون ومصيرهم الي النار ، تغسل بالاستقصار سمطها ، وتكفن بالتعرية من ريطها ، وتحنط بتوابلها وابازيرها ، وتواري في قدورها وتنانيرها . ثم تبعث الي اخوان متوافقين ، وخلان مترافقين ، قد تطابقوا في الاراء ، وتالفوا في الاهواء وتمالحوا في الطعام ، وتراضعوا بالمدام ، نداءهم تفدية ، وجوابه تلبية ، لا يضبون علي الاحقاد ، ولا يتنافسون في الوداد ، ولا يشوب صفوهم شاءب ، ولا يعيب فضلهم عاءب . فالحمد لله الذي اباحنا لذيذ المطاعم ، ونهج لنا سبل الغناءم ، وهدانا الي رخص الطيبات ، ووقف بنا علي حدود اللذات ، ووفقنا ان ناخذ منها بامره ، ونزدجر عنها بزجره ، ونتصرف مع الشراءع في احلال ما احلت ، واجتناب ما حرمت وحظرت . واطال الله بقاء الوزير ما اختار البقاء ، وعلا كعبه ما امتد العلاء ، وجعل له من كل رزق هنء حظا جزيلا ، والي كل مشرب عذب هاديا ودليلا ، بمنه وطوله ، وقدرته وحوله . وكتب ابو اسحاق عن ابن فسانجس الي بختيار بن احمد بن بويه في صفة متصيد كان له بواسط : من حل محلي في اصطناع الامير عز الدولة  اطال الله بقاءه  واصطفاءه ، وانتهي الي غايتي من اثرته واجتباءه ، كان حقيقا في التسوية في طاعته بين سره وجهره ، والجمع في نصيحته بين جده وهزله ، غير مسامح نفسه بقضاء وطر لا حظ له فيه ، ولا موسع له في بلوغ ارب لا فاءدة له منه ، تمسكا بعلاءق الولاية في ساءر الاحوال ، واداء الفريضة الامانة في صغير وكبير الاعمال ، والله بلطفه يمدني في خدمته بالتوفيق ، ويقف بي منها علي سواء الطريق ، ويهب لي تحفظا يحرس من الزيغ والزلل ، وتيقظا يعصم من الخطا والخطل .  ووجدت في سفري هذا  ايد الله الامير عز الدولة  فضلا في زماني عن المهمات ، يستروح النفوس الي توفيره علي المحبوبات ، فاعتمدت مها التصيد تادبا بادبه  اطال الله بقاءه  في الولوع به ، واعتمادا لعاءدته علي من يحضرني من اولياءه وعبيده ، في قوة ابدانهم ونشاطها ، ورياضة خيلهم وانبساطها ، واعتيادهم طراد ما يسنح ويعن ، واستثارة ما يستكن ويستجن ، واغراءهم بطلب ما يحاولونه ، واضرابهم عن الفتك بمن يساورونه ، اذ كان هذا الامر مثالا يحتذي في مطاعنة الفرسان ، ومنهجا يقتفي في مطاردة الاقران . وافق لي من السرور لذلك يوم غاب نحسه وهوي ، وطلع سعده واعتلي ، وصدق الله ايامنه وسوانحه ، واكذب اشاءمه وبوارحه ، بما رزقناه من اجتماع الصيد ووفوره ، وكثرته وجمومه ، وسهله لنا من ادراك ما طلبناه منه وارغناه ، والوصول الي ما اعتمدناه وانتحيناه ، بظل مولانا الامير عز الدولة  ادام الله عزه الممدود علينا  وبركة اسمه الذي به استنجحنا والزمان ساقطة جماره ، مفعمة انهاره ، مورقة اشجاره ، مغردة اطياره ، ونحن غب سماء اقلع بعد الارتواء ، واقشع عند الاستغناء ، والبقل خضل ممطور ، والنقع ساكن محصور ، والرياض كالعراءس في وشيها ومطارفها ، متجلية في خلعها وملابسها ، متبرجة في حللها ومجاسدها ، باسطة زرابيها وانماطها ، ناشرة حبراتها ورياطها ، زاهية بحمراءها وصفراءها ، تاءهة بعوانها وعذراءها ، كانما عارضت عصبا ، او فاخرت صحبا ، او احتفلت لوفد ، او هي من حبيب علي وعد ، تتباري طيبا وحسنا ، وتتفاوح ارجا وعرفا ، فما نرد منها حديقة الا استوقفتنا بهجتها ونضارتها ، واستنزلتنا جدتها وغضارتها ، وخيلنا كالامواج المتدفقة ، والاطواد الموثقة ، متشوفة عاطية ،  مستبقة جارية ، تشتاق الي الصيد وهي لا تطعمه ، وتحن اليه كانه قضيم تقضمه ، وعلي ايدينا جوارح مءللة المخالب والمناسر ، ومذربة النصال والخناجر ، طامحة الالحاظ والمناظر ، بعيدة المرامي والمطارح ، ذكية القلوب والنفوس ، قليلة القطوب والعبوس ، ذات قوادم كثة اثيثة ، وخواف وحفة اثيرة ، سابغة الاذناب ، كريمة الانساب ، صليبة الاعواد ، قويمة الاوصال ، تزيد اذا الحمت شرها وقرما ، وتضاعف اذا شبعت كلبا ونهما . فبينا نحن ساءرون ، وفي الطلب ممعنون ، اذ وردنا ماء زرقا جمامه ، طامية ارجاءه ، يبوح باسراره صفاءه ، وتلوح في قراره حصباءه ، وافانين الطير به محدقة ، وغراءبه عليه واقعة ، متغايرة الالوان والصفات ، مختلفة اللغات والاصوات ، فمن بين صريح خلص وتهذب نوعه ، ومن مشوب تهجن او اقرف عرقه . فلما اوفينا عليها ، ارسلنا الجوارح اليها ، كانها رسل المنايا ، او سهام القضايا ، فلما تسمع الا مسميا ، ولم تر الا مذكيا . ثم عدنا لشاننا دفعات ، واطلقنا مرات ، حتي ازددنا واستكثرنا ، وانتهينا واكفينا ، وانطلقنا بعد ذلك نعتام ونتخير ، ونقترح ونتحكم . فكان الدراج اطرف مطلوباتنا ، وانظف ماكولاتنا ، فاستثرناه عن مجاثمه ، وانتزعناه من مكامنه ، واختطفنا ببزاتنا ما طار منه وانتشر ، وبعثتنا بوازجنا علي ما تبنج واستتر ، فاهتدت اليها كالوداءع المستودعة ، ت واظهرتها كالكنوز المستخرج ، تستدل عليها بالشميم ، وتستنبطها بالنسيم . فلم يفتنا ما برز ، ولا سلم منا ما احتجز . ثم عدلنا  ايد الله الامير  عن مطارح الحمام ، الي مسارح الارام ، نستقري ملاعبها ، ونوم مجامعها ، لا نالو بحثا وفحصا ، ولا نفتر اجتهادا وحرصا ، وامامنا ادلة فرهة يهدون ، ورواد مهرة يرشدون ، حتي افضينا الي اسراب كثيرة العدد ، متصلة المدد ، لاهية باطلاءها ، راتعة في اكلاءها ، غارة بما احاط بها ، ذاهلة عما اعد لها ، ومعنا فهود اخطف من البروق ، واثقف من الليوث ، واجدي من الغيوث ، وامكن من الثعالب ، وانزي من الجنادب ، وادب من  العقارب ، خمص الخصور ، قب البطون ، رقش المتون ، حمر الاماق ، خزر الحداق ، هرت الاشداق ، عراض الجباه ، غلب الرقاب ، كاشرة عن انياب كالحراب ، تلحظ الظباء من ابعد غاياتها ، وتعرف حسها من اقصي نهاياتها ، تتبع مرابضها واثارها ، وتنسم رواءحها وانشارها . فاقبلنا من تجاه الريح اليها واغذذنا السير نحوها ، ثم دببنا لها الضراء ، وشننا عليها الغارة الشعواء ، وارسلنا فهودنا اليها ، فانقضت كالشهب عليها ، جاءلة في ادمها وعفرها ، صاءلة بعترها وشصرها . وجرت خيلنا في اثارها ، كاسعة لادبارها ، فالقينا كلا منها علي ظبي قد افترسه وافترشه ، وصرعه وجعجعه ، فصانعناها بالدماء فقنعت وولغت ، واستنزلناها عن الظباء فسامحت ونزلت . واوغلنا من بعد في اللحاق بما شذ وشرد ، وقص اثر ما ند وبعد ، قد انتهت النوبة الي الكلاب والصقور ، وفي صحبتنا منها كل كلب عريق المناسب ، نجيح المكاسب ، حلو الشماءل ، نجسب المخايل ، حديد الناظرين ، اغضف الاذنين ، اسيل الخدين ، مخطف الجنبين ، عريض الزور ، متين الظهر ، ابي النفس ، ملهب الشد ، لا يمس الارض الا تحليلا وايماء ، ولا يطاها الا اشارة وايحاء ، وكل صقر عميم الجسم ، مصمت العظم ، ماض كالحسام ، قاض كالحمام ، كثير التلفت ، طويل التلهف ، متيقظ في نواظره ، مشتط في مطالبه ، خفيف النهضة الي ما يريد ، ثقيل الوطاة علي ما يصيد . فما لبثنا ان اشرفنا علي يعافير متطرفة ، ويحامير متعزبة ، فخرطنا القلاءد والشباقات ، فمرت مترافقات متوافقات ، قد تباينت في الصور والاجناس ، وتالفت في الارتياد والالتماس ، فسقت الصقور اليها ضاربة وجوهها ، ناكسة رءوسها ، ولحقت الكلاب بها منشية فيها ، مدمية لها . وبادرناها مجهزين ، وغنمناها فاءزين . واعترضنا في المرجع  ايد الله الامير  عانة من حمير ، لم نحتسبها ولم نطمع في الوقوع علي مثلها ، فثاورها سرعان خيلنا ، وخالطها فتاك  فرساننا ، فصرعنا منها جحشا ومنعنا مما سواه شدة الكلال والملال ، وامتلاء الحقاءب من الاثقال . وانقلبنا  ايد الله الامير  الي معرس كنا استطبناه بادءين ، واعددناه للاستراحة عاءدين . وقد وجب الجمع بين صلاتي الظهر والعصر ، فنزلنا ريثما صلينا ، وعرفنا عدد ما صدنا ، واجتمع الينا اهل موكبنا ، ونهضنا فاتممنا ، واخذنا في صيد ما يقرب ويحف ، وتحصيل ما يلوح ويستدف ، فكان ذلك حباري ارسلنا بعض شواهيننا اليه ، فثاروه وهو يتقيه ، وثاقفه وهو ينتحيه ، يعلو عليه تارة ويستفل عنه اخري ، كالفارسين المتطاردين ، والبطلين المتنازلين ، فداما كذلك ساعة او ساعتين ، الي ان اعتلقه ، وهبط به ، وخبطه وجثم عليه . وكان قريبا منه قنبر اطلقنا عليه يءيءا لنا ، فعرج الي السماء عروجا ، ولجج في اثره تلجيجا ، كان ذلك يعتصم منه بالخالق ، وكان هذا يستطعمه من الرازق ، حتي غابا عن النظار ، واحتجبا عن الابصار ، وصارا كالغيب المرجم ، والظن المتوهم ، حتي خطفه ووقع به وهما كهيءة الطاءر الواحد ، فاعجبنا امرهما ، واطربنا منظرهما ، ووردنا المنازل سالمين ، وولجناها غانمين ، والغزالة مصوبة للغروب ، مءذنة بالمغيب ، والجو في اطمار منهجة من اصاءله ، وشفوف مورسة من غلاءله . فالحمد لله الذي قدر الارزاق ونزلها ، ويسرها وسهلها ، واتاها عباده من مستصعب جهاتها ، وممتنع مراماتها ، وجعل لهم في الاطيار السارية والوحوش الجارية طعما من اطايبها ، وخدما من جناءبها ، وعلمهم تذليل شامسها وابيها ، واستجابة نافرها وعاصيها ، اسباغا للمواهب ، وارغاما للمعايش ، وامتاعا بالاوطار ، واسعافا بالمسار . واياه اسال ان ينصر راية الامير في دقيق الاغراض وجليلها ، ويقضي الظفر لها في جسيم المطالب وضءيلها ، حتي يكون شعاره في  الجميع ضامنا للظهور والغلبة ، وافيا له كفيلا باليمن والبركة ، ويلهمنا من شكره جل ثناءه ما يءذن بالدوام والتمام ، ويءمن من الانفصام والانصرام ، بمنه وطوله ، وقدرته وحوله . ابو نواس : ما البرق في ذي عارض لماحولا انقضاض الكوكب المنصاح ولا انبتات الحواب المنداححين دنا من راحة المتاح اجذ في السرعة من سرياحيكاد عند ثمل المراح يطير في الجو بلا جناح الحواب : الدلو ، والمنداح : الواسع ، ومنه : لك عن كذا مندوحة . والمتاح : المستقي . والسرياح : اسم كلب . ولابي نواس : كانه اذ لج في كيادهمحتسب للاجر في جهاده يحظر ما صاد علي فهادهتحنن الشيخ علي اولاده فليس يغدو معه بزاده وقال المخزومي في الفخ : ذو قصر احدب من غير كبرمحتقر المنظر جبار الخبر مستضعف لكن اذا ضيم انتصرمستانس فان مسسناه نفر  وان جني جناية لم يعتذرمنعطف مثل الهلال في الصغر مفوق سهما اذا شد استمرنصاله الحب وماواه الحفر لما رايي العصفور حبا قد بذرارتاب بالحنطة ما بين المدر ولم يزل بين الرجاء والحذريبعثه الحرص ويثنيه الخطر ثم هوي مستيقنا لما افتكران بني الدنيا جميعا في غرر وامل النفع ولم يخش الضررفشده الفخ باشراك الغير ولم يطق دفع القضاء والقدرفكثرة الاطماع افات البشر وفي تصاريف الليالي معتبروالحزم ان تجزع من حيث تسر فاخر الصفو وان لذ الكدر وقال الشمردل : قد اغتدي قبل طلوع الشمسللصيد في يوم قليل النحس باحجن الخطم كمي النفسغرثان الا اكلة من امس يطرح للطمس وراء الطمسكنظر الغضبان او ذي المس حتي اذا عاين بعد الحبسعشرين من حباريات عبس يمشين مشي الخاطبات القعساو كالنصاري في ثياب طلس فهن بين اربع وخمسصرعي ومستدم اميم الراس كانما مخلبه في ورسمن علق الاجواف بعد النهس وخرب قد ذل بعد القعسكالبكر يعطي راسه للعكس لاح وقد ارضاهم في الحدسعلي شمال قانص معتس كانه وهو لها في درسجلمود قذاف قليل الوكس ململ من صخرات ملس  نعت الطير قال عنترة يصف غرابا : ظعن الذين فراقهم اتوقعوجري ببينهم الغراب الابقع خرق الجناح كان لحيي راسهجلمان بالاخبار هش مولع وقال صخر الغي يذكر العقاب : والله فتخاء الجناحين لقوةتوسد فرخيها لحوم الارانب كان قلوب الطير في جوف وكرهانوي القسب ملقي عند بعض المادب والمقدم قول امرء القيس في مثل : كان قلوب الطير رطبا ويابسالدي وكرها العناب والحشف البالي وقالت جنوب اخت عمرو ذي الكلب : تمشي النسور اليه وهي لاهيةمشي العذاري عليهن الجلابيب وقال النابغة الذبياني وذكر اتباعها للجيش ترقب القتلي : تراهن خلف القوم خزرا عيونهاجلوس الشيوخ في مسوك الارانب المسوك جمع مسك : وهو الجلد . وقال اخر ينعت حمامة : مزبرجة الاعناق نمر ظهورهامخطمة بالدر خضر رواءع  تري طررا بين الخوافي كانهاحواشي برود احكمتها الوشاءع ومن قطع الياقوت صيغت عيونهاخواضب بالحناء منها الاصابع وقال ابن المعتز في الديك : بشر بالصبح طاءر هتفاهاج من الليل بعدما انتصفا مذكر بالصبوح صاح بناكخاطب فوق منبر وقفا صفق اما ارتياحة لسنا ال . . . فجر واما علي الدجي اسفا وقال ابن الرومي : كان بنات الماء في صرح متنهاذا ما علا روق الضحي فترفعا زرابي كسري بثها في صحانهليحضر وفدا او ليجمع مجمعا واخضر كالطاووس يحسب راسهبخضراء من حر الحرير مقنعا يتيه بمنقار عليه حباءكيخيلن في ضاحيه جزعا مجزعا يلح علي اسطامه وشم صفرةترقش منها متنه فتلمعا كملعقة الصيني اخدمها يداصناعا وان كانت يد الله اصنعا وقال ابو اسحاق الصابء يصف قبجة : انعت طارونية الثيابلابسة خزا علي الاهاب تصنعت تصنغ التصابيوابرزت موجها بلا نقاب ريان من محاسن الشبابمكحولة العينين كالكعاب كانما تسقي دم الرقابتسمعنها منها وراء الباب  تمتمة بالقاف في الخطابكانما تقرا من كتاب قهقهة الابريق بالشراباهلا بصياد لها جلاب جاء بها كريمة النصابربيبة الجبال والهضاب كردية الاعراق والانسابلم تدر ما بادية الاعراب غريبة صارت من الاحباب وقال ذو الرمة في الظليم : شخت الجزارة مثل البيت ساءرهمن المسوح خدب شوقب خشب وقال علقمة بن عبدة فيه : هيق كان جناحيه وجءجءهبيت اطافت به خرقاء مهجوم سال المهدي رجلا عن طاءر جاء من الغابة فقال : لو لم يبن بفضيلة السبق لبان بحسن الصورة . فقال : صفه لي ، فقال : قد قد الجلم ، وقوم تقويم القلم ، لو كان في ثوب خرقه ، او في صندوق فلقه ، يمشي علي عنمتين ، ويلقط بدرتين ، وينظر بجمرتين ، اذا اقبل فديناه ، واذا ادبر حميناه . وقال عبد الواحد بن فتوح المعروف بالزقاق المغربي في الحمام : يجتاب اردية السحاب بخافقكالبرق اومض في السحاب فابرقا لو سابق الريح الجنوب لغايةيوما لجاءك مثلها او اسبقا يستقرب الارض البسيطة مذهباوالافق ذا السقف الرفيعة مرتقي  ويظل مسترق السماع يخافهفي الجو تحسبه الشهاب المحرقا يبدو فيعجب من راه بحسنهوتكاد اية عتقه ان تنطقا مترفرفا من حيث درت كانمالبس الزجاجة او تجلبب زءبقا وقال ابو نواس في الاوز : كانما يصفرن من ملاعقصرصرة الاقلام في المهارق وقال يصف الديك : انعت ديكا من ديوك الهنداحسن من طاووس قصر المهدي اشجع من غادي عرين الاسدتري الدجاج حوله كالجند يقعين من خيفته للسفد نعت انواع من الحيوان قال محمد بن ابي محمد اليزيدي يصف قنفذا راه فاطعمه وسقاه : وطارق ليل جاءنا بعد هجعةمن الليل الا ما تحدث سامر قريناه صفو الزاد حين رايتهوقد جاء خفاق الحشا وهو سادر جميل المحيا في الرضي فاذا ابيحمته من الضيم الرماح الشواجر ولست تراه واضعا لسلاحهيد الدهر موتورا ولا هو واتر وقال ذو الرمة في صفة الحرباء :  يظل مرتبءا للشمس تصهرهاذا راي الشمس مالت جانبا عدلا كانه حين يمتد النهار لهاذا استقام يمان يقرا الطولا وقال ايضا : كان يدي حرباءها متشمسايدا مذنب يستغفر الله تاءب وقال ايضا : يصلي بها الحرباء للشمس ماثلاعلي الجذل الا انه لا يكبر اذا حول الظل العشي رايتهحنيفا وفي قرن الضحي يتنصر وقال ايضا : كم دون مية من خرق ومن علمكانه لامع عريان مسلوب كان حرباءه في كل هاجرةذو شيبة من رجال الهند مصلوب وقال ابو داود الايادي : اني اتيح له حرباء تنضبةلا يرسل الساق الا ممسكا ساقا الحرباء تاتي شجرة تعرف بالتنضبة وما اشبهها من ذوات الاغصان فتمسك  بيديها غصنين من الشجرة ، وتقابل بوجهها عين الشمس ، فكلما زالت عين الشمس عن ساق خلت الحرباء يدها عنه وامسكت ساقا اخري حتي تغيب الشمس ، ثم تستخفي . وقال اخر يصف الضفادع : ومقعدات ما لهن ارجلكقعدة الناكح حين ينزل وقال في الضب : شديد اصفرار الكشيتين كانماتطلي بورس بطنه وشواكله فذلك اشهي عندنا من بياحكملحا الله شاريه وقبح اكله دخل اعرابي البصرة فاشتري خبزا فاكله الفار فقال : عجل رب البيت بالعقابلعامرات البيت بالخراب كحل العيون وقص الرقابمجررات احبل الاذناب كيف لنا بانمر الاهابمنهرت الشدق حديد الناب كانما برثن بالحرابيفرسها كالاسد الوثاب قال ابو عمرو بن العلاء : رايت باليمن غلاما من جرم ينشد عنزا له ، فقلت ، يا غلام صفها ، فقال : حسراء مقبلة ، شعراء مدبرة ، ما بين غثرة  الدهسة ، وقنوء الدبسة ، سجحاء الخدين ، خطلاء الاذنين ، فشقاء الصورين ، كان زنمتيها تتوا قلنسية ، يا لها ام عيال ، وثمال مال . الغثرة : غبرة كدرة ، والدهسة : لون كلون الدهاس ، قال الاصمعي : الدهاس من الرمل كل لين لال يبلغ ان يكون رملا وليس بتراب ولا طين . والديسة حمرة كدرة . والسجحاء : السهلة الخدين . والخطلاء : الطويلة الاذنين وفشقاء : منتشرة متباعدة ، والصوران : القرنان ، والتتوان : ذءابتا القلنسوة ، وفي القلنسوة لغات احداها قلنسية . وقال ابن قاضي ميلة المغربي ، وذكر كلب البحر ، والمغارة يسمونه عدا قرش ، وكان التقف انسانا فتتبعه صاحب الولاية حتي صيد ، ووجد بعض اشلاء الرجل في جوفه : واشغي بكفيه مثل المديطويل القرا مدمج الاعظم تصرفه في ضمان المياهومهجته في يد الخضرم نخاف الهواء ويخشي الضياءوان كان اجرا من ضيغم ولما ارتقت نفسه للاذيوبات مع البغي في مجثم وعزته منعته بالبحارومثواه في زاخر مظلم دعاه الي حتفه حينهفاقعص مرءا من العوم فالقاه سعدك في راحتيكوقيده سفكه للدم ونزهك الله عن ان تضيعبارضك نفس امرء مسلم وقال ابن زهير الكلبي : قل لابي الجودي عند الفجراتاك حصاد بغير اجر  مسربلين في ملاء خضرلا يتشكين انقلاب الدهر من كلام علي عليه السلام : ان شءت قلت في الجرادة اذ خلق لها عينين حمراوين ، واسرج لها حدقتين قمراوين ، وجعل لها السمع الخفي ، وفتح لها الفم السوي ، وجعل لها الحس القوي ، ونابين بهما تقرض ، ومنجلين بهما تقبض ، يرهبها الزراع في زرعهم ، ولا يستطيعون ذبها ولو اجلبوا بجمعهم ، حتي ترد الحرث في نزواتها ، وتقضي منه شهواتها . نعت الحية قال النابغة الذبياني ، ووجدتها في بعض الكتب منسوبة الي خلف الاحمر : صل صفا لا ينطوي من القصرطويلة الاطراق من غير خفر داهية قد صغرت من الكبركانما قد ذهبت به الفكر مهروتة الشدقين حولاء النظرتفتر عن عوج حداد كالابر وقال الهذلي ، وذكر اثارها علي الطريق : كان مزاحف الحياة فيهقبيل الصبح اثار السياط وقال خلف الاحمر : وكانما لبست باعلي لونهابردا من الاثواب انهجه البلي  في عينها قبل وفي حيزومهافطس وفي انيابها مثل المدي وقال ايضا : وحية مسكنها الرمالكانها اذا شتت خلخال وقال اخر : ارقش بين حنش وثعبانكانما في راسه سنانان وفي حجاجي راسه مغاران وقال هميان بن قحافة : وافعوان مسه كالمبردفي قدر شبرين كساق المقعد كان عينيه سراجا موقدتخال رز نفخه المردد صريف نابي جمل في قردداو غليان مرجل لم يبرد وقال اخر : خلقت لهازمه عزين وراسهكالقرص فلطح من دقيق شعير وكان شدقيه اذا استعرضتهشدقا عجوز مضمضت لطهور  وقال عنترة بن الاخرس : لعلك تمني من اراقم ارضنابارقم يسقي السم من كل منطف تراه باجواز الهشيم كانماعلي متنه اخلاق برد مفوف كان بضاحي جلده وسراتهومجمع ليتيه تهاويل زخرف كان تثني نسعه تحت حلقهلما قد طوي من جلده المتعطف وقال اشجع : وكانما التدريج في بطنانهاامواج دجلة في هبوب الشمال وقال ابن المعتز : تلقي اذا انسلخت في الارض جلدتهاكانها كم درع قده بطل وقال ابن نباته : ففي الهضبة الحمراء ان كنت ساريااغيبر ياوي في صدور الشواهق يسالم ركبان الطريق نهارهالي الليل مخبوء لاحدي البواءق كان بقايا ما سري من قميصهعلي متنه افواف برد شبارق يقصر عن يافوخه حين ينطويحقيبة مملوء من الشر زاهق وغرهم منه وهم يخدعونهكراه علي ايمانهم والمرافق ودون الذي يرجون من سقطاتهحفيظة مشبوب اللحاظ مرافق  مطول اذا ما طلته الكيد سادرجرء اذا بادهته بالحقاءق نعت الهوام والحشرات قال رياح الاسدي : تطاول بالفسطاط ليلي ولم يكنبحنو الغضا ليلي علي يطول تءرقني حدب قصار اذلةوان الذي يءذينه لذليل اذا جلت بعض الليل منهن جولةتعلقن بي او جلن حيث اجول اذا ما قتلناهن اضعفن كثرةعلينا ولا ينعي لهن قتيل الا ليت شعري هل ابيتن ليلةوليس لبرغوث علي سبيل وقال اعرابي : الا يا عباد الله من لقبيلةاذا ظهرت في الارض شد مغيرها فلا الدين ينهاها ولا هي تنتهيولا ذو سلاح من معد يضيرها وقال السلامي في الزنبور : ولابس ثوب واحد وهو طاءرملوثة ابراده وهو واقع اغر محشي الطيلسان مدبجوسود المنايا في حشاه وداءع اذا حك اعلي راسه فكانمابسالفتيه من يديه جوامع يخاف اذا ولي ويءمن مقبلاويخفي علي الاقران ما هو صانع  بدا فارسي الزي يعقد خصرهعليه قباء زينته الوشاءع يرجع الحان الغريض ومعبدويسقي كءوسا ملءها السم ناقع فمعجزه الوردي احمر ناصعومءزره التبري اصفر فاقع وقال عبد الصمد في العقرب : يا رب ذي افك كثير خدعهيبرز كالقرنين حين يطلعه في مثل صدر السبت حين تقطعهاسود كالسبحة فيه مبضعه لا تصنع الرقشاء ما لا يصنعهينطف فيها سمه وسلعه وروي ان عبد الرحمن بن حسان دخل علي ابيه يبكي وهو صبي ، فقال : ما يبكيك ؟ قال : لسعني طاءر كانه ملتف في بردي حبرة . فقال : قلت والله الشعر . وقال عنترة : وخلا الذباب بها فليس ببارحغردا كفعل الشارب المترنم هزجا يحك ذراعه بذراعهفعل المكب علي الزناد الاجذم وقال الصابء في البق : طافوا علينا وحر الصيف يطبخناحتي اذا نضجت اجسادنا اكلوا واول الابيات :  وليلة لم اذق من حرها وسناكان في جوفها النيران تشتعل احاط بي عسكر للبق ذو لجبما فيه الا شجاع فاتك بطل من كل شاءلة الخرطوم طاعنةلا تمنع الحجب مسراها ولا الكلل وقال اخر : اذا البعوض زجلت اصواتهاواخذ اللحن مغنياتها لم تطرب السامع زامراتهاصغيرة كبيرة اذاتها يقصر عن بغيتها بغاتهافلا تصيب ابدا رماتها رامحة خرطومها قناتها وقال ابن المعتز : بت بليل ساهرا لم اطرفجرجسه كالزءبر المنتف تنفذ في الجسم وراء المطرفحتي تري فيه كشكل المصحف او مثل رض العصفر المدوف وقال ابو نواس : يا رب مستخف بحر . . . ز الدرز يكنفه صءابه انحي له بمذلق ال . . . حدين اصبعه نصابه  لله درك من اخيقنص اصابعه كلابه وقال اخر : للقمل حول ابي العلاء مصارعمن بين مقتول وبين عقير وكانهن اذا علون قميصهفذ وتوام سمسم مقشور وقال ابو عثمان الخالدي : كانما قمل ابي رياشما بين صءبان قفاه الفاشي وذا وذا قد لج في انتعاششهدانج بدد في خشخاش وقال ابن المعتز يصف الارضة : ارقط ذو شيب كلون المكتهلتخاله مكتحلا وما اكتحل راكب كف اين ما شاء رحلمثل العروق لا تري فيه خلل بيني انابيب له فيها سبل بعض المحدثين من ابيات : اذا تغني بعوضه طرباساعد برغوثها الغنا فرقص فهل سمعتم بمطربي احدتقاسموه علي الجذور حصص وقال اخر مثله : كان جنبي البيت الحرام فمايءنس منه الا بمستلم  كان حرب البسوس قد فرشتتحتي فمن ظافر ومنهزم وقال اخر : قبيلة في طولها وعرضهالم يطبقوا عينا لها بغمضها خوف البراغيث وخوف عضهاكان في جلودها من مضها عقاربا ترفض من مرفضهاان دام هذا هربت من ارضها يا رب فاقتل بعضها ببعضها نعت النساء جملة وتفصيلا قد ذكرنا في باب الغزل والنسيب من ذلك ما يليق به ، ونقتصر هاهنا علي ما هو وصف ونعت مدحا كان او ذما . قال الله عز وجل في مدح حور العين : ' كانهن الياقوت والمرجان ' الرحمن :  ، وقال تعالي في موضع اخر : ' كانهن بيض مكنون ' الصافات :  . وقال عدي بن زيد : بيض عليهن الدمقس وفي ال . . . اعناق من تحت الاكفة در كالبيض في الروض المنور قدافضي بهن الي الكثيب بهر يارج من ارداءهن مع ال . . . مسك الزكي عنبر وقطر وقد وصفهن النبي صلي الله عليه وسلم موجزا فقال : النساء حباءل الشيطان .  وما احسن ما عرفهن علقمة بن عبدة حيث يقول : فان تسالوني بالنساء فاننيخبير بادواء النساء طبيب اذا شاب راس المرء او قل مالهفليس له في ودهن نصيب تراهن لا يحببن من قل مالهوشرخ الشباب عندهن عجيب وقال جرير : ما استوصف الناس من شء يروقهمالا راوا ام عمرو فوق ما وصفوا كانها مزنة غراء لاءحةاو درة لا يواري ضوءها الصدف وقال النابغة الذبياني يصف امراة النعمان بن المنذر : سقط النصيف ولم ترد اسقاطهفتناولته واتقتنا باليد بمخضب رخص كان بنانهغنم علي اغصانه لم يعقد وبفاحم رجل اثيث نبتهكالكرم مال علي الدعام المسند نظرت اليك بحاجة لم تقضهانظر السقيم الي وجوه العود زعم الهمام بان فاها باردعذب اذا ما ذقته قلت ازدد والبطن ذو عكن لطيف لينوالصدر ينفجه بثدي مقعد وتخالها في البيت اذ فاجاتهاقد كان محجوبا سراج الموقد صفراء كالسيراء اكمل خلقهاكالغصن في غلواءه المتاود واذا لمست لمست اخثم جاثمامتحيرا بمكانه ملء اليد  واذا طعنت طعنت في مستهدفرابي المجسة بالعبير مقرمد واذا نزعت نزعت من مستحصفنزع الحزور بالرشاء المحصد لا وارد منها يريد اذا استقيصدرا ولا صدر يجوز لمورد وقال عبد الصمد : وهتكت ثني الليل عنبيض السوالف والصفاح فكانما ضحكت سجو . . . ف الليل عن بيض الاداحي وقال اخر : مريضات اوبات التهادي كانماتخاف علي احشاءها ان تقطعا تسيب انسياب الايم اخصره النديفرفع من اعطافه ما ترفعا وقال بكر بن النطاح : بيضاء تسحب من قيام فرعهاوتغيب فيه وهو جثل اسحم فكانها فيه نهار ساطعوكانه ليل عليها مظلم وقال بشار : وكان تحت لسانهاهاروت ينفث فيها سحرا وتخال ما ضمت علي . . . ه ثيابها ذهبا وعطرا  يقال للصبي اذا كان في بطن امه جنين ، فاذا ولد قيل له وليد ، فاذا زاد علي هذا قيل له طفل ، فاذا ارضعته امه قيل له رضيع ، فاذا فطمته امه قيل له فطيم ، واذا زاد علي هذا قيل له جفر ، فاذا زاد علي هذا قيل له جحوش ، فاذا زاد عليه قيل له حزور ، فاذا قوي وعدا واستقل قيل له بدر ، ويقال له مذ يفطم الي ان يبلغ عشر سنين غلام ، ويقال له بعد ذلك يافع ، فاذا قارب الادراك قيل له مراهق وكوكب ، فاذا ادرك قيل له حالم ومحتلم ومترعرع ، فاذا جاز الادراك قيل له ناشء وامرد ، فاذا ابتدات لحيته تخرج قيل له طار ، فاذا اسود الشعر في عارضيه قيل له محمم وفتي وشاب ، فاذا استوت لحيته قيل له مجتمع . ويقال له من خمس الي عشرة الي خمس وعشرين قمد ، ومن خمس وعشرين الي ثلاثين عنطنط ، ومن ثلاثين الي اربعين صمل ، ومن اربعين الي خمسين كهل ، ومن خمسين الي ثماني شيخ ، ويقال له بعد الثمانين يفن . وقال عمر بن ابي ربيعة : زهراء انسة مقبلهاعذب كان مذاقه الخمر واذا تراءت في الظلام جلتدجن الظلام كانها البدر نظرت اليك بعين مغزلةحوراء خالط طرفها فتر وقال : قليلة ازعاج الحديث يروعهاتعالي الضحي لم تنتطق عن تفضل نءوم الضحي ممكورة الخلق غادةهضيم الحشا حسانه المتعطل .  وقال ابو القاسم الزاهي : سفرن بدورا وانتقبن اهلةومسن غصونا والتفتن جاذرا واطلعن في الاجياد بالدر انجماجعلن لحبات القلوب ضراءرا واحتذي في البيت الاول قول المتنبي : بدت قمرا ومالت خوط بانوفاحت عنبرا ورنت غزالا وقال عدي بن الرقاع العاملي : وكانها بين النساء اعارهاعينيه احور من جاذر جاسم وسنان اقصده النعاس فرنقتفي عينه سنة وليس بناءم وقال عبيد بن الابرص : كان ريقتها بعد الكري اغتبقتمن ماء ادكن في الحانوت فضاح او من مشعشعة كالمسك نشوتهاومن انابيب رمان وتفاح وقال كعب بن زهير : تجلو عوارض ذي ظلم اذا ابتسمتكانه منهل بالراح معلول شجت بذي شبم من ماء محنيةصاف بابطح اضحي وهو مشمول تجلو الرياح القذي عنه وافرطهمن صوب سارية بيض يعاليل  كان هيت المخنث يدخل علي ازواج النبي صلي الله عليه وسلم ، فدخل ذات يوم دار ام سلمة هو صلي الله عليه وسلم عندها ، فاقبل علي اخي ام سلمة عبد الله بن ابي امية فقال : ان فتح الله عليكم الطاءف فسل ان تنفل بنت غيلان بن سلمة بن معتب الثقفي فانها مبتلة هيفاء ، شموخ نجلاء ، تناصف وجهها في القسامة ، معتدلة في القامة ، جامعة للوسامة ، ان قامت تثنت ، وان قعدت تبنت ، وان تكلمت تغنت . اعلاها قضيب ، واسفها كثيب ، في شء بين فخذيها كالقعب المكفا ، كما قال قيس بن الخطيم : تغترق الطرف وهي لاهيةكانها شف وجهها نزف بين شكول النساء خلقتهاقصد فلا جبلة ولا قضف فسمع رسول الله صلي الله عليه وسلم قوله فقال : ' ما لك سباك الله ، ما كنت احسبك الا من غير اولي الاربة من الرجال ، ولذلك كنت لا احجبك عن نساءي . وامر ان يسير الي خاخ ، ففعل . فدخل بعض الصحابة في اثر الحديث فقال : اتاذن لي ان اتبعه فاضرب عنقه ؟ قال : لا ، انا قد امرنا الا نقتل المصلين . وكتب ابو اسحاق الصابء في صفة جارية : ممشوقة القد ، اسيلة الخد ، شاجية اللحظ ، شاجية اللفظ ، صادقة الدعج ، ظاهرة الغنج ، حوراء الطرف ، قنواء الانف ، ماءلة الرد ، جاءلة العطف ، راءقة الشكل ، بارعة الشكل ، مليحة النحر ، صحيحة الصدر ، دقيقة الخصر ، مشرقة الثغر ، جعدة الشعر ، مريضة النظر ، كثير الخفر ، شديدة الكحل ، مبينة الخجل ، نقية اللون ، خمصانة البطن ، زجاء الحواجب ، سبطاء الرواجب ، سوداء الذواءب ، بيضاء التراءب ، غضة المحاجر ، سهلة ما كف المعاجر ، سقيمة الجفون ،  غليظة القرون ، متراصفة الاسنان ، باردة اللسان ، رطبة الاطراف ، ارجة الاعطاف ، معتدلة القوام ، بطيءة القيام ، مدورة السر ، واضحة الطرة ، حسنة المنقب ، جميلة المعصب ، قاءمة العنق ، ناهدة الثديين ، متساوية اليدين ، كاسية الساقين ، غليظة الفخذين ، مناصفة الاعضاء ، هضيمة الاحشاء ، ذكية القلب ، ممتلءة القلب ، ريا السوار ، سبغي الازار ، ان التفتت فخشف ، وان انفلتت فحقف ، او تبدت فوثن ، او تثنت فغصن ، او اقبلت فقضيب ، او ولت فكثيب ، او طلعت فشمس ، او سفرت فبدر ، او ابتسمت فعن برد مرصوف ، او نطقت فعن در مشوف . فرعها ليل ، ووجهها صبح ، وخدها ورد ، وعرقها يمان ، وصدغها نون كاتب ، وانفها حدب قاضب ، تتارج عن نسيم الرياض ، وتضحك عن نقي البياض ، وتفتر عن عذب المذاق ، وتكشف عن حلو العناق ، وتخطر بعطف الشباب ، وترشف بطعم الشراب . تحلو في كل جارحة منك جارحة منها او معني من معانيها : فالوجه لعينك ، والنطق لسمعك ، والريق لفمك ، والعرف لنفك ، والصدر لضمك ، والنحر للثمك : شرك النفوس ونزهة ما مثلهاللمطمءن وعقلة المستوفز والشعر لابن الرومي . تمام ابيات قيس في صفة المراة : قضي الله لها حين صورها ال . . . خالق ان لا يجنها السدف  تنام عن كبر شانها فاذاقامت رويدا تكاد تنغرف خود يغث الحديث ما سكتتوهو بفيها ذو لذة طرف تخزنه وهو مشتهي حسنوهو اذا ما تكلمت انف حوراء جيداء يستضاء بهاكانها خوط بانة قصف تمشي كمشي المبهور في دهس الر . . . رمل الي السهل دونه الجرف اهدي المنذر بن ماء السماء جارية الي كسري انوشروان وكتب معها اليه : قد اهديت اليك جارية معتدلة الخلق ، نقية اللون والثغر ، بيضاء قمراء ، وطفاء دعجاء ، حوراء عيناء ، قنواء شماء ، زجاء برجاء ، اسيلة الخد جثلة الشعر ، عظيمة الهامة ، بعيدة مهوي القرط ، عيطاء عريضة الصدر ، كاعب الثدي ، مشاشة المنكب والعضد ، حسنة المعصم ، لطيفة الكف ، سبطة البنان ، لطيفة طي البطن ، خميصة الخصر ، غرثي الوشاح ، رداح القبل ، رابية الكفل ، مفعمة الساق ، لفاء الفخذين ، ريا الروادف ، ضخمة الماكمتين ، مشبعة الخلخال ، لطيفة الكعب والقدم ، قطوف المشي ، مكسال الضحي ، بضة المتجرد ، شموع للسيد ، ليست بخنساء ولا سفعاء ، ذليلة الانف ، عزيزة النفس ، لم تغذ في بءس ، حيية رزينة ، حليمة ركينة ، كريمة الخال ، تقتصر بنسب ابيها دون فصيلتها ، وبفصيلتها دون جماع قبيلتها ، قد احكمتها التجارب في الادب ، فرايها راي اهل الشرف ، وعملها عمل اهل الحاجة ، صناع الكفين ، قطيعة اللسان ، رهوة الصوت ، تزين البيت ، وتشين العدو ، ان اردتها اشتهت ، وان تركتها انتهت ، وحملق عيناها ، وتحمر وجنتاها ، وتذبذب  شفتاها ، وتبادرك الوثبة . قال ابو العباس لخالد بن صفوان : يا خالد ان الناس قد اكثروا في النساء ، فاي النساء احب اليك ؟ قال : يا امير المءمنين ، احبها ليسب الضرع الصغيرة ولا بالفانية الكبيرة ، وحسبي من جمالها ان تكون فخمة من بعيد ، مليحة من قريب ، اعلاها عسيب ، واسفلها كثيب ، غذي في النعيم واصابتها حاجة ، فادبها النعيم واذلها الفقر ، لم تقرا فتجبن ، ولم تفتك فتمجن ، الهلوك علي زوجها الحصان من جارها . اذا خلونا كنا اهل دنيا ، وان تفرقنا كنا اهل اخرة . ومن الجيد في وصف اخلاقهن قول يزيد بن الحكم ، ويروي لابن قيس الرقيات : ان النساء اذا ينهين عن خلقفكل ما قيل لا يفعلن مفعول وما وعدنك من شر وفين بهوما وعدن من الخيرات تضليل ان النساء كاشجار نبتن معافيهن مر وبعض المر ماكول وصف اعرابي امراة فقال : هي ارق من الهواء ، واطيب من الماء واحسن من النعماء ، وابعد من السماء . ومن كلام احمد بن يوسف في صفة جارية كاتبة : كان خطها اشكال صورتها ، وكان مدادها سواد شعرها ، وقرطاسها اديم وجهها ، وكان قلمها بعض اناملها ، وكان لسانها سحر مقلتها ، وكان مبراتها سيف لحظها وكان مقطها قلب عاشقها .  وقال ابراهيم الرقيق الكاتب المغربي : وما ام ساجي الطرف خفاقة الحشااطاع لها الحوذان والسلم النضر اذا ما دعاها نصت الجيد نحوهاغن قصير الخطو في عظمه فتر باملح منها ناظرا او مقلداولكن عداني عن تقنصها الهجر وقال اعرابي : بيضاء في وجنتها احمراريعبنها جاراتها القصار هن الليالي وهي النهار انشد احمد بن يحيي : اذا نطقت سمعت لها صواباوتخطء في الفعال فما تصيب اذا اعطيتها كفرت والوتوان منعت فعابسة طوب ومنصب كالاقحوان منطقبالظلم مغلوث العوارض اشنب كسلافة العنب العصير مزاجهعود وكافور ومسك اصهب وقال اخر : تجري الاراك علي اغر كانهبرد تحدر من متون غمام  وقال النابغة : تجلو بقادمتي حمامة ايكةبردا اسف لثاته بالاثمد كالاقحوان غداة غب سماءهجفت اعاليه واسفله ند وقال ابن الرومي : الا ربما سءت الغيور وساءنيوبات كلانا من اخيه علي وحر وقبلت افواها عذابا كانهاينابيع خمر حصبت لءلء البحر وجمع البحتري كل ما يشبه به الثغر في بيت واحد فقال : كانما يضحك عن لءلءمنضد او برد او اقاح وقال الاعشي وذكر مشيهن فاحسن وتبعه الناس : كان مشيها من بيت جارتهامر السحابة لا ريث ولا عجل غراء فرعاء مصقول عوارضهاتمشي الهوينا كما يمشي الوجي الوحل وقال اخر : تمشي الهوينا اذا مشت فضلامشي النزيف المخمور في صعد  تظل من زور بيت جارتهاواضعة كفها علي الكبد وقال الحارث بن حلزة وذكر العجيزة : وتنوء تثقلها روادفهافعل الضعيف ينوء بالوسق وهذا من المقلوب ، انما الوسق ينوء بالضعيف ، قال الله عز وجل : ' ما ان مفاتحه لتنوء بالعصبة اولي القوة ' القصص :  . وقال اخر : وبيض نضيرات الوجوه كانماتازرن دون الازر رملات عالج وقال التمار واجاد : اخرها متعب لاولهافبعضها جاءر علي بعض وقال اخر : مجدولة الاعلي كثيب نصفهااذا مشت اقعدها ما خلفها وكانت عاءشة بنت طلحة موصوفة بعظم العجيزة ، فاذا نهضت فلا تستقل ، فكانت تقول : اني لمعناة بكما . وقال البحتري : رددن ما خففت منه الخصور اليما في المازر فاستثقلن اردافا  وقال ابن الرومي : وهبت له عيني الهجوعافاثابها منه الدموعا ظبي كان بخصرهمن دقة ظما وجوعا وقال عمرو بن كلثوم : وثديا مثل حق العاج رخصاحصانا من اكف اللامسينا وقال مسلم بن الوليد : فاقسمت انسي الداعيات الي الصباوقد فاجاتها العين والستر واقع فغطت بايديها ثمار نحورهاكايدي الاساري اثقلتها الجوامع وقال ابن الرومي : صدور فوقهن حقاق عاجوثغر زانه حسن اتساق يقول القاءلون اذا راوهاهذا الدر من تلك الحقاق وقال الاصمعي : ما وصف احد الثغر باحسن من بيت بشر بن ابي خازم : يفلجن الشفاه عن اقحوانجلاه غب سارية قطار ولا وصف اللون باحسن من قول عمر بن ابي ربيعة :  وهي مكنونة تحدر عنها في اديم الخدين ماء الشباب ولا وصف احد امراة الا احتاج الي قول عدي بن الرقاع : وكان بين النساء اعارها وقد كتبنا البيتين . وذكر الاصمعي بعد ذلك ما لا يليق بهذا الباب . وقالت عبد الرحمن بن الحكم بن ابي العاص : هيفاء فيها اذا استقبلتها عجفعجزاء غامضة الكعبين معطار من الاوانس مثل الشمس لم يرهابساحة الدار لا بعل ولا جار وقال خالد بن صفوان المنقري : عليك اذا ما كنت لا بد ناكحاذوات الثنايا الغر والاعين النجل وكل هضيم الكشح خفاقة الحشاقطوف الخطا بلهاء وافرة العقل وقال ذو الرمة : تريك سنة وجه غير مقرفةملساء ليس بها خال ولا ندب تزداد للعين ابهاجا اذا سفرتوتحرج العين منها حين تنتقب لمياء في شفتها حوة لعسوفي اللثات وفي انيابها شنب كحلاء في برج صفراء في نعجكانها فضة قد مسها ذهب البرج : سعة العين ، والنعج بياضها .  نعت لباسهن وزينتهن قال عمر بن ابي ربيعة : لا يزال الخلخال فوق الحشايامثل اثناء حية مفتول وقال الطاءي : من الهيف لو ان الخلاخيل صيرتلها وشحا جالت عليها الخلاخل وقال ابن الرومي : فاذا لبسن خلاخلاكذبن اسماء الخلاخل تابي تخلخلهن سو . . . ق مرجحنات بخادل وقال عبيد الله بن عبد الله بن طاهر : وشاحها يحسد خلخالهاكجاءع يحسد شبعانا وقال منصور بن كيغلغ : كانها والقرط في اذنهابدر الدجي قرط بالمشتري قد كتب الحسن علي وجههايا اعين الناس قفي فانظري وصف اسحاق بن ابراهيم الموصلي قميصا فقال : كانه قد من جرم الزهرة .  وذكر شاعر معشوقا لبس ثوبا ازرق فقال : الان صرت البدر حي . . . ن لبست لون سماءه وقال ابن الرومي : كانها وعثان المسك يشملهاشمس عليها ضبابات وادجان وقال الصابء مثله : تبخرت والعثان يكنفهافكانت البدر وسط هالته كاتب : ثوب كلعاب الشمس ، وخلع الهلال ، لو راه اصحاب الكلام ، لجعلوه من حيز الاعراض لا الاجسام . والهلال ها هنا الحية . نعت الغلمان احسن البحتري في قوله : واهيف ماخوذ من النفس شكلهتري العين ما تختار اجمع فيه وقال ابو محمد المهلبي الوزير في تكين الجاندار غلام معز الدولة :  ظبي يرق الماء فيوجناته فيرف عوده ويكاد من شبه العذا . . . ري فيه ان تبدو نهوده ناطوا بمعقد خصرهسيفا ومنطقة تووده جعلوه قاءد عسكرضاع الرعيل ومن يقوده وقال ابن المعتز في غلام عذر : ظبي يتيه بحسن صورتهعبث الفتور بلحظ مقلته وكان عقرب صدغه وقفتلما دنت من نار وجنته وقال ايضا : له مقلة ترمي القلوب ووجنةتفتح فيها الورد من كل جانب وعذر خداه بخطين قوماكما اثر التسطير في رق كاتب وكان ابو نواس والحسين بن الضحاك الخليع اول من اطنب في وصف الغلمان ، وجعلاه مذهبا ، فمن شعر ابي نواس في المعني : من كف مضطمر الزنار معتدلكانه غصن بان غير ذي اود ومنه : في مثل وجهك يحسن الشعرويكون فيه لذي الهوي عذر ما ان نظرت الي محاسنهغلا تداخلني له كبر تتزين الدنيا بطلعتهويكون بدرا حين لا بدر  ومنه : فاذا بدا اقتادت محاسنهقسرا اليه اعنة الحدق وقال ابو عثمان الخالدي : يا شبيه البدر حسناوضياء ومثالا وشبيه الغصن ليناوقواما واعتدالا انت مثل الورد لوناونسيما وملالا وقال المعروف بالعطار المغربي : مهفهف القامة ممشوقهامستملح الخطرة معشوقها في طرفه من سقم الحاظهدعوي وفي جسمي تصديقها وقال ابن ميخاءيل المغربي : صور عبد الله بن مسكةوصور الناس من الطين مهفهف القد هضيم الحشايكاد ينقد من اللين كان في اجفانه منتضيسيف علي يوم صفين نعت السودان الغاية المومي اليها قول ابن الرومي : غصن من الابنوس ركب فيمءتزر معجب ومنتطق  في لين سمورة تخيرها ال . . . فراء او لين جيد الدلق اكسبها الحسن انها صبغتصبغة حب القلوب والحدق فانصرفت نحوها الضماءر وال . . . ابصار يعنقن ايما عنق يفتر ذاك السواد عن يققمن ثغرها كاللالء النسق كانها والمزاح يضحكهاليل تفري دجاه عن فلق وكانت حاملا فقال : اخلق بها ان تقوم عن ذكركالسيف يفري مضاعف الحلق ان جفون السيوف اكثرهااسود والحق غير مختلق وقال بشار : يكون الحار في خد مليحفيكسوه الملاحة والدلالا ويوقفه لعين مبصريهفكيف اذا رايت اللون خالا وقال ابو علي البصير : لم يعبها استحالة اللون عنديانها صبغة كلون الشباب وقال اخر : مشبهات الشباب والمسك تفدي . . . هن نفسي من الردي والخطوب كيف يهوي الي الاريب وصال ال . . . بيض والبيض مشبهات المشيب  وقال الرضي ابو الحسن الموسوي : اذا كنت تهوي الظبي المي فلا تلمجنوني علي الظبي الذي كله لمي حببتك يا لون الشباب لاننيرايتكما في العين والقلب تواما وقال ابو اسحاق الصابء : لك وجه كان يمناي خطت . . . ه بلفظ تمله امالي فيه معني من البدور ولكننفضت صبغها عليه الليالي وقال اعشي بن سليم في امراته ، وكانت سوداء ، وراها تختضب : تخضب كفا بتكت من زندهافتخضب الحناء من مسودها كانها والكحل في مرودهاتكحل عينيها ببعض جلدها وقيل لاخر : لم تحب السودان ؟ قال : لانهن اسخن ، فقيل : نعم هن اسخن للعين . نظر ابن ابي عتيق الي سوداء فقال : لو اقتسمتها الغواني خيلانا لحظين بها . وقال يعقوب بن رافع : فجءني بمثل المسك اطيب نكهةوجءني بمثل الليل اطيب مرقدا  وقال اخر : كسيت من اديمها الحال الجو . . . ن غشاء احسن به من غشاء مشبها صبغة الشباب ولما . . . ت العذاري ولبسة الخطباء نعت السماء والنجوم وما يتعلق بها قال اعرابي في صفة الشمس : مخباة اما اذا الليل جنهافتخفي واما بالنهار فتظهر اذا انشق عنها ساطع الفجر وانجليدجي الليل وانجاب الحجاب المستر والبس عرض الارض لونا كانهعلي الافق الشرقي ثوب معصفر ولون كردع الزعفران يشبهشعاع يلوح فهو ازهر اصفر الي ان علت وابيض منها اصفرارهاوجالت كما جال المنيح المشهر تري الظل يطوي حين تعلو وتارةتراه اذا مالت الي الارض ينشر وافنت قرونا وهي ذاك ولم تزلتموت وتحيا كل وقت وتنشر وقال الطرماح : والشمس معرضة تمور كانهاترس يقلبه كمي رامح وقال ابن الرومي : اذا رنقت شمس الاصيل ونفضتعلي الافق الغربي ورسا مذعذعا  وودعت الدنيا لتقضي نحبهاوشول باقي عمرها فتسعسعا ولاحظت النوار وهي مريضةوقد وضعت خدا الي الارض اضرها كما لاحظت عواده عين مدنفتوجع من اوصابه ما توجعا وقال ابو النجم العجلي في اصغاء الشمس للمغيب : والشمس قد صارت كعين الاحول وقال اخر : والشمس كالمراة في كف الاشل وقال ابن الرومي : كان حنو الشمس ثم غروبهاوقد جعلت في مجنح الليل تمرض تخاوص عين مس اجفانها الكرييرنق فيها النوم ثم تغمض وانشد ثعلب لجميل يريد الهلال : كان ابن مزنتها جانحافسيط تساقط من خنصر الفسيط : قلامة الظفر . وقال ابن المعتز : في ليلة اكل المحاق هلالهاحتي تبدي مثل وقف العاج  وقال ايضا : ولاح ضوء هلال كاد يفضحهمثل القلامة قد قصت من الظفر وقال الناجم : والبدر قد قابلني طالعاكانه حزة بطيخ وقال اخر : ما للهلال ناحلا في المغربكالنون قد خط بماء الذهب وقال ابن المعتز : يا ليلة ما كان اط . . . يبها سوي قصر البقاء احييتها وامتهاوطويتها طي الرداء حتي رايت الشمس تت . . . لو البدر في افق السماء وكانه وكانهقدحان من خمر وماء وقد اكثر الشعراء في وصف الثريا ، ووصفوها فاغربوا . فمن احسن ما قيل فيها قول امرء القيس : اذا ما الثريا في السماء تعرضتتعرض اثناء الوشاح المفصل  وقال يزيد بن الطثرية : اذا ما الثريا في السماء كانهاوشاح وهي من سلكه فتبددا وقال ذو الرمة : وردت اعتسافا والثريا كانهاعلي قمة الراس ابن ماء محلق يدب علي اثارها دبرانهافلا هو مسبوق ولا هو يلحق وقال ابن الرومي : طيب ريقه اذا ذقت فاهوالثريا في جانب الغرب قرط ووصفها مرقش علي اختلاف حالها فقال : في الشر كاس وفي مغاربهاقرط وفي اوسط السماء قدم وذكر ابن المعتز المعني الاخير وزاد فيه فقال : واري الثريا في السماء كانهاقدم تبدت من ثياب حداد وقال ابن المعتز ايضا :  فناولنيها والثريا كانهاجني نرجس حيا النديم به الساقي وقال ايضا : وقد اصغت الي الغرب الثرياكما اصغي الي الحس الفروق كان نجومها والفجر بادلاعيننا سقيمات تفيق وقال جران العود : اراقب لمحا من سهيل كانهاذا ما بدا من اخر الليل يطرف وقال اخر : يقر بعيني ان اري بمكانهسهيلا كطرف الاخزر المتشاوس وقال ارطاة بن سهية : ولاح سهيل من بعيد كانهشهاب ينحيه عن الريح قابس وقال ابن المعتز : وقد لاح للساري سهيل كانهعلي كل نجم في السماء رقيب وقال البحتري :  كان سهيلا شخص ظمان جانحمن الليل في نهي من الماء يكرع وقال جرير وذكر جملة النجوم : سري نحوهم ليل كان نجومهقناديل فيهن الذبال المفتل وهو من قول امرء القيس : نظرت اليها والنجوم كانهامصابيح رهبان تشب لقفال وتبعهما ذو الرمة فقال : وردت وارداف النجوم كانهاقناديل فيهن المصابيح تزهر وقال ابراهيم بن المهدي : طرقتها ونجوم الليل خاضعةكانها في اديم الليل عنقود وقال كعب بن سعد الغنوي : وقد مالت الجوزاء حتي كانهافساطيط ركب بالفلاة نزول وقال الدلفي : اذا السماء روضةنجومها كالزهر والجو صاف لم يك . . . دره انتشار البشر  وقال ابن المعتز : كان سماءنا لما تجلتخلال نجومها عند الصباح رياض بنفسج خضل نداهيفتح بينه نور الاقاحي وقال ايضا : والصبح يتلو المشتري فكانهعريان يمشي في الدجي بسراج وقال العلوي الكوفي في النسر : وركب ثلاث كالاثافي تعاوروادجي الليل حتي اومضت سنة الفجر اذا جمعوا اسميتهم باسم واحدوان فرقوا لم يعرفوا اخر الدهر وقال محمد بن الحسين الامدي من شعراء عصرنا : ورث قميص الليل حتي كانهسليب بانفاس الصبا متوشح ورفع منه الذيل صبح كانهوقد لاح شخص اشقر اللون اجلح ولاحت بطيءات النجوم كانهاعلي كبد الخضراء نور مفتح وله ايضا : وقد غرد النسر الشمالي هابطاكما عكست في هامش دال كاتب وقد وسط النجم السماء كانهطليعة جيش او دليل ركاءب  وقال ابن حيان المغربي : وكان المجر جدول ماءنور الاقحوان في جانبيه نعت الليل والصبح وما جاء في طوله وقصره قال ذو الرمة : وليل كجلباب العروس ادرعتهباربعة والشخص في العين واحد احم علافي وابيض صارمواعيس مهري واروع ماجد وقال ابو نواس : ابن لي كيف صرت الي حريميجفن اللي مكتحل بقار ومثله لابي تمام : اليك هتكنا جنح ليل كانهقد اكتحلت منه الليالي باثمد وقال ابن المعتز : يا رب ليل اسود الجلبابملتحف بخافقي غراب وقال ذو الرمة يذكر الصبح :  كمثل الحصان الانبط البطن قاءماتمايل عنه الجل واللون اشقر اخذه ابن المعتز فقال : وما راعنا الا الصباح كانهجلال قباطي علي سابح ورد وقال ذو الرمة : كان عمود الصبح جيد ولبةوراء الدجي من حرة اللون حاسر وقال ايضا واحسن : اقامت به حتي ذوي العود في الثريوساق الثريا في ملاءته الفجر وقال حميد بن ثور : وتري الصباح كان فيه مصلتابالسيف يحمله حصان اشقر وقال ابو نواس : فقمت واللي يجلوه الصباح كماجلي التبسم عن غر الثنيات وقال ايضا : لما تبدي الصبح من حجابهكطلعة الاشمط من جلبابه  وقال ايضا : قد اغتدي والصبح في حريمهمعسكر في الزهر من نجومه والصبح قد نسم في اديمهبدعة بكتفي حيزومه دع الوصي في قفا يتيمه وقال ابن المعتز : قد اغتدي علي الجياد الضمروالصبح قد اسفر او لم يسفر حتي بدا في ثوبه المعصفركانه غرة مهر اشقر وقال : حتي بدا ضوء صباح فاتقمثل تبدي الشيب في المفارق وقال ، وذكر خيلا : فوردت قبل الظلام المعتديوالافق الغربي ذو التورد كانه اجفان علي الامرد وقال امرء القيس : وليل كموج البحر ارخي سدولهعلي بانواع الهموم ليبتلي فقلت له لما تمطي بصلبهواردف اعجازا وناء بكلكل الا ايها الليل الطويل الا انجليبصبح وما الاصباح منك بامثل  فيا لك من ليل كانه نجومه بكل مغار الفتل شدت بيذبل كان الثريا علقت في مصامهابامراس كتان الي صم جندل وقال النابغة : كليني لهم يا اميمة ناصبوليل اقاسيه بطء الكواكب تقاعس حتي قلت ليس بمنقضوليس الذي يرعي النجوم بايب وقال اخر : كان الليل اوثق جانباهواوسطه بامراس شداد وقال بشار : خليلي ما بال الدجي ليس ينزحوما لعمود الصبح لا يتوضح اضل النهار المستنير طريقهام الدهر ليل كله ليس يبرح وطال علي الليل حتي كانهبليلين موصولين ما يتزحزح اظن الدجي طالت وما طالت الدجيولكن اطال الليل هم مبرح وقال سويد بن ابي كاهل : واذا ما قلت ليل قد مضيعطف الاول منه فرجع وقال البعيث : تطاول هذا الليل حتي كانهاذا ما مضي تثني عليه اواءله  ومنهما اخذ بشار قوله : حتي كانه بليلين موصولين وقد مضي الشعر . وتبعه خالد بن يزيد فقال : والليل وقف علينا ما يفارقناكانما كل وقت منه اوله وقد ظرف القاءل : وليل المحب بلا اخر وقول اليقطيني اظرف : عدمتك من ليل اما لك اخر وقال عدي بن الرقاع : وكا ، ليلي حين تغرب شمسهبسواد اخر مثله موصول ارعي النجوم اذا تغيب كوكبابصرت اخر كالسراج يجول وقال اصرم بن حميد : وليل طويل الجانبين قطعتهعلي كمد والدمع تجري سواكبه كواكبه حسري عليه كانهامقيدة دون المسير كواكبه وقال علي بن محمد بن نصر :  لا اظلم الليل ولا ادعي ان النجوم الليل ليست تغور ليلي كما شاءت فان لم تجدطال وان جادت فيلي قصير وقال عباس بن الاحنف : ايها الراقدون حولي اعينوني علي الليل حسبة واءتجارا حدثوني عن النهار حديثااو صفوه فقد نسيت النهارا وقال اخر : ليل تحير ما ينحط في جهةكانه فوق متن الارض مشكول نجومه ركد ليست بزاءلةكانما هن في الجو القناديل حتي اري الصبح قد لاحت بشاءرهوالليل قد مزقت عنه السرابيل حتي اري الصبح كفي ان ظفرت بهوان بدت غرة منه وتحجيل وقال القاضي او القاسم التنوخي : وليلة مشتاق كان نجومهاقد اغتصبت عيني الكري فهي نوم كان عيون السامرين لطولهااذا شخصت للانجم الزهر انجم كان سواد الفجر والليل ضاحكيلوح ويخفي اسود يتبسم وقال ابن الرومي : رب ليل كانه الدهر طولاقد تناهي فليس فيه مزيد  ذي نجوم كانهن نجوم الش . . . شيب ليست تزول لا بل تزيد وقال ابو نواس في قصره : ليلة كاد يلتقي طرفاهاقصرا وهي ليلة الميلاد اخذه محمد بن احمد الاصبهاني ونقص في المعني فقال : يوم لهو قد التقي طرفاهفكان العشي منه غدو وقال ابن المعتز : يا ليلة كان من تقاصرهايعثر منها العشاء بالسحر وقال ايضا : لم تك غير شفق وفجرحتي تولت وهي بكر الدهر وقال حبيب بن عيسي الكاتب : انا خلونا ليلة مشهورةطاب الحديث وعفت الاسرار في كل مقمرة كان بياضهاللسامرين اذا استشف نهار فكانها كانت علينا ساعةوكذا ليالي العاشقين قصار وقال اعرابي : خرجت في ليلة حندس قد القت اكارعها علي الارض ، فمحت صور الابدان ، فما كنا نتعارف الا بالاذان .  وقال جحظة : وليل في كواكبه حرانفليس لطول مدته انتهاء عدمت تبلج الاصباح فيهكان الصبح جود او وفاء وقال اخر : وكانما الليل الطويل بهاقصرا وطيبا قبلة الخلس نعت السحاب والغيث وما كان منهما بينا رسول الله صلي الله عليه وسلم جالس مع اصحابه ذات يوم اذ نشات سحابة فقالوا : يا رسول الله هذه سحابة ، قال : كيف ترون قواعدها ؟ قالوا : ما احسنها واشد تمكنها . قال : كيف ترون رحاها ؟ قالوا : ما اشد استقامتها ، قال : كيف برقها ، اوميضا ام خفوا ام يشق شقا ؟ قالوا : بل يشق شقا . فقال صلي الله عليه وسلم : الحيا ، فقالوا : يا رسول الله ما راينا افصح منك ، قال : وما يمنعني وانما انزل الله عز وجل القران بلسان عربي مبين . قواعدها : اسافلها ، ورحاها : وسطها ومعظمها ، واذا استطار البرق من قطرها الي قطرها فذلك الانشقاق والانبثاق ، واذا كان البرق كالتبسم في خلل السحاب فذلك الوميض ، وومض السحاب واومض لغتان . والخفو : اقل من الومض ، يقال : خف يخفو خفوا ، وهو ان يلمع تارة ثم يسكن . وروي ان اعرابيا مكفوفا خرج مع ابنته يرعي غنما له ، فقال الشيخ : اجد ريح النسيم قد دنا ، فارفعي راسك فانظري قالت : اراها كانها  سرب معز هزلي ، او بطن حمار اصحر . قال : ارعي واحذري . ثم مكث ساعة فقال : اني اجد ريح النسيم قد دنا فما ترين ؟ قالت : اراها كانها بغال دهم تجر جلالها ، قال : ارعي واحذري . ثم سكت ساعة فقال : اني اجد ريح النسيم قد دنا فما ترين ؟ قالت : اراها كما قال الشاعر : دان مسف فوق الارض هيدبهيكاد يدفعه من قام بالراح كانما بين اعلاه واسفلهريط منشرة او ضوء مصباح فمن بعقوته كمن بنجوتهوالمستكن كمن يمشي بقرواح فقال : انجي لا ابا لك . فما انقضي كلامه حتي هطلت السماء عليها . والابيات لاوس بن حجر واولها : يا هل تري البرق لما بت ارقبهكما استضاء يهودي بمصباح اني ارقت ولم يارق معي صاحلمستكن بعيد النوم لواح يهدي الجنوب باولاه وناء بهاعجاء مزن تسح الماء دلاح كان مزنته لما علا شطبااقراب ابلق ينفي الخيل رماح كان فيه اذا ما الرعد فجرةدهما مطافيل قد همت بارشاح فاصبح الروض والقيعان مترعةمن بين مرتتق منها ومنصاح وقال الاخطل : بمرتجز داني الرباب كانهعلي ذات ملح مقسم لا يريمها فما زال يسقي بطن خبت وعرعروارضهما حتي اطمان جسيمها  وعمهما بالماء حتي تواضعتورءوس المتان سهلها وحزونها اذا قلت قد خفت عزاليه اقبلتبه الريح من عين سريع جمومها وقال : ومظلم تعلن الشكوي حواملهمستفرغ بسجال الغين منشطب دان ابست به ريح يمانيةحتي تبجس من حيران منثعب وقال ابن ميادة : سحاءب لا من صيف ذي صواعقولا محرقات ماءهن حميم اذا ما هبطن الارض قد جف عودهابكين بها حتي يعيش هشيم قيل لبعض العرب : من اين اقبلت ؟ قال : من الفج العميق . قيل اين تريد ؟ قال : البيت العتيق . قيل : وهل كان من مطر ؟ قال : نعم حتي عفي الاثر ، وانضر الشجر ، ودهده الحجر . بعث يزيد بن المهلب سريعا مولي عمرو بن حريث الي سليمان بن عبد الملك ، قال سريع : فعلمت انه سيسالني عن المطر ، ولم اكن ارتق بين كلمتين ، فدعوت اعرابيا فاعطيته درهما وقلت له : كيف تقول اذا سءلت عن المطر ؟ فكتبت ما قاله وجعلته بيني وبين القربوس حتي حفظته . فلما قدمت قرا كتابي وقال : كيف المطر يا سريع ؟ قلت : يا امير المءمنين ، عمد الثري ، واستاصل العرق ، ولم ار واديا الا داريا . فقال سليمان : هذا كلام لست بابي  عذره . فقلت : بلي ، قال : اصدقني ، فصدقته ، فضحك حتي فحص برجليه وقال : لقنته والله لابن بجدتها . انشد المبرد : اذا الله لم يسق الا الكرامفاسقي ديار بني حنبل ملثا مريا له هيدبصدوق الرواعد والازمل كان الرباب دوين السحابنعام تعلق بالارجل الرباب : سحاب دون سحاب . وقال اخر : جاءت تهادي مشرفا ذراهاتخر اولاها علي اخراها مشي العروس ناقصا خطاهاكانما تحط من حشاها قراقر الجراد ام دباها وقال ابو ذءيب : له هيدب يعلو الشراج وهيدبمسف باذناب التلاع خلوج علاجمه غرقي رواء كانهاقيان شروب رجعهن نشيج الشراج : شعاب الحرار .  وقالت اعرابية : فبينا نرمق احشاءنااضاء لنا عارض فاستنارا واقبل يزحف زحف الكسيرسياق الرعاء البطاء العشارا يغني وتضحك حافاتهامام الجنوب وتبكي مرارا فلما خشينا بان لا نجاءوان لا يكون قرار قرارا اشار له امر فوقههلم فام الي ما اشارا وقال عنترة : جادت عليها كل بكر حرةفتركن كل قرارة كالدرهم وقال ابو عون الكاتب : في مزنة طبقت فكادتتصافح الارض بالغمام وقال ابن المعتز : جاءت بجفن اكحل وانصرفتمرهاء من اسبال دمع منسكب وقال ايضا : يكسو البلاد قميصا من زخارفهكانه فوق جيب الارض مزرور  ظلت جاذره صرعي مطرحةكانه لءلء في الارض منثور وقال ايضا : ما تري نعمة السماء علي الار . . . ض وشكر الرياض للامطار وكان الربيع يجلو عروساوكانا من قطره في نثار وقال البحتري ذات ارتجاز لحنين الرعدمجرورة الذيل صدوق الوعد مسفوحة الدمع لغير وجدلها نسيم كنسيم الورد ورنة مثل زءير الاسدولمع برق كسيوف الهند جاءت بها ريح الصبا من نجدفانتثرت مثل انتثار العقد فراحت الارض بعيش رغدمن وشي اثواب الربي في برد كانما غدرانا في الوهديلعبن من حبابها بالنرد وقال الطاءي : لم ار عيرا جمة الدءوبتواصل التهجير بالتاويب ابعد من اين ومن لغوبمنها غداة السارق المهضوب كالليل او كاللوب او كالنوبمنقادة لعارض غربيب كالشيعة التفت علي النقيباخذة بطاعة الجنوب  ناقضة لمرر الخطوبتكف غرب الزمن العصيب محاءة للازمة اللزوبمحو استلام الركن للذنوب لما دنت للارض من قريبتشوفت لوبلها السكوب تشوف المريض للطبيبوطرب المحب للحبيب وفرحة الاديب بالاديبوخيمت صادقة الشءبوب فقام فيها الرعد كالخطيبوحنت الريح حنين النيب الشمس ذات حاجب محجوبوالارض في رداءها القشيب في زاهر من نبتها رطيببعد اشهباب الثلج والضريب كالكهل بعد السن والتحنيبتبدل الشباب بالمشيب كم انست من جانب غريبوفتقت من مذنب يعبوب ونفست عن بارض مكروبومكنت من نافر الجنوب تحفظ عهد الغيب بالمغيبكانها تهمي علي القلوب وقال الفرزدق وذكر الثلج : واصبح مبيض الصقيع كانهعلي سروات النيب قطن مندف وقال العرجي : كان سقيط الثلج ما حصبت بهعلي الارض قطن او دقيق مغربل وقال ابن المعتز : ارقت له والركب ميل رءوسهميخوضون ضحضاح الكري بهم فتر  علاهم جليد الليل حتي كانهمبزاة تجلي في مراتبها قمر وقال امرء القيس يصف البرق : اصاح تري برقا اريك وميضهكلمع اليدين في حبي مكلل يضء سناه او مصابيح راهبامال السليط بالذبال المفتل وقد اكثر الشعراء في ذكر البرق ولكن اعتمادنا علي ما فيه وصف او تشبيه . قال دعبل : ارقت لبرق اخر الليل منصبخفي كبطن الحية المتقلب وقال في ذلك : ما زلت اكلا برقا في جوانبهكطرفة العين يخبو ثم يختطف برق تحاسر من خفان لامعهيقضي اللبانة من قلبي وينصرف وقال اخر ويروي لعبد الله بن العباس الربيعي : الا من لبرق سري موهناخفي كغمزك بالحاجب كان تالقه في السماءيدا حاسب او يدا كاتب وقال كلثوم بن عمرو العتابي وذكر انواعا من التشبيه : ارقت للبرق يخبو ثم ياتلقيخفيه طورا وبيديه لنا الافق  كانه غرة شهباء لاءحةفي وجه دهماء ما في جلدها بلق او ثغر زنجية تفتر ضاحكةتبدو مشافرها طورا وتنطبق او سلة البيض في جاواء مظلمةوقد تلقت ظباها البيض والدرق وقال الطاءي وذكر سحابة : سيقت ببرق ضرم الزنادكانه ضماءر الاغماد وقال في ذلك : يا سهم للبرق الذي استطارابات علي رغم الدجي نهارا اض لنا ماء وكان ناراارضي الثري واسخط الغبارا وقال ايضا : اليك سري بالمدح ركب كانهمعلي الميس حيات اللصاب النضانض يشمن بروقا من نداك كانهاوقد لاح اخراها عروق نوابض وقال الحسين بن مطير : مستضحك بلوامع مستعبربمدامع لم تمرها الاقذاء فله بلا حزن ولا بمسرةضحك يراوح بينه وبكاء كثرت لكثرة ودقه اطباءهفاذا تحلب فاضت الاطباء  وكان بارقه حريق يلتقيريح عليه وعرفج والاء لو كان من لجج السواحل ماءهلم يبق في لجج السواحل ماء وقال ابو الحسن علي بن اسحاق بن خلف الزاهي يصف قوس قزح : ضحك الزمان لدمع عين مقبلينهل بين شماءل وجناءب وكان وجه الجو نيط ببرقعوكان شمس الدجن وجنة كاعب وكان قوس المزن في تخطيطهشفة بدت من تحت خضرة شارب وانشدني ابو الفوارس بن الصفي لنفسه متشبها بالقدماء : دان تكاد الوحش تكره وسطهوتمسه كف الوليد المرضع متتابع جم كان ركامهركبات قيصر او سرايا تبع فهمي فالقي بالعراء بعاعهسحا كمندفع الاتي المترع فتساوت الاقطار من افواههفالقارة العلياء مثل المدفع وغدا سراب القاع بحر حقيقةفكانه لتيقن لم يخدع متغطمطا غصب الوحوش مكانهاتياره فالضب جار الضفدع وقال عبيد : سقي الرباب مجلجل ال . . . اكناف لماح بروقه جون تكفكفه الصباوهنا وتمريه خريقه مري العسيف عشارهحتي اذا درت عروقه  ودنا يضء ربابهغابا يضرمه حريقه حتي اذا ما ذرهبالماء ضاق فما يطيقه هبت له من خلفهريح شامية تسوقه حلت عزاليه الجنو . . . ب فثج واهية خروقه نعت الارواح قال الفرزدق : وركب كان الريح تطلب عندهملها ترة من جذبها بالعصاءب سروا يخبطون الليل وهي تلفهمالي شعب الاكوار من كل جانب ثم افتخر بعد ذلك بما ليس هاهنا موضع ايراده . وقال البحتري : كان الريح والمطر المناجيخواطرها عتاب واعتذار كان مدار دجلة حين جاءتباجمعها هلال او سوار وقال ابن المعتز : يا رب ليل سحر كلهمفتضح البدر عليل النسيم تلتقط الانفاس برد النديفيه فتهديه لحر الهموم وقال ابن الرومي :  وشمال باردة النسيمالوت عن الهموم بالهموم تشفي حزازات القلوب الهيممشاية في الليل بالنميم بين نسيم الروض والخيشومكانها من جنة النعيم وقال في ذلك : كان نسيمها ارج الخزاميولاها بعد وسمي ولي هدية شمال هبت بليللافنان الغصون بها نجي اذا انفاسها نسمت سحيراتنفس كالشجي لها الخلي وقال : حيتك عنا شمال طاف ريقهابجنة فجرت روحا وريحانا هبت سحيرا فناجي الغصن صاحبهسرا بها فتنادي الطير اعلانا ورق تغني علي خضر مهدلةتسمو بها وتمس الارض احيانا تخال طاءرها نشوان من طربوالغصن من هزه عطفيه نشوانا وذكر اعرابي ركود الهواء فقال : ركد حتي كانه اذن تسمع . وقال السري الرفاء : والريح وسني خلال الروض وانيةفما يراع لها مستيقظ الترب وقال ابن المعتز : والريح تجذب اطراف الرداء كماافضي الشفيق الي تنبيه وسنان  وله ايضا ونسيم يبشر بالارض القط . . . ر كذيل الغلالة المبلول ووجوه البلاد تنتظر الغي . . . ث انتظار المحب رجع الرسول نعت الخصب والمحل بعث رجل ابنين له يرتادان في خصب ، فقال احدهما : رايت ماء غيلا ، يسيل سيلا ، وحوضه يميل ميلا ، يحسبه الراءد ليلا . قال الثاني : رايت ديمة علي ديمة ، في عهاد غير قديمة ، يشبع منها الناب قبل الفطيمة . سءل بعض العرب : ما وراءك ؟ قال : التراب يابس ، والارض عابس . قال ابو عمرو بن العلا : وقعت الي ناحية فيها نفير من الاعراب ، فرايتها مجدبة ، فقلت لبعضهم : ما بال بلدكم هذا ؟ قال : لا ضرع ولا زرع قلت : فكيف فتعيشون ؟ قالوا : نحترش الضباب ، ونصيد الدواب فناكلها . قلت : فكيف صبركم عليه ؟ فقال : يا هناه ، سءل خالق الارض : هل سويت ؟ قال : بل ارضيت . وقال الطاءي وذكر الخصب بالغيث : اذا ما ارتدي بالبرق لم يزل الثريله تبعا او يرتدي الروض بالبقل سحابا اذا القت علي خلفه الصبايدا قالت الدنيا اتي قاتل المحل تري الارض تهت ارتياحا لوقعهكما ارتاحت البكر الهدي الي البعل اذا انتشرت اعلامه حوله انطوتبطون الثري منه وشيكا علي حمل  قدمت ليلي الاخيلية علي الحجاج فقال لها : ما اتي بك يا ليلي ؟ قالت : اخلاف النجوم ، وكلب البرد ، وشدة الجهد ، وكنت لنا بعد الله ردءا . قال فاخبريني عن الارض ، قال : الارض مقشعرة ، والفجاج مغبرة ، وذو الغني مختل ، وذو الحد منفل . قال : وما سبب ذاك ؟ قالت : اصابتنا سنون مجحفة مظلمة ، لم تدع لنا فصيلا ولا ربعا ، ولم تبق عافطة ولا نافطة ، فقد اهلكت الرجال ، ومزقت العيال ، وافسدت الاموال . وقالت اعرابية : الم ترنا غبنا ماءنازمانا فظلنا نكد البءارا فلما عدا الماء اوطانهوجف الثماد فصارت حرارا وفتحت الارض افواههاعجيج الجمال وردن الجفارا وضجت الي ربها في السماءرءوس العضاه تناجي السرارا لبسنا لدي عطن ليلةعلي الياس اثوابنا والخمارا وقلنا اعيرا الندي حقهوعيشوا كراما وموتوا حرارا فان الندي لعسي مرةيرد الي اهله ما استعارا فبينا نوطن احشاءنااضاء لنا بارق فاستطارا واقبل يزحف زحف الكسيركسوق الرعاء البطاء العشارا يغني وتضحك حافاتهخلال الغمام ويبكي مرارا فلما خشينا بان لا نجاءوان لا يكون فرار فرارا اشار له امر فوقههلم فام الي ما اشارا  وقال اعرابي : مطرنا فلما ان روينا تهادرتشقاشق منها راءب وحليب ورامت رجال من رجال ظلامةوعدت ذحول بيننا وذنوب ونصت ركاب للصبا فتروحتالا ربما هاج الحبيب حبيب وطءن فناء الحي حتي كانهرجا منهل من كرهن لحيب بني عمنا لا تعجلوا بنضب الثريقليلا ويشفي المترفين طبيب فلو قد توالي النبت وامتيرت القريوخبت ركاب الحي حين تءوب وصار غبوق الخود وهي كريمةعلي اهلها ذو جدتين مشوب وصار الذي في انفه خنزوانةينادي الي هادي الرجا فيجيب اولءك ايام تبين للفتياكاب سكيت ام اشم نجيب نعت المياه والانهار والغدران قال جابر بن رالان : فيا لهف نفسي كلما التحت لوحةعلي شربة من بعض احواض مارب بقايا نطاف اودع الغيم صفوهامصقلة الارجاء زرق المشارب ترقرق ماء المزن فيهن والتقتعليهن انفاس الرياح الغراءب وقال اخر :  فما انشق ضوء الصبح حتي تبينتجداول امثال السيوف القواطع وقال اخر : الا ليت شعري هل اري جانب الحميوقد انبتت سلانه نفلا جعدا وهل اردن الدهر ماء وقيعةكان الصبا شدت علي متنه بردا وانشد الطاءي : اقرا علي الوشل السلام وقل لهكل المشارب مذ هجرت ذميم سقيا لظلك بالعشي وبالضحيولبرد ماءك والمياه حميم وقال اخر : وماء كضوء الصبح كدرت صفوهباخفاف عيس في الازمة تمرح صقيل كمتن السيف قد جر فوقهذيول رياح تغتدي وتروح وقال ذو الرمة يذم ماء : وماء قديم العهد بالناس اجنكان الدبا ماء الغضا فيه تبصق وقال ايضا : وماء كلون الغسل اقوي فبعضهاواجن اسدام وبعض مغور  وقال ابن المعتز في مثله : وماء دارس الاثار خالكدمع حار في جفن كحيل وقال ابن الرومي : علي حفافي جدول مسجورابيض مثل المهرق المنشور او مثل متن المنصل المشهورينساب مثل الحية المذعور وقال ابو الحسن السلامي : ونهر تمرح الامواج فيهمراح الخيل في رهج الغبار اذا صفرت عليه الشمس خلنانمير الماء يمزج بالعقار وقال السري الرفاء : وضاحك الروض محلي المنزلسبط هبوب الريح جعد المنهل موشح بالنور او مكللمفرجة حلته عن جدول اقبل قد غص بمد مقبلوالطير ينقض عليه من عل وصف بعضهم الماء فقال : ان قلت انه متصل فبذاك يشهد انتظامه ، وان قلت متباين فعلي ذاك يدل انقسامه . اواءله جاذبة لاواخره ، واعجازه طوع صدوره ، وهو طبيب الارض من سقامها ، يقذف ما تضمنته بطونها علي ظهورها .  انشد تغلب : ومنهل فيه الغراب ميتكانه من الاجون الزيت سقيت منه القوم واستقيت وقال ابو الحسن علي بن اسماعيل الزيدي العلوي المغربي يذكر نهرا اجراه المعز الي الساحل : يا حسن ماجلنا وخضرة ماءهوالنهر يفرغ فيه ماء مزبدا كاللءلء المنثور الا انهلما استقر به استحال زبرجدا واذا الشمال سطت علي امواجهنثرت حبابا فوقهن منضدا فكانما الفلك الاثير ادارهفلكا وضمنه النجوم الوقدا وقال ابو اسماعيل ابن عبدون الكاتب المغربي : والنيل بين الجانبين كانماقدت بصفحته صفيحة منصل ياتيك من كدر الزواخر مدهبممسك من ماءه ومصندل فكان ضوء البدر في تمويجهبرق تموج في سحاب مسبل وكان نور السرج من جنباتهزهر الكواكب تحت ليل اليل مثل الرياض مفتقا نوارهاتبدو لعين مشبه وممثل  وصف السفن قال طرفة : يشق حباب الماء خيزومها بهاكما قسم الترب المفايل باليد وقال الحسن بن هانء : سارحل من قود المهاري شملةمسخرة لا تستحث بحاد مع الريح ما راحت فان هي اعصفتتروح براس كالعلاة وهاد وقال البحتري : يا من تاهب مزمعا لرواحمتيمما بغداد غير ملاح في بطن جارية كفتك بسيرهارقلان كل شناحة وشناح فكانها والماء ينضح صدرها والخيزرانة في يد الملاح جون من العقبان تبتدر الدجيتهوي بصف واصطفاق جناح وقال ابو فراس ابن حمدان : كانما الماء عليه الجسردرج بياض خط فيه سطر  كاننا لما استتب العبراسرة موسي يوم شق البحر وقال ابو اسماعيل ابن عبدون الكاتب المغربي : بركاءب سود الرحال نجاءبلين العراءك سابقات ذلل خضر وصفر تزدهيك شياتهابمولع وملمع في اشكل كالزهر في تلوينه موشيةفي بنية مثل القصور المثل وتري زبازبها تمشي خلفهبين البطء مسيره والمعجل جري الجياد فجاهد متاخردون المدي عن سابق متمهل وزوارقا كادت تطير كانماحملت مقادمها قوادم شمال تعلو بها الارواح ثن تحطهافتكاد تلحق بالقرار الاسفل نعت الرياض والازهار قال ابن الرومي : وروضة عذراء غير عانسهجادت لها كل سماء راجسه كانما الالسن عنها خارسهفيها شموس للبهار وارسه كانها جماجم الشمامسهتروقك النورة منها الناكسه بعين يقظي وبجيد ناعسهلءلءة الطل عليها فارسه وقال في ذلك : ورياض تخايل الارض فيهاخيلاء الفتاة في الابراد  ذات وشي تكلفته سوارلبقات تحوكه وغواد شكرت نعمة الولي علي الوس . . . مي ثم العهاد بعد العهاد فهي تثني علي السماء ثناءطيب النشر شاءعا في البلاد وقال في ذلك : اصبحت الدنيا تروق من نظربمنظر فيه جلاء للبصر واها لها مصطنعا لقد شكراثنت علي الارض بالاء المطر والارض في روض كافواف الحبرتبرجت بعد حياء وخفر تبرج الانثي تصدت للذكر وقال ابو الفتح البكتمري الكاتب : وروضة راضية عن الديموطءتها بناظري دون القدم وصنتها صوني بالشكر النعم وقال العلوي الحماني : دمن كان رياضهايكسين اعلام المطارف وكانما غدرانهافيها عشور في مصاحف وكانما انوارهاتهتز بالريح العواصف  طرر الوصاءف يلتقي . . . ي بها الي طرر الوصاءف وقال البحتري : اتاك الربيع الطلق يختال ضاحكامن الحسن حتي كاد ان يتكلما وقد نبه النيروز في غلس الدجياواءل ورد كن بالامس نوما يفتحه برد النديفكانهينث حديثا كان قبل مكتما وانشد الزبير بن بكار : شموس واقمار من النور طلعلذي اللهو في اكنافها متمتع نشاوي تثنيها الرياح فتنثنيويلثم بعض بعضها ثم يرجع كان عليها من مجاجة طلهالالء الا انها ليس تلمع وتحدرها عنها الصبا فكانهادموع مراها البين والبين يفجع وقال اخر : سقيا لارض اذا ما شءت نبهنيبعد الهدو بها قرع النواقيس كان سوسنها في كل شارقةعلي الميادين اذناب الطواويس وقال ابن المعتز : كان اذريونهاوالشمس فيه كاليه مداهن من ذهبفيها بقايا غاليه  وقال ايضا يصف جملة من الانوار : الا تري البستان كيف نوراونشر المنثور بردا اصفرا وضحك الورد الي الشقاءقواعتنق القطر اعتناق الوامق في روضة كحلل العروسوخرم كهامة الطاووس وياسمين في ذري الاغصانمنتظم كقطع العقيان والسرو مثل قطع الزبرجدقد استمد الماء من ترب ندي علي رياض وثري ثريوجدول كالمبرد المجلي وفرج الخشخاش جيبا وفتقكانه مصاحف بيض الورق او مثل اقداح من البلورتخالها تجسمت من نور تبصره قبل انتشار الوردمثل الدبابيس بايدي الجند والسوسن الازاذ منشور الحللكقطن قد مسه بعض البلل وقد بدت فيه ثمار الكنكركانه جماجم من عنبر وحلق البهار بين الاسجمجة كهامة الشماس وجلنار كاحمرار الخداو مثل اعراف ديوك الهند والاقحوان كالثنايا الغرقد صقلت انواره بالقطر وقال ابن الرومي : وظلت عيون الروض تخضل بالنديكما اغرورقت عين الشجي لتدمعا  وقال اخر : وكان البنفسج الغض يحكياثر اللطم في خدود الغيد وقال عبيد الله بن عبد الله بن طاهر في النرجس : ترنو بابصارها اليك كماترنو اذا خافت اليعافير مثل اليواقيت قد نظمن عليزمرد فوقهن كافور كانها والعيون ترمقهادراهم وسطها دنانير وقال ابو نواس : لدي نرجس غض القطاف كانهاذا ما منحناه العيون عيون مخالفة في شكلهن فصفرةمكان سواد والبياض جفون وقال اخر وذكر العلة في انه عين لا تطرف فتم التشبيه : كانما النرجس يحكي لناعين محب ابدا تنظر لا تطرف الدهر لاشفاقهاتخوفا من نظرة تقصر وقال اخر : وكان العيون في النرجس الغض . . . ض عيون قد وكلت بالسهود وقال ابن الرومي يفضل النرجس علي الورد :  خجلت خدود الورد من تفضيلهخجلا توردها عليه شاهد للنرجس الفضل المبين وان ابياب وحاد عن الطريقة حاءد يحكي مصابيح السماء وتارةيحكي مصابيح السماء تراصد واذا احتفظت به فامتع صاحببحياته لو ان شيءا خالد ينهي النديم عن القبيح بلحظهوعلي المدامة والسماع مساعد فصل القضية ان هذا قاءدزهر الربيع وان هذا طارد شتان بين اثنين هذا موعدبتسلب الدنيا وهذا واعد هذي النجوم هي التي ربتهمابحيا السحاب كما يربي الوالد فانظر الي الاخوين من ادناهماشبها بوالده فذاك الماجد اين الخدود من العيون نفاسةورياسة لولا القياس الفاسد وكان ابن الرومي يكره الورد ويذمه فقال : وقاءل لم هجوت الورد قلت لهوذاك من قبحه عندي ومن غمطه كانه سرم بغل حين يفتحهوقت البراز وباقي الروث في وسطه وقال ابن الرومي يستسقي نبيذا ويذكر النرجس : ادرك ثقاتك انهم وقعوافي نرجس معه ابنة العنب فهم بحال لو بصرت بهاسبحت من عجب ومن عجب ريحانهم ذهب علي درروشرابهم در علي ذهب يا نرجس الدنيا اقم ابداللاقتراح وداءر النخب ذهب العيون اذا مثلن لناورد الجفون زبرجد القصب  وقال السري الرفاء : لو رحبت كاس بذي زورةلرحبت بالورد اذ زارها جاء فخلناه خدودا بدتمضرمة من خجل نارها قد عطر الدنيا فطابت بهلا عدمت دنياه عطارها وقال ابن الجهم : ما اخطا الورد منك شيءاطيبا وحسنا ولا ملالا اقام حتي اذا انسنابقربه اسرع انتقالا وقال البحتري : شقاءق يحملن الندي فكانهدموع التصابي في خدود الخراءد وقال محمد بن هانء المغربي : الورد في رامشنة من نرجسوالياسمين وكلهن غريب فكان هذا عاشق وكان ذا . . . ك معشق وكان ذاك رقيب وقال الشمشاطي في وصف الارض المجودة : الجو يبكي ووجه الارض مبتسمفالجو في ماتم والارض في عرس  وقال اخر : اما تري الارض قد اعطتك عذرتهامخضرة واكتسي بالنور عاريها فللسماء بكاء في جوانبهاوللربيع ابتسام في نواحيها وقال ابن رشيق المغربي : شقاءق انستك حسن الوردبكل محمر الي مسود كمقلة او شامة في خدكانها وسط ثراها الجعد تلحظ خلسا من عيون رمد وقال عبد الكريم بن ابراهيم النهشلي المغربي وجمع انواعا من التشبيه واوردتها متصلة لاحفظ نظمها البديع من التصديع : بارق في خلال غيم دلوحصدع الليل كالصباح الصديع بات يزجي سوامه من قطيعمكفهر مثل السوام القطيع فهو فيها كطرة المطرف المذ . . . هب او سلة الحسام الصنيع قاءما ينثر الحباب علي ور . . . د خدود الربيع نثر الدموع في فضاء مضمخ من عبيروهواء مخلق من ردوع يعتلي الفجر فيهما ذا حياءوتمر الرياح ذات خضوع في رياحين تاخذ الريح عنهن . . . ن معاني جيب العروس الشموع شجر ذاب فوقه القطر فاختا . . . ل من الحسن في رداء وشيع وفياء الرياض في توشيعووشاح السماء في تجزيع واصيل معصفر الجيب يجريماءه جري ادمع التوديع خففت فوقه الصبا وادارتلحظها الشمس فيه تحت خشوع  نعت النخل والشجر قال النمر بن تولب في صفة النخل : ضربن العرق في ينبوع عينطلبن معينه حتي روينا بنات الدهر لا يخشين محلااذا لم تبق ساءمة بقينا كان فروعهن بكل ريحعذاري بالذواءب ينتصينا وقال عبد الصمد يصف البلح : كانه في ناضر الاغصانزمرد لاح علي تيجان حتي اذا تم له شهرانوانسدلت عثاكل القنوان فصلن بالياقوت والمرجانرايته مختلف الالوان من قانء احمر ارجوانوفاقع اصفر كالنيران مثل الاكاليل علي الغواني وقال البحتري : ومن شجر رد الربيع لباسهعليه كما نشرت وشيا منمنما احل فابدي للعيون بشاشةوكان قذي للعين اذ كان محرما حكي ان النظام جاء به ابوه الي الخليل بن احمد وهو حدث ليعلمه ، فقال الخليل يوما يمتحنه ، وفي يده قدح زجاج : يا بني صف لي هذه الزجاجة ، قال ابمدح ام بذم ؟ قال : بمدح قال : تريك القذي ، ولا تقبل  الاذي ، ولا تستر ما وراءها . قال : فذمها ، قال : سريع كسرها ، بطء جبرها ، قال : فصف هذه النخلة ، واومي الي نخلة في داره ، قال : ابمدح ام بذم ؟ قال : بمدح قال : هي حلو مجتناها ، باسق منتهاها ، ناضر اعلاها . قال : فذمها قال : هي صعبة المرتقي ، بعيدة المجتني ، محفوف بها الاذي . قال الخليل : يا بني نحن الي التعلم منك احوج . قال سعيد بن حميد : حفت بسرو كالقيان تلبستخضر الحرير علي قوام معتدل فكانها والريح تخطر بينهاتنوي التعانق ثم يمنعها الخجل وقال : وتري الغصون اذا الرياح تنفستملتفة كتعانق الاحباب وقال ابن المعتز : ظللت بملهي خير يوم وليلةتدور علينا الكاس في فتية زهر لدي نرجس غض وسرو كانهقدود جوار رحن في ازر خضر وقال كشاجم : لنا علي دجلة نخل منتخلنسلفه ماء ويسقينا عسل كانما اعذاقه اذا حملغداءر من شعر وحف رجل وفيه عمري كعمر مقتبلكذهب الابريز لونا ومحل وجيسوان طعمه يشفي العللكانه اطراف ربات الكلل  وعظم الازاذ فيه ونبللولا النوي يشد منه لهطل وقال ابن المعتز في الكرم : حتي اذا حر اب جاش مرجلةبفاتر من هجير الصيف مستعر ظلت عناقيده يخرجن من ورقكما احتبي الزنج في خضر من الارز قال معاوية لصحار العبدي : ما هذه البلاغة التي فيكم ؟ قال : شء تجيش به صدورنا فتقذفه علي السنتنا . فقال له رجل من عرض القوم : هءلاء بالبسر ابصر منهم بالخطب . فقال صحار : اجل والله انا لنعلم ان الريح لتلقحه وان البرد ليعقده ، وان القمر ليصبغه ، وان الحر لينضجه . قال معاوية : فما تعدون البلاغة فيكم ؟ قال : الايجاز قال : وما الايجاز قال : ان تجيب فلا تبطء ، وتقول فلا تخطء . نعت الحرب والجيش قال معقر بن الحارث بن اوس بن حمار البارقي : وقد جمعا جمعا كان زهاءهجراد سفا في هبوة متطاير يفرج عنا كل خوف نخافهجواد كسرحان الاباءة ضامر وكل طموح في الحراء كانهااذا اغتسلت في الماء فتخاء كاسر فباكرهم عند الشروق كتاءبكاركان سلمي سيرها متواتر كان نعام الدو باض عليهمواعينهم تحت الحديد جواحر ضربنا حبيك البيض في غمر لجةفلم ينج في الناجين منهم مفاخر  وقال الحصين بن الحمام المري : فليت ابا شبل راي كر خيلناوخيلهم بين الستار واظلما نطاردهم نستنقذ الجرد كالقنا ويستنقذون السمهري المقوما عشية لا تغني الرماح مكانهاولا النبل الا المشرفي المصمما لدن غدوة حتي اتي الليل ما تري من الخيل الا خارجيا مسوما واجرد كالسرحان يضربه النديومحبوكة كالسيد شقاء صلدما يطان من القتلي ومن قصد القناخبارا فما يجرين الا تجشما عليهن فتيان كساهم محرقوكان اذا يكسو اجاد واكرما صفاءح بصري اخلصتها قيونهاومطردا من نسج داود مبهما يهزون سمرا من رماح ردينةاذا حركت بضت عواملها دما وقال رميض بن رشيد العنزي : فجءنا بجمع لم ير الناس مثلهيكاد له ظهر الوديقة يطلع بارعن دهم ينشد البلق وسطهله عارض فيه المنية تلمع وقال زيد الخيل : بجيش تضل البلق في حجراتهتري الاكم فيه سجدا للحوافر ومن كلام لعبد الحميد في صفة الحرب : والله لكاني انظر الي شءبوبها قد همع ، وعارضها قد لمع ، وكاني بالوعيد قد اوري نارا ، فاقلعت عن براجم بلا معاصم ، ورءوس بلا غلاصم .  وقال زهير : يطعنهم ما ارتموا حتي اذا طعنواضارب حتي اذا ما ضاربوا اعتنقا وقال مهلهل ، وذكر الحرب وتناصفهم فيها : كانا غدوة وبني ابينابجنب عنيزة رحيا مدير وقال : انبضوا معجس القسي وابرق . . . نا كما توعد الفحول الفحولا وقال : دلفت له بابيض مشرفيكما يدنو المصافح للسلام وقال قيس بن الخطيم : اذا ما فررنا كان اسوا فرارناصدود الخدود وازورار الحواجب صدود الخدود والقنا متشاجرولا نبرح الاقدام عند التضارب وقال البحتري : لقد كان ذاك الجاش جاش مسالمعلي ان ذاك الزي زي محارب وقال : تسرع حتي قال من شهد الوغيلقاء عدو ام لقاء حباءب  وقال : لله درك يوم بابك باسلابطلا لابواب الحتوف قروعا لما اتوك تقود جيشا ارعنايمشي عليه كثافة وجموعا في معرك ضنك تخال به القنابين الضلوع اذا انحنين ضلوعا وزعتهم بين الاسنة والظباحتي ابدت جموعهم توزيعا وقال ابن المعتز : وعم السماء النقع حتي كانهدخان واطراف الرماح شرار وقال ابو الهول في قتل يزيد بن مزيد الوليد بن طريف : قل للقوافل والجنود وغيرهمسيروا فقد قتل الوليد يزيد لا ذا يني طلبا ولا ذا ياتليهربا فذا نصب وذا مجهود كالليل يطلبه النهار بضوءهفظلام ذاك بنور ذا مطرود وقال اخر : عشية كنا بالخيار عليهماننقص من اعمارهم ام نزيدها وقال ابان بن عبدة بن العباس بن مسعود : اذا الدين اودي بالفساد فقل لهيدعنا وراسا من معد نصادمه ببيض خفاف مرهفات قواطعلداود فيها اثره وخواتمه  وزرق كستها ريشها مضرحيةاثيت خوافي ريشها وقوادمه بجيش تضل البلق في حجراتهبيثرب اخراه وبالشام قادمه اذا نحن سرنا بين شرق ومغربتنبه يقظان التراب وناءمه وقال الاخطل يذكر الفرار والحضر : ونجي ابن بدر ركضه من رماحناونضاخة الاعطاف ملهبة الحضر اذا قلت نالته العوالي تقاذفتبه سوحق الرجلين صاءبة الصدر كانهما والال ينجاب عنهمااذا انغمسا فيه يعومان في بحر يسر اليها والرماح تنوشهفدي لك امي ان دابت الي العصر فظل يفديها وظلت كانهاعقاب دعاها جنح ليل الي وكر وقال تميم بن ابي بن مقبل يصف الكتيبة : وشهباء ينبو الليل عنها كانهاصفا زل عن اركانها المتزحلف لها كلكل اعيا علي كل غامزبه زور باد من العز اجنف وقال الخوارزمي : بجيش عنده للاكم ثاروجسم الشمس في يده ضءيل اذا الارض اشتكته الي سماءاجابتها السماء كذا اقول فكاهل هذه منه ثقيلوناظر هذه منه كليل  وقال الحاتمي : بيوم عقيم يلقح البيض باسهولود المنايا وهو اشمط ثاكل اذا ما اسر النقع انوار شمسهاذاعت باسرار المنايا المناصل وقال ابو الفرج الببغاء : قاد الجياد الي الجياد عوابساشعثا ولولا باسه لم تنقد في جحفل كالسيل او كالليل اوكالقطر صافح موج بحر مزبد متوقد الجنبات يعتنق القنافيه اعتناق تواصل وتودد مثعنجر بظبا الصوارم مبرقتحت الغبار وبالصواهل مرعد رد الظلام علي الضحي واسترجع ال . . . اظلام من ليل العجاج الاربد وكانما نقشت حوافر خيلهللناظرين اهلة في الجلمد وكان طرف الشمس مطروف وقدجعل الغبار له مكان الاثمد وكتب كاتبه : حتي اذا اشتد الكرب ، وعظم الخطب ، وكثر الطعان والضرب ، وثار الرهج ، وسالت المهج ، وضاقت الحلق ، واحمرت الحدق ، وقامت الحرب علي ساق ، وانزل الله النصر ، وحكم لنا بالعلو والقهر ، وولوا هربا ، واتبعناهم طلبا ، قد خامرهم الوهل ، واستولي عليهم الاجل ، واخطاهم الامل ، فمن بين قتيل طريح ، وعقير جريح ، وهارب طاءح ، ومستامن جانح ، قد اصبح رجاءه خاءبا ، وظنه كاذبا ، وباله كاسفا ، وقلبه خاءفا . وكتب اخر : فبرز الفاجر الكافر في عدة تشتمل علي كذا خيلا كاتي السيل ، ورجلا كحلول الليل ، بالصفاءح المذلقة ، والرماح المثقفة ،  والقسي المطورة ، والال المطرورة ، والجواشن الحصينة ، والحلق الموضونة ، والتقت الفتيان قد انتضت مناصلها ، وهزت عواملها ، فمن مثلم في الهام مغمود ، ومجرد في الاصلاب مقصود ، ورديع بنجيع الاحشاء ، وهاتك شغف السويداء . وكتب اخر : قد خسروا الدين بما شروه من خساءس الاعراض ، وفاتتهم الدنيا بما اتيح لهم من حواضر الاجال ، وصاروا اغراضا لمواقع الغير ، ونصبا لمواضع العبر . وكتب اخر : قانعا من الامر الذي قصد له بحشاشة يستبقيها ، راضيا من مسعاته في الطمع بنفسه ان يوءب بها ، وانثال الاولياء فاصلين من العجاج اليهم ، منقضين من الجبال عليهم . وكتب اخر : فهم بين ميت مقبور بين مدرج السيول ومهب الرياح ، عواءده السباع وحواضره الذءاب ، قد اكتسب اثاما وخدت به الي مصارع الذلة ، ومضاجع الهلكة ، ومصاير اهل الشقوة ، من العذاب الواصب ، والخزي الداءم ، وبين ماسور مقهور ، قد اوبقته بجراءره ذنوبه ، واسلمته الي الذلة مكاسبه ، فهو في ضيق الاسر ، وذل القهر ، وخشوع العبودية ، و خضوع الاستكانة ، يتلهف علي فرطاته نادما ، ويحاول قبول توبته ابيا ، ويهتف بوله الاعتذار مستكينا . وكتب اخر : حتي اذا لقحت الحرب عوانا ، وبركت بكلكلها ، ودارت رحاها ، وتلافت الصفوف ، وتدانت الزحوف ، وترامي القوم ارشاقا ، فترنمت القسي ، وكثر الدوي ، ورنت الاوتار ، وشقت الابصار ، وسارت التكاءب ، وتهاوت المقانب الي المقانب ، واطعنت بالرماح ، وتدافعت بالراح ، فلم ير الا مقعص او جريح ، او ماطور او نطيح ، او ماءل او سطيح ، وقد ثار الغضب ، وانقطع السبب ، واشتدت الحمية ، وذهبت الروية ، واعترك الزحام ، وضاق مع سعة الفضاء المقام ، وتغيرت الالوان وكشرت الاسنان ، وصار الدهم  شقرا ، والشقر كمتا ، والرجال بهتا ، فعند ذلك حمي الوطيس ، واسلم الرءيس ، وحال الموت دون الفوت ، وصار الاكس كالاروق ، والمحتال كالاحمق ، وذو البصيرة كالاخرق . وقال ابو الحسن السلامي : فالروض من زهر مضرجوالماء من ماء التراءب اشكل والنقع ثوب بالنسور مطيروالارض فرش بالجياد مخيل تهوي العقاب علي العقاب ويلتقيبين الفوارس اجدل ومجدل وسطور خيلك انما الفاتهاسر تنقط بالدماء وتشكل نعت السلاح والجنن قال الرضي : وجيش يسامي كل طود عجاجهويفتر عنه كل واد يضمه تخطف ابصار الاعادي سيوفهوتملا اسماع القباءل لجمه اذا سار صبحا طارد الشمس نقعهوان سار ليلا طبق الارض دهمه تراجع حمرا في دم الضرب بيضهوتنجاب شقرا من دم الطعن دهمه وقال قيس بن الخطيم : اجالدهم يوم الحديقة حاسراكان يدي بالسيف مخراق لاعب وقال معقر بن حمار : وحامي كل قوم عن ابيهمفصارت كالمخاريق السيوف  وقال اسحاق بن خلف في السيف ايضا : القي بجانب خصرهامضي من الاجل المتاح وكانما ذر الهبا . . . ء عليه انفاس الرياح وقال ابو الهول : حسام غداة الروع ماض كانهمن الله في قبض النفوس رسول اذا ما تمطي الموت في يقظاتهفلا بد من نفس هناك تسيل كان علي افرنده موج لجةتقاصر في ضحضاحه وتطول وقال ايضا : وكان الفرند والرونق الجا . . . ري في صفحتيه ماء معين يستطير الابصار كالقبس المش . . . عل ما تستبين فيه العيون ما يبالي اذا الضريبة حانتاشمال نيطت به ام يمين نعم مخراق ذي الحفيظة في الهي . . . جاء يعصي به ونعم القرين وقال البحتري واجاد : يتناول الروح البعيد منالهعفوا ويفتح في القضاء المقفل ماض وان لم تمضه يد فارسبطل ومصقول وان لم يصقل  يغشي الوغي فالترس ليس بجنة من حده والدرع ليس بمعقل يصغي الي حكم الردي فاذا مضيلم يلتفت واذا قضي لم يعدل متوقد يفري باول ضربةما ادركت ولو انها في يذبل واذا اصاب فكل شء مقتلواذا اصيب فما له من مقتل وقال علي بن اسماعيل الزيدي العلوي المغربي : ومهند عضب الغرار كانهتحت العجاجة لجة خضراء نقش الفرند ذبابه فكانماسلخت عليه الحية الرقطاء القي عزيمته ابو موسي عليمتنيه فهو لحده امضاء وقال ابن الرومي : يشيعه قلب رواع وصارمصقيل بعيد عهده بالصياقل تشيم بروق الموت في صفحاتهوفي حده مصداق تلك المخايل وقال ابن المعتز : ولي صارم فيه المنايا كوامنفما ينتضي الا لسفك دماء تري فوق متنيه الفرند كانهبقية غيم رق دون سماء وقال ابن الرومي :  يقول القاءلون اذا راوهلامر ما تعوليت الدروع وقال مزرد بن ضرار اخو الشماخ يصف الرمح : ومطرد لدن الكعوب كانهتغشاه منباع من الزيت ساءل اصم اذا ما هز مارت سراتهكما مار ثعبان الرمال المواءل له فارط ماضي الغرار كانههلال بدا في ظلمة الليل ناحل وقال اخر : وصارم فيه ماء لو الم بهنوح علي فلكه لم يامن الغرقا وبين امواجه نار مسعرةلو حل فيها خليل الله لاحترقا وقال محمد بن هانء : وابيض كلسان البرق مخترطمن دون حق معز الدين اصليت منية ليس تبغي غير طالبهاوكوكب ليس يبغي غير عفريت وقال عنترة في الرماح : يدعون عنتر والرماح كانهااشطان بءر في لبان الادهم وقال دريد بن الصمة : فجءت اليه والرماح تنوشه كوقع الصياصي في النسيج الممدد وقال الطاءي :  مثقفات سلبن الروم زرقتهاوالعرب الوانها والعاشق القضفا وقالت ليلي الاخيلية : ان الخليع ورهطه في عامركالقلب البس جءجءا وحزيما قوم رباط الخيل وسط بيوتهمواسنة زرق يخلن نجوما وقال الطاءي : من كل ازرق نظار بلا نظرالي المقاتل ما في متنه اود انه كان ترب الحب مذ زمنفليس يعجزه قلب ولا كبد وقال ساعدة بن جءية : واعد ازرق في الكماة كانهفي طخية الظلماء ضوء شهاب وقال اخر : واسمر خطيا كان كعوبه نويالقسب قد ارمي ذراعا علي العشر وقال مالك بن نويرة : وسمر كاشطان الجرور نواهليجور بها زو المنايا ويهتدي يقعن معا فيهم بايدي كماتناكان المنون للرماح بموعد وقال سلامة بن جندل :  سن الثقاف قناها فهي محكمةقليلة الزيغ من هم وتركيب كانها باكف القوم اذ لحقوامواتح البءر او اشطان مطلوب وقال ابن المعتز وجمع : اعددت اخرس للطعان ونثرةزغفا ومطردا من الخرصان وكعوب شوحطة كان حنينهابالكف عولة فاقد مرنان وسلاجما زرقا كان ظباتهامشحوذة بضراءم النيران افواقها حشو الجفير كانهاافواه افرخة من النغران وقال الشماخ يصف قوسا : اذا انبض الرامون عنها ترنمتترنم ثكلي اوجعتها الجناءز وانشد ثعلب فيها : وهي اذا انبضت فيها تسجعترنم الثكلي ابت لا تهجع واولها : نزعت فيها وهي فرع اجمعوهي ثلاث اذرع واصبع وافتخرت جاريتان من العرب بقوسي ابيهما فقالت احداهما : قوس ابي طروح مروح ، تعجل الظبي ان يروح . وقالت الاخري : قوس ابي كزة ، تعجل الظبي النقزة .  وقال محمد بن بشير : ومشمرين عن السواعد حسرعنها بكل رفيقة التوتير ليس الذي تشوي يداه رميةمنهم بمعتذر ولا معذور عطف السيات موانع في عطفهاتعزي اذا نسبت الي عصفور وقال ابو العيال الهذلي في السهام : فتري النبال تعير في اقطارهاشمسا كان نصالهن السنبل وقال ابو كبير الهذلي : فتعاوروا نبلا كان سوامهانفيان قطر في عشي مسدف وقال : ومعابلا صلع الظبات كانهاجمر بمسهكة يشب لمصطلي نجفا بذلت لها خوافي ناهضحشر القوادم كاللفاع الاطحل واذا تسل تخشخشت ارياشهاخشف الجنوب بيابس من اسحل مسهكة : موضع ريح شديدة ، ونجف : جمع نجيف اي عريض ، وحشر لطيف ، واللفاع : لحاف يتلفع به ، واطحل : اسود .  وقال ابو دواد وذكر الدرع : واعددت للحرب فضفاضةتضاءل في الطي كالمبرد وقال امرء القيس : ومسرودة النسج موضونةتضاءل في الطي كالمبرد تفيض علي المرء اردانهاكفيض الاتي علي الجدجد وقال اخر : وارعن ملموم الكتاءب خيلهمضرجة اعرافها ونحورها عليها مذالات القيون كانهاعيون الافاعي سردها وقتيرها وقال جزء بن ضرار : ومسفوحة فضفاضة تبعيةواها القتير تجتويها المعابل دلاص كظهر النون لا يستطيعهاسنان ولا تلك الحظاء الدواخل الحظاء : جمع حظوة وهي سهام صغار لا نصل لها . وقال حزن بن عامر الطاءي : لباسهم اذا فزعوا دروعكان قتيرها حدق الجراد  وقال اخر : فتخال موج البحر يصفق بعضهبعضا وميض قتيرها وسرادها وقال محمد بن عبد الملك الحلبي : وعلي سابغة الذيول كانهاسلخ كسانيه الشجاع الارقم وقال ابو الحسين ابن لنكك البصري : يا رب سابغة حبتني نعمةكافاتها بالسوء غير مفند اضحت تصون عن المنايا مهجتيوظللت ابذلها لكل مهند وقال عمر بن الخطاب رضي الله عنه لعمرو بن معد يكرب : اخبرني عن السلاح قال : عن اية تسال ؟ قال : اخبرني عن الرمح قال : اخوك وربما خانك ، قال فالسهام ، قال : منايا تخطء وتصيب قال : فالدرع : قال مشغلة للفارس ، متعبة للراجل ، وانها لحصن حصين ، قال : فالترس ، قال : ذاك مجن وعليه تدور الدواءر . قال : فالسيف ، قال : هناك قارعتك امك الهبل . ولهذا الخبر تمام لا يليق بهذا المكان ايراده . قال الرقاشي في قوس : مجلوزة الاكعب في استواءسالمة من ابن السيساء فلم تزل مساحل البراءتاخذ من طراءف اللحاء حتي بدت كالحية الصفراءترنو الي الطاءر في الهواء بمقلة سريعة الاقذاءليست بكحلاء ولا زرقاء  وقال اخر فيها : صفراء نبع خطموها بوترلام ممر مثل حلقوم النغر حدت ظباة اسهم مثل الشررفصرعتهن باخفاف القتر حور العيون بابليات النظريحسبها الناظر من خير البشر وقال ابن نباته في سكين : ما ابصر الناظر من قبلهاماء ونارا جمعا في مكان ووصفها اخر فقال : اقطع من البين . النامي في سيف : فيريك في لالاءه متوقداحنق المنون به علي الاجال نعت انواع القتل والجراح قال معقر بن حمار البارقي : كان جماجم الابطال لماتلاقينا ضحي حدج نقيف وقال عنترة : وحليل غانية تركت مجدلاتمكو فريصته كشدق الاعلم سبقت يداي له بعاجل طعنةفوهاء نافذة كلون العندم  وقال ابو خراش الهذلي : فنهنهت اولي القوم عني بضربةتنفس منها كل حشيان مجحر وطعن كرمح الشول امست غوارزاجواذبها تابي علي المتغبر الغوارز : التي قد ذهبت البانها فاذا طلب منها الدر رمحن . والغبر بقية اللبن . وقال قيس بن الخطيم : طعنت ابن عبد القيس طعنة ثاءرلها نفذ لولا الشعاع اضاءها ملكت بها كفي فانهرت فتقهايري قاءم من دونها ما وراءها وقال ابو النجم يصف الطعنة : لنصرعن ليثا يرن ماتمهبطعنة نجلاء فيها المه يجيش من نهر تراقيه دمهكمرجل الصباغ جاش بقمه وقال محمد بن عبد الملك الحلبي : نهنهت اولاها بضرب صادقهبر كما خط الرداء المعلم وقال السري الرفاء : لما تراءي لك الجمع الذي نزحتاقطاره ونات بعدا جوانبه  تركتهم بين مصبوغ تراءبهمن الدماء ومخضوب ذواءبه فحاءد وشهاب الرمح لاحقهوهارب وذباب السيف طالبه يهوي اليه بمثل النجم طاعنهوينتحيه بمثل البرق ضاربه يكسوه من دمه ثوبا ويسلبهثيابه فهو كاسيه وسالبه ونظر في هذا المعني الي قول البحتري : سلبوا واشرقت الدماء عليهممحمرة فكانهم لم يسلبوا وانشد المبرد في مصلوب : قام ولما يستعن بساقهالف مثواه علي فراقه كانما يضحك من اشداقه وقال مسلم بن الوليد في مثله : وراس مهران قد ركبت قلتهلدنا كفاه مكان الليت والجيد وضعته حيث ترتاب الرياح بهوتحسد الطير فيه اضبع البيد ما زال يعنف بالنعمي ويغمطهاحتي استقل به عود علي عود تعدو السباع فترميه باعينهاتستنشق الجو انفاسا بتصعيد وقال الطاءي : ولقد شفي الانفاس من برحاءهاان صار بابك جار مازيار  سود اللباس كانما نسجت لهمايدي السموم مدارعا من قار بكروا واسروا في متون ضوامرقيدت لهم من مربط النجار لا يبرحون ومن راهم خالهمابدا علي سفر من الاسفار وقال البحتري في مثله : وتراه مطردا علي اعوادهمثل اطراد كواكب الجوزاء مستشرفا للشمس منتصبا لهافي اخريات الجذع كالحرباء وقال الاخيطل الواسطي : كانه عاشق قد مد بسطتهيوم الفراق الي توديع مرتحل او قاءم من نعاس فيه لوثتهمداوم لتمطيه من الكسل وقال ابو الحسن الانباري في ابن بقية لما صلبه عضد الدولة فوصف حاله وان كان مخرجه مخرج التابين : علو في الحياة وفي المماتبحق انت احدي المعجزات ولما ضاق بطن الارض عن انيضم علاك من بعد الممات اصاروا الجو قبرك واستنابواعن الاكفان ثوب السافيات كان الناس حولك حين قامواوفود نداك ايام الصلات كانك قاءم فيهم خطيباوكلهم قيام للصلاة  مددت يديك نحوهم احتفاءكمدهما اليهم بالهبات اسات الي النواءب فاستثارتفانت قتيل ثار الناءبات نعت المعاقل والابنية قال ابو تمام وذكر عمورية : وبرزة الوجه قد اعيت رياضتهاكسري وصدت صدودا عن ابي كرب بكر فما افترعتها كف حادثةولا ترقت اليها همة النوب من عهد اسكندر او قبل ذلك قدشابت نواصي الليالي وهي لم تشب وقال اخر في وصف قلعة : وخلقاء قد تاهت علي من يرومهابمرقبها العالي وجانبها الصعب يزر عليها الجو جيب غمامهويلبسها عقدا بانجمه الشهب فابرزتها مهتوكة الجيب بالقناوغادرتها ملصوقة الخد بالترب وقال علي بن الجهم : وقبة ملك كان النجو . . . م تصغي اليها باسرارها لها شرفات كان النجومكستها طراءف انوارها وهن كمصطبحات خرجنلعيد النصاري وافطارها فمن بين عاقصة شعرهاومصلحة عقد زنارها  وقال البحتري : لما كملت روية وعزيمةاعملت رايك في ابتناء الكامل ذعر الحمام وقد ترقت فوقهمن منظر خطر المزلة هاءل وكان حيطان الزجاج بجوهلجج يمجن علي جوانب ساحل وكان تفويف الرخام اذا التقيتاليفه بالمنظر المتقابل حبك الغمام رصفن بين منمرومسير ومقارب ومشاكل وقال : يا من راي البركة الحسناء رءيتهاوالانسات اذا لاحت مغانيها ما بال دجلة كالغيري تنافسهافي الحسن طورا واطوارا تباهيها كان جن سليمان الذين ولواابداعها فادقوا في معانيها فلو تمر بها بلقيس عن عرضقالت هي الصرح تمثيلا وتشبيها اذا علتها الصبا ابدت لها حبكامثل الجواشن مصقولا حواشيها اذا النجوم تراءت في جوانبهاليلا حسبت سماء ركبت فيها كانها حين لجت في تدفقهايد الخليفة لما سال واديها وقال : غرف من بناء دين ودنيايوجب الله فيه اجر الامام  شوقتنا الي الجنان فزدنافي اجتناب الذنوب والاثام وقال المتوكل لابي العيناء وقد بني بناء : كيف تري دارنا ؟ قال : رايت الناس يبنون دورهم في الدنيا ، وانت بنيت الدنيا في دارك . وقال ابو سعيد الرستمي في دار بناها الصاحب : هي الدار ابناء الندي من حجيجهانوازل في ساحاتها وقوافلا فكم انفس تاوي اليها مغذةوافءدة تهوي اليها حوافلا وسامية الاعلام تلحظ دونهاسنا النجم في افاقها متضاءلا نسخت بها ايوان كسري بن هرمزفاصبح في ارض المداءن عاطلا فلو ابصرت ذات العماد عمادهالامست اعاليها حياء اسافلا ولو لحظت جنات تدمر حسنهادرت كيف تبني بعدهن المجادلا متي ترها خلت السماء سرادقاعليها واعلام النجوم تماثلا وقال علي بن يوسف المغربي التونسي : بني منظرا يسمي العروسين رفعةكان الثريا عرست في قبابه اذا الليل اخفاه بحلكة لونهبدا ضوءه كالبدر تحت سحابه تمكن من سعد السعود محلهفاضحي ومفتاح الغني قرع بابه ولو شاده عزم المعز ورايهعلي قدره في ملكه ونصابه لكان حصي الياقوت والتبر مفرغاعلي المسك من اجره وترابه وكانت اعاليه سموا ورفعةتباشر ماء المزن قبل انسكابه  سال عثمان رضي الله عنه بعض من وفد عليه عن حصن بناحية هراة فقال قي ذلك : محلقة دون السماء كانهاغمامة صيف زال عنها سحابها فما تبلغ الاروي شماريخها العليولا الطير الا نسرها وعقابها وما خوفت بالذءب ولدان اهلهاولا نبحت الا النجوم كلابها نعت الدار والرسوم قال زهير بن ابي سلمي : لمن طلل برامة لا يريمعفا وخلا له حقب قديم يلوح كانه كفا فتاةترجع في معاصمها الوشوم ابو نواس : لم دمن تزداد حسن رسومعلي طول ما اقوت وطيب نسيم تجافي البلي عنهن حتي كانمالبسن علي الاقواء ثوب نعيم وقال الطاءي : ان شءت ان لا تري صبرا لمصطبرفانظر علي اي حال اصبح الطلل كانما جاد مغناه فغيرهدموعنا يوم بانوا وهي تنهمل  وقال البحتري : اري بين ملتف الاراك منازلامواثل لو كانت مهاها مواثلا لقينا المغاني باللوي فكانمالقينا الغواني الانسات عواطلا وقال معلي الطاءي : لبسن البلي حتي كان رسومهاطعمن الهوي او ذقن فقد الحباءب وقال محمد بن وهيب : لبسا البلي فكانما وجدابعد الاحبة مثل ما اجد وقال الطاءي : او ما رايت منازل ابنة مالكرسمت له كيف الزفير رسومها وكانما القي عصاه بها النويمن نية قذف فليس يريمها وقال ابن هرمة : نبكي علي دمن ونءي هامدوجواثم سفع الخدود رواكد عرين من عقب القدور واهلهافعكفن بعدهم بهاب لابد ووقينه عبث الصبا فكانهدنف مرته الربع بين عواءد  وقال ابو نواس : لمن طلل عاري المحل دفينخلا عهده الا خوالد جون كما اقترنت عند المبيت حماءمبعيدات ممسي ما لهن وكون وقال ايضا في الاثافي في معرض الذم : رايت قدور الناس سودا من الصلاوقدر الرقاشيين بيضاء كالبدر نبينها للمعتفي بفناءهمثلاث كنقط الثاء من نقط الحبر وقال الطاءي : اثاف كالخدود لطمن حزناونءي مثل ما انفصم السوار وقال : والنءي اهمد شطره فكانهتحت الحواجب حاجب مقرون وقال ابن المعتز : عفا غير ماءلات كانهاخدود عذاري مسهن شحوب وقال القطامي : وما هداني لتسليم علي دمنبالغمر غيرهن الاعصر الاول  فهن كالحلل الموشي ظاهرهااو كالكتاب الذي قد مسه بلل وقال ذو الرمة : كانها بعد احوال مضين لهابالاشيمين يمان فيه تسهيم اودي بها كل عراص الث بهااو جافل من عجاج الصيف مهجوم منازل الحي اذ لا الدار نازحةبالاصفياء واذ لا العيش مذموم كادت بها العين تنبو ثم بينهامعارف الارض والجون اليحاميم وقال بعض اهل المعرة ، وهو ابن النوت ، وتروي لابي العلاء وليست له : مررت بربع في سياث فراعنيبه زجل الاحجار تحت المعاول تناولها عبل الذراع كانماجني الحقد فيما بينهم حرب واءل اهادمها شلت يمينك خلهالمعتبر او واقف او مساءل منازل قوم اذكرتنا حديثهمولم ار احلي من حديث المنازل وصف الفلاة والال وقال الاخطل : وبيداء ممحال كان نعامهابارجاءها القصوي اباعر همل  تري لامعات الال فيها كانهارجال تعري تارة وتسربل وجوز فلاة ما يغمض ركبهاولا عين هاديها من الخوف تغفل بكل بعيد الغول لا يهتدي بهبعرفان اعلام وما فيه منهل ملاعب جنان كان ترابهاذا اطردت فيه الرياح مغربل اجزت اذا الحرباء اوفي كانهمصل يمان او اسير مكبل تري الثعلب الحولي فيها كانهاذا ما علا نشزا حصان مجلل وقال زهير : وتنوفة عمياء لا يجتازهاالا المشيع ذو الفءاد الهادي قفر هجعت بها ولست بناءموذراع ملقية الجران وسادي وعرفت ان ليست بدار اقامةفكصفقة بالكف كان رقادي وقال جرير : وهاجد موماة بعثت الي السريوللنوم احلي عنده من جني النحل يكون نزول الركب فيها كلا ولاغشاشا ولا يدنين رحلا الي رحل وقال ذو الرمة : وغبراء يقتات الاحاديث ركبهاوتشفي ذوات الضغن من طاءف الجهل تري قورها يغرقن في الال مرةواونة يخرجن من غامر ضحل  ورمل عزيف الجن في عقداتههزيز كتضراب المغنين بالطبل وقال ايضا : ودوية جرداء جداء خيمتبها هبوات الصيف من كل جانب سباريت يخلو سمع مجتاز خرقهامن السمع الا من ضباح الثعالب وقال : ومشتبه الارباء يرمي بركبهيبيس الثري ناءي المناهل اخرق اذا هبت الريح الصبا درجت بهغراءب من بيض هجاءن دردق فاصبحت اجتاب الفلاة كاننيحسام جلت عنه المداوس مخفق الارباء : جمع ربوة ، واخرق : بعيد واسع ، ودردق : صغار ولا واحد لها من لفظها ، واراد بالغراءب : فراخ النعام . وقال ايضا : وساحرة السراب من المواميترقص في عساقلها الاروم العساقل : السراب ، والاروم : الاعلام . يموت قطا الفلاة بها اواماويهلك في جوانبها النسيم مللت بها المقام وارقتنيهموم ما تنام ولا تنيم ابيت الليل ارعي كل نجموشر رعاية العين النجوم  وقال مسعود اخو ذي الرمة : ومهمه فيه السراب يلمحيداب فيه القوم حتي يطلحوا ثم يظلون كان لم يبرحواكانما امسوا بحيث اصبحوا وكان ابو حامد البصري اذا راي اهل النظر وتفرقهم بعد الكلام في المجلس والخصام تمثل بابيات مسعود هذه . وقال اخر : اخوف بالحجاج حتي كانماتحرك عظم في الفءاد مهيض ودون يد الحجاج من ان تنالنيبساط لايدي الناعجات عريض مهامه اشباه كان سرابهاملاء بايدي الغاسلات رحيض وقال مسلم بن الوليد : وقاطعة رجل السبيل مخوفةكان علي ارجاءها حد مبرد مءزرة بالال فيها كانهارجال قعود في ملاء معمد وقال اسحاق الموصلي وتشبه بذي الرمة : ومدرجة للريح تيهاء لم يكنليجشمها زميلة غير حازم يضل بها الساري وان كان هادياوتقطع انفاس الرياح النواسم تعسفت افري جوزها بشملةبعيدة ما بين القرا والمحازم كان شرار المرو من نبذها بهنجوم هوت اخري الليالي العواتم  وقال القلاخ : وبلد اغبر مخشي العطبيضحي به موج السراب مضطرب لو قذف الكتان فيه لالتهبقطعت احشاه بسير منجذب وقال ذو الرمة : قد اعسف النازح المجهول معسفهفي ظل اغضف يدعو هامه البوم بين الرجا والرجا من جنب واصيةيهماء خابطها بالخوف معكوم للجن بالليل في ارجاءها زجلكما تناوح يوم الريح عيشوم دوية ودجي ليل كانهمايم تراطن في حافاته الروم كاننا والقنان القود تحملناموج الفرات اذا التج الدياميم وصف السير والسري وقال الاخطل : وغارت عيون العيس والتفت العريفهن من الضراء والجهد نحل وقد ضمرت حتي كان عيونهابقايا قلات او ركي ممكل ممكل : غار ماءها ونزح ثم جم بعد النزح ، يقال فيه مكلة من ماء اي قليل اجتمع بعد النزح . وصارت بقاياها الي كل حرةلها بعد اساد مراح وافكل  وقعن وقوع الطير فيها وما بهاسوي حرة ترجيعها متطلل وقال ذو الرمة : ونشوان من طول النعاس كانهبحبلين في مشطونة يترجح اطرت الكري عنه وقد مال راسهكما مال رشاف الفضال المرنح اذا مات فوق الرمل احييت روحهبذكراك والعيس المراسيل جنح وقال الحطيءة : واشعث يهوي النوم قلت له ارتحلاذا ما الثريا اعرضت واسبطرت فقام يجر الثوب لو ان نفسهيقال له خذها بكفيك خرت وقال الفرزدق : وابيض مخمور يميل براسهنعاسا ولم يشرب طلاء ولا خمرا اذا لم يجد بدا من الامر هجتهوجيب الذراع لا يضيق به صدرا وقال اعرابي : بدان بنا وابن الليالي كانهحسام جلا عنه القيون صقيل فما زلت افني كل يوم شبابهالي ان اتتك العيس وهو ضءيل وقال مسكين الدارمي : ومنعقد ثني اللسان بعثتهتخال النعاس في مفاصله خمرا رماه الكري في الراس حتي كانهاميم جلاميد تركن به وقرا  وقال ذو الرمة : واشعث مثل السيف قد لاح جسمهوجيف المهاري والهموم الاباعد سقاه السري كاس النعاس فراسهلدين الكري من اخر الليل ساجد اقمت له صدر المطي وما درياجاءرة اعناقها ام قواصد تري الناشء الغريد يضحي كانهعلي الرحل مما منه السير عاصد منه : اي جهده ، وعصد البعير : اذا لوي عنقه للموت . وقال مسلم بن الوليد : اليك امين الله راعت بنا القطابنات الفلا في كل نشز وفدفد اخذن السري اخذ العنيف واسرعتخطاها بها والنجم حيران مهتد لبسن الدجي حتي نضت وتصوبتهوادي نجوم الليل كالدحو باليد وقال العتابي : واشعت مشتاق رمي في جفونهغريب الكري بين الفجاج السباسب امات الليالي شوقه غير زفرةتردد ما بين الحشا والتراءب سحبت له ذيل السري وهو لابسدجي الليل حتي صح ضوء الكواكب ومن فوق اكوار المهاري لبانهاحل لها اكل الذري والغوارب اذا ادرع الليل انجلي وكانهبقية هندي حسام المضارب بركب تري كسر الكري في جفونهموعهد الفيافي في وجوه شواحب وقال الطاءي وجعل السير طريقا الي همة مروته :  وركب كامثال الاسنة عرسواعلي مثلها والليل تسطو غياهبه لامر عليهم ان تتم صدورهوليس عليهم ان تتم عواقبه وقال جحدر بن ربيعة العكلي : وركب تعادوا بالنعاس كانماتساقوا عقارا خالطت كل مفصل سريت بهم حتي مضي الليل كلهولاحت هوادي الصبح للمتامل وقالوا وقد مالت طلاهم من الكريانخ انها نعمي علينا وافضل فطاوعتهم حتي اناخوا كلا ولامهاري لهوا منها ولما تعقل ومالوا علي اعطافها وتوسدواالي الركب اليسري سواعد اشمل ولاثوا بايديهم فضول ازمةتصور البري ازرارها لم تحلل غشاشا غرار العين ثم تنبهواسراعا الي اكوار سدس وبزل وقال ابو النجم العجلي : وبلدة ما الانس من اهالهاولا ضعيف القوم من رجالها زوراء تبكي الجن من امحالهاقطعت بالعيس علي كلالها نعت البيان والمحاورة قال حسان بن ثابت : لساني وسيفي صارمان كلاهماويبلغ ما لا يبلغ السيف مذودي وقال جرير فاخذ اللفظ والمعني :  لساني وسيفي صارمان كلاهماوللسيف اشوي وقعة من لسانيا وقال الاخطل : افحمت عنكم بني النجار قد علمتعليا معد وكانوا طالما هدروا حتي استكانوا وهم مني علي مضضوالقول ينفذ ما لا تنفذ الابر وقال محمد بن هانء : حكم يجلي غيب كل ملمةكالشمس تكشف جنح كل ظلام وقال اخر : من كل معني يكاد الميت يفهمهحسنا ويعبده القرطاس والقلم وقال الصابي : فقر لم يزل اليها فقيراكل مبدي فصاحة ومعيد يغتدي البارع المفيد اليهالاحقا بالمقصر المستفيد ببيان شاف ولفظ مصيبواختصار كاف ومعني سديد وقال ايضا : ولي فقر تضحي الملوك فقيرةاليها لدي احداثها حين تطرق ارد بها راس الجموح فينثنيواجعلها سوط الحرون فيعنق فان حاولت لطفا فماء مرقرقوان حاولت عنفا فنار تالق وقال ابو فراس ابن حمدان :  وروضة من رياض الفكر دبجهاصوب القراءح لا صوب من المطر كانما نشرت يمناك بينهمابردا من الوشي او بردا من الحبر وقال اخر : نطقت بحكمة جلي سناهاعن المعني اللطيف دجي الظلام تلذ كانها راح وروحتمشي في العروق وفي العظام وقول رسول الله صلي الله وعليه وسلم : ' ان من البيان لسحرا ' هو الغاية ايجازا وبلاغة . وكتب الصاحب بن عباد : خط احسن من عطفات الاصداغ ، وبلاغة كالامل اذن بالبلاغ . فقر كما جيدت الرياض ، وفصول كما تغامزت المقل المراض . الفاظ كما نورت الاشجار ، ومعان كما تنفست الاسحار . وقال الماهر : وحديث كانهاوبة من مسافر فهو احلي من الرقا . . . د لدي طرف ساهر وقال بشار : وكان رجع حديثهاقطع الرياض كسين زهرا وكان تحت لسانهاهاروت ينفث فيه سحرا وقال السري الرفاء : يتنازعون علي الرحيق غراءبايحسبن زاهرة كءوس رحيق  صدرت عن الافكار وهي كانهارقراق صادرة عن الراووق وقال محمد بن احمد الحزور : لله لءلء الفاظ اساقطهالو كن للغيد لاستانسن بالعطل ومن عيون معان لو كحلت بهانجل العيون لاغناها عن الكحل سحر من الفكر لو دارت سلافتهعلي الزمان تمشي مشية الثمل وصف العباس بن الحسن العلوي رجلا بفصاحة فقال : ما شبهته يتكلم الا بثعبان ينهال من رمال ، او ماء يتغلغل بين جبال . وقال ثمامة : كان جعفر بن يحيي انطق الناس ، قد جمع التمهل والجزالة والحلاوة وافهاما يغنيه عن الاعادة ، ولو كان في الارض ناطق يستغني بمنطقه عن الاشارة لاستغني جعفر عن الاشارة كما استغني عن الاعادة . وقال : قلت لجعفر : ما البيان ؟ فقال : ان يكون الكلام يحيط بمعناك ، ويجلي عن مغزاك ، وتخرجه من الشركة ، ولا تستعين عليه بالفكرة ، والذي لا بد منه ان يكون سليما من التكلف ، بريءا من التعقيد ، غنيا عن التاويل . الجاحظ : هذا تاويل قول الاصمعي : البليغ من طبق المفصل ، واغناك عن المفسر . قال المفضل : قلت لاعرابي : ما البلاغة ؟ قال : الايجاز في غير عجز ، والاطناب في غير خطل . وذكر اعرابي امراة فقال : كلامها الوبل علي المحل ، والعذب البارد علي الظما .  والجيد قول القطامي : فهن ينبذن من قول يصبن بهمواقع الماء من ذي الغلة الصادي وقول الاخطل : وقد تكون بها سلمي تحادثنيتساقط الحلي حاجاتي واسراري وقول الشماخ : حديث لو ان اللحم يصلي ببعضهغريضا اتي اصحابه وهو منضج قال عبد الحميد بن يحيي : البلاغة ما رضيته الخاصة ، وفهمته العامة . وقال ايضا : خير الكلام ما قل ودل ولم يمل قال اخر : اللفظ الحسن احدي النفاثات في العقد . نعت القوافي وقال عدي بن الرقاع : وقصيدة قد بت اجمع شملهاحتي اقوم ميلها وسنادها نظر المثقف في كعوب قناتهحتي يقيم ثقافه منادها وعلمت اني لست اسال واحداعن حرف واحدة لكي ازدادها  وقال بشر بن ابي خازم : فابعثهن اربعة وخمسابالفاظ مثقفة عذاب وكنت اذا وسمت بهن قوماكاطواق الحماءم في الرقاب وقال الفرزدق : ومن يك خاءفا لاذاة شعريفقد امن الهجاء بنو حرام هم قادوا سفيههم وخافواقلاءد مثل اطواق الحمام ومثله قول ابن هرمة : اني اذا ما امرء خفت نعامتهفي الجهل واستحكمت منه قوي الوذم عقدت في ملتقي اوداج لبتهطوق الحماءم لا يبلي علي القدم وقال جرير : وعاو عوي من غير شء رميتهبقافية انفاذها تقطر الدما خروج بافواه الرواة كانهاقرا هندواني اذا هز صمما وقالت الخنساء : وقافية مثل حد السنا . . . ن تبقي ويذهب من قالها نطقت ابن عمرو فسهلتهاولم ينطق الناس امثالها  وقال ابو تمام الطاءي : ووالله لا انفك اهدي شواردااليك يحملن الثناء المنخلا تخال به بردا عليك محبراوتحسبه عقدا عليك مفصلا الذ من السلوي واطيب نفحةمن المسك مفتوقا وايسر محملا اخف علي روح واثقل قيمةواقصر في سمع الجليس واطولا ويزهي له قوم ولم يمدحوا بهاذا مثل الراوي به او تمثلا وقال علي بن الجهم : ولكن احسان الخليفة جعفردعاني الي ما قلت فيه من الشعر فسار مسير الشمس في كل بلدةوهب هبوب الريح في البر والبحر وقال البحتري : وقد اتتك القوافي غب مسالةكما تفتح غب الوابل الزهر وقال : وكنت اذا استبطات ودك زرتهبتفويف شعر كالرداء المحبر عتاب باطراف القوافي كانهطعان باطراف القنا المتكسر فاجلو به وجه الاخاء واجتليحياء كصبغ الارجوان المعصفر  وقال : الست الموالي فيك نظم قصاءدهي الانجم اقتادت مع الليل انجما ثناء كان الروض فيه منورضحي وكان الوشي فيه منمنما وقال : اليك القوافي نازعات قواصدايسير ضاحي وشيها وينمنم ومشرقة في النظم غرا يزينهابهاء وحسنا انها لك تنظم ضوامن للحاجات اما شوافعامشفعة او حاكمات تحكم وكاءن غدت لي وهي شعر مسيروراحت علي وهي مال مسوم وقال ايضا : في نظام من البلاغة ما شك . . . ك امرء انه نظام فريد ومعان لو فصلتها القوافيهجنت شعر جرول ولبيد حزن مستكمل الكلام اختياراوتجنبن ظلمة التعقيد وركبن اللفظ القريب فادرك . . . ن به غاية المرام البعيد وقال ابن الرومي : ودونكها من شاعر لك شاكروان حرك الخيم الكريم وحضضا وما ازداد فضل فيك بالمدح شهرةولكنه كالمسك صادف مخوضا  وقال ايضا : خذها اليك مشيحة سيارةفي الناس من باد ومن متحضر تغدو عليك بحاصب وبتاربوعلي الرواة بلءلء متخير وقال : خذها تبوعا لمن ولي مسومةكانها كوكب في اثر عفريت وقال دعبل وذكر التفاوت ما بين المجيد والمسء : يموت ردء الشعر من قبل اهلهوجيده يبقي وان مات قاءله اخذ السري الرفاء هذا المعني فقال : فتعيش بعد مماته اشعارهويموت قبل مماتها اشعارها وقال الصاحب ابن عباد : اتتني بالامس اشعارهتعلل روحي بروح الجنان كبرد الشباب وبرد الشرابوظل الامان ونيل الاماني وعهد الصبا ونسيم الصباوصفو الدنان ورجع القيان فلو ان الفاظها جسمتلكانت عقود نحور الغواني  وقال القاضي ابو القاسم التنوخي : وقصيدة الفاظهافي النظم كالدر النثير جاءت الي كانها الت . . . وفيق في كل الامور بارق من شكوي واح . . . سن من حياة في سرور فكانها امل تحق . . . قق بعد ياس في الصدور او كالمنام لساهراو كالامان لمستجير وكانما هي من شبا . . . ب او وصال او نشور من كل معني كالسلا . . . مة او كتيسير العسير وقال يزيد بن مفرغ : يغسل الماء ما صنعت وشعريراسخ منك في العظام البوالي وقال ابو تمام : يود ودادا ان اعضاء جسمهاذا انشدت شوقا اليه مسامع وقال المتنبي : اذا ما صافح الاسماع يوماتبسمت الضماءر والقلوب قيل لمعتوه : ما اجود الشعر ؟ قال : ما دل صدره علي عجزه ، ولا يحجبه شء دون بلوغه .  وقال الكندي :  تقصر عن مداها الريح جرياوتعجز عن مواقعها السهام تناهب حسنها حاد وشادفحث بها المطايا والمدام وصف الكتاب والقلم وما يجانسهما قال ابو تمام الطاءي : لك القلم الاعلي الذي بشباتهتصاب من الامر الكلي والمفاصل لعاب المنايا القاتلات لعابهواري الجني اشتارته ايد عواسل له ريقة طل ولكن وقعهاباثاره في الشرق والغرب وابل فصيح اذا استنطقته وهو راكبواعجم ان خاطبته وهو راجل اذا ما امتطي الخمس اللطاف وافرغتعليه شعاب الفكر وهي حوافل اطاعته اطراف الرماح وقوضتلنجواه تقويض الخيام الجحافل اذا استغزر الذهن الجلي واقبلتاعاليه في القرطاس وهي اسافل وقد رفدته الخنصران وسددتثلاث نواحيه الثلاث الانامل رايت جليلا شانه وهو مرهفضني وجسيما خطبه وهو ناحل وقال ابن الرومي : لعمرك ما السيف سيف الكميباخوف من قلم الكاتب  له شاهد ان تاملتهظهرت علي سره الغاءب سنان المنية في جانبوسيف المنية في جانب وقال السري الرفاء : لك القلم الذي يضحي ويمسيبه الاقليم محمي الحريم هو الصل الذي لو عض صلالاسلمه الي ليل السليم وقال العتابي : الاقلام مطايا الفطن . وقال سهل بن هارون : القلم لسان الضمير ، اذا رعف اعلن سراره وانار اثاره . قال علي بن عبيدة فيه : اصم يسمع النجوي ويخبر بالغاءب . وقيل : الخط هندسة روحانية ، وان ظهرت بالة جسدانية . وقيل : فضل الخط علي اللفظ ان الخط للقريب والبعيد ، واللفظ للقريب فقط . وقال جالنيوس : الخط كلام ميت ، واللفظ كلام حي . ولو تمم المعني لقال : الخط كلام ميت وحي . وقيل : الدواة منهل ، والقلم ماتح ، والكتاب عطن .  وقال اخر : خطه روضة والفاظه الاز . . . هار يضحكن والمعاني الثمار وقال اخر : مكررة الفاظنا في فصولهفان نحن اتممنا قراءته عدنا اذا ما نشرناه فكالمسك نشرهونطويه لا طي السامة بل ضنا وقال الصابء : فخاتم كامن في بطن راحتهاوفي اناملها سحبان مستتر وقال اخر : وادي خطابا في سطور كانهامخانق در في نحور الكواعب وقال التنوخي : خط وقرطاس كان . . . نهما السوالف والشعور وكانه ليل يمو . . . ج خلاله صبح منير وبداءع تدع القلو . . . ب تكاد من طرب تطير في كل معني كالغنييحويه محتاج فقير او كالفكاك ينالهمن بعد ما ياس اسير وكانما الاقبال جا . . . ء او الشفاء او النشور وكانه شرخ الشبا . . . ب وعيشه الغض النضير وله من ابيات ذكر فيها قصيدة ثم ذكر فيها الخط :  وكانه اذ لاح منفوق المهارق والسطور ورد الخدود اذا انتقل . . . ت به علي راح الثغور كتبت بحبر كالنوياو كفر نعمي من كفور في مثل ايام التوا . . . صل او كاعتاب الدهور وقال علي بن الجهم : يا رقعة جاءتك مثنيةكانها خد علي خد نبذ سواد في بياض كماذر فتيت المسك في الورد ساهمة الاسطر مصروفةمن نبذ الهزل الي الجد يا كاتبا اسلمني عتبهاليه حسبي منك ما عندي وقال اخر : سواد مثل خافية الغرابواقلام كمرهفة الحراب وقرطاس كرقراق السرابوالفاظه كايام الشباب وقال ابن المعتز : قلم ما اراه ام فلك يج . . . ري بما شاء قاسم ويسير راكع ساجد يقبل قرطا . . . سا كما قبل البساط شكور  وقال ايضا : اذا اخذ القرطاس خلت يمينهتفتح نورا او تنظم جوهرا قال الجاحظ في وصف كتاب : لا اعلم جارا ابر ، ولا خليطا انصف ، ولا رفيقا اطوع ، ولا معلما اخضع ، ولا صاحبا اظهر كفاية ولا اقل خيانة ، ولا ابدي نفعا ، ولا اقل ابراما واملالا ، ولا احمد اخلاقا ، ولا اقل خلافا ، ولا اتم سرورا ، ولا اقل غيبة ، ولا اكثر اعجوبة ، ولا ابعد مراء ، ولا ازهد في جدال ، ولا اكف عن قتال ، ولا امن علي كشف الاسرار والاطلاع علي شكوي ذات النفس ، من كتاب . ونظر المامون الي ابنه الفضل وهو ينظر في كتاب فقال له : ما هذا يا بني ؟ قال : يا امير المءمنين هذا بعض ما يشحذ الفطنة ، ويءنس من الوحدة ، فقال : الحمد لله الذي رزقني من ولدي من يري بعين عقله اكثر مما يري بعين جسمه . وقال ابن الرومي : حبر ابي حفص لعاب الليلكانه الوان دهم الخيل يجري الي الاخوان جري السيلبغير وزن وبغير كيل كانه من نهر الرفيل ووصف عبد الله بن المعتز الكتاب فقال : هو والج الابواب ،  جرء علي الحجاب ، مفهم لا يفهم ، وناطق لا يتكلم . وقال الرياشي ، قال الاصمعي : الا ادلك علي بستان يكون في كمك ، وروضة تكون في حجرك ، وميت ينطق ، واخرس يتكلم ، يحدثك اذا شءت ، ويقطع عنك اذا سءمت ؟ قلت : بلي ، قال : عليك بكتابك . سءل بعض الكتاب : متي يستحق الخط ان يوصف بالجودة ؟ قال : اذا اعتدلت اقسامه ، وطالت الفه ولامه ، واستقامت سطوره ، وضاهي صعوده حدوره ، وتفتحت عيونه ، ولم يشتبه واوه ونونه ، واشرق قرطاسه ، واظلمت انفاسه ، ولم تختلف اجناسه ، واسرع الي العيون تصوره ، والي القلوب تميزه ، واندمجت فصوله ، وتناسب دقيقه وجليله ، وخرج عن نمط الوراقين ، وبعد عن تصنع المحررين ، وقام لكاتبه مقام النسبة والحلية ، وكان حينءذ كما قيل : اذا ما تجلل قرطاسهوساوره القلم الارقش تضمن من خطه حلةكنقش الدنانير او انقش حروف تعيد لعين الكليلنشاطا ويقراها الاخفش نعت النار والحر وما يتعلق بهما ويتبعهما قال جران العود : ونار كسحر العود يرفع ضوءهامع الليل هبات الرياح الصوارد وقال جميل :  رايت واصحابي بايلة موهناوقد غار نجم الفرقد المتصوب لبثنة نارا ما تبوخ كانهااذا ما رمقناها مع البعد كوكب وقال اخر : ويوم كان المصطلين بحرهوان لم يكن جمر قيام علي الجمر صبرت له حتي تجلي وانماتفرج ايام الكريهة بالصبر وقال اخر : بحر لو ان اللحم يصلي بحرهغريضا اتي اصحابه وهو منضج وقال مسكين الدارمي : وهاجرة ظلت كان ظباءهااذا ما اتقتها بالقرون سجود تلوذ بشءبوب من الشمس فوقهاكما لاذ من حر السنان طريد ومن كلام لابي الفضل ابن العميد : وممتحن بهواجر يكاد اوارها يذيب دماغ الضب ، ويصرف وجه الحرباء عن التحنف ويزويه عن التنصر ، ويقبضه عن امساك ساق وارسال ساق : ويترك الجاب في شغل عن الحقبويقدح النار بين الجلد والعصب ويغادر الوحش قد مالت هواديها :  سجودا لدي الارطي كان رءوسهاعلاها صداع او فواق يصورها وكما قال الفرزدق : بيوم اتت دون الظلال شموسهفظل المها صورا جماجمها تغلي قال الاصمعي : سمعت اعرابيا يعاتب اخاه ويقول : اما والله لرب يوم كتنور الطهاة رقاص باكمامه ، قد رميت بنفسي في اجيج سمومه ، اتحمل منه ما تكره لما تحب . سمع الحارث بن عبد الله بن ابي ربيعة قول اخيه عمر : ويوم كتنور الطواهي سجرنهوالقين فيه الجمر حتي تضرما قذفت بنفسي في اجيج سمومهوبالعنس حتي ابتل مشفرها دما فقال : الله اكبر اخذت في فن اخر ، فلما سمع : اءمل ان القي من الناس عالماباخباركم او ان الم مسلما قال : انك لفي ضلالك القديم . وقال الصابي يصف الشمعة : ولا دليل سوي هيفاء مخطفةتهدي الركاب وجنح الليل معتكر غصن من الذهب الابريز اثمر فياعلاه ياقوتة صفراء تستعر  ياتيك ليلا كما ياتي المريب فانلاح الصباح طواه دونك الحذر وقال السري الرفاء فيها : فلما دجا الليل فرجتهبروح تحيف جثمانها غصون من التبر قد ازهرتلهيبا يزين افنانها فيا حسن ارواحها في الدجيوقد اكلت فيه ابدانها وقال فيها ابو اسماعيل الكاتب منشء السلطان محمد بن ملكشاه : ومساعد لي بالبكاء مءانسبالليل يءنسني بطيب لقاءه هامي المدامع او يصاب بعينهحامي الاضالع او يموت بداءه ساويته في لونه ونحولهوفضلته في بءسه وشقاءه هب انه مثلي بحرقة قلبهوسهاده طول الدجي وعناءه افوادع طول النهار مرفةكمعذب بصباحه ومساءه وقال الصاحب : وراءق القد مستحبيجمع اوصاف كل صب سهاد ليل ودمع عينولون جسم وحر قلب وقال كشاجم : اعددت لليل اذا الليل غسقاغصان تبر عريت من الورق  ثمارها مثل مصابيح الافقيغني الندامي ضوءها عن الفلق شفاءها ان مرضت ضرب العنق وقال الصنوبري فيها : مجدولة في قدهاحاكية قد الاسل كانها عمر الفتيوالنار فيها كالاجل وقال المتنبي فيها : قد شابهتني في لون وفي قضفوفي احتراق وفي دمع وفي سهر وقال سوار بن مضرب : وهاجرة تشتوي بالسمومجنادبها في رءوس الاكم اذا الموت اخطا حرباءهارمي راسه بالعمي والصمم نعت البرد والصلاء قال مرة بن محكان : في ليلة من جمادي ذات انديةلا يبصر الكلب من ظلماءها الطنبا لا ينبح الكلب فيها غير واحدةحتي يلف علي خيشومه الذنبا وقالت اخت عمرو ذي الكلب :  وليلة يصطلي بالفرث جازرهايختص بالنقري المثرين داعيها لا ينبح الكلب فيها غير واحدةحتي الصباح ولا تسري افاعيها وقال اخر الشنفري : وليلة قر يصطلي القوس ربهاواقدحه اللاتي بها يتنبل وقال كشاجم يصف الثلج : راحت به الارض الفضاء كانهامن كل ناحية بثغرك تضحك ويقال : برد الربيع مونق ، وبرد الخريف موبق . وقال القاضي ابو القاسم التنوخي : فانهض بنار الي فحم كانهمافي العين ظلم وانصاف قد اتفقا جاءت ونحن كقلب الصب حين سلابردا فصرنا كقلب الصب اذ عشقا وقال ابو بكر الخالدي يصف الكانون : ومقعد لا حراك ينهضهوهو علي اربع قد انتصبا مصفر محرق تنفسهتخاله العين عاشقا وصبا اذا نظمنا في جيده سبجاصيره بعد ساعة ذهبا وقال ابن حيان المغربي : كانما الفحم والرماد وماتفعله النار فيهما لهبا شيخ من الزنج شاب مفرقهعليه درع منسوجة ذهبا  وقال اخر : وفحم كايام الوصال فعاله ومنظره في العين يوم صدود كان لهيب النار بين خلالهبوارق لاحت في عماءم سود نعت الاكول والماكل انشد ثعلب : تري كل محلول الازار كانمايطين سطحا او يلقم ناصحا وقال البحتري : وكان الفتي يطم ركاياقد تهورن او يسد بثوقا معدة اولية كرحي البز . . . ر تلقي حبا وتلقي دقيقا وقال ابن المعتز : كان اكف القوم في جنباتهقطا لم ينفره عن الماء سارح وقال ابن الرومي : الا يلاقوك فتلقي بهماكل يتامي ما لهم كاسب من كل شحذان الحشا باءسياكل ما لا يحسب الحاسب فكاه كالعصرين من دهرهكلاهما في شانه داءب  كانما الفروج في كفهفريسة ضرغامها دارب وقال : يا عدو الزاد ياثع . . . بان موسي المتلقف وقال اخر : لم تر عيني اكلا مثلهياكل باليسري معا واليمين تلعب في القصعة اطرافهلعب اخي الشطرنج بالشاه بين وقال ابن الرومي : ما انس لا انس خبازا مررت بهيدحو الرقاقة وشك اللمح بالبصر ما بين رءيتها في كفه كرةوبين رءيتها قوراء كالقمر الا بمقدار ما تنداح داءرةفي صفحة الماء يرمي فيه بالحجر وقال ايضا يصف سمكا استهداه : وبنات دجلة في فناءكمماسورة في كل معترك بيض كامثال السباءك بلمشحونة بالشحم كالعكك تفري بامثال الدروع واح . . . يانا بمثل نوافذ الشكك تغني عن الزيات قاليهاوتبخر الشاوين بالودك حسنت مناظرها وساعدهاطعم كحل معاقد التكك وقال يستهدي لوزينجا :  لا يخطءني منك لوزينجاذا بدا اعجب او عجبا لم تغلق الشهوة ابوابهاالا ابت زلفاه ان يحجبا لو شاء ان يذهب في صخرةلسخر الطيب له مذهبا يدور بالنفخة في جامهدورا تري الدهن له لولبا عاون فيه منظر مخبرامستحسن ساعد مستعذبا كالحسن المحسن في شدوهتم فاضحي مضربا مطربا مستكثف الحشو ولكنهارق جلدا من نسيم الصبا كانما قدت جلابيبهمن اعين القطر اذا قببا يخال من رقة خرشاءهشارك في الاجنحة الجندبا لو انه صور في خبزهثغرا لكان الواضح الاشنبا وقال يصف دجاجة : وسميطة صفراء ديناريةثمنا ولونا زفها لك حزور عظمت فكادت ان تكون اوزةونزت فكاد اهابها يتفطر طفقت تجود بذوبها جوذابةفاتي لباب اللوز فيها السكر نعم السماء هناك ظل صبيبهايهمي ونعم الارض ظلت تمطر ظلنا نقشر جلدها عن لحمهافكان تبرا عن لجين يقشر وقال في الرءوس : ما ان علمنا من طعام حاضرنعتده لفجاءة الزوار  كمهيءين من المطاعم فيهماشبه من الابرار والفجار هام وارغفة وضاء ضخمةقد اخرجا من جاحم فوار كوجوه اهل الجنة ابتسمت لنامقرونة بوجوه اهل النار وقال كشاجم في مثله : وقد عزمنا علي مباكرة الشر . . . ب ولكن ما عندنا من طعام غير ما راج من رقاق هنءمع هام علي عداد الهام تلك كالماء ذي الحباب وهاتي . . . ك عليها كمثل طير سام يمتطين الخوان ارءس خرفا . . . ن وينزلن عنه بيض نعام وقال ابن الرومي يصف العنب : ورازقي مخطف الخصوركانه مخازن البلور قد ضمنت مسكا الي الشطوروفي الاعالي ماء ورد جوري لم يبق منه وهج الحرورالا ضياء في ظروف نور له مذاق العسل المشوروبرد مس الخصر المقرور ونفحة المسك مع الكافورورقة الماء علي النحور لو انه يبقي علي الدهورقرط اذان الحسان الحور وقال السري الرفاء ينعت حملا مشويا : انعته معصفر البردينابيض قاني حمرة الجنبين خلف شهرين علي الخلفينثم رعي بعدهما شهرين  فجسمه شبران في شبرينيا حسنة وهو صريع الحين بين ذراعين مفصلينكسارق حد من اليدين وطرف يستوقف الطرفينكمثل مراة من اللجين مذهبة المقبض والوجهينبكف شاو عطر الكفين شق حشاه عن شقيقتيناختين في القد شبيهتين كما قرنت بين كماتيناو كرتي مسك لطيفتين وقال الاعرج الخثعمي : طاب له ماكله ومشربهحديقة فيها ثمار تعجبه يكثر فيها موزه ورطبهيلقاه منها حين يجني اطيبه بعيد ما يجنيه منه اقربه نعت القدور قد اكثر الناس في وصفها وانما يكنون بذلك عن سعة القري وكمال المروءة . قال جحدر بن ربيعة العكلي : وقدر كجوف الليل انعمت غليهاتري الفيل فيها طافيا لم يفصل علي راسيات بينهن خصاصةثلاث كاثباج النعامات مثل ومن كل قوم يعرفون عيالهااذا الشول راحت كالحني المعطل وقال ابن احمر : ودهم تصاديها الولاءد جلةاذا جهلت اجوافها لم تحلم  تري كل هرجاب لجوج لهمةزفوف بشلو الناب هوجاء عيلم لها لغط جنح الظلام كانهعجارف غيث راءح متهزم وقال ربيع بن اصرم بن خارجة العنبري : وسمحاء تستوفي الجزور نصبتهافجاءت كاجلاد الحصان المقيد تفرغ في الشيزي الجماع كانهااذا مدت الايدي شريعة مورد وقال ابو ذءيب : وسود من الصيدان فيها مذاءبنضار اذا لم يستفدها نعارها الصيدان : جمع صيداء وهي البرم ، والمذانب : المغارف واحدتها مذنبة ، والنضار : الاثل . لهن نشيج بالنشيل كانهاضراءر حرمي تفاحش غارها اذا استعجلت بعد الهدو ترازمتكهزم الظءار جر عنها حوارها الظءار : جمع ظءر ، وهي العاطفة علي الفصيل . ورزمة الناقة : صوتها ، يقال : ارزمت ارزاما : اذا حنت .  وقال الفرزدق : وقد علم الجيران ان قدورناضوامن للارزاق والريح زفزف نري حولهن المعتفين كانهمعلي صنم في الجاهلية عكف وقال : بعثت له دهماء ليست بلقحةتدر اذا ما هب نحسا عقيمها كان المجال الغر في حجراتهاعذاري بدت لما اصيب حميمها مخصرة لا يجعل الستر دونهااذا المرضع الهوجاء جال بريمها وقال معن بن اوس : اذا ما امتطاها الموقدون رايتهالوشك قراها وهي بالجزل تشعل سمعت لها لغطا اذا ما تغطمطتكهدر الجمال رزما وهي تجفل وقال امية بن ابي الصلت : وقدوره بفناءهللضيف مترعة زواخر وكانهن بما شجي . . . ن وما حمين به ضراءر زبد وقرقره كقر . . . قرة الفحول اذا تخاطر يقال : خطر البعير بذنبه خطرا وخطرانا .  وقال النابغة الذبياني : له بفناء البيت سوداء ضخمةتلقم اوصال الجزور العراعر بقية قدر من قدور تورثتلال الجلاح كابرا بعد كابر يظل الاماء يبتدرن قديحهاكما ابتدرت كلب مياه قراقر وقال مسكين الدارمي : كان قدور قومي كل يومقباب الترك ملبسة الجلال كان الموقدين بها جمالطلاها الزفت والقطران طال بايديهم مغارف من حديداشبهها مقيرة الدوالي وقال ابن المعتز : والسيف راعي ابلي في المحلسلمها الي قدور تغلي مثل الليالي سامحت بهطلترقل فيها بالوقود الجزل ارقالها في السير تحت الرحل وقال ابن حيان المغربي : كان الاثافي حول كل معرسنزلناه غربان علي الارض جثم نعت الملاهي قال الحمدوني في العود : وناطق بلسان لا ضمير لهكانه فخذ نيطت الي قدم  يبدي ضمير سواه في الحديث كمايبدي ضمير سواه الخط بالقلم وقال السري الرفاء يصف الطبل : ومقيد الطرفين يض . . . رب عند تضييق القيود ولقد يلطم خذهفي حال ترفيه الخدود وكانما زاراتهيحسبن زارات الاسود انظر اليه مع المدا . . . م تري بروقا في رعود وقال اخر في راقص : اذا اختلس الخطي واهتز لينارايت لرقصه سحرا مبينا يمس الارض من قدميه وهمكرجع الطرف يخفي ان يبينا تري الحركات منه بلا سكونفتحسبها لخفتها سكونا كسير الشمس ليس بمستقروليس بممكن ان يستبينا نعت الشواذ التي يقل اهتمام الواصفين بها ويبعد تكررها . في وصف دعوة مظلوم : وسارية لم تسر بالليل تبتغيمحلا ولم يقصر لها القيد مانع تحل وراء الليل والليل ضارببجثمانه فيه سمير وهاجع اذا وردت لم يردد الله وفدهاعلي اهلها والله راء وسامع  تفتح ابواب السماوات دونهااذا قرع الابواب منهن قارع واني لارجو الله حتي كاننياري بجميع الظن ما الله صانع ذكرت العماءم عند ابي الاسود الدءلي فقال : هي جنة في الحرب ، ومكنة من الحر ، ومدفاة من القر ، ووقار في الندي ، وواقية من الاحداث ، وزيادة في القامة ، وهي بعد عادة من عادات العرب . وقال اخر يصف الحبس : نزلت باحصنها منزلاثقيلا علي عنق السالك ولست بضيف ولا في كريولا مستعير ولا مالك وليس بغصب ولا كالرهونولا شبه الوقف عن هالك ولي مسمعان فادناهمايغني ويسلك في الحالك واقصاهما ناظر في السما . . . ء عمدا واوسخ من عارك وروي عن يوسف عليه السلام انه كتب علي باب السجن : هذه منازل البلوي ، وقبور الاحياء ، وتجربة الاصدقاء ، وشماتة الاعداء . وقال اخر : قد اشهد اللهو بفتيان غررعلي جياد كتماثيل الصور كانما خيطوا عليها بالابراو سمر الفارس فيها فانسمر وقال اخر في مريض : امسي يجود بنفسه وكانهقمر تغشاه الدجي بكسوف  ومشي البلي في جسمه فكانهورد قطيف مءذن بجفوف وقال الصابء في عتيدة الطيب : وعتيدة للطيب ان تستدعهاتبعث اليك امامها ببشيرها يلقاك قبل عيانها ارج لهافكانه مستاذن لحضورها لا عيب فيها غير ان نسيمهامثل اللسان يشيع سر ضميرها وقال تميم بن ابي بن مقبل يصف القدح : غدا وهو مجدول فراح كانهمن الصك والتقليب في الكف افطح خروج من الغمي اذا صك صكةبدا والعيون المستكفة تلمح مفدي مءدي باليدين ملعنخليع لجام فاءز متمنح خليع لجام : مثل يريد القمار ، والخليع : الذي خلعه اهله وتبرءوا من جريرته . . . اي مستدير جوفه . اذا امتنحته من معد عصابةغدا ربه قبل المفيضين يقدح وقال اخر يذكر ماء في العين : يقولون ماء طيب خان عينهوما ماء عين خان عينا بطيب ولكنه ازمان انظر طيبابعيني قطامي علا فوق مرقب كان ابن حجل مد فضل جناحهعلي بانسانيهما المتغيب  وقال اخر في الحول : حمدت الهي اذ بلاني بحبهاعلي حول يغني عن النظر الشزر نظرت اليها والرقيب يظننينظرت اليه فاسترحت من العذر وقال اخر فيه : ونجمين في برجين هاد وجاءراذا طلعا حل الكسوف بواحد لهذا علي التقدير قوة زهرةوفي ذا التشبيه طرف عطارد اذا افل الهادي ووافاه برجهتراءي لنا المكسوف في زي قاصد من الانجم اللاءي جرت في بروجهاولم تدر ما معني نجوم الفراقد وقال ابو نواس في اعور : اعور المقلة من تحت دعجلو عداه عور العين سمج تحسب النكتة في ناظرهدرة بيضاء في فص سبج وقال اخر يصف طيب يومه : انت والله من الاي . . . ام لدن الطرفين كلما قلبت عيني . . . ي ففي قرة عين وقال اخر يذكر الدواليب : بكرت تحن وما بها وجديواحن من وجد الي نجد فدموعها تحيا الرياض بهاودموع عيني اقرحت خدي وقال الطرماح يصف الخوف : كان بلاد الله وهي عريضةعلي الخاءف المذعور كفة حابل  تءدي اليه ان كل ثنيةتيممها ترمي اليه بقاتل وقال الفرزدق : وخافوك حتي القوم تنزو قلوبهمكنزو القطا ضمت عليه الحباءل وقال الطرماح : وقد زادني حبا لنفسي اننيبغيض الي كل امرء غير طاءل اذا ما راني قطع الطرف بينهوبيني فعل العارف المتجاهل ملات عليه الارض حتي كانهامن الضيق في عينيه كفة حابل وقال اخر في محجمة : وخضراء لا من نبات الهديريلفف بالسيف منقارها كان مشق عيون القطااذا هن هومن اثارها وقال خلف بن خليفة في حجام : وكان سلاحك في جونةتعلق في سيرها ودعه سلاح امرء يدع الادميكان ورا اذنه هقعه وقال ابن نصر الكاتب في سمستجه : وانا اتنجز سءدده ، اباها طويلة كفضله ، عريضة كطوله ، نقية كعرضه ، دقيقة كفكره ، رقيقة كلفظه ، مفوفة كخطه ، مشوفة من شرطه ، قد زانها  باستعماله ، وصانها بابتذاله ، فتعطرت بذكاء انامله ، وقطرت من ماء محاسنه ، تذكر مواقع منحته ، وتحرك بشكر منته . ولمحدث فيها : يا رب مسعدة حليف صبابةوكابة لعب الغرام بلبه محمولة اما كواكف عبرةمن عينه او روعة من قلبه وقال اخر : يا ابن من يكتب في الار . . . قاب من غير دواة لم يكن يكتب فيهاغير خط الالفات وقال الطاءي يصف رداء خلعه عليه الحسن بن وهب : كالسراب الرقراق في النعت الاانه ليس مثله في الخداع وتراه تسترجف الريح متني . . . ه بامر من الهبوب مطاع رجفانا كانه الدهر منهكبد الصب او حشا المرتاع وقال كشاجم في البطيخ : وزاءر وقد تعطرااسر شهدا واذاع عنبرا ملتحفا للحر ثوبا اصفرامعمدا من الحرير اخضرا يظنه الناظر ان تبصرادب الدبا في متنه فاثرا وقال ابن الجهم :  وفوارة ثارها في السماءفليست تقصر عن ثارها ترد علي المزن ما انزلتعلي الارض من صوب امطارها وقال كشاجم : طلعة غضة اتتنا تحاكيسفطا فيه لءلء منظوم ما جواد من جاد بالمال لكن . . . ن المواسي هو الجواد الكريم وقال اخر في الرمان : ورمان رقيق القشر يحكيثدي الغيد في اثواب لاذ اذا قشرته طلعت علينانجوم من عقيق او بجاذي وقال ابو الحسن الجهرمي في المشمش : وهاجر دهرا يزور شهرازان وطاب مخبرا وخبرا مثل الجساد صبغة ونشراخالف ما اعلن ما اسرا جسما حلا يضم قلبا مراكما تضم الصدفات الدرا يكاد في الايدي يذوب قطرا ولكشاجم في كيزان الفقاع : دواء داء الثمل المخموررشف شراب شبم مقرور رق كدمع العاشق المهجورفي قعر كيزان من الصخور يدفع قضبانا من البلورفي نفس مثل جني الكافور  النوادر في هذا الباب قال الحمدوني : ما اري ان ذبحت شاة سعيدحاصلا في يدي غير الاهاب ليس الا عظامها لو تراهاقلت هذي ارزان في جراب وقال اخر : فان تمنعوا منا السلاح فعندناسلاح لنا لا يشتري بالدراهم جلاميد امثال الاكف كانهارءوس رجال حلقت في المواسم وقال ابو علي البصير يذكر بيتا : وليلة عارض لا نوم فيهاارقت بها الي الصبح الفتيق تفيض عيون جيرتنا علينااذا نظروا الي الغيم الرقيق تواصلت السحاءب وهو بيتواجلت وهو قارعة الطريق وقال ابن الحجاج في مثله : جوف بيت لم تبق منه اللياليغير رسم رث المعالم فاني منزل ما تقوم جدرانه الرث . . . ثة الا بقدرة الرحمن تتثني حيطانه من هبوب الر . . . يح فيه تثني الاغصان واذا دب عنكبوت علي السط . . . ح تداعت جوانب الحيطان وقال ابن سكرة يصف فرسا :  تعطيك مجهودها فراهتهافي السير والحضر عندها وتد وقال ابن الرومي يصف خادما : نمشة فوق صفرة فتراهكونيم الذباب في اللفاح وقال اخر : وهو مستهتر ببرشاء نمشا . . . ء كحب الشونيز في الشيراز وقال ابن الرومي : ولها كعثب كظلف غزالفيه صدع كانما هو خدش وقال المصيصي وذكر دينارا اعطاه ممدوح : قد لعب السقم بجثمانهفهو خيال واقف النفس كانه في الكف من خفةمقداره من صفرة الشمس وقال ابن الرومي : رايك في جبة مخرقةاطول اعمار مثلها يوم وطيلسان كالال تلبسهعلي قميص كانه غيم وقال ابن الحجاج : قال لي الغسال لماجءته قولا صحيحا مر حبيبي انا لا اغ . . . سل بالصابون ريحا  وللحمدوني في طيلسانه اوصاف مطبوعة فضل فيها غيره ، وجعله دابه كما انفرد راشد الكاتب بصفة عوده ، فمن ذلك قوله : ان ابن حرب جاد لي كاسيابطيلسان هرم قشعم انظر الي كثرة تمزيقهكانه مزق في ماتم يصدعه اللحظ بايماضهصدع فءاد العاشق المغرم تذكرني كثرة تمزيقهتفرق الناس عن الموسم وقال ايضا : وطيلسان ان توهمتهقددته بالطول والعرض كان اشفاقي عليه اذاعدوت اشفاقي علي عرضي لو انه بعض بني ادمكان اسير الله في الارض وقال ايضا : كانني من طول رفقي بهيملكني مذ صار في ملكي وقال ايضا : كان كفي اذا ضمتاعليه خوف الريح في غل وقال : يا ابن حرب اطلت فقري برفويطيلسانا قد كنت عنه غنيا  فهو في الرفو ال فرعون في العر . . . ض علي النار غدوة وعشيا وقال : كم رفوناه اذ تمزق حتيبقي الرفو وانقضي الطيلسان وقال : فيما كسانيه ابن حرب معتبرفانظر اليه فانه احدي الكبر قد كان ابيض ثم ما زلنا بهنرفوه حتي اسود من صدا الابر وقال : شكا ثقل اسم الطيلسان لضعفهفسميته ساجا فهل ذاك نافعي وقال ابن الرومي : كان وقع الاعجر المتينفي طيز ذات الكفل الرزين صوت يد العجان في العجينتواضعت لا للتقي والدين تحت فتي من قلبها مكينتواضع البطة الشاهين وقال اخر : انعت عيرا هو اير كلهحافره وراسه وظله انعظ حتي طار عنه جلهكان حمي خيبر تمله ادخاله عما وعام سله وقال اخر :  انعت ايرا من ايور الزطكانما قط علي مقط كانه صلعة شيخ ثط وقال راشد الكاتب : ينام علي كف الفتاة وتارةله حركات ما تحس بها الكف كما يرفع الفرخ ابن يومين راسهالي ابويه ثم يدركه الضعف تطوق فوق الخصيتين كانهرشاء علي ظهر الركية ملتف وقال : اير ضعيف المتن رخو القويلو شءت ان تعقده لانعقد ان يمس كالبقلة في لينهافطالما اصبح مثل الوتد وقال : وقد كنت تملا كف الفتاةفاصبحت تدخل في الخاتم وقال : كانه وهو مقع فوق خصيتهمسافر تحته خرجان من ادم وقال : اير تعقف واسترخت مفاصلهمثل العجوز حناها شدة الكبر تراه حين يريد البول منحنياكانه قوس نداف بلا وتر  وقال : كانه ويد الحسناء تلمسهسير الاداوة لما مسه البلل وقال : كان ايري من لين مقبضهخريطة قد خلت من الكتب كانه حية مطوقةقد جعلت راسها علي الذنب وقال اخر : ولقد غدوت بمشرف يافوخهعسر المكرة ماءه يتدفق ارن يسيل من النشاط لعابهويكاد جلد اهابه يتمزق وقال ابن المعتز : الا ربما انعظت حتي اخالهسينقد او ينعط او يتمزق فاغمده حتي اذا قلت قد ونيابي وتمطي جامحا يتمطق وقال بشار : وتراه بعد ثلاث عشرة قاءمامثل المءذن شك يوم سحاب وقال ايضا يصف فرج المراة وقيل فرج الرجل : وصاحب مطرق من طول صحبتهلا ينفع الدهر الا وهو محموم تاتيك في شدة الحمي منافعهفان افاق بدا في وجهه اللوم  وقال الفرزدق : فبتن بجانبي مصرعاتوبت افض اغلاق الختام كان مفالق الرمان فيهوجمر غضا قعدن عليه حامي وقال : يا رب خود من بنات الزنجتمشي بتنور شديد الوهج اخثم مثل القدح الخلنج وقال ايضا : ثم اتقتني بجهم لا سلاح لهكمنخر الثور محبوسا علي البقر كانه وجه تركيين قد غضبامستهدف لطعان غير منجحر وقال رجل من بني دارم : وانت رويبة قد تعلمينفضلت النساء بضيق وحر ويعجبني منك عند النكاححياة الكلام وموت النظر فقال الفرزدق : يا هذا لقد دللت فاحترس . وقال ابن النجم : كان تحت درعها المنعطوقد بدا منها الذي تغطي  شطا رميت فوقه بشطكهامة الشيخ اليماني الثط لم ينز في البطن ولم ينحطرابي المجس حسن المحط كانه قط علي مقطفيه شفاء من اذي التمطي الشط : شط السنام ، وكل سنام له شطان ، وناقة شطوطي : عظيمة السنام . وكان الناس يقدمون قول النابغة : واذا لمست لمست اخثم جاثمامتحيزا بمكانه ملء اليد وهي ابيات قد تقدم ذكرها  علي جميع ما قيل في معناه حتي قال بشار في ذلك : عجزاء من سر بني مالكلها حر من بطنها ارفع زين اعلاه باشرافهوانضم من اسفله المشرع وما انصف من عاد عن تقديم ابيات النابغة ، فلو لم يكن منها الا قوله منحيزا بمكانه لكفاه فصاحة وحلاوة ، ولكن الناس مولعون بالمحدث ، ولكل جديد لذة . وقال اعرابي : جاءت عروسا تفضل العراءساشكلا والفاظا ودلا خالسا ومركبا مثل الامير جالساجهم المحيا ينفج الملابسا يدخل مبلولا ويبدو يابسالا يفضل الاول منه السادسا وقال اخر :  فكشفت عن ابيض حبككانه قعب نضار مكي او جبنة من جبن بعلبكتسمع فيه الدلك بعد الدلك مثل صرير القتب المنفكاو حك صفار شديد الحك وقال سحيم : ابصرتها تميل كالوسنانمن الظباء الخرد الحسان تمشي بمثل القدح الجيشاني وقال اخر : يا رب خود من بنات الكركتمشي بجهم مثل وجه التركي وقال اخر : فقربت رحبا خبيث المفلقمني ينكه ناءك يبقبق بقبقة الجر بكف المستقي وقال المعذل بن غيلان : وركب كبيضة الادحيكان بيت الشعر المطلي عليه شونيز علي فرني وقال ابن الرومي في سوداء : لها حر تستعير وقدتهمن قلب صب وصدر ذي حنق  كانما حره لخابرهما اوقدت في حشاه من حرق يزداد ضيقا علي المراس كماتزداد ضيقا انشوطة الوهق ونظر سحيم الي امراة تضحك منه وهو يمضي ليقتل فقال : فان تضحكي مني فيا رب ليلةتركتك فيها القباء المفرج وجاءت امراة بزوجها الي المغيرة تستعديه عليه وتذكر انه عنين ، فقال الزوج : الله يعلم يا مغيرة اننيقد دستها دوس الحصان المرسل واخذتها اخذ المقصب شاتهعجلان يذبحها لقوم نزل فقال المغيرة : اني لا اري ذلك في شماءلك . وقال المءمل وذكر العجيزة : من راي مثل حبتيتشبه البدر اذ بدا تدخل اليوم ثم تد . . . خل اردافها غدا وقال ابن الرومي : ولحية كذنب البرذونلو انها كانت علي فرعون لاحتاج ان يحملها بعون  وقال ايضا : ان تطل لحية عليك وتعرضفالمخالي معروفة للحمير علق الله في عذاريك مخلا . . . ة ولكنها بغير شعير لو راي مثلها النبي لاجريفي لحي الناس سنة التقصير وقال اسحاق بن خلف : ما سرني انني في طول داودوانني علم في الباس والجود ماشيت داود فاستضحكت من عجبكانني والد يمشي بمولود ما طول داود الا طول لحيتهيظل داود فيها غير موجود تكنه خصلة منها اذا نفحتريح الشمال وجف الماء في العود ركب يزيد بن مفرغ الي جنب عباد بن زياد ، وكان عباد عظيم اللحية كانها جوالق فدخلت فيها الريح فنفشتها ، فضحك ابن مفرغ وقال لرجل من لخم كان الي جانبه : الا ليت اللحي كانت حشيشافنعلفها خيول المسلمينا دخل مخنث الحمام فراي رجلا كبير الذكر كثير الشعر فقال : انظروا الحليفة في القطيفة . قدم الي ابي العيناء قدر كثيرة العظام فقال : هذه قدر ام قبر ؟ ! راي رجل الهلال فاستحسنه فقال له الجماز : وما يستحسن منه ؟ ! فوالله ان فيه لخصالا لو كانت احداهن في الحمار لرد بها ، قال : وما هي ؟  قال : انه يدخل الروازن ، ويمنع من الدبيب ، ويدل علي اللصوص ، ويسخن الماء ، ويحرق الكتان ، ويورث الزكام ، ويحل الدين ، ويزهم اللحم . قيل لاعرابي : ما صفة الاير عندكم ؟ قال : عصبة ينفخ فيها الشيطان فلا ترد . سءل رقبة بن مصقلة عن مادبة حضرها فقال : اتينا بخوان كانه جوبة من الارض ، ورقاق كاذان الفيلة ، وجرجير كاذان المعزي ، تم اتينا بساكنة ماء كان ظهرها قرطاسي ، وبفالوذج رعديد كان الزنبق والجاذي ينبعان منه تري النفش من تحته . اتي رجل مكفوف نخاسا فقال : اطلب لي حمارا ليس بالصغير المحتقر ، ولا الكبير المشتهر ، ان خلا الطريق تدفق ، وان كثر الزحام ترفق ، لا يصادم السواري ، ولا يدخلني تحت البواري ، ان اقللت علفه صبر ، وان اكثرت شكر ، وان ركبته هام ، وان ركبه غيري نام ، فقال له النخاس : اصبر فان مسخ الله القاضي حمارا قضيت حاجتك . وقالت ام الورد بنت اوس العجلانية : هن لعمارة جهم منظرهيروق عيني كل خرق يبصره ظلت به لاهية تزعفرهمثل السنام طار عنه وبره كان حجاما شديدا ابهرهيمص ماء ظهره ويحدره كان رمانا يفت احمرهبعثره في جوفه مبعثره تم له منظره ومخبره  وقالت : بيضاء من مصايد الشيطانلها هن مستهدف الاركان اقمر تطليه بزعفراناخثم يملا راحة الانسان بجبهة كالقدح الجيشانيكان فيه فلق الرمان او لهبا من لهب النيرانرابي المجس مشرف المكان تراه عند الشم والتدانيمبرطما برطمة الغضبان بشفة ليست علي اسنانادرد معشوق من الدردان يزل عنه الفعل في الطعانكما يزل طرف السنان عن ترس مخشي من الفرسان راي عبادة دابة تحت مخارق يقرمط فقال : برذونك هذا يمشي علي استحياء . اخر باب الصفات والنعوت يتلوه باب الشيب وهو الباب الثامن والعشرون من كتاب التذكرة والحمد الله رب العالمين وصلواته علي سيدنا محمد واله الطاهرين وسلم تسليما كثيرا الي يوم الدين .
  الباب الثامن والعشرون في الشيب والخضاب صفحة فارغة بسم الله الرحمن الرحيم الحمد لله محيي الاموات ، وجامع الرفات ، مقدر الاجال ، ومقرب الامال ، خالق الموت والحياة ليبلو احسن الاعمال ، وجاعل الشيب نذيرا بالزوال ، نقل الانسان في عمره اطوارا ، وجعل حالتيه من قوة وضعف ذكري له واعتبارا ، فكان الشباب ليلا يغطي علي جهله واستتارا ، والشيب نهارا يستضء به ووقارا . احمده علي ما اسبغ من انعامه فغمر ، واساله توفيق من عمر فتذكر ، وان يعفو عما جنته سكرات الصبا وغراته ، وجرته حوادث الهوي ونزعاته ، وان ينبهنا لبوادر الشيب وفجاته ، ويوقظنا لنوازله وفجعاته ، ويلهمنا استعدادا يقضي بحسن الخاتمة ، ويفضي الي كرم رحمته الواسعة ، وصلواته علي محمد سيد البشر ، المكرم بالشفاعة في المحشر ، الذي سبقت بمبعثه النذر والايات ، ودلت عليه قبل وجوده المعجزات ، وامتدت الاعناق وهو في المهد لنبوته ، وبشر شيبة الحمد انه من ولده وذريته ، وعلي اله الاكرمين وصحابته . الباب الثامن والعشرون باب الشيب ويشتمل علي خمسة فصول :   الفجيعة بالشيب وحلوله .   الرضي به والتسلي عن نزوله .   الخضاب .   اخبار المعمرين .   النوادر .
  الفصل الاول الفجيعة بالشيب وحلوله
 يقال : ان اول من شاب ابراهيم الخليل عليه السلام ليتميز به عن اسحاق فانه كان شديد الشبه به ، فلما وخطه الشيب قال : يا رب ما هذا ؟ قال : هو الوقار ، قال : يا رب زدني وقارا ، ولم يكن احد راي الشيب قبله . والشيب راءد الموت ، قال الله عز وجل : ' اولم نعمركم ما يتذكر فيه من تذكر وجاءكم النذير ' . جاء في التفسير : انه الشيب . وقال النبي صلي الله عليه وسلم : لو لم يوكل بابن ادم الا الصحة والسلامة لاوشك ان يرداه الي ارذل العمر . وقال صلي الله عليه وسلم : كفي بالسلامة داء . وقال النمر بن تولب : من الطويل يسر الفتي طول السلامة جاهدا . . . فكيف تري طول السلامة يفعل ومثله لحميد بن ثور : من الطويل  اري بصري قد رابني بعد صحة . . . وحسبك داء ان تصح وتسلما وقال عبد الرحمن بن سويد المري : من الكامل كانت قناتي لا تلين لغامز . . . فالانها الاصباح والامساء ودعوت ربي بالسلامة جاهدا . . . ليصحني فاذا السلامة داء كعب بن زهير : من البسيط كل ابن انثي وان طالت سلامته . . . يوما علي الة حدباء محمول بعض المعمرين : من الكامل واذا رايت عجيبة فاصبر لها . . . فالدهر قد ياتي بما هو اعجب ولقد اراني والاسود تخافني . . . واخافني من بعد ذاك الثعلب قال ابن عباس : ما اتي الله عبده علما الا شابا ، والخير كله في الشباب ، ثم تلا قوله تعالي : ' قالوا سمعنا فتي يذكرهم يقال له ابراهيم ' وقوله عز وجل : ' انهم فتية امنوا بربهم وزدناهم هدي ' وقوله تعالي : ' واتيناه الحكم صبيا ' . وكان انس يقول : قبض رسول الله صلي الله عليه وسلم وفي راسه ولحيته عشرون شعرة بيضاء ، فقيل له : يا ابا حمزة وقد اسن ؟ فقال : لم يشنه الله تعالي بالشيب ، فقيل : او شين هو ؟ قال : كلكم يكرهه . قال بعض الزهاد : الشيب للجاهل نذير ، وللعاقل بشير .  وقال اخر : الشيب تبسم المنايا . كان عيسي عليه السلام اذا مر علي الشباب قال لهم : كم من زرع لم يدرك الحصاد ، واذا مر علي الشيوخ قال : ما ينتظر بالزرع اذا ادرك الا ان يحصد . وقال مسروق : اذا بلغ احدكم اربعين سنة فلياخذ حذره من الله . انس رفعه : من اتي عليه اربعون سنة ولم يغلب خيره شره فليتجهز الي النار . محمد بن علي بن الحسي عليهما السلام : اذا بلغ الرجل اربعين سنة نادي مناد من السماء : دنا الرحيل فاتخذ زادا . قال النخعي : كانوا يطلبون الدنيا فاذا بلغوا الاربعين طلبوا الاخرة . وقال الشعبي : الشيب علة لا يعاد عنها ، ومصيبة لا يعزي عليها . وقال عمرو بن قميءة : من الطويل كاني وقد جاوزت تسعين حجة . . . خلعت بها عني عذار لجامي علي الراحتين مرة وعلي العصا . . . انوء ثلاثا بعدهن قيامي رمتني بنات الدهر من حيث لا اري . . . فكيف بمن يرمي وليس برام فلو انها نبل اذا لاتقيتها . . . ولكنني ارمي بغير سهام اذا ما راني الناس قالوا الم يكن . . . حديثا حديد الطرف غير كهام وافني وما افني من الدهر ليلة . . . ولم يغن ما افنيت سلك نظام  واهلكني تاميل يوم وليلة . . . وتاميل عام بعد ذاك وعام وانشد الفراء : من الوافر حنتتي حانيات الدهر حتي . . . كاني حابل يدنو لصيد قصير الخطو يحسب من راني . . . ولست مقيدا اني بقيد الاخطل : من البسيط وقد لبست لهذا الدهر اعصره . . . حتي تجلل راسي الشيب واشتعلا فبان مني شبابي بعد لذته . . . كانما كان ضيفا طارقا نزلا وبينما المرء مغبوط بعيشته . . . اذ خانه الدهر عما كان فانتقلا وقال ايضا : من البسيط اعرضن عن شمط في الراس لاح به . . . منهن منه اذا ابصرنني حيد يا قل خير الغواني كيف رعن به . . . فشربه وشل منهن تصريد قد كن يعهدن مني منظرا حسنا . . . ومفرقا حسرت عنه العناقيد ان الشباب لمحمود لذاذته . . . والشيب منصرف عنه ومصدود  وقال بعض العرب ، بل هي للتيمي : من الطويل اذا كانت السبعون سنك لم يكن . . . لداءك الا ان تموت طبيب وان امرءا قد عاش سبعين حجة . . . الي منهل من ورده لقريب اذا ما مضي القرن انت فيهم . . . وخلفت في قرن فانت غريب راي اياس بن قتادة العبشمي شيبة في لحيته فقال : اري الموت يطلبني واراني لا افوته ، اعوذ بك من فجات الامور ، يا بني سعد قد وهبت لكم شبابي فهبوا لي شيبي ، ولزم بيته ، فقال اهله : تموت هزلا ، قال : لان اموت مهزولا مءمنا احب الي من ان اموت منافقا سمينا . وقال غسان خال الفرار : من الكامل ابيض مني الراس بعد سواد . . . ودعا المشيب حليلتي لبعاد واستحصد القرن الذي انا منهم . . . وكفي بذاك علامة لحصاد وقال نافع بن لقيط الفقعسي : من الكامل فلءن بليت لقد عمرت كانني . . . غصن تثنيه الرياح رطيب وكذاك حقا من يعمر يبله . . . كر الزمان عليه والتقليب حتي يعود من البلي وكانه . . . في الكف افوق ناصل معصوب مرط القذاذ فليس فيه مصنع . . . لا الريش ينفعه ولا التعقيب  وقال النابغة الجعدي : من المتقارب وما البغي الا علي اهله . . . وما الناس الا كهذي الشجر تري المرء في عنفوان الشباب . . . يهتز في بهجات خضر زمانا من الدهر ثم التوي . . . وعاد الي صفرة فانكسر وقال اخر : من الرجز من عاش دهرا فسياتيه الاجل . . . والمرء تواق الي ما لم ينل والمرء يبلوه ويلهيه الامل وقال لبيد : من الطويل وما المرء الا كالشهاب وضوءه . . . يحور رمادا بعد اذ هو ساطع نظر ابن الرومي الي المعني فقال : من الطويل محار الفتي شيخوخة او منية . . . ومرجوع وهاج المصابيح رمدد اخر : من الطويل لعمري لءن حلءت عن منهل الصبا . . . لقد كنت ورادا لمشربه العذب ليالي اغدو بين بردي لاهيا . . . اميس كغصن البانة الناعم الرطب سلام علي سير القلاص مع الركب . . . ووصل الغواني والمدامة والشرب سلام امرء لم تبق منه بقية . . . سوي نظر العينين او شهوة القلب  ابن مقبل : من البسيط يا حر ان سواد الراس خالطه . . . شيب القذال اختلاط الصفو بالكدر يا حر من يعتذر من ان يلم به . . . ريب الزمان فاني غير معتذر وقال منصور التمري : من البسيط ما تنقضي حسرة مني ولا جزع . . . اذا ذكرت شبابا ليس يرتجع بان الشباب وفاتتني بشرته . . . صروف دهر وايام لها خدع وما كنت اوفي شبابي كنه غرته . . . حتي انقضي فاذا الدنيا له تبع ابكي شبابا رزيناه وكان ولا . . . توفي بقيمته الدنيا ولا تسع ما واجه الشيب من عين وان ومقت . . . الا لها نبوة عنه ومرتدع محمد بن خازم : من البسيط لا تكذبن فما الدنيا باجمعها . . . من الشباب بيوم واحد بدل كفال بالشيب ذنبا عند غايته . . . وبالشباب شفيعا ايها الرجل وقال اسحاق بن ابراهيم الموصلي : من الطويل اذا المرء قاسي الدهر وابيض راسه . . . وثلم تثليم الاناء جوانبه فليس له في العيش خير وان بكي . . . علي العيش او رجي الذي هو كاذبه  وقال ابو دلف العجلي : من البسيط في كل يوم اري بيضاء قد طلعت . . . كانما نبتت في ناظر البصر لءن قصصتك بالمقراض عن بصري . . . لما قصصتك عن همي ولا فكري وقال يحيي بن خالد بن برمك : من الكامل الليل شيب والنهار كلاهما . . . راسي بكثرة ما تدور رحاهما الشيب احدي الميتتين تقدمت . . . اولاهما وتاخرت اخراهما ابو تمام : من الطويل غدا الشيب مختطا بفودي خطة . . . طريق الردي منها الي النفس مهيع هو الزور يجفي والمعاشر يجتوي . . . وذو الالف يقلي والجديد يرقع له منظر في العين ابيض ناصع . . . ولكنه في القلب اسود اسفع ونحن نرجيه علي الكره والرضي . . . وانف الفتي من وجهه وهو اجدع وقال : من الخفيف لو راي الله ان في الشيب فضلا . . . جاورته الابرار في الخلد شيبا وقال : من الخفيف  شاب راسي وما رايت مشيب الر . . . اس الا من فضل شيب الفءاد وكذاك القلوب في كل بءس . . . ونعيم طلاءع الاجساد طال انكاري البياض وان عم . . . مرت شيءا انكرت لون السواد البحتري : من الطويل وكنت ارجي في الشباب شفاعة . . . فكيف لباغي حاجة بشفيعه مشيب كبث السر عي بحمله . . . محدثه او ضاق صدر مذيعه تلاحق حتي كاد ياتي بطيءه . . . بحث الليالي قبل اتي سريعه وقال : من البسيط جاوزت حد الشباب النضر ملتفتا . . . الي بنات الصبا يركضن في طلبي والشيب مهرب من جاري منيته . . . ولا نجاء له من ذلك الهرب والمرء لو كانت الشعري له وطنا . . . صبت عليه صروف الدهر من كثب وقال : من الخفيف خلياه وجدة اللهو ما دا . . . م رداء الشباب غضا جديدا ان ايامه من البيض بيض . . . ما راين المفارق السود سودا ابن الرومي : من الخفيف لو يدوم الشباب مدة عمري . . . لم تدم لي بشاشة الاوطار كل شء له تناه وحد . . . كل شء يجري الي مقدار  ابو العتاهية : من الوافر الا يا موت لم ار منك بدا . . . اتيت فما تحيف ولا تحابي كانك قد هجمت علي مشيبي . . . كما هجم المشيب علي شبابي دخل او الاسود الدءلي علي عبيد الله بن زياد وقد اسن ، فقال له عبيد الله يهزا به : يا ابا الاسود انك لجميل فلو علقت تميمة ، فقال ابو الاسود : من البسيط افني الشباب الذي افنيت جدته . . . كر الجديدين من ات ومنطلق لم يتركا لي في طول اختلافهما . . . شيءا اخاف عليه لذعة الحدق قيل لشيخ : ما صنع الدهر بك ؟ فقال : فقدت المطعم وكان المنعم ، واجمت النساء وكن الشفاء ، فنومي سبات ، وسمعي خفات ، وعقلي تارات . وسءل اخر فقال : ضعضع قناتي ، واوهن شهواتي ، وجرا علي عداتي . ابن الرومي : من الطويل كفي بسراج الشيب في الراس هاديا . . . الي من اضلته المنايا لياليا امن بعد ابداء المشيب مقاتلي . . . لرامي المنايا تحسبيني ناجيا وكان كرامي الليل يرمي ولا يري . . . فلما اضاء الشيب شخصي رمانيا  عبد العزيز الطارقي المغربي : من الطويل  سقي الله ايام الصبا كل ريق . . . اذا جادها صوب البشاشة ارزما فلا زال يرتاد الزمان لرجعها . . . رقيب متي غمت عن اللحظ رجما فما هي الا بهجة العيش قوضت . . . هناك والا نور عيني اظلما ضرار بن عمرو ، وتروي للعتبي : من البسيط من عاش اخلقت الايام جدته . . . وخانه الثقتان السمع والبصر قالت عهدتك مجنونا فقلت لها . . . ان الشباب جنون برءه الكبر المخارق اليشكري : من الطويل وكنت اباهي الراءحين بلمتي . . . فاصبح باقي نبتها قد تقصبا فقد ذهبت الا شكيرا كانه . . . علي ناهض لم يبرح العش ازغبا ابو حية النميري : من الوافر ترحل بالشباب الشيب عنا . . . فليت الشيب كان به الرحيل وقد كان الشباب لنا خليلا . . . فقد قضي ماربه الخليل لعمر ابي الشباب لقد تولي . . . حميدا ما يراد به بديل اذ الايام مقبلة علينا . . . وظل اراكة الدنيا ظليل ابن الرومي : من الطويل اعر طرفك المراة فانظر فان نبا . . . بعينيك عنك الشيب فالبيض اعذر  اذا شنءت وجه الفتي عين نفسه . . . فعين سواه بالشناءة اجدر وقال العتبي : من الطويل راين الغواني الشيب لاح بمفرقي . . . فاعرضن عني بالخدود النواضر وكن اذا ابصرنني او سمعن بي . . . سعين فرقعن الكوي بالمحاجر فصرن اذا ابصرنني او سمعنني . . . نهضن فرقعن الكوي بالمعاجر الحماني : من الوافر لعمرك للمشيب اشد مما . . . فقدت من الشباب اشد فوتا تمليت الشباب فصار شيبا . . . وابليت المشيب فصار موتا ابو العتاهية : من الوافر عريت من الشباب وكان غضا . . . كما يعري من الورق القضيب فيا ليت الشباب يعود يوما . . . فاخبره بما فعل المشيب الحماني : من الكامل المجزوء واها لمنزلة وطيب . . . بين الاجارع والكثيب واها لايام الشبا . . . ب وعيشه الغض الرطيب واها لايام الشبا . . . ب بعدن عن عهد قريب ايام كنت من الغوا . . . ني في السواد من القلوب  لو يستطعن خبانني . . . بين المخانق والجيوب مزرد : الطويل فلا مرحبا بالشيب من وفد زاءر . . . متي يات لا تحجب عليه المداخل وسقيا لريعان الشباب فانه . . . اخو ثقة في الدهر اذ انا جاهل ابو نواس : الكامل المرفل كان الشباب مطية الجهل . . . ومحسن الضحكات والهزل كان الجميل اذا ارتديت به . . . ومشيت اخطر صيت النعل كان الفصيح اذا نطقت به . . . واصاخت الاذان للمملي كان المشفع في ماربه . . . عند الفتاة ومدرك التبل والباعثي والناس قد رقدوا . . . حتي ابيت خليفة البعل والامري حتي اذا عزفت . . . نفسي اعان يدي بالبخل فالان صرت الي مقاربة . . . وحططت عن ظهر الصبا رحلي 
  الفصل الثاني الرضي بالشيب والتسلي عن جدته
 جاء في الاثر ان الشيب وقار ، ومنه قول الشاعر : من الخفيف لا يرعك المشيب يا ابنة عبد ال . . . له فالشيب حلية ووقار انما تحسن الرياض اذا ما . . . ضحكت في خلالها الانوار وقال طريح بن اسماعيل الثقفي : من الكامل والشيب للحكماء من سفه الصبا . . . بدل تكون له الفضيلة مقنع والشيب غاية من تاخر حينه . . . لا يستطيع دفاعه من يجزع ان الشباب له لذاذة جدة . . . والشيب منه في المغبة انفع لا يبعد الله الشباب ومرحبا . . . بالشيب حين اري اليه المرجع وقال بشار ، ويروي لمسلم : من البسيط الشيب كره وكره ان يفارقني . . . اعجب بشء علي البغضاء مودود  يمضي الشباب وياتي بعده خلف . . . والشيب يذهب مفقودا بمفقود بعض العرب : من الطويل الا قالت الحسناء يوم لقيتها . . . كبرت ولم تجزع من الشيب مجزعا رات ذا عصا يمشي عليها وشيبة . . . تقنع منها راسه ما تقنعا فقلت لها لا تهزءي بي فقلما . . . يسود الفتي حتي يشيب ويصلعا وللقارح اليعبوب خير علالة . . . من الجذع المجري وابعد منزعا دعبل : من الكامل اهلا وسهلا بالمشيب فانه . . . سمة العفيف وحلية المتحرج وكان شيبي نظم در زاهر . . . في تاج ذي ملك اغر متوج والجيد في ذلك قول الاخر : من الكامل والشيب ان يحلل فان وراءه . . . عمرا يكون خلاله متنفس لم ينتقص مني المشيب قلامة . . . الان حين بدا الب واكيس ابو تمام : من البسيط فلا يءرقك ايماض القتير به . . . فان ذاك ابتسام الراي والادب وقد اعتذر البحتري للشيب وكرر ذلك في مواضع من شعره فقال :  من الخفيف : عيرتني المشيب وهي بدته . . . في عذاري بالصد والاجتناب لا تريه عارا فما هو بالشي . . . ب ولكنه جلاء الشباب وبياض البازي اصدق حسنا . . . ان تاملت من سواد الغراب وقال : من الخفيف ورات لمة الم بها الشي . . . ب فريعت من ظلمة في شروق ولعمري لولا الاقاحي لابصر . . . ت انيق الرياض غير انيق وسواد العيون لو لم يحسن . . . ببياض ما كان بالموموق ومزاج الصهباء بالماء املي . . . بصبوح مستحسن وغبوق اي ليل يبهي بغير نجوم . . . او سحاب يبدي بغير بروق وهذا من قول الاخر : من الطويل تفاريق شيب في الشباب لوامع . . . وما حسن ليل ليس فيه نجوم البحتري ايضا : من الخفيف طبت نفسا عن الشباب وما سو . . . ود من صبغ برده الفضفاض فهل الحادثات يا ابن عويف . . . تاركاتي ولبس هذا البياض وقال : من الطويل :  رات فلتات الشيب فابتسمت لها . . . وقالت نجوم لو طلعن باسعد اعاذل ما كان الشباب مقربي . . . اليك فالحي الشيب اذ كان مبعدي فاما ما ورد في الاثر من رافة الله عز وجل بالشيخ ، وما اعد له من صنوف الرحمة والعفو ، فتلك حال مقترنة بالطاعات ، ويوجبها التقلب في العبادات ، والا فهو كلما اسن في المعاصي كان ابعد له عن الله ، واناي مما امله ورجاه ، وليس هذا موضع ذكرها ، ولا يليق بايرادها ؛ وقد روي ان النبي صلي الله عليه وسلم : ان الله تعالي عز ذكره يقول : وعزتي وجلالي وفاقة خلقي الي اني لاستحي من عبدي وامتي يشيبان في الاسلام ان اعذبهما . ثم بكي ، فقيل له : ما يبكيك يا رسول الله ؟ فقال : ابكي ممن يستحي الله منه وهو لا يسحي من الله . وقال ابو الفرج حمد بن خلف الهذاني : من الطويل تعيرني وخط المشيب بعارضي . . . ولولا الحجول البيض لم تحسن الدهم حتي الدهر قوسي فاستمرت عزيمتي . . . ولولا انحناء القوس لم ينفذ السهم وقال النمر بن تولب : من الطويل فان تك اثوابي تمزق عن بلي . . . فاني كنصل السيف في خلق الغمد لبيد : من الطويل فاصبحت مثل السيف اخلق جفنه . . . تقادم عهد القين والنصل قاطع ومثله للعجير السلولي : من الطويل لقد اذنت بالهجر هيفاء ليتها . . . به اذنتنا والفءاد جميع واني وان واجهن شيءا كرهنه . . . لكالسيف يبلي الجفن وهو قطوع  المتنبي : من الطويل وشي بالمشيب الشيب عند الكواعب . . . فهن وان واصلن ميل الحواجب راين بياضا في سواد كانه . . . بياض العطايا في سواد المطالب هو الليل لا يزري عليه بان تري . . . جوانبه محفوفة بالكواكب بلغ ابو بكر هبة الله بن الحسن الشيرازي تسعين سنة ولم تبيض له شعرة فقل يتبرم بالشباب من قصيدة : من الوافر الام وفيم يظلمني شبابي . . . وتلبس لمتي حلك الغراب وامل شعرة بيضاء تبدو . . . بدو البدر من خلل السحاب وادعي الشيخ ممتلءا شبابا . . . كذي ظما يعلل بالشراب وكافور المشيب اجل عندي . . . وفي فودي من مسك الشباب واين من الصباح ظلام ليل . . . واين من الرباب دجي ضباب قال افلاطون : هرم النفس شباب العقل ؛ اخذ ذلك ابن المعتز ونظمه فقال : من المتقارب وما ينتقص من شباب الرجال . . . يزد في نهاها والبابها قال ابو مجيب الاعرابي ، وقد راي قوما يعذلون شابا : لا تعذلوه فقد رايتني وانا شاب اعض علي الملام عض الجموح علي اللجام ، حتي اخذ الشيب بعنان شبابي . روي عن النبي صلي الله عليه وسلم ا ، ه قال : الا انبءكم بخياركم ، قالوا : بلي يا  رسول الله ، قال : اطولكم اعمارا في الاسلام اذا سددوا . وقال الحسن : افضل الناس ثوابا يوم القيامة المءمن المعمر . راي حكيم طارء شيبة فقال : مرحبا بثمرة الحكمة ، وجني التجربة ، ولباس التقوي . وكان المامون يتمثل : من الطويل رات وضحا في الراس مني فراعها . . . فريقان مبيض به وبهيم تفاريق شيب في السواد لوامع . . . وما حسن ليل ليس فيه نجوم العكوك : من الكامل واري الليالي ما طوت من قوتي . . . ردته في عظتي وفي افهامي وعلمت ان المرء من سنن الردي . . . حيث الرمية من سهام الرامي عبد الله بن محمد الازدري المعروف بالعطار المغربي : الكامل سلني بوقعات الزمان فانما . . . هذا القتير غبار ذاك الموكب ولقد عذلت الدهر ثم عذرته . . . ورايت ظلما عذل من لم يذنب وحمدته لما علمت بانه . . . يسم المجرب بالعذار الاشيب وعجبت ان طلع المشيب بلمتي . . . فنكرته والليل ثوب الكوكب 
  الفصل الثالث ما جاء في الخضاب
 اول من خضب من اهل مكة بالسواد عبد المطلب بن هاشم ، خضبه بذلك ملك من ملوك حمير وزوده ، واقبل عبد المطلب من عنده ، فلما قرب من مكة اختضب ودخلها فقالت نثيلة بنت جناب بن كلب ام العباس بن عبد المطلب : يا شيبة الحمد ما احسن هذا الخضاب لو دام ، فقال لها عبد المطلب : من الطويل فلو دام هذا يا نثيل حمدته . . . ولكن بديل من شباب قد انصرم تمتعت منه والحياة قصيرة . . . ولا بد من موت نثيلة او هرم وما ذا الذي يجدي علي المرء خفضه . . . ونعمته يوما اذا عرشه انهدم فموت جهيز عاجل لا شوي له . . . احب الينا من مقالكم حطم وقد قال رسول الله صلي الله عليه وسلم : غيروا الشيب ولا تشبهوا باليهود . وكان جماعة من الصحابة رضوان الله عليهم يخضبون ، وسءل علي عليه السلام عن خبر النبي صلي الله عليه وسلم فقال : انما قال صلي الله عليه وسلم ذلك والدين قل ، فاما  الان وقد اتسع نطاقه وضرب بجرانه فامرو وما اختار . وقد احسن ابن الرومي في قوله : من الطويل اذا دام للمرء الشباب ولم تدم . . . غضارته ظن الشباب خضابا فكيف يظن المرء ان خضابه . . . يخال سوادا او يظن شبابا الخضاب بالسواد مكروه ، قال رسول الله صلي الله عليه وسلم : خير شبابكم من تشبه بشيوخكم ، وشر شيوخكم من تشبه بشبابكم ، ونهي عن الخضاب بالسواد وقال : هو خضاب اهل النار ، وفي لفظ اخر : الخضاب بالسواد خضاب الكفار ، والخضاب بالحمرة والصفرة جاءز تلبيسا للشيب علي الكفار في الغزو والجهاد . وقال صلي الله عليه وسلم : الصفرة خضاب المءمنين ، وكانوا يخضبون بالحناء للحمرة ، وبالخلوق والكتم للصفرة ، وخضب بعض العلماء بالسواد ، وذلك لا باس به اذا صحت النية ، ولم يكن فيه هوي وشهرة . قال محمود الوراق في انكار الخضاب : من مجزوء الكامل يا خاضب الشيب الذي . . . في كل ثالثة يعود ان النصول اذا بدا . . . فكانه شيب جديد فدع المشيب لما تري . . . د فلن يعود كما تريد ولابن المعتز يعتذر عن ذلك : من المتقارب  وقالوا النصول مشيب جديد . . . فقلت الخضاب شباب جديد اساءة هذا باحسان ذا . . . فان عاد هذا فهذا يعود وقال ابو الفرج حمد بن خلف الهمذاني : من الطويل وانكر جاراتي خضاب ذواءبي . . . وهن به سودن بيض الانامل فواعجبا منهن ينكرن باطلا . . . علي ولم يجلبن قلبي بباطل فسل مشيبي من خضابي كانما . . . تسل من الاغماد بيض المناصل وكنت متي ابدي النصول بياضها . . . رايت نصولا ركبت في مقاتلي حدث بعضهم قال : خرجت الي ناحية الطفاوة فاذا ا ، ا بامراة لم ار احسن منها فقلت : ايتها المراة ان كان لك زوج فبارك الله لك فيه ، والا فاعلميني ، قال فقالت : وما تصنع بي وفي شء لا اراك ترتضيه ، قلت : وما هو ؟ قالت : مشيب في رايب ، قال : فثنيت عنان دابتي راجعا ، فصاحت بي : علي رسلك اخبرك بشء ، فوقفت وقلت : ما هو يرحمك الله ؟ قالت : والله ما بلغت العشرين بعد وهذا راسي وكشفت عن عناقيد كالحمم وما رايت في راسي بياضا قط ، ولكن احببت ان تعلم انا نكره منكم ما تكرهون منا وانشدت : من الوافر اري شيب الرجال من الغواني . . . بموضع شيبهن من الرجال قال : فرجعت خجلا كاسف البال . قال الاصمعي : بلغني عن بعض العرب فصاحة ، فاتيته لاسمع من  كلامه ، فصادفته وهو يخضب ، فلما راني قال : ان الخضاب لمن مقدمات الضعف ، ولءن كنت قد ضعفت مشيت امام الجيوش ، وعدوت علي الوحوش ، ولهوت بالنساء ، واختلت في الرداء ، وارويت السيف ، وقريت الضيف ، وابيت العار ، وحميت الجار ، وغلبت القروم ، وعاركت الخصوم ، وشربت الراح ، ونادمت الجحجاح ، فاليوم قد حناني الكبر ، وضعف البصر ، وجاءني بعد الصفو الكدر ، ثم انشد : من البسيط شيب نعلله كيما ندلسه . . . كهيءة الثوب مطويا علي حرق قد كنت كالغصن ترتاح الرياح له . . . فصرت عودا بلا ماء ولا ورق صبرا علي الدهر ان الدهر ذو غير . . . واهله فيه بين الصفو والرنق يقال : ان اول من خضب بالسواد فرعون ؛ وتزوج رجل علي عهد عمر رضي الله عنه فكان يخضب بالسواد ، فنصل خضابه وظهرت شيبته ، فرفعه اهل المراة الي عمر فرد نكاحه واوجعه ضربا ، وقال غررت القوم بالشباب ، ولبست عليهم بشيبتك . سءل الحسن عن الخضاب فقال : هو جزع قبيح . قال اسماء بن خارجة لجاريته اخضبيني ، قالت : حتي متي ارقعك فقال : من البسيط عيرتني خلقا ابليت جدته . . . وهل رايت جديدا لم يعد خلقا المتنبي : من الطويل وما خضب الناس البياض لانه . . . قبيح ولكن احسن الشعر فاحمه مشب الذي يبكي الشباب مشيبه . . . فكيف توقيه وبانيه هادمه 
  الفصل الرابع اخبار المعمرين
 زعموا ان الربيع بن ضبع الفزاري كان من المعمرين ، وانه دخل علي بعض خلفاء بني امية فقال له : وابيك يا ربيع لقد طلبك جد غير عاثر ، ثم قال : فصل لي عمرك ، قال : عشت ماءتي سنة في الفترة ، فترة عيسي بن مريم ، وعشرين وماءة سنة في الجاهلية ، وستين في الاسلام ، فقال : اخبرني عن الفتية من قريش المتواطءي الاسماء ، قال : سل عن ايهم شءت ، قال : اخبرني عن عبد الله بن عباس ، قال : فهم وعلم وعطاء جذم ، ومقرء ضخم ، قال : فاخبرني عن عبد الله بن عمر ، قال : حل وعلم وطول كظم وبعد عن الظلم ، قال : فاخبرني عن عبد الله بن جعفر ، قال : ريحانة طيب ريحها ، لين مسها ، قليل علي المسلمين ضرها ، قال فاخبرني عن عبد الله بن الزبير ، قال : جبل وعر ينحدر منه الصخر ، قال : لله درك يا ربيع ما اخبرك بهم ! قال : يا امير المءمنين قرب جواري وكثر استخباري . اتي معاوية برجل من جرهم قد اتت عليه الدهور ، فقال له : اخبرني عما رايت في سالف عمرك ، قال : رايت مثل ما رايت ، رايت الدنيا ليلة في اثر ليلة ، ويوما في اثر يوم ، ورايت الناس بين جامع مالا مفرقا ، ومفرق مالا مجموعا ، وبين قوي يظلم ، وضعيف يظلم ، وصغير يكبر ، وكبير يهرم ، وحي يموت ، وجنين يولد ، وكلهم بين مسرور بموجود ، ومحزون بمفقود . والعرب لا تعد معمرا الا من بلغ ماءة وعشرين وسنة فصاعدا .  ومن المعمرين المستوغر بن ربيعة ، وهو عمر بن ربيعة بن كعب بن سعد بن زيد مناة بن تميم بن مر ، قيل انه ادرك الاسلام او كاد يدرك اوله ، ونسبه الي تميم ، وبقاءه الي الاسلام او قبله يدل علي طول بقاءه ، قيل انه عاش ثلاثماءة وعشرين سنة حتي قال : من الكامل ولقد سءمت من الحياة وطولها . . . وعمرت من عدد السنين مءينا ماءة اتت من بعدها ماءتان لي . . . وازددت من عدد الشهور سنينا هل ما بقي الا كما قد فاتنا . . . يوم يكر وليلة تحدونا وانما سمي المستوغر لبيت قاله وهو : من الوافر ينش الماء في الربلات منها . . . نشيش الرضف في اللبن الوغير الربلات : واحدها ربلة بفتح الباء واسكانها ، وهي لحمة غليظة ، والرضف : الحجارة المحماة ، والوغير : لبن تلقي فيه حجارة محماة ثم يشرب ، اخذ من وغيرة الظهيرة ، وهي اشد ما يكون من الحر ، ومنه وغر صدر فلان يغر وغرا اذا التهب من الغيظ من غضب او حقد . ومنهم دويد بن زيد بن نهد بن زيد بن اسلم بن الحاف بن قضاعة : قال ابو حاتم : عاش دويد بن زيد اربعماءة سنة وستا وخمسين سنة . وقال ابن دريد : لما حضرت دويد بن زيد الوفاة قال لبنيه : اوصيكم بالناس شرا ، لا ترحموا لهم عبرة ، ولا تقيلوا لهم عثرة ، قصروا الاعنة ، وطولوا الاسنة ،  واطعنوا شزرا ، واضربوا هبرا ، واذا اردتم المحاجزة فقبل المناجزة ؛ والمرء يعجز لا المحالة ، بالجد با بالكد ، التجلد ولا التبلد ، المنية ولا الدنية ، لا تاسوا علي فاءت وان عز فقده ، ولا تحنوا الي ظاعن وان الف قربه ، ولا تطمعوا ، ولا تهنوا فتجزعوا ، ولا يكون لكم المثل السوء ، ان الموصين بنو سهوان ، اذا مت فارحبوا حط مضجعي ولا تصبوا علي برحب الارض ، وما ذاك بمءد الي نفعا ، ولكن حاجة نفس خامرها الاشفاق . ثم مات ؛ وهو القاءل عند موته : من الرجز اليوم يبني لدويد بيته . . . يا رب نهب صالح حويته ورب قرن بطل ارديته . . . ومعصم مخضب ثنيته لو كان للدهر بلي ابليته ومن قوله ايضا : من الرجز القي علي الدهر رجلا ويدا . . . والدهر ما اصلح يوما افسدا يفسد ما اصلحه اليوم غدا قوله : الموصون بنو سهوان مثل ، اي لا تكونوا كمن تقدم اليهم فسهوا واعرضوا عن الوصية . ومن المعمرين عبيد بن شربة ، اتي عليه ماءتان وعشرون سنة ، ساله معاوية عمن راي من القرون ، فقال : ادركت الناس يقولون : ذهب الناس . وممن عمر عدي بن حاتم الطاءي ، ولما غلب المختار بن ابي عبيد علي الكوفة وقع بينهما ، فهم عدي بالخروج عليه ، ثم عجز لكبر سنه ، وكان قد بلغ ماءة وعشرين سنة وقال : من المنسرح  اصبحت لا انفع الصديق ولا . . . املك ضرا للشانء الشرس وان جري بي الجواد منطلقا . . . لم تملك الكف رجعة الفرس وعمر زهير بن ابي سلمي المزني ماءة وثماني سنين فقال : من الطويل بدا لي اني عشت تسعين حجة . . . خلعت بها عن منكبي رداءيا بدا لي اني لست مدرك ما مضي . . . ولا سابقا شيءا اذا كان جاءيا وما ان اري نفسي تقيها كريمتي . . . وما ان تقي نفسي كريمة ماليا وروي ان اكثم بن صيفي طال عمره فقال : من الطويل وان امرءا قد عاش تسعين حجة . . . الي ماءة لم يسام العيش جاهل مضت ماءتان غير ست واربع . . . وذلك من عد الليالي قلاءل وقيل ان رجلا من جرهم وفد علي معاوية بن ابي سفيان وقد اتت عليه ماءتان واربعون سنة ، فقال له معاوية : ممن الرجل ؟ قال : من جرهم ، قال : وهل بقي من جرهم باق ؟ ! قال : بقيت ولو لم ابق لم ترني ، فقال له معاوية : صف لي الدنيا واوجز ، قال : نعم سنيات رخاء وسنيات بلاء ، يولد مولود ويهلك هالك ، ولولا المولود لباد الخلق ، ولولا الهالك لضاقت الارض باهلها ، ثم انشا يقول : من الطويل وما الدهر الا صدر يوم وليلة . . . ويولد مولود ويفقد فاقد وساع لرزق يدرك رزقه . . . ومهدي اليه رزقه وهو قاعد  ومنهم زهير بن جناب بن هبل بن عبد الله بن كنانة بن بكر بن عوف بن عذرة بن زيد بن رفيدة بن ثور بن كلب بن وبرة بن تغلب بن حلوان ابن عمران بن الحاف بن قضاعة بن مالك ابن عمرو بن زيد بن مرة بن زيد بن مالك بن حمير . قال ابو حاتم : عاش زهير بن جناب ماءتي سنة وعشرين سنة ، واوقع ماءتي وقعة ، وكان سيدا مطاعا شريفا في قومه ، ويقال : كان فيه عشر خصال لم تجتمع في غيره من اهل زمانه ، كان سيد قومه وشريفهم وخطيبهم وشاعرهم وقاءدهم الي الملوك وطبيبهم ، والطب في ذلك الزمان شرف ، وحازي قزمه : اي كاهنهم ، وكان فارس قومه ، وله البيت فيهم والعدد منهم . واوصي بنيه فقال : يا بني اني قد كبرت سني ، وبلغت حرسا من دهري ، فاحكمتني التجارب والامور تجربة واختبار ، فاحفظوا عني ما اقول وعوا ، واياكم والخور عند المصاءب ، والتواكل عند النواءب ، فان ذلك داعية للغم وشماتة العدو وسوء الظن بالرب . واياكم ان تكونوا بالاحداث مغترين ، ولها امنين ، ومنها ساخرين ، فانه ما سخر قوم قط الا ابتلوا ، ولكن توقعوها ، فانما الانسان في الدنيا غرض تعاوره الرماة ، فمقصر دونه ومجاوز موضعه ، وواقع عن يمينه وشماله ، ثم لا بد انه مصيبه . وكان زهير بن جناب علي عهد كليب واءل ، ولم تجتمع قضاعة الا عليه وعلي رزاح بن ربيعة . وسمع زهير بعض نساءه تتكلم بما لا ينبغي ان تتكلم به امراة عند زوجها فنهاها ، فقالت : اسكت عني والا ضربتك بهذا العمود ، فوالله ما كنت اراك تسمع شيءا وتعقله فقال : من الطويل  الا يا لقومي لا اري النجم طالعا . . . ولا الشمس الا حاجتي بيميني معزبتي عند القفا بعمودها . . . يكون نكيري ان اقول ذريني امين علي سر النساء وربما . . . اكون علي الاسرار غير امين فللموت خير من حداج موطا . . . مع الظعن لا ياتي المحل لحين وهو القاءل : من الكامل المجزوء ابني ان اهلك فقد . . . اورثتكم مجدا بنيه وتركتكم ابناء سا . . . دات زنادكم وريه من كل ما نال الفتي . . . قد نلته الا التحيه فالموت خير للفتي . . . فليهلكن وبه بقيه من ان يري الشيخ البجا . . . ل وقد تهادي بالعشيه وقال ، وقد مضت له ماءتا سنة من عمره : من الوافر لقد عمرت حتي ما ابالي . . . احتفي في صباحي ام مساءي وحق لمن انت ماءتان عاما . . . عليه ان يمل من الثواء ومن المعمرين ذو الاصبع العدواني ، واسمه حرثان بن محرث بن الحارث بن ربيعة بن وهب بن ثعلبة بن ظرب بن عمرو بن عتاب بن يشكر بن عدوان ، وهو الحارث بن عمرو بن قيس بن عيلان بن مضر ، وانما سمي الحارث عدوان : لانه عدا علي اخيه فهم بقتله ، وقيل بل فقا عينيه ، وقيل ان اسم ذي الاصبع حرثان بن حويرث ، وقيل : ابن حرثان بن حارثة ، ويكني : ابا عدوان ، وسبب لقبه بذي الاصبع : ان حية نهسته علي اصبعه فشلت فسمي بذلك ، ويقال : انه عاش ماءة وتسعين سنة .  وقال ابو حاتم : عاش ثلاثماءة سنة . وهو احد حكام العرب في الجاهلية ، وروي انه كان اثرم ، وروي عنه : من الكامل المرفل لا يبعدن عصر الشباب ولا . . . لذاته ونباته النضر لولا اولءك ما حفلت متي . . . عوليت في حرجي الي قبري هزءت اثيلة ان رات هرمي . . . وان انحني لتقادم ظهري وخبر بناته اللواتي زوجهن مشهور يرد في موضعه . وهو القاءل : من الوافر اذا ما الدهر جر علي اناس . . . كلاكله اناخ باخرينا فقل للشامتين بنا افيقوا . . . سيلقي الشامتون كما لقينا ومن المعمرين معدي كرب من ال ذي رعين ، وهو القاءل وقد طال عمره : من الوافر اراني كلما افنيت يوما . . . اتاني بعده يوم جديد يعود ضياءه في كل فجر . . . ويابي من شبابي لا يعود ومن المعمرين ابو الطمحان القيني ، واسمه حنظلة بن الشرقي من بني كنانة بن القين . قال ابو حاتم : عاش ابو الطمحان القيني ماءتي سنة ، وقال في ذلك : من الوافر حنتني حانيات الدهر حتي . . . كاني خاتل يدنو لصيد قصير الخطو يحسب من راني . . . ولست مقيدا امشي بقيد  ومن المعمرين عبد المسيح بن بقيلة الغساني ، وبقيلة اسمه ثعلبة ، وقيل : الحارث ، وانما سمي بقيلة لانه خرج علي قومه في بردين اخضرين ، فقالوا له : ما انت الا بقيلة فسمي بذلك . وذكر ابن الكلبي وابو مخنف وغيرهما انه عاش ثلاثماءة وخمسين سنة ، وادرك الاسلام ولم يسلم ولم يسلم وكان نصرانيا . وروي ان خالد بن الوليد لما نزل الحيرة وتحصن اهلها منه ، ارسل اليهم : ابعثوا لي رجلا من عقلاءكم وذوي اسنانكم ، فبعثوا اليه عبد المسيح بن بقيلة ، فاقبل يمشي حتي دنا من خالد ، فقال : انعم صباحا ايها الشيخ ، قال : قد اغنانا الله عن تحيتك هذه ، فمن اين اقصي اثرك ايها الشيخ ؟ قال : من ظهر ابي ، قال : فمن اين خرجت ؟ قال : من بطن امي ، قال : فعلام انت ؟ قال : علي الارض ، قال : ففيم انت ؟ قال : في ثيابي ، قال : اتعقل لا عقلت ؟ قال : اي والله واقيد ، قال : ابن كم انت ؟ قال : ابن رجل واحد ، قال خالد : ما رايت كاليوم قط ، اني اساله عن الشء وينحو بي في غيره ، قال : ما انباتك الا عما سالت ، فسل ما بدا لك ، قال : اعرب انتم ام نبط ؟ قال : عرب استنبطنا ، ونبط استعربنا ، قال : فحرب انتم ام سلم ؟ قال : بل سلم ، قال فما هذه الحصون قال : بنيناها لسفيه نحذر منه حتي يجء الحليم ينهاه ، قال : كم اتي لك ؟ قال : خمسون وثلاثماءة سنة ، قال : فما ادركت ؟ قال : ادركت سفن البحر ترقي الينا في هذا الجرف ، ورايت المراة من اهل الحيرة مكتلها علي راسها ، لا تزود الا رغيفا واحدا حتي ترد الشام ، ثم قد اصبحت اليوم خرابا ، وذلك داب الله تعالي في العباد والبلاد . قال : وبيده سم ساعة يقلبه في كفه ، فقال له خالد : ما هذا في كفك ؟ قال : السم ، قال : وما تصنع به ؟ قال : ان كان عندك ان يوافق قومي واهل بلدي حمدت الله تعالي وقبلته ، وان كانت الاخري لم اكن اول من ساق اليهم ذلا ، اشربه واستريح من الحياة ، فان ما بقي من عمري ليسير ، قال خالد :  هاته ، فاخذه وقال : بسم الله وبالله رب الارض والسماء الذي لا يضر مع اسمه شء ثم اكله ، فتجللته غشية ثم ضرب بذقنه في صدره طويلا ، ثم عرق وافاق فكانما نشط من عقال ، فرجع ابن بقيلة الي قومه فقال : جءتكم من عند شيطان اكل سم ساعة فلم يضره ، صانعوا القوم واخرجوهم عنكم ، فان هذا امر مصنوع لهم ، فصالحوهم علي ماءة الف درهم . وقال عبد المسيح : لما بني بالحيرة قصره المعروف بقصر بني بقيلة : من الوافر لقد بنيت للحدثان حصنا . . . لو ان المرء تنفعه الحصون طويل الراس اقعس مشمخرا . . . لانواع الرياح به حنين وذكر ان بعض مشايخ اهل الحيرة خرج الي ظهرها فخط ديرا ، فلما حفر موضع الاساس وامعن في الاحتفار ، اصاب كهيءة البيت ، فدخله فاذا رجل علي سرير من زجاج ، وعند راسه كتابه : ا ، ا عبد المسيح بن بقيلة : من الوافر حلبت الدهر اشطره حياتي . . . ونلت من المني بلغ المزيد وكافحت الامور وكافحتني . . . ولم احفل بمعضلة كءود وكدت انال في الشرف الثريا . . . ولكن لا سبيل الي الخلود ومن المعمرين : النابغة الجعدي ، واسمه قيس بن عبد الله بن ربيعة ابن جعدة بن كعب بن ربيعة بن عامر بن صعصعة ، ويكني : ابا ليلي . وروي ابو حاتم السجستاني قال : كان النابغة الجعدي اسن من النابغة  الذبياني ، والدليل علي ذلك قوله : من الطويل تذكرت والذكري تهيج علي الهوي . . . ومن حاجة المحزون ان يتذكرا نداماي عند المنذر بن محرق . . . اري اليوم منهم ظاهر الارض مقفرا كهول وشبان كان وجوههم . . . دنانير مما شيف في ارض قيصرا فهذا يدل علي انه كان مع المنذر بن محرق ، والنابغة الذبياني كان مع النعمان بن المنذر بن محرق ، ويقال : ان النابغة غبر ثلاثين سنة لا يتكلم ، ثم تكلم بالشعر ، ومات وهو ابن ماءة وعشرين سنة . وروي عن هشام بن محمد الكلبي : انه عاش ماءة وثمانين سنة وروي ابن دريد عن ابي حاتم انه عاش ماءتي سنة ، ووفد النابغة علي عبد الله بن الزبير في خلافته ، وروي انه مات باصبهان ، وبها كان ديوانه ، ومن شعره : من الوافر ومن يك ساءلا عني فاني . . . من الفتيان ايام الخنان ايام الخنان : كانت للعرب قديمة ، هاج بها فيهم مرض من انوفهم وحلوقهم . وقال محمد بن حبيب : بل هي وقعة كانت لهم ، قال قاءل منهم وقد لقوا عدوهم خنوهم بالرماح : مضت ماءة لعام ولدت فيه . . . وعشر بعد ذاك وحجتان فابقي الدهر والايام مني . . . كما ابقي من السيف اليماني يفلل وهو ماثور جراز . . . اذا جمعت بقاءمه اليدان قيل : وعمر بعد ذلك طويلا ، ومن ذلك قوله : من الكامل المجزوء المرء يامل ان يعي . . . ش وطول عيش قد يضره تفني بشاشته ويب . . . قي بعد حلو العيش مره وتسوءه الايام حت . . . ي لا يري شيءا يسره  كم شامت بي ان هلك . . . ت وقاءل لله دره وتمثل المنصور بهذه الابيات عند موته . ومن شعره في المعني : من المتقارب لبست اناسا فافنيتهم . . . وافنيت بعد اناس اناسا ثلاثة اهلين افنيتهم . . . وكان الاله هو المستاسا ويروي ان النابغة كان يفتخر ويقول : اتيت النبي صلي الله عليه وسلم وانشدته : من الطويل بلغنا السماء مجدنا وجدودنا . . . وانا لنبغي فوق ذلك مظهرا فقال عليه السلام : اين المظهر يا ابا ليلي ؟ فقلت : الجنة يا رسول الله ، فقال عليه السلام : اجل ان شاء الله . وانشده القصيدة ، فقال صلي الله عليه وسلم : لا يفضض الله فاك ، وفي رواية اخري : لا يفضض فوك ، فيقال : انه لم يسقط من فمه سن ولا ضرس . ومن شعره في كبره : من الكامل شيخ كبير قد تخدد لحمه . . . افني ثلاث عماءم الوانا سوداء داجية وسحق مفوف . . . ودروس مخلقة تلوح هجانا ثم المنية بعد ذلك كله . . . وكانما يعني بذاك سوانا ويزعمون ان اماناة بن قيس بن الحارث بن شيبان بن العاتك ابن معاوية الكندي عاش ثلاثماءة وعشرين ، وفي ذلك يقول المثلم النخعي :  من الطويل الا ليتني عمرت يا ام خالد . . . كعمر اماناة بن قيس بن شيبان لقد عاش حتي قيل ليس بميت . . . وافني فءاما من كهول وشبان فحلت به من بعد حرس وحقبة . . . دويهية حلت بنصر بن دهمان ومنهم عمرو بن الحارث بن مضاض الجرهمي ، قال عبد العزيز بن عمران : خرج ابو سلمة بن عبد الاسد المخزومي قبل الاسلام في نفر من قريش يرديدون اليمن ، فاصابهم عطش شديد ببعض الطريق ، فامسوا علي الطريق ، فساروا جميعا فقال لهم ابو سلمة : اني اري ناقتي تنازعني شقا ، افلا ارسلها واتبعها ؟ قالوا : فافعل ، فارسل ناقته وتبعها فاصبحوا علي ماء وحاضر ، فاسقوا وسقوا ، فانهم لعلي ذلك اذا اقبل رجل فقال : من القوم ؟ فقالوا : من قريش ، فرجع الي شجرة امام القوم فتكلم عندها بشء ورجع فقال : لينطلق احدكم معي الي رجل يدعوه ، قال ابو سلمة : فانطلقت معه ، فوقف بي تحت شجرة ، فاذا وكر مغلق ، فصوت يا ابه ، فزعزع شيخ راسه فاجابه ، فقال : هذا الرجل ، فقال لي : ممن الرجل ؟ قلت : من قريش ، قال : من ايها ؟ قلت : من بني مخزوم بن يقظة ، قال : من ايها ؟ قلت : انا ابو سلمة بن عبد الاسد بن هلال بن عبد الله بن عمرو بن مخزوم بن يقظة ، قال : ايهات انا ويقظة بسن واحد ، اتدري من يقول ؟ من الطويل كان لم يكن بين الحجون الي الصفا . . . انيس ولم يسمر بمكة سامر بلي نحن كنا اهلها فابادنا . . . صروف الليالي والجدود العواثر قلت : لا ، قال : انا قاءلها ، انا عمرو بن الحارث بن مضاض الجرهمي ،  اتدري لم سمي اجيادا ؟ قلت : لا ، قال : جادت بالدماء يوم التقينا نحن وقطورا ، اتدري لم سمي فقيقان ؟ قلت : لا ، قال : لتقعقع السلاح علي ظهورنا لما طلعنا عليهم منه . دخل سليمان بن عبد الملك مسجد دمشق فراي شيخا يزحف فقال : يا شيخ ايسرك ان تموت ؟ قال : لا ، قال : ولم ، وقد بلغت من السن ما اري ؟ قال : ذهب الشباب وشره ، وبقي الكبر وخيره ، اذا انا قعدت ذكرت الله ، واذا قمت حمدت الله ، فاحب ان تدوم لي هاتان الخصلتان . وقد جاءت الاخبار عن القرن الاول دالة علي طول العمر المضاعف علي اعمار هذا العصر ، فمن الحجة فيها عمر نوح عليه السلام في قومه الذي لا خلاف فيه ، دل عليه كتاب الله تعالي والتوراة وساءر الكتب . وقال وهب : ان اصغر من مات من ولد ادم عليه السلام ابن ماءتي سنة فبكته الانس والجن لحداثة سنه . وقال عبد الله : كان الرجل ممن كان قبلكم لا يحتلم حتي تاتي عليه ثمانون سنة .  الفصل الخامس نوادر هذا الباب قال سهل بن غالب الخزرجي في معاذ بن مسلم جد يحيي بن معاذ : من المنسرح ان معاذ بن مسلم رجل . . . ليس لميقات عمره امد قد شاب راس الزمان واكتهل الد . . . هر واثواب عمره جدد قل لمعاذ اذا مررت به . . . قد ضج من طول عمرك الابد يا بكر حواء كم تعيش وكم . . . تسحب ذيل الحياة يا لبد قد اصبحت دار ادم خربت . . . وانت فيها كانك الوتد تسال غربانها اذا نعبت . . . كيف يكون الصداع والرمد فاشخص ودعنا فان غايتك ال . . . موت وان شد ركنك الجلد قيل لاعرابي : الا تغير مشيبك بالخضاب ؟ قال : الا بلي ! ففعل ذلك مرة ثم لم يعاوده ، فقيل له : لم لم تعاود الخضاب ؟ فقال : يا هناه لقد تشد لحياي فجعلت اخالني ميتا . نظر يزيد بن مزيد الشيباني الي رجل ذي لحية عظيمة وقد تلففت علي صدره واذا هو خاضب ، فقال له : انك من لحيتك لفي مءونة ؟ قال : اجل ! ولذلك اقول : من الطويل  لها درهم للزيت في كل جمعة . . . واخر للحناء يبتدران فلولا نوال من يزيد بن مزيد . . . لصوت في حافاتها الجلمان قيل للجماز وقد اسن : ما بقي من شهوتك للنساء ؟ قال : القيادة عليهن . نظر شاب الي شيخ تقارب خطاه فقال له : من قيدك ؟ قال : الذي تركته يقتل قيدك . قال رجل لجارية اراد شراءها : لا يريبك شيبي فان عندي قوة ، قالت : ايسرك ان عندك عجوزا مغتلمة ؟ ! بعض العرب : من الرجز رات شبابا بان واضمحلا . . . وفاتها الدهر به فولي وصار شيخا فانيا انقحلا . . . فاستعبرت تهمر سجلا سجلا الانقحل : المسن الذي تجاوز الماءة . تقول للموت بهذا اولي . . . بءس امرء هذا لمثلي بعلا مازح اشيخ جارية من الاعراب فقالت : من البسيط يا ايها الشيخ ما عناك للغزل . . . قد كنت في مقعد عن ذا ومعتزل رضت القلاص فلم تحكم رياضتها . . . فاعمد برحلك نحو الجلة الذلل صاح صبي بشيخ قد احدودب : بكم ابتعت هذه القوس يا عماه ؟  قال : يا بني ان عشت اعطيتها بغير ثمن . راي الخليل مع رجل دفترا بخط دقيق فقال : يا هذا ايءست من طول العمر ؟ عبد المحسن الصوري : من البسيط اهدي لي الشيب رجلا منه ثالثة . . . وكنت من قبله امشي برجلين هدية كنت اباها فصيرها . . . علي بالرغم مني قرة العين ابو نواس : من الكامل قالوا كبرت فقلت ما كبرت يدي . . . عن ان تحث الي فمي بالكاس نظر رجل الي فيلسوف يدب شيخا فقال : ما تصنع ؟ قال : اغسل مسحا لعله يبيض .  اخر باب الشيب ، ويتلوه باب النسيب والغزل ، والحمد لله اولا واخرا وحسبنا الله ونعم الوكيل .  فارغة 
  الباب التاسع والعشرون في الغزل والنسيب
  صفحة فارغة   بسم الله الرحمن الرحيم وبه الاعانة اللهم انا نحمدك علي ما سترت من العيوب ، واسبلت دونه من ذيل عفوك المطلوب ، ونستغفرك من موبقات الذنوب ، ونسالك عصمة الاجساد والقلوب ، حتي لا تسعي تلك الي هواها ، ولا ترتع هذه عن هداها ، وان تجعل الصون لنا شعارا ، والعفة سجيتنا اعلانا واسرارا ، ولا تءاخذنا بلغو الالسنة الناطقة عن قلوب سليمة ، ولا بطرب النفوس المرتاحة ما لم يكن ذا نية سنية وعزيمة ، ونسالك الصلاة علي نبيك الداعي الي دار السلام ، الناهي عن الرهبانية في الاسلام ، وعلي اله الاصفياء الكرام . 
  الباب التاسع والعشرون في النسيب والغزل
 وهو اثنان وعشرون نوعا : هذا الباب تتداخل معانيه ، ويتضمن كل بيت منه صحبة اخيه . فان فصل واضيف كل معني الي بابه ، انقطع البيت عن قرينه ، وتبدد نظام تاليفه وترتيبه ، فذهبت بهجة الكلام وسلب رونقه ، وعلي ذلك فقد افردت منه عشرين نوعا ميزتها لحاجة شاهد ان دعت اليها وهي : شدة الغرام والوجد ، الاعراض والصد والهجر ، الشوق والنزاع ، ذكر الوداع ، المسرة عند الاياب ، الطيف والخيال ، الرقة والنحول ، البكاء والهمول ، احماد المواصلة ولذة العناق ، شكوي البين والفراق واحتمالهما ، الارق والسهاد ، تعاطي الصبر والتجلد ، العذول والوشاة والرقيب ، وصف المحبوب ، طيب الافواه ، وصف الثغر ، اسرار الهوي واعلانه ، عشق الحلاءل ، غزل العباد وتساهلهم ، اخبار من قتل بالكمد . وما عدا ذلك علي كثرة فنونه وعدد ضروبه جعلته بابا واحدا ، واتبعته بفصل من نوادر هذا الباب ، علي ما شرطته في اول الكتاب . وقد تجء ابيات واخبار تتضمن عدة معان من الانواع المفردة ، فلا اري حل نظامها وتفريق التءامها ، فاضيفها الي الفصل العام ، واثبتها في بعض الانواع اذا كان يتضمن معني منها ، محافظة علي ان تلج الاسماع متصلة لم تسلب حسن ازدواجها ، وترد علي القلوب مكسوة رونق الفتها واصطحابها ، والله الموفق للصواب . 
  النوع الاول شدة الغرام والوجد
 قال جرير : من الكامل لا يستطيع اخو الصبابة ان يري . . . حجرا اصم ولا يكون حديدا الله يعلم لو اردت زيادة . . . في الحب عندي ما وجدت مزيدا وقال ايضا : من الكامل اسري بخالدة الخيال ولا اري . . . شيءا احب من الخيال الطارق ان البلية من تمل حديثه . . . فانشح فءادك من حديث الوامق اهواك فوق هوي النفوس ولم يزل . . . ما بنت قلبي كالجناح الخافق وقال الصمة بن عبد الله القشيري : من الطويل لعمري لءن كنتم علي الناي والقلي . . . بكم مثل ما بي انكم لصديق اذا زفرات الحب صعدن في الحشا . . . رددن ولم ينهج لهن طريق  وقال بعض بني طء : من الطويل هويتك حتي كاد يقتلني الهوي وزرتك حتي ملني كل صاحب وحتي راي مني ادانيك لينة . . . لديهم ولولا انت ما لان جانبي الا حبذا لوما الحياء وربما . . . منحت الهوي من ليس بالمتقارب باهلي ظباء من ربيعة عامر . . . عذاب الثنايا مشرفات الذواءب وقال المتنبي : من الطويل وما هي الا نظرة بعد نظرة . . . اذا نزلت في قلبه رحل العقل جري حبها مجري دمي في مفاصلي . . . فاصبح لي عن كل شغل بها شغل كان رقيبا منك سد مسامعي . . . عن العذل حتي ليس يدخلها العذل وقال البحتري : من الطويل راي البرق مختارا فبات بلا لب . . . واصباه من ذكر البخيلة ما يصبي وقد عاج في اطلالها غير ممسك . . . لدمع ولا مصغ الي عذل الركب وكنت جديرا يوم اعرف منزلا . . . لال سليمي ان يعنفني صحبي وبي ظما لا يملك الماء دفعه . . . الي نهلة من ريقها الخصر العذب  تزودت منها نظرة لم تجد بها . . . وقد يءخذ العلق الممنع بالغصب وما كان حظ العين من ذاك مذهبي . . . ولكن رايت العين بابا الي القلب وقال ايضا : من الكامل شوق اليك تفيض منه الادمع . . . وجوي عليك تضيق عنه الاضلع وهوي تجدده الليالي كلما . . . قدمت وترجعه السنون فيرجع يقتادني طربي اليك فيغتلي . . . وجدي ويدعوني هواك فاتبع كلفا بحبك مولعا ويسرني . . . اني امرو كلف بحبك مولع وقال ايضا : من الطويل قضي الله اني منك ضامن لوعة . . . تقضي الليالي وهي ثاو مقيمها اميل بقلبي عنك ثم ارده . . . واعذر نفسي فيك ثم الومها وقال جميل : من الطويل اظن هواها تاركي بمضلة . . . من الارض لا مال لدي ولا اهل محا حبها حب الاولي كان قبلها . . . وحلت مكانا لم يكن حل من قبل وقال كثير : من الطويل اريد لانسي ذكرها فكانما . . . تمثل لي ليلي بكل سبيل وقالوا نات فاختر من الصبر والبكا . . . فقلت البكا اشفي اذن لغليلي  وقال ذو الرمة : من الطويل اذا ذكرت عندي اءن لذكرها . . . كما ان من حر السلاح جريح ولي كبد مقروحة من يبيعني . . . بها كبدا ليست بذات قروح ابي الناس ويب الناس لا يشترونها . . . ومن يشتري ذا علة بصحيح وقال ايضا : من الطويل وجدت بها وجد المضل بعيره . . . بمكة والحجاج غاد وراءح وجدت بها ما لم تجد ام واحد . . . بواحدها تطوي عليه الصفاءح وجدت بها ما لم يجد ذو حرارة . . . يراقب جمات الركي البراءح وقال ايضا : من الطويل اذا غير الناي المحبين لم اجد . . . رسيس الهوي من ذكر مية يبرح فلا القرب يدني من هواها ملالة . . . ولا حبها ان تبرح الدار يبرح تصرف اهواء القلوب ولا اري . . . نصيبك من قلبي لغيرك يمنح اذا خطرت ذكر مية خطرة . . . علي القلب كادت في فءادك تجرح اناة يطيب البيت من طيب نشرها . . . بعيد الكري زين له حين يصبح  لءن كانت الدنيا علي كما اري . . . تباريح من ذكراك للموت اروح ويروي : من مي فللموت اروح وقال اعرابي : من الطويل ايا منشر الموتي اعني علي التي . . . بها نهلت نفسي سقاما وعلت لقد بخلت حتي لو اني سالتها . . . قذي العين من سافي التراب لضنت الا قاتل الله الحمامة غدوة . . . علي الغصن ماذا هيجت حين غنت تغنت بصوت اعجمي فهيجت . . . هواي الذي كانت ضلوعي اجنت فلو قطرت عين امرء من صبابة . . . دما قطرت عيني دما والمت اذا قلت هذي زفرة اليوم قد مضت . . . فمن لي باخري في غد قد اطلت حلفت لها بالله ما ام واحد . . . اذا ذكرته اخر الليل انت وما وجد اعرابية قذفت بها . . . صروف النوي من حيث لم تك ظنت اذا ذكرت ماء العضاه وطيبه . . . وبرد حصاه اخر الليل حنت باكثر مني لوعة غير انني . . . اجمجم احشاءي علي ما اجن ت وقال عروة بن حزام : من الطويل واني لتعروني لذكراك فترة . . . لها بين جلدي والعظام دبيب  وما هو الا ان اراها فجاءة . . . فابهت حتي ما اكاد اجيب عشية لا عفراء منك بعيدة . . . فتسلو ولا عفراء منك قريب لءن كان برد الماء حران صاديا . . . الي حبيبا انها لحبيب وقال عمرو بن ضبيعة : من الطويل تضيق جفون العين عن عبراتها . . . فتسفحها بعد التجلد والصبر وغصة صدر اظهرتها فرفهت . . . حرارة حر في الجوانح والصدر الا ليقل من شاء ما شاء انما . . . يلام الفتي فيما استطاع من الامر قضي الله حب المالكية فاصطبر . . . عليه فقد تجري الامور علي قدر وقال خلف بن خليفة : من الطويل سلبت عظامي لحمها فتركتها . . . مجردة تضحي اليك وتخصر واخليتها من مخها فتركتها . . . انابيب في اجوافها الريح تصفر اذا سمعت باسم الفراق تقعقعت . . . مفاصلها من هول ما تنتظر خذي بيدي ثم ارفعي الثوب فانظري . . . بي السقم الا انني اتستر وليس الذي يجري من العين ماءها . . . ولكنها روح تذوب فتقطر وقال عبد الله بن الدمينة الخثعمي : من الطويل اقضي نهاري بالحديث وبالمني . . . ويجمعني والهم بالليل جامع نهاري نهار الناس حتي اذا بدا . . . لي الليل هزتني اليك المضاجع اذا نحن انفذنا الدموع عشية . . . فموعدنا قرن من الشمس طالع  وقال ايضا : من الطويل يقولون مجنون بسمراء مولع . . . نعم زيد في حب لها وولوع واني لاخفي حب سمراء في الحشا . . . ويعلم قلبي انه سيشيع اظل كاني واجم لمصيبة . . . المت واهلي سالمون جميع وقال ايضا : من الطويل ولما ابي الا جماحا فءاده . . . ولم يغن عن ليلي بمال ولا اهل تسلي باخري غيرها فاذا التي . . . تسلي بها تغري بليلي ولا تسلي وقال حسان بن ثابت : من الطويل كان فءادي في مخاليب طاءر . . . اذا ذكرتك النفس شدت به قبضا كان فجاج الارض حلقة خاتم . . . علي فما تزداد طولا ولا عرضا وقال المامون : من المديد نفس تدمي مسالكه . . . وحنين لست املكه والذي اخفيه من سقم . . . فلسان الدمع يهتكه وقال ديك الجن : من الطويل كان علي قلبي قطاة تذكرت . . . علي ظما وردا فهزت جناحها  ولي كبد حري ونفس كانها . . . بكف عدو ما يريد سراحها وقال بعض بني قشير : من الطويل ولما تبينت المنازل باللوي . . . ولم تقض لي تسليمة المتزود زفرت اليها زفرة لو حشوتها . . . سرابيل ابدان الحديد المسرد لقصت حواشيها وظلت لحرها . . . تلين كما لانت لداود في اليد وقال اخر : من الطويل اذا كنت لا يسليك عمن توده . . . تناء ولا يشفيك طول تلاق فهل انت الا مستعير حشاشة . . . لمهجة نفس اذنت بفراق وقال ابو الشميص الخزاعي : من الكامل وقف الهوي بي حيث انت فليس لي . . . متاخر عنه ولا متقدم اجد الملامة في هواك لذيذة . . . حبا لذكرك فليلمني اللوم اشبهت اعداءي فصرت احبهم . . . اذ كان حظي منك حظي منهم واهنتني فاهنت نفسي عامدا . . . ما من يهون عليك ممن اكرم ان كان عندك قد اذلني الهوي . . . فبكل ناحية اعز واكرم وقال ابن الحجاج : من الطويل بديعة حسن الوجه ليس بمنكر . . . عليك جوي قلبي ولا ببديع  سابكيك لا ان المني يستفزني . . . لعود ووصل منك او لرجوع ولكن نار الشوق لم ار مطفيا . . . لها في فءادي مثل فيض دموعي تبدلت بي من لا يكون قنوعه . . . يسر وما تولينه كقنوعي فعيشكما لا زال الا منغصا . . . وشملكما لا زال غير جميع اخر : من الطويل كان هموم الناس في الارض كلها . . . علي وقلبي فيهم قلب واحد ولي شاهدا عدل سهاد وعبرة . . . وكم مدع للحب من غير شاهد وقال ابو نواس : من مجزوء الخفيف دع جنابا وذكرها . . . عنك ان كنت عاقلا لا تذكر بنفسك ال . . . موت ما دام غافلا عبد الكريم بن ابراهيم النهشلي المغربي : منا لطويل اواجدة وجدي حماءم ايكة . . . تميل بها ميل النزيف غصونها نشاوي وما مالت بخمر رقابها . . . بواك وما فاضت بدمع عيونها اعيدي حمامات اللوي ان عندنا . . . لشجوك امثالا يعود حنينها وكل غريب الدار يدعو همومه . . . غراءب محشود عليها شجونها ابو اسحاق الحصري الانصاري المغربي : من الكامل  ولقد تنسمت الرياح لعلني . . . ارتاح ان يبعثن منك نسيما فاثرن من حرق الصبابة كامنا . . . واذعن من سر الهوي مكتوما وكذا الرياح اذا مررن علي لظي . . . نار بدت ضرمنها تضريما 
  النوع الثاني  في الاعراض والصد
 قال البحتري : من الطويل علمتك ان منيت منيت موعدا . . . جهاما وان ابرقت ابرقت خلبا فوااسفا حتام اسال مانعا . . . وامن خوانا واعتب مذنبا وقال ايضا : من الكامل اين الغزال المستعير من النقا . . . كفلا ومن نور الاقاحي مبسما تظما مراشفنا اليه وريها . . . في ذلك اللعس الممنع واللمي متعتب في غير ما متعتب . . . ان لم يجد جرما لدي تجرما الف الصدود فلو يمر خياله . . . بالصب في سنة الكري ما سلما وقال عروة بن اذينة : من الكامل ان التي زعمت فءادك ملها . . . خلقت هواك كما خلقت هوي لها  بيضاء باكرها النعيم فصاغها . . . بلباقة فادقها واجلها حجبت تحيتها فقلت لصاحبي . . . ما كان اكثرها لنا واقلها واذا وجدت لها وساوس سلوة . . . شفع الضمير الي الفءاد فسلها وقال البحتري : من البسيط تصرم الدهر لا وصل فيطمعني . . . فيما لديك ولا ياس فيسليني ولست اعجب من عصيان قلبك لي . . . يوما اذا كان قلبي فيك يعصيني وقال اخر : من الطويل اذا كان هذا منك حقا فانني . . . مداوي الذي بيني وبينك بالهجر ومنصرف عنك انصراف ابن حرة . . . طوي وده والطي ابقي من النشر وقال عبد الله بن الدمينة : من الطويل ولما بدا لي منك ميل مع العدي . . . علي ولم يحدث سواك بديل صددت كما صد الرمي تطاولت . . . به مدة الايام وهو قتيل وعزيت نفسا عن نوار كريمة . . . علي بها من لوعة وغليل وقال ايضا : من الكامل واذا غضبت علي بت كانني . . . بالليل مستحر الفءاد كليم  ولقد اردت الصبر عنك فعاقني . . . علق بقلبي من هواك قديم يبقي علي حدث الزمان وريبه . . . وعلي جفاءك انه لكريم واريته زمنا فعاد بحلمه . . . ان المحب عن الحبيب حليم وعتبت حين صحوت وهو بداءه . . . شتي العتاب مصحح وسقيم وقال النظار الفقعسي : من الطويل يقولون هذي ام عمرو قريبة . . . دنت بك ارض نحوها وسماء والا انما قرب الحبيب وبعده . . . اذا هو لم يوصل اليه سواء وقال ابن نباتة : من المتقارب ملالك علمني في هوا . . . ك ان اتمني النوي والصدودا وكيف السبيل الي رقدة . . . اذكر طيفك فيها العهودا واغرب ابن الرومي فحمد الاعراض فقال : من مجزوء الرجز ما ساءني اعراضه . . . عني ولكن سرني سالفتاه عوض . . . عن كل شء حسن عوضني من حسنه . . . حسنا فماذا ضرني ما قلت ان قد عقني . . . بالصد الا برني وقال قيس بن ذريح : الطويل  وقد ايقنت نفسي ببينك برهة . . . من الدهر لو ياتي بياس يقينها صلي الحبل يحمل ما سواه فانه . . . يعفي علي غث الامور سمينها وقال اسماعيل بن يسار : منا لكامل لو تبذلين لنا دلالك مرة . . . لم نبغ منك سوي دلالك محرما ما ضر اهلك لو تطوف عاشق . . . بفناء بيتك او الم مسلما وقال ابو الطيب المتنبي : من البسيط وما صبابة مشتاق علي امل . . . من اللقاء كمشتاق بلا امل والهجر اقتل لي مما افارقه . . . انا الغريق فما خوفي من البلل وقال ابن الحجاج : من السريع يا مولعا بالهجر مهلا فقد . . . علمتني الصبر علي الهجر وقد تسببت لقلبي الي . . . سلوه من حيث لا تدري صبرا وتسليما وهل لي اذا . . . جنت سوي التسليم والصبر كم تتجني والتجني اذا . . . فكرت فيه اول الغدر عتب المامون علي عريب وهجرها اياما ، ثم اعتلت فعادها فقال : كيف وجدت طعم الهجر ؟ فقالت : يا امير المءمنين لولا مرارة الهجر ما عرفت حلاوة الوصل ، ومن ذم بدء الغضب حمد عاقبة الرضي ؛ فخرج المامون الي جلساءه فحدثهم بالقصة وقال : اتري لو كان من كلام النظام لم يكن كثيرا ؟  وكلمها دفعة بكلام اغضبها فهجرته ، فدخل احمد بن ابي دواد فقال : يا احمد اقض بيننا ، فقالت عريب : لا حاجة لي في قضاءه ودخوله بيننا ثم انشات تقول : من المنسرح : ونخلط الهجر بالوصال ولا . . . يدخل في الصلح بيننا احد وقال ابن مقبل : من الطويل فاصبحن لا يسقيننا من مودة . . . بلالا ولو سالت بهن الاباطح اذا الناس قالوا كيف انت وقد بدا . . . ضمير الهوي بي قلت للناس صالح اري الناس اني لا احب وانني . . . سلوت وفي قلبي كلوم جوارح وقال عتيق بن مفرج المغربي : من الكامل خمصانة ملء الازار اذا مشت . . . تمشي الهوينا خطوها مقصور قالت وقد نظرت الي بمقلة . . . هاروت من اجفانها مسحور عرضت نفسي في الهوي وتلومها . . . ان المحب علي الهوي لجسور ما انت اول مغرم هجر الكري . . . لما تيقن انه مهجور 
  النوع الثالث في الشوق والنزاع
 قال ابن ميادة ، وهو الرماح بن ابرد : من الطويل الا ليت شعري هل ابيتن ليلة . . . بحرة ليلي حيث رببني اهلي بلاد بها نيطت علي تماءمي . . . وقطعن عني حيث ادركني عقلي وروي ان عبد السلام ابن القتال الكلابي انشد ابن ميادة البيت الثاني فاغار عليه وادخله شعره . يقال : ربيته ورببته ، ومنه قول الاحوص : من الطويل وفي بيته مثل الغزال المربب وقال اخر : من الطويل لعمرك اني يوم بانوا ولم امت . . . خفاتا علي اثارهم لصبور اهذا ولما تمض للبين ليلة . . . فكيف اذا مرت عليك شهور وقال اخر : من الطويل يقر بعيني ان اري من بلادها . . . ذري عقدات الاجرع المتقاود  وان ارد الماء الذي وردت به . . . سليمي وقد مل السري كل واحد والصق احشاءي ببرد ترابه . . . ولو كان ممزوجا بسم الاساود وقال جميل : من الطويل وما صاديات حمن يوما وليلة . . . علي الماء يغشين العصي حواني لوابث لا يصدرن عنه لوجهة . . . ولا هن من برد الحياض دواني يرين حباب الماء والموت دونه . . . فهن لاصوات السقاة رواني باوجع مني جهد شوق وغلة . . . اليك ولكن العدو عداني وقال ابو الطيب المتنبي : من الطويل وما شرقي بالماء الا تذكرا . . . لماء به اهل الحبيب نزول يحرمه لمع الاسنة فوقه . . . فليس لظمان اليه سبيل وقال اخر : من الطويل رعاك ضمان الله يا ام مالك . . . ولله عن يشقيك اغني واوسع يذكرنيك الخير والشر والذي . . . اخاف وارجو والذي اتوقع وقال عبد الله بن نمير بن حسوسة الثقفي : من الطويل تعز بصبر لا وجدك لن تري . . . عراض الحمي احدي الليالي الغوابر كان فءادي من تذكره الحمي . . . واهل الحمي يهفو به ريش طاءر  وقال اخر ، وجدتها في ديوان ابراهيم بن العباس : من الكامل باتت تشوقني برجع حنينها . . . وابيت اسعدها برجع حنيني الفان مغتربان بين مهامه . . . طويا الضلوع علي هوي مكنون وقال اخر : من الطويل ولو وقفت ليلي بقبري وقد عفت . . . معالمه واستفتحت بسلام لحنت اليها بالتحية رمتي . . . ورنت بترجيع السلام عظامي وقال اخر : من الطويل لاتعذلينا في الزيارة انني . . . واياك كالظمان والماء بارد تراه قريبا دانيا غير انه . . . تحول المنايا دونه والرواصد وقال عون الكندي الكاتب : من الطويل سقي الله اياما لنا و لياليا . . . مضين فما يرجي لهن رجوع اذ العيش صاف والاحبة جيرة . . . واذ كل ايام الزمان ربيع واذ انا اما للعواذل في الصبا . . . فعاص واما للهوي فمطيع وقال عمرو بن قميءة : من الكامل لله عيشتنا بجو سويقة . . . والعيش غض والزمان غرير طابت فقصر طيبها ايامها . . . فكانما فيها السنون شهور  وقال يحيي بن طالب الحنفي : من الطويل اذا ارتحلت نحو اليمامة رفقة . . . دعاني الهوي وارتاح قلبي الي الذكر كان فءادي كلما مر راكب . . . جناح عقاب رام نهضا الي الوكر احقا عباد الله ان لست ناظرا . . . الي قرقري يوما واعلامها الغبر يقولون ان الهجر يشفي من الجوي . . . ولا ازددت الا ضعف ما بي من الهجر تنحيت عنها كارها وتركتها . . . وهجرانها عندي امر من الصبر وقال قيس بن ذريح : من الطويل لقد خفت الا تقنع النفس بعدها . . . بشء من الدنيا وان كان مقنعا واعذل فيها النفس اذ حيل دونها . . . وتابي اليها النفس الا تطلعا وقال ايضا ، ويرمي لمزاحم : من الطويل الي الله اشكو فقد ليلي كما اشتكي . . . الي الله فقد الوالدين يتيم بكت دارهم من نايهم وتهللت . . . دموعي فاي الجازعين الوم امستعبر يبكي من الشوق و البلي . . . ام اخر يبكي شجوه ويهيم وقال الصمة بن عبد الله القشيري : من الطويل الا قاتل الله اللوي من محلة . . . وقاتل دنيانا بها كيف ولت غنينا زمانا باللوي كيف اصبحت . . . عراض اللوي من اهلها قد تخلت  واول الابيات وهي من هذا النوع : الا من لعين ما تري قلل الحمي . . . ولا ابرق الظمان الا استهلت لجوج اذا لجت بكي اذا بكت . . . بكت فادقت في البكا واجلت ابو بكر الوراق التميمي المغربي : من الخفيف تعبي راحتي وانسي انفرادي . . . وشفاءي الضنا ونومي سهادي لست اشكو فعال من صد عني . . . اي بعد وقد ثوي في فءادي هو يختال بين قلبي وعيني . . . وهو ذاك الذي يري في السواد انشد الجاحظ : من الطويل عسي ان تحل الحي جرعاء وابل . . . وعل النوي بالظاعنين تريع افي كل عام زفرة مستجدة . . . تضمنها مني حشا وضلوع وقال جميل : من الطويل اشوقا ولما يمض لي غير ليلة . . . رويد الهوي حتي يغب لياليا لحي الله اقواما يقولون اننا . . . وجدنا بعيد الناي للحب شافيا ومثله : من الطويل اشوقا ولما تمض لي غير ليلة . . . فكيف اذا جد المسير بنا عشرا ومثله لكثير : من الطويل لعمرك ان الجزع امسي ترابه . . . من الطيب كافورا وعيدانه رندا  وما ذاك الا ان مشت في عراصه . . . عزيزة في سرب وجرت به بردا واصبح ماء الشعب خمرا واصبحت . . . جلاميده مسكا واوراقه وردا وظلت ظبا البيداء ترعي خماءلا . . . سقتها رياح الجو من سحبها شهدا وقال اخر : من الطويل فان ترجع الايام بيني وبينها . . . بذي الاثل صيفا مثل صيفي ومربعي اشد باعناق النوي بعد هذه . . . مراءر ان جاذبتها لم تقطع وقال الصمة القشيري ، ويروي لغيره : من الطويل واذكر ايام الحمي ثم انثني . . . علي كبدي من خشية ان تقطعا فليست عشيات الحمي برواجع . . . عليك ولكن خل عينك تدمعا وقال اخر : من الطويل سقي بلدا امست سليمي تحله . . . من المزن ما تروي به وتسيم وان لم اكن من ساكنيه فانه . . . يحل به شخص علي كريم الا حبذا من ليس يعدل قربه . . . لدي وان شط المزار نعيم ومن لامني فيه حبيب وصاحب . . . فرد بغيظ صاحب وحميم وقال ابن نباتة : من البسيط يا حبذا ارض نجد كيف ما سمحت . . . بها الخطوب علي يسر واعسار  وحبذا دمث من ارضها عبق . . . هبت عليها رياح غب امطار احبها وبلاد الله واسعة . . . حب البخيل غناه بعد اقتار ما كنت اول من حنت ركاءبه . . . شوقا وفارق الفا غير مختار وقال ابو القمقام الاسدي : من الكامل اقرا علي الوشل السلام وقل له . . . كل المشارب مذ هجرت ذميم سقيا لظلك بالعشي وبالضحي . . . ولبرد ماءك والمياه حميم لو كنت املك برد ماءك لم يذق . . . ما في قلاتك ما حييت لءيم وقال ابن الحجاج : من السريع يا ليلتي هل لك ان ترجعي . . . حتي اري فيك حبيبي معي ماذا علي الصبح الذي راعني . . . لو انه ابطا ولم يسرع اذانه شتت شمل الهوي . . . ليت اذان الصبح لم يسمع وقال رجل من بني كلاب : من الطويل نحن الي الرمل اليماني صبابة . . . و هذا لعمري ان رضيت كثيب فاين الاراك الدوح والسدر والغضا . . . ومستخبر عمن نحب قريب هناك تغنينا الحمام ونجتني . . . جني اللهو يحلولي لنا ويطيب وقال خارجة بن فليح : من الطويل احن الي ليلي وقد شط وليها . . . كما حن محبوس عن الالف نازع  اذ خوفتني النفس بالناي تارة . . . وبالصرم منها كذبتها المطامع اكل هواك الطرف عن كل بهجة . . . وصمت عن الداعي اليك المسامع وقال ذو الرمة : من الطويل ومن حاجتي لولا التناءي وربما . . . منحت الهوي من ليس بالمتقارب عطابيل بيض من ربيعة عامر . . . رقاق الثنايا مشرفات الحقاءب وقال ايضا : من البسيط تعتادني زفرات حين اذكرها . . . تكاد تنقض منهن الحيازيم هام الفءاد لذكرها وخامره . . . منها علي عدواء الدار تسقيم فما اقول ارعوي الا تهيضه . . . حظ له من خبال الشوق مقسوم وله ايضا : من الطويل ادارا بحزوي هجت للعين عبرة . . . فماء الهوي يرفض او يترقرق وقفنا فسلمنا فكاد بمشرف . . . لعرفان صوتي دمنة الدار تنطق تجيش الي النفس في كل منزل . . . لمي ويرتاح الفءاد المشوق وله ايضا : من الطويل اذا ذكرتك النفس ميا فقل لها . . . افيقي فايهات الهوي من مزارك وما ذكرك الشء الذي ليس راجعا . . . به الوجد الا خفقة من ضلالك  اما والذي حج الملبون بيته . . . شلالا ومولي كل باق وهالك لءن قطع الياس الحنين فانه . . . رقوء لتذارف الدموع السوافك لقد كنت اهوي الارض ما يستفزني . . . لها الشوق الا انها من ديارك 
  النوع الرابع في ذكر الوداع
 وقال الشماخ : من الطويل واعجلنا وشك الفراق وبيننا . . . حديث كتنفيس المريضين مزعج حديث لو ان اللحم يصلي بحره . . . غريضا اتي اصحابه وهو منضج وقال بعض العرب : من الطويل ومما شجاني انها يوم ودعت . . . تولت وماء العين في الجفن حاءر فلما اشارت من بعيد بنظرة . . . الي التفاتا اسلمتها المحاجر يقولون لا تنظر وتلك بلية . . . الا كل ذي عينين لا بد ناظر الام بان حنت قلوصي من الهوي . . . ولا ذنب لي في ان تحن الاباعر وقال البحتري : من الكامل رحلوا فاية عبرة لم تسكب . . . اسفا واي عزيمة لم تغلب لو كنت شاهدنا وما صنع الهوي . . . بقلوبنا لحسدت من لم يحبب شغل الرقيب واسعدتنا خلوة . . . في هجر هجر واجتناب تجنب  تشكو الفراق الي قتيل صبابة . . . شرق المدامع بالفراق معذب وقال المتنبي : من الكامل وجلا الوداع من الحبيب محاسنا . . . حسن العزاء وقد جلين قبيح فيد مسلمة وطرف شاخص . . . وحشا يذوب ومدمع مسفوح وقال جرير : من الوافر اتسني اذ تودعنا سليمي . . . بعود بشامة سقي البشام فلو وجد الحمام كما وجدنا . . . بسلمانين لاكتاب الحمام بنفسي من تجنبه عزيز . . . علي ومن زيارته لمام ومن امسي واصبح لا اراه . . . ويطرقني اذا هجع النيام وقال البحتري : من الكامل وانا الفداء لمرهف غض الصبا . . . يوهيه حمل وشاحه وعقوده قصرت تحيته فجاد بخده . . . يوم الوداع لنا وضن بجيده ولو استطاع لكان يوم وصاله . . . للمستهام مكان يوم صدوده وقال ابن الرومي : من المنسرح لو كنت يوم الفراق حاضرنا . . . وهن يطفين غلة الوجد لم تر الا دموع باكية . . . تسفح من مقلة علي خد كان تلك الدموع قطر ندي . . . يقطر من نرجس علي ورد  وقال ايضا : من الوافر تلاقينا لقاء لافتراق . . . كلانا منه ذو قلب مروع فما افترت شفاه عن ثغور . . . بل افترت جفون عن دموع وقال الطاءي : من الكامل مدت اليك بنانة اسروعا . . . تصف الفراق ومقلة ينبوعا كادت لعرفان النوي الفاظها . . . من رقة الشكوي تكون دموعا وقال البصير : من الطويل المت بنا يوم الرحيل اختلاسة . . . فاضرم نيران الهوي النظر الخلس تانت قليلا وهي ترعد خيفة . . . كما تتاني حين تعتدل الشمس فخاطبها صمتي بما انا مضمر . . . وابلست حتي ليس يعلم لي حس وولت كما ولي الشباب لطية . . . طوت دونها كشحا علي نايها النفس وقال الحسن بن هاني : من الكامل المرفل وكان سلمي اذ تودعنا . . . وقد اشراب الدمع ان يكفا رشا تواصين القيان به . . . حتي عقدن باذنه شنقا وقال المرتضي ابو القاسم الموسوي : من الطويل ويوم وقفنا للوداع وكلنا . . . يعد مطيع الشوق من كان احزما  نصرت بقلب لا يعنف في الهوي . . . وعين متي استمطرها قطرت دما وقال ابو المطاع ابن ناصر الدولة بن حمدان : من الكامل لو كنت ساعة بيننا ما بيننا . . . فشهدت حين نكرر التوديعا ايقنت ان من الدموع محدثا . . . وعلمت ان من الحديث دموعا وقال ابو الحسين بن لنكك البصري : من الوافر وقفنا موقف التوديع نوطي . . . نجوم الدمع افاق الغروب تعجب من عناق حر دمعا . . . وتقبيل يشيع بالنحيب وقد ضاق العناق فلو فطنا . . . دخلنا في المخانق والجيوب وقال جعفر بن علبة الحارثي : من الطويل اشارت بطرف العين وهي حزينة . . . تودعنا اذ لم يبين كلامها فلو كنت ابكي للفراق صبابة . . . شفي بعض وجدي من جفوني انسجامها ولكنها عين كتوم لدمعها . . . اذا ما حبال الوصل جد انصرامها وخبرتها تهدي السلام ودونها . . . جبال السري تثليثها واكامها فان التي اهدت علي ناي دارها . . . سلامها لمردود علي سلامها وقال ذو الرمة : من الطويل عدون فاحسن الوداع فلم نقل . . . كما قلن الا ما تشير الاصابع ولما تلاحقنا ولا مثل ما بنا . . . من الوجد لا تنقض منه الاضالع تخللن ابواب الخدور باعين . . . غرابيب والالوان بيض صوادع  وخالسن تبساما الينا كانما . . . تصيب به حب القلوب القواطع وقال اخر من الطويل ولا انسي من اسماء بالامس قولها . . . وادمعها يذرين حشو المكامل تمتع بذا اليوم القصير فانه . . . رهين بايام الشهور الاطاول وقال البحتري : من السريع ان انت ودعت بتقبيلة . . . كانت يدا مشكورة للفراق احاذر البين من اجل النوي . . . طورا واهواه من اجل العناق وقال ابو دهبل : من الطويل فوا ندما اذ لم اعج اذ تقول لي . . . تقدم فشيعنا الي ضحوة الغد فاصبحت مما كان بيني وبينها . . . سوي ذكرها من قابض الماء باليد وانشد ابو الساءب ذلك فقال : ما صنع شيءا ، اكتري حمارا يشيعهم ولا يقول : فواندمي ، واظنه قد كان له عذر ولا يقدر يذكره ، وقال للرجل : ما تقول انت ؟ فقال الرجل : وانا اظنه قد كان له عذر ، قال : وما هو ، قال الرجل : لا ادري ، قال : اظنه قد كان مثلي لا يجد شيءا . الحسين بن الضحاك : من الكامل نفسي الفداء لخاءف مترقب . . . جعل الوداع اشارة بعناق اذ لا جواب لمفحم متحير . . . الا الدموع تصان بالاطراق  المتنبي : من الطويل ولم ار كالالحاظ يوم رحيلهم . . . بعثن بكل القتل من كل مشفق عشية يعدونا عن النظر البكا . . . وعن لذة التوديع خوف التفرق نودعهم والبين فينا كانه . . . قنا ابن ابي الهيجاء في قلب فيلق 
  النوع الخامس في المسرة واللقاء عند الاياب
 قال البحتري : من الطويل وقد ضمنا وشك التلاقي ولفنا . . . عناق علي اعناقنا ثم ضيق فلم نر الا مخبرا عن صبابة . . . بشكوي والا عبرة تترقرق فاحسن بنا والدمع بالدمع واشج . . . يمازجه والخد بالخد ملصق ومن قبل قبل التشاكي وبعده . . . نكاد بها من شدة الوجد نشرق فلو فهم الناس التلاقي وحسنه . . . لحبب من اجل التلاقي التفرق وقال ايضا : من الطويل ولما التقينا والنقا موعد لنا . . . تعجب رامي الدر حسنا ولاقطه فمن لءلء تجلوه عند ابتسامها . . . ومن لءلء عند الحديث تساقطه وقال الاخطل : من الطويل واني واياها اذا ما لقيتها . . . لكالماء من بين الغمامة والخمر وقال عمرو بن حكيم بن معية : من الطويل خليلي امسي حب خرقاء عامدي . . . ففي القلب منه زفرة وصدوع ولو جاورتنا الان خرقاء لم نبل . . . علي جدبنا الا يصوب ربيع 
  النوع السادس في ذكر الطيف والخيال
 من احسن ما قيل في الخيال قول قيس بن الخطيم : من الكامل اني سربت وكنت غير سروب . . . وتقرب الاحلام غير قريب ما تمنعي يقظي فقد تءتينه . . . في النوم غير مصرد محسوب وتبعه البحتري فقال : من الخفيف ما نقضي ليانة عند لبني . . . والمعني بالغانيات معني هجرتنا يقظي وكادت علي مذ . . . هبها في الصدود تهجر وهنا وقال ابو القاسم الحسن بن بشر الامدي : اخطا البحتري في قوله : هجرتنا يقظي ، قال : لان خيالها بتمثل له في كل احوالها ، ايقظي كانت او وسني ؛ قال : والجيد في هذا المعني قوله : من البسيط ارد دونك يقظانا وياذن لي . . . عليك سكر الكري ان جءت وسنانا قال : والذي اوقعه في ذلك قول قيس بن الخطيم ، وكان الاجود ان يقول : ما تمنعي في اليقظة فقد تءتينه في النوم ، اين ما تمنعنيه في يقظتي فقد تءتينه في  حال نومي ، حتي يكون النوم واليقظة منسوبين اليه ، لان خيال المحبوب يتمثل في حال نومه ويقظته جميعا ، الا انه يتسع من التاويل في هذا لقيس ما لا يتسع للبحتري ، لان قيسا قال : فقد تءتءينه في النوم ، ولم يقل : تءتينه ناءمة ، وقد يجوز ان يحمل علي انه اراد ما تمنعي يقظي اي وانا يقظان ، فقد تءتينه في النوم ، اي : في نومي ، ولا يسوغ مثل ذلك في بيت البحتري لانه قال : وسني ، ولم يقل : في الوسن . وقال عمرو بن مالك الجعدي : من الطويل الا طرقتنا ام اوس ودونها . . . من القف اعلام له وجنود فلما انتبهنا للخيال الذي سري . . . اذا الارض قفر والمزار بعيد فقلت لعيني عاودي النوم واهجعي . . . لعل خيالا طارقا سيعود وقال البحتري : من الطويل المت بنا بعد الهدو فسامحت . . . بوصل متي نطلبه في الجد تمنع ورب لقاء لم يءمل ، وفرقة . . . لاسماء لم تحذر ولم تتوقع اسر بقرب من ملم مسلم . . . واشجي بين من حبيب مودع فكاءن لنا بعد النوي من تفرق . . . تزجيه احلام الكري ، وتجمع وقال ايضا : من الطويل واني وان ضنت علي بودها . . . لارتاح منها للخيال المءرق يعز علي الواشين لو يعلمونها . . . ليال لنا نزدار فيها ونلتقي فكم غلة للشوق اطفات حرها . . . بطيف متي يطرق دجي الليل يطرق  اضم عليه جفن عيني تمسكا . . . به عند اجلاء النعاس المرنق وقال ايضا : من الطويل ولم ار مثلينا ولا مثل شاننا . . . نعذب ايقاظا وننعم هجدا وقال ايضا : من الطويل وليلة هومنا علي العيس ارسلت . . . بطيف خيال يشبه الحق باطله فلولا بياض الصبح طال تشبثي . . . بعطفي غزال بت وهنا اغازله وقال العباس بن الاحنف : من الوافر خيالك حين ارقد نصب عيني . . . الي وقت انتباهي لا يزول وليس يزورني صلة ولكن . . . حديث النفس عنك به الوصول وتبعه ابو تمام في هذا المعني فقال : من البسيط زار الخيال بها لا بل ازاركه . . . فكر اذا نام فكر الخلق لم ينم ظبي تقنصته لما نصبت له . . . في اخر الليل اشراكا من الحلم وقال ايضا في المعني : من الخفيف من فما زارك الخيال ولكن . . . انت بالفكر زرت طيف الخيال وقال علي بن يحيي : من المديد  بابي والله من طرقا . . . كابتسام البرق اذ خفقا زارني طيف الحبيب فما . . . زاد ان اغري بي الارقا ومثله لاحمد بن يوسف الكاتب : من الرمل في سبيل الله ود حسن . . . دام من قلبي لوجه حسن وهوي ضيعته في سكن . . . ليس حظي منه غير الحزن يرقد الليل ويستعذبه . . . فاذا استعذبت طيب الوسن زارني منه خيال ما له . . . ارب في غير ان يوقظني وانشد ابو القاسم ابن الفضل لنفسه بيتا الم فيه بهذا المعني وزاد عليه : من البسيط ما زارني طيفه الا موافقة . . . علي الكري ثم ينفيه وينصرف في قوله : موافقة معني لطيف لم اعثر عليه لمن تقدم . 
  النوع السابع في الرقة والنحول
 قال اعرابي : من الطويل ولو ان ما ابقيت مني معلق . . . بعود ثمام ما تاود عودها وقال المجنون : من الطويل الا انما غادرت يا ام مالك . . . صدي اينما تذهب به الريح يذهب وقال المتنبي : من الطويل ولو قلم القيت في شق راسه . . . من السقم ما غيرت من خط كاتب وقال ايضا : من الخفيف حلت دون المزار فاليوم لو زر . . . ت لحال النحول دون العناق وقال العلوي : من البسيط ابقي الهوي فيه جسما كالهواء ضني . . . تنسم الريح فيه وهو مفقود  اتبعتها نفسا تدمي مسالكه . . . كانه من حمي الاحشاء مقدود واشار المتنبي الي النحول فاحسن في قوله : من الكامل امر الفءاد جفونه ولسانه . . . فكتمنه وكفي بجسمك مخبرا وقال ابو الحسن السلامي : من البسيط ما ضن عنك بموجود ولا بخلا . . . اعز ما عنده النفس التي بذلا يحكي المطايا حنينا والهجير جوي . . . والمزن دمعا واطلال الديار بلي وقال الماهر : من الوافر وما ابقي الهوي والشوق مني . . . سوي روح تردد في خيال خفيت علي النواءب ان تراني . . . كان الروح مني في محال وقال ديك الجن : من الهزج كلانا غصن شطب . . . فذا بال وذا رطب اذا ما هبت الريح . . . ومال المرط والاتب ابانت منه ما طاب . . . ومني ما بري الحب وقال ابو عثمان الخالدي : من الطويل بنفسي حبيب بان صبري لبينه . . . واودعني الاحزان ساعة ودعا وانحلني بالهجر حتي لو انني . . . قذي بين جفني ارمد ما توجعا  وقل ابن دريد : من السريع ان الذي ابقيت من جسمه . . . يا متلف الصب ولم تشعر صبابة لو انها دمعة . . . تجول في جفنك لم تقطر 
  النوع الثامن  في البكاء والهمول
 قال ذو الرمة ، وهو قدوة في البكاء علي الطلول : من البسيط ما بال عينك منها الماء ينسكب . . . كانه من كلي مفرية سرب وقال ايضا : من الطويل وما شنتا خرقاء واهيتا الكلي . . . سقي بهما ساق ولما تبللا باضيع من عينيك للدمع كلما . . . تذكرت ربعا او توهمت منزلا وقال ايضا : من الطويل قف العيس في اطلال مية فاسال . . . رسوما كاخلاق الرداء المسلسل اظن الذي يجدي عليك سءالها . . . دموعا كتبديد الجمان المفصل وقال اخر : من البسيط استبق دمعك لا يودي البكاء به . . . واكفف بوادر من عينيك تستبق ليس الشءون وان جادت بباقية . . . ولا الجفون علي هذا ولا الحدق وقال احمد بن يوسف : الكامل عذب الفراق لنا قبيل وداعه . . . ثم اجتدحناه بسم ناقع  وكانما اثر الدموع بخدها . . . طل سقيط فوق ورد يانع وقريب منه قول الناشء الاوسط : من المتقارب بكت للفراق فقد راعني . . . بكاء الحبيب لقرب الديار كان الدموع علي خدها . . . بقية طل علي جلنار ومثله للسري الرفاء : من الوافر وقفنا نحمد العبرات لما . . . راينا البين مذموم السجايا كان خدودهن اذا التقينا . . . شقيق فيه من طل بقايا وهذه كلها ماخوذة من قول البحتري في عكسه لاحمد بن يوسف فانه في عصره متقدم عليهم : من الطويل شقاءق يحملن الندي فكانها . . . دموع التصابي في خدود الخراءد وقال الطاءي : من الكامل ظعنوا فكان بكاي حولا كاملا . . . ثم ارعويت وذاك حكم لبيد اجدر بلوعة جمرة اطفاءها . . . بالدمع ان تزداد طول وقود وقال ايضا : من الكامل نثرت فريد مدامع لم تنظم . . . والدمع يحمل بعض ثقل المغرم وصلت دموعا بالنجيع فخدها . . . في مثل حاشية الرداء المعلم وقال ايضا : من الكامل  مطر من العبرات خدي ارضه . . . حتي الصباح ومقلتاي سماءه احبابه ما يفعلون بقلبه . . . ما ليس يفعله به اعداءه وقال مسلم بن الوليد : من الطويل فاه من الاحزان ان اسفر الضحي . . . وفي كبدي من بينهن حريق مزجنا دما بالدمع حتي كانما . . . يذاب بعيني لءلء وعقيق وقال العباس بن الاحنف : من المتقارب بكت غير انسة بالبكا . . . تري الدمع في مقلتيها غريبا واسعدها بالبكا نسوة . . . جعلن مغيض الدموع الجيوبا وقال ايضا : من الكامل نزف البكاء دموع عينك فاستعر . . . عينا لغيرك دمعها مدرار من ذا يعيرك عينه تبكي بها . . . ارايت عينا للبكاء تعار وقال دعبل : من الكامل المرفل لا ابتغي سقيا السحاب لها . . . في مقلتي خلف من السقيا وقال ابو نواس : من الخفيف لا جزي الله دمع عيني خيرا . . . وجزي الله كل خير لساني من دمعي فليس يكتم شيءا . . . ووجدت اللسان ذا كتمان  كنت مثل الكتاب اخفاه طي . . . فاستدلوا عليه بالعنوان وقال الصولي : من الطويل فلا تنكرن لون الدموع فانها . . . يبيضها تصعيدها من دم القلب ومثله لابي العباس الضبي : من البسيط لا تحسبن دموعي البيض غير دمي . . . وانما نفسي الحامي يصعده وقال البحتري : من الكامل سالت مقدمة الدموع وخلفت . . . حرقا توقد في الحشا ما ترحل ان الفراق كما علمت فخلني . . . ومدامعا تسع الفراق وتفضل الا يكن صبر جميل فالهوي . . . نشوان يحمل فيه ما لا يجمل وقال ايضا : من الوافر وقفنا والعيون مشغلات . . . يغالب دمعها نظر كليل نهته رقبة الواشين حتي . . . تعلق لا يغيض ولا يسيل ونحوه قول ابن طاهر عبيد الله بن عبد الله : من الطويل ولا مقلتي من غامر الماء تنجلي . . . ولا مدمعي من مكمد الوجد يقطر وهذا البيت اجاز به قول الاول ابي حية : من الطويل وقفت كاني من وراء زجاجة . . . الي الدار من فرط الصبابة انظر  فعيناي طورا تغرقان من البكا . . . فاعشي وطورا تحسران فابصر وقال اخر : من الطويل رعي الله عينا من بكاها علي الحمي . . . تجف ضروع المزن وهي حلوب بكت وغدير الحي طام فاصبحت . . . عليه الجمال الحاءمات تلوب وما كنت ادري ان عينا زكية . . . ولا ان ماء المقلتين شروب وقال رجل من بني نهشل : من الطويل الام علي فيض الدموع وانني . . . بفيض الدموع الجاريات جدير ايبكي حمام الايك من فقد الفه . . . واصبر عنها انني لصبور وقال اخر : من الطويل مررنا باعلي الجزع من قلة الحمي . . . علي طلل لم تبق الا معالمه وددت وقد عجنا نحييه ان لي . . . دموع الوري دمع واني ساجمه ابو حبيب المغربي ، وقد ابدع : من البسيط تجري جفوني دماء وهو ناظرها . . . ومتلف القلب وجدا وهو مرتعه اذا بدا حال دمعي دون رءيته . . . يغار مني عليه فهو برقعه 
  النوع التاسع في احماد المواصلة والعناق
 قال البحتري : من البسيط قد اطرق الغادة البيضاء مقتدرا . . . علي الشباب فتصبيني واصبيها في ليلة لا ينال الصبح اخرها . . . علقت بالراح اسقاها واسقيها عاطيتها غضة الاطراف مرهفة . . . شربت من يدها خمرا ومن فيها وقال الحاتمي : من الطويل وعيش كنوار الرياض استرقته . . . اختلاسا واحداث الليالي غوافل لماما واغصان الشبيبة رطبة . . . وماء الصبا في ورد خدي جاءل ويوم كحلي الغانيات سلبته . . . حلي الربي حتي انثني وهو عاطل سبقت اليه الصبح والشمس غضة . . . وصبغ الدجي من مفرق الصبح ناصل ونشوان من خمر الدلال سقيته . . . شمولا فنمت عن هواه الشماءل اذ العيش مخضر الاصاءل ناعم . . . واذ زبرج الدنيا خليل مواصل  وقال ابن الرومي : من الطويل اعانقها والنفس بعد مشوقة . . . اليها وهل بعد العناق تدان كان فءادي ليس يشفي غليله . . . سوي ان يري الروحين يتمزجان وقال ابو فراس ابن حمدان : من الطويل وكم ليلة ماشيت بدر تمامها . . . الي الصبح لم يشعر بامري شاعر ولا ريبة الا الحديث كانه . . . جمان وهي او لءلء متناثر اقول وقد ضج الحلي واشرفت . . . ولم ار منها للصباح بشاءر ايا رب حتي الحلي مما اخافه . . . وحتي بياض الصبح مما احاذر فيا نفس ما لاقيت من لا عج الهوي . . . ويا قلب ما جرت عليك النواظر وقال البحتري : من الخفيف تلك نعم لو انعمت بوصال . . . لشكرنا في الوصل انعام نعم نسيت موقف الجمار وشخصا . . . نا كشخص ارمي الجمار وترمي وقال ايضا : من المتقارب ولم انس ليلتنا في الودا . . . ع لف الصبا بقضيب قضيبا وقال بكر بن خارجة : من البسيط رايت شخصك في ليلي يعانقني . . . كما يعانق لام الكاتب الالفا  وقال ابن المعتز : من السريع كانني عانقت ريحانة . . . تنفست في ليلها البارد فلو ترانا في قميص الدجي . . . حسبتنا في جسد واحد وقال علي بن الجهم : من الطويل سقي الله ليلا ضمنا بعد هجعة . . . وادني فءادا من فءاد معذب فبتنا جميعا لو تراق زجاجة . . . من الراح فيما بيننا لم تسرب وقال ايضا : من الطويل فبتنا معا لا يخلص الماء بيننا . . . الي الصبح دوني حاجب وستور وقال البحتري : من الطويل ولم انسه اذ قام ثاني جيده . . . الي واذ مالت علي ذواءبه عناق يهد الصبر وشك انقضاءه . . . ويذكي الجوي او يسكب الدمع ساكبه وقال اخر : من الطويل فبتنا علي رغم الحسود وبيننا . . . حديث كنشر المسك شيب به الخمر حديث لو ان الميت نوجي ببعضه . . . لاصبح حيا بعد ما ضمه القبر  وقال مزاحم بن الحارث العقيلي : من الطويل فبتنا ندامي ليلة لم نذق بها . . . حراما ولم يبخل بحل ضنينها صفاحا بايمان تري ان مسها . . . شفاء الصدي من علة طال حينها 
  النوع العاشر في شكوي الفراق واحتماله
 قال جميل : من الطويل وما مر يوم مذ تراخت بنا النوي . . . ولا ليلة الا هوي منك رادف اهم بشكوي منك ثم تردني . . . اليك وتثنيني عليك العواطف فلا تحسبن الناي اسلي مودتي . . . ولا ان عيني ردها عنك طارف وقال اخر : من البسيط يا قلب ويحك ما سلمي بذي سلم . . . ولا الزمان الذي قد فات يرتجع اكلما مر ركب لا يلاءمه . . . ولا يبالون ان يشتاق من فجعوا علقتني بهوي منهم فقد جعلت . . . من الفراق حصاة القلب تنصدع لما دنا البين بين الحي واقتسموا . . . حبل النوي وهي في ايديهم قطع جادت بادمعها سلمي وعاجلني . . . وشك الفراق فمن ابكي ومن ادع وقال ذو الرمة : من الطويل نظرت الي اظعان مي كانها . . . مولية ميس تميل ذواءبه  فابديت مني الدمع والدمع كاتم . . . بمغرورق نمت علي سواكبه فلما عرفنا اية البين بغتة . . . وردت لاحداج الفراق ركاءبه ولم يستطع الف لالف تحية . . . من الناس الا ان يسلم حاجبه تراءي لنا ما بين سجفين لمحة . . . غزال احم العين بيض تراءبه وقال قيس بن ذريح ، ويروي لعبد الله بن مصعب الزبيري : من الطويل فان يحجبوها او يحل دون وصلها . . . مقالة واش او وعيد امير فلن يمنعوا عيني من داءم البكا . . . ولن يذهبوا ما قد اجن ضميري وكنا جميعا قبل ان يظهر الهوي . . . بانعم حالي غبطة وسرور فما برح الواشون حتي بدت لنا . . . بطون الهوي مقلوبة لظهور لقد كان حسب النفس لو دام وصلها . . . ولكنما الدنيا متاع غرور وقال ايضا : من الوافر بكيت نعم بكيت وكل الف . . . اذا بانت قرينته بكاها وما فارقت لبني عن تقال . . . ولكن شقوة بلغت مداها وقال ايضا : من الطويل مضي زمن والناس يستشفعون بي . . . فهل لي الي لبني الغداة شفيع يقولون صب بالنساء موكل . . . وما ذاك من فعل الرجال بديع الي الله اشكو امة شقت العصا . . . هي اليوم شتي وهي امس جميع  لعمرك اني يوم جرعاء مالك . . . لعاص لامر المرشدين مطيع ندمت علي ما كان مني ومنكم . . . كما ندم المغبون حين يبيع وقال اخر : من الطويل وكل مصيبات الزمان عرفتها . . . سوي فرقة الاحباب هينة الخطب وقلت لقلبي حين لج به الهوي . . . وكلفني ما لا اطيق من الحب الا ايها القلب الذي قاده الهوي . . . افق لا اقر الله عينك من قلب وقال ابو العباس النامي ، واحسن في قوله : من الخفيف سالت بالفراق صبا وما ين . . . بءها بالفراق مثل خبير هو بين الحشا صدوع وفي الاع . . . ين ماء وجمرة في الصدور وقال علي بن الجهم : من الكامل المرفل فارقتكم واعيش بعدكم . . . ما هكذا كان الذي يجب اني لالقي الناس معتذرا . . . من ان اعيش وانتم غيب وقال ابن المعتز : من الكامل ومتيم جرح الفراق فءاده . . . فالدمع من اجفانه يترقرق هزته فرقة ساعة فكانما . . . في كل عضو منه قلب يخفق وقال ايضا : من الطويل  يقولون لي والبعد بيني وبينها . . . نات عنك ليلي وانطوي سبب القرب فقلت لهم والحب يفضحه البكا . . . لءن فارقت عيني لقد سكنت قلبي يوهمنيك الشوق حتي كانما . . . اناجيك من قرب وان لم تكن قربي وقال ابو العتاهية : من الطويل اما والذي لو شاء لم يخلق النوي . . . لءن غبت عن عيني لما غبت عن قلبي وقال ابن المعتز : من مجزوء الرمل ما ابالي بظنون . . . وعيون اتقيها لي من ذكراك مرا . . . ة اري وجهك فيها وقال اخر : من البسيط ان كنت لست معي فالذكر منك معي . . . يراك قلبي وان غيبت عن بصري العين تبصر من تهوي وتفقده . . . وناظر القلب لا يخلو من النظر وقال الناجم : من الطويل لءن راح عن عيني احمد غاءبا . . . لما هو عن عين الفءاد بغاءب له صورة في القلب لم يقصها النوي . . . ولا تتخطاها اكف النواءب اذا ساءني منه شحوط دياره . . . فضاقت علي في هواه مذاهبي عطفت علي شخص له ، غير نازح . . . منازله بين الحشا والتراءب وكتب المستظهر بالله ابو العباس الي يوسف بن احمد الجزري  وكيله في سفرة سافرها متمثلا : من السريع قلت وقالوا بان احبابه . . . وبدلوه البعد بالقرب والله ما شطت نوي نازح . . . سار عن العين الي القلب وقال البحتري : من الكامل وابي الظعاءن يوم رحن لقد مضي . . . فيهن مجدول القوام قضيفه شمس تالق بالفراق غروبها . . . عنا وبدر والرحيل كسوفه وقال العلوي : من الكامل ولقد نظرت الي الفراق فلم اجد . . . للموت لو فقد الفراق سبيلا ان المصاءب لو تصور ما عدت . . . مترحلا بالبين او مرحولا يا ساعة البين انبري فكانما . . . وصلت بساعات القيامة طولا وقال بعض العرب : من البسيط روعت بالبين حتي ما اراع له . . . وبالمصاءب في اهلي وجيراني لم يترك الدهر لي علقا اضن به . . . الا اصطفاه بناي او بهجران وقال ابن نباتة : من الطويل فزعت الي ياسي فلم اسل عنهم . . . اذا الياس لم يسل المحب فما يسلي تلافيت فيها قسوة الهجر بالبكا . . . وداويت فيها عزة الحب بالذل  عشية استعيدي علي البين مسعدا . . . فينصرني دمعي ويخذلني اهلي فيا بين حل بيني وبين عواذلي . . . اذا لم تحل بين المطية والرحل ويا دمع لا تهتك علي سراءري . . . فلو شءت يوم البين كذبت ما تملي وقال المتنبي : من الكامل كم غر صبرك وابتسامك صاحبا . . . لما راه وفي الحشا ما لا يري قد كنت احذر بينهم من قبله . . . لو كان ينفع حاءنا ان يحذرا وانشد ثعلب : من المنسرح ولت بهم عنك نية قذف . . . غادرت الشعب غير ملتءم واستودعت نشرها الديار فما . . . تزداد طيبا الا علي القدم وقال ابن الحجاج : من الخفيف ان يوم الفراق مذ بعدت في . . . ه وشطت دار الحبيب القريب شرد النوم عن جفوني كما ال . . . لف ما بين مقلتي والنحيب وقال ايضا : من البسيط يا مزعج النوم عن اجفان مغتبق . . . علي السهاد وبالاحزان مصطبح بيني وبينك وعد ليس يخلفه . . . بعد المزار وعهد غير مطرح فما ذكرتك والاقداح داءرة . . . الا مزجت بدمعي باكيا قدحي ولا سمعت بصوت فيه ذكر نوي . . . الا عصبت عليه كل مقترحي وقال ايضا : من البسيط اما الغزال الذي نهوي فقد ظعنا . . . فاستشعر الصبر او مت بعده حزنا  ما لي وللبين لم يترك علي كبدي . . . الفا تقر به عيني ولا سكنا قد كنت اكتم وجدي بعد بينكم . . . فاليوم يا حادي الاظعان قد علنا حمي جفوني الكري شوقا الي سكني . . . يحرك الوجد فينا كلما سكنا وانشد الجاحظ : من الخفيف انا ابكي خوف الفراق لاني . . . بالذي يفعل الفراق عليم 
  النوع الحادي عشر في الارق والسهاد
 وقال ابن الرومي : من المنسرح حارب اجفانه الرقاد فما . . . يسكن من ليله الي سكن لم يخلق الدمع لامرء عبثا . . . الله ادري بلوعة الحزن اساء بي ما اتيت من حسن . . . الي في ما مضي من الزمن منعتني بعدك العزاء به . . . يا ليت ما كان منك لم يكن وقال اخر : من الوافر جفت عيني عن التغميض حتي . . . كان جفونها عنها قصار وقال ابن الحجاج : من البسيط يا من رضيت بها رزقا اعيش به . . . وحدي وليس يفوت المرء ما رزقا اسلمت طرفي الي شوق يعلمه الس . . . هاد فامتحنته كيف قد حذقا نامي هنيءا لعينيك الرقاد فما . . . امسيت اعلم الا الهم والارقا ان فرق الدهر شخصينا مراغمة . . . فثم قلبان لا والله ما افترقا وقال ابن المعتز : الطويل كليني لعين بالدموع شغلتها . . . كما جاد يوما ذو اهاضيب ماطر وقد كنت ارعي النجم انسبها به . . . ولكن جفوني مطرقات سواهر 
  النوع الثاني عشر في تعاطي الصبر والتجلد
 قال غلام من بني فزارة : من الطويل فاعرض كيما يحسب الناس انما . . . بي الهجر لا والله ما بي لك الهجر ولكن اروض النفس امظر هل لها . . . اذا فقدت يوما احبتها صبر وانشد التوزي : من الطويل فلو كنت ادري ان ما كان كاءن . . . هجرتك ايام الفءاد سليم تقاضيك عيناك الدموع كما لنا . . . كما يتقاضاك الديون غريم ولكن حسبت الهجر شيءا اطيقه . . . وما كان لي فيما حسبت عزيم وقال اخر : من الطويل ان اك عن ليلي سلوت فانما . . . تسليت عن ياس ولم اسل عن صبر وان يك عن ليلي غني وتجلد . . . فرب غني نفس قريب من الفقر فيا رب ان اهلك ولم ترو هامتي . . . بليلي امت لا قبر اعطش من قبري  وقال نصيب : من الطويل اهابك اجلالا وما بك قدرة . . . علي ولكن ملء عين حبيبها وما هجرتك النفس يا مي انها . . . قلتك ولكن قل منك نصيبها ولكنهم يا احسن الناس اولعوا . . . بقول اذا ما جيت هذا حبيبها وقالت ظبية الخضرية : من الطويل فلا يفرح الواشون بالهجر ربما . . . اطال الحبيب الهجر والحب ناصح ويغدو النوي بين المحبين والهوي . . . مع القلب مطوي عليه الجوانح وقال ذو الرمة : من الطويل وقد كنت ابكي والنوي مطمءنة . . . بنا وبكم من علم ما البين صانع واشفق من هجرانكم وتشفني . . . مخافة وشك البين والشمل جامع واعمد للامر الذي لا اريده . . . لترجعني يوما اليك الرواجع واهجركم هجر البغيض وحبكم . . . علي كبدي منه شءون صوادع ويروي للمجنون وغيره : من الطويل واحبس عنك النفس والنفس صبة . . . بذكراك والممشي اليك قريب مخافة ان يسعي الوشاة بظنة . . . واكرمكم ان يستريب مريب لقد جعلت نفسي وانت اخترمتها . . . وكنت اعز الناس عنك تطيب ولو شءت لم اغضب عليك ولم يزل . . . لك الدهر مني ما حييت نصيب اما والذي يبلو السراءر كلها . . . ويعلم ما يبلو به ويغيب  لقد كنت ممن تصطفي النفس خلة . . . لها دون خلان الصفاء حجوب وقال الصمة القشيري ، ويروي للاقرع بن وغيره : من الطويل اتبكي علي ليلي ونفسك باعدت . . . مزارك من ليلي وشعباكما معا فما حسن ان تاتي الامر طاءعا . . . وتجزع ان داعي الصبابة اسمعا بكت عيني اليسري فلما زجرتها . . . عن الجهل بعد الحلم اسبلتا معا وقال ابو دهبل : من الطويل ااترك ليلي ليس بيني وبينها . . . سوي ليلة اني اذا لصبور عفا الله عن ليلي الغداة فانها . . . اذا وليت حكما علي تجور ويا عطشي والماء عذب اخوضه . . . ويا وحشتا والمءنسون كثير ويا حسرة في القلب يوم رحيلهم . . . وليلي علي ظهر البعير تسير وقال ابو القاسم ابن المعتمر الزهري : انشدت ابا الساءب ابيات ابي دهبل هذه فقال لي : واباءي ، كنت والله احبك وتثقل علي ، وانا الان احبك وتخف علي وقال ابو عبد الله من الحجاج : من الطويل هجرتك لا ان البعاد افادني . . . سلوا ولا اني بعهدك غادر  ولكن هو الهجر الذي كل كاءن . . . لمدته فيه وان طال اخر غضبت متيم الهشامية علي مولاها علي بن هشام ، فتمادي عتبها فكتب اليها : الادلال الي الاملال ، ورب هجر دعا الي صبر ، وانما سمي القلب قلبا لتقلبه ، ولقد صدق العباس بن الاحنف حيث يقول : من الخفيف لا اراني الا ساهجر من لي . . . س يراني اقوي علي الهجران ملني واثقا بحسن وفاءي . . . ما اضر الوفاء بالانسان قال : فخرجت اليه من وقتها ورضيت عبد الله بن مصعب : من الطويل واني وان قصرت عن غير بغضة . . . لراع لاسباب المودة حافظ وانتظر العتبي واغضي عن القذي . . . الاين طورا مرة واغالظ واني ليدعوني الي الصرم ما اري . . . وابي وتثنيني اليك الحفاءظ وانتظر الاقبال بالود منكم . . . واصبر حتي اوجعتني المغاءظ وجربت ما يسلي المحب من الهوي . . . فاقصرت والتجريب للمرء واعظ ام فروة : من الطويل وما ماء مزن اي ماء تقوله . . . تحدر من غر طوال الذواءب بمنعرج او بطن واد تقابلت . . . عليه رياح المزن من كل جانب  نفي نسم الريح القذي عن متونه . . . فما ان به عيب يكون لشارب باطيب ممن يقصر الطرف دونه . . . تقي الله واستحياء ما في العواقب وقال اخر : من الطويل الا رب هم يمنع النوم برحه . . . اقام كقبض الراحتين علي الجمر وشوق كاطراف الاسنة في الحشا . . . ملكت عليه طاعة الدمع ان يجري 
  النوع الثالث عشر في ذكر العذول والرقيب
 وقال بعض العرب : من الطويل يقولون مجنون بسمراء مولع . . . بنفسي جنون في هوي وولوع اذا امرتني العاذلات بهجرها . . . ابت كبد عما يقلن صديع وكيف اطيع العاذلات وحبها . . . يءرقني والعاذلات هجوع وقال احمد بن سليمان بن وهب ، قال لي ابي : قد عزمت علي معاتبة عمك ، يعني الحسن بن وهب ، في حبه لبنات ، فقد شهر بها وافتضح ، فكن معي واعني عليه ، وكان هواي مع عمي ، فمضيت معه فقال له ابي وقد طال عتابه : يا اخي جعلت فداك الهوي الذ وامتع ، والراي اصوب وانفع ، فقال عمي متمثلا : اذا امرتني العاذلات . . . البيت فالتفت الي ابي ينظر ما عندي فتمثلت : من الطويل واني ليلحاني علي فرط حبها . . . رجال اطاعتهم قلوب صحاءح فنهض ابي مغضبا وضمني عمي اليه وقبلني وانصرفت الي بنات فحدثتها بما  جري وعمي يسمع ، فاخذت العود وغنت : من الوافر يلومك في محبتها رجال . . . لو انهم برايك لم يلوموا وقال ابن الرومي : من الكامل وشكي الشجي من الخلي ملامة . . . وشكي الوفي تلون المذاق فدع المحب من الملامة انها . . . بءس الدواء لموجع مقلاق لا تطفءن جوي بلوم انه . . . كالريح تغري النار بالاحراق وقال الحسن بن هانء : من السريع ما حطك الواشون من رتبة . . . عندي وما ضرك مغتاب كانما اثنوا ولم يعلموا . . . عليك عندي بالذي عابوا وقال محمد بن وهيب الحميري : من المتقارب ونظرة عين تلافيتها . . . غرارا كما نظر الاحول مقسمة بين وجه الحبيب . . . ولحظ الرقيب متي يغفل وقال البحتري : من الطويل ولا بد من واش يتاح علي النوي . . . وقد يجلب الشء البعيد جوالبه  افي كل يوم كاشح متكلف . . . ينم علينا او رقيب نراقبه وقال عبد الله بن المعتز : من الخفيف وابلاءي من محضر ومغيب . . . وحبيب مني بعيد قريب لم ترد ماء وجهه العين الا . . . شرقت قبل ريها برقيب وكان للمراكبي جارية يقال لها مظلومة ، مليحة الوجه يبعثها مع عريب ترقبها ، وكانت اجمل منها ، فقال فيها الشاعر : من الوافر لقد ظلموك يا مظلوم لما . . . اقاموك الرقيب علي عريب ولو اولوك انصافا وعدلا . . . لما اخلوك انت مع الرقيب انتهين المريب عن المعاصي . . . فكيف وانت من شان المريب وكيف يفارق الجاني ذنوبا . . . لديك وانت داعية الذنوب وقال اخر في مثله : من المتقارب فديتك لو انهم انصفوا . . . لما منعوا العين عن ناظريك الم يقراوا ويحهم ما يرو . . . ن من وحي طرفك في مقلتيك وقد جعلوك رقيبا لنا . . . فمن ذا يكون رقيبا عليك  تصدين اعيننا عن سواك . . . وهل تنظر العين الا اليك والجيد في قول الوشاة قول ابي دهبل : من الطويل لقد قطع الواشون ما كان بيننا . . . ونحن الي ان يوصل الحبل احوج هم منعونا ما نحب واوقدوا . . . علينا وشبوا نار صرم تاجج ولو تركونا لا هدي الله هديهم . . . ولم يلحموا قولا من الشر ينسج لاوشك صرف الدهر تفريق بيننا . . . ولا يستقيم الدهر والدهر اعوج واني لمحزون عشية زرتها . . . وكنت اذا ما جءتها لا اعرج فلما التقينا لجلجت في حديثها . . . ومن اية الصد الحديث الملجلج وقال العرجي : من الكامل واطعت فيها الكاشحين فاكثروا . . . فيها المقالة شامتا ومعرضا وسفاهة بالمرء صرم حبيبه . . . يرضي بهجرته العدو المبغضا وقال ذو الرمة : من الطويل وكنت اذا ما جءت ميا مسلما . . . اتوني وفودا بين ساع وجالس غضابا اذا ما جءت ميا ازورها . . . علي الا رغما لتلك المعاطس فانا علي ما يزعم الناس بيننا . . . من الود لا نهوي دني المجالس كلانا ابي ان يقري السوء نفسه . . . وفي النفس للانسان احرس حارس 
  النوع الرابع عشر في وصف المحبوب
 وقال حميد بن ثور الهلالي : من الطويل ولما استقل الحي في رونق الضحي . . . قضينا الوصايا والحديث المكتما من البيض عاشت بين ام عزيزة . . . وبين اب بر اطاب واكرما منعمة لو يدرج الذر ساربا . . . علي جلدها بضت مدارجه دما رقود الضحي لا تقرب الجيزة القصي . . . ولا الجيزة الادنين الا تجشما وقال الاخطل : من الطويل نواعم لم يلقين في العيش ترحة . . . ولا عثرة من حد سوء يزيلها ولو بات يسري الذر فوق جلودها . . . لاثر في ابشارهن محيلها وقال تميم بن ابي بن مقبل : من البسيط وماتم كالدمي حور مدامعها . . . لم تباس العيش ابكارا ولا عونا  شم مخصرة هيف منعمة . . . من كل داء باذن الله يشفينا كانهن الظباء الادم اسكنها . . . ضال بغرة او ضال بدارينا يمشين هيل النقا لانت جوانبه . . . ينهال حينا وينهال الثري حينا من رمل عرنان او من رمل اسنمة . . . جعد الثري بات في الامطار مدجونا يهززن للمشي اوصالا منعمة . . . هز الجنوب ضحي عيدان يبرينا او كاهتزاز رديني تعاوره . . . ايدي التجار فزادوا متنه لينا نازع البابها لبي بمختزن . . . من الاحاديث حتي ازددن لي لينا في ليلة من ليالي الدهر صالحة . . . لو كان بعد انصراف الدهر مامونا وقال سحيم : من الطويل كان الثريا علقت فوق نحرها . . . وجمر غضا هبت له الريح ذاكيا تريك غداة البين كفا ومعصما . . . ووجها كدينار الاعزة صافيا وقال عمرو بن شاس : من الطويل اذا نحن ادلجنا وانت امامنا . . . كفي للمطايا نور وجهك هاديا اليس يزيد العيس خفة اذرع . . . اذا كن حسري ان تكوني اماميا وقال بشر بن عقبة العدوي : من الطويل رايتك فوق الناس يا ام مالك . . . بجملة حسن اخرست من يعيبها  فوالله ما ادري اانت كما اري . . . ام العين مزهو اليها حبيبها وقال اخر : من الطويل احب اللواتي في صباهن غرة . . . وفيهن عن ازواجهن طماح مسرات حب مظهرات عداوة . . . تراهن كالمرضي وهن صحاح وقال ذو الرمة : من البسيط زين الثياب وان اثوابها استلبت . . . فوق الحشية يوما زانها السلب تريك سنة وجه غير مقرفة . . . ملساء ليس بها خال ولا ندب اذا اخو لذة الدنيا تبطنها . . . والبيت فوقهما بالليل محتجب سافت بطيبة العرنين مارنها . . . بالمسك والعنبر الهندي مختضب وقال ايضا : من الطويل اذا نازعتك القول مية او بدا . . . لك الوجه منها او نضا الدرع سالبه فيا لك من خد اسيل ومنطق . . . رخيم ومن خلق تعلل جادبه وقال اخر : من الكامل ابت الروادف والثدي لقمصها . . . مس البطون وان تمس ظهورا واذا الرياح مع العشي تناوحت . . . نبهن حاسدة وهجن غيورا  وقال اخر : من الطويل تاملتها مغترة فكانما . . . رايت بها من سنة البدر مطلعا اذا ما ملات العين منها ملاتها . . . من الدمع حتي انزف الدمع اجمعا وقال اخر : من الكامل بيضاء انسة الحديث كانها . . . قمر توسط جنح ليل مبرد موسومة بالحسن ذات حواسد . . . ان الحسان مظنة للحسد وتري مدامعها ترقرق مقلة . . . سوداء ترغب عن سواد الاثمد وقال تميم بن مقبل : من الطويل الم تر ان القلب ثاب واقصرا . . . وجلي عمايات الشباب وابصرا وبدل حلما بعد جهل ومن يعش . . . يجرب ويبصر شانه ان تبصرا وكنا اجتنينا مرة ثمر الصبا . . . فلم يبق منه الدهر الا تذكرا وعمدا تصدت يوم شاكلة الحمي . . . لتنكا قلبا قد صحا وتوقرا عشية ابدت جيد ادماء مغزل . . . وطرفا يريك الاثمد الجون احورا واسحم مجاج الدهان كانه . . . عناقيد من كرم دنا فتهصرا واشنب تجلوه بعود اراكة . . . ورخصا علته بالخضاب مسيرا فيا لك من شوق بقلب متيم . . . يجن الهوي منها ويا لك منظرا وقال الحسن بن هانء : من السريع لو مس عاد حيا ولم . . . يضمه من بعده قبر  او مر ذر فوق سرباله . . . يوما لادمي جلده الذر وقال ايضا : من الكامل المرفل في مثل وجهك يحسن الشعر . . . ويكون فيه لذي الهوي عذر تتزين الدنيا بطلعته . . . ويكون بدرا حين لا بدر وقال ايضا : من المديد ما هوي الا له سبب . . . يبتدي منه وينشعب فتنت قلبي محجبة . . . برداء الحسن تنتقب خليت والحسن تاخذه . . . تنتقي منه وتنتخب فاكتست منه طراءفه . . . واستزادت فضل ما تهب صار جدا ما مزحت به . . . رب جد جره اللعب وقال ابو ذءيب : من الطويل وان حديثا منك لو تعلمينه . . . جني النحل في البان عود مطافل مطافيل ابكار حديث نتاجها . . . تشاب بماء مثل ماء المفاصل المفاصل : منفصل السهل من الجبل حيث يكون الرضراض ، فالماء الذي يستنقع فيه اطيب ماء .  وقال البحتري : من الكامل ووراء تسدية الوشاة ملية . . . بالحسن تملح في القلوب وتعذب كالبدر الا انها لا تجتلي . . . كالشمس الا انها لا تغرب وقال ايضا من الخفيف ذات حسن لو استزادت من الحس . . . ن اليه لما اصابت مزيدا فهي كالشمس بهجة والقضيب ال . . . غض لينا والريم طرفا وجيدا وقال ايضا : من السريع لا تلحني ان عزني الصبر . . . فوجه من اهواه لي عذر غانية لم اغن عن حبها . . . يقتل في اجفانها السحر ان نظرت قلت بها ذلة . . . او خطرت قلت بها كبر يهتز اعلاها فتعتاقه . . . رادفة يعيا بها الخصر اصبحت لا اطمع في وصلها . . . حسبي ان يبقي لي الهجر وقال ايضا : من الطويل غرير تراءاه العيون كانما . . . اضاء لها من تحت داجية فجر اذا انصرفت يوما بعطفيه لفتة . . . او اعترضت من لحظه نظرة شزر رايت هوي قلب بطء نزوعه . . . وحاجة نفس ليس عن مثلها صبر وقال ايضا : من الوافر  اذا خطرت تارج جانباها . . . كما خطرت علي الروض القبول ويحسن دلها والموت فيه . . . وقد يستحسن السيف الصقيل وقال ايضا : من الطويل ضمان علي عينيك اني لا اسلو . . . وان فءادي من جوي بك لا يخلو الا ان وردا لو يذاد به الصدي . . . وان شفاء لو يصاب به الخبل اطاع لها دل غرير وواضح . . . شتيت وقد مرهف وشوي خدل والحاظ عين ما علقن بفارغ . . . فخلينه حتي يكون له الشغل وقال ايضا : من الطويل واهيف ماخوذ من النفس شكله . . . تري العين ما تختار اجمع فيه ولم تنس نفسي ما سقيت بكفه . . . من الراح الا ما سقيت بفيه وقال ايضا : من البسيط بيضاء اوقد خديها الصبا وسقي . . . اجفانها من سلاف الراح ساقيها في حمرة الورد شكل من تلهبها . . . وللقضيب نصيب من تثنيها قد علمت انني لم ارض كاشحها . . . فيها ولم استمع من قول واشيها وقال ابو تمام : من الكامل عنت له سكن فهام بذكرها . . . اي الدموع وقد بدت لم يجرها  بيضاء يحسب شعرها من وجهها . . . لما بدا او وجهها من شعرها تعطيك منطقها فتحسب انه . . . لجني عذوبته يمر بثغرها واظن حبل وصالها لمحبها . . . اوهي واضعف قوة من خصرها وقال ابن الرومي : من الخفيف وغزال تري علي وجنتيه . . . قطر سهميه من دماء القلوب جرحته العيون فاقتص منها . . . بجوي في القلوب دامي الندوب وقال ايضا : من السريع يا غصنا من لءلء رطب . . . فيه سرور العين والقلب احسن بي يوم ارانيكم . . . وما علي المحسن من عتب وقال ايضا : من الخفيف من جوار كانهن جوار . . . يتسلسلن من مياه عذاب لابسات من الشفوف لبوسا . . . كالهواء الرقراق او كالسراب يءنس الليل ذكرهن فينجا . . . ب وان كان حالك الجلباب عن وجوه كانهن شموس . . . وبدور طلعن غب سحاب سالمتها الانداب وهي من الرق . . . قة اولي الوجوه بالانداب لو تري القوم بينهن لاخبر . . . ت صراحا ولم تقل باكتساب واذا ما تعجب الناس قالوا . . . هل يصيد الظباء غير الكلاب وقال ايضا : من المنسرح يا وجنتيه التين من بهج . . . في صدغيه الذين من دعج  ما حمرة فيكما امن خجل . . . ام صبغة الله ام دم المهج خدان فينا لظي حريقهما . . . ونوره فيهما بلا وهج ما ان تزال القلوب في حرق . . . عليهما والعيون في لجج وقال ايضا : من المنسرح ظبي وما الظبي بالشبيه له . . . في الحسن الا استراقه حوره وحسن اجياده ومقلته . . . ونفرة فيه من رقي السحرة محاسن كلهن مسترق . . . منه وكل راه فاغتفره ولحظ عينين لو ادارهما . . . لفارس في سلاحه اسره وخنث جفنيهما وغنجهما . . . تعلم السحر ماهر السحرة ومضحك واضح به شنب . . . يعرف من شام برقه مطره وصحن خد حريقه ضرم . . . يقذف في القلب داءما شرره اعاره الورد حسن صبغته . . . بل صبغة الورد منه معتصره كانما الله حين صوره . . . خيره دون خلقه صوره يكفيه رعي الخلاء ان له . . . من كل قلب ممنع ثمره وقال ايضا : من الكامل المرفل ومهفهف تمت محاسنه . . . حتي تجاوز منية النفس تصبو الكءوس الي مراشفه . . . وتهش في يده الي الحبس ابصرته والكاس بين فم . . . منه وبين انامل خمس  فكانها وكان شاربها . . . قمر يقبل عارض الشمس وقال ابو فراس ابن حمدان : من الوافر مسء محسن طورا وطورا . . . فما ادري عدوي ام حبيبي يقلب مقلة ويدير لحظا . . . به عرف البرء من المريب وبعض الظالمين وان تباهي . . . شهي الظلم مغتفر الذنوب وقال ابن نباتة : من الطويل وكم بالحمي ودعت من وصل خلة . . . وغانية يناي من القرط جيدها الذ من النيل المعجل وعدها . . . وانفع من وصل الغواني صدودها منعمة يروي من الدمع جفنها . . . ولم يرو من ماء الشبيبة عودها وقال ابن الرومي : من مجزوء الرمل يا شبيه البدر في الحس . . . ن وفي بعد المنال جد فقد تنفجر الصخ . . . رة بالماء الزلال وقال ابو الحسن السلامي : من الطويل وفيهن سكري اللحظ سكري من الصبا . . . تعاتب حلو اللفظ حلو الشماءل ادارت علينا من كءوس حديثها . . . سلافا وغنتنا بصوت الخلاخل  وقال ابو الخطاب الجبلي : من الكامل دمث يكاد من الحياء يذيبه . . . لحظي وليس يلينه استعطافي هيهات تسلي عن هواه ذنوبه . . . ظلم الهوي احلي من الانصاف وقال علي بن جبلة العكوك : من الوافر اغر تولد الشهوات منه . . . فما تعدوه اهواء القلوب وما اكتحلت به عين فتبقي . . . مسلمة الضمير من الذنوب وقال السري الرفاء : من الكامل ضعفت معاقد خصره وعقوده . . . فكان عقد الخصر عقد وفاءه وقال الرشيد في ماردة ام المعتصم : من الكامل المرفل واذا نظرت الي محاسنها . . . فبكل موقع نظرة نبل وتنال منك بحد مقلتها . . . ما لا ينال بحده النصل ولقلبها حلم يباعدها . . . عن ذي الهوي ولطرفها جهل ولوجهها من وجهها قمر . . . ولعينها من عينها كحل وقال عبد الله بن الحجاج : من الكامل ومدلل اما القضيب فقده . . . شكلا واما ردفه فكثيب  يمشي وقد فعل الصبا بقوامه . . . فعل الصبا بالغصن وهو رطيب ارمي مقاتله فتخطي اسهمي . . . غرضي ويرمي مقتلي فيصيب نفسي فداءك ان نفسي لم تزل . . . يحلو فداءك عندها ويطيب ما لي وما لك لا اراك تزورني . . . الا ودونك مانع ورقيب وقال : من السريع فديت من نادمته ليلة . . . ووجهه والكاس مصباحي اجفانه في مجلسي نرجسي . . . وخده وردي وتفاحي مزجت كاسي من جني ريقه . . . بمثل ما فيها من الراح وقال : من السريع يا من اذا قابل شمس الضحي . . . خرت له راكعة ساجده كيف احتيالي في جحودي هوي . . . عيني علي قلبي به شاهده وقال : من السريع فديت انسانا علي وصله . . . وهجره يحسدني الناس لما احتوي الورد علي خده . . . ودب في عارضه الاس مزجت كاسي من جني ريقه . . . بمثل ما دارت به الكاس وقال : من مخلع البسيط وشادن خلقه دليل . . . فينا علي قدرة الحكيم يفعل بالشمس في ضحاها . . . ما تفعل الشمس بالنجوم مر بنا والصباح منه . . . يشرق تحت الدجي البهيم  يعلم الغصن وهو يمشي . . . تثني الغصن في النسيم وقال : من مجزوء الرمل قل لمن ريقته مس . . . ك وشهد ومدام والذي حلل قتلي . . . وهو محظور حرام ايها الناءم عمن . . . عينه ليس تنام كل نار غير ناري . . . فيك برد وسلام انشد ابو حاتم لرجل من كلب : من الطويل لقد منعت برد المقيل وقطعت . . . برمان انفاس المطي صعود قصيرة هم الروح اما شتاءها . . . فسخن واما قيظها فبرود من هاهنا اخذ عمر بن ابي ربيعة قوله فزاد واحسن : من الخفيف سخنة في الشتاء باردة الصي . . . ف سراج في الليلة الظلماء وقال اعرابي : من الوافر منعمة يحار الطرف فيها . . . كان حديثها سكر الشباب من المتصديات لغير سوء . . . تسيل اذا مشت مشي الحباب 
  النوع الخامس عشر في طيب الافواه
 وقال امرء القيس : من المتقارب كان المدام وصوب الغمام . . . وريح الخزامي ونشر القطر يعل به برد انيابها . . . اذا طرب الطاءر المستحر وقال جميل : من الكامل وكان طارقها علي علل الكري . . . والنجم وهنا قد بدا لتغور يستاف ريح مدامة معلولة . . . بذكي مسك او سحيق العنبر وقال اخر : من الطويل كان علي انيابها الخمر شابها . . . بماء الندي من اخر الليل غابق وما ذقته الا بعيني تفرسا . . . كما شيم في اعلي السحابة بارق وقال ابو صعترة البولاني : من الطويل فما نطفة من حب مزن تقاذفت . . . بها جنبتا الجودي والليل دامس  فلما اقرته اللصاب تنفست . . . شمال لاعلي ماءه فهو قارس باطيب من فيها وما ذقت طعمه . . . ولكنني في ما تري العين فارس وقال حرملة بن مقاتل : من الطويل وما ضرب في راس نيق ممنع . . . بتيهاء قد يستنزل العصم نيقها باطيب من فيها وما ذقت طعمه . . . وقد جف بعد النوم للنوم ريقها اذا اعتلت الافواه واستمكن الكري . . . وقد حان من نجم الثريا خفوقها وما ذقت فاها غير شء رجوته . . . الا رب راجي شربة لا يذوقها وقال ابو ذءيب : من الطويل عصاني اليها القلب اني لامره . . . مطيع فما ادري ارشد طلابها اراد ارشد طلابها ام غي فحذف ، وفي الكتاب العزيز : سرابيل تقيكم الحر ولم يقل : وتقيكم البرد ، وعادة العرب الحذف اذا كان فيما بقي دليلا علي ما حذف ، ويرون ذلك من الفصاحة ؛ وقال الشاعر : تمر بها رياح الصيف دوني فقلت لقلبي يا لك الخير انما . . . يدليك للموت الجديد حبابها فاقسم ما ان بالة لطيمة . . . تفتح باب الفارسين بابها ولا الراح راح الشام جاءت سبءية . . . لها راية تهدي الكرام عقابها  عقار كماء ليست بخطمة . . . ولا خلة يكوي الشروب شهابها باطيب من فيها اذا جءت طارقا . . . من الليل والتفت علي ثيابها وقال بشار : من البسيط يا اطيب الناس ريقا غير مختبر . . . الا شهادة اطراف المساويك وقال ابن الرومي : من الطويل وما تعتريها افة بشرية . . . من النوم الا انها تتخثر كذلك انفاس الرياض بسحرة . . . تطيب وانفاس الانام تغير وما ذقته الا بشيم ابتسامها . . . وكم مخبر بيديه للعين منظر وغير عجيب طيب انفاس روضة . . . منورة باتت تراح وتمطر وقال ايضا : من البسيط هي الفتاة اذا اعتلت مفاصلها . . . بالنوم واعتلت الافواه بالسحر طابت هناك لحين لا يطيب له . . . الا الرياض كان ليست من البشر وقال القطامي : من الطويل وما ريح قاع ذي خزامي وحنوة . . . له ارج من طيب النبت عازب  باطيب من فيها اذا ما تقلبت . . . من الليل وسني جانبا بعد جانب وقال جرير : من الطويل سقين البشام المسك حين رشفنه . . . رشيف الغريريات ماء الوقاءع اذا ما رجا الظمان ورد شريعة . . . ضربن حبال الموت دون الشراءع وقال ابن الدمينة : من الطويل وما نطفة صهباء صافية القذي . . . بحجلاء تجري تحت نيق حبابها سقاها من الاشراط ساق فاصبحت . . . تسيل مجاري سيلها وشعابها يحوم بها صاد يري دونها الردي . . . محيطا فيهوي وردها ويهابها باطيب من فيها ولا قرقفية . . . يشاب بماء الزنجبيل رضابها  ا
  لنوع السادس عشر في وصف الثغر
 وقال القطامي : من الطويل منعمة تجلو بعود اراكة . . . ذري برد عذب شنيب المناصب كان فضيضا من عريض غمامة . . . علي ظما جادت به ام غالب وقال اخر : من البسيط كانما ثغرها من حسنه برد . . . مما تهاديه ايدي الريح مصقول كانه اقحوان غب سارية . . . مديم واجهته الريح مشمول وقال مسلم : من الطويل تبسم عن مثل الاقاحي تبسمت . . . له مزنة صيفية فتبسما وقال اخر : من الطويل احاذر في الظلماء ان تستشفني . . . عيون الغياري في وميض المضاحك وقال السمهري : من الطويل وبيضاء مكسال لعوب خريدة . . . لذيذ لدي ليل التمام شمامها  كان وميض البرق بيني وبينها . . . اذا حان من بعض البيوت ابتسامها وقال جميل : من الطويل وقامت تراءي بعد ما نام صحبتي . . . لنا وسواد الليل قد كاد يجلح بذي اشر كالاقحوان يزينه . . . ندي الطل الا انه هو املح 
  النوع السابع عشر في اسرار الهوي واعلانه
 وقال نصيب : من الطويل وما زال كتمانيك حتي كانني . . . برجع جواب الساءلي عنك اعجم لاسلم من قول الوشاة وتسلمي . . . سلمت وهل حي من الناس يسلم وقال الاخطل : من الطويل ولما تلاحقنا نبذنا تحية . . . اليهن فالتذ الحديث اصيلها فكان لدينا السر بيني وبينها . . . ولمع غضيضات العيون رسولها وقال اخر : من الطويل بنفسي الذي ان قال خيرا وفي به . . . وان قال شرا قاله وهو مازح ومن قد رماه الناس حتي اتقاهم . . . ببغضي الا ما تكن الجوانح وقال اعرابي : من الطويل وما بحت يوما بالذي كان بيننا . . . كما يستباح الهذريان المبيح  سوي انني قد قلت و العيس ترتمي . . . بنا عرصات في الازمة جنح هنيءا لمسواك الاراك فانه . . . بخمر ثنايا ام عمرو يصبح وللطوق مجراه وللقرط انه . . . علي نفنف من جيدها يتطوح وقال ابن سماعة الاسدي فيما رواه ابو هلال العسكري : من الطويل بنفسي من لا بد اني هاجره . . . ومن انا في الميسور والعسر ذاكره ومن قد رماه الناس حتي اتقاهم . . . ببغضي الا ما تجن ضماءره احبك يا ليلي علي غير ريبة . . . ولا خير في حب تذم سراءره اكفكف دمعي ان يكون طليعة . . . علي سر نفسي حين ينهل قاطره والبيتان الاولان الاصح انهما ليزيد بن الطءرية من القصيدة طويلة من هذا النوع ، وانا اذكر مستحسنها ومختارها هاهنا لءلا ينقطع : الا يا شفاء النفسي لو يسعف الهوي . . . ونجوي فءاد لا تباح سراءره اثيبي اخا ضارورة اصفق العدي . . . عليه وقلت في الصديق معاذره بنفسي من ان يدن ينفع دنوه . . . وان ينا لا تخر الصديق جراءره ومستخبر عنها ليعلم ما الذي . . . لها في فءادي ود اني احاذره تركت علي عمياء منه ولم اكن . . . اذا ما وشي واش بليلي اناظره اتهجر بيتا بالحجاز تكنفت . . . جوانبه الاعداء ام انت زاءره  فان اته لا انج الا بظنة . . . وان ياته غيري تنط بي جراءره ولا باس بالهجر الذي ليس عن قلي . . . اذا شجرت عند الحبيب شواجره وقد روي شطر هذه الابيات للحسين بن مطير ، ومنها قوله : الا حب بالبيت الذي انت هاجره . . . وانت بتلماح من الطرف زاءره لانك من بيت لعيني معجب . . . واملح في عيني من البيت عامره اصد حياء ان يلج بي الهوي . . . وفيك المني لولا عدو احاذره وفيك حبيب النفس لو تستطيعه . . . لمات هوي والشوق حين تجاوره وكان حبيب النفس للقلب واترا . . . وكيف يحب القلب من هو واتره فان يكن الاعداء احموا كلامه . . . علينا فلم تحمي علينا مناظره احبك حبا لن اعنف بعده . . . محبا ولكني اذا ليم عرذره لقد مات قلبي اول الحب فانقضي . . . ولو مت اضحي الحب قد مات اخره وقال ابن ميادة : من الخفيف يا خليلي هجرا كي تروحا . . . هجتما للرواح قلبا قريحا ان تريغا لتعلما سر سعدي . . . تجداني بسر سعدي شحيحا ان سعدي لمنية المتمني . . . جمعت عفة ووجها صبيحا وقال جميل : من الطويل سامنح طرفي غيركم ان لقيتكم . . . لكي يحسبوا ان الهوي حيث انظر واكني باسماء سواك واتقي . . . زيارتكم والحب لا يتغير  وقال الحسن بن هانء : من الخفيف لابيحن حرمة الكتمان . . . راحة المستهام في الاعلان قد تعزيت بالسكوت وبالاط . . . راق جهدي فنمت العينان تركتني الوشاة نصب المشيري . . . من واحدوثة بكل مكان ما اري خاليين في السر الا . . . قلت ما يخلوان الا لشاني وقال البحتري : من الطويل اذا العين راحت وهي عين علي الجوي . . . فليس بسر ما تسر الاضالع وقال تميم بن ابي بن مقبل : من الطويل لقد طال ما اخفيت حبك في الحشا . . . وفي القلب حتي كاد في القلب يجرح قديما ولم يعلم بذلك عالم . . . وان كان موثوقا يود وينصح فردي فءادي او اثيبي ثوابه . . . فقد يملك المرء الكريم فيسجح سبتك بماشور الثنايا كانه . . . اقاحي غداة بات بالدجن ينضح وقال ابن الدمينة : من الطويل هجرتك اياما بذي الغمر انني . . . علي هجر ايام بذي الغمر نادم هجرتك اشفاقا عليك من الردي . . . وخوف الاعادي واجتناب النماءم واني وذاك الهجر لو تعلمينه . . . كعازبة عن طفلها وهي راءم  فما اعلم الواشين بالسر بيننا . . . ونحن كلانا للمودة كاتم ويستحسن قول ابي الطيب في المعني : من الخفيف واذا خامر الهوي قلب صب . . . فعليه لكل عين دليل واحسن ما قيل في ذلك قول قيس بن ذريح : من الطويل لو ان امرءا اخفي الهوي عن ضميره . . . لمت ولم يعلم بذاك ضمير ولكن سالقي الله والنفس لم تبح . . . بسرك والمستخبرون كثير وقال اخر : من الطويل يقولون ليلي بالمغيب امينة . . . له وهو راع سرها وامينها فان تك ليلي استودعتني امانة . . . فلا وابي ليلي اذا لا اخونها اارضي بليلي الكاشحين وابتغي . . . كرامة اعدءي لها واهينها معاذة وجه الله ان اشمت العدي . . . بليلي وان لم تجزني ما ادينها ساجعل ديني جنة دون دينها . . . وعرضي ليبقي عرض ليلي ودينها 
  النوع الثامن عشر في عشق الحلاءل
 وقال القحيف : من الطويل لقد ارسلت خرقاء نحوي رسولها . . . لتجعلني خرقاء ممن اضلت وخرقاء لا تزداد الا ملاحة . . . ولو عمرت تعمير نوح وجلت وقال ابو الاسود الدءلي : من الطويل ابي القلب الا ام عمرو وحبها . . . عجوزا ومن يحبب عجوزا يفند كسحق اليماني قد تقادم عهده . . . ورقعته ما شءت في العين واليد وقال اخر : من الطويل تقول العدي لا بارك الله في العدي . . . قد اقصر عن ليلي ورثت وساءله ولو اصبحت ليلي تدب علي العصا . . . لكان هوي ليلي جديدا اواءله وقال ابو الوجزة السعدي : من الكامل حتام انت موكل بقديمة . . . امست تجدد كاليماني الجيد زاد الجلال كمالها ووشي بها . . . عقل وفاضلة وشيمة سيد ضنت بناءلها عليك وانتما . . . غران في طلب الشباب الاغيد فالان ترجو ان تثيبك ناءلا . . . هيهات ناءلها مكان الفرقد 
  النوع التاسع عشر في غزل العباد وتساهلهم فيه
 كان عبد الرحمن بن عبد الله بن ابي عمار من بني جشم بن معاوية فقيها عابدا من عباد مكة ، يسمي القس من عباداته ، وكان يشبه بعطاء بن ابي رباح ، وكانت بمكة لسهيل بن عبد الرحمن مغنية محسنة ، فسمعها القس من غير تعمد منه لذلك ، فبلغ غناءها منه كل مبلغ ، فراه مولاها فقال له : هل لك ان تدخل فتسمع ؟ فابي . فقال له مولاها : انا اقعدها تسمع غناءها ولا تراها ولا تراك ، فابي ، فلم يزل به حتي دخل فاسمعه غناءها ، فاعجبته فقال : هل لك ان اخرجها اليك ؟ فابي ، فلم يزل حتي اخرجها ، فاقعدها بين يديه فغنت ، فشغف بها وشغفت به ، وعرف بذلك اهل مكة حتي سميت به ، فصارت تعرف بسلامة القس ، فقالت له يوما : انا والله احبك ، فقال : وانا والله احبك ، قالت واحب ان اضع فمي علي فمك ، قال : وانا والله احب ذلك ، قالت : والصق بطني ببطنك ، قال : وانا والله احب ذلك ، قالت فما يمنعك ؟ فولله ان الموضع لخال ، قال اني سمعت الله عز وجل يقول : الاخلاء يومءذ بعضهم لبعض عدو الا المتقين واني اكره ان تكون خلة ما بيني وبينك تءول الي عداوة . ثم قام فانصرف ، وعاد الي ما كان عليه من النسك . وله فيها اشعار كثيرة فمنها : من الكامل قد كنت اعذل في السفاهة اهلها . . . فاعجب لما تاتي به الايام  فاليوم اعذرهم واعلم انما . . . سبل الضلالة والهدي اقسام ومنها : من الكامل اسلام هل لمتيم تنويل . . . ام هل صرمت ودك غول لا تصرفي عني دلالك انه . . . حسن الي وان بخلت جميل ومنها : من الكامل اسلام انك قد ملكت فاسجحي . . . قد يملك الحر الكريم فيسجح وقال ابو الساءب المخزومي لجرير المغني : ما معك من مرقصات ابن سريج ؟ فغناه شعر بن ابي ربيعة : من الطويل فلم ار كالتجمير منظر ناظر . . . ولا كليالي الحج افتن ذا هوي وكم من قتيل لا ينال به دم . . . ومن غلق رهنا اذا ضمه مني وكم مالء من عينيه من شء غيره . . . اذا راح نحو الجمرة البيض كالدمي يسحبن اذيال المروط باسوق . . . خدال واعجاز ماكمها روي اوانس يسلبن الحليم فءاده . . . فيا طول ما شوق ويا حسن مجتلي قال ابو الساءب : كما انت حتي اتحرم لهذا بركعتين وحدث بعضهم قال : انشدت ابا الساءب المخزومي قول قيس بن  ذريح ، هكذا وفي الخبر الصحيح ان الابيات لعبيد الله بن عتية بن مسعود : من الوافر صدعت القلب ثم ذررت فيه . . . هواك فليم فالتام الفطور تغلغل حيث لم يبلغ شراب . . . ولا حزن ولم يبلغ سرور فصاح بجارية له سندية تسمي زبدة : اي زبدة عجلي ، فقالت : اني اعجن ، فقال لها : ويحك تعالي ودعي العجين ، فجاءت ، فقال لها انشدي بيتي قيس ، فاعادتهما فقال لها : يا زبدة احسن قيس ، والا فانت حرة ، ارجعي الان الي عجينك ، ادركيه لا يبرد . وكان عبيد الله هذا فقيها عالما ورعا ، وهو احد الفقهاء المشهورين ، وهو اذي قال فيه عمرو بن عبد العزيز رضي الله عنه : وددت ان لي ليلة من عبيد الله بالف دينار من بيت المال ، فقيل له يا امير المءمنين : مثلك يقول هذا مع تخوفك ! فقال : انكم لا تدرون ، اني ارجع منه باضعاف ذلك فيما انتفع به منه او نحو هذا الكلام . وكان عبيد الله مع هذا غزلا وله اشعار معروفة رقيقة في النسيب ، فمن ذلك قوله : من الطويل الا من لنفس ما تموت فينقضي . . . عناها ولا تحيا حياة لها طعم ااترك اتيان الحبيب تاثما . . . الا ان هجران الحبيب هو الاثم فذق هجرها قد كنت تزعم انه . . . رشاد الا يا ربما كذب الزعم ومنه قوله : من الطويل  لعمري لءن شطت بعثمة دارها . . . لقد كدت من وشك الفراق اليح اروح بهم ثم اغدو بمثله . . . وتحسب اني في الثياب صحيح وقال ابو الزناد : قدمت المدينة امراة من هذيل ، وكانت جميلة فرغب الناس فيها ، فخطوبها وكادت تذهب بعقول اكثرهم ، فقال عبيد الله ابن عبد الله : من الطويل احبك حبا لا يحبك مثله . . . قريب ولا في العاشقين بعيد احبك حبا لو شعرت ببعضه . . . لجدت ولم يصعب عليك شديد وحبك يا ام الصبي مدلهي . . . شهيدي ابو البكر فنعم شهيد ويعرف وجدي قاسم بن محمد . . . وعروة ما القي بكم وسعيد ويعلم ما اخفي سليمان علمه . . . وخارجة يبدي بنا ويعيد ابو بكر : عبد الرحمن بن الحارث بن هشام ، والقاسم بن محمد بن ابي بكر ، وعروة بن الزبير ، وسعيد بن المسيب بن حزن ، وسليمان بن يسار مولي ميمونة بنت الحارث الهلالية ، وخارجة بن زيد بن ثابت ، وسابعهم عبيد الله قاءل الابيات ، هم الفقهاء السبعة ، فقهاء المدينة الذين اخذ عنهم الراي والسنن . قال الخليل بن سعيد : مررت بسوق الطير فاذا الناس يركب بعضهم بعضا ، فاذا ابو الساءب المخزومي قاءم علي غراب يباع وهو اخذ طرف رداءه ، وهو يقول للغراب : ايقول لك قيس بن ذريح : من الطويل الا يا غراب البين قد طرت الذي . . . احاذر من لبني فهل انت واقع ثم لا تقع ؟ ! ثم يضربه برداءه والغراب يصيح ، قال : فقال له قاءل : يا ابا  الساءب ليس هذا ذاك الغراب ، فقال : قد علمت ، ولكني اخذ البء حتي يقع النطف . وكان ابو الساءب هذا مع زهده وعفافه مشغوفا بالغزل والغناء ، وكضلك كان ابن ابي عتيق كلمته التي يقول فيها : من الطويل ولست براض من خليل بناءل . . . قليل ولا ارضي له بقليل فقال له هذا كلام مكافء ليس بعاشق ؛ القرشيان اصدق واقنع منك ، ابن ابي ربيعة حيث يقول : من الخفيف ليس حظي كطرفة العين منها . . . وكثير منها القليل المهنا وقوله : من الخفيف فعدي ناءلا وان لم تنيلي . . . انه ينفع المحب الرجاء وابن قيس الرقيات حيث يقول : من الوافر رقي بعيشكم لا تصرمينا . . . ومنينا المني ثم امطلينا عدينا من غد ما شءت انا . . . نحب وان مطلت الواعدينا وذكر ذلك لابي الساءب المخزومي ومعه ابن المولي فقال : صدق ابن ابي عتيق وفقه الله ، الا قال المديون كثير كما قال هذا حين يقول : من الطويل وابكي فلا ليلي بكت من صبابة . . . لباك ولا ليلي لذي الود تبذل  واخنع بالعتبي اذا كنت مذنبا . . . وان اذنبت كنت الذي اتنصل نظر ابو الحازم المدايني ، وكان من اعبد النس وازهدهم ، الي امراة تطوف بالبيت مسفرة احسن خلق الله تعالي وجها ، فقال : ايتها المراة اتقي الله ، لقد شغلت الناس عن الطواف ، فقالت : اما تعرفني ؟ قال : من انت ؟ فقالت : من الطويل من اللاءي لم يحججن يبغين حسبة . . . ولكن ليقتلن البرء المغفلا فقال : اني اسال الله ان لا يعذب هذا الوجه الحسن بالنار ، فبلغ ذلك سعيد بن المسيب فقال رحمه الله : اما لو كان بعض عباد العراق لقال : اغربي يا عدوة الله ، ولكنه ظرف عباد اهل الحجاز . قال ساءب راوية كثير : قال لي كثير يوما ونحن بالمدينة : اذهب بنا الي ابن ابي عتيق نتحدث معه ، فذهبت اليه معه ، فاستنشده ابن ابي عتيق فانشد قوله : من الطويل اباءنة سعدي نعم ستبين حتي بلغ الي قوله : واخلفن ميعادي وخن امانتي . . . وليس لمن خان الامانة دين قال ابن ابي عتيق : اعلي الامانة تبعتها ؟ فانكف واستعضب نفسه وصاح وقال :  كذبن صفاء الود يوم محله . . . وادركني من عهدهن رهون فقال ابن ابي عتيق : ويحك فذاك املح لهن وادعي للقلوب اليهن ؛ سيدك ابن قيس الرقيات كان اعلم منك واوضع للصواب موضعه فيهن ، اما سمعت قوله : من المديد حب ذاك الدل والغنج . . . والتي في طرفها دعج والتي ان حدثت كذبت . . . والتي في وعدها خلج وتري في البيت صورتها . . . مثل ما في البيعة السرج خبروني هل علي رجل . . . عاشق في قبلة حرج فسكن كثير واستحلي ذلك وقال : لا ان شاء الله ، ن فضحك ابن ابي عتيق حتي ذهب به . ولابي الساءب في ابن ابي عتيق في هذا الفن اخبار كثيرة كرهت الاطالة في ايرادها . وروي ان سعيد ابن المسيب ، وهو من العلم بالمكان المشهور ، مر في بعض ازقة مكة ، فسمع الاخضر الحربي يتغني في دار العاص بن واءل ، والشعر لمحمد بن عبد الله النميري : من الطويل تضوع مسكا بطن نعمان اذ مشت . . . به زينب في نسوة عطرات فضرب برجله فقال : هذا والله مما يلذ استماعته ثم قال : وليست كاخري وسعت جيب درعها . . . وابدت بنان الكف للجمرات وعلت بنان المسك وحفا مرجلا . . . علي مثل بدر لاح في الظلمات وقامت تراءي يوم جمع فافتنت . . . برءيتها من راح من عرفات  فكانوا يرون ان هذا الشعر لسعيد بن المسيب . انشد انسان قول الاحوص : من البسيط سقيا لربعك من ربع بذي سلم . . . وللزمان به اذ ذاك من زمن اذ انت فينا لمن ينهاك عاصية . . . واذ اجر اليكم سادرا رسني فوثب ابو عبيدة بن عمار بن ياسر قاءما ثم ارخي رداءه ومضي يمشي علي تلك الحال ويجره حتي بلغ العرض ثم رجع ، وكان ذلك بمحضر ابراهيم بن هشام المخزومي ، وهو والي المدينة ، فقال ابراهيم حين جلس ابو عبيدة : ما شانك ؟ فقال : ايها الامير : اني سمعت هذا البيت مرة فاعجبني ، فحلفت الا اسمعه الا جررت رسني . لقد منعت معروفها ام جعفر . . . واني الي معروفها لفقير حتي انتهيت الي قوله : ازور علي ان لست انفك كلما . . . اتيت عدوا بالبنان يشير فاعجبه ذلك وطرب وقال : اتدري يا ابن اخي كيف كانوا يقولون ؟ قلت : لا ، قال : كانوا يقولون : الساعة دخل ، الساعة خرج ، الساعة مر ، الساعة رجع ، وجعل يومء بابهامه الي وراء منكبيه ، وسبابته الي حيال وجهه ، ويقبلها ، يحكي ذهابه ورجوعه .  وسمع ابو الساءب رجلا ينشد قول ابي دهبل : من الطويل اليس عظيما ان نكون ببلدة . . . كلانا بها ثاو ولا نتكلم فقال له قف يا حبيبي ، فوقف ، فصاح بجارية له : يا سلامة اخرجي ، فخرجت ، فقال له : اعد بابي انت البيت ، فاعاده ، فقال : بلي والله انه لعجيب عظيم والا فسلامة حرة لوجه الله ، اذهب فديتك مصاحبا ، ثم دخل وجعلت الجارية تقول : ما لقيت منك ، لا تزال تقطعني عن شغلي فيما لا ينفعك ولا ينفعني . قال عروة بن عبد الله بن عروة بن الزبير : جاءني ابو الساءب المخزومي يوما فسلم وجلس الي ، فقلت له بعد الترحيب به : الك حاجة يا ابا الساءب قال : وكما تكون الحاجة ، ابيات لعروة بن اذينة ، بلغني انك سمعتها منه ، قلت : اي ابيات ، قال : وهل يخفي القمر ؟ قوله : من الكامل ان التي زعمت فءادك ملها فانشدته اياها فلما بلغت الي قوله : فقلت لعلها قال : احسن والله ، ما يروم هذا الا اهل المعرفة والفضل ، هذا والله الصادق الود ، الداءم العهد ، لا الهذلي الذي يقول : من الكامل ان كان اهلك يمنعونك رغبة . . . عني فاهلي بي اضن وارغب لقد عدا الاعرابي طوره ، واني لارجو ان يغفر الله لابن اذينة في طلب العذر لها ، وحسن الظن بها ، فدعوت له بطعام فقال : لا والله حتي اروي هذه الابيت ، فلما رواها وثب ، فقلت له : كما انت يغفر الله لك حتي تاكل ، فقال : والله ما  كنت لاخلط بمحبتي لها واخذي اياها غيرها ، وانصرف . وكان ابو الساءب واقفا علي راس بءر فاشده ابن جندب : من الكامل غيضن من عبراتهم وقلن لي . . . ماذا لقيت من الهوي ولقينا فرمي بنفسه في البءر بثيابه فبعد لاي ما اخرجوه 
  النوع العشرون في اخبار من قتله الكمد
 ممن له ذلك الصمة بن عبد الله القشيري وكان يهوي ابنة عم له فخطبها الي عمه ، فاشتط عليها في المهر ، فسال اباه ان يعاونه ، وكان كثير المال ، فلم يعنه بشء ، فسال عشيرته فاطاعوه ، فاتي عمه بالابل ، فقال له : لا اقبل هذه في مهر ابنتي ، فسل اباك ان يبدلها لك ، فسال اباه فابي عليه ، فلما راي فعلهما قطع عقلها وخلاها ، فعاد كل بعير منها الي الافه ، وتحمل الصمة راحلا ، فقالت له ابنة عمه حين راته : تالله ما رايت كاليوم رجلا باعته عشيرته بابعرته ، ومضي لوجهه حتي لحق بثغر الديلم ، فمات به كمدا وقال : من الطويل اتبكي علي ريا ونفسك باعدت . . . مزارك من ريا وشعباكما معا وحدث رجل من اهل طبرستان قال : بينا انا امشي في ضيعة لي فيها الوان من الفاكهة والزعفران وغير ذلك من الاشجار اذا انا بانسان في البستان مطروح عليه اثواب خلقان ، فدنوت منه فاذا هو يتحرك ولا يتكلم ، فاصغيت اليه فاذا هو يقول بصوت خفي : من الطويل  تعز بصبر لا وجدك لا تري . . . بشام الحمي احدي الليالي الغوابر كان فءادي من تذكره الحمي . . . واهل الحمي يهفو به ريش طاءر فما زال يردد هذين البيتين حتي فاضت نفسه ، فسالت عنه ، فقيل لي : هذا الصمة بن عبد الله القشيري . وقال بعض بني عقيل : مررت بالصمة يوما وهو وحده جالس يبكي ويخاطب نفسه ويقول : لا والله ما صدقتك فيما قالت ، ن قلت : من تعني بهذا ويحك ؛ اجننت ؟ قال اعني التي اقول فيها : من الطويل اما وجلال الله لو تذكرينني . . . كذكراك ما كفكفت للعين مدمعا فقالت : بلي وجلال الله ذكرا لو انه . . . يصب علي صم الصفا لتصدعا اسلي نفسي واخبرها انها لو ذكرتني كما قالت لكانت في مثل حالي . وقال محمد بن معن الغفاري : اقحمت السنة ناسا من الاعراب ، فخلوا المذار وابرقوا ، واذا غلام منهم قد صار جلدا وعظما ، فرفع عقيرته يتغني بابيات وهي : من الطويل الا يا سنا برق علي قلل الحمي . . . لهنك من برق علي كريم لمعت اقتداء الطير والقوم هجع . . . فهيجت احزانا وانت سليم فبت بحد المرفقين اشيمه . . . كاني لبرق بالنسار رحيم فهل من معير طرف عين خلية . . . فانسان طرف العامري كليم رمي قلبه البرق اليماني رمية . . . بذكر الحمي وهنا فكاد يهيم  فقلت : يا غلام ، دون ما بك ما يفحم عن الشعر ، قال : اجل ، ولكن البرق انطقني ، فما مكث يومه حتي مات . وممن روي انه مات كمدا كعب بن مالك المعروف بالمخبل ، وهو من بني لاي بن شماس ، وكان عنده ابنة عم له يقال لها : ام عمرو ، وكان اليها ماءلا ، وبها معجبا ، فنظر اليها متجردة من ثيابها ، فقال لها : يا ام عمرو هل تعرفين اجمل منك واكمل ؟ قالت : نعم اختي ميلاء ، قال لها : فاني اشتهي ان اراها ، فقالت : ان علمت بمكانك لم تجء ، ولكني احتال واحضرها ، ففعلت ذلك ، فلما حضرت وراها علقها وغلبت علي قلبه ، ووجدت هي به كوجده بها ، فاخبرت ام عمرو بشانهما ، وصادفتهما وهما يتحدثان ، فانصرفت الي اخوتها ، وهم سبعة ، فقالت : اما ان تزوجوا هذا الرجل من ميلاء وتفرقوا بيني وبينه ، واما ان تغيبوها عني ، فلما وقف علي ذلك هرب الي الشام وانشا يقول : من الطويل افي كل يوم انت من بارح الهوي . . . الي الشم من اعلام ميلاء ناظر وكان مقيما بالحجاز ، فروي هذا البيت رجل من اهل الشام ثم خرج الشامي الي الحجاز لحاجة له فاجتاز بام عمرو وميلاء ، فاستدل ام عمرو علي الطريق فقالت : يا ميلاء صفي له الطريق ، فلما سمع ذكر ميلاء ذكر الاعرابي ، وانشد البيت الذي اخذه عنه ، فارتاحت ميلاء ورحبت بالرجل وقالت له : اجلس حتي يجء اخوتي فيكرموك ويقفوك علي الطريق ، فلما جاءوا واخبرتهم ميلاء بما سمعت منه ، وقد كانوا يحبون ان يعرفوا خبر كعب ، فعرفهم انه نزل عليه وسمع هذا الشعر منه وشعرا اخر ، فقالوا انشدناه ، فانشدهم : من الطويل  خليلي قد رضت الامور وقستها . . . بنفسي وبالفتيان كل مكان فلم اخف لوما للصديق ولم اجد . . . خليا ولا ذا البث يستويان من النس انسانان ديني عليهما . . . مليان لولا الناس قد قضياني منوعان ظلامان لا ينصفانني . . . بدلهما والحسن قد خلباني خليلي اما ام عمرو فمنهما . . . واما عن الاخري فلا تسلاني بلينا بهجران ولم نر مثلنا . . . من الناس انسانين يهتجران اشد مصافاة وابعد عن قلي . . . واعصي لواش حين يكتنفان يبين طرفانا الذي في ضميرنا . . . اذا استعجمت بالمنطق الشفتان فوالله ما ادري ، اكل ذوي الهوي . . . علي ما بنا ام نحن مبتليان وكنا كريمي معشر حم بيننا . . . هوي فحظناه بكل صيان نذود النفوس الحاءمات عن الهوي . . . وهن باعناق اليه ثوان فاكرموا الرجل ، ووقفوه علي الطريق ، وخرجوا الي الشام الي كعب بن مالك فاقدموه ، فلما دخل الحي جلس ناحية فراي مجمعا للحي وغليما ، فدعا الغليم فقال له : من ابوك ؟ قال كعب بن مالك ، وقد كان خلف ابنه صغيرا فعرفه ، فقال : ما هذا الجمع ؟ فقال : لخالتي ميلاء ماتت الساعة ، فراعه ذلك وقام منه وقعد ، وشهق شهقة مات ، فدفنت ميلاء ثم دفن الي جانب قبرها . وممن نسب الي العشق ومات كمدا محمد ابن داود الاصفهاني صاحب المذهب . روي عن ابي عبد الله ابراهيم بن محمد بن عرفة النحوي نفطويه ، قال : دخلت علي محمد بن داود في مرضه الذي مات فيه ، فقلت له :  كيف تجدك ؟ قال : حب من تعلم اورثني ما تري ، فقلت : ما منعك عن الاستمتاع به مع القدرة عليه ؟ فقال : الاستمتاع علي وجهين ، احدهما النظر المباح ، والثاني اللذة المحظورة ، اما النظر المباح فاورثني ما تري ، واما اللذة المحظورة فانه منعني عنها ما حدثني ابي قال ، حدثنا سويد بن سعيد قال ، حدثنا علي بن مسهر عن ابي يحيي القتات عن مجاهد عن ابن عباس عن النبي صلي الله عليه وسلم انه قال : من عشق وكتم وعف وصبر غفر الله له وادخله الجنة . ثم انشد لنفسه : من البسيط انظر الي السحر يجري من لواحظه . . . وانظر الي دعج في طرفه الساجي وانظر الي شعرات فوق عارضه . . . كانهن نمال دب في عاج وانشد لنفسه : من الخفيف ما لهم انكروا سوادا بخدي . . . ه ولا ينكرون ورد الغصون ان يكن عيب خده بدء ذا الشع . . . ر فعيب العيون شعر الجفون فقلت له : نفيت القياس في الفقه واثبته في الشعر ، فقال : غلبة الهوي وملكة النفوس دعوا اليه ، قال : ومات من ليلته ، او في اليوم الثاني . ومنهم حبيشة بنت حبيش احدي بني عامر بن عبد مناة بن كنانة كانت تهوي ابن عمها عبد الله بن علقمة ويهواها ، تواردا في الهوي وهما طفلان ، وبعث الرسول صلي الله عليه وسلم خالد بن الوليد الي بني عامر بن عبد مناة وامره ان يدعوه الي الاسلام ، فان اجابوه والا قاتلهم ، فصبحهم خالد بالغميصاء وقد سمعوا به فخافوه ، وكانوا قتلوا اخاه الفاكه بن الوليد ، وعمه الفاكه بن المغيرة في الجاهلية ، وكانوا من اشد حي في كنانة باسا ، كانوا يسمون لعقة الدم ، فلما  صبحهم ومعه بنو سليم ، وكانت بنو سليم تطلبهم بمالك بن خالد بن صخر الشريد واخوته كرز وعمرو الحارث ، وكانوا قتلوهم في موطن واحد ، فلما صبحهم خالد في ذلك اليوم ، وراوا معه بنو سليم زادهم دلك نفورا ، فقال لهم خالد : اسلموا ، فقالوا : نحن قوم مسلمون ، قال : فالقوا سلاحكم وانزلوا ، قالوا : لا والله ما نلقي سلاحنا ، ولا نحن لك ولا لمن معك امنين ، قال خالد : فلا امان لكم الا ان تنزلوا ، فنزلت فرقة منهم فاسرهم ، وتفرق بقية القوم فرقتين ، فاصعدت فرقة وسفلت اخري ، فبعث خالد جندا في اثر ظعن مصعدة يسوق بهن فتية ، فقال : ادركوا اولءك ؛ فخرجوا في اثرهم ، فلما ادركوهم وقف لهم غلام شاب علي الطريق ، فجعل يقاتل ويرتجز ويقول : من الرجز ارخين اذيال المروط وارتعن . . . مشي حييات كان لم يفزعن ان يمنع اليوم نساء تمنعن فقاتلهم قليلا فقتلوه ومضمر حتي لحقوا الظعن ، فخرج اليهم غلام كانه الاول فجعل يقاتلهم ويقول : من الرجز اقسم ما ان خادر ذو لبده . . . يدرم بين ايكة ووهده يفرس ثنيان الرجال وحده . . . باصدق الغداة منا نجده فقتلوه فادركوا الظعن فاخذوهن ، فاذا فيهن غلام وضء به صفرة في لونه كالمنهوك ، ربطوه بحبل وقدموه ليقتلوه ، فقال لهم : هل لكم في خير ؟ قالوا : وما هو ؟ قال : تدركون بي الظعن اسفل الوادي ثم تقتلوني ، فلما كان بحيث يسمعهن الصوت نادي باعلي صوته : اسلمي حبيش عند نفاد العيش ، فاقبلتعليه جارية حسناء بيضاء وقالت : وانت فاسلم علي كثرة الاعداء وشدة البلاء ،  قال سلام عليك دهرا ، وان بنت عصرا ، قالت : وانت سلام عليك عشرا وشفعا تتري ، وثلاثا وترا فقال : من الطويل ان يقتلوني يا حبيش فلم يدع . . . هواك لهم مني سوي غلة الصدر فقالت : من الطويل وانت فلا تبعد فنعم اخو الهوي . . . جميل العفاف والمودة في ستر وقال لها : من الطويل الم يك حقا ان ينول عاشق . . . تكلف ادلاج السري والوداءق فقالت : بلي والله فقال : فلا ذنب لي قد قلت اذ نحن جيرة . . . اثيبي بود قبل احدي الصفاءق اثيبي بود قبل ان تشحط النوي . . . ويناي الخليط بالحبيب المفارق قال : فضربوا عنقه ، فتقتحم الجارية من خدرها حتي اهوت نحوه فالتقمت فاه ، فنزعوا منها راسه ، وانها لتنشع بنفسها حتي ماتت مكانها . وروي ان رسول الله صلي الله عليه وسلم ودي القتلي ، بعث عليا عليه السلام فوداهم ، قال علي عليه السلم : قدمت عليهم فقلت لهم : هل لكم ان تقبلوا هذا بما اصيب منكم من القتلي والجرحي ، وتحللوا رسول الله قالوا : نعم ، فقلت لهم : هل لكم في ان تقبلوا الثاني بما دخلكم من الروع والفزع ؟ قالوا : نعم ، فقلت لهم : فهل لكم في ان تقبلوا الثالث وتحللوا رسول الله صلي الله عليه وسلم مما علم ومما لم يعلم ؟ قالوا : نعم ،  فدفعته اليهم ، وجعلت اديهم ، حتي اني لادي ميلغ الكلب ، وفضلت فضلة فدفعتها اليهم ، فقال رسول الله صلي الله عليه وسلم : اقبلوها ؟ قال : نعم ، قال : فوالذي انا عبده لهي احب الي من حمر النعم . روي ان رجلا من بني تميم يقال له الخضر ، ابق له غلامان قال : فخرجت في طلبهما وانا علي ناقة لي عيساء كوماء اريد اليمامة ، فلما صرت في ماء لبني حنيفة يقال له الصرصران ، ارتفعت سحابة فرعدت وبرقت وارخت عزاليها ، فعدلت الي بعض ديارهم ، وسالت القري فاجابوا . فدخلت دارا لهم ، وانخت الناقة وجلست تحت ظلة لهم من جريد النخل ، وفي الدار جويرية لهم سوداء ، اذ دخلت جارية كانها سبيكة فضة ، وكان عينيها كوكبان دريان ، فسالت الجارية : لمن هذه العيساء ؟ تعني ناقتي ، فقيل : لضيفكم هذا ، فعدلت الي وقالت : السلام عليكم ، فرددت عليها السلام ، فقالت لي : ممن الرجل ؟ فقلت : من بني حنظلة ، فقالت : من ايهم ؟ فقلت : من بني نهشل ، فتبسمت وقالت : انت اذن ممن عناه الفرزدق بقوله : من الكامل ان الذي سمك السماء بني لنا . . . بيتا دعاءمه اعز واطول بيتا بناه لنا المليك وما بني . . . ملك السماء فانه لا ينقل بيتا رزارة محتب بفناءه . . . ومجاشع وابو الفوارس نهشل قال فقلت : نعم جعلت فداك ، واعجبني ما سمعت منها ، فضحكت وقالت : فان ابن الخطفي قد هدم عليكم بيتكم هذا الذي فخرتم به حيث يقول : من الكامل اخزي الذي رفع السماء مجاشعا . . . وبني بناء بالحضيض الاسفل  بيتا يحمم قينكم بفناءه . . . دنسا مقاعده خبيث المدخل قال : فوجمت ، فلما رات ذلك في وجهي قالت : لا عليك ، فان الناس يقال فيهم ويقولون ، ثم قالت : اين تءم ؟ قلت : اليمامة ، فتنفست الصعداء ثم قالت : هاهي تلك امامك ثم انشات تقول : من الوافر تذكرني بلادا خير اهلي . . . بها اهل المروءة والكرامه الا فسقي الاله اجش صوبا . . . يسح بدره بلد اليمامه وحيا بالسلام ابا نجيد . . . فاهل للتحية والسلامه قال : فانست بها وقلت : اذات خدن ام ذات بعل ؟ فانشات تقول : من الوافر اذا رقد النيام فان عمرا . . . تءرقه الهموم الي الصباح تقطع قلبه الذكري وقلبي . . . فلا هو بالخلي ولا بصاح سقي الله اليمامة دار قوم . . . بها عمرو يحن الي الرواح فقلت لها : من عمرو هذا ؟ فانشات تقول : من الوافر سالت ولو علمت كففت عنه . . . ومن لك بالجواب سوي الخبير فان تك ذا قبول ان عمرا . . . هو القمر المضء المستنير وما لي بالتبعل مستراح . . . ولو رد التبعل لي اسيري قال : ثم سكتت سكتة كانها تسمع الي كلام ، ثم تهافتت وانشات تقول : يخيل لي هيا عمرو بن كعب . . . بانك قد حملت علي سرير يسير بك الهوينا القوم لما . . . رماك الحب بالغلق العسير فان تك هكذا يا عمرو اني . . . مبكرة عليك الي القبور  ثم شهقت شهقة ميتة ، فقلت لهم : من هذه ؟ فقالوا : عقيلة بنت الضحاك بن عمرو بن محرق بن النعمان بن المنذر ، فقلت لهم : فمن عمرو هذا ؟ قالوا : ابن عمها عمرو بن كعب بن محرق بن النعمان بن المنذر ، فارتحلت من عندهم ، فلما دخلت اليمامة سالت عن عمرو هذا ، فاذا هو قد دفن في ذلك الوقت الذي قالت فيه ما قالت . قال عكرمة : اني لمع ابن عباس بعرفة اذا فتية ادمان يحملون فتي في كساء معروق الوجه ناحل البدن احلي من رايت من الفتيان ، حتي وضعوه بين يدي ابن عباس وقالوا له : استشف له يا ابن عم رسول الله ، فقال : ابن عباس : وما به ؟ فانشا الفتي يقول : من الطويل بنا من جوي الاحزان والحب لوعة . . . تكاد لها نفس الشفيق تذوب ولكنما ابقي حشاشة معول . . . علي ما به عود هناك صليب قال وانشا الفتي يقول : من الطويل وبي لوعة لو تشتكي الصم مثلها . . . تفطرت الصم الصلاد فخرت ولو قسم الله الذي لي من الجوي . . . علي كل نفس حظها لالمت ولكنما ابقي حشاشة معول . . . علي ما به صلب النجار فمدت قال : فاقبل ابن عباس علي عبيد الله بن حميد بن زهير بن سهيل بن الحارث بن اسد بن عبد العزي ، فقال : اخذ هذا البدوي العود علي وعليه ، قال : ثم حملوه ، فخفت في ايديهم فمات ، فقال ابن عباس : هذا قتيل الحب لا عقل ولا قود . قال عكرمة : فما رايت ابن عباس يسال الله تلك العشية حتي امسي الا العافية مما ابتلي به ذلك الفتي .  وممن قيل انه مات كمدا : عبد الله بن عجلان النهدي ، روي انه راي اثر كف محبوبته في ثوب زوجها فمات . وهذا الفصل نذكر فيه جملة الاخبار والاشعار في الغزل ، ونقتصر علي ما يءمن معه الملل ، ونعدل عن الاكثار ، فان استقصاءه غير ممكن ، وهو فن يلهج به الناس ، وقد اكثروا منه واختلفوا فيه . قيل : الهوي جليس ممتع ، واليف مءنس ، وصاحب مهلك ، ومالك قاهر ، مسالكه لطيفة ، ومذاهبه متضادة ، واحكامه جاءرة ، ملك الابدان وارواحها ، والقلوب وخواطرها ، والعيون ونواظرها ، والعقول واراءها ، واعطي خزام طاعتها ، وقود تصرفها ، تواري عن الا صار مدخله ، وغيض في القلوب مسلكه ، وقد راينا الهوي يشجع قلب الجبان ، ويسخي كف البخيل ، ويصفي ذهن الغبي ، ويبعث حزم العاجز ، ويخضع له عزة كل متجبر . فمن مختار الشعر فيه قول الشنفري : من الطويل فواكبدا علي اميمة بعد ما . . . طمعت فهبها نعمة العيش ولت لقد اعجبتني لا سقوطا قناعها . . . اذا ما مشت ولا بذات تلفت تحل بمنجاة من اللوم بيتها . . . اذا ما بيوت بالمذمة حلت اميمة لا يخزي نثاها حليلها . . . اذا ذكر النسوان عفت وجلت اذا هو امسي اب قرة عينه . . . ماب السعيد لم يقل اين ظلت فدقت وجلت واسبكرت واكملت . . . فلو جن انسان من الحسن جنت فبتنا كان البيت حجر فوقنا . . . بريحانة ريحت عشاء وطلت  وقال جميل : من الطويل يقولون جاهد يا جميل بغزوة . . . واي جهاد غيرهن اريد لكل حديث بينهن بشاشة . . . وكل فتيل بينهن شهيد علقت الهوي منها وليدا ولم يزل . . . الي اليوم ينمي حبها ويزيد وافنيت عمري بانتظاري نوالها . . . وافنت بذاك الدهر وهو جديد وقد تلتقي الاشتات بعد شتاتها . . . وقد تدرك الحاجات وهي بعيد اذا قلت ما بي يا بثينة قاتلي . . . من الحب قالت ثابت ويزيد وقال ذو الرمة : من الطويل الا لا ابالي الموت ان كان دونه . . . لقاء لمي وارتجاع من الوصل اناة كان المرط حين تلوثه . . . علي دعصة غراء من عجم الرمل اسيلة مستن الوشاحين قانء . . . باطرافها الحناء في سبط طفل من المشرقات البيض في غير مرهة . . . ذوات الشفاه الحو ولاعين النجل اذا ما امرء حاولن ان يقتتلنه . . . بلا احنة بين النفوس ولا ذحل تبسمن عن نور الاقاحي في الثري . . . وفترن من ابصار مضروجة كحل وانا لنرضي حين نشكو بخلوة . . . اليهن حاجات النفوس بلا بذل وما الفقر ازري عندهن بوصلنا . . . ولكن جرت اخلاقهن علي البخل وقال قيس بن ذريح : من الطويل  سلي هل قلاني من عشير صحبته . . . وهل ذم رحلي في الرفاق رفيق وهل يجتوي القوم الكرام صحابتي . . . اذا اغبر مخشي الفجاج عميق ولو تعلمين الغيب ايقنت انني . . . لكم والهدايا المشعرات صديق صبوحي اذا ما ذرت الشمس ذكركم . . . ولي ذكركم عند المساء غبوق تتوق اليك النفس ثم اردها . . . حياء ومثلي بالحياء حقيق واني وان حاولت صرمي وهجرتي . . . عليك من احداث الردي لشفيق تكاد بلاد الله يا ام معمر . . . بما رحبت يوما علي تضيق اذود سوام الطرف عنك وهل له . . . علي احد الا عليك طريق وحدثتني يا قلب انك صابر . . . علي البعد من لبني فسوف تذوق فمت كمدا او عش سقيما فانما . . . تكلفني ما لا اراك تطيق دعون الهوي ثم ارتمين قلوبنا . . . باعين اعداء وهن صديق وهذه الابيات متنازعة ، وقد انشد ابو هلال العسكري الرابع منها ، والسادس والثامن لمضرس بن الحارث المري ، والبيت الاخر هو لجرير في ديوانه . قال عبيد الله بن سليمان الوزير : دعاني المعتضد يوما ، فقال لي : الا تعاتب بدرا علي ما لا يزال يستعمله من التخرق في النفقات والاثابات والزيادات والصلات ، وجعل يءكد القول علي في ذلك ، فلم اخرج من حضرته حتي دخل عليه بدر ، فجعل يستامره في اطلاقات مسرفة ، ونفقات واسعة ، وصلات سنية ، وهو ياذن فيها ، فلما خرج راي في وجهي انكارا لما فعله بعد ما جري  بيني وبينه ، فقال : يا عبيد الله : قد عرفت ما في نفسك ، واني واياه لكما قال الشاعر : من البسيط في وجهه شافع يمحو اساءته . . . من القلوب مطاع حيثما شفعا مستقبل بالذي يهوي وان كثرت . . . منه الاساءة معذور بما صنعا وهذه ابيات يقولها الحكم بن قنبر البصري اولها : ويلي علي من اطار النوم فامتنعا . . . وزاد قلبي علي اوجاعه وجعا كانما الشمس في اعطافه لمعت . . . حسنا او البدر من ازراره طلعا وقال ابو صخر الهذلي : من الطويل اما والذي ابكي واضحك والذي . . . امات واحيا والذي امره الامر لقد تركتني احسد الوحش ان اري . . . اليفين منها لا يروعهما الذعر فيا حبها زدني جوي كل ليلة . . . ويا سلوة الايام موعدك الحشر عجبت لسعي الدهر بيني وبينها . . . فلما انقضي ما بيننا سكن الدهر وقال اخر : من الطويل وكنت متي ارسلت طرفك راءدا . . . لقلبك يوما اتعبتك المناظر رايت الذي لا كله انت قادر . . . عليه ولا عن بعضه انت صابر  وقال الحسين بن مطير : من الطويل وكنت اذود العين ان ترد البكا . . . فقد وردت ما كنت عنه اذودها خليلي ما بالعيش عتب لو اننا . . . وجدنا لايام الصبا من يعيدها ولي نظرة بعد الصدود من الجوي . . . كنظرة ثكلي قد اصيب وحيدها هل الله عاف عن ذنوب تكشفت . . . ام الله ان لم يعف عنها يعيدها اذا جءتها بين النساء منحتها . . . صدودا كان النفس ليست تريدها وقال اخر : من الطويل لعمرك ما ميعاد عينك والبكا . . . بداراء الا ان تهب جنوب اعاشر في داراء من لا اوده . . . وبالرمل مهجور الي حبيب وقال بعض الاعراب : من البسيط لا خير في الحب وقفا لا تحركه . . . عوارض الياس او يرتاحه الطمع لو كان لي صبرها او عندها جزعي . . . لكنت املك ما اتي وما ادع لا احمل اللوم فيها والغرام بها . . . ما حمل الله نفسا فوق ما تسع وقال اخر : من الطويل لقد كان فيها للامانة موضع . . . وللكف مرتاد وللعين منظر وللحاءم العطشان ري بريقها . . . وللمرح الذيال ملهي ومسكر اقلب طرفي في السماء لعله . . . يصادف طرفي طرفها حين انظر  وقال الاحوص : من الطويل الا لا تلمه اليوم ان يتبلدا . . . فقد غلب المحزون ان يتجلدا فما العيش الا ما تلذ وتشتهي . . . وان لام فيه ذو الشنان وفندا اذا كنت عزهاة عن اللهو والصبا . . . فكن حجرا من يابس الصخر جلمدا وقال ذو الرمة : من الطويل الما علي الدار التي لو وجدتها . . . بها اهلها ما كان وحشا مقيلها ولو لم يكن الا تعلل ساعة . . . قليلا فاني نافع لي قليلها وقال ابو حية النميري : من الطويل وان دما لو تعلمين جنيته . . . علي الحي جاني مثله غير سالم اما انه لو كان غيرك ارقلت . . . اليه القنا بالراعفات اللهاذم ولكن لعمر الله ما طل مسلما . . . كغر الثنايا واضحات الملاغم اذا هن ساقطن الحديث كانه . . . سقاط حصي المرجان من سلك ناظم رمين فاقصدن القلوب فلم نجد . . . دما ماءرا الا جوي في الحيازم وخبرك الواشون ان لن احبكم . . . بلي وستور الله ذات المحارم  اصد وما الصد الذي تعلمينه . . . عزاء بنا الا اجتراع العلاقم حياء وبقيا ان تشيع نميمة . . . بنا وبكم اف لاهل النماءم ويروي للمجنون : من الطويل شفيعي اليها قلبها ان تعتبت . . . وقلبي لها فيما تروم شفيع لقد ظفرت مني بسمع وطاعة . . . وكل محب سامع ومطيع وقال ابو العميثل : من الطويل سلام علي الوصل الذي كان بيننا . . . تداعت به اركانه فتضعضعا تمني رجال ما احبوا وانما . . . تمنيت ان اشكو اليها فتسمعا واني لانهي النفس عنها ولم يكن . . . بشء من الدنيا سواها لتقنعا اري كل معشوقين غيري وغيرها . . . قد استعذبا طعم الهوي وتمتعا كاني واياها علي حال رقبة . . . وتفريق شمل لم نبت ليلة معا وقال ابو عبد الله بن الدمينة الخثعمي ، وهذه الابيات من قصيدة مشهورة ، وقد تنوزع اكثرها ، ونسبت ابيات منها الي عدد من الشعراء ، والمقصود الشعر لا شاعره ، فلذلك جمعت المختار منها في مكان واحد : من الطويل احقا عباد الله ان لست واردا . . . ولا صادرا الا علي رقيب ولا زاءرا فردا ولا في جماعة . . . من الناس الا قيل انت مريب وهل ريبة في ان تحن نجيبة . . . الي الفها او ان يحن نجيب وان الكثيب الفرد من ايمن الحمي . . . الي وان لم اته لحبيب اميم لقد عذبتني واريتني . . . بداءع اخلاق لهن ضروب  صدودا واعراضا كاني مذنب . . . الا ليس لي الا هواك ذنوب تضنين حتي يذهب البخل بالمني . . . وحتي تكاد النفس عنك تطيب فيا حسرات القلب من غربة النوي . . . اذا اقتسمتها نية وشعوب ومن خطرات تعتريني وزفرة . . . لها بين جلدي والعظام دبيب فلا تتركي نفسي شعاعا فانها . . . من الوجد قد كادت عليك تذوب احبك اطراف النهار بشاشة . . . وبالليل يدعوني الهوي فاجيب ولما رايت الهجر ابقي مودة . . . وطارت باضعان علي قلوب هجرت اجتنابا غير بغض ولا قلي . . . اميمة مهجورا الي حبيب لك الله اني واصل ما وصلتني . . . ومثن بما اوليتني ومثيب واخذ ما اعطيت عفوا وانني . . . لازور عما تكرهين هيوب واني لاستحييك حتي كانما . . . علي بظهر الغيب منك رقيب ولو انني استغفر الله كلما . . . ذكرتك لم تكتب علي ذنوب تلجين حتي يزري الهجر بالهوي . . . وحتي تكاد النفس عنك تطيب اميم احذري نقض الهوي لم يزل لنا . . . علي الناي والهجران منك نصيب وكوني علي الواشين لداء شغبة . . . كما انا للواشي الد شغوب بنفسي واهلي من اذا عرضوا له . . . بذكر الهوي لم يدر كيف يجيب ولم يعتذر عذر البرء ولم تزل . . . به سكتة حتي يقال مريب الا لا ابالي ما اجنت صدورهم . . . اذا نصحت ممن اود جيوب الا ليت شعري عنك هل تذكرينني . . . فذكرك في الدنيا الي حبيب وهل لي نصيب من فءادك ثابت . . . كما لك عندي في الفءاد نصيب ومما يروي للمجنون : من الطويل  الا ايها البيت الذي لا ازوره . . . وان حله شخص الي حبيب هجرتك اشفاقا وزرتك خاءفا . . . وفيك علي الدهر منك رقيب ساستعتب الايام فيك لعلها . . . بيوم سرور في الزمان تءوب جري السيل فاستبكاني السيل اذ جري . . . وفاضت له من مقلتي غروب وما ذاك الا حين ايقنت انه . . . يمر بواد انت منه قريب يكون اجاجا دونكم فاذا انتهي . . . اليكم تلقي طيبكم فيطيب اظل غريب الدار في ارض عامر . . . الا كل مهجور هناك غريب وقال الاقرع بن معاذ القشيري : من الطويل الا حبذا ريح الغضا حين زعزعت . . . بقضبانه بعد الضلال جنوب تجء بريا من عثيمة طلة . . . يعيش لها القلب الدوي فيثيب لقد طرقتنا ام عثمان بعدما . . . هوي النجم والساري الي حبيب كاني وان كانت شهودا عشيرتي . . . اذا بنت عني يا عثيم غريب ولا خير في الدنيا اذا ا ، ت لم تزر . . . حبيبا ولم يطرب اليك حبيب واكببت اكباب الدني وباعدت . . . لك النفس حاجات وهن قريب فلا تعديني الفقر يا ام خالد . . . فان الغني للمنفقين قريب وقال ابن الدمينة : من الطويل قفي يا اميم القلب نقض لبانة . . . ونشك الهوي ثم افعلي ما بدا لك سلي البانة الغيناء بالابطح الذي . . . به البان هل حييت اطلال دارك وهل قمت في اطلالهن عشية . . . مقام اخي الباساء واخترت ذلك  وهل كفكفت عيناي في الدار عبرة . . . فرادي كنظم اللءلء المتدارك فيا بانة الوادي اليست مصيبة . . . من الله ان تحمي علينا ظلالك ويا بانة الوادي اثيبي متيما . . . اخا سقم انشبته في حبالك عدمتك من نفس وانت سقيتني . . . بكاس الردي في وصل من لم يوالك ومنيتني لقيان من لست لاقيا . . . نهاري ولا ليلي ولا بين ذلك فما بك من صبر ولا من جلادة . . . ولا من عزاء فاهلكي في الهوالك ليهنك امساكي بكفي علي الحشا . . . ورقراق دمعي رهبة من زيالك ولو قلت طا في النار اعلم انه . . . هدي منك او مدن لنا في وصالك لقدمت رجلي نحوها فوطءتها . . . هدي منك لي او غبة في ضلالك وقال ايضا : من الطويل خليلي اني اليوم شاك اليكما . . . وهل تنفع الشكوي الي من يزيدها تفرق الاف واسبال عبرة . . . اظل باطراف البنان اذودها وكاءن تري من ذي هوي حيل دونه . . . ومتبع الف نظرة لا يعيدها نظرت بمغضي سيل تربان نظرة . . . هل الله لي قبل الممات معيدها الي رجح الاكفال غيد كانها . . . ظباء الفلا اعناقها وخدودها خليلي شدا بالعصاءب فانظرا . . . الي كبدي هل بت صدعا عهودها وكنا اذا تدنو بعصماء نية . . . رضينا بدنيانا فلا نستزيدها وقال ايضا : من الطويل ولما لحقنا بالحمول انبري لنا . . . خفيف الحشا توهي القميص عواتقه  قليل قذي العيني يعلم انه . . . هو الموت ان لم تصرعنا بواءقه وقفنا فسلمنا فسلم كارها . . . علينا وتبريح من الوجد خانقه فساءلته حتي اطمان وقد بدا . . . لنا برد منه تطير صواعقه فسايرته ميلين يا ليت انني . . . علي سخطه حتي الممات ارافقه فلما رات ان لا جواب وانه . . . مدي الصرم مضروب علينا سرادقه رمتني بطرف لو كميا رمت به . . . لبل نجيعا نحره وبناءقه ومن طوال قصاءد الغزل ومختارها قول كثير ، وقد اقتصرت علي بعضها : من الطويل خليلي هذا ربع عزة فاعقلا . . . قلوصيكما ثم انزلا حيث حلت وما كنت ادري قبل عزة ما البكا . . . ولا موجعات الحزن حتي تولت فقد حلفت جهدا بما نحرت له . . . قريش غداة المازمين وصلت وكانت لقطع الحبل بيني وبينها . . . كناذرة نذرا فاوفت وحلت فقلت لها يا عز كل مصيبة . . . اذا وطنت يوما لها النفس ذلت ولم يلق انسان من الحب ميعة . . . تعم ولا غماء الا تجلت كاني انادي صخرة حين اعرضت . . . من الصم لو تمشي بها العصم زلت صفوحا فما تلقاك الا بخيلة . . . فمن مل منها ذلك الوصل ملت اباحت حمي لم يرعه الناس قبلها . . . وحلت تلاعا لم تكن قبل حلت  فما انصفت اما النساء فبغضت . . . الينا واما بالنوال فضنت يكلفها الخنزير شتمي وما بها . . . هواني ولكن للمليك استذلت هنيءا مريءا غير داء مخامر . . . لعزة من اعراضنا ما استحلت ووالله ما قاربت الا تباعدت . . . بصرم ولا اكثرت الا اقلت فان تكن العتبي فاهلا ومرحبا . . . وحقت لها العتبي الينا وقلت وان تكن الاخري فان وراءنا . . . مناديح لو سارت بها العيس كلت اسيءي بنا او احسني لا ملومة . . . لدينا ولا مقلية ان تقلت واني وان صدت لمءن وصادق . . . عليها بما كانت الينا ازلت فما انا بالداعي لعزة بالردي . . . ولا شامت ان نعل عزة زلت فلا يحسب الواشون ان صبابتي . . . بعزة كانت غمرة فتجلت فيا عجبا للقلب كيف اعترافه . . . وللنفس لما وطنت كيف ذلت واني وتهيامي بعزة بعدما . . . تخليت مما بيننا وتخلت لكالمرتجي ظل الغمامة كلما . . . تبوا منها للمقيل اضمحلت كاني واياها سحابة ممحل . . . رجاها فلما جاوزته استهلت قال عبد الله بن ابي عبيد : قلت لابي الساءب المخزومي : ما احسن عروة بن اذينة حيث يقول : من الكامل لبثوا ثلاث مني بمنزل غبطة . . . وهم علي غرض هنالك ما هم متجاورين بغير دار اقامة . . . لو قد اجد رحيلهم لم يندموا ولهن بالبيت العتيق لبانة . . . والركن يعرفهن لو يتكلم لو كان حيا قبلهن ظعاءنا . . . حيا الحطيم وجوههن وزمزم  وكانهن وقد حسرن لواغبا . . . بيض باكناف الحطيم مركم قال : فقال : لا والله ما احسن ولا اجمل ، ولكنه اهجر واخطل في صفتهن بهذه الصفة ، ثم لا يندم علي رحيلهن ، اهكذا قال كثير حيث يقول : من الطويل تفرق اهواء الحجيج علي مني . . . وصدعهم شعب النوي صبح اربع فريقان منهم سالك بطن نخلة . . . واخر منهم سالك بطن تضرع فلم ار دارا مثلها دار غبطة . . . وملقي اذا التف الحجيج بمجمع اقل مقيما راضيا بمقامه . . . واكثر جارا ظاعنا لم يودع انظر اليه تقدمت شهادته علمه ، وكفي لسانه ببيانه ، وهل يغتبط عاقل بمقام لا يرضي به ، ولكن مكره اخوك لا بطل ؛ والعرجي كان بالعهد اوفي منهما ، واولي بالصواب حين تعرض لها نافرة من مني ، فقال لها عاتبا مستكينا : من الكامل المرفل عوجي علي فسلمي جبر . . . ماذا الوقوف وانتم سفر ما نلتقي الا ثلاث مني . . . حتي يفرق بيننا النفر قال المداءني : انتجع اهل جنوب ناحية حسي والحمي ، وقد اصابها الغيث وامرعت ، فلما ارادوا الرحيل وقف لهم مالك بن الصمصامة وجنوب هي بنت محصن الجعدية بنت عم مالك حتي اذا بلغته اخذ بخطام بعيرها ثم قال : من الطويل اريتك اذ ازمعتم اليوم نية . . . وغالك مصطاف الحمي ومرابعه  اترعين ما استودعت ام انت كالذي . . . اذا ما ناي هانت عليه وداءعه فبكت وقالت : بل ارعي والله ما استودعت ، ولا اكون كمن هانت عليه وداءعه ، فارسل بعيرها وبكي حتي سقط مغشيا عليه ، وهي واقفة ، ثم افاق وهو يقول : الا ان حسيا دونه قلة الحمي . . . مني النفس لو كانت تنال شراءعه وكيف ومن دون الورود عواءق . . . واصبغ حامي ما احب ومانعه فلا انا فيما صدني عنه طامع . . . ولا ارتجي وصل الذي هو قاطعه قال بعضهم : رايت امراة مستقبلة البيت في غاية الضر والنحافة ، رافعة يديها تدعو ، فقلت لها : هل من حاجة ؟ قالت : حاجتب ان تنادي في الموقف بقولي : من الطويل تزود كل الناس زادا يقيمهم . . . وما لي زاد والسلام علي نفسي ففعلت ، فاذا انا بفتي منهوك فقال : اما الزاد فمضيت به اليها ، فما زادت علي النظر والبكاء ، ثم قالت له : تنصرف مصاحبا ، فقلت : ما علمت ان لقاء كما يقتصر علي هذا ، فقالت : امسك ، اما علمت ان ركوب العار ودخول النار شديد ؟ ! وقال الناجم : من الرجز طالبت من شرد نومي وذعر . . . بقبلة تحسن في القلب الاثر فقال لي مستعجلا وما انتظر : . . . ليس لغير العين حظ في القمر اخذه من قول علي بن الجهم : من الطويل وقلن لنا نحن الاهلة انما . . . نضء لمن يسري بليل ولا نقري  فلا نيل الا ما تزود ناظر . . . ولا وصل الا بالخيال الذي يسري وقال سليمان بن ابي دباكل الخزاعي : وقد وجدت بعض هذهه الابيات في ديوان ابي ذءيب : من الكامل يا بيت خنساء الذي اتجنب . . . ذهب الشباب وحبها لا يذهب اصبحت امنحك الصدود وانني . . . قسما اليك علي الصدود لاجنب مالي احن اذا جمالك قربت . . . واصد عنك وانت مني اقرب تبكي الحمامة شجوها فتهيجني . . . ويروح عازب همي المتاوب وتهب سارية الرياح من ارضكم . . . فاري الرياح لها تطل وتجنب واري الصديق يودكم فاوده . . . ان كان ينسب منك او لا ينسب واخالف الواشين فيك تجملا . . . وهم علي اولو ضغاءن ذرب ثم اتخذتهم علي وليجة . . . حتي غضبت ومثل ذلك يغضب واري السمية باسمكم فيزيدني . . . شوقا اليك حنانك المتنسب وقال يزيد بن الطثرية : من الكامل بنفسي من لو مر برد بنانه . . . علي كبدي كانت شفاء انامله  ومن هابني في كل امر وهبته . . . فلا هو يعطيني ولا انا ساءله وقال ايضا : من الطويل عقيلية اما ملات ازارها . . . فدعص واما خصرها فبتيل تقيظ باكناف الحمي ويظلها . . . بنعمان من وادي الاراك مقيل اليس قليلا نظرة ان نظرتها . . . اليك وكلا ليس منك قليل فيا خلة النفس التي ليس دونها . . . لنا من اخلاء الصفاء خليل ويا من كتمنا حبه لم يطع به . . . عدو ولم يءمن عليه دخيل اما من مقام اشتكي غربة النوي . . . وخوف العدا فيه اليك سبيل فديتك اعداءي كثير وشقتي . . . بعيد علاتي فكيف اقول فما كل يوم لي بارضك حاجة . . . ولا كل وقت لي اليك رسول صحاءف عندي للعتاب طويتها . . . ستنشر يوما والعتاب يطول فلا تحملي اثمي وانت ضعيفة . . . فحمل دمي يوم الحساب ثقيل قيل لما تايمت عاءشة بنت طلحة كانت تقيم بمكة سنة وبالمدينة سنة ، وتخرج الي مال عظيم لها بالطاءف ، وقصر كان لها هناك تتنزه فيه ، وتجلس فيه بالعشيات تناضل بين الرامة ، فمر بها النميري لاشاعر ، فسالت عنه فنسب لها ، فقالت اءتوني به ، فاتوا به ، فقالت له : انشدني مما قلت في زينب ، تعني زينب بنت يوسف اخت الحجاج بن يوسف ، وكان النميري يتعشقها ، وهو محمد بن عبد الله بن نمير من ثقيف ، فامتنع عليها ، وقال : بنت عمي وقد  صارت عظاما بالية ، قالت : اقسمت عليك الا فعلت ، فانشدها قوله ، وهي ابيات ذكرت ها هنا مختارها : من الطويل تضوع مسكا بطن نعمان ان مشت . . . به زبيب في نسوة عطرات فاصبح ما بين الهماء وجدوة . . . الي الماء ماء الجزع ذي العشرات له ارج من مجمر الهند ساطع . . . تظلع رياه من الكفرات تهادين ما بين المحصب من مني . . . واقبلن لا شعثا ولا غبرات مررن بفخ راءحات عشية . . . يلبين للرحمن معتمرات يخمرن اطراف البنان من التقي . . . ويخرجن جنح الليل معتجرات تقسم لبي يوم نعمان انني . . . رايت فءادي عارم النظرات جلون وجوها لم تلحها سماءم . . . حرور ولم يسفعن بالسبرات قالت : والله ما قلت الا جميلا ، ولا ذكرت الا كرما وطيبا ، ولا وصفت الا دينا وتقي ، اعطوه الف درهم . فلما كانت الجمعة الاخري تعرض لها ، فقالت : علي به ، فجاءها فقالت له : انشدني من شعرك في زينب ، فقال لها : او انشدك من شعر الحارث بن خالد فيك ، فوثب مواليها اليه ، فقالت : دعوه ، فانه اراد ان يستقيد لبنت عمه ، هات مما قال الحارث ، فانشدها : من الكامل المرفل ظعن الامير باحسن الخلق . . . وغدوا بلبك مطلع الشرق في البيت ذي الحسب الرفيع ومن . . . اهل التقي والبر والصدق  اترجة عبق العبير بها . . . عبق الدهان بجانب الحق ما صبحت احدا برءيتها . . . الا غدا بكواكب الطلق فقالت : والله ما ذكر الا جميلا ، ذكر اني اذا صبحت زوجا غدا بوجهي ، غدا بكواكب الطلق ، واني غدوت مع امير تزوجني الي المشرق ، واني احسن الخلق في البيت ذي الحسب الرفيع ، اعطوه الف درهم واكسوه حلتين ، ولا تعد تاتينا يا نميري . وكان الحارث بن خالد المخزومي مع منصبه وشرفه وفضله شديد الغزل ، خالعا فيه العذار ، ولاه عبد الملك بن مروان مكة ، فاذن له المءذن وخرج الي الصلاة ، فارسلت اليه عاءشة بنت طلحة ان بقي م طوافي شء لم اتمه ، فامر الءذنين فكفوا عن الاقامة حتي فرغت من طوافها ، والناس يصيحون به ويضجون ، فبلغ ذلك عبد الملك بن مروان فعزله ، وكتب اليه يءنبه فيما فعل ، فقال : ما اهون والله غضبه علي اذا رضيت عاءشة ، والله لو لم تفرغ من طوافها الي الليل لاخرت الصلاة الي الليل . وكانت العرب في جاهليتها واسلامها مع شدة باسها وغلظ اكبادها ترق عند الغزل وتلين ، حتي مات كثير منهم كمدا وشغفا ، وكانت تستحسن منه ما هو مستهجن عند غيرها من طواءف الامم ، الا تري ان الشاعر منهم كان ينسب بالمراة الجليلة ذات الحسب والعشيرة المنيعة ، فلا ينكرون ذلك ولا يغيرونه حتي كانوا ينسبون بنساء الملوك ، فلا يكون منهم له نكير . ذكر النابغة الذبياني المتجردة زوجة النعمان بن المنذر في شعره ، فقال قصيدة اولها : من الكامل امن ال مية راءح او مغتدي . . . عجلان ذا زاد وغير مزود  ووصف اعضاءها وافحش حتي قال : واذا طعنت طعنت في مستهدف . . . رابي المجسة بالعبير مقرمد وهي ابيات قد كتبتها في مكان اخر من هذا الكتاب ، وانشدها النعمان غير مراقب ، فقال بعض اعداءه : ما يستطيع ان يقول ذلك الا من جرب ، فاغراه به . وتنسب ابو دهبل الجمحي بعاتكة بنت معاوية بن ابي سفيان ، فاحتمله معاوية ووصله وزوجه ليكف ويقطع القالة عن ابنته . روي ان عاتكة بنت معاوية حجت فنزلت بذي طوي ، فمر بها ابو دهبل الجمحي في وقت الهاجرة وهي غافلة عنه ، فوقف ينظر اليها ، فلما تنبهت له شتمته فانصرف ، وقال فيها الشعر ، فبلغها فضحكت وبعثت اليه بكسوة ، وجرت الرسل بينهما ، وكان ابو دهبل من اجمل الناس ، فلما صدرت عن مكة خرج معها الي الشام ، فنزل قريبا منها ، وكانت تعاهده بالبر والالطاف ، حتي دخلت دمشق وورد معها ، فانقطعت عن لقاءه ، وبعد من ان يراها ، ومرض بدمشق مرضا طويلا وقال في ذلك : من الخفيف طال ليلي وبت كالمحزون . . . ومللت المقام في جيرون واطلت المقام بالشام حتي . . . ظن اهلي مرجمات الظنون فبكت خشية التفرق جمل . . . كبكاء القرين اثر القرين وهي زهراء مثل لءلءة الغو . . . واص ميزت من جوهر مكنون واذا ما نسبتها لم تجدها . . . في سناء من المكارم دون تجعل المسك واليلنجوج والند . . . د صلاء لها علي الكانون  ثم خاصرتها الي القبة البي . . . ضاء تمشي في مرمر مسنون قبة في مراجل ضربوها . . . عند برد الشتاء في قيطون عن يساري اذا دخلت من البا . . . ب وان كنت خارجا فيميني ثم فارقتها علي خير ما كا . . . ن قرين مقارنا لقرين ولقد قلت اذا تطاول ليلي . . . وتقلبت ليلتي في فنون ليت شعري امن هوي طار نومي . . . ام براني الباري قصير الجفون وشاع هذا الشعر حتي بلغ معاوية فامسك عنه ، حتي اذا كان يوم الجمعة دخل عليه النس وفيهم ابو دهبل ، فقال معاوية لحاجبه : اذا اراد ابو دهبل الخروج فامنعه واردده الي ، وجعل الناس يسلمون وينصرفون ، فقام ابو دهبل لينصرف ، ن فناداه معاوية : يا ابا دهبل هلم الي ، فلما دنا اجلسه حتي خلا به ، ثم قال : ما ظننت في قريش اشعر منك حيث تقول : ولقد قلت اذا تطاول ليلي وذكر بعض الابيات ، ووالله ان فتاة ابوها معاوية ، وجدها ابو سفيان ، وجدتها هند بنت عتبة لكما ذكرت ، فاي شء زدت في قدرها ، ولقد اسات والله في قولك : ثم خاصرتها الي القبة الخضراء . فقال له امير المءمنين : والله ما قلت هذا ، ن وانما قيل علي لساني ، فقال له معاوية : اما من جهتي فلا خوف عليك لاني اعلم صيانة ابنتي نفسها ، واعلم ان فتيان الشعراء لم يتركوا ان يقولوا النسيب في كل من جاز ان يقولوه فيه ، وكل من لم يجز ، وانما اكره لك جوار يزيد ، واخاف عليك وثباته ، فان له سورة الشباب وانفة الملوك . وانما اراد معاوية ان يهرب ابو دهبل وتنقضي القالة علي ابنته . فحذر ابو دهبل وخرج الي مكة هاربا علي وجهه ، وكان يكاتب عاتكة ، فبينما معاوية ذات يوم في مجلسه اذ جاء  خصي فقال له : يا امير المءمنين والله لقد سقط اليوم الي عاتكة كتاب ، فلما قراته بكت ثم اخذته فجعلته تحت مصلاها ، ن وما زالت خاثرة النفس منذ اليوم ، فقال له : اذهب والطف لهذا الكتاب حتي تاتيني به ، فانطق الخصي فلم يزل حتي اصاب منها غرة ، فاخذ الكتاب واقبل به الي معاوية واذا فيه : من الطويل اعاتك هلا اذ بخلت فلم تري . . . لذي صبوة زلفي لديك ولا حقا رددت فءادا قد تولي به الهوي . . . وسكنت عينا لا تمل ولا ترقا ولكن خلعت القلب بالوعد والمني . . . ولم ار يوما منك جودا ولا صدقا اتنسين ايامي بربعك مدنفا . . . صريعا بارض الشام ذا جسد ملقي وليس صديق يرتضي لوصية . . . وادعو لاوتي بالشراب فما اسقي واكبر همي ان اري لك مرسلا . . . وطول نهاري جالس ارقب الطرقا فوا كبدي اذ ليس لي منك مجلس . . . فاشكو الذي بي من هواك وما القي رايتك تزدادين للصب غلظة . . . ويزداد قلبي كل يوم لكم عشقا فلما قرا معاوية هذا الشعر ، بعث الي يزيد بن معاوية ، فاتاه فدخل عليه ، فوجده مطرقا ، فقال : يا امير المءمنين ماهذا الاطراق الذي شجاك ؟ فقال : امر ارمني واقلقني منذ اليوم ، وما ادري ما انتم في شانه ، قال : وما هو ؟ قال : هذا الفاسق ابو دهبل كتب هذه الابيات لاختك عاتكة ، ولم تزل باكية منذ اليوم ، وقد افسدها فما تري فيه ؟ فقال : والله يا امير المءمنين ان الشان في امره لهين ، قال : وما هو ؟ قال : عبد من عبيدك يكمن له في ازقة مكة فيريحنا منه ، فقال له معاوية : اف لك ، والله ان امرءا يريد بك ما يريد ، ويسمو بك الي ما  يسمو لغير ذي راي ، وانت قد ضاق ذرعك بكلمة ، وقصر فيها باعك اردت ان تقتل رجلا من قريش ، واما تعلم انك ان فعلت ذلك صدقت قوله وجعلتنا احدوثة ابدا ! قال : يا امير المءمنين انه قد قال قصيدة اخري ، فانشدها اهل مكة ، وسارت حتي بلغتني واوجعتني ، وحملتني علي ما اشرت فيه ، قال وما هي ؟ قال : قال : من الطويل الا لا تقل مهلا فقد ذهب المهل . . . وما كل من يلحي محبا له عقل لقد كان في حالين ولم ازر . . . هواي وان خوفت عن حبها شغل حمي الملك الجبار عني لقاءها . . . فمن دونها تخشي المتالف والقتل فلا خير في حب نخاف وباله . . . ولا في حبيب لا يكون له وصل فواكبدي اني شهرت بحبها . . . ولم يك فيما بيننا ساعة بذل ويا عجبا اني اكاتم حبها . . . وقد شاع حتي قطعت دونها السبل قال له : قد والله رفهت عني ، والله ما كنت امن ان يكون قد وصل اليها ، اما الان ، وهو يشكو انه لم يكن بينهما وصل ولا بذل ، فالخطب فيه يسير ، قم عني وانصرف . وحج معاوية في تلك السنة ، فلما انقضت ايام الحج كتب اسماء وجوه قريش واشرافهم وشعراءهم ، وكتب فيهم اسم ابي دهبل ، ثم دعا بهم ، ففرق في جميعهم صلات سنية ، واجازهم جواءز كثيرة ، فلما قبض ابو دهبل جاءزته وقام لينصرف دعا به معاوية ، فرجع اليه ، فقال : يا ابا دهبل ، مالي اري ابا خالد يزيد بن معاوية ابن امير المءمنين عليك ساخطا في قوارص تاتيه عنك ، وشعر تزال قد نطقت به وانفذته الي خصياننا وموالينا ؟ لا تعترض لابي خالد . فجعل  يعتذر اليه ، ويحلف انه مكذوب عليه . فقال له معاوية : لا باس عليك ، وما يضرك هذا عندنا ، هل تاهلت ؟ قال : لا ، قال : فاي بنات عمك احب اليك ؟ قال : فلانة ، قال : قد زوجكها امير المءمنين واصدقها الفي دينار ، فلما قبضها قال : ان راي امير المءمنين ان يعفو عما مضي ، فان نطقت ببيت في معني ما سبق فقد ابحت دمي ، وفلانة التي زوجتنيها طالق البتة ، فسر بذلك معاوية ، وضمن له رضي يزيد عنه ، ووعده بادرار ما وصله به في كل سنة ، فانصرف الي دمشق ، ولم يحج معاوية في تلك السنة الا من اجل ابي دهبل . ومن حلاوة الهوي والغزل عندهم وضعوا اخبارا واشعارا نسبوها الي المجنون وغيره ، ومما نسب الي المجنون : انه لما اختلط في حب ليلي ، قيل لابيه احجج الي مكة وادع الله عز وجل ، ومره ان يتعلق باستار الكعبة ، واسال الله ان يعافيه مما به ، ويبغض ليلي اليه ، فلعل الله عز وجل ان يخلصه من هذا البلاء ، فحج به ابوه ، فلما صاروا بمني سمع صاءحا في الليل يصيح : يا ليلي ، فصرخ صرخة ظنوا ان نفسه قد تلفت ، وسقط مغشيا عليه ، فلم يزل كلك حتي اصبح ، وقال له ابوه : تعلق باستار الكعبة ، واسال الله عز وجل ان يعافيك من حب ليلي ، فتعلق بالاستار وقال : اللهم زدني لليلي حبا وبها كلفا ، ولا تنسني ذكرها ابدا ، فهام حينءذ واختلط ولم يضبط ، فكان يهيم في البرية مع الوحش . وروي انه مر بزوج ليلي وهو جالس يصلي في يوم شات ، فوقف عليه ثم قال : من الوافر بربك هل ضممت اليك ليلي . . . قبيل الصبح او قبلت فاها وهل رفت عليك قرون ليلي . . . رفيف الاقحوانة في نداها  فقال له : اللهم اذ حلفتني فنعم ؛ فقبض المجنون بكلتا يديه قبضتين من نار فما فارقهما حتي سقط مغشيا عليه ، وسقط الجمر مع لحم راحتيه ، فقام زوج ليلي مغموما بفعله متعجبا . والاخبار المنسوبة الي المجنون كثيرة ، وهي تخرج عن المعني الذي قصدت . واعود الي مستحسن الاشعار في المعني ، فمن ذلك قول جرير من الطويل كان عيون المجتلين تعرضت . . . لشمس تجلي يوم دجن سحابها اذا ذكرت للقلب كاد لذكرها . . . يطير اليها واعتراه عذابها حمي اهلها ما كان منا واصبحت . . . سواء علينا نايها واقترابها وقال ذو الرمة : من الطويل عدتني العوادي عنك يا مي برهة . . . وقد يلتوي دون الحبيب فيهجر علي انني في كل سير اسيره . . . وفي نظري من نحو ارضك اصور فان تحدث الايام يا مي بيننا . . . فلا ناشر سرا ولا متغير اقول لنفسي كلما خفت هفوة . . . من القلب في اثار مي فاكثر الا انما مي فصبرا بلية . . . وقد يبتلي المرء الكريم فيصبر وقال ايضا : من الطويل وقفنا فقلنا ايه عن ام سالم . . . وما بال تكليم الديار البلاقع فما كلمتنا دارها غير انها . . . ثنت هاجسات من خبال مراجع  عفت غير اجال الصريم وقد يري . . . بها وضح اللبات حور المدامع اذا الفاحش المغيار لم يرتقبنه . . . مددن حبال المطمعات الموانع فما القرب يشفي من هوي ام سالم . . . وما البعد منها من دواء بنافع من البيض مبهاج عليها ملاحة . . . نضار وروعات الحسان الرواءع هي الشمس اشراقا اذا ما تزينت . . . وشبه النقا مغترة في الموادع ولما تلاقينا جرت من عيوننا . . . دموع كففنا فيضها بالاصابع ونلنا سقاطا من حديث كانه . . . جني النحل ممزوجا بماء الوقاءع وقال ابو ذءيب الهذلي : من الطويل ابي القلب الا ام عمرو فاصبحت . . . تحرق ناري بالشكاة ونارها وعيرها الواشون اني احبها . . . وتلك شكاة ظاهر عنك عارها فان اعتذر منها فاني مكذب . . . وان تعتذر يردد عليها اعتذارها فلا يهنا الواشين ان قد هجرتها . . . واظلم دوني ليلها ونهارها فما ام خشف بالعلاية مشدن . . . تنوش البير حيث نال اهتصارها باحسن منها يوم قامت فاعرضت . . . تواري الدموع حيث جد انحدارها ومما ينسب الي قيس بن الملوح المجنون : من الطويل دعا المحرمون الله يستغفرونه . . . بمكة يوما كي تمحي ذنوبها  وناديت يا مولاي اول حاجة . . . بنفسي ليلي ثم انت حسيبها تمر الصبا صفحا بساكن ذي الغضا . . . ويصدع قلبي ان يهب هبوبها قرية عهد بالحبيب وانما . . . هوي كل نفس حيث حل حبيبها وقال رجل من بني الحارث : من الطويل مني ان تكن حقا تكن احسن المني . . . والا فقد عشنا بها زمنا رغدا اماني من سلمي حسان كانما . . . سقتك بها سلمي علي ظما بردا وقال ابن ياسين : من الطويل الهي منحت الود مني بخيلة . . . وانت علي تغيير ذاك قدير شفاء الجوي بث الهوي واشتكاءه . . . وان امرءا اخفي الهوي لصبور وينشد للصمة : من البسيط تختال عيني في يوميك واجدة . . . تبكي لفرط صدود او نوي دار وقال اخر : من الطويل الي الله اشكو بخلها وسماحتي . . . لها عسل مني وتبذل علقما افي الله ان انسي ولا تذكرينني . . . وعيناي من ذكراك قد ذرفت دما ابيت فما تنفك لي منك حاجة . . . رمي الله بالحب الذي كان اظلما عبد العزيز بن خلوف النحوي المغربي : من الكامل ان التي فتنته ود حماتها . . . لو تستعير سيوفهم لحظاتها  الجانيات هوي امر مذاقة . . . من صدها والذ من رشفاتها الواقعات بنا نوافذ تلتقي . . . في القلب اكلمها وحب رماتها اني لارضي ان ابيع بلحظة . . . منها مدامع مقلتي وسناتها ان الامر من الحمام مذاقة . . . لفراق دنيا تلك من لذاتها بيني وبين سلوها ما بيتها . . . في حسن صورتها وحسن لداتها وقال الاحوص بن محمد : من الطويل لقد منعت معروفها ام جعفر . . . واني الي معروفها لفقير وقد انكرت بعد اعتراف زيارتي . . . وقد وغرت فيها علي صدور ادور ولولا ان اري ام جعفر . . . بابياتكم ما درت حيث ادور ازور البيوت اللاصقات بارضها . . . وقلبي الي البيت الذي لا ازور وما كنت زوارا ولكن ذا الهوي . . . اذا لم يزر لا بد ان سيزور وقال ابو اسحاق الحصري الانصاري المغربي : من الكامل المجزوء هتفت سحيرا والربي . . . للقطر رافعة العيون يا هل بكيت كما بكت . . . ورق الحماءم في الغصون ذكرنني عهدا مضي . . . للانس منقطع القرين فكانما صاغت علي . . . شجوي شجي تلك اللحون وتصرمت ايامه . . . فكانها رجع الجفون  وقال اخر : من الطويل وددتك لما كان حبك خالصا . . . واعرضت لما صار نهبا مقسما ولا يلبث الحوض الجديد بناءه . . . علي كثرة الوراد ان يتهدما قال بعض العرب لبنيه : صفوا لي شهواتكم من النساء ، فقال الاكبر : تعجبني القدود والخدود والنهود ، وقال الاوسط : تعجبني الاطراف والاعطاف والارداف ، وقال الاصغر : تعجبني الثغور والنحور والشعور . روي ان سكينة بنت الحسين مرت بعروة بن اذينة ، فقالت : يا ابا عامر انت الذي تقول : من البسيط اذا وجدت اوار الحب في كبدي . . . اقبلت نحو سقاء القوم ابترد هبني تبردت برد الماء ظاهره . . . فمن لنار علي الاحشاء تتقد وانت القاءل : من البسيط قالت وابثثتها وجدي فبحت به . . . قد كنت عندي تحب الستر فاستتر الست تبصر من حولي فقلت لها . . . غطي هواك وما القي علي بصري قال : نعم ، قالت : هن حراءر واشارت الي جواريها ان كان هذا خرج من قلب سليم . انشد الجاحظ : من الكامل المرفل  قامت تخاصرني لقبتها . . . خود تاطر غادة بكر كل يري ان الشباب له . . . في كل مبلغ لذة عذر وقال الحسن بن هانء : من المديد ظن بي من قد كلفت به . . . فهو يجفوني علي الظنن نام لا يعنيه ما لقيت . . . عين ممنوع من الوسن رشا لولا ملاحته . . . خلت الدنيا من الفتن كل يوم يسترق له . . . حسنه عبدا بلا ثمن وقال ابو الطيب : من الطويل لعينيك ما يلقي الفءاد وما لقي . . . وللحب ما لم يبق مني وما بقي وبين الرضي والسخط والقرب والنوي . . . مجال لدمع المقلة المترقرق واحلي الهوي ما شك في الوصل ربه . . . وفي الهجر فهو الدهر يرجو ويتقي وقال البحتري : من الكامل ارسوم دار ام سطور كتاب . . . ذهبت بشاشتها مع الاحقاب يجتاز زاءرها بغير لبانة . . . ويرد ساءلها بغير جواب ولربما كان المكان محببا . . . فينا بمن فيه من الاحباب ترنو فتنقلب القلوب للحظها . . . مرضي السلو صحاءح الاوصاب رفعت من السجف المنيف وسلمت . . . بانامل فيهن درس خضاب وتعجبت من لوعتي فتبسمت . . . عن واضحات لو لثمن عذاب  لو تسعفين وما سالت مشقة . . . لعدلت حر جوي ببرد رضاب ولءن شكوت ظماي انك للتي . . . قدما جعلت من السراب شرابي وقال ايضا : من الطويل تمادي بها وجدي وملك وصلها . . . خلي الحشا في وصلها جد زاهد وما الناس الا واجد غير مالك . . . لما يبتغي او مالك غير واجد وقال ايضا : من الكامل لغريرة ادنو وتبعد في الهوي . . . واجود بالوصل المصون وتبخل وعليلة الالحاظ ناعمة الصبا . . . غري الوشاة بها ولج العذل لا تكذبن فانت الطف في الحشا . . . عهدا واحسن في الضمير واجمل لو شءت عدت الي التناصف في الهوي . . . وبذلت من مكنونه ما ابذل احنو عليك وفي فءادي لوعة . . . واصد عنك ووجه ودي مقبل واذا هممت بوصل غيرك ردني . . . ولهي عليك وشافع لك اول واعز ثم اذل ذلة عاشق . . . والحب فيه تعزز وتذلل وقال ايضا : من المتقارب احب علي اي ما حالة . . . اساءة ليلي واحسانها اراك وان كنت ظلامة . . . صفية نفسي وخلانها  ويعجبني فيك ان استديم . . . صبابات نفسي واشجانها وما سرني ان قلبي اعير . . . عزاء القلوب وسلوانها وقال ابو تمام : من البسيط ما اقبلت اوجه اللذات سافرة . . . مذ ادبرت باللوي ايامنا الاول ان شءت ان لا تري صبرا لمصطبر . . . فانظر علي اي حال اصبح الطلل كانما جاد مغناه فغيره . . . دموعنا يوم بانوا وهي تنهمل وقال ايضا : من الوافر ارامة كنت مالف كل ريم . . . لو استمتعت بالانس القديم ادار البءس غيرك التصابي . . . الي فصرت جنات النعيم لءن اصبحت ميدان السوافي . . . لقد اصبحت ميدان الهموم ومما ضرم البرحاء اني . . . شكوت فما شكوت الي رحيم اظن الدمع في خدي سيبقي . . . رسوما من بكاءي في الرسوم وليل بت اكلاه كاني . . . سليم او سهرت علي سليم فاقسم لو سالت دجاه عني . . . لقد انباك عن وجد عظيم وقال ابن الرومي : من الطويل ثني شوقه والمرء يصحو ويسكر . . . رسوم كاخلاق الصحاءف دثر لايدي البلي فيها سطور مبنية . . . عبارتها ان كل بيت سيهجر  وقفت بها صحبي فظلت عراصهم . . . بدمعي وانفاسي تراح وتمطر وقال ايضا : من المنسرح مذ صرت همي في النوم واليقظة . . . اتعبت مما اهذي بك الحفظه كم واعظ فيك لي وواعظة . . . لو كنت ممن تنهاه فيك عظه وكيف بالصبر عنك يا حسنا . . . يامر بالسيءات من لحظه يا من حلا في الفءاد منظره الحلوفما مجه ولا لفظه ويحي الي كم تصيد رقته . . . قلبي وقلب كم اشتكي غلظه وقال ايضا : من الطويل جعلت لها صدري مرادا تروده . . . وبواتها من حبة القلب منزلا فما علقت من قبلها النفس معلقا . . . ولا اتخذت من بعدها متعللا وقال : من الكامل نظرت فاقصدت الفءاد بسهمها . . . ثم انثنت عني فكدت اهيم ويلاه ان نظرت وان هي اعرضت . . . وقع السهام ونزعهن اليم وقال ابو عثمان الخالدي : من البسيط انباك شاهد امري عن مغيبه . . . وجد جد الهوي بي في تلعبه  يا نازحا نزحت دمعي قطيعته . . . هب لي من الدمع ما ابكي عليك به ولي فءاد اذا لج الغرام به . . . هام اشتياقا الي ذكري معذبه وقال ابو بكر اليوسفي : من الطويل سقي البارق العلوي عذبا من الحيا . . . محلتنا بين العذيب وبارق واغني مغانيها وارضي رياضها . . . وشق بلطم القطر خد الشقاءق محلة ايناس ومغني اوانس . . . ومركز رايات ومرعي ايانق فيا يومها كم من مناف منافق . . . ويا ليلها كم من مواف موافق ومنها : فلم انتبه الا وذكراك صاحبي . . . ولم اغتمض الا وطيفك طارقي اغار علي رياك من كل ناشق . . . لها وعلي ذكراك من كل ناطق وقال ابن نباتة : من الكامل المجزوء كيف السلو واين بابه . . . والحي قد خطفت ركابه زعم المخبر انه . . . ضربت علي سلع قبابه فطلبتهم كالايم او . . . كالسيل في الليل انسيابه فاذا احم المقلتي . . . ن يشين انمله خضابه يهتز مثل السمهري . . . تدافعت فيه كعابه وقف الولاءد دونه . . . كالقلب يستره حجابه اقبلت اساله واع . . . لم ان حرماني جوابه ويلي علي متلون ال . . . اخلاق يعجبه شبابه لا رسله تتري الي . . . نا بالسلام ولا كتابه  وقال ايضا : من الطويل وبدر تمام بت الثم رجله . . . واكبره عن ان اقبل خده تعشقت فيه كل شء يحبه . . . من الجور حتي صرت اعشق صده ولا بد لي من جهلة في وصاله . . . فمن لي بخل اودع الحلم عنده وقال ابو الحسن السلامي : من الكامل انسيم هل للصلح عندك موضع . . . فيزور طيف او يهب نسيم والشيب دونك وهو موت مضمر . . . والهجر وهو تفرق مكتوم وقال من ابيات : من الوافر وسموه مع القربي غريبا . . . كنور العين سموه سوادا كان سعيد بن حميد الكاتب ينعشق فضل الشاعرة مولاة المتوكل وتهواه ، فكتبت اليه تعاتبه علي حضوره مع مغنية وتجميشه اياها ، وكتبت في اخرها : من الخفيف خنت عهدي وليس ذاك جزاءي . . . يا صناع اللسان مر الفعال وتبدلت بي بديلا فلا يه . . . نك ما اخترته من الابدال فاجابها يعتذر بجواب طويل ، وكتب في اخره : من الطويل  تظنون اني قد تبدلت بعدكم . . . بديلا وبعض الظن اثم ومنكر اذا كان قلبي في يديك رهينة . . . فكيف بلا قلب اصافي واهجر وقال ابو الفرج الدمشقي المعروف بالواواء : من الطويل رعي الله من لم يرع لي ما رعيته . . . وان كان في كف المنية مودعي فيا اسفي زدني جوي كل ليلة . . . ويا كبدي وجدا عليه تقطعي وقال ايضا : من البسيط هبني اخادع طرفي في تامله . . . فكيف اخدع قلبا ليس ينخدع يا من اذا رمت عنه الصبر يمنعني . . . شوق مجيب وصبر عنه ممتنع وقال العباس بن الاحنف : من المنسرح احرم منكم بما اقول وقد . . . نال به العاشقون من عشقوا صرت كاني ذبالة نصبت . . . تضء للناس وهي تحترق وقال المرتضي ابو القاسم الموسوي : من الطويل فيا رب ان لقيت وجها تحية . . . فحي وجوها بالمدينة سهما تجافين عن مس الدهان وطالما . . . عصمن عن الحناء كفا ومعصما وكم من جليد لا يخامره الهوي . . . شنن عليه الوجد حتي تتيما  اهان لهن النفس وهي كريمة . . . والقي اليهن الحديث المكتما وقال ابو عبد الله ابن الحجاج : من السريع يا ظالما قلبي الي جوره . . . يحن مشتاق ويرتاح افسدتني بعد صلاحي وهل . . . يرجي لافسادك اصلاح وقال ايضا : من الوافر بنفسي من احب العيش فيه . . . واكره ما يشير به النصيح يطيب لي الكريه به ويحلو . . . ويحسن منه في عيني القبيح ولم ار كالمليح الوجه مهما . . . اتاه فانه حسن مليح وقال من الطويل تاوبه هذا الهوي فهو قاتله . . . وعاوده جهل التصابي وباطله واخلق بامر لم تءد فروضه . . . الي اهله الا تءدي نوافله فقد انباتني في هواك بما جنت . . . اواخره حتما علي اواءله وان اتحصيل من بات قبلنا . . . ينبهه عن اجل الامر عاجله وقال : من الطويل الي الله اشكو مقلة لا دموعها . . . تجف ولا تقري كراها جفونها ونفسا الي احبابها مذ تحملوا . . . يطول علي بعد المزار حنينها وكانت تمنيها الشكوك سفاهة . . . وتوطءها بسط الغرور ظنونها مواعيد قد مل التقاضي غريمها . . . وشدت بامراس المطال ديونها وقال ايضا : من المنسرح افدي بنفسي من لا اسميه . . . اكتم وجدي به واخفيه استره بين اضلعي شفقا . . . والدمع بين الوشاة بيديه  ظبي سقاني المدام من يده . . . ممزوجة بالرحيق من فيه قد ملك الحسن لا ينافسه . . . يوسف فيه ولا يباريه فالبدر في التم من صناءعه . . . والشمس في الدجن من جواريه يمنع ماعونه ويسالني . . . سواد عيني اليمني فاعطيه قد عيل صبري مما اعاتبه . . . وضاق صدري مما اداريه يحسن لي وجهه الجميل كما . . . يسء لي في الهوي تجنيه وكلما رمت ان اعاتبه . . . علي تماديه في تعديه جاءت علي غفلة محاسنه . . . تسالني الصفح عن مساويه وقال مقداد بن المطاميري ، وهو ممن عاصرناه ، وكان قليل البضاعة في الادب علي حلاوة الفاظه ورشاقة معانيه : من البسيط ان حال في الحب عما كنت اعهده . . . وبات يرقد ليلا لست ارقده فلا طويت الحشا الا علي حرق . . . يبلي من الصبر عنه ما اجدده يا عاذلي ان يوم البين ضل هوي . . . قلبي المعني فقل لي اين انشده زار الخيال طليحا قلما انست . . . جفونه بالكري او لان مرقده اهلا به زاءرا تدنيه من جسدي . . . ضماءري وخفوق القلب يبعده وقال ايضا : من المتقارب ومجدولة مثل جدل العنان . . . صبوت اليها فاصبيتها اذا لام في حبها العاذلا . . . ت اسخطتهن وارضيتها كاني اذا ما نهيت العيون . . . عن الدمع بالدمع اغريتها  من رسولي الي الثريا فاني . . . ضقت ذرعا بهجرها والكتاب سلبتني مجاجة المسك عقلي . . . فسلوها ماذا احل اغتصابي وهي مكنونة تحير منها . . . في اديم الخدين ماء الشباب ابرزوها مثل المهاة تهادي . . . بين خمس كواعب اتراب فلما سمع ابن ابي عتيق قوله قال : اياي اراد وبي نوه ، لا جرم ، والله لا اذوق اكلا حتي اشخص واصلح بينهما ، ونهض . قال بلال مولاه : ونهضت معه ، فجاء الي قوم من بني الديل بن بكر لم تكن تفارقهم نجاءب لهم فره يكرونها ، فاكتري منهم راحلتين واغلي لهم ، فقلت له : استوضعهم او دعني اماكسهم فقد اشتطوا عليك ، فقال : ويحك ، اما علمت ان المكاس ليس من اخلاق الكرام ، ثم ركب احداهما ، وركبت الاخري ، فسار سيرا شديدا ، فقلت : ابق علي نفسك ، فان ما تريد ليس يفوت ، فقال : ويحك من الطويل ابادر حبل الود ان يتقضبا وما حلاوة الدنيا ان تم الصدع بين عمر والثريا ؟ ! فقدمنا مكة ليلا غير محرمين ، فدق علي عمر بابه ، فخرج اليه فسلم عليه ولم ينزل عن راحلته ، وقال : اركب اصلح بينك وبين الثريا فانا رسولك الذي سالت عنه . فركبا معا وقدمنا الطاءف ، وقد كان عمر اوصي ام نوفل ، فكانت تطلب له الحيلة لاصلاحها فلا يمكنها . فقال ابن ابي عتيق للثريا : هذا عمر قد جشمني السفر من المدينة اليك ، فجءتك به معترفا بذنب لم يجنه ، معتذرا اليك من غساءتك اليه ، فدعيني من التعداد والترداد ، فانه من الشعراء الذين يقولون ما لا يفعلون . فصالحته اتم صلح واحسنه واجمله ، وكررنا الي المدينة . تزوج زيد بن عمرو بن عثمان سكينة بنت الحسين ، فعتب عليها  يوما ، فخرج الي مال له ، فذكر اشعب ان سكينة دعته فقالت : ان ابن عثمان خرج عاتبا علي فاعلم لي حاله ، قلت : لا استطيع ان اذهب اليه الساعة ، قالت : فانا اعطيك ثلاثين دينارا ، قال : فاعطتني اياها ، فاتيته ليلا فدخلت الدار ، فقال : انظروا من في الدار ، فاتوه فقالوا اشعب ، فنزل عن فرشه وصار في الارض وقال : شعيب ؟ قلت : نعم ، قال : ما جاء بك ؟ قلت : ارسلتني سكينة بنت الحسين لاعلم خبرك ، اتذكرت منها ما تذكرت منك ؟ وانا اعلم انك قد وجلت حين نزلت عن فرشك وصرت الي الارض ، فقال : دعني من هذا وغنني : من السريع عوجا به فاستنطقاه فقد . . . ذكرني ما كنت لم اذكر فغنيته فلم يطرب ، ثم قال : غغني ويلك غير هذا ، فان اصبت ما في نفسي فلك حلتي هذه ، وقد اشتريتها انفا بثلاثماءة دينار ، فغنيته : من الخفيف علق القلب بعض ما قد شجاه . . . من حبيب امسي هوانا هواه ما ضراري نفسي بهجران من لي . . . س مسيءا ولا بعيدا نواه واجتنابي بيت الحبيب وما الخل . . . د باهوي الي من ان اراه قال : ما عدوت والله ما في نفسي ، خذ الحلة ، فاخذتها ورجعت الي سكينة فقصصت عليها القصة فقالت : اين الحلة ؟ قلت : معي ، فقالت : افانت الان تريد ان تلبس حلة ابن عثمان ، لا والله وال كرامة ، فاشترتها نمي بثلاثماءة دينار . وروي ان رجلا كان له جارية يهواها وتهواه ، فغاضبها يوما وتمادي الهجر بينهما ، واتفق ان دخلت اليا مغنية فغنتها :  ما ضراري نفسي بهجران من ليس البيت المتقدم ذكره ، فقالت الجارية : لا شء والله الا الحمق ، وقامت الي مولاها وقبلت راسه واصطلحا . احب المتوكل ان ينادم الحسين بن الضحاك ، وان يري ما بقي من ظرفه وشهوته لما كان عليه ، فاحضره وقد كبر وضعف ، وسقاه حتي سكر ، وقال لخادمه شفيع : اسقه ، فسقاه حتي سكر ، وحياه بوردة ، وكان علي شفيع ثياب موردة ، فمد الحسين يده الي ذراع شفيع ، فقال له المتوكل : ويحك يا حسين اتجمش اخص خدمي عندي بحضرتي ؟ فكيف لو خلوت ؟ ما احوجك الي ادب ، وكان المتوكل غمز شفيعا علي العبث به ، فقال الحسين بن الضحاك : يا سيدي اريد دواة وقرطاسا ، فامر له بذلك ، فكتب بخطه : من الطويل وكالوردة الحمراء حيا بوردة . . . من الوشي يمشي في قراطق كالورد له عبثات عند كل تحية . . . بعينيه يستدعي الحليم الي الوجد تمنيت ان اسقي بكفيه شربة . . . تذكرني ما قد نسيت من العهد سقي الله عيشا لم ابت فيه ليلة . . . من الدهر الا من حبيب علي وعد ثم دفع الرقعة الي شفيع وقال له : ادفعها الي مولاك ، فلما قراها استملحها وقال له : احسنت والله يا حسين ، لو كان شفيع ممن تجوز هبته لوهبته لك ، ولكن بحياتي يا شفيع الا كنت ساقيه بقية يومه هذا واخدمه كما تخدمني ، وامر له بمال ، فحمل معه لما انصرف .  ومن شعر الحسين بن الضحاك : من مجزوء الخفيف لا وحبيك لا اصا . . . فح للدمع مدمعا من بكي شجوه استرا . . . ح وان كان موجعا كبدي من هواك اس . . . قم من ان تقطعا لم تدع سورة الضني . . . في للسقم موضعا سعت امة لبثينة بها الي اخيها وابيها ، وقالت لهما : ان جميلا عندها الليلة ، فاتياها مشتملين علي سيفين ، فراياه جالسا حجرة منها يحدثها ويشكو اليها بثه ، ثم قال لها : يا بثينة ارايت ودي اياك وشغفي بك ؟ الا تجربينه ؟ قالت : بماذا ؟ قال : بما يكون بين المتحابين ، فقالت له : يا جميل : اهذا تبغي ؟ والله لقد كنت عندي بعيدا منه ، ولءن عاودت تعريضا بريبة لا رايت وجهي ابدا ، فضحك وقال : والله ما قلت لك هذا الا لاعلم ما عندك فيه ، ولو علمت انك تجيبينني اليه ، لعلمت انك تجيبين غيري ، ولو علمت منك مساعدة عليه لضربته بسيفي هذا ما استمسك قاءمه في يدي ، ولو اطاعني قلبي لهجرتك هجرا الي الابد ، اوما سمعت قولي : من الطويل واني لراض من بثينة بالذي . . . لو استيقن الواشي لقرت بلابله بلا وبان لا استطيع وبالمني . . . وبالامل المرجو قد خاب امله وبالنظرة العجلي وبالحول تنقضي . . . اواخره لا نلتقي واواءله فقال ابوها لاخيها : قم فما ينبغي لنا بعد هذا اليوم ان نمنع هذا الرجل من لقاءها ، فانصرفا وتركاهما .  قال اسحاق الموصلي : صرت الي الواثق فقال : باي شء اطرفتني من احاديث الاعراب واشعارهم ؟ فقلت يا امير المءمنين : جلس الي فتي من الاعراب في بعض المنازل ، فحادثني فرايت منه احلي ما رايت من الفتيان منظرا وحديثا وظرفا وادبا ، فاستنشدته فانشدني : من الطويل سقي العلم الفرد الذي في ظلاله . . . غزالان مكحولان مءتلفان اذا امنا التفا بجيدي تواصل . . . فطرفاهما للريب يسترقان ارغتهما ختلا فلم استطعهما . . . ورميا ففاتاني وقد قتلاني ثم تنفس نفسا ظننت ان حيازيمه قد تقطعت ، فقلت : ما لك بابي انت ؟ فقال : وراء هذين الجبلين لي شجن ، وقد حيل بيني وبين المرور بهذه البلاد ، وقد نذر دمي ؟ ، وانا اتمتع بالنظر الجبلين تعللا بهما اذا قدم الحجاج ، ثم يحال بيني وبين ذلك ، فقلت له : زدني مما قلت في ذلك فانشدني : من الطويل اذا ما وردت الماء في بعض اهله . . . حضور فعرض بي كانك مازح فان سالت عني حضور فقل لها . . . به غبر من داءه وهو صالح فامرني الواثق فكتب الشعيرن وغني الواثق بهما بعد ايام ، ووصلني بصلتين ، وذكر خبرا طويلا ليس هذا موضعه . قال حماد الراوية : اتيت مكة فجلست في حلقة فيها عمر بن ابي ربيعة المخزومي ، فتذاكروا العذريين ، فقال عمر بن ابي ربيعة : كان لي صديق من بني عذرة يقال له الجعد بن مهجع ، وكان احد بني سلامان ، وكان يلقي مثل الذي القي من الصبابة بالنساء والوجد بهن ، علي انه كان لا  عاهر الخلوة ، ولا سريع السلوة ، وكان يوافي الموسم في كل سنة ، فاذا راث عن وقته رجمت عنه الاخبار ، وتوكفت الاسفار حتي يقدم ، فغمني ذات سنة ابطاءه حتي قدم حجاج عذرة ، فاتيت القوم انشد صاحبي ، ن فاذا غلام قد تنفس الصعداء ثم قال : عن ابي المسهر تسال ؟ قلت : نعم واياه اردت ، قال : هيهات اصبح والله ابو المسهر لا مءيسا فيهمل ، ولا مرجوا فيعلل ، اصبح والله كما قال القاءل : من الطويل لعمرك ما حبي لاسماء تاركي . . . اعيش ولا اقضي به فاموت قلت : وما الذي به ؟ قال : مثل الذي بك من تهور كما في الضلال وجركما اذيال الخسار ، فكانما لم تسمعا بجنة ولا نار ! قلت : من انت منه يا ابن اخي ؟ قال : اخوه ، قلت : اما والله يا ابن اخي ؟ قال : اخوه ، قلت : اما والله يا ابن اخي ما يمنعك ان تسلك مسلك اخيك من الادب ، وان تركب مراكبه ، الا انك واخاك كالبرد والبجاد لا يرفعك ولا ترفعه ، ثم صرفت وجه وانا اقول : من الطويل اراءحة حجاج عذرة وجهة . . . ولما يرح في القوم جعد بن مهجع خليلان نشكو ما نلاقي من الهوي . . . متي ما يقل اسمع وان قلت يسمع الا ليت شعري اي شء اصابه . . . فلي زفرات هجن ما بين اضلعي فلا يبعدنك الله خلا فانني . . . سالقي كما لاقيت في الحب مصرعي ثم انطلقت حتي وقفت موقفي من عرفات ، فبينا انا كذلك اذا انا بانسان قد  تغير لونه وساءت هيءته ، فادني ناقته من ناقتي حتي خالف بين اعناقهما ثم عانقني وبكي حتي اشتد بكاءه ، فقلت : وما وراءك ؟ فقال : برح العذل وطولا المطل ، ثم انشا يقول : من الوافر لءن كانت عدية ذات لب . . . لقد علمت بان الحب داء الم تنظر الي تغيير جسمي . . . واني لا يفارقني البكاء واني لو تكلفت الذي بي . . . لقف الكلم وانكشف الغطاء وان معاشري ورجال قومي . . . حتوفهم الصبابة واللقاء اذا العذري مات خلي بال . . . فذاك العبد يبكيه الرشاء فقلت : يا ابا المسهر : انها ساعة تضرب اليها اكباد الابل من شرق الارض وغربها ، فلو دعوت وانت بمني كنت قمينا ان تظفر بحاجتك ، وان تنصر علي عدوك ، قال : فتركني واقبل علي الدعاء ؛ فلما تدلت الشمس للغروب ، وهم الناس ان يفيضوا ، سمعته يتكلم بشء ، فاصغيت اليه فاذا هو يقول : من الرجز يا رب كل غدوة وروحه . . . من محرم يشكو الضحي ولوحه انت حسيب الخلق يوم الدوحه فقلت : وما يوم الدوحة ؟ فقال : والله لاخبرنك وان لم تسالني ، فيممنا نحو مزدلفة ، فاقبل علي وقال : اني رجل ذو مال كثير من نعم وشاء ، وذو المال لا يسعه القل ، ولا يروره الثماد ، واني خشيت عاما اول علي مالي التلف ، وقطر الغيث ارض كلب ، فانتجعت اخوالي منهم ، فاسعوا لي عند صدر المجلس ، وسقوني جمة الماء ، وكنت فيهم في خير حال ، ثم اني عزمت علي موافقة ابلي  بماء لهم يقال له الحوذان ، ن فركبت فرسي ، وسمطت خلفي شرابا كان اهداه الي بعضهم ، ثم مضيت حتي اذا كنت بين الحي ومرعي الغنم ، رفعت لي دوحة عظيمة ، فنزلت عن فرسي وشددته بغصن من اغصانها ، وجلست في ظلها ، فبينا انا ذلك اذ سطع غبار من ناحية الحي ، ثم رفعت لي شخوص ثلاثة ، ثم تبينت فاذا فارس يطرد مسحلا واتانا ، فتاملته فاذا عليه درع اصفر وعمامة خز سوداء ، واذا فروع شعره تضرب خصره ، فقلت : غلام حديث عهد بعرس اعجلته لذة الصيد فترك ثوبه ولبس ثوب امراته ، فما جاز عني الا قليلا حتي طعن المسحل وثني طعنة للاتان ، فصرعهما واقبل راجعا نحوي وهو يقول : من السريع نطعنهم سلكي ومخلوجة . . . كرك لامين علي نابل فقلت له : انك قد تعبت واتعبت فلو نزلت ، فثني الرجل ونزل ، وشد فرسه بغصن من اغصان الشجرة ، والقي رمحه واقبل حتي جلس ، فجعل يحدثني حديثا ذكرت فيه قول ابي ذءيب : من الطويل وان حديثا منك لو تعلمينه . . . جني النحل في البان عوذ مطافل فقمت الي فرسي فاصلحت من امره ، ثم رجعت وقد حسر العمامة عن راسه ، فاذا غلام كان وجهه الدينار المنقوش ، فقلت : سبحانك اللهم ما اعظم قدرتك واحسن صنعتك ! فقال لي : مم ذاك ؟ قلت : مما راعني من جمالك وبهرني من نورك ، قال : وما الذي روعك من حبيس التراب واكيل الدواب ؟ ثم لا يدري اينعم بعد ذلك ام يباس ؟ قلت : لا يصنع الله بك الا خيرا ؛ ثم تحدثنا ساعة ، فاقبل علي فقال : ما هذا اراه قد سمتطه خلفك في سرجك ؟ قلت : شراب  اهداه الي بعض اهلك ، فهل لك فيه من ارب ؟ قال : انت وذاك ، فاتيته به فشرب منه وجعل ينكت احيانا بالسوط علي ثناياه ، فكان والله يتبين لي ظل السوط فيهن ، فقلت : مهلا فاني خاءف ان تكسرهن ، فقال : ولم ؟ قلت : لانهن رقاب عذاب ، قال : ثم رفع عقيرته يتغني : من الطويل اذا قبل الانسان اخر يشتهي . . . ثناياه لم يحرج وكان له اجرا فاذا زاد زاد الله في حسناته . . . مثاقيل يمحو الله عنه بها الوزرا ثم قام الي فرسه فاصلح من امره ، ثم رجع الي فبرقت لي بارقة من تحت الدرع فاذا ثدي كانه حق عاج فقلت : ناشدتك الله امراة انت ؟ قالت : اي والله الا ، انها تكره العهر وتحب الغزل ، ثم جلست فجعلت تشرب معي ما افتقد من انسها شيءا ، حتي نظرت الي عينيها كانهما عينا مهاة مذعورة ، فوالله ما راعني الا ميلها علي الدوحة سكري ، فزين والله لي الغدر وحسن في عيني ، ثم ان الله عز وجل عصمني ، فجلست منها حجرة ، فلما لبثت الا يسيرا حتي انتبهت فزعة ، فلاثت عمامتها براسها ، وجالت في متن فرسها وقالت : جزاك الله عن الصحبة خيرا ، قلت : ولم لا تزوديني منك زادا ، فناولتني يدها فقبلتها ، فشممت والله منها ريح المسك المفتوت ، فذكرت قول الشاعر : من البسيط كانها اذا تقضي النوم وانتبهت . . . وسنانة ما بها عين ولا اثر فقلت اين الموعد ؟ قالت : ان لي اخوة شرسا وابا غيورا ، والله لان اسرك احب الي من ان اضرك ، ثم انصرفت فجعلت اتبعها بصري حتي غابت ، فهي والله يا ابن ابي ربيعة احلتني هذا المحل وابلغتني هذا المبلغ . فقلت : يا ابا المسهر ان الغدر بك مع ما تذكر لمليح ، فبكي وشتد بكاءه . فقلت له : لا تبك ، ما قلت  لك الا مازحا ، ولو لم ابلغ حاجتك الا بمالي لسعيت في ذلك حتي اقدر عليه ، فقال لي خيرا . فلما انقضي الموسم شددت علي ناقتي ، وشد علي ناقته ، ودعوت غلامي فشد علي بعير له ، وحملت عليه قبة حمراء من ادم كانت لابي ربيعة المخزومي ، وحملت معي الف دينار ومطرف خز ، وانطلقا حتي اتينا بلاد كلب ، فنشدنا عن ابي الجارية فوجدناه في نادي قومه ، واذا هو سيد الحي ، واذا الناس حوله ، فوقفت علي القوم فسلمت ، فرد الشيخ السلام ، ثم قال : ممن الرجل ؟ قلت : عمر بن عبد الله بن ابي ربيعة المخزومي ، فقال : المعروف غير المنكر ، فما الذي جاءك ؟ فقلت : خاطبا ، قال : الكفاء والرغبة ، قلت : اني لم اتي ذلك لنفسي عن غير زهادة فيك ولا جهالة بشرفك ، ولكني اتيتك في حاجة ابن اختكم العذري ، وها هو ذاك ، فقال : انه والله لكفء الحسب رفيع البيت ، غير ان بناتي لم يقعن الا في هذا الحي من قريش ، فوجمت لذلك ، وعرف التغير في وجهي فقال : اما اني ساصنع بك ما لم اصنع بغيرك ، قلت : فما ذاك ؟ فقال : اخيرها ، فهي وما اختارت ، قلت : ما انصفتني او تختار لغيري وتولي الخيار غيرك ، فاشار الي العذري : ان دعه يخيرها ، فارسل اليها ان من الامر كذا وكذا ، فارسلت اليه ما كنت استبد برايي دون القرشي ، والخيار في قوله وحكمه ، فقال لي : انها قد ولتك امرها ، فاقض ما انت قاض ، فحمدت الله واثنيت عليه وقلت : اشهد اني قد زوجتها من الجعد بن مهجع ، واصدقتها هذه الالف دينار ، وجعلت تكرمتها العبد والبعير والقبة ، وكسوت الشيخ المطرف ؛ وسالته ان يبيته من ليلته ، فارسل الي امها فاتته فقالت : تخرج ابنتي كما تخرج الامة ؟ فقال الشيخ : جهزي في جهازها ، فما برحت حتي ضربت قبة في وسط الحريم ، ثم اهديت اليه ليلا ، وبت انا عند الشيخ ، فلما اصبحت اتيت القبة ، فصحت بصاحبي فخرج الي ، وقد اثر السرور في وجهه ، فقلت : كيف  كنت بعدي ؟ وكيف هي بعدك ؟ فقال : ابدت والله لي كثيرا مما كانت تخفيه يوم لقيتها ، ن فسالتها عن ذلك فانشات تقول : من الطويل كتمت الهوي لما رايتك جازعا . . . وقلت فتي بعض الصديق يريد وان تطرحني او تقول فتية . . . يضر بها برح الهوي فتعود فوريت عما بي وفي داخل الحشا . . . من الوجد برح فاعلمن شديد فقلت : اقم علي اهلك ، بارك الله لك فيهم ، وانطلقت وانا اقول : من الطويل كفيت اخا العذري ما كان نابه . . . واني لاعباء النواءب حمال وقال العذري : من الطويل اذا ما ابو الخطاب خلي مكانه . . . فاف لدينا ليس من اهلها عمر فلا حي فتيان الحجازيين بعده . . . ولا سقيت ارض الحجازين بالمطر كان الرشيد يجد بماردة ام المعتصم وجدا شديدا ، فغضبت عليه وغضب عليها ، وتمادي بهما الهجر ، فامر جعفر بن يحيي العباس بن الاحنف فقال : من الكامل راجع احبتك الذين هجرتهم . . . ان المتيم قل ما يتجنب ان التجنب ان تطاول منكما . . . دب السلو له فعز المطلب وامر ابراهيم الموصلي فغني به الرشيد ، فلما سمعه بادر الي ماردة فترضاها ، فقالت : من السبب في ذلك ؟ فعرفته فامرت لكل واحد من العباس وابراهيم بعشرة الا ف درهم .  هوي ديك الجن ، وهو عبد السلام بن رغبان ، امراة نصرانية واستهيم بها ودعاها الي الاسلام ليتزوجها ، ففعلت وفعل ، ثم ان سافر عنها الي دمشق وخلفها بحمص ، وكان له ابن عم يعاديه ، فسعي به اليها ليكدر حاله ، وادعي عليها الفساد ، ووضع من اشاع عنها الفساد ، حتي عاد ديك الجن الي حمص ، ورصده ابن عمه وقت وصوله ، ووضع الرجل الذي اشير بالتهمة اليه ، فدق الباب عليها وديك الجن يسالها عليها وديك الجن يسالها عما قرفت به وهي تنكر ، فحين طرق الباب فقال : انا فلان ، فقال لها ديك الجن : يا زانية زعمت انك لا تعرفين من هذا الامر شيءا ، ثم اخترط سيفه فضربها به حتي قتلها ، وقال في ذلك اشعار كثيرة ، فمن قوله فيها : من مجزوء الخفيف : لك نفس مواتيه . . . والمنايا معاديه ايها القلب لا تعد . . . لهوي البيض ثانيه ليس برق يكون اخ . . . لب من برق غانيه خنت سرا من لم يخن . . . ك فموتي علانيه ثم انه عرف الخبر علي حقيقته وتيقنه فندم ، ومكث شهورا لا يستفيق م البكاء ولا يطعم الا ما يقيم رمقه من بلقة يسيرة ، وقال في ندمه علي قتلها : من الكامل يا طلعة طلع الحمام عليها . . . وجني لها ثمر الردي بيديها رويت من دمها الثري ولطالما . . . روي الهوي شفتي من شفتيها قد بات سيفي في مجال وشاحها . . . ومدامعي تجري علي خديها فوحق نعليها فما وطء الحصي . . . شء اعز علي من نعليها ما كان قتليها لاني لم اكن . . . ابكي اذا سقط الذباب عليها  لكنت ضننت علي العيون بحسنها . . . وانفت من نظر العيون اليها وقد رويت هذه الابيات لفتي من غطفان يقال له : السليك بن مجمع ، وكان من الفرسان ، وكان مطلوبا بدماء ، وكان يخطب بنت عم له يهواها ، فيمنعها ابوها ثم زوجها خوفا منه ، فدخل بها في دار ابيها ثم نقلها بعد اسبوع الي عشيرته ، فلقيه من بني فزارة ثلاثون فارسا كلهم يطالبه بذحل ، فحلقوا عليه ، وقاتلهم فقتل منهم عددا ، واثخن بالجراح حتي ايقن بالموت ، فعاد اليها وقال : ما اسمح بك نفسا لهءلاء ، واني احب ان اقدمك قبلي ، قالت : افعل ، فلو لم تفعله انت لفعلته انا بعدك ، فضربها بسفه حتي قتلها ، وقال هذه الابيات ، ثم عمد اليها وتمرغ في دمها ، ثم تقدم فقاتل حتي قتل ، وحفظت فزارة الابيات فنقلوها ؛ وقيل : بل ادركها قومه وبه رمق ، فسمعوه يردد هذه الابيات ، فحفظوها عنه ، وبقث عندهم يوما ومات . ومن شعر ديك الجن في المقتولة : من الكامل اشفقت ان يرد الزمان بغدره . . . او ابتلي بعد الوصال بهجره قمر انا استخرجته من دجنة . . . لبليتي وجلوته من خدره فقتلته وله علي كرامة . . . ملء الحشا وله الفءاد باسره عهدي به ميتا كاحسن ناءم . . . والحزن يسفح عبرتي في نحره ولو كان يدري الميت ماذا بعده . . . بالحي منه بكي له في قبره غصص تكاد تفيض منها نفسه . . . وتكاد تخرج قلبه من صدره  قال معبد اليقطيني المغني : كنت منقطعا الي البرامكة اخدمهم والازمهم ، فبينا انا ذات يوم في منزلي اذا بابي يدق ، فخرج غلامي ثم رجع الي ، فقال : علي الباب رجل ظاهر المروءة يستاذن عليك ، فاذنت له ، فدخل علي شاب قلما رايت احسن وجها ، ولا انظف ثوبا ، ولا اجمل زيا منه ، من رجل دنف عليه اثر السقم ، فقال لي : اني احاول لقاءك منذ مدة ، فلا اجد اليه سبيلا ، وان لي حاجة ، قلت : وما هي ؟ فاخرج ثلاثماءة دينار فوضعها بين يدي ثم قال : اسالك ان تقبلها وتصنع في بيتين قلتهما لحنا تغنيني به ، قلت هاتهما ، فانشدني : من البسيط والله علي طرفي الجاني علي بدني . . . لتطفءن بدمعي لوعة الحزن او لابوحن حتي يحجبوا سكني . . . فلا اراه ولو ادرجت في كفني قال : فصنعت فيهما لحنا ثم غنيته اياه ، فاغمي عليه حتي ظننت انه قد مات ، ثم افاق فقال : اعد ، فديتك ! فناشده الله غي نفسه ، وقلت : اخشي ان تموت ، فقال : هيهات ، انا اشقي من ذلك ، وما زال يخضع ويتضرع حتي اعدته فصعق صعقة اشد من الاولي ، حتي ظننت نفسه قد فاضت ، فلما افاق رددت الدنانير عليه ، فوضعتها بين يديه ، ، وقلت : يا هذا خذ دنانيرك وانصرف عني ، فقد قضيت حاجتك ، وبلغت وطرك فيما اردت ، ولست احب ان اشرك في دمك ، فقال : يا هذا لا حاجة لي في الدنانير وهذا مثلها لك ، ثم اخرج ثلاثماءة دينار فوضعها بين يدي وقال : اعد الصوت علي مرة اخري وحلال دمي ، فشرهت نفسي الي الدنانير ، ثم قلت له : ولا بعشرة اضعافها الا علي ثلاث شراءط ، قال : وما هن ؟ قلت : اولهن ان تقيم عندي وتتحرم بطعامي ، والثانية  ان تشرب اقداحا من النبيذ تشك قلبك عليك ، وتسكن ما بك ، والثالثة ان تحدثني بقصتك ، فقال : افعل ما تريد ، فاخذت الدنانير ودعوت بالطعام فاصاب منه اصابة معذر ، ثم دعوت بالنبيذ فسرب اقداحا ، وغنيته بشعر غيره في نحو معناه ، وهو يشرب ويبكي ، ثم قال : الشرط اعزك الله ، فغنيته صوته فجعل يبكي احر بكاء ، وينشج اشد نشيج وينتحب ، فلما رايت ما به قد خف عما كان يلحقه ، ورايت النبيذ قد شد من قلبه ، كررت عليه صوته مرارا ، ثم قلت له : حدثني حديثك . فقال : انا رجل من اهل المدينة ، خرجت متنزها في ظاهرها ، وقد سال العقيق ، في فتية من اقراني واخذاني ، فبصرنا بفتيات قد خرجن لمثل ما خرجن له ، فجلسن حجرة منا ، وبصرت فيهن بفتاة كانها قضيب قد طله الندي ، تنظر بعينين ما ارتد طرفها الا بنفس من يلاحظها ، فاطلنا واطلن حتي تفرق الناس وانصرفنا ، وقد ابقت بقلبي جرحا بطء اندماله ، فعدت الي منزلي وانا وقيذ ، وخرجت من غد الي العقيق وليس به احد ، فلم ار لها ولا لصاحباتها اثرا ، ثم جعلت اتبعها في طرق المدينة واسواقها ، فكان الارض اضمرتها ، وسقمت حتي ايس مني اهلي ، وخلت بي ظءر لي فاستعلمتني حالي وضمنت لي كتمانها والسعي في ما احبه منها ، فاخبرتها بقصتي ، فقالت : لا باس عليك ، هذه ايام الربيع ، وهي سنة خصب وانواء ، وليس يبعد عنك المطر ، ثم غدا العقيق فتخرج حينءذ واخرج معك ، فان النسوة يجءن ، فاذا فعلن ورايتها اتبعتها حتي اعرف موضعها ، ثم اصل بينك وبينها ، واسعي لك في تزويجها . فكان نفسي اطمانت الي ذلك ووثقت به ، وسكنت اليه ، فقويت وطمعت ، وتراجعت نفسي . وجاء المطر بعقب ذلك ، فسال العقيق ، وخرج الناس وخرجت مع اخواني اليه ، فجلسنا مجلسنا الاول بعينه ، فما كنا والنسوة  الا كفرسي رهان ، فاومات الي ظءري ، فجلست حجرة منها ومنهن ، واقبلت علي اخواني وقلت : لقد احسن القاءل : من الطويل رمتني بسهم اقصد القلب وانثنت . . . وقد غادرت جرحا به وندوبا فاقبلت علي صاحباتها وقالت : احسن والله القاءل ، واحسن من اجابه حيث يقول : من الطويل بنا مثل ما تشكو فصبرا لعلنا . . . نري فرجا يشفي السقام قريبا فامسكت عن الجواب خوفا من ان يظهر مني ما يفضحني واياها ، وعرفت ما ارادت . ثم تفرق الناس وانصرفنا ، وتبعتها ظءري حتي عرفت منزلها ، وصارت الي . فاخذت بيدي ومضينا اليها ، فلم تزل تتلطف حتي وصلت اليها ، فتلاقينا وتزاورنا علي حال مخالسة ومراقبة ، حتي شاع حديثي وحديثها ، وظهر ما بيني وبينها ، فحجبها اهلها ، وتشدد عليها ابوها ، فما زلت اجتهد في لقاءها فلا اقدر عليه ، وشكوت الي ابي حالي لشدة ما نالني فيها ، وسالته خطبتها لي ، فمضي ابي ومشيخة اهلي الي ابيها فخطبوها فقال : لو كان ذلك قبل ان يفضحها ويشهر بها لاسعفته بما التمس ، ولكنه قد فضحها ، فلم اكن لاحقق قول الناس فيها بتزويجه اياها ، فانصرفت علي ياس منها ومن نفسي . قال معبد : فسالته اين تنزل ؟ فخبرني ، وصارت بيننا عشرة ، ثم جلس جعفر بن يحيي للشرب ، فكان اول صوت غنيته صوتي في شعر هذا الفتي ، فطرب طربا شديدا وقال : ويحك ان لهذا الصوت حديثا ، فما هو ؟ فحدثته خبر الصوت فامر باحضار الفتي فاحضر من وقته ، واستعادة الحديث فاعاده عليه ، فقال له : هي في ذمتي حتي ازوجك اياها ، فطابت نفسه واقام معنا ليلتنا حتي اصبح ؛ وغدا جعفر الي الرشيد ، فحدثه الحديث فتعجب منه ، وامر باحضارنا جميعا فاحضرنا ، وامر بان اغنيه الصوت فغنيته ، فشرب عليه وسمع حديث الفتي ،  وامر من وقته بكتاب الي عامل الحجاز باشخاص الرجل وابنته وجميع اهله الي حضرته ، فلم يمض الا مسافة الطريق حتي احضر ، فامر الرشيد بايصاله اليه فاوصل ، وخطب اليه الجارية للفتي ، واقسم عليه الا يخالف امره ، فاجابه ، وزوجه اياها ، وحمل الرشيد اليه الف دينار لجهازها والف دينار لنفقة الطريق ، وامر للفتي الفي دينار ، ولي بالف دينار ، وامر لنا جعفر بالفي دينار لي وله ، وكان المدني بعد ذلك في جملة ندماء جعفر . قال عصمة بن مالك : جمعني وذا الرمة مربع مرة ، فقال : هيا عصمة ان مية من منقر ، ومنقر اخبث حي واقفي للاثر ، واثبته في نظر ، واعلمه بشر ، وقد عرفوا اثار ابلي ، فهل عندك من ناقة نزدار عليها مبة ؟ قلت : اي والله عندي الجءذر ، فقال : فعلي بها ، فاتيته بها فركب وردفته ، فاتينا محلة مية والقوم خلوف ، والنساء في الرحال ، فلما راين ذا الرمة اجتمعن الي مي ، وانحنا قريبا واتيناهن وجلسنا اليهن ، فقالت ظريفة منهن : انشدنا يا ذا الرمة ، فقال انشدهن يا عمصة ، فانشدتهن قصيدته التي يقول فيها : من الطويل نظرت الي اظعان مي كانها . . . ذري النخل او اثل تميل ذواءبه فاسبلت العينان والقلب كاتم . . . بمغرورق نمت عليه سواكبه بكاء فتي جاء الفراق ولم تجل . . . جواءلها اسراره ومعاتبه فقالت الظريفة : فالان فلتجل ثم انشدت حتي اتيت علي قوله : وقد حلفت بالله مية ما الذي . . . احدثها الا الذي انا كاذبه اذا فرماني الله من حيث لا اري . . . ولا زال في ارضي عدو احاربه فقالت مية : ويحك يا ذا الرمة ، خف عواقب الله ، ثم انشدت حتي اتيت  علي قوله : اذا سرحت من حب مي سوارح . . . علي القلب ابته جميعا عوازبه فقالت الظريفة : قتلته قتلك الله ، فقالت مية : ما اصحه وهنيءا له ، فتنفس ذو الرمة تنفسة كاد حرها يطير بلحيتي ، ثم انشدت حتي اتيت علي قوله : اذا نازعتك القول مية او بدا . . . لك الوجه او نضا الدرع سالبه فما شءت من خد اسيل ومنطق . . . رخيم ومن خلق تعلل جادبه فقالت الظريفة : قد بدا لك الوجه وتنوزع القول ، فمن لنا بان ينضو الدرع سالبه ، فقالت لها مية : قاتلك الله ، ماذا تاتين به ، فتضاحكت الظريفة وقالت : ان لهذين لشانا ، فقوموا عنهما ، فقمنا معها ، فخرجت فكنت قريبا حيث اراهما ، واسمع ما ارتفع من كلامهما ، فوالله ما رايته تحرك من مكانه الذي خلفته فيه ، حتي ثاب اواءل الرجال ، فاتيته ، فقلت له : انهض بنا فقد ثاب القوم ، فقام فودعها وولت ، وردفته وانصرفنا . قد اتيت من هذه الاخبار والاشعار في هذا الباب وغيره باخر قبل اول ، وباول بعد اخر ، ولم الزم الترتيب في الشعراء وغيرهم ، علي قدر منازلهم واعصارهم ، لاني تبعت الخاطر فيما امل ، واصبحت عندما تذكرت او نقلت لابرا من كدر الكلفة وظلامها ، وليس في ذلك خلل يلحق الغرض الذي اممته . فلا يظنه المتصفح وصما ، ولا يعده غباوة ونقصا ، فالله تعالي يحرسنا من جهل يطلق السنة الزارين ، ويوقظنا من غفلة تنبه علنا لا نتبع الغاوين ، بمنه وسعة فضله . 
  نوادر من هذا الباب
 ممن احسن في نوادره ، ولطف في بداءعه ابو عبد الله ابن الحجاج ، فمن شعره : من الهزج بنفسي الفارغ القلب . . . وقلبي منه ملان غزال ناعس الطرف . . . ولا يقال نعسان اراه فر من رضوا . . . ن لما نام رضوان وقوله : من المنسرح ان غدرت بي فلست اجحدها . . . اني اهل لذلك الغدر شيب وفقر والغدر احسن ما . . . يكون بين المشيب والفقر والله يا سادتي يمين فتي . . . تعلم الصدق من ابي ذر لو ان لي ما لزوجها لرات . . . بحر ندي فوق بيتها يجري لو ان لابن الجصاص فيشلتي . . . لصيرت عنده علي الجحر قد بقيت بيننا مدهدهة . . . في المد من فكرها وفي الجزر ثم غني بغير فيشلة . . . وها هنا اير بلا الدر وله في السخف غزل كثير حلو عجيب الفتنة لا فراط فيه ، فمنه قوله : من الكامل المجزوء ووصيفة مثل الغلا . . . م نصيحة فيها عياره لما انتبهت اثرتها . . . والصيد في يد من اثاره  يحيي القلوب وصالها . . . وتشق جفوتها المراره وقوله في الكامل اعرضت عن سهري بطرف ناءم . . . ولهوت عن ولهي بقلب سالم وزعمت اني قد سلوتك صارما . . . حبلي وخنت بعهدك المتقادم هيهات الهاني جماعك فاعلمي . . . مذ ذقت شربك عن جميع العالم وقوله : من مجزوء الرجز قد انزعجت فاسكني . . . وقد جسرت فاجبني لا تقدمي علي دم . . . لكافر او مءمن نحن عبيد فهبي . . . مسيءنا للمحسن ولا تضني في الهوي . . . علي محب قد ضني علي سقيم ميت . . . محنط مكفن لو اشتري منك الرضي . . . بروحه لم يغبن ويح الضني الي متي . . . لا يشتفي من بدني عجبت ممن عزمها . . . في السر ان تقتلني تري بلاءي ثم لا . . . اطمع ان ترحمني وقد رثي لي من راي . . . ما بي ومن لم يرني جارية حبي لها . . . يطوي معي في كفني كالبدر حين ينجلي . . . والغصن حين ينثني وقال ابن سكرة الهاشمي في عشق اعرج : من الكامل قالوا بليت باعرج فاجبتهم . . . العيب يحدث في قضيب البان ماذا علي اذا استجدت شماءلا . . . وروادفا تغني عن الكثبان  اني احب جلوسه واريده . . . للنوم لا للجري في الميدان في كل عضو منه حسن كامل . . . ما ضرني ان زلت القدمان قال حسين بن الضحاك الخليع : كان صالح بن الرشيد يتعشق يسرا خادم اخيه ابي عيسي ، وكان يراوده عن نفسه ، فيعده ولا يفي له ، فارسله ابو عيسي يوما الي صالح اخيه في السحر يقول : يا اخي اني قد اشتهيت اليوم ان اصطبح ، فبحياتي الا ما ساعدتني ، وصرت الي حتي نصطبح اليوم جميعا . فصار يسر الي صالح وهو منتش قد شرب في السحر ، فابلغه الرسالة ، قال : نعم وكرامة ، اجلس اولا ، فجلس ، فقال : يا غلام احضرني عشة الاف درهم ، فاحضرها ، فقال له : يا يسر دعني من مواعيدك ومطلك هذه عشرة الاف درهم ، فاقض حاجتي وخذها ، والا فليس ها هنا الا الغصب ، فقال : يا سيدي انا اقضي الحاجة ولا اخذ المال ، ثم فعل ما اراده فطاوعه فقضي حاجته ، وامر صالح بحمل العشرة الاف درهم معه . قال حسين : ثم خرج الي صالح من خلوته ، فقال : يا حسين قد رايت ما كنا فيه ، فان حضرك شء فقل : فقلت : من الهزج : ايا من طرفه سحر . . . ويا من ريقه خمر تجاسرت فكاشفت . . . ك لما غلب الصبر وما احسن في امر . . . ك ان ينهتك الستر واما لامني الناس . . . ففي وجهك لي عذر فدعني من مواعيد . . . ك اذ حينك الدهر فلا والله لا نبر . . . ح او ينفصل الامر فاما الغصب والذم . . . واما البذل والشكر  فلو شءت تيسرت . . . كما سميت يا يسر فكن كاسمك لا تمن . . . عك النخوة والكبر فلا فزت بحظي من . . . ك ان ذاع له ذكر قال الحسين : فضحك ثم قال : لعمري لقد تيسر يسر كما قلت ، فقلت : نعم ، ومن لا يتيسر بعد اخذ الدية ، فلو اردتني بهذا ايضا لتيسرت ، فضحك ثم قال : نعطيك يا حسين الدية لحضورك ومساعدتك ، ولا نريدك لما اردنا له يسرا ، فبءست المطية انت . وقال حسين بن الضحاك : كان يالفني انسان من جند الشام عجيب الخلقة والزي والشكل ، غليظ جلف ، فكنت احتمل ذلك منه ، ويكون حظي التعجب منه ، وكان ياتيني بكتب من عشيقة له ، ما رايت احلي ولا اظرف منها ، ولا ابلغ ولا اشكل من معانيها ، ويسالني ان اجيب عنها ، فاجهد نفسي في الجواب ، واصرف عنايتي اليه علي علمي بان الشامي لا يميز بين الخطا والصواب لجهله ، ولا يفرق بين الابتداء والجواب . فلا طال ذلك علي حسدته ، وتنبهت علي افساد حاله عندها ، فسالته عن اسمها ، فقال : بصبص ، فكتبت اليها في جواب كتاب منها كان جاءني به : من السريع ارقصني حبك يا بصبص . . . والحب يا سيدتي يرقص ارمصت اجفاني بطول البكا . . . فما لاجفانك لا ترمص وابابي وجهك ذاك الذي . . . كانه من حسنه عصعص فجاءني بعد ذلك فقال : يا ابا علي ، ما كان ذنبي اليك وما اردت بما صنعت بي ؟ فقلت له : وما ذاك عافاك الله ؟ قال : ما هو والله الا ان وصل اليها ذلك  الكتاب حتي بعثت الي اني مشتاقة اليك ، والكتاب لا ينوب عن الرءية ، فتعال الي الروش ، الذي بالقرب من بابنا ، قف بحياله حتي اراك ، فتزينت باحسن ما قدرت عليه ، وصرت الي الموضع ، فبينا انا واقف انتظر مكلما لي او مشيرا الي ، اذا انا بشء قد صب علي فملاني من مفرقي الي قدمي ، وافسد ثيابي وسرجي ، وصيرني وجميع ما علي ودابتي في نهاية السواد والقذر ، واذا هو ماء قد خلط ببول وسواد وسرجين ، فانصرفت بخزي ، وكان ما مر بي من الصبيان وساءر من مررت به من الضحك والطنز والصياح بي اغلظ مما جري علي ، ولحقني من اهلي ومن في منزلي شر من ذلك ، واعظم من ذلك ان رسلها انقطعت عني جملة . فجعلت اعتذر اليه واقول له : ان الافة انها لم تفهم الشعر لجودته وفصاحته ، وانا احمد الله عز وجل علي ما نله واسر الشماتة به . قال المداءني : دخل ابو النجم العجلي علي هشام بن عبد الملك ، وقد اتت له سبعون سنة ، فقال له هشام : ما رايك في النساء ؟ قال : اني لانظر اليهن شزرا ، وينظرن الي خزرا ، فوهب له جارية ، وقال له : اغد علي فاعلمني ما كان منك ، فلما اصبح غدا عليه فقال : ما صنعت شيءا وما قدرت عليه ، وقد قلت في ذلك : من الكامل نظرت فاعجبها الذي في درعها . . . من حسنها ونظرت في سرباليا فرات لها كفلا ينوء بخصرها . . . وعثا روادفه واخثم رابيا ورايت منتشر العجان مقلصا . . . رخوا مفاصله وجلدا باليا ادني له الركب الحليق كانما . . . ادني اليه عقاربا وافاعيا  ما بال راسك من وراءي طالعا . . . اظننت ان حر الفتاة وراءيا فاذهب فانك ميت لا ترتجي . . . ابد الابيد ولو عمرت لياليا انت الغرور اذا خبرت وربما . . . كان الغرور لمن رجاه شافيا لكن ايري لا يرجي نفعه . . . حتي اعود اخا فتاء ناشيا مرض علي بن عبيدة ، فقيل له : ما تشتهي ؟ قال : عيون الرقباء ، والسن الوشاة ، واكباد الحساد . قال علي بن عبد العزيز يعرض بالتحاء معشوق : من السريع قد برح الحب بمشتاقك . . . فاوله احسن اخلاقك لا تجفه وارع له حقه . . . فانه اخر عشاقك وقال اخر : من المديد بابي من عينه ابدا . . . في عدات وهي لا تعد ولاخر في معشوق احول : من الطويل ونجمين في برجين هاد وحاءر . . . اذا طلعا حل الكسوف بواحد لهذا علي التمثيل قوة زهرة . . . وهذا علي التشبيه طرف عطارد وقال اخر : من السريع كانما الخيلان في خده . . . كواكب احدقن بالبدر وقال اخر : من السريع رحمت اسود هذا الخال حين بدا . . . في لجة الخد مرموقا بابصار  كانه بعض عباد الهنود وقد . . . القي بمهجته في لجة النار ذكر ان ابا القمقام بن بحر السقا عشق مدنية ، فبعث اليها ان اخوانا لي زاروني فابعثي لي برءوس حتي نتغدي ونصطبح علي ذكرك ، ففعلت ، فلما كان اليوم الثاني ، بعث اليها : اننا لم نفترق فابعثي لي بسنبوسك حتي نصطبح علي ذكرك ، ففعلت ، فلما كان في اليوم الثالث بعث اليها : اصحابي مقيمون فابعثي الي ببقرية منقورية وجزورية شهية حتي تاكلها ونصطبح علي ذكرك ، فقالت لرسوله : اني رايت الحب اذا حل بالقلب يفيض علي الكبد والاحشاء ويمنع من شهوة والطعام ، وان حب صاحبنا هذا ليس يجاوز معدته . ودعت ابا الحراث جمينا واحدة كان يحبها ، فجعلت تحادثه ولا تذكر الطعام ، فلما طال ذاك به ، قال : لا اسمع للغداء ذكرا ، قالت : اما تستحي ؟ اما في وجهي ما يشغلك عن هذا ؟ فقال : جعلني الله فداك ، لو ان جميلا وبثينة قعدا ساعة لا ياكلان شيءا لبصق كل واحد منهما في وجه صاحبه وافترقا وانشد الاعرابي في ضده : من الطويل فلو كنت عذري العلاقة لم تكن . . . سمينا وانساك الهوي كثرة الاكل وواعد العرجي امراة شعثاء من الطاءف ، فجاء علي حمار ومعه غلام ، وجاءت علي اتان ومعها جارية ، فوثب العرجي علي المراة ، ووثب الغلام علي الجارية ، ووثب الحمار علي الاتان ، فقال العرجي : هذا يوم غاءب رقباءه عنا .  وحدث احمد بن عبيد الله بن عمار قال : كنا نختلف الي المجالس ونحن احداث عن الرواة ما يروونه من الاداب والاخبار ، وكان يصحبنا فتي من احسن الناس وجها ، وانظفهم ثوبا ، واجملهم زيا ، ولا نعرف باطن امره . فانصرفنا يوما من مجلس المبرد ، وجلسنا في مجلس نتقابل بما كتبنا ، ونصحح المجلس الذي شهدنا ، فاذا بجارية قد طلعت وطرحت في حجر الفتي رقعة ما رايت احسن من شكلها ، مختومة بعنبر ، فقراها منفردا ثم اجاب عنها ، ورمي بها الي الجارية ، فلم يلبث ان خرج خادم من الدار في يده كرسي ، فدخل الينا فصفع الفتي به حتي رحمناه ، وخلصناه من يده ، وقمنا اسوا الناس حالا . فلما تباعدنا سالناه عن الرقعة ، فاذا فيها مكتوب : من الطويل كفي حزنا انا جميعا ببلدة . . . كلانا بها ثاو ولا نتكلم فقلنا له : هذا ابتداء طريف ، فاي شء اجبت ؟ فقال : هذا صوت سمعته يغني به ، فلما قراته في الرقعة ، اجبت عنه بصوت مثله ، فسالناه ما هو ؟ فقال : كتبت في الجواب : اراعك بالخابور نوق واجمال فقلنا له : ويلك ، ما وفاك القوم حقك ، قد كان ينبغي ان يدخلونا معك في القصة بدخولك معنا ، ولكن نحن نوفيك حقك ، ثم تناولناه فصفعناه حتي لم يدر اين ياخذ ، وكن اخر عهده بالاجتماع معنا . روي مصعب بن عبد الله الزبيري عن ابيه قال : اتاني ابو الساءب ليلة بعدما رقد النيام ، فاشرفت عليه فقال : سهرت وذكرت اخا لي استمتع به ،  فلم اجد سواك ، فلو مضينا الي العقيق وتناشدنا وتحادثنا ، فمضينا وانشدته في بعض ذلك يبيتن للعرجي : من الكامل باتا بانعم ليلة حتي بدا . . . صبح تلوح كالاغر الاشقر فتلازما عند الفراق صبابة . . . اخذ الغريم بفضل ثوب الاعسر فقال : اعده علي ، فاعدته ، فقال : احسن والله ، امراته طالق ان نطق بحرف غيره حتي يرجع الي بيته ، قال : فلقينا عبد الله بن الحسن ، فلما صرنا اليه وقف بنا وهو منصرف من ماله يريد المدينة ، فقال : كيف انت يا ابا الساءب ؟ فقال له : فتلازما عند الفراق ، فالتفت الي وقال : متي انكرت صاحبك ؟ فقلت : منذ الليلة ، فقال : انا لله ، واي كهل اصيبت به قريش . ثم مضينا فلقينا محمد بن عمران التيمي قاضي المدينة يريد مالا له علي بغلة ، ومعه غلام علي عنقه مخلاة فيها قيد البغلة ، فسلم وقال : كيف انت يا ابا الساءب ؟ فقال : فتلازما عند الفراق ، فالتفت الي فقال : متي انكرت صاحبك ؟ قلت : انفا ، فلما اراد المضي قال : اتدعه هكذا ، والله ما امن ان يتهور في بعض ابار العقيق ، فقال : يا غلام قيد البغلة ، فوضعه في رجله وهو ينشد البيت ويشير بيده اليه ، يري انه يفهم عنه قصته ، ثم نزل الشيخ وقال لغلامه : احمله علي بغلتي ، والحقه باهله ، فلما كان بحيث علمت انه قد فاته اخبرته بخبره ، فقال : قبحك الله ماجنا ، فضحت شيخا من قريش وغررتني . قال اسحاق الموصلي : كنت يوما بحضرة الرشيد اغنيه ، وهو يشرب فخل الفضل بن الربيع ، فقال له : ما وراءك ؟ قال : خرج الي يا امير المءمنين ثلاث جوار لي ، مكية ومدينية وعراقية ، فقبضت المدينية علي هني ، فلما انعظ وثبت العراقية عليه ، فقالت لها : ما هذا التعدي ؟ الم تعلمي ان مالكا حدثنا  عن الزهري عن عبد الله بن ظالم عن سعيد بن زيد قال : قال رسول الله صلي الله عليه وسلم من احيا ارضا ميتة فهي له ؟ فقالت الاخري : وقد حدثنا سفيان عن ابي الزناد عن الاعرج عن ابي هريرة قال : قال رسول الله صلي الله عليه وسلم : الصيد لمن صاده ، لا لمن اثاره ، فدفعتهما الاخري عنه ، وقالت : هذا لي وفي يدي حتي تصطلحا علي شء . فلما سمع الرشيد ضحك ، وامر بحملهن اليه ، فحظين عنده ، وفيهن يقول الشاعر : من الكامل ملك الثلاث الانسات عناني . . . وحللن من قلبي بكل مكان ما لي تطاوعني البرية كلها . . . واطيعهن وهن في عصياني ما ذاك الا ان سلطان الهوي . . . وبه عززن اعز من سلطاني قال : طلب اشعب من عشيقته خاتما كان معها ، فقالت : يا سيدي هذا ذهب واخاف ان تذهب ، ولكن خذ هذا العود حتي تعود . وكتب رجل الي عشيقته : ايذني لخيالك ان يلم بي ، فكتبت اليه : ابعث بدينارين حتي اجيءك انا بنفسي . قال بعضهم : رايت ام جعفر سكري في ايوان كسري ، بيدها مذري ، عليها قباء خز طاروني ، وهي تكتب علي الحاءط : من المتقارب فلا تاسفن لي ناسك . . . وان مات ذو طرب فابكه ونك من لقيت من العالمين . . . فان الندامة في تركه قال : فقلت لها : يا سيدة عبد مناف ما هذا الشرع ؟ فقالت : اسكت هذا الذي بلغنا عن ادم لما جامع حواء فقالت له : يا ابا محمد ما هذا ؟ فقال : ما هذا يقال له : النيك فقالت : زدني منه فانه طيب .  قال : وكان رجل يتعشق امراة ويتبعها في الطرقات دهرا ، الي ان امكنته من نفسها ، فلما افضي غليها لم ينتشر عليه ، فقالت له : ايرك هذا اير لءيم ، فقال : بل هو من الذين قال فيهم الشاعر : من البسيط واعظم الناس احلاما اذا قدروا نظر مغيرة بن المهلب يوما الي يزيد اخيه وهو يطالع امراته ويقول لها : اكشفي ساقك ولك خمسون الف درهم ، فقال : ويلك يا فاسق ، هات نصفها وهي طالق . ومثل هذه الحكاية ما سمعته من شرف الدين علي بن طراد الزبيني الوزير ، وان لم يكن من فن الغزل ، قال : كان ينادمني البارع ابو عبد لله الحسين الدباس ، وهو من اعيان اهل الادب والراوية ، وكان حديدا ، فيولع به ابدا فتحء منه نوادر تضحك ، فقال : فولع به احمد الحاجب ، واخرجه من الاعتدال ، فقال ابو عبد الله البارع : والله لقد مزنت خمسة دنانير لمن حمل الي امراتك ، فقال احمد ولم يتحرك ولم يضجر : اضعت مالك ، كنت تعطيني خمسة قراريط حتي احملها اليك طوعا . وقال : من الرجز لا ينفع الجارية الخضاب . . . ولا الوشاحان ولا الحقاب من دون ان تصطفق الاركاب . . . وتلتقي الاسباب والاسباب وقال اخر : من الطويل واني اشد القوم وجدا وناقتي . . . اشد ركاب القوم رجع حنين يشوق الحمي اهل الحمي ويشوقني . . . حمي بين افخاذ وبين بطون وقال اخر : من الرجز  والله لا تمسكني بضم . . . ولا بتقبيل ولا بشم الا بزعزاع يسلي همي . . . يسقط منه فتخي في كمي وقال اخر : من الطويل جزي الله خيرا ذات بعل تصدقت . . . علي عزب كيما يكون له اهل فانا سنجزيها بما صنعت بنا . . . اذا ما تزوجنا وليس لها بعل افيضوا علي عزابكم من نساءكم . . . فما في كتاب الله ان يحرم الفضل ومر ابو نواس بغلام حسن الوجه خفيف العجز ، فسءل عنه قال : من السريع ما شءت من دنيا ولكنه . . . منافق ليست له اخره وراي المامون القاضي يحيي بن اكتم يحد النظر الي الواثق بالله فقال : يا ابا محمد حوالينا ولا علينا . وسمع مخنث رجلا يغني : من مجزوء الرمل واقف في الماء عطشا . . . ن ولكن ليس يسقي فقال له : زن دينارا وغرقه . قال رجل لامراة : انا احبك ، قالت : وما الدليل علي ذلك ؟ قال : تعطيني قفيز دقيق حتي اعجنه بدموع عيني ، قالت : علي ان تجء بخبره الينا ، قال يا سيدتي ، انت تريدين خبازا لا تريدين عاشقا . كتب رجل الي غلام كان يعشقه : وضعت خدي علي الثري ارضاء لك ، فقال الغلام : هات عشرة دراهم وضع خدك علي خدي .  انشد المامون قول العباس بن الاحنف : من الطويل هم كتموني سيرهم ثم ازمعوا . . . وقالوا اتعدنا للرواح وبكروا فقال : سخروا من ابي الفضل اعزه الله . قال ابو العيناء : انشد ابو الهذيل شعرا : من الكامل واذا توهم ان يراها ناظر . . . ترك التوهم وجهها مكلوما فقال : كان ينبغي ان تناك هذه باير من خاطر . وانشد النظام : من الوافر اذا هم النديم له بلحظ . . . تمشت في مفاصله الكلوم قال : ما ينبغي ان ينادم هذا الي اعمي . كتب علي بن الجهم الي جارية يهواها شعرا : من الطويل خفي الله في من قد سلبت فءاده . . . وتيمته حتي كان به سحرا دعي البخل لا اسمع به منك انما . . . سالناكم ما ليس يعري لكم ظهرا قال ميمون بن هارون : كنا عند الحسن بن وهب ، فقال لبنات غني : من البسيط اتاذنون لصب في زيارتكم . . . فعندكم شهوات السمع والبصر لا يفعل السوء ان طال المقام به . . . عف الضمير ولكن فاسق النظر  والشعر للعباس بن الاحنف ، فضحكت ثم قالت : فاي خير في ان كان كذا واي معني ، فخجل الحسن من نادرتها عليه ، وعجبنا من حدة جوابها وفطنتها . اغتسلت نعم التي يقول فيها عمرو بن ابي ربيعة : من الطويل امن ال نعم انت غاد فمبكر في غدير ، فاقام عليه عمر يشرب منه حتي جف . رءي علي بن عبد الله الريحاني مع جارية له كان يهواها عند اخوانه ، فحان وقت الظهر فبادروا الصلاة ، وهما يتحادثان فاطالا حتي كادت الصلاة تفوت ، فقيل يا ابا الحسن : الصلاة فقال : رويدك حتي تزول الشمس ، اي حتي تقوم الجارية . ابو نواس شعر : من مجزوء الرمل وغزال تشره النفس الي حل ازاره بستطه بدوة الكاس لنا بعد ازوراره فاطفنا بنواحيه ولم نلمم بداره وقال : من المنسرح مر بنا والعيون تاخذه . . . تجرح منه مواضع القبل افرغ في قالب الجمال فلا . . . يصلح الا لذلك العمل ومرت به جارية للقاسم بن الرشيد في يديها نرجس ، فلم تكلمه ، فقال لها ، ما اقبح هجرك ، فقالت : اقبح منه افلاسك ، فقال : من السريع قلت وقد مرت بنا ظبية . . . رعبوبة في كفها نرجس  ما اقبح الهجر فقالت لنا . . . اقبح منه عاشق مفلس ومن شعره : من الوافر وناظرة الي من النقاب . . . تلاحظني بطرف مستراب كشفت قناعها فاذا عجوز . . . مسودة المفارق بالخضاب فما زالت تجشمني طويلا . . . وتاخذ في احاديث التصابي تحاول ان يقوم ابو زياد . . . ودون قيامه شيب الغراب اتت بحرابها تكتال فيه . . . فقامت وهي فارغة الجراب متي تشفي العجوز اذا استكانت . . . باير لا يقوم علي الشباب اخر : من مخلع البسيط اشكو الي الله من عجوز . . . تاخذها هبة الغيور ولا زوردية الثنايا . . . قد خضبت كفها بقير كانما وجهها قميص . . . قد فركوه علي الحصير  فارغة 
  الباب الثلاثون في انواع شتي من الخطب
  فارغة  بسم الله الرحمن الرحيم وما توفيقي الا بالله الحمد لله مسدي الاحسان وموليه ، وفاتق اللسان بالبيان ومءتيه ، يمنح الحكمة اهل الاجتباء والايثار ، ويختص من يشاء ويختار ، جعل النطق ترجمان الضمير ، وله ولاية الاخبار والتعبير ، وفضل بعضا علي بعض في الرصف والتحبير ، فكان القاصر عن ابداء ما اجنه الاخر حسيرا ملوما ، والزاءد علي ما تضمنه هذرا مذموما ، وكانت الخطابة في ذكر مواهب الله والاءه ، ونشر ما خصنا به من صنوف نعماءه ، والابانة من وحدانيته واوليته ، والدلالة علي ربوبيته وازليته ، وجدال اهل الباطل حتي يفيءوا ، ونضال المعاندين ليرجعوا وينيبوا وازليته ، وجدال اهل الباطل حتي يفيءوا ، ونضال المعاندين ليرجعوا وينيبوا ، اولي الخصيم الادره ، والخطيب الافوه ، واجدر ان نقابل نعمة الله بشكرها ، ونستعمل الة الفضيلة المعطاها في حقها وقدرها ؛ والصلاة علي رسوله النبي الامي ، المرسل باللسان المبين العربي ، الذي سلم له الفصاحة المقر ولاجاحد ، وشهد ببلاغته الغاءب والشاهد ، وعلي اله اولي المواقف المشهورة والمشاهد . 
  الباب الثلاثون في الخطب
 من شواهد الخطابة في الكتاب العزيز قوله سبحانه وتعالي في حق داود عليه السلام : وشددنا ملكه اتيناه وفصل الخطاب قال بعضهم : تتبعت خطب رسول الله صلي الله عليه وسلم ، فوجدت اواءل اكثرها : الحمد لله ، نحمده ونستعينه ، ونءمن به ، ونتوكل عليه ، ونستغفه ونتوب اليه ، ونعوذ بالله من شرور انسنا ومن سيءات اعمالنا ، من يهد الله فلا مضل له ، ومن يضلل فلا هادي له ، واشهد ان لا اله الا الله وحده لا شريك له . خطبته عليه السلام في حجة الوداع : الحمد لله ، نحمده ونستعبنه ، ونستغفره ونتوب اليه ، ونعوذ بالله من شرور انفسنا ومن سيءات اعمالنا ، من يهد الله فلا مضل له ، ومن يضلل فلا هادي له ، واشهد ان لا اله الا الله وحده لا شريك له ، واشهد ان محمدا عبده ورسوله .   اوصيكم عباد الله بتقوي الله ، واحثكم علي العمل بطاعته ، واستفتح الله بالذي هو خير . اما بعد ايها الناس ان دماءكم واموالكم عليكم حرام الي ان تلقوا ربكم كحرمة يومكم هذا ، في شهركم هذا ، الا هل بلغت ؟ اللهم اشهد . واول ربا ابدا به ربا العباس ين عبد المطلب . وان دماء الجاهلية موضوعة ، واول دم ابدا به دم عامر بن ربيعة بن الحارث بن عبد المطلب ، وان ماثر الجاهلية موضوعة غير الشدانة والسقاية . والعمد قود ، وشبه العمد ما قتل بالعصا والحجر ، وفيه ماءة بعير ، فمن ازداد فهو من الجاهلية . ايها الناس ، ان الشيطان قد يءس ان يعبد بارضكم هذه ، ولكنه قد رضي ان يطاع فيمكا سوي ذلك فيما تحقرون من اعمالكم ايها الناس ، انما النسء زيادة في الكفر ، يضل به الذين كفروا ، يحلونه عاما ويحرمونه عاما ليواطءوا عدة ما حرم الله . وان الزمان قد استدر كهيءته يوم خلق الله السموات والارض ، وان عدة الشهور عند الله اثنا عشر شهرا في كتاب الله يوم خلق السموات والارض ، منها اربعة حرم : ثلاثة متواليات وواحد فرد ذو القعدة وذو الحجة والمحرم ورجب الذي بين جمادي وشعبان . الا هل بلغت ؟ الهم اشهد . ايها الناس ، ان لنساءكم عليكم حقا ، ولكم عليهن حق ، فعليهن ان لا يوطءن فرشكم ولا يدخلن احدا تكرهونه بيوتكم الا باذنكم ، ولا ياتين بفاحشة ، فان فعلن فان اله تعالي قد اذن لكم ان تعضلوهن ، وتهجروهن في  المضاجع وتضربوهن ضربا غير مبرح ، فان انهين واطعنكم فعليكم رزقهن وكسوتهن بالمعروف ، فانما النساء عندكم عوان لا يملكن لانفسهن شيءا ، اخذتموهن بامانة الله تعالي ، واستحللتم فوجهن بكتاب الله ، فاتقوا الله في النساء واستوصوا بهن خيرا . ايها الناس اما المءمنون اخوة ، ولا يحل لامرء من مال اخيه الا عن طيب نفس منه . الا هل بلغت . اللهم اشهد . ولا ترجعن كفارا بعدي يضرب بعضكم رقاب بعض ، فاني قد تركت فيكم ما ان اخذتم به لن تضلوا : كتاب الله . الا هل بلغت ؟ اللهم اشهد . ايها الناس ، ن ان ربكم واحد ، وان اباكم واحد ، كلكم لادم ادم من تراب ؛ ان اكرمكم عند الله اتقاكم ، ليس لعربي علي اعجمي فضل الا بالتقوي . الا هل بلغت ؟ قالوا : نعم . قال : فليبلغ الشاهد الغاءب . ايها الناس ان الله تعالي قسم لكل وارث نصيبه من الميراث ، ولا تجوز لوارث وصية من اكثر من الثلث ، والولد للفراش وللعاهر الحجر ، من ادعي الي غير ابيه ، ومن تولي الي غير مواليه ، فعليه لعنة الله والملاءكة والناس اجمعين ، لا يقبل الله منه صرفا ولا عدلا ، والسلام عليكم ورحمة الله وبركاته . لما قبض رسول الله صلي الله عليه وسلم خطب سهيل بن عمرو فقال : والله ان هذا الدين الذي اصبحنا فيه سيمتد كامتداد الشمس في طلوعها . فقيل له : واني علمت ؟ فقال : رايت رجلا وحيدا فريد الامال ولا عز ولا عدد ، قام في ظل الكعبة فقال : انا رسول الله اليكم ؛ فكنا من بين ضاحك وهازل ، ومستعجل وراحم ؛ فلم يزل امره ينمي حتي دني طوعا وكرها ، ولو كان ذلك من عند غير الله تعالي ما كان الا كالكرة في يد بغض سفهاء قريش . فلا يغرنكم  هذا  يعني ابو سفيان  من انفسكم ، فانه يعلم من هذا الامر ما اعلم ، ولكن حسد بني عبد المطلب قد جثم علي صدره وتمكن في حشاه . خطب سعد بن ابي وقاص في يوم الشوري فقال : الحمد لله بديا كان واخرا يعود ، احمد كان انجاني في الضلالة ، وبصرني في العماية ؛ فبرحمة الله فاز من نجا ، وبهدي الله افلح من وعي ، وبمحمد بن عبد الله صلي الله عليه وسلم استقامت الطرق واستبانت السبل ، فظهر كل حق ومات كل باطل ، اياكم ايها النفر وقول اهل الزور وامنية الغرور ، فقد سكنت الاماني قبلكم قوما ورثوا ما ورثتم ، ونالوا ما نلتم ، فاتخذهم الله اعداء ولعنهم لعنا كثيرا ، قال الله عز وجل : لعن الذين كفروا من بني اسراءيل علي لسان داود وعيسي ابن مريم ذلك بما عصوا وكانوا يعتدون . لا يتناهون عن منكر فعلوه لبءس ما كانوا يفعلون . واني نكبت قرني فاخذت سهمي الفالج ، واخذت لطلحة بن عبيد الله في غيبته ما ارتضيت لنفسي في حضوري ، فانا به زعيم ، وبما اعطيت عنه كفيل ، والامر اليك يا ابن عوف بصدق النفس وجهد النصح ، وعلي الله قصد السبيل واليه المصير . وقال لعمر ابنه حين نطق مع القوم فبذهم ، وكانوا كلموه في الرضا عنه قال : هذا الذي اغضبني عليه ، اني سمعت رسول الله صلي الله عليه وسلم يقول : يكون قوم ياكلون الدنيا بالستنهم كما تلحس البقر الارض بالسنتها .  ومن خطبة لعلي بن ابي طالب عليه السلام في التوحيد : الحمد لله المعروف من غير رءية ، الذي لم يزل قاءما داءما اذا لا سماء ذات ابراج ، ولا حجب ذات ارتاج ، ولا ليل داج ، ولا بحر ساج ، ولا جبل ذو فجاج ، ولا فج ذو اعوجاج ، ولا ارض ذو مهاد ، ولا خلق ذو اعتماد ؛ ذلك مبتدع الخلق ووارثه ، واله الخلق ورزاقه ، ومسخر الشمس والقمر داءبين في مرضاته ، يبليان كل جديد ، ويقربان كل بعيد ، قسم ارزاقهم ، واحصي اثارهم واعمالهم ، وعدد انفاسهم وخاءنة اعينهم وما تخفي صدورهم من الضمير ، ومستقرهم ومستودعهم من الارحام والظهور ، الي ان تتناهي بهم الغايات ؛ هو الذي اشتد نقمته علي اعداءه في سعة رحمته ، واتسعن رحمته لاولياءه في شدة نقمته ، قاهر من عازه ، ومدمر من شاقه ، ومذل من ناواه ، وغالب من عاداه ؛ من توكل عليه كفه ، ومن ساله اعطاه ، ومن افترضه قضاه ، ومن شكره جزاه . عباد الله ، زنوا انفسكم من قبل ان توزنوا ، وحاسبوا من قبل ان تحاسبوا ، ونفسوا قبل ضيق الخناق ، وانقادوا قبل عنف السياق ، واعلموا انه من لم يعن علي نفسه حتي يكون له منها واعظ وزاجر لم يكن له من غيرها لا زاجرو لا واعظ . ومن خطبة له عليه السلام في المعني : الحمد لله الدال علي وجوده بخلقه ، وبمحدث خلقه علي ازليته ، وباشتباههم علي ان لا شبه له ، لا تشمله المشاعر ، ولا تحجبه السواتر ، لافتراق  الصانع والمصنوع ، والحاد والمحدود ، والرب والمربوب ، الاحد بلا تاويل والخالق لا بمعني حركة ونصب ، والسعيع لا باداة ، والبصير لا بتفريق الة ، والشاهد لا بمماسة ، والباءن لا بتراخي مسافة ، والظاهر لا برءية ، والباطن لا بلطافة ، بان من الاشياء بالقهر لها والقدرة عليها ، وبانت الاشياء بالخضوع له والرجوع اليه ؛ من وصفه فقد حده ، ومن حده فقد عده ، ومن عده فقد ابطل ازليته ، ومن قال كيف فقد استوصفه ، ومن قال اين فقد حيزه ، عالم اذ لا معلوم ، ورب اذ لا مربوب ، وقادر اذ لا مقدور . ومن خطبة له في ذكر النبي صلي الله عليه وسلم : اختاره من شجرة الانبياء ، ومشكاة الضياء ، وذءابة العلياء ، وسرة البطحاء ، ومصابيح الظلمة ، وينابيع الحكمة . وفي مثل ذلك والصلاة عليه : اللهم داحي المدحوات ، وداعم المسموكات ، وجابل القلوب علي فطرتها ، شقيها وسعيدها ، اجعل شراءف صلواتك بركاتك علي محمد عبدك ورسولك ، الخاتم لما سبق ، والفاتح لما انغلق ، والمعلن الحق بالحق ، والدافع جيشات الاباطيل ، والدامغ صولات الاضاليل ، كما حمل فاضطلع ، قاءما بامرك ، مستوفزا في مرضاتك ، غير ناكل عن قدم ولا واه في عزم ، واعيا لوحيك ، حافظا لعهدك ، ماضيا علي انفاذ امرك ، حتي اوري قبس القابس ، واضاء الطريق للخابط ، وهديت به القلوب بعد خوضات الفتن والاثام ، واقام موضحات الاعلام ونيرات الاحكام ؛ فهو امينك المامون ، وخازن علمك المخزون ، وشهيدك يوم الدين ، وبعيثك بالحق ، ورسولك الي الخلق .  اللهم افسح لهم مفسحا في ظلك ، واجزه مضاعفات الخير من فضلك ، اللهم اعل علي بناء البانين بناءه ، واكرم لديك منزله ، واتمم له نوره ، واجزه علي ابتعاثك له مقبول الشهادة ومرضي المقالة ، ذا منطق عدل وخطة فصل ؛ اللهم اجمع بيننا وبينه في برد العيش وقرار النعمة ، وامن الشهوات ولهو اللذات ، ورخاء الدعة ومنتهي الطمانينة وتحف الكرامة . ومن خطبة له عليه السلام : اين من سعي واجتهد ، وجمع وعدد ، وبني وشيد ، وزخرف ونجد ، وفرش ومهد . قال جعفر بن يحيي وقد ذكر هذا الكلام : هكذا تكون البلاغة : ان يقرن بكل كلمة اختها ، فتلوح الاولي بالثانية قبل انقاءها ، وتزيد كل واحدة في نور الاخري وضياءها . ومن خطبة له عليه السلام : نحمد علي اخذ واعطي ، وعلي ما ابلي وابتلي ، الباطن بكل خفية ، الحافظ لكل سريرة ، العالم بما تكن الصدور وما تخون العيون . ونشهد ان لا اله غيره ، وان محمدا نجيه وبعيثه ، شهادة يوافق فيها السر الاعلان والقلب اللسان . قال نوف البكالي : خطبنا امير المءمنين عليه السلام بالكوفة وهو  قاءم عل حجارة نصبها له جعدة بن هبيرة المخزومي ، وعليه مدرعة من صوف وحماءل سيفه من ليف ، وفي رجليه نعلان من ليف وكان جبينه ثفنة بعير ، فقال : الحمد لله الذي اليه مصاءر الخلق وعواقب الامر ، نحمده علي عظيم احسانه ، ونير برهانه ، ونوامي فضله وامتنانه ، حمدا يكون لحقه قضاء ، ولشكره اداء ، والي ثوابه مقربا ، ولحسن مزيده موجبا ، ونستعين يه استعانة راج لفضله ، مءمل لنفعه ، واثق بدفعه ، معترف له بالطول ، مذعن له بالعمل والقول ، ونءمن به ايمان من رجاه موقنا ، واناب اليه مءمنا ، وخضع له مذعنا ، واخلص له موحدا ، وعظمه ممجدا ، ولاذ به راغبا مجتهدا ، لم يولد سبحانه فيكون في العز مشاركا ، ولم يلد فيكون موروثا هالكا ، ولم يتقدمه وقت ولا زمان ، ولم يتعاوره زيادة ولا نقصان ، بل ظهر للعقول بما ارانا من علامات التدبير المتقن والقضاء المبرم ، فمن شواهد خلقه خلق السموات والارض موطدات بلا عمد ، وقاءمات بلاسند ، دعاهن فاجبن طاءعات مذعنات . ومنها : اوصيكم عباد الله بتقوي الله الذي البسكم الرياش ، واسبغ عليكم المعاش ، فلو ان احدا يجد الي البقاء سلما او لدفع الموت سبيلا لكان ذلك سليمان بن داود ، عليهما السلام ، الذي سخر له ملك الجن والانس مع النبوة وعظيم الزلفة ، فلما استوفي طعمته ، واستكمل مدته ، رمته قسي الفناء بنبال الموت ، واصبحت الديار منه خالية ، والمساكن معطلة ، ورثها قوم اخرون . وان لكم في القرون السالفة لعبرة : اين العمالقة وابناء العمالقة ؟ اين الفراعنة وابناء الفراعنة ؟ اين اصحاب مداءن الرس الذين قتلوا النبيين ، واطفاوا سنن المرسلين ،  واحيوا سنن الجبارين ؟ اين الذين ساروا بالجيوش ، وهزموا الالوف ، وعسكروا العساكر ، ومدنوا المداءن . ومن خطبة له عليه السلام : احمده شكرا لانعامه ، واستعينه علي وظاءف حقوقه ، عزيز الجند عظيم المجد ، واشهد ان محمدا عبده ورسوله ، دعا الي طاعته وقهر اعداءه جهادا عن دينه ، لا يثنيه عن ذلك اجتماع علي تكذيبه ، والتماس لاطفاء نوره . فاعتصموا بتقوي الله ، فان لها حبل وثيقا عروته ، ومعقلا منيعا ذروته ، وبادروا الموت وغمراته ، امهدوا له قبل حلوله ، واعدوا له قبل نزوله ، فان الغاية القيامة ، وكفي بذلك واعظا لمن عقل ، ومعتبرا لمن جهل . وقبل بلوغ الغاية ما تعملون من ضيق الارماس ، وشدة الابلاس ، وهو المطلع ، وروعات الفزع ، واختلاف الاضلاع ، واستكاك الاسماع ، وظلمة اللحد ، وخيفة الوعد ، وغم الضريح ، وردم الصفيح ، فالله الله عباد الله ، فان الدنيا ماضية بك سنن ، وانتم والساعة في قرن ، وكانها قد جاءت باشراطها ، وازفت بافراطها ، ووقفتكم علي صراطها ؛ وكانها قد اشرفت بزلازلها ، واناخت بكلاكلها وانصرمت الدنيا باهلها ، واخرجتهم من حضنها ، وكانت كيوم مضي وشهر انقضي ، وصار جديدها رثا ، وسمينها غثا ، في موقف ضنك المقام ، وامور مشتبهة عظام ، ونار شديد كلبها ، عال لجبها ، ساطع لهبها ، مغيظ زفيرها ،  متاجج سعيرها ، بعيد خمودها ، ذاك وقودها ، مخوف وعيدها ، عميق قرارها ، مظلمة اقطارها ، حامية قدورها ، فظيعة امورها وسيق الذين اتقوا ربهم الي الجنة زمرا قد امن العذاب ، وانقطع العتاب وزحزحوا عن النار واطمانت بهم الدار ، ورضوا المثوي والقرار ، الذين كانت اعمالهم في الدنيا زاكية ، واعينهم باكية ، وكان ليلهم في دنياهم نهارا تخشعا واستغفارا ، وكان نهارهم ليلا توحشا وانقطاعا ؛ جعل الله لهم الجنة ثوابا ، وكانوا احق بها واهلها في ملك داءم ونعيم قاءم ، فارعوا عباد الله ما برعايته يفوز فاءزكم ، وباضاعته يخسر مبطلكم ، وبادروا اجالكم باعمالكم ، فانكم مرتهنون بما اسفلتم ، ومدينون بما قدمتم ، وكان قد نزل بكم المخوف فلا رجعة تنالون ، ولا عثرة تقالون ، استعملنا الله واياكم بطاعته وطاعة رسوله ، وعفا عنا وعنكم بفضل رحمته . الزمر الارض واصبروا عن البلاء ، ولا تحركوا بايديكم وسيوفكم في هوي السنتكم ، ولا تستعجلوا بما لم يعجله الله لكم ، فانه من مات منكم علي فراشه وهو علي معرفة حق ربه وحق رسوله واهل بيته مات شهيدا ، ووقع اجره علي الله ، واستوجب ثواب ما يءتي من صالح عمله ، وقامت النية مقام اصلاته لسيفه ، فان لكل شء مدة واجلا . وخطب لما ورد عليه مقتل محمد بن ابي بكر وغلبة اصحاب معاوية  علي مصر ، فقال بعد ان حمد الله تعالي : الا ان مصر اصبحت قد فتحت ، الا وان محمد بن ابي بكر قد اصيب ، رحمة الله وعند الله نحتسبه ، اما والله ان كان لمن ينتظر القضاء ، ويعمل للجزاء ، ويبغض شكل الفاجر ، ويحب هدي المءمن . اني والله لا الوم نفسي في تقصير ولا عجز ؛ اني بمقاساة الحرب جد عالم خبير ، واني لاتقدم في الامر فاعرف وجه الحزم ، واقوم فيه بالراي المصيب معلنا ، واناديكم نداء المستغيث فلا تسمعون لي قولا ، ولا تطيعون لي امرا الي عواقب الفساد ، وانتم لا تدرك بكم الاوتار ، ولا يشفي بكم الغليل . دعوتكم الي غياث اخوانكم فجرجرتم جرجرة الجمل الاسر ، وتثاقلتم الي الارض تثاقل من ليس له نية في جهاد عدو ولا احتساب اجر ، وخرج جيل ضعيف كانما يساقون الي الموتوهم ينظرون . خطب الحسن بن عليهما السلام بعد وفاة ابيه فقال : اما والله ما ثنانا عن قتال اهل الشام شدة ولا ندم ، وانما كنا نقاتل اهل الشام بالسلامة والصبر ، فسبقت السلامة بالعداوة والصبر بالجزع . وكنتم في مبتداكم الي صفين ودينكم امام دنياكم ، وقد اصبحتم ودنياكم امام دينكم ، وكنا لكم وكنتم لنا ، فصرتم الان كانكم علينا ، ثم اصبحتم بعد ذلك تعدون قتيلين : قتيلا بصفين تبكون عليه وقتيلا بالنهروان تطلبون بثاره . فاما الباكي فخاذل ، واما  الطالب فثاءر ، وان معاوية قد دعا الي امر ليس فيه عز ولا نصفة ، فان اردتم الموت رددناه اليه ، وحاكمناه الي الله تعالي ، وان اردتم الحياة قبلناه واخذنا بالرضي . فناداه القوم البقية البقية . خطب معاوية بالمدينة فقال : اما بعد ، فانا قدمنا علي صديق مستبشر ، وعلي عدو مستبسر ، وناس بين ذلك ينظرون وينتظرون ، فان اعطوا منها رضوا وان لم يعطوا منها اذا هم يسخطون ، ولست اسع الناس كلهم ، فان لم تكن محمدة فلا بد من لاءمة ، ليكن لوما هونا اذا ذكر غفر ، واياكم والعظمي التي ان ظهرت اوبقت ، وان لم خفيت اوتغت . خطب معاوية بالمدينة فقال ، وكان رقي المنبر فارتج عليه ، فاستانف فارتج عليه ، فقطع الخطبة ، وقال : سيجعل الله بعد عسر يسرا ، وبعد عي بيانا ، وانتم الي امير فعال احوج منكم الي امير قوال . فبلغ كلامه عمرو بن العاص فقال : هن مخرجاتي من الشام ، استحسانا لكلامه .  وصعد زياد المنبر فلما حمد الله واثني عليه اراد الخطبة فارتج عليه فقال : معاشر الناس ان الكلام يجء احيانا وربما كوبر فعسا ، وتكلف فابي ، والتعمل لاتيه خير من التعاطي لابيه ، وساعود فاقول ؛ ثم نزل . وقدم زياد البصرة واليا لمعاوية والفسق فيها ظاهر فاش ، فخطب خطبة قال فيها : الحمد لله علي افضاله ، ونساله المزيد من نعمه واكرامه ، اللهم كما زدتنا نعما فالهمنا شكرا . اما بعد فان الجاهلية الجهلاء ، والضلالة العمياء ، والغي الموفي باهله علي النار ، ما اصبح فيه سفهاءكم ويشتمل عليه حملاءكم من الامور العظام ، كانكم لم تقرءا كتاب الله عز وجل ، ولم تسمعوا ما اعد الله من الثواب لاهل طاعته ، والعذاب الاليم لاهل معصيته ، في الزمن السرمدي الذي لا يزول . اتكونون كمن طرفت الدنيا عينه وسدت مسامعه الشهوات ، واختار الفانية علي الباقية ، ولا تدركون انكم احدثتم في الاسلام الحدث الذي لم تسبقوا اليه ، من ترككم الضعيف يقهر ويءخذ ماله ، والضعيفة المسلوبة في النهار المبصر ،  والعدد غير قليل ؟ الم يكن فيكم نهاة تمنع الغواة عن دلج الليل وغارة النهار ؟ قربتم القرابة وباعدتم الدين ، وتعتذرون بغير العذر ، وتغضون عن المختلس ؟ كل امرء منكم يذب عن سفيهه ، صنع من لا يخاف عاقبة ولا يرجو معادا . ما انتم بالحلماء ، ولقد اتبعتم السفهاء ، فلم يزل بهم ما ترون من قيامكم دونهم حتي انتهكوا حرم الاسلام ، ثم اطرقوا وراءكم كنوسا في مكانس الريب . حرام علي الطعام والشراب حتي اسويها بالارض هدما واحراقا . اني رايت اخر هذا الامر لا يصلح الا بما صلح به اوله : لين في غير ضعف ، وشدة في غير عنف . واني اقسم بالله لاخذن الولي بالمولي ، والمقيم بالظاعن ، والمقبل بالمدبر ، والصحيح منكم في نفسه بالسقيم ، حتي يلقي الرجل منكم اخاه فيقول : انج سعد فقد هلك سعيد ، او تستقيم لي قناتكم . ان كذبة المنبر تلقي منشورة ، فاذا تعلقتم علي بكذبة فقد حلت لكم معصيتي : من نقب عليه فانا ضامن له ما ذهب منه ؛ فاياي ودلج الليل ، فاني لا اوتي بمدلج الا سفكت دمه ، وقد اجلتكم في ذلك بقدر ما ياتي الخبر من الكوفة ويرجع اليكم ؛ واياي ودعوي الجاهلية فاني لا اجد احدا دعا بها الا قطعت لسانه . وقد احدثتم احداثا لم تكن ، وقد احدثنا لكل ذنب عقوبة : من غرق قوما غرقناه ، ومن احرق علي قوم احرقناه ، ومن نقب علي قوم بيتا نقبنا عليه قلبه ، ومن نبش قبرا دفناه فيه حيا . كفوا عني ايديكم والسنتكم اكف عنكم يدي ولساني . ولا يظهر من احدكم خلاف ما عليه عامتكم الا ضربت عنقه . وقد كانت بيني وبين اقوام  احن فجعلت ذلك دبر اذني وتحت قدمي ، فمن كان محسنا فليزدد احسانا ، ومن كان مسيءا فلينزع عن اساءته . اني لو علمت ان احدكم قد قتله السل من بغضي لم اكشف له قناعا ، ولم اهتك له سترا ، حتي يبدي لي صفحته ، فاذا فعل لم اناظره . فاستانفوا اموركم ، واعينوا علي انفسكم ، فرب مبتءس بقدومنا سيسر ، ومسرور بقدومنا سيبتءس . ايها الناس انا اصبحنا لكم ساسة وعنكم ذادة ، نسوسكم بسلطان الله الذي اعطاناه ونذود عنكم بفء الله الذي خولنا . فلنا عليكم السمع والطاعة فيما احببنا ، ولكم علينا العدل فيما ولينا ؛ فاستوجبوا عدلنا وفيانا بمناصحتكم ايانا . واعلموا اني مهما قصرت عنه فلن اقصر عن ثلاث : لست محتجبا عن طالب حاجة منكم ولو اتاني طارقا بليل ، ولا حابسا عطاء ولا رزقا عن ابانه ، ولا مجمرا لكم بعثا . فادعوا الله تعالي بالصلاح لاءمتكم فانهم ساستكم المءدبون ، وكهفكم الذي اليه تاوون ، ومتي يصلحوا تصلحوا ، ولا تشربوا قلوبكم بغضهم ، فيشتد لذلك غيظكم ، ويطول له حزنكم ، ولا تدركوا حاجتكم ، مع ا ، ه لو استجيب لكم فيهم كان شرا لكم . اسال الله تعالي ان يعين كلا علي كل . واذا رايتموني انفذ فيكم الامر فانفذوه علي اذلاله . وايم الله ، ان لي فيكم لصرعي كثيرة ، فليحذر كل امرء منكم ان يكون من صرعاي . فقام عبد الله بن الاهتم فقال : اشهد ايها الامير لقد اوتيت الحكمة وفصل الخطاب . فقال : كذبت ذاك نبي الله داود . فقام الاحنف فقال : انما الثناء بعد البلاء ، والحمد بعد العطاء ؛ وانا لانثني  حتي نبتلي ، ولا نحمد حتي نعطي . قال له زياد : صدقت . فقام ابو بلال يهمس وهو يقول : انبانا الله عز وجل بغير ما قلت ، قال الله عز وجل : وابراهيم الذي وفي ، الا تزر وازرة وزر اخري ، وان ليس للانسان الا ما سعي . وان سعيه سوف يري ، ثم يجزاه الجزاء الاوفي . فسمعها زياد فقال : انا لا نبلغ ما نريد فيك وفي اصحابك حتي نخوض اليكم الباطل خوضا . قيل لبعض الخطباء : لقد جودت في خطبتك . فقال : اني عرفت هذا الامر وعودي قريب من العلوق ، وطينتي قابلة للطبع ، لم يعترضني شاغل الازمان ، ولم يعتلقني طارق الحدثان ، فانا كما قال مهدي ابن الملوح : من الطويل اتاني هواها قبل ان اعرف الهوي . . . فصادف قلبا فارغا فتمكنا خطبة قس بن ساعدة الايادي : ايها الناس اجتمعوا واسمعوا وعوا : انه من عاش مات ، ومن مات فات ، وكل ما هو ات ات ، اقسم قس قسما لا كذب فيه ولا اثم : ان في السماء لخبرا ، وان في الارض لعبرا ، سقف مرفوع ، ومهاد موضوع ، وبحر مسجور ، ونجوم تسير ولا تغور . ما لي اري الانس يذهبون ولا يرجعون ؟ ارضوا بالمقام فاقاموا ام تركوا فناموا ؟ اقسم بالله قسما : ان لله دينا هو ارضي من دين نحن  عليه ؛ واراكم قد تفرقتم بالهة شتي . وان كان الله رب هذه الالهة ، انه ليجب ان يعبد وحده . كلا انه الله الواحد الصمد ، ليس بمولود ولا والد ، اعاد وابدي ، واليه المعاد غدا . وقال : من الكامل المجزوء في الذاهبين الاولي . . . ن من القرون لنا بصاءر لما رايت مواردا . . . للموت ليس لها مصادر ورايت قومي نحوها . . . يمضي الاصاغر والاكابر لا يرجع الماضي الي . . . ولا من الباقين غابر ايقنت اني لا محا . . . لة حيث صار القوم صاءر خطبة لجبلة بن حريث العبدي : ايها الناس ، انما البقاء بعد الفناء ، وقد خلقنا ولم نك شيا ، وسنعود الي مبدانا فاما رشدا واما غيا . ان العواري اليوم والهبات غدا ، لا بد من رحيل عن محل نازل ؛ الا وقد تقارب سل فاحش وعطاء جزل ، وقد اصبحتم في محل محل منزل لا يثبت فيه سرور يسر ، ولا اصابه حضور عسر ، ولا تطول فيه حياة مرجوة الا اخترمها موت مخوف ، ولا يوثق فيها بحلف ماض ، وانتم اعوان الحتوف علي انفسكم ، تسوقكم الي الفناء ، فلم تطلبون البقاء ؟ . خطبة للعملس : هل لكم في الكلمات مطر ونبات ، وبنون وبنات ، واباء وامهات ، وايات في اثر ايات : سماء مبنية ، وارض مدحية ، ضوء وظلام ، وليال وايام ، وسعيد وشقي ، ومحسن ومسي ، وفقير وغني . اين الارباب الفعلة ، ليجدن كل  عامل عمله ؟ اين ثمود وعاد ؛ اين الاباء والاجداد ؟ اين الخيل التي تشكم ، واين الظلم الذي لم ينقم ؟ . الاصل مدحوة ولكنه زاوج بينها وبين مبنية وتكون مبنية من دحيت ، والعرب تفعل ذلك وتقول : مجفو ومجفي وهو مبني من جفي . خطبة لهاشم بن عبد مناف : خطب فقال : ايها الناس ، الحلم شرف والصبر ظفر ، والجود سءدد والمعروف كنز ، والجهل سفه ، والعجز ذلة ، والحرب خدعة ، والظفر دول ، والايا غير ، والمرء منسوب الي فعله وماخوذ بعمله ، فاصطنعوا المعروف تكسبوا الحمد ، واستشعروا الجد تفوزوا به ، ودعوا الفضول يجانبكم السفهاء ، واكرموا الجليس يعمر ناديكم ، وحاموا عن الحقيقة يرغب في جواركم ، وانصفوا من انفسكم يوثق بكم ، وعليكم بمكارم الاخلاق فانها رفعة ، واياكم والاخلاق الدنية فانها تضع الشرف وتهدم المجد ، والسلام . خطب ابو طالب عبد مناف بن عبد المطلب عند تزويج رسول الله صلي الله عليه وسلم بنت خويلد رضي الله عنها : الحمد لله الذي جعلنا من ذرية ابراهيم وزرع اسماعيل ، وجعل لنا بلدا حراما وبيتا محجوجا ، وجعلنا الحكام علي الناس ، ثم ان محمدا بن عبد الله ابن اخي من لا  يوازن به فتي من قريش الا رجح به برا وفضلا ، وكرما وعقلا ، ومجدا ونبلا ، وان كان في المال قل فان المال ظل زاءل وعارية مسترجعة ، وله في خديجة ابنة خويلد رغبة ، ولها فيه مثل ذلك ، وما احببتم من الصداق فعلي . خطبة النبي صلي الله عليه وسلم وخبر تزويج فاطمة عليها السلام : روي عن انس انه قال : بينا انا مع رسول الله صلي الله عليه وسلم اذ غشيه الوحي ، فمكث هنيهة ثم افاق فقال لي : يا انس اتدري ما جاءني بخ جبريل من عند صاحب العرش عز وجل ؟ قلت : الله ورسوله اعلم . قال : ان ربي تعالي امرني ان ازوج فاطمة من علي بن ابي طالب عليهما السلام . انطلق ادع لي ابا بكر وعمر وعثمان وطلحة والزبير وعدتهم من الانصار ، فانطلقت فدعوتهم ، فلما اخذوا مقاعدهم قال النبي صلي الله عليه وسلم : الحمد لله المحمود بنعمته ، المعبود بقدرته ، المرهوب من عذابه ، المرغوب في ما عنده ، النافذ امره في سماءه وارضه ، الذي خلق الخلق بقدرته ، وميزهم باحكامه ، واعزهم بدينه ، واكرمهم بنبيه صلي الله عليه وسلم . ثم ان الله تعالي جعل المصاهرة نسبا لاحقا وامرا مفترضا ، وشج به الارحام ، والزمه الانام ، قال الله تعالي : وهو الذي خلق من الماء بشرا فجعله نسبا وصهرا ، وكان ربك قديرا . فامر الله يجري الي قضاءه ، وقضاءه يجري الي قدره ، ولكل قضاء قدر ، ولكل قدر اجل يمحو الله ما يشاء ويثبت ، وعنده ام الكتاب ثم ان ربي تعالي امرني ان ازوج فاطمة من علي بن ابي طالب ، وقد زوجتها اياه علي اربعماءة من فضة ان رضي بذلك علي .  وكان النبي صلي الله عليه وسلم قد بعث في حاجة ، ثم انه دعا بطبق من بر ، فوضعه بين ايدينا ثم قال : انتهبوا ؛ فبينا نحن ننتهب اذ دخل علي ، فتبسم النبي صلي الله عليه وسلم في وجهه ، ثم قال : يا علي ان ربي عز وجل قد امرني ان ازوجك فاطمة ، وقد زوجتك اياها علي اربعماءة مثقال فضة ان رضيت يا علي . قال : رضيت يا رسول الله . ثم ان عليا خر ساجدا شكرا لله تعالي ، فلما رفع راسه ، قال رسول الله صلي الله عليه وسلم : بارك الله عليكما وبارك فيكما ، واسعد جدكما ، واخرج منكما الكثير الطيب ؛ قال انس : فوالله لقد اخرج الله منهما الكثير الطيب . خطبة علي عليه السلام حين تزوج فاطمة عليها السلام : الحمد لله الذي قرب من حامديه ، ودنا من ساءليه ، ووعد الجنة من يتقيه ، وقطع بالنار عذر من يعصيه ، احمده بجميع محامده واياديه ، واشكره شكر من يعلم انه خالقه وباريه ، ومصوره ومنشيه ، ومميته ومحييه ، ومقربه ومنجيه ، ومثيبه ومجازيه ، واشهد ان لا اله الا الله وحده لا شريك له ، شهادة تبلغه وترضيه ، واشهد ان محمدا صلي الله عليه وسلم عبده ورسوله ، صلاة تزلفه وتدنيه ، وتعزه وتعليه ، وتشرفه وتجتنيه . اما بعد . فان اجتماعنا مما قدره الله ورضيه ، والنكاح مما امر الله به واذن فيه ، وهذا محمد صلي الله عليه وسلم قد زوجني فاطمة ابنته علي صداق مبلغه اربعماءة وثمانون درهما ، ورضيت به فاسالوه ، وكفي بالله شهيدا . قيل لما بلغ فاطمة عليها السلام ما اجمع عليه من منعها فدكا لاثت خمارها علي راسها ، واشتملت بجلبابها ، واقبلت في لمة من حفدتها ونساء قومها تطا ذيولها ، ما تخرم مشتها مشية رسول الله صلي الله عليه وسلم ، حتي دخلت علي ابي  بكر وهو في حشد من المهاجرين والانصار ، رضي الله عنهم اجمعين ، وغيرهم ، فنيطت دونها ملاءة ، ثم انت انه اجهش لها القوم بالبكاء وارتج المجلس ، ثم امهلت هنيهة حتي اذا سكن نشيج القوم وهدات فورتهم افتتحت كلامها بحمد الله والثناء عليه والصلاة علي رسول الله صلي الله عليه وسلم ثم قالت : لقد جاءكم رسول من انفسكم عزيز عليه ما عنتم حريص عليكم بالمءمنين رءوف رحيم . فان تعرفوه تجدوه ابي دون اباءكم واخا ابن عمي دون رجالكم ، فبلغ الرسالة صادعا بالنذارة بالغا بالرسالة ، ماءلا عن سنن المشركين ، ضاربا لثبجهم ، يدعو الي سبيل ربه بالحكمة والموعظة الحسنة ، اخذا باكظام المشركين ، يهشم الاصنام ويفلق الهام ، حتي انهزم الجمع وولوا الدبر ، وحتي تفري الليل عن صبحه ، واسفر الحق عن محضه ، ونطق زعيم الدين ، وخرست شقاشق الشياطين ، وتمت كلمة الاخلاص ، وكنتم علي شفا حفرة من النار ، نهزة الطامع ، ومذقة الشارب ، وقبسة العجلان ، وموطء الاقدام ، تشربون الطرق وتقتاتون القد ، اذلة خاسءين ، تخافون ان يتخطفكم الناس من حولكم ، حتي انقذكم الله تعالي برسوله صلي الله عليه وسلم ، بعد اللتيا والتي ، وبعد ان مني ببهم الرجال وذءبان العرب ومردة اهل الكتاب ، كلما اوقدوا نارا للحرب اطفاها الله ، او نجم قرن الشيطان ، او فغرت فاغرة للمشركين قذف اخاه في لهواتها ، فلا ينكفء حتي يطا صماخها باخمصه ، ويطفء عادية لهبها بسيفه ، او قالت : يخمد لهبها بحده  مكدودا في ذات الله تعالي ، وانتم في رفاهية  فاكهون امنون وادعون ، حتي اذا اختار الله لنبيه صلي الله عليه وسلم دار انبياءه ، ظهرت حسكه النفاق ، وسمل جلباب الدين ، ونطق كاظم الغاوين ، ونبغ خامل الافلين ، وهدر فنيق المبطلين ، فخطر في عرصاتكم ، واطلع الشيطان راسه صارخا بكم ، فدعاكم فالفاكم لدعوته مستجيبين ، وللغرة ملاحظين ، ثم استنهضكم فوجدكم خفاقا ، واحمشكم فالفاكم غضابا ، فوسمتم غير ابلكم ، واوردتم غير شربكم ؛ هذا والعهد قريب ، والكلم رحيب ، والجرح لما يندمل . بماذا زعمتم : خوف الفتنة ؟ الا في الفتنة سقطوا وان جهنم لمحيطة بالكافرين فهيهات منكم واني بكم واني تءفكون ، وكتاب الله تعالي بين اظهركم ، زواجره بينة ، وشواهده لاءحة ، واوامره واضحة ، ارغبة عنه تريدون ام بغيره تحكمون ؟ بءس للظالمين بدلا ومن يبتغ غير الاسلام دينا فلن يقبل منه وهو في الاخرة من الخاسرين . ثم لم تلبثوا الا ريث ان تسكن نفس نغرتها ، تسرون حسوا في ارتغاء ، ونصبر منكم علي مثل حز المدي ، وانتم الان تزعمون الا ارث لنا ، افحكم الجاهلية تبغون ؟ ومن احسن من الله حكما لقوم يوقنون ؟ ايها معشر المسلمة المهاجرة ، اابتز ارث ابي ؟ ! ابي الله ؛ افي الكتاب يا ابن ابي قحافة ان ترث اباك ولا ارث ابي ؟ لقد جءت شيءا فريا . فدونكها مخطومة مرحولة تلقاك يوم حشرك ، فنعم الحكم الله ، والزعيم محمد صلي الله عليه وسلم ،  والموعد القيامة ، وعند الله يحشر المبطلون ، ولكل نبا مستقر ، وسوف تعلمون . ثم انكفات علي قبر ابيها صلي الله عليه وسلم وقالت : من البسيط قد كان بعدك انباء وهنبثة . . . ولو كنت شاهدها لم تكثر الخطب انا فقدناك فقد الارض وابلها . . . واختل اهلك فاحضرهم ولا تغب وذكر انها لما فرغت من كلام ابي بكر رضي الله عنه والمهاجرين عدلت الي مجلس الانصار فقالت : يا معشر الفءة ، واعضاء الملة ، وحضنة الاسلام ، ما هذه الفترة في حقي والسنة في ظلامتي ؟ اما كان لرسول الله صلي الله عليه وسلم ان يحفظ في ولده ؟ لسرعان ما احدثتم ، وعجلان ذا اهالة ؟ اتقولون مات محمد صلي الله عليه وسلم فخطب جليل استوسع وهيه ، واستنهر فتقه ، وفقد راتقه ، واظلمت الارض لغيبته ، واكتابت خيرة الله لمصيبته ، وخشعت الجبال ، واكدت الامال ، واضيع الحريم ، واذيلت الحرمة عند مماته صلي الله عليه وسلم ، وتلك نازلة اعلن بها كتاب الله تعالي في فتنتكم ، في ممساكم ومصبحكم ، تهتف في اسماعكم ، ولقبله ما حلت بانبياء الله ورسله صلي الله عليه وعليهم ، وما محمد الا رسول قد خلت من قبله الرسل ، افان مات او قتل انقلبتم علي اعقابكم ، ومن ينقلب علي عقبيه فلن يضر الله شيءا وسيجزي الله الشاكرين . ايها بني قيلة ، ااهتضم تراث ابيه وانتم بمراي مني ومسمع ، تلبسكم الدعوة ، وتشملكم الحيرة ، وفيكم العدد والعدة ، ولكم الدار وعندكم الجنن ، وانتم الالي ، نخبة الله التي انتخب لدينه ، وانصار رسوله صلي الله عليه ، واهل الاسلام ، والخيرة التي  اختار الله تعالي لنا اهل البيت ، فنابذتم العرب ، وناهضتم الامم ، وكافحتم البهم ، لا نبرح نامركم فتاتمرون ، حتي دارت لكم بنا رحي الاسلام ، ودر حلب الايام ، وخضعت نعرة الشرك ، وباخت نيران الحرب ، وهدات دعوة الهرج ، واستوسق نظام الدين ، فابي جرتم بعد البيان ، ونكصتم بعد الاقدام ، واسررتم بعد الاعلان ، لقوم نكثوا ايمانهم ؟ اتخشونهم ؟ فالله احق ان تخشوه ان كنتم مءمنين . الا قد اري ان قد اخلدتم الي الخفض ، وركنتم الي الدعة ، فعجتم عن الدين ، ومحجتكم التي وعيتم ، ولفظتم التي سوغتم . وان تكفروا انتم ومن في الارض جميعا فان الله لغني حميد . الا وقد قلت الذي قلته علي معرفة مني بالخذلان الذي خامر صدوركم ، واستشعرته قلوبكم ، ولكن قلته فيضة النفس ، ونفثة الغيظ ، وبثة الصدر ، ومعذرة الحجة . فدونكموها فاحتقبوها مدبرة الظهر ، ناقبة الخف ، باقية العار ، موسومة بشنار الابد ، موصولة بنار الله الموقدة التي تطلع علي الافءدة ، فبعين الله ما تفعلون وسيعلم الذين ظلموا اي منقلب ينقلبون ، وانا ابنة نذير لكم بين يدي عذاب شديد ، فاعلموا انا عاملون وانتظروا انا منتظرون . بلغ عاءشة رضي الله عنها ان اناسا يتناولون ابا بكر الصديق رضي الله  عنه ، فارسلت الي ازفلة من الناس ، فلما حضروا سدلت استارها ، وعلت وسادها ، ثم دنت فحمدت الله عز وجل واثنت عليه وصلت علي نبيه صلي الله عليه وسلم وعذلت وقرعت وقالت : ابي وما ابي ! ابي والله لا تعطوه الايدي ، ذاك طود منيف وظل مديد ، هيهات هيهات ، كذبت الظنون ، انجح والله اذ اكديتم وسبف اذ ونيتم : من البسيط سبق الجواد اذا استولي علي الامد فتي قريش ناشءا ، وكهفها كهلا ، يريش مملقها ، ويفك عانيها ، ويراب شعبها ، حي حلته قلوبها ، ثم استشري في دينه ، فما برحت شكيمته في ذات الله حتي بني بفناءه مسجدا يحيي فيه ما امات المبطلون . وكان رحمة الله عليه غزير الدمعة وقيذ الجوانح شجي النشيج ، فانغضت اليه نسوان مكة وولدانها يسخرون منه ويستهزءون به ، الله يستهزء بهم ويمدهم في طغيانهم يعمهون . واكبرت ذلك رجالات قريش ، فحنت له قسيها ، وفوقت له سهامها ، وانتتلوه غرضا ، فما فلوا له صفاة ولا قصفوا له قناة ، ومر علي سيساءه ، حتي اذا ضرب الدين بجرانه ، والقي  بركه ، ورست اوتاده ، ودخل الناس فيه افواجا ، ومن كل شرعة اشتاتا وارسالا ، اختار الله جل اسمه لنبيه صلي الله عليه وسلم ما عنده . فلما قبض الله عز وجل رسوله صلي الله عليه وسلم ضرب الشيطان برواقه ، ومد طنبه ، ونصب حباءله ، واجلب بخيله ورجله ، واضطرب حبل الاسلام ، ومرج عهده ، وماج اهله ، وبغي الغواءل ، وظنت رجال ان قد اكثبت نهزتها ، ولات حين الذي يرجون ، واني والصديق بين اظهرهم . فقام حاسرا مشمرا ، قد جمع بين حاشيتيه ، ورفع قطريه ، فرد نشر الدين علي غره ، ولم شعثه بطيه ، واقام اوده يثقافه ، فامذقر النفاق بوطءه ، وانتاش الدين فنعشه . فلما اراح الحق علي اهله ، واقر الرءوس علي كواهلها ، وحقن الدماء في اهبها ، حضرته منيته ، نضر الله وجهه ، فسد ثلمه بنظيره في الرحمة ، ومقتفيه في السيرة والمعدلة ، ذاك عمر بن الخطاب ، لله ام حملت به ودرت عليه لقد اوحدت . فشرد الشرك شذر مذر ، وبخع الارض ونخعها ، يقال : بخع نفسه قتلها غما والنخع ان يجوز بالذبح الي النخاع ، وفي الحديث ان انخع الاسماء اي اقتلها لصاحبه ، والناخع العالم فقاءت اكلها ، ولفظت خبيءها ، ترامه ويصد عنها ، وتصدي له وياباها . ثم وزع فيءها ، وودعها كما صحبها . فاروني ماذا ترون ، واي يومي ابي تنقمون ؟ ايوم اقامته اذ عدل فيكم ، او يوم ظعنه اذ نظر لكم . اقول قولي هذا واستغفر الله لي ولكم . ولما قتل عثمان امير المءمنين قالت عاءشة رضي الله عنها : قتل ؟ ! قالوا : نعم ، قالت : فرحمه الله وغفر له ؛ اما والله لقد كنتم الي تسديد الحق  وتاييده ، واعزاز الاسلام وتاكيده ، احوج منكم الي ما نهضتم اليه من طاعة من خالف عليه ، ولكن كلما زادكم الله تعالي نعمة في دينكم ازددتم تثاقلا في نصرته طمعا في دنياكم . اما والله لهدم النعمة ايسر من بناءها ، وما اردناه اليكم بالشكر باسرع من زوال النعمة عنكم بالكفر ؛ وايم الله ، لءن كان افني اكله واخترم اجله ، لقد كان عند رسول الله صلي الله عليه وسلم كذراع البكر الازهر ؛ ولءن كانت الابل اكلت اوبارها انه لصهر رسول الله صلي الله عليه وسلم ، ولءن كان برك الدهر عليه بزوره ، واناخ عليه بكلكله ، انها لنواءب تتري تلعب باهلها وهي جادة ، وتجد بهم وهي لاعبة ؛ اما والله لقد حاط الاسلام وكنفه ، وعضد الدين وايده ، ولقد هدم الله به صياصي الكفر ، وقطع به دابر المشركين ، وقلم به اركان الضلالة . فلله تعالي المصيبة به ما افجعها ، والفجيعة ام اوجعها ، صدع الله بمقتله صفاة القلوب في الدين ، وشملت مصيبته ذروة الاسلام . قيل لما قتل الحسين بن علي عليهما السلام وجه ابن زياد راسه والنسوة الي يزيد فامر ان يحضر راس الحسين في طست ، وجعل ينكت ثناياه بقضيب وينشد : من الرمل ليت اشياخي ببدر شهدوا . . . جزع الخزرج من وقع الاسل قالت زينب بنت علي : صدق الله ورسوله يا يزيد : ثم كان عاقبة الذين  اساءا السوءي ان كذبوا بايات الله وكانوا بها يستهزءون . اظننت يا يزيد حين اخذ علينا باطراف الارض واكناف السماء فاصبحنا نساق كما تساق الاساري ان بنا هوانا علي الله وبك عليه كرامة ، وان هذا لعظم خطرك فشمخت بانفك ، ونظرت في عطفك ، جذلان فرحا حين رايت الدنيا مستوسقة لك ، والامور متسقة عليك ، وقد مهلت ونفست وهو قول الله تبارك وتعالي : ولا يحسبن الذين كفروا انما نملي لم خير لانفسهم انما نملي لهم ليزدادوا اثما ولهم عذاب مهين . امن العدل يا ابن الطلقاء تخديرك نساءك واماءك ، وسوقك بنات رسول الله صلي الله عليه وسلم قد هتكت ستورهن ، وهن مكتءبات ، تخدي بهن الاباعر ، وتحدو بهن الاعادي من بلد الي بلد ، لا يراقبن ولا يءوين ، يتشوقهن القريب والبعيد ، ليس معهن ولي من رجالهن ؟ وكي يستبطا في بغضتنا من نظر الينا بعين الشنف والشنان ، والاحن والاضغان ؟ اتقول : ليت اشياخي ببدر شهدوا ، غير متاثم ولا مستعظم وانت تنكث ثنايا ابي عبد الله بمخصرتك ؟ ولم لا تكون كذلك وقد نكات القرحة واستاصلت الشافة ، باهراقك دماء ذرية محمد صلي الله عليه وسلم ونجوم الارض من ال عبد المطلب ؟ ! ولتردن علي الله وشيكا موردهم ولتودن انك عميت وبكمت ولم تقل : لاهلوا واستهلوا فرحا . اللهم خذ لنا بحقنا ، وانتقم لنا ممن ظلمنا . والله ما فريت الا في جلدك ، ولا حززت الا في لحمك ، وسترد علي رسول الله صلي الله عليه وسلم برغمك ، وعترته ولحمته في حظيرة القدس يوم يجمع الله شملهم ملمومين من الشعث ، وهو قول الله تعالي : ولا تحسبن الذين قتلوا في سبيل الله امواتا بل احياء عند ربهم يرزقون ، فرحين . وسيعلم من بواك ومكنك من رقاب  المءمنين اذا كان الحاكم الله تعالي والخصم محمد صلي الله عليه وسلم ، وجوارحك شاهدة عليك ، فبءس لظالمين بدلا ، وايكم شر مكانا واضعف جندا ، مع اني والله يا عدو الله وابن عدوه استصغر قدرك ، واستعظم تقريعك ، غير ان العيون عبري ، والصدور حري ، وما يجزي ذلك او يغني عنا . وقد قتل الحسين عليه السلام حزب الشيطان تقربا الي حزب السفهاء ليعطوهم اموال الله تعالي علي انتهاك محارم الله . فهذه الايدي تنطف من دماءنا ، وهذه الافواه تتحلب من لحومنا ، وتلك الجثث الزواكي تقتاتها غيلان الفلوات . فلءن اتخذتنا مغنما لنتخذنك مغرما حين لا تجد الا ما قدمت يداك ، تستصرخ بابن مرجانة ويستصرخ بك ، ونتقاضي عند الميزان ، وقد وجدت افضل زاد زودك معاوية قتلك ذرية محمد صلي الله عليه وسلم ؛ فوالله ما اقتقيت غير الله ، ولا شكواي الا الي الله ، فكد كيدك ، واسع سعيك ، وناصب جهدك ، فوالله لا يرحض عنك عار ما اتيت الينا ابدا . والحمد لله الذي ختم بالسعادة والمغفرة لسادات شبان الجنان ، واوجب لهم الجنة . اسال الله ان يرفع لهم الدرجات ، وان يوجب لهم المزيد من فضله فانه ولي قدير . وقال بعضهم : رايت ام كلثوم بنت علي عليه السلام بالكوفة ، ولم ار خفرة والله انطق منها كانها تنطق علي لسان امير المءمنين ، وقد اومات الي الناس وهم يبكون علي الحسين ان اسكتوا ، فلما سكنت فورتهم وهدات الاجراس قالت : ابدا بحمد الله والصلاة علي نبيه صلي الله عليه وسلم . اما بعد ، يا اهل الكوفة ،  يا اهل الختر والخذل والختل ، الا فلا رقات العبرة ، ولا هدات الرنة ، انما مثلكم كمثل التي نقضت غزلها من بعد قوة انكاثا تتخذون ايمانكم دخلا بينكم . الا وهل فيكم الا الصلف والشنف وملق الاماء وغمز الاعداء ؟ وهل انتم الا كمرعي علي دمنة او كقصعة علي ملحودة ؟ الا ساء ما قدمت لكم انفسكم : ان سخط الله عليكم وفي العذاب انتم خالدون . اتبكون ؟ اي والله ، فابكوا ، فانكم والله احرياء بالبكاء ، فابكوا كثيرا واضحكوا قليلا ، فقد فزتم بعارها وشنارها ، ولن ترحضوها بغسل بعدها ابدا . واني ترحضون قتل سليل خاتم النبوة ومعدن الرسالة ، وسيد شباب اهل الجنة ، ومنار محجتكم ومدرة حجتكم ، ومفزع نازلتكم ؟ فتعسا ونكسا ، لقد خاب السعي ، وخسرت الصفقة ، وبءتم بغضب من الله وضربت عليكم الذلة والمسكنة . لقد جءتم شيءا ادا تكاد السموات يتفطرن منه وتنشق الارض وتخر الجبال هدا . اتدرون اي كبد لرسول الله صلي الله عليه وسلم فريتم ؟ واي كريمة له ابرزتم ؟ واي دم له سفكتم ؟ لقد جءتم بها شوهاء خرقاء طلاع الارض والمساء . افعجتم ان قطرت دما ؟ ولعذاب الاخرة اخزي وهم لا ينصرون . فلا يستخفنكم المهل ، فانه لا تحفزه المبادرة ، ولا يخاف عليه فوت الثار . كلا ان ربك لنا ولهم ولكم بالمرصاد . ثم ولت عنهم فتركت الناس حياري وقد ردوا ايديهم الي افواههم . ورايت شيخا كبيرا من بني جعفر وقد اخضلت لحيته من دموع عينيه ، وهو يقول بصوت حزين : من الطويل  كهولهم خر الكهول ونسلهم . . . اذا عد نسل لا يبور ولا يخزي خطبت حفصة بنت عمر رضوان الله عليها فقالت : الحمد لله الذي ال نظير له ، الفرد الذي لا شريك له . واما بعد : فكل العجب من قوم زين لهم الشيطان افعالهم وارعوي الي صنيعهم ، ودب الي الفتنية لهم ، ونصب حباءله فخلتهم ، حتي هم عدو الله باحياء البدعة ونشر الفتنة ، وتجديد الجور بعد دروسه ، واظهاره بعد دثوره ، واراقة الدماء ، واباحة الحمي ، وانتهاك محارم الله عز وجل بعد تحصينها ، فتضرم وهاج وتوغر وثار غضبا لله عز وجل ونصرة لدين الله ، فخسا الشيطان ووقم كيده ، وكف ارادته ، وقدع محنته ، واصغر خده ، لسبقه الي مشايعة اولي الناس بخلافة رسول الله صلي الله عليه وسلم ، الماضي علي سنته ، المقتدي بدينه ، المقتص لاثره ، فلم يزل سراجه زاهرا ، وضوءه لامعا ، ونوره ساطعا ، له من الافعال الغرر ، ومن الاراء المصاص ، ومن التقدم في طاعة الله تعالي اللباب ، الي ان قبضه الله تعالي اليه ، قاليا لما خرج منه ، شاءنا لما ترك من امره ، شنفا لما كان فيه ، صبا الي ما صار اليه ، واءلا الي ما دعي اليه ، عاشقا لما هو فيه . فلما صار الي التي وصفت ، وعاين ما ذكرت ، اوما بها الي اخيه في المعدلة ، ونظيره في السيرة ، وشقيقه في الديانة ؛ ولو كان غير الله سبحانه اراد لامالها الي ابنه ، ولصيرها في عقبه ، ولم  يخرجها من ذريته . فاخذها بحقها ، وقام فيها بقسطها ، لم يءده ثقلها ، ولم يبهطه حفءها ، مشردا للكفر عن موطنه ، ونافرا له عن وكره ، ومثيرا له عن مجثمه ، حتي فتح الله عز وجل علي يديه اقطار البلاد ، ونصر الله يقدمه ، وملاءكته تكنفه ، وهو بالله تعالي معتصم وعليه متوكل ، حتي تاكدت عري الحق عليكم عقدا ، واضمحلت عري الباطل عنكم حلا ، نوره في الدجنات ساطع ، وضوءه في الظلمات لامع ، قاليا للدنيا اذ عرفها ، لافظا لها اذ عجمها ، وشاءنا لها اذ سبرها ، تخطبه ويقالها ، وتريده وياباها ، لا تطلب سواه بعلا ، ولا تبغي سواه فحلا ، اخبرها ان التي يطلب ويخطب ارغد منها عيشا ، وانضر منها حبورا ، وادوم منها سرورا ، وابقي منها خلودا ، واطول منها اياما ، واغدق منها انهارا ، وانعت منها جمالا ، واتم بلهنية ، واعذب منها رفاهية ، فبشعت نفسه بذلك لعادتها ، واقشعرت لمخالفتها ، فعركها بالعزم الشديد حتي اجابت ، وبالراي الجليد حتي انقادت . واقام فيها دعاءم الاسلام ، وقواعد السنة الجارية ، ورواسي الاثار الماضية ، واعلام اخبار النبوة الطاهرة ، وظل خميصا من بهجتها ، قاليا لاتاءها ، لا يرغب في زبرجها ، ولا يطمح الي جدتها ، حتي دعي فاجاب ، ونودي فاطاع علي تلك الحال ، فاحتذي في الناس باخيه ، فاخرجها من نسله ، وصيرها شوري بين اخوته ، فباي افعاله تتعلقون ؟ وباي مذاهبه تتمسكون ؟ ابطراءقه القويمة في حياته ام بعدله فيكم عند مماته ؟ الهمنا الله واياكم طاعته ، واذا شءتم ففي حفظ الله وكلاءته . لما قتل عثمان بن عفان رحمة الله عليه صاحت ابنته عاءشة : يا  ثارات عثمان ! انا لله وانا اليه راجعون . افيتت نفسه وطل دمه في حرم رسول الله صلي الله عليه وسلم ، ومنع من دفنه ؛ ولو يشاء لامتنع ووجد من الله تعالي حاكما ، ومن المسلمين ناصرا ، ومن المهاجرين شاهدا ، حتي يفء الي الحق من شذ عنه او تطيح هامات وتفري غلاصم وتخاض دماء ؛ ولكن استوحش مما انستم به ، واستوخم وما استمراتموه . يا من استحل حرم الله ورسوله واستباح حماه ، لقد نقمتم عليه اقل مما اتيتم اليه ، فراجع ولم تراجعوه ، واستقال فلم تقيلوه ، رحمة الله عليك يا ابتاه ، احتسبت نفسك وصبرت لامر ربك حي لحقت به ، وهءلاء الان قد ظهر منهم تراوض الباطل ، واذكاء الشنان ، وكوامن الاحقاد ، وادراك الاحن والاوتار ، وبذلك وشيكا كان كيدهم وتبغيهم ، وسعي بعضهم ببعض ، فما اقالوا عاثرا ، ولا استعتبوا مذنبا ، حتي اتخذوا ذلك سببا الي سفك الدماء واباحة الحمي ، وجعلوا سبيلا الي الباساء والعنت ، فهلا علت كلمتكم وظهرت حسكتكم اذ ابن الخطاب قاءم علي رءوسكم ، ماثل في عرصاتكم ، يرعد ويبرق بارعابكم ، يقمعكم غير حذر من تراجعكم الاماني بينكم ، وهلا نقمتم عليه عودا وبدءا اذ ملك ويملك عليكم من ليس فيكم بالخلق اللين والمنظر الفضيل ، يسعي عليكم وينصب لكم ، لا تنكرون ذلك منه خوفا من سطوته ، وحذرا من شدته ، ان يهتف بكم متقسورا او يصرخ بكم مغذمرا ، ان قال صدقتم قالته ، وان سال بذلتم سالته ؛ يحكم في رقابكم واموالكم كانكم عجاءز صلع واماء قطع ، فبدا معلنا لابن ابي قحافة بارث نبيكم علي بعد رحمه وضيق بلده ، وقلة عدده . فوقي الله شرها . زعم لله دره ما اعرفه بما صنع ، او لم يخصم الانصار بقيس ، ثم حكم بالطاعة لمولي ابي حذيفة ، يتمايل بكم يمينا وشمالا ، قد خطب عقولكم  واستمهر وجلكم ، ممتحنا لكم ، ومتعرفا اخطاركم . وهل تسمو هممكم الي منازعته ، ولولا تيك لكان قسمه خسيسا ، وسعيه تعيسا ، لكن بدا الراي وثني بالقضاء وثلث بالشوري ، ثم غدا سامرا مسلطا ، درته علي عاتقه ، فتطاطاتم له ، ووليتموه ادباركم ، حتي علا اكتافكم ، ينعق بكم في كل مرتع ، ويشد منكم علي كل مخنق ، لا ينبعث لكم هتاف ، ولا ياتلق لكم شهاب ، عرفتم او انكرتم ، لا تالمون ولا تستنطقون ، حتي اذا عاد الامر فيكم ولكم واليكم في مونقة من العيش ، عرقها وشيج ، وفرعها عميم ، وظلها ظليل ، تتناولون من كثب ثمارها اني شءتم رغدا ، وحلبت عليكم عشار الارض دررا ، واستمراتم اكلكم من فوقكم ومن تحت ارجلكم ، تنامون في الخفض ، وتسكنون الي الدعة ، ومقتم زبرجة الدنيا ، واستحليتم غضارتها ونضرتها ، وظننتم ان ذلك سياتيكم من كثب عفوا ، ويتحلب عليكم رسلا ، فانتضيتم سيوفكم ، وكسرتم جفونكم ، وقد ابي الله ان تشام سيوف جردت بغيا وظلما ؛ ونسيتم قول الله عز وجل : ان الانسان خلق هلوعا اذا مسه الشر جزوعا واذا مسه الخير منوعا . فلا يهنءكم الظفر ، ولا يستوطن بكم الحر ، فان الله تعالي بالمرصاد ، واليه المعاد . والله ما يقوم الظليم الا علي رجلين ، ولا ترن القوس الا علي سيتين . فاثبتوا في الغرز ارجلكم فقد ضللتم هداكم في المتيهة الخرقاء كما اضل ادحيته الحسل . وسيعلم كيف يكون اذا كان الناس عباديد ، وقد نازعتكم الرجال ، واعترضت عليكم الامور ، وساورتكم الحروب بالليوث ، وقارعتكم الايام بالجيوش ، وحمي عليكم الوطيس ، فيوما تدعون من لا يجيب ، ويما تجيبون من لا يدعو . وقد بسط باسطكم كلتا يديه يري انهما  في سبيل الله ، فيد مقبوضة واخري مقصورة ، والرءوس تنزو عن الطلي والكواهل ، كما ينقف التنوم ، فما ابعد نصر الله من الظالمين ؛ واستغفر الله تعالي مع المستغفرين ، والحمد لله رب العالمين . وان في هذه الخطب التي ذكرناها للنساء بيانا عن فضيلة العرب بما خصهم الله تعالي من النطق والبيان ، وميزهم فيه علي ساءر الامم . قال الجاحظ : لا تعرف الخطب الا العرب والفرس ؛ فاما الهند فلهم معان مدونة وكتب مخلدة ، لا تضاف الي رجل معروف ولا الي عالم موصوف ، وانما هي كتب متوارثة ، واداب علي وجه الدهر مذكورة . ولليونانيين فلسصفة وصناعة منطق . وكان صاحب المنطق نفسه بكء اللسان ، غير موصوف البيان ، مع علمه بتميز الكلام وتفصيله ومعانيه وخصاءصه . وهم يزعمون ان جالينوس كان انطق اللسان ، ولم يذكروه بالخطابة ، ولا بهذا الجنس من البلاغة . وفي الفرس خطباء الا ان كلام للفرس وكل معني للعجم فانما هو عن طول فطرة ، وعن اجتهاد راي وطول خلوة ، وعن مشاورة ومعاونة ، وعن طول التفكر ودرساة الكتب وحكاية الثاني علم الاول ، وزيادة الثالث في علم الثاني ، حتي اجتمعت ثمار تلك الفكر عند اخرهم . وكل شء للعرب فانما هو ديهة وارتجال ، وكانه الهام ، وليست هناك معانا ولا مكابدة ، ولا اجالة فكر ولا استعانة ، وانما هو ان يصرف وهمه  الي الكلام ، او الي رجز يوم الخصام ، او حين يمتح علي راس بءر او يحدو ببعير ، او عند المقارعة او المناقلة ، او عند صراع او في حرب ، فما هو الا ان يصرف وهمه الي جملة المذهب ، وغلي العمود الذي اليه يقصد ، فتاتيه المعاني ارسالا ، وتنثال عليه الالفاظ انثيالا ، ثم لا يعيده علي نفسه ، ولا يدرسه احد من ولده . وكانوا اميين لا يكتبون ، ومطبوعين لا تيكلفون ، وكان الكلام الجيد عندهم اكثر واظهر ، وهم عليه اقدر وله اقهر ، وكل واح في نفسه انطق ، ومكانه في البيان ارفع . وخطباءهم للكلام اوجد ، والكلام عليهم اسهل ، وهو عندهم ايسر من ان يتفقروا الي تحفظ ، ويحتاجوا الي تدارس ؛ وليس هم كمن حفظ علم غيره ، واحتذي علي كلام من كان قبله ، فلم يحفظوا الا ما علق بقلوبهم ، والتحم بصدورهم ، واتصل بعقولهم من غير تكلف ولا قصد ولا تحفظ ولا طلب . وان شيءا هذا الذي في ايدينا جزء منه لبالمقدار الذي لا يعلمه الا من احاط بقطر السحاب وعدد التراب ، وهو الله المحيط بما كان ، والعالم بما سيكون . ونحن اذا ادعينا للعرب اصناف البلاغة من القصيد والارجاز ، ومن المنثور والاسجاع ، ومن المزدوج وما لا يزدوج ، فمعنا علي ذلك لهم شاهد صادق من الديباجة الكريمة ، والرونق العجيب ، والسبك والنحت الذي لا يستطيع اشعر الناس اليوم ، ولا ارفعهم في البيان ان يقول مثل ذلك الا في اليسير والشء القليل . ونحن لا نستطيع ان نعلم ان الرساءل التي في ايدي الناس للفرس صحيحة غير مصنوعة ، وقديمة غير مولدة ، اذ كان مثل ابن المقفع وسهل بن هارون وابي عبيد الله وعبد الحميد وغيلان يستطيعون ان يولدوا مثل تلك  الرساءل ، ويصنعوا مثل تلك السير . والمثل يضرب في الخطابة بسحبان واءل ، وكان خطيب العرب غير مدافع ولا منازع ، وكان ابنه عجلان ايضا خطيبا بليغا ، وكان سحبان اذا خطب لم يعد حرفا ، ولم يتوقف ولم يتحبس ، ولم يعد كلاما ولم يتفكر في استنباط ، وكان يسيل عرقا كانه اذي بحر . ويقال ان معاوية قدم عليه وفد من خراسان ، وجههم سعيد بن عثمان ، فطلب سحبان فلم يوجد عامة النهار ، ثم اقتضب من ناحية كان فيها اقتضابا ، فادخل عليه فقال : تكلم ، فقال : انظروا لي عصا تقيم من اودي . فقالوا : وما تصنع بها وانت بحضرة امير المءمنين ؟ قال : ما كان يصنع بها موسي صلي الله عليه وهو يخاطب ربه وعصاه في يده ؟ فضحك معاوية وقال : هاتوا له عصا . فجاءه بعصاه ، فاخذها ثم قام فتكلم منذ صلاة الظهر الي ان فاتت صلاة العصر ، ما تنخع ولا سعل ، ولا توقف ولا تحبس ، ولا ابتدا في معني فخرج عنه وقد بقي عليه فيه شء ، وسال عن اي جنس من الكلام يخطب فيه . فما زالت تلك حاله ، وكل عين في السماطين والحفل قد شخصت نحوه ، الي ان اشار اليه عاوية الصلاة فقال : هي امامك ونحن في صلاة يتبعها تمجيد وتحميد ، وعظة وتنبيه وتذكير ، ووعد ووعيد . قال معاوية : انت اخطب العرب قاطبة . قال سحبان : والعجم والجن والانس . لما دخل عبد الملك بن مروان الكوفة بعد قتل مصعب خطبهم  فقال : يا اهل العراق اني اذا قلت مقالا عقدته بفعال ، ووصلت وعيدي بمطال ، ثم جعلت من نفسي عليها رقيبا يتقاضاني الوفاء ، فاسبق بالعقاب الي اهل الظنة ، واتناول بالكرامة من قعد عن الفتنة . فاياكم واياكم ما دمت استكف نفسي عنكم ، واياكم واياكم وعدا غير ملوي ، وزجرا غير منسي ، فطالما اوضعتم في اودية الضلالة ، واعتبقتم مطايا المعصية ، واستدرتنا كفكم العقوبة ، فلما مريتم اخلاف النقمة صررناها بمصاهرة النعمة . واذا اهملتم ركاءب السطوة عقلناها بفضل العاءدة . تدفعون حقنا ويابي قضاء الله الا تقليدكم اياه ، وتوجفون في غيكم ونكدح في اقبالكم ، فبذنوكم سفه رايكم : ترابية مرة ، وزبيرية اخري . حتي متي ، والي متي نسعي في صلاحكم ؟ الا واني لااخذ بسالف الجراءم ، ولا اعاقب بمتقدم العصيان ، وانما بكم ما استقبلتم به انفسكم . الا وكل ما كان فتحت قدمي ودبر اذني ، رغبة لكم فيما لم ترغبوا فيه لانفسكم ، وحرصا علي ا اضعتموه منا فيكم ، فاعقبوا بين الدول ، واجعلوا للحق نصيبا منكم ، واغدوا علي اعطياتكم . ولما اتي عبد الله بن الزبير قتل مصعب اخيه خطب الناس فحمد الله واثني عليه ثم قال : انه اتانا خبر قتل مصعب فسررنا واكتابنا ، فاما السرور فلما قدر له من الشهادة وخير له من الثواب ، واما الكابة فلوعة يجدها الحميم عند فراق حميمه ، وانا والله ما نموت حبجا كميتة ال ابي العاص ، انما نموت قتلا  بالرماح ، وقصعا تحت ظلال السيوف ، وان يهلك المصعب فان في ال الزبير منه خلفا له . ولما قتل الحجاج بن عبد الله بن الزبير ارتجت مكة بالبكاء ، فامر الحجاج يجمع الناس الي المسجد ، ثم صعد المنبر فحمد الله واثني عليه ثم قال : يا اهل مكة بلغني اكباركم واستعظامكم قتل ابن الزبير ، الا وان ابن الزبير كان من خيار هذه الامة حتي رغب في الخلافة ، ونازع فيها اهلها ، فخلع طاعة الله واستكن بحرم الله . ولو كان شء مانعا للقضاء لمنع ادم حرمة الجنة ، لان الله تعالي خلقه بيده ، ونفخ في من روحه ، واسجد له ملاءكته ، واباحه جنته ، فلما اخطا اخرجه من الجنة بخطءه ، وادم اكرم علي الله من ابن الزبير ، والجنة اعظم حرمة من الكعبة ، فاذكروا الله تعالي يذكركم . وصعد المنبر بعد قتله متلثما ، فحط اللثام عن وجهه وقال : موج ليل التطم فانجلي بضوء صبحه . يا اهل الحجاز ، كيف رايتموني ؟ الم اكشف عنكم ظلمة الجور وطخية الباطل بنور الحق ؟ والله لقد وطءكم الحجاج وطاة مشفق عطفته رحم ووصل قرابة . فاياكم ان تزلوا عن سنن ما اقمناكم فاقطع عنكم ما وصلته لكم بالصارم البتار ، واقيم من اودكم ما يقيم المثقف من اود القنا بالنار اليكم ! ثم نزل وهو يقول من الطويل  اخوا لحرب ان عضت به الحرب عضها . . . وغن شمرت عن ساقها الحرب شمرا وخطب فقال : يا اهل العراق ، ان الفتنة تلقح بالنجوي ، وتنتج بالشكوي ، وتحصد بالسيف ، اما والله لءن ابغضتموني فما تضروني ، ولءن احببتموني فما تنفعوني ، وما انا بالمستوحش لعداواتكم ، ولا المستريح لمودتكم . زعمتم اني ساحر وقال الله تعالي : ولا يفلح الساحر حيث اتي ؛ وزعمتم اني احسن الاسم الاعظم ، فلم تقاتلون من يعلم ما لا تعلمون ؟ ثم التفت الي اهل الشام فقال : لارواحكم اطيب من ريح المسك ، ولدنوكم انس من الولد ، وما مثلكم الا كما قال اخو ذبيان : من الوافر اذا حاولت في اسد فجورا . . . فاني لست منك ولست مني هم درعي التي استلامت فيها . . . الي يوم النسار وهم مجني ثم قال : يا اهل الشام بل انتم كما قال الله عز وجل : ولقد سبقت كلمتنا لعبادنا المرسلين انهم لهم المنصورون . قام خالد بن عبد الله القسري علي المنبر بواسط خطيبا ، فحمد الله واثني عليه وصلي علي النبي صلي الله عليه وسلم ثم قال : ايها الناس ، تنافسوا في المكارم ، وسارعوا الي المغانم ، واشتروا الحمد بالجود ، ولا تكسبوا بالمطل ذما ، ولا تعتدوا بالمعروف ما لم تعجلوه ، ومهما يكن لاحد عند احد نعمة فلم يبلغ شكرها فالله احسن لها جزاء واجزل عليها عطاء ؛ واعلموا ان حواءج الناس  اليكم نعم من الله تعالي عليكم ، فلا تملوا النعم فتحول نقما ؛ واعلموا ان افضل المال ما اكسب اجرا واورث ذكرا ؛ ولو رايتم المعروف رجلا لرايتموه حسنا جميلا ، يسر الناظرين ويفوق العالمين ؛ ولو رايتم البخل رجلا لرايتموه رجلا مشوها قبيحا ، تنفر عنه القلوب وتغضي عنه الابصار . ايها الناس ان اجود الناس من اعطي من لا يرجوه ، واعظم الناس عفوا من عفا عن قدرة ، واوصل الناس من وصل من قطعه ، ومن لم يطب حرثه لم يزل نبته ، والاصول عن مغارسها تنمو ، وباصولها تسمو . اقول قولي هذا واستغفر الله لي ولكم . قيل لما ولي ابو بكر بن عبد الله بن حزم المدينة وطال مكثه عليها ، كان يبلغه عن قوم من اهلها تناول لاصحاب رسول الله صلي الله عليه وسلم واسعاف من اخرين لهم علي ذلك ، فامر اهل البيوتات ووجوه الناس في يوم الجمعة ان يقربوا من المنبر ، فلما فرغ من خطبة الجمعة قال : ايها الناس ، غني قاءل قولا ، فمن رعاه واداه فعلي الله جزاءه ، ومن لم يعه فلا يعدمن ذما ، مهما قصرتم عنه في تفصيله فما تعجزون عن تحصيله ، فارعوه ابصاركم ، واوعوه اسماعكم ، واشعروه قلوبكم ، فالموعظة حياة ، والمءمنون اخوة ، وعلي الله قصد السبيل ، ولو شاء لهداكم اجمعين . فاتقوا الله واتوا الهدي تهتدوا ، واجتنبوا الغي ترشدوا ، وانيبوا الي الله ايها المءمنون لعلكم تفلحون . والله جل ثناءه وتقدست اسماءه امركم بالجماعة ورضيها لكم ، ونهاكم عن الفرقة وسخطها منكم ، فاتقوا الله حق تقاته ولا تموتن الا وانتم مسلمون ، واعتصموا بحبل الله جميعا ولا تفرقوا واذكروا نعمة الله عليكم اذ كنتم اعداء فالف بين قلوبكم فاصبحتم بنعمته  اخوانا وكنتم علي شفا حفرة من النار فانقذكم منها . جعلنا الله واياكم ممن ينبع رضوانه ويتجنب سخطه ، فانما نحن به وله . ان الله تعالي بعث محمدا صلي الله عليه وسلم بالدين ، واختاره علي العالمين ، واختار له اصحابا علي الحق ، ووزارء دون الخلق ، اختصهم به ، وانتخبهم له ، فصدقوه وعززوه ووقروه ، فلم يقدموا الا بامره ، ولم يحجموا الا عن رايه ، وكانوا اعوانه بعهده ، وخلفاءه من بعده ، فوصفهم باحسن صفتهم ، وذكرهم فاثني فقال عز وجل وقوله الحق : محمد رسول الله والذين معه اشداء علي الكفار رحماء بينهم تراهم ركعا سجدا يبتغون فضلا من الله ورضوانا سيماهم في وجوههم من اثر السجود ذلك مثلهم في التوراة ومثلهم في الانجيل كزرع اخرج شطاه فازره فاستغلظ فاستوي علي سوقه يعجب الزراع ليغيظ بهم الكفار وعد الله الذين امنوا وعملوا الصالحات منهم مغفرة واجرا عظيما . فمن غاظوه فقد كفر وخاب وفجر وخسر ، قال الله عز وجل : للفقراء المهاجرين الذين اخرجوا من ديارهم واموالهم يبتغون فضلا من الله ورضوانا وينصرون الله ورسوله اولءك هم الصادقون ، الذين تبواوا الدار والايمان من قبلهم يحبون من هاجر اليهم ولا يجدون في صدورهم حاجة مما اوتوا ويءثرون علي انفسهم ولو كان بهم خصاصة ومن يوق شح نفسه فاولءك هم المفلحون ، والذين جاءوا من بعدهم يقولون ربنا اغفر لنا ولاخواننا الذين سبقونا بالايمان ولا تجعل في قلوبنا الا للذين امنوا ربنا انك رءوف رحيم . فمن خالف شراءط الله تعالي عليه لهم ، وامره اياه فيهم ، فلا حق له في الفء ، ولا سهم له في الاسلام ، في اي كثير من القران ؛ فمرقت مارقة من الدين وفارقوا المسلمين ، وجعلوهم عضين ، وتشعبوا احزابا ، واشابات واوشابا ، فخالفوا كتاب الله فيهم ، وثناءه عليهم ، واذوا رسول الله صلي الله عليه وسلم ، فخابوا وخسروا الدنيا  والاخرة ، ذلك هو الخسران المبين . افمن كان علي بينة من ربه كمن زين له سوء عمله واتبعوا اهواءهم . ما لي اري عيونا خزرا ، ورقابا صعرا ، وبطونا بجرا ، وشجي لا يسيغه الماء ، وداء لا يءثر فيه الدواء . افنضرب عنكم الذكر صفحا ان كنتم قوما مسرفين ، كلا بل والله هو الهناء والطلاء ، حتي يطر العر ويبوح الشر ، ويضح العيب ، ويستوسق الجيب ، فانكم لم تخلقوا عبثا ، ولن تتركوا سدي . ويحكم اني لست اتاويا اعلم ، ولا بدويا افهم ، وقد حلبتكم اشطرا ، وقلبتكم ابطنا واظهرا ، فعرفت انجاءكم ، وعلمت ان قوما اظهروا الاسلام بالسنتهم واسروا الكفر في قلوبهم ، فضربوا بعض اصحاب رسول الله صلي الله عليه وسلم ببعض ، وضربوا الامثال ، ووجدوا علي ذلك من اهل الجهل من ابناءهم اعوانا ، ياذنون لهم ويصغون اليهم . مهلا قبل وقوع القوارع ، وحلول الرواءع ؛ ومع ذلك فلست اونب تانيبا ، عفا الله عما سلف ، ومن عاد فينتقم الله منه ، والله عزيز ذو انتقام . فاسروا خيرا واظهروه ، واجهروا به اخلصوا ، فطالما مشيتم القهقري ناكصين ، وليعلم من ادبر واصر انها موعظة بين يدي نقمة ، ولست ادعوكم الي هوي يتبع ، ولا الي راي يبتدع ، انما ادعوكم الي الطريقة المثلي التي فيها خير الاخرة والاولي ، فمن اجاب فالي رشده ، ومن عمي فعن قصده . فهلموا الي الشراءع لا الي الخداءع ، ولا تولوا غير سبيل المءمنين ، ولا تستبدلوا الذي هو ادني بالذي هو خير بءس للظالمين بدلا . واياكم وبنيات الطريق ، فعندها الرهق ، وعليكم بالجادة فهي اسد وارد ، ودعوا الاماني فقد اردت من كان قبلكم ، وليس للانسان الا ما سعي ولله الاخرة والاولي . لا تفتروا علي الله كذبا فيسحتكم بعذاب ، وقد خاب من افتري . ربنا لا  تزغ قلوبنا ، بعد اذ هديتنا وهب لنا من لدنك رحمة انك انت الوهاب . الذي هو ادني بالذي هو خير بءس للظالمين بدلا . واياكم وبنيات الطريق ، فعندها الرهق ، وعليكم بالجادة فهي اسد وارد ، ودعوا الاماني فقد اردت من كان قبلكم ، وليس للانسان الا ما سعي ولله الاخرة والاولي . لا تفتروا علي الله كذبا فيسحتكم بعذاب ، وقد خاب من افتري . ربنا لا تزغ قلوبنا ، بعد اذ هديتنا وهب لنا من لدنك رحمة انك انت الوهاب . خطب محمد بن الوليد بن عتبة بن ابي سفيان الي عمر بن عبد العزيز وهو خليفة ابنته فزوجه وخطب فقال : الحمد لله ذي العزة والكبرياء ، وصلي الله علي محمد خاتم الانبياء ، اما بعد ، فقد احسن بك الظن من اودعك حرمته ، واختارك ولم يختر عليك ، وقد زوجتك علي ما في كتاب الله امساك بمعروف او تسريح باحسان . قال الاصمعي خطب داود بن علي بالمدينة فارتج عليه فقال : ان اللسان بضعة من الانسان ، يكل بكلاله اذا نكل ، وينبسط بانفساحه اذا ارتجل ، الا وان الكلام بعد الافحام كالاشراق بعد الاظلام ، وانا لا ننطق هذرا ، ولا نسكت حصرا ، بل ننطق مرشدين ، ونسكت معتبرين ، ونحن امراء الكلام ، فينا وشجت عروقه ، وعلينا تهدلت غصونه ، وبعد مقامنا هذا مقام ، ووراء ايامنا ايام ، يعرف فيها فصل الخطاب ، ومواضع الصواب . ومن الخطب في الاستسقاء روي ان النبي صلي الله عليه وسلم خرج للاستسقاء ، فتقدم فصلي ركعتين جهر فيهما بالقراءة ، وكان يقرا في العيدين والاستسقاء في الركعة الاولي بفاتحة الكتاب وسبح اسم ربك الاعلي ، وفي الثانية بفاتحة الكتاب وهل اتاك حديث الغاشية فلما قضي صلاته استقبل القبلة بوجهه ، وقلب رداءه ثم جثا علي ركبتيه ، ورفع  يديه وكبر تكبيرة قبل ان يستسقي ، ثم قال : اللهم اسقنا غيثا مغيثا ، وحيا ربيعا ، وجدا طبقا غدقا ، مونقا عاما ، هنيءا مريءا ، وابلا سابلا مسيلا مجللا داءما دررا نافعا غير ضار ، عاجلا غير راءث ، غيثا اللهم تحيي به البلاد ، وتغيث به العباد ، وتجعله بلاغا للحاضر منا والباد . اللهم انزل علينا في ارضنا زينتها ، وانزل علينا في ارضنا سكنها . اللهم انزل علينا من السماء ماء طهورا ، فاحي به بلدة ميتا ، واسقه مما خلقت لنا انعاما واناسي كثيرا . تتابعت السنون علي قريش فخرج عبد المطلب بن هاشم حتي ارتقي ابا قبيس ، ومعه رسول الله صلي الله عليه وسلم وهو غلام ، فقال : اللهم ساد الخلة ، وكاشف الكربة ، انت عالم غير معلم ، ومسءول غير مبخل ، وهذه عبداءك واماءك بعذرات حرمك ، يشكون اليك سنتهم التي اكلت الظلف والخف ، فاسمعن اللهم وامطرن غيثا مريءا مغدقا . فما راموا حتي انفجرت السماء بماءها وكظ الوادي ثجثجه ، فقال شيخان قريش وجلتها : هنيءا لك ابا البطحاء . ومن خطبة لامير المءمنين علي بن ابي طالب عليه السلام : اللهم قد انصاحت جبالنا ، واغبرت ارضنا ، وهامت دوابنا ، وتغيرت مرابضها ، وعجت عجيج الثكالي علي اولادها ، وملت التردد في مراتعها ،  والحنين الي مواردها . فارحم انين الانة ، وحنين الحانة . اللهم وارحم حيرتها في مذاهبها ، وانينها في موالجها . اللهم خرجنا اليك حين اعتكرت علينا حدابير السنين ، واخلفتنا مخايل الجود ، وكنت الرجاء للمبتءس ، والبلاغ للملتمس ، ندعوك حين قنط الانام ، ومنع الغمام ، وهلك الوسام ، الا تءاخذنا باعمالنا ولا تاخذنا بذنوبنا ، وانشر علينا رحمتك بالسحاب المنبعق ، والربيع المغدق ، والنبات المونق ، سحا وابلا تحيي به ما قد مات ، وترد به ما قد فات . اللهم اسقنا منك سقيا محيية مروية ، تامة عامة ، مباركة ، مريءة ، زاكيا نبتها ، ثامرا فرعها ، ناضرا ورقها ، تنعش بها الضعيف من عبادك ، وتحيي بها الميت من بلادك . اللهم اسقنا منك ديمة تعشب بها بلادنا ، وتجري بها وهادنا ، ويخصب بها جنابنا ، وتعيش بها مواشينا ، وتدني بها اقاصينا ، وتستغني بها ضواحينا ، من بركاتك الواسعة ، وعطاياك الجزيلة علي برتك المرملة ، وحشك المهلمة . وانزل علينا سماء مخضلة ، مدرارا هاطلة ، يدافع الودق منها الودق ، ويحفز القطر منها القطر ، غير خلب برقها ، ولا جهام عارضها ، ولا قزع ربابها ، ولا شفان ذهابها ، حتي يخصب لامراعها المجدبون ، ويحيا ببركتها المسنتون ، فانك تنزل الغيث من بعد ما قنطوا ، وتنشر رحمتك وانت الولي الحميد . غريب هذه الخطبة : انصاحت : اي تشققت ؛ وهامت : من الهيام وهو داء يصيب الابل من العطش فتكوي له مشافرها ؛ والحدابير : جمع حدبار ؛ وهي الناقة التي انضاها السير ، شبه بها سنة الجدب والقزع : القطع الصغار من  السحاب ؛ وقوله : ولا شفان ذهابها : اراد ذات شفان ، والشفان : الريح الباردة ؛ والذهاب : الامطار اللينة . ومن خطبة له عليه السلام : الا وان الارض التي تحملكم ، والسماء التي تظلكم مطيعتان لربكم ، وما اصبحتا تجودان لكم ببركتهما توجعا لكم ، ولا زلفة اليكم ، ولا لخير ترجوانه منكم ، ولكن امرتا بمنافعكم فاطاعتا ، واقيمتا علي حدود مصالحكم فقامتا . ان الله يبتلي عباده عند الاعمال السيءة بنقص الثمرات ، وحبس البركات ، واغلاق خزاءن الخيرات ، ليتوب تاءب ، ويقلع مقلع ، ويتذكر متذكر ، ويزدجر مزدجر . وقد جعل الله الاستغفار سببا لدرود الرزق ، ورحمة الخلق ، فقال : استغفروا ربكم انه كان غفارا ، يرسل السماء عليكم مدرارا . فرحم الله امرءا استقبل توبته ، واستقال خطيءته ، وبادر منيته . انا خرجنا اليك من تحت الاستار والاركان ، بعد عجيج البهاءم والولدان ، راغبين في رحمتك ، وراجين فضل نعمتك ، وخاءفين من عذابك ونقمتك . الهم فاسقنا غيثك ولا تجعلنا من القانطين ، ولا تهلكنا بالسنين ، ولا تءاخذنا بما فعل السفهاء منا ، يا ارحم الراحمين . اللهم انا خرجنا نشكو اليك ما لا يخفي عليك ، حين الجاتنا المضايق الوعرة ، واجاءتنا المقاحط المجدبة ، واعيتنا المطالب المتعسرة ، وتلاحمت  علينا الفتن المستصعبة . اللهم انا نسالك الا تردنا خاءبين ولا تقلبنا واجمين ولا تخاطبنا بذنوبنا ، ولا تقايسنا باعمالنا . اللهم انشر عليك غيثك وبركتك ورزقك ورحمتك ، واسقنا سقيا ناقعة مروية معشبة ، تنبت بها ما قد فات ، وتحيي بها ما قد مات ، نافعة الحيا ، كثيرة المجتني ، تروي بها القيعان ، وتسيل البطنان ، وتستورق الاشجار ، وترخص الاسعار ، انك علي ما تشاء قدير . لما خرج عمر بالعباس يستسقي قال : اللهم انا نتقرب اليك بعم نبيك ، وبقية اباءه وكبر رجاله ، فانك تقول وقولك الحق واما الجدار فكان لغلامين يتيمين في المدينة وكان تحته كنز لهما وكان ابوهما صالحا ، فحفظتهما لصلاح ابيهما ، فاحفظ نبيك في عمه ، فقد دلونا به اليك مستشفعين ومستغفرين . ثم اقبل علي الناس فقال : استغفروا ربكم انه كان غفارا يرسل السماء عليكم مدرارا . قال الراوي : ورايت العباس رضي الله عنه وقد طال عمره وعيناه تنضحان ، وشيبته تجول علي صدره وهو يقول : اللهم ا ، ت الراعي فلا تهمل الضالة ، ولا تدع الكبير بدار مضيعة ، فقد ضرع الصغير ، ورق الكبير ، وارتفعت الشكوي ، وانت تعلم السر واخفي . اللهم فاغثهم بغياثك من قبل ان يقنطوا فيهلكوا ، انه لا يياس من روحك الا القوم الكافرون . قال : فنشات سحابة ، وقال الناس : ترون ؟ ثم تلامت واستتمت ومشت  فيها ريح ثم هدات ودرت ، فوالله ما برحوا حتي اعتقلوا الحذاء وقلصوا الميازر ، وطفق الناس بالعباس يمسحون اركانه ويقولون : هنيءا لك ساقي الحرمين . شهد ابو حنيفة نكاحا فقالوا له تكلم ، فقال : الحمد لله شكرا لنعمته ، وسبحان الله خضوعا لعظمته ، ولا اله الا الله اقرارا بتوحيده ، وصلي الله علي سيدنا محمد عند ذكره . ان الله عز وجل خلق من الماء بشرا فجعله نسبا وصهرا ، وكان ربك قديرا ، علي ان احل النكاح وحرم السفاح وامرنا بالاصلاح ، ثم ان فلانا خطب الي فلان ، فعلي اسم الله فلتكن الاجابة ، وعلي الخيرة تكون منه العقدة ، زوجت وانكحت . خطبة نكاح من انشاء علي بن نصر الكاتب : الحمد لله اهل الحمد وخالقه ، فاطر الخلق ورازقه ، ومرشد المرء وواعظه ، ومنزل الذكر وحافظه ، الذي بسط الامال ونشرها ، وطوي الاجال وسترها ، وانشا السحاب وازجاه ، وانشا العقاب وارجاه ، جل عن صفة الواصف ، وتعالي عن معرفة العارف ، الا فانه الله الذي لا اله الا هو ، وسع كل شء رحمة وعلما . احمده علي ما نفع وضر ، واشكره علي ما ساء وسر ، واستعينه علي ما بهظ واثقل ، واتوكل عليه في ما الم واعضل ، واومن به ايمان من اهتدي واستنصر ، وافوض امري اليه تفويض من استقال واستغفر ، واشهد ان لا اله الا الله وحده لا شريك له ، شهادة تغني من العسرة ، وتقي الندامة يوم الحسرة ، وتنفس كربة المكروب ، وتضء في ظلم الخطوب ، واشهد ان محمدا عبده ورسوله ، انتخبه من اشرف ارومة وعنصر ، وابتعثه اراف هاد ومنذر ، فبلغ الرسالة ، واوضح الدلالة ، وادي الامانة في ما سمعه ، وخفض الجناح لمن اتبعه ، وحذر من شاقه وعصاه ، وانذر من حاده وعاداه ، مغمضا علي القذي ، وواطءا  علي جمرات الاذي ، حتي غضب الله لحلمه ، ونصره باخيه وابن عمه ، وجعلهما الله ومن اتبعهما الغالبين ، فقطع دابر القوم الذين ظلموا ، والحمد لله رب العالمين ، صلي الله عليهما صلاة غادية راءحة ، سانحة بارحة . ثم ان الله تعالي امرنا بالتواصل والتكاثر ، ومنعنا من التقاطع والتدابر ، وخبرنا انه خلق من الماء بشرا فجعله نسبا وصهرا ، وكان ربك قديرا . وهذا فلان يخطب فلانة . دخل عبد الله بن الاهتم علي عمر بن عبد العزيز مع العامة ، فلم يفجا عمر اا وهو ماثل بين يديه ، فتكلم فحمد الله واثني عليه ثم قال : اما بعد فان الله خلق الخلق غنيا عن طاعتهم ، امنا معصيتهم ، والناس يومءذ في المنازل والراي مختلفون : فالعرب بشر تلك المنازل : اهل الحجر والوبر واهل المدر الذين تحتاز دونهم طيبات الدنيا ورفاهة عيشها ، ميتهم في النار وحيهم اعمي ، مع ما لا يحصي من المرغوب عنه والمرهوب منه . فلما اراد الله تعالي ان ينشر عليهم من رحمته ، بعث اليهم رسولا من انفسهم عزيزا عليه ما عنتوا ، حريصا عليهم ، بالمءمنين رءوفا رحيما . فلم يمنعهم ذلك ان جرحوه في جسمه ، ولقبوه في اسمه ، ومعه كتاب من الله ناطق وبرهان صادق لا يرحل الا بامره ، ولا ينزل الا باذنه ، واضطروه الي بطن غار . فلما امر بالعزمة انبسط لامر الله لونه ، فافلج الله حجته ، واعلي كلمته ، واظهر دعوته ، وفارق الدنيا نقيا تقيا . ثم قام بعده ابو بكر ، فسلك سنته ، واخذ بسبيله ، فارتدت العرب ، فلم يقبل بعد رسول الله صلي الله عليه وسلم الا الذي كان قابلا  منهم ، فانتضي السيوف من اغمادها ، واوقد النيران في شعلها ، ثم ركب باهل الحق الي اهل الباطل ، فلم يبرح يفصل اوصالهم ويسقي الارض دماءهم ، حتي ادخلهم في الذي خرجوا منه ، وقررهم بالذي نفروا عنه . وقد كان اصاب من مال الله بكرا يرتوي عليه ، وحبشية ترضع ولدا له ، فراي من ذلك غصة في حلقه عند موته ، فادي ذلك الي الخليفة من بعده ، وبرء اليهم منه ، وفارق الدنيا تقيا نقيا علي منهاج صاحبه . ثم قام بعده عمر بن الخطاب ، فمصر الامصار ، وخلط الشدة باللين ، فحسر عن ذراعيه ، وشمر عن ساقيه ، واعد للامور اقرانها ، وللحرب التها ، فلما اصابه فتي المغيرة استهل بحمد الله الا يكون اصابه ذو حق في الفء فيستحل دمه بما استحل من حقه . وقد كان اصاب من مال الله بضعة وثنانين الفا ، فكسر بها رباعه ، وكسر بها كفالة اولاده من بعده ، وفارق الدنيا تقيا نقيا علي منهاج صاحبيه . ثم انا والله ما اجتمعنا بعدهما الا علي ظلع ، ثم انك يا عمر ابن الدنيا ، ولدتك ملوكها ، والقمتك ثديها ، فلما وليتها القيتها حيث القاها الله ، فلاحمد له الذي جلا بك حوبتنا ، وكشف بك كربتنا ، امض ولا تلتفت ، فانه لا يعز علي الحق شء ، اقول قولي هذا واستغفر الله لي ولكم وللمءمنين والمءمنات . ولما ان قال : ثم انا والله ما اجتمعنا بعدهما الا علي ظلع ، سكت الناس الا هشاما ، فانه قال : كذبت ، كان عثمان هاديا مهديا . لما قام السفاح ابو العباس اول خلافته علي المنبر ، قام بوجه كورقة المصحف فاستحيا فلم يتكلم ، فنهض داود بن علي عمه حتي صعد المنبر . قال  المنصور ، فقلت في نفسي : شيخنا وكبيرنا يدعو الي نفسه ، فانتضيت سيفي وغطيته بثوبي وقلت : ان فعل ناجزته ، فلما رقي عتبا استقبل الناس بوجهه دون ابي العباس ، ثم قال : ايها الناس ، ان امير المءمنين يكره ان يتقدم قوله فعله ، ولاثر الفعال اجدي عليكم من تشقيق الكلام ، وحسبكم كلام الله ممتثلا فيكم ، وابن عم رسول الله صلي الله عليه وسلم خليفة عليكم ، والله قسما برا لا اريد بها الا الله ، ما قام بهذا المقام بعد رسول الله صلي الله عليه وسلم احق به من علي بن ابي طالب عليه السلام ، وامير المءمنين هذا ، فليظن ظانكم وليهمس هامسكم . قال ابو جعفر المنصور : ثم نزل فشمت سيفي . ولداود بن علي خطبة مشهورة ، خطبها وابو العباس علي المنبر ، صعد دونه بمرقاة فقال : شكرا شكرا ، اظن عدو الله ان لن نقدر عليه ، ارخي له في زمانه ، حتي عثر بفضل خطامه ، فالان طلعت الشمس من مشرقها ، واخذ القوس باريها ، وعاد السهم الي النزعة ، وصار الامر الي اهل بيت نبيكم ، اهل الرافة والرحمة . والله ما نزلنا مقهورين حتي اتاح الله لنا شيعتنا من اهل خراسان ، والله رب هذه البنية لا يظلم منكم احد ، واشار بيده الي المسجد ثم نزل . فقام سديف مولاهم الي جنب المنبر فقال : ايزعم الضلال  حبطت اعمالهم  ان غير ال محمد احق بالخلافة ، فلم وبم ؟ ايها الناس ، الكم الفضل بالصحابة دون ذوي القرابة ، الشركاء في النسب ، الورثة للسلب ، الخاصة في الحياة ، الولاة عند الوفاة ، مع ضربهم علي الدين جاهلكم ، وتامينهم بعد  الخوف ساءلكم ، واطعامهم في اللاواء جاءعكم ؟ كم قصم الله بهم من جبار طاغ ، ومنافق باغ ، وفاسق ظالم ؟ لم يسمع بمثل العباس ، لم تخضع له الامة لواجب حق الحرمة ، ابو رسول الله صلي الله عليه وسلم بعد ابيه ، وامينه ليلة العقبة ، ورسوله يوم مكة ، وحاميه يوم حنين ، لا يخالف له كلما ، ولا يعصي له قسما . انكم والله معشر قريش ما اخترتم لانفسكم من حيث اختار الله لنفسه طرفة عين ، ما زلتم تختارون تيميا مرة وعدويا مرة ، فاصبحتم بين ظهراني قوم اثروا العاجل علي الاجل ، والفاني علي الباقي ، اهل خمور وماخور ، وطنابير ومزامير ، ان ذكروا لم يذكروا ، وان قوموا بحق ادبروا ، بذلك كان زمانهم ، وبه كان سلطانهم ، حتي اتاكم من هذه الخرسية من لا تعرفون له وجها ، ولا تثبتون له نسبا ، فضربكم بالسيف حتي اعطيتموها عنوة وانتم صاغرون ، وانشد : من الكامل امست امية قد تشتت شعبها . . . شعب الضلال وشتتت اهواءها زعمت امية وهي غير حكيمة . . . ان لن تزول ولن يهد بناءها وقضي الاله بغير ذاك فذبحت . . . حتي تريع علي الفجاج دماءها خطب سليمان بن علي فقال : ولقد كتبنا في الزبور من بعد الذكر ان الارض يرثها عبادي الصالحون ، قضاء فصل ، وقول مبرم ، فالحمد لله الذي صدق عبده وانجز وعده ، وبعدا للقوم الظالمين الذين اتخذوا الكعبة غرضا والدين هزءا ، والفء ارثا ، والقران عضين ، لقد  ضل عنهم ما كانوا يستهزءون ، وكاين تري من بءر معطلة وقصر مشيد ، ذلك بما قدمت ايديهم وما الله بظلام للعبيد ، امهلهم حتي اضطهدوا العترة وامنوا الغرة ، ونبذوا السنة ، وخاب كل جبار عنيد ، ثم اخذهم فهل تحس منهم من احد او تسمع له ركزا . وخطب عبد الله بن علي بما قدم مروان بن محمد دورا : الم تر الي الذين بدلوا نعمة الله كفرا واحلوا قومهم دار البوار ، جهنم يصلونها وبءس القرار ، ركض بكم يا اهل الشام ال حرب وال مروان ، يتسكعون بكم الظلم ، ويخوضون بكم مداحض المراقي ، ويوطءونكم محارم الله تعالي ومحارم رسوله . فما يقول علماءكم غدا عند الله تعالي اذ يقولون ربنا هءلاء اضلونا فاتهم عذابا ذعفا في النار فيقول : لكل ضعف ولكن لا تعلمون . اما امير المءمنين فقد اءتنف بكم التوبة ، وغفر لكم الزلة ، وبسط لكم الاقالة بفضله ، فليفرح روعكم ، ولتعظكم مصارع من كان قبلكم ، فهذه الجثي منكم مصرعة ، وبيوتهم خاوية ، بما ظلموا والله لا يحب الظالمين . ثم نزل عن المنبر . وصعد بعده صالح بن علي فقال : الحمد لله ، يا اهل النفاق وعمد الضلالة ، اغركم لين الابساس وطول الايناس ، حتي ظن جاهلكم ان ذلك  لفلول حد وخور قناة . فاذ استوباتم العافية فغدا فطام ونكال ، وسيف يعض بالهام . خطب زيد بن علي فقال : اوصيكم عباد الله بتقوي الله التي من اكتفي بها كفته ، ومن اجتن بها وقته ، وهي الزاد وعليها المعاد ، زاد مبلغ ومعاد منج ، دعا اليها اسمع داع فوعاها خير واع ، فاعذر داعيها وفاز واعيها . عباد الله ان تقوي الله حمت اولياء الله محارمه ، والزمت قلوبهم مخافته حتي اسهرت ليلم واظمات هواجرهم ، فاخذوا الراحة بالنصب ، والري بالظما ، واستقربوا الاجل ، فبادروا بالعمل ، وكذبوا الامل ، ولاحظوا الاجل . طوبي لهم وحسن ماب . ثم ان الدنيا دار فناء وعناء ، وغير وعبر ، فمن العناء ان المرء يجمع ما ياكل ، وبيني ما لا يسكن ، ثم يخرج الي الله تعالي لا مالا حمل ولا بناء نقل ، ومن الفناء ان الدهر موتر قوسه ، ثم لا تخطء سهامه ، ولا توسي جراحه ، يرمي الحي بالموت ، والصحيح بالعطب . اكل لا يشبع ، وشارب لا يروي . ومن غيرها انك تلقي المحروم مغبوطا ، والمغبوط محروما ، وليس ذلك الا لنعيم زال ، وبءس نزل . ومن عبرها ان المشرف علي امله يقطعه اجله ، فلا امل يدرك ، ولا مءمل يترك ، فسبحان الله ما اغر سرورها ، واظما ريها ، واضحي فيها . فكان الذي كان من الدنيا لم يكن ، وكان الذي هو كاءن منها قد كان . صار اولياء الله فيها الي الاجر بالصبر ، والي الامل بالعمل ، جاءوا الله تعالي في داره ملوكا خالدين . ان الله عز وجل خلق موتا بين حياتين : موت بعد حياة ، وحياة ليس بعدها موت . وان اعداء الله نظروا فلم يجدوا شيءا بعد الموت الا والموت اهون منه ، فسالوا الله عز وجل الموت فقالوا يا مالك ليقض علينا ربك ، قال انكم ماكثون . وان اولياء الله نظروا فلم يجدوا شيءا بعد الموت الا والموت اشد منه ، فسالوا الله الحياة جزعا من الموت ؛ ولكل مما  هو فيه مزيد . فسبحان الله ما اقرب الحي من الميت باللحاق به ، وما ابعد الميت من الحي لانقطاعه عنه ، وليس شء بخير من الخير لا ثوابه ، وليس شء بشر من الشر الا عقابه ، وكل شء من الدنيا سماعه اعظم من عيانه ، وكل شء من الاخرة عيانه اعظم من سماعه . فليكفكم من السماع العيان ، ومن الغيب الخبر . ان الذي امرتم به اوسع مما نهيتم عنه ، وما احل لكم اكثر مما حرم عليكم ، فذروا ما قل لما كثر ، وما ضاق لما اتسع . وقد تكفل لكم بالرزق وامركم بالعمل ، فلا يكونن المضمون لكم طلبه اولي بكم من المفروض عليكم ، مع انه والله قد اعترض الشك ودخل اليقين ، حتي كان الذي ضمن لكم قد فرض عليكم ، وكان الذي فرض عليكم قد وضع عنكم . فبادروا العمل ، وخافوا بغتة الاجل ، فانه لا يرجي من رجعة الحياة ما يرجي من رجعة الرزق ، فان ما فات اليوم من الرزق يرجي غدا ارتداده ، وما فات امس من العمر لم ترج اليوم رجعته . خطب محمد بن ابراهيم بن اسماعيل بن ابراهيم طباطبا بن الحسن بن الحسن بن علي الخارج مع ابي السرايا ، فقال :  وكان ابو السرايا قد انتهب قصر العباس بن موسي بن عيسي  اما بعد ، فانه لا يزال يبلغني ان القاءل منكم يقول : ان بني العباس فء لنا نخوض في دماءهم ، ونرتع في اموالهم ، ويقبل قولنا فيهم ، وتصدق دعوانا عليهم . حكم بلا علم وعزم بلا روية . عجبا لمن اطلق بذلك لسانه او حدث به نفسه . ابكتاب الله عز وجل اخذ ، ام لسنة رسوله صلي الله عليه وسلم ابتع ؟ او في ميلي معه طمع ، او بسط يدي له بالجور امل ؟ هيهات هيهات ، فاز ذو الحق بما نوي ، واخطا طالب ما تمني ، حق كل ذي حق في يده ، وكل مدع  علي حجته . ويل لمن اغتصب حقا وادعي باطلا ، وافلح من رضي بحكم الله تعالي ، وخاب من ارغم الحق انفه . العدل اولي بالاثرة وان رغم الجاهلون . حق من امر بالمعروف ان يجتنب المنكر ، ولمن سلك سبيل العدل ان يصبر علي مرارة الحق . كل نفس تسمو الي همتها ، ونعم الصاحب القناعة . ايها الناس ، ان اكرم العبادة الورع ، وافضل الزاد التقوي ، فاعملوا في دنياكم ، وتزودوا لاخرتكم ، اتقوا الله حق تقاته ، ولا تموتن الا وانتم مسلمون . واياكم والعصبية وحمية الجاهلية ، فانهما يمحقاه الدين ، ويورثان النفاق ، خلتان ليستا من ديني ولا دين اباءي . وتعاونوا علي البر والتقوي ، ولا تعاونوا علي الاثم والعدوان ، يصلح لكم دينكم ، وتحسن المقالة فيكم . الحق ابلج ، والسبيل نهج ، والباطل لجلج ، والناس مختلفون ، ولكل في الحق سعة . من حاربنا حاربناه ، ومن سالمنا سالمناه . الناس جميعا امنون الا رجلين : رجل نصب لنا نفسه واعان علينا بماله ، ولو شءت ان اقول ، ورجل قال فينا يتناول من اعراضنا ، قلت ، ولكن حسب امرء وما اكتسب وسيكفي الله الظالمين . خطبة تنسب الي يزيد : ايها الناس ، سافروا بابصاركم في كر الجديدين ، ثم ارجعوها كليلة عن بلوغ الامل ، فان الماضي عظة للباقي ، ولا تجعلوا الغرور سبيل العجز فتنقطع حجتكم في موقف الله ساءلكم فيه ومحاسبكم علي ما اسلفتم . ايها الناس ، امس شاهد فاحذروه ، واليوم مءدب فاعرفوه ، وغدا رسول فاكرموه ، وكونوا علي حذر من هجوم القدر . اعمالكم تطلق ابدانكم ، والصراط ميدان يكثر فيه  العثار ، فالسالم ناج ، والعاثر في النار . خطب محمد بن سليمان بن علي بن عبد الله فقال : الحمد لله ، احمده واستعينه واستغفره ، واومن به ، واتوكل عليه ، واشهد ان لا اله الا الله وحده لا شريك له ، وان محمدا عبده ورسوله ، ارسله بالحق داعيا ، وبالعدل امرا ، وبالجنة مبشرا ، ومن النار منذرا ، وبلغ رسالته ، وجاهد من عند عن سبيل ربه حتي اكمل الله له دينه ، واظهر حجته ، وصلي الله عليه ولي اله كما صلي علي ابراهيم وال ابراهيم . اوصيكم عباد الله بتقوي الله ، واحضكم علي طاعة الله ، وارضي لكم ما عند الله ، فان تقوي الله افضل ما تحاث الناس عليه وتداعوا اليه ، وتواصوا به ، فاتقوا الله ما استطعتم ، واسمعوا واطيعوا ، وانفقوا خيرا لانفسكم ، ولا تغرنكم الدنيا فانها غرارة ، مغرور من اغتر بها ، الا ترونها لم ترفع احدا الا وضعته ؟ ولم تعز جبارا الا اذلته ؟ ولم تذق ابناءها من حلاوتها الا اعقبتهم سما قاتلا وذعافا موبيا ؟ قد اعدت لهم مصارع الردي ومدارج التلف لطول الحسرة والندامة ، يوم تذهل كل مرضعة عما ارضعت وتضع كل ذات حمل حملها . فلمثل هذه تسعون ، وفي مثلها ترغبون ، واليها تركنون ، ولها تجمعون ، وانتم ترون مصارع الملوك الذين كانوا اكول منكم اعمارا ، واكثر منكم اموالا واعتد عتادا فتلك مساكنهم لم تسكن من بعدهم الا قليلا وكنا نحن الوارثين . فاحذروها كما حذركم الله فانها بالموضع الذي وضعها الله ، والصفة التي وصفها ، قال الله عز وجل واضرب لهم مثل الحياة الدنيا كماء انزلناه من السماء فاختلط به نبات الارض فاصبح هشيما تذروه الرياح وكان الله علي كل شء مقتدرا ، وقال عز وجل : اتبنون بكل ريع اية تعبثون ، وتتخذون مصانع لعلكم تخلدون ، واذا بطشتم جبارين الشعراء .  فاعملوا عباد الله لدار المتقين ، فان الدار الاخرة هي الحيوان ودار المقامة التي لا تمس اهلها فيها نصب ولا يمسهم فيها لغوب . خطب المامون فقال : اتقوا الله عباد الله وانتم فيمهل ، بادروا الاجل ولا يغرنكم الامل ، فكان بالموت وقد نزل ، فشغلت المرء شواغله ، وتركت عنه بواطله ، وهيءت اكفانه ، وبكاه جيرانه ، وصار الي المنزل الخالي بجسده البالي ، قد فارق الرفاهية وعاين الداهية ، فوجهه في التراب عفير ، وهو الي ما قدم فقير . خطب لابن نباتة الحمد لله الذي علا في ارتفاع مجده عن اعراض الهمم ، وخلا باتساع رفده عن اعتراض التهم ، وجلا قلوب اولياءه بينابيع الحكم ، وهداهم بنور اجتباءه لارشد نعم ، احمده علي صنوف النعم ، حمدا تضيق باحصاءه الكلم ، واشهد ان لا غله الا الله وحده لا شريك له ، شهادة تشفي القلوب من السقم ، وتكفي المرهوب من النقم ، واشهد ان محمدا صلي الله عليه وسلم عبده ورسوله ، نقله في اطهر صلب ورحم ، واختصه باحمد الاخلاق والشيم ، وارسله الي العرب والعجم ، وجعل امته خير الامم ، فشفي الاسماع من الصمم ، ووفي بالعهود والذمم ، ونفي بنوره حنادس الظلم ، صلي الله عليه وعلي اهل بيته اهل الفضل  والكرم . ايها الناس ، ما اسلس قياد من كان الموت جريره ، وابعد سداد من كان هواه اميره ، واسرع فطام من كانت الدنيا ظءيره ، وامنع جناب من اصبحت التقوي ظهيره . فاتقوا الله عباد الله حق تقواه ، وراقبوه مراقبة من يعلم انه يراه ، وتاهبوا لوثبات المنون ، فانها كامنة في الحركات والسكون ، بينما المرء مسرورا بشبابه ، مغرورا باعجابه ، مغمورا بسعة اكتسابه ، مستورا عنه ما خلق له بما يغري به ، اذ سعرت فيه الاسقام شهابها ، واعلقت به ظفرها ونابها ، فسرت فيه اوجاعه ، وتنكرت عليه طباعه ، واظل رحيله ووداعه ، وقل عنه منعه ودفاعه ، فاصبح ذا بصر حاءر ، وقلب طاءر ، ونفس غابر ، في قطب هلاك داءر ، قد ايقن بمفارقة اهله ووطنه ، واذعن بانتزاع روحه من بدنه ، فاوما الي حاضر عواده ، موصيا لهم باصغر اولاده ، والنفس بالسياق تجدب ، والموت بالفواق يقرب ، والعيون لهول مصرعه تسب ، والحامة تعدد عليه وتندب ، حتي تجلي له ملك الموت  صلي الله عليه  من حجبه ، فقضي فيه قضاء امر به ، فعافه الجليس ، واوحش منه الانيس ، وزود من ماله كفنا ، وحصل في الارض بعمله مرتهنا ، وحيدا علي كثرة الجيران ، بعيدا علي قرب المكان ، مقيما بين قوم كانوا فزالوا ، وجرت عليهم الحادثات فحالوا ، لا يخبرون بما اليه الوا ، ولو قدروا علي المقال لقالوا ، قد شربوا من الموت كاسا مرة ، ولم يفقدوا من اعمالهم ذرة ، والي عليهم الدهر الية برة ، الا تجعل لهم الي دار الدنيا كرة ، كانهم لم يكونوا للعيو قرة ، ولم يعدوا في الاحياء مرة ، اسكتهم والله الذي انطقهم ، وابادهم الذي خلقهم ، وسيجدهم كما اخلقهم ، ويجمعهم بعدما  فرقهم ، يوم يعيد الله العالمين خلقا جديدا ، ويجعل الظالمين لنار جهنم وقودا ، يوم تكونون شهداء علي الناس ويكون الرسول عليكم شهيدا يوم تجد كل نفس ما عملت من خير محضرا وما عملت من سوء تود ان بينها وبينه امدا بعيدا . جعلنا الله واياكم ممن قدر قدره ، فقبل امره ، وادام في الخلوات ذكره ، وجعل تقوي عالم الخفيات ذخره ، واستغفر الله لي ولكم ولساءر المسلمين . سمعت هذه الخطبة علي الشيخ ابي اسحاق ابراهيم بن محمد بن نبهان الغنوي الرقي مع غيرها من خطب ابن نباتة ، وما رايت مخبرا اعرف منه بما يقرا عليه ، كان يحفظ خطب ابن نباتة كانما يقراها من كفه ، ويرد علي القارء من حفظه ولفظه . وحدثنا من فيه قال : اخبرنا الشيخ الخطيب ابو القاسم يحيي بن طاهر بن محمد بن عبد الرحيم ، قال : اخبرنا ابي طاهر عن ابيه محمد عن ابيه عبد الرحيم ابن محمد بن اسماعيل الفارقي ، قال : لما عملت هذه الخطبة وخطبت بها يوم جمعة ، بت ليلة السبت فرايت فيما يري الناءم كاني بظاهر مدينة ميافارقين عند الجبانة ، ورايت بين المقابر جمعا كثيرا ، فقلت : ما هذا الجمع ؟ فقال لي قاءل : هذا النبي صلي الله عليه وسلم ومعه الصحابة ، فقصدته لاسلم عليه ، فلما قربت منه التفت فراني فقال : اهلا ومرحبا يا خطيب الخطباء ، كيف تقول  واوما الي القبور  فقلت كانهم لم يكونوا للعيون قرة ، ولم يعدوا في الاحياء مرة ، اسكتهم والله الذي انطقهم ، وابادهم الذي خلقهم ، وسيجدهم كما اخلقهم ، ويجمعهم كما فرقهم ، يوم يعيد الله العالمين خلقا جديدا ، ويجعل الظالمين لنار جهنم وقودا ، يوم تكونون شهداء علي الناس  واومات الي الصحابة ، واومات الي النبي صلي الله عليه وسلم  ويكون الرسول عليكم شهيدا يوم تجد كل نفس ما عملت من خير محضرا  وما عملت من سوء تود لو ان بينها وبينه امدا بعيدا . قال : فقال لي النبي صلي الله عليه وسلم : احسنت لا فض الله فاك ، ادنه ادنه ، قال : فدنوت منه فاخذ وجهي فقبله وتفل في في وقال : وفقك الله . فانتبهت من النوم وبي من السرور ما يجل عن الوصف ، واخبرت اهلي بما رايت ، وبقيت بعد هذا المنام لا اطعم الطعام ولا اشتهيه ، وكان يوجد في فمي مثل راءحة المسك . قال شيخنا ابو القاسم رحمة الله عليه : ولم يبق بعد هذا المنام الا قليلا حتي توفي  رحمة الله عليه  ولو دون الاربعين سنة . ومن خطبه : الحمد لله ناقض عزاءم المخلوقين بابرام عزمه ، وقابض خزاءم انفس الابقين لالزام حكمه ، وحال عقد الشبهات عن بصاءر اهل وده ، وفال عدد ذوي الرغبات عن محجة قصده ، احمده حمدا يستوجبه فضله ، واعلم ان اختلاف مقاديره عدله ، واشهد ان لا غله الا الله وحده لا شريك له ، شهادة اجدد بها في مقام مقالا ، وامجد بها ذا الجلال والاكرام تعالي ، واشهد ان محمدا عبده ورسوله ، ارسله والحق خافية صواه ، واهية قواه ، حل حرمه ، فل عصمه ، طامسة اعلامه ، دراسة احكامه ، منكورة ايامه ، مبتورة اوذامه ، فاقدم صلي الله عليه وسلم علي اعداءه علي الاقرار بوحدانيته ، حتي دك رعان البهتان فاصحرها ، وفك اركان الطغيان فدمرها ، واطلع شمس اليقين وندب اليها ، وشرع شراءع الدين فاوضحها لديها ، صلي الله عليه وعلي اله صلاة تسوق ثوابه بين يديها ، وتءمن عقابه من امن من العالمين عليها . ايها الناس ، اسيموا القولب في رياض الحكم ، واديموا النحيب علي ابيضاض اللمم ، واطيلوا الاعتبار بانتقاض النعم ، واجتلوا الافكار في انقراض الامم ،  الذين كانوا من قبلكم في الارض قاطنين ، وعلي مهاد الخفض مستوطنين وبعهود الايام واثقين ، والي غايات الاماني سابقين ، ممن تبوا عرعرة دهر اصبحتم بحضيضه ، وتملي صفو زمان جاد عليكم بقروضه ، حتي اذا استحكمت فيهم طماعية التخليد ، واستولت عليهم رفاهية التمهيد ، وقادوا الخليقة بازمة الرغب والرهب ، وسارت بهم الدنيا مسير التقريب والخبب ، وعموا عن مناصب اشراك جدها في مراعي اللعب ، ولهوا عما يدل عليه الاعتبار فيها من سوء النقلب ، رغا في وسط ديارهم سقب العطب ، واعدي فيهم الهلاك اعداء الجرب ، واوقعت بهم المون ايقاع الغضب ، وادت اليكم الايام من اخبارهم انواع العجب ، سحبت عليهم الهوج اذيال نقاءمها ، وحلبت عليهم المنون سجال غماءمها ، فاضحوا رهاءن اجداث موصدة ، ووداءع قبور ملحدة ، ذهبوا والله فلم يرجعوا ، وندبوا فلم يسمعوا ، وازعجوا فلم يمنعوا ، واستضيموا فلم يدفعوا ، اتراهم رضوا بدار الغربة دارا ، ام اثروا قرار الوحشة قرارا ؟ لا والله ما اختاروا فرقة الاحباب ، والكون تحت اطباق التراب ، ولكن صال عليهم القضاء فاطرقوا ، وطال عليهم فتمزقوا ، فليت شعري ماذا قيل لهم وماذا لقوا ؟ اسعدوا بمكتسبهم في الاخرة ام شقوا ؟ فهلم عباد الله الي محاسبة النفوس ، قبل مواثبة النحوس ، ومقارنة الرموس ، ومعاينة اليوم العبوس ، يوم غض الرءوس ، وفض الطروس ، والفحص عن المحسوس والملموس ، بين يدي الملك القدوس يوم تشقق السماء بالغمام ، ونزل الملاءكة تنزيلا يوم ترجف الارض والجبال وكانت الجبال كثيبا مهيلا . يوم ندعو كل اناس بامامهم ، فمن اوتي كتابه بيمينه فاولءك يقرءون كتابهم ولا يظلمون فتيلا . يوم يدعوكم فتستجيبون بحمده وتظنون ان لبثتم الا قليلا . طيبنا الله واياكم بطيب كتابه ، وادبنا واياكم بادابه ، ووقفنا واياكم للاخذ بصوابه ، ووفقنا واياكم عند ما  امرنا به ، ان اولي ما اهتديتم بارشاده ، واحق ما صدقتم بوعده وابعاده ، كلام من جعلكم من خير عباده ، ويقرا فكلا اخذنا بذنبه . . . الحمد لله المدرك المقيت ، المهلك المفيت ، المنشر المميت ، مالك ازمة الجمع والتشتيت ، الذي فات حدود الاوصاف والنعوت ، واحتجب عن الابصار بعز الملكوت ، سبحانه له الخلق خضوع قنوت ، وهو الواحد الحي الذي لا يموت ، احمده حمدا يمري سبل عهاد رزقه ، ويوري شعل زناد الشكر في خلقه ، واشهد ان لا اله الا الله وحده لا شريك له ، شهادة كر علي اللسان لفظها ، وقر في مقر الجبنان حفظها ، واشهد ان محمدا عبده ورسوله ، ارسله بوجه طلق ، ولسان ذلق ، وشرع صدق ، ودين حق ، فصد عن سبيل الهلكة ، وامد باليمن والبركة ، حتي صارت الكلمة سددا ، والامة في الحق شرعا احدا ، صلي الله عليه وعلي اله صلاة لا تنقطع عددا ، ولا تنقضي ابدا . ايها الناس ، ان ضياء نهار المشيب في اظلام ليل اللحي والرءوس ، حقق عند الفطن اللبيب قرب انهدام القوي واخترام النفوس ، ذلك المضيف واغل ، وسيف لموصول الحياة فاصل ، ونور طالع بافول النسم ، ومنشور بالاشخاص الي محل الرمم ، فلا تحرقوا  رحمكم الله  نور مشيبكم بنار ذنوبكم ، وارمقوا غير الحوادث بابصار قلوبكم ، تركم ما خفي عنكم من عيوبكم ، فكما حل بكم من المشيب ما تكرهون ، فكذلك يحل بكم الموت ، افلا تنتهون ؟ ! الا وغن الشيب ثغر الحياة الذي لا يمكن سداده ، وكسر القناة الذي لا يصلح الدهر ما تنصف من الثمار ان جداده ، ويا معشر الشباب كم من زرع اباده قبل البلوغ الهدم في البناء . فما بقاء من صحته في دنياه سقمه ، وغنيمته من الحياة غرمه ، ومقامه فيها سفر ، وايامه بتقلبها عبر ، تريه اعطاء ما تسلبه ، وبناء ما تخربه ،  وبعيدا ما تقربه ، وعتيدا ما تجنبه . فيا عجبا لامور بالتزود قد حان سفره ، واقام من تقدمه عليه ينتظره ، وهو خلي من التاهب لرحلة تذكره ، مع صحة علمه ا ، المنية لا تءخره . فرحم الله امرءا اهمه معاده ، وتقدمه زاده ، وكان الي التقوي انقياده ، ولهواه جهاده ، قبل اخلاق الجدة ، وانفاق المدة ، وانهدام العدة ، واقتحام الشدة ، قبل هطلان الرخصاء ، وبطلان الاعضاء ، وضيق رحب الفضاء ، وحيرة الفتور والاغضاء ، لورود حتم القضاء ، هنالك صالت عليك بسطوتها شعوب ، وحالت عن سجيتها اللعوب ، ورقت لكرب سياقك القلوب ، وشقت علي قرب فراقك الجيوب ، وطلعت سافرة عن صفحتها المخدرة العروب ، اذ حان منك في ظلمات التراب غروب . فانيبوا ايها الغافلون اذ كنتم موقنين انكم صاءرون الي هذا المصير ، واذيبوا جامد الدموع بنيران الزفير ، واطيبوا التزود لوشك المسير ، واستجيبوا لربكم من قبل ان ياتي يوم لا مرد له من الله ، ما لكم من ملجا يومءذ وما لكم من نكير . جعلنا الله واياكم ممن ادبته العبر ، وهذبته الفكر ، فاملت عليه غرر الامور انباء عواقبها ، وتجلت له ستر المحذور عن لالاء قواضبها ، فاستعظم في بقية عمره ادخار الحسنات ، واستعصم بهضبة الحق من شر ام هو ات . ان احسن نظم اللاقط ونثره ، وابلغ وعظ الواعظ وزجره ، كلام من تطمءن القولب بذكره . ويقرا : والله خلقكم ثم يتوفاكم ومنكم من يرد الي ارذل العمر لكي لا يعلم بعد علم شيءا ، ان الله عليم قدير . ومن خطبة لقطري بن الفجاءة المازني الخارجي :  من كان يريد الحياة الدنيا وزينتها نوف اليهم اعمالهم فيها وهم فيها لا يبخسون . الا فبءست الدار لمن اقام فيها ، فاعملوا وانتم تعلمون انكم تاركوها عما قليل ، فانها كما وصفها من انشاها ، وكما ذمها من ابتداها ، فقال : واضرب لهم مثل الحياة الدنيا كماء انزلناه من السماء فاختلط به نبات الارض فاصبح هشيما تذروه الرياح وكان الله علي كل شء مقتدرا . من ذم الله اعمالهم كيف حملوا الي قبورهم فلا يدعون ركبانا ، وانزلوا فلا ينزلون ضيفانا ، وجعل لهم من الضريح اكفانا ، ومن التراب اكنانا ، ومن الرفات جيرانا ، فهم جيرة وهم ابعاد ، متناءون لا يزورون ولا يزارون ، حلماء قد ذهبت اضغانهم ، وجهلاء قد ماتت احقادهم ، لا يخشي دفعهم ، ولا يرجي منعهم ، كما قال الله عز وجل : وكم اهلكنا قبلكم من قرن هل تحس منهم من احد او تسمع لهم ركزا ، وقال تبارك وتعالي : فتلك مساكنهم لم تسكن من بعدهم الا قليلا وكنا نحن الوارثين ، استبدلوا بظهر الارض بطنها وبالسعة ضيقا ، وبالاهل غربة ، وبالنور ظلمة ، فجاوروها كما فارقوها ، حفاة عراة فرادي ، غير ا ، هم ظعنوا باعمالهم الي الحياة الداءمة ، وغلي خلود الابد ، فكانوا كما قال الله عز وجل : ثم ردوا الي الله مولاهم الحق ، وضل عنهم ما كانوا يفترون ، فاحذروا ما حذركم الله ، فانه قد اعذر وانذر ، ووعد واوعد لءلا يكون للناس علي الله حجة بعد الرسل يقولوا : ربنا لولا ارسلت الينا رسولا فنتبع اياتك من قبل ان نذل ونخزي . عصمنا الله واياكم بطاعته ، ورزقنا واياكم اداء حقه . قال مالك بن دينار رضي الله عنه : غدوت الي الجمعة ، فقعدت قريبا من المنبر ، فجاء الحجاج فصعد المنبر ، فذكر الله وحمده ومجده واثني عليه ،  وصلي علي محمد نبيه ثم قال : امرء تزود عمله ، امرء حاسب نفسه ، امرء فكر فيما يقرءه فس صحيفته ويراه في ميزانه ، امرء كان عند قلبه زاجر وعند همه ممسك ، امرء اخذ بعنان قلبه كما ياخذ الرجل يخطام حمله ، فان قاده الي طاعة الله تبعه ، وان قاده الي معصيته كفه . خطبة منبرية من انشاء علي بن نصر الكاتب : الحمد لله الذي برا الخلاءق تفضلا ، وجعل من الملاءكة رسلا ، وانتخب من عباده صفوة انزل عليهم وحيه ، وحملهم امره ونهيه ، وابتعثهم مبشرين ، وارسلهم منذرين ، ليهلك من هلك عن بينة ، ويحيا من حي عن بينة ، وان الله لسميع عليم ، جل عن الاشباه والانداد ، وتقدس عن الصاحب والاولاد ، وعز عن الادراك بالجوارح ، وتنزه عن الظلم والقباءح ، وتعالي عما يقول الظالمون علوا كبيرا ، ذو العلم المحيط بكل شء ، والقدرة القابضة لنفس كل حي ، والعزة المالكة لكل قلب ، والرحمة الواسعة لكل ذنب . احمده منعما لا ياس من رحمته ، واعوذ به منتقما لا ملجا من سطوته ، واستعينه ناصرا لا غالب لجنده ، واومن به مصدقا لقوله ووعده . واشهد ان لا اله الا الله وحده لا شريك له ، شهادة تجبر نقاءص الاعمال ، وتعفر خطايا الاقوال والافعال ، وتكون زادا للسفر اليه ، وعتادا ليوم العرض عليه . واشهد ان محمدا عبده ورسوله ، انتخبه من اكرم ارومة ولباب ، ونقله في اطهر متون واصلاب ، حتي برز والانوار تضء بين يديه ، والشواهد تنم الي قلوب ذوي الايمان عليه ، فما زال مقبولا محببا ، ومتبوعا مرحبا ، نطقه الحمد والاستغفار ، وشعاره السكينة والوقار ، الي ان دنا الامد المضروب لاظهاره ، وبلغ الاجل المكتوب في انذاره ، فارسله  صلي الله عليه  علي حين فترة امتدت اشطانها ، وفتنة تمرد شيطانها ، حين فتحت الغواية ابوابا ، واتخذت الاصنام  اربابا ، وافتريت علي الله الاباطيل ، وعبدت دونه الصور والتماثيل ، فجهر بكلمة الصدق ، وصدع بدعوة الحق ، ودل علي الدين القويم ، وهدي الي الصراط المستقيم ، حتي بدا الاسلام مشرقا ، واستنبط الكفر نفقا ، وظهر امر الله وهم كارهون . صلي الله عليه وسلم ، وشرف وكرم ، صلاة داءمة تلاقيه وتصافحه ، وسلاما يغاديه ويراوحه ، وشرفا ينمي اذا ذوت الحداءق ، وكرامة تبقي اذا فنيت الخلاءق ، وعلي اهل بيته وناصريه ، وصحابته وموازريه ، وذوي الرتبة الفاءتة للمساعي ، والدرجة العالية عن المرعي والراعي . اوصيكم عباد الله واياي بتقوي الله ، واحذركم الدنيا فانها منزل مكر واطماع ، ودار غرور وخداع ، وطريق ميل واعوجاح ، ومحل قلعة وانزعاج ، درتها مقطوعة ، ونفرتها ممنوعة ، وعقدها مجذوذ ، وعهدها منبوذ ، بينا هي مقبلة حتي تدبر ، ومستانسة حتي تنفر ، ومسعدة حتي تخذل ، ومصحبة حتي تحرن ، صحتها اسقام ، ولذتها احلام ، ونعيمها بوس ، واسعدها نحوس ، من سكن اليها فتنته ، ومن اعتمد عليها اسلمته ، ومن همت باقتناصه استهوته ، ومن نهيت عن اعتباطه اهرمته ، المرء فيها حليف هموم واشجان ، واليف غموم واحزان ، وطليح نصب ولغوب ، وطريح نوب وخطوب ، فالسعيد من فقه اغراضها ، والسليم من كره اعراضها ، والعزيز من زهد في عاجلها ، والنزيه من صدف عن باطلها ، عالما بعظم عناءها ، وموقنا بوشيك انقضاءها ، ومنقطعا عنها الي ربه ، بخلوص من سريرته وقلبه ، يسهر ليله اعتبارا ، ويسكب دمعه حذارا ، ويفني وقته استغفارا ، قد ايقن بسرعة المنقلب ، وتحقق الا وزر ولا مهرب ، فهو يرهب الفارط من الاجرام ، ويفرق الواقع من الانتقام ، فذلك المكتوب من الخاءفين ، وعسي ان يكون من المفلحين ، والشقي من اغتر بتعاليلها ، واستمر في غيها واضاليلها ، وصبا الي خضراء دمنها ، ولها عن طارق لاواءها ومحنها ،  واستعزر الحلب من اخلافها ، واستمرا العذب من نطاقها ، لا يري لها انقطاعا ، ولا يخشي علي درتها مصاعا ، فهو علي لذاتها منهمك ، وبحبال خدعها متمسك ، يسحب فيها ذيل الاشر الخليع ، وينقاد اليها انقياد المءتمر المطيع ، نومته علي السكر والمزمار ، وصبحته علي النشوة والخمار ، لا يلتفت الي نوبها التي اقرحت الجفون ، ومناياها التي افنت القرون ، ولا يري عليه من اجله رقيبا ، ووراءه من خالقه طليبا ، ينتزعه من يد الناصر ولا يجد امتناعا ، ويسلبه لفتة الناظر فلا يستطيع دفاعا ، فذاك المعدود من الاخسرين افعالا ، والمحسوب من الاضلين اعمالا . فاتقوا الله عباد الله حق تقاته ، واعتدوا لدنو الاجل وميقاته ، واعملوا لقبر لحده مظلم ، وسفر يخاف فيه سوء المقدم ، واحذروا الموت قبل التوبة ، وعض الانامل يوم الاوبة يوم لا ينفع مال ولا بنون الا من اتي الله بقلب سليم . جعلنا الله واياكم ممن اءتمر وازدجر ، وعلم استبصر ، واعتبر وتذكر ، واستقال واستغفر ، استغفروا الله لي ولكم ولساءر المسلمين . 
  نوادر الخطب
 خطب وال باليمامة فقال : ان الله لا يقار عباده علي المعاصي ، وقد اهلك امة عظيمة في ناقة ما كانت تساوي ماءتي درهم ، فسمي مقوم الناقة . خطب عدي بن وثاب فقال : اقول كما قال العبد الصالح : ما اريكم الا ما اري ، وما اهديكم الي سبيل الرشاد . قالوا : ليس هذا قول عبد صالح انما هو قول فرعون ، قال : من قاله فقد احسن . صعد بعض الاعراب علي المنبر في عمله يخطب ، فقال : والله ان اكرمتموني اكرمتكم ، وان اهنتموني اهنتكم ، ولتكونن اهون علي من ضرطتي هذه ، ثم ضرط . ولي المهلب بعض الاعراب كورة بخراسان ، وعزل واليا كان بها ، فلام وردها الاعرابي وصعد المنبر حمد الله تعالي واثني عليه ثم قال : ايها الناس  اقصدوا لما امركم الله تعالي به ، فانه عز وجل رغبكم في الاخرة الباقية ، وزهدكم في الدنيا الفانية ، فرغبتم في هذه ونبذتم تلك ، فيوشك ان تفوتكم الفانية ، ولا تحصل لكم الباقية ، فتكونوا كما قال الله : لا ماءك ابقيت ولا حرك انقيت ، واعتبروا بهذا المعزول عنكم كيف سعي فصار ذلك الي علي رغم انفه ، وصار كما قال في محكم كتابه : مجزوء الخفيف انعمي ام خالد . . . رب ساع لقاعد قال الاصمعي : ولي اعرابي تبالة ، فصعد المنبر فلم يحمد الله ولم يثن عليه ، ولم يصل النبي صلي الله عليه وسلم ، وقال : ان الامير اعزه الله ولاني بلدكم ، واني والله ما اعرف من الحق غير مقدار سوطي ، واني لا اوتي بظالم ولا مظلوم الا اوجعته ضربا . فكانوا يتعاطون الحق بينهم ولا يترافعون اليه . ولي العلاء بن عمرو بلاد سارية ، وكان جاءرا ، فاصاب الناس القحط ، وامسكت السماء مطرها ، فخرجوا يستسقون ، وصعد العلاء المنبر فقال في دعاءه : اللهم ارفع عنا البلاء والغلاء . فوثب معتوه كان بها فقال : والعلاء ، فانه شر من الغلاء ، واغلظ من جميع البلاء . فضحك الناس وخجل العلاء وانصرف . استعمل المنصور سلما الكلبي  وكان اخاه من الرضاعة  علي الري ، وكان اعرابيا ، فاستعمل اخاه ناصحا علي اذربيجان ، فصعد المنبر فحمد الله واثني عليه ثم قال : اللهم اجعل بصري في طاعتك بصر الصقر ، وقوتي في مرضاتك قوة النمر ، وعمري في محبتك عمر النسر ، اللهم اصلح امير المءمنين  صلاحا ، وامتع به متاعا يا هناه ، اقول قولي هذا واستغفر الله لي ولكم ؛ ثم نزل . فاتاه نعي فاظهر الجزع وارجف به اهل عمله ، فصعد المنبر وقال : ايها الناس اظننتم ان موت ابني كسرني ؟ فوالله ما كنت قط اجرا علي الله وعليكم مني الساعة ، فادوا خراجكم . فبلغ المنصور ذلك ، فوجه اليه فعزله . خطبة في الطلاق ، لبعض الظرفاء : الحمد لله الذي جعل في الطلاق اجتلابا للارزاق ، فقال تعالي : وان يتفرقا يغن الله كلا من سعته ، اوصيكم عباد الله بالقساوة والملالة ، والتجني والجهالة ، واحفظوا قول الشاعر : من الخفيف اذهبي قد قضيت منك قضاءي . . . واذا شءت ان تبيني فبيني خطبة نكاح لبعض الظرفاء : تعاهدوا نساءكم بالسب ، وعاودوهن بالضرب ، وكونوا كما قال الله تعالي : واهجروهن في المضاجع واضربوهن ، ثم ان فلانا في خمول نسبه ، ونقصان ادبه ، خطب اليكم فازهدوا فيه ، فرق الله بينهما ، وعجل لهما حينهما . خطب رجل خطبة نكاح فاطال ، فقام بعض القوم فقال : اذا فرغ هذا فبارك الله لكم ، فعلي شغل . حصر عبد الله بن عامر علي منبر البصرة ، فاشتد جزعه ، فقيل ان  هذا مقام صعب فامتحن فيه غيرك ، فامر وادع بن مسعود ان يصعد ويخطب ، فلما ابتدا الكلام حصر فقال : لا ادري ما اقول لكم ، ولكن اشهدكم ان امراتي طالق ، فهي التي اكرهتني علي حضور الصلاة . ثم امر اخر فصعد المنبر ونظر الي اصلع ، فقال : اللهم العن هذه الصلعة . خطبة خطبها القاضي ابو بكر ابن قريعة في دار ابي اسحاق الصابي : الحمد لله الذي تين فوزر ، وعنب فرزق ، ورطب فسكر ، وخوخ فشطب ، وكمثر فخثر ، ومشمش فصفر ، وبطخ فعسل ، وتفح فعطر ، وموز فانضج ، ودقق فجوز ، وجردق فسمذ ، وبورد فكثر ، وسكرج فلوز ، وملح فطيب ، وخلل فسقنج ، وخردل فحرف ، وبقل فخضر ، وقثا فدقق ، وبورن فنعم ، ومصص فحمض ، وطجن فجفف ، وسنبس فثلث ، وسكبج فزعفر ، وهرس فصولج ، وبصل فعقد ، وسبذج فصعد ، وسمق فمزز ، وطبهج فحرف ، وبيض فعجج ، وجدا فرضع ، وبطط فسمن ، ودجج فصدر ، وفرخ فشام ، وحبب فبرز ، وجوذب فخشخش ، ورزز فالبن ، وخبص فلوز ، وفلذج فحمر ، وقطف فعرف ، ولوزج فسكر . احمد علي الضري الطحون ، والفم الجروش ، والحلق البلوع ، والمعدة الهضوم ، والسفل النثور ، والذكر القءوم ، والغداء والعشاء ، والفطور والسحور ، واشهد ان لا اله الا الله وحده لا شريك له ، خالق السموات ومحلل  الطيبات ، واشهد ان محمدا عبده ورسوله ، مبيح المحللات ، وحاظر المحرمات وان ابا اسحاق ابراهيم بن هلال ، ارشده الله ، اطعمنا فصدرنا ، وماهنا فاثلجنا ، وسقانا فروانا ، ومد ستارته فاسمعنا واطربنا ، واستنشدناه فانشدناه ، واستحدثناه فحدثنا ، فارفعوا ايديكم الي الله عباد الله ، فالدعاء له بما يرد ثواب فعله اليه ، ويسهل الدعوة الثانية عليه ، انه قريب مجيب ، واستغفر الله لي ولكم ولساءر المسلمين اخر باب الخطب والحمد لله وحده ويتلوه ان شاء الله باب المكاتبات والرساءل وصلي الله علي سيدنا محمد اله وسلم  فارغة 
  الباب الحادي والثلاثون في المكاتبات والرساءل
  فارغة  بسم الله الرحمن الرحيم الحمد لله مجزل العطايا والقسم ، منزل البلايا والنقم ، ومعلم الانسان بالقلم ، خصه منه بانواع المنافع والفواءد ، وجعل الغاءب به في حكم الشاهد ، يري به البعيد الناءي كالقريب الداني ، ويبرز ما في الضمير ، مستغنيا عن الوسيط والسفير ، زاد علي فضيلة اللسان بان ناجي القاصي كماجاة الداني ، وبما له من الضبط الباقي علي الحقب والازمان يجمع المتفرق ويحصره ، وينبه الناسي ويذكره ، لولاه تلاشت العلوم بالنسيان الانسي ، ولم يحو نشرها الفكر البشري ، وضاعت الحقوق المضبوطة بالاشهاد ، ولم يقم بادابها قلب حافظ ولا فءاد ، وابلاها طول التقادم ، وانساها السهو الموكول بهذا العالم . اللهم فكما واليت علينا من احسانك ، فلا تءاخذنا بالتقصير في شكر امتنانك ، واجعل لنا في كل نعمة اتيتنا حظا يدنينا من عفوك ورضوانك ، وصل علي محمد النبي الابي الذي منعته الشعر والكتاب ، واتيته الحكمة وفصل الخطاب ، وجعلت علمه بالاولين والاخرين مع عدمهما من دلاءل نبوته وخصاءص رسالته ، وجمعت له بذاك معاني الاعجاز والبراهين ، وتكذيب من قال : ان هذا الا اساطير الاولين . وصلي الله علي محمد واله الغر الميامين .  
  الباب الحادي والثلاثون في المكاتبات والرساءل
 الرساءل والمكاتبات ابسط من الشعر مقالا ، وافسح مجالا ، وان كان اربابها اقل عددا فانهم اشرف محلا ومحتدا ، وقد ذكر الصابي الفرق بين المترسل والشاعر فاجاد ، وحكم فانصف ، وساذكر رسالته هذه في اثناء الباب . وقد اقتصرت علي ما تضمن معني بديعا ، ولفظا فصيحا ، او سيرة معربة ، او قضية معجبة ، وتجنبت الاكثار اذ كان استقصاء فنونها واستغراق فصولها يحتاج الي كتاب مفرد ، ويكون وان اطيل مختصرا . وكانت القدماء توجز المكاتبات وتختصرها ، وتقنع من الالفاظ بمبلغها ، وتري الاطالة عجزا والايجاز اعجازا ، ولذلك قال يحيي بن خالد لاولاده : ان استطعتم ان تكون كتبكم كلها توقيعات فافعلوا . وعدل الناس الان الي الاسهاب ، واعتاضوا عن البلاغة بالتفريغ في الالفاظ ، فمن البليغ الموجز ما قال الله عز وجل حكاية عن كتاب سليمان عليه السلام : انه من سليمان وانه بسم الله الرحمن الرحيم ، الا تعلوا علي واتوني مسلمين .  وكانت كتب رسول الله صلي الله عليه وسلم الي الملوك وغيرهم كلها مختصرة ، وهو صلي الله عليه وسلم الذي لا خلاف في فصاحته عند المقر والجاحد ، بلسانه نزل القران بلسان عربي مبين . كتب الي المنذر بن الحارث بن ابي شمر الغساني ، صاحب دمشق : سلام علي من ابتع الهدي وامن بالله ، فاني ادعوك ان تءمن بالله وحده لا شريك له ، يبقي لك ملكك . وكتب الي ابرويز بن هرمز ملك فارس : من محمد رسول الله الي كسري عظيم الفرس ، سلام علي من اتبع الهدي ، وامن بالله ورسوله ، وشهد ان لا اله الا الله ، واني رسول الله الي الناس كافة لينذر من كان حيا ، اسلم تسلم ، وان ابيت فعليك اثم المجوس . فهذا ونحوه ما كان يكتب عنه صلي الله عليه وسلم ، ومكاتبات الصدر الاول علي هذا النمط كانت ، الا ما يتضمن بلاغا او حجاجا ، فيكون الاسهاب فيه انجع واوقع ، وقد مضي في هذا الكتاب من كتبهم المختصرة وفقرهم ما تجده متفرقا في اماكنه اللاءقة به . وقد كتب بعضهم الي متلوم مترجح بين الطاعة والمعصية : اما بعد ، فاني اراك تقدم رجلا وتءخر اخري ، فاعتمد علي ايتهما شءت . فهذا غاية الايجاز مع قوة الاعذار في الانذار .  وكتب عبد الحميد بن يحيي عن مروان بن محمد الي ابي مسلم كتابا يدعوه الي الطاعة ويخوفه عاقبة الفتن يحمل علي جمل من حجمه ، وضمن ان قراه وسمعه من يطيف به انه يعود الي الطاعة او تتفرق كلمتهم ، وهذا عكس الاول في الاطناب والاطالة . واعتمد ابو مسلم علي احدي الرجلين وبالغ في الايجاز ، فلم يقرا الكتاب واعاده وكتب عليه : من الطويل محا السيف اسطار البلاغة وانتحب . . . عليك ليوث الغاب من كل جانب فان تقبلوا نعمل سيوفا شحيذة . . . يهون عليها العتب من كل عاتب كتب معاوية الي ابي موسي بعد الحكومة وهو بمكة عاءذ بها من علي عليه السلام ، واراد بذلك ان يضمه الي اهل الشام : اما بعد ، فانه لو كانت النية تدفع خطا لنجا المجتهد واعذر الطالب ، ولكن الحق لمن قصد له فاصابه ، ليس لمن عارضه فاخطاه ، وقد كان الحكمان اذا حكما علي رجل لم يكن له الخيار عليهما ، وقد اختار القوم عليك ، فاكره منهم ما كرهوه منك ، واقبل الي الشام فهي اوسع لك . فكتب اليه ابو موسي : اما بعد فاني لم اقل في علي الا ما قال صاحبك فيك ، الا انني اردت ما عند الله تعالي ، واراد عمرو ما عندك ، وقد كان بيننا للمحكوم عليه الخيار ، فانما ذلك في الشاة والبعير ، فاما في امر هذه الامة فليس احد اخذا لها بزمام ما كرهوا ، وليس يذهب الحق بعجز عاجز ولا مكيدة كايد ، فاما دعاءك اياي الي الشام ، فليست بي عن حرم ابراهيم عليه السلام رغبة ، والسلام . قيل ثلاثة تدل علي عقول اصحابها : الكتاب والهدية والرسول .  قال زياد : ما قرات كتاب رجل قط الا عرفت عقله فيه ، وما رايت مثل الربيع بن زياد رجلا : ما كتب الي كتابا قط الا جر منفعة او دفع مضرة ، ولا سالته عن شء قط الا وجدت عنده منه علما ، ولا ناظرته في شء الا وجدته قد سيق الناس فيه ، ولا سايرني قط فمست ركبته ركبتي . ومن رسالة لعبد الحميد بن يحيي في الفتنة : ففي طاعة الاءمة في الاسلام ومناصحتهم علي امورهم ، والتسليم لما امروا به ، حفظ كل نعمة فاضلة ، وكرامة باقية ، وعافية مجللة ، وسلامة ظاهرة وباطنة ، وقوة باذن الله مانعة ، وفي الخلاف عليهم والمعصية لهم ذهاب كل نعمة ، وتفرق كل كرامة ، ومحق كل عصمة ، وهلاك كل سلامة والفة ، وموت كل عزة وقوة ، والدعاء لكل بلية ، ومقارفة كل ضلالة ، واتباع كل حهالة ، واحياء كل بدعة ، واماتة كل سنة ، واجتلاب كل ضرر علي الامة ، وادبار كل منفعة ، والعمل بكل جور وباطل ، وافناء كل حق . وبمعصية خليفة الله لا يزال رجل من المسلمين يضرب بسيفه الذي في يديه سيف اخيه الذي كان يعتمد عليه ، ويوهن عضده ، ويهدم حصنه ، ويقل عدده ، ويهلك ثروته ، وينفرد من ناصره ، ويعطب من يدعوه ويفزع اليه ، ويكثر بمكانه ، ويحرسه من غفلته عن الاعداء اذا غفل ، ويكون عينا له من خلفه فلا يزال بالمعصية منهم والاختلاف دم يهراق بغير حقه ، وطفل من ابناء المسلمين قد يتم من ابيه ، ومذلة قد دخلت عليه ، ونعمة قد زالت عنه ، ووحشة حدثت ، وضغاءن في القلوب قد نشبت ، وشحناء قد ظهرت ، واوتار  قد بقيت ، وعداوة في النفس قد استقرت ، وخوف قد ظهر ، وسبل قد قطعت ، وامراة قد ارملت ، وصبية قد يتمت ، وبلاد عامرة قد خربت ، وعدد قد نقص ، وبلايا قد عمت وشملت ، وعدو قد شمت ، ومنافق قد رفع الي الي ما كان يءمل راسه ، وعدو من المشركين قد طمع ، وقوي بعد ضعف ، وعز بعد مذلة ، ورعية قد ضاعت ، وناعبة قد ولولت ، وحميم قد قتل حميمه ، ومودة قد صارت عداوة ، واجتماع من الاهواء قد عاد الي فرقة ، وارحام قد تقطعت . فانظروا يا معشر المسلمين ماذا تفعل الفتنة والمعصية ، وكيف يدب الشيطان بها ، ويسعي فيها ، ويحتال يخديعته ومكره ولطيف مسالكه ، حتي يلهبها ويشعلها ، ويرفعها من قلتها الي الكثرة ، ومن صغرها الي كبرها ، فانه انما يبدا بالطعن علي الولاة ، ثم يترامي الي الشكاة والسخط والغضب ، وزين لهم القتال ، فبلغ الهلاك الاعظم والشر الاكبر ، بطرف امر صغير الخطر في الظاهر عظيم البلية في الباطن ، فلا يزال الرجل ينظر منهم الي قاتل ابيه واخيه وحميمه وذوي قرابته واهل مودته ، والنافع  كان  له ، ثم يحمل العداوة في قلبه ، والحقد في نفسه ، والضغينة العظيمة عليه ، ويستعد للنقمة منه ، وطلب الذحل عنده ، فتثبت تلك الضغاءن في الابناء بعد الاباء . فانظروا يا اهل الاسلام من اين دب الشيطان بلطيف مسالكه ، وعلي اي شء ورد ، والي اي امر ترامي حتي عم بالمعصية اهل الاسلام عامة . ومن كلامه  يعني عبد الحميد  في الطاعة : اما بعد ، فان الله تباركت اسماءه ، وجل ثناءه ، وتعالي ذكره ، اختار لنفسه من الاديان والملل كلها الاسلام ، ثم جعل اهله الذين اكرمهم به ، واصطفاهم له ، خيرته من عباده  واهل صفوته ، وبعث به اليهم نبيه صلي الله عليه وسلم ، وسماهم المسلمين ، وهو الذي شرع لساكني سماواته من ملاءكته ، ولاهل الارض من انبياءه ، ثم بعثهم به فقال : شرع لكم من الدين ما وصي به نوحا والذي اوحينا اليك وما وصينا به ابراهيم وموسي وعيسي الي اخر الاية . فبلغ رسول الله صلي الله عليه وسلم رسالات ربه ونصح لامته ، ومضي لامره ، وجاهد علي حقه من خالفه وعاداه وابتغي سبيلا غير سبيله ، ثم امن به وصدقه وعززه ونصره ، واتبع النور الذي انزل معه ، وهم يومءذ قليل مستضعفون في الارض ، يخافون ان يتحفظهم الناس كما وصفهم الله تبارك وتعالي في كتابه ، امرا رضيه لنفسه ونبيه ، ابتعثه له حتي اتم الله الاسلام وكمله وفضله وجعله دينه ، واعلم حقه من شاء من عباده وخلقه ، وبين لهم انه الههم وربهم ، امرهم بطاعته ، والاعتصام بحبله ، والتمسك بعهده ، ثم توكل لهم بالحفظ والدفع والنصر والقهر ، والظهور علي من خالفهم ، وابتغي غير سبيلهم ، ما حفظوا امره ، وتمسكوا بطاعته ، ووفوا بعهده ، والله ولي الاسلام ، والناصر له علي عدوه ، وولي اعزازه واظهاره علي الدين كله ولو كره المشركون ، قضاء منه بتا لا مرد له ، وموعدا لا خلف له ، وسنة ماضية في الذين خلوا من قبل ولن تجد لسنة الله تبديلا . فان الله بعهده ونعمته لم يزل يصنع لهذا الدين ، ويغلب له بالفءة القليلة من اهله الفءة الكثيرة من عدوه ، قضاء منه اوجبه علي نفسه ، لم يجعل فيه مثنوية ، تصغي اليه افءدة اهل الريبة والشك في امره ، ولكن حتمه علي نفسه ، واوجبه لهم في كتابه ، واعلمهم فيه معالم طاعته ومسالك معصيته ، ليهلك من هلك عن بينة ، وان الله لسميع عليم . فدين الله الذي خص به اولياءه اولهم واخرهم ، تام علي ما بعث به نبيه صلي الله عليه وسلم ، فان الله ختم به الانبياء ، وقفي به الرسل ، وجعل امته خير امة اخرجت للناس يامرون بالمعروف وينهون عن المنكر ، وجعل الله نظام الدين الذي اختاره لنفسه ، وشرعه لمن اكرم من خلقه ، فارتضي لتنزيل وحيه من ملاءكته ، وتبليغ رسالاته من انبياءه ، الي عباده . وقوامه وعصمته الطاعة التي  جمع الله فيها شعب الخير وانواع البر ومناقب الفضل ، وجعلها واصلة بالاسلام سببا الي كل هدي وفضيلة ، واختيارا لكل سعادة وكرامة ، في عاجل واجل ، مع ما توكل به من حفظها ومنعها ، والذب عن حرمتها ، والنصر لمن جاهد عليها ، والاعلاء لمن اوجبها له من ولاة الحق وانصار الدين ، والاظهار لهم علي من خالفهم ونكب عن سبيلهم ، واراد المفارقة لحقهم ، الي ما كان اعد لحزبها واولياءها الذين نصرهم الله واحلهم  بما لزموا منها وحدبوا عليها من التمسك بها  في رضوان الله والنعيم المقيم لا تغيير له ولا انقطاع ولا زوال ، عطاء من ربك غير مجذوذ . وجعل المعصية شقاء وخسارا وتبارا ، وسببا لكل نقص وذل وهوان وحسرة ، فمن اعتصم بها ، واقام عليها ، ودعا اليها ، كان من اخوانها والغواة فيها ، مع ما يريهم الله في عاجل امرهم : من ادحاض حجتهم ، وسوء مصارعهم ، وقطع مددهم ، وتفريق نظامهم ، وازهاق باطلهم ، واظهار اهل الطاعة عليهم ، وامكانه منهم في كل مجمع يجمع الله منهم جماعة ، الي ما اعد الله لهم من اليم العقاب ، وسوء الحساب ، وشديد العذاب ، لا يفتر عنهم ، ولا هم فيه مبلسون . فمن اراد الله اسعاده وتوفيقه وتبصيره حظه لزم الطاعة وعرف حقها ، وما جعل الله فيها من السعة والعصمة والمخرج ، واثرها وواظب عليها ، وكان من اهلها ، وادي الحق الذي اوجبه الله عليه لوليها اليه ، فاحرز بذلك نفسه ، وسلم به دينه ، واستكمل به افضل ما يرغب به من ثواب ربه ، ولم يكن متخوفا للغير في دنياه ، متوقعا للنقم ، متوكفا للقوارع احلت باهل المعصية والخلاف والمفارقة للحق واهله ، وكان من ذلك في امن ونجاة وسلامة وعافية . ومن اراد الله به غير ذلك ، لما يعلم من ضميره ودفينه ، تخلي منه ، واسلمه الي قرينه وما يسول له من غروره ، ويمنيه من اباطيله ، فاستشعروا ركوبها ودخلوا مع الغواة فيها ، ودعوا اليها ، فكانوا خاءفين ، ولاءذين مترقبين للدواءر التي يخافون ان تحل بهم ، وتاتي عليهم . فغن الله تعالي يقول : ولا يزال الذين كفروا تصيبهم بما صنعوا قارعة او تحل قريبا من دارهم حتي ياتي وعد الله ان الله لا يخلف الميعاد .  وامير المءمنين يساله ان يلهمه الرافة والرحمة برعيته ، والاصلاح اليهم ، والمعدلة فيهم ، وان يلهم رعيته الطاعة والوفاء والمنصاحة ، ويزيد المحسن منهم احسانا ، ويقبل توبة التاءب ، ويراجع المسء الي محبته ، وان يلهمه واياكم خالص الشكر وصالح العمل . امر المامون احمد بن يوسف ان يكتب في الافاق بتعليق المصابيح في المساجد في شهر رمضان ، قال : فاخذت القرطاس لاكتب فاستعجم علي ، ففكرت طويلا ثم غشيتني نعسة فرايت في النوم قاءلا يقول لي : اكتب فان في كثرة المصابيح اضاءة للمتهجدين ، وانسا للسابلة ، ونفيا لمكامن وتنزيها لبيوت الله عز وجل عن وحشة الظلم . قال حمدون بن اسماعيل : دخلت علي المامون يوما وهو في بعض صحون بساتينه يمشي حافيا ، وفي يده كتاب يصعد بصره فيه ويصوبه ، فالتفت الي وقال : احسبك راعك ا رايته ، قلت : واي شء اروع لي من نظري لي سيدي يمشي حافيا ويقرا كابا قد شغله واذهله ، فقال لي : اني سمعت الرشيد يقول شيءا لم اتوهمه ينسبك علي حقيقته ، وهو انه قيل لبعض البلغاء : ا البلاغة ؟ قال : التقرب من المعني البعيد ، والتباعد من حشو الكلام ، والدلالة بالقليل علي الكثير ؛ وهذا كتاب عمرو بن مسعدة ، قد اتي في حرفين بما كان ياتي به غيره في طوماء ، وصف حال الجند وطاعتهم . ثم دفعه الي ، فاذا فيه : كتابي الي امير المءمنين ومن قبلي من قواده واجناده ، من الانقياد للطاعة علي احسن ما تكون طاعة جند تاخرت ارزاقهم واختلت احوالهم ، والسلام .  ثم قال : اشهد اني قد قضيت حق هذا الكلام وكتبت الي جندي باعطياتهم ، وتركتهم لا يتمنون موتي ، وامرت بالزيادة في ارزاقهم . كتب احمد بن سعد الكاتب : وقديما غرقت الفتن ابناءها ، واسكنتهم ربعها ، وارضعتهم درها ، والحفتهم ظلها ، واسحبتهم ذيلها ، ونقلتهم في مراتع الغرور ، وارتهم الثقة بدوام السرور ، والامن لعوارض المحذور وعواقب المقدور ، فتمادوا في منهج الضلال ، وتراموا في مسلك الفساد ، وتشعبوا في طريق الغي ، حتي اذا تم الرضاع ، ونجم الفطام ، وان لحكم الله ان يمضي ، ولباسه ان ينزل ، سلط الله عليهم سيوف الحق ، فصاروا لاهله جزرا ، وللباطل واهله عبرا ، وللمواعظ السالفة نتيجة ، وللمواعد المحدودة حقيقة ، ولبصيرة ذوي البصاءر قوة ، ولثقة اهل العصمة مادة ، ولسوط العذاب نمصبا ، ولنار الجحيم حطبا ، وما الله بظلام للعبيد . فصل : من معقل الي عقال ، ومن اجل الي اجال . عبد الحميد في ذكر الفتنة : فان الفتنة تستشرف باهلها ، متشوفة بانق منظر ، وازين ملبس ، تجرر لهم اذيالها ، وتضريهم وتعدهم تتابع دراتها حتي ترمي بهم في حدرات امواجها مسلمة لهم ، تعدهم الكذب وتمنيهم الخدع ، فاذا لزمهم عضاضها ، ونفر بهم شماسها ، تخلت عنهم خاذلة لهم ، وتبرات منهم معرضة عنهم ، قد سبلوا اجمل لباس دينهم ، واستنزلوا عن حصن دنياهم ، الغني البهي منظره ، الجميل اثره ، حتي تطرحهم في فضاءح اعمالهم الي الايجاف في التعب وسوء النمقلب ، فمن اثر دينه علي دنياه ، تمسك بطاعة ولاته ، وتحرز بالدخول الي مرضاته في الجماعة ، تاركا لاثقل الامرين واوبل الحالين .  فصل : فزرعوا الضغاءن في قلوبكم ، وغرسوا اشجار الاحن في صدوركم ، واوقدوا نيران الاحقاد بينكم ، الله الله في ذكر الحمية وفخر الجاهلية ، وملاقح الشنان ، ومنافح الشيطان . فصل : حتي اعنقوا في حنادس ظلم جهالته ، ومهاوي سبل ضلالته ، ذللا علي سياقه ، وسلسا في قياده ، الي نزل من حميم ، وتصلية جحيم ، سوي ما القحت الحفيظة في نفسه من عواءد الحسد ، وقدحت الحمية في نفسه من نار الغضب ، ونفخ الشيطان في سحره من ريح الكبر ، مضادة لله تعالي بالمناصبة ، ومبارزة لامير المءمنين بالمحاربة ، ومجاهرة للمسلمين بالمخالفة . فصل من كتاب للمامون ، وقد ولي عبد الله بن طاهر في فتنة : ممتدة الي الفتن اعناقهم ، متطلعة اليها انفسهم ، مرتاحة لها قلوبكم ، مصيخة الي دعواها اسماعهم ، فلم تذك للفتنة نار الا منهم ساعر يشب ضرامها ، اما موجفا ركابه ، مبديا صفحته في مباشرتها ، واما موريا عن نفسه يدب الخمر ، ويستتر تحت الشبه ، ليحسب انه بمعزل عنها ، ونافذ كيده يسري في تسهلها . احمد بن سعد من كتاب فتح : الحمد لله العظيم شانه ، العلي مكانه ، المنير برهانه ، القوي سلطانه ، الذي ابتدع الخلق بحكمته ، وانشاهم بقدرته ، واجري الامور علي مشيءته ، وصرفها علي ارادته ، وحكم لاولياءه واهل طاعته ، الذاءدين عن حريمه ، المانعين لحوزته بالاعلاء والتمكين ، والنصر والتاييد ، وعلي اعداءه الغامطين لنعمته ، الناهكين لحرمته ، الساعين بالفساد في بلاده ، والعدوان علي عباده ، بالخذلان والتشريد ، والنكال المبيد . ومن رسالة له في السلم : فاكتفوا في المعرفة به جل جلاله بخبر  العقول وشهادة الافهام ، ثم استظهر لهم في التبصرة ، وعليهم في الحجة ، برسل ارسلهم ، وايات بينهان ومعالم اوضحها ، ومنارات بمسالك الحق رفعها ، وشرع لهم الاسلام دينا ، وارتضاه واصطفاهن وفضله واسناه ، وشرفه واعلاه ، وجعله مهيمنا علي الدين كله ولو كره المشركون ، وقرن العز بحزبه واهله ، فقال عز من قاءل : هو الذي ارسل رسوله بالهدي ودين الحق ليظهره علي الدين كله ولو كره المشركون ، وايده بانبياءه الداعين اليه ، والناهجين لطرقه ، والهادين لفراءضه ، والمخبرين عن شراءعه ، قرنا بعد قرن ، وامة بعد امة ، في فترة بعد فترة ، وفءة بعد فءة ، حتي انتهي بقدره جل ذكره الي مبعث النبي الامي ، الفاضل الزكي ، الذي قفي به علي الرسل ، ونسخ بشريعته شراءع الملل ، وبدينه اديان الامم ، علي حين فترة وترامي حيرة ، فاباخ به نيران الفتن ، بعد اضطرامها ، واضاء به سبل الرشاد بعد اظلامها ، علي علم نمه تعالي ذكره ، بما وجد عنده من النهوض باعباء الرسالة ، والقيام باداء الامانة ، فازاح بذلك العلة وقطع المعذرة ، ولم يدع للشاك موضع شبهة ، ولا للمعاند دعوي مموهة ، حتي مضي حميدا فقيدا ، تشهد له اثاره ، وخلف في امته ما اصارهم به الي عطف الله ورحمته ، والنجاة من عقابه وسخطته ، الا من شقي بسوء اختياره ، وحرم الرشد بخذلانه ، صلي الله عليه وعلي اله افضل صلاة واعمها ، واوفاها واتمها . والحمد لله الذي خص سيدنا الامير بالتوفيق ، وتوجه له بالارشاد والتسديد ، في جميع انحاءه ومواقع اراءه ، وجعل همته  اذ كانت الهمم الي خدع الدنيا صادفة ، وزخارفها التي تتجلي بها لابناءها وتدعو الي نفسها  مقصورة الي ما يجمع له رضي ربه ، وسلامة دينه ، واستقامة امور مملكته ، وصلاح احوال رعيته ، وايده في هذه الحال العارضة ، ولاشبهة الواقعة ، التي تحار في مثلها الاراء ، وتضطرب الاهواء ، وتتنازع خواطر النفوس ، وتعتلج وساوس الصدور ، ويخفي موضع الصواب ، ويشكل منهج الصلاح ، بما  اختاره له من السلم والموادعة والصلح والموافقة التي اخبر عن فضله ، والخير الذي في ضمنه يقوله بقوله : والصلح خير وقوله : وان جنحوا للسلم فاجنح لها . فاصبح السيف مغمودا ، ورواق الامن ممدودا ، والهواء متفقة ، والكلمة مجتمعة ، ونيران الفتن والضلالة خامدة ، وظنون بغاتها الساعين لها كاذبة ، وطبقات الاولياء والرعية بما اعيد اليهم من الامنة بعقب الخيفة ، والانسة بعد الوحشة ، مستبشرين ، والي الله في اطالة بقاء الامير راغبين ، وفي مسالته مخلصين . ولو لم يكن السلم في كتاب الله مامورا به ، والصلح مخبرا عن الخير الذي فيه ، لكان فيما يتنظم من حقن الدماء وسكون الدهماء ، ويجمع من الخلال المحمودة ولفضاءل المعدودة المقدم ذكرها ، ما حدا عليه ، ومثل للعقول السليمة والاراء الصحيحة موضع الخيرة فيه ، وحسن العاءدة علي الخاص والعام ، فيما ينجلي للعيون من مشتبهات الظنون ، اذ الريب واقع ، والشك خالج بين المحق والمبطل ، والحق والباطل ، والجاءر والمقسط ، وقد قال الله عز وجل : لولا رجال مءمنون ونساء مءمنات لم تعلموهم ان تطءوهم فتصيبكم منهم معرة بغير علم ، ناظرا للمسلين من معرة او مضرة تلحق بعضهم بغير علم ، ومءثرا تطهيرهم من ظنن العدوان ، مع رفعه عنهم فرطات النسيان ، وكافا ايدي المسلمين عن المشركين ، كما كف ايديهم عن المسلمين ، تحسنا علي بريته ، وابقاء علي اهل معصيته ، الي ان تتم لهم المحنة للذي ارتاه ، والامر الذي ارتضه ، وموقع الحمد في عاقبته ، والسلامة في خاتمته ، وبلغه من غايات البقاء امدها ، ومن مواقع العيش ارغدها ، مقصرا ايدي النواءب عما خوله ، ومغضوضيا اعين الحوادث عما نوله ، انه جواد ماجد . وفي مثل ذلك : الحمد لله ذي النعمة السابغة ، والحكمة البالغة والبلاء الجميل ، والعطاء الجزيل ، الذي جعل بعد عسر يسرا ، وبعد ضنك رحبا ،  وبعد تناء تدانيا ، وبعد تعاد تصافيا وحبا ، واعقب افتراقا من المتشاحنين اعترافا ، واختلافا اءتلافا ، وتدابرا تناصرا ، وتخاذلا تظاهرا ، نظرا لخلقه وعاءدة عليهم ، واعتمادا لما فيه مصالح اخرتهم ودنياهم ، ومدح الصلح وحدا عليه ، وحمد السلم اذا جنح الخصم اليه ، فقال عز وجل من قاءل : والصلح خير وقال : وان جنحوا للسلم فاجنح لها والف بين القلوب في سبيله ، ولامها في نصرة رسوله ، وقال : هو الذي ايدك بنصره وبالمءمنين ، والف بين قلوبهم لو انفقت ما في الارض جميعا ما الفت بين قلوبهم ولكن الله الف بينهم ، انه عزيز حكيم وصان المسلمين  عند الفتح العام للبلد الحرام ، واظهار الاسلام علي الدين كله ، والادالة من الكفر واهله  عما يلحق من في دارهم من مسلم او مسلمة  غمرتها الجملة واخفت من موضعها الشبهة  من مضرة ، وسماها للمسلمين معرة ، وجعلها واصلة اليهم اذا وصلت الي اولءك منهم ، فقال جل ذكره : ولولا رجال مءمنون ونساء مءمنات لم تعلموهم ان تطءوهم فتصيبكم منهم معرة بغير علم فحماهم من يسير الاثم ، وان كان ساقطا بعد العلم ؛ واختار لهم الخلوص من الشواءب في الدين وجعل هذه الغلال الرضية والخصال الحميدة لهم ادبا ولمصالحهم سببا ، فندلهم لها ، وارشدهم الي سوابق نعمه ، ونفاءس قسمه ، التي بدا بها قبل الاسيجاب ، واوجب علي شكرها حسن الثواب ، حمدا يرتفع اليه ، ويزكو لديه ، ويمضي ما فرض في تحميده ، ويوجب ما ياذن به من مزيده ، وصلي الله علي محمد عبده وامينه علي وحيه ، وخيرته من خلقه ، والمبعوث لاحياء دينه ونصرة حقه ، وعلي الطيببين من اله وسلم تسليما . وفي مثل ذلك . . . الحمد لله مقلب القلوب وعالم الغيوب ، الجاعل بعد عسر يسرا ، وبعد عداوة ودادا ، وبعد تحارب اجتماعا ، وبعد تباين  اقترابا ، رافة منه بعباده ولطفا ، وتحننا عليهم وعطفا ، لءلا يستمر بهم التتايع في التدابر والتقاطع ، وليكونوا بررة اخوانا ، وعلي الحق اعوانا ، لا يتنكبون له منهجا ، ولا يركبون من الشبهة ثبجان بغير دليل يهديهم قصد المسالك ، ولا مرشد يودهم عن ورود المهالك ؛ احمده علي نعمه التي لا يحصي الواصفون احصاءها ، ومننه التي لا يءدي الشاكرون جزاءها ، واياديه التي لا يحمل الخلق اعباءها ، حمدا يتجدد علي مر الازمان والدهور ، ويزيد علي فناء الاحقاب والعصور ، ويقع بمحابه في جميع الامور ، فان احق ما استعمله الغالون ، ونطق به التالون ، واثره المءمنون ، وتعاطاه بينهم المسلمون ، فيما ساء وسر ، ونفع وضر ، ما اصبح به الشمل ملتءما ، والامر منتظما ، والفتق مرتتقا ، والصلح متسقا ، والسيف مغمودا ، ورواق الامن ممدودا ، فحقنت به الدماء ، وسكنت به الدهماء ، وانقمع له الاعداء ، واتصل به السرور ، وامنت معه الشرور ، وليس شء بذلك اولي ، والي احراز الثواب به ادني ، من الصلح الذي امر الله تبارك وتعالي به ، ورغب فيه وندب اليه ، فقال وقوله الحق : لا ياتيه الباطل من بين يديه ولا من خلفه فاصلحوا بين اخويكم . كتب سهل بن هارو الي ذي الرياستين : ان للازمة فرجا ، فكن من ولاة فرجها ، ولايامها دولا ، فخذ بحظك من دولتك منها ، ولدولها امتدادا فتزود قبل اوان تصرمها ، فان تعاظمك ما انباتك عنه فانظر في جوانبها تاخذك الموعظة من جميع نواحيها ، واعتبر بذلك الاعتبار علي انك مسلم ما سلم اليك منها . فكتب عهده علي فارس .  كتب عمرو بن مسعدة : وانا احب ان يتقرر عندك ان املي فيك ابعد من ان اختلس الامور اختلاس من يري في عاجلك عوضا من اجلك ، وفي الذاهب من يومك بدلا من المامول في غدك . قال المبرد : كانت في الحسن بن رجاء شراسة ، وفي كفه ضيق ، فكتبت اليه : الناس  اعز الله الامير  رجلان : حر وعبد ، فثمن الحر الاكرام ، وثمن العبد الانعام ، فاصلحه هذا القول لي ولغيري مدة ثم رجع الي طبعه . كاتب : الحمد لله الذي جعل محنته عطفا وادبا ، ولم يجعلها هلكة ولا عطبا ، وجعل اواءلها ناطقة علي صواب اواخرها ، وبواديها مخبرة عن حميد عواقبها ، ومواردها مبشرة بالسلامة في مصادرها . ابراهيم بن العباس في ذكر خليفة : الحمد لله الذي يجتبي اليه من يشاء باصطفاءه ، ويهدي اليه من ينيب باجتباءه ، ويرفع درجات من يشاء بقدرته ، ويختار لهم بلطفه ، وهو اعلم حيث يجعل رسالته ، ويودع مناءح نعمته ، ويولي مقاسم فضله ، ويكسو عز سلطانه ، مصطفي ال ابراهيم بالكتاب والحكمة ، ومختصهم بالملك والعظمة ، ومءتيهم الحكمة في الذكر القديم ، فقال تعالي : ام يحسدون الناس علي ما اتاهم الله من فضله ، فقد اتينا ال ابراهيم الكتاب والحكمة واتيناهم ملكا عظيما . والحمد لله الذي جعل الخلافة عقيب الرسالة ، فاحيا بها ايامها ، ووطد بها اعلامها ، وانفذ فيها احكامها ، وانتخب لها من اهل الوراثة ولاة راشدين ، وهداة مهدين ، اساة للعالمين ذرية بعضها من بعض والله سميع عليم . فانار بهم معالم دينه الذي اصطفاه ، واوضح دلاءل الحق الذي اعلاه ، وظاهر بهم فضله الذي اولاه ، وخصهم من اظهاره واظفاره ، بما ياذن  لاولياءه وانصاره . والحمد لله الذي اكرم امير المءمنين بما قاد اليه من الخلافة ، واصار اليه من الوراثة ، ووطا له من الامانة علي مشارف بنيانه ، وارسي قواعد اركانه ، وحمي حريم سلطانه ، وجعل ايامه ايام نضارة وغضارة ، وامن وسلامة ، وهدوء واستقامة ، بما اسند اليه من مراعاة صلاح عباده ، واضافة العدل في بلاده ، والاجتهاد في تلافي كل فاسد ، وضم كل ناشر ، واستعادة كل نافر ، حتي اعتدلت قناة الملك في يده ، وشرف منار الحق في دولته ، وزهق الباطل في دعوته ، وسارعت الرفاهة في ابالته ، واتصلت السعادة بسياسته ، فاصبحت الدهماء ساكنة ، والثغور مسددة . فصل من كتاب عن اجناد طرف يذكر طاعتهم : قد اعد الله منا لامير المءمنين في نصرة الدولة ، وحماية البيضة ، ودفع الخطوب الملمة ، وكفاية الامور المهمة ، عزاءم ماضية ، وايديا علي الحق متناصرة ، واعوانا علي الخير متوازرة ، لا يتخونهم وهن في الايد ، ولا ضعف في الكيد ، ولا انتقاص في العدد ، ولا انقطاع في المدد ، باغين عند الله الحسني يجميل بلاءهم ، وعند امير المءمنين الزلفي بصادق ولاءهم . فصل في وصف وال : نعمه عامة لجميع المسلمين ، عاءدة بعمارة الدين ، منتظمة بعز الدولة وحماية البيضة ، وصيانة المملكة ، بعد شمول البلاء ، واضطراب الدهماء ، وتشعب الاهواء ، وتطلع اقاصي الاعداء ، وانتهاء الفساد الي حيث يعيي حسمه ، والفتق الي حيث يعجز رتقه . فان سيدنا نهض من هذا الخطب العظيم الذي لم يمر بالاسلام مثله ، ولا حملت الكواهل بعض ثقله ، فساسه بصاءب راءه ، وشفاه من معضل داءه ، بما قد اعيا قدما انصار الدولة والملوك الذين جملت السير بذكرهم ، واثر ما بان من فضلهم . فصل في ولاية خليفة :  ولم يزل الله منذ اضطرب حبل المملكة ، وظهر اعداء الدولة ، يصرف مشيءته ، وينقل ارادته ، مختارا لموضع امامته ، ومرتادا لمحل خلافته ، وان كان قد تقدم علمه بمواقع الاختيار ، لكنه جل جلاله تجري عادته في الاناة تاديبا للخليقة ، وزجرا لذوي العجلة عن تورد الامور المشكلة ، وتقحم اثباجها قبل اعمال الروية ، حتي وقف اصطفاءه وقصر اجتباءه علي امير المءمنين ، فاقرها منه في موطنها ، وثبتها في معدنها ؛ ووجده لما اصطفاه بها ناهضا ، وفيها قاءما بحقها ، راتقا لفتقها ، صادفا عن الدنيا وراءعات زبرجها ، وموتقات زخرفها ، لا تثنيه دواعي لذاتها ، ولا تطبيه عوارض شهواتها ، عن طلب ما عند الله ، وابتغاء الزلفة بين يديه ، والقربة اليه ، في عمارة الدين ، وحياطة المسلمين ، واقامة معالم الحق ، واحياء سنن العدل ، طاويا كشحه علي صفاء نيته ، ونقاء سريرته ، وصارفا همه الي ما فيه المزية والمعدلة في البرية ، وساميا بهمته الي تاييد المملكة وتاكيد اسبابها ، وتعديل احوالها ، بعد مشارفتها الاصفار من بهجتها ، والاخفاق من زينتها ، والاخلاق من جديدها ، والتشعث من نضرتها ، حتي استقامت علي افضل سبلها ، وخلصت من شواءب الافات المكتنفة لها ، وثاب الي الدين عزه ، والي الاسلام نوره ، واستودعت الامانة من اداها ، وسيقت الايالة الي من يقوم بحكم الله فيها ، وحاط من الزيغ حواشيها ، ونهد للاعداء الممتدة اعناقهم ، المنطلقة اطماعهم ، براي يفل السيف الحسام ، وعزم يكل الجحفل اللهام ، فثني من غربهم ، وهون من خطبهم ، واصبح بنعمة من الله لزمانه قريعا ، وللخلق غياثا وربيعا ، وللمسلمين وزرا وحصنا منيعا ، وقام فيما ناطه الله به ، وطوقه اياه ، مقام السالفين من اباءه الطاهرين ،  والاءمة الراشدين ، سابقا لشاوهم بمهله ، وموفيا عليهم بصالح عمله ، وان كانوا في الفضل علي تشابه في المقاييس ، وتصاقب في المنازل ، غير ان الله تعالي فاوت بين الانبياء في الدرجات ، وان كان قد انتظمهم في مجامع الخيرات . كتب المعتصم الي المامون في كتاب فتح تولاه له : وكتابي هذا كتاب منه لخبر ، لا معتد باثر . كتب ابو الفضل ابن العميد  وهو محمد بن الحسين بن محمد ، وابوه ابو عبد الله الحسين ، وكان وزيرا كاتبا بخراسان واصله من قم  الي ملكان ونداد خرشيد عند استعصاءه علي ركن الدولة ابي علي : كتابي وانا مترجح بين طمع فيك ، وياس منك ، واقبال عليك ، واعراض عنك ، فانك تدل بسابق حرمة ، وتمت بسالف خدمة ، ايسرهما يوجب رعاية ، ويقتضي محافظة وعناية ، ثم تشفعهما بحادث غلول وخيانة ، وتتبعهما بانف خلاف ومعصية ، وادني ذلك يحبط اعمالك ، ويمحق كل ما يرعي لك لا جرم اني وقفت بني ميل اليك ميل عنك اقدم رجلا لصمدك ، واءخر اخري عن قصدك ، وابسط يدا لاصطلامك واجتياحك ، واثني ثانية نحو استبقاءك واسصلاحك ، واتوقف عن امتثال بعض المامور فيك ، ضنا بالنعمة عندك ، ومنافسة في الصنيعة لديك ، وتاميلا لفيءتك وانصرافك ، ورجاء لمراجعتك وانعطافك ، فقد يغرب العقل ثم يءوب ، ويعزب اللب ثم يثوب ، ويذهب الحزم ثم يعود ، ويفسد العزم ثم يصلح ، ويضاع الراي ثم يستدرك ، ويسكر المرء ثم يصحو ، ويكدر الماء ثم يصفو ؛ وكل ضيقة فالي رخاء ، وكل غمرة فالي انجلاء . وكما انك اتيت من  اساءتك بما لم تحتسبه اولياءك ، فلا تدع ان تاتي من احسانك بما لا يرتقبه اعداءك . وكما استمرت بك الغفلة حتي ركبت ما ركبت ، واخترت ما اخترت ، فلا عجب ان تنتبه انتباهة تبصر فيها قبح ما صنعت ، وسوء ما اثرت ، وساقيم علي رسمي في الابقاء والمماطلة ما صلح ، وعلي الاسيناء والمطاولة ما امكن ، طمعا في ايناسك ، وتحكيما لحسن الظن بك . فلست اعدم فيما اظاهره من اعذار ، وارادفه من انذار ، احتجاجا عليك ، واستدراجا لك ، ن فان يشا الله يرشدك ، وياخذ بك الي خظك ويسددك ، فانه علي كل شء قدير . فصل منها : وزعمت انك في طرف من الطاعة بعد ان كنت متوسطها ، فاذا كنت كذاك فقد عرفت حاليها ، وحلبت شطريها ، فنشدتك الله لما صدقت عما سالتك عنه : كيف وجدت ما زلت عنه ؟ وكيف وجدت ما صرت اليه ؟ الم تكن من الاولين في ظل ظليل ، ونسيم عليل ، وريح بليل ، وهواء عذي ، وماء روي ، ومهاد وطي ، وكن كنين ، ومكان مكين ، وحصن حصين ، يقيك المتالف ، ويءمنك المخاوف ، ويكفيك من نواءب الزمان ، ويحفظك من طوارق الحدثان ، عززت به بعد الذلة ، وكثرت بعد القلة ، وارتفعت بعد الضعة ، وايسرت بعد العسرة ، واثريت بعد المتربة ، واتسعت بعد الضيقة ، واطافت بك الولاة وخفقت فوقك الرايات ، ووطء عقبك الرجال ، وتعلقت بك الامال ، وصرويكاثر بك ، وتشير ويشار اليك ، ويذكر علي المنابر اسمك ، وفي المحاضر ذكرك ؟ ففيم الان انت من الامر وما  العوض مما عددت ؟ والخلف مما وصفت ؟ وما استعددت حين اخرجت من الطاعة نفسك ، ونفضت منها كمك ، وغمست في خلافها يدك ؟ وما الذي اظلك بعد انحسار ظلها عنك ؟ اظل ذو ثلاث شعب ، لا ظليل ولا يعني من اللهب ؟ ومنها : تامل حالك ، وقد بلغت هذا الفصل من كتابي مستكرها ، والمس جسدك ، وانظر هل يحس ؟ واجسس عرقك هل ينبض ؟ وفتش ما حنيت عليه اضلاعك ، هل تجد في عرضها قلبك ؟ وهل حلا بصدرك ان تظفر بموت سريح ، او يفوت مريح ؟ ثم قس غاءب امرك بشاهده ، واخر شانك باوله . حكي عن ملكان  وكان ادب امثاله  انه كان يقول : والله ما كانت حالي عند قراءة هذا الفصل الا كما اشار اليه الاستاذ الرءيس ، ولقد ناب كتابه عن الكتاءب في عرك اديمي واستصلاحي ، وردي الي طاعة صاحبه . ومن كتاب الي عضد الدولة : وقد يعد اهل التحصيل في اسباب انقراض العلوم وانتقاص مددها ، وانتقاص مررها ، والاحوال الداعية الي ارتفاع جل الموجود منها ، وعدم الزيادة فيها : الطوفان بالماء والنار ، والموتان العارض من عموم الاوباء ، وتسلط المخالفين في المذاهب والاراء ، فان كل ذلك يخترم العلوم اختراما ، وينتهكها انتهاكا ، ويجتث اصولها اجتثاثا . وليس  عندي   الخطب في جميع ذلك يقارب ما يولده تسلط ملك جاهل تطول مدته ، وتتسع قدرته ، فان البلاء به لا يعدله بلاء . وبحسب عظم المحنة بمن هذه صفته ، والبلوي بمن هذه صورته ، تعظم النعمة في تملك سلطان عالم عامل كالامير الجليل الذي احله الله من الفضاءل بملتقي طرقها ، ومجتمع فرقها ، فهي نور نوافر ممن لاقت حتي تصير اليه ، وشرد نوازع حيث حلت حتي تقع عليه ، تتلفت اليه تلفت الوامق ، وتتشوف نحوه تشوف الصب العاشق ، قد ملكتها وحشة المضاع ، وحيرة المرتاع : من الطويل فان تعش قوما بعدهم او تزورهم . . . فكالوحش يدنيها من الانس المحل فصل من كلام الصابي في تقليد المطيع ابنه الطاءع ما كان اليه من الخلافة : ولما صار في السن العليا والعلة العظمي ، بحيث يحرج ان يقيم معه علي امامة قد كل عن تحمل كلها ، وضعف عن النهوض بعبءها ، خلع ذلك السربال علي امير المءمنين الطاءع لله خلع الناص عليه ، المسلم اليه ، خارجا الي رب العالمين وجماعة المسلمين من الحق في حسن ايالتهم وسياستهم ، مما استقل واضطلع ، وفي حسن الاختيار والارتياد لهم ، حين حسر وظلع . ومن كلامه : للنعم شرط من الشكر لا تريم ما وجدته ، ولا تقيم اذا فقدته ، وكثيرا ما تسكر الواردين حياضها ، ويغشي عيون المقتبسين  ايماضها ، فيذهلون عن امتراء درتها ، ويعمهون عن الاستمتاع بنضرتها ، ويكونون كمن اطار طاءرها لما وقع ، ونفر وحشيها حين انس ، فلا يلبثون ان يتعروا من جلبابها ، وينسلخوا من اهابها ، ويتعوضوا منها الحسرة والغليل ، والاسف الطويل . ولما نقل بختيار ابنته المزوجة بابي تغلب ابن حمدان كتب عنه الصابي في معناها فصلا ، وهو : قد توجه ابو النجم بدر الحرمي  وهو الامين علي ما يلحظه ، والوفي بما يحفظه  نحوك يا سيدي ومولاي بالوديعة ، وانما نقلت من وطن الي سكن ، ومن مغرس الي معرس ، ومن ماوي بر وانعطاف ، الي مثوي كرامة والطاف ، ومن منبت درت لها نعماءه ، الي منشا تجود عليها سماءه ، وهي بضعة مني انفصلت اليك ، وثمرة من جني قلبي حصلت لديك ، وما بان عني من وصلت حبله بحبلك ، وتخيرت له باهر فضلك ، وبواته المنزل الرحب من جميل خلاءقك ، واسكنته الكنف الفسيح من كريم شيمتك وطراءقك ، ولا ضياع علي ما تضمنته امانتك ، ويشتمل عليه حفظك ورعايتك . وارجو ان يقرن الله موردها بالطاءر السعيد ، والامر الرشيد ، والعز الزاءد والجد الصاعد ، والنماء في الاءتلاف ، والعصمة من الفرقة والخلاف ، حتي تكون عواءد البركة باحوالها منوطة ، ومن عوادي الايام وغيرها محوطة . ولما قرء هذا الفصل بحضرة ابي تغلب ، اعتمد للجواب عنه ابو الفرج الببغا فاجاب عنه بما نسخته : واما ابو النجم بدر الحرمي المستوجب للارتضاء والاحماد ، الموفي بمناصحته  علي كل مراد ، فقد ادي الامانة الي متحملها ، وسلم الذخيرة الجليلة الي متقبلها ، فحلت من محل العز في وطنها ، واوت من حمي السءدد الي مستقرها وسكنها ، متنقلة عن عطف الفضل والكمال ، الي كنف السعادة والاقبال ، وصادرة عن انبل ولادة ونسب ، الي اشرف اتصال وانبه سبب ، وفي اليسير من لوازم فروضها وواجبات حقوقها ، ما صان رعايتي عن الوصاة بها ، ونزه وفاءي عن الاستزادة لها . وكيف يوصي الناظر بنوره ؟ ام كيف يحض القلب علي حفظ سروره ؟ وان سببا قرن باحماد امير المءمنين ذكري ، ووصل بحبل السيد العم ركن الدولة حبلي ، ومنح عز الدولة مكنون ودي ، واختص الاخوة من ولد ابيه السعيد  رحمه الله وايدهم  بوثيق عهدي ، الي ان صرت بفضل الجماعة قاءلا ، ودونها بالنية والفعل مناضلا ، وبمحاسنها المجموعة لي ناطقا ، وبما لي عندها من المساهمة والمشاركة واثقا ، لحقيق بالتباهي في الاعظام ، وخليق بالمبالغة في الايجاب والاكرام . والله تعالي يعين علي ما اعتقده من ذلك وانويه ، ويوفقني لما يوفي علي المحبة والبغية فيه ، بمنه وقدرته ، وحوله وقوته . وانما الم الصابي في تسميته اياها بالوديعة بما كتبه جعفر بن ثوابة عن المعتضد الي ابن طولون في ذكر ابنته قطر الندي المنقولة اليه . وهو : واما الوديعة  اعزك الله  فهي بمنزلة ا انتقل من شمالك الي يمينك ، عناية بها ، وحياطة لها ، ورعاية لولاءك فيها . فلما عرضه علي الوزير ابي القاسم عبيد الله بن سليمان استحسنه جدا وقال له : تسميتك اياها الوديعة نصف البلاغة ، ووقع له بالزيادة في اقطاعه ومشاهرته . من كتاب لابي القاسم عبد العزيز بن يوسف الي اهل الشام . قد  علمتم بشهادة الاثار ، وتظاهر الاخبار ، ما اعد الله لامير المءمنين بطاعة وليه المنصور ، وصفيه المبرور ، عضد الدولة  ايده الله  من حام حقيقته ، ساد خلته ، راع سدته ورعيته ، لا يثنيه عن غاياته عارض السام ولا يلهيه عن هماته راحة الجمام : من الطويل مضاميره اعيت علي من يرومها . . . فكل مدي عن غايتيه قصير وهو عين امير المءمنين اذا نظر ، ولسانه اذا نطق ، ويده اذا لمس ، الانت ام امضت ، ووطات ام افضت . ومن كتاب في ذكر ابي تغلب : وقد كان الغضنفر بن حمدان حين نفضته المذاهب ، ولفظته المهارب ، واجهضته عن مكامنه المكايد الكتاءب ، وتطوح في بلاد الشام ، يتنقل بين مصارع يحسبها مرابع ، ومجاهل يعدها معالم ، يروم انتعاشا والجد خاذله ، ويبتغي انتياشا والبغي طالبه . وكتب الي الصاحب ابن عباد : وقف مولانا علي ما كتب مولاي معرضا بخدمته ، ومجليا عن نيته ، فصدقه وحققه ، وقال ادام الله سلطانه : ان لسان اثره في الفصاحة كلسان قلمه ، يتجاريان كفرسي رهان ، وناهيك بالاول اشتهارا ووضوحا ، وبالثاني غررا وحجولا . وكنا لمثل هذه الحال نعده ونعتده ، وننتجز عدات الفضل منه ، وحسبنا ا افادتنا التجارب فيه ، كافلا بالسعادة ودرك الارادة ، وما زالت مخايله وليدا وناشيا ، وشماءله صغيرا ويافعا ، نواطق بالحسني عنه ، ضوامن للنجح  منه ، فقد اصبح الظن ايقانا ، والضمار عيانا والتقدير بيانا ، والاستدراك برهانا . كتب ابو اسحق الصابي مقاطعة : هذا كتاب من عبد الله الفضل ، الامام المطيع لله امير المءمنين ، لفلان بن فلان . انك رفعت قصتك تذكر حال ضيعتك المعروفة بكذا وكذا ، من رستاق كذا وكذا ، من طسوج كذا وكذا ، وانها ارض رقيقة قد توالي عليها الخراب وانغلق اكثرها بالسد والدغل ، وان امير المءمنين امر بمقاطعتك عن هذه الضيعة علي كذا من الورق المرسل في كل سنة علي استقبال سنة كذا وكذا الخراجية ، مقاطعة مءبدة ، ماضية مقررة نافذة ، يستخرج مالها في اول المحرم من كل سنة ، ولا تتبع بنقض ولا بتاول متاول فيها ، ولا يعترض معترض في مستانف الايام ان اجتهدت في عمارتها ، وتكلفت الانفاق عليها ، واستخراج سدودها ، وقفل اراضيها ، واحتفار سواقيها ، واجتلاب الاكرة اليها ، واطلاق البذور والتقاوي فيها ، وارغاب المزاعين بتخفيف طسوقها بحق الرقبة ومقاسماتها ، وكان في لك توفير لحق بيت المال ، وصلاح ظاهر لا يختل . وسالت امير المءمنين الامر والتقدم بالاسجال لك به ، واثباته في ديوان السواد ودواوين الحضرة وديوان الناحية ، وتصييره ماضيا لك ولعقبك واعقابهم ، ولمن لعل هذه الضيعة او شيءا منها ينتقل اليه ببيع او ميراث او صدقة او غير ذلك من ضروب الانتقال : وان امير المءمنين بايثاره الصلاح ، واعتماده اسبابه ، ورغبته فيما عاد بالتوفير علي بيت المال والعمارة للبلاد والترفيه للرعية ، امر بالنظر فيما ذكرته ، واستقصاء البحث عنه ، ومعرفة وجه التدبير ، وسبيل الحظ فيه ، والعمل بما يوافق الرشد في جميعه . فرجع الي الديوان في تعرف ما  حكيته من احوال هذه الضيعة ، فانفذ منه رجل مختار ثقة مامون من اهل الخبرة بامور السواد واعمال الخراج ، قد عرف امير المءمنين امانته وديانته ، وعلمه ومعرفته ؛ وامر بالمصير الي هذه الناحية ، وجمع اهلها من الادلاء والاكرة والمزارعين وثقات التناء والمجاورين ، والوقوف علي هذه الاقرحة ، وايقاع المساحة عليها ، وكشف احوال عامرها وغامرها ، والمسير علي حدودها ، واخذ اقوالهم واراءهم في وجه صلاح وعمارة كل قراح منها ، وما يوجبه صواب التدبير فيما التمسته من المقاطعة بالمبلغ الذي بذلته ، وذكرت انه زاءد علي الارتفاع ، والكتاب بجميع ذلك الي الديوان ليوقف عليه ، ورسم ما يعمل عليه ، وينهي الي امير المءمنين فينظر فيه : فما صح عنده منه امضاه ، وما راي الاستظهار علي نظر الناظر فيه استظهر فيما يري منه ، حتي يقف علي حقيقته ، ويرسم علي ما يعمل عليه . فذكر ذلك الناظر انه وقف علي هذه الضيعة وعلي ساءر اقرحتها وحدودها ، وطافها بمشهد من اهل الخبرة باحوالها من ثقات الادلاء والمجاورين والاكرة والمزارعين والتناء الذين يرجع الي اقوالهم ويعمل عليها ؛ فوجد مساحة بطون الاقرحة المزروعة من جميعها ، دون سواقيها ومروزها وتلالها وجاريتها ومستنقعاتها ، وما لا يعتمل من اراضيها ، بالجريب الهاشمي الذي تمسح به الارض في هذه الاناحية كذا وكذا جريبا ، منها جميع القراح المعروف بكذا وكذا ، ومنها موضع الحصن والبيوت والساحات والراحات والبراحات والخرابات ، ووجد حالها في الخراب  والانسداد وتعذر العمارة والحاجة الي عظيم المءونة ومفرط النفقة علي ما حكيته وشكوته . ونظر في مقدار اصل هذه الجربان من هذه الضيعة ، وما يجب عليها ، وكشف الحال في ذلك . ونظر امير المءمنين في ما رفعه هذا المءتمن النفذ من الديوان ، واستظهر فيه بما راه من الاستظهار ، ووجب عنده من الاحتياط ، فوجد ما رفعه صحيحا صحة عرفها امير المءمنين وعلمها ، وقامت في نفسه وثبتت عنده ، وراي ايقاع المقاطعة التي التمسها علي حق بيت المال في هذه الضيعة ، فقاطعك عنه في كل سنة هلالية ، علي استقبال سنة كذا وكذا الخراجية ، علي كذا وكذا درهما براسم صحاحا مرسلة بغير كسر ولا كفاية ولا حق جزر ولا جهبذة ، ولا محاسبة ولا زيادة ، ولا شء من جميع المءن وساءر التوابع والرسوم ، تءدي في اول المحرم من كل سنة حسب ما تءدي المقاطعات ، مقاطعة ماضية مءبدة نافذة ثابتة علي مضي الايام وكرور الاعوام ، لا تنقض ولا تفسخ ولا تتبع ولا يتاول فيها ولا تغير ، علي ان يكون هذا المال ، وهو من الورق المرسل ، كذا وكذا في كل سنة مءدي الي بيت المال ، ومصححا عند من يورد عليه الينا في هذه الناحية اموال خراجهم ومقاطعاتهم وجباياتهم ، لا يعتل فيه ابافة تلحق الغلات ، سماوية ولا ارضية ، ولا بتعطيل ارض ، ولا نقصان ريع ، ولا بانحطاط سعر ، ولا بتاخر قطر ، ولا بشوب غلة ، ولا بحرق ولا سرق ، ولا بغير ذلك من الافات ، بوجه من الوجوه ولا سبب من الاسباب ؛ ولا يحتج في ذلك بحجة يحتج بها التناء والمزارعون وارباب الخراج في الالتواء بما عليهم ، وعلي ان لا تدخل عليك في  هذه المقاطعة يد ماسح ولا مخمن ولا حازر ، ولا مقدر ولا امين ولا خاطر ولا ناظر ، ولا متتبع ولا متعرف لحال زراعة وعمارة ، ولا كاشف لامر زرع وغلة ، ماضيا ذلك لك ولعقبك من بعدك واعقابهم ، وورثتك وورثتهم ، ابدا ما تناسلوا ، ولمن عسي ان تنتقل هذه الاقرحة او شء منها اليه بارث او بيع او هبة او نحل او صدقة او وقف او مناقلة او اجارة او مهاياة ، او تمليلك او اقرار او بغير ذلك من الاسباب التي تنتقل بها الاملاك من يد الي يد ، ولا ينقض ذلك ولا شء منه ولا يغير ولا يفسخ ، ولا يزال ولا يبدل ولا يتعقب ، ولا يعترض فيه معترض بسبب زيادة عمارة ، ولا ارتفاع سعر ، ولا وفور غلة ، ولا زكاء ريع ، ولا احياء موات ، ولا اعتمال معطل ، ولا عمارة خراب ، ولا استخراج غامر ، ولا اصلاح شرب ، ولا استحداث غلات ، يم جير الرسم باستحداثها وزراعتها ، ولا يعد ولا يمسح ما عسي ان يغرس في هذه الاقرحة من النخل واصناف الشجر المعدود والكروم ، ولا يتاول عليك بما لعل اصناف المساحة ان يزيد به فيما يعمره ويستخرجه من الجبابين والمتنقعات ، ومواضع المشارب المستغني عنها ، اذ كان امير المءمنين قد عرف ذلك ، وجعل كل ما يجب علي كل شء منه عند وجوبه داخلا في هذه المقاطعة وجاريا معها . وعلي انك ان فضلت شيءا من مال هذه المقاطعة علي بعض الاقرحة من جميع الضيعة ، وافردت باقي مال المقاطعة بباقيها عند ملك بنتقل منها عن يدك ، او فعل ذلك غيرك ، ممن جعل له في هذه المقاطعة ما جعل لك ، من ورثتك وورثيهم ، وعقبك واعقابهم ، ومن لعل هذه الضيعة او شيءا من هذه الاقرحة ينتقل اليه بضرب من ضروب الانتقال قبل ذلك التفضيل منكم عند الرضا ، والاعتراف ممن تفضلون باسمه ، وتحيلون عليه ، وعوملتم علي ذلك ، ويم يتاول عليكم في شء منه . وعلي انك ان  التسمت او التمس من يقوم مقامك ضرب منار علي هذه الضيعة تعرف به رسومها وطسوقها وحدودها ، ضرب ذلك المنار اي وقت التمستموه ، ولم تمنعوا منه ، وان تاخر ضرب المنار لم يتاول عليكم به ، ولم يجعل علة في هذه المقاطعة ، اذ كانت شهرة هذه الضيعة واقرحتها في اماكنها ، ومعرفة مجاوريها بما ذكر من تسميتها ومساحتها ، يغني عن تحديدها او تحديد شء منها ، ويقوم مقام المنار في ايضاح معالمها ، والدلالة علي حدودها وحقوقها ورسومها . وقد سوغك يا فلان بن فلان امير المءمنين وعقبك من بعدك واعقابهم ووثتك وورثتهم ابدا ما تناسلوا ، ومن تنتقل هذه الاقرحة او شء منها اليه ، جميع الفضل بين ما كان يلزم هذه الضيعة او اقرحتها من حق بيت المال وتوابعه ، علي الوضعية التامة وعلي الشروط القديمة وبين ما يلزمها علي هذه المقاطعة ، وجعل ذلك خارجا عن حاصل طسوج كذا وكذا ، وعما يرفعه المءتمنون ، ويوافق عليه المتضمنون ، علي غابر الدهور ومر السنين وتعاقب الايام والشهور ، فلا يقبل في ذلك سعاية ساع ، ولا قدح قادح ، ولا قرف قارف ، ولا اغراء مغر ، ولا قول معتب ، ولا يرجع عليك فيما سوغته ونظر اليك به بحال من الاحوال ، ولا برجوع في التقديرات ، ولا بنقض للمعاملات وردها الي قديم اصولها ، ولا ضرب من ضروب الحجج والتاويلات ، والتي يتكلم عليها اهل العدل علي سبيل الحكم والنظر ، واهل الجور وعلي سبيل العدوان والظلم . ولم تكلف يا فلان بن فلان ، ولا عقبك من بعدك ولا ورثتك واعقابهم ، ولا احد ممن تخرج هذه الضيعة او هذه الاقرحة او شء منها اليه علي الوجوه والاسباب كلها ، اخراج توقيع ولا كتاب مجرد ، ولا منشور بانفاذ شء من ذلك ، ولا احضار سجل به ، ولا اقامة حجة فيه في وقت من الاوقات . وعلي الا يلزمك ولا احدا ممن يقوم في هذه المقاطعة مقامك مءونة ولا كلفة ولا ضريبة ولا زيادة ولا بقسط كري ولا مصلحة ولا عمل بزند ، ولا نفقة ولا مءونة حماية ولا خفارة ، ولا غير ذلك . ولا يلزم بوجه من الوجوه في هذه المقاطعة  زيادة علي المبلغ المذكور المحدود المءدي في بيت المال في كل سنة خراجية ، وهو من الورق المرسل كذا وكذا ، ولا يمنع من روز جهبذ او حجة كاتب او عامل بمال هذه المقاطعة اذا اديته واديت شيءا منه اولا ، حتي يتكامل الاداء وتحصل في يدك البراءة كل سنة بالوفاء لجميع المال لهذه المقاطعة ، وعلي ان تعاونوا علي احوال العمارة وصلاح الشرب ، وتوفر عليكم الصيانة والحماية والذب والرعاية . ولا يتعقب ما امر به امير المءمنين احد من والة العهود والامور والوزراء واصحاب الدواوين ، والكتاب والعمال والموفين والضمناء والمءتمنين ، واصحاب الخراج والمعاون وجميع طبقات المعاملين وساءر ضروب المتصرفين ، لشء يبطله او يزيله عن جهته ، او ينقضه او يفسخه او يغيره او يبدله ، او يوجب عليك او علي عقبك من بعدك واعقابهم وورثتهم ابدا ما تناسلوا ، ومن تخرج هذه الضيعة او شء منها اليه ، حجة علي ساءر طرق التاويلات ، ولا يلزمكم شيءا ولا يكلفكم عوضا من امضاءه ؛ ولا ينظر في ذلك احد منهم نظر تتبع ولا كشف ولا فحص ولا بحث . وان خالف احد منهم ما امر به امير المءمنين او تعرض لكشف هذه المقاطعة او مساحتها او تخمينها ، او اعتبارها او الزيادة في مبلغ مالها ، او ثبت في الدواوين في وقت من الاوقات شء يخالف ما رسمه امير المءمنين فيها ، اما علي طريق السهو والغلط او العدوان والظلم والعناد والقصد ، فذلك كله مردود باطل منفسخ ، وغير جاءز ولا ساءغ ، ولا قادح في صحة هذه المقاطعة وثبوتها ووجوبها ، ولا معطلا لها ، ولا مانعا من تلافي السهو واستدراك الغلط في ذلك ، ولا مغيرا لشء من شراءط هذه المقاطعة ، ولا حجة تقوم عليك يا فلان بن فلان ، ولا علي كل من يقوم مقامك في هذه المقاطعة بشء من ذلك ، اذ كان يامر به امير المءمنين في ذلك علي وجه من وجوه الصلاح وسبيل من سبله ، راهما وامضاهما ، وقطع بهما كل اعتراض ودعوي ،  واحتجاج وقرف ، وازال معهما كل بحث صفح ، وتبعة وعلاقة . وان كان من الشراءط فيما سلف من السنين ، وخلا من الازمان ، ما هو اوكد واتم واحكم ، واحوط لك ، ولعقبك وورثتك واعقابهم وورثتهم ، ومن تنتقل هذه الاقرحة او شء منها اليهم ، مما شرط في هذا الكتاب ، لحال اوجبها الاحتياط علي اختلاف مذاهب الفقهاء والكتاب ، وغيرهم مما للخلفاء ان يفعلوه وتنفذ فيه امورهم ، حملت وحملوا عليه ، وهو لكم ومضاف الي شروط هذا الكتاب التي قد اتي عليها الذكر ، ودخلت تحت الحصر ، ولم يكلف احد منكم اخراج امر به . وان التمست او احد من ورثتك واعقابك ، ومن عسي ان تنتقل هذه الضيعة او هذه الاقرحة او شء منها اليه في وقت من الاوقات ، تجديدا بذلك ، او مكاتبة عامل او مشرف ، او اخراج توقيع او منشور الي الديوان بمثل ما تضمنه هذا الكتاب ، اجبتم اليه ولم تمنعوا منه . وامر امير المءمنين باثبات هذا الكتاب في الدواوين ، واقراره في يدك ، حجة لك ولعقبك من بعدك واعقابهم وورثتك وورثتهم ، وثيقة في ايديكم ، وفي يد من عسي ان تنتقل هذه الضيعة اليه ، او الاقرحة او شء منها ، بضرب من ضروب الانتقال التي ذكرت في هذا الكتاب والتي لم تذكر فيه ، وان لا تكلفوا ايراد امر بعده ، ولا يتاول عليكم متاول فيه . فمن وقف علي هذا الكتاب وقراه او قرء عليه من جميع الامراء وولاة العهود والوزراء والكتاب والعمال والمشرفين والمتصرفين والناظرين في امور الخراج ، واصحاب السيوف علي اختلاف طبقاتهم وتباين منازلهم واعمالهم ، فليمتثل ما امر به امير المءمنين فيه ولينفذ لفلان بن فلن ولورثته ولورثتهم وعقبه  واعقابهم ، ولمن تنتقل هذه الاقرحة او شء منها اليه ، بهذه المقاطعة ، من غير مراجعة فيها ولا استءمار علياه ، ولا تكليف احد ممن يقوم بامرها ايراد حجة بعد هذا لكتاب ، وليعمل بمثل ذلك من وقف علي نسخة من هذا الكتاب في ديوان من دواوين الحضرة واعمالها والناحية ، وليقر في يد فلان بن فلان ويد من يورده ويحتج به ممن يقوم مقامه ، ان شاء الله تعالي . وكتب الوزير في تاريخ كذا . فصل من كتاب لاحمد بن اسماعيل الكاتب ، المعروف بنطاحة : البليغ من عرف السقيم من المعتل ، والمقيد من المطلق ، والمشترك من المنفرد ، والمنصوص من المتاول ، والايماء من الايحاء ، والفصل من الوصل ، ولااصل من الفصل ، والتلويح من التصريح . ومن شروط البليغ ان يكون حاد الفطنة ، وصحيح القريحة ، صافي الذهن ، وان يعرف في وجهه التحفظ وسجية المتحرز ، والخجل والوجل ، ويتبين في لحظه الرضي والغضب ، والسرور والحزن ، والامن والخوف ، والامر والنهي ، والذكاء والغباء ، والفكر والسهو . وجدت كتابا منسوبا الي ابن العميد كتبه الي الصاحب ابي القاسم ابن عباد  وفيه ما يشكك في قبوله  وفيه اذكار بسياسة مستفادة : مولاي وان كان سيدا بهرتنا نفاسته ، وابن سيد تقدمت علينا رياسته ، وفاننا نعتده سندا ووالدا ، واعده ولدا واحدا ، ومن حق ذلك ان يعضد رايي رايه ليزداد استحكاما ، ويستمر عقدا وابراما ، وحضرة مجلس ركن الدولة تفاوضني ما جري بينه وبين مولاي طويلا ، ووصل به كلاما بسيطا ، واطلعني علي ان مولاي لم يزد بعد الاستقصاء والاستيفاء علي التقضي والاستعفاء والزم عبده انا ان اكره مولاي اكراه المسالة واجبره اجبار الطلبة ، علما بانه ان دافع المجلس المعمور طلبا للتحرز ، لم يزد وساطتي اخذا بالتطول . واقول بعد ان اقدم مقدمة : مولاي غني عن هذا بتصونه وتقلله وعزوفه بهمته عن تكاثر المال وتحصيله ، ولكن العمل فقير الي كفايته ، محتاج الي كفالته . وما اقول ومرادي ما يعقد من  حساب ، وينشا من كتاب ، ويستظهر به من جمع ، وعطاء ومنع . فكل ذلك وان كان مقصودا ، وفي ايات الوزارة معدودا ، ففي كتاب مولاي من يفي به ويستوفيه ، ويوفي عليه بايسر مساعيه ، ولكن ولي النعمة يريده لتهذيب من هو ولي عهده ، والمامول ليومه وغده ، ايد الله ايامه وبلغه فيه مرامه . فلا بد وان كان الجوهر كريما ، والمجد صميما ، والسنخ عظيما ، ومركب العقل سليما ، من مناب من يعلم ما السياسة والرءاسة ، وكيف ترتب ويعالج الخطب اذا ضاقت المذاهب ، وتعصي الشهوة لتحرس الحشمة ، وتهجر اللذة لتحصيل الامرة . ولا بد من محتشم يقوم في وجه صاحبه فيرده اذا بدر منه الراي المتقلب ، ويراجعه اذا جمح به اللجاج المرتكب ، ويعاوده اذا ملكه الغضب المنتشر . فلم يكن السبب في ان فسدت جهة وبلدان عدة ، الا ان خفضت اقدار الوزارة فانقبضت اطراف الامارة . ولن تفسد  علي ما اري  بقية الارض الا اذا استعين بالاذناب علي هذا الامر . فلا يبخلن مولاي علي ولي نعمته بفضل معرفته ، فمن هذه الدولة جري ماء فضله وفضل شيخه من قبله . فان كان مسموعا كلامي ، وموثوقا به اهتمامي ، فلا يقعن انقباض عني ، ولا اعراض عما سبق مني . ومولاي محكم بعد الاجابة الي العمل فيما يشترط ، غير مراجع فيما يقترحه . وهذا خطي به ، وهو علي ولي النعمة حجة ، لا يبقي معها شبهة ، وتتاصل المكاتبة بالمشافهة اما بحضوري لديه ، او تجشمه الي هذا العليل الذي قد الح النقرس عليه ، والسلام . نسخة كتاب ورد من الصاحب اسماعيل بن عباد الي ابي عبد الله الحسين بن احمد بن سعدان : كتابي ، اطال الله بقاء الاستاذ مولاي ورءيسي ، ادام الله تاييده ونعماءه ،  يوم كذا ، ومولانا الامير السيد فخر الدولة شاهنشاه ، اطال الله بقاه ، وكبت اعداه ، فيما يرفع الله من قواعد ملكه ، ويعضد يمن سواعد عزه ، ويعم من استظهاره ، ويفسح من افنية استيلاءه واقتداره ، علي ما تقر به عيون اولياء الدولة ، وانصار البيضة ، وحماة الحوزة ، وثقات الدعوة . وانا سالم والحمد لله رب العالمين ، وصلي الله علي سيدنا محمد واله اجمعين ، وعندي للاستاذ مولاي كتب انا رهين برها ، وعبد شكرها ، وما عن تقصير في حقها ذهبت عن الاجابة ، ولا لا قصار عن فرضها قبضت يدي عن الكتابة . وكيف وقد علم من له الخلق والامر ، وسواء عنده السر والجهر ، اني لم استفد منذ دهر ، لا اضبط اطرافه امتدادا ، ولا احصي ايامه تعدادا ، موهبة في نفسي اكرم منبتا من وده ، وفي صدري اوكد موثقا من عهده ، ولكن حوادث اعترضت واجحفت ، وكوارث الحت فالحبت ، واتت الليالي بما لم يحسب طروقه ، وهجمت الخطوب بما لم يرتقب حدوثه ، ومضي امير الامراء وسعيد السعداء ، رضوان الله عليه ، فعاد النهار اسود ، والعيش انكد ، والملك اغبر بل اربد ، واصبحت خصوما والحياة خصم يمال عليه ، والموت سلم نحن اليه . وقد كان قدس الله مثواه وكرم ماواه ، وعند بلوغ الامر الي حيث لا مطمع في العمر ، اشار الي مولانا الامير السيد فخر الدولة اشارة الناص ، وعين علي ذكره بالاسم الخاص ، عالما بانه سداد الامر ، وسداد الثغر ، والكافل معه بالشمل حتي يجتمع ، وبالحبل حتي يتصل ، بالشعث حتي يلم ، وبالنشر حتي يضم . فحقق الله مخيلته في حياته ، وحفظ حقيقته بعد وفاته . وقبل ذلك ما كان  سوغه الله تعالي رضوانه  كلفني الاستمالة به  ادام الله سلطانه  لتمار تلك الاحقاد عن الصدور ، وتقار عواطف النفوس والقلوب ، ويتساهم احسان الله الموفور ، لا سيما وقد تخون الدهر الملك السعيد طود الاطواد ، وعضد الاعضاد ، فوجب  ان يزاد في التناصر ، ويحصن الملك بالتظاهر . وبذلت جهد الناصح ، وهديت بالادب الصالح ، الي الطريق الواضح ، فثني الامير السيد فخر الدولة عنانه عن نيسابور لاعادة الالفة ، وجد علي سمت جرجان ماحيا للنبوة ، الا ان القضاء سبق فلم يلحق ، وفرط فلم يدرك ، وقبض امير الامراء  قدس الله روحه  الي قبضة الرحمة ، والصلوات الجمة ، بعد ان ذلل الخصوم ، وادال القروم ، واسترق الاعداء ، وساس الدهماء ، واستقل بالاعباء ، وخلف اطيب الابناء . فخدمت الدولة بالضبط بقدر ما استطعت ، وتكلفت بقدر ما كفلت له واتسعت ، الي ان عاد مولانا فخر الدولة الي منصبه الممهود ، وسريره الموروث ، ورواق عزه الممدود ، ومستقر ملكه المنصور ، فتجلت الغمم ، ونهضت الهمم ، وقويت المنن ، وانزاحت الظلم ، واصفقت الكافة ، ونزلت الرحمة والرافة ، وشفي الله صدور قوم مءمنين ، وقيل الحمد لله رب العالمين . وراي اهل البصاءر ان قد اعاد الله الدولة اجد ما شوهدت ، واشب ما عوهدت ، نافضة غبارها ، رافعة منارها ، خافقة بلواءها ، مستعلية علي اعداءها ، مرسية بدعامتها عند من يوفيها نذورها ، ومفوضة زعامتها الي من يحميها محذورها . فكان من اول ما فاتحته  حرس الله ملكه  فقرات منه صحيفة السعادة ، واخذت منه بوثيق الارادة ، ما اعلمنيه من عكوف همته علي عمارة ما اثله الامراء السعداء بينهم قبل انخراطها في سلك التفاق ، وانحطاطها في شعب الاءتلاف ، ودعا الامراء السادة من اهله  بحق الكبر وفضل التجريب لاطوار الدهر  الي التناصر والتناصف ، والاعراض عن التباعد والتخالف ، ورفض المنافسة التي تهيج كوامن النفوس ، وتثير سواكن القلوب ، فقد اتي الله تعالي في التماسك فسحة ، ولم يوجد في المشاحنة المباينة رخصة . هذا ولو كانت علي اشد تضايق واتم تقارب ، لوجب ان يتساهم عليها ، فان يسير الحظ مع التعاون والتازر خير من كثيره مع التقاطع والتدابر . فان كان منهم من تاخذه العزة بالاثم ، ويبغي تجاوز سابق الوصية والحكم ، كانت الجماعة يدا عليه ، الي ان يفء للحسني ، ويعود طوعا  او كرها للطريقة المثلي . فاما الذي عنده  اعلي الله جده  لمولانا الامير صمصام الدولة وشمس الملة ، فالانصباب بالمودة التي لا مطلع من بعدها ، ولا منزع من وراء حدها ، وبالاشافاق المتناهي الي حيث لا اقتراح وراءه للمريد ، ولا استزادة لملتمس المزيد ، والله يمنع بعضا ببعض ، ويمد هذه الظلال علي بسيط الارض ، حتي لا يعرف لها من سواهم ملك يطاع ، ولا مالك يقع عليه الاجماع ، ان الله سميع مجيب . لا يعرف لها من سواهم ملك يطاع ، ولا مالك يقع عليه الاجماع ، ان الله سميع مجيب . وارجع الي ما افتتحت له المخاطبة . كان كتاب الاستاذ الاول قد ملا اليدين فضلا ، وحمل الكاهل ثقلا ، وايقنت ان اولي المودات بالثقة الوكيدة ، واحراها بالاستقامة الشديدة ، مودته التي طلعت من افق فضل ، وشيدها كرم اصل ، فاتت تبرعا من غير استجلاب ، وتطوعا من دون استكراه ، ورجوت ان اكون نعم الناهض بحق المقاطعة ، وان حاز بالمبرة الرتبة السابقة ، ووجدته قد بذل من نفسه في المشاركة ، ما لو كلفته اياه لكنت متحكما ، او ماءلا علي جانبه متسحبا ، فغدوت اري الحال بيننا اولي ما اصرف الهمم الي حفظه من جوانبه ، واوكل الفكر بحراسته ، عن الدهر ونواءبه . وليس ذلك الا نتيجة ما قدمه ، وثمرة ما تجشمه ، والا فقد علم الاستاذ ان كثيرا ممن سد خصاص المجلس الذي سده ، وان لم يسد في الكفاية والبراعة مسده ، كاثرني فحققت ، وباسطني فتقبضت ، لا تقصيرا بالواحد ، ولكن علما بالمصادر والموارد . فلما وجدت من جمع مزية الاستقلال الي كرم الخلال ، وشرف النجار الي من كان اهلا للاكبار ، ومن هنءت به الامور قبل ان يهنا ، واولاه الله ادب الصدور قبل ان يولي ، ارسلت نفسي علي سجيتها ، واعدتها لفطرة اوليتها ، وظننت الله قد انشر الفضلاء الاعيان الذين كنت اتجمل بودادهم ، واتكثر باعتقادهم ، وانست قلة الصديق من بعدهم . والان حين اعتب الزمان فغفرت له اكثر جراءره ، وسحبت ذيل التجاوز علي معظم جراءمه ، ورد بعده كتابان جعلا التفضل نمه عادة ، والبر ابداء واعادة . ولو قد وفيت بما سبق ، لوفيت الحق في  ما لحق ، الا اني الي الان معذور او معتذر ، ومقصر او مقتصر . ولءن كانت محامد الاستاذ مولاي تسابق يقين العارف ، وتستغني عن لسان الواصف ، اني قد خطبت في مجلس مولانا الامير السيد فخر الدولة فيها بخطب ان لم تفتتح بالتحميد فقد شحنت بالتعظيم ، وان لم تكن قرءت علي درج المنابر ، فقد تليت في اشرف المحاضر ، وحققت عنده ان الاستاذ مولاي يري الخدمتين خدمة واحدة ، ويعد الغاءبة شاهدة ، واعتد لذلك اشد اعتداد ، فاسلف عنه اتم احماد . وقد نفذ اليه عن حضرته العالية ما ليس بغاية يوقف عندها ، حتي تردف مع استقرار المخاطبات بما يجب بعدها ، بمشيءة الله . وا قد جمعنا الله علي ما جمع فالانقباض هجنة ، والاحتشام وصمة . وكنت  ادام الله تاييد الاستاذ  وقد يسر الله من سد الثلمة ما استدعت النفوس ان ينسد ، وسهل من ارتداد الظلمة ما استبعدت العقول ان يرتد ، امل ظفرا بما لم ازل انازع اليه ، واقارع الامال عليه ، من اعتزال الاشغال التي كان يحسن الانقطاع اليها ، وفي الايام بقية ، والعمر في اقباله ، والنشاط في استقباله ، والشباب بحاله ، والاشد علي استقلاله ؛ الا ان مولانا الامير خاطبني في هذه الباب بمخاطبات لم استطع معها ان ابلغ ما اردت ، ن وايمم الي حيث قصدت ، وانتهي في التعظيم الي ما لا يقسم للمشارك القسيم ، فلم اطق شكر نعمته الا بان اتطوق فرض خدمته ، واوردت هذا الفصل اعتذارا الي الوفاء واهله ، من النظر بعد ما تءرخ السير بمثله ، وان كان الله قد ادال من القنوط اللازم بالاحسان الفاءض ، واتنضي للملك اكمل ساءس واشرف راءض . وقد خاطبت ابا العلاء في كل باب بما يءدي فيه حق المناب ، وعلي ذكره فاني ارعي له حقوقه التي لدي ووساءله الي ان ادي الي عن الاستاذ مولاي ما كتب بالاخلاص علي سواد القلب ، وجعل المودة شريعة لا تعقب بالنسخ ؛ فان راي مولاي الاستاذ ان يخاطبني بما يخاطب الموثوق به ، المسكون اليه ، المعتمد منه ما لاستظهار عليه ، ويقرر عند مولانا الامير صمصام الدولة وشمس الملة ، اني وان غبت فخادم متصرف باخلاص حاضر ، وعبد قد ورثه  كابرا عن كابر ، ويصرفني بين امره ونهيه ، فعل ، ان شاء الله تعالي . نسخة الجواب من انشاء ابي اسحاق الصابي : كتابي ، اطال الله بقاء سيدنا الصاحب ، وادام عزه وتاييده وعلوه ، ونعم الله عند مولانا الملك السيد صمصام الدولة وشمس الملة  اطال الله بقاه ، وادام نصره وعلاه  سابغة راهنة ، واحوال مملكته  رعاها الله  مستقيمة منتظمة ، والله جل اسمه متكفل له بحفظ الحوزة وحياطتها ، واظهار الراية ونصرتها ، والتمكين في لاارض بافضل ما مكن به للملوك المءيدين ، وولاة الامر المنتخبين المختارين ، تصاعدا وسموا وتزايدا ونموا ، وتوقلا في هضبات الفخر والمجد ، وترقيا في درجات الحظ والجد ، وهو  ادام الله ايامه  مقابل لذلك بالشكر لوليه ، والاستمداد للطيف صنعه فيه ، ومد الظل الظليل علي كل عام وخاص ، وافاضة الفعل الجميل في كل دان وقاص ، فالاولياء علي طاعته مجمعون ، وفيها مخلصون ، والرعايا في كنف سياسته وايالته ساكنون وادعون . واما ما خصني الله به من تفويضه الي وتعويله علي ، وانفاذه امري في البسط عنه والقبض ، والاعلاء والخفض ، فلساني يقصر عن ذكره موجزا مجملا ، فكيف به مشروحا مفصلا . والحمد لله علي ذلك حمدا ينتهي باتصاله وترادفه ، وتوافيه وتضاعفه ، الي مجازاة هذه المنن كلها ، وان كانت استطاعتنا متخلفة عنها وواقفة دونها ، وناقصة عن الوفاء بحقها ، حتي يتممه عفوه وفضله ، واحسانه وطوله . وفضل كتاب سيدنا الصاحب ، منصورا بنظير ما صدر كتابي هذا ، من مناءح الله الجليلة ، لما في نفسه ولي فيه ولنا جميعا ، في سلامة مولانا الامير الاجل فخر الدولة ، اطال الله بقاءه ، وادام تمكينه ونعماءه ، وانتظام احواله واطراد شءونه ونفاذ امره ، في ما احسن الله توفيقه له ، وارشاده اليه من توفيته حقه ، وانزاله  منزلته ، وايفاءه به الي اعلي مراقي الكمال والفضل ، ومفيضا علي من صنوف البر والاكرام ، وضروب المننن الجسام ، ما يستبعد الاحرار باقله ، وتسترق الاعناق بايسره ، ومفوضا الي من جلاءل الامور ومعاظم الشءون ، ما يجب ان تكون المفاوضات بيننا فيه مترددة ، وسبل المواصلة به وبامثاله معمورة ، وفهمته . فاما تذمم سيدنا الصاحب من تاخر الاجوبة عن كتبي المتواترة اليه ، واعتذاره من ذلك بما اعتذر به ، فقد قام عندي احضاره اياها ، وحفظه عددها ، وتوكل فكره ومراعاته بها ، وجمعه الجواب عنها في الكتاب الذي هذا جوابه ، مقام المكاتبة الجارية علي المواظبة ، المستمرة علي المداومة ، لا سيما مع تناولني به من لفظه الجميل ، وبره الهني ، ومطاولته البالغة ، ومناقشته الشافية ، وعلي حسب ظماي  كان  الي ذلك والتياحي ، وسروري الان به وارتياحي . وهذه حال تخفف عنه كلفة الاعتذار ، وتوجب له مزيدا في الاعتداد ، لا اعدمني الله تحمل عوارفه ، وتطول مننه ، مع الانهاض بها ، والمعونة علي شكرها . واما ما ذكره سيدنا الصاحب من الاثقال الفادحة التي حملها ، والامور المنتشرة التي نظمها ، بين الرزية في امير الامراء مءيد الدولة ، رضي الله عنه ، التي نكات القلوب واقرحت الاكباد ، وبين العطية في مولانا الامير الاجل فخر الدولة التي اقرت العيون ، واثلجت الصدور ، فلقد كنت لجميع ذلك متصورا وبه محيطا ، ولو لم اعلمه بالمراعاة ، واضرب فيه بسهم الموالة ، لعلمته بالقياس والاستدلال ، لاني كافحت الثانية للاولي ، ولاقيت الداهية الجلي في الملك الاعظم ، والسيد المقدم عضد الدولة وتاج الملة ، لقاه الله روحه وريحانه ، وبواه جنته ورضوانه ، وقاسيت شداءد متعبة فيما خدمته به ايام عليته المتطاولة ، وفيما نفذته بعده من وصاياه المءكدة . ولما انتقل الي جوار ربه وانقلب الي كرامته  وعفوه ، ثنيت وجهي الي احتذاء مراسمه ، وامتثال اوامره ، فيما عقده من العهد للملك القاءم بعده ، الساد ثلمة مكانه ، الوارث شرف منزلته ، المستقر في علياء رتبته ، مولانا صمصام الدولة وشمس الملة ، مستمليا فيما اخذت وتركت ، واوردت واصدرت ، من سديد يراءه ، ومستضيءا بوميض لالاءه ، وضاربا وجوه النواءب بيمن طاءره ، وسعادة طالعه ، الي ان تجلت غماءها ، واسمح اباءها ، وتذللت صعابها ، وتفللت انيابها ، وضربت الدولة بجرانها ، واستعلت باركانها ، واطمانت علي مهادها ، وطرف الله عين شناءها وحسادها ؛ هذا علي شواءب كانت تعترض ثم تقلع ، وتطل ثم لا تقشع ، لا تخلو الدول المتجددة من اعتنان امثالها واشكالها ، واحسن بها مع حسن عقباها ومالها . فلو وصفت لسيدنا ما مر بي في هذه الاحوال من اصلاح الفاسد ، وتقويم الماءد ، وقبض المنبسط ، وارضاء المتسخط ، وتالف المخالف ، واستقادة المتجانف ، ومقابلة كل داء بدواءه ، وتعديل كل امر خيف من اضطرابه والتواءه ، لطال الخطب واتصل القول . وانا احمد الله علي ان جمع بيننا فيا تولانا به من المعونة التي قضينا بها حق موالينا الامراء السادة ، صلوات الله علي من مضي منهم وسلف ، واطال الله بقاء من قام بعدهم وخلف ، واياه اسال ادامتهم والزيادة فيها ، ليشار الينا في المستقلين بحمل اياديهم ، كما يشار اليهم في الانعام علي مواليهم ، بمنه وطوله . واما ما اورده سيدنا الصاحب في الحض علي التالف والتعطف ، والنهي عن التقاطع والتدابر ، فمثله  ولا مثل له  قال ذلك وارشد اليه ، واشار به وحث عليه . وحقيق علينا فيما نلتزمه من شكر النعم التي خصتنا خصاءصها ، وتظاهرت علينا ملابسها ، ان نكرر علي اسماع موالينا ما يعود عليهم وعلينا في ظلهم ، باجتماع الشمل ، واتصال الحبل ، والتعاضد الكابت لاعداءهم ، الزاءد في علياءهم ، وبالله ما اجد عند مولانا صمصام الدولة مستزادا في ذلك ، ولا موضعا لبعث باعث عليه ، اذ كان يرجع الي اكرم طبيعة ، واشرف غريزة ، وافخر نجار ، واثقب راي واصح اختيار ، ويري  لمولانا وعمه وسيدنا الامير الاجل فخر الدولة ما ينبغي ان يراه من الحق العظيم ، والفضل الكبير ، ويثق بما له عنده من مثل ذلك ، ويعتقد في سيدنا الصاحب ا يعتقد في اول الوزراء ، واجل الكبراء ، والاوحد في الدولة ، والمتفرد بكل فضيلة ، والمعول علي رايه ، والمرجوع الي تدبيره في ما خص وعم ، وجل ودق ، وما اخل براب هذه الحال وعمارتها وحراستها ، ونفي الاقذاء والشواءب عنها ، وبلوغ كل غاية في تقريرها وتمهيدها ، وتثبيتها وتوطيدها ، غير موجب لنفسي فيها من الحمد الا ما يجب للعارف بالحق والمءدي للفرض . واما تمهيد سيدنا الصاحب عذر مولانا الاجل فخر الدولة ، واصداره ما صدر الي عن حضرته ، ووعده بما وعد به من مستانف زيادته ، فقد شكرت ذلك ، وتحملت المنة فيه ، ووثقت من سيدنا الصاحب بان كرمه وكيل لي عليه ، وناءب عني عنده ، في توفيتي من جهتها جميعا ، ما استحق بالموالاة الممحوضة غير المشوبة ، والطاعة المصدوقة غير المكذوبة ، وبما وسمني به مولانا الملك السيد صمصام الدولة وشمس الملة من نعماه واثرته ، وفوضه الي من وزارته ومظاهرته ، مءهلا لي في ذلك التفرد والاستبداد ، وذاهبا بي عما كان امر الوزارة جاريا عليه من الشركاء والانداد . ولست اخاف وقد عرفت لسيدنا الصاحب حق السابق المجلي ان يمنعني حق التالي المصلي ، في ما تراه العيون ظاهرا ، او تتناقله الاخبار ساءرا ، ومن وراءه باطن مني في التعبد له ، والانحطاط عنه ، اشهد الله علي سماحة نفسي به ، وانشراح صدري له ، وصل الله ما تقرر في قلبي من اعظامه ، وتحصل في يدي من عهده وذمامه ، باحسن ما اتصلت به ذات بين ، والتام عليه شمل فريقين ، لطوله ومنه ، ومشيءته واذنه . وقد سمعت من ابي العلاء ما اداه ، واجبت عنه بما اقتضاه ، واعتددت له  شكر ما اشكره ، وان كنت لا ارضي حدا اقف عنده في مراعاة مثله ممن انتسب الي جملته الجليلة ، وفءته الشريفة ، وكان مرسوما منها بالسفارة ، موسوما بتحمل الرسالة ، وقبل ذلك وبعده ، فاني ارغب الي سيدنا الصاحب في امدادي بامره ونهيه ، وتصريفي في عوارض خدمته ، واختصاصي بمفاوضته ومباسطته ، واعتمادي بحاجاته واوطاره ، واطلاعي علي ساءر احواله واخباره ، ومتجدد نعم الله عنده ، ومواهبه له ، فان راي ان يتوخاني بالمنة في ذلك ، محققا سالف ظني به ، ومنجزا انف وعده ، فعل ، ان شاء الله تعالي . كتب كاتب الي خارجي : استزلك الشيطان بمكره وخديعته فاطعته ، ودعاك بعداواته الي ما فيه فساد دنياك فاجبته ، وخرجت الي المعصية وقد عرفت وعورة مركبها ، وصعوبة مسلكها ، وخشونة مصحبها ، وسوء مصرعها ، ثم فعلت ذلك حين استبصر المستبصرون ، واناب المنيبون ، ونزع العارفون ، لما اظهر الله من فضل امامهم ونشر من عدله ، وغمر به من احسانه وفضله . كتب بعض الكتاب القدماء : ليس لمن قد عرف مثل الذي عرفت من فضلك عذر في اضاعة حظه منك ، ولا حجة في الامساك عن اذكارك بالحقوق التي تربها برعايتك . واذا تاملت امري وتصفحت احوال اهل دهري ، علمت ان لكل رجل بضاعة ينفق بها ، ووسيلة بها يتوسل ، سوقا يجلب اليها تلك البضاعة ، واملا يقصده بتلك الوسيلة . وانك اولي الناس واحقهم بالامساك علي ، لان سوقي ليست بنافقة عند  احد نفاقها عندك ، وبضاعتي ليست زاكية عند احد كزكاءها في حيزك . وانا وان كانت الايام دخلت بين وبينك ، وبين حظي منك ، وعارضتني في املي فيك ، فليس الي ان اقطع اسباب رجاءي منك ، وانصرف عن الامور الداعية اليك سبيل . وليس امساك السماء عن طالب الغيث في حال من الاحوال ، بمانع من رجاءها في مستقبل الايام ، ولا داع الي الياس منها في غابر الدهر . وما منعني من الكتاب اليك منذ حدثت هذه الحوادث الا الانتظار ان تسكن الناءرة ، فان لكل شء حمة ، ولكل مكروه مدة ، ولكل حادث تناهيا ، فالزوال اولي به ، ولا خير في مساورة النواءب وهي مقبلة ، ولا في معارضة الدهر في وقت حدته وشدته ، وربما تطاطا المرء للمحنة فتخطته ، وعدل عن سنن الشر فنجا منه ، وفارق مدرجته ، فامن معرته . وان هذه المحنة لمحنة المت بي ، وما اعرف للزمان فيها عذرا ، ولا لما جني علي منها سببا ، لانه ان كان ذلك لحال كانت بيني وبين من كنت اواصل ، فوالله ما ظننت المودات بين الناس ذنبا عند السلطان فاجتنبه ، ولا جرما محتسبا فاتنكبه . فصل من هذه المكاتبة : فانت العدة علي الزمان ، والعون علي الدهر المستنجد علي الايام . وقد قصدتك بكتابي هذا لتجدد ما لعل الغيبة اخلقته من الحال ، فانها ربما احدثت في القلوب النسيان ، وقد قيل في ذلك : من الوافر اذا ما شءت ان تنسي خليلا . . . فاكثر دونه عد الليالي فما اسلي فءادك مثل ناي . . . ولا ابلي جديدا كابتذال ولم يرد علي وارد هو ابلغ من تقوية املي واستحكام رجاءي من العلم بدوام ما كنت اعهد منك ، وان هذه المحنة لم تءثر علي اثرا من رايك .  وكتب ابو اسحاق الصابي الي بعض اخوانه : وقد سالتني عن الفرق بين المترسل والشاعر ، وكنت سالتني  ادام الله عزل  عن السب في ان اكثر المترسلين البلغاء لا يفلقون في الشعر ، وان اكثر الشعراء الفحول لا يجيدون في الترسل . فاجبتك بقول مجمل ، ووعدتك بشرح له مفصل ، وانا فاعل ذلك بمشيءة الله فاقول : ان طريق الاحسان في منثور الكلام يخالف طريق الاحسان في منظومه ، لان افخر الترسل هو ما وضح معناه ، واعطاك غرضه في اول وهلة سماعه ، وافخر الشعر ما غمض فلم يعط غرضه الا بعد مماطلة نمه لك ، وعرض منك عليه . فلما صارت الاصابتان في الامرين متراميتين علي طريقين متباينين بعد علي الفراغ ان تجمعهما ، فشرقت الي هذا فرقة ، وغربت الي ذاك اخري ، ومال كل من الجميع الي الجانب الموافق لطبعه . ثم ترتبوا في المسافة بينهما ، فكان الافضل من اهل كل مذهب من وقع في الغاية او قريبا منها ، وجعل الوسط خاليا او كالخالي لقلة عدد الواقعين فيه . فليس يكاد يوجد جامع بين الاحسانين الا علي شرط يزيد به الامر تعذرا والعدد تنزرا ، وهو ان يكون طبعه طاءعا له ، ممتدا معه ، فاذا دعاه الي التطرف به الي احد الجانبين اطاعه وانقاد اليهن كابراهيم بن العباس الصولي وابي علي البصير ومن جري مجراهما ؛ فهذا جواب مسالتك . وتبقي فيها زيادات وانفصالات لا باس بايرادها ليكون القول قد استغرق مداها ، وتمت اولاه باخراه ؛ ذلك ان للساءل ان يقول : فمن اية جهة صار الاحسن في معاني الترسل الوضوح وفي معاني الشعر الغموض ؟ فالجواب ان الشعر بني علي حدود مقررة واوزان مقدرة ، وفصل ابياتا كل واحد منها قاءم بذاته وغير محتاج الي غيره الا ما يتفق ان يكون مضمنا باخيه ، وهو عيب فيه . فلما كان النفس لا يمكنه ان يمتد في البيت الواحد باكثر من مقدار عروضه وضربه ، وكلاهما قليل ، احتاج الي ان يكون الفضل في المعني ، فاعتمد ان يلطف ويدق ، ليصير المفضي اليه والمطل عليه بمنزلة الفاءز بذخيرة خافية استفادها ، والظافر بخبيءة دفينة استخرجها واستنبطها . ثم ان للمتامل  وقفات علي اعجاز الابيات ، وقد وضعت لادراك المعني والفطنة للمغزي ، وفي مثل ذلك تحسن خفايا الاثر وبعد المرمي . والترسل مبني علي مخالفة هذه الطريقة ومعاكستها ، اذ كان كلاما واحدا لا يتجزا ولا ينفصل الا فصولا طوالا . وهو موضوع وضع ما يهذ هذا او يقرا متصلا ، ويمر علي اسماع شتي الاحوال : من خاصة ورعية ، وذوي افهام ذكية وغبية . فاذا كان متسهلا ومتسلسلا ساغ فيها وقرب اذنه في افهامها ، وتساوقت الالسن في تلاوته ، والالباب في درايته . فجميع ما يستحب في الاول يستكره في الثاني ، وجميع ما يستحب في الثاني يستكره في الاول ، حتي ان ما قدمناه من عيب في التضمين في الشعر هو فضيلة في فصول الرساءل . الا تري ان حسنها ما كان متعلقا بعضه ببعض ، ومقتضيا تعطفا من الهوادي علي التوالي ، وردا من الاواخر علي المبادي . فمتي خرج الشعر علي سنن الابتداع والاختراع فكان ساذجا مغسولا ، فقاءله معيب غير مصيب ، والترك له ادل علي العقل واولي بذوي الفضل . ومتي خرج الترسل عن ان يكون جليا سلسا تعثرت الاسماع في حزونته ، وتحيرت الافهام في مسالكه ، فاظلم مشرقه ، وتكدر رونقه ، وكان صاحبه مستكره الطريقة ، مستهجن الصناعة . وقد بقيت في الباب زيادة اخري : وهي الاخبار عن سبب قلة المترسلين وكثرة الشعراء ، وعن العلة في نباهة اولءك وخمول هءلاء . فالجواب عن ذلك ان الشاعر انما يصوغ قصيدته بيتا بيتا ، فهو يجمع قريحته وقدرته علي كل بيت منها ، فيقرره ويبلغ ارادته نمه ، وله من الوزن والقافية قاءد وساءق يقومان له باكثر حدود العر ، فكانه انما يحذوه علي مثال ، او يفرغه في قالب مماثل . والمترسل يصوغ رسالته متحدة متجمعة ، ويضمها من اقطار متراخية متسعة ، وربما اسهب حتي تستغرق الواحدة من رساءله اقدار القصاءد الطوال الكثيرة . هذا الي ما يتعاطاه من فخامة الالفاظ اللاءقة بان يصدر مثلها عن السلطان واليه ، والتصرف فيها علي صروب ما تتصرف عليه احوال الزمان وعوارض الحدثان . فلذلك صار وجود المضطلعين بجودة النثر اعز ، وعددهم انزر . فاما ارتفاع  طبقتهم علي تلك الطبقة ، فان المترسلين انما يترسلون في جباية خراج ، او سد ثغر ، او عمارة بلاد ، او اصلاح فساد ، او تحريض علي جهاد ، او احتجاج علي فءة ، او مجادلة لملة ، او دعاء الي الفة ، او نهي عن فرقة ، او تهنءة بغبطة ، او تعزية علي رزية ، او ما شاكل ذلك من جلاءل الخطوب ومعاظم الشءون التي يحتاجون فيها ان يكونوا ذوي ادوات كثيرة ، ومعرفة مفننة . وقد وسمتهم الكتابة بشرفها ، وبواتهم منزلة رياستها ، فاخطارهم عالية بحسب علو خطر ما يفيضون فيه ويذهبون اليه . والشعراء انما اغراضهم التي يرتمون نحوها ، وغاياتهم التي يجرون اليها ، وصف الديار والاثار ، والحنين الي الاهواء والاوطار ، والتشبيب بالنساء ، والطلب والاجتداء ، والمديح والهجاء . فليس يجرون مع اولءك في مضمار ، ولا يقاربونهم في الاقتدار . وهذا قول فيما اردناه ان شاء الله تعالي . وكتب ابو اسحاق الصابي من كتاب الي رعية خرجت عن الطاعة : اما بعد ، احسن الله توفيقكم ؛ ان الشيطان لا يزال بكسو الخدع والشبهات ساربيل الحجج والبينات ليشعل بها الاحلام ، ويستزل الاقدام ، وتتجه له المداخل علي عقول ربما استضعفها ، ومال بها الي موارد غوايتها ، وازلها عن سنن هدايتها ، واراها الحق محالا ، والرشد ضلالا ، والخطا اصابة ، والخطل اصالة . بذلك جرت منه العادة ، وقامت عليه الشهادة ، واستحق ان تعصب به اللعنة ، وتتوقي منه الفتنة . واذا كان ذلك كذلك ، فحقيق علي كل ناظر لنفسه ، وحافظ لدينه ، ان يتحرز من الوقوع في اشراكه المبثوثة ، وحباءله المنصوبة ،  وخطاطيفه الحجن التي تجتذب القلوب ، وتغتال الالباب ، وتورد الموارد التي لا صدر عنها ، ولا انفكاك منها ، وان يتهم هواجس فكره ، ووساوس صدره ، ويعرضها علي نظره وفحصه ، وتامله وبحثه . ومنه : وقد علمتم  رعاكم الله  ان هذا الشيطان اللعين نازع لكم منذ حين ، وانكم علي ثبج منخطة فتنة قد برقت بوارقها ، وزمجرت رواعدها ، وجرت الفرقة التي لا شء اضر منها ، ولا انفع من تجنبها ، والنزوع عنها . قال الله تعالي ، وهو اصدق القاءلين ، واكرم المنعمين : واذكروا نعمة الله عليكم اذ كنتم اعداء فالف بين قلوبكم فاصبحتم بنعمته اخوانا ، وكنتم علي شفا حفرة من النار فانقذكم منها . ومن خالف ادابه وسننه فقد خسر دنياه واخرته ، واضاع عاجلته واجلته ، وتبوا مقعده من النار ، واستحقها استحقاق الكفار الاشرار ، والله يهدي من يشاء ويضل من يشاء . ونمه : وامير المءمنين يستعيذ بالله لنفسه ولكم من زلة القدم ، وعاقبة الندم ، ويساله ان يردكم الي الاولي ويلهمكم التقوي ، ويصدف بكم عن المناهج الغوية والموارد المخزية ، بمنه وحوله وطوله . وكتب عن نفسه اليالصاحب ابن عباد : كتابي  اطال الله بقاء مولانا  عن حظ من السلامة وافر ، وظل من الكفاية ساتر ، والحمد لله رب العالمين . وقد كنت فيما قبل اقل من مكاتبة مولانا اقلال المخل بحق يجب ، والمقارف لذنب ينكر ، واسكن مع ذاك الي ان معرفته الثاقبة تستنبط عذري وان غمض ، ومعدلته الفاءضة تمحص ذنبي وان ظهر . وع تقابل فطنته واشارتي ، وتوارد صفحه ومعذرتي ، فلا باس بان اوضح الامر لغيره ، ممن عسي ان يكون خفي عنه لاسلم عليه من التعجب ، سلامتي علي مولانا الصاحب من التعتب ،  وهو انني كنت منذ سنين كثيرة مرميا بعطلة ، وموسوما بعزلة ، فتخوفت ان يتطرق لبعض المنحرفين عني ، والباغين علي ، قول ربما تطرق مثله علي من نبا به زمانه ، وهرته اوطانه ، فاكون قد ابديت لمراصده عن مقاتلي ، ولمخاتلة عن حز مفاصلي ، فلزمت التقية ، وكرهت الاذية ، وانتظرت الامكان ، وتوقعت دورة الزمان ، وعلي ذاك فوالله  اطال الله بقاء مولانا  ما فارقت منذ عرضت بيني وبينه الشقة ، وابعدتني عنه الشقوة ، ذكره وشكره ، والثناء عليه والاعتداد به ؛ وان محاسن وجهه لنصب عيني ، ومخارج لفظه حشو سمعي ، ونوادر فضله جل ادبي ، والاسناد عنه كنه فخري . هذا وانما خدمته ايام كانت رياسته سرا في ضمير الزمان ، ودينا في ضمان الايام ، فكيف لو رايته امرا ناهيا بين وسادتيه ، وراي خادما ماثلا بين يديه ؟ وما يمكنني ان اهجو دهرا قصر خطوتي عنه ، وقد اعطاه من استحقاقه ما اعطي ، ولا ان امدحه وقد حرمني من جواره ما حرم . فان اوجبت له شكرا فلعظم بلاءه عنده ، وان الحقت به ذما فلاتصال القواطع عنه ، ولا سيما وانما حماني عن ورود بحر زاخر ، وحجبني عن ضياء بدر زاهر ، ومنعني من بلال نوء ماطر ، واخرجني عن غمرة غيث قاطر ، وحال بيني وبين من اليه الشكوي له ، ومنه العدوي عليه ، حتي خلا بي فافرط ظلمه ، وتحكم في فجار حكمه . وكتب الي صديق له : وصل كتاب مولاي وفهمته . فاما ما شكاه من الشوق الي ، فاحلف بالله انه صادق فيه ، مستغن عندي عن اقامة شاهد بما اجده من مثله . كيف لا يكو كذلك وقد اوحشنا الزمان من الاخوان ، وافردنا دون الاقران ، فصار كل منا بضاعة صاحبه المزجاة الواحدة ، وذخيرته الشاذة للشدة الفاردة . ومنذ فرق الدهر بين داريان ، فقد داني بين قلبينا ، وعرفنا فضل صنيعه الينا ، بان ابقانا من بين من افني ، واخرنا عمن مضي واودي . وحياة  مولاي  اطالها الله  ما تتعلل عيني الا بتصوره ، ولا قلبي الا بتذكره ، ولا قطعت كتبي عنه الا بنية واصلة له ، ومودة مواظبة عليه ، ومخالصة لا ينقصها الاغباب ، ولا يزيد فيها الادمان . وارجو ان يزول بنا دوران الزمان ، وكرات الليالي والايام ، الي اتصال حبل وانتظام شمل ، واستقرار دار ، وتداني جوار . وكتب عن قاضي القضاة محمد بن معروف الي الوزير ابي منصور محمد بن الحسين : الدنيا  اطال الله بقاء سيدنا الوزير  مذمومة ممن تساعد ، فضلا عمن تعاند . وقد علم الله انني لم ازل زاهدا فيها ، ذاهبا عنها ، ايام الاقبال والشبيبة ، فكيف عند وشك الرحيل والمفارقة ؟ ! ولو سلم الاحرار فيها من دواعي الحاجة ، وعوارض الخلة ، لهانت عليهم مقاطعتها ومصارمتها ، واستتب طريقهم الي متاركتها ومفارقتها ، وخاصة من كان مثلي في تداني المدي ، وتقاصر الخطي ، والتوجه الي الدار الاخري . لكنه لا بد فيها للمجتاز ، وان كان لا بثا علي اوفاز من مادة تسبل ستر التجمل عليه ، وتمنع من ظهور الخصاصة به . ولمولانا الملك علي نعم سوابغ ، واياد سوبق ، وقد كان سبيلي ان اشتغل بشكرها ، واستمر علي نشرها ، والحديث بها ، واتوقف عن استضافة غيرها اليها لولا المعذرة التي قدمتها ، والضرورة التي اومات اليها ، ومن تمام هذه النعم ان يكون الوجه مصونا والقوت موجودا . وكتب عن ابن بقية الي عضد الدولة : فاما اعتقاده  اطال الله بقاءه  حفظ الالفة ، ودحض ما الم بها من الوحشة ، فمشاكل لاراءه الصحيحة واخلاقه السجيحة ، ولما لم ازل ابعث واحث عليه ، وادعو وارشد اليه . واذا كان هذا رايه ، وكان عند مولانا الامير عز الدولة مثله ، وكنت بينهما مسديا ملحما فيه ، وباذلا وسعي في تقرير اواخيه ، فما ينبغي ان تقعد بنا حال عن الجمع بين القول والفعل ، والمساواة بين الشاهد الغاءب ، والمطابقة بين البادي والخافي . واما اللزوم لسنن موالينا الماضين  رضي الله عنهم اجمعين  فمولانا  اولي من حافظ عليها ، وتمسك بها ، وكل من بعده من موال  ادام الله نعماءهم  فيهم يقتدي ، وبادابهم يهتدي . وما يخالف في ذلك الا من الحق خصمه ، والحجة عليه ، والله تعالي من وراء معونته ان انثني وراجع ، او المعونة عليه ان اصر وتتايع . وها هنا  ايد الله مولانا  احوال اخر ، ودواع الي اعتقاد هذه الالفة لو لم تسبق الوصية بها من القرن الخالف : فمنها ان الادوات التي ادت الماضين الي تلك الاراء السديدة الرشيدة ، هي في الغابرين الباقين  مد الله في اعمارهم  اوجد ، وعليهم احسن ، وهم بان يستانفوها ويستقبلوها اولي من ان يتعلموها ويتقيلوها ، لارتفاع العصابة التي مولانا وسيدنا زعيمها ، واللحمة التي هو كبيرها وعظيمها ؛ ومنها ان انتشار التظالم ان بدا  والعياذ بالله  لم يقف ند الحد الذي يقدر ان يقف عنده ، ولم يخص الجانب الذي يظن انه يلحقه وحده ، بل يدب دبيب النار في الهشيم ، ويسري كما يسري النغل في الاديم . وكثيرا ما يعدي الصحاج مبارك الجرب ، ويتخطي الاذي الي المرتقي الصعب ، في مثل ذلك ، وانعكاس المتحملات في مثل ذلك اقرب من استتابها ، والتواءها اسرع من اعتدالها . وكان ابو اسحاق الصابي محبوسا في دار المطهر بن عبد الله ، وصودر علي مال اجحف به ، وكان المطهر يراعي حاله ، وكان معه ابناه محبوسين ، ويخرج كل واحد منهما في نوبة له . واتفق ان المطهر تفقد حال ابي اسحاق في مطمعه ومشربه ، فانكر خللا راه ، وضرب الطباخ ومنع المستخرج من مطالبته ببقية كانت عليه ، وحال بينه وبين مخاطبته ، وكان ذلك في نوبة ابنه الاصغر ابي علي المحسن ، فكتب اليه :  يا ابا علي ، جعلني الله فداك ، عشنا بعدك ما شينا ، وشبعنا وروينا ، وارخت السماء عزاليها ، واثعنجرت بما فيها ، فغمر الماء الزبي ، ونقع من الصدي ، ولبست الارض قناعها الاخضر ، ونضت شعارها الاغبر ، وعاضنا الغض العميم من المصوح الهشيم ، وجزانا الرطب المخضوم من اليابس المقضوم ، فعاشت العاملة والماشية ، وهاجت الابية الغاشية ، وارتجعت روايا المطايا ، ما اخذت منها المخارم والثنايا ، مستردة بمشافرها ما جذب البري بمناخرها ، ساءمة بين الكثيف الكث ، من الطباق والشث ، وسارحة في المناخ الفسيح ، من القيصوم والشيح ، فنحن في سوابغ من النعم ، نرتع فيها رتعة النعم ، قد عز عندنا ان يستضاف لدينا ضيف كريم ، واستغني ان يرتضع لءيم ، واترعت الجفان وذما ، واستحال القرم بشما وحالت البطنة دون الفطنة ، ومنع الطعام دون تراجع الكلام ، فلو ان قسا بيننا لخرس ، او دغفلا لابلس ، وكان الشاعر انما اراد احدنا بقوله : من الطويل اتانا ولم يعدله سحبان واءل . . . بيانا وعلما بالذي هو قاءل فما زال عنه اللقم حتي كانه . . . من العي لما ان تكلم باقل فهزيلنا بحمد الله سامن ، وضءيلنا باذن الله بادن ، واخلافنا دارة ، وغلاتنا مترعة ، ورياضتنا مخصية ، وعرصاتنا معشبة ، ومشاربنا متاقة ، وانهارنا متدفقة ، واشجارنا مورقة مرجحنة ، واطيارنا مغردة ، وريحنا رخاء ، وعيشنا سراء ، وزماننا ربيع كله ، وليلنا معر من اوله ، ونهارنا ضحي الي اخره . وقد اخرجنا الله من شدة الي بلهنية ، ومن ضغطة الي رفاهية ، ومن شقوة الي سعادة ، ناكل الطيب المستمرا بعد الخبيث المستوبا ، ونشرب البارد العذب ، بعد الاجن الملح . وادركتنا هزة الرعاية ، واطت بنا عند سلاطيننا  اطال الله بقاءهم   رحم الولاية ، وابدلنا من الاطراح محافظة وعناية ، ومن الادالة صونا ووقاية ، وحصلنا في ضيافة سيدنا الاستاذ الكريمة ، واستنقذنا من ملكة المستخرج السيءة اللءيمة ، فها هو ذا يكذب دوننا اذا حمل ، ويغني عنا اذا نظر ، ويتعزل بيتنا تعزل الاحوص بيت عاتكة ، يرانا نمه بنجوة ، وكنا له بالامس طعمة ، ويصرف انيابه حسرة ، وكنا له قبل اليوم مضغة ، ويهر علي غيرنا مع الاحرار هريرا ، ويملا اسماعنا فيهم زءيرا ، قد ذلت لنا من بينهم صعبته ، ولانت في ايدينا صعدته ، وجار علي عجمنا عوده ، ومال علي غمرنا عموده ، وفطرفه مغضوض ، وابهامه معضوض ، ومنار عظمته مخفوض ، ومبرم هيبته منقوض . قد شكل عنا بشكال ، ونشطنا علي رغمه من عقال ، فهو بالصغر باش بنا بعد اكفهرار ، وهاش لنا بعد اقشعرار ، ومتبسم في وجوهنا بعد تجهم ، ومقيد الفاظه عنا بعد تهجم ، ومتثعلب في مخاطبتنا بعد تقسور ، ومصانع بعد تغمشر ، وذلك ا البسناه الله من عز الرضي وصلاح النمقلب والمفضي . والحمد لله رب العالمين ، واياه نسال ان يبلغنا منتهي امالنا ، والغاية من اقتراحنا في هذه الدولة التي تقادمت فيها علاءقنا ، واستحكمت وثاءقنا ، ولم تزل نعمها متوقعة مضمونة ، ونقمها مصلحة مامونة ، ونحن الان طلاءح نكبة ، وطراءح محنة ، قد اوجب الله لنا فيها الثواب بعد العقاب ، والجنة بعد الحساب ، والتعويض بعد التمحيص ، والتانيب بعد التخصيص ، وبالله التوفيق . فاجابه ابو علي : وصلت معه سيدي  اطال الله بقاءه  مبشرة بالغيث الذي غمر الوري ، وروي الثري ، وبلغ الزبي ، ونقع الصدي ، وحرش الضباب ، واهاج الذءاب ، واسال التلاع ، وملا البقاع : من البسيط فن بمخلفه كمن بنجوته . . . والمستكن كمن يمشي بقرواح قد لبست الارض افخر حللها ، وتحلت بعد عطلها ، وابتسمت عن نوارها ، وضحكت عن زوارها ، وثقلت بعد خفها ، وتضوعت عن نسيم عرفها ، بالكلا  الذي طبق البلاد ، وعلا الوهاد ، وعم السهوب ، وشفي القلوب ، فالحاطب بطء الاوبة ، والقابس قرين الخيبة ، قد جن ذبابه ، ونعب غرابه ، وسمنت حواشيه ، وغرزت مواشيه ، فكان الثلج في مواطنها ، والقطن المندوف بين معاطنها ، يتطرف ولا يتنحي ، ويتتبع ولا يستقصي . قد اكثبها السعدان ، واحسبها المكر والضيمران ، فما تبرح عن ماوي ولا تنزح عن طلب مرعي ، قد القت رعاتها عصيها ، واستوقفت مضاجعها ، وجعلت حبالها علي غواربها ، واهملتها في مسارجها ، فانداحت بطونها ، وانبسطت غضونها ، واستحشت اكرعها ، واستحنت اضلعها ، فكان القاءل لها وصف ، واياها عني ، في قوله : من الخفيف ابلي الابل لا يحوزها الرا . . . عون مج الندي عليها الغمام سمنت فاستحش اكرعها لا الن . . . ني ني ولا السنام سنام وما البسه  ادام الله تاييده  من سوابغ النعم ، ومنحه من مطايب الطعم ، واترع له من الجفان الرذم ، وشمله من اريحيات الكرم ، حتي كظ البشم ، وذهب القرم ، واودت الفطن ، وعييت اللسن ، وصار قس في خطابته كباقل ، اذ عي عن حسابه ودعفل كبعض الاعراب وقد سءل عن النضناض ففتح عن فيه ، وادار لسانه فيه ، او كاحمد بن هشام الذي استطرد القاءل عليه بقوله : من الطويل وصافية تعشي العيون رقيقة . . . رهينة عام في الدنان وعام ادرنا بها الكاس الروية بيينا . . . من الليل حتي انجاب كل ظلام  فما ذر قرن المس حتي كاننا . . . من العي نحكي احمد بن هشام او كانا في اجابته التي بعد منها المرام ، وتقاصرت دونها الافهام ، فهي كالسماك في علوه ، والعيوق في سموه ، تحرن في يد مقتادها ، وتعز علي مرتادها ، محاولها مقهور ، والسالك اليها حسير . وضربت معه  ادام الله تاييده  بالسهم الفاءز ، واخذت بالنصيب الوافر ، في كل ما عدد ووصف ، وابان وعرف ، من اطلال السعود ، وكبت الحسود ، وانحسار النواءب ، واسعاف المطالب ، وعود السلطان  اطال الله بقاءه  الي ما يوجبه علاه ، ويقتضيه اياه ، من قديم الحرمة ، وسالف الموالاة والخدمة ، له ، من المحافظة علي الولي المخلص ، والعبد المتحقق ، بعد التهذيب والتاديب ، اللذين لم يعدوا الاصلاح ولم يتجاوزوا الارشاد ؛ والحصول في كنف سيدنا ومولانا الاستاذ الجليل  اطال الله بقاءه  الذي من تبواه سلم ونجا ، ومن تنكبه هلك وهوي ؛ وضيافته التي وضحت سبلها ، واشتهرت طرقها ، وجواره العزيز الذي لا تستطيعه النواءب ، ولا تتخونه الحوادث ، والانقاذ من ملكة المستخرج ، القصير النسب ، الدقيق الحسب ، الذي لا يراقب ، ولا يخاف العواقب ، ولا تدركه هزة ، ولا تعطفه اريحية ، والخروج عن يده الكزة الاصابع ، القليلة لامنافع ، اللءيمة الظفر ، الكثيرة الضر ، التي لا مخلص لمن وقع بين اناملها ، ولا منتزع لمن نشب في مخالبها . فالحمد لله الذي كفها عنا بعد الانبساط ، وقصرها بعد الاشتطاط ، وجعل مقلها يكدمها دوننا عضا ، ويبدلها بالبسط علينا قبضا ، قد ذللته الهيبة ، وقيدته الطاعة ، فانس بعد نفاره ، وعدل عن ازوراره ، حمدا يقضي له الحق ، ويءدي الفرض ، ويمتري المزيد من النعم ، ويءمن نوازل النقم ؛ واياه اسال ان يجعل سيدي في حماه الذي لا يرام ، ويلحظه بعينه التي لا تنام ، ويجريه علي العادة ، ولا يقطع عنه المادة ، بمنه وقدرته .  لما قبض هلال بن بدر بن حسنويه علي ابيه بدر ، وقال الناس في ذلك ما شاءوا ، فمن منكر لفعله مستفظع ، ومن مصوب له عاذر ، سءل ابو الحسن علي بن نصر الكاتب انشاء كتاب يبين فيه عن عذر هلال ويحسن اثره ، فكتب : ان اولي ما استمع ، واحري ما اقتفي وابتع ، كتاب الله تعالي المنزل علي قلب نبيه صلي الله عليه وعلي اله وسلم ، وازلف محله لديه اذ يقول جل جلاله وصدق مقاله ، مءدبا للخلق ، وحاضا علي قول الحق ، ومخوفا من الاثم المكتسب ، ومحذرا من الوزر المحتقب : يا ايها الذين امنوا اجتنبوا كثيرا من الظن ان بعض الظن اثم ويقول : يا ايها الذين يمنوا اتقوا الله وقولوا قولا سديدا ، فجعل التقوي له منوطة بالقول السديد ، والنطق الرشيد . فلا يجب لاحد من الخاصة والعامة ، وجد الرياء في خليقته ، وشيءا باين طبعه وسليقته ، ان يحكم التهم عليه ، يوجه الظنن اليه ، استنكارا لظاهره المستهجن ، دون استشفاف باطنه المستحسن ، لا سيما ان صدر من ذي رءاسة ، وبصير بسياسة ، قد لابس الخير ولاشر ، ومارس النفع والضر ، وعلم كيف تصرف الامور ، وتقلب الايام والدهور . فان لكل بدء خاتمة يورد عليها ، وعاقبة يفضي اليها ، ولرب جميل انكشف عن القبيح غطاءه ، وقبيح انحسر عن الجميل غشاءه ، ولا يعلم الانسان ما في المغيب . وان الله جل ثناءه ، وتقدست اسماءه ، جعل الاسلام دينا قيما يهدي اليه من الجهالة ، وطريقا مستقيما اوضح عليه الدلالة ، وسببا مبينا استنقذ به من الضلالة ، ختم به الاديان والملل ، وحتم اتباعه علي كافة الشراءع والنحل ، وجعل العاجلة لمن جهل واضح حجته ، وعدل عن لاءح محجته ، وبغي الفسا فيه ، وخالف اوامره  ونواهيه ، واستحل ما حرم الله تعالي من اهليه ، سفكا للدماء المحقونة ، وهتكا للمحارم المصونة ، وفتكا بالنفوس المحرمة ، ونهكا للاموال المجتمعة ، سيفا يحصد شوكته ، وحقا يقصم شرته ، وخوفا يشرد طمانينته ، واصاره في الاجلة الي نا ر تلظي ، لا يصلاها الا الاشقي ، الذي كذب وتولي . ثم وعد غير الراضي بفعله ، والجاري في مذاهبه وسبله ، جزاء الاسف والندامة ، ورداه برداء الخزي يوم القيامة ، قال الله تعالي : ومن يبتغ غير الاسلام دينا فلن يقبل منه ، وهو في الاخرة من الخاسرين ، وقال : ومن يتبع غيرسبيل المءمنين نوله ما تولي ونصله جهنم وساءت مصيرا . وخبر نبيه صلي الله عليه وسلم بصورة المءمنين وصفة المتقين ، فقال تعالي : لا تجد قوما يءمنون بالله واليوم الاخر يوادون من حاد الله ورسوله ولو كانوا اباءهم او ابناءهم او اخوانهم او عشيرتهم اولءك كتب في قلوبهم الغيمان وايدهم بروح منه . فحق لمن عق في الله اباه ، وهجر في مرضاته زوجه واخاه ، وقطع في طاعته رحمه ، وحاد في ذاته عشيرته ولحمه ، ان يلحقه بعباده الذين ارتضي فعلهم ، وشكر سعيهم وعملهم ، واعد الجنة ثوابا لهم ، اذ كان ما يتكلفه من هذه الحال التي تاباها الطباع ، وتنفر منها القلوب والاسماع ، مبالغة في القربة الي ربه ، وحرصا علي تحصيل ثوابه واجره . ومنها : وانا لما وجدنا ابانا  هداه الله الي الهدي وعدل به الي السبيل المثلي  قد استمر علي مزلفة مردية ، ومدرجة مودية ، مع تخلق العمر ، ونزول الامر ، ومشارفة حلول القبر ، وراينا له الكف عن غربه اصلح ، والتخفيف عن ذنبه اربح ، وقصره عن استزادة السيءات اكمل في بره ، وحصره عن الاستكثار من الموبقات افضل في شكره ، فقبضنا يده المبسوطة بالشر ، وكففنا سهامه المبثوثة بالضر ، واخفناه علي نفسه خيفة تردعه ، وتلجمه وتزعه ، عسي الله ان يهديه لرشده ، ويرده الي سواء قصده ، فيطفو من غمرته ، ويصحو من سكرته ، ويرجع الي ربه رجوع المضطر ، وينزع نزوع الذي مسه الضر ، ومعه بقية من  عمره ، يتدارك بها الفاءت من امره ، بتوبة متحنف ضاج ، ودعوة متلهف راج ، فانه تعالي يقول : ثم اذا مسكم الضر فاليه تجارون ، فنكون لحق تربيته قاضين ، ولحرمة ابوته حافظين ، باجتذابنا اياه الي مصلحته ، واستلابنا له من ضلالته وفتنته ، قبل فوت وقته ومدته . ونسال الله تعالي توفيقا لما قرب منه ، وازلف عنده ولديه ، وله  جل ثناءه  الحمد الطويل ، والشكر الجزيل ، علي ما انعم به علينا ، وازله من منحه الينا ، وسببه بتوفيقه لنا من اصلاح الفاسد ، ورد الحاءد ، وتقويم الزاءل ، وتعديل الماءل ، ورم الثلم وزم الكلم ، وامرار حبل الدين ، ونظم شمل المسلمين ، حمد من قدر منحته بقدرها ، وعرف لها حق شكرها ، واليها الرغبة في الامتاع بجميل الموهبة ، والهام الصبر علي ما امتحنا به من مكافحة شيخنا ، وفي اتباع دينه وكتابه ، واجتناب جوالب سخطه وعقابه . فليعلم الخاص والعام ممن انتهي اليه هذا الاثر ، وقرء عليه هذا الخبر ، ان النعمة ان لم تخصه في ما فعلناه ، فلم تبعده بمشاركة الكافة في ما ارغناه ، ومساهمة الجماعة في ما اثرناه من مصالحهم وابتغيناه . فلينصف من نفسه ، وليصرف عنها وساوس هجسه ، وما يخطر لها من تخيل انا خلله ، واوضحنا بطوله وزلله ، ليسر الطاعة في قلبه ، وليظهرها في فعله ونطقه ، يجد من الله هاديا رءوفا ، ومن ساءسه راعيا عطوفا ، ومن الرشد طريقا مهيعا ، ومن القصد سبيلا متبعا ، فان الله مع المءمنين ، ويهدي من يشاء الي صراط مستقيم . وعمل فصولا علي السنة جماعة من المتقدمين ، عرضت علي الوزير ابي العباس ، فلما قبلت ومدحت كتب مقرا بها فيما بعد : الالفاظ  اطال الله بقاء الوزير  نتاءج الافكار ، وحالة من القلوب محل  الاولاد : يكون منهم القرة والعرة ، وبكليهما يقع الافتتان والمسرة ، وليس يصح لاحد علم جميلها من قبيحها ، ومعرفة سقيمها من صحيحها ، الا بان يسلط عليها ثواقب الافهام ، وجهابذة الكلام ، ثم يتخلي عنها ، ويتبرا منها ، ليسلم ذامها من المراقبة والمحاباة ، ويبعد مما اصطلحت عليه الطباع ، واتفقت عليه الاسماع ، من مقابلة ما يورده المتاخر بالرد ، امام التصفح له والنقد ، واستشعاره تقصيره فيه ، قبل تامل الفاظه ومعانيه . فان المحدث مظلوم ، والمحدث خاصة مفهوم ، وفي ذلك اخبار متعالمة ، واحاديث متعارفة متداولة . ولا عذر لمن شافهه من الوزير  اطال الله بقاءه  لسان البلاغة ، وواجهه انسان عين الفصاحة ، وقومه شخص الكتابة ، واستخدمه ملك الخطابة ، الا يجري بالسداد قلمه ، والصواب كلمه ؛ كما لا حرج عليه مع تشبث الهموم بفكره ، وتمكنها من صدره ، ان يكثر خطاه وخطله ، ويتصل عثاره وزلله . وكنت خدمته بفصول مختلفة المباني ولااصول ، تقلبت فيها تقلبي في احسانه ، ونشرت مطويها نشري لانعامه وامتنانه ، ونحلت حملا منها من لا يتجمل بملكه ، وان تحملت بانخراطها ف ينظمه وسلكه ، متعمدا بذلك ما قدمته ، معتقدا فيه ما قررته ، وما ا ، شط الان مع نفاقها في سوق مجده ، ابتعاثها شرارة من زنده ، لتركها ، ومن لم يعرق في استنباطها جبينه ، ولا در لاستخراجها وتينه ، وارجو ان ال يجلب هذا الاقرار تغييرا ، ولا يولد علي السنة المالوفة نقيصة ولا تقصيرا . وهذه ظلامة لا يسع العادل تركها ، ولا يسوغ في النصفة العدول عنها ، وليس تجري المطالبة بها مجري الرجوع في الهدية ، وانما هو كاسترداد القرض والعارية . والله يحسن توفيقي لطاعته ، ولا يسلبني حسن تثقيفه وهدايته ، بمنه وقدرته ، وهو حسبي ونعم الوكيل .  وكتب الي صديق له : قد عرفت ، ايها الاخ ، الدهر وتبدله ، والزمان وتنقله ، وانه غير ملتزم لوتيرة ، ولا مبرم القتل علي مريرة ، بينا هو مقبل حتي يعرض ، ومنبسط حتي ينقبض ، ومعط حتي يحرم ، ومعاف حتي يسقم ، وعادل حتي يظلم ، وبان حتي يهدم ؛ الغدر سجيته ودابه ، والفتك بغيته وطلابه . فالعاقل غير ساكن الي حباءه ، والحازم غير واثق بوفاءه . لا يجد الانسان عليه ظهيرا ، ولا من نواءبه نصيرا ، الا اخا ادخره في رخاءه لشدته ، وذا ود اعتقده باصالة رايه لفاقته ، فعساه اني لطف لازالة بلواه ، اذا غاض صبره علي سكون من النفس اليه ، وامان من الشماتة بما يقف من حاله عليه . فكثيرا ما خرج الاحرار باحزانهم مستروحين بنفثها ، وباحوا باشجانهم باءحين ببثها ، الي مستبشر بما لحقهم ، وان كتم استبشاره وحزنه ، ومبتهج بما طرقهم وان ستر ابتهاجه وشجنه ، وما احسن وصية المتنبي ، سقي الله صداه ، في قوله : من البسيط لا تشك يوما الي خلق فتشمته . . . شكوي الجريح اليالغربان والرخم فليس بقليل الحظ من ظفر بخل امن سره وجهره ، وعلم خيره وشره ، وطعم حلوه ومره . وما زلت علي مر الليالي والازمان ، انتقي الاخلاء والاخوان لاضيف اليك اخر اعضدك ونفسي باختصاصه ، ويشد عضدك ويدي باستخلاصه ، حتي طلع في السنين المتطاولة ، وبعد لي الايام المماطلة ، في افق المودة والاخاء ، وسماء المخيلة والرخاء ، السيد ابو فلان ، والفيته متخلصا من شواءب القتام ، موفيا في رضاع سخيله علي بدر التمام . فاولت رءيته امرا مقبلا وسللت علي عنق الايام منه منصلا ، وما زالت الخبرة توفي علي الخبر ، والتجربة تزيد في حسن الاثر ، الي ان استحكمت قواعد الوداد ، وضربت الثقة  دون سداده بالاسداد ، ثم اراني الحظ الان امرا مخالفا لما كنت به عارفا ، واسمع لفظا منافيا ما كنت له الفا ، من اخلال بوصال احال فيه علي موجب الحال ، وقوة من خطاب كانت لا تخطر قديما له ببال ، وتنزه عن الاعتذار عند الفرطات كان مبذولا علي مر الساعات ، وامارات بعد هذا وامارات ؛ وانا لطلبي اطب العلة بالصبر ، ولسوء ظني استجيب لما اسامه من امره وفساد مثله ، حرسه الله ، غير مسموح به . وتغير العادة علي مثلي ابلغ شء في اذي قلبه ، فانا بين مصابرة ومساترة ، ومواربة ومساورة : من الطويل يقولوا تجنب عادة ما عرفتها . . . شديد علي الانسان ما لم يعود فان رايت ان تقف علي هذه الجملة سرا ، وتوسعها تدبيرا وفكرا ، وتسبل عليها من كتمانك جناحا وسترا ، وتهدي لراي تعمله لاعمله ، وتمثله لامتثله ، فعلت ، ان شاء الله تعالي . ومن كلام له : ومثله  ادام الله تاييده  ممن تراعي حسناته وتلحظ ، وتزوي زلاته وتحفظ ، ويثني عليه بصحة العهد والذمام ، ويسرع اليه قدح العيب والملام ، يجعل الاناة زماما لاعماله ، والروية راءدا لافعاله ، فيسء بالعجلة ظنا ويقلب الراي ظهرا وبطنا ، حتي اذا صفا من الشواءب ، وشف له عن غيب العواقب ، ابداه عن يقين لا يطور به الشك ، وامضاه علي تحقيق لا يسوغ معه الترك ، والله  عز اسمه  يهديه للاوفق ، ويرشده الي الاحري بفضله والاليق ، انه علي كل شء قدير . وكتب الي دار الخلافة في معني سقوط فرس :  انتهي الينا نبا شغل القلب وروعه ، وقسم الفكر ووزعه ، وجلب الاهتمام ودعاه ، واوجب الازعاج واقتضاه ، وتعقبه خبر دفع الكربة وصرفها ، ورفع الغمة وكشفها ، وطرد المساءة بالمسرة ، وابدل الاشفاق بالحبرة ، من عثرة زلت لها يد الجواد ، وكبوة كانت والسلامة علي ميعاد ، وانما قرنها الله تعالي بها ملاحظة ، واجراها معها محافظة ، لتصرف روعة باديها ، وتكفي عاقبة عواديها ، وتحسم مادة الاذي والضرر فيها . وان كان ما يتخذ من المراكب للخدمة الشريفة كريما نسبه وعرقه ، مهذبا مذهبه وخلقه ، امينا خببه وركضه ، وثيقة سماءه وارضه ، فانه يتضاءل عند اعباء المجد ، ويضعف عند امتطاء الشرف العد ، ويري ان عليه من عز الخلافة وفخارها ، وحكم الامامة ووقارها ، ما تزل معه الاطواد الفارعة ، وتضيق به الاقطار الواسعة . فذنبه بعذره ممزوج ، وعثاره لاستقلاله موهوب . والحمد لله الذي كمل لدينا البر والانعام ، وكفي المسلين والاسلام ، وجعل المخافة بالنعمة مقرونة ، والسلامة مع الحذر مضمونة ، واليه الرغبة في حراسة الحضرة النبوية ، من عوارض المحذور ، وطوارق الدهور ، وان يجعل ايامها موصولة بالامن واليمن ، وسعادتها منظومة بين الاحسان والحسن ، فلا نتخللاه شاءبة ، انه علي كل شء قدير . انباناك هذه الجملة لتقوم بانهاءها علي عادة منابتك ، وتشفي اختصارها باسهابك واطالتك ، وتجيءنا بما نسكن اليه . ونشكر الله الكريم عليه ، ونعتده منك ولك ، ان شاء الله تعالي . كتب ابو القاسم الحسين بن علي المغربي الي ابي القاسم سليمان بن فهد ، وقد اهدي اليه خمسة اقلام في يوم نيروز : للناس  اطال الله بقاء الاستاذ الجليل  عادة في مثل هذا اليوم بتهادي الاقلام ، وقد كان يجب ان يكون هذا الفعل محظورا الا عليه ، وممنوعا الا منه ،  لان الاقلام اذا اهديت اليه قد اعطيت قوس البلاغة باريها ، واعلمت افراس الكتابة مجريها ، وانصفت هذه الالة ولم تظلم ، واكرمت هذه الاداة الخطرة ولم تهتضم . واذا عدل عنه  حرسه الله  فقد انزلت دار غربة ، واحلت منزل هوان وذلة ، وشتت عن اوطانها ، وشردت عن ميدانها ، وفرق بينها وبين من يستخدمها في توشية برود المجد ، وتسهيم ملابس الحمد ، وتانق روض الفصاحة ، واستثمار جني البلاغة ، وما احق هذا المعني بما قيل : من الكامل اقرا علي الوشل السلام وقل له . . . كل المشارب مذ هجرت ذميم لو كنت املك منع ماءك لم يذق . . . ما في قلاتك ما حييت لءيم ولكن لو ملكت امارة هذه الصناعة ، لحميت منابت اليراع ، وصنت مغارس الغياض ، ولمنعتها الا من كل صنع اللسان واليد ، كريم القول والفعل ، ولخصصته  ادام الله تاييده  بابيات ابن عنمة كلها : من الخفيف انت خير من الف الف من النا . . . س ما كبت وجوه الرجال عندك البر والتقي واسي والنف . . . س وحمل لمضلع الاثقال وصلات الارحام قد علم الل . . . ه وفك الاسري من الاغلال وعلي هذه المقدمات التي طغي بها اللفظ ، ولم اعتمد فيها الا ما بين عن القصد ، فقد نفذت خمسة اقلام لا اصفها بالجودة ولا الجود ، فاطعن علي فروسية يده التي تمتطي الصعب والذلول ، وتمر في الوعث والسهول ، وهو ادام الله تاييده  يشفع في قلتها نية منفذها ، ان شاء الله تعالي . ومن كلام اخي ابي نصر الحسن بن الحسن بن حمدون : وقد كان الاحتياط من طعن الغاءب يقتضيني اخلاء هذا الجمع مما يتهم هواي فيه ، وحكم الانصاف علي بان اوفيه حقه اذ كان لاحقا بالقدماء في صناعته ؛ تشهد له بذلك رساءله .  رسالة كتبها جوابا عن تاج الدولة ابي طالب بن الطاهر نقيب الطالبيين الي ابي عبد الله احمد بن علي بن المعمر : اوصل الي فلان  ادام الله علو الجانب الفلاني وقدرته ، ورفع في الاخرة كما رفع في الدنيا درجته ، وكمل بنيل الاماني جذله ومسرته ، واضاء باتصال البشاءر والتهاني لديه اسرته ، وجمل بطول بقاءه عترته الطاهرة واسرته  كتابا كريما يشتمل علي ضروب من البر وفنون ، وابكار من الطول المتتابعة امداده الي وعون ، وفضل يذعن له بالسبق كل ذي براعة وخط ، يهزا حسنا بما تخطه يد كل ذي يراعة وتصرف في العبارة ، لم يكن للصاحب ولا ابن العميد ، وتمكن في البلاغة لم يعطه مولي العلاء بن وهب عبد الحميد ؛ ويقسم للمعاني التي ركبت في جسد الكلام روحا ، وجعلت صدر قارءها وسامعها بالالتذاذ بها مشروحا . ووقفت عليه مجيلا في ميدان الثناء باياديه المتالية جوادي ، وشاكرا لما نزله الي من عوارفه شكر الرياض المجودة من الغوادي ، ومعترفا بالاء البيت الكريم المعضودة عواءدها عندي بالبوادي ، الساءرة اخبارها في الحواضر والبوادي . وعرفت ما تضمنه من الاشارة الي غزير فضله الذي نحلنيه ، ووصفه الجميل الذي اعارنيه ، وعلمه الذي لا يساجله فيه مساجل ولا يدانيه ، والشهادة لي من ذلك تمريه ، لولا جلالة قدره ، وشرف عنصره الزاكي ونجره ، لقلت دافعا ما شهد لي به ، وكساني حلل الفخر : بحسبه ان الفضاءل لا يسعها الا اوعية حامليها ، والعلوم تفضح عند الاختبار منتحلها كاذبا ومدعيها ، لكن اذا شهد لي مثله من الاماجد وفرسان الادب ، الذين يقر ببراعتهم فيه كل جاحد ، فليس الا التلقي بيد القابل الشاكر ، واستخدام الافكار في الثناء علي معاليه والخواطر . فاما ما كلف موصل الخطاب حمله ، واوعز اليه بالمشافهة به تفصيلا وجملة ، فقد اورد ما عزاه الي التقدم التاجي واسنده ، وحقق القول فيه واكده ، وجلا وجود العواءق للنفوس عن راحتها ، وازال المكاره المناسبة لاحوال الوقت بساحتها ، فالفرصة في قصد تلك الخدمة منتهزة ، والغنيمة بالفوز بها  ان شاء  الله  مع وجود السبيل محرزة . وكتب الية صديق له من البغداديين انتقل الي الموصل وصار اليها ، وعرض فيها بذكر الجمال محمد بن علي الاصبهاني ، وزير الشام والموصل ، المشهور بالافضال والجود : سيدنا  اطال الله بقاءه ، وادام ارتفاعه الي فلك المعالي وارتقاءه ، ويسر له كل ارب تسمو نحوه همته  وصل النجح ولقاءه ، وضاعف عناء حسوده الراغم وشقاءه  حجة بغداد علي من جحد فضلها ، ولسانها المجادل بالحف لمن عاند اهلها ، وعنوان ما خصها الله به من المحاسن التي لا ينكرها الا ظالم معت ، ولا يخالف عليها الا كل جاءر عن القصد غير مهتد ، فانه البارع في كرمه ، الفارع هضاب الانفراد عن الاقران بشيمه ، الحاوي قصب السبق بما اشتهر من مروءته ، المغبر في اوجه الكهول في ريعان شبيبته ، الجامع اشتات المحامد باخلاقه الممدوحة بكل لسان ، المحبوبة الي كل انسان ، فقد رفع عنا في المحاجة دونها كلفة المقال ، ووضع عنا وزر المراء المنهي عن المباهاة به واثم الجدال . وصارت الموصلي تزهي به وتدعيه ، وتقول لنفسها ان هم بفراقك فلا تدعيه ، فقد ازدانت بسداده عرصتك ، وذهب كمدك بحلول من مثله وغصتك ، واتسع لك في مفاخرة بغداد بادعاءك اياه ضيق المجال ، ووجدت به ضالتك في زمان اضحي وهو محط الرحال . هذه اشارة لا ينكر ذوو الالباب ، العالمون بدليل الخطاب ، ان لسان الحال بها من لسان المقال افصح ، وميدان المستدل عليها افسح ، وميزانه اوفي عند اثبات البينات وارجح وحجته اظهر يومءذ واوضح . وعرض علي فلان فصلا كريما من حضرته ، يتضمن اهداء السلام الي وشكر ما تادي اليه من ثناءي لمحاسنه التي لا منة لي في وصفها المتعين علي ، فوقفت منه مع اختصاره علي بلاغة في ايجاز ، وعبارة تستدعي من متدبرها نشوة  طرب واهتزاز . وسرحت سوام طرفي من خطه في رياض مونقة ، وحداءق بالازهار مشرقة : من الكامل كتفتح النوار فتقه الحيا . . . او كالصباح فري الدجي بعموده وما زلت قبل وروده اناجي نفسي بقرع باب المكاتبة واحدثها ، واحملها علي عمارة سبيل المواصلة وابعثها ، واهجن عندها المقاطعة المتصلة ، والمصارمة المستعملة ، مهما تاكد في سالف الايام بين الاسلاف ، من الوداد الجميل الاوصاف ، وكون ذلك عند الابناء قرابة مرعية ونسبا ، والي تقارض المودة في ذات بينهم سببا . فتقول لي : العادات سنن متبوعة ، وملل مشروعة ، والذي استمر به العرف ان يكون ابتداء المكاتبات من المسافر ، والمفاتحة بها من الظاعن عن وطنه الساءر ، فلا تثريب عليك في الانقباض ولا ملام ، ولا مقال للزاري عليك في ترك المباسطة ولا كلام . لكن لما استمرت مدة الانقباض المستهجن وطالت ، واسهبت المحافظة في توبيخها علي تراخي هذه الحال واطالت ، ووصلني الفصل الذي وفر حبرتي واغتباطي ، وحرك لتلافي فارط التقصير نشاطي ، رايت ان مثله  وان عز وجوده  يحتسب له ولا يحاسب ، وتبذل له العتبي ولا يعاتب . فنشطت قلمي من عقاله ، وعجت عن هجر الاسترسال الي وصاله ، مشعرا له  ادام الله علوه  ان كثيرا من الاجانب ، ومن لم يرني من الجوانب ، يقلدني نجاد المنة بخير ينبي عند ذكري ، وقول جميل ابناءه نحوي تسري ، او كتاب يصدره الي مفتحا ، او يشكر به خدمة راي تقربي بها متضحا ، فكيف لي ان يقتدي في حقي بالبعداء من يحل مني محل الاعزة والاقرباء ، اما بمواصلة جميلة ، او نيابة بتحسين الذكر كفيلة . وهذا مقام لا يستغني فيه عن الافصاح بالحقيقة التي يمنع الحزم من التصريح بها ، والمعيته كافية في لمحها ، والاستدلال بجملتها علي شرحها .  وبعد ، فانا ممن الهمه الله حب الفضاءل وفاهلها ، واغراه بشناة من بلي بجهلها ، فاذا رايت الدهر قد سمح بماجد كريم ، وعوض سوام الامال يمرعي مريع غير هشيم ، وجاد بعد ضنة بارعواءه واعتابه ، وعدل بعد ظلم باقرار حق في نصابه ، وجدت في منتي قوة كنت عدمتها ، ومن همتي حركة منذ الامد الطويل ما عملتها ، واعتقدت ان بضاءع الفضل الباءرة قد نفقت ، وايدي مشتريها علي ايدي مجهزيها بالربح قد اصفقت ، وان النقص الذي استولي علي الارض من اطرافها ، واشترك فيه الاعم الاغلب من مشروفي ساكنيها واشرافها ، قد رفع عاره عن الامة ، وكشف بازالته عنها حجاب الغمة . وما برحت ، منذ انشر الله رميم الكرم الداءر الدارس ، واعاد روح المعالي زاكية المنابت نامية المغارس ، بالجانب الفلاني  جمع الله بدوام سعادته شمل المجد ، وبلغه الغاية القصوي من علو الجد  اضوع المحافل في ذلك مبالغة من ملك الشغف قلبه فما يراقب في المغالاة خلقا ، ولا يخاف التكذيب من يقول حقا ، ما لم يكن لطمع عرضي ، ورب مقام قمته ، وعذر ي الاجتهاد ابليته واقمته ، وقد جري ذكر هذا الجانب  ادام الله علاه  فقلت : نفس عصام سودت عصاما وهل الفخر الاوفي ، وشرع المجد الاصفي ، وقدح الرياسة المعلي ، والسيادة المجاوزة رتبة الفرقدين محلا ، الا من وفق الله له هذا الماجد الحلاحل ، والجواد الذي ليس لبحر جوده ساحل ، والكريم الذي اضحت امواله مقسمة بايدي عفاته نمتهبة ، واعينها لما منيت به من بغضاءه منتحبة ، وهمته العلية مستغرقة للاوقات في رسم عاف يعيده ، وبر واف للمجتدين يفيده ، ودين يقوم في حفظ معالمه اذا قعد الجميع ، ويجيب داعيه وقد تصامم عنه كل سميع ، ومصلحة جامعة يحيي رفاتها ، ونفس مجدود يقضي من اوطارها ما فاتها ، وعلم تنشر  اعلامه بارفاد حامليه ، وصنع جميل يتخذه عند امليه ، ومكرمة يصيب بها مواقعها ، واحدوثة جميلة يكتسي وشاءعها ، وذكر ملا الافاق نشره طيبا ، واصبح كل لسان بمدحه خطيبا . وهل ما يتداوله الرواة ، وتتناقله في الكتب الافواه ، من اخبار شيخ البرامك يحيي بن خالد ، وماثر كل كريم من قديم الزمان ماجد ، والنفوس تنكر بعضه استعظاما ، وتعتده سمرا او مناما ، الا دون ما نراه عيانا ، ونستوضح في كل ساعة دليلا عليه وبرهانا . لعل وجوها كانت في هذاالمقام حاضره ، واعينا رامقة الي ناظره ، فزويت عني تلك غيظا وامتقعت ، واغريت هذه بمسارقة النظر المريب نحوي واولعت ، وانا خالع بالمضي في شوطي للعذار ، غير ملتفت فيما يكمد الحاسدين الي الاعتذار . ورايت في تصفح هذه المفاتحة متاملا ، وقراءتها متلقيا بحسن القبول متقبلا ، واستءناف المواصلة بكتبه الكريمة التي تمهد مباني الوداد ، وتعمر سبل المحافظة التي يعدها امثاله من اولي البصاءر اجمل مكتسب ، واعلي في مجاري احواله  اجراها الله علي ايثاره ، وامدها بجنود السعادة في ليله ونهاره  ما اشتبهت ارواح الانس بمعرفته ، ولشكر صنع الله عنده في مقابلته اعلي . وما وضع صدور الادباء رساءل اسماء بغير اجسام ، والفاظا بغير معان ، الا ليدلوا علي موعهم من البراعة ، وينبهوا علي محلهم من البلاغة . فمنهم الجاحظ وكان مسهبا يستقي من بحر لا نيزح ماءه ، ويمتري اثباج در لا تقلع سماءه ، ويهدر هدير الفنيق بلا نهاية ، ويءم نهجا لا مقصد له ولا غاية ، والمعري يحوم ولا يعوم ، ويلوب ولا يرد ، ويلغز ولا يبرز ، كانما عنده مضمر يخاف من كشفه ، وخلل ان اظهره اذن بحتفه . وله رساءل كثيرة لكنها موشية بوهمات الالحاد ، ومبنية علي اختلاطه في الاعتقاد ، كانه شاك مريب او هازء عابث ، وقد استكثر من روايتها فان تركت معجمة اهملت ، وان فسرت خرجت عن معني الرساءل ، وصارت بكتب اللغة اشبه ، مع ان الحرج يمنع من التعرض لتدوينها ، وقد اقتصرت منها علي  رسالة هي من اسلمها . وللبديع والحريري مع تبريزهما ابدا صريحهما عن الرغوة واعلانهام بالاختلاف والغربة ، فوضعا حكايات مفعولة ، عن اسماء مجهولة ، ابانا بها عن فضاءل ليست بمفضولة . نسال الله السلامة من موبق الضلال والمين ، وان يكشف عن بصاءرنا غياهب الهوي والرين . رسالة كتبها ابو عثمان عمرو بن بحر الجاحظ الي مويس بن عمران : زينك الله بالتقوي ، وكفاك ما اهمك من امر الاخرة والدنيا ، واعزل بالقناعة ، وختم لك بالسعادة ، وجعلك من الشاكرين . عن عاقب  ابقاك الله  علي الصغير بعقوبة الكبير ، وعلي الهفوة بعقوبة الاصرار ، وعلي الخطا بعقوبة العمد ، وعلي معصية المقلين ، فقد تناهي في الظلم . ومن لم يفرق بين الاعالي والاسافل ، وبين الاقاصي والاداني ، عاقب علي الزنا بعقوبة السرق ، وعلي القتل بعقوبة القذف . ومن خرج الي ذلك في باب العقاب ، خرج الي مثله في باب الثواب . ولا اعلم نارا ابلغ في احراق اهلها من نار الغيظ ، ولا حركة انقض لقوي الابدان من طلب لسان الجليس المداخل . والشعار دون الدثار ، والخاص دون العام . والطالب  جعلت فداك  بغرض ظفر ما لم يخرج المطلوب الجبان ، وما لم تقع المنازلة .  ومن الحزم الا تخرج الي العدو الا ومعك من القوي ما يعم الفضلة التي يتيحها لك الاخراج ، ولا بد ايضا من حزم يحذرك مصارع البغي ، ويخوفك ناصر المظلوم . وبعد ، فانت  ابقاك الله  تضر من الم الغيظ نفسك ، والغيظ عذاب اليم ، وربما زاد التشفي في الغيظ ولم ينقص منه . ولست علي يقين من ان يعود سهمك في ضرك ، كما اقنت بموضع الغيظ من صدرك . والحازم لا يلتمس شفاء غيظه باجتلاب ضغنه ، ولا يطفء نار غضبه باحر من غضبه ، ولا يسدد سهمه الا والغرض ممكن ، والغاية قريبة ، ولا يهرب والهرب معجز . ان سلطان الغيظ غشوم ، وان حكم الغضب جاءر ، واضعف ما يكون العزم عند التصرف ، واضعف ما يكون الجزم والغضب في طباع سلطان الهوي ، والهوي يتصور في صورة امراة ، ولا يبصر مساقط العيب ومواقع السرف الا كل معتدل الطباع ، مستوي الاسباب . والله لقد كنت اكره سرف الرضي مخافة جواذبه الي سرف الهوي ، فما ظنك بسرف الغضب وبغلبة الغيظ ، ولا سيما ممن تعود اهما النفس ، ولم يعودها الصبر ، ولم يعرفها موضع الحظ في تجرع المرارة ، وان المراد من الامور عواقبها عواجلها . ولقد كنت اشفق عليك من افراط السرور ، فما ظنك بافراط الغضب ؟ وقد قال الناس : لا خير في طول الراحة اذا كان يورث الغفلة ، ولا في طول الكفاية اذا كان يءدي المعجزة ، ولا في كثرة العي اذا كان يخرج الي البلادة . جعلت فداك ، ان داء الحزن ، وان كان قاتلا ، فانه داء مماطل ، وسقمه مطاول ، ومعه من التمهل بقدر قسطه من اناة المرة السوداء ، وداء الغيظ سفيه  طياش ، وعجول فحاش ، يعجل عن التوبة ، ويقطع دون الوصية ، ومعه من الحرق بقدر قسطه من التهاب المرة الحمراء . وانت روح كما انت جسم ، من قرنك الي قدمك . وعمل الافة في الدقاق العتاق اسرع ، وصدها عن الغلاظ الجفاة اكد ، فلذلك اشتد جزعي لك من سلطان الغيظ وغلبة الغضب . فاذا اردت ان تعرف مقدار الذنب اليك ، من مقدار عقابك عليه ، فانظر في علته وفي مخرج سببه ، والي معدنه الذي فيه نجم ، وعشه الذي منه درج ، ومغرسه الذي فيه نبت ، والي جهة صاحبه في التتابع والنزع ، وفي التسرع والثبات ، والي حاله عند التقريع ، والي حياءه عند التعريض ، والي فطنته عند الرشق والتورية ، فان فضل الغيظ ربما دل علي فرط الاكتراث بكون الاقدام والاحجام ، فكل ذنب كان سببه الراي ، او ضيق صدر وغلق طباع ، وجد مرارا ، او من جهة تاويل او من جهة الغيظ في المقادير او من طريق فرط الانفة ، وغلبة طباع الحمية من بعض الجفوة او لبعض الاثرة ، او من جهة استحقاقه عند نفسه ، وفيما زين له عمله انه مقصر به ، مءخر عن مرتبته ، او كان مبلغا عنه ، او مكذوبا عليه ، او كان ذلك جاءزا فيه غير ممتنع نه ، فاذا كانت ذنوبه من هذا الشكل وعلي هذه الاسباب ، وفي هذه المجاري ، فليس يقف عليها كريم ، ولا يلتفت لفتها حليم ، ولست اسميه بكبير معروفه كريما ، حتي يكون عقله غامرا لعلمه ، وعلمه غالبا لطبعه ، كما اني لا اسميه بالذي اري من كفه عن القصاص حليما ، حتي يكون عالما بما ترك ، وعارفا بما اخذ . واسم الحلم جامع للظلم والقدرة والفهم ، فاذا وجدت الذنب بعد ذلك لا سبب له الا البغضة والا تشفي  النفس والعناد الغالب ، فلو لم ترض لصاحبه بعقاب دون قعر جهنم لعدلك كثير من العقلاء ، ولصوب رايك عالم من الاشراف . ومتي كانتت طبيعته البذاء ، وخليقته الشرارة والتسرع ، فاقتله قتل العقارب ، وادمغه دمغ رءوس الحيات . واذا كان ممن لا يسء فيك القول ، ولا يرصدك بالمكروه ، الا لتعطيه علي الخوف ، وتمنع عرضك من جهة التقية ، فامنعه من جميع رفدك ، واحتل في منعه من قبل غيرك . فانك ان اعطيته علي هذه الشريطة ، واعظمته مع هذه الحكومة ، فقد شاركته في سب نفسك ، واستدعيت الالسنة البذيءة الي عرضك ، فكنت عينا لهم عليك ، وبابا لهم اليك . وكيف تعاقبه علي ذنب لك شطره ، وانت فيه قسيمه ، الا ان عليك غرمه وله غنمه ؟ ومن العدل المحض والانصاف الصريح ان تحط عن الحسود نصف عقابه ، وتقتصر به علي مقداره ، لان الم حسده لك قد كفاك مءونة شطر غيظك عليه . واما الواد فلا تعرض له البتة ، ولا تلتفت لفته ، ولو اتي علي الحرث والنسل ، وجثا علي الروح والقلب . ولا تغتر بقوله اني اود ، ولا تحكم له بدعواه اني جد وامق ، وانظر انت في حديثه والي مخارج لفظه ، وفي لحن قوله ، والي طريقه وطبعه ، والي خلقه وخليقته ، والي تصرفه وتصميمه ، والي توقفه وتهوره ؛ وتامل مقدار جزعه من قلة اكتراثه ، وانظر الي غضبه فيك ولك ، والي انصرافه عمن انصرف عنك ، وميله الي من مال اليك ، والي تسلمه من الشر ، وتعرضه له ، والي مداهنته وكشف قناعه ، بل لا تقض له بجميع ذلك ما كان ذلك في ايام دوليتك ، ومع اقبال امرتك ، وان طالت الايام وكثرت الشهور ، حتي تنتظم له الحالات وتستوي فيه الازمان ؛ نعم ، ثم لا تحكم له بذلك حتي يكون خلقه حالة مقصورة علي محبتك ، ومحتوية عليك وعلي نصيحتك ، بالعلل التي توجب الافعال ، والاسباب التي تسخر القلوب للمودات . فان انت لم تحكم له بالعادة  مع احتمال هذه العلل فيه ، ومع توافيها اليه ، ولم تقض له باقصي النهاية ، مع ترادف هذه الاسباب ، وتكافل هذه الدلاءل ، وتعاون هذه البرهانات ، فكل بينة اذن زور ، وكل دلالة فاسدة . وقد قال الاول : ان دلاءل الامور اشد تثبيتا من شهادات الرجال ، الا ان يكون في البر دليل ومع الشهادة برهان ، لان الدليل لا يكذب ولا ينافق ، ولا يزيد ولا يبدل ، وشهادة الانسان لا تمنع من ذلك ، وليس معها امان من فساد ما كان الامكان قاءما . فان جهلت  اعزك الله  علة غضبك ، فتمثل جهل من لا علة له ؛ وان عجزت عن احتمال عقابك ، فتمثل عجز ما لا يطاق حمله ، ولا عار علي جازع الا فيما يمكن في مثله الصبر ، ولا لوم علي جاهل فيما لا ينجح في مثله الفكر . وليس هذا اول شرك نصبته ، ولا اول كيد ارغته ، وما هي باول دنية غطيتها وسترتها ، وحيلة اكمنتها ورمقتها . وقد كانت التقية احزم ، والاقتضاء اسلم ؛ بل كان العفو ارحم ، والتغافل اكرم . ولا خير في عقوبة تشمت العدو القديم ، ويتنادي بها العدو الحادث . والاناة ابلغ من الحزم ، وابعد من الذم ، واحمد مغبة ، وابعد من مخوف العجلة ، وقد قال الاول : عليك بالاناة فانك علي ايقاع ما انت موقعه اقدر منك علي رد ما اوقعته ، وقد اخطا من قال : من البسيط قد يدرك المتاني بعض حاجته . . . وقد يكون مع المستعجل الزلل بل لو كان قال : المتاني بدرك حاجاته احق ، والمستعجل بفوت حاجاته اخلق ، كان قد وفي المعني حقه ، واعطي اللفظ حظه ، وان كان القول الاول موزونا والثاني منثورا . وليس يصارع الغضب ايام شبابه وغرب نابه شء الا  صرعه ، ولا ينازعه قبل انتهاءه وادباره شء الا قهره ؛ وانما يحتال له قبل هيجه ، ويتوثق منه قبل حركته ، ويتقدم في حسم اسبابه ، وفي قطع حباله ، فاذا تمكن واستفحل واذكي ناره واشتعل ، ثم لاقي ذلك من صاحبه قدرة ، ومن اعوانه سمعا وطاعة ، فلو اسعطه بالتوراة واوجرته بالانجيل ، ولددته بالزبور ، وافرغت علي راسه القران افراغا ، واتيته بادم عليه السلم شفيعا ، لما قصر دون اقصي قوته ، ولتمني ان يعار اصناف قدرته . وقد جاء في الاثر : ان اقرب ما يكون العبد من غضب ربه اذا غضب . وقال قتادة : ليس يسكن غضب العبد الا ذكره غضب الرب . فلا تقف  حفظك الله  بعد مضيك في عتابي التماسا للعفو عني ، ولا تقصر عن افراطك من طريق الرحمة لي ، ولكن قف وقفة من يتهم الغضب علي عقله ، ولاسلطان علي دينه ، ويعلم ان للعقل خصوما ، وللكرم اعداء ؛ وتمسك امساك من لا يبرء نفسه من الهوي ، ولا يبرء الهوي من الخطا ، ولا تنكر لنفسك ان تزل ، ولعقلك ان يهفو ، فقد زل ادم عليه السلم وهفا ، وغره عدوه ، وخدعه خصمه ، وعيب باخلاف عزمه ، وسكون قلبه الي خلاف ثقته ؛ هذا وقد خلقه الله بيده واسكنه في دار امنه ، واسجد له ملاءكته ، ورفع فوق العالمين درجته . فلست اسالك الا ريثما تسكن نفسك ، ويرتد اليك ذهنك ، وتري الحلم وما يجلب من السلامة وطيب الاحدوثة . ان الله ليعلم ، وكفي به عليما ، وليشهد وكفي به شهيدا ، وكفي بجزاء من يعلمه ما لا يعلم جزاء وتعرضا ، وكفي به عند الله بعدا ومقتا . لقد اردت ان افديك بنفسي في بعض كتبي ، وكنت عند نفسي في عداد الموتي وفي حيز الهلكي . فرايت ان من الخيانة لك ، ومن اللءم في معاملتك ، ان افديك بنفس  ميتة وان اريك اني قد جدت لك بانفس علق والعلق معدوم . وانا اقول لك  ابقاك الله  كما قال اخو ثقيف : مودة الاخ التالد وان اخلق خير من مودة الطارف ، وان ظهرت بشاشته وراعتك جدته . سلمك الله وسلم عليك ، وحفظك وكلاك ، وكان لك ومعك . رسالة ابي العلاء احمد بن عبد الله بن سليمان المعري تسمي الاغريضية : السلام عليك ايتها الحكمة المغربية ، ولاالفاظ العربية ، اي هواء رقاك ، واي غيث سقاك ، برقه كالاحريض ، وودقه مثل الاغريض ، حللت الربوة ، وجللت عن الهبوة ، اقول لك ما قال اخو نمير لفتاة بني عمير : من الوافر زكا لك صالح وخلاك ذم . . . وصبحك الايامن والسعود لانا اسف علي قربك من الغراب الحجازي ، علي حسن الزي ، لما اقفر ، وركب السفر ، فقدم جبال الروم في نو ، انزل البرس من الجو ، فالتفت الي عطفه ،  وقد شمط فاسي ، وترك النعيب او نسي ، وهبط الارض فمشي في قيد وتمثل ببيت دريد : من الطويل صبا ما صبا حتي علا الشيب راسه . . . فلما علاه قال للباطل ابعد واراد الاياب في ذلك الجلباب ، فكره الشمات فكمد حتي مات ؛ ورب ولي اغرق في الاكرام ، فوقع في الابرام ، ابرام السام ، لا ابرام السلم . فحرس الله سيدنا حتي تدغم الطاء في الهاء ، فتلك حراسة بغير انتهاء ، وذلك ان هذين ضدان ، وعلي التضاد متباعدان ، رخو وشديد ، وهاو وذو تصعيد ، وهما في الجهر والهمس ، بمنزلة غد وامس . وجعل الله رتبته التي هي كالفاعل والمبتدا ، نظير الفعل في انها لا تنخفض ابدا . فقد جعلني ان حضرت عرف شاني ، وان غبت لم يجهل مكاني ، ك يا في النداء ، والمحذوف من الابتداء ، اذا قلت زيد اقبل ، والابل الابل ، بعدما كنت كهاء الوقف ان الغيت فبواجب ، وان ذكرت فغير لازب ، اني وان عدوت في زمان كثير الدد ، كهاء العدد ، لزمت المذكر فاتت بالمنكر ، مع الف يراني في الاصل ، كالف الوصل ، يذكرني لغير الثناء ، ويطرحني عند الاستغناء ، وحال كالهمزة تبدل العين ، وتجعل بين بين ، وتكون تارة حرف لين ، وتارة مثل الصامت الرصين ، فهي لا تثبت علي طريقه ، ولا تدرك لها صورة علي الحقيقة ، ونواءب الحقت لاصغير بالكبير ، كانها ترخيم التصغير ، وردت المستحلس الي حليس ، وقابوس الي قبيس ، لامد صوتي بتلك  الالاء ، ومد الكوفي صوته في هءلاء ، واخفف عن حضرة سيدنا الرءيس الحبر ، تخفيف المدني ما قدر عليه من النبر ، ان كاتبت فلا ملتمس جواب ، وان اسهبت في الشكر فلا طالب ثواب . حسبي ما لدي من اياديه ، وما غمر من فضل السيد الاكبر ابيه ، ادام الله لهما القدرة ما دام الضرب الاول من الطويل صحيحا ، والمنسرح خفيفا سريحا ، وقبض الله يمين عدوها عن كل معن ، قبض العروض من اول وزن ، وجمع له المهانة الي التقييد ، كما جمعا في ثاني المديد ، وقلم قلم الفسيط ، وخبل كسباعي البسيط ، وعصب الله الشر بهامة شانيهما وهو مخزو ، عصب الوافر الثالث وهو مجزو ، بل اضمرته الارض اضمار ثالث الكامل ، وعداه امل الامل ، وسلم سيدانا  اعز الله نصرهما ،  ومن احباه وقرباه  سلامة متوسط المجموعات ، فانه امن من المروعات ؛ فقد افتننت في نعمها الراءعة ، كافتنان الداءرة الرابعة ، وذلك انها ام ستة موجودين ، وثلاثة مفقودين ، وانا اعد نفسي مراسلة حضرة سيدنا الجليلة ، عدة ثريا الليل ، وثريا سهيل ، هذه القمر ، وتلك عمر ، واعظمه في كل وقت اعظاما في مقة ، وبعض الاعظام في مقت ، فقد نصب للاداب قبة صار الشام فيها كشامة المعيب ، والعراق كعراق الشعيب ، احسب ظلالها من البردين ، واغنت العالم عن الهندين : هند الطيب ، وهند النسيب ، ربة الخمار ، وارباب قمار ، اخذان التجر ، وخدينة الهجر . ما حاملةطوق من الليل ، وبرد من المنتجع مكفوف الذيل ، اوفت الاشاء ، فقالت للكءيب ما شاء ، تسمعه غير مفهوم ، لا بالرمل ولا بالمزموم ، كان سجعها قريض ، ومراسلها الغريض ، فقد ماد لشجوها العود ، وفقيدها لا يعود ، تندب هديلا فات ، واتيح له بعض الافات ، باشوق الي هديلها من  عبده الي مناسمة انباءه ، ولا اوجد علي الفها منه علي زيارة فناءه ، وليس الاشواق ، لذوات الاطواق ، ولا عند الساجعة ، وعبرة متراجعة ، انما رات الشرطين ، قبل البطين ، والرشاء بعد العشاء ، فحكت صوت الماء في الخرير ، واتت براء داءمة التكرير ، فقال جاهل فقدت حميما ، وثكلت ولدا قديما ، وهيهات يا باكية اصبحت فصدحت ، وامسيت فتناسيت ، لا همام لا همام ، ما اريت اعجب من هاتف الحمام سلم فناح وصمت فهو مكسور الجناح انما الشوق لمن يذكر في كل حين ، ولا يذهله مضي السنين . وسيدنا  اطال الله بقاه  القاءل النظم في الذكاء مثل الزهر ، وفي النقاء مثل الجوهر ، وتحسب بادرته التاج ارتفع عن الحجاج ، وغابرته الحجل في الرجل يجمع بين اللفظ القليل ، والمعني الجليل ، جمع الافعوان في لعابه بين القلة وفقد البلة ، خشن ولان فما هان ، لين الشكير يدل علي عتق المحضير ، وحرش الدينار ، اية كرم النجار ، فصنوف الاشعار بعده كالف السلم ، يلفظ بها في الكلام ، ولا تثبت لها هيءة بعد اللام ، خلص من سبك النقد خلوص الذهب من اللهب ، واللجين من يد القين ، كانه لال ، في اعناق حوال ، وسواه لط ، في عنق ثط ، ما خانته قوة الخاطر الامين ، ولا عيب بسناد ولا تضمين ، واين النثرة من  العثرة ، والغرقد من الفرقد ، فالساعي في اثره فارس عصا بصير ، لا فارس عصا قصير ، وانا ثابت علي هذه الطوية ثبات حركة البناء ، مقيم تلك الشهادة بلا استثناء ، غني عن الايمان فلا عدم ، مقيم علي ما قلت فلا حنث ولا ندم ، وانما تخبا الدرة للحسناء الحرة ، ويجاد باليمين ، في العلق الثمين ، ما انفسه خاطرا اقتري الفضة من القضة ، والوصاة من مثل الحصاة ، وربما نزعت الاشباه ، ولم يشبه المرء اباه ، ولا غرو لذلك : الخضرة ام اللهيب ، والخمرة بنت الغربيب . وكذلك سيدنا : ولد من سحر المتقدمين ، حكمة للحنفاء المتدينين . كم له من قافية تبني السود . وتثني الحسود ، كالميت من شرب العاتقة الكميت ، نشوره قريب ، وحسابه تثريب . اين مشبهو الناقة بالفدلمي ، والصحصح برداء الردن ، وجب الرحيل ، عن الربع المحيل . نشا بعدهم واصف ، غودروا له كالمناصف ، اذا سمع الخافض صفته للسهب الفسيح ، والرهب الطليح ، ود ان  حشيته بين الاحناء ، وخلوقه عصيم الهناء ، وحكم بالقود في الرقود ، وصاغ بري ذوات الارسان ، من بري البيض الحسان ، شنفا لدر النحور وعيون الحور ، وشغفا بدر بكي وعين مثل الركي ، واعراضا عن بدور ، سكن في الخدور ، الي حول كاهلة المحول ، فهن اشباه القسي ونعام السي . وان اخذ في نعت الخيل فيا خيبة من سبه الاوابد بالتقييد ، وشبه الحافر بقعب الوليد ، نعتا غبط به الهجين المنسوب ، والبازي اليعسوب ، اذ رزق من الخير ما ليس لكثير من سباع الطير ، وذلك انه علي الصغر سمي بعض الغرر . وقد مضي حرس ، وخفت جرس ، وللقالع ابغض طالع ، والازرق يجنبك عنه الفرق . فالان سلمت الجبهة من المعض ، وشمل بعضها بركات بعض ، فايقن النطيح ان ربه لا يطيح ، والمهقوع نجا راكبه من الوقوع ، فلن يحرب قاءد المغرب ، ولن يرجل ساءس الارجل . والعاب وان لحق الكعاب ، ناكب عن ناقلات  المراكب . وقالت خيفانة امرء القيس الدباءة ، لراعي المباءة ، والاثفية للقدر الكفية ، نقما علي جاعل عدرها كقرون العروس ، وجبهتها كمحذف التروس ، واني للكندي ، قواف كهمجة السعدي : من الوافر اذا اصطكت بضيق حجرتاها . . . تلاقي العسجدية واللطيم فالقسيب في تضاعيف النسيب ، والشباب في ذلك التشبيب ، ليس رويه بمقلوب ، ولكنه من ارواء القلوب . قد جمع اليل ماء الصبا ، وصليل ظماء الظبا ، فالمصراع كوذيلة الغربية ، حكت الزينة والريبة ، وارت الحسناء سناها والسمجة ما عناها . فاما الراح فلو ذكرها لشفت من الهرم ، وانتفت منالكرم الي الكرم ، ولم ترض دنان العقار ، بلباس القار ، ونسيج العناكب علي المناكب ، ولكن تكسي من وشي ثيابا ، ويجعل طلاءها زريابا . ولقد سمعته ذكر خيمة يغبط المسك ان يكون جارها من الشيام ، ويود الاخبية انه سعد الخيام .  ووقفت علي مختصر اصلاح المنطق الذي كاد بسمات الابواب ، يغني عن ساءر الكتاب ، فعجبت كل العجب من تقييد الاجمال بطلاء الاحمال ، وقلب البحر الي قلت النحر ، واجراء الفرات ، في مثل الاخرات ، شرفا له تصنيفا شفي الريب ، وكفي من ابن قريب ، ودل علي جوامع اللغة بالايماء ، كما دل المضمر علي ما طال من الاسماء ، اقول في الاخبار ، امرت ابا عبد الجبار ، فاذا اضمرته عرف متي قلت امرته ، وابل من المرض والتمريض ، بما اسقط من شهود القريض ، كانهم في تلك الحال ، شهدوا بالمحال ، عند قاض عرف امانتهم بالانتقاض علي حق علمه بالعيان ، فاستغني فيه عن كل بيان . وقد تاملت شواهد اصلاح المنطق فوجدتها عشرة انواع ، في عدة اخوة الصديق ، لما تظاهروا علي غير التحقيق ، وتزيد علي العشرة بواحد ، كاخ ليوسف لم يكن بالشاهد . والشعر الاول ، وان كان سبب الاثرة ، وصحيفة الماثرة فانه كذوب القالة نموم الاطالة ، وان قفا نبك علي حسنها وقدم سنها ، لتقر بما يبطل شهادة القول الرضي ، فكيف بالبغي الانثي ؟ قاتلها الله عجوزا لو كانت بشرية ، كانت من اغوي البرية . وقد تمادي بابي يوسف  رحمه الله  الاجتهاد ، في اقامة الاشهاد ، حتي انشد رجزا لضب ، وان معدا من ذلك لجد مغضب . اعلي فصاحته يستعان  بالقرض ، ويستشهد باحناش الارض ؟ ما رءبة عنده في نفير ، فما قولك في ضب دامي الاظافير ؟ ومن نظر في كتاب يعقوب وجده كالمهمل ، الا باب ، فعل وفعل ، وفانه مءلف علي عشرين حرفا : ستة مذلقة ، وثلاثة مطبقة ، واربعة من الحروف الشديدة ، وواحد من المزيدة ، ونفيثين : التاء والذال ، واخر متعال ، والاختين العين والحاء ، والشين مضافة الي حيز الراء ، فرحم الله ابا يوسف لو عاش لفاظ كمدا ، او احفاظ حسدا ، سبق ابن السكيت ثم صار كالسكيت ، وسمق ثم حار وتدا للبيت ، كان الكتاب تبرا في تراب معدن ، بين الحث والمتدن ، فاستخرجه سيدنا واستوشاه ، وصقله فكره ووشاه ، فغبطه النيرات علي الترقيش ، والال النقيش ، فهو محبوب ليس بهين ، علي انه ذو وجهين ، وما من قط ولا هم ، ولا نطق ولا ارم . قد ناب في كلام العرب الصميم ، مناب مراة المنجم في علم التنجيم ، شخصها ضءيل ملموم ، وفيها القمران والنجوم . واقول بعد في اعادة اللفظ : ان حكم التاليف في ذكر الكلمة مرتين كالجمع في النكاح بين اختين ، الاولي حل يرام ، والثانية بسل حرام . كيف يكون في  الهودج لميسان ، وفي الجمعة خميسان ؟ يا ام الفتيات ، حسبك من الهنود ، ويا ابا الفتيان شرعك من السعود ، عليك انت بزينب ودعد ، وسم ايها الرجل بسوي سعد ، ما قل اثير ، والاسماء كثير . مثل يعقوب مثل خود كثيرة الحلي ، ضاعفته علي التراق ، وعطلت الخصر والساق . كان يوم قدوم تلك النسخة يوم ضريب ، حشر الوحوش مع الانس ، واضاف الجنس الي غير الجنس ، ولم يحكم علي الظباء بالسباء ، ولا رمي الاجال بالاوجال ، ولكن الاضداد تجتمع فتسمع ، وتنصرف باللذات اذاة . وان عبده موسي لقيني نقابا ، فقال هلم كتابا ، يكون لك شرفا ، وبموالاتك في حضرة سيدنا معترفا ، فتلوت عليه هاتين الايتين ان لك الا تجوع فيها ولا تعري وانك لا تظما فيها ولا تضحي واحسبه راي نور السءدد فقال لمخلفيه ، ما قال موسي صلي الله عليه لاهليه اني انست نارا لعلي اتيكم منها بقبس او اجد علي النار هدي . قليت شعري ما يطلب ، اقبس ذهب ام قبس لهب ؟ بل يتشرف بالاخلاق الباهرة ويتبرك بالاحساب الطاهرة : من البسيط باتت حواطب ليلي يقتبسن لها . . . جزل الجذا غير خوار ولا دعر وقد اب من سفرته الاولي ومعه جذوة من نار قديمة ان لمست فنار ابراهيم ،  وان اونست فنار الكليم ؛ واجتني بهارا حبت به المرازبة كسري ، وحمل في فكاك الاسري ، وادرك نوحا مع القوم ، وبقي غضا الي اليوم ، وما انتجع موسي الا الروض العميم ، ولا اتبع الا اصدق مغيم . وورد عبده الزهيري من حضرته المطهرة كانه زهرة نقيع ، او وردة ربيع ، كثيرة الورق ، طيبة العرق ، ليس هو في نعمته كالريم ، في ظلال الصريم ، والجاب في السحاب المنجاب ، لان الظلام يسفر والغمام ينسفر ، ولكنه مثل النون في اللجة ، والاعفر تحت جربة . وقد كنت عرفت سيدنا فيما سلف ان الادب كعهود في اثر عهود ، اروت النجاد فما ظنك بالوهود ؟ واني نزلت من ذلك الغيث ببلد طسم كاثر الوسم ، منعه القراع من الامراع ، يا بوس بني سدوس ، العدو حازب ، والكلا عازب ؛ يا خصب بني عبد المدان ، ضان في الحربث وضان في السعدان ، فلما رايت ذلك اتعبت الاظل ، فلم اجد الا الحنظل ، فليس في اللبيد الا الهبيد ، جنيته من شجرة اجتثت من فوق الارض ما لها من قرار ؛ لبن الابل عن المرار مر ، وعن الاراك طيب حر .  هذا مثلي في الادب ، فاما في النشب ، فلم يزل لي بحمد الله وبقاء سيدنا بلغتان : بلغة صبر وبلغة وفر ، انا منهما بين الليلة المرعية ، واللقوح الربعية هذه عام ، وتلك مال وطعام ، والقليل سلم الي الجليل ، كالمصلي يريغ الضوء باسباغ الوضوء ، والتكفير بادامة التعفير ، وقاصد بيت الله يغسل الحوب بطول الشحوب . وانا في مكاتبة سيدنا الجليلة ، والميل عن حضرة سيدنا الاجل والده  اعز الله نصره  كسبا بن يعرب لما ابتهل في التقرب الي خالق النور ومصرف الامور ، نظر فلم ير اشرف من الشمس يدا ، فسجد لها تعبدا ، وغير ملوم سيدنا لو اعرض عن شقاءق النعمان الربعية ، ومداءحه اليربوعية ، مللا عن اهل البلد المضاف الي هذا الاسم ، فغير معتذر ، من ابغض لاجلهم بني المنذر ، وهم الي حضرته السنية رجلان : ساءل وقاءل ، فاما الساءل فالح ، واما القاءل فغير مستملح ، وقد سترت نفسي عنها ستر الخميص بالقميص ، واخي الحتر بسجوف الستر ، فظهر بي فضله الذي مثله مثل الصبح اذا تصرف الحيوان في شءونه ، فخرج من بيته اليربوع ، وبرز عن الملك من اجل الربوع . وقد يولع الهجرس بان يجرس في البلد الجرد قدام اسد ورد ، واني خبرت ان تلك الرسالة الاولي عرضت بالموطن الكريم ، فاوجب ذلك رحيل اختها ، متعرضة لمثل بختها ، وكيف لا تنفع ، وفي اليم تقع ؟ وهي بمقصد سيدنا فاخرة ، ولو نهيت الاولي لانتهت الاخرة .  ومن رساءل ابي الفضل احمد بن الحسين الهمذاني المعروف ببديع الزمان المسماة بالمقامات : حدثنا عيسي بن هشام قال : كنت وانا في عنفوان سني ، اشد رحلي لكل عماية ، واركض طرفي الي كل غاية ، حتي شربت العمر ساءغه ، ولبست للدهر سابغه . فلما صاح النهار بجانب ليل ، وجمعت للمعاد ذيلي ، وطءت ظهر المروضة ، لاداء المفروضة ، وصحبني في الطريق رفيق ما انكره من سوء . فلما تجالينا ، خبرنا بحالينا ، اسفرت القصة عن اصل كوفي ، ومذهب صوفي . وسرنا فلما حللنا المدينة ملنا الي دارة ودخلناها ، وقد بقل وجه النهار واخضر جانبه ، فلما اغتمض جفن الليل وطر شاربه ، قرع علينا الباب ، فقلنا من القارع المنتاب ؟ فقال : وفد الليل وبريده ، وفل الجوع وطريده ، وحر قاده الضر والزمن المر ، وضيف وطءه خفيف ، وضالته رغيف ، وجار يستعدي علي الجوع ، والجيب المرقوع ، وغريب اوقدت النار في اثره ، وانبح العواء علي سفره ، ونبذت خلفه الحصاة ، وكنست بعده العرصات ، نضوه طليح ،  وعيشه تبريح ، ومن دون فرخيه مهامه فيح . قال عيسي بن هشام : فقبضت من كيسي قبضة الليث ، وبعثت بها اليه ، وقلت : زدنا سءالا ، نزدك نوالا . فقال : ما عرض عن العود علي احر من نار الجود ، ولا لقي وفد البر باحسن من بريد الشكر ، ومن ملك الفضل فليواس ، فلن يذهب العرف بين الله والناس . واما انت فحقق الله امالك ، وجعل اليد العليا لك . قال عيسي بن هشام : ففتحنا له الباب وقلنا له ادخل فدخل ، فاذا هو والله شيخنا ابو الفتح الاسكندري . فقلت : يا ابا الفتح شد ما بلغت بك الخصاصة ، وهذا الزي خاصة . فتبسم ثم انشا يقول : من مجزوء الخفيف لايغرنك الذي . . . انا فيه من الطلب انا في ثروة يشق . . . ق لها برده الطرب انا لو شءت لاتخذ . . . ت شنوفا من الذهب ومما انشاه عبد الله ابو القاسم ابن محمد الخوارزمي وسماه الرحل : وصية لكل لبيب ، متيقظ اريب ، عالم اديب ، يكره مواقف السقطات ، ويتحفظ من مصادف الغلطات ، ويتلطف من مخزيات الفرطات ، ان يدعي  دون مقامه ، ويقتصر من تمامه ، ويغض من سهامه ، ويظهر بعض شكيمته ، ويساوم بايسر قيمته ، ويستر كثيرا من بضاعته ، ويكتم دقيق صناعته ، ولا يبلغ غاية استطاعته ، وان يعاشر الناس باصدق المناصحة ، وجميل المسامحة ، وان لا يحمله الاعجاب بما يحسنه ، علي الازدراء بمن يستقرنه ، والافتراء علي من يعترضه ويلسنه ، ليكون خبره اكثر من خبره ، ونظرته اروع من منظره ، ويكون اقرب من الاعذار ، وابعد من الخجلة والانكسار : من الطويل فليس الفتي من قال اني انا الفتي . . . ولكنه من قيل انت كذلكا ومن مدع ملكا بغير شهادة . . . له خجلة ان قيل ان لست مالكا ولقد نصرت بالاتضاع ، علي ذي نباهة وارتفاع ، وذلك اني اصعدت في بعض الايام ، مع جماعة من العوام ، بين ناجر وزاءر وثاجر وتامر الي الغري والحاءر ، حتي انتهينا الي قرية شارعة ، اهلة زارعة ، وما منا الا من املته السميرية فاغرضته ، واسقمته فامرضته ، وفترته فقبضته ، فكثر منا الجءار ، واستولي علينا الدوار ، فخرجنا منها خروج المسجون ، وقد تقوسنا تقويس العرجون ، فاسترحنا بالصعود ، من طول القعود : من الرجز كاننا الطير من الاقفاص . . . ناجية من احبل القناص طيبة الانفس بالخلاص . . . منفضات الريش والعناصي فما استتمت الراحة ، ولا استقرت بنا الساحة ، حتي وقف علينا واقف وهتف بنا هاتف : ايكم ابن الخوارزمي ؟ فقالوا له : ذلك الغلام المنفرد ،  والشاب المستند ، فاقبل الي وسلم علي وقال : ان الناظر يستزيرك ، فليعجل اليه مصيرك . فقمت معه ، يتقدمني واتبعه ، حتي انتهي الي جلة من الرجال ، ذوي بهاء وجلال ، وزينة وكمال ، من اشراف الامصار ، واعيان ذوي الاخطارن من اهل واسط وبغداد ، والبصرة والسواد : من الطويل تري كل مرهوب العمامة لاثها . . . علي وجه بدر تحته قلب ضيغم فقام الي ذو المعرفة لاكرامه ، وساعده الباقون علي قيامه ، واطال في سءاله وسلامه ، وجذبوني الي صدر المجلس فابيت ، ولزمت ذناباه ، واحتبيت ، واخذوا يستخبرونني عن الحال ، والمعيشة والمال ، وداعية الارتحال ، وعن النية والمقصد ، والاهل والولد ، والجيران والبلد : من الطويل وما منهم الا حفي مساءل . . . وواصف اشواق ومثن بصالح ومستشفع في ان اقيم لياليا . . . اروح واغدو عنده غير بارح ثم قال اءلهم : هل لقيت عين الزمان وقلبه ، ومالك الفضل وربه ، وقليب الادب وغربه ، وامام العراق ، وشمس الافاق ؟ فقلت : ومن صاحب هذه الصفة المهولة ، والكناية المجهولة ؟ فقالوا : او ما سمعت بكامل هيت ، ذي الصوت والصيت ؟ من السريع ذاك الذي لو عاش قس الي . . . زمانه ذا وابن صوحان وابن دريد وابو حاتم . . . وسيبويه وابن سعدان وعامر الشعبي وابن العلا . . . وابن كريز وابن صفوان قالوا فخارا كلهم انه . . . سيدنا اذ قال غلماني فقلت لهم : قلدتم المة ، وهيجتم الحنة ، الي لقاء هذا العالم المذكور ، والسيد المشهور ، وقد كانت الرياح تاتيني بنفحات هذا الطيب ، وهدر هذا الخطيب ،  فالان لا اثر بعد عين ، ساصبح لاجله عن سري القين ، اغتناما للفاءدة ، والنعمة الباردة ، ووجدانا للضالة الشاردة : من الخفيف اين امضي وما الذي انا ابغي . . . بعد ادراكي المني والطلابا فاذا ما وجدت عندكم العل . . . م قريبا فما اريد الثوابا اذهبوا انتم فزوروا عليا . . . لازور الهيتي والادابا لن ابالي ان قيل ان الخوارز . . . مي اخطا في فعله او اصابا فقالت الجماعة : بل اصبت ، ووجدت ما طلبت ، وقديما كنا ننشر اعلاقك ، ونتمني اتفاقك ، ونتداول اوصافك ، ونحب مضافك ، ونكثر لديه ذكرك ، ونعظم لديه قدرك ، فيتحرك منه ساكنه ، ويتقلقل بك اماكنه ، ونسال الله سبحانه ان يجمع بينك وبينه بمحضرنا ، وتلامح عينك عينه بمنظرنا ، فيلتف غبارك بغباره ، ويمتزج بتياره ، ويختلط مضمارك بمضماره ، فنعرف منكما السابق والسكيت ، والوذانق والكعيت ، ويتبين من الذي يحوي القصب ، ومن يشتكي العصب ، فانكما قال الشاعر : من الوافر هما رمحان خطيان كانا . . . من السمر المثقفة الصعاد تهال الارض ان يطا عليها . . . بمثلها نسالم او نعادي فقلت : لقد تنكبتم الانصاف ، واخطاتم الاعتراف ، وابعدتم القياس ، واوقعتم الالتباس ، اين ابن ثلاثين الي ابن ثمانين ، وابن ابن اللبون من البازل الامون ؟ والمهر الرازح ، من الجواد القارح ، والكودن المبروض ، من المجرب المروض ؟ من البسيط  وابن اللبون اذا ما لز في قرن . . . لم يستطع صولة البزل القناعيس كيف لربيب بطاءح وسباخ ، وساكن صراءف واكواخ ، بين سوادية انباط ، وعلوج اشراط ، ورعاع اخلاط ، وسفل سقاط ، في بلدة ان جاوزت سورها ، وعبرت جسورها ، صحت واغربتا ! وان رايت وجها غريبا ناديت وا ابتاه ، لا اعرف غير النبطية كلاما ، ولا القي سوي والدي اماما ، في معشر ما عرفوا الترحال ، ولا ركبوا السروج والرحال ، ولا فارقوا الجدار والظلال والاطلال : من الوافر اولءك معشر كبنات نعش . . . خوالف لا تغور مع النجوم بمصاولة رجل جوال ، رحال حلال ، بهيت وضع ، وبالكوفة ارضع ، وببغداد اثغر ، وبواسط اجفر ، وبالحجاز وتهامة فطامه ، وبمصر والمغرب كان احتلامه ، وبنجد والشام بقل عارضه ، واشتدت عوارضه ، وباليمن وعمان ويت نواهضه ، وبخراسان بلغ اشده ، وببخاري وسمرقند تناهي جده ، وبغزنة والهند شاب واكتهل ، ومن سيحون وجيجون عل ونهل ، وبميسان والبصرة عود وقرح ، وبالجبال جله وجلح ، فهو يعد المازني امامه ، وابن جني غلامه ، والمتنبي من رواته ، والمعري حامل دواته ، والصابي باري قلمه ، ولاصاحب رافع علمه ، وبني مقلة ناقلي غاشيته ، وبني ابي حفصة بعض حاشيته ، وقد قرا الكتب وتلاها ، وحفظ العلوم ورواها ، ودرس الاداب ووعاها ، ودون الدواوين والفها ، وانشا الحكم وصنفها ، وفصل المشكلات وشرحها ، وارتجل الخطب ونقحها ، فهو البحر المورود ، والامام المقصود ، والعلم المصمود ، هذا بون بعيد ، ومرتقي شديد : من المتقارب اتلقون بالاعزل الرامحا . . . وبالاكشف الحاسر الدارعا  وبالكودن لاسابق السبحا . . . وبالمنجل الصارم القاطعا فما استتم كلامنا حت مثل ، فاذا نحن به قد طلع مهرولا ، واقبل مستعجلا ، فرايت رجلا اجلح ، اهتم اقلح افطح اروح ، طويلا عنطنط ، يحكي ذءبا امعط ، اخمع اخبط ، فتلقوه معظمين ، وله مفخمين ، فقصد في المجلس صدره ، واسند الي المخدة ظهره . فما استقر به المكان ، حتي قيل له : هذا فلان ، فقبض من انفه ، ونظر الي بشطر من طرفه ، وقال ببعض فيه ، هلموا ما كنتم فيه ، تعسا للشوهاء وجالبيها ، والقرعاء وقالبيها : من المنسرح جاء دريد مجررا رسنه . . . فحل فلا تمنعنه سننه احبه قومه علي شوه . . . ان القرنبي لامها حسنه فقال : كان لنا شيخ بالانبار ، كثير الاخبار ، قد بلغ من العمر املاه ، ومن السن اعلاه ، قرات عليه جميع الكتاب ، وعلم الانساب ، وادب الكتاب ، وشعر الاعراب ، ومعاني الزجاج ، ومساءل ابن السراج ، وديوان العجاج ، وكتاب الاصلاح ، وشروح الايضاح ، وشعر الطرماح ، والعين للفرهودي ، والجمهرة للازدي ، واكثر من المصنفات المجهولات والمعروفات . ينفخ في شقاشقه ، ويزيد في بقابقه ، ويتعاظم في مخارقه . وجعل لاقوم يقسمون بيننا الالحاظ ، ويحسنون الالفاظ ، وما منهم الا من اغتاظ ، لسكوتي وكلامه ، وتاخري واقدامه ، ثم هذي الشيخ اذ وصف له رجل علي الغيب ثم راه ، فاحتقره وازدراه ، وانشد متمثلا : من الوافر لعمر ابيك تسمع بالمعيدي . . . بعيد الدار خير ان تراه وقال : هذا المعيدي هو ضمرة بن جابر بن قطن بن نهشل بن دارم بن  مالك بن حنظلة بن مالك بن زيد مناة بن تميم بن مرة بن اد بن طابخة بن الياس ابن مضر بن نزار بن معد بن عدنان ، والمعيدي تصغير معدي وهو الذي قالت فيه نادبته : من الراجز انعي الكريم النهشلي المصطفي . . . اكرم من خندف او تخندقا فقلت : ما بعد هذا المقال ، وجه للاحتمال ، وما يجب لي بعد هذه المواقحة ، غير المكافحة ، ولم يبق بعد المكاذبة من مراقبة : من الرجز ما علتي وانا جلد نابل . . . والقوس فيه وتر عنابل ترن من تحريكها المعابل ما علتي وانا جلد جلد . . . والقوس فيه وتر عرد مثل ضراع البكر او اشد فعطفت عليه عطفة الثاءر العاسف ، والتفت اليه التفاتة الطاءر الخاءف ، فقلت له : يا اخا هيت ، قد قلت ماشيت ، فاجب الان اذ دعيت ، والزم مكانك ، وغض عنانك ، وقصر لسانك : ان نادبة ضمرة خندفته ، لما وصفته ، وما سمعت في نسبتك اياه لخندف ذكرا ، فابن عن ذلك عذرا ، فقال : ان خندف هي امراة الياس بن مضر غلبت علي بنيها فنسبوا الياه كطهية ومزينة ، وبلعدوية وعرينة ، والسلكة وجهينة ، وندبة واذينة ، وكشبيب بن البرصاء وبلعرجاء ، فقلت : سءلت فاجبت ، وقلت فاصبت ، فاخبرني عن خندف ، هل هو اسم موضوع ، او لقب مصنوع ؟ فوقف عند ذلك حماره ، وخمدت ناره ، وركد جريانه ، وسكن هذيانه ، وقر غليانه ، وظهر حرانه ، وذل وانقمع ، ونطوي واجتمع ، فاضطره الحياء ، والجاه الاستحذاء ، الي ان قال وهو يخفي لفظه ، ويطرق لحظه ، اظنه لقبا . فقلت : هو كما ظننت فما معناه وما سببه ؟ وكيف كان موجبه ؟ ولم يجد بدا من ان يقول : لا ادري ؛ فقال وقد اذقته مر الاماتة ،  واحس من القوم بتظاهر الشماتة : من الطويل وو بجدع الانف لو ان صحبه . . . تنادوا وقالوا في المتاح له قم ثم اقبلوا الي ، وانعكفوا علي ، باوجه متهللة ، والسن متوسلة ، في شرح الحال ، والقيام بجواب السءال ، فقلت : هذا بديع عجيب ، انا اسال وانا اجيب ؟ ان الياس بن مضر تزوج ليلي ابنة تغلب بن حلوان بن الحاف بن قضاعة بن معد في بعض النسب فولد له منها عمرو وعامر وعمير ، ففقدهم ذات يوم فانحي علي ليلي باللوم ، فقال : اخرجي فياثرهم ، واتيني بخبرهم . فمضت في طلبهم ، وعادت بهم ، فقالت : ما زلت اخندف في ابتغاءهم ، حتي ظفرت بلقاءهم . فقل لها الياس : انت خندف ، والخندفة في الاتباع ، تقارب خطو في اسراع . وقال عمرو : يا ابه ، انا ادركت الصيد فلويته ، فقال له : انت مدركة اذ حويته . وقال عامر : انا طبخته وشويته ، فقال له : انت شابخة اذ شويته ، فقال عمير : وانا انقمعت في الخباء ، فقال له : فانت قمعة للاحتباء . فلصقت بها وبهم هذه الالقاب ، وجرت بها اليهم الانساب . فقال حينءذ : هذا علم استفدته ، وفضل استزدته ، وقد قال الحكيم : مذامرة ذوي الالباب ، نماء الاداب . فقلت له متمثلا : من الطويل اقول له والرمح ياكر متنه . . . تامل خفاقا انني انا ذلكا ثم لم يحتبس الا قليلا ، ولم يمتسك طويلا ، ولم ير من راي فتيلا ، حتي عاد الي هديره ، واخذ في تهذيره ، طمعا ان ياخذ بالثار ، ويعود الفص له في القمار ، فعدل عن العلوم النسبية ، وجال في ميدان العربية ، ولم يحس ان باعه فيها اقصر ، وطرفه دون حقاءقها احسر ، فقال : حضرت يوما حلبة من حلبات العلوم ، وموسما من مواسم المنصور والمنظوم ، وقد غص بكل خطيب مصقع ، وحكيم مقنع ، وعالم مصدع ، وملء من كل عتيق صهال ، وفنيق صوال ،  ومنطيق جوال ؛ فاخذوا في فنون المعارضات ، وصنوف المناقضات ، وسلكوا في معاني القريض ، كل طويل وعريض ، حتي اذا اخذ الساءل منهم بالمخنق ، ببيت الفرزدق : من الطويل وعض زمان يا ابن مروان لم يدع . . . من المال الا مسحتا او مجلف ثم لم يحتبس فيه الا قليلا ، فكثر فيه الجدال ، وطال المقال ، وما منهم احد اجاد القياس ، واصاب القرطاس ، ووقع علي الطريق ، واتي بالتحقيق . فلما رايتهم وهم في غمرتهم ساهون ، وفي ضلالتهم يعمهون ، ناديتهم الي فارعوا ، ومني فاستمعوا ، فاني ابن بجدية ، وعالم ما تحت جلدته ، ثم اني ابديت لهم اسراره ، واثقبت ناره ، وحللت عقده ، ومخضت زبده ، واطرت لبده ، وبجست حجره ، وابثثتهم عجره وبجره . فقالوا : لله ابوك ، فانك اسبقنا الي غاية ، واكشفنا لغيابه ، واجلانا لشبهة ، واضوانا في بدهة ، وما اعلم اليوم علي ظهرها من يقوم لعلم ما فيه ، ويطلع علي خافية . فاذكرني الامتعاض ، واخذني النتفاض ، فانشدته : من البسيط من ظن ان عقول الناس ناقصة . . . وعقله زاءد ازري به الطمع ثم قلت له : ادعيت فوق ما وعيت ، فاخبرني عن اول هذا البيت : يا مجري الكميت ، وكيف تنشده وعض بالفتح اووعض بالضم ؟ فقال : كلاهما مروي ، فقلت : تبتدء بالفعل ثم تعود الي الاسم يا ذا الاعجاب ، تهيا للساءل في الجواب ، واخبرني : لم فتحت اخر الماضي ؟ فاسرع من غير التغاضي فقال : لانه مبني عليه ، لا يضاف سواه اليه . فقلت : هذا الجواب نعمله ، ومن صبيان المكتب لانعدمه ، وانما التمس منك الفاءدة فيها ، واطلب كشف خافيها . فقال : ما جاء عن اءمة النحاة ، وساءر الرواة ، في هذا غير ما شرحته ، ولا زادوا علي ما اوضحته . فقلت : دع عنك هذا ، واخبرني عن هذا البناء : العلة ام لغيرها ؟ فاقبل يتردد ويتزحزح ، ويتثاءب تارة ويتنحنح ، فلما سد عليه من طريقه ، وحصل في مضيقه ، وغص بريقه ، قال : لا اعلم . فقالت الجماعة :  اعذر اليك من القي سلاحه ، وغض جماحه ، ومن ادبر بعد اقباله ، عدل عن قتاله : من الكامل والحق ابلج لا يخيل سبيله . . . والحق يعرفه ذوو الالباب والان فقد فازت قداحك ، وبانت غررك واوضاحك ، واجدت المصال ، وادركت الخصال ، فاوضح لنا عما سالت ، وارشدنا الي ما دللت لءلا يقال : هذا بهت ، ومحال بحت . فقلت : حبا وكرامة ، اسمع انت يا طغامة : ان الفعل من فاعله ، كالوليد من ناجله ، لا يخلو الفعل من علامة فاعل ، في لفظ كل قاءل ، وهي الفتح من ماضيه وواقعه ، والزواءد في مستقبله ومضارعه ، وبيان ذلك ان الفتحة من ماضيه ، لا تكون مع التاء والنون ، فنقول : اخرج فتثبت الفتحة ، ثم تقول اخرجت واخرجننا فيسقط ما ذكرنا ، وعلامتان لمعني محال ، لا يوجبهما الحال ، فان كانت النون التي مع الالف ضمير المفعول ، عادت الفتحة فتقول : اخرجنا الامير ، فهذا بين منير . فصفقت الجماعة وشمخت ، وحسنت وبخبخت ، وجعل الاديب يضطرب اضطراب العصفور ، ويتقلب تقلب المصغور ، متيقنا ان اسده صار تغير قصبا ، وان مستقيمه ، وجيده تبهرج ، وصحيحه تدحرج ، وحديده تكرج ، فقال منشدهم : من الوافر تري الرجل النحيف فتزدريه . . . وتحت ثيابه اسد مزير ويعجبك الطرير فتبتليه . . . فيخلف ظنك الرجل الطرير فما عظم الرجال لهم بفخر . . . ولكن فخرهم كرم وخير فاخذه الابلاس ، وضاقت به الانفاس ، وسكنت منه الحواس ، ورفضه الناس ، وجعل ينكت الارض ، ويواصل لكفه العض ، ويتشاءم بيومه ، ويعود علي نفسه  بلومه ، يمسح جبينه ، ويكثر انينه . فقمت فقامت معي الجماعة وتركته ، واستهانت به وفركته ، فلما بقي وحده ، تمني لحده ، واسبل دمعته ، وود ان الارض بلعته : من الطويل وكان كمثل البو ما بين روم . . . يلوذ بحقويه السراة الاكابر فاصبح مثل الاجرب الجلد مفردا . . . طريدا فما تدنو اليه الاباعر فقام فتبعني ، ووقف وودعني ، واطال الاعتذار ، واظهر التوبة والاستغفار ، وقال : مثلك من سد الخلل ، واقال العثرة والزلل ، فقد اغتررت من سنك بالحداثة ، ومن زيك بالرثاثة ، ومن اخلاقك بالدماثة . فقلت : كل ذلك مفهوم معلوم ، وانت فيه معذور لا ملوم ، وما جري بيننا منسي غير مذكور ، ومطوي غير منشور ، ومخفي غير مشهور : من الكامل وجدال اهل العلم ليس بقادح . . . ما بين غالبهم الي المغلوب ثم سكت فما اعاد ، ونزلت وعاد ، وكان ذلك اول عهد به واخره ، وباطن لقاء وظاهره ، وكل اجتماع وساءره . وبعد ذلك شعر الغيت ذكره . ومما انشاه ابو محمد القاسم بن علي الحريري من مقاماته : حكي الحارث بن همام قال : ملت في ريق زماني الذي غبر ، الي مجاورة اهل الوبر ، لاخذ اخذ نفوسهم والسنتهم العربية ، فشمرت تشمير من لا يالو جهدا ، وجعلت اضرب في الارض غورا ونجدا ، الي ان اقتنيت هجمة من  الراغية ، وثلة من الثاغية ، ثم اويت الي عرب ارداف اقيال ، وابناء اقوال ، فاوطنوني امنع جناب ، وفلوا عني حد كل ناب ، فما تاوبني عندهم هم ، ولا قرع صفاتي سهم ، الي ان اضللت في ليلة منيرة البدر لقحة غزيرة الدر ، فلم اطب نفسا بالغاء طلبها ، والقاء حبلها علي غاربها ، فتدثرت فرسا محضارا ، واعتقلت لدنا خطارا ، وسريت ليلتي جمعاء اجوب البيداء ، واقتري كل شجراء ومرداء ، الي ان نشر الصبح راياته ، وحيعل الداعي الي صلاته ، فنزلت عن متن الركوبة لاداء المكتوبة . ثم جلت في صهوتها ، وفررت عن شحوتها ، وسرت لا اري اثرا الا قفوته ، ولا نشزا الا علوته ، ولا واديا الا جزعته ، ولا راكبا الا استطلعته ، وجدي مع ذلك يذهب هدرا ، ولا يجد ورده صدرا ، الي ان حانت صكة عمي ، ولفح هجير يذهل غيلان عن مي ، وكان يوما اطول من ظل القناة ، واحر من دمع المقلات ، فايقنت اني ان لم استكن من الوقدة واستجم بالرقدة ، ادنفني اللغوب ، وعلقت بي شعوب ، فعجت الي سرحة كثيفة الاغصان وريقة الافنان ، لاغور تحتها الي المغيربان . فوالله ما استروح نفسي ، ولا استراح فرسي ، حتي نظرت الي سانح في هيءة ساءح ، وهو ينتجع نجعتي ويشتد الي بقعتي ، فكرهت انعياجه الي معاجي ، واستعذت بالله من شر كل مفاجي . ثم ترجيت ان يتصدي منشدا ، او يتبدي مرشدا ، فلما اقترب من  سرحتي وكاد يحل بساحتي ، الفيته شيخان السروجي متشحا بجرابه ، ومضطغنا اهبة تجوابه ، فانسني اذ ورد ، وانساني ما شرد ، ثم استوضحته من اين اثره ، وكيف عجره وبجره ، فانشد بديها ، ولم يقل ايها : من الخفيف قل لمستطلع دخيلة امري . . . لك عندي كرامة وعزازه وهي ابيات تركت اثباتها هاهنا حتي لا اكدر صفاء بلاغته في منثورة بتقصيره في منظومه . قال : ثم رفع الي طرفه ، فقال : لامر ما جدع قصير انفه . فاخبرته خبر ناقتي السارحة ، وما عانيته في يومي والبارحة ، فقال : دع الالتفات الي ما فات ، والطماح الي ما طاح ولا تاس علي ما ذهب ، ولو انه واد من ذهب ، ولا تستمل من مال عن ريحك ، واضرم نار تباريحك ، ولو كان ابن بوحك او شقيق روحك ، ثم قال : هل لك في ان تقيل ، وتتحامي القال والقيل ؟ فان الابدان انضاء تعب ، والهاجرة ذات لهب ، ولن يصقل الخاطر ، وينشط الفاتر ، كقاءلة الهواجر ، وخصوصا في شهري ناجر ، فقلت ، : ذاك اليك ، وما اريد ان اشق عليك . فاقترش الترب واضطجع ، واظر ان قد هجع ، وارتفقت علي ان احرس ولا انعس ، فاخذتني السنة حين زمت الالسنة ، فلم افق الا والليل قد تولج ، والنجم قد تبلج ، ولا السروجي ولا المسرج . فبت بليلة نابغية ، واحزان يعقوبية ، اساور الوجوم ، واساهر النجوم ، تارة افكر في رجلتي ، واخري في رجعتي ، الي ان وضح لي عند افترار ثغر الضو ، في وجه الجو ، راكب يخد في الدو ؛ فالمعت اليه بثوبي ، رجاء ان يعرج الي صوبي ، فلم يعبا بالماعي ، ولا اوي لالتياعي ، بل سار علي هينته ، واصماني بسهم اهانته ، فاوفضت اليه لاستردفه ، واحتمال تغطرفه ، فلما ادركته بعد الاين ، واجلت فيه مسرح العين ، وجدت ناقتي مطيته ، وضالتي لقطته ، فما  كذبت ان اذريته عن سنامها ، وجاذبته طرف زمامها ، فقلت له : انا صاحبها ومضلها ، ولي رسلها ونسلها ، فلا تكن كاشعب ، فتتعب وتتعب . فجعل يلدغ ويصي ، ويتقح ولا يستحي ، وبينا هو ينزو ويلين ، ويستاسد ويستكين ، غذ غشينا ابو زيد لابسا جلد النمر ، وهاجما هجوم السيل المنهمر ، فخفت والله ان يكون يومه كامسه ، وبدره مثل شمسه ، فالحق بالقارظين ، واصير خبرا بعد عين . فلم ار الا ان اذكرته مودته المنسية ، وفعلته الامسية ، وناشدته الله اوافي للتلافي ، ام لما فيه اتلافي ، فقال : معاذ الله ان اجهز علي مكلومي ، واصل حروري بسمومي ، وانما وافيتك لاخبر كنه حالك ، واكون يمينا لشمالك . فسكن عند ذلك جاشي ، وانجاب استيحاشي ، فاطلعته طلع اللقحة ، وتبرقع صاحبي بالقحة ، فنظر اليه نظر ليث العريسة الي الفريسة ، ثم اشرع قبله الرمح ، واقسم له بمن انار الصبح ، لءن لم ينج منجي الذباب ، ويقنع من الغنيمة بالاياب ، ليوردن سنانه وريده ، وليفجعن به وليده ووديده . فنبذ زمام الناقة وحاص ، وافلت وله حصاص ، فقال لي ابو زيد : تسلمها وتسنمها ، فانها احدي الحسنيين ، وويل اهوت من ويلين . قال الحارث بن همام : فحرت بين لوم ابي زيد وشكره ، وزنة نفعه بضرة ، فكانه نوجي بذات صدري ، او تكهن ما خامر سري ، فقابلني بوجه طليق وانشد بلسان ذليق : من مجزوء الرمل  يا اخي الحامل ضيمي . . . دون اخواني وقومي  ان يكن ساءك امسي . . . فلقد سرك يومي فاغتفر ذاك لهذا . . . واطرح شكري ولومي ثم قال : انا تءق وانت مءق فكيف نتفق ؟ ثم ولي يفري اديم الارض ، ويركض طرفه ايما ركض ، فما عدوت ان ارتكضت مطيتي ، وعدت لطيتي ، حتي انتهيت الي حلتي ، بعد اللتيا والتي . 
  نوادر من المكاتبات
 كتب ابو الفضل ابن العميد : كتابي  جعلني الله فداك  وانا في كد وتعب منذ فارقت شعبان ، وفي جهد ونصب من شهر رمضان ، وفي العذاب الادني دون العذاب الاكبر من الم الجوع ووقع الصوم ومرتهن بتضاعيف : من الطويل حرور لو ان اللحم يصلي ببعضها . . . غريضا اتي اصحابه وهو منضج وممتحن بهواجر يكاد اوارها يذيب دماغ الضب ، ويصرف وجه الحرباء عن التحنف ، ويزويه عن التنصر ، ويقبض يده عن امساك ساق وارسال ساق : من البسيط ويترك الجاب في شغل عن الحقب . . . ويقدح النار بين الجلد والعصب ويغادر الوحش قد مالت هوادبها : من الطويل سجودا لدي الارطي كان رءوسها . . . علاها صداع او فواق يصورها وكما قال الفرزدق : من الطويل بيوم اتت فيه الظلال سمومه . . . وظل المها صورا جماجمها تغلي وكما قال مسكين الدارمي : من الطويل وهاجرة ظلت كان ظباءها . . . اذا ما تقتها بالقرون سجود  تلوذ بشءبوب من الشمس فوقها . . . كما لاذ من حر السنان طريد وممنو بايام تحاكي ظل الرمح طولا ، وليال كابهام لاقطة قصرا ، ونوم كلا ولا قلة ، وكحسو الطاءر من ماء الثماد دقة ، وكتصفيقة الطاءر المستحر خفة من الطويل كما ابرقت يوما عطاشا غمامة . . . فلما رجوها اقشعت وتجلت ومن المنسرح كنقر العصافير وهي خاءفة . . . من النواطير يانع الرطب واحمده علي كل حال ، واساله ا ، يعرفني فضل بركته ، ويلقيني الخير في باقي ايامه وخاتمته ، وارغب اليه في ان يقرب علي القمر دوره ، ويقصر سيره ، ويخفف حركته ، ويعجل نهضته ، وينقص مسافة فلكه وداءرته ، ويزيل بركة الطول عن ساعاته ، ويرد علي غرة شوال ، فهي اسر الغرر عندي واقرا لعيني ، ويسمعني النعرة في قفا شهر رمضان ، ويعرض علي هلاله اخفي من السر ، واظلم من الكفر ، وانحف من مجنون بني عامر ، واضني من قيس بن ذريح ، وابلي من اسير الهجر ، ويسلط عليه الحور بعد الكور ، ويرسل عليه كلفا يغمره وكسوفا يستره ، ويرينيه مغمور النور ، مقهور الضوء ، قد جمعه والشمس برج واحد ودرجة مشتركة ، وينقص من اطرافه كما تنقص النيرات من طرف الزند ، ويبعث عليه الارضة ، ويهدي اليه السوس ، ويغري به الدود ، ويبليه بالار ، ويخترمه بالجراد ويبيده بالنمل ، ويجتحفه بالذر ، ويجعله من نجوم الرجم ، ويرمي به مسترق السمع ، ويخلصنا من معاودته ، ويريحنا من دوره ، ويعذبه كما عذب عباده وخلقه ، ويفعل به فعله بالكتان ، ويصنع به صنعة بالالوان ، ويقابله  بما تقتضيه دعوة السارق اذا افتضح بضوءه ، وتهتك بطلوعه : ويرحم الله عبدا قال امينا واستغفر الله جل جلاله مما قلته ان كرهه ، واستعفيه من توفيقي لما يذمه ، واساله صفحا يفيضه وعفوا يسيغه ، وحالي بعدما شكوته صالحة ، وعلي ما تحب وتهوي جارية ، ولله الحمد  تقدست اسماءه  والشكر . ومن كلام ابي الحسن ابن نصر الكاتب الي صديق له اشتري حمارا يداعبه برسالة من جملتها : عرفت  ابقاك الله  حين وجدت من سكرة الايام افاقة ، وانست من وجهها العبوس طلاقة ، وتنسمت رياح المسرة ، واعتضت من ظلمة الضيق نور بذوي الاخطار والهيءة ، فسررت بكون هذه المنقبة التي اضمرها الاعدام ، ومن علي كرم سرها الامكان ، واستدللت منها علي خبايا فضل ، وتنبهت بها علي مزايا نبل ، كانت ماسورة في قبضة الاعسار ، وكانعة في سدفة الاقتار ، وقلت : اي قدم احق بولوج الركب من قدميه ، وحاذ اولي ببطون القب من حاذيه ؟ واي انامل ابهي من انامله اذا تصرفت في الاعنة يسراها ، وتختمت بالمخاصر يمناها ؟ وكيف يكون ذلك الخلق العميم والوجه الوسيم ، وقد بهر جالسا ، اذا طلع معاليك ، فقبضت ما انبسط من عنانها ، واخمدت ما اشتعل من نيرانها ، حتي وقفت علي محجة لاشك ارجو علو همتك بحسن اختيارك ، واخشي منافسة الايام في درك اوطارك ، فاناه كالظانة في ولدها ، والمحادثة بالسوء في واحدها ، يدني الامل مسارها ، ويزجي القلق حذارها ، حتي اتتني الانباء تنعي رايك الفاءل ،  وتبكي عزمك الافل ، يوقوع اختيارك علي فاضح صاحبه ، ومسلم راكبه ، الجامد في حلبة الجياد ، والحاذق بالحزن ولاكياد ، الشءم ديدنه ودابه ، والبلادة طبيعته وشانه ، لا يصلحه التاديب ، ولا تقرع له الظنابيب ، ان لحظ عيرا نهق ، او لمح اتانا شبق ، او وجد روثا شم وانتشق ، فكم هتم سنا لصاحبه ، وكم اسعط انف راكبه بانفاسه ؟ وكم استرده خاءفا فلم يردده ، وكم رامه خاطبا فلم يسعده ؟ يعجل ان احب الاناة والابطاء ، ويرسخ ان حاول الحث والنجاء ، مطبوع علي العكس والخلاف ، موضوع للضعة والاستخفاف ، عزيز حتي تهينه السياط ، كسول ولو ابطره النشاط ، ما عرف في النجاية ابا ، ولا افاد من الوغي ادبا ، الطالب به محصور ، والهارب عليه ماسور ، الممتطي له راجل ، والمستعلي بذروته نازل ، له من الاخلاق اسواها ، ومن الاسماء اشناها ، ومن الاذهان اصداها ، ومن القدود احقرها ، ومن تجحده المراكب ، وتجهله المواكب ، وتعرفه ظهور السوابل ، وتالفه سباطات المنازل . ومنها : جعلت فداك ، لم حيث شاورت لم تستشر عليما ان عدمته نصيحا ، وبصيرا ان لم تظفر به شفيقا ، وذا منة نافذة ان عدمت ذينك بواحدة ؛ وان وجدك بعزلة من العتاق ، وحجزة من ذوات الاعناق ، امالك الي الهماليج التي زانها التصنيع ، وراضها التخليع ، فاصبحت منسربة كالحباب ، متدافعة كالسحب ، وامطاك المركبة البدع ، بين كرم الاصل وكرم الفرع ، سفواء رومية ، او دهماء اعوجية ، لها طرفان من الحمد والذم ، وخبران لنسب الاب من الام ، يكرم راكبها ولا يهاب ، وينجو صاحبها فلا يصاب ، ذات خطي تسبق الاوفاز ،  ومطي يشتت الاعجاز ، نهاية في كمالها ، زاهية باخوانها ، تطرد الطرف وقج حازها ، وتسترجع الطرف وقد جازها ، فانت عليها كالبدر او انبه ، وقد يجنح لك الراي او نهيه ، ولكن بقيت الي ذلك دقيقة جليلة المعني ، وقريبة بعيدة المرمي ، بها شرف المطالب ، وليست مما تكسب يد الكاسب : كرم الطبيعة والنجار ، واتساع همة المشاور والمستشار ، فان وجدت هذا يا مولاي بالغالي من صغر المنة فاشربه ، او عرض عليك هول من الاخطار كرها فاركبه . هيهات قلص المرام ، وشلت يد الرام ، وغاض الماء ، واهوت سنة الحالم ، وهوت شفة الحاءم ، ونفقت المكارم وحضر طالبها ، وتنجت الكراءم ثم جاء خاطبها . وعندي الان بواب حيل افتحها ، وغوامض خدع اوضحها ، تطفيلا بالراي لا تستوجبه ، وتغريبا في المكر لا تستغربه ، ان تستحدث سيفا فيكون بعض الات ما تسومه من الخيل المسومة ، وترومه من البغال المخزمة ، فعل النحرير من الاجناد ، المستظهر بتقديم الاهبة والاستعداد ، فان انتشر عنك هذا الخبر ، وامحي ذلك الرقم ولااثر ، عدت لرسمك مستسعيا قدمك في مهمك ، وماحيا طمع الجلالة في وهمك ، وقرنته باتان ، وجمعت بينهما في مكان ، بعد ان تحلها له نكاحا او تمتعا ، وتمهرها عنه جلا او برقعا ، فتنتفع بالجحاش ، ويكون الولد للفراش . هذان فنان من التوصل ، ونوعان من التغلغل : فاختر وما فيهما حظ لمختار ثم لا اعلم اي فكر من الافكار ، اوهمك النباهة في ركوب الحار ، ولا من اين وقع لك هذا وحصل ، ودعني من التهاويس باخبار العزيز وجندل ، فاني اعرف منك ثم انكرها ، والوم ثم اعذرها ، فليس طريق العلاء منقوضة لكل دايس ، ولا ظهرها مسرجا لكل فارس ، ولا كل من رام خليقة ما طبع لها ،  وعادة ليس من اهلها ، ومنقبة ما ذاق صرفها ، وطبيعة ما اشتم عرفها ، اتته منقادة مجيبة ، واطاعته مختارة مريدة ، فلكل درجة قدم ترقاها ، ولكل حسنة ناظر يرعاها ، والانسان بنفسه اعرف ، ولشاكلته الف . فان يكن ما اتيت  ابقاك الله فكذلك تكون ان شاء الله  زلة العالم وعثرة الحازم ، وغفلة المتحفظ ، وغفوة المتيقظ ، فامط العار بجواد حصين الصهوة محلق الجبهة ، امين الحوافر ، فسيح المناخر ، عريق المفاخر ، ربقة الافكار ، ومزلقة الابصار ، او بغلة تسطو تيها علي ابيها ، وتبغض الارض الي ممتطيها ، كانما تحطها في صبب ، او تطا بقواءمها علي لهب ، والا فاترك الابهة كما تركتك ، وافركها كما فركتك ، وتنح عن سنن الفارط ، وانسل انسلال المغالط ، وارجع لاول امرك ، لا مخطءا ولا مصيبا ، ولا نبيه القدر ولا معيبا . ومن رسالة له الي بعض اخوانه وقد ولي ولاية : واقول  ادام الله عز القاضي  ان الدهر كله كل ، وابه عقد وحل ، يحلو مرة ثم يمر ، وينفع تارة ويضر ، ويصفو يسيرا ثم يكدر ، ويفي قليلا ثم يغد ، فالكيس من ابناءه من انتهز فرصة عطفه وابقاءه ، تشاغلا بهزله وطيبه ، وتغافلا عن جده وتعذيبه ، صلة فرصة عطفه وابقاءه ، تشاغلا للغثاثة والوقار . ففي هذه الحلبة جرينا ، ولاخلاف هذه مرينا ، فنبذنا ترتيب القضاء والشهادة ، وتركنا كلفة الانحناء والسجادة ، وراينا الرخص ماخوذا بها ، والشبه مفتوحة ابوابها ، وان اختلاف الاءمة رحمة الله الي الامة . ولجانا الي كتاب الحيل عند ضيق الامر ، وراي ابن اللبان في طهارة الخمر ، وان الاجماع ليس بحجة . ولابصريون  ادام الله عز القاضي  يتبعون شيخا من شيوخ ناعمة طاحية ، يزعم ان التوبة  بعد السبعين ماحية ، وانها في الشبيبة كذابة ترد علي عقبها ، ويضرب بها وجه صاحبها ، وله في ذلك كلام مفيد ، وقد اخت عنه تعليقة اذا فرغ الانسان منها فقد نبذ كتاب الله ظهرا ، وخرج من الدين ببركته صفرا ، ولولا ضيق الصدر ولاوقت ، لطويت هذه السطور علي شء من كلامه لتتدبر معانيه ، وتري حسن تصرفه فيه ، ولكن حال الجريض دون القريض ، وما اخوفني ان يظن هذه الفكاهة انما هي انفساح الحال ، واتساع المجال ، وقوة الانس ، وانبساط النفس . وما هي الا سرور بما تيسر من مفاوضته ، وتسني من اسباب مناسمته التي نشرت بها علي الهم جناحا ، وجعلتها لسدفة فكري مصباحا ، واني اذا سامحني الدهر بمحادثة فضله ، وامكنني من مباثة مثله ، فضضت بنات صدري ، ونفضت بها اثقال ظهري : من الطويل ومن لك في الدنيا باروع ماجد . . . يواسيك في اهوالها او يشارك والمرء باخيه ، بعدت داره ام قربت ، والمعرفة حرمة بين الاحرار قويت ام ضعفت ، فاما اذا ضمهم ذمام الادب ، فهم فيه بنو اب ، وما ابعد عهدي بيد للايام عندي ، الي حين الاجتماع بالاستاذ ابي الفضل ، الذي علوت به من السرور مرقبا ، وجعلته الي هذه المفاوضة المءنسة لي سببا ، والله تعالي يمتعني من القاضي بالفضل الراجح ، ويمدني من دياره بالخبر الصالح ، فان راي مقابلة ما اصدرته بوجه من القبول ورضي ، وخلق بالترحيب مضي ، واتحافي بمبهج اخباره ، وايناسي بسانح اوطاره ، فعل ، ان شاء الله تعالي . من المقامات التي انشاها ابو محمد القاسم بن علي الحرير : اخبر الحارث بن همام قال : ازمعت التبريز من تبريز ، حين نبت بالذليل والعزيز ، وخلت من المجير والمجيز ؛ فبينا انا في اعداد الاهبة ، وارتياد الصحبة ،  لقيت ابا زيد السروجي ملتفا بكساء ومحتفا بنساء ، فسالته عن خطبه ، واين يسرب مع سربه . فاوما الي امراة منهن باهرة السفور ، ظاهرة النفور ، وقال : تزوجت هذه لتءنسني في الغربة ، وترحض عني قشف العزبة ، فلقيت منها عرق القربة ، تمطلني بحقي وتكلفني فوق طوقي ، فانا منها نضو وجي ، وحلف شجو وشجي ، وها نحن قد تساعينا الي الحاكم ليضرب علي يد الظالم ، فان انتظم بيننا الوفاق ، والا فالطلاق والانطلاق . قال : فملت الي ان اخبر لمن الغلب ، وكيف يكون المنقلب ، فجعلت شغلي دبر اذني ، وصحبتهما وان كنت لا اغني . فلما حضرا القاضي ، وكان ممن يري فضل الامساك ، ويضن بنفاثة السواك ، جثا ابو زيد بين يديه وقال : ايد الله القاضي واحسن اليه ، ان مطيتي هذه ابية القياد ، كثيرة الشراد ؛ مع اني اطوع لها من بنانها ، واجني عليها من جنانها ، فقال لها القاضي : ويحك ! اما علمت ان النشوز يغضب الرب ، ويوجب الضرب ؟ فقالت : انه ممن يدور خلف الدار ، وياخذ الجار بالجار .  فقال له القاضي : تبا لك اتبذر في السباخ ، وتستفرخ حيث لا افراخ ؟ اغرب عني ، لا نعم عوفك ، ولا امن خوفك . فقال له ابو زيد : انها  ومرسل الرياح  لاكذب من سجاح ، فقالت : كلا هو  ومن طوق الحمامة وجنح النعامة  لاكذب من ابي ثمامة ، حين مخرق باليمامة . فرفر ابو زيد زفير الشواظ ، واستشاط المغتاظ ، وقال لها : ويلك يا دفار يا فجار ، يا غصة البعل والجار ، اتعمدين في الخلوة لتعذيبي ، وتبين في الحفلة تكذيبي ؟ قد علمت اني حين بنيت عليك ودنوت اليك ، الفيتك اقبح من قردة ، وايبس من قدة ، واخشن من ليفة ، وانتن من جيفة ، واثقل من هيضة ، واقذر من حيضة ، وابرز من قشرة ، وابرد من قرة ، واحمق من رجلة واوسع من دجلة ، فسترت عوارك ولم ابد عارك ، علي ا ، ه لو حبتك شيرين بجمالها ، وزبيدة بمالها ، وبلقيس بعرشها ، وبوران بفرشها ، والزباء بملكها ، ورابعة بنسكها ، وخندف بفخرها ، والخنساء بشعرها في صخرها ، لانفت ان تكوني قعيدة رحلي وطروقة فحلي . قال : فتذمرت المراة وتنمرت ، وحسرت عن ساعديها وشمرت ، وقالت : يا الام من مارد ، واشام من قاشر ، واجبن من صافر ، واطيش من طامر ، اترمين بشنارك ، وتفري عرضي بشفارك ؟ وانت تعلم انك احقر من قلامة ،  واعيب من بغلة ابي دلامة ، وافضح من حبقة ، في حلقة ، واحير من بقة في حقه ، وهبك الحسن في لفظه ووعظه ، والشعبي في علمه وحفظه ، والخليل في عروضه ونحوه ، وجريرا في غزله وهجوه ، وقسا في فصاحته وخطابته ، وعبد الحميد في بلاغته وكتابته ، وابا عمرو في قراءته واعرابه ، وابن قريب في روايته عن اعرابه ؛ اتظنني ارضاك اماما لمحرابي وحساما لقرابي ؟ لا والله ولا بوابا لبابي ، ولا عصا لجرابي . فقال لهام القاضي : اراكما شنا وطبقة ، وحداة وبندقة ، فاترك ايها الرجل اللدد واسلك في سيرك الجدد ، واما انت فكفي عن سبابه ، وقري اذا اتي البيت من بابه . فقالت المراة : والله ما اسجن عنه لساني ، الا اذا كساني ، ولا ارفع له شراعي دون اشباعي ، فحلف ابو زيد بالنحرجات الثلاث ، انه لا ينلك سوي اطماره الرثاث . فنظر القاضي في قصصهما نظر الالمعي ، وافكر فكرة اللوذعي . ثم اقبل عليهما بوجه قد قطبه ، ومجن قد قلبه ، وقال : الم يكفكما التسافه في مجلس الحكم ، والاقدام علي هذا الجرم ، حتي تراقيتما في فحش المقاذعة الي خبث المخادعة ؟ وايم الله لقد اخطات استكما الحفرة ، ولم يصب سهمكما الثغرة ، فان امير المءمين ، اعز الله ببقاءه الدين ، نصبني لاقضي بين الخصماء لا لاقضي دين الغرماء ، وتمام هذه المقامة تركته اختصارا . ون رسالة كتب بها الشريف ابو يعلي ابن الهبارية من كرمان الي الشيخ الخطيب ابي زكريا يحيي بن علي التبريزي جوابا : من الطويل  افدي الكتاب بناظري فبياضه . . . ببياضه وسواده بسواده فلقد جدد عهدي بالسرور والجذل ، واعاد علي عصر الطرب ، وانالني من الزمان ما يوفي علي الامل ، واحيا ميت نشاطي ، واجري الروح في رميم جذلي وانبساطي ، ورد لي ما غاب من فرحي واغتباطي ، وفرج عن روحي المكروبة ، وازاح علل عازب الهموم عن نفسي بما حققه من مسلامة سيدنا . نعم ، وصلني كتابه فالتقطت من نفاءس درره ، ولقد كنت فقيرا الي بداءع فقره ، وتعجبت من ملح كلامه ، ونكت نثاره ونظامه . وهو ان كان في العين كتابا ، فقد وجدته في القلب كتيبة ملءت طعانا وضرابا ، لانه  حرس الله فضله  شحنه عتابا ، وملاما وسبابا ، المني وقعه واحرقني لذعه ، لكنه خلق سيدنا وطبعه . من السريع ولاشيخ لا يترك اخلاقه زعم اني ذو ملة طرف ، والملال  اطال الله بقاء سيدنا  بءست الخلة كما عرف ، وفي المثل المقول : لا مودة لملول ، كلا والله لانا له اوفي من الافلاس والاعسار ، واحفظ لعهده من الخمول والافتار ، لاحوال الادباء الاحرار ، بل من الكلف لوجه البدر ، والخمار لعاقبة الخمر . والله مانسيت عهده ولا سلوت وده ولا تركت مكاتبته عمدا . يقول فيها : فسيدنا معروف في الافاق ، غير مفتقر الي المقام بالعراق ، لكي اظن ظباء الحريم قد عقلت عقله ، واحسب ارام الصراة لا الصريم قد ربطت فضله ،  وانه صريع الكاس والحدق البخل ، وان سخاء صبيان نهر المعلي يغطي علي ما في رءساءه من الشح والبخل ،  فهو  دام فضله  اسير الغزلان ، وربيط الوجوه الحسان ؛ اعلي يتجالد سيدنا ويتداري ؟ لقد تغلغل في النفاق وتناهي . هب ان الخلافة المستظهرية  نصر الله اعلامها  اذنت في مسيره ، والمكارم الرضوية سمحت بزاده وبعيره ، اتاذن له الجفون المراض ، والقدود الرشاق ، والخصور الدقاق ، والالفاظ الرخيمة ، والالحاظ السقيمة ، والقدود الهيف ، والغنج الذي يجل عن التكييف ، والثغور المعسولة ، والخصور المظلومة ؟ من المجتث كم قد اردت مسيرا . . . عن بردشير البغيضه فرد عزمي عنه . . . هوي الجفون المريضه والله لجلسة علي صدور زنبريات الجسر ، بين العشاء والعصر ، مع غزال انسي لا وحشي يسمي الزيت ، ويكني مخرب البيت ، وقد فركت نفحات الاصيل بيد النسيم غلالة دجلة والزرقاء ، وزرنق يساير السمارية الدهماء ، وفيها حورية حوراء ، باعطاف ولا اليزنية السمراء ، والحاظ ولا المشرفية البيضاء ، والفاظ لو سمعها ابن قريب ، لما وري ابي ذءيب . ويلاه لنقر الدف ، وصرير الخف ، وتكسر الالحان ، علي كان وكان ، في وكنات الجنات ، ومشاتمات الحمايات والكنات ، في المامونية ودرب القيار ، والقربة ودار دينار ، وقولها : وستغ الله وستغ الله ، انك حقب البيت ، لاحلي من نبرات زلزل في الثقيل الاول منها ويلاه فما خطيت : من المديد هات باليسري فقد ضعفت . . . يدي اليمني عن القدح  من البسيط : ورد الخدود ورمان النهود واغ . . . صان القدود سبت عقلي فلا تلم قد قيدت بالهوي عقلي وقد عقلت . . . قلبي فما نافعي ان اطلقت قدمي يا سيدي ، جعلت فداك ، ها هنا من التين التركي ، والموز الهندي في بساتين الحضور ، واقرحة الاسافل ، وازقة الاوساط ، ما لا يذكر معه الوزيري الشمفي ، فما في العوجاء ولا باقطينا ، لا بالرقة ولا الزلاقة منه شء ولا واحدة . فديته يقطر عسله ، ويسيل دبسه ، وينتثر قنده ، ويذوب شهده ، ولكن السنون قد كسرت الشرة وقنعتني بحر الحرة ؛ والنفاق النفاق ، فهو زمان ومكان يروج فيه النفاق . اللهم غفرا ما لي وللهراء من الكلام ، وذكر الغلامة والغلام ، بعدما خوطبت بالشريف الامام ، واستفتيت في الحلال والحرام . وكاني بسيدنا الشريف الخطيب ابي البقاء عند بلوغه الي هذا الفصل من مكتوبي يعده من جملة ذنوبين ويرفع عقيرته بهتك ستر الله عن عيوبي ، ويقول : قد تصابي ابن عمي بعد شيبه ، ونادي علي نفسه بعيبه ، وامر بذنبه وريبه ، ولعهدي به وهو في عنفوان شبابه ، متميزا بالنسك عن اضرابه ، ومنفردا بالتبعصم عن اترابه ، ولم يقرع باب اللهو ، ولم يبده بهراء من قوله ولا لغو ، ولا غازل غزالا ، ولا ناك الا حلالا ، فما ها الجهل بعد الشيب ؟ اصبا بعدما شاب ، ام شاب الدهر وبرده كما شاب ؟ فعاد زيرا غزلا بعد ماكان عزهاة معتزلا ، فينبذ كتابي من يده متبعصما ، ويعرض عن موصله بوجهه المليح صدودا وتجهما ، يوقول سيدنا البارع ، وشهادته السيف القاطع : والله لو بلغ ابو يعلي الي العرش ، لما كان الا اسقط من سنجة قيراط في حش . ومنها : فيعارضه الرءيس الاجل الموفق ابو الفضل ابن عيشون دام جماله ، ولاسحر مقاله ، والكرم خلاله ، والشرف خصاله ، فيقول : يا قوم لا تهتكوا ستر  اخيكم ، ولا تعجلوا بقطع اسبابكم عن اسبابه ونزع اواخيه من اواخيكم ، فعلي هذا عاشرتموه ، وقديما يا سرتموه ، اظننتموه يحول ، وحسبتم حمقه يزول ؟ ! ومنها : فيقول سيدي ابو الفضاءل المروزي بعد ان يحرك الدبة ويهز المذبة ، سلوا عنه صديقه القديم ، وحميمه الخبير به العليم حشابور ، فهو يعرف من مخازيه ما لا يعدله شء ولا يوازيه ، وكفاه قوله : الكامل المجزوء وربيبة زينتها . . . فاتت كجارية ربيبه وهي ابيات فيها سخف . يغتابونني وهم لا يعلمون ، كانهم نسوا قول الله تعالي : وانهم يقولون ما لا يفعلون . يا سيدنا انا اقول وافعل ولكن ما في قلبي شء . وجملة الامر وتفصيله اني كما قال ابو بصير ، وسيدنا به عين البصير : من البسيط علقتها عرضا وعلقت رجلا . . . غيري وعلق اخري غيرها الرجل من المنسرح : قد عشقت محنتي فواحربا . . . علجا غليظ القفا له عضل وقد تبدلت واتخذت فتي . . . كالبدر فيه من مثلها بدل مساعدا مسعفا يجود بما . . . اطلب ما في خلاله بخل لكنني للعفاف يقنعني . . . كما علمت الحديث والقبل وواحد واحد علي عجل . . . اخذه منه وهو مشتغل وهي طويلة وفيها هزل سخيف الغي .  وكتب علي بن نصر الكاتب الي امرد خرجت لحيته : لكل حادثة يفجع به الدهر  احسن الله معونتك  حد من القلق والالتياع ، ومبلغ من التحرق والارتياع ، يستوجب فنا من التعزية ، ويستحق نصيبا من العظة والتسلية ، والاختصار فيها لما قرب خطبه وشانه ، والاكثار لما جل محله ومكانه ، ومصابك هذا  اعزك الله  في بياض عارضك لما اسود كمصابك في وساده اذا ابيض ، والالم بنبات روضه جميما ، نظير الالم به يوم يعود هشيما ، فليس احد يدفع عظم النازل بك ، ولا يستصغر جسيم الطارق لك ، وان كان ما يتعقبه من المشيب اقذي للعيون واذل ، بيد ان الحاضر من النبات الذي تمنيت ان يكون معوزا ووددت ارضك دونه جرزا ، القي عنك النواظر وكانت ملتفتة اليك ، ووقف عنك الخواطر وكانت موقوفة عليك ، وصيرك قذي الاجفان ، وكنت جلاها ، وجعلك كربة النفوس وكنت هواها ، وابدلك من انس التقبل وحشة التنقل ، وعوضك من رقة الترفرف كلفة التافف ، فصرت لا تري الا معرضا ، بعد ان كنت لا تري الا متعرضا ، فتبارك الذي صرف عنك الابصار ، ونقل منك الاوطار ، فكنت اربة الانكح ، فصرت اربة المنكوح ، ولذة الناطح ، فغدوت لذة المنطوح ، فانت ابلق السوطين اقبالا وادبارا ، وصاحب الوزرين ملوطا به ولاءطا ، وكاسب الغثمين مسوطا كرة وساءطا ، فعويلا داءما وبكاء ، وعزاء عن الذكر الجميل عزاء ، فلكل اجل كتاب ، وعن كل جاءحة ثواب . وقد استوفيت امد الصبا والصبابة ، واستنبت الحسرة عليها والكابة ، فرزيتك راتبة والرزايا سواءر ، ومصيبتك ثابتة والمصاءب عواءر ، فغنا لله وانا اليه راجعون ، لقد فجعت بعلق ما كان احسن واجمل ، ثم الا حيلة فانها الايام لا تثبت علي حالة ، ولا تعرف غير التنقل والاستحالة ، تسوء تارة وتسر ، وتحلو طورا ثم تمر ، سراءرها خبيثة ، ومراءرها نكيثة ، من طيبت له اعتبطته ، ومن لهت عنه اخرمته ، فاجرك الله في وجه نضب ماءه ، وذهب رواءه ، ومات  حياءه ، وفي ضيعة استاجم برها ، واستدغل نورها ، واستع طريقها ، واستعت بثوقها . . وفي جاه كان عامرا فخرب ، ودخل كان وافرا فذهب ، وتذكار كان واصلا الي القلوب منك فحجب ، فاصبحت مسبوق السكيت ، وظلت حيا واتت الميت ، قد نطق المرم بهجاءك ، وخيمت النحوس بفناءك ، فانت تمشي القهقري ، وكل يوم حظك الي ورا ، ولا قوة الا بالله من محن دفعت اليها ، ولم تعن بحال عليها ؛ قد يشغل الانسان عن نواءبه المشاركون فيها ، ويسليه عنها المساهمون في معني من معانيها ، وانت من بين هذه المنزلة لا شريك لك ، فانهم يعتاضون عنها ولست بمعتاض ، فيرتكضون للعيش ولست بركاض ، والدهر يطوي محاسنك طي السجل كتابه ، وينشر مقابحك نشر اليماني ابراده ، ويقلي الطرف رءيتك فلا يفتق عليك جفنا ، ويمج السمع ذكرك فلا يجد عنده اذنا ، وتتهم الادباء طرقك فال تفتح لك رتاجا . فانت الطريد الذي لا يجار ، والربع الذي لايزار ، والظان المريب ، والظنين المعيب ، والعار الفاشي ، والمقبور الناشي . وقد اعنتك برقعتي هذه جامعة بين البكاء عليك والانين ، وناظمة بين العزاء لك والتابين لها حلاوة النثر ، وعليها طلاوة الشعر ، نتجتها قريحة عليك ، ونسجتها خواطر خطرت اليك ، تخفف عزمك والانس مشاغيل بتثقيله ، وتكرم مكانك والغجماع واقع علي تهوينه . فغن عرفت لي ذاك والا عرفه الصدق ، وان شكرته والا شكره الحق ، والسلام عليك من اسير لا يخلص بالفدية ، وقتيل بسيف السبال واللحية . اراد كاتب ا ، ي كتب جوازا لرجل وحش الصزرة ، فلم يقدر علي تحليته لفرط دمامته ، فكتب : ياتيك يهذا الجواز اية من ايات الله ، فدعه يذهب الي نار وسقره .  ذم الجاحظ الكتاب فقال : ما قولك في قوم اول من كتب لرسول الله صلي الله عليه وسلم بالوحي خالفه في كتابه ، فانزل الله فيه ايات بينات ، فهرب الي جزيرة العرب فمات كافرا ، ثم استكتب معاوية فكان اول من غدر بامامه ، وحاول نقض عري الاسلام في ايامه ؛ ثم كتب عثمان لابي بكر مع طهارة اخلاقه ، فلم يمت حتي اداه عرق الكتابة الي ذم من ذمه من اولياءه ؛ ثم كتب لعمر زياد بن ابيه ، فانعكس لشر مولود ، وكتب لعثان مروان بن الحكم ، فخانه في خاتمه واشعل حرباص في مملكته . كان لرافع بن الحسين بن حماد بن مقن كاتب رقيع نصراني يقال له ابو الحسين بن طازاد ، فكتب اليه : امير الامراء الاجل الرفيع المحل ، الشاكر المراقب ، الناظر في العواقب ، مظاهر الدولة والمناقب . ذكر بديع الزمان ابو الفضل الهمذاني في مجلس ابي الحسين ابن فارس ، فقال ما معناه : ان البديع قد نسي حق تعليمنا اياه وعقنا ، وطمح بانفه عنا ، فالحمد لله علي فساد الزمان وتغير نوع الانسان . وبلغ ذلك البديع ، فكتب الي ابي الحسين : نعم اطال الله بقاء الشيخ الغمام ، انه الحما المسنون ، وان ظنت به الظنون ، والناس لادم ، وان كان العهد قد تقادم ، وتركبت الاضداد ، واخلاط الميلاد ، والشيخ الامام يقول : فسد الزمان ، افلا يقول : متي كان صالحا ؟ افي الدولة العباسية وقد راينا اخرها ، وسمعنا اولها ، ام المدة المروانية وفي اخبارها ، ولا تسكع الشول  باغبارها ؛ ام السنين الحربية : الكامل المجزوء والسيف يغمد في الطلا . . . والرمح يركز في الكلي ومبيت حجر بالفلا . . . والرتان وكربلا ام البيعة الهاشمية والعشرة براس من بني فراس ، ام الامارة العدوية وصاحبها يقول : هل بعد القفول الا النزول ؛ ام الخلافة التيمية وهو يقول : طوبي لمن مات في ناناة الاسلام ؛ ام علي عهد الرسالة ويوم قيل : اسكتي يا فلانة فقد ذهبت الامانة ؛ ام في الجاهلية ولبيد يقول : من الكامل وبقيت في خلف كجلد الاجرب ام قبل ذلك واخو عاد يقول : من الطويل بلاد بها كنا وكنا نحبها . . . اذ الناس ناس والزمان زمان ام قبل ذلك ويروي عن ادم عليه السلام : من الوافر تغيرت البلاد ومن عليها . . . فوجه الارض مغبر قبيح ام قبل ذلك والملاءكة تقول لبارءها اتجعل فيها من يفسد فيها ويسفك الدماء . ما فسد الناس ، ولكن اطرد القياس ، ولا اظلمت الايام ، وانما امتد  الظلام . وهل يفسد الشء الا عن صلاح ، ويمسي المرء الا عن صباح ؟ ولعمري لءن كان كرم العهد كتابا يرد ، وجوابا يصدر انه لقريب المنال ، واني علي توبيخه لي لفقير الي لقاءه ، شفيق علي بقاءه ، نمتسب الي ولاءه ، شاكر لالاءه ، لا احل حريدا عن امرهولا اقف بعيدا عن قلبه ، ولا نسيته ولا انساه ؛ ان له علي كل نعمة خولنيها نارا ، وعلي كل كلمة علمنيها منارا ؛ ولو عرفت لكتابي موقعا من قلبه لاغتمنت خدمته به ، ولرددت اليه سءر كاسه ، وفضل انفاسه . ولكني خشيت ان يقول : هذه بضاعتنا ردت الينا ، وله ايده الله العتبي والمودة في القربي ، والمرباع وما ناله الباع ، وما ضمه الجلد وضمنه المشط ، وليست رضي ولكنها جل ما املك . واثنتان  ايد الله الشيخ الامام  قلما يجتمعان ، الخراسانية والانسانية ، فان لم اكن خراساني الطينة فاني خراساني المدينة ، والمرء من حيث يوجد ، لا من حيث يولد ، ولاانسان من حيث يثبت لا من حيث ينبت . فاذا انضاف الي خراسان ولادة همذان ارتفع القلم ، وسقط التكليف ، فالجرح جبار ، والجاني حمار ، ولاجنة ولا نار . فليحتملني علي هناتي ، اليس صاحبنا الذي يقول : من الخفيف لا تلمني علي ركاكة عقلي . . . ان تيقنت انني همذاني 
  الباب الثاني والثلاثون في شوارد الامثال 
  فارغة  بسم الله الرحمن الرحيم وبه الثقة والعون  الحمد لله المتنزه عن الضريب والمثال ، المستعلي عن ضرب المقاييس له والامثال ، المتفرد بصفة الكبرياء والجلال ، مجري البحار ومرسي الجبال ، ومحصي عدد القطر والرمال ، خالق الجان من مارج من نار ، والانسان من حما صلصال ، عالم الغيب والشهادة الكبير المتعال ؛ ضرب لنوره مثلا من المشكاة والمصباح ، وخلق الشمس والقمر حسبانا وفلق الاصباح ، وجعل الليل مطية الراغبين غليه ليحمدوا سراهم عند الصباح . احمده حمدا حرس نعمه عندنا من الزيال والانتزاح ، ويقرن غدو مواهبه لدينا بالرواح .  واشهد ان لا اله الا الله وحده لا شريك له ، شهادة تنقذ مخلصها من عماية الضلال ، وتكون له خير ذخر في العقبي والمال ، والصلاة علي رسوله محمد المخصوص بمعجز البلاغة والبيان ، الناطق بنبوته الحصي والسرحان ، المنعوت في الانجيل والتوراة والقران وعلي اله واصحابه المتالفة قلوبهم في اتباعه بعد البغضاء والشنان . 
  الباب الثاني والثلاثون في شوارد الامثال
 امثال العرب كثير ، وان وقعت عليها اشعارهم ، ومن تلاهم من المخضرمين والمحدثين ، لم يضبطها حصر . وفي الامثال الخامل والنادر ، والبعيد المغزي ، والعقد المعني ، والجافي اللفظ . فاعتمدت في هذا الباب علي المشهور منها ، وما جزلت الفاظه ، وسهلت معانيه ، وحسن استعماله في عصرنا ، ولم يكن بعيدا من الملاءمة ، فمن الامثال : البس لكل حالة لبوسها . واقتصدت فيما اوردته في الامثال النبوية ، مع ان كلامه صلي الله عليه وسلم حكمة ، وامثاله كثيرة ، وفيما لاوقعته عليها من الشعر . فان الكتاب الذي هذه الامثال باب من ابوابه ، قد تضمن من كلامه صلي الله عليه وسلم ، ومن الاشعار في كل ابوابه ما يقع شاهدا في عموم المعاني والمقاصد ، فلا حظ في تكريرها . واضفت كل معني الي ما يجانسه ويقاربه لءلا تكثر الفصول فيضل المتامل لها . وهي اثنان وسبعون فصلا : شواهد من الكتاب العزيز ، من كلام الرسول عليه السلام ، منتهي التمثيل في لفظ افعل التفضيل ، والحنكة والتجارب ، الاخذ بالحزم والاستعداد للامر ، الاغترار والتحيل والاطماع ، البر والعقوق ، الحمية والانف ، الحلم والثبات ، الصدق والكذب ، وصف الرجل بالتدبير والفعل الجميل ، التمسك بالامر الواضح ، التوسط في الامور ، التساوي في الامر ، المجازاة ، التفرق والزيال ، حفظ اللسان ، التصريح والمكاشفة ، التسويف والوعد  والوعيد ، المكر والمداهنة ، الضرورة والمعذرة والاعذار ، تعذر الكمال المحض ، تعلق الفعل بما يبعد ، والامتناع عنه ما اتصل المانع او فعله ما استمر الشء ، وضع الشء في موضعه ، وضع الشء في غير موضعه ، اصلاح المال ، تسهيل الامور ودفع الاقدم بالاحدث ، العداوة والشماتة والرمي بالعصبية ، الاتفاق والتحاب والاستمالة ، قوة الخلق الي التخلق ، دليل استعان بمثله النفع والضر وفي معانيهما ، النفع من حيث لا يحتسب ، المبالغة ، الامر النادر ، الجبن والذل ، الجهل والحمق ، البلية علي البلية ، خيبة الامل والسعي ، العدة تاوي اليها ، الزم الامور بصاحبها ، الجاني علي نفسه ، الاحالة بالذنب علي من لم يجنه ، لقاء الشء بمثله او اشد ، تنافي الحالات ، الرضي بالميسور اذا تعذر المنشود ، الامر المضاع والمهمل ، ارتفاع الخامل ، خمول النبيه ، الشر وراءه الخير ، ضد ذلك ، الخطا والاختلاط ، الجميل يكدر بالمن ، اغتنام الفرصة ، اللقاء ، تعذر الامر وما يعرض من دونه ، طلب الحاجة ، التعجيل وفوت الامر ، سوء المكافاة وظلم المجازاة ، الظن ، التبري من الامر ، الاستهانة وقلة الاحتفال ، المشاركة في الرخاء والخذلان في الشدة ، والرخاء والسعة ، المعجب بخاصة نفسه ، الساعي لنفسه في صلاحه ، اليسير يحيي الكثير ، الشدة والداهية ، الدعاء . ؟ من شواهد الكتاب العزيز علي انه يحيط بما لا تفني عجاءبه ، ولا تنفد غراءبه ، وانما نشير الي ما يقتضيه شرط الكتاب ، والله الموفق للصواب . ؟ ؟ قوله تعالي : انما مثل الحياة الدنيا كماء انزلناه من السماء فاختلط به نبات الارض مما ياكل الناس والانعام حتي اذا اخذت الارض زخرفها وازينت وظن اهلها انهم قادرون عليها اتاها امرنا ليلا او نهارا فجعلناها حصيدا كان لم تغن بالامس كذلك نفصل الايات لقوم يتفكرون يونس :  .   وقال الحسن : ضرب الله مثلا ، فاقل الناس انتفع به وابصره ، يقول الله عز وجل : ايود احدكم ان تكون له جنة من نخيل واعناب تجري من تحتها الانهار له فيها من كل الثمرات واصابه الكبر وله ذرية ضعفاء فاصابها اعصار فيه نار فاحترقت كذلك يبين الله لكم الايات لعلكم تتفكرون البقرة :  . ثم قال : هذا الانسان حين كبرت سنه وكثر عياله ورق عظمه ، بعث الله علي جنته نارا فاحرقتها ، احوج ما كان اليها ، فهذا مثل ضربه الله ليوم القيامة ، يوم يقوم ابن ادم عريان ظمان ، ينتظر ويحذر شدة ذلك اليوم ، فايكم سره ان يذهب عمله احوج ما كان اليه ؟ . وقال تعالي في خيبة السعي : قل هل ننبءكم بالاخسرين اعمالا الذين ضل سعيهم في الحياة الدنيا وهم يحسبون انهم يحسنون صنعا الكهف    . وقال عز وجل : وقدمنا الي ما عملوا من عمل فجعلناه هباء منثورا الفرقان :  . وقال سبحانه : مثل الذين كفروا بربهم اعمالهم كرماد اشتدت به الريح في يوم عاصف لا يقدرون مما كسبوا علي شء ذلك هو الضلال البعيد ابراهيم :  . وروي عن النبي صلي الله عليه وسلم انه قال : ضرب الله مثلا صراطا مستقيما ، والصراط الاسلام . وقال عز من قاءل : يا ايها الناس ضرب مثل فاستمعوا له ، ان الذين تدعون من دون الله لن يخلقوا ذبابا ولو اجتمعوا له ، وان يسلبهم الذباب شيءا لا يستنقذوه منه ، ضعف الطالب والمطلوب . ما قدروا الله حق قدره ان الله لقوي عزيز الحج :    .  وقال تعالي : يوم يكشف عن ساق ويدعون الي السجود القلم :  . وانما يراد بذلك الشدة  العرب تفرق فتقول : كشف عن ساقه ، وحسر عن ذراعه ، واسفر عن وجهه . هذا هو الفصيح ، وربما وضعت هذه الافعال بعضها موضع بعض ولا يفسد الكلام . وقال عز وجل : اانا لمردودون في الحافرة النازعات :  . وقال سبحانه : مثل الذين ينفقون اموالهم في سبيل الله كمثل حبة انبتت سبع سنابل في كل سنبلة ماءة حبة والله يضاعف لمن يشاء والله واسع عليم البقرة :  . العرب تقول : عاد فلان في حافرته ، اي عاد الي طريقه الاولي . ومن الامثال الماخوذة عن النبي صلي الله عليه السلام اياكم وخضراء الدمن . فهذا كلام مفهوم من لفظه ، والمراد به غير خضراء الدمن ، فلما سءل عنها قال : المراة الحسناء في منبت السوء . وقال صلي الله عليه وسلم : ان مما ينبت الربيع ما يقتل حبطا او يلم . يريد بذلك علي ما في عاقبة الغني وزخرف الدنيا وزبرجها من الخطر ، وان من ذلك ما يءدي الي هلاك المرء في دينه واخرته . وقال صلي الله عليه وسلم : مثل المءمن كمثل الخامة من الزرع تفيءها الريح مرة هاهنا ومرة هاهنا ، ومثل الكافر كمثل الارزة المجذية علي الارض حتي يكون انجعافها  مرة . الخامة من الزرع قصبته ويقال : الاصل خامة ، والارزة العرعرة ، وهي شجرة صلبة ، والمجذية القاءمة ، الانجعاف الانقلاع . وقوله عليه السلام : الايمان قيد الفتك . وليس هناك قيد ، وانما معناه الاسلام حاجز عما حظره . وقوله عليه السلام في اهل الاسلام والشرك : لا تراءي ناراهما . وقوله صلي الله عليه وسلم : لا ترفع عصاك عن اهلك . وقد قال صلي الله عليه وسلم : لا يلسع المءمن من حجر مرتين . ولا ينتطح فيها عنزان ، تسهيلا لامر القتل لان العنز انما تشام في نطاحها وترجع . وقال عليه السلام : كل ما اصميت ودع ما انميت . العرب تقول : رمي فاصمي اذا اثقله فلم يتحامل ، ورمي فانمي اذا تحامل بالرمية ، ورومي فاشوي اذا اصاب غير المقتل ، والشوي الاطراف . منتهي التمثيل في لفظ افعل التفضيل ويقع التمثيل به في معان كثيرة جدا ، والعرب تقول : هو اعز من الابلق العقوق ، تعني في الشء الذي لا يوجد ، لان العقوق انما هو في الاناث دون الذكور . وكان المفضل يخبر ان المثل لخالد بن مالك النهشلي ، قاله للنعمان ابن المنذر ، وكان اسر ناسا من بني مازن بن تميم ، فقال : من يكفل  هءلاء ؟ فقال خالد : انا ، فقال النعمان : وبما احدثوا ؟ فقال خالد : نعم وان كان الابلق العقوق . فذهبت مثلا . قال الاصمعي : اذا ارادوا العز والمنعة قالوا : انه لامنع من ام قرفة ، وهي امراة مالك بن حذيفة بن بدر ، كان يعلق في بيتها خمسون سيفا كلهم محرم . وقال غير الاصمعي : هي بنت ربيعة بن بدر الفزارية . ومن امثالهم : هو اعز من كليب واءل ، وهو كليب بن ربيعة التغلبي ، كان اعز العرب في دهره ، فقتله جساس بن مرة ، ففيه كانت حرب بكر وتغلب ابني واءل ، وهي حرب البسوس . ويقال : هو اعز من مروان القرظ ؛ اعز من الزباء اعز من الزباء اعز من حليمة ؛ اعز من عقاب الجو ؛ اعز من قنوع ؛ امنع من لهاة الليث ؛ اعز من است النمر . ويقولون : هو اذل من فقع القرقر ؛ وهو اذل من وتد ، وذلك لانه يدق . وانه لاذل من يد في رحم ، ومعناه ان صاحبها يتوق ان يصيب بيده شيءا ؛ وهو اذل من الحوار ؛ واذل من عير ؛ اذل من حمار قعيد ، اذل من قيسي بحمص ؛ اذل من النقد ؛ اذل من قراد .  ويقولون : هو احلم من الاحنف ؛ احلم من قيس بن عاصم ، واخبارهما قد وردت في مكان اخر . ويقولون هو اجود من حاتم ؛ واجود من كعب بن مامة ؛ اجود من هرم واخبارهم مشهورة ، واجود من لافظة يقال : انها الرحي سميت بذلك لانها تلفظ ما تطحنه ، وقيل : انها العنز ، وجودها انها تدعي الي الحلب وهي تعتلف ، فتلقي ما في فيها وتميل للحلب . ويقال : هو اشجع من ليث عفرين قال ابو عمرو : هو الاسد . وقال الاصمعي : هو دابة مثل الحرباء تتعرض للراكب ، وهو منسوب الي عفرين اسم بلد ؛ وهو اجرا من خاصي الاسد ؛ واجرا من ذي لبد ؛ واشجع من اسامة ؛ واجرا من قسورة ؛ واجرا من ليث بخفان خادر . قال الشاعر : من الطويل فتي كان احيا من فتاة حيية . . . واشجع من ليث بخفان خادر ويقولون : انه لاجبن من المنزوف ضرطا . قال ابراهيم بن ابان :  المنزوف دابة تكون في البادية ، اذا صحت بها لم تزل تضرط حتي تموت ؛ واجبن من صافر ، وهو ما يصفر من الطير ، ولا يكون الصفير في سباع الطير ، انما يكون في خشاشها وما يصاد منها . واجبن من صفرد . ويقولون : ابخل من مادر ، لاط حوضه وسقي منه ، فلما استغني عنه سلح فيه لءلا يستقي منه غيره . ابخل من ذوي معذرة ؛ ابخل من الضنين بناءل غيره . ويقولون : اقري من ازواد الركب ؛ وهم ثلاثة نفر من قريش ؛ اقري من غيث الضريك ، وهو قتادة بن مسلمة الحنفي ؛ اقري من مطاعيم الريح ؛ وهم اربعة : احدهم ابو محجن الثقفي ، وقد كان لبيد بن ربيعة العامري يطعم اذا هبت الصبا الي ان تنقضي . اوفي من عوف بن محلم ؛ وخبره مع مهلهل ، اخي كليب ، لما امنه يوم التحالق مشهور ؛ اوفي من السموال ، وخبره مشهور ؛ اوفي من الحارث ، يقول نصر : هو الحارث بن عباد . ويقولون : هو احسن من الطاووس ؛ واجمل من ذي العمامة ، وهو سعيد بن العاص بن امية ويكني ابا احيحة ، وله يقول الشاعر : من البسيط ابو احيحة من يعتم عمته . . . يضرب وان كان ذا مال وذا ولد  ويقولون : انه لامضي من السهم ؛ وامضي من سليك المقانب . ويقولون : اعلي فداء من حاجب بن زرارة ؛ ومن بسطانم بن قيس ؛ ومن الاشعث ، اسرته مذحج ففدي نفسه بثلاثة الاف بعير . ويقولون : افتك من البراض ، وافتك من الحارث بن ظالم . ويقولون : انجب من مارية ، ولدت لزرارة حاجبا ولقيطا وعلقمة ؛ انجب من بنت الخرشب ولدت لزياد العبسي بنيه الكملة وهم : ربيع الكامل ، وعمارة الوهاب ، وقيس الحفاظ ، وانس الفوارس ؛ انجب من ام البنين ، ولدت لمالك بن جعفر بن كلاب : ملاعب الاسنة عامرا ، وفارس قرزل طفيلا ، وربيع المقترين ربيعة ، ونزال المضيق سلمي ، ومعود الحكماء معاوية ، انجب من عاتكة ، ولدت لعبد مناف هاشما وعبد شمس والمطلب . ويقولون : اسرع من نكاح ام خارجة ، وهي بنت سعد بن قدار من بجيلة ، ولدت في نيف وعشرين حيا من العرب من اباء ، ؟ وكان الرجل يقول لها : خطب فتقول : نكح . كذلك قال يونس بن حبيب ، وقد قيل خطب ونكح . فنظر بنوها الي عمرو بن تميم قد ورد بلادهم ، فاحسوا بانه اراد  امهم ، فبادروا اليها ليمنعوه من تزوجها ، وسبقهم لانه كان راكبا ، فقال لها : ان فيك لبقية ، فقالت : ان شءت . فجاءوا وقد بني عليها ، ثم نقلها بعد الي بلاده . فزعم الرواة انها جاءت معها بالعنبر صغيرا ، وانه ابن عمرو بن بهراء ، وبهراء من قضاعة ، واولدها عمرو بن تميم اسيدا والهجيم والقليب ، فخرجوا ذات يوم يستسقون ، فقل عليهم الماء ، فانزلوا ماءحا من تميم ، فجعل الماءح يملا الدلو اذا كانت للهجيم واسيد والقليب ، فاذا وردت دلو العنبر تركها تضطرب ، فقال العنبر : من الرجز قد رابني من دلوي اضطرابها . . . والناي عن بهراء واغترابها الا تجء ملاي تجء قرابها الماءح الذي يستقي من اسفل البءر ؛ والماتح الذي يستقي من اعلاها . ويقولون : اسرع من العين ؛ ومن طرف العين ؛ ومن لمح البصر ؛ واسرع من اليد الي الفم ؛ واعجل من نعجة الي حوض ؛ واسرع من دمعة الخصي . ويقولون : اعدا من السنفري ؛ اعدا من السليك ، اسرع من عدوي الثءباء ، وذلك ان الانسان اذا تثاءب اعدي غيره . ويقولون : ابطا من فند ، وهو مولي لعاءشة بنت طلحة ، بعثت به مولاته ليقتبس نارا ، فاتي مصر فاقام بها سنة ، ثم جاء يشتد ومعه نار ، فتبددت  ناره ، فقال : تعست العجلة . ويقولون : احذر من غراب ؛ احذر من ذءب ؛ احذر من عقعق ؛ اروغ من ثعالة ؛ اختل من ثعالة ، واختل من ذءب . ويقولون : اخنث من هيت ؛ اخنث من طويس ، وهما مخنثان ؛ اخبث من ذءب الخمر ؛ واخبث من ذءب الغضا . ويقولون : انه لاصنع من تنوط ، وهو طاءر يصنع عشه مدلي من الشجر ؛ واصنع من سرفة ، وهي دودة تكون في الحمض تصنع بيتها مربعا من قطع العيدان . ومن امثالهم : هو اصدق من قطاة ، وذلك لانها تقول : قطا قطا فاسمها من صوتها ، قال النابغة : من البسيط تدعو القطا وبه تدعي اذا انتسبت . . . يا صدقها حين تدعوها فتنتسب ويقال : لاكذب من الشيخ الغريب ؛ واكذب من اخيذ الجيش ، قيل : هو الذي ياخذه اعداءه فيستدلونه علي قومه ، فهو يكذبهم بجهده ، وهو اكذب من الاخيذ الصبحان ؛ واكذب من المهلب ، وكان يكذب لاصحابه في الحرب ، يعدهم بالنجدة والامداد ؛ واكذب من اسير السند .  ومن امثالهم : انه لاحمق من تراب العقد ، يعني عقد الرمل ، قيل : وحمقه انه ينهار ولا يثبت . قال الفراء : انه لاحمق من راعي ضان ثمانين ، قال وذلك ان اعرابيا بشر كشري بشارة سر بها فقال : سلني ما شءت ، قال : اسالك ضانا ثمانين ؛ احمق من العقعق ، وحمقه ان ولده ابدا ضاءع ؛ احمق من رخمة ، احمق من الحباري ، احمق من رجلة ، وهي البقلة الحمقاء ؛ احمق من الممتخط بكوعه ؛ احمق من الممهورة احدي خدمتيها ، قال : وذلك ان زوجها قضي حاجته منها ثم طلقها ، فقالت : اعطني مهري ، فاخذ احد خلخاليها من رجلها فاعطاها اياه ، فرضيت به وسكتت ، وانه : لاحمق من دغة ، وهي امراة عمرو بن جندب بن العنبر ، وخبرها في حمقها قبيح مستهجن ذكره ؛ واحمق من حمامة ، وذلك انها تبيض علي الاعواد ، فربما وقع بيضها فانكسر ، واحمق من الضبع ؛ واحمق من ناكثة غزلها ، وهي امراة من قريش . اتيه من احمق ثقيف وهو يوسف بن عمر . وفي الخبر : سيكون في ثقيف كذاب ومبير واحمق ؛ قيل : الكذاب المختار ، والمبير الحجاج ، والاحمق يوسف . ومن امثالهم : ابل من حنيف الحناتم ؛ ابل من مالك بن زيد مناة . ومنها : هو ابلغ من سحبان واءل ؛ وابين من قس ؛ واخطب  من قس ؛ وهو اعيا من باقل ، وهو رجل من ربيعة كان عييا فدما . وهو اخلي من جوف حمار ، وهو رجل من عاد ، وجوفه واد كان ينزل به ، فلما كفر اخرب الله واديه . ومنها : اخجل من مقمور . واطمع من اشعب . ويقولون : ازهي من غراب ، واخيل من مذالة ، يضرب للمتكبر في نفسه ، وهو عند الناس مهين ، والمذالة الامة الماهنة ، وهي في ذلك تتبختر ، واخيل من واشمة استها ؛ و ازهي من ثعلب . ومن امثالهم : هو ابصر من غراب ؛ ابصر من الزرقاء ، وهي زرقاء اليمامة ؛ ويقال : هو اسمع من فرس ؛ واسمع من قراد ؛ اسمع من سمع ازل . ويقال : هو انوم من فهد ؛ وانوم من غزال ، وانعس من كلب ، وانوم من عبود ، وهو عبد نام في محتطبه اسبوعا ، واذا ارادوا خفة النوم قالوا : اخف راسا من الذءب ؛ واخف راسا من الطاءر . ويقولون : املخ من لحم الحوار اي ليس له طعم .  ومن امثالهم : اظلم من الحية ، ومن حية الوادي ، واظلم من ذءب ، اظلم من الجلندي ، واظلم من التمساح . ومن امثالهم : انه لالص من شظاظ ، وهو رجل من بني ضبة كان لصا مغيرا فصار مثالا ، وله خبر غريب قد ذكر في باب الحيل ؛ واسرق من جرذ ؛ والص من عقعق ؛ واخطف من عقاب . ويقال : انه لاصرد من عنز جرباء للذي يشتد عليه البرد . ومن امثالهم : انه لاطيش من فراشة . ويقولون : انه لاجوع من كلبة حومل ، وهي كلبة كانت في الامم السالفة ، واجوع من زرعة وهي كلبة ؛ واجوع من ذءب ؛ واجوع من قراد . ويقال : انه لافحش من فاسية ، يريد الخنفساء ، وذلك انها اذا حركت نتنت ، وابذي من مطلقة ؛ واقود من ظلمة ، والوط من دب ،  واسفد من ديك ؛ واسفد من عصفور ، وازني من سجاح ، وازني من قرد ، وهو قرد بن معاوية بن هذيل ؛ وازني من هر وهي امراة يهودية ، وهي التي قطع المهاجر يدها في من قطع من النساء حين شمتن بموت النبي صلي الله عليه وسلم ؛ واشبق من حبي المدينية ؛ واسلح من دجاجة ، واسلح من حباري . ويقولون : انه لابر من العملس ، وكان رجلا برا بامه حتي كان يحملها علي عاتقه ؛ وابر من فلحس ، وهو رجل من شيبان حمل اباه علي ظهره وحج به ؛ وانه لاعق من ضب وذلك لانه ياكل ولده . ويقولون : انه لاحيا من ضب ، من الحياة وذلك اطول من ذماء الضب ، واطول ذماء من الحية ، واطول صحبة من الفرقدين ، واطول من اللوح ، واطول من السكاك . ومن اماثلهم : اصبر من عود بدفيه الجلب ، والدفان الجنبان ، والجلب اثار الدبر ؛ واصبر من جذل الطعان ؛ واصبر من ضب . ويقال : انه لادم من البعرة ، في دمامة خلقته . وانه لاعري من المغزل ؛ واكسي من البصل . ومن امثالهم : وانه لابعد من بيض الانوق ، وذلك انها لا تبيض الا  في قلل الجبال ؛ وابعد من النجم ، واناي من الكواكب ؛ وارفع من السماء ، ابعد من مناط العيوق . ويقولون : انه لانم من صبح ، اذ كان لا يكتم شيءا ، وقد جاء في شعر محدث : من الوافر انم من النسيم علي الرياض . . . انم من الرياض علي السحاب انم من الزجاج . ومن امثالهم : انه لاسال من فلحس ، وهو الذي يتحين طعام الناس ، يقال منه اتانا يتفلحس ، وهو الذي تسميه العامة الطفيلي . وقال ابن حبيب : هو رجل من شيبان ، كان سيدا عزيزا يسال سهما في الجيش وهو في بيته ، فيعطي فاذا اعطيه سال لامراته ، فاذا اعطي سال لبعيره ، وكان له ابن يقال له زاهر فكان مثله ، فقيل له : العصا من العصية . ويقولون : امطل من عرقوب ، وخبره يجء فيما بعد . ويقولون : انه لاشهر من فارس الابلق ؛ واشهر من الشمس ، واشهر من البدر ، واشهر من القمر ؛ واشهر من قطرب . ومن امثالهم : انه لاروي من النقاقة ، وهي الضفدع ، وذلك ان مسكنها الماء ؛ واروي من ضب ، لانه لا يشرب الماء ، واروي من الحوت ، واظما من حوت ايضا .  ومن امثالهم : هو اشام من خوتعة ، وهو رجل من بني عميلة بن قاسط ، اخي النمر بن قاسط ، وكان مشءوما ؛ واشام من قدار ، وهو عاقر الناقة ؛ واشام من احمر عاد ، وهو عاقرها ايضا ، وانما هو احمر ثمود ؛ واشام من طويس ، وهو مخنث كان يقول : ولدت يوم مات رسول الله صلي الله عليه وسلم ، وفطمت يوم مات ابو بكر رضي الله عنه ، وبلغت الحنث يوم قتل عمر رضي الله عنه ، وتزوجت يوم قتل عثمان ، وولد لي ليلة قتل علي عليه السلام ، واشام من الاخيل وهو الشقراق ، واشام من منشم ، وهي امراة عطارة ، قال زهير : من الطويل تداركتما عبسا وذبيان بعدما . . . تفانوا ودقوا بينهم عطر منشم اشام من غراب البين ؛ ابين شءما من زحل ؛ اشام من البسوس ، وهي ناقة كانت لخالة جساس بن مرة ، رماها كليب بسهم فاختلط لبنها ودمها ، فكانت سب قتله ، وفيها كانت حرب بكر وتغلب . ومن امثالهم : هو اصح من عير ابي سيارة ، قال الاصمعي : دفع بالناس من جمع اربعين سنة علي حماره . ويقولون : انه لاخيب صفقة من شيخ مهو ، وهم حي من عبد  القيس ، لهم في هذا المثل قصة قبيحة : اشتري الفسو من اياد  وكانوا يعرفون به  ببردي حبرة ، فعرفت بعد ذلك عبد القيس بالفسو ، ويروي احمق من شيخ مهو ، ويقال : اخسر صفقة من ابي غبشان ، باع مفاتيح الكعبة من قصي بزق من خمر . ومن امثالهم : اهون مقتول ام تحت زوج ، واصله ان ربيعة البكاء ، وهو ربيعة بن عامر بن ربيعة بن عامر بن صعصعة ، راي امه تحت زوجها ، فقدر انه يقتلها ، فبكي وصاح ، فسمي البكاء ، وقيل فيه هذا المثل ، وضرب به المثل في الحمق ، وقيل احمق من ربيعة البكاء ؛ وقد قال الشاعر في الحمق : من الطويل رمتني بنو عجل بداء ابيهم . . . وهل احد في الناس احمق من عجل قالوا : كان له فرس جواد فقيل له : لكل جواد من خيل العرب اسم ، فما اسم جوادك ؟ ففقا عينه وقال : اسميه الاعور . اهون من تبالة علي الحجاج ، وتبالة بلد صغير من بلدان اليمن ، يقال انها اول بلدة وليها الحجاج ، فلما سار اليها قال للدليل : اين هي ؟ قال : قد سترتها عنك هذه الاكمة ، فقال : اهون بعمل بلدة تسترها الاكمة ، ورجع . اهون من قعيس علي عمته ، رهنته علي صاع من بر فلم تفتكه . اهون هالك عجوز في عام سنة ، اهون مظلوم عجوز معقومة ، اهون مظلوم سقاء مروب ، اصله السقاء يلف حتي يبلغ اوان المخض ، والمظلوم السقاء الذي  يمخضن قبل اوان المخض ، اهون من الشعر الساقط ؛ اهون من ذباب . ومن امثالهم : اضل من موءدة ؛ اضل من سنان ؛ اتيه من فقيد ثقيف ؛ اما سنان فهو ابن ابي حارثة المري ، وكان قومه عنفوه علي الجود ، فركب ناقة ورمي بها الفلاة ، فلم ير بعد ذلك ، وسمته العرب ضالة غطفان ، وقالوا : ان الجن استفحلته تطلب كرم نجله ؛ واما فقيد ثقيف فهو الذي هوي امراة اخيه فتاخيا ، وله قصة طويلة . وهو اضل من ولد اليربوع ؛ واضل من قارظ عنزة ، ويقولون : هو اهدي من النجم ؛ واهدي من اليد الي الفم . ومن امثالهم : احيا من هدي ؛ احيا من فتاة ؛ احيا من مخباة ؛ احلي من ميراث العمة الرقوب ؛ واحلي من الولد ؛ واحني من الوالد ؛ وقال اعرابي : هو افرح من المضل الواجد ، والظمان الوارد ، والعقيم الوالد . ومن امثالهم : ادهي من قيس بن زهير ؛ اشد من لقمان بن عاد ؛ ابطش من دوسر ، وهي كتيبة النعمان ، ارمي من ابن تقن ، وهو رام كان في زمن لقمان بن عاد ، وكان ينافر لقمان حتي هم بقتله . افرغ من حجام ساباط ؛ افرغ من يد تفت اليرمع . يقال ان حجام ساباط كان اذا اعوزه من يحجمه حجم امه ، فلم يزل بها حتي نزف دمها وماتت .  اغزل من امرء القيس . اكفر من ناشرة ، من كفران النعمة . انعم من خريم ، رجل من ولد سنان بن ابي حارثة ، كان في زمن الحجاج ، انعم من حيان اخي جابر . ومن امثالهم : انكح من ابن الغز ، هو رجل من اياد كان ينام فتاتي الفصلان تحتك بذكره تحسبه اصل شجرة ، وله خبر مشهور مع شيرين زوجة كسري ، ولاجله نفي ايادا الي ارض الروم . انكح من جويرية ، وهو رجل من عبد القيس . اشغل من ذات النحيين ، هي امراة من هذيل ، وخبرها مع خوات بن جبير اشهر من ان يذكر . ويقولون : هو الزم لليمين من الشمال ؛ والزم لك من شعرات قصك ، وذلك لانها كلما حلقت نبتت . ويقولون : هو اندم من الكسعي ، وكان ارمي الناس لا يخطء له سهم ، فرمي في الليل فانفذ ، فظن انه اخطا ، فخلع ابهامه ، فلما اصبح راي رميته فندم علي ما فعل بنفسه .  ويقولون : هو ابكي من يتيم ؛ ادني من حبل الوريد ؛ احقد من جمل ؛ اخلف من ثيل البعير ؛ اشرب من الهيم ؛ اغير من الفحل ؛ اثقل من حمل الدهيم ، وهي ناقة لها خبر يجء في مكان اخر ، انفر من ظبي ، وشرحه يرد في مكان غير هذا . ومن امثالهم : اقصر من انملة ؛ اقصر من ظمء الحمار ؛ اقصر من ابهام القطاة ؛ اقصر من ابهام الحباري ؛ اصغر من صعوة ؛ اصغر من قراد ؛ اقصر من ابهام الضب ؛ اصغر من صءابة ؛ اضعف من بعوضة . امن من ظبي بالحرم ؛ امن من حمام مكة ، الف من حمام مكة ؛ الف من كلب . اوقل من وعل . ابلد من ثور ؛ ابلد من سلحفاة . ابخر من اسد ؛ ابخر من صقر . ؟  احرص من ذءب ؛ اكسب من ثعلب ، اكسب من ذر ؛ اكسب من النمل . احرس من كلب ؛ اوقح من ذءب ؛ الام من كلب عقور ؛ اكل من السوس ؛ افسد من السوس ، افسد من الجراد ، احطم من جراد ؛ اجرد من جراد ، اجرد من صلعة ؛ اجمع من ذرة ؛ ادب من قراد ، ادب من قرنبي ؛ انزي من الجراد ، الح من الذباب ؛ الح من الخنفساء ؛ اشرد من ورل ؛ اعقد من ذنب الضب ؛ اسبح من نون ؛ اكثر من النمل ، اثبت من قراد ، اكثر من الدباء ؛ اخشن من الشيهم ؛ اخف حلما من العصفور . ويقولون : هو ادب من الشمس الي غسق الظلمة ؛ ارق من الهواء ، اضيع من قمر الشتاء . اقفط من تيس بني حمان ، يزعمون انه فقط سبعين عنزا بعد ما فريت اوداجه .  غلبة الاقدار والجدود من امثالهم في هذا : حارب بجد او دع ؛ ويقال : عارك . اذا جاء القدر عشي البصر ؛ قاله ابن عباس لنافع بن الازرق لما ساله عن الهدهد ونظره الي الماء من تحت الارض ، ولا يري الفخ تحت التراب ، وفي الخبر : لا حذر من قدر . وقال اكثم بن صيفي : من مامنه يءتي الحذر . وتمثل به عمر ابن الخطاب رضي الله عنه علي المنبر وقد ذكر ما كان عليه في الجاهلية وما ال امره اليه من الخلافة : من المتقارب هون عليك فان الامور . . . بكف الاله مقاديرها فليس باتيك منهيها . . . ولا قاصر عنك مامورها وقال عبد الله بن يزيد الهلالي : من الكامل الجد املك بالفتي من نفسه . . . فانهض بجد في الحوادث او ذر  ما اقرب الاشياء حين يسوقها . . . قدر وابعدها اذا لم تقدر وقال السموال بن عاديا : من المتقارب فلسنا باول من فاته . . . علي رفقه بعض ما يطلب وقد يدرك الامر غير الاريب . . . وقد يصرع الحول القلب وقال فيها : ولكن لها امر قادر . . . اذا حاول الامر لا يغلب وقال توبة بن مضرس : من الطويل تجوز المصيبات الفتي وهو عاجز . . . ويلعب صرف الدهر بالحازم الجلد ومن امثالهم : كيف توقي ظهر ما انت راكبه ؛ وقال شريح في الذين فروا من الطاعون : انا واياهم من طالب لقريب . وقال نصيب : من الطويل ومن يبق مالا عزة وصيانة . . . فلا الدهر مبقيه ولا الشح وافره ومن يك ذا عود صليب يعده . . . ليكسر عود الدهر فالدهر كاسره وقال اخر : من الرجز  والسبب المانع حظ العاقل . . . هو الذي سب رزق الجاهل وقال اخر : من الطويل يخيب الفتي من حيث يرزق غيره . . . ويعطي الفتي من حيث يحرم صاحبه نظر اليه المتنبي فقال واحسن وزاد : من الطويل ويختلف الرزقان والسعي واحد . . . الي ان تري احسان هذا لذا ذنبا وقال بشار : من الكامل تاتي اللءيم وما سعي حاجاته . . . عدد الحصي ويخيب سعي الداءب ومن امثالهم : لا جد الا ما اقعص عنك ما تكره ، قاله معاوية حين مات عبد الرحمن بن خالد بن الوليد ، وكان خافه علي الامر . وقال معاوية ايضا حين مات الاشتر من شربة عسل : ان لله جنود منها العسل ، وقالت جنوب اخت عمرو ذي الكلب : من البسيط كل امرء بطوال العيش مكذوب . . . وكل من غالب الايام مغلوب وقال النابغة : من البسيط ما يطلب الدهر تدركه مخالبه . . . والدهر بالوتر ناج غير مطلوب  وقال اخر : من الطويل لعمرك ما يدري امرء كيف يتقي . . . اذا هو لم يجعل له الله واقيا وقال ابو قلابة الهذلي : من البسيط ان الرشاد وان الغي في قرن . . . بكل ذلك ياتيك الجديدان لا تامنن وان اصبحت في حرم . . . ان المنايا بجنبي كل انسان ولا تقولن لشء لست افعله . . . حتي تبين ما يمني له الماني اي يقدر لك القادر الله تعالي . وقال اخر : من الطويل ومن كان مسرورا بطول حياته . . . فاني زعيم ان سيصرعه الدهر وقال ابن الرومي : من الكامل طامن حشاك فان دهرك موقع . . . بك ما تخاف من الامور وتكره واذا حذرت من الامور مقدرا . . . وفررت منه فنحوه تتوجه الحنكة والتجارب ويقولون في امثالهم : انا ابن بجدتها .  ويقولون : حلب الدهر اشطره ، اي اختبر الدهر شطريه من خير وشر . واصله من حلب الناقة ، يقال : حلبتها شطرها اي نصفها ، وذلك انه حلب خلفين من اخلافها فهو شطر ، ثم يحلبها الثانية خلفين ايضا فيقول : حلبتها شطرين ، ثم يجمع فيقول : اشطر . ويقولون : فلان مءدم مبشر ، وهو الذي يجمع لينا وشدة ، واصله من ادمة الجلد ، وهي باطنه ، وبشرته وهي ظاهره . ويقولون : عند جهينة الخبر اليقين ، ويروي جفينة ، ولذلك خبر معروف متداول ، وهو رجل كان عنده خبر من قتل قد خفي امره . وقال المنذر بن الحباب بن الجموح الانصاري يوم السقيفة : انا جذيلها المحكك وعذيقها المرجب ؛ الجذيل تصغير الجذل ، وهو اصل الشجرة تقطع اغصانها وتبقي قاءمة ، فتجء الجرباء من الابل فتحتك به ، وهو يسمي جذل الحكاك ، واما العذيق فهو تصغير العذق ، وهي النخلة نفسها اذا كرمت حملت ما لا تطيقه ، فتنحني فتبني في اصلها دعامة تعتمد عليها ، فذلك الترحيب . وقال علي عليه السلام : راي الشيخ خير من مشهد الغلام ، فصار هذا الكلام مثلا متداولا ، ويقولون في التجارب : رجل منجذ . وانشد  الاصمعي : من الوافر اخو الخمسين مجتمع اشدي . . . ونجذني مداورة الشءون ويقولون في الخبر : كفي برغاءها مناديا . اعط القوس باريها . ومن امثالهم : من يشتري سيفي وهذا اثره ، يدل اثره علي مخبره . ويقولون : اتعلمني بضب انا حرشته . انت اعلم باللقمة ام من غص بها ، اي الغاص باللقمة اخبر بها . الخيل اعلم بفرسانها . الجواد عينه فراره . عين عرفت فذرفت . افواهها مجاسها ، اصله ان الابل اذا احسنت الاكل اكتفي الناظر بذلك عن معرفة سنها واستغني عن جسها .  رب لحظ اصدق من لفظ . ليس الخبر كالعيان . است الباءن اعلم . كمعلمة امها البضاع . اني اذا حككت قرحة ادميتها ، المثل لعمرو بن العاص ، وكان انعزل في خلافة عثمان رضي الله عنه ، فلما بلغه حصره وقتله ، قال : انا ابو عبد الله ، اني اذا حككت قرحة ادميتها ، فسارت مثلا ، يعني انه كان يظن هذا الامر واقعا فكان كما ظن . ومن امثالهم في المجرب للامور : العوان لا تعلم الخمرة . ويقولون : اذا هززت فاهتز ، واذا رمي بك فارتز . الاخذ بالحزم والاستعداد للامر ومن كلام لرسول الله صلي الله عليه وسلم : اعقل وتوكل . ومن كلام العرب وامثالهم : عش ولا تغتر . ان ترد الماء بماء اكيس . معني الاول ان يمر صاحب الابل بالارض  المكلءة فيقول : ادع ان اعشي ابلي منها حتي ارد علي اخري ، ولا يدري ما الذي يرد عليه . وتاويل المثل الثاني : ان الرجل يمر بالماء فلا يحمل منه اتكالا علي ماء اخر يصير اليه ، فيقال له : ان تحمل معك ماء احزم لك ، وان اصبت ماء اخر لم يضرك ، وان لم تحمل فاخفقت من الماء عطبت . قال حماد الراوية : انشدت ابا عطاء السندي هذا البيت : من المتقارب اذا كنت في حاجة مرسلا . . . فارسل حكيما ولا توصه فقال ابو عطاء : بءس ما قال ، فقلت : فكيف كان يقول ؟ قال : كان يقول : من الوافر اذا ارسلت في امر رسولا . . . فافهمه وارسله اديبا فان ضيعت ذاك فلا تلمه . . . علي ان لم يكن علم الغيوبا ومن امثالهم : قد احزم لو اعزم . وقال الشعبي : اصاب متامل او كاد ، واخطا مستعجل او كاد . ومنه قول القطامي : من البسيط قد يدرك المتاني بعض حاجته . . . وقد يكون مع المستعجل الزلل  ومن امثالهم في الجد : اجمع جراميزك ؛ واشدد حزيمك ؛ بينه قول علي عليه السلام : من الهزج اشدد حيازيمك للموت . . . فان الموت لا قيكا ويقولون في مثله : اتخذ الليل جملا ؛ هذا اوان الشد فاشتدي زيم ، وزيم هاهنا اسم فرس ، وهو في موضع اخر المتفرق ؛ ولتخرم فاذا استوضحت فاعزم ؛ قال بشار : من الطويل وخل الهوينا للضعيف ولا تكن . . . نءوما فان الحزم ليس بناءم ومن امثالهم : اشتر لنفسك وللسوق . ومنها : قبل الرمي يراش السهم . ومنها : قبل الرمي تملا الكناءن . دمث لنفسك قبل النوم مضطجعا ، وقال الحمال العبدي : من الطويل اذا خفت في امر عليك صعوبة . . . فاصحب به حتي تذل مراكبه  وقال بعض بني سدوس : من الكامل واذا ظلمت فكن كانك ظالم . . . حتي يفء اليك حقك اجمع ومن امثالهم : رمت المحاجزة قبل المناجزة . الفرار بقراب اكيس . المثل الاول لاكثم بن صيفي ، والثاني لجابر بن عمرو المازني ، وذلك انه كان يسير يوما في طريق اذ راي رجلين شديدا كلبهما عزيزا سلبهما ، فقال : الفرار بقراب اكيس ثم مضي . انج يا ثعالة فالقتل لا شوي له . ويقولون : زاحم بعود او دع ، اي لا تستعن الا باهل القوة ، وقال الشاعر : من الطويل اذا المرء لم يبدهك بالحزم كله . . . قريحته لم تغن عنك تجاربه ومن امثالهم في الاستعداد : مخرنبق لينباع ، اي مطرق ليثب . ونحوه : تحسبها حمقاء وهي باخس . وقولهم : اطري فانك ناعلة ، اي اركب الامر الشديد فانك قوي عليه . واصل هذا ان رجلا قال لراعية له ، وكانت ترك الحزونة وترعي في السهولة ، اطري : خذي طرر الوادي ، وهي نواحيه . قال ابو عبيد : احسبه  يعني بالنعلين غلظ جلد القدمين . ومن التحذير والحزم : قولهم : انج سعد فقد هلك سعيد . ومن امثالهم في الجد : قرع له ساقه ، وقرع له ظنبوبه . ويقولون : عدوك اذ انت ربع ، يءمر الرجل بان ياتي من الحزم ما كان ياتيه من قبل . ما جاء في الاغترار والتحيل والاطماع وما يقارب هذه المعاني النساء حباءل الشيطان ، قاله ابن مسعود رضي الله عنه . ومن امثالهم : مرعي ولا اكولة ، عشب ولا بعير . وقد يقع هذان المثلان في معني وجود الشء حيث لا ينتفع به . برد غداة غر عبدا من ظما ، وذلك انه خرج في برد غداة ولم يتزود الماء لما راي من روح النهار ، فلما حميت عليه الشمس بالفلاة هلك عطشا . ليس باول من غرة السراب . ومن امثالهم : كيف بغلام قد اعياني ابوه ، ومنه قول الشاعر :  من البسيط ترجو الصغير وقد اعياك والده . . . وما رجاءك بعد الوالد الولدا ويشبهه قول الفرزدق وان كان اراد به الهجاء : من الطويل ترجي ربيع ان تجء صغارها . . . بخير وقد اعيا ربيعا كبارها ويقولون : يا عاقد اذكر حلا ، يضربون لمن يبالغ في الامر وينسي عاقبته ، واصله الذي يشد عليه رحله ويسرف في الاستيثاق . ويقولون : لا تقتن من كلي سوء جروا . والذءب خاليا اسد ، ومثله قول المتنبي : من الخفيف واذا ما خلا الجبان بارض . . . طلب الطعن وحده والنزالا ويقولون في الاطماع : اما كفي العبد ان ينام حتي يحلم برتبة . انك لا تجني من الشوك العنب . وقال كعب بن زهير : من البسيط فلا يغرنك ما منت وما وعدت . . . ان الاماني والاحلام تضليل  يقولون : انباض بغير توتير ، اي نبض القوس من غير ان يوترها . قد نفخت لو نفخت في فحم ، قاله الاغلب العجلي في شعر له . ويقولون : هو بنت الجبل ، يعنون الصدي ، اي هو مع كل من يتكلم . ويقولون ايضا : ما انت الا كابنة الجبل مهما يقل تقل . ومن كلام المهلبي في الاغترار : من ضاق الاسد قراه اظفاره ، ومن حرك الدهر اراه اقتداره . البر والعقوق والمحافظة علي الاهل والاخوان من امثالهم في هذه المعاني : منك عيصك وان كان اشبا ، اي منك اهلك وان كانوا علي خلاف ما تريد . ومثله : منك انفك وان كان اجدع . ومنه : الحفاظ يحلل الاحقاد ، ومنه قول القطامي : وترفض عند المحفظات الكتاءف والكتاءف السخاءم .  ويقولون : لا يعدم الحوار من امه حنة . لا يضر الحوار وطء امه . وقال الشاعر : من الطويل اخاك اخاك ان من لا اخا له . . . كساع الي الهيجا بغير سلاح وقال اخر : من الطويل وان ابن عم المرء فاعلم جناحه . . . وهل ينهض البازي بغير جناح والنصف الثاني من هذا البيت مثل ساءر . ويقال في الاخ متمسك باخاءه : ما عقلك بانشوطة . ومن ذلك قول ذي الرمة : من الطويل وقد علقت مي بقلبي علاقة . . . بطيءا علي مر الشهور انحلالها ويقولون : هو علي حبل ذراعك . ويقولون : لا تدخل بين العصا ولحاءها . وقال ابو الدرداء رضي الله عنه : معاتبة الاخ خير من فقده ،  فصارت مثلا . وقال طرفة بن العبد : من الطويل واعلم علما ليس بالظن انه . . . اذا مات مولي المرء فهو ذليل وقال بدر بن علماء العامري : من الطويل اذا سيم مولاك الهوان فانما . . . تراد به فاقصد له وتشدد وقال ابن المولي : من الطويل لا تطلبي عزا بذل عشيرة . . . فان الذليل من تذل عشاءره ولما قال الشاعر في جرير بن عبد الله البجلي : من الرجز لولا جرير هلكت بجيلة . . . نعم الفتي وبءست القبيلة قال قاءل : ما مدح من هجي قومه . ومن الامثال في العقوق : العقوق ثكل من لم يثكل . الملك عقيم . ومن امثال البر قول بيهس لامه لما قتل اخوته وعاد فحنت اليه وكانت من قبل تقصيه : الثكل ارامها .  وقالت له : اجءت من بينهم ؟ فقال : لو خيروك لاخترت . ومن امثالهم : وابابي وجوه اليتامي ، حكاه المفضل عن سعد القرقرة ، وهو رجل من اهل هجر كان النعمان يضحك منه ، فدعا بفرسه اليحموم ، وقال لسعد : اركبه فاطلب عليه الوحش ، قال سعد : اذن والله اصرع ، فابي النعمان الا ان يركبه ، فلما ركبه سعد نظر الي بعض ولده فقال : وابابي وجوه اليتامي . ومن كلامهم : انصر اخاك ظالما او مظلوما . ويقولون : اعن اخاك ولو بالصوت ، اي ان لم تقدر علي معونته بيدك فاستصرخ له حتي يغاث . ويقولون : مولاك ولا عناك . ومن الامثال في الحمية والانفة قول اكثم بن صيفي : تجوع الحرة ولا تاكل بثدييها . الفحل يحمي معقولا شوله . ومنه : الخيل تجري علي مساويها ، اي وان كان بها اوصاب وعيوب .  وقولهم : من عز بز ، قاله جابر بن الاف للمنذر . وقولهم : محا السيف ما قال ابن دارة اجمعا ، هو سالم بن دارة ، هجا فزارة فافحش فاغتاله احدهم فقتله . ومن الحمية قولهم : هاجت زبراء ، وهي امة كانت للاحنف كان يصغي الي قولها كثيرا ، ولها معه خبر قد ورد في موضعه ، والابيات الساءرة في هذا المعني كثيرة ، فمن ذلك قول عبد الله بن الزبير الاسدي : من البسيط فلن الين لغير الحق اساله . . . حتي يلين لضرس الماضغ الحجر وقال مالك بن الريب : من الطويل وما انا كالعير المقيم لاهله . . . علي القيد في بحبوحة الدار يرتع وقال النابغة : من البسيط تعدو الذءاب علي من لا كلاب له . . . وتتقي صولة المستاسد الحامي وقال معارك بن مرة العبدي : من الطويل اتطمع في هضمي لدن شاب عارضي . . . وقد كنت ابي الضيم اذ انا امرد وقال منقذ الهلالي : من الوافر  سءمت العيش حين رايت دهرا . . . يكلفني التذلل للرجال فحسبك بالتنصف ذل حر . . . وحسبك بالمذلة سوء حال وقال امرء القيس ويروي للخنساء : من المتقارب ساحمل نفسي علي الة . . . فاما عليها واما لها وقال ابي بن حمام بن قراد بن مخزوم العبسي : من الطويل ولست بمهياب لمن لا يهابني . . . ولست اري للمرء ملا يري ليا وقال العباس بن مرداس : من الطويل فخذها فليست للعزيز بخطة . . . وفيها مقال لامرء متذلل وقال محمد بن وهيب الحميري : من الطويل الا ربما كان التصبر ذلة . . . وادني الي الحال التي هي اسمج وقد يركب الخطب الذي هو قاتل . . . اذا لم يكن الا عليه معرج وقال مهيار فاحسن فجاز الحاقه بالتمثيل بالقدماء : من المنسرح فاقعد اذا السعي جر مهلكة . . . وجع اذا ما اهانك الشبع ومن امثالهم : لو كرهتني يدي لما صحبتني ؛ وقال الشاعر :  من الطويل فلو رغبت عني يميني قطعتها . . . وفيها لمن رام الوصال وصال ما جاء في الحلوم والثبات يشبه هذا المعني قوله صلي الله عليه وسلم : جدع الحلال انف الغيرة . ومن امثالهم : اذا نزا بك الشر فاقعد اي فاحلم ولا تسارع اليه . وقال الاحمر في مثله : الحليم مطية الجهول ، يعني انه يحتمل جهله ولا يءاخذ به . ومن امثالهم : انه لواقع الطاءر . وانه لساكن الريح . وهو واقع الغراب ؛ واقع الطير ، وقال الشاعر : من البسيط قل ما بدا لك من زور ومن كذب . . . حلمي اصم واذني غير صماء ومنه : ملكت فاسجح . قالته عاءشة لعلي عليه السلام يوم الجمل .  ومن امثالهم فيه : اذا ارجحن شاصيا فارفع يدا . يقول : اذا رايته قد خضع واستكان فاكفف عنه ، والشاصي الرافع رجله ، والمرجحن الساقط الثقيل . ومن امثالهم في الحلم والايقاظ له : من الطويل لذي الحلم قبل اليوم ما تقرع العصا . . . وما علم الانسان الا ليعلما قيل : هو عامر بن الظرب العدواني حاكم العرب ، عاش حتي انكر عقله ، فكان اذا زاغ في الحكم قرعت له العصا فينتبه ويعود الي الحق ؛ وقيل : اكثم بن صيفي ، وقيل : اول من قرعت له العصا سعد بن مالك الكناني ، وقيل و عمرو بن حممة الدوسي . ومن كلام العرب : عركت ذلك بجنبي اي احتملته . ربط بالامر جاشا اي وطن نفسه عليه . ما جاء في الصدق والكذب من امثال العرب : سبني واصدق . اذا سمعت بسري القين فانه مصبح . يضرب للكذوب ولا يصدق ولو صدق ، واصله ان القين اذا نزل بالحي قال لهم : اني اسري الليلة ، يحثهم بذلك علي معاملته ثم يصبح بمكانه .  ويقولون في كلامهم : من عرف بالصدق جاز كذبه ، ومن عرف بالكذب لم يجز صدقه . وقال حكيم : الصدق عز والكذب خضوع . ومن امثالهم : لا يكذب الراءد اهله . ومنها : الكذب داء والصدق شفاء . ومنها : ليس لمكذوب راي ، كان المفضل يحدث ان صاحب هذا المثل هو العنبر بن عمرو بن تميم قاله لابنته الهيجمانة ؛ وذلك ان عبد شمس بن سعد بن زيد مناة بن تميم كان يزورها ، فنهاه قومها فابي ، حتي وقعت الحرب بين قومه وقومها ، فاغار عليهم عبد شمس في جيشه ، فعلمت الهيجمانة فاخبرت اباها ، وقد كانوا يعلمون اعجاب الهيجمانة به كاعجابه بها . فلما قالت هذه المقالة لابيها قال مازن بن مالك بن عمرو بن تميم : حنت ولات هنت ، واني لك مقروع ، وهو عبد شمس بن سعد كان يلقب به ، فقال لها ابوها عند ذلك : اي بنية ، اصدقيني اكذاك هو فانه لا راي لمكذوب . فقالت : ثكلتك ان لم اكن صدقتك فانج ولا اخالك ناجيا ،  فذهبت كلمته وكلمتها وكلمة مازن مثلا . ومن امثالهم : ان الكذوب قد يصدق . عند النوي يكذبك الصادق . قال المفضل : ان رجلا كان له عبد فلم يكذب قط ، فبايعه رجل ليكذبنه ، وجعل الخطر بينهما اهلهما ومالهما ، فقال الرجل لسيد العبد : دعه يبيت عندي الليلة . ففعل ؛ فاطعمه الرجل لحم حوار واسقاه لبنا حليبا في سقاء قد كان فيه لبن حازر ؛ فلما اصبحوا تحملوا وقالوا للعبد : الحق باهلك ، فلما تواري عنهم نزلوا ؛ فاتي العبد سيده فساله فقال : اطعموني لحما لا غثا ولا سمينا ، وسقوني لبنا لا محضا ولا حقينا ، وتركتهم قد ظعنوا فاستقلوا فساروا بعد او حلوا ، وفي النوي يكذبك الصادق ، فارسلها مثلا . واحرز مولاه مال الذي بايعه واهله . ومن امثالهم : لا يدري الكذوب كيف ياتمر . القول ما قالت حذام ، المثل للجيم بن مصعب بن علي بن بكر بن واءل وحذام امراته . صدقته الكذوب اي نفسه . صدقني سن بكره . قال علي عليه السلام في رجل اخبره بشء فصدقه .  لا الية لسالية ، زعم يونس ان ذلك لكذبها ، تحلف انها قليلة السلاء مخافة العين . وفي الكذوب احاديث وبان استه حين اصعدا . وصف الرجل بالتبريز والفعل الحميد من امثالهم في هذا : هو نسيج وحده ، اذا كان مكتفيا بنفسه . ويقولون : هو يرقم علي الماء ، يضرب في الحذق . ويقولون في المحافظة والحمي : جار كجار ابي دواد . وفي الوفاء انجز حر ما وعد ، قال ذلك الحارث بن عمرو بن حجر الكندي لصخر بن نهشل بن دارم ، وكان له مرباع من حنظلة ، فقال له : هل ادلك علي غنيمة ولي خمسها ؟ قال : نعم . فدله علي قبيلة فاغار عليها بقومه ، فتنجزه ما بذله له . ويقولون في المجرب : جري المذكي القارح . وقال قيس بن زهير لحذيفة بن بدر في الرهان بينهما : جري المذكيات غلاب .  ويقولون للرجل المبرز : ما يشق غباره ، واصله قول قصير بن سعد في العصا فرسه حين قال لجذيمة : اركبها فانه لا يشق غبارها ، والخبر مشهور . ويقولون : ما يقعقع له بالشنان ؛ ولا يصطلي بناره . ويقولون : هو الوي بعيد المستمر ، للشرس الشديد ، قاله النعمان بن المنذر لخالد بن معاوية السعدي . وقال الشاعر : من الرجز وجدتني الوي بعيد المستمر . . . احمل ما حملت من خير وشر ومن امثالهم : هل يخفي علي الناس النهار . وهل يجهل القمر . وقال ذو الرمة : من البسيط لقد بهرت فما تخفي علي احد . . . الا علي احد لا يعرف القمرا ومن امثالهم : لا حر بوادي عوف ، المثل للمنذر يقوله لعوف بن محلم الشيباني وقد اجار عليه ، وقيل هو عوف بن كعب بن زيد مناة بن تميم ،  وكان يقتل الاساري ولا يعتقهم . ويقولون في الرجل المقدام علي الامور : ما يبالي علي اي قتريه وقع ، ويقال : قطريه ، اي جانبيه . ويقال : بمثلي تنكا القرحة . ويقولون : هو عندي باليمين عند الوصف والاحماد . ولا تجعلني في اليد الشمال ، اي لا تحقرني . ويقولون : رجل مقابل مدابر اي كريم الطرفين . التمسك بالامر الواضح من امثالهم فيه : من سلك الجدد امن العثار . ومن امثالهم : الحق ابلج والباطل لجلج ، يتردد صاحبه فيه فلا يجد مخرجا . ليس لعين ما رات ولكن لكف ما اخذت . اكرمت فارتبط . ومنه : اشدد يديك بغرزه .  ويقولون : محسنة فهيلي ، يضربونه للامر المستقيم ، واصله ان رجلا نزل بامراة ومعه سلف دقيق ، فلما غاب الرجل اغتنمت غيبته ، فجعلت تهيل من سلفه الدقيق في سلفها ؛ فهجم عليها غفلة فدهشت فجعلت تهيل من دقيقها في دقيقه ، فعند ذلك قال : محسنة فهيلي . ويقولون : خلاءك اقني لحياءك ، اقني اي الزم ، ومنه قول عنترة : من الكامل فاقني حياءك لا ابا لك واعلمي . . . اني تمرء ساموت ان لم اقتل ومن امثالهم : اقصدي تصيدي . دع عنك بنيات الطريق ، اي عليك واضح الامر ، ودع الروغان يمينا وشمالا . التوسط في الامور من ذلك قوله صلي الله عليه وسلم حين ذكر العبادة والغلو فيها : ان المنبت لا ارضا قطع ولا ظهرا ابقي . يقول اذا كلف نفسه فوق طاقتها من العبادة بقي حسيرا كالذي افرط في اغذاذ السير حتي عطبت راحلته ولم يقض سفره .  لا تكن حلوا فتسترط ولا مرا فتعقي ، اي تلفظ من المرارة ، يقال : قد اعقي الشء اذا اشتدت مرارته ، قال ابو عبيدة : وقول العامة فتلفظ غير صحيح . وقال عمر بن الخطاب رضي الله عنه : ان هذا الامر لا يصلحه الا لين في غير ضعف وشدة في غير عنف . وقيل : خير الامور الاوساط . وقالوا في مثله : لا وكس ولا شطط . وقال زهير : من البسيط دون السماء ودون الارض قدرهما . . . دون الذنابي فلا فوت ولا درك وقال عنترة : من الكامل لا ممنعا هربا ولا مستسلم وقالوا : شر السير الحقحقة . وفي الخبر : خير الامور اوساطها . فالوسط محمود علي كل حال الا في العلوم ؛ فان الغايات فيها خير واولي . وقيل : ساءر العلوم والصناعات ينفع فيها التوسط ولا يضر ، كالنحو ليس يضر من احسن باب الفاعل والمفعول ، وباب الاضافة ، وباب المعرفة والنكرة ، ان يكون جاهلا بقية ابواب النحو ؛ وكذلك  من نظر في علم الفراءض فليس يضر من احكم باب الصلب ان يجهل باب الجد . وغاية ذلك ان يكون علم من ذلك العلم نوعا دون نوع الا علم الطب والكلام ، فاصلح الامور لمن تكلف علم الطب ان لا يحسن منه شيءا او يكون حاذقا ، فانه ان احسن منه شيءا ولم يبلغ فيه المبالغ هلك او اهلك المرضي ؛ وكذلك العلم بصناعة الكلام : ان قصر فيه عرضت اليه الشبهة ، ولم يبلغ الغاية التي تزيلها فيضل ويضل . التساوي في الامر سواسية كاسنان الحمار . سواسية كاسنان المشط . القوم اخوان وشتي في الشيم . هما كركبتي البعير ، هذا مثل قاله هرم بن قطبة الفزاري في منافرة عامر بن الطفيل وعلقمة بن علاثة اليه . هما كفرسي رهان . هما زندان في وعاء . هما كحماري العبادي حين قيل له ايهما شر ؟ فقال : هذا ثم هذا ،  وهذا المثل لا يوضع في المدح . ومن امثالهم : وقعا كعكمي عير . انصف القارة من راماها . قال هشام : والقارة هم عضل والديش ابنا الهون بن خزيمة ، وانما سموا قارة لاجتماعهم والتفافهم ؛ قال ابو عبيدة : واصل القارة الاكمة وجمعها قور . قال ابن واقد : وانما قيل قد انصف القارة من راماها في حرب كانت بين قريش وبكر بن عبد مناة بن كنانة ، وكانت القارة مع قريش وهم قوم رماة ؛ فلما التقي الفريقان راماهم الاخرون فقيل : قد انصفكم هءلاء اذ ساووكم في العمل الذي هو شانكم وصناعتكم . ومن امثالهم : سواء علينا سالباه وقاتله ، وهو نصف بيت للوليد بن عقبة من شعر قاله في قتل عثمان رضي الله عنه ، واصله ان رجلا يقال له الحطم قتل فصارت خميصة له الي غير القاتل ، فرءيت معه فقال : لست بقاتله ، فقيل له ذلك . ومن امثالهم : اشبه امرء بعض بزه ، قاله ذو الاصبع العدواني ، وهو خبر طويل يجء في موضعه . كل ذات صدار خالة ؛ قاله همام بن مرة الشيباني . ويقولون : ما اشبه الليلة بالبارحة .  وحذو القذة بالقذة . كل نجار ابل نجارها . لا تنبت الحقلة الا بقلة ، اي لا يلد الوالد الا مثله . المجازاة من امثالهم في هذا : اضء لي اقدح لك . ويقال : اكدح لي ، اي كن لي اكن لك . ومنها : من ينكح الحسناء يعط مهرا . ومنها : اساء سمعا فاساء اجابة . قال النابغة : من البسيط لقد جزتكم بنو ذبيان ضاحية . . . بما فعلتم ككيل الصاع بالصاع لما مات محمد بن الحجاج بن يوسف اشتد جزع ابيه الحجاج عليه ، ودخل الناس عليه يعزونه ويسلونه وهو لا يزداد الا جزعا ، وكان ممن دخل عليه رجل كان الحجاج قتل ابنه يوم الزاوية ، فلما راي جزع الحجاج وقلة ثباته شمت به وتمثل بقول طفيل الغنوي : من الطويل  فذوقوا كما ذقنا غداة محجر . . . من الغيظ في اكبادنا والتحوب وقال حسان بن عمرو : من الطويل متي ما يشا مستقبض الشر يلقه . . . سريعا وتجمعه اليه انامله التفوق والزيال من امثالهم في ذلك : اتي ابد علي لبد ، وهو نسر لقمان السابع . من يجتمع يتقعقع عمده ، اي قصاراهم التفرق . طارت بهم العنقاء . اودت بهم عقاب ملاع . ذهبوا ايدي سبا . ويقال في مثله : خفت نعامته . وشالت نعامته . وزف راله .  ويقولون : فسا بينهم ظربان . اودي كما اودي ارم . وقال الخنوت السعدي وهو توبة بن مضرس : من الطويل ارب بهم ريب المنون كانما . . . علي الدهر فيهم ان يفرقهم نذر ومن امثالهم : لكل ذي عمود نوي . حفظ اللسان من ذلك قوله تعالي : كبر مقتا عند الله ان تقولوا ما لا تفعلون . وفي الحديث : وهل يكب الناس علي مناخرهم في النار الا حصاءد السنتهم . وقال اكثم بن صيفي : مقتل الرجل بين فكيه ، يعني لسانه . وقال عمر بن عبد العزيز : التقي ملجم . وقال بعض العرب لرجل يوصيه : اياك ان يضرب لسانك عنقك . ومنه قول الشاعر : من المتقارب رايت اللسان علي اهله . . . اذا ساسه الجهل ليثا مغيرا  وقال علقمة بن علاثة : اول العي الاختلاط ، واسوا القول الافراط . ومن امثالهم : من اكثر اهجر . اجعل هذا في وعاء غير سرب . ويقولون : صدرك اوسع لسرك . في امثال اكثم بن صيفي : لكل ساقطة لاقطة ، يحذر به من سقط الكلام . ومن امثاله : رب قول انفذ من صول ، يضرب لحفظ اللسان ، فيما يبقي من العار . وقال طرفة بن العبد : من الطويل وان لسان المرء ما لم تكن له . . . حصاة علي عوراته لدليل وقال كعب بن سعد : من الطويل اذا انت جالست الرجال فلا يكن . . . عليك لعورات الرجال دليل وكان يجالس الاحنف رجل يطيل الصمت حتي اعجب به الاحنف ، فقال  الرجل يوما للاحنف : يا ابا بحر ، هل تقدر ان تمشي علي شرف المسجد ؟ فتمثل الاحنف : من الطويل وكاءن تري من صامت لك معجب . . . زيادته او نقصه في التكلم ومن امثال العرب : سكت الفا ونطق خلفا ، قال ابن الاعرابي : الخلف الردء من القول . يقال : فاس ذات خلفين ، اي ذات راسين ، والخلف الطريق وراء الجبل . ويقال : خلف صدق من ابيه وخلف سوء . ويقال لمن هلك والده : اخلف الله عليك ، اي كان الله خليفة والدك عليك . ويقال لمن ذهب ماله : اخلف الله عليك ، وخلف الرجل الوالي اذا كان خليفته . ويقال : خلف فوه من الصيام يخلف خلوفا اذا تغير . ويقال : هو خالف اهله وخالفه اهله اذا كان فاسدا . ويقال في مثله : خلفناة وخليفة ، ويقال : عبد خالف ، اي فاسد . ويقال : ابيعك العبد وابرا اليك من خلفته ، ورجل ذو خلفة ؛ والخالفة عمود من اعمدة البيت ، وخوالف البيت زواياه ، واحدتها خلفة . قال الاصمعي : خلف فلان يخلف خلوفا اذا فسد ولم يفلح والخوالف النساء اللواتي غاب ازواجهن عنهن وليس عندهن رجال . قال الله تعالي : رضوا بان يكونوا مع الخوالف التوبة  ،  وحي خلوف ، اي غيب ، وخلوف حضور ؛ والخلفة الورقة تخرج بعد الورق اليابس . ويقال : الليل والنهار خلفة ، اي اذا ذهب هذا جاء هذا . ويقال : خلف ثوبه اذا قطع وسطه وجمع بين طرفيه . ويقال : برءت اليك من خلفة العبد ، اي فساده ؛ والخلف طرف الضرع . ويقال : اخلف بيده اذا اهوي بها الي خلفه  ليتناول شيءا ؛ والاخلاف ان يعيد علي الناقة فلا تلقح ، والاخلاف ان يعد الرجل عدة فلا ينجزها ؛ والاخلاف ان يجعل الحقب وراء الثيل ، والثيل وعاء مقلم البعير ، وهو قضيبه ؛ يقال : اخلف عن بعيرك . قال ابو زيد : الخالف الفاسد الاحمق ، وقد خلف يخلف خلافة . ويقال : جاء فلان خلافي وخلفي ، وهما واحد ، وقد جاءت اللغتان في كتاب الله عز وجل ؛ ويقال اختلف فلان صاحبه في اهله اختلافا ، وذلك ان يناظره حتي اذا غاب عن اهله جاء فدخل عليهن . قال : ويقال : خلف الشراب واللبن يخلف خلوفا اذا حمض ثم اطيل انقاعه ففسد . وقال ابو زيد والاصمعي : خلفت نفسي عن الطعام ، تخلف خلوفا اذا اضربت عنه من مرض . وقال ابو زيد : لا يقال ذلك الا من المرض . قال الاصمعي واللحياني في الخلف المربد يكون وراء البيت . وقال الاصمعي : الخلفة الاستقاء . يقال : من اين خلفتكم ؟ اي من اين تستقون . ويقال : نتاج فلان خلفة ، اي عام ذكر وعام انثي ؛ والخلفة النبت في الصيف ، والخلفة اختلاف البهاءم وغيرها . ويقال : حلب الناقة خليف لباها ، يعني الحلبة التي بعد ذهاب اللبا ؛ والخليف الطريق في الجبل ، وقال ابو نصر : هو الطريق وراء الجبل او في اصله . وقال اللحياني : الخليف الطريق في ما وراء الجبل او بين الجبلين ؛ ويقال المخلفة : الطريق ايضا ، يقال : عليك المخلفة الوسطي . ما جاء في التصريح والمكاشفة من ذلك قولهم : صرح الحق عن محضه . ابدي الصريح عن الرغوة ، الرغوة والرغوة ، لغتان . وهذا  المثل لعبيد الله بن زياد قاله لهانء بن عروة المرادي في شان مسلم بن عقيل . يقال للبن حين يحلب : حليب ، فاذا ذهبت رغوته فهو صريح . فاذا امكن ان يصب في الاناء فهو صريف ، ثم نقيع يومه ، ثم حقين اذا جعل في السقاء ، فاذا اخذ طعم السقاء فهو ممحل ، فاذا اخذ في الحمض فهو قارس ، فاذا راب فامكن ان يمخض فهو ظليم ومظلوم ، فاذا انقطع زبده فلم يخرج مستقيما فهو مثمر وثامر ، فاذا خرج زبده فهو راءب ، فاذا اشتد حمضه فتقطع فصار اللبن ناحية والماء ناحية فهو الممذق ، فاذا اشتد حمضه جدا فهو الادل . يقال : جاءنا بادلة تروي الوجه ، فاذا بلبل وغلظ فهو الهدبد والعكلط والعجلط ، وهو الغنمي اذا صب فلم يسمع من خثورته ، والمحض الذي لم يخالطه ماء . والخامط الذي اخذ ريحا ، فاذا ذهبت عن اللبن حلاوته قبل له السامط ، والحازر الذي يشتد ايضا ، والضريب الذي حقن اياما فاشتدت حموضته ، والدواية شبيه الجليدة تعلو اللبن ، والرثيءة حليب يصب علي حامض وقد رثاته . والصير ماء الجبن والمصل  عربي صحيح  والماء الذي يسيل منه المصالة ، ويقال للكشك الزهيدة ، والنسء حليب يصب عليه ماء ، نساته انسءه نسءا ، والنخيسة لبن الضان يصب عليه لبن المعزي . والضيح الذي كثر ماءه وهو الضياح ، والمذيق الذي فيه ماء . والرخف الرخو من الزبد ، والنهيد الذي لم يتم روب لبنه ، والصرد ان ينقطع منتفثا لا يلتءم . ومن امثالهم : قد بين الصبح لذي عينين . ومنها : برح الخفاء .  ومنها : اخبرته بعجري ويجري ، اي اظهرته من ثقتي علي معايبي ، واصل العجر العروق المتعقدة ، فاما البحر فهي ان تكون في البطن خاصة . ومنها : لبست له جلد النمر . قشرت له العصا . لا مخبا لعطر بعد عروس ؛ وقد يضرب في الخطا وترك الشء وقت الحاجة اليه . قال ابو زيد : واصله ان رجلا تزوج بامراة فوجدها تفلة ، فقال : اين الطيب ؟ فقالت : خباته فعنفها ، قال : لا مخبا لعطر بعد عروس . وذكر المفضل : ان المثل لامراة عروس ، وكان رجلا جميلا يسمي عروسا ، فهلك فحملت المراة عطرا والة النساء والطيب ، فمر بها بعض معارفها فوبخها وعنفها ، فقالت عند ذلك هذا المثل . ومن امثالهم : لا اطلب اثرا بعد عين ، وقد يضرب في الاحتياط للامر ، المثل لمالك بن عمرو الباهلي ، كان له اخ يقال له سماك ، فقتله رجل من غسان ، فلقيه مالك فاراد قتله ، فقال الغساني : دعني ولك ماءة من الابل ، فقال : لا اطلب اثرا بعد عين ، ثم قتله . ومن امثالهم : ترك الخداع من اجري من ماءة ، المثل لقيس بن  زهير في رهان داحس والغبراء لما جعل المدي ماءة غلوة . ويقولون في المكاشفة والتحذير : قد اعذر من انذر . وما له ستر ولا حجر ، الستر هاهنا الحياء والحجر العقل . ويقولون في الامر الجلي : ما يوم حليمة بسر ، وحليمة بنت الحارث بن ابي شمر الغساني ، ويوم حليمة من ايام العرب المشهورة ، ولها فيه حديث معروف ، وقد ذكر هذا اليوم في موضع اخر بشرحه . ومن امثالهم في الامر الشاءع : يكفيك من شر سماعه ، قالته فاطمة بنت الخرشب الانمارية ام الربيع بن زياد ، وهي ام الكملة احدي المنجبات ، لقيس بن زهير ، وكان الربيع اخذ منه درعا فعرض لها قيس ليرتهنها عليه ، فقالت : يا قيس اتري بني زياد مصالحيك وقد ذهبت بامهم يمينا وشمالا فقال الناس ما شاءوا ، ويكفيك من شر سماعه . ومن امثالهم : عند التصريح تريح . ما جاء في التسويف والوعد والعويد يقولون : مطله مطلا كنعاس الكلب ، وذاك انه داءم متصل . ويقولون : اسمع جعجعة ولا اري طحنا ، والطحن الدقيق .  ومن امثالهم : الصدق ينبي عنك لا الوعيد ، غير مهموز من نبا ينبو . ومنها : جاء ينفض مذرويه ، اذا جاء يتوعد ويتهدد ، ولا يقال هذا الا لمن يتوعد من غير حقيقة ، والمذروان فرعا الاليتين . ومنها ويقاربها قولهم : ارق علي ظلعك . والمثل الساءر : مواعيد عرقوب . قالوا : كان عرقوب رجلا من العماليق اتاه اخ له يساله شيءا فقال له عرقوب : اذا اطلعت هذه النخلة فلك طلعها ، فلما اطلعت اتي الرجل اخاه للعدة فقال : دعها حتي تصير بلحا ، فلما ابلحت اتاه فقال له : دعها حتي تصير زهوا ، فلما ازهت قال : دعها حتي تصير ثمرا ، فلما اثمرت عمد اليها عرقوب من الليل فجدها ولم يعط اخاه منها شيءا ، وفيه يقول الاشجعي : من الطويل وعدت وكان الخلف منك سجية . . . مواعيد عرقوب اخاه بيثرب ويقولون في الوعيد : برق لمن لا يعرفك .  ويقولون لمن يعد ولا ينجز وعده ذكر ولا حساس . ومن امثالهم في التسويف : الي ذاك ما باض الحمام وفرخا . المكر والمداهنة ومن امثالهم في ذلك : يسر حسوا في ارتغاء . امكر وانت في الحديد ؛ قاله عبد الملك بن مروان لعمرو بن سعيد الاشدق عند قتله ؛ وخبره معه طويل ، وقد ذكر في موضع اخر ، وقال له عمرو حين قيده : ان رايت يا امير المءمنين ان لا تفضحني بان تخرجني الي اهل الشام فتقتلني بحضرتهم فافعل ؛ وانما اراد عمرو ان يخالفه فيخرجه ، فاذا ظهر منعه اصحابه وحالوا بينه وبين عبد الملك . ومن امثالهم : من حفر مغواة وقع فيها . اعن صبوح ترقق . اصل المغواة البءر تحفر للذءب ثم يجعل فيها جدي او غيره ، فيسقط الذءب فيها لياخذه فيصطاد . والمثل الثاني : قال النمفضل الضبي فيه : كان نزل رجل بقوم اضافوه ليلا وغبقوه فلما فرغ قال لهم : اذا اصبحتموني غدا فكيف اخذ في حاجتي ؟ فقالوا له : اعن صبوح ترقق ؟  عاد الرمي علي النزعة ، والنزعة الرماة . ومن امثالهم في هذا المعني : لامر ما جدع قصير انفه ، وخبر جذيمة يشتمل علي هذا المثل وغيره فلا حاجة الي اعادة ذكره . اطرق كري ان النعام في القري . ما زال يقتل في الذروة والغارب ، اذا بالغ في الخداع . الايناس قبل الابساس . اياك اعني واسمعي يا جارة ، المثل لسهل بن مالك الفزاري ، قاله لاخت حارثة بن لام الطاءي . ومن امثالهم في المكر : خامري ام عامر . ويقارب ذلك قولهم : امر نهار قضي ليلا . ويقولون للخب : اروغا ثعالة . حفظ المودة بالتباعد من امثالهم في هذا : فرق بين معد تحاب . وكتب عمر بن الخطاب  رضي الله عنه الي ابي موسي ان مر ذوي القرابات ان يتزاوروا ولا يتجاوروا ، وروي عنه وابن مسعود انهما قالا : خالطوا الناس وزايلوهم ، اي خالطوهم في المعاشرة والاخلاق وزايلوهم باعمالكم ، ويحتمل المباعدة ايضا ، ويقارب هذا الكلام قول صعصعة بن صوحان : اذا لقيت المءمن فخالطه ، واذا لقيت الفاجر فخالفه ، ودينك فلا تكلمنه . ويشبه ما روي عن عيسي عليه السلام : كن وسطا وامش جانبا . ما جاء في الضرورة والمعذرة والاعتذار ازهد الناس في عالم جاره ويروي اهله . ومن امثالهم في ذلك : مكره اخوك لا بطل ، خبره في قصة بيهس نعامة ، وهو مذكور في مكانه من هذا الكتاب . لو ترك القطا لنام ، هو لامراة عمرو بن امامة ، وكان نزل بقوم من مراد فطرقوه ليلا فلما رات امراته سوادهم انبهته فقالت : قد اتيت ، فقال : انما هذه القطا ، فقالت : لو ترك القطا لنام . فاتاه القوم فبيتوه فقتلوه . ومن امثالهم : الشر الجاه الي مخ العراقيب ، وقد يضرب عند مسالة اللءيم .  ويقولون : الطعن اظار ، يضرب للبخيل يعطي عن ضرورة ، يقول : اذا خاف ان يطعنه عطفه ذلك عليه فجاد بماله خوفا منه . ويقولون : الخلة تدعو الي السلة ، اي الحاجة تدعو الي السرقة . ويقولون : لكل جواد كبوة ولكل عالم هفوة ولكل صارم نبوة . ويقولون : ترك الذنب ايسر من الاعتذار . ومن امثالهم : حياك من لا خلا فوه ، واصله ان رجلا سلم عليه وهو ياكل فلم يرد السلام ، فلما فرغ قال هذه المقالة اي كنت مشغولا . ومن امثالهم في لاضرورة : بيتي يبخل لا انا . شغلت شعابي جدواي . بالساعد تبطش الكف في الضرورة ، هذا المثل يضرب ايضا في قلة الاعوان . ومن الاعذار قول قصير بن سعد لعمرو بن عدي حين امره ان يطلب ثار خاله جذيمة من الزباء ، افعل كذا وخلاك ذم . قال الشاعر : من الطويل  اذا ما شفيت النفس ابلغت عذرها . . . ولا لوم في امر اذا بلغ العذر ومن امثال الضرورة : يلبس الخلق من لا جديد له . تعذر الكمال والمحض من امثالهم فيه : اي الرجال المهذب . وقول ابي الدرداء رضي الله عنه : من لك باخيك كله . وقولهم : لا تعدم الحسناء ذاما ، مخفف وهو العيب . تعلق الفعل بما يتعذر والامتناع عنه ما اتصل المانع ، او فعله ما استمر الشء ومن امثالهم في هذا : لا اتيك ما حنت النيب . ومثله : لا اتيك ما اطت الابل . وقال ابو زيد : لا اتيك ما اختلفت الدرة والجرة ، واختلافهما ان الدرة تنتقل الي الضروع والجرة تعلو الي الراس .  ما اختلف الملون ، وهما الليل والنهار ، والواحد منهما ملي مقصور . ومثله : ما اختلف الاجدان ، وكذلك : ما اختلف الفتيان ، ومنه قول الشاعر : من الكامل ما لبث الفتيان ان عصفا بهم . . . ولكل قفل يسرا مفتاحا ويقولون : ما افعله ما سمر ابنا سمير . ولا اتيك السمر والثقمر ، يريدون ما كان السمر وما طلع القمر . ولا اتيك سن الحسل ، والحسل ولد الضب ، حتي تسقط اسنانه ، ويقال انها لا تسقط ابدا حتي تموت . قال الاحمر في هذا : لا اتيك سجيس الاوجس . سجيس عجيس ، ومعناهما : الدهر . ولا اتيك الازلم الجذع ، وهو الدهر .  وما حي حي وما مات ميت . ويروي عن المفضل انه قال : هذا المثل للقمان بن عاد . ومثله : لا افعله دهر الداهرين ، وعوض العاءضين . وابد الابدين ، وابد الابيد . وما حملت عيني الماء . وحتي يرجع السهم علي فوقه وهو لا رجع ابدا انما مضاءه قدما . وقال ابن الكلبي : من هذا قولهم : لا افعل ذلك معزي الفزر ، قال : والفزر سعد بن زيد مناة بن تميم ، وكان وافي الموسم بمعزي فانهبها هنالك ، فتفرقت في البلاد ، فالمعني في معزي الفزر حتي تجتمع تلك ، وهي لا تجتمع الدهر كله ، وانما سمي الفزر لانه قال : من اخذ منها واحدة فهي له ، ولا يءخذ منها فزر ، قال : وهي الاثنان . ولا افعل ذلك حتي يءوب القارظان ، وهما من عنزة ، فالاول منهما يذكر بن عنزة لصلبه ، عشق فاطمة بنت خزيمة بن نهد ، وخبرهما يرد في  اخبار العرب ، والقارظ الاخر زهير بن عامر بن عنزة خرج يجتني القرظ فلم يرجع ولا علم بخبره . ومن امثالهم : حتي يءوب المنخل ، وخبره شبيه بهذا الخبر . وضع الشء في موضعه من امثالهم في هذا : ذكرتني الطعن وكنت ناسيا . واصله ان رجلا حمل علي رجل ليقتله ، وكان في يد المحمول عليه رمح فانساه الدهش والجزع ما في يده ، فقال الحامل : الق الرمح ، فقال الاخر : اري معي رمحا وانا لا اشعر به ، ذكرتني الطعن وكنت ناسيا ، وكر علي صاحبه فقتله او هزمه ، وقيل ان الحامل : صخر بن معاوية السلمي والمحمول عليه : يزيد الصعق الكلابي . ومن امثالهم : خلع الدرع بيد الزوج . التجرد لغير النكاح مثلة ، وهما مثلان قالتهما رقاش بنت عمرو ابن تغلب بن واءل ، تزوجها كعب بن مالك بن تيم الله بن ثعلبة فقال لها : اخلعي درعك ، فقالت : خلع الدرع بيد الزوج ، فقال : اخلعيه لانظر اليك ، فقالت : التجرد لغير النكاح مثلة . وقريب من معني هذا الفصل قولهم : اذكر الغاءب يقترب .  اذكر غاءبا تره . والثاني قاله عبد الله بن الزبير وقد ذكر المختار وهو غاءب فقدم عليه . وقال عتبة بن ابي سفيان : العجب من علي بن ابي طالب عليه السلام ومن طلبه الخلافة وما هو وهي ؟ فقال معاوية : اسكت يا اوزه ، فوالله انه فيها كخاطب الحرة اذ يقول : من الطويل لءن كان ادلي خاطب فتعذرت . . . عليه وكانت راءدا فتمطت لما تركته رغبة عن حباله . . . ولكنها كانت لاخر حطت وقال النجاشي الحارثي : من البسيط اني امرء قل ما اثني علي احد . . . حتي ابين ما ياتي وما يذر لا تحمدن امرءا حتي تجربه . . . ولا تذمن من لم يبله الخبر وفي بعض الحديث : لا تعجلوا بحمد الناس ولا ذمهم ، فان احدا لا يدري بما يختم له . ومن امثال العرب : لا تحمدن امة عام اشتراءها ولا حرة عام بناءها . ومثله : لا تهرف قبل ان تعرف ، والهرف الاطناب .  وضع الشء في غير موضعه قال اوس بن حجر : كمن دب يستخفي وفي الحلق جلجل . ومن امثال العرب : خرقاء ذات نيقة . ومنها : كالحادي وليس له بعير . ومن امثالهم : وحمي ولا حبل ، يضربونه للشهوان وليس بجاءع . ومنها : يحمل شن ويفدي لكيز ، وهما ابنا قصي بن عبد القيس ، قاله شن لامهما ، وكانت تءثر لكيزا عليه . ويقولون : ليس هذا بعشك فادرجي . ويقولون : كمستبضع التمر الي هجر . متي كان حكم الله في كرب النخل وهو نصف بيت لجرير قاله لشاعر من عبد القيس وقد حكم للفرزدق علي جرير .  وقال الشاعر : من الوافر فانك والكتاب الي علي . . . كدابغة وقد حلم الاديم يقولون : كالامة تفخر بحجر ربتها . وقال ابن هرمة : من المتقارب كتاركة بيضها بالعراء . . . وملحفة بيض اخري جناها قيل : اراد الكروان ، فانه يترك بيض نفسه ويحضن بيض غيره ، وان حمل علي العموم كان حسنا . وقال العديل بن الفرخ العجلي : من الطويل وكنت كمهريق الذي في سقاءه . . . لرقراق ال فوق رابية صلد كمرضعة اولاد اخري وضيعت . . . بني بطنها هذا الضلال عن القصد وقال اخر : من الطويل وان كلام المرء في غير كنهه . . . لكالنبل ترمي ليس فيها نصالها وقال يزيد بن ضبة : من الكامل  لا تبدين مقالة ماثورة . . . لا تستطيع اذا مضت ادراكها وقال اخر : من الطويل اذا عركت عجل بنا ذنب طء . . . عركنا بتيم اللات ذنب بني عجل وقال حارثة بن بدر ، ويروي لانس بن زنيم الليثي : من الطويل اهان واقصي ثم يستنصحونني . . . ومن ذا الذي يعطي نصيحته قسرا وقال اخر : من الطويل ولم ار ظلما مثل ظلم ينالنا . . . يساء الينا ثم نءمر بالشكر وقال اخر : من الوافر وكم من موقف حسن احيلت . . . محاسنه فعد من الذنوب ومن امثالهم : تبصر القذاة في عين اخيك وتعمي عن الجذع في عينك ، وتدع الجذع المعترض في حلقك . وقد روي هذا المثل بالفاظ مختلفة ، فمنها : ان رجلا كان ابوه صلب في حرب ، ثم انه قاول اخر وعابه ، فقال له الاخر : احدكم يري القذاة في عين اخيه ولا يري الجذع معترضا في است ابيه . ويقولون : في ذنب الكلب تطلب الاهالة والاهالة الودك ، لمن يطلب الشء من غير وجهه .  ما جاء في اصلاح المال لا جديد لمن لا يلبس الخلق ، قالته عاءشة رضي الله عنها ، وقد وهبت مالا عظيما ثم رقعت ثوبا لها . وقال احيحة بن الجلاح : التمرة الي التمرة تمر ؛ والذود الي الذود ابل . ومنه : من الوافر قليل المال تصلحه فيبقي . . . ولا يبقي الكثير مع الفساد ويقولون : من ذهب ماله هان علي اهله . ويقرب منه قولهم : الشحيح اعذر من الظالم . ومن امثالهم : لا تفاكه امة ولا تبل علي اكمة . تسهيل الامور ودفع الاقدم بالاحدث ومن امثالهم فيه : كان جرحا فبرا ، قاله بعض العرب واصيب بابن له فسءل عنه بعد مدة .  ومثله قول ابي خراش : من الطويل بلي انها تعفو الكلوم وانما . . . نوكل بالادني وان جل ما يمضي ومنه قولهم : هون عليك ولا تولع باشفاق . وقال الاحوص : من البسيط ان القديم وان جلت رزيته . . . ينضو فينسي ويبقي الحادث الانف ويقولون : جاء ثانيا من عنانه ، اذا جاء وقد قضي حاجته . ويقولون : لا تعدم صناع ثلة : والثلة الصوف تغزله المراة . ولن تعدم سارقة حثيثا . ومن امثالهم : انجد من راي حضنا ، وحضن جبل بنجد ، يضرب ذلك لمن بلغ مقصده . ؟ ومن امثالهم في تسهيل الشء : اوردها سعد وسعد مشتمل ، يعني انه اورد ابله شريعة الماء ولم يوردها علي بءر فيحتاج الي الاستقاء . ؟  ومنه : اهون السقي التشريع . ؟ هذا علي طرف الثمام ، وذلك ان الثمام لا يطول فيشق علي المتناول . ؟ ومنه : كلا جانبي هرشي لهن طريق ، يضرب اذا سهل الامر من الوجهين . ومن التسهيل والمقاربة كلام ابن المعتز : ابق لرضاك من غضبك ، واذا طرت فقع قريبا . وقال اعرابي : من الطويل وقد غضبوا حتي اذا ملاوا الربي . . . ولو ان اقرارا علي الضيم اروح وقال عمرو بن اسيد الاسدي : من الطويل كانك لم تسبق من الدهر ليلة . . . اذا انت ادركت الذي انت تطلب ومثله : من الطويل كان الفتي لم يعر يوما اذا اكتسي . . . ولم يك صعلوكا اذا ما تمولا ؟ وقال النبي صلي الله عليه وسلم لما قتل القاري الانصاري عصماء بنت مروان اليهودية وكانت تهجو النبي صلي الله عليه وسلم فطرقها ليلا فقتلها : لا يتنطح فيها عنزان . وذلك ان العنز لا تبالغ ، وانما تشام وترجع ، فهو اسهل ما يكون بين المتلاقيين . ؟  ومن امثالهم : كل امرء في بيته صبي ، ويراد به تسهيل الخلق . ويقولون في التسهيل وما يجتزء به : قد تقطع الدوية الناب . ما جاء في العداوة والشماتة والرمي بالعضيهة من امثالهم في هذا : رماه بثالثة الاثافي ، وهي القطعة المتصلة بالجبل يجعل الي جنبها اثنتان . وقال خفاف بن ندبة : من الوافر فان قصيرة شنعاء مني . . . اذا حضرت كثالثة الاثافي ويقولون : لا تدريه لعرضك فيلزم ، تدريه تغريه ويلزم يضري . ويقولون : لا تري العكلي الا حيث يسوءك . ويقولون : رماه بالعضيهة وبالافيكة وبالبهيتة . ورماه باقحاف راسه . ومن امثالهم : رمتني بداءها وانسلت ، وقال المفضل : المثل لرهم بنت الخزرج من كلب وكانت امراة سعد بن زيد مناة ، وكان لها ضراءر  فسابتها احداهن يوما فرمتها رهم بعيب كان في رهم ، فقالت ضرتها : رمتني بداءها وانسلت ، فذهبت مثلا . ويشبه هذا المثل : من الكامل لا تنه عن خلق وتاتي مثله . . . عار عليك اذا فعلت عظيم وقال عدي بن زيد : من الرمل واجتنب اخلاق من لم ترضه . . . لا تعبه ثم تقفو في الاثر وقال عبد الله بن معاوية الجعفري : من المتقارب ولا تقربن الصنيع الذي . . . تلوم اخاك علي مثله ومن امثالهم في هذا : محترس من مثله وهو حارس . ويقال في العداوة : هو ازرق العين . وهم سود الاكباد . وهم صهب السبال ، في كشف العداوة . ويقال : بينهم داء الضراءر .  ويقولون : جلي محب نظره . قال زهير : من الوافر فان يك في صديق او عدو . . . تخبرك العيون عن القلوب وقال اكثم بن صيفي : من لا حاك فقد عاداك . ويقولون : هو يعض علي الارم ، يقال ذلك في الغيظ ، يقال انها الحصي ويقال الاضراس . ويقولون : بينهم عطر منشم ، يراد به الشر العظيم . ويقولون : عصبه عصب السلمة ، وهي شجرة لها شوك اذا ارادوا قطعها عصبوا اغصانها حتي يصلوا اليها . ويقولون في الشماتة : من ير يوما ير به . ومنه قول نهشل بن حري : من الطويل ومن ير بالاقوام يوما يرونه . . . معرة يوم لا توازي كواكبه  فقل للذي يبدي الشماتة جاهلا . . . سياتيك كاس انت لا بد شاربه وقال حارثة بن بدر : من البسيط يا ايها الشامت المبدي عداوته . . . ما بالمنايا التي عيرت من عار تراك تنجو سليما من غواءلها . . . هيهات لا بد ان يسري بك الساري والمستحسن في ذلك قول عدي بن زيد : من الخفيف ايها الشامت المعير بالده . . . ر اانت المبرا الموفور وقال الاخطل : من الطويل لقد عثرت بكر بن واءل عثرة . . . فان عثرت اخري فلليد والفم وقال تميم بن ابي بن مقبل : من الطويل اذا الناس قالوا كيف انت وقد بدا . . . ضمير الذي بي قلت للناس صالح ليرضي صديق او ليبلغ كاشحا . . . وما كل من اسلفته الود ناصح وقد احسن المتنبي في قوله : من البسيط ولا تشك الي خلق فتشمته . . . شكوي الجريح الي الغربان والرخم  ما جاء في الاتفاق والتحاب والاستمالة من امثالهم في هذا : كانت لقوة صادفت قبيسا ، تضرب في سرعة الاتفاق ، قال ابو عبيدة : اللقوة السريعة الحمل والقبيس العجل السريع الالقاح . ومنه : التقي الثريان ، والثري التراب الندي ، فاذا جاء المطر الكثير رسخ في الارض حتي يلتقي بنداه ، والندي الذي يكون في بطن الارض . ومن امثالهم : لا تنقش الشوكة بالشوكة فان ضلعها معها . ويقولون : القي عليه شراشره . والقي عليه بعاعه ، اي القي عليه نفسه من حبه . ويقولون : نظرة من ذي علق . ومنها : وافق شن طبقة ، وفيه تاويلان : احدهما انهما قبيلتان كان فيهما شر فالتقتا ، وشن من عبد القيس وطبقة من اياد ؛ والاخر ان الشن القربة الخلق عمل منها اداوة فجاء موافقا ، وقد فسر بوجه ثالث قد ذكر في باب الكناية .  ويقولون : هما كندماني جذيمة ، قيل هما مالك وعقيل من بلقين كانا لا يفترقان . وقيل ان جذيمة كان لا ينادم احدا ترفعا وكبرا ، ويقول : انما انادم الفرقدين ، والشعر قد دل علي الاول وهو الاصح . ومن امثالهم في الاستمالة : ارغوا لها حوارها تحن ، اصله ان الناقة اذا سمعت رغاء حوارها سكنت وهدات . ومنه قول معاوية حين رفع قميص عثمان : حرك لها حوارها تحن . ومنها : ان الرثيءة مما يفتا الغضب واصله ان رجلا كان غضبانا علي قوم ، قال ابو زيد : واحسبه كان جاءعا ، فسقوه رثيءة فسكن غضبه . ومنها : العاشية تهيج الابية ، اي تراها تاكل فتميل فتاكل بعد الاباء . ما جاء في قوة الخلق علي التخلق من امثالهم في هذا : ان العناء رياضة الهرم . ويقولون : ان العروق عليها ينبت الشجر ، يضربونه في شبه الفرع بالاصل . قريب من هذا المعني .  يقولون : اعييتني باشر فكيف بدردر ، يقول : لم تقبلي الادب وانت شابة ذات اشر فكيف وقد اسننت وبدات درادرك ، وهي مغارز الاسنان . ويقولون : اعييتني من شب الي دب ، اي من لدن شببت الي ان دببت هرما . وقال ذو الاصبع العدواني : من البسيط كل امرء صاءر يوما لشيمته . . . وان تخلق اخلاقا الي حين وهو القاءل ايضا : من البسيط اعمد الي الحق فيما انت فاعله . . . ان التخلق ياتي دونه الخلق وقال المخضع النبهاني : من الطويل ومن يقترف خلقا سوي خلق نفسه . . . يدعه وترجعه اليه الرواجع وقال سليمان بن المهاجر ، وتروي لحاتم : من الطويل ومن يبتدع ما ليس فيه سجية . . . يدعه ويغلبه علي النفس خيمها وقال اخر : من الوافر وكيف ملامتي اذ شاب راسي . . . علي خلق نشات به غلاما  وقال عمرو بن كلثوم : من الطويل ولكن فطام النفس ايسر محملا . . . من الصخرة الصماء حين ترومها وقال صالح بن عبد القدوس : من الطويل ولن يستطيع الدهر تغيير خلقه . . . لءيم ولن يسطيعه متكرم كما ان ماء المزن ما ذيق ساءغ . . . زلال وماء البحر يلفظه الفم ما جاء في ذليل استعان بمثله من امثالهم فيه : مثقل استعان بدفيه ، واصله البعير يحمل عليه الحمل الثقيل ولا يقدر علي النهوض ، فيعتمد علي دفيه علي الارض ، والدف الجنب . ومثله عبد صريخه امة . قال الفرزدق : لقد خزيت قيس وذل نصيرها . وقال اخر : وداعية عند القبور نصيرها . ومن امثالهم : ذليل عاذ بقرملة ، والقرمل نبات كل من راه انتزعه من اصله لضعفه .  ما جاء في النفع والضر ومعايبهما من امثالهم في ذلك : سبق درته غراره ، الغرار قلة اللبن ، والدرة كثرته . يقولون : سبق شره خيره . ويقولون : هل بالرمل اوشال ؟ اي لا خير عنده ، كما ان الرمل لا يكون فيه وشل . ويقولون : ما يبض حجره ، والبض ادني ما يكون من السيلان . ومن امثالهم : ما هو في العير ولا في النفير ، فالعير عير قريش والنفير نفير قريش من مكة لحماية العير ، فكانت غزوة بدر . صقر يلوذ بحمام العوسج . خير مالك ما نفعك . لم يضع من مالك ما وعظك ، وهذا المثل لاكثم بن صيفي . ويقولون : ما عنده خل ولا خمر ، اي ما عنده من الخير شء .  ويقولون : من شر ما القاك اهلك ، يضرب لمن يتجافاه الناس ولا نفع عنده . وقال ابن لنكك البصري : من البسيط وهبك كالشمس في حسن الم ترنا . . . نفر منها اذا مالت الي الضرر وقال البحتري : من الطويل يقل غناء القوس نبع نجارها . . . وساعد من يرمي عن القوس خروع وقال عدي بن زيد : من الطويل اذا انت لم تنفع بودك اهله . . . ولم تنك بالبوسي عدوك فابعد وقال قيس بن الخطيم : من الطويل اذا المرء لم يفضل ولم يلق نجدة . . . مع القوم فليقعد بضعف ويبعد وقال عبد الله بن معاوية : من الطويل اذا انت لم تنفع فضر فانما . . . يراد الفتي كيما يضر وينفع وقال اخر : من الطويل وان فتي الفتيان من راح او غدا . . . لضر عدو او لنفع صديق  ومن امثالهم مما جاء في النفع من حيث لا يحتسب حباب فلا تعق ابرا : يضرب في عدم النفع ، والجباب الجمار الذي لا طلع فيه ، والابر الذي يلقح النخل . ما جاء في المبالغة رب اخ لك لم تلده امك ، يقال انه للقمان بن عاد ، وذلك انه راي رجلا مستخليا بامراة فاتهمه فقال : من هذا ؟ فقالت : اخي ، وصار قوله مثلا لغير ما قصد له . ويقولون : الضجور قد تحلب العلبة ، ويضرب للمنوع قد ينال منه الشء . ويقولون : رب رمية من غير رام . وفي الخواطء سهم صاءب ، وقريب منه : الامر يجء فوق ما في النفس . ليس الري عن التشاف ، واصل التشاف ان يشرب الرجل الشفافة كلها ، وهي بقية الماء في الاناء . يقول : قد يروي الشارب قبل بلوغ تلك وكذلك الحاجة .  ويقولون : قد يبلغ القطوف الوساع . وقد يبلغ الخضم القضم . يقولون : خذها ولو بقرطي مارية ، وهي ام ولد جفنة الغسانيين ، يقال للرجل يطلب الشء فيحث علي المبالغة فيه . ومن هذا الفن قوله صلي الله عليه وسلم لابي سفيان بن الحارث بن عبد المطلب لما جاء مسلما وكان هجا النبي صلي الله عليه وسلم : كل الصيد في جوف الفرا . ويقولون : هو بين الخلب والكبد للمبالغة في الحنو والاشفاق . ويقولون : ليس لما قرت به العين ثمن . ويقولون : اذا لم تسمع فالمع . اذا ضربت فاوجع . ويكون الاول لا تترك في الامر شبهة . ما جاء في الامر النادر من امثالهم في ذلك : انما هو كبارح الاروي ، يضرب للرجل لا  يري منه شء الا في الزمان مرة ، لان الاروي مساكنها الجبال ، ولا تكاد تري سانحة ولا بارحة . است لم تعود المجمر . كانت كبيضة العقر . ما جاء في الجبن والذل ؟ ؟ ان الجبان حتفه من فوقه ، قاله عمرو بن مامة في شعر له . كل ازب نفور ، قاله زهير بن جذيمة العبسي ، وانما كان نفار الازب من الابل لكثرة شعره ، ويكون ذلك في عينه ، فكلما راه ظن انه شخص يطلبه فنفر من اجله . عصا الجبان اطول ، وانما يطيلها من جنبه ارهابا لعدوه . ومنها : روغي جعار فانظري اين المفر . ومنها : افلت وانحص الذنب ، المثل لمعاوية ، وكان بعث رجلا من غسان الي ملك الروم ، وجعل له ثلاث ديات علي ان ينادي بالاذان اذا دخل  عليه مجلسه ، ففعل ذلك الغساني وعند ملك الروم بطارقته ، فوثبوا عليه ليقتلوه ، وثاروا الي وجهه بالسيوف فنهاهم ملكهم وقال : كنت اظن ان لكم عقولا ، انما اراد معاوية ان اقتل هذا غدرا وهو رسول ، فيفعل ذلك بكل مستامن منا ويهدم كل كنيسة في مملكته ، فجهزه واكرمه ورده . فلما راه معاوية قال : افلت وانحص الذنب ، فقال : كلا انه لبهلبه ، وحدثه الحديث ، فقال معاوية : لقد اصاب ما اردت . ومن امثالهم : افلت وله حصاص . افلتني جريعة الذقن ، اذا كان منه قريبا . ويقال للخاءف : افرخ روعك ، والمثل لمعاوية ، قاله لزياد . الجهل والحمق ومن امثالهم : لا يدري ما هر من بر . ولا يدري اي طرفيه اطول ، معناه انسب ابيه افضل ام نسب امه ؟ ومنها : لا يدري اسعد الله اكثر ام جذام وهما حيان بينهما من التفاوت ما لا يخفي علي جاهل ، قاله حمزة بن الضليل البلوي لروح بن زنباع الجذامي .  وقال الشاعر : من الوافر لقد افحمت حتي لست تدري . . . اسعد الله اكثر ام جذام ويقولون : ضل الدريص نفقه ، وهو تصغير الدرص ، والدرص ولد اليربوع ، يضرب في الحجة اذا اضلها الباغي . قد يضرط العير والمكواة في النار ، كانه جاهل بما يراد به . ويروي هذا المثل عن عمرو بن العاص . ويقولون : حدث حديثين امراة فان ابت فاربعة . ويروي حدث حديثين امراة فان لم تفهم فاربع ، اي كف عنها واسكت . ومن امثالهم : ربما كان السكوت جوابا . ويقولون : كالممهورة من مال ابيها . وكالممهورة احدي خدمتيها . ويقولون : خرقاء عيابة . ومن امثالهم : من كل شء تحفظ اخاك الا من نفسه . سفه بالناب الرغاء ، اي سفه بالشيخ التصابي .  البلية علي البلية من امثالهم في هذا : اغيرة وجبنا ، قالته امراة من العرب لزوجها ، وقال ابو عبيدة : هذه امراة المثني بن حارثة ، قالته يوم القادسية لسعد ابن ابي وقاص ، كان قد تزوجها بعد قتل المثني . ومن امثالهم : هو بين حاذف وقاذف ، والحاذف بالعصا والقاذف بالحجر . ويقولون : ضغث علي ابالة ، الابالة الحزمة من الحطب ، والضغث الجرزة التي فوقها . ويقولون : احشفا وسوء كيلة . ومن قول عامر بن الطفيل : اغدة كغدة البعير وموتا في بيت سلولية . قال الشاعر : من الكامل غضبت تميم ان تقتل عامر . . . يوم النسار فاعقبوا بالصيلم ومن امثالهم : كالمستغيث من الرمضاء بالنار . اخذ العسس  المستهل بن الكميت بن زيد في ايام المنصور فحبس ، فكتب يشكو حاله وكتب في اخر الرقعة : من الطويل اذا نحن خفنا في زمان عدوكم . . . وخفناكم ان البلاء لراكد فقال المنصور : صدق المستهل وامر بتخلية سبيله . ومن امثالهم : ان جرجر العود فزده ثقلا . ومنها : هل بعد السلب الا الاسار . خيبة الامل والسعي ومن امثالهم في نحو هذا : كطالب القرن جدعت اذنه . ومنها : كالباحث عن الشفرة . كالشاة تبحث عن سكين جزار . سقط العشاء به علي سرحان .  كمبتغي الصيد في عريسة الاسد . وقال جرير : من الطويل يشق علي ذي الحلم ان يتبع الهوي . . . ويرجو من الامر الذي ليس لاقيا واني لمغرور اعلل بالمني . . . ليالي ارجو ان مالك ماليا وقال الاقرع بن معاذ : من الطويل وكم سقت في اثاركم من نصيحة . . . وقد يستفيد الظنة المتنصح وقال عدي بن زيد : من الرمل لو بغير الماء حلقي شرق . . . كنت كالغصان بالماء اعتصاري ومن امثال اكثم بن صيفي : من فسدت بطانته كان كمن غص بالماء . ومن امثالهم : رجع فلان من حاجته بخفي حنين ، وحنين اسكاف بالحيرة ، ساومه اعرابي بخفين فاختلفا حتي اغضبه الاعرابي ، فلما ارتحل القي احد خفيه في طريقه ثم القي الاخر في موضع اخر ، فلما مر الاعرابي باحدهما قال : ما اشبه هذا بخف حنين ، لو كان معه الاخر اخذته ؛ ومضي فلما  انتهي الي الاخر ندم علي تركه الاول ، فلما مضي الاعرابي عمد حنين الي راحلته وما عليها وذهب بها ، واقبل الاعرابي ليس معه غير الخفين ، فقال له قومه : ماذا جءن به من سفرك ؟ فقال : قد جءتكم بخفي حنين ، فصار مثلا . ويقال للرجل اذا جاء من حاجته فارغا : جاء يضرب اصدريه ، اي عطفيه ، ويقرب من هذا المعني قول الشاعر : من الطويل يقولون ان العام اخلف نوءه . . . وما كل عام روضة وغدير ويقرب من ذلك قولهم : اسمن كلبك ياكلك ، ويقال سمن . قال المفضل : كان لرجل من طسم طلب يسقيه اللبن ويطعمه اللحم ، وكان يامل فيه ان يصيد ، فضري الكلب علي ذلك ، فجاع يوما وفقد اللحم ، فجاء ربه فوثب عليه واكل من لحمه . ما جاء في العدة بارتحالها فيجدها من الامثال في ذك قولهم : الي امه يلهف اللهفان . ولمثله كنت احسيك الحسي ، واصله الرجل يغذو فرسه بالالبان فيقول ذلك عند الهرب والنجاة . ومثله قول القطامي : من الكامل  واذا يصيبك والحوادث جمة . . . حدث حداك الي اخيك الاوثق ويتصل بهذا المعني من وجه اخر قولهم : كل ضب عند مرداته ، والمرادة الحجر الذي يرمي به ، ويقال : ان الضب قليل الهداية فلا يتخذ جحره الا عند حجر يكون علامة له ، فيه يرميه الطالب له ، فهو كالعدة له . الزم الامور بصاحبها من امثالهم في هذا : ابنك ابن بوحك . ابنك من دمي عقبيك . ويروي : ولدك . وكان المفضل يخبر بهذا المثل عن امراة لطفيل بن مالك بن جعفر بن كلاب ، وهي امراة من بلقين ، فولدت له عقيل بن الطفيل فتبنته كبشة بنت عروة بن جعفر بن كلاب ، فقدم عقيل علي ابيه يوما فضربه ، فجاءته كبشة فمنعته وقالت : ابني ، فقالت القينية : ابنك من ادمي عقبيك . ومن امثالهم من ذلك : منك الحيض فاغسليه . ومن امثالهم في تقارب هذا المعني : الحريص يصيدك لا الجواد . وقال المساور بن هند : ان الشقي بكل حبل يخنق .  ومثله : ان الشقاء علي الاشقين مصبوب . ومن امثالهم : شنشنة اعرفها من اخزم . لا يدعي للجلي الا اخوها . رب مملول لا يستطاع فراقه . رب مخالفة لا يمكن طلاقها . لا يعجز مسك السوء عن عرف السوء . ويقرب من هذا المعني قولهم : اينما اذهب الق سعدا ، قاله الاضبط ابن قريع بن عوف بن كعب بن سعد بن زيد مناة بن تميم ، اذته عشيرته من بني سعد ، فخرج عنهم فجعل لا يجاور قوما الا اذوه ، اي افر من الاذي الي مثله . الجاني علي نفسه من امثالهم في هذا : اتتك بحاءن رجلاه . يداك اوكتا وفوك نفخ ، الاول قاله عمرو بن هند وكان الي  ليقتلن من تميم ماءة رجل  في خبر طويل  وليحرقنهم ، فاحرق تسعة وتسعين واعوزه الرجل ، فاذا براكب يخب وقد راي القتار فظنه الطعام يصنع ، فلما اشرف علي عمرو وقال له من انت ؟ قال : من البراجم . فقال له عمرو : ان الشقي راكب البراجم ، فارسلها مثلا ، ثم احرقه ؛ والمثل الثاني اصله ان رجلا كان في بعض جزاءر العرب ، فاراد ان يعبر علي زق قد نفخ فيه فلم يحسن احكامه حتي اذا توسط البحر خرجت منه الريح فغرق ، فلما غشيه الموت استغاث برجل فقال له هذه المقالة . ومن امثالهم : لا يضر الشر الا من جناه . لا يحزنك دم ضيعه اهله . علي اهلها دلت براقش . الاول قاله جذيمة الابرش لما قطعت الزباء رواهشه فقال قاءل : احفظوا دم الملك لا يقطر منه الي الارض شء فقال جذيمة عند ذلك هذا المثل . واما براقش فهي كلبة نبحت علي جيش مروا ولم يشعروا بالحي الذي فيه الكلبة ، فلما سمعوا نباحها علموا ان اهلها هناك ، فعطفوا عليهم فاستباحوهم . ومن امثالهم مما يقارب هذا : كانت عليهم كراغية البكر وهو بكر ثمود ، وخبره ساءر . ويقولان : نزت به البطنة .  ومن امثالهم : كالنازي بين القرينين ، واصله في الابل ان يترك الذكر فياخذ في النزوان حتي يوثق في القران ، ويقرب من هذه المعاني قول ابن هرمة : من الوافر وحسبك تهمة برء قوم . . . يضم علي اخي سقم جناحا ومن امثالهم : كمجير ام عامر . ومنها : ما لاقي يسار الكواعب ، وكان من حديثه ان عبدا لبعض العرب ولمولاه بنات فجعل يتعرض لهن ويراودهن عن انفسهن ، فقلن له : يا يسار اشرب البان هذه اللقاح ونم في ظلال هذه الخيام ، ولا تتعرض لبنات الكرام ، فابي ؛ فلما اكثر عليهن واعدنه ليلا فاتاهن وقد اعددن له موسي ، فلما خلا بهن قبض عليه فجببن مذاكيره ، فصار مثلا لكل جان علي نفسه متعد لطوره . ومن امثالهم : كالكبش يحمل شفرة وزنادا . احسن فوق . وقال نصيب : من الطويل واني واياهم كساع لقاعد . . . مقيم واشقي الناس بالشعر قاءله  الاحالة بالذنب علي من لم يجنه من ذلك قول النابغة : من الطويل وحملتني دنب امرء وتركته . . . كذي العر يكوي غيره وهو راتع والعر داء ياخذ الابل في مشافرها وقواءمها ، تزعم العرب انهم اذا كووا الصحيح برء السقيم ، والعر بالفتح الجرب . ومن امثالهم : كالثور يضرب لما عافت البقر ، من شرب الماء ضربوا الثور يزعمون ان الجن تركب الثيران فتصد البقر عن الشرب . قال الحارث بن حلزة : من الخفيف عنتا باطلا وظلما كما تع . . . تر عن حجرة الربيض الظباء كان الرجل ينذر اذا بلغت ابله او غنمه مبلغا ما ذبح عنها كذا ، فاذا بلغت ضربها وعمد الي الظباء يصطادها ويذبحها وفاء بالنذر . وقال الفرزدق : من الطويل وشيبني ان لا يزال مرجم . . . من القول ماثور خفيف محامله تقوله غيري لاخر مثله . . . ويرمي به راسي ويترك قاءله وقال نهشل بن حري : من الطويل  تخليت من داء امرء لم يكن له . . . شريكا والقي رحله في الحباءل فان تغرموني داء غيري احتمل . . . ذنوب ذءاب القريتين العواسل ومن امثالهم : ما لي ذنب الا ذنب صحر . جزاني جزاء سنمار ، وخبرهما ، قال المفضل : هي صحر بنت لقمان العادي ، وكان ابوها لقمان واخوها لقيم ، فخرجا مغيرين فاصابا ابلا كثيرة ، فسبق لقيم الي منزله ، فعمدت اخته صحر الي جزور منها مما قدم به لقيم فنحرتها وصنعت منها طعاما يكون معدا لابيها لقمان اذا جاء تتحفه به ، وكان لقمان حسد ابنه لقيما لتبريزه  كان  عليه ، فلما قدم لقمان قدمت صحر اليه الطعام وعلم انه من غنيمة لقيم لطمها لطمة فقات عينها ، فصارت عقوبتها مثلا لكل من لا ذنب له يعاقب . وكان من حديث سنمار انه كان بناء وكان مجيدا ، وهو من الروم ، فبني الخورنق الذي بظهر الكوفة للنعمان بن امرء القيس ، فلما نظر اليه النعمان كره ان يعمل مثله لغيره فالقاه من اعلي الخورنق فخر ميتا . وفيه يقول القاءل : من الطويل جزتنا بنو سعد بحسن فعالنا . . . جزاء سنمار وما كان ذا ذنب ومثله : ان كنت ريحا فقد لاقيت اعصارا .  الحديد بالحديد يفلح . النبع يقرع بعضه بعضا . رمي فلان بحجره . ويقولون : ليس هو حقيقة ولكنه قريب منه . لءن التقي روعي وروعك لتندمن . ويقولون : ادفع الشر بمثله اذا اعياك غيره . وقال الفند الزماني : من الهزج وفي الشر نجاة حي . . . ث لا ينجيك احسان دواء الشء بمثله او اشد ان علي اختك تطردين ، وذلك ان فرسا نفرت فطلبت اختها ، يضرب للرجل يلقي مثله في الدهاء والشجاعة او غير ذلك . ومثله : ان تك ضبا فاني حسله .  ويقولون : باءت عرار بكحل ، وهما ثور وبقرة كانا لسبطين من بني اسراءيل ، فقتل احد السبطين الثور ، فكادوا يتفانون بينهم حتي اباءوا به البقرة . ويقولون : قد بل بعير اعزل اي يمر بين يدي عدة . ان يكن بطريرا فاني صهصلق ، كلاهما بمعني صخوب . تنافي الحالات من شواهد الكتاب العزيز في ذلك قوله تعالي : هل يستوي الذي يعلمون والذين لا يعلمون الزمر :  . وقوله عز وجل : افمن اسس بنيانه علي تقوي من الله وروضوان خير ام من اسس بنيانه علي شفا جرف هار فانهار به في نار جهنم التوبة :  . قيل نزلت في شان مسجد قباء ومسجد الضرار الذي بناه ابو عامر الراهب ، احد المنافقين ، بناه ليقطع به النبي صلي الله عليه وسلم والمءمنين عن مسجد قباء . قوله سبحانه : افمن كان مءمنا كمن كان فاسقا لا يستوون السجدة :  . قيل نزلت في علي بن ابي طالب عليه السلام وعقبة بن ابي معيط ، وكان عقبة فخر علي علي عليه السلام فقال له علي عليه السلام : اسكت انما انت فاسق ، فنزلت هذه الاية ، وشهد ما بعدها لعلي عليه السلام بالجنة ولعقبة بالنار بقوله : اما الذين امنوا وعملوا الصالحات فلهم جنات الماوي نزلا بما كانوا يعملون واما الذين فسقوا فماواهم النار السجدة  ،  . ذكره الزجاج وغيره . ومن امثال لاعرب : ماء ولا كصداء ، وصداء بءر ؛ واصل هذا المثل ان ابنة هانء بن قبيصة لما قتل عنها زوجها لقيط بن زرارة تزوجها رجل من اهلها ، فكان لا يزال يراها تذكر لقيطا ، فقال لها ذات يوم : ما استحسنت من  لقيط ؟ فقالت : كل اموره كانت حسنة ، ولكني احدثك انه خرج مرة الي الصيد وقد انتشي ، فركب ورجع بقميصه نضح من صيده ، والمسك يضوع من اعطافه ، وراءحة الشراب من فيه ، فضمني ضمة وشمني شمة فياليتني مت ثمة ، قال : ففعل زوجها مثل ذلك ثم ضمها اليه وقال : اين انا من لقيط ؟ فقالت : ماء ولا كصداء . ومثله : رجل ولا كمالك ، يعنون مالك بن نويرة . ومرعي ولا كالسعدان ، قالته امراة من طء لامرء القيس ، وكان مفركا ، فقال لها : اين انا من زوجك الاول ؟ فقالت : مرعي ولا كالسعدان . وانشدوا للاسعر بن ابي حمران الجعفي : من المتقارب اريد دماء بني مازن . . . وراق المعلي بياض اللبن خليلان مختلف بالنا . . . اريد العلاء ويبغي الثمن يريد المعلي فرسه ، وكانت بنو مازن قتلت اباه وكانت خالته ناكحا في بني مازن ؛ فكان الاسعر اذا وجد غفلة اغار علي بني مازن فقتل فيهم ؛ فقالت لهم خالته : بولوا الودق علي حافة الطريق وضعوا لبنا فلعل الفرس اذا وجد ريح ذلك احتبس فاصبتموه ؛ ففعلوا ذلك واغار عليهم وانصرف كعادته يحمي اصحابه حتي اذا اراد ان تسرح الفرس طفق الفرس الي ريح اللبن والابوال ، وكثروه حتي اكتنفوه ، فلما راي ذلك قال : واثكل اماه وخالتاه فلما سمعت ذلك خالته قالت : لا اراني الا احدي الثاكلتين ، فنادت به ان اضرب فيه ، ففعل فانسرح الفرس وذهب ، وانما امرتهم بذلك لان الفرس كان غذاءه اللبن . وقال الاعشي  وبيته هذا مثل ساءر : من السريع شتان ما يومي علي كورها . . . ويوم حيان اخي جابر ومن امثال العرب : انت تءق وانا مءق فكيف نتفق ؟ ويروي : فمتي نتفق . التءق السريع الي الشر ، والمءق السريع البكاء . ويقال الممتلء من الغضب . ومن امثالهم : ما يجمع بين الاروي وبين النعام ، يقولون : تلك في رءوس الجبال وهذه في السهولة . ومنها : لا يجتمع السيفان في غمد . ومنه قول ابي ذءيب : من الطويل تريدين كيما تجمعيني وخالدا . . . وهل يجمع السيفان ويحك في غمد ولهذا الشعر خبر قد ذكر في موضعه . ومنها : ما يلقي الشجي من الخلي . ويقولون : هان علي الاملس ما لاقي الدبر .  ومن امثالهم : حن قدح ليس منها ، واصله ان رجلا مدح قوما واطراهم وليس منهم . ولما امر رسول الله صلي الله عليه وسلم يوم بدر بضرب عنق عقبة بن ابي معيط بن ابي عمرو بن امية بالسيف صبرا قال : اقتل من بين قريش صبرا ؟ فقال عمر ابن الخطاب رضي الله عنه : حن قدح ليس منها ، اي انك لست من قريش ، وكان عمر قاءفا . ويروي ان ابا عمرو بن امية كان عبدا في صفورية وكان امية قد عمي فكان يقوده ، فغناه بيت جرير يقوله لعدي بن الرقاع : من البسيط وابن اللبون اذا ما لز في قرن . . . لم يستطع صولة البزل القناعيس وقال عدي بن الرقاع : من الكامل والقوم اشباه وبين حلومهم . . . بون كذاك تفاضل الاشياء كالبرق منه وابل متتابع . . . جود واخر ما يجود بماء والمرء يورث مجده ابناءه . . . ويموت اخر وهو في الاحياء ويقولون في تنافي الحال بين الشبيبة والهرم : كنت وما اخشي بالذءب ؛ ويقال : كنت وما اخشي من الذءب . كنت وما يقاد بي البعير ، والمثل لسعد بن زيد مناة بن تميم . ومن امثالهم : اريها السهي وتريني القمر .  تفرق من صوت الغراب وتفرس الاسد المشتم . بءس العوض من جمل قيده . راس في السماء واست في الماء . اضرطا وانت الاعلي . ويقولون : سلكي ومخلوجة ، يريدون الاختلاف . ويقولون انما السلكي المستقيمة والمخلوجة المعوجة . ويقولون : لا تجعل قدك الي اديمك . القد مسك السخلة ، وجمعه قداد ، والاديم الجلد العظيم . ومن امثالهم : مرة جيش ومرة عيش . اليوم خمر وغدا امر ، قاله امرء القيس لما ورد عليه خبر قتل ابيه ، وكان يشرب فذهبت مثلا . ومن امثالهم : شخب في الاناء وشخب في الارض ، وقد يضرب مثلا للرجل يخطء ويصيب .  ومثله : يشج مرة وياسو اخري . ومثله : اطرقي وميشي ، واصله خلط الصوف بالشعر ، وقد يضرب للرجل يخلط كلامه بين صواب وخطا . ومما يناسب هذا المعني المثل الساءر : شب عمرو عن الطوق ، معناه كبر عن سن الصغير الذي يلبس الطوق . وكذلك قولهم : جلت الهاجن عن الولد ، قال ابو عبيد : الهاجن هي الصغيرة ، ومنه يقال : اهتجنت الجارية اذا افترعت قبل الاوان ، وانما ارادوا صغرت . قال : وانا احسب هذا من الاضداد لانهم يقولون للعظيم جلل . ويقال ايضا في الحقير جلل ؛ قال امرء القيس : من المتقارب لقتل بني اسد ربهم . . . الا كل شء سواه جلل وقال لبيد في العظيم : من الرمل ومن الارزاء رزء ذو جلل ومما يليق بهذا المعني قول الشاعر : من الوافر الم تر ان سير الخير ريث . . . وان الشر ساءره يطير  وقال اخر : من الطويل اذا ما بريد الشام اقبل نحونا . . . ببعض الدواهي المفظعات فاسرعا فان كان شرا سار يوما وليلة . . . وان كان خيرا ابطا السير اربعا وتمثل بهذا البيت الثاني معاوية لما بلغه وفاة الحسن بن علي عليهما السلام . وقال ابو ذءيب : من المتقارب فيا بعد داري من دراكم . . . كبعد سهيل من الفرقد وقال المءمل : من الكامل والقوم كالعيدان يفضل بعضهم . . . بعضا كذاك يفوق عود عودا ومن امثالهم : ان كنت ذواقا فاني نشبة ، يقول : ان كنت لا وفاء لك ، فاني داءم العهد ، والنشبة الذي اذا عبث بالشء لم يفارقه . ومنها : جل الرفد عن الهاجن . الرفد : العس ، والهاجن البكرة تنتج قبل ان يخرج لها سن . الرضا بالميسور اذا تعذر المنشود من امثالهم في هذا النحو : اذا عز اخوك فهن ، قاله الهذيل بن هبيرة الثعلبي ، وكان اغار علي بني ضبة فغنم واقبل بالغناءم ، فقال اصحابه : اقسمها بيننا ، قال : اني اخاف ان تشاغلتم بالاقتسام ان يدرككم الطلب ، فلما  لم يقبلوا قال المثل حينءذ ، ثم نزل فقسم بينهم الغناءم . ويقارب ذلك قولهم : ان لم يغلب فاخلب . سوء الاستمساك خير من حسن الصرعة . ويناسبه : كل الحذاء يحتذي الحافي الوقع . واصله الرجل يمشي في الوقع  وهي الحجارة  حافيا فيصيبه الوجي . ومنه : ولكن من يمشي سيرضي بما ركب . ومثله : ركب الصعب من لا ذلول له . ومنه : رضي من الوفاء باللفاء ، واللفاء دون حق الرجل . ومنه : ان تسلم الجلة فالسخل هدر . ويقولون : ارض من المركب بالتعليق . ويقولون : الثيب عجالة الراكب . ويقولون : من حقر حرم ، يحضون علي المعروف ولا يحقر  قليله . وقال الشاعر : من البسيط وكل ما سد فقرا فهو محمود من الرجز يكفيك ما بلغك المحلا وقال امرء القيس بن حجر : من الوافر اذا ما لم تجد ابلا فمعزي . . . كان قرون جلتها العصي اذا ما قام حالبها ارنت . . . كان القوم صبحهم نعي فتملا بيتنا اقطا وسمنا . . . وحسبك من غني شبع وري قاله امرء القيس بن حجر ، وقد نزل علي المعلي بن تيم الطاءي حين طردته العرب ، واتخذ هناك ابلا فغدا قوم من جديلة يقال لهم بنو زيد فطردوا الابل ، وكانت لامرء القيس رواحل مقيدة خوفا من ان يدهمهم امر ليسبق عليهن ، فخرج نفر منهم فركبوا الرواحل ليطلبوا الابل ، فاخذتهم جديلة ، فرجعوا اليه بلا شء ، فذلك قوله : من الطويل فدع عنك نهبا صيح في حجراته . . . ولكن حديث ما حديث الرواحل ففرقت عليه بنو نبهان فرقا من معزي يحتلبها . ومن ذلك قول عمرو بن معدي كرب : من الوافر اذا لم تستطع شيءا فدعه . . . وجاوزه الي ما تستطيع يقول ذلك من ابيات اولها :  امن ريحانة الداعي السميع . . . يءرقني واصحابي هجوع وريحانة اخته سباها الصمة الجشمي ابو دريد ، فلم يقدر عمرو علي استنقاذها ، ثم تزوجها الصمة فاولدها دريدا وعبد الله وقيسا وخالدا وعبد يغوث . ومنه قولهم : اذا لم يكن ما تريد فارد ما يكون . قال زياد بن منقذ : من الطويل اذا سد باب عنك من دون حاجة . . . فدعه لاخري بنفتح لك بابها وقال يحيي بن زياد : من الكامل واذا توعر بعض ما تسعي له . . . فاركب من الامر الذي هو اسهل وقال ايضا : من الوافر اذا كدرت عليك امور ورد . . . فجزه الي موارد صافيات ويقولون : ان الرشف انقع . وقبح الله معزي خيرها خطة . ويقولون : كل فضل من ابي كعب درك ، لمن يطلب المعروف من بخيل فينيل يسيرا فيرضي به .  الامر المضاع المهمل من امثالهم في ذلك : صفقة لم يشهدها حاطب ، اصله ان بعض اهل حاطب باع بيعة غبن فيها ، فقيل ذلك . ويقارب ذلك قولهم : يخبط خبط عشواء . ومن امثالهم : لا ابوك نشر ولا التراب نفد . ومنها : لا ماءك ابقيت ولا اناءك انقيت . قال الاحمر في المثل الاول : اصل هذا ان رجلا قال : لو علمت اين قتل ابي لاخذت من تراب موضعه فجعلته علي راسي ، فقيل له ذلك ، اي لا تدرك بهذا اثار ابيك ولا ينفد التراب . واما المثل الثاني فاصله ان رجلا كان في السفر ومعه امراته ، وكانت عاركا ، فحضرها طهرها وعها ماء يسير فاغتسلت به ، فلم يكفها لغسلها وقد انفدت الماء ، فبقيت هي وزوجها عطشانين . ومنه قول عمر بن الخطاب رضي الله عنه : النساء لحم علي وضم الا ما ذب عنه . وقول كعب بن زهير : اوسعتهم سبا وراحوا بالابل ، وكانت  بنو اسد اغارت علي ابلهم فهجاهم . ويقرب من هذه المعاني قولهم : ان الموصين بنو سهوان ، يراد انهم يغفلون ويسهون عما يوصون به . ويقرب منه قولهم : كف مطلقة تفت اليرمع ، كانها تفعل فعلا لا يفيدها . ويقولون : بعد خيرتها يحتفظ اي راعي الغنم ، يضرب في الحذر بعد الاضاعة . كثرت الحلبة وقل الرعاء ، يضرب في ضياع الامر مع كثرة الولاة . ارتفاع الخامل ان البغاث بارضنا يستنسر ، وقد يريدون بذلك وصف بلادهموان الضعيف بها الجبان يصير شجاعا . ومن امثالهم في هذا المعني : كان كراعا فصار ذراعا ، وهذا يروي عن ابي موسي الاشعري . ومنها : لكن بشعفين انت جدود ، واصله ان امراة اخصبت بعد هزل فذكرت درة لبنها ففرحت بها فقيل لها : لكن بشعفين انت جدود ،  لم تكوني كذلك ، وهو اسم موضع كانت تنزله . ومن امثالهم : استنت الفصال حتي القرعي . ويقولون : الذءب يكني ابا جعدة ، وربما يريدون به اكرام من لا يراد اكرامه . ويقرب من هذا في طلب الزيادة ممن ليس لها باهل : اعطي العبد كراعا فطلب ذراعا ، واصله ان جارية يقال لها ام عمرو ، وكانت لمالك وعقيل ندماني جذيمة ، فجلس اليهما رجل طويل الشعر والاظافير هو عمرو بن عدي ابن اخت جذيمة فناولاه شيءا من الطعام فطلب اكثر منه ، فعندها قالت ام عمرو : اعطي العبد ذراعا . ثم صاروا الي الشراب فجعلت ام عمرو تسقي صاحبيها وتدع عمرا ، ففيها يقول عمرو بن كلثوم : من الوافر صددت الكاس عنا ام عمرو . . . وكان الكاس مجراها اليمينا فذهب كلامه وكلامها مثلين ، وكان هذا كله قبل ان يعرفوه ، فلما انتسب الي مالك وعقيل فرحا وقدما به علي خاله جذيمة ، فكان من امره وامرهما ما ذكرت في موضعه . وما احسن ما قال البحتري في هذا المعني : من الطويل  متي ارت الدنيا نباهة خامل . . . فلا تنظر الا خمول نبيه خمول النبيه مما يقارب ذلك قول النبي صلي الله عليه وسلم في استعاذته : اللهم اني اعوذ بك من الحور بعد الكور ، اي من النقصان بعد الزيادة . ومن امثال العرب : غلبت جلتها حواشيها ، الجلة مسان الابل وحواشيها صغارها ورذالها . ويقولون : كان حمارا فاستاتن . ويقولون في قريب منه : اودي العير الا ضرطا . ومن امثالهم : استنوق الجمل ، وهذا المثل لطرفة بن العبد ، وكان عند بعض الملوك وشاعر ينشده شعرا ، فوصف جملا ثم حوله الي نعت ناقة ، فقال ذلك عندها ، وقد يضرب هذا المثل في التخليط . ومن امثالهم : الحمي اضرعتني لك . ويقولون : لم يبق منه الا قدر ظمء حمار ، يقال : ان الحمار اقل الدواب ظمءا . ويقولون : كان جوادا فخصي .  ما جاء في الشر وراءه الخير من ذلك قوله تعالي : فان مع العسر يسرا الشرح :  . وقوله سبحانه : عسي ان تكرهوا شيءا ويجعل الله فيه خيرا النساء :  . وعسي ان يكرهوا شيءا وهو خير لكم البقرة :  . وقيل لبعض الصالحين وقد اجهد نفسه في العبادة : اتعبت نفسك قال : راحتها طلبت . وقال يزيد بن محمد المهلبي : من الرجز رب زمان ذله ارفق بك . . . لا عار ان ضامك دهر او ملك وقال اخر : من الطويل اهين لهم نفسي لاكرمها بهم . . . ولا يكرم النفس الذي لا يهينها ومن امثال العرب : لا يضر الحوار ما وطءته امه . ومن امثالهم : لم يذهب من مالك ما وعظك ، يقول : اذا ذهب من مالك شء فحذرك ان يحل بك مثله ، فتادييه اياك عوض من ذهابه . ومن امثالهم : الغمرات ثم ينجلين . عند الصباح يحمد القوم السري ، المثلان للاغلب العجلي .  ومنها : تسمع بالمعيدي خير من ان تراه ، قاله النعمان بن المنذر للصقعب بن عمرو النهدي . هذا قول ابن الكلبي ، وزعم ان قضاعة ابن معد ، ونهد بطن من قضاعة ؛ واما المفضل فقال : ان المثل للمنذر بن ماء السماء قاله لشقة بن ضمرة النهشلي ، فقال له شقة : ابيت اللعن ان الرجال ليسوا بجزر يراد منهم الاجسام ، وانما المرء باصغريه قلبه ولسانه ، ذهبت مثلا ، واعجب المنذر ما راي من بيانه وعقله ، فسماه باسم ابيه وقال : انت ضمرة بن ضمرة . ما جاء في ضد ذلك من شواهد الكتاب العزيز في هذا المعني قوله تعالي : فلما راوه عارضا مستقبل اوديتهم قالوا هذا عارض ممطرنا بل هو ما استعجلتم به ريح فيها عذاب اليم الاحقاف :  . وقوله تعالي : وان ادري لعله فتنة لكم ومتاع الي حين الانبياء :  . ومن امثال العرب : رب صلف تحت الراعدة ، والصلف قلة الخير ، والراعدة السحابة ذات الرعد . وقال اعرابي : رب مونق موبق . ومثله لشاعر ينهي عن تزوج الحسناوات : من البسيط ولن تمر بمرعي مونق ابدا . . . الا وجدت به اثار ماكول وقد تقدم ذكر قوله صلي الله عليه وسلم : اياكم وخضراء الدمن . وقال رجل من عبد القيس : من الرمل جامل الناس اذا ما جءتهم . . . انما الناس كامثال الشجر منهم المذموم في منظره . . . وهو صلب عوده حلو الثمر  وتري منه اثيثا نبته . . . طعمه مر وفي العود خور وقال اخر : من البسيط الح جودا ولم تضرر سحاءبه . . . وربما ضره في الحاجة المطر وقال ابو نواس : من البسيط بل استترت باظهار البشاشة لي . . . بالبشر مثل استتار النار بالعود ومن امثالهم : يا حبذا الميراث لولا الذلة ، قاله نعامة حين قتل اخوته . نعم كلب في بءس اهله ، يقول : اذا وقع الموت في مواشي القوم نعم كلبهم . ومثله : سمن كلب ببءس اهله . وقال زهير : من الكامل المرفل والستر دون الفاحشات وما . . . يلقاك دون الخير من ستر ويقارب هذه المعاني قولهم : رب عجلة تهب ريثا . من سره بنوه ساءته نفسه ، هذا المثل لضرار بن عدي الضبي ،  وكان طعنه عامر بن مالك فارداه عن فرسه ، فاشبل عليه بنوه حتي استشالوه . ودخل ضرار علي المنذر فقال له : ما الذي نجاك يومءذ ؟ قال : تاخير الاجل واكراهي نفسي علي المق الطوال . ومن امثالهم : رب امنية قادت الي منية . ويقولون : شر يوميها واغواه لها ، اصله ان امراة من طسم يقال لها عنز سبيت فحملوها في هودج والطفوها بالقول والفعل فقالت هذه المقالة . ولها يقول الشاعر : من الرمل شر يوميها واغواه لها . . . ركبت عنز بحدج جملا ويقولون : تجنب روضة واحال يعدو ، اي ترك الخصب واختار الشقاء . ويقولون : تبرد هذا الضب فذنب ، اي اخرج ذنبه فحان ، اراد ان يقع في الخير فوقع في الشر . الخطا والاختلاط ان اخا الظلماء اعشي بالليل ، يضرب لمن يخطء حجته ولا يبصر المخرج منها . ومن امثالهم : اساء رعيا فسقي ، واصله ان يسء الراعي رعي  الابل نهاره ، حتي اذا اراد ان يريحها الي اهلها كره ان يظهر سوء اثره فيسقيها الماء فتمتلء اجوافها . ويقولون في الاختلاط : اختلط الحابل بالنابل . ويقولون : اختلفت رءوسها فرتعت ، يضرب مثلا في الاختلاط واختلاف الكلمة . الجميل يكدر بالمن قال الله تعالي : يا ايها الذين امنوا لا تبطلوا صدقاتكم بالمن والاذي كالذي ينفق ماله رءاء الناس ولا يءمن بالله واليوم الاخر ، فمثله كمثل صفوان عليه تراب فاصابه وابل فتركه صلدا ، لا يقدرون علي شء مما كسبوا والله لا يهدي القوم الكافرين . البقرة :  . ومن امثال العرب : شوي اخوك حتي اذا انضج رمد ، وينسب الي عمر بن الخطاب رضي الله عنه . وقال الحطيءة : من الطويل وان انعموا لا كدروها ولا كدوا ومن امثالهم : ما ضفا ولا صفا عطاءك ، كدره ما قال احباءك ، اي يمنون علي والمنة تكدر المعروف .  ما جاء في اغتنام الفرصة من امثالهم في ذلك : خذ من جذع ما اعطاك . قال المفضل : كان من حديثه ان غسان كانت تءدي الي ملوك سليح دينارين كل سنة عن كل رجل ، فكان الذي يلي ذلك سبطة بن المنذر السليحي . فجاء سبطة بن المنذر الي جذع بن عمرو الغساني يساله الدينارين ، فقال : اعجل لك احدهما واخر علي الاخر حتي اوسر ، فقال سبطة : ما كنت لاءخر عليك شيءا ، فدخل جذع الي منزله ثم خرج مشتملا علي سيفه ، فضرب سبطة حتي سكت ثم قال : خذ من جذع ما اعطاك . فذهب مثلا ، وامتنعت غسان من الدينارين بعد ذلك . ومنه قولهم : اسر وقمر بدر . ويقاربه قولهم : اذا اصبت ابلا فاذهب بها وابعدن مراحها من ريها ، يقال هذا للرجل بين القوم فيءمر ان يناي عنهم كيلا يصيبوه بمثل ما اصابهم . ومن امثالهم في اللقاء يقولون في اللقاء عن قرب : لقيته ادني ظلم . ولقيته اول عين ، اي اول شء . ولقيته اول ذات يدين .  ولقيته شد النهار ومده ، ومده ارتفاعه . ولقيته سراة اليوم ، اي اوله . ولقيته اديم الضحي ، اي اوسطه واوله ولقيته التقاطا . قال الشاعر : من الرجز ومنهل وردته التقاطا ويقال في المواجهة : لقيته كفاحا . ولقيته صراحا . ولقيته كفة . واذا لقيته في اليومين او الثلاثة قلت : لقيته في الفرط . قال الاحمر : ولا يكون الفرط في اكثر من خمس عشرة ليلة . فان لقيته بعد شهر او نحوه قلت : لقيته عن عفر . فان لقيته بعد الحول قلت : لقيته عن هجر . ويقولون : لقيته بين سمع الارض وبصرها ، اذا كان ياتيه ثم يمسك  ثم ياتيه ، والاعتمار الزيارة متي كانت ، قال اعشي باهلة : من البسيط وراكب جاء من تثليث معتمرا وقال ابو عبيدة : هو المعتم بالعمامة ، وكل شء جعلته علي راسك من عمامة او قلنسوة او تاج او اكليل فهو عمار . تعذر الامر وما يعرض دونه من امثالهم في ذلك : من لي بالسانح بعد البارح ؛ واصله ان رجلا مرت به ظباء بارحة فكره ذلك ، فقيل انها ستمر بك سانحة ، فعندها قال ذلك . ومنها : لا تك كالمختنقة علي اخر مدها ، وذلك انها طحنت طحينها فلما بقي مد انكسر قطب الرحي . ومن امثالهم : حيل بين العير والنزوان . قال الشاعر : من الطويل اهم بامر الحزم لو استطيعه . . . وقد حيل بين العير والنزوان ويقولون : قد علقت دلوك دلوا اخري ، يريدون انها تعلق بها فتمنعها من الصعود ، وقد يقال ذلك في الاشتراك . قال الشاعر : من الطويل وفي نظر الصادي الي الماء حسرة . . . اذا كان ممنوعا سبيل الموارد  ومن امثالهم : حال الجريض دون القريض ، والمثل لعبيد بن الابرص في قصته مع النعمان . ومنها : سد ابن بيض الطريق . اصله ان رجلا في الزمن الاول يقال له ابن بيض عقر ناقة علي ثنية فسد بها الطريق ، فمنع الناس من سلوكها . وقال المفضل : كان ابن بيض رجلا من عاد وكان تاجرا مكثرا ، وكان لقمان بن عاد يحفره في تجارته ، ويجيره علي خرج يعطيه ابن بيض يضعه له علي ثنية الي ان ياتي لقمان فياخذه ، فاذا ابصره لقمان قد فعل ذلك قال : قد سد ابن بيض السبيل . يقول : انه لم يجعل لي سبيلا علي اهله وماله حتي وفي لي بالجعل الذي سماه . ويقرب منذ لك قولهم : من لك بذناب لو ؛ اي من لك بان يكون لو حقا . ما جاء في طلب الحاجة وما يليق بذلك ومن امثالهم : اتبع الفرس لجامها ، يضرب للحاجة يطلب تمامها . المثل لعمرو بن ثعلبة الكلبي اخي عدي بن جناب ، وكان ضرار بن عمرو الضبي قد اغار عليهم فسبي يومءذ سلمي بنت واءل الصاءغ ، وكانت يومءذ امة لعمرو بن ثعلبة وكان له صديقا ، فقال له : انشدك بالاخاء والمودة الا رددت علي اهلي ، فجعل يرد شيءا بعد شء حتي بقيت سلمي ، وكانت قد  اعجبت ضرارا فابي ان يردها ، فقال عمرو : يا ضرار اتبع الفرس لجامها ، فارسلها مثلا . وردها عليه ضرار . ومن امثالهم : تمام الربيع الصيف ، واصله في المطر ، فاوله الربيع والصيف الذي يليه . ومنها : السراح مع النجاح . ومنها : الق دلوك في الدلاء . قال الشاعر : من الوافر وليس الرزق عن طلب حثيث . . . ولكن الق دلوك في الدلاء تجء مليءة طورا وطورا . . . تجء بحماة وقليل ماء ويقولون : لا يرسل الساق الا ممسكا ساقا ، يضربونه مثلا لمن يسال حاجة بعد حاجة قضيت له . ومن امثالهم في الطلب من اجدب انتجع . ان جانب اعياك فالحق بجانب .  ومثله : وفي الارض للحر الكريم منادح . والندحة السعة . ويقولون : النفس تعرف من اخوها النافع . ومن كلامهم : ادرها وان ابت . سبق سيله مطره . ويقولون اذا اهتم بها : جعلها نصب عينيه . وفي ضده : جعلها بظهره . ما جاء في التعجيل وفوت الامر من امثالهم في هذا : انقطع السلا في البطن ، اي فات الامر . ويقولون للساهي يفوته الامر : يذهب يوم الغيم ولا تشعر به . قال البعيث : من الطويل ولا تبكين في اثر شء ندامة . . . اذا نزعته من يديك النوازع ومن امثالهم : لا ادري اي الجراد عاره ، للامر يفوت ، اي اي الناس اخذه .  ويقولون : ضح رويدا ، اي لا تعجل . وزمن امثالهم : سبق السيف العذل ، كان المفضل يحدث بهذا المثل عن ضبة بن اد ، وبدء ذلك انه كان له ابنان سعد وسعيد ، فخرجا في طلب ابل لهما ، فرجع سعد ولم يرجع سعيد ، وكان ضبة كلما راي شخصا مقبلا قال : اسعد ام سعيد ؟ فذهبت هذه كلمته مثلا . قال : ثم ان ضبة بينما هو يسير ومعه الحارث ابن كعب في الشهر الحرام اذ اتيا علي مكان فقال الحارث لضبة : اتري هذا الموضع فاني لقيت به فتي من هيءته كذا وكذا فقتلته واخذت منه هذا السيف ، واذا هو صفة سعيد ؛ فقال له ضبة : ارني السيف انظر اليه ، فناوله فعرفه ضبة ، فقال عندها : ان الحديث ذو شجون . فذهب كلمته هذه الثانية مثلا ، ثم ضرب به الحارث حتي قتله ، قال : فلامه الناس في ذلك وقالوا : اتقتل في الشهر الحرام ؟ فقال سبق السيف العذل . فذهبت هذه الثالثة مثلا . ومن امثالهم في ترك التعجيل : الليل طويل وانت مقمر ، قاله  السليك لما هجم عليه الرجل وجلس علي صدره وقال استاسر ، يريد بالكلمة لا تعجل حتي تصبح . الحذر قبل ارسال السهم ، اي لا تفعل ما تخاف ان يفوت . ويقولون : لا يملك حاءن دمه . لا عتاب علي الجندل ، اي قد وقع الامر الذي لا مرد له . ومن امثالهم في الفوت : هلك القيد واودي المفتاح . ومن الفوت قولهم : الصيف ضيعت اللبن ، المثل لعمرو بن عمرو بن عدس ، وكانت عنده دختنوس ابنة لقيط بن زرارة ، وكان ذا مال كثير الا انه كان كبير السن ، ففركته فلم تزل تساله الطلاق حتي فعل ، فتزوجها بعده عمرو بن معبد بن زرارة ابن عمها ، وكان شابا الا انه معدم ، فمرت ابل عمرو ابن عمرو ذات يوم بدختنوس فقالت لخادمتها : انطلقي فقولي له يسقينا من اللبن ، فقال لها هذه المقالة ، فذهبت مثلا ؛ قال : ولعله كان طلقها بالصيف . ما جاء في سوء المكافاة وظلم المجازاة من امثالهم في هذا المعني : من استرعي الذءب ظلم . وقال اكثم بن الصيفي : ليس من العدل سرعة العذل .  ومن كلامهم : رب لاءم مليم . ومن امثالهم : الحرب غشوم ، اي يقتل فيها من لم يكن له فيها جناية ولا ذنب . ويقولون : الظلم مرتعه وخيم . قال الشاعر : من الكامل المجزوء البغي يصرع اهله . . . والظلم مرتعه وخيم ومن امثالهم : احشك وتروثيني ، يخاطب فرسا له ، يقول : اعلفك الحشيش وانت تروثين علي . ومن امثالهم : شر الرعاء الحطمة . وقال الشاعر : من الوافر اعلمه الرماية كل يوم . . . فلما اشتد ساعده رماني ومن امثالهم : لو ذات سوار لطمتني . لا تبل في قليب شربت منه ، اي لا تذمن من اسدي اليك معروفا .  ما جاء في الظن قال الله سبحانه : يا ايها الذين امنوا اجتنبوا كثيرا من الظن ان بعض الظن اثم الحجرات :  . ومن امثالهم : الشفيق بسوء الظن مولع . وقال اكثم بن صيفي : من احسن الظن اراح نفس . وقالوا : من يسمع يخل . وقال الطرماح : من الطويل متي ما يسء ظن امرء بصديقه . . . وللظن اسباب عراض المسارح يصدق امورا لم يجءه يقينها . . . عليه ويعشق سمعه كل كاشح وقال ابن مقبل : من المتقارب ساترك للظن ما بعده . . . ومن يك ذا ريبة يستبن ولا تتبع الظن ان الظنون . . . تريك من الامر ما لم يكن وقال يحيي بن زياد : من البسيط  وسوء ظنك بالادنين داعية . . . لان يخونك من قد كان مءتمنا وقال ايضا : من الطويل اذا انت خونت الامين بظنة . . . فتحت له بابا الي الخون مغلقا فاياك اياك الظنون فانها . . . واكثرها كالال لما ترقرقا وقال اخر : من الطويل اذا انت لم تبرح تظن وتقتضي . . . علي الظن اردتك الظنون الكواذب ويقرب من البناء علي الظن قولهم : من يرقد يحلم . ما جاء في التبري من الامر من امثالهم في هذا : لا ناقة لي في هذا ولا جمل ، قاله الحارث عباد في قتل جساس كليبا . ويقولون : ما لي بهذا الامر يدان . ويقولون : هذا احق منزل بترك . ويقاربه : لا يطاع لقصير امر ، قاله قصير بن سعد صاحب الزباء حين اشار علي جذيمة فصدف عن رايه .  ويقولون : خل سبيل من هي سقاءه ، اي خل سبيل من لا يريد صحبتك . ومثله : انما يضن بالضنين . قال لبيد : من الكامل فاقطع لبانة من تعرض وصله . . . ولخير واصل خلة صرامها ومن امثالهم : لا قرار علي زار من الاسد . ويقولون : خل امرءا وما اختار ، وان ابي الا النار . ويقولون : الق حبله علي غاربه ، واصله الناقة اذا ارسلت ترعي القي حبلها علي غاربها ؛ ولا يترك ساقطا فيمنعها من الرعي . ما جاء في الاستهانة وقلة الاحتفال يقولون : علي غريبتها تحدي الابل ، يريدون به تهاون الانسان بمال غيره . والمثل الساءر : احق الخيل بالركض المعار . ومن امثالهم : عثيثة تقرض جلدا املسا ، قاله الاحنف لحارثة بن  بدر الغداني وعابه عند زياد ، وذلك انه طلب الي علي عليه السلام ان يدخله في الحكومة ، فلما بلغه عيب حارثة اياه قال الاحنف ذلك . وهو مثل يضرب عند احتقار الرجل واحتقار كلامه . ويقولون : من باع بعرضه فقد انفق ، اي من اهان عرضه للشتم وجده حاضرا . ومن امثالهم : احمل العبد علي الفرس فان هلك هلك وان ملك ملك . تري من لا حريم له يهون . ومما يشبه ذلك ويضرب في من يفعل امرا عظيما ولا يحتفل به ويظن انه لم يصنع شيءا ، ما حكاه يونس عن العرب : ان غلاما اخذ بعيرا فشق نصفه ثم اخرج مصيره وجعل يطويه فمر به قوم فقالوا : مه يا غلام ؟ فقال : اني لا اضيره وانما اطوي مصيره . ومن امثالهم : اهون هالك عجوز في عام سنة . ويقال : خله درج الضب ، اي يذهب حيث يشاء . ويقولون : اجع كلبك يتبعك .  وقال البريق الهذلي : من الطويل وكنت اذا الايام احدثن هالكا . . . اقول شوي ما لم تصب بصميم تصب من صاب اي قصد . وقال الفرزدق في الاستهانة : من الكامل ما ضر تغلب واءل اهجوتها . . . او بلت حيث تناطح البحران وقال اخر : من الرمل ما يضر البحر اضحي زاخرا . . . ان رمي فيه غلام بحجر وقال اخر : من الطويل ورب امور لا تضيرك ضيرة . . . وللقلب من مخشاتهن وجيب وقال اخر : من الطويل انا النار في احجارها مستكنة . . . فان كنت ممن يقدح النار فاقدح انا الليث وابن الليث في حومة الوغي . . . فان كنت ممن ينبح الليث فانبح وقال ابن الرومي : من البسيط لينبح الكلب ضوء البدر ما نبحا وقال الاخطل : من الطويل  عتبتم علينا ال غيلان كلكم . . . واي عدو لم نبته علي عتب وقال اخر : من الطويل اهينوا مطاياكم فاني رايته . . . يهون علي البرذون موت الفتي الندب وقال اخر : من البسيط لا يجفل البرد من يبلي حواشيه . . . ولا يبالي علي من راحت الابل وقال اخر : من الطويل الا لا يبالي البرد من جر فضله . . . كما لا تبالي مهرة من يقودها المشاركة في الرخاء والخذلان في الشدة من امثالهم في ذلك : يربض حجرة ويرتعي وسطا . ومثله : من الوافر موالينا اذا افتقروا الينا . . . وان اثروا فليس لنا موالي وقريب منه : من البسيط لا اعرفنك بعد الموت تندبني . . . وفي حياتي ما زودتني زادي  ويقولون : من فاز بفلان فاز بالسهم الاخيب ، لمن يخذل في وقت الحاجة ، وقاله علي عليه السلام فيما كان يستبطء به اصحابه . ما جاء في الرخاء والسعة يقولون في ذلك : هم في شء لا يطير غرابه . ومن شعر النابغة : ليس غرابها بمطار . واصله ان الغراب اذا وقع في موضعه منه لم يحتج ان يتحول الي غيره . وقد يضرب هذا المثل في الشدة ايضا . ويقرب منه قوله : وجد ثمرة الغراب ، انما ينتقي من الثمر اطيبه واجوده . ويقولون : هم في مثل حدقة البعير ، يريدون الخصب والعشب . جاء بالضح والريح . الضح الشمس . وجاء بالطم والرم ، يريدون الكثرة . ومن امثالهم : ان اضاخا منهل مورود .  ومنها : يوم توافي شاوه وانعمه ، لمن يملك امره ويكثر جمعه . ومنها : تتابعي بقر ، خبر ذلك ان بشر بن ابي خازم خرج سنة اسنت فيها قومه فمر بصوار من البقر واجل من الاروي فذعرت منه فركبت جبلا وعرا ليس له منفذ ، فلما نظر اليها قام علي شعب من الجبل واخرج قوسه وجعل يشير اليها كانه يرميها ، فتلقي انفسها فتكسر ، وجعل يقول : من الرجز انت الذي تصنع ما لم يصنع . . . انت حططت من ذرا مقنع كل شبوب لهق مقنع ويقول : تتابعي بقر ، فخرج الي قومه فدعاهم اليها فاصابوا من اللحم ما شاءوا وانعشوا . ومن امثالهم في السعة لمن يفسد في المال ويضيعه : ليس عليك نسجه فاسحب وجر . وقعت في مرتعة فعيثي . عبد وحلي في يديه . عبد ملك عبدا .  ارعي فزارة لا هناك المرتع . عيثي جعار خلا لك الجو فبيضي واصفري . وتمثل بذلك عبد الله بن العباس لما خلت مكة لعبد الله بن الزبير وسار الحسين بن علي عليهما السلام الي العراق . ومن امثالهم في نحو ذلك : كل ذات ذيل تختال . من يطل ذيله ينتطق به . المعجب بخاصة نفسه من امثالهم في ذلك : كل مجر بالخلاء يسر . زين في عين والد ولده . كل فتاة بابيها معجبة ، يروي هذا المثل للاغلب العجلي في شعر له ، وقيل هو للعجفاء بنت علقمة ، وقيل هو لكاهنة منهم تنافر اليها نسوان كل  واحدة منهن تذكر مجد ابيها وتفخر به . وانشد الرياشي : من المنسرح زينه الله بالفخار كما . . . زين في عين والد ولده وقال ابو تمام : من الكامل ويسء بالاحسان ظنا لا كمن . . . هو ابانه وبشعره مفتون الساعي لنفسه وفي خلاصه من امثالهم في هذا : سمنكم هريق في اديمكم ؛ لمن ينفق علي نفسه ويمنع الناس . كل امرء قي شانه ساع . كل جان يده الي فيه . اصل المثل ان جذيمة الابرش نزل منزلا وامر الناس ان يجنوا الكماة ، فكان بعضهم اذا وجد شيءا يعجبه اثر به نفسه ، وكان عمرو ابن عدي ياتيه بخير ما يجده فعندها قال عمرو بن عدي : من الرجز هذا جناي وخياره فيه . . . وكل جان يده الي فيه وتمثل بذلك علي عليه السلام لما جنيت اليه العراق ، فنظر الي فتنتها وذهبها : يا حمراء يا بيضاء : احمري وابيضي ، غري غيري .  هذا جناي وخياره فيه . . . وكل جان يده الي فيه وقال اكثم بن صيفي : من ضعف عن كسبه اتكل علي زاد غيره . ويقولون في الرضا بما في اليد والاياس مما في يد الغير : ملء عينيك وشء غيرك . اليسير يجني الكثير من امثالهم : الشر تبدوه صغاره . قال مسكين الدارمي : من الكامل المجزوء ولقد رايت الشر بي . . . ن الحي تبدوه صغاره ولو انهم ياسونه . . . لتنهنهت عنهم كباره ومنها : ان دواء الشق ان تحوصه ، واصل الحوص الخياطة ، يعني قبل تفاقمه . وقال طرفة بن العبد : من الكامل قد يبعث الامر الكبير صغيره . . . حتي تظل له الدماء تصبب وقال يزيد بن الحكم : من الكامل المجزوء  اعلم بني فانه . . . بالعلم ينتفع الحكيم ان الامور دقيقها . . . مما يهيج له العظيم وقال انس بن مساحق العبدي : من المتقارب بان الدقيق يهيج الجليل . . . وان العزيز اذا شاء ذل وقال عقيل بن هاشم القيني : من البسيط فبينما المرء تزجيه اصاغره . . . اذ شمرت فحمة شهباء تستعر تعيي علي من يداويها مكايدها . . . عمياء ليس لها سمع ولا بصر ويقارب هذه المعاني قول ابن نباتة : من المتقارب فلا تحقرن عدوا رماك . . . وان كان في ساعديه قصر فان الحسام يجز الرقاب . . . ويعجز عما تنال الابر ومن كلام العرب يقولون : الحرب اولها كلام . ويقال : صغارها شرارها ، اي اصغرهن اكثرهن شرا . ومن امثالهم : ان الخصاص يري في جوفه الرقم ، اي ان الشء الحقير الصغير يري فيه العظيم ، والخصاصة الفرجة بين الشيءين والرقم الداهية .  ما جاء في الشدة والداهية قولهم : جاوز الماء الزبي . وبلغ الحزام الطبيين . جرحه حيث لا يضع الراقي انفه ، اي لا دواء له . ومثله : غادر وهيا لا يرقع ، اي فتق فتقا لا يقدر علي رتقه . ويقال : جاء فلان وقد لفظ لجامه ، اذا جاء مجهودا . ومثله : جاء وقد قرض لنا رباطه . ويقال في الشدة : جاء بعد اللتيا والتي . ولقيت منه عرق القربة . المنايا علي الحوايا ، والحوايا ها هنا مراكب ، واحدتها حوية ، كل ذلك في الشدة .  ويقولون في مثله : راي فلان الكواكب مظهرا ، معناه اظلم عليه يومه حتي راي الكواكب عند الظهر . ويقولون : قد اخذ منه بالمخنق . ويقولون : لقي منه الامرين ، والفتكرين ، والبرحين . ولقيت منه بنات برح . ويقولون : تركته علي مثل ليلة الصدر ، يعنون نفر الناس وصدرهم من حجهم ، يضرب في الاصطلام . ومثله : تركته علي مثل مشفر الاسد . وتركته علي مثل مقلع الصمغة . وتركته علي انقي من اراحة . ويقولون : صبرا وان كان قترا ، والقتر شدة الزمان . وصبرا وان كان جمرا . ومنه : اساف حتي ما يشتكي السواف ، يعني انه اعتاده ، والاسافة ذهاب المال واجتياحه .  ويقولون : ما له ثاغية ولا راغية . ويقولون للرجل اذا كان داهية : صل اصلال ؛ وهتر اهتار . وهو حول قلب . وهو عضلة من العضل . وداهية الغبر ؛ وصماء الغبر . ويقولون في الدواهي : قد بدت جنادعه . وقع في ام جندب . وقع في هياط ومياط وهو الصخب والضجر . و وقع في الدهيم ، واصله ان اخوة قتلوا فحملوا علي ناقة يقال لها الدهيم ، فصارت مثلا . ويقولون : اتتكم الدهيم ترمي بالنشف والتي بعدها ترمي بالرضف . وجاء بالداهية الدهياء ، والزباء والشعراء . وجاء بالعنقفير .  وجاء باحدي بنات طبق ، واصلها من الحيات . ويقولون : صمي صمام . وصمي ابنة الجبل . ويسمون الدواهي الماود واحدتها موءدة . في الدعاء يقولون في الدعاء : هوت امه . وهبلت امه ، ويريدون بذلك المديح ، وكانه اخرج مخرج التفجع . قال اعشي باهلة : من الطويل الا هبلت ام الذين غدوا به . . . الي القبر ماذا يحملون الي القبر ويقولون في الدعاء له : نعم عوفك ، اي نعم بالك . ويقولون في الدعاء عليه : لا نعم عوفك . لا قبل الله منه صرفا ولا عدلا ، فالعدل الفرض والصرف التطوع . ويقولون : رماه الله بالطلاطلة والحمي المماطلة ، الطلاطلة سقوط اللهاة ، ويقال : الذبحة .  ويقولون في الشماتة : لليدين وللفم ، والمثل لعاءشة رضي الله عنها . و للمنخرين ، اي اكبه الله علي منخريه ، والمثل لعمر بن الخطاب رضي الله عنه ، قاله لرجل اتي به سكران في شهر رمضان . ويقال : بجنبيه الوجبة ، يعني الصرعة . و من كلا جانبيك لا لبيك . به لا بظبي . لا لعا لفلان . وقولهم : بفيه الحجر . وبفيه الاثلب والكثكث . تم الباب بحمد الله ومنه والحمد لله وحده ، ويتلوه ان شاء الله تعالي الباب الثالث والثلاثون في الحجج البالغة والاجوبة الدامغة . 
  الباب الثالث والثلاثون في الحجج البالغة والاجوبة الدامغة .
  فارغة  بسم الله الرحمن الرحيم وبه الثقة والعون الحمد لله الملك الديان ، المفضل المنان ، خالق الانسان ، ومفضله بالبيان ، ومءتيه الحكمة وفصل الخطاب ، موفق بديهته لصواب الجواب ، ومسدده للقراع والنضال ، ومءيده عند الخصام والجدال ، له النعم السابغة ، والايات الصادعة ، والمعجزات الرادعة ، والكلمة العليا القاطعة ، والبطشة الكبري الوازعة ، وصلواته علي نبيه وصفيه ، محمد عبده ونبيه ، الذي اظهر حجته ، واوضح محجته ، واتاه جوامع الكلم ، وخصه باكرم الاخلاق والشيم ، وعلي اله مصابيح الظلم ، ودراري البهم . 
  الباب الثالث والثلاثون في الحجج البالغة والاجوبة الدامعة
  في الكتاب العزيز من الحجج البالغة ما يكون غاية لمن تمثل به ، وكيف لا يكون ذلك وهو برهان الشريعة ودليلها ، ومحجة الهداية وسبيلها ، فمن ذلك قوله تعالي : وضرب لنا مثلا ونسي خلقه قال من يحيي العظام وهي رميم ، قل يحييها الذي انشاها اول مرة يس :  وقال تعالي : ايحسب الانسان ان يترك سدي ، الم يك نطفة من مني يمني ، ثم كان علقة فخلق فسوي ، فجعل منه الزوجين الذكر والانثي ، اليس ذلك بقادر علي ان يحيي الموتي القيامة :    وقوله عز وجل : وهو الذي يبدا الخلق ثم يعيده وهو اهون عليه الروم :  اي في تقرير عقولكم وقياس ظنونكم الماخوذين من معارفكم . وقوله عز وجل حكاية عن ابراهيم عليه السلام : وكيف اخاف ما اشركتم ولا تخافون انكم اشركتم بالله ما لم ينزل به عليكم سلطانا ، فاي الفريقين احق بالامن ان كنتم تعلمون الانعام :  . ومن ايات الحجاج القاطع في اقامة التوحيد وتوهين الشرك قوله سبحانه : قل لو كان معه الهة كما يقولون اذن لابتغوا الي ذي العرش سبيلا الاسراء :  وقوله تعالي : ما اتخذ الله من ولد وما كان معه من اله اذن لذهب كل اله بما خلق ولعلا بعضهم علي بعض سبحان الله عما يصفون المءمنون :  وقوله تعالي في تفرده بخلق البرية : ان الذين تدعون من دون الله لن يخلقوا  ذبابا ولو اجتمعوا له وان يسلبهم الذباب شيءا لا يستنقذوه منه ضعف الطالب والمطلوب . ما قدروا الله حق قدره ، ان الله لقوي عزيز الحج :    ومن الحجة في امر كتابه : وان كنتم في ريب مما نزلنا علي عبدنا فاتوا بسورة من مثله البقرة :  وقال في الدلالة علي اثبات نبوة رسوله صلي الله عليه وسلم وعلي اله وسلم بتامل احواله وتدبر ما جاء به : افلم يدبروا القول ام جاءهم ما لم يات اباءهم الاولين ، ام لم يعرفوا رسولهم فهم له منكرون المءمنون :    فانه كان صلي الله عليه وعلي اله وسلم يعرف في قريش قبل البعثة بالصادق والامين . وقوله تعالي : قل لو شاء الله ما تلوته عليكم ولا ادراكم به فقد لبثت فيكم عمرا من قبله افلا تعقلون يونس :  . ولما بعث رسول الله صلي الله عليه وسلم قام فقال : يا معشر قريش ، لو قلت لكم ان خيلا تطلع عليكم من هذا الجبل اكنتم مصدقي ؟ قالوا : نعم قال : فاني نذير لكم بين يدي عذاب شديد . فلما اقروا بصدقه خاطبهم بالانذار ودعاهم الي الاسلام . والان نذكر ما تحاور به الناس فيما بينهم ، وتحاجوا به بعضهم علي بعض في خطابهم ومقاصدهم .  قال عثمان بن عفان رضي الله عنه لعامر بن عبد قيس العنبري وراه ظاهر الاعرابية : يا اعرابي اين ربك ؟ قال : بالمرصاد .  استعمل عتبة بن ابي سفيان رجلا من اله علي الطاءف ، فظلم رجلا من ازد شنوءة ، فاتي الازدي عتبة فمثل بين يديه فقال : من البسيط .  امرت من كان مظلوما لياتيكم . . . فقد اتاكم غريب الدار مظلوم  ثم ذكر ظلامته فقال عتبة : اني اراك اعرابيا جافيا . والله ما احسبك تدري كم تصلي في كل يوم وليلة . فقال : ارايتك ان انباتك ذاك اتجعل لي عليك مسالة ؟   قال : نعم ، فقال الاعرابي : من الرجز  ان الصلاة اربع واربع . . . ثم ثلاث بعدهن اربع ثم صلاة الفجر لا تضيع  قال : صدقت ، فسل ، قال الاعرابي : كم فقار ظهرك ؟ قال : لا ادري ، قال الاعرابي : افتحكم بين الناس وانت تجهل هذا من نفسك ؟ قال : ردوا عليه ظلامته .  لما انتهي الي علي عليه السلام يوم السقيفة ان الانصار قالت : منا امير ومنكم امير ، قال عليه السلام : فهلا احتججتم عليهم بان رسول الله صلي الله عليه وسلم وصي بان نحسن الي محسنهم ونتجاوز عن مسيءهم . قالوا : وما في هذا من الحجة عليهم ؟ قال : لو كانت الامارة فيهم لم تكن الوصية بهم .  ومما ينظر الي هذا المعني وان كان مخرجه مخرج علو الهمة وارتفاعها قول عمرو بن سعيد بن العاص المعروف بالاشدق ، وقد دخل بعد موت ابيه علي معاوية بن ابي سفيان فقال له معاوية : الي من اوصي بك ابوك ؟ قال : ان ابي اوصي الي ولم يوص بي .  وفي يوم السقيفة ايضا قال الحباب بن المنذر : انا جذيلها المحكك وعذيقها المرجب ، ان شءتم كررناها جذعة ، منا امير ومنكم امير ، فان عمل المهاجري شيءا في الانصار رده عليه الانصاري ، وان عمل الانصاري شيءا في المهاجرين رده عليه المهاجري ، فاراد عمر الكلام فقال ابو بكر رضي الله عنه : علي رسلك ، نحن المهاجرون اول الناس اسلاما ، واوسطهم دارا ، واكرم الناس  حسبا واحسنهم وجوها ، واكثر الناس ولادة في العرب ، وامسهم رحما بالرسول صلي الله عليه وسلم ، اسلمنا قبلكم وقدمنا في القران عليكم ، فانتم اخواننا في الدين وشركاءنا في الفء ، وانصارنا علي العدو ؛ اويتم واسيتم ، فجزاكم الله خيرا ؛ نحن الامراء وانتم الوزراء ؛ لا تدين العرب الا لهذا الحي من قريش ، وانتم محقوقون ان لا تنفسوا علي اخوانكم من المهاجرين ما ساق الله اليهم . قالوا : فانا قد رضينا وسلمنا .  وقال عيسي بن يزيد : قال ابو بكر رضي الله عنه : نحن اهل الله واقرب الناس بيتا من بيت الله ، وامسهم رحما برسول الله ؛ ان هذا الامر ان تطاولت له الخزرج لم تقصر عنه الاوس ، وان تطاولت له الاوس لم تقصر عنه الخزرج ، وقد كان بين الحيين قتلي لا تنسي ، وجراح لا تداوي ، فان نعق منكم ناعق فقد جلس بين لحيي اسد : يضغمه المهاجري ويخرجه الانصاري . قال ابن داب : فرماهم والله بالمسكتة .  قال رجل للربيع بن خثيم وقد صلي ليلة حتي اصبح : اتعبت نفسك فقال : راحتها اطلب ، ان افره العبيد اكيسهم .  وهذا قول حق في مقام صدق ، اخذه روح بن حاتم بن قبيصة ابن المهلب في مقام الباطل ، ونظر اليه رجل واقفا بباب المنصور في الشمس فقال له : قد طال وقوفك في الشمس ، قال روح : ليطول وقوفي في الظل .  رءي عبيد الله بن الحسن القاضي علي باب جعفر بن سليمان ، والشمس تنقله من ظل الي ظل ، فقيل له : امثلك في علمك ومكانك يقف هذا   الموقف ؟ فقال : من الطويل  اهين لهم نفسي لاكرمها بهم . . . ولا يكرم النفس الذي لا يهينها  وكان هذه المعاني تنظر الي قول الاعشي : من الطويل  تقول سليمي لو اقمت لسرنا . . . ولم تدر اتي للمقام اطوف  وقول عنترة : من الكامل  ولقد ابيت علي الطوي واظله . . . حتي انال به كريم الماكل  قال عمر بن الخطاب رضي الله عنه لابي مريم السلولي : والله لا احبك حتي تحب الارض الدم ، قا : افتمنعني حقا ؟ قال : لا ، قال : لا باس . انما ياسي علي الحب النساء .  دخل يزيد بن ابي مسلم علي سليمان بن عبد الملك ، وكان قبيحا ، فلما راه سليمان ، قال : قبح الله رجلا اجرك رسنه واشركك في امانته ، فقال له يزيد : يا امير المءمنين ، رايتني والامر عني مدبر ، ولو رايتني وهو علي مقبل لاستكبرت مني ما استصغرت ، واستعظمت مني ما استحقرت ، فقال : اتري الحجاج استقر في قعر جهنم بعد ؟ قال : يا امير المءمنين ، لا تقل ذلك في الحجاج ، فان الحجاج وطا لكم المنابر ، وذلل لكم الجبابرة ، وهو ياتي يوم القيامة عن يمين ابيك وعن يسار اخيك ، فحيث كانا كان .  ارسل اهل البصرة رجلا يقال له كليب الجرمي الي علي بن ابي  طالب عليه السلام لما قرب منها ليعلم لهم حقيقة حاله ورايه في اهل الجمل ، فبين له من امرهم ما علم انه علي الحق ، ثم قال له : تبايع ؟ قال : اني رسول قوم ، ولا احدث حدثا حتي ارجع اليهم ، فقال له : ارايت لو ان الذين وراءك بعثوك راءدا لهم تبتغي مساقط الغيث فرجعت اليهم فاخبرهم عن الكلا والماء ، فخالفوا الي المعاطش والمجادب ، ما كنت صانعا ؟ قال : كنت تاركهم ومخالفهم الي الكلا والماء ، فقال له : فامدد اذن يدك ، فقال الجرمي : فوالله ما استطعت ان امتنع عند قيام الحجة علي ، فبايعته .  قال بعض اليهود لعلي عليه السلام : ما دفنتم نبيكم حتي اختلفتم ، فقال له : انما اختلفنا عنه لا فيه ، ولكنكم ما جفت ارجلكم من البحر حتي قلتم لنبيكم : ^ ( اجعل لنا الها كما لهم الهة ، قال انكم قوم تجهلون ) ^ الاعراف :   قال معاوية لابي الاسود : بلغني ان عليا اراد ان يدخلك في الحكومة ، فعزمت عليك اي شء كنت تصنع ؟ قال : كنت اتي المدينة فاجمع الفا من المهاجرين والفا من الانصار ، فان لم اجدهم تممتهم من ابناءهم ، ثم استحلفهم بالله العظيم : المهاجرون احق ام الطلقاء ؟ فتبسم معاوية وقال : اذن والله ما كان اختلف عليك اثنان .  كتب عليك عليه السلام الي معاوية جوابا عن كتاب منه : واما طلبك الشام فاني لم اكن لاعطيك اليوم شيءا منعتكه امس ، واما قولك : ان الحرب قد اكلت العرب الا حشاشات انفس بقيت : الا ومن اكله الحق فالي  النار ، واما استواءنا في الحرب والرجال : فلست بامضي علي الشك مني علي اليقين ، وليس اهل الشام باحرص علي الدنيا من اهل العراق علي الاخرة ، واما قولك انا بنو عبد مناف : فكذلك نحن ، ولكن ليس امية كهاشم ، ولا حرب  كعبد المطلب ، ولا ابو سفيان كابي طالب ، ولا المهاجر كالطليق ، ولا الصريح كاللصيق ، ولا المحق كالمبطل ، ولا المءمن كالمدغل ، ولبءس الخلف خلف يتبع سلفا هوي في نار جهنم ، وفي ايدينا بعد فضل النبوة التي اذللنا بها العزيز ، ونعشنا بها الذليل . ولما ادخل الله العرب في دينه افواجا ، واسلمت له هذه الامة طوعا وكرها ، كنتم ممن دخل في الدين اما رغبة واما رهبة ، علي حين فاز اهل السبق بسبقهم ، وذهب المهاجرون الاولون بفضلهم ، فلا تجعلن للشيطان فيك نصيبا وعليك سبيلا .  وكتب اليه ايضا ، وهو من محاسن الكتب ، اخذ عليه فيه بالحجة ورماه بالمسكتة : اما بعد فقد اتاني كتابك تذكر فيه اصطفاء الله تعالي محمدا صلي الله عليه وسلم لدينه ، وتاييده اياه بمن ايده الله به من اصحابه ، فلقد خبا لنا الدهر منك عجبا اذ طفقت تخبرنا بالاء الله عندنا ونعمه علينا في نبينا ، فكنت في ذلك كناقل التمر الي هجر ، او داعي مسددة الي النضال . وزعمت ان افضل الناس في الاسلام فلان وفلان ، فذكرت امرا ان تم اعتزلك كله ، وان نقص لم يلحقك ثلمه ، وما انت والفاضل والمفضول ، والساءس والمسوس ، وما للطلقاء وابناء الطلقاء والتمييز بين المهاجرين الاولين وترتيب درجاتهم ، وتعريف طبقاتهم ؟ هيهات لقد حن قدح ليس منها ، وطفق يحكم فيها من عليه الحكم لها . الا تربع علي ظلعك ، وتعرف قصور ذرعك ، وتتاخر حيث اخرك القدر ؟ ! فما عليك غلبة المغلوب ، ولا لك ظفر الظافر ، وانك   لذهاب في التيه ، رواغ عن القصد . الا تري غير مخبر لك ، لكن بنعمة الله احدث : ان قوما استشهدوا في سبيل الله من المهاجرين ، ولكن فضل ، حتي اذا استشهد شهيدنا قيل سيد الشهداء ، وخصه رسول الله صلي الله عليه وسلم بسبعين تكبيرة حين صلي عليه ؟ اولا تري ان قوما قطعت ايديهم في سبيل الله ، ولكل فضل ، حتي اذا فعل بواحد منا كما فعل بواحدهم قيل : الطيار في الجنة وذو الجناحين ؟ ولولا ما نهي الله عز وجل عن تزكية المرء نفسه لذكر ذاكر فضاءل جمة تعرفها قلوب المءمنين ولا تمجها اذان السامعين . فدع عنك من مالت به الريبة فانا صناءع ربنا ، والناس بعد صناءع لنا ، لم يمنعنا قديم عزنا وعادي طولنا علي قومنا ان خلطناهم بانفسنا فنكحنا وانكحنا ، فعل الاكفاء ، ولستم هناك ، واني يكون ذلك كذلك ومنا النبي ومنكم المكذب ، ومنا اسد الله ومنكم اسد الاحلاف ، ومنا سيدا شباب اهل الجنة ومنكم صبية النار ، ومنا خير نساء العالمين ومنكم حمالة الحطب ، في كثير مما لنا وعليكم ؟ فاسلامنا ما قد سمع ، وجاهليتنا لا تدفع ، وكتاب الله يجمع لنا ما شذ عنا ، وقوله سبحانه : ^ ( واولو الارحام بعضهم اولي ببعض في كتاب الله ) ^ ( الانفال :  ) وقوله تعالي : ^ ( ان اولي الناس بابراهيم للذين اتبعوه وهذا النبي والذين امنوا والله ولي المءمنين ) ^ ( ال عمران :  ) فنحن مرة اولي بالقرابة ، وتارة اولي بالطاعة . ولما احتج المهاجرون علي الانصار يوم السقيفة برسول الله صلي الله عليه وسلم فلجوا عليهم ، فان يكن الفلج به فالحق لنا دونكم ، وان يكن بغيره فالانصار علي دعواهم .  وزعمت اني لكل الخلفاء حسدت وعلي كلهم بغيت : فان يكن ذلك كذلك فليس الجناية عليك فيكون العذر اليك ، وتلك شكاة ظاهر عنك عارها .   وقلت : اني كنت اقاد كما يقاد الجمل المخشوش حتي ابايع ، ولعمر الله ، لقد اردت ان تذم فمدحت ، وان تفضح فافتضحت ، وما علي المسلم من غضاضة في ان يكون مظلوما ما لم يكن شاكا في دينه ، ولا مرتابا بيقينه ، وهذه حجتي الي غيرك قصدها ، ولكني اطلقت لك منها بقدر ما سنح من ذكرها .  ثم ذكرت ما كان من امري وامر عثمان : ولك ان تجاب عن هذه لرحمه منك : فاينا كان اعدي له واهدي الي مقالته ؟ امن بذل له نصرته فاستقعده واستكفه ؟ ام من استنصره فتراخي عنه وبث المنون اليه ، حتي اتي قدره عليه ؟ كلا والله . لقد علم الله المعوقين منكم والقاءلين لاخوانهم هلم الينا ولا ياتون الباس الا قليلا ، وما كنت اعتذر من اني كنت انقم عليه احداثا ، فان كان الذنب اليه ارشادي وهدايتي له ، فرب ملوم لا ذنب له . وقد يستفيد الظنة المتنصح وما اردت الا الاصلاح ما استطعت ، وما توفيقي الا بالله عليه توكلت واليه انيب هود :  .  وذكرت انه ليس لي عندك ولاصحابي الا السيف : فلقد اضحكت بعد استعبار : متي الفيت بنو عبد المطلب عن الاعداء ناكبين ، وبالسيوف مخوفين ؟ فالبث قليلا يلحق الهيجا حمل ، فسيطلبك من تطلب ، ويقرب منك ما تستبعد ، وانا مرقل نحوك في جحفل من المهاجرين والانصار والتابعين لهم باحسان ، شديد زحامهم ، ساطع قتامهم ، متسربلين سرابيل الموت ، احب اللقاء اليهم لقاء ربهم ، قد صحبتهم ذرية بدرية ، وسيوف هاشمية ، قد عرفت مواقع نصالها في اخيك وخالك وجدك واهلك ، وما هي من الظالمين ببعيد . كان قبيصة بن جابر ممن كثر علي الوليد بن عقبة لما ولي الكوفة ، فقال معاوية يوما والوليد وقبيصة عنده : يا قبيصة ، ما كان شانك وشان الوليد ؟  قال : خير يا امير المءمنين في اول وصل الرحم واحسن الكلام ، فلا تسال عن شكر وحسن ثناء ، ثم غضب علي الناس وغضبوا عليه ، وكنا منهم ، فاما ظالمون فنستغفر الله ، واما مظلومين فيغفر الله له ، وخذ في غير هذا يا امير المءمنين فان الحديث ينسي القديم . قال : ولم ؟ فوالله لقد احسن السيرة وبسط الخير وكف الشر ، قال : فانت اقدر علي ذلك منه يا امير المءمنين ، فافعل ، قال : اسكت لا سكت . فسكت وسكت القوم ، ثم قال له معاوية : ما لك لا تتحدث ؟ قال : نهيتني عما احب فسكت عما اكره . قال معاوية للاحنف حين وبخه بتخذيله عن عاءشة ومشهده صفين : فعلت وفعلت . فقال : يا امير المءمنين لم ترد الامور علي اعقابها ؟ اما والله ان القلوب التي ابغضناك بها بين جوانحنا ، وان السيوف التي قاتلناك لها لعلي عواتقنا ، ولءن مددت يدا بشر من غدر لنمدن باعا من ختر ، وان شءت لتستصفين كدر قلوبنا بصفو حلمك ، قال : فاني بها افعل . روي ان عمر بن الخطاب رضي الله عنه قدم الي الشام ومعه عبد الرحمن بن عوف رحمه الله وهما علي حمارين قريبين من الارض ، فتلقاهما معاوية في كبكبة حسناء ، فثني وركه فنزل وسلم عليه بالخلافة فلم يرد عليه ، فقال له عبد الرحمن ابو عبيدة : يا امير المءمنين احصرت الفتي فلو كلمته ، فقال : انك لصاحب الجيش الذي اري ؟ قال : نعم ، قال : لانا في بلاد يكثر فيها جواسيس العدو ، فان نحن لم نتخذ العدة والعدد استخف بنا ، وهجم علي عوراتنا ، وانا  بعد  عاملك ، فان وقفتني وقفت ، وان استزدتني زدت ، وان استنقصتني نقصت ؛ قال : فوالله لءن كنت كاذبا انه لراي اريب ، وان كنت  صادقا انه لتدبير اديب ، ما سالتك عن شء قط الا تركتني منه في اضيق من رواجب الضرس ، لا امرك ولا انهاك . فلما انصرف قال ابو عبيدة او عبد الرحمن : لقد احسن الفتي في اصدار ما اوردت عليه ، قال : لحسن اصداره وايراده جشمناه ما جشمناه . روي ان عمر بن الخطاب رضي الله عنه كان يعس بالمدينة في الليل ، فسمع صوت رجل في بيته فارتاب بالحال ، فتسور فوجد رجلا عنده امراة وخمر ، فقال : يا عدو الله ، اكنت تري ان الله يسترك وانت تعصيه ؟ فقال لارجل : لا تعجل علي يا امير المءمنين ، ان كنت عصيت الله في واحدة فقد عصيته في ثلاث ، قال الله سبحانه وتعالي : ولا تجسسوا الحخجرات :  وقد تجسست ، وقال : واتوا البيوت من ابوابها البقرة :  ، وقد تسورت ، وقال : فاذا دخلتم بيوتا فسلموا النور :  وما سلمت . فقال عمر : فهل عندك من خير ان عفوت عنك ؟ قال : بلي والله يا امير المءمنين ، لءن عفوت عني لا اعود لمثلها ابدا ، فعفا عنه . خطب رجل الي عبد الله بن عباس يتيمة كانت في حجره ، فقال : لا ارضاها لك ، قال : ولم ؟ قال : لانها تشرف وتنظر ، وهي مع ذلك بذيءة ، قال : فاني لا اكره ذلك ، فقال ابن عباس : اما الان فاني لا ارضاك لها . قيل وقع بين علي وعثمان كلام فقال عثمان : ما اصنع بكم ان كانت قريش لا تحبكم وقد قتلتم منهم يوم بدر سبعين كان وجوههم شنوف  الذهب تشرب انفهم قبل شفاههم . قدم حماد بن جميل من فارس فنظر اليه يزيد بن المنجاب وعليه جبة وشي ، فقال : هل اتي علي الانسان حين من الدهر لم يكن شيءا مذكورا الانسان :  ، فقال حماد : كذكلك كنتم من قبل فمن الله عليكم النساء :  . دخل وفد علي عمر بن عبد العزيز فاراد فتي منهم الكلام ، فقال عمر : ليتكلم اسنكم ، فقال الفتي : يا امير المءمنين ، ان قريشا لتري فيها من هو اسن منك ، فقال : تكلم يا فتي . قال معاوية يوما : الارض لله وانا خليفته ، فما اخذت فلي حلال ، وما تركت للناس فلي عليهم فيه منة ، فقال صعصعة : ما انت واقصي الامة فيه الا سواء ، ولكن من ملك استاثر . فغضب معاوية وقال : لقد هممت ، قال صعصعة : ما كل من هم فعل ، قال : ومن يحول بيني وبين ذلك ؟ قال : الذي يحول بين المرء وقلبه . وجه معاوية رجلا الي ملك الروم ومعه كتاب تصديره : الي طاغية الروم ، فقال ملك الروم للرجل : ما لذي الفخر بالرسالة والمتسمي بخلافة النبوة والسفه ؟ اظنكم وليتم هذا الامر بعد اعواز ، لو شءت كتبت : من ملك الروم الي غاصب اهل بيت نبيه ، العامل بما يكفره عليه كتابه ، لكني اتجالل عن ذلك . روي ان عاءشة رضي الله عنها بعثت الي معاوية وهو بالمدينة تذكر حاجة من ال ابي بكر ، فارسل اليها بثلاثين الف درهم صلة لها وبمثلها لال  ابي بكر ، وبعث الي ام حبيبة اخته عشرين الف درهم ، فقالت : اتفضل علي وانا اختك ، وحقي ما تعلم ؟ فقال : اني اثرت هوي رسول الله صلي الله عليه وسلم واقتديت به فيكما ، فقالت : ان كنت صادقا فاعتزل ما انت فيه ، وخل بينه وبين من ادخلك في الاسلام ، فوالله لهوي رسول الله صلي الله عليه وسلم فيه كان فوق هواه فيك ، فقال معاوية : لله در الحق ما اقمعه . سمع زياد امراة تقول اللهم : اللهم اعزل عنا زيادا فقال : يا امة الله ، زيدي في دعاءك : وابدلنا به من هو خير لنا منه . قال الاصمعي : ناظر قوم من الخوارج الحسن البصري فقال : انتم اصحاب دنيا ، قالوا : وكيف ؟ قال : ايمنعكم السلطان من الصلاة ؟ قالوا : لا ، قال : افيمنعكم من الحج ؟ قالوا : لا ، حتي عدد وجوه البر ويقولون لا ، قال : فاراه انما منعكم الدرهم فقاتلتموه . قال حاطب بن ابي بلتعة : بعثني رسول الله صلي الله عليه وسلم الي المقوقس ملك الاسكنجرية ، فاتيته بكتاب النبي صلي الله عليه وسلم فابلغته رسالته ، فضحك ثم قال : كتب الي صاحبك يسالني ان اتبعه علي دينه ، فما يمنعه ان كان نبيا ان يدعو الله فيسلط علي البحر فيغرقني فيكفي مءونتي وياخذ ملكي ؟ قلت : فما منع عيسي عليه السلام اذ اخذته اليهود فربطوه في حبل وجعلوا عليه اكليلا من شوك ، وحملوا خشبته التي صلبوه عليها علي عنقه ، ثم اخرجوه وهو يبكي حتي نصبوه علي الخشبة ، ثم طعنوه حيا بحربة حتي مات  هذا علي زعمكم  فما منعه ان يدعو الله فيجيبه فيهلكهم ويكفي مءونتهم ،  ويظهر هو واصحابه عليهم ؟ وما منع يحيي بن زكريا حين سالت امراة الملك الملك ان يقتله ، فقتله وبعث براسه اليها حتي وضع بين يديها ، ان يسال الله ان ينجيه ويهلك الناس ؟ فاقبل علي جلساءه وقال : والله انه لحكيم ، وما يخرج الحكيم الا من عند الحكماء . قال خالد بن يزيد القرشي : كانت لي حاجة بالجزيرة فاتخذتها طريقا مستخفيا ، قال : فبينا انا اسير بين اظهرهم اذا انا بشمامسة ورهبان  وكان خالد رجلا لبيبا لسنا ذا راي  فقلت لهم : ما جمعكم ها هنا ؟ قالوا : ان لنا شيخا سياحا نلقاه كل عام في مكاننا هذا مرة فنعرض عليه ديننا وننتهي فيه الي رايه ، قال : وكنت رجلا معنيا بالحديث فقلت : لو دنوت من هذا فلعلي اسمع منه شيءا انتفع به ، قال : فدنوت منه ، فلما نظر الي قال لي : من انت ؟ اانت من هءلاء ؟ قلت : اجل ، قال : من امي احمد ؟ قلت : نعم ، قال : من علماءهم انت او من جهالهم ؟ قلت : لست من علماءهم ولا من جهالهم ، قال : الستم تزعمون في كتابكم ان اهل الجنة ياكلون ويشربون ولا يبولون ولا يتغوطون ؟ قال ، قلت : نعم نقول ذلك وهو كذلك ، قال : فان لهذا مثلا في الدنيا ، فما هو ؟ قلت مثل هذا الصبي في بطن امه ياتيه رزق الرحمن بكرة وعشية ولا يبول ولا يتغوط ، فتربد وجهه وقال لي : الم تزعم انك لست من علماءهم ؟ قلت : بلي ما انا من علماءهم ولا من جهالهم ، ثم قال : الستم تزعمون انكم تاكلون وتشربون ولا ينتقص مما في الجنة شء ؟ قال : نقول ذلك وهو كذلك ، قال : فان لهذا مثلا في الدنيا ، فما هو ؟ قلت : مثل هذا مثل رجل اعطاه الله علما وحكمة في الدنيا وعلمه كتابه ، فلو اجتمع من خلق الله فتعلموا منه ما نقص ذلك من علمه شيءا ، قال : فتربد وجهه وقال : الم تزعم انك لست من علماءهم ؟ قال ، قلت : اجل ما انا من علماءهم ولا من جهالهم ، فقال : الستم تقولون في  صلواتكم السلام علينا وعلي عباد الله الصالحين ؟ قال : قلت نعم ، قال : فلها عني ثم اقبل علي اصحابه وقال : ما بسط لاحد من الامم ما بسط لهءلاء من الخير ، ان احدهم اذا قال في صلواته السلام علينا وعلي عباد الله الصالحين ، لم يبق عبد صالح في السموات والارض الا كتب الله له به عشر حسنات ، ثم قال : الستم تستغفرون لانفسكم وللمءمنين والمءمنات ؟ قال ، قلت بلي ، فقال لاصحابه : ان احد هءلاء اذا استغفر للمءمنين والمءمنات لم يبق عبد لله مءمن في السموات والارض من الملاءكة والمءمنين ولا من كان علي عهد ادم او كاءن الي يوم القيامة الا كتب الله له به عشر حسنات ، ثم اقبل علي فقال لي : ان لهذا مثلا في الدنيا فما هو ؟ فقلت : كمثل رجل مر بملا كثيرا كانوا او قليلا ، فسلم عليهم فردوا عليه ، او دعا لهم فدعوا له ، قال : فتربد وجهه ثم قال : اتزعم انك لست من علماءهم ؟ قلت : اجل ما انا من علماءهم ولا من جهالهم ، فقال لي : ما رايت من امة محمد من هو اعلم منك ، سلني عما بدا لك ؟ فقلت : كيف اسال من يزعم ان لله ولدا ؟ قال : فشق عن مدرعته حتي ابدي بطنه ، ثم رفع يديه فقال : لا غفر الله لمن قالها ، منها فررنا واتخذنا الصوامع ، وقال : اني ساءلك عن شء فهل انت مخبري ؟ قال ، قلت : نعم ، قال : اخبرني هل بلغ ابن القرن فيكم ان يقوم اليه الناشء والطفل فيشتمه ويتعرض لضربه ولا يغير ذلك عليه ؟ قال ، قلت : نعم ، قال : ذلك حين رق دينكم ، واستحببتم دنياكم ، واثرها من اثرها منكم . فقال له رجل من القوم : ابن كم القرن ؟ قلت : اما انا فاقول ابن ستين سنة ، واما هو فقال ابن سبعين . فقال رجل من جلساءه : يا ابا هشام ما كان يسرنا ان احدا من هذه الامة لقيه غيرك . قال العتبي : وفد زياد علي معاوية فاتاه بهدايا واموال عظام وسفط مملوء جوهرا لم ير مثله ، فسر معاوية به سرورا شديدا ، فلما راي زياد ذلك صعد المنبر وقال : انا والله يا امير المءمنين اقمت صعر العراق ، وجبيت لك مالها ،  والفظت اليك بحرها . فقام اليه يزيد بن معاوية فقال : ان تفعل ذلك يا زياد فنحن نقلناك من ولاء ثقيف الي ولاء قريش ، ومن القلم الي المنابر ، ومن زياد بن عبيد الي حرب بن امية ، فقال معاوية : اجلس فداك ابي وامي . قال موسي بن عقبة : حج عبد الملك فلقيه رجل من ولد عمر بن الخطاب وقد نالته ولادة من ابي بكر رحمهما الله ، فساله فحرمه وقال متمثلا : من الطويل ومن لا يذد عن حوضه بسلاحه . . . يهدم ومن لا يظلم الناس يظلم فقال له رجل من القوم : اذا ذدت ابن الفاروق وابن الصديق فمن يرده ؟ قال : يرده عبد مناف . سال رجل رجلا حاجة فقال المسءول : اذهب بسلام ، سل الله تعالي ، فقال الساءل : قد انصفنا من ردنا الي الله . حج الرشيد فلقيه موسي بن جعفر علي بغلة ، فقال له الرشيد : مثلك في حسبك وشرفك وتقدمك يلقاني علي بغلة ؟ فقال : تطاطات عن خيلاء الخيل ، وارتفعت عن دناءة العير ، وخير الامور اوسطها . قدم معاوية المدينة فدخل دار عثمان ، فقالت عاءشة بنت عثمان : وا ابتاه وبكت . فقال معاوية : يا ابنة اخي ان الناس اعطونا طاعة واعطيناهم امانا ، واظهرنا لهم حلما تحته غضب ، واظهروا لنا طاعة تحتها حقد ، ومع كل  انسان سيفه ، وهو يري مكان انصاره ، فان نكثناهم نكثوا بنا ، ولا ندري اعلينا يكون ام لنا ، ولان تكوني بنت عم امير المءمنين خير من ان تكوني امراة من عرض المسلمين . دخل زفر بن الحارث علي عبد الملك بن مروان بعد الصلح فقال : ما بقي من حبك للضحاك ؟ قال : ما لا ينفعني ولا يضرك ، قال : شد ما احببتموه معاشر قيس ، قال : احببناه ولم نءاسه ولو اسيناه لقد كنا ادركنا ما فاتنا منه ، قال : فما منعكم من مواساته يوم المرج ؟ قال : ما منع اباك من مواساة عثمان يوم الدار . قال قريش بن انس : حضرنا جماعة عند عمرو بن عبيد فقال : يءتي بي يوم القيامة فيقام بي بين يدي الله عز وجل فيقول لي : اقلت اني لا اغفر للقاتل واني ادخله النار ؟ فاقول : انت قلت : ومن يقتل مءمنا متعمدا فجزاءه جهنم خالدا فيها النساء :  . فسكتت الجماعة ، فقلت له ، وما في البيت اصغر مني : ارايت ان قال لك قد قلت : ان الله لا يغفر ان يشرك به ويغفر ما دون ذلك لمن يشاء النساء :  ،  فمن اين علمت اني لا اشاء ان اغفر للقاتل ؟ فما رد علي شيءا . قال الحجاج لبعض الخوارج : اجمعت القران ؟ قال : او متفرقا كان فاجمعه ؟ قال : اتقرءه ظاهرا ؟ قال : بلي اقرءه وانا ابصره ، قال : فتحفظه ؟ قال : وهل اخشي فراره فاحفظه ؟ قال : ما تقول في امير المءمنين عبد الملك ؟ قال : لعنه الله ولعنك معه ، قال : انك مقتول فكيف تلقي الله ؟ قال : القاه بعملي وتلقاه بدمي .  دنا سقاء من فقيه علي باب سلطان فساله عن مسالة ، فقال له : اهذا موضع المسالة ؟ فقال له السقاء : او هذا موضع الفقه ؟ كان الحسن يقول : لا توبة لقاتل مءمن متعمدا . فدس اليه عمرو بن عبيد رجلا وقال قل له : انه من ان يكون مءمنا او كافرا او منافقا او فاسقا . فان كان مءمنا فان الله تعالي يقول : يا ايها الذين امنوا توبوا الي الله توبة نصوحا التحريم :  ، وان كان كافرا فانه يقول : قل للذين كفروا ان ينتهوا يغفر لهم ما قد سلف الانفال :  ، وان كان منافقا فانه يقول : ان المنافقين في الدرك الاسفل من النار ولن تجد لهم نصيرا الا الذين تابوا النساء :    ، وان كان فاسقا فانه يقول : اولءك هم الفاسقون الا الذين تابوا النور :    . فقال الحسن للرجل : من اين لك هذا ؟ قال : شء اختلج في صدري ، قال : اصدقني . فقال الرجل : عمرو بن عبيد ، فقال الحسن : عمرو بن عبيد ، وما عمرو ؟ اذا قام بامر قعد به ، واذا قعد بامر قام به . لما اخذ عمر بن الخطاب في التوجه الي الشام قال له رجل : اتدع مسجد رسول الله صلي الله عليه وسلم ؟ قال : ادع مسجد رسول الله صلي الله عليه وسلم لصلاح امة رسول الله صلي الله عليه وسلم ولقد هممت ان اضرب راسك بالدرة حتي لا تجعل الرد علي الاءمة عادة فيتخذها الاجلاف سنة . ولما اخذ سابور ماني الزنديق قال له نصحاءه : اقتله ، قال : ان قتلته من غير ان اغلبه بالحجة قال عامة الناس بقوله ، ويقولون ملك جبار قتل زاهدا ،  ولكني احاجه فان غلبته بالحجة حينءذ قتلته ، ففعل ، ثم حشا جلده تبنا وصلبه . قال الحجاج بن يوسف ليحيي بن سعيد بن العاص : بلغني انك تشبه ابليس في قبح وجهك ؛ قال : وما ينكر الامير ان يكون سيد الانس يشبه سيد الجن ؟ . قال اياس بن معاوية : كنت اختلف وانا غلام الي رجل من اليهود اتعلم منه الحساب ، فسمعته يوما يقول : الا تعجبون من المسلمين ، يزعمون ان اهل الجنة ياكلون ويشربون ولا يبولون ولا يتغوطون ؟ قال اياس : فقلت يا معلم الست تزعم ان الدنيا مراة الاخرة ؟ قال : نعم ، قلت : فاخبرني عما ياكله ابن ادم ايصير كله ثفلا ؟ قال : لا ولكن بعضه ثفل وبعضه غذاء ؛ قال ، قلت : فما انكرت ان يكون بعضه في الدنيا غذاء ويصير كله في الاخرة غذاء ، فقال لي : قاتلك الله من غلام ما افهمك . قال المتتصر لابي العيناء : ما احسن الجواب ؟ قال : ما اسكت المبطل وحير المحق . وقال المسور بن مخرمة : دخلت علي معاوية ، فقال : ما فعل طعنك علي الاءمة يا مسور ؟ فاستعفيته فاقسم علي ؛ فوالله ما تركت عيبا الا ذكرته . فقال : لا تبرا من ذنب ، فهل لك يا مسور ذنوب تخافها ان تهلك بها ان لم يغفرها الله لك ؟ قلت : نعم ؛ قال : فما جعلك احق ان ترجو المغفرة مني ؟ فكان المسور اذا ذكره استغفر له وقال خصمني . خطب معاوية ذات يوم فقال : ان الله يقول : وان من شء الا  عندنا خزاءنه وما ننزله الا بقدر معلوم الحجر :  ، فما نلام نحن ؟ فقام اليه الاحنف بن قيس فقال له : يا معاوية ، انا والله ما نلومك علي ما في خزاءن الله ، وانما نلومك علي ما انزل الله علينا من خزاءنه فاغلقت بابك دونه . خطب المنصور بمكة ، وقد امل الناس عطاءه ، فقال : يا ايها الناس انما انا سلطان الله في ارضه ، اسوسكم بتوفيقه وتسديده ، وخازنه علي فيءه ، اعمل فيه بمشيءته ، واقسمه بارادته ؛ وقد جعلني الله تعالي قفلا عليه ، اذا شاء ان يفتحني فتحني ، واذا شاء ان يقفلني اقفلني . فارغبوا الي الله ايها الناس في هذا اليوم الذي عرفكم من فضله ما انزله في كتابه ، فقال عز وجل : اليوم اكملت لكم دينكم واتممت عليكم نعمتي ورضيت لكم الاسلام دينا الماءدة :  ، ان يوفقني للصواب ، ويسددني للرشاد ، ويلهمني الرافة بكم والاحسان اليكم ، ويفتحني لاعطياتكم وقسم ارزاقكم فيكم ، انه قريب مجيب . فقال له ابن عياش المنتوف : احال امير المءمنين بالمنع علي ربه تعالي . قال صالح بن علي بن عبد الله بن عباس لابنه عبد الملك وقد غضب عليه : يا ابن الفاعلة ؛ فقال عبد الملك : الزانية لا ينكحها الا زان او مشرك النور :  ، وانشد : من الطويل عن المرء لا تسال وسل عن قرينه . . . فان الفريقين بالمقارن مقتد فلم يكلمه صالح حتي مات . وكانت ام عبد الملك بن صالح جارية لمروان بن محمد ، فلما قتله صالح بمصر ، اتخذ ام عبد الملك لنفسه . فلما سعي قمامة كاتب عبد الملك به  الي الرشيد واعتزم علي حبسه كلمه واغلظ له ، فقال الرشيد : ما انت منا ؛ فقال : والله ما ابالي لاي الفحلين كنت ، لصالح بن علي او لمروان بن محمد . كلم عروة بن الزبير عبد الملك بكلام غليظ والحجاج قاءم علي راسه ، فقال : يا ابن العمياء ، اتكلم امير المءمنين بمثل ما اسمع ؟ قال عروة : يا ابن المتمنية ، وما ذكرك عجاءز الجنة ؟ وكانت جدة الحجاج القاءلة : من البسيط هل من سبيل الي خمر فاشربها . . . ام هل سبيل الي نصر بن حجاج وكان عمر بن الخطاب رض الله عنه اجتار بالمراة وهي تنشد هذا الشعر ، فاحضر نصر بن حجاج ، وهو شاب جميل ذو وفرة مليحة ، فحلق شعره فكان اجمل ، فنفاه ، وقال : لا اسمع النساء يتمنينك في حجالهن . فقال عبد الملك : اقسمت عليك الا امسكت . ؟ قال ابو حاتم : كنت في حلقة ابي عبيدة ، فجاء الينا غلام من ال المهلب وضء الوجه في منطقه لين ، فكان القوم استقبحوا منطقه . فقال له رجل من ال صباح بن خاقان المنقري : يا غلام ممن انت ؟ قال : من ال المهلب ؛ قال : ومن امك ؟ قال : سبية من القندهار ، قال : نزعت فيك رخاوة الهند ؛ فبعث منه شيطانا ؛ فقال : ايها المتكلم فمن انت ؟ قال : من بني تميم ؛ قال : امكنت والله من مقاتلك : ام شبيبكم وفارسكم سوداء ، وام عنترتكم سوداء ، وام ذي الرقيبة سبية من امانيا ، وام عمرو بن العاص سبية من عنزة ، وام عبيد الله بن زياد بن ظبيان سبية من اصفهان ، وام ابن زياد الذي مزقكم كل  ممزق مرجانة ، وام زياد الذي شدخ رءوسكم سمية ، وام الشعبي من جلولاء ، وام خالد بن عبد الله الذي غمركم نواله سبية من الروم ، وام وكيع ابن الدورقية الذي ادرك ثاركم سبية من دروق ، وام عبد الله بن  خازم الذي اباد غابركم بخرسان سبية ، فايتهن تعيب لا ام لك ؟ ثم قام الغلام فما ابقي في الحلقة الا ضاحكا او شامتا . وروي عن رجل من قريش ، قال : كنت اجالس سعيد بن المسيب فقال لي يوما : من اخوالك ؟ قلت : امي فتاة ، فكاني نقصت من عينه ، وامهلت حتي دخل عليه سالم بن عبد الله بن عمر ، فلما خرج من عنده قلت : من هذا يا عم ؟ قال : سبحان الله ، اتجهل هذا من قومك ؟ هذا سالم بن عبد الله بن عمر ، قلت : فمن امه ؟ قال : فتاة ؛ ثم اتاه القاسم بن محمد بن ابي بكر الصديق فجلس اليه فنهض ، فقلت : من هذا يا عم ؟ قال : اتجهل من اهلك مثله ؟ ما اعجب هذا هذا القاسم بن محمد بن ابي بكر ، قلت : فمن امه ؟ قال : فتاة ؛ قال : فامهلت حتي جاء علي بن الحسين بن علي بن ابي طالب ، فسلم عليه ثم نهض ، فقلت له : يا عم ، من هذا ؟ قال : هذا الذي لا يسع مسلما ان يجهله ، هذا علي بن الحسين بن علي بن ابي طالب ، قلت : فمن امه ؟ قال : فتاة ؛ قال : فقلت يا عم رايتني نقصت في عينك لما علمت اني لام ولد ، اما لي في هءلاء اسوة ؟ قال : فجللت في عينه جدا . وتزوج علي بن الحسين امة له اعتقها ، فلامه عبد الملك بن مروان وكتب اليه : اما بعد فانه بلغني انك اعتقت امتك وتزوجتها ، وقد كان لك في اكفاءك من قريش ما تستكرم به في الصهر ، وتستنجب به في الولد ، فلم تنظر لنفسك ولا لولدك ونكحت في اللءم . فكتب اليه علي : اما بعد ، فاني اعتقتها بكتاب الله عز وجل وارتجعتها بسنة رسول الله صلي الله عليه وسلم ، وانه والله ما فوق رسول  الله صلي الله عليه وسلم مرتقي لاحد في مجد ، ان الله عز وجل قد رفع بالاسلام الخسيسة ، واتم النقيصة ، واكرم به من اللءم ، فلا عار علي مسلم ، هذا رسول الله صلي الله عليه وسلم تزوج امته وامراة عبده . فقال عبد الملك : ان علي بن الحسين يشرف من حيث يتضع الناس . سال الرشيد موسي بن جعفر فقال : لم زعمتم انكم اقرب الي رسول الله صلي الله عليه وسلم منا ؟ فقال : يا امير المءمنين ، لو ان رسول الله صلي الله عليه وسلم انشر فخطب اليك كريمتك اكنت تجيبه ؟ فقال : سبحان الله ، وكنت افتخر بذلك علي العجم والعرب ؛ فقال : لكنه لا يخطب الي ولا ازوجه لانه ولدنا ولم يلدكم . وروي انه قال : هل يجوز ان يدخل علي حرمك وهن متكشفات ؟ فقال : لا ، قال : لكنه كان يدخل علي حرمي كذلك ، وكان يجوز له . وقيل انه ساله ايضا : لم قلتم انا ذرية رسول الله ، وجوزتم للناس ان ينسبوكم اليه فيقولون يا بني رسول الله وانتم بنو علي ، وانما ينسب الرجل الي ابيه دون جده ؟ فقال : اعوذ بالله من الشيطان الرجيم ، بسم الله الرحمن الرحيم ومن ذريته داود وسليمان وايوب ويوسف وموسي وهارون وكذلك نجزي المحسنين وزكريا ويحيي وعيسي والياس الانعام :    ، وليس لعيسي اب ، وانما الحق بذرية الانبياء من قبل امه ، وكذلك الحقنا بذرية النبي صلي الله عليه وسلم من قبل امنا فاطمة عليها السلام ، وازيدك يا امير المءمنين ، قال الله تعالي فمن حاجك فيه من بعد ما جاءك من العلم فقل تعالوا ندع ابناءنا وابناءكم ونساءنا ونساءكم وانفسنا وانفسكم ال عمران :  . ولم يدع عليه السلام عند مباهلة النصاري غير علي وفاطمة والحسن والحسين وهم الابناء .  قال الرشيد للجهجاه : ازنديق انت ؟ قال : وكيف اكون زنديقا وقد قرات القران ، وفرضت الفراءض ، وفرقت بين الحجة والشبهة ؟ قال : والله لاضربنك حتي تقر ، قال : هذا خلاف ما امر به رسول الله صلي الله عليه وسلم ، امرنا ان نضرب الناس حتي يقروا بالايمان وانت تضربني حتي اقر بالكفر . قال المنصور لاسحاق بن مسلم العقيلي : افرطت في ولاءك لبني امية ، فقال : من وفي لمن لا يرجي كان لمن يرجي اوفي ، فصدقه . ودخل المكي علي المامون ، وكان مفرط القصر والدمامة ، فضحك المعتصم ، فقال المكي : مم ضحك هذا ؟ فوالله ما اصطفي الله يوسف عليه السلام لجماله وانما اصطفي لبيانه ، وقد نص الله عز وجل علي ذلك بقوله : فلما كلمه قال انك اليوم لدينا مكين امين يوسف :  ، وبياني احسن من هذا . قال معاوية لرجل من اهل اليمن : ما كان احمق قومك حين ملكوا عليهم امراة ، قال : قومك اشد حماقة اذ قالوا : اللهم ان كان هذا هو الحق من عندك فامطر علينا حجارة من السماء الانفال :  ، هلا قالوا : فاهدنا له . طاف رجل من بني تغلب بالبيت ، وكان وسيما جسيما ، فبصر به رجل من قريش كان حسودا ، فسال عنه فخبر انه من تغلب ، فلما حاذاه قال  القرشي ليسمعه : انها لرجلان قلما وطءت البطحاء . فالتفت اليه التغلبي وقال له : يا هذا البطحاوات ثلاث : فبطحاء الجزيرة وهي لي دونك ، وبطحاء ذي قار وانا احق بها منك ، وهذه البطحاء سواء العاكف فيه والباد . قال : فتحير الرجل فما اعاد كلمة . قال الرشيد لاسماعيل بن صبيح : وددت ان لي حسن خطك ، فقال : يا امير المءمنين ، لو كان حسن الخط مكرمة لكان اولي الناس بها رسول الله صلي الله عليه وسلم . قال محمد بن عبد الملك الزيات لبعض اولاد البرامكة : من انت ومن ابوك ؟ قال : ابي الذي تعرفه ، ومات وهو لا يعرفك . ومثل هذا او قريب منه ما حكي ان المرواني صاحب الاندلس كتب الي صاحب مصر كتابا وملاه بسبه وسب ابيه ، فكتب اليه في الجواب : يا هذا ، عرفتنا فهجوتنا ، ولو عرفناك لاجبناك ، والسلام . دخل شاب من بني هاشم علي المنصور ، فساله عن وفاة ابيه ، فقال : مرض رضي الله عنه يوم كذا ، ومات رحمه الله يوم كذا ، وترك رحمه الله من المال كذا . فانتهره الربيع وقال : بين يدي امير المءمنين توالي الدعاء لابيك . فقال الشاب : لا الومك لانك لم تعرف حلاوة الاباء . قال : فما علمنا ان المنصور ضحك في مجلسه قط ضحكا افتر عن نواجذه الا يومءذ  وكان الربيع لقيطا . واستبطا عبد الملك بن مروان ابنة مسلمة في مسيره الي الروم فكتب  اليه : من الكامل لمن الظعاءن سيرهن تزحف . . . سير السفين اذا تقاعس يجذف فكتب اليه مسلمة في الجواب : من الطويل ومستعجب مما يري من اناتنا . . . ولو زبنته الحرب لم يترمرم وسمع مسلمة رجلا تمثل بقول الشاعر وقد دلي بعض بني مروان في قبره : من الطويل وما كان قيس هلكه هلك واحد . . . ولكنه بنيان قوم تهدما فقال له مسلمة : لقد تكلمت بكلمة شيطان ، هلا قلت : من الطويل اذا مقرم منا ذرا حد نابه . . . تخمط فينا ناب اخر مقرم سابق مسلمة في حلبة فسبق وعبد الملك حاضر ، فقال عبد الملك ، والشعر لبعض بني عبس : من الطويل نهيتكم ان تحملوا هجناءكم . . . علي خيلكم يوم الرهان فتدركوا فتضعف ساقاه وتفتر كفه . . . وتخذر فخذاه فلا يتحرك وما يستوي المران هذا ابن حرة . . . وهذا هجين ظهره متشرك قعدن به خالاته فاختزلنه . . . الا ان ان عرق السوء لا بد مدرك فقال مسلمة ، والشعر لمسكين الدارمي : من الطويل وما انكحونا طاءعين فتاتهم . . . ولكن نكحناها باسيافنا قهرا كريم اذا اعتل الزمان وجدته . . . وقد سار في ظلماءه قمرا بدرا  فما زادها فينا السباء مذلة . . . ولا خبزت خبزا ولا طبخت قدرا وكاءن تري فينا من ابن سبية . . . اذا التقت الخيلان يطعنها شزرا ولكن خلطناها بحر نساءنا . . . فجاءت بهم بيضا غطارفة زهرا لما استخلف المهدي اخرج من في السجون ، فقيل له : انما تزري علي ابيك ، فقال : لا ازري علي ابي ، ولكن ابي حبس بالذنب وانا اعفو عنه . وجزع المهدي علي رخيم جاريته جزعا شديدا ، فكان ياتي المقابر ليلا فيبكي . فبلغ ذلك المنصور فكتب اليه : كيف ترجو ان اوليك امر الامة وانت تجزع علي امة ؟ فكتب اليه المهدي : اني لم اجزع علي قيمتها وانما جزعت علي شيمتها . عرض رجل للرشيد وهو يطوف بالبيت فقال : يا امير المءمنين ، اني اريد ان اكلمك بكلام فيه خشونة ، فاحتمله لي ، قال : لا ولا كرامة ، قد بعث الله تعالي من هو خير منك الي من هو شر مني فقال : فقولا له قولا لينا طه :  . قال رجل لمعاوية : والله لقد بايعتك وانا كاره ، فقال معاوية : قد جعل الله لك في الكره خيرا كثيرا . قال الحجاج يوما علي المنبر : تزعمون انا من بقايا ثمود ، والله جل وعز يقول : وثمودا فما ابقي النجم :  . وقال مرة اخري : لءن كنا من بقايا ثمود فما انجي الله مع صالح الا خيارهم . وبنو ثقيف يزعمون ان ثقيفا هو قسي بن منبه بن بكر بن هوازن بن منصور  ابن عكرمة بن خصفة بن قيس بن عيلان بن مضر ؛ وقال قوم : ان ثقيفا والنخع اخوان من اياد ، وقوم اخرون يزعمون ان ثقيفا من بقايا ثمود . اتي الوليد بن عبد الملك برجل من الخوارج ، فقيل له ما تقول في ابي بكر وعمر : فقال خيرا ، قيل فعثمان : قال خيرا . قيل فما تقول في امير المءمنين عبد الملك : فقال : الان جاءت المسالة ، ما اقول في رجل الحجاج خطيءة من خطاياه . قال معاوية يوما لاهل الشام ، وعنده عقيل بن ابي طالب : هذا ابو يزيد لولا انه علم اني خير له من اخيه لما اقام عندنا وتركه ، فقال له عقيل : اخي خير لي في ديني وانت خير لي في دنياي . وقال له مرة اخري : انت معنا يا ابا يزيد ، قال : ويوم بدر كنت معكم . مر معاوية بقوم من قريش ، فلما راوه قاموا غير عبد الله بن عباس ، فقال : يا ابن عباس ، ما منعك من القيام كما قام اصحابك ؟ ما ذاك الا لموجدة اني قاتلتكم بصفين ، فلا تجد ، فان عثمان بن عفان قتل مظلوما . قال ابن عباس : فعمر بن الخطاب قتل مظلوما ، قال : ان عمر قتله كافر ، قال ابن عباس فمن قتل عثمان ؟ قال : المسلمون ، قال : فذاك دحض لحجتك . لقي ابو العيناء بعض اخوانه في السحر ، فجعل يعجب من بكوره ويقول : يا ابا عبد الله ، اتركب في مثل هذا الوقت ؟ فقال له ابو العيناء : تشاركني بالفعل وتفردني بالتعجب .  وكان ابو العيناء في جملة ابي الصقر ، وكان يعادي ابن ثوابة لمعاداته لابي الصقر . فاجتمعا في مجلس صاعد ، فتلاحيا ، فقال له ابن ثوابة : اما تعرفني ؟ فال له ابو العيناء : بلي والله ، اعرفك ضيق العطن ، كثير الوسن ، قليل الفطن ، خارا علي الذقن . قد بلغني تعديك علي ابي الصقر ، وانما حلم عنك لانه لم يجد عزا فيذله ، ولا علوا فيضعه ، ولا مجدا فيهدمه ، فعاف لحمك ان ياكله ، وسهك دمك ان يسفكه . فقال له اسكت ، فما تساب اثنان الا غلب الامهما ، فقال له ابو العيناء : فلهذا غلبت ابا الصقر بالامس . قال عبد الصمد بن علي : كنت عند عبد الله بن علي في عسكره بالشام لما خالف المنصور ودعا الي نفسه ، وكان ابو مسلم بازاءه يقاتله ، فاستءذن لرسول ابي مسلم عليه فاذن له ، فدخل رجل من اهل الشام فقال له : يقول لك الامير علام قتالك اياي وانت تعلم اني اهزمك ؟ فقال ، قل له : يا ابن الزانية ، ولم تقاتلني عنه وانت تعلم انه يقتلك . وشبيه بهذا ما حكي عن الامين انه كتب الي طاهر بن الحسين وقت محاربته اياه : يا طاهر ، اعلم انه ما قام لنا قاءم بامر فكان جزاءه منا الا السيف ، فخذ لنفسك او دع . فكان طاهر يقول بعد ذلك : والله لقد جعلني علي مثل النار من الحذر . قال المهدي لشريك وعيسي بن موسي عنده : لو شهد عندك عيسي  كنت تقبله ؟ واراد ان يغري بينهما ، فقال شريك : من شهد عندي سالت عنه ، ولا يسال عن عيسي غير امير المءمنين ، فان زكيته قبلته . فقلبها عليه . وقال مروان بن محمد لحاجبه يوم الزاب وقد ولي منهزما : كر عليهم بالسيف ، فقال : لا طاقة لي لهم ؛ قال : والله لءن لم تفعل لاسوانك ، قال : وددت انك تقدر علي ذلك . قال بحيرا الراهب لابي طالب : احذر علي ابن اخيك فانه سيصير الي كذا وكذا . قال : ان كان الامر علي ما وصفت فهو في حصن من الله تعالي . قال رجل لهشام بن الحكم : اليس اختصم العباس وعلي الي عمر ؟ قال : بلي ، قال : فايهما كان الظالم ؟ قال : ليس فيهما ظالم ، قال : سبحان الله كيف يتخاصم اثنان وليس فيهما ظالم ؟ قال : كما تخاصم الملكان الي داود وليس فيهما ظالم . قال رجل لشريك : اخبرني عن قول علي عليه السلام للحسن : ليت اباك كان قد مات قبل هذا اليوم بعشرين سنة ، اقاله الا هو شاك في امره ؟ قال له شريك : اخبرني عن قول مريم : يا ليتني مت قبل هذا وكنت نسيا منسيا مريم :  ، قالته شاكة في عفتها ؟ فسكت الرجل . دخل الوليد بن يزيد علي هشام وعلي الوليد عمامة وشي ، فقال هشام : بكم اخذت عمامتك ؟ قال بالف درهم . فقال هشام : عمامة بالف درهم ؟ يستكثر ذلك . قال : يا امير المءمنين انها لاكرم اطرافي ، وقد اشتريت  انت جارية بعشرة الاف دينار لاخس اطرافك . بايت المفضل الضبي المهدي ، فلم يزل يحدثه وينشده حتي جري ذكر حماد الراوية ، فقال له المهدي : ما فعل عياله ومن اين يعيشون ؟ قال : من ليلة مثل هذه كانت مع الوليد بن يزيد . شكا يزيد بن اسيد الي المنصور ما ناله من العباس بن محمد اخيه ، فقال المنصور : اجمع احساني اليك واساءة اخي فانهما يعتدلان ؛ قال : اذا كان احسانكم الينا جزاء لاساءتكم كانت الطاعة منا تفضلا . لما بني محمد بن عمران قصره حيال قصر المامون قيل : يا امير المءمنين ، ماراك وباهاك . فدعاه فقال : لم بنيت هذا القصر حذاءي ؟ قال : يا امير المءمنين ، احببت ان تري اثر نعمتك علي فجعلته نصب عينيك . فاستحسن جوابه واجزل عطيته . قال الاشعث بن قيس لشريح القاضي : يا ابا امية ، عهدي بك وان شانك لشءين ، فقال : يا ابا محمد ، انت تعرف نعمة الله علي غيرك وتجهلها في نفسك . تظلم اهل الكوفة الي المامون من عامل ولاه عليهم ، فقال المامون : ما علمت في عمالي اعدل ولا اقوم بامر الرعية ، ولا اعود بالرفق عليهم منه . فقام رجل من القوم فقال : يا امير المءمنين ، ما احد اولي بالعدل والانصاف منك ،  فاذا كان عاملنا بهذه الصفة فينبغي ان تعدل بولايته بين اهل البلدان وتساوي به اهل الامصار ، حتي يلحق كل بلد واهله من عجله وانصافه مثل الذي لحقنا ؛ واذا فعل ذلك امير المءمنين فلا يصيبنا منه اكثر من ثلاث سنين ، فضحك المامون وعزل العامل عنهم . وكتب ابراهيم بن سيابة الي رجل كثير المال يستسلف منه نفقة ، فكتب اليه : العيال كثير ، والدخل قليل ، والدين ثقيل ، والمال مكذوب عليه . فكتب اليه ابراهيم : ان كنت كاذبا فجعلك الله صادقا ، وان كنت محجوجا فجعلك الله معذورا . نظر الي هذا المعني ابو عبد الله ابن الحجاج فقال من ابيات له : من السريع مدحته يوما براءية . . . نفخت في انشادها شدقي فلم يزل يقعد لي تارة . . . وتارة في الدست يستلقي كانه في شهرها حامل . . . قد نخت يومين بالطلق ثم اشتكي الفقر وقال ادع لي . . . بان يزيد الله في رزقي فقلت يا رب بحق الذي . . . ارسلته يدعو الي الحق ان كان فيما يدعي كاذبا . . . فافتح له بابا الي الصدق صار الفضل بن الربيع الي ابي عباد في نكبته يساله حاجة فارتج عليه ، فقال له : يا ابا العباس ، بهذا البيان خدمت خليفتين ؟ فقال : انا تعودنا ان نسال ولا نسال .  قال مالك بن طوق للعتابي : سالت فلانا حاجة فرايتك قليلا في كلامك . قال : كيف لا اقل في كلامي ومعي حيرة الطلب ، وذل المسالة ، وخوف الرد . قال بنو تميم لسلامة بن جندل : مجدنا في شعرك . فقال : افعلوا حتي اقول . ساير ابن لشبيب بن شبة علي بن هشام ، وعلي علي برذون له فاره ، فقال له : سر ، قال : كيف اسير وانت علي برذون ان ضربته طار وان تركته سار ، وانا علي برذون ان ضربته قطف وان تركته وقف . فدعا له ببرذون وحمله عليه . عاتب الفضل بن سهل الحسين بن مصعب في امر ابنه طاهر والتواءه عليه وتلونه ، فقال له الحسين : انا ايها الامير شيخ في ايديكم ، لا تذمون اخلاصي ، ولا تنكرون نصحي ؛ فاما طاهر فلي في امره جواب مختصر ، وفيه بعض الغلظ ، فان اذنت ذكرته ، قال : قل ، فقال : ايها الامير ، اخذت رجلا من عرض الاولياء ، فشققت صدره واخرجت قلبه ، ثم جعلت فيه قلبا قتل به خليفة ، واعطيته الة ذلك من الرجال والاموال والعبيد ، ثم تسومه بعد ذلك ان يذل لك ويكون كما كان ؟ لا يتهيا هذا الا ان ترده الي ما كان ، ولا تقدر علي ذلك . فسكت الفضل . اتي هشام برجل قد رمي بخيانة ، فاقبل يحتج عن نفسه ، فقال له  هشام : او تتكلم ايضا ؟ فقال الرجل : ان الله سبحانه يقول : يوم تاتي كل نفس تجادل عن نفسها النحل :  ، افنجادل الله تعالي جدالا ولا نكلمك كلاما ؟ فقال : تكلم بما احببت . كتب الحسن بن زيد الي صاحب الزنج بالبصرة : عرفني نسبك ؟ فاجابه : ليعنك من شاني ما عناني من امرك . قيل لابي الهذيل : ان قوما يلعنونك ، قال : ارايت ان انا اتبعتهم هل يلعنني قوم اخرون ؟ قال : نعم ، قال : فاراني لا اتخلص من لعن طاءفة ، فدعني مع الحق واهله . خلع الرشيد علي يزيد بن مزيد ، وكان في مجلسه رجل من اهل اليمن ، فقال : اجرر يا يزيد ما لم يعرق فيه جبينك ، قال : صدقت عليكم نسجه وعلينا سحبه . قال عمرو بن العاص لمعاوية : ما اشد حبك للمال ، قال : ولم لا احبه وانا استعبد به مثلك وابتاع دينك ومروءتك . قال ابو العيناء : قال لي المتوكل يوما : لا تكثر الوقيعة في الناس ، فقلت : ان لي في بصري شغلا عن ذلك ، فقال : ذاك اشد لحقدك علي اهل العافية . وقال له المتوكل يوما : ان سعيد بن عبد الملك يضحك منك ، فقال : ان الذين اجرموا كانوا من الذين امنوا يضحكون المطففين :  . وقال له ابن السكيت : تراك احطت بما لم احط به ؟ قال : ما  انكرت ؟ فوالله لقد قال الهدهد  وهو اخس طاءر  لسليمان : احطت بما لم تحط به . وقال ابو العيناء : قال لي المتوكل : امص الي موسي بن عبد الملك واعتذر اليه ولا تعلمه اني وجهتك . فقلت له : تستكتمني بحضرة الف ؟ قال : انما عليك ان تنفذ لما تءمر به ، قلت : وعلي ان احترس مما اخاف منه . وقال له يوما عبيد الله بن سليمان : كيف حالك ؟ قال : انت الحال ، اذا صلحت صلحت . وقربه يوما فقال : تقريب المولي وحرمان العدو . قيل له : لا تعجل فان العجلة من الشيطان ، فقال : لو كان كذلك لما قال موسي : وعجلت اليك ربي لترضي طه :  . وقال ابو العيناء : انا اول من اظهر العقوق بالبصرة ، قال لي ابي : يا بني ان الله قرن طاعته بطاعتي فقال : اشكر لي ولوالديك لقمان :  ، فقلت : يا ابه ان الله تعالي اءتمنني عليك ولم ياتمنك علي فقال سبحانه وتعالي : ولا تقتلوا اولادكم خشية املاق الاسراء :  . وقال ابو العيناء : قال لي المتوكل يوما : بلغني انك رافضي . فقلت : للدين ام للدنيا ؟ فان اك للدين ترفضت فابوك مستنزل الغيث ؛ وان اك لدنيا ففي يدك خزاءن الارض . وكيف اكون رافضيا وانا مولاك ، ومولدي  البصرة ، واستاذي الاصمعي ، وجيراني باهلة ؟ فقال : ان ابن سعدان زعم ذلك ، فقلت : ومن ابن سعدان والله ما يفرق بين الامام والماموم ، والتابع والمتبوع ، انما ذلك حامل درة ومعلم صبية ، واخذ علي كتاب الله اجرة . قال : لا تفعل ، فانه مءدب المءيد ؛ قلت : يا امير المءمنين ، لم يءدبه حسبة ، وانما ادبه باجرة ، فاذا اعطيته حقه فقد قضيت ذمامه . وقف بهلول علي رجل فقال : خبرني عن قول الشاعر : من الكامل واذا نبا بك منزل فتحول كيف هو عندك ؟ قال : جيد ، قال : فان كان في الحبس فكيف يتحول ؟ فانقطع الرجل . فقال بهلول : الصواب قول عنترة : من الطويل اذا كنت في دار يسوءك اهلها . . . ولم تك مكبولا بها فتحول قيل لمجنون : ما فعل ضربك للصبيان ؟ فقال : من الطويل وان امرءا يمسي ويصبح سالما . . . من الناس الا ما جني لسعيد تزوج اعرابي امراة اشرف منه حسبا ونسبا فقال : يا هذه انك مهزولة ، فقالت : هزالي اولجني بيتك . نظر رجل الي امراتين تتلاعبان فقال : مرا ، لعنكما الله ، فانكن صويحبات يوسف . فقالت احداهن : يا عم فمن رمي به في الجب ؟ انحن ام انتم ؟ قال علي بن عبيدة : تزاور اختان من اهل القصر فارهقتهما الصلاة ، فبادرت احداهما فصلت صلاة خفيفة ، فقال لها بعض النساء : كنت حرية  ان تطولي الصلاة في هذا اليوم شكرا لله تعالي حيث التقيتما ، قالت : لا ولكن اخفف صلاتي اليوم واتمتع بالنظر اليها ، واشكر الله تعالي في صلاتي غدا . قال عاءشة للخنساء : الي كم تبكين علي صخر ، وانما هو جذوة في النار ؟ قالت : ذلك اشد لجزعي عليه . جاءت امراة الي عدي بن ارطاة تستعديه علي زوجها وتشكو انه عنين لا ياتيها ، فقال عدي : اني لاستحي للمراة ان تستعدي علي زوجها في مثل هذا ، فقالت : ولم لا ارغب فيما رغبت فيه امك ، فلعل الله ان يرزقني ابنا مثلك . مدح رجل هشاما فقال : يا هذا انه قد نهي عن مدح الرجل في وجهه ، فقال له : ما مدحتك وانما اذكرتك نعم الله تعالي لتجدد له شكرا . قال المغيرة بن شعبة لعمر بن الخطاب رضي الله عنه في جواب كلام اشار فيه الي تجنب الفاجر : يا امير المءمنين ، الضعيف المءمن له امانته وعليك ضعفه ، والفاجر القوي لك قوته وعليه فجوره . فولاه الكوفة . لما فتح قتيبة بن مسلم سمرقند افضي الي اثاث ومتاع لم ير مثله ، وكان في جملة ذلك قدور يرقي اليها بالسلالم . فاراد ان يري الناس عظيم ما فتح الله عليهم ، فامر بدار ففشرت له ، وفي صحنها تلك القدور ، فاذا بالحضين بن المنذر بن الحارث بن وعلة الرقاشي قد اقبل والناس جلوس علي مراتبهم ، والحضين شيخ كبير . فلما راه عبد الله بن مسلم قال لاخيه قتيبة : اءذن لي في  معابثته ، قال : لا ترده فانه خبيث الجواب ، فابي عبد الله الا ان ياذن له  وكان عبد الله يضعف ، وكان تسور حاءطا الي امراة قبل ذلك  فاقبل علي الحضين فقال له : امن الباب دخلت يا ابا ساسان ؟ قال : اجل ، اسن عمك عن تسور الحيطان ؛ قال : ارايت هذه القدور ؟ قال : هي اعظم من ان لا تري ؛ قال : ما احسب بكر بن واءل راي مثلها ؛ قال : اجل ولا عيلان ، ولو كان راها لسمي شبعان ولم يسم عيلان ، فقال له عبد الله : يا ابا ساسان اتعرف الذي يقول : من الطويل عزلنا وامرنا وبكر بن واءل . . . تجر خصاها تبتغي من تحالف قال : اعرفه واعرف الذي يقول : من الوافر وخيبة من يخيب علي غني . . . وباهلة بن يعصر والرباب قال : اتعرف الذي يقول : من الطويل كان فقاح الازد حول ابن مسمع . . . اذا عرقت افواه بكر بن واءل قال : نعم واعرف الذي يقول : من الكامل قوم قتيبة امهم وابوهم . . . لولا قتيبة اصبحوا في مجهل قال : اما الشعر فاراك ترويه ، فهل تقرا من القران شيءا ؟ قال : اقرا منه الاكثر الاطيب : هل اتي علي الانسان حين من الدهر لم يكن شيءا مذكورا الانسان :  . قال : فاغضبه ، فقال : والله لقد بلغني ان امراة الحضين حملت اليه وهي حامل من غيره ، قال : فما تحرك الشيخ عن هيءته الاولي ، ثم قال علي رسله : وما يكون ؟ تلد غلاما علي فراشي فيقال فلان ابن  الحضين كما يقال : عبد الله بن مسلم . فاقبل قتيبة علي عبد الله وقال : لا يبعد الله غيرك . قام عمرو بن العاص بالموسم فاطري معاوية وبني امية ، وتناول من بني هاشم ، وذكر مشاهده بصفين ، فقال له ابن عباس : يا عمرو ، انك بعت دينك من معاوية واعطيته ما في يدك ، ومناك ما في يد غيره ، فكان الذي اخذ منك فوق الذي اعطاك ، وكان الذي اخذت منه دون ما اعطيته ، وكل راض بما اخذ واعطي ؛ فلما صارت مصر في يدك تتبعك فيها بالعزل والتنقص ، حتي لو ان نفسك فيها القيتها اليه . وذكرت مشاهدك بصفين ، فما ثقلت علينا وطاتك ولا نكاتنا فيها حربك ، وان كنت فيها لطويل اللسان قصير البنان ، اخر الحرب اذا اقبلت واولها اذا ادبرت ، لك يدان : يد لا تبسطها الي خير ، ويد لا تقبضها عن شر ، ووجهان : وجه مونس ووجه موحش ، ولعمري ان من باع دينه بدنيا غيره لحري ان يطول حزنه علي ما باع واشتري ؛ ولك بيان وفيك خطل ، ولك راي وفيك نكد ، ولك قدر وفيك حسد ، فاصغر عيب فيك اعظم عيب غيرك . فقال عمرو : اما والله ما في قريش اثقل وطاة منك علي ، ولا لاحد من قريش عندي مثل قدرك . ولما استقام راي الناس علي ابي موسي بصفين ، اتاه عبد الله بن عباس  وعنده وجوه الناس واشرافهم  فقال : يا ابا موسي ، ان الناس لم  يرضوا بك ولم يجتمعوا عليك لفضل لا تشارك فيه ، وما اكثر اشباهك من المهاجرين والانصار والمقدمين قبلك ، ولكن اهل الشام ابوا غيرك ، وايم الله اني لاظن ذلك شرا لنا وخيرا لهم ، وانه قد ضم اليك داهية العرب ، وليس في معاوية خصلة يستحق بها الخلافة ؛ فان تقذف بحقك علي باطله تدرك حاجتك ، وان تطمع باطله في حقك يدرك حاجته فيك . اعلم ان معاوية طليق الاسلام ، وان اباه من الاحزاب ، وانه ادعي الخلافة من غير مشورة ، فان صدقك فقد صرح بخلعه ، وان كذبك فقد حرم عليك كلامه ، وان ادعي ان عمر وعثمان استعملاه فصدق : فاما عمر استعمله وهو الوالي عليه ، بمنزلة الطبيب من المريض يحميه مما يشتهي ويءخره مما يكره ، ثم استعمله عثمان براي عمر ، وما اكثر من استعملاه ثم لم يدعوا الخلافة ، وهو منهم واحد . واعلم ان لعمرو مع كل شء يسرك حينا يسوءك . ومهما نسيت فلا تنس ان عليا بايعه القوم الذي بايعوا ابا بكر وعمر وعثمان ، فانها بيعة هدي ، وانه لم يقاتل الا غاصبا او ناكثا . فقال ابو موسي : رحمك الله والله ما لي امام غير علي ، واني لواقف عند ما اري ، ولرضي الله احب الي من رضي اهل الشام ، وما انا وانت الا بالله . دخل زيد بن علي علي هشام بن عبد الملك الرصافة فسلم تسليم الخلافة ، ثم مال فجلس ، فقال : يا امير المءمنين ، انه ليس احد فوق ان يوصي بتقوي الله واني اوصيك بتقوي الله ، وكفي به جازيا لعباده الصالحين ومثيبا . فظن هشام انه يريد ان يتظلم ، فقال : انت الراجي للخلافة المنتظر لها ، وكيف ترجوها وانت ابن امة ؟ فقال : يا امير المءمنين ، ان شءت اجبت وان شءت سكت ، قال : اجب ، قال : انه ليس احد اعظم عند الله منزلة من نبي بعثه رسولا ، فلو كانت ولادة ام ولد تقصر به عن بلوغ غاية الانبياء والرسل لم يبعث  الله اسماعيل بن ابراهيم ، وكانت امه مع ام اسحاق كامي مع امك ، ثم لم يمنعه ذلك ان يبعثه الله نبيا ، وكان عند ربه مرضيا ، وكان ابا العرب وابا خير البشر وخاتم المرسلين ؛ فالنبوة اعظم خطرا ام الخلافة ؟ وما عار الرجل بامه وهو ابن رسول الله صلي الله عليه وسلم وابن علي بن ابي طالب ؟ ثم طفق فخرج . قال الاسكندر لابنه : يا ابن الحجامة فقال : اما امي فقد احسنت التخير ، واما انت فلم تحسن . ؟ وقال اعرابي لابنه : يا بن الامة فقال : لهي والله اعذر منك حيث لم ترض الا حرا . قال رجل لاعرابي : اتجلب التمر الي هجر ؟ قال : نعم اذا اجدبت ارضها وعدم نخلها . لما بلغ معاوية وفاة الحسن بن علي عليه السلام دخل عليه ابن عباس قبل ان يعلم بها ، فقال له : اجرك الله ابا عباس في ابي محمد الحسن بن علي  ولم يظهر حزنا  فقال ابن عباس : انا لله وانا اليه راجعون ، وغلبه البكاء فرده ، ثم قال : لا يسد والله مكانه حفرتك ، ولا يزيد موته في اجلك ، والله لقد اصبنا بمن هو اعظم منه فقدا فما ضيعنا الله بعده . قال له معاوية : كم كانت سنه ؟ قال : هو اشهر من ان تجهل سنه . قال : احسبه ترك اولادا صغارا ؟ قال : كلنا كان صغيرا فكبر ، ولءن اختار الله لابي محمد ما عنده وقبضه الي رحمته ، فلقد ابقي الله ابا عبد الله ، وفي مثله الخلف الصالح . لما اهديت بنت عقيل بن علفة الي عبد الملك بن مروان او الي الوليد  ابنه بعث مولاة له لتاتيه بخبرها قبل ان يدخل بها . فاتتها فلم تاذن لها وكلمتها فاحفظتها فهشمت انفها . فرجعت اليه فاخبرته ، فغضب من ذلك ، فلما دخل عليها قال : ما اردت الي عجوزنا هذه ؟ قالت : اردت والله ان كان خيرا ان تكون اول من لقي بهجته ، وان كان شرا ان تكون احق من ستره . ارسل مسلمة بن عبد الملك الي هند بنت المهلب يخطبها علي نفسه ، فقالت لرسوله : والله لو احيا من قتل من اهل بيتي وموالي ما طابت نفسي بتزويجه ، بل كيف يامنني علي نفسه وانا اذكر ما كان منه ، وثاري عنده ؟ لقد كان صاحبك يوصف بغير هذا في رايه . قال بعضهم : رايت بالمدينة امراة بين عينيها سجادة وعليها ثياب معصفرة ، فقلت لها : ما ابعد زيك من سمتك ؟ فقالت بصوت نشيط : من الطويل ولله مني جانب لا اضيعه . . . وللهو مني جانب ونصب ولست ابالي من رماني بريبة . . . اذا كنت عند الله غير مريب قال بعضهم : خرجت في حاجة فلما كنت بالسيالة ، وقفت علي باب ابراهيم بن هرمة ، فصحت : يا ابا اسحاق ، فاجابتني ابنته ، قالت : خرج انفا ؛ قلت : هل من قري فاني مقو من الزاد ؟ قالت : لا والله ، قلت : فاين قول ابيك : من المنسرح لا امتع العود بالفصال ولا . . . ابتاع الا قريبة الاجل  قالت : فذاك افناها . وقيل انه اجتمع بباب ابن هرمة جماعة من الشعراء فسالوا ابنته عنه فقالت : وما تريدون منه ؟ قالوا : جءنا لنهاجيه ، قالت : من الطويل تجمعتم من كل اوب ووجهة . . . علي واحد لا زلتم قرن واحد قيل لسعيد بن المسيب وقد كف بصره : الا تقدح عينك ؟ قال : حتي افتحها علي من ؟ . قال رجل لعامر بن الطفيل : استاسر ، قال : بيت امك لا يسعني . وقف رجل للحجاج فقال : اصلح الله الامير ، جني جان في الحي فاخذت بجريرته واسقط عطاءي ، فقال : اما سمعت قول الشاعر : من الكامل المرفل جانيك من يجني عليك وقد . . . يعدي الصحاح مبارك الجرب ولرب ماخوذ بذنب صديقه . . . ونجا المقارف صاحب الذنب فقال الرجل : كتاب الله تعالي اول ما اتبع ، قال الله عز وجل : معاذ الله ان ناخذ الا من وجدنا متاعنا عنده يوسف :  ؛ فقال الحجاج : صدقت ، وامر برد عطاءه . مر الاحنف بعكراش بن ذءيب  وكان ممن شهد الجمل مع عاءشة فقطعت يداه جميعا  فصاح به عكراش : يا مخذل ، فقال الاحنف : اما انك لو اطعتني لاكلت بيمينك وتمسحت بشمالك .  وقال له رجل : تسمع بالمعيدي خير من ان تراه ، فقال : وما ذممت في يا ابن اخي ؟ قال : الدمامة وقصر القامة ، قال : لقد عبت ما لم اءامر فيه . وشخص يزيد بن عمر بن هبيرة الي هشام فتكلم ، فقال هشام : ما مات من خلف مثل هذا ؛ فقال الابرش الكلبي : ليس هناك ، اما تراه يرشح جبينه لضيق صدره ؟ فقال يزيد : ما لذاك ارشح ، لكن لجلوسك في هذا الموضع . خرج يزيد بن عمر بن هبيرة الفزاري يسير بالكوفة الي مسجد بني غاضرة وقد اقيمت الصلاة ، فنزل فصلي واجتمع الناس لمكانه في الطريق ، واشرف النساء من السطوح ، فلما قضي صلاته قال : لمن هذا المسجد ؟ قيل : لبني غاضرة ، فتمثل قول الشاعر : من الكامل ولما تركن من الغواضر معصرا . . . الا فصمن بساقها خاخالا فقالت له امراة من المشرفات : من الكامل ولقد عطفن علي فزارة عطفة . . . كر المنيح وجلن ثم مجالا فقال يزيد : من هذه ؟ قالوا : بنت الحكم بن عبدل ، فقال : هل تلد الحية الا حية . دخل طريح بن اسماعيل الثقفي علي ابي جعفر المنصور في جملة الشعراء ، فقال له المنصور حين سلم : لا حياك الله ولا بياك ، اما اتقيت الله ويلك حيث تقول للوليد : من المنسرح  لو قلت للسيل دع طريقك وال . . . موج عليه كالهضب يعتلج لساخ وارتد او لكان له . . . في ساءر الناس عنك منعرج ويروي الي طريق سواك . فقال طريح : قد علم الله اني قلت ذاك ويدي ممتدة اليه عز وجل ، واياه تبارك وتعالي عنيت ، فقال المنصور : يا ربيع اما تري هذا التخلص ؟ انشد اسماعيل بن يسار النساء عبد الملك بن مروان قصيدة مدحه بها يقول فيها : من الطويل جعلت هشاما والوليد ذخيرة . . . وليين للعهد الوثيق المءكد قال فنظر اليهما عبد الملك مبتسما ، والتفت الي سليمان فقال : اخرجك اسماعيل من هذا الامر ، فغضب سليمان ونظر الي اسماعيل نظر مغضب ، فقال : يا امير المءمنين انما وزن الشعر اخرجه من البيت الاول وقد قلت بعده : من الطويل وامضيت عزما في سليمان راشدا . . . ومن يعتصم بالله مثلك يرشد فامر له بالفي درهم ، وامر اولاده الثلاثة فاعطوه ثلاثة الاف درهم . ومثله ان ابا تمام انشد احمد بن المعتصم : من الكامل اقدام عمرو في سماحة حاتم . . . في حلم احنف في ذكاء اياس فقال له مءدبه  واراد الغض منه  : الامير اكبر من كل من وصفت . فقال ابو تمام : الكلام باخره ، ثم انشد : من الكامل لا تنكروا ضربي له من دونه . . . مثلا شرودا في الندي والباس  فالله قد ضرب الاقل لنوره . . . مثلا من المشكاة والنبراس وقيل انه ارتجل البيتين لوقته . اعترض الرشيد قينة ليشتريها فغنت : من المنسرح ما نقموا من بني امية ال . . . ا انهم يجهلون ان غضبوا ثم تنبهت فقالت : وانهم معدن النفاق فما . . . تفسد الا عليهم العرب فقال الرشيد ليحيي بن خالد : سمعت يا ابا علي ؟ فقال : تبتاع ، يا امير المءمنين ، وتسني لها الجاءزة ، ويعجل لها الاذن ليسكن قلبها ، قال : ذلك جزاءها . وقال لها : انت مني بحيث تحبين ، فاغمي علي الجارية . والشعر الذي غنت لعبيد الله بن قيس الرقيات وهو : من المنسرح ما نقموا من بني امية ال . . . ا انهم يحلمون ان غضبوا وانهم معدن الملوك فما . . . تصلح الا عليهم العرب جلس عمرو بن هداب للشعراء فانشده طريف بن سوادة ارجوزة فيه حتي انتهي الي قوله : من الرجز  ابرص فياض اليدين اكلف . . . والبرص اندي باللهي واعرف وكان عمرو ابرص فصاح به بعض حاضريه : اسكت قطع الله لسانك ، فقال عمرو : مه ان البرص من مفاخر العرب ، اما سمعت قول ابن حبناء : من البسيط لا تحسبن بياضا في منقصة . . . ان اللهاميم في اقرابها بلق احضر عبد الملك بن مروان رجلا يري راي الخوارج ، فامر بقتله وقال : الست القايل : من الطويل ومنا سويد والبطين وقعنب . . . ومنا امير المءمنين شبيب فقال : يا امير المءمنين انما قلت : امير المءمنين شبيب ، اردت بك يا امير المءمنين فحقن دمه . خرج رجل علي عبد الله بن طاهر كان اصطنعه واحسن اليه : فحاربه عبد الله فظفر به ، فقال له : ما حملك علي ما صنعت مع احساني اليك ؟ فقال : حملني علي ذلك قولك ايها الامير : من المنسرح حتي متي تصحب الرجال ولا . . . تصحب يوما لامك الهبل فصفح عنه واعاده الي مرتبته وزاد في بره . مرت امراة من العرب بمجلس من مجالس نمير ، فرماها جماعة منهم بابصارهم ، فوقفت وقالت : يا بني نمير لا لامر الله اطعتم ولا لقول الشاعر  سمعتم ، قال الله عز وجل : قل للمءمنين يغضوا من ابصارهم النور :  ، وقال الشاعر : من الوافر فغض الطرف انك من نمير . . . فلا كعبا بلغت ولا كلابا قال : فما اجتمع منهم بعد في مجلس اثنان . انشد ابراهيم بن هرمة عبد الواحد بن سليمان بن عبد الملك بحضرة عبد الله بن الحسن بن الحسن شعرا يقول فيه : من الوافر وجدنا غالبا كانت جناحا . . . وكان ابوك قادمة الجناح فغضب عبد الله بن الحسن حتي انقطع زره ثم وثب مغضبا وتجوز ابن هرمة في الانشاد ثم لحقه فقال : جزاك الله خيرا يا ابن رسول الله ، فقال : ولكن لا جزاك الله خيرا يا ماص بظر امه ، اتقول لابن مروان وكان ابوك قادمة الجناح بحضرتي وانا ابن رسول الله صلي الله عليه وسلم وابن علي بن ابي طالب عليه السلام ؟ فقال ابن هرمة : جعلني الله فداك ، اني قلت قولا اخدعه به طلبا للدنيا ، ووالله ما قست بكم احدا قط ، او لم تسمعني قد قلت فيها : وبعض القول يذهب في الرياح . قال : فضحك عبد الله وقال له : قاتلك الله فما اطرفك . حجت سكينة بنت الحسين وعاءشة بنت طلحة ، وكانت عاءشة احسنهما الة وثقلا ، وكان معها ستون بغلا فحدا حادي عاءشة فقال : من الرجز عاءش يا ذات البغال الستين . . . لا زلت ما عشت كذا تحجين فشق ذلك علي سكينة فنزل حاديها فقال : من الرجز عاءش هذي ضرة تشكوك . . . لولا ابوها ما اهتدي ابوك  فامرت عاءشة حاديها فكف . عرض محمد بن واسع حمارا له علي البيع فقال له رجل : اترضاه لي ؟ فقال لو رضيته ما بعته . وهذا انما قال تحرجا وتحوبا وفيه جواب مسكت . دعا بعض القراء بعض الامراء باسمه فغضب وقال : اين الكنية لا ابا لك ؟ فقال : ان الله تعالي سمي احب الخلق اليه فقال : وما محمد الا رسول قد خلت من قبله الرسل ال عمران :  ، وكني ابغض الخلق اليه فقال : تبت يدا ابي لهب المسد :  . وناظر ابن الزيات رجلا فصالحه علي مال فقال له : عجله ، فقال : اظلم وتعجيل ؟ فقال ابن الزيات : اصلح وتاجيل ؟ كانت قبيحة ام المعتز تحرضه علي قتل الاتراك الذين قتلوا اباه ، وتبرز اليه قميصه المضرج بدمه ، فقال لها يوما : ارفعه والا صار القميص قميصين ، فما عادت لعادتها بعد ذلك . لما اراد هشام ان ينزل الرصافة قيل له : لا تخرج فان الخلفاء لا لا يطعنون ولم نر خليفة طعن ، قال : انتم تريدون ان تجربوني ، ونزل الرصافة وهي برية . واتي هشام بعود فقال للوليد بن يزيد : ما هذا ؟ قال : خشب يشقق ثم يرقق ثم يلصق ثم تعلق عليه اوتار فينطق فتضرب الكرام برءوسها الحيطان سرورا  به ، وما في المجلس الا من يعلم ما اعلمه وانت اولهم يا امير المءمنين . وقد قيل ان هذا الكلام للوليد بن مسعدة الفزاري مع عبد الملك بن مروان . ركب الرشيد لينظر الي هدايا بعث بها علي بن عيسي بن ماهان بعد صرف الفضل بن يحيي عن خراسان ، وجعفر بن يحيي يسايره ، فقال لجعفر : اين كان هذا ايام اخيك ؟ قال : في منازل اربابه ، فلم يحر جوابا . قال التوزي : كان رجل من ولد جرير في حلقة يونس بن حبيب ، وفيها رجل من بني شيبان ، وام جرير منهم ، فقال الجريري يفتخر علي الشيباني : من الطويل نمتني من شيبان ام نزيعة . . . كذلك ضرب المنجبات النزاءع اما والله  يا اخا بني شيبان  ما اخذناها الا باطراف الرماح . فقال الشيباني : صدقت والله ، لانت الام من ان يزوجوك بها طوعا او يرضوك لها كفءا . وقف الاسكندر علي ذيوجانس فقال : اما تخافني ؟ فقال : اخير اننت ام شر ؟ قال : بل خير . فقال ذيوجانس : فاني لا اخاف الخير بل احبه . سال رجل جاهل افلاطون : كيف قدرت علي كثرة ما تعلمت ؟ قال : لاني افنيت من الزيت اكثر مما افنيت من الشراب . تكلم صعصعة عند معاوية فعرق ، فقال : بهرك الكلام يا صعصعة ؟ فقال : الخيل الجياد نضاخة بالماء . نظر ثابت بن عبد الله بن الزبير الي اهل الشام فشتمهم ، فقال له سعيد بن عثمان بن عفان : تشتمهم لانهم قتلوا اباك ؟ قال : صدقت ، ولكن  المهاجرين والانصار قتلوا اباك . دخل معن بن زاءدة علي المنصور يقارب في خطوه ، فقال ابو جعفر : كبرت سنك يا معن ؛ قال : في طاعتك ؛ قال : وانك لجلد قال : علي اعداءك ، قال : وان فيك بقية ؛ قال : هي لك يا امير المءمنين . مر اعرابي بمجلس قوم فسخروا منه واستهزاوا به ، فرجع اليهم وقال : يا هءلاء ان الناس رجلان : متكلم غانم ، وساكت سالم ، فوالله ما سلمتم سلامة الصامت ، ولا غنمتم غنيمة المتكلم . قال عبد الله بن عباس : بعثني علي عليه السلام الي عاءشة ام المءمنين يامرها بالرحيل الي بلادها . فاتيتها فدخلت عليها فلم يوضع لي شء اجلس عليه ، فتناولت وسادة كانت في رحلها فقعدت عليها ، فقالت عاءشة : يا ابن عباس ، اخطات السنة : قعدت علي وسادتنا في بيتنا بغير اذننا ، فقلت : ما هذا بيتك ، بيتك الذي امرك الله سبحانه ان تقري فيه ، ولو كان بيتك ما قعدت علي وسادتك الا باذنك . ثم قلت : ان امير المءمنين عليا ارسلني اليك يامرك بالرحيل الي بلادك . قالت : واين امير المءمنين ؟ ذاك عمر . فقلت : ذاك عمر وعلي ايضا ، قالت : ابيت ابيت . قلت : اما والله ما كان اباءك الا قصير المدة ، عظيم التبعة ، قليل المنفعة ، ظاهر الشءم ، بين النكد ، وما عسي ان يكون اباءك وما كان امرك الا كحلب شاة حتي صرت ، لا تامرين ولا تنهين ، ولا تاخذين ولا تعطين ، وما كان مثلك الا كقول اخي بني امية حيث يقول : من الكامل ما زال اهداء الضغاءن بينهم . . . تتري الحديث وكثرة الالقاب حتي تركت كان صوتك بينهم . . . في كل مجمعة طنين ذباب  قال : فبكت حتي سمعت نحيبها من وراء الحجاب ، ثم قالت : اني معجلة الرحيل الي بلادي ان شاء الله ، والله ما من بلد ابغض الي من بلد انتم فيه . قال : ولم ذاك ؟ فوالله لقد جعلنا اباك صديقا ، قالت : يا ابن عباس ، اتمن علي برسول الله صلي الله عليه وسلم ؟ فقلت : ما لي لا امن عليك بمن لو كان منك لمننت علي . وقال بعض اصحاب الرشيد : كنت واقفا علي راس الرشيد وقد دخل عليه عبد الملك بن صالح ، فاقبل عليه الرشيد فقال : كاني انظر الي شءبونها وقد لمع ، والي غبارها وقد سطع ، والي الوعيد وقد اوري نارا ، وقد كشف عن لهازم بلا حلاقم ورءوس بلا غلاصم ، فمهلا مهلا يا بني هاشم ، لا تستوعروا السهل ولا تستسهلوا الوعر ، ولا تبطروا النعم ، ولا تستجلبوا النقم ، فعن قليل يذم ذو الراي منكم رايه ، وينكص ذو الحزم منكم عقبيه ، وتستبدلوا الذل بعد العز ، وتستشعروا الخوف بعد الامن . فقال عبد الملك : يا امير المءمنين ، افذا اتكلم ام تواما ؟ قال : بل فذا ؛ قال : ان لله عليك حقا فيما ولاك فاده ، واحفظه في رعيته ، ولا تجعل الكفر في موضع الشكر ، ولا العقاب موضع الثواب ، ولا تقطع رحمك التي اوجب الله عليك صلتها ، والزمك حقها ، ونطق الكتاب بها ، فان عقوقها كفر ؛ وجاز ذا الحق علي حقه ، ولا تصرف الحق الي غير اهله ؛ جمعت عليك القلوب بعد افتراقها ، وسكنتها بعد نفارها ، وشددت اواخي ملكك باشد من اركان يلملم ، وكنت كما قال اخو بني جعفر ابن كلاب : من الرمل ومقام ضيق فرجته . . . بلساني ومقامي وجدل  لو يقوم الفيل او فياله . . . زل عن مثل مقامي وزحل فقال الرشيد : هذا ابنك يخبرنا عنك بمعصيتك وشقاقك . قال : ليس يخلو ابني من ان يكون مامورا او عدوا ، فان كان مامورا فمعذورا وعدوا فمحذورا ، وقد قال الله تعالي : ان من ازواجكم واولادكم عدوا لكم فاحذروهم التغابن :  ، قال : فهذا كاتبك قمامة بن يزيد يخبر بمثل ذلك ، وقد سال ان يجمع بينك وبينه ، قال : ان من كذب علي واشاظ بدمي غير مامون ان يبهتني ، وخرج . قال ابن مروان لابي يوسف القزويني الفقيه الحنفي وقد اراه سور امد وعجبه من حصانته واحكامه : كيف تراه ؟ فقال له ابو يوسف : يحفظك بالليل ، ويرد عنك السبل ، ولا يحجب عنك دعوة المظلوم . كان احمد بن يوسف يكتب بين يدي المامون ، فطلب منه السكين فدفعها اليه والنصاب في يده ، فنظر اليه المامون نظر منكر ، فقال : علي عمد فعلت ذلك ، ليكون الحد علي اعداءك . فعجب الناس من سرعة جوابه وشدة فطنته . وقال المامون لاحمد بن يوسف : ان اصحاب الصدقات تظلموا منك ، فقال : والله ، يا امير المءمنين ، ما رضي اصحاب الصدقات عن رسول الله صلي الله عليه وسلم حتي انزل الله تعالي فيهم : ومنهم من يلمزك في الصدقات فان اعطوا منها رضوا وان لم يعطوا منها اذا هم يسخطون التوبة :  ، فكيف يرضون عني ؟ فاستضحك المامون وقال له : تامل احوالهم واحسن النظر في امرهم .  لما ولي يحيي بن اكثم قضاء البصرة استصغروا سنه ، فقال له رجل : كم سن القاضي اعزه الله ؟ سن عتاب بن اسيد حين ولاه رسول الله صلي الله عليه وسلم مكة ، فجعل جوابه احتجاجا . قيل لابن شبرمة : لم تركت النبيذ ؟ فقال : ان كان حلالا فحظي تركت ، وان كان حراما فبالحزم اخذت . لما قال النابغة الجعدي في ليلي الاخيلية من ابيات : من الطويل الا حييا ليلي وقولا لها هلا . . . فقد ركبت ايرا اغر محجلا وقد اكلت بقلا وخيما نباته . . . وقد شربت من اخر الليل ايلا يعني البان الايل وقد تورث الغلمة اجابته ليلي من ابيات : من الطويل تعيرني داء بامك مثله . . . واي حصان لا يقال لها هلا فغلبته . لما قال الوليد بن عقبة بن ابي معيط حين قتل عثمان رضي الله عنه ابياته المشهورة التي من جملتها : من الطويل هم قتلوه كي يكونوا مكانه . . . كما غدرت يوما بكسري مرازبه اجابه الفضل بن العباس بن عتبة بن ابي لهب بابيات منها يقول : من الطويل وشبهته كسري وقد كان مثله . . . شبيها بكسري هديه وعصاءبه  ارسل ابو ذءيب الهذلي خالد بن زهير الي امراة بينه وبينها خلة ، فافسدها خالد لنفسه ، وكان ابو ذءيب من قبل قد فعل مثل ذلك مع عويمر بن مالك بن عويمر ، فلما عرف ابو ذءيب ما فعله خالد كتب اليه بابيات منها : من الطويل خليلي الذي دلي لغي خليلتي . . . جهارا وكل قد اصاب غرورها ونفسك فاحفظها ولا تفش للعدي . . . من السر ما يطوي عليه ضميرها فاجابه خالد بن زهير : من الطويل فلا تجزعن من سيرة انت سرتها . . . فاول راض من يسيرها اي جعلتها ساءرة . ويروي من سنة وعلي هذه الرواية يروي من يسيرها بضم اوله ، وفي ذلك يقول ابو ذءيب : من الطويل تريدين كيما تجمعيني وخالدا . . . وهل يجمع السيفان ويحك في غمد شبب الاحوص بن محمد الانصاري بام جعفر ، وهي امراة من الانصار ، وشاع شعره فيها ، فاوعده اخوها ايمن وتهدده فلم ينته ، فاستعدي عليه عمر بن عبد العزيز ، فربطهما في حبل ودفع اليهما سوطين وقال لهما : تجالدا ، فغلب اخوها وسلح الاحوص في ثيابه وهرب ، وتبعه ايمن حتي فاته الاحوص هربا . وانما فعل ذلك عمر اقتداء بعثمان بن عفان ، فانه لما تهاجي سالم بن دارة ومرة بن رافع الغطفاني لزمهما عثمان بحبل واعطاهما سوطين فتجالدا بهما .  وكان الاحوص قال في ام جعفر من ابيات : من الطويل لقد منعت معروفها ام جعفر . . . واني الي معروفها لفقير فقال الساءب احد بني عمرو بن عوف يعيره فراره ويعارضه في هذه الابيات : من الطويل لقد منع المعروف من ام جعفر . . . اخو ثقة عند الجلاد صبور علاك بمتن السوط حتي اتقيته . . . باصفر من ماء الصفاق يفور فقال الاحوص : من الطويل اذا انا لم اغفر لايمن ذنبه . . . فمن ذا الذي يغفر له ذنبه بعدي اريد انتقام الذنب ثم ترده . . . يد لادانيه مباركة عندي هجا الاخطل سويد بن منجوف فقال : من الطويل وما جذع سوء خرق السوس متنه . . . لما حملته واءل بمطيق فقال سويد : والله يا ابا مالك ما تحسن ان تهجو ولا تمدح . اردت هجاءي فمدحتني ، جعلت واءلا تحملني امورها وما طمعت في بني ثعلبة فضلا عن بكر . طعن عامر بن الطفيل ضبيعة بن الحارث فقال ضبيعة :  من الكامل لولا اعتراض في الاغر وجراة . . . لفعلت فاقرة بجيش سعيد فقال عامر : يعجز عن فرسه ويتوعدني . انشد جرير قول الاخطل : من الطويل واني لقوام مقاوم لم يكن . . . جرير ولا مولي جرير يقومها فقال : صدق ، انا لا اقوم عند است قس لاخذ القربان ولا بين يدي سلطان لاداء الجزية . انشد رجل يحيي بن خالد : من البسيط اني امرء في اعالي بيت مكرمة . . . اذا تمزق ثوبي ارتدي حسبي فقال يحيي : ما اقل غناء هذا الرداء في كانونين . قصد شاعر ابا دلف فقال له : ممن انت ؟ قال : من بني تميم ، فقال ابو دلف : من الذين يقول فيهم الشاعر : من الطويل تميم بطرق اللءم اهدي من القطا قال : نعم ، بتلك الهداية جءتك ؛ فخجل ابو دلف واسكتمته واحسن جاءزته . لما قتل مسلمة بن عبد الملك يزيد بن المهلب قال ثابت قطنة يرثيه : من الكامل يا ليت اخوتك الذين تغيبوا . . . كانوا ليومك بالعراق شهودا  فقال مسلمة : وانا والله وددت حتي اسقيهم بكاسه . لما اسلمت بنت شيبة بن ربيعة قالت هند بنت عتبة لها : من الوافر تدين مع الاولي قتلوا اباها . . . اقتل ابيك جاءك باليقين فقالت : نعم قتله جاءني باليقين . عرض بلال بن ابي بردة الجند ، فمر به رجل من بني نمير ومعه رمح قصير ، فقال له بلال : يا اخا بني نمير ما انت كما قال الشاعر : من الوافر لعمرك ما رماح بني نمير . . . بطاءشة الصدور ولا قصار فقال : اصلح الله الامير ما هو لي انما استعرته من رجل من الاشعريين . بصر الفرزدق بجرير محرما فقال : والله لافسدن علي ابن المراغة حجه ، ثم جاءه مستقبلا وقال : من الطويل فانك لاق بالمشاعر من مني . . . فخارا فخبرني بمن انت فاخر فقال جرير : لبيك اللهم لبيك . قال الحسن بن قحطبة : دخلت علي المهدي بعيساباذ فدخل شريك القاضي فسلم ، فقال المهدي : لا سلم الله عليك يا فاسق ، فقال شريك : ان للفاسق علامات تعرف : شرب الخمور واتخاذ القينات والمعازف . قال : قتلني الله ان لم اقتلك . قال : ولم يا امير المءمنين ؟ قال : رايت في المنام كاني مقبل عليك اكلمك وانت تكلمني من قفاك . فقال لي  المعبر : هذا رجل يطا بساطك وهو مخالف لك . فقال شريك : ان رءياك ليست كرءيا يوسف بن يعقوب ، وان دماء المسلمين لا تستحل بالاحلام . فنكس المهدي راسه ثم اشار اليه ان اخرج ، فخرج وخرجت خلفه . فقال لي : ما رايت ما اراد صاحبك ان يفعل ؟ فقلت : اسكت فلله ابوك . جاء رجل الي شريح فكلمه بشء واخفاه ، فلما قام قال له رجل : يا ابا امية ، ما قال لك ؟ قال : يا ابن اخي اما رايته اسره منك ؟ وقيل للشعبي  وقد بني باهله  : كيف وجدت اهلك ؟ قال : ولم ارخيت الستور اذن . دعا الرشيد ابا يوسف ليلا فساله عن مسالة فافتاه ، فامر له بماءة الف درهم ، فقال : ان راي امير المءمنين ان يامر بتعجيلها قبل الصبح ، فقال : عجلوها له ، فقيل ان الخازن في بيته والابواب مغلقة ، فقال ابو يوسف : وقد كنت في بيتي والدروب مغلقة ، فحين دعاني فتحت . قال عبيد الله بن زياد لبعض بني بكر بن واءل : ما تقول فينا وفي الحسين وفي قتلنا اياه ؟ فقال : ما اقول ، يجء جده يوم القيامة فيشفع له ويجء جدك فيشفع لك . كان ابو الاسود يتشيع ، وكان ينزل في بني قشير وهم عثمانية ، فكانوا يرمونه بالليل ، فاذا اصبح شكا ذلك . فشكاهم مرة فقالوا له : ما نحن نرميك ولكن الله يرميك ، فقال : كذبتم لو كان الله يرميني لما اخطاني .  كان بعض اهل البصرة يتشيع ، وكان له صديق يفد اليه ويوافقه علي مذهبه ، فاودعه مالا فجحده ، فاضطر الي ان قال لمحمد بن سليمان ، وساله ان يحضره ويحلفه بحق علي ففعل ذلك . فقال الرجل : اعز الله الامير ، هذا الرجل صديقي وهو اعز علي واجل من ان احلف له بالبراءة من مختلف في ولايته وايمانه ، ولكني احلف له بالبراءة من المتفق علي ايمانهما وولايتهما ابي بكر وعمر . فضحك محمد بن سليمان ، والتزم المال ، وخلي الرجل . دخل ابو الطفيل عامر بن واثلة الكناني علي معاوية فقال له : انت من قتلة عثمان ؟ قال : لا ولكني ممن حضره فلم ينصره ، قال : وما منعك من نصره ؟ قال : لم ينصره المهاجرون والانصار ؛ قال معاوية : لقد كان حقه واجبا وكان يجب عليهم ان ينصروه ، قال : فما منعك يا امير المءمنين من نصرته ومعك اهل الشام ؟ قال : او ما طلبي بدمه نصرة له ؟ فضحك عامر وقال : انت والله وعثمان كقوله : من البسيط لا اعرفنك بعد الموت تندبني . . . وفي حياتي ما زودتني زادي فقال له معاوية : دع عنك هذا وقل لي ما بقي الدهر من ثكلك علي بن ابي طالب ؟ قال : ثكل العجوز المقلات والشيخ الرقوب ، قال : كيف حبك له ؟ قال : حب ام موسي لموسي ، والي الله اشكو التقصير . اتي الحجاج بامراة من الخوارج فقال لمن حضره : ما ترون فيها ؟ قالوا اقتلها . فقالت : جلساء اخيك خير منك ومن جلساءك قال : ومن اخي ؟ قالت : فرعون ، لما شاور جلساءه في موسي قالوا : ارجه واخاه وارسل في المداءن حاشرين الاعراف :  .  اتي عتاب بن ورقاء بامراة من الخوارج ، فقال لها : يا عدوة الله ما دعاك الي الخروج ؟ اما سمعت الله تبارك وتعالي يقول : من الخفيف كتب القتل والقتال علينا . . . وعلي الغانيات جر الذيول قالت : يا عدو الله ، اخرجني قلة معرفتك بكتاب الله تعالي . قال المنصور لبعض الخوارج وقد ظفر به : عرفني من اشد اصحابي اقداما كان في مبارزتك ؟ قال : ما اعرفهم بوجوههم ولكني اعرف اقفاءهم ، فقل لهم يدبروا حتي اصفهم ؛ فاغتاظ وامر بقتله . قال الحجاج لرجل من الخوارج : والله اني لابغضكم ، فقال الخارجي : ادخل الله اشدنا بغضا لصاحبه الجنة . خفف اشعب الصلاة مرة ، فقال له بعض اهل المسجد : خففت الصلاة جدا ، قال : لانه لم يخالطها رياء . عاد المعتصم ابا الفتح ابن خاقان ، والفتح صغير ، فقال له : داري احسن ام دار ابيك ؟ قال : يا امير المءمنين ، دار ابي ما دمت فيها . اجتاز عمر بن الخطاب رضي الله عنه بصبيان يلعبون وفيهم عبد الله بن الزبير ، فتهاربوا الا عبد الله ، فانه وقف . فقال له عمر : لم لم  تفر مع اصحابك ؟ قال : لم يكن لي جرم فافر منك ، ولا كان الطريق ضيقا فاوسعه عليك . اتي الحجاج باعرابي في امر احتاج الي مساءلته عنه ، فقال الحجاج : قل الحق والا قتلتك ، فقال له : اعمل به انت ، فان الذي امرك بذلك اقدر عليك منك علي ، فقال الحجاج : صدق . فخلوه . قدم اعرابي علي سلطان ومعه قصة ، فجعل يقول : هاءم اقراوا كتابيه ، فقيل له : هذا يقال يوم القيامة ، فقال : هذا شر من يوم القيامة ، انه يءتي يوم القيامة بحسناتي وسيءاتي ، وانتم جءتم بسيءاتي وتركتم حسناتي . حلف اعرابي بالمشي الي بيت الله الحرام لا يكلم ابنه ، فحضرته الوفاة ، فقيل له : كلمه قبل ان تفارق الدنيا ، فقال : والله ما كنت قط اعجز عن المشي الي بيت الله تعالي مني الساعة . قيل لاعرابي ينسج : الا تستحي ان تكون نساجا فقال : انما استحي من ان اكون اخرق لا انفع اهلي . مد المامون يده الي اعرابي ليقبلها ، فتناولها بكمه ، فقال : اتتقزز منها ؟ قال : لا بل اتقزز لها . قال رجل : رايت اعرابيا في ابل قد ملات الوادي ، فقلت : لمن هذه ؟ قال : لله في يدي . سال اعرابي فقيل له : بورك فيك ، وتوالي عليه ذلك من غير  مكان فقال : وكلكم الله الي دعوة لا تحضرها نية . سالت اعرابية المنصور في طريق مكة فحرمها ، فقالت : من الطويل اذا لم يكن فيكن ظل ولا جني . . . فابعدكن الله من شجرات وسالته اخري فمنعها ، فقالت : من الطويل دنوك ان كان الدنو كما اري . . . علي وبعد الدار يستويان قيل لجاذوسيس الصقلي : انك من مدينة خسيسة ، قال : اما انا فيلزمني العار من قبل بلدي ، واما انت فعار لازم لاهل بلدك . وعير اخر سقراط ببلده ، فقال سقراط : نسبي مني ابتدا ، ونسبك اليك انتهي . قيل : طاف الرشيد بالبيت فوطء جرادة ، فلم يدر ما عليه فيها ، فبعث بالمامون الي الفضيل بن عياض فسلم عليه وقال : يا امير المءمنين يقرا عليك السلام ويقول لك : لنا اليك حاجة ، فاحب ان تعبر الينا . فلم يجب الفضيل بشء ، فرجع المامون وقال : رايت رجلا ليست به اليك حاجة ، فقام الرشيد مغضبا حتي خيف علي الفضيل منه ؛ فوقف عليه وسلم ، فوسع الفضيل له ورد عليه السلام . فلما جلس اقبل علي الفضيل فقال : رحمك الله ، قد كان الواجب ان تاتينا وتعرف حقنا اذ ولانا الله اموركم فصيرنا الحكام في دماءكم ، والذابين عن حريمكم ، واذ لم تاتنا فقد اتيناك ؛ اني وطءت الان في الطواف علي جندبة  فما ديتها ؟ قال : فبكي الفضيل بكاء شديدا حتي علا صوته وقال : اذا كان الراعي يسال عن الغنم هلكت الغنم ، وانما يجب علي الراعي ان يرتاد لغنمه المرعي ، وجيد الكلا ، وعذب الماء ، فاذا كنت يا امير المءمنين تسالني عن معالم الدين فباي شء تسوس رعيتك ؟ قال : فخجل الرشيد حتي عرق وانصرف . ومما وضع علي لسان البهاءم : قالوا : عير الثعلب لبءة بانها لم تلد في عمرها الا جروا واحدا ، فقالت : نعم الا انه اسد . وقالوا : صحب ذءب وثعلب اسدا فاصطادوا عيرا وظبيا وارنبا . فقال الاسد للذءب : اقسم هذا بيننا ، فقال : العير لك ، والظبي لي ، والارنب للثعلب . فغضب الاسد واخذ بحلق الذءب حتي قطع راسه ، وقال للثعلب : اقسمه انت ، فقال : العير لغداءك ، والظبي لعشاءك ، والارنب تفكه به في الليل ، فقال : من علمك هذه القسمة العادلة ؟ قال : راس الذءب الذي بين يديك . قالوا : تعلق ذءب بعوسجة ليصعد حاءطا فعقرته ، فاقبل يلومها فقالت : يا هذا لم نفسك في التعلق ، فما يتعلق بكل شء . كان ابو ايوب المورياني ، وزير المنصور ، اذا دعاه المنصور يصفر ويرعد مع مكانه منه ومحله عنده . فقيل له في ذلك ، فقال : مثلي ومثلكم في هذا مثل باز وديك تناظرا ، فقال البازي : ما اعرف اقل وفاء منك ، قال : وكيف ذلك ؟ قال : تءخذ بيضة فيحضنك اهلك ، وتخرج علي ايديهم فيطعمونك باكفهم ويحسنون اليك ، حتي اذا وجدت منهم غفلة طرت وصحت وعلوت  الحيطان ، وفارقت الدار التي ربيت بها وطرت الي غيرها ؛ وانا اوخذ من الجبال فاوثق وتخاط عيني ، واطعم الشء اليسير ، واونس يوما او يومين ثم اطلق علي الصيد ، فاطير وحدي ، واخذ الصيد لصاحبي ، وامسكه عليه ، واعود الي مكاني . فقال له الديك : ذهب عليك الصواب ، انت والله لو رايت علي السفافيد من البزاة اليسير من الكثير الذي اراه انا من الديكة ما عدت قط اليهم . ولكن لو عرفتم من المنصور ما اعرفه لكنتم اسوا حالا مني عند طلبه لكم . تهاجي عبد الرحمن بن حسان بن ثابت وعبد الرحمن بن الحكم فافحشا ، فكتب معاوية الي سعيد بن العاص ، وهو عامله علي المدينة ، ان يجلد كل واحد منهما ماءة سوط ؛ وكان ابن حسان صديقا لسعيد ، وما مدح احدا قط غيره ، فكره ان يضربه او يضرب ابن عمه ، فامسك عنهما ؛ ثم ولي مروان بن الحكم فضرب ابن حسان ماءة سوط ولم يضرب اخاه . فكتب ابن حسان الي النعمان بن بشير وهو عند معاوية فعرفه . فعزم معاوية علي مروان ان يضرب اخاه ماءة ، فسال مروان الانصار سءال ابن حسان ان يعفو فابي ، فطلبوا اليه ان يقتصر علي خمسين ففعل . فلقي ابن حسان بعض من كان لا يهوي ما ترك من ذلك ، فقال : ضربك ماءة وتضرب خمسين ، بءس ما صنعت اذ وهبتها له ، فقال : انه عبد وانما يضرب العبد نصف ما يضرب الحر ، فحمل هذا الكلام حتي شاع في المدينة ، فبلغ ابن الحكم فشق عليه واتي اخاه مروان واخبره الخبر ، فقال : فضحني لا حاجة لي فيما ترك ، فهلم فاقتص ، فضرب ابن الحكم خمسين اخري . روي ان امراة ابي الاسود خاصمته الي زياد في ولدها ، فقالت : ايها الامير ، ان هذا يريد ان يغلبني علي ولدي ، وقد كان بطني له وعاء ، وثديي له سقاء ، وحجري له فناء ؛ فقال ابو الاسود : بهذا تريدين ان تغلبيني علي  ولدي ، فوالله لقد حملته قبل ان تحمليه ، ووضعته قبل ان تضعيه ؛ قالت : لا سواء ، انك حملته خفا وحملته ثقلا ، ووضعته شهوة ووضعته كرها . فقال له زياد اني اري امراة عاقلة يا ابا الاسود ، فادفع اليها ابنها فاخلق ان تحسن ادبه . لما حبس الحلاج عند القشوري مرض ابن له فاشتهي التفاح الشامي ، وكان لا يصاب لفوت اوانه ، فتلطف الحلاج واحتال حتي ساله القشوري تفاحة شامية ، قصد بها تعرف امر الحلاج في صدقه وكذبه ، واراد ايضا بلوغ مراده في ولده ، وكان الحلاج قد اعد تفاحة لذلك ، فحين ساله اومي بيده هكذا واعادها بتفاحة ، وتناولها القشوري يقلبها ويتعجب منها ، والحلاج يقول : الساعة قطعتها من الجنة ، قال القشوري : اني اري في موضع منها عيبا ، قال الحلاج  غير مطرق ولا مكترث  : اما علمت انها اذا اخرجت من دار البقاء الي دار الفناء لحقها جزء من البلاء ، فكان جوابه احسن من حيله وفعله . وكان كثير قصيرا لا يبلغ ضروع الابل ، فقال له جرير : اي رجل انت لولا دمامتك ؟ فال كثير : من الطويل ان اك قصدا في الرجال فانني . . . اذا حل امر ساحتي لطويل روي ان عزة قالت لبثينة : تصدي لكثير واطمعيه في نفسك حتي اسمع ما يجيبك به ؛ ثم اقبلت اليه وعزة تمشي وراها متخفية وعرضت عليه الوصل فقاربها ، ثم قال : من الطويل رمتني علي فوت بثينة بعدما . . . تولي شبابي وارحن شبابها بعينين نجلاوين لو رقرقت بها . . . لنوء الثريا لاستهل ربابها  فكشفت عزة عن وجهها ، فبادرها الكلام ثم قال : ولكنما ترمين نفسا مريضة . . . لعزة منها صفوها ولبابها فضحكت ثم قالت : اولي لك بها نجوت ، وانصرفتا تتضاحكان . قال يزيد بن عروة : لما مات كثير لم تتخلف امراة بالمدينة ولا رجل عن جنازته ، وغلب النساء عليها يبكينه ويذكرن عزة في ندبهن له ، فقال ابو جعفر محمد بن علي : افرجوا لي عن جنازة كثير لارفعها ، قال : فجعلنا ندفع النساء عنها ، وجعل محمد بن علي يضربهن بكمه ويقول : تنحين يا صواحبات يوسف . فانتدبت له امراة منهن فقالت : يا ابن رسول الله لقد صدقت ، انا لصواحباته وقد كنا خيرا منكم له ، فقال ابو جعفر لبعض مواليه : احتفظ بها حتي تجيءني بها اذا انصرفت . قال فلما انصرف اتي بتلك المراة كانها شرر النار ، فقال لها محمد بن علي : انت القاءلة : انكن ليوسف خير منا ؟ قالت : نعم ، تءمنني غضبك يا ابن رسول الله ؟ قال : انت امنة من غضبي فانبءيني . قالت : نحن  يا ابن رسول الله  دعوناه الي اللذات من المطعم والمشرب والتمتع والتنعم ، وانتم معاشر الرجال القيتموه في الجب وبعتموه بابخس الاثمان ، وحبستموه في السجن ، فاينا كان عليه احني وبه اراف ؟ فقال محمد : لله درك ، لن تغالب امراة الا غلبت ، ثم قال لها الك بعل ؟ قالت : لي من الرجال من انا بعله ، فقال ابو جعفر : ما اصدقك ، مثلك من تملك زوجها ولا يملكها ، قال : فلما انصرفت قال رجل من القوم : هذه بنت فلانة بنت معيقيب . اخبر كثير عن قطام صاحبة ابن ملجم في قدمة قدمها الكوفة ، فاراد الدخول اليها ليوبخها ، فقيل له : لا تردها فان لها جوابا ، فابي كثير واتاها ؛ فوقف علي بابها وقرعه ، فقالت : من هذا ؟ كثير بن عبد الرحمن  الشاعر ، فقالت لبنات عم لها تنحين حتي يدخل الرجل ، فولجن البيت ، واذنت له فدخل ، وتنحت من بين يديه فراها وقد ولت ، فقال لها : انت قطام ؟ فقالت : نعم قال : صاحبة علي بن ابي طالب عليه السلام ؟ قالت : صاحبة عبد الرحمن بن ملجم ، قال : اليس فيك قتل علي بن ابي طالب ؟ قالت : بل مات باجله ، قال : ام والله لقد كنت احب ان اراك ، فلما رايتك نبت عيني عنك ، فما احلوليت في صدري ، قالت : والله انك لقصير القامة ، عظيم الهامة ، قبيح المنظر ، وانك لكما قال الاول : تسمع بالمعيدي خير من ان تراه ، فقال : من الطويل رات رجلا اودي السفار بوجهه . . . فلم يبق الا منظر وجناجن فان اك معروق العظام فانني . . . اذا وزن الاقوام بالقوم وازن واني لما استودعتني من امانة . . . اذا ضاعت الاسرار للسر دافن فقالت : انت لله ابوك كثير عزة ؟ قال : نعم ، فقالت : الحمد لله الذي قصر بك فصرت لا تعرف الا بامراة ، قال : ليس الامر كذلك ، والله لقد سار بها شعري ، وطار بها ذكري ، وقرب من الخليفة مجلسي ، وانها لكما قلت : من الطويل فما روضة بالحزن طيبة الثري . . . يمج الندي جثجاثها وعرارها باطيب من اردان عزة موهنا . . . وقد اوقدت بالمندل الرطب نارها فان خفيت كانت لعينك قرة . . . وان تبد يوما لم يغمك عارها فقالت : تاالله ما رايت شاعرا قط انقص عقلا ولا اضعف وصفا منك حيث تقول هذا ، الا قلت كما قال امرء القيس : من الطويل الم ترياني كلما جءت طارقا . . . وجدت بها طيبا وان لم تطيب فخرج وهو يقول : من الكامل  الحق ابلج لا تخيل سبيله . . . والحق يعرفه ذوو الالباب حج سليمان بن عبد الملك ومعه الشعراء ، فمر بالمدينة منصرفا ، فاتي باسراء من الروم نحو من اربعماءة اسير . فقعد سليمان وعنده عبد الله بن الحسن ابن الحسن بن علي عليهم السلام ، وعليه ثوبان ممصران ، وهو اقربهم منه مجلسا ، فادنوا اليه بطريقهم وهو في جامعة ، فقال لعبد الله بن الحسن : قم فاضرب عنقه فقام فما اعطاه احد سيفا حتي دفع اليه حرسي سيفا كليلا ، فضربه فابان عنقه وذراعه واطن ساعده وبعض الغل ، فقال له سليمان : اجلس ، فوالله ما ضربته بسيفك ولكن بحبسك ، وجعل يدفع الاسراء الي الوجوه فيقتلونهم ، حتي دفع الي جرير رجلا ، فدست اليه بنو عبس سيفا قاطعا في قراب ابيض ، فضربه فابان راسه ؛ فدفع الي الفرزدق اسيرا ، فدست اليه القيسية سيفا كليلا ، وقيل بل دفع اليه سليمان سيفا وقال : اقتله به ، فقال : لا ، اضربه بسيف مجاشع ، واخترط سيفه فضربه فلم يغن شيءا ، فقال له سليمان ام والله لقد بقي عليك عارها وشنارها ، فقال جرير قصيدة يهجوه فيها ، منها في المعني : من الطويل بسيف ابي رغوان سيف مجاشع . . . ضربت ولم تضرب بسيف ابن ظالم ضربت به عند الامام فارعشت . . . يداك وقالوا محدث غير صارم وقيل : ان الفرزدق قال لسليمان : يا امير المءمنين هب لي هذا الاسير ، فوهبه له ، فاعتقه وقال : من الطويل فهل ضربة الرومي جاعلة لكم . . . ابا عن كليب او ابا مثل دارم كذاك سيوف الهند تنبو ظباتها . . . وتقطع احيانا مناط التماءم ولا نقتل الاسري ولكن نفكهم . . . اذا اثقل الاعناق حمل المغارم وروي انه سبق جريرا الي البيتين الاولين المذكورين ، وقال : كاني بابن  المراغة قد قال كذا ؛ فما لبث الا مدة يسيرة حتي جاءته القصيدة وفيها البيتان . ومن اجوبة الفرزدق المستحسنة في هذه القصيدة ، وعرض بسليمان لان بني عبس اخواله : من الطويل فان يك سيف خان او قدر اتي . . . بتعجيل نفس حتفها غير شاهد فسيف بني عبس وقد ضربوا به . . . نبا بيدي ورقاء عن راس خالد وقوله ايضا : من البسيط فما نبا السيف عن جبن ولا دهش . . . عند الامام ولكن اخر القدر ولو ضربت به عمدا مقلده . . . جمع اليدين ولا الصمصامة الذكر قال ابو العيناء : نظر المامون الي يحيي بن اكثم يلحظ خادما له ، فقال للخادم : تعرض له اذا قمت ، فاني ساقوم للوضوء ، وامره ان لا يبرح ، وعد الي بما يقول لك ، فلما قام غمزه الخادم بعينه ، فقال يحيي : لولا انتم لكنا مءمنين سبا :  فمضي الخادم الي المامون فاخبره ، فقال له : عد اليه فقل له : انحن صددناكم عن الهدي بعد اذ جاءكم بل كنتم مجرمين سبا :  فخرج اليه الخادم وقال له ذلك ، فاطرق يحيي وكاد يموت جزعا ، فخرج المامون وهو يقول : من الطويل  متي تصلح الدنيا ويصلح اهلها . . . وقاضي قضاة المسلمين يلوط قم واتق الله واصلح دينك . لما هجا يزيد بن مفرغ بني زياد فافحش ، وظفر به عبيد الله امر به فسقي نبيذا حلوا قد خلط معه الشبرم فاسهل بطنه ، وطيف به وهو علي تلك الحال ، وقرن به هر وخنزير ، فجعل يسلح والصبيان يقولون : اين جست ؟ فيقول : انست ونبيذ است وعصارة زبيب است وسمية روسبي است ، وجعل كلما جر الخنزير ضغت فيقول : من البسيط ضجت سمية لما لزها قرني . . . لا تجزعي ان شر الشيمة الجزع فلما خافوا عليه الهلاك امر به ان يغسل ، فلما غسل قال : من الخفيف يغسل الماء ما صنعت وقولي . . . راسخ منك في العظام البوالي لما وقع التباين بين محمد بن عبد الملك الزيات واحمد بن ابي دواد في ايام الواثق ، وسعي كل واحد منهما بصاحبه ، دخل يوما محمد بن عبد الملك دار الواءق وابن ابي دواد هناك ، فلما راه وثب يصلي صلاة الضحي ، فقال محمد بن عبد الملك وانشدها يسمعه : من الكامل صلي الضحي لما استفاد عداوتي . . . واراك تنسك بعدها وتصوم لا تعدمن عداوة من واحد . . . تركتك تقعد بعدها وتقوم مات رجل واوصي الي ابي حنيفة وهو غاءب ، فقدم ابو حنيفة وارتفع الي ابن شبرمة ، وادعي الوصية واقام البينة ، فقال له ابن شبرمة : يا ابا حنيفة ، احلف ان شهودك شهدوا بحق ، قال : ليس علي يمين ، كنت غاءبا ، قال : ضلت مقاليدك يا ابا حنيفة ، قال : ضلت مقاليدي ؟ ما تقول في اعمي شج  فشهد له شاهدان ان فلانا شجه ، اعلي الاعمي يمين ان شهوده شهدوا بحق وهو لا يري ؟ قال اعرابي لعبد الملك : الناقة اذا كانت تمنع الحلب قومتها العصا ، قال : اذن تكفا الاناء وتكسر انف الحالب . اجتمع شريك بن عبد الله ويحيي بن عبد الله بن الحسن في دار الرشيد ، فقال يحيي لشريك : ما تقول في النبيذ ؟ قال : حلال ، قال : فقليله ام كثيره ؟ قال : بل قليله ، قال : ما رايت خيرا قط الا والازدياد منه خير الا خيرك هذا فان قليله خير من كثيره . كتب ملك الروم الي الرشيد : اني متوجه اليك بكل صليب في مملكتي وكل بطل في جندي ، فوقع الرشيد في كتابه : وسيعلم الكافر لمن عقبي الدار . قال ابو حنيفة : قال لي حماد بن ابي سليمان : اذا سءلت عن معضلة فاقلبها سءالا علي ساءلك حتي تتخلص من مسالته ، قال : فدس الي رجل علي الباب وانا عند ابن هبيرة قد امر بي الي السجن ، فتبعني الرجل الي السجن فقال لي : يا ابا حنيفة يحل للرجل اذا امره السلطان الاعظم بقتل رجل ان يقتله ؟ قال ، قلت : وكان الرجل ممن وجب عليه القتل ؟ قلت : ان السلطان الاعظم لا يامر بقتل من لا يستحق عليه القتل .  قال موسي بن عبد الله بن الحسن لامراته ام سلمة وكانت من ولد ابي بكر الصديق : من الطويل اني زعيم ان اجء بضرة . . . فراسية فراسة للضراءر فقال الربيع بن سليمان مولي الحسينيين : من الطويل ابنت ابي بكر تريد بضرة . . . لعمري لقد حاولت احدي الكباءر اعتق عمر بن عتبة غلاما كبيرا ، فقال له عبد صغير : اذكرني يا مولاي ذكرك الله بخير ، فقال : انك لم تخرف ؟ فقال : ان النخلة تجتني زهوا قبل ان تصير معوا ، فقال : قاتلك الله لقد استعتقت فاحسنت ، وقد وهبتك لواهبك ، كنت امس لي واليوم مني . المعو : الجني الرطب ، وجاء عن العرب عشر كلمات عينها عين ولا مها واو  البعو : الجناية ، الجعو : الطين ، الدعو : مصدر دعا يدعو ، السعو : الشمع ، والسعو ايضا الرجل الضعيف ، وهو ايضا طاءر اصغر من العصفور ، القعو : من البكرة ، اللعو : الحريص والذءب في بعض اللغات ، والمعو : وقد ذكر ، النعو : الشق في مشفر البعير . 
  نوادر من هذا الباب
 قال نصر بن سيار بخراسان لاعرابي : هل اتخمت قط ؟ قال : اما من طعامك وطعام ابيك فلا . فيقال ان نصرا حم من هذا الجواب اياما ، وقال : ليتني خرست ولم افه بسءال هذا الشيطان . بعث معن بن زاءدة الي ابن عياش المنتوف الف دينار ، وكتب اليه : قد بعثت اليك بالف دينار واشتريت بها دينك . فكتب اليه : وصل ما انفذت وقد بعتك ديني ما خلا التوحيد لعلمي بقلة رغبتك فيه . دخل اشعري علي الرشيد فساله ، فقال : احتكم ، فقال : اشعري يحكم بعد ابي موسي ؟ فضحك واعطاه . اعترض عمرو بن الليث فارسا من جيشه ، وكانت دابته في غاية الهزال ، فقال له : يا هذا ، تاخذ مالي فتنفقه علي امراتك وتسمنها وتهزل دابتك التي تحارب عليها وبها تاخذ الرزق ؟ امض لشانك فليس لك عندي شء . فقال الجندي : ايها الامير لو استعرضت امراتي لاستسمنت دابتي . فضحك عمرو وامر باعطاءه رزقه .  قال زياد لرجل : يا ابن الزانية ، فقال : اتسبني بشء شرفت به . لما قال ابن هرمة : من المتقارب ومهما الام علي حبهم . . . فاني احب بني فاطمة بني بنت من جاء بالمحكما . . . ت والدين والسنة القاءمة لقيه رجل فساله : من قاءلها ؟ فقال : من عض بظر امه ، فقال له ابنه : الست قاءلها ؟ قال : بلي ، قال : فلم شتمت نفسك ؟ قال : اليس ان يعض المرء بظر امه خير من ان ياخذه ابن قحطبة . ومر ابن هرمة علي جيرانه وهو ميت سكرا حتي دخل منزله . فلما كان من الغد ، دخلوا اليه فعاتبوه علي الحال التي راوه عليها ، فقال لهم : انا في طلب مثلها منذ دهر ، اما سمعتم قولي : من الخفيف اسال الله سكرة قبل موتي . . . وصياح الصبيان يا سكران فنفضوا ثيابهم وخرجوا وقالوا : لا يفلح هذا ابدا . شهد رجل عند ابي العاج  وكان علي البصرة  علي رجل من المعيطيين بشهادة ، وكان الشاهد سكران ، فقال المعيطي المشهود عليه : اعزك الله ، انه لا يحسن ان يقرا من السكر ، فقال الشاهد : بلي اني لاحسن ، فقال اقرا فقال : من الرمل المجزوء علق القلب الربابا . . . بعد ما شابت وشابا  وانما تماجن بذلك علي المعيطي ليحكي به الوليد بن عقبة وانشاده هذا البيت وهو يصلي في محراب الكوفة . وكان ابو العاج محمقا وظن ان هذا قران ، فقال : صدق الله ورسوله . ويلكم فلم تعلمون ولا تعلمون . لما مات جعفر بن محمد عليهما السلام ، قال ابو حنيفة لشيطان الطاق : مات امامك ، قال : لكن امامك لا يموت الي يوم القيامة ، يعني ابليس . فقال له ابو حنيفة : ما تقول في المتعة ؟ قال : حلال ، قال : افيسرك ان تكون بناتك واخواتك يتمتع بهن ؟ قال : شء قد احله الله ان كرهت فيا حيلتي ؟ قال شيطان الطاق : فما تقول في النبيذ ؟ قال : حلال ، قال : افيسرك ان تكون بناك واخواتك نباذات ؟ قال رجل من ولد سعيد بن سلم لابي العيناء : ان ابني يبغضك ، قال : يا بني ان لي اسوة بال محمد صلي الله عليه وسلم . قال رجل للفرزدق : ما اقبح وجهك كانه خلق من احراح ، فقال : انظر هل تري حر امك فيه . وقيل لابي الاسود : كان وجهك من فقاح مجتمعة ، فقال للقاءل : فهل فقحة امك فيه . وعلي كلامه احتذي الفرزدق . قيل لبشار : ما اذهب الله ناظري احد الا عوضه منهما شيءا ، فما الذي عوضك ؟ قال : ان لا اري مثلك .  تزوج اعمي امراة فقالت : لو رايت حسني وبياضي لعجبت ، فقال : اسكتي ، لو كنت كما تقولين ما تركك لي البصراء . نظر ذيوجانس الي رجل مبذر لماله فقال له : هب لي منا فضة ، قال له : كيف صرت تسال الناس الحبة والفلس وتسالني منا فضة ؟ قال : لاني لا ارجو اليك العودة ولا ارجوها منك اذ كان لا يبقي معك . نظر حكيم الي معلم ردء الكتابة فقال له : لم لا تعلم الصراع ؟ فقال : لا احسنه ، قال : هو ذا انت تعلم الكتابة ولا تحسنها . ولي موسي بن مصعب الموصل فاستعمل رجلا من اهل حران علي كورة باهدرا ، وهي اجل كور الموصل ، فابطا عليه الخراج فكتب اليه : من المنسرح هل عند رسم برامة الخبر . . . ام لا فاي الاشياء ننتظر احمل ما عندك يا ماص بظر امه والا فقد امرت رسولي يشدك وثاقا وياتيني بك . فاخذ الرجل ما كان معه من الخراج ولحق بحران وكتب اليه في الجواب في اخر الرقعة : من البسيط ان الخليط الذي تهوي قد اءتمروا . . . للبين ثم اجدوا السير فانشمروا اجهد جهدك يا ابن الزانية . فلما قرا موسي كتابه ضحك وقال : احسن والله الجواب ، والله لا اطلبه ابدا . قال الوليد بن يزيد بن عبد الملك ، وهو ولي عهد ، للعباس بن الوليد بن عبد الملك وقد تماضا : اسكت يا ابن البظراء ، وكانت ام العباس رومية ، فقال له العباس : اتفخر علي بما قطع من بظر امك ؟  قال الوليد لاشعب : تمن ؟ فقال اشعب : يتمني امير المءمنين ثم اتمني ؟ فقال الوليد : انما اردت ان تغلبني ، اني اتمني ضعفي ما تتمني ، فقال اشعب : اني اتمني كفلين من العذاب ، قال : اذن نوفرهما عليك . كانت سعدة بنت سعيد بن خالد بن عمرو بن عثمان تحت الوليد ابن يزيد بن عبد الملك ، فهوي اختها سلمي ، فطلق سعدة طمعا ان يتزوج اختها ، فلم يزوجه ابوها . وندم علي طلاقه سعدة واستهام بها ، فتزوجت سعدة فايس منها . فقال الوليد لاشعب : هل لك في عشرة الاف درهم علي ان تبلغ سعدة رسالتي ؟ قال : احضرها حتي انظر اليها ، فاحضرها الوليد ، فوضعها اشعب علي عاتقه وقال : هات رسالتك ، فقال الوليد تقول لها : من الوافر اسعدة هل اليك لنا سبيل . . . وهل حتي القيامة من تلاق بلي ولعل دهرا ان يواتي . . . بموت من خليل او فراق فاصبح شامتا وتقر عيني . . . ويجمع شملنا بعد افتراق فاتي اشعب باب سعدة فاستاذن عليها ، فاخبرت بمكانه فامرت بفرش لها ففرشت وجلست واذنت له . فلما دخل انشدها ما امر به ، فقالت لخدمها : خذوا الفاسق ، فقال : يا سيدتي ، انها بعشرة الاف درهم ، قالت : والله لاقتلنك او تبلغه كما بلغتني ، قال : وما تهبين لي ؟ قالت بساطي الذي تحتي ، قال : قومي عنه ، فقامت فطواه ، ثم قال : هاتي رسالتك  جعلت فداك  قالت ، قل له : من الطويل اتبكي علي لبني وانت تركتها . . . فقد ذهبت لبني فما انت صانع  فاقبل اشعب فدخل علي الوليد فانشده البيت ، فقال : اواه قتلتني يا ابن الزانية ما انا صانع ؟ اختر اما ان ادليك منكسا علي راسك في البءر ، او ارمي بك منكسا من فوق القصر ، او اضرب راسك بعمودي هذا ضربة ، هذا الذي انا صانع ، فاختر الان ما انت صانع . قال اشعب : ما كنت لتفعل من هذا شيءا ، قال : ولم يا ابن الزانية ؟ قال : ما كنت لتعذب عينين قد نظرتا الي سعدة ، قال : صدقت ؛ اواه افلت مني بهذا والله يا ابن الزانية كان بالرقة قاص يكني ابا عقيل يكثر التحدث عن بني اسراءيل فيظن به الكذب ، فقال له يوما الحجاج بن خيثمة : ما كان اسم بقرة بني اسراءيل ؟ قال : خيثمة ، فقال له رجل من ولد ابي موسي الاشعري : في اي كتاب وجدت هذا ؟ قال : في كتاب عمرو بن العاص . وكان ابو الهندي ، وهو عبد المءمن بن عبد القدوس بن شيث بن ربعي الرياحي ، عجيب الجواب . فجلس اليه رجل مرة يعرف ببردين المناقير ، وكان ابوه صلب في حرابة ، والحرابة عندهم سرق الابل خاصة ، فاقبل يعرض لابي الهندي بالشراب ، فلما اكثر عليه قال ابو الهندي : احدهم يري القذاة في عين اخيه ولا يري الجذع في است ابيه . ومر به نصر بن سيار الليثي وهو يميل سكرا فقال له : افسدت شرفك ، فقال ابو الهندي : لو لم افسد شرفي لم تكن انت والي خراسان .  وخطب الي رجل من بني تميم فقال له : لو كنت مثل ابيك لزوجتك ، فقال له ابو الهندي : لكن لو كنت مثل ابي ما خطبت اليك . كانت حميدة بنت النعمان بن بشير تحت روح بن زنباع الجذامي ، فاشرفت علي قوم من جذام وفدوا علي روح فزجرها روح فقالت : اني والله لابغض الحلال من جذام ، فكيف تخافني علي الرحام منهم ؟ وخلف عليها بعده الفيض بن محمد عم يوسف ، فقالت فيه : من البسيط سميت فيضا وما شء تفيض به . . . الا بسلحك بين الباب والدار وتمثل الفيض يوما بهذا البيت : من البسيط ان كنت ساقية قوما علي كرم . . . صفو المدامة فاسقيها بني قطن ثم تحرك فضرط ، فقالت : وهذه ايضا فاسقيها بني قطن . جلس معن بن زاءدة يقسم سلاحا في جنده اذ دفع الي رجل منهم سيفا ، وكان سيف سوء ، فقال معن : خذه فانها مامورة ، فقال : هذا مما قد امر ان لا يقطع شيءا ابدا ، فابدله له وزاد في عطاءه . امر بلال بن ابي بردة بن ابي موسي الاشعري بتفريق بين رجل وامراته ، فقال له : يا ال ابي موسي ، انما خلقكم الله للتفريق بين المسلمين . وقال ابو العيناء : قال لي المتوكل يوما : هل رايت طالبيا حسن الوجه قط ؟ قلت : نعم ، رايت ببغداد منذ ثلاثين سنة واحدا ، قال : تجده كان يءاجر وكنت تقود عليه ، فقلت : يا امير المءمنين ، قد بلغ هذا من فراغي ، ادع  موالي مع كثرتهم واقود علي الغرباء ؟ فقال المتوكل للفتح : اردت ان اشتفي منهم فاشتفي لهم مني . وقدم الي ماءدة عليها ابو هفان وابو العيناء فالوذجة ، فقال ابو هفان : لهذه احر من مكانك في جهنم ، فقال له ابو العيناء : ان كانت حارة فبردها بشعرك . وقال ابو العيناء : ادخل علي المتوكل رجل قد ادعي النبوة ، فقيل له : ما علامة نبوتك ؟ قال : ان يدفع الي احدكم امراة فاني احبلها في الحال ، فقال : يا ابا العيناء ، هل لك ان تعطيه بعض الاهل ؟ فقال : انما يعطيه من كفر به . فضحك وخلاه . وقال : فلج بعض المجان فرايته وهو ياكل سمكا ولبنا فعاتبته علي ذلك فقال : امن ما يكون الطريق اذا قطع فيه . ومرت جارية بقوم ومعها طبق مغطي ، فقال لها بعضهم : اي شء معك علي الطبق ؟ قالت : فلم غطيناه ؟ قالت امراة مزبد لمزبد : يا قرنان يا مفلس قال : ان صدقت فواحدة من الله تعالي والاخري منك . رفع مزبد مرة الي والي المدينة ومعه زق فارغ ، فامر بضربه فقال له : لم تضربني ؟ قال : لان معك الة الخمر ، قال : وانت  اعز الله  معك الة الزنا .  قال الرشيد لبهلول : من احب الناس اليك ؟ قال من اشبع بطني ، قال : فانا اشبعك فهل تحبني ؟ قال الحب بالنسيءة لا يكون . وقال له الرشيد : ابو بكر وعمر خير ام علي ؟ فقال : واحد بازاء الاثنين لا يجوز ، ولكن علي والعباس خير من ابي بكر وعمر . وشبيه بهذا ما حكي عن السندي بن شاهك انه احضر رجلا ادعي عليه الرفض فقال له : ما تقول في ابي بكر ؟ فاثني عليه ، قال : فعمر ؟ قال : لا احبه فاخترط السندي سيفه وقال : لم ويلك ؟ قال : لانه جعل الشوري في ستة من المهاجرين واخرج العباس منهم ، فشام سيفه ورضي عنه . ضرط ابن صغير لعبد الملك بن مروان في حجره ، فقال له : قم الي الكنيف ، فقال : انا فيه . وكان عبد الملك شديد البخر . دخل ابراهيم الحراني الحمام فراي رجلا عظيم الذكر فقال له : ايباع متاع البغل ؟ قال : لا بل نحملك عليه . فلما خرج بعث اليه بصلة وكسوة وقال لرسوله ، قل له : اكتم هذا الحديث فانه كان مزاحا . فرده وقال ، قل له : لو قبلت حمالتنا لقبلنا صلتك . قال الفرزدق لزياد الاعجم : يا اقلف ، فقال يا ابن النمامة . كان لبعضهم ابن دميم فخطب الي قوم ، فقال الابن لابيه يوما : بلغني ان العروس عوراء ، فقال الاب : يا بني ، بودي انها عمياء حتي لا تري سماجة وجهك .  كانت رقية بنت عبد الله بن عمرو بن عثمان  وامها فاطمة بنت الحسين  عند هشام بن عبد الملك ، وكان يحبها وتبغضه ، فاعتلت ، فجلس عند راسها فقال لها : ما تشتكين ؟ قالت : بغضك ، فسكت عنها ساعة ثم قال لها : ما تشتهين ، قالت : فقدك . وكان بالبصرة رجل طيب يقال له حوصلة ، وكان له جار يعشق ابنا له ، فوجه حوصلة بابنه هذا الي بغداذ في حاجة له ولم يعلم جاره بذلك ، فجاء ليلة يطلبه فصاح بالباب : اعطونا نارا ، فقال حوصلة : المقدحة ببغداذ . وقد حكي مثل هذا سواء عن ابن ابي عتيق وقد جاء صديق لجاريته يطلب نارا ، فقال له : قداحتنا في البستان . وقال بعض العلوية لابي العيناء : اتبغضني ولا تصح صلاتك الا بالصلاة علي اذا قلت : اللهم صل علي محمد واله ؟ قال ابو العيناء : اذا قلت الطيبين الطاهرين خرجت منهم . سكر مزبد يوما فقالت امراته : اسال الله ان يبغض اليك النبيذ ، قال : والفتيت اليك . قالت امراة مزبد يوما ، وكانت حبلي ونظرت الي قبح وجهه : الويل لي ان كان الذي في بطني يشبهك ، فقال لها : الويل لي ان كان الذي في بطنك لا يشبهني .  سال بعض الخلفاء بعض من لا يستحق الولاية فقال : ولني يا امير المءمنين ارمينية ، قال : يبطء علي امير المءمنين خبرك . وقال رجل لحميد الطوسي ، وكان عاتيا : رايت في النوم كان القيامة قد قامت ، وكان الله تعالي قد دعاك وغفر لك وادخلك الجنة . فقال : ان كانت رءياك حقا فالجور ثم اكثر منه ها هنا . مر الفرزدق وهو راكب علي بغلة فضرطت ، فضحكت منه امراة ، فالتفت اليها وقال : ما يضحكك ؟ فوالله ما حملتني انثي قط الا ضرطت . فقالت له المراة : قد حملتك امك تسعة اشهر يا ابن الضراطة . تنبا رجل فادعي انه موسي بن عمران ، وبلغ خبره الخليفة فاحضره وقال : من انت ؟ قال : موسي بن عمران الكليم قال : وهذه عصاك التي صارت ثعبانا ؟ قال : نعم ، قال : فالقها من يدك وامرها ان تصير ثعبانا كما فعل موسي ، قال : قل انا ربكم الاعلي كما قال فرعون حتي اصيرها ثعبانا كما فعل موسي . وتنبات امراة علي عهد المامون فاوصلت اليه ، فقال لها : من انت ؟ قالت : انا فاطمة النبية ، قال لها المامون : اتءمنين بما جاء به محمد فهو حق ؟ قالت : نعم ، فان محمدا قال لا نبي بعدي ، قالت : صدق عليه السلام ، فهل قال لا نبية بعدي ؟ قال المامون لمن حضره : اما انا فقد انقطعت ، فمن كان عنده حجة فليات بها ، وضحك حتي غطي وجهه .  وتنبا اخر في ايام المعتصم ، فلما احضر بين يديه قال له : انت نبي ؟ قال : الي من بعثت ؟ قال : اليك ، قال : اشهد انك لسفيه احمق ، قال : انما يبعث الي كل قوم مثلهم ، فضحك المعتصم وامر له بشء . وتنبا اخر في خلافة المامون فقال له : ما انت ؟ قال : نبي ، قال : فما معجزتك ؟ قال : سل ما شءت  وكان بين يديه قفل  فقال : خذ هذا القفل فافتحه ، قال : اصلحك الله ، لم اقل لك انني حداد ، قلت : انا نبي . فضحك المامون واستتابه واجازه . قال بصيلة : دخلت سقاية بالكرخ فتوضات ، فلما خرجت تعلق بي السقاء وقال : هات قطعة فضرطت ضرطة وقلت : خل الان سبيلي فقد نقضت وضوءي ، فضحك وخلاني . دخل رجل من ولد قتيبة بن مسلم الحمام وبشار بن برد فيه فقال : يا ابا معاذ وددت لو انك مفتوح العين ، قال : ولم ذاك ؟ قال : لتري استي فتعرف انك قد كذبت في شعرك حيث تقول : من الوافر علي استاه سادتهم كتاب . . . موالي عامر وسم بنار قال : غلطت يا ابن اخي انما قلت : علي استاه سادتهم ، ولست منهم . كان بعضهم يتقلد اعمال السلطان ، فجاءه ابوه يوما يساله في امر انسان فاشتد عليه وضجر ، فقال لابيه : احب واسالك ان تقول اذا جاءك انسان وقال : كلم ابنك بسبي قل : ليس ذلك بابني ، فقال الاب : انا هو ذا اقول هذا منذ ثلاثين سنة وما يقبل مني .  كان ابو حنيفة وشيطان الطاق بمشيان ذات يوم اذ سمعا رجلا يقول : من يدلنا علي صبي ضال ؟ فقال شيطان الطاق : اما الصبي فلا ادري ولكن ان اردت ان ادلك علي شيخ ضال فها هو ذا ، واوما الي ابي حنيفة . وكان لشيطان الطاق ابن احمق فقال له ابو حنيفة : انت من ابنك هذا في بستان ، قال : هذا لو كان ابنك . لما اخذ محمد بن سليمان صالح بن عبد القدوس ليوجه به الي المهدي قال له : اطلقني حتي افكر فيولد لك ولد ذكر ، ولم يكن لمحمد بن سليمان غير بنت واحدة ، قال : بل اصنع ما هو انفع لك ، افكر حتي تفلت من يدي . حمل بعض الصوفية طعاما الي طحان يطحنه فقال : انا مشغول ، فقال : اطحنه والا دعوت عليك وعلي حمارك ورحاك ، قال : فانت مجاب الدعوة ؟ قال : نعم ، قال : فادع الله عز وجل ان يصير حنطتك دقيقا فهو انفع لك واسلم لدينك . ؟ دخل الشعبي الحمام وفيه رجل متكشف ، فغمض عينيه فقال له الرجل : يا شيخ متي ذهبت عينك ؟ قال : منذ هتك الله سترك . ؟ قال رجل من اهل الحجاز لابن شبرمة : من عندنا خرج العلم ، قال : ثم لم يعد اليكم . ؟  اعترض رجل المامون فقال : يا امير المءمنين ، انا رجل من العرب ، قال : ما ذاك بعجب ، قال : واني اريد الحج ، قال : الطريق امامك نهج ، قال : وليست لي نفقة ، قال : قد سقط الفرض عنك ، قال : اني جءتك مستجديا لا مستفتيا . فضحك وامر له بصلة . ؟ وتنظر هذه الحكاية الي قصة عبد الله بن فضالة الاسدي مع ابن الزبير لما قال : اني جءتك مستجديا لا مستوصفا ، فلعن الله ناقة حملتني اليك ؛ الا ان المامون ولع بالاعرابي وابن الزبير قصد المنع لمجتديه ، فلم اثبت الحكاية ها هنا لهذا السبب اذ كان لا يليق بها . ؟ قال الاصمعي : مررت بكناس يكنس كنيفا بالبصرة وهو ينشد : من الوافر اضاعوني واي فتي اضاعوا . . . ليوم كريهة وسداد ثغر فقلت له : اما سداد الكنيف فانت ملء به ، واما سداد الثغر فلا علم لي بك كيف انت فيه  وكنت حديث السن واردت العبث به  قال : فاعرض عني مليا ثم اقبل علي وانشد متمثلا : من الطويل واكرم نفسي انني ان اهنتها . . . وحقك لم تكرم علي احد بعدي فقلت له : والله ما يكون من الهوان شء اكثر مما بذلتها له ، فباي شء اكرمتها ؟ فقال : بلي والله ، ان من الهوان ما هو شر مما انا فيه ، فقلت : ما هو ؟ فقال : الحاجة اليك والي امثالك من الناس . اتي الحكم بن عبدل ابن بشر بالكوفة ، فساله فقال : اخمسماءة  احب اليك الان ام الف في القابل ؟ قال : الف في القابل ، فلما اتاه قال : الف احب اليك ام الفان في القابل ؟ قال : الفان في القابل . فلم يزل ذلك دابه حتي مات ابن بشر وما اعطاه شيءا . ثم ان امراة موسرة بالكوفة كانت لها علي الناس ديون بالسواد ، فاستعانت بابن عبدل في دينها وقالت : اني امراة ليس لي زوج ، وجعلت تعرض بانها تزوجه نفسها . فقام ابن عبدل في دينها حتي اقتضاه ؛ فلما طالبها بالوفاء كتبت اليه : من الوافر سيخطيك الذي اخطاك مني . . . فقطع حبل وصلك من حبالي كما اخطاك معروف ابن بشر . . . وكنت تعد ذلك راس مال قال محمد بن ابراهيم الامام لسعيد الدارمي : لو صلحت عليك ثيابي لكسوتك ، قال : فديتك ان لم تصلح علي ثيابك صلحت علي دنانيرك . قال اسحاق بن ابراهيم الموصلي : عمل محمد الامين سفينة فاعجب بها وركب فيها يريد الانبار وانا معه . فقال لي : يا اسحاق كيف تري سفينتي ؟ قلت حسنة يا امير المءمنين ، عمرها الله ببقاءك . وقام يريد الخلاء ، وقال : قل فيها ابياتا ، فقلت : نعم ، وخرج . فقمت بالابيات اليه فاشتهاها جدا وقال لي : احسنت يا اسحاق ، وحياتي لاهبن لك عشرة الاف دينار ، فقلت : متي يا امير المءمنين ، اذا وسع الله عليك ؟ فضحك ودعا بها علي المكان . وفي حكاية اخري عنه انه طرب علي غناءه فخرق دراعته وقال : وحياتي لاهبن لك عشرة الاف درهم ، فقال متي يا سيدي ؟ اذا بويعت بالخلافة وكنت بين يديك اغني ، ووفق لي ان طربت علي غناءي ؟ وقد حكي عن الحجاج ما يقارب هذا ، وخرج في مقام الجد  والسخاء ، وذلك انه حج فلما اراد الصدر قال : اعذرونا يا اهل مكة فانا علي سفر . فقام اليه رجل من قريش فقال : لا عذر الله من يعذرك ، امير المصرين وابن عظيم القريتين ، فاذا عذرناك فمن نلوم ؟ فقال الحجاج : علي بالتجار فاحضروا ، فاستسلف منهم الف الف درهم وقسمها منهم . راي رجل رجلا ياخذ حجارة قد اعدها لبناء له فاستحيا منه ، فقال الاخذ : لم اعلم انها لك ؟ فقال : هب انك لم تعلم انها لي ، الم تعلم انها ليست لك ؟ دخل ابو الاقرع علي الوليد فقال له : انشدني قولك في الخمر ، فانشده : من الطويل كميتا اذا شجت وفي الكاس وردة . . . لها في عظام الشاربين دبيب تريك القذي من دونه وهي دونه . . . لوجه اخيها في الاناء قطوب فقال له الوليد : شربتها ورب الكعبة ، فقال : يا امير المءمنين ، لءن كان نعتي لها رابك لقد رابتني معرفتك بها . قدم رجل عجوزا دلالة الي القاضي ، فقال : اصلح الله القاضي ، زوجتني هذه امراة فلما دخلت بها وجدتها عرجاء ، فقالت : اصلح الله القاضي ، زوجته امراة يجامعها او زوجته حمارة يحج عليها ؟ قيل لامراة ظريفة : ابكر انت ؟ قال : اعوذ بالله من الكساد . قال ابو العيناء : خطبت امراة فاستقبحتني فكتبت اليها : من الطويل فان تنفري من قبح وجهي فانني . . . اديب اريب لا عيي ولا فدم  فاجابت : ليس لديوان الرساءل اريدك . خرجت حبي المدينية في جوف الليل فليقها انسان فقال : اتخرجين في هذا الوقت ؟ قالت : وما ابالي ؟ ان لقيني الشيطان فانا في طاعته ، وان لقيني رجل فانا في طلبه . غاب رجل عن امراته فبلغها انه اشتري جارية ، فاشترت غلامين ، فبلغ الخبر زوجها فجاء مبادرا وقال لها : ما هذا ؟ فقالت : اما علمت ان الرحي احوج الي بغلين من البغل الي رحوين ، بع الجارية حتي نبيع الغلامين . ففعل ذلك . ادخل علوي امراة فلما طالبها قالت له : هات شيءا ؟ قال : اما ترضين ان يلج فيك بضعة مني ؟ قالت : هذا ينفق بقم . دخل ابن يونس فقيه مصر علي بعض الخلفاء ، فقال له : ما تقول في رجل اشتري شاة فضرطت فخرجت من استها بعرة فقات عين رجل ؟ علي من الدية ؟ قال : علي الباءع ، قال : ولم ؟ قال : لانه باع شاة في ساتها منجنيق ولم يبرا من العهدة . كان ابن قريعة القاضي في مجلس المهلبي ، فوردت عليه رقعة فيها : ما يقول القاضي  اعزه الله  في رجل دخل الحمام فجلس في الابزن لعلة كانت به ، فخرجت منه ريح وتحول الماء زيتا ، فتخاصم الحمامي والضارط ، وادعي كل واحد منهما انه يستحق جميع الزيت بحقه فيه ؟ فكتب القاضي في  الجواب : قرات هذه الفتيا الظريفة في هذه القصة السخيفة ، واخلق بها ان تكون عبثا باطلا وكذبا ماحلا ، وان كان ذلك كذلك فهو من اعاجيب الزمان وبداءع الحدثان . والجواب  وبالله التوفيق  ان للصاقع نصف الزيت بحق وجعاءه ، وللحمامي نصف الزيت بحق ماءه ، وعليهما ان يصدقا المبتاع منهما عن خبث اصله وقبح فصله ، حتي يستعمله في مسرجته ، ولا يدخله في اغذيته . وجد شيخ مع زنجية في ليلة الجمعة في مسجد وقد نومها علي الجنازة ، فقيل له : قبحك الله يا شيخ ، قال : اذا كنت اشتهي وانا شيخ فما ينفعني شبابكم ؟ قالوا : فزنجية ؟ قال : فمن يزوجني منكم بعربية ؟ قالوا : ففي المسجد ؟ قال : من يفرغ لي منكم بيته ساعة ؟ قالوا : فعلي الجنازة ؟ قال : من يعطيني سريره ؟ قالوا : فليلة الجمعة ؟ قال : ان شءتم جءتكم ليلة السبت . فضحكوا منه وخلوه . وقف اعرابي من بني فقعس علي جماعة يسالهم ، وهو عريان فانشد : من الوافر كساني فقعس وكسا بنيه . . . عطاف المجد ان له عطافا فقال بعضهم : لو كساك خرقة تواريك كانت اصلح لك من هذا العطاف . قال شاعر في الصاحب : من المتقارب وردنا لنشكر كافي الكفاة . . . ونساله الكف عن برنا فقال له بعضهم : فقد كفيت فليس يعطي احدا شيءا . غضب سعيد بن وهب يوما علي غلام له فامر به فبطح وكشف  عنه الثوب ليضربه ، وقال له : يا ابن الفاعلة ، انما غرتك استك هذه حتي اجترات علي هذه الجراة ، وساريك هوانها علي . فقال الغلام : طالما غرتك هذه الاست حتي اجترات علي الله تعالي ، وسوف تري هوانك عليه . قال سعيد : فورد علي من جوابه ما حيرني وسقط السوط من يدي . ركب اعرابي بحيرة ، فقيل له : انها حرام لا يحل ركوبها ، فقال : يركب الحرام من لا حلال له . وسال اعرابي عبد الملك فقال : سل الله تعالي ، فقال الاعرابي : قد سالته فاحالني عليك . فضحك واعطاه . ودخل اعرابي المخرج فخرج منه صوت ، فجعل فتيان حضور يضحكون منه ، فقال : يا فتيان ، هل سمعتم شيءا في غير موضعه ؟ وقال بعض المجان : حضرنا مجلسا فيه قينة ، فتحركت فضرطت وتشورت وقطعت الزير ، فتغافلوا عنها ، ثم قالت لبعضهم : ما تحب ان اغنيك ؟ قال من المنسرح : يا ريح ما تصنعين بالدمن . . . كم لك من محو منظر حسن قال : فكان خجلها في اقتراحه اشد من خجلها من ضرطها . وقال ابن ابي البغل لرجل : ولد لي مولود فما اسميه ؟ قال : لا تخرج من الاصطبل وسمه ما شءت . قال برصوما الزامر لابيه : لم تجد اسما تسميني به احسن من  هذا ؟ قال : لو علمت انك تجالس الخلفاء لسميتك يزيد بن مزيد . لما قال ابراهيم بن هرمة : من المنسرح لا امتع العود بالفصال ولا . . . ابتاع الا قريبة الاجل قال مزبد : صدق ابن الخبيثة فانه لا يشتري الا شاة الاضحي التي يذبحها من ساعته . لما قال ارطاة بن سهية ، وهي امه ، للربيع بن قعنب : من البسيط لقد رايتك عريانا ومءتزرا . . . فما علمت اانثي انت ام ذكر قال له : لكن سهية قد علمت ، فغلبه . قال محمد بن الحارث بن بسخنر : كان علويه بعيد الخجل صفيق الوجه لا يكاد يخجله شء . فاجتمعنا يوما عند المعتصم ومعنا ابراهيم بن المهدي ، فلما خرجنا قال ابراهيم لعلويه : هل احدثت شيءا من الغناء ؟ قال : صنعت : من الطويل اذا كان لي شيءان يا ام مالك . . . فان لجاري منهما ما تخيرا وفي واحد ان لم يكن غير واحد . . . اراه له اهلا وان كنت معسرا قال ابراهيم : وان كانت امراتك ؟ فانقطع علوية انقطاعا قبيحا ، وخجل حتي لم ينتفع بنفسه ذلك اليوم . ومما وضع علي لسان البهاءم ايضا :  وقع في شرك صياد ثعلبان ، فقال احدهما لصاحبه : يا اخي اين تري نلتقي ؟ قال : في الفراءين بعد ثلاثة ايام .  دخل كلب مسجدا خرابا فبال في المحراب ، وفي المسجد قرد ناءم ، فقال للكلي : اما تخاف تبول في المحراب ؟ فقال الكلب : ما احسن ما خلقك حتي تتعصب له . وقالوا : ان جديا وقف علي سطح يشتم ذءبا في الارض ، فقال له الذءب : لست الذي تشتمني ولكن مكانك الذي يفعل ذلك . عدا كلب خلف ظبي فقال له الظبي : انك لا تلحقني ، قال : لم ؟ قال : لاني اعدو لنفسي وانت تعدو لصاحبك . هاج بابي علقمة الدم فاتوه بحجام يحجمه ، فقال له : اشدد قصب الملازم وارهف ظبة المشارط ، واسرع الوضع ، وعجل النزع ، وليكن شرطك وخزا ، ومصك نهزا ، ولا تكرهن ابيا ، ولا تردن اتيا . فوضع الحجام محاجمه في جونته وقال : اسقوا هذا شربة فانه الي الدواء احوج منه الي الحجامة . استاجر رجل حمالا ليحمل معه قفصا فيه قوارير علي ان يعلمه ثلاث خصال ينتفع بها . فلما بلغ ثلث الطريق قال : هات الخصلة الاولي ، قال : من قال لك ان الجوع خير من الشبع فلا تصدقه ، قال : نعم . فلما بلغ نصف الطريق قال : هات الثانية ، قال : من قال لك ان المشي خير من الركوب فلا تصدقه ، قال : نعم . فلما بلغ الي باب الدار قال : هات الثالثة ،  قال : من قال لك انه وجد حمالا ارخص منك فلا تصدقه . فرمي الحمال بالقفص وقال له : من قال لك انه بقي في القفص قارورة واحدة فلا تصدقه . جاء رجل الي السيد الحميري فقال : بلغني انك تقول بالرجعة ، قال : صدق الذي اخبرك وهذا ديني ، قال : افتعطيني دينارا بماءة دينارا الي الرجعة ؟ قال السيد : نعم واكثر من ذلك ان وثقت لي بمن يضمن لي انك ترجع انسانا . قال : واي شء ارجع ؟ قال : اخشي ان ترجع كلبا او خنزيرا او حمارا وتذهب بمالي ، فافحمه . وقف مطيع بن اياس علي رجل يعرف بابي عمير من اصحاب المعلي الخادم ، فجعل يعبث به ويمازحه الي ان قال له : من الوافر الا ابلغ لديك ابا العمير . . . اراني الله في استك نصف اير فقال له ابو العمير يا ابا سلمي ، لو جدت بالاير كله لاحد لجدت لي به لما بيننا من المصادقة ، ولكنك لحبك له لا تريده كله الا له . فافحمه ولم يعاود العبث به . وكان مطيع يرمي بالابنة . القي ابو دلف العجلي علي فضل الشاعرة المتوكلية يوما : من الكامل قالوا عشقت صغيرة فاجبتهم . . . اشهي المطي الي ما لم يركب كم بين حبة لءلء مثقوبة . . . لبست وحبة لءلء لم تثقب فقالت فضل مجيبة له : من الكامل ان المطية لا يلذ ركوبها . . . ما لم تذلل بالزمام وتركب والحب ليس بنافع اربابه . . . ما لم يءلف للنظام ويثقب  وقف الفرزدق بالبصرة علي رجل يكري النساء الحمير يعرف بباب المكاري ، فقال له : انت باب ؟ قال : نعم ، فقال : من الطويل كم من حر يا باب ضخم حملته . . . علي الرحل فوق الاخدري المكرم فقال : الساعة والله  جعلني الله فداك  نزلت النوار  استودعها الله  عن ذلك الحمار ، واشار بيده الي بعض الحمير ، فقال له ابنه : ما كان اغناك عن هذا العبث . تكلم البصري مع بعض المتكلمين في مجلس المرتضي فقال البصري : ان العقل غير العلم ، وقال الاخر : العقل هو العلم . فدل البصري واوضح حجته والخصم يرده بجحود وبهت لا دليل وراءه ؛ فلما اعياه وضحك الحاضرون من فهمه ، قال البصري : قد اتيت بالبرهان لست تقبله ، وقد بقي عندي دليل واضح اذكره ولا ترده ، قال : ما هو ؟ قال : انت ، فانك غاية في العلم والفضل ، وليس لك عقل كلب . فاستشاط الاخر وسبه وسفه عليه ، وقال : يا زوج كذا ، فقال البصري واشار الي الحاضرين : سيدنا يدل . قال الاصمعي : ولي اعرابي علي تيماء ، وكان هناك قوم من بني ضبة ، وكان فيهم امراة ماجنة . فمر بها الوالي ذات يوم وهو وحده وليس معه احد من اعوانه ، فقالت : ايها الرجل اني احب الشعر وسماعه ، فهل تروي لجميل شيءا ؟ قال : نعم ، واراد ان يجمشها ، فقال : اروي قوله : من الطويل هممت بامر يا بثينة لو مضي . . . لشد بواقي حبها من فءاديا لاجعل فخذا من بثينة كالنقا . . . يمينا واخري مثلها عن شماليا واراد ان تنقمع وتحتشم بسماع هذا وتنصرف عنه . فقالت : ما احسن ما فوق  لو اصاب القرطاس ، فقال : قبحك الله ما امجنك ، وانصرف مستحييا . قال شريك الحارثي لجارية سوداء : لمن انت يا سوداء ؟  وكان اصلع  قالت : انا لفلان يا اصلع ، فغضب وقال : كانك لست سوداء ، فلم غضبت ؟ فقالت له : الحق اغضبك ، لا تسب حتي لا تسب . جلس بعض الاعراب يبول وسط الطريق بالبصرة فقيل له : يا اعرابي اتبول في طريق المسلمين ؟ قال : وانا من المسلمين ، بلت في حقي من الطريق . كان في يحيي بن اكثم حسد شديد ، وكان مفننا في العلوم ، اذا ناظر رجلا فراه عالما بالفقه اخرجه الي الحديث ، وان وجده عالما بالفقه والحديث اخرجه الي العربية ، فقدم من اهل خراسان رجل له افتنان في العلوم فناظره ، فجعل يحيي لا يخرجه الي فن الا قام به . فناظره في الحديث وقال له : ما تحفظ من الاصول ؟ قال : احفظ عن شريك عن ابي اسحاق عن الحارث ان عليا عليه السلام رجم لوطيا . فسكت يحيي ولم يناظره بعد ذلك بحرف . اخرج نصر بن سيار محمد بن قطن الاسدي الي قتال الكرماني كارها ، فاصابه سهم غرب فقتله ، ورمي ذلك اليوم برذون الكرماني فنفق ، فصاح اصحاب نصر : يا اصحاب الكرماني ، ما فعل البرذون ؟ فصاحوا بهم : ركبه محمد بن قطن الي النار . قال رجل لبعض الاعراب : لا احسبك تحسن الخراءة قال : بلي وابيك ، اني بها لحاذق ، ابعد الاثر ، واعد المدر ، واستقبل الشيح ، واستدبر الريح ، واقعي اقعاء الظبي ، واجفل اجفال النعام .  قال ابو زيد الانصاري : دعا ابن ابي بردة ابا علقمة ، وهو معتوه بصري ، فلما دخل عليه قال : تدري لم ارسلت اليك ؟ قال : لا ، قال : لاسخر منك . فقال ابو علقمة : لءن فعلت ذاك لقد سخر احد الحكمين من صاحبه . فلعنه ابن ابي بردة وامر بحبسه . فبقي اياما ثم اخرجه يوم السبت ، فلما وقف بين يديه قال له : ابو علقمة ما هذا الذي في كمك ؟ قال : طرف من طرف السجن ، قال : افلا تهب لنا منه ، قال : هذا يوم لا ناخذ فيه ولا نعطي ، قال ابن ابي بردة : ما ابردك واثقلك يا ابا علقمة ، قال : ابرد مني واثقل من كانت جدته يهودية من اهل السواد . قال ابو زيد النحوي : مر رجل من قيس ومعه ابن له يريد الجمعة ، وابو علقمة المعتوه هذا علي باب المسجد جالس . فقال الغلام لابيه : اكلم ابا علقمة ؟ قال : لا ، فاعاد الكلام ثلاثا ، فقال له ابوه : انت اعلم . فقال له الغلام : يا ابا علقمة ، ما بال لحي قيس خفيفة قليلة المءونة ولحي اليمن كبيرة عريضة شديدة المءونة ؟ قال : من قول الله تعالي : والبلد الطيب يخرج نباته باذن ربه والذي خبث لا يخرج الا نكدا الاعراف :  ، مثل لحية ابيك ، قال : فجذب القيسي يده من يد ابنه ودخل في غمار الناس حياء وخجلا . قيل كان في همذان مجنون يجتمع عليه الناس ، فاذا اجتمعوا عليه قال لهم : هل ترون ما انتم فيه من حيرتكم وغفلتكم شيءا ؟ ما هو الا محنة العبودية ووطاة الشريعة في الدنيا ، والحبس والسءال والعذاب في الاخرة ، وانما الراحة ما انا فيه : لا حرج في الدنيا ولا حساب في الاخرة . مر حوشب بمجنون من بني اسد وهو راكب قصبة والصبيان  معه . فقال حوشب : قبحك الله تصنع هذا وانت امرء من العرب ؟ فانشا المجنون يقول : من الكامل نجي وليدته واسلم شيخه . . . بءس الفتي عند الحفيظة حوشب واتبعه الصبيان يصيحون به : بءس الفتي عند الحفيظة حوشب ، وهو يركض هاربا . وقيل بينا احمد بن طولون في فيءته اذ سمع صاءحا يصيح : يا احمد بن طولون ، يا اخا ثمود ، يا احمد بن طولون ، يا اخا فرعون فقال : علي بهذا الصاءح ، فمضوا وعادوا وقالوا : هو ابو نصر المجنون  لمجنون كان بمصر  فجء به فقال : ما لك يا ابا نصر ؟ قال جاءع . قال : فامر بطعام فجء به وشواء وحلواء ، فاكل الطعام والحلواء وشرب ثم نام بحضرة ابن طولون فما ايقظه بحرف ، ولم يزل ساكتا حتي انتبه . فقال له : متي نراك يا ابا نصر ؟ قال : حتي اجوع . قال عبد الله بن خزيمة لبعض اصحابه ، وكان صاحب شرطته ، ذات يوم : اين تذهب يا هامان ؟ قال : ابني لك صرحا . قال رجل لصاحب منزل : اصلح خشب هذا السقف فانه يتفرقع ، قال : لا تخف انما هو تسبيح ، فقال : اخاف ان تدركه رقة فيسجد . سمع اسماعيل بن حماد بن ابي حنيفة يحيي بن اكثم يغض من جده ، فقال : ما هذا جزاءه منك ، قال : حين فعل ماذا ؟ قال : حين اباح النبيذ ودرا الحد عن اللوطي . قال رجل لحسين بن منصور الحلاج : ان كنت فيما تدعيه صادقا  فامسخني قردا ، فقال لو هممت بذاك لكان نصف العمل مفروغا منه . سال رجل رجلا : ما اسمك ؟ قال : بحر ، قال : ابو من ؟ قال : ابو الفيض ، قال : ابن من ؟ قال : ابن الفرات قال : ما ينبغي لصديقك ان يلقاك الا في زورق . واسرت مزنية حسان بن ثابت في الجاهلية فاراد اهله ان يفادوه ، فقالت مزينة : لا نفاديه الا بتيس اجم ، فقالوا : والله لا نرضي ان يفتدي شاعرنا ولساننا بتيس ، فقال حسان ويحكم اتغبنون انفسكم عيانا ، ان القوم تيوس ، فخذوا من القوم اخاكم واعطوهم اخاهم . قال موسي بن قيس المازني قلت لابي فراس المجنون : انت النهار كله ماش افتشتكي بدنك بالليل ؟ فقال : من المتقارب اذا الليل البسني ثوبه . . . تقلب فيه فتي موجع فقلت : يا احمق اسالك عن حالك وتنشدني الشعر ؟ قال : اجبتك يا مجنون ، قلت : اتقول لي هذا وانا سيد من سادات الانصار فقال : من الطويل وان بقوم سودوك لفاقة . . . الي سيد لو يظفرون بسيد ثم لطم عينه ، ومر وهو يقول : هكذا يكون الجواب المقشر . تم الباب بحمد الله وعونه والحمد لله ، اللهم صل علي محمد النبي واله وسلم . ويتلوه باب كبوات الجياد وهفوات الامجاد والله المعين والموفق بحوله وقوته قوبل بجميعه فصح وكان الفراغ منه في سابع عشر رجب من سنة تسعين وستماءة ، والله يطيل بقاء مالكه ويمتعه به امين .  فارغة 
  الباب الرابع والثلاثون في كبوات الجياد وهفوات الامجاد
  فارغة  بسم الله الرحمن الرحيم وما توفيقي الا بالله الحمد لله الذي تفرد بالكمال ، وتعالي علي الاشباه والامثال ، قوله الحق وامره الفصل ، وبيده الخير وله الفضل ، خص البشر بالنقص والزمهموه ، ليعرفوا الخالق برتبة الكمال فيوحدوه ، ما استفز العجب ذا فضيلة الا كشفته هفوته ، ولا استقر في خياله التمام الا اكذب النقص مخيلته ، ولا امتد سابق في جراء الا والعثار غايته ، ولا اشتد صاعد في ذروة علاء الا والهبوط عاقبته ، ولا اشتد ساعد في رماء الا خان وقد امكنت رميته .  احمده حمد مسلم معترف ، واساله راغبا في قبول الانابة من مقر مقترف . واشهد ان لا اله الا الله شهادة اعوذ بها من هفوات القول والعمل ، والوذ بعصمتها من فرطات الخطا والخطل ، والصلاة علي محمد نبيه المعصوم من الزلل والعثار ، المءيد بالسكينة والوقار ، المختص بالاحتباء والاختيار ، وعلي اله واصحابه الاتقياء الابرار .  
  الباب الرابع والثلاثون في كبوات الجياد وهفوات الامجاد
  ويتصل به سرقات فحول الشعراء وسقطاتهم . قال الله تعالي : ان الذين تولوا منكم يوم التقي الجمعان انما استزلهم الشيطان ببعض ما كسبوا ولقد عفا الله عنهم ان الله غفور حليم ال عمران :  . فهذه كانت هفوة من المسلمين وفيهم سادات الصحابة واعيان الشجعان في يوم حنين غفرها الله وعفا عنها . وكان بعض القوم قال في ذلك اليوم : لن نءتي اليوم من قلة ، وهم في اثني عشر الفا ، فانزل الله تعالي : ويوم حنين اذا اعجبتكم كثرتكم فلم تغن عنكم شيءا وضاقت عليكم الارض بما رحبت ثم وليتم مدبرين التوبة :  . ويليق بهذا الباب قصص الانبياء عليهم السلام التي نسب اليهم فيها الخطا : كخطيءة ادم عليه السلام ، وكقضية داود في الحكم ، وقضية سليمان في قوله تعالي : ولد فتنا سليمان والقينا علي كرسيه جسدا ثم اناب ص :  فغفرنا له ذلك ؛ وقد نسبوا الي الخليل ابراهيم عليه السلام نحو ذلك ، حيث راي الكوكب ثم القمر ثم الشمس ؛ وقصة يوسف عليه السلام حيث همت به وهم بها .  ولكني الغيت شرح هذه الاخبار التي اوردها اصحاب السير تنزيها لهم ، واكبارا عن تمثيلهم ممن ادركه الزلل فهفا ، وعثر في سنن هديه فكبا ؛ وعلي ان الناس مختلفون فيما يجوز عليهم من الخطا ، وفيهم من لم يجوز عليه وقوع الخطيءة ، لا كبيرها ولا صغيرها ، قبل النبوة وبعدها . فاما الذين جوزوا وقوع الخطا منهم واختلفوا ، فجوز اصحاب الحديث ومن تابعهم وقوع الكباءر منهم قبل النبوة ؛ وافرط قوم منهم فجوزوها في حال النبوة ، سوي الكذب فيما يتعلق باداء الشريعة ؛ ومنهم من جوز ذلك في حال النبوة بشرط الاسرار دون الاعلان ؛ وفيهم من جوزه علي الاحوال كلها ، ومنعت المعتزلة من وقوع الكباءر والصغاءر المستخفة من الانبياء عليهم السلام قبل النبوة وفي حالها ، وجوزت في الحالين وقوع ما لا يستخف من الصغاءر ، ثم اختلفوا : فمنهم من جوز النبي الاقدام علي المعصية الصغيرة لا علي سبيل العمد ، ومنهم من منع ذلك وقال : انهم لا يقدمون علي ما يعملونه معصية علي سبيل التاويل . وحكي عن النظام وجعفر بن مبشر انهما قالا مع جماعة اتبعتهما ان ذنوبهم لا تكون الا علي سبيل السهو والغفلة ، وانهم مءاخذون بذلك وان كان موضوعا عن اممهم لقوة معرفتهم وعلو مرتبتهم ، وحجج هذه المقالات و تسمية قاءليها و الذاهبين اليها ، تحتاج الي بيان و شرح لا يليق بهذا الكتاب . وحصل من هذا اجماع اكثر الناس ان احدا لا يخلو من هفوة وزلة ، والله بكرمه ولي العفو عنها والمسامحة بها ، فلا يعاب ذو فضيلة بوقوعها منه . كان لرسول الله صلي الله عليه وسلم ناقة تسبق ما يجاريها . فجاء اعرابي بناقة له فسبقها ، فقال النبي صلي الله عليه وسلم : حقيق علي الله تعالي ان لا يرفع شيءا الا وضعه .  وقال الاحنف : الشريف من عدت سقطاته . قال النابغة : اي الرجال المهذب . وقالوا : كل صارم ينبو ، وكل جواد يكبو . ومنه قول الاخر : من الطويل هو السيف الا ان للسيف نبوة وكان الاحنف حليما سيدا ، يضرب به المثل ، وقد عدت له سقطات . فمن ذلك انه نظر الي خيل لبني مازن وقال : هذه خيل ما ادركت بالثار ولا نقضت الاوتار ؛ فقال له سعيد بن العلقم المازني : اما يوم قتلت اباك فقد ادركت بثارها . فقال الاحنف : لشء ما قيل : دع الكلام حذر الجواب . وكانت بنو قتلت ابا الاحنف في الجاهلية . ومن سقطاته ان عمرو بن الاهتم دس اليه رجلا يسفهه ، فقال : يا ابا بحر من كان ابوك في قومه ؟ قال : كان من اوسطهم لم يسدهم ولم يتخلف عنهم ، فرجع اليه ثانية ففطن انه من قبل عمرو ، فقال : ما كان مال ابيك ؟ قال : كانت له صرمة يمنح منها ويقري ولم يكن اهتم سلاحا . ولما خرج الاحنف مع مصعب ارسل اليه بماءة الف درهم ، ولم يرسل الي زبراء جاريته بشء ، فجاءت حتي تقدمت بين يدي الاحنف ثم ارسلت عينيها ، فقال لها : ما يبكيك ؟ فقالت : ما لي لا ابكي عليك اذا لم تبك  علي نفسك ؟ ابعد نهاوند ومرو الروذ تجمع بين غارين من المسلمين ؟ فقال : نصحتني والله في ديني اذ لم انتبه لذلك ، ثم امر بفساطيطه فقوضت ، فبلغ مصعبا ذلك فقال : ويحكم من دهاني في الاحنف ؟ فقالوا : زبراء ، فبعث اليها بثلاثين الف درهم ، فجاءت حتي ارخت عينيها بين يديه فقال : ما لك يا زبراء ؟ قالت : جءت باخوانك من اهل البصرة تزفهم كما تزف العروس حتي اذا صيرتهم في نحور اعداءهم اردت ان تفت في اعضادهم ، قال : صدقت والله ، يا غلام دع الفساطيط ، فاضطرب العسكر بمجء زبراء مرتين فذهبت مثلا . وانا اجتنب ذكر ما جاء في هفوات الصالحين والصدر الاول اجلالا لهم عن سوء الظن الا ان يجء ما ليس بخطا علي الحقيقة ، وانما اعترفوا به تواضعا ، كما جاء عن عمر رضي الله عنه ، قال : لا يبلغني ان احدا تجاوز بصداقه صداق النبي صلي الله عليه وسلم الا ارتجعته منها . فقامت امراة فقالت : ما جعل الله تعالي ذلك لك ، يا ابن الخطاب ، ان الله عز وجل يقول : وان اردتم استبدال زوج مكان زوج واتيتم احداهن قنطارا فلا تاخذوا منه شيءا اتاخذونه بهتانا واثما مبينا النساء :  ، فقال عمر : الا تعجبون من امام اخطا وامراة اصابت ؟ ناضلت امامكم فنضلته ، وعمر رضي الله عنه انما قال ذلك زجرا ليقتدوا بسنة الرسول صلي الله عليه وسلم في صدقات النساء ولم يوجبه عليهم ، والاية التي احتجت بها المراة ليست في الصداق .  روي قتادة ان الحسن سءل عن قوله تعالي : قد جعل ربك تحتك سريا مريم :  ، فقال : ان كان لسريا وان كان لكريما ، فقال : من هو ؟ قال : المسيح ، فقال له حميد بن عبد الرحمن : اعد نظرا انما السري الجدول فتمعر لونه ، وقال : يا حميد ، غلبنا عليك الامراء . وكان ابو حنيفة يلحن ، فسمعه ابو عمرو بن العلاء يتكلم في الفقه ويلحن ، فاستحسن كلامه واستقبح لحنه ، فقال : انه لخطاب لو ساعده صواب ، ثم قال لابي حنيفة : انك احوج الي اصلاح لسانك من جميع الناس . وساله رجل يوما فقال : ما تقول في رجل تناول صخرة فضرب بها راس رجل فقتله اتقيده به ؟ فقال : لا ولو ضربه بابا قبيس . وقد احتج قوم لابي حنيفة وزعموا انه لم يلحن ، وقالوا : اسم الجبل هكذا وليس بكنية ؛ وروي ان عطاء كذا كان يقول ، وكذاك ابن عباس ، ولا يشك في فصاحته ، ويحتجون بلغة بلحارث بن كعب ، وانهم يسوون في التثنية بين النصب والجر ؛ وينشدون بين المتلمس : من الطويل فاطرق اطراق الشجاع ولو راي . . . مساغا لناباه الشجاع لصمما ويقولون : رايت اباه وابا اباها . . . قد بلغا في المجد غايتاها والاحسن في هذا ان يكون قولهم : ابا قبيس اسما للجبل ليس بكنية ، فلا يغير بتغيير العوامل فيه ، ويصير كالاسم الواحد .  وكان بشر المريسي يقول لجلساءه : قضي الله لكم الحواءج علي احسن الوجوه واهنءها ، فسمع قاسم التمار قوما يضحكون من ذلك فقال : هذا كما قال الشاعر : من المنسرح ان سليمي والله يكلءها . . . ضنت بشء ما كان يرزءها فكان احتجاجه لبشر اعجب من لحنه ، وهما متقدمان في اصحاب الكلام . قال سعيد بن المسيب : ما فاتني الاذان في مسجد رسول الله صلي الله عليه وسلم منذ اربعين سنة ، ثم قام يريد الصلاة فوجد الناس يخرجون من المسجد . وقال قتادة : ما نسيت شيءا قط ، ثم قال : يا غلام ناولني نعلي ، قال : النعل في رجلك . كان عامر بن عبد الله بن الزبير في غاية الفضل والدين ، وكان لا يعرف الشر ، فاتي بعطاءه الي المسجد فاخذه ، وقام الي منزله ونسيه ثم ذكره في بيته ، فقال لخادمه : ادخل المسجد فاءتني بعطاءي ، قال : واين تجده بعد ؟ قال : سبحان الله وياخذ احد ما ليس له ؟ قال الحسن بن زياد : مر ابن ابي ليلي بجبانة الكوفة علي امراة مجنونة يقال لها ام عمران تعرض لها رجل فشتمته ، فامر ابن ابي ليلي بادخالها الي المسجد وبان تضرب الحد ، فشتمت اخر باقبح من شتيمة الاول ، فامر ان تضرب الحدين . قال فبلغ ابا حنيفة ذلك ، قال الحسن : وكنت حاضرا مجلس ابي حنيفة ، فبعث اربعة انفس واحدا بعد واحد حتي تقصوا الخبر وعادوا اليه ، فوقف علي صحته ، فقال : ان للعلماء زلات ، ولكن يجب ان تخفي وان يقال لهم في السر : فان كان الامر كما قلتم فانظروا من يثق به من  اصدقاءه يلقاه في سر ، ويخبره ان الذي قد عمل قد وهم فيه . اما اولها فان المجنون لا يجب عليه الحد ، وانه حكم بغير خصم حاضر ادعي ذلك ، وذلك ان الرجل الذي شتمه مضي ولم يقف ؛ وانه اقام حدا في المسجد ، والحدود لا تقام في المساجد ؛ وجمع عليها حدين في مقام واحد ، ولا يجوز ان يجمع علي مسلم حدان في موضع حتي يبرا الاول ويقام عليه الثاني . واما حده اياها وهي قاءمة ، فليس بين المسلمين خلاف ان المراة لا تضرب قاءمة ، ولكن تضرب جالسة ، والمراة اذا احتاج الحاكم ان يحدها ، احضر وليها حتي يتولي من سترها ما لعله ان ينكشف منها ؛ واما انكشاف شعرها حين ضربت فلم يامر احدا ان يغطيه ، وقد كان يجب ان يامر امراة تغطيه . قال الشعبي : اخطات عند عبد الملك بن مروان في اربع ، حدثني بحديث فقلت : اعده علي ، فقال : اما علمت ان امير المءمنين لا يستعاد ؛ وقلت حين اذن لي : انا الشعبي يا امير المءمنين ؟ فقال : ما ادخلناك حتي عرفناك ؛ وكنيت عنده رجلا فقال : اما علمت انه لا يكني احد عند امير المءمنين ؛ وسالته ان يكتبني حديثا ، فقال : انا نكتب ولا نكتب . وليس ما ذكره الشعبي عن نفسه ونسبها فيه الي الخطا بخطا ، وانما تخلق عبد الملك باخلاق الجبابرة ، وخالف اخلاق الحنيفية السهلة ، فكان غلط الشعبي مضافا اليها . ؟ وانا اكره ذكر ما اخ علي الفقهاء ونسبوا فيه الي الغلط ، بل لكل منهم فضيلة الاجتهاد ، وزلة الراي  ما لم يتعمد  مغفورة . وترك ما وهموا  فيه وتجنبه ، مع الاعتراف لهم ، جامع للاحتياط وحسن الظن بهم . قال المعتمر بن سليمان : اياك والاقتداء بزلات اصحاب النبي صلي الله عليه وسلم ، فتقول : فلان شرب النبيذ ، وفلان سمع الغناء ، وفلان لعب بالشطرنج ، فيجء منك فاسق تام . ؟ كان هشام بن عبد الملك من رجال بني امية ودهاتهم ، وكان المنصور يعده افضل من معاوية ومن عبد الملك ابيه ، وعدت له سقطات ، منها ان الحادي حدا به فقال : من الرجز ان عليك ايها البختي . . . اكرم من يمشي به المطي فال هشام : صدق . والاخري ذكر عنده سليمان فقال : والله لاشكونه يوم القيامة الي امير المءمنين عبد الملك . والاخري انه لما ولي الخلافة خطب فقال : الحمد لله الذي انقذني من النار بهذا المقام . ؟ ؟ ؟ كان الحجاج فصيحا محبا للبلاغة ، متحفظا في خطبه ، حتي انه غير القران خوف اللحن ، حيث بدر لسانه الي فتح الهمزة في ان ، فقرا ان ربهم يومءذ ، ثم علم ان اللام لا تكون الا في جواب ان المكسورة فقال : خبير ، ومع هذا قرا : انا من المجرمون منتقمين . قدم العريان بن الهيثم علي عبد الملك بن مروان فقيل له : تحفظ من مسلمة فانه يقول : لان يلقمني رجل حجرا احب الي من ان يسمعني لحنا ، فاتاه العريان ذات يوم فسلم عليه فقال : كم عطاءك ؟ قال العريان : الفين ، فقال : كم عطاءك ؟ قال : الفان ، قال : ما الذي دعاك الي اللحن الاول ؟ قال : لحن الامير  فكرهت ان اعرب ، واعرب فاعربت . فاستحسن كلامه . وكان يزيد بن المهلب فصيحا لم تءخذ عليه زلة في لفظ ، ثم اخذ عليه غلط ، فانه قال علي المنبر  وذكر عبد الحميد بن عبد الرحمن بن زيد ابن الخطاب  فقال : وهذه الضبعة العرجاء ، فاعتدت عليه لحنا ، لان الانثي انما يقال لها الضبع ويقال للذكر الضبعان . قال الزبير : عيب علي ابن قيس الرقيات قوله : من الطويل تقدت بي الشهباء نحو ابن جعفر . . . سواء عليها ليلها ونهارها فناقض بين صدر البيت وعجزه لانه قال في الاول : انه سار سيرا غير عجل ، ثم قال في عجز البيت : سواء عليها ليلها ونهارها ، وهذا غاية الداب في السير . وقد اخطا ايضا في قوله : من المنسرح ما مر يوم الا وعندهمالحم رجال او يالغان دماهكذا الرواية ، فغيرته الرواة الي الصحيح وهو : او يولغان دما . العنزي احد رواة العرب المشهورين ، قال : دخلت علي زياد فقال : انشدني ، فقلت : من شعر من ايها الامير ؟ قال : من شعر الاعشي فانشدته : من الكامل رحلت سمية غدوة اجمالها غما اتممت القصيدة حتي تبينت الغضب في وجهه ، وقال الحاجب للناس :  ارتفعوا ، فقاموا . قال : ثم لم اعد اليه والله بعدها . واستمع حماد لرواية هذه الحكاية قال : فكنت بعد ذلك اذا استنشدني خليفة او امير تنبهت قبل ان انشده لءلا يكون في القصيدة ذكر امراة له او بنت او ام . قال ابن دريد : وجدت للجاحظ في كتاب البيان تصحيفا شنيعا ، فانه قال : حدثني محمد بن سلام قال : سمعت يونس يقول : ما جاءنا عن احد من رواءع الكلام ما جاءنا عن النبي صلي الله عليه وسلم ؛ وانما هو عن ابي عثمان البتي . فاما النبي صلي الله عليه وسلم فلا شك عند الملي والذمي انه كان افصح الخلق . وفي هذا الكتاب قال الجاحظ : يستحسن من النساء اللحن ، وانشد لمالك بن اسماء بن خارجة يحتج لقوله : من الخفيف منطق صاءب وتلحن احيا . . . نا وخير الحديث ما كان لحنا قال علي بن المنجم : قلت له : مثلك في فضلك وعلمك يقول هذا ؟ وانما اراد وصفها بالظرف والفطنة ، وانها توري عما قصدت له ، وتتنكب التصريح . فاعترف بذلك وقال : اني تنبهت له من بعد ؛ قلت : فلم لا تغيره من الكتاب ؟ فقال : كيف بما سارت به الركبان ؟ واللحن هنا : الكناية عن الشء والتعريض بذكره ، والعدول عن الايضاح به علي معني قوله تعالي : ولتعرفنهم في لحن القول محمد :  . وقد تبع عبد الله بن مسلم بن قتيبة الجاحظ ، فذكر في كتابه المعروف بعيون الاخبار ابيات مالك هذه ، واعتذر لها من لحن ان اصيب فيه . وقول رسول الله صلي الله عليه وسلم : لعل احدكم الحن بحجته ، اي افطن واغوص عليها .  من هذا ايضا : انشد ابو البيداء الرياحي ابا عمرو : من الطويل ولو ان حيا للمنايا مقاتلا . . . يكون لقاتلنا المنية عن معن فتي لا يقول الموت من حر وقعه . . . لك ابنك خذه ليس من شيمتي دعني فقال له ابو عمرو : صحفت ، انما هو قتالا يقول الموت . انشد العماني الراجز الرشيد شعرا يقول منه : من الرجز كان اذنيه اذا تشوفا . . . قادمة او قلما محرفا وعلم الجماعة انه لحن ولم يهتدوا الي اصلاحه ؛ فقال الرشيد : اجعله تخال اذنيه . كان اسحاق بن ابراهيم الموصلي من الادب والفضل بالمكان المشهور ، وكان الاصمعي يعارضه . فانشده اسحاق بيتين كان يعجب بهما وهما : من الخفيف هل الي نظرة اليك سبيل . . . يرو منك الصدي ويشف الغليل ان ما قل منك يكثر عندي . . . وكثير من المحب القليل فقال له الاصمعي : قد لحنت في قولك يرو ، واخذت البيت الثاني من قول عمر بن ابي ربيعة : من الخفيف وكثير منها القليل المهنا فلم يكن من اسحاق جواب  وقد احتج قوم لاسحاق بما انشده ابو اسحاق الشيرازي : من الرجز كفاك كف لا تليق درهما . . . جودا واخري تعط بالسيف الدما  وقالوا : الاصل في الافعال الجزم ، وانما دخل في المضارع لمضارعته الاسماء ، واستعملوه كذا في ضرورة الشعر . اسحاق مع كثرة فضاءله ، وتوفر معانيه وخصاءصه ، ومنها دماثته وكمال عقله ، يتحقق بالشجاعة والفروسية ، ويحب ان ينسب اليها افة من الافات المعترضة علي العقول ، وغفلة لا يخلو منها ذوو الحلوم ؛ وشهد بعض الحروب فاصابه سهم فنكص علي عقبيه حتي قال اخوه طياب فيه : من المتقارب وانت تكلف ما لا تطيق . . . وقلت انا الفارس الموصلي فلما اصابتك نشابة . . . رجعت الي بيتك الاول قال كيسان : سمعت ابا عبيدة ينشد : من البسيط ما زال يضربني حتي خزيت له . . . وحال من دون بعض البغية الشفق فقلت : خزيت خزيت ؟ وضحكت فغضب وقال : كيف هو ؟ قلت : انما هو خذيت . فانخزل وما احار جوابا . وروي ابو عبيدة ابيات لقيط في يوم جبلة : من الرجز يا قوم قد حرقتموني باللوم . . . ولم اقاتل عامرا قبل اليوم سيان هذا والعناق والنوم . . . والمشرب البارد في ظل الدوم وقالوا : يعني في ظلال نخل المقل . قال الاصمعي : قد احال ابن الحاءك ؛ انما هو في الظل الدوم ، اي الداءم وجبلة بنجد .  وروي الاصمعي بيت الحارث بن حلزة : من الخفيف عنتا باطلا وظلما كما تع . . . نز عن حجرة الربيض الظباء وقال : العنزة الحربة ينخر بها . فرد عليه ابو عمرو وقال : انما هو تعتر من العتيرة وهي ذبيحة للصنم ، وكانوا ينذرون للاصنام ذبيحة ثم تشح نفوسهم فيذبحون عنها الظباء . وروي لذي الرمة : من البسيط فيها الضفادع والحيتان تصطخب فقيل : هو تصطحب ، ولا صوت لها . وروي لرءبة : من الرجز شمطاء تنوي الغيظ حين ترام وانما هو تبوي ، اي تجعله بمنزلة البو . وروي المفضل : من الطويل نمس باعراف الجياد اكفنا فقال له خلف : انما هو نمش وهو مسح اليد ؛ ومنه قيل للمنديل مشوش . وليس علينا ان يزل الوهم او يجنح الخاطر ، او يشذ عنه علم في  وقت ثم يثوب فيدركه . قال ابو موسي الحامض : قرء علي ثعلب كتاب بخط ابن الاعرابي فيه خطا فرده ، فقيل انه بخطه فقال : هو خطا ؛ قيل : فيغير ؟ قال : دعوه ليكون عذرا لمن اخطا . كان حماد الراوية لا يقرا القران ، فاستقرء فقرا في المصحف فصحف في نيف وعشرين موضعا . فمن جملتها : واوحي ربك الي النحل ان اتخذي من الجبال بيوتا ومن الشجر ومما يغرسون ؛ وما كان استغفار ابراهيم لابيه الا عن موعدة وعدها اباه ؛ ليكون لهم عدوا وحربا ؛ وما يجحد باياتنا الا كل جبار كفور ؛ فعززوه ونصروه ؛ وتعززوه وتوقروه ؛ لكل امرء منهم يومءذ شان يعنيه ؛ هم احسن اثاثا وريا ؛ عذابي اصيب به من اساء ؛ يوم يحمي غليها في نار جهنم فبادوا ولات حين مناص ؛ ونبلو خياركم ؛ صنعة الله ومن احسن من الله صنعة ؛ فاستعانه الذي من  شيعته ؛ سلام عليكم لا نتبع الجاهلين ؛ قل ان كان للرحمن ولد فانا اول العاءذين . قال الحزنبل : كنا عند ابن الاعرابي ومعنا ابو هفان ، فانشد ابن الاعرابي عمن انشده ، فقال ابن ابي سبة العبلي : من المتقارب افاض المدامع قتلي كذا . . . وقتلي بكبوة لم ترمس فغمز ابو هفان رجلا وقال : قل له ما معني كذا ؟ فقال : يريد كثرتهم . فلما قمنا قال لي ابو هفان : سمعت الي هذا المعجب الرقيع هو ابن ابي سنة ، وصحف في بيت واحد موضعين ، فقال : قتلي كذا وهو كدا ، وقال : بكبوة وهو بكثوة ؛ واغلط من هذا علي انه يفسر تصحيفه بوجه وقاح . وابن ابي سنة هو ابو سعيد مولي فايد من موالي بني امية ، وكان شاعرا مغنيا ؛ وهذا البيت من شعره يرثي به مواليه ويذكر قتل بني هاشم اياهم . وذكر ابو تمام في كتاب الحماسة شعر ابن المقفع يرثي يحيي بن زياد : من الطويل فان تك قد فارقتنا وتركتنا . . . ذوي خلة ما في سداد لها طمع فقد جر نفعا فقدنا لك اننا . . . امنا علي كل الرزايا من الجزع فقال ابو رياش : هذا ماخوذ من قول النمري منصور : من الوافر  لقد عزي ربيعة ان يوما . . . عليها مثل يومك لا يعود وانما ياخذ الاحدث من الاقدم ، وابن المقفع قتل في خلافة المنصور ، والنمري انما عرف شعره في خلافة الرشيد ، فهو الاولي بان ينسب الي اقتفاء ابن المقفع . قصد محمد بن الفضل بن يعقوب ابن داود العتبي  وكان قد وقع بين محمد وبين ابيه الفضل وحشة  فقال له : كنت عند ابي فتهدم علي تهدم الحاءط ، فتركته حتي سكن غباره ، ثم جعلت اتاتي له ، فادخل بيني وبينه حتي يرضي عنه . فقال العتبي : اني لاكره ان ادخل بين الرجل وبين ابيه . فقال له محمد : هذه سقطة قد كنت امنها عليك ، انك لتدخل بين الرجل وبين ربه فتقول له : كل كذا ، واصنع كذا ، ودع كذا ، فقال العتبي : يا غلام اسرج لي ، فقال محمد : لا حاجة لي في ركوبك ، من كان هذا اسقاطه عند الابناء كيف يكون تهوره عند الاباء ؟ قال ابو الحسن الطوسي : كنا في مجلس علي اللحياني ، وكان عازما علي ان يملي نوادر ضعف ما كان املي . فقال يوما : تقول العرب : مثقل استعان بذقنه ، فقام اليه يعقوب بن السكيت ، وهو يومءذ حدث ، فقال له : يا ابا الحسن ، العرب تقول : مثقل استعان بدفيه ، يريدون الجمل اذا نهض بحمله استعان بجنبيه . فقطع الاملاء . فلما كان المجلس الثاني املي فقال : العرب تقول هو جاري مكاشري . فقام اليه يعقوب فقال : اعزك الله ، انما هو مكاسري كسر بيتي الي كسر بيته ، فقطع الاملاء فما املي شيءا بعد ذلك . مرض ابو يوسف فعاده ابو حنيفة مرارا ، وراه في اخر مرة ثقيلا ، فاسترجع وقال : لقد كنت اءملك بعدي للمسلمين ، ولءن اصيب الناس بك ليموتن علم كثير معك ، ثم رزق العافية وخرج من العلة ؛ واخبر ابو يوسف بقول ابي حنيفة فيه ، فارتفعت نفسه ، وانصرفت وجوه الناس اليه ؛ فعقد لنفسه مجلسا ،  وقصر عن حضور مجلس ابي حنيفة . فسال عنه فاخبر بحاله ، فدعا بغلام كان له عنده قدر وقال له : صر الي مجلس يعقوب وقل له : ما تقول في رجل دفع الي قصار ثوبا ليقصره بدرهم ، فصار اليه بعد ايام في طلب الثوب ، فقال له القصار : ما لك عندي شء وانكره ؛ ثم ان رب الثوب رجع اليه ، فدفع اليه الثوب مقصورا ، اله اجرة ؟ فان قال : له اجرة فقل : اخطات ، وان قال : لا اجرة له ، فقل : اخطات . فصار اليه وساله فقال : له اجرة ، فقال : اخطات ، فنظر ساعة ثم قال : لا اجرة له ، فقال : اخطات . فقام ابو يوسف من ساعته فاتي ابا حنيفة فقال له : ما جاء بك الا مسالة القصار ، قال : اجل ؛ قال : سبحان الله ، من عقد لنفسه مجلسا وقعد يفتي الناس ، ويتكلم في دين الله وهذا قدره ، لا يحسن ان يجيب في مسالة من الاجارات . فقال : يا ابا حنيفة علمني . قال : ان كان قصره بعدما غصبه فلا اجرة له ، لانه قصره لنفسه ، وان كان قصره قبل ان غصبه فله اجرة لانه قصره لصاحبه . ثم قال : من ظن انه يستغني عن العلم فليبك علي نفسه . مات ولد طفل لسليمان بن علي ، فاتاه الناس من اهل البصرة يعزونه ، وفيهم شبيب بن شيبة وبكر بن حبيب السهمي . فقال شبيب : اوليس يقال : ان الطفل لا يزال محبنظيا بباب الجنة حتي يدخل ابواه  فجاء بظاء معجمة  فقال له بكر بن حبيب ، محبنظءا  بطاء غير معجمة فقال شبيب : الا ان من بين لابتيها يعلم ان القول كما اقول ، فقال بكر : وخطا ثان ، ما للبصرة واللوب ؟ اذهبت الي ما قيل بالمدينة : ما بين لابتيها ، اي حريتها ؟ واستشهد في المحبنطء بقول القاءل : من الرجز اني اذا سءلت لا احبنطي . . . ولا احب كثرة التمطي 
  فصل في سرقات فحول الشعراء وسقطاتهم
 ليس منهم فحل مذكور ولا شاعر مشهور الا وقد اسقط وجاء بالرذل الذي لا يرضاه المضعوف البكي ، وما فيهم الا من وجد سارقا مغيرا علي من تقدمه ، وقد تتبعوا باغلاط . فاما فحول الجاهلية فخرج العلماء لاغاليطهم وجها ، واضطروا الي ذلك لان اللغة والاعراب عنهم اخذا ، فلو جعلوا ما جاء عنهم غير جاءز في لغتهم بطل الاستشهاد باشعارهم ؛ ثم انهم لم يجيزوا ذلك لمن اخذ العربية نقلا وتلقينا . وانا ذاكر من ذلك ما يحضرني ويليق بهذا الكتاب مقتصرا ومستدلا بالبعض علي الكل ، والله الموفق للصواب . وخرق الاجماع والخروج عنه منكر ؛ والا فلو قال قاءل : ما المانع من نسبة العربي الفصيح اجاهلي اذا اتي بغير المعتاد من لغتهم الي الغلط والخطا ، فلو نبه عليه لعاد الي الواجب اذ كان غير معصوم ولا محفوظ من وقوع الزلل عليه ، لم يكن عن ذلك جواب محقق . وقد كان النابغة الذبياني كثير الاقواء في شعره ، فلما دخل الحجاز هابوه ان يواقفوه علي هذه العادة المستهجنة ، فامروا قينة فغنته في  قوله : من الكامل  امن ال مية راءح او مغتدي . . . عجلان ذا زيد وغير مزود زعم البوارح ان رحلتنا غدا . . . وبذاك خبرنا الغراب الاسود فاستبان فحش الاقواء وقال : ما هذا ؟ فقالوا : كذا قلت . فجعله وبذاك تنعاب الغراب الاسود ، وترك الاقواء . ولو انصف متاول بيت امرء القيس : من السريع فاليوم اشرب غير مستحقب . . . اثما من الله ولا واغل علي انه اراد اشرب غير ثم اسكن الباء وجعل رب غ مثل عضد ، ولما جاز عندهم عضد وعضد قاس رب غ عليه ، لعلم ان هذا الوجه اذا استعمل في الكلام لم يلحن احد واستغني عن الاعراب . وكذلك قال امرء القيس في قصيدته التي اولها : من الطويل خليلي مرا بي علي ام جندب . . . نقض لبانات الفءاد المعذب ثم قال فيها : عقيلة اتراب لها لا ذميمة . . . ولا ذات خلق ان تاملت جانب ولو استعمل غيره السناد في قصيدته علي غير حرف السناد لمنع منه . وكم له من غاية تلهي السامع ثم يدركه نقص البشر فيقول : من الطويل  امن ذكر ليلي ان ناتك تنوص . . . فتقصر عنها خطوة وتبوص تبوص وكم من دونها من مفازة . . . ومن ارض جدب دونها ولصوص وزهير ، وهو اصفاهم الفاظا وادقهم كلاما ، يقول : من الطويل فاقسمت جهدا بالمنازل من مني . . . وما سحقت فيه المقادم والقمل فانظر كيف ختم البيت بلفظة القمل وهي اهجن لفظة وابعدها من الاستعمال ، والمقاطع اولي بالمراعاة ، فانها ملموحة مكشوفة ، وعليها يقف الكلام . وقالوا : ان امرا القيس اخذ قوله : من الطويل كان مكاكي الجواء غدية . . . صبحن سلافا من رحيق مفلفل من قول ابي دواد الايادي : من المتقارب تخال مكاكية بالضحي . . . خلال الدقاري شربا ثمالا الدقاري الرياض ، واحدتها دقري محركة . والاعشي اخذ قوله في صفة الطيف : من الكامل يلوينني ديني الغداة واقتضي . . . ديني اذا وقذ النعاس الرقدا من قول عمرو بن قميءة : من المتقارب ناتك امامة الا سءالا . . . والا خيالا يوافي خيالا  يوافي مع الليل ميعادها . . . ويابي مع الصبح الا زوالا وعبيد بن الابرص اخذ قوله : من الكامل والناس يلحون الغوي اذا هم . . . خطءوا الصواب ولا يلام المرشد من قول المرقش الاصغر : من الطويل فمن يلق خيرا يحمد الناس امره . . . ومن يغو لا يعدم علي الغي لاءما واخذ جرير قوله : من الطويل واني لعف الفقر مشترك الغني . . . سريع اذا لم ارض داري احتماليا من قول المخبل السعدي : من الكامل اني لترزءني النواءب في الغني . . . واعف عند مشحة الاقتار ولكن جريرا اكمل المعني وجاء به في نصف بيت في اعذب لفظ واسلمه . واخذ عبدة بن الطبيب قوله : من الطويل فما كان قيس هلكه هلك واحد . . . ولكنه بنيان قوم تهدما من قول امرء القيس ، ولكنه كشف المعني وبينه : من الطويل فلو انها نفس تموت سوية . . . ولكنها نفس تساقط انفسا  واخذ ابو حية النميري قوله : من الطويل فالقت قناعا دونه الشمس واتقت . . . باحسن موصولين كف ومعصم من قول النابغة الذبياني : من الكامل سقط النصيف ولم ترد اسقاطه . . . فتناولته واتقتنا باليد فاحسن ابو حية كل الاحسان وزاد زيادات ليست في بيت النابغة . وكانت قصة الراعي النميري ضد ذلك حيث اخذ قوله : من الطويل واعلم ان الموت يا ام عامر . . . قرين محيط حبله من وراءيا من قول طرفة : من الطويل لعمرك ان الموت ما اخطا الفتي . . . لكالطول المرخي وثنياه باليد فانه قصر عن طرفة كل التقصير معني ولفظا . والاعشي الكبير ميمون بن قيس ، وهو ارقهم طبعا ، واسلمهم لفظا ، واقلهم اغلاقا ، يقول وهو يتغزل ويصف ريق شبابه ولهوه مع اترابه ، وقبوله عند الكواعب ، وما قضاه في صباه من المارب : من الكامل فرميت غفلة عينه من شاته . . . فاصبت حبة قلبها وطحالها ويقول في مقام الوصف ومنتهي التمثيل : من المتقارب وهل تنكر الشمس شمس النهار . . . ولا القمر الباهر الابرص  ويقول في مدح الملوك : من الطويل ويقسم امر الناس يوما وليلة . . . وهم ساكتون والمنية تنطق فاحسن وابلغ ثم قصر وتاخر وافحش فقال بعده : من الطويل ويامر لليحموم في كل ليلة . . . بقت وتعليق فقد كاد يسنق فانظر الي هذا التباعد والفصال . ثم يقول في موضع الحكمة ومظنة تهذيب اللفظ والمعني ، فياتي بما لا معني فيه ولا لفظ له : من المنسرح  ان محلا وان مرتحلا . . . وان للسفر ما مضي مهلا قال نقاد الشعر : الشعر اربعة اضرب : ضرب حسن لفظه ومعناه ، فاذا نثر لم يفقد حسنه ، وذلك نحو : من البسيط في كفه خيزران ريحه عبق . . . من كف اروع في عرنينه شمم يغضي حياء ويغضي من مهابته . . . فما يكلم الا حين يبتسم وضرب حسن لفظه وخلا معناه نحو : من الطويل ولما قضينا من مني كل حاجة . . . ومسح بالاركان من هو ماسح اخذنا باطراف الاحاديث بيننا . . . وسالت باعناق المطي الاباطح وضرب جاد معناه وقصر لفظه نحو : من الطويل خطاطيف حجن في حبال متينة . . . تمد بها ايد اليك نوازع وضرب قصر معناه ولفظه نحو : من المنسرح ان محلا وان مرتحلا . . . وان للسفر ما مضي مهلا المعني ان لنا محلا ، وان لنا مرتحلا ، وان لنا مهلا بعد السفر الذي مضي . وما احسن ما قال الواءلي : من الطويل وحاطب ليل في القريض زجرته . . . وقلت له قول النصيح المجامل اذا انت لم تقدر علي در لجه . . . فدعه ولا تعرض لحصباء ساحل وقد اخذ الاعشي قوله من قول النابغة : من الكامل تجلو بقادمتي حمامة ايكة . . . بردا اسف لثاته بالاثمد وتبعه القتال الكلابي فقال : ولم يمنعه اشتهار هذين البيتين من الاغارة وسلك في سرقة الشعر مسلكه في الغارة علي المال ، فانه كان من مشهوري اللصوص وفتاكهم وشعراءهم : من الكامل تجلو بقادمتي حمامة ايكة . . . برد اسف لثاته مثلوج وفي اعرابه كلام وتاويل . ومن المصالتة والمجاهرة في السرقة قول قيس بن الخطيم ، وهو شاعر الاوس وفتاها وشجاعها : من الطويل وما المال والاخلاق الا معارة . . . فما اسطعت من معروفها فتزود وكيف يخفي ماخذه مع اشتهار قصيدة طرفة بن العبد ، وهي معلقة علي  الكعبة ، وهو يقول فيها : من الطويل لعمرك ما الايام الا معارة . . . فما اسطعت من معروفها فتزود قال ابو نواس : قد قال شاعران بيتين ووضعا التشبيه فيهما في غير موضعه ، فلو اخذ البيت الثاني من شعر احدهما فجعل مع البيت الاخر ، واخذ بيت ذاك فجعل مع هذا ، كان لفقا له ومشبها ، فقيل له : اي ذلك تعني ؟ قال : قول جرير للفرزدق : من الطويل فانك اذ تهجو تميما وترتشي . . . تبابين قيس او سحوق العماءم كمهريق ماء بالفلاة وغره . . . سراب اثارته رياح السماءم وقول ابن هرمة : من المتقارب واني وتركي ندي الاكرمين . . . وقدحي بكفي زندا شحاحا كتاركة بيضها بالعراء . . . وملحفة بيض اخري جناحا فلو قال جرير : فانك اذ تهجو تميما ، وبعده كتاركة بيضها بالعراء ، لكان اشبه ببيته ، ولو قال ابن هرمة مع بيته : واني وتركي ندي الاكرمين ، وبعده كمهريق ماء بالفلاة ، لكان اشبه . هكذا جاءت الرواية عن ابي نواس ؛ وهو ايضا وهم فان الشعر للفرزدق من قصيدته التي اولها : من الطويل تحن بزوراء المدينة ناقتي  قالها لما قتل وكيع بن ابي سود قتيبة بن مسلم بخراسان . وجرير كان مولعا بمدح قيس ، والفرزدق يهجوهم ، وذلك محقق لما ذكرته ايضا . قال سلمة بن عياش : دخلت علي الفرزدق السجن وهو محبوس ، وقد قال قصيدته التي فيها : من الكامل ان الذي سمك السماء بني لنا . . . بيتا دعاءمه اعز واطول وقد افحم واجبل ، فقلت له : الا ارفدك ؟ فقال : وهل ذاك عندك ؟ فقلت : نعم ، ثم قلت : بيت زرارة محتب بفناءه . . . ومجاشع وابو الفوارس نهشل فاستجاد البيت وغاظه قولي ، فقال لي : ممن انت ؟ قلت : من قريش ؛ قال : فمن ايها انت ؟ قلت : من بني عامر بن لءي فقال : لءام والله ضعة ؛ جاورتهم بالمدينة فما احمدتهم . فقلت : الالام والله منهم وارضع قومك ، جاءك رسول مالك بن المنذر ، وانت سيدهم وشاعرهم ، فاخذ باذنك يقودك حتي حبسك ، فما اعترضه ولا نصرك احد . فقال : قاتلك الله ما انكرك ؛ واخذ البيت فادخله في قصيدته . ولما قال ذو الرمة : من الطويل احين اعاذت بي تميم نساءها . . . وجردت تجريد اليماني من الغمد ومدت بضبعي الرباب ومالك . . . وعمرو وسالت من وراءي بنو سعد ومن ال يربوع زهاء كانه . . . زها الليل محمود النكاية والرفد قال له الفرزدق لا تعودن فيها ، فانا احق بها منك ؛ قال : والله لا اعود فيها ولا انشدها ابدا الا لك ، فهي في قصيدة الفرزدق التي يقول فيها : من الطويل  وكنا اذا القيسي نب عتوده . . . ضربناه فوق الانثيين علي الكرد ويروي : وكنا اذا الجبار صعر خده . ومر الفرزدق بالشمردل يوما وهو ينشد : من الطويل وما بين من لم يعط سمعا وطاعة . . . وبين تميم غير حز الغلاصم فقال : والله لتتركنه او لتتركن عرضك ، فقال : هو لك . فانتحله الفرزدق في قصيدته التي اولها : تحن بزوراء المدينة ناقتي انشد الكميت بن زيد نصيبا فاستمع له فكان فيما انشده : من البسيط وقد راينا بها حورا منعمة . . . بيضا تكامل فيها الدل والشنب فثني نصيب خنصره فقال له الكميت : ما تصنع ؟ قال : احصي خطاك تباعدت في قولك : تكامل فيها الدل والشنب ، هلا قلت كما قال ذو الرمة : من البسيط لمياء في شفتيها حوة لعس . . . وفي اللثاث وفي انيابها شنب ثم انشده في اخري : من المتقارب اذا ما الهجارس غنينها . . . تجاوبن بالفلوات الوبارا فقال له نصيب : الوبار جمع وبرة وهي دابة معروفة لا تسكن الفلوات . ثم انشده حتي بلغ الي قوله :   كان الغطامط من جريها . . . اراجيز اسلم تهجو غفارا فقال له نصيب : ما هجت اسلم غفارا قط . فاستحيا الكميت فسكت . والذي عابه نصيب من قبيح الكلام وفاحشه ، فان احسن الكلام ما اتسق وتشاكلت معانيه ، وتقاربت الفاظه ، ولذلك قال ابن لجا لابن عم له : انا اشعر منك ، قال : وكيف ؟ قال : لاني اقول البيت واخاه ، وانت تقول البيت وابن عمه . وانشد الجاحظ : من الطويل وشعر كبعر الكبش فرق بينه . . . لسان دعي في القريض دخيل قال ذلك لان بعر الكبش يقع متفرقا . ولذلك عيب علي ابي تمام قوله : من الكامل لا والذي خلق الهوي ان النوي . . . صبر وان ابا الحسين كريم ولما قال ذو الرمة : من الطويل ابا ظبية الوعساء بين جلاجل . . . وبين النقا اانت ام ام سالم وقف بالمربد ينشد والناس مجتمعون عليه ، فاذا هو بخياط يطالعه ويقول يا غيلان : من الطويل اانت الذي تستنطق الدار واقفا . . . من الجهل هل كانت بكن حلول فقام ذو الرمة وفكر زمانا ثم عاد فقعد بالمربد ينشد ، فاذا الخياط قد وقف عليه وقال له : من الطويل اانت الذي شبهت عنزا بقفرة . . . لها ذنب فوق استها ام سالم  فقام ذو الرمة فذهب ولم ينشد في المربد بعدها حتي مات الخياط . وقال غيلان بن المعذل : قدم علينا ذو الرمة الكوفة فانشدنا بالكناسة وهو علي راحلته قصيدته الحاءية التي يقول فيها : من الطويل اذا غير الناي المحبين لم يكد . . . رسيس الهوي من حب مية يبرح فقال له عبد الله بن شبرمة : قد برح يا ذا الرمة ، ففكر ساعة ثم قال : لم اجد رسيس الهوي من حب مية يبرح . قال : فاخبرت ابي بما كان من قول ذي الرمة واعتراض ابن سبرمة عليه ، فقال : اخطا ذو الرمة في رجوعه عن قوله الاول ، واخطا ابن شبرمة في اعتراضه عليه . هذا مثل قول الله عز وجل : اذا اخرج يده لم يكد يراها النور :  هو لم يرها ولم يكد . قال ابو عبد الله الزبيري : اجتمع راوية جميل وراوية كثير وراوية جرير وراوية نصيب ، فافتخر كل واحد منهم بصاحبه ، وقال صاحبي اشعر ، فحكموا سكينة بنت الحسين لما عرفوه من عقلها وبصرها بالشعر ، فخرجوا حتي استاذنوا عليها ، وذكروا لها الذي كان من امرهم ، فقالت لراوية جرير : اليس صاحبك الذي يقول : من الكامل طرقتك صاءدة القلوب وليس ذا . . . حين الزيارة فارجعي بسلام واي ساعة احلي للزيارة من الطروق ؟ قبح الله صاحبك وقبح شعره ، الا قال : ادخلي بسلام .  ثم قالت لراوية كثير : اليس صاحبك الذي يقول : من الطويل يقر بعيني ما يقر بعينها . . . واحسن شء ما به العين قرت وليس شء اقر بعينها من النكاح ، افيحب صاحبك ان ينكح ؟ قبح الله صاحبك وقبح شعره . وقالت لراوية جميل : اليس صاحبك الذي يقول : من الطويل فلو تركت عقلي معي ما طلبتها . . . ولكن طلابيها لما فات من عقلي فما اري بصاحبك هوي ، انما طلب عقله ، قبح الله صاحك وقبح شعره . ثم قالت لراوية نصيب : اليس صاحبك الذي يقول : من الطويل اهيم بدعد ما حييت وان امت . . . فوا حزنا من ذا يهيم بها بعدي فما اري له همة الا من يعشقها بعده ؟ قبحه الله وقبح شعره الا قال : من الطويل اهيم بدعد ما حييت وان امت . . . فلا صلحت دعد لذي خلة بعدي ثم قالت لراوية الاحوص : اليس صاحبك الذي يقول : من الكامل من عاشقين تواعدا وتراسلا . . . ليلا اذا نجم الثريا حلقا باتا بانعم ليلة والذها . . . حتي اذا وضح الصباح تفرقا قال : نعم ، قالت : قبحه الله وقبح شعره ، هلا قال : تعانقا . فلم تثن علي احد منهم ولم تقدمه . وليس كل ما ذكرته ساقطا ، ولكل منه وجه ولصاحبه فيه قصد ، وانما حسن الخير اذ كان من امراة قد تتبعت فحول الشعراء وظرفت في ما تتبعتهم به ، وقصر رواتهم عن جوابها .  وشبيه به الخير الذي رواه الزبير بن بكار قال : خرج عمر بن ابي ربيعة الي مكة فخرج معه الاحوص واعتمرا . قال الساءب راوية كثير : فلما مرا بالروحاء استتلياني فخرجت اتلوهما حتي لحقتهما بالعرج رواحهما ؛ فخرجنا جميعا حتي وردنا ودان ؛ فحبسهما نصيب وذبح لهما واكرمهما ؛ وخرجنا وخرج معنا نصيب . فلما جءنا كلية عدلنا جميعا الي منزل كثير ، فقيل لنا : هبط قديدا ، فاتينا قديدا فذكر لنا انه في خيمة من خيامها ، فقال لي ابن ابي ربيعة : اذهب فادعه لي ؛ فقال نصيب : هو احمق واشد كبرا من ان ياتيك ؛ فقال لي عمر : اذهب كما اقول لك فادعه لثي . فجءته فهش لي وقال : اذكر غاءبا تره ، لقد جءت وانا اذكرك . فابلغته رسالة عمر فحدد نظره الي وقال : اما كان عندك من المعرفة ما يردعك عن اتياني بمثل هذا وتردعه عن مثل هذه الرسالة ؟ قلت : بلي والله ، ولكني سترت عليك وابي الله الا ان يهتك سترك . فقال لي : اليك يا ابن ذكوان ، ما انت من شكلي ، فقل لابن ابي ربيعة : ان كنت قرشيا فانا قرشي ، فقلت : الا تترك هذا التلصق وانت تقرف عنهم كما تقرف الصمغة ؟ فقال : والله لانا اثبت فيهم منك في سدوس . ثم قال : وقل له ان كنت شاعرا فانا اشعر منك ، فقلت له : هذا اذا كان الحكم اليك . فقال : والي من هو ؟ ومن اولي بالحكم مني ؟ وبعد هذا يا ابن ذكوان فاحمد الله علي لءمك فقد منعك مني اليوم . فرجعت الي عمر فقال : ما وراءك ؟ فقلت : ما قال لك نصيب ، فقال : وان ؟ فاخبرته فضحك وضحك صاحباه ظهرا لبطن . ثم نهضوا معي اليه فدخلنا عليه في خيمته فوجدناه جالسا علي جلد كبش ، فوالله ما اوسع للقرشي . فلما تحدثوا مليا وافاضوا في ذكر الشعر اقبل علي عمر فقال له : انت تنعت المراة وتنسب بها ثم تدعها وتنسب بنفسك ، اخبرني عن قولك : من المنسرح قالت تصدي له ليعرفنا . . . ثم اغمزيه يا اخت في خفر قالت لها قد غمزته فابي . . . ثم اسبطرت تشتد في اثري  وقولها والدموع تسبقها . . . لنفسدن الطواف في عمر اتراك لو وصفت بهذا هرة اهلك ، الم تكن قد قبحت واسات وقلت الهجر ؟ انما توصف الحرة بالاباء والحياء والالتواء والبخل والامتناع كما قال هذا ، واشار الي الاحوص : من الطويل ادور ولولا ان اري ام جعفر . . . بابياتكم ما درت حيث ادور وما كنت زوارا ولكن ذا الهوي . . . اذا لم يزر لا بد ان سيزور قال : فدخلت الاحوص ابهة وعرفت الخيلاء فيه . فلما استبان ذلك كثير منه قال : ابطل اخرك اولك ، اخبرني عن قولك : من الوافر فان تصلي اصلك وان تبني . . . بصرمك بعد وصلك لا ابالي ولا الفي كمن ان سيم صرما . . . تعرض كي يرد الي الوصال اما والله لو كنت فحلا لباليت ولو كسرت انفك ، هلا قلت كما قال هذا الاسود ، واشار الي نصيب : من الطويل بزينب المم قبل ان يرحل الركب . . . وقل ان تملينا فما ملك القلب قال : فانكسر الاحوص ودخلت نصيبا الابهة . فلما نظر الي الكبرياء قد دخلته ، قال له : وانت يا ابن السوداء فاخبرني عن قولك : من الطويل اهيم بدعد ما حييت فان امت . . . فواكبدا من ذا يهيم بها بعدي اهمك من ينيكها بعدك ؟ فقال نصيب : استوت القرفة ، وهي لعبة لهم مثل المنقلة ، قال ساءب : فلما امسك كثير اقبل عليه عمر فقال له : قد انصتنا لك فاسمع يا مذبذب الي . اخبرني عن تخيرك لنفسك وتخيرك لمن تحب حيث  تقول : من الطويل الا ليتنا يا عز كنا لذي غني . . . بعيرين نرعي في الخلاء ونعزب كلانا به عر فمن يرنا يقل . . . علي حسنها جرباء تعدي واجرب اذا ما وردنا منهلا صاح اهله . . . علينا فما ننفك نرمي ونضرب وددت وبيت الله انك بكرة . . . هجان واني مصعب ثم نهرب نكون بعيري ذي غني فيضيعنا . . . فلا هو يرعانا ولا نحن نطلب ويلك اتمنيت لها ولنفسك الرق والجرب والرمي والطرد والمسخ ؟ فاي مكروه لم تتمن لها ولنفسك ؟ لقد اصابها منك مثل قول الاول : معاداة عاقل خير من مودة احمق . قال : فجعل يختلج جسده كله ، ثم اقبل عليه الاحوص فقال له : الي يا ابن استها ، اخبرني بخبرك وتعرضك للشر وعجزك عنه واهدافك لمن رماك ، اخبرني عن قولك : من الطويل وقلن وقد يكذبن فيك تعيفوشءم اذا ما لم تطع صاح ناعقه واعييتنا لا راضيا بكرامة . . . ولا تاركا شكوي الذي امنت صادقه وادركت صفو الود منا فلمتنا . . . وليس لنا ذنب فنحن مواذقه والفيتنا سلما فصدعت بيننا . . . كما صدعت بين الاديم خوالقه والله لو احتفل عليك هاجيك لما زاد علي ما بءت به علي نفسك . قال : فخفق كما يخفق الطاءر . ثم اقبل عليه نصيب فقال : اقبل علي يا زب الذباب ، فقد تمنيت معرفة غاءب عندي علمه فيك حيث تقول : من الطويل وددت وما تغني الودادة انني . . . بما في ضمير الحاجبية عالم فان كان خيرا سرني وتركته . . . وان كان شرا لم تلمني اللواءم انظر في مراتك ، واطلع في جيبك ، واعرف صورة وجهك ، تعرف ما عندها لك . فاضطرب اضطراب العصفور ، وقام القوم يضحكون وجلست عنده .  فلما هدا شاوه قال لي : ارضيتك فيهم ؟ فقلت له : اما في نفسك فنعم ، لقد نحس يومك معهم ، وقد بقيت انا عليك فما عذرك  ولا عذر لك  في قولك : من الطويل سقي دمنتين لم تجد لهما اهلا . . . بحقل لكم يا عز قد رابني حقلا نجاء الثريا كل اخر ليلة . . . يجودهما جودا ويتبعه وبلا ثم قلت في اخرها : وما حسبت ضمرية جدرية . . . سوي التيس ذو القرنين ان لها بعلا اهكذا يقول الناس : سوي التيس ذي القرنين ؟ ويحك ثم تظن ذلك قد خفي ولم بعلم به احد ، فتسب الرجال وتعيبهم ؟ فقال : ما انت وهذا ؟ وما علمك بمعني ما اردت ؟ فقلت : هذا اعجب من ذاك ، اتذكر امراة تنسب بها في شعرك وتستغزر لها الغيث في اول شعرك ، ثم تحمل عليها التيس في اخره ؟ قال : فاطرق وذل وسكن . فعدت الي اصحابي واعلمتهم ما كان من خبره ، فقالوا : ما انت اهون حجارته التي رمي بها اليوم منا ، قال ، فقلت لهم : لم يترني فاطلبه بذحل ، ولكني نصحته لءلا يخل هذا الاخلال الشديد ، ويركب هذه العروض التي ركب في الطعن علي الاحرار والعيب لهم . ومن السرقة الفاحشة قول كثير في عبد الملك بن مروان : من الطويل اذا ما اراد الغزو لم يثن همه . . . حصان عليها عقد در يزينها  اخذه من قوله الحطيءة مصالتة فلم يغير سوي الروي : من الطويل اذا ما اراد الغزو لم يثن همه . . . حصان عليها لءلء وشنوف ومثل ذلك فعل الفرزدق في قوله : من الطويل فما الناس بالناس الذين عهدتهم . . . ولا الدار بالدار التي كنت تعرف نقله من قول العباس بن عبد المطلب رضي الله عنه : من الطويل اذا مجلس الانصار خف باهله . . . وحلت بواديهم غفار واسلم فما الناس بالناس الذي عهدتهم . . . ولا الدار بالدار التي كنت تعلم وجرير علي سعة بحره وقدرته علي غرر الشعر وابكار الكلام نقل قوله : من الوافر فلو كان الخلود لفضل قوم . . . علي قوم لكان لنا الخلود من قول زهير ، وهو شعر مشهور يحفظه الصبيان وترويه النساء : من الطويل فلو كان حمد يخلد المرء لم يمت . . . ولكن حمد المرء غير مخلد وقد قال جرير : من الطويل فانت ابي ما لم تكن لي حاجة . . . فان عرضت ايقنت ان لا ابا ليا فاخذه عبد الله بن معاوية بن عبد الله بن جعفر فقال : من الطويل اانت اخي ما لم تكن لي حاجة . . . فان عرضت ايقنت ان لا اخا ليا  وهو من قصيدة له مشهورة اجاد فيها واحسن كل الاحسان ، ولم تمنعه قدرته علي ذلك الاحسان من الشره الي ما ليس له . وقد قال الشماخ : من الطويل وامر ترجي النفس ليس بنافع . . . واخر يخشي ضيرة لا يضيرها فاغار عليه شبيب بن البرصاء فقال : من الطويل ترجي النفوس الشء لا تستطيعه . . . وتخشي من الاشياء ما لا يضيرها وكان ابو العتاهية مع تقدمه في الشعر كثير السقط ، فروي انه لقي محمد بن مناذر بمكة ، فمازحه وضاحكه ، ثم دخل علي الرشيد فقال : يا امير المءمنين هذا شاعر البصرة يقول قصيدة في كل سنة ، وانا اقول في السنة مءين قصاءد . فادخله الرشيد اليه فقال ما يقول ابو العتاهية . فقال : يا امير المءمنين لو كنت اقول كما يقول لقلت مثله كثيرا : من الهزج الا يا عتبة الساعة . . . اموت الساعة الساعة لقلت مثله كثيرا ، ولكنني اقول : من الخفيف ان عبد المجيد يوم تولي . . . هد ركنا ما كان بالمهدود ما دري نفسه و حاملوه . . . ما علي النعش من عفاف وجود فقال الرشيد : انشدنيها ، فانشده اياها ، فقال : ما لها عيب الا انها سوقة ، وكما كان ينبغي الا ان تكون في خليفة او ولي عهد ، ثم امر له بعشرة الاف درهم ؛ فكاد ابو العتاهية يموت غما واسفا .  ذكر ابو الشيص يوما في مجلس الرياشي فقال : اخطا ابو الشيص في بيت واحد في اربعة اماكن ، وهو قوله : من المتقارب اشاقك والليل ملقي الجران . . . غراب ينوح علي غصن بان فالكلام شاقك لا غير ، فجعل افعل مكان فعل ؛ وذكر ان الذي شاقه بالليل غراب ، والغراب لا يصيح بالليل ؛ وقال : غراب ينوح ، وصياح الغراب لا يقال له نوح انما يقال : نعب الغراب ونعق وشحج ؛ وقال : غراب ينوح علي غصن بان ، وغصن البان اضعف من ان يحمل غرابا . استحسن من ابي نواس قوله : من الطويل اليك رمت بالقوم هوج كانما . . . جماجمها تحت الرحال قبور وهو ماخوذ من قول الوليد بن عدي بن حجر الكندي : من البسيط كان هامتها قبر علي شرف . . . تمد للسير اوصالا واصلابا وطرق الراعي المعني فقال : من الوافر فهن سوابغ الابدان غلب . . . كان رءوسهن قبور عاد وتبعهما كثير فقال : من الكامل كالقبر هامة راسها وكانما . . . منها امام الحاجبين قدوم وابو حية النميري فقال : من الكامل وكان هامته اذا استعرضته . . . قبر برابية عليه الجندل  قال الحسن بن رشيق الازدي الكاتب المغربي في ما جمعه من شعر المغاربة : اجتمعت وانا بيعلي بن ابراهيم الاربسي ، وكانت له مكانة من الخط والترسل وعلم الطب والهيءة مع تقدمه في الشعر ، فاخذ في ذكر الشعراء وغض من عبد الكريم النهشلي  وهو من اعيان وقته  فاغلظت له في الجواب . فالتفت الي منكرا علي وقال : وما انت وما دخولك بين الشيوخ يا بني ؟ فقلت له : ومن يكون الشيخ ايده الله ؟ فعرفني نفسه ثم اخرج رقعة من خطه فيها شعره : من البسيط اياة شمس حواها جسم لءلءة . . . يغيب من لطف فيها ولم تغب صفراء مثل النضار السكب لابسة . . . درعا مكللة درا من الحبب لم يترك الدهر منها غير راءحة . . . تضوعت وسنا ينساح كاللهب اذا النديم تلقاها ليشربها . . . صاغت له الراح اطرافا من الذهب فقال : كيف رايت ؟ فقلت  واردت الاشتطاط عليه : اما البيت الاول فناقص الصنعة ، مسروق المعني ، فيه تنافر ، قال : وكيف ذلك ؟ قلت : لو كان ذكر الياقوتة مع اللءلءة كما قال ابو تمام : من الكامل او درة بيضاء بكر اطبقت . . . حبلا علي ياقوتة حمراء لكان اتم تصنيعا واحسن ترصيعا ولو ذكرت روح الخمر مع ذكرك جسم اللءلءة  يعني الكاس  لكان اوفي للمعني ، ولو قلت مع قولك اياة : شمس حواها نهار وعنيت به الكاس كما قال ابن المعتز ، ويروي للقاضي التنوخي : من المتقارب وراح من الشمس مخلوقة . . . بدت لك في قدح من نهار  لكنت قد ذهبت الي شء عجيب غريب ؛ اما قولك : يغيب من لطف فيها ولم يغب ، فمن قول البحتري : من الكامل يخفي الزجاجة لونها فكانها . . . في الكف قاءمة بغير اناء واما البيت الثاني فاكثر من ان ينبه عليك فيه ، واما الثالث فمن قول ابن المعتز : من البسيط ابقي الجديدان من موجودها عدما . . . لونا وراءحة في غير تجسيم واما البيت الاخير ، فمن قول مسلم بن الوليد : من الطويل اغارت علي كف المدير بلونها . . . فصاغت له منها انامل من ذبل وقوله ايضا : من الطويل اذا مسها الساقي اعارت بنانه . . . جلابيب كالجادي من لونها صفرا وفيه عيب يقال له التوكء ، وهو تكريرك ذكر الراح ، وانت مستغن عنه ، قال : فماذا كنت انت تسد مكان الراح ، قلت : كنت اقول : صاغت ليمناه اطرافا من الذهب . وانشدته لنفسي دون ان اعلمه : من الطويل معتقة يعلو الحباب جنوبها . . . فتحسبه فيها نثير جمان رات من لجين راحة لمديرها . . . فجادت له من عسجد بينان ثم انشد يصف بستانا : من البسيط تفيض بالماء منه كل فوهة . . . فكل فوارة بالماء تنذرف كانها بين اشجار منورة . . . ظلت بمستحسن اللبلاب تستجف مجامر تحت اثواب مجللة . . . علي مشاجبها دخانها يهف  فقال : هل تعلم في هذا المعني شيءا ؟ فلم ارد مكاشفته ، فاضربت عن ابيات علي ابن العباس الرومي في تشبيه المجمرة بالفوارة ، وانما عكسه يعلي ، وقلت : بل قريبا منه ، وانشدته لنفسي شعرا ؛ فقال : لمن انشدتني بدءا وعودة ؟ قلت : للذي انكرت عليه ان يدخل بين الشيوخ ؛ فعرف ، وعرف بي فاستصحبني منذ ذلك اليوم . لما ورد الخالديان العراق فيهما السري الرفاء يخاطب ابا الخطاب الصابي : من الكامل بكرت عليك مغيرة الاعراب . . . فاحفظ ثيابك يا ابا الخطاب ورد العراق ربيعة بن مكدم . . . وعتيبة بن الحارث بن شهاب وهي قصيدة مشهورة من عيون شعره . فاستحسن هذا المعني واستجيد ، وانما اخذه من قول ابي تمام ، وقد سرق شعره محمد بن يزيد الاموي فمدح به : من الخفيف من بنو عامر من ابن الحباب . . . من بنو تغلب غداة الكلاب من طفيل بن عامر ومن الحا . . . رث ام من عتيبة بن شهاب وبشار يسمونه ابا المحدثين لتقدمه وتسليمهم اليه الفضيلة والسبق ، وبعض اهل اللغة يستشهدون بشعره لزوال الطعن عليه فيها فمما اسقط فقال : من الرمل انما عظم سليمي حبتي . . . قصب السكر لا عظم الجمل واذا ادنيت منها بصلا . . . غلب المسك علي ريح البصل  يقول هذا مع قوله في معني مثله : من الوافر اذا قامت لمشيتها تثنت . . . كان عظامها من خيزران ومع قوله في الفخر : من الطويل كان مثار النقع فوق رءوسنا . . . واسيافنا ليل تهاوي كواكبه ومع قوله : اذا انت لم تشرب مرارا علي القذي . . . ظمءت واي الناس تصفو مشاربه وقال له خلاد : انك لتجء بالشء المهجن المتفاوت ، قال : وما ذاك ؟ قال : بينما تقول شعرا تثير به النقع وتخلع القلوب مثل قولك : من الطويل اذا ما غضبنا غضبة مضرية . . . هتكنا حجاب الشمس او قطرت دما اذا ما اعرنا سيدا من قبيلة . . . ذري منبر صلي علينا وسلما علي ان بيتي بشار منقولان ، فالاول انشده ابو هلال العسكري للقحيف واوله : من الطويل اذا ما فتكنا فتكة مضرية . . . هتكنا حجاب الشمس او قطرت دما والثاني هو بيت جرير بعينه : من الطويل منابر ملك كلها مضرية . . . يصلي علينا من اعرناه منبرا الي ان تقول : من الهزج ربابة ربة البيت . . . تصب الخل في الزيت لها عشر دجاجات . . . وديك حسن الصوت فقال : لكل شء وجه وموضع ؛ فالقول الاول جد ، وهذا قلته في ربابة جاريتي ، وانا لا اكل البيض من السوق ، وربابة هذه لها عشر دجاجات  وديك ، فهي تجمع البيض لي وتحفظه عندها ؛ فهذا قولي عندها احسن من قفا نبك من ذكري حبيب ومنزل عندك . وهذا عذر غير واضح ، وهو باستءناف ذنب اولي . وقد كان يسعه ان يقول ما تفهمه الامة ولا يسقط هذا السقوط . وما الذي احوجه الي ان يدونه ويروي عنه ؟ واي حجة له في البيتين الاولين لولا الزلل والنقص المستوليان علي البشر . وابو تمام ، مع باهر فضله وبديع نظمه ونطقه بالشعر الذي لو سمي سحرا لكان اليق ، يقول : من الوافر خشنت عليه اخت بني خشين ويظن ذلك من البديع الذي اخترعه وسلك مذهبه . ويقول يمدح رجلا ويصفه بالتنين : من الكامل ولي ولم يظلم وهل ظلم امرء . . . حث النجاء وخلفه التنين وقال ايضا وهجن : من الكامل كانوا رداء زمانهم فتصدعوا . . . فكانما لبس الزمان الصوفا واغار علي زهير حيث يقول : من الوافر لمن طلل برامة لا يريم فقال : من الوافر ارامة كنت مالف كل ريم  وقد قال ، وبعد عن الفصاحة وهو امامها : من الكامل والمجد لا يرضي بان ترضي بان . . . يرضي امرء يرجوك الا بالرضا وكذلك الرضي ابو الحسن الموسوي ممن شهد بفضله الاعداء ، وترجم شعره اكابر العلماء ، وقد كان علمه اكثر من شعره ، وله تصنيف في علم القران برز فيه علي القدماء ، ثم لم يمنعه اقتداره علي درر الكلام وجواهر المعاني من التعرض لما ليس له ، والغارة الشعواء علي متقدمي الشعراء . وقد كان غنيا ببنات صدره عن الاستلحاق ، ومكفيا بمصون خاطره عن الاستطراق . وقد عثرت له علي زلل يرتفع قدره عنه ، وسهو لو تنبه له غيره . ولعل غليان الخاطر وازدحام البيان ، شغله عن تفقد ما جري به اللسان . وساقتصر علي البعض اذ كان القصد بكشف غلط مثله من صدور العلم اقامة عذر من لم يبلغ شاوه . فمما سها في اعرابه وغفل عن تصحيحه قوله : من البسيط ترجو وبعض رجاء الناس متعبة . . . قد ضاع دمعك يا باك علي الطلل فرفع المنادي المشبه بالمضاف وحقه النصب . ومثله قوله ايضا : من الطويل ولم انسه غاد وقد احدقت به . . . ادان تروي نعشه واقارب ومن ذلك قوله : من الطويل واين المطايا تذرع البيد والدجي . . . الي اقرب من نيل عز وابعد ولم تستعمل العرب افعل التفضيل الا جاءت بمن ، كقولهم : اقرب من  كذا ، او ياتي بالالف واللام فيخرج عن معني التفضيل كقولهم الاقرب والابعد . ومنه قوله : من الطويل الا ان اصناف السيوف كثيرة . . . واقطعها هنديها ويمانها وانما هو سيف يمان اذا خفف الياء ، فاما نقله الي ما يجري الاعراب عليه في حالة الرفع فما تكلمت به العرب . ومما اهمل قوافيه واجري منصوبه مجري مرفوعه ، ولم يرخص احد في مثله ، قوله : من الطويل اذا سكر العسال من قطراتها . . . سقيت حمياها اغر يماني وقوله : من الكامل كم من طويل العمر بعد وفاته . . . بالذكر يصحب حاضرا او بادي علي ان المعني واللفظ لغيره وهو : من الكامل كم من طويل العمر بعد مماته . . . ويموت اخر وهو في الاحياء وقول المتنبي : ذكر الفتي عمره الثاني والاصل قول الاول : ان الثناء هو الخلود ومما استعار فيه كلام المتقدمين ولم يراقب تصفح المتاملين قوله :  من البسيط هل تعلمون علي ناي الديار بكم . . . ان الضمير اليكم شيق ولع وهو قول ابي زبيد الطاءي بعينه : من البسيط من مبلغ قومي الناءين ان شحطوا . . . ان الفءاد اليهم شيق ولع وقوله : من الطويل مرمون من قبل اللقاء مهابة . . . اذا رمقوا باب الطراف الممدد من قول جرير : من الطويل مرمون من ليث عليه مهابة . . . تفادي الاسود الغلب منه تفاديا وقوله : من الوافر اروني من يقوم لكم مقامي . . . اروني من يقول لكم مقالي فقوله : اروني من يقوم لكم مقامي ، هو صدر بيت لجرير : من الوافر اروني من يقوم لكم مقامي . . . اذا ما الامر جل عن الخطاب ؟ وقوله : من الكامل لا تبعدن واين قربك بعدها . . . ان المنايا غاية الابعاد من قول مالك بن الريب : من الطويل يقولون لا تبعد وهم يدفنونني . . . واين مكان البعد الا مكانيا ؟  وقوله : من الكامل قرف علي قرح تقادم عهده . . . ان القروف علي القروح لاوجع من بيت الحماسة المشهور : من الطويل فلم تنسني اوفي المصيبات بعده . . . ولكن نكء القرح بالقرح اوجع ؟ وقوله : من البسيط فكاذب النفس يمتد الرجاء لها . . . ان الرجاء بصدق النفس ينقطع من قول لبيد : من الرمل واكذب النفس اذا حدثتها . . . ان صدق النفس يزري بالامل ؟ وقوله : من الخفيف وندامي تفرقوا بعد الف . . . شغلوا الدمع بعدهم ان يعارا وهو قول الشمردل اليربوعي بعينه : من الطويل وكنت اعير الدمع قبلك من بكي . . . فانت علي من مات بعدك شاغله وقوله في صفة الخيل : من الطويل خوارج من ذيل الغبار كانها . . . انامل مقرور دنا النار صاليا هو بيت الاسعر بن ابي حمران الجعفي في مثله : من الكامل  يخرجن من خلل الغبار عوابسا . . . كانامل المقرور اقعي فاصطلي وقوله : من الكامل المجزوء مستلامين بها كان . . . رءوسهم بيض النعام وهو قول النابغة : من الوافر فصبحهم ململمة رداحا . . . كان رءوسهم بيض النعام وقوله : من الطويل وما كنت الا كالثريا تحلقا . . . يدف علي اثارها دبرانها من قول ذي الرمة : من الطويل يدف علي اثارها دبرانها . . . فلا هو مسبوق ولا هو يلحق وقوله : من الكامل هن القسي من النحول فان سما . . . طلب فهن من النجاء الاسهم اخذه من قول البحتري وان كان زاد في المعني ونقص : من الخفيف كالقسي المعطفات بل الاس . . . هم مبرية علي الاوتار وفي هذه القصيدة يقول يصف الدرع : من الكامل  من كل ضاحكة القتير كانها . . . برد اعاركها الشجاع الارقم نقله من محمد بن عبد الملك بن صالح الهاشمي في قوله يصفها : من الكامل وعلي سابغة الدروع كانها . . . سلخ كسانيه الشجاع الارقم ومن ذلك قوله : من السريع اصلاحك المال ابن عم الغني . . . والبخل خير من سءال البخيل وهو مسلوخ من قول ابن المعتز : من السريع فاشدد عري مالك واستبقه . . . فالبخل خير من سءال البخيل وقوله : من الطويل فما اب حتي استفزع المجد كله . . . شروب علي غيظ الرجال اكول منقول من قول الاقرع بن معاذ : من الطويل متين حبال الود مطلع العدي . . . اكول علي غيظ الرجال شروب ومن ذلك قوله : من الكامل المجزوء يا حسنكم في الدهر اذ . . . نابا واقبحكم رءوسا من قول الاول : من المتقارب فيا قبحهم في الذي خولوا . . . ويا حسنهم في زوال النعم  وابو الطيب المتنبي ، مع فضله المشهور ، وبحره الغزير واخذه برقاب الكلام ، ووقوفه علي دقاءق المعاني ، واتيانه بها في ابهج رونق واصفي سبك وارق لفظ ، وعلي ما في شعره من الحكم والامثال الساءرة ، يغلط ويحيل ويجء بالمعني الشنيع واللفظ الرذل ، ثم لا يتصفحه فيسقطه او ينبه عليه من بعد فيضعه . فمن غلطه قوله : من الكامل ملك زهت بماكنه ايامه . . . حتي افتخرن به علي الايام وانما هو زهيت ، يقال : زهيت علينا يا رجل ، وزها النبت اذا اصفر وظهر زهوه اي صفرته ، وزها البسر وازهي اذا احمر واذا اصفر . وفي الخبر ان النبي صلي الله عليه واله وسلم نهي عن بيع التمر حتي يزهو ، ويروي حتي يزهي ، والزهو البسر والزهر ايضا الكذب . وقوله : من الكامل وصلت اليك يد سواء عندها ال . . . بازي الاشهب والغراب الابقع وهو البازي غير مشدد ، وقد وصل الف القطع في قوله الاشهب وانما احتذي في البازي قول البحتري : من الخفيف وبياض البازي احسن لونا . . . ان تاملت من سواد الغراب وحكمها في هذا الاخلال عند من اخذه عليهما واحد . واخذ علي المتنبي قوله : من الكامل وقتلن دفرا والدهيم فما تري . . . ام الدهيم وام دفر هابل والدهيم اسم الداهية ، واصل ذلك ناقة اسمها الدهيم حملت رءوس قتلي  جماعة الي ابيهم ؛ والعرب تسمي الدنيا ام دفر لما فيها من المزابل والدفر النتن ، فجعل المتنبي الدفر الداهية ووهم في ذلك . وقوله : من الخفيف لامة فاضة اضاة دلاص . . . احكمت نسجها يدا داود والمسموع مفاضة ولم تقل العرب فاضة . وقوله : من الطويل فارحام شعر يتصلن لدنه . . . وارحام مال ما تني تتقطع فقالوا : لم تقل العرب لدن بالتشديد . وعيب في القوافي بقول : من الكامل انا بالوشاة اذا ذكرتك اشبه . . . تاتي الندي ويذاع عنك فتكره واذا رايتك دون عرض عارضا . . . ايقنت ان الله يبغي نصره فانه ان جعل الهاء حرف الروي لم يجز لان هاء الضمير لا تكون رويا الا اذا سكن ما قبلها ، وان جعل الراء الروي  وهو اولي  جاءه الخلل في التصريع باشبه في البيت الاول . واحال في قوله : من البسيط وضاقت الارض حتي صار هاربهم . . . اذا راي غير شء ظنه رجلا وغير شء معناه المعدوم ، والمعدوم لا يري .  واحال في قوله : من الخفيف يفضح الشمس كلما ذرت الشم . . . س بشمس منيرة سوداء وفي قوله ايضا : من الطويل وان نلت ما املت منك فربما . . . شربت بماء يعجز الطير ورده فجعله في عسر المنال كالماء الذي يعجز الطير ان يرده فاحال المدح هجوا . وسقط في مواضع كثيرة ، فمن ذلك قوله في سيف الدولة : من الطويل خف الله واستر ذا الجمال برقع . . . فان لحت حاضت في الخدور العواتق اراد ان يمدحه فنسب به . وقوله فيه : من الطويل فان كان بعض الناس سيفا لدولة . . . ففي الناس بوقات بها وطبول وقوله : من الكامل اني علي شغفي بما في خمرها . . . لاعف عما في سراويلاتها فافتضح مع قول الرضي رضي الله عنه من بعده : من الطويل يحن الي ما تضمر الخمر والحلي . . . ويصدف عما في ضمان المازر  وقوله : من البسيط العارض الهتن بن العارض الهتن . . . بن العارض الهتن بن العارض الهتن وقوله : من الكامل فكانه حسب الاسنة حلوة . . . او ظنها البرني والازاذا وقوله : من الكامل قلق المليحة وهي مسك هتكها وقوله : من مخلع البسيط ماذا يقول الذي يغني . . . يا خير من تحت ذي السماء وقوله : من الكامل اني يكون ابا البرية ادم . . . وابوك والثقلان انت محمد تقدير الكلام : كيف يكون ادم ابا البرية وابوك محمد وانت الثقلان ، يعني الانس والجن ، وادم واحد من الانس ، وقد فصل بين المبتدا الذي هو ابوك وبين الخبر الذي هو محمد بالجملة التي هي والثقلان انت ، وهذا تعسف قبيح . ويناسبه قوله : من الطويل حملت اليه من ثناءي حديقة . . . سقاها الحجي سقي الرياض السحاءب  اراد سقي السحاءب الرياض . وليس كل ما استعملته العرب يحسن استعماله بالمحدثين . ومثله من شعره : من الكامل فتبيت تسءد مسءدا في نيها . . . اسادها في المهمه الانضاء تقديره : مسءدا في نيها الانضاء اسادها في المهمه . وقد كان يكفيه في هذا البيت التكرير الذي لا فاءدة فيه حتي اضاف اليه هذا التعقيد في التقديم والتاخير . ومن الساقط المستهجن قوله : من الوافر جواب مساءلي اله نظير . . . ولا لك في سءالك لا الا لا فاما ما اقتبس معناه واحتذي فيه علي مثال من تقدمه فكثير ، ولا يعد عيبا ، انما اعتده عليه ضد او شانء . والمعاني ليست مملوكة ، واولي الناس بها من كساها لفظا راءقا وكملها واحسن مجتلاها . وقد تتوارد الخواطر في المعاني فلا ينسب الثاني الي السرقة ما كانت مصالتة لفظا ومعني ، او بيتا كاملا ، كما اخذ الفرزدق ، وكما قيل في بيت ابي تمام : من الطويل واحسن من نور تفتحه الصبا . . . بياض العطايا في سواد المطالب انه ماخوذ من قول الاخطل : من الطويل راين بياضا في سواد كانه . . . بياض العطايا في سواد المطالب  ويقول من يتعصب لابي تمام : ان هذا البيت مصنوع ولم يصح عن الاخطل ، وهذا الاصح ، فان ديوانه لم يتضمنه ولا وجد في نسخة من النسخ . لكن قد قال العمي في ذكر الشيب : من الطويل راين بياضا في سواد كانه . . . بياض العطايا في سواد المطالب ومن سقطات المتنبي : من الطويل ولا واحدا في ذا الوري بل جماعة . . . ولا البعض من كل ولكنك الضعف ولا الضعف حتي يبلغ الضعف ضعفه . . . ولا ضعف ضعف الضعف بل مثله الف اقاضينا هذا الذي انت اهله . . . غلطت ولا الثلثان هذا ولا النصف ومن معانيه المسروقة المنقولة في افحش لفظ واهجنه قوله : من الوافر ونهب نفوس اهل النهب اولي . . . باهل المجد من نهب القماش واصله قول عمرو بن كلثوم : من الوافر فابوا بالنهاب وبالسبايا . . . وابنا بالملوك مصفدينا واخذ المعني ابو تمام ، لكنه زاد وبين وهذب اللفظ فقال : من البسيط ان الاسود اسود الغاب همتها . . . يوم الكريهة في المسلوب لا السلب  ومما استهجن لفظه وبعد عن الاستعمال ومجته الاسماع قوله : من الكامل ولديه ملعقيان والادب المفا . . . د وملحياة وملممات مناهل وقوله : من الكامل جفخت وهم لا يجفخون بها بهم . . . شيم علي الحسب الاغر دلاءل وقوله : من الوافر اروض الناس من ترب وخوف . . . وارض ابي شجاع من امان وقوله : من الخفيف كل اخاءه كرام بني الدن . . . يا ولكنه كريم الكرام وقوله : من الكامل لو لم تكن من ذا الوري اللذ منك هو . . . عقمت بمولد نسلها حواء ويجري مجراه في ركاكة لفظه والتكرير الذي لا معني تحته الا العي قوله : من الطويل ومن جاهل بي وهو يجهل جهله . . . ويجهل علمي انه بي جاهل وقوله : من الطويل  فقلقت بالهم الذي قلقل الحشا . . . قلاقل عيش كلهن قلاقل وقوله : من الوافر وافقد من فقدنا من وجدنا . . . قبيل الفقد مفقود المثال وقوله : من الطويل وطعن كان الطعن لا طعن عنده وقد خرج متتبعوه معاني من شعره مترذلة ، اقتصرت منها علي قوله مضافا الي ما سبق في اول هذا الفصل : من البسيط لو استطعت ركبت الناس كلهم . . . الي سعيد بن عبد الله بعرانا وله وقد جمع قبح اللفظ وبرد المعني : من الكامل ان كان مثلك كان او هو كاءن . . . فبرءت حينءذ من الاسلام ؟ وقوله : من الكامل خلت البلاد من الغزالة ليلها . . . فاعاضهاك الله كي لا تحزنا ؟ وعيب عليه قوله في صفة فرس : من الرجز وزاد في الاذن علي الخرانق ، وهو الارنب ، فدل علي جهله بالخيل والمستحسن من صفاتها والمستقبح . وانما توصف بصغر الاذن ودقتها ، وهي  ضد صفة الارنب . ؟ واخذ عليه في العروض استعماله فاعلاتن في عروض الرمل في ابيات كثيرة غير مصرعة من قصيدة اولها : من الرمل انما بدر بن عمار سحاب . . . هطل فيه ثواب وعقاب فجاء به علي تمام الداءرة ، ولم تستعمله العرب ، وانما جاء في شعرها علي فاعلن . ومنه قوله : من الطويل تفكره علم ومنطقه حكم . . . وباطنه دين وظاهره ظرف فجاء في عروض الطويل مفاعيلن ولم يرد في اشعار العرب الا مفاعلن الا في التصريع . 
  نوادر من هذا الباب
 قيل لم ير الاحنف ضجرا قط الا مرة واحدة ، فانه اعطي خياطا قميصا يخيطه فحبسه حولين ، فاخذ الاحنف بيد ابنه بحر ، فاتي به الخياط وقال : اذا مت فادفع القميص الي هذا . قال ابو حاتم : كنت اقرا شعر المتلمس علي الاصمعي فانتهينا الي قوله : من البسيط اغنيت شاني فاغنوا اليوم شانكم . . . واستحمقوا في هراس الحرب او كيسوا فغلطت فقلت اغنيت شاتي ، فقال الاصمعي : فاغنوا اليوم تيسكم ، واشار الي ، فضحك جميع الحاضرين . قيل ان عبد الله بن احمد بن حنبل قرا في الصلاة : اقرا باسم ربك الذي خلق ، فقيل له : انت وابوك في طرفي نقيض ، زعم ابوك ان القران ليس بمخلوق ، وقد جعلت انت رب القران مخلوقا . قال بعضهم : سمعت ابن شاهين المحدث في جامع المنصور يقول في الحديث : نهي النبي صلي الله عليه وسلم عن تشقيق الحطب ، فقال بعض الملاحين : يا قوم فكيف نعمل والحاجة ماسة . وهو تشقيق الخطب . قال :  وسمعته مرة اخري وهو يفسر قوله تعالي : وثيابك فطهر المدثر :  ، قال : قيل لا تلبسها علي غدرة ، وانما هو عذرة . كان عند عمر بن عبد العزيز رجلان ، فجعلا يلحنان ، فقال الحاجب : قوما فقد اوذيتما امير المءمنين ، فقال عمر انت والله اشد اذي لي منهما . خرج اسحاق بن مسلم العقيلي مع المنصور الي مكة فامعن في السير وطوي المراحل ، فقال اسحاق : انا قد هلكنا يا امير المءمنين ، فما هذه العجلة ؟ قال : نخاف ان يفوتنا الحج ، فقال : اكتب اليهم ليءخروه عشرة ايام . قيل للنسابة البكري : يا ابا ضمضم ، ادم من ابوه ؟ فحمله استقباح الجهل عنده حتي ان قال : ادم بن الصاء بن الحملح وامه صاعدة بنت فرزام . فتضاحكت العرب . محمد بن وهيب الحميري يذكر داخلا فيما لا يحسنه وليس بمن شانه : من الطويل تشبهت بالاعراب اهل التعجرف . . . فدل علي مثواك قبح التكلف لسان عراقي اذا ما صرفته . . . الي لغة الاعراب لم يتصرف قرا الرشيد ليلة : وما لي لا اعبد الذي فطرني ، فارتج عليه ، فاخذ يردد وابن ابي مريم بقربه في الفراش ، فقال : لا ادري والله لم لا تعبده . فضحك الرشيد وقطع صلاته . مدح علي بن الجهم المتوكل بقصيدة قال في اولها :  من الكامل  الله اكبر والنبي محمد . . . والحق ابلج والخليفة جعفر فاستبرد هذا اللفظ والافتتاح . وقال فيه مروان ابن ابي الجنوب  ويقال ابن ابي الحكم  يهزا به : من الطويل اراد علي ان يقول قصيدة . . . بمدح امير المءمنين فاذنا  فارغة 
