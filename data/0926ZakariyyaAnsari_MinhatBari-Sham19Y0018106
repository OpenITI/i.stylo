  AUTO   سورة الواقعة

 وقال مجاهد: {رجت} [الواقعة: ]: "زلزلت"، {بست} [الواقعة: ]: "فتت لتت كما يلت السويق المخضود: الموقر حملا، ويقال ايضا: لا شوك له " {منضود} [هود: ]: "الموز، والعرب المحببات الي ازواجهن"، {ثلة} [الواقعة: ]: "امة"، {يحموم} [الواقعة: ]: "دخان اسود"، {يصرون} [الواقعة: ]: "يديمون"، {الهيم} [الواقعة: ]: "الابل الظماء"، {لمغرمون} [الواقعة: ]: "لملومون مدينين محاسبين"، {روح} [يوسف: ]: "جنة ورخاء"، {وريحان} [الواقعة: ]: "الريحان الرزق"، {وننشءكم فيما لا تعلمون}: "في اي خلق نشاء" وقال غيره: {تفكهون}   [الواقعة: ]: "تعجبون"، {عربا} [الواقعة: ]: "مثقلة، واحدها عروب، مثل صبور وصبر، يسميها اهل مكة العربة، واهل المدينة الغنجة، واهل العراق الشكلة"، وقال في {خافضة} [الواقعة: ]: "لقوم الي النار"، و {رافعة} [الواقعة: ]: "الي الجنة"، {موضونة} [الواقعة: ]: "منسوجة، ومنه: وضين الناقة والكوب: لا اذان له ولا عروة والاباريق: ذوات الاذان والعري"، {مسكوب} [الواقعة: ]: "جار"، {وفرش مرفوعة} [الواقعة: ]: "بعضها فوق بعض"، {مترفين} [الواقعة: ]: "ممتعين"، {ما تمنون} [الواقعة: ]: "من النطف يعني هي النطفة في ارحام النساء"، {للمقوين} [الواقعة: ]: "للمسافرين، والقي القفر"، {بمواقع النجوم} [الواقعة: ]: "بمحكم القران، ويقال: بمسقط النجوم اذا سقطن، ومواقع وموقع واحد"، {مدهنون} [الواقعة: ]: "مكذبون، مثل {لو تدهن فيدهنون} [القلم: ]، {فسلام لك} [الواقعة: ]: اي مسلم لك: انك من اصحاب اليمين، والغيت ان وهو معناها، كما تقول: انت مصدق، مسافر عن قليل، اذا كان قد قال: اني مسافر عن قليل، وقد يكون كالدعاء له، كقولك فسقيا من الرجال، ان رفعت السلام فهو من الدعاء"، {تورون} [الواقعة: ]: "تستخرجون اوريت: اوقدت " {لغوا} [مريم: ]: "باطلا"، {تاثيما} [الواقعة: ]: "كذبا".
 (الواقعة) في نسخة: "سورة الواقعة". (بسم الله الرحمن الرحيم) ساقطة من نسخة. ({رجت}) اي: (زلزلت). ({وبست}) اي: (فتت). (المخضود) هو (الموقر حملا) ({منضود}) معناه: (الموز) اي: شجرة، وهذا في الحقيقة انما هو تفسير للطلح، وقد اختلف في تفسيره فقيل: هو شجر الموز، وقيل: شجر له ظل بارد رطب، وقيل: هو شجر عظام له شوك واما ({منضود}) فمعناه: مركب بعضه علي بعض، وقوله: ({منضود}): الموز) ساقط من نسخة. (والعرب) اي: (المحببات الي ازواجهن). ({ثلة}) اي: (امة). ({يحموم}) هو (دخان اسود) ({يصرون}) اي:



 (يديمون) ({الهيم}) اي: (الابل الظماء) بكسر الظاء والمد. ({لمغرمون}) اي: (لملزمون). نفقة زرعنا. ({روح}) اي: (جنة ورخاء). ({وريحان}) في نسخة: "والريحان" (الرزق) وقوله: ({روح}) الي هنا ساقط من نسخة ({وننشءكم}) اي: (في اي خلق نشاء). ({تفكهون}) اي: (تعجبون) ({عربا}) اي: (مثقلة) فهن كما انهن محببات لازواجهن كما مر مثقلات باللحم ولو ذكر هذا ثم كان اولي. ({خافضة}) اي: القوم الي النار) و ({رافعة}) اي: لاخريين (الي الجنة) ({موضونة}) اي: (منسوجة ومنه وضين الناقة) اي: حزامها، (والكوب) الماخوذ من قوله تعالي: {باكواب} هو ما (لا اذن له ولا عروة) {مترفين} اي: (متمتعين) بالحرام ({للمقوين}) اي: (للمسافرين). والقي) بكسر القاف (القفر) وهو مفازة لا نبات فيها ولا ماء. {مدهنون} اي: (مكذبون).

