 وعن رجل عن عكرمة عن ابي هريرة وعن ابي هرون العبدي عن ابي سعيد الخدري عن النبي صلي الله عليه وسلم قال: هذا نهي يقول حين هو مءمن فلا يفعلن يعني لا يسرق ولا يزني ولا يغل * قال ابو محمد رحمه الله: فهذه التفاسير كلها ليس فيها الا مزايلة الايمان للفاعل حين الفعل ثم رجوعه في بعضها اليه اذا تاب واذا ترك، وليس في شء من هذه التفاسير بيان ما هو الايمان الزاءل حين هذه المعاصي وقد علمنا ان كل ما قاله رسول الله صلي الله عليه وسلم فهو الحق الواضح الذي لا حقيقة في غيره وان من فعل شيءا لم يكن حين فعله اياه مءمنا فان الايمان قد فارقه بلا شك كما قال رسول الله صلي الله عليه وسلم لكن يجب علينا ان نعرف ما هذا الايمان الذي يزول عنه في حين ذلك الفعل لنعلم من ذلك حكم ذلك الفاعل بعون الله تعالي ومنه، فنظرنا في ذلك فوجدنا الناس في تفسير لفظة الايمان قد افترقوا علي اربعة اقوال فقال اهل الحق: الايمان اسم واقع علي ثلاثة معان احدها العقد بالقلب.
 والاخر النطق باللسان.
 والثالث عمل بجميع الطاعات فرضها ونفلها واجتناب المحرمات * وقالت طاءفة: مخطءة ان الايمان اسم واقع علي معنيين وهما العقد بالقلب والنطق باللسان فقط وان اعمال الطاعات واجتناب المحرمات انما هي شراءع الايمان وليست ايمانا،
 وهذه مقالة وان كانت فاسدة فصاحبها لا يكفر * وقالت طاءفتان قولين خرجا بهما  الي الكفر صراحا * احدهما جهم بن صفوان السمرقندي ومن قلده واتم به فانهم قالوا الايمان هو التصديق بالفلب فقط وان اعلن الكفر وجحد النبوة وصرح بالتثليث وعبد الصليب في دار الاسلام دون تقية، والاخر محمد بن كرام السجستاني ومن اتبعه واقتدي به فانهم قالوا الايمان التصديق باللسان فقط وان اعتقد الكفر بقلبه، فلزم الطاءفة الاولي ان ابليس مءمن، وان اليهود والنصاري الذين حاربوا رسول الله صلي الله عليه وسلم مءمنون اولياء الله تعالي من اهل الجنة لان كل هءلاء عرفوا الله تعالي بقلوبهم وعرفوا صحة نبوة رسوله صلي الله عليه وسلم بقلوبهم وجدوه مكتوبا عندهم في التوراة والانجيل او ان يكذب الله تعالي في اخباره بصحة علم ابليس بالله تعالي وبنبوة الانبياء عليهم السلام، ولزم الطاءفة الثانية ان المنافقين الذين شهد الله تعالي بانهم من اهل النار مءمنون اولياء الله تعالي من اهل الجنة وهذا كفر مجرد، وكلا القولين خرق للاجماع ومخالفة لاهل الاسلام * قال ابو محمد رحمه الله: فيلزم من قال: ان الايمان المزايل للزاني في حين زناه، وللقاتل في حين قتله، وللسارق في حين سرقته، وللغال في حين غلوله، وللشارب في حين شربه، وللمنتهب في حال نهبته، انه التصديق ان يقول: القاتل والزاني والغال والمنتهب والشارب قد بطل تصديقهم، ومن بطل تصديقه فهو كافر فيلزمه ان لا يءخذ من احد من هءلاء زكاة ولا يترك يصلي في مسجد مع المسلمين ولا ان يدخل الحرم ولا ان يبتدء نكاح مسلمة وان مات له قريب في تلك الحال ان لا يرثه، وهذا خلاف لاجماع الصحابة ومن يعتد به بعدهم وهم لا يقولون هذا يعني من لم يكن منهم * قال ابو محمد رحمه الله: فاذ لم يرد رسول الله صلي الله عليه وسلم بقوله المذكور في هذا الحديث ان الزاني كافر ولا ان القاتل كافر ولا ان المنتهب كافر ولا ان الغال كافر، ولا ان
 الشارب كافر، ولا ان السارق كافر، وصح انهم لو كانوا كفارا للزمهم ما يلزم المرتد عن دينه من القتل وفراق الزوجة واستيفاء المال فبيقين ندري انه عليه السلام لم يعن بذهاب الايماب المذكور ذهاب تصديقه، وايضا فبضرورة الحس يدري من واقع شيءا من الذنوب المذكورة من المسلمين من نفسه ان تصديقه لم يزل وانه كما كان وكل قول تكذبه الضرورة فهو قول متيقن السقوط فقد صح ما قلنا ان الايمان المزايل له في حال هذه الافاعيل انما هو الايمان الذي هو الطاعة لله تعالي فقط، وهذا امر مشاهد باليقين لان الزنا والقتل والغلول والنهبة وشرب الخمر ليس شء منها طاعة لله تعالي فليست ايمانا فاذ ليس شء منها ايمانا ففاعلها ليس مءمنا بمعني ليس مطيعا اذ لم  يفعل الطاعة، لكنه عاص وفاسق ومن فعل الايمان فهو مءمن، وكل من ذكرنا لم يفعل في فعله تلك الافعال ايمانا فليس مءمنا، وهذا الحديث من الحجج القاطعة علي ان الطاعات كلها ايمان، وان ترك الطاعة ليس ايمانا، وبالله تعالي التوفيق *  مسالة هل تقام الحدود في المساجد ام لا؟ * قال ابو محمد رحمه الله: نا احمد بن محمد بن عبد الله الطلمنكي نا ابن مفرج نا محمد بن ايوب الصموت نا احمد بن عمرو ابن عبد الخالق البزار نا ابو نشيط محمد بن هرون والحسن بن عرفة قال ابو نشيط: نا ابو المغيرة عبد القدوس بن الحجاج نا سعيد بن بشير عن قتادة، وقال ابن عرفة: نا ابو حفص عمر بن عبد الرحمن الابار عن اسماعيل بن مسلم، ثم اتفق قتادة واسماعيل كلاهما عن عمرو بن دينار عن طاوس عن ابن عباس عن النبي صلي الله عليه وسلم قال: " لا تقام الحدود في المساجد ولا يقتل بالولد الوالد " * قال ابو محمد رحمه الله: اسماعيل بن مسلم.
 وسعيد بن بشير ضعيفان، وبه الي البزار نا يونس بن صالح بن معاذ نا محمد بن عمر الواقدي نا اسحاق بن حازم عن ابي الاسود عن نافع بن جبير بن مطعم عن ابيه ان رسول الله صلي الله عليه وسلم نهي ان تقام الحدود في المساجد،
 محمد بن عمر الواقدي ساقط مذكور بالكذب * ومن طريق ابن وضاح نا موسي بن معاوية نا محمد بن عبد الله عن العباس بن عبد الرحمن بن حكيم بن حزام قال: قال رسول الله صلي الله عليه وسلم: " لا تقام الحدود في المساجد " محمد بن عبد الله.
 والعباس مجهولان، وعن وكيع نا مبارك عن ظبيان بن صبيح الضبي قال: قال عبد الله بن مسعود لا تقام الحدود في المساجد: ظبيان مجهول وعن وكيع نا سفيان الثوري عن قيس بن مسلم عن طارق بن شهاب قال: اتي عمر بن الخطاب رجل في حد فقال: اخرجاه من المسجد ثم اضرباه * قال ابو محمد رحمه الله: هذا خبر صحيح قد صح ان رسول الله صلي الله عليه وسلم امر بتطييب المساجد وتنظيفها، وقال تعالي: (في بيوت اذن الله ان ترفع ويذكر فيها اسمه) فوجب صون المساجد ورفعها وتنظيفها فما كان من اقامة الحدود فيه تقذير للمسجد بالدم كالقتل والقطع فحرام ان يقام شء من ذلك في المسجد لان ذلك ليس تطييبا ولا تنظيفا، وكذلك امر رسول الله صلي الله عليه وسلم برجم ما عز بالبقيع خارج المسجد، واما ماكان من الحدود جلدا فقط فاقامته في المسجد جاءز وخارج المسجد ايضا جاءز الا ان خارج المسجد احب الينا خوفا ان يكون من المجلود بول لضعف طبيعته او غير ذلك مما لا يءمن من المضروب، برهان ذلك قول الله تعالي: (وقد فصل لكم  ما حرم عليكم الا ما اضطررتم اليه) فلو كان اقامة الحدود بالجلد في المساجد حراما لفصل لنا ذلك مبينا في القران علي لسان رسوله صلي الله عليه وسلم، وممن قال باقامة الحدود بالجلد في المساجد: ابن ابي ليلي وغيره وبه ناخذ، وبالله تعالي التوفيق *  مسالة هل الحدود كفارة لمن اقيمت عليه ام لا؟ * قال ابو محمد رحمه الله: كل ما اصاب ذنبا فيه حد فاقيم عليه ما يجب في ذلك فقد سقط عنه ما اصاب من ذلك تاب او لم يتب حاش المحاربة فان اثمها باق عليه
 وان اقيم عليه حدها ولا يسقطها عنه الا التوبة لله تعالي فقط، برهان ذلك ما رويناه من طريق مسلم نا يحيي بن يحيي وابو بكر بن ابي شيبة وعمرو الناقد واسحاق بن ابراهيم ومحمد بن عبد الله بن نمير كلهم عن سفيان بن عيينة عن الزهري عن ابي ادريس الخولاني عن عبادة بن الصامت قال كنا مع رسول الله صلي الله عليه وسلم في مجلس: فقال: " تبايعوني علي ان لا تشركوا بالله شيءا ولا تسرقوا ولا تزنوا ولا تقتلوا النفس التي حرم الله الا بالحق فمن وفا منكم فاجره علي الله ومن اصاب شيءا من ذلك فعوقب به فهو كفارة له ومن اصاب شيءا من ذلك فستره الله عليه فامره الي الله ان شاء عفا عنه وان شاء عذبه " * وبه الي مسلم حدثني اسماعيل بن سالم انا هشيم انا خالد  هو الحذاء  عن ابي قلابة عن ابي الاشعث  هو الصنعاني  عن عبادة بن الصامت قال: اخذ علينا رسول الله صلي الله عليه وسلم كما اخذ علي النساء ان لا نشرك بالله شيءا ولا نسرق ولا نزني ولا نقتل اولادنا ولا يغتاب بعضنا بعضا فمن وفا منكم فاجره علي الله ومن اتي منكم حدا فاقيم عليه فهو عقابه، ومن ستره الله عليه فامره الي الله ان شاء عذبه وان شاء غفر له * واما تخصيصنا المحاربة من جميع الحدود فلقول الله تعالي: (انما جزاء الذين يحاربون الله ورسوله ويسعون في الارض فسادا) الي قوله تعالي: (عذاب عظيم) فنص الله تعالي نصا لا يحتمل تاويلا علي انهم مع اقامة هذا الحد عليهم وانه لهم خزي في الدنيا ولهم مع ذلك في الاخرة عذاب عظيم * قال ابو محمد رحمه الله: فوجب استعمال النصوص كلها كما جاءت وان لا يترك شء منها لشء اخر وليس بعضها اولي بالطاعة من بعض وكلها حق من عند الله تعالي ولا يجوز النسخ في شء من ذلك، اما حديث عبادة فانه فضيلة لنا ان تكفر عنا الذنوب بالحد والفضاءل لا تنسخ لانها ليست اوامر ولا نواهي وانما النسخ في الاوامر والنواهي سواء وردت بلفظة الامر والنهي او بلفظ الخبر ومعناه الامر والنهي، واما الخبر المحقق فلا يدخل النسخ فيه ولو دخل لكان كذبا وهذا  لا يجوز ان يظن بشء من اخبار الله تعالي ورسوله صلي الله عليه وسلم، واما الاية في المحاربة فان وجوب العذاب في الاخرة مع الخزي في الدنيا باقامة الحد عليهم خبر مجرد من الله تعالي لا مدخل فيه للامر والنهي فامن دخول النسخ في شء من ذلك والحمد لله رب العالمين * قال ابو محمد رحمه الله: فان تعلق متعلق بما نا احمد بن عمر العذري نا عبد الله ابن احمد بن حموية السرخسي نا ابراهيم بن دحيم نا عبدبن حميد الكشي ثنا عبد الرزاق عن معمر عن ابن ابي ذءب عن سعيد المقبري عن ابي هريرة قال: قال رسول الله صلي الله عليه وسلم: " ما ادري اتبع كان لعينا ام لا وما ادري ذو القرنين انبيا كان ام لا وما ادري الحدود كفارات لاهلها ام لا؟ " وبما ثناه احمد بن عمر العذري نا محمد بن ابي سعيد بن سختوية الاسفرايني في داره بمكة ثنا عبد العزيز بن جعفر بن سعد انا احمد ابن زنحويه بن موسي نا داود بن رشيد نا سيف بن هرون عن اسماعيل بن ابي خالد عن قيس بن ابي حازم عن جرير بن عبد الله قال: بايعنا رسول الله صلي الله عليه وسلم علي ما بايعت النساء فمن مات منا ولم يات بشء منهن ضمن له الجنة ومن مات منا واتي بشء فاقيم عليه الحد فحسابه علي الله تعالي * قال ابو محمد رحمه الله.
 اما حديث ابي هريرة فصحيح السند وما نعلم له في وقتنا هذا علة الا ان الذي لا نشك فيه ان رسول الله صلي الله عليه وسلم لا يختلف قوله ولا يقول الا الحق وقد قال صلي الله عليه وسلم باصح سند مما اوردنا انفا من طريق عبادة: ان من اصاب من الزنا.
 والسرقة.
 والقتل.
 والغصب شيءا فاقيم عليه الحد فهو كفارة له فمن المحال ان يشك رسول الله صلي الله عليه وسلم في شء قد قطع به وبشر امته به وهو وحي من الله تعالي اوحي اليه به والقول عندنا فيه ان ابا هريرة لم يقل انه سمع من رسول الله صلي الله عليه وسلم هذا الكلام وقد سمعه ابو هريرة من احد المهاجرين ممن سمعه ذلك الصاحب من
 رسول الله صلي الله عليه وسلم في اول البعث قبل ان يسمع عبادة رسول الله صلي الله عليه وسلم يقول: " ان الحدود كفارة فهذا صحيح بانه عليه السلام لا يعلم الا ما علمه الله تعالي ثم اعلمه بعد ذلك ما لم يكن يعلمه حينءذ واخبر به الانصار اذ بايعوه قبل الهجرة والحدود حينءذ لم تكن نزلت بعد لا حين بيعة عبادة ولا قبل ذلك وانما نزلت بالمدينة بعد الهجرة لكن الله تعالي اعلم رسوله عليه السلام انه سيكون لهذه الذنوب حدود وعقوبات وان كان لم يعلمه بها لكنه اخبره انها كفارات لاهلها هذا هو الحق الدي لا يجوز غيره ان صح حديث ابي هريرة ولم تكن فيه علة، واما حديث جابر فساقط لانه  من رواية داود بن رشيد وهو ضعيف، ثم لو صح لكان القول فيه كالقول في حديث ابي هريرة الذي تكلمنا فيه انفا والامر كان حينءذ في حديث جابر ابين لان اسلام جرير متاخر جدا بعد الفتح لم يدرك قط بيعة النساء التي كانت قبل القتال لان اسلام جرير كان بعد نزول الماءدة فصار حديث عبادة قاضيا علي كل ذلك ومخبرا عن الله تعالي ما ليس في ساءر الاخبار من ان الحدود كفارة لاهلها حاش ما خصه الله تعالي منها *  مسالة هل تسقط الحدود بالتوبة ام لا؟ * قال ابو محمد رحمه الله: قال قوم: ان الحدود كلها تسقط بالتوبة وهذه رواية رواها ابو عبد الرحمن الاشعري عن الشافعي قالها بالعراق ورجع عنها بمصر واحتج اهل هذه المقالة بما ناه عبد الله ابن ربيع نا محمد بن معاوية نا احمد بن شعيب ارنا محمد بن بشار نا عبد الرحمن بن مهدي نا سفيان الثوري عن زيد بن اسلم عن يزيد بن نعيم عن ابيه ان ماعز بن مالك اتي النبي صلي الله عليه وسلم فقال اقم علي كتاب الله فاعرض عنه اربع مرات، ثم امر رسول الله صلي الله عليه وسلم برجمه فلما مسته الحجارة خرج يشتد وخرج عبد الله بن انس من نادي قومه بوظيف حمار فضربه فصرعه فاتي النبي صلي الله عليه وسلم فحدثه بامره فقال: " الا تركتموه لعله يتوب
 فيتوب الله عليه يا هذا لو سترته بثوبك كان خيرا لك " حدثنا حمام ثنا عباس بن اصبغ نا محمد بن عبد الملك بن ايمن نا محمد بن وضاح نا ابو بكر بن ابي شيبة نا عمرو بن حماد ابن طلحة عن اسباط بن نصر عن سماك عن علقمة بن واءل بن حجر عن ابيه ان امراة وقع عليه رجل في سواد الصبح وهي تعمد الي المسجد عن كره نفسها فاستغاثت برجل مر عليها وفر صاحبا، ثم مر عليها قوم ذوو عدد فاستغاثت بهم فادركوا الذي استغاثت به وسبقهم الاخر فاتوا به النبي صلي الله عليه وسلم فاخبرته انه وقع عليها واخبره القوم انهم ادركوه يشتد فقال انما كنت اغثتها علي صاحبها فادركني هءلاء فاخذوني: قالت: كذب هو الذي وقع علي فقال النبي صلي الله عليه وسلم: " اذهبوا به فارجموه " فقام رجل من الناس فقال: لا ترجموه وارجموني انا الذي فعلت بها الفعل فاعترف فاجتمع ثلاثة عند رسول الله صلي الله عليه وسلم الذي وقع عليها والذي اغاثها والمراة فقال: " اما انت فقد غفر الله لك وقال للذي اغاثها قولا حسنا " فقال له عمر ارجم الذي اعترف بالزنا: قال رسول الله صلي الله عليه وسلم: " لا انه قد تاب الي الله تعالي " وزاد ابن عمر في روايته لو " تابها اهل مدينة يثرب لقبل منهم " * نا ابو عمر احمد بن قاسم نا ابي قاسم بن محمد ابن قاسم نا جدي قاسم بن اصبغ نا الحرث بن ابي اسامة نا ابو النضر نا ابو معاوية عن  ليث بن ابي سليم عن ابي بردة بن ابي موسي الاشعري عن ابي مليح بن اسامة الهذلي عن واثلة بن الاسقع قال: " شهدت رسول الله صلي الله عليه وسلم ذات يوم واتاه رجل فقال يا رسول الله: اني اصبت حدا من حدود الله تعالي فاعرض عنه ثم اتاه الثانية فاعرض عنه ثم قالها الثالثة فاعرض عنه ثم اقيمت الصلاة فلما قضي الصلاة اتي الرابعة فقال اصبت حدا من حدود الله فاقم في حد الله قال: الم تحسن الطهور او الوضوء ثم شهد الصلاة معنا انفا؟ اذهب فهي كفارتك " * ومن طريق ابي بكر بن ابي شيبة ثنا زيد بن الحباب عن عكرمة بن عمار نا شداد بن عبد الله عن الباهلي قال: " كنت
 مع رسول الله صلي الله عليه وسلم في المسجد فقال له رجل: اني اصبت حمدا فاقم علي واقيمت الصلاة فصلي رسول الله صلي الله عليه وسلم [ في المسجد ] () ثم خرج ومعه الرجل وتبعته فقال: يا رسول الله اقم علي حدي فاني اصبته فقال: " اليس حين خرجت من منزلك توضات فاحسنت الوضو.
 وشهدت معنا الصلاة؟ قال نعم: قال: فان الله قد غفر لك ذنبك او حدك " * قال ابو محمد رحمه الله: وقد روينا هذا الخبر وفيه " اني زنيت " كما ثنا المهلب ابن ابي صفرة الاسدي التميمي ثنا عبد الله بن ابراهيم الاصيلي نا محمد بن احمد الصواف نا احمد بن هرون بن روح البرذنجي نا محمد بن عبد الملك الواسطي نا عمرو بن عاصم عن همام بن يحيي عن اسحاق بن عبد الله بن ابي طلحة عن انس " ان رجلا اتي النبي صلي الله عليه وسلم فقال: يا رسول الله اني زنيت فاقم علي الحد " ثم اقيمت الصلاة فصلي مع النبي صلي الله عليه وسلم فقال له النبي صلي الله عليه وسلم: قد كفر عنك بصلاتك " * قال ابو محمد رحمه الله: وقالوا: قد قال الله تعالي: (انما جزاء الذين يحاربون الله ورسوله ويسعون في الارض فسادا) الاية الي قوله: (الا الذين تابوا من قبل ان تقدروا عليهم) قالوا: فصح النص من القران وصح الاجماع بان حد المحاربة تسقطه التوبة قبل القدرة عليهم فوجب ان تكون جميع الحدود من الزنا والسرقة والقذف وشرب الخمر كذلك لانها كلها حدود وقعت التوبة قبل القدرة علي اهلها * قال ابو محمد رحمه الله: هذا كل ما يمكن ان يحتج به اهل هذه المقالة وذهب اخرون الي ان التوبة لا تسقط الحدود واحتجوا بما ناه حمام نا عباس بن اصبغ نا محمد ابن عبد الملك بن ايمن نا بكر  هو ابن حماد  نا مسدد نا يحيي  هو ابن سعيد القطان عن هشام الدستواءي نا يحيي بن ابي كثير عن ابي قلابة عن ابي المهلب ان عمران ابن الحصين حدثه ان امراة من جهينة اتت النبي صلي الله عليه وسلم حبلي من الزنا فقالت  اني اصبت حدا فاقمه علي: فدعا وليها فقال: " احسن اليها فاذا وضعت فاتني بها " ففعل فامرها رسول الله صلي الله عليه وسلم فشكت عليها ثيابها ثم امر بها فرجمت ثم صلي عليها فقال عمر: تصلي عليها وقد زنت؟ فقال: " لقد تابت توبة لو قسمت بين سبعين من اهل المدينة لوسعتهم هل وجدت شيءا هو افضل من ان جاءت بنفسها؟ " * ومن طريق مسلم نا محمد بن المثني حدثني عبد الاعلي نا داود بن ابي نضرة عن ابي سعيد الخدري ان رجلا من اسلم يقال له: ماعز بن مالك " اتي رسول الله صلي اله عليه وسلم فقال: اني اصبت فاحشة فاقمه علي: فرده النبي صلي الله عليه وسلم مرارا ثم سال قومه فقالوا: ما نعلم به باسا  فذكر باقي الحديث وفيه  فامرنا رسول اله صلي الله عليه وسلم ان نرجمه فكان الناس فيه فرقتين قاءل يقول هلك: لقد احاطت به خطيءته وقاءل يقول: ما توبة افضل من توبة ماعز انه جاء الي رسول الله صلي الله عليه وسلم فوضع يده في يده فقال اقتلني بالحجارة: قال فلبثوا بذلك يومين او ثلاثة: ثم جاء رسول الله صلي الله عليه وسلم وهم جلوس فسلم ثم جلس فقال: " استغفروا لماعز بن مالك ".
 فقالوا: غفر الله لماعز بن مالك فقال رسول الله صلي الله عليه وسلم: لقد تاب توبة لو قسمت بين امة لوسعتهم " * ومن طريق مسلم نا محمد بن عبد الله بن نمير نا بشير بن المهاجر نا عبد الله بن بريدة عن ابيه " ان ماعز بن مالك اتي رسول الله صلي الله عليه وسلم فقال: يا رسول الله اني قد ظلمت نفسي وزنيت واني اريد ان تطهرني فرده  فذكر الحديث، وفيه  فجاءت الغامدية فقالت: يا رسول الله اني قد زنيت فطهرني وانه ردها فلما كان الغد قالت: يا رسول الله لم تردني كما رددت ماعزا؟ فوالله اني لحبلي، قال: " اما الان فاذهبي  وذكر باقي الخبر  فلما فطمته اتته بالصبي وفي يده كسرة خبز فقالت: هذا يا نبي الله قد فطمته وقد اكل الطعام، فدفع الصبي الي رجل من المسلمين ثم امر بها فحفر الي صدرها وامر الناس فرجموها فاقبل خالد بن الوليد فرمي راسها فنضح الدم علي وجه خالد فسبها فسمع نبي الله صلي الله عليه وسلم سبه اياها فقال: مهلا يا خالد فوالذي نفسي بيده لقد تابت توبة لو تابها
 صاحب مكس لغفر له ثم امر بها فصلي عليها ودفنت " قالوا: فهذا ماعز قد صحت توبته قبل الرجم باخبار رسول الله صلي الله عليه وسلم بذلك وبانها مقبولة وهذه الغامدية والجهنية رضي الله عنهما قد تابتا اتم توبة واصحها مقبولة من الله تعالي باخبار النبي عليه السلام ولم تسقط هذه التوبة عنهم الحد قالوا: وكذلك ايضا حد رسول الله صلي الله عليه وسلم الذين قذقوا عاءشة رضي الله عنها * قال ابو محمد رحمه الله: فلما اختلفوا في ذلك كما ذكرنا وجب ان ننظر في ذلك  لنعلم الحق من ذلك [ فنتبعه ] () بعون الله تعالي ومنه * فنظرنا في الحديث الذي احتج به من راي الحدود ساقطة بالتوبة فنظرنا في ذلك فوجدناه مرسلا فسقط التعلق به، ثم نظرنا في حديث علقمة بن واثل فوجدناه لا يصح لانه من طريق سماك بن حرب وهو يقبل التلقين شهد بذلك شعبة وغيره فسقط، ثم نظرنا في حديث واثلة بن الاسقع فوجدنا الاول من طريق فيها ليث بن ابي سليم وليس بالقوي * واما حديث الباهلي فوجدناه من طريق عكرمة بن عمار وهو ضعيف جدا، قال قيل وقد رويتموه بان فيه زينب: قلنا: نعم وفيه من لا يعرف رجاله، ثم انه لو ثبت دون علة لما كانت فيه حجة لان فيه وجوها تمنع من استعماله، احدها ان ممكنا ان يكون هذا قبل نزول حد الزنا ثم نزل حد الزنا فكان الحكم لايجاب الحد، فان قيل: وممكن ايضا ان يكون بعد نزول حد الزنا، ثم نزل حد الزنا فكان الحكم له ويكون ناسخا لما في حديث ماعز والغامدية والجهينية قلنا: ان الواجب اذا تعارضت الاخبار ان يءخذ بالزاءد والزاءد هو الذي جاء بحكم لم يكن واجبا في معهود الاصل وكان معهود الاصل بلا شك ان لاحد علي احد تاءبا كان او غير تاءب فجاء النص بايجاب الحدود جملة وكانت هذه النصوص زاءدة علي معهود الاصل، وجاء حديث ماعز والغامدية والجهينية فكان ما فيها من ايجاب الحد علي التاءب زاءدا علي ما في الخبر الذي فيه اسقاط الحد
 عن التاءب هذا لو كان في حديثهم ان الحد سقط عنه بالتوبة فكيف وليس هذا فيه وانما فيه اسقاط الحد بصلاته فقط وهذا ما لا يقولونه [ بل هم يخالفون لهذا الحكم ] () فبطل تعلقهم بهذا الخبر وبتلك الاخبار جملة وبالله تعالي التوفيق * فان قالوا: هبكم ان حد الزنا قد وجدتم فيه وفي حد القذف اقامة الحد علي من تاب فمن اين لم تسقطوا حد السرقة وحد الخمر بالتوبة ولا نص معكم في اقامتها علي التاءب منها؟ قلنا: ان النص قد ورد جملة باقامة الحدود في السرقة.
 والخمر.
 والزنا.
 والقذف ولم يستثن الله تعالي تاءبا من غير تاءب ولم يصح نص اصلا باسقاط الحد عن التاءب فاذا الامر كذلك فلا يحل ان يخص التاءب من عموم امر الله تعالي باقامة الحدود بالراي والقياس دون نص ولا اجماع، فهذه عمدتنا في اقامة الحدود علي التاءب وغير التاءب، وانما حديث ماعز والغامدية والجهينية مءيد لقولنا في ذلك فقط ولو لم يات ما احتجنا اليها مع الاوامر الواردة باقامة الحدود لقول النبي صلي الله عليه وسلم: " من بدل دينه فاقتلوه " وقوله عليه السلام: " البكر بالبكر جلد ماءة وتغريب عام والثيب بالثيب جلد ماءة والرجم "

 ومع قوله تعالي: (والسارق والسارقة فاقطعوا ايديهما) ومع قوله تعالي: (فاجلدوهم ثمانين جلدة) ومع قول رسول الله صلي الله عليه وسلم " اذا شرب الخمر فاجلدوه " الحديث فلم يخص عليه السلام شيءا من شء مما امر باقامة الحد عليه تاءبا من غيره وما ينطق عن الهوي ان هو الا وحي يوحي وما كان ربك نسيا، ثم نظرنا ايضا في احتجاجهم علي هءلاء المذكورين بانهم قد اجمعوا علي ان التوبة تسقط عذاب الاخرة وهو العذاب الاكبر فاذا اسقطت العذاب الاكبر فاحري واوجب ان تسقط العذاب الاقل الذي هو الحد في الدنيا فوجدنا هذا كله لازما لكل من ذكرنا لانهم اصحاب قياس بزعمهم ولو صح قياس يوما ما من الدهر لكانت هذه المقاييس اصح قياس في العالم واين هذا من قياسهم الفاسد الحديد علي الذهب في الربا.
 وغزل القطن علي الذهب والفضة في الربا.
 وقياسهم فرج الزوجة علي يد السارق وساءر قياساتهم الفاسدة التي لا تعقل، واما نحن فلا يلزمنا هذا لان القياس كله باطل لا يحل القول بشء منه في دين الله تعالي والحمد لله رب العالمين، وعذاب الاخرة غير عذاب الدنيا وليس اذا سقط احدهما وجب ان يسقط الاخر اذ لم يوجب ذلك نص قران ولا سنة ولا اجماع وكثير من المعاصي ليس فيها في الدنيا حد كالغصب، ومن قال لاخر: يا كافر.
 وكاكل لحم الخنزير.
 وعقوق الوالدين وغير ذلك وليس ذلك بموجب ان يكون فيها في الاخرة عقاب بل فيها اعظم العقاب في الاخرة، فصح ان احكام الدنيا غير متعلقة باحكام الاخرة وبالله تعالي التوفيق * وقد احتجوا بقول الله تعالي: (والذين يرمون المحصنات ثم لم ياتوا باربعة شهداء) الي قوله تعالي: (غفور رحيم) فوجدناهم لا حجة لهم في هذه الاية لان الله تعالي لم يسقط الحد بالتوبة مطلقة ولو اراد ذلك لقال الا الذين تابوا ولم يقل من بعد ذلك فلما قال تعالي من بعد ذلك بين لنا تعالي ان هذه التوبة لا تكون الا من بعد الجلد ثمانين واستحقاق اسم الفسوق ورد الشهادة لا قبل الجلد بنص القران فانما سقط بالتوبة بعد الجلد ما عدا الجلد لان الجلد قد نفذ فلا يسقط بعده بالتوبة الا الفسق وحكم قبول الشهادة فقط، وايضا فبعد نزول هذه الاية جلد رسول الله صلي الله عليه وسلم مسطح بن اثاثة.
 وحسان بن ثابت.
 وحمنة بنت جحش فبطل التعلق في اسقاط الحد بالتوبة المذكورة في الاية وصح انه انما سقط بها ما عدا الحد وهو الفسق ورد الشهادة فقط فبطل كل ما شغب هءلاء القوم به وصح انه لا يسقط بالتوبة شء من الحدود حاشا حد الحرابة الذي ورد النص بسقوطها بالتوبة قبل القدرة عليهم فقط واما بالتوبة الكاءنة منهم بعد القدرة عليهم او مع القدرة عليهم فلا  يسقط بذلك عنهم حد المحاربة اصلا لان النص لم يسقط الحد عنهم الا بالتوبة قبل القدرة عليهم فقط وبقي ما عدا ذلك علي انفاذ ما امر الله تعالي به فيه، وبالله تعالي التوفيق *
 قال علي رحمه الله: والدليل عندنا في ذلك ان من اقر بحد ولم يقل ما هو فلا شء عليه اصلا كما فعل رسول الله صلي الله عليه وسلم فان قال: علي حد فيه الجلد فقط لم يقم ايضا عليه جلد لانه قد يظن في فعله ذلك انه حد يوجب جلدا وليس كما يظن فاذ هو ممكن فلا يحل لنا بشرته باحلاله لنا اياها لان تحريم الله تعالي لها قبل احلاله الفاسد، ولو ان امرءا قال لاخر اضربني فقد احللت لك بشرتي لم يحل ضربه اصلا لانه ليس له ان يحل من نفسه ما حرم الله تعالي منها ولا ان يحرم منها ما احله الله تعالي ولو قال من صح عليه الجلد في القذف.
 او الزنا.
 او الخمر قد حرمت عليكم بشرتي لكان كلامه هذرا ولغوا وكذلك لو احل لاخر قتل نفسه او قطع يده او احلت المزاة فرجها لاجنبي او حرم الرجل فرجه علي امراته او حرمت هي فرجها عليه لكان كل ذلك باطلا ولا حرام الا ما حرم الله تعالي او رسوله عليه السلام قال الله تعالي: (ولا تقولوا لما تصف السنتكم الكذب هذا حلال وهذا حرام لتفتروا علي الله الكذب) فان قال: علي لله تعالي حد يوجب اما زنا واما قذفا واما شرب خمر فهذا لم يتحقق ولا اقر اقرارا صحيحا وليس عليه الا حد الخمر لانه اقل الحدود الواجبة عليه بيقين، ولا يحل ان يزاد عليه شء بالشك فلا يجوز ان يجلد شيءا حتي يتبين ما هو الحد الذي عليه ويصفه وصفا تاما *  مسالة السجن في النهمة: قال ابو محمد رضي الله عنه: قال قوم: بالسجن في التهمة واحتجوا بما ثنا احمد بن قاسم ثنا ابي قاسم بن محمد بن قاسم ثنا جدي قاسم بن اصبغ ثنا محمد بن ابي العوام ثنا احمد بن حاتم الطويل ثنا ابراهيم بن خثيم بن عراك عن ابيه عن جده عن ابي هريرة ان النبي صلي الله عليه وسلم حبس في تهمة احتياطا او قال استظهارا يوما وليلة * وبه الي قاسم بن اصبع ثنا ابن وضاح حدثني محمد ابن ادم نا بن المبارك عن بهز بن حكيم عن ابيه عن جده عن النبي صلي الله عليه وسلم انه حبس في تهمة ثم خلي سبيله * ومن طريق عبد الرزاق عن معمر عن بهز بن حكيم عن ابيه
 عن جده معاوية بن حيدة قال: " اخذ رسول الله صلي الله عليه وسلم ناسا من قومه في تهمة فحبسهم فجاء رجل من قومي الي النبي صلي الله عليه وسلم وهو يخطب فقال: يا محمد علي ما تحبس جيرتي؟ فصمت النبي صلي الله عليه وسلم فقال: ان ناسا يقولون انك لتنهي عن الشء وتستخلي به فقال النبي صلي الله عليه وسلم: ما يقول؟ فجعلت اعرض بينهما بكلام مخافة ان يسمعها فيدعو علي قومي  دعوة لا يفلحون بعدها قال: فلم يزل النبي صلي الله عليه وسلم حتي فهمها قال قد قالوها؟ وقال قاءلها منهم: والله لو فعلتها لكان علي وما كان عليهم خلوا له عن جيرانه " * وبه الي عبد الرزاق عن ابن جريج اخبرني يحيي بن سعيد الانصاري عن عراك بن مالك قال: اقبل رجلان من بني غفار حتي نزلا منزلا بضجنان من مياه المدينة وعندها ناس من غطفان معهم ظهر لهم فاصبح الغطفانيون قد اضلوا بعيرين من ابلهم فاتهموا بهما الغفاريين فاقبلوا الي رسول الله صلي الله عليه وسلم وذكروا امرهم فحبس احد الغفاريين وقال للاخر اذهب فالتمس فلم يكن الا يسيرا حتي جاء بهما فقال النبي صلي الله عليه وسلم: لاحد الغفاريين حسبت انه المحبوس استغفر لي فقال: غفر الله لك يا رسول الله فقال رسول الله صلي الله عليه وسلم: ولك وقتلك في سبيله قال فقتل يوم اليمامة " * قال ابو محمد رحمه الله: وذهب الي هذا قوم كما روينا من طريق عبد الرزاق عن ابن جريج قال: كتب عمر بن عبد العزيز بن عبد الله كتابا قراته اذا وجد المتاع مع الرجل المتهم فقال: ابتعته فاشدده في السجن وثاقا ولا تحله بكتاب احد حتي ياتيه فيه امر الله تعالي قال ابن جريج: فذكرت ذلك لعطاء فانكره، وذهب اخرون الي المنع من الحبس بالتهمة كما روينا من طريق عبد الرزاق نا ابن جريج قال: سمعت عبد الله بن ابي مليكة يقول: اخبرني عبد الله بن ابي عامر قال انطلقت في ركب حتي اذا جءنا ذا المروة سرقت عيبة لي ومعنا رجل متهم فقال اصحابي: يا فلان اردد عليه عيبته: فقال ما اخذتها: فرجعت الي عمر بن الخطاب فاخبرته فقال: من انتم؟: فعددتهم فقال اظنها صاحبها للذي اتهم: فقلت لقد اردت يا امير المءمنين ان تاتي به مصفدا:
 فقال عمر: اتاتي به مصفودا بغير بينة لا اكتب لك فيها ولا اسالك عنها وغضب وما كتب لي فيها ولا سال عنها فانكر عمر رضي الله عنه ان يصفد احد بغير بينة * قال ابو محمد رحمه الله: فنظرنا في ذلك فوجدنا الاحاديث المذكورة لا حجة في شء منها لان ابراهيم بن خثيم ضعيف.
 وبهز بن حكيم ليس بالقوي.
 وحديث عراك مرسل ثم لو صح لكان فيه الدليل علي المنع من الحبس لاستغفار رسول الله صلي الله عليه وسلم من ذلك فان ذكروا حديث المراة الغامدية التي قالت لرسول الله صلي الله عليه وسلم: طهرني قال: " ويحك ارجعي فاستغفري الله وتوبي اليه قالت لعلك تردني كما رددت ماعز بن مالك قالت: اني حبلي من الزنا: قال: اثيب انت؟ قالت: نعم قال: فلا نرجمنك حتي تضعي ما في بطنك قال: فكفلها رجل من الانصار حتي وضعت فاتي بها رسول الله صلي الله عليه وسلم فقال: قد وضعت الغامدية قال: اذا لا نرجمها وندع ولدها صغيرا ليس له من يرضعه " فقال رجل من الانصار: الي رضاعه فرجمها " *

 قال ابو محمد رحمه الله: فهذا لا حجة لهم فيه لان رسول الله صلي الله عليه وسلم لم يسجنها ولا امر بذلك، لكن فيه ان الانصاري تولي امرها وحياطتها فقط * قال ابو محمد رحمه الله: فان ذكروا قول الله تعالي: " فامسكوهن في البيوت حتي يتوفاهن الموت او يجعل الله لهن سبيلا) فان هذا حكم منسوخ باجماع الامة * قال علي رحمه الله: فاذ لم يبق لمن راي السجن حجة فالواجب طلب البرهان علي صحة القول الاخر فنظرنا في ذلك فوجدنا من قال بسجنه لا يخلو من احد وجهين، اما ان يكون متهما لم يصح قبله شء، او يكون قد صح قبله شء من الشر، فان كان متهما بقتل او زنا او سرقة او شرب او غير ذلك فلا يحل سجنه لان الله تعالي يقول: (ان الظن لا يغني من الحق شيءا)، وقال رسول الله صلي الله عليه وسلم: " اياكم والظن فان الظن اكذب الحديث " وقد كان في زمن رسول الله صلي الله عليه وسلم المتهمون بالكفر وهم المنافقون
 فما حبس رسول الله صلي الله عليه وسلم منهم احدا، وبالله تعالي التوفيق *  مسالة فيمن اصاب حدا مرتين فصاعدا * قال ابو محمد رحمه الله: اختلف الناس في ذلك كمن زني مرتين فاكثر قبل ان يحد في ذلك او قذف مرتين فاكثر قبل ان يحد في ذلك او شرب الخمر مرتين فاكثر قبل ان يقام عليه الحد، او سرق مرتين فاكثر عليه ان يحد في ذلك او جحد عارية مرتين فاكثر قبل ان يقام عليه الحد في ذلك او حارب مرتين فاكثر قبل ان يقام عليه الحد في ذلك، فقالت طاءفة: ليس في كل ذلك الا حد واحد فقط، وقالت طاءفة: عليه لكل مرة حد * قال ابو محمد رحمه الله: فوجب ان ننظر في ذلك لنعلم الحق فنتبعه بعون الله تعالي، فنظرنا في قول من قال: لكل فعلة حد: فوجدناهم يحتجون بقول الله تعالي: (الزانية والزاني فاجلدوا كل واحد منهما ماءة جلدة) وقال تعالي: (والسارق والسارقة فاقطعوا ايديهما)، وقال تعالي: (والذين يرمون المحصنات ثم لم ياتوا باربعة شهداء فاجلدوهم ثمانين جلدة) ووجدنا رسول الله صلي الله عليه واله يقول: ما حدثناه عبد الله بن ربيع ثنا محمد بن معاوية ثنا احمد بن شعيب انا محمد بن رافع ثنا عبد الرزاق ثنا معمر عن سهل بن ابي صالح عن ابيه عن ابي هريرة انه قال: " من شرب الخمر فاجلدوه ثم اذا شرب فاجلدوه ثم اذا شرب فاجلدوه " وذكر باقي الخبر، قالوا: فوجب بنص كلام الله تعالي، وكلام رسوله صلي الله عليه وسلم علي من زنا الجلد المامور به، وعلي من سرق قطع يده، وعلي من قذف الجلد المامور به، وعلي من شرب الخمر الجلد المامور به، فاستقر ذلك فرضا عليه فاذ ذلك كذلك فبيقين ندري انه متي ني ثانية وجب عليه حد ثان، واذا سرق ثانية وجب  عليه بالسرقة الثانية قطع ثان، واذا قذف ثانية وجب عليه حد ثان، واذا شرب ثانية وجب عليه حد ثان ولابد، وهكذا في كل مرة * قال ابو محمد رحمه الله: اما قولهم ان الله تعالي قال: (الزانية والزاني) الاية،
 وقوله تعالي: " والسارق والسارقة " الاية، وقوله تعالي (والذين يرمون المحصنات) الاية، وقول رسول الله صلي الله عليه وسلم: " اذا شرب فاجلدوه ثم اذا شرب فاجلدوه ثم اذا شرب فاجلدوه " فكل ذلك حق ويكفر من انكر لفظه ومعناه، واما قولهم فاستقر ذلك فرضا عليه فهذا وهم اصحابنا، ولسنا نقول بهذا لكن نقول: انه لا يجب شء من الحدود المذكورة بنفس الزنا ولا بنفس القذف ولا بنفس السرقة ولا بنفس الشرب لكن حتي يستضيف الي ذلك معني اخر وهو ثبات ذلك عند الحاكم باقامة الحدود اما بعلمه واما ببينة عادلة، واما باقراره، واما ما لم يثبت عند الحاكم فلا يلزمه حد لا جلد ولا قطع اصلا، (برهان ذلك) هو انه لو وجبت الحدود المذكورة بنفس الفعل لكان فرضا علي من اصاب شيءا من ذلك ان يقيم الحد علي نفسه ليخرج مما لزمه او ان يعجل المجء الي الحاكم فيخبره بما عليه ليءدي ما لزمه فرضا في ذمته لا في بشرته، وهذا امر لا يقوله احد من الامة كلها بلا خلاف، اما اقامته الحد علي نفسه فحرام عليه ذلك باجماع الامة كلها وانه لا خلاف في انه ليس لسارق ان يقطع يد نفسه بل ان فعل ذلك كان عند الامة كلها عاصيا لله تعالي فلو كان الحد فرضا واجبا بنفس فعله لما حل له الستر علي نفسه ولا جاز له ترك الاقرار طرفة عين ليءدي عن نفسه ما لزمه، وانما امر الله تعالي ورسوله عليه السلام الاءمة وولاتهم باقامة الحدود المذكورة علي من جناها، وبيقين الضرورة ندري ان الله تعالي لم يامرهم من ذلك الا اذا ثبت ذلك عندهم وصح يقينا ان لكل زنا يزنيه، وكل قذف يقذفه، وكل شرب يشربه، وكل سرقة يسرقها، وكل حرابة يحارب، وكل عارية يجحدها قبل علم الامام بذلك فلم يجب عليه فيه شء لكنا نقول: ان الله تعالي اوجب علي من زني مرة او الف مرة ادا علم الامام بذلك جلد ماءة وعلي القاذف، والسارق، والمحارب، وشارب.
 الخمر، والجاحد مرة والف مرة حدا واحدا اذا علم الحاكم ذلك كله * قال ابو محمد رحمه الله: واما ان وقع علي من فعل شيءا من ذلك تضييع من الامام او اميره لغير ضرورة ثم شرع في اقامة الحد فوقعت ضرورة منعت من
 اتمامه فواقع فعلا اخر من نوع الاول، فقولنا وقول اصحابنا سواء يستتم عليه الحد الاول ثم يبتدء في الثاني ولابد * برهان ذلك ان الحد كله قد وجب بعلم الامام او  اميره مع قدرته علي اقامة جميع الحد ثم احدث ذنبا اخر فلا يجزي عنه حد قد تقدم وجوبه * قال ابو محمد رحمه الله: ونسال المخالفين عن قولهم فيمن زنا مرات او شرب مرات.
 او قذف مرات انسانا واحدا، او سرق مرات، او حارب مرات وعلم الامام كل دلك وقدر علي اقامة الحدود عليه ثم لم يحد حتي واقع ما ذكرنا فلم يوجبوا عليه الا حدا واحدا، ما الفرق بين هذا وبين قول من قال منهم: ان افطر عامدا فوطء اياما من شهر رمضان ان عليه لكل يوم كفارة، ومن حلف ايمانا كثيرة علي اشياء مختلفة فعليه لكل يمين كفارة ومن قال منهم: ان ظاهر مرات كثيرة فان لكل ظهار كفارة، وقولهم كلهم: ان من اصاب وهو محرم صيودا فعليه لكل صيد جزاء بل قال بعضهم: انه لو اصاب صيدا واحدا وهو قارن فعليه جزاءان، فان ادعوا في كفارة الافطار في رمضان اجماعا ظهر جهل من ادعي ذلك او كذبه لان زفر بن الهذيل وغيره منهم يري ان من افطر بوطء او غيره جميع ايام شهر رمضان ولم يكفر فليس عليه الا كفارة واحدة فقط، وهذا هو الواجب علي قول سعيد بن المسيب لان المحفوظ عنه ان شهر رمضان كله صوم واحد من افطر يوما منه فعليه قضاء جميعه يقضي شهرا ولا بد، ومن افطره كله فعليه شهر واحد ايضا ولا مزيد *  مسالة فيمن اصاب حدا ثم لحق بالمشركين او ارتد * قال ابو محمد رحمه الله: نا عبد الله بن ربيع ثنا محمد بن معاوية ثنا احمد بن شعيب انا قتيبة بن سعيد ثنا حميد بن عبد الرحمن عن ابيه عن ابي اسحق السبيعي عن جرير.
 بن عبد الله البجلي قال: قال رسول الله صلي الله عليه وسلم: " اذا ابق العبد الي الشرك فقد حل دمه " *
 قال ابو محمد رحمه الله: فبهذا ناخذ والعبد ههنا كل حر وعبد فكلنا عبيد الله تعالي تعالي ومن لحق بارض الشرك بغير ضرورة فهو محارب، هذا اقل احواله ان سلم من الردة بنفس فراقه جماعة الاسلام وانحيازه الي ارض الشرك بما حدثنا يوسف بن عبد الله ابن عبد البر النمري ثنا خلف بن القاسم ثنا احمد بن سعد المهراني ثنا احمد بن عبد الجبار ثنا ابو معاوية محمد بن حازم عن اسماعيل بن ابي خالد عن قيس بن ابي حازم عن جرير ابن عبد الله البجلي قال: قال رسول الله صلي الله عليه وسلم: " انا برء من كل مسلم مقيم بين اظهر المشركين " * قال ابو محمد رحمه الله: وسنستقصي الكلام ان شاء الله تعالي في هذا في كتاب الردة من هذا الكتاب، فان قال قاءل: انما ذكر رسول الله صلي الله عليه وسلم ها هنا مع ذكر  العبد الاباق فصح انه انما عني بذلك المماليك فقط، قلنا وبالله تعالي التوفيق: ليس الاباق لفظا موقوفا علي المماليك الذين.
 لنا فقط، بل كل من هرب عن سيده ومالكة فهو ابق، والله تعالي مالك الجميع والكل عبيده ومماليكه فمن هرب عن جماعة الله تعالي وعن دار دين الله تعالي الي دار اعداء الله تعالي المحاربين لله عزوجل فهو ابق * برهان ذلك قول الله تعالي: (وان يونس لمن المرسلين اذ ابق الي الفلك المشحون) فقد سمي الله تعالي فعل يونس رسوله صلي الله عليه وسلم  وهو حر بلا خلاف  اذ فر عن امر ربه تعالي اباقا فصح ان الاباق لكل حر وعبد، وبالله تعالي التوفيق * حدثنا عبد الله بن ربيع ثنا محمد ابن معاوية ثنا احمد بن شعيب انا محمد بن قدامة عن جرير عن المغيرة بن مقسم عن الشعبي قال: كان جرير بن عبد الله يحدث عن النبي صلي الله عليه وسلم " اذا ابق العبد لم تقبل له صلاة وان مات مات كافرا فاق غلام لجرير فاخذه فضرب عنقه " * قال ابو محمد رحمه الله: ولا يسقط عن اللاحق بالمشركين لحاقه بهم شيءا من الحدود التي اصابها قبل لحاقه ولا التي اصابها بعد لحاقه لان الله تعالي اوجب
 الحدود في القران علي لسان رسوله صلي الله عليه وسلم ولا ارسلها ولم يسقطها، وكذلك لم يسقطها عن المرتد ولا عن المحارب ولا عن الممتنع ولا عن الباغي اذا قدر علي اقامتها عليهم وما كان ربك نسيا، ونحن نشهد بشهادة الله تعالي ان الله عزوجل لو اراد ان يستثني احدا من هءلاء لما سكت عن ذلك اعناتا لنا ولا اهمله ولا اغفله فاذ لم يعلمنا بذلك فنحن نقسم بالله تعالي ان الله تعالي ما اراد قط اسقاط حد اصابه لاحق بالشرك قبل لحاقه او اصابه بعد لحاقه بهم او اصابه مرتد قبل ردته او بعدها وان من خالف هذا فمخطء عند الله تعالي بيقين لا شك فيه، وقد صح النص والاجماع باسقاطه وهو ما اصابه اهل الكفر ماداموا في دار الحرب قبل او يتذمموا او يسلموا فقط فهذا خارج بفعل رسول الله صلي الله عليه وسلم في كل من اسلم منهم فلم يءاخذهم بشء مما سلف لهم من قتل او زنا، او قذف، او شرب خمر.
 او سرقة، وصح الاجماع بذلك، فان قال قاءل: فان الله تعالي يقول: (قل للذين كفروا ان ينتهوا يغفر لهم ما قد سلف) * وقال تعالي: (ومن يتولهم منكم فانه منهم) فصح بهذا ان المرتد من الكفار بلا شك فاذ هو منهم فحكمه حكمهم * وذكروا من طريق مسلم حدثنا محمد بن المثني ثنا الضحاك  يعني ابا عاصم النبيل  انا حيوة بن شريح ثنا يزيد ابن ابي حبيب عن ابن شمامة المهري ثنا مضر ثنا عمرو بن العاص في سياقة الموت يبكي طويلا فذكر الحديث وفيه قال: " فلما جعل الله الاسلام في قلبي اتيت رسول الله  صلي الله عليه وسلم فقلت: ابسط يمينك فلابايعك فبسط يمينه فقبضت يدي فقال: ما لك يا عمرو؟ فقلت اردت ان اشترط: فقال: تشترط ماذا؟ قلت: ان يغفر لي قال: اما علمت ان الاسلام يهدم ما قبله وان الهجرة تهدم ما قبلها وان الحج يهدم ما قبله " وذكر باقي الكلام * ومن طريق مسلم حدثنا محمد بن حاتم بن ميمون وابراهيم بن دينار واللفظ لابراهيم قال ثنا حجاج  هو ابن محمد  عن ابن جريج اخبرني يعلي بن مسلم انه سمع
 سعيد بن جبير يحدث عن ابن عباس " ان ناسا من اهل الشرك قتلوا فاكثروا وزنوا فاكثروا فاتوا النبي صلي الله عليه وسلم فقالوا: ان الذي تقول وتدعو اليه لحسن ولو تخبرنا ان لما عملنا كفارة فنزل (والذين لا يدعون مع الله الها اخر ولا يقتلون النفس التي حرم الله الا بالحق) الي قوله: (يلق اثاما) (وقل يا عبادي الذين اسرفوا علي انفسهم لا تقنطوا من رحمة الله) الاية * قال ابو محمد رحمه الله: تمام الاية الاولي الي قوله: (حسنات) والاخري (ان الله يغفر الذنوب جميعا) وكل هذا حق ولا حجة لهم فيه بل عليهم علي ما نبين ان شاء الله تعالي * اما قول الله تعالي: (قل للذين كفروا ان ينتهوا يغفر لهم ما قد سلف) الاية فنعم هكذا نقول ولم نخالفهم في هذه الاية ولا هي مسالتنا وانما مسالتنا هل تقام عليهم الحدود السالفة ام لا؟ وليس في هذه الاية من هذا حكم اصلا لا بنص من القران، ولا من السنة وان التاءب منا مغفور له وان ماعزا مغفور له والغامدية والجهنية.
 مغفور لهما بلا شك، ولم تسقط عنهم مغفرة الله تعالي لهم ذنبهم حد الله تعالي الواجب في الدنيا وانما اسقطت مغفرة الله تعالي عنهم عذاب الاخرة فقط ولم يسقط عنهم الحد بحكم رسول الله صلي الله عليه وسلم عليهم مع علمه صلي الله عليه وسلم انه مغفور لهم اقام علهيم حد الزنا الذي قد غفره الله تعالي لهم، وقد جلد رسول الله صلي الله عليه وسلم مسطح بن اثاثة في القذف وهو بدري مغفور له وجلد النعمان في الخمر وهو بدري مغفور له، وجلد عمر رضي الله عنه بحضرة الحصابة رضي الله عنهم قدامة بن مظعون وهو بدري مغفور له، كل ما فعل في الخمر ولو تمت الشهادة علي المغيرة لحده وهو حدبي مغفور له ما قد فعل، فصح ان المغفرة من الله تعالي لا تسقط الحدود الواجبة في الدنيا ومن خالف هذا وقال: ان التوبة تسقط الحدود كلها خالف حكم رسول الله صلي الله عليه وسلم الذي ذكرنا، وقد تقصينا هذا في باب مفرد لذلك قبل هذا بابواب يسيرة * واما قول الله تعالي: (ومن يتولهم منكم فانه منهم) فلا حجة لهم في هذا اصلا لانه ليس فيها اسقاط
 الحدود علي من ابق اليهم او ارتد وانما فيها ان المرتد من الكفار، وهذا لا شك  فيه عند مسلم (فان قالوا): بلي ولكن لما كان منهم حكم له بحكمهم قلنا: لهم هذا واضح، وبرهان ذلك اجماعكم معنا علي ان المرتد لا يقر علي ردته بخلاف المشرك الكتابي الذي يقر علي كفره اذا ادي الجزية صاغرا وتذمم، وانه لا يقبل من المرتد جزية اصلا عندكم، وانه لا تنكح المرتدة بخلاف المشركة الكتابية، وانه لا تءكل ذبيحة المرتد بخلاف المشرك الكتابي ولا يسترق المرتد ان سبي كما يسترق المشرك ان سبي فقد اقررتم ببطلان قياسكم الفاسد فابطلتم ان يقاس المرتد علي الكافر في شء من هذه الوجوه ويلزمكم ان لا تقيسوه عليهم في سقوط الحدود فهو احوط لقياسكم، ولاح انهم في هذه المسالة لا النص من القران والسنة اتبعوا، ولا القياس طردوا، ولا تعلقوا بشء اصلا، وبالله تعالي التوفيق * وصح ان قول الله تعالي: (ومن يتولهم منكم فانه منهم) انما هو علي ظاهره بانه كافر من جملة الكفار فقط وهذا حق لا يختلف فيه اثنان من المسلمين فان ادعوا ان المرتد لا تقبل منه جزية، ولا تءكل ذبيحته، ولا يسترق اجماعا دل ذلك علي جهل من ادعي ذلك او كذبه * فقد صح عن بعض السلف اخذ الجزية منهم، وعن بعض الفقهاء اكل ذبيحته ان ارتد الي دين صابء، وابو حنيفة واصحابه يقولون: ان المرتدة اذا لحقت بارض الحرب سبيت واسترقت ولم تقتل ولو انها هاشمية او عبشمية * حدثنا حمام ثنا ابن مفرج ثنا بن الاعرابي ثنا الدبري ثنا عبد الرزاق عن معمر عن سماك بن الفضل ان عاملا لعمر بن عبد العزيز كتب الي عمر بن عبد العزيز في رجل اسلم ثم ارتد فكتب اليه عمر بن عبد العزيز ان اساله عن شراءع الاسلام فان كان قد عرفها فاعرض عليه الاسلام فان ابي فاضرب عنقه وان كان لم يعرفها فغلظ عليه الجزية ودعه قال معمر: واخبرني قوم من اهل الجزيرة ان
 قوما اسلموا ثم لم يمكثوا الا قليلا حتي ارتدوا فكتب فيهم ميمون بن مهران الي عمر بن عبد العزيز فكتب عمر بن عبد العزيز ان رد عليهم الجزية ودعهم، وقد روي نحو هذا عن عمر بن الخطاب * قال ابو محمد رحمه الله: واما حديث عمر وبن العاص فهو عليهم اعظم حجة لان فيه تسوية النبي صلي الله عليه وسلم بين الاسلام والهجرة والحج في ان كل واحد منها يهدم ما قبله وهم لا يختلفون ولا احد نعلمه في ان الجج لا يسقط حدا اصابه المرء قبل حجه ولم يتب منه ولم تطل مدته دونه فمن الباطل ان يتحكموا في حكم الله تعالي علي لسان رسوله صلي الله عليه وسلم فيحملوا قوله عليه السلام: " ان الاسلام يهدم ما قبله " علي ان الاسلام يسقط  الحدود التي واقعها العبد قبل اسلامه ويجعل الحج لا يسقطها، وكلا الامرين جاء عن رسول الله صلي الله عليه وسلم مجيءا واحدا وان هذا الخبر ضد قولهم في هذه المسالة وذلك ان رسول الله صلي الله عليه وسلم انما اخبر ان الاسلام يهدم ما قبله وان الهجرة تهدم ما قبلها وان الحج يهدم ما قبله فقالوا هم: ان الردة الي الكفر تهدم ما قبلها من الحدود الواجبة قياسا للكفر علي الاسلام وان الهجرة الي الشيطان واللحاق بدار الكفر واهل الحرب تهدم ما قبلها من الحدود قياسا علي الهجرة الي الله تعالي والي دار الاسلام وان الحج لا يهدم ما قبله، وهذا عين العناد والخلاف والمكابرة لرسول الله صلي الله عليه وسلم * واما حديث عمر رضي الله عنه فانه لم يتكلم قط في ذلك الخبر في ثبات الحدود او سقوطها وانما تكلم في المغفرة، واذا قلنا: ان مغفرة الله تعالي للذنوب لا تسقط الحدود الواجبة في تلك الذنوب الا حيث صح النص.
 والاجماع باسقاطها فقط وليس ذلك الا في الحربي الكافر يبتدء الاسلام فقط، ونحن نقول: ان الاسلام والهجرة الصادقة الي الله تعالي ورسوله عليه السلام.
 وان الحج المبرور يهدم ما قبله من الذنوب ومن صفة كل ما ذكرنا من الاسلام الحسن والهجرة الصادقة والحج المبرور
 ان يتوب صاحب هذه الحال عن كل ذنب سلف قبله * برهان ذلك ما حدثنا به عبد الرحمن ابن عبد الله بن خالد نا ابراهيم بن احمد نا الفربري نا البخاري نا خلاد بن يحيي نا سفيان بن منصور.
 والاعمش كلاهما عن ابي واءل عن عبد الله بن مسعود قال: قال رجل لرسول الله صلي الله عليه وسلم: انءاخذ بما عملنا في الجاهلية قال: " من احسن في الاسلام لم يءاخذ بما عمل في الجاهلية ومن اساء في الاسلام اخذ بالاول والاخر " * قال ابو محمد رحمه الله: فحكم الاحسان في الاسلام هو التوبة من كل ذنب اسلفه ايام كفره، واما من اصر علي معاصيه فما احسن في اسلامه بل اساء فيه، وكذلك من لم يهجر ما نهي الله تعالي عنه فليس تام الهجرة وكل حج اصر صاحبه علي المعاصي فيه فلم يوف حقه من البر فليس مبرورا، وبالله تعالي التوفيق *  مسالة الاستتابة في الحدود وترك سجنه * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق نا ابن جريج قال: حضرت عبد العزيز بن عبد الله جلد انسانا الحد في فرية فلما فرغ من ذلك قال له ابو بكر بن عبد الرحمن بن عبد الله بن ربيعة: ان من الامر ان يستتاب عند ذلك فقال عبد العزيز للمجلود: تب فحسبنه انه قال اتوب الي الله: قال ابن جريج: واخبرني بعض علماء اهل المدينة انهم لا يختلفون انه يستتاب كل من عمل عمل قوم لوط.
 او زني، او افتري، او شرب، او سرق او حارب، قال عبد الرزاق: وخبرني ابو بكر  عن غير واحد عن ابن المسيب انه قال: سنة الحد ان يستتاب صاحبه اذا فرغ من جلده قال سعيد بن المسيب: ان قال قد تبت وهو غير رضي لم تقبل شهادته * قال ابو محمد رحمه الله: وبهذا نقول لان التوبة فرض من الله تعالي علي كل مذنب ولان الدعاء الي التوبة فرض علي كل مسلم قال الله تعالي: (يا ايها الذين امنوا توبوا الي توبة نصوحا عسي ربكم ان يكفر عنكم سيءاتكم) الاية واذا كان هذا الاصرار علي الذنب حراما باجماع الامة كلها المتيقن فالتوبة والاقلاع فرض باجماع الامة كلها
 لا خلاف في ذلك، قال الله تعالي: (ادع الي سبيل ربك بالحكمة والموعظة الحسنة) وقال تعالي: (ولتكن منكم امة يدعون الي الخير) الاية * قال ابو محمد رحمه الله: فلما كانت التوبة من سبيل الله تعالي المفترض سلوكها وكانت من الخير والمعروف كان فرضا علي كل مسلم ان يدعو اليها بالنصوص التي ذكرنا واستتابة المذنب قبل اقامة الحد عليه واجبة لقول الله تعالي: (سارعوا الي مغفرة من ربكم) فالمسارعة الي الفرض فرض فان لم يستتبه الامام او من حضره الا حتي اقيم عليه الحد فواجب ان يستتاب بعد الحد علي ما ذكرنا فان لم يتب فاقيم عليه استتيب فان تاب اطلق ولا سبيل عليه بحبس اصلا لانه قد اخذ حق الله تعالي منه الذي لاحق له قبله سواه، فالزيادة علي ذلك تعد لحدود الله تعالي وهذا حرام *  مسالة قال ابو محمد رحمه الله: فان قال: لا اتوب فقد اتي منكرا فواجب ان يعزر علي ما نذكره في كتاب التعزير ان شاء الله تعالي لقول رسول الله صلي الله عليه وسلم: " من راي منكم منكرا فليغيره بيده ان استطاع فان لم يستطع فبلسانه فان لم يستطع فبقلبه وذلك اضعف الايمان " فيجب ان يضرب ابدا حتي يتوب هذا ان صرح بان لا يتوب، فاذا ادي ذلك الي منيته فذلك عقيرة الله وقتيل الحق لا شء علي متولي ذلك لانه احسن فيما فعل به، وقد قال الله تعالي: (ما علي المحسنين من سبيل) فان سكت ولم يقل اتوب ولا لا اتوب فواجب حبسه واعادة الاستتابة عليه ابدا حتي ينطق بالتوبة فيطلق * برهان ذلك انه قد صح منه الذنب ووجبت عليه التوبة ولا تعرف توبته الا بنطقه بها فهو ما لم ينطق بها وبالاصرار فممكن ان يتوب في نفسه وممكن ان لا يتوب فلما كان كلا الامرين ممكنا لم يحل ضربه لانه لم يات بمنكر تيقن انه اتي به ولم يجز تسريحه لان فرضا عليه دعاءه الي التوبة حتي يتوب ولا سبيل الي امساكه وبالله تعالي التوفيق * وهكذا ابدا متي تاب ثم واقع الذنب او غيره فقد جاء عن رسول الله صلي الله عليه وسلم خبر ان مرسلان في انه استتاب السارق بعد قطع يده كما حدثنا حمام  نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج.
 وسفيان الثوري.
 ومعمر قال ابن جريج.
 وسفيان كلاهما عن ابي خصفة عن محمد بن عثمان بن ثوبان، وقال معمر: عن ايوب السختياني قال ايوب.
 وابن ثوبان: اتي النبي صلي الله عليه وسلم برجل سرق شملة فقيل يا رسول الله هذا سرق: فقال النبي صلي الله عليه وسلم: " ما اخاله اسرقت؟ قال: نعم قال: فاذهبوا فاقطعوا يده ثم احسموها ثم اءتوني به فاتوه به فقال: اني اتوب الي الله فقال: اللهم تب عليه " * وبه الي عبد الرزاق عن معمر عن ابن المنكدر ان النبي صلي الله عليه وسلم قطع رجلا ثم امر به فحسم قال له: " تب الي الله تعالي فقال اتوب الي الله تعالي فقال النبي صلي الله عليه وسلم: ان السارق اذا قطعت يده وقعت في النار فان عاد تبعها وان تاب استشالها " قال عبد الرزاق يقول استرجعها: * قال ابو محمد رحمه الله: هذان مرسلان ولا حجة في مرسل وانما الحجة فيما اوردنا من النصوص قبل، وانما اوردناهما لءلا يموه مموه بما فيهما من الاستتابة بعد القطع وبالله تعالي التوفيق *   مسالة  الامتحان في الحدود وغيرها بالضرب او السجن او التهديد * قال علي رحمه الله: لا يحل الامتحان في شء من الاشياء بضرب ولا بسجن ولا بتهديد لانه لم يوجب ذلك قران.
 ولا سنة ثابتة.
 ولا اجماع ولا يحل اخذ شء من الدين الا من هذه الثلاثة النصوص () بل قد منع الله تعالي من ذلك علي لسان رسوله صلي الله عليه وسلم بقوله: " ان دماءكم واموالكم واعراضكم وابشاركم عليكم حرام " فحرم الله تعالي البشر.
 والعرض فلا يحل ضرب مسلم ولا سبه الا بحق اوجبه القران او السنة الثابتة وقال تعالي: (فامشوا في مناكبها وكلوا من رزقه) فلا يحل لاحد ان يمنع مسلما من المشي في الارض بالسجن بغير حق اوجبه قران او سنة ثابتة، واما من صح قبله حق ولواه ومنعه فهو ظالم قد تيقن ظلمه فواجب ضربه ابدا حتي يخرج مما عليه لقول
 رسول الله صلي الله عليه وسلم: " من راي منكم منكرا فليغيره بيده ان استطاع " ولامره عليه السلام بجلد عشرة فاقل فيما دون الحد علي ما نذكره في باب التعزير ان شاء الله تعالي وانما هذا فيما صح انه عنده او يعلم مكانه لما ذكرنا، واما من كلف اقرارا علي غيره فقط وقد علم انه يعلم الجاني فلا يجوز تكليفه ذلك لانها شهادة ومن كتم الشهادة فانه فاسق لقول الله تعالي: (فلا تكتموا الشهادة ومن يكتمها فانه اثم قلبه) فاذ هو فاسق اثم فلا ينتفع بقوله لا يحل قبول شهادته حينءذ وهو مجرح بذلك ابدا ما لم يتب فلا  يحل ان يهدد احد ولا ان يروع بان يبعث الي ظالم يعتدي عليه، وبالله تعالي التوفيق * قال ابو محمد رحمه الله: ولا خلاف في ان كل هذا حرام في الذمي كما هو في المسلم فان ضرب حتي اقر فقد جاء عن بعض السلف في هذا ما حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح ناسحنون نا ابن وهب عن ابن ابي ذءب عن ابن شهاب ان طارقا كان جعل ثعلبا الشامي علي المدينة يستخلفه فاتي بانسان اتهم بسرقة فلم يزل يجلده حتي اعترف بالسرقة فارسل الي عبد الله بن عمر بن الخطاب فاستفتاه فقال ابن عمر: لا تقطع يده حتي يبرزها * قال ابو محمد رحمه الله: اما ان لم يكن الا اقراره فقط فليس بشء لان اخذه باقرار هذه صفته لم يوجبها قران ولا سنة ولا اجماع وقد صح تحريم بشرته ودمه بيقين فلا يحل شء من ذلك الا بنص او اجماع فان استضاف الي الاقرار امر يتحقق به يقينا صحة ما اقر به ولا يشك في انه صاحب ذلك فالواجب اقامة الحد عليه وله القود مع ذلك علي من ضربه السلطان كان او غيره لانه ضربه ظالما له دون ان يجب عليه ضرب وهو عدوان وقد قال الله تعالي: (فمن اعتدي عليكم فاعتدوا عليه) الاية وليس ظلمه وما وجب عليه من حد الله تعالي او لغيره بمسقط حقه
 عند غيره في ظلمه له بل يءخذ منه ما عليه ويعطي هو من غيره وهكذا قال مالك وغيره في السارق يمتحن فيخرج السرقة بعينها ان عليه القطع اذا كانت مما يقطع فيه الا ان يقول دفعها الي انسان ادفعها له وانما اعترفت لما اصابني من الضرب فلا يقطع * قال ابو محمد رحمه الله: وهذا صحيح وبه نقول، واما البعثة في المتهم وايهامه دون تهديد ما يوجب عليه الاقرار فحسن واجب كبعث رسول الله صلي الله عليه وسلم خلف اليهودي الذي ادعت الجارية التي رض راسها فسيق اليه فلم يزل به عليه السلام حتي اعترف فاقاد منه وكما فعل علي بن ابي طالب اذ فرق بين المدعي عليهم القتل واسر الي احدهم ثم رفع صوته بالتكبير فوهم الاخر انه قد اقر ثم دعي بالاخر فساله فاقر حتي اقروا كلهم فهذا حسن لانه لا اكراه فيه ولا ضرب، وقد كره هذا مالك ولا وجه لكراهيته لانه ليس فيه عمل محظور وهو فعل صاحب لا يعرف له من الصحابة مخالف ينكر ذلك وانما الكره ما حدثنا يونس بن عبد الله نا احمد بن عبد الله بن عبد الرحيم نا احمد بن خالد نا محمد بن عبد السلام الخشني نا محمد بن بشار نا يحيي بن سعيد القطان نا ابو حيان يحيي بن سعيد التيمي عن ابيه عن الحارث بن سويد عن عبد الله بن مسعود انه قال: ما من كلام يدرا عني سوطا او سوطين عند سلطان الا تكلمت به *

 وعن شريح انه قال: السجن كره والوعيد كره والقيد كره والضرب كره * قال ابو محمد رحمه الله: كل ما كان ضرارافي جسم او مال او توعد به المرء في ابنه او ابيه او اهله او اخيه المسلم فهو كره لقول رسول الله صلي الله عليه وسلم: " المسلم اخو المسلم لا يظلمه ولا يسلمه " * ولما روينا من طريق البخاري نا مسدد نا يحيي  هو ابن سعيد القطان  عن شعبة عن قتادة عن انس عن النبي صلي الله عليه وسلم قال: " لا يءمن احدكم حتي يحب لاخيه ما يحب لنفسه " *   مسالة  الشهادة علي الحدود * قال علي: نا محمد بن سعيد بن نبات
 نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية ثنا وكيع عن سفيان الثوري عن علي بن كليب عن ابيه ان علي بن ابي طالب كان يامر بالشهود اذا شهدوا علي السارق ان يقطعوه يلون ذلك * قال ابو محمد رحمه الله: ليس هذا بواجب لانه لا يوجبه قران ولا سنة عن رسول الله صلي الله عليه وسلم وسلم ثابتة لكن طاعة الامام او اميره واجبة فاذا امر الامام او اميره الشهود او غيرهم ان يقطعه لزمتهم الطاعة، وبالله تعالي التوفيق * وبه الي وكيع نا اسراءيل عن جابر الجعفي عن الشعبي في رجلين شهدا علي ثلاثة انهم سرقوا قال: يقطعون * قال علي رحمه الله: وهكذا نقول، ولو شهد عدلان علي الف رجل او اكثر بقتل او بسرقة او بحرابة او بشرب خمر او بقذف لوجب القود والقطع والحد في كل ذلك علي جميعهم بشهادة الشاهدين ولا فرق بين شهادتهما عليهم مجتمعين وبين شهادتهما علي كل واحد منهم علي انفراده * قال ابو محمد رحمه الله: ولو ان عدلين شهدا علي عدول بشء مما ذكرنا وقال المشهود عليهم: نشهد عليهم بكذا وكذا مثل ما شهد به الشاهدان عليهم او شيءا اخر لم يلتفت الي شهادة المشهود عليهم اصلا ووجب انفاذ الحدود والحقوق عليهم بشهادة السابقين الي الشهادة * برهان ذلك ان المشهود عليهم بما ذكرنا قد بطلت عدالتهم وصحت جرحتهم بشهادة العدلين عليهم بما شهدا به مما يوجب الحد فان من ثبت عليه ما يوجب الحد او بعض المعاصي التي لا توجب حدا كالغصب وغيره فهو مجرح فاسق بيقين ولا شهادة لمجرح فاسق اصلا، فلو ان المشهود عليهم صحت توبتهم بعد ماكان منهم وجب بذلك ان تعود عدالتهم فاذا كان ذلك كذلك فان الشهادتين معا مقبولتان وينفذ علي كلا الطاءفتين شهدت به عليها الاخري الا ان كلتا الشهادتين شهادة واجبة قبولها بنص القران والسنة  في امره تعالي بالحكم بشهادة العدول وبالله تعالي التوفيق * فان شهدت كلتا الطاءفتين علي الاخري معا لم تسبق احدي الشهادتين الاخري اما عند حاكيمن واما في عقدين عند حاكم واحد فهما ايضا شهادتان قاءمتان صحيحتان فان كلتا الشهادتين تبطل بيقين لا شك فيه لانه ليست احداهما باولي بالقبول من الاخري فلو قبلناهما معا لكنا قد صرنا موقنين باننا ننفذ الشهادة الان دابا حكما بشهادة فساق لان كل شهادة منهما توجب الفسق والجرحة علي الاخري والمنع من قبول الشهادة الاخري، ولو حكمنا باحدي الشهادتين علي الاخري مطارفة لكان هذا عين الظلم والجور اذ لم يوجب ترجيح احداهما علي الاخري نص ولا اجماع، ومن اراد ان يرجح الشهادة ها هنا باعدل البينتين او باكثرهما عددا فهو خطا من القول لانه لم يوجب الله تعالي قط شيءا من ذلك ولا رسوله صلي الله عليه وسلم وسلم ولا اجمعت الامة عليه، والحكم بمثل هذا لا يجوز *   مسالة  من شهد في حد بعد حين * قال ابو محمد رحمه الله: نا محمد بن سعيد بن نبات نا عبد الله بن نصر ثنا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية ثنا وكيع نا مسعر بن كدام عن ابي عون  هو محمد بن عبد الله الثقفي  قال عمر بن الخطاب: من شهد علي رجل بحد لم يشهد به حين اصابه فانما يشهد علي ضغن، قال علي: نا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب قال: بلغني عن ربيعة انه قال في رجل زني في صباه واطلع علي ذلك رهط عدول فلم يرفعوا امره ولبث بذلك سنين وحسنت حالته ثم نازع رجلا فرماه بذلك واتي علي ذلك بالبينة واعترف فانه يرجم، لا يضع الحد عن اهله طول زمان ولا ان يحدث صاحب ذلك حسن هيءة، قال ابن وهب: يريد بصباه سفهه بعد الاحتلام * قال ابو محمد رحمه الله: وقال ابو حنيفة.
 واصحابه: ان شهد اربعة عدول احرار مسلمون بالزنا بعد مدة فلا حد عليه * قال ابو يوسف: مقدار المدة المذكورة شهر واحد، وقالوا: ان شهد عليه عدلان مسلمان حران بسرقة بعد مدة فلا قطع عليه لكن يضمن ما شهد عليه بانه سرقه ولو شهدا عليه بشرب خمر، فان كانت الشهادة وريح الخمر توجد منه
 او وهو سكران اقيم عليه الحد وان كانت تلك الشهادة بعد ذهاب الريح او السكر فلا حد عليه الا ان يكونوا حملوه الي الامام في مصر اخر فزال الريح او السكر في الطريق فانه يحد، ولو شهد عليه بعد مدة طويلة بقذف او جراحة حد للقدف ووجب عليه حكم تلك الجراحة، وقال الشافعي.
 واصحابه واصحابنا: يقام عليه الحد في كل ذلك، وقال الاوزاعي.
 والليث.
 والحسن بن حي مثل ذلك *

 قال ابو محمد رحمه الله: واذ قد بلغنا ههنا فلنتكلم بعون الله تعالي في حكم من اطلع علي حد اهو في حرج ان كتم الشهادة ام في سعة من ذلك؟ فنقول: قال الله تعالي: (واقيموا الشهادة لله)، وقال تعالي: (ومن اظلم ممن كتم شهادة عنده من الله) وقال تعالي: (ولا تكتموا الشهادة ومن يكتمها فانه اثم قلبه) وقال تعالي: (ولا يابي الشهداء اذا ما دعوا) ووجدنا ما روينا من طريق مسلم نا قتيبة بن سعيد نا ليث  هو ابن سعد  عن عقيل عن الزهري عن سالم بن عبد الله بن عمر عن ابيه " ان رسول الله صلي الله عليه وسلم: قال المسلم اخو المسلم لا يظلمه ولا يسلمه، ومن كان في حاجة اخيه كان الله في حاجته ومن فرج عن مسلم كربة فرج الله بها عنه كربة من كرب يوم القيامة، ومن ستر مسلما ستره الله يوم القيامة " * قال ابو محمد رحمه الله: فوجب استعمال هذه النصوص كلها فنظرنا في ذلك فوجدنا العمل في جمعها الذي لا يحل لاحد غيره لا يخلو من احد وجهين اما ان يخص عموم الايات المذكورة بالخبر المدكور، واما ان يخص عموم الخبر المذكور بالايات المذكورات اذ لا يمكن البتة غير هذا ولابد من احد العملين فان خصصنا عموم الايات بالخبر كان القول في ذلك ان القيام بالشهادات كلها والاعلان بها فرض الا ما كان منها ستر المسلم في حد من الحدود فالافضل الستر وان خصصنا عموم الخبر بالايات كان القول في ذلك ان الستر علي المسلم حسن الا ماكان من اداء الشهادات فانه واجب فنظرنا اي
 هذين العملين هو الذي يقوم البرهان علي صحته فيءخذ به اذ لا يحل اخذ احداهما مطارفة دون الاخر ولا يجوز ان يكونا جمعا جميعا بل الحق في احدهما بلا شك فنظرنا في ذلك بعون الله تعالي فوجدنا الستر علي المسلم الذي ندبنا اليه في الحديث لا يخلو من احد وجهين لا ثالث لهما اما يستره ويستر عليه في ظلم يطلب به المسلم فهذا فرض واجب وليس هذا مندوبا اليه بل هو كالصلاة والزكاة، واما ان يكون في الذنب يصيبه المسلم ما بينه وبين ربه تعالي ولم يقل احد من اهل الاسلام باباحة الستر علي مسلم في ظلم ظلم به مسلما كمن اخذ مال مسلم بحرابة واطلع عليه انسان او غصبه امراته او سرق حرا وما اشبهه فهذا فرض علي كل مسلم ان يقوم به حتي يرد الظلامات الي اهلها فنظرنا في الحديث المذكور فوجدناه ندبا لا حتما وفضيلة لا فرضا فكان الظاهر منه ان للانسان ان يستر علي المسلم يراه علي حد بهذا الخبر ما لم يسءل عن تلك الشهادة نفسها فان سءل عنها ففرض عليه اقامتها وان لا يكتمها فان كتمها حينءذ فهو عاص لله تعالي وصح بهذا اتفاق الخبر مع الايات.
 وان اقامة الشهادة لله تعالي وتحريم  كتمانها وكون المرء ظالما بذلك فانما هو اذا دعي فقط لا اذا لم يدع كما قال تعالي: (ولا يابي الشهداء اذا ما دعوا) ثم نظرنا في الخبر المذكور عن رسول الله صلي الله عليه وسلم الذي حدثناه حمام نا عباس بن اصبغ نا محمد بن عبد الملك بن ايمن نا ابراهيم بن محمد نا يحيي بن يعمر نا ابن ابي بكر بن محمد بن عمرو بن حزم عن ابيه عن عبد الله بن عمرو بن عثمان عن ابي عمرة الانصاري  هو عبد الرحمن بن زيد بن خالد  " ان رسول الله صلي الله عليه وسلم قال: الا اخبركم بخير الشهداء الذي ياتي بالشهادة قبل ان يسالها او يخبر بشهادته قبل ان يسالها " * قال ابو محمد رحمه الله: فكان هذا عموما في كل شهادة في حد او غير حد ووجدنا قول الله تعالي: (يا ايها الذين امنوا كونوا قوامين بالقسط شهداء لله ولو علي انفسكم او الوالدين والاقربين) فسوي الله تعالي بين وجوب اداء المرء الشهادة علي
 نفسه وعلي والديه واقاربه والاباعد فوجب من هذه النصوص ان الشهادة لا حرج علي المرء في ترك اداءها ما لم يسالها حدا كان او غيره فاذا سالها ففرض عليه اداءها حدا او غيره، وان من كان لانسان عنده شهادة والمشهود له لا يدري بها ففرض عليه اعلامه بها لقول رسول الله صلي الله عليه وسلم: " لدين النصيحة قيل: لمن يا رسول الله؟ قال: لله ولكتابه ولاءمة المسلمين وعامتهم " فان ساله المشهود اداءها لزمه ذلك فرضا لما ذكرنا قبل من قول الله تعالي: (ولا يابي الشهداء اذا ما دعوا) وان لم يسءل لم يلزمه ان يءديها وبالله تعالي التوفيق * واما من كانت عنده شهادة علي انسان بزنا فقذف ذلك الزاني انسان فوقف القاذف علي ان يحد للمقذوف ففرض علي الشاهد علي المقذوف الزاني ان يءدي الشهادة ولا بد سءلها اولم يسءلها علم القاذف بذلك او لم يعلم وهو عاص لله تعالي ان لم يءدها حينءذ لقول الله تعالي: (وتعاونوا علي البر والتقوي ولا تعاونوا علي الاثم والعدوان) ولقول رسول الله صلي الله عليه وسلم: " المسلم اخو المسلم لا يظلمه ولا يسلمه " ولقوله عليه السلام: " انصر اخاك ظالما كان او مظلوما " فهذا اذا ادي الشهادة التي عنده بصحة ما قذف به معين علي اقامة حد بحق غير ظالم به معين علي البر والتقوي وان لم يءدها معين علي الاثم والعدوان وهو ظالم قد اسلمه للظلم اذ تركه يضرب بغير حق، فان ذكروا ما ناه يوسف ابن عبد الله وغيره قالوا: حدثنا محمد بن ا لجسور ثنا قاسم بن اصبغ نا مطرف بن قيس حدثنا يحيي بن بكير نا مالك بن انس عن يحيي بن سعيد الانصاري عن سعيد بن المسيب قال: ان رجلا من اسلم جاء الي ابي بكر الصديق فقال: ان الاخر زني فقال له ابو بكر: هل ذكرت ذلك لغيري؟ فقال: لا قال ابو بكر: فتب الي الله واستتر بستر الله فان الله يقبل التوبة عن  عباده فلم تقر نفسه حتي اتي عمر بن الخطاب فقال له كما قال لابي بكر فقال له عمر كما قال له ابو بكر فلم تقر نفسه حتي اتي رسول الله صلي الله عليه وسلم فقال: ان الاخر زني قال سعيد بن المسيب: فاعرض عنه رسول الله صلي الله عليه وسلم مرارا كل ذلك يعرض عنه حتي اذا اكثر عليه بعث الي
 اهله فقال: ايشتكي ابه جنة؟ فقالوا: لا فقال رسول الله صلي الله عليه وسلم: ابكر ام ثيب؟ فقالوا: بل ثيب فامر به رسول الله صلي الله عليه وسلم فرجم " قال سعيد: فقال رسول الله صلي الله عليه وسلم لرجل من اسلم يقال له هزال لو سترته برداءك لكان خيرا لك قال يحيي: فذكرت هذا الحديث في مجلس فيه يزيد بن نعيم بن هزال الاسلمي فقال يزيد: هزال جدي، وهذا الحديث حق، قال علي: فان هذا الحديث مرسل لم يسنده سعيد ولا يزيد بن نعيم ولا حجة في مرسل ولو انسند لما خرج منه الا ان الستر وترك الشهادة افضل فقط هذا علي اصول القاءلين بالقياس اذا سلم لهم، وبالله تعالي التوفيق *   مسالة  اختلاف الشهود في الحدود * قال ابو محمد: فلما اختلفوا في ذلك فنظرنا في ذلك فالذي نقول به ان كل ما تمت به الشهادة ووجب القضاء بها فان كل ما زاده الشهود علي ذلك فلا حكم له ولا يضر الشهادة اختلافهم كما لا يضرها سكوتهم عنه وان كل ما لا تتم الشهادة الا به فهذا هو الذي يفسدها اختلافهم فالشهادة اذا تمت من اربعة عدول بالزني علي انسان بامراة يعرفونها اجنبية لا يشكون في ذلك، ثم اختلفوا في المكان او في الزمان او في المزني بها فقال بعضهم: امس بامراة سوداء، وقال بعضهم: بامراة بيضاء اليوم فالشهادة تامة والحد واجب لان الزنا قد تم عليه ولا يحتاج في الشهادة الي ذكر مكان ولا زمان ولا الي ذكر التي زني بها فالسكوت عن ذكر ذلك وذكره سواء وكذلك في السرقة، ولو قال احدهما: امس وقال الاخر: عام اول او قال احدهما بمكة وقال الاخر ببغداد فالسرقة قد صحت وتمت الشهادة فيها ولا معني لذكر المكان ولا الزمان ولا الشء المسروق منه سواء اختلفا فيه او اتفقا فيه او سكتا عنه لانه لغو وحديث زاءد ليس من الشهادة في شء، وكذلك في شرب الخمر وفي القذف فالحد قد وجب ولا معني لذكر المكان والمقذوف في ذلك والمسكوت عنه وذكره والاتفاق عليه والاختلاف فيه سواء * قال ابو محمد رحمه الله: ومن ادعي الخلاف في ذلك فيلزمه ان يراعي اختلاف
 الشهود في لباس الزاني والسارق والشارب والقاذف فان قال احدهما: كان في راسه قلنسوة وقال الاخر: عمامة او قال احدهما: كان عليه ثوب اخضر، وقال الاخر: بل احمر، وقال احدهما: في غيم وقال الاخر: في صحو فهذا كله لا معني له، فان قال قاءل: ان الغرض  في مراعاة الاختلاف انما هو ان تكون الشهادة علي عمل واحد فقط واذا اختلفوا في المكان او الزمان او المقذوف او المزني بها او المسروق منه او الشء المسروق فلم يشهدوا علي عمل واحد قلنا: من اين وقع لكم ان تكون الشهادة في كل ذلك علي عمل واحد واي قران او سنة او اجماع اوجب ذلك؟ واي نظر اوجبه؟ وهذا ما لا سبيل الي وجوده بل الغرض اثبات الزنا المحرم والفذف المحرم والسرقة المحرمة والشرب المحرم والكفر المحرم فقط ولا مزيد، وبيان ذلك قول الله تعالي: (والذين يرمون المحصنات ثم لم ياتوا باربعة شهداء) الاية، فصح بهذه الاية ان الواجب انما هو اثبات الزنا فقط وهو الذي رماها به ولا معني لذكره التي رماها ولا سكوته عنه فليس عليه ان ياتي باكثر من اربعة شهداء علي ان الذي رماها به من الزنا حق ولا نبالي عملا واحدا كان او اربعة اعمال لان كل ذلك زنا، وكذلك ان شهد عليه بالقذف لمحصنة فقد ثبت عليه بالقران ثمانون جلدة ولم يحد الله تعالي ان يكون في الشهادة ذكر الزمان ولا ذكر المكان فالزيادة لهذا باطل بيقين لان الله تعالي لم يامر به ولا بمراعاته، وكذلك قال الله تعالي: (والسارق والسارقة فاقطعوا ايديهما) فحسبنا، وصحة الشهادة بانها سارقة او انه سارق، ولم نجد الله تعالي ذكر الزمان او المكان او المسروق منه او الشء المسروق فمراعاة ذلك باطل بيقين لا شك فيه، وهكذا قال رسول الله صلي الله عليه وسلم: " اذا شرب الخمر فاجلدوه " فاوجب الجلد بشرب الخمر فاذا صحت الشهادة بشرب الخمر فقد وجب الحد بنص امر رسول الله صلي الله عليه وسلم في ذلك ولا معني لمراعاة ذكر مكان او زمان او صفة الخمر اوصفة الاناء اذ لم يات نص بذلك عن الله تعالي ولا عن رسوله صلي الله عليه وسلم وسلم فمراعاة ذلك
 باطل بلا شك، والحمد لله رب العالمين * قال ابو محمد: وقد جاء نحو ذلك عن السلف كما حدثنا عبد بن ربيع حدثنا ابن مفرج حدثنا قاسم بن اصبغ حدثنا ابن وضاح حدثنا سحنون حدثنا ابن وهب انا السري بن يحيي قال: حدثنا الحسن البصري قال: شهد الجارود علي قدامة بن مظعون انه شرب الخمر  وكان عمر قد امر قدامة علي البحرين  فقال عمر للجارود: من يشهد معك؟ قال: علقمة الخصي فدعا علقمة فقال له عمر بم تشهد؟ فقال علقمة وهل تجوز شهادة الخصي قال عمر: وما يمنعه ان تجوز شهادته اذا كان مسلما قال علقمة: رايته يقء الخمر في طست قال عمر: فلا وربك ماقاءها حتي شربها فامر به فجلد الحد فهذا حكم عمر بحضرة الصحابة رضي الله عنهم لايعرف له منهم مخالف في اقامة  الحد بشهادتين مختلفتين احداهما انه راه يشرب الخمر والاخري انه لم يره يشربها لكن راه يتقيءها وعهدناهم يعظمون خلاف الصاحب اذا وافق تقليدهم وهم ههنا قد خالفوا عمر بن الخطاب.
 والجارود.
 وجميع من بحضرتهما من الصحابة فلا مءنة عليهم وحسبنا الله ونعم الوكيل *   مسالة  الاقرار بالحد بعد مدة وايهما افضل الاقرار ام الاستتار به؟ قال ابو محمد رحمه الله: اختلف الناس في ذلك فلما اختلفوا وجب ان ننظر فيما اختلفوا فيه لنعلم الحق من ذلك فنتبعه بعون الله تعالي فنظرنا فيما احتجب به الطاءفة المختارة للستر وان جميع الامة متفقون علي ان الستر مباح وان الاعتراف مباح انما اختلفوا في الافضل ولم يقل احد من اهل الاسلام ان المعترف بما عمل مما يوجب الحد عاص لله تعالي في اعترافه ولا قال احد من اهل الاسلام قط: ان الساتر علي نفسه ما اصاب من حد عاص لله تعالي فنظرنا في تلك الاخبار التي جاءت في ذلك فوجدناها كلها لا يصح منها شء الا خبرا واحدا في اخرها لا حجة لهم فيه علي ما نبين
 ان شاء الله تعالي، اما خبر هزال الذي صدرنا به من طريق شعبة عن محمد بن المنكدر عن ابن هزال عن ابيه فمرسل فلا حجة فيه لانه مرسل، وكذلك الذي من طريق ابن المبارك عن يحيي بن سعيد عن ابن المنكدر، ويزيد بن النعيم ايضا مرسل، وكذلك حديث مالك عن يحيي بن سعيد الانصاري مرسل ايضا، وحديث الليث عن يحيي ابن سعيد مرسل ايضا فبطل الاحتجاج برواية يحيي بن سعيد وبالله تعالي التوفيق * ثم نظرنا في هذا الخبر من طريق عكرمة بن عمار فوجدناه لا حجة فيه لوجهين، احدهما انه مرسل، والثاني ان عكرمة بن عمار ضعيف ثم نظرنا فيه من طريق حبان بن هلال عن ابان ابن يزيد عن يحيي بن ابي كثير عن ابي سلمة بن عبد الرحمن بن عوف عن يزيد بن نعيم بن هزال الانصاري عن عبد الله بن دينار فوجدناه ايضا مرسلا، ثم نظرنا فيه من طريق ابن جريج عن يحيي بن سعيد الانصاري عن عبد الله بن دينار فوجدناه ايضا مرسلا، ثم نظرنا فيه من رواية معمر عن ايوب السختياني عن حميد بن هلال فوجدناه ايضا مرسلا، ثم نظرنا فيه من رواية الحبلي عن ابي قلابة فوجدناه مرسلا * واما حديث حماد بن سلمة ففيه ابو المنذر لا يدري من هو، وابو امية المخزومي ولا يدري من هو وهو ايضا مرسل، وحتي لو صح هذا الخبر لما كان لهم فيه حجة لانه ليس فيه الا ما اخالك سرقت ورسول الله صلي الله عليه وسلم لا يقول الا الحق فلو صح ان رسول الله صلي الله عليه وسلم قال للذي سيق اليه بالسرقة ما اخالك سرقت لكنا علي يقين من انه عليه السلام قد صدق في  ذلك وانه علي الحقيقة يظن انه لم يسرق وليس في هذا تلقين له ولا دليل علي ان الستر افضل فبطل تعلقهم بهذا الخبر جملة * واما حديث مسلم في الاجهاد فلا حجة فيه لوجهين، احدهما انه من رواية محمد بن عبد الله بن اخي الزهري وهو ضعيف، والثاني انه لو صح لما كانت لهم فيه حجة اصلا لان الاجهاد المذكور انما هو ما ذكره المرء مفتخرا به لانه ليس في هذا الخبر انه يخبر به الامام معترفا ليقام عليه كتاب 
 الله تعالي وانما فيه ذم المجاهرة بالمعصية وهذا لا شك فيه حرام، ثم نظرنا في حديث مسلم الذي رواه ابن شهاب عن ابي سلمة.
 وسعيد بن المسيب عن ابي هريرة " ان رسول الله صلي الله عليه وسلم اعرض عن المعترف مرات " فوجدناه صحيحا لا داخلة فيه لاحد الا انه لا حجة لهم فيه لان الناس في سبب اعراض رسول الله صلي الله عليه واله عنه علي قولين فطاءفة قالت: انما اعرض عنه لان الاقرار بالزنا لا يتم الا بتمام اربع مرات، وطاءفة قالت: انما اعرض عنه عليه السلام لانه ظن ان به جنونا او شرب خمر ولم يقل احد من الامة ان الحاكم اذا ثبت عنده الاقرار بالحد جاز له ان يستره ولا يقيمه فبطل تعلقهم بهذا الخبر وسنستقصي الكلام في تصحيح احد هذين الوجهين بعد هذا ان شاء الله تعالي * قال ابو محمد: فلم يبق () لهذه الطاءفة خبر يتعلقون به اصلا، ثم نظرنا () فيما روي في ذلك عن الصحابة رضي الله عنهم فوجدناه ايضا لا يصح منه شء اما الرواية عن ابي بكر.
 وعمر رضي الله عنهما في قولهما للاسلمي: استتر بستر الله فلا تصح لانها عن سعيد بن السميب مرسلة، وكذلك حديث ابراهيم بن طهمان عن موسي بن عقبة عن عبد الله بن يزيد عن محمد بن عبد الرحمن ان ابا بكر فهو مرسل * قال ابو محمد: ثم نظرنا فيما احتجت به طاءفة الاخري فوجدنا الرواية عن الصحابة ان الطاءفة منهم قالت: ما توبة افضل من توبة ماعز جاء الي رسول الله صلي الله عليه وسلم فوضع يده في يده وقال: اقتلني بالحجارة، فصح هذا من قول طاءفة عظيمة من الصحابة رضي الله عنهم بل لو قلنا: انه لا مخالف لهذه الطاءفة من الصحابة رضي الله عنهم لصدقنا لان الطاءفة الاخري لم تخالفها وانما قالت: لقد هلك ماعز لقد احاطت به خطيءته فانما انكروا امر الخطيءة لا امر الاعتراف فوجدنا تفضيل الاعتراف لم يصح عن احد من الصحابة رضي الله عنهم خلافه * ثم نظرنا فيما احتجوا به من الاثار فوجدناها في غاية الصحة والبيان لان رسول الله صلي الله عليه وسلم حمد توبة ماعز  والغامدية وذكر عليه السلام ان توبة ماعز لو قسمت بين امة لوسعتهم.
 وان الغامدية لو تاب توبتها صاحب مكس لغفر له.
 وان الجهينية لو قسمت توبتها بين سبعين من اهل المدينة لوسعتهم، ثم رفع عليه السلام الاشكال جملة فقال: انها لم نجد افضل من ان جادت بنفسها لله فصح يقينا ان الاعتراف بالدنب ليقام عليه الحد افضل من الاستتار له بشهادة النبي صلي الله عليه وسلم انه لا افضل من جود المعترف بنفسه لله تعالي * قال ابو محمد رحمه الله: ومن البرهان علي ذلك ايضا ما رويناه من طريق مسلم نا يحيي ابن يحيي.
 وابو بكر بن ابي شيبة.
 وعمرو الناقد.
 واسحق بن ابراهيم  هو ابن راهويه  ومحمد ابن عبد الله بن نمير كلهم عن سفيان بن عيينة واللفظ لعمرو، قال سفيان بن عيينة عن الزهري عن ابي ادريس الخولاني عن عبادة بن الصامت قال: كنا مع رسول الله صلي الله عليه وسلم في مجلس فقال: بايعوني علي ان لا تشركوا بالله شيءا ولا تزنوا ولا تسرقوا ولا تقتلوا النفس التي حرم الله الا بالحق فمن وفي منكم فاجره علي الله ومن اصاب شيءا من ذلك فعوقب به فهو كفارة له ومن اصاب شيءا فستره الله عليه فامره الي الله.
 ان شاء عفي عنه وان شاء عذبه " قال علي رحمه الله: فارتفع الاشكال جملة والحمد لله رب العالمين وصح بنص كلام رسول الله صلي الله عليه وسلم واعلامه امته ونصيحته اياهم باحسن ما علمه ربه تعالي ان من اصاب حدا فستره الله عليه فان امره الي الله تعالي ان شاء عذبه وان شاء غفر له وان من اقيم عليه الحد فقد سقط عنه ذلك الذنب، وكفره الله تعالي عنه، وبالضرورة ندري ان يقين المغفرة افضل من التعزير في امكانها او عذاب الاخرة واين عذاب الدنيا كلها من غمسة في النار؟ نعوذ بالله منها فكيف من اكثر من ذلك * قال ابو محمد رحمه الله: فصح ان اعتراف المرء بذنبه عند الامام افضل من الستر بيقين وان الستر مباح بالاجماع، وبالله تعالي التوفيق *
   مسالة  تعافوا الحدود قبل بلوغها () الي الحاكم * قال ابو محمد رحمه الله: نا عبد الله بن ربيع نا عمر بن عبد الملك نا محمد بن بكر نا ابو داود نا سليمان بن داود المهري نا ابن وهب سمعت ابن جريج يحدث عن عمرو بن شعيب عن ابيه عن عبد الله ابن عمرو بن العاصي " ان رسول الله صلي الله عليه وسلم قال: تعافوا الحدود فيما بينكم فما بلغني من حد فقد وجب " نا حمام نا عباس بن اصبغ نا محمد بن عبد الملك بن ايمن نا محمد ابن وضاح نا سحنون نا ابن وهب قال: سمعت ابن جريج يحدث عن عمرو بن شعيب  عن ابيه عن عبد الله بن عمرو بن العاصي ان رسول الله صلي الله عليه وسلم قال: " تعافوا الحدود فيما بينكم فما بلغني من حد فقد وجب " * نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب اخبرني عبد الله بن احمد بن حنبل نا ابي نا محمد بن جعفر نا سعيد  هو ابن ابي عزوبة  عن قتادة عن عطاء بن ابي رباح عن طارق بن مرقع عن صفوان بن امية ان رجلا سرق بردة فرفعه الي النبي صلي الله تعالي عليه وسلم فامر بقطعه فقال: يا رسول الله قد تجاوزت عنه قال: " فلو لا كان هذا قبل ان تاتيني به يا ابا وهب  فقطعه رسول الله صلي الله عليه وسلم  " نا عبد الله بن ربيع نا محمد بن معاوية نا احمد ابن شعيب انا هلال بن العلاء الرقي نا حسين نا زهير نا عبد الملك  هو ابن ابي بشير  نا عكرمة عن صفوان بن امية انه طاف بالبيت فصلي ثم لف رداء له في برده فوضعه تحت راسه فنام فاتاه لص فاستله من تحت راسه فاخذه فاتي به النبي صلي الله عليه وسلم فقال ان هذا سرق رداءي فقال له النبي صلي الله عليه وسلم: " اسرقت رداء هذا؟ قال: نعم قال: ذهبا ب فاقطعا يده  قال صفوان: ما كنت اريد ان تقطع يده في رداءي قال: فلو ما كان هذا قبل " * نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب نا احمد بن عثمان بن حكيم نا عمرو عن اسباط عن سماك عن حميد بن اخت صفوان عن صفوان بن امية قال: كنت
 ناءما في المسجد علي خميصة لي ثمن ثلاثين درهما فجاء رجل فاختلسها مني فاخذ الرجل فاتي به النبي صلي الله عليه وسلم فامر به ليقطع فاتيته فقلت له: تقطعه من اجل ثلاثين درهما انا اضعه وانسءه ثمنها قال: فهلا كان هذا قبل ان تاتيني به " نا عبد الله بن ربيع نا ابن مفرج نا قاسم ابن اصبغ نا ابن وضاح نا سحنون نا ابن وهب عن عمرو بن الحارث ان عمرو بن دينار المكي حدثه انه قيل لصفوان بن امية لا دين لمن لم يهاجر فاقبل الي رسول الله صلي الله عليه وسلم فدخل عليه فقال: ما اقدمك قال قبل لي: انه لا دين لمن لم يهاجر قال: " فاقسمت عليك لترجعن الي اباطيح مكة ثم جء الي رسول الله صلي الله عليه وسلم برجل فقال: ان هذا سرق خميصتي فقال رسول الله صلي الله عليه وسلم: " اقطعوا يده  قال: عفوت عنه يا رسول الله فقال رسول الله صلي الله عليه وسلم: فهلا قبل ان تاتيني به " * نا يوسف بن عبد الله نا احمد بن محمد بن الجسور نا قاسم بن اصبغ نا مطرف بن قيس نا يحيي بن بكير نا مالك نابن شهاب عن صفوان بن عبد الله ابن صفوان بن امية ان صفوان بن امية قيل له: انه من لم يهاجر هلك فقدم صفوان ابن امية المدينة فنام في المسجد وتوسد رداءه فجاء سارق فاخذ رداءه فاخذ صفوان السارق فجاء به الي رسول الله صلي الله عليه وسلم، فامر به رسول الله صلي الله عليه وسلم ان تقطع يده فقال صفوان: اني لم ارده بهذا هو عليه صدقة فقال رسول الله صلي الله عليه وسلم: فهلا قبل ان تاتيني به "؟ *

 قال ابو محمد رحمه الله: وجاء فيه ايضا عن بعض السلف كما رويناه بالسند المدكور الي مالك عن ربيعة بن ابي عبد الرحمن ان الزبير بن العوام لقي رجلا قد اخذ سارقا وهو يريد ان يذهب به الي السلطان فشفع له الزبير ليرسله فقال: لا حتي ابلغ به الي السلطان فقال له الزبير: اذا بلغت به الي السلطان فلعن الله الشافع والمشفع * قال ابو محمد رحمه الله: فنظرنا في الاثار عن النبي صلي الله عليه وسلم فوجدناها لا يصح منها شء اصلا، اما الاول فعن عمرو بن شعيب عن ابيه عن عمرو وهي صحيفة، واما حديث صفوان فلا يصح فيه شء اصلا لانها كلها منقطعة لانها عن عطاء.
 وعكرمة.
 وعمرو بن دينار.
 وابن شهاب وليس منهم احد ادرك صفوان، واما عن عطاء عن طارق بن مرتفع () وهو مجهول، او عن اسباط عن سمك عن حميد بن اخت صفوان وهذا ضعيف عن ضعيف عن مجهول * قال علي: فاذ ليس في هذا الباب اثر يعتمد عليه فالمرجوع اليه هو طلب حكم هذه المسالة من غير هذه الاثار فنظرنا في ذلك فوجدنا قد صح بالبراهين التي قد اوردنا قبل ان الحد لا يجب الا بعد بلوغه الي الامام وصحته عنده فاذ الامر كذلك فالترك لطلب صاحبه قبل ذلك مباح لانه لم يجب عليه فيما فعل حد بعد ورفعه ايضا مباح اذ لم يمنع من ذلك نص او اجماع فاذ كلا الامرين مباح فالاحب الينا دون ان يفتي به ان يعفا عنه ما كان وهلة ومستورا فان اذي صاحبه وجاهر فرفعه احب الينا وبالله تعالي التوفيق *  مسالة هل تدرا الحدود بالشبهات ام لا؟ قال ابو محمد رحمه الله: ذهب قوم الي ان الحدود تدرا بالشبهات فاشدهم قولا بها واستعمالا لها ابو حنيفة واصحابه ثم المالكيون ثم الشافعيون، وذهب اصحابنا الي ان الحدود لا يحل ان تدرا بشبهة ولا ان تقام بشبهة وانما هو الحق لله تعالي ولا مزيد فان لم يثبت الحد لم يحل ان يقام بشبهة لقول رسول الله صلي الله عليه وسلم: " ان دماءكم واموالكم واعراضكم وابشاركم عليكم حرام " واذا ثبت الحد لم يحل ان يدرا بشبهة لقول الله تعالي: (تلك حدود الله فلا تعتدوها) * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر في اللفط الذي يتعلق به من تعلق ايصح ام لا؟ فنظرنا فيه فوجدناه قد جاء من طرق ليس فيها عن النبي صلي الله عليه وسلم نص ولا كلمة وانما هي عن بعض اصحاب () من طرق كلها لا خير فيها  كما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن سفيان الثوري عن ابراهيم النخعي ان عمر بن الخطاب قال: ادرءوا الحدود ما استطعتم * وبه الي سفيان الثوري عن القاسم بن عبد الرحمن قال قال ابن مسعود: اردءوا الحدود ما استطعتم، وعن ابي هريرة ادفعوا الحدود ما وجدتم مدفعا، وعن ابن عمر قال: ادفعوا الحدود بالشبهات * وعن عاءشة ادرءوا الحدود عن المسلمين ما استطعتم * وعن عمر بن الخطاب.
 وابن مسعود كانا يقولان: ادرءوا عن عباد الله الحدود فيما شبه عليكم * قال ابو محمد رحمه الله: وهي كلها لا شء، اما من طريق عبد الرزاق فمرسل، والذي من طريق عمر كذلك لانه عن ابراهيم عن عمر ولم يولد ابراهيم الا بعد موت عمر بنحو خمسة عشر عاما، والاخر الذي عن ابن مسعود مرسل لانه من طريق القاسم ابن عبد الرحمن بن عبد الله بن مسعود، واما احاديث ابن حبيب ففضيحة لو لم يكن فيها غيره لكفي فكلها مرسلة * قال ابو محمد رحمه الله: فحصل مما ذكرنا ان اللفظ الذي تعلقوا به لا نعلمه روي عن احد اصلا وهو ادرءوا الحدود بالشبهات لا عن صاحب ولا عن تابع الا الرواية الساقطة التي اوردنا من طريق ابراهيم بن الفضل عن عبد الله بن دينار عن ابن عمر.
 وابراهيم ساقط، وانما جاء كما تري عن بعض الصحابة مما لم يصح ادرءوا الحدود ما استطعتم وهذا لفظ ان استعمل ادي الي ابطال الحدود جملة علي كل حال، وهذا خلاف اجماع اهل الاسلام وخلاف الدين وخلاف القران والسنن لان كل احد هو مستطيع علي ان يدرا كل حد ياتيه فلا يقيمه فبطل ان يستعمل هذا اللفظ وسقط ان تكون فيه حجة لما ذكرنا، واما اللفظ الاخر في ذكر الشبهات فقد قلنا: ادرءوا لا نعرفه عن احد اصلا الا ما ذكرنا مما لا يجب ان يستعمل فقط لانه باطل لا اصل له، ثم لا سبيل لاحد الي استعماله لانه ليس فيه بيان ما هي تلك الشبهات فليس
 لاحد ان يقول في شء يريد ان يسقط به حدا هذا شبهة الا كان لغيره ان يقول: ليس بشبهة ولا كان لاحد ان يقول في شء لا يريد ان يسقط به حدا: ليس هذا شبهة الا كان لغيره ان يقول: بل هو شبهة، ومثل هذا لا يخل استعماله في دين الله تعالي انه لم يات به قران.
 ولا سنة صحيحة.
 ولا سقيمة.
 ولا قول صاحب.
 ولا قياس.
 ولا معقول مع الاختلاط الذي فيه كما ذكرنا وبالله تعالي التوفيق * قال ابو محمد رحمه الله: فان شغب مشغب بما رويناه من طريق البخاري  عن رسول الله صلي الله عليه وسلم: الحلال بين والحرام بين وبينهما امور مشتبهة فمن ترك ما اشتبه عليه من الاثم كان لما استبان اترك ومن اجترا علي ما يشك فيه من الاثم او شك ان يواقع ما استبان والمعاصي حمي الله من يرتع حول الحمي يوشك ان يواقعه، فان هذ صحيح وبه نقول وهو عليهم لا لهم لانه ليس فيه الا ترك المرء ما اشتبه عليه فلم يدر ما حكمه عند الله تعالي في الذي له تعبدنا به، وهذا فرض لا يحل لاحد مخالفته، وهكذا نقول ان من جهل احرام هذا الشء ام حلال؟ فالورع له ان يمسك عنه ومن جهل افرض هو ام غير فرض؟ فحكمه ان لا يوجبه ومن جهل اوجب الحد ام لم يجب؟ ففرضه ان لا يقيمه لان الاعراض والدماء حرام لقول رسول الله صلي الله عليه وسلم: " ان دماءكم واموالكم واعراضكم وابشاركم عليكم حرام "، واما اذا تبين وجوب الحد فلا يحل لاحد ان يسقطه لانه فرض من فراءض الله تعالي * قال ابو محمد رحمه الله: ما نعلم احدا اشد جسرا علي اقامة الحد بالشبهات وحيث لا تجب اقامتها منهم ثم يسقطونها حيث اوجبها الله تعالي ورسوله عليه السلام ونحن ذاكرون من ذلك طرفا كافيا ان شاء الله تعالي، فاول ذلك النفس التي عظم الله تعالي امرها وحرم قتلها الا بالحق، فاما المالكيون فقتلوا النفس المحرمة بدعوي من لعله يريد ان يشفي نفسه من عدوه مع ايمان رجلين من عشيرته وان كانا افسق البرية وهم لا يعطونه بدعواه نواة معفونة ولو حلفوا مع دعواه الف يمين وكانوا اصلح البرية،
 وهذا سفك الدم المحرم بالشبهة الفاسدة التي لا شبهة ابرد منها ويقتلون بشهادة اللوث غير العدل والقسامة ولا يعطون بشهادتهم فلسين ويقتلون الابي عن الصلاة ان اقر بها وانها فرض، ويقتلون الممسك اخر حتي قتل.
 ولا يحدون الممسك امراة حتي يزني بها، ويقتلون الساحر دون استتابة وانما هي حيل وكبيرة كالزنا، ولا يقتلون اكل الربا، وقول الله تعالي فيه اشد من قوله في الساحر.
 ويقتلون المستتر بالكفر ولا يدرءون عنه باعلانه التوبة ولا يقتلون المعلن بالكفر اذا اظهر التوبة ولا فرق، ويقتلون المسلم بالكافر اذا قتله غيلة ولا يجيزون في ذلك عفو الولي وهذا خلاف القران والسنة واقامة الحدود بالشبهة الفاسدة.
 ويجلدون الفاتل المعفو عنه ماءة جلدة وينفونه سنة، (واما الحنيفيون) فيقتلون المسلم بالكافر خلافا علي الله تعالي.
 وعلي رسوله عليه السلام ومحافظة لاهل الكفر، ولا يقتلون الكافر اذا سب النبي صلي الله عليه وسلم بحضرة اهل الاسلام في اسواقهم ومساجدهم ولا يقتلون من اهل الكفر من سب الله تعالي جهارا بحضرة المسلمين، وهذه امور نعوذ بالله منها، ويقتلون الذمي الذي قد حرم دمه الا بالحق بشهادة كافرين.
 واما الزنا فان المالكيين يحدون بالحبل ولعله من  اكراه، ويرجمون المحصن اذا وطء امراة اجنبية في دبرها او فعل فعل قوم لوط محصنا كان او غير محصن، ولا يحدون واطء البهيمة ولا المراة تحمل علي نفسها كلبا وكل ذلك اباحة فرج بالباطل، ولا يحدون التي تزني وهي عاقلة بالغة مختارة بصبي لم يبلغ، ويحدون الرجل اذا زني بصبية من سن ذلك الصبي، وان ابن القاسم لا يحد النصراني ولا اليهودي اذا زني بمسلمة ويطلقون الحربي النازل عندنا بتجارة والمتذمم يغرم الجزية علي تملك المسلمات اللواتي سباهن قبل تزوله وتذممه من حراءر المسلمات من القرشيات.
 والانصاريات وغيرهن وعلي وطءهن وبيعن صراحا مباحا، وهذه قولة ما سمع بافحش منها *
   مسالة  واما السرقة فان المالكيين يقطعون فيها الرجلين بلا نص ثابت ولا اجماع، ويقطعون من دخل منزل انسان فاخرج منه ما يساوي ثلاثة دراهم وقال: ان صاحب الدار ارسلني في هذه الحاجة وصدقه صاحب الدار، ولا يلتفتون الي شء من هذا او يقطعون يده مطارفة، ويقطعون جماعة سرقت ربع دينار فقط، وراوا في احد اقوالهم انه اذا غلط بالسارق فقطعت يساره انه تقطع اليد الاخري فقطعوا يديه جميعا في سرقة واحدة وما عين الله تعالي قط يمني من يسري، والحنيفيون يقطعون فيها الرجل بعد اليد بغير نص ولا اجماع.
 واما القذف فان المالكيين يحدون حد القذف في التعريض ويسقطون جميع الحدود بالقتل حاشي حد القذف، فان كانوا يسقطون ساءر الحدود بالشبهة فما بالهم لا يسقطون حد القذف ايضا بالشبهة، وقالوا: انما فعلنا ذلك خوف ان يقال للمقذوف: لو لم يكن الذي قذفك صادقا لحد لك ففي اي دين وجدوها من قران او سنة او قياس؟ ويحدون شارب الخمر ولو جرعة منه خوف ان يقذف احدا بالزنا وهو لم يقذف احدا بعد فاي عجب في اقامة الحدود بلا شبهة، ويتعلقون برواية ساقطة عن بعض الصحابة قد اعاذهم الله تعالي من مثلها، ويحدون من قال لاخر: لست ابن فلان اذا نفاه عن ابيه، ويحدن من قذف امراته بانسان سماه وان لاعن امراته وهذه خلاف لرسول الله صلي الله عليه وسلم مجرد، ويحدون من قذف انسانا نكح نكاحا فاسدا لا يحل مثله وهو عالم بالتحريم، هذا وهم يحدون من قذف امراة مسلمة ظهر بها حمل وهم يقرون انهم لا يحلفون ولا يقطعون انه من زنا ومنهم من يري الحد علي من قال لاخر: زنت عينك او زنت يدك وقد صح عن النبي صلي الله عليه وسلم " ان اليدين تزنيان وزناهما البطش والعينين تزنيان وزناهما النظر والفرج يصدق ذلك او يكذبه " واما الخمر فان المالكيين يقيمون الحد فيه بالنكهة، وكل من له معرفة يدري ان من اكل الكمثري الشتوي  وبعض انواع التفاح ان نكهة فمه ونكهة شارب الخمر سواء، وايضا فلعله ملا فمه منها
 ولم يجرعها فبقيت النكهة او لعله دلس عليه بها وهو لا يدري، ثم يجلدون هم والحنيفيون في الخمر ثمانين جلدة وجمهور الصحابة علي ان الحد فيها اربعون فلم يدرعوا الاربعين.
 الزاءدة بالشبهة ولم يوجبها قران ولا سنة ولا اجماع، ويحدون ثمانين كما قلنا بفرية لم يفترها بعد فيقدمون له الحدود ولعله لا يقذف احدا ابدا، ولا فرق بين هذا وبين ان يقدموا له حد زنا لم يكن منه، او حد سرقة لم يكن منه، ويحدون هم والشافعيون الفاضل العالم المتاول احلال النبيذ المسكر ويقبلون مع ذلك شهادته وياخذون العلم عنه ولا يحدون المتاول في الشغار والمنعة وان كان عالما بالتحريم.
 ولا في الخليطين وان كان حراما كالخمرة *   مسالة  اعتراف العبد بما يوجب الحد: قال ابو محمد رحمه الله: اختلف الناس في هذا فنظرنا في ذلك فوجدنا اصحابنا يقولون: قال الله تعالي: (ولا تكسب كل نفس الا عليها ولا تزر وازرة وزر اخري) والعبد مال من مال سيده فاعترافه بما يوجب ابطال بعض مال سيده كسب علي غيره فلا يجوز بنص القران * قال ابو محمد رحمه الله: وهذا احتجاج صحيح ان لم يات ما يدفعه فنظرنا فوجدنا الله تعالي يقول: (كونوا قوامين بالقسط شهداء لله ولو علي انفسكم او الوالدين والاقربين) فامر الله تعالي بقبول شهادة المرء علي نفسه وعلي والديه واقرباءه ولم يختلف الناس في ان شهادة المرء علي نفسه مقبولة دون اخر معه دون يمين تلزمه سواء كان فاسقا او عدلا مءمنا كان او كافرا وان شهادته علي غيره لا تقبل الا بشرط العدالة وبان يكون معه غيره او يمين الطالب علي حسب اختلاف الناس في ذلك ولم يخص الله تعالي عبدا من حر، فلما ورد هذان النصان من عند رب العالمين وجب ان ننظر في استعمالهما فوجدنا اصحابنا يقولون: هو شاهد علي نفسه كاسب علي غيره فلا يقبل، ووجدنا من خالفهم يقول: بل هو شاهد علي نفسه كاسب عليها وان ادي ذلك الي نقص في مال سيده ولم يقصد الشهادة علي مال سيده فنظرنا في هذين الاستعمالين اذ
 لابد من استعمال احدهما فوجدنا قول اصحابنا في انه كاسب علي غيره انما يصح بواسطة وبانتاج لا بنفس الاقرار ووجدنا قول من خالفهم يصح بنفس القصة لانه انما اقر علي نفسه بنفس لفظه وهو ظاهر مقصده وانما يتعدي ذلك الي السيد بتاويل لا بظاهر اقراره فكان هذا اصح الاستعمالين واولاهما ولو كان ما قالوه اصحابنا لوجب ان لا يحد العبد في زني ولا في سرقة.
 ولا في خمر.
 ولا في قذف.
 ولا في حرابة وان قامت بذلك  بينة وان لا يقتل في قود لانه في ذلك كاسب علي غيره وفي الحد عليه اتلاف لمال سيده وهذا ما لا يقولونه لا هم ولاغيرهم *   مسالة  من قال: لا يءاخد الله عبدا باول ذنب * قال ابو محمد رحمه الله: نا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب عن قرة بن عبد الرحمن المعافري عن ابن شهاب قال: اتي ابو بكر الصديق بسارق فقال: اقطعوا يده فقال: اقلنها يا خليفة رسول الله صلي الله عليه وسلم فوالله ما سرقت قبلها فقال له ابو بكر: كذبت والذي نفسي بيده ما غافص الله مءمنا باول ذنب يعمله * وبه الي ابن وهب عن سفيان الثوري عن حميد الطويل عن انس بن مالك قال: اتي عمر بن الخطاب بسارق فقال: والله ما سرقت قبلها فقال له عمر: كذبت ورب عمر ما اخذ الله عبدا عند اول ذنب * وبه الي ابن وهب عن عبد الله ابن سمعان بهذا وان علي بن ابي طالب قال له: الله احلم من ان ياخذ عبده في اول ذنب يا امير المءمنين فامر به عمر فقطع فلما قطع قام اليه علي بن ابي طالب فقال له: انشدك الله كم سرقت من مرة؟ قال له: احدي وعشرين مرة  [ غافصة فاجاه واخذه علي غرة ] * قال ابو محمد رحمه الله: يفعل الله ما يشاء وكل احكامه عدل وحق فقد يستر الله الكثير والقليل علي من يشاء اما املاء واما تفضلا ليتوب وياخذ بالذنب الواحد وبالذنوب عقوبة او كفارة له لا معقب لحكمه ولا يسءل عما يفعل وهم يسءلون،
 والاسنادان عن ابي بكر.
 وعلي ضعيفان احدهما مرسل والاخر مرسل ساقط والاسناد في ذلك عن عمر صحيح ولله الامر من قبل ومن بعد *   مسالة  هل تقام الحدود علي اهل الذمة؟ * قال ابو محمد رحمه الله: اختلف الناس في هذا الخبر فجاء عن علي بن ابي طالب لا حد علي اهل الذمة في الزنا وجاء عن ابن عباس لا حد علي اهل الذمة في السرقة، وقال ابو حنيفة: لا حد علي اهل الذمة في الزنا ولا في شرب الخمر وعليهم الحد في القذف وفي السرقة الا المعاهد في السرقة لكن يضمنها، وقال محمد بن الحسن صاحبه: لا امنع الذمي من الزنا وشرب الخمر وامنعه من الغناء، وقال مالك: لا حد علي اهل الذمة في زنا ولا في شرب خمر وعليهم الحد في القذف والسرقة، وقال الشافعي.
 وابو سليمان واصحابهما: عليهم الحد في كل ذلك * حدثنا حمام نا ابن مفرج نا عبد الاعلي بن محمد نا الدبري نا عبد الرزاق نا الثوري اخبرني سماك بن حرب عن قابوس بن المخلوق عن ابيه قال: كتب محمد بن ابي بكر الي علي بن ابي طالب يساله عن مسلمين تزندقا.
 وعن مسلم زني بنصرانية.
 وعن مكاتب مات وترك بقية من  كتابته وترك ولدا احرارا فكتب اليه علي اما اللذان تزندقا فان تابا والا فاضرب اعناقهما واما المسلم الذي زني بالنصرانية فاقم عليه الحد وارفع النصرانية الي اهل دينها واما المكاتب فاعط مواليه بقية كتابته واعط ولده الاحرار ما بقي من ماله نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج.
 وسفيان الثوري كلاهما عن عمرو بن دينار عن مجاهد ان ابن عباس كان لا يري علي عبد ولا علي اهل الذمة حدا، وعن ربيعة انه قال في اليهودي.
 والنصراني: لا اري عليهما في الزنا حدا قال: وقد كان من الوفاء لهم بالذمة ان يخلي بينهم وبين [ اهل ] دينهم وشراءعهم تكون ذنوبهم عليهم * قال ابوا محمد رحمه الله: فلما اختلفوا وحب ان ننظر في ذلك لنعلم الحق فنتبعه فنظرنا في قول من قال: لاحد علي ذمي فوجدناهم يقولون: قال الله تعالي: (فان جاءوك
 فاحكم بينهم او اعرض عنهم فان حكمت فاحكم بينهم بالقسط) ووجدناهم يقولون: قد عاهدناهم علي الترك لهم علي كفرهم وكان كفرهم يدخل فيه كل شريطة من احكامهم فوجب ان لا يعترض عليهم بخلاف ما عوهدوا عليه * قال ابو محمد رحمه الله: ما نعلم لهم حجة غير هذا فلما نظرنا في ذلك وجدناه لا حجة فيه للحنيفيين.
 والمالكيين اصلا لان الاية المذكورة عامة لا خاصة وهم قد خصوا فاوجبوا عليهم الحد في السرقة وفي القذف لمسلم وفي الحرابة واسقطوا الحد في الزنا وفي الخمر فقط وهذا تحكم لم يوجبه قران ولا سنة لا صحيحة ولا سقيمه ولا اجماع ولا قول صاحب، (فان قالوا): السرقة ظلم ولا يقرون علي ظلم مسلم ولا علي ظلم ذمي والقذف حكم بينهم وبين المسلم، واذا كان ذلك فلا خلاف في انه يحكم في ذلك بحكم الاسلام قلنا لهم: وكذلك الزنا اذا زنوا بامراة مسلم او بامته او بامراة ذمي او امته فانه ظلم للمسلم او سيدها وظلم للذمي كذلك ولا يقرون علي ظلم، وعلي كل حال فقد خصصتم الاية بلا دليل وتركتم ظاهرها بلا حجة، فان شغبوا بقول علي.
 وابن عباس رضي الله عنهما في ذلك قلنا لهم: لا حجة لكم في ذلك لان الرواية عن علي في ذلك لا تصح لانها عن سماك بن حرب وهو ضعيف يقبل التلقين ثم عن قابوس بن المخارق وهو مجهول، ثم لو صح لما كانت لهم فيه حجة لانه لا حجة في قول احد دون رسول الله صلي الله عليه وسلم.
 واما الرواية عن ابن عباس فابعد لانه لا حجة في احد دون رسول الله صلي الله عليه وسلم وانهم قد خالفوا ابن عباس في هذه القضية لان فيها لا حد علي عبد وهم لا يرون هذا ولا حد علي ذمي وهم يرون الحد عليه في القذف والسرقة * قال ابو محمد رحمه الله: فاذ قد تعارضت الروايتان عن مجاهد عن ابن عباس  فقد بطل التعلق باحداهما دون الاخري ووجب ردهما الي كتاب الله تعالي فلاي القولين شهد القران والسنة فهو الحق، وعلي كل حال فقد بطل كل قول شغب به الحنيفيون.
 والمالكيون ولم يبق لهم حجة اصلا.
 اما الاية فانها منسوخة ولو صح انها محكمة لما
 كان لمن اسقط بها اقامة الحدود عليهم متعلق لانه انما فيها التخيير في الحكم بينهم لا في الحكم عليهم جملة واقامة الحدود حكم عليهم لا حكم بينهم فليس للحدود في هذه الاية مدخل اصلا بوجه من الوجوه فسقط التعلق بها جملة.
 واما عهود من عاهدهم علي الحكم باحكامهم فليس ذلك عهد الله تعالي بل هو عهد ابليس.
 وعهد الباطل.
 وعهد الضلال ولا يعرف المسلمون عقودا ولا عهودا الا ما امر الله تعالي به في القران والسنة فهي التي امر الله تعالي بالوفاء بها كما قال رسول الله صلي الله عليه وسلم.
 " كل شرط ليس في كتاب الله تعالي فهو باطل " وقال عليه السلام: " من عمل عملا ليس عليه امرنا فهو رد " وان قالوا: قال الله تعالي: (لااكراه في الدين) قلنا: نعم ما نكرههم علي الاسلام ولا علي الصلوة ولا علي الزكاة ولا علي الصيام ولا الحج لكن متي كان لهم حكم حكمنا فيه بحكم الاسلام لقول الله تعالي: (وان احكم بينهم بما انزل الله ولا تتبع اهواءهم واحذرهم ان يفتنوك عن بعض ما انزل الله اليك) وقال تعالي: (افحكم الجاهلية يبغون ومن احسن من الله حكما لقوم يوقنون)؟ فافترض الله تعالي علي لسان رسوله عليه السلام ان لا نتبع اهواءهم فمن تركهم واحكامهم فقد اتبع اهواءهم وخالف امر الله تعالي في القران *   مسالة  حد المماليك * قال ابو محمد رحمه الله: الحدود كلها اربعة اقسام لا خامس لها، اما اماتة بصلب.
 او بقتل بسيف.
 او برجم بالحجارة وما جري مجراها.
 واما نفي واما قطع واما جلد، وجاء النص واجماع الامة كلها علي ان حد المملوكة الانثي في بعض وجوه الجلد وهو الزنا مع الاحصان خاصة نصف حد الحر والحرة في ذلك واتفقوا كلهم مع النص ان حد المماليك في القتل والصلب كحد الاحرار وجاء النص ايضا في النفي الذي ليس له امد سواه، واختلفوا فيما عدا ذلك علي ما نذكره ان شاء الله تعالي، فذهبت طاءفة الي ان حد الاماء والعبيد فيما عدا ما ذكرنا ولا نحاش شيءا كحد الاحرار سواء سواء، وهو قول اصحابنا، وقالت طاءفة: حد العبيد والاماء في الجلد كله علي النصف من حد الاحرار والحراءر وحد العبيد والاماء في
 القطع كحد الاحرار والحراءر، فاختلف هءلاء فطاءفة تقول به في الاحرار ولا تقول به في العبيد والنساء والاماء والحراءر فالذين يقولون بالنفي المءقت جملة اختلفوا فطاءفة جعلت حد الاماء والعبيد فيه نصف حد الحر والحرة وهو قول الشافعي.
 واصحابه  وطاءفة جعلت فيه حد الاماء خاصة علي النصف من حد الحراءر وجعلت فيه حد العبيد كحد الاحرار وهو قول ابي سليمان.
 واصحابنا، اما الطاءفة التي لا تقول بالنفي المءقت فهم ابو حنيفة.
 واصحابه، واما الطاءفة التي قالت به في الاحرار خاصة ولم يقولوا به في العبيد ولا في الاماء ولا في الحراءر فهم مالك واصحابه * وقالت طاءفة حد العبيد والاماء في جلد الزنا علي نصف حد الاحرار والحراءر وحد العبيد والاماء في القذف كحد الحر والحرة وهو قول روي عن عمر بن عبد العزيز وغيره * قال ابو محمد رحمه الله: والذي نقول به ان حد المماليك ذكورهم واناثهم في الجلد والنفي المءقت والقطع علي النصف من حد الحر والحرة وهو كل ما يمكن ان يكون له نصف واما ما لا يمكن ان يكون له نصف من القتل بالسيف او الصلب او النفي الذي لا وقت له فالمماليك والاحرار فيه سواء * قال ابو محمد رحمه الله: فاما اقوال من ذكرنا فالتناقض فيها ظاهر لا خفاء به وما نعلم لهم شبهة اصلا وسنذكر اقوالهم ان شاء الله تعالي الا ان يقول قاءل: ان القطع لا يمكن تنصيفه فهو خطا من قبل الاثار ومن قبل الحس والمشاهدة، فاما من قبل الحس والمشاهدة فان اليد معروفة المقدار فقطع نصفها ممكن ظاهر بالعيان وهو قطع الانامل فقط ويبقي الكف وقد وجدناهم يوقعون علي الانامل خاصة حكم اليد فلا يختلفون فيمن قطعت انامله كلها ان له دية يد فمن قطع الانامل خاصة فقد وافق النص لانه قطع ما يقع عليه اسم يد كما امره الله تعالي وقطع نصف ما يقطع من الحر كما جاء النص ايضا علي ما نذكره، وكذلك الرجل ايضا لها مقدار معروف فقطع نصفها ممكن وهو قطعها من
 وسطها مع الساق فقط، واما من طريق الاثار فحدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن قتادة ان علي بن ابي طالب كان يقطع اليد من الاصابع والرجل من نصف القدم، وبه الي عبد الرزاق عن سفيان الثوري عن ابي المقدام قال: اخبرني من راي علي بن ابي طالب يقطع يد رجل من المفصل، وبه الي عبد الرزاق عن ابن جريج عن عمرو بن دينار قال: كان عمر بن الخطاب يقطع القدم من مفصلها، وكان علي يقطع القدم قال ابن جريج: اشار لي عمرو الي شطرها * قال ابو محمد رحمه الله: فاذ قد جاء النص عن علي رضي الله عنه قطع اليد من المفصل وقطعها من الاصابع فالواجب حمل ذلك علي خلاف التناقض الذي لا وجه له لكن علي ان ذلك في حالين مختلفين، وهكذا القول في القدم ايضا * قال ابو محمد رحمه الله: والقوم اصحاب قياس بزعمهم، وقد صح النص  والاجماع علي ان حد الامة المحصنة في الزني نصف حد الحرة المحصنة، وصح النص والاجماع ان حد العبد في القتل بالسيف والصلب كحد الحر وكذلك في النفي غير المءقت فكان يلزمهم علي اصولهم التي ينتمون اليها في القول بالقياس علي ان يجعلوا ما اختلف فيه من القطع مردودا الي اشبه الجنسين به فهذه عمدتهم التي اتفقوا عليها في القياس فاذا فعلوا هذا وجب ان يكون القطع مقيسا علي الجلد لا علي القتل ولا علي النفي غير المءقت وذلك ان القتل لا يتنصف وكذلك النفي غير المءقت، واما الجلد فيتنصف والقطع يتنصف فكان قياس ما يتنصف علي ما يتنصف اولي من قياس ما يتنصف علي ما لا يتنصف هذا اصح قياس لو صح شء من القياس يوما ما * قال ابو محمد رحمه الله: فنظرنا في ذلك ليلوح الحق من ذلك فنتبعه فوجدناهم يقولون قال الله تعالي في الاماء: (فاذا احصن فان اتين بفاحشة.
 فعليهن نصف ما علي المحصنات من العذاب) فكان هذا من الله تعالي لا يحل خلافه، وقال تعالي: (الزانية
 والزاني فاجلدوا كل واحد منهما ماءة جلدة) ولم يخص الله تعالي من ذلك الا الاماء فقط وما كان ربك نسيا، وابقي العبيد فلم يخص كما خص الاماء، ومن الباطل ان يريد الله تعالي ان يخص العبيد مع الاماء فيقتصر علي ذكر الاماء ويمسك عن ذكر العبيد ويكلفنا من ذلك علم الغيب ومعرفة ما عنده مما لم يعرفنا به حاشي لله تعالي من هذا وكذلك قال الله عزوجل: (والذين يرمون المحصنات ثم لم ياتوا باربعة شهداء فاجلدوهم ثمانين جلدة) فلم يخص تعالي ههنا امة من حرة ولا عبدا من حر ومن الباطل ان يريد الله تعالي ان لا تجلد العبيد والاماء في القذف ثمانين جلدة ويكون اقل من ذلك ثم يامرنا بجلد من قذف ثمانين جلدة ولا يبين ذلك لنا افي حر دون عبد وفي حرة دون امة وهذا خلاف قوله تعالي: (ما فرطنا في الكتاب من شء) وقوله تعالي: (تبيانا لكل شء) وقد قال الله تعالي: (تلك حدود الله فلا تعتدوها) فكان حد القذف من حدود الله تعالي وحد الزنا من حدود الله تعالي فلا يحل ان يتعدي ما حد الله تعالي منها وحد الله تعالي في القذف ثمانين وفي الزنا ماءة فلا يحل لاحد ان يتعدي ما حد الله تعالي في احدهما الي ما حد الله تعالي في الاخر، فوضح بلا شك ان من حمل احدهما علي الاخر في عبد او امة او حر او حرة فقد تعدي حدود الله وسوي ما خالف الله تعالي بينهما، وقال الله تعالي: (والسارق والسارقة فاقطعوا ايديهما) فقلتم: ان الحر والعبد والامة سواء فاين زهق عنكم قياسكم الذي خالفتم به القران في حد العبد القاذف والامة القاذفة؟ ومن اين وجب ان تستسهلوا مخالفة قول الله تعالي: (فاجلدوهم ثمانين جلدة) قياسا  علي قوله تعالي: (فاذا احصن فان اتين بفاحشة فعليهن نصف ما علي المحصنات من العذاب) وعظم عندكم ان تخالفوا قوله: (فاقطعوا ايديهما) قياسا علي قوله: (فاذا احصن فان اتين بفاحشة فعليهن نصف ما علي المحصنات من العذاب) ان هذا لعجب جدا.
 قال اصحابنا: ووجدنا الله تعالي يقول: (والسارق والسارقة فاقطعوا ايديهما جزاء بما
 كسبا)، فكان من المحال ان يريد الله تعالي ان يكون حكم العبد والامة في ذلك بخلاف حكم الحر والحرة ثم لا يبينه هذا امر قد تيقنا ان الله تعالي لا يكلفنا اياه ولا يريده منا قالوا: وجدنا رسول الله صلي الله عليه وسلم قال: " اذا شرب فاجلدوه " وجلد في الخمر حدا مءقتا ولم يخص عليه السلام بذلك الحكم حرا من عبد ولا حرة من امة وهو المبين عن الله تعالي * قال ابو محمد رحمه الله: كل ما ذكره اصحابنا فهو حق صحيح ان لم تات سنة ثابتة تبين صحة ما ذهبنا اليه، واما ان جاءت سنة صحيحة توجب ما قلنا فالواجب الوقوف عند ما جاءت به السنة عن رسول الله صلي الله عليه وسلم المبين لنا مراد ربنا تعالي فنظرنا في ذلك فوجدنا ما ثناه عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب اخبرني محمد بن اسماعيل ابن ابراهيم بن علية نا يزيد بن هرون انا حماد بن سلمة عن ايوب السختياني عن عكرمة عن ابن عباس عن النبي صلي الله عليه وسلم قال: " اذا اصاب المكاتب حدا او ميراثا ورث بحساب ما عتق منه واقيم عليه الحد بحساب ما عتق منه " * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن عيسي الدمشقي نا يزيد بن هرون انا حماد بن سلمة عن قتادة وايوب السختياني قال قتادة عن خلاس بن عمرو عن علي بن ابي طالب، وقال ايوب عن عكرمة عن ابن عباس، ثم اتفق علي.
 وابن عباس كلاهما عن النبي صلي الله عليه وسلم قال: " المكاتب يعتق منه بقدر ما ادي ويقام عليه الحد بقدر ما عتق منه ويرث بقدر ما عتق منه " * قال ابو محمد رحمه الله: هذا اسناد عجيب كان عليه من شمس الضحي نورا ما ندري احدا غمزه بشء الا ان بعضهم ادعي ان وهيبا ارسله * قال ابو محمد رحمه الله: فكان ماذا اذا ارسله وهيب؟ قد اسند حكم المكاتب فيما ذكرنا وفي ديته حماد بن سلمة.
 وحماد بن زيد عن ايوب واسنده علي بن المبارك ويحيي بن ابي كثير عن عكرمة عن ابن عباس صلي الله عليه وسلم، وايضا فان الحنيفيين والمالكيين متفقون علي ان المرسل كالمسند ولا فرق، فعلي قولهم ما زاده ارسال وهيب بن خالد
 الاقرة فاذ قد صح وثبت فقد وجب ضرورة بنص حكم رسول الله صلي الله عليه وسلم ان حدود المماليك جملة عموما لذكورهم واناثهم مخالفة لحكم حدود الاحرار عموما لذكورهم  واناثهم واذ ذلك كذلك فلا قول لاحد من الامة الي ان حد المماليك علي النصف من حدود الاحرار فكان هذا واجبا القول به وبهذا نقول، وبالله تعالي التوفيق *  مسالة هل يقيم السيد الحدود علي مماليكه ام لا؟ * قال ابو محمد رحمه الله: اختلف الناس في هذا فقالت طاءفة: يقيم السيد جميع الحدود من القتل فما دونه علي مماليكه، وقالت طاءفة: يحد السيد مماليكه في الزنا والخمر والقذف ولا يحده في قطع قالوا: وانما يحده اذا شهد عليه بذلك الشهود، وقالت طاءفة: لا يحد السيد مملوكه في شء من الاشياء وانما الحدود الي السلطان فقط.
 فالقول الاول كما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن ايوب السختياني عن نافع ان ابن عمر قطع يد غلام له سرق وجلد عبدا له زني من غير ان يرفعهما * وبه الي عبد الرزاق عن عبيد الله بن عمر عن نافع عن ابن عمر قال: ان جارية لحفصة سحرتها واعترفت بذلك فاخبرت بها عبد الرحمن بن زيد بن الخطاب فقتلها فانكر ذلك عليها عثمان بن عفان فقال له ابن عمر: ما تنكر علي ام المءمنين امراة سحرت فاعترفت فسكت عثمان * وبه الي عبد الرزاق عن عبيد الله بن عمر بن حفص بن عاصم عن نافع قال: ابق غلام لابن عمر فمر علي غلمة لعاءشة ام المءمنين فسرق منهم جرابا فيه تمر وركب حمارا لهم فاتي به ابن عمر فبعث به الي سعيد بن العاص  وهو امير علي المدينة  فقال سعيد: لا يقطع غلام ابق فارسلت اليه عاءشة انما غلمتي غلمتك وانما جاع وركب الحمار ليبلغ عليه فلا تقطعه قال: فقطعه ابن عمر، وعن ابراهيم النخعي ان النعمان بن مقرن قال: لابن مسعود امتي زنت قال: اجلدها قال: انها لم تحصن قال: احصانها اسلامها * قال شعبة: نا الاعمش عن ابراهيم بهذا وفيه جلدها خمسين، وعن عبد الله بن مسعود وغيره قالوا: ان الرجل يجلد مملوكته
 الحدود في بيته، وان النعمان بن مقرن سال عبد الله ابن مسعود قال: امتي زنت قال: اجلدها خمسين قال: انها لم تحصن قال ابن مسعود: احصانها اسلامها، وعن ابن وهب نا ابن جريج ان عمرو بن دينار اخبره ان فاطمة بنت رسول الله صلي الله عليه وسلم كانت تجلد وليدتها خمسين اذا زنت، وعن انس بن مالك انه كان يجلد ولاءده خمسين اذا زنين * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق نا ابن جريج نا عمرو بن دينار ان الحسن بن محمد بن الحنفية اخبره ان فاطمة بنت محمد صلي الله عليه وسلم جلدت امة لها الحد زنت، وعن ابراهيم النخعي قال: كان علقمة.
 والاسود يقيمان الحد علي جواري قومهما * قال ابو محمد رحمه الله: وقد روي عن بعض من ذكرنا وغيرهم جواز عفو  السيد عن مماليكه في الحدود كما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن رجل عن سلام بن مسكين اخبرني عن حبيب بن ابي فضالة ان صالح بن كريز حدثه انه جاء بجارية له زنت الي الحكم بن ايوب قال: فبينا انا جالس اذ جاء انس بن مالك فجلس فقال: يا صالح ما هذه الجارية معك؟ قلت: جاريتنا بغت فاردت ان ارفعها الي الامام ليقيم عليها الحد قال: لا تفعل رد جاريتك واتق الله واستر عليها قلت؟ ما انا بفاعل حتي ارفعها قال له انس: لا تفعل واطعني قال صالح: فلم يزل يراجعني حتي قلت له اردها علي ان ما كان علي من ذنب فانت له ضامن فقال انس: نعم قال: فرددتها * وعن ابراهيم النخعي في الامة تزني قال: تجلد خمسين فان عفا عنها سيدها فهو احب الينا قال عبد الرزاق وبه ناخذ * قال ابو محمد رحمه الله: وهذان اثران ساقطان لانهما عمن لم يسم، واما من فرق بين ذات الزوج وغير ذات الزوج فكما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن الزهري عن سالم بن عبد الله بن عمر عن ابيه قال: في الامة
 اذا كانت ليست بذات زوج فظهر () منها فاحشة جلدت نصف ما علي المحصنات من العذاب يجلدها سيدها فان كانت من ذوات الازواج رفع امرها الي الامام، وعن ربيعة انه قال: احصان المملوكة ان تكون ذات زوج فيذكر منها فاحشة فلا يصدق عليها سيدهاء والزوج يذب.
 عن ولده وعن رحمها وعن ما بيده فليس يقيم الفاحشة عليها الا بشهادة اربعة ولا يقيم الحد عليها اذا ثبت الا السلطان قال الله تعالي: (فاذا احصن فان اتين بفاحشة فعليهن نصف ما علي المحصنات من العذاب) واما من فرق بين الجلد في الزني.
 والخمر.
 والقذف وبين القطع في السرقة فهو قول مالك، والليث: وما نعلمه عن احد قبلهما * قال ابو محمد رحمه الله: فلما اختلفوا نظرنا في ذلك لنعلم الحق فنتبعه بمن الله تعالي فوجدنا ابا حنيفة.
 واصحابه يحتجون بما ناه عبد الله بن ربيع نا عبد الله بن عثمان نا احمد ابن خالد نا علي بن عبد العزيز نا الحجاج بن المنهال نا حماد بن سلمة عن يحيي البكاء عن مسلم بن يسار عن ابي عبد الله رجل من اصحاب رسول الله صلي الله عليه وسلم قال: كان ابن عمر يامرنا ان ناخذ عنه قال.
 هو عالم فخذوا عنه فسمعته يقول: الزكاة والحدود والفء والجمعة الي السلطان.
 وعن الحسن البصري انه ضمن هءلاء اربعا، الجمعة والصدقة.
 والحدود.
 والحكم، وعن ابن محيريز انه قال: الحدود.
 والفء والزكاة.
 والجمعة الي السلطان *

 قال ابو محمد رحمه الله: ما نعلم لهم شبهة غير هذا وكل هذا لا حجة لهم فيه لانه ليس في شء مما ذكروا ان لا يقيم الحدود علي المماليك ساداتهم وانما فيه ذكر الحدود عموما الي السلطان، وهكذا نقول لكن يخص من ذلك حدود المماليك الي ساداتهم بدليل ان وجد، ثم ايضا لو كان فيما ذكروه لما كانت فيه حجة لانه لا حجة في قول احد دون رسول الله صلي الله عليه وسلم *
 قال ابو محمد رحمه الله: واما قول مالك.
 والليث في التفريق بين الجلد والقطع والقتل فلا نعلم لهم ايضا حجة اصلا، ولا ندري لهم في هذا التفريق سلفا من صاحب.
 ولا تابع، ولا متعلقا من قران.
 ولا من سنة صحيحة، ولا سقيمة، ولعل بعضهم ان يقول: ان السيد له جلد عبيده واماءه ادبا وليس له قطع ايديهم ادبا، فلما كان الحد في الزنا والخمر والقذف جلدا كان ذلك للسادات لانه حد وجلد * قال ابو محمد رحمه الله: فهذا القول في غاية الفساد لقول رسول الله صلي الله عليه وسلم: " انما الاعمال بالنيات ولكل امرء ما نوي " فجلد الادب هو غير جلد الحد بلا شك، وبالله تعالي التوفيق * ثم نظرنا في قول ربيعة فوجدناه قولا لا تءيده حجة لا من قران ولا من سنة صحيحة، اما قول ربيعة فان للزوج ان ينوب عنها فحجة زاءفة جدا وما جعل الله تعالي للزوج اعتراضا ولا ذبا فيما جاءت السنة باقامته عليها * واما من راي السيد يقيم جميع الحدود علي مماليكه فنظرنا فيه فوجدنا ما نا عبد الله بن يوسف نا احمد بن فتح نا عبد الوهاب بن عيسي نا احمد بن محمد نا احمد بن علي نا مسلم بن الحجاج نا عيسي بن حماد المصري نا الليث بن سعد عن سعيد بن ابي سعيد المقبري عن ابي هريرة قال: سمعت رسول الله صلي الله عليه وسلم يقول: " اذا زنت امة احدكم فتبين زناها فليجلدها الحد ولا يثرب عليها ثم ان زنت فليجلدها الحد ولا يثرب عليها ثم ان زنت الثالثة فليبعها ولو بحبل من شعر " * وعن مسلم ايضا نا القعنبي نا مالك عن ابن شهاب عن عبيدالله بن عتبة عن ابي هريرة ان رسول الله صلي الله عليه وسلم سءل عن الامة اذا زنت ولم تحصن؟ قال: " ان زنت فاجلدوها ثم ان زنت فاجلدوها ثم ان زنت فاجلدوها ثم بيعوها ولو بضفير " قال ابن شهاب: والضفير الحبل، قال ابن شهاب: لا ادري ابعد الثالثة او الرابعة، والاخبار فيما ذكرنا كثيرة جدا * قال ابو محمد رحمه الله: ثم نتكلم بعون الله تعالي فيما ذكرنا في الاخبار
 المذكورة من بيع الامة التي تزني فنقول: ان الليث روي هذا الحديث عن سعيد  ابن ابي سعيد المقبري عن ابيه عن ابي هريرة ان زنت الثالثة فليبعها ولو بحبل من شعر، وهكذا رواه عبد الرزاق عن عبيدالله بن عمر عن سعيد بن ابي سعيد انه سمع ابا هريرة، وهكذا ايضا رواه خالد بن الحارث عن ابن عجلان عن سعيد المقبري عن ابي هريرة فلم يذكروا زناها المرة الثالثة جلدا بل ذكروا البيع فقط، وعن ابي صالح عن ابي هريرة ان يقام الحد عليها ثلاث مرات ثم تباع بعد الثالثة مع الجلد، وهكذا رواه سفيان بن عيينة قال علي: فوجب ان يلغي الشك ويستقر البيع بعد الثالثة مع الجلد، والطرق كلها في ذلك في غاية الصحة، وكل ما صح عن النبي صلي الله عليه وسلم فهو عن الله تعالي قال الله تعالي: (وما ينطق عن الهوي ان هو الا وحي يوحي) فاذ ذلك كذلك فامره صلي الله عليه وسلم بالبيع في الثالثة ندب * برهان ذلك امره بالبيع في الرابعة لا يمكن البتة الا هذا لانه لو كان امره صلي الله عليه وسلم في الثالثة فرضا لما اباح حبسها الي الرابعة * واما البيع في الرابعة ففرض لابد منه لان اوامره صلي الله عليه وسلم علي الفرض لقول الله تعالي: (فليحذر الذين يخالفون عن امره) الاية * قال ابو محمد رحمه الله: ويجبره السلطان علي بيعها احب ام كره بما ينتهي اليه العطاء فيها ولا يتاتي بها طلب زيادة ولا سوق كما امر رسول الله صلي الله عليه وسلم ان تباع ولو بحبل من شعر او ضفير من شعر اذا لم يوجد فيها الا ذلك، فان زنت في خلال تعريضها للبيع او قبل ان تعرض حدها ايضا لعموم امره صلي الله عليه وسلم بجلدها ان زنت وكذلك ان غاب السيد او مات فلا بد من بيعها علي الورثة ضرورة، فان كانت لصغار جلدها الولي او الكافل لقول رسول الله صلي الله عليه وسلم في رواية مالك عن الزهري فاجلدوها فهو عموم لكل من قام به، ولا يلزم البيع في العبد اذا زني لان رسول الله صلي الله عليه وسلم انما امر بذلك في الامة اذا زنت وما ينطق عن الهوي ان هو الا وحي يوحي، ومن يتعد
 حدود الله فقد ظلم نفسه، وكذلك ان سرقت الامة او شربت الخمر فانها تحد ولا يلزم بيعها لان النص انما جاء في زناها فقط وما كان ربك نسيا * قال ابو محمد رحمه الله: فلو اعتقها السيد اذا تبين زناها لم ينفذ عتقه بل هو مردود لانه مامور ببيعها واخراجها عن ملكه فهو في عتقه اياها، او كتابته لها، او هبته اياها، او الصدقة بها، او اصداقها، او اجارتها، او تسليمها في شء بصفة غير البيع مما شاء نقدا او الي اجل بدنانير او بدراهم مخالف لامر رسول الله صلي الله عليه وسلم وقد قال عليه السلام: " من عمل عملا ليس عليه امرنا فهو رد " وكذلك لو دبرها فمات او اوصي بها فكل ذلك باطل ولابد من بيعها *

 قال ابو محمد رحمه الله.
 ولا يجوز ان يقيم الحد السيد علي مماليكه الا بالبينة او باقرار المماليك او صحة علمه ويقينه علي نص قوله صلي الله عليه وسلم: " فتبين زناها " ولا يطلق علي اقامة الحدود علي المماليك الا اهل العدالة فقط من المسلمين *  مسالة اي الاعضاء تضرب في الحدود؟ * قال ابو محمد رحمه الله: اختلف الناس في هذا وقال الله تعالي: (فان تنازعتم في شء فردوه الي الله والرسول) الاية ففعلنا فوجدنا الله تعالي يقول: (الزانية والزاني فاجلدوا كل واحد منهما ماءة جلدة) وقال عليه السلام: " اذا شرب فاجلدوه " وقال عليه السلام: " وعلي ابنك جلد ماءة وتغريب عام والبكر بالبكر جلد ماءة وتغريب عام " وسنذكر كل ذلك ان شاء الله تعالي فلم نجد عن الله تعالي ولا عن رسوله صلي الله عليه وسلم امرا بان يخص عضوا بالضرب دون عضو الا حد القذف وحده فان رسول الله صلي الله عليه وسلم قال فيه: " البينة والا حد في ظهرك " * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا عمران بن يزيد المدمشقي نا مخلد بن الحسين الاسدي نا هشام بن حسان عن محمد بن سيرين عن انس بن مالك قال: ان اول لعان كان في الاسلام ان هلال بن امية قذف شريك
 ابن سحماء بامراته فاتي النبي صلي الله عليه وسلم فاخبره بذلك فقال له النبي صلي الله عليه وسلم " البينة والا حد في ظهرك " يردد ذلك عليه مرارا، فوجب ان لا يخص بضرب الزنا والخمر عضو من عضو اذ لو اراد الله تعالي ذلك لبينه علي لسان رسوله صلي الله عليه وسلم الا انه يجب اجتناب الوجه ولا بد والمذاكر والمقاتل * اما الوجه فلما روينا من طريق مسلم نا عمرو الناقد.
 وزهير ابن حرب قالا جميعا: نا سفيان بن عيينة عن ابي الزناد عن الاعرج عن ابي هريرة قال: قال رسول الله صلي الله عليه وسلم: " اذا ضرب احدكم فليجتنب الوجه " * واما المقاتل فضربها غرر كالقلب والانثيين ونحو ذلك ولا يحل قتله ولا التعريض به لما نخاف منه وبالله تعالي التوفيق *  مسالة كيف يضرب الحدود اقاءما ام قاعدا؟ اختلف الناس في ذلك وقال الله تعالي: (فان تنازعتم في شء) الاية، اما من قال بان الحدود تقام علي المحدود وهو قاءم فانهم ذكروا في ذلك ما ناه عبد الرحمن بن عبد الله بن خالد نا ابراهيم بن احمد نا الفربري نا البخاري نا اسماعيل بن عبد الله نا مالك عن نافع عن ابن عمر فذكر حديث اليهوديين اللذين رجمهما رسول الله صلي الله عليه وسلم في الزنا، قال ابن عمر: فرايت الرجل يحني علي المراة يقيها الحجارة، وذكروا حديث ابي هريرة في جلده حد القذف الذي يقول في ذلك لعمرك اني يوم اضرب قاءما ثمانين سوطا انني لصبور * ثم اتوا باطرف ما يكون  من التخليط: فقالوا ان قول عمر بن الخطاب للجالد في الحد: اضرب واعط كل ذي عضو حقه دليل علي ان المجلود كان قاءما، وقال: فدل حديث اليهوديين علي ان الرجل كان قاءما وانها كانت قاعدة * قال ابو محمد رحمه الله: فكل هذا عليهم لا لهم علي ما نبين ان شاء الله تعالي * اما حديث النبي صلي الله عليه وسلم في ذلك فهم اول من عصاه وخالفه وقالوا: لا يحل ان يقام حد الزنا علي يهودي ولا يهودية وحملوا فعل رسول الله صلي الله عليه وسلم ذلك علي ما لم يقدموا
 علي اطلاقه بالسنتهم اما انه علي معصية الله تعالي واما انه علي انفاذ لما في التوراة مما لا يجوز لهم انفاذه وانه علي كل حال لم يحكم رسول الله صلي الله عليه وسلم في ذلك بامر الله تعالي ولا بوحيه اليه ولا بحق يجب اتباعه فيه لا محيد لهم من هذا، فهذا الذي ظنوا من ذلك كذب بحت وما فيه دليل علي انه كان قاءما ولا انها كانت قاعدة بل قد يحني عليها وهو راكع وهو الاظهر او وهو منكب قريب من الجلوس وهو ممكن جدا ايضا، واما ان يحني عليها وهو قاءم وهي قاعدة فممتنع لا يمكن البتة ولا يتاتي ذلك وقد يمكن ان يكونا قاءمين ويحني عليها بفضل ما للرجل علي المراة من الطول وقد يمكن ان يكونا قاعدين * واما حديث ابي هريرة فليس فيه ان ابا هريرة اوجب عليه ان يقوم قاءما اذ جلده ولابد ولا ان المراة بخلاف الرجل * قال ابو محمد رحمه الله: فاذ لانص في شء من هذا ولا اجماع فقد ايقنا ان الله تعالي لو اراد ان يكون اقامة الحد علي حال لا يتعدي من قيام او قعود او فرق بين رجل وامراة لبينه علي لسان رسوله عليه السلام، فصح ان الجلد في الزنا والقذف والخمر والتعزيز يقام كيف ما تيسر علي المراة والرجل قياما وقعودا فان امتنع امسك وان دفع بيديه الضرب عن نفسه مثل ان يلقي الشء الذي يضرب به فيمسكه امسكت يداه *   مسالة  صفة الضرب * قال ابو محمد رحمه الله: اجاز قوم ان يسال الدم في جلد الحدود والتعزيز وهو لم يات به عن الصحابة شء من ذلك بل قد صح عن عمر رضي الله عنه مما قد ذكرناه قبل لا تجد فاجلدها ولا يعرف له في ذلك مخالف من الصحابة رضي الله عنهم، والذي نقول به بل الضرب في الزنا والقذف والخمر والتعزير ان لا يكسر له عظم ولا ان يشق له جلد ولا ان يسال الدم ولا ان يعفن له اللحم لكن يوجع سالم من كل ذلك فمن تعدي فشق في ذلك الضرب او اسال دما او عفن لحما او كسر له عظما فعلي متولي ذلك القود وعلي الامر ايضا  القود ان امر بذلك * برهان ذلك قول الله تعالي: (قد جعل الله لكل شء قدرا) فعلمنا يقينا ان لضرب الحدود قدرا لا يتجاوزه وقدرا لا ينحط عنه بنص القران فطلبنا ذلك فوجدنا ادني اقداره ان يءلم فما نقص عن الالم فليس من اقداره وهذا مالا خلاف فيه من احد وكان اعلي اقداره نهاية الالم في الزنا مع السلامة من كل ما ذكرنا ثم الحطيطة من الالم علي حسب ما وصفنا، فاما المنع من كل ما ذكرنا فلقول رسول الله صلي الله عليه وسلم: " ان دماءكم واموالكم واعراضكم وابشاركم عليكم حرام " فحرمت اسالة الدم نصا اذ هرق الدم حرام الا ما اباحه نص او اجماع ولا نص ولا اجماع علي اباحة اسالة الدم في شء من الحدود نعم ولا عن احد من التابعين، واما تعفن اللحم فقد نص رسول الله صلي الله عليه واله علي تحريم البشرة فلا يحل منها الا ما احله نص او اجماع وانما صح النص والاجماع علي اباحتها للالم فقط واما كسر العظام فلا يقول باباحته في ضرب الحدود احد من الامة بلا شك * قال ابو محمد رحمه الله: ومن خالفنا في هذه الاشياء سالناه الشدة الضرب في ذلك حد ام لا؟ (فان قالوا): لا تركوا قولهم وخالفوا الاجماع ولزمهم ان يبيحوا ان يجلد في كل ذلك بسوط مملوء حديدا او رصاصا يقتل من ضربه وهذا لا يقوله احد من الامة (وان قالوا): ان لذلك حدا وقدرا نقف عنده فلا يحل تجاوزه سءلوا عن ذلك فان حدوا فيه غير ما حددنا كانوا متحكمين في الدين بلا برهان، (فان قالوا): ان الحدود انما جعلت للردع (قلنا لهم): كلا ما ذلك كما تقولون انما ردع الله تعالي بالتحريم وبالوعيد في الاخرة فقط واما بالحدود فانما جعل الله تعالي كما شاء ولم يخبرنا الله تعالي انها للردع ولو كانت للردع كما تدعون لكان الف سوط اردع من ماءة ومن ثمانين.
 ومن اربعين ومن خمسين، ولكان قطع اليدين والرجلين اردع من قطع يد واحدة ولكنا نقول: هي نكال وعقوبة وعذاب وجزاء وخزي كما قال الله تعالي في المحاربة:
 (انما جزاء الذين يحاربون الله ورسوله ويسعون) الاية.
 وقال تعالي: (فعليهن نصف ما علي المحصنات من العذاب) وقال تعالي في القاذف: (ان الذين يحبون ان تشيع الفاحشة في الذين امنوا) الاية وقال تعالي: (والسارق والسارقة) الاية وقال تعالي: (الزانية والزاني) الاية وانما التسمية في الدين الي الله تعالي لا الي الناس فصح انه تعالي جعلها كما شاء حيث شاء ولم يجعلها حيث لم يشا * قال ابو محمد رحمه الله: فاذ قد صح ما ذكرنا.
 وصح مقدار الضرب الذي لا يتجاوز فقد صح ان من تجاوز ذلك المقدار فانه متعد لحدود الله تعالي وهو عاص بذلك ولا  تنوب معصية الله تعالي عن طاعته فاذ هو متعد فعليه القود قال الله تعالي: (فمن اعتدي عليكم فاعتدوا عليه) الاية فضرب التعدي لا يتبعض بلا شك فاذ لا يتبعض وهو معصية فباطل ان يجزي عن الحد الذي هو طاعة لله تعالي فيقتص له منه، ثم يقام عليه الحد ولا بد وبالله تعالي التوفيق *  مسالة  باي شء يكون الضرب في الحد؟ * قال ابو محمد رحمه الله: اما اهل الراي.
 والقياس فانهم قالوا: الحدود كلها بالسوط الا الشافعي رحمه الله قال: الا الخمر فانه يجلد فيها بما صح عن النبي صلي الله عليه وسلم انه جلد فيها * قال ابو محمد رحمه الله: احتج من راي الجلد بالسوط ولا بد في الحدود بما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق نا معمر عن يحيي بن ابي كثير قال: " جاء رجل الي رسول الله صلي الله عليه وسلم فقال: يا رسول الله اني اصبت حدا فاقمه علي فدعا النبي صلي الله عليه وسلم بسوط فاتي بسوط جديد عليه ثمرته قال: لا سوط دون هذا فاتي بسوط مكسور العجز فقال: لا سوط فوق هذا فاتي بسوط بين السوطين فامر به فجلد " وذكر الخبر * وعن زيد بن اسلم " ان رجلا اعترف علي نفسه بالزنا فدعا رسول الله صلي الله عليه وسلم بسوط فاتي بسوط مكسور فقال فوق هذا فاتي بسوط جديد لم تقطع ثمرته
 فقال: بين هذين فاتي بسوط قد ركب به ولان فامر به فجلد " وذكر باقي الخبر حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب عن مخرمة بن بكير عن ابيه قال: سمعت عبيد الله بن مقسم يقول: سمعت كريبا مولي ابن عباس يحدث او يحدث عنه قال: " اتي رجل النبي صلي الله عليه وسلم فاعترف علي نفسه بالزنا ولم يكن الرجل احصن فاخذ رسول الله صلي الله عليه وسلم سوطا فوجد راسه شديدا فرده ثم اخذ سوطا اخر فوجده لينا فامر به فجلد ماءة " * وعن ابي عثمان النهدي قال: اتي عمر ابن الخطاب في حد ما ادري ما ذلك الحد فاتي بسوط فيه شدة فقال: اريد ما هو الين فاتي بسوط لين فقال: اريد اشد من هذا فاتي بسوط بين السوطين فقال: اضرب ولا يري ابطك * وعن ابي عثمان النهدي قال: اتي عمر بن الخطاب في حد فاتي بسوط فهزه فقال اءتوني بسوط الين من هذا فاتي بسوط اخر فقال اءتوني بسوط اشد من هذا فاتي بسوط بين السوطين فقال اضرب ولا يري ابطك واعط لكل عضو حقه * قال ابو محمد رحمه الله: ما نعلم له شبهة غير ما ذكرنا اما الاثار في ذلك عن رسول الله صلي الله عليه وسلم فمرسلة كلها ولا حجة في مرسل واضعفها حديث مخرمة بن بكير لانه منقطع في ثلاثة مواضع لان سماع مخرمة من ابيه لا يصح وشك ابن مقسم  اسمعه من كريب ام بلغه عنه ثم هو عن كريب مرسل ثم لو صح لما كان لهم في شء منها حجة لانه ليس في شء منها ان لا تجلد الحدود الا بسوط هذه صفته وانما فيه ان الحدود جاءز ان يضرب بسوط هذه صفته فقط وهذا امر لا ناباه فسقط تعلقهم بالاثار المذكورة * واما الاثر عن عمر رضي الله عنه فصحيح الا انه لا حجة لهم فيه ولا حجة في قول احد دون رسول الله صلي الله عليه وسلم فلما سقط كل ما شغبوا به نظرنا فيما يجب في ذلك فوجدنا الله تعالي يقول في الزاني والزانية: (فاجلدوا كل واحد منهما ماءة جلدة) الي قوله تعالي: (وليشهد عذابهما طاءفة من المءمنين) وقال تعالي:
 (فعليهن نصف ما علي المحصنات من العذاب) وقال عليه السلام: " علي ابنك جلد ماءة وتغريب عام " وقال تعالي في القاذف: (فاجلدوهم ثمانين جلدة) وقال رسول الله صلي الله عليه وسلم: " اذا زنت امة احدكم فليجلدها " وقال عليه السلام: " اذا شرب فاجلدوه " ونهي عليه السلام ان يجلد اكثر من عشر جلدات في غير حد فايقنا يقينا لا يدخله شك ان الله تعالي لو اراد ان يكون الجلد في شء مما ذكرنا بسوط دون سوط لبينه لنا علي لسان رسوله عليه السلام في القران وفي وحي منقول الينا ثابت كما بين صفة الضرب في الزنا وكما بين حضور طاءفة من المءمنين للعذاب في ذلك فاذ لم يفعل ذلك تعالي فبيقين ندري ان الله تعالي لم يرد قط ان يكون الضرب في الحدود بسوط خاصة دون ساءر ما يضرب به فاذ ذلك كذلك فالواجب ان يضرب الحد في الزنا والقذف بما يكون الضرب به علي هذه الصفة بسوط او بحبل من شعر او من كتان او من قنب او صوف او حلفاء او غير ذلك او تفر او قضيب من خيزران او غيره الا الخمر فان الجلد فيها علي ما جاء عن رسول الله صلي الله عليه وسلم كما روينا من طريق مسلم نا محمد بن المثني نا معاذ بن هشام  هو الدستواءي  نا قتادة عن انس بن مالك " ان النبي صلي الله عليه وسلم جلد في الخمر بالجريد والنعال " * ومن طريق البخاري نا قتيبة بن سعيد نا ابو ضمرة انس بن عياض عن يزيد بن الهادي عن محمد بن ابراهيم عن ابي سلمة عن ابي هريرة قال: اتي النبي صلي الله عليه وسلم برجل قد شرب فقال: " اضربوه " قال ابو هريرة: فمنا الضارب بيده والضارب بنعله والضارب بثوبه وذكر الحديث * قال ابو محمد رحمه الله: فالجلد في الخمر خاصة يكون بالجريد والنعال. 
 والايدي وبطرف الثوب كل ذلك اي ذلك راي الحاكم فهو حسن ولا يمتنع عندنا ان يجلد في الخمر ايضا بسوط لا يكسر ولا يجرح ولا يعفن لحما كما روينا من طريق مسلم نا احمد ابن عيسي نا ابن وهب اخبرني عمرو بن الحرث عن بكير بن الاشج قال:

 بينما نحن عند سليمان بن يسار اذ جاء عبد الرحمن بن جابر بن عبد الله فحدثه قاقبل علينا فقال: حدثني عبد الرحمن بن جابر عن ابيه عن ابي بردة الانصاري انه سمع رسول الله صلي الله عليه وسلم يقول: " لا يجلد احد فوق عشرة اسواط الا في حد من حدود الله تعالي " فاقتضي هذا ان الضرب بالسوط جاءز في كل حد وفي التعزير وضرب الخمر وبالله تعالي التوفيق *   مسالة  هل يجلد المريض الحدود ام لا؟ وان جلدها كيف يجلدها؟ * قال ابو محمد رحمه الله: اختلف الناس في هذا فقالت طاءفة: يعجل له ضرب الحد كما نا محمد بن سعيد بن نبات نا احمد بن عبد البصير نا قاسم بن اصبغ نا محمد بن عبد السلام الخشني نا محمد بن المثني نا عبد الرحمن بن مهدي نا سفيان الثوري عن عبد الله بن ابي بكر بن محمد بن عمرو بن حزم عن ابيه ان عمر بن الخطاب اتي برجل يشرب الخمر وهو مريض فقال: اقيموا عليه الحد فاني اخاف ان يموت * قال ابو محمد رحمه الله: فاحتمل هذا ان يكون اشفاق عمر رضي الله عنه من ان يموت قبل ان يضرب الحد فيكون معطلا للحد، واحتمل ايضا من ان يكون يصيبه موت منه فنظرنا في ذلك فوجدنا محمد بن سعيد ايضا قال: نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا سفيان فذكر هذا الخبر وفيه ان عمر قال: اضربوه لا يموت، فبين هذا ان اشفاق عمر كان من كلا الامرين * قال ابو محمد رحمه الله: فاذا كان هذا فقد ثبت انه امر بان يضرب ضربا لا يموت منه * وبه الي وكيع نا سفيان عن ابن جريج عن عبد الله بن عبيد بن عمير عن ابيه انه كان يبر نذره بادني الضرب، وبه الي وكيع نا سفيان عن ابن جريج عن عطاء الضغث للناس عامة في قوله تعالي: (وخذ بيدك ضغثا فاضرب به ولا تحنث) * نا يحيي بن عبد الرحمن بن مسعود نا احمد بن دحيم نا ابراهيم بن حماد نا اسماعيل بن اسحق نا
 اسمعيل بن ابي اويس عن اخيه عن سليمان بن بلال عن هشام بن عروة عن غلام لهم يفهم قال: اخبرني ذلك الغلام ان عروة حلف ليضربني كذا وكذا ضربة فاخذ بيده شماريخ فضربني بها جميعا * وبه الي اسمعيل نا محمد بن عبيد نا محمد بن ثور عن معمر عن قتادة في قوله تعالي: (وخذ بيدك ضغثا فاضرب به ولا تحنث) قال عودا فيه تسعة وتسعون عودا والاصل تمام الماءة فضرب به امراته وكان يحلف ليضربنها فكانت الضربة تحلة ليمينه وتخفيفا عن امراته، وهو قول الشافعي، وقالت طاءفة:

 يءخر جلده حتي يبرا، وهو قول مالك * وجاء عن مجاهد في الاية المذكورة ما ناه يحيي ابن عبد الرحمن بن مسعود بالاسناد المذكور الي اسماعيل بن اسحق نا علي بن عبد الله نا سفيان عن ابن ابي نجيح عن مجاهد في قوله تعالي: (وخذ بيدك ضعثا فاضرب به ولا تحنث) قال: هي لايوب خاصة * وقال عطاء: هي للناس عامة * قال ابو محمد رحمه الله: فلما اختلفوا نظرنا في ذلك لنعلم الحق فنتبعه بعون الله تعالي فوجدنا الطاءفة المانعة من اقامة الحد عليه حتي يبرا يحتجون بما ناه حمام نا عباس ابن اصبغ نا محمد بن عبد الملك بن ايمن نا عبد الله بن احمد بن حنبل نا ابي نا غندر نا شعبة قال: سمعت عبد الاعلي التغلبي يحدث عن ابي جميلة عن علي بن ابي طالب " ان امة زنت فحملت فاتي علي علي النبي صلي الله عليه وسلم فاخبره فقال له: دعها حتي تلد او قال حتي تضع ثم اجلدها " * وبه الي احمد بن حنبل نا وكيع نا سفيان عن عبد الاعلي التغلبي عن ابي جميلة الطهوي عن علي " ان خادما للنبي صلي الله عليه وسلم احدثت () فامرني النبي صلي الله عليه وسلم ان اقيم عليها الحد فاتيتها فوجدتها لم تجف من دمها فاتيته فاخبرته فقال: اذا جفت من دمها فاقم عليها الحد اقيموا الحدود علي ما ملكت ايمانكم " قالوا: فهذا رسول الله صلي الله عليه وسلم لم يعجل جلد الخادم الحامل حتي تضع فتجلد الحد الذي امر الله تعالي به، وكذلك التي لم تجف من دمها حتي يجف عنها دمها * ثم نظرنا في قول الطاءفة الثانية
 الموجبة تعجيل الحد علي حسب ما يءمن به الموت فوجدناهم يذكرون ما ناه عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب نا احمد بن يوسف النيسابوري.
 ومحمد بن عبيد الله ابن يزيد بن ابراهيم الحراني  واللفظ له  قال احمد: نا احمد بن سليمان، وقال محمد بن عبيد الله: حدثني ابي ثم اتفق احمد بن سليمان.
 وعبيد الله بن يزيد: قالا نا عبد الله بن عمرو  هو الرقي  عن زيد بن ابي انيسة عن ابي حازم عن سهل بن سعد قال: ان رسول الله صلي الله عليه وسلم اتي برجل قد زني فامر به فجرد فاذا رجل مقعد حمش الساقين فقال رسول الله صلي الله عليه وسلم: ما يبقي الضرب من هذا شيءا فدعا باثاكيل فيها ماءة شمروخ فضربه بها ضربة واحدة * نا حمام نا عباس بن اصبغ نا محمد بن عبد الملك بن ايمن نا يزيد ابن محمد العقيلي بمكة نا عبد الرحمن بن حماد الثقفي نا الاعمش عن الشعبي عن علقمة عن ابن عباس قال: مر رسول الله صلي الله عليه وسلم بامراة ضعيفة لا تقدر ان تمتنع ممن ارادها فقال رسول الله صلي الله عليه وسلم: ممن؟ قالت: من فلان فذكرت رجلا ضعيفا اضعف منها فبعث اليه رسول الله صلي الله عليه وسلم فجء به فساله عن ذلك؟ فاقر مرارا فقال له رسول الله صلي الله عليه وسلم: خذوا اثاكيل ماءة فاضربوه بها مرة واحدة *

 قال ابو محمد رحمه الله: حديث سهل بن سعد صالح تقوم به الحجة، فان قيل: ان هذا الخبر المعروف فيه اسراءيل كما نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب اخبرني محمد بن وهب الحراني نا محمد بن سلمة ني ابو عبد الرحيم  هو خال محمد بن سلمة  حدثني زيد  هو ابن ابي انيسة  عن ابي حازم عن ابي امامة ابن سهل بن حنيف قال: جء رسول الله صلي الله عليه وسلم بجارية  وهي حبلي  فسالها ممن حملك؟ فقالت: من فلان المقعد فجء بفلان فادا رجل حمش الجسد ضرير فقال: والله ما يبقي الضرب من هذا شيءا فامر باثا كيل ماءة فجمعت فضرب بها ضربة واحدة
 وهي شماريخ النخل الذي يكون فيها العروق، وفي اثار كثيرة يطول ذكرها جدا فتركناها لذلك * قال ابو محمد رحمه الله فلما جاءت الاثار كما ذكرنا وجب ان ننظر في ذلك فوجدنا حديث ابي جميلة عن علي صحيحا الا انه لا حجة لهم فيه اصلا لانه انما فيه ان رسول الله صلي الله عليه وسلم اخر الحد عن الحامل وعن التي لم تجف من دمها وهذا ليس مما نحن فيه في شء لان الحامل ليست مريضة وانما خيف علي جنينها الذي لا يحل هلاكه وحكم الصحيح ان تجلد بلا رافة وحكم الجنين ان لا يتوصل الي اهلاكه فوجب تاخير الجلد عنها جملة كما يءخر الرجم ايضا من اجله، واما التي لم تجف من دمها فان هذا كان اثر الولادة وفي حال سيلان الدم وهذا شغل شاغل لها ومثلها ان لا تجلد في تلك الحال كمن ذرعه القء او هو في حال الغاءط او البول ولا فرق وانقطاع ذلك الدم قريب انما هي ساعة او ساعتان ولم يقل في الحديث اذا طهرت انما قال: اذا جفت من دمها فبطل ان يكون لهم في شء من ذينك الحديثين متعلق اصلا، فاذ قد سقط ان يكون لتلك الطاءفة متعلق فالواجب ان ننظر بعون الله فيما قالت به الطاءفة الاخري.
 فنظرنا في الحديث الذي اوردنا من جلد المزمن المريض بشماريخ فيها ماءة عثكول، فوجدنا الطريق الذي صدرنا به من طريق سهل بن سعد طريقا جيدا تقوم به الحجة ووجدناهم يحتجون بامر ايوب صلي الله عليه وسلم * قال ابو محمد رحمه الله: اما نحن فلا نحتج بشريعة نبي غير نبينا صلي الله عليه وسلم لقول الله تعالي: (لكل جعلنا منكم شرعة ومنهاجا) ولما قد احكمنا في كتابنا الموسوم بالاحكام لاصول الاحكام * قال ابو محمد رحمه الله: وحتي لو لم يصح في هذا حد لكان قول الله تعالي:

 (لا يكلف الله نفسا الا وسعها) موجبا ان لا يجلد احد الا علي حسب طاقته من الالم وكان نصا جليا في ذلك لا يجوز مخالفته اصلا، وبضرورة العقل ندري ان ابن نيف وثلاثين قوي الجسم مصبر الخلق يحمل من الضرب من قوته ما لا يحمله الشيخ ابن ثمانين والغلام ابن خمسة عشر عاما واربعة عشر عاما اذا بلغ واصاب حدا، وكذلك يءلم الشيخ الكبير والغلام الصغير من الجلد مالا يءلم ابن الثلاثين الشاب القوي بل لا يكاد يحس الا حسا لطيفا ما يءلم ذينك الالم الشديد، وان الذي يءلم الشاب القوي لو قوبل به الشيخ الهرم والصغير النحيف من الجلد لقتلهما، هذا امر لا يدفعه الا مدافع للحس والمشاهدة، ووجدنا المريض يءلمه اقل شء مما لا يحسه الصحيح اصلا الا كما يحس بثيابه التي ليس لحسه لها في الالم سبيل اصلا وعلي حسب شدة المرض يكون تالمه للكلام وللتلف وللمس اليد بلطف، هذا ما لا شك فيه اصلا ومن كابر هذا فانما يكابر العيان والمشاهدة والحس، فوجدنا المريض اذا اصاب حدا من زنا او قذف او خمر لابد فيه من احد امرين لا ثالث لهما اما ان يعجل له الحد واما ان يءخر عنه (فان قالوا) يءخر (قلنا لهم): الي متي؟ (فان قالوا) الي ان يصح (قلنا لهم).
 ليس لهذا امد محدود وقد تتعجل الصحة وقد تبطء عنه.
 وقد لا يبرا فهذا تعطيل للحدود وهذا لا يحل اصلا لانه خلاف امر الله تعالي في اقامة الحدود فلم يبق الا تعجيل الحد كما قلنا نحن، ويءكذ ذلك قول الله تعالي: (سارعوا الي مغفرة من ربكم) فصح ان الواجب ان يجلد كل واحد علي حسب وسعه الذي كلفه الله تعالي ان يصبر له، فمن ضعف جدا جلد بشمراخ فيه ماءة عثكول جلدة واحدة او فيه ثمانون عثكالا كذلك.
 ويجلد في الخمر ان اشتد ضعفه بطرف ثوب علي حسب طاقة كل احد ولا مزيد، وبهذا نقول ونقطع انه الحق عند الله تعالي بيقين وما عداه فباطل عند الله تعالي وبه التوفيق *  مسالة  بكم من مرة من الاقرار تجب الحدود علي المقر؟ * قال ابو محمد
 رحمه الله: اختلف الناس في هذا فقالت طاءفة: باقراره مرة واحدة تجب اقامة الحدود وهو قول الحسن بن حي، وحماد بن ابي سليمان، وعثمان البتي، ومالك، والشافعي، وابي ثور، وابي سليمان.
 وجميع اصحابهم، وقالت طاءفة: لا يقام علي احد حد الزنا باقراره حتي يقر علي نفسه اربع مرات ولا يقام عليه حد القطع والسرقة حتي يقربه مرتين وحد الخمر مرتين، واما في القذف فمرة واحدة وهو قول روي عن ابي يوسف صاحب ابي حنيفة *

 قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا نظرنا فيما احتجت به كل طاءفة لقولها فنظرنا في قول من راي ان الحد لا يقام في الزنا باقل من اربع مرات فوجدناهم يحتجون بطريق مسلم ني عبد الملك بن شعيب عن الليث بن سعد ني ابي عن جدي ني عقيل بن خالد عن ابن شهاب عن ابي سلمة بن عبد الرحمن بن عوف.
 وسعيد بن المسيب كلاهما عن ابي هريرة انه اتي برجل الي رسول الله صلي الله عليه وسلم  وهو في المسجد  فناداه فقال: يا رسول الله اني قد زنيت فاعرض عنه فتنحي تلقاء وجهه فقال.
 يا رسول الله اني قد زنيت فاعرض عنه حتي كرر ذلك اربع مرات فلما شهد علي نفسه اربع شهادات دعاه رسول الله صلي الله عليه وسلم فقال: " ابك جنون؟ " قال.
 لا قال: فهل احصنت؟ قال: نعم قال رسول الله صلي الله عليه وسلم: " اذهبوا به فارجموه " * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن حاتم بن نعيم انا حبان  هو ابن موسي  انا عبد الله  هو ابن المبارك  عن حماد بن سلمة عن ابي الزبير عن عبد الرحمن بن مضاض عن ابي هريرة ان ماعزا اتي رجلا يقال له هزال فقال.
 يا هزال ان الاخر قد زني قال.
 ايت رسول الله صلي الله عليه وسلم قبل ان ينزل فيك قران فاتي رسول الله صلي الله عليه وسلم فاخبره انه زني فاعرض عنه ثم اخبره فاعرض عنه.
 ثم اخبره فاعرض عنه اربع مرات فلما كانت الرابعة امر برجمه فلما رجم اتي الي شجرة فقتل * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد
 ابن شعيب انا محمد بن حاتم بن نعيم انا حبان  وهو ابن موسي  انا عبد الله بن المبارك عن زكريا ابي عمران البصري  هو ابن سليم  صاحب اللءلءي قال: سمعت شيخا يحدث عمرو بن عثمان القرشي قال نا عبد الرحمن بن ابي بكرة عن ابيه قال.
 شهدت النبي عليه السلام وهو واقف علي بغلته فجاءته امراة حبلي فقالت: انها قد بغت فارجمها فقال لها النبي صلي الله عليه وسلم: " استتري بستر الله " فذهبت ثم رجعت اليه وهو واقف.
 علي بغلته فقالت: ارجمها فقال لها النبي صلي الله عليه وسلم: " استتري بستر الله " فرجعت ثم جاءت الثالثة  وهو واقف علي بغلته  فاخذت باللجام فقالت: انشدك الله الا رجمتها فقال: " انطلقي حتي تلدي " فانطلقت فولدت غلاما فجاءت به النبي صلي الله عليه وسلم فكفله النبي عليه السلام ثم قال: " انطلقي فتطهري من الدم " فانطلقت فتطهرت من الدم ثم جاءت فبعث النبي صلي الله عليه وسلم الي نسوة فامرهن ان يستبرءنها وان ينظرن اطهرت من الدم فجءن فشهدن عند النبي صلي الله عليه وسلم بطهرها فامر لها عليه السلام بحفرة الي ثندوتها ثم اقبل هو والمسلمون فقال.
 بيده فاخذ حصاة كانها حمصة فرماها بها ثم قال " للمسلمين ارموها واياكم ووجهها " فرموها حتي طفيت فامر باخراجها حتي صلي عليها * وروينا من  طريق مسلم نا محمد بن عبد الله بن نمير.
 ابو بكر بن ابي شيبة كلاهما يقول.
 ان عبد الله ابن نمير حدثه قال.
 نا بشر بن المهاجر نا عبد الله بن بريدة عن ابيه " ان ماعز بن مالك الاسلمي اتي رسول الله صلي الله عليه وسلم فقال.
 يا رسول الله اني قد ظلمت نفسي وزنيت واني اريد ان تطهرني فرده فلما كان من الغد اتاه فقال.
 يا رسول الله اني قد زنيت فرده الثانية فارسل رسول الله صلي الله عليه وسلم الي قومه فقال: اتعلمون بعقله باسا اتنكرون منه شيءا؟ فقالوا.
 ما نعلمه الا وفي العقل من صالحينا فيما نري فاتاه الثالثة فارسل اليهم ايضا فسال عنه فاخبروه انه لا باس به ولا بعقله فلما كان الرابعة حفر له حفرة ثم امر به فرجم فجاءت الغامدية فقالت.
 يا رسول الله اني قد زنيت فطهرني وانه ردها فلما
 كان الغد قالت.
 يا رسول الله اتردني لعلك تريد ان تردني كما رددت ماعزا فوالله اني لحبلي قال لها.
 لا اما الان فاذهبي حتي تلدي فلما ولدت اتته بالصبي في خرقة قالت.
 هذا قد ولدته قال.
 فاذهبي فارضعيه حتي تفطميه فلما فطمته اتت بالصبي في يده كسرة خبز قالت.
 هذا يا رسول الله قد فطمته وقد اكل الطعام فدفع الصبي الي رجل من المسلمين ثم امر بها فحفر لها الي صدرها وامر الناس فرجموها " فهذا هو البيان الجلي من رسول الله صلي الله عليه وسلم لاي شء رد ماعزا لان الغامدية قررته عليه السلام علي انه رد ماعزا وانه لا يحتاج الي ترديدها لان الزنا الذي اقرت به صحيح ثابت وقد ظهرت علامته  وهي حبلها  فصدقها رسول الله صلي الله عليه وسلم بذلك وامسك عن ترديدها ولو كان ترديده عليه السلام ماعزا من اجل ان الاقرار لا يصح بالزنا حتي يتم اربع مرات لانكر عليها هذا الكلام ولقال لها.
 لا شك انما اردك كما رددت ماعزا لان الاقرار لا يتم الا باربع مرات وهو عليه السلام لا يقر علي خطا ولا علي باطل فصح يقينا انها صادقة فانها لا تحتاج من الترديد الي ما احتاج اليه ماعز ولذلك لم يردها عليه السلام بعد هذا الكلام، وصح يقينا ان ترديده عليه السلام ماعزا انما كان لوجهين، احدهما ما نص عليه السلام من تهمته لعقله فسال عليه السلام قومه المرة بعد المرة هل به جنون؟ وسءاله عليه السلام هل شرب خمرا كما روينا من طريق مسلم نا محمد ابن العلاء نا يحيي بن يعلي بن الحرث المحاربي عن غيلان بن جامع عن علقمة بن مرثد عن سليمان بن يزيد عن ابيه قال.
 " جاء ماعز بن مالك الي رسول الله صلي الله عليه وسلم فقال له طهرني قال.
 ويحك ارجع فاستغفر الله وتب قال فرجع غير بعيد ثم جاء فقال يا رسول الله: طهرني فقال.
 له مثل ذلك حتي اذا كانت الرابعة قال له رسول الله صلي الله عليه وسلم.
 فيم اطهرك؟ قال: من الزنا فقال رسول الله صلي الله عليه وسلم.
 ابه جنة  فاخبر انه ليس بمجنون فقال.
 اشرب خمرا فقام رجل فاستنكهه فلم يجد منه ريح خمر
 فقال رسول الله صلي الله عليه وسلم.
 ازنيت؟ قال.
 نعم فامر به فرجم " وذكر باقي الخبر، والوجه الاخر ان رسول الله صلي الله عليه وسلم اتهمه انه لا يدري ما المزني فردده لذلك وقرره كما نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب ارنا سويد بن نصر ارنا عبد الله بن المبارك عن معمر عن يحيي بن ابي كثير عن عكرمة عن ابن عباس " ان الاسلمي اتي رسول الله صلي الله عليه وسلم فاعترف بالزنا فقال.
 لعلك قبلت او غمزت او نظرت " * وبه الي احمد بن شعيب اخبرني عبد الله بن الهيثم عن عثمان البصري ارنا وهب بن جرير بن حازم قال.
 حدثني ابي قال.
 سمعت يعلي ابن حكيم يحدث عن عكرمة عن ابن عباس " ان النبي صلي الله عليه وسلم قال لماعز ابن مالك: ويحك لعلك قبلت او غمزت او نظرت؟ قال.
 لا قال فنكتها؟ قال.
 نعم فعند ذلك امر برجمه " فقد صح يقينا ان ترديد النبي عليه السلام لماعز لم يكن مراعاة لتمام الاقرار اربع مرات اصلا وانما كان لتهمته اياه في عقله وفي جهله ما هو الزنا فبطل تعلقهم بحديث ابن بريدة، والحمد لله رب العالمين * واما حديث ابي هريرة من طريق ابن مضاض فان ابن مضاض مجهول لا يدري من هو، وقد جاء عن ابي هريرة خبر صحيح ببيان بطلان ظنهم نذكره بعد تمام كلامنا في هذه الاخبار ان شاء الله تعالي * وهو ما نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا اسحق ابن ابرهيم  هو ابن راهويه  انا عبد الرزاق نا ابن جريج اخبرني ابو الزبير قال.
 ان عبد الرحمن بن الصامت ابن عم ابي هريرة اخبره انه سمع ابا هريرة يقول.
 جاء الاسلمي الي رسول الله صلي الله عليه وسلم فشهد علي نفسه اربع مرات بالزنا يقول.
 اتيت امراة حراما كل ذلك يعرض عنه رسول الله صلي الله عليه وسلم فاقبل في الخامسة فقال.
 له انكحتها؟ قال.
 نعم قال.
 فهل تدري ما الزنا؟ قال.
 نعم اتيت منها حراما مثل ما ياتي الرجل من اهله حلالا قال.
 فما تريد بهذا القول قال.
 اريد ان تطهرني فامر به رسول الله صلي الله عليه وسلم ان يرجم فرجم فسمع رسول الله
 صلي الله عليه وسلم رجلين من اصحابه يقول احدهما لصاحبه. 
 انظروا الي هذا الذي ستر الله عليه فلم تدعه نفسه حتي رجم رجم الكلب فسكت عنهما رسول الله صلي الله عليه وسلم ساعة فمر بجيفة حمار شاءل برجليه فقال.
 اين فلان وفلان؟ فقالا.
 نحن يا رسول الله فقال لهم.
 كلا من جيفة هذا الحمار فقالا.
 يا رسول الله غفر الله لك من ياكل هذا؟ فقال رسول الله صلي الله عليه وسلم ما نلتما من عرض هذا انفا اشد  من هذه الجيفة فوالذي نفسي بيده انه الان في انهار الجنة * قال ابو محمد رحمه الله.
 فهذا خبر صحيح، وفيه ان رسول الله صلي الله عليه وسلم لم يكتف بتقريره اربع مرات ولا باقراره اربع مرات حتي اقر في الخامسة ثم لم يكتف بذلك حتي ساله السادسة هل تعرف ما الزنا؟ فلما عرف عليه السلام انه يعرف الزنا لم يكتف بذلك حتي ساله السابعة ما يريد بهذا الا ليختبر عقله فلما عرف انه عاقل صحيح العرض اقام عليه الحد، وفي هذا الخبر بيان بطلان الراي من الصاحب وغيره لانه عليه السلام انكر عليهما ما قالاه برايهما مجتهدين قاصدين الي الحق فهذا يبطل احتجاج من احتج بما روي عن بريدة، وبالله تعالي التوفيق * ومن طريق مسلم نا ابو غسان المسمعي نا معاذ  يعني ابن هشام الدستواءي  ني ابي عن يحيي بن ابي كثير ني ابو قلابة ان ابا المهلب حدثه عن عمران بن الحصين " ان امراة من جهينة اتت نبي الله صلي الله عليه وسلم  وهي حبلي من الزنا  فقالت يا نبي الله اصبت حدا فاقمه علي فدعا نبي الله صلي الله عليه وسلم وليها فقال احسن اليها فاذا وضعت فاتني بها فامر بها رسول الله صلي الله عليه وسلم فشكت عليها ثيابها وامر بها فرجمت.
 ثم صلي عليها فقال له عمر.
 اتصلي عليها يا نبي الله وقد زنت؟ قال.
 لقد تابت توبة لو قسمت بين اهل المدينة لوسعتهم، وهل وجدت افضل من ان جادت بنفسها لله تعالي؟ " * ومن طريق
 مسلم نا قتيبة نا الليث عن ابن شهاب عن عبيدالله بن عبد الله بن عتبة عن ابي هريرة وزيد بن خالد الجهني انهما قالا " ان رجلين من الاعراب اتيا رسول الله صلي الله عليه وسلم فقال احدهما يا رسول الله انشدك الله الا قضيت لي بكتاب الله فقال له الاخر.
 وهو افقه منه نعم فاقض بيننا بكتاب الله وايذن لي فقال رسول الله صلي الله عليه وسلم.
 قل فقال: ان ابني كان عسيفا علي هذا فزني بامراته " وذكر الحديث وفيه ان رسول الله صلي الله عليه وسلم قال له.
 " والذي نفسي بيده لاقضين بينكما بكتاب الله اما الوليدة والغنم رد عليك وعلي ابنك جلد ماءة وتغريب عام واغديا انيس علي امراة هذا فان اعترفت فارجمها فغدا عليها فاعترفت فامر بها رسول الله صلي الله عليه وسلم فرجمت " فوجدنا بريدة.
 وعمران بن الحصين.
 وابا هريرة.
 وزيد بن خالد كلهم قد روي عن رسول الله صلي الله عليه وسلم اقامة الحد في الزنا علي الغامدية والجهينية بغير ترديد وعلي امراة هذا المذكور بالاعتراف المطلق وهو يقتضي ولابد رجمها بما يقع عليه اسم اعتراف وهو مرة واحدة فقط وصح ان كتاب الله يوجب ما قضي به رسول الله صلي الله عليه وسلم من اقامة الحد في الزنا بالاعتراف المطلق دون تحديد عدد لقول رسول الله  صلي الله عليه وسلم.
 " لاقضين بينكما بكتاب الله تعالي " واقسم علي ذلك ثم قضي بالرجم في الاعتراف دون عدد فصح انه اذا صح الاعتراف مرة او الف مرة فهو كله سواء وان اقامة الحد واجب ولابد وبالله تعالي التوفيق *   مسالة  هل في الحدود نفي ام لا؟ قال ابو محمد رحمه الله: النفي يقع من الحدود في المحاربة بالقران وفي الزنا بالسنة وحكم به قوم في الردة وفي الخمر والسرقة * قال ابو محمد رحمه الله.
 فنتكلم ان شاء الله تعالي في كل ذلك فصلا فصلا فنقول وبالله تعالي التوفيق.
 قالت طاءفة.
 نفيه سجنه، وقالت طاءفة.
 ينفي ابدا من بلد الي بلد، وقالت طاءفة.
 نفيه هو ان يطلب حتي يعجزهم فلا يقدروا عليه كما نا حمام نا ابن مفرج نا
 ابن الاعرابي نا الدبري نا عبد الرزاق نا ابراهيم بن ابي يحيي عن داود بن الحصين عن عكرمة عن ابن عباس انه قال.
 في المحارب ان هرب واعجزهم فذلك نفيه * وبه الي عبد الرزاق عن ابن جريج عن عبد الكريم او غيره قال.
 سمعت سعيد بن جبير وابا الشعثاء جابر بن زيد يقولان.
 انما النفي ان لا يدركوا فاذا ادركوا ففيهم حكم الله تعالي والا نفوا حتي يلحقوا ببلدهم، وعن الزهري انه قال فيمن حارب ان عليه ان يقتل او يصلب او يقطع او ينفي فلا يقدر عليه، وعن الضحاك في قوله تعالي.
 (او ينفوا من الارض) قال: هو ان يطلبوا حتي يعجزوا * قال ابو محمد رحمه الله.
 وبهذا يقول الشافعي.
 وقال اخرون.
 النفي حد من حدود المحارب كما كتب الي المرجي بن زروان قال.
 نا ابو الحسن الرحبي نا ابو مسلم الكاتب نا عبد الله بن احمد بن المغلس نا عبد الله بن احمد بن حنبل عن ابيه نا ابو معاوية نا حجاج عن عطية العوفي عن ابن عباس قال.
 اذا خرج الرجل محاربا فاخاف الطريق واخذ المال قطعت يده ورجله من خلاف، واذا اخذ المال وقتل قطعت يده ورجله من خلاف ثم صلب، واذا قتل ولم ياخذ المال قتل، واذا اخاف الطريق ولم ياخذ مالا ولم يقتل نفي * قال ابو محمد رحمه الله: فنظرنا فيما يحتج به من قال.
 ان النفي هو السجن فوجدناهم يقولون ان الله تعالي قال.
 (او ينفوا من الارض) قالوا.
 والنفي في لغة العرب التي نزل بها القران هو الابعاد فصح ان الواجب ابعاده من الارض قالوا.
 ولا يقدر علي اخراجه من الارض جملة فوجب ان نفعل من ذلك اقصي ما نقدر عليه لقول رسول الله صلي الله عليه وسلم.
 " اذ امرتكم بامر فانوا منه ما استطعتم " ولقول الله تعالي.
 (فاتقوا الله ما استطعتم) فكان اقصي ما نستطيع من ذلك ابعاده عن كل ما قدرنا علي ابعاده منه من الارض، وغاية ذلك السجن لانه ممنوع من جميع الارض حاشا ما كان سجنه الذي لم نقدر علي منعه منه اصلا فلزمناما استطعنا من ذلك، وسقط عنا ما لم نستطع منه وانما قلنا حتي يحدث توبة لانه مادام  مصرا علي المحاربة فهو محارب فاذ هو محارب فواجب ان يجزي جزاء المحارب فالنفي
 عليه باق ما لم يترك المحاربة بالتوبة فاذا تركها سقط عنه جزاءها ان يتمادي فيه اذ قد جوزي علي محاربته * قال ابو محمد رحمه الله.
 ثم نظرنا في حجة من قال.
 ينفي ابدا من بلد الي بلد ان قال.
 اننا اذا سجناه في بلد او اقررناه فيه غير مسجون فلم ننفه من الارض كما امر الله تعالي بل عملنا به ضد النفي والابعاد وهو الاقرار والاثبات في الارض في مكان واحد منها وهذا خلاف القران فوجب علينا بنص القران ان نستعمل ابعاده ونفيه عن جميع الارض ابدا حسب طاقتنا وغاية ذلك الا نقره في شء منها مادمنا قادرين علي نفيه من ذلك الموضع ثم هكذا ابدا ولو قدرنا علي ان لا ندعه يقر ساعة في شء من الارض لفعلنا ذلك ولكان واجبا علينا فعله مادام مصرا علي المحاربة * قال ابو محمد رحمه الله.
 فكان هذا القول اصح واولي بظاهر القران لما ذكر المحتج له من ان السجن اثبات واقرار لا نفي، وما عرف قط اهل اللغة التي نزل بها القران وخاطبنا بها الله تعالي ان السجن يسمي نفيا ولا ان النفي يسمي سجنا بل هما اسمان مختلفان متغايران قال الله تعالي.
 (فامسكوهن في البيوت حتي يتوفاهن الموت او يجعل الله لهن سبيلا) الاية، وقال تعالي.
 (ثم بدا لهم من بعد ما راوا الايات ليسجننه حتي حين ودخل معه السجن فتيان) فما قال احد.
 لا قديم ولا حديث ان حكم الزواني كان النفي اذ امر الله تعالي بحسبهن في البيوت ولا قال قط احد ان يوسف عليه السلام نفي اذ حبس في السجن، فقد بطل قول من قال.
 بالسجن جملة.
 وعلي كل حال فالواجب ان ننظر في القولين اللذين هما اما نفيه الي مكان غير مكانه واقراره هنالك او نفيه ابدا.
 فوجدنا من حجة من قال ينفي من بلد الي بلد ويقر هنالك * [ ان قالوا: انتم لا تقولون بتكرار فعل الامر بل يجزي عندكم ايقاعه مرة واحدة، وذا كررتم النفي ابدا فقد نضتم اصلكم * قال علي: وهذا الذي انكروه داخل
 عليهم بمنعهم المنفي من الرجوع الي منزله فهم يقرون عليه استدامة تلك العقوبة فقد وقعوا فيما انكروا بعينه نعم والتكرار ايضا لازم لمن قال بنفيه او سجنه سواء سواء ] () * قال ابو محمد رحمه الله: فنقول ان المحارب الذي افترض الله تعالي علينا نفيه  حربا علي محاربته فانه مادام مصرا فهو محارب وما دام محاربا فالنفي حد من حدوده قال الله تعالي.
 (ولم يصروا علي ما فعلوا) فمن فعل المحاربة فبلا شك ندري انه في حال نومه واكله واستراحته ومرضه انه محارب كما كان لم يسقط عنه الاسم الذي وسمه الله تعالي به وحق عليه الحد به * هذا ما لا خلاف فيه فهو بعد القدرة عليه في حال اصراره علي المحاربة بلا شك لا يسقط عنه الاثم الا بتوبة او نص او اجماع فالحد باق عليه حتي يسقط بالتوبة او يسقط عنه الحكم بالنص او الاجماع فليس ذلك الا بقطع يده ورجله من خلاف بلا خلاف من احد في انه لا يجدد عليه قطع اخر ويمنع النص من ان يحدث له حدا اخر علي ما سلف منه * قال ابو محمد رحمه الله.
 ثم وجدنا من قال.
 بنفيه وتركه في المكان الذي ينفيه اليه قد خالف القران في انه اقره في ذلك المكان والاقرار خلاف النفي فقد اقروه في الارض فلم يبق الا القول الذي صححنا وهو قول الحسن البصري، وبه نقول.
 فالواجب ان ينفي ابدا من كل مكان من الارض وان لا يترك يقر الا مدة اكله ونومه وما لا بد له منه من الراحة التي ان لم ينلها مات.
 ومدة مرضه لقول الله تعالي.
 (وتعاونوا علي البر والتقوي) فواجب ان لا يقتل وان لا يضيع لكن ينفي ابدا حتي يحدث توبة فاذا احدثها سقط عنه النفي وترك يرجع الي مكانه فهذا حكم القران ومتي احدث التوبة من قرب او بعد سقط عنه النفي وبالله تعالي التوفيق *   مسالة  واما نفي الزاني فان الناس اختلفوا فيه فقالت طاءفة.
 الزاني غير
 المحصن يجلد ماءة وينفي سنة الحر والحرة ذات الزوج وغير ذات الزوج في ذلك سواء واما العبد الذكر فكالحر واما الامة فجلد خمسين ونفي ستة اشهر وهو قول الشافعي.
 واصحابه.
 وسفيان الثوري.
 والحسن بن حي.
 وابن ابي ليلي، وقالت طاءفة.
 ينفي الرجل الزاني جملة ولا تنفي النساء وهو قول الاوزاعي، وقالت طاءفة.
 ينفي الحر الذكر ولا تنفي المراة الحرة ذات زوج كانت او غير ذات زوج ولا الامة ولا العبد وهو قول مالك واصحابه، وقالت طاءفة.
 لا نفي علي زان اصلا لا علي ذكر ولا علي انثي ولا حر ولا عبد ولا امة وهو قول ابي حنيفة.
 واصحابه * قال ابو محمد رحمه الله.
 ونحن ذاكرون ان شاء الله تعالي ما جاء في ذلك عن المتقدمين، فمن ذلك ما ناه عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب نا محمد بن العلاء ابو كريب نا عبد الله بن ادريس الاودي سمعت عبيد الله بن عمر بن حفص بن عاصم عن نافع عن ابن عمر قال.
 " ان رسول الله صلي الله عليه وسلم ضرب وغرب وان ابا بكر ضرب وغرب وان عمر ضرب وغرب " * نا حمام نا ابن مفرج نا ابن  الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج عن موسي بن عقبة عن نافع عن صفية بنت ابي عبيد ان رجلا وقع علي جارية بكر فاحبلها فاعترف ولم يكن احصن فامر به ابو بكر فجلده ماءة ثم نفي * وعن عروة بن الزبير عن عاءشة ام المءمنين انها قالت اتي رجل الي عمر بن الخطاب فاخبره ان اخته احدثت  وهي في سترها وانها حامل  فقال عمر.
 امهلها حتي اذا وضعت واستقلت فاذني بها فلما وضعت جلدها ماءة وغربها الي البصرة عاما * ومن طريق مالك عن ابن شهاب ان عمر بن الخطاب غرب في الزنا سنة.
 قال ابن وهب قال ابن هشاب: ثم لم يزل ذلك الامر تمضي به السنة حتي غرب مروان في امرته بالمدينة ثم ترك ذلك الناس، وعن ابن وهب اخبرني جرير ابن حازم عن الحسن بن عمارة عن العلاء بن بدر عن كلثوم بن جبير قال.
 تزوج رجل منا
 امراة فزنت قبل ان يدخل بها فجلدها علي بن ابي طالب ماءة سوط ونفاها سنة الي نهر كربلاء فلما رجعت دفعها الي زوجها وقال.
 امراتك فان شءت فطلق وان شءت فامسك * وعن ابن هشاب عن يحيي بن عبد الرحمن بن حاطب عن ابيه ان حاطبا توفي واعتق من صلي من رقيقه وصام وكانت له وليدة نوبية قد صلت وصامت وهي اعجمية لم تفقه فلم يرعه الا حملها فذهب الي عمر فزعا فقال له عمر: انت الرجل الذي لا تاتي بخير فارسل اليها عمر احبلت؟ فقالت نعم من مرعوش بدرهمين فاذا هي تستهل به وصادفت عنده علي بن ابي طالب.
 وعثمان بن عفان.
 وعبد الرحمن بن عوف فقال: اشيروا علي وعثمان جالس فاضطجع فقال علي.
 وعبد الرحمن قد وقع عليه الحال قال: اشر علي يا عثمان قال: قد اشار عليك اخواك قال: اشر علي انت قال اراها تستهل به كانها لا تعلمه وليس الحد الا علي من علمه فامر بها فجلدت ماءة وغربها * وعن عطاء قال: البكر تجلد ماءة وتنفي سنة، وعن عبد الله بن مسعود في البكر يزني بالبكر يجلدان ماءة وينفيان سنة، وعن ابن عمر انه حد مملوكة له في الزنا ونفاها الي فدك * قال ابو محمد رحمه الله: واما من لم ير ذلك فكما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابي حنيفة عن حمادبن ابي سليمان عن ابراهيم النخعي قال قال علي ابن ابي طالب في البكر يزني بالبكر فان حبسهما من الفتيان ينفيان، وعن ابراهيم النخعي ان علي بن ابي طالب قال في ام الولد اذا اعتقها سيدها او مات فزنت انها تجلد ولا تنفي * قال ابو محمد رحمه الله: فلما اختلفوا نظرنا في ذلك لنعلم الحق فنتبعه بعون الله تعالي فنظرنا في قول من قال بالتغريب من حد الزنا يذكرون ما رويناه من طريق مسلم نا قتيبة نا ليث عن ابن شهاب عن عبيد الله بن عبد الله بن عتبة بن مسعود عن ابي هريرة وزيد  ابن خالد انهما قالا " ان رجلا من الاعراب اتي رسول الله صلي الله عليه وسلم فقال: يا رسول الله انشدك الله الا قضيت لي بكتاب الله فقال الخصم الاخر وهو افقه منه: نعم فاقض بيننا بكتاب الله
 واءذن لي فقال له رسول الله صلي الله عليه وسلم: قل قال: ان ابني كان عسيفا علي هذا فزني بامراته واني اخبرت ان علي ابني الرجم فافتديت منه بماءة شاء ووليدة فسالت اهل العلم فاخبروني انما علي ابني جلد ماءة وتغريب عام وان علي امراة هذا الرجم فقال له رسول الله صلي الله عليه وسلم: والذي نفسي بيده لاقضين بينكما بكتاب الله الوليدة والغنم رد عليك وعلي ابنك جلد ماءة وتغريب عام واغديا انيس علي امراة هذا فان اعترفت فارجمها قال فغدا عليها فاعترفت فامر بها فرجمت " * قال ابو محمد رحمه الله: وهكذا رويناه من طريق معمر.
 وصالح بن كيسان.
 ويونس بن زيد.
 وسفيان بن عيينة.
 ومالك بن انس كلهم عن الزهري بهذا الاسناد * ومن طريق مسلم نا يحيي بن يحيي التميمي انا هشيم عن منصور عن الحسن عن حطان بن عبد الله الرقاشي عن عبادة بن الصامت قال: قال رسول الله صلي الله عليه وسلم: " خذوا عني خذوا عني قد جعل الله لهن سبيلا البكر بالبكر جلد ماءة وتغريب عام والثيب بالثيب جلد ماءة والرجم " * ومن طريق مسلم نا عمرو الناقد نا هشيم بهذا الاسناد مثله ومن طريق مسلم نا محمد بن المثني ومحمد بن بشار جميعا عن عبد الاعلي نا سعيد  هو ابن ابي عروبة  عن قتادة عن الحسن عن حطان بن عبد الله عن عبادة بن الصامت قال: " كان نبي الله صلي الله عليه وسلم اذا انزل عليه كرب لذلك وتربد له وجهه قال.
 فانزل عليه ذات يوم فبقي كذلك فلما سري عنه قال: خذوا عني قد جعل الله لهن سبيلا الثيب بالثيب والبكر بالبكر الثيب جلد ماءة ثم رجم بالحجارة والبكر جلد ماءة ثم نفي سنة * نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن عبد الاعلي نا يزيد  هو ابن زريع  نا سعيد بن ابي عروبة عن قتادة عن الحسن عن حطان بن عبد الله الرقاشي عن عبادة بن الصامت قال: " كان رسول الله صلي الله عليه وسلم اذا انزل عليه كرب لذلك وتربد له وجهه فنزل عليه ذات يوم فلقي ذلك فلما سري عنه قال: خذوا عني قد جعل الله لهن سبيلا البكر بالبكر جلد ماءة ونفي سنة والثيب بالثيب جلد ماءة والرجم " *
 قال ابو محمد رحمه الله: ورواه ايضا شعبة.
 وهشام الدستواءي كلاهما عن قتادة باسناده نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن اسمعيل ابن ابراهيم بن علية.
 ومحمد بن يحيي بن عبد الله قال ابن علية: نا عبد الرحمن بن نا عبد العزيز بن عبد الله بن ابي سلمة، وقال محمد بن يحيي: انا يعقوب بن ابراهيم بن  سعد بن ابراهيم بن عبد الرحمن بن عوف انا ابي عن صالح بن كيسان ثم اتفق صالح.
 وابن ابي سلمة كلاهما عن الزهري عن عبيد الله بن عبد الله بن عتبة بن مسعود عن زيد بن خالد الجهني قال: سمعت رسول الله صلي الله عليه وسلم يامر فيمن لم يحصن اذا زني بجلد ماءة وتغريب عام، وبه الي احمد بن شعيب انا محمد بن رافع نا حجير نا الليث عن عقيل بن خالد عن ابن شهاب عن سعيد بن المسيب عن ابي هريرة عن رسول الله صلي الله عليه وسلم انه قضي فيمن زني ولم يحصن ان ينفي عاما مع اقامة الحد عليه * قال ابو محمد رحمه الله: فكانت هذه اثار متظاهرة رواها ثلاثة من الصحابة رضي الله عنهم.
 عبادة بن الصامت.
 وابو هريرة.
 وزيد بن خالد الجهني بايجاب تغريب عام مع جلد ماءة علي الزاني الذي لم يحصن مع اقسام النبي عليه السلام بالله تعالي في قضاءه به انه كتاب الله تعالي.
 وكتاب الله تعالي هو وحيه وحكمه مع ان الله تعالي يقول في القران: (وما ينطق عن الهوي ان هو الا وحي يوحي) فهذا نص القران فان كل ما قاله رسول الله صلي الله عليه وسلم فعن وحي من الله تعالي يقوله، وقال تعالي: (فعليهن نصف ما علي المحصنات من العذاب) وفرق عليه السلام بين حد المملوك وحد الحر في حديث ابن عباس.
 وعلي الذي اوردنا قبل في باب حد المماليك فصح النص ان علي المماليك ذكورهم واناثهم نصف حد الحر والحرة وذلك جلد خمسين ونفي ستة اشهر * قال ابو محمد رحمه الله: ثم نظرنا في قول من لم ير التغريب علي النساء والمماليك
 فوجدناهم يذكرون الخبر الذي قد اوردناه قبل باسناده فاغني عن ترداده، وهو قوله عليه السلام: " اذا زنت امة احدكم فليجلدها ولا يثرب " فلا حجة لهم فيه لانه خبر مجمل فسره غيره لانه انما فيه فليجلدها ولم يذكر فيه عدد الجلد كم هو، فصح انه انما احال عليه السلام بيان الجلد المامور به فيه علي القران وعلي الخبر الذي فيه بيان حكم المملوك في الحدود فاذ هو كذلك فليس سكوت النبي صلي الله عليه وسلم عن ذكر التغريب في ذلك الخبر حجة في ابطال التغريب الذي قد صح امره صلي الله عليه وسلم به فيمن زنا ولم يحصن، وكذلك ليس في سكوته صلي الله عليه وسلم عن ذكر عدد جلدها كم هو حجة في اسقاط ما قد صح عنه عليه السلام من ان حدها نصف حد الحرة، وايضا فان هذا الخبر ليس فيه ان لا تغريب ولا ان التغريب ساقط عنها لكنه مسكوت عنه فقط.
 واذا لم يكن فيه نهي عن تغريبها فلا يجوز ان يكون هذا الخبر معارضا للاخبار التي فيها النفي وبالله تعالي التوفيق *

 قال ابو محمد رحمه الله: وقال بعضهم: ان حق السيد في خدمة عبده وامته وحق اهل المراة فيها فلا يجوز قطع حقوقهم بنفي العبد.
 والامة.
 والمراة فيقال لهم: ليس بشء لان حق الزوجة والولد ايضا في زوجها وابنهم فلا يجوز قطعه بنفيهم، فان ادعوا ان حديث عبادة منسوخ بقول الله تعالي: (الزانية والزاني) الاية، وقالوا: لان حديث عبادة " خذوا عني قد جعل الله لهن سبيلا " قالوا: صح ان هذا الخبر كان بعد قول الله تعالي.
 (واللاتي ياتين الفاحشة من نساءكم) الاية قال: فكان السبيل ما ذكر في حديث عبادة من الجلد والرجم والتغريب، ثم جاء قول الله تعالي: (الزانية والزاني) الاية فكان ناسخا لخبر عبادة * قال ابو محمد رحمه الله: هذا كلام جمع التخليط والكذب، اما التخليط فدعواهم النسخ، واما الكذب فهو التحكم منهم في اوقات نزول الاية وما في خبر عبادة بلا
 برهان ونحن نبين ذلك بحول الله تعالي وقوته فنقول: ان دعواهم ان خبر عبادة كان قبل نزول الاية من اجل ما فيه " خذوا عني قد جعل الله لهن سبيلا " فظن منهم وقد حرم الله تعالي القطع بالظن بقوله تعالي: (ان يتبعون الا الظن وما تهوي الانفس) وقال تعالي: (وان الظن لا يغني من الحق شيءا) وبقوله صلي الله عليه وسلم: " اياكم والظن فان الظن اكذب الحديث " لكن القول الصحيح في هذا المكان هو ان القطع بان حديث عبادة كان قبل نزول (الزانية والزاني) الاية، او بان نزول هذه الاية كان قبل حديث عبادة فمن الممكن ان يكون حديث عبادة قبل نزول الاية المذكورة، وجاءز ان يكون نزول الاية قبل حديث عبادة وكل ذلك سواء اي ذلك كان لا يعترض بعضه علي بعض ولا يعارض شيءا منه شء ولا خلاف بين الاية والحديث علي ما نبين ان شاء الله تعالي فنقول: انه ان كان حديث عبادة قبل نزول الاية فقد صح ما في حكم حديث عبادة من الجلد والغريب والرجم وكانت الاية وردت ببعض ما في حديث عبادة واحالنا الله تعالي في باقي الحد علي ما سلف في حديث عبادة وكما لم تكن الاية مانعة عندهم من الرجم الذي ذكر في حديث عبادة قبل نزولها بزعمهم ولم يذكر فيها فكذلك ليست مانعة من التغريب الذي ذكر في حديث عبادة قبل نزولها بزعمهم ولم يذكر فيها ولا فرق، هذا هو الحكم الذي لا يجوز تعديه ان كان حديث عبادة قبل نزول الاية كما ادعوا، وان كان حديث عبادة بعد نزول الاية فقد جاء بما في الاية من الجلد وزيادة الرجم والتغريب وكل ذلك حق ولم يكن قول رسول الله صلي الله عليه وسلم في حديث عبادة " قد جعل الله لهن سبيلا " بموجب ان يكون قبل نزول الاية ولا بد بل قد تنزل الاية  ببعض الذي جعله الله تعالي لهن ثم بين رسول الله صلي الله عليه وسلم في حديث عبادة تمام السبيل وهو الرجم والتغريب المضافان الي ما في الاية من الجلد وبالله تعالي التوفيق *  مسالة من اصاب حدا ولم يدر بتحريمه * قال ابو محمد رحمه الله:
 من اصاب شيءا محرما فيه حد او لا حد فيه وهو جاهل بتحريم الله تعالي له فلا شء عليه فيه لا اثم ولا حد ولا ملامة لكن يعلم فان عاد اقيم عليه حد الله تعالي فان ادعي جهالة نظر فان كان ذلك ممكنا فلا حد عليه اصلا، وقد قال قوم بتحليفه ولا نري عليه حدا ولا تحليفا وان كان متيقنا انه كاذب لم يلتفت الي دعواه * قال ابو محمد: برهان ذلك قول الله تعالي: (لانذركم به ومن بلغ) فان الحجة علي من بلغته النذارة لا من لم تبلغه، وقد قال الله تعالي: (لا يكلف الله نفسا الا وسعها) وليس في وسع احد ان يعلم ما لم يبلغه لانه علم غيب واذا لم يكن ذلك في وسعه فلا يكلف الله احدا الا ما في وسعه فهو غير مكلف تلك القصة فلا اثم عليه فيما لم يكلفه ولا حد ولا ملامة وانما سقط هذا عمن يمكن ان يعلم ويمكن ان يجله فلقول رسول الله صلي الله عليه وسلم: " ان دماءكم واموالكم واعراضكم وابشاركم عليكم حرام، وقد جاءت في هذا عن السلف اثار كثيرة كما روينا عن سعيد بن المسيب ان عاملا لعمر ابن الخطاب كتب الي عمر يخبره ان رجلا اعترف عنده بالزنا فكتب اليه عمر ان سله هل كان يعلم انه حرام فان قال.
 نعم فاقم عليه الحد وان قال.
 لا فاعلمه انه حرام فان عاد فاحدده * وعن الهيثم بن بدر عن حرقوص قال اتت امراة الي علي بن ابي طالب فقالت ان زوجي زني بجاريتي فقال صدقت هي وما لها لي حل فقال له علي: اذهب ولا تعد كانه درا عنه الحد بالجهالة *  مسالة المرتدين * قال ابو محمد رحمه الله: كل من صح عنه انه كان مسلما متبرءا من كل دين حاش دين لاسلام ثم ثبت عنه انه ارتد عن الاسلام وخرج الي دين كتابي او غير كتابي او الي غير دين فان الناس اختلفوا في حكمه فقالت طاءفة: لا يستتاب وقالت طاءفة: يستتاب.
 وفرقت طاءفة بين من اسر ردته وبين من اعلنها وفرقت طاءفة بين من ولد في الاسلام ثم ارتد وبين من اسلم بعد كفره ثم ارتد ونحن ذاكرون ان شاء الله تعالي ما يسر الله تعالي لذكره فاما من قال: لا يستتابوا
 فانقسموا قسمين فقالت طاءفة: يقتل المرتد تاب او لم يتب راجع الاسلام او لم يراجع * وقالت طاءفة.
 ان بادر فتاب قبلت منه توبته وسقط عنه القتل وان لم تظهر توبته انفذ عليه القتل، واما من قال: يستتاب فانهم انقسموا اقساما فطاءفة  قالت.
 نستتيبه مرة فان تاب والا قتلناه، وطاءفة قالت.
 نستتيبه ثلاث مرات فان تاب والا قتلناه، وطاءفة قالت.
 نستتيبه شهرا فان تاب والا قتلناه، وطاءفة قالت.
 نستتيبه ثلاثة ايام فان تاب والا قتلناه، وطاءفة قالت.
 نستتيبه ماءة مرة فان تاب والا قتلناه، وطاءفة قالت.
 يستتاب ابدا ولا يقتل، فاما من فرق بين المسر والمعلن فان طاءفة قالت.
 من اسر ردته قتلناه دون استتابة ولم نقبل توبته ومن اعلنها قبلنا توبته، وطاءفة قالت: ان اقر المسر وصدق النية قبلنا توبته وان لم يقر ولا صدق النية قتلناه ولم نقبل توبته قال هءلاء.
 واما المعلن فتقبل توبته، وطاءفة قالت لا فرق بين المسر والمعلن في شء من ذلك فطاءفة قبلت توبتهما معا اقر المسر او لم يقر، وطاءفة لم تقبل توبة مسر ولا معلن * قال ابو محمد رحمه الله: واختلفوا ايضا في الكافر الذمي او الحربي يخرجان من كفر الي كفر، فقالت طاءفة: يتركان علي ذلك ولا يمنعان منه، وقالت طاءفة: لا يتركان علي ذلك اصلا ثم افترق هءلاء فرقتين، فقالت طاءفة: ان رجع الذمي الي دينه الذي خرج عنه ترك والا قتل، وقالت طاءفة: لا يقبل منه شء غير الاسلام وحده والا قتل ولا يترك علي الدين الذي خرج اليه ولا يترك ايضا ان يرجع الي الذي خرج عنه لكن ان اسلم ترك وان ابي قتل ولا بد * قال ابو محمد رحمه الله: نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن بشار ني حماد بن مسعدة ناقرة  هو ابن خالد  عن حميد بن هلال عن ابي بردة ابن ابي موسي الاشعري عن ابيه ان النبي صلي الله عليه وسلم بعثه الي اليمن ثم ارسل معاذ بن جبل بعد ذلك فلما قدم قال.
 يا ايها الناس اني رسول رسول الله صلي الله عليه وسلم اليكم فالقي له
 ابو موسي وسادة ليجلس عليها فاتي برجل كان يهوديا فاسلم ثم كفر فقال معاذ: لا اجلس حتي يقتل قضاء الله ورسوله ثلاث مرات فلما قتل قعد * ومن طريق البخاري نا يحيي ابن سعيد القطان عن قرة بن خالد قال: حدثني حميد بن هلال اخبرني ابو بردة بن ابي موسي الاشعري عن ابي موسي الاشعري ان رسول الله صلي الله عليه وسلم قال له: " اذهب انت يا ابا موسي او يا عبد الله بن قيس الي اليمن " ثم اتبعه معاذ بن جبل فلما قدم عليه القي له وسادة قال: واذا رجل موثق فقال: ماهذا؟ قال: كان يهوديا فاسلم ثم تهود قال: لا اجلس حتي يقتل قضاء الله ورسوله ثلاث مرات فامر به فقتل في حديث * وعن ايوب السختياني عن عكرمة قال: اتي علي بن ابي طالب بزنادقة فاحرقهم فبلغ ذلك ابن عباس فقال: لو كنت انا لم احرقهم لنهي رسول الله صلي الله عليه وسلم  " لا تعذبوا بعذاب الله " ولقتلتهم وذكر باقي الحديث * وعن ابي عمرو الشيباني ان رجلا من بني عجل تنصر فكتب بذلك عيينة بن فرقد السلمي الي علي بن ابي طالب فكتب علي ان يءتي به فجء به حتي طرح بين يديه رجل اشعر عليه ثياب صوف موثوق في الحديد فكلمه علي فاطال كلامه وهو ساكت فقال: لا ادري ما تقول؟ غير اني اعلم ان عيسي ابن الله فلما قالها قام اليه علي فوطءه فلما راي الناس ان عليا قد وطءه قاموا فوطءوه فقال علي: امسكوا فامسكوا حتي قتلوه ثم امر به علي فاحرق بالنار * وعن انس بن مالك قال.
 بعثني ابو موسي الاشعري بفتح تستر الي عمر بن الخطاب فسالني عمر وكان نفر ستة من بكر بن واءل قد ارتدوا عن الاسلام ولحقوا بالمشركين فقال: ما فعل النفر من بكر؟ قال: فاخذت في حديث اخر لاشغله عنهم فقال.
 ما فعل النفر من بكر بن واثل؟ قلت.
 يا امير المءمنين قوم ارتدوا عن الاسلام ولحقوا بالمشركين ما سبيلهم الا القتل فقال عمر: لان اكون اخذتهم سلما احب الي مما طلعت عليه الشمس من صفراء او بيضاء وذكر باقي الخبر * واما من قال: يستتاب
 مرة فان تاب والا قتل لما روينا من طريق عبد الرزاق عن معمر عن الزهري عن عبيد الله ابن عبد الله بن عتبة بن مسعود عن ابيه قال اخذ ابن مسعود قوما ارتدوا عن الاسلام من اهل العراق فكتب فيهم الي عثمان فرد اليه عثمان ان اعرض عليهم دين الحق وشهادة ان لا اله الا الله فان قبلوها فخل عنهم وان لم يقبلوها فاقتلهم فقبلها بعضهم فتركه ولم يقبلها بعضهم فقتله * وعن ابي عمرو الشيباني قال: اتي علي بن ابي طالب بشيخ كان نصرانيا فاسلم ثم ارتد عن الاسلام فقال له علي: لعلك انما ارتددت لان تصيب ميراثا ثم ترجع الي الاسلام؟ قال: لا قال.
 فلعلك خطبت امراة فابوا ان يزوجوكها فاردت ان تزوجها ثم تعود الي الاسلام؟ قال: لا قال: فارجع الي الاسلام قال لا حتي القي المسيح قال.
 فامر به علي فضربت عنقه ودفع ميراثه الي ولده المسلمين * وعن ابي عمرو الشيباني ان المسور العجلي تنصر بعد اسلامه فبعث به عتبة بن ابي وقاص الي علي فاستتابه فلم يتب فقتله فساله النصاري جيفته بثلاثين الفا فابي علي واحرقه * واما من قال يستتاب ثلاث مرات فلما روينا من طريق عبد الرزاق عن ابن جريج اخبرني سليمان بن موسي انه بلغه عن عثمان بن عفان انه كفر انسان بعد ايمانه فدعاه الي الاسلام ثلاثا فابي فقتله * وبه الي عبد الرزاق عن ابن جريج اخبرني حيان عن ابن شهاب انه قال اذا اشرك المسلم دعي الي الاسلام ثلاث مرات فان ابي ضربت عنقه * واما من قال: يستتاب ثلاثة ايام فان تاب والا قتل فهو  قول مالك.
 واصحابه، واحد قولي الشافعي * واما من قال يستتاب مرة فان تاب والا قتل فهو قول الحسن بن حي * واما من قال: يستتاب شهرا فكما روينا من طريق عبد الرزاق نا عثمان عن سعيد بن ابي عروبة عن ابي العلاء عن ابي عثمان النهدي ان عليا استتاب رجلا كفر بعد اسلامه شهرا فابي فقتله * وقد روي هذا عن مالك وعن بعض اهل مذهبه * واما من قال: يستتاب شهرين فكما روينا من طريق عبد الرزاق عن معمر عن ايوب عن حميد بن
 هلال عن ابي بردة قال: قدم علي ابي موسي الاشعري معاذ بن جبل من اليمن واذا برجل عنده فقال: ما هذا؟ فقال: رجل كان يهوديا فاسلم ثم تهود ونحن نريده علي الاسلام منذ احسبه قال: شهرين قال معاذ: والله لا اقعد حتي تضربوا عنقه فضربت عنقه ثم قال معاذ: قضاء الله ورسوله * حدثنا عبد الوهاب  هو ابن عطاء الخفاف  انا سعيد عن ايوب عن حميد بن هلال ان معاذ بن جبل قدم علي ابي موسي اليمن فوجد عنده رجلا قد تهود وعرض عليه ابو موسي الاسلام شهرين فقال معاذ: والله لا اجلس حتي اقتله قضاء الله ورسوله * واما من قال: يستتاب ابدا دون قتل فلما نا عبد الله بن ربيع نا عبد الله بن محمد بن عثمان نا علي بن عبد العزيز نا الحجاج بن المنهال نا حماد بن سلمة انا داود  هو ابن ابي هند  عن الشعبي عن انس بن مالك ان ابا موسي الاشعري قتل جحينة الكذاب واصحابه قال انس: فقدمت علي عمر بن الخطاب فقال: ما فعل جحينة واصحابه قال: فتغافلت عنه ثلاث مرات فقلت: يا امير المءمنين وهل كان سبيل الي القتل؟ فقال عمر: لو اتيت بهم لعرضت عليهم الاسلام فان تابوا والا استودعتهم السجن * وروينا من طريق عبد الرزاق عن معمر قال: اخبرني محمد بن عبد الرحمن بن عبدالقاري عن ابيه قال: قدم مجزاة بن ثور او شقيق بن ثور علي عمر يبشره بفتح تستر فقال له عمر: هل كانت مغربة يخبرنا بها؟ قال: لا الا ان رجلا من العرب ارتد فضربنا عنقه قال عمر.
 ويحكم فهلا طينتم عليه بابا وفتحتم له كرة فاطعمتموه كل يوم منها رغيفا وسقيتموه كوزا من ماء ثلاثة ايام ثم عرضتم عليه الاسلام في الثالثة فلعله ان يرجع اللهم لم احضر ولو امر ولم اعلم * واما من قال: اربعين يوما فلما روينا من طريق ابن وضاح نا سحنون نا ابن وهب عن مسلمة بن علي عن رجل عن قتادة ان رجلا يهوديا اسلم ثم ارتد عن الاسلام فحبسه ابو موسي الاشعري اربعين يوما يدعوه الي الاسلام فاتاه معاذ بن جبل فراه عنده فقال: لا انزل حتي تضرب عنقه فلم ينزل حتي ضربت عنقه * واما من ارتد من كفر الي كفر فان ابا حنيفة
 ومالكا قالا جميعا يقر علي ذلك ولا يعترض عليه، وقال الشافعي، وابو سليمان،  واصحابهما: لا يقر علي ذلك، ثم اختلف قول الشافعي: فمرة قال: ان رجع الي الكفر الذي تذمم عليه ترك والا قتل الا ان يسلم، ومرة قال: لا يقبل منه الرجوع الي الدين الذي خرج عنه لا بد له من الاسلام او السيف.
 وبهذا يقول اصحابنا: * قال ابو محمد رحمه الله: فنظرنا في قول من قال: انه يستتاب مرة فان تاب والا قتل فوجدناهم يقولون: قال الله تعالي: (ادع الي سبيل ربك بالحكمة والموعظة الحسنة وجادلهم بالتي هي احسن) وقال تعالي: (وافعلوا الخير)، وقال تعالي: (ولتكن منكم امة يدعون الي الخير) الاية فكانت الاستتابة فعل خير ودعاء الي سبيل ربنا بالحكمة والموعظة الحسنة ودعاء الي الخير وامرا بالمعروف ونهيا عن المنكر، فكان ذلك واجبا، وكان فاعله مصلحا.
 وقد صح عن رسول الله صلي الله عليه وسلم انه قال لعلي: لان يهدي الله بهداك رجلا واحدا خير لك من حمر النعم، قالوا: فهذا لا ينبغي ان يزهد فيه، قالوا: وقد فعله علي.
 وعثمان.
 وابن مسعود، وروي عن ابي بكر، وعمر بحضرة الصحابة رضي الله عنهم * قال ابو محمد رحمه الله: لا نعلم لهم حجة غير هذا اصلا فعارضهم من قال: لا استتيبه بان قالوا: بان الدعاء الي سبيل الله تعالي لا يخلو من ان يجب مرة او عددا محدودا او اكثر من مرة او ابدا ما امتد العمر بلا نهاية ولا سبيل الي قسم رابع قال.
 فان قلتم انه يجب ابدا ما امتد العمر بلا نهاية تركتم قولكم وصرتم الي قول من راي ان يستتاب المرتد ابدا ولا يقتل وهذا ليس هو قولكم ولو كان لكنا قد ابطلناه انفا، ولو كان هذا ايضا لبطل الجهاد جملة لان الدعاء كان يلزم ابدا مكررا بلا نهاية وهذا قول لا يقوله مسلم اصلا وليس دعاء المرتد  وهو احد الكفار  باوجب من دعاء غيره من اهل الكفر الحربيين فسقط هذا القول وبالله تعالي التوفيق *
 (وان قلتم) انه يجب عددا محدودا اكثر من مرة كنتم قاءلين بلا دليل وهذا باطل لقول الله تعالي.
 (قل هاتوا برهانكم ان كنتم صادقين) وليس قول من قال.
 يستتاب مرتين باولي ممن قال.
 ثلاثة ولا ممن قال اربعا او خمسا او اكثر من ذلك، وكل هذه الاقوال بلا برهان فسقط هذا القول بلا شك فلم يبق الا قول من قال.
 يدعي مرة فيقال له: ان من اسلم ثم ارتد قد تقدم دعاءه الي الاسلام حين اسلم بلا شك ان كان دخيلا في الاسلام او حين بلغ وعلم شراءع الدين هذا ما لا شك فيه وقد قلنا ان التكرار لا يلزم فالواجب اقامة الحد عليه اذ قد اتفقنا نحن وانتم علي وجوب  قتله ان لم يراجع الاسلام، فالاشتغال عن ذلك وتاخيره باستتابة ودعاء لا يلزمان ترك الاقامة عليه وهذا لا يجوز، قالوا.
 ونحن لم نمنع من دعاءه الي الاسلام في خلال ذلك دون تاخير لاقامة الحق عليه ولا تضييع له وانما كلامنا هل يجب دعاءه واستتابته فرضا ام لا؟ فهنا اختلفنا فاوجبتموه بلا برهان ولم نوجب نحن ولا منعنا * (فان قلتم): ندعوه مرة بعد الدعاء الاول السالف لم تكونوا باولي ممن قال.
 بل ادعوه مرة ثانية ايضا بعد هذه المرة، او ممن قال.
 بل الثالثة بعد الثانية، او ممن قال.
 بل الرابعة بعد الثالثة وهكذا ابدا فبطل بلا شك ما اوجبتم فرضا من استتابته مرة واحدة فاكثر، قال.
 واما قولكم فانه قد روي عن ابي بكر، وعمر، وصح عن عثمان، وعلي، وابن مسعود بحضرة الصحابة رضي الله عنهم فلا حجة لكم في هذا * اما الرواية عن ابي بكر فلا تصح لان الطريق في كلتي الروايتين عن ابن لهيعة وهو ساقط.
 واما الحكم في اهل الردة فهو امر مشهور نقل الكواف لا يقدر احد علي انكاره الا انه لا حجة لكم فيه لان اهل الردة كانوا قسمين، قسما لم يءمن قط كاصحاب مسيلمة.
 وسجاح فهءلاء حربيون لم يسلموا قط لا يختلف احد في انهم تقبل توبتهم واسلامهم والقسم الثاني قوم اسلموا ولم يكفروا بعد اسلامهم لكن منعوا الزكاة من ان يدفعوها الي ابي بكر رضي الله عنه فعلي هذا قوتلوا،
 ولا يختلف الحنيفيون.
 ولا الشافعيون في ان هءلاء ليس لهم حكم المرتد اصلا وهم قد خالفوا فعل ابي بكر فيهم ولا يسميهم اهل ردة، ودليل ما قلنا شعرا لحطيءة المشهور الذي يقول فيه: * اطعنا رسول الله ما كان بيننا * فيا لهفنا ما بال دين ابي بكر ايورثها بكرا اذا مات بعده * فتلك لعمر الله قاصمة الظهر وان التي طالبتم فمنعتم لكا * للنمر او احلي لدي من التمر فدا لبني بكر بن ذودان رحلي ونا * قتي عشية يحدي بالرماح ابو بكر فهو مقر برسول الله صلي الله عليه وسلم كما تري فقد يمكن ان يكون الاشعث من هءلاء وغيره وما يبعد ان يكون فيهم قوم ارتدوا جملة كمن امر بطليحة ونحو هءلاء الا ان هذا لا ينسند فلو صح لما كانت فيه حجة لان الخلاف في ذلك موجود بين الصحابة رضي الله عنهم ومن قال: بقتل المرتد ولا بد دون ذكر استتابة او قبولها كما اوردنا عن معاذ.
 وابي موسي وانس.
 وابن عباس.
 ومعقل بن مقرن، ومنهم من قال: بالاستتابة ابدا وايداع السجن فقط كما قد صح عن عمر مما قد اوردنا قبل ووجوب القتال هو حكم اخر غير وجوب القتل بعد القدرة فان قتال من بغي علي المسلم او منع حقا قبله وحارب دونه فرض واجب بلا خلاف ولا حجة في قتال ابي بكر رضي الله عنه اهل  الردة لانه حق بلا شك ولم نخالفكم في هذا ولا يصح اصلا عن ابي بكر انه ظفر بمرتد عن الاسلام غير ممتنع باستتابة فتاب فتركه او لم يتب فقتله هذا ما لا يجدونه، واما من بدل كفرا بكفر اخر * قال ابو محمد رحمه الله: اختلف الناس فيمن خرج من كفر الي كفر فقال ابو حنيفة، ومالك.
 واصحابهما، وابو ثور: انهم يقرون علي ذلك ولا يعترض عليهم وقال الشافعي، وابو سليمان، واصحابهما: لا يقرون علي ذلك اصلا، ثم اختلفوا فقالت طاءفة من اصحاب الشافعي.
 ينبذ اليه عهده ويخرج الي دار الحرب فان ظفر به بعد
 ذلك فمرة قال.
 ان رجع الي دينه الكتابي الذي خرج منه اقر علي حربيته وترك، ومرة قال: لا يترك بل لا يقبل منه الا الاسلام او السيف.
 وبهذا يقول اصحابنا.
 الا انهم لا يرون الحاقه بدار الحرب بل يجبر علي الاسلام والا قتل * قال ابو محمد رحمه الله: فلما اختلفوا نظرنا في ذلك فوجدنا من قال.
 انهم يقرون علي ذلك يحتجون بقول الله تعالي.
 (والذين كفروا بعضهم اولياء بعض) وامره تعالي ان يقول مخاطبا لجميع الكفار.
 (قل يا ايها الكافرون لا اعبد ما تعبدون ولا انتم عابدون ما اعبد) الي اخر السورة قالوا.
 فجعل الله تعالي الكفر كله دينا واحدا قالوا.
 وقد قال الله تعالي.
 (لا اكراه في الدين) فكان هذا ظاهرا يمنع من اكراهه علي ترك كفره قالوا.
 ولا يخلوا اذا اجبر علي ترك الكفر الذي خرج اليه من احد وجهين ولا ثالث لهما، اما ان يجبر علي الرجوع الي دينه الذي خرج عنه كما قال الشافعي في احد قوليه.
 ، او يجبر علي الرجوع الي الاسلام كما قال هو في قوله الثاني، واصحابكم.
 فان اجبر علي الرجوع الي دينه فقد اجبر علي اعتقاد الكفر وعلي الرجوع الي الكفر، قالوا.
 واعتقاد جواز هذا كفر، قالوا.
 وان اكره علي الرجوع الي الاسلام فكيف يجوز ان يجبر علي ذلك دون ساءر اهل الكفر من اهل الذمة ولا فرق بينه وبينهم فهو كافر وهم كفار ولا فرق * قال ابو محمد رحمه الله: وهذا كل ما شغبوا به من النصوص الا ان بعضهم قال: ارايت من احدث في نصرانية.
 او يهودية.
 او مجوسية رايا لم يخرج به عن جملتهم اتجبرونه علي ترك ذلك الراي والرجوع الي جملتهم او الي الاسلام؟ وارايتم من خرج من ملكية الي نسطورية.
 او يعقوبية.
 او قادونية.
 او معدونية فدان بعبودية المسيح وانه نبي الله وان الله تعالي وحده لا شريك له؟ اتجبرونه علي الرجوع الي التثليث، او الي الرجوع الي القول بان الله هو المسيح بن مريم؟، وكذلك من خرج من ربانية الي عامانية،  او الي عيسونية اتجبرونه علي الرجوع عن الايمان بمحمد صلي الله عليه وسلم الي الكفر؟ * قال ابو محمد رحمه الله: هذا كل ما موهوا به من التشنيع وكل هذا عاءد عليهم علي ما نبين ان شاء الله تعالي، اما قول الله تعالي، (والذين كفروا بعضهم اولياء بعض) فحق ولا حجة لهم فيه لانه ليس فيه الا انهم كلهم اولياء بعضهم لبعض فقط وليس في هذه الاية حكم اقرارهم، ولا حكم قتلهم، ولا حكم ما يفعل بهم في شء من امور بهم اصلا، وكذلك قوله تعالي.
 (قل يا ايها الكافرون) الي اخرها ليس فيها ايضا الا اننا مباينون لجميع الكفار في العبادة والدين وليس في هذه السورة شء من احكامهم.
 لا من اقرارهم ولا من ترك اقرارهم، وقد قال الله تعالي مخاطبا لنا: (ومن يتولهم منكم فانه منهم) فمن تولاهم منا فهو منهم كما قال تعالي: ان بعضهم اولياء بعض فهلا تركوا المرتد اليهم منا علي ردته؟ باخبار الله تعالي انه منهم فان لم تكن هذه الاية حجة في اقرار المرتد منا اليهم علي ذلك فذانك النصان ليسا بحجة فيما ارادوا التمويه بايرادهما من ان الخارج منهم من كفر الي كفر يقر علي ذلك وبالله تعالي التوفيق * قال ابو محمد رحمه الله: واما قول الله تعالي: (لا اكراه في الدين) فلا حجة لهم فيه لانه لم يختلف احد من الامة كلها في ان هذه الاية ليست علي ظاهرها لان الامة مجمعة علي اكراه المرتد عن دينه.
 فمن قاءل يكره ولا يقتل، ومن قاءل يكره ويقتل * (قان قالوا): خرج المرتد منا بدليل اخر عن حكم هذه الاية قلنا لهم وكذلك ان خرج المرتد منهم من فر الي كفر بدليل اخر عن حكم هذه الاية والا فهو كما قلتم: وان المحتجين بقول الله تعالي: (والذين كفروا بعضهم اولياء بعض) وبقول الله تعالي.
 (لكم دينكم ولي دين) في ان الكفر كله ملة واحدة وشء واحد هم اول من نقض الاحتجاج وخالفه وفرقوا بين احكام اهل الكفر فكلهم مجمع معنا علي ان من اهل الكفر من تنكح نساءهم وتءكل ذباءحهم وان منهم من لا تنكح نساءهم ولا تءكل ذباءحهم * قال ابو محمد رحمه الله: واما قولهم: لا يخلو من اجبر علي ترك الكفر الذي خرج اليه
 من احد وجهين.
 اما ان يجبر علي الرجوع الي الكفر الذي خرج منه، واما ان يجبر علي الاسلام فنعم انه لا يخلو من احدهما والذي نقول به فانه يجبر علي الرجوع الي الاسلام ولا بد ولا يترك يرجع الي الدين الذي خرج منه (واما قولهم).
 كيف يجوز ان يجبر علي الاسلام مع ما ذكرنا فجوابنا وبالله تعالي التوفيق انه ان لم يقم برهان من القران والسنة علي وجوب اجباره والا فهو قولكم * قال ابو محمد رحمه الله: وكذلك قولهم: ان خرج من فرقة من النصاري الي فرقة  اخري فاننا لا نعترض عليهم علي ما نبينه بعد ان شاء الله تعالي، فبقي الان الكلام في احتجاجهم بقول الله تعالي.
 (لا اكراه في الدين) فوجدنا الناس علي قولين، احدهما انها منسوخة، والثاني انها مخصوصة، فاما من قال انها منسوخة فيحتج بان رسول الله صلي الله عليه وسلم لم يقبل من الوثنين فيقال لهم.
 وبالله تعالي التوفيق لم يختلف مسلمان في ان رسول الله صلي الله عليه وسلم لم يقبل من الوثنيين من العرب الا الاسلام او السيف الي ان مات عليه السلام فهو اكراه في الدين فهذه الاية منسوخة، واما من قال انها مخصوصة فانهم قالوا.
 انما نزلت في اليهود والنصاري خاصة كما روي عن عمر بن الخطاب انه قال لعجوز نصرانية ايتها العجوز اسلمي تسلمي ان الله تعالي بعث الينا محمدا صلي الله عليه وسلم بالحق فقالت العجوز وانا عجوز كبيرة واموت الي قريب قال عمر.
 اللهم اشهد لا اكراه في الدين، وبما روينا عن ابن عباس قال.
 كانت المراة تجعل علي نفسها ان عاش ولدها تهوده فلما اجليت بنو النضير كان فيهم من ابناء الانصار فقالت الانصار.
 لا ندع ابناءنا فانزل الله تعالي (لا اكراه في الدين) فقد صح ان رسول الله صلي الله عليه وسلم قد قاتل الكفار الي ان مات عليه السلام حتي اسلم من اسلم منهم، وصح عنه الاكراه في الدين ثم نزل بعد ذلك (فاذا انسلخ الاشهر الحرم فاقتلوا المشركين حيث وجدتموهم) الاية الي قوله تعالي.
 (فخلوا سبيلهم) ونزل قوله تعالي.
 (قاتلوا الذين لا يءمنون بالله ولا باليوم الاخر) الي قوله تعالي.
 (حتي يعطوا الجزية عن يد وهم صاغرون) فان قال قاءل: فاين
 انتم من قوله تعالي.
 (فانبذوا اليهم علي سواء) فيقال لهم.
 لا يختلف اثنان في ان هذه الاية نزلت قبل نزول براءة فاذ ذلك كذلك فان براءة نسخت كل حكم تقدم وابطلت كل عهد سلف بقوله تعالي: (كيف يكون للمشركين عهد عند الله وعند رسوله الا الذين عاهدتم عند المسجد الحرام) وانما كانت اية النبذ علي سواء ايام كانت المهادنات جاءزة.
 واما بعد نزول (فاذا انسلخ الاشهر الحرم فاقتلوا المشركين حيث وجدتموهم) فلا يحل ترك مشرك اصلا الا بان يقتل او يسلم او ينبذ اليه عهده بعد التمكن من قتله حيث وجد الا ان يكون من ابناء الذين اوتوا الكتاب فيقر علي الجزية والصغار كما امر الله تعالي او يكون مستجيرا فيجار حتي يقرا عليه القران ثم يرد الي مامنه ولا بد الي ان يسلم ولا يترك اكثر من ذلك او رسولا فيترك مدة اداء رسالته واخذ جوابه ثم يرد الي بلده وما عدا هءلاء فالقتل ولا بد او الاسلام كما امر الله تعالي في نص القران وما صح عن رسول الله صلي الله عليه وسلم، فان ذكروا ما نا حمام نا عبد الله بن محمد بن علي الباجي نا احمد بن خالد نا عبيد الله بن محمد الكشوري نا محمد بن يوسف الحذافي نا عبد الرزاق نا ابن جريج قال: جديث رفع الي علي في يهودي تزندق ونصراني نزندق قال.
 دعوه يحول من دين الي دين *

 قال ابو محمد رحمه الله: هذا لم يصح عن علي لانه منقطع ولم يولد ابن جريج الا بعد نحو نيف وثلاثين عاما من موت علي بن ابي طالب رضي الله عنه، ولا حجة في احد بعد رسول الله صلي الله عليه وسلم وكم من قولة لعلي صحيحة قد خالفوها وبالله تعالي التوفيق *   مسالة  ميراث المرتد، قال ابو محمد رحمه الله: اختلف الناس في ميراثه فقالت طاءفة.
 هو لورثته من المسلمين كما نا محمد بن سعيد بن نبات نا احمد ابن عبد البصير نا قاسم بن اصبغ نا محمد بن عبد السلام الخشني نا محمد بن المثني نا موسي بن مسعود ابو حذيفة نا سفيان عن سماك بن حرب عن دثار بن يزيد بن عبيد بن الابرص الاسدي ان علي بن ابي طالب قال: ميراث المرتد لولده * وعن الاعمش عن الشيباني
 قال: اتي علي بن ابي طالب بشيخ كان نصرانيا فاسلم ثم ارتد عن الاسلام فقال له علي: لعلك انما ارتددت لان تصيب ميراثا ثم ترجع الي الاسلام قال: لا قال: فلعلك خطبت امراة فابوا ان يزوجوكها فاردت ان تزوجها ثم تعود الي الاسلام قال: لا قال: فارجع الي الاسلام قال.
 لا حتي القي المسيح فامر به فضربت عنقه فدفع ميراثه الي ولده من المسلمين * وعن ابن مسعود بمثله، وقالت طاءفة.
 بهذا منهم الليث بن سعد.
 واسحق بن راهوية، وقال الاوزاعي: ان قتل في ارض الاسلام فما له لورثته من المسلمين، وقالت طاءفة: ان كان له وارث علي دينه فهو احق به والا فماله لورثته من المسلمين كما روينا من طريق عبد الرزاق عن اسحق بن راشد ان عمر بن عبد العزيز كتب في رجل من المسلمين اسر فتنصر اذا علم ذلك ترث منه امراته وتعتد ثلاثة قروء ودفع ماله الي ورثته من المسلمين لا اعلمه قال.
 الا ان يكون له وارث علي دينه في ارض فهو احق به، وقالت طاءفة: ميراثه لاهل دينه فقط كما روينا من طريق عبد الرزاق انا معمر عن قتادة قال: ميراث المرتد لاهل دين، قال عبد الرزاق.
 انبانا ابن جريج قال.
 الناس فريقان.
 منهم من يقول.
 ميراث المرتد للمسلمين لانه ساعة يكفر يوقف فلا يقدر منه علي شء حتي ينظر ايسلم ام يكفر؟ منهم النخعي.
 والشعبي.
 والحكم بن عتيبة، وفريق يقول.
 لاهل دينه، وقالت طاءفة.
 ان راجع الاسلام فماله له وان قتل فماله لبيت مال المسلمين لا لورثته من الكفار قال بهذا ربيعة.
 ومالك.
 وابن ابي ليلي.
 والشافعي، وقالت طاءفة ان راجع الاسلام فماله له وان قتل فماله لورثته من الكفار، قال بهذا ابو سليمان.
 واصحابنا.
 وقال ابو حنيفة واصحابه.
 ان قتل المرتد فماله لورثته من المسلمين وترثه زوجته كساءر ورثته وان فر ولحق بارض الحرب وترك ماله عندنا فان القاضي يقضي بذلك ويعتق امهات اولاده  ومدبره ويقسم ماله بين ورثته من المسلمين علي كتاب الله تعالي، فان جاء مسلما اخذ
 من ماله ما وجد في ايدي ورثته ولا ضمان عليهم فيما استهلكوه، هذا فيما كان بيده قبل الردة، واما ما اكتسبه في حال ردته ثم قتل او مات فهو في، للمسلمين، وقالت طاءفة.
 مال المرتد ساعة يرتد لجميع المسلمين قتل او مات او لحق بارض الحرب او راجع الاسلام كل ذلك سواء وهو قول بعض اصحاب مالك: ذكر ذلك ابن شعبان عنه.
 واشهب * قال ابو محمد رحمه الله.
 فلما اختلفوا نظرنا في ذلك فكان الثابت عن رسول الله صلي الله عليه وسلم من انه لا يرث المسلم الكافر مانعا من توريث ولد المرتد وهم مسلمون مال ابيهم المرتد لانه كافر وهم مسلمون * نا بهذا الحديث جماعة ومن جملتهم ما ناه عبد الله بن ربيع نا محمد بن اسحق بن السليم نا ابن الاعرابي نا ابو داود نا مسدد نا سفيان عن الزهري عن علي بن الحسين عن عمرو بن عثمان بن عفان عن اسامة بن زيد عن النبي صلي الله عليه وسلم قال.
 " لا يرث المسلم الكافر ولا الكافر المسلم " وهذا عموم منه عليه السلام لم يخص منه مرتد من غيره (وما كان ربك نسيا)، ولو اراد الله ان يخص المرتد من ذلك لما اغفله ولا اهمله بل قد حض الله تعالي علي ان المرتد من جملة الكفار بقوله تعالي.
 (ومن يتولهم منكم فانه منهم) فسقط هذا القول جملة وبالله تعالي التوفيق *   مسالة وصية المرتد وتدبيره، قال ابو محمد.
 كل وصية اوصي بها قبل ردته او في حين ردته بما يوافق البر ودين الاسلام فكل ذلك نافذ في ماله الذي لم يقدر عليه حتي قتل لانه ماله وحكمه نافذ فاذا قتل او مات فقد وجبت فيه وصاياه بموته قبل ان يقدر علي ذلك المال، واما اذا قدرنا عليه قبل موته من عبد وذمي او مال فهو للمسلمين كله لا تنفذ فيه وصية لانه اذا وجبت الوصية بموته لم يكن ذلك المال له بعد ولا تنفذ وصية احد فيما لا يملكه *   مسالة  من صار مختارا الي ارض الحرب مشاقا للمسلمين امرتد
 هو بذلك ام لا؟ ومن اعتضد باهل الحرب علي اهل الاسلام وان لم يفارق دار الاسلام امرتد هو بذلك ام لا؟ * قال ابو محمد نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن قدامة عن جرير عن مغيرة عن الشعبي قال.
 كان جرير يحدث عن النبي صلي الله عليه وسلم اذا ابق العبد لم تقبل له صلاة وان مات مات كافرا فابق غلام لجرير فاخذه فضرب عنقه * وبه الي احمد بن شعيب انا قتيبة نا حميد بن  عبد الرحمن عن ابيه عن ابي اسحاق عن الشعبي عن جرير بن عبد الله البجلي قال: قال رسول الله صلي الله عليه وسلم.
 " اذا ابق العبد الي الشرك فقد حل دمه " * ومن طريق مسلم نا علي بن حجر السعدي نا اسماعيل  يعني ابن علية  عن منصور بن عبد الرحمن عن الشعبي عن جرير انه سمعه يقول.
 ايما عبد ابق من مواليه فقد كفر حتي يرجع اليهم قال منصور.
 قد والله روي عن النبي صلي الله عليه وسلم ولكن اكره ان يروي عني ههنا بالبصرة * حدثنا عبد الله بن ربيع نا محمد بن اسحاق نا ابن الاعرابي نا ابو داود نا هناد بن السري نا ابو معاوية  هو ابن ابي حازم الضرير  عن اسماعيل بن ابي خالد عن قيس بن ابي حازم عن جرير بن عبد الله البجلي قال: " بعث رسول الله صلي الله عليه وسلم سرية الي خثعم فاعتصم ناس منهم بالسجود فاسرع فيهم القتل فبلغ ذلك النبي صلي الله عليه وسلم فامر لهم بنصف العقل وقال: انا برء من كل مسلم يقيم بين اظهر المشركين قالوا.
 يا رسول الله لا تتراءي ناراهما " * قال ابو محمد رحمه الله.
 حديث الشعبي عن جرير الذي قدمنا هو من طريق منصور ابن عبد الرحمن عن الشعبي موقوف علي جرير فلا وجه للاشتغال به، وهو من طريق مغيرة عن الشعبي مسند الا ان فيه ان العبد باقامته يكون كافرا فظاهره في المملوك لان الحر لا يوصف باباق في المعهود لكن رواية ابي اسحاق عن الشعبي في هذا الخبر بيان انه في الحر والمملوك وبيان الاباق الذي يكفر به وهو اباقه الي ارض الشرك والعبد
 واقع علي كل احد لان كل احد عبد الله تعالي كما روينا من طريق مسلم نا اسحاق بن ابراهيم الحنظلي انا سفيان بن عيينة عن العلاء بن عبد الرحمن عن ابيه عن ابي هريرة " سمعت النبي صلي الله عليه وسلم يقول.
 قال الله تعالي: قسمت الصلاة بيني وبين عبدي نصفين ولعبدي ما سال فاذا قال العبد الحمد لله رب العالمين قال الله حمدني عبدي " فقوله تعالي: اذا قال العبد عني به الحر والمملوك بلا شك والاباق مطلق علي الحر ايضا قال الله تعالي (اذ ابق الي الفلك المشحون) فاخبر تعالي عن رسوله الحر يونس بن متي صلي الله عليه وسلم انه ابق اذ خرج مغاضبا لامر ربه تعالي وقد علمنا ان من خرج عن دار الاسلام الي دار الحرب فقد ابق عن الله تعالي.
 وعن امام المسلمين وجماعتهم ويبين هذا حديثه صلي الله عليه وسلم انه برء من كل مسلم يقيم بين اظهر المشركين وهو عليه السلام لا يبرا الا من كافر قال الله تعالي: (المءمنون والمءمنات بعضهم اولياء بعض) * قال ابو محمد رحمه الله.
 فصح بهذا ان من لحق بدار الكفر والحرب مختارا محاربا لمن يليه من المسلمين فهو بهذا الفعل مرتد له احكام المرتد كلها من وجوب القتل عليه  متي قدر عليه ومن اباحة ماله وانفساح نكاحه وغير ذلك لان رسول الله صلي الله عليه وسلم لم يبرا من مسلم، واما من فر الي ارض الحرب لظلم خافه ولم يحارب المسلمين ولا اعانهم عليهم ولم يجد في المسلمين من يجيره فهذا لا شء عليه لانه مضطر مكره، وقد ذكرنا ان الزهري محمد بن مسلم بن شهاب كان عازما علي انه ان مات هشام بن عبد الملك لحق بارض الروم لان الوليد بن يزيد كان نذر دمه ان قدر عليه وهو كان الوالي بعد هشام فمن كان هكذا فهو معذور، وكذلك من سكن بارض الهند والسند والصين والترك والسودان والروم من المسلمين فان كان لا يقدر علي الخروج من هنالك لثقل ظهر او لقلة مال او لضعف جسم او لامتناع طريق فهو معذور، فان كان هنالك محاربا للمسلمين معينا للكفار بخدمة او كتابة فهو كافر وان كان انما يقيم هنالك لدنيا يصيبها وهو كالذمي
 لهم وهو قادر علي اللحاق بجمهرة المسلمين وارضهم فما يبعد عن الكفر وما نري له عذرا ونسال الله العافية، وليس كذلك من سكن في طاعة اهل الكفر من الغالية ومن جري مجراهم لان ارض مصر والقيروان وغيرهما فالاسلام هو الظاهر وولاتهم علي كل ذلك لا يجاهرون بالبراءة من الاسلام بل الي الاسلام ينتمون وان كانوا في حقيقة امرهم كفارا، واما من سكن في ارض القرامطة مختارا فكافر بلا شك لانهم معلنون بالكفر وترك الاسلام ونعوذ بالله من ذلك، واما من سكن في بلد تظهر فيه بعض الاهواء المخرجة الي الكفر فهو ليس بكافر لان اسم الاسلام هو الظاهر هنالك علي كل حال من التوحيد والاقرار برسالة محمد صلي الله عليه وسلم والبراءة من كل دين غير الاسلام واقامة الصلاة وصيام رمضان وساءر الشراءع التي هي الاسلام والايمان والحمد لله رب العالمين، وقول رسول الله صلي الله عليه وسلم " انا برء من كل مسلم اقام بين اظهر المشركين " يبين ما قلناه وانه عليه السلام انما عني بذلك دار الحرب والا فقد استعمل عليه السلام عماله علي خيبر وهم كلهم يهود، واذا كان اهل الذمة في مداءنهم لا يماذجهم غيرهم فلا يماذجهم غيرهم فلا يسمي الساكن فيهم لامارة عليهم او لتجارة بينهم كافرا ولا مسيءا بل هو مسلم محسن ودارهم دار اسلام لا دار شرك لان الدار انما تنسب للغالب عليها والحاكم فيها والمالك لها، ولو ان كافرا مجاهدا غلب علي دار من دور الاسلام واقر المسلمين بها علي حالهم الا انه هو المالك لها المنفرد بنفسه في ضبطها وهو معلن بدين غير الاسلام لكفر بالبقاء معه كل من عاونه واقام معه وان ادعي انه مسلم لما ذكرنا، واما من حملته الحمية من اهل الثغر من المسلمين فاستعان بالمشركين الحربيين واطلق ايديهم علي قتل من خالفه من المسلمين او علي اخذ اموالهم او سبيهم فان كانت يده هي الغالبة  وكان الكفار له كاتباع فهو هالك في غاية الفسوق ولا يكون بذلك كافرا لانه لم يات شيءا اوجب به عليه كفرا قران او اجماع وان كان حكم الكفار جاريا عليه فهو بذلك كافر
 علي ما ذكرنا فان كانا متساويين لا يجري حكم احدهما علي الاخر فما نراه بذلك كافرا والله اعلم، وانما الكافر الذي برء منه رسول الله صلي الله عليه وسلم هو المقيم بين اظهر المشركين وبالله تعالي التوفيق *  مسالة  من المنافقين، والمرتدين قال قوم: ان رسول الله صلي الله عليه وسلم قد عرف المنافقين وعرف انهم مرتدون كفروا بعد اسلامهم وواجهه رجل بالتجوير وانه يقسم قسمة لا يراد بها وجه الله وهذه ردة صحيحة فلم يقتله قالوا: فصح انه لا قتل علي مرتد ولو كان عليه قتل لانفذ ذلك رسول الله صلي الله عليه وسلم علي المنافقين المرتدين الذين قال الله تعالي فيهم: (اذا جاءك المنافقون) القوله تعالي: (فهم لا يفقهون) * قال ابو محمد: هذا كل ما احتجوا به ونحن ان شاء الله تعالي ذاكرون كل اية تعلق بها متعلق في ان رسول الله صلي الله عليه وسلم عرف المنافقين باعيانهم، ومبينون بعون الله تعالي وتاييده انهم قسمان، قسم لم يعرفهم قط عليه السلام، وقسم اخر افتضحوا فعرفهم فلا ذوا بالتوبة ولم يعرفهم عليه السلام انهم كاذبون او صادقون في توبتهم فقط، فاذا بينا هذا بعون الله تعالي بطل قول: من احتج بامر المنافقين في انه لا قتل علي مرتد وبقي قول: من راي القتل بالتوبة، واما انه لا يسقط بالتوبة والبرهان علي الصحيح من ذلك، فنقول وبالله تعالي التوفيق، قال الله تعالي: (ومن الناس من يقول امنا بالله وباليوم الاخر) الي قوله تعالي: (فما ربحت تجارتهم وما كانوا مهتدين) فهذه اول اية في القران فيها ذكر المنافقين وليس في شء منها دليل علي ان رسول الله صلي الله عليه وسلم عرفهم ولا علي انه لم يعرفهم فلا متعلق فيها لاحد من اهل القولين المذكورين: قال الله تعالي: (يا ايها الذين امنوا لا تتخذوا بطانة من دونكم) الي قوله تعالي: (ان الله بما تعملون محيط) ففي هذه الاية دليل علي ان هءلاء القوم ممكن ان يكونوا معروفين لان الله تعالي اخبرنا انهم من غيرنا بقوله تعالي: (من دونكم) فاذ هم من غيرنا فممكن ان يكونوا من اليهود مكشوفين، وممكن ان يكون قوله تعالي عنهم: (انهم قالوا امنا) اي بما عندهم، وقد يمكن ايضا ان يكونوا من المنافقين
 المظهرين للاسلام، وممكن ان الله تعالي امرهم ان لانتخذهم بطانة اذا اطلعنا منهم علي هذا، والوجه الاول اظهر واقوي لظاهر الاية واذ كلتا هما ممكن فلا متعلق في هذه الاية لمن ذهب ان رسول الله صلي الله عليه وسلم كان يعرف المنافقين باعيانهم ويدري ان باطنهم النفاق وقال تعالي.
 (الم تر الي الذين يزعمون انهم) الي قوله تعالي.
 (حتي يحكموك فيما  شجر بينهم) وصح عن رسول الله صلي الله عليه وسلم " ثلاث من كن فيه كان منافقا خالصا " في كتاب مسلم وغيره " اذا حدث كذب واذا وعد اخلف واذا اءتمن خان وان صام وصلي وزعم انه مسلم " * ومن طريق مسلم ايضا نا ابو بكر بن ابي شيبة، ومحمد بن عبد الله ابن نمير قالا جميعا: نا عبد الله بن نمير نا الاعمش عن عبد الله بن مرة عن مسروق عن عبد الله بن عمرو بن العاص قال: قال رسول الله صلي الله عليه وسلم: " اربع من كن فيه كان منافقا خالصا ومن كانت فيه خلة منهن كانت فيه خلة من نفاق حتي يدعها اذا حدث كذب واذا وعد اخلف واذا عاهد غدر واذا خاصم فجر " فقد صح ان ههنا نفاقا لا يكون صاحبه كافرا، ونفاقا يكون صاحبه كافرا فيمكن ان يكون هءلاء الذين ارادوا التحاكم الي الطاغوت لا الي النبي صلي الله عليه وسلم مظهرين لطاعة رسول الله صلي الله عليه وسلم عصاة بطلب الرجوع في الحكم الي غيره معتقدين لصحة ذلك لكن رغبة في اتباع الهوي فلم يكونوا بذلك كفارا بل عصاة فنحن نجد هذا عيانا عندنا فقد ندعو نحن عند الحاكم الي القران والي سنة رسول الله صلي الله عليه وسلم الثابت عنهم باقرارهم فيابون ذلك ويرضون براي ابي حنيفة ومالك.
 والشافعي هذا امر لا ينكره احد فلا يكونون بذلك كفارا، فقد يكون اولءك هكذا حتي اذا بين الله تعالي انهم لا يءمنون حتي يحكموا رسول الله صلي الله عليه وسلم فيما شجر بينهم وجب ان من وقف علي هذا قديما وحديثا والي يوم القيامة فابي وعند فهو كافر وليس في الاية ان اولءك عندوا بعد نزول هذه الاية فاذ لا بيان فيها فلا حجة فيها لمن يقول: ان رسول الله صلي الله عليه وسلم عرفهم انهم منافقون واقرهم، وقال تعالي: (ويقولون
 طاعة فاذا برزوا من عندك بيت طاءفة) الي قوله تعالي: (وكيلا) فهذا ليس فيه نص علي انهم كانوا يظهرون الايمان بل لعلهم كانوا كفارا معلنين، وكانوا يلتزمون الطاعة بالمسالمة فاذ لا نص فيها فلا حجة فيها لمن ادعي انه عليه السلام كان يعرفهم ويدري ان عقدهم النفاق، وقال تعالي: (فما لكم في المنافقين فءتين) الي قوله.
 (واولءكم جعلنا لكم عليهم سلطانا مبينا)، وقد روينا من طريق البخاري نا ابو الوليد  هو الطيالسي  نا شعبة عن عدي بن ثابت قال: سمعت عبد الله بن يزيد يحدث عن زيد بن ثابت قال.
 لما خرج رسول الله صلي الله عليه وسلم الي احد رجع ناس ممن خرج معه وكان اصحاب رسول الله صلي الله عليه وسلم فرقتين، فرقة تقول.
 نقاتلهم، وفرقة تقول.
 لا نقاتلهم فنزلت (فما لكم في المنافقين فءتين) فهذا اسناد صحيح، وقد سمي الله تعالي اولءك منافقين، واما قوله تعالي في هذه الاية متصلا بذلك (ودوا لو تكفرون كما كفروا فتكونون سواء) الي قوله تعالي: (فما جعل الله لكم عليهم سبيلا) فقد كان يمكن ان يظن انه تعالي عني بذلك اولءك  المنافقين وهو كان الاظهر لولا قوله تعالي.
 (فلا تتخذوا منهم اولياء حتي يهاجروا في سبيل الله) فهذا يوضح غاية الايضاح انه ابتداء حكم في قوم اخرين غير اولءك المنافقين لان اولءك كانوا من سكان المدينة بلا شك وليس علي سكان المدينة هجرة بل الهجرة كانت الي دارهم، فاذا كان ذلك كذلك فحكم الاية كلها انها في قوم كفار لم يءمنوا بعد وادعوا انهم امنوا ولم يهاجروا، وكان الحكم حينءذ ان من امن ولم يهاجر لم ينتفع بايمانه وكان كافرا كساءر الكفار ولا فرق حتي يهاجر الا من ابيح له سكني بلده كمن بارض الحبشة والبحرين وساءر من ابيح له سكني ارضه الا المستضعفين قال الله تعالي.
 (والذين امنوا ولم يهاجروا مالكم من ولايتهم من شء حتي يهاجروا) وقد قال تعالي.
 (المءمنون بعضهم اولياء بعض) فقد قطع الله تعالي الولاية بيننا وبينهم فليسوا مءمنين وقال تعالي.
 (الذين تتوفاهم الملاءكة ظالمي انفسهم قالوا
 فيم كنتم) الي قوله (الا المستضعفين) الاية فان قال قاءل.
 معني حتي يهاجروا في سبيل الله اي حتي يجاهدوا معكم بخلاف فعلهم حين انصرفوا عن احد وارادوا ان يجعلوا الاية كلها في المنافقين المنصرفين عن احد قيل له وبالله تعالي التوفيق، هذا ممكن ولكن قد قال تعالي.
 (فخذوهم واقتلوهم حيث وجدتموهم) فاخبرونا هل فعل ذلك النبي عليه السلام فقتل الراجعين عن احد حيث وجدهم؟ وهل اخذهم ام لا؟ * (فان قالوا): قد فعل ذلك كذبوا كذبا لا يخفي علي احد وما عند مسلم شك في انه عليه السلام لم يقتل منهم احدا ولا نبذ العهد الي احد منهم (وان قالوا).
 لم يفعل ذلك عليه السلام ولا المءمنون (قيل لهم).
 صدقتم ولا يحل لمسلم ان يظن ان النبي عليه السلام خالف امر ربه فامره تعالي ان تولوا بقتلهم حيث وجدهم وباخذهم فلم يفعل وهذا كفر ممن ظنه بلا شك (فان قالوا).
 لم يتولوا بل تابوا ورجعوا وجاهدوا قيل لهم فقد سقط حكم النفاق عنهم بلا شك وحصل لهم حكم الاسلام بظاهر الاية بلا شك فقد بطل تعلقهم بهذه الاية جملة في انه عليه السلام كان يعرف المنافقين ولكن في قوله تعالي.
 (الا الذين يصلون الي قوم بينكم وبينهم ميثاق او جاءوكم حصرت صدورهم) الي قوله تعالي.
 (فما جعل الله لكم عليهم سبيلا) بيان جلي بان هءلاء لم يكونوا قط من الاوس ولا من الخزرج لانهم لم يكن لهم قوم محاربون للنبي عليه السلام ولا نسبوا قط الي قوم معاهدين النبي عليه السلام بميثاق معقود هذا مع قوله تعالي.
 (فان اعتزلوكم فلم يقاتلوكم) الي قوله تعالي.
 (سبيلا) فان هذا بيان جلي علي انهم من غير الانصار ومن غير المنافقين لكن من الكفار المجاهرين بالكفر الا ان يقول قاءل.
 ان قوله تعالي.
 (الا الذين  يصلون الي قوم بينكم وبينهم ميثاق) استثناء منقطع مما قبله في قوله.
 (اخرين) وعلي كل حال فقد سقط حكم النفاق علي اولءك ان كان هكذا.
 (فان قيل).
 فان كان الامر كما قلتم ان في قوله تعالي.
 (ودوا لو تكفرون كما كفروا فتكونون سواء) انه في قوم
 من الكفار غير اولءك فحسبنا انه تعالي قد سمي اولءك الراجعين منافقين فصاروا معروفين قيل له وبالله تعالي التوفيق، قد قلنا ان النفاق قسمان قسم لمن يظهر الكفر ويبطن الايمان وقسم لمن يظهر غير ما يصر فما سوي الدين ولا يكون بذلك كافرا، وقد قيل لابن عمر.
 انا ندخل علي الامام فيقضي بالقضاء فنراه جورا فنمسك فقال.
 انا معشر اصحاب رسول الله صلي الله عليه وسلم نعد هذا نفاقا فلا ندري ما تعدونه انتم وقد ذكرنا قبل قول رسول الله صلي الله عليه وسلم.
 " ثلاث من كن فيه كان منافقا خالصا وان صلي وان صام وقال اني مسلم " فاذ الامر كذلك فلا يجوز ان نقطع عليهم بالكفر الذي هو ضد الاسلام الا بنص ولكنا نقطع عليهم بما قطع الله تعالي به من اسم النفاق والضلالة والاركاس وخلاف الهدي ولا نزيد ولا نتعدي ما نص الله تعالي عليه باراءنا وبالله تعالي التوفيق، وقال الله تعالي.
 (بشر المنافقين بان لهم عذابا اليما) الي قوله.
 (اجرا عظيما) * قال ابو محمد.
 اما هءلاء فمنافقون النفاق الذي هو الكفر فلا شك لنصه تعالي علي انهم مذبذبون لا الي المءمنين ولا الي المجاهرين بالكفر في نار جهنم وانهم اشد عذابا من الكفار بكونهم في الدرك الاسفل من النار ولكن ليس في شء من هذه الايات كلها انه عليه السلام عرفهم باعيانهم وعرف نفاقهم اذ لا دليل علي ذلك فلا حجة فيها لمن ادعي انه عليه السلام عرفهم وعرف نفاقهم، ثم لو كان ذلك لكان قوله تعالي.
 (ان المنافقين في الدرك الاسفل من النار) الي قوله تعالي.
 (اجرا عظيما) موجبا لقبول توبتهم اذا تابوا وهم قد اظهروا التوبة والندم والاقرار بالايمان بلا شك فبطل عنهم بهذا حكم النفاق جملة في الدنيا وبقي باطن امرهم الي الله تعالي، وهذه الاية تقضي علي كل اية فيها نص بانه عليه السلام عرف منافقا بعينه وعرف نفاقه قال الله تعالي: (يا ايها الذين امنوا لا تتخذوا اليهود والنصاري بعضهم) الي قوله تعالي.
 (فاصبحوا خاسرين) * قال ابو محمد رحمه الله: فاخبر الله تعالي عن قوم يسارعون في الذين كفروا
 حذرا ان تصيبهم داءرة واخبر تعالي عن الذين امنوا انهم يقولون للكافرين: (اهءلاء الذين اقسموا بالله جهد ايمانهم انهم لمعكم) يعنون الذين يسارعون فيهم قال الله تعالي: (حبطت اعمالهم فاصبحوا خاسرين) فهذا لا يكون الا خبرا عن قوم اظهروا  الميل الي الكفار فكانوا منهم كفارا خاءبي الاعمال ولا يكونون في الاغلب الا معروفين لكن قوله تعالي: (فيصبحوا علي ما اسروا في انفسهم نادمين) دليل علي ندامتهم علي ما سلف منهم وان التوبة لهم معرضة علي ما في الاية التي ذكرنا قبل هذه، وبالله تعالي التوفيق * وقال تعالي: (واعدوا لهم ما استطعتم من قوة) الي قوله تعالي: (لا تعلمهم نحن نعلمهم) * قال ابو محمد: فهذه في المنافقين بلا شك، وقد نص الله تعالي علي ان المسلمين لا يعلمونهم ورسول الله صلي الله عليه وسلم مخاطب بهذا الخطاب مع المسلمين بلاشك فهو لا يعلمهم، والله تعالي يعلمهم، وقال تعالي: (لو كان عرضا قريبا وسفر قاصدا لاتبعوك) الي قوله تعالي: (كارهون) * قال ابو محمد رحمه الله: ليس في اول الاية الا انهم يحلفون كاذبين وهم يعلمون كذبهم في ذلك وانهم يهلكون انفسهم بذلك وهذه صفة كل عاص في معصيته، وفي الاية ايضا معاتبة الله تعالي نبيه عليه السلام علي اذنه لهم، واما قوله تعالي: (لا يستاذنك الذين يءمنون بالله واليوم الاخر) الي قوله تعالي: (يترددون) فان وجه هذه الاية التي يجب ان لا تصرف عنه الي غيره بغير نص، ولا اجماع انه في المستانف لان لفظها لفظ الاستقبال، ولا خلاف في هذه الاية انها نزلت بعد تبوك ولم يكن لرسول الله صلي الله عليه وسلم بعد تبوك غزوة اصلا ولكنها نقطع علي انها لو كانت هنالك غزوة بعد تبوك وبعد نزول الاية فاستاذن قوم منهم النبي صلي الله عليه وسلم في القعود دون عذر لهم في ذلك لكانوا بلا شك مرتابة قلوبهم كفارا بالله تعالي
 وباليوم الاخر مترددين في الريب فبطل تعلقهم بهذه الاية، ثم قوله تعالي: (ولو ارادوا الخروج لاعدوا له عدة) الي قوله تعالي.
 (كارهون) فهذه اخبار عما خلا لهم وعن سيات اقترفوها وليس فيها شء يوجب لهم الكفر حتي لو كانوا معروفين باعيانهم وبالله تعالي التوفيق * وقوله تعالي: (ومنهم من يقول اءذن لي) الي قوله تعالي: (وهم فرحون) * قال ابو محمد رحمه الله.
 قد قيل: ان هذه الاية نزلت في الحر بن قيس وهذا لا ينسند البتة وانما هو منقطع من اخبار المغازي ولكن علي كل حال يقال: هذا كان معروفا بلا شك وليس في الاية انه كفر بذلك ولكنه عصي و() واذنب، وبلي ان جهنم لمحيطة بالكافرين ولا يجوز ان يقطع بهذا النص علي ان ذلك القاءل كان من الكافرين، واما الذي اخبر الله تعالي بانه ان اصابت رسوله عليه السلام سيءته ومصيبته تولوا  وهم فرحون او انه ان اصابته حسنة ساءتهم فهءلاء كفار بلا شك وليس في الاية نص علي ان القاءل.
 اءذن لي ولا تفتني كان منهم، ولا فيها نص علي انه عليه السلام عرفهم وعرف نفاقهم فبطل تعلقهم بهذه الاية، وقال تعالي: (قل انفقوا طوعا او كرها لن يقبل منكم) الي قوله.
 (يفرقون) * قال ابو محمد: اما هءلاء فكفار بلا شك مظهرون للاسلام ولكن ليس في الاية انه عليه السلام عرفهم باعيانهم ولا دليل فيها علي ذلك اصلا وانما هي صفة وصفها الله تعالي فيهم ليميزوها من انفسهم، وليس في قوله تعالي: (فلا يعجبك اموالهم ولا اولادهم)، دليل علي انه كان يعرفهم باعيانهم وانه كان يعرف نفاقهم بل قد كان للفضلاء من الانصار رضي الله عنهم الاموال الواسعة والاولاد النجباء الكثير كسعد بن عبادة.
 وابي طلحة وغيرهما فهذه صفة عامة يدخل فيها الفاضل الصادق والمنافق فامر تعالي في الاية ان لا تعجبه اموالهم ولا اولادهم
 عموما لان الله تعالي يريد ان يعذب المنافقين منهم بتلك الاموال ويموتوا كفارا ولا بد، وبالله تعالي التوفيق * وقال تعالي: (ومنهم من يلمزك في الصدقات) الي قوله تعالي: (راغبون) * قال ابو محمد رحمه الله: وهذا لا يدل البتة لا بنص، ولا بدليل علي كفر من فعل هذا ولكنها معصية بلا شك، وقال تعالي.
 (ومنهم الذين يءذون النبي) الي قوله تعالي.
 (ذلك الخزي العظيم) قال.
 وهذه الاية ليس فيها دليل علي كفر من قال حينءذ ان رسول الله صلي الله عليه وسلم اذن وانما يكون كافرا من قال.
 ذلك واذي رسول الله صلي الله عليه وسلم بعد نزول النهي عن ذلك، ونزول القران بان من فعل ذلك فهو كافر، وان من حاد الله تعالي ورسوله صلي الله عليه وسلم فله نار جهنم خالدا فيها، فقد جاء ان عمر قال لرسول الله صلي الله عليه وسلم.
 والله يا رسول الله انك لاحب الي من كل احد الا نفسي فقال له رسول الله صلي الله عليه وسلم: كلاما معناه انه لا يءمن حتي يكون احب اليه من نفسه فقال له عمر.
 اما الان فانت احب الي من نفسي * قال ابو محمد: لا يصح ان احدا عاد الي اذي رسول الله صلي الله عليه وسلم ومحادته بعد معرفته بالنازل في ذلك من عند الله تعالي الا كان كافرا ولا خلاف في ان امرءا لو اسلم ولم يعلم شراءع الاسلام فاعتقد ان الخمر حلال وان ليس علي الانسان صلاة وهو لم يبلغه حكم الله تعالي لم يكن كافرا بلا خلاف يعتد به حتي اذا قامت عليه الحجة فتمادي حينءذ باجماع الامة فهو كافر، ويبين هذا قوله تعالي في الاية المذكورة:

 (يحلفون لكم ليرضوكم والله ورسوله احق ان يرضوه ان كانوا مءمنين) فقد اخبرهم تعالي انهم ان كانوا مءمنين فارضاء الله ورسوله احق عليهم من ارضاء المسلمين فصح هذا بيقين، وبالله تعالي نستعين، وقال تعالي: (يحذر المنافقون ان تنزل عليهم سورة تنبءهم بما في قلوبهم قل استهزءوا ان الله مخرج ما تحذرون) قال وهذه
 الاية ايضا لا نص فيها علي قوم باعيانهم فلا متعلق فيها لاحد في هذا المعني، وقال تعالي: (ولءن سالتهم ليقولن انما كنا نخوض ونلعب) الي قوله تعالي: (كانوا مجرمين) * قال ابو محمد: هذه بلا شك في قوم معروفين كفروا بعد ايمانهم ولكن التوبة مبسوطة لهم بقوله تعالي: (ان نعف عن طاءفة منكم نعذب طاءفة بانهم كانوا مجرمين) فصح انهم اظهروا التوبة والندامة واعترفوا بذنبهم.
 فمنهم من قبل الله تعالي توبته في الباطن عنده لعلمه تعالي بصحتها، ومنهم من لم تصح توبته في الباطن فهم المعذبون في الاخرة، واما في الظاهر فقد تاب جميعهم بنص الاية، وبالله تعالي التوفيق * وقال تعالي: (المنافقون والمنافقات) الي قوله تعالي: (عذاب مقيم) قال: فهذه صفة عامة لم يقصد بها الي التعريف لقوم باعيانهم، وهذه حق واجب علي كل منافق ومنافقة، وبالله تعالي التوفيق * وقال تعالي: (يا ايها النبي جاهد الكفار والمنافقين واغلظ عليهم) الي قوله تعالي: (ولا نصير) قال.
 فهذه اية امر الله تعالي رسوله صلي الله عليه وسلم بمجاهدة الكفار والمنافقين، والجهاد قد يكون باللسان والموعظة والحجة كما نا عبد الله بن ربيع نا محمد بن اسحاق نا ابن الاعرابي نا ابو داود نا موسي بن اسماعيل نا حماد  هو ابن سلمة  عن حميد عن انس ان رسول الله صلي الله عليه وسلم قال: " جاهدوا المشركين باموالكم وانفسكم والسنتكم " * قال ابو محمد: وهذه الاية تدل علي ان هءلاء كانوا معروفين باعيانهم وانهم قالوا كلمة الكفر وكفروا بعد اسلامهم، ولكن لما قال الله تعالي: (فان يتوبوا يك خيرا لهم وان يتولوا يعذبهم الله عذابا اليما) صح ان الله تعالي بدل لهم التوبة وقبلها ممن احاطها منهم وكلهم بلا شك اظهر التوبة، وبرهان ذلك حلفهم وانكارهم فلا متعلق لهم في هذه الاية، وبالله تعالي التوفيق * وقال تعالي: (ومنهم من عاهد الله لءن اتانا من فضله) الي قوله تعالي: (يكذبون) قال وهذه ايضا صفة اوردها
 الله تعالي يعرفها كل من فعل ذلك من نفسه وليس فيها نص ولا دليل علي ان صاحبها معروف بعينه علي انه قد روينا اثرا لا يصح وفيه انها نزلت في ثعلبة بن  حاطب وهذا باطل لان ثعلبة بدري معروف وهذا اثر ناه حمام نا يحيي بن مالك ابن عاءذ نا الحسن بن ابي غسان نا زكريا بن يحيي الباجي ني سهل السكري نا احمد ابن الحسن الخراز نا مسكين بن بكير نا معان بن رفاعة السلامي عن علي بن يزيد عن القاسم بن عبد الرحمن عن ابي امامة قال: جاء ثعلبة بن حاطب بصدقته الي عمر فلم يقبلها وقال: لم يقبلها النبي صلي الله عليه وسلم ولا ابو بكر ولا اقبلها * قال ابو محمد: وهذا باطل بلا شك لان الله تعالي امر بقبض ذكوات اموال المسلمين وامر عليه السلام عند موته ان لا يبقي في جزيرة العرب دينان فلا يخلو ثعلبة من ان يكون مسلما ففرض علي ابي بكر.
 وعمر قبض ذكاته ولا بد ولا فسحة في ذلك وان كان كافرا ففرض ان لا يقر في جزيرة العرب فسقط هذا الاثر بلا شك وفي رواته معان بن رفاعة، والقاسم بن عبد الرحمن، وعلي بن يزيد  وهو ابو عبد الملك الالهابي  وكلهم ضعفاء.
 ومسكين بن بكير ليس بالقوي * وقال تعالي: (الذين يلمزون المطوعين من المءمنين في الصدقات) الي قوله تعالي: (الفاسقين) وقال تعالي: (ولا تصل علي احد منهم مات ابدا) الي قوله تعالي: (وماتوا وهم كافرون) * قال ابو محمد: قدمنا هذه الاية وهي مءخرة عن هذا المكان لانها متصلة المعاني بالتي ذكرنا قبلها لانهما جميعا في امر عبد الله بن ابي.
 ثم نذكر القول فيهما جميعا ان شاء الله تعالي * قال ابو محمد: هذه الايات فيها انهم يلمزون المطوعين من المءمنين ويسخرون منهم وهذا ليس كفرا بلا خلاف من احد من اهل السنة، واما قوله تعالي: (استغفر لهم او لا تستغفر لهم) الي قوله تعالي: (الفاسقين) وقوله تعالي: (ولا تصل
 علي احد منهم مات ابدا) الي قوله تعالي: (فاسقون) فان هذا لا يدل علي تماديهم علي الكفر الي ان ماتوا ولكن يدل يقينا علي ان فعلهم ذلك من سخريتهم بالذين امنوا غير مغفور لهم لانهم كفروا فيما خلا فكان ما سلف من كفرهم موجبا ان يغفر لهم لمزهم المطوعين من المءمنين وسخريتهم بالذين لا يجدون الا جهدهم وان تابوا من كفرهم وانهم ماتوا علي الفسق لا علي الكفر بل هذا معني الاية بلا شك، برهان ذلك ما روينا من طريق مسلم نا ابو بكر بن ابي شيبة نا ابو اسامة نا عبيد الله  هو ابن عمر  عن نافع عن ابن عمر قال: لما توفي عبد الله بن ابي بن سلول جاء ابنه عبد الله الي رسول الله صلي الله عليه وسلم فساله ان يعطيه قميصا يكفن فيه اباه فاعطاه ثم ساله ان يصلي عليه فقام رسول الله صلي الله عليه وسلم ليصلي عليه فقام عمر واخذ بثوب رسول الله صلي الله عليه وسلم فقال:

 يا رسول الله اتصلي عليه وقد نهاك الله ان تصلي عليه؟ فقال رسول الله صلي الله عليه وسلم: " انما خيرني الله تعالي فقال: (استغفر لهم او لا تستغفر لهم) الي قوله تعالي: (سبعين مرة) وسازيد علي " السبعين) قال: انه منافق فصلي عليه رسول الله صلي الله عليه وسلم فانزل الله تعالي (ولا تصل علي احد منهم مات ابدا ولا تقم علي قبره) قال مسلم: نا محمد بن المثني نا يحيي  هو ابن سعيد القطان  عن عبيد الله بن عمر باسناده ومعناه وزاد " فترك الصلاة عليهم " * قال ابو محمد: ونا يوسف بن عبد الله بن عبد البر قال.
 نا خلف بن القاسم نا ابن الورد نا ابن عبد الرحيم الرقي عن عبد الملك بن هشام عن زياد بن عبد الله البكاءي عن محمد بن اسحق الزهري عن عبيد الله بن عبد الله بن عتبة عن ابن عباس قال.
 سمعت عمر بن الخطاب يقول: لما توفي عبد الله بن ابي دعي له رسول الله صلي الله عليه وسلم للصلاة عليه فقام اليه فلما وقف اليه يريد الصلاة تحولت حتي قمت في صدره فقلت: يا رسول الله اتصلي علي عدو الله عبد الله بن ابي؟ القاءل كذا يوم كذا والقاءل كذا في يوم كذا اعدد ايامه حتي اذا
 اكثرت عليه قال: " يا عمر اخر عني اني قد خيرت فاخترت قد قيل لي: (استغفر لهم او لا تستغفر لهم) فلو اعلم اني ان زدت علي السبعين غفر له لزدت " قال: ثم صلي عليه رسول الله صلي الله عليه وسلم ومشي معه حتي قام علي قبره حتي فرغ منه قال: فعجبت لي ولجراتي علي رسول الله صلي الله عليه وسلم والله ورسوله اعلم فو الله ما كان الا يسيرا حتي نزلت هاتان الايتان (ولا تصل علي احد منهم مات ابدا ولا تقم علي قبره) الي قوله تعالي: (وهم فاسقون) فما صلي رسول الله صلي الله عليه وسلم علي منافق حتي قبضه الله تعالي " * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن عبد الله بن المبارك نا حجير بن المثني نا الليث بن سعد عن عقيل بن خالد عن ابن شهاب عن عبيد الله بن عبد الله بن عتبة بن مسعود عن ابن عباس عن عمر بن الخطاب قال.
 " لما توفي عبد الله بن ابي ابن سلول دعي له رسول الله صلي الله عليه وسلم ليصلي عليه فلما قام رسول الله صلي الله عليه وسلم وثبت ثم قلت.
 يا رسول الله اتصلي علي ابن ابي؟ وقال: يوم كذا كذا وكذا اعدد عليه فتبسم رسول الله صلي الله عليه وسلم وقال: اخر عني يا عمر فلما اكثرت عليه قال: اني خيرت فاخترت فلو علمت اني ان زدت علي السبعين غفر له لزدت عليها فصلي عليه رسول الله صلي الله عليه وسلم ثم انصرف فما مكث الا يسيرا حتي نزلت الايتان من براءة المذكورتان قال عمر: فعجبت من جراتي علي رسول الله صلي الله عليه وسلم " والله اعلم * حدثنا احمد بن عمر بن انس العذري نا ابو ذر الهروي نا عبد الله بن احمد بن حمويه السرخسي نا ابراهيم بن خريم نا عبد بن حميد انا ابراهيم بن  الحكم عن ابيه عن عكرمة قال: " لما حضر عبد الله بن ابي الموت قال ابن عباس: فدخل عليه رسول الله صلي الله عليه وسلم فجري بينهما كلام فقال له عبد الله بن ابي: قد افقه ما تقول ولكن من علي اليوم وكفني بقميصك هذا وصل علي قال ابن عباس.
 فكفنه رسول الله صلي الله عليه وسلم بقميصه وصلي عليه والله اعلم اي صلاة كانت وان رسول الله صلي الله عليه وسلم لم يخدع انسانا قط غير انه قال يوم الحديبية: كلمة حسنة قال الحكم: فسالت عكرمة ما هذه الكلمة؟ فال
 قالت قريش: يا ابا حباب انا قد منعنا محمدا طواف هذا البيت ولكنا ناذن لك فقال لا لي في رسول الله صلي الله عليه وسلم اسوة حسنة " * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد ابن شعيب انا عبد الجبار بن العلاء بن عبد الجبار عن سفيان بن عيينة عن عمرو بن دينار وسمع جابرا يقول: اتي النبي صلي الله عليه وسلم قبر عبد الله بن ابي وقد وضع في حفرته فوقف فامر به فاخرج من حفرته فوضعه علي ركبتيه والبسه قميصه ونفث عليه من ريقه والله اعلم * قال ابو محمد رحمه الله: فهذا كله يوجب صحة ما قلناه لوجوه، احدها ظاهر الاية كما قلنا من انهم كفروا قبل وماتوا علي الفسق، والثاني ان الله تعالي قد نهي النبي صلي الله عليه وسلم والمءمنين عن الاستغفار جملة للمشركين بقوله تعالي: (ما كان للنبي والذين امنوا ان يستغفروا للمشركين) الي قوله تعالي: (اصحاب الجحيم) فلو كان ابن ابي وغيره من المذكورين ممن تبين للنبي عليه السلام انهم كفار بلا شك لما استغفر لهم النبي صلي الله عليه وسلم ولا صلي عليه، ولا يحل لمسلم ان يظن بالنبي صلي الله عليه وسلم انه خالف ربه في ذلك فصح يقينا انه عليه السلام لم يعلم قط ان عبد الله بن ابي والمذكورين كفار في الباطن * روينا من طريق مسلم نا حرملة بن يحيي التجيبي نا عبد الله بن وهب انا يونس عن ابن شهاب اخبرني سعيد بن المسيب بن حور عن ابيه قال: لما حضرت ابا طالب الوفاة جاءه رسول الله صلي الله عليه وسلم فوجد عنده ابا جهل.
 وعبد الله بن ابي امية بن المغيرة فقال رسول الله صلي الله عليه وسلم: " يا عم قل لا اله الا الله كلمة اشهد لك بها عند الله فقال ابو جهل.
 وعبد الله ابن ابي امية: اترغب عن ملة عبد المطلب فلم يزل رسول الله صلي الله عليه وسلم يعرضها عليه ويعيدان عليه تلك المقالة حتي قال ابو طالب: اخر ما كلمهم به علي ملة عبد المطلب فقال رسول الله صلي الله عليه وسلم: " اما والله لاستغفرن لك ما لم انه عنك " فانزل الله تعالي.
 (ما كان للنبي والذين امنوا) الاية * قال ابو محمد: فصح ان النهي عن الاستغفار للمشركين نزل بمكة بلا شك فصح يقينا انه عليه السلام لم يوقن ان عبد الله بن ابي مشرك ولو ايقن انه مشرك لما صلي عليه
 اصلا ولا استغفر له وكذلك تعديد عمر بن الخطاب مقالات عبد الله بن ابي سلول لا ولو  كان عنده كافرا لصرح بذلك وقصد اليه ولم يطول بغيره، والثالث شك ابن عباس.
 وجابر وتعجب عمر من معارضة النبي صلي الله عليه وسلم في صلاته علي عبد الله بن ابي واقراره بان رسول الله صلي الله عليه وسلم اعرف منه، والرابع ان الله تعالي انما نهي نبيه صلي الله عليه وسلم عن الصلاة عليهم والاستغفار لهم فقط ولم ينه ساءر المسلمين عن ذلك وهذا لا ننكره فقد كان رسول الله صلي الله عليه وسلم لا يصلي علي من له دين لا يترك له وفاء ويامر المسلمين بالصلاة عليهم فصح يقينا بهذا ان معني الايات انما هو انهم كفروا بذلك من قولهم: وعلم بذلك النبي عليه السلام والمسلمون، ثم تابوا في ظاهر الامر فمنهم من علم الله تعالي ان باطنه كظاهره في التوبة ومنهم من علم الله تعالي ان باطنه خلاف ظاهره ولم يعلم ذلك النبي عليه السلام ولا احد من المسلمين وهذا في غاية البيان وبالله تعالي التوفيق * وقال تعالي.
 (فرح المخلفون بمقعدهم خلاف رسول الله) الي قوله تعالي: (وهم كافرون) قال فقوله تعالي.
 (فرح المخلفون) الاية ليس فيها نص علي انهم كفروا بذلك ولكنهم اتوا كبيرة من الكباءر كانوا بها عصاة فاسقين وقد ذكر الله تعالي هءلاء باعيانهم في سورة الفتح وبين تعالي هذا الذي قلناه هنالك بزيادة علي ما ذكرهم به ههنا فقال تعالي.
 (سيقول لك المخلفون من الاعراب) الي قوله تعالي: (عذابا اليما) فنص الله تعالي علي ان اولءك المخلفين الذين امر الله تعالي نبيه صلي الله عليه وسلم ان لا يصلي علي احد منهم مات ابدا وانهم كفروا بالله وبرسوله والذين امر الله تعالي نبيه صلي الله عليه وسلم ان لا تعجبه اموالهم ولا اولادهم وانه تعالي اراد ان تزهق انفسهم وهم كافرون انهم مقبولة توبتهم ان تابوا في ظاهر امرهم وفي الحكم بان باطنهم ان من كان منهم صحيح التوبة مطيعا اذا دعي بعد موت رسول الله صلي الله عليه وسلم الي الجهاد فسيءتيه اجرا عظيما وان من تولي عذبه الله تعالي عذابا اليما فصح ما قلناه من انهم كفروا فعرف رسول الله صلي الله عليه وسلم انهم كفروا ثم تابوا فقبل توبتهم ولم يعرف عليه السلام بعد التوبة من منهم الصادق في سر امره
 ولا من منهم الكافر في باطن معتقده وهذا هو الحق الذي لا يجوز غيره بشهادة النصوص كما اوردنا انفا وبالله تعالي التوفيق * وقال تعالي: (واذا انزلت سورة ان امنوا بالله) الي قوله تعالي: (فهم لا يفقهون) * قال ابو محمد رحمه الله: فهذه نص الايات التي ذكرنا ايضا وقد تكلمنا فيها، وقال تعالي: (وجاء المعذرون من الاعراب) الي قوله تعالي: (عذاب اليم) قال: وهذه الاية تبين ما قلناه نصا لانه تعالي اخبر ان بعضهم كفار الا ان كلهم عصاة فاما المبطنون للكفر منهم فلم يعلمهم النبي عليه السلام ولا علمهم احد منهم الا الله تعالي فقط، وقال تعالي.
 (انما السبيل علي الذين يستاذنونك) الي قوله: (عن القوم الفاسقين) *

 قال ابو محمد رحمه الله: وهذه كالتي قبلها وقد قلنا ان فيهم من كفر فاولءك الذين طبع الله علي قلوبهم ولكن الله تعالي ارجي امرهم بقوله تعالي.
 (وسيري الله عملكم ورسوله) فصح ما قلناه واتفقت الايات كلها والحمد لله رب العالمين * وكذلك اخبر تعالي ان ماواهم جهنم جزاءا بما كانوا يكسبون وجهنم تكون جزاءا علي الكفر وتكون جزاءا علي المعصية وكذلك لا يرضي تعالي عن القوم الفاسقين وان لم يكونوا كافرين وقال تعالي: (الاعراب اشد كفرا ونفاقا) الي قوله تعالي: (ان الله غفور رحيم) * قال ابو محمد: وهذه الايات كلها تبين نص ما قلناه من ان فيهم كفارا في الباطن * قال ابو محمد رحمه الله: لا يعلم سرهم الا الله تعالي واما رسوله عليه السلام فلا وقال تعالي.
 (وممن حولكم من الاعراب منافقون) الي قوله تعالي: (سميع عليم) * قال ابو محمد: هذه الاية مبينة نص ما قلناه بيانا لا يحل لاحد ان يخالفه من ان النبي عليه السلام لا يعلم المنافقين لا من الاعراب ولا من اهل المدينة ولكن الله تعالي يعلمهم وان منهم من يتوب فيعفو الله تعالي عنه، وان النبي صلي الله عليه وسلم مامور باخذ زكوات جميعهم علي ظاهر الاسلام، وقال تعالي.
 (الذين اتخذوا مسجدا ضرارا وكفرا) الي قوله
 تعالي: (الا ان تقطع قلوبهم والله عليم حكيم) * قال ابو محمد رحمه الله: وهذه كالتي قبلها وفيها ان بنيانهم للمسجد قصدوا به الكفر ثم اظهروا التوبة فعلم الله تعالي صدق من صدق فيها وكذب من كذب فيها ونعم لا يزال بنيانهم الذي بنوا ريبة في قلوبهم الا ان تقطع قلوبهم، وقد قدم الله تعالي ان من اذنب ذنبا فممكن ان لا يغفره له ابدا حتي يعاقبه عليه، وهذا مقتضي هذه الاية وقال تعالي.
 (واذا ما انزلت سورة فمنهم من يقول) الي قوله تعالي: (لا يفقهون) * قال ابو محمد رحمه الله.
 فهذه لا دليل فيها اصلا علي ان القاءلين بذلك معروفين باعيانهم لكنها صفة وصفها الله تعالي يعرفونها من انفسهم اذا سمعوها فقط، وقال تعالي: (ويقولون امنا بالله وبالرسول) الي قوله تعالي: (هم الفاءزون) * قال ابو محمد.
 ليس في هذه الاية بيان انهم معروفون باعيانهم وانما هي صفة من سمعها عرفها من نفسه وهي تخرج علي وجهين، احدهما ان يكون من فعل ذلك كافرا وهو ان يعتقد النفار عن حكم رسول الله صلي الله عليه وسلم ويدين بان لا يرضي به فهذا كفر مجرد، والوجه الثاني ينقسم قسمين.
 احدهما ان يكون فاعل ذلك متبعا لهواه في الظلم ومحابات نفسه عارفا بقبح فعله في ذلك ومعتقدا ان الحق في خلاف فعله فهذا فاسق وليس كافرا، والثاني ان يفعل ذلك مقلدا لانسان في انه قد شغفه تعظيمه اياه وحبه موهما نفسه انه  علي حق وهذه الوجوه كلها موجودة في الناس.
 فاهل هذين القسمين الاخرين مخطءون عصاة وليسوا كفارا ويكون معني قوله تعالي.
 (وما اولءك بالمءمنين) اي وما اولءك بالمطيعين لان كل طاعة لله تعالي فهو ايمان وكل ايمان طاعة لله تعالي فمن لم يكن مطيعا لله تعالي في شء ما فهو غير مءمن في ذلك الشء بعينه وان كان مءمنا في غير ذلك مما هو فيه مطيع لله تعالي، وقال تعالي.
 (يا ايها النبي اتق الله) الي قوله تعالي.
 (عليما حكيما) *
 قال ابو محمد رحمه الله: هذه الاية يقتضي ظاهرها ان اهواء الكافرين والمنافقين معروفة وهو ان يكفر جميع المءمنين، قال تعالي: (ودوا لو تكفرون كما كفروا فتكونون سواء) فاذ اهواءهم معروفة ففرض علي النبي صلي الله عليه وسلم وعلي كل مسلم ان لا يطيعهم في ذلك مما قد عرف انه مرادهم وان لم يشيروا عليه في ذلك براي ولا يجوز ان يظن ظان ان الكفار والمنافقين اتوا رسول الله صلي الله عليه وسلم وسلم مشيرين عليه براي راجين ان يتبعهم فيه فاذ الامر كذلك فليس في الاية بيان ان المنافقين كانوا معروفين باعيانهم عند رسول الله صلي الله عليه وسلم يدري انهم منافقون ولكنهم معروفة صفاتهم جملة ومن صفاتهم بلا شك ارادتهم ان يكون كل الناس كفارا، وقال تعالي: (اذ يقول المنافقون والذين في قلوبهم مرض) الاية * قال ابو محمد رحمه الله: هذا ايضا ليس فيه بيان بانهم قوم معروفين باعيانهم وانما هو خبر عن قاءلين قالوا ذلك: وقال تعالي: (واذ قالت طاءفة منهم يا اهل يثرب لا مقام لكم فارجعوا) * قال ابو محمد: وهذا ايضا ممكن ان يقوله يهود وممكن ان يقوله ايضا قوم مسلمون خور اوجبنا، واذ كل ذلك ممكن فلا يجوز القطع من اجل هذه الاية علي ان رسول الله صلي الله عليه وسلم كان يعرف انهم منافقون، واما قوله تعالي: (ويستاذن فريق منهم النبي) الي قوله تعالي.
 (وكان عهد الله مسءولا) فان هذا قد روي انه كان نزل في بني حارثة وبني سلمة وهم الافاضل البدريون الاحديون ولكنها كانت وهلة في استءذانهم النبي صلي الله عليه وسلم يوم الخندق.
 وقولهم.
 (ان بيوتنا عورة) وفيهما نزلت.
 (اذ همت طاءفتان منكم ان تفشلا والله وليهما) كما نا عبد الرحمن بن عبد الله بن خالد نا ابراهيم بن احمد نا الفربري نا البخاري نا علي بن عبد الله نا سفيان بن عيينة قال عمرو بن دينار.
 سمعت جابر بن عبد الله يقول.
 فبينا نزلت (اذ همت طاءفتان منكم ان تفشلا والله وليهما) قال جابر.
 نحن الطاءفتان بنو حارثة وبنو سلمة  قال جابر.
 وما نحب انها لم تنزل لقوله تعالي.
 (والله وليهما) * قال ابو محمد.
 مع انه ليس في الاية ان هذا كفر اصلا فبطل التعلق بها وبالله تعالي التوفيق * وقال تعالي.
 (قد يعلم الله المعوقين منكم) الي قوله تعالي.
 (وكان ذلك علي الله يسيرا) * قال ابو محمد: فهذه ليس فيها دليل علي انها في قوم معروفين باعيانهم ولكنها صفة يعرفها من نفسه من سمع منهم هذه الاية الا ان قول الله تعالي بعدها بيسير.
 (ليجزي الله الصادقين بصدقهم ويعذب المنافقين ان شاء او يتوب عليهم) بيان جلي علي بسط التوبة لهم وكل هءلاء بلا خلاف من احد من الامة معترف بالاسلام لاءذ بالتوبة فيما صح عليهم من قول يكون كفرا ومعصية فبطل التعلق بهذه الاية لمن ادعي ان رسول الله صلي الله عليه وسلم كان يعرفهم باعيانهم ويعرف انهم يعتقدون الكفر في باطنهم قال الله تعالي.
 (ولا تطع الكافرين والمنافقين) الي قوله تعالي.
 (وكفي بالله وكيلا) * قال ابو محمد: قد مضي قولنا في قوله تعالي: (ولا تطع الكافرين والمنافقين) وقال تعالي: (ودع اذاهم وتوكل علي الله وكفي بالله وكيلا) لا يختلف مسلمان في انه ليس علي ترك قتال الكافرين واصغارهم ودعاءهم الي الاسلام ولكن فيما عدا ذلك، وقال تعالي: (لءن لم ينته المنافقون والذين في قلوبهم مرض) الي قوله تعالي: (ولن تجد لسنة الله تبديلا) * قال ابو محمد: هذه الاية فيها كفاية لمن عقل ونصح نفسه لان الله تعالي قطع بانه ان لم ينته المنافقون والذين في قلوبهم مرض والمرجفون في المدينة ليغرين بهم رسول الله صلي الله عليه وسلم ثم لا يجاورونه فيها الا قليلا فاخبر تعالي انهم يكونون ان لم ينتهوا ملعونين اينما ثقفوا اخذوا وقتلوا تقتيلا  واعراب  ملعونين  انه حال لمجاورتهم 
 معناه لا يجاورونه الا قليلا ملعونين، ولو اراد الله تعالي غير هذا لقال: ملعونون علي خبر ابتداء مضمر ثم اكد تعالي بان هذه هو سنته تعالي التي لا تتبدل فنسال من قال: ان رسول الله صلي الله عليه وسلم علمهم باعيانهم وعلم نفاقهم هل انتهوا او لم ينتهوا فان قال: انتهوا رجع الي الحق وصح انهم تابوا ولم يعلم باطنهم في صحة التوبة او كذبها الا الله تعالي وحده لا شريك له ولم يعلم رسول الله صلي الله عليه وسلم قط الا الظاهر الذي هو الاسلام او كفرا رجعوا عنه فاظهروا التوبة منه وان قال: لم ينتهوا لم يبعد من الكفر لانه يكذب الله تعالي ويخبر انه تعالي بدل سنته التي قد اخبر انه  لا يبدلها او بدلها رسوله عليه السلام * قال ابو محمد: وكل من وقف علي هذا وقامت عليه الحجة ثم تمادي فهو كافر لانه مكذب لله تعالي او مجور لرسوله عليه السلام وكلا الامرين كفر * قال ابو محمد: ولقد بلغني عن بعض من خذله الله تعالي انه تلا هذه الاية ثم قال: ما انتهوا ولا اغراه بهم * قال ابو محمد: نحن نبرا الي الله تعالي من هذا فان قاءله افك كاذب عاص لله تعالي لا يحل له الكلام في الدين ونسال الله تعالي العافية، وقال تعالي: (ومنهم من يستمع اليك) الي قوله تعالي: (واتبعوا اهواءهم) * قال ابو محمد: من عصي الله تعالي فقد طبع علي قلبه في الوجه الذي عصي فيه ولو لم يطبع علي قلبه فيه لما عصي فقد يمكن ان يكون هءلاء منافقين فاعلانهم بالتوبة ماح لما تقدم في الظاهر والله اعلم بالباطن، وبالله تعالي التوفيق * وقال تعالي: (فاذا انزلت سورة محكمة) الي قوله تعالي: (فلو صدقوا الله لكان خيرا لهم) * قال ابو محمد: وهذا كالذي قبله اما ان يكون هذا النظر يبين معتقدهم واظهارهم الاسلام توبة تصح به قبولهم علي ظاهرهم وان لم يكن ذلك النظر دليلا يتميزون
 به فهم كغيرهم ولا فرق، وقال تعالي: (ان الذين ارتدوا علي ادبارهم) الي قوله تعالي: (والله يعلم اسرارهم) * قال ابو محمد: هذه صفة مجملة لمن ارتد معلنا او مسرا ولا دليل فيها علي انه عليه السلام عرف انهم منافقون مسرون للكفر، وبالله تعالي التوفيق * قال تعالي: (ام حسب الذين في قلوبهم مرض) الي قوله تعالي: (والله يعلم اعمالكم) * قال ابو محمد: قد بين الله تعالي: انه لو شاء اراهم نبيه عليه السلام وهذا لا شك فيه ثم قال تعالي: (ولتعرفنهم في لحن القول) فهذا كالنظر المتقدم ان كان لحن القول برهانا يقطع به رسول الله صلي الله عليه وسلم علي انهم منافقون فاظهارهم خلاف ذلك القول واعلانهم الاسلام توبة في الظاهر كما قدمنا وان كان عليه السلام لا يقطع بلحن قولهم علي ضميرهم فانما هو ظن يعرفه في الاغلب لا يقطع به، وبالله تعالي التوفيق * قال ابو محمد: قد ذكرنا في براءة.
 والفتح قول الله تعالي: (سيقول لك المخلفون) الايات كلها وبينا ان الله تعالي وعدهم بقبول التوبة والاجر العظيم ان تابوا واطاعوا لمن دعاهم بعد النبي عليه السلام الي الجهاد، وبالله تعالي التوفيق *

 وقال تعالي: (قالت الاعراب امنا) الي قوله تعالي: (غفور رحيم) * قال ابو محمد: هذا دليل علي انهم استسلموا لله تعالي غلبة ولم يدخل الايمان في قلوبهم ولكن الله تعالي قد بسط لهم التوبة في الاية نفسها بقوله تعالي: (وان تطيعوا الله ورسوله لا يلتكم من اعمالكم شيءا) فاظهارهم الطاعة لله تعالي ولرسوله عليه السلام مدخل لهم في حكم الاسلام ومبطل لان يكون عليه السلام عرف باطنهم، وقال تعالي: (يوم يقول المنافقون والمنافقات) الي قوله تعالي: (وغرتكم الاماني) * قال ابو محمد: فهذه حكاية عن يوم القيامة واخبار بانهم كانوا في الدنيا مع المسلمين وهذا يبين انهم لم يكونوا معروفين عند النبي صلي الله عليه وسلم ولا عند المسلمين وهذه
 الاية يوافقها ما روينا من طريق مسلم بن الحجاج نا زهير بن حرب نا يعقوب بن ابراهيم بن سعد نا ابي عن ابن شهاب عن عطاء بن يزيد الليثي ان ابا هريرة اخبره ان رسول الله صلي الله عليه وسلم قال في حديث: " فيجمع الله الناس يوم القيامة فيقول من كان يعبد شيءا فليتبعه.
 فيتبع من يعبد الشمس الشمس، ويتبع من يعبد القمر القمر، ويتبع من يعبد الطواغيت الطواغيت وتبقي هذه الامة فيها منافقوها، وذكر الحديث، وقال تعالي: (الم تر الي الذين نهوا عن النجوي) الي قوله تعالي: (فبءس المصير) * قال ابو محمد: هءلاء معروفون بلا شك ولكن التوبة لهم مبسوطة كما ذكرنا في ساءر الايات، وقال تعالي: (الم تر الي الذين تولوا قوما غضب الله عليهم) الي قوله تعالي: (هم الخاسرون) * قال ابو محمد: وهذه صفة قوم لم يسلموا الا انهم يتبرءون من موالاة الكفار فان كانوا معروفين بالكفر فالتوبة لهم مبسوطة كما ذكر تعالي في ساءر الايات التي تلونا قبل، وبالله تعالي التوفيق * وقال تعالي: (الم تر الي الذين نافقوا) الي قوله تعالي: (باسهم بينهم شديد) * قال ابو محمد: هذا قد يكون سرا علمه الله منه وفضحه ولم يسم قاءله ويمكن ان يكون قد عرف فالتوبة لهم مبسوطة كما ذكرنا في ساءر الايات، وقال تعالي: (اذا جاءك المنافقون) الي قوله تعالي: (ولكن المنافقين لا يعلمون) * قال ابو محمد: هذا نزل في عبد الله بن ابي كما روينا من طريق البخاري نا عمرو ابن خالد نا زهير بن معاوية نا ابو اسحق  هو السبيعي  قال: سمعت زيد بن ارقم قال: خرجنا مع رسول الله صلي الله عليه وسلم في سفر اصاب الناس فيه شدة فقال عبد الله بن ابي: لا تنفقوا علي من عند رسول الله حتي ينفضوا من حوله وقال: لان رجعنا  الي المدينة ليخرجن الاعز منها الاذل فاتيت النبي صلي الله عليه وسلم فاخبرته فارسل الي عبد
 الله بن ابي فاجتهد يمينه ما فعل فقالوا.
 كذب زيد يا رسول الله فوقع في نفسي مما قال شدة حتي انزل الله تعالي تصديقي في (اذا جاءك المنافقون) فدعاهم النبي صلي الله عليه وسلم ليستغفر لهم فلووا رءوسهم قال " وقوله.
 (خشب مسندة) كانوا رجالا اجمل شء كما روينا من طريق البخاري نا علي بن عبد الله نا سفيان قال عمرو بن دينار.
 سمعت جابر بن عبد الله يقول.
 كنا في غزاة فكسع رجل من المهاجرين رجلا من الانصار فقال دعوها فانها منتنة فسمع ذلك عبد الله بن ابي فقال.
 فعلوها اما والله لءن رجعنا الي المدينة ليخرجن الاعز منها الاذل فبلغ ذلك النبي صلي الله عليه وسلم فقام عمر فقال.
 يا رسول الله دعني اضرب عنق هذا المنافق فقال النبي صلي الله عليه وسلم.
 دعه لا يتحدث الناس ان محمدا يقتل اصحابه قال سفيان.
 فحفظته من عمر وقال.
 سمعت جابرا قال.
 كنا مع النبي صلي الله عليه وسلم " * قال ابو محمد: اما قول الله تعالي.
 (اذا جاءك المنافقون) الي قوله تعالي.
 (فهم لا يفقهون) فهم قوم كفروا بلا شك بعد ايمانهم وارتدوا بشهادة الله تعالي عليهم بذلك الا ان التوبة لهم بيقين مذكورة في الاية، وفيما رواه زيد بن ارقم من الحديث الثابت اما النص فقوله تعالي.
 (يستغفر لكم رسول الله لووا رءوسهم) واما منع الله تعالي من المغفرة لهم فانما هو بلا شك فيما قالوه من ذلك القول.
 لا في مراجعة الايمان بعد الكفر فان هذا مقبول منهم بلا شك * برهان ذلك ما سلف في الايات التي قدمنا قبل وايضا اطلاقهم فيه نبيه صلي الله عليه وسلم علي الاستغفار لهم بقوله.
 (سواء عليهم استغفرت لهم ام لم تستغفر لهم لن يغفر الله لهم) وهم قد اظهروا الايمان بلا شك والله اعلم بنياتهم * برهان ذلك ما قد ذكرناه قبل من شك جابر وابن عباس وعمر رضي الله عنهم في ابن ابي بعينه صاحب هذه القصة، وكذلك الخبر عن جابر اذ قال عمر للنبي عليه السلام دعني اضرب عنق هذا المنافق  يعني عبد الله بن ابي  فليس في هذا دليل علي انه حينءذ منافق لكنه قد كان نافق بلا شك وقد قال عمر رضي الله عنه: مثل هذا في مءمن برء من النفاق جملة وهو حاطب بن بلتعة  وقول رسول الله صلي الله عليه وسلم.
 " دعه لا يتحدث الناس ان محمدا يقتل اصحابه " دليل بين علي تحريم دم
 عبد الله بن ابي بن سلول بقوله عليه السلام.
 " دعه " وهو عليه السلام لا يجوز ان يامر بان يدع الناس فرضا واجبا، وكذلك قوله عليه السلام.
 " لا يتحدث الناس ان محمدا يقتل اصحابه " بيان جلي بظاهر لفظه مقطوع علي غيبه بصحة باطن ان عبد الله بن ابي من جملة اصحاب رسول الله صلي الله عليه وسلم بظاهر اسلامه وانه من جملة الصحابة المسلمين الذين لهم حكم الاسلام والذين حرم الله تعالي دماءهم الا بحقها وبيقين ندري انه لو حل دم  ابن ابي لما حاباه رسول الله صلي الله عليه وسلم ولو وجب عليه لما ضيعه عليه السلام * ومن ظن ان رسول الله صلي الله عليه وسلم لا يقتل من وجب عليه القتل من اصحابه فقد كفر وحل دمه وماله لنسبته الي رسول الله صلي الله عليه وسلم الباطل، ومخالفة الله تعالي، والله لقد قتل رسول الله صلي الله عليه وسلم اصحابه الفضلاء المقطوع لهم بالايمان والجنة اذ وجب عليهم القتل كماعز، والغامدية، والجهينية رضي الله عنهم، فمن الباطل المتيقن، والضلال البحت، والفسوق المجرد بل من الكفر الصريح ان يعتقد او يظن من هو مسلم ان رسول الله صلي الله عليه وسلم يقتل مسلمين فاضلين من اهل الجنة من اصحابه اشنع قتلة بالحجارة، ويقتل الحارث بن سويد الانصاري قصاصا بالمجدر بن خيار البلوي بعلمه عليه السلام دون ان يعلم ذلك احد والمراة التي امر انيسا برجمها ان اعترفت وبقطع يد المخزومية ويقول: " لو كانت فاطمة لقطعت يدها " وبقوله عليه السلام: " انما هلكت بنو اسراءيل بانهم كانوا اذا اصاب الضعيف منهم الحد اقاموه عليه واذا اصابه الشريف تركوه " ثم يفعل هو عليه السلام ذلك ويعطل اقامة الحق الواجب في قتل المرتد علي كافر يدري انه ارتد الان ثم لا يقنع بهذا حتي يصلي عليه ويستغفر له وهو يدري انه كافر وقد تقدم نهي الله تعالي له عن الاستغفار للكفار ونحن نشهد بشهادة الله تعالي بان من دان بهذا واعتقده فانه كافر مشرك مرتد حلال الدم والمال نبرا الي الله تعالي منه ومن ولايته () من يظن به النفاق بلا خلاف فالامر فيمن
 دونه بلاشك اخفي فارتفع الاشكال في هذه الايات ولله الحمد، وصح ان عبد الله ابن ابي بعد ان كفرهو ومن ساعده علي ذلك اظهروا التوبة والاسلام فقبل رسول الله صلي الله عليه وسلم ذلك منهم ولم يعلم باطنهم علي ما كانوا عليه من الكفر؟ ام علي ما اظهروا من التوبة؟ ولكن الله تعالي عليم بذلك وهو بلا شك المجازي عليه يوم القيامة، وقال تعالي: (يا ايها النبي جاهد الكفار والمنافقين واغلظ عليهم) * قال ابو محمد: هذا يخرج علي وجهين لا ثالث لهما * اما من يعلم انه منافق وكفر فانه عليه السلام يجاهده بعينه بلسانه والاغلاظ عليه حتي يتوب، ومن لم يعلم بعينه جاهده جملة بالصفة وذم النفاق والدعاء الي التوبة، ومن الباطل البحت ان يكون رسول الله صلي الله عليه وسلم يعلم ان فلانا بعينه منافق متصل النفاق ثم لا يجاهده فيعصي ربه تعالي ويخالف امره ومن اعتقد هذا فهو كافر لانه نسب الاستهانة بامر الله تعالي الي رسوله صلي الله عليه وسلم * قال ابو محمد: هذا كل ما في القران من ذكر المنافقين قد تقصيناه والحمد لله رب  العالمين، وبقيت اثار نذكرها الان ان شاء الله تعالي * روينا من طريق البخاري نا سعيد بن عفير ني الليث  هو ابن سعد  نا عقيل عن ابن شهاب اخبرني محمود ابن الربيع الانصاري ان عتبان بن مالك ممن شهد بدرا قال في حديث: " فغدا علي رسول الله صلي الله عليه وسلم.
 وابو بكر حين ارتفع النهار.
 قال: وحسبناه علي خزيرة صنعناها له قال: فثاب في البيت رجال ذوو عدد فاجتمعوا فقال قاءل منهم: اين مالك بن الدخشن  او ابن دخشن  فقال بعضهم: ذلك منافق لا يحب الله ورسوله، فقال رسول الله صلي الله عليه وسلم: لا تقل ذلك الا تراه قد قال لا اله الا الله يريد بذلك وجه الله قال: الله ورسوله اعلم فانا نري وجهه ونصيحته الي المنافقين فقال رسول الله صلي الله عليه وسلم: فان الله قد حرم علي النار من قال لا اله الا الله يبتغي بها وجه الله تعالي " * حدثنا عبد
 الله بن ربيع نا محمد بن اسحاق بن السليم نا ابن الاعرابي نا ابو داود نا عبد الله بن مسرة نا معاذ بن هشام الدستواءي نا ابي عن قتادة عن عبيد الله بن بريدة عن ابيه قال: قال رسول الله صلي الله عليه وسلم: " لا تقولوا للمنافق سيدا فانه ان يك سيدا فقد اسخطتم ربكم " * ومن طريق مسلم نا زهير بن حرب نا جرير  هو ابن عبد الحميد  عن منصور ابن المعتمر عن ابي واءل عن ابن مسعود قال: لما كان يوم حنين اثر رسول الله صلي الله عليه وسلم ناسا في القسمة فاعطي الاقرع بن حابس ماءة من الابل، واعطي عيينة بن حصن مثل ذلك، واعطي ناسا من اشراف العرب واثرهم يومءذ في القمسة، فقال رجل: والله ان هذه لقسمة ما يعدل فيها وما اريد بها وجه الله قال فقلت: والله لاخبرن به رسول الله صلي الله عليه وسلم قال: فاتيته فاخبرته بما قال: فتغير وجه رسول الله صلي الله عليه وسلم حتي كان كالصرف ثم قال: " من يعدل اذا لم يعدل الله ورسوله يرحم الله موسي لقد اوذي باكثر من هذا فصبر " قال ابن مسعود: قلت لا جرم لا ارفع اليه بعدها حديثا * ومن طريق مسلم نا محمد بن المثني.
 ومحمد بن رمح قال محمد بن رمح بن المهاجر: انا الليث ابن سعد عن يحيي بن سعيد الانصاري عن ابي الزبير عن جابر، وقال ابن المثني: نا عبد الوهاب عن عبد الحميد الثقفي قال: سمعت يحيي بن سعيد الانصاري يقول: انا ابو الزبير انه سمع جابر بن عبد الله قال: اتي رجل بالجعرانة منصرفه من حنين وفي ثوبه بلال فضة  ورسول الله صلي الله عليه وسلم يقبض منها يعطي الناس فقال: يا محمد اعدل قال: " ويلك ومن يعدل اذا لم اكن اعدل؟ " فقال عمر بن الخطاب: دعني يا رسول الله فاقتل هذا المنافق فقال: " معاذ الله ان يتحدث الناس اني اقتل اصحابي ان هذا واصحابه يقرءون القران لا يجاوز حناجرهم يمرقون منه كما يمرق السهم من الرمية " *

 ومن طريق البخاري نا محمد انا مخلد بن يزيد اخبرنا ابن جريج اخبرني عمرو بن دينار انه سمع جابر بن عبد الله يقول: " غزونا مع رسول الله صلي الله عليه وسلم وقد ثاب معه
 ناس من المهاجرين حتي كثروا وكان من المهاجرين رجل لعاب فكسع انصاريا فغضبت الانصار غضبا شديدا حتي تداعوا فقال الانصاري: يا للانصار، وقال المهاجري يا للمهاجرين فخرج النبي صلي الله عليه وسلم فقال: ما بال دعوي الجاهلية ما شانهم؟ فاخبر بكسعة المهاجري الانصاري فقال النبي صلي الله عليه وسلم: دعوها فانها خبيثة فقال عبد الله بن ابي بن سلول: قد تداعوا علينا لءن رجعنا الي المدينة ليخرجن الاعز منها الاذل فقال عمر بن الخطاب.
 الا تقتل يا نبي الله هذا الخبيث؟  لعبد الله بن ابي  فقال النبي صلي الله عليه وسلم: لا يتحدث الناس ان محمدا يقتل اصحابه " * ومن طريق مسلم نا قتيبة بن سعيد نا عبد الواحد  هو ابن زياد  عن عمارة بن القعقاع عن عبد الرحمن بن ابي نعم قال: سمعت ابا سعيد الخدري يقول: " بعث علي بن ابي طالب الي رسول الله صلي الله عليه وسلم من اليمن بذهيبة في اديم مقروظ لم تخلص من ترابها فقسمها بين اربعة نفر.
 عيينة بن بدر، والاقرع بن حابس، وزيد الخيل وشك في الرابع فقال رجل من اصحابه: كنا نحن احق بها من هءلاء فبلغ ذلك النبي صلي الله عليه وسلم فقال.
 الا تامنوني وانا امين في السماء ياتيني خبر السماء صباحا ومساء، فقام رجل غاءر العينين مشرف الوجنتين ناشز الجبهة كث اللحية محلوق الراس مشمر الازار فقال.
 يا رسول الله اتق الله فقال.
 ويلك او لست احق اهل الارض ان يتقي الله؟ ثم ولي الرجل فقال خالد بن الوليد.
 يا رسول الله الا اضرب عنقه؟ فقال.
 لعله ان يكون يصلي، قال خالد.
 وكم من مصل يقول بلسانه ما ليس في قلبه فقال رسول الله صلي الله عليه وسلم اني لم اومر ان انقب عن قلوب الناس ولا اشق بطونهم انه يخرج من ضءضء هذا قوم يتلون كتاب الله رطبا لا يجاوز حناجرهم يمرقون من الدين كما يمرق السهم من الرمية " * حدثنا محمد بن سعيد بن نبات نا احمد بن عون الله نا قاسم بن اصبغ نا محمد بن عبد السلام الخشني نا محمد بن بشار نا محمد بن جعفر نا شعبة قال: سمعت قتادة يحدث عن ابي نضرة عن قيس بن عباد قلت: " لعمار ارايت قتالكم هذا اراي
 رايتموه فان الراي يخطء ويصيب؟ او عهد عهد اليكم رسول الله صلي الله عليه وسلم فقال.
 ما عهد الينا رسول الله صلي الله عليه وسلم شيءا لم يعهده الي الناس كافة، وقد قال رسول الله صلي الله عليه وسلم احسبه قال: حدثني حذيفة انه قال: في امتي اثنا عشر منافقا لا يدخلون الجنة ولا يجدون ريحها حتي يلج الجمل في سم الخياط ثمانية منهم يكفيكهم الرسلة سراج من النار يظهر بين اكتافهم  حتي ينجم من ظهورهم " * حدثنا محمد بن سعيد بن نبات نا احمد بن عبد البصير نا قاسم بن اصبغ نا محمد بن عبد السلام الخشني نا محمد بن المثني نا ابو احمد  هو الزبيري  نا سفيان الثوري عن سلمة بن كهيل عن عياض بن عياض عن ابيه عن ابن مسعود قال: " خطبنا رسول الله صلي الله عليه وسلم فذكر في خطبته ما شاء الله تعالي، ثم قال: ان منكم منافقين فمن سميت فليقم ثم قال: قم يا فلان قم يا فلان قم يا فلان حتي عد ستة وثلاثين ثم قال: ان منكم وان فيكم فسلوا الله العافية فمر عمر برجل مقنع قد كان بينه وبينه معرفة قال ما شانك؟ فاخبره بما قال النبي صلي الله عليه وسلم فقال له عمر: تبا لك ساءر اليوم " * ومن طريق مسلم نا الحسن بن علي الحلواني نا ابن ابي مريم انا محمد بن جعفر اخبرني زيد بن اسلم عن عطاء بن يسار عن ابي سعيد الخدري ان رجلا من المنافقين في عهد رسول الله صلي الله عليه وسلم كان اذا خرج رسول الله صلي الله عليه وسلم تخلفوا عنه وفرحوا بمقعدهم خلاف رسول الله صلي الله عليه وسلم فاذا قدم النبي عليه السلام اعتذروا اليه وحلفوا واحبوا ان يحمدوا بما لم يفعلوا فلا تحسبنهم بمفازة من العذاب * ومن طريق مسلم نا زهير بن حرب انا احمد الكوفي نا الوليد بن جميع نا ابو الطفيل قال: كان بين رجل من اهل العقبة وبين حذيفة ما يكون بين الناس فقال: انشدك الله كم كان اصحاب العقبة فقال له القوم: اخبره اذ سالك قال  يعني حذيفة  كنا نخبر انهم اربعة عشر فان كنت فيهم فقد كان القوم خمسة عشر واشهد بالله ان اثني عشر منهم حزب لله ولرسوله ويوم يقوم الاشهاد وعذر ثلاثة وعذر ثلاثة قالوا: ما سمعنا منادي رسول الله صلي الله عليه
 وسلم ولا علمنا بما اراد القوم * قال ابو محمد: ليست هذه العقبة العقبة الفاضلة المحمودة قبل الهجرة تلك كانت للانصار خالصة شهدها منهم رضي الله عنهم سبعون رجلا وثلاث نسوة ولم يشهدها احد من غيرهم الا رسول الله صلي الله عليه وسلم وحده والعباس عمه وهو غير مسلم يومءذ لكنه شفقة علي ابن اخيه * ومن طريق مسلم نا ابو كريب جعفر بن غياث عن الاعمش عن ابي سفيان عن جابر ان رسول الله صلي الله عليه وسلم قدم من سفر فلما كان قرب المدينة هاجت ريح تكاد ان تدفن الراكب فزعم ان رسول الله صلي الله عليه وسلم قال: بعثت هذه الريح لموت منافق وقدم المدينة فاذا عظيم من المنافقين قد مات * قال ابو محمد: واحاديث موقوفة علي حذيفة فيها انه كان يدري المنافقين وان عمر ساله اهو منهم؟ قال.
 لا ولا اخبر احدا بعدك بمثل هذا وان عمر كان ينظر اليه فاذا حضر حذيفة جنازة حضرها عمر وان لم يحضرها حذيفة لم يحضرها عمر  وفي بعضها منهم شيخ لو ذاق الما ما وجد له طعما كلها غير منسندة، وعن حذيفة قال: مات رجل من المنافقين فلم اذهب الي الجنازة فقال.
 هو منهم فقال له عمر.
 انا منهم قال.
 لا، وعن محمد بن اسحاق ني عاصم بن عمر بن قتادة بن النعمان الطفري قال.
 قلت لمحمود بن لبيد هل كان الناس يعرفون النفاق فيهم؟ قال.
 نعم والله ان كان الرجل ليعرفه من اخيه ومن ابيه ومن بني عمه ومن عشيرته، ثم يلبس بعضهم بعضا علي ذلك قال محمود.
 " لقد اخبرني رجل من قومي عن رجل من المنافقين معروف نفاقه كان يسير مع رسول الله صلي الله عليه وسلم حيث سار فلما كان من امر الحجر ما كان ودعا رسول الله صلي الله عليه وسلم حين دعا فارسل الله السحابة فامطرت حتي ارتوي الناس اقبلنا عليه نقول.
 ويحك ابعد هذا شء؟ قال: سحابة مارة ثم ان رسول الله صلي الله عليه وسلم سار حتي كان ببعض الطريق ضلت ناقته فخرج اصحاب رسول الله صلي الله عليه وسلم في طلبها وعند رسول الله
 صلي الله عليه وسلم رجل من اصحابه يقال له عمارة بن حزم وكان عقيبا بدريا  وهو من بني عمرو بن مخزوم  وكان في رحل يزيد بن نصيب القينقاعي وكان منافقا فقال زيد وهو في رحل عمارة وعمارة عند النبي عليه السلام.
 اليس محمد يزعم انه نبي ويخبركم عن خبر السماء ولا يدري اين ناقته؟ فقال رسول الله صلي الله عليه وسلم وعمارة عنده: ان رجلا قال هذا محمد يخبركم انه نبي ويزعم انه يخبركم بخبر السماء وهو لا يدري اين ناقته واني والله ما اعلم الا ما علمني الله وقد دلني عليها وهي في هذا الوادي من شعب كذا وكذا وقد حبستها شجرة بزمامها فانطلقوا حتي تاتوني بها فذهبوا فجاءوا بها فرجع عمارة بن حزم الي رحله فقال.
 والله لاعجب من شء حدثناه رسول الله صلي الله عليه وسلم انفا عن مقالة قاءل اخبره الله عنه كذا وكذا للذي قال زيد بن نصيب فقال رجل ممن كان في رحل عمارة ولم يحضر رسول الله صلي الله عليه وسلم زيد والله قال هذه المقالة قبل ان تاتي فاقبل عمارة علي زيد يجافي عنقه ويقول يا ال عباد الله ان في رحلي الراهبة وما اشعر اخرج اي عدو الله من رحلي فلا تصحبني " وعن زيد بن وهب قال.
 كنا عند حذيفة  وهو من طريق البخاري  فقال حذيفة.
 ما بقي من اصحاب هذه الاية الا ثلاثة يعني قوله تعالي.
 (قاتلوا اءمة الكفر) الي قوله: (ينتهون) قال حذيفة.
 ولا بقي من المنافقين الا اربعة فقال له اعرابي انكم اصحاب محمد تخبروننا بما لا ندري فما هءلاء الذين ينقرون بيوتنا ويسرقون اعلافنا قال.
 اولءك الفساق اجل لم يبق منهم الا اربعة شيخ كبير لو شرب الماء وجد له بردا *

 قال ابو محمد: هذا كل ما حضرنا ذكره من الاخبار وليس في شء منها حجة اصلا، اما حديث مالك بن الدخشن فصحيح وهو اعظم حجة عليهم لان رسول الله صلي الله عليه واله اخبر بان شهادة التوحيد تمتع صاحبها وهكذا قال رسول الله صلي الله عليه وسلم: " نهيا عن قتال المصلين " * واما حديث بريدة الاسلمي " لا تقولوا للمنافق سيدا "
 فان هذا عموما لجميع الامة ولا يخفي هذا علي احد واذ الامر كذلك فاذا عرفنا المنافق ونهينا ان نسميه سيدا فليس منافقا بل مجاهر، واذا عرفنا من المنافق ونحن لا نعلم الغيب ولا ما في ضميره فهو معلن لا مسر، وقد يكون هذا الحديث ايضا علي وجه اخر وهو ان النبي عليه السلام قد صح عنه ان خصلا من كن فيه كان منافقا خالصا وقد ذكرناها قبل، وليس هذا نفاق الكفر لكنه منافق لاظهاره خلاف ما يضمره في هذه الخلال المذكورة في كذبه، وغدره.
 وفجوره.
 واخلاقه.
 وخيانته ومن هذه صفاته فلا يجوز ان يسمي سيدا ومن سماه سيدا فقد اسخط الله تعالي باخبار رسول الله صلي الله عليه وسلم بذلك * واما حديث ابن مسعود فان القاءل ان رسول الله صلي الله عليه وسلم لم يعدل ولا اراد وجه الله تعالي فما عمل فهو كافر معلن بلا شك، وكذلك القاءل في حديث جابر اذ استاذن عمر في قتله اذ قال: اعدل يا رسول الله فنهي رسول الله صلي الله عليه وسلم عمر عن ذلك واخبر بانه لا يقتل اصحابه وكذلك ايضا في استءذان عمر في قتل عبد الله بن ابي ان هءلاء صاروا باظهارهم الاسلام بعد ان قالوا ما قالوا: حرمت دماءهم وصاروا بذلك من جملة اصحابه عليه السلام * قال ابو محمد: فهذا ما احتج به من راي ان المرتد لا يقتل اصلا لان هءلاء مرتدون بلا شك ولم يقتلهم رسول الله صلي الله عليه وسلم وقد قتل اصحابه الفضلاء كماعز والغامدية والجهينية اذ وجب القتل عليهم ولو كان القتل علي هءلاء المرتدين لما ضيع ذلك اصلا * قال ابو محمد: فنقول وبالله تعالي التوفيق انه لا خلاف بين احد من الامة في انه لا يحل لمسلم ان يسمي كافرا معلنا بانه صاحب رسول الله صلي الله عليه وسلم ولا انه من اصحاب النبي عليه السلام وهو عليه السلام قد اثني علي اصحابه فصح انهم اظهروا الاسلام فحرمت بذلك دماءهم في ظاهر الامر وباطنهم الي الله تعالي في صدق او كذب فان كانوا صادقين في توبتهم فهم اصحابه حقا عند الناس ظاهرهم وعند الله تعالي باطنهم وظاهرهم فهم الذين اخبر رسول الله صلي اله عليه وسلم انهم لو انفق احدنا مثل احد ذهبا ما بلغ نصيف مد احدهم
 وان كانوا كاذبين فهم في الظاهر مسلمون وعند الله تعالي كفار، وهكذا القول في حديث  ابي سعيد الذي قد ذكرناه اذ استاذنه خالد في قتل الرجل فقال لا لعله ان يكون يصلي فقد صح نهي النبي عليه السلام لخالد عن قتله ولو حل قتله لما نهاه رسول الله صلي الله عليه وسلم عن ذلك واخبر رسول الله صلي الله عليه وسلم بالسبب المانع من قتله وهو انه لعله يصلي فقال له خالد رب مصل يقول بلسانه ما ليس في قلبه فاخبره انه لم يبعث ليشق عن قلوب الناس فانما عليه الظاهر واخبرنا عليه السلام انه لا يدري ما في قلوبهم وان ظاهرهم مانع من قتلهم اصلا، وقد جاء هذا الخبر من طريق لا تصح وفيه انه عليه السلام امر ابا بكر.
 وعمر بقتله فوجده يركع ووجده الاخر يسجد فتركاه وامر عليا بقتله فمضي فلم يجده، وانه عليه السلام قال: لو قتل لم يختلف من امتي اثنان وهذا لا يصح اصلا ولا وجه للاشتغال به، واما حديث عمار في امتي اثنا عشر منافقا فليس فيه ان رسول الله صلي الله عليه وسلم عرفهم باعيانهم وهو اخبار بصفة عن عدد فقط ليس فيهم بيان انهم عرفوا باسماءهم فسقط التعلق بهذا الخبر وبالله تعالي التوفيق * واما حديث ابن مسعود فانه لا يصح فان قد روينا من طريق قاسم بن اصبغ نا احمد بن زهير بن حرب نا ابو نعيم عن سفيان الثوري عن سلمة بن كهيل عن رجل عن ابيه عن ابن مسعود فذكر هذا الحديث وقال سفيان عن هذا الرجل الذي لم يسم عن ابيه اراه عياض بن عياض فقد اخبر ابو نعيم عن سفيان انه مشكوك فيه، ثم لو صح لما كانت لهم فيه حجة لانهم قد انكشفوا واشتهر امرهم فليسوا منافقين بل هم مجاهرون فلابد من احد امرين لا ثالث لهما، اما ان يكونوا تابوا فحقنت دماءهم بذلك، واما انهم لم يتوبوا فهو مما تعلق به من لا يري قتل المرتد علي ما ذكرنا * واما حديث ابي سعيد فانما فيه انهم ليسوا مامونين من العذاب وهذا ما لا شك فيه ليس فيه ان رسول الله صلي الله عليه وسلم عرف كفرهم * واما حديث حذيفة
 فساقط لانه من طريق الوليد بن جميع وهو هالك ولا نراه يعلم من وضع الحديث فانه قد روي اخبارا فيها ان ابا بكر.
 وعمر.
 وعثمان.
 وطلحة.
 وسعد بن ابي وقاص رضي الله عنهم ارادوا قتل النبي صلي الله عليه وسلم والقاءه من العقبة في تبوك وهذا هو الكذب الموضوع الذي يطعن الله تعالي واضعه فسقط التعلق به والحمد لله رب العالمين * واما حديث جابر فراويه ابو سفيان طلحة بن نافع وهو ضعيف، ثم لو صح لما كانت فيه الحجة لانه ليس فيه الا هبوب الريح لموت عظيم من عظماء المنافقين فانما في هذا انكشاف امره بعد موته فلم يوقن قط بان رسول الله صلي الله عليه وسلم علم نفاقه في حياته فلا يجوز ان يقطع بالظن علي رسول الله صلي الله عليه وسلم *

 واما الموقوفة علي حذيفة فلا تصح ولو صحت لكانت بلا شك علي ما بينا من انهم صح نفاقهم وعاذوا بالتوبة ولم يقطع حذيفة ولا غيره علي باطن امرهم فتورع عن الصلاة عليهم، وفي بعضها ان عمر ساله انا منهم فقال له لا ولا اخبر احدا غيرك بعدك وهذا باطل كما تري لان من الكذب المحض ان يكون عمر يشك في معتقد نفسه حتي لا يدري امنافق هو ام لا؟ وكذلك ايضا لم يختلف اثنان من اهل الاسلام في ان جميع المهاجرين قبل فتح مكة لم يكن فيهم منافق انما كان النفاق في قوم من الاوس والخزرج فقط فظهر بطلان هذا الخبر * واما حديث محمود بن لبيد فمنقطع ومع هذا فانما فيه انهم كانوا يعرفون المنافقين منهم واذ الامر كذلك فليس هذا نفا قابل هو كفر مشهور وردة ظاهرة هذا حجة لمن راي انه لا يقتل المرتد * واما حديث حذيفة لم يبق من اصحاب هذه الاية الا ثلاثة فصحيح ولا حجة لهم فيه لان في نص الاية ان يقاتلوا حتي ينتهوا فبيقين ندري انهم لو لم ينتهوا لما ترك قتالهم كما امر الله تعالي، وكذلك ايضا قوله انه لم يبق من المنافقين الا اربعة فلا شك عند احد من الناس ان اولءك الاربعة كانوا يظهرون الاسلام وانه لا يعلم غيب القلوب الا الله تعالي فهم
 ممن اظهر التوبة بيقين لا شك فيه ثم الله تعالي اعلم بما في نفوسهم * قال ابو محمد: ويبين هذا ما رويناه من طريق البخاري نا عمر بن حفص بن غياث نا ابي نا الاعمش ني ابراهيم النخعي عن الاسود قال: كنا في حلقة عبد الله بن مسعود فجاء حذيفة حتي قام علينا فسلم ثم قال: لقد انزل النفاق علي قوم خير منكم قال الاسود: سبحان الله ان الله تعالي يقول: (ان المنافقين في الدرك الاسفل من النار) فتبسم عبد الله بن مسعود وجلس حذيفة في ناحية المسجد فقام عبد الله فتفرق اصحابه فرماني حذيفة بالحصي فاتيته فقال حذيفة: عجبت من ضحكه وقد علم ما قلت لقد انزل الله النفاق علي قوم كانوا خيرا منكم ثم تابوا فتاب الله عليهم * روينا من طريق البخاري نا ادم بن ابي اياس نا شعبة عن واصل الاحدب عن ابي واءل شقيق ابن سلمة عن حذيفة بن اليمان قال: ان المنافقين اليوم شر منهم علي عهد رسول الله صلي الله عليه وسلم كانوا حينءذ يسرون واليوم يجهرون * قال ابو محمد: فهذان اثران في غاية الصحة في احدهما بيان ان المنافقين علي عهد رسول الله صلي الله عليه وسلم كانوا يسرون وفي الثاني انهم تابوا فبطل تعلق من تعلق بكل اية وكل خبر ورد في المنافقين وصح انهم قسمان.
 اما قسم لم يعلم باطن امره فهذا لا حكم له في الاخرة.
 وقسم علم باطن امره وانكشف فعاذ بالتوبة قالوا: ان  الذي جور رسول الله صلي الله عليه وسلم وقال انه لم يعدل ولا اراد بقسمته وجه الله مرتد لا شك فيه منكشف الامر وليس في شء من الاخبار انه تاب من ذلك ولا انه قتل بل فيها النهي عن قتله قلنا: اما هذا فحق كما قلتم لكن الجواب في هذا ان الله تعالي لم يكن امر بعد بقتل من ارتد فلذلك لم يقتله رسول الله صلي الله عليه وسلم ولذلك نهي عن قتله ثم امره الله تعالي بعد ذلك بقتل من ارتد عن دينه فنسخ تحريم قتلهم * برهان ذلك ما رويناه من طريق مسلم نا هناد بن السري نا ابو الاحوص عن سعيد بن مسروق
 عن عبد الرحمن بن ابي نعيم عن ابي سعيد الخدري قال: " بعث علي  وهو باليمن  بذهيبة في تربتها الي رسول الله صلي الله عليه وسلم فقسمها رسول الله صلي الله عليه وسلم بين اربعة نفر الاقرع ابن حابس الحنظلي.
 وعيينة بن بدر الفزاري.
 وعلقمة بن علاثمة العامري.
 وزيد الخيل الطاءي احد بني نبهان فذكر الحديث وفيه فجاء رجل كث اللحية مشرف الوجنتين غاءر العينين ناتء الجبين محلوق الراس فقال: اتق الله يا محمد فقال له رسول الله صلي الله عليه وسلم: فمن يطع الله ان عصيته ايامنني علي اهل الارض ولا تامنوني فاستاذن رجل في قتله  يرون انه خالد بن الوليد  فقال رسول الله صلي الله عليه وسلم: ان من ضءضء هذا قوما يقرءون القران لا يجاوز حناجرهم يقتلون اهل الاسلام ويدعون اهل الاوثان يمرقون من الاسلام كما يمرق السهم من الرمية لءن ادركتهم لاقتلنهم قتل عاد " * حدثنا هشام ابن سعيد انا عبد الجبار بن احمد نا الحسن بن الحسين البجيرمي نا جعفر بن محمد نا يونس ابن حبيب نا ابو داود الطيالسي نا سلام بن سليمان  هو ابو الاحوص  عن سعيد ابن مسروق عن عبد الرحمن بن ابي نعيم عن ابي سعيد الخدري " ان عليا بعث الي النبي صلي الله عليه وسلم بذهيبة في تربتها فقسمها النبي صلي الله عليه وسلم بين اربعة نفر بين عيينة ابن حصن بن بدر الفزاري.
 وعلقمة بن علاثة الكلابي.
 والاقرع بن حابس التميمي.
 وزيد الخيل الطاءي فغضبت قريش والانصار وقالوا: يعطي صناديد اهل نجد ويدعنا فقال رسول الله صلي الله عليه وسلم: انما اعطيتهم اتالفهم فقام رجل غاءر العينين محلوق الراس مشرف الوجنتين ناتء الجبين فقال: اتق الله يا محمد فقال رسول الله صلي الله عليه وسلم فمن يطع الله ان عصيته انا ايامنني علي اهل الارض ولا تامنوني فاستاذن عمر في قتله فابي ثم قال رسول الله صلي الله عليه وسلم.
 يخرج من ضءضء هذا قوم يقرءون القران لا يجاوز حناجرهم يمرقون من الاسلام كما يمرق السهم من الرمية يقتلون اهل الاسلام ويدعون اهل الاوثان والله لءن ادركتهم لاقتلنهم قتل عاد " *

 قال ابو محمد: فصح كما تري الاسناد الثابت ان هذا المرتد استاذن عمر بن الخطاب.
 وخالد بن الوليد في قتله فلم ياذن لهما رسول الله صلي الله عليه وسلم في ذلك واخبر عليه السلام في فوره ذلك انه سياتي من ضءضءه عصابة ان ادركهم قتلهم وانهم يمرقون من الاسلام كما يمرق السهم من الرمية فقد خرج عنه ومن خرج عنه بعد كونه فدخوله كدخول السهم في الرمية فقد ارتد عنه فصح انذار النبي عليه السلام بوجوب قتل المرتد وانه قد علم عن الله تعالي انه سيامر بذلك بعد ذلك الوقت فثبت ما قلناه من ان قتل من ارتد كان حراما ولذلك نهي عنه عليه السلام ولم ياذن به لا لعمر ولا لخالد ثم انه عليه السلام نذر بانه سيباح قتله وانه سيجب قتل من يرتد فصح يقينا نسخ ذلك الحال وقد نسخ ذلك بما رويناه عن ابن عباس.
 وابن مسعود.
 وعثمان.
 ومعاذ عن رسول الله صلي الله عليه وسلم * قال ابو محمد رحمه الله: فاذ قد بطلت هذه المقالة من ان لا يقتل المرتد وصح انه من قال انه تعلق بمنسوخ فلم يبق الا قول من قال يستتاب وقد ذكرناه *   مسالة  حد الزنا  قال ابو محمد رحمه الله: قال الله تعالي: (ولا تقربوا الزنا انه كان فاحشة) وقال تعالي: (ولا يزنون) الاية فحرم تعالي الزنا وجعله من الكباءر توعد فيه بالنار * حدثنا عبد الرحمن بن عبد الله بن خالد نا ابراهيم بن احمد نا الفربري نا البخاري نا محمد بن المثني نا اسحاق بن يوسف نا الفضل بن غزوان عن عكرمة عن ابن عباس قال قال رسول الله صلي الله عليه وسلم: " لا يزني العبد حين يزني وهو مءمن ولا يسرق حين يسرق وهو مءمن ولا يشرب حين يشرب وهو مءمن ولا يقتل حين يقتل وهو مءمن " قال عكرمة قلت لابن عباس كيف ينتزع الايمان منه قال هكذا وشبك بين اصابعه ثم اخرجها فان تاب عاد اليه هكذا وشبك بين اصابعه * ومن طريق البخاري نا ادم نا شعبة عن الاعمش عن ذكوان  هو ابو صالح  عن ابي هريرة قال قال رسول الله صلي الله عليه وسلم: " لا يزني الزاني
 حين يزني وهو مءمن ولا يسرق حين يسرق وهو مءمن ولا يشرب حين يشرب وهو مءمن والتوبة معروضة " نا عبد الله بن ربيع التميمي نا محمد بن معاوية المرواني نا احمد بن شعيب انا اسحاق بن راهويه انا الوليد بن مسلم عن الاوزاعي قال ني سعيد بن المسيب  وابو سلمة بن عبد الرحمن بن عوف.
 وابو بكر بن عبد الرحمن بن الحارث بن هشام كلهم حدثوني عن ابي هريرة عن النبي صلي الله عليه وسلم قال: " لا يزني الزاني حين يزني وهو مءمن ولا يسرق حين يسرق وهو مءمن ولا يشرب الخمر حين يشربها وهو مءمن ولا ينتهب نهبة ذات شرف فيرفع المسلمون اليها ابصارهم حين ينتهبها وهو مءمن " *

 قال ابو محمد رحمه الله: الايمان هو جميع الطاعة فاي طاعة اطاع العبد بها ربه فهي ايمان وهو بفعله اياها مءمن واي معصية عصي بها العبد ربه فليست ايمانا فهو بفعله اياها غير مءمن والايمان والطاعة شء واحد فمعني ليس مءمنا ليس مطيعا لله تعالي ولو كان نفي الايمان ههنا ايجابا للكفر لوجب قتل السارق ومن ذكر معه علي الردة هذا لا يقوله احد ولا فعله رسول الله صلي الله عليه وسلم * حدثنا حمام نا عباس بن اصبغ نا محمد بن عبد الملك ابن ايمن نا محمد بن اسماعيل الترمذي نا الحميدي نا سفيان بن عيينة عن الاعمش عن عبد الله ابن مرة عن مسروق عن عبد الله بن مسعود ان رسول الله صلي الله عليه وسلم قال: " لا يحل دم امرء مسلم يشهد ان لا اله الا الله واني رسول الله الا في احدي ثلاث رجل كفر بعد ايمانه او زني بعد احصانه او نفس بنفس " * وقد روي عن عثمان رضي الله عنه انه قال وهو محصور في الدار بم تقتلونني؟ وقد سمعت رسول الله صلي الله عليه وسلم يقول لا يحل دم امرء مسلم الا باحدي ثلاث رجل كفر بعد ايمان او زني بعد احصان او قتل نفسا فقتل بها * قال ابو محمد رحمه الله: وعظم الله تعالي بعض الزنا علي بعض وكله عظيم ولكن المعاصي بعضها اكبر من بعض فعظم الله الزنا بحليلة الجار وبامراة المجاهد وزنا الشيخ * وروينا من طريق مسلم نا اسحاق بن ابراهيم انا جرير عن منصور عن ابي واءل
 عن عمرو بن شرحبيل عند عبد الله بن مسعود قال: " سالت رسول الله صلي الله عليه وسلم اي الذنب اعظم عند الله تعالي قال ان تدعو لله ندا وهو خلقك قلت ثم اي قال ان تقتل ولدك مخافة ان يطعم معك قلت ثم اي قال ان تزاني بحليلة جارك " * وبه الي مسلم نا ابو بكر ابن ابي شيبة نا وكيع عن سفيان عن علقمة بن مرثد عن سليمان بن بريدة عن ابيه قال قال رسول الله صلي الله عليه وسلم: " حرمة نساء المجاهدين علي القاعدين كحرمة امهاتهم وما من رجل من القاعدين يخلف رجلا من المجاهدين في اهله فيخونه فيهم الا وقف له يوم القيامة فياخذ من عمله ما شاء فما ظنكم؟ " * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب نا محمد بن المثني انا محمد بن جعفر نا شعبة عن منصور قال سمعت ربعي ابن حراش يحدث عن زيد بن ظبيان رفعه الي ذر عن النبي صلي الله عليه وسلم قال: " ثلاثة يحبهم الله وثلاثة يبغضهم ثلاثة الذين يبغضهم الله الشيخ الزاني والفقير المختال والغني الظلوم " * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب نا محمد بن العلاء نا ابو معاوية عن الاعمش عن ابي حازم عن ابي هريرة قال قال رسول الله صلي الله عليه وسلم: " ثلاثة لا ينظر الله اليهم ولا يزكيهم ولهم عذاب اليم شيخ زان.
 وملك كذاب.
 وعامل مستكبر " * قال احمد بن شعيب ونا عبد الرحمن بن محمد بن سلام نا محمد بن ربيعة نا الاعمش  عن ابي حازم عن ابي هريرة عن النبي صلي الله عليه وسلم فذكره، وقال فيه الشيخ الزاني والامام الكذاب والعامل المختال " * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا ابو داود الحزامي نا عارم  هو محمد بن الفضل  نا حماد بن زيد نا عبيد الله بن عمر عن سعيد بن ابي سعيد المقبري عن ابي هريرة " ان رسول الله صلي الله عليه وسلم قال: اربعة يبغضهم الله البياع الحلاف والفقير المختال والشيخ الزاني والامام الجاءر " *  مسالة  ما الزنا؟ قال علي: قال الله تعالي: (والذين هم لفروجهم حافظون الا علي ازواجهم) الي قوله: (فاءلءك هم العادون) وصح ان رسول الله صلي الله عليه وسلم قال.
 " الولد للفراش
 وللعاهر الحجر " وقد ذكرناه باسناده فيما تقدم فصح انه ليس الوطء الا مباحا لا يلام فاعله او عهرا في غير الفراش وههنا وطءان اخران، احدهما من وطء فراشا مباحا في حال محرمة كواطء الحاءض والمحرمة والمحرم والصاءم فرضا والصاءمة كذلك والمعتكف والمعتكفة والمشركة فهذا عاص وليس زانيا باجماع الامة كلها الا انه وطء فراشا حرم بوجه ما فاذا ارتفع ذلك الوجه حل له وطءها، والثاني من جهل فلا ذنب له وليس زانيا فبعد هذين الوطءين فليس الا من وطء امراته المباحة بعقد نكاح صحيح او بملك يمين صحيح يحل فيه الوطء او عاهر وهو من وطء من لا يحل له النظر الي مجردها وهو عالم بالتحريم فهذا هو العاهر الزاني وبالله تعالي التوفيق *   مسالة حد الزنا  قال علي رحمه الله: قال الله تعالي.
 (واللاتي ياتين الفاحشة من نساءكم) الاية الي قوله تعالي: (فاعرضوا عنهما) * قال ابو محمد رحمه الله: فصح النص والاجماع علي ان هذين الحكمين منسوخان بلا شك، ثم اختلف الناس فقالت طاءفة: ان قوله تعالي: (واللذان ياتيانها منكم فاذوهما) ناسخ لقوله: (واللاتي ياتين الفاحشة من نساءكم) الي قوله تعالي: (او يجعل الله لهن سبيلا) وحمل من قال هذا قوله عزوجل: (واللذان ياتيانها منكم) علي ان المراد بها الزاني والزانية، وقال اخرون: ليس احد الحكمين ناسخا للاخر لكن قوله تعالي: (فامسكوهن في البيوت) هذا كان حكم الزواني من النساء ثيباتهن وابكارهن وقوله تعالي: (واللذان ياتيانها منكم فاذوهما) هذا حكم الزانين من الرجال خاصة الثيب منهم والبكر * قال ابو محمد رحمه الله: وهذا قول ابن عباس وغيره كما نا ابو سعيد الجعفري نا محمد بن علي الادفوي المقري نا ابو جعفر احمد بن محمد بن اسماعيل النحوي نا بكر ابن سهل نا عبد الله بن صالح نا معاوية بن صالح عن علي بن ابي طلحة عن ابن عباس انه قال في قول الله تعالي: (واللاتي تاتين الفاحشة من نساءكم فاستشهدوا عليهن اربعة  منكم فان شهدوا فامسكوهن في البيوت) فكانت المراة اذا زنت تحبس في البيت حتي تموت ثم انزل الله تعالي بعد ذلك (الزانية والزاني فاجلدوا كل واحد منهما ماءة جلدة) وان كانا محصنين رجما فهذا السبيل الذي جعل الله لهما، قال ابن عباس: وقوله تعالي: (واللذان ياتيانها منكم فاذوهما) فكان الرجل اذا زني اوذي بالتعيير وضرب النعال فانزل الله تعالي بعد هذا (الزانية والزاني فاجلدوا كل واحد منهما ماءة جلدة) فان كانا محصنين رجما في سنة رسول الله صلي الله عليه وسلم * نا ابو سعيد الجعفري نا محمد بن علي الادفوي نا ابو جعفر احمد بن محمد بن اسماعيل ثنا احمد بن محمد انا سلمة  هو ابن شبيب  نا عبد الرزاق نا معمر عن قتادة في قول الله تعالي: (فامسكوهن في البيوت حتي يتوفاهن الموت او يجعل الله لهن سبيلا) قال: نسختها الحدود، وقال قتادة ايضا: في قوله تعالي: (والذان ياتيانها منكم فاذوهما) نسختها الحدود * قال ابو محمد رحمه الله: وهذا هو القول الصحيح لان قوله تعالي: (واللاتي ياتين الفاحشة من نساءكم) الي قوله: (فامسكوهن في البيوت حتي يتوفاهن الموت او يجعل الله لهن سبيلا) انما فيه حكم النساء فقط وليس فيها حكم الرجال اصلا، ثم عطف الله تعالي عليها متصلا بها قوله تعالي: (واللذان ياتيانها منكم فاذوهما) فكان هذا حكما زاءدا للرجال مضافا الي ما قبله من حكم النساء ولا يجوز البتة ان يقال في شء من القران انه منسوخ بكذا ولا انه ناسخ لكذا الا بيقين لانه اخبار عن مراد الله تعالي ولا يمكن ان يعلم مراد الله تعالي منا الا بنص قران او سنة ثابتة عن رسول الله صلي الله عليه وسلم فانها بوحي من الله تعالي او باجماع متيقن من جميع الصحابة رضي الله تعالي عنهم قالوه عن توقيف من رسول الله صلي الله عليه وسلم لهم علي ذلك او بضرورة وهو ان يتيقن تاخير احد النصين بعد الاخر ولا يمكن استعمالهما جميعا فندري حينءذ بيقين ان الله تعالي ابطل حكم الاول بالنص الاخر، وكذلك ما جاء عن رسول الله صلي الله تعالي عليه وسلم ولا فرق، فمن اخبر عن مراد الله تعالي منا بشء من دين الله
 تعالي بغير احد هذه الوجوه فقد اخبر عن الله تعالي بما لا علم له وهذا هو الكذب علي الله تعالي بلا شك اخبر عنه بما لم يخبر به تعالي عن نفسه فصح يقينا ان حكم النساء الزواني كان الحبس في البيوت حتي يمتن او يجعل الله لهن سبيلا بحكم اخر وان حكم الرجال الزناة كان الاذي هذا ما لا شك فيه عند احد من الامة ثم نسخ هذا كله بالحدود بلا خلاف من احد من الامة وليس معنا يقين بان حبس الزواني من النساء نسخ بالاذي، ثم نسخ عنهن الاذي بالحد هذا ما لم يات به قران ولا سنة  ولا اجماع ولا اوجبته ضرورة فلم يجز القول به وبالله تعالي التوفيق * قال ابو محمد: فلما صح بالنص والاجماع ان الحبس والاذي منسوخان عن الزواني والزناة باليقين الذي لا شك فيه بالحدود وجب ان ننظر في الناسخ ما هو فوجدنا الناس قد اجمعوا علي ان الحر الزاني والحرة الزانية اذا كانا غير محصنين فان حدهما ماءة جلدة ثم اختلفوا فقالت طاءفة: ومع الماءة جلدة نفي سنة، وقالت طاءفة: هذا علي الرجل واما المراة فلا نفي عليها، وقالت طاءفة: لا نفي في ذلك لا علي رجل ولا علي امراة، ثم اتفقوا كلهم حاش من لا يعتد به بلا خلاف وليس هم عندنا من المسلمين فقالوا: ان علي الحر والحرة اذا زنيا وهما محصنان الرجم حتي يموتا ثم اختلفوا فقالت طاءفة: عليهما مع الرجم المذكور جلد ماءة لكل واحد منهما، وقالت طاءفة: ليس عليهما الا الرجم ولا جلد عليهما، وقالت الازارقة من الخوارج ليس عليهما الا الجلد فقط ولا رجم علي زان اصلا، ثم وجدنا الامة قد اتفقت بلا خلاف من احد منهم علي ان الامة اذا احصنت فعليها خمسون جلدة * قال ابو محمد رحمه الله: ولا ندري احدا اوجب عليها مع ذلك الرجم ولا يقطع علي ان المنع من رجمها اجماع والله اعلم، ثم اختلفوا فقالت طاءفة عليها نفي ستة اشهر مع الجلد، وقالت طاءفة: لا نفي عليها مع ذلك اصلا ثم اختلفوا في الامة اذا لم تحصن وزنت فقالت طاءفة: عليها خمسون جلدة ونفي ستة اشهر، وقالت طاءفة:
 ليس عليها الا خمسون جلدة فقط ولا نفي عليها، وقالت طاءفة: لا شء عليها لا جلد ولا نفي اصلا * ثم اختلفوا في حد العبد اذا زني وهو محصن او غير محصن فقالت طاءفة: حده كحد الامة علي حسب اختلافهم في النفي مع الجلد او اسقاط النفي وقالت طاءفة: حده كحد الحر الرجم او النفي * واختلفوا في حد من بعضه حر وبعضه عبد اذا زني من العبيد والاماء فقالت طاءفة: حده حد العبد التام الرق او الرجم والنفي والامة التامة الرق، وقالت طاءفة: عليه من الجلد والنفي بحساب ما فيه من الحرية وبحساب ما فيه من الرق * قال ابو محمد رحمه الله: ونحن ان شاء الله تعالي ذاكرون جميع هذه المساءل مسالة مسالة ومتقصون ما احتجب به كل طاءفة لقولها ومبينون بعون الله تعالي صواب القول في ذلك بالبراهين من القران والسنة كما فعلنا في ساءر كتابنا هذا والحمد لله رب العالمين وبه تعالي نستعين ونعتصم *   مسالة  حد الحر والحرة غير المحصنين *

 قال ابو محمد رحمه الله: قال الله تعالي: (الزانية والزاني فاجلدوا كل واحد منهما ماءة جلدة ولا تاخذكم بهما رافة في دين الله ان كنتم تءمنون بالله واليوم الاخر وليشهد عذابهما طاءفة من المءمنين) * قال ابو محمد رحمه الله: فجاء النص كما تري ولم يختلف احد من اهل القبلة في ان حكم الزاني الحر غير المحصن والزانية الحرة غير المحصنة وانما اختلف الناس في هل عليها نفي كما ذكرنا ام لا؟ وهذا باب قد تقصيناه في ابواب مجموعة صدنا بها قبل كلامنا في المرتدين ذكرنا فيها كل حكم يختص به حدان من الحدود فصاعدا وتقصينا هنالك الاثار باسانيدها ونذكرها هنا ان شاء الله تعالي جملة مختصرة من ذلك وبالله تعالي التوفيق * فنقول انه قد صح ان رسول الله صلي الله عليه وسلم قال: " البكر بالبكر جلد ماءة
 وتغريب عام والثيب بالثيب جلد ماءة والرجم " وصح عنه عليه السلام من طريق الزهري عن عبيد الله بن عبد الله بن عتبة بن مسعود عن زيد بن خالد انه سمع رسول الله صلي الله عليه وسلم يامر فيمن زني ولم يحصن بجلد ماءة وتغريب عام * وعن الزهري عن سعيد بن المسيب عن ابي هريرة ان رسول الله صلي الله عليه وسلم قضي فيمن زني ولم يحصن بان ينفي عاما مع اقامة الحد عليه وصح انه عليه السلام قال للذي زني ابنه بامراة مستاجره: علي ابنك جلد ماءة وتغريب عام وعلي امراة هذا الرجم "، وصح ان عمر بن الخطاب جلد امراة زنت ماءة جلدة وغربها عاما، وروي ايضا مثل ذلك عن علي بن ابي طالب وغيره من الصحابة رضي الله عنهم ولم يرو عن احد من الصحابة رضي الله عنهم خلاف ذلك الا رواية عن علي ليس علي ام الولد نفي وانما قال في البكرين يزنيان حسبهما من الفتنة ان ينفيا، وعن ابن عباس من زني جلد وارسل * قال ابو محمد رحمه الله: فليس قول ابن عباس من زني جلد وارسل دليلا علي انه لا يوجب النفي عنده بل قد يكون قوله وارسل يريد به ان يرسل الي بلد اخر، وكذلك قول علي حسبهما من الفتنة ان ينفيا يخرج علي ايجاب النفي وان ذلك حسبهما من البلاء * قال الله تعالي: (الم احسب الناس ان يتركوا ان يقولوا امنا وهم لا يفتنون) الي قوله تعالي: (وليعلمن الكاذبين) والرواية عنه في ان ام الولد لا تنفي اذا زنت لا تصح علي ما ذكرنا قبل * قال ابو محمد رحمه الله: وكلا القولين دعوي بلا برهان ومن عجاءب الدنيا ان يجعلوا الاربعين التي زادها عمر بن الخطاب رضي الله عنه في حد الخمر علي سبيل التعزير حدا واجبا مفترضا وهو رضي الله عنه يجلد مرة اربعين، مرة ستين، ومرة ثمانين، وكذلك عثمان بعده، وعلي، وغيرهما من الصحابة رضي الله عنهم ثم ياتون الي حد افترضه الله تعالي علي لسان رسوله صلي الله عليه وسلم فيجلعونه تعزيرا كل ذلك جراة علي الدعوي بلا برهان،  وادعوا ان رسول الله صلي الله عليه وسلم قال: " اذا زنت امة احدكم فليجلدها " ولم يقل فلينفها دليلا علي نسخ التغريب *
 قال ابو محمد رحمه الله: وهذا من الباطل المحض لان هذا خبر مجمل احال فيه رسول الله صلي الله عليه وسلم علي غيره فلم يذكر نفيا ولا عدد الجلد فان كان دليلا علي اسقاط التغريب فهو ايضا دليل علي اسقاط عدد ما يجلد وان لم يكن دليلا علي اسقاط عدد ما يجلد لانه لم يذكر فيه فليس ايضا دليلا علي نسخ النفي وان لم يذكر فيه، والاخبار يضم بعضها الي بعض واحكام الله تعالي واحكام رسوله عليه السلام كلها حق ولا يحل ترك بعضها لبعض بل الواجب ضم بعضها الي بعض واستعمال جميعها * قال ابو محمد رحمه الله: واما اسقاط مالك النفي عن العبيد والاماء والنساء واثباته اياه علي الحر فتفريق لا دليل علي صحته لان قضاء رسول الله صلي الله عليه وسلم وامره قد ورد عموما بالنفي علي كل من زني ولم يحصن ولم يخص الله تعالي ولا رسوله صلي الله عليه وسلم امراة من رجل ولا عبدا من حر وما كان ربك نسيا * وقد قال الله تعالي في الاماء (فعليهن نصف ما علي المحصنات من العذاب) فصح ان عليهن من النفي نصف ما ينفي المحصن، وكذلك امر رسول الله صلي الله عليه وسلم بان يقام الحد علي المكاتب بنسبة ما ادي من حد الحر وبنسبة ما لم يءد من حد العبد فبطل كل ما خالف حكم الله تعالي وحكم رسوله صلي الله عليه وسلم وبالله تعالي التوفيق * * حد الحر والحرة المحصنين *  مسالة قال ابو محمد رحمه الله: قالت طاءفة: الحر والحرة اذا زنيا وهما محصنان فانهما يرجمان حتي يموتا، وقالت طاءفة: يجلدان ماءة ثم يرجمان حتي يموتا، فاما الازارقة فليسوا من فرق الاسلام لانهم الذين اخبر رسول الله صلي الله عليه وسلم عنهم بانهم يمرقون من الدين كما يمرق السهم من الرمية فانهم قالوا لا رجم اصلا وانما هو الجلد فقط، فاما من روي عنه الرجم فقط دون جلد فكما نا محمد بن سعيد ابن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع عن يحيي بن ابي كثير السقا عن الزهري ان ابا بكر رضي الله عنه.
 وعمر رجما ولم يجلدا *
 وبه الي وكيع نا العمري  هو عبد الله بن عمر  عن نافع عن ابن عمر قال: ان عمر رجم ولم يجلد * وبه الي وكيع نا الثوري عن مغيرة عن ابراهيم النخعي قال: يرجم ولا يجلد * وعن عبد الرزاق عن معمر عن الزهري انه كان ينكر الجلد مع الرجم  وبه يقول الاوزاعي.
 وسفيان الثوري.
 وابو حنيفة.
 ومالك.
 والشافعي.
 وابو ثور.
 واحمد بن حنبل.
 واصحابهم، واما من روي عنه الرجم والجلد معا فكما نا ابو عمر احمد بن قاسم نا ابي قاسم بن محمد بن قاسم نا جدي قاسم بن اصبغ نا محمد بن عبد السلام الخشني نا محمد بن بشار نا محمد بن جعفر غندر نا شعبة عن سلمة بن كهيل عن الشعبي ان علي بن ابي طالب جلد شراحة يوم الخميس ورجمها يوم الجمعة فقال: اجلدها بكتاب الله وارجمها بقول رسول الله صلي الله عليه وسلم * حدثنا حمام نا عباس بن اصبغ نا محمد بن عبد الملك ابن ايمن نا اسماعيل بن اسحق القاضي نا عبد الواحد بن زياد نا حفص بن غياث عن الاعمش عن القاسم بن عبد الرحمن بن عبد الله بن مسعود عن ابيه قال: رايت علي ابن ابي طالب دعا بشراحة فجلدها يوم الخميس ورجمها يوم الجمعة، فقال جلدتها بكتاب الله ورجمتها بسنة رسول الله صلي الله عليه وسلم * حدثنا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا اسماعيل بن ابي خالد عن عمرو بن مرة عن علي بن ابي طالب انه قال: اجلدها بالكتاب وارجمها بالسنة، وعن الشعبي عن ابي بن كعب انه قال: في الثيب تزني اجلدها ثم ارجمها * وبه يقول الحسن البصري: كما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن قتادة عن الحسن قال: اوحي الي رسول الله صلي الله عليه وسلم " خذوا عني خذوا عني قد جعل الله لهن سبيلا الثيب بالثيب جلد ماءة والرجم والبكر بالبكر جلد ماءة ونفي سنة " وكان الحسن يفتي به، وبه يقول الحسن بن حي.
 وابن راهويه.
 وابو سليمان وجميع اصحابنا، وههنا قول ثالث: ان الثيب ان كان شيخا جلد ورجم فان كان شابا
 رجم ولم يجلد كما روي عن ابي ذر قال: الشيخان يجلدان ويرجمان والثيبان يرجمان والبكران يجلدان وينفيان، وعن ابي بن كعب قال: يجلدون ويرجمون ولا يجلدون ويجلدون ولا يرجمون، وفسره قتادة قال الشيخ المحصن يجلد ويرجم اذا زني والشاب المحصن يرجم اذا زني والشاب اذا لم يحصن جلد، وعن مسروق قال: البكران يجلدان وينفيان.
 والثيبان يرجمان ولا يجلدان والشيخان يجلدان ويرجمان * قال ابو محمد رحمه الله: وهذه اقوال كما تري فاما قول من لم ير الرجم اصلا فقول مرغوب عنه لانه خلاف الثابت عن رسول الله صلي الله عليه وسلم وقد كان نزل به قران ولكنه نسخ لفظه وبقي حكمه، حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن سفيان الثوري عن عاصم بن ابي النجود عن ذر بن حبيش قال: قال لي ابي بن كعب كم تعدون سورة الاحزاب؟ قلت: اما ثلاثا وسبعين اية او اربعا وسبعين  اية قال: ان كانت لتقارن سورة البقرة او لهي اطول منها وان كان فيها لاية الرجم قلت: ابا المنذر وما اية الرجم قال: اذا زني الشيخ والشيخة فارجموهما البتة نكالا من الله والله عزيز حكيم * قال علي: هذا اسناد صحيح كالشمس لا مغمز فيه، وحدثنا ايضا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا معاوية بن صالح الاشعري انا منصور  هو ابن ابي مزاحم  نا ابو حفص  هو عمر بن عبد الرحمن  عن منصور  هو ابن المعتمر  عن عاصم بن ابي النجود عن ذر بن حبيش قال.
 قال لي ابي بن كعب: كم تعدون سورة الاحزاب قلت: ثلاثا وسبعين فقال ابي: ان كانت لتعدل سورة البقرة او اطول وفيها اية الرجم الشيخ والشيخة اذا زنيا فارجموها البتة نكالا من الله والله عزيز حكيم، فهذا سفيان الثوري.
 ومنصور شهدا علي عاصم وما كذبا فهما الثقتان الامامان البدران وما كذب عاصم علي ذر ولاكذب ذر علي ابي *
 قال ابو محمد رحمه الله: ولكنها نسخ لفظها وبقي حكمها ولو لم ينسخ لفظها لاقراها ابي بن كعب ذرا بلا شك ولكنه اخبره بانها كانت تعدل سورة البقرة ولم يقل له انها تعدل الان فصح نسخ لفظها * قال علي: وقد روي هذا من طرق، منها ما ناه عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن المثني نا محمد بن جعفر غندر نا شعبة عن قتادة عن يونس بن جبير عن كثير بن الصلت قال: قال لي زيد بن ثابت سمعت رسول الله صلي الله عليه وسلم يقول: " اذا زني الشيخ والشيخة فارجموهما البتة " قال عمر: لما نزلت اتيت رسول الله صلي الله عليه وسلم فقلت اكتبنيها قال شعبة كانه كره ذلك فقال عمر: الا تري ان الشيخ اذا لم يحصن جلد وان الشاب اذا زني وقد احصن رجم * قال علي رحمه الله: وهذا اسناد جيد * قال علي: وقد توهم قوم ان سقوط اية الرجم انما كان لغير هذا وظنوا انها تلفت بغير نسخ، واحتجوا بما ناه احمد بن محمد ابن عبد الله الطلمنكي نا ابن منفرج نا محمد بن ايوب الصموت نا احمد بن عمر بن عبد الخالق البزار نا يحيي بن خلف نا عبد الاعلي بن عبد الاعلي عن محمد بن اسحق عن عبد الله بن ابي بكر بن محمد بن عمرو بن حزم.
 وعبد الرحمن بن القاسم بن محمد بن ابي بكر الصديق قال عبد الله عن عمرة بنت عبد الرحمن وقال عبد الرحمن عن ابيه، ثم اتفق القاسم ابن محمد.
 وعمرة كلاهما عن عاءشة ام المءمنين قال: لقد نزلت اية الرجم والرضاعة  فكانتا في صحيفة تحت سريري فلما مات رسول الله صلي الله عليه وسلم تشاغلنا بموته فدخل داجن فاكلها * قال ابو محمد: وهذا حديث صحيح وليس هو علي ما ظنوا لان اية الرجم اذ نزلت حفظت وعرفت وعمل بها رسول الله صلي الله عليه وسلم الا انه لم يكتبها نساخ القران في المصاحف ولا اثبتوا لفظها في القران، وقد ساله عمر بن الخطاب ذلك كما اوردنا
 فلم يجبه رسول الله صلي الله عليه وسلم الي ذلك فصح نسخ لفظها وبقيت الصحيفة التي كتبت فيها كما قالت عاءشة رضي الله عنها فاكلها الداجن ولا حاجة باحد اليها، وهكذا القول في اية الرضاعة ولا فرق * وبرهان هذا انهم قد حفظوها كما اوردنا فلو كانت مثبتة في القران لما منع اكل الداجن للصحيفة من اثباتها في القران من حفظهم، وبالله تعالي التوفيق * فبيقين ندري انه لا يختلف مسلمان في ان الله تعالي افترض التبليغ علي رسوله صلي الله عليه وسلم وانه عليه الصلاة والسلام قد بلغ كما امر قال الله تعالي: (يا ايها الرسول بلغ ما انزل اليك من ربك وان لم تفعل فما بلغت رسالته)، وقال تعالي: (انا نحن نزلنا الذكر وانا له لحافظون)، وقال تعالي: (سنقرءك فلا تنسي الا ما شاء الله) وقال تعالي: (ما ننسخ من اية او ننسها نات بخير منها او مثلها) فصح ان الايات التي ذهبت لو امر رسول الله صلي الله عليه وسلم بتبليغها لبلغها ولو بلغها لحفظت ولو حفظت ما ضرها موته كما لم يضر موته عليه السلام كل ما بلغ فقط من القران وان كان عليه السلام لم يبلغ او بلغه فانسيه هو والناس او لم ينسوه لكن لم يامر عليه السلام ان يكتب في القران فهو منسوخ بيقين من عند الله تعالي لا يحل ان يضاف الي القران * قال ابو محمد رحمه الله: وقد روي الرجم عن النبي صلي الله عليه وسلم جماعة كما حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن يحيي بن عبد الله النيسابوري نا بشر بن عمر الزهراني ني مالك عن الزهري عن عبيد الله بن عبد الله ابن عتبة عن ابن عباس ان عمر بن الخطاب قال: ان الله بعث محمدا وانزل عليه الكتاب فكان فيما انزل اية الرجم فقراناها ووعيناها ورجم رسول الله صلي الله عليه وسلم ورجمنا بعده واخشي ان طال بالناس زمان ان يقول قاءل: ما نجد اية الرجم في كتاب الله تعالي فيترك فريضة انزلها الله وان الرجم في كتاب الله حق علي من زني اذا احصن من الرجال والنساء اذا قامت البينة او كان الحبل او الاعتراف * وبه الي احمد بن شعيب انا محمد بن منصور المكي نا سفيان بن عيينة عن الزهري
 عن عبيد الله بن عبد الله بن عتبة عن ابن عباس قال: سمعت عمر يقول: قد خشيت  ان يطول بالناس زمان حتي يقول قاءل: ما نجد الرجم في كتاب الله فيضل بترك فريضة انزلها الله الا وان الرجم حق علي من زني اذا احصن وكانت البينة او كان الحبل او الاعتراف، وقد قراناها (الشيخ والشيخ فارجموها البتة) وقد رجم رسول الله صلي الله عليه وسلم ورجمنا بعده * حدثنا عبد الله بن ربيع نا عمر بن عبد الملك نا محمد بن بكر نا سليمان بن الاشعث نا مسدد نا يحيي بن سعيد القطان عن سعيد بن ابي عروبة عن قتادة عن الحسن عن حطان بن عبد الله الرقاشي عن عبادة بن الصامت قال: قال رسول الله صلي الله عليه وسلم: " خذوا عني خذوا عني قد جعل الله لهن سبيلا الثيب بالثيب جلد ماءة ورجم بالحجارة والبكر بالبكر جلد ماءة ونفي سنة " * روينا من طريق مسلم نا عبد الملك بن شعيب بن الليث بن سعد نا ابي عن جدي نا عقيل عن ابن شهاب عن ابي سلمة بن عبد الرحمن بن عوف.
 وسعيد بن المسيب عن ابي هريرة انه اتي رجل من المسلمين الي رسول الله صلي الله عليه وسلم وهو بالمسجد فناداه يا رسول الله اني زنيت فذكر الحديث وفيه ان رسول الله صلي الله عليه وسلم قال له: " فهل احصنت؟ قال نعم فقال رسول الله صلي الله عليه وسلم اذهبوا به فارجموه " * (مسالة) حد الامة المحصنة: قال ابو محمد: قال الله تعالي: (فاذا احصن فان اتين بفاحشة فعليهن نصف ما علي المحصنات من العذاب) فبيقين ندري ان الله تعالي اراد فاذا تزوجن ووطءن فعلين نصف ما علي الحراءر المحصنات من العذاب، والحرة المحصنة فان عليها جلد ماءة والرجم، وبالضرورة ندري ان الرجم لا نصف له فبقي عليهن نصف الماءة فوجب علي الامة المحصنة جلد خمسين فقط (فان قيل) فمن اين اوجبتم عليها نفي ستة اشهر امن هذه الاية ام من غيرها؟ (فجوابنا) وبالله تعالي التوفيق ان القاءلين ان علي الامة نفي ستة اشهر قالوا: ان ذلك واجب عليهن من
 هذه الاية، وقالوا: ان الاحصان اسم يقع علي الحرة المطلقة فقط فان كان هذا كما قالوا فالنفي واجب علي الاماء المحصنات من هذه الاية لان معني الاية فعلين نصف ما علي الحراءر من العذاب وعلي الحراءر هنا من العذاب جلد ماءة ومعه نفي سنة او رجم والرجم لا ينتصف اصلا لانه موت والموت لا نصف له اصلا، وكذلك الرجم لانه قد يموت المرجوم من رمية واحدة وقد لا يموت من الف رمية وما كان هكذا فلا يمكن ضبط نصفه ابدا واذ لا يمكن هذا فقد امنا ان يكلفنا الله تعالي ما لا نطيق لقوله تعالي: (لا يكلف الله نفسا الا وسعها) ولقول رسول الله صلي الله عليه وسلم: " اذا امرتكم بشء فاتوا منه ما استطعتم " او كما قال عليه السلام: فسقط الرجم وبقي  الجلد والنفي سنة وكلاهما له نصف فعلي الامة نصف ما علي الحرة منها * قال ابو محمد رحمه الله: وان كان الاحصان لا يقع في اللغة الا علي الحرية فقط فالنفي لا يجب علي الاماء من هذه الاية، وما نعلم الاحصان في اللغة العربية والشريعة يقع الا علي معنيين علي الزواج الذي يكون فيه الوطء فهذا اجماع لا خلاف فيه وعلي العقد فقط ولا نعلمه يقع علي الحرة المطلقة فقط فلا يجوز ان يقع في الدين الا بيقين لانه اخبار عن الله تعالي ولا يحل لمن له تقوي او عقل ان يخبر عن الله تعالي الا بيقين ولسنا والله نحن كمن يقول: ان الدين ماخوذ بالظنون فقط ولكن النفي واجب علي الاماء اذا زنين من موضع اخر وهو الخبر الذي ناه عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب اخبرني محمد بن اسماعيل بن ابراهيم ابن علية نا يزيد بن هرون انا حماد ابن سلمة عن ايوب السختياني عن عكرمة عن ابن عباس عن النبي صلي الله عليه وسلم قال: " اذا اصاب المكاتب حدا او ميراثا ورث بحساب ما عتق منه واقيم عليه الحد بحساب ما عتق منه " * وبه الي احمد بن شعيب انا محمد بن عيسي الدمشقي نا يزيد بن هرون نا حماد بن سلمة عن ايوب السختياني.
 وقتادة قال قتادة: عن خلاس بن عمرو عن علي بن ابي طالب، وقال ايوب: عن عكرمة عن ابن عباس ثم اتفقا علي، وابن عباس كلاهما عن النبي صلي الله عليه وسلم قال: " المكاتب يعتق منه بقدر ما ادي ويقام عليه الحد بقدر ما عتق منه ويرث بقدر ما عتق منه " وهذا اسناد في غاية الصحة فوجب ضرورة ان يكون حد الامة بنسبته من حد الحرة عموما في جميع ماله نصف من حد الحرة فوجب ضرورة ان حد الامة المتزوجة نصف حد الحرة من النفي والجلد وان لا يخص من ذلك شء لان رسول الله صلي الله عليه وسلم لم يخص من ذلك ولا احد من الامة اجمع علي تخصيصه ولا جاء القران بتخصيصه فوجب نفيها ستة اشهر وجلدها خمسون جلدة وبالله تعالي التوفيق *   مسالة  حد المملوك اذا زني، وهل عليه وعلي الامة المحصنة رجم ام لا؟ * قال ابو محمد: اختلف الناس في المملوك الذكر اذا زني فقالت طاءفة: ان حده حد الحر من الجلد والنفي والرجم كما نا محمد بن سعيد بن نبات نا احمد بن عبد البصير نا قاسم بن اصبغ نا محمد بن عبد السلام الخشني نا محمد بن المثني نا عبد الله بن ادريس الاودي نا ليث بن ابي سليم عن مجاهد قال: قدمت المدينة وقد اجمعوا علي عبد زني وقد احصن بحرة انه يرجم الا عكرمة فانه قال: عليه نصف الحد قال مجاهد:

 واحصان العبد ان يتزوج الحرة واحصان الامة ان يتزوجها الحر وبهذا ياخذ اصحابنا كلهم، وقال ابو ثور: الامة المحصنة والعبد المحصن عليهما الرجم الا ان يمنع من ذلك اجماع، وقال الاوزاعي: اذا احصن العبد بزوجة حرة فعليه الرجم وان لم يعتق فان كان تحته امة لم يجب عليه الرجم ان زني وان عتق، وكذلك قال ايضا: اذا احصنت الامة بزوح حر فعليها الرجم وان لم تعتق ولا تكون محصنة بزوج عبد، وقال ابو حنيفة، ومالك، والشافعي، واحمد: حد العبد المحصن وغير المحصن
 والامة لا رجم في شء من ذلك * قال ابو محمد: فلما اختلفوا كما ذكرنا وجب ان ننظر في ذلك فيما احتج به اصحابنا لقولهم فوجدناهم يقولون: (الزانية والزاني) الاية، وقال رسول الله صلي الله عليه وسلم: " البكر بالبكر جلد ماءة وتغريب عام والثيب بالثيب جلد ماءة والرجم " قالوا: فجاء القران والسنة بعموم لا يحل ان يخص منه الا ما خصه الله تعالي ورسوله عليه السلام فوجدنا النص من القران والسنة قد صح بتخصيص الاماء من جملة هذا الحكم بان علي المحصنات منهن نصف ما علي المحصنات الحراءر، وكذلك النص الوارد في الامة التي لم تحصن فخصصنا الاماء بالقران ولاسنة وبقي العبد وما كان ربك نسيا، وبيقين ندري ان الله تعالي لو اراد ان يخص العبيد لذكرهم كما ذكر الاماء ولما اغفل ذلك ولا اهمله والقياس كله باطل ودعوي بلا برهان، وكل ما يشغبون به في اثبات القران فحتي لو صح لهم وهو لا يصح لهم منه شء اصلا لما كان في شء منه ايجاب تخصيص القران به ولا اباحة الاخبار عن مراد الله تعالي اذ لا يجوز ان يعرف مغيب احد بقياس قالوا: فوجب ان يكون حكم العبد كحكم الحر في حد الزنا، ثم نقول لاصحاب القياس قد اجمعتم علي ان حد العبد كحد الحر في الردة وفي المحاربة وفي قطع السرقة فيلزمكم علي اصولكم في القياس ان تردوا ما اختلف فيه من حكمه في الزنا الي ما اتفقتم فيه من حكمه في الردة والمحاربة والسرقة بالقتل رجما والقتل صلبا او بالسيف اشبه من القتل رجما بالجلد قالوا.
 لا ولا سيما المالكيون المشغبون باجماع اهل المدينة وهذا اجماع الا عكرمة قد خالفوه * (فان قالوا) ان راوي هذا الخبر ليث بن ابي سليم وليس بالقوي (قلنا لهم): رب خبر احتججتم فيه لانفسكم بليث ومن هو دون ليث كجابر الجعفي عن الشعبي " لا يءمن احد بعدي جالسا، وليث اقوي من جابر بلا شك، ثم نظرنا فيما احتج به ابو ثور فوجدنا من حجته ان قال:

 قال الله تعالي: (فاذا احصن فان اتين بفاحشة فعليهن نصف ما علي المحصنات من العذاب) (قلنا): امر الله تعالي بالمخالفة بين حد الامة وحد الحرة فيما له نصف وليس ذلك الا الجلد والتغريب فقط واما الرجم فلا نصف له اصلا فلم يكن للرجم في هذه الاية دخول اصلا ولا ذكر، وكذلك لم يكن له ذكر في قوله تعالي: (والزانية والزاني) الاية، ووجدنا الرجم قد جاءت به سنة رسول الله صلي الله عليه وسلم علي من احصن، وكذلك جاء عن عمر رضي الله عنه.
 وغيره من الصحابة الرجم علي من احصن جملة ولم يخص حرا من عبد ولا حرة من امة فوجب ان يكون الرجم واجبا علي كل من احصن من حر او عبد او حرة او امة بالعموم الوارد في ذلك الا ان جلد الامة نصف جلد الحرة ونفيها نصف امد الحرة * قال ابو محمد رحمه الله: فنظرنا في هذين الاحتجاجين فوجدناهما صحيحين اذ لم يرد نص صحيح يعارضهما فنظرنا في ذلك فوجدنا رسول الله صلي الله عليه وسلم قد قال اذ اصاب المكاتب حدا او ميراثا ورث بحساب ما عتق منه واقيم عليه الحد بحساب ما عتق منه وقد ذكرناه باسناده في الباب الذي قبل هذا متصلا به فاغني عن اعادته، فاقتضي لفظ رسول الله صلي الله عليه وسلم وحكمه في هذا الخبر حكم المماليك في الحد بخلاف حكم الاحرار جملة اذ لو كان ذلك سواء لما كان لقول رسول الله صلي الله عليه وسلم ان يقام عليه الحد بحساب ما عتق منه معني اصلا، ولكان المكاتب الذي عتق بعضه كانه حر كله هذا خلاف حكم رسول الله صلي الله عليه وسلم * قال ابو محمد رحمه الله: فاذ قد صح ان حكم اهل الردة في الحدود خلاف حكم الحر فليس الا احد وجهين لا ثالث لهما ولابد من احدهما اما ان لا يكون علي المماليك حد اصلا وهذا باطل بما اوردناه ايضا باسناده في الباب المتصل بهذا الباب واسناده * نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا عبد الرحمن بن محمد بن سلام نا اسحق بن يوسف الازرق عن سفيان الثوري عن عبد الاعلي  هو ابن عبد الاعلي
 التغلبي  عن ميسرة  هو ابن جميلة  عن علي بن ابي طالب " ان رسول الله صلي الله عليه وسلم قال اقيموا الحدود علي ما ملكت ايمانكم " فكان هذا عموما موجبا لوقوع الحدود علي العبيد والاماء، واما ان يكون للمماليك حد مخالف لحكم حدود الاحرار وهذا هو الحق اذ قد بطل الوجه الاخر ولم يبق الا هذا، والحق في احدهما ولابد مع ورود هذين النصين الذين ذكرنا من وجوب اقامة الحدود علي ما ملكت ايماننا وانهم في ذلك بخلاف حدود الاحرار، فاذ قد وجب هذا بلا شك فلم يكن بد من تحديد حد المماليك بخلاف حكم الاحرار في الحدود، فقد صح اجماع القاءلين بهذا القول وهم اهل الحق علي ان  حكم المماليك في الحد نصف حد الحر فكان هذا حجة صحيحة مع صحة الاجماع المتيقن علي اطباق جميع اهل الاسلام علي ان حد العبد والامة ليس يكون اقل من نصف حد الحر ولا اكثر من نصف حد الحر، ولم يات بهذا نص قط فهذا اجماع صحيح متيقن علي ابطال القول بان يكون حد المملوك او المملوكة اقل من نصف حد الحر او اكثر من نصف حد الحر فبطل بالنصوص المذكورة * قال ابو محمد رحمه الله: فلو لا نص رسول الله صلي الله عليه وسلم علي اقامة الحدود علي ما ملكت ايماننا لكانت الحدود عنهم ساقطة جملة فاذ قد صحت الحدود عليهم فلا يجوز ان يقام عليهم منها الا ما اوجبه عليه نص او اجماع ولا نص ولا اجماع بوجوب الرجم عليهم ولا بايجاب ازيد من خمسين جلدة ونفي نصف سنة فوجب الاخذ بما اوجبه النص والاجماع واسقاط ما لا نص فيه ولا اجماع وبالله تعالي التوفيق * قال ابو محمد رحمه الله: فصح بما ذكرنا ان قول الله تعالي: (والزانية والزاني فاجلدوا) الاية انما عني بلا شك الاحرار والحراءر، وكذلك قول رسول الله صلي الله عليه وسلم البكر بالبكر جلد ماءة ونفي سنة والثيب بالثيب جلد ماءة والرجم انما عني به عليه السلام الاحرار والحراءر لا العبيد ولا الاماء، واما من لم يصحح الحديث الذي
 اوردنا عن رسول الله صلي الله عليه وسلم في ان يقام الحد علي المكاتب بقدر ما عتق منه ولم يصحح الحكم بقول رسول الله صلي الله عليه وسلم " البكر بالبكر جلد ماءة وتغريب عام والثيب بالثيب جلد ماءة والرجم " ولم يعتمد في الرجم الا علي الاحاديث الواردة في رجم ماعز.
 والغامدية.
 والجهينية رضي الله عنهم فانه لا مخلص لهم من دليل ابي ثور واصحابنا ولا نجد البتة دليلا علي اسقاط الرجم عن الامة المحصنة والعبد المحصن فان رجع الي القياس فقال: اقيس العبد علي الامة قيل له القياس كله باطل ولو كان حقا لما كان لكم ههنا وجه من القياس تتعلقون به في اسقاط الرجم اصلا لان قول الله تعالي: (فاذا احصن فان اتين بفاحشة فعليهن نصف ما علي المحصنات من العذاب) ليس فيه نص ولا دليل علي اسقاط الرجم عنها ولا نجد دليلا علي اسقاطه اصلا لا سيما من قال: احصانها هو اسلامها وانه ايضا يلزمه ان تكون كل حرة مسلمة محصنة ولابد وان لم تتزوج قط لان احصانها ايضا اسلامها، ومن الباطل المحال ان يكون اسلام الامة احصانا لها ولا يكون اسلام الحرة احصانا لها فاذا وجب هذا ولابد فواجب ان تكون الاية المذكورة يعني قوله تعالي: (فاذا احصن فان اتين بفاحشة فعليهن نصف ما علي المحصنات من العذاب) اللواتي لم يتزوجن من الاماء والحراءر لان اهل هذه المقالة لا يرون  المحصنات ههنا الا الحراءر اللواتي لم يتزوجن فهن عندهم اللواتي لعذابهن نصف، واما الرجم الذي هو عندهم عذاب المتزوجات فقط لا عذاب عليهن عندهم غيره فلا نصف له فاذا لزمهم هذا واقتضاه قولهم فواجب ان تبقي الامة المحصنة بالزواج والحرة المحصنة بالزواج زعلي وجوب الرجم الذي انما وجب عندهم بان النبي صلي الله عليه وسلم رجم من زاحصن فقط وبالله تعالي التوفيق *   مسالة  وجدت امراة ورجل يطءها فقالت: هو زوجي وقال هو: هي زوجتي وذلك لا يعرف *
 قال ابو محمد رحمه الله: اختلف الناس في هذا فقالت طاءفة: لا حد عليهما كما نا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا موسي بن معاوية نا وكيع نا داود بن يزيد الزعاوي عن ابيه ان رجلا وامراة وجدا في حرب مراد فرفعا الي علي بن ابي طالب فقال ابنة عمي تزوجتها فقال لها علي ما تقولين؟ فقال لها الناس قولي نعم فقالت نعم فدرا عنهما، حدثنا محمد بن سعيد بن نبات نا احمد بن عون الله نا قاسم بن اصبغ نا محمد بن عبد السلام الخشني نا محمد بن بشار بندار نا محمد بن جعفر غندر نا شعبة عن الحكم بن عتيبة.
 وحماد بن سليمان انهما قالا في الرجل يوجد مع المراة فيقول هي امراتي انه لا حد عليه قال شعبة فذكرت ذلك لايوب السختياني فقال ادرءوا الحدود ما استطعتم * قال ابو محمد رحمه الله: وبه يقول ابو حنيفة، والشافعي، وقالت طاءفة: عليهما الحد كما نا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي ابن معاوية نا وكيع عن سفيان الثوري عن المغيرة عن ابراهيم النخعي في الرجل يوجد مع المراة فيقول: هي امراتي فقال ابراهيم: ان كان كما يقول لم يقم علي فاجر حد، حدثنا محمد ابن سعيد بن نبات نا احمد بن عون الله نا قاسم بن اصبغ نا محمد بن عبد السلام الخشني نا محمد بن بشار نا محمد بن جعفر نا شعبة عن المغيرة عن ابراهيم النخعي في الرجل يوجد مع المراة فيقول هي امراتي قال: عليه الحد * حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم ابن اصبغ نا ابن وضاح نا سحنون نا ابن وهب عن غير واحد عن الاوزاعي قال: سالت ابن شهاب عن الرجل يوجد مع المراة؟ فيقول تزوجتها فقال: يسال البينة فان جاء ببينته والا وقع عليه الحد * وبه يقول مالك.
 واصحابه، وقال عثمان البتي: ان كانا لا يعرفان فلا حد عليهما فان كانا معروفين فان كان يري قبل ذلك يدخل اليها ويذكر ذلك فلا حد عليه وان لم يكن شء من ذلك فعليهما الحد * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر في ذلك فوجدنا  من قال لا حد عليهما يحتج بان قال: هو قول روي عن علي بن ابي طالب بحضرة الصحابة ولا مخالف له منهم فلا يجوز تعديه وقالوا ادرءوا الحدود بالشبهات واوجب هذه شبهة قوية وقالوا لا خلاف بين احد من الامة في ان رجلا لو وجد يطا امة معروفة لغيره فقال الذي عرف ملكها له قد كان اشتراها مني وقال هو كذلك واقرت هي بذلك انه لا حد عليهما فهذا مثله * قال ابو محمد رحمه الله: ما نعلم لهم حجة غير ما ذكرنا وكل هذا لا حجة لهم فيه، اما قولهم انه قول روي عن علي فهذا لا حجة لهم فيه لانه لا حجة في احد دون رسول الله صلي الله عليه وسلم فهذا لا يلزمنا، واما قولهم: ادرءوا الحدود ما امكنكم فقد ثبت بطلان هذا القول وانه لا يحل درء حد بشبهة ولا اقامته بشبهة في دين الله تعالي وانما هو الحق واليقين فقط ويكفي من بطلان قول من قال: ادرءوا الحدود بالشبهات انه قول لم يات به قران ولا سنة وانما جاء القران والسنة بتحريم دم المسلم وبشرته حتي يثبت عليه حد من حدود الله تعالي فاذا ثبت لم يحل درءه اصلا فيكون عاصيا لله تعالي، واما قولهم في تنظيرهم ذلك بالامة المعروفة لانسان فيوجد معها رجل فيقول قد صارت الي وملكتها ويقول سيدها بذلك ودعواهم الاجماع في ذلك قول بالظن لا يصح وما عهدنا قول مالك المشهور فيمن قامت عليه بينة بانه اخرج من حرزه مالا مستترا بذلك فادعي ان صاحب ذلك الشء امره بذلك او انه وهبه واقر صاحب المال بذلك بانه لا يلتفت الي ذلك بل تقطع يده ولا بد * قال ابو محمد رحمه الله: والذي نقول به ان من وجد مع امراة يطءها وقامت البينة بالوطء فقال هو انها امراتي او قال امتي فصدقته في ذلك فان كان غريبين او لا يعرفان فلا شء عليهما ولا يعرض لهما ولا يكشفان عن شء لان الاجماع قد صح بنقل الكواف ان الناس كانوا يهاجرون الي رسول الله صلي الله عليه وسلم افذاذا ومجتمعين من اقاصي اليمن ومن جميع بلاد العرب باهليهم ونساءهم واماءهم وعبيدهم فما حيل بين احد وبين من
 زعم انها امراته او امته ولا كلف احد علي ذلك بينة، ثم علي هذا اجماع جميع اهل الاسلام وجميع اهل الارض من عهد رسول الله صلي الله عليه وسلم والي يومنا هذا لا يزال الناس يرحلون باهليهم واماءهم ورقيقهم ولا يكلف احد منهم بينة علي ذلك بل تصدق اقوالهم في ذلك مسلمين كانوا او كفارا فاذ قد صح النص بهذا والاجماع فلا يجوز مخالفة ذلك فان كانت هي معروفة في البلد ومعروف انه لا زوج لها فان امكن ما يقول فلا شء عليهما لان اصل دماءهما وابشارهما علي التحريم بقول رسول الله صلي الله عليه وسلم: " ان  دماءكم واموالكم واعراضكم وابشاركم عليكم حرام " فلا يجوز اباحة ما حرم الله تعالي الا بيقين لا شك فيه وان كان كذبهما في ذلك متيقنا فالحد واجب عليهما وان قال هي امتي وصدقه صاحبها الذي عرف ملكها له واقر انه قد كان وهبها له او كان باعها منه صدق ولا شء عليهما في ذلك فان كذبه حد الا ان ياتي ببينة علي صحة دعواه فلو قال: هي امتي وقالت هي بل انا زوجته او قال هي زوجتي وقالت هي بل انا امته او قالت بل ام ولده فقد اتفقا علي صحة الفراش فلا حد في ذلك وهي علي الحرية حتي يقيم هو بينة بملكه لها فان لم يفعل حلف لها فيما يدعيه من الزوجية وفرق بينهما لان الملك قد بطل اذا لم تقم بينة والناس علي الحرية حتي يصح الرق والزوجية لم تثبت لا باقرارهما ولا ببينة وانما يحكم عليهما من الان واما اذا كانت امة معروفة لانسان فانكر سيدها خروجها عن ملكه الي الذي وجد معها فالحد عليها وعلي الذي وجد معها الا ان ياتي ببينة علي ذلك وله علي سيدها اليمين ولا بد *   مسالة  فيمن وجد مع امراة فشهد له ابوها او اخوها بالزوجية * قال ابو محمد رحمه الله: فلو وجد يطا امراة معروفة وهو مجهول او معروف فادعي هو وهي الزوجية وشهد لهما بذلك ابوها او اخوها فان مالكا قال: عليهما الحد وقال اصحابنا: ان كان اللذان شهدا لهما عدلين صح العقد وبطل الحد وبهذا ناخذ
 فان لم يكونا عدلين فالحد عليهما ما لم يكن علي صحة النكاح بينة او استفاضة لان اليقين صح انهما غير زوجين وانها حرام عليه فلا ينتقل التحريم الي التحليل ولا ينتقلان الي حكم الزوجية الا بيقين من بينة او استفاضة *   مسالة  هل يصلي الامام وغيره علي المرجوم ام لا؟ * قال ابو محمد رحمه الله: نا عبد الله بن يوسف نا احمد بن فتح نا عبد الوهاب ابن عيسي نا احمد بن محمد نا احمد بن علي نا مسلم بن الحجاج نا محمد بن المثني نا عبد الاعلي نا داود عن ابي نضرة عن ابي سعيد الخدري " ان رجلا من اسلم يقال له ماعز ابن مالك رجمه رسول الله صلي الله عليه وسلم فذكر الحديث ثم قام رسول الله صلي الله عليه وسلم خطيبا من العشي فقال: او كلما انطلقنا غزاة في سبيل الله تخلف رجل في عيالنا له نبيب كنبيب التيس علي ان لا اوتي برجل فعل ذلك الا نكلت به قال فما استغفر له ولا سبه " * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق نا ابن جريج اخبرني عبد الله بن ابي بكر اخبرني ايوب عن ابي امامة بن سهل بن حنيف الانصاري ان رسول الله صلي الله عليه وسلم " صلي الظهر يوم امر بماعز يرجم فطول الاوليين من الظهر حتي  كاد الناس يعجزون عنها من طول القيام فلما انصرف امر به فرجم فلم يقتل حتي رماه عمر ابن الخطاب بلحي بعير فاصاب راسه فقتله فقال رجل لماعز حين فاضت نفسه اتصلي عليه يا رسول الله؟ قال: لا فلما كان الغد صلي الظهر فطول الركعتين الاولتين كما طولهما بالامس او اخر باشياء فلما انصرف قال: صلوا علي صاحبكم فصلي عليه النبي عليه السلام والناس " * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن الزهري عن ابي سلمة عن جابر بن عبد الله " ان رجلا من اسلم جاء الي النبي صلي الله عليه وسلم فاعترف بالزنا فاعرض  فذكر الحديث وفيه  فامر به النبي صلي الله عليه وسلم فرجم بالمصلي فلما اذلفته الحجارة فر فادرك فرجم حتي مات فقال له النبي صلي الله عليه وسلم: خيرا
 ولم يصل عليه " * قال ابو محمد رحمه الله: فذهب الي هذا قوم فقالوا لا يصلي عليه الامام ويصلي عليه غيره، وذهب اخرون الي ان الامام يصلي علي المرجوم والمرجومة كساءر الموتي ولا فرق، روينا من طريق البخاري نا محمود نا عبد الرزاق انا معمر عن الزهري عن ابي سلمة بن عبد الرحمن بن عوف عن جابر قال: " ان رجلا من اسلم جاء الي النبي صلي الله عليه وسلم فاعترف بالزنا فاعرض عنه حتي شهد علي نفسه اربع  مرات فذكر الحديث وفيه  فامر به فرجم بالمصلي فلما اذلفته الحجارة فر فادرك فرجم حتي مات فقال له النبي صلي الله عليه وسلم خيرا وصلي عليه " * قال ابو محمد رحمه الله: فهذا مما اختلف فيه محمود بن غيلان.
 واسحق بن ابراهيم الدبري علي عبد الرزاق فرواية الدبري عنه في هذا الخبر ولم يصل عليه ورواية محمود عنه في هذا الخبر وصلي عليه فالله اعلم ايهما وهم * ومن طريق مسلم نا محمد بن عبد الله بن نمير نا ابي نا عبد الله بن بريدة عن ابيه فذكر حديث الغامدية وان رسول الله صلي الله عليه وسلم امر الناس فرجموها ثم امر بها فصلي عليها ودفنت * ومن طريق مسلم نا ابو غسان المسمعي نا معاذ  يعني ابن هاشم الدستواءي  ني ابي عن يحيي بن ابي كثير ني ابو قلابة ان ابا المهلب حدثه عن عمران ابن الحصين " ان امراة من جهينة اتت نبي الله صلي الله عليه وسلم وهي حبلي من الزنا وذكر الحديث، وفيه ان رسول الله صلي الله عليه وسلم امر بها فرجمت ثم صلي عليها فقال له عمر بن الخطاب اتصلي عليها يا نبي الله وقد زنت؟ قال: لقد تابت توبة لو قسمت بين سبعين من اهل المدينة لوسعتهم وهل وجدت بافضل من ان جادت بنفسها لله؟ " ففي هذه الاثار صلاة رسول الله صلي الله عليه وسلم علي الجهينية بنفسه بلا خلاف وامره بالصلاة علي  الغامدية بلا خلاف وصلاته علي ماعز رضي الله عنه باختلاف، وهذه الاثار في غاية
 الصحة وبهذا يقول علي بن ابي طالب رضي الله عنه حين رجم شراحة فقالوا كيف نصنع بها؟ قال اصنعوا بها كما تصنعون بنساءكم اذا متن في بيوتكم * قال ابو محمد رحمه الله: والذي نصنع بنساءنا اذا متن في بيوتنا هو ان يغسلن ويكفن ويصلي عليهن الامام وغيره هذا ما لا خلاف فيه من احد من الامة وبالله تعالي التوفيق *   مسالة  في امراة احلت نفسها او تزوج رجل خامسة او دلست او دلست بنفسها لاجنبي * قال ابو محمد رحمه الله: حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب عن يونس بن يزيد عن ابن شهاب انه قال في المراة تقول للرجل اني حل لك فيمسها علي ذلك فنلد منه انه يرجم ولا يرثه ذلك الولد * قال ابو محمد: ليس لاحد ان يحل ما حرم الله تعالي فاحلالها نفسها باطل وهو زنا محض وعليه الرجم والجلد ان كانا محصنين ولا يلحق في هذا ولد اصلا اذا لم يكن عقد فان كانا جاهلين فلا شء عليهما وان كان احدهما جاهلا والاخر عالما فالحد علي العالم دون الجاهل * وعن بكير بن الاشج انه قال في امراة انطلقت الي جاريتها فهياتها بهيءتها وجعلتها في حجلتها وجاء زوجها فوطءها قال تنكل المراة ولا جلد علي الرجل وعلي الجارية حد الزنا ان كانت تدري ان ذلك لا يحل، ولو ان امراة دلست نفسها لاجنبي فوطءها يظن انها امراته فهي زانية ترجم وتجلد ان كانت محصنة او تجلد وتنفي ان كانت غير محصنة ولا يلحق الولد في ذلك * قال ابو محمد: في امراة وجدت مع رجل ولها زوج فقالت تزوجني نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج قال: اخبرني بعض اهل الكوفة ان علي بن ابي طالب رجم امراة كانت ذات زوج فجاءت ارضا فتروجت ولم تشك ان ما جاءها موت زوجها ولا طلاقه، وعن ابن شهاب انه قال نري في امراة
 حرة كانت تحت عبد فتحولت ارضا اخري فتزوجت رجلا قال: نري عليها الحد ولا نري علي الذي تزوجها شيءا ولا علي الذي انكحها ان كان لا يعلم انها كان لها زوج * قال ابو محمد رحمه الله: واما من تزوج خامسة فان حماما قال: حدثنا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن الزهري في الرجل يتزوج  الخامسة قال: يجلد فان طلق رابعة من نساءه طلقة او طلقتين ثم تزوج الخامسة قبل انقضاء عدة التي طلق جلد ماءة * وبه الي عبد الرزاق عن ابن جريج قال: قال ابن شهاب: في رجل نكح الخامسة فدخل بها قال: ان كان قد علم ذلك ان الخامسة لا تحل رجم وان كان جاهلا جلد ادني الحدين ولها مهرها بما استحل منها ثم يفرق بينهما ولا يجتمعان ابدا فان علمت رجمت ان احصنت وجلدت ان لم تحصن فان لم تعلم ان تحته اربع نسوة فلا عقوبة عليها فان ولدت لم يرثه ولدها، وعن ابراهيم النخعي في الذي ينكح الخامسة متعمدا قبل ان تنقضي عدة الرابعة من نساءه انه يجلد ماءة ولا ينفي، وقال اخرون: غير هذا كما روي عن الاوزاعي قال: سالت ابن شهاب عن الرجل يتزوج الاخت علي الاخت والخامسة وهو يعلم انه حرام قال يرجم ان كان محصنا قال ابن وهب: وسمعت الليث يقول ذلك، وقال مالك، والشافعي، واصحابنا: يرجم الا ان يعذر بجهل * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر في ذلك فوجدنا من قال لا حد علي من تزوج خامسة يحتج بما ذكرنا في اول الباب الذي قبل هذا متصلا به في الكلام في المراة تتزوج ولها زوج والرد عليه قد ذكرناه هنالك ايضا بما جملته انه ليس زواجا لان الله تعالي حرمه واذ ليس زواجا فهو عهر فاذ هو عهر فعليه حد الزني وعليها كذلك ان كانا عالمين بان ذلك لا يحل ولا يلحق فيه الولد اصلا فان كانا جاهلين فلا حد في ذلك لما ذكرنا ويلحق الولد وان كان احدهما جاهلا والاخر
 عالما فالحد علي العالم ولا شء علي الجاهل، واما من قال انه يجلد ادني الحدين فليس بشء لما ذكرنا هنالك من انه زان او غير زان فان كان زانيا فعليه حد الزنا كاملا وان كان غير زان فلا شء عليه لان بشرته حرام الا بقران او بسنة وبالله تعالي التوفيق *   مسالة  امراة تزوجت في عدتها ومن طلق ثلاثا قبل الدخول او بعده ثم وطء * قال ابو محمد رحمه الله: روي عن سعيد بن المسيب ان امراة تزوجت في عدتها فرفع ذلك الي عمر بن الخطاب فضربها دون الحد وفرق بينهما، وعن الشعبي انه قال: في امراة نكحت في عدتها عمدا قال: ليس عليها حد، وعن ابراهيم النخعي بمثله * قال ابو محمد رحمه الله: والاسناد الي عمر منقطع لان سعيدا لم يلحق عمر رضي الله عنه سماعا الا نعيه النعمان بن مقرن علي المنبر، ولا تخلو الناكحة في عدتها بان تكون عالمة بان ذلك لا يحل او تكون جاهلة بان ذلك محرم او غلطت في العدة فان كانت جاهلة  او غلطت في العدة فلا شء عليها لانها لم تعمد الحرام والقول قولها في الغلط علي كل حال فان كانت عالمة بان ذلك لم يحل ولم تغلط في العدة فهي زانية وعليها الرجم وقد يمكن ان يضربها عمر رضي الله عنه تعزيرا لتركها التعلم من دينها ما يلزمها فهو مكان التعزير، واما من اسقط الحد في العمد في ذلك فانه ان طرد قوله لزمه المصير الي قول ابي حنيفة في سقوط الحد عمن تزوج امه وهو يدري انها امه وانها حرام وعمن تزوج ابنته كذلك او اخته كذلك وتزوج نساء الناس وهن تحت ازواجهن عمدا دون طلاق ولا فسخ وهذا هو الاطلاق علي الزنا بل هو الاستخفاف بكتاب الله تعالي، واما من اسقط الحد في بعض ذلك واوجبه في بعض قاقض فان تعلقوا بعمر فقد قلنا انه ليس في الاثر عن عمر انها كانت عالمة بانقضاء العدة ولا بالتحريم فلا متعلق لهم بذلك *
 قال ابو محمد رحمه الله: والقول في ذلك كله واحد وهو ان كل عقد فاسد لا يحل فالفرج به لا يحل ولا يصح به زواج فهما اجنبيان كما كانا والوطء فيه من العالم بالتحريم زنا مجرد محض وفيه الحد كاملا من الرجم او الجلد او التعزير ولا يلحق فيه ولد اصلا ولا مهر فيه ولا شء من احكام الزوجية وان كان جاهلا فلا حد ولا يقع في ذلك شء من احكام الزوجية الا لحاق الولد فقط للاجماع وبالله تعالي التوفيق، واما من طلق ثلاثا ثم وطء فان كان عالما ان ذلك لا يحل فعليه حد الزني كاملا وعليها كذلك لانها اجنبية فان كان جاهلا فلا شء عليه ولا يلحق الولد ههنا اصلا لانه وطء فيما لا عقد له معها لا صحيحا ولا فاسدا وبالله تعالي التوفيق *  مسالة من تزوجت عبدها * قال ابو محمد رحمه الله: حدثنا محمد ابن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع عن سفيان الثوري عن جابر الجعفي عن الحكم بن عتيبة ان عمر بن الخطاب كتب في امراة تزوجت عبدها فعزرها وحرمها علي الرجال * وبه الي وكيع نا الاسود ابن شيبان عن ابي نوفل عن ابي عقرب قال: جاءت امراة الي عمر بن الخطاب فقالت يا امير المءمنين اني امراة كما تري غيري من النساء اجمل مني ولي عبد قد رضيت امانته فاردت ان اتزوجه فبعث عمر الي العبد فضربه ضربا وامر بالعبد فبيع في ارض غربة، وعن ابن شهاب عن ابن سمعان قال: كان ابو الزبير يحدث عن جابر بن عبد الله الانصاري انه قال: جاءت امراة الي عمر بن الخطاب ونحن بالجابية نكحت عبدها فتلهف عليها وهم برجمها ثم فرق بينهما وقال للمراة: لا يحل لك ملك يمينك * قال ابو محمد رحمه الله: القول في هذا كله واحد كل نكاح لم يبحه الله تعالي فلا  يجوز عقده فان وقع فسخ ابدا لانه ليس نكاحا صحيحا جاءز فان وقع فيه الوطء فالعالم بتحريمه زان عليه الحد حد الزنا كاملا فهو او هي او كلاهما ومن كان جاهلا فلا شء عليه
 والولد فيه لاحق للاجماع ومن قذف الجاهل حد لانه ليس زانيا ولو كان زانيا لحد حد الزنا ولا يحل للمراة عبدها فان وطءها فكما قلنا ان كانت عالمة ان هذا لا يحل فهي زانية وترجم ويجلدها ان كانت محصنة او تجلد وتنفي ان كانت غير محصنة والعبد كذلك ولا يلحق الولد فان كانت جاهلة فلا شء عليها ويلحق الولد بها اما التفريق فلا بد منه، واما التحريم علي الرجال فلا يحرم بذلك لان الله تعالي لم يوجب ذلك، ولا رسوله صلي الله عليه وسلم فان اعتقته بشرط ان يتزوجها فالعتق باطل مردود لانه علق بشرط ليس في كتاب الله تعالي فهو باطل واذا بطل الشرط بطل عقد لم يعقد الا بذلك الشرط ولا يجوز انفاذ العقد لان العاقد له لم يعقده قط منفردا من الشرط فلا يحل ان بمضي عليه عقد لم يعقده علي نفسه قط لانه لم يوجب عليه ذلك قران.
 ولا سنة صحيحة.
 ولا اجماع فان اعتقته بغير شرط ثم تزوجها زواجا صحيحا فهو جاءز * قال ابو محمد رحمه الله: (فان قالوا): من اين اوجبتم الحد وعمر بن الخطاب لم يحد في ذلك ولا يعرف له من الصحابة رضي الله عنهم مخالف؟ (قلنا): ان عمر رضي الله عنه قد هم برجمها فلولا ان الرجم عليها كان واجبا ما هم وانما ترك رجمها اذ عرف جهلها بلا شك ونحن ايضا لا نري حجة في قول احد دون رسول الله صلي الله عليه وسلم ولكن اذ يحتجون بقول عمر رضي الله عنه فيلزمكم ان تحرموها علي الرجال في الابد كما جاء عن عمر، وبالله تعالي التوفيق *  مسالة  المحلل والمحلل له  قال ابو محمد رحمه الله: حدثنا محمد بن سعيد بن نبات نا احمد بن عون الله نا قاسم بن اصبغ نا محمد بن عبد السلام الخشني نا محمد بن بشار نا يحيي بن سعيد القطان نا شعبة عن الاعمش عن المسيب بن رافع عن قبيصة بن جابر الاسدي قال: قال عمر بن الخطاب: لااوتي بمحلل او محلل له الا رجمته * قال ابو محمد: عهدنا بالحنيفيين، والمالكيين، والشافعيين يعظمون خلاف الصاحب اذا وافق تقليدهم وكلهم قد خالفوا عمر بن الخطاب وهم يقلدونه فيما هو
 عنه من طريق لا تصح والذي نقول به وبالله تعالي التوفيق ان كل نكاح انعقد سالما مما يفسده ولم يشترط فيه التحليل والطلاق فهو نكاح صحيح تام لا يفسخ وسواء اشترط ذلك عليه قبل العقد او لم يشترط لان كل ناكح لمطلقة ثلاثا فهو محلل ولا بد فالتحليل المحرم هنا هو ما انعقد عقدا غير صحيح، واما اذا عقد النكاح علي شرط التحليل ثم  الطلاق فهو عقد فاسد ونكاح فاسد فان وطء فيه فان كان عالما ان ذلك لا يحل فعليه الرجم والحد لانه زنا وعليها ان كانت عالمة مثل ذلك ولا يلحق الولد فان كان جاهلا فلا حد عليه ولا صداق والولد لاحق وبالله تعالي التوفيق، وهكذا القول في كل عقد فاسد بالشغار.
 والمتعة والعقد بشرط ليس في كتاب الله تعالي اي شرط كان وبالله تعالي التوفيق *  مسالة  المستاجرة للزنا او للخدمة والمخدمة * قال ابو محمد: حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق نا ابن جريج ني محمد بن الحرث بن سفيان عن ابي سلمة بن سفيان ان امراة جاءت الي عمر بن الخطاب فقالت: يا امير المءمنين اقبلت اسوق غنما لي فلقيني رجل فحفن لي حفنة من تمر ثم حفن لي حفنة من تمر ثم حفن لي حفنة من تمر ثم اصابني فقال عمر: ما قلت؟ فاعادت فقال عمر بن الخطاب ويشير بيده: مهر مهر مهر ثم تركها * وبه الي عبد الرزاق عن سفيان بن عيينة عن الوليد بن عبد الله  وهو ابن جميع  عن ابي الطفيل ان امراة اصابها الجوع فاتت راعيا فسالته الطعام فابي عليها حتي تعطيه نفسها قالت: فحثي لي ثلاث حثيات من تمر وذكرت انها كانت جهدت من الجوع فاخبرت عمر فكبر وقال: مهر مهر مهر ودرا عنها الحد * قال ابو محمد رحمه الله: قد ذهب الي هذا ابو حنيفة ولم ير الزنا الا ما كان مطارفة واما ما كان فيه عطاء او استءجار فليس زنا ولا حد فيه، وقال ابو يوسف.
 ومحمد.
 وابو ثور.
 واصحابنا.
 وساءر الناس، هو زنا كله وفيه الحد، واما المالكيون.
 والشافعيون فعهدنا بهم يشنعون خلاف الصاحب الذي لا يعرف له مخالف اذا وافق تقليدهم وهم قد خالفوا عمر رضي الله عنه ولا يعرف له مخالف من الصحابة رضي الله عنهم بل هم يعدون مثل هذا اجماعا ويستدلون علي ذلك بسكوت من بالحضرة من الصحابة عن النكير لذلك (فان قالوا): ان ابا الطفيل ذكر في خبره انها قد كان جهدها الجوع (قلنا لهم): وهذا ايضا انتم لا تقولون به ولا ترونه عذرا مسقطا للحد فلا راحة لكم في رواية ابي الطفيل مع ان خبر ابي الطفيل ليس فيه ان عمر عذرها بالضرورة بل فيه انه درا الحد من اجل التمر الذي اعطاها وجعله عمر مهرا، واما الحنيفيون المقلدون لابي حنيفة في هذا فمن عجاءب الدنيا التي لا يكاد يوجد لها نظير ان يقلدوا عمر في اسقاط الحد ههنا بان ثلاث حثيات من تمر مهر وقد خالفوا هذه القضية بعينها فلم يجيزوا في النكاح الصحيح مثل هذا واضعافه مهرا بل منعوا من اقل من عشرة دراهم في ذلك فهذا هو الاستخفاف حقا والاخذ بما اشتهوا من قول الصاحب حيث اشتهوا وترك ما اشتهوا  ترك من قول الصاحب اذا اشتهوا فما هذا دينا واف لهذا عملا اذ يرون المهر في الحلال لا يكون الا عشرة دراهم لااقل ويرون الدرهم فاقل مهرا في الحرام الا ان هذا هو التطريق الي الزنا واباحة الفروج المحرمة وعون لابليس علي تسهيل الكباءر وعلي هذا لا يشاء زان ولا زانية ان يزنيا علانية الا فعلا وهما في امن من الحد بان يعطيها درهما يستاجرها به للزنا فقد علموا الفساق حيلة في قطع الطريق بان يحضروا مع انفسهم امراة سوء زانية وصبيا بغاء ثم يقتلوا المسلمين كيف شاءوا ولا قتل عليهم من اجل المراة الزانية والصبي البغاء فكلما استوقروا من الفسق خفت اوزارهم وسقط الخزي والعذاب عنهم ثم علموهم وجه الحيلة في الزنا وذلك ان يستاجرها بتمرتين وكسرة خبر ليزني بها ثم يزنيان في امن وذمام من العذاب بالحد الذي افترضه الله تعالي ثم علموهم الحيلة في وطء الامهات والبنات بان يعقدوا معهن نكاحا ثم يطءنهن علانية امنين من الحدود
 ثم علموهم الحيلة في السرقة ان ينقب احدهم نقبا في الحاءط ويقف الواحد داخل الدار والاخر خارج الدار، ثم ياخذ كلما في الدار فيضعه في النقب، ثم ياخذه الاخر من النقب ويخرجان امنين من القطع، ثم علموهم الحيلة في قتل النفس المحرمة بان ياخذ عودا صحيحا فيكسر به راس من احب حتي يسيل دماغه ويموت ويمضي امنا من القود ومن غرم الدية من ماله، ونحن نبرا الي الله تعالي من هذه الاقوال المعلونة وما قال اءمة المحدثين ما قالوا باطلا ونسال الله السلامة ولو انهم تعلقوا في كل ما ذكرنا بقران او سنة لاصابوا بل خالفوا القران.
 والسنة وما تعلقوا بشء الا بتقليد مهلك وراي فاسد.
 واتباع الهوي المضل * قال ابو محمد رحمه الله: وحد الزنا واجب علي المستاجر والمستاجرة بل جرمهما اعظم من جرم الزاني والزانية بغير استءجار لان المستاجر والمستاجرة زنيا كما زني غير المستاجر ولا فرق وزاد المستاجر والمستاجرة علي ساءر الزنا حراما اخر وهو اكل المال بالباطل، واما المخدمة فروي عن ابن الماجشون صاحب مالك ان المخدمة سنين كثيرة لا حد علي المخدم اذا وطءها وهذا قول فاسد ومع فساده ساقط، اما فساده فاسقاطه الحد الذي اوجبه الله تعالي في الزنا، واما سقوطه فتفريقه بين المخدمة مدة طويلة والمخدمة مدة قصيرة ويكلف تحديد تلك المدة المسقطة للحد التي يسقط فيها الحد فان حد مدة كان متزيدا من القول بالباطل بلا برهان، وان لم يحد شيءا كان محرما موجبا شارعا مالا يدري فيما لا يدري وهذه تخاليط نعوذ بالله منها، والحد كامل واجب علي المخدم والمخدمة ولو اخدمها عمر نوح في قومه لانه زنا وعهر  من ليست له فراشا، وبالله تعالي التوفيق *  مساءل من نحو هذا  قال علي: من زني بامراة ثم تزوجها لم يسقط الحد بذلك عنه لان الله تعالي قد اوجبه عليه فلا يسقطه زواجه اياها وكذلك
 اذا زني بامة ثم اشتراها وهو قول جمهور العلماء، وقال ابو حنيفة: لا حد عليه في كلتا المسالتين * قال ابو محمد رحمه الله: وهذه من تلك الطوام (فان قالوا): كيف نحده في وطء امراته وامته (قلنا لهم): لم نحده في وطءه لهما وهما امراته وامته وانما نحده في الوطء الذي كان منه لهما وهما ليستا امراته ولا امته ثم يلزمهم علي هذا الاعتلال الفاسد ان من قذف امراة ثم تزوجها ان يلاعن ولا حد عليه وانه ان زني بها فحملت ثم تزوجها او اشتراها ان يلحق به الولد والا فكيف ينفي عنه ولد امراته منه او ولد امته منه (فان قالوا): ليس ابن فراش (قلنا): صدقتم ولذلك نحده علي الوطء السالف لانه لم يكن وطء فراش * قال ابو محمد رحمه الله: ولو زني بامراة حرة او امة ثم قتلها فعليه حد الزنا كاملا والقود او الدية والقيمة لانها كلها حقوق اوجبها الله تعالي فلا تسقطها الاراء الفاسدة، وروي عن ابي حنيفة ان حد الزنا يسقط اذا قتلها فما سمع باعجب من هذه البلية ان يكون يزني فيلزمه الحد فاذا اضاف الي كبيرة الزنا كبيرة القتل للنفس التي حرم الله تعالي سقط عنه حد الزنا نبرا الي الله تعالي من ذلك، ونحمده علي السلامة منها كثيرا وبه نستعين *   مسالة  من وطء امراة ابيه او حريمته بعقد زواج او بغير عقد * قال ابو محمد: نا حمام نا عباس بن اصبغ نا محمد بن عبد الملك بن ايمن نا احمد ابن زهير نا عبد الله بن جعفر الرقي.
 وابراهيم بن عبد الله قال الرقي: نا عتبة بن عمرو الرقي عن زيد بن ابي انيسة عن عدي بن ثابت عن يزيد بن البراء بن عازب عن ابيه، وقال ابراهيم: نا هشيم عن اشعث بن سوار عن البراء بن عازب ثم اتفقا واللفط لهشيم قال: مر بي عمي الحرث بن عمرو وقد عقد له رسول الله صلي الله عليه وسلم فقلت له: اي
 عم اين بعثك رسول الله صلي الله عليه وسلم فقال: بعثني الي رجل تزوج امراة ابيه فامرني ان اضرب عنقه * قال ابو محمد رحمه الله: وهذا الخبر من طريق الرقيين صحيح نقي الاسناد،  واما من طريق هشيم فليست بشء لان اشعث بن سوار ضعيف * وبه الي احمد بن زهير نا يوسف بن منازل نا عبد الله بن ادريس نا خالد بن ابي كريمة عن معاوية بن قرة عن ابيه " ان رسول الله صلي الله عليه وسلم بعث اباه  هو جد معاوية  الي رجل اعرس بامراة ابيه فضرب عنقه وخمس ماله " قال احمد بن ابراهيم: قال يحيي بن معين: هذا الحديث صحيح ومن رواه فاوقفه علي معاوية فليس بشء قد كان ابن ادريس ارسله لقوم واسنده لاخرين، قال ابن معين: ويوسف بن منازل ثقة نا حمام نا عباس بن اصبغ نا محمد بن عبد الملك بن ايمن نا عبد الله بن احمد بن حنبل.
 وابو قلابة قال ابو قلابة: حدثنا المغيرة بن بكار نا شعبة سمعت الربيع بن الركين يقول: سمعت عدي بن ثابت يحدث عن البراء قال: مر بنا ناس ينطلقون قلنا: اين تريدون قالوا: بعثنا رسول الله صلي الله عليه وسلم الي رجل اتي امراة ابيه ان نضرب عنقه * قال ابو محمد رحمه الله: هذه اثار صحاح تجب بها الحجة ولا يضرها ان يكون عدي بن ثابت حدث به مرة عن البراء.
 ومرة عن يزيد بن البراء عن ابيه فقد يسمعه من البراء ويسمعه من يزيد البراء فيحدث به مرة عن هذا ومرة عن هذا، فهذا سفيان عن عيينة يفعل ذلك يروي الحديث عن الزهري مرة وعن معمر عن الزهري مرة قال: وقد اختلف الناس في هذا فقالت طاءفة: من تزوج امه او ابنته او حريمته او زني بواحدة منهن فكل ذلك سواء وهو كله زنا والزواج كلا زواج اذا كان عالما بالتحريم وعليه حد الزنا كاملا ولا يحلق الولد في العقد وهو قول الحسن.
 ومالك.
 والشافعي.
 وابي ثور وابي يوسف.
 ومحمد بن الحسن صاحبي
 ابي حنيفة: الا ان مالكا فرق بين الوطء في ذلك بعقد النكاح وبين الوطء في بعض ذلك بملك اليمين فقال: فيمن ملك بنت اخيه.
 او بنت اخته.
 وعمته.
 وخالته. 
 وامراة ابيه.
 وامراة ابنه بالولادة.
 وامه نفسه من الرضاعة.
 وابنته من الرضاعة.
 واخته من الرضاعة وهو عارف بتحريمهن وعارف بقرابتهن منه ثم وطءهن كلهن عالما بما عليه في ذلك فان الولد لاحق به ولا حد عليه لكن يعاقب وراي ان ملك امه التي ولدته.
 وابنته واخته بانهن حراءر ساعة يملكهن فان وطءهن حد حد الزنا، وقال ابو حنيفة: لا حد عليه في ذلك كله ولا حد علي من تزوج امه التي ولدته وابنته.
 واخته.
 وجدته.
 وعمته.
 وخالته.
 وبنت اخيه.
 وبنت اخته عالما بقرابتهن منه عالما بتحريمهن عليه ووطءهن كلهن فالولد لاحق به والمهر واجب لهن عليه وليس عليه الا التعزير دون الاربعين فقط، وهو قول سفيان الثوري قالا: فان وطءهن بغير  عقد نكاح فهو زنا عليه ما علي الزاني من الحد * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن قتادة عن سعيد بن المسيب انه قال فيمن زني بذات محرم يرجم علي كل حال، وقال ابراهيم النخعي.
 والحسن: حده حد الزنا، وبه الي عبد الرزاق عن معمر عن عوف  هو ابن ابي جميلة  ني عمرو ابن ابي هند قال.
 ان رجلا اسلم وتحته اختان فقال له علي بن ابي طالب: لتفارقن احداهما او لاضربن عنقك، وقال جابر بن زيد ابو الشعثاء.
 واحمد بن حنبل.
 واسحاق بن راهويه كل من وطء حريمته عالما بالتحريم عالما بقرابتها منه فسواء وطءها باسم نكاح او بملك يمين.
 او بغير ذلك فانه يقتل ولا بد محصنا كان او غير محصن * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر في ذلك ليلوح الحق فنتبعه ان شاء الله فبدانا بما احتج به ابو حنيفة ومن قلده لقوله فوجدناهم يقولون ان اسم الزنا غير اسم النكاح فواجب ان يكون له غير حكمه *
 (فاذا قلتم): زني بامه فعليه ما علي الزاني، (واذا قلتم): تزوج امه فالزواج غير الزنا فلا حد في ذلك وانما هو نكاح فاسد فحكمه حكم النكاح الفاسد من سقوط الحد ولحاق الولد ووجوب المهر وما نعلم لهم تمويها غير هذا وهو كلام فاسد.
 واحتجاج فاسد.
 وعمل غير صالح، اما قوله ان اسم الزنا غير اسم الزواج فحق لا شك فيه الا ان الزواج هو الذي امر الله تعالي به واباحه وهو الحلال الطيب والعمل المبارك، واما كل عقد او وطء لم يامر الله تعالي به ولا اباحه بل نهي عنه فهو الباطل والحرام والمعصية والضلال ومن سمي ذلك زواجا فهو كاذب افك متعد وليست التسمية في الشريعة الينا ولا كرامة انما هي الي الله تعالي قال الله عزوجل: (ان هي الا اسماء سميتوها انتم واباءكم ما انزل الله بها من سلطان) الاية * قال ابو محمد رحمه الله: اما من سمي كل عقد فاسد ووطء فاسد  وهو الزنا المحض  زواجا ليتوصل به الي اباحة ما حرم الله تعالي او الي اسقاط حدود الله تعالي الا كمن سمي الخنزير كبشا ليستحله بذلك الاسم، وكمن سمي الخمر نبيذا او طلاء ليستحلها بذلك الاسم، وكمن سمي البيعة والكنيسة مسجدا، وكمن سمي اليهودية اسلاما وهذا هو الانسلاخ من الاسلام ونقض عقد الشريعة وليس في المحال اكثر من قول القاءل هذا نكاح فاسد وهذا ملك فاسد لان هذا كلام ينقض بعضه بعضا ولءن كان نكاحا او ملكا فانه لصحيح حلال لان الله تعالي احل الزواج والملك وقال تعالي: (الا علي ازواجهم او ما ملكت ايمانهم) الاية فما كان زواجا وملك يمين فهو حلال طلق  ومباح طيب ولا ملامة فيه ولا ماثم وكل ما كان فيه اللوم والاثم فليس زواجا ولا ملكا مباحا للوطء ولا كرامة بل هو العدوان والزنا المجرد لا شء الا فراش او عهر حرام فان وجد لنا يوما ما ان نقول نكاح فاسد او زواج فاسد او ملك فاسد فانما هو حكاية اقوال لهم وكلام علي معانيهم كما قال تعالي: (وجزاء سيءة سيءة
 مثلها)، وكما قال تعالي: (فمن اعتدي عليكم فاعتدوا عليه بمثل ما اعتدي عليكم) (والله يستهزء بهم)، وقد علم المسلمون ان الجزاء ليس بسيءة وان القصاص ليس عدوانا وان معارضة الله تعالي علي الاستهزاء ليس مذموما بل هو حق فصح من هذا ان كل عقد لم يامر به الله تعالي فمن عقده فهو باطل وان وطء فيه فان كان عالما بالتحريم عالما بالسبب المحرم فهو زان مطلق، وهكذا القول فيمن نكح نكاح متعة او شغار او موهوبة او علي شرط ليس في كتاب الله تعالي او بصداق لا يحل.
 من جهل التحريم في شء من ذلك بان لم تبلغه او بتاويل لم تقم عليه الحجة في فساده فهو معذور لا حد عليه ومن قذفه فعليه الحد كمن دخل بلدا فتزوج امراة لا يعرفها فوجدها امه او ابنته فهذا يلحق فيه الولد ولا يحد فيه حد بالاجماع * وبهذا بطل قول ابي حنيفة المذكور.
 وقول مالك الذي وصفنا في وطء الحريمة بملك اليمين والعجب كل العجب من احتجاج بعض من لقيناه من المالكيين بقوله تعالي: (الا علي ازواجهم او ما ملكت ايمانهم) (قيل لهم): ان كنتم تعلقتم بهذه الاية في الحاق الولد بمن وطء عمته وخالته وذوات محارمه فانها من ملك اليمين فابيحوا الوطء المذكور واسقطوا عنه الملامة جملة فهذا هو نص الاية فلو فعلوا ذلك لكفروا بلا خلاف من احد واذ لم يفعلوا ذلك ولا اسقطوا الملامة ولا اباحوا له ذلك فقد ظهر تمويههم في ايراد هذه الاية في غير موضعها * قال ابو محمد رحمه الله: (فان قال قاءل): فانتم تقولون ان المملوكة الكتابية لا يحل وطءها وان وطءها فلا حد عليه والولد لاحق فما الفرق بين هذا وبين من وطء احدا من ذوات محارمه التي ذكرنا فاوجبتم في كل هذا حد الزنا ولم تلحقوا الولد، (قلنا): ان الفرق في ذلك هو ان الله تعالي اباح ملك اليمين جملة وحرم ذوات المحارم بالنسب والرضاع والصهر والمحصنات من النساء تحريما واحدا مستويا فحرمت اعيانهن كلهن تحريما واحدا ولم يحل منهن لمس ولا رءية عرية ولا تلذذ اصلا لانهن
 محرمات الاعيان، وقال تعالي: (ولا تنكحوا المشركات حتي يءمن) فانما حرم فيهن النكاح فقط والنكاح ليس الا عقد الزواج او الوطء فقط فاذا ملكناهن فلم تحرم علينا اعيانهن اذ لا نص في ذلك ولا اجماع وانما حرم وطءهن فقط وبقي ساءر ذلك علي  التحليل بملك اليمين كالمملوكة.
 والحاءض.
 والمحرمة.
 والصاءمة فرضا.
 والمعتكفة فرضا.
 والحامل من غير السيد ولا فرق، فلما لم يكن في واحدة من هءلاء محرمة العين كن فراشا في غير الوطء فكان الوطء وان كان حراما فهو في فراش لم يحرم فيه الا الوطء فقط وكل وطء في غير محرم العين فليس عهرا ولا زنا وانما العهر ما كان في محرمة العين فقط وبالله تعالي التوفيق * قال: ثم نظرنا فيمن اوجب الحد في وطء الام بعقد النكاح كحد الزنا بغيرها من الاجنبيات وقول من اوجب في ذلك القتل احصن او لم يحصن فوجدنا الخبر في قتل من اعرس بامراة ابيه ثابتا والحجة به قاءمة فوجب الحكم به ولم يسع احدا الخروج عنه فكان من قول المخالف في ذلك ان قالوا قد يمكن ان يكون ذلك الذي اعرس بامراة ابيه قد فعل ذلك مستحلا له فان كان هذا فنحن لا نخالفكم في ذلك فقلنا لهم: ان هذه الزيادة ممن زادها كذب علي رسول الله صلي الله عليه وسلم مجرد وعلي من روي ذلك عن الصحابة رضي الله عنهم ولو كان ذلك لقال الراوي: بعثنا رسول الله صلي الله عليه وسلم الي رجل ارتد فاستحل امراة ابيه فقتلناه علي الردة فاذ لم يقل ذلك الراوي فهو كذب مجرد، فهذه الزيادة ظن ما ليس فيه فصح ان من وطء امراة ابيه بعقد سماه نكاحا او بغير عقدكما جاءت الفاظ الحديث المذكور فقلته واجب ولا بد وتخميس ماله فرض ويكون الباقي لورثته ان كان لم يرتد او للمسلمين ان كان ارتد (فان قالوا): لم نجد مثل هذا في الاصول (قلنا لهم): لا اصل عندنا الا القران والسنة والاجماع فهذا الخبر اصل في نفسه ولكن اخبرونا في اي الاصول وجدتم ان من تزوج امه وهو يدري انها امه.
 او ابنته وهو يدري انها ابنته او اخته او احدي
 من ذوات محارمه وهو يدري عالم بالتحريم في كل ذلك فوطءهن فلا حد عليه والمهر واجب لهن عليه والولد لاحق به فما ندري هذا الا في غير الاسلام؟ * قال ابو محمد رحمه الله: واما نحن فلا يجوز ان نتعدي حدود الله فيما وردت به فنقول: ان من وقع علي امراة ابيه بعقد او بغير عقد او عقد عليهما باسم نكاح وان لم يدخل بها فانه يقتل ولابد محصنا كان او غير محصن ويخمس ماله وسواء امه كانت او غير امه دخل بها ابوه او لم يدخل بها، واما من وقع علي غير امراة ابيه من ساءر ذوات محارمه كامه التي ولدته من زنا او بعقد باسم نكاح فاسد مع ابيه فهي امه وليست امراة ابيه.
 او اخته او ابنته.
 او عمته.
 او خالته او واحدة من ذوات محارمه بصهر.
 او رضاع فسواء كان ذلك بعقد او بغير عقد هو زان وعليه الحد فقط،  وان احصن عليه الجلد والرجم كساءر الاجنبيات لانه زنا، واما الجاهل في كل ذلك فلا شء عليه *   مسالة  من احل لاخر فرج امته  قال ابو محمد رحمه الله: سواء كانت امراة احلت امتها لزوجها او ذي رحم محرم احل امته لذي رحمه او اجنبي فعل ذلك فقد ذكرنا قول سفيان في ذلك وهو ظاهر الخطا جدا لانه جعل الولد مملوكا لمالك امه واصاب في هذا ثم جعله لاحق النسب بواطء امه وهذا خطا فاحش لان رسول الله صلي الله عليه وسلم قال: " الولد للفراش وللعاهر الحجر " * وبين عز وجل ما هو الفراش وما هو العهر؟ فقال تعالي: (والذين هم لفروجهم حافظون) الي قوله تعالي: (العادون) فهذه التي احل مالكها فرجها لغيره ليست زوجة له ولا ملك يمين للذي احلت له وهذا خطا لان الله تعالي يقول: (ولا تاكلوا اموالكم بينكم بالباطل) الاية، وقال رسول الله صلي الله عليه وسلم: " ان دماءكم واموالكم عليكم حرام " وقد علمنا ان الذي احل الفرج لم يهب الرقبة ولا طابت نفسه باخراجها عن
 ملكه ولا رضي بذلك قط فان كان ما طابت به نفسه من اباحة الفرج وحده حلالا فلا يلزمه سواه ولا ينفذ عليه غير ما رضي به فقط وان كان ما طابت به نفسه من اباحة الفرج حراما فانه لا يلزمه والحرام مردود لقول رسول الله صلي الله عليه وسلم: " من عمل عملا ليس عليه امرنا فهو رد " فلا ينفذ عليه هبة الفرج، واما الرقبة فلم يرض قط باخراجها عن ملكه فلا يحل اخذها له بغير طيب نفسه الا بنص يوجب ذلك او اجماع * قال ابو محمد رحمه الله: فاذ الامر كما ذكرنا فالولد غير لاحق والحد واجب الا ان يكون جاهلا بتحريم ما فعل وبالله تعالي التوفيق *  مسالة  من احل فرج امته لغيره  نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج قال: اخبرني عمرو بن دينار انه سمع طاوسا يقول قال ابن عباس: اذا احلت امراة الرجل.
 او ابنته.
 او اخته له جاريتها فليصبها وهي لها فليجعل به بين وركيها قال ابن جريج: واخبرني ابن طاوس عن ابيه انه كان لا يري به باسا وقال: هو حلال فان ولدت فولدها حر والامة لامراته ولا يغرم الزوج شيءا، قال ابن جريج: واخبرني ابراهيم بن ابي بكر عن عبد الرحمن بن زادويه عن طاوس انه قال هو احل من الطعام فان ولدت فولدها للذي احلت له وهي لسيدها الاول قال ابن جريج: واخبرني عطاء بن ابي رباح قال: كان يفعل يحل الرجل  وليدته لغلامه وابنه واخيه وتحلها المراة لزوجها، قال عطاء: وما احب ان يفعل وما بلغني عن ثبت قال: وقد بلغني ان الرجل كان يرسل بوليدته الي ضيفه * قال ابو محمد رحمه الله: فهذا قول وبه يقول سفيان الثوري: وقال مالك.
 واصحابه لاحد في ذلك اصلا، ثم اختلف قوله في الحكم في ذلك فمرة قال: هي لمالكها المبيح ما لم تحمل فان حملت قومت علي الذي ابيحت له، ومرة قال: تقام باول وطءه
 علي الذي ابيحت له حملت او لم تحمل، وقالت طاءفة: اذا احلت فقد صار ملكها للذي احلت له بكليتها كما روينا بالسند المذكور الي عبد الرزاق عن معمر عن ابن مجاهد.
 وعمرو بن عبيد قال ابن مجاهد عن ابيه: وقال عمرو عن الحسن: ثم اتفقا اذا احلت الامة لانسان فعتقها له ويلحق به الولد * وبه الي عبد الرزاق عن ابن جريج قال: اخبرني عبد الله ابن قيس ان الوليد بن هشام اخبره انه سال عمر بن عبد العزيز فقال: امراتي احلت جاريتها لابيها قال: نهي له فهذا قول ثان، وذهب اخرون الي غير هذا كما روينا بالسند المذكور الي عبد الرزاق عن معمر عن الزهري في الرجل يحل الجارية للرجل فقال ان وطءها جلد ماءة احصن او لم يحصن ولا يلحق به الولد ولا يرثه وله ان يفتديه ليس لهم ان يمنعوه، وقال اخرون: بتحريم ذلك جملة كما روينا بالسند المذكور الي عبد الرزاق عن سفيان الثوري عن ابي اسحاق السبيعي عن سعيد بن المسيب قال: جاء رجل الي ابن عمر فقال: ان امي كانت لها جارية وانها احلتها لي ان اطاها عليها قال: لا تحل لك الا من احدي ثلاث: اما ان تتزوجها، واما ان تشتريها، واما ان تهبها لك، وبه الي عبد الرزاق عن معمر عن قتادة ان ابن عمر قال: لا يحل لك ان تطا الا فرجا لك ان شءت بعت وان شءت وهبت وان شءت اعتقت * وبه الي عبد الرزاق عن ابن جريج عن عمرو بن دينار قال: لا تعار الفروج * قال ابو محمد رحمه الله: اما قول ابن عباس فهو عنه وعن طاوس في غاية الصحة ولكنا لا نقول به اذ لا حجة في قول احد دون رسول الله صلي الله عليه وسلم، وقد قال تعالي: (والذين هم لفروجهم حافظون الا علي ازواجهم او ما ملكت ايمانهم) الاية الي قوله (العادون) فقول الله احق ان يتبع، واما قول مالك فظاهر الخطا وما نعلم احدا قال به قبله ويبطل قوله في التقويم بما يبطل به قول من راي ان الملك ينتقل بالاباحة الا ان قول مالك: زاد ايجاب القيمة في ذلك، واما قول عمر بن عبد العزيز.
 والحسن.
 ومجاهد قد تقدم ابطالنا اياه بانه لا يحل ان يلزم المرء في ماله ما لم يلتزمه الا ان يلزمه
 ذلك نص او اجماع فمن اباح الفرج وحده فلم يبح الرقبة فلا يحل اخراج ملك الرقبة  عن يده بالباطل وليس الا احد وجهين لا ثالث لهما، اما جواز هبته فهو قول ابن عباس.
 واما ابطاله فهو قول ابن عمر: فالرقبة في كلا الوجهين باقية علي ملك مالكها لا يحل سوي ذلك اصلا، واما قول الزهري فخطا ايضا لا يخلو وطء الفرج الذي احل له من احد وجهين لا ثالث لهما، اما ان يكون زانيا فعليه حد الزنا من الرجم والجلد او الجلد والتغريب او يكون غير زان فلا شء عليه، واما الاقتصار علي ماءة جلدة فلا وجه له ولا يلحق الولد ههنا اصلا جاهلا كان او عالما لانها ليست فراشا اصلا ولا له فيها عقد ولا مهر عليه ايضا لان ماله حرام الا بنص او اجماع ولم يوجب عليه المهر ههنا نص ولا اجماع وعلي المحلل التعزير ان كان عالما فان كانوا جهالا او احدهم فلا شء علي الجاهل اصلا *  مسالة  الشهود في الزنا لا يتمون اربعة  قال ابو محمد رحمه الله: قال قوم: اذا لم يتم الشهود اربعة حدوا حد القذف كما نا عبد الله بن ربيع نا عبد الله ابن محمد بن عثمان نا احمد بن خالد نا علي بن عبد العزيز نا الحجاج بن المنهال نا حماد بن سلمة انا علي بن زيد بن جدعان عن عبد الرحمن بن ابي بكرة ان ابا بكرة وزيادا ونافعا وشبل ابن معبد كانوا في دار ابي عبد الله في غرفة ورجل في اسف ذاك اذ هبت ريح ففتحت الباب ووقعت الشقة فاذا رجل بين فخذيها فقال بعضهم: قد ابتليا بما ترون فتعاهدوا وتعاقوا علي ان يقوموا بشهادتهم فلما حضرت صلاة العصر اراد الرجل ان يتقدم فيصلي بالناس فمنعه ابو بكرة وقال لا والله لا تصلي بنا وقد راينا ما راينا فقال الناس: دعوه فليصل فانه الامير واكتبوا بذلك الي عمر فكتبوا الي عمر فكتب عمر بن الخطاب ان اقدموا علي فلما قدموا شهد عليه ابو بكرة.
 ونافع.
 وشبل وقال زياد: قد رايت رعة سيه ورايت ورايت ولكن لا ادري انكحها ام لا فجلدهم عمر الا زيادا
 فقال ابو بكرة: الستم قد جلدتموني قالوا: بلي قال: فاشهد بالله الف مرة لقد فعل فاراد عمر بن الخطاب ان يجلده الثانية فقال علي بن ابي طالب: ان كانت شهادة ابي بكرة شهادة رجلين فارجم صاحبك والا فقد جلد تموه * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن الزهري عن ابن المسيب قال شهد علي المغيرة بن شعبة ثلاثة بالزنا ونكل زياد فجلد عمر الثلاثة وقال لهم: توبوا تقبل شهادتكم فتاب اثنان ولم يتب ابو بكرة فكانت لا تقبل شهادته وابو بكرة اخو زياد لامه فحلف ابو بكرة ان لا يكلم زيادا ابدا فلم يكلمه حتي مات * ومن طريق عبد الرزاق عن معمر عن بديل العقيلي عن ابي الوضاح قال: شهد ثلاثة نفر علي رجل وامراة  بالزنا وقال الرابع: رايتهما في ثوب واحد فان كان هذا زنا فهو ذاك فجلد علي الثلاثة وعزر الرجل والمراة * قال ابو محمد رحمه الله: وبهذا يقول ابو حنيفة.
 والشافعي.
 واصحابهما، وقال ابو ثور.
 وابو سليمان.
 وجميع اصحابنا لا يحد الشاهد بالزنا اصلا كان معه غيره او لم يكن * قال ابو محمد رحمه الله: فلما اختلفوا وجب ان ننظر فيما احتجت به كل طاءفة لقولها ليلوح الحق من ذلك فنتبعه بعون الله تعالي فوجدنا من قال: يحد الشهود اذا لم يتموا اربعة بان ذكروا ما ناه حمام نا ابن المفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق نا ابن جريج عن عمرو بن شعيب قال: قال رسول الله صلي الله عليه وسلم: " قضاء الله ورسوله ان لا تقبل شهادة ثلاثة ولا اثنين ولا واحدا علي الزنا ويجلدون ثمانين جلدة ولا تقبل لهم شهادة ابدا حتي يتبين للمسلمين منهم توبة نصوح واصلاح " * وقالوا: حكم عمر ابن الخطاب بحضرة علي وعدة من الصحابة رضي الله عنهم لا ينكر ذلك عليه منهم احد فكان هذا اجماعا، وهذا كل ما موهوا به ما نعلم لهم حجة غير هذا
 الا ان بعضهم ذكر قول رسول الله صلي الله عليه وسلم للذي رمي امراته البينة والا حد في ظهرك * قال ابو محمد رحمه الله: وكل هذا لا حجة لهم فيه اما خبر عمرو بن شعيب فمنقطع اقبح انقطاع لانه لم يذكر من بينه وبين رسول الله صلي الله عليه وسلم ولا حجة عندنا في مرسل ولا عند الشافعي فلا يجوز لهم ان يحتجوا علينا به لاننا لا نقول به اصلا فيلزمونا اياه علي اصلنا وهم لا يقولون به فيحتجوا به علي اصولهم * قال ابو محمد رحمه الله: ثم نظرنا في قول من قال انه لا حد علي الشاهد سواء كان وحده لا احد معه او اثنين كذلك او ثلاثة كذلك فوجدناهم يقولون قال الله تعالي: (والذين يرمون المحصنات ثم لم ياتوا باربعة شهداء فاجلدوهم ثمانين جلدة) وقال رسول الله صلي الله عليه وسلم: " للقاذف البينة والا حد في ظهرك " فصح يقينا لامرية فيه بنص كلام الله تعالي وكلام رسوله صلي الله عليه وسلم ان الحد انما هو علي القاذف الرامي لا علي الشهداء ولا علي البينة، وقد صح ان رسول الله صلي الله عليه وسلم قال: " ان دماءكم واموالكم واعراضكم وابشاركم عليكم حرام كحرمة يومكم هذا من شهركم هذا " فبشرة الشاهد حرام بيقين لا مرية فيه ولم يات نص قران ولا سنة صحيحة بجلد الشاهد في الزنا اذا لم يكن معه غيره وقد فرق القران والسنة بين الشاهد من البينة وبين القاذف الرامي  فلا يحل البتة ان يكون لاحدهما حكم الاخر فهذا حكم القران والسنة الثابتة * واما الاجماع فان الامة كلها مجمعة بلا خلاف من احد علي ان الشهود اذا شهدوا واحدا بعد واحد فتموا عدولا اربعة فانه لا حد عليه * وكذلك اجمعوا بلا خلاف من احد منهم لو ان الف عدل قذفوا امراة او رجلا كذلك بالزنا مجتمعين او مفترقين ان الحد عليهم كلهم حد القذف ان لم ياتوا باربعة شهداء فان جاءوا باربعة شهداء سقط الحد عن القذفة فقد صح الاجماع المتيقن الذي لا شك فيه * واما المخالفون لنا في
 الجملة علي الفرق بين حكم القاذف وبين حكم الشاهد وان القاذف فليس شاهدا وان الشاهد ليس قاذفا فقد صح الاجماع علي هذا بلا شك وصح اليقين ببطلان قول من قال بان يحد الشاهد والشاهدان والثلاثة اذا لم يتموا اربعة لانهم ليسوا قذفة ولا لهم حكم القاذف وهذا هو الاجماع حقا الذي لا يجوز خلافه * واما طريق النظر فنقول وبالله تعالي التوفيق: انه لو كان ما قالوا لما صحت في الزنا شهادة ابدا لانه كان الشاهد الواحد اذا شهد بالزنا صار قاذفا عليه الحد علي اصلهم فاذ قد صار قاذفا فليس شاهدا فاذا شهد الثاني فكذلك ايضا يصير قاذفا وهذا فاسد كما تري وخلاف للقران في ايجاب الحكم بالشهادة بالزنا وخلاف السنة الثابتة بوجوب قبول البينة في الزنا وخلاف الاجماع المتيقن بقبول الشاهدة في الزنا وخلاف الحس والمشاهدة في ان الشاهد ليس قاذفا والقاذف ليس شاهدا، وايضا فنقول لهم اخبرونا عن الشاهد اذا شهد علي اخر بالزنا وهو عدل ماذا هو الان عندكم اشاهد ام قاذف ام لا شاهد ولا قاذف؟ ولا سبيل الي قسم ثالث فان قالوا: هو شاهد قلنا صدقتم وهذا هو الحق واذ هو شاهد فليس قاذفا حين نطق بالشهادة فمن المحال الممتنع ان يصير قاذفا اذا سكت ولم يات بثلاثة عدول اليه وليس في المحال اكثر من ان يكون شاهدا لا قاذفا فاذا تكلم باطلاق الزنا عل المشهود عليه بم يصير قاذفا لا شاهدا اذا لم يتكم ولا نطق بحرف فهذا محال لا اشكال فيه وان قالوا هو قاذف فقد ذكروا وجوب الحد علي القاذف بلا شك فقد وجب الحد عليه *   مسالة  شهد اربعة بالزنا علي امراة احدهم زوجها * قال ابو محمد رحمه الله: اختلف الناس في هذا فقالت طاءفة: ليست شهادة ويلا عن الزوج كما روينا عن ابن عباس في اربعة شهداء شهدوا بالزنا علي امراة واحدهم زوجها قال يلا عن الزوج ويحد الاخرون، وعن ابراهيم النخعي بمثله، وبه يقول مالك.
 والشافعي.
 والاوزاعي في احد قوليه، وقال اخرون ان كانوا عدولا فالشهادة تامة وتحد المراة  كما روينا عن الحسن البصري في اربعة شهدوا علي امراة بالزنا احدهم زوجها قال اذا جاءوا مجتمعين الزوج اجوزهم شهادة، وعن الشعبي انه قال في اربعة شهدوا علي امراة بالزنا احدهم زوجها انه قد جازت شهادتهم واحرزوا ظهورهم، وقال الحكم ابن عتيبة: في اربعة شهدوا علي امراة بالزنا احدهم زوجها حتي يكون معهم من يجء بها وبهذا ياخذ ابو حنيفة.
 والاوزاعي في احد قوليه * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر فيما احتج به كل قاءل منهم لقوله فوجدنا كلتا الطاءفتين تتعلق بقول الله تعالي: (والذين يرمون ازواجهم ولم يكن لهم شهداء الا انفسهم) وبقول رسول الله صلي الله عليه وسلم: " لهلال بن امية البينة والا حد في ظهرك " فنظرنا في هذين النصين فوجدناهما انما نزلا في الزوج اذا كان راميا قاذفا لا اذا كان شاهدا هذا نص الاية ونص الخبر فليس حكم الزوج اذا كان شاهدا لا قاذفا راميا فوجب ان نطلب حكم شهادة الزوج في غيرهما فوجدنا الله تعالي يقول: (والذين يرمون المحصنات ثم لم ياتوا باربعة شهداء فاجلدوهم) فشرط الله تعالي علي القاذف ان لم يات باربعة شهداء ان يجلد ولم يخص تعالي اولءك الاربعة الشهداء ان لا يكون منهم زوجها (وما كان ربك نسيا)، ولو اراد الله تعالي ان لا يكون الزوج احد اولءك الشهداء لبين ذلك ولما كتمه ولا اهمله فاذا عم الله تعالي ولم يخص فالزوج وغير الزوج في ذلك سواء بيقين لا شك فيه فصح من هذا ان الزوج اذا قذف امراته فعليه حد القذف الا ان يلاعن او ياتي باربعة شهداء سواه لانه قاذف ورام والقاذف والرامي مكلف ان يخلص نفسه باربعة شهداء ولا بد، وهكذا الاجنبي ولا فرق اذا قذف فلا بد من اربعة غيره فان جاء الزوج شاهدا لا قاذفا فهو كالاجنبي الشاهد ولا فرق لا حد عليه ولا لعان اصلا لانه لم يرمها ولا قذفها فان كان عدلا وجاء معه بثلاثة شهود فقد تمت الشهادة ووجب الرجم عليها لانهم اربعة شهود كما امر الله تعالي وبه ناخذ *
 واما اشتراط الحكم بن عتيبة من ان يكون معهم من ياتي بهم فلا معني له لان الله تعالي لم يوجب ذلك ولا رسوله صلي الله عليه وسلم ولا يخلو ذلك الخامس من احد ثلاثة اوجه لا رابع لها اما ان يكون قاذفا واما ان يكون شاهدا واما ان يكون متطوعا لا قاذفا ولا شاهدا فان كان قاذفا فمن الحرام والباطل ان يلزم الشهود ان ياتي قاذفا يتقدمهم او يامر بقذف المحصنة والمحصن ليتوصل بذلك الي اقامة الشهادة وان كان ذلك الخامس شاهدا فهذا ايجاب لخمسة شهود وهذا خلاف القران.
 والسنة.
 والاجماع، وان كان متطوعا لا قاذفا ولا شاهدا فهذا باطل لان الله تعالي لم يوجبه ولا رسوله صلي الله عليه وسلم  فسقط قول الحكم في ذلك * قال ابو محمد رحمه الله: فالحكم في هذا علي ثلاثة اوجه اذا كان الزوج قاذفا فلا بد من اربعة شهود سواه والا حد او يلاعن فان لم يكن قاذفا لكن جاء شاهدا فان كان عدلا ومعه ثلاثة عدول فهي شهادة تامة وعلي المشهود عليها حد الزنا كاملا وان كان الزوج غير عدل او كان عدلا وكان في الذين معه غير عدل او لم يتم ثلاثة سواه والشهادة لم تتم فلا حد علي المشهود وليس الشهود قذفه فلا حد عليهم ولا حد علي الزوج ولا لعان لانه ليس قاذفا وبالله تعالي التوفيق *  مسالة  شهد اربعة بالزنا علي امراة وشهد اربعة نسوة انها عذراء * قال ابو محمد رحمه الله: اختلف الناس في هذا فقالت طاءفة: لا حد عليها كما روينا عن الشعبي انه قال في اربعة رجال عدول شهدوا علي امراة بالزنا وشهد اربع نسوة بانها بكر فقال: اقيم عليها الحد وعليها خاتم من ربها * قال ابو محمد رحمه الله: هذا علي الانكار منه لاقامة الحد عليها، وقالت طاءفة: تحد كما حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ حدثنا ابن وضاح نا سحنون حدثنا ابن وهب عن الحرث بن نبهان في اربعة شهدوا بالزنا علي امراه
 ونظر النساء اليها فقلن انها عذراء قال: اخذ بشهادة الرجال واترك شهادة النساء واقيم عليها الحد، وباسقاط الحد عنها يقول ابو حنيفة.
 واصحابه الازفر، وبه يقول سفيان الثوري.
 والشافعي، وقال مالك.
 وزفر بن الهذيل.
 واصحابنا تحد * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر في ذلك فوجدنا من راي ايجاب الحد عليها يقول قد صحت البينة عليها بما يوجب الحد بنص القران فلا يجوز ان يعارض امر ربه تعالي بشء وما نعلم لهم حجة غير هذا فعارضهم الاخرون بان قالوا: بانه لا خلاف انه اذا صح ان الشهود كاذبون او واهمون فان الشهادة ليست حقا بل هي باطل ولا يحل الحكم بالباطل وانما امر الله تعالي بانفاذ الشهادة اذا كانت حقا عندنا في ظاهرها لا اذا صح عندنا بطلانها، وهذه قد صح عندنا بطلانها فلا يجوز الحكم بها * قال ابو محمد رحمه الله: قال الله تعالي: (كونوا قوامين بالقسط شهداء لله) فواجب اذا كانت الشهادة عندنا في ظاهرها حقا ولم يات شء يبطلها ان يحكم بها واذا صح عندنا انها ليست حقا ففرض علينا ان لا نحكم بها اذ لا يحل الحكم بالباطل هذا هو الحق الذي لا شك فيه، ثم نظرنا في الشهود لها انها عذراء فوجب ان يقرر  النساء علي صفة عذرتها فان قلن انها عذرة يبطلها ايلاج الحشفة ولابد وانه صفاق عند باب الفرج فقد ايقنا بكذب الشهود وانهم وهموا فلا يحل انفاذ الحكم بشهادتهم وان قلن انها عذرة واغلة في داخل الفرج لا يبطها ايلاج الحشفة فقد امكن صدق الشهود اذ بايلاج الحشفة يجب الحد فيقام الحد عليها حينءذ لانه لم نتيقن كذب الشهود ولا وهمهم وبالله تعالي التوفيق *  مسالة كم الطاءفة التي تحضر حد الزاني او رجمه؟ * قال ابو محمد رحمه الله: قال الله تعالي: (وليشهد عذابهما طاءفة من المءمنين)
 قال: (ويدرا عنها العذاب ان تشهد اربع شهادات بالله انه لمن الكاذبين).
 فصح ان عذاب الزناة الجلد ومع الجلد الرجم والنفي، ثم اختلف العلماء في مقدار الطاءفة التي افترض الله تعالي ان تشهد العذاب المذكور فقالت طاءفة: هي واحد من الناس فان زاد فجاءز  وهو قول ابن عباس  كما روي الثوري عن ابن ابي نجيح عن مجاهد قال: الطاءفة رجل وبهذا يقول اصحابنا، وقالت طاءفة: الطاءفة اثنان فصاعدا كما روينا عن عطاء قال اثنان فصاعدا، وبه يقول اسحق بن راهويه، وقالت طاءفة: ثلاثة فصاعدا كما روينا عن ابن شهاب، وقال ابن وهب: سمعت شمر بن نمير يحدث عن الحسين بن عبيد الله بن ضميرة عن ابيه عن جده عن علي بن ابي طالب مثله سواء سواء ان الطاءفة ثلاثة فصاعدا وبه يقول الشافعي في احد قوليه، وقالت طاءفة: الطاءفة نفر دون ان يحدوا عددا كما روينا عن معمر عن قتادة انه سمع (وليشهد عذابهما طاءفة من المءمنين) قال نفر من المسلمين، وقالت طاءفة: الطاءفة اربعة فصاعدا كما روينا عن الليث بن سعد، وقالت طاءفة: الطاءفة خمسة فصاعدا كما روينا عن ربيعة بن ابي عبد الرحمن، وقالت طاءفة: الطاءفة عشرة كما روي عن الحسن البصري انه قال: الطاءفة عشرة * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر في ذلك فوجدنا جميع الاقوال لا يحتج بها الا قول مجاهد.
 وابن عباس وهو ان الطاءفة.
 واحد فصاعدا فوجدناه قولا يوجبه البرهان من القران والاجماع واللغة فاما القران فان الله تعالي يقول: (وان طاءفتان من المءمنين اقتتلوا فاصلحوا بينهما فان بغت احداهما علي الاخري) الاية فبين تعالي نصا جليا انه اراد بالطاءفتين هنا الاثنين فصاعدا بقوله في اول الاية: (اقتتلوا) وبقوله تعالي: (فان بغت احداهما علي الاخري) وبقوله تعالي في اخر الاية: (فاصلحوا بين اخويكم) وبرهان اخر وهو ان  الله تعالي قال: (وليشهد عذابهما طاءفة من المءمنين) وبيقين ندري ان الله تعالي لو اراد بذلك عددا من عدد لبينه ولاوقفنا عليه ولم يدعنا نخبط فيه عشواء حتي نتكهن فيه الظنون الكاذبة حاش لله تعالي من هذا وبالله تعالي التوفيق *  مسالة حد الرمي بالزنا  وهو القذف  قال الله تعالي: (والذين يرمون المحصنات ثم لم ياتوا باربعة شهداء فاجلدوهم ثمانين جلدة) الي قوله تعالي: (غفور رحيم) * قال ابو محمد رحمه الله: ففي هذه الاية احكام كثيرة يجب الوقوف عليها بان تطلب علمها وان تعتقد وان يعمل بها بعون الله تعالي علي ذلك فمنها معرفة ما هو الرمي الذي يوجب الحكم المذكور في الاية من الجلد واسقاط الشهادة والفسق وان القذف من الكباءر ومن المحصنات اللواتي يجب برميهن الحكم المذكور في الاية من الجلد واسقاط الشهادة والفسق وعدد الجلد وصفته.
 ومن المامور بالجلد.
 ومتي يمتنع من قبول شهادتهم وفيما ذا يمتنع من قبولها وفسقهم وما يسقط بالتوبة من الاحكام المذكورة وما صفة التوبة من ذلك ونحن ان شاء الله تعالي نذكر كل ذلك بعون الله تعالي بالبراهين الواضحة من القران والسنن الثابتة في ذلك ولا حول ولا قوة الا بالله *  مسءالة  ما الرمي.
 والقذف؟  قال ابو محمد رحمه الله: ذكر الله تعالي هذا الحكم باسم الرمي في الاية المذكورة وصح ان القذف والرمي اسمان لمعني واحد لما ناه عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب نا اسحق بن ابراهيم  هو ابن راهويه  انا عبد الاعلي  هو ابن عبد الاعلي السلمي  قال: سءل هشام  هو ابن حسان  عن الرجل يقذف امراته فحدثنا هشام عن محمد  يعني ابن سيرين  قال: سالت انس ابن مالك عن ذلك وانا اري ان عنده من ذلك علما فقال ان هلال بن امية قذف امراته بشريك بن سحماء وكان اخا البراء بن مالك وكان اول من لاعن فلاعن رسول الله صلي الله عليه وسلم بينهما ثم قال: " ابصروه فان جاءت به ابيض فض العينين فهو لهلال ابن امية وان جاءت به اكحل جعدا احمش الساقين فهو لشريك بن سحماء " قال انس:
 فانبءت انها جاءت به اكحل جعد احمش الساقين * حدثنا عبد الله بن ربيع نا محمد ابن معاوية عن محمد بن سيرين عن انس بن مالك قال: اول لعان كان في الاسلام ان هلال بن امية قذف شريك بن سحماء بامراته فاتي النبي صلي الله عليه وسلم فاخبره بذلك فقال له النبي صلي الله عليه وسلم: " اربعة شهداء والا حد في ظهرك " وذكر حديث اللعان * قال ابو محمد رحمه الله: فهذا انس بن مالك حجة في اللغة وفي النقل في الديانة قد سمي الرمي قذفا مع انه لا خلاف في ذلك من احد من اهل اللغة ولا بين  احد من اهل الملة، وكذلك لا خلاف بين احد من اهل الاسلام في ان الرمي المذكور في الاية المذكورة الموجب للجلد والفسق وسقوط الشهادة هو الرمي بالزنا بين الرجال والنساء ثم اختلف العلماء في الرمي بغير الزنا ايوجب حدا ام لا؟ فقالت طاءفة: لا حد الا في الرمي بالزنا فقط ولا حد في غير ذلك لا في نفي عن نسب اب او جد ولا في رمي بلوطية ولا في رمي ببغاء ولا في رمي رجل بوطء في دبر امراة ولا في اتيان بيهمة ولا في رمي امراة انها اتيت في دبرها ولا في رميها ببهيمة ولا في رمي بكفر ولا بشرب خمر ولا في شء اصلا، وهو قول اصحابنا، وقال قاءلون في بعض ما ذكرنا ايجاب الجلد ونحن نذكر ان شاء الله تعالي ما يسر الله تعالي لذكره من ذلك وبيان الحق ان شاء الله تعالي وبه نستعين *  مسالة النفي عن النسب  قال ابو محمد رحمه الله: اختلف الناس فيمن نفي اخر عن نسبه فقالت طاءفة: فيه الحد، وقالت طاءفة: لا حد فيه فاما من اوجب فيه الحد فهو كما قال ابن مسعود لا حد الا في اثنين ان يقذف محصنة او ينفي رجلا عن ابيه وان كانت امه امة، وعن الشعبي في الرجل ينفي الرجل من فخذه قال: ليس عليه حد الا ان ينفيه من ابيه * وعن الشعبي.
 والحسن قالا جميعا: يضرب الحد * وعن ابراهيم النخعي قال: من نفي رجلا عن ابيه كان ابوه ما كان فعليه الحد ومن
 قال لرجل من بني تميم لست منهم وهو منهم او لرجل من بني بكر لست منهم وهو منهم فعليه الحد.
 وعن ابراهيم النخعي في رجل نفي رجلا عن ابيه قال له: لست لابيك وامه نصرانية او مملوكة قال لا يجلد، ومن طريق عبد الرزاق نا ابن جريج قال: سمعت حفص بن عمر بن ربيع يقول كان بين ابي وبين يهودي مرافعة في القول في شفعة فقال ابي لليهودي يهودي بن يهودي فقال: اجل والله اني اليهودي ابن اليهودي اذ لا يعرف رجال كثير اباءهم فكتب عامل الارض الي عمر بن عبد العزيز  وهو عامل المدينة  بذلك فكتب فقال ان كان الذي قال له ذلك يعرف ابوه فحد اليهودي فضربه ثمانين سوطا * وعن ابن جريج انه قال: سال ابن شهاب عن رجل قيل له يا ابن القين ولم يكن ابوه قينا قال: نري ان يجلد الحد، واما من روي عنه انه لا حد في ذلك كما روينا من طريق عبد الرزاق عن ابراهيم بن محمد عن اسحق بن عبد الله عن محكول ان معاذ بن جبل.
 وعبد الله بن عمرو بن العاصي رضي الله عنهما قالا جميعا: ليس الحد الا في الكلمة ليس لها مصرف وليس لها الا وجه واحد * وعن علي بن ابي طالب رضي الله عنه قال اذا بلغ الحد لعل وعسي فالحد معطل، وقد روي عن  ابن عباس رضي الله عنه فيم قال لرجل يا نبطي انه لا حد عليه * وعن عطاء بن ابي رباح انه سءل عن رجل قال لرجل يا نبطي ويا عبد بني فلان فلم ير عطاء فيه شيءا، وعن الشعبي انه سءل عن رجل قال لعمري يا نبطي فلم ير الشعبي في ذلك شيءا وقال: كلنا نبط وبه يقول اصحابنا * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر في ذلك لنعلم الحق فنتبعه فوجدنا الزهري يقول في نفي المرء عن ابيه او عن نسبه كما اوردنا عنه قبل ذلك ان السنة علي النافي في كتاب الله تعالي وسنة نبيه عليه السلام ان ياتي باربعة شهداء فنظرنا هل نجد هذا الذي ذكر الزهري في كتاب الله تعالي؟ فلم نجده اصلا
 وانما وجدنا فيه الحد ووجوب اربعة شهداء علي من رمي المحصنات فوجدنا النافي انسانا عن نسبه فلم يرم محصنة اصلا، والزهري وان كان عندنا احد الاءمة الفضلاء فهو بشر يهم كما يهم غيره ويخطء ويصيب بل وجدنا نص القران مخالفا لقول الزهري لانه يسقط الحد عمن رمي المحصنات اذا قال لابن امه او ابن كافرة يا ابن الزانية واوجبه حيث ليس في القران ايجابه اذا قال له لست لابيك فسقط تعلقهم بذلك جملة، فان قالوا: النافي قاذف ولابد قلنا: لا ما هو قاذف ولا قدف احدا وقد ينفيه عن نسبه بانه استلحق وانه من غيرهم ابن نكاح صحيح فقد كانت العرب تفعل هذا فلا قذف ههنا اصلا وقد يكون نفيه له بان اراد الاستكراه لامه وانها حملت به في حالة لا يكون للزنا فيه دخول كالناءمة توطا او السكري او المغمي عليها او الجاهلة فقد بطل ان يكون النافي قاذفا جملة واحدة، ثم نظرنا هل في السنة لهم متعلق؟ فوجدنا ما ناه احمد بن قاسم نا ابي قاسم بن محمد بن قاسم نا جدي قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب اخبرني حيوة بن شريح عن سالم بن غيلان عن يحيي بن سعيد الانصاري عن سليمان بن يسار عن بعض اصحاب النبي صلي الله عليه وسلم ان رسول الله صلي الله عليه وسلم جلد رجلا ان دعا اخر يا ابن المجنون * قال ابو محمد: فنظرنا في هذا الخبر فوجدناه لا متعلق لهم به اصلا من وجوه، اولها انه مرسل ولا تقوم بمرسل حجة، والثاني من طريق سالم بن غيلان التجيبي وهو مجهول لم يعدل.
 وثالثها انه لو صح لم يكن فيه حجة لانه ليس فيه انه عليه السلام جلده الحد وانما فيه انه جلده فلا يحل ان يراد فيه انه جلده الحد ونحن لا نابي من ذلك من سب مسلما لانه منكر يغير باليد فبطل ان تكون لهم فيه حجة بل هو عليهم، وقد روي هذا الخبر يونس بن عبد الاعلي وهو احفظ من سحنون واعرف بالحديث منه فلم يبلغه الي رسول الله صلي الله عليه وسلم كما نا عبد الله بن ربيع نا محمد بن  معاوية نا احمد بن شعيب انا يونس بن عبد الاعلي اخبرنا ابن وهب اخبرني بن حيوة بن شريح
 عن سالم بن غيلان التجيبي عن يحيي بن سعيد عن سليمان بن يسار قال: ان بعض اصحاب رسول الله صلي الله عليه وسلم جلد رجلا ان دعا اخر يا ابن المجنون * قال ابو محمد رحمه الله: وهذا ايضا كالذي ذكرنا قبل لانه ليس فيه انه جلده الحد والحدود لا تقام بالظنون الكاذبة والزيادة في الحديث كذب وتبليغ الحد المذكور الي ثمانين كذب بلا شك ممن قطع بذلك فبطل تعلقهم بهذا الخبر جملة ثم نظرنا في ذلك فوجدنا الله تعالي قد اوجب في القذف بالزنا الحد وجاءت به السنة الصحيحة وصح به الاجماع المتيقن فكان هذا هو الحق الذي لا شك فيه ووجدنا رسول الله صلي الله عليه وسلم قد قال: " ان دماءكم واموالكم واعراضكم وابشاركم عليكم حرام " وقد قال تعالي: (تلك حدود الله فلا تعتدوها) وقال تعالي: (ولا تعتدوا ان الله لا يحب المعتدين) فحرم الله تعالي العدوان وضرب الابشار بغير برهان من العدوان وحرم تعالي ان تتعدي حدوده واثبات حد بغير برهان تعد لحدود الله تعالي وبالله تعالي التوفيق *   مسالة  قذف المءمنات من الكباءر وتعرض المرء لسب ابويه من الكباءر * قال ابو محمد رحمه: قال الله تعالي: (ان تجتنبوا كباءر ما تنهون عنه نكفر عنكم سيءاتكم) الاية * وقال تعالي: (والذين يجتنبون كباءر الاثم والفواحش) الاية، وكما روينا من طريق مسلم ني هارون بن سعيد الايلي نا ابن وهب اخبرني سليمان بن بلال عن ثور بن يزيد عن ابي الغيث عن ابي هريرة عن رسول الله صلي الله عليه وسلم قال: " اجتنبوا السبع الموبقات قيل يا رسول الله وما هن؟ قال الشرك بالله والسحر وقتل النفس التي حرم الله الا بالحق واكل مال اليتيم واكل الربا والتولي يوم الزحف وقذف المحصنات الغافلات المءمنات "، وقال الله تعالي: (ان الذين يرمون المحصنات الغافلات المءمنات لعنوا في الدنيا والاخرة) الاية * قال ابو محمد رحمه الله: فصح ان قذف المءمنات المحصنات البريءات من الكباءر
 الموجبة للعنة في الدنيا والاخرة والعذاب العظيم في الاخرة ودخل فيها قذف الامة والحرة دخولا مستويا لان الله تعالي لم يخص مءمنة من مءمنة وبقي قذف الكافرة فوجدنا الله تعالي قال: (والذين يرمون المحصنات ثم لم ياتوا باربعة شهداء فاجلدوهم ثمانين جلدة) الاية فهذه عموم تدخل فيه الكافرة والمءمنة فوجب ان قاذفها فاسق الا ان يتوب * وروينا من طريق مسلم نا محمد بن الوليد بن عبد الحميد انا محمد بن جعفر نا شعبة نا عبيد الله بن ابي بكر قال سمعت انس بن مالك قال: " ذكر رسول الله صلي الله عليه وسلم الكباءر  وسءل عن الكباءر فقال: الشرك بالله وقتل النفس وعقوق الوالدين قال الا انبءكم باكبر الكباءر قول الزور او قال شهادة الزور  قال شعبة: واكبر ظني انه قال  شهادة الزور " * ومن طريق مسلم انا عمر بن محمد بن بكير الناقد نا اسماعيل بن علية عن سعيد الجريري نا عبد الرحمن بن ابي بكرة عن ابيه انه قال: " كنا عند رسول الله صلي الله عليه وسلم فقال الا انبءكم باكر الكباءر ثلاثا الاشراك بالله وعقوق الوالدين وشهادة الزور او قول الزور وكان رسول الله صلي الله عليه وسلم متكءا فجلس فما زال يكررها حتي قلنا ليته سكت " * قال ابو محمد رحمه الله: ليس شك الراوي بين قوله عليه السلام شهادة الزور او قول الزور بمحيل شيءا من حكم هذين الخبرين فاي ذلك كان فالمعني فهي واحد لا يختلف لان كل قول قاله المرء غير حاك فقد شهد به وكل شهادة يشهد بها المرء فقد قالها فالقول شهادة والشهادة قول وهذه الشهادة هي غير الشهادة المحكوم بها قال الله تعالي: (ستكتب شهادتهم ويسءلون) وقال تعالي: (فان شهدوا فلا تشهد معهم) فهذه الشهادة هي القول المقول لا المءداة عند الحاكم بصفة ما وبالله تعالي التوفيق، فصح ان قذف الكافرة البريءة قول زور بلا خلاف من احد وقول الزور من الكباءر كما بين رسول الله صلي الله عليه وسلم * روينا من طريق مسلم نا قتيبة بن سعيد نا ليث بن سعد عن ابن الهادي عن سعد بن ابراهيم بن عبد الرحمن بن عوف عن حميد بن عبد الرحمن عن عبد الله بن عمرو بن العاص
 " ان رسول الله صلي الله عليه وسلم قال ان من اكبر الكباءر شتم الرجل والدية قالوا: يا رسول الله وكيف يشتم الرجل والديه؟ قال: نعم يسب ابا الرجل فيسب اباه ويسب امه فيسب امه " فصح ان السب المذكور من الكباءر وان لم يكن قذفا * قال ابو محمد رحمه الله: واما من رمي المرء بما فعل فليس قذفا لكنه غيبة ان كان غاءبا واذي ان كان حاضرا هذا ما لا خلاف فيه وبالله تعالي التوفيق *  مسالة  من المحصنات الواجب بقذفهن ما اوجبه الله تعالي في القران * قال ابو محمد: قال الله تعالي: (والذين يرمون المحصنات ثم لم ياتوا باربعة شهداء فاجلدوهم) الاية فكان ظاهر هذا ان المحصنات المذكورات هن النساء لان هذا اللفظ جاء بجمع المءنث فاعترض علينا اصحاب القياس ههنا وقالوا لنا ان النص انما ورد بجلد الحد من قذف المراة فمن اين لكم ان تجلدوا من قذف رجلا بالزنا؟ وما هذا الا قياس منكم وانتم تنكرون القياس * قال ابو محمد رحمه الله: فاجابهم اصحابنا ههنا باجوبة كل واحد منها مقنع كاف مبطل لاعتراضهم هذا الفاسد، والحمد لله رب العالمين، فاحد تلك الاجوبة ان من تقدم  من اصحابنا قال: جاء النص بالحد علي قذف النساء وصح الاجماع بحد من قذف رجلا والاجماع حق واصل من اصولنا التي نعتمد عليها وقد افترض الله تعالي علينا اتباع الاجماع والاجماع ليس الا عن توقيف من رسول الله صلي الله عليه وسلم، وقال بعض اصحابنا: بل نص الاية عام للرجال والنساء وانما اراد الله تعالي النفوس المحصنات قالوا وبرهان هذا القول ودليل صحته قول الله تعالي في مكان اخر: (والمحصنات من النساء) قالوا فلو كانت لفظة المحصنات لا تقع الا علي النساء لما كان لقول الله تعالي: (من النساء) معني وحاش لله من هذا فصح ان المحصنات يقع علي النساء والرجال فبين الله تعالي مراده هنالك بان قال من النساء واجمل الامر في اية القذف اجمالا قالوا (فان قال قاءل):
 ان قوله تعالي: (من النساء) كقوله تعالي: (وغرابيب سود) و(عشرة كاملة) (قلنا): لا يجوز ان يحمل كلام الله تعالي علي تكرار لا فاءدة اخري فيه الا بنص قران.
 او سنة.
 او اجماع وليس معكم شء من هذا في دعواكم ان قوله تعالي: (من النساء) تكرار لا فاءدة فيه * قال ابو محمد رحمه الله: وهذا جواب حسن، واما الاول فلا نقول به لانه حتي لو صح الاجماع علي وجوب الحد علي قاذف الرجل لما كان في الاية احتجاج وايجابنا الحد علي قاذف العبد وقاذف الكافرة لانه لا اجماع علي ذلك، واما جوابنا الذي نعتمد عليه ونقطع علي صحته وانه مراد الله تعالي بالبرهان الواضع فهو ان الله تعالي انما اراد بقوله: (والذين يرمون المحصنات ثم لم ياتوا باربعة شهداء) الفروج المحصنات، برهان ذلك ان الاربعة الشهود المذكورين لا يختلف اثنان من الامة في ان شهادتهم التي يكلفونها هي ان يشهدوا بانهم راوا فرجه في فرجها والجا خارجا والاجماع قد صح بان ما عدا هذه الشهادة ليست شهادة بزنا ولا يبرا بها القاذف من الحد فصح ان الرمي المذكور انما هو للفروج فقط، وايضا برهان اخر كما روينا من طريق مسلم نا اسحق بن ابراهيم  هو ابن راهويه  انا عبد الرزاق نا معمر عن ابن طاوس عن ابيه عن ابن عباس قال: ما رايت اشبه باللمم مما قال ابو هريرة فان النبي صلي الله عليه وسلم قال: " ان الله كتب علي ابن ادم حظه من الزنا ادرك ذلك لا محالة فزنا العينين النظر وزنا اللسان النطق والنفس تمني ووتشتهي والفرج يصدق ذلك او يكذبه " * قال ابو محمد رحمه الله: فلم يجعل رسول الله صلي الله عليه وسلم وسلم الزنا الا للفرج فقط وابطله عن جميع اعضاء الجسم اولها عن اخرها الا ان يصدقه فيها الفرج فصح يقينا ان النفس والقلب وجميع اعضاء الجسد حاش الفرج لا رمي فيها ولا قذف اصلا وانه لا رمي الا للفروج  فقط فاذ لا شك في هذا ولا مرية فالمراد من الله  تعالي: (والذين يرمون المحصنات)
 هي بلا شك الفروج التي لا يقع الرمي الا عليها لا يكون الزنا المرمي به الا منها * قال ابو محمد رحمه الله: (فان قال قاءل): ان المحصنات نعت ولا يفرد النعت عن ذكر المنعوت (قلنا): هذا خطا لانه دعوي بلا برهان لان القران واشعار العرب مملوء مما جاء في ذلك بخلاف هذا، قال الله تعالي: (والصاءمين والصاءمات) وقال الله تعالي: (ان المصدقين والمصدقات) ومثل هذا كثير مما ذكر الله تعالي النعت دون ذكر المنعوت، وقال الشاعر: * * ولا جاعلات العاج فوق المعاصم * فذكر النعت ولم يذكر المنعوت وما نعلم نحويا منع من هذا اصلا وانما ذكرنا هذا لءلا يموه مموه ثم ان هذا الاعتراض راجع عليهم لان من قولهم انه اراد النساء المحصنات فعلي كل حال قد حذف المنعوت واقتصر علي النعت ولا فرق بين اقتصاره تعالي علي ذكر المحصنات وحذف الفروج علي قولنا او حذف النساء علي قولهم فسقط اعتراضهم جملة، وقولنا نحن الذي حملنا عليه الاية اولي من دعواهم لان قولنا يشهد له النص والاجماع علي ما ذكرنا، واما دعواهم ان الله تعالي اراد بذلك النساء فدعوي عارية لا برهان عليها لا من نص ولا اجماع لانهم يخصون تاويلهم هذا ويسقطون الحد عن قاذف نساء كثيرة كالاماء والكوافر والصغار والمجانين فقد افسدوا دعواهم من قرب مع تعريها من البرهان وبالله تعالي التوفيق *  مسالة  قذف العبيد والاماء  قال ابو محمد: اختلف الناس فيمن قذف عبدا او امة بالزنا، فقالت طاءفة: لا حد عليه كما روي عن النخعي.
 والشعبي انهما قالا جميعا: لا يضرب قاذف ام ولد، وعن حماد بن ابي سليمان قال: اذا قال رجل لرجل امه ام ولد او نصرانية لست لابيك لم يضرب لان النفي وقع علي الام وعن ابن سيرين قال اراد عبيد الله بن زياد ان يضرب قاذف ام ولد فلم يتابعه علي ذلك احد، وقد روي عن عطاء.
 والحسن.
 والزهري لا حد علي قاذف ام ولد * قال علي: وممن لم ير الحد علي قاذف العبد والامة ابو حنيفة.
 ومالك والاوزاعي.
 وسفيان الثوري.
 وعثمان البتي.
 والحسن بن حي.
 والشافعي.
 واصحابهم، وقالت طاءفة: بايجاب الحد في ذلك نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن ايوب السختياني عن نافع مولي ابن عمر قال: ان اميرا من الامراء سال ابن عمر عن رجل قذف ام ولد لرجل فقال ابن عمر: يضرب الحد صاغرا، وعن الحسن البصري قال: الزوج يلاعن الامة، وان قذفها وهي امة جلد لانها امراته *

 قال ابو محمد: وبهذا يقول اصحابنا وهذا الاسناد عن ابن عمر من اصح اسناد يوجد في الحديث فلما اختلفوا كما ذكرنا وجب ان ننظر فيما احتجت به كل طاءفة لنعلم الحق من ذلك فنتبعه بعون الله تعالي ولطفه فنظرنا في قول من لم ير الحد علي قاذف الامة والعبد فلم نجد لهم شيءا يمكن ان يتعلقوا به الا ما روينا من طريق البخاري نا مسدد نا يحيي ابن سعيد القطان عن الفضيل بن غزوان عن ابن ابي نعم عن ابي هريرة قال: " سمعت ابا القاسم صلي الله عليه وسلم يقول: من قذف مملوكه وهو برء مما قال جلد يوم القيامة الا ان يكون كما قال " * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا سويد بن نصر انا عبد الله  هو ابن المبارك  عن الفضيل بن غزوان عن ابي نعم انه حدثه انه قال: قال ابو القاسم صلي الله عليه وسلم " من قذف مملوكه بريءا مما قال اقيم عليه الحد يوم القيامة الا ان يكون كما قال " وعن الحسن عن ابن عمر قال: من قذف مملوكه كان لله تعالي في ظهره حد يوم القيامة ان شاء اخذه وان شاء عفي عنه * قال ابو محمد: ولعلهم يدعون الاجماع او يقولون لا حرمة للعبد ولا للامة فكثيرا ما ياتون بمثل هذا فان ادعوا الاجماع اكذبهم ما روينا عن ابن عمر باصح طريق وما نعلم قولهم عن احد من الصحابة اصلا الا رواية لا نقف الان علي موضعها من اصولنا عن ابي بردة انه كانت له ابنة من حرة.
 وابنة من ام ولد فكانت ابنة الحرة تقذف ابنة ام الولد فاعتق امها وقال لابنة الحرة اقذفيها الان ان قدرت، وعن نفر من التابعين
 قد ذكرناهم خالفوهم في اكثر اقوالهم، فاما الرواية عن ابي بردة فلا متعلق لهم بها لانه ليس فيها انه لا حد فيها علي قاذفها ولعل حاكم وقته كان لا يري الحد علي قاذف ام الولد فبطل تعلقهم بهذا، واما قولهم لا حرمة للعبد ولا للامة فكلام سخيف والمءمن له حرمة عظيمة ورب عبد جلف خير من خليفة قرشي عند الله تعالي، قال الله تعالي: (يا ايها الناس انا خلقناكم من ذكر وانثي) الاية الي قوله: (ان اكرمكم عند الله اتقاكم) والناس كلهم في الولادة اولاد ادم وامراته ثم تفاضل الناس باخلاقهم واديانهم لا باعراقهم ولا بابدانهم وقد قال رسول الله صلي الله عليه وسلم: " ان دماءكم وامولكم واعراضكم وابشاركم عليكم حرام " فسوي عليه السلام بين حرمة العرض من الحر والعبد نصا ولاسيما الحنيفيون الموجبون القود علي الحر للعبد وعلي الحرة للامة فقد اثبتوا حرمتهما سواء * قال علي: اقوال لهم في هذه المساءل قد اختلف فيها فمن قال لامراته.
 زنيت في كفرك او قال: زنيت وانت امة * حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم ابن اصبغ نا ابن وضاح نا سحنون نا ابن وهب اخبرني يونس انه سال ابن شهاب  عن رجل قذف امراته فقال لها: زنيت وانت امة او نصرانية فقال ابن شهاب: ان لم يات علي ذلك بالبينة جلد الحد ثمانين، وبه يقول ابو حنيفة.
 وسفيان.
 ومالك.
 والاوزاعي.
 واصحابهم، وقال الشافعي.
 واصحابه: لا حد عليه، قال ابو حنيفة.
 واصحابه.
 وسفيان.
 والشافعي.
 واصحابه: فيمن قال زنيت وانت صغيرة او قال زنيت وانت مكرهة ان لا حد، وقال مالك: عليه الحد ايضا في قوله زنيت وانت مكرهة * قال ابو محمد: اما قول ابي حنيفة.
 واصحابه فظاهر التناقض لانهم يقولون لا حد علي قاذف الامة.
 والكافرة.
 والصغيرة، ثم فرقوا ههنا فحدوا من قال: زنيت وانت امة ولم يحدوا من قال: زنيت وانت صغيرة (فان قالوا): انما قذفها وهي حرة مسلمة (قيل): وكذلك انما قذفها وهي بالغ (فان قالوا): ان المكرهة ليست زانية
 وكذلك الصغيرة (قيل لهم): فالان وجب عليه الحد اذا صح كذبه بيقين *  مسالة  فيمن قذف صغيرا.
 او مجنونا.
 او مكرها.
 او مجبوبا.
 او رتقاء.
 او قرناء.
 او بكرا.
 او عنينا * قال ابو محمد: نا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب اخبرني يزيد بن عياض الليثي عن ابن هشام انه قال في صبية افتري عليها او افترت، قال: اذا قاربت الحيض او مسها الرجل جلد قاذفها الحد، وقال مالك: اذا بلغ مثلها ان يوطا جلد قاذفها الحد وكذلك يجلد قاذف المجنون، وقال ابو حنيفة.
 والشافعي.
 واصحابهما.
 والحسن بن حي: لا حد علي قاذف صغير.
 ولا مجنون * قال علي: قال الله تعالي: (والذين يرمون المحصنات) الاية، وقد قلنا: ان الاحصان في لغة العرب هو المنع وبه سمي الحصن حصنا يقال درع حصينة، وقد احصن فلان ماله اذا احرزه ومنع منه قال تعالي: (ولا يقاتلونكم جميعا الا في قري محصنة) والصغار محصونون بمنع الله تعالي لهم من الزنا وبمنع اهليهم وكذلك المجانين وكذلك المجبوب والرتقاء.
 والقرناء.
 والعنين، وقد يكون كل هءلاء محصنين بالعفة، واما البكر والمكره فمحصنان بالعفة فاذا كل هءلاء يدخلون في جملة المحصنات بمنع الفروج من الزنا فعلي قاذفهم الحد ولا سيما القاءلون ان الحرية احصان وكل حرة محصنة فان الصغيرة الحرة.
 والمجنونة.
 والرتقاء.
 وساءر من ذكرناهم محصنون واسقاط الحد عن قاذفهم خطا محض لااشكال فيه فما علمنا لهم حجة اكثر من ان قالوا: ان من قذف من ذكرنا فقد تيقنا كذبه (فقلنا لهم) صدقتم والان حقا وجب الحد علي القاذف اذ قد صح كذبه، وبالله تعالي التوفيق *

 قال ابو محمد: وهذا مكان عظمت فيه غفلة من اغفله لان القذف لا يخلو من احد اوجه ثلاثة لا رابع لها، اما ان يكون صادقا، وقد صح صدقه فلا خلاف في انه
 لا حد عليه، او يكون ممكنا صدقه وممكنا كذبه فهذا عليه الحد بلا خلاف لامكان كذبه فقط ولو صح صدقه لما حد او يكون كاذبا، قد صح كذبه فالان حقا طابت النفس علي وجوب الحد عليه بيقين اذ المشكوك في صدقه او كذبه لابد له من احدهما ضرورة فلو كان صادقا لما صح عليه حد اصلا فصح يقينا اذ قد سقط الحد عن الصادق انه باق علي الكذب اذ ليس الا صادقا او كاذبا، وهذا في غاية البيان والحمد لله رب العالمين *   مسالة  كافر قذف مسلما او كافرا * قال ابو محمد: قد ذكرنا وجوب الحد علي من قذف كافرا فاذا قذف الكافر مسلما فقد ذكرنا فيما سلف من كتابنا هذا وجوب الحكم علي الكفار بحكم الاسلام لقول الله تعالي: (وان احكم بينهم بما انزل الله) وبقوله تعالي: (وقاتلوهم حتي لا تكون فتنة ويكون الدين كله لله) وقد ذكرنا وجوب قتل من سب مسلما من الكفار لنقضهم العهد وفسخهم الذمة لقول الله تعالي: (حتي يعطوا الجزية عن يد وهم صاغرون) فافترض الله تعالي اصغارهم فاذا خرجوا عن الصغار فلا ذمة لهم واذا لم تكن لهم ذمة فقتلهم وسبيهم.
 واموالهم حلال واذا سبوا مسلما فقد خرجوا عن الصغار واصغروا المسلم فقد برءت الذمة ممن فعل ذلك منهم ولا ذمة له * حدثنا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي ابن معاوية نا وكيع نا اسحق بن خالد قال: سالت الشعبي عن يهودية افترت علي مسلم قال تضرب الحد، وبه الي وكيع حدثنا سفيان الثوري عن طارق بن عبد الرحمن قال شهدت الشعبي ضرب نصرانيا قذف مسلما فجلده ثمانين * قال ابو محمد: اما الحد فواجب بلا شك لانه حكم الله تعالي علي كل قاذف والقتل واجب كما ذكرنا لنقض الذمة سواء كان رجلا او امراة لابد من قتلهما الا ان يسلما فيتركا عن القتل لا عن الحد (فان قال قاءل).
 هلا اوقفتم المراة ولم تقتلوها لنهي رسول الله صلي الله عليه وسلم عن قتل النساء؟ ولانها اذا نقضت ذمتها بسبب المسلم فقد عادت
 حربية واذا عادت حربية فلا ذمة لها فليس عليها الا الاسترقاق (قلنا): وبالله تعالي التوفيق، ان حكم الحربي قبل التذمم غير حكمه بعد نقضهم الذمة لان حكمهم قبل التذمم المقاتلة فاذ قدرنا عليهم فاما المن.
 واما الفداء.
 واما القتل.
 واما الابقاء علي الذمة هذا في الرجال وكذلك في النساء حاش القتل، واما بعد نقض الذمة  فليس الا القتل او الاسلام فقط لقول الله تعالي: (وان نكثوا ايمانهم من بعد عهدهم وطعنوا في دينكم فقاتلوا اءمة الكفر) فافترض الله تعالي قتالهم بعد نكث ايمانهم من بعد عهدهم حتي ينتهوا ولا يجوز ان يخص الانتهاء ههنا عن بعض ما هم عليه دون جميع ما هم عليه اذ لا دليل يوجب ذلك ونحن علي يقين اننا اذا انتهوا عن الكفر فقد حرمت دماءهم ولا نص معنا ولا اجماع علي انهم ان انتهوا عن بعض ما هم عليه دون بعض عادوا الي حكم الاستبقاء وقد تقصينا هذا في كتاب الجهاد في مواضع من ديواننا، وحكم المراة في ذلك حكمها اذا اتت بعد الذمة بشء يبيح الدم من زنا بعد احصان.
 او قتل نفس.
 او غير ذلك واما اذا قذف الكافر كافرا فليس الا الحد فقط علي عموم امر الله تعالي فيمن قذف محصنة بنص القران * قال ابو محمد رحمه الله: والعجب ممن يري انه لا حد علي كافر اذا زني بمسلمة ولا علي كافرة اذا زني بها مسلم ولا يري الحد علي كافر في شرب الخمر ثم يري الحد علي الكافر اذا قذف مسلما او مسلمة فليت شعري ما الذي فرق بين احكام هذه الحدود عندهم (فان قالوا): ان الحد في القذف حق للمسلم (قلنا لهم): وقولوا ايضا ان حد الكافر اذا زني بمسلمة حق لابي تلك المسلمة ولزوجها وامها ولا فرق، والعجب ايضا ممن قطع يد الكافر اذا سرق من كافر ثم لا يحده له اذا قذفه وهذه عجاءب لا نظير لها خالفوا فيها نصوص القران وتركوا القياس الذي اليه يدعون.
 وبه يحتجون اذ فرقوا بين هذه الاحكام ولم يقيسوا بعضها علي بعض بغير دليل في كل ذلك وبالله تعالي التوفيق *
   مسالة  فيمن قال لامراة لم يجدك زوجك عذراء * قال ابو محمد رحمه الله: اختلف الناس في هذا، فقالت طاءفة: لا حد في ذلك وليس قذفا، وكذلك لو قال رجل لامراة تزوجها فلا يلاعن بهذا، وقالت طاءفة: هو قذف ويحد ويلاعن الزوج * قال ابو محمد رحمه الله: احتج من راه قذفا بما نا احمد بن محمد الطلمنكي قال: نا ابن مفرج نا محمد بن ايوب نا احمد بن عمرو بن عبد الخالق البزار نا محمد بن منصور الطوسي نا يعقوب بن ابراهيم بن سعد نا ابي عن ابن اسحق قال: وذكر طلحة عن سعيد بن جبير عن ابن عباس قال: تزوج رجل من الانصار امراة من بني العجلان فبات عندها ليلة فلما اصبح لم يجدها عذراء فرفع شانها الي النبي صلي الله عليه وسلم فدعي الجارية فقالت: بل كنت عذراء فامر بهما فتلاعنا واعطاها المهر قال البزار: لا نعلمه روي الا من هذا الطريق *

 قال علي: وهذا ليس بشء لوجهين، احدهما ان ابن اسحق لم يصح سماعه لذلك من طلحة فهو منقطع، والثاني ان طلحة هذا لم ينسبه وهو والله اعلم طلحة بن عمرو المكي فهو الذي يروي عن اصحاب ابن عباس وهو مشهور بالكذب والا فهو علي كل حال مجهول فسقط التعلق بهذا الخبر * قال ابو محمد رحمه الله: وذهاب العذرة يكون بغير الزنا او بغير وطء كوقعة او غير ذلك فلما لم يكن ذهاب العذرة زنا لم يكن الرمي به رميا ولا قذفا فاذ ليس رميا ولا قذفا فلا حد فيه ولا لعان لان الله تعالي انما جعل الحد واللعان بالزنا لا بما سواه، وبالله تعالي التوفيق، وهو قول اصحابنا وغيرهم، وبهذا نقول *  مسالة  التعريض هل فيه حد او تحليف ام لا حد فيه ولا تحليف؟ * قال ابو محمد رحمه الله: اختلف الناس في التعريض افيه حد ام لا؟ فقالت
 طاءفة: فيه حد القذف كاملا كما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن الزهري عن سالم بن عبد الله بن عمر عن ابيه عبد الله بن عمر قال: ان عمر كان يجلد في التعريض بالفاحشة، وبه الي عبد الرزاق نا ابن جريج اخبرني ابن ابي مليكة عن صفوان.
 وايوب عن عمر بن الخطاب انه حد في التعريض قال ابن ابي مليكة: والذي حد عمر في التعريض  هو عكرمة بن عامر بن هشام ابن عبد مناف بن عبد الدار  هجا وهب بن زمعة بن الاسود بن المطلب بن اسد بن عبد العزي فعرض به في هجاءه * حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب سمعت معاوية بن مصالح يحدث عن كثير بن الحرث عن القاسم مولي عبد الرحمن ان عمر بن الخطاب جلد في التعريض وقال: ان حمي الله لا ترعي حواشيه * وبه الي ابن وهب اخبرني مالك.
 وعمرو بن الحرث، قال مالك عن ابي الرجال عن امه عمرة بنت عبد الرحمن، وقال عمرو عن يحيي بن سعيد الانصاري قالت عمرة.
 ويحيي ان رجلين استبا في زمان عمر بن الخطاب فقال احدهما: ما ابي بزان ولا امي بزانية فاستفتي في ذلك عمر بن الخطاب فقال قاءل مدح اباه وامه وقال اخرون قد كان لابيه وامه مدح سوي هذا نري ان يجلد الحد فجلده عمر ثمانين * وبه الي ابن وهب اخبرني رجل من اهل العلم ان مسلمة ابن مخلد جلد الحد في التعريض، وبه الي ابن وهب اخبرني سعيد بن ايوب عن عطاء عن عمرو بن دينار عن ابي صالح الغفاري ان عمرو بن العاص جلد رجلا الحد كاملا في  ان قال لاخر يا ابن ذات الداية * حدثنا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا غير واحد عن جابر عن طريف العكلي عن علي بن ابي طالب قال: من عرض عرضنا له بالسوط، وبه الي وكيع نا سفيان الثوري عن عاصم عن ابن سيرين عن سمرة قال من عرض عرضنا له *
 حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق نا ابن جريج قال: سمعت محمد بن هشام يقول: قال رجل في امارة عمر بن عبد العزيز لرجل الك تسري علي جاراتك قال: والله ما اردت الا نخلات كان يسرقهن فحده عمر بن عبد العزيز * قال ابو محمد: وبايجاب الحد في التعرض يقول مالك وهو قول ربيعة ايضا، وقال اخرون لا حد في التعريض كما نا محمد بن سعيد بن نبات نا عبد الله بن نصر بن قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا سفيان الثوري عن ابي الرجال عن امه عمرة بنت عبد الرحمن قالت: نازع رجل رجلا فقال: اما ابي فليس بزان ولا امي بزانية فرفع الي عمر فشاور اصحاب رسول الله صلي الله عليه وسلم فقالوا: ما نري عليه حدا مدح اباه وامه فضربه عمر، وبه الي وكيع نا المسعودي عن القاسم بن عبد الرحمن قال: قال عبد الله بن معسود: لا حد الا في اثنين ان يقذف محصنة او ينفي رجلا من ابيه * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابراهيم بن محمد عن اسحاق بن عبد الله عن مكحول ان معاذ بن جبل.
 وعبد الله بن عمرو بن العاص قالا جميعا: ليس يحد الا في الكلمة التي لها مصرف وليس لها الا وجه واحد * وبه الي ابراهيم بن محمد عن صاحب له عن الضحاك بن مزاحم عن علي بن ابي طالب قال: اذا بلغ الحد لعل وعسي فالحد معطل * حدثنا عبد الله بن ربيع نا عبد الله ابن محمد بن عثمان نا احمد بن خالد نا علي بن عبد العزيز نا الحجاج بن المنهال نا حماد بن سلمة عن يونس بن عبيد عن حميد بن هلال ان رجلا شاتم رجلا فقال يابن شامة الوذر  يعني ذكور الرجال  فقال له عثمان اشهد عليه اشهد عليه فرفعه الي عمر فجعل الرجل يقع في عثمان فينال منه فقال عمر: اعرض عن ذكر عثمان فجعل لا ينزع فعلاه عمر بالدرة وقال اعرض عن ذكر عثمان وسال عن ام الرجل فاذا هي قد تزوجت ازواجا فدرا عنه الحد * حدثنا محمد بن سعيد بن نبات نا احمد بن عون الله نا قاسم بن اصبغ نا محمد بن عبد السلام الخشني نا محمد بن بشار  بندار  نا محمد بن جعفر
  غندر  نا شعبة عن ابي ميمونة سلمة بن المحبق نا ابن ابي ميمونة نا سلمة بن المحبق قال: قدمت المدينة فعقلت راحلتي فجاء انسان فاطلقها فجءت  فلهزت () في صدره وقلت يا ناءك امه فذهب بي الي ابي هريرة وامراته قاعدة فقالت لي امراته لو كنت عرضت ولكنك اقمحت قال فجلدني ابو هريرة الحد ثمانين فقلت لعمرك اني يوم اجلد قاءما ثمانين سوطا انني لصبور * حدثنا محمد بن سعيد بن نبات نا عبد الله بن احمد نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية ناوكيع نا اسراءيل عن جابر عن عامر الشعبي في رجل قال لرجل انك تقود الرجال الي امراتك قال التعزير وليس يحد، وبه الي وكيع نا سفيان عن المغيرة عن ابراهيم النخعي قال: في التعريض عقوبة، وبه الي وكيع نا سفيان الثوري عن اسماعيل بن ابي خالد عن عامر الشعبي قال: لو قال له ادعاك عشرة لم يضرب * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق نا ابن جريج قال: قلت لعطاء التعريض قال ليس فيه حد قال عطاء.
 وعمرو بن دينار فيه نكال قال ابن جريج قلت له يستخلف ما اراد كذا وكذا قال: لا قال ابن جريج: وقلت لعطاء رجل قال لاخيه ابن ابيه لست باخي قال: لا يحد، وبه الي عبد الرزاق عن معمر عن الزهري في رجل قال لاخر يا ابن العبد او ايها العبد قال انما عنيت به عبد الله قال يستحلف بالله ما اراد الا ذلك ولا حد عليه فان نكل جلد، قال الزهري: فلو قال لاخر يا ابن الحاءك يا ابن الخياط يا ابن الاسكاف يعيره ببعض الاعمال قال يستحلف بالله ما اراد نفيه وما اراد الا عمل ابيه فان حلف ترك وان نكل حد، وبه الي عبد الرزاق عن سفيان الثوري عن اسماعيل بن ابي خالد انه سءل عن رجل قال لاخر انك لدعي قال ليس عليه حد، ولو قال له ادعاك ستة لم يكن عليه حد، قال قتادة: لو قال رجل لرجل اني اراك زانيا عزر ولم يحد والتعريض كله يعزر فيه في قول قتادة، وعن سعيد بن المسيب قال انما جعل الحد علي من نصب الحد نصبا *
 قال ابو محمد رحمه الله: وبان لا حد في التعريض يقول سفيان الثوري.
 وابن شبرمة.
 والحسن بن حي.
 وابو حنيفة.
 والشافعي.
 وابو سليمان.
 واصحابهم فلما اختلفوا كما ذكرنا نظرنا فوجدنا من راي الحد فيه يقول هذا فعل عمر بحضرة الصحابة رضي الله عنهم * قال علي: وهذا لا متعلق لهم به لانه قد صح الخلاف في ذلك عن الصحابة رضي الله عنهم نصا كما ذكرنا ايضا من طريق وكيع، نعم وعن عمر رضي الله عنه ادرءوا الحد عمن قال لاخر يا ابن شامة الوذر، واما علي بن ابي طالب.
 وسمرة فانه جاء عنهما من عرض عرضنا له وليس في هذا بيان انهما ارادا الحد فبطل تعلقهم بفعل عمر.

 وعلي.
 وسمرة رضي الله عنهم جملة فنظرنا هل لهم حجة غير هذا؟ فوجدناهم يذكرون قول الله تعالي: (يا ايها الذين امنوا لا تقولوا راعنا) الاية قالوا وكان الكفار يقولون لرسول الله صلي الله عليه وسلم راعنا يريدون من الرعونة وهذا تعريض فنهي عن التعريض * قال ابو محمد: وهذا حجة عليهم لا لهم لوجوه، اولها اننا لم نخالفهم في ان التعريض لا يجوز فيحتجوا بهذا وانما خالفناهم في هل فيه حد ام لا؟ وليس في هذه الاية لو صح استدلالهم بها الا النهي عن التعريض فقط وليس فيها ايجاب حد فيه اصلا فظهر تمويههم بالاية، والثاني ان الله تعالي لم يحد الذين عرضوا بهذا التعريض فكيف يحتجون بها في ايجاب الحد، والثالث ان الله تعالي انما نهي عن قول راعنا من لا يظن به تعريض اصلا فهم الصحابة رضي الله عنهم فصح يقينا انه لم ينه عزوجل عن لفظة راعنا من اجل التعريض بل كما شاء تعالي لا لعلة اصلا والحد في ذلك ساقط لا ينسند اصلا فبطل تعلقهم بالاية جملة وصح انها حجة عليهم وبالله تعالي التوفيق * قال ابو محمد: فلما بطل قول من راي الحد في التعريض وجب ان ننظر في قول
 الطاءفة الاخري فوجدناهم يذكرون قول الله تعالي: (ولا جناح عليكم فيما عرضتم به من خطبة النساء او اكننتم في انفسكم) الي قوله تعالي: (حتي يبلغ الكتاب اجله) ففرق عزوجل بين حكم التصريح وبين حكم التعريض تفريقا لا يختل علي ذي حس سليم، واذا كانا شيءين مختلفين ليس لاحدهما حكم الاخر فلا يجوز البتة ان يجعل في احدهما ما جعل في الاخر بغير نص ولا اجماع، وذكروا ما روينا من طريق مسلم ني ابو الطاهر وحرملة واللفظ لحرملة قالا جميعا: نا ابن وهب اخبرني يونس عن ابن شهاب عن ابي سلمة ابن عبد الرحمن عن ابي هريرة " ان اعرابيا اتي الي رسول الله صلي الله عليه وسلم فقال يا رسول الله ان امراتي ولدت غلاما اسود وانا انكره فقال له النبي صلي الله عليه وسلم وسلم هل لك من ابل؟ قال نعم قال ما الوانها قال حمر قال فهل فيها من اورق؟ قال: نعم قال رسول الله صلي الله عليه وسلم فاني هو فقال لعله يارسول الله نزعه عرق له فقال له النبي صلي الله عليه وسلم وهذا لعله نزعه عرق له " * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن الزهري قال ني سعيد بن المسيب عن ابي هريرة قال: " جاء رجل الي النبي صلي الله عليه وسلم فقال ولدت امراتي غلاما اسود وهو حينءذ يعرض بان ينفيه فقال له النبي صلي الله عليه وسلم الك ابل؟ قال: نعم قال ما الوانها؟ قال حمر قال افيها اورق؟ قال نعم فيها ذود ورق قال مم ذاك تري؟ قال لا ادري لعله ان يكون نزعه عرق قال رسول الله صلي الله عليه وسلم وهذا لعله ان يكون نزعه عرق " ولم يرخص له في الانتفاء منه * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب  اخبرني اسحق بن ابراهيم  هو ابن راهويه  اخبرني النضر بن شميل نا حماد بن سلمة انا هارون بن زياد عن عبد الله بن عبيد الله بن عمير عن ابن عباس " ان رجلا قال يا رسول الله ان تحتي امراة جميلة لا ترد يد لامس قال طلقها قال اني لا اصبر عنها قال فامسكها " * قال ابو محمد رحمه الله: فهذه الاحاديث كلها في غاية الصحة موجبة انه لا شء في التعريض اصلا لان الاعرابي الذي ذكر ان امراته ولدت ولدا اسود وعرض
 بنفيه وكان من بني فزارة ذكر ذلك الزهري فلم ير رسول الله صلي الله عليه وسلم في ذلك حدا ولا لعانا وكذلك الذي قال ان امراتي لا ترد يد لامس فلم ير رسول الله صلي الله عليه وسلم في ذلك حدا ولا لعانا، وقد اوجب عليه السلام الحد واللعان علي من صرح، وكذلك قوله عليه السلام: " لولا ما سبق من كتاب الله لكان لي ولها شان " وقال عليه السلام: " لو كنت راجما احدا بغير بينة لرجمت هذه " تعريض صحيح وانكر للمنكر دون تصريح لكن بظن لا يحكم به ولا يقطع به، وكذلك قول ابن عباس: تلك امراة كانت تظهر السوء في الاسلام تعريض صحيح * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب نا اسحاق بن ابراهيم نا سفيان بن عيينة عن الزهري عن عاءشة قالت: " اختصم سعد بن ابي وقاص.
 وعبد بن زمعة في ابن زمعة فقال سعد: اوصاني اخي عتبة اذا قدمت مكة فانظر ابن امة زمعة فهو ابني.
 وقال عبد هو ابن امة ابي ولد علي فراش ابي فراي رسول الله صلي الله عليه وسلم شبها بينا بعتبة فقال رسول الله صلي الله عليه وسلم: الولد للفراش واحتجبي منه يا سودة " فهذا رسول الله صلي الله عليه وسلم قد اشار اشارة لم يقطع بها بل خاف وظن انه من ماء عتبة ولم ير حدا علي سعد بن ابي وقاص اذ نسب ولد زمعة الي اخيه، فهذه اثار رواها من الصحابة رضي الله عنهم جماعة عاءشة.
 وابو هريرة.
 وانس.
 وابن عباس فصارت في حد التواتر موجبة للعلم مبطلة قول من راي ان في التعريض حدا بل صح بها ان من عرض لغير سبب لكن لشكوي علي حديث الاعرابي او تورعا علي حديث ابن وليدة  زمعة  او انكارا للمنكر علي حديث ابن عباس.
 وعلي حديث انس فلا شء في ذلك اصلا لا اثم ولا كراهية ولا انكار لان رسول الله صلي الله عليه وسلم قال ذلك، وقيل بحضرته فلم ينكروه * (واما طريق الاجماع) فان الامة كلها لا تختلف والمالكيون في جملتهم علي ان من اظهر السوء من رجل.
 او امراة كانفراد الاجنبيين ودخول الرجل منزل المراة تسترا فواجب علي المسلمين انكار ذلك ورفعه الي الامام، وهذا بيقين تعريض والا فاي
 شء ينكرون من ذلك، والعجب كل العجب انهم يرون الحد في التعريض وهم  يصرحون بالقذف ولا يرون في ذلك شيءا وذلك اقامتهم حد الزنا علي الحبلي وما ثبت قط عليها زنا فهم يدعون انهم يسقطون الحدود بالشبهات وهذان مكانان اقاموا الحد بالشبهات فيهما.
 وهما حد القذف علي من عرض ولم يصرح.
 وحد الزنا علي من حملت ولا زوج لها ولا سيد، وبالله تعالي التوفيق * قال ابو محمد: وصح ان لا حد في التعريض اصلا فان قال المعرض به: احلفه ما اراد قذفي لم يكن له ذلك ولا يحلف ههنا اصلا لانه لم يقذفه وانما ادعي عليه انه اراد قذفه فقط، ولا خلاف بين احد من الامة كلها في ان من ادعي علي اخر انه اضمر قذفه ولم يقذفه فانه لا تحليف في ذلك لصحة الاجماع علي ان من اضمر قذفا ولم ينطق به فانه لا حد في ذلك اصلا حتي اقر بذلك امرء علي نفسه وهذا المعرض فلم ينطق بالقذف ولا شء في ذلك اصلا.
 واما من ادعي عليه انه صرح بالقذف وهو منكر فلا تحليف في ذلك ايضا لان الحد في ذلك من حدود الله تعالي وحقوقه لا من حقوق الادميين فانما يحلف بالله ما اذيتك.
 ولا شتمتك ويبرا، وبالله تعالي التوفيق *   مسالة  من قذف انسانا قد ثبت عليه الزنا وحد فيه او لم يحد * قال ابو محمد: قد جاءت في هذا اثار كما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن الزهري عن ابن المسيب قال: اذا جلد الرجل في حد ثم اونس منه تركه فعيره به انسان نكل، وبه الي عبد الرزاق نا ابن جريج عن عطاء قال: علي من اشاع الفاحشة نكل وان صدق، وعن الزهري قال: لو ان رجلا اصاب حدا في الشرك ثم اسلم فعيره به رجل في الاسلام نكل، وعن يحيي
 ابن سعيد الانصاري انه قال: دخل رجلان علي عمر بن عبد العزيز فقال احدهما: انه ولد زنا فطاطا الاخر راسه فقال عمر: ما يقول هذا؟ فسكت واعترف فامر عمر بالقاءل ذلك له فلم يزل يجا قفاه حتي خرج من الدار، وعن ابن شهاب انه قال: لا نري علي من قذف رجلا جلد الحد بعد ان يحلف القاذف بالله ما اردت حين قلت له ما قلت الا الامر الذي جلد فيه الحد، وقال ابن شهاب في رجل قال لاخر يا ابن الزانية وكانت جدته قد زنت انه يحلف بالله الذي لا اله الا هو انه لم يرد الا جدته التي احدثت ثم لا يكون عليه شء، وعن سفيان الثوري انه قال في الرجل يجلد الحد فيقول له رجل يا زاني قال: يستجب بالدرة ويعزر ومنا من يقول اذا اقيم الحد جلد من  قذفه وممن قال بحلده ابن ابي ليلي * قال ابو محمد.
 والذي نقول به، وبالله تعالي التوفيق ان الله تعالي قال: (ان الذين يحبون ان تشيع الفاحشة في الذين امنوا لهم عذاب اليم) وقد ذكرنا فيما سلف من كتابنا قول رسول الله صلي الله عليه وسلم في الذي تزني امته: " فليجلدها ولا يثرب " فصح ان التثريب علي الزاني حرام.
 وان اشاعة الفاحشة حرام ولا يحل بلا خلاف اذي المسلم بغير ما امر الله تعالي ان يءذي به فصح من هذا ان من سب مسلما بزنا كان منه.
 او بسرقة كانت منه او معصية كانت منه وكان ذلك علي سبيل الاذي لا علي سبيل الوعظ والتذكير الجميل سرا لزمه الادب لانه منكر، وقد قال رسول الله صلي الله عليه وسلم: " من راي منكم منكرا فليغيره بيده ان استطاع فان لم يستطع فلبسانه " فهذا الحديث بيان ما قدمنا نصا لان فيه اباح تغيير المنكرات باليد واللسان فمن بكت اخر بما فعل علي سبيل الامر بالمعروف والنهي عن المنكر فهو محسن.
 ومن ذكره علي غير هذا الوجه فقد اتي منكرا ففرض علي الناس تغييره لان رسول الله صلي الله عليه وسلم وسلم قال: " ان دماءكم واموالكم واعراضكم وابشاركم عليكم حرام " فصح ان عرض كل احد حرام الا حيث اباحه النص او الاجماع وسواء عرض
 العاصي وغيره وبالله تعالي التوفيق * قال ابو محمد: فان قذف انسان انسانا قد زني بزنا غير الذي ثبت عليه وبين ذلك وصرح فعلي القاذف الحد سواء حد المقذوف في الزنا الذي صح عليه او لم يحد لانه محصن عن كل زنا لم يثبت عليه، وقد قلنا ان الاحصان هو المنع فمن منع بشء او امتنع منه فهو محصن عنه فاذ هو محصن فعليه الحد بنص القران *   مسالة  فيمن انتفي من ابيه  قال علي: نا محمد بن سعيد ابن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا المسعودي عن القاسم بن عبد الرحمن ان ابا بكر الصديق رضي الله عنه اتي برجل انتفي عن ابيه فقال: ابو بكر اضرب الراس فان الشيطان في الراس * قال ابو محمد: يلزم القاءلين بايجاب الحد في النفي عن الاب او عن النسب ان يقيم حد القذف كاملا علي من انتفي من ابيه او علي من نفي ولده من نفسه والا فقد تناقضوا، واما نحن فقد بينا قبل ان ههنا التعزير فقط ولا حد في ذلك، وبالله تعالي التوفيق *  مسالة من قال لاخر انت ابن فلان ونسبه الي عمه.
 او خاله.
 او زوج امه او اجنبي *

 قال ابو محمد: قال قوم: في كل هذا الحد وهو خطا ولكن الحكم في هذا ان ما كان من ذلك علي سبيل الحق والخير فهو فعل حسن وقول حسن، واما ما كان من ذلك مشاتمة.
 او اذي.
 او تعريضا ففيه التعزير فقط ولا حد في ذلك، برهان ما ذكرنا قول الله تعالي حاكيا عن ولد يعقوب عليه السلام اذ قالوا: (نعبد الهك واله اباءك ابراهيم واسماعيل واسحاق) فجعلوا عمه اسماعيل عليه السلام ابا له ولم ينكر الله تعالي ذلك ولا يعقوب عليه السلام وهو نبي الله تعالي، وقال تعالي:
 (ملة ابيكم ابراهيم) وقد علمنا يقينا ان في المسلمين خلاءق ليس لابراهيم عليه السلام في ولادتهم نسب، واما زوج الام فان احمد بن محمد بن عبد الله الطلمنكي نا قال: نا ابن مفرج نا محمد بن ايوب الصموت نا احمد بن عمرو بن عبد الخالق البزار نا ابراهيم بن سعيد الجوهري نا ابو اسامة نا محمد بن عمرو عن ابي سلمة بن عبد الرحمن ابن عوف ان ابا طلحة صنع طعاما للنبي صلي الله عليه وسلم فارسل انس بن مالك فجاء حتي دخل المسجد  ورسول الله صلي الله عليه وسلم في اصحابه  فقال: " دعانا ابوك؟ فقال: نعم قال: قوموا " قال: انس فاتيت ابا طلحة فذكر الحديث * حدثنا حمام نا ابي مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج عن هشام بن عروة بن الزبير عن ابيه قال: " كانت ام عمير بنت سعد عند الجلاس بن سويد فقال الجلاس بن سويد في غزوة تبوك، ان كان ما يقول محمد حقا لنحن اشر من الحمير فسمعها عمير فقال: والله اني لاخشي ان لم ارفعها الي النبي صلي الله عليه وسلم ان ينزل القران فيه وان اخلط بخطبته ولنعم الاب هو لي فاخبر النبي صلي الله عليه وسلم فدعا النبي عليه السلام الجلاس فعرفه فتحالفا فجاء الوحي الي النبي صلي الله عليه وسلم فسكتوا فلم يتحرك احد  كذلك كانوا يفعلون لا يتحركون اذا نزل الوحي  فرفع عن النبي صلي الله عليه وسلم فقال: (يحلفون بالله ما قالوا ولقد قالوا كلمة الكفر) الي قوله: (فان يتوبوا يك خيرا لهم) فقال الجلاس استتب لي ربي يا رسول الله فاني اتوب الي الله واشهد له بصدق قال عروة فما زال عمير منها بعلياء حتي مات " * قال ابو محمد: فهذا رسول الله صلي الله عليه وسلم يقول: عن الربيب اب وينسب الي الرجل ابن امراته فيقول له ابوك وهذا انس.
 وعمير بن سعد من اهل اللغة والديانة يقولان بذلك * قال ابو محمد: وهذا قول ابي حنيفة.
 وابي سليمان  واصحابنا.
 وبه ناخذ *   مسالة  فيمن قال لاخر يا لوطي.
 او يا مخنث  قال علي:

 انا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا ابو هلال عن قتادة ان رجلا قال لابي الاسود الدءلي يا لوطي قال يرحم الله لوطا، وبه الي ابي هلال عن عكرمة في رجل قال لاخر يا لوطي قال عكرمة ليس عليه حد، وعن الزهري.
 وقتادة انهما قالا جميعا في رجل قال لرجل يا لوطي انه لا يحد، وبه يقول ابو حنيفة.
 وابو سليمان.
 واصحابنا: وقال اخرون: لا حد في ذلك الا ان يبين كما روينا بالسند المذكور الي عبد الرزاق اخبرني ابن جريج قال قلت لعطاء في رجل قال لاخر يا لوطي: قال: لا حد عليه حتي يقول: انك لتصنع بفلان، وبه الي عبد الرزاق عن سفيان الثوري عن حماد بن ابي سليمان عن ابراهيم النخعي انه قال في رجل قال لاخر يا لوطي: قال: نيته يسال عما اراد بذلك، وقالت طاءفة: عليه الحد كما نا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا سعيد بن حسان عن عبد الحميد بن جبير بن شيبة ان رجلا قال لرجل يا لوطي فرفع الي عمر بن عبد العزيز فجعل عمر يقول يا لوطي يا محمدي فكانه لم ير عليه الحد وضربه بضعة عشر سوطا ثم ارسل اليه من الغد فاكمل له الحد، وبه الي وكيع نا ابو هلال عن الحسن البصري في الرجل يقول للرجل يا لوطي قال: عليه الحد، وبه الي وكيع عن الحسن ابن صالح بن حي عن منصور عن ابراهيم النخعي في فعل قوم لوط قال.
 يجلد من فعله ومن رمي به، وبه الي وكيع عن اسراءيل عن جابر عن عامر الشعبي في الرجل يقول للرجل يا لوطي قال: يجلد * قال ابو محمد: قول ابراهيم.
 والشعبي يجلد ليس فيه بيان انهما ارادا الحد وقد يمكن ان يريدا جلد تعزير وبايجاب الحد علي من رمي به يقول مالك.
 والشافعي وهو الخارج علي قول ابي يوسف.
 ومحمد بن الحسن *
 قال ابو محمد: فلما اختلفوا وجب ان ننظر في ذلك فوجدنا هذه المسالة  يعني من رمي اخر بانه ينكح الرجال.
 او بانه ينكحه الرجال  انما هي معلقة بالواجب في قوم لوط فان كان زنا فالواجب في الرمي به حد القذف بالزنا وان كان ليس زنا فلا يجب في الرمي به حد القذف بالزنا وسنستقصي الكلام في هذه المسالة ان شاء الله تعالي في باب مفرد له اثر كلامنا في حد السرقة.
 وحد الخمر.
 ولا حول ولا قوة الا بالله * وهو ليس عندنا زنا فلا حد في الرمي به، واما ابو يوسف.
 ومحمد بن الحسن فهو عندهما زنا او مقيس علي الزنا فالحد عندهما في القذف به، واما مالك.
 والاشهر من اقوال الشافعي  فهو عندهم خارج من حكم الزنا لانهما يريان فيه الرجم احصن او لم يحصن فاذ هو عندهم ليس زنا، وانما حكمه المحاربة او الردة لانه لا يراعي فيه احصان من غيره فكان الواجب علي قولهما ان لا يكون فيه حد الزنا وهو مما تناقضوا فيه افحش تناقض فلم يتبعوا فيه نصا ولا قياسا (فان قالوا): ان الرمي بذلك حرام (قلنا): نعم واثم ولكن ليس كل حرام.
 واثم تجب فيه الحدود: فالغصب حرام ولا حد فيه.
 واكل الخنزير حرام ولا حد فيه، والرمي بالكفر حرام ولا حد فيه، واما من قال لاخر يا مخنث فان القاضي حمام بن احمد قال: نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابراهيم بن محمد بن ابي يحيي عن داود بن الحصين عن ابي سفيان قال: قال رسول الله صلي الله عليه وسلم: " من قال لرجل من الانصار يا يهودي فاضربوه عشرين ومن قال لرجل يا مخنث فاضربوه عشرين " * قال ابو محمد رحمه الله: وهذا ليس بشء وذلك لانه مرسل والمرسل لا تقوم به حجة، ثم هو ايضا من رواية ابراهيم بن ابي يحيي وهو في غاية السقوط، ولو كان هذا صحيحا عن رسول الله صلي الله عليه وسلم لاوجبناه حدا ولكنه لا يصح فلا يجب القول به ولا حد في شء مما ذكروا وانما هو التعزير فقط للاذي لانه منكر وتغيير المنكر واجب
 لامر رسول الله صلي الله عليه وسلم، وبالله تعالي التوفيق *  مسالة  من رمي انسانا ببهيمة * قال ابو محمد رحمه الله: حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب نا ابن ابي ذءب عن الزهري انه قال: من رمي انسانا ببهيمة فعليه الحد * وبه الي ابن وهب نا ابن سمعان عن الزهري قال: من رمي بذلك  يعني ببهيمة  جلد ثمانين * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن الزهري قال: من قذف رجلا ببهيمة جلد حد الفرية، وقالت طاءفة: لا حد في ذلك كما روينا من طريق عبد الرزاق عن سفيان الثوري عن جابر الجعفي قال: سالت الشعبي عن رجل قذف ببهيمة او وجد عليها قال ليس عليه حد * حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب اخبرني يونس بن يزيد عن ربيعة انه قال فيمن يقذف ببهيمة؟ قال قد قذف بقول كبير والقاءل اهل للنكال الشديد وراي السلطان فيه، واما الحنيفيون.
 والمالكيون.
 والشافعيون.
 واصحابنا الظاهريون فلا يرون في ذلك حدا اصلا وهذا تناقض من الحنيفيين.
 والمالكيين.
 والشافعيين في ذلك اذ يرون الحد علي من قذف بفعل قوم لوط ولا يرون الحد علي  من قذف ببهيمة وكل ذلك مختلف فيه كما اوردنا وكل ذلك لا نص في ايجاب الحد في الرمي به وبالله تعالي التوفيق * قال ابو محمد رحمه الله: وهم لا يجدون عن احد من الصحابة ايجاب حد علي من رمي انسانا بفعل قوم لوط ونحن نوجدهم عن الصحابة رضي الله عنهم ايجاب حد حيث لا يوجبونه كما نذكر ان شاء الله تعالي *  مسالة  فيمن فضل علي ابي بكر الصديق او افتري علي القران كما نا احمد بن عمر بن انس العذري نا عبد الله بن الحسين بن عقال نا ابراهيم بن محمد الدينوري
 نا محمد بن احمد بن الجهم نا ابو قلابة نا محمد بن بشار  بندار  نا محمد بن جعفر  غندر  نا شعبة عن حصين بن عبد الرحمن عن ابن ابي ليلي ان الجارود بن العلاء العبدي قال: ابو بكر خير من عمر فقال رجل من ولد حاجب بن عطارد عمر خير من ابي بكر فبلغ عمر فضرب بالدرة الحاجبي حتي شغر () برجله وقال: قلت عمر خير من ابي بكر ان ابا بكر صاحب رسول الله صلي الله عليه وسلم وكان اخير الناس في كذا وكذا من قال غير ذلك وجب عليه حد المفتري * قال ابو محمد رحمه الله: هكذا في كتاب العذري من ولد حاجب بن عطارد  وهو خطا  والصواب من ولد عطارد بن حاجب بن زرارة * قال علي: انما اخبر عمر في هذا الخبر ان ابا بكر اخير الناس في كذا وكذا اشياء ذكرها لا علي العموم وقد يكون المرء خيرا في شء ما من اخر خير منه في اشياء فقد عذب بلال في الله تعالي بما لم يعذب ابو بكر وجالد علي ما لم يجالد ابو بكر وابو بكر خير منه علي العموم وفي اشياء غير هذا كثيرة، وبالسند المذكور الي ابن الجهم نا محمد بن بشر نا الهيثم.
 والحكم قالا جميعا: نا شهاب بن حراش عن الحجاج بن دينار عن ابي معشر عن ابراهيم قال سمعت: علقمة ضرب بيده علي منبر الكوفة قال سمعت عليا عليه السلام يقول: بلغني ان قوما يفضلونني علي ابي بكر.
 وعمر من قال شيءا من هذا فهو مفتر عليه ما علي المفتري، وبه الي ابن الجهم نا ابو قلابة نا الحجاج ابن المنهال نا محمد بن طلحة عن ابي عبيدة بن حجل ان علي بن ابي طالب قال لا اوتي برجل فضلني علي ابي بكر.
 وعمر الا جلدته حد المفتري * حدثنا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا اسماعيل ابن ابي خالد عن عامر الشعبي قال.
 استشارهم عمر في الخمر فقال عبد الرحمن بن عوف  من افتري علي القران اري ان يجلد ثمانين * حدثنا عبد الله بن ربيع نا عبد الله بن محمد ابن عثمان نا احمد بن خالد نا علي بن عبد العزيز نا الحجاج بن المنهال نا حماد بن سلمة عن عطاء ابن الساءب عن جحادة بن دثار ان ناسا من اصحاب رسول الله صلي الله عليه وسلم شربوا الخمر بالشام وال يزيد بن ابي سفيان كتب فيهم الي عمر فذكر الحديث، وفيه انهم احتجوا علي عمر بقول الله تعالي: (ليس علي الذين امنوا وعملوا الصالحات جناح فيما طعموا اذا ما اتقوا وامنوا وعملوا الصالحات ثم اتقوا وامنوا) فشاور فيهم الناس فقال لعلي ماذا تري؟ فقال: اري انهم قد شرعوا في دين الله ما لم ياذن به فان زعموا انها حلال فاقتلهم فانهم قد احلوا ما حرم الله تعالي وان زعموا انها حرام فاجلدهم ثمانين ثمانين فقد افتروا علي الله الكذب وقد اخبر الله تعالي بحد ما يفتري به بعضنا علي بعض * قال ابو محمد رحمه الله: هم يعظمون  يعني الحنيفيين.
 والمالكيين  قول الصاحب وحكمه اذا وافق تقليدهم واهواءهم وهم ههنا قد خالفوا الصحابة رضي الله عنهم فلا يرون علي من فضل عمر علي ابي بكرحد الفرية ولا علي من فضل عليا عليهما حد الفرية ولا يرون علي من افتري علي الله تعالي وعلي القران حد الفرية لكن يرون القتل ان بدل الدين او لا شء ان كان متاولا هذا وهم يحتجون بقول علي.
 وعبد الرحمن في هذين الخبرين في اثبات ثمانين في حد الخمر نعم وفي اثبات القياس وقد خالفوهما في ايجاب حد الفرية علي من افتري علي الله كذبا فلءن كان قول علي.
 وعبد الرحمن حجة في ايجاب حد الخمر وفي القياس فانه حجة في ايجاب حد الفرية علي من افتري علي الله تعالي كذبا وعلي القران، ولءن كان قولهما ليس بحجة في ايجاب حد الفرية علي من افتري علي الله تعالي.
 وعلي القران فما قولهما حجة في ايجاب القياس ولا في ايجاب ثمانين في الخمر ولا فرق وبالله تعالي التوفيق، وهذا يليح لمن انصف نفسه انه ليس كل فرية يجب فيها الحد فاذ ذلك كذلك فلا حد الا في الفرية بالزنا لصحة النص والاجماع علي ذلك وبالله تعالي التوفيق *  مسالة  عفو المقذوف عن القاذف  قال ابو محمد رحمه الله:
 حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب اخبرني يونس بن يزيد عن ربيعة انه قال في رجل قال للامام افتري علي فلان او رمي امي فيقول الامام افعلت؟ فيقول نعم قد فعلت فيقول الاخر قد اعفيته فينبغي للامام ان يقول للمفتري عليه انت ابصر ولا يكشفه لعله يكشف غطاء لا يحل كشفه فان عاد يلتمس ذلك الحد كان ذلك له، وبه الي ابن وهب ني مالك بن انس ان زريق بن الحكم حدثه قال: افتري رجل يقال له مصباح علي ابنه فقال له يا زاني فرفع ذلك الي  فامرت بجلده فقال والله لءن جلدته لاقرن علي نفسي بالزنا فلما قال ذلك لي اشكل علي فكتبت الي عمر بن عبد العزيز اذكر ذلك له فكتب عمر الي ان اجز عفوه في نفسه قال زريق فكتبت الي عمر بن عبد العزيز في الرجل يفتري عليه ابواه ايجوز عفوه عنهما؟ فكتب عمر الي خذ له بكتاب الله تعالي الا ان يريد سترا * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن اسماعيل بن امية اخبرني زريق بن حكيم ان عمر بن عبد العزيز كتب اليه في رجل قذف ابنه ان اجلده الا ان يعفو ابنه عنه، قال ابن زريق فظننت انها للاب خاصة فكتبت الي عمر اراجعه للناس عامة ام للاب خاصة؟ فكتب الي بل للناس عامة، وقال اخرون لا عفو في ذلك لاحد كما روينا بالسند المذكور الي عبد الرزاق عن عمر بن عبد العزيز عن عمر بن الخطاب قال: لا عفو في الحدود عن شء منها بعد ان تبلغ الامام فان اقامتها من السنة، وبه الي عبد الرزاق عن معمر.
 وابن جريج كلاهما عن الزهري قال: اذا بلغت الحدود السلطان فلا يحل لاحد ان يعفو عنها قال ابن جريج.
 ومعمر  يعني الفرية  وقد روي هذا القول عن الحسن البصري، وبه يقول ابو سليمان.
 واصحابنا وهو قول الاوزاعي.
 والحسن بن حي، وقال ابو حنيفة.
 واصحابه لا يجوز العفو عن الحد في القذف وروي عن ابي يوسف في احد قوليه.
 وعن الشافعي.
 واصحابه.
 واحمد بن حنبل.
 واصحابه ان العفو في ذلك جاءز قبل
 بلوغ الامر الي الامام وبعد بلوغه اليه، وقال مالك فيمن قذف اخر فثبت ذلك عند الامام فاراد المقذوف ان يعفو عن القاذف قال: لا يجوز له العفو الا ان يريد سترا علي نفسه خوف ان يثبت عليه ما رمي به فيجوز عفوه حينءذ قال مالك: فان اراد المقذوف ان يءخر اقامة الحد علي القاذف له او لابويه كان ذلك له وياخذه به متي احب قال فان عفا عنه ثم اراد اخذه لم يكن له اخذه به * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر في ذلك فوجدنا هذا الاختلاف مرجعه الي احد وجهين لا ثالث لهما، اما ان يكون الحد في القذف من حقوق الله تعالي كالحد في الزنا.
 والحد في الخمر.
 والحد في السرقة.
 والحد في المحاربة، واما ان يكون من حقوق الناس كالقصاص في الاعضاء.
 والجنايات علي الاموال فان كان الحد في القذف من حقوق الله تعالي كساءر الحدود فلا يجوز لاحد عفو فيه لانه لا حق له فيه ولا فرق بين من سرق مال انسان.
 او زني بامته وافتري عليه او بامراة اكرهها.
 وسرق مالا من مالها.
 وافتري عليها فلم يختلفوا في انه ليس للرجل ان يعفو عن الزنا بامته فيسقط عنه حد الزنا بذلك ولا لهما ان يعفوا عمن  سرق مالهما او قطع عليهما الطريق فيسقط عنه حد السرقة بذلك.
 وحد المحاربة، والمفرق بين القذف وبين ما ذكرنا متحكم في الدين بلا دليل وان كان الحد في القذف من حقوق الناس فعفو الناس عن حقوقهم جاءز، فنظرنا في قول مالك فوجدناه ظاهر التناقض لانه ان كان حد القذف عنده من حقوق الله تعالي فلا يجوز عفو المقذوف اراد سترا او لم يرد لان الله تعالي لم يجعل له اسقاط حد من حدود الله تعالي وان كان من حقوق الناس فالعفو جاءز لكل احد في حقه اراد سترا او لم يرد ويقال لمن نصر هذا القول الظاهر الخطا: ما الفرق بين هذا وبين من عفا عن الزاني بامته وهو يريد تسترا علي نفسه خوف ان يقيم الواطء لها بينة بانها له غصبها منه الذي
 هي بيده الان؟ وبين من عفا عن سارق متاعه وهو يريد سترا علي نفسه خوف ان يقيم الذي سرقه منه بينة عدل بان الذي كان بيده سرقه منه وانه مال من مال هذا الذي سرقه اخر فهل بين شء من هذا كله فرق؟ هذا ما لا يعرف اصلا فسقط هذا القول جملة لتناقضه ولتعريه من الادلة ولانه قول لا يعرف عن احد من الصحابة رضي الله عنهم ولا عن احد من التابعين، ثم نظرنا في قول ابي حنيفة فوجدناه قد تناقض لانه جعله من حقوق الله تعالي ولم يجز العفو عنه اصلا فاصاب في ذلك ثم تناقض مناقضة ظاهرة فقال لا حد علي القاذف الا ان يطالبه المقذوف فجعله بهذا القول من حقوق المقذوف واسقطه بان لم يطلبه وهذا تخليط ظاهر * قال ابو محمد رحمه الله: وهذا لا حجة لهم فيه وقد نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا قتيبة بن سعيد نا محمد بن ابي عدي عن محمد بن اسحاق عن عبد الله ابن ابي بكر بن محمد بن عمرو بن حزم عن عمرة بنت عبد الرحمن عن عاءشة ام المءمنين قالت: لما نزل عذري قام النبي صلي الله عليه وسلم علي المنبر فامر بالمراة والرجلين فضربوا حدهم * قال ابو محمد رحمه الله: فهذا رسول الله صلي الله عليه وسلم اقام حد القذف ولم يشاور عاءشة امنا رضي الله عنها ان تعفو ام لا؟ فلو كان لها في ذلك حق لما عطله عليه السلام وهو ارحم الناس واكثرهم حضا علي العفو فيما يجوز فيه العفو فصح ان الحد من حقوق الله تعالي لا مدخل للمقذوف فيه اصلا ولا عفو له عنه، واما من طريق الاجماع فان الامة مجمعة علي تسمية الجلد المامور به في القذف حدا ولم يات نص ولا اجماع بان لانسان حكما في اسقاط حد من حدود الله تعالي فصح انه لا مدخل للعفو فيه، واما من طريق النظر فلو كان من حقوق الناس لكان العفو المذكور في ذلك لا يجوز البتة الا من المقذوف فيما قذف به لا فيما قذف به غيره من  ابيه.
 وامه لانه لا خلاف في انه لا يجوز عفو احد عن حق غيره وهم يجيزون عفو
 المرء عن قاذف ابيه الميت وامه الميتة وهذا فساد وتناقض من القول والقوم اهل قياس وقد اتفقوا علي انه لا عفو للمسروق منه في قطع يد سارقه ولا للمقطوع عليه في الطريق في العفو عن القاطع عليه للمحارب له ولا للمزني بامراته وامته عن الزاني بهما فاي فرق بين حد القذف وحد السرقة ولا للمقطوع عليه الطريق في العفو عن القاطع، واما ما جاء عن الصحابة رضي الله عنهم فان عمر جلد ابا بكرة.
 ونافعا.
 وشبل ابن معبد اذ راهم قذفة ولم يشاور في ذلك المغيرة ولا راي له حقا في عفو او غيره فبطل قول من راي العفو في ذلك جملة وبالله تعالي التوفيق *  مسالة  في من قال لامراته يا زانية فقالت زنيت معك او قال ذلك لرجل فقال انت ازني مني * قال ابو محمد رحمه الله: حدثنا عبد الله بن ربيع نا عبد الله بن محمد بن عثمان نا احمد بن خالد نا علي بن عبد العزيز نا الحجاج بن المنهال نا حماد بن سلمة عن قتادة قال في من قال لامته يا زانية فقالت زنيت بك قال: تجلد تسعين، وبه الي حماد بن سلمة عن ابي حرة عن الحسن في امراة حرة قالت لاخر: زنيت بك قال تجلد حدين * قال ابو محمد: اذا قال الرجل للمراة او قالت المراة للرجل زنيت بك فهذا اعتراف مجرد بالزنا وليس قذفا لانه من قال هذا اللفظ فانما اخبر عن نفسه انه زني ولم يخبر عن المقول له بزنا اصلا وقد يزني الرجل بالمراة وهي سكري.
 او مجنونة.
 او مغلوبة.
 او وهي حاملة وهو عالم وتزني المراة بالرجل كذلك وكمن ابتاع امة فاذا بها حرة فهي زانية وليس هو زانيا فقاءل هذا القول ان قاله معترفا فعليه حد الزنا فقط ولا شء عليه غير ذلك وان قاله لها شاتما فليس قاذفا ولا معترفا فلا حد عليه لا للزنا ولا للقذف ولكن يعزر للاذي فقط فلو قال لها زنينا معا او قالت له ذلك فهذا ان كان قاله شاتما فهو قذف صحيح عليه حد القذف فقط وان قاله معترفا فعليه حد الزنا فقط،
 وكذلك علي المراة ان قالت ذلك ولا فرق * حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم ابن اصبغ نا ابن وضاح نا سحنون نا ابن وهب اخبرني يونس بن يزيد عن الزهري.
 وربيعة قالا جميعا فيمن قال لاخر اني اراك زانيا فقال له الاخر انت ازني مني وهما عفيفان فانهما يجلدان الحد معا زاد ربيعة لا يكون رجل ازني من رجل حتي يكون زانيا.
 وقال مالك يضربان الحد جميعا *

 قال ابو محمد رحمه الله: اما قول ربيعة لا يكون رجل ازني من رجل حتي يكون زانيا فخطا والمستعمل في اللغة غير.
 هذا قال الله تعالي: (الله خير اما يشركون) ولا خير اصلا فيما يشركون، وقال تعالي: (اصحاب الجنة يومءذ خير مستقرا واحسن مقيلا) وليس في القرار في النار خير اصلا ولا فيها من حسن المقيل لا كثير ولا قليل نعوذ بالله منها، وقال رسول الله صلي الله عليه وسلم: " كتاب الله احق وشرط الله اوثق " وليس في شرط لغير الله شء من الثقة ولا في غير كتاب الله تعالي في الدين شء من الحق، واما السنة والاجماع فهما داخلان في كتاب الله تعالي لان كل ذلك عدل الله تعالي فنظرنا في هذا فوجدنا من قال لاخر انت ازني مني ليس فيه اعتراف علي نفسه بالزنا وانما هو قذف صحيح فواجب جلده حد القذف وبالله تعالي التوفيق *  مسالة  فيمن ادعت ان فلانا استكرهها  قال علي: نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق نا معمر عن الزهري.
 وقتادة قالا جميعا في امراة قذفت رجلا بنفسها انه غلبها علي نفسها والرجل ينكر ذلك وليس لها بينة فانها تضرب حد الفرية * حدثنا عبد الله بن ربيع نا عبد الله بن محمد بن عثمان نا احمد بن خالد نا علي بن عبد العزيز نا الحجاج بن المنهال نا حماد بن سلمة انا قتادة ان رجلا استكره امراة فصاحت فجاء مءذن فشهد لها عند عمر بن عبد العزيز انه سمع صياحها فلم
 يجلدها * حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب اخبرني عميرة بن ابي ناجية عن يزيد بن ابي حبيبة عن عمر بن عبد العزيز انه اتنه امراة فقالت ان فلانا استكرهني علي نفسي فقال: هل سمعك احد او راك؟ قالت لا فجلدها بالرجل  وهو عمرو بن مسلم.
 او اسحاق بن مسلم مولي عمرو بن عثمان  قال ابن وهب: سالت مالكا عن المراة تقول ان فلانا اكرهني علي نفسي قال ان كان ليس مما يشار اليه بذلك جلدت الحد وان كان مما يشار اليه بالفسق نظر في ذلك * قال ابو محمد رحمه الله: ههنا يرون عليه السجن الطويل والادب وغرم مهر مثلها وهذا اقوال تدور علي وجوه اما جلدها حد القذف ان لم يكن لها بينة  وهو قول الزهري.
 وقتادة  واما اسقاط الحد عنها بشهادة واحد انه سمع صياحها فقط  وهو عن عمر بن عبد العزيز  والا فتجلد.
 واما ان يدرا عنها الحد بان يري معها خاليا ويءثر فيه اثرا او يسمع صياحها وهو قول ربيعة وهو ايضا قول يحيي بن  سعيد الانصاري وزاد ان يعاقب الرجل المدعي عليه ان كان ذلك اشد العقوبة ان ظهر بشء مما ذكرنا والا فالحد علي المراة حد القذف، واما ان ينظر فان كان المدعي عليه من اهل العافية جلد حد القذف.
 وان كان ممن يشار اليه بالفسق فلا شء عليها ويسجن هو ويطال سجنه ويغرم مهر مثلها  وهو قول مالك  * قال ابو محمد رحمه الله: اما قول مالك فظاهر الخطا لانه فرق في الادعاء بين المشار اليه بالخير.
 والمشار اليه بالفسق ولم يوجب الفرق بين شء من ذلك قران.
 ولا سنة.
 ولا اجماع.
 ولاقياس.
 ولا قول صاحب، وقد اجمعت الامة كلها علي ان رجلا يدعي دينا علي اخر والمدعي عليه منكر فانه يحلف ولو انه احد الصحابة رضي الله عنهم.
 وقد قضي باليمين علي عمر.
 وعثمان.
 وابن عمر.
 وغيرهم رضي الله عنهم
 ولا اجد افضل منهم ولا ابعد من التهمة والدعوي بجحد المال.
 والظلم.
 والغصب كالدعوي بالغلبة في الزنا ولا فرق لان كل ذلك حرام ومعصية وقد قال رسول الله صلي الله عليه وسلم: " لو اعطي قوم بدعواهم لا دعي قوم دماء قوم واموالهم ولكن اليمين علي من ادعي عليه " وقال عليه السلام لصاحب من اصحابه اختصما: " بينتك او يمينه " وقد اجمعت الامة ومالك معهم علي ان مسلما برا فاضلا عدلا ولو انه احد الصحابة رضي الله عنهم ادعي مالا علي يهودي.
 او نصراني ولا بينة له ان اليهودي.
 او النصراني يبرا من ذلك بيمينه وان الكافر لو ادعي ذلك علي المسلم لا حلف له فكيف يقضي لها بدعواها فيغرمه مهرها من اجل انه فاسق ولا فاسق افسق من كافر قال الله تعالي: (الكافرون هم الفاسقون) فهذان وجهان من الخطا، وثالث وهو القضاء عليه بالسجن والعقوبة دون بينة وهذا ظلم ظاهر لا خفاء به، ورابع هو انه لا يخلو من ان يكون يصدقها او يكذبها ولا سبيل الي قسم ثالث فان كان يصدقها فينبغي له ان يقيم عليها حد الزنا والا فقد تناقض وضيع حدا لله تعالي وان كان يكذبها فباي معني يسجنه ويغرمه مهر مثلها فيءكلها المال بالباطل وياخذ ماله بغير حق، وخامس وهو انه ان تكلمت وكان المدعي عليه معروفا بالعافية جلدها حد القذف وان مكثت فظهر بها حمل رجمها ان كانت محصنة وهذا ظلم ما سمع باشنع منه وحرج في الدين لم يجعله الله تعالي قط فيه ولا يحفظ عن احد فرق هذا التفريق قبل مالك وبالله تعالي التوفيق * قال ابو محمد رحمه الله: فنظرنا في ذلك فوجدنا الله تعالي يقول: (فان تنازعتم في شء فردوه الي الله والرسول) الاية ففعلنا فوجدنا الله تعالي قد اوجب الحد علي من  رمي احدا بالزنا الا ان ياتي ببينة ثم نظرنا في التي تشتكي بانسان انه غلبها علي نفسها فوجدناها لا تخلو من ان تكون قاذفة او تكون غير قاذفة فان كانت قاذفة فالحد واجب
 عليها بلا شك اذ لا خلاف في ان قاذف الفاسق يلزمه الحد كقاذف الفاضل ولا فرق، والقذف هو ما قصد به العيب والذم وهذه ليست قاذفة انما هي مشتكية مدعية واذ ليست قاذفة فلا حد للقذف عليها ولكن تكلف البينة فان جاءت بها اقيم عليه حد الزنا وان لم تات بها فلا شء عليه اصلا لا سجن ولا ادب ولا غرامة لان ماله محرم وبشرته محرمة ومباح له المشي في الارض، قال الله تعالي: (فامشوا في مناكبها) (فان قال قاءل): فان لم تكن بينة فاقضوا عليه باليمين بهذا الخبر (قلنا): وبالله تعالي التوفيق ان دعواها انتظم حقا لها وحقا لله تعالي ليس لها فيه دخول ولا خروج فحقها هو التعدي عليها وظلمها وحق الله تعالي هو الزنا فواجب ان يحلف لها في حقها فيحلف بالله ما تعديت عليك في شء ولا ظلمتك وتبرا ذمته ولا يجوز ان يحلف بالله ما زني لانه لا خلاف في ان احدا لا يحلف في حق ليس له فيه مدخل، ولا يختلف اثنان في ان من قال انك غصبتني وزيدا دينارا فانه انما يحلف له في حقه من الدينار لا في حق زيد وهكذا في كل شء، واما الفرق بين الذم والشكوي فانهم لا يختلفون فيمن قال لاخر ابتداء او في كلام بينهما يا ظالم يا غاصب انه مسء، فمن قاءل عليه الادب، ومن قاءل للاخر ان يقول له مثل ذلك ولا يختلفون فيمن شكا باخر فقال ظلمني واخذ مالي بغير حق انه لا شء عليه وانه ليس مسيءا بذلك فصح الفرق بين الشكوي وبين الاعتداء بالسب والقذف وبالله تعالي التوفيق *  مسالة  فيمن قذف وهو سكران  قال ابو محمد رحمه الله: قد ذكرنا في مواضع كثيرة حكم السكران وانه غير مءاخذ بشء اصلا الا حد الخمر فقط الا اننا نذكر عمدة حجتنا في ذلك باختصار ان شاء الله تعالي * قال ابو محمد رحمه الله: قال الله تعالي: (يا ايها الذين امنوا لا تقربوا الصلاة وانتم سكاري حتي تعلموا ما تقولون) فشهد الله تعالي وهو اصدق شاهد ان السكران لا يدري ما يقول واذا لم يدر ما يقول فلا شء عليه ولم يختلف احد من الامة في ان امرءا لو نطق بلفظ لا يدري معناه وكان معناه كفرا.
 او قذفا.
 او طلاقا فانه لا يءاخذ
 بشء من ذلك فاذا كان السكران لا يدري ما يقول فلا يجوز ان يءاخذ بشء مما يقول قذفا كان او غير قذف (فان قالوا): كان هذا قبل تحريم الخمر (قلنا).
 نعم فكان ماذا؟ والامة كلها مجمعة بلا خلاف من احد منها علي ان حكم هذه الاية باق لم ينسخ وانه لا يحل لسكران ان يقرب الصلاة حتي يدري ما يقول.
 وكذلك لا يختلف اثنان  من ولد ادم في ان حال السكران في انه لا يدري ما يقول باق كما كان لم يحله الله تعالي عن صفته (فان قالوا): هو ادخل ذلك علي نفسه (قلنا): نعم وهذا لا فاءدة لكم فيه لوجوه، اولها ان هذا تعلل لا يوجب حكما لانه لم يات بهذا التعليل قران.
 ولا سنة.
 ولا اجماع.
 والثاني انا نسالكم عمن اكره علي شرب الخمر ففتح فمه كرها باكاليب وصب فيه الخمر حتي سكر فان هذا لا خلاف في انه غير اثم ولا في انه لم يدخله علي نفسه فينبغي ان يكون حكمه عندكم بخلاف حكم من ادخله علي نفسه فلا تلزموا هذا المكره شيءا مما قال في ذلك السكر والا فقد تناقضتم، والثالث انا نسالكم عمن شرب البلاذر فجن، او تزيد نقطع عصب ساقيه فاقعد ايكون لذلك المجنون حكم المجانين في سقوط جميع الاحكام عنه او تكون الاحكام لازمة له من اجل انه ادخل ذلك علي نفسه؟ وهل يكون للذي ابطل ساقيه عمدا او اشرا ومعصية لله تعالي حكم المقعد في الصلاة وسقوط الحج وغير ذلك ام لا يسقط عنه شء من ذلك من اجل ادخاله ذلك علي نفسه؟ فمن قولهم بلا خلاف ان لهما حكم ساءر المجانين وساءر القاعدين فبطل تعلقهم بان السكران ادخل ذلك علي نفسه، وقد صح ان حمزة رضي الله عنه قال لرسول الله صلي الله عليه وسلم.
 ولعلي بن ابي طالب.
 وزيد بن خالد هل انتم الا عبيد لاباءي وهو سكران فلم يعنفه علي ذلك ولو قالها صحيحا لكفر بذلك وحاش له من ذلك، فصح ان السكران اذا ذهب تمييزه فلا شء عليه لا في القذف ولا في غيره لانه مجنون لا عقل له * (فان قالوا): قد جاء عن بعض الصحابة رضي الله عنهم اذا شرب سكر واذا
 سكر هذي واذا هذي افتري واذا افتري جلد ثمانين (قلنا): حاشي لله ان يقول صاحب هذا الكلام الفاسد هم والله اجل.
 واعقل.
 واعلم من ان يقولوا هذا السخف الباطل ويكفي منه اجماعهم علي ان من هذي فلا حد عليه ولو كفر او قذف فهم يحتجون بما هم اول مخالف له واحضر مبطل لحكمه ونعوذ بالله مثل هذا، وسنتكلم ان شاء الله تعالي في ابطال هذا الخبر من طريق اسناده ومن تخاذله وفساده في كلامنا في حد الخمر من ديواننا هذا ان شاء الله تعالي (فان قالوا): ومن يدري انه سكران ولعله تساكر (قيل لهم): قولوا هذا بعينه في المجنون ومن يدري انه مجنون ولعله متحامق وانتم لا تقولون هذا بل تسقطون عنه الاحكام والحدود فالحال التي تدري في المجنون انه مجنون بمثلها يدري في السكران انه سكران ولا فرق وهي انه اذا بلغ من نفسه من التخليط في كلامه وافعاله حيث يوقن انه لا يبلغه من نفسه المميز الصاحي حياء من مثل تلك الحال فهذا بلا شك احمق وسكران كما قال الله تعالي: (حتي تعلموا ما تقولون)  فمن خلط في كلامه فليس يعلم ما يقول وبالله تعالي التوفيق *  مسالة  الاب يقذف ابنه.
 او ام عبيده.
 او ام ابنه * قال ابو محمد رحمه الله: قد ذكرنا حكم عمر بن عبد العزيز يحد من قذف ابنه واوجب الحد في ذلك مالك.
 والاوزاعي.
 وابو سليمان.
 واصحابنا، وقالت طاءفة: لا حد علي الاب في ذلك كما نا حمام نا ابن مفرج نا ابن الاعرابي نا ابو يعقوب الدبري نا عبد الرزاق عن ابن جريج عن عطاء قال اذا افتري الاب علي الابن فلا يحد، وبه الي عبد الرزاق عن سفيان الثوري عمن سمع الحسن يقول ليس علي الاب لابنه حد، وبه يقول ابو حنيفة.
 والشافعي.
 واحمد بن حنبل.
 واصحابهم.
 والحسن بن حي.
 واسحق بن راهويه، وقال سفيان الثوري في الاب يقذف ابنه انهم يستحبون الدرا عنه، وقال في المراة تزني وهي محصنة وتقتل ولدها انه يدرا عنها الحد *
 قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر في ذلك فنظرنا في قول من راي انه لا يحد الاب لابنه فوجدناهم يقولون قال الله تعالي: (وبالوالدين احسانا ولا تقل لهما اف ولا تنهرهما وقل لهما قولا كريما واخفض لهما جناح الذل من الرحمة) قالوا وليس من الاحسان.
 ولا من البر ضربهما بالسياط ولا هذا من خفض الجناح لهما من الرحمة وقاسوا ايضا اسقاط الحدود في القذف عن الوالد في قذفه لولده علي اسقاطهم القود عنه ان قتله واسقاطهم القصاص عنه لولده فيما دون النفس علي اسقاطهم الحد عنه في سرقته من ماله وعلي اسقاطهم الحد في زناه بام ولده * قال ابو محمد رحمه الله: ما نعلم لهم غير هذا اصلا وكل هذا لا حجة لهم فيه علي ما نبين ان شاء الله تعالي، اما وصية الله تعالي بالاحسان الي الابوين بان لا يقال لهما اف ولا ينهرا ويخفض لهما جناح لذل من الرحمة فحق لا يحيد عنه مسلم وليس يقتضي شء من ذلك اسقاط الحد عنه في القذف لولده لانه لا يختلف الناس في ان اما ماله والد قدم اليه في قذف او في سرقة او في زنا او في قود فان فرضا علي الوالد اقامة الحد علي والده في كل ذلك وان ذلك لا يسقط عنه ما افترض الله تعالي له عليه من الاحسان والبر وان لا ينهره ولا يقل له اف وان يخفض له جناح الذل من الرحمة وان يشكر له ولله عزوجل وقد قال الله عزوجل: (اشداء علي الكفار رحماء بينهم) وقد امر مع ذلك باقامة الحد علي من امرنا برحمته، وقال تعالي: (وبالوالدين احسانا وبذي القربي واليتامي والمساكين) الاية ولا خلاف بين احد من الامة في ان ذا القربي يحد في قذف ذي القربي وان ذلك لا يضاد الاحسان المامور به بل اقامة الحد علي الوالدين فمن دونهما احسان اليهما وبر بهما لانه حكم الله تعالي الذي لولاه لم يجب برهما  فسقط تعلقهم بالايات المذكورات واما قياسهم اسقاط حد القذف علي اسقاطهم عن الوالد حد الزنا في زناه بامة ولده وعلي اسقاطهم عنه حد السرقة في سرقة مال ولده وعلي اسقاطهم القود عنه في قتله اياه وجرحه اياه في اعضاءه فهذا قياس والقياس كله باطل لانه
 قياس للخطا علي الخطا ونظر للباطل بالباطل واحتجاج منه لقول لهم فاسد بقول لهم اخر فاسد لا يتابعون عليه ولا اوجبه نص.
 ولا اجماع بل الحدود والقود واجبان علي الاب للولد في كل ما ذكرنا، وبالله تعالي التوفيق، فلما سقط قولهم لتعريه عن البرهان رجعنا الي القول الثاني فوجدناه صحيحا لان الله تعالي قال: (والذين يرمون المحصنات) الاية فلم يقل تعالي الا الوالد لولده (وما كان ربك نسيا) فلو ان الله تعالي اراد تخصيص الاب باسقاط الحد عنه لولده لبين ذلك ولما اهمله حتي يتفطن له من لا حجة في قوله فصح يقينا ان الله تعالي اذ عم ولم يخص فانه اراد ان يحد الوالد لولده والولد لوالده بلا شك ووجدناه تعالي يقول: (يا ايها الذين امنوا كونوا قوامين بالقسط شهداء لله ولو علي انفسكم او الوالدين والاقربين) فاوجب الله تعالي القيام بالقسط علي الوالدين والاقربين كالاجنبيين فدخل في ذلك الحدود وغيرها، وبالله تعالي التوفيق * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج قال: اخبرني عبد العزيز بن عمر بن عبد العزيز عن ابيه عمر بن عبد العزيز عن عمر ابن الخطاب قال: لا عفو عن الحدود ولا عن شء منها بعد ان تبلغ الامام فان اقامتها من السنة فهذا قول صاحب لا يعرف له مخالف منهم وهم يعظمون مثل هذا اذا خالف تقليدهم وقد خالفوه ههنا لان عمر بن الخطاب عم جميع الحدود ولم يخص * قال ابو محمد رحمه الله: وكذلك اختلفوا فيمن قذف ام ابنه فقال ابو حنيفة واصحابه.
 والشافعي.
 واصحابه: ليس للولد ان ياخذ اباه بذلك، وقال مالك: له ان ياخذه بذلك، وقال ابو حنيفة.
 والشافعي.
 واصحابهما فيمن قذف ام عبد له ليس له ان ياخذ عبده الحد في ذلك، وقال ابو ثور.
 وابو سليمان.
 واصحابنا: له ان ياخذه بذلك والكلام في هاتين المسالتين كالكلام في التي قبلهما وقد بينا ان حد القذف حد لله تعالي لا للمقذوف فاذ هو كذلك فاخذه واجب علي كل حال قام به
 من قام به من المسلمين لان الله تعالي امر بجلد القاذف ثمانين لم يشترط به قاءما من الناس دون غيره فكان تخصيص من خص بعض القاءمين به دون بعض قولا في غاية الفساد وهو قول مخترع لهم ما نعلم احدا من الصحابة رضي الله عنهم قال به ولا له  حجة اصلا لا من قران.
 ولا من سنة.
 ولا اجماع.
 ولا قياس.
 ولا معني، وما كان هكذا فهو ساقط وبالله تعالي التوفيق * قال ابو محمد رحمه الله: والحكم عند الحنيفيين في اسقاط الحد عن الجد اذا قذف ولد الولد كالحكم في قاذف الابوين الادنين، والعجب بان الحنيفيين قد فرقوا بين حكم الولد وبين حكم ولد الولد في المرتد فجعلوا ولد المرتد يجبر علي الاسلام ولا يقتل وجعلوا ولد ولده لا يجبر ولا يقتل، وفرق ابو يوسف ومحمد بن الحسن.
 والشافعي بين الاب في الميراث وبين الجد فمن اين وقع لهم التناقض ههنا فسووا بين الاب والجد وبين الابن وابن الابن؟ والقوم اصحاب قياس بزعمهم وهذا تناقض لا نظير له وبالله تعالي التوفيق *  مسالة  من نازع اخر فقال له الكاذب بيني وبينك ابن زانية او قال ولد زنا او زنيم او زان فقد قال قاءلون لا حد عليه * قال ابو محمد: ان كان قال ذلك مبتدءا قبل ان ينازعه الاخر فلا حد علي القاءل لانه لم يقذف بعد احدا وان قال ذلك بعد المنازعة فهو قاذف له بلا شك فعليه الحد لان المنازع له كاذب عنده بلا شك وهكذا لو قال: من حضر اليوم علي هذا الطريق فهو ابن زانية وقد كان حضر من هنالك احد فهو قاذف له بلا شك فعليه الحد فلو قال ذلك في المستانف فلا حد عليه لانه اذا لفظ بذلك لم يكن قاذفا ومن المحال ان يصير قاذفا وهو ساكت بعد ان لم يكن قاذفا اذا نطق وهذا باطل لا خفاء به وبالله تعالي التوفيق *  مسالة  من قذف اجنبية وامراته ثم زنت الاجنبية وامراته
 بعد القذف فعليه حد القذف كاملا للاجنبية ولا بد ويلاعن ولا بد ان اراد ان ينفي حمل زوجته او ان ثبت عليها الحد فان ابي وقد جلد للاجنبية فالحمل لاحق به ولا شء علي زوجته لا لعان.
 ولا حد.
 ولا حبس.
 ولا عليه بعد لانه قد حد وان كان لم يجلد لاعن ان اراد ان ينفي الحمل عنه فان ابي جلد الحد فان التعن والتعنت المراة جلد حد الزنا، وجملة هذا ان من قذفه قاذف ثم زني المقذوف لم يسقط ذلك الزنا ما قد وجب من الحد علي قاذفه لانه زنا غير الذي رماه به فهو اذا رمي رامي محصن او محصنة فعليه الحد ولابد ولا يسقط حد قد وجب الا بنص او اجماع ولا نص ولا اجماع ههنا اصلا علي سقوطه بعد وجوبه بنص، وكذلك القول في الزوجة ولا فرق انه يجلد لها للقذف وان زنت الا ان يلاعن وتحد هي للزنا ولا بد وبالله تعالي التوفيق *

  مسالة  من قال لاخر يا زاني فقال له انسان صدقت او قال نعم.
 فان ابا حنيفة وجميع اصحابه الا زفر بن الهذيل قالوا: لا حد علي القاءل صدقت قالوا: فلو قال له صدقت هو كما قلت حدا جميعا قال زفر في كلتا المسالتين يحدان جميعا * قال ابو محمد رحمه الله: لا فرق بين المسالتين ومن قال انه في قوله له صدقت يمكن ان يصدقه في غير رميه بالزنا قيل له وكذلك قوله صدقت هو كما قلت ممكن ان يعني بذلك قولا اخر قاله هذا القاذف من غير القذف ولا فرق * قال ابو محمد رحمه الله: والذي نقول به وبالله تعالي التوفيق انه ان تيقن ان القاءل صدقت او نعم.
 او هو كما قلت.
 او اي والله انه سمع القذف وفهمه فهو مقر بلا شك وعليه الحد وكذلك من قيل له ابعت دارك من زيد بماءة دينار؟ فقال نعم او قال صدقت.
 او قال اي والله.
 او ما اشبه هذا فانه اقرار صحيح بلا شك او قال ذلك مجاوبا لمن قال له طلقت امراتك.
 او انكحت فلانة.
 او وهبت امرا
 كذا وكذا فهكذا في كل شء وان وقع شك اسمع القذف او لم يسمعه وفهمه.
 او لم يفهمه فلا حد في ذلك لانه قد يهم ويظن انه قال كلاما اخر وهكذا في جميع ما ذكرنا من غير ذلك ولا فرق، وقد قال النبي صلي الله عليه وسلم: " ان دماءكم واموالكم واعراضكم وابشاركم عليكم حرام " فصح انه لا يحل ان يستباح شء مما ذكرنا الا بيقين لا اشكال فيه وبالله تعالي التوفيق *  مسالة  من قال لاخر فجرت بفلانة او قال فسقت بها فان ابا حنيفة.
 والشافعي.
 واصحابهما قالوا: لا حد في ذلك * قال ابو محمد رحمه الله: ان كان لهذين اللفظين وجه غير الزنا فكما قالوا وان كان لا يفهم منهما غير الزنا فالحد في ذلك فلما نظرنا فيهما وجدناهما يقعان علي اتيانها في الدبر فسقط الحد في ذلك وكذلك لو قال جامعتها حراما ولا فرق * قال علي: فلو اخبر بهذا عن نفسه لم يكن معترفا بالزنا كما ذكرنا وبالله تعالي التوفيق *  مسالة  ومن قال لاخر زنيت بكسر التاء او قال لامراة زنيت بفتح التاء فان كان غير فصيح حد ولا بد وان كان فصيحا يحسن هذا المقدار من العربية سءل من خاطبت فان قال خاطبت غيرها او قال خاطبت غيره فلا شء عليه لان هذا هو ظاهر كلامه لان خطاب المءنث لا يكون الا بكسر التاء فاذا خاطبها بفتح التاء فلم يخاطبها وخطاب الرجل بفتح التاء فاذا خاطبه بكسرها فلم يخاطبه وان اقر انه خاطبها بذلك حد لانه حينءذ قاذف لها وبالله تعالي التوفيق *

  مسالة  من قذف انسانا قد زني المقذوف وعرف انه صادق في ذلك فجميع العلماء علي انه لا يحل طلبه بذلك الحد الا مالكا فانه قال له طلبه * قال ابو محمد رحمه الله: وهذا قول ظاهر الفساد بين الحوالة لا خفاء به لانه لا خلاف في ان من عرف صدقه في القذف فلا حد عليه فاذا عرف المقذوف ان قاذفه
 صادق فقد عرف انه لاحد عليه فمطالبته اياه ظلم بيقين واباحة طلبه له اباحة للظلم المتيقن ولا فرق بين هذا وبين شهود سمعوا القاذف وهم يعلمون صدقه بلا خلاف في انهم لا يحل لهم ان يشهدوا بالقذف لان شهادتهم تءدي الي الظلم وكذلك من كان له اب فقتل ابوه انسانا ظلما واخذ ماله ظلما فان ولد المقتول الماخوذ ماله فقتل قاتل ابيه واخذ ماله الذي كان لابيه فانه لا يحل لولد هذا المستقاد منه ان يطلب المستقيد لا بدم ولا بما اخذ من ماله الذي اخذ منه بباطل واسترجعه منه بحق ومن فرق بين شء من هذه الوجوه فهو مخطء وقد قال تعالي: (كونوا قوامين بالقسط) الاية فحرم الله تعالي القيام بغير القسط وكذلك قال تعالي: (وتعاونوا علي البر والتقوي ولا تعاونوا علي الاثم والعدوان) وليس في الاثم والعدوان اكثر من ان يدري ان قاذفه لم يكذب ثم يطالبه بما يطالب به اهل الكذب وبالله تعالي التوفيق * (فان قالوا): انه قد اذاه (قلنا): نعم وليس في الاذي حد وانما فيه التعزير فقط *  مسالة  قال ابو محمد رحمه الله: من قذف زوجته فاخذ في اللعان فلما شرع فيه ومضي بعضه.
 اقله.
 او اكثره.
 او جله اعاد قذفها قبل ان تتم هي التعانها فلا بد له من ابتداء اللعان لان الله تعالي يقول: (والذين يرمون ازواجهم ولم يكن لهم شهداء الا انفسهم) الاية فلم يجعل الله تعالي الالتعان الا بعد رمي الزوجة فلا بد بعد رمي الزوجة بان ياتي بما امر الله تعالي به كما امر به وهي ما لم تتم التعانها بعد تمام التعانه زوجته كما كانت فهو في تجديد قذفها رامي زوجته فلا بد له من شهادة اربع شهادات والخامسة فان ابي ونكل حد المقذوف ولا بد فان رماها بزنا يتيقن انه كاذب فيه حد ولا لعان اصلا لان الله تعالي يقول: (وتعاونوا علي البر والتقوي ولا تعاونوا علي الاثم والعدوان) وليس من الاثم والعدوان اكثر من ان يكلف ان ياتي بايمان كاذبة يوقن من حضر او الحاكم انه فيها قاذف فهذا عون علي الاثم والعدوان وقال تعالي: (واذا حكمتم بين الناس ان تحكموا بالعدل) وهي مع ذلك امراته كما كانت ولا
 فرقة الا بعد ان يتم التعانهما علي ما ذكرنا، فلو رماها وايقن الحاكم انه صادق فلا يحل له الحكم باللعان ايضا لكن يقام الحد عليها وهي امراته كما كانت يرثها وترثه لما ذكرنا  من انه لا فرقة الا بعد التعانهما فصح بهذا انه لا لعان فيمن رمي امراته بزنا ممكن ان يكون فيه صادقا ويمكن ان يكون فيه كاذبا فاما اذا تيقن كذبه فلا يحل تعطيل واجب حد الله عنه ولا يحل عونه علي الايمان الكاذبة الاثمة ولا يحل امره بها وبالله تعالي التوفيق *  مسالة  من قذف جماعة او وجد يطا النساء الاجنبيات مرة بعد مرة.
 او وجد يسرق مرات.
 او رءي يشرب الخمر مرات فشهد بكل ذلك فاقام بينة علي صدقه في قذفه من قذف الا واحدا او صدقه جميعهم الا واحدا فعليه الحد في القذف ولا بد لان الحد في قذف الف او في قذف واحد حد واحد ولا مزيد علي ما قدمنا وكذلك لو اقام بينة علي ان جميع اولءك اللواتي وجد يطاهن اماءه الا واحد فعليه حد الزنا ولا بد لان الحد في الزنا بالف او في الزنا بواحدة حد واحد ولا مزيد علي ما قدمنا وكذلك لو اقام بينة علي كل ما سرق انه ماله اخذه حاش بعض ذلك فانه يقطع به ولا بد لان الحد في الف سرقة وفي سرقة واحدة حد واحد علي ما قدمنا، وكذلك لو اقام البينة علي ان كل ما شرب من ذلك كان في غير عقله او كان في ضرورة لعلاج او غيره الا مرة واحدة فعليه جلد الاربعين ولا بد لان الحد في شرب الف مرة وفي جرعة حد واحد كما قدمنا وبالله تعالي التوفيق *  كتاب المحاربين   مسالة  قال الله تعالي: (انما جزاء الذين يحاربون الله ورسوله) الاية * قال ابو محمد: فاختلف الناس من هو المحارب الذي يلزمه هذا الحكم؟
 فقالت طاءفة: المحارب المذكور في هذه الاية هم المشركون، روي عن ابن عباس وغيره كما نا يحيي بن عبد الرحمن بن مسعود نا احمد بن دحيم نا ابراهيم بن حماد نا اسمعيل ابن اسحاق نا محمد بن ابي بكر  هو المقدمي  نا يحيي.
 وخالد  هما القطان  وابو الحرث كلاهما عن اشعث عن الحسن البصري في قول الله تعالي.
 (انما جزاء الذين يحاربون الله ورسوله) الاية قال نزلت في اهل الشرك، وبه الي اسماعيل نا يحيي بن عبد الحميد الحماني نا هشيم عن جويبر عن الضحاك قال كان قوم بينهم وبين النبي صلي الله عليه وسلم ميثاق فنقضوا العهد وقطعوا السبيل وافسدوا في الارض فخير الله تعالي نبيه عليه السلام فيهم ان شاء ان يقتل وان شاء ان يصلب وان شاء قطع ايديهم وارجلهم من  خلاف، وبه الي اسماعيل نا محمد بن ابي بكر نا اشعث نا سفيان انه بلغه عن الضحاك ابن مزاحم في هذه الاية قال: نزلت في اهل الكتاب * وبه الي اسماعيل نا محمد بن عبيد.
 وابراهيم الهروي قال محمد: نا محمد بن ثور وقال ابراهيم: نا سفيان ثم اتفق محمد بن ثور.
 وسفيان كلاهما عن معمر عن قتادة.
 وعطاء الخراساني قالا جميعا في قول الله تعالي: (الا الذين تابوا من قبل ان تقدروا عليهم) هذه الاية لاهل الشرك فمن اصاب من المشركين شيءا من المسلمين وهو لهم حرب فاخذ مالا واصاب دما ثم تاب من قبل ان يقدر عليه اهدر عنه ما مضي، نا حمام القاضي نا ابن مفرج نا ابو علي الحسن ابن سعد نا ابو يعقوب الدبري نا عبد الرزاق عن ابن جريج قال.
 قال لي عطاء بن ابي رباح.
 وعبد الكريم: المحاربة شرك قال ابن جريج: واقول انا لا اعلم احدا يحارب النبي صلي الله عليه وسلم الا اشرك، وقالت طاءفة: هو المرتد كما نا ابو سعيد الجعفري نا محمد بن علي الادفوي نا ابو جعفر احمد بن محمد بن اسماعيل النحوي عن عبد الله ابن احمد بن عبد السلام عن ابي الازهر نا روح بن عبادة عن ابن جريج نا هشام ابن عروة عن ابيه قال: اذا خرج المسلم فشهر سلاحه ثم تلصص ثم جاء تاءبا اقيم
 عليه الحد ولو ترك لبطلت العقوبات الا ان يلحق ببلاد الشرك ثم ياتي تاءبا فتقبل منه، وقالت طاءفة: اللص ليس مسلما كما نا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب عن ابن لهيعة عن عبد الله بن ابي جعفر قال سالت نافعا مولي ابن عمر عن لص مسلم او كافر اتي مسلما واراد ان ياخذ ماله ويهريق دمه قال لو كنت انا امتنعت هذا الذي يستغيلني ليهريق دمي وياخذ مالي ليس بمسلم، وقالت طاءفة: كل لص فهو محارب كما نا حمام ابن مفرج نا الحسن بن سعد نا الدبري نا عبد الرزاق عن ابن جريج عن عبد الكريم او غيره عن الحسن البصري.
 وسعيد بن جبير قالا جميعا: من خرب فهو محارب * قال ابو محمد: الخارب اللص نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن سفيان الثوري عن جابر عن الشعبي قال: اللص محارب لله ولرسوله فاقتله فما اصابك فيه من شء من دمه فعلي، وقالت طاءفة: لا يكون المحارب الا من اخاف السبيل كما نا يحيي بن عبد الرحمن بن مسعود نا احمد بن دحيم نا ابراهيم بن حماد نا اسمعيل بن اسحق نا يحيي بن عبد الحميد الحماني نا سفيان بن عيينة عن عمار الدهني قال: جاء مسعر بن فدكي  وهو متنكر  حتي دخل علي بن طالب فما ترك اية من كتاب الله فيها تشديد الا ساله عنها وهو يقول له توبة قال وان كان مسعر بن فدكي  قال وان كان مسعر بن فدكي قال فقلت له فانا مسعر بن فدكي فامني قال انت امن قال وكان يقطع الطريق ويستحل الفروج، وبه الي اسماعيل بن اسحق نا محمد بن ابي بكر نا عمر ابن علي عن مجاهد عن الشعبي عن سعيد بن قيس الهمداني ان حارثة بن بدر التميمي كان عدوا لعلي وكان يهجوه فاتي الحسن.
 والحسين.
 وعبد الله بن جعفر رضي الله عنهم لياخذوا له امانا فابي علي ان يءمنه قال سعيد: فانطلقت الي علي فقلت: (ما جزاء الذين يحاربون الله ورسوله ويسعون في الارض فسادا) قال: (ان يقتلوا او يصلبوا
 او تقطع ايديهم وارجلهم من خلاف) الاية قلت الا ماذا؟ قال: (الا الذين تابوا من قبل ان تقدروا عليهم) قلت فان حارثة بن بدر قد تاب من قبل ان تقدر عليه قال: هو امن قال: فانطلقت بحارثة الي علي فامنه * حدثنا حمام نا ابن مفرج نا الحسن بن سعد نا ابو يعقوب الدبري نا عبد الرزاق عن معمر عن قتادة وعطاء الخراساني قالا جميعا في هذه الاية: (انما جزاء الذين يحاربون الله ورسوله) قال هذه الاية في اللص الذي يقطع الطريق فهو محارب * قال ابو محمد: ثم اختلف هءلاء، فقالت طاءفة: حيث ما قطع الطريق في مصر او غيره فهو محارب كما كتب الي ابو المرجي بن ذروان المصري نا ابو الحسن الرحبي نا مسلم الكاتب نا عبد الله بن احمد بن المغلس قال ذكر وكيع عن الحكم بن عطية قال سالت الحسن عن رجل ضرب رجلا بالسيف بالبصرة قال كانوا يقولون من شهر السلاح فهو محارب * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن ابن طاوس عن ابيه عن الزبير قال طاوس سمعته يقول: من رفع السلاح ثم وضعه محارب فدمه هدر، قال وكان طاوس يري هذا ايضا * حدثنا عبد الرحمن بن سلمة الكناني نا احمد بن خليل نا خالد بن سعد نا احمد بن خالد نا يحيي بن ايوب بن بادي العلاف فقيه اهل مصر نا سعيد بن ابي مريم نا سليمان ابن بلال ني علقمة بن ابي علقمة عن امه ان غلاما كان لباني فكان باني يضربه في اشياء يعاقبه فيها فكان الغلام يعادي سيده فباعه فاني فلقيه الغلام يوما ومع الغلام سيف يحمله وذلك في امرة سعيد بن العاصي فشهر الغلام السيف علي باني وتفلت به عليه فامسكه عنه الناس فدخل باني علي عاءشة فاخبرها بما فعل به العبد فقالت عاءشة سمعت رسول الله صلي الله عليه وسلم يقول: " من اشار بحديدة الي احد من المسلمين يريد قتله فقد وجب دمه " فذكر الحديث، وفيه ان الغلام قتل * حدثنا يحيي بن عبد الرحمن ابن مسعود نا احمد بن دحيم نا حماد بن ابراهيم نا اسماعيل بن اسحق نا علي بن عبد العزيز  المديني نا محمد بن علي بن مقدم عن سفيان بن حسين عن يعلي بن مسلم عن ابي الشعثاء  جابر ابن زيد  عن ابن عباس قال اذا تسور عليهم في بيوتهم بالسلاح قطعت يده ورجله، وبه الي اسماعيل نا نصر بن علي الجهضمي نا خالد بن الحرث عن اشعث عن الحسن قال اذا طرقك اللص بالليل فهو محارب، وبه الي اسماعيل نا محمد بن ابي بكر المقدمي نا محمد بن سوار عن سعيد بن ابي عروبة عن قتادة قال: اذا دخل عليك ومعه حديدة فهو محارب قال اسماعيل: ونا نصر بن علي نا حرب بن ميمون عن سعيد بن ابي عروبة عن قتادة قال: اذا طرقك اللص بالليل فهو محارب، وبهذا ياخذ الشافعي.
 وابو سليمان.
 واصحابهما، واختلف فيه قول مالك فمرة قال لا تكون المحاربة الا في الصحراء ومرة قال تكون المحاربة في الصحراء وفي الامصار، وقال سفيان: لا تكون المحاربة الا في الصحراء، وقال ابو حنيفة.
 واصحابه: لا تكون المحاربة في مدينة ولا في مصر ولا بقرب مدينة.
 ولا بقرب مصر ولا بين مدينتين ولا بين الكوفة والحيرة ثم روي عن ابي يوسف انه قال اذا كابروا اهل مدينة ليلا كانوا في حكم المحاربة، وقال ابو حنيفة من شهر علي اخر سلاحا ليلا او نهارا فقتل المشهور عليه عمدا فلا شء عليه فان شهر عليه عصا نهارا في مصر فقتله عمدا قتل به وان كان في الليل في مصر او في مدينة او في طريق في غير مدينة فلا شء علي القاتل * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان نطلب الحق من اقوالهم لنعلم الصواب فنتبعه بمن الله تعالي فنظرنا فيما تحتج به كل طاءفة لقولها فنظرنا فيما احتج به من قال ان المحارب لا يكون الا مشركا او مرتدا فوجدناهم يذكرون ما نا عبد الله ابن ربيع نا محمد بن معاوية نا احمد بن شعيب النساءي اخبرنا العباس بن محمد انا ابو عامر العقدي عن ابراهيم بن طهمان عن عبد العزيز بن رفيع عن عبيد بن عمير عن عاءشة ام المءمنين " ان رسول الله صلي الله عليه وسلم قال: لا يحل دم امرء مسلم الا باحدي ثلاث خصال زان محصن
 يرجم او رجل قتل متعمدا فيقتل او رجل يخرج من الاسلام فيحارب الله ورسوله فيقتل او يصلب او ينفي من الارض " وبما ذكره ابن جريج انفا من قوله ما نعلم احدا حارب رسول الله صلي الله عليه وسلم الا اشرك * قال ابو محمد رحمه الله: فنظرنا فيما احتجوا به من ذلك فوجدنا الخبر المذكور لا يصح لانه انفرد به ابراهيم بن طهمان وليس بالقوي، واما قول ابن جريج ما نعلم احدا حارب رسول الله صلي الله عليه وسلم الا اشرك فان محاربة الله تعالي ومحاربة رسوله عليه السلام تكون علي وجهين، احدهما من مستحل لذلك فهو كافر باجماع الامة كلها  لا خلاف في ذلك الا ممن لا يعتد به في الاسلام وتكون من فاسق عاص معترف بجرمه فلا يكون بذلك كافرا لكن كساءر الذنوب من الزنا والقتل والغصب وشرب الخمر واكل الخنزير والميتة والدم.
 وترك الصلاة.
 وترك الزكاة.
 وترك صوم شهر رمضان.
 وترك الحج فهذا لا يكون كافرا لما قد تقصيناه في كتاب الفصل وغيره، ويجمع الحجة في ذلك انه لو كان فاعل شء من هذه العظاءم كافرا بفعله ذلك لكان مرتدا بلا شك ولو كان بذلك مرتدا لوجب قتله لامر رسول الله صلي الله عليه وسلم بقتل من ارتد وبدل دينه وهذا لا يقوله مسلم * قال ابو محمد: (فان قال قاءل): اننا لا نسلم ان من عصي بغير الكفر لا يكون محاربا لله تعالي ولرسوله عليه السلام (قلنا له): وبالله تعالي التوفيق قال الله تعالي: (يا ايها الذين امنوا اتقوا الله وذروا ما بقي من الربا ان كنتم مءمنين فان لم تفعلوا فاذنوا بحرب من الله ورسوله) الاية كتب الي ابو المرجي بن ذروان قال: نا ابو الحسن المرحبي نا ابو مسلم الكاتب نا عبد الله بن احمد بن المغلس نا عبد الله بن احمد بن حنبل نا ابي نا حماد بن خالد الخياط نا عبد الواحد  مولي عروة  عن عروة عن عاءشة قالت: قال رسول الله صلي الله عليه وسلم: قال الله تعالي: " من اذي لي وليا
 فقد استحل محاربتي " وقال الله تعالي: (وان طاءفتان من المءمنين اقتتلوا فاصلحوا بينهما) الي قوله: (واصلحوا بين اخويكم) وقال رسول الله صلي الله عليه وسلم: " تقتل عمارا الفءة الباغية " فصح انه ليس كل عاص محاربا ولا كل محارب كافرا ثم نظرنا في ذلك ايضا فوجدنا الله تعالي قدحكم في المحارب ما ذكرنا من القتل او الصلب او قطع الايدي والارجل من خلاف او النفي من الارض واسقاط ذلك كله عنه بالتوبة قبل القدرة عليه فلو كان المحارب المامور فيه بهذه الاوامر كافرا لم يخل من ثلاثة اوجه لا رابع لها.
 اما ان يكون حربيا مذ كان، واما ان يكون ذميا فنقض الذمة وحارب فصار حربيا، واما ان يكون مسلما فارتد الي الكفر لابد من احد هذه الوجوه ضرورة ولا يمكن ولا يوجد غيرها فلو كان حربيا مذ كان فلا يختلف من الامة اثنان في انه ليس هذا حكم الحربيين وانما حكم الحربيين القتل في اللقاء كيف امكن حتي يسلموا او يعطوا الجزية عن يد وهم صاغرون ومن كان منهم كتابيا في قولنا وقول طواءف من الناس او من كان منهم من اي دين كان ما لم يكن عربيا في قول غيرنا او يءسر فيكون حكمه ضرب العنق فقط بلا خلاف كما قتل رسول الله صلي الله عليه وسلم عقبة ابن ابي معيط.
 والنضر بن الحرث.
 وبني قريظة، وغيرهم او يسترق.
 او يطلق  الي ارضه كما اطلق رسول الله صلي الله عليه وسلم ثمامة بن اثال الحنفي.
 وابا العاصي بن الربيع وغيرهما، او يفادي به كما قال الله تعالي: (فاذا لقيتم الذين كفروا فضرب الرقاب حتي اذا اثخنتموهم فشدوا الوثاق فاما منا بعد واما فداء حتي تضع الحرب اوزارها) او نطلقهم احرارا ذمة كما فعل رسول الله صلي الله عليه وسلم باهل خيبر، فهذه احكام الحربيين بنص القران.
 والسنن الثابتة.
 والاجماع المتيقن ولا خلاف في انه ليس الصلب ولا قطع الايدي والارجل ولا النفي من احكامهم فبطل ان يكون المحارب المذكور في الاية حربيا كافرا وان كان ذميا فنقض العهد فللناس فيه اقوال ثلاثة لا رابع لها: احدها
 انه ينتقل الي حكم الحربيين في كل ما ذكرنا، والثاني انه محارب حتي يقدر عليه فيرد الي ذمته كما كان ولا بد، والثالث انه لا يقبل منه الا الاسلام او السيف، وقد فرق بعض الناس بين الذمي ينقض العهد فيصير حربيا وبين الذمي يحارب فيكون له عندهم حكم المحارب المذكور في الاية لا حكم الحربي فصح بلا خلاف ان الذمي الناقض لذمته المنتقل الي حكم اهل الحرب ليس له حكم المحارب المذكور في الاية بلا خلاف، ويبين هذا قول الله تعالي: (فان نكثوا ايمانهم من بعد عهدهم وطعنوا في دينكم فقاتلوا اءمة الكفر) الي قوله: (لعلهم ينتهون) فامر الله تعالي بقتالهم اذا نكثوا عهدهم حتي ينتهوا وهذا عموم يوجب الانتهاء عن كل ما هم عليه من الضلال وهذا يقتضي ولابد ان لا يقبل منهم الا الاسلام وحده ولا يجوز ان يخص بقوله تعالي: (حتي ينتهوا) انتهاء دون انتهاء فيكون فاعل ذلك قاءلا علي الله تعالي ما لا علم له به وهذا حرام، قال الله تعالي: (وان تقولوا علي الله ما لا تعلمون) وان كان المحارب المذكور في الاية مرتدا عن اسلامه فقد بين رسول الله صلي الله عليه وسلم حكم المرتد بقوله: " من بدل دينه فاقتلوه " وبينه الله تعالي بقوله: (ان الذين كفروا بعد ايمانهم ثم ازدادوا كفرا لن تقبل توبتهم) فصح يقينا ان حكم المرتد الذي اوجب الله تعالي في القران وعلي لسان رسوله عليه السلام هو غير حكمه تعالي في المحارب فصح يقينا ان المحارب ليس مرتدا، وايضا فلا خلاف بين احد من الامة في ان حكم المرتد المقدور عليه ليس هو الصلب ولا قطع اليد والرجل ولا النفي من الارض فصح بكل ما ذكرنا ان المحارب ليس كافرا اصلا اذ ليس له شء من احكام الكفر ولا لاحد من الكفار حكم المحارب والرواية عن ابن عباس فيها الحسن بن واقد وليس بالقوي وهو ايضا من قول ابن عباس لا مسندا فاذ قد صح ما ذكرنا يقينا فقد ثبت بلا شك ان المحارب انما هو مسلم عاص فاذ هو كذلك فالواجب ان ننظر ما المعصية  التي بها وجب ان يكون محاربا وان يكون له حكم المحارب فنظرنا في جميع المعاصي من الزنا.
 والقذف.
 والسرقة.
 والغصب.
 والسحر.
 والظلم.
 وشرب الخمر.
 والمحرمات.
 او اكلها.
 والفرار من الزحف.
 والزنا.
 وغير ذلك فوجدنا جميع هذه المعاصي ليس منها شء جاء نص او اجماع في انه محارب فبطل ان يكون فاعل شء منها محاربا، وايضا فان جميع المعاصي التي ذكرنا والتي لم نذكر لا تخلو من احد وجهين لا ثالث لها، اما ان يكون فيها نص بحد محدود او لا يكون فيها نص بحد محدود فالتي فيها النص بحد محدود فهي الردة.
 والزنا.
 والقذف.
 والخمر.
 والسرقة.
 وجحد للعارية وليس لشء منها الحكم المذكور في الاية في المحارب فبطل ان يكون شء من هذه المعاصي محاربة وهذا ايضا اجماع متيقن، واما ما ليس فيه من الله تعالي حد محدود لا في القران ولا علي لسان رسول الله صلي الله عليه وسلم فلا يحل لاحد ان يلحقها بحد المحاربة فيكون شارعا في الدين ما لم ياذن به الله تعالي وهذا لا يحل بل قد قال رسول الله صلي الله عليه وسلم: " ان دماءكم واموالكم واعراضكم وابشاركم عليكم حرام " فوجب يقينا ان لا يستباح دم احد.
 ولا بشرته.
 ولا ماله.
 ولا عرضه الا بنص وارد فيه بعينه من قران او سنة عن رسول الله صلي الله عليه وسلم او اجماع متيقن من الصحابة رضي الله عنهم راجع الي توقيف رسول الله صلي الله عليه وسلم * فبطل ان يكون شء من المعاصي المذكورة هي المحاربة فاذ لا شك في هذا فلم يبق الا قاطع الطريق والباغي فهما جميعا مقاتلان والمقاتلة هي المحاربة في اللغة فنظرنا في ذلك فوجدنا الباغي قد ورد فيه النص بان يقاتل حتي يفء فقط فيصلح بينه وبين المبغي عليه فخرج الباغي عن ان يكون له حكم المحاربين فلم يبق الا قاطع الطريق ومخيف السبيل فهذا مفسد في الارض بيقين، وقد قال جمهور الناس انه هو المحارب المذكور في الاية ولم يبق غيره وقد بطل كما قدمنا ان يكون كافرا ولم يقل احد من اهل الاسلام في احد من اهل المعاصي انه المحارب المذكور في الاية الا قاطع الطريق المخيف فيها او في اللص فصح
 ان مخيف السبيل المفسد فيها هو المحارب المذكور في الاية بلا شك وبقي امر اللص فنظرنا فيه بعون الله تعالي فوجدناه ان دخل مستخفيا ليسرق.
 او ليزني.
 او ليقتل ففعل شيءا من ذلك مختفيا فانما هو سارق عليه ما علي السارق لا ما علي المحارب بلا خلاف او انما هو زان فعليه ما علي الزاني لا ما علي المحارب بلا خلاف او انما هو قاتل فعليه ما علي القاتل بنص القران والسنة فيمن قتل عمدا وان كان قد خالف في هذا قوم خلافا لا تقوم به حجة فان اشتهر امره ففر واخذ فليس محاربا لانه لم يحارب احدا وانما هو  عاص فقط ولا يكون عليه له حكم المحاربة لكن حكم من فعل منكرا فليس عليه الا التعزير وان دافع وكابر فهو محارب بلا شك لانه قد حارب واخاف السبيل وافسد في الارض فله حكم المحارب كما قال الشعبي.
 وغيره * قال ابو محمد رحمه الله: واما قول من قال: لا تكون المحاربة الا في الصحراء او من قال: لا تكون المحاربة في المدن الا ليلا فقولان فاسدان، ودعوتان ساقطتان بلا برهان لا من قران.
 ولا من سنة صحيحة.
 ولا سقيمة.
 ولا من اجماع.
 ولا من قول صاحب.
 ولا من قياس.
 ولا من راي سديد، وما يبعد ان يكون فيهم من هان عنده الكذب علي الامة كلها، فيقول: من حارب في الصحراء فقد صح عليه اسم محارب *  ومن كتاب المحاربين  قال ابو محمد رحمه الله: فان اعترض معترض في ان المحارب لا يكون الا من شهر السلاح بما ناه عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا اسحاق بن راهويه ارنا الفضل بن موسي نا معمر عن عبد الله بن طاوس عن ابن الزبير عن رسول الله صلي الله عليه وسلم قال: " من شهر سيفه ثم وضعه فدمه هدر " قال اسحاق: ارناه عبد الرزاق بهذا الاسناد مثله ولم يرفعه يريد انه جعله من كلام ابن الزبير قال ابن شعيب: وانا ابو داود نا ابو عاصم عن ابن جريج عن ابن طاوس عن ابيه عن ابن الزبير قال: من رفع السلاح
 ثم وضعه فدمه هدر * حدثنا عبد الله بن ربيع نا محمد بن معاوية اخبرني احمد بن شعيب انا احمد بن عمرو بن السرح اخبرني ابن وهب انا مالك.
 واسامة بن زيد.
 ويونس ابن يزيد ان نافعا اخبرهم عن عبد الله بن عمر ان رسول الله صلي الله عليه وسلم قال: " من حمل علينا السلاح فليس منا " * قال ابو محمد رحمه الله: فهذا كله حق واثار صحاح لا يضرها ايقاف من اوقفها الا انه لا حجة فيها لمن لم ير المحارب الا من حارب بسلاح لان رسول الله صلي الله عليه وسلم انما ذكر في هذين الاثرين من وضع سيفه وشهر سلاحه فقط وسكت عما عدا ذلك فيهما ولم يقل عليه السلام ان لا محارب الا من هذه صفته فوجب من هذين الاثرين حكم من حمل السلاح وبقي حكم من لم يحمل السلاح ان يطلب في غيرهما ففعلنا فوجدنا ما ناه عبد الله بن يوسف نا احمد بن فتح نا عبد الوهاب بن عيسي نا احمد بن محمد نا احمد ابن علي نا مسلم بن الحجاج نا زهير بن حرب ثنا عبد الرحمن بن مهدي نا مهدي ثنا ابن ميمون عن غيلان بن جرير عن زياد بن رياح عن ابي هريرة قال: قال رسول الله  صلي الله عليه وسلم في حديثه: " ومن خرج من امتي علي امتي يضرب برها وفاجرها لا يتحاشي من مءمنها ولا يفي بذي عهدها فليس مني " فقد عم رسول الله صلي الله عليه وسلم كما تسمع الضرب ولم يقل بسلاح ولا غيره فصح ان كل حرابة بسلاح او بلا سلاح فسواء قال: فوجب بما ذكرنا ان المحارب هو المكابر المخيف لاهل الطريق المفسد في سبيل الارض سواء بسلاح.
 او بلا سلاح اصلا سواء ليلا.
 او نهارا في مصر.
 او في فلاة.
 او في قصر الخليفة.
 او الجامع، سواء قدموا علي انفسهم اماما.
 او لم يقدموا سوي الخليفة نفسه فعل ذلك بجنده او غيره منقطعين في الصحراء.
 او اهل قرية سكانا في دورهم او اهل حصن كذلك.
 او اهل مدينة عظيمة.
 او غير عظيمة كذلك واحدا كان او اكثر كل من حارب المار واخاف السبيل بقتل نفس.
 او اخذ
 مال.
 او لجراحة.
 او لانتهاك فرج فهو محارب عليه وعليهم  كثروا او قلوا  حكم المحاربين المنصوص في الاية لان الله تعالي لم يخص شيءا من هذه الوجوه اذ عهد الينا بحكم المحاربين (وما كان ربك نسيا) ونحن نشهد بشهادة الله تعالي ان الله سبحانه لو اراد ان يخص بعض هذه الوجوه لما اغفل شيءا من ذلك.
 ولا نسيه ولا اعنتنا بتعمد ترك ذكره حتي يبينه لنا غيره بالتكهن والظن الكاذب *  مسالة قال ابو محمد رحمه الله: قال قوم يجب ان يعطي المحاربون الشء الذي لا يجحف بالمقطوع عليهم وراوا ذلك في جميع الاموال لغير المحاربين * قال ابو محمد رحمه الله: والذي نقول: وبالله تعالي نتايد انه لا يجوز ان يعطوا علي هذا الوجه شيءا قل ام كثر سواء محاربا كان او شيطانا لقول الله تعالي (وتعاونوا علي البر والتقوي ولا تعاونوا علي الاثم والعدوان)، ولقوله تعالي: (كونوا قوامين بالقسط شهداء لله ولو علي انفسكم) *  مسالة قال ابو محمد رحمه الله فلا يخلو اخذ المال بالوجه المذكور من الظلم والغلبة بغير حق من احد وجهين لا ثالث لهما.
 اما ان يكون برا وتقوي.
 او يكون اثما وعدوانا ولا خلاف بين احد من الامة في انه ليس برا ولا تقوي ولكنه اثم وعدوان بلا خلاف والتعاون علي الاثم والعدوان حرام لا يحل * حدثنا عبد الله بن يوسف نا احمد بن فتح نا عبد الوهاب بن عيسي نا احمد بن محمد نا احمد بن علي نا مسلم بن الحجاج نا ابو كريب محمد بن العلاء نا خالد  يعني ابن مخلد  نا محمد بن جعفر عن العلاء بن عبد الرحمن عن ابيه عن ابي هريرة قال: " جاء رجل الي رسول الله صلي الله عليه وسلم فقال: يا رسول الله ارايت ان جاء رجل يريد اخذ مالي؟ قال:

 فلا تعطه مالك قال: ارايت ان قاتلني؟ قال: قاتله قال: ارايت ان قتلني؟ قال: فانت شهيد قال: ارايت ان قتلته؟ قال: هو في النار "، وبه الي مسلم نا الحسن بن
 علي الحلواني.
 ومحمد بن نافع قالا جميعا: نا عبد الرزاق ارنا ابن جريج انا سليمان الاحوال ان ثابتا  مولي عمر بن عبد الرحمن  اخبره انه لما كان بين عبد الله بن عمرو ابن العاصي وبين عنبسة بن ابي سفيان ما كان تيسروا للقتال ركب خالد بن العاصي الي عبد الله بن عمرو بن العاصي فوعظه خالد فقال عبد الله بن عمرو: اما علمت ان رسول الله صلي الله عليه وسلم قال: " من قتل دون ماله فهو شهيد " * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا عمرو بن علي نا عبد الرحمن ابن مهدي نا ابراهيم بن سعد عن ابيه  هو سعد بن ابراهيم بن عبد الرحمن بن عوف  عن ابي عبيدة بن محمد بن عمار بن ياسر عن طلحة بن عبد الله بن عوف عن سعيد بن زيد عن النبي صلي الله عليه وسلم قال: " من قاتل دون ماله فقتل فهو شهيد ومن قاتل دون دمه فهو شهيد ومن قاتل دون اهله فهو شهيد " * وبه الي احمد بن شعيب انا محمد بن رافع.
 ومحمد بن اسماعيل بن ابراهيم قال: نا سليمان  هو ابن داود الهاشمي  نا ابراهيم  هو ابن سعد ابن ابراهيم  عن ابيه عن ابي عبيدة بن محمد بن عمار بن ياسر عن طلحة بن عبد الله بن عوف عن سعيد بن زيد قال: قال رسول الله صلي الله عليه وسلم: " من قتل دون ماله فهو شهيد ومن قتل دون اهله فهو شهيد ومن قتل دون دينه فهو شهيد ومن قتل دون دمه فهو شهيد "، وبه الي احمد بن شعيب انا القاسم بن زكريا بن دينار نا سعيد بن عمرو الاشعثي نا عمرو  هو ابن القاسم  عن مطرف  هو ابن ابي طريف  عن سوادة  هو ابن ابي الجعد  عن ابي جعفر قال: كنت جالسا عند سويد بن مقرن قال: قال رسول الله صلي الله عليه وسلم: " من قتل دون مظلمته فهو شهيد " نا عبد الرحمن بن عبد الله بن خالد نا ابراهيم بن احمد البلخي نا الفربري نا البخاري نا محمد بن عبد الله بن المثني الانصاري نا ابي نا ثمامة بن عبد الله بن انس " ان انسا حدثه ان ابا بكر كتب له هذا الكتاب لما وجهه الي البحرين بسم الله الرحمن الرحيم هذه فريضة الصدقة التي فرض رسول الله صلي الله عليه وسلم وسلم علي المسلمين والتي امر الله عزوجل بها رسوله صلي الله عليه وسلم فمن سءلها من المسلمين علي وجهها فليعطها ومن سءل فوقها فلا يعط "
 وذكر الحديث * قال ابو محمد رحمه الله: فهذا رسول الله صلي الله عليه وسلم يامر من سءل ماله بغير حق ان لا يعطيه وامر ان يقاتل دونه فيقتل مصيبا سديدا او يقتل بريءا شهيدا ولم يخص عليه السلام مالا من مال، وهذا ابو بكر الصديق.
 وعبد الله بن عمرو رضي الله عنهما  يريان السلطان في ذلك وغير السلطان سواء وبالله تعالي التوفيق *  ذكر ما قيل في اية المحاربة   مسالة قال علي: قال قوم: اية المحاربة ناسخة لفعل رسول الله صلي الله عليه وسلم بالعرنيين ونهي له عن فعله بهم واحتجوا في ذلك بما نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب اخبرني عمرو بن عثمان بن سعيد بن كثير بن دينار عن الوليد عن الاوزاعي عن يحيي بن ابي كثير عن ابي قلابة عن انس بن مالك " ان نفرا من عكل قدموا علي رسول الله صلي الله عليه وسلم فاسلموا فاجتووا المدينة فامرهم النبي صلي الله عليه وسلم ان ياتوا ابل الصدقة فيشربوا من ابوالها والبانها ففعلوا فقتلوا راعيها واستاقوها فبعث النبي صلي الله عليه وسلم في طلبهم قافة فاتي بهم فقطع ايديهم وارجلهم وسمل اعينهم ولم يحسمهم وتركهم حتي ماتوا فانزل الله تعالي: (انما جزاء الذين يحاربون الله ورسوله) الاية * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا احمد بن عمرو بن السرح انا ابن وهب اخبرني الليث بن سعد عن ابن عجلان عن ابي الزناذ قال: ان رسول الله صلي الله عليه وسلم لما قطع الذين سرقوا لقاحه وسمل اعينهم بالنار عاتبه الله تعالي في ذلك فانزل الله تعالي (انما جزاء الذين يحاربون الله ورسوله) الاية * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن المثني نا عبد الصمد  هو ابن عبد الوارث بن سعيد التنوري  نا هشام  هو الدستواءي  عن قتادة عن انس قال: كان رسول الله صلي الله عليه وسلم يحث في خطبته علي الصدقة وينهي عن المثلة *
 قال ابو محمد رحمه الله: كل هذا لا حجة لهم فيه ولا يجوز ان يقال في شء من فعل رسول الله صلي الله عليه وسلم وقوله انه منسوخ الا بيقين مقطوع علي صحته، واما بالظن الذي هو اكذب الحديث فلا فنقول: وبالله تعالي التوفيق: اما الحديث الذي صدرنا به من طريق ابي قلابة عن انس فليس فيه دليل علي نسخ اصلا لا بنص ولا بمعني وانما فيه ان رسول الله صلي الله عليه وسلم قطع ايدي العرنيين وارجلهم ولم يحسمهم وسمل اعينهم وتركهم حتي ماتوا فانزل الله تعالي اية المحاربة وهذا ظاهر ان نزول اية المحاربة ابتداء حكم كساءر القران في نزوله شيءا بعد شء او تصويبا لفعله عليه السلام بهم لان الاية موافقة لفعله عليه السلام في قطع ايديهم وارجلهم وزاءدة علي ذلك تخييرا في القتل او الصلب.
 او النفي وكان ما زاده رسول الله صلي الله عليه وسلم علي القطع من السمل وتركهم لم يحسمهم حتي ماتوا قصاصا بما فعلوا بالرعاء كما نا عبد الله بن ربيع نا محمد بن معاوية  نا احمد بن شعيب انا الفضل بن سهل الاعرج  مرزوقي ثقة  نا يحيي بن غيلان  ثقة مامون  نا يزيد بن زريع عن سليمان التيمي عن انس بن مالك قال: انما سمل رسول الله صلي الله عليه وسلم اعين اولءك العرنيين لانهم سملوا اعين الرعاء وقد ذكر في الحديث الذي اوردنا انهم قتلوا الرعاء فصح ما قلناه من ان اولءك العرنيين اجتمعت عليهم حقوق.
 منها المحاربة.
 ومنها سملهم اعين الرعاء.
 وقتلهم اياهم، ومنها الردة فوجب عليهم اقامة كل ذلك اذ ليس شء من هذه الحدود اوجب بالاقامة عليهم من ساءرها ومن اسقط بعضها لبعض فقد اخطا.
 وحكم بالباطل.
 وقال بلا برهان.
 وخالف فعل رسول الله صلي الله عليه وسلم.
 وترك امر الله تعالي بالقصاص في العدوان بما امره به في المحاربة فقطعهم رسول الله صلي الله عليه وسلم للمحاربة.
 وسملهم للقصاص.
 وتركهم كذلك حتي ماتوا يستسقون فلا يسقون حتي ماتوا لانهم كذلك قتلواهم الرعاء فارتفع الاشكال والحمد لله كثيرا * واما حديث ابي الزناد فمرسل ولا حجة في مرسل ولفظه منكر جدا لان فيه ان رسول الله صلي الله عليه وسلم عاتبه
 ربه في اية المحاربة وما يسمع فيها عتاب اصلا لان لفظ العتاب انما هو مثل قوله تعالي: (عفا الله عنك لم اذنت لهم) ومثل قوله تعالي: (عبس وتولي ان جاءه الاعمي) الايات، ومثل قوله تعالي: (لو لا كتاب من الله سبق لمسكم فيما اخذتم عذاب عظيم)، واما اية المحاربة فليس فيها اثر للمعاتبة، واما حديث قتادة عن انس في الحث علي الصدقة والنهي عن المثلة فحق وليس هذا مما نحن فيه في ورد ولا صدر وانما يحتج بمثل هذا من يستسهل الكذب علي رسول الله صلي الله عليه وسلم انه مثل بالعرنيين وحاش لله من هذا بل هذا نصر لمذهبهم في ان من قتل بشء ما لم يجز ان يقتل بمثله لانه مثلة وهم يرون علي من جدع انف انسان وفقا عيني اخر.
 وقطع شفتي ثالث.
 وقلع اضراس رابع.
 وقطع اذني خامس ان يفعل ذلك به كله ويترك فهل في المثلة اعظم من هذا لو عقلوا عن اصولهم الفاسدة؟ وحاش لله ان يكون شء امر الله تعالي به او فعله رسول الله صلي الله عليه وسلم مثلة انما المثلة ماكان ابتداء فيما لا نص فيه، واما ما كان قصاصا او حدا كالرجم للمحصن، وكالقطع او الصلب للمحارب فليس مثلة وبالله تعالي التوفيق * وقد روينا من طريق مسلم ما ناه عبد الله بن يوسف نا احمد بن فتح نا عبد الوهاب بن عيسي نا احمد بن محمد نا احمد بن علي نا مسلم ابن الحجاج نا يحيي بن يحيي التميمي ارنا هشيم عن عبد العزيز بن صهيب.
 وحميد كلاهما عن انس بن مالك: " ان ناسا من عرينة قدموا علي رسول الله صلي الله عليه وسلم المدينة فاجتووها فقال لهم رسول الله صلي الله عليه وسلم: ان شءتم ان تخرجوا الي ابل الصدقة فتشربوا من البانها وابوالها ففعلوا فصحوا ثم مالوا علي الرعاء فقتلوهم وارتدوا عن الاسلام وساقوا ذود رسول الله  صلي الله عليه وسلم فبلغ ذلك النبي صلي الله عليه وسلم فبعث في اثارهم فاتي بهم فقطع ايديهم وارجلهم وسمل اعينهم وتركهم في الحرة حتي ماتوا " * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا علي بن حجر نا اسماعيل بن علية نا حميد عن انس قال: " قدم علي النبي صلي الله عليه وسلم ناس من عرينة فقال لهم رسول الله صلي الله عليه وسلم: لو خرجتم الي ذودنا فكنتم فيها فشربتم من البانها
 وابوالها ففعلوا فلما صحوا قاموا الي راعي رسول الله صلي الله عليه وسلم فقتلوه ورجعوا كفارا واستاقوا ذود رسول الله صلي الله عليه وسلم فارسل في طلبهم فاتي بهم فقطع ايديهم وارجلهم وسمل اعينهم " * قال ابو محمد رحمه الله: فهذه كلها اثار في غاية الصحة وبالله تعالي التوفيق *  المحارب يقتل   مسالة هل لولي المقتول في ذلك حكم ام لا؟ * قال ابو محمد رحمه الله: نا حمام نا ابن مفرج نا الحسن بن سعد نا الدبري نا عبد الرزاق عن ابن جريج اخبرني عبد العزيز بن عمر بن عبد العزيز قال: ان في كتاب لعمر بن الخطاب والسلطان ولي من حارب الدين وان قتل اباه.
 او اخاه فليس الي طالب الدم من امر من حارب الدين وسعي في الارض فسادا شء، وقال ابن جريج: وقال لي سليمان بن موسي مثل هذا سواء سواء حرفا حرفا، وبه الي عبد الرزاق عن معمر عن الزهري قال: عقوبة المحارب الي السلطان لا تجوز عقوبة ولي الدم ذلك الي الامام قال وهو قول ابي حنيفة.
 ومالك.
 والشافعي.
 واحمد.
 وابي سليمان.
 واصحابهم * قال ابو محمد رحمه الله: وبهذا نقول لان رسول الله صلي الله عليه وسلم قال في الخبرين اللذين رويناهما من طريق ابن عباس ذكرناهما في كتاب الحج.
 وكتاب الصيام.
 وباب وجوب قضاء الحج الواجب.
 وقضاء الصيام الواجب عن الميت: " اقضوا الله فهو احق بالوفاء دين الله احق ان يقضي " وبقوله عليه السلام في حديث بريدة: " كتاب الله احق وشرط الله اوثق " * قال ابو محمد رحمه الله: فلما اجتمع حقان احدهما لله، والثاني لولي المقتول كان حق الله تعالي احق بالقضاء، ودينه اولي بالاداء، وشرطه المقدم في الوفاء علي حقوق الناس فان قتله الامام او صلبه للمحاربة كان للولي اخذ الدية في مال المقتول لان حقه في القود قد سقط فبقي حقه في الدية او العفو عنها علي ما بينا في كتاب القصاص  ولله الحمد، فان اختار الامام قطع يد المحارب ورجله او نفيه انفذ ذلك وكان حينءذ للولي الخيار في قتله.
 او الدية.
 او المفاداة.
 او العفو لان الامام قد استوفي ما جعل الله تعالي له الخيار فيه وليس ههنا شء يسقط حق الولي اذ ممكن له ان يستوفي حقه بعد استيفاء حق الله تعالي، ولقد تناقض ههنا الحنيفيون.
 والمالكيون اسمج تناقض لانهم لا يختلفون في الحج.
 والصيام.
 والزكاة.
 والكفارات.
 والنذور بان حقوق الناس اولي من حقوق الله تعالي.
 وان ديون الغرماء اوجب في القضاء من ديون الله تعالي.
 وان شروط الناس مقدمة في الوفاء علي شروط الله تعالي وقد تركوا ههنا هذه الاقوال الفاسدة، وقدموا حقوق الله تعالي علي حقوق الناس وبالله تعالي التوفيق *  مسالة  (مانع الزكاة) قال ابو محمد رحمه الله: نا احمد بن محمد ابن الجسور نا احمد بن الفضل الدينوري نا ابو جعفر  محمد بن جرير الطبري  نا الحرث انا محمد بن سعد نا محمد بن عمر الواقدي ني عبد الرحمن بن عبد العزيز عن حكيم بن حكيم ابن عباد بن حنيف عن فاطمة بنت خشاف السلمية عن عبد الرحمن بن الربيع الطفري وكانت له صحبة قال: " بعث رسول الله صلي الله عليه وسلم الي رجل من اشجع تءخذ صدقته فجاءه الرسول فرده فرجع الي النبي صلي الله عليه وسلم فاخبره فقال رسول الله صلي الله عليه وسلم: اذهب اليه فان لم يعط صدقته فاضرب عنقه " قال عبد الرحمن: فقلت لحكيم ما اري ابا بكر قاتل اهل الردة الا علي هذا الحديث؟ فقال: اجل * قال ابو محمد رحمه الله: هذا حديث موضوع مملوء افات من مجهولين.
 ومتهمين وحكم مانع الزكاة انما هو ان تءخذ منه احب ام كره فان مانع دونها فهو محارب فان كذب بها فهو مرتد فان غيبها ولم يمانع دونها فهو ات منكرا فواجب تاديبه او ضربه حتي يحضرها او يموت قتيل الله تعالي الي لعنة الله كما قال رسول الله صلي الله عليه وسلم: " من راي منكم منكرا فليغيره بيده ان استطاع " وهذا منكر ففرض علي
 من استطاع ان يغيره كما ذكرنا وبالله تعالي التوفيق *  مسالة  هل يبادر اللص ام يناشد؟  قال ابو محمد رحمه الله: نا احمد بن محمد بن الجسور نا احمد بن الفضل الدينوري نا محمد بن جرير الطبري نا محمد ابن بشار.
 ومحمد بن المثني قالا جميعا: نا ابو عامر العقدي نا عبد العزيز بن المطلب عن اخيه الحكم بن المطلب عن ابيه  هو المطلب بن حنطب  بن فهيذ بن مطرف الغفاري " ان النبي صلي الله عليه وسلم ساله ساءل ان عدا علي عاد فامره ان ينهاه ثلاث مرات قال: فان ابي علي؟ فامره بقتاله وقال عليه السلام: ان قتلك فانت في الجنة وان قتلته فهو في النار "

 حدثنا يوسف بن عبد البر النمري نا عبد الله بن محمد بن يوسف بن احمد الضبي نا العقيلي نا جدي نا يعلي بن اسد العمي نا محمد بن كثير السلمي  هو القصاب  عن يونس بن عبيد عن محمد بن سيرين عن عبادة بن الصامت قال: قال رسول الله صلي الله عليه وسلم: " الدار حرم فمن دخل عليك حرمك فاقتله " * قال ابو محمد رحمه الله: الحديث الاول ليس بالقوي ففيه الحكم بن المطلب ولا يعرف حاله، والخبر الثاني فيه محمد بن كثير القصاب  وهو ذاهب الحديث وليس بشء * قال ابو محمد رحمه الله: والمعتمد عليه في الاخبار التي صدرنا بها في كتابنا في المحاربين من اباحة القتل دون المال وساءر المظالم لكن ان كان علي القوم المقطوع عليهم او الواحد المقطوع عليه او المدخول عليه منزله في المصر ليلا او نهارا في اخذ ماله او في طلب زنا او غير ذلك مهلة فالملشدة فعل حسن لقول الله تعالي: (ادع الي سبيل ربك بالحكمة والموعظة الحسنة وجادلهم بالتي هي احسن) فان لم يكن في الامر مهلة ففرض علي المظلوم ان يبادر الي كل ما يمكنه به الدفاع عن نفسه وان كان في ذلك اتلاف نفس اللص والقاطع من اول وهلة فان كان علي يقين من انه ان ضربه ولم يقتله ارتدع فحرام عليه قتله فان لم يكن علي يقين من هذا فقد صح اليقين بان مباحا له الدفع والمقاتلة فلا شء عليه ان قتله من اول ضربة او بعدها قصدا الي مقتله او الي غير مقتله
 لان الله تعالي قد اباح له المقاتلة والمدافعة قاتلا ومقتولا وبالله تعالي التوفيق، فاما لو كان اللص من الضعف بحيث لا يدافع اصلا او يدافع دفاعا يوقن معه انه لا يقدر علي قتل صاحب الدار فقتله صاحب المنزل فعليه القود لانه قادر علي منعه بغير القتل فهو متعد * حدثنا محمد بن سعيد بن نبات نا احمد بن عبد البصير نا قاسم بن اصبغ نا محمد بن عبد السلام الخشني نا محمد بن المثني نا موسي بن اسماعيل نا سفيان الثوري عن مسلم الضبي قال: قال ابراهيم النخعي: ان خشيت ان يبتدرك اللص فابدره * قال ابو محمد رحمه الله: وهذا نظير قولنا والحمد لله رب العالمين * قال ابو محمد رحمه الله: نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر قال: قلت للزهري ان هشام بن عروة اخبرني ان عمر بن عبد العزيز  اذ هو عامل علي المدينة في زمان الوليد بن عبد الملك  قطع يد رجل ضرب اخر بالسيف فضحك الزهري وقال لي او هذا مما يءخذ به؟ انما كتب الوليد بن عبد الملك الي عمر بن عبد العزيز ان يقطع يد رجل ضرب اخر بالسيف قال الزهري: فدعاني عمر بن عبد العزيز واستفتاني في قطعه فقلت له اري ان يصدقه الحديث ويكتب اليه ان صفوان بن المعطل ضرب حسان ابن ثابت بالسيف علي عهد رسول الله صلي الله عليه وسلم فلم يقطع النبي عليه السلام يده وضرب فلان فلانا بالسيف زمن مروان فلم يقطع مروان يده وكتب اليه عمر بذلك فمكث  حينا لا ياتيه رجع كتابه ثم كتب اليه الوليد ان حسانا كان يهجو صفوان ويذكر امه ونساء اخر قد قاله الزهري: وذكرت ان مروان لم يقطع يده ولكن عبد الملك قطع يده فاقطع يده.
 قال الزهري فقطع عمر يده وكان من ذنوبه التي كان يستغفر الله تعالي منها * قال ابو محمد رحمه الله: ان كان رفع السيف علي سبيل اخافة الطريق فهو محارب عليه حكم المحارب، وان كان لعدوان فقط لا قطع طريق فعليه القصاص فقط الي المجروح فان لم يكن هنالك جرح فلا شء الا التعزير فقط وبالله تعالي
 التوفيق *  مسالة  قطع الطريق من المسلم علي المسلم وعلي الذمي سواء، وذلك لان الله تعالي انما نص علي حكم من حاربه وحارب رسوله صلي الله عليه وسلم او سعي في الارض فسادا ولم يخص بذلك مسلم من ذمي (وما كان ربك نسيا) وليس هذا قتلا للمسلم بالذمي ومعاذ الله من هذا لكنه قتل له بالحرابة ويمضي دم الذمي هدرا، وكذلك القطع علي امراة.
 او صبي.
 او مجنون كل ذلك محاربة صحيحة يستحق بها ما ذكرنا من حكم المحاربة، واما الذمي ان حارب فليس محاربا لكنه ناقض للذمة لانه قد فارق الصغار فلا يجوز الا قتله ولابد او يسلم فلا يجب عليه شء اصلا في كل ما اصاب من دم.
 او فرج.
 او مال الا ما وجد في يده فقط لانه حربي لا محارب وبالله تعالي التوفيق، واما المسلم يرتد فيحارب فعليه احكام المحارب كلها علي ما ذكرنا من فعل رسول الله صلي الله عليه وسلم بالعرنيين الذين اقتص منهم قودا.
 واقام عليهم حكم المحاربة وكانوا مرتدين محاربين متعدين وبالله تعالي التوفيق *  مسالة  (صفة الصلب للمحارب) قال ابو محمد رحمه الله: اختلف الناس في صفة الصلب الذي امر الله تعالي به في المحارب فقال ابو حنيفة: والشافعي: يضرب عنقه بالسيف ثم يصلب مقتولا  زاد الشافعي  ويترك ثلاثة ايام ثم ينزل فيدفن، وقال الليث بن سعد.
 والاوزاعي.
 وابو يوسف: يصلب حيا ثم يطعن بالحربة حتي يموت.
 وقال بعض اصحابنا الظاهرين: يصلب حيا ويترك حتي يموت وييبس كله ويجف فاذا يبس وجف انزل فغسل وكفن وصلي عليه ودفن * قال ابو محمد رحمه الله: فلما اختلفوا وجب ان ننظر فيما احتجت به كل طاءفة لقولها لنعلم الحق من ذلك فنتبعه بعون الله تعالي ومنه فنظرنا في ذلك فوجدنا  من قال يقتل ثم يصلب مقتولا يحتجون بما ذكرناه قبل في كتاب الدماء من ديواننا كيف يكون القود من قول رسول الله صلي الله عليه وسلم: " ان الله كتب الاحسان علي كل شء فاذا قتلتم فاحسنوا القتلة " ومن قوله عليه السلام: " اعف الناس قتلة اهل الايمان "، ومن نهيه عليه السلام ان يتخذ شيءا فيه الروح غرضا ولعنه عليه السلام من فعل ذلك، وقد ذكرنا هذه الاحاديث هنالك باسانيدها فاغني عن اعادتها، وقالوا طعنه علي الخشبة ليس قتلة حسنة ولا عفيفة، وهو اتخاذ الروح غرضا فهذا لا يحل ونظرنا فيما احتج به من راي قتله مصلوبا فوجدناهم يقولون.
 ان الله تعالي انما امرنا بالقتل عقوبة وخزيا للمحارب في الدنيا فاذ ذلك كذلك فالعقوبة والخزي لا يقعان علي ميت وانما خزي الميت في الاخرة لا في الدنيا فلما كان ذلك كذلك بطل ان يصلب بعد قتله ردعا لغيره فعارضهم الاولون بان قالوا: يصلب بعد قتله ردعا لغيره فعارضهم هءلاء بان قالوا ليس ردعا وانما هو عقوبة للفاعل وخزي بنص القران وفي صلبه ثم قتله اعظم الردع ايضا * قال ابو محمد رحمه الله: هذا كل ما احتجب به الطاءفتان معا والتي احتجت به كلتا الطاءفتين حق الا انه انتجوا منه ما لا توجبه القضايا الصحاح التي ذكروا فمالوا عن شوارع الحق الي زواءغ التلبيس والخطا * قال ابو محمد رحمه الله: وذلك علي ما نبين ان شاء الله تعالي فنقول: ان قول رسول الله صلي الله عليه وسلم محمد: " ان اعف الناس قتلة اهل الايمان "، " واذا قتلتم فاحسنوا القتلة "، " ولعن الله من اتخذ شيءا فيه الروح غرضا " والنهي عن ذلك فهو كله حق كما قاله رسول الله صلي الله عليه وسلم: وهو كله مانع من ان يقتل بعد الصلب برمح او برمي سهام.
 او بغير ذلك كما ذكرنا وانما في هذه الاحاديث وجوب الفرض في احسان قتله ان اختار الامام قتله فقط وليس في شء من هذه الاخبار وجوب صلبه بعد القتل ولا اباحة صلبه بعد القتل البتة لا بنص ولا باشارة، فاما احسان
 القتل فحق، واما صلبه بعد القتل فدعوي فاسدة ليس في شء من الاثار التي ذكروا ولا غيرها فبطل بيقين لا شك فيه احتجاجهم بهذه الاخبار في النكتة التي عليها تكلموا وهي الصلب بعد القتل او قبله وسقط قولهم اذ تعري من البرهان * قال ابو محمد رحمه الله: ثم نظرنا فيما احتجت به الطاءفة الثانية الموجبة قتله بعد الصلب فوجدناهم يقولون ان الصلب عقوبة وخزي في الدنيا كما قال الله تعالي وان الميت لا يخزي في الدنيا بعد موته ولا يعاقب بعد موته قولا صحيحا لا شك فيه، ووجدناهم  يقولون ان الردع يكون بصلبه حيا قولا ايضا خارجا عن اصولهم الا انه ليس في شء من ذلك كله ايجاب قتله بعد الصلب كما قالوا ولا اباحة ذلك ايضا وانما في كل ما قالوه ايجاب الصلب فقط فاقحموا فيه القتل بعد الصلب جريا علي عادتهم في التلبيس والزيادة بالدعاوي الكاذبة علي النصوص ما ليس فيها فبطل قولهم ايضا لما ذكرنا * قال ابو محمد رحمه الله: فلما بطل القولان مما وجب الرد الي القران والسنة كما افترض الله تعالي علينا بقوله عزوجل: (فان تنازعتم في شء فردوه الي الله والرسول) ففعلنا فوجدنا الله تعالي قد قال: (انما جزاء الذين يحاربون الله ورسوله) الاية كلها فصح يقينا ان الله تعالي لم يوجب قط عليهم حكمين من هذه الاحكام ولا اباح ان يجمع عليهم خزيان من هذه الاخزاء في الدنيا وانما اوجب علي المحارب احدها لا كلها.
 ولا اثنين منها.
 ولا ثلاثة فصح بهذا يقينا لا شك فيه انه ان قتل فقد حرم صلبه وقطعه ونفيه وانه ان قطع فقد حرم قتله وصلبه ونفيه وانه ان نفي فقد حرم قتله وصلبه وقطعه، وانه ان صلب فقد حرم قتله وقطعه ونفيه لا يجوز البتة غير هذا فحرم بنص القران صلبه ان قتل وحرم ايضا بنص القران قتله ان صلب، وحرم هذا الوجه ايضا بسنن رسول الله صلي الله عليه وسلم التي ذكرنا " من ان اعف الناس قتلة اهل الايمان " " واذا قتلتم فاحسنوا القتلة " و" لعن الله من اتخذ شيءا فيه الروح غرضا " والنهي عن ذلك فلما حرم قتله مصلوبا بيقين لما ذكرنا من وجوب اللعنة
 علي من اتخذ شيءا فيه الروح غرضا وحرم صلبه بعد القتل لما ذكرنا انه لا يجوز عليه جمع الامرين معا وجب ضرورة ان الصلب الذي امر الله تعالي به في المحارب انما هو صلب لا قتل معه ولو لم يكن هكذا لبطل الذي امر الله تعالي به ولكان كلاما عاريا من الفاءدة اصلا وحاش لله تعالي من ان يكون كلامه تعالي هكذا ولكان ايضا تكليفا لما لا يطاق وهذا باطل فصح يقينا ان الواجب ان يخير الامام صلبه ان صلبه حيا ثم يدعه حتي ييبس ويجف كله لان الصلب في كلام العرب يقع علي معنيين احدهما من الايدي والربط علي الخشبة قال الله تعالي حاكيا عن فرعون (ولاصلبنكم في جذوع النخل) والوجه الاخر التيبيس قال الشاعر: يصف فلاة مضلة * بها جيف الحسري فاما عظامها * فبيض واما جلدها فصليب يريد ان جلدها يابس، وقال الاخر: جذيمة ناهض في راس نيق * تري لعظام ما جمعت صليبا يريد ودكا ساءلا * قال ابو محمد رحمه الله: فوجب جمع الامرين معا حتي اذا انفذنا امر الله تعالي فيه وجب به ما افترضه الله تعالي للمسلم علي المسلم من الغسل.
 والتكفين.

 والصلاة.
 والدفن علي ما قد ذكرنا قبل هذا (فان قال قاءل) اليس الرجم اتخاذ ما فيه الروح غرضا وكذلك قولكم في القود بمثل ما قتل؟ (فجوابنا) وبالله تعالي التوفيق نعم وهما مامور بهما قد حكم عليه السلام بكليهما فوجب ان يكونا مستثنيين مما نهي عنه من اتخاذ الروح غرضا، فاما الرجم فبالنص والاجماع، واما القود فبالنص الجلي في رضخ راس اليهودي وفي العرنيين كما قلتم انتم ونحن في ان القصاص من قطع الايدي.
 والارجل.
 وسمل الاعين.
 وجدع الانف والاذان.
 وقطع الشفاه والالسنة.
 وقلع الاضراس حق واجب انفاذه مستثنيين من المثلة المحرمة ولا فرق * (فان قال قاءل): فانكم قد سمعتم قول رسول الله صلي الله عليه وسلم: " اعف الناس
 قتلة اهل الايمان " و" اذا قتلتم فاحسنوا القتلة " وانتم تقتلونه اوحش قتلة واقبحها جوعا وعطشا وحرا وبردا (فنقول): وما قتلناه اصلا بل صلبناه كما امر الله تعالي وما مات الا حتف انفه وما يسمي هذا في اللغة مقتولا (فان قالوا): فانكم تقولون فيمن سجن انسانا ومنعه الاكل والشرب حتي مات انه يسجن ويمنع الاكل والشرب حتي يموت فهذا قتل بقتل (فنقول): ان هذا ليس قتلا ولا قود بقتل بل هو ظلم وقود من الظلم فقط، وبرهان ذلك ان رجلا لو اتفق له ان يقفل بابا بغير عدوان فاذا في داخل الدار انسان لم يشعر به فمات هنالك جوعا وعطشا انه لا كفارة علي قافل الباب اصلا ولا دية علي عاقلته لانه ليس قاتلا (فان قيل): انكم تمنعونه الصلاة والطهارة (قلنا): نعم لان الله تعالي اذ امر بصلبه قد علم انه ستمر عليه اوقات الصلوات فلم يامرنا بازالة التصليب عنه من اجل ذلك (وما كان ربك نسيا) فلا يسع مسلما ولا يحل له ان يعترض علي امر الله تعالي (لا معقب لحكمه) (ولا يسال عما يفعل وهم يسالون) * (صفة القتل في المحارب)  مسالة قال ابو محمد رحمه الله: لا خلاف علي ان القتل الواجب في المحارب انما هو ضرب العنق بالسيف فقط، واما قطعه فان الله تعالي قال: (او تقطع ايديهم وارجلهم من خلاف) فصح بهذا انه لا يجوز قطع يديه ورجله معا لانه لو كان ذلك لم يكن القطع من خلاف وهذا ايضا اجماع لا شك فيه فقال قوم: يقطع يمين يديه ويسري رجليه ثم يحسم بالنار ولا بد * قال ابو محمد: اما الحسم فواجب لانه ان لم يحسم مات وهذا قتل لم يامر الله تعالي  به وقد قلنا: انه لا يحل ان يجمع عليه الامران معا لان الله تعالي انما امر بذلك بلفظ (او) وهو يقتضي التخيير ولا بد، ولو اراد الله تعالي جميع ذلك لقال: ان
 يقتلوا ويصلبوا وتقطع ايديهم وارجلهم من خلاف، وهكذا قوله تعالي: (فكفارته اطعام عشرة مساكين من اوسط ما تطعمون اهليكم او كسوتهم او تحرير رقبة) وقوله تعالي: (ففدية من صيام او صدقة او نسك) (فان قال قاءل): فان العرب قد قالت: جالس الحسن.
 او ابن سيرين.
 وكل خبزا.
 او تمرا، وقال تعالي: (ولا تطع منهم اثما او كفورا) (قلنا): اما قول الله تعالي: (ولا تطع منهم اثما او كفورا) فهو علي ظاهره، وهو عليه السلام منهي ان يطيع الاثم وان لم يكن كفورا وكل كفور اثم وليس كل اثم كفورا فصح ان ذكره تعالي للكفور تاكيد ابدا والا فالكفور داخل في الاثم.
 واما قول العرب: جالس الحسن.
 او ابن سيرين.
 وكل خبزا.
 او تمرا فنحن لا نمنع خروج اللفظ عن موضوعه في اللغة بدليل وانما نمنع من اخراجه بالظنون والدعوي الكاذبة وانما صرنا الي ان قول القاءل: جالس الحسن.
 او ابن سيرين اباحة لمجالستهما معا ولكل واحد منهما بانفراده وكذلك قولهم كل خبزا.
 او تمرا ايضا ولا فرق بدليل اوجب ذلك من حال المخاطب ولو لا ذلك الدليل لما جاز اخراج (او) عن موضوعها في اللغة اصلا وموضوعها انما هو التخيير او الشك والله تعالي لا يشك فلم يبق الا التخيير فقط * قال ابو محمد: ولو قطع القاطع يسري يديه ويمني رجليه لم يمنع من ذلك عمدا فعله او غير عامد لان الله تعالي لم ينص علي قطع يمني يديه دون يسري وانما ذكر تعالي الايدي والارجل فقط (وما كان ربك نسيا) ومن ادعي ههنا اجماعا فقد كذب علي جميع الامة ولا يقدر علي ان يوجد ذلك عن احد من الصحابة اصلا وما نعلمه عن احد من التابعين وبالله تعالي التوفيق *  كتاب السرقة   مسالة قال ابو محمد رحمه الله: قال الله تعالي: (والسارق والسارقة فاقطعوا ايديهما جزاء بما كسبا نكالا من الله) فوجب القطع في السرقة بنص القران.
 ونص السنة واجماع الامة، ثم اختلف الناس في مواضع من حكم السرقة نذكرها ان شاء الله تعالي ولا حول ولا قوة الا بالله *  مسالة  ذكر ما السرقة وحكم الحرز ايراعي ام لا؟ *

 قال ابو محمد رحمه الله: قالت طاءفة: لا قطع الا فيما اخرج من حرزه، واما ان اخذه من غير حرزه ومضي به فلا قطع عليه.
 وكذلك لو اخذ وقد اخذه من حرز فادرك قبل ان يخرجه من الحرز ويمضي به فلا قطع عليه كما نا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا ابن جريج عن سليمان بن موسي.
 وعمرو بن شعيب قال سليمان: ان عثمان، وقال عمرو بن شعيب: ان ابن عمر ثم اتفقا لا قطع علي سارق حتي يخرج المتاع * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج عن سليمان بن موسي ان عثمان قضي انه لا قطع علي سارق وان كان قد جمع المتاع فاراد ان يسرق حتي يحمله ويخرج به، وبه الي ابن جريج عن عمرو بن شعيب ان سارقا نقب خزانة المطلب بن وداعة فوجد فيها قد جمع المتاع ولم يخرج به فاتي به الي ابن الزبير فجلده وامر به ان يقطع فمر بابن عمر فسال فاخبر فاتي ابن الزبير فقال: امرت به ان يقطع؟ فقال: نعم قال فما شان الجلد؟ قال: غضبت فقال ابن عمر: ليس عليه قطع حتي يخرج به من البيت ارايت لو رايت رجلا بين رجلي امراة لم يصبها اكنت حاده؟ قال: لا قال: لعله قد كان نازعا تاءبا وتاركا للمتاع * حدثنا عبد الله بن ربيع نا محمد بن احمد بن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب عن ابن لهيعة عن يزيد بن ابي حبيب عن علي بن سليمان عن مكحول عن عثمان بن عفان قال: لا تقطع يد السارق وان وجد معه المتاع ما لم يخرج به عن الدار * وبه الي ابن وهب سمعت الشمر بن نمير يحدث عن الحسين بن عبد الله بن ضميرة عن ابيه عن جده عن علي بن ابي طالب قال في الرجل يوجد في البيت  وقد نقبه 
 معه المتاع انه لا يقطع حتي يحمل المتاع فيخرج به عن الدار * حدثنا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا زكريا عن الشعبي قال: ليس علي السارق قطع حتي يخرج المتاع، وعن عطاء ساله ابن جريج السارق يوجد في البيت قد جمع المتاع ولم يخرج به قال: لا قطع عليه حتي يخرج به، وعن ربيعة انه قال.
 من اخذ في دار قوم معه سرقة قد خرج عن مفاتيح البيت الذي اخذ السرقة منه فعليه القطع ومن لم يوجد معه شء فلا قطع عليه وان كان يريد السرقة، وعن عدي بن ارطاة انه كتب الي عمر بن عبد العزيز في رجل نقب بيت قوم حتي دخل البيت فجمع متاعهم فاخذوه في البيت قد جمع المتاع فكتب اليه عمر ابن عبد العزيز انه لم ينقب البيت ويجمع المتاع لخير فعاقبه عقوبة شديدة ثم احبسه ولا تدع ان تذكرنيه، وعن ابن شهاب انه قال انما السرقة فيما احصن فما كان محصنا  في دار.
 او حرز.
 او حاءط.
 او مربوط.
 فاحتل رباطه فذهب به فتلك من السرقة التي يقطع فيها قال: فمن سرق طيرا من حرز له معلق فعليه ما علي السارق * قال ابو محمد رحمه الله: وبهذا يقول سفيان الثوري.
 وابو حنيفة.
 ومالك والشافعي.
 واحمد بن حنبل.
 واصحابهم.
 واسحق بن راهويه: وقالت طاءفة: عليه القطع سواء من احرز سرق او من غير حرز كما نا احمد بن انس العذري نا عبد الله ابن الحسين بن عقال  هو الزبيري  نا ابراهيم بن محمد الدينوري نا محمد بن احمد بن الجهم نا موسي بن اسحاق نا ابو بكر بن ابي شيبة نا ابو خالد عن يحيي بن سعيد الانصاري عن عبد الرحمن بن القاسم بن محمد بن ابي بكر الصديق قال: بلغ عاءشة ام المءمنين انهم يقولون: اذا لم يخرج السارق المتاع لم يقطع فقالت عاءشة: لو لم اجد الا سكينا لقطعته، وبه الي ابن الجهم نا محمد بن رمح نا يزيد بن هرون انا سليم بن حيان نا سعيد ابن مسلم قال: كان عبد الله بن الزبير يلي صدقة الزبير فكانت في بيت لا يدخله احد
 غيره وغير جارية له ففقد شيءا من المال فقال للجارية: ما كان يدخل هذا المكان غيري وغيرك فمن اخذ هذا المال؟ فاقرت الجارية فقال لي.
 يا سعيد انطلق بها فاقطع يدها فان المال لو كان لم يكن عليها قطع * حدثنا محمد بن سعيد بن نبات نا احمد بن عبد البصير نا قاسم نا اصبغ نا محمد بن عبد السلام الخشني نا محمد بن المثني نا عبد الرحمن بن مهدي نا سفيان الثوري عن المغيرة ابن مقسم قال: ذكر عند ابراهيم النخعي قول الشعبي في السارق لا يقطع حتي يخرج بالمتاع فانكره ابراهيم * حدثنا حمام بن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق نا ابن جريج اخبرني ابو بكر قال: نا خالد بن سعيد بن المسيب.
 وعبيد الله بن عبد الله بن عتبة انهما سءلا عن السارق يسرق فيطرح السرقة ويوجد في البيت الذي سرق منه لم يخرج فقالا جميعا: عليه القطع، وقد روي هذا ايضا عن الحسن البصري رواه روح بن عبادة عن اشعث بن عبد الملك الحمراني عن الحسن قال: اذا جمع السارق المتاع ولم يخرج به قطع * حدثنا عبد الله بن ربيع نا عبد الله بن محمد بن عثمان نا احمد بن خالد نا علي بن عبد العزيز نا الحجاج بن المنهال نا حماد بن سلمة انا عبد العزيز بن ابي سعيد المزني ان عمرو بن ابي سيارة المزني كان قاءما يصلي من الليل فسمع خشفة في البيت فظن انها الشاة ثم استيقن ان في البيت لصوصا فاخذ السيف فقام علي باب البيت فاذا كارة وسط البيت فخرج عليه مثل الجمل المحجرم فضرب بالثياب وجهه وحذفه عمرو بالسيف  حذفة ونادي مواليه وعبيده علي الرجل فقد اثقلته واقام بمكانه يري ان في البيت اخرين فادركوه وهو تحت ساباط لبني ليث يشتد فاخذوه فجاءوا به الي عبيدالله بن ابي بكرة فقال: اني رجل قصاب واني ادلجت من اهلي اريد الجسر لاجيز غنما لي وان عمرا ضربني بالسيف فبعث عبيد الله الي عمرو فساله فقال: بل دخل علي بيتي وجمع
 المتاع فشهد عليه فقطع عبيد الله بن ابي بكرة يده * قال ابو محمد رحمه الله: وبه يقول ابو سليمان.
 وجميع اصحابنا: ومن هذا ايضا المختلس فان الناس اختلفوا فيه فقالت طاءفة: لا قطع عليه كما حدثنا محمد بن سعيد ابن نبات نا احمد بن عبد البصير نا قاسم بن اصبغ نا محمد بن عبد السلام الخشني نا محمد ابن المثني نا عبد الرحمن بن مهدي نا سفيان الثوري عن سماك بن حرب عن دثار بن يزيد عن عبيد بن الابرص ان علي بن ابي طالب اتي برجل اختلس من رجل ثوبا فقال: انما كنت العب معه قال: تعرفه؟ قال نعم فلم يقطعه * حدثنا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي ابن معاوية نا وكيع نا مالك بن انس عن الزهري ان رجلا اختلس طوقا فسءل عنها مروان زيد بن ثابت فقال: ليس عليه قطع * وعن معمر عن الزهري قال: اختلس رجل متاعا فاراد مروان ان يقطع يده فقال له زيد بن ثابت: تلك الخلسة الظاهرة لا قطع فيها لكن نكال وعقوبة * ومن طريق عبد الرزاق عن سفيان الثوري عن اسماعيل بن مسلم عن الحسن عن علي بن ابي طالب انه سءل عن الخلسة فقال: تلك الدعوة المقلة لا قطع فيها * وعن الشعبي ان رجلا اختلس طوقا فاخذوه  وهو في حجرته فرفع الي عمار ابن يسار  وهو علي الكوفة  فكتب الي عمر بن الخطاب فكتب اليه انه عادي الظهيرة ولا قطع عليه * وعن عدي بن ارطاة انه كتب الي عمر بن عبد العزيز في رجل اختلس طوقا من ذهب كان في عنق جارية نهارا فكتب اليه عمر بن عبد العزيز ان ذلك عادي ظهر () ليس عليه قطع فعاقبه * وعن الحسن البصري في الخلسة لا قطع فيها * وعن قنادة لا قطع علي المختلس ولكن يسجن ويعاقب  وهو قول النخعي.
 وابي حنيفة.
 ومالك.
 والشافعي.
 واحمد بن حنبل.
 واصحابهم:  وبه يقول اسحاق بن راهويه: وقالت طاءفة: عليه القطع كما نا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون  نا ابن وهب عن قباث بن رزين انه سمع علي بن رباح اللخمي يقول: السنة ان تقطع اليد المستخفية ولا تقطع اليد المعلنة * وعن عطاء بن ابي رباح انه قال: تقطع يد السارق المستخفي المستتر ولا تقطع يد المختلس المعلن * ومن طريق ابي بكر بن ابي شيبة ثنا عبد الاعلي عن هشام ان عدي بن ارطاة رفع اليه رجل اختلس خلسة فقال اياس بن معاوية: عليه القطع * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر في ذلك فنظرنا في قول من لم ير القطع الا في اخذ من حرز فوجدناهم يذكرون ما ناه عبد الله ابن ربيع نا محمد بن معاوية نا احمد بن شعيب نا قتيبة بن سعيد نا الليث بن سعد عن محمد ابن عجلان عن عمرو بن شعيب عن ابيه عن جده عن عبد الله بن عمرو " ان رسول الله صلي الله عليه وسلم سءل عن التمر المعلق؟ فقال: من اصاب منه من ذي حاجة غير متخذ خبنة () فلا شء عليه ومن خرج بشء منه فعليه غرامة مثليه والعقوبة ومن سرق شيءا منه بعد ان يءوه الجرين فبلغ ثمن المجن فعليه القطع ومن سرق دون ذلك فعليه غرامة مثله والعقوبة " * نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا قتيبة بن سعيد نا ابو عوانة عن عبيد الله بن الاخنس عن عمرو بن شعيب عن ابيه عن جده قال: " سءل رسول الله صلي الله عليه وسلم في كم تقطع اليد؟ فقال: لا تقطع اليد في تمر معلق فاذا ضمه الجرين قطعت في ثمن المجن ولا تقطع في حريسة الجبل فاذا اواه المراح قطعت في ثمن المجن " * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب عن الحرث
 ابن مسكين قراءة عليه واحمد يسمع عن ابن وهب اخبرني عمرو بن الحرث عن عمرو ابن شعيب عن ابيه عن عبد الله بن عمرو قال: " ان رجلا من مزينة اتي رسول الله صلي الله عليه وسلم فقال: يا رسول الله كيف تري في حريسة الجبل؟ قال: هي ومثلها والنكال وليس في شء من لماشية قطع الا فيما اواه المراح فبلغ ثمن المجن ففيه قطع اليد وما لم يبلغ ثمن المجن ففيه غرامة مثليه وجلدات نكال قال: يا رسول الله كيف تري في التمر المعلق؟ قال: هو ومثله والنكال وليس في شء من التمر المعلق قطع الا فيما اواه الجرين فما اخذ من الجرين فبلغ ثمن المجن ففيه القطع وما لم يبلغ ثمن المجن ففيه غرامة مثليه وجلدات نكال " * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد ابن شعيب انا عبد الله بن عبد الصمد بن علي عن مخلد عن سفيان عن ابي الزبير عن جابر عن رسول الله صلي الله عليه وسلم قال: " ليس علي خاءن ولا مختلس قطع " * نا عبد الله  ابن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن حاتم نا سويد بن نصر انا عبد الله بن المبارك عن ابن جريج اخبرني ابو الزبير عن جابر " ان رسول الله صلي الله عليه وسلم درا عن المنتهب والمختلس والخاءن القطع " * قال ابو محمد رحمه الله: فقالوا لم يجعل النبي صلي الله عليه وسلم القطع علي مختلس ولا علي خاءن فسقط بذلك القطع عن كل من اءتمن وسقط القطع عن حريسة الجبل والتمر المعلق حتي يءويهما الجرين والمراح وهو حرزهما وقالوا: ما وجد في غير حرز فانما هو لقطة قد ابيح اخذها وتحصينها، وقالوا: قد جاء عن عمر بن الخطاب.
 وعلي بن ابي طالب.
 وزيد بن ثابت انه لا قطع علي مختلس ولا يعرف لهم من الصحابة مخالف فدل ذلك علي اعتبار الحرز فنظرنا في ذلك فوجدناه لا حجة لهم في شء منه * اما الخبران اللذان ذكرنا فلا يصح منهما ولا واحد.
 اما حديث حريسة
 الجبل.
 والتمر المعلق فانه لا يصح لان احد طريقيه من سعيد بن المسيب مرسل والاخري هي ايضا اسقط مرسلة من طريق ابن ابي حسين ولا حجة في مرسل.
 والاخري مما انفرد به عمرو بن شعيب عن ابيه عن جده وهي صحيفة لا يحتج بها فهذا وجه يسقط به، ودليل اخر انه لو صح لكان عليهم لا لهم لانهم كلهم  يعني الحاضرين من المخالفين  مخالفون لما فيه من ذلك ان فيه ان من خرج بشء من التمر المعلق ففيه غرامة مثليه وهم لا يقولون بهذا، وكذلك اذا اواه الجرين فلم يبلغ ثمن المجن ففيه ايضا غرامة مثليه وهم لا يقولون بهذا ايضا.
 وفيه ايضا ان في حريسة الجبل غرامة مثلها وان فيها غرامة مثليها وان فيها ان اواه المراح فلم يبلغ ثمن المجن غرامة مثليها فهم قد خالفوا هذا الخبر الذي احتجوا به في اربعة مواضع من احكامه فكيف يستجيز ذو ورع يدري ان كلامه محسوب عليه وانه محاسب به يخاف لقاء الله تعالي.
 ويهاب عقابه ان يحتج بخبر هو يصححه ويخالفه في اربعة احكام من احكامه علي من لا يصححه اصلا فلا يراه حجة وهل في التعجيل بالاثم والفضيحة العاجلة اكثر من هذا، فان ادعوا في ترك هذه الاحكام الاربعة اجماعا كذبوا لان عمر بن الخطاب رضي الله عنه قد حكم بها بحضرة الصحابة رضي الله عنهم لا يعرف منهم له مخالف ولا يدري منهم عليه منكر فاضعف قيمة الناقة المنتحرة للمزني علي رقيق حاطب التي سرقوها وانتحروها، وقد روينا من طرق منها ما ناه احمد بن محمد بن الجسور نا قاسم بن اصبغ نا مطرف بن قيس نا يحيي بن بكير نا مالك بن انس عن هشام بن عروة بن الزبير عن ابيه عن يحيي بن عبد الرحمن بن حاطب ان رقيقا لحاطب سرقوا ناقة للمزني  رجل من مزينة   فانتحروها فرفع ذلك الي عمر بن الخطاب فامر عمر لكثير بن الصلت ان يقطع ايديهم قال عمر: اني اراك تجيعهم والله لاغرمنك غرما يشق عليك ثم قال للمزني كم ثمن ناقتك؟ قال: اربعماءة درهم قال عمر: فاعطه ثمانماءة درهم *
 قال ابو محمد رحمه الله: فهذا اثر عن عمر كالشمس، واما حديث سعيد بن المسيب وهم يعدون مثل هذا اجماعا اذا وافق اهواءهم، وقد روي عن عثمان بن عفان رضي الله عنه وغيره نحو هذا في اتلاف الاموال كما روينا من طريق عبد الرزاق عن معمر عن الزهري عن ابان بن عثمان ان اباه عثمان اغرم في ناقة محرم اهلكها رجل فاغرمه الثلث زيادة علي ثمنها قال الزهري: ما اصيب من اموال الناس ومواشيهم في الشهر الحرام فانه يزاد الثلث لهذا في العمد، فهذا اثر في غاية الصحة عن عثمان رضي الله عنه ولا يعرف له في ذلك مخالف من الصحابة رضي الله عنهم.
 وقال به الزهري بعد ذلك وهم لا يبالون بدعوي الاجماع في اقل من هذا جراة علي الكذب ثم لا يبالون بمخالفة ما يقرون بانه اجماع * قال ابو محمد رحمه الله: نقول وبالله تعالي التوفيق ان الخبر الذي رواه ابو الزبير عن جابر لم يروه احد من الناس عن جابر الا ابو الزبير فقط وابو الزبير مدلس ما لم يقل فيه نا او انا لا سيما في جابر فقد اقر علي نفسه بالتدليس فيه كما نا يوسف بن عبد الله بن عبد البر النمري قال: نا عبد الله بن محمد بن يوسف الازدي نا اسحق بن احمد الصيدلاني نا ابو جعفر العقيلي () نا زكريا بن يحيي الحلواني نا احمد بن سعيد بن ابي مريم نا عمي ونا محمد بن اسماعيل نا الحسن بن علي نا سعيد بن ابي مريم نا الليث بن سعد قال: قدمت مكة فجءت ابا الزبير فدفع الي كتابين فانقلبت بهما فقلت في نفسي لو عاودته فسالته اسمع هذا كله من جابر؟ فرجعت اليه فقلت له: هذا كله سمعته من جابر فقال منه ما سمعته ومنه ما حدثت عنه فقلت له اعلم لي ما سمعت منه فاعلم لي علي هذا الذي عندي * قال علي: فما لم يروه الليث عن ابي الزبير او لم يقل فيه نا او انا فهو منقطع فقد صح ان هذا الحديث لم يسمعه ابو الزبير من جابر، واما احتجاجهم بما جاء عن الصحابة رضي الله عنهم في المختلس فان الرواية في ذلك عن زيد بن ثابت لا تصح لانها عن الزهري عنه منقطعة ولم يسمع الزهري من زيد كلمة * واما الرواية عن عمر.
 وعمار بن ياسر في ذلك فانها منقطعة لانها عن الشعبي عنهما ولم يولد الشعبي الا بعد قتل عمر بن الخطاب
 رضي الله عنه ولم يكن يعقل اذ مات عمار بن ياسر * واما الرواية عن علي في ذلك فهي من طريقين احداهما عن سماك بن حرب وهو يقبل التلقين.
 والاخري من طريق بكير بن  ابي السبط المكفوف وقد روي نحوه عن قتادة.
 وعفان ولا يعرف حاله الا ان القول في المختلس لا يخلو من احد وجهين.
 اما ان يكون اختلس جهارا غير مستخف من الناس فهذا لا خلاف فيه انه ليس سارقا ولا قطع عليه او يكون فعل ذلك مستخفيا عن كل من حضر فهذا لا خلاف بيننا وبين الحاضرين من خصومنا في انه سارق وان عليه القطع فبطل كل ما تعلقوا به وعري قولهم في مراعاة الحرز عن ان يكون له حجة اصلا * واما قولهم ان الشء اذا لم يكن محرزا فهو لقطة فخطا لان اللقطة انما هي ما سقط عن صاحبه وصار بدار مضيعة.
 وكذلك الضالة، واما ما كان غير مهمل ولا ساقط فقد بطل عن ان يكون لقطة او ضالة وقد جاء في اللقطة والضالة نصوص لا يحل تعديها فلا مدخل للسارق فيها فنحن انما نكلمهم في سارق من حرز لا في ملتقط ولا في اخذ ضالة فان الملتقط مختلس فسقط هذا الاعتراض الفاسد * قال ابو محمد رحمه الله: فوجب ان ننظر في القول الثاني فوجدنا الله تعالي يقول (والسارق والسارقة فاقطعوا ايديهما جزاء بما كسبا نكالا من الله) فوجب بنص القران ان كل من سرق فالقطع عليه وان من اكتسب سرقة فقد استحق بنص كلام الله تعالي جزاء لكسبه ذلك قطع يده نكالا وبالضرورة الحسية.
 وباللغة يدري كل احد يدري اللغة ان من سرق من حرز او من غير حرز فانه سارق وانه قد اكتسب سرقة لا خلاف في ذلك فاذ هو سارق مكتسب سرقة فقطع يده واجب بنص القران ولا يحل ان يخص القران بالظن الكاذب ولا بالدعوي العارية من البرهان فان من قال: ان
 الله تعالي انما اراد في هذه الاية من سرق من حرز فانه مخبر عن الله تعالي والمخبر عن الله تعالي بما لم يخبر به عن نفسه ولا اخبر به عنه نبيه صلي الله عليه وسلم فقد قال علي الله تعالي الكذب وقال ما لا يعلم وقفا ما لا علم له به وهذا عظيم جدا، وقد اوردنا عن عاءشة.
 وابن الزبير وسعيد بن المسيب.
 وعبد الله بن عبيد الله.
 والحسن.
 وابراهيم النخعي.
 وعبيد الله بن ابي بكرة القطع علي من سرق وان لم يخرج به من الحرز * قال ابو محمد رحمه الله: فهذا نص القران، واما من السنن فروينا من طريق البخاري نا ابو الوليد  هو الطيالسي  والليث  هو ابن سعد  عن ابن شهاب عن عروة عن عاءشة " ان قريشا اهمتهم المراة المخزومية التي سرقت فذكر الحديث، وفيه ان رسول الله صلي الله عليه وسلم قام فخطب فقال: يا ايها الناس انما ضل من كان قبلكم انهم كانوا اذا سرق الشريف تركوه واذا سرق الضعيف فيهم اقاموا عليه الحد وايم الله لو ان فاطمة بنت محمد سرقت لقطع محمد يدها " * ومن طريق البخاري نا موسي بن اسماعيل نا عبد الواحد الاعمش قال: سمعت ابا صالح سمعت ابا هريرة يقول: قال رسول الله  صلي الله عليه وسلم: " لعن الله السارق يسرق البيضة فتقطع يده ويسرق الحبل فتقطع يده " * قال ابو محمد رحمه الله: فقضي رسول الله صلي الله عليه وسلم بقطع السارق جملة ولم يخص عليه السلام حرزا من غير حرز (وما ينطق عن الهوي ان هو الا وحي يوحي) (وما كان ربك نسيا)، وقال تعالي: (اليوم اكملت لكم دينكم) وقال تعالي: (لتبين للناس ما نزل اليهم) ونحن نشهد بشهادة الله تعالي ان الله عزوجل لو اراد ان لا يقطع السارق حتي يسرق من حرز ويخرجه من الدار لما اغفل ذلك ولا اهمله ولا اعنتنا بان يكلفنا علم شريعة لم يطلعنا عليه ولبينه علي لسان رسوله صلي الله عليه وسلم اما في الوحي.
 واما في النقل المنقول فاذ لم يفعل الله تعالي ذلك ولا رسوله صلي الله عليه وسلم فنحن نشهد.
 ونبت.
 ونقطع بيقين لا يمازجه شك ان الله تعالي لم يرد قط ولا رسوله صلي الله عليه وسلم اشتراط الحرز في السرقة واذ لا شك في ذلك
 فاشتراط الحرز فيها باطل بيقين لا شك فيه وشرع لما لم ياذن الله تعالي به وكل ما ذكرنا فانما يلزم من قامت عليه الحجة ووقف علي ما ذكرنا لان من سلف ممن اجتهد فاخطا ماجور وبالله تعالي التوفيق، واما الاجماع فانه لا خلاف بين احد من الامة كلها في ان السرقة هي الاختفاء باخذ الشء ليس له، وان السارق هو المختفي باخذ ما ليس له وانه لا مدخل للحرز فيما اقتضاه الاسم فمن اقحم في ذلك اشتراط الحرز فقد خالف الاجماع علي معني هذه اللفظة في اللغة وادعي في الشرع ما لا سبيل له الي وجوده ولا دليل علي صحته * واما قول الصحابة: فقد اوضحنا انه لم يات قط عن احد منهم اشتراط الحرز اصلا وانما جاء عن بعضهم حتي يخرج من الدار، وقال بعضهم: من البيت وليس هذا دليلا علي ما ادعوه من الحرز مع الخلاف الذي ذكرنا عن عاءشة.
 وابن الزبير في ذلك فلاح ان قولنا قول قد جاء به القران والسنن الثابتة عن رسول الله صلي الله عليه وسلم وبالله تعالي التوفيق *  مساءل من هذا الباب   مسالة فيمن سرق من بيت المال.
 او من الغنيمة * قال ابو محمد رحمه الله: نا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا المسعودي عن القاسم بن عبد الرحمن قال: ان رجلا سرق من بيت المال فكتب فيه سعد بن ابي وقاص الي عمر بن الخطاب فكتب عمر اليه ان لا قطع عليه لان فيه نصيبا * وبه الي وكيع نا سفيان  هو الثوري  عن سماك بن حرب عن عبيد بن الابرص ان علي بن ابي طالب اتي برجل قد سرق من  الخمس مغفرا فلم يقطعه علي وقال: ان له فيه نصيبا * وبه يقول ابراهيم النخعي.
 والحكم بن عتيبة.
 وابو حنيفة.
 والشافعي.
 واصحابهما، وقال مالك.
 وابو ثور.
 وابو سليمان.
 واصحابهم: عليه القطع *
 قال ابو محمد رحمه الله: انما احتج من لم ير القطع في ذلك بحجتين.
 احداهما ان له فيه نصيبا مشاعا، والثانية انه قول صاحبين لا يعرف لهما مخالف من الصحابة رضي الله عنهم.
 اما الاحتجاج بانه قول طاءفة من الصحابة رضي الله عنهم لا يعرف لهم منهم مخالف فان هذا يلزم المالكيين المحتجين بمثل هذا اذا وافق اهواءهم التاركين له اذا اشتهوا واما نحن فلا حجة عندنا في قول احد دون رسول الله صلي الله عليه وسلم.
 واما احتجاجهم بان له في ذلك نصيبا فهذا ليس حجة في اسقاط حد الله تعالي اذ ليست هذه القضية مما جاء به القران ولا مما صح عن رسول الله صلي الله عليه وسلم ولا مما اجمعت عليه الامة فلا حجة لهم في غير هذه العمد الثلاث وكونه له في بيت المال وفي المغنم نصيب لا يبيح له اخذ نصيب غيره لانه حرام عليه باجماع لا خلاف فيه، وبقول الله تعالي: (ولا تاكلوا اموالكم بينكم بالباطل) فاذ نصيب شريكه عليه حرام فلا فرق بين سرقته اياه وبين سرقته من اجنبي لا نصيب له معه وهم يدعون القياس وهم يقولون ان الحرام اذا امتزج مع الحلال فانه كله حرام كالخمر مع الماء.
 ولحم الخنزير يدق مع لحم الكبش وغير هذا كثير ويرون الحد علي من شرب خمرا ممزوجة بماء حلال فما الفرق بينه وبين من سرق شيءا بعضه له حلال وبعضه حرام لغيره؟ * قال ابو محمد رحمه الله: فلما لم نجد في المنع من قطع من سرق من المغنم.
 او من الخمس.
 او من بيت المال حجة اصلا لا من قران.
 ولا سنة.
 ولا اجماع وجب ان ننظر في القول الاخر فوجدنا الله تعالي يقول: (والسارق والسارقة فاقطعوا ايديهما جزاء بما كسبا نكالا من الله) ووجدنا رسول الله صلي الله عليه وسلم قد اوجب القطع علي السارق جملة ولم يخص الله تعالي ولا رسوله عليه السلام سارقا من بيت المال من غيره ولا سارقا من المغنم ولا سارقا من مال له فيه نصيب من غيره (وما كان ربك نسيا) ولو ان الله تعالي اراد ذلك لما اغفله ولا اهمله، والعمل في ذلك ان ننظر فيمن سرق من شء له فيه نصيب من بيت المال.
 او الخمس.
 او المغنم
 او غير ذلك فان كان نصيبه محدودا معروف المقدار كالغنيمة او ما اشترك فيه ببيع او ميراث.
 او غير ذلك.
 او كان من اهل الخمس نظر فان اخذ زاءدا علي نصيبه مما يجب في مثله القطع قطع ولا بد فان سرق اقل فلا قطع عليه الا ان يكون منع حقه  في ذلك او احتاج اليه فلم يصل الي اخذ حقه الا بما فعل ولا قدر علي اخذ حقه خالصا فلا يقطع اذا عرف ذلك وانما عليه ان يرد الزاءد علي حقه فقط لانه مضطر الي اخذ ما اخذ اذا لم يقدر علي تخليص مقدار حقه والله تعالي يقول: (وقد فصل لكم ما حرم عليكم الا ما اضطررتم اليه) وبالله تعالي التوفيق *  مسالة  فيمن سرق من الحمام، نا محمد بن سعيد بن نبات نا عبد الله ابن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا سعيد بن عبد العزيز التنوخي عن بلال بن سعد ان رجلا سرق برنسا من الحمام فرفع الي ابي الدرداء فلم ير عليه قطعا، وبه يقول ابو حنيفة.
 واصحابه، وقال مالك.
 واحمد.
 واسحق.
 وابو ثور.
 وابو سليمان، واصحابهم عليه القطع اذا كان هنالك حافظ * قال ابو محمد رحمه الله: وهذا مما تناقض فيه الحنيفيون.
 والمالكيون لانهم يعظمون خلاف الصاحب الذي لا يعرف له مخالف من الصحابة اذا وافق اراءهم وقد خالفوا ههنا قول ابي الدرداء ولا يعرف له من الصحابة مخالف * قال ابو محمد رحمه الله: واما نحن فلا حجة عندنا في قول احد دون رسول الله صلي الله عليه وسلم وقد قال تعالي: (والسارق والسارقة فاقطعوا ايديهما جزاء بما كسبا نكالا من الله) وهذا سارق فالقطع عليه بنص القران ولو اراد الله تعالي تخصيص ذلك لما اغفله *  مسالة  فيمن سرق من مسجد، قال قوم: لا قطع علي من سرق من مسجد، وقالت طاءفة: اذا كان هنالك حافظ لذلك الشء او كانت الابواب مغلقة قطع والا فلا، وكذلك لو قلع باب المسجد فان كان مغلقا مضبوطا قطع والا
 فلا، وهكذا القول في باب الدار  وهو قول مالك  وقال اصحابنا: القطع في كل ذلك واجب والاصل في ذلك امر الحرز كما ذكرنا وقد بطل قول من قال بمراعاة الحرز فالواجب قطع من سرق من مسجد بابا كان مغلقا او غير مغلق.
 او حصيرا.
 او قنديلا.
 او شيءا وضعه صاحبه هنالك ونسيه كان صاحبه معه او لم يكن اذا اخذه مستترا باخذه لنفسه لا ليحفظه علي صاحبه وذلك لما ذكرنا وبالله تعالي التوفيق *  مسالة  هل علي النباش قطع ام لا؟  قال ابو محمد رحمه الله: اختلف الناس في النباش فقالت طاءفة: عليه القتل، وقالت طاءفة: تقطع يده ورجله، وقالت طاءفة: تقطع يده فقط، وقالت طاءفة: يعزر ادبا ولا شء عليه غير ذلك، واما من راي عليه القتل فكما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج عن صفوان بن سليم ان رجلا من اصحاب رسول الله صلي الله عليه وسلم  وجد رجلا يختفي في القبور فقتله فاهدر عمر بن الخطاب دمه، واما من راي قطع يده ورجله فكما روينا بالسند المذكور الي ابن جريج قال: قال لي عمرو بن دينار: قطع عباد بن عبد الله بن الزبير يد غلام ورجله اختفي * قال ابو محمد رحمه الله: عباد هذا من التابعين ادرك عاءشة نعم وجده الزبير وجمهور الصحابة رضي الله عنهم، واما من راي قطع يده فقط فكما روينا بالسند المذكور الي عبد الرزاق عن ابراهيم بن محمد بن ابي يحيي اخبرني عبد الله بن ابي بكر عن عبد الله بن عامر بين ربيعة انه وجد قوما يختفون القبور باليمن فكتب الي عمر بن الخطاب فكتب اليه عمر ان يقطع ايديهم * حدثنا عبد الله بن ربيع نا محمد بن عثمان نا احمد بن خالد نا علي بن عبد العزيز نا حجاج بن المنهال نا هشيم عن سهيل بن ابي صالح قال: شهدت عبد الله بن الزبير قطع يد النباش، وبه الي الحجاج بن المنهال نا حماد بن سلمة عن الحجاج بن ارطاة ان الشعبي.
 والنخعي.
 ومسروق بن الاجدع.
 وزاذان.
 وابا ذرعة بن عمر.
 وعمرو بن حزم قالوا في النباش ادا اخذ المتاع: قطع، وعن ابراهيم النخعي قال: اذا سرق النباش قدر ما يقطع فيه فعليه القطع، وعن الشعبي انه سءل عن النباش فقال: نقطع في امواتنا كما نقطع في احياءنا * قال ابو محمد رحمه الله: والذي نقول به وبالله تعالي التوفيق ان كل هذا لا معني له لكن الفرض هو ما افترض الله تعالي ورسوله عليه السلام الرجوع اليه عند التنازع اذ يقول تعالي: (فان تنازعتم في شء فردوه الي الله والرسول) الاية ففعلنا فوجدنا تعالي يقول: (والسارق والسارقة فاقطعوا ايديهما) ووجدنا رسول الله صلي الله عليه وسلم قد اوجب القطع علي من سرق بقوله عليه السلام: " لو سرقت فاطمة بنت محمد لقطع محمد يدها " ووجدنا السارق في اللغة التي نزل بها القران وبها خاطبنا الله تعالي هو الاخذ شيءا لم يبح الله تعالي له اخذه فياخذه متملكا له مسخفيا به فوجدنا النباش هذه صفته فصح انه سارق واذ هو سارق فقطع اليد علي السارق فقطع يده واجب، وبه نقول: واما من راي قتله.
 او قطع يده ورجله فما نعلم له حجة الا ان يكونوا راوه محاربا وليس ههنا دليل علي انه محارب اصلا لانه لم يخف طريقا فليس له حكم المحارب ودماءنا حرام فدم النباش حرام، وبالله تعالي التوفيق *  مسالة  ما يجب فيه علي اخذه القطع  قال ابو محمد رحمه الله: تنازع الناس في اشياء فقال قوم: لا قطع في سرقتها، وقال قوم: فيها القطع من ذلك التمر.
 والجمار.
 والشجر.
 والزرع *

 قال ابو محمد رحمه الله: نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب اخبرني محمد بن خالد ني ابي نا سلمة بن عبد الملك الغوصي عن الحسن  هو ابن صالح ابن حي  عن يحيي بن سعيد الانصاري عن القاسم بن محمد بن ابي بكر الصديق عن رافع بن خديج قال: سمعت رسول الله صلي الله عليه وسلم يقول: لاقطع في ثمر.
 ولا كثر 
 والكثر الجمار  وفي هذا اثار كثيرة لم نذكرها لءلا نطول بذكرها ولو صحت لوجب الاخذ بها بذلك وللزم حينءذ ان لا يقطع في شء من الثمر والحبوب سواء حصد او لم يحصد جد او لم يجد كان في المخازن او لم يكن لعموم هذا اللفظ.
 ولان الله تعالي سمي اليابس ثمرا فقال: (ومن ثمرات النخيل والاعناب) فسمي الله تعالي ما تثمره الشجرة والنخلة والزرع ثمرا بقوله تعالي: (وهو الذي انشا جنات معروشات وغير معروشات والنخل والزرع مختلفا اكله والزيتون والرمان) الاية الي قوله تعالي: (واتوا حقه يوم حصاده) فوجب الحق فيه يوم حصاده  والحصاد لا يكون الا في اليابس  واما ساق الشجر.
 والنخل.
 واغصانه فلا يقع عليه اسم ثمر اصلا لا في لغة.
 ولا في شريعة، واختلف المتاخرون في هذا فقال سفيان الثوري: لا قطع فيما يفسد من يومه من الطعام مثل الثريد واللحم وما اشبهه لكن يعزر واذا كانت الثمرة في شجرتها لم تقطع اليد في سرقتها لكن يعزر، قال ابو حنيفة: لا يقطع في شء من الابل.
 ولا البقر.
 ولا الغنم.
 ولا الخيل.
 ولا البغال.
 ولا الحمير.
 اذا سرق كل ذلك من المرعي فاذا كانت في المراح او في الدور ففيها القطع، ولا يقطع في شء من الفواكه الرطبة كانت في الدور او في الشجر في حرز كانت او في غير حرز وكذلك البقول كلها.
 وكذلك ما يسرع اليه الفساد من اللحم والطعام كله كان في حرز او في غير حرز ولا قطع في الملح، ولا في التوابل.
 ولا في الزروع كلها فاذا يبس الزرع وحمل الي الاندر او الي البيوت وجب القطع في سرقة شء منه اذا بلغ ما يجب فيه القطع، وقال مالك: كل ما كان من الفواكه في اشجاره والزرع في مزرعته فلا قطع في شء منه وكذلك الانعام في مسارحها فاذا احرزت الانعام في مراح او دار ففيها القطع، فاذا جمع الزرع في اندره او في الدور ففيه القطع، واذا جنيت الفواكه وادخلت في الحرز ففيها القطع، وكذلك تقطع في البقول والفواكه كلها وفي اللحم.
 وفي كل شء اذا كان في حرز، وهذا قول الشافعي ايضا: وقال ابو
 ثور: اذا كانت الفواكه في اشجارها رطبة او غير رطبة وكان الفسيل في حاءطه، وكان كل ذلك محرزا ممنوعا ففيه القطع، وقال فيما عدا ذلك بقول مالك.
 والشافعي  وقال مالك: والشافعي.
 وابو ثور في البعير.
 او الدابة تسرق من الفدان: ففيه القطع، وقال اصحابنا في كل ما ذكرنا القطع محرزا كان او غير محرز اذا سرقه السارق ولم ياخذه معلنا * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا نظرنا في ذلك، ونظرنا في قول ابي ثور فوجدناه صحيحا الا اشتراطه الحرز فقط فان الحرز لا معني له علي ما بينا قبل، وقول ابي ثور هذا انما صح لموافقته عموم قول الله تعالي: (والسارق والسارقة فاقطعوا ايديهما) وبحكم رسول الله صلي الله عليه وسلم بقطع السارق عموما دون اشتراط حرز.
 وقول ابي ثور: مخالف للاحاديث المذكورة قبل هذا لانها واهية.
 ولا حجة الا في صحيح، ثم نظرنا في قول مالك.
 والشافعي: فوجدنا حجتهما انما هي خبر عمرو بن شعيب.
 وابن المسيب، وخبر حميد بن قيس.
 وعبد الرحمن بن عبد الله لا حجة لهما غيرهما وقد بينا ان هذه الاخبار في غاية الوهي وان الاحتجاج بالواهي باطل، وقد قلنا ان هذه الاخبار لا تصح ولو صحت لما كان في شء منها دليل علي ما ادعاه من ادعاه من الحرز بل كان الواجب حينءذ ان لا يقطع في شء مما يقع عليه اسم ثمر ولا اسم كثر وان يقطع في ذلك ان اواه الجرين رطبا كان او غير رطب فهذا كان يكون الحكم لو صح الخبر وما عدا هذا فباطل بظن كاذب فاذ لم تصح الاثار اصلا فالواجب ما قاله اصحابنا من ان القطع واجب في كل ثمر وفي كل كثر معلقا كان في شجره او مجذوذا او في جرين كان او في غير جرين اذا اخذه سارقا له مستخفيا باخذه غير مضطر اليه وبغير حق له فان القطع في كل طعام كان مما يفسد او لا يفسد اذا اخذه علي وجه السرقة غير مشهور باخذه.
 ولا حاجة اليه.
 ولا عن حق اوجب له اخذه
 فان القطع واجب في الزرع اذا اخذ من فدانه.
 او هو باندره علي وجه السرقة مستترا او مختفيا باخذه لا عن حاجة اليه ولا عن حق له، واما الماشية فالقطع فيها ايضا كذلك الا ان تكون ضالة ياخذها معلنا فيكون محسنا حيث ابيح له اخذها وعاصيا لا سارقا حيث لم يبح له اخذها فلا قطع ههنا لانه ليس سارقا، وانما القطع علي السارق وعمدتنا في ذلك قول الله تعالي: (والسارق والسارقة فاقطعوا ايديهما) وحكم رسول الله صلي الله عليه وسلم بقطع السارق عموما، وبالله تعالي التوفيق *  مسالة  الطير فيمن سرقها، قال ابو محمد رحمه الله: اختلف الناس في القطع في الطير اذا سرق كالدجاج.
 والاوز.
 وغيرها، فقالت طاءفة: لا قطع في شء من ذلك كما نا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ  نا ابن وضاح نا موسي بن معاوية نا وكيع نا سفيان الثوري عن جابر بن يزيد الجعفي عن عبد الله بن يسار قال: اتي عمر بن عبد العزيز برجل قد سرق.
 دجاجا فاراد ان يقطعه فقال ابو سلمة بن عبد الرحمن بن عوف كان عثمان يقول: لا قطع في طير فخلي عمر سبيله * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن عبد الله بن المبارك عن سفيان الثوري عن جابر الجعفي عن عبد الله بن يسار قال: اراد عمر بن عبد العزيز ان يقطع سارقا سرق دجاجة فقال له ابو سلمة بن عبد الرحمن بن عوف: ان عثمان بن عفان قال: لا قطع في طير، وعن ابي سلمة بن عبد الرحمن بن عوف ان عثمان بن عفان قال: لا قطع في طير * وبه يقول ابو حنيفة.
 واحمد بن حنبل.
 واصحابهما.
 واسحق بن راهويه: وقالت طاءفة: القطع فيه اذا سرق من حرز وهو قول مالك.
 والشافعي.
 واصحابهما: وقالت طاءفة: القطع فيها علي كل حال اذا سرقت * قال ابو محمد رحمه الله: فنظرنا فيما اختلفوا من ذلك فوجدنا من احتج بقول
 من لم ير القطع فيه فوجدناهم يقولون: ان ابطال القطع فيه قد روي عن عثمان بن عفان ولا يعرف له في ذلك مخالف من الصحابة وادعي بعضهم انه روي نحو ذلك عن علي وهذا لا يعرف وقالوا ان الاصل فيه انه تافه في الاصل مباح فاذا كان مملوكا لم يقطع سارقه اذا كان ما هذا وصفه لم يقطع سارقه، والطير اذا كان مباحا او كان فرخا فلا قيمة له وانما تصير له القيمة بعد ما يصير مملوكا بالتعليم فهذا كل ما موهوا به ما لهم شبهة غير ذلك وكل ذلك لا حجة لهم فيه اصلا * قال ابو محمد رحمه الله: فاذ قد عري قولهم من حجة وكان الطير مالا من الاموال فقد تعين ذلك ملكا لصاحبه كالدجاج.
 والحمام وشبهها وجب فيه القطع بقول الله تعالي: (والسارق والسارقة فاقطعوا ايديهما) وبايجاب رسول الله صلي الله عليه وسلم القطع علي من سرق، ولم يخص الله تعالي ولا رسوله عليه السلام من ذلك طيرا ولا غيره وتالله لو اراد الله تعالي الذي يعلم سر كل من خلق.
 وكل ما هو كاءن وحادث من حركة او نفس.
 وكلمة ابد الابد.
 وكل ما لا يكون لو كان كيف كان يكون ان يخص من القطع من سرق الطير لما اغفل ذلك ولا اهمله فنحن نشهد بشهادة الله تعالي ان الله تعالي لم يرد قط اسقاط القطع عن سارق الطير بل قد امر الله تعالي بقطعه نصا.
 والحمد لله رب العالمين *  مسالة  (الصيد) قال ابو محمد رحمه الله: يتعلق بهذا الباب  امر الصيد فان ابا حنيفة لا يري القطع في الصيد اذا تملك اصلا ولا يري القطع فيمن سرق ابلا متملكا من حرزه، ولا علي من سرق كذلك غزالا.
 او خشفا.
 او ظبيا.
 او حمارا وحشيا.
 او ارنبا.
 او غير ذلك من الصيد، وراي مالك.
 والشافعي.
 واصحابهما القطع في كل ذلك علي حسب الاختلاف الذي اوردناه عنهم في مراعاة الحرز * قال ابو محمد رحمه الله: وهذا مكان ما نعلم للحنيفيين فيه حجة اصلا ولا انه
 قال به احد قبل شيخهم بل هو خرق للاجماع، وخلاف للقران مجرد الا انهم ادعوا انهم قاسوه علي الطير * (فان قالوا): ان الصيد يشبه الطير في انهما حيوان وحشي مباح في اصله * (قيل لهم): فاسقطوا علي هذا القياس القطع عمن سرق ياقوتا.
 او ذهبا او فضة.
 او نحاسا.
 او حديدا.
 او رصاصا.
 او قذديرا.
 او زءبقا.
 او صوف البحر لان هذا كله اجسام مباحة في الاصل غير متملكة كالصيد ولا فرق فهذا تشبيه اعم من تشبيهكم وعلة اعم من علتكم، وايضا فانهم قد نقضوا هذا القياس فلم يقيسوا قاتل الدجاج الانسي علي الصيد المحرم في الاحرام، ولا قاسوا الانعام.
 والخيل عند من يبيحها علي ذوات الاربع من الصيد.
 وكان هذا كله نصا واجماعا متيقنا فصح ان القطع واجب علي من سرق صيدا متملكا كما هو واجب في ساءر الاموال، وبالله تعالي التوفيق *  مسالة  فيمن سرق خمرا لذمي.
 او لمسلم.
 او سرق خنزيرا كذلك.
 او ميتة كذلك * قال ابو محمد رحمه الله: نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج عن عطاء قال: من سرق خمرا من اهل الكتاب قال عطاء: زعموا في الخمر.
 والخنزير يسرقه المسلم من اهل الكتاب يقطع من اجل انه حل لهم في دينهم وان سرق ذلك من مسلم فلا قطع عليه * وبه الي عبد الرزاق عن معمر عن ابن ابي نجيح عن عطاء قال: من سرق خمرا من اهل الكتاب قطع، وقالت طاءفة: لا قطع عليه في ذلك ولكن يغرم لها مثلها وهذا قول شريح.
 وسفيان الثوري.
 ومالك.
 وابي حنيفة.
 واصحابهم: وقالت طاءفة: لا قطع عليه في ذلك ولا ضمان وهو قول الشافعي.
 واحمد واصحابهما وبه يقول اصحابنا: * قال ابو محمد رحمه الله: فنظرنا في ذلك فراينا قول من اوجب الضمان واسقط
 القطع في غاية الفساد لانه لا يخلو الخمر.
 والخنزير من ان يكونا مالا للذمي له قيمة.

 او لا يكونا مالا له، ولا سبيل الي قسم ثالث اصلا فان كانت الخمر.
 والخنزير مالا للذمي لهما قيمة فالقطع فيهما واجب علي اصولهم اذا بلغ كل واحد منهما ما فيه القطع وان كان الخمر.
 والخنزير لا قيمة لهما وليسا مالا للذمي فباي وجه قضوا بضمان ما لا قيمة له ولا هو مال وهل هذا منهم الا قضاء بالباطل؟ وايكال مال بغير حق لا سيما وهم يقولون: ان المسلم ان سرق خمرا لمسلم.
 او خنزيرا لمسلم فلا قطع ولا ضمان لانهما ليسا مالا له ولا لهما قيمة، والعجب كله كيف يقضون بضمانهما عليه وهو لاسبيل له الي قضاءهما لانه عندهم مما يكال او يوزن ففيهما المثل عندهم، ثم نظرنا في قول من راي القطع في ذلك والضمان وقول من لا يري في ذلك لا قطعا ولا ضمانا فنظرنا فيمن راي القطع والضمان فلم نجد لهم حجة اصلا الا ان قالوا: انها مال لهم ولها قيمة عندهم فقلنا: لهم اخبرونا ابحق من الله تملكوها واستحقوا ملكها وشربها ام بباطل؟ ولا سبيل الي قسم ثالث (فان قالوا): بحق وامر من الله تعالي كفروا بلا خلاف وهم لا يقولون هذا.
 ويلزمهم ان يقولوا ان دين اليهود والنصاري حق وهذا لا يقوله مسلم اصلا قال الله تعالي: (ان الدين عند الله الاسلام) وقال تعالي: (ومن يبتغ غير الاسلام دينا فلن يقبل منه) فاذا قد صح ما قلنا وصح ان الله تعالي حرم شرب الخمر علي كل مسلم وكافر.
 وحرم بيعها علي كل مسلم وكافر.
 وحرم ملكها علي كل مسلم وكافر بقوله تعالي امرا للرسول عليه السلام ان يقول: (يا ايها الناس اني رسول الله اليكم جميعا) وبقوله عليه السلام " كل مسكر حرام وان الذي حرم شربها حرم بيعها " ثبت انها ليست مالا لاحد وانه لا قيمة لها اصلا.
 وكذلك الخنزير للتحريم الوارد فيه جملة فاذ قد حرم ملكها جملة كان من سرقها لم يسرق مالا لاحد لا قيمة لها اصلا ولا سرق شيءا يحل ابقاءه جملة فلا شء عليه والواجب هرقها علي كل حال لمسلم وكافر.
 وكذلك قتل
 الخنازير، وبالله تعالي التوفيق * قال ابو محمد رحمه الله: واما من سرق ميتة فان فيها القطع لان جلدها باق علي ملك صاحبها يدبغه فينتفع به ويبيعه (فان قيل): ما الفرق بين الخنزير والميتة اوجبتم القطع في الميتة من اجل جلدها ولم توجبوا القطع في الخنزير فهلا اوجبتموه من اجل جلده وجلده وجلد ساءر الميتات سواء في جواز الانتفاع به وبيعه اذا دبغ؟ * (فجوابنا) ان الفرق بينهما في غاية الوضوح ولله الحمد وهو ان الميتة كانت في حياتها متملكة لصاحبها باسرها فلما ماتت سقط ملكه عن لحمها.
 وشحمها.
 ودمها ومعاها.
 وفرثها.
 ودماغها.
 وغضاريفها لان كل هذا حرام مطلق التحريم وبقي  ملكه كما كان علي ما اباح الله تعالي له الانتفاع به منها وهو الجلد.
 والشعر.
 والصرف والوبر.
 والعظم فلا يخرج عن ملكه الا باباحته اياه لانسان بعينه او لمن اخذه ويعلم ذلك بطرحه الجميع وتبريه منه فهو ما لم يطرحه مالك لذلك فان سرق فانما سرق شيءا متملكا ملكا صحيحا ومال من مال مسلم.
 او ذمي فالقطع فيه، واما الخنزير فلا يقع عليه في حياته ملك لاحد لانه رجس محرم جملة فمن سرقه حيا.
 او ميتا فانما اخذ مالا لا مالك له وما لا يحل لاحد تملكه فجلده لمن بادر اليه.
 واخذه.
 ودبغه فاذا دبغ صار حينءذ ملكا من مال متملكه من سرقه فعليه فيه القطع، والقطع واجب في عظام الفيل كما ذكرنا والميتات كلها كذلك لان رسول الله صلي الله عليه وسلم قال: " انما حرم اكلها " حاش عظم الخنزير وشعره وكل شء منه حرام جملة لا يحل لاحد تملك شء منه الا الجلد فقط بالدباغ لقول رسول الله صلي الله عليه وسلم: " ايما اهاب دبغ فقد طهر " وبالله تعالي التوفيق *  مسالة  فيمن سرق حرا صغيرا.
 او كبيرا * قال ابو محمد رحمه الله: لا نعلم خلافا في ان من سرق عبدا صغيرا لا يفهم ان عليه القطع، واختلف الناس فيمن
 سرق عبدا كبيرا يتكلم، وفيمن سرق حرا صغيرا او كبيرا، فاما العبد الصغير الذي لا يفهم فان الذي سرقه سارق مال فعليه القطع، واما من سرق العبد الذي يفهم فانما اسقط عنه القطع من اسقطه لانه لولا انه اطاعه ما امكنه سرقته اياه * قال ابو محمد رحمه الله: وهذا لا ينبغي ان يطلق اطلاقا لان في الممكن ان يسرقه وهو ناءم.
 او سكران.
 او مغمي عليه.
 او متغلبا عليه متهددا بالقتل فلا يقدر علي الامتناع.
 ولا علي الاستغاثة فاذا كان هكذا فهي سرقة صحيحة قد تمت منه واذ هي صحيحة فالقطع عليه بنص القران * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج قال اخبرت ان عمر بن الخطاب قطع رجلا في غلام سرقه، وبه الي عبد الرزاق عن سفيان الثوري عن اسماعيل عن الحسن البصري قال: من سرق صغيرا حرا.
 او عبدا قطع، قال ابراهيم النخعي: يقام الحد علي الكبير وليس علي الصغير من شء  يعني انه يقطع الكبير في سرقة الصغير  وبه الي عبد الرزاق عن معمر قال سالت الزهري عمن سرق عبدا اعجميا لا يفقه قال: يقطع، وبالقطع في سرقة العبد الصغير يقول ابو حنيفة.
 ومحمد بن الحسن.
 ومالك.
 والشافعي.
 واحمد.
 واصحابهم.
 واسحق.
 واصحابنا.
 وسفيان الثوري.
 وذكر عن ابي يوسف انه استحسن ان لا يقطع، واما من سرق حرا فان حمام بن احمد نا قال: نا ابن مفرج  نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج قال: اخبرت ان عليا قطع الباءع باءع الحر وقال: لا يكون الحر عبدا، وقال ابن عباس: ليس عليه قطع وعليه شبيه بالقطع الحبس، وقال ابو حنيفة: وسفيان.
 واحمد.
 وابو ثور: لا قطع علي من سرق حرا صغيرا كان او كبيرا، وقال مالك.
 واسحاق بن راهويه: علي من سرق حرا صغيرا القطع، وذكر هذا عن الحسن البصري.
 والشعبي * قال ابو محمد رحمه الله: وقد جاء في هذا اثر لا علينا ان نذكره لان الحنيفيين
 ياخذون باقل منه اذا وافقهم، وهو كما نا القاضي عبد الله بن عبد الرحمن بن جحاف المعافري بسلنسيه نا محمد نا ابراهيم بطليطلة نا بكر بن العلاء القشيري بمصر نا زكريا بن يحيي الساجي البصري نا القاسم بن اسحق الالصاري نا ابي نا عبد الله بن محمد بن يحيي بن عروة بن الزبير عن هشام بن عروة عن ابيه عن عاءشة ان رسول الله صلي الله عليه وسلم اتي برجل كان يسرق الصبيان فامر به فقطع * قال ابو محمد رحمه الله: فليس فيه تخصيص حر من عبد، وبالله تعالي التوفيق *  مسالة  من سرق المصحف، قال ابو محمد رحمه الله: قال ابو حنيفة.
 واصحابه.
 لا قطع علي من سرق مصحفا سواء كانت عليه حلية فضة تزن ماءتي درهم.
 او اكثر: او اقل.
 او لم تكن، وقال مالك.
 والشافعي.
 واصحابنا عليه القطع * قال ابو محمد رحمه الله: واحتج من لم ير القطع بان قال: ان له فيه حق التعليم لانه ليس له منعه عمن احتاج اليه قال: فلما كان له فيه حق كان كمن سرق من بيت المال قال والفضة تبع لانها تدخل في بيعه كما يدخل في بيعه الجلد والدفتان وهذا كلام في غاية الفساد والباطل اول ذلك قولهم: لان له فيه حق التعليم وقد كذب انما حق المتعلم في التلقين فقط لا في مصحف الناس اصلا اذ لم يوجبه قران.
 ولا سنة.
 ولا اجماع، وانما فرض علي الناس تعليم بعضهم بعضا القران تدريسا وتحفيظا وهكذا كان جميع الصحابة رضي الله عنهم في عهد رسول الله صلي الله عليه وسلم بلا خلاف من احد انه لم يكن هنالك مصحف، وانما كانوا يلقنه بعضهم بعضا ويقرءه بعضهم بعضا فمن احتاج منهم ان يقيد ما حفظ كتبه في الاديم.
 وفي اللخاف.
 والالواح: والاكتاف فقط فبطل قوله ان للسارق حقا في المصحف وصح ان لصاحب المصحف منعه من كل احد اذ لا ضرورة باحد اليه * قال ابو محمد رحمه الله: فصح ان القطع واجب في سرقة المصحف كانت عليه حلية او لم تكن لقول الله تعالي: (والسارق والسارقة فاقطعوا ايديهما) *

 قال ابو محمد رحمه الله: ويلزمهم ان لا يوجبوا القطع علي من سرق كتب العلم وهذا خطا بل القطع في كل ذلك واجب، وبالله تعالي التوفيق *   مسالة  سراق اختلف الناس في وجوب القطع عليهم * قال ابو محمد رحمه الله: قال ابو حنيفة.
 واصحابه لا يقطع من سرق صليبا او وثنا ولو كان من فضة.
 او ذهب قال: فان سرق دراهم فيها صور اصنام او صور صلبان فعليه القطع لان ذلك يعبد وهذا لا يعبد * قال ابو محمد رحمه الله: وهذا خطا.
 وتناقض.
 واحتجاج فاسد، اما الخطا فاسقاط الحد الذي افترض الله تعالي من القطع علي السارق، وانما وجب القطع علي سارق الصليب لانه سرق جوهرا لا يحل له اخذه، وانما الواجب فيه كسره فقط واما ملك جوهره فصحيح، ولا فرق بينه وبين من سرق اناء ذهب واناء فضة والنهي قد صح عن اتخاذ انية الفضة والذهب كما صح عن اتخاذ الصليب والوثن ولا فرق والقطع واجب في كل ذلك لانه لم يسرق الصورة ولا شكل الاناء وانما سرق الجسم الحلال تملكه وانما الواجب في الانية المذكورة.
 والصلبان.
 والاوثان الكسر فقط فان كان الصليب.
 او الوثن من حجر لا قيمة له اصلا بعد الكسر فلا قطع فيه اصلا لما ذكرناه قبل من قول عاءشة رضي الله عنها ان يد السارق لم تكن تقطع في عهد رسول الله صلي الله عليه وسلم في الشء التافه وسنستقصي الكلام في ذلك ان شاء الله تعالي في كلامنا في مقدار ما يقطع فيه السارق، واما التناقض فظاهر ايضا لانه لا فرق بين صورة وصورة بلا برهان وكلاهما محرم تصويره ومتوعد عليه بالعذاب الشديد يوم القيامة، واما فساد احتجاجه بان الصليب يعبد والصورة التي في الدراهم لا تعبد فان الهند يعبدون البقر كما يعبد النصاري الصليب ويعظمونها كما يعظم الصليب ولا فرق فيلزمه ايضا ان لا يقطع في سرقة البقر (فان قالوا): اننا نحن لا نعبدها (قلنا لهم): واننا نحن ايضا
 لا نعبد الصليب ولا نعظمه، والحمد لله رب العالمين، والعجب كل العجب من اسقاط ابي حنيفة القطع عن سارق الصليب وهو يقتل المسلم اذا قتل عابد الصليب فلءن كان لعابد الصليب من الحرمة عندهم ما يستباح به دم المسلم فان لمال عابد الصليب من الحرمة ما تستباح به يد سارقه والصليب مال من ماله هذا علي ان النهي قد صح ان لا يقتل مءمن بكافر عن رسول الله صلي الله عليه وسلم نعم وعن الله تعالي في القران اذ يقول: (ولن يجعل الله للكافرين علي المءمنين سبيلا) واذ يقول تعالي: (افنجعل المسلمين كالمجرمين ما لكم كيف تحكمون) ولم يات نهي قط عن قطع يد من سرق مال كافر ذمي بل امر الله تعالي  بقطعه في عموم قوله: (والسارق والسارقة فاقطعوا ايديهما) وقد علم الله تعالي ان السارق يسرق من مسلم ومن ذمي فنحن نقسم بالله تعالي انه لو اراد استثناء سارق مال الذمي لما سكت عن ذلك ولا نسيه ولبينه كما بين لنا ان لا يقتل مءمن بكافر، وبالله تعالي التوفيق *  مسالة  احضار السرقة، قال ابو محمد رحمه الله.
 قال المالكيون: من اقر بسرقة دراهم كثيرة او قليلة او غير ذلك فان القطع لا يجب بذلك الا حتي يحضر ذلك الشء الذي اقر بسرقته * قال ابو محمد رحمه الله: وهذا ايضا خطا لانه رد لما امر الله تعالي به من قطع السارق ولم يشترط احضار السرقة (وما كان ربك نسيا) لكن الواجب قطعه ولا بد ثم يلزمه احضار ما سرق ليرد الي صاحبه ان عرف او ليكون في جميع مصالح المسلمين ان لم يعرف صاحبه فان عدم الشء المسروق ضمنه علي ما نذكر بعد هذا ان شاء الله تعالي * قال ابو محمد رحمه الله: ولا نعلم لمن خالف هذا حجة اصلا فان تعلقوا بما ناه عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب عن ابن ابي ذءب عن ابن شهاب ان طارقا كان جعله ثعلبة الشامي علي المدينة يستخلفه فاتي بانسان
 متهم بسرقة فجلده فلم يزل يجلده حتي اعترف بالسرقة فارسل الي ابن عمر فاستفتاه فقال ابن عمر: لا تقطع يده حتي يبرزها، فهذا لا حجة لهم فيه لان من اقر تحت العذاب وبالتهديد فلا قطع عليه وسواء ابرز السرقة او لم يبرزها لانه قد يكون اودعت عنده وهو يدري انها سرقة او لا يدري فلا يكون علي المودع في ذلك قطع اصلا ويحتمل قول ابن عمر هذا  اي حتي يبرز  قولته مجردة من الاقرار بالضرب مع انه لا حجة في احد دون رسول الله صلي الله عليه وسلم وكم قولة لابن عمر قد خالفوها بلا برهان، فان ذكروا ما روينا بالسند المذكور الي ابن وهب قال: اخبرني يحيي بن ايوب قال: كتب الي يحيي بن سعيد يقول من اعترف بسرقة ثم اتي مع ذلك بما يصدق اعترافه فذلك الذي تقطع يده، ومن اعترف علي تهدد وتخوف ثم لم يات بما يصدق اعترافه فان ناسا يزعمون ان يقطعوا في مثل هذا، وبه الي ابن وهب عن يونس بن يزيد عن ربيعة قال من اعترف بعد امتحان فلم يوجد ذلك عنده ولم يوجد ما يصدقه من عمله فان اعترافه لم يكن متصلا ولا اقامته علي الاعتراف خشية ان يكون عليه من البلاء ما قد دفع عنه من البلاء باعترافه فنري ان لا يءخذ باعترافه الا ان ياتي وجه البينة والمعرفة انه صاحب تلك السرقة وهذا لا حجة لهم فيه لان من اقر بسرقة فلا يخلو من ان يكون اقر بلا تهديد ولا عذاب.
 او اقر بتهديد وعذاب  فان اقر بتهديد وعذاب فلا قطع عليه اصلا احضر السرقة.
 او لم يحضرها اذ قد يدري موضعها، او جعلت عنده فلا قطع عليه، وان كان اقر بلا تهديد ولا عذاب فالقطع عليه اخرج السرقة.
 او لم يخرجها لما ذكرنا قبل، واما قول ربيعة ان لا يءخذ المكره باعتراف الا ان ياتي وجه البينة والمعرفة انه صاحب تلك السرقة فقول صحيح لا شك فيه انه اذا جاء ببيان يتيقن به دون شك انه سرقها فالقطع واجب وسواء حينءذ اقر تحت العذاب او دون عذاب وكذلك لو عذب او اقر وجاءت بينة تشهد بانهم راوه يسرق لوجب قطع يده بالسرقة لا باقراره، وقد قلنا: ان احضار الشء المسروق ليس بيانا في انه هو سرقه
 وانما هو ظن ولا يحل قطع يد مسلم بالظن، قال الله تعالي: (ان يتبعون الا الظن وان الظن لا يغني من الحق شيءا) وقال رسول الله صلي الله عليه وسلم: " اياكم والظن فان الظن اكذب الحديث " * قال ابو محمد رحمه الله: وقد روينا عن ابي بكر الصديق بحضرة عمر بن الخطاب وساءر الصحابة رضي الله عنهم انه قطع الا قطع باقرار مجرد دون احضار السرقة وان السرقة انما وجدت عند الصاءغ او عنده وقد يمكن ان توضع في رحله بغير علمه * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر.
 وسفيان الثوري كلاهما عن الاعمش عن القاسم بن عبد الرحمن بن عبد الله بن مسعود عن ابيه قال: جاء رجل الي علي بن ابي طالب فقال: اني سرقت فرده فقال: اني سرقت فقال: شهدت علي نفسك مرتين فقطعه، قال عبد الرحمن: فرايت يده في عنقه معلقة، وبه الي عبد الرزاق عن ابن جريج قال قلت لعطاء: رجل شهد علي نفسه مرة واحدة قال: حسبه * قال ابو محمد رحمه الله: انما اوردنا هذا لءلا يشغبوا فيما يذكرونه من احضار السرقة بما ذكرنا عن ابن عمر فاوجدناهم عن علي اصح مما وجدوا لابن عمر قطعا بغير احضار السرقة وكذلك عن عطاء والا فلا حجة في احد دون رسول الله صلي الله عليه وسلم * قال ابو محمد رحمه الله: وقال بعض من لا يري درا الحد عن السارق برجوعه انه ان اقر ثم رجع فلا قطع عليه لكن يغرم السرقة الذي اقر انه سرقها منه وهذا تناقض وخطا لانه لم يقر له بشء الا علي وجه السرقة (قلنا): فلا يخلو اقراره ذلك ضرورة من احد وجهين لا ثالث لهما، اما ان يكون صادقا في انه سرق منه ما ذكر او يكون كاذبا في ذلك، فان كان صادقا فقد عطلوا الفرض اذ لم ينفدوا عليه ما امر الله تعالي به من قطع يد السارق، وان كان كاذبا فقد ظلموه اذ غرموه ما لم يجب له عنده فقط، ولا  صح اقراره به فهم بين تعطيل الفرض.
 او ظلم في اباحة مال محرم وكلاهما لا يحل
 وبالله تعالي التوفيق *  مسالة  اختلاف الشهادة في ذلك * قال ابو محمد رحمه الله: قال الشافعي.
 وابو يوسف.
 ومحمد بن الحسن.
 وابو ثور: ان اختلف الشاهدان فقال احدهما سرق بقرة، وقال الاخر: بل ثورا، او قال احدهما سرق بقرة حمراء.
 وقال الاخر بل سوداء، او قال احدهما: سرق يوم الخميس، وقال الاخر: بل يوم الجمعة فلا قطع عليه، فان قال احدهما: سرق بقرة حمراء، وقال الاخر: بل سوداء فعليه القطع وقال مالك: ان قال احد الشاهدين: سرق يوم الخميس، وقال الاخر: بل يوم الجمعة، وقال اثنان: زني يوم الخميس، وقال اثنان: بل يوم الجمعة فقد بطل عنه حد السرقة وحد الزنا قال فلو قال احدهما قذف زيدا يوم الجمعة، وقال الاخر: قذفه يوم الخميس.
 او قال احدهما: شرب الخمر يوم الخميس، وقال الاخر: بل يوم الجمعة فعليه حد القذف وحد الخمر وهذا كله تخليط، وانما اوردناه لنري بعون الله تعالي من نصح نفسه واراد الله تعالي به خيرا بطلان اقوالهم في التشبيه الذي هو عندهم اصل لقياسهم الباطل وانه من ميزه لم يعجز ان يعارض عللهم بمثلها او باقوي منها فنقول لجميعهم: اخبرونا عمن شهد عليه شاهدان بانه سرق بقرة حمراء، وقال الاخر بيضاء، وعمن شهد عليه شاهدان بانه قذف زيدا، وقال احدهما: امس، وقال الاخر: بل اليوم.
 او قال احدهما: شرب خمرا امس، وقال الاخر: بل اليوم اهذه الشهادة علي سرقة واحدة.
 او علي سرقتين مختلفتين، وعلي قذف واحد ام علي قذفين متغايرين.
 وعلي شرب واحد ام علي شربين مفترقين (فان قالوا): بل علي سرقة واحدة.
 وشرب واحد.
 وقذف واحد كابروا العيان لانه لا يشك ذو حس سليم في ان شرب يوم الخميس ليس هو شرب يوم الجمعة وانما هو شرب اخر وان سرق بقرة صفراء ليس هي سرقة بقرة سوداء، وانما هي سرقة اخري (وان قالوا): بل هي سرقتان مختلفتان.
 وشربان مختلفان وقذفان مختلفان متغايران (قيل لهم): فاي فرق بين هذا وبين الشهادات بزنا مختلف او بسرقة ثور.
 او بقرة
 او باختلاف الشهادة في المكان وهذا ما لا سبيل لهم منه الي التخلص اصلا لا بنص قران.
 ولا سنة صحيحة.
 ولا اجماع.
 ولا قول صاحب.
 ولا قياس.
 ولا راي سديد فسقط بيقين قول من فرق بين الاحكام التي ذكرنا ولم يبق الا قول من ساوي بينهما فراعي الاختلاف في كل ذلك.
 او لم يراع الاختلاف في شء من ذلك * قال ابو محمد رحمه الله: فوجدنا من راعي الاختلاف في كل ذلك يقول: اذا  اختلف الشاهدان في صفة المسروق.
 او في زمانه.
 او في مكانه فانما حصل من قولهم فعلان متغايران فاذ ذلك كذلك فانما حصل علي فعل شاهد واحد ولا يجوز القطع بشاهد واحد وكذلك القذف فلا يجوز اقامة حد قذف.
 ولا حد خمر بشاهد واحد فهذه حجتهم ما لهم حجة غيرها فنظرنا فيها فوجدناها لا تصح لان الذي ينبغي ان يضبط في الشهادة ويطلب به الشاهد انما هو ما لا تتم الشهادة الا به والذي ان نقص لم تكن شهادة فهذا هو الذي ان اختلف الشاهد فيه بطلت الشهادة لانها لم تتم، واما ما لا معني لذكره في الشهادة.
 ولا يحتاج اليه فيها.
 وتتم الشهادة مع السكوت عنه فلا ينبغي ان يلتفت اليه، وسواء اختلف الشهود فيه.
 او لم يختلفوا.
 سواء ذكروه.
 او لم يذكروه واختلافهم فيه كاختلافهم في قصة اخري ليست من الشهادة في شء ولا فرق فلما وجب هذا كان ذكر اللون في الشهادة لا معني له وكان ايضا ذكر الوقت في الشهادة في الزنا.
 وفي السرقة.
 وفي القذف.
 وفي الخمر لا معني له.
 وكان ايضا ذكر المكان في كل ذلك لا معني له فكان اختلافهم في كل ذلك كاتفاقهم كسكوتهم ولا فرق لان الشهادة في كل ذلك تامة دون ذكر شء من ذلك وانما حكم الشهادة وحسب الشهود ان يقولوا: انه زني بامراة اجنبية نعرفها اولج ذكره في قبلها راينا ذلك فقط وما نبالي قالوا: انها سوداء.
 او بيضاء.
 او زرقاء.
 او كحلاء مكرهة.
 او طاءعة.
 امس او اليوم.
 او منذ سنة بمصر.
 او ببغداد وكذلك لو اختلفوا في لون ثوبه حينءذ.
 او لون عمامته، وكذلك حسبهم ان يقولوا: سرق راسا من البقر
 مختفيا باخذه ولا عليهما ان يقولا: اقرن.
 او اعضب.
 او ابتر.
 او وافي الذنب ابيض او اسود، وهكذا في القذف.
 وشرب الخمر ولا فرق، فصح ان الشهادة في كل ذلك تامة مع اختلاف الشهود وما لا يحتاج الي ذكره في الشهادة اذا اقتضت شهادتهم وجود الزنا منه.
 او وجود السرقة.
 او وجود القذف منه او وجود شرب الخمر منه فقط لانهم قد اتفقوا في ذلك، وهذا هو الموجب للحد فانما اوجب الله تعالي الحد في كل ذلك بوقوع الزنا ووجوب السرقة او القذف واثبت الاربعة الزنا فقد وجب الحد في ذلك بنص القران.
 والسنة ولم يقل الله تعالي قط ولا رسوله صلي الله عليه وسلم لا تقبلوا الشهادة حتي يشهدوا علي زنا واحد في وقت واحد في مكان واحد وعلي سرقة واحدة لشء واحد في وقت واحد في مكان واحد (وما كان ربك نسيا) وتالله لو اراد الله تعالي ذلك لما اهمله ولا اغفله حتي يبينه فلان وفلان وحاش لله من هذا، فصح ان ما اشترطوه من ذلك خطا لا معني له، وبالله تعالي التوفيق * فليعلموا ان قولهم لا نعلمه عن احد من الصحابة رضي الله عنهم ولا نذكره عن تابع الا شيءا ورد عن قتادة *

 حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن قتادة في رجل شهد عليه رجل انه سرق بارض وشهد عليه اخر بانه سرق بارض احري قال: لا قطع عليه، وقد صح عن بعض التابعين ممن نعلمه اعلي من قتادة خلاف هذا كما نا عبد الله بن ربيع نا عبد الله بن محمد بن عثمان نا احمد بن خالد نا علي بن عبد العزيز نا الحجاج بن المنهال نا حماد بن سلمة انا هشام بن عروة بن الزبير عن ابيه قال: تجوز شهادة الرجل وحده في السرقة، وقد ذكرنا مثل هذا عن عبيد الله بن ابي بكرة وان كنا لا نقول به ولكن ليريهم ان تمويههم بانها شهادة واحدة علي فعل واحد كلام فاسد وبالله تعالي التوفيق *  مسالة  القطع في الضرورة  قال ابو محمد رحمه الله: نا حمام
 نا ابن مفرج نا ابن الاعرابي حدثنا الدبري نا عبد الرزاق عن معمر عن يحيي بن ابي كثير قال: قال عمر بن الخطاب: لا تقطع في عذق.
 ولا في عام السنه، وبه الي معمر عن ابان ان رجلا جاء الي عمر بن الخطاب في ناقة نحرت فقال له عمر: هل لك في ناقتين عشراوين مرتعتين سمينتين بناقتك؟ فانا لا نقطع في عام السنة  والمرتعتان الموطاتان  * قال ابو محمد: من سرق من جهد اصابه فان اخذ مقدار ما يغيث به نفسه فلا شء عليه وانما اخذ حقه فان لم يجد الا شيءا واحدا ففيه فضل كثير كثوب واحد او لءلءة.
 او بعير.
 او نحو ذلك فاخذه كذلك فلا شء عليه ايضا لانه يرد فضله لمن فضل عنه لانه لم يقدر علي فضل قوته منه، فلو قدر علي مقدار قوته يبلغه الي مكان المعاش فاخذ اكثر من ذلك وهو ممكن لا ياخذه فعليه القطع لانه سرق ذلك عن غير ضرورة، وان فرضا علي الانسان اخذ ما اضطر اليه في معاشه فان لم يفعل فهو قاتل نفسه وهو عاص لله قال الله تعالي: (ولا تقتلوا انفسكم) وهو عموم لكل ما اقتضاه لفظه، وبالله تعالي التوفيق *  مسالة  من سرق من ذي رحم محرمة  قال ابو محمد رحمه الله: اختلف الناس فيمن سرق من مال كل ذي رحم محرمة فقال مالك.
 وابو حنيفة.
 والشافعي.
 واحمد بن حنبل.
 واصحابهم.
 وسفيان الثوري.
 واسحق: ان سرق الابوان من مال ابنهما.
 او بنتهما فلا قطع عليهما، قال الشافعي: وكذلك الاجداد والجدات كيف كانوا لا قطع عليهم فيما سرقوه من مال من تليه ولادتهم، وقال: هءلاء كلهم حاشي مالكا.
 وابا ثور لا قطع علي الولد ولا علي البنت فيما سرقاه من  مال الوالدين.
 او الاجداد.
 او الجدات، قال مالك.
 وابو ثور: عليهما القطع في ذلك، وقال الثوري.
 وابو حنيفة.
 واصحابه: لا قطع علي كل من سرق مالا
 لاحد من رحمه المحرمة، وقال اصحابنا: القطع واجب علي من سرق من ولده.
 او من والديه.
 او من جدته.
 او من جده.
 او من ذي رحم محرمة.
 او غير محرمة واتفقوا كلهم انه يقطع فيما سرق من ذي رحمه غير المحرمة، وفيما سرق من امه من الرضاعة، وابنته وابنه من الرضاعة واخوته من الرضاعة * قال ابو محمد: فلما اختلفوا كما ذكرنا وجب ان ننظر في ذلك لنعلم الحق فنتبعه بعون الله تعالي فنظرنا في قول من اسقط القطع عن الابوين في مال الولد اذا سرقه فوجدناهم يحتجون بالثابت عن رسول الله صلي الله عليه وسلم من قوله: " انت ومالك لابيك " قالوا: فانما اخذ ماله وقالوا: لو قتل ابنه لم يقتل به ولو زني بامة ابنه لم يحد لذلك فكذلك اذا سرق من ماله قال وفرض عليه ان يعفف اباه اذا احتاج الي الناس فله في ماله حق بذلك، وقالوا له في ماله حق اذا احتاج اليه كلف الانفاق عليه، وقالوا قال الله تعالي: (وبالوالدين احسانا) وقال تعالي: (ان اشكر لي ولوالديك) وقال تعالي: (ولا تقل لهما اف ولا تنهرهما) الي قوله: (كما ربياني صغيرا) فليس قطع ايديهما فيما اخذ من ماله رحمة، فهذا كل ما شغبوا به في كل ذلك وكل ذلك لا حجة لهم في شء منه بل هو عليهم كما نبين ان شاء الله تعالي * اما ما ذكروا من القران فحق الا انه لا يدل علي ما ادعوا من اسقاط القطع فيما سرقوا من مال الولد ولا علي اسقاط الجلد والرجم او التغريب اذا زني بجارية الولد ولا علي اسقاط الحد اذا قذف الولد ولا علي اسقاط المحاربة اذا قطع الطريق علي الولد * اما قوله تعالي: (وبالوالدين احسانا) فان الله تعالي اوجب الاحسان اليهما كما اوجبه علينا ايضا لغيرنا قال الله تعالي: (وبالوالدين احسانا وبذي القربي واليتامي والمساكين وابن السبيل والجار ذي القربي) الاية فان كانت مقدمة الاية حجة بوجوب الاحسان الي الابوين في اسقاط القطع عنهما اذا سرقا من مال الولد فهي حجة ايضا ولا بد في اسقاط القطع عن كل ذي قربي وعن ابن السبيل وعن
 الجار الجنب.
 والصاحب بالجنب اذا سرقوا من اموالنا وهذا ما لا يقولونه فظهر تناقضهم وبطل احتجاجهم بالاية، وايضا فالامر بالاحسان ليس فيه منع من اقامة الحدود بل اقامتها عليهم من الاحسان اليهم بنص القران لقول الله تعالي: (ان الله يامر بالعدل والاحسان) وقد امرنا باقامة الحدود فاقامتها علي من اقيمت عليه  احسان اليه وانها تكفير وتطهير لمن اقيمت عليه وهم لا يختلفون في ان اماما لو كان له اب او ام فسرقا فان فرضا عليه اقامة القطع عليهما فبطل تمويههم بالاية جملة وصح انها حجة عليهم * واما قوله تعالي: (ان اشكر لي ولوالديك) فحق ومن الشكر اقامة امر الله تعالي عليهما وليس يقتضي شكرهما اسقاط ما امر الله تعالي به فيهما والذي امر بشكرهما تبارك اسمه هو الذي يقول: (كونوا قوامين بالقسط شهداء لله ولو علي انفسكم او الوالدين والاقربين) فصح امر الله تعالي بالقيام عليهم بالقسط وباداء الشهادة عليهم ومن القيام بالقسط اقامة الحدود عليهم وبالله تعالي التوفيق، وهكذا القول في قوله تعالي: (ولا تقل لهما اف ولا تنهرهما) الاية فليس في شء من هذا اسقاط الحد عنهم في سرقة من مال الولد ولا في غير ذلك والله تعالي يقول: (اشداء علي الكفار رحماء بينهم) ولم يكن وجوب الرحمة لبعضنا مسقطا لاقامة الحدود بعضنا علي بعض فبطل تعلقهم بالايات المذكورات جملة * واما قول رسول الله صلي الله عليه وسلم: " انت ومالك لابيك " فقد اوضحنا ذلك ان ذلك خبر منسوخ قد صح نسخه بايات المواريث وغيرها، واول من يحتج بهذا الخبر فالحنيفيون.
 والمالكيون.
 والشافعيون لانهم لا يختلفون في ان الاب اذا اخذ من مال ابنه درهما وهو غير محتاج اليه فانه يقضي عليه برده احب ام كره كما يقضي بذلك علي الاجنبي ولا فرق ولو كان مال الولد للوالد لما قضي عليه برد ما اخذ منه فاذ قد صح ان هذا الخبر منسوخ وصح ان مال الولد للولد لا للوالد فقد صح انه كمال الاجنبي ولا فرق *
 (فان قالوا) ان للوالدين حقا في مال الولد لانهما اذا احتاجا اجبر علي ان ينفق عليهما وعلي ان يعف اباه فاذ له في ماله حق فلا يقطع فيما سرق منه فهذا تمويه ظاهر ولم يخالفهم احد في ان الوالدين اذا احتاجا فاخذا من مال ولدهما حاجتهما باختفاء او بقهر او كيف اخذاه فلا شء عليهما فانما اخذا حقهما وانما الكلام فيهما اذا اخذا ما لا حاجة بهما اليه اما سرا واما جهرا فاحتجاجهما بما ليس من مسالتهما تمويه وهم لا يختلفون فيمن كان له حق عند احد فاخذ من ماله مقدار حقه فانه لا يقطع ولا يقضي عليه برده فلو كان وجوب الحق للابوين في مال الولد اذا احتاجا اليه مسقطا للقطع عنهما اذا سرقا من ماله ما لا يحتاجان اليه ولا حق لهما فيه لوجب ضرورة ان يسقط القطع عن الغريم الذي له الحق في مال غريمه اذا سرق منه ما لا حق له فيه وهذا لا يقولونه فبطل ما موهوا به من ذلك والحمد لله رب العالمين * واما قولهم: لو قتل ابنه لم يقتل به ولو قطع له عضوا وكسره لم يقتص منه ولو قذفه لم يحد له ولو زني بامته لم يحد  فكذلك اذا سرق من ماله لم يحد فكلام باطل واحتجاج للخطا بالخطا بل لو قتل ابنه لقتل به ولو قطع له عضوا او كسره لاقتص منه ولو قذفه لحد له ولو زني بامته لحد كما يحد الزاني وقد بينا كل هذا في ابوابه في كتاب الدماء.
 والقصاص.
 وحد الزنا وحد القذف * قال ابو محمد رحمه الله: فاذ لم يبق لهم حجة اصلا فالواجب ان نرجع عند التنازع الي ما افترض الله تعالي علي المسلمين الرجوع اليه اذ يقول: (فان تنازعتم في شء فردوه الي الله والرسول) الاية ففعلنا فوجدنا الله تعالي يقول: (والسارق والسارقة فاقطعوا ايديهما) ووجدنا رسول الله صلي الله عليه وسلم قد اوجب القطع علي من سرق، وقال: " ان دماءكم واموالكم عليكم حرام " فلم يخص الله تعالي في ذلك ولا رسوله صلي الله عليه وسلم ابنا من اجنبي ولا خص في الاموال مال اجنبي من مال
 ابن (وما كان ربك نسيا) وبيقين ندري ان الله تعالي لو اراد تخصيص الاب من القطع لما اغفله ولا اهمله قال تعالي: (تبيانا لكل شء) فصح ان القطع واجب علي الاب والام اذا سرقا من مال ابنهما ما لا حاجة بهما اليه ثم نظرنا في قول من احتج به من راي اسقاط القطع عن الابن اذا سرق من مال ابويه وعن كل ذي رحم محرمة فوجدناهم يحتجون بقول الله تعالي: (ولا علي انفسكم ان تاكلوا من بيوتكم او من بيوت اباءكم او بيوت امهاتكم) الاية الي قوله تعالي: (او صديقكم) قال: فاباحة الله تعالي الاكل من بيوت هءلاء يقتضي اباحة دخول منازلهم بغير اذنهم فاذا جاز لهم دخول منازلهم بغير اذنهم لم يكن مالهم محرزا عنهم ولا يجب القطع في السرقة من غير حرز، وقالوا ايضا فان اباحة الاكل من اموالهم تمنعهم وجوب القطع لما لهم فيه من الحق كالشريك قالوا: وايضا فان علي ذي الرحم المحرمة ان ينفق علي ذي رحمه عند الحاجة فصار له بذلك حق في ماله بغير بدل فاشبه السارق من بيت المال قالوا: ولما كان محتاجا الي ما ينفقه عليه لا حياء نفسه كان ذلك لازما في جميع اعضاءه فلذلك يسقط القطع عن اليد * قال ابو محمد رحمه الله: فهذا كل ما موهوا به ولا حجة لهم في شء منه اصلا علي ما نبين ان شاء الله تعالي، فاما الاية فحق ولا دليل فيها علي ما ذكروا بل هي حجة عليهم وقد كذبوا فيها ايضا اما كونها لا دليل فيها علي ما ادعوه فانه ليس فيها اسقاط القطع علي من سرق من هءلاء لا بنص ولا بدليل وانما فيها اباحة الاكل لا اباحة الاخذ بلا خلاف من احد من الامة (فان قالوا): قسنا الاخذ علي الاكل (قلنا لهم):

 القياس كله باطل ثم لو كان حقا لكان هذا منه عين الباطل لان القياس عند القاءلين به قياس الشء علي نظيره في العلة او في شبه بوجه ما، ولا يجوز عند احد من الامة لا مجيز قياس ولا مانع قياس الضد علي ضده ولا مضادة اكثر من التحريم والتحليل وانتم مجمعون
 معنا ومع الناس علي ان الاخذ لعروض الاخ.
 والاخت.
 والعم.
 والعمة.
 والخال.
 والخالة.
 والاب والام.
 والصديق من بيوتهم ونقل ما فيها حرام وان الاكل حلال فكيف استحللتم قياس حكم الحرام الممنوع علي حكم الحلال المباح، واما قولهم في الاية وكذبهم فيها قول هذا الجاهل المقدم ان اباحة الله تعالي الاكل من بيوت هءلاء يقتضي اباحة دخول منازلهم بغير اذنهم فليت شعري اين وجدوا هذه في هذه الاية او في غيرها فيدخل الصديق منزل صديقه بغير اذنه هذا عجب من العجب اما سمعوا قول الله تعالي: (يا ايها الذين امنوا ليستاذنكم الذين ملكت ايمانكم والذين لم يبلغوا الحلم) الي قوله تعالي: (فليستاذنوا كما استاذن الذين من قبلهم) فنص الله تعالي علي انه لا يدخل بالغ اصلا علي احد الا باذن ودخل في ذلك الاب والابن وغيرهما حاش ما ملكت ايماننا والاطفال فانهم لا يستاذنون الا في هذه الاوقات الثلاثة فقط وبالله تعالي التوفيق *  مسالة  سرقة احد الزوجين من الاخر * قال ابو محمد رحمه الله: اختلف الناس في هذا، فقالت طاءفة: لا قطع في ذلك كما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج قال: بلغني عن الشعبي قال: ليس علي زوج المراة في سرقة متاعها قطع، وقال ابو حنيفة.
 واصحابه: لا قطع علي الرجل فيما سرق من مال امراته ولا علي المراة فيما سرقت من مال زوجها، وقال مالك.
 واحمد بن حنبل.
 واسحق.
 وابو ثور: علي كل واحد منهما القطع فيما سرق من مال الاخر من حرز، وقال الشافعي ثلاثة اقوال: احدها كقول ابي حنيفة.
 والاخر كقول مالك، والثالث ان الزوج اذا سرق من مالها قطعت يده وان سرقت هي من ماله فلا قطع عليها * قال ابو محمد: فلما اختلفوا كما ذكرنا نظرنا في ذلك فوجدنا من لا يري القطع يحتج بما رويناه من طريق مسلم نا محمد بن رمح نا الليث بن سعد عن نافع عن ابن عمر عن النبي صلي الله عليه وسلم انه قال: " كلكم راع وكلكم مسءول عن رعيته فالامير الذي علي الناس
 راع وهو مسءول عن رعيته والرجل راع علي اهل بيته وهو مسءول عنهم والمراة راعية علي بيت بعلها وولدها وهي مسءولة عنهم والعبد راع علي مال سيده وهو مسءول عنه الا كلكم راع وكلكم مسءول عن رعيته " وهكذا رواه عبد الله بن عمر بن حفص  وحماد بن زيد.
 وايوب السختياني.
 والضحاك بن عثمان.
 واسامة بن زيد كلهم عن نافع عن ابن عمر عن النبي صلي الله عليه وسلم، ورواه سالم عن ابيه عن النبي صلي الله عليه وسلم وزاد فيه كما روينا بالسند المذكور الي مسلم ني حرملة ني ابن وهب اخبرني يونس بن يزيد عن الزهري عن سالم بن عبد الله بن عمر عن ابيه انه سمع رسول الله صلي الله عليه وسلم فذكر هذا الحديث وزاد فيه " والرجل راع في مال ابيه ومسءول عن رعيته " قالوا فكل واحد من الزوجين امين في مال الاخر فلا قطع عليه كالمودع وزاد بعض من لا يعبا به في هذا الحديث زيادة لا نعرفها ولفظا مبدولا وهو المراة راعية في مال زوجها والرجل راع في مال امراته * قال ابو محمد رحمه الله: وكل هذا لا حجة لهم فيه اصلا، اما الخبر المذكور فحق واجب لا يحل تعديه وهو اعظم حجة عليهم لانه عليه السلام اخبر ان كل من ذكرنا راع فيما ذكر وانهم مسءولون عما استرعوا من ذلك فاذ هم مسءولون عن ذلك فبيقين يدري كل مسلم انه لم تبح لهم السرقة والخيانة فيما استودعوه واسلم اليهم وانهم في ذلك ان لم يكونوا كالاجنبيين والاباعد ومن لم يسترع فهم بلا شك اشد اثما واعظم جرما واسوا حالة من الاجنبيين وان ذلك كذلك فاقل امورهم ان يكون عليهم ما علي الاجنبيين ولا بد فهذا حكم هذا الخبر علي الحقيقة، وايضا فانهم لا يختلفون ان علي من ذكرنا في الخيانة ما علي الاجنبيين من الزام رد ما خانوا وضمانه وهم اهل قياس بزعمهم فهلا قاسوا ما اختلف فيه من السرقة والقطع فيها علي ما اتفق عليه من حكم الخيانة ولكنهم قد قلنا انهم لا النصوص اتبعوا ولا القياس احسنوا، وايضا فليس في هذا الخبر دليل اصلا علي ترك القطع في السرقة والقول في الزيادة
 التي زادوها سواء كما ذكرنا لو صحت ولا فرق، واما قولهم ان كليهما كالمودع وكالماذون له في الدخول فاعظم حجة عليهم لانهم لا يختلفون ان المودع اذا سرق مما لم يودع عنده لكن من مال لمودع اخر في حرزه وان الماذون له في الدخول لو سرق من مال محرز عنه للمدخول عليه الاذن له في الدخول لوجب القطع عليهما عندهم بلا خلاف فيلزمهم بهذا التشبيه البديع بالضد ان لا يسقطوا القطع عن الزوجين فيما سرق احدهما من الاخر الا فيما اءتمن عليه ولم يحرز منه وان لم يجب القطع علي كل واحد منهما فيما لم يامنه صاحبه عليه واحرز عنه كالمودع والماذون له في الدخول ولا فرق، وهذا قياس لو صح قياس ساعة من الدهر * قال ابو محمد رحمه الله: فبطل كل ما موهوا به من ذلك والحمد لله رب العالمين، ثم نظرنا في ذلك في قول من فرق بين الزوج والزوجة فراي عليه القطع اذا سرق من  مالها ولم ير عليها القطع اذا سرقت من ماله فوجدناهم يقولون ان الرجل لا حق له في مال المراة اصلا فوجب القطع عليه اذا سرق منه شيءا لانه في ذلك كالاجنبي فوجدنا المراة لها في ماله حقوقا من صداق ونفقة وكسوة واسكان وخدمة فكانت بذلك كالشريك ووجدنا رسول الله صلي الله عليه وسلم قد قال لهند بنت عتبة اذ اخبرته ان ابا سفيان لا يعطيها ما يكفيها وولدها فقال لها عليه السلام: " خذي ما يكفيك وولدك بالمعروف " قالوا فقد اطلق رسول الله صلي الله عليه وسلم يدها علي مال زوجها تاخذ منه ما يكفيها وولدها فهي مءتمنة عليه كالمستودع ولا فرق قالوا: والزوج بخلاف ذلك لان الله تعالي قال: (واتيتم احداهن قنطارا فلا تاخذوا منه شيءا) الاية، وقال تعالي: (فان طبن لكم عن شء منه نفسا فكلوه هنيءا مريءا) فبين الله تعالي تحريم القليل من مالها والكثير عليه * قال ابو محمد رحمه الله: اما قولهم ان لها في ماله حقوقا من صداق ونفقة وكسوة واسكان وخدمة وان رسول الله صلي الله عليه وسلم اطلق يدها علي ماله حيث كان من حرز او غير
 حرز لتاخذ منه ما يكفيها وولدها بالمعروف اذا لم يوفيها واياهم حقوقهم فنعم كل هذا حق واجب وهكذا نقول ولكن لا يشك ذو مسكة من حس سليم ان رسول الله صلي الله عليه وسلم لم يطلق يدها علي ما لا حق لها فيه من مال زوجها ولا علي اكثر من حقها فاذ لا شك في ذلك فاباحة الله تعالي ورسوله صلي الله عليه وسلم لاخذ الحق والمباح ليس فيه دليل اصلا علي اسقاط حدود الله تعالي علي من اخذ الحرام غير المباح ولو كان ذلك لكان شرب العصير الحلال مسقطا للحد عنه اذا تعدي الحلال منه الي المسكر الحرام ولا فرق بين الامرين فاذ ذلك كذلك فلها ما اخذت بالحق وعليها ما افترض الله تعالي من القطع فيما اخذت بوجه السرقة للحق الواجب حكمه وللمباح حكمه وللباطل المحرم حكمه (ومن يتعد حدود الله فقد ظلم نفسه) وهي في ذلك كالاجنبي سواء سواء يكون له حقوق عند السارق فمباح له ان ياخذ حقه ومقدار حقه من مال الذي له عنده الحق من حرز او من غير حرز نعم ويقاتله عليه ان منعه ويحل له بذلك دمه وهو ماجور في كل ذلك فان تعمد اخذ ما ليس له بحق فان تعمد اخذه بافساد طريق فهو محارب له حكم المحارب وان اخذه مجاهرا غير مفسد في الارض فله حكم الغاصب وان اخذه مختفيا فله حكم السارق.
 والمحارب هذا والزوجة في مال زوجها كذلك لان الله تعالي لم يخص اذ امر بقطع السارق والسارقة الا ان تكون زوجة من مال زوجها ولا يكون زوج من مال زوجته (وما كان ربك نسيا) فصح يقينا ان القطع فرض واجب علي الاب والام اذا سرقا من مال ابنهما وعلي الابن والبنت اذا سرقا من مال ابيهما.
 وامهما ما لم يبح لهما اخذه وهكذا  كل ذي رحم محرمة او غير محرمة اذا سرق من مال ذي رحمه او من غير ذي رحمه ما لم يبح له اخذه فالقطع علي كل واحد من الزوجين اذا سرقا من مال صاحبه ما لم يبح له اخذه كالاجنبي ولا فرق اذا سرق ما لم يبح وهو محسن ان اخذ ما ابيح له اخذه من حرز او من غير حرز وبالله تعالي التوفيق *
  مسالة  هل يقطع السارق في اول مرة ام لا؟ * قال ابو محمد رحمه الله: نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج اخبرني عبد ربه بن ابي امية ان الحرث بن عبد الله بن ابي ربيعة حدثه.
 وابن سابط الاحول " ان النبي صلي الله عليه وسلم اتي بعبد قد سرق فقيل يا رسول الله هذا عبد سرق واخذت معه سرقته وقامت البينة عليه () فقال رجل يا رسول الله هذا عبد بني فلان ايتام ليس لهم مال غيره فتركه قال ثم اتي به الثانية سارقا ثم الثالثة ثم الرابعة كل ذلك يقول فيه كما قيل له في الاول قال ثم اتي به الخامسة فقطع يده ثم اتي به السادسة فقطع رجله ثم السابعة فقطع يده، ثم الثامنة فقطع رجله " قال الحارث: اربع باربع فاعفاه الله اربعا وعاقبه اربعا * قال ابو محمد رحمه الله: هذا مرسل ولا حجة في مرسل ولقد كان يلزم الحنيفيين.
 والمالكيين القاءلين بان المرسل كالمسند ان يقولوا به لا سيما وهم يقولون بوجوب درء الحدود بالشبهات ولا شبهة اقوي من خبر وارد يعملون بمثله اذا اشتهوا وتالله ان هذا الخبر علي وهيه لارفع او مثل خبر ابن الحبشي الذي خالفوا له ظاهر القران وايمن من خبر المسور الذي اسقطوا به ضمان ما اتلف بالباطل من مال المسروق منه وخالفوا به القران في ايجابه تعالي الاعتداء علي المعتدي بمثل ما اعتدي به واباحوا به المال بالباطل وبالله تعالي التوفيق * قال ابو محمد رحمه الله: فقطع السارق واجب في اول مرة بعموم القران كما ذكرنا وحسبنا الله ونعم الوكيل *  مسالة  مقدار ما يجب فيه قطع السارق () * قال ابو محمد رحمه الله: اختلف الناس في مقدار ما يجب فيه قطع يد السارق فقالت طاءفة: يقطع في كل ما له قيمة قل او كثر، وقالت طاءفة: اما من الذهب فلا تقطع اليد فيه الا في ربع دينار فصاعدا واما من غير الذهب ففي كل ما له قيمة قلت او كثرت
 وقالت طاءفة: لا تقطع اليد الا في درهم او ما يساوي درهما فصاعدا، وقالت طاءفة:

 لا تقطع اليد الا في درهمين او ما يساوي درهمين فصاعدا، وقالت طاءفة: اما من الذهب فلا تقطع اليد الا في ربع دينار فصاعدا.
 واما من غير الذهب فلا تقطع اليد الا فيما قيمته ثلاثة دراهم فان ساوي ربع دينار او نصف دينار فاكثر ولم يساو لرخص الذهب ثلاثة دراهم فلا تقطع اليد فيه وان ساوي ثلاثة دراهم ولم يساو عشر دينار لغلاء الذهب فلا قطع فيه، وقالت طاءفة.
 اما من الذهب فلا تقطع اليد في اقل من ربع دينار.
 واما من غير الذهب فكل ما يساوي ربع دينار فصاعدا ففيه القطع فان ساوي عشرة دراهم او اكثر او اقل ولا يساوي ربع دينار لغلاء الذهب او ساوي ربع دينار ولم يساو نصف درهم لرخص الذهب فالقطع في كل ذلك، وقالت طاءفة: اما من الذهب فلا قطع في اقل من ربع دينار وتقطع في ربع دينار فاكثر، واما من غير الذهب فان ساوي ربع دينار ولم يساو ثلاثة دراهم او ساوي ثلاثة دراهم ولم يساو ربع دينار قطع في كل ذلك وان لم يساو ربع دينار ولا ثلاثة دراهم فلا قطع فيه، وقالت طاءفة: لا تقطع اليد الا في اربعة دراهم او ما يساويها فصاعدا، وقالت طاءفة: لا تقطع اليد الا في ثلث دينار او ما يساويه فصاعدا، وقالت طاءفة لا تقطع اليد الا في خمسة دراهم او ما يساويها فصاعدا، وقالت طاءفة: لا تقطع اليد الا في دينار ذهب او ما يساويه فصاعدا، وقالت طاءفة: لا تقطع اليد الا في دينار ذهب او عشرة دراهم او ما يساوي احد العددين فصاعدا فان لم يساو لا دينارا ولا عشرة دراهم لم تقطع * وقالت طاءفة: لا تقطع اليد الا في عشرة دراهم مضروبة او ما يساويها فصاعدا ولا تقطع في اقل * قال ابو محمد رحمه الله: فنظرنا في ذلك فوجدنا مارويناه من طريق البخاري
 نا عمر بن حفص بن غياث نا ابي نا الاعمش قال: سمعت ابا صالح السمان عن ابي هريرة عن النبي صلي الله عليه وسلم قال: " لعن الله السارق يسرق البيضة فتقطع يده ويسرق الحبل فتقطع يده " فكان هذا ايضا نصا بينا جليا علي انه لا حد فيما يجب القطع فيه في السرقة الا ان ياتي نص اخر مبين لذلك فوجدنا ما ناه عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا الربيع بن سليمان نا اشعث نا الليث بن سعد عن محمد بن عجلان عن القعقاع بن حكيم عن ابي صالح السمان عن ابي هريرة عن النبي صلي الله عليه وسلم انه قال: " لا يزني الزاني حين يزني وهو مءمن ولا يسرق السارق حين يسرق وهو مءمن ولا يشرب الخمر حين يشربها وهو مءمن ولا ينتهب نهبة ذات شرف يرفع الناس اليه فيها ابصارهم وهو مءمن " فعم رسول الله صلي الله عليه وسلم كل سرقة ولم يخص عددا من عدد  ولو انه عليه السلام اراد مقدارا من مقدار لبينه كما بين ذلك في النهبة في الحديث المذكور فخص ذات الشرف التي يرفع الناس اليه ابصارهم ولم يخص في الزنا ولا في السرقة ولا في الخمر فكانت هذه النصوص المتواترة المتظاهرة المترادفة موافقة لنص القران الذي به عرفنا الله تعالي مراده منا فنظرنا هل نجد في السنة تخصيصا لشء من هذه النصوص؟ فوجدنا الخبر الذي ذكرناه من طريق عروة.
 وعمرة.
 والزهري.
 وابي بكر ابن حزم كما نا عبد الله بن يوسف نا احمد بن فتح نا عبد الوهاب بن عيسي نا احمد ابن محمد نا احمد بن علي نا مسلم بن الحجاج نا الوليد بن شجاع ارني ابن وهب اخبرني يونس عن ابن شهاب عن عروة.
 وعمرة عن عاءشة عن رسول الله صلي الله عليه وسلم قال: " لا تقطع يد السارق الا في ربع دينار فصاعدا " * وبه الي مسلم نا بشر بن الحكم العبدي نا عبد العزيز بن محمد الدراوردي عن يزيد بن عبد الله بن الهادي عن ابي بكر بن محمد بن عمرو بن حزم عن عمرة عن عاءشة انها سمعت النبي صلي الله عليه وسلم يقول: " لا تقطع يد السارق الا في ربع دينار فصاعدا " *
 قال ابو محمد رحمه الله: فخرج الذهب بهذا الخبر عن جملة الاية وعن عموم النصوص التي ذكرنا قبل ووجب الاخذ بكل ذلك وان يستثني الذهب من ساءر الاشياء فلا تقطع اليد الا في ربع دينار بوزن مكة فصاعدا ولا تقطع في اقل من ذلك من الذهب خاصة، ثم نظرنا هل بحد نصا اخر فيما عدا الذهب؟ اذ ليس في هذا الخبر ذكر قيمة ولا ثمن اصلا ولا دليل علي ذلك ولا فيه ذكر حكم شء غير عين الذهب فاذا يونس ابن عبد الله قد حدثنا قال: نا عيسي بن ابي عيسي  هو يحيي بن عبد الله بن يحيي  قال: نا احمد بن خالد نا محمد بن وضاح نا ابو بكر بن ابي شيبة نا عبد الرحيم بن سليمان عن هشام بن عروة عن ابيه عن عاءشة ان يد السارق لم تكن تقطع علي عهد رسول الله صلي الله عليه وسلم في ادني من ثمن حجفة او ترس كل واحد منهما يومءذ ذو ثمن وان يد السارق لم تكن تقطع علي عهد رسول الله صلي الله عليه وسلم في الشء التافه فكان هذا حديثا صحيحا تقوم به الحجة وهو مسند لانها ذكرت عما كان رسول الله صلي الله عليه وسلم لا يقطع يد السارق الا فيه لانه لا يشك احد لا مءمن ولا كافر في انه لم يكن في المدينة حيث كانت عاءشة وحيث شهدت الامر احد يقطع الايدي في السرقات ويحتج بفعله في الاسلام الا رسول الله صلي الله عليه وسلم وحده فصح بهذا الخبر احكام ثلاثة.
 احدها ان القطع انما يجب في سرقة ما سوي الذهب فيما يساوي ثمن حجفة او ترس قل ذلك او كثر دون تحديد.
 والثاني ان ما دون ذلك مما لا قيمة له اصلا وهو التافه لا يقطع فيه اصلا، والثالث بيان كذب من ادعي ان ثمن المجن الذي فيه  القطع انما هو مجن واحد بعينه معروف وهو الذي سرق فقطع فيه النبي صلي الله تعالي عليه وعلي اله وسلم لان عاءشة اخبرت بان المراعي في ذلك ثمن حجفة او ترس، وكلاهما ذو ثمن فلم يخص الترس دون الحجفة ولا الحجفة دون الترس واخبرت ان كليهما ذو ثمن دون تحديد الثمن فصح ما قلناه يقينا، واما قولنا في الدينار انه بوزن مكة فلما صح عن النبي صلي الله عليه وسلم مما ناه عبد الله بن ربيع نا محمد
 ابن معاوية نا احمد بن شعيب انا احمد بن سليمان الزهراني نا ابو نعيم  هو الفضل بن دكين  نا سفيان  هو الثوري  عن حنظلة بن ابي سفيان الجمحي عن طاوس عن ابن عمر عن النبي صلي الله عليه وسلم قال: " المكيال مكيال اهل المدينة والوزن وزن اهل مكة فالمثقال المكي اثنان وثمانون حبة من حب الشعير المجمل لا تنتخب كبيرة ولا تتحر صغيرة فربع دينار وزنه عشرون حبة ونصف حبة لا قطع في اقل من ذلك من الذهب المحض الصرف الذي لا ينضاف اليه خلط يظهر له فيه اثر قل او كثر من ورق او نحاس او غير ذلك وبالله تعالي التوفيق *  مسالة ذكر اعيان الاحاديث الواردة في القطع باختصار * قال ابو محمد رحمه الله: اما حديث ابن عمر قطع رسول الله صلي الله عليه وسلم في مجن ثمنه ثلاثة دراهم فلم يروه احد الا نافع عن ابن عمر عن النبي صلي الله عليه وسلم هكذا رواه عنه الثقات الاءمة ايوب السختياني وموسي بن عقبة.
 وايوب بن موسي.
 وحنظلة بن ابي سفيان الجمحي.
 وعبيد الله بن عمر بن حفص.
 واسماعيل بن امية.
 واسماعيل بن علية.
 وحماد بن زيد.
 ومالك بن انس.
 والليث بن سعد.
 ومحمد بن اسحق.
 وجويرية بن اسماء وغير هءلاء ممن لا يلحق بهءلاء ولا يختلف في اللفظ الا ان بعضهم قال: قيمته وبعضهم قال: ثمنه.
 ورواه بعض الثقات ايضا عن حنظلة بن ابي سفيان عن نافع عن ابن عمر عن رسول الله صلي الله عليه وسلم فقال قيمته خمسة دراهم، وجاء حديث لم يصح لان راويه ابو حرمل ولا يدري من هو ان جارية سرقت ركوة خمر لم تبلغ ثلاثة دراهم فلم يقطعها رسول الله صلي الله عليه وسلم.
 واما القطع في ربع دينار فلم يرو الا عن عاءشة رضي الله عنها، وروي عنها علي ثلاثة اضرب.
 احدها ان رسول الله صلي الله عليه وسلم قال: " لا قطع الا في ربع دينار " والثاني ان رسول الله صلي الله عليه وسلم قطع في ربع دينار او قال: القطع في ربع دينار.
 والثالث انه عليه السلام لم يقطع في اقل من ثمن المجن حجفة او ترس لا في الشء التافه او قطع في مجن ولم يرو هذه الالفاظ باختلافها عنها رضي الله عنها الا القاسم بن محمد.
 وعروة بن الزبير.
 وعمرة بنت عبد الرحمن.
 وامراة عكرمة لم تسم لنا.
 فاما القاسم فاوقفه علي عاءشة من لفظها ولم يسنده
 لكن انها قالت: السارق تقطع يده في ربع دينار، وانكر عبد الرحمن ابنه علي من رفعه  وخطاه.
 واما من قال: لا قطع الا في ربع دينار فلم يروه احد نعلمه الا يونس عن الزهري عن عروة.
 وعمرة عن عاءشة مسندا.
 وابو بكر بن محمد بن عمرو بن حزم عن عمرة عن عاءشة مسندا.
 ومحمد بن عبد الرحمن عن عمرة عن عاءشة مسندا، واما الذين رووا القطع في ثمن المجن لا في التافه الذي هو اقل من ثمن المجن وتحديد هشام بن عروة عن ابيه عن عاءشة وامراة عكرمة عن عاءشة مسندا، واما حديث العشرة دراهم او الدينار فليس فيه شء اصلا عن رسول الله صلي الله عليه وسلم فلا ينبغي ان يجوز التموية فيه علي احد انما فيه موصولا به ذكر العشرة دراهم من قول عبد الله بن عمرو بن العاصي ولا يصح عنه ايضا ومن قول عبد الله بن عباس بن عبد الله وهو قول سعيد بن المسيب وايمن كذلك وهو عنهم صحيح الا حديثا موضوعا مكذوبا لا يدري من رواه من طريق ابن مسعود مسندا لا قطع الا في ربع دينار او عشرة دراهم وليس فيه مع عليه ذكر القيمة اصلا *  مسالة  ذكر ما يقطع من السارق * قال ابو محمد رحمه الله: اختلف الناس فيما يقطع من السارق، فقالت طاءفة: لا تقطع الا اليد الواحدة فقط ثم لا يقطع منه شء، وقالت طاءفة: لا يقطع منه الا اليد والرجل من خلاف ثم لا يقطع منه شء، وقالت طاءفة: تقطع اليد ثم الرجل الاخري، وقالت طاءفة: تقطع يده ثم رجله من خلاف ثم رجله الثانية (واختلفوا ايضا) كيف تقطع اليد وكيف تقطع الرجل وماذا يفعل به اذا لم يبق له ما يقطع واي اليدين تقطع وسنذكر ان شاء الله تعالي كل باب من هذه الابواب والقاءلين بذلك وحجة كل طاءفة ليلوح الحق ولا حول ولا قوة الا بالله العلي العظيم، فاما من قال: لا تقطع الا يده فقط فكما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج قلت لعطاء سرق الاولي قال: تقطع كفه قلت فما قولهم اصابعه قال لم ادرك الا قطع الكف كلها قلت
 لعطاء سرق الثانية قال: ما اري ان تقطع الا في السرقة الاولي اليد فقط قال الله تعالي: (فاقطعوا ايديهما) ولو شاء امر بالرجل ولم يكن الله تعالي نسيا، هذا نص قول عطاء، واما من قال: تقطع اليد ثم اليد ولا تقطع الرجل فروي عن ربيعة وغيره، وبه قال بعض اصحابنا، واما من قال: تقطع يده ثم رجله من خلاف فقط ثم لا يقطع منه شء فكما نا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا سفيان الثوري عن منصور بن المعتمر عن ابي الضحي قال: كان علي بن ابي طالب لا يزيد في السرقة علي قطع اليد والرجل قال وكيع: ونا شعبة عن عمرو بن مرة عن عبد الله بن سلمة ان علي بن ابي طالب اتي بسارق فقطع يده ثم اتي به فقطع رجله ثم اتي  به الثالثة فقال اني استحيي ان اقطع يده فباي شء ياكل او اقطع رجله فعلي اي شء يعتمد؟ فضربه وحبسه * وبه الي وكيع نا اسراءيل عن سماك بن حرب عن عبد الرحمن ابن عابد الازدي قال: اتي عمر بن الخطاب برجل اقطع اليد والرجل  يقال له سدوم  فاران ان يقطعه فقال له علي بن ابي طالب: انما عليه قطع يده ورجله فحبسه عمر * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج اخبرني عمرو بن دينار قال: كتب نجدة بن عامر الي ابن عباس السارق يسرق فتقطع يده ثم يعود فتقطع يده الاخري قال الله تعالي: (فاقطعوا ايديهما) قال ابن عباس: بلي ولكن يده ورجله من خلاف، قال عمرو بن دينار: سمعته من عطاء منذ اربعين سنة * قال ابو محمد رحمه الله: هذا اسناد في غاية الصحة ويحتمل قول ابن عباس هذا وجهين.
 احدهما بلي ان الله تعالي قال هذا ولكن الواجب قطع يده ورجله ويحتمل ايضا بلي ان الله تعالي قال هذا وهو الحق ولكن السلطان يقطع اليد والرجل وهذا الوجه الثاني هو الذي لا يجوز ان يحمل قول ابن عباس علي غيره البتة لانه لا يجوز ان يكون ابن عباس يحقق ان هذا قول الله تعالي ثم يخالفه ويعارضه اذ لا يحل ترك امر الله تعالي
 الا لسنة عن رسول الله صلي الله عليه وسلم ناسخة لما ورد في القران واردة من عند الله تعالي بالوحي الي نبيه عليه السلام فمن الباطل الممتنع ان يخالف قول ابن عباس قول الله تعالي برايه او بتقليده لراي احد دون رسول الله صلي الله عليه وسلم وهو ابعد الناس من ذلك وقد دعاهم الي المباهلة في العول وغيره، وقال في امر متعة الحج وفسخه بعمرة ما اراكم الا سيخسف الله بكم الارض اقول لكم قال رسول الله صلي الله عليه وسلم وتقولون قال ابو بكر.
 وعمر، ومن المحال ان يكون عنده عن رسول الله صلي الله عليه وسلم سنة في ذلك ولا يذكرها وقد اعاذه الله تعالي من ذلك، ومن المحال ان يسمعه عطاء ويفهم عنه ان عنده في قطع الرجل سنة ينبغي لها ترك القران ثم يابي عطاء من قطع الرجل في السرقة كما ذكرنا عنه ويتمسك بالقران في ذلك ويقول: (وما كان ربك نسيا) لو شاء الله تعالي امر بالرجل، فصح يقينا ان ابن عباس لم يرد بقوله بلي ولكن اليد والرجل الا لتصحيح قطع اليدين فقط علي حكم الله تعالي في القران وان قوله ولكن اليد والرجل انما اخبر عن فعل اهل زمانه فقط، وعن الزهري وسالم وغيره انما قطع ابو بكر الصديق رجله وكان مقطوع اليد قال الزهري: فلم يبلغنا في السنة الا قطع اليد والرجل لا يزاد علي ذلك، وعن ابراهيم النخعي قال كانوا يقولون لا يترك ابن ادم مثل البهيمة ليس له يد ياكل بها ويستنجي بها وهو قول حماد بن ابي سليمان.
 وسفيان الثوري.
 واحمد بن حنبل.
 واصحابهم *

 قال ابو محمد رحمه الله: فنظرنا في قول من راي قطع يد السارق الواحدة فقط ثم لا يقطع منه شء.
 وقول من راي قطع اليد بعد اليد فقط ولم ير قطع الرجل في ذلك اصلا فوجدناهم يقولون: قال الله تعالي: (والسارق والسارقة فاقطعوا ايديهما) وقال رسول الله صلي الله عليه وسلم: " لو سرقت فاطمة بنت محمد لقطع محمد يدها " وقال رسول الله صلي الله عليه وسلم: " لا تقطع اليد الا في ربع دينار فصاعدا "، وقال رسول الله صلي الله عليه وسلم: " لعن الله السارق يسرق البيضة فتقطع يده ويسرق الحبل فتقطع يده "
 وقالت عاءشة رضي الله عنها لم تكن الايدي تقطع علي عهد رسول الله صلي الله عليه وسلم في الشء التافه فهذا القران والاثار الصحاح الثابتة عن رسول الله صلي الله عليه وسلم جاءت بقطع الايدي لم يات فيها للرجل ذكر، وقال تعالي: (اتبعوا ما انزل اليكم من ربكم) وقد بينا انه لم يصح عن رسول الله صلي الله عليه وسلم في قطع رجل السارق شء اصلا ولو صح لقلنا به، وما تعديناه ولم يرو في قطع الرجل شء الا عن ابي بكر.
 وعمر.
 وعثمان.
 وعلي.
 ويعلي بن منبه.
 فاما الرواية عن عثمان فلا تصح.
 واما الرواية عن ابي بكر قد جاء عنه انه اراد قطع الرجل الثانية في السرقة الثالثة وهم لا يقولون بهذا، وصح عن علي انه لم ير قطع الرجل الثانية ولا اليد الثانية فصح الاختلاف عنهم في ذلك رضي الله عنهم * وما نا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا سفيان الثوري عن عبد الرحمن بن القاسم.
 ومحمد ابن ابي بكر عن ابيه قال: اراد ابو بكر قطع الرجل بعد اليد والرجل فقال عمر: السنة في اليد، فهذا عمر رضي الله عنه لم ير السنة الا في اليد * قال ابو محمد رحمه الله: فانبلج الامر ولله الحمد * وقد روينا من طريق البخاري نا يحيي بن بكير نا الليث عن يونس عن ابن شهاب عن عبيد الله بن عبد الله ابن عتبة ان ابن عباس كان يحدث ان رجلا اتي الي رسول الله صلي الله عليه وسلم فقال: اني رايت الليلة وذكر الحديث وان ابا بكر رضي الله عنه عبر تلك الرءيا وان رسول الله صلي الله عليه وسلم قال لابي بكر رضي الله عنه: " اصبت بعضا واخطات بعضا " فكل احد دون رسول الله صلي الله عليه وسلم يخطء ويصيب * (فان قال قاءل): قد جاء عن رسول الله صلي الله عليه وسلم " عليكم بسنتي وسنة الخلفاء الراشدين من بعدي " (قلنا): سنة الخلفاء رضي الله عنهم هي اتباع سنته عليه السلام واما ما عملوه باجتهاد فلا يجب اتباع اجتهادهم في ذلك، وقد صح عن ابي بكر.
 وعمر.
 وعثمان.
 وعلي.
 وابن الزبير.
 وخالد بن الوليد.
 وغيرهم القود من اللطمة  والحنيفيون.
 والمالكيون.
 والشافعيون لا يقولون بذلك، واما نحن فليس الاجماع عندنا الا الذي تيقن انهم اولهم عن اخرهم قالوا به وعملوه وصوبوه دون سكوت من احد منهم، ولا خلاف من احد منهم فهذا حقا هو الاجماع وبالله تعالي التوفيق * فاذ انما جاء القران.
 والسنة بقطع يد السارق لا بقطع رجله فلا يجوز قطع رجله اصلا وهذا ما لا اشكال فيه والحمد لله، فوجب من هذا اذا سرق الرجل او المراة ان يقطع من كل واحد منهما يدا واحدة فان سرق احدهما ثانية قطعت يده الثانية بالنص من القران.
 والسنة فان سرق في الثالثة عذر وثقف ومنع الناس ضره حتي يصلح حاله وبالله تعالي التوفيق *  مسالة  صفة قطع اليد  قد ذكرنا عن علي رضي الله عنه في قطع الاصابع من اليد وقطع نصف القدم من الرجل.
 وذكرنا قول عمر رضي الله عنه وغيره في قطع كل ذلك من المفصل، واما الخوارج فراوا في ذلك قطع اليد من المرفق.
 او المنكب * قال ابو محمد رحمه الله: واحتجوا في ذلك بقول الله تعالي: (فاقطعوا ايديهما) قالوا: واليد في لغة العرب اسم يقع علي ما بين المنكب الي طرف الاصابع وهذا وان كان ايضا كما ذكرنا عنهم فان اليد ايضا تقع علي الكف وتقع علي ما بين الاصابع الي المرفق فاذ ذلك كذلك فانما يلزمنا اقل ما يقع عليه اسم يد لان اليد محرمة قطعها قبل السرقة ثم جاء النص بقطع اليد فواجب ان لا يخرج من التحريم المتيقن المتقدم شء الا ما تيقن خروجه ولا يقين الا في الكف فلا يجوز قطع اكثر منها، وهكذا وجدنا الله تعالي اذ امرنا في التيمم بما امر اذ يقول تعالي: (فلم تجدوا ماء فتيمموا صعيدا طيبا فامسحوا بوجوهكم وايديكم منه) ففسر رسول الله صلي الله عليه وسلم مراد الله تعالي بذكر الايدي ههنا وانه الكفان فقط علي ما قد اوردناه،
 وصح عن النبي صلي الله عليه وسلم الفرق بين حد الحر.
 وبين حد العبد علي ما قد ذكرناه، فاذ قد نص عليه السلام علي ان حد العبد بخلاف حد الحر فهذا عموم لا ينبغي ان يخص منه شء بغير نص ولا اجماع فالواجب ان سرق العبد ان تقطع انامله فقط وهو نصف اليد فقط وان سرق الحر قطعت يده من الكوع وهو المفصل، واما في المحاربة فتقطع يد الحر من المفصل ورجله من المفصل وتقطع من العبد انامله من اليد ونصف قدمه من الساق كما روي عن علي بن ابي طالب رضي الله عنه ناخذ من قول كل قاءل  ما وافق النص ونترك ما لم يوافقه وبالله تعالي التوفيق * ()  مسالة  قطع اليد فيمن جحد العارية * قال ابو محمد رحمه الله: روينا من طريق مسلم نا عبد بن حميد نا عبد الرزاق انا معمر عن الزهري عن عروة عن عاءشة قالت: كانت امراة مخزومية تستعير المتاع وتجحده فامر رسول الله صلي الله عليه وسلم بقطع يدها فاتي اهلها اسامة بن زيد فكلموه فكلم رسول الله صلي الله عليه وسلم فيها وذكر الحديث * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق انا معمر عن الزهري عن عروة عن عاءشة ام المءمنين قالت: " كانت امراة مخزومية تستعير المتاع فتجحده فامر النبي صلي الله عليه وسلم بقطع يدها فاتي اهلها اسامة بن زيد فكلموه فكلم اسامة النبي صلي الله عليه وسلم فيها فقال له النبي صلي الله عليه وسلم: يا اسامة الا اراك تكلم في حد من حدود الله ثم قام عليه السلام خطيبا فقال انما هلك من كان قبلكم بانه اذا سرق فيهم الشريف تركوه واذا سرق فيهم الضعيف قطعوه والذي نفسي بيده لو كانت فاطمة بنت محمد لقطعت يدها فقطع يد المخزومية " * وعن نافع عن ابن عمر قال: " كانت امراة مخزومية تستعير المتاع وتجحده فامر النبي صلي الله عليه وسلم بقطع يدها " قال عبد الله بن احمد بن حنبل سالت ابي فقلت له تذهب الي هذا الحديث فقال: لا اعلم شيءا يدفعه وقال تقطع يد المستعير اذا جحد ثم اقر * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا عثمان بن عبد الله بن الحسن ابن حماد نا عمرو بن هاشم ابو مالك عن عبيد الله بن عمر بن حفص بن عاصم عن نافع عن  ابن عمر قال: " ان امراة كانت تستعير الحلي للناس ثم تمسكه قال رسول الله صلي الله عليه وسلم: لتتب الي الله ورسوله وترد ما تاخذ علي القوم فقال رسول الله صلي الله عليه وسلم قم يا بلال فخذ بيدها فاقطعها " * قال ابو محمد رحمه الله: وكان من اعتراض من انتصر لهذا القول ان قال في الحديث الذي رويتم الحديث الذي رويتم مختلف فيه فروي بعضهم ان تلك المخزومية سرقت كما روينا من طريق مسلم نا محمد بن رمح نا الليث  هو ابن سعد  عن ابن شهاب عن عروة عن عاءشة " ان قريشا اهمهم شان المخزومية التي سرقت فقالوا من يكلم فيها رسول الله صلي الله عليه وسلم؟ فقالوا: ومن يجترء عليه الا اسامة حب رسول الله صلي الله عليه وسلم؟ فكلمه اسامة فقال
 رسول الله صلي الله عليه وسلم: اتشفع في حد من حدود الله؟ ثم قام فاختطب فقال يا ايها الناس انما هلك الذين من قبلكم انهم كانوا اذا سرق فيهم الشريف تركوه واذا سرق فيهم الضعيف اقاموا عليه الحد وايم الله لو ان فاطمة بنت محمد سرقت لقطعت يدها " * ومن طريق مسلم نا حرملة اخبرني ابن وهب اخبرني يونس بن يزيد عن ابن شهاب اخبرني عروة بن الزبير عن عاءشة زوج النبي صلي الله عليه وسلم " ان قريشا اهمهم شان المخزومية التي سرقت في عهد رسول الله صلي الله عليه وسلم في غزوة الفتح فقالوا من يكلم فيها رسول الله صلي الله عليه وسلم؟ فقالوا: من يجترء عليه الا اسامة بن زيد حب رسول الله صلي الله عليه وسلم فاتي بها رسول الله صلي الله عليه وسلم فكلمه فيها اسامة بن زيد فتلون وجه رسول الله صلي الله عليه وسلم وقال اتشفع في حد من حدود الله؟ فقال اسامة: استغفر لي يا رسول الله فلما كان العشي قام رسول الله صلي الله عليه وسلم فاختطب فاثني علي الله تعالي بما هو اهله ثم قال: اما بعد فانما هلك الذين من قبلكم انهم كانوا اذا سرق فيهم الشريف تركوه وان سرق فيهم الضعيف اقاموا عليه الحد والذي نفسي بيده لو ان فاطمة بنت محمد سرقت لقطعت يدها ثم امر بتلك المراة التي سرقت فقطع يدها " فهءلاء يرون انها سرقت، قالوا: ومن الدليل علي انها امراة واحدة وقصة واحدة وانها سرقت وان من روي استعارت قد وهم ان في جمهور هذه الاثار انهم استشفعوا لها باسامة بن زيد وان رسول الله صلي الله تعالي عليه وسلم انكر ذلك عليه ونهاه ان يشفع في حد من حدود الله تعالي ومن المحال ان يكون اسامة ابن زيد رضي الله عنه قد نهاه رسول الله صلي الله تعالي عليه وسلم ان يشفع في حد من حدود الله تعالي ثم يعود فيشفع في حد اخر مرة اخري، وقالوا: ان المستعير خاءن ولا قطع علي خاءن لاسيما وقد نا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب قال: سمعت ابن جريج  يحدث عن ابي الزبير المكي عن جابر بن عبد الله " ان رسول الله صلي الله عليه وسلم قال: ليس
 علي الخاءن ولا علي المختلس ولا علي المنتهب قطع " قال: وتحتمل رواية من روي انها استعارت فامر رسول الله صلي الله عليه وسلم بقطعها انهم ارادوا التعريف بانها هي التي كانت استعارت الحلي وسرقت فقطعت للسرقة لا للعارية، قالوا: وهذا كما روي " افطر الحاجم والمحجوم " وراي رسول الله صلي الله عليه وسلم رجلا يصلي خلف الصف فامره باعادة الصلاة، قالوا: وليس من اجل الحجامة اخبر بانهما افطرا لكن بغير ذلك وليس من اجل الصلاة خلف الصف امره بالاعادة لكن بغير ذلك * قال ابو محمد رحمه الله: هذا كل ما شغبوا به قد تقصيناه وكل ذلك لا حجة لهم في شء منه علي ما نبين ان شاء الله تعالي فنقول: وبالله تعالي التوفيق * اما كلامهم في اختلاف الرواية عن الزهري فلا متعلق لهم به لان معمرا.
 وشعيب ابن ابي حمزة روياه عن الزهري وهما في غاية الثقة والجلالة وكذلك ايوب بن موسي كلهم يقولون: انها كانت تستعير المتاع فتجحده فذكر ذلك للنبي صلي الله عليه وسلم فامر بقطع يدها واخبر انه حد من حدود الله تعالي ولم يضطرب علي معمر في ذلك ولا علي شعيب بن ابي حمزة وان كانا خالفهما الليث.
 ويونس بن ابي يزيد.
 واسماعيل ابن امية.
 واسحق بن راشد فان الليث قد اضطرب عليه ايضا وكذلك علي يونس ابن يزيد فان الليث.
 ويونس.
 واسماعيل.
 واسحق ليسوا فوق معمر.
 وشعيب في الحفظ وقد وافقهما ابن اخي الزهري عن عمه، واما تنظيرهم في ذلك بالثابت عن رسول الله صلي الله عليه وسلم من قولهم " افطر الحاجم والمحجوم " وبامره صلي الله عليه وسلم الذي صلي خلف الصف باعادة الصلاة فما زادوا علي ان فضحوا انفسهم واستحلوا في الكذب الذي لا يستسهله مسلم لانهم يقولون: انهما افطرا لانهما كانا يغتابان الناس فقيل لهم فمن اغتاب الناس وهو صاءم افطر عندكم قالوا: لا وهذه مضاحك وشماتة الاعداء واستخفاف باوامر النبي صلي الله عليه وسلم مع الكذب عليه ان يقول عليه السلام: " افطر الحاجم والمحجوم " فيقولون هم لم يفطر واحد منهما، فان قيل لهم اتكذبون
 النبي صلي الله عليه وسلم في قوله افطرا؟ قالوا: افطرا بغير ذلك وهو الغيبة، فان قيل لهم اتفطر الغيبة؟ قالوا لا فرجعوا الي ما فروا عنه كيدا لاهل الاسلام ولم اغتر بهم من الضعفاء المخاذيل * واما حديث امر النبي صلي الله عليه وسلم في المصلي خلف الصف وحده باعادة الصلاة فلو لم يرو احد عشر من الصحابة بالاسانيد الثابتة امره صلي الله عليه وسلم باقامة الصفوف والتراص فيها والوعيد علي خلاف ذلك لامكن ان يعذروا بالجهل فكيف ولا عذر لهم  لانه لا يجوز لمسلم ان يظن بالنبي صلي الله عليه وسلم انه قال لامته: افطر الحاجم والمحجوم " وامر المصلي خلف الصف وحده باعادة الصلاة ثم لا يبين لهم الوجه الذي افطرا به ولا الوجه الذي امر من اجله المصلي خلف الصف باعادة الصلاة، فهذا طعن علي النبي صلي الله عليه وسلم فلا يحل لمسلم ان يظن انه عليه السلام امره بالاعادة لامر لم يبينه علينا.
 واما قولهم ان المستعير الجاحد خاءن ولا قطع علي خاءن والحديث بذاك عن جابر وقد ذكرنا قبل فساد هذا الخبر في صدر كلامنا في قطع السارق، وان ابن جريج لم يسمعه من ابي الزبير وان ابا الزبير لم يسمعه من جابر لانه قد اقر علي نفسه بالتدليس فسقط التعلق بهذا الخبر والحمد لله رب العالمين * قال ابو محمد رحمه الله: فنقول وبالله تعالي نستعين ان رواية من روي انها استعارت فامر رسول الله صلي الله عليه وسلم بقطع يدها.
 ورواية من روي انها سرقت فامر رسول الله صلي الله عليه وسلم بقطع يدها صحيحان لا مغمز فيهما لان كليهما من رواية الثقات التي تقوم بها الحجة في الدين علي ما اوردنا، والعجب كله فيمن يتعلل في رد هذه السنة بهذا الاضطراب وهم ياخذون بحديث " لا قطع الا في ربع دينار " وبحديث " القطع في مجن ثمنه عشرة دراهم " وهما من الاضطراب بحيث قد ذكرناه وذلك الاضطراب اشد من الاضطراب في هذا الخبر بكثير او ياخذ بخبر ابن عمر قطع رسول الله صلي الله عليه وسلم في مجن ثمنه ثلاثة دراهم وليس فيه بيان ان ذلك حد القطع
 وقد عارضه مثله في الصحة من القطع في ربع دينار * قال ابو محمد رحمه الله: فان في هذا الوجه من الاضطراب ليس علة في شء من الاخبار فلنقل بعون الله تعالي ان في هاتين الروايتين اللتين احداهما استعارت المتاع فجحدت فامر رسول الله صلي الله عليه وسلم بقطعها وفي الاخري انها سرقت فامر رسول الله صلي الله عليه وسلم بقطع يدها يخلو من ان يكونا في قصتين اثنتين في امراتين متغايرتين او يكونا في قصة واحدة في امراة واحدة فان كانت في قصتين وفي امراتين فقد انقطع الهذر وبطل الشغب جملة ويكون الكلام في شفاعة اسامة فيهما جميعا علي ما قد ذكرنا من البيان من انه شفع في السرقة فنهي ثم شفع في المستعيرة وهو لا يعلم ان حد ذلك ايضا القطع علي اننا لو شءنا القطع فانهما امراتان متغايرتان وقضيتان اثنتان لكان لنا متعلق بخلاف دعاويهم المجردة من كل علقة الا من المجاهرة بالباطل والجسر علي الكذب لكان كما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق نا ابن جريج قال: اخبرني عكرمة بن خالد  المخزومي ان ابا بكر بن عبد الرحمن بن الحرث بن هشام المخزومي اخبره " ان امراة جاءت الي امراة فقالت ان فلانة تستعيرك حليا  وهي كاذبة  فاعارتها اياه فمكثت لا تري حليها فجاءت التي كذبت علي فيها فسالتها حليها فقالت ما استعرت منك شيءا فرجعت الي الاخري فسالتها حليها فانكرت ان تكون استعارت منها شيءا فجاءت النبي صلي الله عليه وسلم فدعاها فقالت والذي بعثك بالحق ما استعرت منها شيءا فقال: اذهبوا فخذوه من تحت فراشها فاخذ وامر بها فقطعت " قال ابن جريج: واخبرني بشر بن تميم انها ام عمرو بنت سفيان بن عبد الاسد قال ابن جريج: لا اخذ غير هالا اخذ غيرها قال ابن جريج: واخبرني عمرو بن دينار قال: اخبرني الحسن بن محمد بن علي بن ابي طالب قال: " سرقت امراة فاتي بها النبي صلي الله عليه وسلم فجاءه عمرو بن ابي سلمة فقال للنبي صلي الله عليه وسلم: اي انها عمتي فقال النبي صلي الله عليه وسلم: لو كانت فاطمة بنت محمد لقطعت يدها " قال عمرو بن دينار: فلم اشك حين قال
 حسن: قال عمر للنبي صلي الله عليه وسلم: انها عمتي انها بنت الاسود بن عبد الاسد * قال ابو محمد رحمه الله: فهذا ابن جريج يحكي عن عمرو بن دينار انه لا يشك ان التي سرقت بنت الاسود بن عبد الاسد ويخبر عن بشر التيمي ان التي استعارت هي بنت سفيان بن عبد الاسد وهما ابنتا عم مخزوميتان عمهما ابو سلمة بن عبد الاسد رضي الله عنه زوج ام سلمة رضي الله عنها قبل رسول الله صلي الله عليه وسلم ولكنا نقول وبالله تعالي التوفيق هبك انها امراة واحدة وقصة واحدة فلا حجة فيها لان ذكر السرقة انما هو من لفظ بعض الرواة لا من لفظ النبي صلي الله عليه وسلم، وكذلك ذكر الاستعارة وانما لفظ النبي صلي الله عليه وسلم لو كانت فاطمة بنت محمد سرقت لقطعتها فهذا يخرج علي وجهين يعني ذكر السرقة احدهما ان يكون الراوي يري ان الاستعارة سرقة فيخبر عنها بلفظ السرقة، والوجه الاخر هو ان الاستعارة ثم الجحد سرقة صحيحة لا مجازا لان المستعير اذا اتي علي لسان غيره فانه مستخف باخذ ما اخذ من مال غيره يوري بالاستعارة لنفسه او لغيره ثم يملكه مستترا مختفيا فهذه هي السرقة نفسها دون تكلف فكان هذا اللفظ خارجا عما ذكرنا احسن خروج وكان لفظ من روي العارية لا يحتمل وجها اخر اصلا * قال ابو محمد رحمه الله: فتقطع يد المستعير الجاحد كما تقطع من السارق سواء سواء من الذهب في ربع دينار لا في اقل لقول رسول الله صلي الله عليه وسلم: " لا قطع الا في ربع دينار فصاعدا " وفي غير الذهب في كل ماله قيمة: قلت او كثرت لانه قطع في مال اخذ اختفاء لا مجاهرة وتقطع المراة كالرجل لاجماع الامة كلها علي ان حكم الرجل في ذلك كحكم المراة ومن مسقط القطع عنها ومن موجب القطع عليها ولا قطع في ذلك  الا ببينة تقوم بالاخذ والتمليك مع الجحد او الاقرار بذلك فان عاد مرة اخري قطعت اليد الاخري لان رسول الله صلي الله عليه وسلم امر بقطع يدها وهذا عموم لان المستعير طلبه العارية مستخفيا بمذهبه في اخذه فكان سارقا فوجب عليه القطع وحسبنا الله ونعم الوكيل *
  مسالة  قطع الدراهم  نا عبد الله بن محمد بن علي الباجي نا احمد بن خالد نا ابو عبيد بن محمد الكشوري نا محمد بن يوسف الحذافي نا عبد الرزاق نا داود بن قيس اخبرني خالد بن ابي ربيعة ان ابن الزبير حين قدم مكة وجد رجلا يقرض الدراهم فقطع يده * حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب انا عبد الجبار بن عمر عن ابي عبد الرحمن التيمي قال: كنت عند عمر بن عبد العزيز وهو اذ ذاك امير علي المدينة فاتي برجل يقطع الدراهم وقد شهد عليه فضربه وحلقه وامر به فطيف به وامره ان يقول هذا جزاء من يقطع الدراهم ثم امر به ان يرد اليه فقال اما اني لم يمنعني من ان اقطع يدك الا اني لم اكن تقدمت في ذلك قبل اليوم وقد تقدمت في ذلك فمن شاء فليقطع * قال ابو محمد رحمه الله: وروينا من طريق سعيد بن المسيب انه قال وددت اني رايت الايدي تقطع في قرض الدنانير والدراهم * قال ابو محمد رحمه الله: معني هذا انه كانت الدارهم يتعامل بها عددا دون وزن فكان من عليه دراهم او دنانير يقرض بالجلم من تدويرها ثم يعطيها عددا ويستفضل الذي قطع من ذلك * قال ابو محمد رحمه الله: فهذا عمل ابن الزبير  وهو صاحب  لا يعرف له مخالف من الصحابة رضي الله عنهم والحنيفيون يجعلون نزحه زمزم من زنجي وقع فيها حجة واجماعا لا يجوز خلافه في نصر باطلهم في ان الماء ينجسه ما وقع فيه وان لم يغيره وليس في خبرهم ان زمزم لم تكن تغيرت ولعلها قد كانت تغيرت ولعل الماء كان فيها قدر اقل من قلتين كما يقول الشافعي، وكيف وقد صح ان المءمن لا ينجس وهم يحتجون بهذا واسقاطهم السنة الثابتة في امر رسول الله صلي الله عليه وسلم من غسل ميتا فليغتسل فهم يحتجون بان المءمن لا ينجس حيث لا مدخل له فيه وليس الغسل من غسل الميت تنجيسا من الميت ولا كرامة بل هو طاهر ان كان مءمنا لكنها شريعة كالغسل من
 الايلاج وان كان كلا الفرجين طاهرا، وكالغسل من الاحتلام، فان ذكروا ما ناه عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب عن ابن لهيعة عن عبد الملك بن عبد العزيز ان عبد الله بن الزبير ضرب رجلا في قطع  الدنانير والدراهم قلنا وبالله تعالي التوفيق هذا لا يخالفه ما ذكرنا عنه قبل لان هذا ليس فيه انه قرض مقدار ما يجب فيه القطع فلا يلزمه قطع واما نحن فلا حجة عندنا في قول احد دون رسول الله صلي الله عليه وسلم ولم يات عنه عليه السلام ايجاب القطع في قرض الدنانير.
 والدراهم، ولا يقع عليه اسم سارق ولا مستعير وبالله تعالي التوفيق *  مسالة  في تحريم الخمر واختلاف الناس في حد شاربها * قالت طاءفة: ان رسول الله صلي الله عليه وسلم لم يفرض فيها حدا وانما فرضه من بعده، وقالت طاءفة: لا حد فيها اصلا لان رسول الله صلي الله عليه وسلم لم يفرض فيها حدا * وقالت طاءفة: بل فرض رسول الله صلي الله عليه وسلم فيها حدا، ثم اختلفوا فقالت طاءفة ثمانين، وقالت طاءفة: اربعين فاما من قال لم يوقت فيها رسول الله صلي الله عليه وسلم حدا فانهم ذكروا في ذلك ما ناه عبد الرحمن بن عبد الله بن خالد نا ابراهيم بن احمد نا الفربري نا البخاري نا عبد الله ابن عبد الوهاب الحجبي انا خالد بن الحرث نا سفيان الثوري نا ابو حصين قال: سمعت عمير بن سعد النخعي يقول: سمعت علي بن ابي طالب قال: ما كنت لاقيم حدا علي احد فيموت فاجد في نفسي الا صاحب الخمر فانه لو مات وديته وذلك ان رسول الله صلي الله عليه وسلم لم يسنه * قال ابو محمد رحمه الله: هكذا ناه عبد الرحمن بن عبد الله * وبه الي البخاري نا قتيبة بن سعيد نا عبد الوهاب بن عبد المجيد عن ايوب السختياني عن عبد الله بن ابي مليكة عن عقبة بن الحرث انه قال: جء بالنعيمان او ابن النعيمان فامر من كان في البيت ان يضربوه فكنت انا فيمن ضربوه بالنعال * وبه الي البخاري نا قتيبة
 نا ابو ضمرة نا انس بن عياض عن يزيد بن الهادي عن محمد بن ابراهيم التيمي عن ابي سلمة بن عبد الرحمن بن عوف عن ابي هريرة قال: " اتي النبي صلي الله عليه وسلم برجل شرب فقال اضربوه قال ابو هريرة: فمنا الضارب بيده ومنا الضارب بنعله والضارب بثوبه فلما انصرف قال بعض القوم اخزاك الله قال: لا تقولوا هذا لا تعينوا عليه الشيطان " * وبه الي البخاري نا مكي بن ابراهيم عن ابي الجعد عن يزيد بن خصيفة عن الساءب بن يزيد قال: " كنا نءتي بالشارب علي عهد رسول الله صلي الله عليه وسلم وامرة ابي بكر وصدرا من خلافة عمر فنقوم اليه بايدينا ونعالنا وارديتنا حتي كان اخر امرة عمر فجلد اربعين حتي اذا عتوا وفسقوا جلد ثمانين " * وبه الي البخاري نا يحيي بن بكير ني الليث بن سعد نا خالد بن يزيد عن سعيد بن هلال عن زيد بن اسلم عن ابيه عن عمر بن الخطاب ان رجلا علي عهد  رسول الله صلي الله عليه وسلم كان اسمه عبد الله وكان يلقب حمارا وكان يضحك رسول الله صلي الله عليه وسلم وكان رسول الله صلي الله عليه وسلم قد جلده في الشرب فاتي به يوما فامر به فجلد فقال رجل من القوم: اللهم العنه ما اكثر ما يءتي به فقال النبي صلي الله عليه وسلم: لا تلعنوه فو الله ما علمته الا يحب الله ورسوله فتوفي رسول الله صلي الله عليه وسلم وتلك سنته ثم جلد ابو بكر في الخمر اربعين ثم جلد عمر اربعين صدرا من امارته ثم جلد عثمان الحدين كليهما ثمانين واربعين ثم اثبت معاوية الحد ثمانين * قال ابو محمد رحمه الله: فمن تعلق بزيادة عمر رضي الله عنه ومن زادها معه علي وجه التعزير وجعل ذلك حدا واجبا مفترضا فيلزمه ان يحرق بيت باءع الخمر ويجعل ذلك حدا مفترضا لان عمر فعله وان ينفي شارب الخمر ايضا ويجعله حدا واجبا لان عمر فعله، فان قال قد قال عمر: لا اغرب بعده احدا قيل وقد جلد عمر اربعين وستين في الخمر بعد ان جلد الثمانين باصح اسناد يمكن وجوده، ويلزمهم
 ان يحلقوا شارب الخمر بعد الرابعة كما فعل عمر فلا يحدونه اصلا، ويلزمهم ان يوجبوا جلد ثمانين ايضا ولا بد علي من فضل عليا علي ابي بكر او علي عمر او علي من فضل عمر علي ابي بكر لان عمر وعليا قالا ذلك بحضرة الصحابة ويلزمهم ان يجلد حدا واجبا كل من كذب علي الله تعالي وعلي القران والا فقد تناقضوا بالباطل فظهر فساد قولهم * قال ابو محمد رحمه الله: وصح بما ذكرنا ان القول بجلد اربعين في الخمر هو قول ابي بكر.
 وعمر.
 وعثمان.
 وعلي.
 والحسن بن علي.
 وعبد الله بن جعفر بحضرة جميع الصحابة رضي الله عنهم، وبه يقول الشافعي.
 وابو سليمان.
 واصحابهما: وبه ناخذ وبالله تعالي التوفيق *  مسالة هل يقتل شارب الخمر بعد ان يحد فيها ثلاث مرات ام لا؟ قال ابو محمد رحمه الله: () اختلف الناس في شارب الخمر يحد فيها ثم يشربها  فيحد فيها ثانية ثم يشربها فيحد فيها ثالثة ثم يشربها الرابعة فقالت طاءفة: يقتل، وقالت طاءفة: لا يقتل، فاما من قال يقتل فكما نا احمد بن قاسم نا ابي قاسم بن محمد ابن قاسم نا جدي قاسم بن اصبغ نا الحرث  هو ابن ابي اسامة  نا عبد الوهاب ابن عطاء انا قرة بن خالد عن الحسن بن عبد الله بن النصري عن عبد الله بن عمرو
 ابن العاصي انه قال اءتوني برجل اقيم عليه حد في الخمر فان لم اقتله فانا كاذب، وقال مالك.
 والشافعي.
 وابو حنيفة.
 وغيرهم: ان لا قتل عليه وذكروا ذلك عن عمر بن الخطاب.
 وسعد بن ابي وقاص * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر في ذلك فوجدنا من راي قتله كما نا عبد الله بن ربيع نا محمد بن اسحق نا ابن الاعرابي نا ابو داود نا موسي ابن اسماعيل ثنا ابو سلمة انا ابان  هو ابن يزيد العطار  عن عاصم  هو ابن ابي النجود  عن ابي صالح السمان عن معاوية بن ابي سفيان قال: قال رسول الله صلي الله عليه وسلم: " اذا شربوا الخمر فاجلدوهم ثم ان شربوا فاجلدوهم ثم ان شربوا فاقتلوهم " * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق نا سفيان الثوري عن عاصم بن ابي النجود عن ذكوان  هو ابو صالح السمان  عن معاوية ان النبي صلي الله عليه وسلم قال في شارب الخمر: " ان شرب فاجلدوه ثم ان شرب فاجلدوه ثم ان شرب الرابعة فاضربوا عنقه " * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن رافع نا عبد الرزاق نا معمر عن سهيل بن ابي صالح عن ابيه عن ابي هريرة ان النبي صلي الله عليه وسلم قال: " من شرب الخمر فاجلدوه ثم اذا شرب فاجلدوه ثم اذا شرب فاجلدوه ثم اذا شرب في الرابعة  ذكر كلمة معناها  فاقتلوه " * حدثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن سهيل بن ابي صالح عن ابيه عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال: " من شرب الخمر فاجلدوه ثم اذا شرب فاجلدوه ثم اذا شرب فاجلدوه ثم اذا شرب فاقتلوه " * قال ابو محمد رحمه الله: فهذان طريقان في نهاية الصحة وقد روي من طريق اخر لا يعتمد عليها ولو ظفر ببعضها المخالفون من الحاضرين لطاروا به كل مطير * من ذلك  ما ناه احمد بن محمد بن عبد الله الطلمنكي نا ابن مفرج نا ابن الاعرابي نا الدبري نا محمد بن ايوب الصموت نا احمد بن عمر بن عبد الخالق البزار نا محمد بن يحيي القطعي نا الحجاج ابن المنهال نا حماد بن سلمة عن جميل بن زياد عن نافع عن ابن عمر، قال: قال رسول الله صلي الله عليه وسلم: " من شرب الخمر فاجلدوه ثلاثا فان عاد في الرابعة فاقلتوه " * حدثنا عبد الله ابن ربيع نا محمد بن معاوية نا احمد بن شعيب انا اسحق بن ابراهيم  هو ابن راهويه  انا جرير  هو ابن عبد الحميد  عن المغيرة بن مقسم عن عبد الرحيم بن ابراهيم عن عبد الله ابن عمر بن الخطاب ونفر من اصحاب رسول الله صلي الله عليه وسلم قالوا: قال رسول الله صلي الله عليه وسلم: " من شرب الخمر فاجلدوه ثم ان شرب فاجلدوه ثم ان شرب فاجلدوه ثم ان شرب فاقتلوه " * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن يحيي ابن عبد الله نا محمد بن عبد الله الرقاشي نا يزيد بن زريع عن محمد بن اسحق عن عبد الله ابن عتبة عن عروة بن مسعود عن عمرو بن الشريد عن ابيه قال: قال رسول الله صلي الله عليه وسلم: " اذا شرب الخمر فاجلدوه ثم ان شرب فاجلدوه ثم ان شرب فاجلدوه ثم ان شرب فاقتلوه " * حدثنا يونس بن عبد الله بن مغيث انا ابو بكر بن احمد بن خالد نا ابي نا ابن وضاح نا ابو بكر بن ابي شيبة عن شبابة بن سوار عن ابن ابي ذءب عن الحرث ابن عبد الرحمن عن ابي سلمة بن عبد الرحمن بن عوف عن ابي هريرة عن النبي صلي الله عليه وسلم قال: " اذا سكر فاجلدوه ثم اذا سكر فاجلدوه ثم ان سكر فاضربوا عنقه " * حدثنا احمد بن قاسم نا ابي قاسم بن محمد بن قاسم نا جدي قاسم بن اصبغ نا احمد بن زهير نا ابراهيم بن عبد الله انا هشام انا مغيرة بن معبد بن خالد عن عبد بن عبد عن معاوية رفع الحديث قال: " من شرب الخمر فاضربوه فان عاد فاضربوه فان
 عاد فاقتلوه " قال احمد بن زهير: هكذا قال عبد بن عبد  وعبد بن عبد هو ابو عبد الله الجدلي  قال احمد بن زهير سالت يحيي بن معين عن ابي عبد الله الجدلي قال هو فلان ابن عبد كوفي ثقة من قيس لم يحفظ يحيي اسمه * قال ابو محمد رحمه الله: وقد روي هذا الحديث ايضا شرحبيل بن اوس.
 وعبد الله بن عمرو بن العاص.
 وابو غطيف الكندي كلهم عن النبي صلي الله عليه وسلم * قال ابو محمد رحمه الله: واقل من هذا يجعلون فيما وافقهم نقل تواتر كقول الحنيفيين في شرب النبيذ المسكر وكاعتماد المالكيين في ابطال السنن الثابتة في التوقيت في المسح علي رواية ابي عبد الله الجدلي وغير ذلك لهم كثير * قال ابو محمد رحمه الله: فكانت الرواية في ذلك عن معاوية.
 وابي هريرة  ثابتة تقوم بها الحجة وبالله تعالي التوفيق، فنظرنا فيما احتج به المخالفون فوجدناهم يقولون: ان هذا الخبر منسوخ وذكروا في ذلك ما نا عبد الله بن ربيع نا محمد ابن معاوية نا احمد بن شعيب انا عبيد الله بن سعد بن ابراهيم بن سعد نا عمي  هو يعقوب بن سعد  نا شريك عن محمد بن اسحاق عن محمد بن المنكدر عن جابر بن عبد الله عن النبي صلي الله عليه وسلم قال: اذا شرب الرجل فاجلدوه فان عاد فاجلدوه فان عاد فاجلدوه فان عاد الرابعة فاقتلوه فاتي رسول الله صلي الله عليه وسلم برجل منا فلم يقتله * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن موسي نا زياد بن عبد الله البكاءي ني محمد بن اسحاق عن محمد بن المنكدر عن جابر بن عبد الله قال: قال رسول الله صلي الله عليه وسلم: " من شرب الخمر فاضربوه فان عاد فاضربوه فان عاد فاضربوه فان عاد في الرابعة فاضربوا عنقه  فضرب رسول الله صلي الله عليه وسلم نعيمان اربع مرات  " فراي المسلمون ان الحد قد وقع وان القتل قد رفع * حدثنا حمام نا عباس بن اصبغ نا محمد بن عبد الملك بن ايمن نا اسماعيل بن اسحق
 نا ابو ثابت نا ابن وهب اخبرني يونس بن يزيد اخبرني ابن شهاب ان قبيصة بن ذءيب حدثه انه بلغه عن رسول الله صلي الله عليه وسلم انه قال لشارب الخمر: " ان شرب فاجلدوه ثم ان شرب فاجلدوه ثم ان شرب فاجلدوه ثم ان شرب فاقتلوه  فاتي برجل قد شرب ثلاث مرات فجلده ثم اتي به في الرابعة فجلده ووضع القتل عن الناس، قال محمد بن عبد الملك قد نا ابو اسماعيل محمد بن اسماعيل الترمذي نا سعيد بن ابي مريم انا سفيان بن عيينة قال: سمعت ابن شهاب يقول لمنصور بن المعتمر من وافد اهل العراق بهذا الخبر  يعني حديث قبيصة بن ذءيب هذا * حدثنا عبد الرحمن بن عبد الله بن خالد نا ابراهيم بن احمد الفربري نا البخاري نا يحيي بن بكير ني الليث ني خالد بن يزيد بن ابي هلال عن زيد بن اسلم عن ابيه عن عمر بن الخطاب " ان رجلا علي عهد رسول الله صلي الله عليه وسلم كان اسمه عبد الله وكان يلقب حمارا وكان يضحك رسول الله صلي الله عليه وسلم وكان رسول الله صلي الله عليه وسلم قد جلده في الشرب فاتي به يوما فامر به فجلد فقال رجل من القوم اللهم العنه ما اكثر ما يءتي به فقال رسول الله صلي الله عليه وسلم: لا تلعنوه فو الله ما علمته الا يحب الله ويحب رسوله " وذكروا الخبر الثابت عن رسول الله صلي الله عليه وسلم " لا يحل دم امرء مسلم الا باحدي ثلاث كفر بعد ايمان او زني بعد احصان او نفس بنفس " فلا يجوز ان يقتل احد لم يذكر في هذا الخبر *

 قال ابو محمد رحمه الله: فلو ان المالكيين.
 والحنيفيين.
 والشافعيين احتجوا علي انفسهم بهذا الخبر في قتلهم من لم يبح الله تعالي قتله قط ولا رسوله عليه السلام كقتل المالكيين بدعوي المريض وقسامة اثنين في ذلك وقتلهم.
 والشافعيين من فعل فعل قوم لوط ومن اقر بفرض صلاة وقال لا اصلي.
 وكقتل الحنيفيين.
 والمالكيين الساحر وكل هءلاء لم يكفر.
 ولا زني وهو محصن.
 ولا قتل نفسا فهذا كله نقض احتجاجهم
 في قتل شارب الخمر في الرابعة بقول النبي صلي الله عليه وسلم * قال ابو محمد رحمه اله: هذا كل ما احتجوا به وذكروا عن الصحابة ما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن محمد بن راشد عن عبد الكريم ابن ابي امية بن ابي المخارق عن قبيصة بن ذءيب ان عمر بن الخطاب جلد ابا محجن في الخمر ثماني مرات وروي نحو ذلك عن سعيد ايضا وكل ذلك لا حجة لهم فيه علي ما نبين ان شاء الله تعالي * واما حديث جابر بن عبد الله في نسخ الثابت من الامر بقتل شارب الخمر في الرابعة فانه لا يصح لانه لم يروه عن ابن المنكدر احد متصلا الا شريك القاضي.
 وزياد بن عبد الله البكاءي عن محمد بن اسحاق عن ابن المنكدر وهما ضعيفان * واما حديث قبيصة بن ذءيب فمنقطع ولا حجة في منقطع * واما حديث زيد بن اسلم الذي من طريق معمر عنه فمنقطع، ثم لو صح لما كانت فيه حجة لانه ليس فيه ان ذلك كان بعد امر رسول الله صلي الله عليه وسلم بالقتل فاذ ليس ذلك فيه فاليقين الثابت لا يحل تركه للضعيف الذي لا يصح ولو صح لكان ظنا فسقط التعلق به جملة ولو ان انسانا يجلده النبي صلي الله عليه وسلم في الخمر ثلاث مرات قبل ان يامر بقتله في الرابعة لكان مقتضي امره صلي الله عليه وسلم استءناف جلده بعد ذلك ثلاث مرات ولابد لانه عليه السلام حين لفظ بالحديث المذكور امر في المستانف بضربه ان شرب ثم بضربه ان شرب ثانية ثم بضربه ثالثة ثم بقتله رابعة هذا نص حديثه وكلامه عليه السلام فانما كان يكون حجة لو بين فيه انه اتي به اربع مرات بعد امره عليه السلام بقتله في الرابعة وهكذا القول سواء سواء في حديث عمر الذي من طريق سعيد بن ابي هلال عن زيد بن اسلم * قال ابو محمد رحمه الله: فاما نحن فنقول وبالله تعالي التوفيق: ان الواجب ضم اوامر الله تعالي واوامر رسوله صلي الله عليه وسلم كلها بعضها الي بعض والانقياد الي جميعها والاخذ بها وان لا يقال في شء منها هذا منسوخ الا بيقين، برهان ذلك قول الله تعالي.
 (اطيعوا الله واطيعوا الرسول) فصح ان كل ما امر الله تعالي به او رسوله صلي الله عليه وسلم
 ففرض علينا الاخذ به والطاعة له ومن ادعي في شء من ذلك نسخا فقوله مطرح  لانه يقول لنا لا تطيعوا هذا الامر من الله تعالي ولا من رسوله صلي الله عليه وسلم فواجب علينا عصيان من امر بذلك الا ان ياتي نص جلي بين يشهد بان هذا الامر منسوخ او اجماع علي ذلك او بتاريخ ثابت مبين ان احدهما ناسخ للاخر واما نحن فان قولنا هو ان الله تعالي قد تكفل بحفظ دينه واكمله ونهانا عن اتباع الظن فلا يجوز البتة ان يرد نصان يمكن تخصيص احدهما من الاخر وضمه اليه الا وهو مراد الله تعالي منها بيقين وانه لا نسخ في ذلك بلا شك اصلا ولو كان في ذلك نسخ لبينه الله تعالي بيانا جليا ولما تركه ملتبسا مشكلا حاش لله من هذا * قال ابو محمد رحمه الله: فلم يبق الا ان يرد نصان ممكن ان يكون احدهما مخصوصا من الاخر لانه اقل معاني منه وقد يمكن ان يكون منسوخا بالاعم ويكون البيان قد جاء بان الاخص قبل الاعم بلا شك فهذا ان وجد فالحكم فيه النسخ ولا بد حتي يجء نص اخر او اجماع متيقن علي انه مخصوص من العام الذي جاء بعده، برهان ذلك ان الله تعالي قال في كتابه: (تبيانا لكل شء) وقال لرسول الله صلي الله عليه وسلم: (لتبين للناس ما نزل اليهم) والبيان بلا شك هو ما اقتضاه ظاهر اللفظ الوارد ما لم يات نص اخر او اجماع متيقن علي نقله عن ظاهره فاذا اختلف الصحابة فالواجب الرد الي ما افترض الله تعالي الرد اليه اذ يقول: (فان تنازعتم في شء فردوه الي الله والرسول) الاية، وقد صح امر النبي صلي الله عليه وسلم بقتله في الرابعة ولم يصح نسخه ولو صح لقلنا به ولا حجة في قول احد دون رسول الله صلي الله عليه وسلم *  مسالة الخليطين  قد ذكرنا فيما يحل ويحرم من الاشربة ان التمر والرطب.
 والزهو.
 والبسر.
 والزبيب هذه الخمسة خاصة دون ساءر الاشياء يحل ان ينبذ كل واحد منهما علي انفراده ولا يحل ان ينبذ شء منها مع شء اخر لا منها ولا من ساءرها في العالم وانه لا يحل ان يخلط نبيذ شء بعد طيبه او قبل طيبه لا بشء اخر ولا
 بنبيذ شء اخر لا منها ولا من غيرها اصلا واما ما عدا هذه الخمسة فجاءز ان ينبذ منها الشيءان والاكثر معا وان يخلط نبيذ اثنين منها فصاعدا او عصير اثنين فصاعدا وبينا السنن الواردة في ذلك فمن شرب من الخليطين المحرمين مما ذكرنا شيءا لا يسكر فقد شرب حراما كالدم والبول ولا حد في ذلك لانه لم يشرب خمرا ولا حد الا في الخمر لقول رسول الله صلي الله عليه وسلم: " من شرب الخمر فاجلدوه " وللاثار الثابتة ان رسول الله صلي الله عليه وسلم جلد في الخمر، ولقوله عليه السلام: " كل مسكر خمر " فان لم يكن خمرا فلا حد فيه وانما فيه التعزير فقط لانه اتي منكرا، واما كل خليطين مما ذكرنا من غير ذلك اذا اسكر فهو خمر وعلي شاربه حد الخمر لما ذكرنا وبالله تعالي التوفيق *

  مسالة  متي يحد السكران؟ ابعد صحوه ام في حال سكره؟ * قال ابو محمد رحمه الله: اختلف الناس في هذا فروي عن عمر بن عبد العزيز.
 والشعبي انهما قالا: لا يحد حتي يصحو، وبه قال سفيان الثوري.
 وابو حنيفة، وقالت طاءفة: يجلد حين يءخذ وما نعلم لمن قال يءخر حتي يصحو الا ان قالوا ان الجلد تنكيل وايلام والسكران لا يعقل ذلك * قال ابو محمد رحمه الله: واحتج من راي ان الحد حين يءخذ بالخبر الثابت عن رسول الله صلي الله عليه وسلم من طريق عتبة بن الحرث.
 وانس بن مالك.
 وغيرهم ان رسول الله صلي الله عليه وسلم اتي بالشارب فاقر فضربه ولم ينتظر ان يصحو والنظر لا يدخل علي الخبر الثابت فالواجب ان يحد حين يءتي به الا ان يكون لا يحس اصلا ولا يفهم شيءا فيءخر حتي يحس وبالله تعالي التوفيق *  مسالة  فيمن جالس شراب الخمر او دفع ابنه الي كافر فسقاه خمرا * قال ابو محمد رحمه الله: نا عبد الله بن ربيع نا عبد الله بن محمد بن عثمان نا احمد بن خالد نا علي بن عبد العزيز نا الحجاج بن المنهال نا حماد بن سلمة عن علي بن زيد بن جدعان
 عن الحسن البصري ان ابن عامر قال: لا اوتي برجل دفع ابنه الي يهودي او نصراني فسقاه خمرا الا جلدت اباه الحد، وبه الي حماد بن سلمة انا هشام بن عروة عن ابيه ان مروان بن الحكم اتي برجل صاءم دعا قوما فسقاهم الخمر ولم يشرب معهم فجلدوا الحد وجلده معهم * قال ابو محمد رحمه الله: ليس هذا مما يعبا به وقد قال رسول الله صلي الله عليه وسلم: " ان دماءكم واموالكم واعراضكم وابشاركم عليكم حرام " وقد بينا ان لا حد الا علي زان.
 او مرتد.
 او محارب.
 او قاذف.
 او سارق.
 او مستعير جاحد.
 او شارب خمر، واما من سقي غيره الخمر فلا حد عليه لان بشرته حرام ولم يات باباحتها بايجاب الحد عليه لا قران.
 ولا سنة صحيحة.
 ولا سقيمة.
 ولا اجماع.
 ولا قول صاحب * قال ابو محمد رحمه الله: لقد يلزم من راي القود بالقتل علي الممسك انسانا حتي قتل ظلما ومن راي الحد في التعريض قياسا علي القذف ومن راي الحد علي فاعل فعل قوم لوط قياسا علي الزنا ان يري الحد علي ساقي القوم الخمر قياسا علي شاربها والا فقد تناقضوا في قياسهم وبالله تعالي التوفيق *  مسالة : من اضطر الي شرب الخمر * قال ابو محمد رحمه الله:

 من اكره علي شرب الخمر او اضطر اليها لعطش.
 او علاج.
 او لدفع خنق فشربها او جهلها فلم يدر انها خمر فلا حد علي احد من هءلاء، اما المكره فانه مضطر وقد قال تعالي: (وقد فصل لكم ما حرم عليكم الا ما اضطررتم اليه) وقد قال تعالي: (فمن اضطر غير باغ ولا عاد فلا اثم عليه) فصح ان المضطر لا يحرم عليه شء مما اضطر اليه من طعام.
 او شراب، واما الجاهل فانه لم يتعد ما حرم الله تعالي عليه ولا حد الا علي من علم التحريم، ولا يختلف اثنان من الامة في انه من دست اليه غير امراته فوطءها وهو لا يدري من هي يظن انها زوجته فلا حد عليه، واما من قرا
 القران فبدله جاهلا فلا شء عليه * قال تعالي: (لانذركم به ومن بلغ) فصح انه لا حد الا علي من بلغه التحريم وعلي من عرف ان الزنا حرام فقصده عمدا وبالله تعالي التوفيق *  مسالة  حد الذمي في الخمر * قال ابو محمد رحمه الله: قد بينا في مواضع جمة مقدار الحكم علي اهل الذمة كالحكم علي اهل الاسلام لقول الله تعالي: (وقاتلوهم حتي لا تكون فتنة ويكون الدين كله لله) ولقوله تعالي: (وان احكم بينهم بما انزل الله) قال الحسن بن زياد: لا حد علي الذمي الا ان يسكر فان سكر فعليه الحد * قال ابو محمد رحمه الله: وهذا تقسيم لا وجه له لانه لم يوجبه قران.
 ولا سنة ولا اجماع وبالله تعالي التوفيق *  مسالة: قال ابو محمد رحمه الله: جاءز بيع العصير ممن لا يوقن انه يبقيه حتي يصير خمرا فان تيقن انه يجعله خمرا لم يحل بيعه منه اصلا وفسخ البيع لقول الله تعالي: (وتعاونوا علي البر والتقوي ولا تعاونوا علي الاثم والعدوان) وبيقين ندري انه من باع العنب.
 او التين او الخمر ممن يتخذه خمرا فقد اعانه علي الاثم والعدوان وهذا محرم بنص القران واذ هو محرم فقد قال رسول الله صلي الله عليه وسلم: " من عمل عملا ليس عليه امرنا فهو رد " * قال ابو محمد رحمه الله: ومن كسر اناء خمر او شق زق خمر ضمنه لانه لم يصح في ذلك اثر واموال الناس محرمة وقد يغسل الاناء ويستعمل فيما يحل فافساده افساد للمال (فان قيل): ان ابا طلحة.
 وجماعة من الصحابة رضي الله عنهم كسروا خوابي الخمر (قلنا): لا حجة في قول احد دون رسول الله صلي الله عليه وسلم وليس في ذلك  الخبر انه عليه السلام عرف ذلك فاقره والحديث الذي فيه شق الزقاق لا يصح لانه
 من رواية طلق ولا يدري من هو عن شراحيل بن نكيل وهو مجهول * قال ابو محمد رحمه الله: ومن طرح في الخمر سمكا وملحا فجعلها مريا فقد عصي الله تعالي وعليه التعزير لاستعماله الخمر الذي لا يجوز استعمالها ولا تحل في شء اصلا ولا يحل فيها شء الا الهرق فان ادرك ذلك وللخمر ريح.
 او طعم.
 او لون هرق الجميع، وهكذا كل مانع خلط فيه خمر وان لم يدرك ذلك الا وقد استحالت ولم يبق لها اثر فلا يفسد شء من ذلك وهو حلال اكله وبيعه وهو لمن سبق اليه من الناس لا لمن يطرح الخمر فمتي سقط ملك صاحبه عنه واذا سقط عنه ملكه لم يرجع اليه الا بنص او اجماع وبالله تعالي التوفيق *  مساءل التعزير وما لا حد فيه   مسالة  قال ابو محمد رحمه الله: فقد قلنا انه لا حد لله تعالي محدود ولا لرسوله صلي الله عليه وسلم الا في سبعة اشياء وهي الردة.
 والحرابة قبل ان يقدر عليه.
 والزنا.
 والقذف بالزنا.
 وشرب المسكر سكر او لم يسكر.
 والسرقة.
 وجحد العارية، واما ساءر المعاصي فان فيها التعزير فقط  وهو الادب  ومن جملة ذلك اشياء راي فيها قوم من المتقدمين حدا واجبا نذكرها ان شاء الله تعالي ونذكر حجة من راي فيها الحد وحجة من لم يره ليلوح الحق في ذلك بعون الله تعالي كما فعلنا في ساءر كتابنا وتلك الاشياء: السكر.
 والقذف بالخمر.
 والتعريض.
 وشرب الدم.
 واكل الخنزير والميتة.
 وفعل قوم لوط.
 واتيان البهيمة.
 والمراة تستنكح البهيمة.
 والقذف بالبهيمة.
 وسحق النساء.
 وترك الصلاة غير جاحد لها.
 والفطر في رمضان كذلك.
 والسحر * ونحن ان شاء الله تعالي ذاكرون كل ذلك بابا بابا *  مسالة (السكر) قال ابو محمد: اباح ابو حنيفة شرب نقيع الزبيب اذا طبخ.
 وشرب نقيع التمر اذا طبخ.
 وشرب عصير العنب اذا طبخ حتي يذهب ثلثاه وان اسكر كل ذلك فهو عنده حلال ولا حد فيه ما لم يشرب منه القدر الذي يسكر وان سكر
 من شء من ذلك فعليه الحد وان شرب نبيذ تين مسكر. 
 او نقيع عسل مسكر.
 او عصير تفاح مسكر.
 او شراب قمح.
 او شعير.
 او ذرة مسكر فسكر من كل ذلك او لم يسكر فلا حد في ذلك اصلا * قال ابو محمد رحمه الله: وهم يقولون ان الحدود لا تءخذ قياسا اصلا فنقول  لهم: اين وجدتم هذا التقسيم افي قران ام في سنة صحيحة.
 او سقيمة او موضوعة.
 او في اجماع او دليل اجماع، ام في قول صاحب، ام في قول احد قبلكم، ام في قياس، ام في راي يصح؟ فلا سبيل لهم الي وجود ذلك في شء مما ذكرنا لانهم (ان قالوا) حرم الله تعالي الخمر في القران (قلنا) نعم فمن اين وجدتم انتم الحد في السكر مما ليس خمرا عندكم بل هو حلال عندكم طيب وهو مطبوخ عصير العنب اذا ذهب ثلثاه ونقيع الزبيب ونقيع التمر اذا طبخا ولا خمر ههنا اصلا (فان قالوا): جلد رسول الله صلي الله عليه وسلم السكران اذ اتي به ورووا حديث الخمر بعينها والسكر من غيرها او من كل شراب واشربوا في الظروف ولا تسكروا وما كان في معني هذه الاخبار (قلنا لهم): وبالله تعالي التوفيق فانتم اول من خالف ذلك فانكم لا ترون الحد علي من وجد سكران وايضا فهل وجدتم ان النبي صلي الله عليه وسلم ساله مماذا سكر فان قال له من نبيذ عسل او شراب شعير او شراب ذرة اطلقه وقد كان كل ذلك موجودا كثيرا علي عهده عليه السلام وان قال له من نبيذ تمر او نقيع زبيب.
 او عصير عنب حده هل جاء هذا قط في نقل صادق او كاذب؟ فاني لكم هذا التقسيم السخيف فعنه سالناكم وعن تحريمكم به وتحليلكم وعن اباحتكم به الاشياء المحرمة او اسقاطكم حدود الله تعالي الواجبة؟ (فان قالوا): قد صح الاجماع علي حد الشارب بعصير العنب الذي لم يطبخ اذا سكر واختلف فيما عداه (قلنا لهم) فمن اين اوجبتم الحد علي من سكر من نبيذ التمر مطبوخا كان او غير مطبوخ ومن نبيذ الرطب كذلك ومن نبيذ الزهو ومن نبيذ البسر ومن نبيذ الزبيب كذلك ولا اجماع في وجوب الحد عليه وقد روينا
 عن الحسن وغيره انه لا حد علي السكران من النبيذ وكذلك عن ابراهيم النخعي وهو قول ابن ابي ليلي ولا يجدون ابدا قول صاحب ولا قول تابع بمثل هذا التقسيم وكذلك من اضطر الي الخمر لعطش او لاختناق فشرب منها مقدار ما يزيل عطشه او اختناقه وذلك حلال له عندنا وعندهم فسكر من ذلك وهذا لا يقولونه فصح يقينا ان السكر لا حد فيه اصلا وانما الحد والتحريم في المسكر سكر منه او لم يسكر وقد نجد من يسكر من ثلاثة ارطال او اربعة سكرا شديدا ونجد من لا يسكر من ازيد من عشرين رطلا من خمر ولا تتغير له حالة اصلا، واما القذف بشرب الخمر فقد ذكرناه قبل هذا بابواب وقد رجاء بن حيوة وغيره ايجاب الحد فيه وبينا ان الحد لا يجب في ذلك اذ لم يات به قران.
 ولا سنة.
 ولا اجماع وبالله تعالي التوفيق، واما التعريض في القذف فقد ذكرناه في كلامنا في حد القذف وتقصينا هنالك انه لا حد في التعريض لانه لم يوجب الحد فيه قران ولا سنة عن رسول الله صلي الله عليه وسلم لا صحيحة ولا سقيمة.
 ولا اجماع لان الصحابة رضي الله عنهم اختلفوا  في ذلك وليس قول بعضهم اولي من قول بعض وذكرنا صحة الخبر عن رسول الله صلي الله عليه وسلم في الذي اخبره ان امراته ولدت ولدا اسود وهو يعرض بنفيه وفي الذي اخبره عليه السلام ان امراته لا ترد يد لامس فلم يوجب رسول الله صلي الله عليه وسلم عليه حد القذف وبالله تعالي التوفيق *  مسالة  شرب الدم.
 واكل الخنزير.
 والميتة * قال ابو محمد رحمه الله: انا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق نا ابن جريج قلت لعطاء رجل وجد ياكل لحم الخنزير وقال اشتهيته او مرت به بدنة فنحرها وقد علم انها بدنة او امراة افطرت في رمضان او اصاب امراته حاءضا او قتل صيدا في الحرم متعمدا او شرب خمرا فترك بعض الصلاة فذكر جملة فقال عطاء ما كان الله نسيا لو شاء لجعل ذلك شيءا يسميه ما سمعت في ذلك بشء ثم رجع الي ان قال اذا فعل
 ذلك مرة ليس عليه شء واذا عاود ذلك فلينكل، وذكر الذي قبل امراته والذي اصاب اهله في رمضان، وبه الي عبد الرزاق عن معمر عن قتادة قال: اذا اكل لحم الخنزير ثم عرضت له التوبة فان تاب والا قتل، وبه الي معمر عن الزهري في رجل افطر في رمضان فقال اذا كان فاسقا من الفساق نكل نكالا موجعا ويكفر ايضا وان كان فعل ذلك انتحالا لدين غير الاسلام عرضت عليه التوبة * وبه الي عبد الرزاق عن سفيان الثوري في اكل لحم الخنزير في كل ذلك حد كحد الخمر، والذي نعرفه من قول ابي حنيفة.
 ومالك.
 والشافعي.
 واصحابهم.
 واصحابنا انه يعذر فقط فهذه في الخنزير خمسة اقوال، قول فيه الحد كحد الخمر وقول فيه انه لا شء فيه اصلا وهو قول سفيان الثوري واول قولي عطاء.
 والثالث انه يستتاب فان تاب والا قتل وهو قول قتادة، والرابع انه لا شء عليه في اول مرة فان عاد عزر، وقولة خامسة انه يعزر * قال ابو محمد رحمه الله: فنظرنا فيما يحتج به من راي ان في ذلك حدا فلم نجد لهم شيءا الا القياس فلما كانت الخمر مطعومة محرمة فيها حد محدود وجب ان يكون كل مطعوم محرم فيه حد محدود كالخمر قياسا عليها، وهذا اصح قياس في العالم ان صح قياس يوما ما * وطاءفة قالت: لم يفرضه رسول الله صلي الله عليه وسلم ولكن الصحابة اجمعت علي فرضه فصار واجبا بالاجماع، وطاءفة قالت: انما فرضت قياسا علي حد القذف لانها تءدي الي السكر فيكون فيه القذف * فاما الفرقة التي قالت: ان رسول الله صلي الله عليه وسلم فرض حد الخمر فمن اصلهم ان يقاس المسكوت عنه علي المنصوص عليه وهءلاء يقيسون مس الدبر علي مس الذكر لان كليهما عندهم فرج  ولا يشك ذو حس سليم انه لو صح القياس فان قياس شرب الدم.
 واكل الخنزير.
 والميتة علي شرب الخمر اصح من قياس الدبر علي الذكر وكلهم يقيسون حكم ماء الورد والعسل تموت فيه الفارة او القطاة فلا تغير منه لونا ولا طعما ولا ريحا علي السمن
 تموت فيه الفارة وقياس الخنزير.
 والدم.
 والميتة علي الخمر اصح من كل قياس لهم ولو صح يوما ما، واما القطاة فليست كالفارة لان القطاة تءكل والفارة لا تءكل والقطاة تجزي في الحل والاحرام ولا يحل قتلها هنالك والفارة لا تجزي ويحل قتلها هنالك وكذلك ماء الورد والعسل ليس كالسمن لان العسل عند بعضهم فيه الزكاة والسمن لا زكاة فيه وماء الورد لا ربا فيه عند بعضهم والسمن فيه الربا عند جميعهم فظهر تركهم القياس الذي به يحتجون وانهم لا يحسنونه ولا يطردونه * واما الطاءفة التي تقول ان الصحابة رضي الله عنهم فرضوا حد الخمر والقياس ايضا لازم لهم كما لزم الطاءفة المذكورة واما الطاءفة التي قالت ان حد الخمر انما فرض قياسا علي حد القذف والقياس لهءلاء الزم لانه كما جاز ان يفرض حد الخمر قياسا علي حد القذف فكذلك يفرض حد اكل الخنزير والميتة وشرب الدم قياسا علي حد الخمر وجمهورهم يجيزون القياس علي المقيس فوضح ما قلناه من فساد اقوالهم * ثم نظرنا في قول من قال يستتاب فان تاب والا قتل فوجدناه قد حكم له بحكم الردة عنده وهذا خطا لانه قول بلا برهان، ولا يجوز ان يحكم علي مسلم بالكفر من اجل معصية اتي بها الا ان ياتي نص صحيح او اجماع متيقن علي انه يكون بذلك كافرا وان ذلك الفعل كفر وليس معنا نص ولا اجماع علي ان اكل الخنزير والميتة والدم غير مستحل لذلك كافر ولكنه عاص مذنب فاسق الا ان يفعل ذلك مستحلا له فيكون كافرا حنيءذ لان معاندة ما صح الاجماع عليه من نصوص القران وسنن رسول الله صلي الله عليه وسلم كفر لا خلاف فيه فسقط هذا القول لما ذكرنا ولقول رسول الله صلي الله عليه وسلم: " امرت ان اقاتل الناس حتي يشهدوا ان لا اله الا الله واني محمد رسول الله ويقيموا الصلاة ويوتوا الزكاة فاذا فعلوا ذلك عصموا مني دماءهم واموالهم الا بحق الاسلام وحسابهم علي الله " *  مسالة  تارك الصلاة عمدا حتي يخرج وقتها * قال ابو محمد رحمه الله: ذهب مالك.
 والشافعي الي ان من قال: الصلاة حق فرض الا اني لا اريد ان اصلي فانه يتاني به حتي يخرج وقت الصلاة ثم يقتل *
 وقال ابو حنيفة.
 وابو سليمان.
 واصحابهما لا قتل عليه لكن يعزر حتي يصلي * قال ابو محمد رحمه الله: اما مالك.
 والشافعي فانهما يريان تارك الصلاة الذي ذكرنا مسلما لانهما يورثان ماله ولده ويصليان عليه ويدفنانه مع المسلمين ولا يفرقان بينه وبين  امراته وينفذان وصيته ويورثانه من مات قبله من ورثته من المسلمين فاذ ذلك كذلك فقد سقط قولهما في قتله لانه لا يحل دم امرء مسلم الا باحدي ثلاث كفر بعد ايمان او زنا بعد احصان او نفس بنفس وتارك الصلاة متعمدا كما ذكرنا لا يخلو من ان يكون بذلك كافرا او يكون غير كافر فان كان كافرا فهم لا يقولون بذلك لانهم لو قالوه للزمهم ان يلزموه حكم المرتد في التفريق بينه وبين امراته وفي ساءر احكامه فاذ ليس كافرا.
 ولا قاتلا.
 ولا زانيا محصنا.
 ولا محاربا.
 ولا محدودا في الخمر ثلاث مرات فدمه حرام بالنص فسقط قولهم بيقين لا اشكال فيه والحمد لله رب العالمين * فان احتجوا بالخبر الثابت الذي ذكرناه انفا من قول رسول الله صلي الله عليه وسلم: " امرت ان اقاتل الناس حتي يشهدوا ان لا اله الا الله واني محمد رسول الله ويقيموا الصلاة ويءتوا الزكاة فاذا فعلوا ذلك عصموا مني دماءهم واموالهم الا بحق الاسلام وحسابهم علي الله "، وبقول الله تعالي: (فاقتلوا المشركين حيث وجدتموهم وخذوهم واحصروهم واقعدوا لهم كل مرصد فان تابوا واقاموا الصلاة واتوا الزكاة فخلوا سبيلهم) قالوا: ولايجوز تخلية من لم يصل ولم يزك، وذكروا ما روينا من طريق مسلم نا هداب بن خالد نا همام بن يحيي نا قتادة عن الحسن عن ضبة بن محصن عن ام سلمة ام المءمنين ان رسول الله صلي الله عليه وسلم قال: " ستكون امراء فتعرفون وتنكرون فمن عرف برء ومن انكر سلم قال: فمن رضي وتابع قالوا: افلا نقاتلهم؟ قال: لا ما صلوا " * ومن طريق مسلم نا داود ابن رشيد نا الوليد بن مسلم نا عبد الرحمن بن يزيد بن جابر اخبرني مولي بني فزارة زريق بن حيان انه سمع سليم بن قرظة ابن عم عوف بن مالك الاشجعي يقول سمعت
 عوف بن مالك يقول سمعت رسول الله صلي الله عليه وسلم يقول: " خيار اءمتكم الذين تحبونهم ويحبونكم وتصلون عليهم ويصلون عليكم وشرار اءمتكم الذين تبغضونهم ويبغضونكم وتلعنونهم ويلعنونكم قلنا: يا رسول الله افلا ننابذهم عند ذلك؟ قال: لا ما اقاموا فيكم الصلاة لا ما اقاموا فيكم الصلاة " وذكر باقي الخبر، والحديثين اللذين فيهما نهيت عن قتل المصلين فاولءك الذين نهاني الله عن قتلهم، ولا لعله يكون يصلي، ومن طريق مسلم نا قتيبة نا عبد الواحد  هو ابن زياد  عن عمارة بن القعقاع نا عبد الرحمن بن ابي نعم قال سمعت ابا سعيد الخدري يقول: " بعث علي بن ابي طالب الي رسول الله صلي الله عليه وسلم بذهيبة في اديم مقروظ لم تحصل من ترابها " وذكر الحديث، وفيه " فقام رجل غاءر العينين مشرف الوجنتين ناشز الجبهة كث اللحية محلوق الراس مشمر الازار فقال يا رسول الله اتق الله فقال: ويلك الست احق اهل الارض ان يتقي الله؟

 قال ثم ولي الرجل فقال خالد بن الوليد يا رسول الله الا اضرب عنقه؟ قال: لعله يكون يصلي " * قال ابو محمد رحمه الله: ومن طريق مسلم نا مناد بن السري نا ابو الاحوص عن سعيد بن مسروق عن عبد الرحمن بن ابي نعم عن ابي سعيد الخدري قال: " بعث علي بن ابي طالب الي النبي صلي الله عليه وسلم بذهيبة في تربتها " فذكر الخبر، وفيه فجاء رجل كث اللحية مشرف الوجنتين غاءر العينين ناتء الجبين محلوق الراس فقال اتق الله يا محمد فقال رسول الله صلي الله عليه وسلم فمن يطع الله ان لم اطعه؟ ايامنني علي اهل الارض ولا تامنني ثم ادبر الرجل فاستاذن رجل من القوم في قتله  يرون انه خالد بن الوليد  فقال رسول الله صلي الله عليه وسلم: يخرج من ضءضء هذا قوم يقرءن القران لا يجاوز حناجرهم يقتلون اهل الاسلام ويدعون اهل الاوثان يمرقون من الاسلام كما يمرق السهم من الرمية لءن ادركتهم لاقتلنهم قتل عاد " * قال ابو محمد رحمه الله: فاخبر عليه السلام انه يقاتل الناس حتي يقولوا لا اله
 الا الله ويقيموا الصلاة ويءتوا الزكاة فاذا فعلوا ذلك حرمت دماءهم فصح انهم ان لم يفعلوا ذلك حلت دماءهم ونهي عن قتل الاءمة ما صلوا فصح انهم ان لم يصلوا قوتلوا، وصح ان القتل بالصلاة حرام فواجب انه بغير الصلاة حلال، وصح انه نهي عن قتل المصلين فصح انه لم ينه عن قتل غير المصلين ما نعلم لهم حجة في اباحة قتل من لا يصلي غير هذا وكله لا حجة لهم فيه علي ما نبين ان شاء الله تعالي، اما الاية فان نصها قتال المشركين حتي يقيموا الصلاة ويءتوا الزكاة، ولا يختلف اثنان من الامة في ان رسول الله صلي الله عليه وسلم لم يزل يدعو المشركين الي الايمان حتي مات الي رضوان الله تعالي وكرامته وانه في كل ذلك لم يثقف من اجابه الي الاسلام حتي ياتي وقت صلاة فيصلي ثم حتي يحول الحول فيزكي ثم يطلقه هذا ما لا يقدر احد علي دفعه (واما الاحاديث في ذلك) فاما حديث ام سلمة.
 وعوف بن مالك رضي الله عنهما فلا حجة لهم في ذلك فانه ليس فيه الا المنع من قتل الولاة ما صلوا ولسنا معهم في مسالة القتال وانما نحن معهم في مسالة القتل صبرا وليس كل من جاز قتله اذا قدر عليه قتل، قال الله تعالي: (وان طاءفتان من المءمنين اقتتلوا فاصلحوا بينهما) الي قوله تعالي: (المقسطين) فامر الله تعالي بقتال البغاة من المءمنين الي ان يفيءوا ثم حرم قتلهم اذا فاءوا وهكذا كل من منع حقا من اي حق كان ولو انه فلس وجب عليه لله تعالي او لادمي وامتنع دون اداءه فانه قد حل قتاله لانه باغ علي اخيه وباغ في الدين، وكذلك كل من امتنع من عمل لله تعالي لزمه وامتنع دونه ولا فرق فاذا قدر عليهم اجبروا علي اداء ما عليهم بالتعزير والسجن كما امر رسول الله صلي الله عليه وسلم فيمن اتي منكرا  فلا يزال يءدب حتي يءدي ما عليه او يموت غير مقصود الي قتله وحرمت دماءهم بالنص والاجماع وتارك الصلاة الممتنع منها واحد من هءلاء ان امتنع قوتل وان لم يمتنع لم يحل قتله لانه لم يوجب ذلك نص ولا اجماع بل يءدب حتي يءديها او يموت كما قلنا غير مقصود الي قتله ولا فرق، فصح ان هذين الحديثين حديث ام سلمة، وحديث عوف
 انما هو في باب القتال للاءمة لا في باب القتل المقدور عليه لا يصلي، واما حديث ابي سعيد الخدري لعله يصلي فانما فيه المنع من قتل من يصلي وليس فيه قتل من لا يصلي اصلا بل هو مسكوت عنه واذا سكت رسول الله صلي الله عليه وسلم عن حكم فلا يحل لاحد ان يقوله عليه السلام ما لم يقل فيكذب عليه ويخبر عن مراده بما لا علم له به فيتبوا مقعده من النار * قال ابو محمد رحمه الله: واما نهيت عن قتل المصلين واولءك الذين نهاني الله عنهم فنعم لا يحل قتل مصل الا بنص وارد في قتله وليس فيه ذكر لقتل من ليس مصليا اذا اقر بالصلاة اصلا وقد قلنا: انه لا يحل لاحد ان ينسب الي رسول الله صلي الله عليه وسلم ما لم يقل ويقال لمن جسر علي هذا قال رسول الله صلي الله عليه وسلم هذا الذي نقول فان قال نعم كذب جهارا وان قال لم يقل لكنه دل عليه قيل له اين دليلك علي ذلك؟ فلا سبيل له الي دليل اصلا الا ظنه الكاذب فلم يبق لهم دليل اصلا لا من قران.
 ولا من سنة.
 ولا من اجماع ولا قول صاحب.
 ولا قياس.
 ولا راي صحيح وما كان هكذا من الاقوال فهو خطا بلا شك * قال ابو محمد رحمه الله: وهذا الكلام كله انما هو مع من قال بقتله وهو عنده غير كافر واما من قال بتكفيره بترك صلاة واحدة حتي يخرج وقتها فليس هذا مكان الكلام فيه معهم فسيقع الكلام في ذلك متقصي في كتاب الايمان من الجامع ان شاء الله عزوجل * قال ابو محمد رحمه الله: فاذ قد بطل هذا القول فانا نقول وبالله تعالي التوفيق: انه قد صح علي ما ذكرنا في قول رسول الله صلي الله عليه وسلم: " من راي منكم منكرا فليغيره بيده ان استطاع " فكان هذا امرا بالادب علي من اتي منكرا او الامتناع من الصلاة.
 ومن الطهارة من غسل الجنابة.
 ومن صيام رمضان.
 ومن الزكاة.
 ومن الحج.
 ومن اداء جميع الفراءض كلها.
 ومن كل حق لادمي باي وجه كان كل ذلك منكر بلا شك
 وبلا خلاف من احد من الامة لان كل ذلك حرام والحرام منكر بيقين فصح بامر رسول الله صلي الله عليه وسلم اباحة ضرب كل من ذكرنا باليد وصح عن رسول الله صلي الله عليه وسلم ان  لا يضرب في التعزير اكثر من عشرة علي ما نورد في باب كم يكون التعزير ان شاء الله تعالي، فاذ ذلك كذلك فواجب ان يضرب كل من ذكرنا عشر جلدات فان ادي ما عليه من صلاة او غيرها فقد برء ولا شء عليه وان تمادي علي الامتناع فقد احدث منكرا اخر بالامتناع الاخر فيجلد ايضا عشرا وهكذا ابدا حتي يءدي الحق الذي عليه لله تعالي او يموت غير مقصود الي قتله ولا يرفع عنه الضرب اصلا حتي يخرج وقت الصلاة وتدخل اخري فيضرب ليصلي التي دخل وقتها وهكذا ابدا الي نصف الليل فاذا خرج وقت العتمة ترك لانه لا يقدر علي صلاة ما خرج وقتها ثم يجدد عليه الضرب اذا دخل وقت صلاة الفجر حتي يخرج وقتها ثم يترك الي اول الظهر ويتولي ضربه من قد صلي فاذا صلي غيره خرج هذا الي الصلاة ويتولي الاخر ضربه وبالله تعالي التوفيق حتي يترك المنكر الذي يحدث او يموت فالحق قتله وهو مسلم مع ذلك وبالله تعالي التوفيق *  مسالة  فعل قوم لوط: قال ابو محمد رحمه الله: فعل قوم لوط من الكباءر الفواحش المحرمة كلحم الخنزير.
 والميتة.
 والدم.
 والخمر.
 والزنا.
 وساءر المعاصي من احله او احل شيءا مما ذكرنا فهو كافر مشرك حلال الدم والمال * وانما اختلف الناس في الواجب عليه فقالت طاءفة: يحرق بالنار الاعلي والاسفل، وقالت طاءفة: يحمل الاعلي والاسفل الي اعلا جبل بقرية فيصب منه ويتبع بالحجارة، وقالت طاءفة: يرجم الاعلي والاسفل سواء احصنا او لم يحصنا، وقالت طاءفة: يقتلان جميعا، وقالت طاءفة: اما الاسفل فيرجم احصن او لم يحصن، واما الاعلي فان احصن رجم وان لم يحصن جلد جلد الزنا، وقالت طاءفة: الاعلي والاسفل كلاهما سواء ايهما احصن رجم وايهما لم يحصن جلد ماءة كالزنا، وقالت طاءفة:
 لا حد عليهما ولا قتل لكن يعزران فالقول الاول كما نا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب اخبرني ابن سمعان عن رجل اخبره قال: جاء ناس الي خالد بن الوليد فاخبروه عن رجل منهم انه ينكح كما توطا المراة وقد احصن فقال ابو بكر عليه الرجم وتابعه اصحاب رسول صلي الله عليه وسلم علي ذلك من قوله فقال علي: يا امير المءمنين ان العرب تانف من عار المثل وشهرته انفا لا تانفه من الحدود التي تمضي في الاحكام فاري ان تحرقه بالنار فقال ابو بكر: صدق ابو حسن وكتب الي خالد بن الوليد ان احرقه بالنار ففعل قال ابن وهب: لا اري خالدا احرقه بالنار الا بعد ان قتله لان النار لا يعذب بها الا الله تعالي، قال ابن حبيب: من احرق بالنار فاعل فعل قوم لوط لم يخطء * وعن  ابن حبيب نامطرف بن عبد الله بن عبد العزيز بن ابي حازم عن محمد بن المنكدر.
 وموسي بن عقبة.
 وصفوان بن سليم ان خالد بن الوليد كتب الي ابي بكر الصديق انه وجد في بعض سواحل البحر رجلا ينكح كما تنكح المراة وقامت عليه بذلك البينة فاستشار ابو بكر في ذلك اصحاب رسول الله صلي الله عليه وسلم فكان اشدهم فيه يومءذ قولا علي بن ابي طالب قال: ان هذا ذنب لم يعص به من الامم الا امة واحدة صنع الله بها ما قد علمتم اري ان تحرقهما بالنار فاجتمع راي صحابة رسول الله صلي الله عليه وسلم علي ان يحرقه بالنار فكتب ابو بكر الي خالد بن الوليد ان احرقه بالنار ثم حرقهما ابن الزبير في زمانه ثم حرقهما هشام بن عبد الملك ثم حرقهما القسري بالعراق * حدثنا اسماعيل بن دليم الحضرمي قاضي ميورقة قال نا محمد بن احمد بن الخلاص نا محمد بن القاسم بن شعبان ني محمد بن اسماعيل بن اسلم نا محمد بن داود بن ابي ناجية نا يحيي بن بكير عن عبد العزيز بن ابي حازم عن داود بن ابي بكر.
 ومحمد بن المنكدر.
 وموسي بن عقبة.
 وصفوان بن سليم انه وجد في بعض ضواحي البحر رجل ينكح
 كما تنكح المراة قال ابو اسحاق: كان اسمه الفجاة فاستشار ابو بكر اصحاب رسول الله صلي الله عليه وسلم ثم ذكر مثل حديث عبد الملك الذي ذكرنا حرفا حرفا نصا سواء * واما من قال يصعد به الي اعلي جبل في القرية فكما نا احمد بن اسماعيل بن دليم نا محمد بن احمد بن الخلاص نا محمد بن القاسم بن شعبان نا احمد بن سلمة بن الضحاك عن اسماعيل بن محمود بن نعيم نا معاذ نا عبد الرحمن نا حسان بن مطر نا يزيد بن مسلمة عن ابي نضرة عن ابن عباس سءل عن حد اللوطي فقال: يصعد به الي اعلي جبل في القرية ثم يلقي منكسا ثم يتبع بالحجارة * واما من قال يرجم الاعلي والاسفل احصنا او لم يحصنا فكما نا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا ابن ابي ليلي عن القاسم بن الوليد المهراني عن يزيد بن قيس ان عليا رجم لوطيا * حد ثنا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق نا ابن جريج اخبرني عبد الله بن عثمان بن خثيم انه سمع مجاهدا.
 وسعيد بن جبير يحدثان عن ابن عباس انه قال في البكر يوجد علي اللوطية انه يرجم، وعن ابراهيم النخعي انه قال: لو كان احد ينبغي له ان يرجم مرتين لكان ينبغي للوطي ان يرجم مرتين، وعن ربيعة انه قال: اذا اخذ الرجل لوطيا رجم لا يلتمس به احصان ولا غيره، وعن الزهري انه قال علي اللوطي الرجم احصن او لم يحصن * حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن  وهب اخبرني الشمر بن نمير.
 ويزيد بن عياض بن جعدة.
 ومن اثق به، وكتب الي ابن ابي سبرة قال الشمر: عن حسين بن عبد الله بن ضميرة عن ابيه عن جده عن علي بن ابي طالب، وقال يزيد بن عياض بن جعدة عن عبد الملك بن عبيد عن سعيد بن المسيب: وقال ابن ابي سبرة: سمعت ابا الزناد، وقال الذي يثق به عن الحسن ثم اتفق علي.
 وسعيد بن المسيب.
 وابو الزناد.
 والحسن كلهم مثل قول الزهري
 المذكور، وبه يقول الشافعي  وهو قول مالك.
 والليث واسحاق بن راهويه  واما من قال: يقتلان فكما روينا عن ابن عباس قال: اقتلوا الفاعل والمفعول به، واما من قال: هو كالزنا يرجم المحصن منهما ويجلد غير المحصن ماءة جلدة فكما نا احمد بن اسماعيل بن دليم نا محمد بن احمد بن الخلاص نا محمد بن القاسم بن شعبان نا احمد بن سلمة.
 والضحاك عن اسماعيل بن محمد بن نعيم نا معاذ بن الحرث نا عبد الرحمن بن قيس الضبي عن اليماني بن المغيرة نا عطاء بن ابي رباح قال شهدت عبد الله بن الزبير واتي بسبعة اخذوا في اللواط فسال عنهم فوجد اربعة قد احصنوا فامر بهم فاخرجوا من الحرم ثم رجموا بالحجارة حتي ماتوا وجلد ثلاثة الحد وعنده ابن عباس.
 وابن عمر فلم ينكرا ذلك عليه، وعن الحسن البصري انه قال في الرجل يعمل عمل قوم لوط ان كان ثيبا رجم وان كان بكرا جلد، واما من قال ان الفاعل ان كان محصنا فانه يرجم وان كان غير محصن فانه يجلد ماءة وينفي سنة، واما المنكوح فيرجم احصن او لم يحصن فقول ذهب اليه ابو جعفر محمد بن علي بن يوسف احد فقهاء الشافعيين، واما من قال لا حد في ذلك فكما نا محمد بن سعيد بن نبات نا عبد الله بن نصر نا قاسم بن اصبغ نا ابن وضاح نا موسي بن معاوية نا وكيع نا سفيان الثوري عن منصور بن المعتمر.
 وابي اسحق الشيباني كلاهما عن الحكم ابن عتيبة انه قال فيمن عمل عمل قوم لوط يجلد دون الحد، وبه يقول ابو حنيفة.
 ومن اتبعه.
 وابو سليمان.
 وجميع اصحابنا * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر فيما احتج به من راي حرقه بالنار فوجدناهم يقولون انه اجماع الصحابة ولا يجوز خلاف اجماعهم * (فان قيل): فقد روي عن علي.
 وابن عباس.
 وابن الزبير.
 وابن عمر بعد ذلك الرجم او حد الزنا وغير ذلك (قيل) هذا لا يجوز لانه خلاف لما اجمعوا فهذا كل ما ذكروا في ذلك لا حجة لهم غير هذا ووجدناه لا تقوم به حجة لانه لم يروه الا ابن سمعان عن رجل اخبره لم يسمعه ان ابا بكر.
 وعبد الملك بن حبيب عن مطرف عن ابي حازم عن
 محمد بن المنكدر.
 وموسي بن عقبة.
 وصفوان بن سليم.
 وداود بن بكر ان ابا بكر.

 وابن شعبان عن محمد بن العباس بن اسلم عن محمد بن داود بن ابي ناجية عن يحيي بن بكير عن ابن ابي حازم عن ابن المنكدر.
 وموسي بن عقبة.
 وصفوان بن سليم.
 وداود بن بكر ان ابا بكر فهذه كلها منقطعة ليس منهم احد ادرك ابا بكر، وايضا فان ابن سمعان مذكور بالكذب وصفه بذلك مالك بن انس.
 ووجه اخر وهو ان الاحراق بالنار قد صح عن رسول الله صلي الله عليه وسلم انه نهي عن ذلك كما نا عبد الله بن ربيع نا عمر بن عبد الملك الخولاني نا محمد بن بكر نا ابو داود نا سعيد بن منصور نا المغيرة بن عبد الرحمن الحزامي عن ابي الزناد عن محمد بن حمزة بن عمرو الاسلمي عن ابيه " ان رسول الله صلي الله عليه وسلم امره علي سرية وقال: ان وجدتم فلانا فاحرقوه بالنار فوليت فناداني فرجعت فقال: ان وجدتم فلانا فاقتلوه ولا تحرقوه فانه لا يعذب بالنار الا رب النار " ثم نظرنا في قول من راي قتلهم فوجدناهم يحتجون بما ناه عبد الله بن ربيع نا محمد بن اسحاق نا ابن الاعرابي نا الدبري نا ابو داود نا عبد الله بن محمد النفيلي نا عبد العزيز بن محمد  هو ابن محمد الدراوردي  عن عمرو بن ابي عمرو عن عكرمة عن ابن عباس قال: قال رسول الله صلي الله عليه وسلم: " من وجدتموه يعمل عمل قوم لوط فاقتلوا الفاعل والمفعول به " * حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب اخبرني القاسم بن عبد الله بن عمر بن حفص ني سهيل ابن ابي صالح عن ابيه عن ابي هريرة عن رسول الله صلي الله عليه واله قال: " اقتلوا الفاعل والمفعول به " وبه الي ابن وهب عن يحيي بن ايوب عن ابن جريج عن ابن عباس عن النبي صلي الله عليه وسلم بمثل ذلك، وبه الي يحيي بن ايوب عن رجل حدثه عن عبد الله بن محمد بن عقيل بن ابي طالب عن جابر بن عبد الله " ان رسول الله صلي الله عليه وسلم قال: من عمل عمل قوم لوط فاقتلوه " وهذا الرجل  هو عباد بن كثير  * قال ابو محمد رحمه الله: فهذا كل ما موهوا به وكله ليس لهم منه شء يصح،
 اما حديث ابن عباس فانفرد به عمرو بن ابي عمرو  وهو ضعيف.
 وابراهيم بن اسماعيل ضعيف، واما حديث ابي هريرة فانفرد به القاسم بن عبد الله بن عمر بن حفص  وهو مطرح في غاية السقوط  * واما حديث جابر فعن يحيي بن ايوب  وهو ضعيف  عن عباد ابن كثير  وهو شر منه  * واما حديث ابن ابي الزناد فابن ابي الزناد ضعيف.
 ومحمد بن عبد الله مجهول  وهو ايضا مرسل  فسقط كل ما في هذا الباب ولا يحل سفك دم يهودي.
 او نصراني من اهل الذمة نعم.
 ولا دم حربي بمثل هذه الروايات فكيف دم مسلم فاسق.
 او تاءب، ولو صح شء مما قلنا منها لقلنا به ولما استجزنا خلافه اصلا وبالله تعالي التوفيق، ثم نظرنا في قول من قال: يرجمان معا احصنا  او لم يحصنا فوجدناهم يحتجون بانه هكذا فعل الله بقوم لوط قال الله تعالي: (وامطرنا عليهم حجارة من سجيل منضود مسومة عند ربك) واحتجوا من الاثار التي ذكرنا انفا بما ناه احمد بن اسماعيل بن دليم نا محمد بن احمد بن الخلاص نا محمد بن القاسم بن شعبان ني محمد بن احمد عن يونس بن عبد الاعلي.
 وابي الربيع ابن ابي رشدين انا عبيد الله بن رافع عن عاصم بن عبيد الله عن سهيل بن ابي صالح عن ابيه عن ابي هريرة عن النبي صلي الله عليه وسلم قال: " الذي يعمل عمل قوم لوط فارجموا الاعلي والاسفل " وقال فيه: وقال: " احصنا او لم يحصنا " فهذا كل ما شغبوا به قد تقصيناه وكله لا حجة لهم فيه علي ما نبين ان شاء الله تعالي * اما فعل الله تعالي في قوم لوط فانه ليس كما ظنوا لان الله تعالي قال: (كذبت قوم لوط بالنذر انا ارسلنا عليهم حاصبا) الي قوله تعالي: (فذوقوا عذابي ونذر) وقال تعالي: (انا منجوك واهلك الا امراتك كانت من الغابرين) وقال تعالي: (انه مصيبها ما اصابهم) الاية، فنص تعالي نصا جليا علي ان قوم لوط كفروا فارسل عليهم الحاصب فصح ان الرجم الذي اصابهم لم يكن للفاحشة وحدها لكن للكفر ولها فلزمهم ان لا يرجموا
 من فعل فعل قوم لوط الا ان يكون كافرا والا فقد خالفوا حكم الله تعالي فابطلوا احتجاجهم بالاية اذ خالفوا حكمها، وايضا فان الله تعالي اخبر ان امراة لوط اصابها ما اصابهم وقد علم كل ذي مسكة عقل انها لم تعمل عمل قوم لوط فصح ان ذلك حكم لم يكن لذلك العمل وحده بلا مرية * (فان قالوا): انها كانت تعينهم علي ذلك العمل (قلنا): فارجموا كل من اعان علي ذلك العمل بدلالة او قيادة والا فقد تناقضتم وابطلتم احتجاجكم بالقران وخالفتموه، وايضا فان الله تعالي اخبر انهم راودوه عن ضيفه فطمس اعينهم فيلزمهم ولا بد ان يسملوا عيون فاعلي فعل قوم لوط لان الله تعالي لم يرجمهم فقط لكن طمس اعينهم ثم رجمهم، فاذ لم يفعلوا هذا فقد خالفوا حكم الله تعالي فيهم وابطلوا حجتهم، ويلزمهم ايضا ان يطمسوا عيني كل من راود اخر.
 ويلزمهم ايضا ان يحرقوا بالنار من نقص المكيال والميزان لان الله تعالي احرق بالنار قوم شعيب في ذلك.
 ويلزمهم ان يقتلوا من عقر ناقة اخر لان الله تعالي اهلك قوم صالح اذ عقروا الناقة اذ لا فرق بين عذاب الله تعالي قوم لوط بطمس العيون والرجم اذ اتوا تلك الفاحشة وبين احراق قوم شعيب اذ بخسوا المكيال والميزان وبين اهلاكه قوم صالح اذ عقروا الناقة قال الله تعالي: (ناقة الله وسقياها فكذبوه فعقروها) الي اخر السورة،  ثم نظرنا في قول من لم ير في ذلك حدا فوجدناهم يحتجون بقول الله تعالي: (ولا يقتلون النفس التي حرم الله الا بالحق ولا يزنون) الي قوله: (الا من تاب) وقال رسول الله صلي الله عليه وسلم: " لا يحل دم امرء مسلم الا باحدي ثلاث كفر بعد ايمان وزنا بعد احصان او نفسا بنفس " وقال عليه السلام: " ان دماءكم واموالكم واعراضكم وابشاركم عليكم حرام " فحرم الله تعالي دم كل امرء مسلم وذمي الا بالحق ولا حق الا في نص.
 او اجماع، وحرم النبي صلي الله عليه وسلم الدم الا بما اباحه به من الزنا بعد الاحصان.
 والكفر بعد الايمان.
 والقود.
 والمحدود في الخمر ثلاثا.
 والمحارب قبل ان يتوب وليس فاعل فعل قوم لوط واحدا من هءلاء فدمه حرام الا بنص او اجماع وقد قلنا انه لا يصح اثر في قتله نعم ولا يصح ايضا في ذلك شء عن احد من الصحابة رضي الله عنهم لان الرواية في ذلك عن ابي بكر.
 وعلي.
 والصحابة انما هي منقطعة.
 واحداها عن ابن سمعان عن مجهول.
 والاخري عمن لا يعتمد عل روايته، واما الرواية عن ابن عباس.
 فاحداهما عن معاذ بن الحرث عن عبد الرحمن بن قيس الضبي عن حسان بن مطر  وكلهم مجهولون  والرواية عن ابن الزبير.
 وابن عمر مثل ذلك عن مجهولين فبطل ان يتعلق احد في هذه المسالة عن احد من الصحابة رضي الله عنهم بشء يصح، واما من راي دون الحد فالحكم بن عتيبة * قال ابو محمد رحمه الله: فاذ قد صح ذلك انه لا قتل عليه ولا حد لان الله تعالي لم يوجب ذلك ولا رسوله عليه السلام فحكمه انه اتي منكرا فالواجب بامر رسول الله صلي الله عليه وسلم تغيير المنكر باليد فواجب ان يضرب التعزير الذي حده رسول الله صلي الله عليه وسلم في ذلك لا اكثر ويكف ضرره عن الناس فقط كما روينا من طريق البخاري نا مسلم بن ابراهيم نا هشام  هو الدستواءي  نا يحيي  هو ابن ابي كثير  عن عكرمة عن ابن عباس قال " لعن رسول الله صلي الله عليه وسلم المخنثين من الرجال والمترجلات من النساء وقال اخرجوهم من بيوتكم واخرج فلانا واخرج فلانا " واما السجن فلقول الله تعالي: (وتعاونوا علي البر والتقوي ولا تعاونوا علي الاثم والعدوان) وبيقين يدري كل ذي حس سليم ان كف ضرر فعلة قوم لوط الناكحين والمنكوحين عن الناس عون علي البر والتقوي وان اهمالهم عون علي الاثم والعدوان فوجب كفهم بما لا يستباح به لهم دم.
 ولا بشرة.
 ولا مال * قال ابو محمد رحمه الله: فان شنع بعض اهل القحة والحماقة ان يقول ان ترك قتلهم ذريعة الي هذا الفعل (قيل لهم) وترككم ان تقتلوا كل زان ذريعة الي اباحة الزنا منكم وترككم ان تقتلوا المرتد وان تاب تطريق منكم وذريعة الي اباحتكم الكفر.
 وعبادة الصليب.
 وتكذيب القران.
 والنبي عليه السلام.
 وترككم قتل اكل الخنزير.
 والميتة.

 والدم.
 وشارب الخمر تطريق منكم وذريعة الي اباحتكم اكل الخنزير.
 والميتة.
 والدم.
 وشرب الخمر.
 انما هذا انتصار منهم بمثل ما يهذرون به (ولمن انتصر بعد ظلمه فاولءك ما عليهم من سبيل انما السبيل) الاية ونعوذ بالله من ان نغضب له باكثر مما غضب تعالي لدينه او اقل من ذلك او ان نشرع باراءنا الشراءع الفاسدة ونحمد الله تعالي كثيرا علي ما من به علينا من التمسك بالقران.
 والسنة وبالله تعالي التوفيق *  مسالة  فيمن اتي بهيمة، قال ابو محمد رحمه الله: اختلف الناس فيمن اتي بهيمة، فقالت طاءفة: حده حد الزاني يرجم ان احصن ويجلد ان لم يحصن، وقالت طاءفة: يقتل ولا بد، وقالت طاءفة: عليه ادني الحدين احصن او لم يحصن، وقالت طاءفة: عليه الحد الا ان تكون البهيمة له، وقالت طاءفة: يعزر ان كانت البهيمة له وذبحت ولم تءكل وان كانت لغيره لم تذبح، وقالت طاءفة: فيها اجتهاد الامام في العقوبة بالغة ما بلغت، وقالت طاءفة: ليس فيه الا التعزير دون الحد، فالقول الاول كما نا احمد بن عمر بن انس نا ابو ذر نا عبد الله بن احمد بن حموية السرخسي نا ابراهيم بن خريم ابن فهر الشاشي ني عبد بن حميد انا يزيد بن هرون انا سفيان بن حسين عن ابي علي الرحبي عن عكرمة قال سءل الحسن بن علي  مقدمه من الشام  عن رجل اتي بهيمة فقال: ان كان محصنا رجم، وعن عامر الشعبي انه قال في الذي ياتي البهيمة او يعمل عمل قوم لوط قال عليه الحد، وعن الحسن البصري انه قال في الذي ياتي البهيمة ان كان ثيبا رجم وان كان بكرا جلد  وهو قول قتادة.
 والاوزاعي.
 واحد قولي الشافعي  والقول الثاني: عن ابن الهادي قال: قال ابن عمر في الذي ياتي البهيمة: لو وجدته لقتلته  وهو قول ابي سلمة بن عبد الرحمن بن عوف قال: تقتل البهيمة ايضا، والقول الثالث عن معمر عن الزهري في الذي ياتي البهيمة قال: عليه ادني الحدين احصن او لم يحصن، والقول الرابع عن ربيعة انه قال في الذي ياتي البهيمة هو المبتغي ما لم يحلل الله له فراي الامام فيه العقوبة بالغة
 ما بلغت فانه قد احدث في الاسلام امرا عظيما  وهو قول مالك  والقول الخامس عن ابن عباس في الذي ياتي البهيمة: لا حد عليه، وعن الشعبي مثله، وعن عطاء في الذي ياتي البهيمة فقال ما كان الله نسيا ان ينزل فيه ولكنه قبيح فقبحوا ما قبح الله  وهو قول اصحابنا  واحد قولي الشافعي * قال ابو محمد: فلما اختلفوا كما ذكرنا وجب ان ننظر فنظرنا فيما قال به اهل القول الاول فلم نجد لهم الا انهم قاسوه علي الزنا فقالوا هو وطء محرم والقياس كله باطل الا انه يلزم علي من اولج في حياء بهيمة الغسل وان لم ينزل ويجعله كالوطء في الفرج ولا  فرق، وفي القول الثاني فوجدناهم يحتجون بما رويناه كما نا حمام نا عباس بن اصبغ نا محمد ابن عبد الملك بن ايمن نا الحرث بن ابي اسامة نا عبد الوهاب  هو ابن عطاء الخفاف  نا عباد  هو ابن منصور  عن عكرمة عن ابن عباس عن النبي صلي الله عليه وسلم انه قال في الذي ياتي البهيمة: " اقتلوا الفاعل والمفعول به " * حدثنا عبد الله بن ربيع نا محمد بن اسحق نا ابن الاعرابي نا ابو داود نا النفيلي  هو عبد الله بن محمد  نا عبد العزيز  هو ابن محمد الدراوردي  عن عمرو بن ابي عمرو عن عكرمة عن ابن عباس قال قال رسول الله صلي الله عليه وسلم: " من وجدتموه يعمل عمل قوم لوط فاقتلوا الفاعل والمفعول به من اتي بهيمة فاقتلوه واقتلوها معه  قلت ما شان البهيمة؟ قال ما اراه قال ذلك الي انه كره اكل لحمها وقد عمل بها ذلك العمل " * حدثنا احمد بن محمد الطلمنكي نا ابن مفرج نا محمد بن ايوب الصموت الرقي نا احمد بن عمر بن عبد الخالق البزار نا اسماعيل بن مسعود الجحدري نا محمد بن اسماعيل بن ابي فديك نا ابراهيم بن اسماعيل  هو ابن ابي حبيبة  عن داود بن الحصين عن عكرمة عن ابن عباس عن النبي صلي الله عليه وسلم قال: " اقتلوا مواقع البهيمة اقتلوا الفاعل والمفعول به ومن عمل عمل قوم لوط فاقتلوا الفاعل والمفعول " * حدثنا عبد الله ابن ربيع نا محمد بن معاوية نا احمد بن شعيب انا قتيبة بن سعيد نا عبد العزيز بن محمد الدراوردي
 نا عمرو بن ابي عمرو عن عكرمة عن ابن عباس ان رسول الله صلي الله عليه وسلم قال: " لعن الله من عمل عمل قوم لوط ثلاث مرات لعن الله من واقع بهيمة من وجدتموه وقع علي بهيمة فاقتلوه واقتلوا البهيمة " فقيل لابن عباس ما شان البهيمة؟ قال ما سمعت من رسول الله صلي الله عليه وسلم في ذلك شيءا ولكن اري ان رسول الله صلي الله عليه وسلم كره ان يءكل من لحمها او ينتفع بها وقد عمل بها ذلك العمل * قال ابو محمد رحمه الله: لا حجة لهم غير ما ذكرنا وقد ذكرنا في الباب الذي قبل هذا ضعف هذه الاثار لان عباد بن منصور.
 وعمرو بن ابي عمرو.
 واسماعيل بن ابراهيم ضعفاء كلهم ولو صحت لقلنا بها ولجارينا عليها ولما حل خلافها فاذ لا تصح فلا يجوز القول بها الا انه قد كان لازما للحنيفيين.
 والمالكيين القول بها علي اصولهم فانهم احتجوا باسقط منها في ايجاب حد الخمر ثمانين في مواضع جمة، ثم نظرنا في قول من قال: عليه ادني الحدين فوجدناه لا حجة له اصلا ولا نعرف له وجها فسقط، ثم نظرنا في قول من قال يحد وتقتل البهيمة فوجدناه في غاية الفساد، ثم نظرنا في قول من قال عليه العقوبة براي الامام بالغة ما بلغت فوجدناه خطا لان الله تعالي قد زم الامور ولم يهملها ولم يطلق الاءمة علي دماء الناس ولا اعراضهم.
 ولا ابشارهم.
 ولا اموالهم بل قد تقدم اليهم علي لسان  رسوله عليه السلام فقال: " ان دماءكم واموالكم وابشاركم عليكم حرام " ولعل راي الامام يبلغ الي خصاءه.
 او الي اخذ ماله.
 او الي قتله.
 او الي بيعه فان منعوا من هذا سءلوا الفرق بين ما منعوا من هذا وبين ما اباحوا من غير ذلك ولا سبيل لهم اليه فحصل هذا القول لا حجة لقاءله، ثم نظرنا في القول الذي لم يبق غيره  وهو ان عليه التعزير فقط  فوجدناه صحيحا لانه قد اتي منكرا فان الله تعالي يقول: (والذين هم لفروجهم حافظون الا علي ازواجهم او ما ملكت ايمانهم) الي قوله تعالي: (العادون) ولا خلاف بين احد من الامة انه لا يحل ان تءتي البهيمة اصلا ففاعل ذلك فاعل منكر
 وقد امر رسول الله صلي الله عليه وسلم بتغيير المنكر باليد فعليه من التعزير ما نذكره ان شاء الله تعالي *  مسالة  من قذف اخر ببهيمة.
 او بفعل قوم لوط * قال ابو محمد رحمه الله: اختلف الناس في هذا، فقالت طاءفه: عليه حد القذف كما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر عن الزهري قال: من قذف اخر ببهيمة جلد حد الفرية، قال ابو حنيفة.
 ومالك.
 والشافعي: ليس عليه حد الفرية * قال ابو محمد رحمه الله: من جعل اتيان البهيمة زنا فقد طرد اصله وكذلك من جعل فعل قوم لوط زنا فقد طرد اصله اذ جعل في القذف بهما حد الزنا وقد بينا انهما ليسا زنا فالقذف بهما ليس هو القذف الموجب للحد وانما هو اذي فقط ففيه التعزير * واما المالكيون فانهم وافقونا علي ان فعل قوم لوط ليس زنا وان اتيان البهيمة ليس زنا فساووا بينهما في هذا الباب ثم انهم جعلوا في القذف بفعل قوم لوط حد القذف بالزنا ولم يجعلوا في القذف باتيان البهيمة حد القذف بالزنا وهذا تناقض (فان قالوا): ان فعل قوم لوط اعظم من الزنا (قيل لهم): هبكم انه كالكفر فهلا جعلتم في القذف بالكفر حد الزنا علي هذا الاصل الفاسد؟ وهذا لا مخلص منه (فان قالوا): هو زنا ولكنه اعظم الزنا فجعل فيه اعظم حدود الزنا لان المزني بها قد تحل يوما من الدهر وفعل قوم لوط لا يحل المفعول به ذلك للفاعل ابدا فهو اعظم بلا شك (قيل لهم): هذا يبطل من وجوه، احدها ان الزاني بحريمته من نسب او رضاع لا يحل له ابدا فاجعلوا فيه اغلظ حدود الزنا علي هذا الاصل، والثاني ان يقال لهم واطء اجنبية في دبرها اتي منها ما لا يحل له ابدا فان تزوجها فاجعلوا فيه علي هذا الاصل اغلظ حدود الزنا، والثالث ان يقال لهم ايضا:

 اتي البهيمة اتي ما لا يحل له ابدا فقد ساوي فعل قوم لوط في هذه العلة التي عللتم بها قولكم فهلا جعلتم فيه اغلظ الحدود في الزنا ايضا ولا فرق ثم رجعنا الي قولهم ان فعل قوم لوط اعظم الزنا فنقول لهم: اننا قد اوضحنا ان الزنا باللغة.
 وبسنة رسول الله صلي الله عليه وسلم لا يقع علي فعل قوم لوط وقد بينا انه ليس زنا ولا اعظم من الزنا لان رسول الله صلي الله عليه وسلم سءل اي الذنب اعظم؟ فقال: كلاما  معناه الشرك ثم قتل المرء ولده مخافة ان يطعم معه ثم الزنا بحليلة الجار  فصح ان الزنا بحليلة الجار اعظم من فعل قوم لوط بخبر رسول الله صلي الله عليه وسلم الذي لا يحل لاحد رده، وبالله تعالي التوفيق *  مسالة  الشهادة فيما ذكرنا * قال ابو محمد رحمه الله: اختلف الناس قال قوم منهم الشافعي.
 وقوم من اصحابنا: انه لا يقبل في فعل قوم لوط واتيان البهيمة اقل من اربعة شهود، وقال ابو حنيفة.
 واصحابه: يقبل في ذلك اثنان * قال ابو محمد: اما من جعل هذين الذنبين زنا فقد طرد اصله وقد اوضحنا بالبراهين الواضحة انهما ليسا من الزنا اصلا فليس لهما شء مما خص به حكم الزنا واحتج بعض اصحابنا في ذلك بان قالوا: ان الابشار محرمة الا بنص او اجماع، ولم يجمعوا علي اباحة بشرة فاعل فعل قوم لوط وبشرة اتي البهيمة بتعزير ولا بغيره الا باربعة شهود فلا يجوز استباحتهما باقل * قال ابو محمد رحمه الله: فيلزم من راعي هذا ان لا يحكم بقود اصلا الا باربعة شهود لانه لم يجمع علي اباحة دم المشهود عليه بالقتل باقل من اربعة شهود عدول فان قال بذلك كله قاءل كان الكلام معه من غير هذا وهو ان يقال له قد صح الاجماع الصادق القاطع المتيقن علي ان رسول الله صلي الله عليه وسلم امر بقبول البينة في جميع الاحكام اولها عن اخرها وحد في بعض الاحكام عددا وسكت عن بعضها فاذ لا شك في ذلك
 فهذان الحكمان وغيرهما قد ايقنا ان الله تعالي امرنا بانفاذ الواجب في ذلك بشهادة البينة فالواجب في ذلك قبول ما وقع عليه اسم بينة الا ان يمنع نص من شء من ذلك فيوقف عنده وقد منع النص من قبول الكافر والفاسق واخبر النص ان شهادة المراة نصف شهادة الرجل وان الصبيان غير مخاطبين بشء من الاحكام فخرج هءلاء من حكم الشهادة حسب ما اخرجهم النص فقط، وايضا فان الله تعالي يقول: (يا ايها الذين امنوا ان جاءكم فاسق بنبا فتبينوا) الاية فصح ان هذا حكم  من الله تعالي وارد في كل ما يحكم به علي احد في دمه.
 وماله.
 وبشرته وفي كل حكم فلولا النص الثابت ان رسول الله صلي الله عليه وسلم حكم بيمين الطالب مع الشاهد الواحد وصح انه عليه السلام لم يحكم بشهادة الشاهد الواحد دون يمين معها لوجب قبول شاهد واحد بالاية المذكورة الا حيث جاء النص باثنين او اربعة فلما كان هذان الحكمان لا يجوز فيهما تحليف الطالب لانهما ليسا حقا واحدا وانما هما لله تعالي وجب ان لا يجوز فيهما الا ما قال قاءلون باجازته وهو شهادة اثنين.
 او اربع نسوة.
 او رجل وامراتين كساءر الاحكام * واما الزنا وحده فلا يقبل فيه اقل من اربعة بالنص الوارد في ذلك وبالله تعالي التوفيق *  مسالة (السحق) قال ابو محمد رحمه الله: اختلف الناس في السحق فقالت طاءفة: تجلد كل واحدة منهما ماءة كما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق ني ابن جريج اخبرني ابن شهاب قال ادركت علماءنا يقولون في المراة تاتي المراة بالرفعة واشباهها يجلدان ماءة الفاعلة والمفعول بها * وبه الي عبد الرزاق عن معمر عن ابن شهاب بمثل ذلك، ورخصت فيه طاءفة كما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق انا ابن جريج اخبرني من اصدق عن الحسن البصري انه كان لا يري باسا بالمراة تدخل شيءا تريد الستر تستغني به عن
 الزنا، وقال اخرون هو حرام ولا حد فيه وفيه التعزير * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر في ذلك فنظرنا في قول الزهري فلم نجد له حجة اصلا الا ان يقول قاءل كما جعل فعل قوم لوط اشد الزنا فجعلوا فيه اعظم حد في الزنا فكذلك هذا اقل الزنا فجعل فيه اخف حد الزنا * قال ابو محمد رحمه الله: وهذا قياس لازم واجب علي من جعل الرجم في فعل قوم لوط لانه اعظم من الزنا ولا مخلص لهم من هذا اصلا وان يجعلوا السحق ايضا اشد الزنا كفعل قوم لوط فيلزمهم ان يجعلوا فيه الرجم كما جعلوا في فعل قوم لوط ولابد لان كلا الامرين عدول بالفرج الي ما لا يحل ابدا ولكن القوم لا يحسنون القياس ولا يعرفون الاستدلال ولا يطردون اقوالهم ولا يلزمون تعليلهم ولا يتعلقون بالنصوص، وهلا قالوا ههنا ان الزهري ادرك الصحابة وكبار التابعين؟ فلا يقول هذا الا عنهم ولا نعرف خلافا في ذلك ممن يري تحريم هذا العمل فياخذون بقوله كما كانوا يفعلون لو وافق تقليدهم *

 قال ابو محمد رحمه الله: واما نحن فان القياس باطل عندنا ولا يلزم اتباع قول احد دون رسول الله صلي الله عليه وسلم وسلم والسحق والرفعة ليسا زنا فاذ ليسا زنا فليس فيهما حد الزنا ولا لاحد ان يقسم برايه اعلي واخف فيقسم الحدود في ذلك كما يشتهي بل هو تعد لحدود الله تعالي وشرع في الدين ما لم ياذن به الله تعالي وهو يقول تعالي: (ومن يتعد حدود الله فقد ظلم نفسه) وانما يلزم هذا من قامت عليه الحجة فتمادي علي الخطا ناصرا للتقليد * قال ابو محمد رحمه الله: واذ لم يات بمثل قول الزهري قران.
 ولا سنة صحيحة فالابشار محرمة والحدود فلا حد في هذا اصلا وبالله تعالي التوفيق.
 فان ذكروا
 ما ناه احمد بن قاسم نا ابي قاسم بن محمد بن قاسم نا جدي قاسم بن اصبغ نا محمد بن وضاح نا هشام بن خالد نا بقية بن الوليد ني عثمان بن عبد الرحمن ني عنبسة بن سعيد نا مكحول عن واثلة بن الاسقع ان النبي صلي الله عليه وسلم قال: " السحاق زنا بالنساء بينهن " فان هذا لا يصح لانه عن بقية  وبقية ضعيف  ولم يدرك مكحولا.
 وواثلة فهو منقطع ثم لو صح لما كان فيه ما يوجب الحكم بالحد في ذلك لانه عليه السلام قد بين في حديث الاسلمي ما هو الزنا الموجب للحد وانما هو اتيان الرجل من المراة حراما ما ياتي من اهله حلالا، واخبر عليه السلام ان الاعضاء تزني وان الفرج يكذب ذلك او يصدقه فصح ان لا زنا بين رجل وامراة الا بالفرج الذي هو الذكر في الفرج الذي مخرج الولد فقط، ولقد كان يلزم هذا الخبر من راي برايه ان فعل قوم لوط اعظم الزنا فانه ليس معهم فيه نص اصلا ولو وجدوا مثل هذا لطغوا وبغوا فسقط هذا جملة واحدة، ثم نظرنا في قول الحسن في اباحة ذلك فوجدناه خطا لان الله تعالي يقول: (والذين هم لفروجهم حافظون الا علي ازواجهم او ما ملكت ايمانهم) الي قوله: (العادون) وصح بالدليل من القران.
 وبالاجماع ان المراة لا تحل لملك يمينها وانه منها ذو محرم لان الله تعالي اسقط الحجاب عن امهات المءمنين عن عبيدهن مع ذي محارمهن من النساء فصح ان العبد من سيده ذو محرم فالمراة اذا اباحت فرجها لغير زوجها فلم تحفظه فقد عصت الله تعالي بذلك وصح ان بشرتها محرمة علي غير زوجها الذي ابيحت له بالنص فاذا اباحت بشرتها لامراة او رجل غير زوجها فقد اباحت الحرام، وقد روينا من طريق مسلم نا ابو بكر بن ابي شيبة نا زيد بن الحباب  هو العكلي  نا الضحاك بن عثمان  هو الحزامي  اخبرني زيد بن اسلم عن عبد الرحمن بن ابي سعيد الخدري عن ابيه ان رسول الله  صلي الله عليه وسلم قال: " لا ينظر الرجل الي عورة الرجل ولا المراة الي عورة المراة ولا يفض
 الرجل الي الرجل في ثوب واحد ولا تفض المراة الي المراة في الثوب الواحد " * حدثنا احمد بن قاسم نا ابي قاسم بن محمد بن قاسم نا جدي قاسم بن اصبغ نا محمد بن وضاح نا ابو بكر بن ابي شيبة نا ابو الاحوص  هو سلام بن سليم  عن منصور ابن المعتمر عن ابي واءل  هو شقيق بن سلمة  عن عبد الله بن مسعود قال: نهي رسول الله صلي الله عليه وسلم ان تباشر المراة المراة في ثوب واحد  لعل ان تصفها الي زوجها كانه ينظر اليها * وبه الي قاسم بن اصبغ نا محمد بن عبد السلام الخشني نا محمد بن بشار  بندار  انا محمد بن جعفر  غندر  نا شعبة عن قتادة عن عكرمة عن ابن عباس قال: لعن رسول الله صلي الله عليه وسلم المتشبهين من الرجال بالنساء والمتشبهات من النساء بالرجال * قال ابو محمد رحمه الله: فهذه نصوص جلية علي تحريم مباشرة الرجل الرجل والمراة المراة علي السواء فالمباشرة منها لمن نهي عن مباشرته عاص لله تعالي مرتكب حرام علي السواء فاذا استعملت بالفروج كانت حراما زاءدا ومعصية مضاعفة والمراة اذا ادخلت فرجها شيءا غير ما ابيح لها من فرج زوجها او ما ترد به الحيض فلم تحفظ فرجها واذ لم تحفظه فقد زادت معصية فبطل قول الحسن في ذلك وبالله تعالي التوفيق * قال ابو محمد رحمه الله: فاذ قد صح ان المراة المساحقة للمراة عاصية فقد اتت منكرا فوجب تغيير ذلك باليد كما امر رسول الله صلي الله عليه وسلم " من راي منكرا ان يغيره بيده " فعليها التعزير * قال ابو محمد رحمه الله: فلو عرضت فرجها شيءا دون ان تدخله حتي ينزل فيكره هذا ولا اثم فيه وكذلك الاستمناء للرجال سواء سواء لان مس الرجل ذكره بشماله مباح ومس المراة فرجها كذلك مباح باجماع الامة كلها فاذ هو مباح فليس هنالك زيادة علي المباح الا التعمد لنزول المني فليس ذلك حراما اصلا لقول الله تعالي: (وقد فصل لكم ما حرم عليكم) وليس هذا مما فصل لنا تحريمه فهو حلال لقوله تعالي:
 (خلق لكم ما في الارض جميعا) الا اننا نكرهه لانه لس من مكارم الاخلاق ولا من الفضاءل، وقد تكلم الناس في هذا فكرهته طاءفة واباحته اخري كما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن سفيان الثوري عن عبد الله بن عثمان عن مجاهد قال: سءل ابن عمر عن الاستمناء؟ فقال ذلك ناءك نفسه، وبه الي سفيان الثوري عن الاعمش عن ابي رزين عن ابي يحيي عن ابن عباس ان رجلا قال له اني اعبث بذكري  حتي انزل قال اف نكاح الامة خير منه وهو خير من الزنا، واباحه قوم كما روينا بالسند المذكور الي عبد الرزاق نا ابن جريج اخبرني ابراهيم بن ابي بكر عن رجل عن ابن عباس انه قال وما هو الا ان يعرك احدكم زبه حتي ينزل الماء * حدثنا محمد بن سعيد بن نبات نا احمد بن عون الله نا قاسم بن اصبغ نا محمد بن عبد السلام الخشني نا محمد بن بشار  بندار  انا محمد بن جعفر  غندر  نا شعبة عن قتادة عن رجل عن ابن عمر انه قال انما هو عصب تدلكه، وبه الي قتادة عن العلاء بن زياد عن ابيه انهم كانوا يفعلونه في المغازي يعني الاستمناء يعبث الرجل بذكره يدلكه حتي ينزل قال قتادة: وقال الحسن في الرجل يستمني يعبث بذكره حتي ينزل قال: كانوا يفعلون في المغازي، وعن جابر بن زيد ابي الشعثاء قال هو ماءك فاهرقه  يعني الاستمناء ، وعن مجاهد قال كان من مضي يامرون شبابهم بالاستمناء يستعفون بذلك قال عبد الرزاق: وذكره معمر عن ايوب السختياني او غيره عن مجاهد عن الحسن انه كان لا يري باسا بالاستمناء، وعن عمرو بن دينار ما اري بالاستمناء باسا * قال ابو محمد رحمه الله: الاسانيد عن ابن عباس.
 وابن عمر في كلا القولين مغموزة لكن الكراهة صحيحة عن عطاء والاباحة المطلقة صحيحة عن الحسن.
 وعن عمرو بن دينار.
 وعن زياد ابي العلاء.
 وعن مجاهد ورواه من رواه من هءلاء عمن ادركوا وهءلاء كبار التابعين الذين لا يكادون يروون الا عن الصحابة رضي
 الله عنهم * قال ابو محمد رحمه الله: وقد جاء في المراة تفتض المراة باصبعها اثار كما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق نا ابن جريج عن عطاء عن علي بن ابي طالب والحسن بن علي ان الحسن افتي في امراة افتضت اخري باصبعها وامسكها نسوة لذلك ان العقل بينهن وقضي علي بذلك، وبه الي عبد الرزاق عن سفيان الثوري عن منصور.
 ومغيرة قال منصور عن الحكم بن عتيبة: وقال مغيرة عن ابراهيم، ثم اتفق الحكم: وابراهيم عن علي.
 والحسن ان الحسن افتي في امراة افتضت امراة باصبعها ان عليها والممسكات الصداق بينهن هكذا قال المغيرة، وقال الحكم في روايته علي المفتضة وحدها واتفقا ان عليا قضي بذلك، وعن الزهري لو افتضت امراة باصبعها غرمت صداقها كصداق امراة من نساءها، وعن عياض بن عبيد الله قاضي اهل مصر كتب الي عمر بن عبد العزيز في صبي افترع صبية باصبعه فكتب اليه عمر لم يبلغني في هذا شء وقد جمعت لذلك فاقض فيه برايك فقضي لها علي الغلام بخمسين دينارا *

 قال ابو محمد رحمه الله: هذا عن علي مرسل وقد قال رسول الله صلي الله عليه وسلم: " ان دماءكم واموالكم عليكم حرام " فلا يجوز ان يقضي ههنا بصداق لانه ليس زواجا ولا صداق الا في نكاح زواج اذ لم يوجبه في غير ذلك نص ولا اجماع فسواء كان المتفض باصبعه رجلا او امراة لا غرامة في ذلك اصلا لان الله تعالي لم يوجب في ذلك غرامة.
 ولا رسوله صلي الله عليه وسلم، فان شنعوا بان هذا قول علي.
 والحسن بن علي (قلنا لهم) فان هذين الخبرين ليس فيهما ايجاب نكال علي المفتض والمفتضة اصلا وانتم توجبون في ذلك الادب وهذا خلاف منكم لما تشنعون به من حكم علي.
 والحسن رضي الله عنهما وعار هذا واثمه انما يلزم من اوجب فرضا اتباع ما روي عن الصاحب ثم هو مع ذلك اول مخالف له واما نحن فلا يلزم عندنا اتباع احد غير رسول الله صلي الله عليه وسلم فقط فلا حرج علينا في مخالفة
 ما لا نراه واجبا ولكن علي المفتض باصبعه امراة والمفتضة باصبعها امراة ومدخل شء في دبر اخر التعزير لان كل ما ذكرنا معصية ومنكر لقول رسول الله صلي الله عليه وسلم: " ان دماءكم واموالكم واعراضكم وابشاركم عليكم حرام " وهءلاء قد انتهكوا بشرة محرمة فاتوا منكرا ومن اتي منكرا ففرض عليه تغييره باليد كما امر رسول الله صلي الله عليه وسلم فواجب علي من فعل ذلك او غيره من المنكرات التعزير علي ما نذكره ان شاء الله تعالي بعد هذا * قال ابو محمد رحمه الله: ولم يقل احد نعلمه ان في شء من هذا حد زنا ولا حدا محدودا ولا فرق بينه وبين ساءر ما اوجبوا فيه الحدود مما لا نص فيه يصح وبالله تعالي التوفيق *  مسالة  السحر  قال ابو محمد رحمه الله: اختلف الناس في السحر، فقالت طاءفة: يقتل الساحر ولا يستتاب  والسحر كفر  وهو قول مالك  وقال ابو حنيفة: يقتل الساحر، وقال الشافعي: واصحابنا: ان كان الكلام الذي يسحر به كفرا فالساحر مرتد وان كان ليس كفرا فلا يقتل لانه ليس كافرا، وذكر عن المتقدمين في ذلك اشياء كما نا حمام نا ابن مفرج نا ابن الاعرابي نا لدبري نا عبد الرزاق عن ابن جريج اخبرني عمرو بن دينار قال ان عمر بن الخطاب كتب الي جزي بن معاوية عم الاحنف ابن قيس  وكان عاملا لعمر بن الخطاب  ان اقتل كل ساحر وكاتب بجالة كاتب جزي قال بجالة فارسلنا فوجدنا ثلاث سواحر فضربنا اعناقهن، وبه الي عبد الرزاق عن ابن عيينة عن عمرو بن دينار عن سالم بن ابي الجعد قال ان قيس بن سعد قتل ساحرا، وعن نافع عن ابن عمر ان جارية لحفصة سحرتها فاعترفت بذلك فامرت بها عبد الرحمن بن زيد فقتلها  فانكر ذلك عليها عثمان فقال له ابن عمر ما تنكر علي ام المءمنين امراة سحرت واعترفت فسكت عثمان، وعن ايوب السختياني عن نافع ان حفصة سحرت فامرت عبيد الله
 اخاها فقتل ساحرتين، وعن العطاف بن خالد المخزومي ابو صفوان قال رايت سالم ابن عبد الله وهو واقف علي جدار بيت لبني اخ له يتامي اتاه غلمة اربعة ومعهم غلام هو اشف منهم فقال يا ابا عمر انظر ما يصنع هذا قال: وماذا يصنع؟ قال فسل خيطا من ثوبه فقطعه وسالم ينظر اليه فجمعه بين اصبعين من اصابعه ثم تفل عليه مرتين او ثلاثا ثم مده فاذا هو صحيح ليس به باس فسمعت سالما يقول لو كان لي من الامر شء لصلبته، وعن يحيي بن سعيد الانصاري ان خالد بن المهاجر بن خالد قتل نبطيا سحر  يعني ذميا  وعن يحيي بن ابي كثير قال ان غلاما لعمر بن عبد العزيز اخذ ساحرة فالقاها في الماء فطفت فكتب اليه عمر بن عبد العزيز ان الله لم يامرك ان تلقيها في الماء فان اعترفت فاقتلها، وعن ابن شهاب قال يقتل ساحر المسلمين ولا يقتل ساحر اهل الكتاب لان النبي صلي الله عليه وسلم سحره رجل من اليهود يقال له ابن اعصم.
 وامراة من خيبر يقال لها زينب فلم يقتلهما * قال ابو محمد رحمه الله: فهءلاء عمر بن الخطاب.
 وحفصة.
 وعبد الله ابناه.
 وعبيد الله ابنه.
 وعثمان.
 وقيس بن ربيعة.
 ومن التابعين سالم بن عبد الله.
 وخالد بن المهاجر.
 وعمر بن عبد العزيز.
 وعبد الرحمن بن زيد بن الخطاب، واما من خالف هذا فكما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن مالك بن انس عن محمد ابن عبد الرحمن  هو ابو الرجال  عن عمرة بنت عبد الرحمن ان عاءشة ام المءمنين اعتقت جارية لها عن دبر وانها سحرتها واعترفت بذلك وقالت احببت العتق فامرت بها عاءشة ابن اخيها ان يبيعها من الاعراب ممن يسء ملكتها وقالت ابتع بثمنها رقبة فاعتقها، وبه الي عبد الرزاق عن سفيان بن عيينة عن يحيي بن سعيد الانصاري عن ابي الرجال عن عمرة قالت: مرضت عاءشة فطال مرضها فذهب بنو اخيها الي رجل فذكروا له مرضها فقال انكم لتخبروني خبر امراة مطبوبة فذهبوا ينظرون فاذا جارية لها قد سحرتها وكانت قد دبرتها فقالت لها ما اردت مني قالت اردت ان تموتي حتي اعتق قالت فان لله علي ان
 تباع من اشد العرب ملكة فباعتها وامرت بثمنها ان يجعل في مثلها، وعن ربيعة بن عطاء ان رجلا عبدا سحر جارية عربية وكانت تتبعه فرفع الي عروة بن محمد  وكان عامل عمر بن عبد العزيز  فكتب اليه عمر بن عبد العزيز ان يبيعه بغير ارضها وارضه ثم ادفع ثمنه اليها وقد ذكرنا عن عثمان رضي الله عنه انكار قتل الساحر *

 قال ابو محمد: فلما اختلفوا كما ذكرنا وجب ان ننظر في قول من راي قتل الساحر فوجدناهم يقولون: قال الله تعالي: (واتبعوا ما تتلوا الشياطين علي ملك سليمان وما كفر سليمان ولكن الشياطين كفروا يعلمون الناس السحر) الاية قالوا: فسمي الله تعالي السحر كفرا بقوله: (ولكن الشياطين كفروا يعلمون الناس السحر) قال فيعلمون بدل من كفروا فتعليم السحر كفر، وايضا بقوله تعالي: (انما نحن فتنة فلا تكفر) وايضا بقوله تعالي: (ولقد علموا لمن اشتراه ما له في الاخرة من خلاق) وبقوله.
 (ولبءس ما شروا به انفسهم لو كانوا يعلمون) وذكروا ما ناه حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن سفيان بن عيينة عن اسماعيل بن مسلم عن الحسن قال: قال النبي صلي الله عليه وسلم: " حد الساحر ضربه بالسيف " * وبه الي عبد الرزاق عن ابراهيم بن ابي يحيي عن صفوان بن سليم قال: قال رسول الله صلي الله عليه وسلم: " من تعلم السحر قليلا او كثيرا كان اخر عهده من الله " * حدثنا يحيي بن عبد الرحمن بن مسعود نا احمد بن جهيم نا ابراهيم بن حماد نا اسماعيل بن اسحق نا الحجاج بن المنهال نا حماد بن سلمة عن سعيد الجريري عن ابي العلاء " ان رسول الله صلي الله عليه وسلم جانب عقبة ذات ليلة فنزل فجعل يرتجز ويقول: * جندب وما جندب * والاقطع الخبر الخبر * فلما اصبح قال اصحابه يا رسول الله صلي الله عليه وسلم ما راينا راجزا احسن رجزا منك الليلة فما جندب والاقطع؟ قال: اما جندب فرجل من امتي يضرب ضربة يبعث بها امة وحده يوم القيامة واما الاقطع فرجل تقطع يده فتدخل الجنة قبل
 جسده ببرهة من الدهر " فكانوا يرون ان الاقطع زيد بن صوحان قطعت يده يوم اليرموك قبل يوم الجمل مع علي، واما جندب فهو الذي قتل الساحر * قال نا حماد ابن سلمة نا ابوعمران  هو الجوني  ان ساحرا كان عند الوليد بن عقبة فجعل يدخل في بقرة ثم يخرج منها فراه جندب فذهب الي بيته فالتفع علي سيفه فلما دخل الساحر جوف البقرة ضربهما وقال: (اتاتون السحر وانتم تبصرون) فاندفع الناس وتفرقوا وقالوا: حروري فسجنه الوليد وكتب به الي عثمان بن عفان فكان يفتح له بالليل فيذهب الي اهله فاذا اصبح رجع الي السجن قال: فيرون ان جندبا صاحب الضربة * قال ابو محمد رحمه الله: ما نعلم لهم شيءا غير ما ذكرنا قد تقصيناه لهم غاية التقصي واتينا بما لم نذكره ايضا وكل ذلك لا حجة لهم في شء منه علي ما نبين ان شاء الله تعالي فنقول وبالله تعالي التوفيق، اما ما ذكروه من اقوال الصحابة رضي الله عنهم فلا حجة لهم في شء منه، اما قول عمر رضي الله عنه فانه خبر صحيح عنه اخذوا  ما اشتهوا منه وتركوا ساءره وهو خبر ناه حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن معمر.
 وسفيان بن عيينة كلاهما عن عمرو بن دينار قال: سمعت بجالة كاتب جزي يحدث ابا الشعثاء.
 وعمرو بن اوس عند صفة زمزم في امارة المصعب ابن الزبير قال: كنت كاتبا لجزي  عم الاحنف بن قيس  فاتي كتاب عمر قبل موته.
 بسنة اقتلوا كل ساحر وفرقوا بين كل ذي رحم محرم من المجوس وانههم عن الزمزمة قال: فقتلنا ثلاث سواحر قال وصنع طعاما كثيرا وعرض السيف ثم دعا المجوس فالقوا وقر بغل او بغلين من ورق اخلة كانوا ياكلون بها واكلوا بغير زمزمة قال: ولم يكن عمر اخذ من المجوس الجزية حتي شهد عبد الرحمن بن عوف ان النبي صلي الله عليه وسلم اخذها من مجوس اهل هجر فهكذا الحديث، والمالكيون.
 والحنيفيون يخالفون عمر في هذا الخبر فيما لا يحل خلافه فيه من امره بان يفرق بين كل ذي رحم
 محرم من المجوس لان هذا هو امر الله تعالي اذ يقول تعالي: (وان احكم بينهم بما انزل الله) فهو اذ يقول تعالي: (وقاتلوهم حتي لا تكون فتنة ويكون الدين كله لله) فقال الحنيفيون.
 والمالكيون: لا يفرق بين مجوسي وبين حريمته وتءخذ الجزية من كل من ليس كتابيا من العجم فخالفوا القران.
 وعمر بن الخطاب حيث لا يحل خلافه وقلدوه بزعمهم حيث حكم فيه بما اداه اليه اجتهاده مما لم يرد فيه قران ولا صحت به سنة فهذا عكس الحقاءق  والزمزمة كلام تتكلم به المجوس عند اكلهم لا بد لهم منه ولا يحل في دينهم اكل دونه  وهو كلام تعظيم لله تعالي يتكلمون به في افواههم خلقة وشفاهم مطبقة لا يجوز عندهم خلاف ذلك  ولهم خشبات صغار يستعملونها عند ذلك  واخلة ياكلون بها  وهذا حمق منهم وتكلف، وبالسند المذكور الي عبد الرزاق عن عبد الرحمن عن المثني بن الصباح عن عمرو بن شعيب عن سعيد بن المسيب ان عمر بن الخطاب اخذ ساحرا فدفنه الي صدره ثم تركه حتي مات  وهم لا ياخذون بهذا نفسه من حكم عمر في الساحر  وحتي لو التزموا قول عمر كله لكان اذ صح خلاف عاءشة له في ذلك ولما كان قوله اولي من قولها ولا قولها اولي من قوله فالواجب عند التنازع الرجوع الي ما افترض الله تعالي الرجوع اليه من القران والسنة فسقط تعلقهم بعمر في ذلك، واما حديث قيس بن سعيد انه قتل ساحرا فقد يمكن ان يكون ذلك الساحر كافرا اضر بمسلم فقتله وهكذا نقول وايضا فقد صح خلاف ذلك عن عاءشة رضي الله عنه فسقط تعلقهم بحديث قيس، واما حديث حفصة.
 وابن عمر فقد قلنا انه لا حجة في قول احد دون رسول الله صلي الله عليه وسلم، ثم نظرنا في  الاثار التي ذكروا في ذلك فوجدنا خبر الحسن مرسلا ولا حجة في مرسل ولو صح لما كان لهم فيه متعلق اصلا لانه انما فيه حد الساحر ضربة بالسيف وليس فيه قتله والضربة قد تخطء فتجرح فقط وقد تقتل فهم قد خالفوا هذا الخبر واوجبوا قتله ولا بد، واما
 خبر جندب ففي غاية السقوط اول ذلك انه مرسل لا يدري ممن سمعه ابو العلاء فلم يبق الا الاية فوجب النظر فيها ففعلنا بعون الله تعالي وابتدانا باولها من قوله تعالي: (ولكن الشياطين كفروا يعلمون الناس السحر) وقولهم يعلمون بدل من كفروا فنظرنا في ذلك فوجدناه ليس كما ظنوا وان قولهم هذا دعوي بلا برهان بل القول الظاهر هو ان الكلام تم عند قوله تعالي: (كفروا) وكملت القصة وقامت بنفسها صحيحة تامة (ولكن الشياطين كفروا) ثم ابتدا تعالي قصة اخري مبتداة وهو قوله تعالي: (يعلمون الناس السحر) فيعلمون ابتداء كلام لا بدل ثم لو صح ان يعلمون بدل من كفروا ولم يحتمل غير ذلك اصلا لما كان لهم فيه حجة البتة لان ذلك خبر من الله تعالي عن ان ذلك كان حكم الشياطين بعد ايام سليمان عليه السلام وذلك شريعة لا تلزمنا وحكم الله تعالي في الشياطين حكم خارج من حكمنا وكل حكم لم يكن في شريعتنا فلا يلزمنا بل قد صح ان حكم الجن اليوم في شريعتنا غير حكمنا كما قد صح عن النبي صلي الله عليه وسلم انه اباح لهم الروث والعظام طعاما والروث حرام عندنا وحلال لهم فكيف واذا احتمل ظاهر الاية معنيين فلا يجوز حملها علي احدهما دون الاخر الا ببرهان وقد بينا ان كلا الوجهين لا حجة لهم فيه اصلا، وايضا فان نص قولهم ان الشياطين كفروا بتعليم الناس السحر وهم يزعمون ان الملكين يعلمان الناس السحر ولا يكفر الملكان عندهم بذلك فقد اقروا باختلاف حكم تعليم السحر وانه يكون كفرا ولا يكون كفرا بذلك فاذ قد قالوا ذلك فمن اين لهم ان حكم الساحر من الناس الكفر قياسا علي الشياطين دون ان لا يكون كفرا قياسا علي الملكين؟ فكيف والقياس كله باطل فصح انه لا حجة لهم في تكفير الساحر من الناس بان الشياطين يكفرون بتعليمه هذا لو صح لهم ان كفر الشياطين لم يكن الا بتعليمهم الناس السحر خاصة وهذا لا يصح لهم ابدا بل قد كفروا قبل ذلك فكان تعليمهم الناس السحر ضلالا زاءدا ومعصية حادثة اخري وهذا هو مقتضي ظاهر الاية الذي لا يجوز ان يحال عنه البتة الا بالدعوي العارية من البرهان وبالله تعالي التوفيق، ثم صرنا الي قول الله تعالي: (وما يعلمان من احد حتي
 يقولا انما نحن فتنة فلا تكفر) فوجدناهم لا حجة لهم فيه اصلا بوجه من الوجوه لانه انما في هذا الكلام النهي عن الكفر جملة ولم يقولا فلا تكفر بتعلمك السحر ولا بعلمك السحر هذا ما لا يفهم من الاية اصلا، وهكذا قول رسول الله صلي الله عليه وسلم: " لا ترجعوا  بعدي كفارا يضرب بعضكم رقاب بعض " انما هو نهي ان يكفروا ابتداء وعن ان يرتدوا فقط لا انهم بقتل بعضهم بعضا يكونون كفارا وهذا بين لا خفاء به وبالله تعالي التوفيق * وكل من اقحم في هذه الاية ان قوله تعالي حاكيا عن القاءلين (انما نحن فتنة فلا تكفر) ان مرادهما لا تكفر بتعلمك ما نعلمك فقد كذب وزاد في القران ما ليس فيه وما لا دليل عليه اصلا، ثم صرنا الي قوله تعالي: (فيتعلمون منهما ما يفرقون به بين المرء وزوجه) فوجدنا هذا ابعد من ان يكون لهم فيه شبهة يموهون بها من كل ما سلف لانه لم يختلف احد من اهل السنة في ان من فرق بين امراة وزوجها لا يكون كافرا بذلك بل قد وجدنا المالكيين.
 والحنيفيين يفرقون بين المرء وزوجه بما لم ياذن الله تعالي به قط ولا رسوله صلي الله عليه وسلم كالشروط الفاسدة.
 والتخيير.
 والتمليك والعناية.
 وعدم النفقه، واعجب من ذلك كله اباحة الحنيفيين لمن طالت يده من الفساق.
 ولمن قصرت يده منهم ان ياتي الي من عشق امراة رجل من المسلمين ان يحمل السوط علي ظهره حتي ينطق بطلاقها مكرها فاذا اعتدت اكرهها الفاسق علي ان تتزوجه بالسياط ايضا حتي تنطق بالرضا مكرهة فكان ذلك عندهم نكاحا طيبا وزواجا مباركا وطءا حلالا يتقرب به الي الله تعالي وتالله ما في الذي شنعه الله تعالي من التفريق بين المرء وزوجه اعظم اثما ولا اشنع حراما ولا ابعد من رضاء الله تعالي ولا ادني من راي ابليس ومن الشياطين من هذا التفريق الذي امضوه واجازوه ونسال الله الي العافية من مثل هذا وشبهه وقد نجد النمام يفرق بين المرء وزوجه فلا يكون بذلك كافرا فمن اين وقع لهم ان يكفروا الساحر بذلك؟ فبطل تعلقهم بهذا النص جملة وهكذا القول في قوله تعالي:
 (وما هم بضارين به من احد الا باذن الله ويتعلمون ما يضرهم ولا ينفعهم) اذ ليس كل ما ضر المرء يكون به كافرا بل يكون عاصيا لله تعالي لا كافرا ولا حلال الدم، ثم صرنا الي قوله تعالي: (ولقد علموا لمن اشتراه) الي قوله تعالي: (لو كانوا يعلمون) فوجدناهم لا حجة لهم في تكفير الساحر ولا في اباحة دمه اصلا لان هذه الصفة قد تكون في مسلم باجماعهم معنا كما روينا من طريق مسلم نا شيبان بن فروخ نا جرير بن حازم نا نافع عن ابن عمر قال: قال رسول الله صلي الله عليه وسلم: " انما يلبس الحرير في الدنيا من لا خلاق له في الاخر " * قال ابو محمد رحمه الله: وهم لا يختلفون في ان لباس الحرير ليس كفرا ولا يحل قتل لابسه فبطل تعلقهم بهذه الاية ولله الحمد، فنظرنا ان يكون لهم في الاية متعلق اصلا ولا في شء من القران.
 ولا من السنن الصحاح.
 ولا في السنن الواهية  ولا في اجماع.
 ولا في قول صاحب.
 ولا في قياس.
 ولا نظر.
 ولا راي سديد يصح بل كل هذه الوجوه مبطلة لقولهم فلما بطل قول من راي ان يقتل الساحر جملة وقول من ادعي ان السحر كفر بالجملة وجب ان ننظر في القول الثالث فوجدنا الله تعالي يقول: (ولا تقتلوا انفسكم) وقال تعالي: (فاقتلوا المشركين حيث وجدتموهم) الي قوله: (فخلوا سبيلهم) وقال تعالي: (ولا تقتلوا النفس التي حرم الله الا بالحق) وقال تعالي: (ومن يقتل مءمنا متعمدا) الاية، وقال رسول الله صلي الله عليه وسلم: " ان دماءكم واموالكم عليكم حرام " فصح بالقران.
 والسنة ان كل مسلم فدمه حرام الا بنص ثابت او اجماع متيقن فنظرنا هل نجد في السحر نصا ثابتا بتبيان ما هو؟ فوجدنا من طريق مسلم نا هرون بن سعيد الايلي نا ابن وهب اخبرني سليمان بن بلال عن ثور بن يزيد عن ابي الغيث عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال: " اجتنبوا السبع الموبقات قيل يا رسول الله وما هن؟ قال: الشرك بالله والسحر وقتل النفس التي
 حرم الله الا بالحق واكل مال اليتيم واكل الربا والتولي يوم الزحف وقذف المحصنات المءمنات " فكان هذا بيانا جليا بان السحر ليس من الشرك ولكنه معصية موبقة كقتل النفس وشبهها فارتفع الاشكال ولله الحمد، وصح ان السحر ليس كفرا واذا لم يكن كفرا فلا يحل قتل فاعله لان رسول الله صلي الله عليه وسلم يقول: " لا يحل دم امرء مسلم الا باحدي ثلاث كفر بعد ايمان وزنا بعد احصان ونفس بنفس " فالساحر ليس كافرا كما بينا ولا قاتلا ولا زانيا محصنا ولا جاء في قتله نص صحيح فيضاف الي هذه الثلاث كما جاء في المحارب والمحدود في الخمر ثلاث مرات فصح تحريم دمه بيقين لا اشكال فيه * ووجدنا ايضا من طريق البخاري نا عبد الله بن محمد سمعت سفيان بن عيينة يقول: ان هشام بن عروة حدثهم عن ابيه عن عاءشة ام المءمنين قالت: " كان رسول الله صلي الله عليه وسلم سحر حتي يري انه ياتي النساء ولا ياتيهن  قال ابن عيينة وهذا اشد ما يكون من السحر  فقال يا عاءشة.
 اعلمت ان الله افتاني فيما استفتيته فيه؟ اتاني رجلان فقعد احدهما عند راسي والاخر عند رجلي فقال الذي عند راسي للاخر ما بال الرجل؟ فقال: مطبوب قال: ومن طبه قال لبيد بن اعصم  رجل من بني زريق حليف اليهود وكان منافقا  قال وفيم؟ قال في مشط ومشاطة قال واين؟ قال في جف طلعة ذكر تحت راعونة في بءر ذروان قال فاتي البءر حتي استخرجه قال فهذه البءر التي رايتها كان ماءها نقاعة الحناء وكان نخلها رءوس الشياطين قال: فاستخرج فقلت افلا تنشرت؟ قال اما الله فقد شفاني واكره ان اثير علي الناس شرا " *

 قال ابو محمد: فهذا خبر صحيح، وقد عرف الله تعالي رسوله صلي الله عليه وسلم من سحره فلم يقتله (فان قيل): فان في هذا الحديث انه كان منافقا وفي بعض رواياته انه كان يهوديا وانتم تقولون ان الكافر اذا اضر بمسلم وجب قتله وبرءت منه الذمة وان المنافق اذا عرف وجب قتله (قلنا): اننا كذلك نقول لان
 البرهان قام بذلك * واما الذمي اذا اضر بمسلم فلقول الله تعالي: (حتي يعطوا الجزية عن يد وهم صاغرون) فانما حرمت دماء اهل الكتاب بالتزام الصغار فاذا فارقوا الصغار فقد برءت ذمتهم وسقط تحريم دماءهم وعادت حلالا كما كانت لان الله تعالي اباح دماءهم ابدا الا بالصغار فاذا لم يكن الصغار فدماءهم لم تحرم وهم اذا اضروا بمسلم فلم يصغروهم وقد اصغروه فدماءهم حلال، واما المنافق فاذا عرف انه كافر فقد قال رسول الله صلي الله عليه وسلم: " من بدل دينه فاقتلوه " فهذا المنافق او اليهودي نحن علي يقين لا مرية فيه انه لم يكن الله تعالي امر رسوله صلي الله عليه وسلم بعد بقتل من بدل دينه ولا بقتل من لم يلتزم الصغار من اهل الذمة، برهان ذلك لا يشك انه من في قلبه مقدار ذرة من ايمان ان رسول الله صلي الله عليه وسلم لا يتعمد عصيان ربه فلو امره ربه تعالي بقتلهم لانفذ ذلك فاذ لم يقتله عليه السلام فبيقين نقطع ونبت ان ذلك كان قبل نزول الاية بقتل اهل الكتاب ما لم يءدوا الجزية مع الصغار وقبل ان ينزل عليه الامر بقتل من بدل دينه * (فان قالوا): قولوا كذلك في الساحر (قلنا): نعم هكذا نقول وهو ان الساحر بهذا الخبر حرام الدم وكذلك اليهودي يضر بالمسلم فكيف بسيد اهل الاسلام صلي الله عليه وسلم، وكذلك من اعلن الاسلام واسر الكفر ثم صح امر الله تعالي بتحريم دماء اهل الكتاب بالجزية مع الصغار واباحتها بعدم ذلك وصح امر رسول الله صلي الله عليه وسلم بقتل من بدل دينه فصرنا الي ذلك ولم يات امر صحيح بقتل الساحر فبقي علي تحريم الدم فارتفع الاشكال جملة وبالله تعالي التوفيق *  مسالة  التعزير * قال ابو محمد رحمه الله: اختلف الناس في مقدار التعزير فقالت طاءفة: ليس له مقدار محدود وجاءز ان يبلغ به الامام ما راه وان يجاوز به الحدود بالغا ما بلغ  وهو قول مالك  واحد اقوال ابي يوسف وهو قول ابي ثور.
 والطحاوي من اصحاب ابي حنيفة  * وقالت طاءفة: التعزير
 ماءة جلدة فاقل، وقالت طاءفة: اكثر التعزير ماءة جلدة الا جلدة، وقالت طاءفة: اكثر التعزير تسعة وسبعون سوطا فاقل  وهو احد اقوال ابي يوسف، وقالت  طاءفة: اكثر التعزير خمسة وسبعون سوطا فاقل  وهو قول ابن ابي ليلي، واحد اقوال ابي يوسف، وقالت طاءفة: اكثر التعزير ثلاثون سوطا، وقالت طاءفة: اكثر التعزير عشرون سوطا، وقالت طاءفة: لا يتجاوز بالتعزير تسعة  وهو قول بعض اصحاب الشافعي، وقالت طاءفة: اكثر التعزير عشرة اسواط فاقل لا يجوز ان يتجاوز به اكثر من ذلك  وهو قول الليث بن سعد، وقول اصحابنا * قال ابو محمد رحمه الله: فمما روي في القول الاول ما ناه احمد بن عمر بن انس نا الحسن بن يعقوب نا سعد بن فحلون نا يوسف بن يحيي نا عبد الملك بن حبيب قال: قال لي مطرف بن عبد الله ثقة: اتي هشام بن عبد الله المخزومي  وهو قاضي المدينة ومن صالح قضاتها  برجل خبيث معروف باتباع الصبيان قد لصق بغلام في ازدحام الناس حتي افضي فبعث به هشام الي مالك وقال: اتري ان اقتله قال وكان هشام شديدا في الحدود فقال مالك: اما القتل فلا ولكن اري ان تعاقبه عقوبة موجعة فقال: كم؟ قال: ذلك اليك فامر به هشام فجلد اربع ماءة سوط وابقاه في السجن فما لبث ان مات فذكروا ذلك لمالك فما استنكر ولا راي انه اخطا * قال ابو محمد رحمه الله: وذكر محمد بن سحنون بن سعيد في كتابه الذي جمع فيه احكام ابيه ايام ولايته قضاء مدينة القيروان لابن الاغلب قال: شكي الي ابي رجل ياتي زوجته انه غيب عنه ابنته وحال بينه وبينها فبعث في ابي الجارية قال اين ابنتك امراة هذا؟ فقال والله ما اتتني ولا ادري اين هي ولا لها عندي علم قال: فامر به فحمله الي وسط السوق وضرب ماءة سوط ثم سجنه ثم اخرجه مرة ثانية وجلده في وسط السوق ماءة سوط، ثم انا اشك اذكر الثالثة او الرابعة ام لا قال فمات الرجل من الضرب في السجن ثم وجد ابنته في بعض
 الشعاب عند قوم من اهل الفساد، واما القول الثاني فكما نا حمام نا ابن مفرج نا ابن الاعرابي نا الدبري نا عبد الرزاق عن ابن جريج اخبرني هشام بن عروة عن ابيه ان يحيي بن عبد الرحمن ابن حاطب حدثه قال توفي عبد الرحمن بن حاطب واعتق من صلي من رقيقه وصام وكانت له نوبية قد صلت وصامت وهي اعجمية لم تفقه فلم يرعه الا حملها وكانت ثيبا فذهب الي عمر فزعا فحدثه فقال انت الرجل لا تاتي بخير فارسل اليها عمر فسالها فقال: احبلت؟ قالت نعم من مرعوش بدرهمين فصادف ذلك عنده عثمان.
 وعليا.
 وعبد الرحمن بن عوف فقال: اشيروا علي وكان عثمان جالسا فاضطجع فقال علي.
 وعبد الرحمن: قد وقع عليها الحد فقال: اشر علي يا عثمان قال: قد اشار عليك اخواك قال: اشر علي انت قال عثمان: اراها تستهل به كانها لا تعرفه فليس الحد الا علي من علمه فامر بها عمر فجلدت ماءة  ثم غربها ثم قال: صدقت والذي نفسي بيده ما الحد الا علي من علمه، وبه الي عبد الرزاق عن محمد بن راشد قال: سمعت مكحولا يحدث ان رجلا وجد في بيت رجل بعد العتمة ملففا في حصير فضربه عمر ماءة، وبه الي عبد الرزاق نا ابن جريج نا جعفر بن محمد عن ابيه عن علي انه كان اذا وجد الرجل مع المراة في لحاف واحد جلدهما ماءة كل انسان منهما، وبه الي عبد الرزاق عن سفيان بن عيينة عن الاعمش عن القاسم بن عبد الرحمن بن عبد الله بن مسعود عن ابيه قال اتي ابن مسعود برجل وجد مع امراة في لحاف فضربهما لكل واحد منهما اربعين سوطا فذهب اهل المراة واهل الرجل فشكوا ذلك الي عمر بن الخطاب فقال عمر لابن مسعود ما يقول هءلاء؟ قال: قد فعلت ذلك، واما القول الثالث: فروينا عن سعيد بن المسيب، ورويناه ايضا عن ابن شهاب قال: ان عمر بن الخطاب ضرب رجلا دون الماءة وجد مع امراة في العتمة، واما من قال ثلاثون سوطا فلما رويناه عن سفيان بن عيينة عن جامع عن شقيق قال كان لرجل علي ام سلمة ام المءمنين حق فكتب اليها يخرج عليها فامر عمر بان يجلد ثلاثين جلدة، واما من قال عشرون سوطا فكما روينا
 عن وكيع.
 وعبد الرحمن ثم اتفقا كلاهما عن سفيان الثوري عن حميد الاعرج عن يحيي بن عبد الله بن صيفي ان عمر بن الخطاب كتب الي ابي موسي لا يجلد في تعزير اكثر من عشرين سوطا * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر في ذلك فنظرنا في قول من اسقط التعزير جملة ومن راي انه يزاد فيه علي عشر جلدات اذ لم يبق غير هذين القولين اذ ساءر الاقوال قد سقط التعلق بها جملة واحدة فوجدنا المنع منه جملة كما جاء عن عمر بن الخطاب.
 وعن عطاء هو كان الاصل لقول رسول الله صلي الله عليه وسلم: " ان دماءكم واموالكم واعراضكم وابشاركم عليكم حرام " لكن لما قال رسول الله صلي الله عليه وسلم: " من راي منكم منكرا فليغيره بيده ان استطاع فان لم يستطع فبلسانه " كان ذلك مطلقا لتغيير المنكر باليد فكان هذا امرا مجملا لا ندري كيفية ذلك التغيير باليد كيف هو لان التغيير باليد يكون بالسيف.
 وبالحجر.
 ويكون بالرمح.
 ويكون بالضرب، وهذا لا يقدم عليه الا ببيان من الله تعالي علي لسان رسوله عليه السلام، ثم نظرنا في قول مالك فوجدناه ابعد الاقوال من الصواب لانه لم يتعلق بقران.
 ولا بسنة.
 ولا بدليل اجماع.
 ولا بقول احد من الصحابة رضي الله عنهم.
 ولا براي سديد فنظرنا في ذلك فوجدنا ما ناه عبد الرحمن بن عبد الله بن خالد نا ابراهيم بن احمد نا الفربري نا البخاري نا عبد الله بن يوسف نا الليث  هو ابن سعد  ني يزيد بن ابي حبيب عن بكير بن عبد الله عن سليمان بن يسار عن عبد الرحمن بن جابر بن عبد الله بن ابي بردة قال: كان رسول الله صلي الله عليه وسلم يقول: " لا يجلد فوق عشر جلدات الا في حد من حدود الله تعالي " فكان هذا بيانا جليا لا يحل لاحد ان يتعداه، وقد روينا عن سفيان الثوري عن ابي حصين عن ابي عامر قال: اتي علي ابن ابي طالب برجل وجد تحت فراش امراة فقال اذهبوا به فقلبوه ظهرا لبطن في
 مكان منتن فانه كان في مكان شر منه * ومن طريق محمد بن المثني نا الضحاك بن مخلد عن سفيان الثوري عن ابي اسحاق الشيباني عن رجل ان رجلا جاء الي علي بن ابي طالب بمستعد عليه فقال: هذا احتلم علي امي البارحة فقال له علي اذهب فاقمه في الشمس واضرب ظله * قال ابو محمد رحمه الله: ومن اتي منكرات جمة فللحاكم ان يضربه لكل منكر منها عشر جلدات فاقل بالغا ذلك ما بلغ لان الامر في التعزير جاء مجملا فيمن اتي منكرا ان يغير باليد وليس هذا بمنزلة الزاني الذي قد صح الاجماع والنص ان الايلاج والتكرار سواء ولا كالشرب الذي قد صح الاجماع والنص علي ان الجرعة والسكر سواء ولا كالسرقة التي قد صح الاجماع بان سارق ربع دينار وسارق اكثر من ذلك سواء ولا كالقذف الذي قد صح النص بان قاذف واحد او اكثر من واحد سواء، وبالله تعالي التوفيق *  مسالة  هل يقال ذوو الهيءات عثراتهم؟ وكيف يتجاوز عن مسء الانصار رضي الله عنهم؟ * قال ابو محمد رحمه الله: نا عبد الله بن ربيع نا عمر بن عبد الملك الخولاني نا محمد بن بكير البصري.
 نا ابو داود السجستاني.
 وجعفر بن مسافر التنيسي نا ابن ابي فديك عن عبد الملك بن زيد  من ولد سعيد بن زيد بن عمرو بن نفيل  عن محمد ابن ابي بكر بن عمرو بن حزم عن عمرة عن عاءشة قالت: قال رسول الله صلي الله عليه وسلم: " اقيلوا ذوي الهيءات عثراتهم الا الحدود " * حدثنا حمام نا عباس بن اصبغ نا محمد ابن عبد الملك بن ايمن نا ابو عبد الله نا سعيد بن منصور نا ابو بكر بن نافع مولي العمريين قال: سمعت ابا بكر بن محمد بن عمرو بن حزم قالت عمرة: قالت عاءشة: قال رسول الله صلي الله عليه وسلم: اقيلوا ذوي الهيءات عثراتهم " * حدثنا احمد بن قاسم نا محمد بن قاسم ابن اصبغ نا ابي نا جدي نا مضر بن محمد نا مخلد بن مالك نا عبد الرحمن بن محمد بن ابي
 الرجال عن ابن ابي ذءب اخبرني عبد العزيز بن عبد الله بن عمر بن الخطاب انه جرح  مولي له فاستعدي عليه ابن حزم  وهو والي المدينة  فقال ابن حزم: سمعت جدتي عمرة عن عاءشة ان النبي صلي الله عليه وسلم قال: " اقيلوا ذوي الهيءات عثراتهم  او زلانهم " وانت ذو هيءة وقد اقلتك  * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا عمرو بن علي نا عبد الرحمن بن مهدي نا عبد الملك بن زيد المديني عن ابي بكر بن محمد ابن عمرو بن حزم عن ابيه عن عمرة عن عاءشة ان النبي صلي الله عليه وسلم قال: " اقيلوا ذوي الهيءات عثراتهم " * نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن حاتم انا سويد  هو ابن نصر  انا عبد الله  هو ابن المبارك  عن عبد العزيز بن عبد الله بن عمر عن محمد بن ابي بكر بن محمد بن عمرو بن حزم عن ابيه عن عمرة ان رسول الله صلي الله عليه وسلم قال: " تجاوزوا عن زلة ذي الهيءة " * قال ابو محمد رحمه الله: حديث عبد الملك كان يكون جيدا لو لا ان محمد ابن ابي بكر مقدر انه لم يسمعه من عمرة لان هذا الحديث انما هو عن ابيه ابي بكر عن عمرة واما ابو بكر بن نافع  فهو ضعيف ليس هو بشء  وليس هو ابا بكر ابن نافع مولي ابن عمر ذلك عال ثقة وهذا متاخر واحسنها كلها حديث عبد الرحمن بن مهدي فهو جيد والحجة به قاءمة * ومن طريق مسلم نا محمد بن المثني نا محمد بن جعفر انا شعبة سمعت قتادة يحدث عن انس بن مالك ان رسول الله صلي الله عليه وسلم قال: " الانصار كرشي وعيبتي والناس سيكثرون ويقلون فاقبلوا من محسنهم وتجاوزوا عن مسيءهم " * حدثنا عبد الرحمن بن عبد الله بن خالد نا ابراهيم بن احمد نا الفربري نا البخاري نا محمد بن يحيي ابو علي الصاءغ نا شاذان  اخو عبدان  نا ابي نا شعبة بن الحجاج عن هشام بن زيد قال سمعت انس بن مالك يقول: " مر ابو بكر.
 والعباس بمجلس من مجالس الانصار وهم يبكون فقال ما يبكيكم؟ فقالوا ذكرنا مجلس النبي صلي الله عليه وسلم منا فدخل الي النبي صلي الله عليه وسلم فاخبره بذلك قال فخرج النبي
 صلي الله عليه وسلم وقد عصب راسه بحاشية برد فصعد المنبر  ولم يصعده بعد ذلك اليوم  فحمد الله واثني عليه ثم قال اوصيكم بالانصار فانهم كرشي وعيبتي وقد قضوا الذي عليهم وبقي الذي لهم فاقبلوا من محسنهم وتجاوزوا عن مسيءهم "، وبه الي البخاري نا احمد بن يعقوب نا ابن المغلس قال: سمعت عكرمة يقول: سمعت ابن عباس يقول: " خرج رسول الله صلي الله عليه وسلم وعليه ملحفة متعصبا بها علي منكبيه وعليه عصابة دسماء حتي جلس علي المنبر فحمد الله واثني عليه ثم قال: اما بعد ايها الناس فان الناس يكثرون وتقل الانصار حتي يكونوا كالملح في الطعام " (فان قال قاءل): فكيف تجمع هذه الاثار مع قوله صلي الله عليه وسلم: " من راي منكم منكرا فليغيره بيده ان استطاع " ومع ما حدثكموه  عبد الرحمن بن عبد الله بن خالد نا ابراهيم بن احمد نا الفربري نا البخاري نا عبدان  هو ابن عثمان  انا عبد الله بن المبارك انا يونس  هو ابن يزيد  عن الزهري اخبرني عروة عن عاءشة قالت: ما انتقم رسول الله صلي الله عليه وسلم لنفسه في شء يءتي اليه حتي ينتهك من حرمات الله فينتقم لله عزوجل * قال ابو محمد رحمه الله: (فنقول): وبالله تعالي التوفيق: ان جميعها كلها حق ممكن ظاهر وذلك ما كان من اساءة لا تبلغ منكرا وجب ان يتجاوز فيها عن الانصاري في التعزير ولم يخفف عن غيرهم وما كان من حد خفيف ايضا عن الانصار ما لا يخفف عن غيرهم مثل ان يجلد الانصاري في الخمر بطرف الثوب وغيره باليد او بالجريد والنعال ويقال ذو الهيءة  وهو الذي له هيءة علم وشرف  عثرة في جفا ونحو ذلك ما لم يكن حدا او منكرا فلا بد من اقامة الحدود والتعزير وبالله تعالي التوفيق *  مسالة هل يقتل القرشي فيما يوجب القتل من رجم المحصن اذا زني.
 والقود.
 والحرابة.
 والردة، واذا شرب الخمر بعد ان حد فيها ثلاث مرات ام لا؟ * قال ابو محمد رحمه الله: نا احمد بن محمد بن الجسور نا ابو بكر احمد بن الفضل
 الدينوري نا محمد بن جرير الطبري نا عبد الله بن سعد بن ابراهيم بن عبد الرحمن بن عوف الزهري ني عمي يعقوب بن ابراهيم ني شعبة بن الحجاج عن عبد الله بن ابي السفر عن عامر الشعبي عن عبد الله بن مطيع بن الاسود عن ابيه مطيع  اخي بني عدي بن كعب وكان اسمه العاصي فسماه رسول الله صلي الله عليه وسلم مطيعا  قال سمعت رسول الله صلي الله عليه وسلم بمكة يقول: " لا تغزي مكة بعد هذا العام ابدا ولا يقتل رجل من قريش بعد هذا العام صبرا " * حدثنا احمد بن محمد بن الجسور نا احمد بن الفضل بن بهرام نا محمد بن جرير ني عبد الله بن محمد الزهري نا سفيان  هو ابن عيينة  عن زكريا  هو ابن ابي زاءدة  عن الشعبي قال: قال الحرث بن مالك بن البرصاء قال رسول الله صلي الله عليه وسلم: " لا تغزي مكة بعد اليوم ابدا " * حدثنا احمد بن محمد بن الجسور نا احمد بن الفضل نا محمد بن جرير ني نصر بن عبد الرحمن الازدي نا محمد بن عبيد عن زكريا  هو ابن ابي زاءدة  عن عامر الشعبي عن الحرث بن مالك بن برصاء قال: سمعت رسول الله صلي الله عليه وسلم يوم فتح مكة وهو يقول: " لا تغزي بعدها الي يوم القيامة " * قال ابو محمد رحمه الله: الحارث هذا  هو الحارث بن مالك بن قيس بن عود بن جابر بن عبد مناف بن كنانة بن سجع بن عامر بن ليث بن بكر بن عبد مناف ابن كنانة  لا يعرف للشعبي سماع من عبد الله بن مطيع وعبد الله بن مطيع هذا قتل مع  عبد الله بن الزبير في الحصار الاول ولا يعرف له ايضا سماع من الحرث بن مالك بن البرصاء فحصل الخبران منقطعين ولا حجة في منقطع، ثم لو صح لكان المراد بذلك انه عليه السلام لا يغزوها ابدا ولا يقتل هو قرشيا بعد ذلك اليوم صبرا، فهذا من اعلام نبوته صلي الله عليه وسلم، وبرهان صحة هذا التاويل هو قول الله تعالي: (ولا تقتلوهم عند المسجد الحرام حتي يقاتلوكم فيه فان قاتلوكم فاقتلوهم) فاخبر تعالي اننا سنقاتل فيه ونقتل ونقتل * روينا من طريق مسلم نا قتيبة بن سعيد.
 وابو بكر بن ابي شيبة.
 واسحق
  هو ابن ابراهيم  واللفظ لقتيبة قال اسحق اخبرنا، وقال الاخران نا جرير عن عبد العزيز بن رفيع عن عبيد الله بن القبطية قال.
 دخل الحرث بن ابي ربيعة: وعبد الله ابن صفوان.
 وانا معهما علي ام سلمة ام المءمنين فقالت.
 قال رسول الله صلي الله عليه وسلم.
 " يعوذ عاءذ بالبيت فيبعث اليه بعث فاذا كان ببيداء من الارض خسف بهم فقلت يا رسول الله فكيف بمن كان كارها؟ قال.
 يخسف به معهم ولكنه يبعث يوم القيامة علي نيته " * قال ابو محمد رحمه الله: اسقطنا من هذا الخبر كلاما لبعض رواته ليس من الحديث في شء وهو غلط وهو انه ذكر ان ذلك كان ايام ابن الزبير وهو خطا لان ام سلمة ام المءمنين رضي الله عنها ماتت ايام معاوية فانما الغرض من الحديث كلام رسول الله صلي الله عليه وسلم لا كلام من دونه فلا حجة فيه * ومن طريق مسلم نا عمرو بن محمد الناقد نا سفيان ابن عيينة عن امية بن صفوان سمع جده عبد الله بن صفوان يقول: اخبرتني حفصة انها سمعت النبي صلي الله عليه وسلم يقول: " ليءمن هذا البيت جيش يغزونه حتي اذا كانوا ببيداء من الارض يخسف بهم باوسطهم وينادي اولهم اخرهم ثم يخسف بهم فلا يبقي الا الشريد الذي يخبر عنهم " * ومن طريق مسلم ني محمد بن حاتم بن ميمون نا الوليد بن صالح نا عبيد الله ابن عمرو نا يزيد بن ابي انيسة عن عبد الملك العامري عن يوسف بن ماهك اخبرني عبد الله ابن صفوان عن ام المءمنين ان رسول الله صلي الله عليه وسلم قال: " سيعوذ بهذا البيت قوم ليس لهم منعة ولا عدد ولا عدة يبعث اليهم جيش حتي اذا كانوا ببيداء من الارض خسف بهم " قال يوسف: واهل الشام يومءذ يسيرون الي مكة قال عبد الله بن صفوان: اما والله ما هو بهذا الجيش * ومن طريق مسلم نا ابو بكر بن ابي شيبة نا يونس بن محمد نا القاسم بن الفضل الحداءي عن محمد بن زياد عن عبد الله بن الزبير قال: ان عاءشة قالت: " عبث رسول الله صلي الله عليه وسلم في منامه فقلنا يا رسول الله صنعت شيءا في منامك لم تكن تفعله قال: العجب ان ناسا من امتي يءمون هذا البيت لرجل من قريش قد لجا بالبيت حتي اذا كانوا بالبيداء خسف بهم فقلنا: يا رسول الله فان الطريق قد تجمع الناس قال: نعم فيه  المستبصر.
 والمجبر.
 وابن السبيل يهلكون مهلكا واحدا ويصدرون مصادر شتي حتي يبعثهم الله علي نياتهم " * قال ابو محمد رحمه الله: فهذا خبر صحيح في غاية الصحة عن ثلاثة من امهات المءمنين رضي الله عنهن وعن ابن الزبير  وهو صاحب  قد انذر النبي صلي الله عليه وسلم بان مكة تغزي بعده، واما قتل القرشي صبرا فلما روينا من طريق مسلم نا محمد بن المثني نا ابن ابي عدي عن عثمان بن غياث عن ابي عثمان النهدي عن ابي موسي الاشعري قال.
 " بينما رسول الله صلي الله عليه وسلم في حاءط من حواءط المدينة استفتح رجل فذكر الحديث، وفيه ثم استفتح رجل اخر فقال: افتح وبشره بالجنة علي بلوي تكون قال: فذهبت فاذا عثمان بن عفان قال: ففتحت له وبشرته بالجنة فقلت الذي قال فقال اللهم صبرا والله المستعان " * حدثنا عبد الله بن ربيع نا عمر بن عبد الملك الخولاني نا محمد بن بكر نا ابو داود السجستاني نا مسدد نا يزيد بن زريع.
 ويحيي بن سعيد القطان واللفظ له قالا جميعا: نا سعيد بن ابي عروبة عن قتادة عن انس بن مالك حدثهم " ان النبي صلي الله عليه وسلم صعد احدا فتبعه ابو بكر.
 وعمر.
 وعثمان فرجف بهم فضربه نبي الله صلي الله عليه وسلم برجله اثبت احد فانما عليك نبي وصديق وشهيدان " * قال ابو محمد رحمه الله: وانذر رسول الله صلي الله عليه وسلم بان الكعبة يهدمها ذو السويقتين من الحبشة وهذا لا يكون الا بعد غزوها بلا شك وقد صرح رسول الله صلي الله عليه وسلم بانها تغزي بعده وصرح بان عثمان تصيبه بلوي كما تري فهذا انذر بانه سيقتل وهو قرشي وصح يقينا ان حديث الشعبي عن ابن مطيع وعن الحرث بن برصاء لو صح وهو لا يصح لكان معناه انه عليه السلام لا يغزوها بعد يومه ذلك ابدا الي يوم القيامة وانه عليه السلام لا يقتل قرشيا صبرا بعد ذلك اليوم الي يوم القيامة وهكذا كان فاذ هذا معني ذلك الحديث لو صح بلا شك فقد ثبت ان القرشي كغير القرشي في ان يقتل اذا وجب
 عليه القتل صبرا كما يقتل غيره وان الحدود تقام عليه كما تقام علي غير قرشي ولا فرق مع ان هذا امر مجمع عليه بيقين لا شك فيه وبالله تعالي التوفيق *  مسالة  من سب رسول الله صلي الله عليه وسلم او الله تعالي.
 او نبيا من الانبياء او ملكا من الملاءكة.
 او انسانا من الصالحين هل يكون بذلك مرتدا ان كان مسلما ام لا؟ وهل يكون بذلك ناقضا للعهد ان كان ذميا ام لا؟ * قال ابو محمد: اختلف الناس فيمن سب النبي صلي الله عليه وسلم.
 او نبيا من الانبياء ممن يقول انه مسلم، فقالت طاءفة: ليس ذلك كفرا، وقالت طاءفة: هو كفر  وتوقف اخرون في ذلك.
 فاما التوقف فهو قول اصحابنا: واما من قال انه ليس كفرا فاننا روينا باسناد غاب عنا مكانه من روايتنا الا ان علي بن ابي طالب قال: لا اوتي برجل قذف داود عليه السلام بالزنا الا جلدته حدين، واما من قال: انه كفر فاباح دمه بذلك فان عبد الله بن ربيع قال: نا محمد بن معاوية نا احمد بن شعيب انا محمد بن العلاء نا ابو بكر نا ابو معاوية عن الاعمش عن عمرو بن مرة عن سالم بن ابي الجعد عن ابي برزة قال: تغيظ ابو بكر علي رجل فقلت من هو يا خليفة رسول الله؟ قال: لم؟ قلت له لاضرب عنقه ان امرتني بذلك قال: او كنت فاعلا قال: قلت نعم قال فذكرت كلمة معناها لاذهب عظم كلمتي التي قلت غضبه ثم قال: ما كانت لاحد بعد رسول الله صلي الله عليه وسلم * حدثنا حمام نا عباس بن اصبغ نا محمد بن عبد الملك بن ايمن نا محمد ابن اسماعيل الترمذي نا الحميدي نا يعلي بن عبيد نا الاعمش عن عمرو بن مرة عن ابي البختري عن ابي برزة قال: مررت علي ابي بكر الصديق وهو متغيظ علي رجل من اصحابه فقلت: يا خليفة رسول الله من هذا الذي تغيظ عليه؟ قال: ولم تسال عنه؟ قلت لاضرب عنقه قال: فو الله لاذهب غضبه ما قلت ثم قال: ما كان لاحد بعد رسول الله صلي الله عليه وسلم * نا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا محمد بن المثني عن ابي داود الطيالسي
 نا شعبة عن عمرو بن مرة قال: سمعت ابا نصر  هو حميد بن هلال  يحدث عن ابي برزة قال: اتيت علي ابي بكر الصديق وقد اغلظ لرجل فرد عليه فقلت: الا اضرب عنقه؟ فانتهرني وقال: انها ليست لاحد بعد رسول الله صلي الله عليه وسلم * حدثنا عبد الله بن ربيع نا محمد بن معاوية نا احمد بن شعيب انا ابو داود نا عفان نا يزيد بن زريع نا يونس بن عبيد عن حميد بن هلال عن عبد الله بن مطرف بن الشخير عن ابي برزة الاسلمي قال: كنا عند ابي بكر فغضب علي رجل من المسلمين فاشتد غضبه جدا فلما رايت ذلك قلت: يا خليفة رسول الله اضرب عنقه؟ فلما ذكرت القتل اضرب عن ذلك الحديث اجمع الي غير ذلك من النحو قال: فلما تفرقنا ارسل الي فقال: يا ابا برزة ما قلت؟ قال: ونسيت الذي قلت: فقلت له: ذكرنيه فقال: اما تذكر ما قلت؟ قلت: لا والله قال: رايت حين رايتني غضبت علي الرجل فقلت اضرب عنقه يا خليفة رسول الله اما تذكر ذلك او كنت فاعلا ذلك؟ قلت نعم والله ولءن امرتني فعلت قال: والله ما هي لاحد بعد رسول الله صلي الله عليه وسلم * قال ابو محمد: (فان قيل): هذا خبر رواه عن عمرو بن مرة.
 مرة عن سالم ابن ابي الجعد.
 ومرة عن ابي البختري وكلاهما عن ابي برزة (قلنا): فكان ماذا؟ كلهم  ثقة سمعه من كل واحد فحدث به كذلك.
 وعمرو بن مرة من الجلالة والثقة بحيث لا يغمزه بمثل هذا الا جاهل (فان قيل): ان معني قول ابي بكر هذا انما هو ما كان لاحد ان يطاع في سفك دم بعد رسول الله صلي الله عليه وسلم (قلنا): نعم واراد ايضا معني اخر كما روينا مبينا بلا اشكال * حدثنا محمد بن سعيد بن نبات نا احمد بن عون الله نا قاسم بن اصبغ نا محمد بن عبد السلام الخشني نا محمد بن بشار انا معاذ بن معاذ العنبري نا شعبة عن ثوبة العنبري قال: سمعت ابا السوار القاضي عبد الله بن قدامة يحدث عن ابي برزة قال: اغلظ رجل لابي بكر الصديق قلت: الا اقتله؟ فقال ابو بكر: ليس هذا
 الا لمن شتم النبي صلي الله عليه وسلم فبين ابو بكر الصديق رضي الله عنه انه لا يقتل من شتمه لكن يقتل من شتم النبي صلي الله عليه وسلم وقد علمنا ان دم المسلمين حرام الا بما اباحه الله تعالي به ولم يبحه الله تعالي قط الا في الكفر بعد الايمان.
 او زنا المحصن.
 او قود بنفس مءمنة.
 او في المحاربة.
 وقطع الطريق.
 او في المدافعة عن الظلمة.
 او في الممانعة من حق.
 او فيمن حد في الخمر ثلاث مرات ثم شربها الرابعة فقط، وقد علمنا ان من سب النبي صلي الله عليه وسلم فبيقين ندري انه لم يزن.
 ولا شرب خمرا.
 ولا قصد ظلم مسلم.
 ولا قطع طريقا فلم يبق الا انه عند ابي بكر كافر * حدثنا عبد الله بن ربيع نا ابن مفرج نا قاسم بن اصبغ نا ابن وضاح نا سحنون نا ابن وهب عن خالد عن حميد عن عمر بن عبد الله عن عبد الحميد بن عبد الرحمن ابن زيد بن الخطاب انه كان علي الكوفة لعمر بن عبد العزيز فكتب الي عمر بن عبد العزيز اني وجدت رجلا بالكوفة يسبك وقامت عليه البينة فهممت بقتله.
 او قطع يديه.
 او قطع لسانه.
 او جلده ثم بدا لي ان اراجعك فيه فكتب اليه عمر بن عبد العزيز سلام عليك اما بعد والذي نفسي بيده لو قتلته لقتلتك به ولو قطعته لقطعتك به ولو جلدته لاقدته منك فاذا جاءك كتابي هذا فاخرج به الي الكناسة فسبه كالذي سبني او اعف عنه فان ذلك احب الي فانه لا يحل قتل امرء مسلم يسب احد من الناس الا رجلا سب رسول الله صلي الله عليه وسلم، وذهب ابو حنيفة.
 ومالك.
 والشافعي.
 واحمد بن حنبل.
 واسحق بن راهويه.
 وساءر اصحاب الحديث.
 واصحابهم الا انه بذلك كافر مرتد * قال ابو محمد رحمه الله: فلما اختلفوا كما ذكرنا وجب ان ننظر فيما احتجت به كل طاءفة لقولها لنعلم الحق من ذلك فنتبعه بعون الله تعالي وتاييده فوجدنا من قال لا يكون بذلك كافرا يحتجون بما روينا من طريق مسلم نا زهير بن حرب نا جرير بن عبد الحميد عن منصور بن المعتمر عن ابي واءل عن عبد الله بن مسعود لما كان يوم خيبر " اثر رسول الله صلي الله عليه وسلم ناسا في القسمة فقال رجل: والله ان هذه لقسمة ما اريد بها وجه الله تعالي فاتيت  رسول الله صلي الله عليه وسلم فاخبرته بما قال فتغير وجه رسول الله صلي الله عليه وسلم حتي كان كالصرف، ثم قال: من يعدل اذا لم يعدل الله ورسوله؟ يرحم الله موسي لقد اوذي باكثر من هذا فصبر " وبما روينا من طريق البخاري نا عمرو بن حفص بن غياث نا ابي عن الاعمش نا سفيان قال: قال عبد الله بن مسعود كاني انظر الي النبي صلي الله عليه وسلم يحكي نبيا من الانبياء ضربه قومه فادموه وهو يمسح الدم عن وجهه ويقول رب اغفر لقومي فانهم لا يعلمون * قال ابو محمد: وكل هذا لا حجة لهم فيه، اما القاءل في قسمة رسول الله صلي الله عليه وسلم هذه قسمة ما عدل فيها ولا اريد بها وجه الله تعالي فقد قلنا ان هذا كان يوم خيبر وان هذا كان قبل ان يامر الله تعالي بقتل المرتدين وليس في هذا الخبر ان قاءل هذا القول ليس كافرا بقوله ذلك فاذ ليس ذلك في الخبر فلا متعلق لهم به، واما حديث النبي الذي ضربه قومه فادموه فكذلك ايضا ومعني دعاء ذلك النبي عليه السلام لهم بالمغفرة انما هو بان يءمنوا فيغفر الله تعالي لهم ويبين انهم كانوا كفارا به قوله فانهم لا يعلمون فصح انهم كانوا لا يعلمون بنبوته فصح ان كلا الخبرين لا حجة لهم فيه، واما سب الله تعالي فما علي ظهر الارض مسلم يخالف في انه كفر مجرد الا ان الجهمية.
 والاشعرية وهما طاءفتان لا يعتد بهما يصرحون بان سب الله تعالي واعلان الكفر ليس كفرا قال بعضهم: ولكنه دليل علي انه يعتقد الكفر لا انه كافر بيقين بسبه الله تعالي واصلهم في هذا اصل سوء خارج عن اجماع اهل الاسلام وهو انهم يقولون الايمان هو التصديق بالقلب فقط وان اعلن بالكفر.
 وعبادة الاوثان بغير تقية ولا حكاية لكن مختارا في ذلك الاسلام * قال ابو محمد رحمه الله: وهذا كفر مجرد لانه خلاف لاجماع الامة ولحكم الله تعالي ورسوله صلي الله عليه وسلم وجميع الصحابة ومن بعدهم لانه لا يختلف احد لا كافر ولا مءمن في ان هذا القران هو الذي جاء به محمد صلي الله عليه وسلم وذكر انه وحي من الله تعالي وان كان قوم كفار من الروافض ادعوا انه نقص منه وحرف فلم يختلفوا ان جملته كما ذكرنا ولم يختلفوا في ان فيه التسمية بالكفر والحكم بالكفر قطعا علي من نطق باقوال معروفة كقوله تعالي:
 (لقد كفر الذين قالوا ان الله هو المسيح ابن مريم) وقوله تعالي: (ولقد قالوا كلمة الكفر وكفروا بعد اسلامهم) فصح ان الكفر يكون كلاما وقد حكم الله تعالي بالكفر علي ابليس وهو عالم بان الله خلقه من نار وخلق ادم من طين وامره بالسجود لادم وكرمه عليه وسال الله تعالي النظرة الي يوم يبعثون ثم يقال لهم اذ ليس شتم الله تعالي كفرا عندكم فمن اين قلتم انه دليل علي الكفر؟ (فان قالوا) لانه محكوم علي قاءله بحكم الكفر (قيل لهم): نعم محكوم عليه بنفس قوله لا بمغيب ضميره الذي لا يعلمه الا الله تعالي  فانما حكم له بالكفر بقوله فقط فقوله هو الكفر ومن قطع علي انه في ضميره وقد اخبر الله تعالي عن قوم يقولون بافواههم ما ليس في قلوبهم فكانوا بذلك كفارا كاليهود الذين عرفوا صحة نبوة رسول الله صلي الله عليه وسلم كما يعرفون ابناءهم وهم مع ذلك كفار بالله تعالي قطعا بيقين اذ اعلنوا كلمة الكفر * قال ابو محمد رحمه الله: فاذ قد سقط هذا القول فالواجب ان ننظر فيما احتجت به الطاءفة القاءلة ان من سب رسول الله صلي الله عليه وسلم.
 او نبيا من الانبياء.
 او ملكا من الملاءكة عليهم السلام فهو بذلك القول كافر سواء اعتقده بقلبه او اعتقد الايمان بقلبه فوجدناهم يذكرون قول الله تعالي: (قل ابالله واياته ورسوله كنتم تستهزءون لا تعتذروا قد كفرتم بعد ايمانكم) وقال الله تعالي: (يا ايها الذين امنوا لا ترفعوا اصواتكم فوق صوت النبي) الاية، وقوله تعالي: (فلا وربك لا يءمنون حتي يحكموك فيما شجر بينهم) قال فقضي الله عزوجل وقسم وحكم انه لا يءمن احد حتي يحكم رسول الله صلي الله عليه وسلم فيما شجر ثم لا يجد في نفسه حرجا من شء مما قضي به ويسلم تسليما، قالوا وبضرورة الحس والمشاهدة ندري ان من سب الله تعالي او النبي صلي الله عليه وسلم او ملكا من الملاءكة او نبيا من الانبياء علي جميعهم السلام او شيءا من الشريعة او استخف بشء من ذلك كله فلم يحكم النبي صلي الله عليه وسلم لما اتي به من تعظيم
 الله تعالي واكرام الملاءكة والنبيين وتعظيم الشريعة التي هي شعاءر الله تعالي فصح انه لم يءمن فقد كفر اذ ليس الا مءمن او كافر قالوا: وقد نص الله تعالي باحباط عمل من رفع صوته علي صوت النبي صلي الله عليه وسلم واحباط العمل لا يكون الا بالكفر فقط ورفع الصوت علي صوت النبي صلي الله عليه وسلم يدخل فيه الاستخفاف به عليه السلام والسب له والمعارضة من حاضر وغاءب قالوا: وكان قوله تعالي في المستهزءين بالله وباياته ورسوله انهم كفروا بذلك بعد ايمانهم فارتفع الاشكال وصح يقينا ان كل من استهزا بشء من ايات الله وبرسول من رسله فانه كافر بذلك مرتد، وقد علمنا ان الملاءكة كلهم رسل الله تعالي قال الله تعالي: (جاعل الملاءكة رسلا) وكذلك علمنا بضرورة المشاهدة ان كل ساب وشاتم فمستخف بالمشتوم مستهزء به فالاستخفاف والاستهزاء شء واحد * قال ابو محمد رحمه الله: ووجدنا الله تعالي قد جعل ابليس باستخفافه بادم عليه السلام كافرا لانه اذ قال: (انا خير منه) فحينءذ امره تعالي بالخروج من الجنة ودحره وسماه كافرا بقوله (وكان من الكافرين)، وحدثنا حمام نا عباس بن اصبغ نا محمد  ابن عبد الملك بن ايمن نا ابو محمد حبيب البخاري  هو صاحب ابي ثور ثقة مشهور  نا محمد بن سهل سمعت علي بن المديني يقول: " دخلت علي امير المءمنين فقال لي اتعرف حديثا مسندا فيمن سب النبي صلي الله عليه وسلم فيقتل؟ قلت: نعم فذكرت له حديث عبد الرزاق عن معمر عن سماك بن الفضل عن عروة بن محمد عن رجل من بلقين قال: " كان رجل يشتم النبي صلي الله عليه وسلم فقال النبي صلي الله عليه وسلم: من يكفيني عدوا لي؟ فقال خالد بن الوليد: انا فبعثه النبي صلي الله عليه وسلم اليه فقتله فقال له امير المءمنين ليس هذا مسندا هو عن رجل فقلت: يا امير المءمنين بهذا يعرف هذا الرجل وهو اسمه وقد اتي النبي صلي الله عليه وسلم فبايعه وهو مشهور معروف
 قال فامر لي بالف دينار " * قال ابو محمد رحمه الله: هذا حديث مسند صحيح وقد رواه علي بن المديني عن عبد الرزاق كما ذكره، وهذا رجل من الصحابة معروف اسمه الذي سماه به اهله رجل من بلقين فصح بهذا كفر من سب النبي صلي الله عليه وسلم وانه عدو لله تعالي وهو عليه السلام لا يعادي مسلما قال تعالي: (المءمنون بعضهم اولياء بعض) فصح بما ذكرنا ان كل ما سب الله تعالي او استهزا به او سب ملكا من الملاءكة او استهزا به او سب نبيا من الانبياء او استهزا به او سب اية من ايات الله تعالي او استهزا بها والشراءع كلها وللقران من ايات الله تعالي فهو بذلك كافر مرتد له حكم المرتد، وبهذا نقول وبالله تعالي التوفيق * قال ابو محمد رحمه الله: ويبين هذا ما رويناه من طريق مسلم ني زهير بن حرب نا عفان بن مسلم نا حماد بن سلمة انا ثابت البناني عن انس " ان رجلا كان يتهم بام ولد رسول الله صلي الله عليه وسلم فقال رسول الله صلي الله عليه وسلم لعلي: اذهب فاضرب عنقه فاتاه علي فاذا هو في ركي يتبرد فيها فقال له علي اخرج فناوله يده فاخرجه فاذا هو مجبوب  ليس له ذكر  فكف علي عنه ثم اتي النبي صلي الله عليه وسلم فقال: يا رسول الله انه لمجبوب ما له ذكر " * قال ابو محمد رحمه الله: هذا خبر صحيح وفيه من اذي النبي صلي الله عليه وسلم وجب قتله وان كان لو فعل ذلك برجل من المسلمين لم يجب بذلك قتله * (فان قال قاءل): كيف يامر رسول الله صلي الله عليه وسلم بقتله دون ان يتحقق عنده ذلك الامر لا بوحي ولا بعلم صحيح ولا ببينة.
 ولا باقرار؟ وكيف يامر عليه السلام بقتله في قصة بظن قد ظهر كذبه بعد ذلك وبطلانه؟ وكيف يامر  عليه السلام بقتل امرء قد اظهر الله تعالي براءته بعد ذلك بيقين لا شك فيه؟
 وكيف يامر عليه السلام بقتله ولا يامر بقتلها والامر بينه وبينها مشترك؟ * قال ابو محمد رحمه الله: وهذه سءالات لا يسالها الا كافرا او انسان جاهل يريد معرفة المخرج من كل هذه الاعتراضات المذكورة * قال ابو محمد رحمه الله: الوجه في هذه السءالات بين واضح لا خفاء به والحمد لله رب العالمين ومعاذ الله ان يامر رسول الله صلي الله عليه وسلم بقتل احد بظن بغير اقرار او بينة او علم مشاهدة او وحي او ان يامر بقتله دونها لكن رسول الله صلي الله عليه وسلم قد علم يقينا انه برء وان القول كذب فاراد عليه السلام ان يوقف علي ذلك مشاهدة فامر بقتله لو فعل ذلك الذي قيل عنه فكان هذا حكما صحيحا فيمن اذي رسول الله صلي الله عليه وسلم وقد علم عليه السلام ان القتل لا ينفذ عليه لما يظهر الله تعالي من براءته وكان عليه السلام في ذلك كما اخبر به عن اخيه سليمان عليه السلام، وقد روينا من طريق البخاري نا ابو اليمان  هو الحكم بن نافع  انا شعيب  هو ابن ابي حمزة  نا ابو الزناد قال ان عبد الرحمن الاعرج حدثه " انه سمع ابا هريرة يقول انه سمع رسول الله صلي الله عليه وسلم يقول: مثلي ومثل الناس  فذكر كلاما  وفيه انه عليه السلام قال: وكانت امراتان معهما ابناهما جاء الذءب فذهب بابن احداهما فقالت صاحبتها انما ذهب بابنك وقالت الاخري انما ذهب بابنك فتحاكما الي داود عليه السلام فقضي به للكبري فخرجتا علي سليمان عليه السلام فاخبرتاه فقال اءتوني بالسكين اشقه بينهما فقالت الصغري: لا تفعل يرحمك الله هو ابنها فقضي به للصغري  قال ابو هريرة: والله ان سمعت بالسكين الا يومءذ وما كنا نقول الا المدية " * قال ابو محمد رحمه الله: فبيقين ندري ان سليمان عليه السلام لم يرد قط شق الصبي بينهما وانما اراد امتحانهما بذلك وبالوحي فعل هذا بلا شك وكان حكم داود عليه السلام للكبري علي ظاهر الامر لانه كان في يدها وكذلك رسول الله صلي الله عليه وسلم ما اراد قط انفاذ قتل ذلك المجبوب لكن اراد امتحان علي في انفاذ امره واراد
 اظهار براءة المتهم وكذب التهمة عيانا وهكذا لم يرد الله تعالي انفاذ ذبح اسماعيل ابن ابراهيم صلي الله عليهما وسلم اذ امر اباه بذبحه لكن اراد الله تعالي اظهار تنفيذه لامره فهذا وجه الاخبار والحمد لله رب العالمين، فصح بهذا ان كل من اذي رسول الله صلي الله عليه وسلم فهو كافر مرتد يقتل ولا بد وبالله تعالي التوفيق * قال ابو محمد رحمه الله: نا احمد بن اسماعيل بن دليم الحضرمي نا محمد بن احمد  ابن الخلاص نا محمد بن القاسم بن شعبان نا الحسن بن علي الهاشمي ني محمد بن سليمان الباغندي نا هشام بن عمار قال: سمعت مالك بن انس يقول من سب ابا بكر.
 وعمر جلد ومن سب عاءشة قتل قيل له: لم يقتل في عاءشة؟ قال: لان الله تعالي يقول في عاءشة رضي الله عنها: (يعظكم الله ان تعودوا لمثله ابدا ان كنتم مءمنين) قال مالك: فمن رماها فقد خالف القران ومن خالف القران قتل * قال ابو محمد رحمه الله: قول مالك ههنا صحيح وهي ردة تامة وتكذيب لله تعالي في قطعه ببراءتها وكذلك القول في ساءر امهات المءمنين ولا فرق لان الله تعالي يقول: (الطيبات للطيبين والطيبون للطيبات اولءك مبرءون مما يقولون) فكلهن مبرءات من قول افك والحمد لله رب العالمين * قال ابو محمد رحمه الله: واما الذمي يسب النبي صلي الله عليه وسلم فان اصحابنا.
 ومالكا واصحابه قالوا: يقتل ولابد  وهو قول الليث بن سعد  وقال الشافعي: يجب ان يشترط عليهم ان لا يذكر احد منهم كتاب الله تعالي او رسوله صلي الله عليه وسلم بما لا ينبغي او زني بمسلمة او تزوجها فان فعل شيءا من ذلك او قطع الطريق علي مسلم او اعان اهل الحرب بدلالة علي المسلمين او اوي عينا لهم فقد نقض عهده وحل دمه وبرءت منه ذمة الله تعالي وذمة المسلمين فتاول عليه قوم انه ان لم يشترط هذا عليهم لم يستحل دمهم بذلك *
 قال علي رحمه الله: وهذا خطا ممن تاول ذلك عليه لانه لا يختلف عنه ولا عن غيره في الذمي يقطع الطريق علي المسلمين انه قد حل بذلك دمه تقدم اليهم بذلك وشرط لهم او لم يشترط ذلك لهم، وروي عن بعض المالكيين ان الذمي اذا سب النبي صلي الله عليه وسلم بغير ما به كفر يقتل فاستدل بعض الناس انه لا يقتل اذا سبه بتكذيب * وقال سفيان.
 وابو حنيفة.
 واصحابه: ان سب الذمي الله تعالي او رسوله صلي الله عليه وسلم باي شء سبه فانه لا يقتل لكن ينهي عن ذلك، وقال بعضهم: يعزر، وقد روي عن ابن عمر انه يقتل ولا بد.
 واحتج الحنيفيون لضلالهم وافكهم بما ناه عبد الرحمن ابن عبد الله بن خالد نا ابراهيم بن احمد نا الفربري نا البخاري نا محمد بن مقاتل انا عبد الله ابن المبارك انا شعبة عن هشام بن زيد قال: سمعت انس بن مالك يقول: " مر يهودي برسول الله صلي الله عليه وسلم فقال السام عليك فقال رسول الله صلي الله عليه وسلم: وعليك فقال عليه السلام اتدرون ما يقول؟ قال السام عليك قالوا يا رسول الله: الا نقتله؟ قال: لا اذا سلم عليكم اهل الكتاب فقولوا وعليكم " * ومن طريق البخاري نا ابو نعيم  عن ابن عيينة عن الزهري عن عروة عن عاءشة قالت: " استاذن رهط من اليهود علي النبي صلي الله عليه وسلم فقالوا: السام عليك فقلت بلي وعليكم السام واللعنة فقال: يا عاءشة ان الله رفيق يحب الرفق في الامر كله قلت او لم تسمع ما قالوا؟ قال: قلت وعليكم " * حدثنا عبد الله بن ربيع نا محمد بن اسحاق نا ابن الاعرابي نا ابو داود نا يحيي بن حبيب بن عدي نا خالد بن الحرث نا شعبة عن هشام بن زيد بن انس عن انس بن مالك " ان امراة يهودية اتت النبي صلي الله عليه وسلم بشاة مسمومة فاكل منها فجء بها الي رسول الله صلي الله عليه وسلم فسالها عن ذلك فقالت اردت لاقتلك قال: ما كان الله ليسلطك علي ذلك  او قال علي  فقالوا الا نقتلها؟ فقال: لا " *
 قال ابو محمد: فقالوا ان رسول الله صلي الله عليه وسلم قد سمع قول اليهود له السام عليك  وهذا قول لو قاله مسلم لكان كافرا بذلك وقد سمت اليهودية طعاما لتقتله ولو ان مسلما يفعل ذلك لكان بذلك كافرا فلم يقتلهم النبي صلي الله عليه وسلم ولا قتلها، وحديث لبيد بن الاعصم اذ سحره صلي الله عليه وسلم فلم يقتله * قال ابو محمد: ما نعلم لهم حجة غير هذا اصلا وكل هذا لا حجة لهم في شء منه علي ما نبين ان شاء الله تعالي، اما الاحاديث التي فيها قول اليهود للنبي صلي الله عليه وسلم السام عليك فليس بشء لان السام انما هو الموت كما روينا من طريق البخاري نا يحيي بن بكير نا الليث  هو ابن سعد  عن عقيل بن خالد عن ابن شهاب اخبره ابو سلمة بن عبد الرحمن بن عوف.
 وسعيد بن المسيب " ان ابا هريرة اخبرهما انه سمع رسول الله صلي الله عليه وسلم يقول في الحبة السوداء: شفاء من كل داء الا السام " قال ابن شهاب والسام الموت فمعني السام عليك الموت عليك وهذا كلام حق وان كان فيه جفاء لان الله تعالي يقول: (انك ميت وانهم ميتون) وقال تعالي: (كل نفس ذاءقة الموت) وانما يحصل بالجفاء علي النبي صلي الله عليه وسلم الكفر من المسلم وبكفره يحل دمه والذمي كافر ولم يقل انه لجفاءه علي النبي صلي الله عليه وسلم يكون كافرا بجفاءه بل كان كافرا وهو كافر ولا يحل دمه بكفره اذا صحت نيته لكن بمعني اخر غير الكفر وهكذا القول في لبيد بن الاعصم الزرقي اليهودي لرسول الله صلي الله عليه وسلم وفي سم اليهودية لطعامه صلي الله عليه وسلم ولا فرق انما يحصل من ذلك الكفر لمن فعله بالنبي صلي الله عليه وسلم من المسلمين والذميون كفار قبل ذلك ومعه وليس بنفس كفرهم حلت دماءهم في ذلك اذا تذمموا فالمسلم يقتل بكفره اذا احدث كفرا بعد اسلامه والذمي لا يقتل وان احدث في كل حين كفرا حادثا غير كفره بالامس اذا كان من نوع الكفر  الذي تذمم عليه فنظرنا في المعني الذي وجب به القتل علي الذمي اذا سب الله تعالي او رسوله صلي الله عليه وسلم او استخف بشء من دين الاسلام فوجدناه انما هو نقضه الذمة لانه انما
 تذمم وحقن دمه بالجزية علي الصغار قال الله تعالي: (قاتلوا الذين لا يءمنون بالله ولا باليوم الاخر ولا يحرمون ما حرم الله) الاية الي قوله (وهم صاغرون) وقال تعالي: (وان نكثوا ايمانهم من بعد عهدهم وطعنوا في دينكم فقاتلوا اءمة الكفر) فكان هاتان الايتان نصا جليا لا يحتمل تاويلا في بيان ما قلنا من ان اهل الكتاب يقاتلون ويقتلون حتي يعطوا الجزية وعلي انهم اذا عوهدوا وتم عهدهم وطعنوا في ديننا فقد نقضوا عهدهم ونكثوا ايمانهم وعاد حكم قتالهم كما كان، وبضرورة الحس والمشاهدة ندري انهم ان اعلنوا سب الله تعالي او سب رسول الله صلي الله عليه وسلم او شء من دين الاسلام او مسلم من عرض الناس فقد فارقوا الصغار بل قد اصغرونا واذلونا وطعنوا في ديننا فنكثوا بذلك عهدهم ونقضوا ذمتهم واذا نقضوا ذمتهم فقد حلت دماءهم.
 وسبيهم.
 واموالهم بلا شك * قال ابو محمد رحمه الله: وسم اليهودية للنبي صلي الله عليه وسلم كان يوم خيبر بلا شك وهو قبل نزول براءة بثلاثة اعوام، وكذلك نقول في قول اولءك اليهود السام عليك للنبي صلي الله عليه وسلم.
 وفي سحر لبيد بن الاعصم اياه وان هذا كله كان قبل ان يءمر بان لا يثبت عهد الذمي الا علي الصغار وان كل ذلك اذ كانت المهادنة جاءزة لهم لان المعني في حديث السام والسحر هو معني حديث سم الشاة سواء سواء، وحديث سم الشاة منسوخ بلا شك بما في سورة براءة من ان لا يقروا الا علي الصغار فحديث السام والسحر بلا شك منسوخان بل اليقين قد صح بذلك لان معناهما منسوخ ولا يحل العمل بالمنسوخ ولا يجوز البتة ان يكونا بعد نزول براءة لانه من المحال ان ينسخ الله تعالي شيءا بيقين ثم ينسخ الناسخ ويعيد حكم المنسوخ ولا يصحبه من البيان ما يرفع الشك ويرفع الظن ويبطل الاشكال هذا امر قد امناه ولله الحمد (فان قال قاءل): كيف تقولون هذا وانتم تقولون ان من سم اليوم طعاما لاحد من المسلمين فلا قتل عليه.
 وان من سحر مسلما فلا قتل عليه.
 وان اليهود يقولون لنا اليوم السام عليكم ولا قتل عليهم فما نراكم
 تحكمون الا بما ذكرتم انه منسوخ (فجوابنا) وبالله تعالي التوفيق * اننا لم نقل ان هذه الاحاديث نسخ منها الا ما يوجبه حكم خطابهم للنبي صلي الله عليه وسلم خاصة وحكم سم طعامه خاصة وحكم قصده بالسحر خاصة، فهذا هو الذي نسخ وحده فقط ولا مزيد لان الغرض تعظيم النبي صلي الله عليه وسلم وتوقيره وان لا يجعل دعاءه عليه السلام  كدعاء بعضنا بعضا باق ابدا علي المسلم والكافر، فقد علمنا ان قوله الذي قال لرسول الله صلي الله عليه وسلم: " اعدل يا محمد " كان ردة صحيحة لانه لم يوقره ولا عظمه كما امر ورفع صوته عليه فحبط عمله ولو ان مسلما او ذميا يقول لابي بكر الصديق رضي الله عنه فمن دونه اعدل يا ابا بكر لما كان فيه شء من النكرة ولا من الكراهة واليهود ان قالوا لنا السام عليكم او قالوا الموت عليكم لقلنا لهم صدقتم ولا خفاء في هذا، وكذلك لو خاصمونا في حق يدعونه فرفعوا اصواتهم علينا ما كان في ذلك نكرة وهو لرسول الله صلي الله عليه وسلم من اهل الاسلام وغيرهم كفر ونقض للذمة، وكذلك اذا سحرنا ساحر مسلم او كافر فلم يزد علي ان كاذنا كيدا لا يفلح معه قال الله تعالي: (انما صنعوا كيد ساحر ولا يفلح الساحر حيث اتي) وليس بالكيد تنتقض الذمة لانهم لم يفارقوا به الصغار وهو لرسول الله صلي الله عليه وسلم اذا قصد به كفرا ونقض للذمة لانه خلاف التعظيم المفترض له خاصة دون غيره وكذلك سم الطعام لنا ليس فيه الا افساد مال من اموالنا ان كان لنا او كيد من فاعله ان كان الطعام له وليس بافساد المال والكيد تنتقض الذمة ولا يكفر بذلك احد الا من عامل بذلك لرسول الله صلي الله عليه وسلم خاصة فهو كفر ونقض للذمة لانه خلاف التعظيم المفترض له علينا وعلي جميع اهل الارض جنها وانسها وكذلك لو ان مسلما او ذميا لم يسلم لحكم حكم به ابو بكر رضي الله عنه فمن دونه باجتهاده فيما لا نص فيه ولا اجماع ولا رضي بذلك القول لم يكن عليه في ذلك حرج ولا اثم ولو انهما لم يسلما لحكم حكم به رسول الله صلي الله عليه وسلم لكان ذلك كفرا من المسلمين بنص
 صوته عليه فحبط عمله ولو ان مسلما او ذميا يقول لابي بكر الصديق رضي الله عنه فمن دونه اعدل يا ابا بكر لما كان فيه شء من النكرة ولا من الكراهة واليهود ان قالوا لنا السام عليكم او قالوا الموت عليكم لقلنا لهم صدقتم ولا خفاء في هذا، وكذلك لو خاصمونا في حق يدعونه فرفعوا اصواتهم علينا ما كان في ذلك نكرة وهو لرسول الله صلي الله عليه وسلم من اهل الاسلام وغيرهم كفر ونقض للذمة، وكذلك اذا سحرنا ساحر مسلم او كافر فلم يزد علي ان كاذنا كيدا لا يفلح معه قال الله تعالي: (انما صنعوا كيد ساحر ولا يفلح الساحر حيث اتي) وليس بالكيد تنتقض الذمة لانهم لم يفارقوا به الصغار وهو لرسول الله صلي الله عليه وسلم اذا قصد به كفرا ونقض للذمة لانه خلاف التعظيم المفترض له خاصة دون غيره وكذلك سم الطعام لنا ليس فيه الا افساد مال من اموالنا ان كان لنا او كيد من فاعله ان كان الطعام له وليس بافساد المال والكيد تنتقض الذمة ولا يكفر بذلك احد الا من عامل بذلك لرسول الله صلي الله عليه وسلم خاصة فهو كفر ونقض للذمة لانه خلاف التعظيم المفترض له علينا وعلي جميع اهل الارض جنها وانسها وكذلك لو ان مسلما او ذميا لم يسلم لحكم حكم به ابو بكر رضي الله عنه فمن دونه باجتهاده فيما لا نص فيه ولا اجماع ولا رضي بذلك القول لم يكن عليه في ذلك حرج ولا اثم ولو انهما لم يسلما لحكم حكم به رسول الله صلي الله عليه وسلم لكان ذلك كفرا من المسلمين بنص القران واخراجا لهم عن الايمان ولكان ذلك نقضا للذمة من الذمي لانه خروج عن الصغار وطعن في الدين وهذا بين ولله الحمد كثيرا * تم الجزء الحادي عشر من كتاب المحلي لابن حزم وبه تم الكتاب والحمد لله اولا واخرا واسال الله تعالي ان يوفقنا الي ابراز كتب مفيدة تنفع المسلمين كما وفقنا لغيره من الكتب النافعة وصلي الله علي محمد واله وصحبه ومن عمل بشرعه من العالمين اللهم امين امين  

