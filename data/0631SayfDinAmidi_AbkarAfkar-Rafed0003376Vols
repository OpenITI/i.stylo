 واعلم ان الاسماء الحسني قد تنقسم وجوها من التقسيم لا بد من الاشارة اليها مبالغة في التفهيم لغير المتدربين.
 «» القدوس «» الغفار «» القهار «» الفتاح «» الحكم «» العدل «» الكبير «» الحفيظ «» المميت «» الحسيب «» الرقيب «» الواسع «» الحميد «» المحصي «» المقتدر «» المقدم «» المءخر «» البر «» المنتقم «» مالك الملك «» ذو الجلال والاكرام «» المغني «» البديع «» الرشيد «» الصبور وقد ذكر زهير بدلها ما ياتي :
 «» البار «» الجميل «» القاهر «» القريب «» الراشد «» الرب «» المبين «» «البرهان» «» الشديد «» الواقي «» ذو القوة «» القاءم «» الداءم «» الحافظ «» الناظر «» السامع «» المعطي «» الكافي «» الابد «» العالم «» الصادق «» المنير «» التام «» القديم «» الوتر وقد ذكر البيهقي رواية ثالثة عن عبد العزيز بن الحصين ورد فيها ما يخالف هاتين الروايتين.
 ثم قال : وزعم بعض اهل العلم بالحديث : ان ذكر الاسامي في هذا الحديث من جهة بعض الرواة وان الحديث عن النبي صلي الله عليه وسلم في ذكر عددها دون تفسير العدد وقوله صلي الله عليه وسلم «ان لله تسعة وتسعين اسما» لا ينفي غيرها وانما اراد والله اعلم ان من احصي من اسماء الله عز وجل تسعة وتسعين اسما دخل الجنة. سواء احصاها مما نقلنا في الحديث الاول ، او مما ذكرنا في الحديث الثاني. او من ساءر ما دل عليه الكتاب او السنة ، او الاجماع ، وبالله التوفيق.
 هذا وقد اورد الدكتور حسن الجمل في كتابه (الاسماء الحسني) هذه الاسماء كما جاءت في القران الكريم حسب ترتيبها في المصحف ، واوصلها الي اكثر من تسعة وتسعين اسما ، اوصلها الي ستة وماءة اسم وقال : «تلك هي الاسماء الحسني التي جاءت في القران العظيم بصيغة الاسم ، وفي مواضع ظاهرة من ايات الكتاب العزيز ، وقد قرات ماءة وستة اسماء نزلت بلفظ الاسم في القران الحكيم.
 وهذا العدد الذي ذكرته اجتهاد فيه احتمال الخطا اسال ربي الا يءاخذني عليه».
 (الاعتقاد للبيهقي ص  ،  الاسماء الحسني للجمل ص  ).


