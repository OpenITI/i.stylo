 ه صلي الله عليه وسلم؟ an من الحيوانات التي جاءت الاخبار بانها نطقت للنبي صلي الله عليه وسلم ما ياتي:  الجمل: جاء في مسند الامام احمد بسند صحيح، وفي مستدرك الحاكم عن عبد الله بن جعفر ان النبي صلي الله عليه وسلم دخل حاءطا حديقة  لبعض الانصار فاذا فيه جمل، فلما راي النبي صلي الله عليه وسلم ذرفت في عيناه، فمسح النبي سنامه، وفي رواية مسح ذفراه  والذفري بالالف المقصورة، هو الموضع الذي يعرق منه البعير عند اذنه  فسكن، قال النبي لصاحب الجمل " انه شكا الي انك تجيعه وتدءبه " اي تتعبه في العمل. ورواه احمد باسناد جيد عن انس، ورواه احمد والحاكم والبيهقي بسند صحيح من طريق يعلي بن مرة الثقفي، كما روي مثله عن طريق جابر بسند ضعيف. وروي الطبراني عن جابر ان الجمل رغا علي هامة النبي في غزوة ذات الرقاع وقال " ان هذا الجمل يستعديني علي صاحبه " اي يشكو لي صاحبه، وروي الطبراني في كتاب الدعوات عن زيد بن ثابت ان النبي صلي الله عليه وسلم كان في غزاة، فجاء اعرابي ومعه جمل، وجاء رجل كانه حرسي، فقال للنبي صلي الله عليه وسلم: ان هذا الاعرابي سرق بعيري هذا، فرغا البعير وحن ساعة. فانصت النبي، فلما فرغ قال للحرسي "انصرف فان البعير يشهد عليك انك كاذب " ورواها ايضا عن عكرمة بسند ضعيف، كما روي ابن ماجه ان بعيرا رغا ثلاث مرات علي هامة النبي، وكان النبي يءمن في كل منها، ولما سءل عن ذلك قال "ان البعير كان يدعو له ". من هذا يعلم ان الحديث لم يخرج في الصحيحين: البخاري ومسلم، وحكم بعضهم بصحة رواية احمد وغيره، كما حكموا علي الروايات للحادثة بالضعف في حوادث متشابهة، ومهما يكن من شء فليس في هذه الروايات ان الجمل كلم النبي صلي الله عليه وسلم باللغة التي يفهمها الناس، وكل ما كان من الجمل هو الرغاء اي صوته العادي، وقد عرف النبي صلي الله عليه وسلم منه بفراسته او بالالهام من الله انه يشكو وصدق علي ذلك صاحب الجمل واخبر النبي صلي الله عليه وسلم ان الجمل الاخر كان يدعو له. وليس هناك ما يمنع عقلا ولا شرعا ان يلهم الله نبيه معرفة لغة الجمل ومقصده من رغاءه، فقد ثبت ان داود وسليمان عليهما السلام كانا يعرفان منطق الطير، قال تعالي {وورث سليمان داود وقال يا ايها الناس علمنا منطق الطير} النمل: ، وقال {قالت نملة يا ايها النمل ادخلوا مساكنكم لا يحطمنكم سليمان وجنوده وهم لا يشعرون * فتبسم ضاحكا من قولها} النمل: ، ، وفي شان الهدهد قال الله {فقال احطت بما لم تحط به وجءتك من سبا بنبا يقين} الي ان قال {قال سننظر اصدقت ام كنت من الكاذبين} النمل: ، . ومع ان معرفة النبي للغة الجمل وقصده من رغاءه غير ممنوعة عقلا ولا شرعا فان الطرق التي رويت بها هذه الحوادث بعضها صحيح وبعضها ضعيف. ومثل هذا لا تثبت به العقاءد علي ما قرره العلماء. وعدم تصديقها لا يخرج المءمن من داءرة الايمان الي داءرة الكفر.   الحمار  ذكر ابن عساكر في تاريخه بسنده الي ابي منصور: لما فتح النبي صلي الله عليه وسلم خيبر اصاب حمارا اسود، فقال له النبي صلي الله عليه وسلم "ما اسمك "؟ قال: يزيد بن شهاب، اخرج الله من نسل جدي ستين حمار لا يركبها الا نبي، واخيرا قال له النبي صلي الله عليه وسلم "انت يعفور" وكان يركبه في حاجته، ويبعثه خلف من شاء من اصحابه فياتي الباب فيقرعه براسه فيعلم صاحب البيت ان النبي صلي الله عليه وسلم يستدعيه فيذهب اليه. هذا الحديث قال فيه الحافظ ابو موسي المديني: حديث منكر جدا، اسنادا ومتنا، لا يحل لاحد ان ينويه الا مع كلامي عليه. ورواه ابو نعيم بمثله عن معاذ بن جبل، وهو مطعون فيه، واخرجه ابن حبان في الضعفاء وقال: لا اصل له، وليس سنده بشء وذكره ابن الجوزي في الموضوعات، وقال ابن حجر: انه شديد الضعف.   الجدي  قال انه شهد بان الرسول مرسل لاجل ان يءمن ابو لهب بالنبي.  الثعبان  وهو الذي لدغ ابا بكر في الغار يقال انه كلم النبي، ولم ار لهذين الخبرين اثر يعتمد عليه في كتب السنة والسيرة.   الضب  وحديثه مشهور علي الالسنة ورواه البيهقي في احاديث كثيرة، لكنه حديث غريب ضعيف، قال الحافظ المزي: لا يصح اسنادا ولا متنا، وذكره القاضي عياض في "الشفاء" مرويا عند الطبراني. والبيهقي وشيخه ابن عدي كلهم عن ابن عمر، ان اعرابيا دخل علي النبي صلي الله عليه وسلم ومعه ضب وقال لا اومن بك حتي يءمن هذا الضب، فناداه الرسول وساله عن الله الذي يعبده وعن رسوله، وهو مطعون فيه بالضعف، وقيل: انه موضوع، واختار القسطلاني انه ضعيف لا موضوع.  الغزالة روي حديثها البيهقي من طرق، وضعفه جماعة من الاءمة، لكن له طرق يقوي بعضها بعضا فيكون حسنا لغيره، وذكره القاضي عياض في الشفاء بلا سند، وابو نعيم باسناد فيه مجاهيل وملخص الحادثه ان الرسول كان في صحراء فسمع هتاف الظبية التي صادها اعرابي وقيدها، وطلبت ان يفكها حتي ترضع اولادها وتعود فكان ذلك فاطلقها الاعرابي ونطقت بالشهادتين. ذكر السخاوي ان ابن كثير قال: لا اصل له، ومن نسبه الي النبي فقد كذب.  الذءب  وقد شهد للرسول بالرسالة، وحكي قصته ابو هريرة وانس بن مالك وابن عمر وابو سعيد الخدري، ورواها احمد باسناد جيد، والترمذي والحاكم وصححا الحديث. جاء فيها ان ذءبا اخذ شاة فانتزعها الراعي منه فقال الذءب له: الا تتقي الله، تنزع رزقا ساقه الله لي، فعجب الراعي من كلام الذءب، فاخبره بان الاعجب من ذلك انك لا تءمن بالرسول الذي ظهر في يثرب فذهب اليه الراعي واسلم، وامره الرسول باعلان ما حدث من الذءب، ثم قال الرسول "صدق والذي نفسي بيده لا تقوم الساعة حتي يخرج الرجل من اهله فيخبره نعله او سوطه او عصاه بما احدث اهله من بعله ". وروي قصة الذءب البخاري في تاريخه وابو نعيم في الدلاءل، واسناده ليس بالقوي ورواها البيهقي في الدلاءل وسعيد بن منصور في سننه كما رواها البغوي واحمد والبزار وغيرهما بسند صحيح عن ابي هريرة. ذكر القسطلاني في المواهب وذكر الزرقاني في شرحها هذه الحوادث بتوضيح في الجزء الخامس من صفحة   ، وليس في ادلتها ما يوجب علينا تصديقها كعقيدة، وان كان خرق العادات للانبياء والاولياء جاءزا لكن لا يجوز ان ننسب الي الرسول الا ما وثقنا من صدقه حتي لا نقع تحت طاءلة حديثه "من كذب علي متعمدا فليتبءا مقعده من النار" رواه البخاري ومسلم وما فصله به ربه من الاشياء الثابتة كثير، وكفي بالقران معجزة خالدة باقية تتحدي العالم كله الي ان تقوم الساعة، وما حدث من الخوارق قد انتهي اثره 

  AUT حديث ثلاثة من الجفاء
 f عطية صقر. مايو  mالقران والسنة q قال رسول الله صلي الله عليه وسلم " ثلاثة من الجفاء: ان يمسح الرجل جبهته قبل ان يفرغ من صلاته، وان يبول قاءما، وان يسمع الاذان ولا يقول مثل ما يقول المءذن " فما معني الجفاء، وكيف يمسح الرجل جبهته قبل ان يفرغ من الصلاة، وما الضرر من هذا؟ an هذا الحديث له عدة روايات، روي احداها البزار من طريق بريدة بدون ذكر الاذان، وجاء بدله بالنفخ في سجوده "نيل الاوطار للشوكاني ج  ص  " ومعني الجفاء ترك سنة النبي صلي الله عليه وسلم وهديه، وهو يدل علي كراهة هذا الامور، وقد ورد في كل منها نصوص خاصة بها. والنهي عن البول من قيام حكمته التحرز من تطايره واصابه البدن او الثوب بالنجاسة. وهو مكروه الا لحاجة، واجابة السامع للمءذن لها فضل كبير، من تهاون فيها فاته ثواب عظيم، واما مسح المصلي جبهته مما يعلق بها من تراب في السجود فقد كرهه السلف، وعللوه بامور، منها ان يبقي اثر السجود علي وجهه دليلا علي العبادة والتواضع لله ومنعا من الكبر، وفي هذا رجاء قبول الصلاة، ومنها ان مسحه اثناء الصلاة فيه شغل للانسان عن ربه وعدم تمكن من الخشوع. وقد صحت احاديث " النووي علي مسلم ج ص  " تدل علي كراهة مسح الحصا، علي معني ان يزيح المصلي الحصا من موضع سجوده ليسجد علي التراب، وكان مسجد النبي صلي الله عليه وسلم مفروشا به، وليس مفروشا بما نعهده اليوم. وعلل العلماء كراهته بانه ينافي الخشوع، خصوصا اذا كثر، ولهذا رخص في مسح حصاة واحدة تقليلا للحركة وجاء في بعض الاحاديث "اذا قام احدكم الي الصلاة فان الرحمة تواجهه فلا يمسح الحصا" ذكره االشوكاني في نيل الاوطار "ج  ص " كما علل النهي عن مسح الحصا بان كل حصاة تحب ان تحظي بالسجود عليها فلا تنبغي ازاحتها كما جاء مصرحا به في بعض الروايات "المرجع السابق ص ". هذا واذا كان مسح الحصا وتسوية الارض قبل الدخول في الصلاة فلا باس به 

  AUT حديث " لا يلدغ المءمن من جحر مرتين "
 f عطية صقر. مايو  mالقران والسنة q هل ما يردده كثير من الناس بقولهم " المءمن لا يلدغ من جحر مرتين حديث مروي عن النبي صلي الله عليه وسلم؟ an هذا حديث صحيح عن النبي صلي الله عليه وسلم رواه البخاري وسببه انه اسر ابا عزقي الجمحي يوم بدر، فمن عليه واطلقه، وعاهده الا يحرض عليه ولا يهجوه، فلما لحق بقومه عاد الي ما كان عليه من التحريض والهجاء، ثم اسر يوم احد، فطلب من الرسول ان يمن عليه، فلم يستجب له وقال هذا الحديث. ومعناه ان المءمن ينبغي ان يكون حذرا متيقظا لا ينخدع بظواهر الناس، وبخاصة من يخالفه في العقيدة، فالنفاق له اهله الذين يجيدونه ويغرون به الناس، قال تعالي فيهم {اذا جاءك المنافقون قالوا نشهد انك لرسول الله والله يعلم انك لرسوله والله يشهد ان المنافقين لكاذبون} المنافقون: ،. ولو فرض ان المءمن احسن الظن بالمنافق وخدع به مرة فلا ينبغي ان يخدع به مرة اخري، كالذي ادخل اصبعه في جحر فلدغه ثعبان، لا ينبغي ان يدخل اصبعه فيه مرة اخري. وهذه دعوة للمءمنين ان يكونوا علي يقظة تامة في تعاملهم مع الناس بوجه عام، ومع الاعداء بوجه خاص وتشتد الدعوة الي اليقظة عند وجود الفتن والقلاقل، والله يقول {يا ايها الذين امنوا خذوا حذركم} النساء:. والشاعر الحكيم يقول: ومن رعي غنما في ارض مسبعة * ونام عنها تولي رعيها الاسد 

  AUT حديث " الاناء يستغفر للاعقه "
 f عطية صقر. مايو  mالقران والسنة q هل من الحديث ما يقال "الاناء يستغفر للاعقه " وكيف يصح ذلك مع انه من مستهجنات العصر؟ an  لعق الاناء جاء فيه حديث مسلم عن جابر انه صلي الله عليه وسلم امر بلعق الاصابع والصحفة، وقال: " انكم لا تدرون في اي طعامكم البركة " وجاء في رواية له عن انس: وامرنا ان نسلت القصعة، والسلت كما فسره النووي هو المسح وتتبع ما بقي في القصعة من الطعام " ج  ص  ". وفي هذا الارشاد تنظيف للقصعة وعدم ضياع شء من الطعام، فلعق الصحفة التي ياكل منها جمع لا يكون باللسان منهم جميعا، او من اكثر من واحد، وهو متصور في الاناء الخاص الذي ياكل منه شخص واحد، ويكون اللعق بمعني السلت بوساطة الاصابع، فيتتبع كل اكل باصبعه ما تواري او بقي من جوانب الصحفة، فياخذه وياكله. وهذا الامر تعودوا عليه ولا يرون فيه باسا، وقد تعافه بعض النفوس. والمهم هو تنفيذ المطلوب بالوسيلة التي يتواضع عليها الناس، فلا يبقي في الاناء طعام يلقي ويضيع، بل نحافظ عليه ونلتقطه من الاناء بالمعلقة او بالشوكة او السكين ونحو ذلك، ولهذا يندب ان يلتقط ما وقع من الطعام وينظف ويءكل ولا يدعه للشيطان كما جاء في صحيح مسلم. جاء في "الاواءل " للسيوطي ان اول من اتخذ الملعقة سيدنا ابراهيم الخليل "غذاء الالباب للسفاريني ج  ص ".  واما استغفار الاناء للاعقه فالمراد منه اخيرا الحث علي نظافته وعدم ترك شء فيه يعرض للضباع او يسبب القذارة. وقد جاء في ذلك حديث رواه الترمذي وابن ماجه واحمد والبغوي وغيرهم، وقال عنه الترمذي: حديث غريب، اي رواه راو واحد فقط في سلسلة الرواة، قالوا: هو المعلي بن راشد الذي رواه عن ام عاصم نبيشة، ورواه عنه كثيرون كما ذكر في تحفة الاحوذي شرح الترمذي "اسد الغابة رقم  الزرقاني علي المواهب ج  ص  " والحديث بلفظ "من اكل طعاما في انية ثم لحسها استغفرت له القصعة" قال الزرقاني: حقيقة وشكرا لفعله. ولا مانع شرعا ولا عقلا ان يخلق الله في الجماد تمييزا ونطقا، ويءيده رواية الديلمي "استغفرت له القصعة فتقول: اللهم اجره من النار كما اجارني من لعق الشيطان " وقال هو كناية عن حصول المغفرة له ابتداء، لانه لما كان حصول المغفرة بواسطة لحسها غفر له، ولما كانت المغفرة بسبب لحسها كانها تطلب له الغفران. هذا ما ورد ولا يجوز ان يعلق عليه بالاستنكار، فالعرف اذ ذاك كان يقبله والمهم هو المحافظة علي المقصود منه، وهو النظافة والاقتصاد هذا وقد سءل بعض العلماء عن هذا الحديث وعن حديث "اذا اكلتم فافضلوا فقال ما نصه: هذان حديثان لا اصل لهما "مجلة الاسلام  المجلد الرابع، العدد " وقد راينا ان حديث لعق الاناء والاستغفار للاعقه ورد بطريق صحيح. اما حديث "اذا اكلتم فافضلوا" فلم اعثر له علي تخريج مقبول حتي الان 

