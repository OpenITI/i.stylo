  حدثنا هلال بن العلاء الرقي قال ثنا ابي قثنا عبيد الله بن عمرو عن زيد بن ابي انيسة عن سعيد بن ابي بردة قال ثنا ابو بردة عن ابي موسي رضي الله عنه قال بعثني رسول الله صلي الله عليه وسلم ومعاذ بن جبل رضي الله عنه الي اليمن فقال ( انطلقا فادعوا الناس الي الاسلام وبشرا ولا تنفرا ويسرا ولا تعسرا ) قال قلت يا رسول الله افتني في شرابين كنا نصنعهما باليمن البتع من العسل ينبذ حتي يشتد والمزر من الشعير والذرة ينبذ حتي يشتد قال وكان رسول الله صلي الله عليه وسلم قد اعطي جوامع الكلم بخواتيمه ( احرم كل مسكر اسكر عن الصلاة ) فانطلقنا فلما قدمنا اليمن نزل كل واحد منا في قبة علي حدة  ثم جعلا يتزاوران قال فزار معاذ ابا موسي يوما وهو في فناء قبته في الظل فاذا هو برجل قاءم عند ابي موسي وابو موسي يريد قتله قال معاذ ما هذا يا ابا موسي قال يهودي اسلم ثم رجع عن دينه الي يهوديته قال معاذ ما انا بجالس حتي يقتل فقتله ثم جلسا يتحدثان قال يا ابا موسي كيف تفعل بالقران قال اتفوقه تفوقا قال اتنقصه تنقصا اقرا علي فرشي وفي صلاتي وعلي راحلتي ثم قال ابو موسي كيف تفعل انت يا ابا عبد الرحمن قال معاذ سانبءك كيف افعل اما انا فابدا فاتقوي بنومتي علي قومتي فاحتسب في نومتي كما احتسب في قومتي
  حدثنا ابو داود الحراني قال ثنا يزيد بن هارون قال انبا شعبة عن سعيد بن ابي بردة عن ابيه عن ابي موسي ان النبي صلي الله عليه وسلم لما بعثه ومعاذا الي اليمن قال ابو موسي يا رسول الله ان اهل اليمن يصنعون شرابا من العسل يقال له البتع يسكر وشرابا من الشعير يقال له المزر يسكر قال ( اعلموهم ان كل مسكر حرام ) قال لهما ( بشرا ولا تنفرا ويسرا ولا تعسرا وتطاوعا ) قال فقال معاذ لابي موسي كيف تقرا القران قال اقراه قاءما وقاعدا وماشيا وراكبا وعلي فراشي وعلي كل حال اتفوقه تفوقا فقال معاذ لكني انام اول الليل اتقوي به علي اخره قال ففضل فعل معاذ فلما قدما اليمن نزل كل واحد منهما علي حدة فاتي معاذ ابا موسي ذات يوم وعنده رجل موثق فقال له معاذ ما هذا قال كان يهوديا فاسلم ثم تهود قال يزيد قال لي شعبة والله لا ازيدك ولا غيرك علي هذا ولو ضربت عنقي
  حدثنا ابو داود الحراني قال ثنا وهب بن جرير قال ثنا شعبة باسناده فقال رسول الله صلي الله عليه وسلم ( كل مسكر حرام ) بمثله فلما قدما اليمن كان لكل واحد منهما فسطاطا فاتي معاذ ابا موسي وعنده رجل فقال ان هذا كان يهوديا فاسلم ثم تهود وقد اقسمت لا ابرح حتي اقتله فقال معاذ وانا اقسم لا  ابرح حتي اقتله
   * بيان عقاب من يشرب المسكر من اي شراب كان قليلا كان او كثيرا وان كل مسكر خمر وكل مسكر حرام وعقاب من يدمن شرب الخمر والدليل علي ان من تاب منها قبل موته قبلت توبته
  *
  حدثنا محمد بن اسماعيل بن سالم الصاءغ قال ثنا محرز بن عون او ابن سلمة قال ثنا عبد العزيز بن محمد عن عمارة بن غزية عن ابي الزبير عن جابر رضي الله عنه قال قدم نفر من جيشان من اهل اليمن فقالوا يا رسول الله سمعنا بذكرك فاحببنا ان ناتيك فنسمع منك فقال النبي صلي الله عليه وسلم ( اسلموا تسلموا ) قال فاسلموا وقالوا يا رسول الله مرنا وانهنا فانا نري ان الاسلام قد نهانا عن اشياء كنا ناتيها وامرنا باشياء لم نكن نقربها قال فامرهم النبي صلي الله عليه وسلم ونهاهم ثم خرجوا حتي جاءا رحالهم وقد خلفوا فيها رجلا فقالوا اذهب فضع من اسلامك علي يد رسول الله صلي الله عليه وسلم مثل الذي وضعنا وسله عن شرابنا فانا نسينا ان نساله وقد كان من اهم الامر عندنا فجاء ذلك الفتي فاسلم فقال يا رسول الله ان النفر الذين جاءك واسلموا علي يديك قد امروني ان اسالك عن شراب يشربونه بارضهم من الذرة يقال له المزر وارضهم ارض باردة وهم يعملون لانفسهم وليس لهم من يمتهن الاعمال دونهم واذا شربوه قووا به علي العمل قال ( اومسكر هو ) قال اللهم نعم قال النبي صلي الله عليه وسلم ( كل مسكر حرام ) قال فافزعهم ذلك فخرجوا باجمعهم حتي جاءا رسول الله صلي الله عليه وسلم فقالوا يا رسول الله  ان ارضنا ارض باردة وانا نعمل لانفسنا وليس لنا من يمتهن دون انفسنا وانما شراب نشربه بارضنا من الذرة يقال له المزر واذا شربناه فاعنا علي البرد وقوينا علي العمل فقال ( امسكر هو ) قالوا نعم فقال النبي صلي الله عليه وسلم ( كل مسكر حرام ان علي الله عهدا لمن يشرب مسكرا ان يسقيه من طينة الخبال قالوا يا رسول الله وما طينة الخبال قال عرق اهل النار او عصارة اهل النار )
  حدثنا يونس بن عبد الاعلي والصغاني قالا ثنا نعيم بن حماد قال ثنا عبد العزيز بن محمد بن عمارة بن غزية عن ابي الزبير عن جابر عن النبي صلي الله عليه وسلم قال ( كل مسكر حرام ان علي الله عهدا لمن يشرب مسكرا ان يسقيه من طينة الخبال قالوا يا رسول الله وما طينة الخبال قال عرق اهل النار او عصارة اهل النار )
  حدثنا ابو حاتم الرازي قال ثنا ابن ابي مريم قال ثنا نافع بن يزيد حدثني ابو حرزة يعقوب بن مجاهد عن عبد الرحمن بن جابر بن عبد الله عن ابيه عن النبي صلي الله عليه وسلم قال ( نهيتكم عن كذا وكذا فاشربوا ولا احل مسكرا )
  حدثنا محمد بن يحيي قثنا عياش بن الوليد قال ثنا عبد الاعلي عن محمد بن اسحاق عن الزهري عن انس بن مالك ان النبي صلي الله عليه وسلم نهي عن الدباء والحنتم وقال ( كل مسكر حرام )
  حدثنا الصغاني قثنا روح بن عبادة قال ثنا ابن جريج اخبرني موسي بن عقبة عن نافع عن ابن عمر رضي الله عنهما ان رسول الله صلي الله عليه وسلم قال ( كل مسكر خمر وكل مسكر حرام )
 رواه مسلم عن معن عن عبد العزيز بن المطلب عن موسي بن عقبة بمثله مرفوع 
  حدثنا عمر بن شبة وعبد الرحمن بن منصور البصري قالا ثنا يحيي بن سعيد ح
 وحدثنا ابو امية قال ثنا القواريري قال ثنا يحيي بن سعيد عن عبيد الله بن عمر اخبرني نافع عن ابن عمر قال ولا اعلمه الا عن النبي صلي الله عليه وسلم قال ( كل مسكر خمر وكل مسكر حرام )
  حدثنا عثمان بن خرزاد الانطاكي قال ثنا ابو هشام محمد بن يزيد قال ثنا عبدة بن سليمان قال ثنا عبيد الله بن عمر عن نافع عن ابن عمر قال قال رسول الله صلي الله عليه وسلم ( كل مسكر خمر وكل مسكر حرام )
  حدثنا ابو امية قال ثنا عمرو بن عثمان قال ثنا زهير عن عبيد الله بن عمر عن نافع عن ابن عمر قال قال النبي صلي الله عليه وسلم ( كل مسكر خمر )
  حدثنا عثمان بن خرزاذ والصغاني قالا ثنا ابو الربيع الزهراني قال ثنا حماد بن زيد عن ايوب عن نافع عن ابن عمر قال قال رسول الله صلي الله عليه وسلم ( كل مسكر خمر وكل مسكر حرام ومن شرب الخمر في الدنيا فمات وهو يدمنها لم يتب لم يشربها في الاخرة )
  حدثنا ابو داود السجزي قال ثنا محمد بن عيسي بن الطباع قال ثنا حماد بن زيد ح
 وحدثني موسي الدنداني قال سالت محمد بن عيسي بن الطباع فحدثني قال ثنا حماد بن زيد عن ايوب عن نافع عن ابن عمر قال قال النبي صلي الله عليه وسلم ( كل مسكر خمر وكل مسكر حرام ومن مات وهو يشرب الخمر يدمنها لم يشربها في الاخرة )
  حدثنا ابو داود السجزي قال ثنا سليمان بن داود العتكي قال ثنا حماد بمثله 
  حدثنا ابو ابراهيم الزهري قال ثنا نعيم بن حماد قال ثنا ابن المبارك عن حماد بن زيد باسناده مثله عن النبي صلي الله عليه وسلم الي قوله ( وكل مسكر حرام )
  حدثنا الربيع بن سليمان قال ثنا ابن وهب ح
 واخبرنا يونس بن عبد الاعلي قال انبا ابن وهب ان مالك حدثه عن نافع عن ابن عمر عن النبي صلي الله عليه وسلم قال ( من شرب الخمر في الدنيا فلم يتب منها حرمها في الاخرة ولم يسقها )
  حدثنا محمد بن حيويه قال ثنا مطرف والقعنبي عن مالك الي قوله ( ثم لم يتب منها حرمها في الاخرة ) وزاد القعنبي كما قال ابن وهب ( ولم ينلها )
  حدثنا يوسف بن مسلم ومحمد بن الخليل المخرمي والصغاني قالوا ثنا حجاج بن محمد عن ابن جريج اخبرني موسي بن عقبة عن نافع عن ابن عمر قال قال رسول الله صلي الله عليه وسلم ( من شرب الخمر في الدنيا لم يشربها في الاخرة الا ان يتوب )
  حدثنا ابو عبيد الله حماد بن الحسن قال ثنا روح بن عبادة قال ثنا ابن جريج اخبرني موسي بن عقبة بمثله ( الا ان يتوب )
  حدثنا الحسن بن علي بن عفان قال ثنا ابو اسامة ح
 وحدثنا موسي بن اسحاق القواس قال ثنا عبد الله بن نمير قالا ثنا عبيد الله بن عمر عن نافع عن ابن عمر ان النبي صلي الله عليه وسلم قال ( من شرب الخمر في الدنيا لم يشربها في الاخرة الا ان يتوب ) 
  حدثنا الصغاني قال انبا ابو النضر قال ثنا شعبة عن ايوب عن نافع عن ابن عمر قال قال النبي صلي الله عليه وسلم ( من شرب الخمر في الدنيا لم يشربها في الاخرة )
  حدثنا الدبري عن عبد الرزاق قال انبا معمر عن ايوب بمثله وقال ( ثم مات وهو يشربها ولم يتب منها حرمها الله عليه في الاخرة )
  حدثنا داود بن سليمان بن ابي حجر الايلي قال ثنا ابي قال ثنا بكر ابن صدقة عن عبد الله بن سعيد بن ابي هند عن نافع عن ابن عمر عن النبي صلي الله عليه وسلم قال ( من شرب الخمر في الدنيا لم يشربها في الاخرة الا ان يتوب )
  حدثنا يونس بن حبيب قال ثنا ابو داود قال ثنا جويرية عن نافع عن ابن عمر عن النبي صلي الله عليه وسلم بمثله
  حدثنا ابو عتبة الحجازي قال ثنا ابن ابي فديك قال حدثني الضحاك ابن عثمان عن نافع عن ابن عمر لا اعلمه الا قال عن النبي صلي الله عليه وسلم بمثله
   *  بيان النهي عن اتخاذ الخمر خلا
  *
  حدثنا عباس الدوري قال ثنا ابو داود الحفري قال ثنا سفيان الثوري عن السدي عن ابي هبيرة يحيي بن عباد عن انس بن مالك رضي الله عنه عن النبي صلي الله عليه وسلم انه كره ان يجعل الخمر خلا
  حدثنا الغزي قال ثنا الفريابي ح
 وحدثنا ابن عامر قال ثنا قبيصة قالا ثنا سفيان عن السدي عن ابي هبيرة عن انس عن النبي صلي الله عليه وسلم انه نهي ان يجعل الخمر خلا
  حدثنا ابو اسماعيل قال ثنا ابو حذيفة قثنا سفيان باسناده قال جاء رجل الي النبي صلي الله عليه وسلم وفي حجره يتيم وكان عنده خمر حين حرمت الخمر فقال يا رسول الله نصنعه خلا قال لا قال فصبه حتي سال الوادي
  حدثنا محمد بن حيويه قال ثنا يحيي بن يحيي قال ثنا عبد الرحمن بن مهدي قال ثنا سفيان عن السدي عن يحيي بن عباد عن انس  ابن مالك ان النبي صلي الله عليه وسلم سءل عن الخمر تتخذ خلا فقال لا
  حثنا موسي بن سفيان الجنديسابوري قال ثنا عبد الصمد بن حسان قال ثنا سفيان عن السدي عن ابي هبيرة عن انس انه كان عنده مال يتيم فاشتري به خمرا فلما حرمت الخمر اتي النبي صلي الله عليه وسلم فقال يا رسول الله اجعله خلا قال ( لا اهرقه )
 رواه القطان كما رواه عبد الرحمن ولم يخرجه مسلم وغيره هذا الواحد بهذا اللفظ
  حدثنا يوسف بن سعيد المصيصي قال ثنا حجاج بن محمد قال حدثني شعبة عن سماك قال سمعت علقمة بن واءل عن ابيه ان النبي صلي الله عليه وسلم ساله رجل من جعفي يقال له سويد بن طارق عن الخمر فنهاه عنه فقال شء نصنعه دواء فقال النبي صلي الله عليه وسلم ( انما هي داء )
  حدثنا يونس بن حبيب وعمار قالا ثنا ابو داود قال ثنا شعبة عن سماك بن حرب قال سمعت علقمة بن واءل الحضرمي يحدث عن ابيه ان سويد بن طارق سال النبي صلي الله عليه وسلم فقال يا رسول الله ان لنا اعنابا نعتصرها فذكر الخمر فنهاه فقال انها دواء فقال رسول الله صلي الله عليه وسلم ( بل هي داء )
  حدثنا ابو قلابة وابو داود الحراني قالا حثنا وهب بن جرير قال ثنا شعبة عن سماك عن علقمة بن واءل عن ابيه ان طارق بن سويد او سويد ابن طارق من جعفي سال النبي صلي الله عليه وسلم عن الخمر فنهاه عنها وقال ابو داود عن صنعتها فقال انها دواء فقال النبي صلي الله عليه وسلم ( ليست بدواء ولكنها داء ) 
 رواه غندر عن شعبة فقال طارق بن سويد
  حدثنا ابو داود الحراني قال ثنا ابو عتاب قال ثنا شعبة قال ثنا سماك بن حرب سمعت علقمة بن واءل يحدث عن ابيه واءل ان سويد بن طارق سال رسول الله عن الخمر فنهاه عنها ان يصنعها فقال انها دواء فقال رسول الله صلي الله عليه وسلم ( ليست دواء ولكنها داء )
  حدثنا ابراهيم بن مرزوق قال ثنا عثمان بن عمر قال انبا شعبة عن سماك عن علقمة بن واءل عن ابيه انهم اتوا النبي صلي الله عليه وسلم وفيهم رجل من جعفي فسال النبي صلي الله عليه وسلم عن الخمر فذكر مثله
  حدثنا ابو داود الحراني قال ثنا عثمان بن عمر قال اخبرنا شعبة عن سماك عن علقمة بن واءل عن ابيه قال قال رسول الله صلي الله عليه وسلم ( لا تقولوا الكرم وقولوا العنبة والحبلة الكرم محففه ) وقال عمر لا تقولوا الكرم يعني العنب وقولوا كذا وكذا
  حثنا عباس الدوري قال ثنا شبابة قال ثنا شعبة عن سماك عن علقمة عن ابيه ان النبي صلي الله عليه وسلم قال لا تقولوا الكرم ولكن قولوا الحبلة
  اخبرنا يونس بن عبد الاعلي قال انبا ابن وهب اخبرني مالك ابن انس وغيره عن زيد بن اسلم عن عبد الرحمن بن وعلة السباءي من اهل مصر انه سال ابن عباس رضي الله عنهما عن ماء يعصر من العنب فقال ابن عباس ان رجلا اهدي لرسول الله صلي الله عليه وسلم رواية خمر فقال له رسول الله صلي الله عليه وسلم ( هل علمت ان الله عز وجل حرمها قال لا فسار انسان عنده فقال له رسول الله صلي الله عليه وسلم لم ساررته قال امرته ان يبيعها قال ان الذي حرم شربها حرم بيعها قال ففتح له المزادتين حتي ذهب ما فيهما ) 
  حدثنا يونس بن عبد الاعلي قال انبا ابن وهب قال واخبرني سليمان بن بلال عن يحيي بن سعيد عن عبد الرحمن بن وعلة عن ابن عباس عن رسول الله صلي الله عليه وسلم بمثله
   *  بيان النهي عن اتخاذ النبيذ من البسر والرطب اذا جمعا او خلطا وكذلك من الزبيب والتمر وغيره اذا جمعا وكذلك من البسر والتمر
  *
  حدثنا يوسف بن مسلم قال ثنا حجاج عن ابن جريج سمع عطاء بن ابي رباح قال سمعت جابر بن عبد الله رضي الله عنهما يقول قال النبي صلي الله عليه وسلم ( لا تجمعوا بين الرطب والبسر ولا بين الزبيب والتمر نبيذا )
  حدثنا الصغاني قال ثنا روح بن عبادة قال ثنا ابن جريج بمثله
  حدثنا الدبري قال ثنا عبد الرزاق قال انبا ابن جريج اخبرني عطاء قال سمعت جابر بن عبد الله يقول قال النبي صلي الله عليه وسلم ( لا تجمعوا بين الرطب والبسر وبين التمر والزبيب )
  حدثنا الدبري ثنا عبد الرزاق انبا ابن جريج قال حدثني ابو الزبير عن جابر مثل قول عطاء عن النبي صلي الله عليه وسلم
  حدثنا يوسف بن مسلم ثنا حجاج عن ابن جريج  وثنا الدبري عن عبد الرزاق عن ابن جريج قال قلت لعطاء اذكر جابر ان النبي صلي الله عليه وسلم نهي ان يجمع بين نبيذين غير ما ذكرت الرطب والبسر والزبيب والتمر قال لا الا ان اكون نسيت
  حدثنا يونس بن عبد الاعلي قال انبا ابن وهب قال اخبرني الليث بن سعد وجرير بن حازم ان عطاء بن ابي رباح حدثهما عن جابر بن عبد الله عن رسول الله صلي الله عليه وسلم بمثله يعني ان رسول الله صلي الله عليه وسلم نهي ان ينبذ التمر والزبيب جميعا ونهي ان ينبذ البسر والرطب جميعا
  حدثنا ابو يحيي بن ابي مسرة قال حثنا عبد الله بن يزيد المقرء قال ثنا الليث بن سعد قال ثنا ابو الزبير وعطاء عن جابر عن النبي صلي الله عليه وسلم بمثله
  حدثنا الصغاني قال ثنا اسود بن عامر قال ثنا جرير بن حازم عن عطاء بن ابي رباح عن جابر بن عبد الله قال نهي رسول الله صلي الله عليه وسلم عن الزبيب والتمر ان يخلطا
  حدثنا ابن الجنيد الدقاق قال ثنا ابو النضر قال ثنا الليث قال ثنا عطاء بن ابي رباح وابو الزبير عن جابر قال قال النبي صلي الله عليه وسلم ( لا تنبذوا التمر والزبيب جميعا ولا الرطب والبسر جميعا )
  حدثنا يونس بن عبد الاعلي قال انبا ابن وهب قال وحدثني عمرو بن الحارث والليث بن سعد عن ابي الزبير عن جابر بن عبد الله ان رسول الله صلي الله عليه وسلم نهي ان ينبذ التمر والزبيب جميعا ونهي ان ينبذ البسر والرطب جميعا
  حدثنا الصغاني قال ثنا عبد الوهاب عن سعيد عن مطر عن عطاء عن جابر ان النبي صلي الله عليه وسلم نهي عن خليط البسر والزبيب والتمر
  حدثنا الدبري عن عبد الرزاق عن الثوري عن ابي الزبير عن  جابر قال نهي النبي صلي الله عليه وسلم عن التمر والزبيب والرطب والبسر يعني ان ينبذ جميعا
  حدثنا علي بن اشكاب قال ثنا محمد بن عبد الله الانصاري عن سليمان التيمي قال ثنا ابو نضرة عن ابي سعيد الخدري رضي الله عنه قال نهي رسول الله صلي الله عليه وسلم ان ينبذ في الجر وان يخلط البسر والتمر وان يخلط تمر وزبيب
  حدثنا محمد بن عبد الملك الواسطي وابو داود الحراني قالا ثنا يزيد بن هارون قال انبا سليمان التيمي عن ابي نضرة عن ابي سعيد الخدري عن النبي صلي الله عليه وسلم انه نهي عن نبيذ الجر وعن البسر والتمر يخلطان وعن الزبيب والتمر يخلطان
  حدثنا الصغاني قال ثنا روح بن عبادة قال ثنا شعبة قال سمعت سليمان التيمي عن ابي نضرة عن ابي سعيد ان النبي صلي الله عليه وسلم نهي عن البسر والتمر والزبيب والتمر ان يخلطا ونهي عن نبيذ الجر
 لم يخرج مسلم نبيذ الجر فقط
  حدثنا عثمان بن خرزاذ ثنا حفص بن عمر قثنا شعبة عن سليمان التيمي باسناده مثله
  حدثنا علي بن حرب قال ثنا اسباط بن محمد عن سليمان التيمي عن ابي نضرة عن ابي سعيد قال نهي النبي صلي الله عليه وسلم ان يخلط التمر والزبيب او البسر والرطب
  حدثنا سعيد بن مسعود قال ثنا النضر بن شميل قال ثنا شعبة ثنا ابو مسلمة عن ابي نضرة عن ابي سعيد الخدري قال نهي رسول الله صلي الله عليه وسلم عن الزبيب والتمر او عن البسر والتمر يعني ان يخلطا
  حدثنا يوسف القاضي قال ثنا مسدد قال ثنا بشر بن المفضل  قال انبا سعيد بن يزيد ابو مسلمة عن ابي نضرة عن ابي سعيد الخدري قال نهي رسول الله صلي الله عليه وسلم ان يخلط بين البسر والتمر وبين الزبيب والتمر
  حدثنا ابراهيم بن مرزوق والصغاني وروح بن عبادة ثنا اسماعيل ابن مسلم العبدي ثنا ابو المتوكل الناجي عن ابي سعيد الخدري قال نهي رسول الله صلي الله عليه وسلم ان نخلط بسرا بتمر او زبيبا ببسر وقال ( من شربه منكم فليشرب كل واحد منه فردا تمرا فردا وبسرا فردا او زبيبا فردا )
  حدثنا ابن الجنيد الدقاق ثنا بدل بن المحبر ثنا اسماعيل بن مسلم العبدي باسناده مثله
  حدثنا ابو داود الحراني قال ثنا مسلم بن ابراهيم قال ثنا اسماعيل بن مسلم قال ثنا ابو المتوكل الناجي عن ابي سعيد الخدري قال نهي النبي صلي الله عليه وسلم ان نخلط من بسر وتمر او زبيب وتمر او زبيب وبسر وان ننبذ كل واحد منهما علي حدته
  حدثنا علي بن حرب قال ثنا وكيع بن الجراح قال ثنا هشام الدستواءي عن يحيي بن ابي كثير عن عبد الله بن ابي قتادة عن ابيه رضي الله عنه ان النبي صلي الله عليه وسلم قال ( لا تنبذوا الزهو والتمر ) جميعا ولا الزبيب والترم جميعا ولينبذ كل واحد منهما علي حدة
  حدثنا ابن الجنيد الدقاق قالا ثنا عبد الوهاب بن عطاء ح
 وحدثنا الصغاني وابو امية قالا ثنا سعيد بن عامر ح
 وحدثنا يونس بن حبيب قال ثنا ابو داود قالوا ثنا هشام الدستواءي عن يحيي بن ابي كثير عن عبد الله بن ابي قتادة عن ابيه ان النبي صلي الله عليه وسلم قال  ( لا تنبذوا الزهو والرطب جميعا ولا تنبذوا التمر والزبيب جميعا وانتبذوا كل واحد منهما علي حدته ) قال ابو امية ( علي حدة )
  حدثنا محمد بن عبد الله بن ميمون الاسكندراني ابو بكر بها والثقفي قالا ثنا الوليد بن مسلم عن الاوزاعي عن يحيي بن ابي كثير عن عبد الله بن ابي قتادة عن ابيه انه سمع النبي صلي الله عليه وسلم يقول ( لا تجمعوا بين الزهو والرطب ولا بين التمر والزبيب وانتبذوا كل واحد منهما علي حدته )
  حدثنا يحيي بن عياش القطان ببغداد في دار القطن قال ثنا ابو زيد الهروي قال ثنا علي بن المبارك عن يحيي بن ابي كثير قال حدثني ابو سلمة قال حدثني ابو قتادة ان رسول الله صلي الله عليه وسلم قال ( لا تنبذوا الزهو والرطب جميعا ولا تنبذوا التمر والزبيب جميعا وانتبذوا كل واحد علي حدته ) قال فسالت عن ذلك عبد الله بن ابي قتادة فاخبرني انه سمع ذاك من ابيه
  حدثنا الصغاني قال ثنا روح بن عبادة قال ثنا حسين المعلم قال ثنا يحيي بن ابي كثير بهذين الاسنادين انه قال ( الزهو والرطب والتمر والزبيب )
  حدثنا ابو داود السجزي وعثمان بن خرزاذ قالا ثنا ابو سلمة ح
 وحدثنا الصغاني قال ثنا عفان قال ثنا ابان العطار قثنا يحيي بن ابي كثير قال حدثني عبد الله بن ابي قتادة عن ابيه ان نبي الله صلي الله عليه وسلم نهي عن خليط التمر والبسر وعن خليط الزبيب والتمر وعن خليط الزهو والرطب وقال ( انتبذوا كل واحد منهما علي حدة ) 
 قال يحيي وحدثني ابو سلمة ابن عبد الرحمن عن ابي قتادة عن النبي صلي الله عليه وسلم بمثل هذا الحديث
  حدثنا الدبري عن عبد الرزاق قال انبا معمر عن يحيي بن ابي كثير عن عبد الله بن ابي قتادة عن ابيه قال نهي النبي صلي الله عليه وسلم عن الزهو والرطب وقال ( انتبذوا كل واحد منهما علي حدة )
 قال يحيي وحدثني ابو سلمة بن عبد الرحمن عن ابي قتادة عن النبي صلي الله عليه وسلم بمثله
  حدثنا الدبري عن عبد الرزاق قال انبا معمر عن يحيي بن ابي كثير عن عبد الله بن ابي قتادة عن ابيه قال نهي النبي صلي الله عليه وسلم عن الزهو والرطب ان يختلط وعن الزبيب والتمر ان يختلط وقال ( ينبذ كل واحد منهما وحده )
  حدثنا احمد بن يوسف السلمي قال ثنا النضر بن محمد قال ثنا عكرمة بن عمار قال ثنا ابو كثير الغبري قال سمعت ابا هريرة رضي الله عنه يقول قال رسول الله صلي الله عليه وسلم ( لا تنبذوا التمر والزبيب جميعا ولا البسر والتمر جميعا وانبذوا كل واحد منهما علي حدة )
  حدثنا يوسف بن يعقوب قال ثنا ابو الوليد قال ثنا عكرمة باسناده مثله ( ولينبذوا كل واحد منهما علي حدته )
 قال ابو داود السجزي ابو كثير السحيمي يزيد بن عبد الرحمن بن اذينة وقالوا ابن عقيلة وهو اصح من اذينة
  حدثنا علي بن حرب الطاءي قال ثنا اسباط قال ثنا ابو اسحاق الشيباني عن حبيب عن سعيد بن جبير عن ابن عباس رضي الله عنهما قال كتب رسول الله صلي الله عليه وسلم الي اهل جرش ينهاهم ان يخلطوا التمر والزبيب  ورواه علي بن حرب وقال حبيب بن ابي ثابت
  حدثنا علي بن اسماعيل علويه بثلاثة ابواب قثنا عمرو بن عون قال انبا خالد عن الشيباني عن حبيب بن ابي عمرة عن سعيد بن جبير عن ابن عباس قال نهي النبي صلي الله عليه وسلم عن الدباء والحنتم والنقير والمزفت
  حدثنا علويه الكرابيسي قال ثنا عمرو بن عون قال ثنا خالد عن الشيباني عن حبيب بن ابي ثابت عن سعيد بن جبير عن ابن عباس نهي النبي صلي الله عليه وسلم بمثله
  حدثنا الحسن بن عفان العامري قال نا اسباط بن محمد عن الشيباني عن حبيب بن ابي ثابت عن سعيد بن جبير عن ابن عباس قال نهي رسول الله صلي الله عليه وسلم عن البسر والتمر ان يخلطا جميعا وعن الزبيب والتمر ان يخلطا جميعا قال وكتب الي اهل جرش لا يخلطوا التمر والزبيب
  حدثنا عباس بن محمد الدوري وساله ابن اورمة قال ثنا ابو سعيد الحداد قال ثنا خالد بن عبد الله عن حصين عن حبيب بن ابي ثابت وعن الشيباني عن حبيب بن ابي ثابت عن سعيد بن جبير عن ابن عباس قال كتب رسول الله صلي الله عليه وسلم الي اهل جرش ان لا يخلطوا التمر بالزبيب وفي حديث حصين ابن حبيب وكتب رسول الله صلي الله عليه وسلم الي اهل البحرين لا يخلطوا التمر بالزهو يعني الفضيخ
  حدثنا يوسف بن مسلم قال ثنا حجاج عن ابن جريج قال اخبرني موسي بن عقبة عن نافع عن ابن عمر رضي الله عنهما انه كان يقول نهي ان ينبذ البسر والرطب جميعا والبسر والزبيب جميعا قال نافع وكان ابن عمر يامر بتمر وزبيب فينبذا جميعا فيشرب منه
  حدثنا الصغاني قال ثنا روح بن عبادة قال ثنا ابن جريج  بمثله
  حدثنا ابو الازهر وعلي بن حرب قال ثنا معاوية بن عمر وقال ثنا زاءدة عن حبيب بن ابي عمرة عن سعيد بن جبير عن ابن عباس قال نهي رسول الله صلي الله عليه وسلم عن الدباء والحنتم والمزفت والنقير وان يخلط البلح بالزهو
  حدثنا علي بن حرب قال ثنا ابن فضيل عن حبيب بن ابي عمرة عن سعيد بن جبير عن ابن عباس قال نهي رسول الله صلي الله عليه وسلم عن الدباء والحنتم والمزفت وان يخلط البلح بالزهو
