  حدثنا احمد بن محمد بن نافع قال حدثنا الحسين بن الفضل بن ابي حديدة الواسطي قال حدثنا ابراهيم بن عيينة قال حدثنا عبد الله بن عطية العوفي عن اخيه الحسن بن عطية عن ابيه عطية العوفي عن ابي سعيد الخدري قال قال رسول الله * يتبع الرجل من الحسنات يوم القيامة امثال الجبال فيقول اني هذا فيقال باستغفار ولدك لك لم يرو هذا الحديث عن عبد الله بن عطية الا ابراهيم بن عيينة
  حدثنا احمد بن محمد بن نافع قال حدثنا عبد الملك بن شعيب بن الليث قال حدثنا عبد الله بن وهب قال حدثني الليث بن سعد عن شريك بن عبد الله النخعي عن حسين بن عبد الله عن عكرمة عن بن عباس قال * كان رسول الله يصلي في الثوب الواحد لم يرو هذا الحديث عن الليث الا بن وهب تفرد به عبد الملك بن شعيب
  حدثنا احمد بن محمد بن نافع قال حدثنا ابو الطاهر بن السرح قال حدثنا اسماعيل بن ابي اويس قال حدثنا مالك بن انس عن هشام بن عروة عن ابيه  عن عبد الله بن عمرو قال قال رسول الله * ان الشيطان ياتي احدكم فيقول من خلق السماء فيقول الله فيقول من خلق الارض فيقول الله فيقول من خلق الله فاذا وجد ذلك احدكم فليقل امنت بالله ورسوله لم يرو هذا الحديث عن هشام بن عروة عن ابيه عن عبد الله بن عمرو الا مالك ولا عن مالك الا بن ابي اويس تفرد به ابو الطاهر بن السرح ورواه الناس عن هشام بن عروة عن ابيه عن ابي هريرة
  حدثنا احمد بن محمد بن نافع قال حدثنا احمد بن صالح قال حدثنا بن ابي فديك قال حدثنا موسي بن يعقوب عن عبد الرحمن بن اسحاق بن عبد الله بن ابي طلحة عن انس بن مالك ان رسول الله قال * من كذب علي متعمدا فليتبوا مقعده من النار لم يرو هذا الحديث عن اسحاق بن عبد الله الا عبد الرحمن بن اسحاق ولا عن عبد الرحمن الا موسي بن يعقوب ولا عن موسي الا بن ابي فديك تفرد به احمد بن صالح
  حدثنا احمد بن محمد بن نافع قال حدثنا ابو مصعب الزهري قال حدثنا الدراوردي عن عمرو بن يحيي عن ابيه عن ابي سعيد الخدري قال * اختصم رجلان في نخلة فقطع رسول الله جريدة من جراءدها فوجد ذرعها خمسة اذرع فجعلها حريمها لم يرو هذا الحديث عن عمرو بن يحيي الا الدراوردي
  حدثنا احمد بن محمد بن نافع قال حدثنا مءمل بن اهاب قال حدثنا عثمان بن سعيد بن كثير بن دينار قال اخبرنا محمد بن عبد الرحمن بن عرق  اليحصبي عن ابيه عن النعمان بن بشير قال * اهدي لرسول الله عنب من الطاءف فاعطاني عنقودا وقال اذهب به الي امك فاكلته في الطريق فقال ما فعل العنقود فقلت اكلته فسماني غدر قال وكان النعمان يقول علي منبره الا ان البلية كل البلية ان تعمل اعمال السوء في ايمان السوء لا يروي هذا الحديث عن النعمان بن بشير الا بهذا الاسناد تفرد به محمد بن عبد الرحمن بن عرق
  حدثنا احمد بن محمد بن نافع قال حدثنا احمد بن صالح قال قرات علي عبد الله بن نافع قال حدثنا بن ابي ذءب عن هشام بن عروة عن ابيه عن عاءشة عن النبي قال * اذا مرض المءمن اخلصه ذلك كما يخلص الكير خبث الحديد لم يرو هذا الحديث عن هشام بن عروة الا بن ابي ذءب تفرد به عبد الله بن نافع
  حدثنا احمد بن محمد بن نافع قال حدثنا مءمل بن اهاب قال حدثنا زيد بن الحباب قال حدثنا الحسين بن واقد عن حصين بن عبد الرحمن عن ابي واءل عن عبد الله بن مسعود قال قال رسول الله * اتاني جبريل عليه السلام في خضر معلق به الدر لم يرو هذا الحديث عن حصين الا الحسين بن واقد تفرد به زيد بن الحباب
  حدثنا احمد بن محمد بن نافع قال حدثنا احمد بن صالح قال حدثنا عبد الملك بن عبد الرحمن الذماري قال حدثنا سفيان الثوري عن محمد بن المنكدر  عن جابر بن عبد الله قال * سمعت رسول الله يقرا ايحسب ان ماله اخلده لم يرو هذا الحديث عن سفيان الا الذماري
  حدثنا احمد بن محمد بن نافع قال حدثنا احمد بن صالح قال حدثنا اسماعيل بن ابي اويس قال حدثني اخي عن سليمان بن بلال عن ربيعة بن عبد الرحمن عن عراك بن مالك عن ابي بكر بن عبد الرحمن بن الحارث عن هشام عن ام سلمة زوج النبي * ان النبي كان يصبح جنبا من نكاح غير احتلام لم يرو هذا الحديث عن ربيعة الا سليمان بن بلال تفرد به بن ابي اويس عن اخيه
  حدثنا احمد بن محمد بن نافع قال حدثنا احمد بن صالح قال حدثنا يحيي بن محمد الحازمي قال حدثنا اسماعيل بن ثابت بن مجمع عن يحيي بن سعيد الانصاري عن انس بن مالك انه مسح علي الخفين وذكر انس * ان رسول الله مسح علي الخفين لم يرو هذا الحديث عن يحيي بن سعيد الا اسماعيل بن ثابت ولا عن اسماعيل  الا يحيي الحازمي تفرد به احمد بن صالح
  حدثنا احمد بن محمد بن نافع قال حدثنا ابو مصعب قال حدثنا عبد العزيز بن محمد الدراوردي عن كثير بن زيد عن عبد الله بن عامر عن بنت نبيط عن انس بن مالك قال قال رسول الله * احد جبل يحبنا ونحبه فاذا جءتموه فكلوا من شجره ولو من عضاهه لم يرو هذا الحديث عن زينب بنت نبيط الا بهذا الاسناد تفرد به الدراوردي
  حدثنا احمد بن محمد بن نافع قال حدثنا ابو مصعب قال حدثنا صالح بن قدامة عن عبد الله بن دينار عن نافع عن بن عمر قال * نهي رسول الله ان نسافر بالقران الي ارض العدو مخافة ان يناله العدو
  وعن بن عمر قال قال رسول الله * ان احدكم اذا مات عرض عليه مقعده بالغداة والعشي ان كان من اهل الجنة او من اهل النار يقال هذا مقعدك حتي يبعثك الله منه
  وعن نافع عن بن عمر قال حدثتني صفية بنت ابي عبيد عن حفصة او عاءشة او عنهما كلتيهما ان رسول الله قال * لا يحل لامراة تءمن بالله واليوم الاخر ان تحد علي ميت فوق ثلاث الا علي زوجها لم يرو هذه الاحاديث عن عبد الله بن دينار الا صالح بن قدامة
  حدثنا احمد بن محمد بن نافع قال حدثنا محمد بن ميمون الاسكندراني قال حدثنا عبد الله بن يحيي البرلسي قال حدثنا حيوة بن شريح عن  يزيد بن عبد الله بن الهاد عن مالك بن انس عن نافع عن بن عمر انه سمع رسول الله يقول * لا يحتلب احد ماشية احد بغير اذنه ايحب احدكم ان تءتي مشربته فتكسر خزانته فينتشل طعامه فانما تخزن لهم ضروع مواشيهم اطعماتهم فلا يحلبن احد ماشية احد الا بامره لم يرو هذا الحديث عن يزيد بن عبد الله بن الهاد الا حيوة بن شريح وبكر بن مضر تفرد به عن حيوة عبد الله بن يحيي وعن بكر بن مضر ابنه اسحاق بن بكر
  حدثنا احمد بن محمد بن نافع قال حدثنا علي بن زيد الفراءضي المصيصي قال حدثنا اسحاق بن ابراهيم الحنيني قال حدثنا مالك بن انس عن بن شهاب عن عروة عن عمرة عن عاءشة قالت سمعت رسول الله يقول * القطع في ربع دينار فصاعدا
  حدثنا احمد بن محمد بن نافع قال حدثنا علي بن زيد الفراءضي قال حدثنا اسحاق بن ابراهيم الحنيني قال حدثنا مالك بن انس عن بن شهاب عن الاعرج عن ابي هريرة قال قال رسول الله * لا يجتمع غبار في سبيل الله ودخان جهنم في جوف امرء مسلم لم يرو هذين الحديثين عن مالك الا الحنيني
  حدثنا احمد بن محمد بن نافع قال حدثنا احمد بن صالح قال حدثنا بن ابي فديك قال حدثنا زكريا بن ابراهيم عن ابيه قال  سمعت بن عمر يقول قال رسول الله * ما اصبنا من دنياكم هذه الا نساءكم لا يروي هذا الحديث عن بن عمر الا بهذا الاسناد تفرد به بن ابي فديك
  حدثنا احمد بن محمد بن نافع قال حدثنا ابو الطاهر بن السرح قال وجدت في كتاب خالي حدثني عقيل بن خالد عن بن شهاب قال حدثني سعيد بن سليمان عن ابيه سليمان بن زيد بن ثابت عن جده زيد بن ثابت قال * كنت اكتب الوحي لرسول الله وكان اذا نزل عليه اخذته برحاء شديدة وعرق عرقا شديدا مثل الجمان ثم سري عنه فكنت ادخل عليه بقطعة الكتف او كسرة فاكتب وهو يملي علي فما افرغ حتي تكاد رجلي تنكسر من ثقل القران وحتي اقول لا امشي علي رجلي ابدا فاذا فرغت قال اقراه فاقراه فان كان فيه سقط اقامة ثم اخرج به الي الناس
  وعن بن شهاب ان سالم بن عبد الله اخبره عن عبد الله بن عمر عن رسول الله انه قال * توضءوا مما مست النار
  وعن بن شهاب عن عبد الرحمن بن سعد المقعد عن عبد الرحمن بن الحارث بن هشام عن ابيه * قال قلت يا رسول الله حدثني بامر اعتصم به فقال املك  عليك هذا واشار الي لسانه
  وعن بن شهاب ان عبد الرحمن بن ازهر حدثه عن ابيه * ان رسول الله اتي بشارب وهو بخيبر فحثا في وجهه التراب ثم امر اصحابه فضربوه بنعالهم وبما كان في ايديهم حتي قال لهم ارفقوا فرفقوا فتوفي رسول الله وتلك سنته ثم جلد ابو بكر في الخمر اربعين ثم جلد عمر اربعين صدرا من امارته ثم جلد ثمانين في اخر خلافته ثم جلد عثمان الحد اربعين ثم معاوية الحد اربعين
  وعن بن شهاب عن عبيد الله بن عبد الله بن عمر عن ابيه انه سمع رسول الله يقول * مفاتيح الغيب خمس ثم يتلو هذه الاية ان الله عنده علم الساعة وينزل الغيث ويعلم ما في الارحام وما تدري نفس ماذا تكسب غدا وما تدري نفس باي ارض تموت ان الله عليم خبير
  حدثنا احمد بن محمد بن نافع قال حدثنا ابو الطاهر بن السرح قال وجدت في كتاب خالي حدثني عقيل بن خالد عن بن شهاب عن عبيد الله بن عبد الله بن عتبة ان اباه كتب اليه ان الق سبيعة الاسلمية فسلها كيف قضي لها رسول الله قال فاخبرني مالك بن اوس بن الحدثان ان سبيعة الاسلمية اخبرته * ان زوجها سعد بن خولة توفي عنها بمكة مع رسول الله في حجة الوداع وهي حامل فلم تلبث بعده الا يسيرا حتي وضعت فخطبها ابو السنابل بن بعكك بن السباق من بني عبد الدار فابت ان  تنكحه فقال اما انك لا تحلين حتي تعتدي اخر الاجلين فاستفتت رسول الله فاذن لها بالنكاح لم يرو هذا الحديث عن عقيل الا خال ابي الطاهر بن سرح وثيمة بن موسي بن ربيعة
  حدثنا احمد بن محمد بن نافع قال حدثنا ابو الطاهر بن السرح قال حدثنا بشر بن بكر عن الاوزاعي عن ابي حميدة الظاعني عن عروة البارقي قال قال رسول الله * الخيل معقود في نواصيها الخير الي يوم القيامة لم يرو هذا الحديث عن الاوزاعي الا بشر بن بكر تفرد به ابو الطاهر
  حدثنا احمد بن محمد بن نافع قال حدثنا عبيد الله بن عبد الله المنكدري قال حدثنا بن ابي فديك عن محمد بن ابي قدامة عن محمد بن عجلان عن ابي اسحاق الهمداني عن عمرو بن اوس عن عنبسة بن ابي سفيان عن ام حبيبة زوج النبي ان النبي قال * من صلي ثنتي عشرة ركعة بني الله له بيتا في الجنة اربعة قبل الظهر وثنتين بعدها وثنتين قبل العصر وثنتين قبل الصبح  لم يرو هذا الحديث عن محمد بن قدامة الا بن ابي فديك تفرد به عبيد الله بن المنكدر
  حدثنا احمد بن محمد بن نافع قال حدثنا يحيي بن سليمان الجعفي قال حدثنا عبد الله بن المبارك عن سلمة بن نبيط عن ابيه قال * رايت النبي يخطب علي جمل احمر لم يرو هذا الحديث عن سلمة بن نبيط الا بن المبارك
  حدثنا احمد بن محمد بن نافع قال حدثنا ابو يوسف الجيزي قال حدثنا اسماعيل بن عياش عن بن جريج عن عطاء قال * كنت عند بن عباس فاتاه رجل فقال يا ابا عباس ما تقول في قال وما عسي ان اقول فيك قال اني عامل بقلم فقال سمعت رسول الله صلي الله عليه وسلم يقول يءتي بصاحب القلم يوم القيامة في تابوت من نار مقفل عليه باقفال من نار فان كان اجراه في طاعة الله ورضوانه فك عنه التابوت وان كان اجراه في معصية الله هوي به التابوت سبعين خريفا حتي باري القلم ولايق الدواة لم يرو هذا الحديث عن بن جريج الا اسماعيل بن عياش تفرد به ابو يوسف
  حدثنا احمد بن محمد بن نافع قال حدثنا احمد بن صالح قال حدثنا عبد الله بن وهب قال اخبرني عمرو بن الحارث عن عبد ربه بن سعيد عن عبد الله بن كعب الحميري  عن عمر بن ابي سلمة * انه سال رسول الله ايقبل الصاءم فقال له سل هذه لام سلمة فاخبرته ان رسول الله يصنع ذلك فقال له يا رسول الله قد غفر الله لك ما تقدم من ذنبك وما تاخر فقال رسول الله اني لاتقاكم لله واعلمكم بحدوده لم يرو هذا الحديث عن عمر بن ابي سلمة عن امه ام سلمة الا بهذا الاسناد تفرد به عمرو بن الحارث
  حدثنا احمد بن محمد بن نافع قال حدثنا احمد بن صالح قال حدثنا عبد الله بن وهب قال اخبرني اسامة بن زيد ان محمد بن حمزة بن عمرو الاسلمي حدثه انه سمع اباه حمزة يقول قال رسول الله * علي سنام كل بعير شيطان فاذا ركبتموها فسبحوا الله ولا تقصروا عن حاجتكم لم يرو هذا الحديث عن محمد بن حمزة الا اسامة بن زيد الليثي
  حدثنا احمد بن محمد بن نافع قال حدثنا خالد بن عبد السلام الصدفي قال حدثنا عبد الله بن وهب قال حدثني بن لهيعة وعمرو بن الحارث عن يزيد بن ابي حبيب عن سنان بن سعد عن انس بن مالك ان رسول الله قال * ان الاسلام بدا غريبا وسيعود غريبا كما بدا فطوبي للغرباء لم يرو هذا الحديث عن عمرو بن الحارث الا بن وهب
  حدثنا احمد بن محمد بن نافع قال حدثنا احمد بن صالح قال حدثنا محمد بن طلحة التيمي قال حدثنا ابو سهيل بن مالك عن سعيد بن المسيب عن سعد بن ابي وقاص قال * خرج رسول الله يجهز جيشا فنظر الي العباس فقال هذا العباس عم نبيكم اجود قريش كفا واوصلها  لم يرو هذا الحديث عن سعيد بن المسيب الا ابو سهيل بن مالك
  حدثنا احمد بن محمد بن نافع قال حدثنا احمد بن صالح قال حدثنا عبد الله بن وهب قال اخبرني حيوة بن شريح عن عبد العزيز بن مليل عن عبد الرحمن بن ابي امية * ان حبيب بن مسلمة اتي قيس بن سعد بن عبادة في الفتنة الاولي وهو علي فرس فتاخر له عن السرج فقال له اركب فابي ان يركب فقال قيس اني سمعت رسول الله يقول صاحب الدابة احق بصدرها فقال حبيب اني لست اجهل ما قال رسول الله ولكني اخشي عليك لا يروي هذا الحديث عن حبيب بن مسلمة الا بهذا الاسناد تفرد به بن وهب
  حدثنا احمد بن محمد بن نافع قال حدثنا ابو عبيد الله بن عبد الرحمن بن وهب قال حدثنا عبد الله بن وهب قال حدثنا عبد الله بن عياش عن ابي رزين الغافقي عن عبد الله بن عمرو بن العاص ان رسول الله قال * ان الذين يمر بين يدي الرجل وهو يصلي عمدا يتمني يوم القيامة انه شجرة يابسة لا يروي هذا الحديث عن عبد الله بن عمرو الا بهذا الاسناد تفرد به بن وهب
  حدثنا احمد بن محمد بن نافع قال حدثنا عبيد الله بن عبد الله بن المنكدر قال حدثنا محمد بن اسماعيل بن ابي فديك عن سليمان بن داود بن قيس عن ابيه عن موسي بن عقبة عن الزهري عن عيسي بن طلحة  عن عبد الله بن عمرو بن العاص قال * خطب رسول الله الناس في حجة الوداع فحمد الله واثني عليه ثم قال يا ايها الناس خذوا مناسككم فاني لا ادري لعلي غير حاج بعد عامي هذا لم يرو هذا الحديث عن موسي بن عقبة الا داود بن قيس ولا عن داود الا ابنه سليمان ولا عن سليمان الا بن ابي فديك تفرد به المنكدري
  حدثنا احمد بن محمد بن نافع قال حدثنا احمد بن صالح قال حدثنا حرمي بن عمارة قال حدثنا شعبة عن قتادة عن انس قال قال رسول الله * من كذب علي متعمدا فليتبوا مقعده من النار لم يرو هذا الحديث عن شعبة الا حرمي بن عمارة وابو داود الطيالسي
  حدثنا احمد بن محمد بن نافع قال حدثنا عبد الصمد بن الفضل بن خالد الربعي قال حدثنا عبد الله بن وهب قال اخبرني بن لهيعة عن مشرح بن هاعان عن عقبة بن عامر الجهني قال قال رسول الله * لعن الله الذين ياتون النساء في محاشهن لم يرو هذا الحديث عن بن لهيعة الا بن وهب تفرد به عبد الصمد بن الفضل
  حدثنا احمد بن محمد بن نافع قال حدثنا ابو يوسف الجيزي قال حدثنا عبد الله بن وهب قال اخبرني بن لهيعة عن ابي الاسود عن عروة بن الزبير قال * عجبت لقوم طلبوا هذا العلم حتي اذا نالوا منه صاروا حضانا لابناء الملوك 
  حدثنا احمد بن محمد بن نافع قال حدثنا احمد بن صالح قال حدثنا عبد الله بن وهب قال اخبرني بن لهيعة وعمرو بن الحارث عن يزيد بن عمرو المعافري عن ابي عبد الرحمن الحبلي عن عبد الله بن عمرو بن العاص ان رسول الله قال * من صمت نجا
  حدثنا احمد بن محمد بن نافع قال حدثنا عبيد الله بن عبد الله المنكدري قال حدثنا محمد بن اسماعيل بن ابي فديك عن عثمان بن عبد الرحمن الوقاصي عن الزهري عن انس بن مالك قال قال رسول الله * من سره ان يسلم فليلزم الصمت لم يرو هذا الحديث عن الزهري الا عثمان بن عبد الرحمن تفرد به بن ابي فديك
  حدثنا احمد بن محمد بن نافع قال حدثنا عبيد الله بن عبد الله المنكدري قال حدثنا بن ابي فديك عن عمر بن ابي سهل عن الحسن عن انس بن مالك قال قال رسول الله * من علم ابنه القران نظرا غفر الله له ما تقدم من ذنبه وما تاخر ومن علمه اياه ظاهرا بعثه الله يوم القيامة علي صورة القمر ليلة البدر ويقال لابنه اقرا فكلما قرا اية رفع الله عز وجل بها للاب درجة حتي ينتهي الي اخر ما معه من القران لم يرو هذا الحديث عن الحسن الا عمر بن سهل تفرد به بن ابي فديك
  حدثنا احمد بن محمد بن نافع قال حدثنا عبيد الله بن عبد الله المنكدري قال حدثني ابي عن ابيه عن جده عن عبد الرحمن بن يعقوب الحرمي عن ابي هريرة قال قال رسول الله صلي الله عليه وسلم ا * اذا انتصف  شعبان فافطروا لم يرو هذا الحديث عن محمد بن المنكدر الا ابنه المنكدر تفرد به ابنه عبد الله
  حدثنا احمد بن محمد بن نافع قال حدثنا ابو الطاهر بن السرح قال حدثنا خالد بن نزار قال حدثني عمرو بن قيس عن الزهري عن عبيد الله بن عبد الله بن عتبة ان عبد الله بن عباس اخبره * انه كان يقرء عبد الرحمن بن عوف فذكر حديث السقيفة بطوله وذكر فيه ان رسول الله قال لا تطروني كما اطرت النصاري عيسي فانما انا عبد الله ورسوله فقولوا عبد الله ورسوله وقال رجم رسول الله ورجمنا معه لم يرو هذا الحديث عن عمرو بن قيس الا خالد بن نزار
  حدثنا احمد بن محمد بن نافع قال حدثنا محمد بن داود بن ابي ناجية الاسكندراني قال حدثنا زياد بن يونس قال حدثني محمد بن جعفر بن ابي كثير عن يعقوب بن زيد عن بن شهاب عن عبيد الله بن عبد الله بن عتبة بن مسعود قال * كان عبد الله بن عباس اذا صلي عن الجناءز وهو امام كبر ثم يقرا بام القران ثم يصلي علي النبي ثم يكبر ثم ينصرف لم يرو هذا الحديث عن الزهري الا يعقوب بن زيد ولا عن يعقوب الا محمد بن جعفر تفرد به زياد بن يونس
  حدثنا احمد بن محمد بن نافع قال حدثنا عيسي بن ابراهيم بن الغافقي قال حدثنا عبد الله بن وهب عن زيد بن الحباب عن ابي المنيب عن عبد الله بن بريدة  عن ابيه * ان رسول الله نهي ان يصلي الرجل في السراويل ليس عليه غيره لا يروي هذا الحديث عن بريدة الا بهذا الاسناد تفرد به بن وهب
  حدثنا احمد بن محمد بن نافع قال حدثنا مءمل بن اهاب قال حدثنا النضر بن محمد الجرشي قال حدثنا عكرمة بن عمار عن صالح بن ابي الاخضر عن الزهري قال * دخلت علي انس بن مالك فسطاطه في خلافة عبد الملك فقلت له اني ارجو ان تكون انما اخرك الله لتكون شهيدا علي هذه الامة قال فاني اشهد انهم امسوا واصبحوا مخالفين لمن كان قبلهم لانهم يصلون وفي الصلاة تاخير لم يرو هذا الحديث عن عكرمة بن عمار الا النضر بن محمد
  حدثنا احمد بن محمد بن نافع قال حدثنا احمد بن صالح قال حدثنا عبد الله بن وهب قال اخبرني اسامة بن زيد الليثي عن حميد الطويل عن انس قال قال رسول الله * اذا اراد الله بعبد خيرا استعمله ثم صمت فقالوا في ماذا يا رسول الله قال يستعمله عملا صالحا قبل ان يموت لم يروه عن اسامة الا بن وهب
  حدثنا احمد بن محمد بن نافع قال حدثنا احمد بن صالح قال حدثنا عبد الله بن وهب قال اخبرني عمرو عن بكير عن بن المسيب عن ابي هريرة عن رسول الله قال * كل حسنة يعملها بن ادم بعشر امثالها الي سبعماءة ضعف الا الصيام هو لي وانا اجزي به لم يروه عن بكير الا عمرو
  حدثنا احمد بن محمد بن نافع قال حدثنا احمد بن صالح قال حدثنا  بن ابي فديك قال اخبرني يونس بن حمران عن خارجة بن عبد الله بن سعد بن ابي وقاص عن ابيه قال قال لي ابو ايوب الانصاري * الا اعلمك كلمة علمنيها رسول الله قلت بلي يا عم قال ان رسول الله حين نزل علي قال الا اعلمك كلمة من كنز الجنة قلت بلي يا رسول الله بابي انت وامي قال اكثر من قول لا حول ولا قوة الا بالله لم يرو هذا الحديث عن خارجة بن عبد الله الا يونس بن حمران تفرد به بن ابي فديك
  حدثنا احمد بن عمرو القطراني قال حدثنا ابو الربيع الزهراني قال حدثنا محمد بن حازم ابو معاوية قال حدثنا اشعث بن سوار عن الزهري عن عطاء بن يزيد الليثي عن ابي ايوب الانصاري رفعه قال * الوتر واجب علي كل مسلم فمن استطاع ان يوتر بخمس ومن لم يستطع ان يوتر بخمس فليوتر بواحدة ومن لم يستطع ان يوتر بواحدة فليومء ايماء لم يرو هذا الحديث عن اشعث الا ابو معاوية
  حدثنا احمد بن عمرو القطراني قال حدثنا ابو الربيع الزهراني قال حدثنا محمد بن حازم ابو معاوية قال حدثنا السري يحيي عن المعلي بن زياد عن الحسن  عن ابي ذر * انه لقي عمر بن الخطاب فاخذ بيده فغمزها وكان عمر رجلا شديدا فقال ارسل يدي يا قفل الفتنة فقال عمر وما قفل الفتنة قال جءت رسول الله ذات يوم ورسول الله جالس وقد اجتمع عليه الناس فجلست في اخرهم فقال رسول الله لا تصيبكم فتنة ما دام هذا فيكم لم يرو هذا الحديث عن السري بن يحيي الا ابو معاوية
  حدثنا احمد بن عمرو القطراني قال حدثنا ابو الربيع الزهراني قال حدثنا عبد الله بن المبارك قال حدثنا ابو سلمة عن قتادة عن ابي بردة عن ابي موسي قال * لو رايتنا مع نبينا لحسبت انما ريحنا ريح الضان انما لباسنا الصوف وطعامنا الاسودان الماء والتمر ابو سلمة هو محمد بن ابي حفصة لم يرو هذا الحديث الا بن المبارك
  حدثنا احمد بن عمرو القطراني قال حدثنا ابو الربيع الزهراني قال حدثنا عبد الله بن المبارك عن يعقوب بن القعقاع عن قتادة عن سعيد بن المسيب ان معاوية بن ابي سفيان قال * يا ايها الناس انهاكم عن الزور وجاء بخرقة سوداء فالقاها بين ايديهم وقال هو هذا تجعله المراة في راسها لم يرو هذا الحديث عن يعقوب بن القعقاع الا بن المبارك
  حدثنا احمد بن عمرو القطراني قال حدثنا هدبة بن خالد قال حدثنا حماد بن زيد قال حدثنا المعلي بن زياد عن الحسن  عن انس بن مالك قال قال رسول الله * ان الله تبارك وتعالي يءيد هذا الدين باقوام لا خلاق لهم لم يرو هذا الحديث عن المعلي بن زياد الا حماد بن زيد تفرد به هدبة
  حدثنا احمد بن عمرو قال حدثنا ابو حفص عمرو بن علي قال حدثنا ابو داود الطيالسي قال حدثنا بسطام بن مسلم قال حدثنا مالك بن دينار عن عطاء عن جابر * ان النبي خطبهم فقال ان العمري جاءزة
  وعن جابر ان النبي قال * لا تخلطوا الزبيب والتمر ولا البسر والتمر يعني النبيذ لم يرو هذين الحديثين عن مالك بن دينار الا بسطام بن مسلم تفرد بهما ابو داود
  حدثنا احمد بن عمرو قال حدثنا عبد الواحد بن غياث قال حدثنا حماد بن سلمة عن محمد بن واسع وابي سورة عن الاعمش عن ابي صالح عن ابي هريرة ان رسول الله قال * من نفس عن اخيه كربة من كرب الدنيا نفس الله عنه كربة من كرب الاخرة والله في عون العبد ما كان العبد في عون اخيه لم يرو هذا الحديث عن ابي سورة الا حماد بن سلمة
  حدثنا احمد بن عمرو قال حدثنا علي بن ابي طالب البزاز قال حدثنا عبد المنعم بن نعيم الرياحي قال حدثنا يحيي بن مسلم عن الحسن  وعن عطاء بن ابي رباح عن جابر بن عبد الله الانصاري ان رسول الله قال لبلال * اذا اذنت فترسل في اذانك واذا اقمت فاحذم واجعل بين اذانك واقامتك قدر ما يفرغ الاكل من اكله والشارب من شربه والمعتصر اذا دخل لقضاء حاجته ولا تقوموا حتي تروني
  حدثنا احمد بن عمرو القطراني قال حدثنا ابراهيم بن بشار الرمادي قال حدثنا سفيان بن عيينة عن ايوب بن عاءذ الطاءي عن قيس بن مسلم عن طارق بن شهاب قال * جاء اهل الردة من اسد وغطفان الي ابي بكر بعد رسول الله يسالونه الصلح فقال علي ان ننزع منكم الحلقة والكراع وتتركون تتبعون اذناب البقر حتي يري الله عز وجل خليفة نبيه صلي الله عليه وسلم ا والمءمنين رايا يعذرونكم به وتشهدون ان قتلانا في الجنة وقتلاكم في النار وتدون قتلانا ولا ندي قتلاكم فقال عمر يا خليفة رسول الله القول كما قلت غير ان قتلانا قتلوا في سبيل الله لادية لهم لم يرو هذا الحديث عن ايوب بن عاءذ الا سفيان بن عيينة
  حدثنا احمد بن عمرو قال حدثنا زياد بن يحيي ابو الخطاب قال حدثنا سهل بن داود ابو عتاب الدلال قال حدثنا عمرو بن ثابت قال حدثني حبيب بن ابي ثابت قال * صنعت امراة من نساء الحسين بن علي طعاما في بعض ارضيه فطعم فرفع  الطعام فجاء مولي له فدعا بالطعام فقال يا ابا عبد الله لا اريده قال لم قال اكلنا قبيل عند عبيد الله بن العباس فقال الحسين ان اباه كان سيد قريش ان رسول الله قال يا بني عبد المطلب اطعموا الطعام لم يرو هذا الحديث عن حبيب الا عمرو بن ثابت تفرد به ابو عتاب
  حدثنا احمد بن عمرو قال حدثنا محمد بن موسي الحرشي قال حدثنا عبد الله بن جعفر المدني قال حدثنا منصور بن زياد مولي عثمان بن عفان عن عمرو بن شعيب عن ابيه عن جده قال قال رسول الله * لن يءمن عبد حتي يءمن بالقدر خيره وشره ويعلم ان ما اصابه لن يكن ليخطءه وما اخطاه لم يكن ليصيبه لم يرو هذا الحديث عن منصور بن زيد الا عبد الله بن جعفر
  حدثنا احمد بن عمرو قال حدثنا احمد بن عبيد الله الغداني قال حدثنا يعلي بن ميمون قال حدثنا مطر الوراق عن عبد الله بن بريدة عن ابيه * ان النبي رخص في نبيذ الجر بعد ما نهي عنه
  حدثنا احمد بن عمرو قال حدثنا عبد الله بن المثني اخو ابي موسي قال حدثنا عمرو بن شقيق بن عبد الله بن عمير السدوسي قال حدثني ابي عن جدي * انه جاء باداوة من عند النبي قد غسل النبي فيها وجهه ومضمض فيه وبزق في الماء وغسل يديه وذراعيه ثم ملا الاداوة وقال لا تردن ماء الا ملات الاداوة علي ما بقي فيها فاذا اتيت بلادك فرش به تلك البقعة واتخذه مسجدا قال فاتخذوه قال عمرو وقد صليت انا فيه  لا يروي هذا الحديث عن عبد الله بن عمير السدوسي الا بهذا الاسناد تفرد به عبد الله بن المثني
  حدثنا احمد بن عمرو قال حدثنا الحسن بن علي الواسطي قال حدثنا هشيم قال حدثنا سيار عن حفص بن عبيد الله عن انس قال * لما توفي عبد الرحمن بن زيد بن الخطاب فارادوا ان يخرجوه بالليل قال بن عمر لو اخرتموه حتي تصبحوا فاني سمعت رسول الله يقول انها تطلع بقرني شيطان لم يرو هذا الحديث عن سيار الا هشيم
  حدثنا احمد بن عمرو القطراني قال حدثنا الحسن بن علي الواسطي قال حدثنا هشيم عن اسماعيل بن سالم قال سمعت عامر الشعبي يقول سمعت ابا جحيفة يقول * اخبرك بافضل الامة بعد نبيها قلت نعم بابي وامي قال ابو بكر ثم قال يا ابا محمد اخبرك بافضل الامة بعد ابي بكر قلت نعم بابي وامي انت قال عمر بن الخطاب قال يا ابا جحيفة اخبرك بافضلها بعد عمر قلت نعم بابي وامي قال رجل اخر لم تسمه  لم يرو هذا الحديث عن اسماعيل بن سالم الا هشيم تفرد به الحسن بن علي
  حدثنا احمد بن عمرو القطراني قال حدثنا الحسن بن علي بن راشد الواسطي قال حدثنا هشيم قال حدثنا اسماعيل بن سالم قال حدثني علقمة بن واءل عن ابيه عن واءل بن حجر عن النبي * انه اتي برجل قتل قتيلا فدفع القاتل الي ولي المقتول ليقتله فلما انطلق به وفي عنقه نسعة قال النبي لجلساءه القاتل والمقتول في النار فانطلق رجل فذكر له ما قال رسول الله فخلي سبيله فلقد رايته حين خلي سبيله وهو منطلق يجر نسعته لم يرو هذا الحديث عن اسماعيل بن سالم الا هشيم
  حدثنا احمد بن عمرو قال حدثنا محمد بن يحيي الازدي قال حدثنا سعيد بن عامر الضبعي قال حدثنا شعبة عن مخول بن راشد عن ابي جعفر عن جابر بن عبد الله قال * كان النبي يتوضا بالمد ويغتسل بالصاع لم يرو هذا الحديث عن شعبة الا سعيد بن عامر
  حدثنا احمد بن عمرو بن دينار عن بن شهاب الزهري عن هند بنت الحارث عن ام سلمة قالت * استيقظ رسول الله ذات ليلة فرفع راسه الي  السماء وجعل يقلب بصرة ويقول سبحان الله ماذا انزل الليلة من الفتن وماذا فتح من الخزاءن ايقظوا صواحبات الحجر فرب كاسية في الدنيا عارية يوم القيامة لم يرو هذا الحديث عن يحيي بن سعيد وعمرو بن دينار الا سفيان بن عيينة
  حدثنا احمد بن عمرو قال حدثنا علي بن ابي طالب البزاز قال حدثنا موسي بن عمير الكوفي قال حدثنا الحكم بن عتيبة عن ابراهيم النخعي عن الاسود بن يزيد عن عبد الله بن مسعود قال قال رسول الله * حصنوا اموالكم بالزكاة وداووا مرضاكم بالصدقة واعدوا للبلاء الدعاء لم يرو هذا الحديث عن الحكم الا موسي بن عمير
  حدثنا احمد بن عمرو قال حدثنا محمد بن جامع العطار قال حدثنا حماد بن واقد الصفار قال حدثنا ثابت عن عبد الله بن رباح عن ابي قتادة * ان النبي صلي علي قبر بعد ما دفن لم يرو هذا الحديث عن ثابت عن عبد الله بن رباح عن ابي قتادة الا حماد بن واقد
  حدثنا احمد بن عمرو قال حدثنا الربيع الزهراني قال حدثنا حبان بن علي العنزي قال حدثنا ضرار بن مرة عن حصين بن المنذر المزني عن علي قال سمعت رسول الله يقول * لا يقطع الصلاة شء الا الحدث ولا استحييكم مما لم يستحي منه رسول الله الحدث ان يفسو او يضرط لم يرو هذا الحديث عن حصين بن المنذر الا ابو سنان ضرار بن مرة 
  حدثنا احمد بن عمرو قال حدثنا محمد بن الطفيل النخعي قال حدثنا شريك عن الاعمش عن حبيب بن ابي ثابت عن ابي الطفيل عن زيد بن ارقم قال نشد علي الناس من سمع رسول الله يقول يوم غدير خم * الستم تعلمون اني اولي بالمءمنين من انفسهم قالوا بلي قال فمن كنت مولاه فعلي مولاة اللهم وال من والاه وعاد من عاداه فقام اثنا عشر رجلا فشهدوا بذلك لم يرو هذا الحديث عن الاعمش الا شريك وابو عوانة
  حدثنا احمد بن عمرو القطراني قال حدثنا محمد بن الطفيل قال حدثنا شريك عن ابي اسحاق عن عكرمة عن بن عباس * في الرجل يشتري الاضحية او البدنة فيبيعها ويشتري اسمن منها فذكر رخصة لم يرو هذا الحديث عن ابي اسحاق الا شريك
  حدثنا احمد قال حدثنا محمد بن الطفيل قال حدثنا شريك عن ابي اسحاق عن جبلة بن حارثة ان النبي قال * اذا اويت الي فراشك فاقرا قل يا ايها الكافرون الي اخرها فانها براءة من الشرك
  وعن جبلة بن حارثة قال * كان النبي اذا لم يغز اعطي سلاحه عليا او اسامة  لم يرو هذين الحديثين عن ابي اسحاق الا شريك والاعمش
  حدثنا احمد بن عمرو قال حدثنا محمد بن الطفيل قال حدثنا شريك عن حريث عن الشعبي عن مسروق عن عاءشة * ان النبي كان يستدفء بها بعد الغسل لم يرو هذا الحديث عن الشعبي الا حريث
  حدثنا احمد بن عمرو قال حدثنا محمد بن الطفيل قال حدثنا شريك عن الاعمش عن المنهال بن عمرو عن عباد بن عبد الله عن علي وانذر عشيرتك الاقربين قال * جمع رسول الله ثلاثين رجلا علي قعب من لبن وان عامتهم لياكل الجذعة فاكلوا حتي شبعوا وشربوا حتي رووا لم يرو هذا الحديث عن الاعمش الا شريك وابو عوانة
  حدثنا احمد بن عمرو قال حدثنا محمد بن الطفيل قال حدثنا شريك عن اشعث بن سوار عن عدي بن ثابت عن البراء قال * رايت رسول الله حاملا الحسن بن علي علي عاتقه وهو يقول اللهم اني احب حسنا فاحبه لم يرو هذا الحديث عن اشعث الا شريك
  حدثنا احمد بن عمرو قال حدثنا محمد بن الطفيل قال حدثنا شريك عن قيس بن وهب عن ابي الوداك عن ابي سعيد الخدري رفعه قال قال يوم اوطاس * لا توطا ذات حمل حتي تضع حملها ولا غير ذات حمل حتي تحيض حيضة لم يرو هذا الحديث عن قيس بن وهب الا شريك
  حدثنا احمد بن عمرو قال حدثنا محمد بن الطفيل قال حدثنا شريك  عن عاصم عن زر عن حذيفة * انا اعطيناك الكوثر قال نهر في الجنة اجوف فيه انية من الذهب والفضة لا يعلمه الا الله لم يرو هذا الحديث عن عاصم الا شريك
  حدثنا احمد بن عمرو قال حدثنا محمد بن الطفيل قال حدثنا المطلب بن زياد عن ليث بن ابي سليم عن طاوس عن ابي هريرة قال قال رسول الله * انتم الغر المحجلون يوم القيامة من اثار الوضوء فمن استطاع منكم ان يطيل غرته فليفعل لم يرو هذا الحديث عن طاوس الا ليث تفرد به المطلب بن زياد
  حدثنا احمد بن عمرو القطراني قال حدثنا عبد الواحد بن غياث قال حدثنا مسكين بن عبد العزيز العطار قال ذكر ابي عن انس بن مالك لا اعلمه الا رفعه قال * لم يلق بن ادم شيءا منذ خلقه الله عز وجل اسد عليه من الموت ثم قال ان الموت اهون مما بعد وانهم ليلقون من هول ذلك اليوم شدة حتي يلجمهم العرق حتي لو ان السفن اجريت فيه لجرت لم يرو هذا الحديث عن عبد العزيز الا ابنه مسكين
  حدثنا احمد بن عمرو القطراني قال حدثنا عمرو بن مرزوق قال اخبرنا زهير بن معاوية عن ابي اسحاق عن الاسود وعلقمة * ان رجلا اتي بن مسعود فقال اني قرات المفصل في ركعة فقال عبد الله بل هذا كهذ الشعراء وكنثر الدقل لكن رسول الله لم يكن يفعل كما فعلت كان يقرا النظاءر الرحمن والنجم في ركعة بعشرين سورة من المفصل علي تاليف عبد الله اخرهن اذا الشمس كورت والدخان  لم يرو هذا الحديث عن ابي اسحاق الا زهير
  حدثنا احمد بن عمرو قال حدثنا عمرو بن مرزوق قال حدثنا زهير عن ابي اسحاق عن مصعب بن سعد عن سعد ان شاء الله عن النبي قال * ان عاءشة تفضل علي النساء كما يفضل الثريد علي ساءر الطعام لم يرو هذا الحديث عن ابي اسحاق الا زهير
  حدثنا احمد بن عمرو قال حدثنا ابو الربيع الزهراني قال حدثنا هشيم قال حدثنا اسماعيل بن سالم وحصين بن عبد الرحمن عن الشعبي ان عليا جلد شراحة يوم الخميس ورجمها يوم الجمعة وقال * جلدتها بكتاب الله ورجمتها بسنة رسول الله لم يرو هذا الحديث عن اسماعيل بن سالم الا هشيم
  حدثنا احمد بن عمرو قال نا عبد الاعلي بن حماد النرسي قال نا داود بن عبد الرحمن العطار قال نا هشام بن عروة عن ابيه وايوب السختياني عن القاسم بن محمد بن ابي بكر
 عن عاءشة قالت كان النبي صلي الله عليه وسلم يصلي وانا معترضة بين يديه لم يرو هذا الحديث عن ايوب الا داود العطار تفرد به عبد الاعلي بن حماد \  \
  حدثنا احمد بن عمرو قال نا ابو كامل الجحدري قال نا عبد العزيز بن المختار عن منصور بن عبد الرحمن قال نا الشعبي عن علقمة
 ان عبد الله بن مسعود كان يقوم قاءما كل عشية خميس فما سمعته في عشية  منها قال قال رسول الله صلي الله عليه وسلم غير مرة واحدة فنظرت اليه وهو معتمد علي عصا فنظرت الي العصا تزعزع
  حدثنا احمد بن عمرو قال نا ابو كامل الجحدري قال نا عبد العزيز بن المختار قال نا منصور بن عبد الرحمن قال حدثني الشعبي عن قرظة بن كعب الانصاري قال شيعنا عمر بن الخطاب حين خرجنا الي الكوفة ماشيا يقود حمارا او اتانا فقلنا يا امير المءمنين اقسمنا عليك لتركبن فابي حتي سرنا ثلاثة اميال او اربعة فقال بعضنا لبعض قد شققتم علي امير المءمنين فنزلنا فقال احدهم لم تروني بلغت معكم الي هذا المكان فقالوا اردت بذلك كرامتنا وحفظ الانصار قال ان ذاك كذلك ومع ذاك ما هو فقلت لا ندري فقال انكم ستاتون قوما يستطعمونكم اعراضا فاقلوا الرواية عن رسول الله وانا شريككم في ذلك لم يرو هذين الحديثين عن منصور بن عبد الرحمن الا عبد العزيز بن المختار \  \
  حدثنا احمد بن عمرو قال نا يحيي بن درست قال نا محمد بن ثابت قال نا يعقوب بن عطاء بن ابي رباح عن عمرو بن شعيب عن ابيه عن جده قال سءل رسول الله صلي الله عليه وسلم عن ضالة الابل فقال دعها معها الحذاء والسقاء تاكل من الشجر وتشرب من الماء حتي ياخذها ربها فقيل له ضالة الغنم فقال لك او لاخيك او للذءب فقيل يا رسول الله حريسة الجبل فقال غرمها ومثله معه وجلدات نكالا فان اواها المراح فما بلغ ثمن المجن ففيه القطع قالوا يا رسول الله والثمر المعلق قال غرمه ومثله معه وجلدات نكالا فاذا اواها الجرين فما بلغ ثمن المجن  ففيه القطع قالوا يا رسول الله فاللقطة توجد فقال ما كان في قرية مسكونة او طريق ميتاء فعرفه سنة فان وجدت والا فاستمتع بها قيل يا رسول الله فالركاز قال في الركاز الخمس لم يرو هذا الحديث عن يعقوب بن عطاء الا محمد بن ثابت وعبد العزيز بن مسلم القسمالي \  \
  حدثنا احمد بن عمرو القطراني قال نا محمد بن عبيد بن حساب قال نا حماد بن زيد عن المعلي بن زياد عن الحسن
 عن الاسود بن سريع قال بعث رسول الله صلي الله عليه وسلم سرية فلقوا العدو فتتابعوا في القتل حتي افضوا الي الولدان فلما رجعت السرية نمي ذلك الي النبي صلي الله عليه وسلم فقال الم انهكم فقالوا انما هم اولاد المشركين فقال او ليس خياركم اولاد المشركين ثم امر مناديا ينادي الا ان كل مولود يولد علي الفطرة لم يرو هذا الحديث عن المعلي بن زياد الا حماد بن زيد تفرد به بن حساب \  \
  حدثنا احمد بن عمرو قال نا ابو الربيع الزهراني قال نا محمد بن حازم وابو معاوية الضرير قال نا شبيب بن شيبة عن الحسن
 عن عمران بن الحصين قال قال رسول الله صلي الله عليه وسلم لابي كم تعبد اليوم الها قال سبعة ست في الارض وواحد في السماء قال فايهم تعد لرغبتك ورهبتك قال الذي في السماء فقال يا حصين اما انك ان اسلمت علمتك كلمتين تنفعانك قال فلما اسلم حصين اتي النبي صلي الله عليه وسلم فقال يا رسول الله علمني الكلمتين اللتين وعدتني قال فقال اللهم الهمني  رشدي واعذني من شر نفسي لم يرو هذا الحديث عن شبيب بن شيبة الا معاوية \  \
  حدثنا احمد بن عمرو قال نا ابو الربيع الزهراني قال نا عبد الله بن المبارك عن الحسن بن جبير او بن كثير شك ابو الربيع عن عكرمة بن خالد المخزومي
 عن بن عباس ان رسول الله صلي الله عليه وسلم قال لا يتناجي اثنان دون الثالث فان ذلك يءذي المءمن والله تعالي يكره اذي المءمن لا يروي عن بن عباس الا بهذا الاسناد تفرد به بن المبارك \  \
  حدثنا احمد بن عمرو قال نا ابو الربيع قال نا عمر بن حفص العبدي عن ثابت البناني
 عن انس بن مالك قال قال رسول الله صلي الله عليه وسلم يد الرحمن فوق راس المءذن وانه ليغفر له مدي صوته اين بلغ لم يرو هذا الحديث عن ثابت الا عمر بن حفص \  \
  حدثنا احمد بن عمرو قا نا هدبة بن خالد قال نا حماد بن  سلمة قال نا الاشعث بن عبد الرحمن الجرمي عن ابي قلابة عن ابي الاشعث الصنعاني عن النعمان بن بشير ان رسول الله صلي الله عليه وسلم قال كتب الله تعالي كتابا قبل ان يخلق السماوات والارض بالفي عام فانزل منه ايتين ختم بهما سورة البقرة فلا تقران في دار ثلاثة ايام فيقربها شيطان لا يروي هذا الحديث عن النعمان الا بهذا الاسناد تفرد به حماد بن سلمة \  \
  حدثنا احمد بن عمرو القطراني قال نا عبد الاعلي بن حماد النرسي قال نا وهيب بن خالد قال نا ايوب عن محمد بن سيرين عن قزعة
 قال قلت لابن عمر اصلي علي راحلتي حيث توجهت بي قال نعم قلت من السنة هو قال نعم لم يرو هذا الحديث عن ايوب الا وهيب \  \
  حدثنا احمد بن عمرو قال نا احمد بن ابان القرشي قال نا عبد العزيز بن محمد الدراوردي عن عمرو بن ابي عمرو عن القاسم
 عن عاءشة قالت كفن رسول الله صلي الله عليه وسلم في ثلاثة اثواب سحولية ليس فيها قميص ولا عمامة لم يرو هذا الحديث عن عمرو بن ابي عمرو الا الدراوردي \  \
  حدثنا احمد بن عمرو قال نا كامل بن طلحة الجحدري قال نا ليث بن سعد عن يزيد بن ابي حبيب عن صفوان بن سليم عن عبد الرحمن بن هرمز الاعرج مولي بني مخزوم
 عن ابي هريرة قال سجد رسول الله صلي الله عليه وسلم في @QB@ اذا السماء انشقت @QE@ و @QB@ اقرا باسم ربك @QE@ لم يرو هذا الحديث عن صفوان بن سليم عن الاعرج الا يزيد بن ابي حبيب \  \ 
  حدثنا احمد بن عمرو قال نا ابو الربيع قال نا اسماعيل بن جعفر عن يزيد بن خصيفة عن ابراهيم بن عبد الله بن عبد القارء
 ان عليا كان يقول بت عند رسول الله صلي الله عليه وسلم ذات ليلة فكنت اسمعه اذا فرغ من صلاته وتبوا مضجعه يقول اللهم اني اعوذ بمعافاتك من عقوبتك واعوذ برضاك من سخطك واعوذ بك منك اللهم لا استطيع ثناء عليك ولو حرصت ولكن انت كما اثنيت علي نفسك لم يرو هذا الحديث عن ابراهيم بن عبد الله بن عبد القارء الا يزيد بن خصيفة تفرد به اسماعيل بن \  \ جعفر
  حدثنا احمد بن عمرو قال نا محمد بن جامع العطار قال نا مسلمة بن علقمة عن داود بن ابي هند عن الشعبي
 عن ابي هريرة قال سمعت رسول الله صلي الله عليه وسلم يقول في بني تميم ثلاثة اشياء لا ازال احبهم ابدا اتت رسول الله صلي الله عليه وسلم نعم من نعم الصدقة من بني تميم فقال هذه نعم قومي جعلهم قومه وكان علي عاءشة نذر علي ان تعتق من ولد اسماعيل فاقبل عليه سبي من خولان فقال رسول الله صلي الله عليه وسلم اعتقي منهم فانهم من ولد اسماعيل وهم اشد الناس علي الدجال يعني بني تميم لم يرو هذا الحديث عن داود بن ابي هند الا سلمة بن علقمة \  \
