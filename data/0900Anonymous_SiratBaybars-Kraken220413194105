 من الشايخ ولا من كبراء الاقليم فالتفت الي عتمان وقال له اين المشايخ قال له يعي ان المشايخ كان حد منهم قربي قال هات غفراء الدار فحضروا بين بديه فقال لهم اين المشايخ لم ار احيد منهم جاء ني لاي شء فقالوا يا كاشف ان عدم مجيءهم فاهم جميما عندك في الحبس فقال لهم وما سبب حبسهم فقالوا له علي ما فمل عتمان وكيف انه ضربهم ولا يعلم لاحد منهم ذنب وبعد ما ضربهم حبسهم وبعد ذلك ركب علي حصانه وتركهم محبوسين الي هذا الوقت فالتقت الامير الي عتمان وقال له لما ذاضر بتهم وحبستهم قال عتمان كنت اشوف الكاشف يضرب الفلاحين والمشايخ فعملت مثله واتا يا اشقر عزلت تفسي انا حبستهم وانت سيهم ياجدع ومن هذا الوقت انا اضرب وانت سامح فعند ذلك اص الامير بيبرس باخراج المشايخ من الحبس واحضارهم الي بين يديه فلما حضروا قالوا يا امير قد اذانا الاسطي عتمان وما نعلم لنا ذنب فقال بيبرس الحق عليكم كيف ان الامير شعبان بموت عندكم وفي بلدكم والذي قتله رجل بدوي غادر واتتم تاعدين ولا احد يسال ولا تخافوا ان يعيد عليكم هذا الغدار يفعل بكم كما فعل بغيركم من العار والذل والشنار فقالوا له يادولا تلي هذا رجل جبار ومن الذي يقدر يقف له في الطريق او يصطلي له بنار فقال لهم الامير كان ما كان ولكن من الان تنبهوا لاتفسكم واعلموا ان عتمان ما فعل بكم هذه الفعال الا لاجل عدم التقامكم ثم ان بييرس رتب دنهم اثنين نلار وقسم اقلم الجيزه قسين وجهل علي كل قسم ناظرا منهم ويعل في كل قسم اثنين ماصودين و بعل في كل مامورية تاءمقام ون تحت ايديهم المشابخ ولكل شيخ و اهد مساون واربعة ميتدان ونيه علي الالاحين بعدم الظلم واذا شيخ ظلم فلاح فانه يشتكيه الي تاءتمام وان لم ينه بفه يشتكي الي المامور واذا لم ينصفه المامور يشتمكو الي الناظر وان عدم السافي الناظر يعكي الي الكاشف، وانا اخاسن له حته بالسدل والانصاف كما امر النبي جد الاشرافه عليه


