 الشقاء فافاقت والقا الله حلاوة الاسلام في قلبها وكانت مقيسة في مكان يطل علي المكان الذي فيه الملوك وهي تنظر اليهم وستعت ماقالوا علي شيحه فقالت والله امكنكم من قتله كيف هءلاء الملاعين يتشا ورون علي قتل شيح وهو سلطان الفلاع فعند ذلك نزلت لهم و بكت بين ايدبهم وقالت لهحم ياملوك الروم انا رومة بنت عالم الملة جوان وقصدي ان تاخذ وابثارابي وتنظروا الي ملك منكم ياخذ ني في مكانه وبحميني من المسلمين فلماراوها الملك بهتوا في حما لها ومابقااحد الا وهوشاخص اليها وتالوا لها ياسيدتي احنا كلنا نخدمك ولا احدمنا الاويحميك ويكرمك و بذ كرايام ابيك فاخذت كرمي بيدها و قعدت بينهم وشاغلتهم ولماراوها بينهم طلبوا المدام وملوا الكاسات وارادوا ان يسقوها فقالت انا لا اشرب البيبار حزينة علي ابي واما اتتم اشر بوامشروب المافية وكان كلامهم لها بنيه ودلال حتي اشفلتهم بما حوت من الجمال ولمارات الحمرة بينهم قالث لهم انا ما بقيت اشرب البيبار ولكن لا جل خاطركم املا لكم واسقيكم كل هذا والبرتقش واسفوط تاعدين والي فعلها ناظرين فشمرت عن شواعدها وملت وناولت الملوك واخيها مع البرنتش وشاغلت الميع واد فرت لهم البنج حتي رقدواواطلقت شيحه وقالت له هذه تتيجة عملتهامعك حتي خلصتك فان كنت تذبحهم دونك ومانريد والبريقش واسفوط فعند ذلك نزل شيحه احضر حصانين طيبن حطالبرتفش واسفوط علي واحد مسقطين في جمدانين واركب رومة علي الثاني وسار بها تحت الليل وهي را كبة واخيها والبرتقش مسفطين علي الخيل وسلك من طريق لم يعرفها احدوهو يكمن بالنهار ويسافر بالليل مدة ايام حتي اتا الي مصر وطلع الي قلعة الحيل ودخل علي السلطان وهوجالس في رسط الديوان للها نظره الملك الظاهر قام اليه واعتنقه وملم عليه بعدمامشا اليه سيع خطامثل المادة واخذ يده واجلسه جانبه في مرببته وساله اين كانت غيبته فاخبره بكل ماجرا عليه من ملوك الروم ثم انه احضراسفوط والبرتفش وقال شيحه يابرتفش انا اعرف ان غلمان جوان مابقامنهم احد الاانت وانا اعلم ان لا بدلك ان تسلم وسبب ذلك باقي عليك فهل تري هذه النوية من الذي تسبب في خلا صكم فاعلمني بيفين والا والاسم الاعظم 


 ============================================================
 امدك تحت الضرب ولاا بطل عنك اما تقراوتموت فقال البرتقش انا اعلمك من فيران تضر بني ولا تءذيني لكن يا بومحمد الايام طو يلة وان شهرت الذي خلصنا كخاف الناس ولا بقا احد بتعرض لنا فقال شيحه اذا قلت لي عليه لم اتلفه واتما اعرفه فقال له تقوله الصبايغ فسكت شيحه ونزل البرتقش واسفوط في الحبس وطلع رومة في السرايه هند الملكة ام الاسياد واعلم السلطان باسلامها ويريد الوواجبها لفرح السلطان بذلك ولمسا كان ثاني الابام طلع المقدم جمال الدين الي الديوان وقال ياملك الاسلام اناحيتك خاطب راغب في رومة بنت جوان فانها اسليت وهي في السراية بين خدمك وغلمانك وانت ولي امرها بعداسلامها وقد جيتك يامولا ناخاطب فلا ينرد ني خايب فقال السلطان للقاضي قم ياقاضي وخذ ابراهيم وسعد واسالها ان كانت ترضي و من يكون وكيل عقدها فقام القاضي كريم الدين وطلع مع ابراهيم وسعد فرضيت بزواج شيحه والوكيل السلطان وهقد القاضي النكاح وعمل فرح الي رومة يشارله باطراف البنان عدة سبعة ابام ولساكانت ليلة الاصابة دخل شيحة عليها وازال بكاركها وانسر قلبه وارتاح خاطره وكانت ليلة ابرك الليالي وبات واصبح دخل الحام رفع الجنابه عنه ولبس ملبوس السلك وطلع الي الديوان تلقاه الملك الظاهر واجاسه الي جا نبه واخلع السلطان ذلك اليوم الخلع علي ارباب المناصب والموالاه اكراما للمقدم جمال الدين واطلق من في الحبوس واطل المظالم والمكوس ونادي في مصر المنادي بالامن والامان وحفظ الرعية وقلة الاذيه (قال الراوي) وبعدايام جلس السلطان علي تخت القلعة يتعاط القصص و يحكم بالعدل والانصاف كما امر النبي جد الاشراف وشيحه قاعدبجا نبه واولاده مقيمين بالديوان وهم السابق وتويرد وعلي الطويريد ودرنش الطيار والكل حاضر ين والديوان محتبك بالقداويه والامر اوالوزرا ارباب الدولة جسيما واذا بقداوي طالع من باب الديوان الي قدام السلطابن وقبل الارض وقال ياملك الدولة تعيش راسك في المقدم عاصي سلطان بنوا الادرع وكان هذا الفداوي يقال له المقدم مجم الدين بن شاكر فقالله السلطان ومن قتل المقدم عاصي فقال بادولتلي قعله نصير النمر بن اسدالدين البو يضي وملك حصنه ووضبع يده علي ماله 


 ============================================================
 وسلاحه وخيله ونردشطفة عاصي علي راسه ونادي في الجبال ولم جببع البصاة سحته وركب بالنموره واخرب سبع قلاع من قلاع بنوا اسماعيل واخذ النهب منهم ورجع الي الحصن الازرق عمره وسكن فيه ونزل جلود بني الادرع من علي القلاع وامر بد فنهم فماهان علينا ذلك الفمال فركبت انا واتيت لكم اهلمتكم لبكون في شريف علمكم والسلام (قال الراوي) وتان السبب في عمصبان المقدم نصير الشبرانه من حين مات الملك عرنوص قعد المقدم نصير النمر في زاوية بارة يخدم المقدم اسماعيل ابو السباع لانه عمي من بكاه علي ابن اخيه الملك هرنوص وقد طلع مدينة الرخام وقد في زاوية بارةواخذنصير الشمرعنده فلما وصلت الاخبار ان شيحه اني بجوان من السبعة كنايس وسار به يقطعه في مصر دخل علي اسماعيل ابو السباع وقال له ياخوند مرادي اسافر الي قلعتي واطلل علي اولادي رقرايبي واحبا بي قال له المقدم امما عيل ياولديي سر ولكن بامقدم نصير اوصيك لا تعصي علي المقدم شيحه ولا تقمل فعلا يوجب العصبان فقال نصير عبب علي ياخوندوانا ايش لي بشيحة فقال له اوصيتك والسلام فقبل يده وركب بعدان تخفاوسارالي مصرفلياوصل التقي جوان ملق علي كلاليب للمر به وشبحه يقطعه فسحب شاكريته وضرب شيحه الضر به التي بهاراس جوان ولما فعل هذه الفمال انطبقت عليه الرجال فاهي نفسه منهم ولازال يقاتل حتي قفل باب الخوخه بينه وبينهم وما صدق انه ينفذ وعادت الرجال وجدواشيحه طيب فهنوه بالسلامه وجري ماجري وعادنصي من حيث اتي ودخل الي زاوية بارة وقلاع الرنبور واقام عند المقدم اسماعل بخدمه الي ان رجمت بنوا اسماعيل من بركة الحوت وقلاع الحاموس وشيحه سلخ سيف بن فضل وساروابعدها الي معر وتزوج شسيحه برومه بنت جوان واقامت بنوا اسماعيل في مصر حتي بحضروا الفرح واما بنوا الادرع لمساجري لم ماجري وانسلخ سيف وعلق جلده شيحه علي قليته ارسلوا الي نصيرواعليوه عاتم من شيحه وقالوا له كيف ابن عمناودمناولمناو يتمكن شيحه من سلخه فلما سمع نصير التمرذلك ركب وساراليهم واجتمع معهم وقال لهم بارجال هذا كله منكم 


 ============================================================
 ومن سلطا نكم عامي فانه لافيه نخوة رجال لقالوا له هم معنا وخذ لنا بالثار ونجعلك سلطا ننا ولتفق معك علي قتل عاصي لكن يشرط تاخذ لنا بالثارمن شيحه فقال نصير يارجال لوابعضكم وتعالوا علي قلعة الطيره وهكار ونسير كلنا الي عاصي وندخل عليه ونعامله بماعولناعليه فان قام معناوشد بنا كتامعه وهو معناوان ابا وقال اناما اعادي شوحه قتلته اناوتعدت مكانه وبعدها اتقرغ انا لشيحه والظاهر وكل من معهم فقالوا له واحنا معك علي كل ما تريدوارسلوا اتباههم وجعوا ماتبقي من بي الادرع وساروا الي قلعة الطيره وهكار ودخلوا علي نصير كما اتققواوقا لوا له ها نحن جينافاخذهم وسار بهم الي قلمة الصبيبة ودخلواعلي المقدم عاصي وطلبوامنه ان يكون معهم علي اتفاقهم قال المقدم عاصي كيف اعصي علي رجل بيني وبينه عهد الله وميثاقه انه لا يخونني ولا انا اخونه لتقدم نصير النسر اليه ومسكه من لحيته وقال له هتكت الادرعية واتكي عليه ذيحه وبعدها سلخه وكفته ودنته واخذشطفة السلطنة ونشرها علي راسه وجمع اللهوم وركب واخذ الادرعية وهجم علي الحصون واولاداسماعيل غايبه في مصر ونهب مسبع قلاع من قلاع بني اسماعيل ورجع ملك الحصن الازرق كان المقدم نجم الدين ابن شاكر منقطع لي تلته وهوضعيف فلما بلغه ذلك ماهان عليه وكان لا شفي من ضعفه ركب حجرته وسار الي مصر ودخل الديوان اعلم السلطان هذا كان السبب (قال الراوي) فلماسمع الملك ذلك الكلام اشتد به الغضب وامر نجم الدين بالحلوس ثم انه التفت للي شيحه وقال له كيف الراي يامقدم جمال الدين فكتب شيحه كتاب وقال بارجال من فيكم ياخذهذا الكتاب ويدخل به علي نصير النمرو بحيب منه ردالجواب فسكتوا الرجاللا احدقدر بتكلم فعندها تحرك ابراهيم بن حسن وقال انا اكون بداء اولاد اسماعيل فقال شبحه تستاهل يا ابوخليل ان تكون نايب عني في كل امرمهم ثم خلع عليه تقطان النيابة علي السلطنة وقفطان النجابة وفردله شطفة الملك علي راسه ونادي له في الديوان ان يكون كيخة الحصون فزل ايراهيم من الديوان وجمع رجا له وكواخيه واخذ كواخي شيحة وكبيرم المقدم اسيل بن الاصم واخذمعه فارس وسالم وسلام وفانم وغنام والحطاب وهءلاء 


 ============================================================
 السبعة الذين كابواكواغي عندر نبيق اليشهبي ولما طاعواشيحة جملهم كو اخيه في الديوان فلما ركب ابراهيم اخذهم معه وساروا جملة واحدة وقد ساروا طالبين الحصن الازرق (ياساده) وكان في الديوان رجل تبع من بفي الادرع وهومتخفي ولااحد يلكفت اليه ولماجري ماجري فاهان عليه فزل ركب حجرته وسبق الي الحصن الازرق ودخل علي نصير النمروكان انسمه المقدم حامدواعلم نصير التبر وبنوالادرع بقدوم ابراهيم الحوراني وكواخيه قالوا بنوالادرع نركب ونسير ونقا بلهم علي ابعد مكان ونذهبهم وهم تبانين من كثرة السفرفقال المقدم نصبرهيا يارجال فركب بنوالادرع وطلبواالبروسار واحتي التقوا مع المقدم ابراهيم ومن معه وكان ملتقي علي محل يقال له حبس الشغل قريب من ارض الشام ووقعت العين علي العين فلم يصبروا بتوالادرع الاحملوا علي بني اسماعيل في الحال ووقع علي الطايفتين وغنا الحسام الفصال وتبطحت القتلي علي الرمال وهطل الدم وسال وححم الشجاع ومال وتقل علي بنواسما عيل العددوزاد المعدود وارجعهم بنو الادرع الي وري رنظر المقدم ايراهيم الي تعب الرجال فسال عن الخبر فقالواله كسروتا بنو الادرع فد كس ابراهيم علي بني الادرع بحجرته وصرخ فيهم بعظم زعقته وقوا قلوب الرجال بحملته ومادام يضرب في بفي الادرع بذو الحياة حتي اشرفوا علي الهرب والشتات وصار يضرب فيهم ضرب مطلق بقد الخود والدرق حتي ردهم الي الحصن الازرق ولما عادوا الادرعية دخلوا الحصن علي نصير النمر فقال لهم ابش الخبر فاخبروه بما فعل ابراهيم بن حسن فقال نصير خلوا ابن الحوراني من قسمي وانا الضامن لكم قتله اقبدوا يار جال فقعدوا واذا بالسبعة كواخي داخلين ومعهم كتاب شيحه والسبب في ذلك ان ابراهيم جاء تحت الحصن ونصب خيامة وقال ان الحاج شيحه قليل العقل كيف يكتب كتابا الي هذا الفاجر ويريد منه رد الجواب هذا ماله الا الطمان عند الحملة والضرب فقالوا السكواخي السبعة يامقدم ابراهيم قبل كل شء ارسل كتاب شيحه اليه قبل الخصام فان عمل بمافيه نسايبقي عليه عتب ولاملام فقال ابراهيم اقوم ادخل في قلمته واعطيه كتاب 


