 يحتمل ان يعود علي اليهود والنصاري لان العداوة بينهم موجودة مستمرة ويحتمل ان يعود علي النصاري فقط لانها امة متقاتلة بينها الفتن الي يوم القيامة ثم توعدهم بعذاب الاخرة اذ صنعهم كفر يوجب الخلود في النار واعلم رحمك الله انه قد جاءت اثار صحيحة في ذم الشحناء والتباغض والهجران لغير موجب شرعي ففي صحيح مسلم عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال تفتح ابواب الجنة يوم الاثنين ويوم الخميس فيغفر لكل عبد لا يشرك بالله شيءا الا رجلا كانت بينه وبين اخيه شحناء فيقال انظروا هذين حتي يصطلحا انظروا هذين حتي يصطلحا وفي رواية تعرض الاعمال في كل خميس واثنين فيغفر الله في ذلك اليوم لكل امرء لا يشرك بالله شيءا الحديث انتهي وروي ابن المبارك في رقاءقه بسنده عن النبي صلي الله عليه وسلم قال لا يحل لامرء مسلم ان يهاجر مسلما فوق ثلاث ليال فانهما ناكبان عن الحق ما داما علي صرامهما فاولهما فيا يكون سبقه بالفء كفارة له وان سلم عليه فلم يقبل ورد عليه سلامه ردت عليه الملاءكة وردت علي الاخر الشياطين واذا ماتا علي صرامهما لم يدخلا الجنة اراه قال ابدا انتهي وسنده جيد ونصه قال ابن المبارك اخبرنا شعبة عن يزيد الرشك عن معاذة العدوية قالت سمعت هشام بن عامر يقول سمعت النبي صلي الله عليه وسلم فذكر الحديث وقوله لم يدخلا الجنة ليس علي ظاهره اي لم يدخلا الجنة ابدا حتي يقتص لبعضهم من بعض او يقع العفو او تحل الشفاعة حسبما هو معلوم في صحيح الاثار وقوله سبحانه يا اهل الكتاب قد جاءكم رسولنا يبين لكم كثيرا مما كنتم تخفون من الكتاب الاية اهل الكتاب لفظ يعم اليهود والنصاري ولكن نوازل الاخفاء كالرجم وغيره انما حفظت لليهود لانهم كانوا مجاوري رسول الله صلي الله عليه وسلم في مهاجره وفي اعلامه صلي الله  عليه وسلم بخفي ما في كتبهم وهو امي لا يكتب ولا يصحب القراء دليل علي صحة نبوءته لو الهمهم الله للخير ويعفوا عن كثير اي لم يفضحهم فيه ابقاء عليهم والضمير في يعفوا للنبي صلي الله عليه وسلم وقوله تعالي قد جاءكم من الله نور هو محمد صلي الله عليه وسلم وكتاب مبين هو القران ويحتمل ان يريد موسي عليه السلام والتوراة اي لو اتبعتموها حق الاتباع والاول هو ظاهر الاية وهو اظهر وسبل السلام اي طرق السلامة والنجاة ويحتمل ان يكون السلام هنا اسما من اسماء الله عز وجل فالمعني طرق الله والظلمات الكفر والنور الايمان وباقي الاية بين متكرر وقوله سبحانه قل فمن يملك اي لا مالك ولا راد لارادة الله تعالي في المسيح ولا في غيره وقوله سبحانه يخلق ما يشاء اشارة الي خلقه المسيح في رحم مريم من غير والد بل اختراعا كادم عليه السلام وقوله تعالي والله علي كل شء قدير عموم معناه الخصوص فيما عدا الذات والصفات والمحالات وقوله سبحانه وقالت اليهود والنصاري نحن ابناء الله واحباءه الاية البنوة في قولهم هذا بنوة الحنان والرافة لانهم ذكروا ان الله سبحانه اوحي الي اسراءيل ان اول اولادك بكري فضلوا بذلك وقالوا نحن ابناء الله واحباءه ولو صح ما رووا لكان معناه بكرا في التشريف او النبوءة ونحوه وكانت هذه المقالة منهم عند ما دعاهم النبي عليه السلام الي الايمان به وخوفهم العذاب فقالوا نحن لا نخاف ما تقول لانا ابناء الله واحباءه ذكر ذلك ابن عباس وقد كانوا قالوا للنبي صلي الله عليه وسلم في غير ما موطن نحن ندخل النار فنقيم فيها اربعين يوما فرد الله عليهم قولهم فقال لنبيه عليه السلام قل فلم يعذبكم بذنوبكم اي لو كانت منزلتكم منه فوق منازل البشر لما عذبكم وانتم قد اقررتم انه يعذبكم ثم ترك الكلام الاول واضرب عنه غير مفسد له ودخل في غيره فقال بل انتم بشر

  CHECK [اية ]
 كساءر الناس والخلق اكرمهم عند الله اتقاهم يهدي من يشاء للايمان فيغفر له ويورط من يشاء في الكفر فيعذبه وله ملك السماوات والارض وما بينهما فله بحق الملك ان يفعل ما يشاء ولا معقب لحكمه واليه مصير العباد بالحشر والمعاد وقوله تعالي يا اهل الكتاب يعني اليهود والنصاري قد جاءكم رسولنا محمد عليه السلام وقوله علي فترة من الرسل اي علي انقطاع من مجيءهم مدة ما والفترة سكون بعد حركة في الاجرام ويستعار ذلك للمعاني وقد قال عليه السلام لكل عمل شرة ولكل شرة فترة وفي الصحيح ان الفترة التي كانت بين نبينا محمد صلي الله عليه وسلم وبين عيسي ستماءة سنة وهذه الاية نزلت بسبب قول اليهود ما انزل الله علي بشر بعد موسي من شء قاله ابن عباس وقوله ان تقولوا معناه حذارا ان تقولوا يوم القيامة ما جاءنا من بشير ولا نذير فقد جاءكم بشير نذير وقامت الحجة عليكم والله علي كل شء قدير فهو الهادي والمضل لا رب غيره وقوله سبحانه واذ قال موسي لقومه يا قوم اذكروا نعمة الله عليكم اذ جعل فيكم انبياء الاية المعني واذكر لهم يا محمد علي جهة اعلامهم بغيب كتبهم ليتحققوا نبوءتك ثم عدد عيون تلك النعم فقال اذ جعل فيكم انبياء اي حاطة ومنقذون من النار وشرف في الدنيا والاخرة وجعلكم ملوكا اي فيكم ملوك لان الملك شرف في الدنيا وحاطة في نواءبها واتاكم ما لم يءت احدا من العالمين قال مجاهد هو المن والسلوي والحجر والغمام وقال غيره كثرة الانبياء وعلي هذا القول فالعالمون علي العموم وعلي القول بان المءتي هو ايات موسي فالعالمون عالم زمانهم لن ما اوتي النبي صلي الله عليه وسلم من ايات الله اكثر من ذلك والمقدسة معناه المطهرة قال ابن عباس هي الطور وما حوله وقال قتادة هي الشام قال الطبري ولا يختلف انها بين الفرات وعريش مصر  قال ع وتظاهرت الروايات ان دمشق هي قاعدة الجبارين ثم حذرهم موسي الارتداد علي الادبار وذلك هو الرجوع القهقري والخاسر الذي قد نقص حظه ثم ذكر عز وجل انهم تعنتوا ونكصوا فقالوا ان فيها قوما جبارين والجبار من الجبر كانه لقدرته وغشمه وبطشه يجبر الناس علي ارادته والنخلة الجبارة العالية التي لا تنال بيد وكان من خبر الجبارين انهم كانوا اهل قوة فلما بعث موسي الاثني عشر نقيبا مطلعين من امر الجبارين واحوالهم راوا لهم قوة وبطشا وتخيلوا ان لا طاقة لهم بهم فتعاقدوا بينهم علي ان يخفوا ذلك من بني اسراءيل وان يعلموا به موسي ليري فيه امر ربه لما انصرفوا الي بني اسراءيل خان منهم عشرة فعرفوا قراباتهم ومن وثقوا به ففشا الخبر حتي اعوج امر بني اسراءيل وقالوا اذهب انت وربك فقاتلا ولم يف من النقباء الا يوشع بن نون وكالب بن يوفتا ويقال فيه كالوث بثاء مثلثة وقوله تعالي قال رجلان من الذين يخافون اي يخافون الله سبحانه قال اكثر المفسرين الرجلان يوشع بن نون وهو ابن اخت موسي وكالب بن يوفتا انعم الله عليهما بالايمان الصحيح وربط الجاش والثبوت وقولهم فاذهب انت وربك فقاتلا الاية عبارة تقتضي كفرا وقيل المعني فاذهب انت وربك يعينك وان الكلام معصية لا كفر وذكر ابن اسحاق وغيره ان النبي صلي الله عليه وسلم كلم الناس يوم بدر وقال لهم اشيروا علي ايها الناس فقال له المقداد بن الاسود يا رسول الله لسنا نقول كما قالت بنو اسراءيل اذهب انت وربك فقاتلا انا هاهنا قاعدون ولكن نقول اذهب انت وربك فقاتلا انا معكما مقاتلون ثم تكلم سعد بن معاذ بنحو هذا المعني ولما سمع موسي عليه السلام قولهم وراي عصيانهم تبرا الي الله منهم قوال داعيا عليهم رب اني لا املك الا نفسي واخي يعني هارون  وقوله فافرق بيننا دعاء حرج والمعني فافرق بيننا وبينهم حتي لا نشقي بفسقهم قال فانها محرمة عليهم اي قال الله وحرم الله تعالي علي بني اسراءيل دخول تلك المدينة اربعين سنة يتيهون في الارض اي في ارض تلك النازلة وهو فحص التيه وهو علي ما يحكي طول ثلاثين ميلا في عرض ستة فراسخ ويروي انه لم يدخل المدينة احد من ذلك الجيل الا يوشع وكالوث وروي ان يوشع نبء بعد كمال الاربعين سنة وخرج بيني اسراءيل من التيه وقاتل الجبارين وفتح المدينة وفي تلك الحرب وقفت له الشمس ساعة حتي استمر هزم الجبارين والتيه الذهاب في الارض الي غير مقصد معلوم وقوله تعالي فلا تاس علي القوم الفاسقين معناه فلا تحزن والخطاب بهذه الاية لموسي عليه السلام قال ابن عباس ندم موسي علي دعاءه علي قومه وحزن عليهم فقال الله له فلا تاس علي القوم الفاسقين وقوله تعالي واتل عليهم نبا ابني ادم بالحق اذ قربا قربانا الاية اتل معناه اسرد واسمعهم اياه وهذه من علوم الكتب الاول فهي من دلاءل نبوءة نبينا محمد صلي الله عليه وسلم اذ هي من غامض كتب بني اسراءيل قال الفخر وفي الاية قولان احدهما اتل علي الناس والثاني اتل علي اهل الكتاب انتهي وابني ادم هما لصلبه وهما هابيل وقابيل روت جماعة من المفسرين منهم ابن مسعود ان سبب هذا التقريب ان حواء كانت تلد في كل بطن ذكرا وانثي وكان الذكر يتزوج انثي البطن الاخر ولا تحل له اخته توءمته فولدت مع قابيل اختا جميلة ومع هابيل اختا ليست كذلك فلما اراد ادم ان يزوجها من هابيل قال قابيل انا احق باختي فامره ادم فلم ياتمر فاتفقوا علي التقريب فتقبل قربان هابيل ووجب ان ياخذ اخت قابيل فحينءذ قال لاقتلنك وقول هابيل انما يتقبل الله من المتقين كلام  قبله محذوف تقديره ولم تقتلني وليس لي ذنب في قبول الله قرباني وانما يتقبل الله من المتقين واجماع اهل السنة في معني هذه الالفاظ انها اتقاء الشرك فمن اتقاه وهو موحد فاعماله التي تصدق فيها نيته مقبولة واما المتقي للشرك وللمعاصي فله الدرجة العليا من القبول والحتم بالرحمة علم ذلك باخبار الله تعالي لا ان ذلك يجب علي الله تعالي عقلا قلت قول ع في معني هذه الالفاظ يعني حيث وقعت في الشرع واما في هذه الاية فليس باتقاء شرك علي ما سياتي وقول هابيل ما انا بباسط يدي اليك الاية قال عبد الله بن عمر وجمهور الناس كان هابيل اشد قوة من قابيل ولكنه تحرج وهذا هو الاظهر قال ع ومن هنا يقوي ان قابيل انما هو عاص لا كافر لانه لو كان كافرا لم يكن للتحرج هنا وجه وتبوء معناه تمضي متحملا وقوله باثمي واثمك قيل معناه باثم قتلي وساءر اثامك وقيل المعني باثمي الذي يختص بي فيما فرط لي وهذا تاويل يعضده قول النبي صلي الله عليه وسلم يءتي بالظالم والمظلوم يوم القيامة فيءخذ من حسنات الظالم فتزاد في حسنات المظلوم حتي ينتصف فان لم تكن له حسنات اخذ من سيءات المظلوم فتطرح عليه وقوله وذلك جزاء الظالمين يحتمل ان يكون من قول هابيل لاخيه ويحتمل ان يكون اخبارا من الله تعالي لمحمد عليه السلام قال الفخر وقوله تعالي فطوعت له نفسه قتل اخيه قال المفسرون معناه سهلت له نفسه قتل اخيه انتهي وقوله سبحانه فاصبح من الخاسرين اصبح عبارة عن جميع اوقاته وهذا مهيع كلام العرب ومنه اصبحت لا احمل السلاح البيت وقول سعد فاصبحت بنو اسد تعزرني الي غير ذلك من استعمال العرب ومن خسران قابيل ما صح وثبت عن النبي صلي الله عليه وسلم انه قال ما قتلت نفس ظلما الا كان علي ابن ادم الاول كفل منها وذلك لانه  اول من سن القتل وقوله تعالي فبعث الله غرابا الاية قيل اصبح في ثاني يوم قتله يطلب اخفاء امر قتله فلم يدر ما يصنع به فبعث الله غرابا حيا الي غراب ميت فجعل يبحث في الارض ويلقي التراب علي الغراب الميت وظاهر الاية ان هابيل هو اول ميت من بني ادم ولذلك جهل سنة المواراة وكذلك حكي الطبري عن ابن اسحاق عن بعض اهل العلم بما في الكتب الاول والسوءة العورة ويحتمل ان يراد الحالة التي تسوء الناظر ثم ان قابيل واري اخاه وندم علي ما كان منه من معصية في قتله حيث لا ينفعه الندم واختلف العلماء في قابيل هل هو من الكفار او من العصاة والظاهر انه من العصاة قال الفخر ولم ينتفع قابيل بندمه لان ندمه كان لاسباب منها سخط ابويه واخوته وعدم انتفاعه بقتله ونحو ذلك ولما كان ندمه لهذه الاسباب لا لاجل الخوف من الله تعالي فلا جرم لم ينفعه هذا الندم وقوله تعالي من اجل ذلك هو اشارة الي ما تضمنته هذه القصة من انواع المفاسد الحاصلة بسبب القتل الحرام لا انه اشارة الي قصة قابيل وهابيل انتهي وقوله سبحانه من اجل ذلك كتبنا علي بني اسراءيل الاية جمهور الناس علي ان قوله من اجل ذلك متعلق بقوله كتبنا اي من اجل هذه النازلة ومن جراها كتبنا وقال قوم بل هو متعلق بقوله من النادمين اي ندم من اجل ما وقع والوقف علي هذا علي ذلك والناس علي ان الوقف من النادمين ويقال فعلمت ذلك من اجلك بفتح الهمزة ومن اجلك بكسرها وقوله سبحانه بغير نفس اي بغير ان تقتل نفس نفسا والفساد في الارض يجمع الزنا والارتداد والحرابة وقوله سبحانه فكانما قتل الناس جميعا روي عن ابن عباس انه قال المعني من قتل نفسا واحدة وانتهك حرمتها فهو مثل من قتل الناس جميعا ومن ترك قتل نفس واحدة وصان حرمتها مخافتي  واستحياها فهو كمن احيا الناس جميعا قال الحسن وابن زيد ومن احياها اي عفا عن من وجب له قتله بعد القدرة وقيل غير هذا ثم اخبر تعالي عن بني اسراءيل انهم جاءتهم الرسل بالبينات في هذا وفي سواه ثم ان كثيرا منهم بعد ذلك في كل عصر يسرفون ويتجاوزون الحدود وقوله سبحانه انما جزاء الذين يحاربون الله ورسوله الاية روي انس بن مالك وغيره ان الاية نزلت في قوم من عكل وعرينة قدموا علي النبي صلي الله عليه وسلم فاسلموا ثم انهم مرضوا واستوخموا المدينة فامرهم النبي ص  ان يكونوا في لقاح الصدقة وقال اشربوا من البانها وابوالها فخرجوا فيها فلما صحوا قتلوا الراعي واستاقوا الابل فبلغ النبي صلي الله عليه وسلم خبرهم فبعث الطلب في اثارهم فاخذوا قال جميع الرواة فقطع رسول الله صلي الله عليه وسلم ايديهم وارجلهم من خلاف وسمر اعينهم ويروي وسمل وتركهم في جانب الحرة يستسقون فلا يسقون فقيل ان هذه الاية ناسخة لفعله صلي الله عليه وسلم بالعرنيين ووقف الامر علي هذه الحدود وقال جماعة انها غير ناسخة لذلك الفعل لان العرنيين مرتدون لا سيما وفي بعض الطرق انهم سملوا اعين الرعاء وقالوا هذه الاية هي في المحارب المءمن قال مالك المحارب عندنا من حمل علي الناس السلاح في مصر او برية فكابرهم عن انفسهم واموالهم دون ناءرة ولا دخل ولا عداوة وبهذا القول قال جماعة من اهل العلم قالوا والامام مخير فيه بان يعاقبه بما راي من هذه العقوبات فاما قتل المحارب فبالسيف ضربة للعنق واما صلبه فبعد القتل عند جماعة وقال جماعة بل يصلب حيا ويقتل بالطعن علي الخشبة وروي هذا عن مالك وهو الاظهر من الاية وهو الانكي في النكال واما القطع فاليد اليمني من الرسغ والرجل الشمال من المفصل وقوله سبحانه او ينفوا من

  CHECK [اية ]
 الارض الظاهر ان الارض في هذه الاية هي ارض النازلة وقد جنب الناس قديما الارض التي اصابوا فيها الذنوب ومنه حديث الذي ناء بصدره نحو الارض المقدسة وينبغي للامام ان كان هذا المحارب المنفي مخوف الجانب يظن به ان يعود الي حرابه وافساد ان يسجنه في البلد الذي يغرب اليه وان كان غير مخوف الجانب ترك مسرحا وهذا هو صريح مذهب مالك وقوله تعالي ذلك لهم خزي في الدنيا الاية اشارة الي هذه الحدود التي توقع بهم فيحتمل الخزي لمن عوقب وعذاب الاخرة لمن سلم في الدنيا وبالجملة فهم في المشيءة وقوله سبحانه الا الذين تابوا الاية استثني عز وجل التاءب قبل ان يقدر عليه واخبر سبحانه بسقوط حقوقه عنه بقوله فاعلموا ان الله غفور رحيم والعلماء علي ان الاية في المءمنين ويءخذ المحارب بحقوق الناس وان تاب هذا هو الصحيح وقوله تعالي يا ايها الذين ءامنوا اتقوا الله وابتغوا اليه الوسيلة الاية هذه الاية وعظ من الله تعالي بعقب ذكر العقوبات النازلة بالمحاربين وهذا من ابلغ الوعظ لانه يرد علي النفوس وهي خاءفة وجلة وابتغوا معناه اطلبوا والوسيلة القربة واما الوسيلة المطلوبة لنبينا محمد صلي الله عليه وسلم فهي ايضا من هذا لان الدعاء له بالوسيلة والفضيلة انما هو ان يءتاهما في الدنيا ويتصف بهما ويكون ثمرة ذلك في الاخرة التشفيع في المقام المحمود قلت وفي كلامه هذا مالا يخفي وقد فسر النبي صلي الله عليه وسلم الوسيلة التي كان يرجوها من ربه وانها درجة في الجنة لا ينبغي ان تكون الا لعبد من عباد الله وارجو ان اكون انا هو الحديث وخص سبحانه الجهاد بالذكر وان كان داخلا في معني الوسيلة تشريفا له اذ هو قاعدة الاسلام وقوله تعالي يريدون ان يخرجوا من النار اخبار بانهم يتمنون هذا وقال الحسن بن ابي الحسن اذا فارت بهم النار  قربوا من حاشيتها فحينءذ يريدون الخروج ويطمعون به وتاول هو وغيره الاية علي هذا قلت ويءيده ما خرجه البخاري في رءية النبي صلي الله عليه وسلم حيث اتاه ءاتيان فاخذا بيده وفيه فاقبل الرجل الذي في النهر فاذا اراد ان يخرج رمي الرجل بحجر في فيه وفيه ايضا فانطلقنا الي ثقب مثل التنور اعلاه ضيق واسفله وساع تتوقد تحته نار فاذا اقترب ارتفعوا فاذا خمدت رجعوا فيها وفيها رجال نساء عراة فقلت ما هذا فقالا انطلق الحديث واخبر سبحانه عن هءلاء الكفار انهم ليسوا بخارجين من النار بل عذابهم فيها مقيم مءبد وقوله سبحانه والسارق والسارقة فاقطعوا ايديهما الاية قلت المسروق مال او غيره فشرط المال ان يكون نصابا بعد خروجه مملوكا لغير السارق ملكا محترما تاما لا شبهة له فيه محرزا مخرجا منه الي ما ليس بحرز له استسرارا فالنصاب ربع دينار او ثلاثة دراهم او ما يساوي ثلاثة دراهم وقوله ايديهما يعني ايمان النوعين والنكال العذاب والنكل القيد وقوله سبحانه فمن تاب من بعد ظلمه واصلح فان الله يتوب عليه الاية جمهور العلماء علي ان توبة السارق لا تسقط عنه القطع وقال الشافعي اذا تاب السارق قبل ان يتلبس الحكام باخذه فتوبته تدفع عنه حكم القطع قياسا علي توبة المحارب وقوله سبحانه الم تعلم ان الله له ملك السموات والارض يعذب من يشاء ويغفر لمن يشاء اي فلا معقب لحكمه سبحانه ولا معترض عليه يفعل ما يشاء لا اله الا هو وقوله تعالي يا ايها الرسول لا يحزنك الذين يسارعون في الكفر الاية تسلية لنبيه عليه السلام وتقوية لنفسه بسبب ما كان يلقي من طواءف المنافقين واليهود والمعني قد وعدناك النصر والظهور عليهم فلا يحزنك ما يقع منهم ومعني المسارعة في الكفر البدار الي نصره والسعي في كيد الاسلام واطفاء نوره قال مجاهد وغيره قوله تعالي من الذين قالوا ءامنا  بافواههم ولم تءمن قلوبهم يراد به المنافقون وقوله سماعون للكذب سماعون لقوم اخرين يراد به اليهود ويحتمل ان يراد به اليهود مع المنافقين لان جميعهم يسمع الكذب بعضهم من بعض ويقبلونه ولذلك جاءت عبارة سماعهم في صيغة المبالغة اذ المراد انهم يقبلون ويستزيدون من ذلك وقوله سبحانه سماعون لقوم اخرين يحتمل ان يريد يسمعون منهم وذكر الطبري عن جابر ان المراد بالقوم الاخرين يهود فدك وقيل يهود خبير ويحتمل ان يكون معني سماعون لقوم اخرين بمعني جواسيس مسترقين الكلام لينقلوه لقوم اخرين وهذا مما يمكن ان يتصف به المنافقون ويهود المدينة قلت وهذا هو الذي نص عليه ابن اسحاق في السير قال ع وقيل لسفيان بن عيينة هل جري للجاسوس ذكر في كتاب الله عز وجل فقال نعم وتلا هذه الاية سماعون لقوم اخرين وقوله سبحانه يحرفون الكلم من بعد مواضعه هذه صفة اليهود في معني ما حرفوه من التوراة وفيما يحرفونه من الاقوال عند كذبهم من بعد مواضعه اي من بعد ان وضع مواضعه وقصدت به وجوهه القويمة يقولون ان اوتيتم هذا فخذوه روي ان يهود فدك قالوا ليهود المدينة استفتوا محمدا فان افتاكم بما نحن عليه من الجلد والتجبية فخذوه وان افتاكم بالرجم فاحذروا الرجم قاله الشعبي وغيره 