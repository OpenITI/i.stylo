 المسمي به لانهم ما كانوا يعرفونه بهذا الاسم والسءال عن المجهول بما او عن معناه لانه لم يكن مستعملا في كلامهم كما استعمل الرحيم والراحم والرحوم {انسجد لما تامرنا} للذي تامرنا بالسجود له او لامرك بالسجود يا محمد من غير علم منا به يامرنا علي وحمزة كان بعضهم قال لبعض انسجد لما يامرنا محمد او يامرنا المسمي بالرحمن ولا نعرف ما هو فقد عاندوا لان معناه عند اهل اللغة ذو الرحمة التي لا غاية بعدها في الرحمة لان فعلان من ابنية المبالغة تقول رجل عطشان اذا كان في نهاية العطش {وزادهم} قوله اسجدوا للرحمن {نفورا} تباعدا عن الايمان
 
 تبارك الذي جعل في السماء بروجا وجعل فيها سراجا وقمرا منيرا ()
 {تبارك الذي جعل في السماء بروجا} هي منازل الكواكب السيارة لكل كوكب بيتان يقوي حاله فيهما وللشمس بيت وللقمر بيت فالحمل والعقرب بيتا المريخ والثور والميزان بيتا الزهرة والجوزاء والسنبلة بيتا
 
 عطارد والسرطان بيت القمر والاسد بيت الشمس والقوس والحوت بيتا المشتري والجدي والدلو بيتا زحل وهذه البروج مقسومة علي الطباءع الاربع فيصيب كل واحد منها ثلاثة بروج فالحمل والاسد والقوس مثلثة نارية والثور والسنبلة والجدي مثلثة ارضية والجوازء والميزان والدلو مثلثة هواءية والسرطان والعقرب والحوت مثلثة ماءية سميت المنازل بالبروج التي هي القصور العالية لانها لهذه الكواكب كالمنازل لسكانها وانشقاق البروج من التبرج لظهوره وقال الحسن وقتادة ومجاهد البروج هي النجوم الكبار لظهورها {وجعل فيها} في السماء {سراجا} يعني الشمس لتوقدها سرجا حمزة وعلي اي نجوما {وقمرا منيرا} مضيءا بالليل
 
 وهو الذي جعل الليل والنهار خلفة لمن اراد ان يذكر او اراد شكورا ()
 {وهو الذي جعل الليل والنهار خلفة} فعلة من خلف كالركبة من ركب وهي الحالة التي يخلف عليها الليل والنهار كل واحد منهما الاخر والمعني جعلهما ذوي خلفة يخلف احدهما الاخر عند مضيه او يخلفه في قضاء ما فاته من الورد {لمن اراد ان يذكر} يتدبر في تسخيرهما واختلافهما فيعرف مدبرهما يذكر حمزة وخلف اي يذكر الله او المنسي فيقضي {او اراد شكورا} اي يشكر نعمة ربه عليه فيهما
 
 وعباد الرحمن الذين يمشون علي الارض هونا واذا خاطبهم الجاهلون قالوا سلاما ()
 {وعباد الرحمن} مبتدا خبره {الذين يمشون} او اولءك يجزون والذين يمشون وما بعدهما صفة والاضافة الي الرحمن للتخصيص والتفضيل وصف اولياءه بعدما وصف اعداءه {علي الارض هونا} حال او صفة للمشي اي هينين او مشيا هينا والهون الرفق واللين اي يمشون بسكينة ووقار وتواضع دون
 الفرقان (  )
 مرح واختيال وتكبر فلا يضربون باقدامهم ولا يخفقون بنعالهم اشرا وبطرا ولذا كره بعض العلماء الركوب في الاسواق ولقوله ويمشون في الاسواق {واذا خاطبهم الجاهلون} اي السفهاء بما يكرهون {قالوا سلاما} سدادا من القول
 
 يسلمون فيه من الايذاء والافك او تسلما منكم نتارككم ولا تجاهلكم فاقيم السلام مقام التسلم وقيل نسختها اية القتال ولا حاجة الي ذلك فالاغضاء عن السفهاء مستحسن شرعا ومروءة هذا وصف نهارهم ثم وصف ليلهم بقوله
 
 والذين يبيتون لربهم سجدا وقياما ()
 {والذين يبيتون لربهم سجدا} جمع ساجد {وقياما} جمع قاءم والبيتوتة خلاف الظلول وهي ان يدركك الليل نمت او لم تنم وقالوا من قرا شيءا من القران في صلاة وان قل فقد بات ساجدا وقاءما وقيل هما الركعتان بعد المغرب والركعتان بعد العشاء والظاهر انه وصف لهم باحياء الليل او اكثره
 
 والذين يقولون ربنا اصرف عنا عذاب جهنم ان عذابها كان غراما ()
 {والذين يقولون ربنا اصرف عنا عذاب جهنم ان عذابها كان غراما} هلاكا لازما ومنه الغريم لملازمته وصفهم باحياء الليل ساجدين قاءمين ثم عقبه بذكر دعوتهم هذه ايذانا بانهم مع اجتهادهم خاءفون مبتهلون متضرعون الي الله في صرف العذاب عنهم
 
 انها ساءت مستقرا ومقاما ()
 {انها ساءت مستقرا ومقاما} اي ان جهنم وساءت في حكم بءست وفيها ضمير مبهم يفسره مستقرا والمخصوص بالذم محذوف معناه ساءت مستقرا ومقاما هي وهذا الضمير هو الذي ربط الجملة باسم ان وجعلها خبرا لها او بمعني احزنت وفيها ضمير اسم ان ومستقرا حال او تمييز ويصح ان يكون التعليلان متداخلين ومترادفين وان يكونا من كلام الله تعالي وحكاية لقولهم
 
 والذين اذا انفقوا لم يسرفوا ولم يقتروا وكان بين ذلك قواما ()
 {والذين اذا انفقوا لم يسرفوا} لم يجاوزوا الحد في النفقة او لم ياكلوا للتنعم ولم يلبسوا للتصلف وعن ابن عباس رضي الله عنهما لم ينفقوا في المعاصي فالاسراف مجاوزة القدر وسمع رجل رجلا
 
 يقول لا خير في الاسراف فقال لا اسراف في الخير وقال عليه الصلاة والسلام من منع حقا فقد قتر ومن اعطي في غير حق فقد اسرف {ولم يقتروا} بضم التاء كوفي وبضم الياء وكسر التاء مدني وشامي وبفتح الياء وكسر التاء مكي وبصري والفتر والافتار والتقتير والتضييق الذي هو نقيض الاسراف {وكان} انفاقهم {بين ذلك} اي الاصراف والاقتار {قواما} اي عدلا بينهما فالقوام العدل بين الشيءين والمنصوبان اي بين ذلك قواما خبران وصفهم بالقصد الذي هو بين الغلو والتقصير وبمثله امر عليه الصلاة والسلام ولا تجعل يدك مغلولة الي عنقك الاية وسال عبد الملك بن مروان عمر عبد العزيز عن نفقته
 الفرقان (  )
 حين زوجه ابنته فقال الحسنة بين السيءتين فعرف عبد الملك انه اراد ما في هذه الاية وقيل اولءك اصحاب محمد عليه الصلاة والسلام كانوا لا ياكلون طعاما للتنعم واللذة ولا يلبسون ثيابهم للجمال والزينة ولكن لسد الجوعة وسترالعورة ودفع الحر والقر وقال عمر رضي الله عنه كفي سرفا ان لا يشتهي الرجل شيءا الا اكله
 
 والذين لا يدعون مع الله الها اخر ولا يقتلون النفس التي حرم الله الا بالحق ولا يزنون ومن يفعل ذلك يلق اثاما ()
 {والذين لا يدعون مع الله الها اخر} اي لا يشركون {ولا يقتلون النفس التي حرم الله} اي حرمها يعني حرم قتلها {الا بالحق} بقود او رجم او ردة او شرك او سعي في الارض بالفساد وهو متعلق بالقتل المحذوف او بلا يقتلون {ولا يزنون} ونفي هذه الكباءر عن عباده الصالحين تعريض لما كان عليه اعداءهم من قريش وغيرهم كانه قيل والذين طهرهم الله مما انتم عليه {ومن يفعل ذلك} اي المذكور {يلق اثاما} جزاء الاثم
 
 يضاعف له العذاب يوم القيامة ويخلد فيه مهانا ()
 {يضاعف} بدل من يلق لانهما في معني واحد اذ مضاعفة العذاب هي لقاء الاثام كقوله ...
 
 متي تاتنا تلمم بنا في ديارنا ... تجد حطبا جزلا ونارا تاججا ...
 فجزم تلمم لانه بمعني تاتنا اذ الاتيان هو الالمام يضعف مكي ويزيد ويعقوب يضعف شامي يضاعف ابو بكر علي الاستءناف او علي الحال ومعني يضاعف {له العذاب يوم القيامة} اي يعذب علي مرور الايام في الاخرة عذابا علي عذاب وقيل اذا ارتكب المشرك معاصي مع الشرك عذب علي الشرك وعلي المعاصي جميعا فتضاعف العقوبة لمضاعفة العذاب المعاقب عليه {ويخلد} جزمه جازم يضاعف ورفعه رافعه لانه معطوف عليه {فيه} في العذاب فيهي مكي وحفص بالاشباع وانما خص حفص الاشباع بهذه الكلمة مبالغة في الوعيد والعرب تمد للمبالغة مع ان الاصل في هاء الكناية الاشباع {مهانا} حال اي ذليلا
 
 الا من تاب وامن وعمل عملا صالحا فاولءك يبدل الله سيءاتهم حسنات وكان الله غفورا رحيما ()
 {الا من تاب} عن الشرك وهو استثناء من الجنس في موضع النصب {وامن} بمحمد عليه الصلاة والسلام {وعمل عملا صالحا} بعد توبته {فاولءك يبدل الله سيءاتهم حسنات} اي يوفقهم للمحاسن بعد القباءح او يمحوها بالتوبة ويثبت مكانها الحسنات الايمان والطاعة ولم يرد به ان السيءة بعينها حسنة ولكن المراد ما ذكرنا يبدل مخففا البرجمي {وكان الله غفورا} يكفر السيات {رحيما} يبدلها بالحسنات
 
 ومن تاب وعمل صالحا فانه يتوب الي الله متابا ()
 {ومن تاب وعمل صالحا فانه يتوب الي الله متابا} اي ومن تاب وحقق التوبة بالعمل الصالح فانه يتوب بذلك الي الله تعالي متابا مرضيا عنده مكفرا للخطايا محصلا للثواب
 
 والذين لا يشهدون الزور واذا مروا باللغو مروا كراما ()
 {والذين لا يشهدون الزور} اي الكذب يعني ينفرون عن محاضر الكذابين ومجالس الخطاءين فلا
 الفرقان (  )
 يقربونها تنزها عن مخالطة الشر واهله
 
 اذ مشاهدة الباطل شركة فيه وكذلك النظارة الي ما لم تسوغه الشريعة هم شركاء فاعليه في الاثام لان حضورهم ونظرهم دليل الرضا وسبب وجود الزيادة فيه وفي مواعظ عيسي عليه السلام اياكم ومجالسة الخاطءين او لا يشهدون شهادة الزور علي حذف المضاف وعن قتادة المراد مجالس الباطل وعن ابن الحنفية لا يشهدون اللهو والغناء {واذا مروا باللغو} بالفحش وكل ما ينبغي ان يلغي ويطرح والمعني واذا مروا باهل اللغو والمشتغلين به {مروا كراما} معرضين مكرمين انفسهم عن التلوث به كقوله واذا سمعوا اللغو عرضوا عنه وعن الباقر رضي الله عنه اذا ذكروا الفروج كنوا عنها
 
 والذين اذا ذكروا بايات ربهم لم يخروا عليها صما وعميانا ()
 {والذين اذا ذكروا بايات ربهم} اي قرء عليهم القران اووعظوا بالقران {لم يخروا عليها صما وعميانا} هذا ليس بنفي الخرور بل هو اثبات له ونفي الصم والعمي ونحوه لا يلقاني زيد مسلما هو نفي للسلام لا للقاء يعني انهم اذا ذكروا بها خروا سجدا وبكيا سامعين باذان واعية مبصرين بعيون راعية لما امروا به ونهوا عنه لا كالمنافقين واشباههم دليله قوله تعالي وممن هدينا واجتبينا اذا تتلي عليهم ايات الرحمن خروا سجدا وبكيا
 
 والذين يقولون ربنا هب لنا من ازواجنا وذرياتنا قرة اعين واجعلنا للمتقين اماما ()
 {والذين يقولون ربنا هب لنا من ازواجنا} من البيان كانه قيل هب لنا قرة اعين ثم بينت القرة وفسرت بقوله من ازواجنا {وذرياتنا} ومعناه ان يجعلهم الله لهم قرة اعين وهو من قولهم رايت منك اسدا اي انت اسد او للابتداء علي معني هب لنا من جهنم ما تقربه عيوننا من طاعة وصلاح وذريتنا ابو عمرو وكوفي غير حفص لارادة الجنس وغيرهم ذرياتنا {قرة اعين} وانما نكر لاجل تنكير القرة لان المضاف لا سبيل الي تنكيره الا بتنكير المضاف اليه كانه قال هب لنا منهم
 
 سرورا وفرحا وانما قيل اعين علي القلة دون عيون لان المراد اعين المتقين وهي قليلة بالاضافة الي عيون غيرهم قال الله تعالي وقليل من عبادي الشكور ويجوز ان يقال في تنكير اعين انها اعين خاصة وهي اعين المتقين والمعني انهم سالوا ربهم ان يرزقهم ازواجا واعقابا عمالا لله تعالي بسرون بمكانهم وتقربهم عيونهم وقيل ليس شء اقر لعين المءمن من ان يري زوجته واولاده مطيعين لله تعالي وعن ابن عباس رضي الله تعالي عنهما هو الولد اذا راه يكتب الفقه {واجعلنا للمتقين اماما} اي اءمة يقتدون بنا في الدين فاكتفي بالواحد لدلالته علي الجنس ولعدم اللبس او واجعل كل واحد منا اماما قيل في الاية ما يدل علي ان الرياسة في الدين يجب ان تطلب ويرغب فيها
 
 اولءك يجزون الغرفة بما صبروا ويلقون فيها تحية وسلاما ()
 {اولءك يجزون الغرفة} اي الغرفات وهي العلالي في الجنة فوحد اقتصارا علي الواحد الدال علي الجنس دليله وهم في الغرفات امنون {بما صبروا} اي بصبرهم علي الطاعات وعن الشهوات وعلي اذي الكفار
 الفرقان (  )
 الشعراء (  )
 ومجاهدتهم وعلي الفقر وغير ذلك {ويلقون فيها} ويلقون كوفي غير حفص {تحية} دعاء بالتعمير {وسلاما} ودعاء بالسلامة يعني ان الملاءكة يحيونهم ويسلمون عليهم او يحيي بعضهم بعضا ويسلم عليه
 
 خالدين فيها حسنت مستقرا ومقاما ()
 {خالدين فيها} حال {حسنت} اي الغرفة {مستقرا ومقاما} موضع قرار واقامة وهي في مقابلة ساءت مستقرا ومقاما
 
 قل ما يعبا بكم ربي لولا دعاءكم فقد كذبتم فسوف يكون لزاما ()
 {قل ما يعبا بكم ربي لولا دعاءكم} ما متضمنة لمعني الاستفهام وهي في محل النصب ومعناه ما يصنع بكم ربي لولا دعاءه اياكم الي الاسلام او لولا عبادتكم له اي انه خلقكم لعبادته كقوله وما خلقت الجن والانس الا ليعبدون اي الاعتبار عند ربكم لعبادتكم او ما يصنع
 
 بعذابكم لولا دعاءكم معه الهة وهو كقوله تعالي ما يفعل الله بعذابكم ان شكرتم {فقد كذبتم} رسولي يا اهل مكة {فسوف يكون} العذاب {لزاما} اي ذا لزام او ملازما وضع مصدر لازم موضع اسم الفاعل وقال الضحاك ما يعبا ما يبالي بمغفرتكم لولا دعاءكم معه الها اخر
 
 سورة الشعراء مكية وهي ماءتان وعشرون وسبع ايات
 بسم الله الرحمن الرحيم
 
 طسم ()
 {طسم} طس ويس وحم ممالة كوفي غير الاعشي والبرجمي وحفص ويظهر النون عند الميم يزيد وحمزة وغيرهما يدغمها
 
 تلك ايات الكتاب المبين ()
 {تلك ايات الكتاب المبين} الظاهر اعجازه وصحة انه من عند الله والمراد به السورة او القران والمعني ايات هذا المءلف من الحروف المبسوطة تلك ايات الكتاب المبين
 
 لعلك باخع نفسك الا يكونوا مءمنين ()
 {لعلك باخع} قاتل ولعل للاشفاق {نفسك} من الحزن يعني اشفق علي نفسك ان تقتلها حسرة وحزنا علي ما فاتك من اسلام قومك {الا يكونوا مءمنين} لءلا يءمنوا او لا متناع ايمانهم او خيفة ان لا يءمنوا
 
 ان نشا ننزل عليهم من السماء اية فظلت اعناقهم لها خاضعين ()
 {ان نشا} ايمانهم {ننزل عليهم من السماء اية} دلالة واضحة {فظلت} اي فتظل لان الجزاء يقع فيه لفظ الماضي في معني المستقبل تقول ان زرتني اكرمتك اي اكرمك كذا قاله الزجاج {اعناقهم} رءساءهم ومقدموهم او جماعتهم يقال جاءنا عنق من الناس لفوج منهم {لها خاضعين} منقادين وعن ابن عباس رضي الله عنهما نزلت فينا وفي بني امية فتكون لنا عليهم الدولة
 الشعراء (  )
 فتذل لنا اعناقهم بعد صعوبة ويلحقهم هوان بعد عزة
 
 وما ياتيهم من ذكر من الرحمن محدث الا كانوا عنه معرضين ()
 {وما ياتيهم من ذكر من الرحمن محدث الا كانوا عنه معرضين} اي وما يجدد لهم الله
 
 بوحيه موعظة وتذكيرا الا جددوا اعراضا عنه وكفروا به
 
 فقد كذبوا فسياتيهم انباء ما كانوا به يستهزءون ()
 {فقد كذبوا} محمدا صلي الله عليه وسلم فيما اتاهم به {فسياتيهم} فيسعلمون {انباء} اخبار {ما كانوا به يستهزءون} وهذا وعيد لهم وانذار بانهم سيعلمون اذا مسهم عذاب الله يوم بدر او يوم القيامة ما الشء الذي كانوا يستهزءون به وهو القران وسياتيهم انباءه واحواله التي كانت خافية عليهم
 
 اولم يروا الي الارض كم انبتنا فيها من كل زوج كريم ()
 {او لم يروا الي الارض كم انبتنا} كم نصب بانبتنا {فيها من كل زوج} صنف من النبات {كريم} محمود كثير المنفعة ياكل منه الناس والانعام كالرجل الكريم الذي نفعه عام وفاءدة الجمع بين كلمتي الكثرة والاحاطة ان كلمة كل تدل علي الاحاطة بازواج النبات علي سبيل التفصيل وكم تدل علي ان هذا المحيط متكاثر مفرط الكثرة وبه نبه هلي كمال قدرته
 
 ان في ذلك لاية وما كان اكثرهم مءمنين ()
 {ان في ذلك لاية وما كان اكثرهم مءمنين} اي ان في انبات تلك الاصناف لاية علي ان منبتها قادر علي احياء الموتي وقد علم الله ان اكثرهم مطبوع علي قلوبهم غير مرجي ايمانهم
 
 وان ربك لهو العزيز الرحيم ()
 {وان ربك لهو العزيز} في انتقامه من الكفرة {الرحيم} لمن امن منهم ووحد اية مع الاخبار بكثرتها لان ذلك مشار به الي مصدر انبتنا والمراد ان في كل واحدي من تلك الازواج لاية اي اية
 
 واذ نادي ربك موسي ان اءت القوم الظالمين ()
 {واذ} مفعول به اي اذكر اذ {نادي} دعا ربك موسي ان اءت ان بمعني اي {القوم الظالمين} انفسهم بالكفر وبني اسراءيل بالاستعباد وذبح الاولاد سجل عليهم بالظلم ثم عطف
 
 قوم فرعون الا يتقون ()
 {قوم فرعون} عليهم عطف البيان كان معني القوم الظالمين وترجمته قوم فرعون وكانهما عبارتان تعتقبان علي مءدي واحد {الا يتقون} اي اءتهم زاجرا فقد ان لهم ان يتقوا وهي كلمة حث واغراء ويحتمل انه حال من الضمير في الظالمين اي يظلموا غير متقين الله وعقابه فادخلت همزة الانكار علي الحال
 
 قال رب اني اخاف ان يكذبون ()
 {قال رب اني اخاف} الخوف غم يلحق الانسان لامر سيقع {ان يكذبون}
 
 ويضيق صدري ولا ينطلق لساني فارسل الي هارون ()
 {ويضيق صدري} بتكذيبهم
 الشعراء (  )
 اياي مستانف او عطف علي اخاف {ولا ينطلق لساني} بان تغلبني الحمية علي ما اري من المحال واسمع من الجدال وبنصبهما يعقوب عطفا علي يكذبون فالخوف متعلق بهذه الثلاثة علي هذا التقدير وبالتكذيب وحده بتقدير الرفع {فارسل الي هارون} اي ارسل اليه جبريل واجعله نبيا يعينني علي الرسالة وكان هرون بمصر حين بعث موسي نبيا بالشام ولم يكن هذا الالتماس من موسي عليه السلام توقفا في الامتثال بل التماس عون في تبليغ الرسالة وتمهيد العذر في التماس المعين علي تنفيذ الامر ليس بتوقف في امتثال الامر وكفي بطلب العون دليلا علي التقبل لا علي التعلل
 
 ولهم علي ذنب فاخاف ان يقتلون ()
 {ولهم علي ذنب} اي تبعة ذنب بقتل القبطي فحذف المضاف او سمي تبعة الذنب ذنبا كما سمي جزاء السيءة سيءة {فاخاف ان يقتلون} اي يقتلوني به قصاصا وليس هذا تعللا ايضا بل استدفاع للبلية المتوقعة وفرق من ان يقتل قبل اداء الرسالة ولذا وعده بالكلاءة والدفع بكلمة الردع وجمع له الاستجابتين معا في قوله
 
 قال كلا فاذهبا باياتنا انا معكم مستمعون ()
 {قال كلا فاذهبا} لانه استدفعه بلاءهم فوعده الله الدفع بردعه عن الخوف والتمس منه رسالة اخيه فاجابه بقوله اذهبا اي جعلته رسولا معك فاذهبا وعطف فاذهبا علي الفعل الذي يدل عليه كلا كانه قيل ارتدع يا موسي عما تظن فاذهب انت وهرون {باياتنا} مع اياتنا وهي اليد والعصا وغير ذلك {انا معكم} اي معكما بالعون والنصرة ومع من ارسلتما اليه بالعلم والقدرة {مستمعون} خبر لان ومعكم لغو او هما خبران اي سامعون والاستماع في غير هذا الاصغاء للسماع يقال استمع فلان حديثه اي اصغي اليه ولا يجوز حمله ههنا علي ذلك فحمل علي السماع
 
 فاتيا فرعون فقولا انا رسول رب العالمين ()
 {فاتيا فرعون فقولا انا رسول رب العالمين} لم يثن الرسول كما ثني في قوله انا رسولا ربك لان الرسول يكون بمعني المرسل وبمعني الرسالة فجعل ثمة بمعني المرسل فلم يكن بد من تثنيته وجعل هنا بمعني الرسالة فيستوي في الوصف به الواحد والتثنية والجمع ولانهما لاتحادهما واتفاقهما علي شريعة واحدة كانهما رسول واحد او اريد ان كل واحد منا
 
 ان ارسل معنا بني اسراءيل ()
 {ان ارسل} بمعني ارسل لتضمن الرسول معني الارسال وفيه معني القول {معنا بني اسراءيل} يريد خلهم يذهبوا معنا الي فلسطين وكانت مسكنهما فاتيا بابه فلم يءذن لهما سنة حتي قال البواب ان ههنا انسانا يزعم انه رسول رب العالمين فقال اءذن له لعلنا نضحك منه فاديا اليه الرسالة فعرف فرعون موسي فعند ذلك
 
 قال الم نربك فينا وليدا ولبثت فينا من عمرك سنين ()
 {قال الم نربك فينا وليدا} وانما حذف فاتيا فرعون فقالا اختصارا والوليد الصبي لقرب عهده من الولادة اي الم تكن
 الشعراء (  )
 صغيرا فربيناك {ولبثت فينا من عمرك سنين} قيل ثلاثين سنة
 
 وفعلت فعلتك التي فعلت وانت من الكافرين ()
 {وفعلت فعلتك التي فعلت} يعني قتل القبطي فعرض اذ كان ملكا {وانت من الكافرين} بنعمتي حيث قتلت خبازي او كنت علي ديننا الذي تسميه كفرا وهذا افتراء منه عليه لانه معصوم من الكفر وكان يعايشهم بالتقية
 
 قال فعلتها اذا وانا من الضالين ()
 {قال فعلتها اذا} اي اذ ذاك {وانا من الضالين} الجاهلين بانها تبلغ القتل والضال عن الشء هو الذاهب عن معرفته او الناسين من قوله ان تضل احداهما فتذاكر احداهما الاخري فدفع وصف الكفر عن نفسه ووضع الضالين موضع الكافرين واذا جواب وجزاء معا وهذا الكلام وقع جوابا لفرعون وجزاء له لان قول فرعون وفعلت فعلتك معناه انك جازيت نعمتي بما فعلت فقال له موسي نعم
 
 فعلتها مجازيا لك تسليما لقوله لان نعمته كانت جديرة بان تجازي بنحو ذلك الجزاء
 
 ففررت منكم لما خفتكم فوهب لي ربي حكما وجعلني من المرسلين ()
 {ففررت منكم} الي مدين {لما خفتكم} ان تقتلوني وذلك حين قال له مءمن من ال فرعون ان الملا ياتمرون بك ليقتلوك فاخرج الاية {فوهب لي ربي حكما} نبوة وعلما فزال عني الجهل والضلالة {وجعلني من المرسلين} من جملة رسله
 
 وتلك نعمة تمنها علي ان عبدت بني اسراءيل ()
 {وتلك نعمة تمنها علي ان عبدت بني اسراءيل} كر علي امتنانه عليه بالتربية فابطله من اصله وابي ان تمسي نعمة لانها نقمة حيث بين ان حقيقة انعامه عليه تعبيد بني اسراءيل لان تعبيدهم وقصدهم بذبح ابناءهم هو السبب في حصوله عنده وتربيته ولو تركهم لرباه ابواه فكان فرعون امتن علي موسي بتعبيد قومه واخراجه من حجر ابويه اذا حققت وتعبيدهم تذليلهم واتخاذهم عبيدا ووحد الضمير في تمنها وعبدت وجمع في منكم وخفتكم لان الخوف والفرار لم يكونا منه وحده ولكن منه ومن ملته المءتمرين بقتله بدليل قوله ان الملا ياتمرون بك ليقتلوك واما الامتنان فمنه وحده وكذا التعبيد وتلك اشارة الي خصلة شنعاء مبهمة لا يدري ما هي الا بتفسيرها ومحل ان عبدت الرفع عطف بيان لتلك اي تعبيدك بني اسراءيل نعمة تمنها علي
 
 قال فرعون وما رب العالمين ()
 {قال فرعون وما رب العالمين} اي انك تدعي انك رسول رب العالمين فما صفته لانك اذا اردت السءال عن صفة زيد تقول ما زيد تعني اطويل ام قصير افقيه ام طبيب نص عليه صاحب الكشاف وغيره
 
 قال رب السماوات والارض وما بينهما ان كنتم موقنين ()
 {قال} موسي مجيبا له علي وفق سءاله {رب السماوات والارض وما بينهما} اي وما بين الجنسين {ان كنتم موقنين} اي ان كنتم تعرفون الاشياء
 
 بالدليل فكفي خلق
 الشعراء (  )
 هذه الاشياء دليلا او ان يرجي منكم الايقان الذي يءدي اليه النظر الصحيح نفعكم هذا الجواب والالم ينفع والايقان العلم الذي يستفاد بالاستدلال ولذا لا يقال الله موقن
 
 قال لمن حوله الا تستمعون ()
 {قال} اي فرعون {لمن حوله} من اشراف قومه وهم خمسماءة رجل عليهم الاساور وكانت للملوك خاصة {الا تستمعون} معجبا قومه من جوابه لانهم يزعمون قدمهما وينكرون حدوثهما وان لهما ربا فاحتاج موسي الي ان يستدل بما شاهدوا حدوثه وفناءه فاستدل حيث
 
 قال ربكم ورب اباءكم الاولين ()
 {قال ربكم ورب اباءكم الاولين} اي هو خالقكم وخالق اباءكم فان لم تستدلوا بغيركم فبانفسكم وانما قال رب اباءكم لان فرعون كان يدعي الربوبية علي اهل عصره دون من تقدمهم
 
 قال ان رسولكم الذي ارسل اليكم لمجنون ()
 {قال} اي فرعون {ان رسولكم الذي ارسل اليكم لمجنون} حيث يزعم ان في الوجود الها غيري وكان فرعون ينكر الهية غيره
 
 قال رب المشرق والمغرب وما بينهما ان كنتم تعقلون ()
 {قال رب المشرق والمغرب وما بينهما ان كنتم تعقلون} فتستدلون بما اقول فتعرفون ربكم وهذا غاية الارشاد حيث عمم اولا بخلق السموات والارض وما بينهما ثم خصص من العام البيان انفسهم واباءهم لان اقرب المنظور فيه من العاقل نفسه ومن ولد منه وما شاهد من احواله من وقت ميلاده الي وقت وفاته ثم خصص المشرق والمغرب لان طلوع الشمس من احد الخافقين وغروبها في الاخر علي تقدير مستقيم في فصول السنة وحساب مستومن اظهر ما استدل به ولظهوره انتقل الي الاحتجاج به خليل الرحمن عن الاحتجاج بالاحياء والاماتة علي نمرودين كنعان وقيل ساله فرعون عن الماهية جاهلا عن حقيقة سءاله فلما اجاب موسي بحقيقة الجواب وقع عنده ان موسي حاد عن الجواب حيث ساله عن الماهية وهو يجيب عن ربوبيته
 
 واثار صنعه فقال معجبا لهم من جواب موسي الا تستمعون فعاد موسي الي مثل قوله الاول فجننه فرعون زاعما انه حاءد عن الجواب فعاد ثالثا الي مثل كلامه الاول مبينا ان الفرد الحقيقي انما يعرف بالصفات وان السءال عن الماهية محال واليه الاشارة في قوله تعالي ان كنتم تعقلون اي ان كان لكم عقل علمكم انه لا تمكن معرفته الا بهذا الطريق فلما تحير فرعون ولم يتهيا له ان يدفع ظهور اثار صنعه
 
 قال لءن اتخذت الها غيري لاجعلنك من المسجونين ()
 {قال لءن اتخذت الها غيري} اي غيري الها {لاجعلنك من المسجونين} اي لاجعلنك واحدا ممن عرفت حالهم في سجوني وكان من عادته ان ياخذ من يريد سجنه فيطرحه في هوة ذاهبة في الارض بعيدة العمق فردا لا يبصر فيها ولا يسمع فكان ذلك اشد من القتل ولو قيل لاسجننك لم يءد هذا المعني وان كان اخصر
 
 قال اولو جءتك بشء مبين ()
 {قال اولو جءتك} الواو للحال دخلت عليها همزة الاستفهام اي اتفعل
 الشعراء (  )
 بي ذلك ولو جءتك {بشء مبين} اي جاءيا بالمعجزة
 
 قال فات به ان كنت من الصادقين ()
 {قال فات به} بالذي يبين صدقك {ان كنت من الصادقين} ان لك بينة وجواب الشرط مقدر اي فاحضره
 
 فالقي عصاه فاذا هي ثعبان مبين ()
 {فالقي عصاه فاذا هي ثعبان مبين} ظاهر الثعبانية لا شء يشبه الثعبان كما تكون الاشياء المزورة بالشعوذة والسحر روي ان العصا ارتفعت في السماء قدر ميل ثم الخطت مقبلة الي فرعون وجعلت تقول يا موسي مرني بما شءت ويقول فرعون اسالك بالذي ارسلك الا اخذتها فاخذها فعادت عصا
 
 ونزع يده فاذا هي بيضاء للناظرين ()
 {ونزع يده فاذا هي بيضاء للناظرين} فيه دليل علي ان بياضها كان شء يجتمع النظارة علي النظر اليه لخروجه عن العادة وكان بياضها نوريا روي ان
 
 فرعون لما ابصر الاية الاولي قال فهل غيرها فاخرج يده فقال لفرعون ما هذه قال فرعون يدك فادخلها في ابطه ثم نزعها ولها شعاع يكاد يغشي الابصار ويسد الافق
 
 قال للملا حوله ان هذا لساحر عليم ()
 {قال} اي فرعون {للملا حوله} هو منصوب نصبين نصب في اللفظ والعامل فيه ما يقدر في الظرف ونصب في المحل وهو النصب علي الحال من الملا اي كاءنين حوله والعامل فيه قال {ان هذا لساحر عليم} بالسحر ثم اغوي قومه علي موسي بقوله
 
 يريد ان يخرجكم من ارضكم بسحره فماذا تامرون ()
 {يريد ان يخرجكم من ارضكم بسحره فماذا} منصوب لانه مفعول به من قولك امرتك الخير {تامرون} تشيرون في امره من حبس او قتل من المءامرة وهي المشاورة او من الامر الذي هو ضد النهي لما تحير فرعون برءية الايتين وزل عنه ذكر دعوي الالهية وحط عن منكبيه كبرياء الربوبية وارتعدت فراءضه خوفا طفق يءامر قومه الذين هم بزعمه عبيده وهو الههم او جعلهم امرين ونفسه مامورا
 
 قالوا ارجه واخاه وابعث في المداءن حاشرين ()
 {قالوا ارجه واخاه} اخر امرهما ولا تباغت قتلهما خوفا من الفتنة {وابعث في المداءن حاشرين} شرطا يحشرون السحرة وعارضوا قول فرعون ان هذا لساحر عليم بقولهم
 
 ياتوك بكل سحار عليم ()
 {ياتوك بكل سحار عليم} فجاءوا بكلمة الاحاطة وصيغة المبالغة ليسكنوا بعض قلقه
 
 فجمع السحرة لميقات يوم معلوم ()
 {فجمع السحرة لميقات يوم معلوم} اي يوم الزينة وميقاته وقت الضحي لانه الوقت الذي وقته لهم موسي عليه السلام من يوم الزينة في قوله تعالي موعدكم يوم الزينة وان يحشر الناس ضحي والميقات ما وقت به احد اي حدد من زمان او مكان ومنه مواقيت الاحرام
 
 وقيل للناس هل انتم مجتمعون ()
 {وقيل للناس هل انتم مجتمعون} اي اجتمعوا وهو استبطاء لهم في الاجتماع والمراد منه استعجالهم
 الشعراء (  )
 
 لعلنا نتبع السحرة ان كانوا هم الغالبين ()
 {لعلنا نتبع السحرة} في دينهم {ان كانوا هم الغالبين} اي غلبوا موسي في دينه وليس غرضهم اتباع السحرة وانما الغرض الكلي ان لا يتبعوا موسي فساقوا الكلام مساق الكناية لانهم اذا اتبعوهم لم يكونوا متبعين لموسي
 
 فلما جاء السحرة قالوا لفرعون اءن لنا لاجرا ان كنا نحن الغالبين () قال نعم وانكم اذا لمن المقربين ()
 {فلما جاء السحرة قالوا لفرعون اءن لنا لاجرا ان كنا نحن الغالبين قال نعم} وبكسر العين علي وهما لغتان {وانكم اذا لمن المقربين} اي قال فرعون نعم لكم اجر عندي وتكونون مع ذلك من المقربين عندي في المرتبة والجاه فتكونون اول من يدخل علي واخر من يخرج ولما كان قولهم اءن لنا لاجرا في معني جزاء الشرط لدلالته عليه وكان قوله وانكم اذا لمن المقربين معطوفا عليه دخلت اذا قارة في مكانها الذي تقتضيه من الجواب والجزاء
 
 قال لهم موسي القوا ما انتم ملقون ()
 {قال لهم موسي القوا ما انتم ملقون} من السحر فسوف ترون عاقبته
 
 فالقوا حبالهم وعصيهم وقالوا بعزة فرعون انا لنحن الغالبون ()
 {فالقوا حبالهم} سبعين الف حبل {وعصيهم} سبعين الف عصا وقيل كانت الحبال اثنين وسبعين الفا وكذا العصي {وقالوا بعزة فرعون انا لنحن الغالبون} اقسموا بعزته وقوته وهو من ايمان الجاهلية
 
 فالقي موسي عصاه فاذا هي تلقف ما يافكون ()
 {فالقي موسي عصاه فاذا هي تلقف} تبتلع {ما يافكون} ما يقلبونه عن وجهه وحقيقته بسحرهم ويزورونه ويخيلون في حبالهم وعصيهم انها حيات تسعي
 
 فالقي السحرة ساجدين ()
 {فالقي السحرة ساجدين} عبر عن الخرور بالالقاء بطريق المشاكلة لانه
 
 ذكر مع الالقاات ولانهم لسرعة ما سجدوا صاروا كانهم القوا
 
 قالوا امنا برب العالمين ()
 {قالوا امنا برب العالمين} عن عكرمة رضي الله عنه اصبحوا سحرة وامسوا شهداء
 
 رب موسي وهارون ()
 {رب موسي وهارون} عطف بيان لرب العالمين لان فرعون كان يدعي الربوبية فارادوا ان يعزلوه وقيل ان فرعون لما سمع منهم امنا برب العالمين قال اياي عنيتم قالوا رب موسي وهرون
 
 قال امنتم له قبل ان اذن لكم انه لكبيركم الذي علمكم السحر فلسوف تعلمون لاقطعن ايديكم وارجلكم من خلاف ولاصلبنكم اجمعين ()
 {قال امنتم له قبل ان اذن لكم} بذلك {انه لكبيركم الذي علمكم السحر} وقد تواطاتم علي امر ومكر {فلسوف تعلمون} وبال ما فعلتم ثم صرح فقال {لاقطعن ايديكم وارجلكم من خلاف}
 الشعراء (  )
 من اجل خلاف ظهر منكم {ولاصلبنكم اجمعين} كانه اراد به ترهيب العامة لءلا يتبعوهم في الايمان
 
 قالوا لا ضير انا الي ربنا منقلبون ()
 {قالوا لا ضير} لا ضرر وخبر لا محذوف اي في ذلك او علينا {انا الي ربنا منقلبون}
 
 انا نطمع ان يغفر لنا ربنا خطايانا ان كنا اول المءمنين ()
 {انا نطمع ان يغفر لنا ربنا خطايانا ان كنا} لان كنا {اول المءمنين} من اهل المشهد او من رعية فرعون ارادوا لا ضرر علينا في ذلك بل لنا اعظم النفع لما يحصل لنا في الصبر عليه لوجه الله من تكفير الخطايا او لا ضير علينا فيما تتوعدنا به انه لا بد لنا من الانقلاب الي ربنا بسبب من اسباب الموت والقتل اهون اسبابه وارجاها او لا ضير علينا في قتلك انك ان قتلتنا انقلبنا الي ربنا انقلاب من يطمع في مغفرته ويرجو رحمته لما رزقنا من السبق الي الايمان
 
 واوحينا الي موسي ان اسر بعبادي انكم متبعون ()
 {واوحينا الي موسي ان اسر} وبوصل الهمزة حجازي {بعبادي} بني اسراءيل سماهم عباده لايمانهم بنبيه اي سربهم ليلا وهذا بعد سنين من
 
 ايمان السحرة {انكم متبعون} يتبعكم فرعون وقوله علل الامر بالاسراء باتباع فرعون وجنوده اثارهم يعني اني بنيت تدبير امركم وامرهم علي ان تتقدموا ويتبعوكم حتي يدخلوا مدخلكم من طريق البحر فاهلكهم وروي انه مات في تلك الليلة في كل بيت من بيوتهم ولد فاشتغلوا بموتاهم حتي خرج موسي بقومه وروي ان الله تعالي اوحي الي موسي ان اجمع بني اسراءيل كل اربعة ابيات في بيت ثم اذبح الجداء واضربوا بدماءها علي ابوابكم فاني سامر الملاءكة ان لا يدخلوا بيتا علي بابه دم وسامرهم بقتل ابكار القبط واخبزوا خبزا فطيرا فانه اسرع لكم ثم اسر بعبادي حتي تنتهي الي البحر فياتيك امري
 
 فارسل فرعون في المداءن حاشرين ()
 {فارسل فرعون في المداءن حاشرين} اي جامعين للناس بعنف فلما اجتمعوا قال
 
 ان هءلاء لشرذمة قليلون ()
 {ان هءلاء لشرذمة قليلون} والشرذمة الطاءفة القليلة ذكرهم بالاسم الدال علي القلة ثم جعلها قليلا بالوصف ثم جمع القليل فجمع كل حزب منهم قليلا واختار جمع السلامة الذي هو للقلة واراد بالقلة الذلة لا قلة العدد اي انهم لقلتهم لا يبالي بهم ولا تتوقع غلبتهم وانما استقل قوم موسي وكانوا ستماءة الف وسبعين الفا لكثرة من معه فعن الضحاك كانوا سبعة الاف الف
 
 وانهم لنا لغاءظون ()
 {وانهم لنا لغاءظون} اي انهم يفعلون افعالا تغيظنا وتضيق صدورنا وهي خروجهم من مصرنا وحملهم علينا وقتلهم ابكارنا
 
 وانا لجميع حاذرون ()
 {وانا لجميع حاذرون} شامي وكوفي وغيرهم حذرون فالحذر المتيقظ والحاذر الذي يجدد حذره وقيل المءدي في السلاح وانما يفعل ذلك حذرا واحتياطا لنفسه يعني ونحن قوم من عادتنا التيقظ والحذر
 
 واستعمال الحزم في الامور فاذا خرج علينا خارج سارعنا الي حسم فساده وهذه معاذير اعتذر بها الي اهل المداءن لءلا يظن به العجز
 الشعراء (  )
 والفتور
 
 فاخرجناهم من جنات وعيون ()
 {فاخرجناهم من جنات} بساتين {وعيون} وانهار جارية
 
 وكنوز ومقام كريم ()
 {وكنوز} واموال ظاهرة من الذهب والفضة وسماها كنوزا لانهم لا ينفقون منها في طاعة الله تعالي {ومقام} ومنزل {كريم} بهي بهيج وعن ابن عباس رضي الله عنهما المنابر
 
 كذلك واورثناها بني اسراءيل ()
 {كذلك} يحتمل النصب علي اخرجناهم مثل ذلك الاخراج الذي وصفنا والرفع علي انه خبر مبتدا محذوف اي الامر كذلك {واورثناها بني اسراءيل} عن الحسن لما عبروا النهر رجعوا واخذوا ديارهم واموالهم
 
 فاتبعوهم مشرقين ()
 {فاتبعوهم} فلحقوهم فاتبعوهم يزيد {مشرقين} حال اي داخلين في وقت شروق الشمس وهو طلوعها ادرك قوم فرعون موسي وقومه وقت طلوع الشمس
 
 فلما تراءي الجمعان قال اصحاب موسي انا لمدركون ()
 {فلما تراءي الجمعان} اي تقابلا بحيث يري كل فريق صاحبه والمراد بنو اسراءيل والقبط {قال اصحاب موسي انا لمدركون} اي قرب ان يلحقنا عدونا وامامنا البحر
 
 قال كلا ان معي ربي سيهدين ()
 {قال} موسي عليه السلام ثقة بوعد الله اياه {كلا} ارتدعوا عن سوء الظن بالله فلن يدركوكم {ان معي} معي حفص {ربي سيهدين} اي سيهديني طريق النجاة من ادراكهم واضرارهم سيهديني بالياء يعقوب
 
 فاوحينا الي موسي ان اضرب بعصاك البحر فانفلق فكان كل فرق كالطود العظيم ()
 {فاوحينا الي موسي ان اضرب بعصاك البحر} اي القلزم او النيل {فانفلق} اي فضرب فانفلق وانشتي فصار اثني عشر فرقا علي عدد الاسباط {فكان كل فرق} اي جزء تفرق منه {كالطود العظيم} كالجبل المنطاد في السماء
 
 وازلفنا ثم الاخرين ()
 {وازلفنا ثم} حيث انفلق البحر {الاخرين} قوم فرعون اي قربناهم من بني اسراءيل او من البحر
 
 وانجينا موسي ومن معه اجمعين ()
 {وانجينا موسي ومن معه اجمعين} من الغرق
 
 ثم اغرقنا الاخرين ()
 {ثم اغرقنا الاخرين} فرعون وقومه وفيه ابطال القول بتاثير الكواكب في الاجال وغيرها من الحوادث فانهم اجتمعوا في الهلاك مع اختلاف طوالعهم روي ان جبريل عليه السلام كان بين بني اسراءيل وبين ال فرعون فكان يقول لبني اسراءيل ليلحق اخركم باولكم ويستقبل القبط فيقول رويدكم يلحق اخركم باولكم فلما انتهي موسي الي البحر قال يوشع لموسي اين امرت فهذا البحر امامك وغشيك ال فرعون قال موسي ههنا فخاض يوشع الماء وضرب موسي بعصاه البحر فدخلوا وروي ان موسي عليه الصلاة والسلام قال عند ذلك يا من كان قبل كل شء والمكون لكل شء والكاءن بعد كل شء
 
 ان في ذلك لاية وما كان اكثرهم مءمنين ()
 {ان في ذلك} اي فيما فعلنا
 الشعراء (  )
 بموسي وفرعون {لاية} لعبرة عجيبة لا توصف {وما كان اكثرهم} اي المغرقين {مءمنين} قالوا لم يءمن منهم الا اسية وحزقيل مءمن ال فرعون ومريم التي دلت موسي علي قبر يوسف
 
 وان ربك لهو العزيز الرحيم ()
 {وان ربك لهو العزيز} بالانتقام من اعداءه {الرحيم} بالانعام علي اولياءه
 
 واتل عليهم نبا ابراهيم ()
 {واتل عليهم} علي مشركي قريش {نبا ابراهيم} خبره
 
 اذ قال لابيه وقومه ما تعبدون ()
 {اذ قال لابيه وقومه} قوم ابراهيم او قوم الاب {ما تعبدون} اي اي شء تعبدون وابراهيم عليه السلام يعلم انهم عبدة الاصنام ولكنه سالهم ليريهم ان ما يعبدونه ليس بمستحق للعبادة
 
 قالوا نعبد اصناما فنظل لها عاكفين ()
 {قالوا نعبد اصناما} وجواب ما تعبدون اصناما كيسءلونك ماذا ينفقون قل العفو ماذا قال ربكم قالوا الحق
 
 لانه سءال عن المعبود لا عن العبادة وانما زادوا نعبد في الجواب افتخارا ومباهاة بعبادتها ولذا عطفوا علي نعبد {فنظل لها عاكفين} فقيم علي عبادتها طول النهار وانما قالوا فنظل لانهم كانوا يعبدونها بالنهار دون الليل او معناه الدوام
 
 قال هل يسمعونكم اذ تدعون ()
 {قال} اي ابراهيم {هل يسمعونكم} هل يسمعون دعاءكم علي حذف المضاف لدلالة {اذ تدعون} عليه
 
 او ينفعونكم او يضرون ()
 {او ينفعونكم} ان عبدتموها {او يضرون} ان تركتم عبادتها
 
 قالوا بل وجدنا اباءنا كذلك يفعلون ()
 {قالوا بل} اضراب اي لا تسمع ولا تنفع ولا تضر ولا نعبدها لشء من ذلك ولكن {وجدنا اباءنا كذلك يفعلون} فقلدناهم
 
 قال افرايتم ما كنتم تعبدون ()
 {قال افرايتم ما كنتم تعبدون}
 
 انتم واباءكم الاقدمون ()
 {انتم واباءكم الاقدمون} الاولون
 
 فانهم عدو لي الا رب العالمين ()
 {فانهم} اي الاصنام {عدو لي} والعدو والصديق يجيءان في معني الوحدة والجماعة يعني لو عبدتهم لكانوا اعداء لي في يوم القيامة كقوله سيكفرون بعبادتهم ويكونون عليهم ضدا وقال الفراء هو من المقلوب اي فاني عدوهم وفي قوله عدو لي دون لكم زيادة نصح ليكون ادعي لهم الي القبول ولو قال فانهم عدو لكم لم يكون بتلك المثابة {الا رب العالمين} استثناء منقطع لانه لم يدخل تحت الاعداء كانه قال لكن رب العالمين
 
 الذي خلقني فهو يهدين ()
 {الذي خلقني} بالتكوين في القرار المكين {فهو يهدين} لمناهج الدنيا ولمصالح الدين والاستقبال في يهديني مع سبق العناية لانه يحتمل يهديني للاهم الافضل والاتم الاكمل او الذي خلقني لاسباب خدمته فهو يهديني الي اداب خلته
 
 والذي هو يطعمني ويسقين ()
 {والذي هو يطعمني} اضاف الاطعام الي ولي الانعام لان لركون الي الاسباب عادة الانعام {ويسقين} قال ابن عطاء هو الذي يحييني بطعامه ويرويني بشرابه
 الشعراء (  )
 
 واذا مرضت فهو يشفين ()
 {واذا مرضت} وانما لم يقل امرضني لانه قصد الذكر بلسان الشكر فلم يضف اليه ما يقتضي الضر قال ابن عطاء واذا مرضت برءية الخلق {فهو يشفين} بمشاهدة الحق قال الصادق اذا مرضت برءية الافعال فهو يشفين بكشف منة الافضال
 
 والذي يميتني ثم يحيين ()
 {والذي يميتني ثم يحيين} ولم يقل اذا مت لانه الخروج من حبس البلاء ودار الفناء الي روض البقاء لوعد اللقاء وادخل ثم في الاحياء لتراخيه عن الافناء وادخل الفاء في الهداية والشفاء لانهما يعقبان الخلق والمرض لامعا معا
 
 والذي اطمع ان يغفر لي خطيءتي يوم الدين ()
 {والذي اطمع} طمع العبيد في الموالي بالافضال لا علي الاستحقاق بالسءال {ان يغفر لي خطيءتي} قيل هو قوله اني سقيم بل فعله كبيرهم هذا ربي للبازغ هي اختي لسارة وما هي الا معاريض جاءزة وليست بخطايا يطلب لها الاستغفار واستغفار الانبياء تواضع منهم لربهم وهضم لانفسهم وتعليم للامم في طلب المغفرة {يوم الدين} يوم الجزاء
 
 رب هب لي حكما والحقني بالصالحين ()
 {رب هب لي حكما} حكمة او حكما بين الناس بالحق او نبوة لان النبي عليه السلام ذو حكمة وذو حكم بين عباد الله {والحقني بالصالحين} اي الانبياء ولقد اجابه حيث قال وانه في الاخرة لمن الصالحين
 
 واجعل لي لسان صدق في الاخرين ()
 {واجعل لي لسان صدق في الاخرين} اي ثناء حسنا وذكرا جميلا في الامم التي تجء بعدي فاعطي ذلك فكل اهل دين يتولونه ويثنون عليه ووضع اللسان موضع القول لان القول يكون به
 
 واجعلني من ورثة جنة النعيم ()
 {واجعلني من} يتعلق بمحذوف اي وارثا من {ورثة جنة النعيم} اي من الباقين فيها
 
 واغفر لابي انه كان من الضالين ()
 {واغفر لابي} اجعله اهل المغفرة باعطاء الاسلام وكان وعده الاسلام يوم فارقه {انه كان من الضالين} الكافرين
 
 ولا تخزني يوم يبعثون ()
 {ولا تحزني} الاخزاء من الخزي وهو الهوان او من الخزاية وهو الحياء وهذا نحو الاستغفار كما بينا {يوم يبعثون} الضمير فيه للعباد لانه معلوم او للضالين وان يجعل من جملة الاستغفار لابيه اي ولا تخزني في يوم يبعث الضالون وابي فيهم
 
 يوم لا ينفع مال ولا بنون ()
 {يوم لا ينفع مال} هو بدل من يوم الاول {ولا بنون} احدا
 
 الا من اتي الله بقلب سليم ()
 {الا من اتي الله بقلب سليم} عن الكفر والنفاق فقلب الكافر والمنافق مريض لقوله تعالي في قلوبهم مرض اي ان المال اذا صرف في وجوه البر وبنوه صالحون فانه ينتفع به وبهم سليم القلب او جعل المال والبنون في معني الغني كانه قيل يوم لا ينفع غني الا غني من اتي الله بقلب سليم لان غني الرجل في دينه بسلامة قلبه كما ان غناه في دنياه بماله وبينه وقد جعل من مفعولا لينفع اي لا ينفع مال ولا بنون الا رجلا قلبه مع ماله حيث انفقه في طاعة الله ومع بنيه
