 $  س النساءي سالم بن ابي الجعد قال حدثت عن كعب بن مرة البهزي في العتق روي عن سالم عن شرحبيل بن السمط عن كعب بن مرة
 $  س النساءي سعد بن ابراهيم عن بعض ال سعد روي عن سعد بن ابراهيم عن عامر بن سعد عن ابيه
 $  ق بن ماجة سعد بن سعيد المقبري عن اخيه عن ابيه عن ابي هريرة لا قطع في ثمر ولا كثر اسم اخيه عبد الله بن ابي سعيد
 $  د ت س ابي داود والترمذي والنساءي سعد بن عثمان الدشتكي عن رجل من اصحاب النبي صلي الله عليه وسلم راه ببخاري قيل انه عبد الله بن خازم امير خراسان
 $  م مسلم سعد بن مالك ابو سعيد الخدري عن رجل من وفد عبد القيس قال في القوم رجل اصابته جراحة قال وكنت اخبا الجراحة حياء من رسول الله صلي الله عليه وسلم فقلت يا رسول الله فيما اشرب قال في اسقية الادم الحديث فهذا صحابي مبهم لم يذكره المزي 
 $  د س ابي داود والنساءي سعيد بن جبير عن رجل عنده رضي عن عاءشة في النوم عن صلاة الليل هو الاسود بن يزيد النخعي
 $  س النساءي سعيد بن ابي سعيد المقبري عن اخيه عن ابي هريرة في التعوذ اسمه عباد
 $  سعيد المقبري عن رجل عن كعب بن عجرة هو ابو ثمامة الخياط
 $  د ابي داود سعيد بن عبد العزيز عن مولي يزيد بن نمران قيل اسم المولي سعيد ايضا ذكره البخاري وابن ابي حاتم
 $  د ابي داود سعيد بن ابي عروبة عن صاحب له عن ابي المليح عن ابيه في الصلاة في الرحال يوم المطر زاد كان يوم الجمعة هو قتادة ابو قلابة
 $  س النساءي سعيد بن ابي عروبة عن بعض اصحابه عن عبد الله بن بريدة عن ابي موسي افطر الحاجم والمحجوم روي سعيد عن ابي مالك عن بن بريدة 
 $  س النساءي سفيان الثوري عن رجل عن الحسن قوله روي عن سفيان عن عبيد الصيد وعن بيان واخر عن الشعبي عن وهب بن خنبش روي عن سفيان عن بيان هو جابر الجعفي
 $  س النساءي سفيان بن عيينة عن يعقوب بن عطاء وغيره عن عمرو بن شعيب كانه المثني بن الصباح كني عنه النساءي لضعفه
 $  س النساءي سليم بن اسود ابو الشعثاء المحاربي عن رجل من بني ثعلبة بن يربوع هو ثعلبة بن زهدم
 $  سليمان بن الاشعث السجستاني ابو داود قال حدثت عن سعيد بن سليمان عن سليمان بن كثير عن عمرو بن دينار عن طاوس عن بن عباس ورواه في موضع اخر عن محمد بن ابي غالب عن ابي سعيد بن سليمان وقال في موضع اخر حدثت عن ابراهيم بن سعد اسم الذي حدثه عنه احمد بن محمد بن ايوب وقال في موضع اخر حدثت عن عمر بن شقيق عن ابي جعفر الرازي عن الربيع بن انس عن ابي العالية عن ابي بن كعب في الكسوف رواه عن عمر بن شقيق من شيوخ ابي داود يحيي بن حكيم
 $  سي النساءي في اليوم والليلة سليمان التيمي عن رجل عن معقل بن يسار قلب القران يس هو ابو عثمان روي عنه سليمان عن ابي عثمان وليس بالنهدي عن ابيه عن معقل 
 $  د ابي داود سليمان بن عمرو بن الاحوص عن امه في رمي الجمرة من بطن الوادي هي ام جندب
 $  سليمان الاعمش عن رجل عن بن عمر في قضاء الحاجة لا يرفع ثوبه حتي يدنو من الارض قيل هو قاسم بن محمد
 $  د ابي داود سليمان بن الاعمش ثنا اصحاب لنا عن عروة المزني عن عاءشة في القبلة رواه غير واحد عن الاعمش عن حبيب بن ابي ثابت عن عروة وعن رجل هو القاسم بن محمد
 $  س النساءي سماك بن حرب عن رجل عن عاءشة بنت طلحة رواه جماعة عن طلحة بن يحيي عن عمته عاءشة بنت طلحة
 $  د ت س ابي داود والترمذي والنساءي سويد بن غفلة عن مصدق النبي صلي الله عليه وسلم لم يسم 
  ( حرف الشين المعجمة )
 $  س النساءي شبيب ابو روح الحمصي عن رجل من الصحابة في قراءة سورة الروم في الصبح يقال اسم هذا الصحابي الاغر
 $  شعبة عن الحكم بن عبد الحميد عن مقسم عن بن عباس في اتيان الحاءض قال شعبة حفظي مرفوع قال وقال فلان وفلان انه لا يرفعه رواه عن الحكم موقوفا ابو عبد الله الشقري وعن شعبة عن سهيل بن ابي صالح واخيه عن ابيهما عن رجل من اسلم حديث اللديغ اسم اخيه صالح وقيل عبد الله
  ( حرف الصاد المهملة )
 $  ع الستة صالح بن خوات بن جبير عمن صلي مع النبي صلي الله عليه وسلم صلاة الخوف هو سهل بن ابي حثمة
 $  د ابي داود صالح ابو الخليل عن صاحب له عن ام سلمة هو عبد الله بن الحارث بن نوفل
 $  ت الترمذي صالح بن كيسان عن رجل لم يسمه عن عقبة بن عامر في التفسير 
  ( حرف الضاد المعجمة فارغ )
 الطاء المهملة
 $  س النساءي طاوس عن رجل ادرك النبي صلي الله عليه وسلم الطواف حول الكعبة مثل الصلاة وحديث العاءد في هبته هو عبد الله بن عباس في الموضعين وعن طاوس عن رجل عن زيد بن ثابت في الرقي هو حجر المدري
 $  د ابي داود طلحة بن مصرف عن رجل عن سعد في الاستيذان هو هذيل بن شرحبيل
  ( حرف الظاء المعجمة )
  العين المهملة
 $  عابس بن ربيعة عن ام المءمنين هي عاءشة رضي الله عنها
 $  د ابي داود عامر بن عبد الله بن الزبير عن رجل من بني زريق عن ابي قتادة هو عمرو بن سليم
 $  س النساءي عامر الشعبي عن رجل من حضرموت عن زيد بن ارقم ان ثلاثة اتوا عليا في ولد او ثلاثة اشتركوا في طهر هو عبد الله بن الخليل الحضرمي وعن الشعبي عمن حدثه عن علي ابو بكر وعمر سيدا كهول اهل الجنة يروي عن الشعبي عن الحارث الاعور عن علي 
 $  ت الترمذي عامر العقيلي عن ابيه عن ابي هريرة وعنه يحيي بن ابي كثير قيل انه عقبة حكاه البخاري قلت جزم بن حبان بانه عبد الله بن شقيق فانه قال في الطبقة الثالثة من الثقات عامر بن عبد الله العقيلي روي عن ابي هريرة وعنه يحيي بن ابي كثير وابوه عبد الله بن شقيق
 $  ت ق الترمذي وابن ماجة عباد بن تميم عن عمه هو عبد الله بن زيد بن عاصم وعن رجل من الانصار لا تبقين في رقبة بعير قلادة هو ابو بشير الانصاري
 $  د ابي داود العباس بن عبد الله بن معبد بن العباس عن بعض اهله عن بن عباس عن العباس في فتح مكة من اهله الذين يروي عنهم ابوه عبد الله واخوه ابراهيم بن معبد وعكرمة مولاهم
 $  ق بن ماجة عبد الله بن ادريس عن ابيه وعمه عن جده عن يزيد واسم عمه داود
 $  س النساءي عبد الله بن بريدة انه بلغه في خضاب الشيب روي عن بن بريدة عن ابي الاسود عن ابي ذر 
 $     الاربعة عبد الله بن بشر المازني عن اخته وقيل عمته وقيل خالته في النهي عن صيام يوم السبت هي الصماء واسمها بهيمة
 $  عبد الله بن ابي بكر بن محمد بن عمرو بن حزم عن عمته عن ابيه زيد بن ثابت علق له البخاري اثرا في الحضر ووصله مالك في الموطا
 $  ق بن ماجة عبد الله بن خبيب والد معاذ عن عمه قال كنا في مجلس فجاء النبي صلي الله عليه وسلم وعلي راسه اثر ماء فقال بعضنا لبعض نراه اليوم طيب نفسه رواه بن ماجة من طريق خالد بن مخلد عن عبد الله بن سليمان عن معاذ بن عبد الله بن خبيب عن ابيه به ولم يسمه ورواه بن مندة في المعرفة من طريق سليمان بن بلال عن عبد الله بن سليمان سمع معاذ بن عبد الله بن خبيب عن ابيه عن عمه واسمه عبيد فذكره قال ورواه معن عن عبد الله بن سليمان وترجم له بن مندة عبيد بن معاذ عن انس وساق هذا الحديث في ترجمته
 $  د ابي داود عبد الله بن سعيد بن ابي هند عن بعض اصحاب عكرمة في اللحظ في الصلاة روي عن عبد الله عن ثور بن يزيد عن عكرمة عن بن عباس 
 $  د ابي داود عبد الله بن سعيد ايضا عن مولي لابي ايوب عن ابي اليسر في التعوذ هو صيفي
 $  س النساءي عبد الله بن شبرمة الضبي عن الثقة عن عبد الله بن شداد عن بن عباس في تحريم الخمر روي عن عبد الله بن شبرمة عن عمار الدهني عن عبد الله بن شداد وعن بن شبرمة عن امراة مسروق اسمها قمير
 $  س النساءي عبد الله بن شداد الاعرج عن رجل عن خزيمة بن ثابت رواه عن خزيمة ابنه عمارة وهرمي بن عبد الله وعمرو بن احيحة بن الجلاح وعن بنت حمزة هي امامة
 $  س النساءي عبد الله بن شقيق العقيلي عن رجل من الصحابة في النهي عن الارقاء روي عن بن بريدة عن فضالة بن عبيد الانصاري
 $  س النساءي عبد الله بن عبد الرحمن بن ابي بكر عن بعض ازواج النبي صلي الله عليه وسلم في الزجر عن الشرب في او اني الفضة هي ام سلمة رضي الله عنها 
 $  د ابي داود عبد الله بن عبيد الله بن ابي مليكة عن عقبة بن الحارث قال وحدثنيه صاحب لي عن عقبة بن عامر وانا لحديث صاحبي احفظ اسم صاحبه عبيد بن ابي مريم
 $  د ابي داود عبد الله بن مسلم اخو الزهري عن مولي اسماء بنت ابي بكر الصديق عن اسماء يحتمل ان يكون عبد الله بن كيسان قاله الحافظ ابو الحجاج
 $  س النساءي عبد الله بن وهب عن عمرو بن الحارث والليث بن سعد وذكر اخر عن سليمان بن عبد الرحمن عن عبيد بن فيروز عن البراء في الاضاحي وعن الليث وذكر اخر عن بكير بن الاشج عن نافع عن بن عمر وعن عمر بن الحارث وذكر اخر عن ابي الاسود عن عروة عن عاءشة هو في هذه المواضع كلها عبد الله بن لهيعة وعن بن وهب عن جرير بن حازم وسمي اخر عن ابي اسحاق عن عاصم بن ضمرة والحارث بن الاعور عن علي في الزكاة هو الحارث بن نبهان وعن بن وهب عن عمرو بن الحارث وذكر اخر عن عمرو بن شعيب عن ابيه عن جده حديث حراسة الخيل ورواه في موضع اخر فقال عن عمرو بن الحارث واخر عن عمرو بن شعيب هو هشام بن سعد وعن بن وهب عن يونس ومالك قلت المكني عنه في حديث عمرو بن شعيب هو بن لهيعة والمكني عنه في حديث بن شهاب هو بن سمعان
 $  س النساءي عبد الله بن يزيد مولي المنبعث عن رجل من الصحابة في اللقطة روي عن عبد الله بن بريدة عن ابيه عن زيد بن خالد الجهني 
 $  س النساءي عبد الله بن يزيد المقري عن حيوة وذكر اخر عن ابي الاسود عن عروة عن مروان عن ابي هريرة في صلاة الخوف وعن حيوة وذكر اخر عن ابي هانء الخولاني عن ابي عبد الرحمن الحبلي عن عبد الله بن عمرو بن العاص في فضل الغزو والاخر في الموضعين هو بن لهيعة
 $  خ البخاري عبد الله بن يزيد المقري ثنا حيوة وغيره قالا ثنا ابو الاسود عن عكرمة عن بن عباس ان اناسا من المسلمين كانوا مع المشركين يكثرون سوادهم الحديث وفيه قصة هكذا ساق البخاري هذا الاسناد والغير المكني عنه هو بن لهيعة قاله الطبري
 $  د ابي داود عبد الله بن يعقوب بن اسحاق عمن حدثه عن محمد بن كعب القرظي عن بن عباس الحديث مشهور برواية ابي المقدام هشام بن زياد عن محمد بن كعب
 $  ق بن ماجة عبد الاكرم عن ابيه اسم ابيه ابو حنيفة
 $  د ابي داود عبد الجبار بن واءل بن حجر عن اهل بيته عن واءل بن حجر روي عن عبد الجبار عن اخيه علقمة
 $  س النساءي عبد الرحمن بن نجيد الانصاري عن جدته اسمها ام نجيد 
 $  س النساءي عبد الرحمن بن جابر بن عبد الله عن رجل من الانصار هو ابو بردة بن نيار
 $  س النساءي عبد الرحمن بن الحارث بن هشام عن مولي ام سلمة عنها في الصاءم يصبح جنبا هو نافع مولي ام سلمة
 $  عبد الرحمن بن عمرو الاوزاعي عمن سمع عبد الله بن عمرو بن العاص في النهي عن صوم الدهر وروي عن الاوزاعي عن عطاء عمن سمع بن عمرو وروي عن عطاء عن العباس الشاعر عن بن عمرو الاوزاعي ايضا انبءت عن سعيد المقبري عن ابيه عن ابي هريرة في وطء التراب روي عنه عن بن عجلان عن سعيد به الاوزاعي ايضا حدثني عن رجل عن نافع عن القاسم عن عاءشة في الدعاء عند المطر هو محمد بن الوليد الزبيدي وعمن سمع عبد الله بن عمر هو عطاء
 $  عبد الرحمن بن ابي ليلي ثنا اصحابنا احيلت الصلاة ثلاثة احوال روي عنه عن معاذ بن جبل ولم يسمع منه 
 $  عبد الرحمن بن المنهال وقيل بن مسلمة وقيل بن سلمة عن عمه روي عنه قتادة سمي بن قانع عمه مسلمة
 $  ت الترمذي عبد الرزاق عن شيخ من اهل المدينة عن العلاء بن عبد الرحمن في فضل فارس روي عن عبد الله بن جعفر المخزومي عن العلاء
 $  د ابي داود عبد السلام بن ابي حازم شهدت ابا برزة دخل عبيد الله بن زياد فحدثني فلان روي عنه عن عمه
 $  عبد العزيز بن عبد الله بن ابي سلمة عن عمه هو الماجشون ويعقوب بن ابي سلمة
 $  عبد الكريم بن مالك الجزري عن رجل عن ابيه الندم توبة روي عن عبد الكريم عن زياد بن ابي مريم عن عبد الله بن مغفل عن ابيه عن بن مسعود
 $  كن النساءي في مسند مالك عبد الملك بن عبد العزيز بن جريج بلغني عن صفية بنت شيبة عن ام عثمان بنت ابي سفيان عن بن عباس روي عنه عن عبد الحميد بن جبير بن شيبة عن صفية بن جريج ايضا وقال اخبرني بعض بني ابي رافع عن عكرمة عن بن عباس طلق ابو ركانة امراته يحتمل ان يكون هو الفضل بن عبيد الله بن ابي رافع 
 $  ق بن ماجة عبد الملك بن عمير عن مولي ربعي عن ربعي عن حذيفة اقتدوا باللذين من بعدي روي عنه عن هلال مولي ربعي عن ربعي
 $  د ابي داود عبد الواحد بن زياد عن عجوز من اهل الكوفة جده علي بن غراب روي مروان بن معاوية عن طلحة ام غراب عن عقيلة مولاة لبني فزارة وهي جدة علي بن غراب
 $  عبيد الله بن سعد بن ابراهيم الزهري عن عمه هو يعقوب
 $  ق بن ماجة عبيد الله بن عبد الرحمن بن موهب عن عمه عن ابي هريرة هو عبيد الله بن عبد الرحمن بن عبد الله بن موهب عن عمه عبيد الله بن موهب والد يحيي
 $  د ابي داود عبيد الله بن عمر العمري عن رجل عن مكحول عن عراك بن مالك عن ابي هريرة روي عن اسماعيل بن امية عن مكحول عن عراك وعن ايوب بن موسي عن مكحول عن سليمان بن يسار عن عراك
 $  د ابي داود عثمان بن زفر الجهني عن بعض بني رافع بن مكيث عن رافع في حسن الملكة روي عن عثمان عن محمد بن خالد بن رافع عن عمه الحارث بن رافع عن رافع 
 $  د ابي داود عدي بن ثابت عن رجل انه كان مع عمار وحذيفة رواه ابراهيم عن همام بن الحارث عن حذيفة وابي مسعود
 $  س النساءي عرفجة بن عبد الله الثقفي عن رجل من اصحاب النبي صلي الله عليه وسلم عن النبي صلي الله عليه وسلم في فضل شهر رمضان رواه النساءي من طريق شعبة عن عطاء بن الساءب عنه ولم يسمه وارود من طريق ابن عتيبة عن عطاء عن عرفجة عن عتبة بن فرقد ورجح رواية شعبة ورواه حماد بن سلمة عن عطاء بن الساءب عن عرفجة قال كنت عند عتبة بن فرقد وهو يحدثنا عن شهر رمضان اذ دخل رجل من الصحابة فسكت عتبة ثم قال يا ابا عتبة حدثنا عن شهر رمضان كيف سمعت رسول الله صلي الله عليه وسلم يقول فيه فذكره اورده بن مندة في ترجمة ابي عبد الله غير منسوب في الكني وقال ابو نعيم رواه ابراهيم بن طهمان وجماعة عن عطاء بن الساءب يعني مما ارسلوه والله تعالي اعلم
 $  عروة بن الزبير من احيي ارضا ميتة قال عروة فلقد حدثني الذي اخبرني بهذا الحديث ان رجلين اختصما الحديث روي عن هشام بن عروة عن ابيه عن سعيد بن زيد
 $  س النساءي عطاء بن ابي رباح عن مولي لاسماء بنت ابي بكر الصديق عنها في الرمي بالنبل بشبه ان يكون عبد الله بن كيسان وله في ترجمة الاوزاعي 
 $  سي النساءي في اليوم والليلة عطاء بن يزيد عن بعض الصحابة في التسبيح دبر الصلاة هو ابو هريرة
 $  س النساءي عطاء بن يسار عن رجل من الصحابة في صلاة المسبل ازاره هو ابو هريرة
 $  عطاء بن يسار عن رجل من اهل مصر عن ابي الدرداء في التفسير
 $  س النساءي عطاء الشامي عن رجل من الانصار في اكل الزيت هو ابو اسيد بن ثابت
 $  ي د ت س البخاري في جزء رفع اليدين وابي داود والترمذي والنساءي علقمة بن ابي علقمة عن امه اسمها مرجانة
 $  س النساءي علقمة بن قيس في قصة بروع بنت واشق فقام رجل من اشجع هو معقل بن سنان الاشجعي
 $  سي النساءي في اليوم والليلة علي بن حسين بن علي عن ابنة عبد الله بن جعفر يقال اسمها ام ابيها
 $  عمار عن الرجل في عمارة بن شبيب 
 $  عمارة بن خزيمة بن ثابت عن عمه وله صحبة ذكر بن مندة ان اسم عمه عمارة بن ثابت قلت قال ولي الدين العراقي في كتاب الاطراف باوهام الاطراف عمه معروف الاسم ذكر ابو احمد العسكري في الصحابة ان اسمه عبيد الله
 $  ت الترمذي عمر بن اسحاق بن عبد الله بن ابي طلحة عن امه عن ابيها في تشميت العاطس ويقال عن عمر عن زوجته حميدة بنت رفاعة
 $  د س ابي داود والنساءي عمر بن الحكم بن ثوبان عن مولي قدامة بن مظعون عن مولي اسامة بن زيد روي عن عبيد الله بن سالم عن ابي عبيد الله مولي قدامة
