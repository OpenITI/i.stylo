 $  عمرو عن جابر بن عبد الله وعن وهب بن منبه وعن الزهري وعن سعيد بن جبير وعن كريب هو بن دينار 
  ( من اسمه عمران )
 $  عمران بن ابان بن عمران بن زياد بن ناصح ويقال صالح السلمي ويقال القرشي ابو موسي الطحان الواسطي اخو محمد بن ابان روي عن شعبة وحريز بن عثمان وحمزة الزيات وطلحة بن يزيد وخلف بن خليفة وشريك القاضي وايوب بن سيار وغيرهم وعنه ابو داود الحراني والحسن بن علي الحلال وحجاج بن الشاعر والقاسم بن محمد بن ابي شيبة وحميد بن زنجويه وغيرهم قال ابو داود خرج مع ابي السرايا وقذف قوما بلغني عن بن معين انه قال ليس بشء قال ابو داود فقلت لاحمد كان يزيد يكلمه فقال كان يزيد لا يهجر علي مثل هذا وقال النساءي ضعيف وقال مرة ليس بالقوي وذكره بن حبان في الثقات وقال بن عدي له غراءب خاصة عن محمد بن مسلم الطاءفي ولا اري بحديثه باسا ولم ار له حديثا منكرا قال بن حبان مات سنة خمس وماءتين قلت وقال ابو حاتم الرازي ضعيف الحديث وقال العقيلي لا يتابع وقال العجلي فيما نقله عنه بن خلفون ليس بثقة وقال اسلم الواسطي في تاريخه اخبرني اسماعيل بن عيسي انه توفي سنة  قلت وفيها ارخه القراب وقال الحسن بن علي الخلال ثنا عمران بن ابان عن شعبة عن مالك عن عمرو بن مسلم عن سعيد بن المسيب عن ام سلمة رفعة اذا اهل هلال ذي الحجة فمن كانت عنده ذبيحة الحديث قال عمران فسالت مالكا عنه فقال ليس هذا من حديثي قال فقلت لجلساءه ثنا بهذا عنه امام العراق شعبة ويقول ليس من حديثي فقالوا انه اذا لم ياخذ بالحديث فقال ليس هذا من حديثي قلت كتبت هذا لاني استنكرت هذا من عمران ولا اعتقد صحة هذا الكلام عن مالك وقد اخرج الحديث الدارقطني من طرق عن شعبة عن مالك به مرفوعا ومن طرق اخري عن مالك به مرفوعا وموقوفا وقال الذهبي قديم الوفاة مقل
 $  د ت ابي داود والترمذي عمران بن انس ابو انس المكي روي عن عطاء وابن ابي مليكة وغيرهم وعنه معاوية بن هشام ويحيي بن واضح ومصعب بن المقدام وابو تميلة واخرون قال البخاري منكر الحديث وذكره بن حبان في الثقات روي له ابو داود والترمذي حديثا واحدا عن عطاء عن بن عمر اذكروا محاسن موتاكم الحديث قلت وقال العقيلي لا يتابع علي حديثه واورد له عن بن ابي مليكة عن عاءشة حديث لدرهم ربا اعظم عند الله من سبعة وثلاثين زنية وقال ارسله غيره عن بن ابي مليكة 
 $  بخ م د ت س البخاري في الادب المفرد ومسلم وابي داود والترمذي والنساءي عمران بن ابي انس القرشي العامري المصري ويقال مولي ابي خراش السلمي مدني نزيل الاسكندرية روي عن عبد الله بن جعفر بن ابي طالب ومالك بن اوس بن الحدثان وسلمان الاغر وسليمان بن يسار وعمر بن الحكم بن رافع وعبد الرحمن بن ابي سعيد وابي سلمة بن عبد الرحمن وابي خراش السلمي وحنظلة بن علي السلمي وعروة بن الزبير وعبد الرحمن بن جبير المصري وعبد الله بن نافع بن العمياء وعمر بن عبد العزيز وجماعة وعنه ابنه عبد الحميد وعبد ربه بن سعيد ويزيد بن ابي حبيب ومحمد بن اسحاق ويونس بن يزيد وعبد الحميد بن جعفر والليث بن سعد والوليد بن ابي الوليد المدني واخرون قال احمد وابن معين وابو حاتم والنساءي ثقة وقال بن يونس قدم الاسكندرية سنة ماءة وكان سماع الليث منه بالمدينة توفي بالمدينة سنة سبع عشرة وماءة وكذا ارخه بن حبان قلت يعني في الثقات وزعم ان اسم ابيه عبد العزيز بن شرحبيل بن حسنة وقال العجلي مدني ثقة وقال بن سعد كانوا يزعمون انهم من بني عامر بن لءي والناس يقولون انهم موالي ثم انتموا بعد ذلك الي اليمن ومات عمران قديما وله احاديث وقال بن اسحاق حدثني عمران بن ابي انس وكان ثقة وحكي عن بن ابي شيبة ان ابا انس كان مولي لعبد الله بن سعد بن ابي سرح واسمه نوفل 
 $  س النساءي عمران بن بكار بن راشد الكلاعي ابو موسي البراد الحمصي المءذن روي عن الحسن بن خمير وبشر بن ابي حمزة ومحمد بن المبارك الصوري وخطاب بن عثمان الفوزي وابي اليمان وابي المغيرة وعلي بن عياش والربيع بن روح اللاحوني ويزيد بن عبد ربه وابي التقي عبد الحميد بن ابراهيم واحمد بن خالد الوهبي وعدة وعنه النساءي وابن ابي عاصم والبجيري وعبدان الاهوازي وابو حاتم وابنه عبد الرحمن بن ابي حاتم ومحمد بن جرير الطبري وابراهيم بن متويه ومحمد بن الحسن بن قتيبة وابو عوانة الاسفراءيني وخيثمة بن سليمان واخرون قال النساءي ثقة قلت وقال مسلمة بن قاسم لا باس به مات بحمص سنة احدي وسبعين وماءة
 $  م س مسلم والنساءي عمران بن الحارث السلمي ابو الحكم الكوفي روي عن بن عباس وابن الزبير وابن عمر وعنه قتادة وسلمة بن كهيل وحصين بن عبد الرحمن وقال ابو حاتم صالح الحديث وذكره بن حبان في الثقات روي له مسلم حديثا واحدا عن بن عمر فيمن اتخذ كلبا قلت ووقع في رواية عن ابي الحكم غير مسمي ولا منسوب وقد جزم النووي بانه عبد الرحمن بن ابي نعم البجلي وجزم عبد الغني بن سعيد بان ابا الحكم الذي روي عن بن عمر وعنه قتادة بجلي وان الذي روي عن بن عباس وعنه حصين وسلمة بن كهيل سلمي وهذا مما يقوي قول الثوري وقال العجلي عمران بن الحارث كوفي تابعي ثقة عندهم
 $  م د ت س مسلم وابي داود والترمذي والنساءي عمران بن حدير السدوسي ابو عبيدة البصري صلي علي جنازة خلف انس وروي عن ابي مجلز وابي قلابة وابي عثمان النهدي وعبد الله بن شقيق العقيلي ودعامة والد قتادة وقسامة بن زهير ويحيي بن سعيد الانصاري وغيرهم وعنه شعبة والحمادان وعبد الملك بن الصباح ويزيد بن زريع ووكيع ومعاذ بن معاذ ومعتمر بن سليمان وعثمان بن الهيثم المءذن واخرون قال ابو حاتم حدثني عبد الله بن دينار البصري قال ذكر شعبة عمران به حدير فقال كان شيءا عجبا كانه يثبته وقال يزيد بن هارون كان اصدق الناس وقال عبد الله بن احمد عن ابيه بخ بخ ثقة وقال بن معين والنساءي ثقة وقال بن المديني ثقة من اوثق شيخ بالبصرة وذكره بن حبان في الثقات قال البخاري وقال ابو قطن مات سنة تسع واربعين وماءة قلت وقال بن سعد كان ثقة كثير الحديث وقال بن شاهين في الثقات قال احمد بن حنبل هو صدوق صدوق وقال بن خلفون وثقه بن نمير واحمد بن صالح وغيرهما ووصفه عثمان بن الهثم انه اصدق الناس 
 $  س ق النساءي وابن ماجة عمران بن حذيفة احد المجاهيل قال كانت ميمونة تدان الحديث وعنه زياد بن عمرو بن هند الجملي قلت ذكره مسلم في الطبقة الثانية من اهل الكوفة وذكره بن حبان في ثقات التابعين واخرج حديثه في صحيحه وكذا الحاكم وقال الذهبي لا يعرف
 $  ع الستة عمران بن حصين بن عبيد بن خلف بن عبد نهم بن سالم بن غاضرة بن سلول بن حبشة بن سلول بن كعب بن عمرو الخزاعي ابو نجيد اسلم هو وابو هريرة عام خيبر روي عن النبي صلي الله عليه وسلم وعن معقل بن يسار وعنه ابنه نجيد وابو الاسود الديلي وابو رجاء العطاردي وربعي بن حراش ومطرف ويزيد ابنا عبد الله بن الشخير والحكم بن الاعرج وزهدم الجرمي وصفوان بن محرز وعبد الله بن رباح الانصاري وعبد الله بن بريدة ومحمد بن سيرين والحسن وابو قتادة العدوي وابو السوار العدوي وابو المهلب الجرمي وزرارة بن اوفي وابو نضرة العبدي واخرون استقضاه عبد الله بن عامر علي البصرة ثم استعفاه ومات بها سنة اثنتين وخمسين وكان الحسن البصري يحلف بالله ما قدمها راكب خير من عمران بن حصين قلت وكذا قال بن سيرين نحو وسياق النسب هنا من عند عبد البر وكذا ذكره بن الكلبي ومن تبعه ان عبد نهم بن حذيفة بن جهم بن غاضرة وقال بن سعد استقضاه زياد ثم استعفاه وكانت الملاءكة تصافحه قبل ان يكتوي وقال بن البرقي كان صاحب راية خزاعة يوم الفتح وحكي بن مندة قولا انه مات سنة  
 $  تمييز عمران بن حصين الضبي عن اعرابي عن النبي صلي الله عليه وسلم قال ما اخاف علي قريش الا انفسها الحديث وعنه بلال بن يحيي العبسي اخرجه احمد في مسنده من طريق بلال بن يحيي العبسي عنه وقال الغلابي عن يحيي بن معين حديث سعيد بن اوس عن بلال عن عمران بن حصين الضبي عن بن عباس اذا رايت الناس فلين كذا قال وقد اسنده الدار قطني من طريق ابي احمد الزبيري عن بلال بهذا السند الي عمران قال قدمت البصرة وبها بن عباس واذا رجل يقول صدق الله ورسوله قال فسالته فذكر قصة فيها انه قدم علي النبي صلي الله عليه وسلم في فداء بن لصديق له وفيها ان طال بك عمر رايت قريشا فلا هنا وفلا هنا قال فقد رايت ذلك قال بن يونس في تاريخ مصر ما جاء لاهل الكوفة عن سعد بن اوس العبسي عن عمران بن حصين فهو الضبي لا الصحابي 
 $  تمييز عمران بن حصين القشيري اخر يقال انه ابو روبة ويقال بن روبة يروي عنه بصري روي عن عاءشة وابي سعيد وعنه ايوب بن عاءذ ذكره الخطيب
 $  خ د س البخاري وابي داود والنساءي عمران بن حطان بن ظبيان بن لوذان بن عمرو بن الحارث بن حدوس وقيل غير ذلك في نسبة السدوسي ابو سماك ويقال ابو شهاب البصري ويقال غير ذلك روي عن ابي موسي الاشعري وابن عباس وابن عمر وجماعة وعنه يحيي بن ابي كثير وقتادة ومحارب بن دثار وغيرهم قال العجلي بصري تابعي ثقة وقال ابو داود ليس في اهل الاهواء اصح حديثا من الخوارج ثم ذكر عمران بن حطان وغيره وذكره بن حبان في الثقات وقال ابو سلمة عن ابان بن يزيد سالت قتادة فقال كان عمران بن حطان لا يتهم في الحديث وقال يعقوب بن شبية ادرك جماعة من الصحابة وصار في اخر امره ان راي راي الخوارج وكان سبب ذلك فيما بلغنا ان ابنة عمه رات راي الخوارج فتزوجها ليردها عن ذلك فصرفته الي مذهبها قال وحدثت عن الاصمعي عن عثمان البتي قال كان عمران بن حطان من اهل السنة فقدم غلام من عمان كانه نصل فقلبه في مجلس وذكر المبرد ان اسم امراة عمران حمنة وقال حلبس الكلبي عن سعيد بن ابي عروبة عن قتادة لقيني عمران بن حطان فقال يا اعمي اني عالم بخلافك غير انك رجل تحفظ فاحفظ عني هذه الابيات ثم انشده ابياتا في الزهد قال بن قانع توفي سنة  قلت ذكر ابو زكريا الموصلي في تاريخ الموصل عن محمد بن بشر العبدي الموصلي قال لم يمت عمران  بن حطان حتي رجع عن راي الخوارج انتهي هذا احسن ما يعذر به عن تخريج البخاري له واما قول من قال انه خرج ما حمل عنه قبل ان يري ما راي ففيه نظر لانه اخرج له من رواية يحيي بن ابي كثير عنه ويحيي انما سمع منه في حال هربه من الحجاج وكان الحجاج يطلبه ليقتله من اجل المذهب وقصته في هربه مشهورة واما قول ابي داود ان الخوارج اصح اهل الاهواء حديثا فليس علي اطلاقه فقد حكي بن ابي حاتم عن القاضي عبد الله بن عقبة المصري وهو بن لهيعة عن بعض الخوارج ممن تاب انهم كانوا اذا هووا امرا صيروه حديثا وقال العقيلي عمران بن حطان لا يتابع وكان يري راي الخوارج يحدث عن عاءشة ولم يتبين سماعه منها انتهي وكذا جزم بن عبد البر بانه لم يسمع منها وليس كذلك فان الحديث الذي اخرجه له البخاري وقع عنده التصريح بسماعه منها وقد وقع التصريح بسماعه منها في المعجم الصغير للطبراني باسناد صحيح وكذا روي الرياشي عن ابي الوليد الطيالسي عن ابي عمرو بن العلاء عن صالح بن سرح اليشكري عن عمران بن حطان قال كنت عند عاءشة وقال بن حبان في الثقات كان يميل الي مذهب الشراة وقال بن البرقي كان حروريا او قال الدارقطني متروك لسوء اعتقاده وخبث مذهبه وقال المبرد في الكامل كان راس القعد من الصفرية وفقيههم وخطيبهم وشاعرهم انتهي والقعد الخوارج كانوا لا يرون بالعرب بل ينكرون علي امراء الجور حسب الطاقة ويدعون الي رايهم ويزينون مع ذلك الخروج ويحسنونه وقال ابو نواس  فكاني وما احسن منها  قعدي يزين التحكيما  لكن ذكر ابو الفرج الاصبهاني انه انما صار قعديا لما عجز عن الحرب والله اعلم قلت وكان من المعروفين في مذهب الخوارج وكان قبل ذلك مشهورا بطلب العلم والحديث ثم ابتلي وساق بسند صحيح عن بن سيرين قال تزوج عمران امراة من الخوارج ليردها عن مذهبها فذهبت به وسماها في رواية اخري حمنة وانشد له من شعره  لا يعجز الموت شء دون خالقه  والموت يفني اذا ما ناله الاجل   وكل كرب امام الموت منقشع  والكرب والموت مما بعده جلل  
 $  س النساءي عمران بن خالد بن يزيد بن مسلم بن خالد بن يزيد بن مسلم بن ابي حميل القرشي ويقال الطاءي مولاهم ابو عمر ويقال ابو عمرو الدمشقي وقد ينسب الي جده ويقال عمران بن يزيد بن خالد روي عن معروف الخياط وعيسي بن يونس وبعد الرحمن بن ابي الرجال وشعيب بن اسحاق ومخلد بن حسين والداروردي ومروان بن معاوية الفزاري ومحمد بن شعيب بن شابور وابن عيينة واسماعيل بن عبد الله بن سماعه بن اسماعيل وهقل بن زياد وغيرهم روي عنه النساءي والعمري وابن قتيبة وحرب الكرماني والحسن بن سفيان والباغندي وغيرهم قال ابو زرعة كتبت عنه حديثا واحدا عن رديح بن عطية وقال ابو حاتم كتبت عنه في الرحلة الثانية وقال النساءي لا باس به ذكره بن حبان في الثقات وقال مات سنة اربع واربعين وماءتين وقال النساءي في موضع اخر ثقة
 $  د ت ابي داود والترمذي عمران بن خالد ابو خالد عن بن عباس وعنه اسماعيل بن حماد بن ابي سليمان ذكره بن عدي في ترجمة اسماعيل وقال انه مجهول وقال العقيلي حديث اسماعيل بن حماد غير محفوظ ويرويه عن مجهول وظهر لي انه خير ابي خالد الوالبي الاتي ذكره وان كان صنيع المزي يقتضي انهما واحد وقد اوضحت ذلك في ترجمة ابي خالد الوالبي في الكني وقد فرق الحاكم ابو احمد بين الوالبي وبين الراوي عن بن عباس فسمي الوالبي هرما ولم يذكر له رواية عن بن عباس وذكر الراوي عن بن عباس فيما لا يعرف اسمه لكن لم يقل ان اسماعيل بن حماد يروي عنه
 $  خ ت  البخاري في التعاليق والاربعة عمران بن داود العمي ابو العوام القطان البصري  روي عن قتادة ومحمد بن سيرين وابي جمرة الضبعي وابي اسحاق الشيباني وابان بن ابي عياش وحميد الطويل وسليمان التيمي ويحيي بن ابي كثير ومعمر بن راشد ومحمد بن جحادة وغيرهم وعنه بن مهدي وابو داود الطيالسي وسلم بن قتيبة وسهل بن تمام وشعيب بن بيان ومحمد بن بلال وعبد الله بن رجاء الغداني وابو عاصم الضحاك بن مخلد وابو علي الحنفي وعمرو بن عاصم وعمرو بن مرزوق واخرون قال عمرو بن علي كان بن مهدي يحدث عنه وكان يحيي لا يحدث عنه وقد ذكره يحيي يوما فاحسن الثناء عليه وقال عبد الله بن احمد عن ابيه ارجوه ان يكون صالح الحديث وقال الدوري عن بن معين ليس بالقوي وقال مرة ليس بشء لم يرو عنه يحيي بن سعيد وقال الاجري عن ابي داود هو من اصحاب الحسن وما سمعت الا خيرا وقال مرة ضعيف افتي في ايام ابراهيم بن عبد الله بن حسن بفتوي شديدة فيها سفك الدماء قال وقدم ابو داود ابا هلال الراسبي عليه تقديما شديدا وقال النساءي ضعيف وقال بن عدي هو ممن يكتب حديثه وذكره بن حبان في الثقات وقال ابو المنهال عن يزيد بن زريع كان حروريا كان يري السيف علي اهل القبلة قلت في قوله حروريا نظر ولعله شبة بهم وقد ذكر ابو يعلي في مسنده القصة عن ابي المنهال في ترجمة قتادة عن انس ولفظه قال يزيد كان ابراهيم يعني بن عبد الله بن حسن لما خرج يطلب الخلافة استفتاة عن شء فافتاه بفتيا قتل بها رجال مع ابراهيم انتهي وكان ابراهيم ومحمد خرجا علي المنصور في طلب الخلافة لان المنصور كان في زمن بني امية بايع محمدا بالخلافة فلما زالت دولة بني امية وولي المنصور الخلافة تطلب محمدا ففر فالح في طلبه فظهر بالمدينة وبايعه قوم وارسل اخا ابراهيم الي البصرة فملكها وبايعه قوم فقدر انهما قتلا وقتل معهما جماعة كثيرة وليس هءلاء من الحرورية في شء وقال الساجي صدوق وثقه عفان وقال العقيلي من طريق بن معين كان يري راي الخوراج ولم يكن داعية وقال الترمذي قال البخاري صدوق بهم وقال بن شاهين في الثقات كان من اخص الناس بقتادة وقال الدارقطني كان كثير المخالفة والوهم وقال العجلي بصري ثقة وقال الحاكم صدوق واورد له العقيلي عن قتادة عن سعيد بن ابي الحسن عن ابي هريرة حديث ليس شء اكرم علي الله من الدعاء قال لا يتابع عليه بهذا اللفظ ولا يعرف الا به 
 $  د ت ق ابي داود والترمذي وابن ماجة عمران بن زاءدة بن نشيط الكوفي روي عن ابيه وحسين بن ابي عاءشة وابي داود نفيع وعنه بن المبارك ووكيع وابو احمد الزبيري وعيسي بن يونس وحفص بن غياث وعبد الله بن نمير وعبد الله بن داود الخريبي وابو نعيم قال بن معين والنساءي ثقة قلت وذكره بن حبان في الثقات
 $  ت ق الترمذي وابن ماجة عمران بن زيد التغلبي ابو يحيي البصري ويقال الكوفي الملاءي الطويل روي عن ابيه وزيد العمي وابي حازم الاعرج وعبد الرحمن بن القاسم بن محمد وعنه بن المبارك ووكيع وابو النضر واسد بن موسي وابو نعيم وعلي بن الجعد وعبيد الله العيشي و غيرهم قال الدوري عن بن معين ليس يحتج بحديثه وقال ابو حاتم يكتب حديثه وليس بالقوي وذكره بن حبان في الثقات له عندهما حديث انس في المصافحة كان اذا استقبله انسان فصافحه لا ينزع يده من يده قلت وقال بن عدي بصري يكني ابا محمد قليل الحديث 
 $  بخ د ت ق البخاري في الادب المفرد وابي داود والترمذي وابن ماجة عمران بن طلحة بن عبيد الله التيمي ولد علي عهد النبي صلي الله عليه وسلم فسماه عمران روي عن ابيه وامه حمنة بنت جحش و علي بن ابي طالب وخولة الانصارية وعنه ابنا اخويه ابراهيم بن محمد بن طلحة ومعاوية بن اسحاق بن طلحة وسعد بن طريف الاسكاف ذكره بن سعد في الطبقة الاولي من اهل المدينة وقال العجلي مدني تابعي ثقة وذكره بن حبان في الثقات له عندهم حديث واحد عن امه في الاستحاضة
 $  بخ س البخاري في الادب المفرد والنساءي عمران بن ظبيان الحنفي الكوفي روي عن ابي يحيي حكيم بن سعد وعدي بن ثابت ويحيي بن عقيل وعنه قيس بن الربيع وعبد الملك بن مسلم بن سلام واسراءيل وشريك والسفيانان وغيرهم وقال البخاري فيه نظر وقال ابو حاتم يكتب حديثه وذكره بن حبان في الثقات قلت وقال انه مات سنة سبع وخمسين وماءة وقال يعقوب بن سفيان ثقة من كبراء اهل الكوفة يميل الي التشيع وقال بن حبان في الضعفاء ايضا فحش خطاه حتي بطل الاحتجاج به وذكره العقيلي وابن عدي في الضعفاء
 $  عخ البخاري في خلق افعال العباد عمران بن عبد الله بن طلحة الخزاعي البصري وقد ينسب الي جده روي عن سعيد بن المسيب والقاسم بن محمد بن ابي بكر وعنه حماد بن سلمة وسلام بن مسكين قال الاجري عن ابي داود بصري مستقيم الحديث وذكره بن حبان في الثقات قلت وقال بن حبان ليس بمشهور 
 $  د ق ابي داود وابن ماجة عمران بن عبد المعافري ابو عبد الله المصري روي عن عبد الله بن عمرو بن العاص وعنه عبد الرحمن بن زياد بن انعم الافريقي قال عثمان الدارمي عن بن معين ضعيف وذكره بن حبان في الثقات له عندهما ثلاثة لا تقبل لهم صلاة وعند ق ثلاث من ادان فيهن قلت وشرط انه يعتبر حديثه من غير رواية الافريقي عنه فكانه لم يوثقه لانه ليس له راو غير الافريقي وقد ذكره يعقوب بن سفيان في ثقات المصريين وقال العجلي مصري تابعي ثقة وقال بن القطان لا يعرف حاله
 $  ت الترمذي عمران بن عصام الضبعي ابو عمارة البصري والد ابي جمرة ويقال عمران بن عصام العنزي القاص الشاعر ويقال انهما اثنان روي عن عمران بن حصين وقيل عن رجل عنه في ذكر الشفع والوتر روي عن ابيه وقتادة والمثني بن سعيد وابو التياح الضبيعيان ذكره بن حبان في الثقات وقال خليفة قتل يوم الزاوية وقيل بعد بن الاشعث روي له الترمذي الحديث المتقدم قلت لكنه غير منسوب عنده فاما عمران بن عصام الضبعي والد ابي جمرة فان بن عبد البر وغيره ذكروه في الصحابة وقال بن عبد البر ومنهم من لا يصحح له صحبة وانما روايته عن عمران بن حصين وقال البخاري في تاريخه قال حجاج ثنا حماد عن ابيه قال عاش النبي صلي الله عليه وسلم ثلاثا وستين سنة وقال بن حبان كان علي قضاء البصرة وكان مع بن الاشعث فضرب الحجاج عنقه يوم الزاوية وقال البخاري في الاوسط قتله الحجاج يوم الزاوية سنة ثلاث وثمانين واما عمران بن عصام العنزي الشاعر فهو اخر غير هذا كان شاعرا يمدح بني امية وبعثه الحجاج الي عبد الملك بن مروان يحضه علي البيعة بولاية العهد بعده للوليد وكان ذلك بعد وقعة بن الاشعث بالاتفاق فتبين انه غير المقتول في وقعة بن الاشعث وكيف يجتمع بعد ذلك نسب ضبيعة وعنزة لرجل واحد فصح انهما اثنان والله اعلم 
 $  ي م البخاري في جزء رفع اليدين مسلم عمران بن ابي عطاء الاسدي مولاهم ابو حمزة القصاب الواسطي روي عن ابيه وابن عباس وانس ومحمد بن الحنفية وعنه يونس بن عبيد وشعبة والثوري وهشيم وابو عوانة وغيرهم قال احمد ليس به باس صالح الحديث وقال بن معين ثقة وقال ابو زرعة بصري لين وقال ابو حاتم والنساءي ليس بالقوي وقال الاجري عن ابي داود يقال له عمران الحلاب ليس بذاك وهو ضعيف وذكره بن حبان في الثقات له في مسلم حدث بن عباس لا اشبع الله بطنه قلت قال بن خلفون عن بن نمير انه وثقه
 $  عمران بن عمير الهذلي الكوفي مولي عبد الله بن مسعود واخو القاسم بن عبد الرحمن بن عبد الله بن مسعود لامه روي عن عبد الله بن عتبة بن مسعود والده عمير هو جد اسحاق بن ابراهيم بن عمير الماضي في الهمزة روي عنه مسعر وحده قال البخاري حديثه في الكوفيين وقال بن ابي حاتم نحوه ذكره البخاري في الشهادات في باب شهادة القاذف واجازه عبد الله بن عتبة انتهي وقد وصله ابو بكر بن ابي شبية عن ابي ادريس عن مسعر عن عمران بن عمير ان عبد الله بن عتبة كان يجيز شهادة القاذف اذا تاب ذكرته لكون المزي ذكر عبد الرحمن بن فروخ وهو نظير هذا
 $     الاربعة عمران بن عيينة بن ابي عمران الهلالي ابو الحسن الكوفي اخو سفيان روي عن ابي اسحاق السبيعي واسماعيل بن ابي خالد وعطاء بن الساءب وحصين بن عبد الرحمن وليث بن ابي سليم ويزيد بن ابي زياد وابي فروة الجهني وغيرهم وعنه ابنه الحسن وعمران بن علي الباهلي ومحمد بن طريف البجلي وعبدة بن عبد الرحمن وعثمان بن ابي شبية ومحمد بن عبد الاعلي الصنعاني وابو سعيد الاشج واخرون قال بن معين صالح الحديث وقال ابو زرعة صالح الحديث وقال ابو حاتم لا يحتج بحديثه لانه ياتي بالمناكير وقال الاجري سءل ابو داود عن ابراهيم وعمران ومحمد بن عيينة فقال كلهم صالح وحديثهم قريب وقال العقيلي في حديثه وهم خطا وذكره بن حبان في الثقات قلت وقال ابو بكر البزار ليس به باس وقال بن خلفون وقال ابو صالح صدوق 
 $  مد ابي داود في المراسيل عمران بن محمد بن سعيد بن المسيب القرشي المخزومي روي عن ابيه عن جده وعن ام ولد لابيه روي عنه ابراهيم بن حماد المدني ومعن بن عيسي ويونس بن محمد المءذن وموسي بن اسماعيل ذكره بن حبان في الثقات وقال يعتبر حديثه اذا روي عنه الثقات لان في رواية الضعفاء عنه احاديث منكرة روي له ابو داود حديثا واحدا مرسلا واخرج الطبراني في ترجمة ابي سعيد الخدري من طريقه حديثا اخر مسندا وقال لا نعلم له غيره ان لله تعالي ثلاث حرمات
 $  ت ق الترمذي وابن ماجة عمران بن محمد بن عبد الرحمن بن ابي ليلي الانصاري الكوفي روي عن ابيه وعنه ابنه محمد وابن اخيه الحسن بن عبد الرحمن بن محمد وسهل بن عثمان العسكري وعثمان بن ابي شيبة ذكره بن حبان في الثقات وقد تقدم حديث الترمذي في داود بن علي
 $  عمران بن مسلم بن رياح الثقفي الكوفي وقد ينسب الي جده روي عن عبد الله بن معقل بن مقرن وعلي بن عمارة وعنه مسعر وزكرياء بن سيار والثوري وشريك وابو مالك النخعي ذكره بن حبان في الثقات قلت لكنه جعله تابعيا وقال يروي عن عبد الله بن المغفل يعني بالمعجمة والفاء 
 $  خ م د ت س البخاري ومسلم وابي داود والترمذي والنساءي عمران بن مسلم المنقري ابو بكر البصري القصير راي انسا وروي عن ابي رجاء العطاردي والحسن ومحمد وانس بن سيرين وعطاء بن ابي رباح وابراهيم التيمي وسعيد بن سليمان الربعي وعبد الله بن دينار وقيس بن سعد المكي وغيرهم وعنه مهدي بن ميمون والثوري والجراح بن مليح والد وكيع وخالد بن الحارث ويحيي القطان ويحيي بن سليم الطاءفي وحاتم بن اسماعيل وحماد بن مسعدة وبشر بن المفضل وعبد الله بن رجاء المكي واخرون قال القطان كان مستقيم الحديث وانما ذكرته لانه يروي اشياء لا يرويها غيره وينفرد عنه قوم بتلك الاحاديث وذكره بن حبان في الثقات قلت وزاد الا ان في رواية يحيي بن سليم عنه بعض المناكير وكذا في رواية سويد بن عبد العزيز عنه انتهي وقد فرق البخاري بين عمران بن مسلم القصير فقال ابو بكر سمع ابا رجاء وعطاء وكناه يحيي بن سعيد ثم قال عمران بن مسلم عن عبد الله بن دينار منكر الحديث روي عنه يحيي بن سليم وكذا تبعه بن ابي حاتم في التفرقة بينهما وقال في الذي يروي عن عبد الله بن دينار سمعت ابي يقول يقول هو منكر الحديث وهو شبة المجهول وكذا فرق بينهما ايضا بن ابي خيثمة ويقعوب بن سفيان وابن عدي والعقيلي وانكر ذلك الدارقطني في العلل في ترجمة عبد الله بن دينار عن بن عمر وقال هو هو بغير شك وقال بن ابي حاتم ثنا ابو زياد عن عبد الرحمن بن مهدي وذكر عمران بن مسلم الجفعي فقال كان مستقيم الحديث فسالت ابي عن عمران القصير فقال لا باس به قال وسالت ابي عن عمران الذي روي عن انس قال خدمت النبي صلي الله عليه وسلم عشرا وعنه جعفر بن برقان فقال يرون انه عمران القصير ولم يسمع من انس وافرد العقيلي عمران بن مسلم عن عمران القصير عن انس وذكر له هذا الحديث وقال بن عدي في ترجمة سويد بن عبد العزيز عمران القصير هو بن مسلم بصري عزيز الحديث ونسب عمران الرواي عن عبد الله بن دينار مكيا وقال ابراهيم بن الجنيد سالت يحيي بن معين عن خالد بن رباح فقال بصري ليس به باس يحدث عن عمران ابي بكر فقال هذا عمران القصير ليس بشء 
 $  تمييز عمران بن مسلم المكي تقدم في الذي قبله
 $  تمييز عمران بن مسلم الجعفي الكوفي الاعمي روي عن خيثمة بن عبد الرحمن وزاذان الكندي وسويد بن غفلة ويزيد بن عمرو وسعيد بن جبير وعنه طلحة بن مصرف وهو من اقرانه وشعبة ومالك بن مغول وزهير بن معاوية وزاءدة بن قدامة ومحمد بن جابر الحنفي والثوري وشريك وابو عوانة واخرون وذكره بن حبان في الثقات قلت وذكره بن ابي حاتم قال سالت ابي عنه فقال ثقة قال وكتب الي عبد الله بن احمد عن ابيه انه قال ثقة وكما يكون الثقة وعن اسحاق بن منصور عن بن معين ثقة وقال مرة صالح وعن بن مهدي قال احاديث عمران بن مسلم صحاح مستقيمة لا يختلفون فيه وقال العجلي كوفي ثقة
 $  تمييز عمران بن مسلم الفزاري ويقال الاودي الكوفي روي عن جعفر بن عمرو بن حريث ومجاهد وعطاء وعنه ابو معاوية و الفضل بن موسي السيناني واسباط بن محمد ومحمد بن ربيعة ومروان بن معاوية وابو نعيم قال ابو احمد الزبيري كان رافضيا كانه جرو كلب قلت ذكره بن ابي حاتم فقال عمران بن مسلم سمعت ابي يقول هو شيخ وذكره بن حبان في الثقات فقال عمران بن مسلم وقيل بن ابي مسلم وقال الازدي قد حدث عنه يحيي بن سعيد يعني القطان ومن حديث عنه فهو في عداد اهل الصدق 
 $  ع الستة عمران بن ملحان ويقال بن تيم ويقال بن عبد الله ابو رجاء العطاردي البصري ادرك زمن النبي صلي الله عليه وسلم ولم يره وروي عن عمر وعلي وعمران بن حصين وابن عباس وسمرة بن جندب وعاءشة وعنه ايوب وجرير بن حازم وعوف الاعرابي وعمران القصير ومهدي بن ميمون وابو الاشهب وحماد بن نجيح وسلم بن زرير وسعيد بن ابي ربيعة والجعد ابو عثمان والحسن بن ذكوان وابو الحارث الكرماني وصخر بن جويرية واخرون قال بن معين وابو زرعة ثقة وقال بن سعد كان ثقة في الحديث وله رواية علم بالقران وام قومه اربعين سنة وتوفي في خلافة عمر بن عبد العزيز قال وقال الواقدي توفي سنة سبع عشرة وماءة قال وهذا عندي وهل وقال الذهلي مات قبل الحسن لا ادري في اي سنة غير اني اتوهمه سنة  وقال ابو حاتم جاهلي فر من النبي صلي الله عليه وسلم ثم اسلم بعد الفتح واتي عليه ماءة وعشرون سنة وقال البخاري قال اشعث بن سوار بلغ سبعا وعشرين وماءة سنة وقال البخاري يقال مات قبل الفرزدق والحسن ومات الحسن سنة عشر وماءة وقال بن عبد البر كان ثقة وكانت فيه غفلة وكانت له عبادة و عمر عمرا طويلا ازيد من ماءة وعشرين سنة مات سنة  في اول خلافة هشام قلت حكي بن سعد ان اسمه عطارد بن برز وتبعه بن حبان فذكره كذلك في الثقات فيمن اسمه عطارد وقال بن ابي حاتم عمران بن ملحان ويقال عمران بن تيم وهو اصح وقال البخاري في الاوسط ملحان ما اراه يصح وقال في الكبير قال احمد هو عمران بن عبد الله 
 $  ت س ق الترمذي والنساءي وابن ماجة عمران بن موسي بن حبان القزاز الليثي ابو عمرو البصري روي عن حماد بن زيد وعبد الوارث ويزيد بن زريع وعبد الواحد بن زياد ومحمد بن سواء السدوسي وعمرو بن رباح العبدي وقاسم المطرز واخرون وقال ابو حاتم صدوق وقال النساءي ثقة وقال في موضع اخر لا باس به وذكره بن حبان في الثقات مات بعد الاربعين وماءتين قلت ووثقه مسلمة بن فاسم والدارقطني
 $  د ت ابي داود والترمذي عمران بن موسي بن عمرو بن سعيد بن العاص بن سعيد بن العاص الاموي اخو ايوب بن موسي روي عن سعيد المقبري وعمر بن عبد العزيز وعنه بن جريج ذكره بن حبان في الثقات روي له ابو داود والترمذي حديثا واحدا من حديث ابي رافع في ان غرز الضفيرة كفل الشيطان وفيه قصة قلت وقع ذكره في سند اثر علقه البخاري في الشهادات عن عمر بن عبد العزيز ووصله الطبري والخلال من رواية بن المبارك عن بن جريج عن عمران بن موسي سمعت عمر بن عبد العزيز اجاز شهادة القاذف ومعه رجل وافاد الحاكم ان اسماعيل بن علية روي عنه ايضا
 $  خ د البخاري وابي داود عمران بن ميسرة المنقري ابو الحسن البصري الادمي روي عن عبد الوارث ومعتمر وعباد بن العوام وعبد الله بن ادريس وحفص بن غياث ومحمد بن فضيل وغيرهم وعنه البخاري وابو داود وابو زرعة وابو حاتم والاثرم وابو مسلم الكجي ومحمد بن يحيي بن المنذر القزاز وابو خليفة وغيرهم ذكره بن حبان في الثقات قال بن ابي عاصم مات سنة ثلاث وعشر وماءتين قلت ووثقه الدارقطني وفي الزهرة روي عنه البخاري احد عشر حديثا 
 $  س النساءي عمران بن نافع روي عن حفص بن عبيد الله بن انس وعنه بكير بن الاشج قال النساءي ثقة وذكره بن حبان في الثقات له عنده حديث انس فيمن احتسب ثلاثة من صلبه
 $  عمران بن يزيد في بن خالد بن يزيد
 $  س النساءي عمران الانصاري عن بن عمر في فضل وادي اليسر روي عنه محمد ابنه اخرج له النساءي هذا الحديث الواحد قلت وقال مسلمة بن قاسم لا باس به
 $  د ابي داود عمران البارقي عن عطية عن ابي سعيد حديث لا تحل الصدقة لغني الحديث وعنه الثوري وروي ايضا عن الحسن البصري ذكره بن حبان في الثقات واخرج له ابو داود هذا الحديث الواحد قلت قد ذكر بن حبان ان الاعمش روي عنه وتبع في ذلك البخاري فانه قال عمران البارقي روي عن الحسن وعنه الاعمش مرسل قال وقد روي الثوري عن عمران البارقي عن عطية
