   قرة بن ابي الصهباء روي عن العلاء بن بدر عن علي رضي الله عنه مرسلا روي عنه معتمر بن سليمان سمعت ابي يقول ذلك، نا عبد الرحمن اخبرنا يعقوب بن اسحاق فيما كتب الي قال نا عثمان بن سعيد قال قلت ليحيي بن معين قره بن ابي الصهباء يروي عنه المعتمر كيف هو؟ قال ما اعرفه، قال ابو محمد يقول ما اعرفه انه مجهول.
   قرة بن خالد السدوسي روي عن ابي رجاء العطاردي والحسن وابن سيرين وعطية روي عنه يحيي بن سعيد وابن مهدي ووكيع ومسلم بن ابراهيم
 
 وابو نعيم وسهل بن تمام سمعت ابي يقول ذلك، قال ابو محمد روي عنه ابو داود الطيالسي.
 نا عبد الرحمن نا صالح بن احمد بن محمد بن حنبل نا علي يعني ابن المديني قال سمعت يحيي بن سعيد يقول كان قرة بن خالد عندنا من اثبت شيوخنا، ثنا عبد الرحمن انا عبد الله بن احمد بن محمد بن حنبل فيما كتب الي قال سالت ابي عن قرة بن خالد وعمران بن حدير فقال ما فيهما الا ثقة.
 نا عبد الرحمن قال وسءل ابي وانا اسمع عن قرة وابي خلدة فقال قرة فوقه، قيل قرة مع من هو؟ قال هو دون حبيب بن الشهيد، قيل له قرة والقاسم ابن الفضل؟ فقال ما اقربه منه، وقال قرة ثقة.
 نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال قرة بن خالد السدوسي ثقة، ثنا عبد الرحمن قال سالت ابي عن قرة بن خالد وحرير بن حازم فقال قرة احب الي من جرير بن حازم ومن ابي خلدة، وقرة بن خالد ثبت عندي.
   قرة بن يزيد روي ان ابن عمر طلاق امراته روي انه الاوزاعي سمعت ابي يقول ذلك.
   قرة بن ابي قرة روي عن ابي اسيد روي عنه يحيي بن ابي كثير سمعت ابي يقول ذلك.
   قرة بن سليمان الجهضمي الازدي جليس حماد بن زيد روي عن هشام بن حسان ومعاوية بن صالح روي عنه ابو الوليد الطيالسي وعمرو () ابن علي سمعت ابي يقول ذلك وسالته عنه فقال ضعيف الحديث.
   قرة بن عبد الرحمن بن حيوءيل بن ناشرة المعافري المزني () المصري روي عن الزهري روي عنه الاوزاعي وحياة بن شريح وسويد بن عبد العزيز وعبد الله بن وهب سمعت ابي يقول ذلك، نا عبد الرحمن نا ابي نا
 
 ابراهيم بن الوليد بن سلمة الطبراني قال نا ابو مسهر قال نا يزيد بن السمط قال كان الاوزاعي يقول ما احد اعلم بالزهري من قرة بن عبد الرحمن بن حيوءيل، نا عبد الرحمن انا ابراهيم بن يعقوب الجوزجاني فيما كتب الي قال سمعت احمد بن حنبل يقول قرة بن عبد الرحمن صاحب الزهري منكر الحديث جدا.
 نا عبد الرحمن انا ابو بكر بن ابي خيثمة فيما كتب الي قال سءل يحيي بن معين عن قرة بن عبد الرحمن فقال ضعيف الحديث، نا عبد الرحمن قال سالت ابي عن قرة بن عبد الرحمن بن حيوءيل فقال ليس بقوي، نا عبد الرحمن قال سءل ابو زرعة عن قرة بن حيوءيل فقال الاحاديث التي يرويها مناكير.
   قرة بن حبيب القشيري () ابو علي الرماح البصري روي عن شعبة والحكم بن عطية وصخر بن جويرية والبراء بن عبد الله وابي الاشهب وعمار بن عمارة وعبد الواحد بن زيد وسوار بن داود سمعت ابي يقول ذلك، قال ابو محمد وروي عن المسعودي وثواب بن عتبة وعبد الله بن بكر المزني روي عنه ابو بدر عباد بن الوليد الغبري وابي وابو زرعة.
 نا عبد الرحمن قال سءل ابي عنه فقال كان صدوقا ثقة غزا مع الربيع ابن صبيح كتبنا عنه ايام الانصاري ثم بقي حتي كتبنا عنه ايام ابي الوليد.
 باب تسمية من روي عنه العلم ممن يسمي قتادة   قتادة بن النعمان الظفري الانصاري اخو ابي سعيد الخدري لامه يكني ابا عمرو والانصار يكنونه ابا عبد الله مات وهو ابن خمس وستين صلي عليه عمر ونزل في قبره روي عنه محمود بن لبيد وابنه عمر سمعت ابي يقول ذلك   قتادة بن ملحان القيسي السدوسي له صحبة والد عبد الملك بن قتادة روي عنه ابنه عبد الملك بن قتادة سمعت ابي يقول ذلك.
 
   قتادة بن عياش الجرشي الرهاوي له صحبة ان النبي صلي الله عليه وسلم عقد له لواء روي عنه ابنه هشام بن قتادة سمعت ابي يقول ذلك.
   قتادة بن دعامة السدوسي البصري وهو ابن دعامة بن قتادة ابن عزيز، وقال بعضهم قتادة بن دعامة بن عكابة بن عزيز بن عمرو بن ربيعة، وقال بعضهم ابن عزيز بن كريم بن عمرو بن الحارث بن سدوس بن شيبان بن ذهل ابن ثعلبة، وكان اعمي يكني ابا الخطاب توفي بواسط في الطاعون وهو ابن ست او سبع وخمسين بعد موت الحسن بسبع سنين روي عن انس بن مالك وعبد الله ابن سرجس وابي الطفيل روي عنه شعبة وهشام الدستواءي وسعيد بن ابي عروبة وهمام سمعت ابي يقول ذلك، وسمعته يقول لم يلق من اصحاب النبي صلي الله عليه وسلم الا انسا وعبد الله بن سرجس، قال ابو محمد لم يذكر ابا الطفيل لانه كان صبيا في عهد النبي صلي الله عليه وسلم.
 نا عبد الرحمن نا عمر بن شبة نا ابو سلمة موسي بن اسماعيل، وانا عبد الرحمن نا احمد بن يحيي بن مالك السوسي قال نا يونس بن محمد قالا نا ابو هلال عن غالب قال سمعت بكر بن عبد الله يقول من اراد ان ينظر الي احفظ من راينا ما راينا الذي هو احفظ منه ولا احري ان ياتي بالحديث كما سمعه فلينظر الي قتادة، والسياق لعمر.
 نا عبد الرحمن حدثني ابي نا عبد الرحمن بن المبارك ثنا الصعق بن حزن نا زيد ابو عبد الواحد قال سمعت سعيد بن المسيب يقول ما اتاني عراقي احفظ من قتادة،.
 نا عبد الرحمن نا صالح بن احمد بن محمد بن حنبل نا علي يعني ابن المديني قال سمعت عبد الرحمن يعني ابن مهدي قال نا حماد بن زيد عن ابي مسلمة قال سمعت ابا قلابة وساله رجل عن شء فلم يقل فيه شيءا فقال من اسال اسال فلانا؟ قال لا، قال اسال فلا نا؟ قال لا، قال اسال قتادة؟ قال نعم سل قتادة،.
 نا عبد الرحمن نا احمد بن منصور الرمادي نا عبد الرزاق قال سمعت 
 معمرا يقول جاء رجل الي ابن سيرين فقال اني رايت في النوم كان حمامة التقمت لءلءة فخرجت كما دخلت سواء قال ابن سيرين هو قتادة هو احفظ الناس،.
 نا عبد الرحمن نا ابي حدثني عبد الله بن عمران نا ابو داود قال ذكر سفيان لشعبة حديثا لقتادة فقال سفيان وكان في الدنيا مثل قتادة؟.
 نا عبد الرحمن نا احمد بن منصور الرمادي نا عبد الرزاق انا معمر قال سمعت قتادة يقول ما قلت لاحد رد علي يعني الحديث، نا عبد الرحمن نا احمد، نا عبد الرزاق قال قال معمر سمعت قتادة يقول ما في القران اية الا قد سمعت فيها بشء ().
 نا عبد الرحمن نا احمد نا عبد الرزاق عن معمر قال قلت للزهري يا ابا بكر اقتادة اعلم او مكحول؟ قال لا بل قتادة وما عند مكحول الا شء يسير،.
 نا عبد الرحمن نا يزيد بن سنان البصري نزيل مصر نا سعيد بن عامر قال همام اخبرناه قال سمعت قتادة يقول ما افتيت بشء من رايي منذ عشرين سنة،.
 نا عبد الرحمن نا صالح بن احمد بن محمد بن حنبل قال نا علي يعني ابن المديني قال سمعت سفيان يقول كان معمر يقول لم ار من هءلاء افقه من الزهري وحماد وقتادة،.
 حدثنا عبد الرحمن نا احمد بن سنان قال كان يحيي بن سعيد يقول قتادة حافظ كان اذا سمع الشء علقه، نا عبد الرحمن حدثني ابي نا عمرو بن علي قال قلت لعبد الرحمن بن مهدي حميد الطويل في حديث فقال قتادة احفظ من خمسين مثل حميد، فسمعت ابي يقول صدق ابن مهدي،.
 نا عبد الرحمن قال سمعت ابي يقول سمعت احمد بن حنبل وذكر قتادة فاطنب في ذكره فجعل ينشر من علمه وفقهه ومعرفته بالاختلاف والتفسير وغير ذلك وجعل يقول عالم بتفسير القران وباختلاف العلماء، ووصفه بالحفظ .
 
 والفقه وقال قلما تجد من يتقدمه اما المثل فلعل،.
 حدثنا عبد الرحمن نا محمد بن حمويه بن الحسن قال سمعت ابا طالب قال سمعت احمد بن حنبل يقول كان قتادة احفظ اهل البصرة لا يسمع شيءا الا حفظه وقرء عليه صحيفة جابر مرة واحدة فحفظها وكان سليمان التيمي وايوب يحتاجون الي حفظه يسالونه وكان من العلماء كان له خمس وخمسون سنة يوم مات،.
 نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال قتادة ثقة، نا عبد الرحمن قال سمعت ابي يقول اكثر اصحاب الحسن قتادة واثبت اصحاب انس الزهري ثم قتادة.
 نا عبد الرحمن قال سالت ابي قلت قتادة عن معاذة احب اليك او ايوب عن معاذة؟ فقال قتادة اذا ذكر الخبر وقتادة احب الي من يزيد الرشك، نا عبد الرحمن قال سمعت ابا زرعة يقول قتادة من اعلي اصحاب الحسن، قيل له يونس ابن عبيد؟ قال ثم يونس.
   قتادة البصري الشامي روي عن هشام بن حكيم روي عنه ابنه عبد الرحمن سمعت ابي يقول ذلك.
   قتادة بن سلميان البصري (روي عن الحسن البصري  ) روي عنه محمد بن اسحاق سمعت ابي يقول ذلك.
   (قتادة بن عبد الله بن ابي قتادة الانصاري روي عن ابيه روي عنه الحجاج بن ارطاة سمعت ابي يقول ذلك  ).
   قتادة بن الفضل بن عبد الله بن قتادة الجرشي (الرهاوي وجده قتادة الجرشي  ) له صحبة روي عن بكير بن فيروز عن ابيه وعن ثور بن يزيد روي عنه علي بن بحر بن بري واحمد بن عبد الملك بن واقد وابراهيم بن موسي سمعت ابي يقول ذلك، ثنا عبد الرحمن قال سالت ابي عن قتادة بن الفضل فقال شيخ.
   قتادة بن سوار بن سعيد الجرمي اخو انيس بن سوار روي
 
 عن ابيه روي عنه المقدمي وابو بكر بن ابي الاسود سمعت ابي يقول ذلك.
 باب تسمية من روي عنه العلم ممن يسمي قعقاعا   قعقاع بن عمرو قال شهدت وفاة رسول الله صلي الله عليه وسلم فيما رواه سيف بن عمر عن عمرو بن تمام عن ابيه عنه وسيف متروك الحديث فبطل الحديث وانما كتبنا ذكر ذلك للمعرفة.
   قعقاع بن ابي حدرد الاسلمي ويقال قعقاع بن عبد الله بن ابي حدرد ولا يصح له صحبة وهو زوج بقيرة روي عبد الله بن سعيد المقبري عن ابيه عنه سمعت ابي يقول ذلك وادخله بعض الناس في كتاب الضعفاء فسمعت ابي يقول يحول من هذا الكتاب فان الراوي عنه عبد الله بن سعيد المقبري وعبد الله ضعيف.
   قعقاع بن حكيم الكناني مديني روي عن جابر وابن عمر وابي صالح وعبد الرحمن بن وعلة ورميثة روي عنه سعيد المقبري وابن عجلان وجعفر بن عبد الله بن الحكم، نا عبد الرحمن قال سمعت ابي يقول ذلك، نا عبد الرحمن نا صالح بن احمد بن محمد بن حنبل نا علي يعني ابن المديني قال قلت ليحيي سمي اثبت عندك او القعقاع بن حكيم؟ قال قعقاع احب الي، نا عبد الرحمن نا محمد بن حمويه بن الحسن قال سمعت ابا طالب قال قال احمد بن حنبل القعقاع بن حكيم مديني ثقة؟
 نا عبد الرحمن نا يعقوب بن اسحاق الهروي فيما كتب الي قال نا عثمان بن سعيد الدارمي قال قلت ليحيي بن معين القعقاع بن حكيم؟ فقال ثقة، نا عبد الرحمن قال سالت ابي عن القعقاع بن حكيم فقال ليس بحديثه باس.
   قعقاع بن اللجلاج روي عن ابي هريرة روي عنه صفوان بن ابي يزيد سمعت ابي يقول ذلك وقال محمد بن عمرو عن حصين بن اللجلاج، قال يحيي بن معين فيما ذكره ابي عن اسحاق بن منصور عنه ان القعقاع اصوب. 
   قعقاع بن يزيد بن شبرمة الضبي كوفي اعمي روي عن الحسن وابراهيم النخعي روي عنه المغيرة والثوري وشريك وجرير سمعت ابي يقول ذلك، نا عبد الرحمن نا محمد بن حمويه بن الحسن قال سمعت ابا طالب قال قال احمد بن حنبل القعقاع بن يزيد كوفي ثقة، نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال القعقاع الذي يروي عنه سفيان ثقة.
   قعقاع بن الصلت روي عن الشعبي روي عنه جرير بن عبد الحميد سمعت ابي يقول ذلك.
   قعقاع بن قطيعة روي عن الحسن روي عنه جرير بن عبد الحميد سمعت ابي يقول ذلك.
   قعقاع بن شور روي عن.. () نا عبد الرحمن قال سالت ابي عنه وقلت ان البخاري ادخل اسمه فيمن يسمي القعقاع فقال لا يعلم للقعقاع ابي شور رواية والذي يحدث يقال له عبد الملك ابي اخي القعقاع بن شور.
 باب تسمية من روي عنه العلم ممن يسمي قطنا   قطن بن عبد الله روي عن عبد الله بن الزبير روي عنه مغيرة ابن مقسم سمعت ابي يقول ذلك.
   قطن بن عبد الله ابو مري الحداني روي عن ابي غالب ونصر المعلم روي عنه ابو بكر بن ابي شيبة ومحمد بن مهران الجمال سمعت ابي يقول ذلك.
   قطن روي عن معاوية روي عنه ابنه سعيد بن قطن سمعت ابي يقول ذلك.
   قطن بن قبيصة بن مخارق الهلالي روي عن ابيه روي عوف (الاعرابي عن حيان عنه سمعت ابي يقول ذلك، قال ابو محمد روي عنه ابنه حرب
 
 ابن قطن.
   قطن بن وهب  ) بن عويمر بن الاجدع الليثي ابو الحسن مديني روي عن يحنس مولي الزبير وعن عمه روي عنه مالك بن انس وعبيد الله ابن عمر والضحاك بن عثمان سمعت ابي يقول ذلك، نا عبد الرحمن قال سءل ابي عنه فقال صالح الحديث.
   قطن ابو المحجل روي عن انس بن مالك روي عنه منصور بن ابي الاسود (روي عنه عبد الصمد بن عبد الوارث  ).
   قطن بن كعب ابو الهيثم القطعي بصري روي عن محمد بن سيرين وابي يزيد المديني وعقبة بن عبد الغافر وايوب روي عنه شعبة وحماد بن زيد وجعفر بن سليمان سمعت ابي يقول ذلك، نا عبد الرحمن قال ذكره ابي عن اسحاق ابن منصور عن يحيي بن معين انه قال قطن بن كعب القطعي ثقة، نا عبد الرحمن قال سءل ابو زرعة عن قطن بن كعب القطعي فقال بصري ثقة روي عن ام عتبة روي عنه محمد بن بكر البرساني.
   قطن بن نسير ابو عباد الغبري البصري المعروف بالذارع روي عن جعفر بن سليمان وعدي بن ابي عمارة سمعت ابي يقول ذلك، نا عبد الرحمن قال سءل ابو زرعة عنه فرايته يحمل عليه ثم ذكر انه روي احاديث عن جعفر بن سليمان (عن ثابت عن انس  ) مما انكر عليه.
   قطن بن ابراهيم ابو سعيد النيسابوري روي عن حفص بن عبد الله سمعت ابي يقول ذلك، قال ابو محمد وسمع منه ابي، نا عبد الرحمن نا احمد ابن سلمة نا محمد بن يحيي النيسابوري وسءل عن قطن بن ابراهيم النيسابوري فقال صدوق مسلم اكتبوا عنه، وروي عن عثمان بن الهيثم المءذن والحسين بن الوليد النيسابوري روي عنه ابي وابو زرعة، نا عبد الرحمن قال سءل ابي عن قطن بن ابراهيم النيسابوري فقال شيخ.
 
 باب تسمية من روي عنه العلم ممن يسمي قزعة   قزعة بن يحيي مولي زياد ويقال مولي عبد الملك ويقال هو جرشي روي عن ابي سعيد الخدري وابن عمر وعبد الله بن عمرو وابي هريرة روي عنه مجاهد وعمارة بن عمير وعاصم الاحول وقتادة وعبد الملك بن عمير ويحيي بن اسماعيل بن جرير وسهم بن منجاب وعمرو بن دينار وروي عمرو بن دينار عن طلق عنه حديث الطور ولا ندري سمع منه قتادة ام لا فانه يحدث عن عبد الرحمن بن برثن عن قزعة سمعت ابي يقول ذلك.
   (قزعة الجمال روي عن انس روي عنه يحيي بن دينار ابو هاشم سمعت ابي يقول ذلك  ).
   قزعة مولي عبد القيس روي عن عكرمة روي عنه زياد بن سعد سمعت ابي يقول ذلك، نا عبد الرحمن قال سءل ابو زرعة عن قزعة مولي عبد القيس فقال مكي ثقة.
   قزعة بن سويد بن حجير الباهلي وهو قزعة بن ابي قزعة بصري روي عن ابيه وابن ابي نجيح وحميد بن قيس الا عرج وحجاج بن الحجاج روي عنه مسلم بن ابراهيم ومسدد وعبد الله بن عاصم وابراهيم بن الحجاج السلمي واسماعيل بن ابراهيم الترجماني والقواريري سمعت ابي يقول ذلك، قال ابو محمد وروي عن ابن ابي مليكة ومحمد بن المنكدر.
 نا عبد الرحمن نا محمد بن حمويه بن الحسن قال سمعت ابا طالب قال قال احمد بن حنبل قزعة بن سويد مضطرب الحديث، انا عبد الرحمن قال قرء علي العباس بن محمد الدوري قال سءل يحيي بن معين عن قزعة بن سويد فقال ضعيف.
 نا عبد الرحمن قال سالت ابي عن قزعة بن سويد فقال ليس بذاك
 
 القوي محله الصدق وليس بالمتين يكتب حديثه ولا يحتج به.
 باب تسمية من روي عنه العلم ممن يسمي قتيبة   قتيبة بن عبد الرحمن بن عثمان بن قدامة ابو عثمان الرءاسي روي عن ابيه عن الضحاك روي عنه وكيع بن الجراح سمعت ابي يقول ذلك.
   قتيبة بن سعيد ابو رجاء البغلاني البلخي مولي ثقيف روي عن الليث بن سعد ومالك بن انس وابن لهيعة وبكر بن مضر وحماد بن زيد ويعقوب بن عبد الرحمن وابي عوانة وعبد الواحد سمعت ابي يقول ذلك، قال ابو محمد روي عنه ابي وابو زرعة.
 نا عبد الرحمن انا علي بن ابي طاهر فيما كتب الي قال نا ابو بكر الاثرم قال سمعت ابا عبد الله احمد بن حنبل وذكر قتيبة بن سعيد فاثني عليه وقال هو من اخر من سمع من ابن لهيعة، نا عبد الرحمن انا ابو بكر بن ابي خيثمة فيما كتب الي قال سءل يحيي بن معين عن قتيبة فقال ثقة.
 نا عبد الرحمن قال سمعت ابي يقول حضرت قتيبة بن سعيد ببغداد وقد جاءه احمد بن حنبل فساله عن احاديث فحدثه ثم جاءه ابو بكر بن ابي شيبة وابن نمير بالكوفة ليلة وحضرت معهما فلم يز لا ينتخبان عليه وانتخب معهما الي الصبح، نا عبد الرحمن قال سءل ابي عنه فقال ثقة.
   قتيبة ابو محمد الزمي روي عن شيبان عن ابي طيبة الجرجاني وروي عن وراد عنه ادم العسقلاني وابو عمير عيسي بن محمد الرملي، نا عبد الرحمن قال سالت ابي عنه فقال لا يعرف هو ولا شيبان وهو مجهول.
   قتيبة بن مهران روي عن شريك روي عنه يونس بن حبيب الاصفهاني وذكر انه من خيار الناس، نا عبد الرحمن قال سالت ابي عنه فقال لا اعرفه والحديث الذي رواه مشهور. 
 باب تسمية من روي عنه العلم ممن يسمي قطبة   قطبة بن مالك من بني ثعلبة عم زياد بن علاقة كوفي له صحبة روي عنه زياد بن علاقة سمعت ابي يقول ذلك.
   قطبة بن عامر بن حديدة احد بني سلمة بن سعد يكني ابا زيد توفي في خلافة عثمان له صحبة سمعت ابي يقول ذلك.
   قطبة بن حريز اتي النبي صلي الله عليه وسلم فاسلم ويكني بابي الحوصلة وهو اول من فتح الابلة روي ذلك من اسلامه معاذ () بن معدان فيما روي عن ابن كهمس عن عمران بن حدير عن معاذ بن معدان.
   قطبة بن قتادة السدوسي بصري روي عن.. () روي عنه رجل يقال له مقاتل ابو عبد الرحمن سمعت ابي يقول ذلك.
   قطبة بن عبد العزيز الحماني الكوفي اخو يزيد بن عبد العزيز بن سياه روي عن الاعمش روي عنه يحيي بن ادم سمعت ابي يقول ذلك.
 نا عبد الرحمن انا عبد الله بن احمد بن محمد بن حنبل فيما كتب الي قال سمعت ابي يقول قطبة بن عبد العزيز شيخ ثقة، نا عبد الرحمن انا ابو بكر بن ابي خيثمة فيما كتب الي قال سمعت يحيي بن معين يقول قطبة بن عبد العزيز كوفي ثقة.
 نا عبد الرحمن قال سالت ابي عن قطبة بن عبد العزيز ويزيد بن عبد العزيز بن سياه فقال قطبة احلي.
   قطبة بن العلاء بن المنهال الغنوي الكوفي ابو سفيان روي عن الثوري وابيه وراي محمد بن سوقة سمعت ابي يقول ذلك وسمع منه ابي وروي عنه، نا عبد الرحمن قال سالت ابي عنه فقال كتبنا عنه ما بلغنا الاخير، قلت له ان
 
 البخاري ادخله في كتاب الضعفاء قال ذلك مما تفرد به، قلت ما حاله؟ قال شيخ يكتب حديثه ولا يحتج به.
 نا عبد الرحمن قال سالت ابا زرعة عن قطبة بن العلاء (فقال يحدث عن سفيان باحاديث منكرة، نا عبد الرحمن قال قلت لابي زرعة قطبة بن العلاء  ) ويحيي بن اليمان ايهما احب اليك في الثوري؟ قال يحيي اكثر حديثا ومن كان اكثر حديثا منهما فهو اكثر خطا.
 باب تسمية من روي عنه العلم ممن يسمي قريشا   قريش بن حيان ابو بكر العجلي من بني بكر بن واءل بصري روي عن الحسن ومحمد وابي غالب وبكر بن واءل (ومالك بن دينار  ) روي عنه وكيع وسليمان بن حرب وعبد الرحمن بن المبارك سمعت ابي يقول ذلك، قال ابو محمد وروي عن ثابت البناني وقتادة روي عنه الاوزاعي وعبد الله بن وهب ومسلم بن ابراهيم.
 نا عبد الرحمن انا محمد بن حمويه بن الحسن سمعت ابا طالب قال سالت احمد ابن حنبل عن قريش بن حيان قال لا باس به كان بالاهواز، نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال قريش بن حيان ثقة، نا عبد الرحمن قال سالت ابي عن قريش بن حيان فقال لا باس به.
   قريش بن انس ابو انس بصري يقال انه تغير عقله وكان سنة ثنتين وماءتين صحيح العقل ومات سنة ثمان وماءتين روي عن حبيب بن الشهيد وعوف ومحمد بن عمرو روي عنه علي بن المديني وابو خيثمة ويحيي بن ابي الخصيب سمعت ابي يقول ذلك،.
 نا عبد الرحمن قال سمعت ابي يقول قال علي بن المديني كان قريش
 
 ابن انس ثقة، نا عبد الرحمن قال سءل ابي عن قريش بن انس فقال لا باس به.
 باب تسمية من روي عنه العلم ممن يسمي قربا   قربا بن ايوب كوفي روي عن السدي روي عنه يحيي بن واضح سمعت ابي يقول ذلك.
   قربا بن دنيق بصري روي عن.. () روي عنه سعيد بن عامر الضبعي سمعت ابي يقول ذلك.
 باب تسمية من روي عنه العلم ممن يسمي قباثا من الطبقة الاولي   قباث بن اشيم الكناني ثم الليثي له صحبة روي عنه ابو الحويرث عبد الرحمن بن معاوية بن الحويرث، وروي يونس بن سيف عن عبد الرحمن بن زياد الليثي عنه سمعت ابي يقول ذلك.
 نا عبد الرحمن قال سمعت محمد بن عوف الحمصي يقول كل من روي عن يونس بن سيف فانه يقول عن عبد الرحمن بن زياد عن قباث الا محمد بن الوليد الزبيدي فانه يقول عن عامر بن زياد عن قباث.
   قباث بن رزين ابو هاشم اللخمي المقرء مصري روي عن عكرمة وعلي بن رباح روي عنه ابن المبارك وابو عبد الرحمن المقرء وابو صالح كاتب الليث، نا عبد الرحمن انا حرب بن اسماعيل الكرماني فيما كتب الي قال قال احمد بن حنبل قباث بن رزين لا باس به، نا عبد الرحمن قال سءل ابي عن قباث بن رزين قال لا باس بحديثه.
 باب تسمية من روي عنه العلم ممن يسمي قيراطا   قيراط ابو العالية روي عن مجاهد والحسن روي عنه شريك
 
 سمعت ابي يقول ذلك.
   قيراط الحجام روي عن زيد بن علي ان اخذ شعره روي عنه ابو سعيد الاشج.
 باب تسمية من روي عنه العلم ممن يسمي قرظة   قرظة بن كعب بن ثعلبة بن عمرو بن الاطنابة الانصاري يقال له صحبة سكن الكوفة وهو احد بني الحارث بن الخزرج حليف بني عبد الاشهل يكني ابا عمرو ابتني بالكوفة دارا توفي في خلافة علي رضي الله عنه بالكوفة وهو صلي عليه روي عنه عامر بن سعد والشعبي وروي سعد بن ابراهيم عن قرظة مرسلا سمعت ابي يقول ذلك.
   قرظة بن ارطاة العبدي روي عن كثير بن شهاب روي عنه ابو اسحاق السبيعي سمعت ابي يقول ذلك.
 باب تسمية من روي عنه العلم ممن يسمي قران   قران بن تمام الاسدي ابو عامر الكوفي روي عن هشام بن عروة ووفاء بن اياس وايمن بن نابل وعبد الله بن عامر الاسلمي روي عنه سريج بن يونس وسعيد بن محمد الجرمي سمعت ابي يقول ذلك، قال ابو محمد وروي عن سهيل بن ابي صالح ومحمد بن ابي حميد روي عنه الحسن بن عرفة، سمعت ابي يقول قال يحيي بن معين قران بن تمام ثقة، نا عبد الرحمن قال سالت ابي عن قران بن تمام فقال هو شيخ لين.
   قران بن محمد الفزاري روي عن عيسي بن تميلة الفزاري روي عنه محمد بن عمر سمعت ابي يقول هو مجهول ومحمد بن عمر هو الواقدي. 
 باب تسمية من روي عنه العلم ممن يسمي قثم   قثم بن العباس بن عبد المطلب الهاشمي روي عنه ابو اسحاق الهمداني سمعت ابي يقول ذلك.
   قثم بن لءلءة مولي ال العباس الهاشمي روي عن امه عن علي رضي الله عنه وروي عن علي ايضا روي عنه مغيرة بن مقسم ويزيد بن عبد الرحمن الدالاني والوليد بن عبد الله بن جميع سمعت ابي يقول ذلك.
 باب تسمية من روي عنه العلم ممن يسمي قابوس   قابوس بن المخارق بن سليم كوفي روي عن ام الفضل بنت الحارث وعن ابيه وقد سمع من ابيه وابوه سمع من النبي صلي الله عليه وسلم روي عنه سماك بن حرب سمعت ابي يقول ذلك.
   قابوس بن ابي ظبيان وابو ظبيان اسمه الحصين بن جندب الليثي روي عن ابيه روي عنه سفيان الثوري وزهير ابو كدينة وجرير وابن ادريس سمعت ابي يقول ذلك، قال ابو محمد روي عنه حنش بن الحارث، نا عبد الرحمن نا علي بن الحسين بن الجنيد نا محمد بن المثني قال سمعت يحيي بن سعيد يحدث عن سفيان عن قابوس بن ابي ظبيان وما سمعت عبد الرحمن بن مهدي يحدث عنه شيءا.
 نا عبد الرحمن انا عبد الله بن احمد بن محمد بن حنبل فيما كتب الي قال سالت ابي عن قابوس بن ابي ظبيان فقال سءل جرير عن شء من احاديث قابوس فقال نفق قابوس نفق، قال عبد الله قلت لابي فما تقول فيه؟ فقال ليس هو بذاك روي الناس عنه، قال عبد الله وسالت يحيي بن معين عن قابوس فقال ضعيف الحديث، قال ابو محمد سالت ابي عن قابوس بن ابي ظبيان فقال (ضعيف الحديث  ) لين يكتب حديثه ولا يحتج به.
 
 باب تسمية من روي عنه العلم ممن يسمي قنبرا   قنبر خادم علي بن ابي طالب روي عن علي روي عنه... () سمعت ابي يقول ذلك.
   قنبر صاحب معاوية روي عن ابي ذر وسلمان وعبادة بن الصامت ومعاوية وام حرام روي عنه يحيي بن ابي عمرو الشيباني.
 باب تسمية من روي عنه العلم ممن يسمي قرطا   قرط بن خيثمة من بني قيس بن ثعلبة بصري روي عن علي وابي موسي الاشعري روي عنه مسلم بن مخراق ابو الاسود وطلق بن خشاف وداود بن نفيع سمعت ابي يقول ذلك.
   (قرط ابو توبة روي عن ابراهيم النخعي وغيره روي عنه وكيع سمعت ابي يقول ذلك  ).
   قرط بن عيوق () روي عن.. ()، نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال قرط بن عيوق ثقة.
   قرط بن حريث مولي باهلة روي عن علي، نا عبد الرحمن قال قرء علي العباس بن محمد الدوري عن يحيي بن معين انه قال قرط بن حريث ليس به باس.
 باب تسمية من روي عنه العلم من الافراد الذين ابتداء اسمهم علي القاف   قارب بن عبد الله بن الاسود بن مسعود الثقفي يقال ان له صحبة روي عنه ابنه عبد الله بن قارب وابراهيم بن ميسرة سمعت ابي يقول ذلك 
 
 (قال ابو زرعة انما روي ابن عيينة عن ابراهيم بن ميسرة عن وهب بن عبد الله  )   قهيد بن مطرف الغفاري مديني روي عن عبد العزيز بن المطلب ابن عبد الله بن حنطب عن اخيه الحكم بن عبد الله عن ابيه المطلب عن قهيد الغفاري انه قال سال ساءل رسول الله صلي الله عليه وسلم فقال ان عدا علي عادي؟
 قال ذكره بالله عز وجل، وروي ابن وهب عن الليث عن يزيد بن الهاد عن عمرو بن قهيد بن مطرف عن ابي هريرة عن النبي صلي الله عليه وسلم، وروي ابن ابي اويس عن ابن وهب عن يحيي بن عبد الله بن سالم عن عمرو مولي المطلب عن قهيد بن مطرف عن ابي هريرة عن النبي صلي الله عليه وسلم سمعت ابي يقول ذلك.
   قسامة بن زهير المازني روي عن ابي موسي الاشعري وابي هريرة روي عن قتادة وغنيم بن قيس وعوف الاعرابي وعمران بن حدير وتوفي في ولاية الحجاج سمعت ابي يقول ذلك، نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال قسامة بن زهير ثقة.
   قيلويه ابو صالح بصري روي عن ابن عباس روي عنه يحيي بن ابي كثير سمعت ابي يقول ذلك، نا عبد الرحمن انا ابو بكر بن ابي خيثمة فيما كتب الي قال سالت يحيي بن معين عن ابي صالح الذي روي عنه يحيي بن ابي كثير فقال اسمه قيلويه بصري ثقة مامون.
   قرثع الضبي وكان من قراء الاولين روي عن عمر بن الخطاب وسلمان روي عنه (علقمة بن قيس وقزعة  ) سمعت ابي يقول ذلك.
   قرفة بن بهيس ابو الدهماء العدوي روي عن عمران بن حصين وهشام بن عامر روي عنه حميد بن هلال سمعت ابي يقول ذلك، حدثنا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال ابو الدهماء ثقة.
   قيظي بن شداد بن اسيد السلمي روي عن ابيه روي عنه ابنه
 
 عمرو بن قيظي سمعت ابي يقول ذلك.
   قارظ بن شيبة بن قارظ حلفاء بني زهرة القارظي احد بني ليث من بني كنانة حلفاء لقريش وهو اخو عمرو بن شيبة مات في خلافة سليمان ابن عبد الملك بالمدينة روي عن سعيد بن المسيب وابي غطفان روي عنه ابن ابي ذءب واخوه عمرو بن شيبة سمعت ابي يقول ذلك.
   قسيم مولي عمارة روي عن قزعة صاحب ابي سعيد في الصلاة روي عنه ابان بن صالح سمعت ابي يقول ذلك.
   قنان بن عبد الله النهمي كوفي روي عن زر بن حبيش ومصعب ابن سعد وعبد الرحمن بن عوسجة روي عنه موسي بن محمد الانصاري وعبد الواحد ابن زياد وعبد الرحيم بن سليمان الرازي ومروان بن معاوية وحفص بن غياث وابن فضيل سمعت ابي يقول ذلك، قال ابو محمد وروي عن سهل بن شعيب النهمي الكوفي، نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال قنان بن عبد الله ثقة.
   قرين روي عن عامر بن سعد وابي سلمة بن عبد الرحمن روي عنه ابن ابي ذءب وعبيد الله بن عبد الرحمن بن موهب سمعت ابي يقول ذلك.
   قيصر من اهل مصر روي عن ابن عمر روي عنه مكحول ويزيد بن ابي حبيب وجعفر بن ربيعة سمعت ابي يقول ذلك، وسالته عنه فقال ليس به باس.
   قعنب التميمي كوفي روي عن علقمة بن مرثد وابي عبيدة بن عبد الله روي عنه سفيان بن عيينة سمعت ابي يقول ذلك، نا عبد الرحمن نا (ابي  ) نا الحميدي نا سفيان نا قعنب التميمي وكان ثقة خيارا.
   قشير بن عمرو روي عن بجالة بن عبدة روي عنه داود بن ابي هند سمعت ابي يقول ذلك.
   قطري الخشاب روي عن سريع مولي عمرو بن حريث
 
 وعبد الوارث مولي انس ومدرك روي عنه وكيع وجعفر بن عون وعبيد الله ابن موسي وعبيد بن اسحاق العطار وعبد الحميد بن صالح سمعت ابي يقول ذلك، قال ابو محمد قطري هو مولي طارق روي عنه ابو داود الطيالسي سالت ابي عنه فقال لا باس به.
   قحذم بن ابي قحذم الجرمي البصري وهو قحذم بن النضر بن معبد روي عن ابيه وسالم بن عبد الله ومكحول روي عنه قتيبة بن سعيد سمعت ابي يقول ذلك، قال ابو محمد روي عنه ابراهيم بن مهدي المصيصي   قريب بن عبد الملك والد عبد الملك بن قريب الاصمعي صاحب العربية روي عن ابي غالب عن ابي امامة روي عنه عمرو بن عاصم الكلابي.
   قحطبة بن غدانة () الجشمي ابو معمر روي عن هشام الدستواءي وسعيد بن ابي عروبة وحسام بن مصك وزياد بن درهم سمع منه ابي بالبصرة ايام الانصاري وروي عنه، نا عبد الرحمن قال سالت ابي عنه فقال صدوق.
 باب تسمية من روي عنه العلم ممن يسمي كثيرا وابتدي اسم ابيه علي الالف   كثير بن افلح مولي ابي ايوب الانصاري اصيب يوم الجزة روي عن زيد بن ثابت وابي سعيد الخدري وابن عمر روي عنه محمد بن سيرين والزهري سمعت ابي يقول ذلك.
   كثير بن ابي اسماعيل روي عن عمر بن بشير الهمداني روي عنه ابو مخنف لوط بن يحيي سمعت ابي يقول ذلك.
 باب الجيم   كثير بن جمهان السلمي كوفي روي عن ابن عمر وابي هريرة وابي عياض روي عنه عطاء بن الساءب سمعت ابي يقول ذلك وسمعته يقول هو شيخ يكتب حديثه.
 
   كثير بن جعفر بن ابي كثير اخو اسماعيل بن جعفر مولي بني زريق الانصاري روي عن ابي طوالة وعلاقة وزيادة ابني عبد الله بن زيد من بني حارثة روي عنه ابراهيم بن المنذر وابو ثابت محمد بن عبد الله سمعت ابي يقول ذلك، قال ابو محمد وروي عن ابيه وعمر مولي غفرة وزيد بن اسلم.
 باب الحاء   كثير بن الحارث روي عن القاسم ابي عبد الرحمن روي عنه معاوية بن صالح سمعت ابي يقول ذلك، نا عبد الرحمن قال سالت () ابي عنه فقال هو صالح الحديث.
   كثير بن حبيب الليثي اليشكري روي عن ثابت البناني روي عنه علي بن المديني ومحمد بن ابي بكر المقدمي واحمد بن عبد الله بن صخر والصلت ابن مسعود سمعت ابي يقول ذلك وسالته عنه فقال لا باس به.
 باب الخاء   كثير بن خنيس الليثي روي عن انس بن مالك وعمرة بنت عبد الرحمن روي عنه الاسود بن العلاء ومحمد بن عمرو بن علقمة وجعفر بن ربيعة سمعت ابي يقول ذلك، قال ابو محمد كان البخاري جعل هذا الاسم اسمين فسمعت ابي يقول هما واحد وسالته عنه فقال هو مديني مستقيم الحديث لا باس بحديثه.
 باب الدال   كثير بن دينار الحمصي جد عثمان بن سعيد بن كثير بن دينار روي عن انس وعمر بن عبد العزيز قوله روي عنه ابنه سعيد بن كثير ويحيي بن صالح الوحاظي سمعت ابي يقول ذلك.
 باب الزاي   كثير بن زيد مولي الاسلميين ابو محمد توفي في اخر زمن ابي جعفر روي عن سالم ونافع ومطلب وربيح بن عبد الرحمن والوليد
 
 ابن رباح وعثمان بن عبد الله بن سراقة روي عنه حماد بن زيد وعبد العزيز بن ابي حازم وحاتم بن اسماعيل وعبد العزيز الدراوردي وابو نباتة يونس بن يحيي وعيسي بن يونس ووكيع وابو احمد الزبيري وابو عامر العقدي وسفيان بن حمزة سمت ابي يقول ذلك.
 نا عبد الرحمن انا ابو بكر بن ابي خيثمة فيما كتب الي قال سءل يحيي بن معين عن كثير بن زيد فقال ليس بذاك القوي، نا عبد الرحمن قال سءل ابي عن كثير بن زيد فقال صالح (ليس بالقوي  ) يكتب حديثه، نا عبد الرحمن قال سءل ابو زرعة عن كثير بن زيد فقال هو صدوق فيه لين.
   كثير بن زياد ابو سهل البرساني بصري الاصل سكن بلخ روي عن الحسن روي عنه حماد بن زيد وسلام بن مسكين وجعفر بن زياد الاحمر وجويبر وعلي بن عبد الاعلي ونوح بن قيس وعمرو بن الرماح والوسيم بن جميل عم قتيبة وغالب بن سليمان سمعت ابي يقول ذلك.
 نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال كثير بن زياد ابو سهل ثقة، نا عبد الرحمن قال سالت ابي عن كثير بن زياد فقال هو ثقة من اكابر اصحاب الحسن لا باس به (بصري وقع الي خراسان  ).
   كثير بن زاذان روي عن عبد الرحمن بن ابي نعم روي عنه عنبسة بن سعيد قاضي الري، نا عبد الرحمن انا يعقوب بن اسحاق فيما كتب الي قال نا عثمان بن سعيد قال قلت ليحيي بن معين كثير بن زاذان من هو؟ قال لا اعرفه، نا عبد الرحمن قال سالت ابي وابا زرعة عنه فقالا هذا شيخ مجهول لا نعلم احد احدث عنه الا ما روي ابن حميد عن هارون بن المغيرة عن عنبسة عنه.
   كثير بن ابي زفاف سمع ابن عمر قوله في السمك روي عنه حماد ابن سعيد البراء سمعت ابي يقول ذلك.
 
 باب السين   كثير بن سليمان روي عن ابن عمر روي عنه عبيد الله بن المغيرة سمعت ابي يقول ذلك.
   كثير بن سليم ابو سلمة المداءني روي عن انس بن مالك والضحاك بن مزاحم روي عنه احمد بن عبد الله بن يونس واسماعيل بن ابان الوراق وعمرو بن عون وابو صالح كاتب الليث ومحمد بن عبد الملك بن ابي الشوارب سمعت ابي يقول ذلك.
 نا عبد الرحمن قال قرء علي العباس بن محمد الدوري عن يحيي بن معين انه قال كثير بن سليم ضعيف، نا عبد الرحمن قال سالت ابا زرعة عن كثير بن سليم فقال واهي الحديث،.
 نا عبد الرحمن قال سالت ابي عن كثير بن سليم فقال ضعيف الحديث منكر الحديث لا يروي عن انس حديثا له اصل من رواية غيره.
   كثير بن الساءب روي عن محمود بن لبيد روي عنه هشام بن عروة ومحمد بن اسحاق سمعت ابي يقول ذلك.
   كثير بن الساءب روي عن ابي () قريظة روي عنه عمارة بن خزيمة بن ثابت سمعت ابي يقول ذلك.
   كثير بن سعيد بن رومان روي عن ابيه عن ابن عمر روي عنه محمد بن مطرف سمعت ابي يقول ذلك.
   كثير بن سويد الجندي يماني روي عن عبد الله بن زبيب روي عنه معمر سمعت ابي يقول ذلك.
   كثير بن سام روي عن محمد ابن الحنفية روي عنه علي بن صالح ابن صالح سمعت ابي يقول ذلك.
 
 باب الشين   كثير بن شهاب الحارثي روي عن عمر رضي الله عنه روي عنه قرظة بن ارطاة وصبيح المزني سمعت ابي يقول ذلك، نا عبد الرحمن قال سمعت ابا زرعة يقول فتح قزوين كثير بن شهاب بعد فتح الري بكم.
   كثير بن شهاب المذحجي من ولد انس بن سعد العشيرة ابو الحسن القزويني روي عن محمد بن سعيد بن سابق وعبد الله بن الجراح القهستاني والحسن ابن محمد الطنافسي كتبت عنه بقزوين وهو صدوق.
   كثير بن شنظير ابو قرة روي عن الحسن وعطاء روي عنه حماد بن زيد وابان بن يزيد العطار والاسود بن شيبان وعبد الوارث وهشام ابن حسان وعباد بن عباد سمعت ابي يقول ذلك.
 حدثنا عبد الرحمن نا محمد بن ابراهيم نا عمرو بن علي قال كان يحيي بن سعيد لا يحدث عن كثير بن شنظير حدثته يوما عن بشر بن المفضل عن كثير بن شنظير فقال كثير بن شنظير كثير بن شنظير،.
 نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال كثير بن شنظير صالح، نا عبد الرحمن انا عبد الله بن احمد بن حنبل فيما كتب الي قال سالت ابي عن كثير بن شنظير فقال صالح، ثم قال قد روي عنه الناس واحتملوه وقال مرة صالح الحديث، نا عبد الرحمن قال سءل ابو زرعة عن كثير بن شنظير فقال بصري لين.
 باب الصاد   كثير بن الصلت الكندي حجازي ابو عبد الله ولد في عهد النبي صلي الله عليه وسلم وكان عدادهم في جمح فتحولوا الي العباس روي عن ابي بكر الصديق وعثمان بن عفان وزيد بن ثابت سمعت ابي يقول ذلك.
 باب العين   كثير بن العباس بن عبد المطلب الهاشمي كان ينزل المدينة روي 
 عنه الاعرج والزهري وابو الاصبغ السلمي سمعت ابي يقول ذلك.
   كثير بن عبد الله الايلي البصري ويقال الانساني كان يسكن قرية انس بن مالك ابو هاشم روي عن انس روي عنه.. () سمعت ابي يقول ذلك وسمعته يقول هو منكر الحديث ضعيف الحديث جدا شبه المتروك بابة زياد ابن ميمون.
   كثير بن عبد الله بن عمرو بن عوف المزني روي عن ابيه ومحمد ابن كعب وربيح بن عبد الرحمن روي عنه عبد العزيز بن محمد ومروان بن معاوية ومعن بن عيسي وعبد الله بن وهب وعبد الله بن نافع الصاءغ ومحمد بن خالد بن عثمة وابو عامر العقدي وخالد بن مخلد وابن قعنب وابن ابي اويس سمعت ابي يقول ذلك.
 نا عبد الرحمن نا محمد بن حمويه بن الحسن قال سمعت ابا طالب قال سالت احمد يعني ابن حنبل عن كثير بن عبد الله بن عمرو بن عوف فقال منكر الحديث ليس بشء.
 نا عبد الرحمن قال قرء علي العباس بن محمد الدوري عن يحيي بن معين انه قال كثير بن عبد الله المزني ضعيف الحديث، نا عبد الرحمن قال سالت ابا زرعة عن كثير بن عبد الله بن عمرو بن عوف فقال واهي الحديث ليس بقوي، قلت له بهز بن حكيم وعبد المهيمن وكثير بن عبد الله ايهم احب اليك؟ فقال بهز وعبد المهيمن احب الي منه، نا عبد الرحمن قال سءل ابي عن كثير بن عبد الله بن عمرو بن عوف فقال ليس بالمتين.
   كثير بن عبد الله اليشكري روي عن الحسن بن عبد الرحمن بن عوف روي عنه مسلم بن ابراهيم وعبيد الله القواريري ومحمد بن ابي بكر المقدمي والصلت بن مسعود الجحدري سمعت ابي يقول ذلك.
   كثير بن عبد الرحمن المءذن روي عن عطاء روي عنه مروان بن معاوية وعبد الله بن داود الخريبي وعبيد الله بن موسي وابو نعيم
 
 سمعت ابي يقول ذلك.
   كثير بن عبد الرحمن الغطفاني روي عن سعيد بن المسيب روي عنه ابن ابي ذءب سمعت ابي يقول ذلك.
   كثير بن عبيد ابو سعيد كوفي رضيع عاءشة وهو مولي ابي بكر روي عن زيد بن ثابت وعاءشة واسماء بنت ابي بكر روي عنه مطرف وعبد الله بن عون ومجالد وبشير وابنه سعيد بن كثير بن عبيد وعبد الله بن دكين وعنبسة بن سعيد بن كثير سمعت ابي يقول ذلك.
   كثير بن عبيد الحذاء المقرء الحمصي ابو الحسن وهو ابن عبيد بن نمير المذحجي روي عن بقية ومحمد بن حرب الابرش ويحيي بن سليم الطاءفي ومروان الفزاري وابي حيوة ومحمد بن شعيب بن شابور روي عنه ابي وابو زرعة، نا عبد الرحمن قال سءل ابي عنه فقال كان ثقة.
 باب الفاء   كثير بن فرقد المديني روي عن نافع وابي بكر بن محمد بن عمرو ابن حزم وعبد الله بن مالك (بن حذافة وعبيد بن السباق روي عنه مالك  ) ابن انس والليث بن سعد وعمرو بن الحارث سمعت ابي يقول ذلك وسمعته يقول كان من اقران الليث وكان ثبتا، نا عبد الرحمن قال قرء علي العباس بن محمد الدوري قال قال يحيي بن معين كثير بن فرقد مديني كان بمصر يروي عنه ليث بن سعد وهو ثقة، نا عبد الرحمن قال سءل ابي عنه فقال صالح.
 باب القاف   كثير بن قيس روي عن ابي الدرداء روي عنه داود بن جميل سمعت ابي يقول ذلك، قال ابو محمد وروي عن ابن عمر روي ابو عاصم النبيل عن الوليد بن مرة عنه.
   كثير بن قنبر روي عن سالم بن عبد الله روي عن يزيد بن زريع
 
 والنضر بن شميل وروح بن عبادة وعلي بن عبد العزيز سمعت ابي يقول ذلك.
 باب الكاف   كثير بن كثير بن المطلب بن ابي وداعة القرشي المكي روي عن ابيه روي عنه ابن جريج ومعمر وهشام بن حسان وسالم الخياط وسفيان ابن عيينة سمعت ابي يقول ذلك، نا عبد الرحمن انا عبد الله بن احمد بن محمد بن حنبل فيما كتب الي قال قال ابي كثير بن كثير من قريش ثقة، نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال كثير بن كثير ابن المطلب بن ابي وداعة السهمي ثقة.
   كثير بن ابي كثير مولي عبد الرحمن بن سمرة روي عن عمر مرسلا وعن ابن عباس وعبد الرحمن بن سمرة وسعيد بن المسيب وابي سلمة ابن عبد الرحمن وابي عياض روي عنه قتادة وايوب السختياني سمعت ابي يقول ذلك.
   كثير بن ابي كثير ابو النضر روي عن ربعي بن حراش وابي بردة بن ابي موسي وعبد الله بن فروخ روي عنه عيسي بن يونس واسحاق بن سليمان وابو عاصم وبراد بن يوسف سمعت ابي يقول ذلك، نا عبد الرحمن انا ابو بكر بن ابي خيثمة فيما كتب الي قال سءل يحيي بن معين عن كثير ابي النضر فقال ضعيف الحديث، نا عبد الرحمن قال سالت ابي عن كثير ابي النضر فقال شيخ مستقيم الحديث.
  كثير بن كليب الجهني ولابيه صحبة روي عن ابيه روي عنه ابنه عثيم بن كثير بن كليب سمعت ابي يقول ذلك.
 باب الميم   كثير بن المطلب بن ابي وداعة القرشي السهمي المكي روي عن ابيه روي عنه ابنه جعفر بن كثير سمعت ابي يقول ذلك. 
   كثير بن مرة الحضرمي ابو شجرة الحمصي روي عن معاذ بن جبل وعمرو بن عبسة وعقبة بن عامر وروي يزيد بن ابي حبيب انه قال () ادرك كثير سبعين بدريا روي عنه خالد بن معدان ومكحول وابو الزاهرية والحسن بن عبد الرحمن ويزيد بن ابي حبيب سمعت ابي يقول ذلك.
   كثير بن مرة البهراني روي عن منصور بن زاذان روي عنه بقية، نا عبد الرحمن قال سالت ابي عنه فقال يروي عنه، شيخ.
   كثير بن مروان روي عن لقمان بن عامر روي عنه ابنه محمد بن كثير بن مروان، نا عبد الرحمن قال سمعت ابن الجنيد يقول كثير بن مروان ليس بقوي، نا عبد الرحمن قال سءل ابي عنه فقال يكتب حديثه ولا يحتج به.
