   احمد بن محمد بن يحيي بن سعيد القطان ابو سعيد البصري روي عن جده يحيي بن سعيد القطان ويونس بن بكير وعبد الله ( م) ابن نمير وعمرو العنقزي وابي اسامة ويحيي بن عيسي وصفوان ابن عيسي [وازهر السمان  ] وسويد بن عمرو، كتبنا عنه [بسامراء قدم من البصرة  ] وكان صدوقا [سءل ابي عنه فقال صدوق  ].
   احمد بن محمد بن الوليد بن برد الانطاكي () ابو جعفر روي عن محمد بن جعفر بن محمد العلوي وضمرة واسحاق بن الفرات قاضي مصر ورواد وابن ابي فديك وبشر بن بكر سمع منه ابي بانطاكية.
 حدثنا عبد الرحمن قال سءل ابي عنه فقال شيخ.
   احمد بن محمد ابو بكر الادمي وهو ابن محمد بن معلي () [الهدادي  ] البصري روي عن يحيي بن حماد ومحمد بن جهضم [وعارم  ] وابي همام () محمد بن محبب سمع منه ابي بالبصرة في الرحلة الثالثة [روي عنه ابي وابو عوانة  ].
   احمد بن محمد بن ساكن () الزنجاني روي عن ابي كريب وزياد
 
 ابن ايوب وابي مصعب سمعت منه بالكوفة مع ابي [وكان صدوقا  ].
   احمد بن محمد بن عاصم الرازي روي عن ابي الربيع الزهراني ومحمد بن ابان الواسطي وقتيبة واسحاق بن راهويه [كتبت عنه وهو صدوق  ].
   احمد بن محمد بن ابي اسلم الرازي روي عن () [يحيي بن يحيي النيسابوري واسحاق بن راهويه كتبت عنه ومحله الصدق.
   احمد بن محمد بن  ] الحجاج بن رشدين المصري روي عن عمرو بن خالد ويحيي بن بكير وابن ابي مريم سمعت منه بمصر ولم احدث عنه لما تكلموا فيه.
   احمد بن موسي صاحب اللءلء وهو ابن ابي مريم ابو عبد الله بصري روي عن ابن عون وعاصم الجحدري وابيه () موسي بن ابي مريم روي عنه معلي بن اسد ومحمد بن سعيد بن الوليد الخزاعي ونصر ابن علي ومحمد بن المثني.
 حدثنا عبد الرحمن قال سمعت ابي وابا زرعة يقولان ذلك. قال ابو محمد وروي عن شعيب بن صفوان عن ابن شبرمة جزء مساءل () روي عنه ابو بكر () بن الاسود.
   احمد () بن موسي الشطوي ابو جعفر البزار نزيل سامراء روي عن محمد بن سابق وزكريا بن عدي كتبت عنه مع ابي وهو صدوق.
   احمد بن معدان العبدي روي عن ثور بن يزيد روي عنه محمد ابن وزير الواسطي.
 حدثنا عبد الرحمن قال سالت ابي عنه فقال هو مجهول والحديث
 
 الذي رواه باطل.
   احمد بن مدرك () ابو عبد الله من قرية بيستا () روي عن عطاف بن قيس الزاهد ودحيم وعبد الله بن ذكوان روي عنه الفضل ابن شاذان ومحمد بن عيسي بن بسام [سالت ابي عنه فقال....  ].
   احمد بن معاوية بن وديع () المذحجي روي عن الحر بن وسيم العابد روي عنه محمد بن وهب بن عطية الدمشقي واحمد بن ابي الحواري والقاسم بن عثمان الجوعي وروي هو عن ابي معاوية () الاسود والوليد ابن مسلم.
   احمد بن معاوية روي عن علي بن عاصم وغيره روي عنه عمر () ابن شبة النميري.
   احمد بن مهران بن المنذر القطان الهمذاني ابو جعفر الذي سمع ابي في كتابه الموطا عن القعنبي روي عثمان بن الهيثم وعبد الله بن رجاء وحسن بن موسي الاشيب والانصاري وهو صدوق.
   احمد بن مروان الطويل الرازي كتب عنه ابي روي عن اسحاق ابن سليمان.
   احمد بن مصعب المروزي ابو عبد الرحمن الهجيمي روي عن الفضل بن موسي السيناني وعبد الرحمن بن مهدي وغندر وحفص بن
 
 غياث كتب عنه ابي بالري جاء الي محمد بن حميد، وسالته عنه فقال صدوق من اجلة اهل مرو.
   احمد بن مقاتل السمرقندي روي عن ابيه عن ابي سعيد الفراء روي عنه سلمة بن محمد بن احمد بن مجاشع السمرقندي ابو احمد   احمد بن المفضل ( م) الحفري القرشي مولي عثمان بن عفان روي عن الثوري وحسن بن صالح واسراءيل واسباط بن نصر ويحيي بن سلمة ابن كهيل روي عنه عبد الله بن محمد بن ابي شيبة، يعد في الكوفيين.
 حدثنا عبد الرحمن قال سمعت ابي وابا زرعة يقولان ذلك ويقولان كتبنا عنه، ورويا عنه، قال وسءل ابي عنه فقال كان صدوقا وكان من رءساء الشيعة.
   احمد بن معمر بن اشكيب () الصفار ابو عبد الله كوفي حضرمي وقع الي مصر يعد في الكوفيين روي عن محمد بن فضيل وابي بكر بن عياش وعبد الرحيم بن سليمان ومحمد بن عبيد.
 حدثنا عبد الرحمن قال سمعت ابي وابا زرعة يقولان ذلك قال وسءل ابي عنه فقال ثقة مامون صدوق. قال وسمعت ابا زرعة يقول ادركته ولم اكتب عنه. قال وسمعت ابي يقول كتبت عنه بمصر.
 قال وسءل ابو زرعة عنه فقال روي عنه سعيد بن اسد بن موسي وكان صاحب حديث. قال ابو محمد روي عن شريك وعبد الرحمن () ابن عبد الملك بن ابجر وعبد السلام بن حرب.
   احمد بن منيع ابو عبد الله بغدادي روي عن هشيم ومحمد بن يزيد
 
 الواسطي وابي تميلة وعبد القدوس بن؟ بكر بن خنيس ومحمد بن ميسر، يعد في البغداديين سمعت ابي ( ك) وابا زرعة يقولان ذلك ويقولان كتبنا عنه، ورويا عنه، قال وسءل ابي عنه فقال صدوق.
   احمد بن المقدام بن الاشعث ابو الاشعث العجلي بصري روي عن حزم بن ابي حزم وحماد بن زيد ومعتمر بن سليمان يعد في البصريين.
 حدثنا عبد الرحمن قال سمعت ابي وابا زرعة يقولان ذلك ويقولان كتبنا عنه [ورويا عنه  ] قال وسءل ابي عن احمد بن المقدام فقال صالح الحديث محله الصدق.
   احمد بن منصور بن ( م) راشد الحنظلي المروزي روي عن النضر بن شميل وعبد الملك بن ابراهيم الجدي، يعد في المراوزة.
 حدثنا عبد الرحمن قال سمعت ابي وابا زرعة يقولان ذلك ويقولان كتبنا عنه، وروي عنه موسي بن اسحاق. قال وسءل ابي عنه فقال صدوق.
   احمد بن منصور الرمادي [بغدادي  ] روي عن عبد الرزاق ويحيي بن بكير () وعثمان بن عمر يعد في البغداديين سمعت ابي وابا زرعة يقولان ذلك وكتبنا عنه مع ابي وكان ابي يوثقه.
   احمد بن المنذر بن الجارود القزاز روي عن حماد بن مسعدة روي عنه عبد الله بن احمد الدورقي، سالت ابي عنه فقال لا اعرفه، وعرضت عليه حديثه فقال حديث () صحيح.
   احمد بن مرحوم الرازي روي عن ضمرة ومءمل بن اسماعيل
 
 وابي جابر محمد () بن عبد الملك سمعت ابي وابا زرعة يقولان ذلك وكان ابي يوثقه وامرني بالكتابة عنه.
   احمد بن المهدي ابو جعفر الاصبهاني روي عن الحجاج بن [ابي  ] منيع وابي اليمان وابن ابي مريم وكاتب ( م) الليث والقعنبي، كتبنا عنه وكان صدوقا [قال ابو محمد هو الذي روي عن ابي عبيد كتاب غريب الحديث  ].
 باب النون   احمد بن نصر بن مالك الخزاعي ابو عبد الله [هو المصلوب  ] روي عن رباح بن زيد ومالك بن انس روي عنه يحيي بن معين واحمد بن ابراهيم الدورقي، يعد في البغداديين سمعت ابي وابا زرعة يقولان ذلك. قال ابو محمد روي عنه محمد بن عبد الله بن ابي الثلج.
   احمد بن نصر النيسابوري روي عن النضر بن شمبل ومءمل بن اسماعيل سمعت ابي وابا زرعة يقولان ذلك ويقولان ادركناه ولم نكتب عنه.
   احمد بن ابي نافع ابو سلمة الموصلي روي عن عفيف بن سالم ومحمد ابن محصن والمعافي بن عمران الموصلي روي عنه علي بن الحسين بن الجنيد.
 باب الواو   () [احمد بن الوليد بن برد الانطاكي روي عن ضمرة ورواد ابن الجراح وابن ابي فديك وعمرو بن ابي سلمة ومءمل بن اسماعيل سمع منه ابي بانطاكية.
 
   احمد بن وديع روي عن ابي معاوية الاسود والوليد بن مسلم والحر بن وسيم روي عنه احمد بن ابي الحواري والقاسم بن عثمان].
   احمد بن ابي العباس الجندعي () وهو احمد بن الوليد التمار كوفي روي عن جعفر بن عون ويزيد بن هارون روي عنه ابي، سءل ابي عنه فقال: صدوق.
 باب الهاء   ( م) احمد بن هاشم وهو ابن ابي العباس الرملي روي عن ضمرة وايوب بن سويد سمعت ابي وابا زرعة يقولان ذلك ويقولان كتبنا عنه، ورويا عنه، قال وسءل ابي عنه فقال صدوق يكتب حديثه ولا يحتج به.
 باب الباء   احمد بن يعقوب [ابو يعقوب  ] المسعودي الكوفي روي عن اسحاق بن سعيد بن العباس ويزيد بن المقدام وجعفر بن سليمان روي عنه منجاب بن الحارث ومحمد بن عبد الله بن نمير سمعت ابي وابا زرعة يقولان ذلك ويقولان ادركناه ولم نكتب عنه، قال ابو محمد وروي عنه ابو سعيد الاشج.
   احمد بن يعقوب بن محمد الزهري ابو ابراهيم روي عن ابي نباتة يونس بن يحيي واسماعيل بن قيس بن سعد بن زيد بن ثابت وعبد الله ابن عثمان () بن اسحاق بن سعد بن ابي وقاص روي عنه ابو زرعة. ()   احمد بن يونس الحمصي روي عن ابي زهير عبد الرحمن بن
 
 مغراء وخلف بن خليفة روي عنه محمد بن عوف الحمصي.
   احمد بن يونس [بن  ] المسيب الضبي البغدادي ابو العباس نزيل اصبهان روي عن ابي الجواب ومحمد بن عبيد الطنافسي وحجاج ابن محمد ويعقوب بن ابراهيم بن سعد ومكي بن ابراهيم والاسود بن عامر ويونس بن محمد سمعنا منه وكان محله عندنا محل الصدق.
   احمد بن يوسف المعروف بحمدان بن يوسف السلمي النيسابوري روي عن النضر بن محمد الحرشي وعمر بن عبد الله بن رزين السلمي كتب الي ابي وابي زرعة بيدي الفضل بن العباس المعروف بالصاءغ.
   احمد بن يوسف () الترمذي قاضي الري روي عن خالد بن زياد الترمذي وفضيل بن عياض ومروان الفزاري وابي معاوية وسعيد ابن خثيم وعباد بن العوام سمع منه ابي وروي عنه ومحمد بن ايوب ابن [يحيي بن  ] الضريس.
   احمد بن يحيي بن المنذر المديني روي عن مالك بن انس حديثا منكرا روي عنه موسي بن اسحاق الانصاري ويحيي بن محمد بن يحيي النيسابوري.
   احمد بن يحيي بن حميد الطويل روي عن حماد بن سلمة يعد في البصريين سمعت ابي وابا زرعة يقولان ذلك ويقولان ادركناه ولم نكتب عنه.
   احمد بن يحيي بن الحواري () البغدادي نزيل سامرا روي عن محمد بن الحسين البرجلاني سمعت منه مع ابي وهو صدوق.
   احمد بن يحيي الصوفي ( ك) روي عن محمد بن بشر ومحمد بن عبيد وزيد بن الحباب واسحاق بن منصور السلولي سمعت
 
 ابي يقول كتبت عنه. قال ابو محمد كتبنا [مع ابي  ] عنه بالكوفة قال وسءل ابي عنه فقال ( م) ثقة روي عن عثمان بن سعيد الزيات روي عنه ابو عوانة الكوفي.
   احمد بن يحيي بن مالك السوسي روي عن عبد الوهاب بن عطاء وعلي بن حفص المداءني واحمد بن اسحاق الحضرمي وابي بدر شجاع ابن الوليد وشبابة سمعت ابي يقول كتبنا عنه. قال ابو محمد وكتبنا [عنه  ] معه بسامرا. قال وسءل ابي عنه فقال صدوق.
   احمد بن يزيد بن ابراهيم ابو () الحسن الورتنيسي روي عن زهير بن معاوية وفليح بن سليمان يعد في الحرانيين سمعت ابي وابا زرعة يقولان ذلك وسمعت ابي يقول هو ضعيف الحديث ادركته.
   احمد بن يزيد بن روح الداري روي عن محمد بن عقبة روي عنه ابو عمير الرملي يعد في الفسلطينيين سمعت ابي وابا زرعة يقولان ذلك، سمعت ابي يقول سكن بيت المقدس وهو من رهط تميم الداري.
  احمد بن يزيد بن الحلواني المقري () روي عن ابي نعيم وكاتب الليث وابي الربيع الزهراني وسعيد بن منصور وابي حذيفة ( م) موسي بن مسعود وصفوان بن صالح الدمشقي روي عنه الفضل ابن شاذان. سالت ابا زرعة عنه فلم يرضه.
   احمد ابن اخت عبد الرزاق روي عن خاله عبد الرزاق روي عنه سويد بن سعيد الانباري [قال ابو محمد هو احمد بن داود روي عنه ابراهيم ابن الصنعاني وعبيد بن محمد  ].
 
 حدثنا عبد الرحمن سمعت علي بن الحسين يقول قال احمد بن حنبل احمد ابن اخت عبد الرزاق كذاب دلني علي شيخ فقال توفي منذ حين فوجدته حيا.
 حدثنا عبد الرحمن قال قرء علي العباس بن محمد [الدوري  ] عن يحيي بن معين انه قال احمد ابن اخت عبد الرزاق كذاب لم يكن ثقة ولا مامون.
 باب من يسمي ابراهيم باب الالف   () ابراهيم بن اسماعيل روي عن ابي هريرة روي عنه الحجاج ابن عبيد سمعت ابي يقول ذلك: سالت ابي عنه فقال: مجهول.
   ابراهيم بن اسماعيل بن ابي حبيبة () الاشهلي الانصاري مولي بني الاشهل روي عن داود بن الحصين وعبد الله بن ابي سفيان روي عنه ابن ابي فديك وابو عامر العقدي وسعيد بن ابي مريم والقعنبي يعد في المدينيين سمعت ابي وابا زرعة يقولان ذلك. قال ابو محمد روي عن عمر ابن سريج عن الزهري روي عنه اسماعيل بن ابي اويس.
 حدثنا عبد الرحمن نا محمد بن حمويه بن الحسن قال سمعت ابا طالب احمد بن حميد قال سالت احمد بن حنبل عن ابراهيم بن اسماعيل بن ابي حبيبة فقال من اهل المدينة. ثقة سالت ابي عن ابراهيم بن ابي حبيبة فقال شيخ ليس بقوي يكتب حديثه ولا يحتج به، منكر الحديث دون ابراهيم بن اسماعيل بن مجمع، واحب الي من ابراهيم بن الفضل.
 
 حدثنا عبد الرحمن اخبرنا يعقوب بن اسحاق الهروي فيما كتب الي نا عثمان بن سعيد الدارمي قال سالت يحيي بن معين قلت: ابراهيم ابن اسماعيل بن ابي حبيبة؟ فقال: صالح.
   ابراهيم بن اسماعيل بن زيد بن مجمع بن جارية الانصاري المديني روي عن الزهري وعمرو بن دينار روي عنه حاتم بن اسماعيل والدراوردي ووكيع وابو نعيم سمعت ابي يقول ذلك.
 حدثنا عبد الرحمن قال قرء علي العباس [بن محمد  ] الدوري عن يحيي بن معين انه قال ابراهيم بن اسماعيل بن مجمع ضعيف سمعت ابي يقول: ابراهيم بن اسماعيل بن مجمع يكتب حديثه ولا يحتج به وهو قريب من ابن ابي حبيبة [كثير الوهم ليس بالقوي  ] قال ابو زرعة سمعت ابا نعيم يقول: ابراهيم بن اسماعيل بن مجمع لا يسوي حديثه ( م)  وسكت ثم قال بعد ذلك  لا يسوي حديثه فلسين، قال ابو محمد روي عن سالم ابن عبد الله بن عمر وعمه يعقوب بن مجمع ومحمد بن كعب القرظي وابي الزناد ووهب بن كيسان. ()   ابراهيم بن اسماعيل بن يحيي بن سلمة بن كهيل روي عن ابيه عن عمه محمد بن سلمة عن سلمة بن كهيل كتب ابي حديثه () ولم ياته ولم يذهب بي اليه ولم يسمع منه زهادة فيه، وسالت ابا زرعة عنه فقال يذكر عنه انه كان يحدث باحاديث عن ابيه ثم ترك اباه فجعله عن عمه لان عمه احلي عند الناس، واحاديث قد جعلها عن عمه عن سلمة عن الاعمش، وسلمة عن ابي اسحاق.
 
   ابراهيم بن اسماعيل بن البصير وهو ابن اسماعيل بن بشير بن سلمان روي عن تميم بن الجعد عن اسماعيل بن ابي خالد وروي عن جعفر بن عون روي عنه ابو شيبة ابراهيم بن عبد الله بن ابي شيبة وابن عمرو العنقزي، سمعت ابا زرعة يقول ابراهيم بن اسماعيل بن البصير ذهبت اليه فلم يقض لي ان اسمع منه ثم سمعت من ابي شيبة ابراهيم بن عبد الله ابن ابي شيبة عنه، و [ان  ] كان احد صدق () في حديث جعفر بن عون عن المعلي بن عرفان عن ابي واءل عن ابن مسعود قال رايت النبي صلي الله عليه وسلم كحل عين علي ببزاقه فهو، واما الباقون فلا اراهم الا سرقوه.
   ابراهيم بن اسماعيل بن عبد الله ( ك) بن ابي ربيعة المخزومي روي عن ابيه عن جده ان النبي صلي الله عليه وسلم استسلف منه حين غزا حنينا ثلاثين او اربعين الفا فلما انصرف قضاه [ودعا له  ] وقال انما جزاء السلف الوفاء والحمد. روي عنه وكيع بن الجراح.
   () [ابراهيم بن اسماعيل بن نصر التبان روي عن ابراهيم بن اسماعيل بن ابي حبيبة روي عنه عبد الرحمن بن عبد الملك بن شيبة الحزامي].
   () [ابراهيم بن ابراهيم المروزي روي عن معاوية بن عمار الدهني روي عنه ابو بدر عباد بن الوليد الغبري].
   ابراهيم بن اسحاق الصيني () الكوفي روي عن قيس بن الربيع روي عنه موسي بن اسحاق الانصاري [وروي عن مالك بن انس روي
 
 عنه محمد بن عثمان بن ابي شيبة والمطين  ].
   ابراهيم بن اسحاق البناني [روي عن خال.... ] روي عنه ().
