 وكان ابو المطرف بن عميرة المذكور كما قال فيه بعض علماء المغرب : قدوة البلغاء ، وعمدة العلماء ، وصدر الجلة الفضلاء ، وهو احمد بن عبد الله بن عميرة المخزومي ؛ ونكتة البلاغة التي قد احرزها واودعها ، وشمسها التي اخفت ثواقب كواكبها حين ابدعها ، مبدع البداءع التي لم يحظ بها قبله انسان ، ولا ينطق عن تلاوتها لسان ؛ اذ كان ينطق عن قريحة صحيحة ، وروية بدرر العلم فصيحة ، ذللت له صعب الكلام ، وصدقت رءياه حين وضع سيد المرسلين ، صلي الله عليه وسلم ، وهو الذي اوتي جوامع الكلم في يديه الاقلام ، واصل سلفه من جزيرة شقر ، وولد بمدينة بلنسية ، وروي عن ابي الخطاب بن واجب وابي الربيع بن سالم وابن نوح والشلوبيني النحوي وابن عات وابن حوط الله ، وغيرهم من الحفاظ ، واجازه من اهل المشرق جماعة ، وكان شديد العناية بشان الرواية فاكثر من سماع الحديث ، واخذه عن مشايخ اهله ، ثم تفنن في العلوم ، ونظر في المعقولات واصول الفقه ، ومال الي الادب ، فبرع براعة عد فيها من مجيدي النظم ، فاما الكتابة فهو فارسها الذي لا يجاري ، وصاحب عينها الذي لا يباري ، وله وعظ علي طريقة ابن الجوزي ، ورساءل خاطب بها الملوك وغيرهم من الموحدين والحفصيين ، وله تاليف في كاءنة ميورقة وتغلب الروم عليها ، نحا في الخبر عنها منحي الامام الاصبهاني في «الفتح القدسي» وله كتاب تعقب فيه علي الفخر الرازي في كتاب «المعالم» وله كتاب رد به علي كمال الدين الانصاري في كتابه المسمي «بالتبيان» ، في علم البيان ، المطلع علي «اعجاز القران» وسماه «بالتنبيهات ، علي ما في البيان من التمويهات» ، وله اختصار نبيل من تاريخ ابن صاحب الصلاة ، وغير ذلك.
