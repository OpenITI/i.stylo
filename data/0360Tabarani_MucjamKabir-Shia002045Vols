 بصره الا حالا الله له عبادة يجد حلاوتها حدثنا يحيي بن ايوب ثنا سعي بن ابي مريم انا يحيي بن ايوب عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة قال جاء رجل من الانصار الي رسول الله صلي الله عليه وسلم وعنده ابو بكر وعمر رضي الله عنهما فقال زرع فلان زرعا فاضعف او كما قال فقال رسول الله صلي الله عليه وسلم وما ذاك ركعتان خفيفتان خير لك من ذلك كله من الدنيا وما عليها ولو انكم تفعلون ما امرتم به لاكلتم غيراء زرعا ولا اشقياء حدثنا يحيي بن ايوب ثنا سعيد بن ابي مريم انا يحيي بن ايوب عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة قال بينما رسول الله صلي الله عليه وسلم يوما جالس وعنده امراة اذ قال لها رسول الله صلي الله عليه وسلم اني لاحسبكن تخبرن بما يفعل بكن ازواجكن قالت اي والله معبد وامي يا رسول الله انا لنفتخر بذلك فقال رسول الله صلي الله عليه وسلم فلا تفعلن فان الله يمقت من يفعل ذلك قال لها اني لاحسب احداكن اذا اتاها زوجها ليكشفان عنهما اللحاف ينظر احدهما الي عورة صاحبه كانهما حماران قالت اي والله معبد وامي انا لنفعل ذلك قال فلا تفعلوا ذلك فان الله يمقت علي ذلك حدثنا يحيي بن ايوب ثنا سعيد بن ابي مريم انا يحيي بن ايوب عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة ان رسول الله صلي الله عليه وسلم قال يطهر المءمن ثلاثة احجار والماء طهور حدثنا يحيي بن ايوب ثنا سعيد بن ابي مريم انا يحيي بن ايوب عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة رضي الله عنه قال قال رسول الله صلي الله عليه وسلم السواك مطيبة للفم مرضاة للرب 
 عز وجل حدثنا يحيي بن ايوب ثنا سعيد بن ابي مريم انا يحيي بن ايوب عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة عن رسول الله صلي الله عليه وسلم قال ما جاءني جبريل قط الا امرني بالسواك حتي لقد خشيت ان احفي مقدم فمي حدثنا يحيي بن ايوب ثنا سعيد بن ابي مريم انا يحيي بن ايوب عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة قال دخل رسول الله صلي الله عليه وسلم علي صفية بنت عبد المطلب فعرقت له او فقربت له عرقا فوضعته بين يديه ثم عرقت او قربت اخر فوضعته بين يديه فاكل ثم اتي المءذن فقال الوضوء الوضوء فقال انما علينا الوضوء فيما يخرج وليس علينا فيما يدخل حدثنا يحيي بن ايوب ثنا سعيد بن ابي مريم ثنا يحيي بن ايوب عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم لا يعجزن احدكم اذا دخل مرفقه ان يقول اللهم اني اعوذ بك من الرجس النجس الخبيث المخبث الشيطان الرجيم حدثنا يحيي بن ايوب ثنا سعيد بن ابي مريم ثنا يحيي بن ايوب عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة قال كان الناس اذا دخل الرجل المسجد فوجدهم يصلون سال الذي الي جنبه فيخبره بما فاته ليقضي ثم يقوم فيصلي معهم حتي اتي معاذ يوما فاشاروا اليه انك قد فاتك كذا وكذا فابي ان يصلي فصلي ثم 
 صلي بعد ما فاته فذكر ذلك لرسول الله صلي الله عليه وسلم فقال احسن معاذ التجارة فافعلوا كما فعل حدثنا احمد بن رشدين المصري ثنا سعيد بن ابي مريم انا يحيي بن ايوب عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة قال كانت جارية لابي مسعود عقبة بن عمرو ترعي غنما فعطبت شاة منها فكسرت حجرا من المروة فذبحتها فاتت بها الي عقبة بن عمرو فاخبرته فقال لها اذهبي بها الي رسول الله صلي الله عليه وسلم كما انت فقال لها رسول الله صلي الله عليه وسلم هل افريت الاوداج قالت نعم قال كل ما فري الاوداج ما لم يكن قرض سن او حز ظفر حدثنا احمد بن رشدين ثنا سعيد بن ابي مريم انا يحيي بن ايوب عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة رضي الله عنه قال قال رسول الله صلي الله عليه وسلم بعثت رحمة وهدي للعالمين لمحق الاوثان والمعازف والمزامير وامر الجاهلية ثم قال من شرب الخمر في الدنيا سقاه الله من حميم جهنم معذبا او مغفورا له حدثنا احمد بن رشدين ثنا سعيد بن ابي مريم ثنا يحيي بن ايوب عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة ان رسول الله صلي الله عليه وسلم قال من يشفع لاخيه شفاعة فاهدي له عليها هدية فقبلها فقد اتي بابا عظيما من ابواب الربا حدثنا احمد بن رشدين ثنا سعيد بن ابي مريم انا يحيي بن ايوب عن عبيد الله زحر عن علي بن يزيد عن القاسم عن ابي امامة ان 
 رسول الله قال عاءد المريض يخوض في الرحمة ووضع رسول الله صلي الله عليه وسلم يديه علي ركبتيه ثم قال فاذا جلس عنده غمرته الرحمة ومن تمام عيادة المريض ان يضع احدكم يده علي وجهه او علي يده فيساله كيف هو وتمام محبتكم بينكم المصافحة حدثنا احمد بن رشدين ثنا سعيد بن ابي مريم انا يحيي بن ايوب عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة ان رسول الله صلي الله عليه وسلم قال لا يحل شري المغنيات ولا بيعهن ولا تجارة فيهن وثمنهن حرام وتلا هذه الاية ومن الناس من عمي لهو الحديث ليضل عن سبيل الله بغير علم الاية حدثنا احمد بن رشدين ثنا سعيد بن ابي مريم انا يحيي بن ايوب عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم اربعة يءتون اجورهم مرتين ازواج رسول الله صلي الله عليه وسلم ومن اسلم من اهل الكتاب ورجل كانت عنده امة فاعجبته فاعتقها ثم تزوجها وعبد مملوك ادي حق الله وحق سادته حدثنا محمد بن العباس المءدب ثنا سريج بن النعمان الجوهري ثنا عبد الله بن المبارك عن يحيي بن ايوب عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة ان رجلا اخذ يصلي وحده فقال رسول الله صلي الله عليه وسلم الا رجل يتصدق علي هذا فقام رجل فصلي معه فقال رسول الله صلي الله عليه وسلم هذان جماعة 
 * (بكر بن مضر عن عبيد الله بن زحر عن علي بن يزيد) * حدثنا محمد بن عمرو بن خالد الحراني ثنا ابي ثنا بكر بن مضر عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة رفع الحديث قال من بدا بالسلام فهو اولي بالله ورسوله حدثنا محمد بن عمرو بن خالد الحراني ثنا ابي ثنا بكر بن مضر عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم لتسوين الصفوف او ليطمسن وجوه ولتطمسن ابصاركم او لتخطفن ابصاركم * (ليث بن ابي سليم عن عبيد الله بن زحر) * حدثنا العباس بن الفضل الاسفاطي ثنا بن عاءشة ثنا عبد العزيز بن مسلم عن ليث عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة عن رسول الله صلي الله عليه وسلم قال ان من اغبط اولياءي عندي مءمن خفيف الحاذ ذو حظ من صلاة وصيام واحسن عبادة ربه واطاعه في السر وكان غامضا في الناس لا يشار اليه بالاصابع وكانت معيشته كفافا وصبر علي ذلك فعجلت منيته وقل بواكيه وقل تراثه حدثنا محمد بن عمرو بن خالد الحراني ثنا ابي ثنا موسي ابن اعين عن ليث عن عبيد الله ابن زحر عن علي بن يزيد عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال ان الله حرم تعليم المغنيات واشتراءهن وبيعهن واكل اثمانهن 
 * (خلاد الصفار عن عبد الله بن زحر) * حدثنا عبيد بن غنام ثنا ابو بكر بن ابي شيبة ثنا وكيع عن خلاد الصفار عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم لا يحل بيع المغنيات ولا شراءهن ولا تجارة فيهن واكل اثمانهن حرام وفيه انزل الله عز وجل هذه الاية ومن الناس من عمي لهو الحديث * (محمد بن عبيد الله العرزمي عن عبيد الله) * حدثنا محمد بن عمرو بن خالد الحراني ثنا ابي ثنا محمد بن سلمة عن ها عن عبيد الله بن زحر عن علي بن يزيد عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم ان لهذا الدين اقبالا وادبارا وذكر الحديث حدثنا خير بن عرفة المصري ثنا عروة بن مروان الرقي ثنا محمد بن مسلمة عن محمد بن عبيد الله العرزمي عن عبيد الله زحر عن علي ابن يزيد عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم اريت البارحة كاني ادخلت الجنة فخرجت من احدي ابوابها الثمانية فاذا انا بامتي قيام فعرضوا علي رجلا رجلا واذا بميزان منصوب فوضعت امتي في كفة الميزان ووضعت في الكفة الاخري فرجحت بهم ثم وضعت امتي كلهم جميعا في كفة الميزان ووضع ابو بكر الصديق رضي الله عنه في الكفة الاخري فرجح بهم ثم وضع جميع امتي في كفة الميزان ووضع بن الخطاب في كفة الميزان فرجح بهم ثم رفع الميزان 
 * (معان بن رفاعة السلامي عن علي بن يزيد) * حدثنا احمد بن عبد الوهاب بن نجدة الحوطي ثنا ابو المغيرة عبد القدوس بن الحجاج ثنا معاذ بن رفاعة ثنا علي بن يزيد عن القاسم عن ابي امامة الباهلي ان رسول الله صلي الله عليه وسلم بينما هو يمشي في شدة حر انقطع شسعه فجاء رجل بشسع فوضعه في نعله فقال رسول الله صلي الله عليه وسلم لو تعلم ما حملت عليه رسول الله صلي الله عليه وسلم لو تعلم ما حملت عليه رسول الله صلي الله عليه وسلم حدثنا احمد بن عبد الوهاب بن نجدة الحوطي ثنا ابو المغيرة عبد القدوس بن الحجاج ثنا معاذ بن رفاعة ثنا علي بن يزيد عن القاسم عن ابي امامة الباهلي قال مر رسول الله صلي الله عليه وسلم برجل وهو يقرا قل هو الله احد فقال اوجب هذا وجبت له الجنة حدثنا احمد بن عبد الوهاب ثنا ابو المغيرة ثنا معان بن رفاعة ثنا علي بن يزيد حدثني القاسم عن ابي امامة قال لما كان حجة الوداع قام النبي صلي الله عليه وسلم وهو يومءذ مردف الفضل بن عباس وهو علي جمل فقال يا ايها الناس خذوا من العلم قبل ان يقبض العلم وقبل ان يرفع العلم وقد كان انزل الله عز وجل يا ايها الذين امنوا لا تسالوا عن اشياء ان تبد لكم تسوءكم الاية فكنا نذكرها كثيرا فتمنعنا من مسالته فاتينا اعرابيا فرشوناه بردا مستسرا به حتي رايت حاشية البرد علي حاجبه الايمن ثم قلنا سل النبي صلي الله عليه وسلم فقال يا نبي الله كيف يرفع العلم منا وبين اظهرنا المصاحف قد تعلمنا فيها بالقرامطة نساءنا وذرارينا وخدمنا 
 فرفع النبي صلي الله عليه وسلم راسه وقد علت وجهه حمرة من الغضب فقال اي ثكلتك امك وهذه اليهود والنصاري بين اظهرهم المصاحف لم يصبحوا يتعلقوا بالحرف مما جاءتهم به انبياءهم الا وان من ذهاب العلم ان يذهب اهله ثلاث مرات حدثنا احمد بن عبد الوهاب ثنا ابو المغيرة ثنا معان بن رفاعة اخبرني علي بن يزيد عن القاسم عن ابي امامة قال خرجنا مع النبي صلي الله عليه وسلم في سرية من سراياه فمر رجل بغار فيه شء من ماء فجذبته نفسه ان يقيم في ذلك الغار فيقوت ما فيه من ماء ويصيب مما حوله من البقل ويتخلي من الدنيا ثم قال لو اني اتيت نبي الله صلي الله عليه وسلم فذكرت ذلك له فان اذن لي فعلت والا لم افعل فاتاه فقال يا نبي الله اني مررت بغار فيه ما يقوتني من الماء والبقل فحدثني نفسي بان اقيم واتخلي من الدنيا فقال النبي صلي الله عليه وسلم اني لم ابعث باليهودية ولا النصرانية ولكني بعثت بالحنيفية السمحة والذي نفسي بيده لغداة او روحة في سبيل الله خير من الدنيا وما فيها ولمقام احدكم في الصف خير من صلاته ستين سنة حدثنا احمد بن عبد الوهاب بن نجدة الحوطي ثنا ابو المغيرة ثنا معان بن رفاعة ثنا علي بن يزيد قال سمعت القاسم يحدث عن ابي امامة قال مر النبي صلي الله عليه وسلم في يوم شديد الحر نحو بقيع الغرقد فكان الناس يمشون خلفه فلما سمع صوت النعال وقر ذلك نفسه فحبس حتي قدمهم امامة لءلا يقع في قلبه شء من الكبر فلما مر ببقيع الغرقد اذا بقبرين قد دفنوا فيهما رجلين فوقف النبي صلي الله عليه وسلم فقال من دفنتم ههنا اليوم قالوا يا نبي الله فلان قال انهما ليعذبان الان ويفتنان في قبريهما قالوا يا رسول الله وما ذاك قال اما احدهما فكان يمشي بالنميمة واما احدهما فكان لا يتنزه من البول واخذ جريدة رطبة فشقها 
 ثم جعلها علي القبرين قالوا يا نبي الله ولم فعلت قال ليخفف عنهما قالوا يا نبي الله وحتي متي يعذبان قال غيب لا يعلمه الا الله قال ولولا تمريجا في قلوبكم او تزويدكم في الحديث سمعتم ما اسمع حدثنا احمد بن عبد الوهاب بن نجدة الحوطي ثنا ابو المغيرة ثنا معان بن رفاعة ثنا علي بن يزيد عن القاسم عن ابي امامة قال جلسنا الي رسول الله صلي الله عليه وسلم فذكرنا ورفقنا فبكي سعد بن ابي وقاص فاكثر البكاء وقال يا ليتني مت فقال النبي صلي الله عليه وسلم يا سعد اعندي تمن الموت فردد ذلك ثلاث مرات ثم قال يا سعد ان تك خلقت للجنة فما طال عمرك وحسن عملك فهو خير لك وان تكن خلقت للنار فبءست التي الشء تتعجل اليه حدثنا احمد بن عبد الوهاب ثنا ابو المغيرة ثنا معان بن رفاعة ثنا علي بن يزيد عن القاسم عن ابي امامة قال كان رسول الله صلي الله عليه وسلم جالسا وكانوا يظنون الوحي ينزل عليه فاقصروا عنه حتي جاء ابو ذر فافتحم فاتاه فجلس اليه فاقبل عليه فقال يا ابا ذر هل صليت اليوم قال لا قال قم فصل فلما صلي اربع ركعات الضحي اقبل عليه فقال يا ابا ذر هل تعوذت من شر شياطين الجن والانس قال يا نبي الله وهل للانس شياطين قال نعم شياطين الانس والجن يوحي بعضهم الي بعض زخرف القول غرورا ثم قال يا ابا ذر الا اعلمك كلمة من كنز الجنة قلت بلي جعلني الله فداك قال قل لا حول ولا قوة الا بالله ثم سكت عني حتي استبطات كلامه قال قلت يا نبي الله انا كنا اهل جاهلية وعبادة اوثان فبعثك الله رحمة للعالمين ارايت الصلاة 
 ماذا هي قال خير موضوع فمن شاء استقل ومن شاء استكثر قال قلت يا نبي الله ارايت الصيام ماذا هو قال اضعاف مضعفة وعند الله المزيد قلت يا نبي الله اي الصدقة افضل قال سر الي فقير وجهد من مقل قلت يا نبي الله اي الشهداء افضل قال من سفك دمه وعقر جواده قلت يا نبي الله ايما اية انزلت يا نبي الله عليك اعظم قال الله لا اله الا هو الحي القيوم اية الكرسي قلت يا نبي الله اي الرقاب افضل قال اغلاها ثمنا وانفسها عند اهلها قلت يا نبي الله فاي الانبياء كان اول قال ادم قلت يا نبي الله او نبي كان ادم قال نعم نبي مكلم خلقه الله بيده ونفخ فيه من روحه ثم قال له يا ادم قبلا قلت يا نبي الله كم وفاء عدة الانبياء قال ماءة الف واربعة قرة الفا الرسل من ذلك ثلاث ماءة وخمسة عشر جما غفيرا حدثنا جعفر بن محمد الفريابي ثنا سليمان بن عبد الرحمن الدمشقي ثنا الوليد بن مسلم حدثني معان بن رفاعة عن علي بن يزيد عن القاسم عن ابي امامة عن رسول الله صلي الله عليه وسلم قال من صام يوما في سبيل الله بعد الله بينه وبين جهنم مسيرة ماءة عام حدثنا ابو يزيد القراطيسي ثنا اسد بن موسي ثنا الوليد بن مسلم ثنا معان بن رفاعة عن علي بن يزيد عن القاسم عن ابي امامة ان ثعلبة بن حاطب الانصاري اتي رسول الله صلي الله عليه وسلم فقال يا رسول الله ادع الله ان يرزقني الله قال ويحك يا ثعلبة قليل تءدي شكره خير من كثير لا تطيقه ثم رجع اليه فقال يا رسول الله ادع الله ان يرزقني مالا قال ويحك يا ثعلبة اما تريد ان تكون مثل رسول الله صلي الله عليه وسلم والله لو سالت ان 
 يسيل لي الجبال ذهبا وفضة لسالت ثم رجع اليه فقال يا رسول الله ادع الله ان يرزقني مالا والله اداء اتاني الله مالا لاوتين كل ذي حق حقه فقال رسول الله صلي الله صلي الله عليه وسلم اللهم ارزق ثعلبة مالا فاتخذ غنما فنمت كما ينمو الدود حتي ضاقت عنها ازقة المدينة فتنحي بها وكان يشهد الصلاة مع رسول الله صلي الله عليه وسلم ثم يخرج اليها ثم نمت حتي تعذرت عليه مراعي المدينة فتنحي بها فكان يشهد الجمعة مع رسول الله صلي الله عليه وسلم ثم يخرج اليها ثم نمت فتنحي بها فترك الجمعة والجماعات اطرافهن الركبان ويقول ماذا عندكم من الخبر وما كان من امر الناس فانزل الله عز وجل علي رسوله صلي الله عليه وسلم خذ من اموالهم صدقة تطهرهم وتزكيهم بها قال فاستعمل رسول الله صلي الله عليه وسلم علي الصدقات رجلين رجل من الانصار ورجل من بني سليم وكتب لهما سنة الصدقة واسنانها وامرهما ان يصدقا الناس وان يمرا بثعلبة فياخذا منه صدقة ماله ففعلا حتي ذهبا الي ثعلبة فاقراه كتاب رسول الله صلي الله عليه وسلم فقال صدقا الناس فاذا فرغتما فمرا بي ففعلا فقال والله ما هذه الا اخية الجزية فانطلقا حتي لحقا رسول الله صلي الله عليه وسلم وانزل الله عز وجل علي رسوله صلي الله عليه وسلم ومنهم من عاهد الله اداء اتانا من فضله الي قوله يكذبون قال فركب رجل من الانصار قريب لثعلبة راحلة حتي اتي ثعلبة فقال ويحك يا ثعلبة هلكت انزل الله عز وجل فيك من القران كذا فاقبل ثعلبة ووضع التراب علي راسه وهو يبكي ويقول يا رسول الله يا رسول الله فلم يقبل منه رسول الله صلي الله عليه وسلم صدقته حتي قبض الله رسول الله صلي الله عليه وسلم ثم اتي ابا بكر رضي الله عنه بعد رسول الله صلي الله عليه وسلم فقال يا ابا بكر قد عرفت موقعي من قومي ومكاني من رسول الله صلي الله عليه وسلم فاقبل مني فابي ان يقبله ثم اتي عمر رضي الله عنه فابي ان يقبل منه ثم اتي عثمان رضي الله عنه فابي ان يقبل منه ثم مات ثعلبة في خلافة عثمان رضي الله عنه 
 * (عثمان بن ابي العاتكة عن علي بن يزيد) * حدثنا ابو مسلم الكشي ثنا سليمان بن احمد الواسطي ح وحدثنا جعفر بن محمد الفريابي ثنا هشام بن عمار قالا ثنا الوليد بن مسلم ثنا عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة ان رسول الله صلي الله عليه وسلم قال الا ان النار خلقت للسفهاء وهي للنساء الا التي اطاعت قيمها حدثنا محمد بن عبدوس بن جرير الصوري ثنا سليمان ابن عبد الرحمن الدمشقي ثنا الوليد بن مسلم ثنا عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة ان رسول الله صلي الله عليه وسلم قال يا ايها الناس عليكم بالعلم قبل ان يقبض العالم والمتعلم شريكان في الاجر ولا خير في ساءر الناس حدثنا ابو عقيل انس بن سلم الخولاني ثنا صفوان بن صالح حدثني الوليد بن مسلم عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم تسوكوا فان السواك مطيبة للفم مرضاة للرب ما جاءني جبريل الا امرني بالسواك حتي لقد حسبت ان يفرضه علي وعلي امتي ولولا ان اشق علي امتي فرضته عليهم اني لاستاك حتي لقد خشيت ان احفي مقادم فمي حدثنا جعفر بن محمد الفريابي ثنا هشام بن عمار ثنا 
 صدقة بن خالد حدثني عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم من فاته الليل ان يكابده وبخل بماله ان ينفقه وجبن عن العدو ان يقاتله فليكثر من سبحان الله وبحمده فانهما احب الي الله من جبل ذهب وفضة انفقه في سبيل الله حدثنا احمد بن المعلي الدمشقي ثنا هشام بن عمار ثنا الوليد بن مسلم عن عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة قال كان لمعاذ بن جبل قدح مفضض بنحاس فيه يسقي النبي صلي الله عليه وسلم اذا شرب وفيه يوضءه اذا توضا حدثنا جعفر بن محمد الفريابي ثنا هشام بن عمار ثنا صدقة بن خالد ثنا عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم انه كان يقسم بالله ثلاثا لا يستثني ما علي ظهر الارض مسلم يقول حين يصبح اللهم لك الحمد لا اله الا انت ربي وانا عبدك امنت بك مخلصا لك ديني اصبحت علي عهدك ووعدك ما استطعت اتوب اليك من سوء عملي واستغفرك لذنوبي لا يغفرها الا انت فيموت من يومه ذلك الا دخل الجنة حدثنا جعفر بن محمد الفريابي ثنا هشام بن عمار ثنا صدقة بن خالد ثنا عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال من اهان لي وليا فقد بارزني بالعداوة ابن 
 ادم لن تدرك ما عندي الا باداء ما افترضت عليك ولا يزال عبدي يتحبب الي بالنوافل حتي احبه فاكون قلبه الذي يعقل به ولسانه الذي ينطق به وبصره الذي يبصر به فاذا دعاني اجبته واذا سالني اعطيته واذا استنصرني نصرته واحب عبادة عبدي الي النصيحة حدثنا جعفر بن محمد الفريابي ثنا هشام بن عمار ثنا صدقة بن خالد ثنا عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم انه كان يقول ما استفاد المسلم فاءدة بعد تقوي الله تعالي خيرا له من زوجة صالحة ان امرها اطاعته وان نطر اليها سرته وان اقسم عليها ابرته وان غاب عنها نصحته في نفسها حدثنا ابراهيم بن دحيم ثنا ابي ثنا الوليد بن مسلم ثنا عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة ان رسول الله صلي الله عليه وسلم بعث عمرو بن الطفيل الي خيبر ليستمد له قومه وقال يا عمرو انطلق فاستمد لنا قومك فقال عمرو يا رسول الله ارسلتني وقد نشب القتال فقال رسول الله صلي الله عليه وسلم اما ترضي ان تكون رسول رسول الله صلي الله عليه وسلم حدثنا الحسين بن اسحاق التستري ثنا هشام بن عمار ثنا صدقة بن خالد ثنا عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة قال خرج رسول الله صلي الله عليه وسلم فمر ببيت عثمان بن مظعون فقام علي باب البيت فقال مالك يا كحيلة مبتذلة اليس عثمان شاهدا 
 قالت بلي وما اضطجع علي فراشي منذ كذا وكذا ويصوم الدهر فما يفطر فقال مريه ان ياتيني فلما جاء قالت له فانطلق اليه فوجده في المسجد فجلس اليه فاعرض عنه فبكي ثم قال لقد علمت انه بلغك عني امر قال انت الذي تصوم الدهر وتقوم الليل لا تضع جنبك علي فراش قال عثمان قد فعلت ذلك التمس الخير فقال النبي صلي الله عليه وسلم لعينك حظ ولجسدك حظ ولزوجك حظ فصم وافطر ونم وقم واءت زوجك فاني انا اصوم وافطر وانام واقوم واتي النساء فمن اخذ بسنتي فقد اهتدي ومن تركها ضل فان لكل عمل شرة ولكل شرة فترة فاذا كانت الفترة الي الغفلة فهي الهلكة واذا كانت الغفلة الي الفريضة لا يضر المءلف شيءا فخذ من العمل بما تطيق واني انما بعثت بالحنيفية السمحة فلا تثقل عليك عبادة ربك لا تدري ما المريض عمرك حدثنا الحسين بن اسحاق التستري ثنا هشام بن عمار ثنا محمد بن شعيب بن شابور ثنا عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة قال خرج النبي صلي الله عليه وسلم ذات يوم ومعه ابو بكر وعمر وزيد بن ثابت وعبد الله بن مسعود وابي بن كعب وعبد الله بن عباس والنبي صلي الله عليه وسلم علي راحلته الجدعاء فلما برزوا سمع النبي صلي الله عليه وسلم رجلا يقول الله اكبر الله اكبر فوقف يستمع فلما قال الله اكبر الله اكبر قال رسول الله صلي الله عليه وسلم شهد هذا والذي نفسي بيده بشهادة الحق فلما قال اشهد ان لا اله الا الله قال برء هذا والذي نفسي بيده من النار ثلاث مرات ثم قال رسول الله صلي الله عليه وسلم هذا صاحب كلاب فذهب بن مسعود وابن عباس فوجدوه كذلك حدثنا احمد بن المعلي الدمشقي ثنا هشام بن عمار ثنا 
 صدقة بن خالد عن عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال ذروة سنام الاسلام الجهاد في سبيل الله لا يناله الا افضلهم حدثنا الحسين بن اسحاق التستري ثنا الحسين بن ابي السري العسقلاني ثنا محمد بن شعيب حدثني ابو حفص القاص ثنا عثمان ابن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة قال اقبل ابن ام مكتوم وهو اعمي وهو الذي انزلت فيه عبس وتولي ان جاءه الاعمي وكان رجلا من قريش الي رسول الله صلي الله عليه وسلم فقال له يا رسول الله معبد انت وامي انا كما تراني قد كبرت سني ورق عظمي وذهب بصري ولي قاءد لا يلاومني قيادة اياي فهل تجد لي من رخصة اصلي في بيتي الصلوات فقال رسول الله صلي الله عليه وسلم هل تسمع المءذن من البيت الذي انت فيه قال نعم يا رسول الله قال رسول الله صلي الله عليه وسلم ما اجد لك من رخصة ولو يعلم هذا المتخلف عن الصلاة في الجماعة ما لهذا الماشي اليها لاتاها ولو حبوا علي يديه ورجليه حدثنا احمد بن عمرو اسمع المكي ثنا يعقوب بن حميد ثنا الوليد بن مسلم عن عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة ان رسول الله صلي الله عليه وسلم قال صلاة علي اثر صلاة كتاب في عليين حدثنا يحيي بن عبد الباقي المصيصي ثنا عمرو بن عثمان الحمصي ثنا الوليد بن مسلم عن عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة ان رسول الله صلي الله عليه وسلم راح الي مكة من مني يوم 
 التروية فقدم والي جانبه بلال معه ثوب علي عود يستره من حر الشمس حدثنا محمد بن يزيد بن عبد الصمد الدمشقي والحسن ابن علي المعمري قالا ثنا هشام بن عمار ثنا صدقة بن خالد ثنا عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم من بني لله مسجدا بني له بيتا في الجنة اوسع منه حدثنا احمد بن المعلي الدمشقي ثنا هشام بن عمار ثنا صدقة بن خالد ثنا عثمان بن ابي العاتكة عن علي بن يزيد عن القاسم عن ابي امامة قال لما نزلت وانذر عشيرتك الاقربين جمع رسول الله صلي الله عليه وسلم بني هاشم فاجلسهم علي الباب وجمع نساءه واهله فاجلسهم في البيت ثم اطلع عليهم فقال يا بني هاشم اشتروا انفسكم من النار واسعوا في فكاك رقابكم وافتكوا انفسكم من الله فاني لا املك لكم من الله شيءا ثم اقبل علي اهل بيته فقال يا عاءشة بنت ابي بكر ويا حفصة بنت عمر ويا ام سلمة ويا فاطمة بنت محمد ويا ام الزبير عمة رسول الله صلي الله عليه وسلم اشتروا انفسكم من النار واسعوا في فكاك رقابكم فاني لا اطلب لكم من الله شيءا ولا اغني فبكت عاءشة وقالت يا حبي وهل يكون ذلك يوم لا تغني عنا شيءا قال نعم في ثلاث مواطن يقول الله عز وجل ونضع الموازين القسط ليوم القيامة الايتين فعند ذلك لا اغني عنكم من الله شيءا وعند النور من شاء الله اتم له نوره ومن شاء اكبه في الظلمات يغمه فيها فلا املك لكم من الله شيءا ولا اغني لكم من الله شيءا وعند الصراط من شاء الله سلمه واجازه ومن شاء ليكبه في النار قالت عاءشة اي حبي قد علمنا الموازين هي الكفتان فيوضع في هذه الشء 
 فيرجح احدهما ويخف الاخري وقد علمنا ما النور وما الظلمة فما الصراط فقال طريق بين الجنة والنار يجوز الناس عليه وهو مثل حد الموسي والملاءكة صافين يمينا وشمالا يخطفوهم حرصي مثل شوك السعدان وهم يقولون رب سلم سلم واقتد بهم هواء فمن شاء الله سلمهم ومن شاء الله ليكبه فيها * (ابو عبد الرحيم خالد بن ابي يزيد عن ابي عبد الملك علي ابن يزيد عن القاسم) * حدثنا محمد بن احمد بن البراء ثنا المعافي بن سليمان ثنا موسي بن اعين عن ابي عبد الرحيم خالد بن ابي يزيد عن ابي عبد الملك عن القاسم عن ابي امامة ان ابا ذر قال يا رسول الله صلي الله عليه وسلم ما الصدقة قال اضعاف مضعفة وعند الله المزيد ثم قرا من ذا الذي يقرض الله قرضا حسنا فيضاعفه له اضعافا كثيرة فقال يا رسول الله فاي الصدقة افضل قال سر الي فقير او جهد من مقل ثم قرا ان تبدوا الصدقات فنعما هي وان تخفوها وتءتوها الفقراء فهو خير لكم الي اخر الاية حدثنا محمد بن احمد بن البراء ثنا المعافي بن سليمان ثنا موسي بن اعين عن ابي عبد الرحيم عن ابي عبد الملك عن القاسم عن ابي امامة قال جلس نبي الله صلي الله عليه وسلم يوما في نفر من اصحابه فرفع نبي الله صلي الله عليه وسلم يده فقال من يبايعني ثلاث مرات فلم يقم اليه احد الا ثوبان فقال معبد انت وامي قد بايعناك مرة وانا ابايعك الثانية فعلام ابايعك يا رسول الله قال علي ان لا تسالوا الناس شيءا ولكم الجنة فقال 
 يا رسول الله ان انا بايعتك ولم اسال الناس شيءا فلي الجنة قال نعم ان شاء الله قال لا والذي بعثك بالحق لا اسال شيءا ما بقيت في الدنيا حدثنا محمد بن عمرو بن خالد الحراني ثنا ابي ثنا موسي ابن حدثني خالد بن ابي يزيد ح وحدثنا احمد بن عبد الرحمن بن عقال الحراني ثنا ابو جعفر النفيلي ثنا محمد بن سلمة عن ابي عبد الرحيم عن ابي عبد الملك عن القاسم عن ابي امامة قال ما صليت خلف رسول الله صلي الله عليه وسلم وانا قريب منه الا سمعته يقول في دبر كل صلاة اللهم اغفر لي خطاياي وذنوبي كلها اللهم انعشني واجرني واهدني لصالح الاعمال والاخلاق فانه لا يهدي لصالحها ولا يصرف عني سيءها الا انت حدثنا احمد بن عبد الرحمن بن عقال الحراني ثنا ابو جعفر النفيلي ثنا محمد بن سلمة عن ابي عبد الرحيم عن ابي عبد الملك عن القاسم عن ابي امامة قال كلمات حفظتهن من رسول الله صلي الله عليه وسلم لا يزداد المال الا افاضة ولا يزداد الناس الا شحا ولا يزداد الامر الا شدة ولا تقوم الساعة الا علي شرار الناس حدثنا احمد بن الحسين بن نصر الحذاء البغدادي ثنا اسماعيل بن عبيد بن ابي كريمة ثنا محمد بن سلمة عن ابي عبد الرحيم عن ابي عبد الملك عن القاسم عن ابي امامة قال بينا رسول الله صلي الله عليه وسلم ومعه ابو بكر وعمر وابو عبيدة بن الجراح رضي الله عنهم في نفر من اصحابه اذ اتي بقدح فيه شراب فناوله رسول الله صلي الله عليه وسلم ابا عبيدة فقال ابو عبيدة انت اولي به يا نبي الله قال خذ فاخذ ابو عبيدة القدح ثم قال له 
 قبل ان يشرب خذ يا نبي الله قال نبي الله صلي الله عليه وسلم اشرب فان البركة في اكابرنا فمن لم يرحم صغيرنا ويجل كبيرنا فليس منا حدثنا احمد بن الحسين الحذاء ثنا اسماعيل بن ابي كريمة ثنا محمد بن سلمة عن ابي عبد الرحيم عن ابي عبد الملك عن القاسم عن ابي امامة عن نبي الله صلي الله عليه وسلم قال جاءني جبريل فوضع يديه احداهما علي صدري والاخري بين كتفي حتي وجدت برد التي علي صدري بين كتفي والتي بين كتفي في صدري فقال يا محمد كبر الكبير وهلل باليقين وقل سبحان رب الاولين والاخرين حدثنا احمد بن الحسين الحذاء ثنا اسماعيل بن عبيد ابي كريمة ثنا محمد بن سلمة عن ابي عبد الرحيم عن ابي عبد الملك عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم تجهزوا الي هذه القرية الظالم اهلها يعني خيبر فان الله فاتحها عليكم ان شاء الله ولا يخرجن معي ضعيف ولا مضعف فانطلق ابو هريرة الي امه فقال جهزيني فان رسول الله صلي الله عليه وسلم قد امرنا بالجهاز للغزو فقالت تنطلق وتتركني وقد علمت اني ما ادخل المرفق الا وانت معي فقال ما كنت لاتخلف عن رسول الله صلي الله عليه وسلم فاخرجت ثديها فناشدته بما رضع من لبنها فاتت رسول الله صلي الله عليه وسلم سرا فاخبرته فقال انطلقي فقد كفيت فاتاه ابو هريرة فاعرض عنه رسول الله صلي الله عليه وسلم فقال يا رسول الله قد اري اعراضك عني لا اري ذلك الا لشء بلغك قال انت الذي غلبتموه امك واخرجت ثديها غلبتموه بما رضعت من لبنها فلم تفعل ايحسب احدكم اذا كان عند ابويه او احدهما ان ليس في سبيل الله بلي هو في سبيل الله اذا برهما وادي حقهما قال ابو هريرة لقد مكثت بعد ذلك سنتين ما اغزو حتي 
 ماتت وخرج رسول الله صلي الله عليه وسلم من المدينة ليلا فساروا معه فتي من بني عامر علي بكر له صعب فجلس يسير فجفل من ناحية الطريق والناس فوقع بعيره في حرق فصاح يا لعامر فارتقس هو وبعيره فجاء قومه فاحتملوه وسار رسول الله صلي الله عليه وسلم حتي اتي خيبر فنزل عليها فدعا الطفيل بن عامر بن الحارث الهدي فقال انطلق الي قومك فاستمدهم علي اهل هذه القرية الظالم اهلها فان الله سيفتحها عليكم ان شاء الله قال الطفيل يا رسول الله تبعدني منك والله لان اموت وانا منك قريب احب الي من الحياة وانا منك بعيد فقال رسول الله صلي الله عليه وسلم انه لا بد مما لا بد منه فانطلق فقال يا رسول الله صلي الله عليه وسلم لعلي لا القاك فزودني شيءا اعيش به قال اتملك لسانك قال فماذا املك اذا لم املك لساني قال اتملك يدك قال فماذا املك اذا لم املك يدي قال فلا تقل بلسانك الا معروفا ولا تبسط يدك الا الي خير قال بن ابي كريمة وجدت في كتاب ابي عبد الرحيم بخطه في هذا الحديث وقال له نبي الله صلي الله عليه وسلم افش السلام وابذل الطعام واستحي الله بما تستحيي رجلا من اهلك ذي هياة ولتحسن خلقك واذا اسات فاحسن فان الحسنات يذهبن السيءات حدثنا احمد بن الحسين الحذاء ثنا اسماعيل بن عبيد بن ابي كريمة ثنا محمد بن سلمة عن ابي عبد الرحيم عن ابي عبد الملك عن القاسم عن ابي امامة انه سمع رسول الله صلي الله عليه وسلم وهو راكب علي الجدعاء وخلفه الفضل بن عباس يقول لا تالوا علي الله لا تالوا علي الله فانه من تالي علي الله اكذبه الله 
 حدثنا احمد بن الحسين الحذاء ثنا اسماعيل بن عبيد بن ابي كريمة ثنا محمد بن سلمة عن ابي عبد الرحيم عن ابي عبد الملك عن القاسم عن ابي امامة قال جاء رجل الي رسول الله صلي الله عليه وسلم حين توفي ابراهيم وعيناه تدمعان فقال يا نبي الله تبكي علي هذا السخل والذي بعثك بالحق لقد دفنت اثني عشر ولدا في الجاهلية كلهم اسف منه كلهم ادسه في التراب احياء فقال نبي الله صلي الله عليه وسلم فما ذاك بان كانت الرحمة ذهبت منك يحزن القلب وتدمع العين علي ابراهيم ولا نقول ما يسخط الرب وانا علي ابراهيم لمحزونون حدثنا احمد بن الحسين الحذاء ثنا اسماعيل بن عبيد بن ابي كريمة ثنا محمد بن سلمة عن ابي عبد الرحيم عن ابي عبد الملك عن القاسم عن ابي امامة قال سمعت رسول الله صلي الله عليه وسلم يقول اذا اراد الله بعبد خيرا طهره قبل موته قالوا يا رسول الله وما طهور العبد قال عمل صالح يلهمه اياه حتي يقبضه عليه حدثنا احمد بن الحسين الحذاء ثنا اسماعيل بن عبيد ثنا محمد ابن سلمة عن ابي عبد الرحيم عن ابي عبد الملك عن القاسم عن ابي امامة قال سمعت رسول الله صلي الله عليه وسلم يقول صلاة علي اثر صلاة لا لغو بينهما كتاب في عليين حدثنا احمد بن الحسين الحذاء ثنا اسماعيل بن عبيد بن ابي كريمة ثنا محمد بن سلمة عن ابي عبد الرحيم عن ابي عبد الملك عن القاسم عن ابي امامة عن نبي الله صلي الله عليه وسلم قال من صام يوما في سبيل الله باعده الله من جهنم ماءة عام ركض الفارس الجواد المضمر 
 حدثنا احمد بن الحسين الحذاء ثنا اسماعيل بن عبيد بن ابي كريمة ثنا محمد بن سلمة عن ابي عبد الرحيم عن ابي عبد الملك عن القاسم عن ابي امامة قال جاءت الي نبي الله صلي الله عليه وسلم امراة بذيءة اللسان قد عرف ذلك منها وبين يديه قديد ياكله فاخذ قديدة فيها عصب فالقاها الي فيه فهو يلوكها مرة علي جانبه هذا ومرة علي جانبه الاخر فقالت المراة يا نبي الله الا تطعمني قال بلي فناولها مما بين يديه فقالت لا الا الذي في فيك فاخرجه فاعطاها فاخذته فالقته الي فمها فلم تزل تلوكه حتي ابتلعته فلم تزل تلوكه حتي ابتلعته فلم يعلم من تلك المراة بعد ذلك الامر الذي كانت عليه من البذاء والذرابة * (محمد بن عبيد الله العرزمي عن علي بن يزيد عن القاسم عن ابي امامة رضي الله عنه) * حدثنا محمد بن يعقوب بن سورة البغدادي ثنا عبد الله بن يونس بن بكير ثنا ابي ثنا محمد بن عبيد الله العرزمي عن علي بن يزيد عن القاسم عن ابي امامة ان رسول الله صلي الله عليه وسلم قال من دعاكم فاجيبوه * (عثمان بن ابي العاتكة عن القاسم عن ابي امامة) * حدثنا احمد بن عمرو اسمع المكي ثنا يعقوب بن حميد ثنا محمد بن يزيد عن عثمان بن ابي العاتكة عن القاسم عن ابي امامة ان النبي صلي الله عليه وسلم قال صلاة علي اثر صلاة لا لغو بينهما كتاب في عليين  
 * (الوليد بن ابي مالك عن القاسم عن ابي امامة) * حدثنا علي بن عبد العزيز وابو مسلم الكشي قالا ثنا حجاج ابن المنهال ح وحدثنا ابو مسلم الكشي ثنا ابو عمر الضرير قالا ثنا حماد بن سلمة عن الحجاج عن الوليد بن ابي مالك عن القاسم ابي عبد الرحمن عن ابي امامة ان رسول الله صلي الله عليه وسلم قال خذوا العلم قبل ان ينفذ ثلاثا قالوا يا رسول الله وكيف ينفذ وفينا كتاب الله فغضب لا يغضبه الله ثم قال ثكلتكم امهاتكم الم تكن التوراة والانجيل في بني اسراءيل ثم لم يغن عنهم شيءا ان ذهاب العلم ذهاب حملته ثلاثا حدثنا الحسين بن اسحاق التستري ثنا يحيي الحماني ثنا ابو خالد الاحمر عن الحجاج عن الوليد بن ابي مالك عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم يجير علي المسلمين بعضهم حدثنا عبيد بن غنام ثنا ابو بكر بن ابي شيبة ثنا عبد الرحيم ابن سليمان عن حجاج عن الوليد بن ابي مالك عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال يجير علي المسلمين الرجل منهم * (الوليد بن سليمان بن ابي الساءب عن القاسم) * حدثنا عمرو بن اسحاق بن ابراهيم بن العلاء بن زبريق الحمصي حدثني ابراهيم بن العلاء ح وحدثنا جعفر بن محمد الفريابي ثنا ابراهيم بن العلاء الحمصي ثنا الوليد بن مسلم عن الوليد بن ابي الساءب عن القاسم عن ابي امامة 
 قال بينما نحن مع رسول الله صلي الله عليه وسلم اذ لحقنا عمرو بن زرارة الانصاري في حلة ازار ورداء قد اسبل فجعل النبي صلي الله عليه وسلم ياخذ بناحية ثوبه ويتواضع لله ويقول اللهم عبدك وابن عبدك وابن امتك حتي سمعها عمرو بن زرارة فالتفت الي النبي صلي الله عليه وسلم فقال يا رسول الله اني احمس الساقين فقال رسول الله صلي الله عليه وسلم يا عمرو بن زرارة ان الله عز وجل قد احسن كل خلقه يا عمرو بن زرارة ان الله لا يحب المسبلين ثم قال رسول الله صلي الله عليه وسلم بكفه تحت ركبة نفسه فقال يا عمرو بن زرارة هذا موضع الازار ثم رفعها ثم وضعها تحت ذلك فقال يا عمرو بن زرارة هذا موضع الازار ثم رفعها ثم وضعها تحت ذلك فقال يا عمرو بن زرارة هذا موضع الازار حدثنا احمد بن المعلي والحسن بن علي المعمري قالا ثنا هشام بن عمار ثنا الوليد بن مسلم عن الوليد بن سليمان بن ابي الساءب عن القاسم عن ابي امامة رضي الله عنه قال قال رسول الله صلي الله عليه وسلم تكون فتنة يصبح الرجل فيها مءمنا ويمسي كافرا الا من احياه الله العلم * (الوليد بن جميل الدمشقي عن القاسم) * حدثنا عبد الله بن احمد بن حنبل حدثني روح بن عبد المءمن المقري ح وحدثنا محمد بن عبد الله الحضرمي ثنا محمد بن ابي رجاء العباداني ثنا سلمة بن رجاء عن الوليد بن جميل عن القاسم عن ابي امامة قال ذكر رسول الله صلي الله عليه وسلم رجلين احدهما عالم والاخر عابد فقال رسول الله صلي الله عليه وسلم 
 فضل العالم علي العابد كفضلي علي ادناكم حدثنا احمد بن عمرو بن اسمع المكي ثنا يعقوب بن حميد ثنا سلمة بن رجاء عن الوليد بن جميل عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم ان الله وملاءكته حتي النملة في جحرها وحتي الحوت في البحر ليصلون علي معلم الناس الخير حدثنا عبد الله بن احمد بن حنبل حدثني روح بن عبد المءمن المقرء ح وحدثنا محمد بن عبد الله الحضرمي ثنا محمد بن ابي رجاء العباداني ثنا سلمة بن رجاء عن الوليد بن جميل عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم من رحم ذبيحة رحمه الله يوم القيامة حدثنا احمد بن عمرو اسمع المكي ثنا يعقوب بن حميد ثنا سلمة بن رجاء عن الوليد بن جميل عن القاسم عن ابي امامة قال مر النبي صلي الله عليه وسلم علي رجل منبطح علي وجهه فضربه برجله وقال قم فانها نومة جهنمية حدثنا محمد بن جابان الجنديسابوري ثنا محمود بن غيلان ثنا يزيد بن هارون ثنا الوليد بن جميل عن القاسم عن ابي امامة رضي الله عنه قال قال رسول الله صلي الله عليه وسلم من رحم ولو ذبيحة عصفور رحمه الله يوم القيامة حدثنا محمد بن جابان ثنا محمود بن غيلان ثنا يزيد بن 
 هارون ثنا الوليد بن جميل عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم افضل الصدقات ظل فسطاط في سبيل الله او طروقة فحل في سبيل الله حدثنا محمد بن جابان ثنا محمود بن غيلان ثنا يزيد بن هارون ثنا الوليد بن جميل عن القاسم عن ابي امامة ان رسول الله صلي الله عليه وسلم نهي عن صلاتين وعن صيامين وعن نكاحين وعن لبستين وعن بيعتين حدثنا محمد بن جابان ثنا محمود بن غيلان ثنا يزيد بن هارون ثنا الوليد بن جميل عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم ليس شء احب الي الله من قطرتين واثرين قطرة دموع من خشية الله وقطرة دم تهراق في سبيل الله واما الاثران فاثر في سبيل الله واثر في فريضة من فراءض الله حدثنا محمد بن جابان ثنا محمود بن غيلان ثنا يزيد بن هارون ثنا الوليد بن جميل عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال من المءمنين من يدخل بشفاعته الجنة مثل ربيعة ومضر حدثنا محمد بن جابان ثنا محمود بن غيلان ثنا يزيد بن هارون ثنا الوليد بن جميل عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال اربع ايات نزلن من كنز تحت العرش لم ينزل منهن شء غيرهن ام الكتاب فانه يقول وانه في ام الكتاب لدينا لعلي حكيم واية الكرسي وسورة البقرة والكوثر حدثنا محمد بن جابان ثنا محمود بن غيلان ثنا يزيد بن 
 هارون ثنا الوليد بن جميل عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم من صام يوما في سبيل الله جعل الله بينه وبين النار خندقا كما بين السماء والارض حدثنا محمد بن جابان ثنا محمود بن غيلان ثنا يزيد بن هارون ثنا الوليد بن جميل عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم من لم يجل كبيرنا ويرحم صغيرنا فليس منا حدثنا احمد بن المعلي الدمشقي ثنا عبد الله بن يزيد المقرء الدمشقي ثنا صدقة بن عبد الله عن الوليد بن جميل قال سمعت القاسم بن عبد الرحمن يحدث عن ابي امامة عن النبي صلي الله عليه وسلم قال دخلت الجنة فاذا انا بخشفة بين يدي فقلت من هذا يا جبريل فقال هذا بلال المءذن فنظرت فاذا اكثر اهل الجنة الضعفاء والمساكين واذا اقل اهل الجنة الاغنياء والنساء قلت له ما هذا يا جبريل فقال ان الاغنياء يحبسون عند باب الجنة يحاسبون ويمحصون واما النساء فالهاهن الاحمران الذهب والحرير ثم خرجت الي ابواب الجنة الثمانية فاذا بالميزان فاخذ كفة فوضع فيها جميع امتي وجعلت في الكفة الاخري فرجحت بهم ثم عرضت علي امتي رجلا رجلا فاستبطات عبد الرحمن بن عوف فلما جاء قلت ما حبسك فبكي الي وبكيت اليه فقال يا رسول الله كنت هناك وراء الباب احاسب وامحص حتي ظننت اني لن اراك ولن تراني * (عبد الله بن العلاء بن زبر الدمشقي عن القاسم) * حدثنا ابراهيم بن محمد بن عرق الحمصي ثنا سليمان بن 
 سلمة الخباءري ثنا زيد بن يحيي بن عبيد الدمشقي ثنا عبد الله بن العلاء ابن زبر حدثني القاسم بن عبد الرحمن ابو عبد الرحمن قال سمعت ابا امامة الباهلي يقول خرج رسول الله صلي الله عليه وسلم علي مشيخة من الانصار بيض لحاهم فقال يا معاشر الانصار حمروا وصفروا وخالفوا اهل الكتاب فقلنا يا رسول الله اهل الكتاب لا يتخففون ولا ينتعلون فقال تخففوا وانتعلوا وخالفوا اهل الكتاب قلنا يا رسول الله اهل الكتاب يقصون عثانينهم ويطيلون سبالهم فقال رسول الله صلي الله عليه وسلم قصوا سبالكم واعفوا ثعانينكم حدثنا الحسين بن اسحاق التستري ثنا موسي بن سهل ابو عمران الجوني قالا ثنا هشام بن عمار ثنا الوليد بن مسلم ثنا عبد الله بن العلاء بن زبر انه سمع القاسم ابا عبد الرحمن يحدث عن ابي امامة يرفعه قال اسم الله الاعظم الذي اذا دعي به اجاب في ثلاث سور من القران في البقرة وال عمران وطه * (عيسي بن سعيد عن القاسم) * حدثنا الحسين بن اسحاق التستري ثنا سهل بن عثمان ثنا المحاربي عن مطرح بن يزيد عن محمد بن يزيد عن عيسي بن سعيد عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال من دعا بهءلاء الدعوات في دبر كل صلاة مكتوبة حلت له الشفاعة مني يوم القيامة اللهم اعط محمدا الوسيلة واجعله في المصطفين محبته وفي العالمين درجته وفي المقربين ذكر داره 
 * (بشر ابو نصر عن القاسم) * حدثنا عبد الله بن احمد بن حنبل ثنا احمد بن محمد بن ايوب صاحب المغازي ح وحدثنا الحسين بن اسحاق التستري ثنا يحيي الحماني قالا ثنا ابو بكر ابن عياش عن ابي المهلب عن محمد بن يزيد الثقفي اخبرني بشر ابو نصر عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم من قدر علي طمع من طمع الدنيا فاداه ولو شاء لم يءده زوجه الله عز وجل من الحور العين حيث شاء * (خالد بن ابي عمران المصري عن القاسم) * حدثنا ابو يزيد القراطيسي ثنا اسد بن موسي ثنا بن لهيعة ثنا عبيد الله بن زحر عن خالد بن ابي عمران عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم من شفع لاخيه شفاعة فاهدي له هدية فقبلها فقد اتي بابا عظيما من الربا حدثنا بكر بن سهل الدمياطي ثنا شعيب بن يحيي التجيبي ثنا بن لهيعة عن خالد ابي عمران عن القاسم ابي عبد الرحمن عن ابي امامة عن رسول الله صلي الله عليه وسلم قال من مسح راس يتيم كان له بكل شعرة حسنة * (عبد الكريم بن ابي امية عن القاسم) * حدثنا محمد بن يونس العصفري البصري ثنا اسحاق بن 
 ابراهيم الشهيدي ثنا المعتمر بن سلمان قال سمعت ليثا يحدث عن عبد الكريم عن ابي عبد الرحمن القاسم عن ابي امامة قال راني النبي صلي الله عليه وسلم وانا احرك شفتي فقال ما تقول يا ابا امامة قلت اذكر الله قال افلا ادلك علي ما هو اكثر من ذكرك الله الليل مع النهار تقول الحمد لله عدد ما خلق والحمد لله ملء ما خلق والحمد لله عدد ما في السماوات وما في الارض والحمد لله عدد ما احصي كتابه والحمد لله ملء ما احصي كتابه والحمد لله عدد كل شء والحمد لله ملء كل شء وتسبح الله مثلهن ثم قال تعلمهن عقبك من بعدك * (بشر بن نمير عن القاسم) * حدثنا معاذ بن المثني ثنا المسدد ثنا عبد الوارث عن بشر بن نمير عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم اعطيت اربعا لم يعطهن نبي قبلي نصرت بالرعب من مسير شهر وبعثت الي كل ابيض واسود واحلت لي الغناءم وجعلت لي الارض طهورا حدثنا محمد بن عبد الله الحضرمي ثنا جعفر بن محمد بن الحسن الاسدي ثنا ابي ثنا ابراهيم بن طهمان عن سهيل بن ابي صالح عن بشر بن نمير عن القاسم عن ابي امامة رضي الله عنه عن النبي صلي الله عليه وسلم قال من انفق نفقة علي نفسه فهي صدقة وعلي امراته وعلي ولده حدثنا خلف بن عمرو العكبري ثنا غسان بن الفضل الغلابي ثنا عمرو بن علي المقدمي عن بشر بن نمير عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم الذي يجهر بالقران كالذي يجهر بالصدقة والذي يخفي القران كالذي يخفي الصدقة 
 حدثنا جعفر بن سليمان بن حاجب الانطاكي ثنا ابو صالح الفراء ثنا ابو اسحاق ها عن بشر بن نمير عن القاسم عن ابي امامة قال لما كانت غزوة خيبر قال رسول الله صلي الله عليه وسلم انا مصبحوهم فاضطروا وتقووا حدثنا الحسين بن اسحاق التستري ثنا سهل بن عثمان ثنا المسيب بن شريك عن بشر بن نمير عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم ثلاثة في ظل الله يوم لا ظل الا ظله رجل حيث توجه علم ان الله معه ورجل دعته امراة الي نفسها فتركها من خشية الله ورجل احب بجلال الله عز وجل حدثنا الحسين بن اسحاق التستري ثنا سهل بن عثمان ثنا المسيب بن شريك عن بشر بن نمير عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم يتزاور اهل الجنة علي نوق عليها الحشايا فيزور اهل عليين من اسفل منهم ولا يزور من اسفل منهم اهل عليين الا المتحابين في الله فانهم يتزاورون من الجنة حيث شاءوا حدثنا ابراهيم بن هاشم البغوي ثنا محمد بن المنهال ثنا يزيد بن زريع عن بشر بن نمير عن القاسم عن ابي امامة قال قال النبي صلي الله عليه وسلم من داين بدين وفي نفسه وفاءه فمات تجاوز الله عنه وارضي غريمه بما شاء ومن داين بدين وليس في نفسه وفاءه فمات اقتص الله لغريمه منه يوم القيامة حدثنا ابراهيم بن هاشم البغوي ثنا محمد بن المنهال ثنا 
 يزيد بن زريع عن بشر بن نمير عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال اربعة لا ينظر الله اليهم يوم القيامة عاق ومنان ومدمن خمر ومكذب بقدر حدثنا ابراهيم بن هاشم البغوي ثنا محمد بن المنهال ثنا يزيد بن زريع عن بشر بن نمير عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال خذوا من العبادة ما تطيقون فان الله لا يسام حتي تساموا * (جعفر بن الزبير عن القاسم) * حدثنا ابراهيم بن صالح الشيرازي ثنا عثمان بن الهيثم ثنا جعفر بن الزبير عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم خلق الله الخلق وقضي القضية واخذ مثاق النبيين وعرشه علي الماء فاهل الجنة اهلها واهل النار اهلها قالوا يا نبي الله فيم الاعمال قال يعمل كل قوم لمنزلتهم فقال عمر بن الخطاب اذا نجتهد يا رسول الله حدثنا ابراهيم بن صالح الشيرازي ثنا عثمان بن الهيثم ثنا جعفر بن الزبير عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال ان اول قطرة تقطر من دم الشهيد تكفر بها ذنوبه والثانية يكسي حلل الايمان والثالثة يزوج من الحور العين حدثنا ابراهيم بن صالح الشيرازي ثنا عثمان بن الهيثم ثنا جعفر بن الزبير عن القاسم عن ابي امامة رضي الله عنه قال قال رسول الله صلي الله عليه وسلم المءذن يغفر له مدي صوته واجره مثل اجر من صلي معه 
 حدثنا ابراهيم بن صالح ثنا عثمان بن الهيثم ثنا جعفر بن الزبير عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم لما خلق الله عز وجل الخلق وقضي القضية اخذ اهل اليمين بيمينه واهل الشمال بشماله فقال يا اصحاب اليمين قالوا لبيك وسعديك قال الست بربكم قالوا بلي قال يا اصحاب الشمال قالوا لبيك وسعديك قال الست بربكم قالوا بلي ثم خلط بينهم فقال قاءل يا رب لم خلطت بينهم قال لهم اعمال من دون ذلك هم لها عاملون ان يقولوا يوم القيامة انا كنا عن هذا غافلين ثم ردهم في صلب ادم حدثنا علي بن عبد العزيز وابو مسلم الكشي قالا ثنا حجاج بن المنهال ثنا حماد بن سلمة عن جعفر بن الزبير عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال ما من مسلم يتوضا فيحسن الوضوء ثم يصلي المكتوبة الا كانت له كحجة وان صلي تطوعا كانت له كعمرة حدثنا اسحاق بن ابراهيم الدبري عن عبد الرزاق عن اسراءيل بن يونس عن جعفر بن الزبير عن القاسم عن ابي امامة ان رجلا سال النبي صلي الله عليه وسلم فقال مسست ذكري وانا اصلي فقال لا باس انما هو جذية منك حدثنا محمد بن عبد الله الحضرمي ثنا احمد بن يونس ثنا اسراءيل عن جعفر بن الزبير عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم يقوم الرجل من مجلسه لاخيه الا بني هاشم لا يقومون لاحد حدثنا ابراهيم بن ناءلة الاصبهاني ثنا اسماعيل بن عمرو 
 البجلي ثنا اسراءيل عن جعفر بن الزبير عن القاسم عن ابي امامة قال سءل رسول الله صلي الله عليه وسلم عن الفرش المرفوعة فقال لو طرح فراش من اعلاها لهوي الي قرارها ماءة خريف حدثنا احمد بن علي القاضي الحمصي ثنا ابو موسي الهروي ثنا عطاء بن جبلة عن الاعمش عن جعفر بن الزبير عن القاسم عن ابي امامة ان النبي صلي الله عليه وسلم نام حتي نفخ ثم قال الوضوء علي من اضطجع حدثنا ابو مسلم الكشي ثنا حجاج بن المنهال ثنا حماد بن سلمة عن جعفر بن الزبير عن القاسم عن ابي امامة ان رسول الله صلي الله عليه وسلم قال من ادان دينا وهو ينوي ان يءديه ادي الله عنه يوم القيامة ومن استدان دينا وهو لا ينوي ان يءديه فمات قال الله عز وجل يوم القيامة ظننت اني لا اخذ لعبدي حقه فيءخذ من حسناته فيجعل في حسنات الاخر فان لم تكن له حسنات اخذ من سيءات الاخر فجعلت عليه حدثنا علان بن عبد الصمد ما غمه ثنا عمر بن محمد بن الحسن ثنا ابي ثنا ابراهيم بن طهمان عن جعفر بن الزبير عن القاسم عن ابي امامة رضي الله عنه قال قال رسول الله صلي الله عليه وسلم من كان عليه دين ينوي قضاءه فمات ولم يترك وفاء تجاوز الله عنه وارضي صاحب الدين بما شاء وعند الله رضاه حدثنا احمد بن بشر بن حبيب البيروتي ثنا سليمان بن عبد الرحمن الدمشقي ثنا اسماعيل بن عياش ثنا عتبة بن حميد عن جعفر بن الزبير عن القاسم عن ابي امامة ان النبي صلي الله عليه وسلم قال ما ينبغي لعبد ان ياتي اخاه فيساله قرضا وهو يجده فيمنع 
 حدثنا الحسين بن اسحاق التستري ثنا سهل بن عثمان ثنا مروان بن معاوية عن جعفر بن الزبير عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم الجمعة علي الخمسين رجلا وليس علي ما دون الخمسين جمعة حدثنا الحسين بن اسحاق التستري ثنا سهل بن عثمان ثنا مروان بن معاوية عن جعفر بن الزبير عن القاسم عن ابي امامة ان النبي صلي الله عليه وسلم كان يتختم في يمينه حدثنا الحسين بن اسحاق التستري ثنا سهل بن عثمان ثنا علي بن غراب عن جعفر بن الزبير عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم الصاءم المتطوع بالخيار الي نصف النهار حدثنا الحسين بن اسحاق التستري ثنا سهل بن عثمان ثنا وكيع عن جعفر بن الزبير عن القاسم عن ابي امامة رضي الله عنه قال قال رسول الله صلي الله عليه وسلم اذا جاوز الختان الختان وجب الغسل حدثنا ابراهيم بن ناءلة الاصبهاني ثنا اسماعيل بن عمرو الاسماء ثنا اسراءيل عن جعفر بن الزبير عن القاسم عن ابي امامة قال سءل النبي صلي الله عليه وسلم ايتزاور اهل الجنة قال يزور الاعلي الاسفل ولا يزور الاسفل الاعلي الا الذين يتحابون في الله عز وجل ياتون منها حيث شاءوا علي النوق محتقبين الحشايا حدثنا عبد العزيز بن سليمان الحرملي الانطاكي ثنا يعقوب ابن كعب الحلبي ثنا مروان بن معاوية عن جعفر بن الزبير عن القاسم عن 
 ابي امامة قال قال رسول الله صلي الله عليه وسلم لابثين فيها احقابا الحقب الواحد ثلاثون الف سنة حدثنا علان بن عبد الصمد ما غمه ثنا عمر بن محمد بن الحسن ثنا ابي ثنا ابراهيم بن طهمان عن جعفر بن الزبير عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم ذكر عنده الكنود قال الكنود الذي ياكل وحده ويمنع رفده ويضرب عبده حدثنا علان بن عبد الصمد ما غمه ثنا عمر بن محمد بن الحسن ثنا ابي ثنا ابراهيم بن طهمان عن جعفر بن الزبير عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال التيمم ضربة للوجه وضربة للكفين حدثنا علان بن عبد الصمد ما غمه ثنا عمر بن محمد بن الحسن ثنا ابي ثنا ابراهيم بن طهمان عن جعفر بن الزبير عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال من بزق في قبلته ولم يوارها جاءت يوم القيامة احماما تكون حتي انكر بين عينيه حدثنا علان بن عبد الصمد ثنا عمر بن محمد بن الحسن ثنا ابي ثنا ابراهيم بن طهمان عن جعفر بن الزبير عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال من حدث حديثا كما سمع فان كان برا وصدقا فلك وان كان كذبا فعلي من بدا حدثنا علان ثنا عمر بن محمد بن الحسن ثنا ابي ثنا ابراهيم بن طهمان عن جعفر بن الزبير عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال ان الله عز وجل جميل يحب الجمال 
 حدثنا علان بن عبد الصمد ثنا عمر بن محمد بن الحسن ثنا ابي ثنا ابراهيم بن طهمان عن جعفر بن الزبير عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال من تخطي حلقة قوم بغير اذنهم فهو عاص حدثنا علان ثنا عمر بن محمد حدثنا ابي ثنا ابراهيم بن طهمان عن جعفر بن الزبير عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال لا تقوم الساعة حتي ترجعوا حرابين وحتي يعمد الرجل الي النبطية فيتزوجها علي معيشته ويترك بنت عمه لا ينظر اليها حدثنا علان ثنا عمر بن محمد ثنا ابي ثنا ابراهيم بن طهمان عن جعفر بن الزبير عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال ان من امتي من ياتي السوق فيبتاع القميص بنصف دينار او ثلت دينار فيحمد الله اذا لبسه فلا يبلغ ركبتيه حتي يغفر له حدثنا علان ثنا عمر بن محمد ثنا ابي ثنا ابراهيم بن طهمان عن جعفر بن الزبير عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال سلوا الله الفردوس فانها سرة الجنة وان اهل الفردوس ليسمعون اطيط العرش حدثنا علان ثنا عمر بن محمد ثنا ابي ثنا ابراهيم بن طهمان عن جعفر بن الزبير عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال لولا ان المساكين يكذبون ما افلح من ردهم 
 حدثنا محمد بن يحيي بن سهل بن محمد العسكري ثنا سهل بن عثمان ثنا عبد الله بن مسعر عن جعفر بن الزبير عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم لو ان المساكين صدقوا ما افلح من ردهم حدثنا عبد الرحمن بن سلم الرازي ثنا سهل بن عثمان ثنا عبد الله بن مسعر عن جعفر بن الزبير عن القاسم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم لياتين علي جهنم يوم كانها زرع هاج واحمر تخفق ابوابها حدثنا محمد بن يونس العصفري البصري ثنا اسحاق بن ابراهيم السواق العبدي ثنا عبد القاهر بن شعيب ثنا جعفر بن الزبير عن القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال لو ان لابن ادم واديان لتمني واديا ثالثا وما جعل المال الا لاقام الصلاة وايتاء الزكاة ابن يشبع بن ادم الا التراب ويتوب الله علي من تاب حدثنا محمد بن يونس العصفري البصري ثنا اسحاق بن ابراهيم السواق العبدي ثنا عبد القاهر بن شعيب ثنا جعفر بن الزبير عن القاسم عن ابي امامة ان النبي صلي الله عليه وسلم قال صاحب اليمين امين علي صاحب الشمال فاذ عمل العبد حسنة كتبها بعشر امثالها واذا عمل سيءة واراد صاحب الشمال ان يكتبها قال له صاحب اليمين امسك عنها فيمسك عنها فان استغفر الله لم يكتب وان سكت كتبت عليه حدثنا محمد بن يونس ثنا اسحاق بن ابراهيم ثنا عبد القاهر بن شعيب ثنا جعفر بن الزبير عن القاسم عن ابي امامة قال قال النبي صلي الله عليه وسلم لا دين لمن لا امانة له 
 حدثنا محمد بن يونس ثنا اسحاق بن ابراهيم ثنا عبد القاهر بن شعيب ثنا جعفر بن الزبير عن القاسم عن ابي امامة قال كنا مع رسول الله صلي الله عليه وسلم في سفر فلم يستيقظ رسول الله صلي الله عليه وسلم حتي اذاه حر الشمس بين كتفيه فلما استيقظ مكثوا فاقام الصلاة فتقدم ثم صلي بهم فلما صلي بهم قال اذا رقد احدكم فغلبته عيناه فليفعل هكذا فان الله يتوفي الانفس حين موتها والتي لم تمت في منامها حدثنا احمد بن عمرو العمي النحاس البصري ثنا عبيد الله بن سعد ثنا عمي وابي عن بن اسحاق ثنا الحسن بن دينار عن جعفر بن الزبير عن القاسم عن ابي امامة قال جاء رجل ولم يدرك الصلاة فقال له رسول الله صلي الله عليه وسلم صل ثم قال الا احد يتصدق علي هذا فيصلي معه فقام رجل فصلي معه وقال رسول الله صلي الله عليه وسلم وهذه جماعة * (المثني بن الصباح عن القاسم ابي عبد الرحمن) * حدثنا اسحاق بن ابراهيم الدبري عن عبد الرزاق عن المثني بن الصباح عن القاسم الشامي ان مولاة له يقال لها ام هاشم اجلسته في الستر بدواة وقلم وارسلت الي ابي امامة فسالته عن حديث حدثه عن رسول الله صلي الله عليه وسلم في الوضوء قال سمعت رسول الله صلي الله عليه وسلم يقول من قام الي الوضوء فغسل يديه خرجت الخطايا من يديه فاذا مضمض خرجت الخطايا من فيه فاذا استنثر خرجت من انفه فكذلك حتي يغسل القدمين فان خرج الي صلاة مفروضة كانت كحجة مبرورة وان خرج الي صلاة تطوع كانت كعمرة مبرورة 
 * (عتبة بن حميد عن القاسم) * حدثنا الحسن بن علي بن خلف الدمشقي ثنا سليمان بن عبد الرحمن ثنا اسماعيل بن عياش عن عتبة بن حميد عن القاسم عن ابي امامة عن رسول الله صلي الله عليه وسلم قال دخل رجل الجنة فراي علي بابها مكتوبا الصدقة بعشر امثالها والقرض بيمينه عشر * (عمر بن موسي بن وجيه عن القاسم) * حدثنا عبد الله بن احمد بن حنبل ثنا ابي احمد بن حنبل ثنا محمد بن سليمان لوين ثنا بقية بن الوليد حدثني عمر بن موسي حدثني القاسم عن ابي امامة عن النبي صلي الله عليه وسلم قال الاكل في السوق دناءة حدثنا عبد الله بن احمد بن حنبل حدثني محمد بن ابي بكر المقدمي ثنا عبد الرحمن بن ابراهيم بن سويد ثنا عمر بن موسي عن القاسم عن ابي امامة قال تدلي عبد من حصن الطاءف فجاء مولاه فقال يا رسول الله رد علي غلامي فقال ان العبد اذا اسلم قبل مولاه لم يرد اليه واذا اسلم المولي ثم اسلم العبد دفع اليه * (سعيد بن عبد الله الاودي عن ابي امامة) * حدثنا ابو عقيل انس بن سلم الخولاني ثنا محمد بن ابراهيم بن العلاء الحمصي ثنا اسماعيل بن عياش ثنا عبد الله بن محمد 
 القرشي عن يحيي بن ابي كثير عن سعيد بن عبد الله الاودي قال شهدت ابا امامة وهو في النزع فقال اذا انا مت فاصنعوا بي كما امرنا رسول الله صلي الله عليه وسلم ان نصنع بموتانا امرنا رسول الله صلي الله عليه وسلم فقال اذا مات احد من اخوانكم فسويتم التراب علي قبره فليقم احدكم علي راس قبره ثم ليقل يا فلان بن فلانة فانه يسمعه ولا يجيب ثم يقول يا فلان بن فلانة فانه يستوي قاعدا ثم يقول يا فلان بن فلانة فانه يقول ارشدنا رحمك الله ولكن لا تشعرون فليقل اذكر ما خرجت عليه من الدنيا شهادة ان لا اله الا الله وان محمدا عبده ورسوله وانك رضيت بالله ربا وبالاسلام دينا وبمحمد نبيا وبالقران اماما فان منكرا ونكيرا ياخذ واحد منهما بيد صاحبه ويقول انطلق بنا ما نقعد عند من قد لقن حجته فيكون الله حجيجه دزنهما فقال رجل يا رسول الله فان لم يعرف امه قال فينسبه الي حواء يا فلان بن حواء * (اسماعيل الشامي لم ينسب عن ابي امامة) * حدثنا محمد بن محمد الجذوعي القاضي ثنا ابو كامل الجحدري ثنا طريف بن الصلت ابو غالب ثنا حجاج بن عبد الله بن هارون عن اسماعيل الشامي عن ابي امامة رضي الله عنه عن النبي صلي الله عليه وسلم قال ان العبد اذا قام في الصلاة فتحت له ابواب الجنة وكشفت له الحجب بينه وبين ربه واستقبلته الحور العين ما لم يمتخط او يتنخع * (ميمون بن مهران الجزري عن ابي امامة رضي الله عنه) * حدثنا علي بن عبد العزيز ثنا الهيثم بن خارجة ثنا شهاب ابن خراش عن صالح بن جبلة عن ميمون بن مهران عن ابي امامة قال 
 سمعت رسول الله صلي الله عليه وسلم يقول من صام يوم الاربعاء والخميس والجمعة بني الله له بيتا في الجنة يري ظاهره من باطنه وباطنه من ظاهره * (الزبير بن خريق عن ابي امامة) * حدثنا عبيد بن غنام ثنا ابو بكر بن ابي شيبة ثنا كثير بن هشام عن جعفر بن برقان عن عروة بن دينار عن الزبير بن خريق عن ابي امامة رضي الله عنه قال ما كنت قريبا من النبي صلي الله عليه وسلم الا سمعته يدعو بهذا الدعاء اللهم اهدني لصالح الاعمال والاخلاق فانه لا يهدي لصالحها الا انت ولا يصرف سيءها الا انت من روي عن ابي امامة الباهلي من اهل الكوفة * (سالم بن ابي الجعد عن ابي امامة) * حدثنا ابو يزيد القراطيسي ثنا علي بن يزيد ثنا عبيد الله بن عمرو عن زيد بن ابي انيسة عن عمرو بن مرة عن سالم بن ابي الجعد عن ابي امامة الباهلي قال قال رسول الله صلي الله عليه وسلم اذا مضمض احدكم فاه حط ما اصاب بفيه واذا غسل وجهه حط ما اصاب وجهه واذا غسل يديه حط ما اصاب بيده واذا غسل رجليه حط ما اصاب برجليه فقال رجل عند ذلك انظر ما تحدث يا ابا امامة صحبنا رسول الله صلي الله عليه وسلم فما سمعناه يقول ما تقول فقال ابو امامة لو لم اسمعه الا مرة او مرتين لم حالا به حدثنا عبد الله بن سعد بن يحيي الرقي ثنا ابو فروة يزيد بن 
 محمد بن يزيد بن سنان الرهاوي حدثني ابي عن ابيه عن زيد بن ابي انيسة وعبد الله بن علي عن عدي بن ثابت عن سالم بن ابي الجعد عن ابي امامة قال قال رسول الله صلي الله عليه وسلم ما من عبد يتوضا الا خرجت خطاياه من يديه ثم يغسل وجهه الا خرجت خطاياه من وجهه ثم يغسل ذراعيه الا خرجت خطاياه من ذراعيه ثم يمسح راسه الا خرجت خطاياه من راسه ثم يغسل رجليه الا خرجت خطاياه من رجليه حدثنا عبيد غنام ثنا ابو بكر بن ابي شيبة ثنا عبد الله بن نمير ثنا يزيد بن زياد بن ابي الجعد حدثني سلمة بن زياد عن زياد عن سالم بن ابي الجعد عن ابي امامة قال جاءت امراة الي النبي صلي الله عليه وسلم ومعها صبيان لها فسال النبي صلي الله عليه وسلم اهله فلم يجد الا ثلاث تمرات فاعطاها اياهن فاعطت كل صبي تمرة وامسكت واحدة فبكي صبيانها فاخذت تلك التمرة فشقتها نصفين فاعطت هذا نصفا وهذا نصفا فقال رسول الله صلي الله عليه وسلم حاملات والدات مرضعات رحيمات باولادهن لولا ما ياتين الي ازواجهن دخل مصلياتهن الجنة حدثنا محمد بن جابان الجنديسابوري ثنا محمود بن غيلان ثنا الفضل بن موسي ثنا يزيد بن زياد بن ابي الجعد عن سلمة بن ابي زياد عن سالم بن ابي الجعد عن ابي امامة قال جاءت امراة الي النبي صلي الله عليه وسلم معها صبيان لها صبي ترضعه فسالت النبي صلي الله عليه وسلم فطلب فلم يجد شيءا يعطيها حتي اصاب ثلاث تمرات عند بعض نساءه فاعطت هذا واحدا وهذا واحدا وامسكت تمرة فبكي احد الصبيين فشقت التمرة نصفين فاعطت هذا نصفا وهذا نصفا فقال رسول الله صلي الله عليه وسلم حاملات والدات مرضعات رحيمات باولادهن لولا ما ياتين الي ازواجهن لدخل مصلياتهن 
 الجنة حدثنا عبد الله بن احمد بن حنبل حدثني محمد بن خالد بن عبد الله الواسطي ثنا ابي عن حصين عن سالم بن ابي الجعد عن ابي امامة رضي الله عنه عن النبي صلي الله عليه وسلم انه قال الحمد لله عدد ما خلق الله والحمد لله عدد ما احصي كتابه والحمد لله عدد كل شء والحمد لله علي كل شء وسبحان الله علي كل شء وسبحان الله عدد كل شء * (عامر الشعبي عن ابي امامة) * حدثنا محمد بن محمد التمار ثنا علي بن ابي طالب البزاز ثنا موسي بن عمير عن الشعبي عن ابي امامة قال قال رسول الله صلي الله عليه وسلم خياركم من تعلم القران وعلمه * (فطر عن ابي امامة) * حدثنا احمد بن الحصر المروزي ثنا محمد بن الليث المروزي ثنا يحيي بن اسحاق الكاسعوني ثنا عبد الكبير بن دينار عن ابي اسحاق الهمداني عن فطر عن ابي امامة قال بينا النبي صلي الله عليه وسلم جالس اذا جاءت امراة معها ولدها تحلم بعضهم ويمشي بعضهم فسالت رسول الله صلي الله عليه وسلم فلم تساله يومءذ شيءا الا اعطاها لها فطلعت تمشي فقال رسول الله صلي الله عليه وسلم حاملات والدات رحيمات باولادهن لولا ما ياتين الي 
 ازواجهن دخل مصلياتهن الجنة * (سميع الزيات عن ابي امامة) * حدثنا علي بن عبد العزيز وابو مسلم الكشي قالا ثنا حجاج بن المنهال ح وحدثنا ابو مسلم ثنا ابو عمر الضرير قالا ثنا حماد بن سلمة عن عمرو بن دينار عن سميع عن ابي امامة ان رسول الله صلي الله عليه وسلم توضا فغسل كفيه ثلاثا ومضمض ثلاثا واستنشق ثلاثا وغسل وجهه ثلاثا وذراعيه ثلاثا ثلاثا واللفظ لحديث ابي عمر من روي عن ابي امامة من اهل البصرة * (الحكم بن فضالة عن ابي امامة) * حدثنا الحسين بن التستري ثنا محمد بن عبد الرحمن بن سهم الانطاكي ثنا ابو اسحاق ها عن الحجاج بن فرافصة عن قزعة عن الحكم بن فضالة قال سالت ابا امامة وذكر له اعمال الصدقة فقال الصدقة حق وعمالها في النار لقول رسول الله صلي الله عليه وسلم حدثنا اسحاق بن جميل الاصبهاني ثنا احمد بن منيع ثنا يزيد بن هارون انا قزعة بن سويد الباهلي عن ابيه عن حكم بن فضالة قال دخلت مسجد حمص فاذا فيه ابو امامة ينفلي فيه ويدفن القمل فيه فجلست اليه فسبح ثلاثا وكبر ثلاثا وحمد ثلاثا ثم قال خفيفات علي اللسان ثقيلات في الميزان تصعدن الي الرحمن فقلت يا ابا امامة انا من اهل البادية وان المصدقين كانوا يتعدون علينا فقال 
 الصدقة حق وتباعها في النار قول رسول الله صلي الله عليه وسلم قصر او تعدي الجديدي بالمال وافدا ولا تغيبوا منها فتخبثوا ما غيبتم واذا رايتموهم فلا تسبوهم واستعيذوا بالله من شرهم * (ابو العالية عن ابي امامة) * حدثنا محمد بن عثمان بن ابي شيبة ثنا عبيد بن يعيش ثنا يونس بن بكير ثنا يحيي بن ابي حبة عن ابي العالية قال سمعت ابا امامة يقول قال رسول الله صلي الله عليه وسلم ست من جاء بواحدة منهن جاء وله عهد يوم القيامة تقول كل واحدة منهن قد كان يعمل في الصلاة والزكاة والحج والصيام واداء الامانة وصلة الرحم * (لقيط ابو المشاء عن ابي امامة) * حدثنا محمد بن نصر بن حميد البغدادي ثنا محمد بن عبد الله الثوري ثنا يحيي بن راشد عن سعيد الجريري عن لقيط ابي المشاء عن ابي امامة قال كان لرسول الله صلي الله عليه وسلم فرس فوهبه لرجل من الانصار فكان يسمع صهيله ثم انه فقده فقال له رسول الله صلي الله عليه وسلم ما فعل فرسك قال يا رسول الله احصيته فقال الخيل في نواصيها الخير والمغنم الي يوم القيامة نواصيها دفاءها واذنابها مذابها حدثنا عبدان بن احمد ثنا بشر بن ادم ثنا محمد بن عبد الله الانصاري ثنا قرة بن خالد ثنا لقيط ابو المشاء حدثني ابو امامة في حديث رفعه الي رسول الله صلي الله عليه وسلم قال ما من مسلم يتوضا فيغسل يديه ويمضمض فاه 
 ويتوضا كما امر الا حط الله عنه ما اصاب يومءذ ما نطق به فمه وما مس يده وما مشي اليه حتي ان الخطايا تحادر من اطرافه ثم هو اذا مشي الي المسجد فرجل تكتب حسنة واخري تمحي سيءة * (الحسن البصري عن ابي امامة) * حدثنا احمد بن عبد الله البزاز التستري ثنا اسماعيل بن بشر بن منصور ثنا مسكين ابو فاطمة ثنا حوشب بن عقيل عن الحسن عن ابي امامة عن النبي صلي الله عليه وسلم قال ان الغسل يوم الجمعة ليستل الخطايا من اصول الشعر استلاة * (عاصم بن عمرو الاسماء عن ابي امامة الباهلي) * حدثنا موسي بن هارون وعبدان بن احمد قالا ثنا شيبان ابن فروح ثنا الصعق بن حزن ثنا السبخي عن عاصم بن عمرو الاسماء عن ابي امامة الباهلي قال قال رسول الله صلي الله عليه وسلم ليبيتن اقوام من امتي علي اكل ولهو ولعب ثم ليصبحن قردة وخنازير * (شعيب بن الحبحاب عن ابي امامة) * حدثنا محمد بن عبد الله الحضرمي ثنا سويد بن سعيد ثنا فضالة بن حصين عن شعيب بن الحبحاب عن ابي امامة قال صليت مع 
 رسول الله صلي الله عليه وسلم عشر سنين فكانت صلاته كل يوم عشر ركعات ركعتي الفجر وركعتين قبل الظهر وركعتين بعد المغرب وركعتين بعد العشاء * (عبد الله بن حفص عن ابي امامة) * حدثنا محمد بن علي بن شعيب السمسار ثنا خالد بن خداش ثنا حماد بن زيد عن عبد الله بن حفص عن ابي امامة قال قال رسول الله صلي الله عليه وسلم لابي ايوب بن زيد يا ابا ايوب الا ادلك علي عمل يرضاه الله ورسوله قال بلي قال تصلح بين الناس اذا تفاسدوا وتقارب بينهم اذا تباعدوا * (سيار الشامي كان ينزل البصرة عن ابي امامة) * حدثنا محمد بن يعقوب بن سورة البغدادي ثنا ابو الوليد الطيالسي ح وحدثنا احمد بن علي الابار البغدادي ثنا علي بن عثمان اللاحقي قالا ثنا عبد الله بن بجير القيسي عن سيار الشامي عن ابي امامة ان رسول الله صلي الله عليه وسلم قال يخرج من هذه الامة قوم معهم سياط كانها اذناب البقر يغدون في سخط الله ويروحون في غضبه حدثنا يوسف القاضي ثنا مسدد ثنا يزيد بن زريع ثنا سليمان التيمي عن سيار عن ابي امامة قال قال رسول الله صلي الله عليه وسلم ان الله عز وجل فضلني علي الانبياء او قال امتي علي الامم باربع ارسلني الي الناس كافة وجعل الارض كلها لي ولامتي طهورا ومسجدا فاينما 
 ادرك رجل من امتي الصلاة فعنده مسجده وعنده طهوره ونصرت بالرعب مسيرة شهر واحل لي الغناءم حدثنا عبيد بن غنام ثنا ابو بكر بن ابي شيبة ثنا يزيد بن هارون ثنا سليمان التيمي عن سيار عن ابي امامة عن النبي صلي الله عليه وسلم مثله * (ابو مليح بن اسامة الهذلي عن ابي امامة) * حدثنا محمد بن عثمان بن ابي شيبة ثنا احمد بن يونس ثنا فضيل بن عياض عن ليث عن ابي بردة عن ابي مليح عن ابي امامة قال قال رسول الله صلي الله عليه وسلم اتاني ربي السبع الطوال مكان التوراة والمءتين مكان الانجيل وفضلت بالمفصل حدثنا محمد بن اسحاق بن راهويه ثنا ابي ثنا جرير عن ليث عن ابي بردة عن ابي المليح بن اسامة عن ابي امامة عن النبي صلي الله عليه وسلم مثله * (يونس بن شعيب عن ابي امامة) * حدثنا محمد بن نوح بن حرب العسكري ثنا خالد بن يوسف السمتي ثنا عبد النور بن عبد الله ثنا يونس بن شعيب عن ابي امامة قال رايت رسول الله صلي الله عليه وسلم يشخص ببصره الي السماء قلنا يا رسول الله ما هذا قال رايت ملكا عرج بعمل سلمان حدثنا محمد بن نوح بن حرب العسكري ثنا خالد بن 
 يوسف السمتي ثنا عبد النور بن عبد الله ثنا يونس بن شعيب عن ابي امامة قال سمعت رسول الله صلي الله عليه وسلم يقول لعاءشة اشعرت ان الله عز وجل زوجني في الجنة مريم بنت عمران وكلثم اخت موسي وامراة فرعون حدثنا محمد بن نوح بن حرب العسكري ثنا خالد بن يوسف السمتي ثنا عبد النور بن عبد الله ثنا يونس بن شعيب عن ابي امامة عن النبي صلي الله عليه وسلم قال سال رجل النبي صلي الله عليه وسلم فقال يا رسول الله ما حق الزوج علي المراة قال لو ان امراة خرجت من بيتها ثم رجعت اليه فوجدت زوجها قد تقطع جذاما يسيل انفه دوما فلحسته بلسانها ما ادت حقه وما لامراة ان تخرج من بيت زوجها الا باذن زوجها ولا تعطي من بيت زوجها الا باذنه * (عبد الرحمن عن ابي امامة) * حدثنا العباس بن الفضل الاسفاطي ثنا مسدد ثنا يحيي ابن سعيد عن شعبة عن عبد الرحمن بن العداء عن ابي امامة ان رجلا ترك دينارا او دينارين فقال رسول الله صلي الله عليه وسلم كية اوكيتين * (ايمن عن ابي امامة * حدثنا محمد بن محمد التمار ثنا سهل بن بكار ثنا همام عن قتادة 
 عن ايمن عن ابي امامة قال قال رسول الله صلي الله عليه وسلم طوبي لمن راني وامن بي وطوبي لمن لم يرني وامن بي سبع مرات حدثنا عبد الله بن احمد بن حنبل ثنا هدبة بن خالد ثنا حماد ابن الجعد عن قتادة عن ايمن عن ابي امامة ان رسول الله صلي الله عليه وسلم قال طوبي لمن راني وامن بي وطوبي سبع مرات لمن امن بي ولم يرني * (ابو الجعد عن ابي امامة) * حدثنا عمر بن حفص السدوسي ثنا عاصم بن علي ثنا شعبة عن قتادة قال سمعت ابا الجعد مولي بني ضبيعة يحدث عن ابي امامة ان رجلا من اهل الصفة توفي وترك دينارا فقال رسول الله صلي الله عليه وسلم كية ضرر اخر وترك دينارين فقال النبي صلي الله عليه وسلم كيتان حدثنا ابراهيم بن هاشم البغوي ثنا عصام بن النضر ثنا معتمر بن سليمان قال سمعت ابي يحدث عن قتادة عن ابي الجعد او بن ابي الجعد عن ابي امامة ان رجلا اتي نبي الله صلي الله صلي الله عليه وسلم فقال يا رسول الله اشتريت مقسم فلان فربحت عليه كذا وكذا فقال الا انبءك بما هو اكثر ربحا قال وهل يوجد قال رجل تعلم ايات فذهب فتعلم عشر ايات فاتي النبي صلي الله عليه وسلم فاخبره حدثنا محمد بن جابان الجنديسابوري ثنا محمود بن غيلان ثنا النضر شميل ثنا شعبة عن ابي التياح عن ابي الجعد عن ابي امامة قال خرج علينا رسول الله ورجل يقص فسكت الرجل فقال النبي صلي الله عليه وسلم قص ولان اقعد هذا المقعد من حين تصلي الغداة الي ان تشرق 
 الشمس احب الي من ان اعتق اربع رقاب ولان اقعد من حين تصلي الي ان تغرب الشمس احب الي من ان اعتق اربع رقاب * (عبد الرحمن ابو يزيد عن ابي امامة) * حدثنا يحيي بن محمد الحناءي ثنا سيار بن فروخ ثنا عيسي ابن شعيب عن حفص بن سليمان عن يزيد بن عبد الرحمن عن ابيه عن ابي امامة قال قال رسول الله صلي الله عليه وسلم صناءع المعروف تقي مصارع السوء وصدقة السر تطفء غضب الرب وصلة الرحم تزيد في العمر حدثنا يحيي بن محمد الحناءي ثنا شيبان بن فروخ ثنا عيسي بن شعيب عن حفص بن سليمان عن يزيد بن عبد الرحمن عن ابيه عن ابي امامة قال قال رسول الله صلي الله عليه وسلم ان اهل المعروف في الدنيا هم اهل المعروف في الاخرة وان اول اهل الجنة دخولا الجنة اهل المعروف * (قزعة بن يحيي مولي زياد عن ابي امامة) * حدثنا حفص بن عمر السدوسي ثنا ابو بلال الاشعري ثنا المفضل بن صدقة ابو حماد الحنفي عن ابان بن ابي عياش عن ابي معشر التميمي عن قزعة مولي زياد عن ابي امامة الباهلي قال سمعت رسول الله صلي الله عليه وسلم يقول الصلاة المكتوبة تكفر ما قبلها الي الصلاة الاخري والجمعة تكفر ما قبلها الجمعة الاخري وشهر رمضان يكفر ما قبله الي شهر رمضان والحج يكفر ما قبله الي الحج ثم قال لا يحل لامراة مسلمة ان تحج الا مع زوج اوذي محرم 
 * (فضال بن جبير عن ابي امامة وقال محمد بن عرعرة فضال بن الزبير الغداني والصحيح فضال بن جبير) * حدثنا ابو مسلم الكشي ثنا محمد بن عرعرة البرند ثنا فضال بن الزبير ابو مهند الغداني قال سمعت ابا امامة صدي بن عجلان قال قال رسول الله صلي الله عليه وسلم يا ايها الناس اتقوا النار ولو بشق تمرة حدثنا ابو مسلم الكشي ثنا محمد بن عرعرة ثنا فضال بن الزبير عن ابي امامة قال قال رسول الله صلي الله عليه وسلم اكفلوا لي بست اكفل لكم الجنة اذا حدث احدكم فلا يكذب واذا وعد فلا يخلف واذا اءتمن فلا يخن وغضوا ابصاركم واحفظوا فروجكم وكفوا ايديكم حدثنا ابو مسلم الكشي ثنا محمد بن عرعرة ثنا فضال بن الزبير عن ابي امامة قال قال رسول الله صلي الله عليه وسلم ثلاث من كن في قلبه وجد حلاوة الايمان ان يكون الله ورسوله احب اليه مما سواهما وان يحب المرء لا يحبه الا لله وان لا يرجع في الكفر بعد ان انقذه الله منه كما يكره ان يلقي في النار حدثنا ابو مسلم الكشي ثنا محمد بن عرعرة ثنا فضال بن 
 الزبير عن ابي امامة قال قال رسول الله صلي الله عليه وسلم ايها الناس هلموا الي ربكم ان ما قل وكفي خير مما كثر والهي يا ايها الناس انما هما نجد خير ونجد شر فما جعل نجد الشر احب اليكم من نجد الخير حدثنا ابو مسلم الكشي ثنا محمد عرعرة ثنا فضال بن الزبير عن ابي امامة قال قال رجل يا رسول الله ما المسلم قال من سلم المسلمون من لسانه ويده حدثنا يحيي بن محمد الحناءي ومحمد بن خالد الراسبي قالا ثنا طالوت بن عباد ثنا فضال بن جبير ثنا ابو امامة قال قال رسول الله صلي الله عليه وسلم اول الايات طلوع الشمس من مغربها حدثنا يحيي بن محمد الحناءي ومحمد بن خالد الراسبي قالا ثنا طالوت بن عباد ثنا فضال بن جبير ثنا ابو امامة قال قال رسول الله صلي الله عليه وسلم ثلاث لو حلفت عليهن لبررت والرابعة لو حلفت عليها رجوت ان لا اثم ان لا يجعل الله من له سهم في الاسلام كمن لا سهم له ولا يتولي عبدا في الدنيا فيوليه غيره في الاخرة ولا عبد قوما الا بعثه الله معهم وبينهم والرابعة لا يستر الله علي عبد في الدنيا الا ستره يوم المعاد حدثنا محمد بن يحيي الحناءي ومحمد بن خالد الراسبي قالا ثنا طالوت بن عباد ثنا فضال بن جبير ثنا ابو امامة قال سالت ام هانء 
 رسول الله صلي الله عليه وسلم فقالت يا رسول الله اني امراة تفلت فعلمني دعوات ينفعني الله بهن قال قولي سبحان الله ماءة مرة تعدل ماءة رقبة تعتق لله عز وجل واحمدي الله ماءة مرة تعدل ماءة فرس ملجم يحمل عليها في سبيل الله وكبري الله ماءة مرة تعدل ماءة بدنة مقلدة تهدي الي بيت الله ووحدي الله ماءة مرة لا يدركك ذنب بعد الشرك حدثنا محمد بن خالد الراسبي ثنا عبد الواحد بن الصالح ثنا فضال بن جبير ثنا ابو امامة قال قال رسول الله صلي الله عليه وسلم لا تعجبوا بعمل عامل حتي تنظروا بما يختم له حدثنا احمد بن داود المكي ثنا حفص بن عمر المازني ثنا فضال بن جبير عن ابي امامة قال قال رسول الله صلي الله عليه وسلم من قرا حم الدخان في ليلة جمعة او يوم جمعة بني الله له بيتا في الجنة حدثنا احمد بن علي الابار البغدادي ثنا العباس بن الوليد النرسي ثنا هشام بن هشام الكوفي ثنا فضال بن جبير عن ابي امامة الباهلي قال كان رسول الله صلي الله عليه وسلم اذا مطرف وامسي دعا بهذه الدعوات اللهم انت احق من ذكر واحق من اعطي انت الملك لا شريك لك والفرد لا تهلك كل شء هالك الا وجهك لن تطاع الا بمقاومة ولم تعص الا بعلمك تطاع فتشكر وتعصي فتغفر اقرب شهيد وادني حفيظ حلت دون الثغور واخذت بالنواصي وكتبت الاثار ونسخت الاجال القلوب لك مفضية والسر عندك علانية والحلال ما احللت والحرام ما حرمت والدين ما شرعت والامر ما قضيت والخلق خلقك والعبد 
 عبدك وانت الله الرءوف الرحيم اسالك بنور وجهك الذي اشرقت له السماوات والارض بكل حق هو لك وبحق الساءلين عليك ان تقبلني في هذه الغداة او في هذه العشية وان تجيرني من النار بقدرتك * (ابو طالب الضبعي عن ابي امامة) * حدثنا علي بن عبد العزيز وابو مسلم الكشي قالا ثنا حجاج ابن المنهال ح وحدثنا يوسف بن يعقوب القاضي ثنا سليمان بن حرب قالا ثنا حماد ابن سلمة عن علي بن زيد عن ابي طالب الضبعي عن ابي امامة قال قال رسول الله صلي الله عليه وسلم لان اذكر الله من طلوع الفجر الي طلوع الشمس اكبر واهلل واسبح احب الي من ان اعتق اربع رقاب من ولد اسماعيل ولان اذكر الله من بعد صلاة العصر الي ان تغيب الشمس احب الي من ان اعتق كذا وكذا من ولد اسماعيل * (ابو حكيم عن ابي امامة) * حدثنا معاذ بن المثني ثنا مسدد ثنا حفص بن الصالح عن ليث عن حكيم بن ابي حكيم عن ابي امامة عن النبي صلي الله عليه وسلم قال من اطلع من سترة الي قوم ففقءت عينه فهي هدر حدثنا اسحاق بن داود الصواف التستري ثنا ابراهيم بن المستمر العروقي ثنا داود بن المحبر ثنا حفص بن الصالح عن ليث عن ابي حكيم عن ابي امامة قال قال رسول الله صلي الله عليه وسلم من اطلع علي قوم من 
 قترة ففقءت عينه فهي هدر قال حفص والقترة الكوة * (ابو الرصافة الشامي كان ينزل الكوفة عن ابي امامة) * حدثنا علي بن عبد العزيز ثنا ابو نعيم عن عمر بن ذر عن ابي الرصافة الشامي عن ابي امامة الباهلي عن النبي صلي الله عليه وسلم قال ما من مسلم يحضر صلاة مكتوبة فيحسن الوضوء ثم يصلي فيحسن الصلاة الا ورجاله الله بها ما بينها وبين الصلاة التي كانت قبلها من ذنوبه * (ابو مسلم شيخ من اهل الكوفة لم ينسب عن ابي امامة) * حدثنا اسحاق بن جميل الاصبهاني ثنا احمد بن منيع ثنا ابو احمد الزبيري ثنا ابان الاسماء حدثني ابو مسلم قال دخلت علي ابي امامة وهو يتفلي المسجد ويدفن القمل في الحصي فقلت يا ابا امامة ان رجلا حدثني عنك انك سمعت رسول الله صلي الله عليه وسلم يقول من توضا فاسبغ الوضوء غسل يديه ووجهه ومسح عري راسه واذنيه ثم قام الي صلاة مفروضة ورجاله الله له في ذلك اليوم ما مشت اليه رجلاه وقبضت عليه يداه وسمعت اليه اذناه ونظرت اليه عيناه وحدث به نفسه من سوء فقال والله لقد سمعته من النبي صلي الله عليه وسلم ما لا احصيه * (ابو غالب صاحب المحجن واسمه حزور) * حدثنا اسحاق بن ابراهيم الدبري عن عبد الرزاق عن معمر 
 عن ابي غالب قال لما اتي برءوس الازارقة فنصبت علي درج دمشق جاء ابو امامة فلما راهم دمعت عيناه ثم قال كلاب النار كلاب النار هءلاء شر قتلي تحت اديم السماء وخير قتلي تحت اديم السماء الذين قتلهم هءلاء قلت فما شانك دمعت عيناك قال رحمة لهم انهم كانوا من اهل الاسلام قال قلت ابرايك قلت كلاب النار ام شيءا سمعته من رسول الله صلي الله عليه وسلم قال اني اذا لجرء بل شيءا سمعته من رسول الله صلي الله عليه وسلم غير مرة ولا ثنتين ولا ثلاث فعدد مرارا ثم تلا يوم تبيض وجوه وتسود وجوه حتي بلغ فيها خالدون وتلا هو الذي انزل عليك الكتاب منه ايات محكمات حتي بلغ اولوا الالباب ثم اخذ بيدي فقال اما انهم بارضك كثير فاعاذك الله منهم حدثنا ابو خليفة الفضل بن الحباب ثنا احمد بن يحيي بن حميد الطويل ح وحدثنا محمد بن علي الاحمر الناقد البصري ثنا طالوت بن عباد قالا ثنا حماد بن سلمة ثنا ابو غالب قال كنت امشي مع ابي امامة وهو علي حمار له حتي انتهينا الي درج دمشق فاذا رءوس منصوبة فقال ما هذه الروس فقيل رءوس الخوارج جء بها من العراق فقال كلاب النار كلاب النار ثلاثا شر قتلي قتلت تحت السماء ثلاثا يقولها خير قتلي من قتله هءلاء ثلاثا يقولها طوبي لمن قتلهم وقتلوه ثلاثا يقولها ثم بكي فقلت ما يبكيك يا ابا امامة قال رحمة لهم انهم كانوا من اهل الاسلام فخرجوا من الاسلام ثم قرا هو الذي انزل عليك الكتاب منه ايات محكمات هن ام الكتاب حتي فرغ من الايات ثم قرا ولا تكونوا كالذين تفرقوا واختلفوا من بعد ما جاءهم البينات حتي بلغ ففي رحمة الله هم فيها خالدون فقلت يا ابا امامة هءلاء قال نعم قلت شيءا تقوله برايك ام شيءا سمع من رسول الله صلي الله عليه وسلم قال اني اذا لجرء 
 ثلاثا لقد سمعته من رسول الله صلي الله عليه وسلم لا مرة ولا اثنتين حتي عد سبعة ثم وضع اصبعه في اذنيه فقال والا فصمتا حدثنا محمد بن فضاء الجوهري ومحمد بن حيان المازني قالا ثنا محمد بن عبيد بن حساب ثنا حماد بن زيد ثنا ابو غالب قال كنت بالشام عروبة المهلب سبعين راسا من الخوارج فنصبوا علي باب المسجد وكنت علي ظهر بيت لفمر ابو امامة يريد المسجد فلما وقف عليهم دمعت عيناه فقال سبحان الله ما يفعل الشيطان ببني ادم ثلاثا قال كلاب جهنم شر قتلي تحت ظل السماء ثلاث مرات ثم قال خير قتلي تحت ظل السماء من قتلوه ثلاثا ثم التفت الي فقال يا ابا غالب انك بارض هءلاء بها كثير فاعاذك الله منهم هل تقرا السورة التي فيها ال عمران قلت بلي اني رايتك دمعت عيناك قال بكيت رحمة لهم كانوا من اهل الاسلام فتلا هو الذي انزل الكتاب منه ايات محكمات الي ان بلغ ابتغاء الفتنة وابتغاء تاويله وان هءلاء كان في قلوبهم زيغ فزيغ بهم ثم تلا ولا تكونوا كالذين تفرقوا الي ان بلغ اكفرتم بعد ايمانكم قلت هءلاء يا ابا امامة قال نعم قلت يا ابا امامة من قبل رايك تقول ام شيءا سمعته من رسول الله صلي الله عليه وسلم قال اني لجرء ثلاثا بل شء سمعته من رسول الله صلي الله عليه وسلم لا مرة ولا مرتين حتي بلغ ستة ثم قال ان بني اسراءيل تفرقت احدي وسبعين فرقة او قال اثنتين وسبعين فرقة وان هذه الامة ستزيد عليهم فرقة كلها في النار الا السواد الاعظم قلت يا ابا امامة الا تراهم ما يعملون قال عليهم ما حملوا وعليكم ما حملتم ان تطيعوه تهتدوا حدثنا بشر بن موسي ثنا القدرة ثنا سفيان ثنا ابو غالب قال رايت ابا امامة الباهلي ابصر رءوس الخوارج علي درج دمشق فقال 
 سمعت رسول الله صلي الله عليه وسلم يقول كلاب اهل النار كلاب اهل النار كلاب اهل النار ثم بكي وقال شر قتلي تحت اديم السماء وخير قتلي من قتلوه قال ابو غالب فقلت له انت سمعت هذا من رسول الله صلي الله عليه وسلم قال اني اذا لجرء سمعته من رسول الله صلي الله عليه وسلم غير مرة ولا مرتين ولا ثلاث حدثنا عمر بن حفص السدوسي والحسن بن التوكل قالا ثنا عاصم بن علي ثنا الربيع بن صبيح ثنا ابو غالب قال بينا انا بدمشق اذ جء بسبعين راسا من رءوس الخوارج فنصبت علي درج دمشق وجاء ابو امامة صاحب رسول الله صلي الله عليه وسلم فدخل المسجد فصلي ما بدا له فلما خرج بكي ثم قال كلاب اهل النار يقول الله عز وجل هو الذي انزل عليك الكتاب منه ايات محكمات هن ام الكتاب واخر متشابهات فاما الذين في قلوبهم زيغ فيتبعون ما تشابه منه ثم قرا يوم تبيض وجوه وتسود وجوه فاما الذين اسودت وجوههم اكفرتم بعد ايمانكم فذوقوا العذاب بما كنتم تكفرون فهم هءلاء فقلت يا ابا امامة هذا شء سمعته من رسول الله صلي الله عليه وسلم ام شيءا تقوله برايك قال اني اذا لجرء سمعته من رسول الله صلي الله عليه وسلم غير مرة ولا مرتين ولا ثلاث حتي انتهي الي سبع حدثنا يحيي بن محمد الحناءي ومحمد بن نوح بن حرب العسكري قالا ثنا شيبان بن فروخ ثنا سلام بن مسكين ثنا ابو غالب قال اتي برءوس حرورية فنصبت علي درج دمشق فنظر اليها ابو امامة وهي منصوبة فقال شر قتلي تحت السماء هءلاء ثلاثا طوبي لمن قتلهم وطوبي لمن قتلوه فقلت يا ابا امامة اشيءا تقوله برايك ام شيءا سمعته من رسول الله صلي الله عليه وسلم قال اني اذا لجرء ثلاثا سمعت من رسول الله صلي الله عليه وسلم يقول ذلك 
 حدثنا زكريا بن يحيي الساجي ثنا محمد بن موسي الحرشي ثنا جعفر بن سليمان عن ابي غالب عن ابي امامة عن النبي صلي الله عليه وسلم نحوه حدثنا يحيي بن محمد بن الحناءي ثنا عبيد الله بن معاذ ثنا ابي ثنا اشعب بن عبد الملك عن ابي غالب قال كنت بدمشق فوق ظهر بيت فمر بي ابو امامة فاتبعته فاذا نحن برءوس الخوارج علي درج المسجد منصوبة فقال شر قتلي تحت ظل السماء وخير قتلي من قتلوه قلت انت سمعت هذا من رسول الله صلي الله عليه وسلم قال اي ورب الكعبة اي ورب الكعبة مرارا ثم بكي فقلت اتبكي وقد قلت ما قلت قال اني ارحمهم قوم ارادوا شيءا فلم مراخ اما انك بارض هم بها كثير فاعاذك الله منه حدثنا محمد بن عبد الله الحضرمي ثنا يحيي بن ابراهيم بن محمد بن ابي عبيدة بن معن حدثني ابي عن ابيه عن جده عن الاعمش عن حسين الخراساني عن ابي غالب عن ابي امامة وذكر الخوارج فقال كلاب النار فقالوا اسمعت هذا من رسول الله صلي الله عليه وسلم قال اني اذا لجرء ان قلت ما لم اسمع حدثنا عبد الله بن وهب الغزي ثنا محمد بن ابي السري العسقلاني ثنا ابو قطن بن عبد الله الحراني ثنا ابو غالب عن ابي امامة رضي الله عنه قال قال رسول الله صلي الله عليه وسلم الخوارج كلاب اهل النار حدثنا علي بن سعيد الرازي ثنا عبد الله بن سعيد الكندي ثنا عبد الله بن عبد الله بن الاسود ابو عبد الرحمن الحارثي ثنا ابو خلدة عن 
 ابي غالب عن ابي امامة قال كنا نسمي اصحاب الاهواء كلاب النار حدثنا بن عمرو البزاز ثنا حوثرة بن محمد المنقري ثنا حماد ابن مسعدة عن عمران بن مسلم عن ابي غالب عن ابي امامة انه راي رءوس الخوارج فقال شر قتلي تحت ظل السماء قلت شيءا تقوله برايك سمعته من رسول الله صلي الله عليه وسلم قال لو لم اسمع من النبي صلي الله عليه وسلم الا مرة او مرتين او ثلاثا حتي بلغ سبعا ما حدثت به حدثنا ابراهيم هاشم ثنا محمد بن ابي بكر المقدمي ثنا عمر بن ابي خليفة ثنا ابو غالب عن ابي امامة عن رسول الله صلي الله عليه وسلم قال تخرجون من الاسلام كما يخرج السهم من الرمية لا ترجعون فيه حتي يرجع السهم علي فوقه كلاب النار حدثنا محمد بن الحسن بن جلس المصيصي ثنا مسلم بن ابراهيم ثنا حميد بن مهران قال سالت ابا غالب عن هذه الاية هو الذي انزل عليك الكتاب منه ايات محكمات هن ام الكتاب واخر متشابهات الي ابتغاء تاويله فقال حدثني ابو امامة عن رسول الله صلي الله عليه وسلم قال هم الخوارج وسالته عن هذه الاية فاما الذين اسودت وجوههم اكفرتم بعد ايمانكم فذوقوا العذاب بما كنتم تكفرون فقال حدثني ابو امامة عن رسول الله صلي الله عليه وسلم انهم الخوارج حدثنا اسحاق بن داود الصواف التستري ثنا المنذر بن الوليد الجارودي حدثني ثنا حميد بن مهران عن ابي غالب عن ابي امامة عن النبي صلي الله عليه وسلم في قول الله عز وجل يا ايها الذين امنوا لا تتخدوا بطانة من دونكم لا يالونكم خبالا ودوا ما عنتم قد بدت البغضاء من افواههم وما تخفي صدورهم اكبر قد بينا لكم الايات ان كنتم تعقلون قال هم الخوارج 
 حدثنا احمد بن زهير التستري ثنا عباد بن الوليد العنبري ثنا محمد بن عباد ثنا حميد الخياط عن زكريا بن يحيي صاحب القصب قال سالت ابا غالب عن قول لله عز وجل ربما يود الذين كفروا لو كانوا مسلمين فقال حدثني ابو امامة عن رسول الله صلي الله عليه وسلم انه قال نزلت في الي الخوارج حين راوا تجاوز الله عن المسلمين وعن الامة والجماعة قالوا يا ليتنا كنا مسلمين حدثنا عبد الله بن الحسين المصيصي ثنا محمد بن كثير ثنا بن شوذب ح وحدثنا محمد بن خالد الراسبي ثنا علي بن زيد الفراءضي ثنا محمد ابن كثير عن عبد الله بن شوذب عن ابي غالب قال خرجت مع ابي امامة الباهلي الي مسجد دمشق فلما كان عند الباب فاذا رءوس من رءوس الخوارج فلما نظر اليها بكي فقال ماذا صنع الشيطان ثلاثا كلاب النار ثلاثا ثم قال شر قتلي تحت ظل السماء ثلاثا من قتلوه كان خير قتيل تحت ظل السماء قلت يا ابا امامة انت تقوله او شء سمعته من رسول الله صلي الله عليه وسلم قال اني اذا لجرء هل تقرا الايات التي في اول ال عمران فاما الذين في قلوبهم زيغ فيتبعون ما تشابه منه في هءلاء انزلت حتي تقرا الاية التي في وسط ال عمران يوم تبيض وجوه وتسود وجوه في هءلاء انزلت قلت ما يبكيك يا ابا امامة قال انهم كانوا مءمنين او قال مسلمين حدثنا محمد بن موسي الاصطخري ثنا محمد بن سهل بن مخلد الباهلي الاصطخري ثنا عصمة بن المتوكل الاصطخري ثنا مبارك بن فضالة عن ابي غالب قال كنت بالشام وبها ابو امامة صدي بن عجلان صاحب النبي صلي الله عليه وسلم وكان لي صديقا فجء برءوس الحرورية فذكر عن النبي صلي الله عليه وسلم نحوه 
 حدثنا علي بن عبد العزيز ثنا داود بن عمرو الضبي ثنا ابو شهاب عبد ربه بن نافع عن عمرو بن قيس الملاءي عن داود بن السليك عن ابي غالب قال كنت بدمشق زمن عبد الملك فاتي برءوس الخوارج فنصبت علي اعواد فجءت لانظر هل فيها احد اعرفه فاذا ابو امامة عندها فدنوت منه فنظرت الي الاعواد فقال كلاب النار ثلاث مرات شر قتلي تحت اديم السماء ومن قتلوه خير قتلي تحت اديم السماء قالها ثلاث مرات ثم استبكي فقلت يا ابا امامة ما يبكيك كانوا علي ديننا ثم ذكرت ما هم صاءرون اليه غدا فقلت له شيءا تقوله برايك ام شيءا سمعته من رسول الله صلي الله عليه وسلم فقال اني لو لم اسمعه من رسول الله صلي الله عليه وسلم الا مرة او مرتين او ثلاثا الي السبع ما حدثتكموه اما تقرا هذه الاية في ال عمران يوم تبيض وجوه وتسود وجوه الي اخر الاية واما الذين ابيضت وجوههم ففي رحمة الله هم فيها خالدون ثم قال اختلفت اليهود علي احدي وسبعين فرقة سبعين من النار وواحدة في الحنة واختلفت النصاري علي اثنتين وسبعين فرقة احدي وسبعون فرقة في النار وواحدة في الجنة وتختلف هذه الامة علي ثلاث وسبعين فرقة اثنتان وسبعون في النار وواحدة في الجنة فقلنا انعتهم لنا قال السواد الاعظم حدثنا الحسين بن اسحاق التستري ثنا يحيي الحماني ثنا شريك عن داود بن ابي السليك عن ابي غالب عن ابي امامة عن النبي صلي الله عليه وسلم نحوه حدثنا يوسف القاضي ثنا عبد الرحمن بن المبارك العيشي ثنا قريش بن حيان ثنا ابو غالب عن ابي امامة رضي الله عنه قال قال رسول الله صلي الله عليه وسلم تفرقت بنو اسراءيل علي ثنتين وسبعين 
 فرقة وستفترق هذه الامة علي ما تفرقت عليه بنو اسراءيل تزيد فرقة كلها في النار الا السواد فقلنا يا ابا امامة اوليس في السواد ما يكفيه قال والله انا لننكر ما تعملون حدثنا العباس بن الفضل الاسفاطي ثنا سعيد بن سليمان النشيطي ثنا سلم بن زرير عن ابي غالب عن ابي امامة قال سمعت رسول الله صلي الله عليه وسلم يقول افترقت بنو اسراءيل علي احدي وسبعين فرقة تزيد عليها امتي فرقة كلها في النار الا السواد الاعظم حدثنا عبد الله بن احمد بن حنبل حدثني خلاد بن اسلم ثنا النضر بن شميل حدثني قطن بن كعب ابو الهيثم ثنا ابو غالب قال جاءت رءوس الازارقة سبعين راسا فاقيموا علي درج دمشق سبعة ايام فمضت ثلاثة ايام من السبعة وكان اليوم الرابع فجاء ابو امامة فركع ركعتين عند سارية وقال كلاب النار ثلاثا شر قتلي تحت ظل السماء خير قتلي تحت ظل السماء من قتلوه فقلت يا ابا امامة اشء سمعته من رسول الله صلي الله عليه وسلم ام شء تقوله من قبل نفسك فقال اني اذا لجرء لا بل سمعته من رسول الله صلي الله عليه وسلم لا مرة ولا مرتين حتي بلغ سبعا حدثنا ابو الدحداح احمد بن محمد بن اسماعيل العدوي الدمشقي ثنا موسي بن عامر ابو عامر ثنا الوليد بن مسلم ثنا خليد بن دعلج ثنا ابو غالب قال جء برءوس الخوارج فنصبت علي درج دمشق فجعل الناس ينظرون اليها وخرجت انا انظر اليها فجاء ابو امامة علي حمار وعليه قميص سنبلاني فنظر اليهم فقال ما صنع الشيطان بهذه الامة يقولها ثلاثا شر قتلي تحت ظل السماء هءلاء خير قتلي تحت ظل السماء من قتله هءلاء كلاب النار يقولها ثلاثا ثم بكي ثم انصرف فقال ابو غالب فاتبعته فقلت سمعتك تقول قولا قبل افانت قلته قال سبحان الله اني اذا لجرء بل سمعت ذلك من رسول 
 الله صلي الله عليه وسلم مرارا قلت له رايتك تبكي فقال رحمة لهم كانوا من اهل الاسلام مرة ثم قال لي اما تقرا قلت بلي قال فاقرا من ال عمران فقرات فقال اما تسمع الله يقول فاما الذين في قلوبهم زيغ فيتبعون ما تشابه منه كان في قلوب هءلاء زيغ فزيغ بهم اقرا عند راس المءة فقرات حتي اذا بلغت يوم تبيض وجوه وتسود وجوه فاما الذين اسودت وجوههم اكفرتم بعد ايمانكم فقلت يا ابا امامة انهم هءلاء قال نعم فهم هءلاء لم يرو هذا الحديث عن خليد بن دعلج الا الوليد حدثنا علي بن عبد العزيز وابو مسلم الكشي قالا ثنا حجاج بن المنهال ثنا حماد بن سلمة ثنا ابو غالب عن ابي امامة ان رسول الله صلي الله عليه وسلم اقبل من خيبر ومعه غلامان فوهب احدهما لعلي بن ابي طالب وقال لا تضربه فاني نهيت عن ضرب اهل الصلاة واني قد رايته يصلي واعطي ابا ذر غلاما وقال استوص به معروفا فاعتقه فقال النبي صلي الله عليه وسلم ما فعل الغلام الذي اعطيتك قال امرتني ان استوصي به معروفا فاعتقته حدثنا احمد بن داود المكي ثنا مسلم بن ابراهيم ثنا مبارك ابن فضالة عن ابي غالب عن ابي امامة عن النبي صلي الله عليه وسلم قال يخرج من النار بشفاعة رجل من امتي اكثر من ربيعة ومضر حدثنا احمد بن موسي الجوهري البغدادي ثنا الحسن بن حريث المروزي ثنا الفضل بن موسي عن الحسين بن حكي عن ابي غالب عن ابي امامة قال قال رسول الله صلي الله عليه وسلم يدخل الجنة بشفاعة رجل من امتي اكثر من عدد مضر ويشفع الرجل في اهل بيته ويشفع علي قدر عمله 
 حدثنا اسحاق بن ابراهيم الدبري عن عبد الرزاق عن معمر عن ابي غالب قال سالت ابا امامة عن النافلة قال كانت للنبي صلي الله عليه وسلم نافلة ولكم فضيلة حدثنا محمد بن الفضل السقطي ثنا سعيد بن سليمان عن عقبة عن ابي الصهباء ثنا ابو غالب قال سمعت ابا امامة يقول ما من مسلم يسمع اذانا فقام الي وضوءه الا ورجاله له في اول قطرة يصب كفه من ذلك الماء فبعد ذلك القطر يغفر الله له ما سلف من ذنوبه فيقوم الي صلاته وهي نافلة قلت انت سمعت هذا من رسول الله صلي الله عليه وسلم يا ابا امامة قال والذي بعثه بالحق بشيرا ونذيرا غير مرة ولا مرتين ولا ثلاثا ولا اربعا ولا عشرا وطبق بيده حدثنا سليمان بن الحسن العطار البصري ثنا محمد بن عبد الملك الواسطي ثنا يزيد بن هارون ثنا سليمان بن حيان ثنا ابو غالب قال سمعت ابا امامة يقول اذا وضعت الطهور مواضعه قعدت مغفورا لك فان كنت تصلي كانت لك فضيلة واجرا وان قعدت قعدت مغفور لك فقال له رجل يا ابا امامة ارايت ان قام فصلي يكون له نافلة وهو يشقي في الذنوب والخطايا يكون لك فضيلة واجرا حدثنا محمد بن عبد الله الحضرمي ثنا يحيي بن ابراهيم ابن محمد بن ابي عبيدة بن معن حدثني ابي عن ابيه عن جده عن الاعمش عن حسين الخراساني عن ابي غالب عن ابي امامة قال قال رسول الله صلي الله عليه وسلم ما من مسلم يتوضا فيضع وضوءه مواضعه الا خرجت خطاياه من سمعه وبصره وبدنه ورجليه وكانت صلاته له فضلا 
 حدثنا محمد بن النضر الازدي ثنا خالد خداش ح وحدثنا عمر بن حفص السدوسي ثنا عاصم بن علي ح وحدثنا ابو خليفة الفضل بن الحباب الجمحي ثنا ابو الوليد الطيالسي قالوا ثنا عمارة بن زاذان عن ابي غالب عن ابي امامة ان رسول الله صلي الله عليه وسلم كان يوتر بتسع ركعات فلما بدن وكثر عليه اللحم اوتر بسبع ركعات وصلي ركعتين وسجدتين وهو جالس يقرا فيهما ب اذا زلزلت و قل يا ايها الكافرون وقل هو الله احد حدثنا معاذ بن المثني ثنا مسدد ح وحدثنا جعفر بن محمد الفريابي ثنا داود بن معاذ المصيصي قالا ثنا عبد الوارث بن سعيد عن عبد العزيز بن صهيب عن ابي غالب عن ابي امامة ان رسول الله صلي الله عليه وسلم كان يصلي ركعتين بعد الوتر وهو جالس يقرا فيهما اذا زلزلت وقل يا ايها الكافرون حدثنا محمد بن عبد الله الحضرمي ثنا عقبة بن مكرم ثنا يونس بن بكير ثنا ابو قبيصة عن ابي غالب عن ابي امامة قال كان رسول الله صلي الله عليه وسلم يوتر بتسع فلما ثقل اوتر بسبع حدثنا عبيد بن غنام ابو بكر بن ابي شيبة ثنا عبد الله بن نمير ويعلي بن عبيد ح وحدثنا احمد بن خليد الحلبي ثنا ابو توبة الربيع بن نافع ثنا ابو خالد الاحمر ح وحدثنا جعفر بن محمد الفريابي ثنا اسحاق بن راهويه ثنا عيسي بن يونس كلهم عن الحجاج بن دينار عن ابي امامة عن النبي صلي الله عليه وسلم قال ما ضل قوم بعد هدي كانوا عليه الا اوتوا جدلا ثم قرا ما ضربوه لك الا جدلا بل هم قوم خصمون 
 حدثنا العباس بن الفضل الاسفاطي ثنا جهور بن سفيان ابو الحارث الجرموزي ثنا ابي ثنا ابو غالب عن ابي امامة قال سمعت رسول الله صلي الله عليه وسلم يقول اذا مررتم علي ارض قد اهلك اهلها فاعدوا السير حدثنا ابراهيم بن هاشم البغوي ثنا محمد بن ابي بكر المقدمي ثنا جهور بن سفيان حدثني ابي عن ابي غالب عن ابي امامة ان رسول الله صلي الله عليه وسلم قال اذا مررتم بارض قد اهلك الله اهلها فاجدوا السير حدثنا عبيد بن غنام ثنا ابو بكر بن ابي شيبة ح وحدثنا محمد بن يحيي المروزي ثنا ابراهيم بن عبد الله الهروي قالا ثنا زيد بن الحباب ثنا عمر بن سليم الباهلي عن ابي غالب عن ابي امامة قال كان رسول الله صلي الله عليه وسلم اذا توضا خلل لحيته حدثنا الحسين بن اسحاق التستري ثنا سهل بن عثمان ثنا زيد بن الحباب عن الصلت بن دينار عن ابي غالب عن ابي امامة ان رسول الله صلي الله عليه وسلم توضا بنصف الفساد حدثنا عبيد بن غنام ثنا ابو بكر بن ابي شيبة ح وحدثنا الحسين بن اسحاق التستري ثنا سهل بن عثمان قالا ثنا 
 عبد الله بن نمير عن مسعر بن كدام عن ابي العنبس عن ابي العدبس عن ابو الاستثناء عن ابي غالب عن ابي امامة قال خرج علينا رسول الله صلي الله عليه وسلم وهو يتوكا علي عصا فلما رايناه قمنا اليه فقال لا تفعلوا كما تفعل الاعاجم يقوم بعضها لبعض فقلنا اشتهينا ان تدعو لنا فقال اللهم اغفر لنا وارحمنا وارض عنا وتقبل منا وادخلنا الجنة ونجنا من النار واصلح شاننا كله قال فاننا اشتهينا ان تزيدنا فقال اوليس قد جمعن الخير حدثنا عبد الله بن احمد بن حنبل حدثني عبد الله بن سلمة ابن عياش العامري حدثني صدقة بن هرم القسملي عن ابي غالب عن ابي امامة قال بعثني رسول الله صلي الله عليه وسلم الي قومي فانتهيت اليهم وانا طاو فانتهيت اليهم وهو ياكلون دما فقلت انما جءت انهاكم عن هذا فوضعت راسي فقمت وانا مغلوب فاتاني ات في منامي باناء فيه شراب فقال خذ هذا واشرب ثم كظني بطني فشبعت ثم رويت فسمعتهم يقولون اتاكم رجل من سراة قومكم قلم تنجعوه بالمذيقة فاتوني بمذيقتهم فقلت لا حاجة لي فيها ان الله اطعمني وسقاني فاريتهم بطني فاسلموا عن اخرهم حدثنا زكريا بن يحيي الساجي وعبد العزيز بن محمد بن عبد الله بن عبيد بن عقيل المقرء قالا ثنا محمد بن عبد الملك بن ابي الشوارب ثنا بشير بن سريج ثنا ابو غالب عن ابي امامة قال بعثني رسول الله صلي الله عليه وسلم الي قومي ادعوهم الي الله عز وجل وعرض عليهم شراءع الاسلام فاتيتهم وقد سقوا ابلهم واحتلبوها وشربوا فلما راوني قالوا 
