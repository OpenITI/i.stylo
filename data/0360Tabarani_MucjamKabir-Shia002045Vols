 بن الزبير عن اسماء بنت ابي بكر قالت رقي النبي صلي الله عليه وسلم المنبر فقال ايها الناس ان الشمس والقمر ايتان من ايات الله لا تنخسفان لموت احد ولا لحياته فاذا رايتم ذلك فافزعوا الي الصلاة والصدقة والي ذكر الله وقد رايت منكم خمسين الفا او سبعين الفا شك فليح يدخلون الجنة بغير حساب مثل صورة القمر ليلة البدر فقام رجل فقال ادع الله ان يجعلني منهم فقال اللهم اجعله منهم ايها الناس لن تسالوني عن شء انزل الا اخبرتكم به فقام رجل فقال من ابي فقال ابوك فلان لابيه الذي كان ينسب اليه وهب بن جلس ابو نعيم عن اسماء  حدثنا عبد الله بن احمد بن حنبل حدثني محمد بن ابي بكر المقدمي ثنا حميد بن الاسود ثنا الضحاك بن عثمان حدثني وهب بن جلس قال سمعت اسماء بنت ابي بكر تقول دخل علي النبي صلي الله عليه وسلم وانا اكيل شيءا واعد فقال يا اسماء لا تحصي فيحصي الله عليك قالت اسماء فما احصيت بعد ذلك اليوم شيءا خلقه الله ولا عددته بعد يومي المطلب بن عبد الله بن حنطب عن اسماء  حدثنا مصعب بن ابراهيم بن حمزة الزبيري ثنا ابي ثنا سفيان بن حمزة عن كثير بن زيد عن المطلب بن عبد الله بن حنطب 
 عن اسماء بنت ابي بكر ان النبي صلي الله عليه وسلم قال لا تحصي فيحصي عليك مجاهد بن جبر عن اسماء بنت ابي بكر  حدثنا عبيد بن غنام ثنا ابو بكر بن ابي شيبة ثنا محمد بن فضيل عن يزيد بن ابي زياد عن مجاهد قال قال بن الزبير افردوا الحج ودعوا قول اعمالكم فقال عبد الله بن عباس ان الذي اعمي الله قلبه انت الا تسال امك عن هذا فارسل اليها فقالت صدق عبد الله بن عباس خرجنا مع رسول الله صلي الله عليه وسلم حجاجا فجعلناها عمرة فحللنا الاحلال كله حتي سطعت المجامر بين الرجال  والنساء حدثنا الحسين بن اسحاق التستري ثنا عثمان بن ابي شيبة ثنا جرير عن يزيد بن ابي زياد عن مجاهد قال قال بن الزبير افردوا الحج ولا تسمعوا قول اعماكم فقال بن عباس ان الذي اعمي الله قلبه انت ارسل الي امك فسلها فارسلوا الي اسماء فقالت صدق بن عباس قدمنا حجاجا فامر رسول الله صلي الله عليه وسلم ان نحل فاحللنا الحل كله حتي سطعت المجامر بين الرجال والنساء ما روي بن ابي مليكة عن اسماء ايوب عن بن ابي مليكة  حدثنا اسحاق بن ابراهيم الدبري عن عبد الرزاق 
 عن معمر عن ايوب عن بن ابي مليكة ان اسماء بنت ابي بكر قالت يا رسول الله ما لي شء الا ما ادخل علي الزبير افانفق منه فقال رسول الله صلي الله عليه وسلم انفقي ولا توكي فيوكي عليك  حدثنا عبد الله بن احمد بن حنبل ثنا محمد بن ابي بكر المقدمي ثنا حماد بن زيد عن ايوب عن بن ابي مليكة عن اسماء بنت ابي بكر قالت فقلت يا رسول الله ليس لي مال الا ما ادخل علي الزبير بيته فقال يا اسماء اعطي وتصدقي ولا توكي فيوكي عليك  حدثنا احمد بن عمرو اسمع المكي ثنا محمد بن ابي عمر العدني ثنا عبد الوهاب الثقفي عن ايوب عن بن ابي مليكة قال حدثتني اسماء بنت ابي بكر قالت قلت يا رسول الله والله ما لي الا مما ادخل علي الزبير بيته فاعطي قال لا توكي فيوكي عليك  حدثنا احمد بن عمرو اسمع المكي ثنا محمد بن ابي عمر العدني ثنا سفيان عن ايوب عن بن ابي مليكة عن اسماء بنت ابي بكر ان النبي صلي الله عليه وسلم قال لا توكي فيوكي عليك  حدثنا معاذ بن المثني حدثنا مسدد ثنا اسماعيل بن ابراهيم ثنا ايوب عن عبد الله بن ابي مليكة قال حدثتني اسماء بنت ابي بكر قالت قلت يا رسول الله ما لي شء الا ما ادخل الزبير بيته افاعطي منه قال اعطي ولا توكي فيوكي عليك 
  حدثنا محمد بن فضاء الجوهري ثنا محمد بن عبيد بن حساب ثنا حماد بن زيد عن ايوب عن بن ابي مليكة عن اسماء بنت ابي بكر قالت كنت اخدم الزبير وكان له فرس وكنت اسوسه فلم يكن من الخدمة شء اشد علي من سياسة الفرس كنت احتش له واقوم عليه ثم اني اصبت خادما جاء النبي صلي الله عليه وسلم سبي فاعطاني خادما وكفتني سياسة الفرس فالقت عني مءنته نافع بن عمر عن بن ابي مليكة  حدثنا يحيي بن ايوب العلاف وعمرو بن ابي الطاهر بن السرح المصريان قالا ثنا سعيد بن ابي مريم ثنا نافع بن عمر عن بن ابي مليكة عن اسماء بنت ابي بكر قالت قال رسول الله صلي الله عليه وسلم اني علي حوضي حتي انظر من يرد عليكم مني وسيرد اناس دوني فاقول يا رب امتي امتي فيقول شعرت ما عملوا بعدك والله ما زالوا يرجعون علي اعقابهم فكان بن ابي مليكة يقول اللهم انا نعوذ بك ان نرجع علي اعقابنا او نغير ديننا  حدثنا يحيي بن ايوب وعمرو بن ابي الطاهر شوال ان رسول الله صلي الله عليه وسلم صلي صلاة الكسوف فقام فاطال القيام ثم ركع فاطال الركوع ثم رفع فسجد فاطال السجود ثم رفع 
 فسجد فاطال السجود ثم انصرف فقال قد قربت مني الجنة حتي لو اني اخترات عليها لجءتكم بقطاف من قطافها ودنت مني النار حتي قلت اي رب وانا معهم فاذا امراة حسناء تخدشها هرة فقلت ما شان هذه قالوا حبستها حتي ماتت جوعا لا اطعمتها ولا ارسلتها تاكل قال نافع حسبت قال من حشيش او حشاءش الارض  حدثنا يحيي بن ايوب العلاف ثنا سعيد بن ابي مريم انا نافع بن عمر عن بن ابي مليكة قال قالت اسماء بنت ابي بكر يا رسول الله ليس لي مال الا ما يدخل الزبير بيته افارضخ منه قال ارضخي بما استطعت ولا توكي فيوكي الله عليك حماد بن يحيي الابح عن بن ابي مليكة  حدثنا عبد الله بن احمد بن حنبل ثنا محمد بن ابي بكر المقدمي ثنا حماد بن يحيي عن بن ابي مليكة عن اسماء بنت ابي بكر قالت سالت رسول الله صلي الله عليه وسلم قلت ليس لي مال الا شء يدخله الزبير قال ارضخي ولا توكي فيوكي عليك جميل بن عنبسة ابو النضر البصري عن بن ابي مليكة  حدثنا عبدان بن احمد ثنا طالوت بن عباد ثنا جميل بن عنبسة ابو النضر قال سمعت عبد الله بن ابي مليكة يحدث عن اسماء بنت ابي بكر قالت قلت يا رسول الله ليس لي مال فارضخ الا ما ادخل بيتي الزبير فقال رسول الله صلي الله عليه وسلم يا اسماء ارضخي ولا توكي فيوكي عليك 
 محمد بن سليم المكي وعبد الجبار بن الورد عن بن ابي مليكة  حدثنا احمد بن عمرو اسمع المكي ثنا محمد بن ابي عمر العدني ثنا وكيع بن الجراح عن محمد بن سليم المكي وعبد الجبار بن الورد عن بن ابي مليكة عن اسماء بنت ابي بكر قالت سالت النبي صلي الله عليه وسلم فقلت ياتيني الساءل فاتصدق عليه من بيت الزبير من غير اذنه فقال رسول الله صلي الله عليه وسلم ارضخي ولا توكي فيوكي عليك الحجاج بن ارطاة عن بن ابي مليكة  حدثنا علي بن عبد العزيز ثنا معلي بن مهدي الاتي ثنا هشيم قال انا الحجاج بن ارطاة عن بن ابي مليكة عن اسماء بنت ابي بكر قالت قلت يا رسول الله ما يحل لي من مال الزبير قال الرطب يعني الطعام  حدثنا شعيب بن عمران العسكري ثنا عبدان بن محمد العسكري ثنا يحيي بن زكريا بن ابي زاءدة عن حجاج ثنا بن ابي مليكة عن اسماء بنت ابي بكر ان النبي صلي الله عليه وسلم قال دخلت امراة النار في هرتها 
 خالد ابو عقيل عن اسماء  حدثنا ابو الزنباع روح بن الفرج وعمرو بن ابي الطاهر بن السرح المصريان قالا ثنا ابو زيد عبد الرحمن بن ابي الغمر ثنا ضمام بن اسماعيل عن عقيل بن خالد ان اباه كان مع الحجاج لما قتل بن الزبير فبعثه الي اسماء بنت ابي بكر فقال قل لها يقول لك الحجاج اعزلي ما كان لك من مال عن مال عبد الله بن الزبير فقالت افعلها بابن اسماء سمعت رسول الله صلي الله عليه وسلم يقول يخرج من هذا الحي من ثقيف رجلان احدهما يكذب والاخر مبير فاما الكذاب فقد عرفناه وما احسبه الا المبير فرجعت اليه فاخبرته فلم يكره ذلك عبد الله مولي اسماء عن اسماء  حدثنا اسحاق بن ابراهيم الدبري انا عبد الرزاق انا معمر ثنا عبد الله بن مسلم اخو الزهري عن مولي لاسماء بنت ابي بكر عن اسماء قالت سمعت رسول الله صلي الله عليه وسلم يقول من كان يءمن منكن بالله واليوم الاخر فلا ترفع راسها حتي نرفع رءوسنا ان يرين عورات الرجال لقصر ازرهم وكانوا اذ ذاك ياتزرن هذه النمرة 
  حدثنا محمد بن العباس المءدب ثنا عفان بن مسلم ثنا وهيب بن خالد عن النعمان بن راشد عن عبد الله بن مسلم عن مولي لاسماء بنت ابي بكر قالت قال رسول الله صلي الله عليه وسلم يا معشر النساء من كان منكن تءمن بالله واليوم الاخر فلا ترفع امراة راسها حتي يرفع الرجال رءوسهم وذلك ان ازرهم كانت قصيرة مخافة ان تنكشف عوراتهم  حدثنا احمد بن عمرو اسمع المكي ثنا محمد بن ابي عمر العدني ثنا سفيان ثنا اخو الزهري اخبرني من سمع اسماء بنت ابي بكر تقول قال رسول الله صلي الله عليه وسلم يا معشر المءمنات لا ترفع امراة راسها قبل ان يرفع الامام راسه من ضيق ثياب الرجال  حدثنا عبد الله بن احمد بن حنبل حدثني محمد بن ابي بكر المقدمي ثنا وهيب بن جرير ثنا ابي قال سمعت النعمان بن راشد يحدث عن الزهري عن مولي لاسماء بنت ابي بكر عن اسماء انها سمعت رسول الله صلي الله عليه وسلم يقول للنساء علي المنبر من كانت منكن تءمن بالله واليوم الاخر فلا ترفع راسها حتي يرفع الرجال رءوسهم قالت لانه كانت بينهم حادة فيلبسون ثيابا تقصر عنهم فتبدو عوراتهم  حدثنا علي بن عبد العزيز ثنا ابو نعيم ثنا عبد السلام 
 بن حرب عن عبد الملك بن سليمان عن عطاء عن ابي عبيد الله او عبد الله مولي اسماء بنت ابي بكر انها اخرجت اليه جبة طيالسة من ديباج فقالت هذه جبة رسول الله صلي الله عليه وسلم فلما قبض كانت عند عاءشة فلما قبضت عاءشة اخذتها فهي عندي تغسلها للمريض يستشفي بها  حدثنا عبيد بن غنام ثنا ابو بكر بن ابي شيبة ثنا ابو خالد الاحمر عن يحيي بن سعيد عن عطاء عن مولي لاسماء قال جءنا مع اسماء الي مني بليل فقالت قد كنا نفعل ذلك مع من هو خير منك تعني النبي صلي الله عليه وسلم  حدثنا الحسين بن اسحاق التستري ثنا عثمان بن ابي شيبة ثنا ابو خالد الاحمر عن حجاج بن ارطاة عن ابي عمر عن اسماء بنت ابي بكر انها اخرجت جبة مزرورة بالديباج فقالت كان رسول الله صلي الله عليه وسلم يلبس هذه في الحرب  حدثنا عبد الله بن احمد بن حنبل حدثني محمد بن ابي بكر المقدمي ثنا عبد الواحد بن زياد عن الحجاج ثنا ابو عمر ختن عطاء عن اسماء عن النبي صلي الله عليه وسلم بمثله  حدثنا عبيد بن غنام ثنا ابو بكر بن ابي شيبة ثنا عبد الرحيم بن سليمان عن حجاج عن ابي عمر عن اسماء عن النبي صلي الله عليه وسلم بمثله 
  حدثنا احمد بن عمرو اسمع المكي ثنا محمد بن ابي عمر العدني ثنا سفيان بن عيينة عن بن جريج قال اخبرني عبد الله مولي اسماء عن اسماء انها قالت ليلة جمع اي بني هل غاب القمر وهي تصلي وقد نزلت عند المزدلفة فقلت لا فصلت شيءا ثم قالت اي بني هل غاب القمر قال وقد غاب القمر قلت نعم فقالت فارتحلوا فارتحلنا ثم مضينا بها حتي رمت الجمرة ثم رجعت فصلت الصبح في منزلها فقلت لها اي هنتاه لقد غلست فقالت اي بني ان نبي الله صلي الله عليه وسلم اذن للظعن  حدثنا معاذ بن المثني ثنا مسدد ثنا يحيي بن سعيد عن بن جريج عن عبد الله مولي اسماء مثله القاسم بن محمد الثقفي عن اسماء  حدثنا علي بن عبد العزيز ثنا داود بن عمرو الضبي ثنا اسماعيل بن زكريا عن يزيد بن ابي زياد عن قيس بن الاحنف الثقفي عن القاسم بن محمد قال جاءت اسماء مع جواري لها وقد ذهب بصرها فقالت اين الحجاج فقلنا ليس ههنا قالت فمروه فليامر لنا بهذه العظام فاني سمعت رسول الله صلي الله عليه وسلم ينهي عن المثلة قلنا اذا جاء قلنا له قالت فاذا جاء فاخبروه اني سمعت رسول الله صلي الله عليه وسلم يقول يخرج في ثقيف كذاب ومبير 
 يعلي بن حرملة ابو ابي المحياة عن اسماء  حدثنا عبيد بن غنام ثنا ابو بكر بن ابي شيبة ثنا يحيي بن يعلي الاسلمي ابو المحياة عن ابيه يعلي بن حرملة ح وحدثنا علي بن عبد العزيز ثنا احمد بن يونس ثنا ابو المحياة عن ابيه قال قدمت مكة بعدما صلب او قتل بن الزبير بثلاثة ايام فكلمت امه اسماء بنت ابي بكر الحجاج فقالت اما ان لهذا الراكب ان ينزل قال المنافق قالت لا والله ما كان منافقا ولقد كان صواما قواما قال اسكتي فانك عجوز قد خرفت قالت ما خرفت منذ سمعت رسول الله صلي الله عليه وسلم يقول يخرج من ثقيف كذاب ومبير فاما الكذاب فقد رايناه تعني المختار واما المبير فانت زاد ابو بكر بن ابي شيبة فقال الحجاج في حديثه مبير المنافقين  حدثنا احمد بن عمرو اسمع المكي ثنا محمد بن ابي عمر العدني ثنا سفيان ثنا ابو المحياة عن ابيه قال لما قتل الحجاج بن الزبير دخل الحجاج علي اسماء بنت ابي بكر فقال لها يا امه ان امير المءمنين اوصاني بك فهل لك من حاجة قالت ما لي اليك من حاجة ولست لك بام ولكن ام المصلوب انظر حتي احدثك حديثا سمعته من 
 رسول الله صلي الله عليه وسلم سمعت رسول الله صلي الله عليه وسلم يقول يخرج في ثقيف كذاب ومبير فاما الكذاب فقد رايناه تعني المختار واما المبير فانت قال الحجاج مبير للمنافقين ابو نوفل بن ابي عقرب العريجي عن اسماء  حدثنا علي بن عبد العزيز ثنا مسلم بن ابراهيم ثنا الاسود بن شيبان حدثني ابو نوفل بن ابي عقرب قال صلب الحجاج بن يوسف عبد الله بن الزبير علي عقبة المدينة ليري ذلك قريشا فلما ان نفروا جعلوا يمرون ولا يقفون عليه حتي مر عبد الله بن عمر فوقف عليه فقال السلام عليك ابا خبيب قالها ثلاث مرات لقد نهيتك عن ذا قالها ثلاث مرات لقد كنت صواما قواما تصل الرحم فبلغ ذلك الحجاج موقف عبد الله بن عمر فاستنزله فرمي به في قبور اليهود وبعث الي اسماء بنت ابي بكر ان تاتيه وقد ذهب بصرها فابت فارسل اليها لتجيءن او لابعثن اليك من يسحبك المطهري قالت والله لا اتيك حتي تبعث الي من يسحبني وخدعة فاتي رسوله اليه فاخبره فقال يا غلام ناولني سبتيتي فناوله نعليه فقام وهو يتودف حتي اتاها فقال لها كيف رايت الله صنع بعدو الله قالت رايتك افسدت عليه دنياه وافسد عليك اخرتك واما ما كنت تعيره بذات النطاقين اجل قد كان لي نطاقان نطاق اغطي به طعام رسول الله صلي الله عليه وسلم من النمل ونطاق لا بد للنساء منه وقد سمعت رسول الله صلي الله عليه وسلم يقول ان في ثقيف مبيرا وكذابا فاما الكذاب فقد عرفناه واما المبير فانت ذاك 
 قال فخرج  حدثنا محمد بن محمد الجذوعي القاضي قال ثنا عقبة بن مكرم ثنا يعقوب بن اسحاق الحضرمي ثنا الاسود بن شيبان عن ابي نوفل بن ابي عقرب عن اسماء بنت ابي بكر مثله ابو العالية البراء عن اسماء  حدثنا عبد الله بن احمد بن حنبل ثنا نصر بن علي قال اخبرني ابي ثنا الحسن بن ابي الحسناء عن ابي العالية البراء عن اسماء بنت ابي بكر ان الحجاج لما دخل عليها قيل لها هذا الامير الحجاج فقالت اما ان رسول الله صلي الله عليه وسلم قال ان في ثقيف كذابا ومبيرا فاما الكذاب فقد رايناه واما المبير فانت هو مسلم القري عن اسماء  حدثنا عبد الله بن احمد بن حنبل ومحمد بن صالح بن الوليد النرسي قالا ثنا ابو حفص عمرو بن علي قال ثنا ابو داود ثنا شعبة عن مسلم القري قال دخلنا علي اسماء بنت ابي بكر فسالناها عن المتعة فقالت فعلناها علي عهد رسول الله صلي الله عليه وسلم بن تدرس عن اسماء كثير بن عبيد عن اسماء عامر بن عبد الله بن الزبير عن اسماء  حدثنا ابو الزنباع روح بن الفرج ثنا يحيي بن بكير 
 ثنا بن لهيعة حدثني ابو الاسود محمد بن عبد الرحمن عن عامر بن عبد الله بن الزبير عن اسماء بنت ابي بكر قالت كنت مرة في ارض قطعها نبي الله صلي الله عليه وسلم لابي سلمة والزبير من ارض النضير فخرج الزبير مع رسول الله صلي الله عليه وسلم ولنا جار من اليهود فذبح شاة فطبخت فوجدت ريحها فدخلني من ريح اللحم ما لم يدخلني من شء قط وانا حامل بابنة لي تدعي خديجة فلم اصبر فانطلقت فدخلت علي امراته اقتبس منها نارا لعلها تطعمني وما لي من حاجة الي النار فلما شممت ريحه ورايته ازددت شرا فاطفاته ثم جءت الثانية اقتبس مثل ذلك ثم الثالثة فلما رايت ذلك قعدت ابكي وادعو الله فجاء زوج اليهودية فقال ادخل عليكم احد قالت لا الا العربية اتت تقتبس نارا فقال فلا اكل منها ابدا او ترسلي منها اليها فارسلت الي بقدحة ولم يكن في الارض شء اعجب الي من تلك الاكلة قال بن بكير القدحة عرقة محمد بن المنكدر عن اسماء  حدثنا اسماعيل بن الحسن الخفاف المصري ثنا احمد بن صالح ثنا بن وهب اخبرني اسامة بن زيد عن محمد بن المنكدر ان اسماء بنت ابي بكر قال لها رسول الله صلي الله عليه وسلم لا توكي فيوكي الله عليك  حدثنا عبد الله بن احمد بن حنبل حدثني ابي ثنا وكيع عن موسي بن عبيدة عن محمد بن المنكدر عن اسماء بنت ابي بكر 
 انها زارت اختها عاءشة والزبير غاءب فدخل النبي صلي الله عليه وسلم فوجد ريح طيب فقال ما علي المراة ان لا تطيب وزوجها غاءب  حدثنا محمد بن عبدوس بن كامل السراج ثنا حجاج بن الشاعر ثنا حجين بن المثني ثنا عبد العزيز بن ابي سلمة الماجشون عن محمد بن المنكدر عن اسماء بنت ابي بكر عن النبي صلي الله عليه وسلم قال اذا دخل الانسان قبره حف به عمله الصالح الصلاة والصيام وياتيه الملك من نحو الصلاة فيرده ومن نحو الصيام فيرده فيناديه اجلس فيجلس فيقول له ما تقول في هذا الرجل قال واي رجل قال محمد قال فيقول والله ما ادري سمعت الناس يقولون شيءا فقلته فيقول الملك علي ذلك عشت وعليه مت وعليه تبعث قال وتقيض له دابة في قبره سوداء مظلمة معها سوط تمرته جمرة فيضربه ما شاء الله لا يسمع صوته احد فيرحمه طلحة بن عبد الله بن عبد الرحمن بن ابي بكر عن اسماء  حدثنا جعفر بن سليمان النوفلي المدني ثنا ابراهيم بن المنذر الحزامي ثنا معين بن عيسي عن شعيب بن طلحة عن ابيه عن اسماء بنت ابي بكر انه لما قتل بن الزبير كان عندها شء اعطاها اياه النبي صلي الله عليه وسلم في سقط ففقدته فامرت بطلبه فلما وجدته خرت ساجدة 
 قيس بن الاحنف عن اسماء بنت ابي بكر حدثنا عبدان بن محمد المروزي ثنا اسحاق بن راهويه انا جرير عن يزيد بن ابي زياد عن قيس بن الاحنف عن اسماء بنت ابي بكر قالت سمعت رسول الله صلي الله عليه وسلم ينهي عن المثلة وسمعته يقول من ثقيف رجلان كذاب ومبير الماجشون عن اسماء  حدثنا احمد بن عمرو اسمع المكي ثنا يعقوب بن حميد ثنا يوسف بن الماجشون عن ابيه عن اسماء بنت ابي بكر قالت كان النبي صلي الله عليه وسلم ياتينا بمكة كل يوم مرتين فلما كان يوما من ذلك جاءنا في الظهيرة فقلت يا ابة هذا رسول الله صلي الله عليه وسلم فقال معبد وامي ما جاء به في هذه الساعة الا امر فقال له النبي صلي الله عليه وسلم هل شعرت ان الله قد اذن لي في الخروج فقال ابو بكر فالصحابة يا رسول الله قال الصحابة فقال ابو بكر ان عندي لراحلتين قد علفتهما منذ كذا وكذا انتظارا لهذا اليوم فخذ احداهما فقال بثمنها يا ابا بكر قال بثمنها معبد انت وامي ان شءت قالت فهيانا لهم سفرة ثم قطعت نطاقها فربطتها ببعضه فخرجا فمكثا في الغار في جبل ثور فلما انتهيا اليه دخل ابو 
 بكر الغار قبله فلم يترك فيه جحرا الا ادخل فيه اصبعه مخافة ان يكون فيه هامة وخرجت قريش حين فقدوهما في بغاءهما وجعلوا في النبي صلي الله عليه وسلم ماءة ناقة وخرجوا يطوفون في جبال مكة حتي انتهوا الي الجبل الذي هما فيه فقال ابو بكر لرجل يراه مواجه الغار يا رسول الله انه ليرانا فقال كلا ان ملاءكة تسترنا باجنحتها فجلس ذلك الرجل فبال مواجه الغار فقال النبي صلي الله عليه وسلم لو كان يرانا ما فعل هذا فمكثا ثلاث ليال يروح عليهما عامر بن فهيرة مولي ابي بكر غنما لابي بكر ويدلج من عندهما فيصبح مع الرعاة في مراعها ويروح معهم ويتطاطا في المشي حتي اذا اظلم انصرف بغنمه اليهما فيظن الرعاة انه معهم وعبد الله بن ابي بكر يظل بمكة يبطش الاخبار ثم ياتيهما اذا اظلم فيخبرهما ثم يدلج من عندهما فيصبح بمكة كباءت ثم خرجا من الغار فاخذا علي الساحل فجعل ابو بكر يسير امامه فاذا خشي ان يءتي من خلفه سار خلفه فلم يزل كذلك مسيره وكان ابو بكر رجلا معروفا في الناس فاذا لقيه لاق قال لابي بكر من هذا معك فيقول هاد يهديني يريد الهداية في الدين ويحسبه الاخر دليلا حتي اذا كانا بابيات قديد وكان علي طريقهما علي الساحل جاء انسان الي مجلس بني مدلج فقال قد رايت راكبين نحو الساحل فاني اري احدهما لصاحب قريش الذي يبغون فقال سراقة بن مالك ذانك راكبان ممن بعثنا في طلبه يواس القوم ثم دعا جاريته فسارها فامرها ان تخرج بفرسه وتحط رمحه ولا تنصبه حتي ياتيه في قراره بموضوع كذا وكذا ثم يجيءها فركب فرسه ثم خرج في اثارهما فقال سراقة فدنوت منهما حتي اني لاسمع قراءة رسول الله صلي الله عليه وسلم ثم ركضت 
