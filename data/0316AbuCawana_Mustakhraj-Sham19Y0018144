 [] قالوا: ثنا سعيد بن ابي عروبة (¬)، عن قتادة (¬)، عن مطرف (¬)، عن عاءشة، "ان رسول الله صلي الله عليه وسلم كان يقول في سجوده: سبوح قدوس رب الملاءكة والروح". هذا لفظ يحيي (¬).
 واما محمد بن بشر فقال: "عن مطرف، عن (¬) (¬) عاءشة، انباته "ان
 [] رسول الله صلي الله عليه وسلم كان يقول في ركوعه وسجوده: "سبوح قدوس رب الملاءكة والروح" (¬).



   حدثنا ابو امية، قال: ثنا روح (¬)، عن سعيد، بمثله.
 قال سعيد: وسمعت قتادة وهو يقول وانا الي جنبه في صلاة العصر (¬).   حدثنا ابو داود الحراني (¬)، قال: ثنا ابو عتاب (¬)، قال:
 [] ثنا سعيد بن ابي عروبة وهشام (¬) وهمام (¬)، عن قتادة (¬)، عن مطرف، عن عاءشة، قالت: "كان النبي صلي الله عليه وسلم يقول في ركوعه وسجوده: سبوح قدوس رب الملاءكة والروح" (¬).



   (حدثنا ابو امية، قال: ثنا ابو الوليد (¬)، عن شعبة،
 [] باسناده، قال: "كان يقول في سجوده" ولم يذكر الركوع) (¬) (¬).



   حدثنا الصغاني، قال: ثنا سليمان بن حرب (¬)، قال: ثنا شعبة، قال: حدثني هشام الدستواءي (¬)، عن قتادة، عن مطرف، عن
 [] عاءشة، انه قال (¬): تعني (¬): النبي صلي الله عليه وسلم في سجوده وركوعه.



   حدثنا حنبل بن اسحاق (¬) بن حنبل (¬)، قال: حدثنا ابو غسان (¬)، قال: ثنا عبد العزيز بن ابي سلمة (¬)، قال: حدثني عمي
 [] الماجشون (¬)، عن عبد الرحمن الاعرج (¬)، عن عبيد الله بن ابي رافع (¬)، عن علي بن ابي طالب، عن النبي صلي الله عليه وسلم: "انه كان اذا ركع قال: اللهم لك ركعت. . ." (¬). وذكر الحديث (¬).



   (¬) حدثنا يونس بن حبيب (¬)، قال: حدثنا ابو داود (¬)، ح وحدثنا ابو امية (¬)،
 [] قال: ثنا روح (¬)، قالا: ثنا عبد العزيز بن ابي سلمة (¬)، حدثنا الماجشون (¬)، عن عبد الرحمن الاعرج، عن عبيد الله بن ابي رافع، عن علي [رضي الله عنه] (¬)، قال: "كان رسول الله صلي الله عليه وسلم اذا ركع قال: اللهم لك ركعت ... " (¬). وذكر الحديث.



   حدثنا الصغاني، قال: ثنا سريج بن النعمان (¬)، قال: ثنا عبد العزيز بن ابي سلمة (¬)، عن عمه الماجشمون وعبد الله بن الفضل (¬)، عن الاعرج، عن عبيد الله بن ابي رافع، عن علي، بنحوه (¬).   حدثنا عيسي بن احمد (¬)، قال: ابنا النضر بن شميل (¬)،
 [] قال: ابنا محمد بن عمرو (¬)، عن ابراهيم بن (¬) عبد الله بن حنين (¬)، عن ابيه (¬) قال: سمعت علي بن ابي طالب [رضي الله عنه] (¬) في رحبة (¬) الكوفة يقول:
 [] "نهاني رسول الله صلي الله عليه وسلم ولا اقول نهاكم عن لبس القسي (¬)، والمعصفر (¬)، وعن تختم الذهب، وان اقرا وانا راكع" (¬).



   حدثنا الحسن بن عفان (¬)، قال: ثنا ابن نمير (¬)، قال: ثنا
 [] الاعمش، عن سعد بن عبيدة (¬)، عن المستورد بن الاحنف (¬) عن صلة بن زفر (¬)، عن حذيفة قال: "صليت مع النبي صلي الله عليه وسلم ليلة فافتتح "البقرة"، فقرا (¬) ... ، وذكر الحديث وقال فيه: "ثم ركع، فجعل يقول: "سبحان ربي العظيم"، فكان ركوعه نحوا من قيامه، ثم رفع راسه فقال: "سمع الله لمن حمده" ثم قام طويلا قريب (¬) مما ركع (¬) " (¬).



   حدثنا العطاردي (¬) قال:
 [] ثنا ابن فضيل (¬)، عن الاعمش (¬)، عن سعد بن عبيدة، عن (¬) صلة بن
 [] زفر، عن حذيفة قال: "صليت مع النبي صلي الله عليه وسلم فافتتح "البقرة" فقلت: يريد الماءة، فجاوز، فقلت يريد ان يقراها في ركعتين، فجاوز، فقلت: يختمها، فختمها، ثم افتتح "النساء"، ثم افتتح "ال عمران"، فقراها، ولا يمر علي تسبيح ولا تكبير ولا استغفار الا وقف. قال: ثم ركع فجعل يقول: "سبحان ربي العظيم" نحوا من قيامه، ثم رفع راسه فقام ساعة، ثم سجد فجعل يقول: "سبحان ربي الاعلي"، فجعل في السجود نحو ركوعه (¬)، ثم صنع في الاخري مثل ذلك".



   حدثنا عبد الله بن محمد ابو حميد المصيصي، قال: ثنا حجاج (¬)، عن ابن جريج (¬)، قال: سمعت. . . . . . . . . . . . . ..
 [] ابن (¬) ابي مليكة يحدث عن عاءشة، قالت: "فقدت رسول الله صلي الله عليه وسلم ليلة،
 [] فظننت انه قد ذهب الي بعض نساءه، فتجسست (¬) ثم رجعت فاذا هو ساجد او راكع يقول: "سبحانك وبحمدك لا اله الا انت" قالت: فقلت: بابي [انت] وامي، اني لفي شان، وانك لفي شان" (¬).



   حدننا الحسن بن عفان [العامري] (¬)، قال: ثنا ابو اسامة (¬)، عن عبيد الله بن عمر (¬)، عن محمد بن يحيي بن حبان (¬)، عن عبد الرحمن
 [] الاعرج، عن ابي هريرة، عن عاءشة قالت: "فقدت النبي صلي الله عليه وسلم ذات ليلة، فلمست (¬) المسجد، فاذا هو ساجد (¬)، وقدماه منصوبتان، وهو يقول: اعوذ برضاك من سخطك، واعوذ بمعافاتك من عقوبتك، واعوذ بك (¬) منك، لا احصي ثناء عليك، انت كما اثنيت علي نفسك" (¬).



  AUTO باب ايجاب تعظيم الرب عز وجل في الركوع، والاجتهاد في الدعاء في السجود، وحظر القراءة في الركوع والسجود

   حدثنا ابن ابي مسرة (¬)، قال: ثنا الحميدي (¬)، قال: ثنا سفيان (¬)، قال: حدثني سليمان بن سحيم (¬) مولي ال (¬) عباس قال:
 [] اخبرني ابراهيم بن عبد الله بن معبد (¬)، عن ابيه (¬)، عن ابن عباس قال: "كشف رسول (¬) الله صلي الله عليه وسلم (¬) الستارة (¬)، والناس خلف ابي بكر [رضي الله عنه] (¬) صفوف، فقال (¬): "ايها الناس انه لم يبق من مبشرات
 [] النبوة الا الرءيا الصالحة (¬)، يراها المسلم، او تري له، الا اني نهيت ان اقرا راكعا او ساجدا، فاما الركوع فعظموا فيه الرب (¬)، واما السجود فاجتهدوا في الدعاء، فقمن (¬) ان يستجاب لكم".
 قال الحميدي: قال سفيان: (افادنيه زياد بن سعد (¬) قبل ان اسمعه)، فقلت: اقرءه منك السلام؟ فقال: نعم، فاقراته السلام، وسالته عنه (¬).



   حدثنا الربيع بن سليمان (¬)، قال:
 [] ثنا الشافعي (¬)، قال: ابنا سفيان، ح
 وحدثنا ابو امية، قال: ثنا ابو نعيم (¬) وسريج (¬)، ح
 وحدثنا اسحاق الدبري (¬)، عن عبد الرزاق (¬)؛ كلهم عن ابن عيينة، باسناده، مثله، الا انه قال: "قمن ان يستجاب لكم" (¬).



   حدثنا الصغاني [ابو بكر بن اسحاق] (¬) قال: حدثنا ابن
 [] ابي مريم (¬)، قال: ثنا عبد العزيز بن محمد (¬)، قال: ثنا سليمان بن سحيم (¬)، عن ابراهيم بن عبد الله بن معبد، عن ابيه، عن ابن عباس، "ان رسول الله  صلي الله عليه وسلم  رفع الستر وابو بكر [ رضي الله عنه ] (¬) يءم الناس، فقال: اللهم هل بلغت؟ اللهم هل بلغت؟ ايها الناس، انه لم يبق بعدي (¬) من مبشرات النبوة ... " فذكر مثله: "فانه قمن ان يستجاب لكم" (¬).



   حدثنا يونس بن عبد الاعلي (¬)، قال: ابنا ابن وهب (¬)،
 [] قال: اخبرني يونس (¬) ح
 وحدثنا السلمي (¬) وابن مهل [الصنعاني] (¬)، قالا: ثنا عبد الرزاق (¬)، عن معمر، كلاهما عن ابن شهاب (¬)، قال: حدثني ابراهيم بن عبد الله بن حنين، ان اباه حدثه انه سمع علي بن ابي طالب [رضي الله عنه] (¬) قال: "نهاني رسول الله صلي الله عليه وسلم ان اقرا راكعا و (¬) ساجدا ".



   حدثنا سليمان بن سيف (¬)، ثنا ابو علي الحنفي (¬)،
 [] وعثمان بن عمر (¬) ح
 وحدثنا ابراهيم بن مرزوق (¬)، قال: ثنا ابو عامر (¬) قالوا: ثنا داود بن قيس (¬)، عن ابراهيم بن عبد الله بن حنين، عن ابيه، عن ابن عباس، عن
 [] علي بن ابي طالب [رضي الله عنه] (¬) قال: "نهاني حبي (¬) صلي الله عليه وسلم عن ثلاث (¬) لا اقول نهي الناس: نهاني عن تختم الذهب، وعن لبس القسي، وعن المعصفر (¬) المفدمة (¬)، ولا اقرا ساجدا ولا راكعا".
 وقال ابو عامر: "وان اقرا راكعا و (¬) ساجدا" (¬).



   حدثنا احمد بن عبد الحميد الحارثي (¬)، قال: ثنا ابو اسامة (¬)،
 [] عن الوليد بن كثير (¬)، قال: حدثني ابراهيم بن عبد الله بن حنين، [عن ابيه] (¬)، انه سمع علي بن ابي طالب [رضي الله عنه] (¬) يقول: "نهاني رسول الله صلي الله عليه وسلم عن قراءة القران وانا راكع (¬) او ساجد".



   حدثنا عبد الرحمن بن بشر (¬)، قال: ثنا يحيي بن سعيد (¬)، قال: ثنا ابن عجلان (¬)، قال: ثنا ابراهيم بن عبد الله بن حنين، عن ابيه، عن ابن عباس، عن علي بن ابي طالب [رضي الله عنه] (¬)، قال: "نهاني رسول الله صلي الله عليه وسلم عن خاتم الذهب، وان اقرا وانا راكع ولم يذكر السجود ونهاني
 [] عن المعصفر، ونهاني عن لبس القسي" (¬).



   حدثنا الربيع (¬)، قال: ثنا ابن وهب (¬)، عن اسامة بن زيد (¬)، عن ابراهيم بن عبد الله بن حنين، عن ابيه، عن علي [رضي الله عنه] (¬)، انه سمعه يقول: "نهاني النبي صلي الله عليه وسلم عن تختم الذهب، وعن لبس المعصفرة (¬)، والقسي، والمياثر (¬)، وعن قراءة القران وانا راكع".
 [] قال اسامة: "فدخلت علي عبد الله بن حنين وهو في بيته يومءذ شيخ كبير، وعليه ملحفة (¬) معصفرة كثيرة العصفر فسالته عن هذا الحديث، فقال عبد الله: سمعت عليا [رضي الله عنه] (¬) يقول: "نهاني رسول الله صلي الله عليه وسلمولا اقول: نهاكم عن تختم الذهب، ولباس المعصفر ... ". وذكر الحديث، ولم يذكر السجود (¬).



   حدثنا احمد بن الفرج الحمصي (¬)، قال: ثنا ابن
 [] ابي فديك (¬)، قال: ثنا الضحاك بن عثمان (¬)، عن ابراهيم بن عبد الله بن حنين، عن ابيه، عن ابن عباس، عن علي [رضي الله عنه] (¬)، انه (¬) قال: "نهاني النبي صلي الله عليه وسلمولا اقول: نهاكم عن تختم الذهب، وعن لبس القسي، وعن لبس المفدم من المعصفر، وعن القراءة راكعا".



   حدثنا محمد بن كثير (¬)، قال: ثنا سعيد بن حفص الحراني (¬)، قال: ثنا يونس بن راشد الحراني (¬)،
 [] عن محمد بن عمرو (¬)، عن ابراهيم بن عبد الله بن حنين، عن ابيه، انه سمع عليا [رضي الله عنه] (¬) برحبة الكوفة يقول: "نهاني رسول الله صلي الله عليه وسلمولا اقول: نهاكم عن تختم الذهب، وان اقرا وانا راكع، وعن لبس القسي، وعن المعصفر المفدم" (¬).



   حدثنا محمد بن كثير، قال: ثنا عبد العزيز بن يحيي (¬)، عن محمد بن سلمة (¬)، عن محمد بن اسحاق (¬)، عن ابراهيم بن عبد الله بن حنين، عن ابيه، عن علي [رضي الله عنه] (¬)، بنحوه.   حدثنا محمد بن كثير الحراني، قال ثنا النفيلي (¬)، قال: ثنا حاتم بن اسماعيل (¬)، قال:
 [] ثنا جعفر بن محمد (¬)، عن محمد بن المنكدر (¬)، عن ابن حنين (¬)، عن علي [رضي الله عنه] (¬)، قال: "نهاني النبي صلي الله عليه وسلمولا اقول: نهاكم عن تختم الذهب، وان (¬) اقرا وانا راكع، وعن لبس القسي، وعن المعصفر المفدم ... "، مثله، ولم يذكر السجود.



   حدثنا الربيع (¬) بن سليمان (¬)، قال: ثنا شعيب بن الليث (¬)، قال: ثنا الليث (¬)، ح
 [] وحدثنا عباس (¬)، قال: ثنا يونس بن محمد (¬)، قال: ثنا الليث، عن يزيد بن ابي حبيب (¬)، ان ابراهيم بن عبد الله بن حنين [حدثه] (¬)، ان اباه حدثه، [انه] سمع من علي [رضي الله عنه] يقول: "نهي النبي صلي الله عليه وسلم عن خاتم الذهب، ولبوس (¬) القسي، والمعصفر (¬)، وقراءة القران وانا راكع"، ولم يذكر السجود.



   حدثنا ابو امية، قال: ثنا وهب بن جرير [ابو العباس] (¬)، عن شعبة (¬)، عن
 [] ابي بكر بن حفص (¬)، عن عبد الله بن حنين، عن ابن عباس، قال: "نهيت عن الثوب الاحمر، وخاتم الذهب، وان اقرا وانا راكع".
 كذا (¬) رواه غندر عن شعبة (¬).



   حدثنا محمد بن كثير الحراني، قال: ثنا سعيد بن حفص الحراني، قال: ثنا يوسف بن راشد الحراني، عن محمد بن عمرو، عن
 [] ابراهيم بن عبد الله بن حنين، عن ابيه، انه سمع عليا [رضي الله عنه] (¬) برحبة الكوفة يقول: "نهاني رسول الله صلي الله عليه وسلمولا اقول: نهاكم عن تختم الذهب، وان (¬) اقرا وانا راكع، وعن لبس القسي، وعن المعصفر المفدم" (¬).



   حدثنا محمد بن كثير الحراني، ثنا عبد العزيز بن يحيي (¬)، قال: حدثني محمد بن سلمة، عن محمد بن اسحاق، عن ابراهيم بن عبد الله بن حنين، عن ابيه، عن علي، بنحوه (¬) (¬).   حدثنا ابو داود الحراني، قال: ثنا عبد العزيز [بن يحيي] (¬)، بمثله.   حدثنا عمار بن رجاء (¬)، قال: ثنا يزيد بن هارون (¬)،
 [] قال: ابنا محمد (¬)، عن ابراهيم بن عبد الله بن حنين، عن ابيه، انه سمع عليا برحبة الكوفة يقول: "نهاني رسول الله صلي الله عليه وسلم ولا اقول: نهاكم عن لبس القسي، والمعصفر، وعن التختم بالذهب، وعن قراءة القران وانا راكع" (¬).
 رواه يزيد بن ابي حبيب (¬)، والضحاك بن عثمان (¬)، واسامة بن زيد (¬)، ومحمد بن عمرو (¬)، ومحمد بن اسحاق (¬)، كل هءلاء عن ابراهيم بن عبد الله بن حنين، عن ابيه، عن عليي؛ الا الضحاك وابن عجلان (¬)؛ فانهما زادا "عن ابن عباس (¬) " عن علي، عن النبي صلي الله عليه وسلم، وقالوا:
 [] "نهاني عن قراءة القران وانا راكع"، ولم يذكروا في روايتهم النهي عنها في السجود (¬).
 [] كما ذكر الزهري (¬)، وزيد بن اسلم (¬) والوليد بن كثير (¬)، وداود بن قيس (¬) (¬).



   حدثنا الصغاني، قال: ثنا اسحاق بن عيسي (¬)، عن
 [] مالك (¬)، عن نافع، ح
 وحدثنا حمدان بن علي (¬) قال: ثنا معلي (¬)، عن وهيب (¬)، عن ايوب (¬)، عن نافع (¬)، عن ابراهيم بن عبد الله بن حنين، عن ابيه، عن علي [رضي الله عنه] (¬)، عن النبي صلي الله عليه وسلم (¬) قال: "وعن قراءة القران في الركوع"، ولم يذكر السجود.



   حدثنا ابو داود الحراني، قال: ثنا ابو ربيعة (¬)، قال: ثنا
 [] وهيب، بمثله: "وعن القراءة وانا راكع".



   حدثنا اسماعيل القاضي (¬) قال: ثنا عيسي بن مينا (¬)،
 [] قال: ثنا محمد بن جعفر بن ابي كثير (¬)، عن زيد بن اسلم (¬)، عن ابراهيم بن عبد الله بن حنين، عن ابيه، عن علي [رضي الله عنه] (¬)، انه قال: "نهاني النبي صلي الله عليه وسلم عن تختم الذهب، وعن لبس القسي، وعن المعصفر المفدم، وعن القراءة في الركوع والسجود، ولا اقول: نهاكم ايها الناس".



  CHECK [باب] بيان ما يقول المصلي اذا رفع راسه من الركوع، ومقدار وقوفه، وثبات المامومين قياما حتي يسجد الامام، ثم يسجدون، وبيان طول الجلوس بين السجدتين

 [باب] (¬) بيان ما يقول المصلي اذا رفع راسه من الركوع، ومقدار وقوفه، وثبات المامومين قياما حتي يسجد الامام، ثم يسجدون، وبيان طول الجلوس بين السجدتين   حدثنا الصغاني، قال: ثنا سليمان بن حرب (¬)، قال: ثنا حماد بن زيد (¬)، عن ثابت (¬)، قال: قال لي انس بن مالك (¬): "اني لا الو (¬) ان اصلي بكم كما رايت رسول الله صلي الله عليه وسلم يصلي".
 قال ثابت: "فكان انس يصنع شيءا لا اراكم تصنعونه (¬)، كان اذا رفع راسه من الركوع قام حتي يقول القاءل: لقد نسي، وكان اذا رفع راسه بين السجدتين قعد حتي يقول القاءل:
 [] "لقد نسي" (¬).



   حدثنا يعقوب بن سفيان (¬)، قال: ثنا عبد الله بن يوسف (¬)، قال: ثنا سعيد (¬)، ح
 وحدثنا يزيد بن عبد الصمد (¬)، قال: ثنا ابو مسهر (¬)، ح
 وحدثنا العباس بن الوليد (¬) قال: حدثني ابي (¬)، قال (¬): ابنا سعيد بن عبد العزيز (¬)، عن عطية بن قيس، عن قزعة، عن ابي سعيد
 [] الخدري، "ان رسول الله صلي الله عليه وسلم كان اذا قال: "سمع الله لمن حمده" قال: "ربنا ولك الحمد ملء السماوات وملء الارض، وملء ما شءت من شء بعد، اهل الثناء والمجد، احق ما قال العبد كلنا لك عبد لا مانع لما اعطيت"، وقال احدهما (¬): "لا نازع لما اعطيت، ولا معطي لما منعت، ولا ينفع ذا الجد منك الجد".
 وقال يعقوب: "لا مانع" (¬).



   حدثنا عباس الدوري، وابو داود الحراني، قالا: ثنا
 [] سعيد بن عامر (¬)، ح
 وحدثنا الصغاني وسعيد بن مسعود (¬)، قالا: ثنا روح بن عبادة (¬)، قالا: ثنا هشام بن حسان (¬)، عن قيس بن سعد (¬)، عن عطاء (¬)، عن ابن عباس، قال: كان رسول الله صلي الله عليه وسلم اذا رفع راسه من الركوع قال: "اللهم ربنا ولك الحمد ملء السماء (¬)، وملء الارض، وملء ما شءت من شء بعد".



   حدثنا ابراهيم بن مرزوق (¬)، قال: ثنا عثمان بن عمر (¬)،
 [] قال: ثنا هشام بن حسان، بمثله.



   حدثنا احمد بن مسعود المقدسي (¬)، ثنا محمد بن عيسي، ابنا هشيم (¬)، ابنا هشام بن حسان (¬) باسناده مثله وزاد فيه: "اهل الثناء والمجد، لا مانع لما اعطيت، ولا معطي لما منعت، ولا ينفع ذا الجد (¬) منك الجد".   حدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، ح
 وحدثنا يوسف بن مسلم (¬)، قال: ثنا حجاج بن محمد، قالا: ثنا
 [] شعبة (¬)، عن عبيد ابي الحسن (¬)، قال: سمعت عبد الله بن ابي اوفي، قال: كان رسول الله صلي الله عليه وسلم يدعو بهذا الدعاء: "اللهم لك الحمد ملء السماوات وملء الارض، وملء ما شءت من شء بعد".
 زاد حجاج في حديثه: قال شعبة: وحدثني ابو عصمة (¬)، عن
 [] سليمان الاعمش، عن عبد الله بن ابي اوفي، "ان النبي صلي الله عليه وسلم كان يدعو به" (¬).



   حدثنا عمار بن رجاء، قال: ثنا محمد بن عبيد (¬)، ح
 وحدثنا الحسن بن عفان، قال: ثنا ابن نمير (¬)، قالا جميعا: عن الاعمش (¬)، عن عبيد بن الحسن، عن ابن ابي اوفي قال: "كان رسول الله صلي الله عليه وسلم اذا رفع راسه من الركوع قال: "سمع الله لمن حمده" ثم قال: اللهم ربنا لك الحمد ملء السماوات (¬) وملء الارض، وملء ما شءت من شء بعد".
 قال ابو عوانة: "يقولون: هو عبيد بن الحسن، وهو ابو الحسن".   حدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، قال (¬): ثنا
 [] شعبة (¬)، سمعت مجزاة بن زاهر (¬) وهو يقول: سمعت ابن ابي اوفي يذكر (¬) هذا الدعاء وزاد فيه: "اللهم طهرني بالثلج والبرد والماء البارد، اللهم نقني من الذنوب والخطايا كما ينقي الثوب الابيض من الدنس (¬) ".



   حدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، ح
 وحدثنا (¬) ابو امية، قال: ثنا وهب بن جرير، قالا: ثنا شعبة، عن ابي اسحاق (¬)، قال: سمعت عبد الله بن يزيد (¬) الانصاري يخطب وهو
 [] يقول: حدثني البراء بن عازب وكان غير كذوب "انهم كانوا اذا صلوا مع رسول الله صلي الله عليه وسلم فرفعوا رءوسهم من الركوع، لم يسجد احد منهم حتي يروا رسول الله صلي الله عليه وسلم ساجدا، ثم يسجدو [ن (¬)] " (¬).



   حدثنا محمد بن علي ابن اخت غزال (¬)، قال: ثنا غسان بن الربيع (¬)، قال: ثنا حماد (¬)،
 [] عن شعبة بنحوه (¬).



   حدثنا ابراهيم بن ابي داود الاسدي (¬)، قال: ثنا عبد الغفار بن داود (¬)، قال: ثنا حماد، عن شعبة، بنحوه.   حدثنا السلمي (¬)، قال: ثنا عبد الصمد بن حسان (¬)، ح
 [] وحدثنا الصغاني وابو امية، قالا: ثنا ابو نعيم (¬)، كلاهما عن سفيان (¬)، عن ابي اسحاق، عن عبد الله بن يزيد، قال: حدثني البراء وهو غير كذوب قال: "كنا اذا صلينا خلف النبي صلي الله عليه وسلم لم يحن (¬) احد منا ظهره حتي يضع النبي صلي الله عليه وسلم جبهته"، قال عبد الصمد: "علي الارض (¬) "، وقال فيه عبد الرحمن (¬): "حتي يسجد النبي صلي الله عليه وسلم فنسجد".



   حدثنا محمد بن صالح كيلجة (¬)، قال: ثنا ابو صالح
 [] الفراء (¬)، ح
 وحدثنا ابو داود السجزي (¬)، قال: ثنا الربيع بن نافع (¬)، قالا: ثنا ابو اسحاق الفزاري (¬)، عن ابي اسحاق الشيباني (¬)، عن محارب بن
 [] دثار (¬)، عن عبد الله بن يزيد، قال: ثنا البراء بن عازب وكان غير كذوب قال: "كنا اذا صلينا مع النبي صلي الله عليه وسلم فرفع راسه من الركوع لم يحن احد منا ظهره حتي يضع النبي صلي الله عليه وسلم جبهته ساجدا".
 هذا لفظ كيلجة، ولفظ غيره: "لم نزل (¬) قاءما (¬) حتي نراه قد وضع وجهه (¬) علي الارض، ثم نتبعه".



   حدثنا محمد بن علي بن داود ابن اخت غزال، قال: ثنا محرز بن عون (¬)، قال: ثنا خلف بن خليفة (¬)، عن الوليد بن
 [] سريع (¬) مولي عمرو بن حريث* عن عمرو بن حريث* (¬)، قال: "صليت خلف النبي صلي الله عليه وسلم الفجر، فسمعته يقرا {فلا اقسم بالخنس () الجوار الكنس ()} (¬)، ولا يحني رجل منا ظهره حتي نراه (¬) ساجدا" (¬).



   اخبرنا يونس بن عبد الاعلي، قال: ابنا ابن وهب، ان مالكا (¬) حدثه، عن
 [] سمي (¬)، عن ابي (¬) صالح (¬)، عن ابي هريرة، قال: قال رسول الله صلي الله عليه وسلم: "اذا قال الامام: سمع الله لمن (¬) حمده فقولوا: اللهم ربنا لك الحمد، فانه من وافق قوله قول الملاءكة غفر له ما تقدم من ذنبه" (¬).
 قال مالك: يقول الرجل: "اللهم ربنا لك الحمد" (¬).



  CHECK [باب] بيان ثواب السجود والترغيب في كثرة السجود

 [باب] (¬) بيان ثواب السجود والترغيب في كثرة السجود   حدثني ابو جعفر محمد بن اسراءيل بن يعقوب الجوهري، قال: ثنا رجاء بن السندي (¬)، قال: ثنا ابن وهب (¬)، قال: ثنا عمرو بن الحارث (¬)، عن عمارة بن غزية (¬)، عن سمي مولي ابي بكر عن ابي صالح [السمان] (¬)، عن ابي هريرة، ان رسول الله صلي الله عليه وسلم قال: "ان اقرب ما يكون العبد من ربه وهو ساجد، فاكثروا الدعاء".



   حدثنا صالح [بن عبد الرحمن] (¬) بن عمرو بن الحارث (¬)، ومحمد بن ابي خالد الصومعي (¬)، قالا: ثنا اصبغ بن الفرج (¬) ح
 وحدثنا ابو امية، قال: ابنا خالد بن خداش (¬)، قالا (¬): ثنا ابن وهب، عن عمرو بن الحارث، عن عمارة بن غزية، عن سمي مولي ابي بكر سمع ابا صالح ذكوان، عن ابي هريرة، ان النبي صلي الله عليه وسلم قال: "ان اقرب ما يكون عبد (¬) من ربه وهو ساجد، فاكثروا من الدعاء".   اخبرني العباس بن الوليد (¬)، قال: حدثني ابي، قال: ثنا الاوزاعي (¬)، قال: حدثني الوليد بن هشام (¬)،
 [] عن معدان بن طلحة (¬)، قال: "قلت لثوبان مولي رسول الله صلي الله عليه وسلم: دلني علي عمل ينفعني الله به (¬) "، قال: فسكت، ثم قلت: "دلني علي عمل ينفعني الله عز وجل (¬) به (¬)، قال: سمعت رسول الله صلي الله عليه وسلم يقول: "ما من عبد يسجد لله سجدة الا رفعه الله بها درجة، وحط عنه بها خطيءة".
 قال معدان: ثم لقيت ابا الدرداء (¬)؛ فحدثني مثل ذلك (¬).



   حدثنا محمد بن عبد الله بن ميمون السكري بالاسكندرية (¬)  واحمد بن محمد بن عثمان الثقفي بدمشق، قالا: ثنا الوليد بن مسلم، قال: ثنا ابو عمرو (¬)، قال: حدثني يحيي بن ابي كثير، قال: حدثني ابو سلمة (¬)، عن ربيعة بن كعب الاسلمي (¬)، قال: كنت ابيت مع النبي
 []صلي الله عليه وسلم اتيه بوضوءه (¬)، وبحاجته، فكان يقوم من الليل فيقول: "سبحان ربي وبحمده سبحان ربي وبحمده" الهوي (¬) . ثم يقول: "سبحان رب العالمين، سبحان رب العالمين" الهوي (¬) .



   حدثنا ابراهيم بن ديزيل (¬)، وابو حاتم (¬)، ويعقوب بن سفيان (¬)، قالوا: ثنا (¬) ابو توبة (¬)، قال: حدثني معاوية بن سلام (¬)، عن
 [] يحيي بن ابي كثير * (¬)، باسناده، مثله، الي قوله: "سبحان ربي وبحمده"، نحو ذلك (¬).



   اخبرني العباس بن الوليد (¬)، قال: اخبرني ابي، قال: ثنا الاوزاعي (¬)، عن يحيي بن ابي كثير، قال: حدثني ابو سلمة *، قال: حدثني ربيعة بن كعب الاسلمي بمثل حديث الوليد بن مسلم، وزاد: قال (¬) لي رسول الله صلي الله عليه وسلم: "هل لك من (¬) حاجة". قال: قلت: يا رسول الله (¬)، "مرافقتك في الجنة"، قال: "ا (¬) وغير ذلك"؟ قال: قلت: "يا رسول الله هي حاجتي"، قال (¬): "فاعني علي نفسك بكثرة السجود".



  CHECK باب [بيان] صفة السجود وايجابه علي سبعة اعظم، وحظر كف الشعر والثوب

 باب [بيان] (¬) صفة السجود وايجابه علي سبعة اعظم، وحظر كف الشعر والثوب   حدثنا عباس الدوري، قال: ثنا شبابة (¬) ح
 وحدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، قالا: ثنا شعبة (¬)، عن عمرو (¬)، عن طاوس (¬)، عن ابن عباس، عن النبي صلي الله عليه وسلم قال: "امرت،
 [] او امر نبيكم صلي الله عليه وسلم ان يسجد علي سبعة اعظم، وامر ان لا يكف (¬) شعرا ولا ثوبا". هذا لفظ ابي داود.
 واما (¬) شبابة فقال: "امر نبيكم صلي الله عليه وسلم (¬) ان يسجد علي سبعة، وامر ان لا يكف شعرا ولا ثوبا".
 * ثم قال: وقال النبي صلي الله عليه وسلم: "امرت بالسجود علي سبعة اعظم، ولا نكف ثوبا ولا شعرا" * (¬) (¬).



   حدثنا محمد بن عوف الحمصي (¬)، قال: ثنا الفريابي (¬)، قال: ثنا سفيان (¬)، عن عمرو بن دينار (¬)، عن طاءس، عن ابن عباس، قال: "امر النبي صلي الله عليه وسلم ان نسجد (¬) علي سبع، ولا نكف شعرا ولا ثوبا" (¬).   حدثنا يونس بن عبد الاعلي، قال: ثنا [سفيان] (¬) بن عيينة، عن عمرو بن دينار، عن طاوس، عن ابن عباس، قال: "امر رسول الله صلي الله عليه وسلم ان يسجد علي سبعة اعظم، ونهي ان يكف شعره وثوبه".   حدثنا يونس بن عبد الاعلي، وبحر بن نصر (¬)، عن ابن
 [] وهب (¬)، قال: اخبرني ابن جريج (¬)، عن عبد الله بن طاوس (¬)، عن ابيه (¬)، عن عبد الله (¬) بن عباس، ان رسول الله صلي الله عليه وسلم قال: "امرت ان اسجد علي سبع لا اكف الشعر ولا الثياب (¬) : الجبهة والانف (¬)، واليدين،
 [] والركبتين، والقدمين".



   حدثنا اسحاق الطحان (¬)، قال: ثنا ابو (¬) صالح (¬) قال: حدثني الليث، قال: حدثني ابن وهب، عن ابن جريج، بمثله.    حدثنا الصغاني، قال: ثنا احمد بن اسحاق (¬) ح
 [] وحدثنا حمدان بن علي (¬)، قال: ثنا معلي بن اسد، قالا: ثنا وهيب (¬)، قال: ثنا عبد الله بن طاوس، عن ابيه، عن ابن عباس، عن النبي صلي الله عليه وسلم قال: "امرت ان اسجد علي سبعة اعظم: الجبهة (¬) واشار بيده الي انفه واليدين، والركبتين، واطراف القدمين، ولا نكف الثياب ولا الشعر (¬) " (¬).



  CHECK [باب] بيان ايجاب الاعتدال في السجود. ووضع اليدين، ورفع المرفقين، وحظر بسط الذراعين فيه كبسط الكلب ذراعيه

 [باب] (¬) بيان ايجاب الاعتدال في السجود. ووضع اليدين، ورفع المرفقين (¬)، وحظر بسط الذراعين فيه كبسط الكلب ذراعيه   حدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، قال: ثنا عبيد الله بن اياد بن لقيط (¬)، قال: حدثني
 [] ابي (¬)، عن البراء، قال: قال رسول الله صلي الله عليه وسلم: "اذا سجدت فضع يديك، وارفع مرفقيك".



   حدثنا الصغاني، قال: ثنا ابو النضر (¬)، قال: ابنا شعبة (¬)، عن (¬) قتادة، قال: سمعت انس بن مالك يقول: قال النبي صلي الله عليه وسلم:
 [] "اعتدلوا في السجود، ولا يبسط احدكم ذراعيه بساط (¬) الكلب" (¬).



   وحدثنا (¬) يونس بن حبيب، قال: ثنا ابو داود (¬)، قال: ثنا شعبة (¬)، باسناده، "ولا يبسطن احدكم ذراعيه انبساط (¬) الكلب" (¬).



   حدثنا الربيع بن سليمان (¬) وابن ابي مسرة (¬)، قالا: ثنا الحميدي (¬)، قال: ثنا سفيان (¬)، قال: ثنا ابو سليمان عبد (¬) الله بن عبد الله بن اخي يزيد بن الاصم الاكبر منهما (¬) ، عن عمه يزيد بن الاصم (¬)، عن ميمونة، قالت: "كان النبي صلي الله عليه وسلم اذا سجد
 [] يجافي (¬) حتي لو ان بهمة (¬) ارادت ان تمر تحت (¬) يديه مرت".



   حدثنا الدبري (¬)، عن عبد الرزاق، قال: واخبرني ابن عيينة (¬)، عن عبيد الله بن عبد الله بن الاصم (¬)، عن يزيد بن الاصم، عن
 [] ميمونة (¬)، بنحوه (¬).



   حدثنا ابو داود السجزي (¬)، قال: ثنا قتيبة، قال: ثنا سفيان (¬)، عن عبيد الله بن عبد الله، عن يزيد بن الاصم، عن ميمونة [بنت الحارث] (¬): "ان النبي صلي الله عليه وسلم كان اذا سجد جافي بين يديه ... " الحديث (¬).   حدثنا عبد الله بن يعقوب بن فاذ ابو محمد (¬) المءدب (¬)
 [][ببغداد] (¬)  قال: ثنا عباد بن موسي (¬)، قال: ثنا مروان بن معاوية (¬)، عن عبيد الله بن عبد الله بن الاصم، عن يزيد بن الاصم، عن ميمونة قالت: "كان رسول الله صلي الله عليه وسلم اذا سجد خوي (¬) بيديه يعني: جنح (¬) (¬)  حتي يري وضح (¬) ابطيه من وراءه، واذا جلس اطمان
 [] علي فخذه اليسري".



   حدثنا علي بن حرب [الطاءي] (¬)، قال: ثنا هارون بن عمران (¬)، ح
 وحدثنا ابن ابي رجاء (¬)، قال: ثنا وكيع، ح
 وحدثنا ابو عمر الامام (¬)، قال: ثنا الحسين بن عياش (¬)، قالوا: ثنا جعفر بن برقان (¬)، عن يزيد بن الاصم، عن ميمونة، قالت: "كان النبي
 []صلي الله عليه وسلم اذا سجد جافي يديه حتي يري من خلفه وضح ابطيه" (¬).



   حدثنا الحسين بن اسحاق (¬) التستري، قال: ثنا عمرو بن سواد (¬)، قال: ثنا ابن وهب، قال: اخبرني عمرو بن الحارث، عن جعفر بن
 [] ربيعة (¬)، عن الاعرج، عن عبد الله ابن بحينة (¬)، قال: "كان رسول الله (¬) صلي الله عليه وسلم اذا سجد يجنح في سجوده حتي يري وضح ابطيه".



   حدثنا محمد بن عبد الله بن عبد الحكم (¬)، قال: ثنا اسحاق بن بكر بن مضر (¬)، عن ابيه (¬)، عن جعفر بن ربيعة، عن ابن هرمز (¬) الاعرج، عن عبد الله بن بحينة "ان رسول الله (¬) صلي الله عليه وسلم[كان (¬)] اذا
 [] سجد يفرج يديه حتي يري بياض ابطيه" (¬).



   حدثنا محمد بن اسماعيل (¬) المكي، ومعاوية بن صالح الدمشقي (¬)، وعثمان بن خرزاذ (¬)، قالوا: ثنا عفان (¬)، قال: ثنا همام (¬)،
 [] قال: ثنا محمد بن جحادة (¬)، قال: حدثني عبد الجبار بن واءل (¬)، عن علقمة بن واءل (¬)
 [] ومولي لهم (¬)، انهما حدثاه عن ابيه واءل بن حجر، "انه (¬) راي النبي صلي الله عليه وسلم يسجد (¬) بين كفيه".



  CHECK [باب] بيان قول المصلي في سجوده، وبيان انتصاب القدمين في السجود

 [باب] (¬) بيان قول المصلي في سجوده، وبيان انتصاب القدمين في السجود   حدثنا يونس بن عبد الاعلي (¬)، قال: ابنا ابن وهب، قال: اخبرني يحيي بن ايوب (¬)، عن عمارة بن غزية (¬)، عن سمي (¬) مولي ابي بكر، عن ابي صالح، عن ابي هريرة، ان رسول الله صلي الله عليه وسلم كان يقول في سجوده: "اللهم اغفر لي ذنبي كله دقه (¬) وجله، واوله واخره، وسره وعلانيته".   حدثنا ابو البختري عبد الله بن محمد بن شاكر العنبري (¬)، قال: ثنا يحيي بن ادم (¬) قال:
 [] ثنا مفضل (¬)، عن الاعمش، عن مسلم بن صبيح (¬)، عن مسروق (¬)، عن عاءشة قالت: "ما رايت رسول الله صلي الله عليه وسلم منذ نزل عليه {اذا جاء نصر الله والفتح ()} (¬) يصلي صلاة الا دعا فيها (¬)، قال فيها: "سبحانك ربي وبحمدك، اللهم اغفر لي" (¬).



   حدثنا الحسن بن عفان (¬)، قال: ثنا ابن نمير (¬)، عن
 [] الاعمش (¬)، عن مسلم (¬)، عن مسروق، عن عاءشة قالت: "لما نزلت هذه (¬) السورة {اذا جاء نصر الله والفتح ()} (¬) ما رايت رسول الله صلي الله عليه وسلم صلي صلاة الا قال: "سبحانك اللهم وبحمدك اللهم اغفر لي".



   حدثنا ابن ابي رجاء (¬)، قال: ثنا وكيع، ح
 وحدثنا الصغاني، قال: ثنا محمد بن كناسة (¬)، وقبيصة (¬)، قالوا: ثنا سفيان (¬)، عن منصور (¬)،
 [] عن ابي الضحي (¬)، عن مسروق، عن عاءشة، ان النبي صلي الله عليه وسلم كان يكثر ان يقول في سجوده وركوعه: "سبحانك اللهم وبحمدك، اللهم اغفر لي"، يتاول (¬) القران (¬).



   حدثنا ابن المنادي (¬)، قال: ثنا وهب بن جرير (¬)، ح
 وحدثنا ابو امية (¬)، قال: ثنا روح (¬)، كلاهما عن شعبة، عن منصور (¬)، عن ابي الضحي، عن مسروق، عن عاءشة قالت: كان رسول الله صلي الله عليه وسلم يكثر ان يقول في ركوعه وسجوده: "سبحانك وبحمدك
 [] اللهم اغفر لي" (¬).



   حدثنا الصغاني، قال: ثنا عبد الوهاب بن عطاء (¬)، قال: ثنا داود (¬)، عن الشعبي (¬) احسبه (¬) عن مسروق، شك داود (¬)  عن عاءشة ان النبي صلي الله عليه وسلم كان يكثر في اخر امره (¬) من قول "سبحان الله وبحمده، واستغفر الله واتوب اليه"، قالت (¬): فقلت:
 [] يا رسول الله، رايتك تكثر من هذا ما لم تكن تكثر؟ فقال رسول الله صلي الله عليه وسلم: "ان ربي خبرني اني ساري علامة في امتي، فاذا رايتها اكثرت ان اسبح بحمده واستغفره؛ انه كان توابا، وقد رايتها، وتلا: {اذا جاء نصر الله والفتح ()} (¬) السورة كلها.
 رواه عبد الاعلي، عن داود بن ابي هند، عن الشعبي، عن مسروق، عن عاءشة، بلا شك (¬).



   حدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، ح
 وحدثنا ابو امية (¬)، قال: ثنا روح (¬)، قالا: ثنا عبد العزيز بن
 [] ابي سلمة (¬)، قال: حدثني عمي الماجشون (¬)، عن عبد الرحمن الاعرج، عن عبيد الله بن ابي رافع، عن علي [رضي الله عنه] (¬) قال: "كان رسول الله صلي الله عليه وسلم اذا سجد قال: "اللهم لك سجدت وبك امنت، ولك اسلمت، سجد وجهي للذي خلقه، وصوره فاحسن صورته، وشق سمعه وبصره، تبارك الله احسن الخالقين" (¬).



   حدثنا يوسف بن مسلم (¬)، قال: ثنا حجاج، عن ابن جريج، قال: اخبرني موسي بن عقبة (¬)، عن عبد الله بن الفضل (¬)، عن عبد الرحمن الاعرج، عن عبيد الله (¬) بن ابي رافع، عن علي [رضي الله عنه] (¬)، قال: "كان النبي صلي الله عليه وسلم اذا سجد في الصلاة المكتوبة" فذكر حديثه بنحوه.   حدثنا (¬) الحسن بن علي [بن عفان] (¬) العامري، قال:
 [] ثنا ابو اسامة، قال: ثنا عبيد الله بن عمر، عن محمد بن يحيي بن حبان، عن [عبد الرحمن] (¬) الاعرج، عن ابي هريرة، عن عاءشة، قالت: فقدت النبي صلي الله عليه وسلم ذات ليلة، فلمست (¬) المسجد، فاذا هو ساجد، قدماه منصوبتان، وهو يقول: "اعوذ برضاك من سخطك، واعوذ بمعافاتك من عقوبتك، واعوذ بك منك، لا احصي ثناء عليك، انت كما اثنيت علي نفسك".



   حدثنا (¬) ابو داود الحراني، قال: ثنا ابو عتاب، قال: ثنا سعيد ابن ابي عروبة، وهشام، وهمام، عن قتادة، عن مطرف، عن عاءشة قالت: كان النبي صلي الله عليه وسلم يقول في ركوعه وسجوده: "سبوح قدوس رب الملاءكة والروح".   حدثنا (¬) الحسن بن عفان، قال: ثنا ابن نمير، عن الاعمش، عن سعد بن عبيدة، عن المستورد بن الاحنف، عن صلة بن زفر، عن حذيفة، ان النبي صلي الله عليه وسلم ركع، فجعل في ركوعه يقول: "سبحان ربي العظيم"، وفي سجوده "سبحان ربي الاعلي". مختصر.



  CHECK [باب] بيان ايجاب الاستواء في القعود والثبات بين السجدتين والنهي من عقب الشيطان، واباحة الاقعاء قال القدمين في الصلاة بين السجدتين

 [باب] (¬) بيان ايجاب الاستواء في القعود والثبات بين السجدتين والنهي من عقب الشيطان، واباحة الاقعاء قال القدمين في الصلاة بين السجدتين   حدثنا ابو الحسن الميموني (¬) والصغاني، قالا: ثنا يزيد بن هارون (¬)، ح
 وحدثنا الحارثي (¬)، قال: ثنا ابو اسامة، قالا: ثنا حسين المعلم، عن بديل بن ميسرة، عن ابي الجوزاء، عن عاءشة، قالت: "كان رسول الله صلي الله عليه وسلم اذا رفع راسه من السجود لم يسجد حتي يستوي جالسا، وكان ينهي
 [] عن عقب (¬) الشيطان، وينهي ان يفترش (¬) الرجل ذراعيه افتراش السبع" (¬).



   حدثنا ابو الازهر (¬)، قال: ثنا عبد الرزاق (¬)، قال: ابنا
 [] ابن جريج، قال: اخبرني ابو الزبير (¬)، انه سمع طاوسا (¬) يقول: "قلت لابن العباس (¬): الاقعاء (¬) علي القدمين؟ قال: "هي السنة" فقلنا: "انا لنراه جفاء بالرجل (¬) "؟ قال ابن عباس:
 [] "بل هي سنة نبيك صلي الله عليه وسلم " (¬) (¬).



   حدثنا الدبري، عن عبد الرزاق، بمثله (¬).   حدثنا الصغاني، قال: ثنا يحيي بن معين (¬)، قال: ثنا حجاج، عن ابن جريج، بنحوه (¬).



  CHECK [باب] بيان الرخصة في تسوية الحصي والتراب لموضع السجود في الصلاة مرة واحدة، والدليل علي انه مكروه الا عند الاضطرار اليه

 [باب] (¬) بيان الرخصة في تسوية الحصي والتراب لموضع السجود في الصلاة مرة واحدة، والدليل علي انه مكروه الا عند الاضطرار اليه   حدثنا يزيد بن سنان (¬)، قال: ثنا حماد بن مسعدة (¬)، قال: ثنا هشام الدستواءي (¬)، عن يحيي بن ابي كثير، عن ابي سلمة بن عبد الرحمن، عن معيقيب (¬)، ان النبي صلي الله عليه وسلم قال في تسوية الحصي
 [] "واحدة او دع" (¬).



   حدثنا ابن ابي رجاء (¬)، قال: ثنا وكيع (¬)، ح
 وحدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، قالا: ثنا هشام (¬)، عن يحيي باسناده: ذكر النبي صلي الله عليه وسلم المسح في المسجد يعني: الحصي قال: "ان كنت لا بد فاعلا فواحدة".    حدثنا الصغاني، قال: ثنا مسلم (¬)، قال: ثنا هشام، و (¬) قال: "وانت تصلي، فان كنت فاعلا فواحدة" تسوية الحصي.



   حدثنا محمد بن عبد الله بن ميمون (¬)، واحمد بن محمد الثقفي، قالا: ثنا الوليد بن مسلم، قال: ثنا الاوزاعي، قال: حدثني يحيي بن ابي كثير (¬)، قال: حدثني ابو سلمة، قال: حدثني معيقيب، ان رسول الله صلي الله عليه وسلم قال في الرجل يمسح التراب حيث يسجد قال: "ان كنت فاعلا فمرة واحدة".
 هذا لفظ الثقفي، ولفظ ابن ميمون: "قلت للنبي صلي الله عليه وسلم مسح التراب (¬) في الصلاة فقال: "ان كنت لا بد فاعلا فمرة واحدة".   حدثنا الصغاني، قال: ثنا يحيي بن ابي بكير (¬)، ح
 وحدثنا ابو امية، قال: ثنا ابو نعيم، قالا: ثنا شيبان (¬)، عن يحيي، عن ابي سلمة قال: حدثني معيقيب ان النبي صلي الله عليه وسلم قال في الرجل يمسح
 [] التراب حيث يسجد قال: "ان كنت فاعلا فمرة (¬) " (¬).
 قال ابو عوانة: "معيقيب بن ابي فاطمة حليف بني عبد شمس بدري".



  CHECK [باب] بيان ايجاب سجدتي السهو علي الملبس عليه صلاته، فلم يدر كم صلي، والدليل علي اجازتها وهو قاعد في التشهد من غير ان يقوم لها، وعلي اجازة صلاته دون رجوعه الي يقينه وبناءه عليه، وبيان الخبر المعارض له الدال قال انها غير جاءزة اذا لم يرجع الي اليقين، وبيان ايجاب طرح الشاك شكه في صلاته، والرجوع فيها الي يقينه، وسجوده سجدتي السهو قبل ان يسلم، والدليل قال ان الشاك في صلاته اذا رجع الي يقينه يقينه سجد سجدتي السهو قبل السلام

 [باب] (¬) بيان ايجاب سجدتي السهو علي الملبس عليه صلاته (¬)، فلم يدر كم صلي، والدليل علي اجازتها وهو قاعد في التشهد من غير ان يقوم لها، وعلي اجازة صلاته دون رجوعه الي يقينه وبناءه عليه، وبيان الخبر المعارض له الدال قال انها غير جاءزة اذا لم يرجع الي اليقين، وبيان ايجاب طرح الشاك شكه في صلاته، والرجوع (¬) فيها الي يقينه، وسجوده سجدتي السهو قبل ان يسلم، والدليل قال ان الشاك في صلاته اذا رجع الي يقينه يقينه سجد سجدتي السهو قبل السلام   اخبرنا يونس بن عبد الاعلي، قال: ثنا ابن وهب، ح
 وحدثني ابو اسماعيل (¬)، عن
 [] القعنبي (¬)، كلاهما عن مالك (¬)، عن ابن شهاب، عن ابي سلمة (¬)، عن ابي هريرة، ان رسول الله صلي الله عليه وسلم قال: "اذا قام احدكم يصلي، جاء الشيطان فلبس (¬) عليه صلاته، فلا يدري (¬) كم صلي، فاذا وجد احدكم ذلك
 [] فليسجد سجدتين وهو جالس" (¬).



   حدثنا ابو داود الحراني (¬)، والعباس بن محمد (¬)، قالا: ثنا يعقوب بن ابراهيم بن سعد (¬)، قال: ثنا ابي، عن صالح (¬)، عن ابن شهاب (¬)، ان ابا سلمة بن عبد الرحمن اخبره، ان ابا هريرة اخبره، ان
 [] رسول الله صلي الله عليه وسلم قال: "ياتي احدكم الشيطان (¬) فيلبس عليه صلاته حتي لا يدري كم صلي، فاذا وجد ذلك احدكم فليسجد سجدتين، وهو جالس".



   حدثنا ابو امية (¬)، قال ابنا ابو اليمان (¬) قال: ابنا شعيب (¬)، والحسن بن موسي (¬)، نا (¬) الليث (¬)، وابو عاصم (¬)، عن ابن ابي ذءب (¬)، كلهم عن ابن شهاب (¬)، بمثله.
 [] ورواه ابن عيينة عن الزهري، بنحوه (¬).



   حدثنا احمد بن عصام (¬)، قال: ثنا ابو عامر العقدي (¬)، قال: ثنا هشام الدستواءي (¬)، عن يحيي بن ابي كثير، عن ابي سلمة، عن ابي هريرة، ان النبي صلي الله عليه وسلم قال: "اذا نودي بالصلاة (¬) ادبر الشيطان وله ضراط، حتي لا يسمع الاذان، فاذا قضي الاذان اقبل، فاذا ثوب (¬)
 [] بها ادبر، فاذا قضي التثويب اقبل حتي (¬) يخطر (¬) بين المرء ونفسه؛ يقول: اذكر كذا (¬) لما لم يكن يذكر حتي يظل الرجل لا يدري (¬) كم صلي. فاذا لم يدر (¬) كم صلي ثلاثا ام اربعا فليسجد سجدتي السهو (¬) وهو جالس" (¬).



   حدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، ح
 وحدثنا ابن ابي عبد الله المقرء (¬)، قال: ثنا
 عبد الوهاب (¬)، قالا: ثنا هشام الدستواءي، بمثله، والمعني واحد.   حدثنا عباس الدوري، قال: ثنا خالد بن مخلد (¬) القطواني (¬)، ح
 وحدثنا الصغاني (¬) قال: ثنا موسي بن داود (¬)، قالا: ثنا سليمان بن بلال (¬)، عن زيد بن اسلم (¬)، عن عطاء بن يسار (¬)، عن ابي سعيد الخدري، قال: قال رسول الله صلي الله عليه وسلم: "اذا شك احدكم في صلاته، فلم يدر
 [] كم صلي ثلاثا (¬) او اربعا فليطرح الشك، وليبن علي ما يستيقن، ثم (¬) ليسجد سجدتين، وهو جالس (¬)، فان كان صلي خمسا شفع (¬) بها صلاته، وان كان [صلي] (¬) اربعا كانتا ترغيما للشيطان" (¬).



   حدثنا محمد بن عوف الحمصي، قال: ثنا عثمان بن سعيد (¬)، قال: ثنا ابو غسان (¬)، عن زيد بن اسلم (¬)، باسناده، [مثله] (¬)،
 [] الا ان سليمان زاد في حديثه، قال: "سجد سجدتين وهو جالس قبل ان يسلم" (¬).



   حدثنا الصغاني وابو امية، قالا: ثنا موسي بن داود، قال: ثنا عبد العزيز بن ابي سلمة (¬)، عن زيد بن اسلم باسناده مثل حديث ابي غسان وسليمان بن بلال، غير تلك الكلمة التي بينت: "قبل ان يسلم" فقط.   حدثنا يونس بن عبد الاعلي، قال: ابنا ابن وهب، عن هشام بن سعد (¬)، عن زيد بن اسلم (¬)، بمثل حديث سليمان بن بلال
 [] بتمامه، وذكر الكلمة: "ليسجد سجدتين وهو جالس قبل السلام" (¬).



  AUTO باب الاباحة لناسي التشهد في الركعتين الاوليين من الظهر وغيره ونهض ان يمضي في صلاته ولا يقعد، وان يسجد سجدتين يكبر في كل سجدة منهما قبل التسليم، ثم يسلم

   حدثنا يونس بن عبد الاعلي، قال: ابنا ابن وهب، قال: حدثني مالك (¬) والليث (¬)، وعمرو بن الحارث (¬)، ويونس بن يزيد، ان ابن شهاب اخبرهم، عن عبد الرحمن الاعرج، ان عبد الله ابن بحينة (¬) حدثه، ان رسول الله صلي الله عليه وسلم قام في اثنتين من الظهر فلم يجلس (¬)؛ فلما قضي صلاته سجد سجدتين، يكبر في كل سجدة وهو جالس قبل ان يسلم، وسجد (¬) الناس معه مكان ما نسي من الجلوس" (¬).
 [] رواه ابن عيينة عن الزهري، بنحوه وقال: "فلما كان في اخر صلاته سجد سجدتين قبل ان يسلم" (¬).



   حدثنا ابن مهل (¬) ومحمد بن الصباح (¬)، قالا: ثنا عبد الرزاق، عن معمر، ح
 وحدثنا الصغاني وابو امية، قالا: ثنا ابو اليمان، قال: ابنا شعيب، كلاهما عن (¬) الزهري، بحديثهما فيه (¬).   حدثنا ابن عبد الحكم (¬) ويزيد بن سنان (¬)، عن اسحاق بن بكر بن مضر (¬)، عن ابيه، عن جعفر بن ربيعة، عن الاعرج (¬)، بحديثه فيه (¬).



   حدثنا عبد الرحمن بن بشر (¬)، قال: ثنا يحيي بن سعيد القطان، [ح] (¬)
 وحدثنا يزيد بن سنان، قال: ثنا عمر بن عمران السدوسي (¬)، قالا: ثنا يحيي بن سعيد الانصاري (¬)، عن الاعرج، عن عبد الله ابن بحينة، انه
 [] صلي مع رسول الله صلي الله عليه وسلم الظهر. فذكره (¬) (¬).



   حدثنا عمار بن رجاء (¬)، قال: ثنا يزيد (¬)، قال: ثنا يحيي (¬)، عن الاعرج (¬)، اخبره عن ابن بحينة، "ان النبي صلي الله عليه وسلم قام في اثنين من الظهر او العصر، فلم يسترح، فلما اعتدل قاءما لم يرجع (¬) حتي فرغ من صلاته، ثم سجد سجدتين وهو جالس، فلما فرغ انتظرناه ان يسلم، فسجد بنا قبل التسليم، ثم سلم".
 [هذا] لفظ [حديث] (¬) يزيد (¬).



  CHECK [باب] بيان الاباحة للمسلم في الركعتين الاوليين من الظهر والعصر ناسيا ان يبني علي صلاته، وان ولي ظهره الي القبلة، او خرج من المسجد، او تكلم. وسجد سجدتي السهو بعد فراغه من صلاته، او بعد ان يسلم. وكذلك الامام والمامومون اذا تكلموا في امر الصلاة، والدليل علي ان الامام اذا كان ذلك منه، فذكره واحد من المامومين، ان عليه ان يسال غيره، فان صدقوه استعمل قولهم، وعلي ان سجدتي السهو بعد السلام اذا استيقن بزيادة في صلاته

 [باب] (¬) بيان الاباحة للمسلم في الركعتين الاوليين من الظهر والعصر ناسيا ان يبني علي صلاته، وان ولي ظهره الي القبلة، او خرج من المسجد، او تكلم. وسجد سجدتي السهو بعد فراغه من صلاته، او بعد ان يسلم. وكذلك الامام والمامومون اذا تكلموا في امر الصلاة، والدليل علي ان الامام اذا كان ذلك منه، فذكره واحد من المامومين، ان عليه ان يسال غيره، فان صدقوه استعمل قولهم، وعلي ان سجدتي السهو بعد السلام اذا استيقن بزيادة في صلاته   حدثنا ابو اسماعيل (¬)، قال: ثنا الحميدي (¬)، قال: ثنا سفيان (¬)، قال: ثنا ايوب (¬)، عن محمد (¬)، عن ابي هريرة، قال: "صلي بنا
 [] رسول الله صلي الله عليه وسلم "، ح
 وحدثنا الصغاني، قال: ثنا زهير (¬)، قال: ثنا ابن عيينة، عن ايوب، عن محمد، قال: سمعت ابا هريرة يقول: "صلي بنا رسول الله صلي الله عليه وسلم احدي صلاتي العشي (¬): اما الظهر واما العصر، واكثر علمي (¬) انها العصر، فسلم في ركعتين، ثم اتي جذعا (¬) في المسجد (¬) فاسند ظهره اليه.
 قال: وفي القوم ابو بكر وعمر [رضي الله عنهما] (¬)، فهاباه (¬) ان
 [] يكلماه، وخرج سرعان الناس (¬)، فقال ذو اليدين (¬): "يا رسول الله، اقصرت الصلاة ام نسيت؟ (¬) " قال: "ما يقول ذو اليدين؟ " فقالوا: "صدق ذو اليدين"، (¬) (¬) فقام، فصلي ركعتين، ثم سلم، ثم كبر فسجد، ثم كبر فرفع، ثم كبر فسجد مثل سجوده او اطول (¬)، ثم كبر فرفع".
 قال ابن سيرين: "واخبرت عن عمران بن حصين: "ثم (¬) سلم".
 واللفظ للصغاني، ومعني حديثهما واحد (¬).



   حدثنا البرتي (¬)، قال: ثنا ابو عمر (¬)، قال: ثنا يزيد بن ابراهيم (¬)، قال: ثنا محمد بن سيرين (¬)، قال: قال ابو هريرة: "صلي رسول الله صلي الله عليه وسلم احدي صلاتي العشي". وذكر الحديث (¬).   اخبرنا يونس بن عبد الاعلي، قال: ابنا ابن وهب ح
 [] وحدثنا محمد بن حيويه (¬)، قال: ثنا مطرف (¬)، جميعا قالا: ثنا مالك، عن ايوب (¬)، ح
 وحدثنا ابو داود (¬)، قال: حدثنا محمد بن عبيد (¬)، قال: ثنا حماد (¬)، عن ايوب، بحديثهما فيه (¬).



   اخبرنا يونس بن عبد الاعلي، قال: ابنا ابن وهب، ان مالكا (¬) حدثه، عن داود بن الحصين (¬)،
 [] عن ابي سفيان (¬)
 []مولي ابن ابي احمد (¬)  قال: سمعت ابا هريرة يقول: "صلي لنا رسول الله صلي الله عليه وسلم العصر (¬)، فسلم في ركعتين،
 [] فقال (¬) ذو اليدين: "اقصرت الصلاة يا رسول الله ام نسيت"؟ فقال رسول الله صلي الله عليه وسلم: "كل ذلك لم يكن (¬) " فقال: قد كان بعض ذلك يا رسول الله"، فاقبل رسول الله صلي الله عليه وسلم علي الناس؛ فقال: "صدق ذو اليدين"؟ قالوا (¬): "نعم"، فاتم رسول الله صلي الله عليه وسلم ما بقي عليه من الصلاة، ثم سجد سجدتين وهو جالس بعد التسليم" (¬).



   حدثنا يزيد بن سنان وابو اسماعيل، قالا: ثنا القعنبي، عن مالك، بمثله.
 اخبرنا يونس بن عبد الاعلي (¬)، قال: قال ابن وهب: قال مالك: "كل سهو كان نقصانا من الصلاة فان سجوده قبل التسليم، وكل سهو كان زيادة في الصلاة فان سجوده بعد التسليم" (¬).



   حدثنا عباس الدوري، وابو داود الحراني (¬)، قالا: ثنا
 [] هارون بن اسماعيل (¬)، قال: ثنا علي بن المبارك (¬)، قال: ثنا يحيي بن ابي كثير، قال: حدثني ابو سلمة، قال: سمعت ابا هريرة يقول: "ان رسول الله صلي الله عليه وسلم صلي ركعتين في صلاة الظهر (¬) ثم سلم، فاتاه رجل من بني سليم (¬) فقال: "يا رسول الله، اقصرت الصلاة ام نسيت"؟ قال: "لم تقصر ولم انس"، قال: "يا رسول الله، انما صليت ركعتين"، قال: "احق ما يقول ذو اليدين" (¬)؟ قالوا: "نعم"، فقام، فصلي بهم ركعتين اخراوين (¬)، ثم سجد سجدتين وهو جالس".



   حدثنا يزيد بن سنان، قال: ثنا حبان (¬)، قال: ثنا ابان (¬)، عن يحيي، بحديثه فيه (¬) (¬).
 رواه محمد بن سابق (¬) عن شيبان (¬)، عن يحيي، نحوه (¬).
 قال ابو عوانة: قال بعض الناس (¬): ذو اليدين وذو الشمالين واحد،
 [] ويحتجون بحديث رواه الزهري فقال فيه: "فقام ذو الشمالين، فقال: اقصرت الصلاة يا رسول الله؟ " (¬)، ويطعنون في هذا الحديث
 [] بان ذا (¬) الشمالين قتل يوم بدر، وان ابا هريرة لم يدركه؛ لانه اسلم قبل وفاة النبي صلي الله عليه وسلم بثلاث سنين، او اربع.
 وليس كما يقولون، وذلك ان (ذا (¬) اليدين) ليس هو: (ذا (¬) الشمالين)؛ لان ذا (¬) اليدين رجل قد سماه بعضهم: (الخرباق) (¬)، عاش بعد النبي صلي الله عليه وسلم ومات بذي خشب (¬)
 [] علي عهد عمر (¬).
 وذو الشمالين (¬) هو: ابن عبد عمرو (¬) حليف لبني زهرة (¬) وقد صح في هذه الاحاديث انه (¬) صلي مع النبي صلي الله عليه وسلم تلك الصلاة (¬).
 [] والطاعن في هذا الحديث (¬) يحتج ايضا بان الكلام منسوخ في الصلاة، وانه يعيد الصلاة اذا كان ذلك منه مثل ما كان من النبي صلي الله عليه وسلم واصحابه (¬). وليس كما يقول؛ اذ (¬) حظر الكلام في الصلاة اذا تعمد. وقد كان مباحا فنسخ بمكة. وما ذكر من حديث ذي اليدين (¬) كان
 [] بالمدينة، فلا ينسخ الاول الاخر (¬).
 والذي يجب: اتباع الحديثين كلاهما (¬)، في العمد علي اعادة الصلاة (¬)؛ اذ النبي صلي الله عليه وسلم قال: "ان مما احدث الله: ان لا يتكلموا في الصلاة" (¬). وقال: "ان هذه الصلاة لا يصلح فيها شء من
 [] كلام الناس" (¬).
 فاذا (¬) تكلم في صلاته عمدا ولم يعلم انه لا يجوز، او اخطا المتكلم (¬) بعد ما يستيقن انه قد اتم الصلاة، ولم يتمها، من امام او ماموم، او الماموم اذا ذكر الامام بكلامه او اجابة (¬) الامام علي ما اجابوا النبي صلي الله عليه وسلم، انه مباح له ان يبني علي صلاته، ولا يكون عليه اعادة؛ والنبي صلي الله عليه وسلم قال: "اذا نسيت فذكروني" (¬).



  CHECK باب [بيان] التسليم بعد سجدتي السهو، والبناء علي صلاته بعه دخوله منزله، ورجوعه الي مصلاه اذا كان ناسيا

 باب [بيان] (¬) التسليم بعد سجدتي السهو، والبناء علي صلاته (¬) بعه دخوله منزله، ورجوعه الي مصلاه اذا كان ناسيا   حدثنا ابو داود السجزي (¬)، قال: نا مسدد، قال: ثنا يزيد بن زريع (¬) ومسلمة بن محمد (¬)، قالا: ثنا خالد الحذاء (¬)، قال: ثنا
 [] ابو قلابة (¬)، عن ابي المهلب (¬)، عن عمران بن حصين، قال: "سلم رسول الله صلي الله عليه وسلم في ثلاث ركعات (¬) من العصر (¬)، ثم دخل" قال غير
 [] مسلمة (¬): الحجرة. فقام اليه رجل يقال له: "الخرباق" (¬)  وكان
 [] طويل (¬) اليدين وقال: "اقصرت الصلاة يا رسول الله"؟ فخرج مغضبا يجر رداءه (¬)، فقال: "اصدق"؟، قالوا: "نعم" فصلي تلك (¬) الركعة، ثم سلم، ثم سجد سجدتيها، ثم سلم".



   حدثنا ابراهيم بن مرزوق، وابو امية، والصغاني، قالوا: ثنا سليمان بن حرب (¬)، قال: ثنا حماد بن زيد، عن خالد الحذاء، بحديثه فيه (¬).   حدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، ثنا شعبة،
 [] عن خالد الحذاء (¬)، عن ابي قلابة، عن ابي المهلب، عن عمران بن حصين، قال: "صلي رسول الله صلي الله عليه وسلم[الظهر او العصر ثلاث ركعات، ثم سلم] (¬)، فقال رجل من اصحاب النبي صلي الله عليه وسلم يقال له: "الخرباق" او "الخرباق": "اقصرت الصلاة "؟ فسال النبي صلي الله عليه وسلم فاذا هو كما قال (¬)، فصلي ركعة، ثم سلم، ثم سجد سجدتين، ثم سلم" (¬).



   حدثني الاخطل بن الحكم الدمشقي (¬)، قال: ثنا بقية (¬)، ح
 [] وحدثنا ابن عوف الحمصي (¬)، عن الربيع بن روح (¬)، قال: ثنا بقية، قال: ثنا شعبة، عن خالد الحذاء، وابن عون (¬)، عن ابن سيرين (¬)، عن ابي هريرة، "ان رسول الله صلي الله عليه وسلم سجد في وهم بعد التسليم" (¬).



   حدثنا محمد بن يحيي (¬) ومحمد بن ادريس الرازي (¬)، قالا:
 [] ثنا محمد بن عبد الله الانصاري (¬) قال: ثنا اشعث (¬)، عن محمد بن سيرين (¬)، عن خالد الحذاء، عن ابي قلابة، عن ابي المهلب، عن عمران بن حصين، "ان النبي صلي الله عليه وسلم صلي بهم، فسها؛ فسجد سجدتين، ثم تشهد، ثم سلم (¬) ".



  CHECK [باب] بيان ايجاب سجدتي السهو علي الشاك في صلاته، وان الامام اذا نسي من صلاته يجب قال الماموم ان يذكره، وان الشاك في صلاته اذا لم يرجع الي اليقين في الزيادة، والنقصان، فتوخي الصواب سجد سجدتي السهو بعد الصلاة، ثم سلم

 [باب] (¬) بيان ايجاب سجدتي السهو علي الشاك في صلاته، وان الامام اذا نسي من صلاته يجب قال الماموم ان يذكره، وان الشاك في صلاته اذا لم يرجع الي اليقين في الزيادة، والنقصان، فتوخي الصواب (¬) سجد سجدتي السهو بعد الصلاة، ثم سلم   حدثنا ابو داود السجزي (¬)، قال: ثنا عثمان بن ابي شيبة (¬)، قال: ثنا جرير (¬)، عن منصور (¬)، عن ابراهيم، عن علقمة، قال: قال عبد الله: "صلي رسول الله صلي الله عليه وسلم قال ابراهيم: فلا ادري! (¬)
 [] زاد او نقص (¬)  فلما سلم قيل: (¬) يا رسول الله احدث في الصلاة شء؟ قال: "وما ذاك"؟ قالوا: "صليت كذا وكذا" قال: فثني (¬) رجليه، واستقبل القبلة، فسجد سجدتين، ثم سلم، فلما انفتل (¬) اقبل عليهم بوجهه فقال: "انه لو حدث في الصلاة شء انباتكم، ولكن
 [] انما انا (¬) بشر انسي كما تنسون، فاذا نسيت فذكروني، واذا شك احدكم في صلاته، فليتحر (¬) الصواب، فليتم عليه، ثم ليسلم (¬)، ثم ليسجد سجدتين" (¬).



  CHECK [باب] بيان الدليل علي اجازة صلاة الشاك فيها اذا كان اكثر وهمه انه الصواب وان لم يرجع الي يقينه، اذا سجد سجدتي السهو، وصفة سجوده، وانه يسجدهما بعد ما يسلم

 [باب] (¬) بيان الدليل علي اجازة صلاة الشاك فيها اذا (¬) كان اكثر وهمه انه الصواب وان لم يرجع الي يقينه، اذا سجد سجدتي السهو، وصفة سجوده، وانه يسجدهما بعد ما يسلم   حدثنا علي بن اشكاب (¬)، وابو داود الحراني، والحسن بن علي بن (¬) عفان، قالوا: ثنا محمد بن عبيد (¬)، ح
 وحدثنا ابن ابي رجاء المصيصي (¬)، قال: ثنا وكيع (¬)، قالا: ثنا مسعر،
 [] عن منصور، عن ابراهيم، عن علقمة، عن عبد الله قال: قال رسول الله صلي الله عليه وسلم: "انما انا بشر انسي كما تنسون، فايكم شك في صلاته فلينظر احري (¬) ذلك للصواب، فليتم عليه، ثم ليسجد سجدتين".
 وهذا لفظ محمد بن عبيد (¬).
 وقال (¬) وكيع: "فليتحر الصواب، ثم ليسجد سجدتين" (¬).



   حدثنا يحيي بن عياش البغدادي (¬) قال: ثنا وهب بن (¬) جرير، قال: ثنا شعبة (¬)، عن منصور، عن ابراهيم، عن علقمة، عن عبد الله قال: "صلي بنا رسول الله صلي الله عليه وسلم فزاد او نقص شك (¬) علقمة او
 [] ابراهيم فسلم ثم اقبل علينا بوجهه فقال: "انه لو حدث في الصلاة شء لحدثتكم، ولكن انما انا بشر انسي كما تنسون، فاذا نسيت فذكروني، فاذا شك احدكم فليتحر اقرب ذلك الي الصواب، فليبن عليه، وليسجد سجدتين وهو جالس (¬) " (¬).



   حدثنا الصغاني، قال: ثنا احمد بن اسحاق الحضرمي (¬)، [ح] (¬) (¬)
 وحدثنا يونس (¬)، قال: ابنا يحيي بن حسان (¬)، قالا: ثنا وهيب، قال:
 [] ثنا منصور، عن ابراهيم، عن علقمة، عن عبد الله، قال: "صلي بنا رسول الله صلي الله عليه وسلم صلاة فزاد فيها او نقص قال: واكثر ظني انه قال: نقص (¬)  فلما سلم قال الناس: يا رسول الله، احدث في الصلاة شء؟ قال: "وما احدث فيها شء، ولو حدث فيها شء لاخبرتكم"، ثم قال: "وما ذاك (¬) "؟، فاخبر بصنيعه (¬)، فثني رجليه، وسجد سجدتين، ثم سلم، وقال: "انما انا (¬) بشر انسي كما تنسون، فاذا نسيت فذكروني، واذا احدكم صلي صلاة فلم يدر: ازاد او نقص، فلينظر احري ذلك للصواب (¬)، فليتمه، وليسجد سجدتين، ثم ليسلم".



   حدثنا ابو العباس الغزي (¬)، قال: ثنا الفريابي، قال: ثنا سفيان (¬)، عن منصور، عن ابراهيم، عن علقمة، عن عبد الله، عن النبي صلي الله عليه وسلم قال: "اذا سهي الرجل في الصلاة فلم يدر ازاد او نقص، فليتوخ (¬)، ثم ليسجد سجدتي سهوه".
 ورواه غير الفريابي (¬)، قال (¬): "فليتحر الصواب"، عن سفيان (¬).



   حدثنا ابو امية، قال: ثنا عبيد الله بن موسي، قال: ثنا اسراءيل، عن منصور، باسناده، بنحو حديث وهيب، "فلينظر (¬) احري ذلك للصواب، فليتم عليه، وليسجد سجدتين، وهو جالس".   حدثنا موسي بن سفيان (¬)، قال: حدثنا عبد الله بن الجهم (¬)، عن عمرو بن ابي قيس (¬)، عن منصور،
 [] باسناده (¬)، مثله، وذكر حديثه فيه.



   حدثنا ابو امية، قال: ثنا زكريا بن عدي (¬)، قال: ثنا فضيل بن عياض (¬)، عن منصور، عن ابراهيم، عن علقمة، عن عبد الله، قال: "صلي بنا رسول الله صلي الله عليه وسلم وذكر الحديث وقال فيه: "فليتحر الذي يري انه الصواب" (¬).
 وقال غندر، عن شعبة: "فليتحر اقرب ذلك الي الصواب" (¬).



   حدثنا بشر بن موسي (¬)، قال: ثنا الحميدي (¬)، قال: ثنا جرير بن عبد الحميد، عن منصور، عن ابراهيم، عن علقمة، عن عبد الله بن مسعود، قال: "صلي رسول الله صلي الله عليه وسلم صلاة فلا ادري ازاد ام نقص شك منصور، فلما سلم قيل له: "يا رسول الله، هل حدث في الصلاة شء؟ " قال: "وما ذاك"؟ قالوا: "صليت كذا وكذا"، فثني رجليه فسجد سجدتين، ثم سلم، ثم اقبل عليهم، فقال: "انه لو حدث في الصلاة شء لاخبرتكم، ولكن انما انا بشر، انسي كما تنسون (¬)، فاذا نسيت فذكروني، واذا شك احدكم في الصلاة فليتحر الصواب، فليتم عليه، فاذا سلم فيسجد (¬) سجدتين" (¬).



  CHECK [باب] بيان الدليل علي ايجاب قضاء سجدتي السهو اذا نسيهما الساهي في صلاته، وان انصرف منهما، او تكلم، عاد فسجدهما

 [باب] (¬) بيان الدليل علي ايجاب قضاء سجدتي السهو اذا نسيهما الساهي في صلاته، وان انصرف منهما، او تكلم، عاد فسجدهما   حدثنا حمدان بن الجنيد (¬)، قال: ثنا الحميدي، ح
 وحدثنا الصغاني، قال: ثنا زكريا بن عدي، كلاهما عن ابي معاوية (¬)، قال: ثنا الاعمش، عن ابراهيم، عن علقمة، عن عبد الله، ان رسول الله صلي الله عليه وسلم سجد سجدتي السهو بعد الكلام (¬).



   حدثنا ابو العباس عبد الله بن محمد بن الجراح الازدي (¬)، قال: ثنا الفريابي، قال: ثنا سفيان (¬)، عن الحسن بن عبيد الله (¬)، عن ابراهيم (¬)، عن علقمة، انه صلي خمسا (¬) فقال ابراهيم: انك صليت خمسا، قال: "وتقول ذلك يا اعور"؟ فقال: نعم، فثني رجليه، فسجد سجدتين وهو جالس، ثم حدث عن عبد الله، عن رسول الله صلي الله عليه وسلم انه فعل هكذا (¬).   حدثنا الغزي (¬)، قال: ثنا قبيصة (¬)، عن سفيان (¬)، عن
 [] الحسن بن عبيد الله (¬)، عن ابراهيم [بن سويد] (¬)، عن علقمة، عن ابن مسعود، "ان النبي صلي الله عليه وسلم صلي خمسا ثم سجد سجدتي السهو وهو جالس".



   حدثنا الدبري (¬)، عن عبد الرزاق (¬)، عن الثوري، عن الحسن بن عبيد الله (¬)، عن ابراهيم، عن علقمة، انه صلي خمسا، فقيل له: "يا ابا شبل، صليت خمسا". وذكر (¬) الحديث (¬).   حدثنا الصغاني، ومحمد بن الجنيد الدقاق (¬)، قالا: ثنا معاوية بن عمرو (¬) [ح (¬)]
 وحدثنا ابو عبيد الله (¬)، قال:
 [] ثنا ابو داود (¬)، قالا: ثنا زاءدة، عن الحسن بن عبيد الله (¬)، عن ابراهيم بن سويد، قال: "صلي علقمة بنا الظهر خمسا، فلما انصرف قالوا له: صليت خمسا فقال (¬): ما فعلت، ثم قال لي: اكذاك يا اعور؟ فقلت: نعم، فانفتل (¬)، فسجد سجدتين، ثم ذكر عن (¬) عبد الله، ان النبي صلي الله عليه وسلم صلي خمسا، قال: فراهم يتوشوشون (¬)، فقال: "ما لكم"؟ فقالوا: ازيد من الصلاة؟ فقال: "وما ذاك"، قالوا: صليت خمسا، قال: "لا، ولكن سهوت"، فانفتل، فسجد سجدتين، ثم سلم". واللفظ للصاغاني.



   حدثنا الصغاني، قال: ابنا ابو خيثمة (¬)، قال: ثنا
 [] عبد الله بن ادريس (¬)، عن الحسن بن عبيد الله، عن ابراهيم، قال: "صلي بنا علقمة، فصلي خمسا"، ثم ذكر نحوه عن عبد الله، ان النبي صلي الله عليه وسلم صلي بهم خمسا، فقيل له في ذلك، فسجد سجدتين، وقال: "انما انا بشر انسي كما تنسون" (¬).



   حدثنا بشر بن موسي، قال: ثنا الحميدي (¬)، قال: ثنا جرير.
 وحدثنا ابو داود (¬)، قال: ثنا يوسف بن موسي (¬)، قال: ثنا جرير، عن الحسن بن عبيد الله (¬)، عن ابراهيم بن سويد، عن علقمة، قال: قال
 [] عبد الله: "صلي بنا رسول الله صلي الله عليه وسلم خمسا، فلما انفتل توشوش القوم بينهم، فقال: "ما شانكم"؟ قالوا: يا رسول الله، هل زيد في الصلاة؟ قال: "لا"، قالوا: فانك قد صليت خمسا، فانفتل، فسجد سجدتين، ثم سلم، ثم قال: "انما انا بشر، انسي كما تنسون".
 وهذا لفظ ابي داود.



  CHECK باب [بيان] ايجاب سجدتي السهو علي الساهي في صلاته، وعلي من زاد فيها او نقص، واجازة الصلاة اذا صلي الظهر او العصر خمسا، او زاد في صلاته علي ما يجب، والدليل علي ان المصلي اذا رجع الي اليقين بانه زاد في صلاته ركعة، سجد سجدتي السهو بعد ما يسلم، وكانت صلاته تامة

 باب [بيان] (¬) ايجاب سجدتي السهو علي الساهي في صلاته، وعلي من زاد فيها او نقص، واجازة الصلاة اذا صلي الظهر او العصر خمسا، او زاد في صلاته علي ما يجب، والدليل علي ان المصلي اذا رجع الي اليقين بانه (¬) زاد في صلاته ركعة، سجد سجدتي السهو بعد ما يسلم (¬)، وكانت صلاته تامة   حدثنا الصغاني، قال: ثنا عاصم بن علي (¬)، قال: ثنا ابو بكر النهشلي (¬)،
 [] عن عبد الرحمن بن الاسود (¬)، عن ابيه (¬)، عن عبد الله قال: صلي بنا النبي صلي الله عليه وسلم خمسا، فلما انصرف (¬) قيل له (¬): يا رسول الله، ازيد في الصلاة؟ قال: "لا"، قالوا: بلي، صليت خمسا، قال لهم (¬): "انما انا بشر مثلكم (¬)، اذكر كما تذكرون (¬)، وانسي كما تنسون"، ثم سجد سجدتي السهو (¬).



   حدثنا الصغاني، قال: ثنا زكريا بن عدي (¬)، قال: ثنا حفص (¬)، عن
 [] الاعمش (¬)، عن ابراهيم، عن علقمة، عن عبد الله، قال: صلي رسول الله صلي الله عليه وسلم صلاة، فاما زاد واما نقص، فلما قضي الصلاة، قلت: اوهمت؟ اما زدت واما نقصت، فقال: "انما انا بشر انسي كما تنسون، فمن وجد من ذلك شيءا فليسجد سجدتين". ثم اقبل علي القبلة، فسجد سجدتين، ثم سلم (¬).



   حدثنا حمدان بن الجنيد [الدقاق] (¬)، والصغاني، قالا: ثنا معاوية بن عمرو (¬)، قال:
 [] ثنا زاءدة (¬)، قال: ثنا الاعمش، عن ابراهيم، عن علقمة، عن (¬) عبد الله، قال: صلينا مع رسول الله صلي الله عليه وسلم فاما زاد او (¬) نقص، قال ابراهيم: وايم الله (¬) ما جاء ذاك الا من قبلي قال: فقلنا: يا رسول الله، احدث في الصلاة شء؟ قال: "لا"، فقلنا له الذي صنع، فقال: "اذا زاد الرجل او نقص فليسجد سجدتين". قال: ثم سجد سجدتين" (¬).



  AUTO باب الدليل قال ايجاب السجود علي من قرا السجدة، واثبات السجدات في السور

   حدثنا علي بن حرب (¬)، قال: ثنا ابو معاوية (¬) ح
 وحدثنا الاحمسي (¬)، قال: ثنا يعلي (¬)، [ح] (¬)
 وحدثنا علي بن حرب [ايضا] ثنا يعلي ومحمد الاحدب (¬) ابنا (¬) عبيد، ح
 [] وحدثنا ابو داود (¬)، ثنا يعلي (¬) ومحاضر (¬)، ح
 وحدثنا ابن ابي رجاء (¬)، قال: ثنا وكيع (¬)، كلهم عن الاعمش (¬)، عن ابي صالح (¬)، عن ابي هريرة، عن النبي صلي الله عليه وسلم قال: "اذا قرا ابن ادم السجدة فسجد، اعتزل الشيطان يبكي يقول: يا ويله (¬) امر ابن ادم
 [] بالسجود فسجد فله الجنة، وامرت بالسجود فابيت فلي النار". قال يعلي: "فعصيت" (¬).



   حدثنا الزعفراني (¬)، قال: ثنا ابو معاوية (¬) وكيع، عن الاعمش، عن ابي صالح، عن ابي هريرة، قال: قال النبي صلي الله عليه وسلم: "اذا قرا ابن ادم السجدة اعتزل الشيطان، يبكي ويقول: يا ويله امر ابن ادم بالسجود فسجد فله الجنة، وامرت بالسجود فلم اسجد فلي النار".



   حدثنا الصغاني، قال: حدثنا اسماعيل بن الخليل (¬)، قال: ثنا علي بن مسهر، قال: ثنا عبيد الله (¬)، عن نافع، عن ابن عمر، قال: "كان رسول الله صلي الله عليه وسلم يقرا ونحن عنده؛ فيسجد ونسجد معه فنزدحم حتي ما يجد بعضنا لجبهته موضعا في غير صلاة" (¬).   حدثنا ابو امية، قال: حدثنا القواريري (¬)، قال: ثنا يحيي بن سعيد (¬)، عن عبيد الله، عن نافع، عن ابن عمر، قال: "كان رسول الله صلي الله عليه وسلم يقرا علينا السورة فيها السجدة، فيسجد ونسجد حتي ما يجد احدنا موضعا لجبهته" (¬).



   حدثنا ابو داود السجزي (¬)، قال: ثنا احمد بن حنبل (¬)، قال: ثنا يحيي بن سعيد (¬)، عن عبيد الله، بمثله، وزاد فيه: "ونسجد معه"، فذكر مثله.



  CHECK باب [بيان] اثبات السجدة في سورة "النجم"، والدليل علي ان القارء اذا قرا فسجد سجد من معه، وان من يسمعها لا يجب عليه السجود حتي يسجد القارء

 باب [بيان] (¬) اثبات السجدة في سورة "النجم"، والدليل علي ان القارء اذا قرا فسجد سجد من معه (¬)، وان من يسمعها لا يجب عليه السجود حتي يسجد القارء   حدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، وحدثنا ابو قلابة (¬)، قال: ثنا بشر بن عمر (¬)، ح
 وحدثنا الصغاني، قال: ثنا ابو الوليد (¬)، قالوا: ثنا شعبة (¬)، عن ابي اسحاق (¬)، قال: سمعت الاسود بن يزيد (¬) يحدث عن
 [] عبد الله (¬)، ان النبي صلي الله عليه وسلم قرا "النجم" بمكة (¬)، وسجد بها، وسجد من كان معه غير شيخ كبير (¬)، اخذ كفا من حصي او تراب، فرفعه الي جبهته، وقال: "يكفيني هذا".
 زاد ابو داود: قال عبد الله: "فلقد رايته قتل كافرا يوم بدر".
 رواه غندر (¬) هكذا، ولم يذكر يوم بدر (¬).



   حدثني ابي (¬)، قال: ثنا علي بن حجر (¬)، قال: ثنا اسماعيل بن جعفر (¬)، قال: ثنا يزيد بن خصيفة (¬)، عن يزيد بن عبد الله بن
 [] قسيط (¬)،
 [] عن عطاء (¬)، انه سال زيد بن ثابت عن القراءة مع الامام، قال: لا قراءة مع الامام في شء، وزعم انه قرا علي رسول الله صلي الله عليه وسلم: {والنجم اذا هوي ()} (¬) فلم يسجد (¬).



   حدثنا الصغاني، قال: ثنا عبيد الله بن موسي (¬)، قال: ثنا ابن ابي ذءب (¬)، عن يزيد بن عبد الله بن قسيط (¬)، عن عطاء بن يسار، عن زيد بن ثابت، قال: "قرات عند رسول الله صلي الله عليه وسلم "النجم" فلم يسجد فيها" (¬).



  CHECK [باب] بيان اثبات السجدة في {اذا السماء انشقت} و {اقرا باسم ربك الذي خلق}

 [باب] (¬) بيان اثبات السجدة في {اذا السماء انشقت} و {اقرا باسم ربك الذي خلق}   حدثنا محمد بن يحيي (¬)، ومحمد بن عبد الملك الواسطي (¬)، قالا: ثنا يزيد بن هارون (¬)، قال: ثنا سليمان التيمي (¬)، عن بكر بن عبد الله المزني (¬)، عن ابي رافع (¬)، قال: "صليت مع ابي هريرة
 [] العتمة (¬)، فقرا: {اذا السماء انشقت ()} فسجد فيها، فلما انصرف (¬) قلت: "ما هذا؟ " (¬) قال: صليت مع ابي القاسم صلي الله عليه (¬)  فسجد بها (¬)، فلا ازال اسجد فيها حتي القاه".
 قال محمد بن يحيي: "فسجد بها"، وقال الدقيقي: "فلا ازال اسجد بها حتي القاه" (¬).



   حدثنا محمد بن يحيي (¬)، قال: ثنا يعلي بن عبيد (¬)،
 [] ومحمد بن يوسف (¬)، ح
 وحدثنا ابن ابي رجاء، قال: ثنا وكيع، قالوا: ثنا سفيان (¬)، عن ايوب بن موسي (¬)، عن عطاء بن ميناء (¬)، عن ابي هريرة، قال: "سجدنا مع رسول الله (¬) في: {اذا السماء انشقت ()} (¬) و {اقرا باسم ربك} (¬) (¬).



   حدثنا فضلك [الرازي] (¬)، قال: ثنا عبد الاعلي النرسي (¬)، وقتيبة وعثمان بن ابي شيبة، قالوا: ثنا [سفيان] بن عيينة (¬)، عن ايوب [بن موسي] (¬)، بمثله (¬).   حدثنا شعيب بن عمرو (¬)، قال: حدثنا [سفيان] بن عيينة (¬)، عن ايوب بن موسي، عن عطاء بن ميناء، عن ابي هريرة قال: "سجدنا مع النبي صلي الله عليه وسلم في: {اذا السماء انشقت ()} و {اقرا باسم} ".



   حدثنا يوسف بن مسلم (¬)، قال: ثنا حجاج، عن ابن جريج، قال: اخبرني ايوب بن موسي (¬)، باسناده، مثله (¬).   حدثنا يونس بن عبد الاعلي، قال: ابنا ابن وهب، ان مالكا (¬) حدثه، عن عبد الله بن يزيد (¬) مولي الاسود بن سفيان (¬) ، عن ابي سلمة بن عبد الرحمن، عن ابي هريرة، "ان (¬) قرا {اذا السماء انشقت ()} فسجد فيها، فلما انصرف اخبرهم ان رسول الله صلي الله عليه وسلم سجد فيها" (¬).



   حدثنا ابو اسماعيل (¬)، ثنا القعنبي، عن مالك، بمثله.   حدثنا الربيع بن سليمان (¬)، وصالح بن عبد الرحمن (¬)، قالا: ثنا حجاج بن ابراهيم (¬) قال: ثنا ابن وهب (¬)، عن عمرو بن الحارث (¬)، عن عبيد الله بن ابي جعفر (¬)، عن الاعرج، عن ابي هريرة قال:
 [] "سجدت مع رسول الله صلي الله عليه وسلم في: {اذا السماء انشقت ()} (¬) و {اقرا باسم ربك الذي خلق ()} (¬) سجدتين".



   حدثنا محمد بن يحيي (¬)، قال: ثنا وهب بن جرير، ح
 وحدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، قالا: ثنا شعبة (¬)، عن عطاء بن ابي ميمونة، عن ابي رافع، عن ابي هريرة "انه سجد {اذا السماء انشقت ()} فقلت (¬): "اتسجد فيها؟ " فقال: "رايت خليلي صلي الله عليه وسلم يسجد (¬)، ولا ازال اسجد فيها حتي القاه"، قلت: النبي صلي الله عليه وسلم؟ " قال: النبي صلي الله عليه وسلم.



   حدثنا محمد بن يحيي، قال: ثنا عبد الصمد (¬)، عن شعبة، عن مروان الاصفر (¬)، عن ابي رافع باسناده مثله: "فانا اسجد حتي القاه" (¬).   حدثنا ابو الازهر (¬)، قال: ثنا بدل بن المحبر (¬)، قال: ثنا شعبة، عن مروان، وعطاء بن ابي ميمونة، سمعا ابا رافع، بمثله: "حتي القاه" (¬).   حدثنا احمد بن محمد بن عثمان الثقفي (¬)، ومحمد بن
 [] عبد الرحمن بن ميمون (¬)، قالا: ثنا الوليد بن مسلم، قال: ثنا ابو عمرو (¬) ح
 وحدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، قال: ثنا هشام (¬)، ح
 وحدثنا عباس الدوري، قال: ثنا هارون بن اسماعيل (¬)، قال: ثنا بن المبارك (¬)، ح (¬)
 [] (¬) وحدثنا ابو صالح (¬) وراق ابي نعيم، قال: ثنا ابو نعيم، قال: ثنا شيبان (¬)، كلهم عن يحيي بن ابي كثير (¬)، عن ابي سلمة، قال: رايت
 [] ابا هريرة يسجد في {اذا السماء انشقت ()} فقلت: اراك سجدت فيها يا ابا هريرة، فقال: "لو لم ار النبي صلي الله عليه وسلم سجد فيها لم اسجد" (¬).



   حدثنا عباس الدوري، والحارث بن ابي اسامة (¬)، قالا: ثنا يونس بن محمد (¬)، ح
 وحدثنا ابن الجنيد الدقاق (¬)، قال: ثنا يحيي بن اسحاق (¬)، قالا: ثنا الليث بن سعد (¬)، عن يزيد بن ابي حبيب (¬)، عن صفوان بن سليم (¬)، عن
 [][عبد الرحمن] الاعرج (¬)، عن ابي هريرة، ان النبي صلي الله عليه وسلم سجد في {اذا السماء انشقت ()} و {اقرا باسم ربك الذي خلق ()}.



  CHECK [باب] بيان حظر التصفيق في الصلاة للرجال، واباحته للنساء، واباحة التسبيح فيها للماموم والمصلي وحده اذا نابته في صلاته ناءبة يريه بها ان يعلم غيره، واباحة الالتفات للامام وغيره ليقف عليها فيعمل فيها ما يجب عليه، واباحة انصرافه قهقري اذا صلي بعض الصلاة، اذا علم بدخول من هو احق بالامامة منه، والدليل علي اباحة تقدم الماموم اذا انصرف الامام وان لم يقدمه فيصلي، واباحة تخلل الصفوف للداخل بعد دخول الناس في الصلاة، حتي ينتهي الي مكانه الذي يجب ان يقدم فيه

 [باب] (¬) بيان حظر التصفيق في الصلاة للرجال، واباحته للنساء، واباحة التسبيح فيها للماموم والمصلي وحده اذا نابته في صلاته ناءبة يريه بها ان يعلم غيره، واباحة الالتفات للامام وغيره ليقف عليها (¬) فيعمل فيها (¬) ما يجب عليه، واباحة انصرافه قهقري اذا صلي بعض الصلاة، اذا علم بدخول من هو احق بالامامة منه، والدليل علي اباحة تقدم الماموم اذا انصرف الامام وان لم يقدمه فيصلي، واباحة تخلل الصفوف للداخل بعد دخول الناس في الصلاة، حتي ينتهي الي مكانه الذي يجب ان يقدم (¬) فيه   حدثنا علي بن حرب [الطاءي] (¬)، وسعدان بن نصر (¬)، وشعيب بن عمرو الدمشقي (¬)، قالوا: ثنا سفيان بن عيينة، عن ابي حازم (¬)،
 [] عن سهل بن سعد الساعدي، قال: "وقع بين الاوس والخزرج كلام (¬)، حتي تناول بعضهم بعضا (¬)، فاتي النبي  صلي الله عليه وسلم  فاخبر، فاتاهم فاحتبس
 [] عندهم؛ فاذن بلال واقام، وتقدم ابو بكر [رضي الله عنه] (¬) يءم الناس، فجاء النبي صلي الله عليه وسلم من مجيءه ذلك؟ فتخلل الناس (¬) حتي انتهي الي الصف الذي يلي ابا بكر، فالتفت ابو بكر؛ فاذا هو برسول الله صلي الله عليه وسلم فاشار اليه النبي صلي الله عليه وسلم ان اثبت مكانك، فرفع ابو بكر راسه الي السماء، ونكص القهقري (¬)، وتقدم رسول الله صلي الله عليه وسلم فصلي بالناس، فلما قضي الصلاة (¬) قال: "يا ابا بكر ما منعك ان تثبت مكانك؟ " قال: "ما كان الله ليري ابن ابي قحافة بين يدي رسول الله صلي الله عليه وسلم".
 زاد علي (¬): باسناده عن النبي صلي الله عليه وسلم قال: "التصفيق للنساء، من نابه (¬) شء من (¬) صلاته فليقل سبحان الله".
 [] وقال سعدان باسناده: قال النبي صلي الله عليه وسلم: "ما لكم حين نابكم شء من صلاتكم صفقتم؟! انما هذا للنساء. من نابه (¬) شء من صلاته فليقل: سبحان الله" (¬).



   اخبرنا يونس بن عبد الاعلي، قال: ثنا ابن وهب، ان مالكا حدثه، ح
 وحدثنا ابو اسماعيل (¬)، قال: ثنا القعنبي (¬)، عن مالك (¬)، عن ابي حازم،
 [] عن سهل بن سعد "ان رسول الله صلي الله عليه وسلم ذهب الي بني عمرو بن عوف (¬) ليصلح بينهم" وذكر الحديث بطوله فقال ابو بكر: "ما كان لابن ابي قحافة ان يصلي بين يدي رسول الله صلي الله عليه وسلم "  "ما لي رايتكم اكثرتم التصفيح؟ (¬) من نابه شء (¬) في صلاته فليسبح؛ فانه اذا سبح التفت اليه، فانما التصفيح للنساء" (¬).



   حدثنا يونس بن عبد الاعلي (¬)، قال: ثنا سفيان (¬)، عن ابي حازم (¬)، عن سهل بن سعد، عن النبي صلي الله عليه وسلم قال (¬): "من نابه شء في
 [] صلاته، فليقل: (سبحان الله) انما التصفيق للنساء، والتسبيح للرجال".



   حدثنا ابو ابراهيم الزهري (¬) قال: ثنا اسحاق بن هشام التمار (¬)، قال: ثنا حماد بن زيد، عن عبيد الله بن عمر (¬)، قال: حدثني ابو حازم، عن سهل بن سعد، قال: كان قتال في بني عمرو بن عوف، فبلغ ذلك النبي صلي الله عليه وسلم فصلي الظهر، ثم اتاهم يصلح (¬) بينهم وذكر الحديث وقال للقوم: "اذا نابكم من (¬) صلاتكم شء فليسبح الرجال، وليصفق (¬) النساء" (¬).



   حدثنا الحسن بن الليث الرازي (¬)، قال: ثنا محمد بن عبد الله بن بزيع (¬)، قال: ثنا عبد الاعلي (¬)، قال: ثنا عبيد الله بن عمر، عن ابي حازم، عن سهل بن سعد، قال: "انطلق االنبي يصلح بين (¬) بني عمرو بن عوف" وزاد:  "فجاء رسول الله صلي الله عليه وسلم فخرق الصفوف، حتي قام في الصف المقدم". وفيه: "ان ابا بكر رجع القهقري" (¬).   حدثنا الدبري، قال: ابنا عبد الرزاق (¬)، قال: ابنا معمر،
 [] عن ابي حازم، بمثله، بطوله.



   حدثنا ابو امية (¬)، قال: ثنا (¬) (¬) احمد بن اسحاق (¬)، قال: ثنا وهيب (¬)، وابو نعيم (¬)، عن ابراهيم بن طهمان (¬)، كلاهما (¬) عن ابي حازم، بحديثهما فيه.   حدثنا ابن الجنيد (¬)، قال: ثنا حجين بن المثني (¬)، قال:
 [] ثنا عبد الحميد بن سليمان (¬)، بحديثه فيه.



   حدثنا يونس بن عبد الاعلي، وسعدان بن نصر، وشعيب بن عمرو (¬)، قالوا: ثنا سفيان بن عيينة (¬)، عن الزهري، عن ابي سلمة، عن ابي هريرة قال (¬): قال رسول الله صلي الله عليه وسلم: "التسبيح للرجال، والتصفيق للنساء" (¬)  قال
 [] بعضهم (¬):  "في الصلاة" (¬).
 رواه ابن وهب، عن يونس بن يزيد (¬)، عن ابن شهاب، عن سعيد، وابي سلمة (¬).



   حدثنا علي بن حرب، قال: ثنا ابو معاوية (¬)، ويعلي (¬)، عن الاعمش، عن ابي صالح (¬)، عن ابي هريرة، عن النبي صلي الله عليه وسلم قال: "التسبيح للرجال، والتصفيق للنساء" (¬).



   حدثنا ابو زرعة الدمشقي (¬)، قال: ثنا ابو صالح (¬)، قال: حدثني الليث، قال: اخبرني يونس (¬)، عن الزهري، عن سعيد (¬)، وابي سلمة، عن ابي هريرة قال: قال النبي صلي الله عليه وسلم: "التصفيق للنساء، والتسبيح للرجال".   حدثنا السلمي (¬)، قال: ثنا عبد الرزاق (¬)، قال: ابنا معمر، عن همام بن منبه (¬)، عن ابي هريرة، عن النبي صلي الله عليه وسلم بمثله،
 [] وزاد (¬): "في الصلاة".



  CHECK باب [بيان] اجازة صلاة من ياتم بمن لا ينوي ان يكون هو امامه، والدليل علي ان من ادرك مع الامام بعض صلاته انه اول صلاته، واباحة ترد المءذن انتظار الامام ادا دخل وقت الصلاة

 باب [بيان] (¬) اجازة صلاة من ياتم (¬) بمن (¬) لا ينوي ان يكون هو امامه، والدليل علي ان من ادرك مع الامام بعض صلاته انه اول صلاته، واباحة ترد المءذن انتظار الامام ادا دخل وقت الصلاة   حدثنا ابو حميد عبد الله بن محمد مولي بني هاشم (¬)  قال: ثنا (¬) حجاج بن محمد، عن ابن جريج (¬)، قال: اخبرني ابن شهاب عن حديث عباد بن زياد (¬)،
 [] ان عروة بن المغيرة بن شعبة (¬) اخبره، ان المغيرة بن شعبة اخبره انه غزا مع رسول الله صلي الله عليه وسلم غزوة تبوك، قال المغيرة: فتبرز (¬) رسول الله صلي الله عليه وسلم قبل الغاءط (¬)؛ فحملت معي (¬) اداوة (¬) قبل صلاة الفجر، فلما رجع رسول الله صلي الله عليه وسلم الي اخذت اهريق علي يديه من الاداوة، فغسل يديه ثلاث مرات، وغسل وجهه، ثم ذهب يحسر (¬) جبته عن ذراعيه، فضاق كما
 [] جبته، فادخل يديه في الجبة حتي اخرج يديه من اسفل (¬) الجبة، وغسل ذراعيه الي المرفقين، ثم توضا ومسح (¬) علي خفيه، ثم اقبل واقبلت معه، فلحقنا الناس قد قدموا عبد الرحمن بن عوف يصلي بهم، فادرك رسول الله صلي الله عليه وسلم[احدي الركعتين، فصلي مع الناس الركعة الاخري (¬)]؛ فلما سلم عبد الرحمن قام رسول الله صلي الله عليه وسلم يتم صلاته، فافزع ذلك المسلمين؛ فاكثروا التسبيح، فلما قضي رسول الله صلي الله عليه وسلم صلاته اقبل عليهم، ثم قال: "احسنتم" او "اصبتم"، يغبطهم (¬) ان صلوا الصلاة لوقتها".



   حدثنا ابو داود الحراني، والدقيقي (¬)، قالا: ثنا يعقوب بن ابراهيم بن سعد (¬)، قال: ثنا ابي، عن صالح (¬)، عن ابن شهاب (¬)، قال:
 [] حدثني عباد بن زياد، عن عروة بن المغيرة، عن ابيه: المغيرة بن شعبة، انه قال: فذكر مثله الا انه زاد:  "قال: فصلي مع الناس الركعة الاخرة بصلاة عبد الرحمن" (¬).



   حدثنا عبد الرحمن بن بشر (¬)، والدبري (¬)، قالا: ابنا
 عبد الرزاق (¬)، قال: ابنا ابن جريج، قال: اخبرني ابن شهاب، عن عباد بن زياد، باسناده، مثله.
 قال ابن جريج: قال ابن شهاب: فحدثني اسماعيل بن محمد بن سعد (¬)، عن حمزة بن المغيرة (¬)، بمثل حديث عباد بن زياد، وزاد: قال المغيرة: فاردت تاخير عبد الرحمن، فقال النبي صلي الله عليه [وسلم] (¬) : "دعه".



  AUTO باب الدليل علي ان المصلي اذا رفع راسه من السجود من الركعة الاولي والثالثة نهض، ولا يثبت قاعدا قبل القيام

 (¬)   حدثنا عمار (¬)، قال: ثنا يزيد، قال: ثنا يحيي (¬)، عن عبد الرحمن بن هزمز، اخبره عن ابن بحينة، "ان النبي صلي الله عليه وسلم قام في الثنتين
 [] من الظهر او العصر (¬)، فلم يسترح، فلما اعتدل قاءما لم يرجع حتي فرغ من صلاته، ثم سجد سجدتي السهو، وهو جالس قبل ان يسلم، ثم سلم" (¬).



  CHECK باب [بيان] الاباحة للمصلي ادا افتتح الصلاة قاءما ان يركع قاعدا، واذا افتتح قاعدا ان يركع قاءما، وبيان الخبر المعارض له الدال قال حظر الركوع قاءما اذا افتتح قاعدا، والركوع قاعدا اذا افتتح قاءما

 باب [بيان] (¬) الاباحة للمصلي ادا افتتح الصلاة قاءما ان يركع قاعدا، واذا افتتح قاعدا ان يركع قاءما، وبيان الخبر المعارض له الدال قال حظر الركوع قاءما اذا افتتح قاعدا، والركوع قاعدا اذا افتتح قاءما   حدثنا الدقيقي (¬)، قال: ثنا يزيد بن هارون، قال: حدثنا حميد الطويل (¬)، عن محبد الله بن شقيق (¬) (¬) قال قلت لعاءشة: "اكان رسول الله صلي الله عليه وسلم يصلي قاعدا؟ قالت: كان يصلي من الليل طويلا قاءما، ويصلي من الليل طويلا قاعدا، فاذا قرا قاءما ركع قاءما، واذا قرا قاعدا ركع قاعدا".   حدثنا ابو عبيد الوراق (¬)، قال: ثنا حجاج يعني: ابن
 [] منهال (¬)، عن يزيد [بن ابراهيم] (¬)، ح
 وحدثنا محمد بن حيوية (¬)، قال: ابنا الهيثم بن عبيد الله ابو محمد الكوفي (¬)، ثنا يزيد بن ابراهيم، قال: حدثني [محمد] (¬) بن سيرين، عن عبد الله بن شقيق العقيلي، عن عاءشة قالت: "كان النبي صلي الله عليه وسلم يكثر الصلاة قاءما وقاعدا، فاذا صلي قاءما ركع قاءما، واذا صلي قاعدا ركع قاعدا" (¬).



   حدثنا الدبري، عن عبد الرزاق (¬)، عن هشام بن حسان (¬)، عن محمد (¬) بن سيرين، عن عبد الله بن شقيق باسناده بحديثه فيه.   حدثنا يونس بن عبد الاعلي، قال: ابنا ابن وهب، ان مالكا (¬) حدثه، عن هشام بن عروة (¬)، عن ابيه، عن عاءشة، انها اخبرته
 [] "انها لم تر رسول الله صلي الله عليه وسلم يصلي صلاة الليل قاعدا حتي اسن، فكان يقرا قاعدا حتي اذا اراد ان يركع قام فقرا نحوا من ثلاثين او اربعين اية، ثم ركع" (¬).



   حدثنا عباس (¬)، قال: ثنا محمد بن بشر (¬)، قال: ثنا هشام بن عروة (¬)، عن ابيه، عن عاءشة، قالت: "كان رسول الله صلي الله عليه وسلم لا يقرا في شء من صلاة الليل قاعدا، فلما كبر، ودخل في السن،
 [] فاذا بقي عليه ثلاثون او اربعون اية قام فقرا ثم سجد".



   حدثنا يونس (¬)، قال: ثنا انس بن عياض (¬)، عن هشام بن عروة (¬)، عن ابيه، عن عاءشة، قالت: "كان النبي صلي الله عليه وسلم لا يصلي شيءا من صلاته وهو جالس؛ فلما دخل في السن جعل يجلس حتي اذا بقي من السورة اربعون او ثلاثون اية قام فقراها، ثم سجد".   حدثنا محمد بن عبد الوهاب (¬)، قال: ثنا جعفر بن عون (¬)، قال: ثنا هشام بن عروة (¬)، عن ابيه، عن عاءشة قالت: "ما رايت رسول الله صلي الله عليه وسلم يقرا في شء من الصلاة في ليل وهو قاعد، حتي دخل في السن، قالت: كان يقرا السورة حتي بقي (¬) منها ثلاثون اية او اربعون اية قام فاتمها، ثم سجد" (¬).



   حدثنا ابو داود الحراني، قال: ثنا محاضر (¬) ح
 وحدثنا قربزان (¬)، قال: ثنا يحيي بن سعيد القطان (¬)، قالا: ثنا هشام بن عروة باسناده مثله قام فقراها ثم ركع. فذكر مثل حديث مالك، عن هشام.   اخبرنا يونس بن عبد الاعلي (¬)، قال ابنا ابن وهب، ان مالكا (¬) حدثه، عن عبد الله بن يزيد مولي الاسود بن سفيان وابي
 [] النضر (¬) مولي عمر بن عبيد الله (¬)  عن ابي سلمة (¬)، عن عاءشة، "ان رسول الله صلي الله عليه وسلم كان يصلي فيقرا وهو جالس، فاذا بقي من قراءته قدر ما يكون ثلاثين او اربعين اية قام، فقراها (¬) وهو قاءم، ثم ركع، ثم سجد، ثم يفعل في الركعة الثانية مثل ذلك" (¬).



   حدثني ابي (¬)، قال: ثنا علي (¬)، قال: حدثنا اسماعيل بن جعفر (¬)، قال: ثنا محمد بن عمرو (¬)، قال: حدثني محمد بن ابراهيم بن الحارث (¬)، عن علقمة بن وقاص (¬)، انه سال عاءشة، كيف كان النبي صلي الله عليه وسلم يصلي الركعتين وهو جالس؟ قالت: "كان يقرا وهو جالس؛ فاذا اراد ان يركع قام فركع" (¬).
 [] روي ابو بكر بن ابي شيبة (¬)، قال: ثنا اسماعيل بن علية (¬)، عن الوليد بن ابي هشام (¬)، عن ابي بكر بن محمد (¬)، عن عروة، عن عاءشة، قالت: "كان النبي صلي الله عليه وسلم يقرا وهو قاعد، فاذا اراد ان يركع قام قدر ما يقرا انسان اربعين اية" (¬).



  CHECK [باب] ذكر الاخبار التي تبين ان النبي صلي الله عليه وسلم كان لا يصلي قاعدا حتي كان في اخر حياته كان يصلي في تطوعه قاعدا

 [باب] (¬) ذكر الاخبار التي تبين ان النبي صلي الله عليه وسلم كان لا يصلي قاعدا حتي كان في اخر حياته كان يصلي في (¬) تطوعه قاعدا   حدثنا يونس بن عبد الاعلي، قال: ابنا ابن وهب، ان مالكا (¬) اخبره، عن ابن شهاب، عن الساءب بن يزيد (¬)، عن المطلب بن ابي وداعة السهمي (¬)، عن حفصة زوج النبي صلي الله عليه وسلم انها قالت: "ما رايت
 [] رسول الله صلي الله عليه وسلم صلي في سبحته قاعدا قط حتي كان قبل وفاته بعام؛ فكان يصلي في سبحته قاعدا، ويقرا بالسورة فيرتلها حتي تكون اطول من اطول منها" (¬).



   حدثنا احمد بن يوسف السلمي (¬)، قال: حدثنا عبد الرزاق (¬)، عن معمر، عن ابن شهاب، ح
 وحدثنا ابو عبيد الله ابن اخي ابن وهب (¬)، قال: ثنا عمي (¬)، قال: (¬) ابنا
 [] يونس (¬)، عن الزهري، عن الساءب بن يزيد، عن المطلب بن ابي وداعة السهمي (¬) ان حفصة زوج النبي صلي الله عليه وسلم قالت: "لم ار رسول الله صلي الله عليه وسلم قاعدا حتي كان قبل موته بعام او اثنين، فكان يصلي في سبحته جالسا، ويرتل السورة، حتي تكون في قراءته اطول من اطول منها" (¬).



   حدثنا سليمان بن عبد الحميد البهراني (¬)، قال: ثنا خطاب بن عثمان الفوزي (¬)، قال: ثنا محمد بن حمير (¬)، قال: حدثني ابراهيم بن ابي عبلة (¬) قال: حدثني محمد بن مسلم
 [] الزهري، باسناده، مثله (¬).



   حدثنا ابو يوسف يعقوب بن سفيان (¬)، قال: ثنا ابو اليمان، قال: ابنا شعيب، عن الزهري، باسناده، مثله.   حدثنا ابو علي الزعفراني (¬)، والصاغاني، ويوسف بن مسلم، قالوا: ثنا حجاج بن محمد (¬)، قال: قال ابن جريج (¬): اخبرني عثمان بن ابي سليمان (¬)، ان ابا سلمة بن عبد الرحمن اخبره، ان عاءشة اخبرته: "ان النبي صلي الله عليه وسلم لم يمت حتي كان كثيرا (¬) من صلاته وهو جالس".



   حدثنا ابو جعفر الدارمي (¬)، قال: ثنا ابو عاصم، قال (¬): ابن جريج (¬) اخبرني، قال: اخبرني عثمان بن ابي سليمان باسناده قالت: "كان (¬) رسول الله صلي الله عليه وسلم لما كبر كثر لحمه كان اكثر صلاته جالسا".   حدثنا محمد بن عبد الملك الواسطي (¬)، قال: ثنا يزيد بن هارون، قال: ابنا الجريري (¬)، عن عبد الله بن شقيق، قال: قلت لعاءشة:
 [] "هل كان رسول الله صلي الله عليه وسلم يصلي قاعدا؟ قالت (¬): "نعم، حين حطمه السن". او قالت: "حتي حطمه السن" (¬).
 رواه زيد بن الحباب (¬)، عن الضحاك بن (¬) عثمان، قال: حدثني عبد الله بن عروة (¬)، عن ابيه (¬)، عن عاءشة، قالت: "لما بدن (¬)
 [] رسول الله صلي الله عليه وسلم وثقل كان اكثر صلاته جالسا" (¬).



  CHECK [باب] بيان فضل صلاة القاءم علي صلاة القاعد، والدليل علي ان الصلاة المكتوبة لا يجوز ان تصلي قاعدا

 [باب] (¬) بيان فضل صلاة القاءم علي صلاة القاعد، والدليل علي ان الصلاة المكتوبة لا يجوز ان تصلي (¬) قاعدا   حدثنا ابو العباس الغزي (¬)، قال: ثنا الفريابي، قال: ثنا سفيان (¬)، عن منصور (¬)، عن هلال بن يساف (¬)، عن ابي يحيي (¬)، عن عبد الله بن عمرو، قال: "اتيت النبي صلي الله عليه وسلم وهو يصلي جالسا، فقلت:
 [] حدثت (¬) يا رسول الله انك قلت: "صلاة الرجل قاعدا علي النصف من صلاته قاءما؟ " قال: اجل، ولكني لست كاحد منكم" (¬).



   حدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، قال: ثنا شعبة (¬)، عن منصور، قال: سمعت هلال بن يساف يحدث عن ابي يحيي الاعرج، عن عبيد الله بن عمرو، ان النبي صلي الله عليه وسلم قال: "صلاة القاعد علي النصف من صلاة القاءم".
 قال ابو عوانة رضي الله عنه (¬): اسم ابي (¬) يحيي:
 [] "مصدع"، يقال (¬) (¬).



  CHECK باب [بيان] صفة الجلوس في الصلاة، والدليل علي ان القعود في الركعتين الاوليين والاخريين واحد، ويطمءن علي فخذه اليسري، ويجعل قدمه اليسري بين فخذه وساقه، ويفرش قدمه اليمني، وان في كل ركعتين التشهد، والخبر المعارض لفرش القدم اليمني

 باب [بيان] (¬) صفة الجلوس في الصلاة، والدليل علي ان القعود في الركعتين الاوليين (¬) والاخريين واحد (¬)، ويطمءن علي فخذه اليسري، ويجعل قدمه اليسري بين فخذه وساقه، ويفرش قدمه اليمني، وان في كل ركعتين (¬) التشهد، والخبر المعارض لفرش القدم اليمني   حدثنا محمد بن احمد بن الجنيد، قال: ثنا العلاء بن عبد الجبار (¬)، قال: ثنا عبد الواحد بن زياد (¬)، قال: ثنا عثمان بن حكيم (¬)، عن
 [] عامر بن عبد الله بن الزبير (¬)، عن ابيه قال: "كان رسول الله صلي الله عليه وسلم اذا قعد في الصلاة جعل قدمه اليسري تحت فخذه وساقه، وفرش قدمه اليمني" (¬).



   حدثنا جعفر بن محمد (¬)، قال: ثنا عفان، قال: حدثنا
 [] عبد الواحد بن زياد (¬)، قال: ثنا عثمان بن حكيم، قال: ثنا عامر بن عبد الله بن الزبير، عن ابيه، قال (¬): "كان رسول الله صلي الله عليه وسلم اذا قعد في الصلاة جعل قدمه اليسري تحت فخذه وساقه، وفرش قدمه اليمني، ووضع يده اليسري علي ركبته اليسري، ووضع يده اليمني علي فخذه اليمني، واشار باصبعه". وارانا عبد الواحد، واشار بالسبابة (¬).



   حدثنا محمد [بن عبد الملك] (¬) الدقيقي، قال: ثنا يزيد (¬)،
 [] قال: ثنا يحيي بن سعيد (¬)، عن القاسم بن محمد (¬)، عن عبيد الله بن عبد الله بن عمر (¬)، ان عبد الله بن عمر كان يقول: "من سنة الصلاة ان يضجع اليسري، وينصب اليمني" يعني: اذا جلس (¬) .



   حدثنا الحارثي (¬)، قال: ثنا ابو اسامة، عن حسين المعلم، عن بديل بن ميسرة، عن ابي الجوزاء، عن عاءشة قالت: "كان رسول الله صلي الله عليه وسلم يقول في كل ركعتين: "التحية"، وكان يفرش رجله اليسري (¬) رجله اليمني".
 رواه (¬) عن اسحاق بن (¬) ابراهيم، عن مروان بن معاوية، عن عبيد الله بن عبد الله بن الاصم، عن يزيد بن الاصم، انه اخبره عن ميمونة، قالت: "كان النبي (¬) صلي الله عليه وسلم اذا سجد خوي بيديه يعني: جنح حتي
 [] يري وضح ابطيه من وراءه، واذا قعد اطمان علي فخذه اليسري" (¬).
 رواه مسلم، عن اسحاق (¬).



   حدثنا علي بن اشكاب (¬) قال: ثنا محمد بن ربيعة (¬)، قال (¬): ثنا جعفر بن برقان، عن يزيد بن الاصم، عن ميمونة قالت: "كان النبي (¬) صلي الله عليه وسلم اذا سجد جافي يديه عن جنبيه، حتي يري من خلفه بياض ابطيه" (¬).



  CHECK باب [بيان] صفة وضع اليدين علي الركبتين في التشهد، وعقد الاصابع والاشارة في السبابة، والدليل علي ان وضع اليدين علي الفخذين والركبتين جاءز

 باب [بيان] (¬) صفة وضع اليدين علي الركبتين في التشهد، وعقد الاصابع والاشارة في (¬) السبابة، والدليل علي ان وضع اليدين علي الفخذين والركبتين جاءز   اخبرنا يونس بن عبد الاعلي، قال: ابنا بن وهب، ان مالكا (¬) حدثه، عن مسلم بن ابي مريم (¬)، عن علي المعاوي (¬)، انه قال: راني عبد الله بن عمر وانا اعبث بالحصي، فلما انصرفت (¬) نهاني،
 [] وقال: "اصنع كما كان رسول الله صلي الله عليه وسلم يصنع". قال: قلت: كيف كان رسول الله صلي الله عليه وسلم يصنع؟ فقال: "كان اذا جلس في الصلاة وضع كفه اليمني علي فخذه اليمني، وقبض اصابعه كلها، واشار باصبعه التي تلي (¬) الابهام، ووضع كفه اليسري علي فخذه اليسري" (¬).



   حدثنا الصغاني، قال: ابنا عبد الله بن يوسف، قال: ابنا مالك بن انس، عن مسلم بن ابي مريم، عن علي بن عبد الرحمن المعاوي، انه قال: راني عبد الله بن عمر، ح
 وحدثنا الصغاني، قال: ابنا سعيد بن سليمان (¬)، قال: ثنا وهيب (¬)، عن مسلم بن ابي مريم (¬)، عن علي بن عبد الرحمن ان رجلا (¬) صلي الي
 [] جنب ابن عمر، فجعل يعبث (¬) بالحصي، فقال له ابن عمر: "لا تعبث بالحصي، ولكن اصنع كما رايت رسول الله صلي الله عليه وسلم يصنع فوضع يده اليمني علي ركبته اليمني، ووضع يده اليسري علي ركبته اليسري، واشار باصبعه السبابة".



   حدثنا ابو داود السجزي (¬)، قال: ثنا القعنبي، عن مالك، عن مسلم [بن ابي مريم] (¬)، عن علي بن عبد الرحمن [المعاوي] (¬)، قال: "راني عبد الله بن عمر"، بمثله (¬).   حدثني ابي [رحمه الله] (¬) قال: ثنا علي (¬)، قال: ثنا اسماعيل (¬) (¬)، قال: ثنا مسلم بن ابي مريم، [عن علي بن عبد الرحمن
 [] المعاوي باسناده نحوه (¬).



   حدثنا اسماعيل القاضي (¬)، نا علي يعني: ابن المديني (¬)  نا سفيان بن عيينة (¬)، قال: حدثني مسلم بن ابي مريم] (¬)، قال: سمعت علي بن عبد الرحمن المعاوي قال: "صليت الي جنب ابن عمر، فقلبت الحصي، فقال لي ابن عمر: "لا تقلب الحصي" قال فيه سفيان مرة اخري:  "فان تقليب الحصي من الشيطان، وافعل كما رايت رسول الله صلي الله عليه وسلم يفعل".
 قال: فقلت: يا ابا عبد الرحمن، كيف رايته يفعل؟ قال: "هكذا"، ووضع سفيان كفه اليمني علي فخذه اليمني، ورفع اصبعه السبابة يشير
 [] بها (¬)، ووضع يده اليسري علي فخذه اليسري، وبسط اصابعه، ولم يشر منها بشء".
 قال سفيان: فحدثنا يحيي بن سعيد (¬) سنة اربع وعشرين (¬)، ان مسلم بن ابي مريم حدثه، فلقيت مسلما (¬) فحدثني انه سمع علي بن عبد الرحمن المعاوي، ثم قال سفيان: من اين لاهل الكوفة مثل هذا (¬)؟



   حدثنا ابو داود الحراني، قال: ثنا ابو عتاب، ح
 وحدثنا ابن المنادي (¬)، قال: ثنا وهب بن جرير، كلاهما قالا: ثنا
 [] شعبة، قال: حدثني مسلم بن ابي مريم (¬) بهذا الحديث ومعناه بحديثهما فيه، وقالا عن شعبة: عبد الرحمن بن علي، وهو غلط، قاله ابو عوانة (¬).



   حدثنا ابو جعفر بن المنادي، قال: ثنا يونس بن محمد (¬)، ح
 وحدثنا حمدان بن علي (¬)، قال: ثنا عفان، ح
 وحدننا ابو بكر الرازي (¬)، قال: ثنا حجاج بن المنهال، قالوا: ثنا حماد بن سلمة، عن ايوب، عن نافع، عن ابن عمر: "ان رسول الله صلي الله عليه وسلم كان اذا قعد في التشهد وضع يده اليسري علي ركبته اليسري، ووضع يده اليمني علي ركبته اليمني، وعقد ثلاثا وخمسين (¬)، واشار بالسبابة". وقال
 [] بعضهم (¬): "ورفع السبابة".



   حدثنا ابو داود الحراني، قال: ثنا ابو الوليد (¬)، عن حماد بن سلمة باسناده مثله: "ويعقد ثلاثا وخمسين، واشار بسبابته".   حدثنا اسحاق بن ابراهيم الصنعاني (¬)، قال: ابنا عبد الرزاق (¬)، ح
 وحدثنا الصغاني، قال: ابنا احمد بن حنبل (¬)، قال: ثنا عبد الرزاق،
 [] قال: ابنا معمر، عن عبيد الله (¬)، عن نافع، عن ابن عمر، "ان رسول الله صلي الله عليه وسلم كان اذا جلس في الصلاة وضع يديه علي ركبتيه، ورفع اصبعه اليمني التي تلي الابهام، فدعا بها (¬)، ويده (¬) اليسري علي ركبته، باسطها عليها" (¬).



  CHECK [باب] بيان التحامل بيده اليسري علي فخذه اليسري في التشهد، واخذ الركبة اليسري باليد اليسري يلقمها، ووضع يده اليمني علي فخذه اليمني، واليسري علي ركبته [اليسري]

 [باب] (¬) بيان التحامل بيده اليسري علي فخذه اليسري في التشهد، واخذ الركبة اليسري باليد (¬) اليسري يلقمها (¬)، ووضع يده اليمني علي فخذه اليمني، واليسري علي ركبته [اليسري] (¬)   حدثنا جعفر بن محمد، قال: ثنا عفان، قال: ثنا عبد الواحد بن زياد، قال: ثنا عثمان بن حكيم، قال: ثنا عامر بن عبد الله بن الزبير، عن ابيه، قال: "كان النبي صلي الله عليه وسلم اذا قعد في الصلاة وضع يده اليمني علي فخذه اليمني، ووضع يده اليسري علي ركبته اليسري". وارانا (¬) عبد الواحد، واشار بالسبابة (¬).   حدثنا يوسف بن مسلم (¬)، قال: ثنا حجاج، عن ابن
 [] جريج، عن عمرو بن دينار، قال: اخبرني عامر بن عبد الله بن الزبير (¬)، عن ابيه قال: "رايت النبي صلي الله عليه وسلم يدعو بالتشهد هكذا: يتحامل يده (¬) اليسري علي فخذه اليسري" (¬).
 [][باب] (¬) بيان الاشارة بالسبابة الي القبلة، ورمي (¬) البصر اليها، وترك تحريكها في الاشارة 
   حدثني ابي (¬) رحمه الله، قال: ثنا علي [بن حجر] (¬)، قال: ثنا اسماعيل بن جعفر، عن مسلم بن ابي مريم، عن علي بن عبد الرحمن المعاوي، عن ابن عمر في حديث ذكره "ان النبي صلي الله عليه وسلم كان اذا قعد في الصلاة اشار باصبعه الي القبلة، ورمي ببصره اليها".   حدثنا ابو داود السجزي (¬)، قال: ثنا محمد بن بشار، قال: ثنا يحيي القطان، قال: ثنا ابن عجلان (¬)، عن عامر بن عبد الله بن
 [] الزبير، عن ابيه، "ان النبي صلي الله عليه وسلم كان اذا تشهد وضع يده اليسري علي فخذه اليسري، ويده اليمني علي فخذه اليمني، واشار باصبعه السبابة، لا يجاوز بصره اشارته" (¬).



   حدثنا هلال بن العلاء (¬)، ويوسف بن مسلم، قالا: ثنا حجاج، قال: ثنا ابن جريج، اخبرني زياد (¬)، عن محمد بن عجلان (¬)، عن عامر بن عبد الله بن الزبير، عن عبد الله بن الزبير، انه (¬) ذكر: "ان النبي صلي الله عليه وسلم كان يشير باصبعه اذا دعا، و (¬) لا يحركها".
 قال ابن جريج: "وزاد عمرو (¬) قال: اخبرني عامر بن عبد الله بن الزبير (¬)، عن ابيه، "انه راي النبي صلي الله عليه وسلم يدعو كذلك (¬)، ويتحامل بيده
 [] اليسري علي رجله اليسري ... ".



  CHECK باب [بيان] ايجاب قراءة التشهد عند القعدة وافتتاحه بالتحيات والدليل علي انه ليس فيه "بسم الله"

 باب [بيان] (¬) ايجاب قراءة التشهد عند القعدة وافتتاحه بالتحيات والدليل علي انه ليس فيه "بسم الله"   حدثنا سليمان بن سيف الحراني وعباس بن محمد (¬) الدوري، وسعيد بن مسعود (¬)، قالوا: ثنا سعيد بن عامر الضبعي (¬)، عن سعيد بن ابي عروبة (¬)، عن قتادة، عن يونس بن جبير (¬)، عن (¬) حطان بن عبد الله الرقاشي (¬)، قال: "صلي ابو موسي احدي
 [] صلاتي العشاء (¬). . ." وذكر الحديث بطوله (¬) وقال فيه:  "اذا كان عند القعدة، فليكن (¬) اول قول احدكم: "التحيات الطيبات الصلوات لله، السلام عليك ايها النبي ورحمة الله وبركاته، السلام علينا وعلي عباد الله الصالحين، اشهد ان لا اله الا الله، واشهد ان محمدا عبده ورسوله".



   حدثنا الصايغ (¬) بمكة، قال: ثنا علي بن عبد الله (¬)، قال: ثنا جرير (¬)، عن سليمان التيمي (¬)، عن قتادة، عن ابي غلاب
 [] يونس بن جبير (¬)، عن حطان بن عبد الله ان ابا موسي قال: "خطبنا رسول الله صلي الله عليه وسلم فعلمنا سنتنا، وبين لنا صلاتنا" وذكر الحديث [بطوله] (¬)، وقال فيه: "وليكن من اول قول احدكم التشهد".



   حدثنا الصغاني، والحارث بن ابي اسامة (¬)، قالا: ثنا يونس بن محمد (¬)، قال: ثنا الليث بن سعد (¬)، عن ابي الزبير، عن سعيد بن جبير (¬) وطاوس، عن ابن عباس، انه قال: "كان رسول الله صلي الله عليه وسلم يعلمنا التشهد كما يعلمنا القران، فكان يقول: "التحيات المباركات، الصلوات الطيبات لله، السلام عليك ايها النبي ورحمة الله وبركاته،
 [] السلام علينا وعلي عباد الله الصالحين، اشهد ان لا اله الا الله، واشهد ان محمدا رسول الله" (¬).



   حدثنا ابن ابي مسرة (¬)، قال: حدثنا المقرء (¬)، قال: ثنا الليث (¬)، قال: حدثني ابو الزبير، عن طاوس، وسعيد بن جبير، عن ابن عباس، قال: "كان النبي (¬) صلي الله عليه وسلم يعلمنا التشهد. . ."، فذكر مثله.   اخبرنا محمد بن عبد الله بن عبد الحكم (¬)، قال: حدثني
 [] ابي (¬) وشعيب بن الليث، عن الليث (¬)، عن ابي الزبير، عن سعيد بن جبير وطاوس، بمثله.
 وسمعت محمد بن عبد الله بن عبد الحكم، قال: سمعت الشافعي [رحمة الله عليه] (¬) يقول: "هذا اجود حديث روي عن النبي صلي الله عليه وسلم (¬) في التشهد".



   حدثنا مهدي بن الحارث (¬)، قال: ثنا ابن ابي شيبة (¬)، قال: حدثني يحيي (¬) بن ادم، قال: ثنا عبد الرحمن بن حميد (¬)، قال: حدثني ابو الزبير، عن طاوس، عن ابن عباس قال: "كان رسول الله صلي الله عليه وسلم يعلمنا التشهد، كما يعلمنا السورة من القران " (¬).   حدثنا حمدان بن علي (¬)، والصغاني، وابو امية، وادريس بن بكر، قالوا: ثنا ابو نعيم (¬)، قال: حدثنا سيف بن
 [] ابي سليمان (¬)، قال: حدثني مجاهد (¬)، قال: ثنا عبد الله بن سخبرة ابو معمر (¬)، قال: سمعت عبد الله بن مسعود (¬) قال: "علمني رسول الله صلي الله عليه وسلم التشهد كفي بين كفيه كما يعلمني السورة من القران: "التحيات لله، والصلوات والطيبات، السلام عليك ايها النبي ورحمة الله وبركاته، السلام علينا وعلي عباد الله الصالحين، اشهد ان لا اله الا الله، واشهد ان محمدا عبده ورسوله" وهو بين ظهرانينا فلما قبض قلنا: "السلام علي النبي" (¬).
 [] قال بعضهم: "سيف بن سليمان" (¬) غير ابي نعيم.



  CHECK باب [بيان] ايجاب اختيار الدعاء بعد الفراغ من التشهد، وحكم السلام علي عباد الله، وايجاب السلام علي نفسه وعلي الصالحين، والدليل علي ان "السلام" اسم من اسماء الله

 باب [بيان] (¬) ايجاب اختيار الدعاء بعد الفراغ من التشهد، وحكم (¬) السلام علي عباد الله، وايجاب السلام علي نفسه وعلي الصالحين، والدليل علي ان "السلام" اسم من اسماء الله   حدثنا ابن ابي رجاء، قال: ثنا وكيع، ح
 وحدثنا الصغاني، وابو امية، قالا: ثنا يعلي (¬)، قالا: ثنا الاعمش (¬)، عن ابي واءل، عن عبد الله، قال: "كنا اذا صلينا خلف النبي صلي الله عليه وسلم قلنا: "السلام علي الله قبل (¬) عباده، والسلام علي جبريل، والسلام علي ميكاءيل، والسلام علي فلان وفلان". فلما سمعها (¬) رسول الله صلي الله عليه وسلم قال: "ان الله هو السلام، فاذا جلس احدكم في الصلاة فليقل:
 [] "التحيات لله، والصلوات والطيبات، السلام عليك ايها النبي ورحمة الله وبركاته، السلام علينا وعلي عباد الله الصالحين"؛ فانكم اذا قلتم ذلك اصاب كل عبد (¬) في السماء والارض، "اشهد ان لا اله الا الله، واشهد ان محمدا عبده ورسوله، ثم يتخير". هذا لفظ وكيع (¬).
 واما يعلي قال بنحوه ومعناه وقال: "ثم يتخير ما شاء" يعني: "من الدعاء" (¬) .



   حدثنا احمد بن عبد الحميد الحارثي (¬) قال: ثنا حسين الجعفي (¬)، قال: ثنا زاءدة، عن سليمان، عن شقيق، عن عبد الله، قال:
 [] "كنا اذا قعدنا في الصلاة قلنا: السلام علينا من ربنا، السلام علي جبريل وميكاءيل ... ". وذكر الحديث بنحوه وقال في اخره: "ثم ليتخير من الكلام ما شاء".



   حدثني عبد الله بن احمد بن حنبل، قال: حدثني ابي (¬)، قال: ثنا محمد بن جعفر (¬)، عن شعبة، عن منصور، عن شقيق، عن عبد الله قال: "كنا اذا صلينا خلف رسول الله صلي الله عليه وسلم ... ". وذكر الحديث وقال في اخره: "فانكم اذا قلتم: "السلام علينا وعلي عباد الله الصالحين" سلمتم علي كل عبد في السماء والارض".
 ولم يذكر شعبة "ثم ليتخير من المسالة ما شاء".   حدثنا الصغاني، قال: ثنا معاوية بن عمرو (¬)، قال: ثنا زاءدة (¬)، عن منصور، عن شقيق، عن عبد الله، قال: "كنا اذا صلينا خلف
 [] رسول الله صلي الله عليه وسلم يقول الرجل منا اذا قعد في صلاة (¬): "السلام علي الله، السلام علي فلان"؛ فقال لنا رسول الله صلي الله عليه وسلم يوم: ان الله هو السلام، فاذا قعد احدكم في صلاته فليقل: "التحيات لله" الي قوله: "وعلي عباد الله الصالحين"؛ فانها تصيب كل عبد في السماوات والارض صالح لله. اشهد ان لا اله الا الله، واشهد ان محمدا عبده ورسوله". ثم ليتخير (¬) بعد من المسالة ما شاء".



   حدثنا الغزي (¬)، قال: ثنا ابو نعيم (¬)، عن الاعمش، والفريابي (¬) عن سفيان (¬)، عن الاعمش، ح
 [] اخبرنا ابو عبيد الله حماد بن الحسن (¬)، قال: ثنا بدل بن المحبر، قال: ثنا شعبة، قال: حدثني سليمان (¬)، ح
 وحدثنا الصغاني، قال: ثنا سريج بن يونس (¬)، قال: ثنا هشيم، قال: ثنا حصين (¬)، والمغيرة (¬) والاعمش (¬)، ح
 وحدثنا ابو امية، قال: ثنا احمد بن يونس (¬)، قال: ثنا زهير، عن مغيرة (¬)، ح
 [] وحدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، قال: ثنا هشام، عن حماد (¬)، ح
 وحدثنا ابن عوف (¬)، قال: ثنا ادم (¬)، ح
 وحدثنا الصغاني، قال: ثنا ابو النضر، قالا: ثنا شعبة، عن حماد (¬)، ح
 [] وحدثنا سعيد بن مسعود المروزي (¬)، قال: ابنا النضر بن شميل (¬) (¬)، قال: ثنا شعبة، قال: ابنا ابو هاشم (¬) وحصين (¬)، ح
 وحدثنا ابو عبيد الله، قال: ثنا بدل، قال: ثنا (¬) شعبة، ثنا الحكم، وحماد، وابو هاشم، بمثله، في التشهد (¬)، ح
 وحدثنا عباس الدوري، قال: ثنا ابو يحيي (¬)، قال: ثنا الاعمش، ح وحدثنا نصر بن مرزق (¬)، قال:
 [] ثنا الخصيب بن ناصح (¬)، قال: ثنا وهيب، كلهم عن الاعمش، عن ابي واءل، عن عبد الله، عن النبي صلي الله عليه وسلم بحديثهم في التشهد.



   حدثنا الحسن بن عفان، قال: ثنا عبيد الله (¬)، قال: ابنا حريث (¬)، عن واصل
 [] الاحدب (¬)، ح
 وحدثنا ابو امية، قال: ثنا سعيد بن سليمان (¬)، قال: ثنا شريك (¬)،
 [] عن جامع بن ابي راشد (¬) (¬).
 وحدثنا اسحاق الدبري، عن عبد الرزاق، عن الثوري، عن حماد، ومنصور، وحصين، والاعمش، وابي هاشم كلهم عن ابي واءل.
 وسفيان (¬)، عن ابي اسحاق (¬)، عن الاسود، وابي الاحوص (¬)، عن عبد الله (¬)، ح
 [] (¬) وحدثنا الصغاني، قال: ثنا هاشم بن القاسم، عن اسراءيل، عن ابي اسحاق، عن ابي الاحوص، وابي عبيدة (¬)، عن عبد الله (¬)، ح
 وحدثني فضلك [الرازي] (¬)، قال: حدثنا قتيبة، قال: ثنا عبثر، عن الاعمش، عن ابي اسحاق، عن ابي الاحوص، عن عبد الله (¬)، كلهم ذكروا تشهد عبد الله (¬).



  CHECK باب [بيان] ايجاب الصلاة علي النبي صلي الله عليه وسلم بعد السلام عليه، وعلي عباد الله الصالحين في التشهد، وثوابه

 باب [بيان] (¬) ايجاب الصلاة علي النبي صلي الله عليه وسلم بعد السلام عليه (¬)، وعلي عباد الله الصالحين في التشهد، وثوابه   اخبرنا يونس بن عبد الاعلي، قال: ابنا ابن وهب، ان مالكا (¬) حدثه عن نعيم بن عبد الله المجمر (¬)، ان محمد بن عبد الله بن زيد الانصاري (¬) وعبد الله بن زيد هو الذي اري النداء بالصلاة (¬)  اخبره
 [] عن ابي مسعود الانصاري (¬)، انه قال: اتانا رسول الله صلي الله عليه وسلم في مسجد (¬)
 [] سعد بن عبادة (¬)، فقال له بشير بن سعد (¬): "امرنا الله ان نصلي عليك، فكيف نصلي عليك؟ قال: "فسكت النبي صلي الله عليه وسلم حتي تمنينا انه لم يساله، ثم قال رسول الله صلي الله عليه وسلم: "قولوا: اللهم صل علي محمد وعلي ال محمد (¬)، كما صليت علي ال ابراهيم (¬)، وبارك علي محمد
 [] وعلي ال محمد كما باركت علي ابراهيم في العالمين، انك حميد مجيد، والسلام كما قد علمتم".



   حدثنا يوسف بن مسلم قال: ثنا حجاج بن محمد، قال: حدثني شعبة، ح
 وحدثني عباس الدوري (¬)، قال: ثنا شبابة، ح
 وحدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، ح
 وحدثنا يزيد بن عبد الصمد (¬)، قال: ثنا ادم (¬)، كلهم عن شعبة (¬)، عن الحكم (¬)، قال:
 [] سمعت ابن ابي ليلي (¬) يحدث عن كعب بن عجرة، انه قال: الا اهدي اليك (¬) هدية؟ خرج علينا رسول الله صلي الله عليه وسلم، فقلنا: يا رسول الله (¬)، قد عرفنا كيف نسلم عليك، فكيف نصلي (¬)؟ فقال (¬): "قولوا: اللهم صل علي محمد وعلي ال محمد، كما (¬) [صليت علي ابراهيم (¬) انك حميد مجيد، اللهم بارك علي محمد (¬) وعلي ال محمد، كما] باركت علي ابراهيم وعلي (¬) ال ابراهيم انك حميد مجيد" (¬) حديثهم واحد.



   حدثنا ابو عمرو بن حازم الغفاري (¬) قال: ثنا علي بن قادم (¬) قال: ثنا مسعر (¬)، عن الحكم، باسناده، مثله.
 وليس في حديث مسعر: "الا اهدي لك هدية" (¬)؟   حدثنا حمدون بن عباد (¬) قال: ثنا ابو بدر (¬)، قال: ثنا سليمان بن مهران (¬)، ح
 [] وحدثنا الصغاني، قال: ثنا قبيصة (¬)، قال: ثنا سفيان (¬)، عن الاعمش (¬) ح
 وحدثنا ابن الجنيد (¬)، قال: ثنا ابو احمد الزبيري (¬)، قال: ثنا مالك بن مغول (¬)، كلاهما عن الحكم، باسناده، وحديثهما فيه.



   حدثنا الصغاني، قال: ثنا قبيصة، عن سفيان (¬)، عن ابراهيم بن مهاجر (¬)، عن مجاهد (¬) وعن يزيد بن ابي زياد (¬)، كلاهما عن
 [] ابن ابي ليلي (¬)، ح
 وحدثنا علي بن حرب [الطاءي] (¬)، قال: ثنا محمد بن فضيل، قال:
 [] ثنا يزيد بن ابي زياد، ويعلي (¬)، عن الاجلح (¬)، عن الحكم (¬) كلاهما (¬)
 [] عن ابن ابي ليلي (¬)، ح
 وحدثنا محمد بن علي بن داود (¬)، قال: ثنا عبد الصمد بن النعمان (¬)، عن حمزة الزيات (¬)، عن الحكم، عن ابن ابي ليلي (¬)، كلهم عن كعب بن عجرة، قال اكثرهم: "لما نزلت هذه الاية: {ياايها الذين امنوا
 [] صلوا عليه وسلموا تسليما ()} (¬) جاء رجل (¬) الي النبي صلي الله عليه وسلم فقال: يا رسول الله، هذا السلام عليك، فكيف الصلاة عليك؟ ". وذكر الحديث.



   اخبرنا يونس بن عبد الاعلي، قال: ابنا ابن وهب، ح
 وحدثنا علي بن حرب [الطاءي] (¬)، قال: ثنا عبد الملك بن عبد العزيز (¬) الماجشون (¬)، كلاهما
 [] ان مالك بن انس (¬) حدثهما عن عبد الله بن ابي بكر بن محمد بن عمرو بن حزم (¬)، عن ابيه، عن عمرو بن سليم (¬) قال: اخبرني ابو حميد الساعدي (¬)، انهم قالوا: يا رسول الله، كيف نصلي عليك؟ قال
 [] رسول الله صلي الله عليه وسلم: "قولوا: "اللهم صل علي محمد وعلي ازواجه وذريته، كما صليت علي ال (¬) ابراهيم، وبارك علي محمد وازواجه (¬) وذريته، كما باركت علي ال ابراهيم انك حميد مجيد" (¬).



   حدثنا محمد بن يحيي (¬)، قال: ثنا ابن ابي مريم (¬)، قال: ثنا محمد بن جعفر (¬)، [ح] (¬).
 [قال محمد] (¬): وحدثنا يحيي بن صالح، قال: ثنا سليمان بن بلال (¬)، قالا: ثنا العلاء بن عبد الرحمن بن يعقوب (¬)، عن ابيه، عن ابي هريرة قال:
 [] قال رسول الله صلي الله عليه وسلم: "من صلي علي واحدة صلي الله عليه عشرة".



  CHECK [باب] بيان الدعاء الذي يدعو به المصلي بعد فراغه من التشهد قبل السلام، وايجاب التعوذ من اربعة اشياء في التشهد الاخر

 [باب] (¬) بيان الدعاء الذي يدعو به المصلي بعد فراغه من التشهد قبل السلام، وايجاب التعوذ من اربعة اشياء في التشهد الاخر   حدثنا بحر بن نصر (¬)، قال: ثنا يحيي بن حسان (¬)، قال: ثنا يوسف بن يعقوب الماجشون (¬)، عن ابيه (¬)، عن الاعرج، عن عبيد (¬) الله بن ابي رافع (¬)، عن علي بن ابي طالب [رضي الله عنه] (¬)، ان رسول الله صلي الله عليه وسلم كان من اخر ما يقول بين التشهد والتسليم: "اللهم
 [] اغفر لي ما قدمت وما اخرت، وما اسررت وما اعلنت [وما اسرفت] (¬) وما انت اعلم به مني، انت المقدم وانت المءخر، لا اله الا انت".



   حدثنا عباس الدوري، قال: ثنا يعقوب بن ابراهيم بن سعد (¬)، قال: ثنا ابي، عن صالح (¬)، عن ابن شهاب قال: اخبرني عروة بن الزبير، ان (¬) عاءشة قالت: "سمعت رسول الله صلي الله عليه وسلم يستعيذ في صلاته من فتنة الدجال" (¬).   اخبرنا العباس بن الوليد (¬)، قال: اخبرني ابي، قال: ثنا
 [] الاوزاعي (¬)، قال: حدثني حسان بن عطية (¬) قال: حدثني محمد بن ابي عاءشة (¬)، قال: سمعت ابا هريرة يقول: قال رسول الله صلي الله عليه وسلم: "اذا فرغ احدكم من التشهد (¬) فليتعوذ بالله من اربع: من عذاب جهنم، و (¬) عذاب القبر، وفتنة المحيا والممات، وشر المسيح الدجال" (¬).



   اخبرني العباس بن (¬) الوليد، قال: حدثني ابي، قال: ثنا الاوزاعي (¬)، قال: حدثني يحيي بن ابي كثير، قال: حدثني ابو سلمة بن عبد الرحمن، قال: سمعت ابا هريرة يقول: قال رسول الله صلي الله عليه وسلم: "تعوذوا بالله من عذاب النار، وعذاب القبر، ومن فتنة المحيا والممات، ومن شر المسيح الدجال".   حدثنا يونس بن حبيب، قال: ثنا ابو داود (¬)، قال: ثنا هشام (¬)، ح
 وحدثنا ابو امية، قال: ثنا الحسن بن موسي الاشيب، وعبيد الله بن موسي (¬)، قالا: ثنا شيبان (¬)، كلاهما عن يحيي بن ابي كثير (¬)، عن
 [] ابي سلمة، عن ابي هريرة، ان رسول الله صلي الله عليه وسلم كان يقول: "اللهم اني اعوذ بك ... ". فذكر مثله (¬).



   حدثنا عباس الدوري، قال: ثنا هارون بن اسماعيل (¬)، قال: ثنا علي بن المبارك، قال: ثنا يحيي بن ابي كثير (¬)، عن ابي سلمة، عن ابي هريرة، ان رسول الله صلي الله عليه وسلم كان يقول في دبر كل صلاة: "اللهم اني اعوذ بك ... ". فذكر مثله.
 [لم يخرج مسلم حديث علي (¬) الذي فيه: "دبر كل صلاة"، وذكر وكيع هذا عن الاوزاعي (¬) علي ما ذكر
 [] علي بن المبارك] (¬) (¬).



   حدثنا ابراهيم بن مرزوق [البصري] (¬)، قال: ثنا عثمان بن عمر (¬)، ح
 وحدثنا ابو عبيد الله (¬)، عن عمه (¬)، كلاهما عن يونس، عن ابن
 [] شهاب، عن عروة، عن عاءشة، انها قالت: "دخل علي رسول الله وعندي امراة من اليهود، وهي تقول: هل شعرت انكم تفتنون في القبور؟ ... ". وذكر الحديث.
 قالت عاءشة: "ثم سمعت رسول الله صلي الله عليه وسلم يستعيذ بعد (¬)  من عذاب القبر".



   حدثنا محمد بن اسحاق الصغاني (¬)، وابو امية الطرسوسي، قالا: ابنا ابو اليمان، قال: ابنا شعيب، عن الزهري، قال: اخبرني عروة بن الزبير، ان عاءشة [زوج النبي صلي الله عليه وسلم] (¬) اخبرته، ان النبي صلي الله عليه وسلم كان يدعو في الصلاة: "اللهم اني اعوذ بك من عذاب القبر، واعوذ بك من فتنة المسيح الدجال، واعوذ بك من فتنة المحيا والممات، اللهم اني اعوذ بك من الماثم (¬) والمغرم". قالت: فقال له قاءل: ما اكثر ما
 [] تستعيذ من المغرم يا رسول الله؟ فقال: "ان الرجل اذا غرم حدث فكذب، ووعد فاخلف" (¬).
 هذا لفظ الصغاني، وهو اتمهما حديثا (¬).



  CHECK [باب] بيان التسليمتين عند الفراغ من التشهد

 [باب] (¬) بيان التسليمتين عند الفراغ من (¬) التشهد   حدثنا حمدان بن الجنيد (¬) والصغاني وعباس الدوري، قالوا: ثنا سليمان بن داود الهاشمي (¬)، قال: ثنا ابراهيم بن سعد (¬)، عن عبد الله بن جعفر بن عبد الرحمن بن المسور بن مخرمة (¬)، عن اسماعيل بن محمد بن
 [] سعد بن ابي وقاص (¬)، قال: اجتمعت انا والزهري فتذاكرنا تسليمة واحدة، فقال الزهري: تسليمة واحدة، فقلت: انا (¬) ابن ابي اسحاق (¬) احدث (¬) بها عليك: حدثني عامر بن سعد بن ابي وقاص (¬)، عن ابيه، "ان رسول الله صلي الله عليه وسلم كان يسلم عن يمينه وعن يساره" (¬).



   حدثنا الصغاني، قال: ثنا منصور بن سلمة (¬)، قال: ثنا عبد الله بن جعفر (¬)، عن اسماعيل بن محمد بن سعد، عن عامر بن سعد، عن سعد بن ابي وقاص، "ان رسول الله صلي الله عليه وسلم كان يسلم عن يمينه حتي نري او يري (¬) بياض خده، وعن يساره حتي نري او يري بياض فخده".   حدثنا السلمي (¬)، قال: ثنا خالد بن مخلد (¬)، قال: ثنا عبد الله بن جعفر (¬) باسناده (¬)  "كان النبي صلي الله عليه وسلم يسلم عن يمينه حتي يري
 [] بياض خده، ثم يسلم عن يساره حتي يري بياض خده" (¬).



   حدثني ابي [رحمه الله] (¬)، قال: ثنا ابو مروان (¬)، قال: ثنا عبد العزيز بن محمد (¬)، عن عمرو بن يحيي المازني (¬)، عن محمد بن يحيي بن حبان (¬)، عن عمه واسع بن حبان (¬)، قال: قلت لعبد الله بن زيد: اخبرني عن صلاة رسول الله صلي الله عليه وسلم كيف كانت؟ فذكر التكبير كلما وضع راسه، وكلما رفعه، وذكر: "السلام عليكم ورحمة الله" عن يمينه، "السلام عليكم" عن يساره (¬).



   اخبرنا عبد الرحمن بن بشر (¬)، قال: ثنا يحيي بن سعيد القطان (¬)، عن شعبة، عن الحكم (¬)، عن (¬) مجاهد، عن ابي معمر (¬)، قال: كان بمكة امير، فكان يسلم تسليمتين فقال عبد الله بن مسعود (¬):
 [] "اني علقها (¬)! كان رسول الله صلي الله عليه وسلم يسلم تسليمتين" (¬).



   حدثنا محمد بن صالح (¬)، ثنا محمد بن المنهال (¬)، قال: ثنا (¬) يزيد بن زريع، عن شعبة (¬) بمثل هذا الاسناد "وكان رسول الله صلي الله عليه وسلم يفعل ذلك" (¬).



  CHECK [باب] بيان الدليل علي ان التسليمة الواحدة غير كافية في جماعة من تسليم التشهد حتي يسلم تسليمتين، والدليل علي اباحة تسليمة الواحدة للمصلي وحده

 [باب] (¬) بيان الدليل علي ان التسليمة الواحدة غير كافية في جماعة من تسليم التشهد حتي يسلم تسليمتين، والدليل علي اباحة تسليمة (¬) الواحدة للمصلي وحده   حدثنا [ابو جعفر] احمد [بن محمد] (¬) بن ابي رجاء المصيصي، قال: ثنا وكيع (¬)، قال: ثنا مسعر، عن عبيد الله بن القبطية (¬)، عن جابر بن سمرة قال: "كنا اذا صلينا خلف رسول الله صلي الله عليه وسلم اشار احدنا الي اخيه بيده عن يمينه وعن شماله؛ فلما صلي (¬) قال رسول الله صلي الله عليه وسلم: "ما بال احدكم يفعل هذا، كانها اذناب خيل شمس، (¬)، انما يكفي
 [] احدكم او لا يكفي احدكم؟ ان يقول هكذا" ووضع يمينه علي فخذه واشار باصبعه، "ثم سلم علي اخيه من عن (¬) يمينه ومن عن شماله".



   حدثنا ابو العباس الغزي (¬) وابو عبيدة (¬) قالا: ثنا ابو نعيم، ح
 وحدثنا ابو عبيدة (¬) قال: ثنا يعلي (¬)، ح
 وحدثنا الدقيقي (¬)، قال: ثنا يزيد بن هارون، ح
 وحدثنا ابن ابي غرزة (¬)، قال:
 [] ثنا جعفر بن عون (¬)، كلهم عن مسعر (¬)، عن عبيد الله بن قبطية، عن جابر بن سمرة، قال: كنا اذا صلينا خلف النبي صلي الله عليه وسلم يقول احدنا: "السلام عليكم، السلام عليكم" بايدينا يمينا وشمالا، فقال رسول الله صلي الله عليه وسلم: "ما بال اقوام اراهم يرمون بايديهم كانها اذناب الخيل الشمس لا يسكن احدكم في الصلاة، ويشير باصبعه علي فخذه؟ ". ثم قال: "ليسلم (¬) احدكم علي اخيه عن يمينه وعن شماله".



   حدثنا الصغاني، قال: ثنا ابو نعيم، ويعلي (¬)، قالا (¬): ثنا مسعر (¬)، عن عبيد الله بن القبطية، عن جابر بن سمرة، قال: كنا نقول خلف رسول الله صلي الله عليه وسلم سلمنا: "السلام عليكم، السلام عليكم"، يشير احدنا يده (¬) عن يمينه، وعن شماله، فقال رسول الله صلي الله عليه وسلم: "ما بال الذين يرمون بايديهم في الصلاة كانها اذناب الخيل الشمس، انما (¬)
 [] يكفي احدكم ان يضع يده علي فخذه، ثم يسلم علي يمينه، وعلي يساره".



   حدثنا عمار بن رجاء (¬)، قال: ثنا عبيد الله بن موسي (¬)، عن اسماعيل، عن الفرات القزاز (¬) (¬) عن عبيد الله (¬)، عن جابر بن سمرة، قال: صليت مع النبي صلي الله عليه وسلم فكنا (¬) اذا سلمنا قلنا بايدينا "السلام عليكم، السلام عليكم" فنظر الينا رسول الله صلي الله عليه وسلم فقال: "ما شانكم تشيرون بايديكم كانها اذناب خيل شمس! اذا سلم احدكم فليلتفت الي صاحبه، ولا يومء (¬) بيده".



   حدثنا ابو زرعة الرازي (¬)، قال: ثنا محمد بن سعيد بن سابق (¬)، قال: ثنا عمرو بن ابي قيس (¬)، عن فرات القزاز (¬)، عن عبد الله بن ابي عمار (¬)، عن جابر بن سمرة، قال: "دخلت انا وابي علي رسول الله صلي الله عليه وسلم فصلي بنا، فلما سلم اوما الناس بايديهم يمينا وشمالا، فابصرهم، فقال: "ما شانكم تقلبون بايديكم كانها اذناب الخيل الشمس، اذا سلم احدكم فليسلم علي من علي يمينه، وعلي من علي يساره (¬). فلما صلوا معه ايضا لم يفعلوا ذلك" (¬).



   حدثنا الحسن بن علي بن عفان [العامري] (¬)، قال: ثنا محمد بن بشر (¬)، قال: ثنا سعيد (¬)، عن (¬) قتادة، عن زرارة بن اوفي (¬)، عن سعد بن هشام (¬)، قال: انطلقت الي عبد الله بن عباس، فسالته عن "الوتر" فقال: "الا ادلك علي اعلم اهل الارض؟ ... "، وذكر الحديث.
 قال سعد بن هشام: قلت لعاءشة: يا ام المءمنين، انبءيني عن وتر رسول الله صلي الله عليه وسلم، فقالت: "كنا نعد له سواكه وطهوره من الليل؛ فيبعثه الله فيما شاء ان يبعثه من الليل، فيتسوك ويتوضا، ثم يصلي
 [] تسع ركعات، لا يجلس فيهن الا عند الثامنة، فيدعو ربه، ويصلي علي نبيه، ثم ينهض ولا يسلم، ثم يصلي التاسعة، ثم يسلم تسليمة يسمعنا، او تسليما (¬) يسمعنا".



   حدثنا الدبري، عن عبد الرزاق (¬)، عن معمر، عن قتادة باسناده (¬)  واقتص (¬) الحديث بمعني حديث سعيد (¬).
 وروي هشام الدستواءي عن قتادة قال (¬): "ثم يسلم تسليمة واحدة يسمعنا" (¬).



