 وما قدروا الله حق قدره والارض جميعا قبضته يوم القيامة والسماوات مطويات بيمينه سبحانه وتعالي عما يشركون () ونفخ في الصور فصعق من في السماوات ومن في الارض الا من شاء الله ثم نفخ فيه اخري فاذا هم قيام ينظرون ()
 وما قدروا الله حق قدره اي ما عظموه حق عظمته حين اشركوا به غيره ثم اخبر عن عظمته فقال والارض جميعا قبضته يوم القيامة والسماوات مطويات بيمينه سبحانه وتعالي عما يشركون (ق) عن عبد الله بن مسعود رضي الله عنه قال «جاء جبريل الي رسول الله صلي الله عليه وسلم قال يا محمد ان الله يضع السماء علي اصبع
 
 والارض علي اصبع والجبال علي اصبع والشجر والانهار علي اصبع وساءر الخلق علي اصبع ثم يقول انا الملك فضحك رسول الله صلي الله عليه وسلم وقال وما قدروا الله حق قدره وفي رواية «والماء والثري علي اصبع وساءر الخلق علي اصبع ثم يهزهن وفيه ان رسول الله صلي الله عليه وسلم ضحك حتي بدت نواجذه تعجبا وتصديقا له ثم قرا وما قدروا الله حق قدره الاية (ق) عن ابن عمر رضي الله عنهما قال: «قال رسول الله صلي الله عليه وسلم يطوي الله السموات يوم القيامة ثم ياخذهن بيده اليمني ثم يقول: انا الملك اين الجبارون اين المتكبرون ثم يطوي الارضين بشماله ثم يقول: انا الملك اين الجبارون اين المتكبرون، وفي رواية يقول: انا الله ويقبض اصابعه ويبسطها ثم يقول انا الملك اين الجبارون اين المتكبرون، وفي رواية يقول: انا الله ويقبض اصابعه انا الملك حتي نظرت الي المنبر يتحرك من اسفل شء منه حتي اني اقول اساقط هو برسول الله صلي الله عليه وسلم» لفظ مسلم وللبخاري «ان الله يقبض يوم القيامة الارضين وتكون السموات بيمينه ويقول انا الملك» (خ) عن ابي هريرة رضي الله عنه قال سمعت رسول الله صلي الله عليه وسلم يقول «يقبض الله الارض ويطوي السماء بيمينه ثم يقول انا الملك اين ملوك الارض» قال ابو سليمان الخطابي ليس فيما يضاف الي الله عز وجل من صفة اليدين شمال لان الشمال محمل النقص والضعف وقد روي كلتا يديه يمين وليس عندنا معني اليد الجارحة انما هي صفة جاء بها التوقيف فنحن نطلقها علي ما جاءت ولا نكيفها وننتهي الي حيث انتهي الكتاب والاخبار الماثورة الصحيحة وهذا مذهب اهل السنة والجماعة وقال سفيان بن عيينة كل ما وصف الله به نفسه في كتابه فتفسيره تلاوته والسكوت عليه.
 قوله عز وجل: ونفخ في الصور فصعق من في السماوات ومن في الارض اي ماتوا من الفزع وهي النفخة الاولي الا من شاء الله تقدم في سورة النمل تفسير هذا الاستثناء وقال الحسن الا من يشاء الله يعني الله وحده ثم نفخ فيه اي في الصور اخري مرة اخري وهي النفخة الثانية فاذا هم قيام اي من قبورهم ينظرون اي ينتظرون امر الله فيهم (ق) عن ابي هريرة رضي الله تعالي عنه قال: قال رسول الله صلي الله عليه وسلم «ما بين النفختين اربعون قالوا اربعون يوما، قال ابو هريرة: ابيت، قالوا: اربعون شهرا، قال ابو هريرة: ابيت، قالوا:
 اربعون سنة قال: ابيت، ثم ينزل الله عز وجل من السماء ماء فينبتون كما ينبت البقل وليس من الانسان شء لا يبلي الا عظم واحد وهو عجب الذنب ومنه يركب الخلق يوم القيامة» قوله تعالي:

  [سورة الزمر (): الايات  الي ]</span>
 واشرقت الارض بنور ربها ووضع الكتاب وجء بالنبيين والشهداء وقضي بينهم بالحق وهم لا يظلمون () ووفيت كل نفس ما عملت وهو اعلم بما يفعلون () وسيق الذين كفروا الي جهنم زمرا حتي اذا جاءها فتحت ابوابها وقال لهم خزنتها الم ياتكم رسل منكم يتلون عليكم ايات ربكم وينذرونكم لقاء يومكم هذا قالوا بلي ولكن حقت كلمة العذاب علي الكافرين () قيل ادخلوا ابواب جهنم خالدين فيها فبءس مثوي المتكبرين () وسيق الذين اتقوا ربهم الي الجنة زمرا حتي اذا جاءها وفتحت ابوابها وقال لهم خزنتها سلام عليكم طبتم فادخلوها خالدين ()
 واشرقت الارض بنور ربها وذلك حين يتجلي الرب تبارك وتعالي لفصل القضاء بين خلقه فما يضارون في نوره كما لا يضارون في الشمس في اليوم الصحو وقيل بعدل ربها واراد بالارض عرصات القيامة ووضع الكتاب اي كتاب الاعمال وقيل اللوح المحفوظ لان فيه اعمال جميع الخلق من المبدا الي المنتهي وجء بالنبيين يعني ليكونوا شهداء علي اممهم والشهداء قال ابن عباس يعني الذين يشهدون للرسل بتبليغ الرسالة وهم امة محمد صلي الله عليه وسلم وقيل يعني الحفظة وقضي بينهم بالحق اي بالعدل وهم لا يظلمون اي لا يزاد في
 
 سيءاتهم ولا ينقص من حسناتهم ووفيت كل نفس ما عملت اي ثواب ما عملت وهو اعلم بما يفعلون يعني انه سبحانه وتعالي عالم بافعالهم لا يحتاج الي كاتب ولا الي شاهد.
 قوله تعالي: وسيق الذين كفروا الي جهنم يعني سوقا عنيفا زمرا افواجا بعضهم علي اثر بعض كل امة علي حدة وقيل جماعات متفرقة واحدتها زمرة حتي اذا جاءها فتحت ابوابها يعني السبعة وكانت قبل ذلك مغلقة وقال لهم خزنتها يعني توبيخا وتقريعا الم ياتكم رسل منكم اي من انفسكم ومن جنسكم يتلون عليكم ايات ربكم وينذرونكم لقاء يومكم هذا قالوا بلي ولكن حقت كلمة العذاب اي وجبت علي الكافرين وهي قوله لاملان جهنم من الجنة والناس اجمعين قيل ادخلوا ابواب جهنم خالدين فيها فبءس مثوي المتكبرين قوله عز وجل: وسيق الذين اتقوا ربهم الي الجنة زمرا فان قلت عبر عن الفريقين بلفظ السوق فما الفرق بينهما.
 قلت المراد بسوق اهل النار طردهم الي العذاب بالهوان والعنف كما يفعل بالاسير اذا سيق الي الحبس او القتل، والمراد بسوق اهل الجنة سوق مراكبهم لانهم يذهبون اليها راكبين او المراد بذلك السوق اسراعهم الي دار الكرامة والرضوان فشتان ما بين السوقين حتي اذا جاءها وفتحت ابوابها فان قلت قال في اهل النار فتحت بغير واو وهنا زاد حرف الواو فما الفرق.
 قلت فيه وجوه احدها انها زاءدة الثاني انها واو الحال مجازه وقد فتحت ابوابها فادخل الواو لبيان انها كانت مفتحة قبل مجيءهم اليها وحذف الواو في الاية الاولي لبيان ان ابواب جهنم كانت مغلقة قبل مجيءهم اليها ووجه الحكمة في ذلك ان اهل الجنة اذا جاءوها ووجدوا ابوابها مفتحة حصل لهم السرور والفرح بذلك واهل النار اذا راوها مغلقة كان ذلك نوع ذلك وهوان لهم. الثالث زيدت الواو هنا لبيان ان ابواب الجنة ثمانية ونقصت هناك لان ابواب جهنم سبعة والعرب تعطف بالواو فيما فوق السبعة تقول سبعة وثمانية.
 فان قلت حتي اذا جاءوها شرط فاين جوابه؟
 قلت فيه وجوه احدها انه محذوف والمقصود من الحذف ان يدل علي انه بلغ في الكمال الي حيث لا يمكن ذكره الثاني ان الجواب هو قوله وقال لهم خزنتها سلام عليكم بغير واو الثالث تقديره فادخلوها خالدين دخلوها فحذف دخلوها لدلالة الكلام عليه وقال لهم خزنتها سلام عليكم اي ابشروا بالسلامة من كل الافات طبتم قال ابن عباس معناه طاب لكم المقام وقيل اذا قطعوا النار حبسوا علي قنطرة بين الجنة والنار فيقتص بعضهم من بعض حتي اذا هذبوا وطيبوا دخلوا الجنة فيقول لهم رضوان واصحابه سلام عليكم طبتم فادخلوها خالدين وقال علي بن ابي طالب رضي الله عنه اذا سيقوا الي الجنة فاذا انتهوا اليها وجدوا عند بابها شجرة يخرج من تحتها عينان فيغتسل المءمن من احداهما فيطهر ظاهره ويشرب من الاخري فيطهر باطنه وتتلقاهم الملاءكة علي ابواب الجنة يقولون سلام عليكم طبتم فادخلوها خالدين.
  [سورة الزمر (): الايات  الي ]
 وقالوا الحمد لله الذي صدقنا وعده واورثنا الارض نتبوا من الجنة حيث نشاء فنعم اجر العاملين () وتري الملاءكة حافين من حول العرش يسبحون بحمد ربهم وقضي بينهم بالحق وقيل الحمد لله رب العالمين ()
 وقالوا الحمد لله الذي صدقنا وعده اي بالجنة واورثنا الارض اي ارض الجنة نتصرف فيها كما نشاء تشبيها بحال الوارث وتصرفه فيما يرثه وهو قوله تعالي: نتبوا اي ننزل من الجنة اي في الجنة حيث
 
 نشاء
 فان قلت فما معني قوله حيث نشاء وهل يتبوا احدهم مكان غيره.
 قلت يكون لكل واحد منهم جنة لا توصف سعة وحسنا وزيادة علي الحاجة فيتبوا من جنته حيث يشاء ولا يحتاج الي غيره وقيل ان امة محمد صلي الله عليه وسلم يدخلون الجنة قبل الامم فينزلون فيها حيث شاءوا ثم تنزل الامم بعدهم فيما فضل منها قال الله عز وجل: فنعم اجر العاملين اي ثواب المطيعين في الدنيا الجنة في العقبي وتري الملاءكة حافين من حول العرش
 اي محدقين محيطين بحافته وجوانبه يسبحون بحمد ربهم وقيل هذا تسبيح تلذذ لا تسبيح تعبد لان التكليف يزول في ذلك اليوم وقضي بينهم بالحق بين اهل الجنة واهل النار بالعدل وقيل الحمد لله رب العالمين اي يقول اهل الجنة شكرا حين تم وعد الله لهم، وقيل ابتدا الله ذكر الخلق بالحمد في قوله الحمد لله الذي خلق السماوات والارض وختم بالحمد في اخر الامر وهو استقرار الفريقين في منازلهم فنبه بذلك علي تحميده في بداءة كل امر وخاتمته والله تعالي اعلم بمراده واسرار كتابه.
 
  سورة حم المءمن
 وتسمي سورة غافر وهي مكية قيل غير ايتين وهما قوله تعالي: الذين يجادلون في ايات الله والتي بعدها وهي خمس وثمانون اية والف وماءة وتسع وتسعون كلمة واربعة الاف وتسعماءة وستون حرفا، عن عبد الله بن مسعود رضي الله تعالي عنه قال «ان مثل صاحب القران كمثل رجل انطلق يرتاد لاهله منزلا فمر باثر غيث فبينما هو يسير فيه ويتعجب منه اذ هبط علي روضات دمثات فقال عجبت من الغيث الاول فهذا اعجب منه واعجب فقيل له ان مثل الغيث الاول مثل هذه الروضات الدمثات مثل ال حم في القران» وعن ابن عباس قال: لكل شء لباب ولباب القران الحواميم وقال ابن مسعود اذا وقعت في ال حم وقعت في روضات الجنة اتانق فيهن، وقال سعد بن ابراهيم ان ال حم تسمي العراءس.
 بسم الله الرحمن الرحيم

  [سورة غافر (): الايات  الي ]</span>
 بسم الله الرحمن الرحيم
 حم () تنزيل الكتاب من الله العزيز العليم () غافر الذنب وقابل التوب شديد العقاب ذي الطول لا اله الا هو اليه المصير ()
 قوله عز وجل: حم قال ابن عباس رضي الله عنهما: حم اسم الله الاعظم وعنه قال الر وحم ون حروف اسمه الرحمن مقطعة وقيل حم اسم للسورة وقيل الحاء افتتاح اسماءه حليم وحميد وحي وحكيم وحنان، والميم افتتاح اسماءه ملك ومجيد ومنان، وقيل معناه حم بضم الحاء اي قضي ما هو كاءن تنزيل الكتاب من الله العزيز اي الغالب القادر وقيل الذي لا مثل له العليم اي بكل المعلومات غافر الذنب يعني ساتر الذنب وقابل التوب يعني التوبة قال ابن عباس غافر الذنب لمن قال لا اله الا الله وقابل التوب ممن قال لا اله الا الله شديد العقاب لمن لا يقول لا اله الا الله ذي الطول يعني السعة والغني وقيل ذي الفضل والنعم واصل الطول الانعام الذي تطول مدته علي صاحبه لا اله الا هو يعني هو الموقوف بصفات الوحدانية التي لا يوصف بها غيره اليه المصير اي مصير العباد اليه في الاخرة قوله تعالي:
 

  [سورة غافر (): الايات  الي ]</span> 
 ما يجادل في ايات الله الا الذين كفروا فلا يغررك تقلبهم في البلاد () كذبت قبلهم قوم نوح والاحزاب من بعدهم وهمت كل امة برسولهم لياخذوه وجادلوا بالباطل ليدحضوا به الحق فاخذتهم فكيف كان عقاب () وكذلك حقت كلمة ربك علي الذين كفروا انهم اصحاب النار () الذين يحملون العرش ومن حوله يسبحون بحمد ربهم ويءمنون به ويستغفرون للذين امنوا ربنا وسعت كل شء رحمة وعلما فاغفر للذين تابوا واتبعوا سبيلك وقهم عذاب الجحيم ()
 ما يجادل يعني ما يخاصم ويحاجج في ايات الله يعني في دفع ايات الله بالتكذيب والانكار الا الذين كفروا قال ابو العالية ايتان ما اشدهما علي الذين يجادلون في القران.
 قوله تعالي: ما يجادل في ايات الله الا الذين كفروا وقوله وان الذين اختلفوا في الكتاب لفي شقاق بعيد وعن ابي هريرة رضي الله تعالي عنه عن النبي صلي الله عليه وسلم قال «ان جدالا في القران كفر» اخرجه ابو داود وقال المراد في القران كفر وعن عمرو بن شعيب عن ابيه عن جده قال «سمع رسول الله صلي الله عليه وسلم قوما يتمارون فقال انما هلك من كان قبلكم بهذا ضربوا كتاب الله عز وجل بعضه ببعض وانما انزل الكتاب يصدق بعضه بعضا فلا تكذبوا بعضه ببعض فما علمتم منه فقولوه وما جهلتم منه فكلوه الي عالمه» (م) عن عبد الله بن عمرو بن العاص قال:
 هاجرت الي رسول الله صلي الله عليه وسلم يوما فسمع اصوات رجلين اختلفا في اية فخرج رسول الله صلي الله عليه وسلم يعرف في وجهه الغضب فقال «انما هلك من كان قبلكم باختلافهم في الكتاب» فلا يغررك تقلبهم يعني تصرفهم في البلاد للتجارات وسلامتهم فيها مع كفرهم فان عاقبة امرهم العذاب كذبت قبلهم قوم نوح والاحزاب من بعدهم يعني الكفار الذين تحزبوا علي انبياءهم بالتكذيب من بعد قوم نوح وهمت كل امة برسولهم لياخذوه قال ابن عباس ليقتلوه ويهلكوه وقيل لياسروه وجادلوا يعني خاصموا بالباطل ليدحضوا يعني ليبطلوا به الحق الذي جاءت به الرسل فاخذتهم فكيف كان عقاب يعني انزلت بهم من الهلاك ما هموا هم بانزاله بالرسل وقيل معناه فكيف كان عقابي اياهم اليس كان مهلكا مستاصلا وكذلك حقت اي وجبت كلمة ربك يعني كما وجبت كلمة العذاب علي الامم المكذبة حقت علي الذين كفروا يعني من قومك انهم يعني بانهم اصحاب النار قوله عز وجل: الذين يحملون العرش قيل حملة العرش اليوم اربعة فاذا كان يوم القيامة اردفهم الله تعالي باربعة اخر كما قال الله تعالي: ويحمل عرش ربك فوقهم يومءذ ثمانية وهم اشرف الملاءكة وافضلهم لقربهم من الله عز وجل وهم علي صورة الاوعال وجاء في الحديث ان لكل ملك منهم وجه رجل ووجه اسد ووجه ثور ووجه نسر، ولكل واحد منهم اربعة اجنحة جناحان منها علي وجهه مخافة ان ينظر الي العرش فيصعق وجناحان يهفو بهما في الهواء ليس لهم كلام غير التسبيح والتحميد والتمجيد ما بين اظلافهم الي ركبهم كما بين سماء الي سماء وقال ابن عباس: حملة العرش ما بين كعب احدهم الي اسفل قدميه مسيرة خمسماءة عام، ويروي ان اقدامهم في تخوم الارضين والارضون والسموات الي حجزهم تسبيحهم سبحان ذي العزة والجبروت سبحان ذي الملك والملكوت سبحان الحي الذي لا يموت سبوح قدوس رب الملاءكة والروح وقيل ان ارجلهم في الارض السفلي ورءوسهم خرقت العرش وهم خشوع لا يرفعون طرفهم وهم اشد خوفا من اهل السماء السابعة واهل السماء السابعة اشد خوفا من التي تليها والتي تليها اشد خوفا من التي تليها.
 وروي جابر عن النبي صلي الله عليه وسلم قال «اذن لي ان احدث عن ملك من ملاءكة الله عز وجل من حملة العرش ان ما بين شحمة اذنه الي عاتقه مسيرة سبعماءة عام» اخرجه ابو داود واما صفة العرش فقيل انه جوهرة خضراء وهو من اعظم المخلوقات خلقا وروي جعفر بن محمد عن ابيه عن جده انه قال: ان ما بين القاءمة من قواءم العرش والقاءمة الثانية كخفقان الطير المسرع ثلاثين الف عام ويكسي العرش كل يوم الف لون من النور لا يستطيع ان ينظر اليه خلق من خلق الله تعالي والاشياء كلها في العرش كحلقة في فلاة وقال مجاهد بين السماء السابعة وبين العرش سبعون الف حجاب حجاب نور وحجاب ظلمة وحجاب نور وحجاب ظلمة وقيل ان العرش قبلة لاهل السماء كما ان الكعبة قبلة لاهل الارض قوله: ومن حوله يعني الطاءفين به وهم الكروبيون وهم سادات الملاءكة، قال وهب بن منبه: ان حول العرش سبعين الف صف من الملاءكة صف خلف صف يطوفون بالعرش يقبل هءلاء ويدبر هءلاء فاذا استقبل بعضهم بعضا هلل هءلاء وكبر هءلاء ومن وراءهم سبعون الف صف قيام ايديهم الي اعناقهم قد وضعوها علي عواتقهم فاذا سمعوا تكبير اولءك وتهليلهم رفعوا اصواتهم فقالوا سبحانك
 
 وبحمدك ما اعظمك واجلك انت الله لا اله غيرك انت الاكبر والخلق كلهم اليك راجعون ومن وراء هءلاء وهءلاء ماءة الف صف من الملاءكة قد وضعوا اليمني علي اليسري ليس منهم احد الا يسبح بتحميد لا يسبحه الاخر ما بين جناحي احدهم مسيرة ثلاثماءة عام وما بين شحمة اذنه الي عاتقه اربعماءة عام واحتجب الله عز وجل من الملاءكة الذين حول العرش بسبعين حجابا من نار وسبعين حجابا من ظلمة وسبعين حجابا من نور وسبعين حجابا من در ابيض وسبعين حجابا من ياقوت احمر وسبعين حجابا من زبرجد اخضر وسبعين حجابا من ثلج وسبعين حجابا من ماء وسبعين حجابا من برد وما لا يعلمه الا الله عز وجل.
 قوله تعالي: يسبحون بحمد ربهم اي ينزهون الله تعالي عما لا يليق بجلاله والتحميد هو الاعتراف بانه هو المنعم علي الاطلاق ويءمنون به اي يصدقون بانه واحد لا شريك له ولا مثل له ولا نظير له.
 فان قلت قدم قوله يسبحون بحمد ربهم علي قوله ويءمنون به ولا يكون التسبيح الا بعد الايمان فما فاءدة قوله ويءمنون به.
 قلت فاءدته التنبيه علي شرف الايمان وفضله والترغيب فيه. ولما كان الله عز وجل محتجبا عنهم بحجب جلاله وجماله وكماله وصفهم بالايمان به. قال شهر بن حوشب حملة العرش ثمانية اربعة منهم يقولون سبحانك اللهم وبحمدك لك الحمد علي حلمك بعد علمك واربعة منهم يقولون سبحانك اللهم وبحمدك لك الحمد علي عفوك بعد قدرتك قال وكانهم يرون ذنوب بني ادم ويستغفرون للذين امنوا اي يسالون الله تعالي المغفرة لهم قيل هذا الاستغفار من الملاءكة مقابل لقولهم اتجعل فيها من يفسد فيها ويسفك الدماء فلما صدر هذا منهم اولا تداركوه بالاستغفار لهم ثانيا وهو كالتنبيه لغيرهم فيجب علي كل من تكلم في احد بشء يكرهه ان يستغفر له ربنا اي ويقولون ربنا وسعت كل شء رحمة وعلما اي وسعت رحمتك وعلمك كل شء وفيه تنبيه علي تقديم الثناء علي الله تعالي بما هو اهله قيل المطلوب بالدعاء فلما قدموا الثناء علي الله عز وجل قالوا فاغفر للذين تابوا واتبعوا سبيلك اي دينك وقهم عذاب الجحيم قال مطرف انصح عباد الله للمءمنين الملاءكة واغش الخلق للمءمنين هم الشياطين.

