 في قلوبهم مرض فزادهم الله مرضا ولهم عذاب اليم بما كانوا يكذبون () واذا قيل لهم لا تفسدوا في الارض قالوا انما نحن مصلحون () الا انهم هم المفسدون ولكن لا يشعرون () واذا قيل لهم امنوا كما امن الناس قالوا انءمن كما امن السفهاء الا انهم هم السفهاء ولكن لا يعلمون () واذا لقوا الذين امنوا قالوا امنا واذا خلوا الي شياطينهم قالوا انا معكم انما نحن مستهزءن ()
 في قلوبهم مرض اي شك ونفاق واصل المرض الضعف والخروج عن الاعتدال الخاص بالانسان وسمي الشك في الدين والنفاق مرضا لانه يضعف الدين كالمرض يضعف البدن فزادهم الله مرضا يعني ان الايات كانت تنزل تتري، اي اية بعد اية فلما كفروا باية ازدادوا بعد ذلك كفرا ونفاقا ولهم عذاب اليم اي مءلم يخلص وجعه الي قلوبهم بما كانوا يكذبون اي بتكذيبهم الله ورسوله في السر، وقرء بالتخفيف اي بكذبهم اذ قالوا امنا وهم غير مءمنين واذا قيل لهم يعني المنافقين وقيل اليهود والمعني اذا قال لهم المءمنون لا تفسدوا في الارض اي بالكفر وتعويق الناس عن الايمان بمحمد صلي الله عليه وسلم وبالقران قالوا انما نحن مصلحون يعني يقولونه كذبا الا كلمة تنبيه ينبه بها المخاطب انهم هم المفسدون يعني في الارض بالكفر وهو اشد الفساد ولكن لا يشعرون وذلك لانهم يظنون ان ما هم عليه من النفاق وابطان الكفر صلاح وهو عين الفساد.
 وقيل لا يشعرون ما اعد الله لهم من العذاب واذا قيل لهم يعني المنافقين وقيل اليهود امنوا كما امن الناس يعني المهاجرين والانصار. وقيل عبد الله بن سلام واصحابه من مءمني اهل الكتاب، والمعني اخلصوا في ايمانكم كما اخلص هءلاء في ايمانهم لان المنافقين كانوا يظهرون الايمان قالوا انءمن كما امن السفهاء اي الجهال. فان قلت كيف يصح النفاق مع المجاهرة بقولهم: انءمن كما امن السفهاء. قلت كانوا يظهرون هذا
 
 القول فيما بينهم لا عند المءمنين فاخبر الله نبيه صلي الله عليه وسلم والمءمنين بذلك فرد الله ذلك عليهم بقوله الا انهم هم السفهاء يعني الجهال. واصل السفه خفة العقل ورقة العلم وانما سمي الله المنافقين سفهاء لانهم كانوا عند انفسهم عقلاء رءساء فقلب ذلك عليهم وسماهم سفهاء ولكن لا يعلمون يعني انهم كذلك. قوله تعالي:
 واذا لقوا الذين امنوا يعني هءلاء المنافقين اذا لقوا المهاجرين والانصار قالوا امنا كايمانكم واذا خلوا اي رجعوا. وقيل هو من الخلوة الي قيل بمعني الباء اي ب شياطينهم وقيل بمعني مع اي مع شياطينهم والمراد بشياطينهم رءساءهم وكهنتهم قال ابن عباس وهم خمسة نفر: كعب بن الاشرف من اليهود بالمدينة وابو بردة من بني اسلم، وعبد الدار في جهينة وعوف بن عامر في بني اسد وعبد الله بن السوداء بالشام، ولا يكون كاهن الا ومعه شيطان تابع لهم، وقيل لهم رءساءهم الذين شابهوا الشياطين في تمردهم قالوا انا معكم اي علي دينكم انما نحن مستهزءن اي بمحمد واصحابه بما نظهر لهم من الاسلام لنامن شرهم ونقف علي سرهم وناخذ من غناءمهم وصدقاتهم. قال ابن عباس نزلت هذه الاية في عبد الله بن ابي واصحابه، وذلك انهم خرجوا ذات يوم فاستقبلهم نفر من اصحاب رسول الله صلي الله عليه وسلم فقال عبد الله بن ابي لاصحابه انظروا كيف ارد هءلاء السفهاء عنكم؟ فذهب فاخذ بيد ابي بكر الصديق فقال: مرحبا بالصديق سيد بني تميم وشيخ الاسلام وثاني رسول الله صلي الله عليه وسلم في الغار الباذل نفسه وماله لرسول الله صلي الله عليه وسلم ثم اخذ بيد عمر فقال: مرحبا بسيد بني عدي بن كعب الفاروق القوي في دين الله الباذل نفسه وماله لرسول الله صلي الله عليه وسلم ثم اخذ بيد علي فقال: مرحبا يا ابن عم رسول الله صلي الله عليه وسلم وختمه وسيد بني هاشم ما خلا رسول الله صلي الله عليه وسلم. فقال له علي: اتق الله يا عبد الله ولا تنافق فان المنافقين شر خليقة الله. فقال مهلا يا ابا الحسن اني لا اقول هذا نفاقا والله ان ايماننا كايمانكم وتصديقنا كتصديقكم ثم تفرقوا فقال عبد الله لاصحابه كيف رايتموني فعلت؟ فاثنوا عليه خيرا.

