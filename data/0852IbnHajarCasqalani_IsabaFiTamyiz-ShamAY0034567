 تقدم في الاسماء ابو اياس الساعدي ذكره الطبري ولم يخرج له شيءا وذكره المستغفري وساق بسنده الي عبد العزيز بن ابان عن صالح بن حسان عن سعيد بن المسيب عن ابي اياس الساعدي قال كنت رديف النبي صلي الله عليه وسلم فقال قل قلت ما اقول قال قل قل هو الله احد ثم قال قل قل اعوذ برب الفلق وقل اعوذ برب الناس ثم قال يا ابا اياس ما قرا الناس بمثلهن وكذا اخرجه الحارث بن ابي اسامة عن عبد العزيز بن ابان وعبد العزيز متروك وذكره بن ابي عاصم في الوحدان فقال ابو اياس بن سهل من بني ساعدة ثم اخرج عن ابي شيبة عن مصعب بن المقدام عن محمد بن ابراهيم عن ابي حازم انه جلس الي بن ابي اياس بن سهل الانصاري فقال اقبل علي فاقبلت عليه فقال الا احدثك عن ابي عن النبي صلي الله عليه وسلم قال لان اصلي حتي تطلع الشمس احب الي من شد علي جياد الخيل في سبيل الله الحديث كذا قال واظنه غير الاول واسم هذا سهل جزما وانما قيل فيه ابو اياس لان اسم ابنه اياس ابو اياس الليثي ذكره بن عساكر في حرف الالف والياء الاخيرة من تاريخه فقال قيل له صحبة وشهد خطبة عمر بالجابية ثم ساق من طريق عبيد الله بن ابي زياد عن الزهري عن عبيد الله بن عبد الله بن عتبة عن ابي اياس الليثي ثم الاشجعي صاحب رسول الله صلي الله عليه وسلم انه بينما هو عند عمر بالجابية زمان قدمها عمر جاء رجل فقال ان امراتي زنت فذكر قصة قال بن عساكر قال غيره عن ابي زاءدة الليثي وهو الصواب قلت وهو محتمل ويحتمل ان يكون هو ابا اناس الذي تقدم بالنون ابو ايمن الانصاري مولي عمرو بن الجموح ذكره بن اسحاق فيمن استشهد باحد ابو ايوب الانصاري خالد بن زيد بن كليب مشهور بكنيته واسمه تقدم ابو ايوب جارية بن قدامة التميمي تقدم في الاسماء وهو باسمه اشهر ابو ايوب اليمامي ذكره المستغفري وحكي خليفة انه روي عن النبي صلي الله عليه وسلم §  <> ابو ايوب اخر ذكره العثماني في الصحابة واخرج من طريق عاصم بن علي عن ابيه عن عبد الله بن عثمان بن خثيم عن جده ابي ايوب ان رجلا قال للنبي صلي الله عليه وسلم عظني واوجز بن فتحون ابو ايوب الازدي سياتي ذكره في القسم الرابع ان شاء الله تعالي ابو ايوب المالكي ذكر سيف في الفتوح ان عمرو بن العاص امره علي جيش في قتال الروم وذكره الطبري من طريقه واستدركه بن فتحون القسم الثاني من حرف الالف ابو ادريس الخولاني عاءذ الله بن عبيد الله تقدم ابو اسحاق قبيصة بن ذءيب الخزاعي تقدم ايضا ابو اسحاق ابراهيم بن عبد الرحمن بن عوف الزهري تقدم ابو امامة بن سهل بن حنيف الانصاري اسمه اسعد تقدم ابو امية بن الاخنس بن شهاب بن شريق الثقفي مختلف في صحبة ابيه وروي هو عن عمر قال الثوري عن عمرو بن عبد الرحمن السهمي عن ابي سلمة بن سفيان المخزومي عن ابي امية بن الاخنس الثقفي قال كنت عند عمر فاتاه رجل فقال ان ابني شج شجة موضحة القسم الثالث ابو اسحاق كعب بن ماتع المعروف بكعب الاحبار تقدم في الاسماء ابو الاسود يزيد بن الاسود الجرشي تقدم ابو الاسود الدءلي ظالم بن عمرو تقدم ابو الاسود الهزاني من عنزة ذكره وثيمة في الردة وقال انه كان نازلا في بني حنيفة فلما قتل مسيلمة حبيب بن عبد الله رسول ابي بكر الصديق انكر ابو الاسود ذلك وقال ان قتل الرسول من حادث الدهر عظيم في سالف الايام بءس من كان من حنيفة ان كان مضي او بقي علي الاسلام واظهر ابو الاسود اسلامه حينءذ استدركه بن فتحون ابو امية الاسدي والد قتادة اسمه كبير بموحدة بوزن عظيم تقدم في الاسماء ابو امية الشعباني اسمه يحمد بضم الياء الاخيرة وسكون المهملة وكسر الميم وقيل عبد الله بن اخامر استدركه يحيي بن عبد الوهاب علي جده ابي عبد الله بن منده وساق من طريق عبد الملك بن يسار §  <> الثقفي حدثني ابو امية الشعباني وكان جاهليا فذكر حديثا قلت وهذا اخرجه يعقوب بن سفيان عن سليمان بن عبد الرحمن عن مطر بن العلاء عن عبد الملك بن يسار وقال بعد قوله جاهليا حدثني معاذ بن جبل رفعه ثلاثون خلافة ونبوة وثلاثون خلافة وملك وثلاثون ملك وتجبر وما وراء ذلك لا خير فيه قلت قال ابو حاتم الرازي ادرك الجاهلية وقال ابو موسي في الذيل ابو امية الشعباني يروي عن ابي ثعلبة الخشني قلت وله رواية عن معاذ بن جبل وحديثه مخرج في السنن وفي كتاب خلق افعال العباد للبخاري من طريق عمرو بن حارثة عنه عن ابي ثعلبة وروي عنه ايضا عبد الملك بن سفيان الثقفي وعبد السلام بن مكلبة وذكره بن حبان في ثقات التابعين ابو امية سويد بن غفلة الجعفي تقدم في الاسماء ابو امية العدوي مولي عمر له ادراك اخرج بن ابي شيبة من طريق بن عباس قال كاتب عمر عبدا له يكني ابا امية فجاء بنجمه حين حل وكان اول نجم في الاسلام ولم اقف علي اسم ابي امية هذا ابو امية الكندي شريح بن الحارث الكندي قاضي الكوفة تقدم القسم الرابع ابي اللحم الغفاري ذكره بن عبد البر في الكني في حرف الهمزة قبل ترجمة ابي الاعور وبعد ترجمة ابي احمد بن جحش وقال ما نصه تقدم ذكره في العبادلة وليست هذه بكنية له ولكنها صارت له كالكنية وقيل انما قيل له ذلك لانه كان لا ياكل اللحم ورايت حاشية علي الاستيعاب بخط بن دحية فيما اظن ما نصه يا ليت شعري اذا علم انها ليست كنية فلم ادخله في الكني ولم قال انها صارت له كالكنية ولم يقل انها صارت له كاللقب اللهم الا ان يظن ان من راي الالف والياء والباء يظن انها كنية فيشتبه عنده بالكنية في حالة الخفض فناهيك جهلا ترتفع عنه رتبة البادي في العلم فضلا عن هذا الشيخ انتهي وقد سبق ابا عمر الي جعلها كنية الترمذي في الجزء الصغير الذي له في الصحابة فقال في الكني منه ابو اللحم له صحبة وكذا صنع الحافظ ابو احمد الحاكم في الكني في الافراد من حرف الهمزة ووقع لابن منده فيه وهم اخر وكل ذلك خطا وجعله في حرف الهمزة علي تقدير ان يكون كنية خطا اخر وانما حقه ان يكون في اللام لان الالف والباء ان كانت اداة الكنية فالاعتبار في ترتيب الحروف بما بعدها وقد مشي علي ذلك الدولابي وابن السكن وابن منده فذكروه في حرف اللام من الكني وانكر ذلك ابو نعيم علي بن منده فاصاب ابو الاسود التميمي استدركه ابو موسي وعزاه لجعفر المستغفري فاخرج من طريق عبد الرزاق عن معمر حدثني شيخ من تميم عن شيخ منهم يقال له ابو الاسود انه سمع النبي صلي الله عليه وسلم يقول اليمين الفاجرة تعقر الرحم ولا اعلمه الا قال تدع الديار بلاقع وهذا وقع فيه تصحيف والصواب ابو سود بضم المهملة وسكون الواو وليس في اوله الف كذا اخرجه احمد من طريق بن المبارك عن معمر وسياتي ابو الاسود الدوسي قال كنا مع النبي صلي الله عليه وسلم كذا قال يزيد بن هارون ووهم فيه يحيي بن معين وقال الصواب عن ابي اسحاق عن ابي هريرة ذكره بن فتحون قلت والحديث المذكور من طريق يزيد بن ابي حبيب عن بكير بن الاشج عن سليمان بن يسار عن ابي اسحاق عن ابي هريرة كذا رواه يعقوب بن ابراهيم بن سعد عن ابيه عن بن اسحاق عن يزيد بن ابي حبيب وكذا قال غيره عن بن اسحاق ابو الاسود الديلي ذكره بن شاهين في الصحابة واورد من طريق عبد الله بن عثمان بن خثيم عن محمد بن خلف بن الاسود ان ابا الاسود اخبره انه اتي النبي صلي الله عليه وسلم مع الناس يوم الفتح الحديث وهو وهم نشا عن سقط والصواب ان اباه الاسود حدثه وهو الاسود بن خلف §  <> وقد تقدم الحديث في ترجمته في الهمزة من الاسماء ابو الاسود عبد الرحمن بن يعمر الدءلي تقدم في الاسماء وحديثه الحج عرفة اورده بن شاهين في ترجمة ظالم ابي الاسود وهو خطا نشا عن سوء فهم وهذه الكنية والنسبة مشتركة بين عبد الرحمن وظالم والصحبة والحديث لعبد الرحمن لا لظالم وقد تقدم ذكر ظالم في القسم الثالث ابو الاسود السلمي روي حديثا عن النبي صلي الله عليه وسلم في التعوذ من الهدم والتردي قال المزي في التهذيب كذا وقع في رواية بن السكن عن النساءي وهو وهم والصواب عن ابي اليسر بفتح الياء المنقوطة باثنتين من تحت والسين المهملة بعدها كذا اخرجه الحاكم من الوجه الذي اخرجه النساءي وهو الصواب ابو امامة له ذكر في ترجمة عبد الله بن اسعد بن زرارة ولم يصب من زعم انه غير اسعد بن زرارة ابو امية التغلبي ترجم له احمد في مسنده واستدركه ابو موسي ووقع لي حديثه بعلو في جزء هلال الحفار قال حدثنا محمد بن السدي حدثنا جرير عن عطاء بن الساءب عن جندب بن هلال عن ابي امية رجل من بني تغلب انه سمع رسول الله صلي الله عليه وسلم يقول ليس علي المسلمين عشور انما العشور علي اليهود والنصاري قال ابو موسي كذا وقع في هذه الرواية جندب بن هلال ورواه شريح بن يونس عن جرير فقال عن حرب بن عبيد الله عن ابيه عن جده ابي امية ولم يسمه واخرجه ابو داود فقال عن حرب عن جده ابي امه عن ابيه نحوه وجرير وابو الاحوص حملا عن عطاء بعد اختلاطه ورواه الثوري وهو قديم السماع من عطاء عن رجل من بكر بن واءل عن خاله قال قلت يا رسول الله وقال وكيع عن سفيان بهذا السند مرسلا ان اباه اخبره انه وفد علي النبي صلي الله عليه وسلم اخرجه ابو داود واخرج ايضا من طريق وكيع عن الثوري عن عطاء عن حرب مرسلا ومن طريق ابي حمزة اليشكري عن عطاء بن الساءب عن حرب بن عبيد الله الثقفي ان اباه اخبره انه وفد علي النبي صلي الله عليه وسلم وهذا اختلاف شديد ويتحصل منه ان رواية جرير غلط وانه من قوله عن جده ابي امه الي ابي امية والصواب الاول ابو انس الانصاري ذكره الدولابي في الكني في فضل الصحابة رضي الله عنهم ولم يذكر له حديثا واخرج له بن مندة من طريق ابراهيم بن ابي يحيي عن مالك بن حمزة بن ابي انس عن ابيه عن جده قال وهو خطا والصواب عن ابراهيم عن مالك بن حمزة بن ابي اسيد عن ابيه عن جده وقد اخرجه البخاري بمعناه من رواية حمزة بن ابي اسيد وكذا اخرج ابو داود من طريق حمزة بن ابي اسيد عن ابيه عن جده حديثا غير هذا ابو اوس تميم بن حجر كذا قاله البغوي وقال غيره ابو تميم اوس بن حجر وهو الصواب ابو ايوب غير منسوب استدركه ابو موسي وعزاه لابي بكر بن ابي علي واخرج من §  <> طريق عبد الرحمن بن ابي زياد الافريقي عن ابيه عن ابي ايوب سمعت رسول الله صلي الله عليه وسلم يقول ان للمسلم علي المسلم ست خصال من المعروف فذكر الحديث قلت اورده اسحاق بن راهويه في مسند ابي ايوب الانصاري وكذا اخرجه البخاري في الادب المفرد من طريق الافريقي عن ابيه عن ابي ايوب الانصاري وفي الحديث قصة للراوي كانت سببا لرواية ابي ايوب الحديث المذكور ابو ايوب الازدي قال الحاكم في المستدرك صحابي من الزهاد ثم ساق من طريق ابي اسحاق الفزاري عن ابراهيم بن كثير عن عمارة بن غزية قال دخل ابو ايوب الازدي علي معاوية فراي منه جفوة فقال ان النبي صلي الله عليه وسلم اخبرنا بانه سنري اثرة بعده قال فما امركم قال اصبروا قال فاصبروا قال الحاكم هذا مرسل لان عمارة لم يدرك ابا ايوب وقد جاء هذا الحديث من وجه اخر عن ابي ايوب الانصاري قلت لعل بعض الرواة نسب ابا ايوب الانصاري ازديا لان الانصار من الازد وفي التابعين ابو ايوب الازدي اخر يقال له المراغي يروي عن عبد الله بن عمرو بن العاص وغيره وقد جاءت عنه رواية مرسلة والله اعلم حرف الباء الموحدة القسم الاول ابو بجير غير منسوب ذكره بن مندة واخرج من طريق عثمان بن عبد الرحمن عن عبد الله بن بجير عن ابيه عن جده عن النبي صلي الله عليه وسلم قال القران كلام ربي الحديث وسنده ضعيف ابو البجير استدركه بن الامين وعزاه لابن الفرضي في المءتلف ولعله بن البجير الاتي في المبهمات ابو بجيلة ذكره الذهبي في التجريد وعزاه لبقي بن مخلد وانا اخشي ان يكون بالنون والمعجمة وسياتي ابو بحر ذكره الدولابي في الكني واخرج من طريق عبد الله بن عمرو بن علقمة عن ابي بحر البكراوي قال قال رسول الله صلي الله عليه وسلم من حسن الله وجهه وحسن موضعه ولم يشنه والده كان من خالصة الله يوم القيامة قلت واخشي ان يكون هذا الحديث مرسلا ابو بحينة ذكره الذهبي في التجريد وعزاه لبقي بن مخلد وانا اظن انه بن بحينة وهو عبد الله المتقدم ابو البداح بن عاصم الانصاري ذكر اسماعيل بن اسحاق القاضي في احكام القران §  <> انه زوج اخت معقل بن يسار التي نزل بسببها فلا تعضلوهن وساق من طريق بن جريج اخبرني عبد الله بن معقل ان جمل بنت يسار اخت معقل بن يسار كانت تحت ابي البداح بن عاصم فطلقها فانقضت عدتها فخطبها وهذا سند صحيح وان كان ظاهره الارسال فان ثبت فهو غير ابي البداح بن عاصم بن عدي الاتي في القسم الرابع ابو البراد غلام تميم الداري ذكره المستغفري في الصحابة واخرج من طريق محمد بن الحسن بن قتيبة عن سعيد بن زياد بفتح الزاي وتشديد التحتانية بن فاءد بالفاء عن ابيه عن جده عن ابي هند قال حمل تميم الداري معه من الشام الي المدينة قناديل وزيتا ومقطا فلما انتهي الي المدينة وافق ذلك يوم الجمعة فامر غلاما له يقال له ابو البراد فقام فشد المقط وهو بضم الميم وسكون القاف وهو الحبل وعلق القناديل وصب فيها الماء والزيت وجعل فيها الفتل فلما غربت الشمس اسرجها فخرج رسول الله صلي الله عليه وسلم الي المسجد فاذا هو يزهر فقال من فعل هذا قالوا تميم يا رسول الله قال نورت الاسلام نور الله عليك في الدنيا والاخرة اما انه لو كانت لي ابنة لزوجتكها فقال نوفل بن الحارث بن عبد المطلب لي ابنة يا رسول الله تسمي ام المغيرة بنت نوفل فافعل فيها ما اردت فانكحه اياها علي المكان وسنده ضعيف ابو بردة بن سعد بن حزابة بن جعيد بن وهيب بن عمرو بن عاءذ بن عمر بن مخزوم ذكره الزبير بن بكار وذكر ان ابنه عبد الرحمن قتل يوم الجمل وكان مع عاءشة رضي الله عنها ابو بردة بن قيس الاشعري اخو ابو موسي مشهور بكنيته كاخيه قال البغوي سكن الكوفة وروي حديثه احمد والحاكم من طريق عاصم الاحول عن كريب بن الحارث بن ابي موسي عن عمه ابي بردة قال قال رسول الله صلي الله عليه وسلم اللهم اجعل فناء امتي قتلا في سبيلك بالطعن والطاعون وله ذكر في حديث اخر من طريق يزيد بن عبد الله بن ابي بردة بن ابي موسي عن جده عن ابي موسي قال خرجنا من اليمن في بضع وخمسين رجلا من قومنا ونحن ثلاثة اخوة ابو موسي وابو بردة وابو رهم فاخرجتنا سفينتنا الي النجاشي واخرجه البغوي من هذا الوجه ثم اخرجه من وجه اخر عن كريب بن الحارث عن ابي بردة بن قيس قال قلت لابي موسي في طاعون وقع اخرج بنا الي دابق مال فقال الي الله تبارك وتعالي ابق لا الي دابق ابو بردة بن نيار الانصاري خال البراء بن عازب اسمه هانء تقدم في حرف الهاء وقيل اسمه مالك بن هبيرة وقيل الحارث بن عمرو كذا ذكر المزي عن بن معين وخطاه بن عبد الهادي فقال انما قاله بن معين في بن ابي موسي قلت قد وقع في حديث البراء لقيت خالي الحارث بن عمرو وقد وصف ابو بردة بن نيار بانه خال البراء فهذا شبهة من قال اسمه الحارث ولعله خال اخر للبراء والله اعلم والاول اصح وقيل انه عم البراء والاول اشهر وشهد ابو بردة بدرا وما بعدها وروي عن النبي صلي الله عليه وسلم روي عنه البراء بن عازب وجابر بن عبد الله وابنه عبد الرحمن بن §  <> جابر وكعب بن عمير بن عقبة بن نيار ونصر بن يسار وكان سبب من سماه الحارث بن عمرو قول البراء لقيت خالي الحارث بن عمرو ولكن يحتمل ان يكون له خال اخر وهو الاشبه ونقل المزي عن عباس الدوري عن بن معين انه حكي ان اسم ابي بردة بن نيار الحارث وتعقب بان بن معين انما قال ذلك في ابي بردة بن ابي موسي قال ابو عمر مات في اول خلافة معاوية بعد ان شهد مع علي رضي الله عنه حروبه كلها ثم قيل انه مات سنة احدي وقيل اثنتين وقيل خمس واربعين ابو بردة خال جميع بن عمير روي شريك عن واءل بن داود عن جميع عن خاله ابي بردة قال قال رسول الله صلي الله عليه وسلم افضل كسب الرجل ولده وكل بيع مبرور اخرجه البغوي عن يحيي الحماني عن شريك وتابعه غير واحد عن شريك وقال الثوري عن واءل عن سعيد بن عمير عن عمه اخرجه بن منده قلت سعيد بن عمير هو بن عتبة بن نيار فعمه هو ابو بردة بن نيار بخلاف جميع فما ادري اهو واحد اختلف في اسمه او هما اثنان ابو بردة الاسلمي ذكره الثعلبي في التفسير قال دعاه النبي صلي الله عليه وسلم الي الاسلام فابي ثم كلمه ابناه في ذلك فاجاب اليه واسلم وعند الطبراني بسند جيد عن بن عباس قال كان ابو بردة الاسلمي كاهنا يقضي بين اليهود فذكر القصة في نزول قوله تعالي الم تر الي الذين يزعمون انهم امنوا بما انزل اليك وما انزل من قبلك يريدون ان يتحاكموا الي الطاغوت الاية ابو بردة الظفري الانصاري الاوسي ذكره بن سعد فيمن نزل مصر وقال ابو نعيم يعد في الكوفيين وعند احمد والبغوي من طريق عبد الله بن معتب بن ابي بردة الظفري عن ابيه عن جده سمعت رسول الله صلي الله عليه وسلم يقول يخرج من الكاهنين رجل يدرس القران دراسة لا يدرسها احد بعده اخرجه احمد وابن ابي خيثمة وغيرهما من طريق بن وهب عن عمرو بن الحارث عن ابي صخر واخرجه بن منده من طريق نافع بن يزيد عن ابي صخر تنبيه عبد الله بن معتب بضم الميم وفتح المهملة وتشديد المثناة المكسورة ثم موحدة للاكثر وذكره ابو عمر بكسر المعجمة وسكون التحتية ثم مثلثة وقال بن فتحون رايته في اصل بن مفرح من كتاب البزار ومعتب مثله لكن بمهملة وموحدة واتفق البزار وابن السكن والباوردي وغيرهم انه عبد الله مكبرا ووقع عند ابي عمر عبيد الله مصغرا ابو برزة الاسلمي مشهور واسمه نضلة بن عبيد علي الصحيح وقيل بن عبد الله وقيل بن عاءذ وقيل عبد الله بن نضلة نقله الواقدي عن اصله وقيل بالتصغير وقال الهيثم بن عدي خالد بن نضلة تقدم في النون ابو برقان السعدي عم النبي صلي الله عليه وسلم من الرضاعة قال ابو موسي ذكره المستغفري ونقل عن محمد بن معن عن عيسي بن يزيد قال دخل ابو برقان عم النبي صلي الله عليه وسلم من بني سعد بن بكر قال يا محمد لقد جءت وما فتي من قومك احب اليهم ولا احسن ثناء منك وانهم يتقممون فقال يا ابا برقان هل تعرف الحيرة قلت نعم قال فان طالت بك حياة لتسمعنها يرد الوارد من غير خفير قال لا ادري ما تقول غير اني ما اتيتك من ثنية كذا الا بخفير فقال رسول الله صلي §  <> الله عليه وسلم لاخذن بيدك يوم القيامة ولاذكرنك ذاك قال فكان عثمان بن عفان يقول يا ابا برقان ما كان لياخذك الا وانت رجل صالح قال ابو برقان قدمت الحيرة فوجدتها علي ما وصفت لي قلت عيسي بن يزيد هو المعروف بابن داب الاخباري وقد كذبوه وقد صحفت هذه الكنية كما سياتي في الثاء المثلثة ابو بريدة عمرو بن سلمة الجرمي تقدم في الاسماء ابو بزة المكي المخزومي مولاهم ذكره بن قانع ونقل عن البخاري ان اسمه يسار وقال بن قانع وابو الشيخ جميعا حدثنا ابو خبيب بمعجمة وموحدتين مصغرا البرتي بكسر الموحدة وسكون الراء بعدها مثناة حدثنا احمد بن ابي بزة وهو بن محمد بن القاسم بن ابي بزة حدثني ابي عن جدي عن ابي بزة قال دخلت مع مولاي عبد الله بن الساءب علي النبي صلي الله عليه وسلم فقبلت يده وراسه ورجله واخرجه ابو بكر بن المقري في جزء الرخصة في تقبيل اليد عن ابي الشيخ واستدركه ابو موسي ابو بشار او يسار بالمهملة ياتي في حرف الياء الاخيرة من الكني ابو البشر بفتحتين بن الحارث العبدري من بني عبد الدار قال محمد بن وضاح هو الشاب الذي خطب سبيعة الاسلمية لما وضعت حملها فحطت اليه فدخل عليها ابو السنابل فقال لست بناكح حتي تمضي اربعة اشهر وعشرا واستدركه بن الدباغ وابن فتحون ابو بشر الانصاري ذكره بن ابي خيثمة واخرج من طريق مخرمة بن بكير عن ابيه عن سعيد بن نافع قال راني ابو البشر الانصاري صاحب رسول الله صلي الله عليه وسلم وانا اصلي حين طلعت الشمس فعاب علي ذلك وقال قال رسول الله صلي الله عليه وسلم لا تصلوا حتي ترتفع فانها انما تطلع بين قرني شيطان وغاير بن ابي خيثمة بينه وبين ابي بشر الانصاري الاتي المخرج حديثه في الصحيحين فهذا اوله كسرة ثم سكون والاتي فتحة ثم كسرة ووحد بينهما بن عبد البر وقال هو الذي روي عمارة بن غزية عنه حديث ان رسول الله صلي الله عليه وسلم حرم ما بين لابتيها قال ومن حديثه الحمي من فيح جهنم والراجح التفرقة ابو بشر الخثعمي له في مسند بقي بن مخلد حديث ابو بشر البراء بن معرور سيد الانصار تقدم في الاسماء ابو بشر السلمي استدركه ابو موسي في الذيل وقال ذكره ابو بكر بن علي وغيره في الصحابة واخرجوا من طريق هشام بن سعد عن زيد بن اسلم عن ابي بشر السلمي وكان من اصحاب النبي صلي الله عليه وسلم قال قال رسول الله صلي الله عليه وسلم من احب ان يفرج الله كربته ويعطيه سءله فلينظر معسرا او ليذر له قال ابو موسي لعله ابو اليسر بفتح التحتانية والمهملة واسمه كعب بن عمرو لان هذا المتن مشهور عنه قلت لكن مخرج الحديثين مختلف واذا تعددت المخارج كان قرينة علي تعدد الراوي بخلاف ما اذا اتحدت ولا مانع ان يروي الحكم عن صحابيين وقرينة اختلاف السياقين ايضا ترشد الي التعدد والله اعلم §  <> ابو بشير الانصاري الساعدي ويقال المازني ويقال الحارثي مخرج حديثه في الصحيحين من طريق عباد بن تميم عنه ومتن الحديث لا تبقين في رقبة بغير قلادة وروي عنه ايضا ضمرة بن سعيد وسعيد بن نافع ذكره ابو احمد الحاكم فيمن لا يعرف اسمه وقيل اسمه قيس بن عبيد بن الحرير بمهملتين مصغر ضبطه الطبري وغيره ووقع عند ابي عمر الحارث وهو عبيد بن الحارث بن عمرو بن الجعد قاله محمد بن سعد ونقل عن الواقدي انه شهد احدا وهو غلام واورده بن سعد في طبقة من شهد الخندق وقد ذكره البغوي فقال ابو بشير الانصاري سكن المدينة وساق حديثه من هذا الوجه قال خليفة مات ابو بشير بعد الحرة وكان عمر طويلا وقيل مات سنة اربعين وهو ساعدي ويقال مازني ويقال حارثي وروي عنه ايضا ضمرة بن سعيد وسعيد بن نافع ويقال ان شيخ هذا الاخير اخر يكني ابا بشر بكسر الموحدة وسكون المعجمة قاله بن ابي خيثمة ابو بشير الانصاري اخر هو الحارث بن خزمة تقدم في الاسماء ابو بشير غير منسوب اخر استدركه بن فتحون وعزاه للطبري وساق روايته من طريق شعبة عن حبيب مولي الانصار سمعت بن ابي بشر وابن ابي بشير يحدثان عن ابيهما ان رسول الله صلي الله عليه وسلم قال الحمي من فيح جهنم فابردوها بالماء قلت وقد تقدم ان ابا عمر جزم بان هذا هو الذي قبله فلا يستدرك عليه مع احتمال الغيرية وذكره البغوي في ترجمة ابي جندل بن سهيل ابو البشير الانصاري يقال انه كنية كعب بن مالك ذكره بن ماكولا ابو البشير كالذي قبله بزيادة الالف واللام اوله من موالي رسول الله صلي الله عليه وسلم اخرجه ابو موسي وعزاه لجعفر المستغفري ابو البشير المعاوي ذكره البزار واستدركه بن الامين ابو بصرة الغفاري بن بصرة بن ابي بصرة بن وقاص بن حبيب بن غفار وقيل بن حاجب بن غفار روي عن النبي صلي الله عليه وسلم روي عنه ابو هريرة وابو تميم الجيشاني وعبد الله بن هبيرة وعبيد بن جبر وابو الخير اليزني وغيرهم واخرج حديثه مسلم والنساءي من طريق بن اسحاق حدثني يزيد بن ابي حبيب عن جبر بن نعيم عن عبد الله بن هبيرة عن ابي تميم الجيشاني عن ابي بصرة الغفاري قال صلي بنا رسول الله صلي الله عليه وسلم صلاة العصر الحديث وفيه ولا صلاة بعد حتي يري الشاهد والشاهد النجم واخرج النساءي من طريق كليب بن ذهل عن عبيد بن جبر قال كنت مع ابي بصرة صاحب النبي صلي الله عليه وسلم في سفر رمضان فذكر الفطر في السفر قال بن يونس شهد فتح مصر واختط بها ومات بها ودفن في مقبرتها وقال ابو عمر كان يسكن الحجاز ثم تحول الي مصر ويقال ان عزة صاحبة كثير من ذريته والي ذلك اشار كثير بقوله في شعره الحاحبية وانكر ذلك بن الاثير فقال ليس في نسب عزة لابي بصرة ذكر ابو بصرة الغفاري جد الذي قبله تقدم في ترجمة حفيده ان له ولابيه وجده صحبة §  <> ابو بصير بن اسيد بن جارية الثقفي اسمه عتبة تقدم وقيل ان اسمه عبيد حكاه بن عبد البر والاول هو المشهور ابو بصير اخر ياتي في الغين المعجمة في ترجمة ابي غسل ابو بصيرة قال ابو عمر ذكره سيف بن عمر فيمن شهد اليمامة من الانصار ابو بكر الصديق بن ابي قحافة اسمه عبد الله وقيل عتيق بن عثمان تقدم ابو بكر بن شعوب الليثي اسمه شداد وقيل الاسود وقيل هو شداد بن الاسود واما شعوب فهي امه باتفاق وهو الذي يقول فيه ابو سفيان بن حرب لما دافع عنه يوم احد ولو شءت نجتني كميت طمرة ولم احمل النعماء لابن شعوب وله اخ اسمه جعونة تقدم في الجيم وحكي الجرمي في النوادر المجموعة ومن خطه نقلت بسند صحيح عن ابي عبيدة فيمن كان ينسب الي امه ابو بكر بن شعوب نسب الي امه وابوه هو من بني ليث بن بكر بن كنانة وهو الذي يقول فذكر الابيات في رثاء قتلي بدر من المشركين قال ثم اسلم بن شعوب بعد وقال المرزباني امه شعوب خزاعية وقال غيره كنانية ووقع في البخاري انها كلبية فاخرج من طريق يونس عن الزهري عن عروة عن عاءشة رضي الله عنها ان ابا بكر تزوج امراة من كلب يقال لها ام بكر فلما هاجر ابو بكر طلقها فتزوجها بن عمها هذا الشاعر الذي قال هذه القصيدة يرثي كفار قريش وماذا بالقليب قليب بدر الابيات وقد اخرجه الاسماعيلي من طريق احمد بن صالح عن وهب عن بن يونس فلم يقل من كلب بل زاد فيه ان عاءشة رضي الله عنها كانت تقول ما قال ابو بكر شعرا في جاهلية ولا اسلام واخرجه الحكيم الترمذي في نوادر الاصول من طريق الزبيدي عن الزهري عن عروة عن عاءشة رضي الله عنها انها كانت تدعو علي من يقول ان ابا بكر الصديق رضي الله عنه قال هذه القصيدة ثم تقول والله ما قال ابو بكر بيت شعر في الجاهلية ولا في الاسلام ولكن تزوج امراة من بني كنانة ثم بني عوف فلما هاجر طلقها فتزوجها بن عمها هذا الشاعر فقال هذه القصيدة يرثي كفار قريش الذين قتلوا ببدر فتحامي الناس ابا بكر من اجل المراة التي طلقها وانما هو ابو بكر بن شعوب قلت وكانت عاءشة اشارت الي الحديث الذي اخرجه الفاكهي في كتاب مكة عن يحيي بن جعفر عن علي بن عاصم عن عوف بن ابي جميلة عن ابي القموص قال شرب ابو بكر الخمر في الجاهلية فانشا يقول فذكر الابيات فبلغ ذلك رسول الله صلي الله عليه وسلم فقام يجر ازاره حتي دخل فتلقاه عمر وكان مع ابي بكر فلما نظر الي وجهه محمرا قال نعوذ بالله من غضب رسول الله صلي الله عليه وسلم والله لا يلج لنا راسا ابدا فكان اول من حرمها علي نفسه واعتمد نفطويه علي هذه الرواية فقال شرب ابو بكر الخمر قبل ان تحرم ورثي قتلي بدر من المشركين واما ما اخرج البزار عن ابي كريب وجنادة عن يونس بن بكير عن مطر بن ميمون حدثنا انس بن مالك قال كنت ساقي القوم وفيهم رجل يقال له ابو بكر من بني كنانة فلما شرب قال §  <> تحيي ام بكر بالسلام وهل لي بعد قومك من سلام يحدثنا الرسول بان سنحيي وكيف حياة اصداء وهام قال فنزل تحريم الخمر فذكر الحديث وفيه كسر الانية واهراق ما فيها قال بن فتحون وهذا البيت لابي بكر شداد بن الاسود بن شعوب من جملة قصيدة رثي بها اهل بدر فلعل ابا بكر الكناني تمثل بها في حال شربه قلت خفي علي بن فتحون ان ابا بكر بن شعوب هو ابو بكر الكناني وظن ان الكناني مسلم وان بن شعوب لم يسلم فلذلك استدركه وقد ذكر بن هشام في زيادات السيرة ان بن شعوب المذكور كان اسلم ثم ارتد والله اعلم ابو بكرة الثقفي نفيع بن الحارث تقدم ابو البنات بموحدة ثم نون خفيفة ياتي في ابي سفيان ابو بهيسة بالتصغير الفزاري ذكره ابو بشر الدولابي في الكني واورد له من طريق كهمس عن يسار بن منظور عن ابي بهيسة انه استاذن النبي صلي الله عليه وسلم فادخل يده في قميصه فمس الخاتم هكذا اورده وهو عند ابي داود والنساءي من هذا الوجه لكن قال عن بهيسة عن ابيها انه استاذن واخرجه بن منده لكن قال عن يسار عن ابيه عن بهيسة قالت استاذن ابي النبي صلي الله عليه وسلم يدخل يده بينه وبين ثيابه الحديث وذكر ان عبد البر ان اسم والد بهيسة عمير وقد تقدم في العين ابو بهية بفتح اوله البكري اسمه عبد الله بن حرب تقدم القسم الثاني لم يذكر فيه احد من الرجال القسم الثالث ابو بحرية بفتح اوله وسكون المهملة وكسر الراء وتشديد التحتانية التراغمي مشهور بكنيته واسمه عبد الله بن قيس تقدم في الاسماء ومما يءيد ادراكه الجاهلية ما اخرجه بن المبارك في كتاب الجهاد من طريق ابي بكر بن عبد الله بن حويطب عن ابي بحرية قال اما اني في اول جيش او سرية دخلت ارض الروم وغلبنا بن عمك عبد الله بن السعدي وفي زمن عمر قال قدامنا ثقالنا ويءخذ منه ان ذلك كان سنة ثلاث عشرة من الهجرة ابو بسرة الجهني قال شهدت عمر بالجابية اتي برجل شرب الطلاء فسكر فجلده الحد ذكره بن عساكر ابو بصيرة اليشكري له ادراك ذكر ابو الفرج الاصبهاني ان مسيلمة الكذاب اتي بابي بصيرة اليشكري فمسح وجهه فعمي وعاش ابو بصيرة المذكور الي امارة خالد القشيري علي العراق §  <> ابو بكر العنسي قال دخلت حير الصدقة مع عمر روي عنه عمر بن نافع النعيمي القسم الرابع ابو بجيلة وابو البجير وابو بحينة تقدموا في الاول وحقهم ان يذكروا في المبهمات ابو البداح بن عاصم بن عدي بن الجد بن العجلان البلوي حليف الانصار قال ابو عمر اختلف فيه فقيل الصحبة لابيه وهو من التابعين وقيل له صحبة وهو الذي توفي عن سبعية الاسلمية وخطبها ابو السنابل بن بعكك ذكره بن جريج وغيره وهو الصحيح في ان له صحبة والاكثر يذكرونه في الصحابة انتهي وعليه مءاخذات الاولي ان مالكا اخرج في الموطا عن عبد الله بن ابي بكر بن محمد بن عمرو بن جزم عن ابيه عن ابي البداح حديثا وهذا يدل علي تاخر ابي البداح عن عهد النبي صلي الله عليه وسلم لان ابا بكر بن محمد بن عمرو بن حزم لم يدرك العصر النبوي وقد روي ايضا عن ابي البداح ابو بكر بن عبد الرحمن بن الحارث بن هشام وابنه عبد الملك وغير واحد وارخ جماعة وفاته سنة سبع عشرة وماءة وقال الواقدي مات سنة عشر وماءة وله اربع وثمانون سنة فعلي هذا يكون مولده سنة ست وعشرين بعد النبي صلي الله عليه وسلم بخمس عشرة سنة وهذا كله يدفع ان يكون له صحبة ويدفع قول بن منده ادرك النبي صلي الله عليه وسلم وقد روي بن عاصم هذا عن ابيه وحديثه عنه في السنن روي عنه ابنه عاصم وغيره وقال بن سعد عن الواقدي ابو البداح لقب وكنيته ابو عمرو قال وكان ثقة قليل الحديث قال بن فتحون قول ابي عمر توفي عن سبيعة وهم انما كان ابو البداح زوجا لجمل بنت يسار اخت معقل بن يسار قلت فذكر القصة المتقدمة لابي البداح في القسم الاول وهو غير هذا قطعا فالتبس عليه كما التبس علي غيره والذي يظهر من قول من ذكر ان له صحبة ينطبق علي ابي البداح الذي قيل له انه كان زوج اخت معقل بن يسار فلعله الذي قيل له انه مات في العصر النبوي وخلف زوجته حاملا لكن المعروف ان اسم زوج سبيعة انما هو سعد بن خولة وهو الذي ثبت في الصحيح انه كان زوج سبيعة فتوفي عنها وهي حامل والله سبحانه وتعالي اعلم ابو بردة الانصاري روي عن النبي صلي الله عليه وسلم في التعزير روي عنه جابر بن عبد الله اخرج حديثه النساءي قاله ابو عمر مغايرا بينه وبين ابي بردة بن نيار خال البراء بن عازب وجزم بانه خال البراء وقال بن ابي خيثمة في الذي روي عنه جابر لا ادري هو الظفري او غيره وسبب ذلك انه وقع في روايته عن ابي بردة الظفري قال ابو عمر هو غير الذي روي عنه جابر هو ابو بردة بن نيار ابو بردة اخر غاير من جمع مسند الطيالسي بينه وبين ابي بردة بن نيار قال ابو داود الطيالسي حدثنا سلام بن سليم هو ابو الاحوص عن سماك بن حرب عن القاسم بن عبد الرحمن عن ابيه عن ابي بردة وليس بابن ابي موسي ان النبي صلي الله عليه وسلم قال اشربوا في الظروف ولا §  <> تشربوا مسكرا واخرجه النساءي عن هناد بن السري عن ابي الاحوص فقال في روايته عن ابي بردة بن نيار وقال النساءي بعده غلط فيه ابو الاحوص لا نعلم احدا من اصحاب سماك تابعه عليه انتهي وقد اخرجه الدارقطني من رواية يحيي بن يحيي عن محمد بن جابر عن سماك لكن قال عن القاسم عن ابي بردة عن ابيه قال الدارقطني وهم ابو الاحوص في اسناده ومتنه ورواية محمد بن جابر هذه هي الصواب قلت فعلي هذا وقع لابي الاحوص فيه تصحيف ابو بكر بن حفص ذكره ابو مسعود سليمان بن ابراهيم الاصبهاني في الصحابة واورد له من طريق حماد بن سلمة عن علي كانه بن زيد بن جدعان عن ابي العالية عن ابي بكر بن حفص ان رسول الله صلي الله عليه وسلم دخل علي عبد الله بن رواحة يعوده الحديث في ذكر الشهداء قال ابو موسي ورواه شعبة عن ابي بكر بن حفص عن ابي مصبح عن عبادة بن الصامت قلت وابو بكر بن حفص المذكور هو بن حفص بن عمر بن سعد بن ابي وقاص قتل المختار حفصا واباه وابو بكر بن حفص من وسط التابعين ابو بلال بن سعد استدركه بن فتحون وعزاه للطبراني وليست هذه كنيته وانما المراد والد بلال بن سعد فالمترجم له سعد وهو والد بلال وسعد هو بن تميم السكوني كما تقدم في الاسماء وبلال تابعي مشهور والله اعلم حرف التاء المثناة القسم الاول ابو تجراة بكسر المثناة وسكون الجيم مولي شيبة بن عثمان الحجبي بالحلف لابنته برة صحبة وكذا لبنته حبيبة ذكر الزبير ما يدل علي انه من اهل هذا القسم فاخرج من طريق عبد الرحمن بن عبد العزيز قال خرج شيبة بن عثمان الي معاوية ومعه حليفه ابو تجراة في امرة سعد بن طلحة بن ابي طلحة فقال شيبة يروح ابا تجراة من بل اهله بمكة يظعن وهو للظل الف ويصب عن حر هواجر والسري ويبدي القناع وهو اشعث صاءف وقال شيبة ايضا وهاجرة قنعت راسي نحوها اخاف علي سعد هوان المضاجع قلت وفي بقاء ابي تجراة الي خلافة معاوية دلالة علي انه من اهل هذا القسم لانه لم يبق بمكة في حجة الوداع من اهلها الا من شهدها وهذا كان من اهلها وذكره عمر بن شبة في حلفاء بني نوفل قال §  <> وهو اخو ابي فكيهة بن يسار ابو تحيي بكسر المثناة وسكون المهملة وفتح التحتانية الاولي شيخ من الانصار ثبت ذكره في حديث صحيح اخرجه ابو يعلي وابن خزيمة وغيرهما من طريق الاسود بن قيس عن ثعلبة بن عباد عن سمرة بن جندب قال بينا انا غلام من الانصار نرمي غرضا لنا علي عهد رسول الله صلي الله عليه وسلم اذ طلعت الشمس فكانت في عين الناظر قدر رمح او رمحين من الافق اسودت حتي اضت كانها تنومة الحديث وفيه خطبة النبي صلي الله عليه وسلم في الكسوف وفيها ذكر الدجال وانه ممسوح العين اليسري كانها عين ابي تحيي شيخ بينه وبين حجرة عاءشة والحديث في السنن الاربعة مختصر ابو تميم روي حديثه حفيده عمرو بن تميم بن ابي تميم عن ابيه عن جده عن النبي صلي الله عليه وسلم قال كل ما اصميت ودع ما انميت ابو تميمة غير منسوب ذكره بن منده فقال سمع النبي صلي الله عليه وسلم روي عنه الحسن وابو السليل واخرج ابو نعيم من طريق اسحاق بن نجيح عن عطاء الخراساني عن الحسن سمعت ابا تميمة وكان ممن ادرك النبي صلي الله عليه وسلم قال سالت النبي صلي الله عليه وسلم عن ابواب القسط فقال انصاف الناس من نفسك وبذل السلام للعالم وذكر الله الحديث واسحاق واه واورده ابو نعيم في ترجمته من رواية ابي اسحاق عن ابي تميمة انه قال للنبي صلي الله عليه وسلم او قال له قاءل الام تدعو قال ادعو الي الله الذي اذا اصابك ضر فدعوته كشف عنك وهذا الحديث معروف لابي تميمة الهجيمي الاتي ذكره في القسم الرابع وقال بن عبد البر ابو تميمة ذكره العقيلي في الصحابة واخرج له من طريق ابي عبيد الله سمعت ابا تميمة يقول سمعت رسول الله صلي الله عليه وسلم يقول لا تزال امتي علي الفطرة ما لم يتخذوا الامانة مغنما والزكاة مغرما والخلافة ملكا الحديث وقال هذا اسناد لا يصح القسم الثاني خال القسم الثالث ابو تميم الجيشاني اسمه عبد الله بن مالك تقدم وذكره ابو بشر الدولابي في باب الصحابة ومن له ادراك من كتاب الكني القسم الرابع ابو تمام الثقفي ذكره ابو موسي وهو خطا نشا عن تغيير وانما هو ابو عامر الثقفي §  <> كما سياتي في العين ابو تميمة الهجيمي تابعي معروف اسمه طريف بن مجالد وقد تقدم له ذكر في القسم الاول حرف الثاء المثلثة القسم الاول ابو ثابت سعد بن عبادة الانصاري الخزرجي سيد الخزرج تقدم ابو ثابت سهل بن حنيف الانصاري تقدم ابو ثابت اسيد بن ظهير الانصاري تقدم ابو ثابت بن عبد بن عمرو بن قيظي بن عمرو بن يزيد بن جشم الانصاري الحارثي قال ابو عمر شهد احدا ويقال انه جد عدي بن ثابت وليس بشء قلت قاءل ذلك هو الدولابي وقال الطبراني ابو ثابت الانصاري جد عدي بن ثابت ولم يذكره اباه ولا من فوقه ابو ثابت بن يعلي الثقفي ذكره الطبري في الصحابة واستدركه بن فتحون ابو ثابت القرشي جار الوحي ذكره بن منده واخرج حديثه البزار وغيره من طريق عبد الله بن رجاء الحمصي عن شرحبيل بن الحكم عن حكيم بن عمير ابي راشد الحبراني حدثني ابو ثابت شيخ من قريش كان يدعي جار الوحي بيته عند بيت النبي صلي الله عليه وسلم الذي كان يوحي اليه فيه قال صليت مع النبي صلي الله عليه وسلم صلاة العتمة فناداه جبريل كما حدثناه النبي صلي الله عليه وسلم فقال هلم فقال النبي صلي الله عليه وسلم ان شءت اتيتك وان شءت جءتني فقال جبريل انا اتيك فجاءه جبريل فانصدع له الجدار حتي دخل فاخذ بيده فانطلق به حتي حمله علي دابة كالبغلة الحديث في الاسراء الي بيت المقدس ورءية الانبياء وغير ذلك قال البزار بعد تخريجه وقال بن منده غريب تفرد به عبد الله بن رجاء الحمصي وقال ابو نعيم رواه ابو حاتم الرازي عن اسحاق يعني بن زريق عن عبد الله بن رجاء ابو ثروان السعدي تقدم في الموحدة ابو برقان فكان احدهما تصحيف من الاخر ابو ثروان بن عبد العزي السعدي عم النبي صلي الله عليه وسلم من الرضاعة ذكره بن سعد في الطبقات في ترجمة حليمة مرضعة النبي صلي الله عليه وسلم فقال حدثنا محمد بن عمر هو الواقدي عن معمر عن الزهري وعن عبد الله بن جعفر وابن ابي سبرة وغيرهم قالوا قدم وفد هوازن علي رسول الله صلي الله عليه وسلم الجعرانة بعد ما قسم الغناءم وفي الوفد عم النبي صلي الله عليه §  <> وسلم ابو ثروان فقال يا رسول الله انما في هذه الحظاءر من كان يكفيك من عماتك وخالاتك واخواتك وقد حضناك في حجورنا وارضعناك بثدينا وقد رايتك مرضعا فما رايت مرضعا خيرا منك ورايت فطيما فما رايت فطيما خيرا منك ثم رايتك شابا فما رايت شابا خيرا منك ولقد تكاملت فيك خصال الخير ونحن مع ذلك اهلك وعشيرتك فامنن علينا من الله عليك قال وقدم عليهم وفد هوازن باسلامهم فكان راس القوم والمتكلم ابا صرد زهير بن صرد فذكر قصته قلت تقدم ذكر هذا العم في حرف الباء الموحدة وان ابا موسي تبع المستغفري في انه ابو برقان بموحدة وقاف والذي ذكره الواقدي اولي وانه بمثلثة وراء وقد ذكره في موضع اخر فقال ان النبي صلي الله عليه وسلم سال الشيماء اخته من الرضاعة عمن بقي منهم فاخبرت ببقاء عمها واختها واخيها وقد مضي ان اخاها عبد الله بن الحارث واما اختها فاسمه انيسة وسياتي ذكرها في كتاب النساء ان شاء الله تعالي ابو ثروان الراعي التميمي ذكره الدولابي في الكني واخرج عن احمد بن داود المكي عن ابراهيم بن زكريا عن عبد الملك بن هارون بن عنترة حدثني ابي سمعت ابا ثروان يقول كنت ارعي لبني عمرو بن تميم في ابلهم فهرب النبي صلي الله عليه وسلم من قريش فجاء حتي دخل في ابلي فنفرت الابل فاذا هو جالس فقلت من انت فقد نفرت ابلي قال اردت ان استانس اليك والي ابلك فقلت من انت قال ما يضرك الا تسالني قلت اني اراك الذي خرجت نبيا قال ادعوك الي شهادة ان لا اله الا الله وان محمدا رسول الله قلت اخرج من ابلي فلا يبارك الله في ابل انت فيها فقال اللهم اطل شقاءه وبقاءه قال هارون فادركته شيخا كبيرا يتمني الموت فقال له القوم ما نراك يا ابا ثروان الا هالكا دعا عليك رسول الله صلي الله عليه وسلم فقال كلا اني اتيته بعدما ظهر الاسلام فاسلمت واستغفر لي ولكن دعوته الاولي سبقت وتابعه محمد بن سليمان الساعدي عن عبد الملك وعبد الملك متروك ابو ثرية بوزن عطية وقيل مصغر سبرة بن معبد الجهني تقدم ابو ثعلبة الاشجعي قال البخاري له صحبة ذكره عنه الحاكم ابو احمد وغيره وقال في ترجمة الراوي عنه لا اعرفه ولا اعرف ابا ثعلبة وقال البغوي سكن المدينة واخرج حديثه احمد والبغوي وابن منده من طريق بن جريج عن بن الزبير عن عمر بن نبهان عن ابي ثعلبة الاشجعي قال قلت يا رسول الله مات لي ولدان في الاسلام فقال من مات له ولدان في الاسلام دخل الجنة بفضل رحمته اياهما وزاد في رواية البغوي قال فلقيني ابو هريرة فقال انت الذي قال له رسول الله صلي الله عليه وسلم في الولدين ما قال قلت نعم قال لءن كان قاله لي احب الي من كذا قال بن منده مشهور عن بن جريج وقال ابو حاتم لا اعرفهما وقوله وذكر الدارقطني ان بعضهم رواه عن بن جريج فقال الخشني وان بعضهم قال عن ابي هريرة بدل ابي ثعلبة والصواب الاول قلت وقع الاول عند الخطيب في المتفق من رواية الانصاري عن بن جريج والثاني عند احمد في مسنده عن حماد بن مسعدة عن بن جريج لكن اخرجه بن منده عن عبد الرحمن بن يحيي عن ابي مسعود الرازي عن حماد بن مسعدة فقال عن ابي ثعلبة وقد بين البغوي سبب ذكر ابي هريرة فيه §  <> ابو ثعلبة الثقفي بن عم كردم بن سفيان تقدم في كردم بن سفيان ولحديثه طريق اخر اخرجه الدارقطني من طريق خالد بن معدان عن ابي ثعلبة قال قال لي عم لي اعمل عملا حتي ازوجك ابنتي فقلت ان تزوجتها فهي طالق ثلاثا وفيه انه سال النبي صلي الله عليه وسلم فقال لا طلاق الا بعد نكاح قال فتزوجتها فولدت لي سعدا وسعيدا وفي سنده علي بن قرين وهو واه وفي سياق قصته مغايرة ابو ثعلبة الحنفي ذكره قاسم بن ثابت في الدلاءل من طريق الوليد بن مسلم عن سعيد بن عبد العزيز ان ابا ثعلبة الحنفي كان يقول اني لارجو الا يخنقني الله بالموت كما يخنقكم قال فبينما هو في صرحة داره اذ قال هذا رسول الله يا عبد الرحمن لاخ له توفي في زمن النبي صلي الله عليه وسلم ثم اتي مسجد بيته فخر ساجدا فقبض وقد اخرجه ابو نعيم في الحلية في ترجمة ابي ثعلبة الخشني ولعل احد الموضعين تصحيف ابو ثعلبة الخشني صحابي مشهور معروف بكنيته واختلف في اسمه اختلافا كثيرا وكذا في اسم ابيه فقيل جرهم بضم الجيم والهاء بينهما راء ساكنة قاله احمد ومسلم وابن زنجويه وهارون الحمال وابن سعد عن اصحابه وقيل جرثم مثله لكن بدل الهاء مثلثة وقيل جرهوم كالاول لكن بزيادة واو وقيل جرثوم كالثاني بزيادة واو ايضا وقيل جرثومة مثله لكن بزيادة هاء في اخره وقيل زيد وقيل عمر وقيل سق وقيل لاسق بزيادة لام اوله وقيل لاسر براء بدل القاف وقيل لاس بغير راء وقيل لا شوم بضم المعجمة بعدها واو ثم ميم وقيل مثله لكن بزيادة هاء في اخره وقيل الاشق بفتح الهمزة وتخفيف اللام وقيل الاشر مثله لكن بدل القاف راء ومنهم من اشبع الشين بوزن الاحين وقيل ناشر بنون وشين معجمة ثم راء وقيل ناشب بموحدة بدل الراء وقيل غرنوق واختلف في اسم ابيه فقيل عمرو وقيل قيس وقيل ناسم وقيل لاسم وقيل لاسر وقيل ناشب وقيل ناشر وقيل جرهم وقيل جرهوم وقيل حمير وقيل جرثوم وقيل بزيادة هاء وقيل جلهم وقيل عبد الكريم كذا في كتاب بن سعد واسم جده لم اقف عليه والله اعلم وهو منسوب الي بني خشين واسمه واءل بن النمر بن وبرة بن تغلب بن حلوان بن عمران بن الحاف بن قضاعة وقال بن الكلبي هو من ولد ليوان بن مر بن خشين روي عن النبي صلي الله عليه وسلم عدة احاديث منها في الصحيحين من طريق ربيعة بن يزيد قلت يا رسول الله انا بارض قوم من اهل الكتاب ناكل في انيتهم وارض صيد اصيد بقوسي واصيد بكلبي المعلم وبكلبي الذي ليس بمعلم فاخبرني بالذي يحل لنا من ذلك الحديث وسكن ابو ثعلبة الشام وقيل حمص روي عنه ابو ادريس الخولاني وابو امية الشعباني وابو اسماء الرحبي وسعيد بن المسيب وجبير بن نفير وابو قلابة ومكحول واخرون ومنهم من لم يدركه قال بن البرقي تبعا لابن الكلبي كان ممن بايع تحت الشجرة وضرب له بسهمه في خيبر وارسله النبي صلي الله عليه وسلم الي قومه فاسلموا واخرج بن سعد بسند له الي محجن بن وهب قال قدم ابو ثعلبة علي رسول الله صلي الله عليه وسلم وهو يتجهز الي خيبر فاسلم وخرج معه فشهدها ثم قدم بعد ذلك سبعة نفر من قومه فاسلموا ونزلوا عليه قال ابو الحسن بن سميع بلغني انه كان اقدم اسلاما من ابي هريرة وعاش بعد النبي صلي الله §  <> عليه وسلم ولم يقاتل بصفين مع احد الفريقين ومات في اول خلافة معاوية كذا قال والمعروف خلافه وقال ابو علي الخولاني كان ينزل داريا واخرج بن عساكر في ترجمته من طريق محفوظ بن علقمة عن بن عاءذ قال قال ناشرة بن سمي ما راينا اصدق حديثا من ابي ثعلبة لقد صدقنا حديثه في افنية الاودية قال علي وكان لا ياتي عليه ليلة الا خرج ينظر الي الاسماء فينظر كيف هي ثم يرجع فيسجد وعن ابي الزاهرية قال قال ابو ثعلبة اني لارجو الله الا يخنقني كما اراكم تخنقون عند الموت قال فبينما هو يصلي في جوف اليل قبض وهو ساجد فرات ابنته في النوم ان اباها قد مات فاستيقظت فزعة فنادت اين ابي فقيل لها في مصلاه فنادته فلم يجبها فاتته فوجدته ساجدا فانبهته فحركته فسقط ميتا قال ابو عبيد وابن سعد وخليفة بن خياط وهارون الحمال وابو حسان الزيادي مات سنة خمس وسبعين ابو ثمامة الكناني اخر من كان ينسا بالحرم في الجاهلية اسمه جنادة تقدم في حرف الجيم وقيل اسمه امية ابو ثور الفهمي قال ابو زرعة الرازي له صحبة ولا اعرف اسمه وقال البغوي سكن مصر وقال ابو احمد الحاكم لا اعرف اسمه ولا سياق نسبه قلت اخرج حديثه احمد والبغوي وابن السكن وغيرهم من طريق بن لهيعة عن يزيد بن عمرو عنه قال كنا عند النبي صلي الله عليه وسلم فاتي بثوب من معافر فقال ابو سفيان لعن الله هذا الثوب ولعن من يعمله فقال النبي صلي الله عليه وسلم لا تلعنهم فانهم مني وانا منهم ولابي ثور رواية ايضا عن عثمان ذكرها ابو ثور محمد بن معد يكرب الزبيدي تقدم في الاسماء القسم الثاني خال القسم الثالث ابو ثعلبة القرظي له ادراك وسمع من عمر روي عنه الزهري ذكره ابو احمد في الكني من طريق عبد الرحمن بن يحيي العدوي عن يونس الديلي عن الزهري عن ابي ثعلبة القرظي سمعت عمر يقول قال رسول الله صلي الله عليه وسلم يحترقون فاذا صلوا الصبح غسلت ما كان قبلها الحديث قال ابو احمد هذا حديث منكر وذكر ابي ثعلبة فيه غير محفوظ وعبد الرحمن بن يحيي ليس ممن يعتمد علي روايته والمعروف ثعلبة بن ابي مالك القرظي قلت لا يبعد احتمال ان يكون غيره القسم الرابع §  <> ابو ثعلبة الانصاري ذكره بن منده واخرج من طريق حماد بن سلمة عن محمد بن اسحاق عن مالك بن ثعلبة عن ابيه ان رسول الله صلي الله عليه وسلم قضي في وادي مهزور ان الماء يحبس الي الكعبين الحديث هذا خطا وهو مقلوب الاسماء والصواب ثعلبة بن ابي مالك كما مضي في الاسماء في القسم الرابع وهو قرظي من حلفاء الانصاري ولم يسمعه من النبي صلي الله عليه وسلم بينهما رجل لم يسم وهو عند ابي داود علي الصواب حرف الجيم القسم الاول ابو جابر الانصاري عبد الله بن عمرو بن حرام تقدم في الاسماء ابو جابر الصدفي ذكره الطبراني فيمن ابهم اسمه واستدركه ابو موسي في الكني من طريقه عن الاعمش عن قيس بن جابر الصدفي عن ابيه عن جده ان رسول الله صلي الله عليه وسلم قال سيكون من بعدي خلفاء ومن بعد الخلفاء امراء ومن بعد الامراء ملوك ومن بعد الملوك جبابرة ثم يخرج رجل من اهل بيتي يملا الارض عدلا الحديث والراوي له عن الاعمش حسين بن علي الكندي لا اعرفه ولا اعرف حال جابر والد قيس ابو جابر اليمامي سيار بن طلق تقدم في الاسماء ابو جارية الانصاري حدث عن النبي صلي الله عليه وسلم انه قال القران كله صواب وروي حديثه حرب بن ثابت عن اسحاق بن جارية عن ابيه عن جده ذكره بن منده هكذا الدارقطني في المءتلف رواية جارية بن اسحاق عن ابيه عن جده ابي الجارية في الصلاة علي النجاشي وتبعه بن ماكولا ابو جبير نفير بن مالك الكندي ويقال الحضرمي تقدم في الاسماء ابو جبيرة بفتح اوله بن الضحاك بن خليفة الانصاري الاشهلي لا يعرف اسمه قال ابو احمد الحاكم وابن منده هو اخو ثابت بن الضحاك قال ابو احمد وتبعه بن عبد البر قال بعضهم له صحبة وقال بعضهم لا صحبة له روي عن النبي صلي الله عليه وسلم عدة احاديث روي عنه ابنه محمود وقيس بن ابي حازم وشبل بن عوف وعامر الشعبي قال بن ابي حاتم عن ابيه لا اعلم له صحبة قلت اخرج حديثه البخاري في الادب المفرد واصحاب السنن وصححه الحاكم وحسنه الترمذي ولفظه فينا نزلت هذه الاية ولا تنابزوا بالالقاب ابو جبيرة بن الحصين بن النعمان بن سنان بن عبد بن كعب بن عبد الاشهل الانصاري §  <> الاشهلي مذكور في الصحابة قاله ابو عمر قلت تقدم ذكره في اسلم وسماه ابو عبيد القاسم بن سلام كذلك ابو جحش الليثي اخرج حديثه ابو الشيخ في كتاب العظمة والحاكم في المستدرك من طريق عبد الملك بن قدامة عن عبد الرحمن بن عبد الله بن دينار عن ابيه عن بن عمر قال جاء عمر والصلاة قاءمة وثلاثة نفر جلوس احدهم ابو جحش الليثي فقال قوموا فصلوا مع رسول الله صلي الله عليه وسلم فقام اثنان واما ابو جحش فقال لا اقوم حتي ياتيني اقوي مني ذراعين فيصرعني حتي يدمي وجهي في التراب ففعل به عمر فذكر الحديث في صفة عباد الملاءكة ولفظه فقال النبي صلي الله عليه وسلم اجلس يغني الرب عن صلاة ابي جحش ان لله في سماء الدنيا ملاءكة خشوعا لا يرفعون رءوسهم حتي تقوم الساعة وفي الحديث ايضا ان رضا عمر رحمة واخرجه ابو نعيم من طريقه وقال الحاكم علي شرط البخاري ورده الذهبي بانه غريب منكر وليس علي شرطه قلت وليس في سنده الا عبد الملك بن قدامة الجمحي وهو مختلف فيه وثقه بن معين والعجلي وضعفه ابو حاتم والنساءي وقال البخاري يعرف وينكر ابو جحيفة وهب بن عبد الله السواءي تقدم في الاسماء ابو الجراح الاشجعي ويقال الجراح قال ابو موسي في الذيل ذكره خليفة بن خياط بلفظ الكنية قلت تقدم في الاسماء ابو جرول زهير بن صرد الجشمي تقدم في الاسماء جرول اخر هو هند بن الصامت تقدم ابو جري بالتصغير هو جابر بن سليم او سليم بن جابر الهجيمي تقدم ورجح البخاري الاول ابو الجعال الجذامي ذكره الاموي في المغازي عن بن اسحاق فيمن وفد علي النبي صلي الله عليه وسلم من ضمام يطلبون سبيهم الذين سباهم زيد بن حارثة وانشد له في ذلك شعرا ابو الجعد افلح اخو ابي القعيس والد عاءشة رضي الله عنها من الرضاعة تقدم كناه ابا الجعد بن جريج في روايته عن عطاء عن عروة عن عاءشة رضي الله عنها ابو الجعد الضمري قال البخاري لا اعرف اسمه ولا اعرف له الا هذا الحديث يعني الذي اخرجه له اصحاب السنن والبغوي وصححه بن خزيمة وابن حبان وغيرهما وهو من الترهيب من ترك صلاة الجمعة الحديث ووقع في بعض طرقه وكانت له صحبة وسماع غيره ادرع وقيل جنادة وقيل عمرو بن بكر يروي عن سلمان الفارسي ايضا روي عنه عبيدة بن سفيان الحضرمي وكان علي قومه في غزوة الفتح قاله بن سعد وقال بن البرقي قتل مع عاءشة رضي الله عنها في وقعة الجمل وقال البغوي سكن المدينة وكانت له دار في بني ضمرة وعزاه لابن سعد وزاد ان النبي صلي الله عليه وسلم بعثه يحشر قومه لغزو الفتح وبعثه ايضا الي قومه حين اراد الخروج الي تبوك يستنفر قومه فخرج اليهم §  <> الي الساحل فنفروا معه الي النبي صلي الله عليه وسلم ابو الجعيجعة صاحب الرقيق ذكره بن منده واخرج من طريق ابي مقاتل حفص بن مسلم عن عبد الله بن عوف عن الحسن ان رجلا كان علي عهد رسول الله صلي الله عليه وسلم يبيع الرقيق يقال له ابو الجعيجعة قال فذكر الحديث ابو جمعة الانصاري ويقال الكناني ويقال القاري بتشديد الياء مشهور بكنيته مختلف في اسمه قيل اسمه جندب بن سبع وقيل بن سباع وقيل بن وهب وقيل اسمه جنبد بتقديم النون علي الموحدة وقيل حبيب بمهملة مفتوحة وموحدة وهو ارجح الاقوال ذكره محمد بن الربيع الجيزي في الصحابة الذين شهدوا فتح مصر وقال بن سعد وكان بالشام ثم تحول الي مصر واخرج الطبراني ما يدل علي انه اسلم ايام الحديبية فاخرج من طريق حجر ابي خلف عن عبد الله بن عوف عن ابي جمعة جنبد بن سبع الانصاري قال قاتلت النبي صلي الله عليه وسلم اول النهار كافرا وقاتلت معه اخر النهار مسلما وكنا ثلاثة رجال وتسع نسوة وفينا نزلت ولولا رجال مءمنون ونساء مءمنات قلت وقوله الانصاري لا يصح لان الانصار حينءذ لم يبق منهم من يقاتل المسلمين مع قريش وقد اخرج الطبراني ايضا من طريق صالح بن جبير عن ابي جمعة الكناني حديثا فهذا اشبه ويحتمل ان يكون انصاريا بالحلف فقد روينا في الاربعين للنسفي التي وقعت لنا من حديث السلفي متصلة بالسماع من رواية معاوية بن صالح عن صالح بن جبير قال قدم علينا ابو جمعة الانصاري صاحب رسول الله صلي الله عليه وسلم ببيت المقدس ليصلي فيه ومعنا رجاء بن حيوة يومءذ فلما انصرف خرجنا معه لنشيعه فلما اردنا الانصراف قال ان لكم جاءزة وحقا احدثكم بحديث سمعته من رسول الله صلي الله عليه وسلم قال قلنا هات يرحمك الله قال كنا مع رسول الله صلي الله عليه وسلم ومعنا معاذ عاشر عشرة فقلنا يا رسول الله هل من قول اعظم اجرا منا امنا بك واتبعناك قال ما يمنعكم ورسول الله بين اظهركم وياتيكم الوحي من السماء الحديث وله شاهد من طريق اسيد بن عبد الرحمن عن صالح بن جبير بغير اسناده اخرجه احمد والدارمي وصححه الحاكم واخرج حديثه البخاري في كتاب خلق افعال العباد واختلف فيه علي الاوزاعي فقال الاكثر عنه عن اسيد عن خالد بن دريك عن بن محيريز قال قلت لابي جمعة قال تغدينا مع رسول الله صلي الله عليه وسلم ومعنا ابو عبيدة بن الجراح الحديث وقال بن شماسة عن الاوزاعي عن اسيد عن صالح بن محمد حدثني ابو جمعة وروي عنه ايضا مولاه ولم يسم وصالح بن جبير وعبد الله بن محيريز هو عبد الله بن عوف الرملي وذكره البخاري في فضل من مات بين السبعين الي الثمانين واغرب بن حبان فقال في ثقات التابعين ابو جمعة حبيب بن سباع روي عن جماعة من الصحابة ابو جميلة السلمي اسمه سنين بمهملة ونونين مصغرا ذكر البخاري في تصحيحه تعليقا انه شهد فتح مكة وذكر قصته مع عمر في المنبوذ وان عريفه شهد عند عمر انه رجل صالح ووصله مالك وقد تقدمت ترجمته في حرف السين المهملة في الاسماء وقال بعضهم انه ضمري وسمي بن حبان اباه واقدا وقيل اسم ابيه فرقد وله رواية ايضا عن ابي بكر وعمر روي عنه الزهري انه ادرك النبي صلي الله §  <> عليه وسلم وحج معه وخرج معه عام الفتح وقال بن سعد له احاديث وذكره في الطبقة الاولي من التابعين وكذا قال العجلي انه تابعي ثقة وفرق البغوي بينه وبين سنين بن واقد كما تقدم في الاسماء ابو جندب العتقي بضم المهملة وفتح المثناة ثم قاف قال ابو سعيد بن يونس شهد فتح مصر وله صحبة وليس له حديث ابو جندب الفزاري ذكره مطين والباوردي في الصحابة واخرجا من طريق النضر بن منصور عن سهل الفزاري عن جندب الفزاري عن ابيه كان رسول الله صلي الله عليه وسلم اذا لقي اصحابه لم يصافحهم وزاد الباوردي في بعض مغازيه فلقينا قوم قد فاتتهم الصلاة وقال بن ابي حاتم عن ابيه رواته مجهولون وذكره ابو نعيم وابو موسي من طريق مطين واستدركه بن فتحون ابو جندل بن سهيل بن عمرو القرشي العامري تقدم نسبه في ترجمة والده قيل اسمه عبد الله وكان من السابقين الي الاسلام وممن عذب بسبب اسلامه ثبت ذكره في صحيح البخاري في قصة الحديبية من طريق معمر عن الزهري عن عروة عن المسور بن مخرمة ومروان بن الحكم فذكر القصة قال وجاء ابو جندل بن سهيل يرسف في قيوده فقال يا معشر المسلمين ارد الي المشركين وقد جءت مسلما الا ترون الي ما لقيت وكان قد عذب عذابا شديدا وكان مجيءه قبل فراغ الكتاب فقال النبي صلي الله عليه وسلم اجزه لي فامتنع وقال هذا ما اقاضيك عليه فقال انا لم نقض الكتاب بعد قال فوالله لا اصالحك علي شء ابدا فاخذ سهيل بن عمر وابوه فرجع به فذكر قصة اسلامه ولحاقه بابي بصير بساحل البحر وانضم اليهما جماعة لا يدعون لقريش شيءا الا اخذوه حتي بعثوا الي رسول الله صلي الله عليه وسلم يسالونه ان يضمهم اليه واورده البغوي من طريق عبد الرزاق مطولا وقد ساقها بن اسحاق عن الزهري مطولة وثبت ذكره في الصحيح في حديث سهل بن سعد ايضا انه قال يوم صفين ايها الناس اتهموا رايكم لقد رايتني يوم ابي جندل ولو استطيع ان ارد امر رسول الله صلي الله عليه وسلم لرددته يعني في امر ابي جندل وذكره اهل المغازي فيمن شهد بدرا وكان اقبل مع المشركين فانحاز الي المسلمين ثم اسر بعد ذلك وعذب ليرجع عن دينه ثم لما كان في فتح مكة كان هو الذي استامن لابيه ذكر ذلك الواقدي من حديث سهيل قال لما دخل رسول الله صلي الله عليه وسلم مكة اغلقت بابي وارسلت ابني عبد الله ان اطلب لي جوارا من محمد فذكر الحديث في تامينه اياه واستشهد ابو جندل باليمامة وهو بن ثمان وثلاثين سنة قاله خليفة وابن اسحاق وابو معشر وغيرهم ابو جنيد مصغرا بن جندع من عمرو بن مازن ذكره بن منده واخرج من طريق البلوي عن عمارة بن زيد عن عبد الله بن العلاء عن الزهري سمعت سعيد بن حبان يذكر عن ابي عنفوانة البارقي سمعت ابا جنيد بن جندع المازني يقول قدمت علي رسول الله صلي الله عليه وسلم يوم حنين غداة هوازن فذكر الحديث والبلوي متروك ابو جنيدة الفهري ذكره مطين في الصحابة والطبراني عنه وابو نعيم عنه واخرج من طريق اسحاق بن عبد الله بن ابي فروة عن ابي جنيدة الفهري عن ابيه عن جده قال قال رسول الله §  <> صلي الله عليه وسلم من سقي عطشان فارواه فتحت له ابواب الجنة الحديث واخرجه ابو نعيم وابو موسي هذه رواية مطين عن محمد بن علي الملطي وقال جابر بن كردي عن يزيد بن هارون عن اسحاق بن خليدة بخاء معجمة ولام ودال ووافقه داود بن الجراح عن ابي غسان عن اسحاق لكن قال بن خليد بلا هاء قال ابو موسي ورواه ابو الشيخ من طريق اخري فقال بن خليدة عن ابيه عن حذيفة ابو جهاد الانصاري السلمي قال ابو نعيم يعد في المصريين واخرج من طريق بن وهب عن سعيد بن عبد الرحمن حدثني رجل من الانصار من بني سلمة عن ابيه عن جده ابي جهاد وكان ابو جهاد من اصحاب رسول الله صلي الله عليه وسلم فقال له ابنه يا ابتاه رايتم رسول الله صلي الله عليه وسلم وصحبتموه والله لو رايته لفعلت وفعلت فقال له ابوه اتق الله وسدد فوالذي نفسي بيده لقد رايتنا معه ليلة الخندق وهو يقول من يذهب فياتينا بخبرهم جعله الله رفيقي يوم القيامة فما قام من الناس احد من صميم ما بهم من الجوع والقر حتي نادي في الثالثة يا حذيفة واخرجه الدولابي من هذا الوجه ابو الجهم بن حذيفة بن غانم بن عامر بن عبد الله بن عبيد بن عويج بن عدي بن كعب القرشي العدوي قال البخاري وجماعة اسمه عامر وقيل اسمه عبيد بالضم قاله الزبير بن بكار وابن سعد وقالا انه من مسلمة الفتح وقال البغوي عن مصعب كان من معمري قريش ومن مشيختهم وحكي بن منده ان ابا عاصم فرق بين ابي جهم بن حذيفة وعبيد بن حذيفة قال الزبير كان من مشيخة قريش وهو احد الاربعة الذين كانت قريش تاخذ عنهم النسب قال وقال عمي كان من المعمرين حضر بناء الكعبة مرتين حين بنتها قريش وحين بناها بن الزبير وهو احد الاربعة الذين تولوا دفن عثمان واخرج البغوي من طريق حفص بن غياث عن هشام بن عروة عن ابيه قال لما اصيب عثمان ارادوا الصلاة عليه فمنعوا فقال ابو الجهم دعوه فقد صلي الله عليه وسلم ورسوله واخرج بن ابي عاصم في كتاب الحكماء من طريق عبد الله بن الوليد عن ابي بكر بن عبيد الله بن ابي الجهم قال سمعت ابا الجهم يقول لقد تركت الخمر في الجاهلية وما تركتها الا خشية علي عقلي وما فيها من الفساد وثبت ذكره في الصحيحين من طريق عروة عن عاءشة رضي الله عنها قالت صلي النبي صلي الله عليه وسلم في خميصة لها اعلام فقال اذهبوا بخميصتي هذه الي ابي جهم واءتوني بانبجانية ابي جهم فانما الهتني انفا علن صلاتي وذكر الزبير من وجه اخر مرسلا ان النبي صلي الله عليه وسلم اتي بخميصتين سوداوين فلبس احداهما وبعث الاخري الي ابي جهم ثم انه ارسل الي ابي جهم في تلك الخميصة وبعث اليه التي لبسها هو ولبس هو التي كانت عند ابي جهم بعد ان لبسها ابو جهم لبسات وثبت ذكره في حديث فاطمة بنت قيس لما قالت ان معاوية وابا جهم خطباني اما ابو جهم فلا يضع عصاه عن عاتقه وقالوا انه كان ضرا بالنساء وقال بن سعد كان شديد العارضة وكان عمر يمنعه حتي كف من لسانه وتقدمت له قصة اخري في ترجمة خالد بن البرصاء واخرج بن المبارك في الزهد من طريق عمر بن سعيد بن ابي حسين حدثني بن سابط وغيره ان ابا جهم بن حذيفة قال انطلقت يوم اليرموك اطلب بن عمي ومعي شنة من ماء فذكر القصة قال بن سعد مات في اخر خلافة معاوية قلت وما تقدم عن الزبير انه حضر بناء الكعبة ان ثبت يدل علي انه تاخر §  <> الي اول خلافة بن الزبير ويءيده ما رواه بن اخي الاصمعي في النوادر عن عمه عن عيسي بن عمر قال وفد ابو جهم علي معاوية ثم علي يزيد ثم ذكر قصة له مع بن الزبير ابو الجهيم بن الحارث بن الصمة بن عمرو بن عتيك بن عمرو بن مبذول بن عامر بن مالك بن النجار الانصاري وقيل في نسبه غير ذلك فقيل اسمه عبد الله وقيل اسمه الحارث بن الصمة ورجحه بن ابي حاتم ثم ترجمه بن ابي حاتم ايضا عبد الله بن جهيم ابو جهيم جعله اثنين وقال بن منده ابو جهيم بن الحارث ويقال عبد الله بن جهيم بن الحارث بن الصمة فجعل الحارث بن الصمة جده وما اظنه الا وهما وتبعه بن الاثير ونسبه الي الاستيعاب ايضا وحديث ابي جهيم بن الحارث في الصحيحين وغيرهما من رواية عن مالك عن ابي النضر عن بشر بن سعيد ان زيد بن خالد ارسله الي ابي جهيم يساله ما سمع من رسول الله صلي الله عليه وسلم في المار بين يدي المصلي ماذا عليه الحديث وقد رواه بن عيينة عن ابي النضر عن بشر قال ارسلني ابو جهيم عبد الله بن جهيم الي زيد بن خالد وهو مقلوب اخرجه بن ماجة واخرجه مسلم معلقا ووصله البخاري وابو داود والنساءي من طريق الاعرج عن عمير مولي بن عباس قال اقبلت انا وعبد الله بن يسار حتي دخلنا علي ابي جهيم فقال اقبل رسول الله صلي الله عليه وسلم من نحو بءر جمل فلقيه رجل فسلم عليه الحديث في التيمم قبل رد السلام ورواه بن لهيعة عن عبد الله بن يسار عن ابي جهيم اخرجه احمد ولابي جهيم حديث اخر اخرجه احمد والبغوي من طريق يزيد بن خصيفة عن مسلم بن سعيد مولي بن الحضرمي عن ابي جهيم الانصاري ان رجلين اختلفا في اية الحديث وفيه ان هذا القران انزل علي سبعة احرف وروي عنه ايضا بشر بن سعيد واخوه مسلم بن سعيد ويقال بن اخت ابي بن كعب ابو جهيمة عبد الله بن جهيم مر ذكره في الذي قبله وتقدم في العبادلة ابو جهينة بالنون بدل الميم الانصاري ذكره الثعلبي في تفسير قوله تعالي ويل للمطففين فاخرج من طريق السدي انه كان له مكيالان يكيل باحدهما ويكتال بالاخر فنزلت ويل للمطففين واستدركه بن فتحون ابو الجون هو قتادة بن الاعور تقدم في القاف ذكره البغوي ابو جبيش بن ذي اللحية العامري الكلابي ذكره سيف في الفتوح وقال استعمله خالد بن الوليد علي هوازن فيمن استعمله من كماة الصحابة عند دخول العراق واستدركه بن فتحون القسم الثاني ابو جعفر الانصاري غير منسوب جاء عنه ما يدل علي انه ولد في عهد النبي صلي الله عليه وسلم فاقل احواله ان يكون من اهل هذا القسم فاخرج بن ابي شيبة من طريق ثابت بن عبيد عن ابي جعفر الانصاري قال رايت ابا بكر الصديق وراسه ولحيته كانهما جمر الغضا وبه انه شهد قتل §  <> عثمان فذكر قصته وقد فرق ابو احمد الحاكم بين هذا وبين ابي جعفر الانصاري الذي روي عن ابي هريرة وهو الظاهر القسم الثالث ابو جامع بن مخارق بن عبد الله بن شداد الهلالي تقدم نسبه في ترجمة اخيه قبيصة في الاسماء ولهذا ادرك ولما مات رثاه بن همام السلولي قاله بن الكلبي ابو جبر احد من استشهد يوم جسر ابو عبيد الثقفي في فتوح العراق وقع ذكره في قصيدة لابي محجن الثقفي رثي فيها من استشهد يومءذ يقول فيها واضحي ابو جبر خليا بيوته وقد كان يغشاها الضعاف الارامل ابو الجعد الغطفاني والد سالم قال البخاري وغيره اسمه رافع وقال البغوي ادرك النبي صلي الله عليه وسلم قلت حديثه عن عبد الله بن مسعود عند مسلم في كتاب التوبة في اواخر الصحيح وله ايضا رواية عن علي بن ابي طالب روي عنه ابنه سالم بن ابي الجعد والشعبي وذكر الحسن بن سفيان في مسنده عنه حديثا مرسلا قال حدثنا احمد بن حنبل حدثنا الحارث بن النعمان عن ابي هريرة الحمصي حدثني علي بن ابي طلحة عن سالم بن ابي الجعد عن ابيه قال قال رسول الله صلي الله عليه وسلم البر لا يبلي والاثم لا ينسي والذنب لا يفني قلت والحارث بن النعمان ضعيف وشيخه ما عرفته وقد اخرج المتن ابو نعيم من طريق مكرم بن عبد الرحمن عن محمد بن عبد الملك عن نافع عن بن عمر به واتم منه ومحمد بن عبد الملك كذبوه ابو الجعيد له ادراك وله ذكر في وقعة اليرموك فذكر محمد بن عاءذ عن الوليد قال اخبرني شيخ من بني ابي الجعيد عن ابيه ابي الجعيد انه اشار علي المسلمين ببيات الروم فقبلوا منه فبيتوهم فذكر القصة وفيها انه وقع في الوادي ثمانون الفا لا يعرف الاخر ما لقي الاول ابو الجلندي الازدي له ادراك وقدم علي عمر فقال له اعرابي ممن انت قال انا ممن انعم الله عليه بالاسلام وكان معه ابو صفرة والد المهلب ذكره بن الكلبي ابو جمعة بن خالد بن عبيد بن ميسر بن رباح بن سالم بن غاضرة بن حبيشة بن كعب الخزاعي له ادراك وهو جد كثير بن عبد الرحمن الخزاعي الشاعر المشهور من قبل امه ذكره بن الكلبي ابو جندل بن سهيل شامي له ادراك وسمع من بلال ذكره الحاكم ابو احمد وفرق بينه وبين ابي جندل بن سهيل بن عمرو الماضي ذكره في الاول واخرج من طريق عبد الله بن عبيد الكلاعي عن مكحول عن الحارث بن معاوية الكندي وابي جندل بن سهيل قالا سالنا بلالا مءذن النبي صلي الله عليه وسلم فذكر حديثه قال الحاكم قال فيه بعض الرواة عن ابي جندل بن سهيل §  <> بن عمرو من بني عامر بن لءي وهو وهم لان ابا جندل العامري استشهد باليمامة ولم يدركه مكحول ولا روي هو عن بلال وذكر بن عساكر نحو ما ذكر الحاكم ابو احمد ان الزبير بن بكار فرق بينهما ايضا والرواية التي في هذه القصة فيها ابو جندل بن سهيل بن عمرو واخرجها تمام في فواءده ابو جندلة زوج امامة له ادراك وقع ذكره في حديث عبد الله بن قرط الثمالي امير حمص لعمر اخرج ابو الشيخ في كتاب النكاح من طريق مسكين بن ميمون المءذن عن عروة بن رويم ان عبد الله بن قرط الثمالي كان يعس بحمص ذات ليلة وكان عاملا لعمر فمرت به عروس وهم يوقدون النيران بين يديها فضربهم بدرته حتي تفرقوا عن عروسهم فلما اصبح قعد علي منبره فحمد الله واثني عليه فقال ان ابا جندلة نكح امامة فصنع لها حثيات من طعام فرحم الله ابا جندلة وصلي علي امامة ولعن الله عروسكم البارحة اوقدوا النيران وتشبهوا بالكفرة والله مطفء نورهم قال وعبد الله بن قرط من اصحاب النبي صلي الله عليه وسلم ابو جهراء مخضرم ياتي ذكره في المبهمات والمشهور انه بن جهراء وقيل اسمه عبد الله ابو جهراء اخر له ادراك وكان عمر ياتمنه ياتي ذكره في ترجمة ابي محجن الثقفي في القسم الاول القسم الرابع ابو جبير الكندي فرق بن الاثير بينه وبين والد جبير بن نفير وتبعه الذهبي فقال ابو جبير الكندي له حديث في الوضوء رواه عنه جبير بن نفير وقال ايضا ابو جبير الحضرمي له حديث وفيه وفادته وهما واحد فان الحديث المذكور اخرجه الحاكم ابو احمد في الكني وابن حبان في صحيحه من طريق معاوية بن صالح عن عبد الرحمن بن جبير بن نفير ان ابا جبير قدم علي النبي صلي الله عليه وسلم فذكر حديثه وفيه ذكر الوضوء وانه بدا بفيه فقال له النبي صلي الله عليه وسلم لا تبدا بفيك وقد مضي في نفير في حرف النون من الاسماء ابو الجدعاء ذكره الطبري والدولابي في الصحابة واخرجا من طريق خالد الحذاء عن عبد الله بن شقيق عن ابي الجدعاء مرفوعا يدخل الجنة بشفاعة رجل من امتي اكثر من بني تميم استدركه بن فتحون وهو خطا نشا عن حذف وانما هو عن بن ابي الجدعاء فسقط لفظ بن وحديثه علي الصواب في جامع الترمذي وغيره ابو جرير ياتي في الحاء المهملة علي الصواب ابو جسرة ذكره ابو بكر بن ابي علي واستدركه ابو موسي واخرج من طريق ابي بكر بن ابي عاصم ثم من رواية داود بن مساور عن معقل بن همام سمعت ابا جسرة يقول وفدنا الي §  <> رسول الله صلي الله عليه وسلم فنهانا عن الدباء والحنتم والمزفت وهو خطا نشا عن تصحيف وانما هو ابو الخير بخاء معجمة ثم تحتانية وهو الصباحي من عبد القيس وسياتي علي الصواب ابو جمعة روي عنه عبد الله بن عوف الرملي حديثا وغاير الدولابي في الكني بينه وبين ابي جمعة بن سبع وهما واحد والحديث الذي ذكره معروف بالاول ابو الجمل بفتحتين ذكره بن عبد البر في اخر حرف الجيم من الكني وحكاه عن عباس الدوري عن يحيي بن معين قال ابو الجمل صاحب رسول الله صلي الله عليه وسلم اسمه هلال بن الحارث كاد يكون بحمص وقد رايت بها غلاما من ولده قاله يحيي وقد تعقب بن فتحون وغيره ذلك وقالوا لا خلاف بين اهل العلم ان هلال بن الحارث يكني ابا الحمراء بالمهملة والراء والمد وليس في الصحابة من يكني ابا الجمل والوهم فيه من ابي عمر لا من عباس والموجود في تاريخ بن معين رواية عباس بالمهملة والراء وهكذا رواه ابو بشر الدولابي ومحمد بن مخلد واحمد بن شاهين والد ابي حفص وابو سعيد بن الاعرابي وغيرهم كلهم عن عباس الدوري وقد ذكره ابو عمر علي الصواب في الحاء المهملة فقال ابو الحمراء اسمه هلال وله فيه وهم اخر فانه قال في الاسماء هلال بن الحمراء فجعل كنيته اسم ابيه ابو جهيمة ذكره الذهبي في التجريد وعزاه لابي موسي فانه اخرج من طريق محمد بن الحسن بن النقاش المقري قال حدثنا الحسين بن ادريس حدثنا خالد بن هياج حدثنا ابي حدثنا سفيان هو الثوري عن منصور عن فضيل بن عمرو عن ابي العالية عن ابي جهيمة ان رسول الله صلي الله عليه وسلم كان يقول في مجلسه باخرة سبحانك اللهم وبحمدك الحديث قال ابو موسي رواه الربيع بن انس عن ابي العالية عن ابي بن كعب ورواه جرير عن فضيل بن عمرو عن زياد بن الحصين عن معاوية قلت كذا فيه وانما هو عن ابي العالية لا عن معاوية فقد ذكر بن ابي حاتم في العلل عن ابيه ان زياد بن الحصين رواه عن ابي العالية مرسلا وزياد بن الحصين يكني ابا جهيمة وهو الذي روي هذا الحديث عن ابي العالية وقوله في الاول عن ابي العالية عن ابي بن كعب خطا وانما هو عن ابي العالية عن رافع بن خديج كما اخرجه الحاكم في المستدرك وذكر رافع بن خديج فيه مع ذلك خطا والصواب مرسل كما قال بن ابي حاتم عن ابيه وقد رواه ابو نعيم الفضل بن دكين عن الثوري بالسند الاول لكن لم يجاوز به ابا العالية وابو نعيم من المتقنين بخلاف غيره وبالله التوفيق حرف الحاء المهملة القسم الاول §  <> ابو حابس الجهني ذكره الطبري في الصحابة واستدركه بن فتحون ابو حاتم المزني حجازي قال الترمذي وابن حبان وابن السكن له صحبة وزاد الترمذي بعد ان اخرج حديثه وهو في تزويج الاكفاء اذا جاءكم من ترضون دينه الحديث لا اعرف له غيره واورد ابو داود حديثه في المراسيل فهو عنده تابعي ونقل بن ابي حاتم عن ابي زرعة قال لا اعرف له صحبة ولا اعرف له الا هذا الحديث وزعم بن قانع ان اسمه عقيل بن مقرن وقد بينت وهمه في ترجمة عقيل المذكور روي عنه محمد وسعيد ابنا عبيد ابو حاجب الانصاري ذكره الدولابي في الصحابة من كتاب الكني ولم يذكر له حديثا ابو الحارث بن الحارث بن عبد المطلب الهاشمي هو نوفل ابو الحارث بن الحارث الكندي هو غرفة نزل مصر ابو الحارث بن الحنظلية اخو سهيل هو سعد الانصاري ابو الحارث هو عبد الله بن الساءب المخزومي ابو الحارث هو عياش بن ابي ربيعة المخزومي تقدموا كلهم في الاسماء ابو الحارث بن قيس بن خالد بن مخلد الانصاري الزرقي ذكره موسي بن عقبة عن بن شهاب فيمن شهد بدرا ابو الحارث الازدي ذكره بن ابي عاصم وتبعه ابو بكر بن ابي علي وروي من طريق سليمان بن عبيد عن القاسم بن يحيي عنه في هذه الاية ولقد راه نزلة اخري فقالوا يا رسول الله ما رايت قال رايت فراشا من ذهب كهيءة الضباب ابو حازم الاحمسي هو صخر بن عيلة تقدم في الاسماء ابو حازم البجلي والد قيس وقيل اسمه عوف وقيل عبد عوف اخرج حديثه البخاري في الادب المفرد وابو داود وصححه وابن خزيمة وابن حبان والحاكم كلهم من طريق اسماعيل بن ابي خالد عن قيس بن ابي حازم عن ابيه انه جاء والنبي صلي الله عليه وسلم يخطب فقام في الشمس فامر به فتحول الي الظل قال محمد بن سعد قتل ابو حازم بصفين ابو حازم البجلي اخر ذكره ابو نعيم في الصحابة واخرج من طريق قيس بن الربيع عن ابان بن عبد الله البجلي عن كريمة بنت ابي حازم عن ابيه قال اختصم الي رسول الله صلي الله عليه وسلم رجلان في ولد فقضي به لاحدهما ابو حازم الانصاري من بني بياضة ذكره البغوي وغيره في الصحابة واخرج هو واسحاق بن راهويه في مسنده والحسن بن سفيان وغيرهم عنه عن النبي صلي الله عليه وسلم في الاعتكاف روي عنه محمد بن ابراهيم التيمي واخرج البغوي وابو داود في المراسيل من طريق شمر بن عطية عن ابي حازم قال كان للنبي صلي الله عليه وسلم نطع يستظل به من الغنيمة فذكر الحديث واخرج §  <> النساءي حديثه الاول من طرق قال في بعضها عن ابي حازم مولي الانصار وفي بعضها مولي الغفارين وفي بعضها عن ابي حازم التمار عن البياضي والرجل الذي من بني بياضة اسمه عبد الله بن جابر وقيل فروة بن عمرو واما التمار فهو تابعي مولي ابي رهم الغفاري وقال الاجري قلت لابي داود ابو حازم حدث عنه محمد بن ابراهيم قال هو الرجل الذي من بني بياضة وقيل انهما اثنان التمار هو مولي ابي رهم الغفاري وان البياضي هو مولي الانصاري والله اعلم ابو حاضر غير منسوب ذكره البغوي وابن الجارود والباوردي وابن حبان في الصحابة وقال الذهلي لا ادري له صحبة ام لا وقال البغوي لم ينسب وقال بن مندة له ذكر في الصحابة واخرج هو والبغوي من طريق شعبة عن خالد الحذاء عن ابي هنيدة عن ابي حاضر قال الا اعلمك كيف كان رسول الله صلي الله عليه وسلم يصلي علي الجنازة اللهم نحن عبادك وانت خلقتنا وانت ربنا واليك معادنا وفي رواية البغوي انه صلي الله عليه وسلم صلي علي جنازة ثم قال الا اخبركم فذكره وقال فيه انت خلقتنا ونحن عبادك والباقي مثله ابو حاطب بن عمرو بن عبد شمس بن عبد ود بن نصر بن مالك بن حسل بن عامر بن لءي القرشي العامري اخو سهيل بن عمرو من السابقين الي الاسلام ذكره بن اسحاق فيمن هاجر الي الحبشة ابو حامد ياتي في ابي حماد ابو حبة البدري وقع ذكره في الصحيح من رواية الزهري عن انس عن ابي بكر بن محمد بن عمرو بن حزم عن ابي حبة البدري عقب حديث الزهري عن انس عن ابي ذر في الاسراء وروي عنه ايضا عمار بن ابي عمار وحديثه عنه في مسند بن ابي شيبة واحمد وصححه الحاكم وصرح بسماعه عنه وعلي هذا فهو غير الذي ذكر بن اسحاق انه استشهد باحد وله في الطبراني حديث اخر من رواية عبد الله بن عمرو بن عثمان عنه وسنده قوي الا ان عبد الله بن عمرو بن عثمان لم يدركه وقال ابو حاتم اسمه عامر بن عبد عمرو بن عمير بن ثابت وقال ابو عمر يقال بالموحدة وبالنون وبالياء والصواب بالموحدة وقيل اسمه عامر وقيل مالك وبالنون ذكره موسي بن عقبة وابن ابي خيثمة وانكر الواقدي ان يكون في البدريين من يكني ابا حبة بالموحدة وقد ذكر بن اسحاق في البدريين ابا حبة من بني ثعلبة بن عمرو بن عوف وكان اخا سعد بن خيثمة لامه ووافقه ابو معشر وقال بن سعد لم نجد في نسب الانصار في ولد عمرو بن عمير بن ثابت بن كلفة بن ثعلبة احدا يقال له ابو حبة وقال الواقدي في الانصار من يكني ابا حبة اثنان احدهما ابو حبة بن غزية بن عمرو المازني من بني مازن بن النجار لم يشهد بدرا والاخر ابو حبة بن عبد عمرو شهد صفين مع علي وليس هو من اهل بدر وجزم عبد الله بن محمد بن عمارة ان الذي شهد بدرا يكني ابا حنة بالنون بدل الموحدة قال واسمه ثابت بن النعمان بن امية اخو ابي الصباح لامه ونقل العسكري عن الجهمي قال ابو حبة الانصاري اثنان احدهما عمرو بن غزية وهو الاكبر والاخر يزيد بن غزية وهو الاصغر وقال وابن الكلبي يقوله بالنون §  <> ابو حبة بن غزية بن عمرو بن عطية بن خنساء بن مبذول بن عمرو بن غنم بن مازن بن النجار الانصاري المازني قال موسي بن عقبة وابن اسحاق وغيرهما شهدا احدا واستشهد باليمامة وادعي الطبري ان اسمه زيد وقد خلطه غير واحد بالذي قبله وفرق بينهما غير واحد قال ابو عمر هذا خزرجي وذاك اوسي وهذا لم يشهد بدرا وذاك شهدها والله اعلم ابو حبيب العنبري جد الهرماس بن حبيب ذكره الدولابي في الكني وسماه اسحاق بن راهويه ثعلبة وقد تقدم في الاسماء ابو حبيب بن زيد بن الحباب بن انس بن زيد بن عبيد الانصاري الخزرجي يجتمع مع ابي بن كعب في عبيد قال بن الكلبي شهد بدرا وقال ابو عمر ذكر في الصحابة ولا اعرفه ابو حبيب الفهري تقدم ذكره في ولده حبيب في الاسماء ابو حبيب روي عنه بن الشاعر وهو مجهول كذا في التجريد ابو حبيبة بن الازعر بن زيد بن العطاف بن ضبيعة الانصاري استدركه يحيي بن عبد الوهاب بن منده علي جده وقال انه ممن شهد احدا ابو حثمة الانصاري والد سهل اسمه عبد الله ويقال عامر بن ساعدة بن عامر بن عدي الحارثي تقدم نسبه في ترجمة ولده قال البخاري في التاريخ قال لي ابراهيم بن المنذر حدثنا محمد بن صدقة حدثني محمد بن يحيي بن سهل بن ابي حثمة عن ابيه عن جده ان النبي صلي الله عليه وسلم بعث ابا حثمة خارصا واخرجه الدارقطني من طريق اخري عن محمد بن صدقة فزاد في اخره فجاء رجل فقال يا رسول الله ان ابا حثمة زاد علي فقال له رسول الله صلي الله عليه وسلم ان بن عمك يشكوك فقال يا رسول الله لقد تركت له خرفة اهله وذكر الواقدي عن محمد بن يحيي بن سهل عن ابيه عن جده ان النبي صلي الله عليه وسلم قال يوم احد من رجل يدلنا علي الطريق يخرجنا علي القوم من قرب فقال ابو حثمة انا فكان دليله حتي اخرجه علي القوم وقال الواقدي كان ابو بكر وعمر وعثمان يبعثونه علي الخرص ومات في اول ولاية معاوية وقد ذكر بن اسحاق في السيرة هذه القصة لكن قال في صاحبها انه ابو خيثمة بمعجمة ثم مثناة تحتانية ثم فوقانية وذكر اليعمري انه وهم وان الصواب انه ابو حثمة والد سهل ولم يات علي الجزم بذلك دليل الا قول بن عبد البر ليس في الصحابة ابو حثمة سوي الجعفي والسالمي وفي هذا الحصر نظر ابو حثمة بن حذيفة بن غانم بن عامر القرشي العدوي اخو ابي جهم قال بن السكن له صحبة وهو من مسلمة الفتح ابو الحجاج الثمالي اسمه عبد الله بن عبد بن عامر وقيل جعد بن عبد تقدم في الاسماء ابو الحجاج الاسلمي والد الحجاج بن الحجاج تقدم في الاسماء ذكره البغوي وقال سكن المدينة ابو حدرد الاسلمي والد عبد الله تقدم حديثه في ترجمة ولده وقد تقدم في حرف النون من §  <> الاسماء في ترجمة ناجية وله حديثه اخر عند البخاري في الادب المفرد وقيل اسمه سلامة بن عمير بن ابي سلامة بن سعد بن مساب بكسر الميم وسكون المهملة بعدها همزة ممدودة واخره موحدة ضبطه ابو علي الجياني وقيل اسمه عبد مكبر بغير اضافة قاله احمد وقيل عبيد مصغر روي عن النبي صلي الله عليه وسلم روي عنه ابنه عم حمل بن بشر بن حدرد ومحمد بن ابراهيم التيمي ذكره العسكري ووقع في تهذيب المزي ان بن سعد ارخ وفاته سنة احدي وسبعين وتعقبه مغلطاي بان بن سعد انما ترجم عبد الله بن ابي حدرد وساق نسبه ثم ارخه وزاد وهو بن احدي وثمانين وكذا ارخه خليفة ويحيي بن بكير وغيرهما ابو حدرد اخر هو الحكم بن حزم الكلفي تقدم في الاسماء ابو حدرد اخر اسمه البراء ذكره بن عبد البر وقال لا اعرفه ابو حدرد ياتي في ابي حديرة ابو حذافة السهمي هو عبد الله بن حذافة بن قيس تقدم ابو حذيفة بن عتبة بن ربيعة بن عبد شمس بن عبد مناف القرشي العبشمي قال معاوية اسمه مهشم وقيل هشيم وقيل هاشم وقيل قيس كان من السابقين الي الاسلام وهاجر الهجرتين وصلي الي القبلتين قال بن اسحاق اسلم بعد ثلاثة واربعين انسانا وتقدم له ذكر في ترجمة سالم مولي ابي حذيفة وثبت ذكره في الصحيحين في قصة سالم من طريق الزهري عن عروة عن عاءشة رضي الله عنها ان ابا حذيفة بن عتبة كان ممن شهد بدرا يكني سالما قالوا كان طوالا حسن الوجه استشهد يوم اليمامة وهو بن ست وخمسين سنة ابو حذيفة الثقفي من ولد غياث بن مالك شهد بيعة الرضوان قاله المداءني استدركه بن فتحون ابو حرب بن خويلد بن عامر بن عقيل بن كعب بن ربيعة بن عامر بن صعصعة العامري العقيلي قال بن الكلبي كان فارسا في الجاهلية ثم اسلم ووفد علي النبي صلي الله عليه وسلم وسال ان قومه لا يعشروا ولا يحشروا فاجابه الي ذلك وفي شرح السيرة للقطب انه عرض عليه الاسلام فابي ثم اسلم بعد ذلك ابو حريز روي عنه ابو ليلي تقدم بيانه في حريز في الاسماء ابو حريزة بزيادة هاء في اخره قاله المستغفري له صحبة وذكره البخاري في الكني المفردة واورد له من طريق هشيم عن ابي اسحاق الكوفي وهو الشيباني عن ابي حريزة قال قال عبد الله بن سلام يا رسول الله نجدك في الكتب قاءما عند العرش محمرة وجنتاك خجلا مما احدثت امتك من بعدك واورد ابو احمد الحاكم هذا الحديث في ترجمة ابي حريز الذي قبل هذا والراجح انه غيره ابو حريش شهد ماعز بن مالك تقدم ذكره في ترجمة حريش ولده ابو حسان جد صالح بن حسان قال بن مندة له صحبة روي حديثه مجالد عن صالح §  <> بن حسان عن ابيه عن جده ان النبي صلي الله عليه وسلم خرج عليهم ابو حسان ويقال ابو حسن ويقال ابو حسين مولي بني نوفل قال عبد بن حميد حدثنا يعقوب بن ابراهيم حدثنا ابي عن صالح بن كيسان عن بن المنكدر حدثني ابو حسان مولي بني نوفل ان النبي صلي الله عليه وسلم قال انا سيد الناس يوم القيامة ولا فخر واخرج بن مندة من طريق عباس الدوري عن يعقوب بهذا السند فقال حدثني ابو حسين مولي بني نوفل واخرجه ابو نعيم من وجه اخر عن بن عباس فقال حدثنا ابو حسن وقد روي الزهري عن ابي حسن مولي بني نوفل عن بن عباس حديثا ونوفل منسوب الي ولاءه هو بن الحارث بن عبد المطلب فانه مولي بني عبد الله بن الحارث بن نوفل فان يكن كذلك فهو تابعي ويحتمل ان يكون منسوبا لنوفل بن عبد مناف ففيهم جد عثمان بن سعيد بن ابي حسين ابو الحسن علي بن ابي طالب بن عبد المطلب الهاشمي تقدم في الاسماء ابو حسن الانصاري ثم المازني جد يحيي بن عمارة بن ابي حسن مشهور بكنيته واسمه تميم بن عمرو وقيل بن عبد عمرو وقيل بن عبد قيس بن مخرمة بن الحارث بن ثعلبة بن مازن قال بن سكن بدري له صحبة وساق من طريق حسين بن عبد الله الهاشمي حدثنا عمرو بن يحيي بن عمارة بن ابي حسن عن ابيه عن جده ابي حسن وكان عقبيا بدريا ان رسول الله صلي الله عليه وسلم كان جالسا ومعه نفر من اصحابه فقام رجل ونسي نعليه فاخذهما اخر فوضعهما تحته فجاء الرجل فقال نعلي فقال القوم ما رايناهما فقال الرجل انا اخذتهما وكنت العب فقال النبي صلي الله عليه وسلم فكيف بروعة المءمن قالها ثلاثا واخرج عبد الله بن احمد في زيادات المسند من طريق الدراوردي حدثني عمرو بن يحيي عن يحيي بن عمارة عن ابيه قال دخلت الاسواق فاخذت دبسيين وامهما ترشرس عليهما فدخل علي ابو حسن فضربني وقال الم تعلم ان رسول الله صلي الله عليه وسلم حرم ما بين لابتي المدينة واخرجه الطبراني من طريق محمد بن فليح عن عمرو بن يحيي اخصر من هذا وقال فيه اذا دخل ابو حسن صاحب النبي صلي الله عليه وسلم فذكر الحديث قال الذهبي بقي الي زمن علي بن ابي طالب ابو الحسن رافع بن عمرو الطاءي تقدم في الاسماء ابو حسن مولي بني نوفل تقدم في ابي حسان ابو حسين بالتصغير تقدم فيه ايضا ابو الحشر بفتح اوله وسكون المعجمة بعدها راء ذكر قصة لابي بكر الصديق مع صهيب اخرجها بن ابي شيبة من طريق ابي الضحي عن مسروق قال مر صهيب بابي بكر فاعرض عنه فقال مالك اعرضت عني ابلغك شء تكرهه قال لا والله الا رءيا رايتها لك كرهتها قال وما رايت قال رايت يدك مغلولة الي عنقك علي باب رجل من الانصار يقال له ابو الحشر فقال ابو بكر نعم ما رايت جمع لي ديني الي يوم الحشر ابو حصيرة ذكر بن اسحاق ان النبي صلي الله عليه وسلم اعطاه من تمر خيبر واختلف §  <> في ضبطه فقيل بكسر الصاد المهملة وقيل بالضاد المعجمة ابو حصين العبسي اسمه لقمان تقدم في الاسماء ابو حصين السدوسي ذكره بن منده وقال روي حديثه نعيم عن عمه عن ابيه ابو حصين السلمي ذكره البغوي وذكر ان الواقدي اخرج عن عن عبد الله بن يحيي عن عمر بن الحكم عن جابر قال قدم ابو حصين السلمي بذهب من معدن فاتي به رسول الله صلي الله عليه وسلم قال فذكر حديثا طويلا ابو حصين الانصاري السالمي وقع ذكره في كتاب احكام القران لاسماعيل القاضي من طريق اسباط بن نصر عن السدي اسنده الي رجل من قومه ان ابا الحصين كان له ابنان فقدم تجار من الشام الي المدينة فتنصرا ولحقا معهم بالشام فاتي ابو الحصين النبي صلي الله عليه وسلم فذكر ذلك له فقال لا اكراه في الدين ولم يءمر يومءذ بقتال فوجد ابو الحصين في نفسه فنزلت فلا وربك لا يءمنون حتي يحكموك الاية وهكذا اخرجه الطبري من طريق اسباط عن السدي وذكر المزي في ترجمة جعفر بن محمد ان ابا داود اخرجه في كتاب الناسخ والمنسوخ عن جعفر بن محمد عن عمرو بن حماد عن اسباط بن نصر فذكر نحوه لكن قال نزلت في رجل من الانصار يقال له الحصين واخرج الطبري ايضا من طريق محمد بن اسحاق صاحب المغازي عن محمد بن ابي محمد عن عكرمة او سعيد بن جبير عن ابي عباس قال نزلت هذه الاية في رجل من الانصار يقال له الحصين من بني سالم بن عوف الحديث قلت وفي الرواة الحصين بن محمد السالمي سمع منه الزهري ووصفه بانه من سراة الانصار وحديثه عنه في الصحيح ولم يذكر من حدث به وذكر بن ابي حاتم ان روايته له انما هي عن عتبان بن مالك وكذا ذكره بن حبان في ثقات التابعين فلا يفسر به هذا الصحابي وان اشتركا في انهما من الانصار من بني سالم وقد تقدم الكلام فيه فيمن اسمه حصين من الاسماء بابسط من هذا ابو حفص عمر بن الخطاب امير المءمنين رضي الله عنه تقدم ابو حفص بن عمرو بن المغيرة المخزومي زوج فاطمة بنت قيس وقيل ابو عمرو بن حفص بن المغيرة وسياتي في العين ابو الحكم رافع بن سنان تقدم ابو الحكم بن سفيان الثقفي تقدم في الحكم بن سفيان ابو الحكم بن حبيب بن ربيعة بن عمرو بن عمير الثقفي ذكره المداءني في من استشهد مع ابي عبيد يوم الجسر ويقال لذلك اليوم يوم جسر الناطف قال المداءني اصيب يومءذ من ثقيف ثلاثماءة رجل مع امير الجيش ابي عبيد كان منهم ثمانون رجلا قد خضبوا الشيب فذكره واستدركه بن فتحون ابو حكيم القشيري جد بهز بن حكيم هو معاوية بن حيدة تقدم ابو حكيم بن مقرن المزني احد الاخوة اسمه عقيل تقدم §  <> ابو حكيم الكناني جد القعقاع بن حكيم ذكره البغوي في الصحابة وساق من طريق بن سمعان عن المقبري عن القعقاع بن حكيم عن جده وكان في حجر عاءشة رضي الله عنها قال فقلت لها سلي رسول الله صلي الله عليه وسلم عن الصلاة في النعلين وهو يطا بهما علي الاثار فقال ان التراب لهما طهور قال البغوي لم اجده الا عند بن سمعان وهو واهي الحديث ابو حكيم يزيد ويقال حكيم ابو يزيد حديثه في النصيحة تقدم في الاسماء ابو حكيم المزني قال الباوردي له صحبة وحديثه عند الحمصيين واخرج هو وابن السكن والطبراني من طريق ضمضم بن زرعة عن شريح بن عبيد قال زعم ابو حكيم ان النبي صلي الله عليه وسلم قال لو لم ينزل علي امتي الا سورة الكهف لكفاهم وله ذكر في اثر موقوف اخرجه عبد الرزاق من طريق عبد الله بن مرداس قال جاءني رجل يسالني فقلت عليك بعبد الله بن مسعود او بابي حكيم المزني فذكر قصة في صيام الجنب واخرجه الطبراني ايضا وهذا يدل علي انه كان مشهورا بالفتيا ابو حكيم ويقال ابو حكيمة عمرو بن ثعلبة تقدم في الاسماء ابو حلوة مولي العباس بن عبد المطلب ذكره الفاكهي في كتاب مكة من طريق بن جريج قال جاء مولي العباس الي النبي صلي الله عليه وسلم فقال انا ابو مرة مولي العباس قال بل انت ابو حلوة ابو حليمة باللام اسمه معاذ بن الحارث الانصاري القاري تقدم ذكره ابو حماد الانصاري ذكره البغوي ولم يخرج له شيءا وذكره ابو موسي وساق من طريق ابي الشيخ حديثا من رواية بن لهيعة عن واهب بن عبد الله عن عقبة بن عامر وابي حماد او ابي حامد الانصاري صاحبي رسول الله صلي الله عليه وسلم ان النبي صلي الله عليه وسلم قال من وجد مءمنا علي خطيءة فسترها كانت له كموءدة احياها قلت ابو حماد كنيته عقبة بن عامر فلولا قوله صاحبي رسول الله صلي الله عليه وسلم بالتثنية لجاز ان الواو سقطت ابو حماد عقبة بن عامر الجهني مشهور تقدم ابو حمامة ذكره البغوي في الصحابة وقال رايت بعض من الف في الصحابة ذكره ولا اعرف له اسما ولا سمعت له خبرا انتهي وقد ذكره بن الجارود في الصحابة ايضا واخرج له من طريق بن اسحاق عن يعقوب بن عتبة عن الحارث بن ابي بكر عن ابيه عن حمامة عن ابيه حديثا ابو الحمراء مولي النبي صلي الله عليه وسلم اسمه هلال بن الحارث ويقال بن ظفر نقله بن عيسي في تاريخ حمص تقدم في الاسماء قال البخاري يقال له صحبة ولا يصح حديثه ابو الحمراء اخر شهد بدرا واحدا ويقال له مولي عفراء ويقال مولي الحارث بن رفاعة ابو حمزة انس بن مالك خادم رسول الله صلي الله عليه وسلم مشهور تقدم في الاسماء ابو حمزة الانصاري الذي قال له النبي صلي الله عليه وسلم ابنك حمزة تقدم في §  <> حمزة من القسم الثاني من الحاء المهملة ابو حميد الساعدي الصحابي المشهور اسمه عبد الرحمن بن سعد ويقال عبد الرحمن بن عمرو بن سعد وقيل المنذر بن سعد بن المنذر وقيل اسم جده مالك وقيل هو عمرو بن سعد بن المنذر بن سعد بن خالد بن ثعلبة بن عمرو ويقال انه عم سهل بن سعد روي عن النبي صلي الله عليه وسلم عدة احاديث وله ذكر معه في الصحيحين روي عنه ولد ولده سعيد بن المنذر بن ابي حميد وجابر الصحابي وعباس بن سهل بن سعد وعبد الملك بن سعيد بن سويد وعمرو بن سليم وعروة ومحمد بن عمرو بن عطاء وغيرهم قال خليفة وابن سعد وغيرهما شهد احدا وما بعده وقال الواقدي توفي في اخر خلافة معاوية او اول خلافة يزيد بن معاوية ابو حميد او ابو حميدة علي الشك ذكره البلاذري في الصحابة واخرج حديثه الامام احمد في مسنده في تضاعيف حديث ابي حميد الساعدي قال احمد حدثنا حسن بن موسي وابو كامل قالا حدثنا زهير عن عبد الله بن عيسي عن موسي بن عبد بن يزيد عن ابي حميد او ابي حميدة شك زهير عن النبي صلي الله عليه وسلم قال اذا خطب احدكم امراة فلا جناح عليه ان ينظر اليها الحديث واستدركه بن فتحون والظاهر انه غير الساعدي اذ لو كان هو لم يشك زهير بن معاوية فيه ابو حميضة الانصاري السالمي اسمه معبد بن عباد تقدم ابو حميضة المزني ذكره بن السكن والعثماني وغيرهما في الصحابة وقال بن حبان له صحبة واخرج بن السكن والطبراني في مسند الشاميين من طريق نصر بن علقمة عن اخيه محفوظ عن بن عاءذ عن غضيف بن الحارث حدثني ابو حميضة المزني قال حضرنا طعاما مع رسول الله صلي الله عليه وسلم وهو يشتغل بحديث رجل او امراة فجعلنا ناكل ونقصر في الاكل فاقبل علينا النبي صلي الله عليه وسلم فاكل معنا ثم قال كلوا كما ياكل المءمنون فاخذ لقمة عظيمة ثم قال هكذا لقما خمسا او ستا ان كان مع ذلك شء والا شرب وقام قال بن السكن لم اجد له من الرواية الا هذا ابو حنش ذكره بن سعد في الصحابة وقال قيل له لا تسال الامارة كذا في التجريد ابو حنة بالنون كذا يقوله الواقدي وقد مضي قبل ابو حنة الانصاري اخو ابي حبة بن غزية بالموحدة ذكره بن ابي خيثمة ونقلته من خط مغلطاي ابو حنة اخر يقال اسمه مالك بن عامر او بن عمير تقدم ابو حوالة الازدي اسمه عبد الله بن حوالة تقدم ابو حيان تقدم في ترجمة حيان غير منسوب من حرف الحاء المهملة من الاسماء ابو حيوة الكندي او الحضرمي جد رجاء بن حيوة ذكره ابو نعيم واسند عن الطبراني بسند له عن خارجة بن مصعب عن رجاء بن حيوة عن ابيه عن جده ان جارية مرت علي النبي صلي الله عليه وسلم وهي تحج فقال لمن هذه قالوا لفلان قال ايطءها قالوا نعم قال وكيف يصنع بولده §  <> ايدعيه وليس به بولد او يستعبده وهو يعدو في سمعه وبصره ولقد هممت ان العنه لعنة تدخل معه في قبره ابو حية التميمي اسمه حابس تقدم في الاسماء القسم الثاني خال القسم الثالث ابو حديرة الاجذمي ويقال الجذامي ادرك النبي صلي الله عليه وسلم وشهد خطبة عمر بالجابية ذكره بن عساكر واخرج قصته من طريق يعقوب بن سفيان عن سعيد بن عقبة عن بن لهيعة عن يزيد بن حبيب ان ابا الخير حدثه ان عبد العزيز بن نبهان سال كريب بن ابرهة احضرت خطبة عمر قال لا قال فبعث الي سفيان بن وهب فقال قال عمر فحمد الله واثني عليه وقال اني اقسم هذا المال علي من افاء الله عليه بالعدل الا هذين الحيين من لخم وجذام فقام اليه ابو حديرة فقال انشدك الله في العدل يا عمر فقال القصة واخرجها مسدد في مسنده الكبير وابو عبيد في الاطول من رواية عبد الحميد بن جعفر عن يزيد عن سفيان بن وهب نحوه ابو الحصين الحنفي كان ممن ثبت علي الاسلام وفيه يقول بن المطرح الحنفي يخاطب ابا بكر الصديق رضي الله عنه لسنا نغرك من حنيفة انهم والراقصات الي مني كفار غيري وغير ابي الحصين عامر وابن السفين قد نشا ابرار ذكره وثيمة في كتاب الردة واستدركه بن فتحون ابو حناءة بفتح اوله والنون والمد وهمزة قبل الهاء بن ابي ازيهر الدوسي له ادراك وكان قتل ابي ازيهر بعد وقعه بدر في حياة النبي صلي الله عليه وسلم ولابي حناءة هذا بنت تسمي سمية تزوجها مجاشع بن مسعود وهي صاحبة القصة مع نصر بن حجاج القسم الرابع ابو حبيب العنبري ذكره الذهبي في التجريد وغاير بينه وبين جد الهرماس وهما واحد وقد عزاه في كل من الترجمتين لتخريج ابي موسي ولم اره في الذيل الا موضع واحد ابو حبيش الغفاري استدركه ابو موسي وانما هو بالخاء المعجمة والنون كما سياتي بيانه وقد ذكره بن منده علي الصواب §  <> ابو حزامة السعدي ذكره بن منده في الحاء المهملة والصواب بالمعجمة وسياتي ابو الحسن الراعي ذكره الذهبي في التجريد فقال كذاب ادعي الصحبة ولا وجود له تفرد منه علي بن عون شيخ روي عنه صدر الدين بن حمويه الجويني والمءيد محمد بن علي الحلبي فهو كذاب وقال في الميزان ابو الحسن بن نوفل الراعي قال حملت النبي صلي الله عليه وسلم ليلة انشق القمر قال علي بن عون لقيته بتركسان بعد الستماءة ابو حسنة الخزاعي ذكره بعضهم في الصحابة وهو خطا نشا عن تصحيف واسند من طريق ابي ضمرة انس بن عياض عن هشام بن عروة عن ابيه ان ابا حسنة الخزاعي صاحب البدن اخبره انه سال النبي صلي الله عليه وسلم عما يعطب من البدن قال الحافظ صالح جزرة صحفه ابو ضمرة تصحيفا عجيبا وذلك انه كان فيه ان ناجية الخزاعي فزيدت الف قبل ناجية ومدت الجيم فصارت ابا حسنة وقد تقدم الحديث علي الصواب في الاسماء في حرف النون ابو حفصة ذكره المستغفري في الصحابة وهو خطا نشا عن تصحيف وانقلاب فانه اورد من طريق شعبة عن المغيرة بن عبد الله قال جلست الي ابي حفصة فذكر حديث الرقوب والصواب ابو خصفة بفتح المعجمة وتقديم الصاد علي الفاء وفتحها وسياتي في الخاء المعجمة ان شاء الله تعالي ابو حكيم بن ابي يزيد الكرخي ذكره البغوي وقال لا اعلم روي حديثه الا عطاء بن الساءب ثم اورد من طريق حماد بن يزيد عن ابيه قلت وكنية هذا الصحابي ابو يزيد وسياتي واضحا في حرف الياء الاخيرة ولا يلزم من ان ابنه يسمي حكيما ان يكني هو ابا حكيم ولم يقع في رواية البغوي ولا غيره الا مكني ابا يزيد فذكره في حرف الحاء من الكني وهم ابو الحيسر بفتح اوله وسكون التحتانية بعدها مهملة مفتوحة ثم راء اسمه انس بن رافع تقدم في الاسماء ابو حيوة الصنابحي قال ابو موسي اورده ابو بكر بن ابي علي واورد له حديثا فصحف الاسم والنسبة معا وقال وانما هو ابو خيرة بخاء معجمة ثم راء والصباحي بموحدة بعد الصاد وبلا موحدة بعد الالف وسياتي في الخاء المعجمة علي الصواب ابو حية النميري ذكره الذهبي في التجريد وقال اسمه الهيثم بن الربيع قال بن ناصر له صحبة انتهي ولا اعرف له في ذلك سلفا بل لا صحبة لابي حية ولا رءية ولا ادراك قال المرزباني في معجم الشعراء وكانت بابي حية لوثة واختلاط كان ينزل البصرة وهو شاعر راجز مقصد كان ابو عمرو بن العلاء يقدمه وادرك ايام هشام بن عبد الملك وبقي الي ايام المنصور ثم المهدي ورثي المنصور لما مات وهو القاءل الا حي من اهل الحبيب المغانيا لبس البلي لما لبسن اللياليا اذا ما تقاضي المرء يوم وليلة تقاضاه شء لا يمل التقاضيا وعده محمد بن سلام الجمحي في طبقات الشعراء في طبقة بشار بن برد ودونه وقال ابو الفرح الاصبهاني ابو §  <> حية الهيثم بن ربيع بن زرارة بن كثير بن جناب بن كعب بن مالك بن عامر بن نمير بن عامر بن صعصعة النميري شاعر مجيد متقدم من مخضرمي الدولتين الاموية والعباسية وكان فصيحا راجزا مقصدا من ساكني البصرة وكان اهوج جبانا بخيلا كذابا معروفا بجميع ذلك قلت لعل مستند من عدة في الصحابة قول من وصفه بانه مخضرم وهو مستند باطل فان المخضرم الذي يذكره بعضهم في الصحابة هو الذي ادرك الجاهلية والاسلام والمخضرم ايضا من ادرك الدولتين الاموية والعباسية فابو حية من القسم الثاني لا من القسم الاول وقال ابو بكر بن ابي خيثمة حدثنا محمد بن سلام الجمحي قال كان لابي حية سيف يسميه لعاب المنية لا فرق بينه وبين الخشبة وكان اجبن الناس فحدثني جار له قال دخل بيته ليلة كلب فسمع حسه فظنه لصا فاشرفت عليه وقد انتضي سيفه لعاب المنية وهو يقول ايها المغتر بنا والمجتري علينا بءس والله ما اخترت لنفسك خير قليل وسيف صقيل اخرج بالعوف عنك قبل ان ادخل بالعقوبة عليك يقول هذا كله وهو واقف في وسط الدار فبينما هو كذلك اذ خرج الكلب فقال الحمد لله الذي مسخك كلبا وكفانا حربا وقال ابو محمد بن قتيبة كان ابو حية النميري من اكذب الناس فحدث يوما انه يخرج الي الصحراء فيدعو الغربان فتقع حوله فياخذ منها ما شاء فقيل له يا ابا حية ارايت ان اخرجناك الي الصحراء يوما فدعوت الغربان فلم تات ماذا نصنع بك قال ابعدها الله اذا قال وحدث يوما قال عن لي ظبي فرميته فراغ عن سهمي فعارضه السهم فراغه فعارضه فما زال والله يروغ ويعارضه حتي صرعه واسندها المبرد عن بن ابي جبيرة قال كان ابو حية النميري اكذب الناس وكان يروي عن الفرزدق فسمعته يوما يقول عن لي ظبي فرميته فراغ فذكر نحوه وقال الرقاشي عن الاصمعي وفد ابو حية النميري علي ابي جعفر المنصور وقد امتدحه وهجا بني حسن فوصله بشء دون ما امل فصار الي الحيرة فشرب عند خمارة واشتري منها شنة فذكر له معها قصة قبيحة وقال بن قتيبة لقي بن مناذر ابا حية النميري فقال له انشدني بعض شعرك فانشده فقال ما هذا اهذا شعر فقال ابو حية واي عيب فيه ما فيه عيب الا انك سمعته وقال ابو عبيد البكري في شرح امالي القالي ابو حية النميري شاعر اسلامي ادرك اواخر دولة بني امية واول دولة بني العباس ومات في اخر خلافة المنصور قلت وما تقدم عن المرزباني انه رثي المنصور يقتضي انه عاش الي خلافة المهدي كما قال وحكي المرزباني ان سلمة بن عياش العامري الشاعر قال لابي حية النميري اتدري ما يقول الناس قال وما يقولون قال يزعمون اني اشعر منك فقال انا لله هلك الناس وذكرها المرزباني ايضا فقال حدث من غير وجه عن سلمة بن عياش العامري من شعراء البصرة محمد بن سليمان بن علي قال قلت لابي حية فذكر مثله قلت وكانت امارة محمد بن سليمان من قبل المهدي فمن بعده وذلك في عشر السنين وماءة وبعد ذلك فهذه اقوال الاخباريين تظافرت علي ان ابا حية لا صحبة له ولا ادراك فهو المعتمد والله اعلم حرف الخاء المعجمة القسم الاول §  <> ابو خارجة عمرو بن قيس الخزرجي البدري تقدم في الاسماء ابو خالد حكيم بن حزام الاسدي ابو خالد يزيد بن ابي سفيان الاموي تقدما ابو خالد غير منسوب ذكره ابو احمد الحاكم عن البخاري وكذا المستغفري وقال صحابي وحديثه عند الاعمش عن مالك بن الحارث عن ابي خالد وكانت له صحبة قال وفدنا علي عمر بن الخطاب ففضل اهل الشام في الجاءزة علينا اخرجه بن ابي شيبة واستدركه ابو موسي ابو خالد الحارث بن قيس بن خلدة بن مخلد بن عامر بن زريق بن عبد حارثة بن مالك بن غضب بن جثم الانصاري الزرقي ذكره بن اسحاق وغيره فيمن شهد بدرا والعقبة وغير ذلك من المشاهد وذكر الواقدي من طريق ضمرة بن سعيد ان ابا خالد الزرقي جرح باليمامة جراحات فانتقضت عليه في خلافة عمر فمات ابو خالد الحارثي من بني الحارث بن سعد ذكره بن شاهين في الصحابة وساق من طريق ابراهيم بن بكير البلوي عن بثير بموحدة ثم مثلثة مصغرا بن ابي قسيمة السلامي بتشديد اللام اخبرني ابو خالد الحارثي من بني الحارث بن سعد قال قدمت علي رسول الله صلي الله عليه وسلم مهاجرا فوجدته يتجهز الي تبوك فخرجنا معه حتي جءنا الحجر من ارض ثمود فنهانا ان ندخل بيوتهم وان ننتفع بشء من مياههم فذكر الحديث بطوله وفيه انه اتي الي الحي بعد ان صلي الظهر مهجرا فوجد اصحابه عنده فقال ما زلتم تبكونه بعد وكان ماءه نزرا لا يملا الاداوة قال نسمي ذلك المكان تبوكا ثم استخرج مشقصا من كنانته فقال انزل فاغرسه وسم الله فنزل فغرسه فجاش عليه الماء وفي هذه القصة قال ابراهيم بن بكير جاءنا ابو عقال رجل من جذام كان يقال انه من الابدال فقال دلوني علي هذه البركة التي جاء اليها رسول الله صلي الله عليه وسلم وهو حسي لا يملا الاداوة فدعا الله فبجسها فخرجنا به حتي وقف عليها فقال نعم هي هي والله ان ماء انبطه جبراءيل وبرك فيه محمد صلي الله عليه وسلم لعظيم البركة قال فلم تزل علي ذلك حتي بعث عمر بن الخطاب بن عريض اليهودي فطواها قلت وفي سند هذا الحديث من لا نعرفه ابو خالد السلمي جد محمد بن خالد اورده البغوي في الكني واورد من طريق ابي المليح عن محمد بن خالد السلمي عن جده وكانت له صحبة فذكر حديثا وقيل اسمه زيد وقد تقدم بيان ذلك في الاسماء وسماه بن منده اللجلاج كما تقدم ولم اره في شء من الروايات سمي في غير ما ذكرت ابو خالد الكندي جد خالد بن معدان كذا اورده الحسن السمرقندي في الصحابة ولم يخرج له شيءا قاله ابو موسي ابو خالد القرشي المخزومي والد خالد روي ابنه خالد بن ابي خالد عن ابيه عن النبي صلي الله عليه وسلم في الطاعون ذكره في التجريد وقال له شء ابو خداش اللخمي له صحبة عداده في اهل الشام روي عنه عبد الله بن محيريز قوله §  <> هكذا ذكره بن منده مختصرا واورده بن السكن من طريق ثور بن يزيد عن عبد الله بن محيريز عن ابي خداش رجل من اصحاب النبي صلي الله عليه وسلم قال غزوت مع رسول الله صلي الله عليه وسلم فسمعته يقول المسلمون شركاء في ثلاث الماء والكلا والنار وسياتي في القسم الاخير ما قد يقدح في ثبوت هذه اللفظة وهي قوله رجل من اصحاب رسول الله صلي الله عليه وسلم ابو خراش بالراء هو حدرد بن ابي حدرد الاسلمي تقدم في الاسماء ابو خراش السلمي ذكره البغوي في الصحابة واخرج بن المقري عن حيوة عن الوليد بن ابي الوليد ان عمران بن ابي انس حدثه عن ابي خراش السلمي انه سمع النبي صلي الله عليه وسلم يقول من هجر اخاه سنة فهو كسفك دمه كذا وقع عنده السلمي وانما هو الاسلمي كذا رواه بن وهب عن حيوة ويقال انه حدرد بن ابي حدرد المذكور قبله ابو الخريف بن ساعدة تقدم في صيفي في الصاد المهملة ابو خزاعة نزل حمص حديثه عند كثير بن مرة ذكره في التجريد ابو خزامة احد بني الحارث بن سعد هذيم العذري حديثه عند الزهري عن بن ابي خزامة عن ابيه واسم ابي خزامة يعمر سماه مسلم وغيره قال سالت رسول الله صلي الله عليه وسلم ارايت رقي نرقي بها وادوية نتداوي بها الحديث ووقع في الكني لمسلم ابو خزامة بن يعمر وكذا قال يعقوب بن سفيان وقواه البيهقي وسماه من طريق اخري زيد بن الحارث وقال ابو عمر ذكره بعضهم في الصحابة لحديث اخطا فيه راوية عن الزهري وهو تابعي كانه جنح الي تقوية قول من قال عن ابي خزامة عن ابيه قال بن فتحون اخرج حديثه الباوردي والطبري من طريق بن قتيبة كما قال مسلم وكذا اخرجه الطبراني ايضا من طريق عبد الرحمن بن اسحاق عن الزهري وقيل عن الزهري عن ابي خزامة عن ابيه ورجحها بن عبد البر وستاتي الاشارة اليها في المبهمات وقد تقدم في الاسماء في خزامة وفي الحارث بن سعد وفي سعد هذيم بيان خطا جميع من سماه كذلك ابو خزامة رفاعة بن عرابة الجهني كناه خليفة بن خياط وقد تقدم في الاسماء ابو خزامة بن اوس بن اصرم بن زيد بن ثعلبة بن غنم الانصاري ذكره بن اسحاق فيمن شهد بدرا وذكره بن حبان في الصحابة لكن وجدته في النسخة التي بخط الحافظ ابي علي العسكري بياء بدل الالف قال ابو خزيمة وما اظنه الا من فساد النسخة التي نقل منها ابو خزيمة بن يربوع بن عمرو الانصاري ذكر العدوي انه شهد احدا وقيل يربوع اسمه وقد تقدم في الاسماء ابو خصفة بفتحات روي علي بن عبد الله المديني وعبدة بن عبد الله الصفار وغيرهما عن وهب بن جرير عن شعبة عن ميسرة بن عبد الله الجعفي قال جلست الي ابي خصفة فقال قال لنا رسول الله صلي الله عليه وسلم اتدرون ما الصعلوك قلنا الذي لا مال له قال الصعلوك الذي له المال لم يقدم منه شيءا قالها ثلاثا وفي رواية عنده السءال عن الرقوب وغير ذلك §  <> ابو خصيفة بالتصغير ذكره الطبراني في الصحابة واخرج من طريق يزيد بن عبد الملك النوفلي عن يزيد بن خصيفة عن ابيه عن جده ان رسول الله صلي الله عليه وسلم قال التمسوا الخير عند حسان الوجوه وبه ان رسول الله صلي الله عليه وسلم كان يقول اذا خرج احدكم من بيته فليقل لا حول ولا قوة الا بالله قلت ويزيد ضعيف وقال العلاءي شيخ شيوخنا في كتاب الوشي ان كان يزيد بن خصيفة هذا هو يزيد بن عبد الله بن خصيفة الثقة المشهور الراوي عن الساءب بن يزيد فلا اعرف لابيه ذكرا في اسماء الرواة ولا لجده خصيفة ذكرا في الصحابة ان كان غيره فلا اعرفه ولا اباه ولا جده قلت هو المشهور فقد ذكر المزي في التهذيب يزيد بن عبد الملك في الرواة عنه وذكر ان اسم والد خصيفة عبد الله بن يزيد وقيل هو خصيفة بن يزيد وعلي هذا فصحابي هذا الحديث هو خصيفة وقد ذكر المزي في ترجمة يزيد بن عبد الله بن خصيفة ان اسم والد خصيفة يزيد وقيل عبد الله بن يزيد بن سعيد بن ثمامة الكندي ابو الخطاب قال ابو عمر له صحبة ولا يوقف له علي اسم روي عنه حديث واحد في الوتر من رواية ابي ثوير بن ابي فاختة وتعقبه بن فتحون بان الصواب روي عنه ثوير وقال البغوي سكن الكوفة وقال ابو احمد الحاكم ذكره ابراهيم بن عبد الله الخزاعي فيمن غلبت عليهم الكني من الصحابة واخرج بن السكن وابن ابي خيثمة والبغوي وعبد الله بن احمد في كتاب السنة له والطبراني من طريق اسراءيل عن ثوير بن ابي فاختة سمعت رجلا من اصحاب رسول الله صلي الله عليه وسلم يقال له ابو الخطاب وسءل عن الوتر فقال احب الي ان اوتر اذ اصلي الي نصف الليل ان الله يهبط الي السماء الدنيا في الساعة السابعة فيقول هل من داع الحديث وفي اخره فاذا طلع الفجر ارتفع وفي رواية ابي احمد الزبيري عن الطبراني انه سال رسول الله صلي الله عليه وسلم عن الوتر ولم يرفعه غيره ابو خلاد هو الساءب بن خلاد تقدم في الاسماء ابو خلاد الرعيني هو عبد الرحمن بن زهير تقدم ابو خلاد غير منسوب روي عن النبي صلي الله عليه وسلم قال اذا رايتم الرجل قد اعطي زهدا في الدنيا الحديث وعنه ابو فروة الجزري وقيل بينهما ابو مريم ثم قال البخاري هذا اولي واخرجه البزار من طريق ابي فروة عن ابي خلاد وكانت له صحبة قال انما ادخلناه في المسند لقوله وكانت له صحبة مع انه لم يقل رايت ولا سمعت انتهي وقد اخرجه بن ابي عاصم من هذا الوجه فقال في سياقه سمعت النبي صلي الله عليه وسلم لكن وقع عنده عن ابي خالد والصواب عن ابي خلاد بتقديم اللام الثقيلة وزعم بن مندة انه الذي قبله فاخرجه بن ماجة وقال يقال اسمه عبد الرحمن بن زهير ابو خلف خادم النبي صلي الله عليه وسلم ذكر له الزمخشري في ربيع الابرار حديثا مرفوعا اذا مدح المنافق اهتز العرش وغضب الرب ذكره بغير اسناد واظنه سقط منه ذكر انس ابو خليد الفهري ويقال ابو خليدة ويقال ابو جنيدة تقدم في الجيم §  <> ابو خميصة هو معبد بن عباد بن قشير الانصاري تقدم في الاسماء ابو خناس خالد بن عبد العزيز الخزاعي تقدم في الاسماء ابو خنيس الغفاري لا يعرف اسمه قال بن السكن مخرج حديثه عن اهل بيته حديثه عند ابي بكر بن عمرو بن عبد الرحمن كذا ذكره عمرو بفتح العين والصواب عمر بضمها وهو بن عبد الرحمن بن عبد الله بن عمر من شيوخ مالك وبين ابي بكر وبين ابي خنيس راو اخر وقال الحاكم ابو احمد له صحبة واخرج من طريق الذهلي عن عبد الله بن رجاء عن سعيد بن سلمة عن ابي بكر بن عمر بن عبد الرحمن عن ابراهيم بن عبد الرحمن بن ابي ربيعة انه سمع ابو خنيس الغفاري يقول خرجت مع رسول الله صلي الله عليه وسلم في غزاة تهامة حتي اذا كنا بعسفان جاءه اصحابه فقال يا رسول الله جهدنا الجوع فاءذن لنا في الظهر ناكله الحديث في اشارة عمر بجمع الازواد ووقوع البركة ثم ارتحلوا فامطروا ونزلوا فشربوا من ماء السماء وهم بالكراع فخطبهم فاقبل ثلاثة نفر فجلس اثنان وذهب الثالث معرضا فقال الا اخبركم عن النفر الثلاثة الحديث قال الذهلي ابو بكر هذا هو بن عمر بن عبد الرحمن بن عبد الله بن عمر من شيوخ مالك قلت كذا نسبه بن ابي عاصم والدولابي في روايتيهما عن شيخين اخرين عن عبد الله بن رجاء وسند الحديث حسن وقد سمعناه بعلو في الثاني من امالي المحاملي رواية الاصبهانيين وشاهده في الصحيحين وله شاهد اخر عنه عند الحاكم عن انس ابو خيثمة الجعفي هو عبد الرحمن بن ابي سبرة تقدم ابو خيثمة الانصاري السالمي وقع ذكره في حديث كعب بن مالك الطويل في قصة توبته وفيه فلما كان بتبوك اذا شخص يزول به السراب فقال له النبي صلي الله عليه وسلم كن ابا خيثمة فاذا هو ابو خيثمة وقد قال الواقدي ان اسم ابي خيثمة هذا عبد الله بن خيثمة وانه شهد احدا وبقي الي خلافة يزيد بن معاوية ابو خيثمة الانصاري اخر اسمه مالك بن قيس قيل هو احد من تصدق بصاع فلمزه المنافقون وذكر بن الكلبي انه السالمي الذي قبله وان اسمه مالك بن قيس لا عبد الله بن خيثمة فالله اعلم ابو خيثمة الحارثي تقدم التنبيه عليه في الحاء المهملة ومن قال ان الصواب انه ابو حتمة بمهملة ثم مثناة فوقية ان الامر فيه علي الاحتمال والله اعلم ابو الخير الكندي هو الجفشيش تقدم في الاسماء ابو خيرة العبدي ثم الصباحي نسبة الي صباح بضم المهملة وتخفيف الموحدة واخره جاء مهملة بن لكيز بن افصي بطن من عبد القيس اخرج البخاري في التاريخ مختصرا وخليفة والدولابي والطبراني وابو احمد الحاكم من طريق داود بن المساور عن مقاتل بن همام عن ابي خيرة الصباحي قال كنت في الوفد الذين اتوا رسول الله صلي الله عليه وسلم من عبد القيس فزودنا الاراك نستاك به فقلنا يا رسول الله عندنا الجريد ولكن نقبل كرامتك وعطيتك فقال اللهم اغفر لعبد القيس اسلموا طاءعين غير مكرهين §  <> اذ قعد قوم لم يسلموا الا حرابا موتورين لفظ الطبراني وفي رواية الدولابي كنا اربعين رجلا واخرجه الخطيب في المءتلف وقال لا اعلم احدا سماه ابو خيرة اخر غير منسوب افرده الاشيري عن الصباحي وذكر له حديثا وقد اخرجه الطبراني لكن اورده في ترجمة الصباحي وعندي انه غيره قال عبد الله بن هشام بن حسان بن يزيد بن ابي خيرة حدثنا ابي عن ابيه عن ابي خيرة قال كانت لي ابل احمل عليها فاتيت النبي صلي الله عليه وسلم وشهدت خيبر او قال حنينا فكنا نحمل لهم الماء علي ابلنا الحديث وفيه فدعا لي رسول الله صلي الله عليه وسلم بالبركة ودعا لولدي القسم الثاني خال القسم الثالث ابو خراش الهذلي هو خويلد بن مرة تقدم في الاسماء ابو خرقاء العامري له ادراك فذكر ابو الفرج الاصبهاني في ترجمة ذي الرمة الشاعر من طريق محمد بن الحجاج التميمي قال حججت فلما صرت بمران جءت الي خرقاء صاحبة ذي الرمة فسلمت عليها فانتسبت لها فقالت انت بن الحجاج بن عمرو بن زيد قلت نعم قالت رحم الله اباك عاجلته المنية من اين اقبلت فقلت حججت قالت ان حجك ناقص اما سمعت قول عمك ذي الرمة تمام الحج ان تقف المطايا علي خرقاء واضعة اللثام قال وكانت قاعدة بفناء البيت كانها قاءمة من طولها بيضاء شهلاء ضخمة فسالتها عن سنها فقالت لا ادري الا اني ادركت شمر بن ذي الجوشن حين قتل الحسين وانا جارية صغيرة وكان ابي قد ادرك الجاهلية وحمل فيها حملات ابو الخيبري ادرك الجاهلية وروي عنه محرز مولي ابي هريرة قصة جرت له مع رفقة له عند قبر حاتم الطاءي رويناها في مكارم الاخلاق للخراءطي من طريق هشام بن الكلبي عن ابي مسكين عن جعفر بن محمد بن الوليد مولي ابي عذرة عن محرز بن ابي هريرة قال مر نفر عبد القيس بقبر حاتم فنزلوا قريبا منه فقام اليه بعضهم فضرب قبره برجله وهو يقول اقر فلما ناموا قام الرجل المذكور فزعا فقال رايت حاتما الطاءي فانشدني ابا الخيبري وانت امرء ظلوم العشيرة شتامها اتيت بصحبك تبغي القري لدي حفرة صخب هامها وتبغي لي الذنب عند المبيت وعندك طي وانعامها §  <> فانا سنشبع اضيافنا وتاتي المطي فنعتامها فاذا ناقته قد عقرت فنحروها وقالوا لقد قرانا حاتم حيا وميتا فلما اصبحوا اردفوا صاحبهم فاذا برجل ينوه بهم وهو راكب علي جمل يقود اخر فقال ايكم ابو الخيبري فقال انا قال ان حاتما اتاني في النوم فاخبرني انه قري اصحابك ناقتك وامرني ان احملك فهذا جمل فاركبه وذكرها ابو الفرج الاصبهاني في ترجمة حاتم الطاءي من الوجه المذكور وساقه من طريق هشام بن الكلبي حدثنا ابو مسكين عن جعفر بن محمد بن الوليد عن ابيه والوليد جده مولي ابي هريرة سمعت محرز بن ابي هريرة يقول كان رجل يقال له ابو الخيبري مر في نفر من قومه بقبر حاتم فبات ابو الخيبري ليلته ينادي به اقرا ضيافك فذكره وفيه فساروا ما شاء الله ثم نظروا الي راكب فاذا هو عدي بن حاتم فقال ان حاتما جاءني في النوم وانه قري راحلتك وقال في ذلك ابياتا رددها علي حتي حفظتها منه فذكرها وفيه وقد امرني ان احملك علي بعير فركبه وذهبوا القسم الرابع ابو خالد الكندي استدركه ابو موسي وقال ذكره ابو بكر بن ابي علي واورده من طريق ابي فروة سمعت ابا مريم سمعت ابا خالد الكندي سمعت رسول الله صلي الله عليه وسلم يقول اذا رايتم الرجل قد اعطي الزهادة في الدنيا الحديث وهذا حديث ابي خلاد الرعيني فوقع الوهم في كنيته ونسبه ابو خداش له صحبة روي عنه ابو عثمان قال كنا في غزوة فنزل الناس منزلا فقطعوا الطريق ونصبوا الحبال علي العلاء فلما راي ما صنعوا قال سبحان الله لقد غزوت مع رسول الله صلي الله عليه وسلم غزوات فسمعته يقول المسلمون شركاء في ثلاث الماء والنار والكلا هكذا ذكر بن منده واما ابو عمر فقال ابو خداش الشرعبي هو حبان بن زيد شامي لا يصح له صحبة وذكره بعضهم في الصحابة واشار الي الحديث وساق قال ورواه يزيد بن هارون وغيره عن حريز بن عثمان عن ابي خداش وسماه بعضهم حبان بن زيد الشرعبي وزاد عن رجل من اصحاب النبي صلي الله عليه وسلم قال وهذا هو الصحيح لا قول من قال عن ابي خداش عن النبي صلي الله عليه وسلم وقد روي ابو خداش هذا عن عمرو بن العاص قلت وقد رواه ابو اليمان عن حريز بن عثمان عن حبان يكني ابا خداش ان شيخا من شرعب نزل بارض الروم فذكر الحديث وهذا موافق لقول بن عبد البر وقد عاب بن الاثير علي بن مندة جعله هذا رجلين احدهما السلمي وهو الذي مضي في القسم الاول والثاني الشرعبي قال وحد ابو عمر بين الذي روي عنه ابو عثمان والذي روي عنه بن محيريز وهو الصواب وفرق بينهما بن منده ومن تبعه فقال جعل الاول شيخا من شرعب والاخر لخميا ولو عرف ان شرعب بطن من لخم لفعل كما فعل ابو عمر قلت §  <> لم يغاير بينهما من اجل شرعب ولخم وانما غاير بينهما لان الشرعبي ظهر من الروايات الاخري انه حبان بن زيد وهو بكسر اوله وتشديد الموحدة شامي تابعي معروف لا صحبة له وانما روي عن بعض الصحابة وارسل شيءا فهو غير الصحابي الذي يقال له ابو خالد السلمي وانما اتحد الحديث الذي روياه وقد رواه عمرو بن علي الفلاس عن يحيي القطان عن ثور بن زيد عن حريز عن ابي خداش عن رجل من اصحاب رسول الله صلي الله عليه وسلم قال غزوت مع رسول الله صلي الله عليه وسلم سبع غزوات او قال ثلاث غزوات قال عمرو بن علي فسالت عنه معاذ بن معاذ فحدثني به عن حريز بن عثمان عن حبان بن زيد الشرعبي عن رجل من اصحاب رسول الله صلي الله عليه وسلم قال عمرو علينا يزيد بن هارون فحدثنا به عن حريز اخرجه ابو احمد الحاكم في الكني من طريق الفلاس ثم اخرجه من طريق اسماعيل بن رجاء الزبيدي عن حريز عن ابي خداش عن رجل من اصحاب النبي صلي الله عليه وسلم واخرجه ابو داود في السنن عاليا عن علي بن الجعد عن حريز عن حبان عن رجل من قرن وعن مسدد عن عيسي بن يونس عن حريز عن ابي خداش عن رجل من المهاجرين فوضح بهذا ان ابا خداش اسمه حبان بن زيد الشرعبي وهو تابعي لا صحابي وانه حدث به عن صحابي غير مسمي واختلف في نسبته فقيل شرعبي وقيل قرني وقيل غير ذلك ابو خداش الشرعبي حبان بن زيد ذكره بعضهم في الصحابة وهو شامي ولا يصح له صحبة قاله بن عبد البر وهو كما قال ابو خراش الرعيني قال الذهبي اورد له بقي بن مخلد حديثا قلت وذكره بن منده في الصحابة وهو خطا فانه اخرج من طريق ابي نعيم عن عبد السلام بن حرب عن اسحاق بن ابي فروة عن ابي الخير عن ابي خراش الرعيني قال اسلمت وعندي اختان فاتيت النبي صلي الله عليه وسلم فذكرت ذلك له فقال طلق ايتهما شءت قلت وقع في السند نقص وتحريف فقد اخرجه بن ابي شيبة عن عبد السلام بن حرب علي الصواب فقال عن اسحاق عن ابي وهب الجيشاني عن ابي خراش عن الديلمي وهو فيروز والحديث معروف به والقصة مشهورة له وقد اخرجه بن ماجة في السنن عن ابي بكر بن ابي شيبة بهذا واخرجه ابو احمد الحاكم في الكني من طريق الحسين بن سنان الحراني عن عبد السلام بن حرب فسقط من سند بن منده ابو وهب واثبت ابا الخير عوض الجيشاني وسقط منه ايضا الصحابي واورد بن منده في ترجمة الرعيني رواية عمران بن عبد الله عن ابي خراش عن فضالة بن عبيد وهو وهم ايضا فقد فرق البخاري وابو احمد الحاكم بين الراوي عن فضالة فلم يقولا انه رعيني وبين الرعيني ويءيده قول بن يونس في تاريخ مصر لا يعرف لابي خراش ولا لعمران الراوي عنه غير هذا الحديث ابو خلف خادم النبي صلي الله عليه وسلم ذكر الزمخشري في ربيع الابرار عن ابي خلف خادم النبي صلي الله عليه وسلم عن النبي صلي الله عليه وسلم اذا مدح الفاسق اهتز العرش وغضب الرب وهكذا وقع عنده بغير اسناد وقد سقط منه انس والحديث المذكور عند ابي علي من طريق واهية عن ابي خلف الاعمي عن انس خادم النبي صلي الله عليه وسلم §  <> واخرج بن ماجة لابي خلف عن انس حديثا اخر حرف الدال المهملة القسم الاول ابو داود الانصاري المازني قيل اسمه عمرو وقيل عمير قال الدولابي سمعت بن البرقي يقول اسمه عمير بن عامر بن مالك بن خنساء بن مبذول بن عمرو بن غنم بن مازن بن النجار وحكي العسكري في التصحيف ان الجهني كان يقول انه ابو داود بتقديم الهمزة علي الالف وصححه بن الدباغ وكذا ابو علي الغساني في اوهام بن عبد البر ورده بن فتحون فان مسلما والنساءي والطبري وابن الجارود وابن السكن وابا احمد كنوه كلهم ابا داود بتقديم الالف علي الواو قلت هو المشهور وبه جزم بن اسحاق وخليفة وبه جاءت الرواية في الحديث المروي عنه وذكر بن اسحاق وغيره انه شهد بدرا وما بعدها واخرج احمد من طريق بن اسحاق عن ابيه عن رجل من بني مازن عن ابي داود قصة شهوده بدرا واخرج الدولابي من طريق جعفر بن حمزة بن ابي داود المازني عن ابيه عن جده وكان من اصحاب بدر قال خرجنا مع رسول الله صلي الله عليه وسلم حتي اتي مسجد ذي الحليفة فصلي اربع ركعات ثم اهل بالحج الحديث وذكر بن سعد عن الواقدي بسند له عن ام عمارة ان ابا داود المازني وسليط بن عمرو ذهبا يريدان ان يحضرا بيعة العقبة فوجدوهم قد بايعوا فبايعا بعد ذلك اسعد بن زرارة وكان راس النقباء ليلة العقبة ابو دجانة الانصاري اسمه سماك بن خرشة وقيل بن اوس بن خرشة متفق علي شهوده بدرا وقال علي انه استشهد باليمامة واسند بن اسحاق من طريق يزيد بن السكن ان رسول الله صلي الله عليه وسلم لما التحم القتال ذب عنه مصعب بن عمير يعني يوم احد حتي قتل وابو دجانة سماك بن خرشة حتي كثرت فيه الجراحة وقيل انه ممن شارك في قتل مسيلمة وثبت ذكره في الصحيح لمسلم من طريق حماد بن سلمة عن ثابت عن انس ان النبي صلي الله عليه وسلم اخذ سيفا يوم احد فقال من ياخذ هذا السيف بحقه فاخذه ابو دجانة ففلق به هام المشركين واخرج الدولابي في الكني من طريق عبيد الله بن الوازع عن هشام بن عروة عن ابيه قال قال الزبير بن العوام عرض النبي صلي الله عليه وسلم يوم احد سيفا فقال من ياخذ هذا السيف بحقه فقام ابو دجانة سماك بن خرشة فقال انا فما حقه قال لا تقتل به مسلما ولا تفر به من كافر ابو الدحداح الانصاري حليف لهم قال ابو عمر لم اقف علي اسمه ولا نسبه اكثر من انه من الانصار حليف لهم وقال البغوي ابو الدحداح الانصاري ولم يزد وروي احمد والبغوي §  <> والحاكم من طريق حماد بن سلمة عن ثابت عن انس ان رجلا قال يا رسول ان لفلان نخلة وانا اقيم حاءطي بها فامره ان يعطيني حتي اقيم حاءطي بها فقال له النبي صلي الله عليه وسلم اعطه اياها بنخلة في الجنة فابي قال فاتاه ابو الدحداح فقال له بعني نخلتك بحاءطي قال ففعل فاتي النبي صلي الله عليه وسلم فقال يا رسول الله ابتعت النخلة بحاءطي فاجعلها له فقد اعطيتكها فقال كم من عذق رداح لابي الدحداح في الجنة قالها مرارا قال فاتي امراته فقال يا ام الدحداح اخرجي من الحاءط فاني قد بعته بنخلة في الجنة فقالت ربح البيع او كلمة تشبهها وقد وقع لنا بعلو في مسند عبد بن حميد من حديث جابر بن سمرة صلي النبي صلي الله عليه وسلم علي ابي الدحداح ثم اتي بغرس الحديث وفي اخره كم من عذق لابي الدحداح اخرجه هكذا عن حجاج بن محمد عن شعبة عن سماك عنه واخرجه ايضا عن محمد بن جعفر عن شعبة فقال عن ابي الدحداح واخرجه مسلم عن بندار عن محمد بن جعفر فقال عن ابي الدحداح واخرج بن منده من طريق عبد الله بن الحارث عن بن مسعود لما نزلت من ذا الذي يقرض الله قرضا حسنا فيضاعفه له فقال ابو الدحداح يا رسول الله والله يريد منا القرض قال نعم الحديث وفيه ذكر ما تصدق به وروي من طريق عقيل عن بن شهاب مرسلا بمعناه وقد تقدم في ترجمة ثابت بن الدحداح انه يكني ابا الدحداح وانه مات في حياة النبي صلي الله عليه وسلم فبني ابو عمر علي انه هذا والحق انه غيره وذكر بن اسحاق عن محمد بن يحيي بن حبان عن عمه واسع بن حبان قال هلك ابو الدحداح وكان اتيا فيهم يعني الانصار فدعا النبي صلي الله عليه وسلم عاصم بن عدي فقال هل كان له فيكم نسب فقال لا فاعطي ميراثه بن اخيه ابا لبابة بن عبد المنذر وهذا ينبغي ان يكون لثابت فقد تقدم في ترجمته انه جرح باحد فقيل مات بها وقيل عاش ثم اتنقضت فمات بعد ذلك بمدة وهو الراجح واما صاحب الترجمة فعاش الي زمن معاوية فاخرج ابو نعيم من طريق فضيل بن عياض عن سفيان عن عوف بن ابي جحيفة عن ابيه ان ابا الدحداح قال لمعاوية سمعت رسول الله صلي الله عليه وسلم يقول من كانت الدنيا همته حرم الله عليه جواري فاني بعثت بخراب الدنيا ولم ابعث بعمارتها قلت ولا يصح سنده الي فضيل فقد اخرجه الطبراني اتم من هذا عن جبرون بن عيسي عن يحيي بن سليمان عن فضيل وجبرون واهي الحديث ابو الدحداح ويقال ابو الدحداحة اسمه ثابت تقدم في الاسماء وزعم مقاتل بن سليمان ان اسمه عمر ابو الدرداء الانصاري واسمه عويمر تقدم وقيل اسمه عامر وعويمر لقب ابو درة البلوي ذكره بن يونس وقال له صحبة وشهد فتح مصر ولا تعرف له رواية وقال علي بن قديد رايت علي باب داره هذه دار ابي درة البلوي صاحب رسول الله صلي الله عليه وسلم ابو الدنيا غير منسوب ذكره مطين في الصحابة واخرج عن محمد بن اسماعيل عن هشام بن عمار عن صدقة بن خالد عن عمر بن قيس عن عطاء عن ابي الدنيا قال قال النبي صلي الله عليه وسلم من اتي الجمعة فليغتسل قال هشام بن عمار ابو الدنيا هذا معروف من اصحاب النبي صلي الله §  <> عليه وسلم وكذا اخرجه البغوي عن هشام واخرج بن مندة من طريق الوليد بن مسلم عن عمر بن قيس لكن قال في المتن غسل الجمعة واجب علي كل محتلم وقال ابو نعيم هذا هو الصواب واللفظ الاول خطا وقال الدارقطني في العلل رواه محمد بن بكر البرساني عن عمر بن عطاء عن ابي الدرداء وقال صدقة بن خالد عن عمر عن عطاء عن ابي الدنيا وهو تصحيف كذا قال وقال ابو بشر الدولابي في الكني غلط فيه هشام بن عمار واخرج الخطيب في الكفاية من طريق احمد بن علي الابار قال قلت لهشام بن عمار حدثك صدقة بن خالد فساق الحديث فقال نعم قال الابار رايته في حديث اهل حمص عن عمر بن قيس عن عطاء عن ابي الدرداء واظنه التزق في كتابه فصار عن ابي الدنيا اي التزقت الراء في الدال انتهي وطريق الوليد بن مسلم المذكورة ترد علي هءلاء ويبقي الجزم بكونه تصحيفا القسم الثاني لم يذكر فيه احد من الرجال القسم الثالث ابو الدهماء البناني ادرك النبي صلي الله عليه وسلم ووفد علي عمر فساله ان يرد بني بنانة في قريش وكانوا ناوا عنهم الي بني شيبان وكان ابو الدهماء سيدهم فقال له عمر ما اعرف هذا فاخبره عثمان بصحة قولهم فقال لهم ارجعوا الي من قابل فقتل سيدهم بن الدهماء فلما كان في خلافة عثمان اتوه فاثبتهم في قريش فلما قتل عثمان ردوا الي بني شيبان وفي ذلك يقول عبد الرحمن بن حسان ضرب التجيبي المضلل ضربة ردت بنانة في بني شيبان يعني حيث قتل عثمان ذكر ذلك كله البلاذري وذكر الزبير بن بكار بعضه وقال في روايته ان عثمان قال رايت ابي يسلم عليهم فسالته عنهم فقال هءلاء قومنا شدوا عنا من بني لءي بن غالب القسم الرابع ابو الدرداء غير منسوب قد ارسل حديثا فذكره بعضهم في الصحابة فوهم فاخرج بن ابي الدنيا والبيهقي في الشعب من طريقه بسنده الي ابي الدرداء الرهاوي قال قال رسول الله صلي الله عليه وسلم احذروا الدنيا فانها اسحر من هارون وماروت الحديث قال البيهقي قال بعضهم عن ابي الدرداء الرهاوي عن رجل من الصحابة وقال الذهبي لا ندري من ابو الدرداء والخبر منكر لا اصل له ابو الديلمي ذكره البغوي واظن ان الصواب بن الديلمي وهو فيروز الماضي في الفاء قال البغوي شامي لم ينسب ثم ساق من طريق عروة بن رويم عن ابي ادريس الخولاني عن ابي الديلمي §  <> قال قال رسول الله صلي الله عليه وسلم ان افضل العبادة حسن الظن بالله قال يقول الله عز وجل انا عند ظن عبدي بي حرف الذال المعجمة القسم الاول ابو ذباب المذحجي من سعد العشيرة قال ابو عمر له في اسلامه خبر ظريف حسن وكان شاعرا وهو والد عبد الله بن ابي ذباب وذكره ابو موسي في الذيل فقال ذكره الحسن بن احمد السمرقندي في الصحابة وقال ابو ذباب السعدي لم يزد واورد ابو موسي من طريق عمارة بن زيد حدثني بكر بن خارجة حدثني ابي عن عاصم بن عمر بن قتادة عن عبد الله بن ابي ذباب عن ابيه قال كنت امرا مولعا بالصيد فذكر قصة الي ان قال وفدت علي النبي صلي الله عليه وسلم فاتيته يوم جمعة فكنت استقبل منبره فصعد يخطب فقال بعد ان حمد الله واثني عليه اني لرسول الله اليكم بالايات البينات وان اسفل منبري هذا لرجل من سعد العشيرة قدم يريد الاسلام ولم اره قط ولم يرني الا في ساعتي هذه وسيحدثكم بعد ان اصلي عجبا قال فصلي وقد مليت منه عجبا فلما صلي قال لي ادن يا اخا سعد العشيرة حدثنا خبرك وخبر صافي وقراط يعني كلبه وصنمه قال فقمت علي قدمي فحدثته حديثي حتي اتيت علي اخره فرايت وجه رسول الله صلي الله عليه وسلم كانه للسرور مذهب فدعاني الي الاسلام وقرا علي القران فاسلمت الحديث وكذا اخرجه ابو سعد النيسابوري في شرف المصطفي مطولا وفي اخره ثم استاذنته في القدوم علي قومي فاتيتهم ورغبتهم في الاسلام فاسلموا فاتيت بهم النبي صلي الله عليه وسلم وفي ذلك اقول تبعت رسول الله اذ جاء بالهدي وخلفت قراطا بدار هوان فمن مبلغ سعد العشيرة انني شريت الذي يبقي بما هو فان ابو ذباب اخر ذكره الفاكهي من طريق محمد بن يعقوب بن عتبة عن ابيه عن الحارث بن ابي ذباب عن ابيه العباس انشد النبي صلي الله عليه وسلم قول قصي بن كلاب انا بن العاصمين بني لءي بمكة مولدي وبها ربيت لي البطحاء قد علمت معد وبرزتها رضيت بها رضيت فلست بغالب ان لم تامل بها اولاد قيذر والنبيت ابو ذر الغفاري الزاهد المشهور الصادق اللهجة مختلف في اسمه واسم ابيه والمشهور انه جندب بن جنادة بن سكن وقيل بن عبد الله وقيل اسمه بربر وقيل بالتصغير والاختلاف في ابيه كذلك §  <> الا في السكن قيل يزيد وعرفة وقيل اسمه هو السكن بن جنادة بن قيس بن بن عمرو بن مليل بلامين مصغرا بن صعير بمهملتين مصغرا بن حرام بمهملتين بن غفار وقيل اسم جده سفيان بن عبيد بن حرام بن غفار واسم امه رملة بنت الوقيعة غفارية ايضا ويقال انه اخو عمرو بن عبسة لامه وقع في رواية لابن ماجة ان النبي صلي الله عليه وسلم قال لابي ذر يا جنيدب بالتصغير وهذا الاختلاف في اسمه واسم ابيه اسنده كله بن عساكر الي قاءليه وقال هو ان بريرا تصحيف بريق وكذا زيد ويزيد وعرفة وكان من السابقين الي الاسلام وقصة اسلامه في الصحيحين علي صفتين بينهما اختلاف ظاهر فعند البخاري من طريق ابي حمزة عن بن عباس قال لما بلغ ابا ذر مبعث النبي صلي الله عليه وسلم قال لاخيه اركب الي هذا الوادي فاعلم لي علم هذا الرجل الذي يزعم انه نبي ياتيه الخبر من السماء واسمع من قوله ثم اءتني فانطلق الاخ حتي قدم وسمع من قوله ثم رجع الي ابا ذر فقال له رايته يامر بمكارم الاخلاق ويقول كلاما ما هو بالشعر فقال ما شفيتني مما اردت فتزود وحمل شنة فيها ماء حتي قدم مكة فاتي المسجد فالتمس النبي صلي الله عليه وسلم وهو لا يعرفه وكره ان يسال عنه حتي ادركه بعض الليل فاضطج فراه علي فعرف انه غريب فلما راه تبعه فلم يسال واحد منهما صاحبه عن شء حتي اصبح ثم احتمل قربته وزاده الي المسجد وظل ذلك اليوم ولا يري النبي صلي الله عليه وسلم حتي امسي فعاد الي مضجعه فمر به علي فقال اما ان للرجل ان يعرف منزله فاقامه فذهب به معه لا يسال احدهما صاحبه عن شء حتي كان اليوم الثالث فعل مثل ذلك فاقامه فقال الا تحدثني ما الذي اقدمك قال ان اعطيتني عهدا وميثاقا ان ترشدني فعلت ففعل فاخبره فقال انه حق وانه رسول الله صلي الله عليه وسلم فاذا اصبحت فاتبعني فاني ان رايت شيءا اخافه عليك قمت كاني اريق الماء فان مضيت فاتبعني حتي تدخل مدخلي ففعل فانطلق يقفوه حتي دخل علي النبي صلي الله عليه وسلم ودخل معه وسمع من قوله فاسلم مكانه فقال له النبي صلي الله عليه وسلم ارجع الي قومك فاخبرهم حتي ياتيك امري فقال والذي نفسي بيده لاصرخن بها بين ظهرانيهم فخرج حتي اتي المسجد فنادي باعلي صوته اشهد ان لا اله الا الله وان محمدا عبده ورسوله فقام القوم اليه فضربوه حتي اضجعوه واتي العباس فاكب عليه وقال ويلكم الستم تعلمون انه من غفار وانه من طريق تجارتكم الي الشام فانقذه منهم ثم عاد من الغد لمثلها فضربوه وثاروا اليه فاكب العباس عليه وعند مسلم من طريق عبد الله بن الصامت عن ابي ذر في قصة اسلامه وفي اوله صليت قبل ان يبعث النبي صلي الله عليه وسلم حيث وجهني الله وكنا نزلا مع امنا علي خال لنا فاتاه رجل فقال له ان انيسا يخلفك في اهلك فبلغ اخي فقال والله لا اساكنك فارتحلنا فانطلق اخي فاتي مكة ثم قال لي اتيت مكة فرايت رجلا يسميه الناس الصابء هو اشبه الناس بك قال فاتيت مكة فرايت رجلا فقلت اين الصابء فرفع صوته علي فقال صابء صابء فرماني الناس حتي كاني نصب احمر فاختبات بين الكعبة وبين استارها ولبثت فيها بين خمس عشرة من يوم وليلة ما لي طعام ولا شراب الا ماء زمزم قال ولقينا رسول الله صلي الله عليه وسلم وابو بكر وقد دخلا المسجد فوالله اني لاول الناس حياة بتحية الاسلام فقلت السلام عليك يا رسول الله فقال وعليك السلام ورحمة الله من انت فقلت رجل من بني غفار فقال صاحبه اءذن لي يا رسول الله في ضيافته §  <> الليلة فانطلق بي الي دار في اسفل مكة فقبض لي قبضات من زبيب قال فقدمت علي اخي فاخبرته اني اسلمت قال فاني علي دينك فانطلقنا الي امنا فقالت فاني علي دينكما قال واتيت قومي فدعوتهم فتبعني بعضهم وروينا في قصة اسلامه خبرا ثالثا تقدمت الاشارة اليه في ترجمة اخيه انيس ويقال ان اسلامه كان بعد اربعة وانصرف الي بلاد قومه فاقام بها حتي قدم رسول الله صلي الله عليه وسلم المدينة ومضت بدر واحد ولم تتهيا له الهجرة الا بعد ذلك وكان طويلا اسمر اللون نحيفا وقال ابو قلابة عن رجل من بني عامر دخلت مسجد مني فاذا شيخ معروق ادم عليه حلة قطري فعرفت انه ابو ذر بالنعت وفي مسند يعقوب بن شيبة من رواية سلمة بن الاكوع ان ابا ذر كان طويلا واخرج الطبراني من حديث ابي الدرداء قال كان رسول الله صلي الله عليه وسلم يبتدء ابا ذر اذا حضر ويتفقده اذا غاب واخرج احمد من طريق عراك بن مالك قال قال ابو ذر سمعت رسول الله صلي الله عليه وسلم يقول ان اقربكم مني مجلسا يوم القيامة من خرج من الدنيا كهيءته يوم تركته فيها وانه والله ما منكم من احد الا وقد نشب فيها بشء غيري رجاله ثقات الا ان عراك بن مالك عن ابي ذر منقطع وقد اخرج ابو يعلي معناه من وجه اخر عن ابي ذر متصلا لكن سنده ضعيف قال الامام احمد في كتاب الزهد حدثنا يزيد بن هارون حدثنا محمد بن عمرو سمعت عراك بن مالك يقول قال ابو ذر اني لاقربكم مجلسا من رسول الله صلي الله عليه وسلم يوم القيامة وذلك اني سمعت رسول الله صلي الله عليه وسلم يقول اقربكم مني مجلسا يوم القيامة من خرج من الدنيا كهيءته يوم تركته فيها وانه والله ما منكم من احد الا وقد نشب فيها بشء غيري وهكذا اورده في المسند واظنه منقطعا لان عراكا لم يسمع من ابي ذر روي ابو ذر عن النبي صلي الله عليه وسلم روي عنه انس وابن عباس وابو ادريس الخولاني وزيد بن وهب الجهني والاحنف بن قيس وجبير بن نفير وعبد الرحمن بن تميم وسعيد بن المسيب وخالد بن وهبان بن خالة ابي ذر ويقال بن اهبان وقيل بن اخيه وامراة ابي ذر وعبد الله بن الصامت وخرشة بن الحر وزيد بن ظبيان وابو اسماء الرحبي وابو عثمان النهدي وابو الاسود الدءلي والمعرور بن سويد ويزيد بن شريك وابو مراوح الغفاري وعبد الرحمن بن ابي ليلي وعبد الرحمن بن حجيرة وعبد الرحمن بن شماسة وعطاء بن يسار واخرون قال ابو اسحاق السبيعي عن هانء بن هانء عن علي ابو ذر وعاء ملء علما ثم اوكء عليه اخرجه ابو داود بسند جيد واخرجه ابو داود ايضا واحمد عن عبد الله بن عمرو سمعت رسول الله صلي الله عليه وسلم يقول ما اقلت الغبراء ولا اظلت الخضراء اصدق لهجة من ابي ذر وفي الباب عن علي وابي الدرداء وابي هريرة وجابر وابي ذر طرقها بن عساكر في ترجمته وقال الاجري عن ابي داود لم يشهد بدرا ولكن عمر الحقه بهم وكان يوازي بن مسعود في العلم وفي السيرة النبوية لابن اسحاق بسند ضعيف عن بن مسعود قال كان لا يزال يتخلف الرجل في تبوك فيقولون يا رسول الله تخلف فلان فيقول دعوه فان يكن فيه خير فسيلحقه الله بكم وان يكن غير ذلك فقد اراحكم الله منه فتلوم ابو ذر علي بعيره فابطا عليه فاخذ متاعه علي ظهره ثم خرج ماشيا فنظر ناظر من المسلمين فقال ان هذا الرجل يمشي علي الطريق فقال رسول الله صلي الله عليه وسلم كن ابا ذر فلما تاملت القوم قالوا يا رسول الله هو والله ابو ذر فقال يرحم الله ابا ذر يعيش وحده ويموت وحده ويحشر وحده فذكر قصة موته وفي وكانت §  <> وفاته بالربذة سنة احدي وثلاثين وقيل في التي بعدها وعليه الاكثر ويقال انه صلي عليه عبد الله بن مسعود في قصة رويت بسند لا باس به وقال المداءني انه صلي عليه بن مسعود بالربذة ثم قدم المدينة فمات بعده بقليل ابو ذر اخر ذكر الذهبي في التجريد ان له عند بقي بن مخلد حديثا ويحتمل ان يكون الذي بعده ابو ذرة بن معاذ بن زرارة الانصاري الظفري يقال اسمه الحارث قال الطبري شهد هو وابوه واخوه وابو نملة احدا قلت وهو اخو ابي نملة شقيقه ذكره ابو احمد الحاكم وسياتي نسبه في ترجمة ابي نملة ابو ذرة الحرمازي ذكره الدولابي واسمه نضلة بن طريف بن نهصل وقد تقدم في الاسماء القسم الثاني خال القسم الثالث ابو ذءيب الهذلي الشاعر المشهور اسمه خويلد بن خالد بن محرث بمهملة وراء ثقيلة مكسورة ومثلثة بن ربيد براء مهملة وموحدة مصغرا بن مخزوم بن صاهلة ويقال اسمه خالد بن خويلد وباقي النسب سواء يجتمع مع بن مسعود في مخزوم وبقية نسبه في ترجمة بن مسعود وذكر محمد بن سلام الجمحي في طبقات الشعراء عن يونس بن عبيد عن ابي عمرو بن العلاء انه قال قلت لعمر بن معاذ من اشعر الناس فذكر قصة فيها وابو ذءيب خويلد بن خالد مات في مغزي له نحو المغرب فدلاه عبد الله بن الزبير في حفرته قال ابو عمر وسءل حسان بن ثابت من اشعر الناس قال رجلا او قبيلة قالوا قبيلة قال هذيل قال بن سلام فاقول ان اشعر هذيل ابو ذءيب وقال عمر بن شيبة كان مقدما علي جميع شعراء هذيل بقصيدته يقول فيها §  <> والنفس راغبة اذا رغبتها واذا ترد الي قليل تقنع وقال المرزباني كان فصيحا كثير الغريب متمكنا في الشعر وعاش في الجاهلية دهرا وادرك الاسلام فاسلم وعامة ما قال من الشعر في اسلامه وكان اصاب الطاعون خمسة من اولاده فماتوا في عام واحد وكانوا رجالا ولهم باس ونجدة فقال في قصيدته التي اولها امن المنون وريبها تتوجع والدهر ليس بمعتب من يجزع ويقول فيها وتجلدي للشامتين اريهم اني لريب الدهر لا اتضعضع واذا المنية انشبت اظفارها القيت كل تميمة لا تنفع والنفس راغبة اذا رغبتها واذا ترد الي قليل تقنع واخرج بن منده من طريق البلوي عن عمارة بن زيد عن ابراهيم بن سعد حدثنا ابو الاكام الهذلي عن الهرماس بن صعصعة الهذلي عن ابيه حدثني ابو ذءيب الشاعر قال قدمت المدينة ولاهلها ضجيج بالبكاء كضجيج الحجيج واذا اهلوا جميعا بالاحرام فقلت مه فقالوا قبض رسول الله صلي الله عليه وسلم وذكر بن عبد البر ان بن اسحاق روي هذا الخبر عن ابي الاكام واوله بلغنا ان رسول الله صلي الله عليه وسلم عليل فاستشعرت حربا وبت باطول ليلة لا ينجاب ديجورها ولا يطلع نورها حتي اذا كان قرب السحر اغفيت فهتف بي هاتف يقول خطب اجل اناخ بالاسلام بين النخيل ومعقل الاطام قضي النبي محمد فعيوننا تذري الدموع عليه بالتسجام قال فوثبت من نومي فزعا الي السماء فلم ار الا سعد الذابح فتفاءلت به ذبحا يقع في العرب وعلمت ان النبي صلي الله عليه وسلم قد مات فركبت ناقتي فسرت فذكر قصته وفيه انه وجد النبي صلي الله عليه وسلم ميتا ولم يغسل بعد وقد خلا به اهله وذكر شهوده سقيفة بني ساعدة وسماعه خطبة ابي بكر وساق قصيدة له رثي بها النبي صلي الله عليه وسلم كسفت لمصرعه النجوم وبدرها وتزعزعت اطام بطن الابطح قال ثم انصرف ابو ذءيب الي باديته فاقام حتي توفي في خلافة عثمان بطريق مكة وقال غيره مات في طريق افريقية في زمن عثمان وكان غزاها ورافق بن الزبير وقيل مات غازيا بارض الروم وقال المرزباني هلك بافريقية في زمن عثمان ويقال انه هلك في طريق مصر فتولاه بن الزبير وقال بن البرقي حدث معروف بن خربوذ اخبرني ابو الطفيل ان عمرو بن الحمق صاحب رسول الله صلي الله عليه وسلم زعم ان في بعض الكتب ان شر الارضين ام صبار حرة بني سليم وان الام القباءل محارب خصفة وان اشعر الناس ابو ذءيب وقال حدث ابو الحارث عبد الله بن عبد الرحمن بن سفيان الهذلي عن ابيه ان ابا ذءيب جاء الي عمر في خلافته فقال يا امير المءمنين اي العمل افضل قال الايمان بالله قال قد فعلت فاي العمل بعده افضل قال الجهاد في سبيل الله قال ذلك كان علي ولا ارجو جنة لا اخشي نارا فتوجه من تلقاء فوره غازيا هو وابنه وابن اخيه ابو عبيد حتي ادركه الموت في بلاد الروم والجيش يساقون في ارض عاقة فقال لابنه وابن اخيه انكما لا تتركان علي جميعا فاقترعا فصارت القرعة لابي عبيد فاقام عليه حتي واراه القسم الرابع خال حرف الراء §  <> القسم الاول ابو راشد الازدي هو عبد الرحمن بن عبيد مضي في الاسماء ابو راشد اخر ياتي في ابي مليكة ابو رافع القبطي مولي رسول الله صلي الله عليه وسلم يقال اسمه ابراهيم ويقال اسلم وقيل سنان وقيل يسار وقيل صالح وقيل عبد الرحمن وقيل قزمان وقيل يزيد وقيل ثابت وقيل هرمز قال بن عبد البر اشهر ما قيل في اسمه اسلم وقال يحيي بن معين اسمه ابراهيم وقال مصعب الزبيري اسمه ابراهيم ولقبه برية وهو تصغير ابراهيم ونقل بن شاهين عن ابي داود انه كان اسمه قزمان فسمي بعده ابراهيم وقيل اسلم وزاد بن حبان وقيل يسار وقيل هرمز وقيل كان مولي العباس بن عبد المطلب فوهبه للنبي صلي الله عليه وسلم فاعتقه لما بشره باسلام العباس بن عبد المطلب والمحفوظ انه اسلم لما بشر العباس بان النبي صلي الله عليه وسلم انتصر علي اهل اخيه وذلك في قصة جرت وكان اسلامه قبل بدر ولم يشهدها وشهد احدا وما بعدها وروي عن النبي صلي الله عليه وسلم وعن عبد الله بن مسعود روي عنه اولاده رافع والحسن وعبيد الله والمغيرة واحفاده الحسن وصالح وعبيد الله اولاد علي بن ابي رافع والفضل بن عبيد الله بن ابي رافع وابو سعيد المقبري وسليمان بن يسار وعطاء بن يسار وعمرو بن الشريد وابو غطفان بن ظريف وسعيد بن ابي سعيد مولي ابي حزم وحصين والد داود وشرحبيل بن سعد واخرون قال الواقدي مات ابو رافع بالمدينة قبل عثمان بيسير او بعده وقال بن حبان مات في خلافة علي بن ابي طالب ابو رافع الانصاري وقع ذكره في حديث المخابرة عند ابي داود من طريق مجاهد عن بن رافع بن خديج عن ابيه قال جاءنا ابو رافع فذكر الحديث ويحتمل ان يكون الذي بعده ابو رافع ظهير بن رافع بن خديج تقدم في الاسماء ابو رافع الحكم بن عمرو الغفاري تقدم في الاسماء ابو رافع الغفاري اخرج له بقي بن مخلد حديثا ويحتمل ان يكون الذي قبله ابو رافع مولي النبي صلي الله عليه وسلم اخر غير القبطي ذكره مصعب الزبيري فقال كان ابو رافع عبدا لابي احيحة سعيد بن العاص بن امية فاعتق كل من بنيه نصيبه منه الا خالد بن سعيد فانه وهب نصيبه للنبي صلي الله عليه وسلم فاعتقه فكان يقول انا مولي رسول الله صلي الله عليه وسلم فلما ولي عمرو بن سعيد بن العاص بن امية المدينة ايام معاوية دعا ابنا لابي رافع فقال مولي من انت فقال مولي رسول الله صلي الله عليه وسلم فضربه ماءة سوط ثم تركه ثم دعاه فقال مولي من انت فقال مولي رسول الله صلي الله عليه وسلم فضربه ماءة سوط حتي ضربه خمسماءة سوط ذكر ذلك المبرد في الكامل واقتضي سياقه انه ابو رافع الماضي وجري علي ذلك بن عبد البر §  <> واورد القصة في ترجمة ابي رافع القبطي والد عبد الله بن ابي رافع كاتب علي وهو غلط بين لان ابا رافع والد عبيد الله كان للعباس بن عبد المطلب فاعتقه قال ابو عمر هذه قصة لا تثبت من جهة النقل وفيها اضطراب كثير وقد روي عن عمرو بن دينار وجرير بن ابي حازم وايوب ان الذي تمسك بنصيبه من ابي رافع هو خالد وحده وفي رواية اخري انه كان لابي احيحة الا سهما واحدا فاعتق بنوه انصباءهم فاشتري النبي صلي الله عليه وسلم ذلك السهم فاعتقه قلت قد ذكر ابو سعيد بن الاعرابي هذه القصة في معجمه من طريق جرير بن حازم عن حماد بن موسي رجل من اهل المدينة ان عثمان بن البهي بن ابي رافع حدثه قال كان ابو احيحة جدي ترك ميراثا فخرج يوم بدر مع بنيه فاعتق ثلاثة منهم انصباءهم وهم سعيد وعبيد الله والعاصي فقتلوا ثلاثتهم يوم بدر كفارا فاعتق ذلك بنو سعيد انصباءهم غير خالد بن سعيد لانه كان غضب علي ابي رافع بسبب ام ولد لابي احيحة اراد ان يتزوجها فنهاه خالد فعصاه فاحتمل عليه فلما اسلم ابو رافع وهاجر كلم رسول الله صلي الله عليه وسلم خالدا في امره فابي ان يعتق او يهب او يبيع ثم ندم بعد ذلك فوهبه للنبي صلي الله عليه وسلم فاعتق صلي الله عليه وسلم نصيبه فكان ابو رافع يقول انا مولي رسول الله صلي الله عليه وسلم فلما ولي عمرو بن سعيد بن العاص المدينة ارسل الي البهي بن ابي رافع فقال له من مولاك قال رسول الله صلي الله عليه وسلم فضربه ماءة سوط ثم قال له من مولاك فقال مثلها حتي ضربه خمسماءة سوط فلما خاف ان يموت قال انا مولاكم فلما قتل عبد الملك بن مروان عمرو بن سعيد بن العاص مدحه البهي بن ابي رافع وهجا عمرو بن سعيد فهذا يبين ان صاحب هذه القصة غير ابي رافع والد عبد الله بن ابي رافع اذ ليس في ولده احد يسمي البهي ابو راءطة ياتي في ابي ريطة ابو الرباب ياتي في الرباب من كتاب النساء ابو الربذاء بموحدة ثم معجمة ويقال بالميم ثم بالمهملة ياتي ابو ربعي عمرو بن الاهتم التميمي تقدم ابو الربيع عبد الله بن ثابت الانصاري تقدم ذكره في حديث جابر بن عتيك ابو ربيعة غير منسوب ذكره ابو زكريا بن مندة مستدركا علي جده ولم يخرج له شيءا قاله ابو موسي ابو رحيمة غير منسوب بالحاء المهملة او المعجمة ذكره ابو نعيم واخرج من طريق روح بن جناح عن عطاء بن نافع عن الحسن عن ابي رحيمة قال حجمت رسول الله صلي الله عليه وسلم فاعطاني درهما وفي سنده ضعيف ابو رداد الليثي قال ابو احمد الحاكم وابن حبان له صحبة روي حديثه الزهري عن ابي سلمة بن عبد الرحمن عنه عن النبي صلي الله عليه وسلم وفي رواية عن الزهري عن ابي سلمة عن رداد الليثي اخرجها ابو رداد ولفظه ان ردادا اخبره عن عبد الرحمن بن عوف انه سمع رسول الله §  <> صلي الله عليه وسلم يقول قال الله انا الرحمن خلقت الرحم وكذا قال بن حبان في ثقات التابعين ورداد الليثي ثم ساق من طريق معمر عن الزهري عن ابي سلمة عن رداد عن عبد الرحمن بن عوف قال وما احسب معمرا حفظه انتهي قلت تابعه بن عيينة عن الزهري عن الترمذي وقال قال البخاري في حديث معمر خطا واخرجه البخاري في الادب المفرد من طريق بن ابي عتيق عن الزهري عن ابي سلمة عن محمد بن عبد الرحمن عن ابي الرداد الليثي عن النبي صلي الله عليه وسلم وتابعه شعيب عن الزهري وقال ابو حاتم الرازي المعروف في هذا رواية ابي سلمة بن عبد الرحمن عن عبد الرحمن ولابي الرداد فيه قصة وهي اشتكي ابو الرداد الليثي فعاده عبد الرحمن بن عوف فقال خيرهم واوصلهم ابو محمد فقال عبد الرحمن فذكر الحديث ابو الردين غير منسوب ذكره البغوي ولم يخرج له شيءا وقال بن مندة له ذكر في الصحابة ولم يثبت واخرج حديثه الحارث بن ابي اسامة والطبراني في مسند الشاميين من طريق عبد الحميد بن عبد الرحمن عن ابي الردين قال قال رسول الله صلي الله عليه وسلم ما من قوم يجتمعون يتلون كتاب الله ويتعاطونه بينهم الا كانوا اضياف الله والا حفت بهم الملاءكة حتي يفرغوا ابو رزين غير منسوب لم يرو عنه الا ابنه عبد الله وهما مجهولان حديثه في الصيد يتواري قاله ابو عمر ابو رزين اخر يقال انه كان من اهل الصفة روينا حديثه في الخلعيات من طريق عمرو بن بكر السكسكي عن محمد بن زيد عن ابي سلمة بن عبد الرحمن عن ابيه ان النبي صلي الله عليه وسلم قال لرجل من اهل الصفة يكني ابا رزين يا ابا رزين اذا خلوت فحرك لسانك بذكر الله لانك لا تزال في صلاة ما ذكرت ربك يا ابا رزين اذا اقبل الناس علي الجهاد فاحببت ان يكون لك مثل اجورهم فالزم المسجد تءذن فيه ولا تاخذ علي اذانك اجرا وسنده ضعيف ووقع ذكره في حديث اخر ذكره العقيلي في الضعفاء في ترجمة محمد بن الاشعث احد المجهولين فذكر من طريقه عن ابي سلمة عن ابي هريرة قال قال ابو رزين يا رسول الله ان طريقي علي الموتي فهل من كلام اتكلم به اذا مررت عليهم قال قل السلام عليكم يا اهل القبور من المسلمين انتم لنا سلف ونحن لكم تبع وانا ان شاء الله بكم لاحقون فقال ابو رزين يا رسول الله يسمعون قال يسمعون ولكن لا يستطيعون ان يجيبوا قال يا ابا رزين الا ترضي ان يرد عليك بعددهم من الملاءكة قال العقيلي لا يعرف الا بهذا الاسناد وهو غير محفوظ واصل السلام المذكور علي القبور يروي باسناد صالح غير هذا ابو رزين العقيلي لقيط بن عامر تقدم في الاسماء ابو رعلة القشيري ياتي في ام رعلة في النساء ابو رفاعة العدوي تميم بن اسد بفتحتين كذا سماه البخاري وقيل بن اسيد بالفتح وكسر السين وقيل بالضم مصغر قيل اسمه عبد الله الحارث قاله خليفة وغيره روي عن النبي صلي الله عليه وسلم روي عنه حميد بن هلال وصلة بن اشيم العدويان البصريان وحديثه في صحيح مسلم من حديث حميد قال اتيت النبي صلي الله عليه وسلم فذكر قصة في نزوله عن المنبر لاجله وتحديثه قال §  <> لما قال له رجل غريب يسال عن دينه فاقبل عليه ونزل فقعد علي كرسي قواءمه من حديد قال وجعل يعلمني مما علمه الله الحديث وروي الحاكم من طريق مصعب الزبيري ان ابا رفاعة العدوي له صحبة واسمه عبد الله بن الحارث بن اسيد بن عدي بن مالك بن تميم بن الدءل بن حسل بن عدي بن عبد مناة غزا سجستان مع عبد الرحمن بن سمرة فقام في اخر الليل فسقط فمات قال بن عبد البر كان من فضلاء الصحابة بالبصرة قتل بكابل سنة اربع واربعين وقال خليفة فتح بن عامر كابل سنة اربع واربعين فقتل فيها ابو قتادة العدوي ويقال بل الذي قيل فيها ابو رفاعة العدوي وقال عدي بن غنام قبر ابي رفاعة صاحب النبي صلي الله عليه وسلم والاسود بن كلثوم ببيهق وكذا قال مسلم ان قبر ابي رفاعة ببيهق ابو رقاد بتخفيف القاف خاطب بها النبي صلي الله عليه وسلم زيد بن ثابت وقد تقدم في ذلك في ترجمة زيد من طريق الواقدي ابو رقية بضم اوله وبقاف مصغرا تميم بن اوس الداري تقدم في الاسماء ابو رمثة بكسر اوله وسكون الميم ثم مثلثة البلوي قال الترمذي له صحبة سكن مصر ومات بافريقية وامرهم ان يسووا قبره حديثه عند اهل مصر كذا اورده ابو عمر وفرق بينه وبين ابي رمثة التميمي الذي بعده وخالفه المزي فقال في ترجمة الذي بعده التيمي ويقال البلوي ابو رمثة التيمي من تيم الرباب وقال التيمي اسمه رفاعة بن يثربي وقيل يثربي بن عوف وقيل يثربي بن رفاعة وبه جزم الطبراني وقيل اسمه حيان بتحتانية مثناة وبه جزم غير واحد وقيل حبيب بن حيان وقيل حسحاس روي عن النبي صلي الله عليه وسلم روي عنه اياد بن لقيط وثابت بن منقذ روي له اصحاب السنن الثلاثة وصحح حديثه بن خزيمة وابن حبان والحاكم ابو الرمداء البلوي ويقال بالموحدة بدل الميم ثم المعجمة تقدم في الاسماء وان اسمه ياسر ابو رهم الغفاري اسمه كلثوم بن حصين بن خالد بن المعيسر بن زيد بن العميس بن احمس بن غفار وقيل بن حصين بن عبيد بن خلف بن حماس بن غفار الغفاري مشهور باسمه وكنيته كان ممن بايع تحت الشجرة واستخلفه النبي صلي الله عليه وسلم علي المدينة في غزوة الفتح قال بن اسحاق في المغازي حدثني الزهري عن عبيد الله بن عبد الله بن عتبة عن بن عباس بذلك روي عن النبي صلي الله عليه وسلم حديثا طويلا في غزوة تبوك ومنهم من اختصره روي عنه بن اخيه ومولاه ابو حازم التمار واخرج احمد والبغوي وغيرهما من طريق معمر عن الزهري اخبرني بن اخي ابي رهم انه سمع ابا رهم يقول غزوت مع النبي صلي الله عليه وسلم غزوة تبوك فذكر الحديث وقال بن سعد بعثه النبي صلي الله عليه وسلم يستنفر قومه الي تبوك وحدث في كتاب الادب المفرد للبخاري وفي صحيح بن حبان ومعجم الطبراني وذكر ابو عروبة انه رمي بسهم في نحره يوم احد فبصق فيه النبي صلي الله عليه وسلم فبرا ابو رهم بن قيس الاشعري اخو ابي موسي تقدم ذكر حديثه في ترجمة اخيه ابي بردة §  <> بن قيس وهو في الطاعون واسناده صحيح ورايت في التاريخ للمظفري نقلا عن بن قتيبة قال كان ابو رهم يتسرع في الفتن وكان اخوه ابو موسي ينهي عنها فذكر قصة قال وقيل ان ابا رهم هذا لا يعرف قلت ولعله هذا ثم وجدت في مسند احمد في اثناء سند ابي موسي من طريق قتادة حدثنا الحسن ان ابا موسي كان له اخ يقال له ابو رهم يتسرع في الفتن فذكر له ابو موسي حديث ما من مسلمين التقيا بسيفهما فقتل احدهما الاخر الا دخلا النار ابو رهم اخر اسمه مجدي بن قيس تقدم ابو رهم الارحبي تقدم في مطعم في الاسماء وذكره البغوي ونقل عن ابي عبيد قال ابو رهم الشاعر هاجر الي النبي صلي الله عليه وسلم وهو بن ماءة وخمس سنين وهو من بني ارحب من همدان ابو رهم يقال هو السمعي وعندي انه غير احزاب قال بن سعد كوفي نزل الشام وهو من الصحابة ولم ينسبه ولم يسمه واخرج بن ابي خيثمة من طريق بقية عن خالد بن حميد حدثني عمر بن سعيد اللخمي عن يزيد بن ابي حبيب عن ابي رهم صاحب رسول الله صلي الله عليه وسلم ان رسول الله صلي الله عليه وسلم قال من عصي امامه ذهب اجره اخرجه اسحاق بن راهويه في مسنده عن بقية والحسن بن سفيان عن اسحاق واخرج الدولابي من طريق ثور بن يزيد عن يزيد بم مرثد عن ابي رهم سمعت رسول الله صلي الله عليه وسلم يقول اذا رجع احدكم من سفره فليرجع بهدية الي اهله وان لم يجد الا ان يكون في مخلاته حجر او حزمة حطب فان ذلك يعجبهم فهذه الاحاديث الثلاثة تصرح بصحبة ابي رهم وقد اخرج بن ماجة الاول من وجه اخر عن يزيد بن ابي حبيب فقال عن ابي الخير عن ابي رهم السمعي قال قال رسول الله صلي الله عليه وسلم ان افضل الشفاعات ان تشفع بين اثنين في نكاح حتي تجمع بينهما واخرجه الطبراني كذلك وزاد في المتن وان اعظم الخطايا من اقتطع مال امرء مسلم بغير حق الحديث فان لم يكن بعض الرواة اخطا في قوله السمعي والا فهذا صحابي يقال له السمعي وليس هو احزاب بن اسيد لان احزابا لا صحبة له فلا يمنع ان يتفق اثنان في الكنية والنسبة ابو رهيمة بالتصغير السمعي ذكره المستغفري والبردعي واستدركه ابو موسي وقد ذكره بن مندة في ترجمة ابي نخيلة اللهبي وياتي ذلك في حرف النون فان ابا موسي اورده من طريق بن مندة وجوز ان يكون هو الذي قبل هذا وهو محتمل ابو الروم بن عمير بن هاشم بن عبد الدار بن عبد مناف بن قصي العبدري اخو مصعب قال البلاذري كان اسمه عبد مناف فتركه لما اسلم وهو من السابقين الاوليين هاجر الي الحبشة ثم قدم فشهد احدا وقال بن الكلبي قدم قبل خيبر فشهدها وقال الواقدي ليس متفقا علي هجرته الي الحبشة وقد نفاها الهيثم بن عدي وغيره ابو رومي ذكره يعقوب بن سفيان واخرج من طريق عمرو بن مالك النكري عن ابي الحوراء عن بن عباس قال كان ابو رومي من شر اهل زمانه فقال النبي صلي الله عليه وسلم لءن §  <> رايت ابا رومي لاضربن عنقه فلما اصبح غدا نحو النبي صلي الله عليه وسلم فاذا هو مع اصحابه يحدثهم فلما راه من بعيد قال مرحبا بابي رومي واخذ يوسع فقال له يا ابا رومي ما عملت البارحة قال ما عسي ان اعمل يا رسول الله انا شر اهل الارض قال ابشر فان الله جعل مكسبك الي الجنة فان الله يمحو ما يشاء ويثبت ما يشاء ابو رويحة الثمالي الفزعي بفتح الفاء والزاي المنقوطة اسمه ربيعة بن السكن تقدم في الاسماء وقال ابو موسي ابو رويحة الفزعي من خثعم قال اتيت النبي صلي الله عليه وسلم وهو يواخي بين الناس قاله المستغفري ابو رويحة الخثعمي اخي النبي صلي الله عليه وسلم بينه وبين بلال المءذن ويقال اسمه عبد الله بن عبد الرحمن الخثعمي وابو رويحة لم يسند عن النبي صلي الله عليه وسلم حديثا ثم ساق من طريق محمد بن اسحاق قال اخي رسول الله صلي الله عليه وسلم بين اصحابه فكان بلال مولي ابي بكر مءذن رسول الله صلي الله عليه وسلم وابو رويحة عبد الله بن عبد الرحمن الخثعمي اخوين فلما دون عمر الديوان بالشام قال لبلال الي من تجعل ديوانك قال مع ابي رويحة لا افارقه ابدا للاخوة المذكورة فضمه اليه وضم ديوان الحبشة الي خثعم لمكان بلال فهم مع خثعم بالشام الي اليوم وقال ابو احمد الحاكم له صحبة ولست اقف علي اسمه قال ابو موسي وقد ذكره ابو عبد الله بن مندة في الكني وليس فيما عندنا من كتابه في الصحابة ثم ساق من طريق ابي احمد الحاكم قال حدثنا ابو الحسن محمد بن العيص الغساني حدثنا ابراهيم بن محمد بن سليمان عن ام الدرداء عن ابي الدرداء قال لما رجع عمر من فتح بيت المقدس وسار الي الجابية ساله بلال ان يقره بالشام ففعل فقال واخي ابو رويحة اخي بيننا النبي صلي الله عليه وسلم فنزل داريا في بني خولان فاقبل هو واخوه الي حي من خولان فقال اتيناكم خاطبين قد كنا كافرين فهدانا الله عز وجل ومملوكين فاعتقنا الله عز وجل وفقيرين فاغنانا الله عز وجل فان تزوجونا فالحمد لله وان تردونا فلا حول ولا قوة الا بالله فزوجوهما وقال ابو عمر روي عن ابي رويحة قال اتيت النبي صلي الله عليه وسلم فعقد لي لواء وقال اخرج فناد من دخل تحت لواء ابي رويحة فهو امن قلت وهذا تقدم في ترجمة ربيعة بن السكن وفرق ابو موسي بين الفزعي والخثعمي وتعقبه بن الاثير بان الفزع بطن من خثعم وهو الفزع بن شهران بن عفرس بن حلف بن افتل وهو خثعم وفاته ان الاول اسمه ربيعة بن السكن واخو بلال اسمه عبد الله بن عبد الرحمن وقد ذكرت في ترجمته ما يدل علي انه غير من اخي النبي صلي الله عليه وسلم بينه وبين بلال وقد اورد بن عساكر حديث الفزعي في ترجمة الخثعمي فكانهما عنده واحد والله اعلم ابو رثاب تقدم في الذال المعجمة انه قيل في ابي ذءاب ابو رءاب ابو ريحانة الازدي ويقال الانصاري اسمه شمعون تقدم في الشين المعجمة من الاسماء ابو ريحانة القرشي تقدم حديثه في ترجمة عقبة بن مالك الجهني في الاسماء ابو ريطة المذحجي ذكره الدولابي والطبراني وابن مندة واخرجوا من طريق §  <> عبد الله بن احمد اليحصبي عن علي بن ابي علي عن الشعبي عن ابي ريطة بن كرامة المذحجي قال كنا عند النبي صلي الله عليه وسلم فقال لقوم سفر لا يصحبنكم خلال من هذه النعم ولا يردن ساءلا ولا يصحبن احد منكم ضالة ان كنتم تريدون الربح والسلام الحديث ووقع في رواية الطبراني عن ابي ريطة عبد الله بن كرامة واخرج المستغفري من طريق عمر بن صبيح عن ابي حريز قاضي سجستان عن الشعبي عن ابي ريطة المذحجي عن النبي صلي الله عليه وسلم انه بينما هو جالس ذات ليلة بين المغرب والعشاء اذ مرت به رفقة تسير سيرا حثيثا فذكر الحديث وذكره البغوي فقال ابو ريطة ولم يخرج له شيءا ابو ريطة اخر غير منسوب ذكره ابو نعيم واخرج من طريق الحسن بن سفيان قال حدثنا نصر بن علي حدثتني ام يونس بنت يقظان المجاشعية حدثتني ريطة وكان ابوها من اصحاب النبي صلي الله عليه وسلم عن ابيها قال قال رسول الله صلي الله عليه وسلم لان الطع قصعة احب الي من ان اتصدق بمثلها طعاما واستدركه ابو موسي ابو ريمة بكسر اوله وسكون التحتانية المثناة بعدها ميم ذكره بن حبان في الصحابة ولم يسمه ولم يعرف من حاله بشء واخرج بن مندة وابو نعيم من طريق المنهال بن خليفة عن الازرق بن قيس قال صلي بنا امام يكني ابا ريمة فسلم عن يمينه وعن يساره حتي يري بياض خديه ثم قال صليت بكم كما رايت رسول الله صلي الله عليه وسلم يصلي وذكر بن مندة ان شعبة رواه عن الازرق بن قيس بن عبد الله بن رياح عن رجل من الصحابة ولم يسمه وذكر المزي في الاطراف ان ابا داود اخرجه من هذا الوجه ولم اقف علي ذلك في شء من نسخ السنن منها نسخة بخط ابي الفضل بن طاهر والنسخة المنقولة من خط الخطيب وقد قابلها عليها جماعة من الحفاظ وهي في غاية الاتقان واتفقت علي ان الصحابي ابو رمثة بتقديم الميم وسكونها علي المثلثة وكذا اورد الطبراني هذا الحديث في مسند ابي رمثة من معجمه وكذا رايته في مستدرك الحاكم والله اعلم القسم الثاني خال القسم الثالث ابو رافع الصاءغ اسمه نفيع وهو مدني نزل البصرة وهو مولي بنت النجار وقيل بنت عمه ذكره بن سعد في الطبقة الاولي من اهل البصرة وقال خرج قديما من المدينة وهو ثقة واخرج الحاكم ابو احمد في الكني من طريق مرحوم العطار عن ثابت البناني عن ابي رافع انه اكل لحم سبع في الجاهلية قلت اكثر عن ابي هريرة وروي ايضا عن الخلفاء الاربعة وابن مسعود وزيد بن ثابت §  <> وابي بن كعب وابي موسي وغيرهم روي عنه بن عبد الرحمن وثابت البناني وبكر المزني وقتادة وسليمان التيمي واخرون قال العجلي ثقة من كبار التابعين ورجح الطبراني ان اسمه كنيته ووثقه وقال ابو عمر مشهور من علماء التابعين ادرك الجاهلية واخرج ابراهيم الحربي في غريب الحديث بسند جيد عن ابي رافع قال كان عمر يمازحني يقول اكذب الناس الصاءغ يقول اليوم غدا ابو رجاء العطاردي قيل اسمه عمران بن ملحان وقيل بن تيم وقيل بن عبد الله ويقال اسمه عطارد قال بن قتيبة ولد قبل الهجرة باحدي عشرة سنة وعاش الي خلافة هشام بن عبد الملك كذا رايته في التاريخ المظفري وقال اشعث بن سوار بلغ سبعا وعشرين وماءة سنة وفي صحيح البخاري من طريق لما بعث النبي صلي الله عليه وسلم فررنا الي النار الي مسيلمة وقال ابو حاتم جاهلي اسلم بعد فتح مكة وعاش ماءة وعشرين سنة وقال البخاري يقال مات قبل الحسن وكانت وفاة الحسن سنة عشرة وارسل عن النبي صلي الله عليه وسلم وروي عن عمر وعلي وعمران بن حصين وسمرة بن جندب وابن عباس وعاءشة وغيرهم روي عنه ايوب وجرير بن حازم وعوف الاعرابي ومهدي بن ميمون وعمران القصير وابو الاشهب والجعد ابو عثمان واخرون قال بن سعد كان له علم وقران ورواية وهو ثقة وام قومه اربعين سنة وتوفي في خلافة عمر بن عبد العزيز قال وقال الواقدي مات سنة سبع عشرة وهو وهم وقال الذهلي مات قبل الحسن اظنه سنة سبع وماءة ووثقه ايضا يحيي بن معين وابو زرعة وابن عبد البر وزاد كانت فيه غفلة ابو رزين الاسدي مسعود بن مالك تابعي مختلف في ادراكه وسياتي في القسم الذي بعده ابو الرقاد اسمه شويس بمعجمة ثم مهملة مصغرا ابو رمح الخزاعي ذكره دعبل بن علي في طبقات الشعراء في اهل الحجاز وقال مخضرم وهو الذي رثي الحسين بن علي بتلك الابيات الساءرة مررت علي ابيات ال محمد فلم ارها كعهدها يوم حلت فلا يبعد الله البيوت واهلها وان اصبحت من اهلها قد تخلت ابو رهم السمعي ويقال له الظهري اسمه احزاب بن اسيد تقدم في الاسماء القسم الرابع ابو رزين مسعود بن مالك الاسدي مولاهم وقيل مولي علي اسمه عبيد نزل الكوفة وروي عن بن ام مكتوم وعلي بن ابي طالب وابو موسي الاشعري وابي هريرة وغيرهم وعنه ابنه عبد الله واسماعيل بن ابي خالد وعطاء بن الساءب والاعمش ومنصور وموسي بن ابي عاءشة ومغيرة بن مقسم واخرون قال ابو حاتم يقال انه شهد صفين مع علي وذكره البخاري في الطهارة من صحيحه تعليقا §  <> من فعله واسند له في الادب المفرد واخرج له مسلم والاربعة من روايته عن الصحابة وذكره بن شاهين في الصحابة وتعقبه ابو موسي وقال لا صحبة له ولا ادراك ثم ساق من طريق عاصم بن ابي واءل قال الا يعجب من ابي رزين قد هرم وانما كان غلاما علي عهد عمر وانا رجل وقال غيره كان اكبر من ابي واءل وكان عالما فهما كذا وقع بخط المزي في التهذيب وتعقبه مغلطاي بان قوله فهما بالفاء غلط وانما هو بالباء المكسورة كذا ذكره البخاري في التاريخ عن يحيي القطان عن ابي بكر قال كان ابو رزين اكبر من ابي قال يحيي وكان عالما بهما ووثقه ابو زرعة والعجلي وغيرهما قلت وله رواية عن معاذ بن جبل وهي مرسلة وانكر ابو الحسن بن القطان ان يكون ادرك بن ام مكتوم وقال شعبة فيما حكاه بن ابي حاتم عنه في المراسيل لم يسمع من بن مسعود قيل قتله عبيد الله بن زياد بعد سنة ستين وقيل عاش الي الجماجم بعد سنة ثمانين وارخه بن قانع سنة خمس وتسعين ابو رهم الانماري ذكره ابو بكر بن ابي علي في الصحابة واخرج عن ابي بكر بن ابي عاصم بسنده الي ثور بن زيد عن خالد بن معدان عن ابي رهم الانماري قال كان رسول الله صلي الله عليه وسلم اذا اخذ مضجعه قال بسم الله اللهم اغفر لي ذنبي واخسء شيطاني وفك رهاني الحديث استدركه ابو موسي وهو خطا نشا عن تحريف وتصحيف وانما هو ابو زهير الانماري كذا اخرجه بن ابي عاصم وهو علي الصواب في كتاب الدعاء له وكذا اخرجه الطبراني ابو رهم الظهري اورده ابو بكر بن ابي علي واستدركه ابو موسي فاخطا فانه هو السمعي واسمه احزاب وليست له صحبة وقد ذكره بن ابي عاصم عن محمد بن مصفي عن يحيي بن سعيد العطار ان ابا رهم الظهري كان في ماءتين من العطاء بحمص وكان شيخا كبيرا يخضب بالصفرة وكان له بن اسمه عمارة اصيب مع يزيد بن المهلب ابو رهيمة الشجاعي استدركه ابو موسي وعزاه لجعفر المستغفري وهو خطا فان الشجاعي تصحيف من السماعي والحديث الذي ذكره المستغفري من طريق سليمان بن داود باسناد له كذا قال هو الحديث الذي تقدم في الاول من طريق سليمان بن داود المكي تبعا له ابو ريحانة عبد الله بن مطر ذكره ابو نعيم وهو خطا فان ابا ريحانة الصحابي اسمه شمعون واما عبد الله بن مطر فهو تابعي يروي عن سفينة خادم رسول الله صلي الله عليه وسلم ابو ريطة المذحجي فرق ابو موسي بينه وبين ابي راءطة وهو واحد والحديث الواحد قال بعضهم فيه عن ابي راءطة وقال بعضهم عن ابي ريطة كما اوضحت ذلك في القسم الاول ابو ريمة تقدم القول فيه في القسم الاول حرف الزاي المنقوطة القسم الاول §  <> ابو زرارة الانصاري ذكره بن ابي خيثمة في الصحابة وقال ابو عمر فيه نظر وقال البغوي لم يسم ولا ادري له صحبة ام لا واخرج هو وابن ابي خيثمة من طريق ابان العطار عن يحيي بن ابي كثير عن محمد بن عبد الرحمن بن ثوبان عن ابي زرارة الانصاري ان النبي صلي الله عليه وسلم قال من سمع النداء ثلاثا فلم يجب كتب من المنافقين واخرجه عن شيخ اخر عن ابان مرسلا وجوز بعضهم ان يكون ابو زرارة هو عبد الرحمن بن سعد بن زرارة وقد تقدم ذكره في القسم الثاني من حرف العين ابو زرارة النخعي له وفادة قال بن الكلبي حكاه بن الاثير عن بن الدباغ قال والذي في الجمهرة زرارة اسم لا كنية قلت وهو كما قال وقد تقدم في الاسماء وانما ذكرته للاحتمال ابو الزعراء ذكره بن منده وقال عداده في اهل مصر وذكر من طريق عبد الله بن جنادة المعافري عن ابي عبد الرحمن الحبلي عن ابي الزعراء قال خرجت مع رسول الله صلي الله عليه وسلم في سفر له فغشيت رسول الله صلي الله عليه وسلم ونحن علي ظهر فسمعته يقول غير الدجال اخوف علي امتي الحديث وبه الاءمة المضلون وذكره محمد بن الربيع الجيزي في الصحابة الذي دخلوا مصر وقال لهم عنه حديث واحد ثم ساقه من الوجه المذكور ابو زعنة الشاعر مختلف في اسمه فقيل عامر بن كعب بن عمرو بن خديج وقيل عبد الله بن عمرو وقيل كعب بن عمرو قال الطبري شهد بدرا ذكر ذلك ابو عمر قلت ذكر بن اسحاق انه شهد احدا فقال قال ابو زعنة بن عبد الله بن عمرو بن عتبة احد بني جشم بن الخزرج يوم احد انا ابو زعنة يعدوني الهرم لم يمنع المخزاة الا بالالم يحمي الديار خزرجي من جشم قلت وهو بفتح اوله والنون بينهما عين مهملة ابو زمعة البلوي سماه العسكري عبيدا بالتصغير بن ارقم وعند ابي موسي بغير تصغير ولا اسم اب ذكره البغوي وابن السكن وغيرهما في الصحابة واخرجوا من طريق بن لهيعة عن عبيد الله بن المغيرة عن ابي قيس مولي بني جمح سمعت ابا زمعة البلوي وكان من اصحاب الشجرة ممن بايع النبي صلي الله عليه وسلم اتي يوما الي الفسطاط فقام في الرحبة وقد بلغه عن عبد الله بن عمرو بعض التشديد فقال لا تشددوا علي الناس فاني سمعت رسول الله صلي الله عليه وسلم يقول قتل رجل من بني اسراءيل تسعا وتسعين نفسا الحديث بطوله وروايته في معجم البغوي في اخر حرف القاف وما عرفت ما سبب ذلك ثم رايت في نسخة اخري يقال اسمه عبيد بن ادم ابو الزهراء البلوي صحابي شهد فتح مصر ذكره بن منده عن بن يونس واظنه تصحيفا وانما هو ابو الزعراء فليس في تاريخ مصر لابن يونس غير ابي الزعراء وكذا وقع في الصحابة الذين دخلوا مصر لابن الربيع الجيزي ابو الزهراء القشيري ياتي في القسم الثالث ويمكن ان يكون من اهل هذا القسم لان في ترجمته انه ممن امره يزيد بن ابي سفيان في بعض فتوح الشام وقد تقدم غير مرة انهم لم يكونوا يءمرون في الفتوح الا الصحابة وقد قرن في هذه القصة بدحية بن خليفة §  <> ابو زهير بن اسيد بن جعونة تقدم في ترجمة قرة بن دعموص ابو زهير الانماري تقدم فيمن اسمه ابو الازهر ابو زهير الثقفي قال بن حبان في الصحابة كان في الوفد قال البغوي سكن الطاءف وقال بن ماكولا وفد علي النبي صلي الله عليه وسلم وفرق ابو احمد في الكني بين ابي زهير بن معاذ وبين ابي زهير الثقفي فقال في الثقفي اسمه عمار بن حميد وهو والد ابي بكر بن ابي زهير وحديث ابي زهير عند احمد وابن ماجة والدارقطني في الافراد بسند حسن غريب من طريق نافع بن عمر الجمحي عن امية بن صفوان عن ابي بكر بن ابي زهير عن ابيه عن النبي صلي الله عليه وسلم قال خطبنا رسول الله صلي الله عليه وسلم بالنباوة من ارض الطاءف فقال يوشك ان تعرفوا اهل الجنة من اهل النار قالوا بم يا رسول الله قال بالثناء الحسن والثناء السء انتم شهداء بعضكم علي بعض قال الدارقطني تفرد به امية بن صفوان عن ابي بكر وتفرد به نافع بن عمر عن امية واورد الحاكم ابو احمد من طريق سفيان بن عيينة عن اسماعيل بن ابي خالد عن ابي بكر بن عمار بن حميد عن ابيه حديثا وهذا سند صحيح وتقدم حديث معاذ في الاسماء وحكي المزي انه قيل انه عمارة بن رويبة ابو زهير بن معاذ بن رياح الثقفي قال الحسين بن محمد القباني له صحبة وقيل معاذ اسمه قال الحاكم ابو احمد ذكر ابراهيم الحربي ان ابا زهير بن معاذ ممن غلبت عليه كنيته من الصحابة واورد له حديث اذا سميتم فعبدوا وهذا الحديث اخرجه الطبراني في ترجمة معاذ الثقفي وقد ذكرت ما فيه هناك واورده المزي في ترجمة ابي زهير الثقفي فقال وقيل ابو زهير بن معاذ ابو زهير النميري قيل هو ابو زهير الانماري الذي يقال له ابو زهر والراجح انه غيره اخرج بن منده من طريق صبح بن مخرمة حدثني ابو مصبح المقري قال كنا نجلس الي ابي زهير النميري وكان من الصحابة فيتحدث باحسن الحديث واذا دعا الرجل منا قال اختمها بامين فان امين في الدعاء مثل الطابع علي الصحيفة قال ابو زهير واخبركم عن ذلك خرجنا مع رسول الله صلي الله عليه وسلم نمشي ذات ليلة فاقمنا علي رجل في خيمة قد الحف في المسالة ورسول الله صلي الله عليه وسلم يسمع منه فقال اوجب ان ختم فقال له رجل من القوم باي شء يختم قال بامين فانه ان ختم بامين فقد اوجب فانصرف الرجل الذي سمعه فاتي الرجل فقال اختم بامين يا فلان في كل شء وابشر ثم قال وهذا حديث غريب تفرد به الفريابي عن صبح واخرج البغوي والطبراني في مسند الشاميين من طريق ضمضم بن زرعة عن شريح بن عبيد الحضرمي عن ابي زهير النميري وكانت له صحبة قال قال رسول صلي الله عليه وسلم لا تقاتلوا الجراد فانه جند من جند الله الاعظم قال البغوي سكن الشام وقد تقدم في يحيي بن نفير شء من هذا ويحتمل ان يكون هو ابا زهير بن جعونة المتقدم ذكره فانه نميري ابو الزواءد اليماني ذكره مطين والدولابي في الكني من الصحابة واورد الفاكهي وجعفر الفريابي في كتاب النكاح بسند صحيح من ابراهيم بن ميسرة قال قال لي طاوس ونحن نطوف لتنكحن او لاقولن لك ما قال عمر لابي الزواءد ما يمنعك من النكاح الا عجز او فجور واخرج الطبراني من طريق §  <> زياد بن نصر عن سليم بن مطين عن ابيه عن ابي الزواءد قال كنت مع رسول الله صلي الله عليه وسلم في حجة الوداع فذكر حديثا طويلا اخرج ابو داود بعضه من هذا الوجه وتقدمت الاشارة اليه في حرف الذال المعجمة فان منهم من قال ان ابا الزواءد هو ذو الزواءد ممن ذكره في الكني البخاري وذكر بهذا الاسناد طرفا من هذا الحديث ابو زياد مولي بني جمح روي عن ابي بكر الصديق وعنه خالد بن معدان كذا في التجريد وكانه عنده مخضرم وقد وجدت له حديثا مرفوعا اخرجه الطبراني في مسند الشاميين من طريق سفيان بن حبيب عن ثور بن زيد عن خالد بن معدان عن ابي زياد قال ما نسيت اني رايت رسول الله صلي الله عليه وسلم اذا صلي وضع يده اليمني علي اليسري في الصلاة ابو زياد الانصاري تقدم في زرارة في الاسماء ابو زيد الذي جمع القران وقع في حديث انس في صحيح البخاري غير مسمي وقال انس هو احد عمومتي واختلفوا في اسمه فقيل اوس وقيل ثابت بن زيد وقيل معاذ وقيل سعد بن عبيد وقيل قيس بن السكن وهذا هو الراجح كما بينته في حرف القاف ابو زيد بن اخطب اسمه عمرو بن اخطب بن رفاعة بن محمود بن بشر بن عبد الله بن الضيف بن احمر بن عدي بن ثعلبة بن حارثة بن عمرو بن عامر الانصاري الخزرجي ابو زيد مشهور بكنيته وهو جد عزرة بن ثابت لامه اخرج الترمذي من طريق ابي عاصم عن عزرة عن علباء بن احمر عن ابي زيد بن اخطب قال مسح النبي صلي الله عليه وسلم يده علي وجهي ودعا لي وفي رواية احمد في هذا الحديث وحده زادني جمالا قال فاخبرني غير واحد انه بلغ بضعا وماءة سنة اسود الراس واللحية وفي رواية لاحمد من وجه اخر عن ابي نهيك حدثني ابو زيد قال استسقي رسول الله صلي الله عليه وسلم ماء فاتيته بقدح فيه ماء فكانت فيه شعرة فاخذتها فقال اللهم جمله قال فرايته بن اربع وتسعين ليس في لحيته شعرة بيضاء وصححه بن حبان والحاكم وعند مسلم من هذا الوجه عن ابي بكر صلي بنا النبي صلي الله عليه وسلم الفجر وصعد المنبر فخطبنا حتي حضرت الظهر الحديث وفي الشماءل للترمذي من الطريق المذكورة عن ابي زيد قال لي النبي صلي الله عليه وسلم يا ابا زيد ادن مني امسح ظهري فمسحت ظهره فوضعت اصابعي علي الخاتم الحديث وصححه بن حبان والحاكم ابو زيد الضحاك اسمه ثابت ابو زيد بن عبيد اسمه سعد ابو زيد بن عمرو بن حديدة اسمه قطبة ابو زيد بن غرزة اسمه عمرو تقدموا في الاسماء وكلهم من الانصار ابو زيد الانصاري الخزرجي جد ابي زيد النحوي البصري قال الحاكم ابو احمد له صحبة والنحوي اسمه سعيد بن اوس بن ثابت بن بشير بن ابي زيد وقال الواقدي هو غير الذي جمع القران فقد تقدم انه لا عقب له §  <> ابو زيد بن عمرو الجذامي ذكره بن اسحاق في وفد جذام ابو زيد الارحبي اسمه عمرو بن مالك تقدم في الاسماء ابو زيد الانصاري اخر ذكره البغوي واخرج من طريق سعيد بن بشير عن قتادة عن ابي الخليل عن ابي زيد الانصاري ان رسول الله صلي الله عليه وسلم قال يعني في الخوارج يدعون الي الله وليسوا من الله في شء من قاتلهم كان اوفي بالله منهم ابو زيد الانصاري اخر ذكر بن الكلبي انه استشهد باحد واستدركه بن فتحون ابو زيد غير منسوب ذكره البغوي واخرج من طريق شعبة عن غنم بن حويص سمعت ابا زيد يقول غزوت مع رسول الله صلي الله عليه وسلم ثلاث عشرة غزوة واخرجه احمد بن حنبل في مسند ابي زيد بن اخطب الانصاري لكنه وقع في روايته عن شعبة عن تميم سمعت ابا زيد يقول فذكره ولم ينسبه ابو زيد قالت فاطمة بنت قيس في حديثها الطويل في نفقة الباءن وسكناها فشرفني الله بابي زيد يعني اسامة بن زيد وهي كنيته اخرجه مسلم من طريق ابي بكر بن ابي الجهم عن فاطمة ابو زيد الجرمي قال ابو احمد له صحبة وفي اسناده مقال قال البغوي لا ادري له صحبة ام لا قلت واخرج حديثه البغوي والطبراني من طريق عبيد بن اسحاق العطار احد الضعفاء عن مسكين بن دينار عن مجاهد سمعت ابا زيد الجرمي يقول قال رسول الله صلي الله عليه وسلم لا يدخل الجنة عاق ولا منان ولا مدمن خمر وعبيد ضعيف جدا وقد خولف قال الدارقطني في العلل رواه يزيد بن ابي زياد عن مجاهد فقال عن ابي سعيد الخدري وقال عبد الكريم عن مجاهد عن عبد الله بن عمرو ابو زيد الغافقي ذكره بن منده وقال عداده في اهل مصر ثم اورد من طريق عمرو بن شراحيل المعافري عن ابي زيد الغافقي قال قال رسول الله صلي الله عليه وسلم الاسوكة ثلاثة اراك فان لم يكن اراك فعنم فان لم يكن عنم فبطم قال ابو وهب الغافقي راوية عن عمرو بن شراحيل العنم الزيتون وقال بن منده غريب لا نعرفه الا من هذا الوجه ابو زيد سمع النبي صلي الله عليه وسلم وعنه الحسن البصري وجوز بن منده ان عمرو بن اخطب ابو زيد غير منسوب اخرج الطبراني في الاوسط من طريق الحسن بن دينار عن يزيد الرشك قال سمعت ابا زيد وكانت له صحبة قال كنت مع النبي صلي الله عليه وسلم فسمع رجلا يتهجد ويقرا بام القران فقام فاستمعها حتي ختمها فقال ما في القران مثلها قيل يجوز انه عمرو بن اخطب ايضا ابو زيد غير منسوب ايضا اخرج حديثه ابو مسلم الكجي في كتاب السنن له من طريق حماد عن سعيد بن قطن عن ابي زيد رجل من اصحاب النبي صلي الله عليه وسلم قال يمسح §  <> المسافر علي الخفين ثلاثة ايام ولياليهن والمقيم يوما وليلة ابو زينب بن عوف الانصاري قال ابو موسي ذكره ابو العباس بن عقدة في كتاب الموالاة من طريق علي بن الحسن العبدي عن سعد هو الاسكاف عن الاصبغ بن نباتة قال نشد علي الناس في الرحبة من سمع رسول الله صلي الله عليه وسلم يقول يوم غدير ما قال الا قام فقام بضعة عشر رجلا منهم ابو ايوب وابو زينب بن عوف فقالوا نشهد انا سمعنا رسول الله صلي الله عليه وسلم يقول واخذ بيدك يوم غدير فرفعها فقال الستم تشهدون اني قد بلغت قالوا نشهد قال فمن كنت مولاه فعلي مولاه وفي سنده غير واحد من المنسوبين الي الرفض القسم الثاني ابو زرعة بن زنباع هو روح الجذامي تقدم في الاسماء القسم الثالث ابو زبيد الطاءي الشاعر المشهور له ادراك واختلف في اسلامه واسمه حرملة بن منذر ويقال المنذر بن حرملة بن معد يكرب بن حنظلة بن النعمان بن حية بتحتانية مثناة بن سعد بن الغوث بن الحارث بن ربيعة بن مالك بن هني بن عمرو بن الغوث بن طي الطاءي قال الطبري كان ابو زبيد في الجاهلية مقيما عند اخواله بني تغلب بالجزيرة وكان في الاسلام منقطعا الي الوليد بن عقبة بن ابي معيط في ولايته الجزيرة وفي ولايته الكوفة ولم يزل به الوليد حتي اسلم وحسن اسلامه وكان ابو مورع واصحابه يضعون علي الوليد العيون فقيل لهم هذا الوليد الان يشرب الخمر مع ابي زبيد فاقتحموا عليه في نفر فادخل شيءا كان بين يديه تحت سريره فهجموا علي السرير فاستخرجوا من تحته طبقا فيه بعار من عنب فخجلوا وقال بن قتيبة لم يسلم ابو زبيد ومات علي نصرانيته وقال المرزباني كان نصرانيا وهو احد المعمرين يقال عاش ماءة وخمسين سنة وادرك الاسلام فلم يسلم واستعمله عمر بن الخطاب علي صدقات قومه ولم يستعمل نصرانيا غيره وبقي الي ايام معاوية وكان ينادم الوليد بن عقبة بن ابي معيط بالكوفة فلما شهد علي الوليد بانه شرب الخمر وصرف عن امرة الكوفة قال ابو زبيد فلعمر الاله لو كان للسيف نصال وللسان مقال ما نفي بيتك الصفا ولا اتوه ولا حال دونك الاسعال قال ورثي علي بن ابي طالب لما مات ولم يذكر منها المرزباني شيءا وذكر ابو الفرج الاصبهاني منها ونقله عن المبرد ان الكرام علي ما كان من خلق رهط امرء جامع للدين مختار §  <> طب بصير باصناف الرجال ولم يعدل بخير رسول الله اخيار الي اخر الابيات وقال الاصبهاني كان طول ابي زبيد ثلاثة عشرة شبرا وكان اعور اخوه من خاصة ملوك العجم ولما مات دفن الي قبر الوليد بن عقبة فمر بهما اشجع السلمي فقال مررت علي عظام ابي زبيد وقد لاحت ببلقعة صلود وكان له الوليد نديم صدق فنادم قبره قبر الوليد قال وكان ابو زبيد مغري بوصف الاسد في شعره وله في ذلك خبر مع عثمان وقد قيل ان قومه قالوا انا نخاف ان تسبنا العرب بوصفك الاسد فترك وصفه وقال المرزباني بقي الي ايام معاوية ومات الوليد قبله فمر بقبره فقال يا صاحب القبر السلام علي من حال دون لقاءه القبر يا هاجري اذ جءت زاءره ما كان من عاداتك الهجر ابو الزبير مءذن ببيت المقدس له ادراك وكان يءذن في زمن عمر فاخرج ابو احمد الحاكم في الكني من طريق مرحوم بن عبد العزيز العطار عن ابيه عن ابي الزبير مءذن بيت المقدس قال جاءنا عمر بن الخطاب فقال اذا اذنت فترسل واذا اقمت فاحدم ابو الزهراء القشيري ذكره بن عساكر في الكني فقال هو ممن ادرك النبي صلي الله عليه وسلم وشهد فتح دمشق وولي صلح اهل الثنية وحوران من قبل يزيد بن ابي سفيان في خلافة عمر ثم ساق من طريق سيف بن عمر في الفتوح قال وبعث يزيد بن ابي سفيان دحية بن خليفة الكلبي في خيل بعد فتح دمشق الي تدمر وابا الزهراء الي الثنية وحوران يصالحونها علي دمشق ووليا القيام علي فتح ما بعثا اليه وكان اخو ابي الزهراء قد اصيبت رجله بدمشق يوم فتح دمشق فلما هاجي بنو قشير بني جعدة فخروا بذلك فاجابهم نابغة بني جعدة فذكر الشعر ثم قال سيف في قصة من شرب الخمر بدمشق وحدهم عمر وقال ابو الزهراء القشيري في ذلك صبري ولم اجزع وقد مات اخوتي ولست علي الصهباء يوما بصابر رماها امير المءمنين بحتفها فخلانها يبكون حول المعاصر ابو زياد مولي ال دراج الجمحيين له ادراك اخرج مسدد في مسنده الكبير بسند صحيح عن خالد بن معدان عن ابي زياد مولي ال دراج قال لم انس ان ابا بكر الصديق كان اذا قام الي الصلاة اخذ بكفه اليمني علي الذراع اليسري لازقا بالكوع وجوز بن عساكر ان يكون مولي ربيعة بن دراج ولم يسق نسب ربيعة هذا قلت وقد ذكرت ربيعة بن دراج وسقت نسبه في القسم الاول من حرف الراء ابو زيد قيس بن عمرو الهمداني تقدم في الاسماء §  <> القسم الرابع ابو زرعة الفزعي ذكره ابو موسي في الذيل وقال اخرجه بن طرخان في الصحابة واورد له من طريق يحيي بن الاصبع بن مهران عن حرام بن عبد الرحمن عن ابي زرعة الفزعي ان النبي صلي الله عليه وسلم عقد لواء الحديث وهذا خطا نشا عن تصحيف والصواب ابو رويحة براء مهملة مصغرا وقد تقدم في الراء بيان ضبط نسبه وانها بفتح الفاء والزاي وان اسمه عبد الله بن عبد الرحمن ابو زرعة مولي المقداد بن الاسود قال ابو عمر اسمه عبد الرحمن وهو تابعي وحديثه مرسل قال البخاري حديثه منقطع قلت ما عرفت سلف ابي عمر في ذكره في الصحابة وقد روي عنه ابو هلال الراسبي الذي يروي عن قتادة وطبقته ابو زيد عامر بن حديدة ذكره ابو عمر فيمن يكني ابا زيد من الانصار وانما هو ابو زيد قطبة بن عامر بن حديدة ابو زيد الانصاري غاير البغوي بينه وبين ابي زيد عمرو بن اخطب جد عروة بن ثابت فاخرج في ترجمة هذا حديث تميم بن حويص سمعت ابا زيد يقول غزوت مع رسول الله صلي الله عليه وسلم ثلاث عشرة غزوة وفي ترجمة جد عزرة حديث صلي بنا النبي صلي الله عليه وسلم فصعد المنبر فخطب حتي الظهر الحديث وقد اخرج احمد الحديثين في مسند ابي زيد عمرو بن اخطب ابو زبيد بن الصلت ذكره بن منده واراد والد زبيد فالترجمة حينءذ للصلت بن معد يكرب الكندي فكان ينبغي اذ عبر عنه باداة الكنية ان يقول ابو زبيد الصلت ولكن كثر استعمال بن منده هذا كما بينته مرارا حرف السين المهملة القسم الاول ابو سالم الحنفي ثم السحيمي ذكره بن السكن في الصحابة واخرج من طريق محمد بن جابر اليمامي عن عبد الله بن بدر السحيمي عن ام سالم عن زوجها ابي سالم قال سمعت رسول الله صلي الله عليه وسلم يقول ويل لبني فلان ثلاث مرات ابو الساءب عثمان بن مظعون الجمحي مشهور باسمه من السابقين الاولين تقدم في الاسماء ابو الساءب يزيد بن اخت النمر تقدم في الاسماء ابو الساءب الانصاري ويقال الثقفي والد كردم تقدم في ترجمة ولده §  <> ابو الساءب الثقفي اسمه مالك وقيل زيد وقيل يزيد تقدم في الميم ابو الساءب مذكور في الصحابة ولا اعرفه قاله ابو عمر وفي سند بقي بن مخلد حديثان لابي الساءب غير منسوب فكانه احد هءلاء ابو الساءب مولي غيلان بن سلمة الثقفي استدركه ابو علي الجياني من طريق يزيد بن ابي حبيب عن عروة بن سلمة ان ابا الساءب مولي غيلان اخبره ابو الساءب رجل من اصحاب رسول الله صلي الله عليه وسلم ذكره بن منده وقال عداده في اهل المدينة ثم اسند من طريق عياش بن عباس عن بكير بن الاشج عن علي بن يحيي عن ابي الساءب رجل من اصحاب رسول الله صلي الله عليه وسلم قال صلي رجل ورسول الله صلي الله عليه وسلم ينظر اليه فلما قضي صلاته قال له ارجع فصل ثلاث مرات الحديث وتعقبه ابو نعيم بان المحفوظ رواية اسحاق بن عبد الله بن ابي طلحة وداود بن قيس ومحمد بن غيلان وغيرهم كلهم عن علي بن يحيي عن ابيه عن عمه رفاعة بن رافع انتهي ولا يمتنع ان يكون لعلي بن يحيي فيه شيخان ابو سبرة الجعفي هو يزيد بن مالك سماه محمد بن عبد الله بن نمير وتقدم حديثه في ترجمة ولده عبد الرحمن بن ابي سبرة ابو سبرة بن الحارث وقيل ابو هبيرة بالهاء بدل السين وتقدم في حرف الالف ذكره وقول من قال انه ابو اسيرة ابو سبرة بن ابي رهم بن عبد العزي بن ابي قيس بن عبد ود بن نصر بن مالك بن حسل بن عامر بن لءي القرشي العامري احد السابقين الي الاسلام وهاجر الي الحبشة في الثانية ومعه ام كلثوم بنت سهيل بن عمرو شهد بدرا في قول جميعهم وامه برة بنت عبد المطلب عمه رسول الله صلي الله عليه وسلم وهو اخو ابي سلمة بن عبد الاسد لامه وذكر الزبير بن بكار انه اقام بمكة بعد وفاة رسول الله صلي الله عليه وسلم الي ان مات في خلافة عثمان قال الزبير لا نعلم احدا من اهل بدر رجع الي مكة فسكنها غيره ابو سبرة غير منسوب ذكر بن منده واخرج من طريق يوسف بن السفر قال قال الاوزاعي حدثني قزعة قال قدم علينا ابو سبرة صاحب رسول الله صلي الله عليه وسلم فقلت له حدثني رحمك الله بحديث سمعته من رسول الله صلي الله عليه وسلم فقال سمعته يقول من صلي الصبح فهو في ذمة الله فاتقوا الله ان يطلبكم بشء من ذمته ابو سبرة الجهني هو معبد بن عوسجة تقدم ابو سبرة جد عيسي بن سبرة تقدم في حبان في الحاء المهملة قال البغوي اظنه سكن المدينة ثم ساق حديثه من طريق بن انيس عن عيسي بن سبرة عن ابيه عن جده ابو السبع بن عبد قيس الانصاري شهد بدرا واسمه ذكوان تقدم ابو سروعة النوفلي هو عقبة بن عامر عند الاكثر وقد تقدم في الاسماء وقيل هو اخوه واسمه الحارث قاله العدوي وذكر انه اسلم يوم الفتح وكذا قال الزبير وغيره واختلف في سنه فبالفتح عند الاكثر وقيل بالكسر والراء الساكنة وزعم الحميدي انه راه بخط الدارقطني مضموم العين §  <> ولعلها كانت علامة الاهمال فظنها ضمة ابو سريحة بمهملتين بوزن عظيمة هو حذيفة بن اسيد بفتح الهمزة تقدم ابو سعاد الجهني قيل اسمه جابر بن اسامة وقد تقدم في الاسماء وان بن ماكولا سماه وقيل هو الذي بعده ابو سعاد الحمصي اخرج ابو زرعة في كتاب الزهد من طريق حريز بن عثمان عن بن ابي عوف قال مر ابو الدرداء بابي سعاد وهو من اصحاب النبي صلي الله عليه وسلم وابو سعاد يقول سبحان الله لا يبيع شيءا ولا يشتري فقال ابو الدرداء اخزن في دنياه ضيع في اخرته فرق ابو عمر بينه وبين الجهني وقال هذا نزل حمص وذكر له هذا الحديث ابو سعدان شامي غير مسمي ولا منسوب ذكره ابو عمر فقال روي عنه مكحول حديثا مرفوعا في الهجرة وقال الذهبي سنده لين ابو سعد الانصاري ثم الحارثي محيصة بن مسعود ابو سعد عياض بن زهير الفهري ابو سعد عياض بن زهير الفهري ابو سعد سلمة بن اسلم بن حريش تقدموا في الاسماء ابو سعد الخير ويقال ابو سعيد الخير قال بن السكن له صحبة ويقال اسمه عمرو وقال ابو احمد الحاكم لا اعرف اسمه ولا نسبه وذكر انه ابو سعيد الانماري وليس كذلك فان لهذا حديثين غير الحديث الذي اختلف فيه في الانماري بل هو ابو سعد او ابو سعيد فاخرج الترمذي في العلل المفردة وابن ابي داود في الصحابة وابو احمد الحاكم عنه من طريق اخري كلهم من طريق ابي فروة الرهاوي عن معقل الكندي عن عبادة بن نسي عن ابي سعيد قال قال رسول الله صلي الله عليه وسلم ان الله لم يكتب الصيام في الليل فمن صام فقد تعني ولا اجر له واخرجه الدولابي في الكني من وجه اخر عن ابي فروة فقال عن ابي سعد الخير الانصاري وفي رواية الحاكم ابي احمد عن ابي سعد الخير واخرجه بن منده وقال غريب لا نعرفه الا من هذا الوجه وقال الترمذي سالت محمدا يعني البخاري عنه فقال لا اري عبادة بن نسي سمع من ابي سعد الخير واخرج الدولابي في الكني من طريق فراس الشعباني انهم كانوا في غزاة القسطنطينية زمن معاوية قال وعلينا يزيد بن شجرة فبينا نحن عنده اذ مر ابو سعد الخير صاحب رسول الله صلي الله عليه وسلم فذكر قصة فقال ابو سعد الخير وانا سمعت رسول الله صلي الله عليه وسلم يقول توضءوا مما مست النار الحديث واخرجه الحاكم ابو احمد من هذا §  <> الوجه فقال ابو سعيد بزيادة ياء واخرجه بن منده من وجه اخر علي الوجهين وقال في سياقه شهدت ابا سعد الخير قال وقال مرة ابو سعيد الخير قال والاكثر قالوا ابو سعد يعني بسكون العين ولم يشكوا ابو سعد الانصاري الزرقي قال سعيد بن عبد العزيز وابو احمد الحاكم له صحبة واخرج بن ماجة من طريق يونس بن ميسرة قال خرجنا مع ابي سعد الزرقي صاحب رسول الله صلي الله عليه وسلم الي شراء الضحايا فذكر الحديث وتردد بن ابي حاتم عن ابيه في صحبته ووقع في رواية الطبراني من طريق يونس المذكور خرجت مع ابي سعد الخير فان كان محفوظا فهو الذي قبله وسياتي له ذكر في ترجمة ابو سعيد زوج اسماء بنت يزيد ابو سعد الانماري ويقال ابو سعيد ياتي ابو سعد الساعدي ذكره بن ابي داود وتبعه بن شاهين في الصحابة واخرج عنه من طريق ابي عمرو الاوزاعي حدثني يحيي بن ابي كثير حدثني قرة بن ابي قرة قال راي ابو سعد الساعدي رجلا يصلي بعد العصر فقال له لا تصل فاني سمعت رسول الله صلي الله عليه وسلم يقول لا تصلوا بعد صلاة العصر وصوب الدارقطني في العلل انه ابو اسيد الساعدي وان بن ابي داود وهم فيه ابو سعد بن فضالة الانصاري ويقال بن ابي فضالة ويقال ابو سعيد بن فضالة بن ابي فضالة ذكره بن سعد في طبقة اهل الخندق وقال بن السكن لا يعرف واخرج الترمذي وابن ماجة وابن خزيمة وابن حبان والحاكم من طريق عبد الحميد بن جعفر عن ابيه عن زياد بن مينا عن ابي فضالة وكان من اصحاب رسول الله صلي الله عليه وسلم قال علي بن المديني سنده صالح وقع عند الاكثر بسكون العين وبه جزم ابو احمد الحاكم وقال له صحبة لا احفظ له اسما ولا نسبا وفي بن ماجة بالوجهين وفي الترمذي بزيادة الياء وقال الذهبي في التجريد ابو سعد بن ابي فضالة له حديث متصل في الكني لابي احمد ثم قال ابو سعيد بن فضالة ويقال ابو سعد اخرج له الترمذي في الرياء كذا وجعله اثنين مع ان الحديث الذي اخرجه الحاكم ابو احمد هو الذي اخرجه الترمذي بعينه ورايته في الترمذي كما في الكني للحاكم ابو سعد بسكون العين وكذا ذكره البغوي في الكني فقال ابو سعد بن ابي فضالة الانصاري سكن المدينة ثم ساق حديثه بسنده الي زياد بن نيار عن ابي سعيد بن ابي فضالة وكان من الصحابة قال سمعت رسول الله صلي الله عليه وسلم يقول اذا جمع الله الاولين والاخرين يوم القيامة ليوم لا ريب فيه نادي مناد من كان اشرك في عمله احدا فليطلب ثوابه من عنده فان الله اغني الشركاء عن الشرك وكذا اخرجه بن ابي خيثمة عن يحيي بن معين عن محمد بن ابي بكر عن عبد الحميد ووقع في الفواءد للصولي عن يحيي بن معين بهذا السند عن ابي سعيد بن فضالة بن ابي فضالة قال بن عساكر وهو وهم والصواب الاول وكذا اخرجه احمد عن محمد ابي بكر وله رواية عن سهيل بن عمرو ايضا اخرجها بن سعد ابو سعد بن وهب النضري بفتح الضاد المعجمة من بني النضير اخوة قريظة قال بن اسحاق في المغازي لم يسلم من بني النضير سوي الرجلين يامين بن عمرو بن كعب وابي سعد بن وهب فاحرزا اموالهما واخرج له بن سعد حديثا عن الواقدي بسند له الي اسامة بن ابي سعد بن وهب §  <> النضري عن ابيه قال شهدت رسول الله الله عليه وسلم يقضي في سيل مهروز ان يحبس الاعلي عن الاسفل حتي يبلغ الكعبين ثم يرسل ووقع في كلام ابي عمر انه نزل الي النبي صلي الله عليه وسلم يوم قريظة وهو خطا تعقبه الرشاطي فان قصة بني النضير متقدمة علي قصة بني قريظة بمدة طويلة ابو سعد الانصاري روي حديثه بن ابي فديك عن يحيي بن ابي خالد عن ابي سعد كذا قال ابو عمر مختصرا وقال بن منده رواه محمد بن اسماعيل بن ابي فديك عن يحيي بن ابي خالد عن بن ابي سعد الانصاري عن ابيه عن النبي صلي الله عليه وسلم انه قال الندم توبة قلت واخرجه الحكيم الترمذي في نوادر الاصول من طريق بن ابي فديك بهذا السند بلفظ التاءب من الذنب كمن لا ذنب له والندم توبة وجزم ابو نعيم بانه النضري المذكور قبله وليس بجيد وجزم ابو بكر بانه الذي روي حديث خير الاضحية الكبش الادغم وليس بجيد ايضا ابو سعد بن اوس بن المعلي بن لوذان بن حارثة بن عدي الانصاري الاوسي ذكره الطبري في الذيل وقال توفي سنة اربع وتسعين ويقال اسمه الحارث ذكر من يكني ابا سعيد بزيادة ياء ابو سعيد الخدري سعد بن مالك بن سنان ابو سعيد العبشمي عبد الرحمن بن سمرة ابو سعيد السعيدي خالد بن ابي احيحة سعد بن العاص ابو سعيد الانصاري يزيد بن ثابت بن وديعة ابو سعيد المخزومي المسيب بن حزن بن ابي وهب ابو سعيد المخزومي عمر بن حريث ابو سعيد كاتب الوحي زيد بن ثابت الانصاري الخزرجي ابو سعيد رافع بن المعلي بدري استشهد بها تقدموا في الاسماء ويقال اسم ابي سعيد بن المعلي الحارس بن اوس بن العلي ويقال الحارس بن نفيع وقيل بل هذا اسم الذي بعده ابو سعيد بن المعلي الانصاري اخر اخرج له البخاري من رواية حفص بن عاصم عنه وروي عنه عبيد بن حنين ايضا قال ابو عمر من قال فيه رافع بن المعلي فقد وهم لانه قتل ببدر وهذا اصح ما قيل فيه الحارث بن نفيع بن المعلي وارخوا وفاته سنة اربع وسبعين وقيل سنة ثلاث قالوا وعاش اربعا وستين سنة قلت وهو خطا فانه يستلزم ان تكون قصته مع النبي صلي الله عليه وسلم وهو صغير وسياق الحديث يابي ذلك فان في حديثه الذي في الصحيح كنت اصلي فمر بي النبي صلي الله عليه وسلم فدعاني فلم اته حتي فرغت من صلاتي الحديث وله حديث اخر اوله كنا نغدو الي السوق قال ابو عمر امه اميمة بنت قرط بن خنساء من بني سلمة §  <> ابو سعيد الانصاري زوج اسماء بنت يزيد بن السكن يقال اسمه سعيد بن عمارة ويقال عمارة بن سعيد ويقال عامر بن مسعود وهي الحاكم ابو احمد القول الاخير وقال عامر بن مسعود تابعي اخر يكني ابا سعيد واخرج بن منده من طريق محمد بن المهاجر بن زياد عن ابيه ان ابا سعيد الانصاري مر بمروان بن الحكم يوم الدار وهو صريع فقال لو اعلم يا بن الزرقاء انه انت لاجهزت عليك فحقدها عليه عبد الملك بن مروان فلما استخلف اتي به فقال احفظ فيها وصية رسول الله صلي الله عليه وسلم قال وماذا قال قال اقبلوا من محسنهم وتجاوزوا عن مسيءهم فتركه قال وكان ابو سعيد زوج اسماء بنت يزيد بن السكن ويقال انه ابو سعيد الزرقي الاتي وبه جزم المزي وجزم بن مندة بالمغايرة بينهما ولعله اصوب ابو سعيد سعد بن عامر بن مسعود الزرقي ذكره بن السكن واخرج من طريق عبد الله بن يوسف التنيسي عن سعيد بن عبد العزيز عن مكحول قال ارسل عبد الملك بن مروان الي ابي سعيد سعد بن عامر بن مسعود الزرقي ويقال انه لقي النبي صلي الله عليه وسلم فساله عن الهدي وحدث عن عاءشة رضي الله عنها واخرج النساءي من طريق شعبة عن ابي العيص عن عبد الله بن مرة عن ابي سعيد الزرقي الحديث في العزل روي عنه عبد الله بن مرة ويونس بن ميسرة ومكحول الشامي قال سعيد بن عبد العزيز له صحبة وقيل انه الذي يقال له ابو سعد الخير ابو سعيد الانماري ويقال ابو سعد قال خليفة هو من انمار مذحج قال ابو احمد لست احفظ له اسما ولا نسبا وحديثه في اهل الشام ثم اورد من طريق مروان بن محمد عن معاوية بن سلام اخي زيد بن سلام انه سمع جده ابا سلام الخشني قال حدثني عبد الله بن عامر اليحصبي سمعت قيس بن حجر يحدث عن عبد الملك بن مروان قال حدثني ابو سعيد الانماري انه سمع رسول الله صلي الله عليه وسلم يقول ان الله وعدني ان يدخل الجنة من امتي سبعين الفا بغير حساب ثم يشفع كل الف لسبعين الفا ويحثي له بكفيه ثلاث حثيات قال قيس فاخذت بتلابيب ابي سعيد فقلت انت سمعت هذا من رسول الله صلي الله عليه وسلم قال سمعت من رسول الله صلي الله عليه وسلم وعاه قلبي ففعل ذلك ثلاثا قال ابو سعيد فحسبت ذلك عند رسول الله صلي الله عليه وسلم فاذا هو اربعماءة الف الف وتسعون الف الف فقال الله اكبر ان هذا لمستوعب مهاجرينا ونستعين بشء من اعرابنا قلت سنده صحيح وكلهم من رجال الصحيح الا قيس بن حجر وهو شامي ثقة ولكن اخرجه الحاكم ابو احمد ايضا من طريق ابي توبة عن معاوية بن سلام فقال ان قيس بن حجر الكندي حدث الوليد بن عبد الملك ان ابا سعيد الخير حدثه واخرجه الطبراني من طريق ابي توبة عن معاوية فقال ان ابا سعيد الانماري وقيل قيس بن الحارث واخرجه ايضا من وجه اخر عن الزبيدي عن عبد الله بن عامر فقال عن قيس بن الحارث ان ابا سعيد الخير الانصاري حدثه فذكر طرفا منه فمن هذا الاختلاف يتوقف في الجزم بصحة هذا السند وجزم الخطيب في المءتلف وتبعه بن ماكولا بانه ابو سعد الخير واسمه بجير بموحدة ثم مهملة بوزن عظيم وسلف الخطيب في ذلك ابو الحسن بن سميع في طبقات الحمصيين فانه ذكره كذلك فيمن سكن الشام من الصحابة وساق حديثه بن جوصا كذلك ابو سعيد غير منسوب افرده الحاكم عن الذي قبله فاخرج من طريق الوليد بن مسلم حدثنا §  <> بن جابر حدثنا الحارث بن محمد الاشعري عن رجل يكني ابا سعيد قال قدمت من العالية الي المدينة فما بلغتها حتي اصابني جهد فبينا انا امشي في سوق من اسواق المدينة اذ سمعت رجلا يقول لصاحبها اشعرت ان النبي صلي الله عليه وسلم قري الليلة فلما سمعت بالقري وبي ما بي من الجهد اتيته فقلت يا رسول الله اقريت الليلة قال اجل قلت وما ذاك قال طعام في صحنه قلت فما صنع فضلة قال رفع قلت يا رسول الله في اول امتك تكون ام في اخرها قال في اولها ويلحقوني افنادا يعني يلحق بعضهم بعضا واخرجه بن مندة من وجه اخر عن بن جابر ولم يسق لفظه ورجاله ثقات ابو سعيد بن زيد كذا وقع في المسند رواية القطيعي عن عبد الله بن احمد بن حنبل من طريق جابر الجعفي عن الشعبي قال اشهد علي ابي سعيد بن زيد ان رسول الله صلي الله عليه وسلم مرت به جنازة فقام ورواه الطبراني عن عبد الله بن احمد بن حنبل بهذا السند فقال اشهد علي ابي سعيد الخدري قال بن الاثير وكانه اصح قلت وليس كذلك بل ما ظنه وهما فقد رواه البغوي عن عبد الله بن احمد كما وقع عند القطيعي ثم وجدت في مسند سعيد بن زيد احد العشرة في مسند البزار ما نصه حدثنا ابو سعيد وقيل ابو سعد روي عن النبي صلي الله عليه وسلم البر والصلة وحسن الجوار عمارة الديار وزيادة في الاعمار روي عنه ابو مليكة قاله ابو عمر قال وفيه نظر ابو سعيد العبسي ذكر الواقدي عن النضر بن سعيد العبسي عن ابيه عن جده قال جعل رسول الله صلي الله عليه وسلم شعار بني عبس عشرة ابو سفيان بن الحارث بن عبد المطلب بن هاشم الهاشمي بن عم رسول الله صلي الله عليه وسلم واخوه من الرضاعة ارضعتهما حليمة السعدية قال بن المبارك وابراهيم بن المنذر وغيرهما اسمه المغيرة وقيل اسمه كنيته والمغيرة اخوه وكان ممن يشبه رسول الله صلي الله عليه وسلم ومضي له ذكر مع عبد الله بن ابي امية واخرجه الحاكم ابو احمد من طريق حماد بن سلمة عن هشام بن عروة عن ابيه قال قال رسول الله صلي الله عليه وسلم ابو سفيان بن الحارث سيد فتيان اهل الجنة قال حلقه الحلاق بمني وفي راسه ثءلول فقطعه فمات قال فيرون انه مات شهيدا هذا مرسل رجاله ثقات وكان ابو سفيان ممن يءذي النبي صلي الله عليه وسلم ويهجوه ويءذي المسلمين والي ذلك اشار حسان بن ثابت في قصيدته المشهورة هجوت محمدا فاجبت عنه وعند الله في ذاك الجزاء ويقال ان عليا علمه لما جاء ليسلم ان ياتي النبي صلي الله عليه وسلم من قبل وجهه فيقول تالله لقد اثرك الله علينا الاية ففعل فاجابه لاتثريب عليكم الاية فانشده ابو سفيان لعمرك اني يوم احمل راية لتغلب خيل اللات خيل محمد فكالمدلج الحيران اظلم ليله فهذا اواني حين اهدي فاهتدي الابيات واسلم ابو سفيان في الفتح لقي النبي صلي الله عليه وسلم وهو متوجه الي مكة فاسلم شهد حنينا فكان ممن ثبت مع النبي صلي الله عليه وسلم واخرج مسلم من طريق كثير بن العباس بن عبد §  <> المطلب عن ابيه قصة حنين قال فطفق النبي صلي الله عليه وسلم يركض بغلته نحو الكفار وانا اخذ بلجامها اكفها وابو سفيان بن الحارث اخذ بركابه فقال يا عباس ناد يا اصحاب الشجرة الحديث واخرجه الدولابي من حديث ابي سفيان بن الحارث بسند منقطع ويقال انه لم يرفع راسه الي رسول الله صلي الله عليه وسلم حياء منه وذكر محمد بن اسحاق له قصيدة رثي بها النبي صلي الله عليه وسلم لما مات يقول فيها لقد عظمت مصيبتنا وجلت عشية قيل قد مات الرسول وقد اسند عنه حديث اخرجه الدارقطني في كتاب الاخوة وابن قانع من طريق سماك بن حرب سمعت شيخا في عسكر مدرك بن المهلب بسجستان يحدث عن ابي سفيان بن الحارث قال قال رسول الله صلي الله عليه وسلم لا يقدس الله امة لا ياخذ الضعيف فيها حقه من القوي وسنده صحيح لولا هذا الشيخ الذي لم يسم وانشد له ابو الحسن مما قاله يوم حنين ان بن عم المرء من اعمامه بني ابيه قوة من قدامه فان هذا اليوم من ايامه يقاتل الحرمي عن احرامه يقاتل المسلم عن اسلامه الابيات وذكر عمر بن شبة في اخبار المدينة عن عبد العزيز بن عمران قال بلغني ان عقيل بن ابي طالب راي ابا سفيان يجول بين المقابر فقال يا بن عمي ما لي اراك هنا قال اطلب موضع قبري فادخله داره وامر بان يحفر في قاعها قبرا ففعل فقعد عليه ابو سفيان ساعة ثم انصرف فلم يلبث الا يومين حتي مات فدفن فيه ويقال انه مات سنة خمس عشرة في خلافة عمر فصلي عليه ويقال سنة عشرين ذكره الدارقطني في كتاب الاخوة ووقع عند البغوي في ترجمته انه اخرج من طريق ابي بكر بن عياش عن عاصم الاعور قال اول من بايع تحت الشجرة ابو سفيان بن الحارث ولم يصب في ذلك فقد اخرجه غيره من هذا الوجه فقال ابو سنان بن وهب وهو الصواب وهو المستفيض عند اهل المغازي كلهم واسم ابي سنان عبد الله وقد تقدم في العبادلة وتاتي قصته قريبا في ابي سنان ابو سفيان صخر بن حرب بن امية بن عبد شمس مشهور باسمه وكنيته ويكني ابا حنظلة تقدم في الاسماء ابو سفيان سراقة بن مالك مشهور باسمه ابو سفيان مدلوك تقدما في الاسماء ابو سفيان بن الحارث لم يسم ولم ينسب رفيق بريدة ذكر بن اسحاق انه استشهد باحد اورده المستغفري من طريقه واستدركه ابو موسي ولعله الذي بعده ابو سفيان بن الحارث بن قيس بن زيد بن ضبيعة بن زيد بن مالك بن عوف الانصاري الاوسي ذكر العدوي انه استشهد باحد وذكر بن الكلبي انه شهد بدرا وقال البلاذري كان يقال له ابو البنات فلما كان باحد قال اقاتل ثم ارجع الي بناتي فلما انهزم المسلمون قال اللهم اني لا اريد ان ارجع الي بناتي ولكن اريد ان اقتل في سبيلك فقتل فاثني عليه النبي صلي الله عليه وسلم بذلك ابو سفيان غير منسوب روي عن النبي صلي الله عليه وسلم عمرة في رمضان تعدل حجة روي عنه ابنه عبد الله ذكره ابو عمر فقال اسناده مدني ابو سفيان بن حويطب بن عبد العزي القرشي العامري قال ابو عمر اسلم مع ابيه يوم الفتح §  <> وقتل هو يوم الجمل ابو سفيان بن ابي وداعة السهمي اسمه عبد الله تقدم ابو سفيان السدوسي قال بن مندة روي ابو موسي محمد بن المثني عن عمرو بن سفيان عن ابيه عن جده قال اصبحت مشركا وامسيت مسلما ابو سفيان بن محصن الاسدي وقع في نسخة احمد بن خازم بالمعجمتين رواية عبد الله بن لهيعة عنه عن صالح مولي التوامة عن عدي مولي ام قيس بنت محصن عن ابي سفيان بن محصن قال رمينا مع رسول الله صلي الله عليه وسلم الجمرة يوم النحر ثم لبست القميص فقال لنا رسول الله صلي الله عليه وسلم لا تلبس قميصا بعد هذا اليوم حتي تفيض اخرجه بن مندة ورواه ابراهيم بن ابي علي عن صالح عن عدي عن ابي سفيان اخرجه ابو نعيم ورجحه بناء منه علي انه ابو سنان بن وهب بن محصن وفيه نظر لان ابا سنان قيل انه مات في حصار قريظة وذلك قبل حجة الوداع بمدة طويلة فالظاهر ان الاول اولي فكانه عمه ولا مانع ان يرويا جميعا قصة واحدة ابو سفيان القرشي احد عمال عمر تقدم ذكره في اوس بن خالد بن يزيد الطاءي وانه قتل في عهد عمر رضي الله عنه وقد تقدم انه لم يبق في حجة الوداع قرشي الا اسلم وشهدها ابو سفيان بن وهب بن ربيعة بن اسد بن صهيب بن مالك بن كثير بن غنم بن دودان بن اسد بن خزيمة الاسدي ذكره بن حبان في الصحابة وانه شهد بدرا وتبعه المستغفري ويحتمل ان يكون هو ابا سنان بن وهب بن محصن وقع في اسمه تصحيف وفي نسبه تغيير والا فهو اخر من اقاربهم ابو سكينة مصغرا وقيل بفتح اوله ذكره عبد الصمد بن سعيد فيمن نزل حمص من الصحابة وقال اسمه محلم بن سوار وقال البغوي سكن الشام وقال بن مندة لا يثبت ثم ساق حديثه من طريق يزيد بن ربيعة عن بلال بن سعد سمعت ابا سكينة وكان من اصحاب النبي صلي الله عليه وسلم فذكر حديثا في فضل العتق ومن هذا الوجه اخرجه بن الجارود والباوردي وابن السكن ويزيد ضعيف وقد جاء عنه من طرق عن ابي توبة عن يزيد ليس فيها انه من الصحابة منها عند البغوي عن زهير بن محمد عن ابي توبة وذكره ابو عمر بوزن طريقة وزاد اوله الالف واللام فقال ابو السكينة قال بن فتحون تبع في ذلك ابا احمد الحاكم ابو سلافة هو الذي بعده ابو سلالة بضم اوله ولامين الاولي خفيفة الاسلمي ويقال ابو سلافة بالفاء بدل اللام وقيل بالميم بدلها قال ابو عمر تبعا لابي حاتم حديثه عند حكام بن سلم عن عنبسة بن سعيد عن عاصم بن عبيد الله عن عبد الله بن عبد الله عنه وهذا ماخوذ من كلام البخاري في الكني المفردة فقال قال حكام عن عنبسة بن سعيد عن عاصم بن عبيد الله عن عبد الله بن عبد الله عن ابي سلالة الاسلمي قال قال النبي صلي الله عليه وسلم سيكون عليكم اءمة يحدثونكم فيكذبونكم واورده ابو احمد الحاكم من طريق §  <> البخاري ووصله بن منده من طريق ابي حاتم الرازي عن يوسف بن موسي عن حكام وكذا اخرجه بن الجارود عن ابي حاتم الرازي لكن نسبه سلميا قال ابو موسي قال بن منده مرة اخري ابو سلامة وقال الطبراني ابو سلام وتعلق به ابو موسي فاستدركه قلت جزم البغوي وابو علي بن السكن بانه ابو سلامة وقال بن السكن له صحبة ثم ساق بن السكن من طريق عبد الرحمن بن شريك عن ابيه عن عاصم بن عبيد الله عن ابيه قال نزل بنا ابو سلامة السلمي فاضفناه شهرين فحدثنا انه سمع رسول الله صلي الله عليه وسلم يقول سيكون عليكم امراء ارزاقكم بايديهم فيمنعونكم منها حتي تصدقوهم بكذبهم وتعينوهم علي ظلمهم فاعطوهم الحق ما قبلوه منكم فان غادروه فقاتلوهم فمن قتل علي ذلك فهو شهيد واورده البغوي عن ابي بكر بن ابي شيبة عن شريك عن منصور عن عبيد الله بن علي عن ابي سلامة السلامي قال قال رسول الله صلي الله عليه وسلم اوصي امرا بامه الحديث ورايته في نسخة معتمدة من كتاب بن السكن بالفاء بدل الميم والسلمي بدل الاسلمي وفي نسخة من البغوي السلامي وممن ذكر انه ابو سلالة بلامين ابو عبيد الله المرزباني في كتاب السيرة العادلة وممن نسبه سلميا الباوردي فالله اعلم ابو سلامة السلامي ذكر في الذي قبله ابو سلام بفتح اوله وتشديد اللام خادم رسول الله صلي الله عليه وسلم قال ابو احمد الحاكم عداده في موالي رسول الله صلي الله عليه وسلم وله صحبة وذكره خليفة بن خياط في تسمية الصحابة من موالي بني هاشم وساق الحاكم من طريق مسعر حدثني ابو عقيل عن سابق بن ناجية عن ابي سلام خادم رسول الله صلي الله عليه وسلم عن النبي صلي الله عليه وسلم قال ما من مسلم يقول حين يصبح وحين يمسي رضيت بالله ربا الحديث وفيه الا كان حقا علي الله ان يرضيه واخرجه بن ابي شيبة عن محمد بن بشر عن مسعر هكذا واخرجه البغوي عن ابي بكر وقد اخرجه ابو داود والنساءي من طريق شعبة عن ابي عقيل عن سابق عن ابي سلام انه كان في مسجد حمص فمر به رجل فقالوا هذا خدم النبي صلي الله عليه وسلم فقام اليه فقال حدثني فذكر هذا الحديث نحوه واخرجه النساءي والبغوي ايضا من طريق هشيم عن ابي عقيل هاشم بن بلال قال حدثنا سابق بن ناجية عن ابي سلام قال مر بنا رجل اشعث فقيل هذا قد خدم النبي صلي الله عليه وسلم فقلت له خدمت رسول الله صلي الله عليه وسلم فقال نعم فقلت له حدثني عنه بحديث لم يتداوله بينك وبينه احد قال سمعته يقول من قال حين يصبح الحديث وعلي هذا فابو سلام رواه عن الخادم والخادم مبهم وقد اخرجه ابو داود في العلم من طريق شعبة حديثا اخر قال فيه عن شعبة بهذا السند عن ابي سلام عن رجل خدم النبي صلي الله عليه وسلم وقد وقع في هذا السند خطا اخر بينته في ترجمة سابق من حرف السين من القسم الاخير وحديث شعبة في هذا هو المحفوظ وابو سلام المذكور هو ممطور الحبشي وهو تابعي وانما لم اذكر هذه الترجمة في القسم الاخير لعد خليفة في موالي رسول الله صلي الله عليه وسلم ابا سلام فلعله اخر لم يرو شيءا بخلاف صاحب الترجمة §  <> ابو سلامة الثقفي ذكر في الصحابة قيل اسمه عروة هكذا اورده بن عبد البر ابو سلامة السلمي ويقال الحبيبي اسمه خداش ولا يعرف الا بحديث واحد اوصي امرا بامه الحديث قاله ابو عمر قلت روي الحديث احمد وابن ماجة وغيرهما من طريق منصور عن عبيد بن علي عن ابي سلامه وقد اشرت الي ذلك في حرف الخاء المعجمه واخرجه الدولابي من طريق شيبان عن منصور فزاد بين عبيد وابي سلامه عرفطه السلمي ابو سلمة بن سفيان بن عبد الاسد بن اخي الذي بعده مات ابوه كافرا قبل بدر كما تقدم في ترجمة اخيه الاسود وام هذا ام جميل بنت المغيرة بن ابي العاص بن امية وله عقب منهم محمد بن عبد الرحمن بن ابي سلمة بن سفيان المعروف بالاوقص قاضي المدينة في زمن موسي الهادي ثم ولي قضاء بغداد بعد الرشيد ذكره الزبير بن بكار ابو سلمة بن عبد الاسد بن هلال بن عبد الله بن عمر بن مخزوم المخزومي احد السابقين الي الاسلام اسمه عبد الله وتقدم في الاسماء ابو سلمة غير منسوب قال ابو احمد الحاكم له صحبة واثني عليه في خلافته لما شكته اليه امراته فاخرج ابو بكر بن ابي عاصم وابو احمد الحاكم من وجهين عن حماد بن زيد عن معاوية بن قرة المزني قال اتيت المدينة في زمن الاقط والسمن والاعراب ياتون بالبر فاذا رجل طامح بصره ينظر الي الناس فظننت انه غريب فدنوت فسلمت عليه فرد علي السلام وقال لي من اهل هذه البلدة انت قلت نعم وجلست معه فقلت من انت قال من بني هلال واسمي كهمس ثم قال لي الا احدثك حديثا شهدته من عمر بن الخطاب فقلت بلي فقال بينما نحن جلوس عنده اذ جاءته امراة فجلست اليه فقالت يا امير المءمنين ان زوجي كثر شره وقل خيره فقال لها ومن زوجك قالت ابو سلمة قال ان ذلك لرجل له صحبة وانه لرجل صدق ثم قال عمر لرجل عنده جالس اليس كذلك قال لا نعرفه يا امير المءمنين الا بما قلت فذكر الحديث وقد تقدم بعضه في ترجمة كهمس ابو سلمة غير منسوب اخر ذكره الحاكم ابو احمد مغايرا للذي قبله وساق من طريق احمد بن عبد الله بن حكيم قال قال ابراهيم الخزاعي ابو سلمة روي عن النبي صلي الله عليه وسلم قال قال الشيطان لا ينجو مني صاحب المال الحديث ابو سلمة جد عبد الحميد بن سلمة ذكره البغوي في الكني واخرج هو وابن ماجة من طريق عثمان البتي عن عبد الحميد بن سلمة عن ابيه عن جده ان ابويه اختصما الي النبي صلي الله عليه وسلم احدهما مسلم والاخر كافر فخيره فتوجه الي المسلم الحديث وقد تقدم موضحا في سلمة من حرف السين المهملة ووقع عند البغوي من وجه اخر عن عثمان البتي عن عبد الحميد بن ابي سلمة عن ابيه عن جده فترجم لوالد ابي سلمة وليس بجيد فان المحفوظ فيها عبد الحميد بن سلمة وفي قول من قال عبد الحميد بن ابي سلمة بزيادة ابي غلط محض ابو سلمي الراعي خادم رسول الله صلي الله عليه وسلم يقال اسمه حريث وقع مسمي عند بن منده وغيره تقدم في الاسماء ووقع حديثه عند البغوي بعلو غير مسمي ولا مكني ثم اخرجه §  <> من طريق ابي سلام الاسود قال حدثنا ابو سلمي ابو سلمي غير منسوب ذكره بن ابي حاتم قال قلت لابي روي السري بن يحيي قال قال ابو سلمي سمعت رسول الله صلي الله عليه وسلم يقرا في صلاة الغداة اذا الشمس كورت فقال قلت لحسان بن عبد الله لقي السري هذا الشيخ فقال نعم وهكذا ذكره ابو عمر نقلا من كتاب بن ابي حاتم وقد ذكره ابو احمد الحاكم فقال ابو سليمان او ابو سلمي ثم قال ابو سليمان او ابو سلمي في هذا الحديث وهم ولست ادري ممن جاء ولا اعرف للسري بن يحيي سماعا ولا رواية عن احد الصحابة وقد روي هذا الحديث ابو الوليد الطيالسي حدثنا السري بن يحيي حدثنا ابو سليم العنزي حدثني رجل من عنزة انه سمع النبي صلي الله عليه وسلم بهذا اخبرنيه ابراهيم بن محمد الفراءضي حدثنا سليم بن سيف حدثنا ابو الوليد فذكره وهو الصواب ويقال ان اول هذا مضموم بخلاف الذي قبله ابو سليط الانصاري البدري يقال اسمه اسير وقيل بزيادة هاء في اخره ويقال اسيد وقيل انس وقيل انيس مصغرا وقيل سبرة مشهور بكنيته مذكور في البدريين بها وله رواية اخرجها احمد والبغوي من طريق بن اسحاق حدثني عبد الله بن عمرو بن ضمرة الفزاري عن عبد الله بن ابي سليط عن ابيه قال اتانا نهي النبي صلي الله عليه وسلم عن اكل لحوم الحمر الانسية والقدور تفور فكفاناها علي وجوهها ابو سليمان خالد بن الوليد المخزومي سيف الله ابو سليمان مالك بن الحويرث الليثي تقدما في الاسماء ابو السمح مولي رسول الله صلي الله عليه وسلم يقال ان اسمه ابو ذر وقال البغوي خادم النبي صلي الله عليه وسلم روي عن النبي صلي الله عليه وسلم وروي عنه محل بن خليفة قال ابو زرعة لا اعرف اسمه ولا اعرف له غير حديث واحد واخرج حديثه بن خزيمة وابو داود والنساءي وابن ماجة والبغوي من طريق يحيي بن الوليد حدثنا محل بن خليفة حدثني ابو السمح قال كنت اخدم النبي صلي الله عليه وسلم فكان اذا اراد ان يغتسل قال ولني قفاك قال البزار لا نعلم حديث ابي السمح بغير هذا الطريق قال ابو عمر يقال انه قتل فلا يدري اين مات ابو السمح شرحبيل بن السمط الكندي تقدم في الاسماء ابو السنابل بن بعكك بموحدة ثم مهملة ثم كافين بوزن جعفر بن الحارث بن عميلة بفتح اوله بن السباق بن عبد الدار القرشي العبدري اسمه صبة بموحدة وقيل بنون وقيل عمرو وقيل عامر وقيل اصرم وقيل لبيد ربه بالاضافة قال البغوي سكن الكوفة وقال البخاري لا اعلم انه عاش بعد النبي صلي الله عليه وسلم روي عن النبي صلي الله عليه وسلم روي عنه الاسود بن يزيد النخعي وزفر بن اوس بن الحدثان النصري وقال بن سعد وغيره اقام بمكة حتي مات وهو من مسلمة الفتح واخرج حديثه الترمذي والنساءي وابن ماجة كلهم من رواية منصور عن ابراهيم عن الاسود في قصة سبيعة قال الترمذي لا نعرف للاسود سماعا من ابي السنابل وثبت ذكره في الصحيحين ايضا في §  <> قصة سبيعة الاسلمية لما مات زوجها فوضعت حملها وتهيات للخطاب فانكر عليها وقال حتي تعتدي اربعة اشهر وعشرا فسالت النبي صلي الله عليه وسلم فاعلمها ان قد حللت وهذا يدل علي ان ابا السنابل كان فقيها والا لكان يقع عليه الانكار في الافتاء بغير علم ولكن عذره انه تمسك بالعموم وقد خصت الحامل اذا وضعت من ذلك العموم ووقع عند البغوي من طريق مغيرة عن ابراهيم عن الاسود عن ابي السنابل ان سبيعة وضعت بعد وفاة زوجها ببضع وعشرين ليلة فتزينت وتعرضت للتزويج فقال لها ابو السنابل لا سبيل لك الي ذلك فاتت النبي صلي الله عليه وسلم فقال بلي ولو رغم انف ابي السنابل وذكر بن سعد انه كان ممن خطب سبيعة وذكر بن البرقي انه تزوجها بعد ذلك واولدها سنابل بن ابي السنابل ابو سنان بن وهب اسمه عبد الله ويقال وهب بن عبيد الله الاسدي قال موسي بن عقبة فيمن شهد بدرا ابو سنان بن وهب الاسدي ولم يسمه وقال الشعبي كان اول من بايع رسول الله صلي الله عليه وسلم تحت الشجرة ابو سنان بن وهب ولم يسمه اخرجه عمر بن شبة قالوا وهو غير ابي سنان بن محصن اخي عكاشة وام قيس لان بن محصن مات والنبي صلي الله عليه وسلم محاصر بني قريظة وكان ذلك قبل بيعة الرضوان تحت الشجرة واخرج الحاكم ابو احمد من طريق عاصم الاحول عن الشعبي قال اتاني عامري واسدي يعني كانا متفاخرين فقلت كان لبني اسد ست خصال ما كانت لحي من العرب كان اول من بايع بيعة الرضوان ابو سنان عبد الله بن وهب الاسدي قال يا رسول الله ابسط يدك ابايعك قال علي ماذا قال علي ما في نفسك وما في نفسي قال فتح وشهادة قال نعم فبايعه قال فخرج الناس يبايعون علي بيعة ابي سنان واخرجه الحسن بن علي الحلواني ومحمد بن اسحاق السراج من طرق عن اسماعيل بن ابي خالد عن الشعبي قال اول من بايع تحت الشجرة ابو سنان بن وهب فذكر القصة واخرجه بن منده من طريق عاصم عن زر بن حبيش قال اول من بايع تحت الشجرة ابو سنان بن وهب ووقع للبغوي فيه تصحيف مضي في ترجمة ابي سفيان بن الحارث بن عبد المطلب واخرج من طريق ابي نعيم الفضل بن دكين قال ابو سنان الاسدي اسمه وهب بن عبد الله وزعم الواقدي ان الذي وقع له ذلك سنان بن ابي سنان بن محصن بن اخي عكاشة قال واما ابو سنان فمات في حصار بني قريظة فالله اعلم ابو سنان بن محصن اخو عكاشة ذكره بن اسحاق فيمن شهد بدرا وهو عندي غير ابي سفيان بن محصن كما بينته قبل وان ابا سنان مات في حصار بني قريظة وابو سفيان حضر حجة الوداع وقد بينت انه غير الذي قبله ايضا وان كلام الواقدي يخالف ذلك ابو سنان الانصاري زوج ام سنان ثبت ذكره في الصحيحين من طريق عطاء عن بن عباس ان النبي صلي الله عليه وسلم قال لامراة من الانصار يقال لها ام سنان ما منعك ان تكوني حججت معنا قالت ناضحان كانا لابي فلان تعني زوجها حج هو وابنه علي احدهما وكان الاخر يسقي ارضا قال فعمرة في رمضان تعدل حجة وفي لفظ فاذا جاء رمضان فاعتمري ولمسلم فعمرة في رمضان تقضي حجة او حجة معي §  <> ابو سنان الاشجعي في ترجمة الجراح الاشجعي ويقال انه معقل بن سنان والراجح انه غيره ابو سنان بن صيفي بن صخر بن خنساء بن سنان بن عبيد بن عدي بن غنم بن كعب بن سلمة الانصاري السلمي ذكره بن اسحاق فيمن شهد بدرا واستشهد في الخندق ابو سنان العبدي ثم الصباحي بضم المهملة وتخفيف الموحدة قال ابو عبيدة معمر بن المثني كان في الوفد ومسح رسول الله صلي الله عليه وسلم وجهه بيده فعمر حتي بلغ تسعين سنة وهو مءذن مسجد بني صباح وكان وجهه يتلالا لمسح رسول الله صلي الله عليه وسلم له وكان شريفا وجيها ابو سنان بن حريث المخزومي ذكره الزبير بن بكار في ترجمة شماس بن عثمان المخزومي فقال لما مات عثمان بن شماس قالت بنت حريث المخزومية المخزومية وكانها كانت زوجته يا عين جودي بدمع غير ابساس وابكي رزية عثمان بن شماس صعب البديهة ميمون نقيبته حمال الوية ركاب افراس غريب مريع اذا ما ازمة ازمت يبري السهام ويبري قبة الراس قد قلت لما اتوا ينعونه جزعا اودي الجواد فاردي المطعم الكاسي قال وكان استشهد يوم احد قال فاجابها اخوها ابو سنان بن حريث اقني حياءك في ستر وفي خفر فانما كان عثمان من الناس لا تقتلي النفس ان حانت منيته في طاعة الله يوم الروع والباس قد مات حمزة ليث الله فاصطبري قد ذاق ما ذاق عثمان بن شماس ابو سهل بريدة بن الحصيب الاسلمي تقدم في الاسماء ابو سهل غير منسوب قال ابو عمر ذكر في الصحابة ولا اعرفه قلت ذكر في التجريد انه له في مسند بقي بن مخلد حديثا ابو سهلة الساءب بن خلاد تقدم في الاسماء ابو سود بضم اوله وسكون الواو التميمي يقال انه جد وكيع بن ابي سود الذي ثار بخراسان وقيل اسمه حسان بن قيس قاله بن قانع وفيه نظر فقد قال بن الكلبي في نسب بني تميم فمن بني غدانة بن يربوع بن حنظلة وكيع بن ابي سود وهو وكيع بن حسان بن قيس بن ابي سود بن كلب بن عوف بن نابل بن عوف بن غدانة وهو الذي قتل قتيبة بن مسلم امير خراسان وذلك في خلافة سليمان بن عبد الملك انتهي فظهر ان حسان والد وكيع وان ابا سود جد حسان وهذا هو المعتمد واخرجه احمد من طريق بن المبارك عن معمر عن شيخ من بني تميم عن ابي سود قال سمعت النبي صلي الله عليه وسلم يقول اليمين الفاجرة التي يقتطع بها الرجل مال المسلم تعقم الرحم واخرجه الحسن بن سفيان والبغوي وابن منده من طريق بن المبارك به واخرجه ابو علي بن السكن من طريق عبد الرزاق عن معمر به وقال بن دريد كان ابو سود جد وكيع مجوسيا وكذا قال بن الكلبي في كتاب المثالب قال ابو عمر هذا غير بعيد لان ديار بني تميم كانت مجاورة لديار الفرس قلت ويءيده ما في قصة حاجب والد عطارد بل في نسب ابي سود هذا ما يدل علي ذلك فان بابك من اسماء العجم فلعله الذي تمجس فتبعه §  <> ابناءه وتصريح ابي سود بسماعه من النبي صلي الله عليه وسلم وروايته عنه بعد ذلك وحمل التابعين لحديثه يدل علي اسلامه وصحبته وقد حكي ابو احمد الحاكم عن البخاري انه قال هذا الحديث مرسل فيحتمل ان يريد بارساله الذي لم يسم في السند وهو عند كثير من المحدثين مرسل انه في حكمه ويحتمل ان يكون وقع له بالعنعنة فلم يثبت عنده صحبته قال البغوي لا اعلم لابي سود الا هذا الحديث ولا اعلم رواه غير معمر ابو سويد الانصاري ويقال الجهني تقدم في ترجمة سويد الجهني في الاسماء ابو سويد ذكره البغوي وابو علي بن السكن في الصحابة وابو بشر الدولابي في الكني وغيرهم من طريق هشام بن سعد عن حاتم بن ابي نصر عن عبادة بن نسي عن رجل من اصحاب رسول الله صلي الله عليه وسلم يدعي ابا سويد ان رسول الله صلي الله عليه وسلم صلي علي المتسحرين هكذا وقع عند من صنف في الصحابة سويد اخره دال مصغر وضبطه اصحاب المءتلف والمختلف الدارقطني ومن تبعه بفتح اوله وكسر الواو وتشديد المثناة التحتانية بعدها هاء فالله اعلم ابو سيارة المتعي بضم الميم وفتح المثناة الفوقانية قال البغوي سكن الشام قيل اسمه عمرو وقيل عمير بن الاعلم وقيل اسمه الحارث بن مسلم وقيل عامر بن هلال ذكره بن السكن وغيره في الصحابة واخرج حديثه احمد والبغوي وابن ماجة وغيرهم من طريق سليمان بن موسي عن ابي سيارة المتعي قال اتيت النبي صلي الله عليه وسلم بعشور نحل لي الحديث وسليمان لم يدرك احدا من الصحابة فهذا لسند منقطع وقد ظن بعض الناس انه ابو سيارة الذي كان يفيض بالناس من عرفات في الجاهلية وليس كذلك فقد ذكر الفاكهي ان ابا سيارة كان قبل ان يغلب قصي علي مكة فهذا يدل علي تقدم عصره علي زمن البعثة ويءيد التفرقة بينهما ان هذا متعي وذاك عدواني ويقال عامري من بني عامر بن لءي واسم هذا عمرو او عمير او عامر واسم ذاك عميلة مصغرا بن الاعزل بن خالد بن سعد بن الحارث بن قابس بن زيد بن عدوان العدواني ويقال كان من بني عبد بن بغيض بن عامر بن لءي وكان بحيز بقيس من عرفة لانهم كانوا اخواله حكاه الزبير بن بكار وذكر ايضا عن محمد بن الحسن المخزومي ان ابا سيارة كان يفيض علي حمار وان حماره عمر اربعين سنة من غير مرض حتي ضربوا به المثل فقالوا اصح من عير ابي سيارة ويقال ان الذي كان يفيض مات قبل البعثة وانه غير المتعي الذي سال عن عشور النحل والله اعلم ابو سيف القين بفتح القاف وسكون المثناة التحتانية بعدها نون وهو الحداد كان من الانصار وهو زوج ام سيف مرضعة ابراهيم ولد النبي صلي الله عليه وسلم ثبت ذكره في الصحيحين من طريق ثابت عن انس قال قال النبي صلي الله عليه وسلم ولد لي الليلة غلام فسميته باسم ابي ابراهيم ودفعته الي ام سيف امراة قين بالمدينة يقال له ابو سيف قال فانطلق اليه فانتهينا الي ابي سيف وهو ينفخ في كيره وقد امتلا البيت دخانا فاسرعت الي ابي سيف فقلت امسك يا ابا سيف جاء رسول الله صلي الله عليه وسلم فامسك فذكر الحديث هذا لفظ مسلم وفي رواية البخاري ودخلنا مع النبي صلي الله عليه وسلم علي ابي سيف القين وكان ظءرا لابراهيم بن النبي صلي الله عليه وسلم فاخذه فقبله الحديث وقد تقدم §  <> في ترجمة البراء بن اوس ان النبي صلي الله عليه وسلم دفع ابراهيم ولده الي ام بردة بنت المنذر زوج البراء بن اوس ترضعه وكان النبي صلي الله عليه وسلم ياتي اليه فيزوره ويقيل عندها اخرجه الواقدي فان كان ثابتا احتمل ان تكون ام بردة ارضعته ثم تحول الي ام سيف والا فالذي في الصحيح هو المعتمد ابو سيلان بكسر المهملة بعدها مثناة تحتانية ذكره بن حبان في الصحابة في الكني من حرف السين وقال يقال ان له صحبة وقد تقدم في العبادلة عبد الله بن سيلان فيحتمل ان تكون هذه كنيته القسم الثاني ابو سعد مالك بن اوس بن الحدثان النصري بالنون تقدم في الاسماء ابو سعد او ابو سعيد بن الحارث بن هشام المخزومي ذكر ابو الفرج الاصبهاني ان خالد بن العاص بن هشام تزوج بنته فاطمة واولدها الحارث بن خالد الذي ولي امرة مكة والعاص بن هشام قتل ببدر فلولده صحبة والحارث بن هشام صحابي مشهور استشهد في خلافة عمر فكان ابا سعد كان في العهد النبوي صغيرا وقد ذكر الزبير بن بكار ان صخرة بنت ابي جهل بن هشام كانت تحت ابي سعيد هذا وولدت له القسم الثالث ابو ساسان حضين بالضاد المعجمة مصغرا بن المنذر الرقاشي تقدم في الاسماء عده الحاكم فيمن سمع من العشرة ابو سجيف بالجيم بن قيس بن الحارث بن عباس له ادراك وشهد اليرموك في خلافة ابي بكر ثم شهد فتح مصر وسكنها ولما قدم مروان بن الحكم مصر بعد ان ولي الخلافة وقاتله اهلها وكانوا قد بايعوا لابن الزبير كان هذا من المعدود في منعه وكان من الفرسان فلما غلب مروان هرب ابو سجيف هذا الي طرابلس فسكنها الي ان مات ابو سعيد المقبري اسمه كيسان تقدم في الاسماء ابو سعيد مولي ابو اسيد بالتصغير الساعدي ذكره بن منده في الصحابة ولم يذكر ما يدل علي صحبته لكن ثبت انه ادرك ابا بكر الصديق رضي الله عنه فيكون من اهل هذا القسم قال بن منده روي عنه ابو نضرة العبدي قصة مقتل عثمان بطولها وهو كما قال وقد رويناها من هذا الوجه وليس فيها ما يدل علي صحبته ابو سلمة تميم بن حذلم تقدم في الاسماء §  <> ابو السمال الاسدي تقدم في سمعان بن هبيرة ابو سويد العبدي له ادراك ذكره البخاري في الكني وتبعه الحاكم ابو احمد وذكره من طريق وكيع عن بركة بن يعلي التيمي عن ابي سويد العبدي قال كنا بباب عمر فذكر قصة ورواه ابو عقيل عن بكرة عن ابي سويد العبدي قال اتينا بن عمر فجلسنا ببابه فذكر قصة وحديثا اخرجه احمد ووكيع احفظ من ابي عقيل والله اعلم القسم الرابع ابو سبرة النخعي صوابه الجعفي الماضي في القسم الاول صحفه بن منده ابو سعد الاعمي تابعي ارسل حديثا فذكره بعضهم في الصحابة قال الحميدي حدثنا سفيان عن عمرو بن دينار عن ابي سعيد الاعمي قال سفيان وحدثنا بن عطاء عن ابيه عن ابي سعد الاعمي ان رسول الله صلي الله عليه وسلم باع حرا في دين وذكره ابو احمد الحاكم في الكني فيمن لا يعرفه اسمه وقال انه يروي عن ابي هريرة ابو سعيد بن وهب القرظي كذا ذكره بن الاثير فوهم في الكنية وانما هو ابو سعد بسكون العين كما تقدم وهو النضري بفتح الضاد المعجمة من بني النضير لا من بني قريظة ابو سعيد غير منسوب روي عنه مكحول اخرجه بن عبد البر مختصرا كذا ذكره بن الاثير والذي في الاستيعاب ابو سعدان كما تقدم ابو سفينة الحارث بن عمرو السهمي كذا وقع في الكمال لعبدالغني واقره المزي والصواب ابو مسقبة وسياتي في الميم ابو سلام الاسلمي افرده ابو موسي فوهم كما نبهت عليه ابو سلمة الانصاري جد عبد الحميد بن سلمة خيره النبي صلي الله عليه وسلم بين ابويه اسمه رافع كذا قال ابو موسي والصواب ان جد عبد الحميد اسمه سلمة وانه في الرواية لجده وهو عبد الحميد بن زيد بن سلمة واما رافع جد عبد الحميد فانه غير هذا وهو عبد الحميد بن جعفر ابو سلمة الخدري ذكره بعضهم في الصحابة وهو خطا نشا عن سقط والصواب عن ابي سلمة وهو بن عبد الرحمن عن الخدري وهو ابو سعيد فسقطت عن من السند فالله اعلم ابو سليمان من ال جبير بن مطعم ذكره البغوي في الصحابة وقال سكن المدينة وهو غلط في ظنه انه له صحبه فانه اخرج من رواية زهير بن محمد عن عبد الله بن ابي بكر بن حزم عن عثمان بن ابي سليمان عن ابيه انه سمع النبي صلي الله عليه وسلم وهو يقرا في المغرب بالطور وقال بن السكن الصواب ما رواه سعيد بن سلمة بن ابي الحسام عن عبد الله بن ابي بكر عن عثمان بن ابي سليمان عن نافع بن جبير بن مطعم عن ابيه وقال ورواه بن جريج عن عثمان بن ابي سليمان عن جبير قال الدارقطني ان كان زهير اراد بقوله عن ابيه اباه الادني فهو وهم لان ابا سليمان هو بن جبير بن مطعم ولا صحبة له وان كان اراد اباه الاعلي فهو نظير رواية بن جريج والصواب رواية سعيد بن سلمة والله اعلم §  <> ابو سهلة مولي عثمان ويقال ابو شهلة بالمعجمة يقال ان له صحبة روي عنه قيس بن ابي حازم كذا في التجريد ولم ينبه علي كونه تابعيا وانما روي عن عثمان مولاه وعن عاءشة حديثا في فضاءل عثمان فارسله بعضهم كما اورده ابو احمد الحاكم في ترجمته فقد اخرج الترمذي وابن ماجة حديثه المذكور من طريق اسماعيل بن ابي خالد عن قيس بن ابي حازم عنه عن عاءشة وذكره في التابعين البخاري وابن حبان والعجلي وغيرهم وذكر الدارقطني ان محمد بن بشر قاله في روايته عن اسماعيل بن ابي خالد بالشين المعجمة والصواب بالمهملة حرف الشين المعجمة القسم الاول ابو شاه اليماني يقال انه كلبي ويقال انه فارسي من الابناء الذين قدموا اليمن في نصرة سيف بن ذي يزن كذا رايت بخط السلفي وقيل ان هاءه اصلية وهو بالفارسي معناه الملك قال ومن ظن انه باسم احد الشياه فقد وهم انتهي وقد ثبت ذكره في الصحيحين في حديث ابي هريرة في خطبة النبي صلي الله عليه وسلم يوم الفتح فقام رجل يقال له ابو شاه فقال اكتبوا لي يا رسول الله فقال اكتبوا لابي شاه يعني الخطبة المذكورة ابو شباث بتخفيف الموحدة واخره مثلثة اسمه خديج بن سلامة تقدم ابو شبيب غير منسوب ولا مسمي ذكر في التجريد وان له في مسند بقي بن مخلد حديثا واحدا ابو شجرة السلمي تقدم في عمرو بن عبد العزي ويقال اسمه سليم بن عبد العزي وامه الخنساء الشاعرة وكان يسكن البادية ذكر الزبير بن بكار في ترجمة خالد بن الوليد قال وقال ابو شجرة بن عبد العزي السلمي في قتال خالد اهل الردة ولو سالت سلمي غداة مرامر كما كنت عنها ساءلا لو نايتها وكان الطعان في لءي بن غالب غداة الجواء حاجة فقضيتها قال وقال ايضا ورويت رمحي من كتيبة خالد واني لارجو بعدها ان اعمرا في ابيات قلت والي هذا البيت قصته مع عمر ذكرها المبرد في الكامل قال اتي ابو شجرة عمر يستحمله فقال له من انت قال انا ابو شجرة السلمي فقال يا عدو نفسه الست القاءل فذكر البيت ثم انحني عليه بالدرة فهرب وركب ناقته وهو يقول §  <> قد ضن عنا ابو حفص بناءله وكل مختبط يوما له ورق وانما ذكرته في هذا القسم لان الخنساء اسلمت هي واولادها كما سابينه في ترجمتها وقال المرزباني يقال اسمه عمرو ويقال عبد الله بن عبد العزي بن قطن بن رياح بن عصر بن معيص بن خفاف بن امرء القيس بن بهز بن سليم ويقال هو عمرو بن الحارث بن عبد العزي مخضرم كثير الشعر وله مع عمر خبر مشهور يعني خبره معه الماضي وله من ابيات في العباس بن مرداس يقول فيها وعباس يدب لي المنايا وما اذنبت الا ذنب صخر وبقية خبره في عمرو بن عبد العزي من كتاب الردة للواقدي ابو شجرة الكندي اسمه معاوية بن محصن تقدم ابو شجرة الرهاوي يزيد بن شجرة تقدم ابو شراك الفهري من بني ضبة بن الحارث بن فهر ذكره الواقدي وابو معشر في اهل بدر وان اسمه عمرو بن ابي عمرو وجوز محمد بن سعد انه عمرو بن الحارث الذي تقدم ان موسي بن عقبة ذكره وقال الواقدي مات ابو شراك سنة ست وثلاثين ابو شريح الخزاعي ثم الكعبي خويلد بن عمرو وقيل عمرو بن خويلد وقيل هانء وقيل كعب بن عمرو وقيل عبد الرحمن والاول اشهر وبكعب جزم بن نمير وابو خيثمة وتردد هارون الحمال في خويلد وكعب وقال الطبري هو خويلد بن عمرو بن صخر بن عبد العزي بن معاوية من بني عدي بن عمرو بن ربيعة اسلم قبل الفتح وكان معه لواء خزاعة يوم الفتح روي عن النبي صلي الله عليه وسلم احاديث وروي ايضا عن بن مسعود رضي الله عنه روي عنه نافع بن جبير بن مطعم وابو سعيد المقبري وابنه سعيد بن ابي سعيد وفضيل والد الحارث وسفيان بن ابي العوجاء قال بن سعد مات بالمدينة سنة ثمان وستين ذكره في طبقات الخندقيين وقال اسلم قبل الفتح وكذا قال غير واحد في تاريخ موته وله قصة مع عمرو بن سعيد الاشدق لما كان امير المدينة ليزيد بن معاوية ففي الصحيحين ان ابا شريح قال لعمرو وهو يجهز البعث الي مكة اءذن لي ايها الامير ان احدثك فذكر حديث لا يحل ان يسفك بها دما يعني بمكة الحديث وفيه قوله عمرو بن سعيد ان الحرم لا يعيذ عاصيا قال الطبري مات بالمدينة سنة ثمان وستين ابو شريح الحارثي اسمه هانء بن يزيد تقدم في الاسماء وان النبي صلي الله عليه وسلم كناه باكبر اولاده ابو شريح الانصاري قال ابو عمر لست اعرفه بغير كنيته وذكره هكذا ذكروه في الصحابة قلت وفي كتاب المستغفري ابو شريح غير منسوب ولم ينسبه انصاريا فما ادري اهما واحد او اثنان ثم بان لي ان الذي ذكره المستغفري هو ابو شريح الخزاعي فانه ذكر له انهم قالوا هو الخزاعي وذكر انه روي عن النبي صلي الله عليه وسلم انه قال ان اعتي الناس علي الله رجل قتل غير قاتله انتهي وهذا من حديث ابي شريح الخزاعي واورده عبد الله بن احمد في زيادات المسند من طريق عبد الرحمن بن اسحاق عن الزهري عن عطاء بن يزيد عن ابي شريح في مسند ابي شريح الخزاعي §  <> ابو شعيب اللحام من الانصار وقع ذكره في الصحيح من حديث ابي مسعود البدري قال جاء رجل من الانصاري يكني ابا شعيب فقال لغلام له لحام اصنع لي طعاما يكفي خمسة فدعا النبي صلي الله عليه وسلم وقد وقع لنا في الجزء التاسع من امالي المحاملي وفي كتاب البغوي وابن السكن وابن منده من طريق عبد الله بن نمير عن الاعمش عن واءل عن ابي مسعود عن رجل من الانصار يكني ابا شعيب قال اتيت النبي صلي الله عليه وسلم فرايت في وجهه الجوع فذكر الحديث قال بن منده رواه الثوري وشعبة والعباس فلم يقولوا عن ابي شعيب قالوا ان رجلا يقال له ابو شعيب ثم ساقه من طريق زهير بن معاوية وعمار بن زريق عن الاعمش عن ابي سفيان عن جابر ان رجلا يقال له ابو شعيب فذكر الحديث ابو شقرة التميمي روي عنه مخلد بن عقبة ذكره ابو عمر مختصرا قال ابو موسي استدركه يحيي بن منده علي جده وساق حديثه وقد ذكره جده الا انه لم يذكر حديثه واخرجه ابو نعيم من طريق الحسن بن سفيان ثم من رواية حماد بن يزيد المنقري حدثني مخلد بن عقبة عن ابي شقرة قال قال رسول الله صلي الله عليه وسلم اذا رايتم الفء عن رءوسهن مثل اسنمة البعير فاعلموهن انهن لا يقبل لهن صلاة قال بعض رواته والفء الفرع ابو شماس بن عمرو الجذامي ذكره بن اسحاق في وفد جذام الذين قدموا علي النبي صلي الله عليه وسلم باسلام قومهم وطلب رد سبيهم الذين سباهم زيد بن حارثة ابو شمر الضبابي هو ذو الجوشن تقدم ابو شمر بن ابرهة بن شرحبيل بن ابرهة بن الصباح الحميري ثم الابرهي ذكر الرشاطي عن الهمداني في انساب حمير انه وفد علي النبي صلي الله عليه وسلم وقتل مع علي بصفين قال الرشاطي لم يذكره بن عبد البر ولا بن فتحون وقال بن منده ابو شمر بن ابرهة بن الصباح الاصبحي يقال له صحبة ويجد ذكره في الاخبار قلت وذكر غيرهما انه وفد في عهد عمر فتزوج بنت ابي موسي الاشعري ويحتمل ان يكون وفد اولا ثم رجع الي بلاده ثم وفد لما استنفرهم عمر الي الجهاد ثم وجدته في تاريخ دمشق فقال ابو شمر بن ابرهة بن الصباح بن لهيعة بن شيبة بن مرة ثم قال اخو كريب بن ابرهة ثم قال هو مصري ثم قال وقيل انه وفد علي رسول الله صلي الله عليه وسلم ثم ساق من طرق عن بن وهب عن بن لهيعة عن الحارث بن يزيد ان عبد الله بن سعد غزا الاساود سنة احدي وثلاثين فاصيب عين معاوية بن خديج وابي شمر بن ابرهة وجندل بن شريح فسموا رماة الخندق ومن طريق يحيي بن بكير عن الليث انه كان من جملة الذين خرجوا من بن ابي حذيفة الي معاوية في الرهن ثم كسروا السجن وخرجوا وامتنع ابو شمر فقال لا ادخله اسيرا واخرج منه ابقا فاقام ثم وجدت له ذكرا في مقدمة كتاب الانساب للسمعاني من طريق بن لهيعة عن عبد الله بن راشد عن ربيعة بن قيس سمع عليا يقول ثلاث قباءل يقولون انهم من العرب وهم اقدم من العرب جرهم وهم بقية عاد وثقيف وهم بقية ثمود واقبل ابو شمر بن ابرهة فقال وقوم هذا وهم بقية تبع §  <> ابو الشموس البلوي قال بن السكن له صحبة ورواية ولا يوقف علي اسمه وقال البغوي سكن الشام وقال بن حبان يقال له صحبة قلت قد علق له البخاري حديثا ووصله في كتاب الكني المفردة ووقع لنا بعلو في المعجم الكبير للطبراني بسند فيه ضعف وهو من طريق سليمان بن مطير عن ابيه عن ابي الشموس البلوي ان النبي صلي الله عليه وسلم نهي اصحابه عن بتر الحجر الحديث قال البغوي وليس لابي الشموس غير هذا الحديث وفي اسناده ضعف ابو شميلة الشنءي بفتح المعجمة والنون بعدها همزة بغير مد ذكره ابو سعيد عن الاعرابي والمستغفري وغيرهما في الصحابة واوردوا من طريق محمد بن اسحاق عن حسين بن عبد الله عن عكرمة عن بن عباس قال كان ابو شميلة رجل من شنوءة غلب عليه الخمر وفي لفظ اتي بابي شميلة سكران وكان قد تتابع فيها فقبض رسول الله صلي الله عليه وسلم قبضة من تراب فضرب بها وجهه وقال اضربوه فضربوه بالثياب والنعال والايدي والمتيخ اي العصي الخفيفة او الجريدة الرطبة وهي بكسر الميم وسكون المثناة التحتانية ثم مثناة فوقانية مفتوحة ثم معجمة واستدركه بن فتحون ابو شهم ياتي في القسم الثالث ابو شهم صاحب الجبيذة تصغير جبذة بجيم وموحدة ساكنة ثم ذال معجمة لا يعرف اسمه ولا نسبه وقال البغوي سكن الكوفة وذكر بن السكن ان اسمه زيد او يزيد بن ابي شيبة واخرج حديثه النساءي والبغوي من طريق يزيد بن عطاء عن بيان عن قيس بن ابي حازم عن ابي شهم وكان رجلا بطالا فمرت به جارية فاهوي بيده الي خاصرتها قال فاتيت النبي صلي الله عليه وسلم الغد وهو يبايع الناس فقبض يده وقال اصاحب الجبيذة امس فقلت لا اعود يا رسول الله قال فنعم اذا فبايعه اسناده قوي ويقال اسم ابي شهم عبيد بن كعب وفي التابعين ابو شهم يروي عن عمر روي عنه اسماعيل بن ابي خالد ذكره ابو احمد في الكني بعد الصحابة ابو شيبة الانصاري الخدري قال ابو زرعة له صحبة ولا يعرف اسمه وقال بن السكن له حديث واحد ولا يعرف اسمه وقال البغوي كان بالروم وقال بن سعد في الطبقة الثالثة من الانصار ابو شيبة الخدري لم يسم لنا ولم نجد اسمه ولا نسبه في كتاب الانصاري وقال بن منده عداده في اهل الحجاز وقال الطبراني هو اخو ابي سعيد واخرج حديثه بن السكن والطبراني والبغوي والدولابي وابن منده من طريق يونس بن الحارث قال حدثني شرس بمعجمة ثم مهملة بينهما راء ساكنة عن ابيه قال خرجت مع معاوية في غزوة القسطنطينية فلما وصلنا ونحن نزول اذا رجل يهتف اقبلنا عليه فقال انا ابو شيبة الخدري سمعت رسول الله صلي الله عليه وسلم يقول من شهد ان لا اله الا الله مخلصا بها قلبه دخل الجنة كذا قال والصواب يزيد بن معاوية ولم يذكر الطبراني القصة ولا قال في السند عن ابيه وحكي ابو احمد الحاكم فيه الوجهين وتبعه ابو عمر واخرج بن عاءذ والدولابي وابن منده من طريق سليمان بن موسي الكوفي عن يونس بن الحارث سمعت شرسا يحدث عن ابيه قال توفي ابو شيبة الخدري ونحن علي حصار القسطنطينية اذ هتف ابو شيبة فقال يايها الناس فاقبلت اليه في ناس كثير فاذا §  <> هو مقنع علي راسه فقال من عرفني فانا ابو شيبة الخدري صاحب رسول الله صلي الله عليه وسلم سمعت رسول الله صلي الله عليه وسلم يقول من شهد ان لا اله الا الله مخلصا دخل الجنة فاعملوا ولا تتكلوا ومات فدفناه مكانه قال ابو حاتم الرازي شرس وابوه مجهولان ابو شيبة اخر غير منسوب ذكر الدارقطني في العلل ان حماد بن سلمة روي عن عبد الملك بن عمير عن ابي شيبة قال قال رسول الله صلي الله عليه وسلم اذا اتي احدكم الي القوم يوسع له اخوه فليقعد الحديث وفيه ثلاث تصفين لك ود اخيك قال ورواه ابو المطرف بن ابي الوزير عن موسي بن عبد الملك بن عمير عن ابيه عن شيبة بن عثمان عن عمه فانه كان حفظه فقد جوده ابو شيخ بن ابي ثابت الانصاري الخزرجي بن اخي حسان بن ثابت ذكره بن اسحاق فيمن شهد بدرا واحدا واستشهد ببءر معونة ومات ابوه ابي في الجاهلية وقال الواقدي وابن الكلبي هو ابي بن ثابت اخو حسان كنيته ابو شيخ ووافق بن اسحاق موسي بن عقبة فقال في البدريين وابو شيخ بن ابي بن ثابت ووافق بن الكلبي في انه اخو ابي حسان يحيي بن سعيد الاموي عن بن اسحاق القسم الثاني ابو شحمة بن عمر بن الخطاب جاء في خبر واه ان اباه جلده في الزنا فمات ذكره الجوذقاني فان ثبت فهو من اهل هذا القسم القسم الثالث ابو شجرة كثير بن مرة تقدم في الاسماء ابو شداد العماني ادرك النبي صلي الله عليه وسلم وقرا كتابه عليه وعاش ماءة وعشرين سنة ذكر البخاري وابن ابي خيثمة وسمويه في فواءده وابن السكن وغيرهم من طريق ابي حمزة عبد العزيز بن زياد الحنظلي حدثني ابو شداد رجل من اهل ذمار قرية من قري عمان قال جاءنا كتاب النبي صلي الله عليه وسلم في قطعة من ادم من محمد رسول الله الي اهل عمان سلام اما بعد فاقروا بشهادة ان لا اله الا الله واني رسول الله وادوا الزكاة وخطوا المساجد وكذا وكذا والا غزوتكم قال ابو شداد فلم نجد احدا يقرا علينا ذلك الكتاب حتي وجدنا غلاما فقرا علينا قلت فمن كان يومءذ علي عمان قال اسوار من اساورة كسري واخرج مطين من طريق ابي حمزة الحنظلي هذا قال رايت رجلا بعمان يكني ابا شداد بلغ عشرين وماءة سنة وقال ابو عمر ابو شداد العماني الذماري وتعقب بان ذمار من صنعاء لا من عمان وعمان بضم اوله والتخفيف من عمل البحرين وذمار قرية منها يقال بالميم والموحدة قاله الرشاطي ويحتمل ان كان ابو عمر حفظه ان يكون §  <> اصله من ذمار وسكن عمان وكذا تعقب بن فتحون في اوهام الاستيعاب قول ابي عمر الذماري وقوله في الراوي عنه عبد العزيز بن شداد وانما هو بن زياد ابو شداد اخر شامي قال الدولابي اسمه سالم وقال بن منده هو سالم بن سالم العبسي الحمصي واخرج ابو احمد الحاكم في الكني من طريق معن بن عيسي عن معاوية بن صالح عن ابي شداد وكان قد عقل متوفي رسول الله صلي الله عليه وسلم ولم يره ولم يسمع منه شيءا قال دخلت علي ابي امامة وهو يشرب طلاء قد ذهب ثلثاه وبقي ثلثه واخرجه الدولابي وابن منده من هذا الوجه عن رجل يقال له ابو شداد روي عن ابي امامة روي عنه معاوية بن صالح ابو شراحيل او ابو شرحبيل هو ذو الكلاع الحميري تقدم في الاسماء ابو شريك ذكره المستغفري في الصحابة واخرج من طريق بن اسحاق ان عمر اعطاه ارضا ابو شعيب غير منسوب له ادراك وشهد مع عمر فتح بيت المقدس اخرج احمد من طريق حماد بن سلمة عن ابي سنان عن عبيد بن ادم وابي مريم وابي شعيب ان عمر بن الخطاب كان بالجابية فذكر فتح بيت المقدس قال ابو سنان عن عبيد سمعت عمر يقول لكعب اين تري ان اصلي الحديث وقول عمر اصلي حيث صلي رسول الله صلي الله عليه وسلم اخرجه يعقوب بن شيبة من هذا الوجه اتم منه قال كان عمر بالجابية فقدم خالد بن الوليد الي بيت المقدس فذكر القصة في قوله انما يفتحها عمر بعد فتح قيسارية الي ان قال فشاور عمر الناس فقال انهم اصحاب كتاب وعندهم علم فذهبوا الي قيسارية ففتحوها وجاءوا الي بيت المقدس فصالحهم فصلي عند كنيسة مريم ثم بزق في احد قميصيه فقيل له ابزق فيها فانها يشرك فيها بالله فقال ان كان يشرك فيها بالله فانه يذكر الله فيها كثيرا ثم قال لقد كان عمر غنيا ان يصلي عند وادي جهنم وقال في قصة الصلاة اصلي حيث صلي رسول الله صلي الله عليه وسلم ليلة اسري به فتقدم الي القبلة فصلي وخلط بن عساكر ترجمة هذا بترجمة ابي شعيب الحضرمي الذي روي عن ابي ايوب في الاستنجاء وروي عنه عثمان بن ابي شوكة والذي يظهر لي انه غيره فان الحاكم ابا احمد حكي في الحضرمي انه يقال له ابو الاشعث ابو شمر بن قيس بن فهر بن عمرو بن وهب بن ربيعة بن معاوية الاكرمين الكندي قال بن الكلبي كان شاعرا شريفا في الجاهلية والاسلام ابو شهاب الهذلي والد ابي ذءيب غزا مع ابيه في خلافة عمر ذكره بن مرزوق في اشعار الهذليين ابو شهم التيمي من تيم الرباب جاهلي ادرك الاسلام ذكره ابو عبيدة معمر بن المثني في خبر الكلاب الاول فقال كان ابو شهم هو ربب الرباب قبل الاسلام وعاش الا خلافة عثمان بن عفان ابو شيبان له ادراك ذكره بن ابي شيبة من طريق معن بن عبد الرحمن قال غزا رجل نحو الشام يقال له شيبان وله اب شيخ كبير فقال ابوه في ذلك §  <> اشيبان ما يدريك ان رب ليلة غبقتك فيها والغبوق حبيب اامهلتني حتي اذا ما تركتني اري الشخص كالشخصين وهو قريب اشيبان ان تات الجيوش تجدهم يقاسون اياما بهن خطوب قال فبلغ ذلك عمر فرده ابو شييم المري ذكره الواقدي عن شيوخه قالوا كان ابو شييم المزني قد اسلم فحسن اسلامه يحدث ويقول لما نفرنا مع عيينة بن حصن يعني في الاحزاب رجع بنا فلما كان دون خيبر راي مناما فقدم فوجد النبي صلي الله عليه وسلم قد فتح خيبر فقال يا محمد اعطني مما غنمت من حلفاءي فاني انصرفت عنك وعن قتالك فلم يعطه شيءا فانصرف فلقيه الحارث بن عوف فقال له الم اقل لك والله ليظهرن محمد علي ما بين المشرق والمغرب القسم الرابع ابو شبل غير منسوب ذكره الدولابي في الصحابة وهو وهم وانما الحديث عند واصل بن مروزق عن رجل من بني مخزوم يكني ابا شبل عن جده وكان من الصحابة وسياتي بيانه في المبهمات ابو شجرة شيخ لابي الزاهرية ذكره الدولابي والمستغفري في الصحابة واستدركه ابو سي ونبه علي انه وهم وجوز بعضهم انه يزيد بن شجرة فانه يكني ابا شجرة وهو مختلف في صحبته لكن فرق ابو احمد الحاكم بين ابي شجرة يزيد بن شجرة وبين ابي شجرة شيخ ابي الزاهرية وهو الصواب فيما اري وقد تقدم في كثير بن مرة ان البغوي اورد في ترجمة من طريق ابي الزاهرية عن ابي شجرة حديثا وهو ان النبي صلي الله عليه وسلم قال اقيموا الصفوف الحديث وفيه ومن وصل صفا وصله الله والذي يظهر انه اخر غير كثير بن مرة والعلم عند الله ابو شريح غير منسوب له حديث في مسند بقي بن مخلد قال في التجريد لعله هانء بن يزيد قلت بل هو ابو شريح الخزاعي فالحديث حديثه ابو شريح المصري ارسل حديثا فذكره بعضهم في الصحابة فاخرج الساعدي من طريق الليث عن يزيد بن ابي حبيب عن محمد الانصاري عن ابي شريح المصري عن النبي صلي الله عليه وسلم قال ان سلام المءمن اذا كان عدة في سبيل الله يوزن كل يوم مع صالح عمله ابو شمير ذكره البغوي وقال انه وهم قال حدثنا محمد بن علي حدثنا ابو نعيم حدثنا عبد الله بن جابر بن ربيعة عن مجمع بن عتاب عن ابيه عن شمير قال قلت للنبي صلي الله عليه وسلم ان لي ابا شيخا كبيرا واخوة اذهب اليهم لعلهم ان يسلموا فاتيك بهم فقال ان هم اسلموا فهو خير لهم وان ابوا فالاسلام واسع او عريض قال البغوي احسب محمد بن علي وهم فيه وقد حدثناه ابو خيثمة §  <> عن ابي نعيم عن مجمع بن عتاب بن شمير عن ابيه يعني فتكون الصحبة لعتاب بن شمير ابو شهلة تقدم في حرف السين المهملة حرف الصاد المهملة القسم الاول ابو صالح حمزة بن عمر الاسلمي تقدم ابو صبرة ذكر في التجريد ان له في مسند بقي بن مخلد حديثا ابو صخر العقيلي ذكره البخاري ومسلم وابن حبان وغيرهم في الصحابة قيل اسمه عبد الله بن قدامة حكاه بن عبد البر واخرج بن خزيمة في صحيحه والحسن بن سفيان في مسنده من طريق سالم بن نوح عن الجريري عن عبد الله بن شقيق عن ابي صخر رجل من بني عقيل وربما قال عبد الله بن قدامة قال قدمت المدينة علي عهد رسول الله صلي الله عليه وسلم بتجارة لي فبعتها فقلت لو الممت برسول الله صلي الله عليه وسلم فاقبلت نحوه فتلقاني في بعض طرق المدينة وهو بين ابي بكر وعمر فجءت حتي كنت من خلفهم فمر يهودي ناشر التوراة يقرءها يعزي نفسه علي بن له ثقيل في الموت قال فمال رسول الله صلي الله عليه وسلم وملت معه فقال يا يهودي انشدك بالذي انزل التوراة علي موسي وانشدك بالذي فلق البحر لبني اسراءيل فعظم عليه هل تجدني وصفتي ومخرجي في كتابك فقال براسه اي لا قال فقال ابنه وهو في الموت والذي انزل التوراة علي موسي انه ليجد صفتك وبعثك ومخرجك في كتابه وانا اشهد ان لا اله الا الله وانك رسول الله فقال رسول الله صلي الله عليه وسلم اقيموا اليهودي عن اخيكم فوليه رسول الله وغسله وكفنه وصلي عليه وقال بن سعد حدثنا علي بن محمد المداءني عن الصلت بن دينار عن عبد الله بن شقيق نحوه ورواه عبد الوهاب بن عطاء عن الجريري فقال عن عبد الله بن قدامة عن رجل اعرابي وقال اسماعيل بن علية عن الجريري عن ابي صخر عن رجل من الاعراب اخرجه احمد عن بن علية ابو صرمة بن ابي قيس الانصاري المازني قيل اسمه قيس بن مالك وقيل مالك بن قيس وقيل بن ابي قيس وقيل بن اسعد وقال بن البرقي هو قيس بن صرمة بن ابي صرمة بن مالك بن عدي بن النجار وكذا نسبه بن قانع والدمياطي روي عن النبي صلي الله عليه وسلم في العزل وعن ابي ايوب وغيره روي عنه عبد الله بن محيريز ولءلءة مولاة الانصار ومحمد بن قيس وزياد بن نعيم وذكر العسكري في الرواة عنه محمد بن يحيي بن حبان والمحفوظ ان بينهما واسطة وقد ذكر البغوي حديثه من طريق يحيي بن سعيد عنه فاثبت الواسطة لءلءة ومن وجه اخر عنه بحذفها وقال ابو عمر لم يختلف §  <> في شهوده بدرا وتعقب بان بن اسحاق وموسي بن عقبة والواقدي لم يذكروه فيهم وحديثه عند الترمذي والنساءي وذكره محمد بن الربيع الجيزي في الصحابة الذين نزلوا مصر فقال ذكر يحيي بن عثمان انه شهد فتح مصر وذكر احمد بن يحيي بن الوزير انه قدم علي عقبة بن عامر واخرج من طريق زياد بن ايوب قال كنا مع ابي ايوب في البحر ومعنا ابو صرمة الانصاري صاحب رسول الله صلي الله عليه وسلم الحديث ويقال هو ابو صرمة الذي نزلت فيه وكلوا واشربوا حتي يتبين لكم الخيط الابيض من الخيط الاسود من الفجر الاية ابو صعير العذري تقدم الاختلاف فيه في ثعلبة بن صعير قال البغوي سكن المدينة ابو صفرة عسعس بن سلامة تقدم في الاسماء ابو صفرة الازدي والد المهلب الامير المشهور مختلف في صحبته وفي اسمه قيل اسمه ظالم بن سارق وقيل بن سراق وقيل قاطع بن سارق بن ظالم وقيل غالب بن سراق ونسبه بن الكلبي فقال ظالم بن سارق بن صبح بن كندي بن عمرو بن عدي بن واءل بن الحارث بن العتيك بن الازد وزعم بعضهم ان اصلهم من العجم وانهم انتسبوا في الازد وذكره بن السكن في الصحابة واخرج من طريق محمد بن عبد بن حميد قال حدثنا محمد بن غالب بن عبد الرحمن بن يزيد بن المهلب بن ابي صفرة حدثني ابي عن اباءه ان ابا صفرة قدم علي رسول الله صلي الله عليه وسلم علي ان يبايعه وعليه حلة صفراء يسحبها خلفه دراعة وله طول وجثة وجمال وفصاحة لسان فلما راه اعجبه ما راي من جماله فقال له من انت قال انا قاطع بن سارق بن ظالم بن عمر بن شهاب بن الهلقام بن الجلند بن السلم الذي كان ياخذ كل سفينة غصبا انا الملك بن الملك فقال له النبي صلي الله عليه وسلم انت ابو صفرة دع عنك سارقا وظالما فقال اشهد ان لا اله الا الله وانك عبده ورسوله حقا حقا يا رسول الله ان لي ثمانية عشر ذكرا ورزقت بنتا سميتها صفرة فقال له النبي صلي الله عليه وسلم فانت ابو صفرة وقال الواقدي في كتاب الردة قالوا وفد الازد من دبا مقرين بالاسلام علي النبي صلي الله عليه وسلم فبعث عليهم حذيفة بن اليمان الازدي مصدقا وكتب له فراءض صدقاتهم فذكر الحديث في الردة وقتال عكرمة اياهم وغلبته وعليهم ارسال سبيهم الي ابي بكر مع حذيفة المذكور قال فحدثنا عبد الله بن زيد بن اسلم عن ابيه عن جده قال لما قدم سبي اهل دبار وفيهم ابو صفرة غلام لم يبلغ الحلم فانزلهم لهم ابو بكر في دار رملة بنت الحارث وهو يريد ان يقتل المقاتلة فقال له عمر يا خليفة رسول الله صلي الله عليه وسلم قوم مءمنون انما شحوا علي اموالهم فقال انطلقوا الي اي البلاد شءتم فانتم قوم احرار فخرجوا فنزلوا البصرة فكان ابو صفرة والد المهلب فيمن نزل البصرة وقال ابو عمر كان ابو صفرة مسلما علي عهد النبي صلي الله عليه وسلم ولم يفد عليه ووفد علي عمر في عشرة من ولده وذكر عبد الرزاق عن جعفر بن سليمان قال وفد ابو صفرة علي عمر بن الخطاب ومعه عشرة من ولده المهلب اصغرهم فجعل عمر ينظر اليهم ويتوسم ثم قال لابي صفرة هذا سيد ولدك وهو يومءذ اصغرهم وقال عمر بن شبة في اخبار البصرة اوفد عثمان بن ابي العاص وهو امير البصرة ابا صفرة في رجال من الازد علي عمر فسالهم عن اسماءهم وسال ابا صفرة فقال انا ظالم بن سارق §  <> وكان ابيض الراس واللحية فاتاه وقد اختضب فقال انت ابو صفرة فغلبت عليه الكنية قلت فهذا معارض لرواية الواقدي انه كان لما وفد غلاما لم يبلغ الحلم وقال الاصمعي في ديوان زياد الاعجم ان ابا صفرة سال عثمان بن ابي العاص ان يقطعه فاقطعه خططا بالمهالبة فقيل له ان هذا الرجل اقلف فدعا به فقال ويحك اما تطهرت قال والله يا امير المءمنين اني لافعل ذلك خمس مرات في اليوم قال انما سالتك عن الختان فقال والله اعز الله الامير ما عرفت ذلك فامره فاختتن قال وفي ذلك يقول زياد بن الاعجم اختتن القوم بعد ما شمطوا واستعربوا بعد اذ هم عجم وقال ابو الفرج في الاغاني في ترجمة ابي عيينة المهلبي اسم ابي صفرة سارق وقيل غالب وقال بن قتيبة المهلب من ازد عمان من قرية يقال لها دبا اسلم في عهد النبي صلي الله عليه وسلم ثم ارتد ونزل علي حكم حذيفة فبعثه الي ابي بكر فاعتقه وقد وقع لنا عن ابي صفرة حديث مسند اخرجه الطبراني في الاوسط من طريق زياد بن عبد الله القرشي دخلت علي هند بنت المهلب بن ابي صفرة وهي امراة الحجاج وبيدها مغزل تغزل به فقلت لها تغزلين وانت امراة امير فقالت ان ابي يحدث عن جدي قال سمعت رسول الله صلي الله عليه وسلم يقول اطولكن طاقا اعظمكن اجرا قال الطبراني لم يسند ابو صفرة غير هذا واسمه سارق بن ظالم ولا يروي عنه الا بهذا الاسناد تفرد به يزيد بن مروان بن زياد قلت ويزيد متروك والحديث الذي اورده بن السكن يعكر عليه ابو صفوان عبد الله بن بشر المازني وابو صفوان مالك بن عميرة وابو صفوان مخرمة بن نوفل والد المسور تقدموا في الاسماء ابو صفوان او بن صفوان في المبهمات ابو صفية مولي رسول الله صلي الله عليه وسلم قال البخاري عداده في المهاجرين واخرجه من طريق المعلي بن عبد الرحمن سمعت يونس بن عبيد يقول لامه ماذا رايت ابا صفية يصنع قالت رايت ابا صفية وكان من المهاجرين من اصحاب النبي صلي الله عليه وسلم يسبح بالنوي تابعه عبد الواحد بن زيد عن يونس بن عبيد عن امه قالت رايت ابا صفية رجلا من المهاجرين يسبح بالنوي اخرجه البغوي واخرج من وجه اخر عن ابي بن كعب عن ابي صفية مولي رسول الله صلي الله عليه وسلم انه كان يوضع له نطع ويءتي بحصي فيسبح به الي نصف النهار فاذا صلي الاولي ورجع اتي به فيسبح حتي يمسي ابو صميمة ويقال بالمعجمة ذكره المستغفري ههنا بالمهملة وسيجء في الضاد المعجمة ابو صهيب ذكره الحاكم ابو احمد فقال روي عن النبي صلي الله عليه وسلم روي عنه هلال اظنه بن يساف قال عبد الرزاق عن معمر عن هلال §  <> القسم الثاني خال القسم الثالث ابو صحار السعدي كان رجلا في عهد النبي صلي الله عليه وسلم وشهد حنينا مع المشركين ثم اسلم ذكره ابو عبد الله بن الاعرابي في كتاب النوادر وقال قال السروجي قال ابو صحار السعدي سعد ابي بكر بن هوازن وقالت له زوجته ابتع لنا عهنا رخيصا فقال لهما كما انت حتي تكون الجبال عهنا كما قال اخو قريش فتاخذي عهنا رخيصا قال ودعاه قومه الي الاسلام بعد ان ظهر الاسلام فابي وقال في يوم حنين الا هل اتاك ان غلبت قريش هوازن والخطوب لها شروط وقد تقدمت هذه الابيات وجوابها في ترجمة بن وهب الاسدي قال ثم اسلم ابو صحار بعد ذلك وحسن اسلامه وجاور عبيد الله بن العباس بالبقيع وذكر له معه خبرا وانشد له فيه مدحا وذكر قصته ايضا ابو عبد الله بن خالويه في كتابه القسم الرابع ابو صالح مولي ام هانء تابعي شهير وهم بعض الرواة في حديث من طريقة فاخرجه الحسن بن سفيان في مسنده وذكره من طريقة ابو نعيم في الصحابة وهو وهم فاخرج الحسن من طريق رزين عن ثابت عن ابي ثابت عن ابي صالح مولي ام هانء انها اعتقته قال وكنت ادخل عليها في كل شهر وكل شهرين دخلة فدخلت عليها يوما اذ دخل عليها النبي صلي الله عليه وسلم فقالت يا بن عم كبرت وثقلت وضعف عملي فهل من مخرج فقال ابشري يا بوان خير كثير احمدي الله ماءة مرة تكون عدل ماءة رقبة وكبري ماءة تكون عدل ماءة فرس مسرجة ملجمة في سبيل الله وسبحي ماءة تكون عدل ماءة بدنة مقلدة مثقلة وهللي ماءة لا يلحقك ذنب الا الشرك هكذا قال رزين وهو ضعيف والصواب اذ دخل عليها علي فقالت يا بن ام وابو صالح مولي ام هانء مشهور في التابعين لا يخفي ذلك علي من له ادني معرفة ابو الصباح بن النعمان صحفه بعضهم والصواب بالضاد المعجمة كما سياتي بعد هذا حرف الضاد المعجمة القسم الاول §  <> ابو الضبيب البلوي ويقال ابو الضبيس ياتي ابو الضبيس الجهني قال بن منده سمعت بن يونس يذكر عن الواقدي انه صحابي ذكر فيمن نزل الاسكندرية وعن الواقدي انه من اصحاب الشجرة وتوفي في اخر خلافة معاوية وذكره الواقدي في جملة من خرج وراء العرنيين ابو الضبيس البلوي ذكره محمد بن الربيع الجيزي فيمن دخل مصر من الصحابة وذكر الواقدي من طريق محمد بن سعد مولي بن مخزوم عن رويفع بن ثابت البلوي قال قدم وفد قومي في شهر ربيع الاول سنة تسع فبلغني قدومهم فانزلتهم علي فدخلوا الي رسول الله صلي الله عليه وسلم فقال الشيخ منهم يقال ابو الضبيس يا رسول الله اني رجل ارغب في الضيافة فهل لي من اجر في ذلك قال نعم وكل معروف الي غني او فقير صدقة ابو الضحاك عمر بن حزم بن زيد الانصاري ابو الضحاك فيروز الديلمي تقدما ابو الضحاك الانصاري ذكره الحسن بن سفيان في مسنده واخرج من طريق ابراهيم بن قيس بن اوس الانصاري عن ابي الضحاك الانصاري قال لما سار رسول الله صلي الله عليه وسلم الي خيبر جعل عليا مقدمته فقال له ان جبريل يحبك قال وقد بلغت الي ان يحبني جبريل قال نعم ومن هو خير من جبريل الله يحبك ابو ضمرة بن العيص ذكره الاختلاف في اسمه في جندع بن ضمرة من الاسماء وكلام ابو ضميرة الحميري والد ضميرة ذكره بن منده في الكني وسبقه البغوي من قبله محمد بن سعد ووصفوه بانه مولي رسول الله صلي الله عليه وسلم وقد قيل ان اسمه سعد وقيل روح وقد تقدم خبره في الكتاب الذي كتبه النبي صلي الله عليه وسلم لال ضميرة في ترجمة ضميرة وقال مصعب الزبيري كانت لابي ضميرة دار بالعقيق وقال بن الكلبي هو غير ابي ضميرة مولي علي وقال بن سعد والبلاذري وفد حسين بن عبد الله بن ضميرة علي المهدي بالكتاب فوضعه علي عينيه واعطاه ثلاثماءة دينار وكان خرج في سفر ومعه قومه ومعهم هذا الكتاب فعرض لهم اللصوص فاخذوا ما معهم فاخرجوا الكتاب واعلموهم بما فيه فردوا عليهم ما اخذوا منهم ولم يعترضوا لهم ذكره البغوي عن محمد بن سعد عن اسماعيل بن ابي اويس ابو ضميمة مصغرا ذكره بن منده واخرج من طريق عطاء الخراساني عن الحسن هو البصري سمعت ابا ضميمة وكان ممن ادرك النبي صلي الله عليه وسلم قال سالت النبي صلي الله عليه وسلم عن ابواب القسط فقال انصاف الناس من نفسك وبذل السلام للعالم قلت قال عطاء فيه ضعف والراوي عنه لهذا الحديث اتهموه بالكذب وهو اسحاق بن نجيح وقد رواه ابو نعيم من وجه اخر عن علي بن حجر رواية عن اسحاق فقال عن ابي تميمة بالمثناة المفتوحة فالله اعلم §  <> القسم الثاني خال وكذا القسم الثالث القسم الرابع ابو ضمضم غير مسمي ولا منسوب ذكره ابو عمر في حاشية كتاب بن السكن فقرات بخطه ابو ضمضم غير منسوب روي ثابت عن انس ان رسول الله صلي الله عليه وسلم قال الا تحبون ان تكونوا كابي ضمضم قالوا يا رسول الله ومن ابو ضمضم قال ان ابا ضمضم كان اذا اصبح قال اللهم اني قد تصدقت بعرضي علي من ظلمني قال فاوجب النبي صلي الله عليه وسلم انه قد غفر له وذكره في الصحابة فقال روي عنه الحسن وقتادة انه قال اللهم اني قد تصدقت بعرضي علي عبادك قال وروي بن عيينة عن عمرو بن دينار عن ابي صالح عن ابي هريرة قال ان رجلا من المسلمين قال فذكر مثله قال ابو عمر اظنه ابا ضمضم المذكور قلت تبع في ذلك كله الحاكم ابا احمد فانه اخرج الحديث من طريق حماد بن زيد عن هشام عن الحسن وعن ابي العوام عن قتادة قالا قال ابو ضمرة اللهم فذكره ثم ساق حديث ابي هريرة من طريق سعيد بن عبد الرحمن عن سفيان وهو كذلك في جامع سفيان واخرجه بن السني في عمل اليوم والليلة من طريق شعيب بن بيان عن عمران القطان عن قتادة عن انس مرفوعا وقد تعقب بن فتحون قول بن عبد البر روي عنه الحسن وقتادة فقال هذا وهم لا خفاء فيه لان النبي صلي الله عليه وسلم يخبر اصحابه عن ابي ضمضم فلا يعرفونه حتي يقولوا من ابو ضمضم وابو عمر يقول روي عنه الحسن وقتادة وقد اخرجه البزار والساجي من طريق ابي النضر هاشم بن القاسم عن محمد بن عبد الله العمي عن ثابت عن انس الحديث وفيه قالوا وما ابو ضمضم قال ان ابا ضمضم كان اذا اصبح قال اللهم الحديث وفي رواية البزار من الزيادة كان رجلا صلبا قال بن فتحون فالرجل لم يكن من هذه الامة وانما كان قبلها فاخبرهم بحاله تحريضا علي ان يعملوا بعمله وما توهماه من ان الصحابي في حديث ابي هريرة هو ابو ضمضم خطا بل هو علبة بن زيد الانصاري كما تقدم في حرف العين المهملة ولولا ما جاء من التصريح بان ضمضم كان فيمن كان قبلها لجوزت ان يكون علبة يكني ابا ضمضم لكن منع من ذلك ما اخرجه ابو داود عن موسي بن اسماعيل وابو بكر الخطيب في كتاب الموضح من طريق روح بن عبادة كلاهما عن حماد بن سلمة عن ثابت عن عبد الرحمن بن عجلان ان النبي صلي الله عليه وسلم قال ايعجز احدكم ان يكون مثل ابي ضمضم قالوا ومن ابو ضمضم يا رسول الله قال رجل ممن كان قبلكم الحديث قال ابو داود رواه ابو النضر عن محمد بن عبد الله العمي عن ثابت عن انس ورواية حماد اصح واخرجه من طريق محمد بن ثور عن معمر عن قتادة موقوفا انتهي واسنده البخاري في تاريخه والبزار والساجي من طريق ابي النضر واشار البزار الي ان محمد بن عبد الله تفرد به واخرجه البخاري في تاريخه والعقيلي في الضعفاء §  <> حرف الطاء المهملة القسم الاول ابو طخفة تقدم في طخفة ابو طريف الهذلي ذكره البغوي ومطين وابن حبان وابن السكن وغيرهم في الصحابة وشهد حصار الطاءف قال بن قانع اسمه كيسان وقال ابو عمر اسمه سنان روي حديثه احمد والحسن بن سفيان وغيرهما من طريق زكريا بن اسحاق عن الوليد بن عبد الله بن ابي شميلة وفي رواية البغوي ابو شميرة براء بدل اللام حدثني ابو طريف انه كان شاهد النبي صلي الله عليه وسلم وهو يحاصر اهل الطاءف قال وكان يصلي بنا صلاة المغرب حتي لو ان انسان رمي بنبله ابعد مواقع نبله وصححه بن خزيمة ابو طريف عدي بن حاتم الطاءي تقدم ابو الطفيل عامر بن واثلة بن عبد الله بن عمرو بن جحش ويقال جهيش بن جدي بن سعد بن ليث بن بكر عبد مناة بن علي بن كنانة الكناني ثم الليثي راي النبي صلي الله عليه وسلم وهو شاب وحفظ عنه احاديث قال بن عدي له صحبة وروي ايضا عن ابي بكر وعمر وعلي ومعاذ وحذيفة وابن مسعود وابن عباس ونافع بن عبد الحارث وزيد بن ارقم وغيرهم روي عنه الزهري وابو الزبير وقتادة وعبد العزيز بن رفيع وعكرمة بن خالد وعمرو بن دينار ويزيد بن ابي حبيب ومعروف بن خربوذ واخرون قال مسلم مات سنة ماءة وهو اخر من مات من الصحابة وقال بن البرقي مات سنة اثنتين وماءة وهو مشهور باسمه وكنيته جميعا وعن مبارك بن فضالة مات سنة سبع وماءة وقال وهب بن جرير بن حازم عن ابيه كنت بمكة سنة عشر وماءة فرايت جنازة فسالت عنها فقيل لي ابو الطفيل وقال بن السكن جاءت عنه روايات ثابتة انه راي النبي صلي الله عليه وسلم واما سماعه منه صلي الله عليه وسلم فلم يثبت وذكر بن سعد عن علي بن زيد بن جدعان عن ابي الطفيل قال كنت اطلب النبي صلي الله عليه وسلم فيمن يطلبه وهو في الغار الحديث وهو ضعيف لانهم لا يختلفون ان ابا الطفيل لم يكن ولد في تلك الليلة قلت واظن ان هذا من رواية ابي الطفيل عن ابيه وقال صالح بن احمد بن حنبل عن ابيه ابو الطفيل مكي ثقة وذكره البخاري في التاريخ الصغير عن ابي الطفيل قال ادركت ثمان سنين من حياة النبي صلي الله عليه وسلم قال ابو عمر كان يعترف بفضل ابي بكر وعمر لكنه يقدم عليا ابو طلحة الانصاري زيد بن سهل بن الاسود بن حرام الانصاري النجاري مشهور باسمه وكنيته وهو القاءل انا ابو طلحة واسمي زيد وكل يوم في جرابي صيد تقدم في الاسماء §  <> ابو طلحة الانصاري اخر ذكره الخطيب في المبهمات وانه الذي ضيف الرجل فاثره بطعامه ونزلت فيه ويءثرون علي انفسهم الاية وذكر انه غير ابي طلحة زوج ام سليم ونسبه انه وقع في الرواية التي اخرجها مسلم فقال رجل من الانصار يقال له ابو طلحة فكانه استبعد ان يكون ابو هريرة لا يعرف ابو طلحة زوج ام سليم حتي يعبر عنه بهذه العبارة وقد جزم غيره بانه هو ولا مانع ان تكون هذه القصة في اواءل ما قدم ابو هريرة المدينة قبل ان يعرف غالب اهلها ابو طلحة درع الخولاني قال الطبراني مختلف في صحبته واورد له من طريق حماد بن سلمة عن ابي سنان عن ابي طلحة الخولاني واسمه درع قال قال رسول الله صلي الله عليه وسلم يكون جنود اربعة فعليكم بالشام الحديث وقال بن يونس شهد فتح مصر ابو طليق بوزن عظيم وقيل طلق بسكون اللام ذكره البغوي وابن السكن وغيرهما في الصحابة واخرجوا من طريق المختار بن فلفل قال حدثني طلق بن حبيب البصري ان ابا طليق حدثه ان امراته ام طليق اتته فقالت له حضر الحج يا ابا طليق وكان له جمل وناقة يحج علي الناقة ويغزو علي الجمل فسالته ان يعطيها الجمل فتحج عليه فقال الم تعلمي اني حبسته في سبيل الله فقالت ان الحج من سبيل الله فاعطنيه يرحمك الله فامتنع قالت فاعطني الناقة وحج انت علي الجمل قال لا اوثرك علي نفسي قالت فاعطني من نفقتك قال ما عندي فضل عني وعن عيالي ما اخرج به وما اتركه لكم قالت انك لو اعطيتني اخلفها الله عليك قال فلما ابيت عليها قالت فاذا لقيت رسول الله صلي الله عليه وسلم فاقرءه مني السلام واخبره بالذي قلت لك قال فاتيت رسول الله صلي الله عليه وسلم فقراته منا السلام واخبرته بالذي قالت فقال صدقت ام طليق لو اعطيتها الجمل لكان في سبيل الله ولو اعطيتها الناقة لكانت وكنت في سبيل الله ولو اعطيتها من نفقتك لاخلفها الله عليك قال فانها تسالك ما يعدل الحج قال عمرة في رمضان لفظ حفص بن غياث عند ابي بشر الدولابي واخرجه بن ابي شيبة وابن السكن وابن منده من طريق عبد الرحيم بن سليمان عن المختار وسنده جيد ابو طويل الكندي شطب الممدود تقدم في الاسماء ابو طيبة الحجام مولي الانصار من بني حارثة وقيل من بني بياضة يقال اسمه دينار حكاه بن عبد البر ولا يصح فقد ذكر الحاكم ابو احمد ان دينار الحجام اخر تابعي واخرج بن منده حديثا لدينار الحجام عن ابي طيبة ويقال اسمه ميسرة ذكره البغوي في معجم الصحابة عن احمد بن عبيد ابي طيبة انه ساله عن اسم جده ابي طيبة فقال ميسرة ويقال اسمه نافع قال العسكري قيل اسمه نافع ولا يصح ولا يعرف اسمه قلت كذا قال ووقع مسمي كذلك في مسند محيصة بن مسعود من مسند احمد ثم من طريق يزيد بن ابي حبيب عن ابي عفير الانصاري عن محمد بن سهل بن ابي خيثمة عن محيصة انه كان له غلام حجام يقال له نافع ابو طيبة فسال النبي صلي الله عليه وسلم عن خراجه فقال اعلفه الناضح الحديث وقد اخرجه احمد وغيره من حديث الليث عن يزيد بن ابي حبيب عن ابي عفير الانصاري عن محمد بن سهل بن ابي خيثمة عن محيصة بن مسعود انه كان له غلام حجام يقال له نافع ابو طيبة وقد ثبت ذكره في الصحيحين انه حجم النبي صلي الله عليه وسلم من حديث انس وجابر وغيرهما واخرج §  <> بن ابي خيثمة بسند ضعيف عن جابر قال خرج علينا ابو طيبة لثمان عشرة خلون من رمضان فقال له اين كنت قال حجمت رسول الله صلي الله عليه وسلم واخرج بن السكن بسند اخر ضعيف من حديث بن عباس كنا جلوسا بباب النبي صلي الله عليه وسلم فخرج علينا ابو طيبة بشء يحمله في ثوبه فقلنا ما هذا معك يا ابا طيبة قال حجمت النبي صلي الله عليه وسلم فاعطاني اجري القسم الثاني لم يذكر فيه احد من الرجال القسم الثالث ابو الطفيل سهيل بن عوف ابو الطمحان القيني اسمه حنظلة تقدم في الاسماء القسم الرابع ابو طالب بن عبد المطلب بن هاشم بن عبد مناف بن قصي القرشي الهاشمي عم رسول الله صلي الله عليه وسلم شقيق ابيه امهما فاطمة بنت عمرو بن عاءذ المخزومية اشتهر بكنيته واسمه عبد مناف علي المشهور وقيل عمران وقال الحاكم اكثر المتقدمين علي ان اسمه كنيته ولد قبل النبي بخمس وثلاثين سنة ولما مات عبد المطلب اوصي بمحمد صلي الله عليه وسلم الي ابي طالب فكفله واحسن تربيته وسافر به صحبته الي الشام وهو شاب ولما بعث قام في نصرته وذب عنه من عاداه ومدحه عدة مداءح منها قوله لما استسقي اهل مكة فسقوا وابيض يستسقي الغمام بوجهه ثمال اليتامي عصمة للارامل ومنها قوله من قصيدة وشق له من اسمه ليجله فذو العرش محمود وهذا محمد قال بن عيينة عن علي بن زيد ما سمعت احسن من هذا البيت واخرج احمد من طريق حبة العرني قال رايت عليا ضحك علي المنبر حتي بدت نواجذه ثم تذكر قول ابي طالب وقد ظهر علينا وانا اصلي مع النبي صلي الله عليه وسلم ببطن نخلة فقال له ماذا يصنعان فدعاه الي الاسلام فقال ما بالذي تقول من باس ولكن والله لا يعلوني استي ابدا واخرج البخاري في التاريخ من طريق طلحة بن يحيي عن موسي بن طلحة عن عقيل بن ابي طالب قال قالت قريش لابي طالب ان بن اخيك هذا قد اذانا فذكر القصة فقال يا عقيل اءتني بمحمد قال فجءت به في الظهيرة فقال ان بني عمك هءلاء زعموا انك تءذيهم فانته عن اذاهم فقال اترون هذه الشمس فما انا باقدر علي ان ادع ذلك فقال ابو طالب والله ما كذب بن اخي §  <> قط وقال عبد الرزاق حدثنا سفيان عن حبيب بن ابي ثابت عمن سمع بن عباس في قوله تعالي وهم ينهون عنه ويناون عنه قال نزلت في ابي طالب كان ينهي عن اذي النبي صلي الله عليه وسلم ويناي عما جاء به واخرج بن عدي من طريق الهيثم البكاء عن ثابت عن انس قال مرض ابو طالب فعاده النبي صلي الله عليه وسلم فقال يا بن اخي ادع ربك الذي بعثك يعافني فقال اللهم اشف عمي فقام كانما نشط من عقال فقال يا بن اخي ان ربك ليطيعك فقال وانت يا عماه لو اطعته ليطيعنك وفي زيادات يونس بن بكير في المغازي عن يونس بن عمرو عن ابي السفر قال بعث ابو طالب الي النبي صلي الله عليه وسلم فقال اطعمني من عنب جنتك فقال ابو بكر ان الله حرمها علي الكافرين وذكر جمع من الرافضة انه مات مسلما وتمسكوا بما نسب اليه من قوله ودعوتني وعلمت انك صادق ولقد صدقت فكنت قبل امينا ولقد علمت بان دين محمد من خير اديان البرية دينا قال بن عساكر في صدر ترجمته قيل انه اسلم ولا يصح اسلامه ولقد وقفت علي تصنيف لبعض الشيعة اثبت فيه اسلام ابي طالب منها ما اخرجه من طريق يونس بن بكير عن محمد بن اسحاق عن العباس بن عبد الله بن سعيد بن عباس عن بعض اهله عن بن عباس قال لما اتي رسول الله صلي الله عليه وسلم ابا طالب في مرضه قال له يا عم قل لا اله الا الله كلمة استحل بها لك الشفاعة يوم القيامة قال يا بن اخي والله لولا ان تكون سبة علي وعلي اهلي من بعدي يرون اني قلتها جزعا عند الموت لقلتها لا اقولها الا لاسرك بها فلما ثقل ابو طالب رءي يحرك شفتيه فاصغي اليه العباس فسمع قوله فرفع راسه عنه فقال قد قال والله الكلمة التي ساله عنها ومن طريق اسحاق بن عيسي الهاشمي عن ابيه سمعت المهاجر مولي بني نفيل يقول سمعت ابا رافع يقول سمعت ابا طالب يقول سمعت بن اخي محمد بن عبد الله يقول ان ربه بعثه بصلة الارحام وان يعبد الله وحده لا يعبد معه غيره ومحمد الصدوق الامين ومن طريق بن المبارك عن صفوان بن عمرو عن ابي عامر الهوزني ان رسول الله صلي الله عليه وسلم خرج معارضا جنازة ابي طالب وهو يقول وصلتك رحم ومن طريق عبد الله بن ضميرة عن ابيه عن علي انه لما اسلم قال له ابو طالب الزم بن عمك ومن طريق ابي عبيدة معمر بن المثني عن رءبة بن العجاج عن ابيه عن عمران بن حصين ان ابا طالب قال لجعفر بن ابي طالب لما اسلم قبل جناح بن عمك فصلي جعفر مع النبي صلي الله عليه وسلم ومن طريق محمد بن زكريا الغلابي عن العباس بن بكار عن ابي بكر الهذلي عن الكلبي عن ابي صالح عن بن عباس قال جاء ابو بكر بابي قحافة وهو شيخ قد عمي فقال رسول الله صلي الله عليه وسلم الا تركت الشيخ حتي اتيه قال اردت ان ياجره الله والذي بعثك بالحق لانا كنت اشد فرحا باسلام ابي طالب مني باسلام ابي التمس بذلك قرة عينك واسانيد هذه الاحاديث واهية وليس المراد بقوله في الحديث الاخير اثبات اسلام ابي طالب فقد اخرج عمر بن شبة في كتاب مكة وابو يعلي وابو بشر سمويه في فواءده كلهم من طريق محمد بن سلمة عن هشام بن حسان عن محمد بن سيرين عن انس في قصة اسلام ابي قحافة قال فلما مد يده يبايعه بكي ابو بكر فقال النبي صلي الله عليه وسلم ما يبكيك قال لان تكون يد عمك مكان يده ويسلم ويقر الله عينك احب الي من اين يكون وسنده §  <> صحيح واخرجه الحاكم من هذا الوجه وقال صحيح علي شرط الشيخين وعلي تقدير ثوبتها فقد عارضها ما هو اصح منها اما الاول ففي الصحيحين من طريق الزهري عن سعيد بن المسيب عن ابيه ان ابا طالب لما حضرته الوفاة دخل عليه النبي صلي الله عليه وسلم وعنده ابو جهل وعبد الله بن ابي امية فقال يا عم قل لا اله الا الله كلمة احاج لك بها عند الله فقال له ابو جهل وعبد الله بن ابي امية يا ابا طالب اترغب عن ملة عبد المطلب فلم يزالا به حتي قال اخر ما قال هو علي ملة عبد المطلب فقال النبي صلي الله عليه وسلم لاستغفرن لك ما لم انه عنك فنزلت ما كان للنبي والذين امنوا ان يستغفروا للمشركين الاية ونزلت انك لا تهدي من احببت ولكن الله يهدي من يشاء فهذا هو الصحيح برد الرواية التي ذكرها بن اسحاق اذ لو كان قال كلمة التوحيد ما نهي الله تعالي نبيه عن الاستغفار له وهذا الجواب اولي من قول من اجاب بان العباس ما ادي هذه الشهادة وهو مسلم وانما ذكرها قبل ان يسلم فلا يعتد بها وقد اجاب الرافضي المذكور عن قوله وهو علي ملة عبد المطلب بان عبد المطلب مات علي الاسلام واستدل باثر مقطوع عن جعفر الصادق وساذكره بعد ولا حجة فيه لانقطاعه وضعف رجاله واما الثاني وفيه شهادة ابي طالب بتصديق النبي صلي الله عليه وسلم فالجواب عنه وعما ورد من شعر ابي طالب في ذلك انه نظير ما حكي الله تعالي عن كفار قريش وجحدوا بها واستيقنتها انفسهم ظلما وعلوا فكان كفرهم عنادا ومنشءه من الانفة والكبر والي ذلك اشار ابو طالب قوله لولا ان تعيرني قريش واما الثالث وهو اثر الهوزني فهو مرسل ومع ذلك فليس في قوله وصلتك رحم ما يدل علي اسلامه بل فيه ما يدل علي عدمه وهو معارضته لجنازته ولو كان اسلم لمشي معه وصلي عليه وقد ورد ما هو اصح منه وهو ما اخرجه ابو داود والنساءي وصححه بن خزيمة من طريق ناجية بن كعب عن علي قال لما مات ابو طالب اتيت النبي صلي الله عليه وسلم فقلت ان عمك الضال قد مات فقال لي اذهب فواره ولا تحدثني شيءا حتي تاتين ففعلت ثم جءت فدعا لي بدعوات وقد اخرجه الرافضي المذكور من وجه اخر عن ناجية بن كعب عن علي بدون قوله الضال واما الرابع والخامس وهو امر ابي طالب ولديه باتبعاه فتركه ذلك هو من جملة العناد وهو ايضا من حسن نصرته له وذبه عنه ومعاداته قومه بسببه واما قول ابي بكر فمراده لانا كنت اشد فرحا باسلام ابي طالب مني باسلام ابي اي لو اسلم ويبين ذلك ما اخرجه ابو قرة موسي بن طارق عن موسي بن عبيدة عن عبد الله بن دينار عن بن عمر قال جاء ابو بكر بابي قحافة يقوده يوم فتح مكة فقال رسول الله صلي الله عليه وسلم الا تركت الشيخ حتي ناتيه قال ابو بكر اردت ان ياجره الله والذي بعثك بالحق لانا كنت اشد فرحا باسلام ابي طالب لو كان اسلم مني بابي وذكر بن اسحاق ان عمر لما عارض العباس في ابي سفيان لما اقبل به ليلة الفتح فقال له العباس لو كان من بني عدي ما احببت ان يقتل فقال عمر انا باسلامك اذا اسلمت افرح مني باسلام الخطاب يعني لو كان اسلم ثم ذكر الرافضي من طريق راشد الحماني قال سءل ابو عبد الله يعني جعفر بن محمد الصادق من اهل الجنة فقال الانبياء في الجنة والصالحون في الجنة والاسباط في الجنة واجل العالمين مجدا محمد صلي الله عليه وسلم يقدم ادم فمن بعده من اباءه وهذه الاصناف يحدثون به ويحشر عبد المطلب به نور الانبياء وجمال الملوك ويحشر §  <> ابو طالب في زمرته فاذا ساروا بحضرة الحساب وتبوا اهل الجنة منازلهم ودحر اهل النار ارتفع شهاب عظيم لا يشك من راه انه غيم من النار فيحضر كل من عرف ربه من جميع الملل ولم يعرف نبيه ومن حشر امة وحده والشيخ الفاني والطفل فيقال لهم ان الجبار تبارك وتعالي يامركم ان تدخلوا هذه النار فكل من اقتحمها خلص الي اعلي الجنة ومن كع عنها غشيته اخرجه عن ابي بشر احمد بن ابراهيم بن يعلي بن اسد عن ابي صالح الحمادي عن ابيه عن جده سمعت راشد الحماني فذكره وهذه سلسلة شيعية غلاة في رفضهم والحديث الاخير ورد من عدة طرق في حق الشيخ الهرم ومن مات في الفترة ومن ولد اكمه اعمي اصم ومن ولد مجنونا او طرا عليه الجنون قبل ان يبلغ ونحو ذلك وان كلا منهم يدلي بحجة ويقول لو عقلت او ذكرت لامنت فترفع لهم نار ويقال لهم ادخلوها فمن دخلها كانت عليه بردا وسلاما ومن امتنع ادخلها كرها هذا معني ما ورد من ذلك وقد جمعت طرقه في جزء مفرد ونحن نرجو ان يدخل عبد المطلب وال بيته في جملة من يدخلها طاءعا فينجو لكن ورد في ابي طالب ما يدفع ذلك وهو ما تقدم من اية براءة وما ورد في الصحيح عن العباس بن عبد المطلب انه قال للنبي صلي الله عليه وسلم ما اغنيت عن عمك ابي طالب فانه كان يحوطك ويغضب لك فقال هو في ضحضاح من النار ولولا انا لكان في الدرك الاسفل فهذا شان من مات علي الكفر فلو كان مات علي التوحيد لنجا من النار اصلا والاحاديث الصحيحة والاخبار المتكاثرة طافحة بذلك وقد فخر المنصور علي محمد بن عبد الله بن الحسن لما خرج بالمدينة وكاتبه المكاتبات المشهورة ومنها في كتاب المنصور وقد بعث النبي صلي الله عليه وسلم وله اربعة اعمام فامن به اثنان احدهما ابي وكفر به اثنان احدهما ابوك ومن شعر عبد الله بن المعتز يخاطب الفاطميين وانتم بنو بنته دوننا ونحن بنو عمه المسلم واخرج الرافضي ايضا في تصنيفه قصة وفاة ابي طالب من طريق علي بن محمد بن متيم سمعت ابي يقول سمعت جدي يقول سمعت علي بن ابي طالب يقول تبع ابو طالب عبد المطلب في كل احواله حتي خرج من الدنيا وهو علي ملته واوصاني ان ادفنه في قبره فاخبرت رسول الله صلي الله عليه وسلم فقال اذهب فواره واتيته لما انزل به فغسلته وكفنته وحملته الي الحجون فنبشت عن قبر عبد المطلب فوجدته متوجها الي القبلة فدفنته معه قال متيم ما عبد علي ولا احد من اباءه الا الله الي ان ماتوا اخرجه عن ابي بشر المتقدم ذكره عن ابي بردة السلمي عن الحسن بن ما شاء الله عن ابيه عن علي بن محمد بن متيم وهذه سلسلة شيعية من الغلاة في الرفض فلا يفرح به وقد عارضه ما هو اصح منه مما تقدم فهو المعتمد ثم استدل الرافضي بقول الله تعالي فالذين امنوا به وعزروه ونصروه واتبعوا النور الذي انزل معه اولءك هم المفلحون قال وقد عزره ابو طالب بما اشتهر وعلم ونابذ قريشا وعاداهم بسببه مما لا يدفعه احد من نقلة الاخبار فيكون من المفلحين انتهي وهذا مبلغهم من العلم وانا نسلم انه نصره وبالغ في ذلك لكنه لم يتبع النور الذي انزل معه وهو الكتاب العزيز الداعي الي التوحيد ولا يحصل الفلاح الا بحصول ما رتب عليه من الصفات كلها قال المرزباني مات ابو طالب في السنة العاشرة من المبعث وكان له يوم مات بضع §  <> وثمانون سنة وذكر بن سعد عن الواقدي انه مات في نصف شوال منها وقد وقعت لنا رواية ابي طالب عن رسول الله صلي الله عليه وسلم فيما اخرجه الخطيب في كتاب رواية الاباء عن الابناء من طريق احمد بن الحسن المعروف بدبيس حدثنا محمد بن اسماعيل بن ابراهيم العلوي حدثني عم ابي الحسين بن محمد عن ابيه موسي بن جعفر عن ابيه عن علي بن الحسين عن الحسين بن علي قال سمعت ابا طالب يقول حدثني محمد بن اخي وكان والله صدوقا قال قلت له بم بعثت يا محمد قال بصلة الارحام واقام الصلاة وايتاء الزكاة قال الخطيب لم اكتبه بهذا الاسناد الا عن هذا الشيخ ودبيس المقرء صاحب غراءب وكثير الرواية للمناكير وقال الخطيب ايضا اخبرنا ابو نعيم حدثنا محمد بن فارس بن حمدان حدثنا علي بن السراج البرقعيدي حدثنا جعفر بن عبد الواحد القاص قال قال لنا محمد بن عباد عن اسحاق بن عيسي عن مهاجر مولي بني نوفل سمعت ابا رافع انه سمع ابا طالب يقول حدثني محمد ان الله امره بصلة الارحام وان يعبد الله وحده ولا يعبد معه احد ومحمد عندي الصدوق الامين قال الخطيب لا يثبت هذا الحديث اهل العلم بالنقل وفي اسناده غير واحد من المجهولين وجعفر ذاهب الحديث وقال بن سعد في الطبقات اخبرنا اسحاق الازرق حدثنا عبد الله بن عون عن عمرو بن سعيد ان ابا طالب قال كنت بذي المجاز مع بن اخي فادركني العطش فشكوت اليه ولا اري عنده شيءا قال فثني وركه ثم نزل فاهوي بعصاه الي الارض فاذا بالماء فقال اشرب يا عم فشربت ومما لم يذكره الرافضي من الاحاديث الواردة في هذا الباب ما اخرجه تمام الرازي في فواءده من طريق الوليد بن مسلم عن عبد الله بن عمر رفعه انه اذا كان يوم القيامة شفعت لابي وامي وعمي ابي طالب واخ لي كان في الجاهلية وقال تمام الوليد منكر الحديث قال بن عساكر والصحيح ما اخرجه مسلم من حديث ابي سعيد الخدري ان رسول الله صلي الله عليه وسلم ذكر عنده ابو طالب فقال ينفعه شفاعتي يوم القيامة فيجعل في ضحضاح من النار يبلغ كعبيه يغلي منه دماغه ابو طرفة الكندي تابعي ارسل حديثا فذكره بعضهم بسببه في الصحابة فاورده المستغفري من طريق بقية حدثني الوليد بن كامل عن ابي طرفة الكندي قال قال رسول الله صلي الله عليه وسلم من غلبت صحته مرضه فلا يتداوي ابو طريف مولي عبد الرحمن بن طريف تابعي ارسل حديثا فذكره بعضهم في الصحابة بسببه اخرج ابو داود في كتاب القدر من طريق عمر بن عبد الله مولي عفرة عن ابي طريف قال بلغنا ان النبي صلي الله عليه وسلم قال اني سالت ربي للاهين من ذريه البشر حرف الظاء المشالة القسم الاول §  <> ابو ظبيان اسمه عبد الله بن الحارث بن كبير بالموحدة الغامدي تقدم في الاسماء ابو ظبية بتقديم الموحدة الساكنة علي الياء الاخيرة صاحب منحة النبي صلي الله عليه وسلم قال بن مندة روي حديثه ابو اسامة عن عبد الرحمن بن يزيد عن ابي سلام عنه ورواه غيره يعني عن عبد الرحمن فقال عن ابي سلمي ووصله ابو احمد الحاكم من طريق ابي اسامة ولفظه عن ابي سلام مولي قريش قال اتيت الكوفة فجلست يوم الجمعة في مجلس عظيم فاقبل رجل فسلم علي القوم فقال انا ابو ظبية صاحب منحة رسول الله صلي الله عليه وسلم كان يخبرني اني سافتقر بعده وكنت في العطاء فخاف علي المغيرة بن شعبة فانا اسال فيكم من الجمعة الي الجمعة فقال له القوم حدثنا يا ابا ظبية بشء سمعته من رسول الله صلي الله عليه وسلم فقال قال رسول الله صلي الله عليه وسلم بخ بخ لخمس ما اثقلهن في الميزان سبحان الله والحمد لله ولا اله الا الله والله اكبر والمءمن يموت له الولد الصالح فيحتسبه قال رواه الوليد بن مسلم عن عبد الرحمن بن يزيد بن جابر وعبد الله بن العلاء بن زبر قال حدثنا ابو سلام حدثني ابو سلمي راعي رسول الله صلي الله عليه وسلم قال ولقيته بالكوفة في مسجدها فذكر ان النبي صلي الله عليه وسلم قال له اما انك ستبقي بعدي حتي تسال فذكر الحديث نحوه ورواية الوليد ارجح لان عبد الرحمن بن يزيد الذي يروي عنه ابو اسامة ضعيف وهو شامي قدم الكوفة فحدثهم فسالوه عن اسمه فقال عبد الرحمن بن يزيد فظنوه بن جابر وهو ثقة فحدثوا عنه ونسبوه الي جابر وقع هذا لجماعة من الكوفيين منهم ابو اسامة وليس هو بن جابر وانما هو بن تميم وافق اسمه واسم ابنه اسم بن جابر واسم ولده وتوافقا في النسبة ايضا ولم يدخل عبد الرحمن بن يزيد بن جابر الكوفة واذا تقرر ذلك فقول عبد الرحمن بن يزيد بن جابر الثقة عن ابي سلمي الراعي اصح من قول عبد الرحمن بن يزيد بن تميم الضعيف عن ابي ظبية وقد وافق عبد الله بن العلاء بن زبر وهو من الثقات عبد الرحمن بن يزيد بن جابر علي قوله وانما ذكرته في هذا القسم للاحتمال القسم الثاني خال القسم الثالث ابو ظبية الكلاعي ذكره ابو بشر الدولابي في الصحابة لان له ادراكا واخرج من طريق ابي المغيرة عن صفوان بن عمرو عن غيلان بن معشر عن ابي ظبية السلفي بضم المهملة وفتح اللام بعدها فاء وهو الكلاعي قال خطبنا عمر بالجابية يوم جمعة فقرا اذا السماء انشقت فنزل عن المنبر فسجد وسجد الناس معه وهكذا اخرجه احمد عن ابي المغيرة عبد القدوس بن الحجاج ورجاله ثقات لكن وقع عند احمد بالمهملة وتاخير الموحدة واشار الي انه تصحيف والصواب بالمعجمة وتقديم الموحدة وحكي غيره فيه الوجهين وبالمعجمة ذكره مسلم والاكثر وقال عباس بن محمد الدوري سمعت §  <> بن معين يقول ابو ظبية الكلاعي صاحب معاذ بن جبل وقال بن خراش ارجو ان يكون سمع من معاذ واخرج ابو يعلي من طريق الاعمش عن شمر بن عطية عن شهر بن حوشب قال دخلت المسجد فاذا ابو امامة جالس فجلست اليه فجاء شيخ يقال له ابو ظبية وكانوا لا يعدلون به رجلا الا رجلا صحب النبي صلي الله عليه وسلم وروي ابو ظبية ايضا عن عمر بن الخطاب وشهد خطبته بالجابية وعن معاذ والمقداد وعمرو بن العاص وولده عبد الله بن عمرو وعمرو بن عبسة وغيرهم روي عنه من التابعين ثابت البناني وشهر بن حوشب وشريح بن عبيد وغيرهم وحديثه عن الصحابة عند ابي داود والنساءي وابن ماجة وفي الادب المفرد للبخاري قال بن ابي حاتم سالت ابا زرعة عن اسم ابي ظبية فقال لا اعرف احدا يسميه وذكره ابو زرعة الدمشقي في الطبقة العليا من تابعي اهل دمشق القسم الرابع خال حرف العين المهملة القسم الاول ابو عازب قال سمعت رسول الله صلي الله عليه وسلم يقول جد الملاءكة في طاعة الله بالعقل وجد المءمنون من بني ادم في طاعة الله علي قدر عقولهم فاعملهم بطاعة الله اوفرهم عقلا اخرجه البغوي من طريق ميسرة بن عبد ربه احد المتروكين عن حنظلة بن وداعة عن ابيه عن ابي عازب ابو العاص بن الربيع بن عبد العزي بن عبد شمس بن عبد مناف العبشمي امه هالة بنت خويلد وكان يلقب جرو البطحاء وقال الزبير بن بكار كان يقال له الامين واختلف في اسمه فقيل لقيط قاله مصعب الزبيري وعمرو بن علي الفلاس والعلاءي والحاكم ابو احمد واخرون ورجحه البلاذري ويقال الزبير حكاه الزبير عن عثمان بن الضحاك ويقال هشيم حكاه بن عبد البر ويقال مهشم بكسر اوله وسكون ثانيه وفتح الشين المعجمة وقيل بضم اوله وفتح ثانيه وكسر الشين الثقيلة حكاه الزبير والبغوي وحكي بن مندة وتبعه ابو نعيم انه قيل اسمه ياسر واظنه محرفا من ياسم وكان قبل البعثة فيما قاله الزبير عن عمه مصعب وزعمه بعض اهل العلم مواخيا لرسول الله صلي الله عليه وسلم وكان يكثر غشاءه في منزله وزوجه ابنته زينب اكبر بناته وهي من خالته خديجة ثم لم يتفق انه اسلم الا بعد الهجرة وقال بن اسحاق كان من رجال مكة المعدودين مالا وامانة وتجارة واخرج الحاكم ابو احمد بسند صحيح عن الشعبي قال كانت زينب بنت رسول الله صلي الله عليه وسلم تحت ابي العاص بن الربيع فهاجرت وابو العاص علي دينه فاتفق ان خرج الي الشام في تجارة فلما كان بقرب المدينة اراد بعض المسلمين ان يخرجوا اليه §  <> فياخذوا ما معه ويقتلوه فبلغ ذلك زينب فقالت يا رسول الله اليس عقد المسلمين وعهدهم واحدا قال نعم قالت فاشهد اني اجرت ابا العاص فلما راي ذلك اصحاب رسول الله صلي الله عليه وسلم خرجوا اليه عزلا بغير سلاح فقالوا له يا ابا العاص انك في شرف من قريش وانت بن عم رسول الله صلي الله عليه وسلم وصهره فهل لك ان تسلم فتغتنم ما معك من اموال اهل مكة قال بءسما امرتموني به ان انسخ ديني بغدرة فمضي حتي قدم مكة فدفع الي كل ذي حق حقه ثم قام فقال يا اهل مكة اوفت ذمتي قالوا اللهم نعم فقال فاني اشهد ان لا اله الا الله وان محمدا رسول الله ثم قدم المدينة مهاجرا فدفع اليه رسول الله صلي الله عليه وسلم زوجته بالنكاح الاول هذا مع صحة سنده الي الشعبي مرسل وهو شاذ خالفه ما هو اثبت منه ففي المغازي لابن اسحاق حدثني يحيي بن عباد بن عبد الله بن الزبير عن ابيه عن عاءشة قالت لما بعث اهل مكة في فداء اسراهم بعثت زينب بنت رسول الله صلي الله عليه وسلم بقلادة لها كانت خديجة ادخلتها بها علي ابي العاص فلما راها رسول الله صلي الله عليه وسلم رق لها رقة شديدة وقال للمسلمين ان رايتم ان تطلقوا لها اسيرها وتردوا عليها قلادتها ففعلوا وساق بن اسحاق قصته اطول من هذا وانه شهد بدرا مع المشركين واسر فيمن اسر ففادته زينب فاشترط عليه رسول الله صلي الله عليه وسلم ان يرسلها الي المدينة ففعل ذلك ثم قدم في عير لقريش فاسره المسلمون واخذوا ما معه فاجارته زينب فرجع الي مكة فادي الوداءع الي اهلها ثم هاجر الي المدينة مسلما فرد النبي صلي الله عليه وسلم اليه ابنته ويمكن الجمع بين الروايتين وذكر بن اسحاق ان الذي اسره يوم بدر عبد الله بن جبير بن النعمان وحكي الواقدي ان الذي اسره خراش بن الصمة قال فقدم في فداءه اخوه عمرو بن الربيع وذكر موسي بن عقبة ان الذي اسره يعني في المرة الثانية هو ابو بصير الثقفي ومن معه من المسلمين لما اقاموا بالساحل يقطعون الطريق علي تجار قريش في مدة الهدنة بين الحديبية والفتح وذكر بن المقري في فواءده من طريق ابراهيم بن سعد عن صالح بن كيسان احسبه عن الزهري قال ابو العاص بن الربيع الذي بدا فيه الجوار في ركب قريش الذين كانوا مع ابي جندل بن سهيل وابي بصير بن عتبة بن اسيد فاتي به اسيرا فقال رسول الله صلي الله عليه وسلم ان زينب اجارت ابا العاص في ماله ومتاعه فخرج فادي اليهم كل شء كان لهم وكانت استاذنت ابا العاص ان تخرج الي المدينة فاذن لها ثم خرج هو الي الشام فلما خرجت تبعها هشام بن الاسود ومن تبعه حتي ردوها الي بيتها فبعث اليها رسول الله صلي الله عليه وسلم من حملها الي المدينة ثم لحق بها ابو العاص في المدينة قبل الفتح بيسير قال وسار مع علي الي اليمن فاستخلفه علي علي اليمن لما رجع ثم كان ابو العاص مع علي يوم بويع ابو بكر وحكي ابو احمد الحاكم انه اسلم قبل الحديبية بخمسة اشهر ثم رجع الي مكة وزاد بن سعد انه لم يشهد مع النبي صلي الله عليه وسلم مشهدا واسند البيهقي بسند قوي عن عبد الله البهي عن زينب قالت قلت للنبي صلي الله عليه وسلم ان ابا العاص ان قرب فابن عم وان بعد فابوا ولد واني قد اجرته قال وقيل عن البهي ان زينب قالت وهو مرسل وقد اخرج ابو داود والترمذي وابن ماجة من طريق داود بن الحصين عن عكرمة عن بن عباس ان النبي صلي الله عليه وسلم رد علي ابي العاص بنته زينب بالنكاح الاول وكانه منتزع من القصة المذكورة قال الترمذي في حديث بن عباس ليس §  <> باسناده باس ولكن لا يعرف وجهه قال وسمعت عبد بن حميد يقول سمعت يزيد بن هارون يقول وذكر هذين الحديثين فقال حديث بن عباس اجود اسنادا والعمل علي حديث عمرو بن شعيب واخرج الترمدي وابن ماجة من طريق حجاج بن ارطاة عن عمرو بن شعيب عن ابيه عن جده ان النبي صلي الله عليه وسلم رد زينب علي ابي العاص بمهر جديد وثبت في الصحيحين من حديث المسور بن مخرمة ان النبي صلي الله عليه وسلم خطب فذكر ابا العاص بن الربيع فاثني عليه في مصاهرته خيرا وقال حدثني فصدقني ووعدني فوفي لي وقال الواقدي كان رسول الله صلي الله عليه وسلم يقول ما ذممنا صهر ابي العاص وفي الصحيحين ان النبي صلي الله عليه وسلم كان يصلي وهو حامل امامه بنت زينب ابنته من ابي العاص بن الربيع واخرج الحاكم ابو احمد بسند صحيح عن قتادة ان عليا تزوج امامة هذه بعد موت خالتها فاطمة وقال بن منده روي عنه بن عباس وعبد الله بن عمرو قال ابراهيم بن المنذر مات ابو العاص بن الربيع في خلافة ابي بكر في ذي الحجة سنة اثنتي عشرة من الهجرة وفيها ارخه بن سعد وابن اسحاق وانه اوصي الي الزبير بن العوام وكذا ارخه غير واحد وشذ ابو عبيد فقال مات سنة ثلاث عشرة واغرب منه قول بن منده انه قتل يوم اليمامة ابو العاكية بن عبيد الازدي ويقال عليكة بلام بدل الالف ياتي ابو العالية المزني لا يعرف اسمه ولا سياق نسبه ولا ذكره ابو احمد الحاكم في الكني واخرج حديثه الطبراني في مسند الشاميين من طريق ابي معيد بالتصغير واسمه حفص بن غيلان عن حبان بن حجر عن ابي العالية المزني ان رسول الله صلي الله عليه وسلم قال ستكون بعدي فتن شداد خير الناس فيها المسلمون من اهل البوادي لا يفتدون من دماء الناس ولا اموالهم ابو عامر الاشعري عم ابي موسي اسمه عبيد بن سليم بن حضار وباقي نسبه مضي في عبد الله بن قيس ذكره بن قتيبة فيمن هاجر الي الحبشة فكانه قدم قديما فاسلم وذكر انه كان عمي ثم ابصر وثبت ذكره في الصحيحين في قصة حنين وان النبي صلي الله عليه وسلم بعثه علي سرية ففي البخاري ومسلم من طريق ابي بردة بن ابي موسي الاشعري عن ابيه قال لما فرغ النبي صلي الله عليه وسلم من حنين بعث ابا عامر علي جيش الي اوطاس فلقي دريد بن الصمة فقتل دريدا فذكر الحديث وفيه فرمي ابو عامر في ركبته فرماه رجل من بني جشم بسهم فاشار فقال ان ذاك قاتلي قال فقصدت له فلحقته فلما راني ولي فقلت الا تستحي الا تثبت فالتقيت انا وهو فقتلته ثم رجعت الي ابي عامر فقلت قد قتل الله صاحبك قال فانزع هذا السهم فنزعته فنزي منه الماء فقال يا بن اخي انطلق الي رسول الله صلي الله عليه وسلم فاقرءه مني السلام وقل له يقول لك استغفر لي الحديث وفيه فدعا رسول الله صلي الله عليه وسلم بماء فتوضا منه ثم رفع يديه فقال اللهم اغفر لعبيد ابي عامر ابو عامر الاشعري اخر روي البخاري وغيره من طريق عبد الرحمن بن غنم عنه حديث المعازف فوقع في رواية البخاري حدثني ابو عامر او ابو مالك الاشعري والله ما كذبني سمعت رسول الله صلي الله عليه وسلم يقول سيكون في امتي قوم يستحلون الخز او الحرير والمعازف الحديث كذا فيه بالشك واخرجه بن حبان في صحيحه من الوجه الذي اخرجه منه البخاري فقال حدثني ابو عامر وابو مالك الاشعري قالا سمعنا رسول الله صلي الله عليه وسلم فذكراه فان كان محفوظا فابو عامر هذا غير عم ابي موسي وكانه والد عامر الذي روي عنه ابنه عامر حديث نعم الحي الاشعريون §  <> الحديث واخرجه الترمذي وروي احمد من طريق بن ابي حسين عن شهر بن حوشب عن عامر او ابي عامر او ابي مالك الاشعري ان النبي صلي الله عليه وسلم بينا هو جالس في مجلس معه اصحابه جاءه جبريل في غير صورته فحبسه رجل من المسلمين الحديث وفيه السءال عن الاسلام واخرجه بن منده وابو نعيم من هذا الوجه لكن وقع عندهما عن ابي عامر او ابي مالك حسب واخرج بن ماجة من وجه اخر عن شهر بن حوشب عن ابي مالك الاشعري حديثا اخر ليس فيه ذكر ابي عامر ابو عامر الاشعري والد عامر ذكر في الذي قبله واختلف في اسمه فقيل عبد الله بن هانء وجزم البخاري بانه عبيد بن وهب وقيل عبد الله بن عمار وقيل عبيد الله بالتصغير وقيل بالتصغير بغير اضافة وقيل اسم ابيه وهب اخرج حديثه الترمذي من طريق عبد الله بن معاذ عن نمير بن اوس عن مالك بن مسروح عن عامر بن ابي عامر الاشعري عن ابيه وقال غريب واخرجه البغوي من هذا الوجه وذكره خليفة بن خياط فيمن نزل الشام من الصحابة من قباءل اليمن وتوفي في خلافة عبد الملك بن مروان ابو عامر اخر غير منسوب راوي حديث مجء جبريل وسءاله عن الاسلام وذكر في ترجمة ابي عامر وابي مالك قريبا ابو عامر الاشعري اخو ابي موسي قيل اسمه هانء بن قيس وقيل عبد الرحمن وقيل عباد وقيل عبيد حكاه ابو عمر ابو عامر الثقفي ذكر محمد بن الحسن الشيباني في كتاب الاثار عن ابي جحيفة عن محمد بن قيس ان رجلا يكني ابا عامر كان يهدي لرسول الله صلي الله عليه وسلم كل عام راوية خمر الحديث اخرجه المستغفري من طريق ابي جحيفة ووقع من وجه اخر عند بن السكن من طريق زيد بن ابي انيسة وعن ابي بكر بن حفص عن عبد الله بن عامر بن ربيعة عن رجل من ثقيف يقال له ابو عامر انه اهدي لرسول الله صلي الله عليه وسلم راوية خمر فقال يا ابا عامر انها قد حرمت بعدك قال يا رسول الله بعها قال ان الذي حرم شربها حرم بيعها وهذا اخرجه الطبراني في الاوسط من هذا الوجه لكن قال ان رجلا من ثقيف يكني ابا تمام بمثناة وميم ثقيلة واخره ميم وقد صحفه ابو موسي كما سياتي في اخر الحروف ابو عامر السكوني ذكره البغوي ولم يخرج له شيءا وذكره بن منده واخرج من رواية بن لهيعة عن بن انعم عن عتبة بن تميم عن عبادة بن نسي عن عبد الرحمن بن غنم سمعت ابا عامر السكوني يقول قلت للنبي صلي الله عليه وسلم ما تمام البر قال تعمل في العلانية عمل السر قال بن منده وروي اسماعيل بن عياش عن حبيب بن صالح عن بن غنم عن ابي عامر حديثا ولم ينسبه واراه هذا ابو عامر اخر غير منسوب ذكره بن منده واخرج من طريق عيسي بن عبد الرحمن بن ابي ليلي عن ابيه عن سالم بن ابي الجعد عن ابي اليسر عن ابي عامر قال بعثني رسول الله صلي الله عليه وسلم الي الشام فذكر الحديث كذا فيه ولعله والد عامر ابو عامر اخر غير منسوب ذكره مطين في الصحابة وقال روي عنه اهل الكوفة §  <> واخرج الطبراني من طريق مالك بن مغول عن علي بن مدرك عن ابي عامر انه كان فيهم شء فاحتبس عن النبي صلي الله عليه وسلم فقال ما حبسك قال ذكرت هذه الاية يا ايها الذين امنوا عليكم انفسكم لا يضركم من ضل اذا اهتديتم فقال النبي صلي الله عليه وسلم لا يضركم من ضل من الكفار اذا اهتديتم ابو عاءشة والد محمد التابعي المشهور ذكره الدولابي في الصحابة ولم يخرج له شيءا ابو عبادة الانصاري اسمه سعيد بن عثمان تقدم في الاسماء قال البغوي لم ينسب اي لم يذكر نسبه الي قبيلة معينة من الانصار ابو العباس عبد الله بن العباس الهاشمي واخوه معبد بن العباس وسهل بن سعد الساعدي تقدموا في الاسماء ذكر من كنيته ابو عبد الله ايضا ممن عرف اسمه واشتهر به ابو عبد الله الارقم بن ابي الارقم والاسود بن سريع التميمي وثوبان مولي رسول الله صلي الله عليه وسلم وجابر بن سمرة السواءي وجبار بن صخر والجد بن قيس الانصاريان وجعفر بن ابي طالب الهاشمي وحذيفة بن اليمان العبسي وحرملة بن عمرو المدلجي والحسن بن علي بن ابي طالب الهاشمي والزبير بن العوام الاسدي وزياد بن لبيد الانصاري وسلمان الفارسي وشرحبيل بن حسنة وطارق بن شهاب وعامر بن ربيعة وعبيد بن خالد وعبيد بن مروان وعتبة بن فرقد وعتبة بن مسعود الهذلي وعمرو بن العاص السهمي وعمرو بن عوف المزني وعباس بن ابي ربيعة المخزومي ومحمد بن عبد الله بن جحش ونافع بن الحارث الثقفي اخو ابي بكرة والنعمان بن بشير الانصاري تقدموا كلهم في الاسماء ابو عبد الله الاشعري وقع ذكره في حديث انس من مسند عبد بن حميد عن يزيد بن هارون عن حميد عنه قال قال رسول الله صلي الله عليه وسلم يقدم عليكم قوم هم ارق افءدة الاشعريون فيهم ابو عبد الله وهو يرتجزون يقولون غدا نلقي الاحبه محمدا وحزبه هكذا اخرجه احمد بن منيع عن يزيد بن هارون وقال غيره عن حميد فيهم ابو موسي والله اعلم ابو عبد الله الخطمي جد مليح بن عبد الله يقال اسمه حصين كما تقدم حكايته في الاسماء روي مليح عن ابيه عن جده وسياتي ذكر حديثه في المبهمات ابو عبد الله الاسلمي هو ابو حدرد والد عبد الله بن ابي حدرد تقدم في الحاء المهملة ابو عبد الله القيني بفتح القاف وسكون التحتانية المثناة بعدها نون ذكر بن منده عن ابي سعيد بن يونس ان له صحبة وروي عنه ابو عبد الرحمن الحبلي وقيل ان شيخ الحبلي يكني ابا عبد الرحمن واخرج الطبراني من طريق بن لهيعة عن بكر بن سوادة عن الحبلي عن ابي عبد الرحمن القيني ان سرقا اشتري من رجل قد قرا سورة البقرة بزا قدم به فتقاضاه فتغيب منه ثم ظفر به فاتي به النبي صلي الله §  <> عليه وسلم فقال له بع سرقا قال فانطلقت به فساومني به اصحاب النبي صلي الله عليه وسلم ثلاثة ايام ثم بدا لي فاعتقته ويحتمل ان يكون واحدا ابو عبد الله المخزومي ذكره بن منده واخرج من طريق خالد بن يزيد بن ابي مالك عن ابيه عن ابي عبد الله المخزومي سمعت رسول الله صلي الله عليه وسلم يقول لا تغبر قدما عبد في سبيل الله الا حرم الله عليه النار وخالد ضعيف ابو عبد الله رجل من اصحاب النبي صلي الله عليه وسلم ذكره البخاري وقال روي عنه يحيي البكاء قال وكان بن عمر يقول خذوا عنه واخرج بن منده من طريق حماد بن سلمة عن يحيي البكاء مثله ويحيي البكاء ضعيف قال بن حزم زعم الطحاوي انه نافع اخو ابي بكرة قال ووهم في ذلك بل لعله الاسود بن سريع او عتبة بن غزوان او عتبة بن فرقد قلت ولا اظنه ايضا اصاب اما عتبة بن غزوان فانه قديم الموت لم يدركه يحيي البكاء اصلا وكذا الاسود بن سريع لم يدركه واما عتبة بن فرقد فعبسي والذي يمكن ان يكون ادركه ممن تقدم ذكره جابر بن سمرة والنعمان بن بشير ثم وجدت في معجم البغوي ابو عبد الله غير منسوب ثم ساق من طريق عطاء بن الساءب عن عرفجة قال كنا عند عتبة بن فرقد وهو يحدثنا عن رمضان اذ جاء رجل من اصحاب رسول الله صلي الله عليه وسلم فسكت فقال يا ابا عبد الله حدثنا عن رمضان فقال سمعت رسول الله صلي الله عليه وسلم يقول فذكر الحديث ثم ساقه من وجه اخر عن عطاء عن عرفجة ان رجلا من الصحابة حدث عن عتبة نحوه ابو عبد الله غير منسوب ذكره البلاذري واورد هو واحمد في مسنده من طريق حماد عن الجريري عن ابي نضرة قال مرض رجل من اصحاب رسول الله صلي الله عليه وسلم فدخل عليه اصحابه يعودونه فبكي فقالوا له يا ابا عبد الله ما يبكيك الم يقول رسول الله خذ من شانك ثم اصبر حتي تلقاني قال بلي ولكن سمعت رسول الله صلي الله عليه وسلم يقول قبض الله قبضة بيمينه فقال هءلاء للجنة ولا ابالي وقبض قبضة بيده الاخري فقال هءلاء للنار ولا ابالي لفظ الباوردي زاد احمد في اخره فلا ادري في اي القبضتين انا سنده صحيح ابو عبد الله غير منسوب اخر روي حديثه الحسن بن سفيان في مسنده من طريق الوليد بن مسلم حدثنا الاوزاعي حدثنا يحيي بن ابي كثير حدثني ابو قلابة حدثني ابو عبد الله قال قال رسول الله صلي الله عليه وسلم بءس مطية الرجل زعموا وسنده صحيح متصل امن فيه من تدليس الوليد وتسويته وقد اخرجه ابو داود في السنن من طريق وكيع عن الاوزاعي فقال فيه عن ابي قلابة قال قال ابو مسعود لابي عبد الله او قال ابو عبد الله لابي مسعود ما سمعت رسول الله صلي الله عليه وسلم يقول في زعموا الحديث قال ابو داود ابو عبد الله هذا هو حذيفة بن اليمان كذا قال وفيه نظر لان ابا قلابة لم يدرك حذيفة وقد صرح في رواية الوليد بان ابا عبد الله حدثه والوليد اعرف بحديث الاوزاعي من وكيع وقال بن منده ابو عبد الله هذا هو الذي روي عنه ابو نضرة قلت وهو محتمل ابو عبد الله غير منسوب اظنه احد الذين قبله ويجوز ان يكون هو عتبة بن فرقد واخرج §  <> النساءي من طريق شعبة عن عطاء بن الساءب عن عرفجة يعني بن عبد الله الثقفي قال كنت في بيت عتبة بن فرقد فاردت ان احدث بحديث وكان رجل من اصحاب النبي صلي الله عليه وسلم اولي بالحديث مني فحدث الرجل عن النبي صلي الله عليه وسلم فذكر الحديث في فضل رمضان ورواه الثوري عن عطاء عن عرفجة عن عتبة عن رجل من اصحاب رسول الله صلي الله عليه وسلم ورواه محمد بن فضيل عن عطاء مثله لكن قال ان رجلا من اصحاب رسول الله صلي الله عليه وسلم حدث عنه عتبة بن فرقد ورواه بن عيينة عن عطاء عن عرفجة عن عتبة بن فرقد نفسه قال النساءي حديث شعبة اولي بالصواب من حديث بن عيينة قلت ويءيد قوله ان ابراهيم بن طهمان رواه عن عطاء بن الساءب عن عرفجة قال كنت عند عتبة فدخل رجل من الصحابة فامسكه عتبة حين راه فقال عتبة يا فلان حدثنا فذكره اخرجه الحارث بن ابي اسامة قال ابو نعيم رواه عبد السلام بن حرب وغيره عن عطاء علي الايهام قلت ورواه حماد بن سلمة عن عطاء عن عرفجة قال كنت عند عتبة بن فرقد وهو يحدثنا عن شهر رمضان اذ دخل رجل من الصحابة فسكت عتبة ثم قال يا ابا عبد الله حدثنا عن شهر رمضان فقال سمعت رسول الله صلي الله عليه وسلم يقول شهر رمضان شهر مبارك تفتح فيه ابواب الجنة وتغلق فيه ابواب الجحيم اخرجه بن منده وقبله الباوردي ابو عبد الله اخر غير منسوب روي عنه ابو مصبح المقرءي في فضل المشي في سبيل الله وفيه قصة لمالك بن عبد الله الخثعمي وقد ذكرت في ترجمة مالك انه جابر بن عبد الله الانصاري ذكر من كنيته ابو عبد الرحمن ممن عرف اسمه واشتهر به ابو عبد الرحمن بلال بن الحارث المزني وبلال بن رباح المءذن وبشر بن ارطاة او بن ابي ارطاة العامري والحارث بن هشام المخزومي وزيد بن خالد الجهني وزيد بن الخطاب العدوي والساءب بن خباب وشرحبيل الجعفي والضحاك بن قيس الفهري وعبد الله بن حنظلة بن ابي عامر الانصاري وعبد الله بن الساءب وعبد الله بن عامر وعبد الله بن عتيبة بن مسعود وعبد الله بن ابي ربيعة المخزومي وعبد الله بن عمر وعبد الله بن عمرو في قول وعبد الله بن مسعود وعويم بن ساعدة والمسور بن مخرمة الزهري ومعاوية بن حديج الكندي ومعاوية بن ابي سفيان الاموي تقدموا كلهم في الاسماء ابو عبد الرحمن الانصاري الذي قال له النبي صلي الله عليه وسلم سم ابنك عبد الرحمن بعد ان كان سماه القاسم فسماه عبد الرحمن ثبت ذلك في الصحيحين ابو عبد الرحمن الجهني نزيل مصر قال البغوي روي عن النبي صلي الله عليه وسلم حديثين وسكن مصر وروي عنه ابو الخير مرثد بن عبد الله اليزني قلت احدهما عند احمد وابن ماجة والطحاوي من رواية محمد بن اسحاق عن يزيد بن ابي حبيب عن ابي الخير عنه عن النبي صلي الله عليه وسلم قال اني راكب غدا الي اليهود فلا تبدءوهم بالسلام الحديث وخالفه بن لهيعة وعبد الحميد بن جعفر فروياه عن يزيد بن ابي حبيب عن ابي الخير عن ابي نضرة الغفاري اخرجه احمد والنساءي والطحاوي من رواية عبد الحميد زاد احمد والطحاوي ومن رواية بن لهيعة وقد قيل عن محمد بن §  <> اسحاق كرواية عبد الحميد بن جعفر اخرجه الطحاوي بغير رواية عبد الله بن عمر الرقي عن بن اسحاق ورويناه في المختارة للضياء من طريق محمد بن سلمة عن بن اسحاق اخرجه من معجم الطبراني عقب رواية عبد الحميد بن جعفر عن يزيد بن ابي حبيب وثانيهما اخرجه البغوي من طريق بن اسحاق ايضا بهذا السند في قصة الراكبين المذحجين اللذين بايعا رسول الله صلي الله عليه وسلم وقد ذكره في الصحابة البخاري والترمذي والبغوي والدولابي والعسكري وابن يونس والباوردي وغيرهم وذكره بن سعد في طبقة من شهد الخندق وانفرد ابو الفتح الازدي فحكي ان اسمه زيد وقرات بخط الحافظ عماد الدين بن كثير انه قيل هو عقبة بن عامر الصحابي المشهور ابو عبد الرحمن الخطمي ذكره البخاري والطبراني وغيرهما في الصحابة واخرج البخاري عن مكي بن ابراهيم عن الجعيد بن عبد الرحمن عن موسي بن عبد الرحمن الخطمي انه سمع محمد بن كعب القرظي يسال عبد الرحمن ما سمعت من ابيك فقال سمعت ابي يقول سمعت رسول الله صلي الله عليه وسلم يقول مثل الذي يلعب بالنرد كالذي يتوضا بالدم واخرجه الطبراني من طريق حاتم بن اسماعيل عن الجعيد به ولفظه يسال اباه عبد الرحمن اخبرني ما سمعت اباك يحدث عن النبي صلي الله عليه وسلم في شان الميسر فقال عبد الرحمن سمعت ابي يقول سمعت رسول الله صلي الله عليه وسلم يقول من لعب بالميسر ثم قام يصلي فمثله كمثل الذي يتوضا بالقيح ودم الخنزير افتقول ان الله يقبل له صلاة قال ابو نعيم رواه غيره فلم يذكر فيه اباه ابو عبد الرحمن الفهري مختلف في اسمه فقيل يزيد بن انيس وقيل كرز بن ثعلبة وقيل اسمه عبيد وقيل الحارث ذكره بن يونس فيمن شهد فتح مصر واخرج حديثه ابو داود والبغوي ووقع لنا بعلو في مسند الدارمي من طريق يعلي بن عطاء عن ابي همام عبد الله بن يسار عنه انه شهد حنينا وقال ابو عمر هو الذي سال بن عباس عن مقام رسول الله صلي الله عليه وسلم عند الكعبة قلت وقد فرق بينهما بن مندة وهو الذي يظهر رجحانه فقد صرح غير واحد بان عبد الله بن يسار تفرد بالرواية عن ابي عبد الرحمن الفهري وكان ابا عمر لما راي ان الفهري والقرشي نسبة واحدة ظنهما واحدا ابو عبد الرحمن القرشي عم محمد بن عبد الرحمن بن الساءب قال بن مندة ذكر في الصحابة ولا يثبت روي محمد بن عبد الرحمن بن الساءب عن ابي عبد الرحمن القرشي ان بن عباس ساله عن الموضع الذي كان النبي صلي الله عليه وسلم نزل فيه للصلاة يعني عند الكعبة فقال نعم عند الشقة الثالثة تجاه الكعبة مما يلي باب بني شيبة يقوم فيه للصلاة فقال له اثبته قال نعم قد اثبته ابو عبد الرحمن القيني تقدم ذكره فيمن كنيته ابو عبد الله وقيل هو غيره وذكر بن الكلبي انه كان يقال له ذو الشوكة لانه كانت له شوكة اذا قاتل لا يفارقها قال وكان جسيما وشهد فتوح الشام فقاتل مع ابي عبيدة يوم اجنادين فقتل ثمانية من الروم فقال ابو عبيدة ينوه به افعل كفعل الضخم من قضاعة بطاعة الله ونعم الطاعة §  <> وذكر خليفة وغيره ان معاوية ولاه غزو الروم فغزا انطاكية من سنة خمس واربعين الي سنة ثمان واربعين ابو عبد الرحمن المخزومي ذكره الطبراني واخرج من رواية عثمان بن عبد الرحمن عن ابيه عن جده ان سعيدا سال النبي صلي الله عليه وسلم عن الوصية فقال له الربع واظنه سعيد بن يربوع فان ابا داود اخرج من طريق زيد بن الحباب عن عمر بن عثمان بن سعيد المخزومي حدثني جدي عن ابيه ان رسول الله صلي الله عليه وسلم قال يوم فتح مكة اربعة لا اءمنهم في حل ولا حرم الحديث ابو عبد الرحمن المذحجي روي حديثه عياض بن عبد الرحمن المذحجي عن ابيه عن جده قاله بن مندة ابو عبد الرحمن النخعي له ذكر كذا في التجريد ابو عبد الرحمن حاضن عاءشة ذكره الدولابي ومطين وابن السكن واخرج من طريق علي بن هاشم عن عبد الملك بن ابي عبد الله قاضي الري عن عباد عن ابي عبد الرحمن حاضن عاءشة قال قلنا له الا تذكر لنا من فضاءل علي بن ابي طالب قال هي اكثر من ان تحصر قلنا فاذكر لنا بعضها قال افعل استاذن علي علي النبي صلي الله عليه وسلم وانا في البيت فسمعته يقول انك لاول من ينفض التراب عن راسه يوم القيامة قلت وعباد من غلاة الرافضة وعلي بن هاشم شيعي واخرجه مطين والدولابي من طريق علي بن هاشم عن عبد الملك عن عبد الله بن عبد الله الرازي عن يحيي بن ابي محمد عن ابي عبد الرحمن حاضن عاءشة قال رايت النبي صلي الله عليه وسلم وعليه ثوب بعضه علي علي وبعضه علي عاءشة وفي لفظ نصفه علي النبي صلي الله عليه وسلم ونصفه علي عاءشة ابو عبد العزيز ذكره بن ابي عاصم في الصحابة وروي من طريق بقية عن عبد الغفور الانصاري عن عبد العزيز عن ابيه وكانت له صحبة فذكر حديثا تقدم فيمن اسمه سعيد واخرجه الطبري في تفسير سورة الاعراف عن عبد الغفار بن عبد العزيز الانصاري عن عبد العزيز الشامي عن ابيه وكانت له صحبة قال قال رسول الله صلي الله عليه وسلم من لم يحمد الله علي ما عمل من عمل صالح وحمد نفسه قل شكره وحبط عمله ومن زعم ان الله جعل للعباد من الامر شيءا فقد كفر بما انزل الله علي انبياءه لقوله تعالي الا له الخلق والامر ابو عبد الملك قيس بن سعد بن عبادة الانصاري الخزرجي تقدم في الاسماء ابو عبد الملك الحكم بن ابي العاص الثقفي اخو عثمان تقدم ايضا ابو عبد يسوع حديثه في الدلاءل للبيهقي من زيادات يونس بن بكير في مغازي بن اسحاق ياتي في المبهمات ابو عبدة احد رسل النبي صلي الله عليه وسلم الي اليمن ذكره المداءني وقد تقدم ذكره في ترجمة الحارث بن عبد كلال ابو عبس بن جبر بن عمرو بن زيد بن جشم بن مجدعة بن حارثة بن الحارث بن الخزرج بن عمرو بن مالك بن الاوس الانصاري الاوسي قيل كان اسمه في الجاهلية عبد العزي وقيل معبد فسماه §  <> النبي صلي الله عليه وسلم عبد الرحمن قال بن الكلبي هو احد من قتل كعب بن الاشرف واورد ذلك بن منده بسنده الي محمد بن طلحة التيمي عن عبد المجيد بن ابي عبس بن محمد بن ابي عبس بن جبر عن ابيه عن جده قال كان كعب بن الاشرف يقول الشعر ويخذل عن رسول الله صلي الله عليه وسلم فذكر الحديث في قصة قتله وذكره موسي بن عقبة وغيره فيمن شهد بدرا وقيل كان عمره يومءذ ثمانيا واربعين سنة وكان هو وابو بردة يكسران اصنام بني حارثة حين اسلما وقال الزبير بن بكار في الموفقيات حدثني محمد بن الضحاك عن ابيه قال اعطي رسول الله صلي الله عليه وسلم ابا عبس بن جبر بعد ما ذهب بصره عصا فقال تنور بهذه فكانت تضء له ما بين وقال المداءني مات سنة اربع وثلاثين وهو بن سبعين سنة وصلي عليه عثمان وحديثه عند البخاري من طريق عباية بن رفاعة عنه في فضل المشي في سبيل الله وذكر في الكني من طريق بن ابي ذءب عن صالح مولي التوامة ان عثمان عاد ابا عبس وكان بدريا وروي عنه ايضا ولده زيد وحفيده ابو عبس بن محمد بن ابي عبس وقال بن سعد اخي النبي صلي الله عليه وسلم بينه وبين خنيس بن حذافة ابو عبس بن عامر بن عدي بن سواد بن عدي بن غنم بن كعب بن سلمة الانصاري السلمي ذكر بن الكلبي انه شهد بدرا ابو عبيد الله جد حرب بن عبيد الله قال ابو عمر له صحبة ولا احفظ له خبرا قلت اخرج ابو داود في كتاب الخراج من طريق عطاء بن الساءب عن حرب بن عبيد الله الثقفي عن جده قال اتيت رسول الله صلي الله عليه وسلم فاسلمت فعلمني الاسلام وعلمني كيف اخذ الصدقة الحديث وذكر فيه اختلافا علي عطاء بن الساءب ففي رواية عبد السلام بن حرب عنه عن حرب بن عبيد الله عن جده ولم يسمه من طريق ابي الاحوص عن عطاء عن حرب عن جده ابي امه ومن طريق الثوري عن عطاء عن حرب مرسلا وفي رواية عن عطاء عن رجل من بكر بن واءل عن خاله قال قلت يا رسول الله اعشر قومي وفيه اختلاف اخر ويقال ان اسم جده حرب بن عبيد الله ابو عبيد غير منسوب روي عنه خالد بن معدان ياتي في القسم الرابع ابو عبيد بن مسعود بن عمرو بن عمير بن عوف بن عقدة بن غيرة بن عوف بن ثقيف الثقفي صاحب المنبر الذي استشهد في جماعة من المسلمين في قتال الفرس فيقال قتل يوم جسر ابو عبيد وهو والد المختار بن ابي عبيد الذي غلب علي الكوفة في خلافة عبد الله بن الزبير سنة ثلاث عشرة وقال ابو بكر بن ابي شيبة في مصنفه حدثنا ابو اسامة عن اسماعيل بن ابي خالد عن قيس بن ابي حازم قال كان ابو عبيد بن مسعود الثقفي عبر الفرات الي نهروان فقطعوا الجسر خلفه فقتل وقتل اصحابه وقال البلاذري يقال ان الفيل برك علي ابي عبيد فمات تحته فاخذ الراية اخوه الحكم فقتل فاخذها جبر بن ابي عبيد فقتل ابو عبيد الزرقي ويقال ابو عبد الله مختلف في صحبته ذكره البغوي واخرج من طريق بن القاري حدثني بن ابي عبيد الزرقي انه خرج مع ابيه فلما كان من الليل اذ هو برجل علي §  <> الطريق قال فعرسنا عنده قال فلما طلع الفجر قال مالك وللوحدة اما سمعت ما قال رسول الله صلي الله عليه وسلم قال اني لم اسافر انما خرجت من هذا الماء الي هذا الماء قال ممن انت قال من الانصار قال ابشر قال فاني لست منهم انما انا من مواليهم قال فانت منهم فذكر الحديث بطوله وفيه قوله صلي الله عليه وسلم اللهم اغفر للانصار وفيه قوله حلفاءنا منا وموالينا منا وذكره بن منده مختصرا واخرج ابو داود في فضاءل الانصار من طريق بن ابي عبيد الزرقي عن ابيه ان النبي صلي الله عليه وسلم قال اللهم اغفر للانصار الحديث مختصرا ابو عبيد مولي رسول الله صلي الله عليه وسلم ذكره الحاكم ابو احمد فيمن لا يعرف اسمه واخرج حديثه الترمذي في الشماءل والدارمي من طريق شهر بن حوشب عنه قال طبخت للنبي صلي الله عليه وسلم قدرا وكان يعجبه الذراع الحديث ورجاله رجال الصحيح الا شهر بن حوشب قال البغوي له صحبة حدثني عباس عن يحيي بن معين قال ابو عبيد الذي روي عنه شهر هو من الصحابة ابو عبيد مولي رفاعة بن رافع ذكره الدولابي والطبراني واوردا من طريق عبد الله بن معقل عن ابي مسلم عن ابي عبيد مولي رفاعة ان رسول الله صلي الله عليه وسلم قال ملعون من سال بوجه الله ملعون من سءل بوجه الله فمنع ابو عبيدة قيل هي كنية ابي محجن الثقفي وابو محجن اسمه سمي بلفظ الكنية ابو عبيدة بن الجراح الفهري امين هذه الامة واحد العشرة من من السابقين اسمه عامر بن عبد الله الجراح اشتهر بكنيته والنسبة الي جده تقدم ابو عبيدة بن عمرو بن محصن بن عتيك بن عمرو بن مبذول بن عمرو بن غنم بن مالك بن النجار الانصاري ذكره ابو عمر مختصرا وقال انه ممن استشهد ببءر معونة ابو عبيدة بن عمارة بن الوليد بن المغيرة المخزومي استشهد باجنادين مع خالد بن الوليد وامه فاطمة بنت الوليد بن المغيرة ذكره الزبير بن بكار وقد ذكرت قصة والده عمارة في ترجمة اخيه الوليد بن عمارة ابو عبيدة مولي ابي راشد الازدي تقدم في عبدالقيوم وكناه بن السكن والباوردي والحاكم ابو احمد ابا عبيد بلا هاء ابو عبيدة الديلي ذكره ابو عمر فقال يقال له صحبة ولا احفظ له خبرا وذكره بن ابي عاصم في الوحدان وذكره بن منده في مسافع وتقدم هناك ابو عتاب الاشجعي ذكره بن منده وقال روي ابو مالك الاشجعي عن عبد الرحيم بن نوفل عن ابيه وعن عتاب الاشجعي عن ابيه في قراءة قل يا ايها الكافرون عند النوم قال ابو نعيم الصحيح في هذا رواية ابي اسحاق عن فروة بن نوفل عن ابيه قال بن الاثير لكن بن منده معذور لانه لو اهمله لاستدركوه عليه وان كان بعض الرواة شذ بروايته قلت وهو كذلك ويحتمل ان §  <> يكون للحديث اسنادان بصحابيين ابو عثمان الانصاري اخرج بن السكن والطبراني من طريق بن ابي الزناد عن ابيه عن ابي سلمة عن ابي عثمان الانصاري قال دق علي رسول الله صلي الله عليه وسلم الباب وقد الممت بالمراة الحديث في الماء من الماء وقيل عن ابي الزناد عن ابي سلمة عن عتبان بن مالك وهو اشهر ويحتمل التعدد ابو عثمان الحجبي هو شيبة بن عثمان تقدم في الاسماء ابو عثمان البكالي بكسر الموحدة وتخفيف الكاف اسمه عمرو بن عبد الله تقدم ابو عديسة ذكره البغوي ولم يخرج له شيءا ابو عدي اسمه طليب بن عمير بن وهب بدري تقدم في الاسماء ابو عذرة بضم اوله وسكون الذال المعجمة ياتي في القسم الثالث ابو عرس بضم اوله وسكون ثانية قال ابو عمر روي عن النبي صلي الله عليه وسلم من كانت له ابنتان فاطعمهما الحديث قال جاء من وجه ضعيف مجهول كذا ذكره مختصرا وساقه الحاكم ابو احمد من طريق اسحاق بن ادريس عن عبد الله بن سليمان عن حرملة عن عتبة بن عامر او عامر بن عتبة عن ابي عرس قال قال رسول الله صلي الله عليه وسلم من كانت له ابنتان فاطعمهما وسقاهما وكساهما من جدته فصبر عليهما كن له حجابا من النار ومن كانت له ثلاث فصبر عليهن فذكر مثله وزاد ولم يكن عليه صدقة ولا جهاد ابو العريان المحاربي اورد حديثه البغوي والطبراني وغيرهما من طريق ابي خلدة خالد بن دينار عن محمد بن سيرين انه سءل عن السهو في الصلاة فقال حدثني ابو العريان ان نبي الله صلي الله عليه وسلم صلي يوما ودخل البيت وكان في القوم رجل طويل اليدين الحديث وذكره ابو عمر فقال روي عنه محمد بن سيرين مثل حديث ابي هريرة في قصة ذي اليدين فقيل انه ابو هريرة وابو العريان غلط من ابي خلدة وقيل انه ابو العريان الهيثم بن الاسود النخعي ثم ساق شيءا من اخبار ابي العريان النخعي وهو خطا فان ابا العريان النخعي لا صحبة له ولا يثبت ادراكه الا علي بعد كما تقدم في ترجمته ابو عريب المليكي تقدم في عريب ابو عريض قال ابو عمر ذكره ابو حاتم الرازي عن محمد بن دينار الخراساني عن عبد الله بن المطلب عن محمد بن جابر الحنفي عن ابي مالك الاشجعي عن ابي عريض وكان دليل رسول الله صلي الله عليه وسلم من اهل خيبر قال اعطاني رسول الله صلي الله عليه وسلم فذكر حديثا منكرا انتهي وهذا الحديث ساقه الحاكم ابو احمد في الكني عن محمد بن المسيب عن ابي حاتم وتعقبه قال قلت يا رسول الله اخاف الا اعطي ما تقول قال بلي سوف تعطاها قلت ومن يعطينيها يا رسول الله قال ابو بكر فلقيت عليا فاخبرته فقال ارجع اليه فقل له من يعطينيها بعد ابي بكر قال عمر قال فبعد عمر قال عثمان فلما راي ذلك سكت ووجه ضعفه ان محمد بن جابر الحنفي والراوي عنه ضعيفان لكن §  <> رواه يعقوب بن عبد الرحمن الحنفي عن محمد بن جابر اخرجه ابو موسي من طريق عبد الله بن موسي بن اسحاق الهاشمي عن علي بن الازهر بن سراج عن احمد بن عبد المءمن النصري عن يعقوب ولفظه كان لي علي رسول الله صلي الله عليه وسلم اجال فاتيته اتقاضاها فاعطاني وبقيت لي بقية فقلت يا رسول الله ارايت ان لم اجدك قال فات ابا بكر فلقيني علي فقال ارجع فسله ان لم اجد ابا بكر قال فات عمر فلقيني علي فقال قل له فان لم اجد عمر قال فات عثمان ابو عزة الهذلي اسمه يسار بن عبد وقيل بن عبد الله وقيل بن عمرو حكي الاقوال الثلاثة ابو احمد الحاكم والاول اكثر وبه جزم البخاري وقد تقدم في الاسماء ذكر من قال انه بن عمرو وذكر ابو احمد العسكري انه عبد الله بالاضافة ونقله ابو احمد الحاكم عن ابي نعيم الفضل بن دكين وقيل انه مطر بن عكامس لان الحديث الذي روي لابي عزة ومطر واحد وهذا ليس بشء لان في بعض طرق حديث ابي عزة تسميته يسارا كما تقدم في الاسماء وقد اخرج حديثه وسماه الترمذي في جامعه من طريق ايوب عن ابي المليح بن اسامة عن ابي عزة رفعه اذا قضي الله لعبد ان يموت بارض جعل له اليها حاجة قال الترمذي ابو عزة ما له صحبة واسمه يسار بن عبد واخرج الحاكم ابو احمد من طريق عبد الله بن ابي حميد عن ابي المليح حدثنا ابو عزة يسار بن عمرو وكان من اصحاب النبي صلي الله عليه وسلم رفعه خمس لا يعلمها الا الله ابو عزيز بن عبد الرحمن اسمه ابيض تقدم في الاسماء ابو عزيز بن جندب بن النعمان قال ابو عمر مذكور في الصحابة ولا يعرف وقيل هو جندب بن النعمان كذا قال والراجح انه جندب وابو عزيز كنيته كما تقدم في الاسماء ابو عزيز بن عمير بن هاشم بن عبد مناف بن عبد الدار العبدري قال ابو عمر اسمه زرارة وله صحبة وسماع من النبي صلي الله عليه وسلم واتفق اهل المغازي علي انه اسر يوم بدر مع من اسر من المشركين قال بن اسحاق فحدثني نبيه بن وهب قال سمعت من يذكر عن ابي عزيز قال كنت في الاساري يوم بدر فسمعت رسول الله صلي الله عليه وسلم يقول استوصوا بالاساري خيرا فقال بن منده لما ترجم له في الصحابة روي عنه نبيه بن وهب ولا يعرف له سند ثم ساق بسنده الي خليفة بن خياط انه ذكره في الصحابة وتعقبه ابو نعيم فقال لا اعلم له اسلاما وقال الزبير بن بكار وابن الكلبي وابو عبيد والبلاذري والدارقطني ان ابا عزيز قتل يوم احد كافرا ورد ذلك ابو عمر بان بن اسحاق عد من قتل من الكفار من بني عبد الدار احد عشر رجلا ليس فيهم ابو عزيز وانما فيهم ابو يزيد بن عمير وفات خليفة خياط ذكره في الصحابة ابو عسيب مولي رسول الله صلي الله عليه وسلم مشهور بكنيته وقد تقدم ذكر من قال في احمر انه اسمه وذكر من قال انه سفينة مولي ام سلمة والراجح انه غيره واخرج حديثه احمد والحارث بن ابي اسامة والطبراني والحاكم ابو احمد من طريق يزيد بن هارون عن مسلم بن عبيد عنه في الحمي والطاعون ووقع عند الحاكم عن مسلم بن عبيدة عن ابي بصير باثبات الهاء في عبيدة دون §  <> بصير والاول الصواب واخرج له بن منده حديثا اخر من رواية حشرج بن نباتة عن ابي بصيرة واسناده حسن ابو عسيم اخره ميم قيل هو الذي قبله وغاير بينهما البغوي والحاكم ابو احمد وقال البغوي لا ادري له صحبة ام لا واخرجا من طريق حماد بن سلمة عن ابي عمران الجوني عن ابي عسيم قال لما قبض رسول الله صلي الله عليه وسلم قالوا كيف نصلي عليه قال ادخلوا عليه من هذا الباب ارسالا ارسالا فصلوا واخرجوا من الباب الاخر فلما وضعوه في لحده قال المغيرة انه قد بقي من قبل قدمه شء لم يصلح قالوا فادخل فاصلحه قال فدخل فمس قدم النبي صلي الله عليه وسلم ثم قال اهيلوا علي التراب فاهالوا عليه حتي بلغ انصاف ساقيه ثم خرج فقال انا احدثكم عهدا برسول الله صلي الله عليه وسلم وهكذا اخرجه ابو مسلم الكجي من طريق حماد واخرجه بن منده في ترجمة عسيب ووقع عنده بالموحدة ابو عصيب اورد البغوي في ترجمة ابي عسيب الماضي قبل حديثا من طريق حشرج بن نباتة حدثني ابو بصير عن ابي عصيب قال خرج رسول الله صلي الله عليه وسلم فدعاني فخرجت اليه ثم مر بابي بكر فدعاه فخرج اليه ثم مر بعمر فدعاه فخرج اليه ثم انطلق يمشي ونحن معه حتي دخل حاءطا لبعض الانصار فقال لصاحبه اطعمنا بسرا فجاء بعذق فوضعه فاكل رسول الله صلي الله عليه وسلم واصحابه ثم دعا بماء فشرب ثم قال انكم لمسءولون عن هذا يوم القيامة فاخذ عمر العذق فضرب به الارض حتي تناثر البسر بين يدي رسول الله صلي الله عليه وسلم ثم قال انا لمسءولون عن هذا يوم القيامة قال نعم الا من ثلاث خرقة يواري الرجل بها عورته وكسرة يسد بها الرجل جوعته وجحر يدخل فيه من الحر والبرد وافردته عن ابي عسيب لاحتمال ان يكون غيره ابو العصير ذكر صاحب الفردوس انه روي عن النبي صلي الله عليه وسلم انه قال اللهم ارني الدنيا كما تريها صالح عبادك ولم يخرج له ولده سندا ابو عطية البكري ذكره بن منده واخرج من طريق يحيي بن عمر حدثنا مسلم عن عبد الله ابو فاطمة الازدي سمعت ابا عطية البكري يقول انطلق بي اهلي الي النبي صلي الله عليه وسلم وانا غلام شاب قال ابو فاطمة رايت ابا عطية يجمع بسجستان وكان نزل خارجا من المدينة علي نحو ميل ورايت ابا عطية ابيض الراس واللحية ورايته يعتم بعمامة بيضاء ابو عطية المزني روي حديثه بكر بن سوادة عن عبد الرحمن بن عطية عن ابيه عن جده عداده في اهل مصر قاله بن منده عن بن يونس ابو عطية غير منسوب ذكره الطبراني وغيره في الصحابة واخرج البغوي وابو احمد الحاكم من طريق اسماعيل بن عياش والطبراني من طريق بقية كلاهما عن بجير بن سعد عن خالد بن معدان عن ابي عطية ان رجلا توفي علي عهد رسول الله صلي الله عليه وسلم فقال بعضهم يا رسول الله لا تصل عليه فقال هل راه احد منكم علي شء من عمل الخير فقال رجل حرس معنا ليلة كذا وكذا قال §  <> فصلي عليه رسول الله صلي الله عليه وسلم ثم مشي الي قبره ثم حثا عليه ويقول ان اصحابك يظنون انك من اهل النار وانا اشهد انك من اهل الجنة ثم قال رسول الله صلي الله عليه وسلم لعمر انك لا تسال عن اعمال الناس وانما تسال عن الغيبة لفظ اسماعيل وعند ابي احمد من رواية البغوي وانما تسال عن الفطرة وفي رواية بقية في اوله قال ابو عطية ان رسول الله صلي الله عليه وسلم جلس فحدث ان رجلا توفي فقال هل راه احد وفيه فقال رجل حرست معه ليلة في سبيل الله وفي اخره ثم قال لعمر بن الخطاب لا تسال عن اعمال الناس ولكن تسال عن الفطرة زاد في رواية البغوي يعني الاسلام واخرجه ابو نعيم من طريق محمد بن عثمان بن ابي شيبة وخلط ابو عمر ترجمته بترجمة ابي عطية الوادعي وقال قيل اسم ابي عطية مالك بن ابي عامر وتعقبه ابو الوليد بن الدباغ بان ابا عطية صاحب الترجمة لم ينسب وقد افرده ابو احمد الحاكم عن الواقدي وذكر الاختلاف في اسم الوادعي وذكر هذا فيمن لا يعرف اسمه قلت وهو كما قال قال ابو احمد ابو عطية ان رجلا توفي روي عنه خالد بن معدان وهو خليق ان يكون عداده في الصحابة قلت ووقع في كلام بن عساكر انه ابو عطية المذبوح وقد اخرج الحاكم ابو احمد المذبوح ايضا ترجمته فيمن لا يعرف اسمه فقال روي ابو بكر بن ابي مريم عن حماد بن سعد عنه هكذا ذكر محمد بن اسماعيل قلت وكان بن عساكر لما راي رواية ابي بكر بن ابي مريم عن المذبوح وهو شامي وخالد بن معدان شامي ايضا ظن انه هو والذي يظهر لي انه غيره كما صنع ابو احمد والله اعلم ابو عطية اخر غير منسوب ذكره بن السكن في الصحابة وقال له حديث مختلف فيه ثم اخرج من طريق عمرو بن ابي المقدام عن ابي اسحاق عن ابي الاسود عن ابي عطية قال قال رسول الله صلي الله عليه وسلم عمرة في رمضان تعدل حجة قال بن السكن لم يرو غيره وجوز غيره ان يكون الوادعي فان يكن هو فالحديث مرسل ابو عفير ذكره البغوي ولم يخرج له شيءا ابو عقبة الفارسي مولي الانصاري اسمه رشيد تقدم روي ابو داود من طريق ابي اسحاق عن داود بن الحصين عن عبد الرحمن بن ابي عقبة الفارسي قال شهدت يوم احد فضربت رجلا فقلت خذها وانا الغلام الفارسي فقال النبي صلي الله عليه وسلم الا قلت وانا الغلام الانصاري هذا وفي المغازي لابن اسحاق قال فيه عبد الرحمن بن ابي عقبة عن ابيه ابو عقبة اهبان بن اوس الاسلمي تقدم في الاسماء ابو عقبة روي له بقي بن مخلد في مسنده حديثا ذكره في التجريد فلعله ابو عقبة الفارسي المنبه عليه في عقبة في الاسماء وقد ترجم له البغوي فقال ابو عقبة الفارسي وساق من طريق داود بن الحصين عن عبد الرحمن بن ابي عقبة عن ابي عقبة وكان مولي من اهل فارس قال شهدت يوم احد فذكره ابو عقرب البكري من بني عريج بمهملة وجيم مصغرا بن بكر بن عبد مناة بن كنانة وقيل فيه ليثي وهو غلط مختلف في اسمه فقيل خالد بن بجير وقيل عويج بفتح اوله وبالواو بن خالد وقيل §  <> عريج كاسم جده الاعلي بن خويلد وقيل معاوية بن خويلد وقيل بل معاوية اسم ولده ابي نوفل الراوي عنه وقيل اسم الراوي عنه معاوية بن مسلم فعلي هذا اسمه هو مسلم وقيل بن عقرب فعلي هذا ابو عقرب جده وقيل اسم ابي نوفل عمرو وقال بن سعد كان من اهل مكة ثم سكن البصرة ويقال انه كان من الاجواد وحديثه عند النساءي من طريق الاسود بن سنان عن ابي نوفل بن ابي عقرب عن ابيه قال سالت النبي صلي الله عليه وسلم عن الصوم وسنده حسن واخرج الحاكم من وجه اخر عن الاسود بن سنان عن ابي نوفل بن ابي عقرب عن ابيه قصة لهب بن ابي لهب ودعاء النبي صلي الله عليه وسلم ان ياكله السبع ابو عقيل الانصاري صاحب الصاع ثبت ذكره في الصحيح من حديث بن مسعود قال لما امرنا بالصدقة كنا نتحامل فتصدق ابو عقيل بنصف صاع وجاء انسان باكثر من ذلك فقال المنافقون ان الله لغني عن صدقة هذا الحديث وسماه قتادة في تفسير الذين يلمزون المطوعين من المءمنين في الصدقات حثحاث بمهملتين مفتوحتين ومثلثتين الاولي ساكنة اخرجه الطبري وغيره وفيه جاء عبد الرحمن بن عوف بنصف ماله واقبل رجل من فقراء المسلمين من الانصار يقال له الحثحاث ابو عقيل فقال يا رسول الله بت اجر الجرير علي صاعين من تمر فاما صاع فامسكته لعيالي واما صاع فها هو هذا فقال المنافقون ان كان الله ورسوله لغنيين عن صاع ابي عقيل واخرجه بن ابي شيبة والطبراني ايضا والطبري والباوردي من طريق موسي بن عبيدة عن خالد بن يسار عن بن ابي عقيل عن ابيه انه بات يجر الجرير فذكر الحديث وموسي ضعيف لكنه يتقوي بمرسل قتادة وذكره بن منده من طريق سعيد بن عثمان البغوي عن جدته بنت عدي ان امها عميرة بنت سهل بن رافع صاحب الصاعين الذي لمزه المنافقون انه خرج بابنته عميرة وبزكاته صاع تمر الحديث وحكي ابو عمر عن بن الكلبي ان اسمه عبد الرحمن بن بيحان من بني اسد وقيل اسمه عبد الله بن عبد الرحمن بن ثعلبة بن بيجان ويحتمل التعدد ولا سيما انه في قصة ذاك نصف صاع وفي قصة ذا صاع ووقع لابي خيثمة نحو ذلك ذكره كعب بن مالك في حديثه الطويل في توبته وهو في صحيح مسلم ابو عقيل لبيد بن ربيعة العامري الشاعر المشهور تقدم وفيه قول بنته تخاطب الوليد بن عقبة اذا هبت رياح ابي عقيل دعونا عند هبتها الوليدا ابو عقيل البلوي حليف الاوس من بني جحجبي ثم من بني عمرو بن عوف ذكره بن اسحاق فيمن شهد بدرا قيل اسمه عبد الله بن عبد الرحمن وقيل عبد الرحمن بن عبد الله ابو عقيل الاحمدي ذكره البغوي وقال مدني ثم ساق من طريق بن ابي حبيبة عن عبد الله بن ابي سفيان عن ابي عقيل الاحمدي انه قال وعدت امراتي حجة ثم بدا لي الغزو فشق عليها فذكرت للنبي صلي الله عليه وسلم وهو في ملا من الناس فقال مرها ان تعتمر في رمضان فانها تعدل حجة وسياتي في النساء في ام عقيل §  <> ابو عقيل المليلي بلامين قيل اسمه لاحق بن مالك تقدم ابو عقيل الجعدي روي عنه اسلم مولي عمر قال شرب رسول الله صلي الله عليه وسلم شربة من سويق واعطاني اخرها ذكره ابو عمر مختصرا وجعله بن الاثير والذي قبله واحدا ولكن مدار حديث المليلي علي المسور بن مخرمة وهذا قد قال ابو عمر انه من اسلم مولي عمر فالله اعلم ابو عقيل جد عدي بن عدي ذكره ابو عمر فقال قيل له صحبة ولا احفظ له خبرا ابو عقيل ياتي في ام عقيل ابو العكر بن ام شريك التي وهبت نفسها للنبي صلي الله عليه وسلم قيل اسمه مسلم بن سلمي كذا اورده ابو عمر مختصرا وقوله بن ام شريك عجيب وانما هو زوج ام شريك وسياتي بيان ذلك واضحا في ترجمة ام شريك وكذا قول من قال انها ام شريك بنت ابي العكر وهو في رواية صحيحة وكانه انقلب علي ابي عمر لكن يلزم منه ان تكون الترجمة لولد ام شريك وليس كذلك بل هو لزوجها وقد اخرج بن سعد عن محمد بن عمر الواقدي عن الوليد بن مسلم عن منير بن عبد الله الدوسي قال اسلم زوج ام شريك وهي غزية بنت جابر الدوسية من الازد وهو ابو العكر فخرج مهاجرا الي رسول الله صلي الله عليه وسلم مع ابي هريرة ومع دوس حين هاجروا قالت ام شريك فجاءني اهل ابي العكر فقالوا لعلك علي دينه قلت اي والله اني لعلي دينه قالوا لا جرم والله لنعذبنك عذابا شديدا فارتحلوا بنا من دارنا ونحن كنا بذي الخلصة وهو من صنعاء فساروا يريدون منزلا وحملوني علي جمل ثقال شر ركابهم واغلظه يطعموني الخبز بالعسل ولا يسوقني قطرة من ماء حتي اذا انتصف النهار وسخنت الشمس ونحن قاءظون نزلوا فضربوا اخبيتهم وتركوني في الشمس حتي ذهب عقلي وسمعي وبصري فعلوا بي ذلك ثلاثة ايام فقالوا لي في اليوم الثالث اتركي ما انت عليه قالت فما دريت ما يقولون الا الكلمة بعد الكلمة فاشير باصبعي الي السماء بالتوحيد قالت فوالله اني لعلي ذلك وقد بلغني الجهد اذ وجدت برد دلو علي صدري فاخذته فشربت منه نفسا واحدا ثم انتزع مني فذهبت انظر فاذا هو معلق بين السماء والارض فلم اقدر عليه تم تدلي الي ثانية فشربت منه نفسا ثم رفع فذهبت انظر فاذا هو معلق بين السماء والارض ثم تدلي الي ثالثة فشربت حتي رويت واهرقت علي راسي ووجهي وثيابي فخرجوا فنظروا فقالوا من اين لك هذا يا عدوة الله قالت فقلت لهم ان عدو الله غيري من خالف دينه فاما قولكم من اين لك هذا فهو من عند الله رزقا رزقنيه الله قالت فانطلقوا سراعا الي قربهم واداويهم فوجدوها موكوءة لم تحل فقالوا نشهد ان ربك هو ربنا وان الذي رزقك ما رزقك في هذا الموضع بعد ان فعلنا بك ما فعلنا هو الذي شرع الاسلام فاسلموا وهاجروا جميعا الي رسول الله صلي الله عليه وسلم فكانوا يعرفون فضلي عليهم وما صنع الله لي وهي التي وهبت نفسها للنبي فعرضت نفسها علي النبي صلي الله عليه وسلم وكانت جميلة وقد اسنت فقالت اني اهب نفسي لك واتصدق بها عليك فقبلها النبي صلي الله عليه وسلم فقالت عاءشة ما في امراة حين تهب نفسها لرجل خير قالت ام شريك فانا تلك فسماني الله مءمنة فقال وامراة مءمنة ان وهبت نفسها للنبي الاية فلما نزلت الاية قالت عاءشة ان الله ليسرع لك في هواك §  <> قلت اذا ثبت هذا فلعل ابا العكر مات او طلقها والذي يغلب علي الظن ان التي وهبت نفسها هي ام شريك اخري كما سياتي في كني النساء ان شاء الله تعالي وقد رويت قصتها في الدلو من وجه اخر سياتي في ترجمتها ابو العلاء الانصاري يقال شهد احدا اخرج الطبراني من طريق الواقدي عن ايوب بن العلاء الانصاري عن ابيه عن جده قال رايت علي رسول الله صلي الله عليه وسلم يوم احد درعين واخرجه من وجه اخر فقال ايوب بن النعمان واخرجه ابو موسي من الوجهين فقال تارة ابو العلا وتارة ابو النعمان ابو العلاء مولي محمد بن عبد الله بن جحش قال خليفة بن خياط وممن صحب النبي صلي الله عليه وسلم من بني اسد بن خزيمة فذكر جماعة ثم قال ومحمد بن عبد الله بن جحش ومولاه ابو العلاء ابو علقمة بن الاعور السلمي ذكره بن اسحاق في المغازي في غزوة تبوك قال حدثني محمد بن طلحة بن يزيد بن ركانة عن عكرمة عن بن عباس قال ما ضرب رسول الله صلي الله عليه وسلم في الخمر الا اخيرا لقد غزا غزوة تبوك فغشي حجرته من الليل ابو علقمة بن الاعور السلمي وهو سكران حتي قطع بعض عري الحجرة فقال ليقم اليه منكم رجل فياخذ بيده حتي يرده الي رحله واستدركه ابو موسي وغيره ابو علكثة بن عبيد الازدي ذكره بن منده مختصرا فقال اخو ابي راشد له ذكر في حديث اخيه وقال ابو نعيم صحفه بن منده وانما هو ابو عبيدة واسمه قيوم فسماه رسول الله صلي الله عليه وسلم عبد القيوم وكناه ابا عبيدة واقر بن الاثير ابا نعيم علي ذلك فشاركه في الوهم والصواب مع بن منده فعبد القيوم مولي ابي راشد لا اخوه وابو علكثة اخوه كما قال بن منده وكان من سروات الازد وزعم عبدان المروزي ان اسمه الحارث ابو عليبة الحضرمي ذكره البغوي في الكني وقد تقدم في الاسماء فان اسمه حرملة ابو علي بن عبد الله بن الحارث بن رحضة بن عامر بن رواحة بن حجر بن معيص بن عامر بن لءي القرشي العامري من مسلمة الفتح واستشهد باليمامة ذكره الزبير بن بكار وتبعه بن عبد البر ابو علي قيس بن عاصم التيمي المنقري وابو علي طلق بن علي الحنفي وابو علي معقل بن يسار المزني تقدموا في الاسماء ابو علي بن البجير ابو البحير ذكره في التجريد وعزاه بقي بن مخلد ابو عمارة البراء بن عازب وابو عمارة خزيمة بن ثابت الانصاريان تقدما في الاسماء ابو عمر بضم العين قدامة بن مظعون تقدم في الاسماء ابو عمر ويقال ابو عمرو بن الحباب بن المنذر ومثله قتادة بن النعمان الانصاريان تقدما §  <> ابو عمر مولي عمر بن الخطاب ذكره الحسن بن سفيان في الصحابة واخرج من طريق بقية عن يحيي بن مسلم عن عكرمة وليس مولي بن عباس حدثني ابو عمر مولي عمر قال قال رسول الله صلي الله عليه وسلم لا يتبعن احدكم بصره لقمة اخيه واخرجه ابو نعيم وتبعه ابو موسي ابو عمر الانصاري ذكره اسحاق بن راهويه في مسنده عن الفضل بن موسي عن بشير بن سلمان عن عمر الانصاري عن ابيه عن النبي صلي الله عليه وسلم قال من صلي قبل الظهر اربعا كن كعدل رقبة من بني اسماعيل واخرجه الطبراني من طريقه وابو نعيم عنه وابو موسي من طريقه واخرجه الطبراني من طريق ابي نعيم الفضل بن دكين عن بشير بن سلمان عن شيخ من الانصار عن ابيه عن امه ولم يسمه ابو عمر بن شييم العبدي المحاربي ذكره بن الكلبي فيمن وفد الي النبي صلي الله عليه وسلم وقال كان من اشراف عبد القيس قال الرشاطي لم يذكره ابو عمر ولا بن فتحون ابو عمرو بفتح اوله بن بديل بن ورقاء الخزاعي ذكره بن الكلبي وقال انه كان من رءساء اهل مصر الذين حاصروا عثمان قلت وقد تقدم ذكر ابيه بديل واخويه عبد الله ونافع ابني بديل ابو عمرو جرير بن عبد الله تقدم ابو عمرو بن حفص بن المغيرة بن عبد الله بن عمر بن مخزوم القرشي المخزومي زوج فاطمة بنت قيس وقيل هو ابو حفص بن عمرو بن المغيرة واختلف في اسمه فقيل احمد وقيل عبد الحميد وقيل اسمه كنيته وامه درة بنت خزاعي الثقفية وكان خرج مع علي الي اليمن في عهد النبي صلي الله عليه وسلم فمات هناك ويقال بل رجع الي ان شهد فتوح الشام ذكر ذلك علي بن رباح عن ناشرة بن سمي سمعت عمر يقول اني اعتذر لكم من عزل خالد بن الوليد فقال ابو عمرو بن حفص عزلت عنا عاملا استعمله رسول الله صلي الله عليه وسلم فذكر القصة اخرجها النساءي وقال البغوي سكن المدينة ثم ساق من طريق محمد بن عبد الرحمن بن ابي ليلي عن الزبير عن عبد الحميد عن ابي عمرو وكانت تحته فاطمة بنت قيس فذكر قصتها مختصرة ابو عمرو سعد بن معاذ سيد الاوس وابو عمرو سفيان بن عبد الله الثقفي وابو عمرو سويد بن مقرن المزني تقدموا ابو عمرو صفوان بن بيضاء الفهري وابو عمرو صفوان بن المعطل تقدما ابو عمرو بن عدي بن الحمراء الخزاعي تقدم ذكر اخيه عبد الله وابو عمرو هذا من مسلمة الفتح وذكر الواقدي من طريق سلمة بن ابي عبد الرحمن بن عوف عن ابيه عن ابي عمرو بن عدي هذا قال رايت سهيل بن عمرو لما جاء نعي النبي صلي الله عليه وسلم قد تقلد السيف ثم خطب خطبة ابي بكر التي خطب بها بالمدينة كانه كان يسمعها ابو عمرو بن مغيث اخرج حديثه النساءي من وجهين عن بن اسحاق قال في احدهما حدثني من لا اتهم عن عطاء بن ابي مروان عن ابيه عن ابي عمرو بن مغيث واسقط الواسطة في الطريق §  <> الاخر ان النبي صلي الله عليه وسلم قال فذكر الحديث في الدعاء اذا اراد دخول القرية وقد روي هذا الحديث جماعة من الثقات وغيرهم عن موسي بن عقبة عن عطاء بن مروان عن ابيه عن كعب الاحبار عن صهيب وهو المحفوظ وروي عن صالح بن كيسان عن ابي مروان عن ابيه عن جده ابو عمرو عبادة بن النعمان الانصاري تقدم في الاسماء ابو عمرو بن كعب بن مسعود الانصاري ذكره بن اسحاق فيمن استشهد ببءر معونة لا يعرف اسمه ابو عمرو هاشم بن عتبة بن ابي وقاص تقدم ابو عمرو الانصاري ذكره يحيي الحماني في مسنده قال حدثنا ابو اسحاق الحميسي عن ثابت عن انس قال قال رسول الله صلي الله عليه وسلم قوموا الي جنة عرضها السماوات والارض فقال رجل بخ بخ فنادي اخا له فقال يا ابا عمرو ربح البيع الجنة ورب الكعبة دون احد قال فالتقوي فاستشهد قلت يحتمل ان يكون المقتول هو سعد بن الربيع والمقول له سعد بن معاذ فان سعد بن الربيع استشهد باحد وله قصة قريبة من هذا مع سعد بن معاذ ابو عمرو الانصاري اخر ذكره الطبراني واورد من طريق جعفر بن محمد الصادق عن ابيه عن محمد بن طلحة بن يزيد بن ركانة عن محمد بن الحنفية قال رايت ابا عمرو الانصاري يوم صفين وكان عقبيا بدريا احديا وهو صاءما يتلوي من العطش وهو يقول لغلام له ترسني فترسه الغلام حتي نزع بسهم نزعا ضعيفا حتي رمي بثلاثة اسهم ثم قال سمعت رسول الله صلي الله عليه وسلم يقول من رمي بسهم في سبيل الله فبلغ او قصر كان ذلك نورا له يوم القيامة فقتل قبل غروب الشمس ووقع في رواية اخري في هذه القصة عن ابي عمرة اخره هاء ابو عمرو الشيباني ذكره الحارث بن ابي اسامة في مسنده واخرج من طريق حسان بن ابراهيم الكرماني عن سعيد بن مسروق عن ابي عمرو الشيباني قال كنا جلوسا مع النبي صلي الله عليه وسلم في سفر فاصاب بعضهم فرخ عصفور فجعل العصفور يقع علي رحالهم فامر النبي صلي الله عليه وسلم ان يردوا عليه فرخه ثم قال ان الله ارحم بعباده من هذا العصفور بفرخه قلت ان كان هذا محفوظا فهو غير سعد بن اياس التابعي المشهور فانه لم يلق النبي صلي الله عليه وسلم واظن ان صحابي هذا الحديث سقط وشيخ الحارث فيه ضعف ابو عمرو النخعي احد من وفد علي النبي صلي الله عليه وسلم من النخع ذكره ابو محمد بن قتيبة في غريب الحديث وذكر له رءيا واستدركه بن الاثير عن الغساني وهذا هو زرارة بن قيس والد عمرو بن زرارة وقد تقدم ذكره وحديثه في الاسماء ابو عمرو غير منسوب ذكره الطبراني وابن منده واخرج الطبراني من طريق بن وهب عن عمرو بن صهبان عن زامل بن عمرو عن ابيه عن جده عن النبي صلي الله عليه وسلم ان النبي صلي الله عليه وسلم اتي العبد يوم الفطر وعن يمينه ابي بن كعب فذكر حديثا وفيه ايها الناس §  <> لا تحتكروا ولا تناجشوا الخ واخرجه بن منده من طريق خالد بن نزار عن ابراهيم بن طهمان عن زامل بنحوه ابو عمرة الانصاري قيل اسمه بشر وقيل بشير قال الاول ابو مسعود والثاني حفيده يحيي بن ثعلبة بن عبد الله بن ابي عمرة في رواية لابن منده وقيل اسمه ثعلبة بن عمرو بن محصن بن عمرو بن عبيد بن عمرو بن مبذول بن مالك بن النجار وقيل ان ثعلبة اخوه وبذلك جزم موسي بن عقبة وقال بن الكلبي اسمه عمرو بن محصن وساق هذا النسب وقال في موضع اخر اسمه بشير بن عمرو وكان زوج بنت عم النبي صلي الله عليه وسلم المقوم بن عبد المطلب واخرج بن منده من طريق يونس بن بكير عن المسعودي عن عبد الله بن عبد الرحمن بن ابي عمرة عن ابيه عن جده انه جاء الي النبي صلي الله عليه وسلم يوم بدر او يوم احد ومعه اخوة له فاعطي النبي صلي الله عليه وسلم الرجل سهما سهما واعطي الفارس سهمين واخرجه ابو داود من طريق ابي عبد الرحمن المقري عن المسعودي فقال عن ابي عمرة عن ابيه عن جده ومن طريق امية بن خالد عن المسعودي عن رجل من ال ابي عمرة عن ابيه عن جده حكاه بن منده وقال مالك في الموطا من رواية عن مالك بن عبد الله بن ابي بكر بن محمد بن عمرو بن حزم عن ابيه عن عبد الرحمن بن عمرو بن عثمان عن ابي عمرة عن زيد بن خالد الجهني وخالفه الاكثر فقالوا بهذا السند عن بن ابي عمرة عن زيد في حديث خير الشهداء وقد رواه بن جريج عن يحيي بن محمد بن عبد الله بن عمرو عن عبد الرحمن ابي عمرة ابو عمرة الانصاري اخر اخرجه ابو احمد الحاكم واخرج هو والمستغفري والطبراني من طريق الدراوردي عن ابي طوالة عن ايوب بن بشر قال اشتكي رجل منا يقال له ابو عمرة فاتاه رسول الله صلي الله عليه وسلم فناداه فقال له اهله هذا رسول الله فقال دعوه لو استطاع لاجابني قال فصرخ النساء فاسكتهن الرجال فقال دعوهن فاذا وجب فلا تبكين باكية قال بن عبد البر ان كان مات في هذا الوقت فهو غير ابي عمرة والد عبد الرحمن ابو عمرة بن سكن الانصاري قال الزبير بن بكار في اخبار المدينة حدثنا محمد بن الحسن عن موسي بن بشير عن يحيي بن عبد الله بن ابي قتادة قال اصيب ابو عمرة بن سكن باحد فامر به رسول الله صلي الله عليه وسلم فقبر فكان اول من دفن في مقبرة بني حرام ابو عمير مسعود بن ربيعة القاري حليف بني زهرة تقدم في الاسماء ابو عميرة الازدي ذكر المستغفري عن يحيي بن بكير انه ذكره فيمن ورد مصر من الصحابة واستدركه ابو موسي ابو عميلة ياتي في القسم الرابع ابو عنبة الخولاني صحابي مشهور بكنيته مختلف في اسمه فقيل عبد الله بن عنبة وقيل عمارة وذكره خليفة والبغوي وابن سعد وغيرهم في الصحابة وقال البغوي سكن الشام وذكره عبد الصمد بن سعيد فيمن نزل حمص من الصحابة وقال احمد بن محمد بن عيسي في رجل حمص ادرك الجاهلية وعاش §  <> الي خلافة عبد الملك وكان ممن اسلم علي يد معاذ والنبي صلي الله عليه وسلم حي وكان اعمي واورد ايضا من طريق ابي الزاهرية عن ابي عنبة وكان من الصحابة فذكر حديثا في قراءة الجمعة يوم الجمعة وكان اعمي وروي عن النبي صلي الله عليه وسلم وعن عمر وغيره روي عنه بكر بن زرعة وابو الزاهرية وشرحبيل بن سعد ولقمان بن عامر واخرون وقد اخرج البغوي وابن ماجة من طريق الجراح بن مليح عن بكر بن زرعة سمعت ابا عنبة الخولاني وكان قد صلي القبلتين مع النبي صلي الله عليه وسلم قال سمعت رسول الله صلي الله عليه وسلم يقول وفي رواية البغوي سمعت ابا عنبة وهو من اصحاب النبي صلي الله عليه وسلم وصلي معه القبلتين كلتيهما وهو ممن اكل الدم في الجاهلية قال سمعت رسول الله صلي الله عليه وسلم يقول لا يزال الله يغرس في هذا الدين غرسا يستعملهم بطاعته واخرجه البغوي من طريق بقية عن بكر بن زرعة عن شريح بن مسروق عن ابي عنبة الخولاني قال ما فتق في الاسلام فتق فسد ولكن الله يغرس في الاسلام غرسا يعملون بطاعته وكان ابو عنبة جاهليا من اصحاب معاذ اسلم واخرج احمد عن شريح بن نعمان عن بقية عن محمد بن زياد حدثني ابو عنبة قال قال رسول الله صلي الله عليه وسلم اذا اراد الله بعبد خيرا عسله قال اي يفتح له عملا صالحا قبل موته ثم يقبض عليه قال شريح له صحبة وقال اهل الشام لا صحبة له وانما هو مددي من امداد اهل اليمن واليرموك وقال بن ابي حاتم عن ابيه ليست له صحبة وذكره ابو زرعة الدمشقي في الطبقة العليا التي تلي الصحابة واخرجه بن عاءذ والبخاري في التاريخ من طريق طليق بن شهر عن ابي عنبة الخولاني قال حضرت عمر بالجابية فذكر قصة وذكره بن سعد في الصحابة الذين نزلوا الشام وذكره خليفة في الصحابة وذكره في الطبقة الثالثة من اهل الشام وقال مات سنة ثمان عشرة وماءة وقول بن عيسي المتقدم اشبه والله اعلم وروي بن المبارك في الزهد من طريق محمد بن زياد ان ابا عنبة كان في مجلس خولان فخرج عبد الله بن عبد الملك هاربا من الطاعون فذكر قصة في انكار ابي عنبة ذلك وقال كانوا اذا نزل الطاعون لم يبرحوا ابو عوسجة الضبي ذكره الحاكم ابو احمد في الكني واخرج هو والبغوي والدارقطني في الافراد من طريق محمد بن اسحاق الصغاني عن مهدي بن حفص عن ابي الاحوص عن سليمان بن قرم عن عوسجة عن ابيه قال سافرت مع النبي صلي الله عليه وسلم فكان يمسح علي الخفين واخرجه البخاري من هذا الوجه ووقع لنا بعلو في فواءد ابي العباس الاصم قال البغوي قال محمد بن اسحاق الصغاني هذا خطا وانما هو سافر مع علي ابو العوجاء ياتي في بن ابي العوجاء في المبهمات ابو عوف سلمة بن سلامة بن وقش الانصاري تقدم ابو عويمر الاسلمي ذكر المستغفري من طريق ابي اويس عن ابي الزناد عن ابي عويمر الاسلمي ان النبي صلي الله عليه وسلم نهي عن ان يشار الي البرق ابو عياش بالشين المعجمة الزرقي الانصاري اسمه زيد بن الصامت ويقال بن النعمان ويقال اسمه عبيد بن معاوية وقيل عبد الرحمن بن معاوية بن الصامت روي عن النبي صلي الله عليه وسلم في صلاة الخوف §  <> اخرج حديثه ابو داود والنساءي بسند جيد من طريق شعبة عن منصور عن مجاهد عنه قال كنا مع رسول الله صلي الله عليه وسلم بعسفان وعلي المشركين خالد بن الوليد وقال بن سعد شهد احدا وما بعدها ويقال انه عاش الي خلافة معاوية ابو عياش وقيل بن عاءش وقيل بن ابي عياش روي عن النبي صلي الله عليه وسلم من قال اذا اصبح لا اله الا الله الحديث من رواية سهيل بن ابي صالح عن ابيه عنه اخرج حديثه ابو داود والنساءي وابن ماجة وفي بعض طرقه عن سهيل بن ابي صالح عن بن ابي عياش ووقع في بعض طرقه عن ابي عياش الزرقي فقيل هو الذي قبله وعلي ذلك جري ابو احمد الحاكم والذي يظهر انه غيره ووقع في الكني لابي بشر الدولابي ابو عياش الزرقي روي عنه زيد بن اسلم حديث من قال اذا اصبح الخ ابو عيسي المغيرة بن شعبة الثقفي الصحابي المشهور تقدم القسم الثاني ابو عاصم عبيد بن عمير الليثي ابو عاءشة عبد الله بن فضالة الليثي ابو عبد الله كثير بن الصلت ابو عبد الرحمن الساءب بن لبابة ابو عبد الملك محمد بن عمرو بن حزم ابو عبد الملك مروان بن الحكم ابو عتيق محمد بن عبد الرحمن بن ابي بكر الصديق ابو عثمان عتبة بن ابي سفيان تقدموا كلهم في الاسماء ابو عثمان بن عبد الرحمن بن عوف الزهري امه بنت ابي الحيسر وهي التي تزوجها عبد الرحمن بن عوف اول ما هاجر واخي النبي صلي الله عليه وسلم بينه وبين سعد بن الربيع فلما تزوجها قال له اولم ولو بشاة وخبره بذلك في الصحيح فذكر الزبير بن بكار في اولاد عبد الرحمن منها ابو عثمان وكانه مات صغيرا ولم يعقب ابو عمير بن ابي طلحة زيد بن سهل الانصاري صاحب القصة التي فيها يا ابا عمير ما فعل النغير وهي في الصحيحين من طريق ابي التياح عن انس قيل اسمه حفص ومات في حياة النبي صلي الله عليه وسلم ففي صحيح مسلم من طريق ثابت عن انس ان ابنا لابي طلحة مات فذكر قصة موته وانها قالت لابي طلحة هو اسكن ما كان وباتت معه فبلغ ذلك النبي صلي الله عليه وسلم فدعا لهما بالبركة فاتت بعبد الله بن ابي طلحة وقد مضي ذكر ابي عمير في الحاء المهملة §  <> القسم الثالث ابو العالية الرياحي بكسر الراء بعدها تحتانية مثناة خفيفة مولاهم اسمه رفيع بفاء ثم مهملة مصغرا بن مهران ادرك الجاهلية ويقال انه قدم في خلافة ابي بكر ودخل عليه فذكر البخاري في تاريخه من طريق مسلم بن قتيبة عن ابي خلدة قال سالت ابا العالية هل رايت النبي صلي الله عليه وسلم قال اسلمت في عامين من بعد موته واخرج الحاكم من طريق علي بن نصر الجهني عن ابي خلدة قال سالت ابا العالية ادركت النبي صلي الله عليه وسلم قال لا جءت بعده بسنتين او ثلاثة ورايت في كتاب اوهام ابي نعيم في كتابه في الصحابة للحافظ عبد الغني المقدسي ان ابا نعيم ذكر ابا العالية الرياحي في الصحابة وخلط في ترجمته شيءا من ترجمة ابي العالية البراء وقد ارسل ابو العالية عن كثير من الصحابة منهم بن مسعود وابو ذر وحذيفة وعلي وروي عن ابي موسي وابي ايوب وثوبان ورافع بن خديج وابي هريرة وابي سعيد وغيرهم روي عنه خالد الحذاء وداود بن ابي هند وابن سيرين والربيع بن انس وبكر بن عبد الله المزني وقتادة وثابت وحميد بن هلال ومنصور بن زاذان واخرون ويقال انه دخل علي ابي بكر وصلي خلف عمر قال بن ابي داود ليس احد بعد الصحابة اعلم بالقران من ابي العالية وبعده سعيد بن جبير وقال النضر بن شميل عن شعبة عن عاصم قلت لابي العالية من اكبر من رايت قال ابو ايوب وقال العجلي تابعي ثقة من كبار التابعين قال ابو خلدة مات سنة تسعين وقيل سنة ثلاث وتسعين وقال المداءني سنة ست وتسعين وقال ابو عمر الضرير مات سنة ثمان وتسعين وبه جزم بن حبان ابو عامر بن عمرو بن الحارث بن غيمان بفتح الغين وسكون التحتانية المثناة الاصبحي ذكره الذهبي في التجريد وقال لم ار من ذكره في الصحابة وقد كان في زمن النبي صلي الله عليه وسلم لابنه مالك رواية عن عثمان وغيره ابو عاءشة مسروق بن الاجدع الهمداني الفقيه الكوفي تقدم في الاسماء ابو عبد الله الصنابحي عبد الرحمن بن عسيلة تقدم في الاسماء ابو عبد الله الجدلي اسمه عبد بن عبد ذكره بن الكلبي ابو عبد الله قيس بن ابي حازم الاحمسي ابو عبد الله بن ميمون الازدي تقدما في الاسماء ابو عبد الله الاشعري غزا في عهد ابي بكر وعمر وروي عن خالد بن الوليد وامراء الاجناد ومعاذ بن جبل ويزيد بن ابي سفيان وعمرو بن العاص وعن شرحبيل بن حسنة وابي الدرداء روي عنه ابو صالح الاشعري واسماعيل بن عبيد الله بن ابي المهاجر وزيد بن واقد ويزيد بن ابي مريم وذكره بن سميع في الطبقة الاولي وقال ابو زرعة الدمشقي لا اعرف اسمه ولم اجد احدا سماه وذكره بن حبان في ثقات التابعين ابو عبد الله القيسي له ادراك وغزا في خلافة عمر مع عتبة بن غزوان اصطخر ففتحوها §  <> ثم نفلوا فكتب عمر الي عتبة ان يجعله في سبعين من العطاء وعياله في عشرة ذكره هشام بن عمار في فواءده رواية محمد بن خريم عن الهيثم بن عمران بهذا وهو جده الاعلي ابو عبد الرحمن حجر بن الادبر تقدم في الاسماء ابو عبد الرحمن غير منسوب سمع ابو بكر قوله روي عنه عمرو بن دينار ذكره البخاري في الكني وتبعه ابو احمد الحاكم ولا يعرف اسمه ابو عثمان الاصبحي اعتمر في الجاهلية وروي عنه ابو قبيل المعافري ذكره بن منده وابن يونس ابو عثمان الصنعاني اسمه شراحيل بن مرثد قاتل اهل الردة في زمن ابي بكر تقدم ابو عثمان النهدي عبد الرحمن بن معقل تقدم في الاسماء ابو عذبة له ادراك ونزل حمص في خلافة عمر فاخرج يعقوب بن سفيان عن ابي اليمان عن حريز بن عثمان عن عبد الرحمن بن ميسرة عن ابي عذبة الحمصي قال قدمت علي عمر رابع اربعة من الشام ونحن حجاج فبينا نحن عنده فذكر قصة لاهل العراق فقال عمر اللهم عجل لهم الغلام الثقفي لا يقبل من محسنهم ولا يتجاوز عن مسيءهم وذكره بن سعد في تابعي اهل الشام بهذا الخبر ابو عذرة بضم اوله وسكون المعجمة ذكره بن ابي خيثمة في الصحابة وتبعه مسلم في الكني وعد في الاوهام نعم له ادراك ولا صحبة له قاله البخاري والدولابي والحاكم ابو احمد روي عن عاءشة اخرج حديثه ابو داود والترمذي وابن ماجة من رواية عبد الله بن شداد الواسطي الاعرج عن ابي عذرة وكان قد ادرك النبي صلي الله عليه وسلم عن عاءشة فذكر حديثا في دخول الحمام قال ابو زرعة لا اعرف احدا سماه وذكره بن حبان في ثقات التابعين وقال يقال له صحبة ابو العريان الهيثم بن الاسود النخعي تقدم في الاسماء ابو عطية الوادعي غزا في عهد عمر ثم كان من اصحاب بن مسعود واختلف في اسمه فقيل مالك بن عامر او بن ابي عامر وقيل مالك بن حمزة او بن ابي حمزة وقيل عمرو بن جندب او بن ابي جندب وقيل هما اثنان وجاء عنه انه قال جاءنا كتاب عمر بن الخطاب وروي عن بن مسعود وابي موسي وغيرهما روي عنه ابو اسحاق السبيعي وعمارة بن عمير ومحمد بن سيرين وخيثمة بن عبد الرحمن والاعمش واخرون وشهد مع علي مشاهده وقال ابو داود في رواية اخري مات في خلافة عبد الملك وقد خلط ابو عمر بترجمة ابي عطية الذي روي عنه خالد بن معدان والصواب التفرقة بينهما ابو عكرمة صعصعة بن صوحان العبدي تقدم في الاسماء ابو العلاء قبيصة بن جابر الاسدي تقدم ابو عمرو الاسود بن يزيد النخعي وعبد الله بن قيس السلماني وسعد بن اياس الشيباني تقدموا في الاسماء ابو عمرو الحميري ثم السيباني بالمهملة ثم الموحدة والد ابي زرعة ذكره يحيي بن عمرو §  <> الفلسطيني يقال اسمه زرعة ذكره بن جوصا عن بن سميع في الطبقة الاولي بعد الصحابة ممن ادرك الجاهلية وسمع من عمر وابي الدرداء وعقبة بن عامر روي عنه ابنه وعمرو بن عبد الملك الفلسطيني وقال ابو زرعة في الطبقة الاولي من التابعين ابو عمرو واسمه زرعة سمع عمر ونزل الرملة وذكره يعقوب بن سفيان في ثقات التابعين من اهل مصر ابو عميلة ادرك النبي صلي الله عليه وسلم ونقلت عنه قصة في فتح خيبر ذكرها الواقدي في المغازي من طريق عيسي بن عميلة عن ابيه عن جده قال اني بوادي بني جمح ما شعرت الا ببني سعد يحملون الظعن هرابا فلقيت راسهم وبر بن عليم فسالته فقال دهمتنا جموع محمد بما لا طاقة لنا به قبل ان ناخذ الاهبة وقد اوقع بقريظة وهو ساءر الي هءلاء بخيبر قلت فرواية ولده عميلة عنه في الاسلام تدل علي انه اسلم لكن لم ار من صرح بانه راي النبي صلي الله عليه وسلم بعد ان اسلم ابو العنبس حجر بن العنبس الكوفي تقدم في الاسماء ابو العيال بن ابي عتبة الهذلي من بني ضباعة بن سعد بن هذيل وهو اخو عبد بن وجزة الهذلي لامه ذكره بن عساكر فقال مخضرم ادرك الجاهلية واسلم وغزا في خلافة عمر فدخل مصر ثم عمر الي خلافة معاوية وغزا مع يزيد بن معاوية الروم وكتب الي معاوية قصيدة قالها في تلك الواقعة منها ابلغ معاوية بن صخر انه يهوي اليه الفرند الاعجل اني لقينا بعدكم في غزونا من جانب الابراج بوما ينسل امرا تضيق به الصدور ودونه مهج النفوس وليس عنه معدل وحكي في ضبط والده خلافا هل بعد النون موحدة او مثناة القسم الرابع ابو عامر الانصاري روي عنه فرات البهراني انه سال عن اهل النار واورده بن منده مختصرا وهو وهم وانما هو ابو عامر الاشعري وقد تقدم الحديث في ترجمة فرات من القسم الثالث ابو عامر الثقفي روي عنه محمد بن قيس ذكره بن منده واخرج من طريق الوليد بن مسلم عن ابي جابر عن محمد بن قيس عمن حدثه حدثني رجل من اصحاب رسول الله صلي الله عليه وسلم انه سمع النبي صلي الله عليه وسلم يقول الخضرة في النوم الجنة والسفينة نجاة والمراة خير والحمل حزن واللبن الفطرة واكره الغل والقيد ثبات في الدين قال بن منده كذا رواه دحيم عن الوليد وقال غيره عن رجل يكني ابا عامر انتهي وقد تقدم في ترجمة ابي عامر الثقفي في القسم الاول كذلك لكن ذلك حديث اخر وقد استدركه ابو موسي علي بن منده والحق ان ابا عامر الثقفي واحد وحديث الخضرة في المنام انما هو عن رجل منهم ابو عامر الانصاري والد حنظلة غسيل الملاءكة ذكره ابو موسي متعلقا بما ذكر الدارقطني في المءتلف باسناد كوفي ضعيف الي الاجلح عن الشعبي عن بن عباس قال بعثت الاوس ابا قيس بن الاسلت وابا عامر والد غسيل الملاءكة وبعثت الخزرج اسعد بن زرارة ومعاذ بن عفراء فدخلوا المسجد فاذا رسول الله صلي الله عليه وسلم فكانوا اول من لقي رسول الله صلي الله عليه وسلم من §  <> الانصار وهذه رواية شاذة في ان ابا عامر كان مع الذين قدموا من الانصاري في القدمة الاولي وعلي تقدير ان يكون الراوي حفظ منهم فليس في حكايته ما يدل علي انه اسلم ولم يعده احد فيمن بايع النبي صلي الله عليه وسلم وعلي تقدير ان يوجد ذلك فكانه ارتد فان مباينته للمسلمين ومظاهرته للمشركين عليهم وحضوره معهم بعض الحروب حتي اراد ابنه حنظلة ان يثور اليه ثم قيامه في كيده الاسلام مشهور في السير والمغازي وهو الذي بني اهل النفاق مسجدا الضرار لاجله فنزلت فيه وارصادا لمن حارب الله ورسوله ابو عاءشة غير منسوب ذكره ابو نعيم في الصحابة وتبعه ابو موسي في الذيل واخرجا من طريق الحسن بن سفيان قال حدثنا اسحاق بن بهلول بن حسان حدثنا ابو داود الحفري حدثنا بدر بن عثمان عن عبد الله بن مروان قال حدثني ابو عاءشة وكان رجل صدق قال خرج علينا رسول الله صلي الله عليه وسلم ذات غداة فقال رايت قبل الغداة كانما اعطيت المقاليد والموازين الحديث وفيه فوضعت في احدي الكفتين ووضعت امتي في الاخري فوزنت بهم فرجحتهم وهكذا اخرجه يعقوب بن شيبة في مسنده للعلل عن اسحاق بن بهلول سواء اورده عنه بن فتحون في كتابه اوهام بن عبد البر ولم ينقل كلام يعقوب ولا الموضع الذي اخرجه فيه والاخلق ان يكون في مسند بن عمر وهذا وقع فيه وهم صعب فانه سقط منه الصحابي فصار ظاهره ان الصحبة لابي عاءشة وليس كذلك فقد ذكره البخاري في الكني المفردة فقال قال ابو داود الحفري بهذا السند سواء وبعد قوله رجل صدق عن بن عمر قال خرج علينا رسول الله صلي الله عليه وسلم فذكر الحديث بعينه وتبعه ابو احمد الحاكم في الكني فقال ابو عاءشة وكان رجل صدق روي عنه عبد الله بن عمر روي عنه عبد الله بن مروان وكذا قال بن حبان في ثقات التابعين في اخره ابو عاءشة روي عن بن عمر روي عنه عبد الله بن مروان وقد مشي هذا الوهم علي بن الاثير وعلي الذهبي وعلي من تبعهما ابو عاءشة اخر ذكره البغوي وابن ابي عاصم في الوحدان وجوز ابو موسي ان يكون الذي قبله وتبع في ذلك ابا نعيم فانه اورد حديثه في ترجمة الذي قبله وهو غيره واخرج حديثه من طريق يحيي بن سعد عن خالد بن معدان عنه ان اليهود اتوا النبي صلي الله عليه وسلم فقالوا حدثنا عن تفسير ابواب من التوراة لا يعلمها الا نبي قال وما هن فذكر الحديث وزاد البغوي فسالوه عن ملك الموت فقال هو بن ادم الذي قتل اخاه وقد غاير بينهما ابو احمد الحاكم فقال في هذا ابو عاءشة مولي سعيد بن العاص روي عن ابي موسي الاشعري وحذيفة روي عنه مكحول وخالد بن معدان وهو تابعي قلت وروايته عن حذيفة وابي موسي في سنن ابي داود في تكبيرات العيد ابو عبد الله الخطمي له حديث غريب كذا في التجريد وهذا هو ابو عبد الله السعدي الذي ذكره بعده سواء فقال روي حديثه مليح بن عبد الله الخ كرره وهما والذي في اصله ابو عبد الله الخطمي حجازي من الانصار روي حديثه بن فديك عن عمر بن محمد عن مليح بن عبد الله الخ ولم يزد علي ذلك فاصاب ولما كان الذهبي راه في موضع السعدي بدل الخطمي ظنه اخر ابو عبد الله غير منسوب صحب النبي صلي الله عليه وسلم روي عن النبي صلي §  <> الله عليه وسلم في فضل المشي في سبيل الله وعنه ابو مصبح المقراءي وقد تقدم في ترجمة مالك بن عبد الله الخثعمي انه جابر بن عبد الله الانصاري ولم ينبه بن الاثير علي ذلك ولا الذهبي ابو عبد الرحمن الاشعري وقيل الاشجعي روي عن النبي صلي الله عليه وسلم الطهور شطر الايمان اخرجه بن منده وابو نعيم وقال بن منده الصواب عن ابي مالك الاشعري كذا اختصره بن الاثير وقوله وقيل الاشجعي ليس عند بن منده ولا ابي نعيم وانما ذكر بن منده ان يحيي بن ميمون روي عن يحيي بن ابي كثير عن زيد بن سلام عن ابي سلام عن ابي عبد الرحمن الاشعري فذكر الحديث قال ورواه ابان العطار عن يحيي فقال عن ابي مالك وهو الصواب وتبعه ابو نعيم قلت ورواية ابان التي صوبها بن منده اخرجها مسلم ابو عبد الرحمن الصنابحي ذكره البغوي في الصحابة وقال سكن المدينة ثم ساق له من طريق الصلت بن بهرام عن الحارث بن وهب عن ابي عبد الرحمن الصنابحي رفعه لا تزال امتي في مسكة ما لم يعملوا بثلاث ما لم يءخروا المغرب مضاهاة لليهود الحديث وهذا هو الصنابح بن الاعسر ان ثبت انه يكني ابا عبد الرحمن والا فهو وهم وقد قال بن الاثير عبد الرحمن الصنابحي روي عنه الحارث بن وهب ويقال انه الذي روي عنه عطاء بن يسار في النهي عن تاخير صلاة المغرب حتي تشتبك النجوم وابو عبد الله الصنابحي اخر لم يدرك النبي صلي الله عليه وسلم كذا قال والذي روي عنه الحارث بن وهب هو الصنابح بن الاعسر والحديث المذكور في صلاة المغرب حديثه واما قوله ان ابا عبد الله الصنابحي اخر لم يدرك النبي صلي الله عليه وسلم فليس كما قال لما بينته في ترجمة عبد الله الصنابحي في العبادلة وهو عبد الله اسم لا كنية والذي يتحصل من كلام اهل العلم بغير وهم ان الصنابحة ثلاثة عبد الله الذي روي عنه عطاء بن يسار وهو مختلف في صحبته ومن قال انه ابو عبد الله فقد وهم ولعله الذي يكني عبد الرحمن والصنابح اسم لا نسب بن الاعسر وهو صحابي بلا خلاف ومن قال فيه الصنابحي فقد وهم وعبد الرحمن بن عسيلة الصنابحي يكني ابا عبد الله وهو مخضرم ليست له صحبة بل قدم المدينة عقب موت النبي صلي الله عليه وسلم فصلي خلف ابي بكر الصديق ومن سماه عبد الله فقد وهم ابو عبيد ذكره البغوي في الصحابة وقال لا ادري له صحبة ام لا ثم اخرج من طريق بجير بن سعد عن خالد بن معدان عن ابي عبيد رفعه ان قلب بن ادم مثل العصفور يتقلب في اليوم سبع مرات انتهي والصواب في هذا السند ابو عبيدة بزيادة هاء وهو بن الجراح كذا اخرجه بن ابي الدنيا والحاكم والبيهقي في الشعب من هذا الوجه وهو منقطع السند لان خالد بن معدان لم يلحق ابا عبيدة بن الجراح ابو عثمان بن سنة بفتح المهملة وتشديد النون الخزاعي الكعبي ارسل حديثا فذكره بعضهم في الصحابة وقال بن ابي عاصم في كتاب الجهاد بعد ان اخرج من طريقة حديثا في قصة الطاءف ارسله يحسب كثير من الناس الخ ان ابا عثمان بن سنة له صحبة وليس كذلك وهو جليل من التابعين انتهي واورده بن منده من طريق الربيع بن سليمان عن بن وهب عن يونس عن الزهري عنه في ليلة §  <> الجن وقد رواه حرملة عن بن وهب فزاد بعد ابي عثمان عن بن مسعود اخرجه ابو نعيم وصوبه قال وكذلك رواه الليث عن يونس قلت وكذا هو عند النساءي عن ابي الطاهر بن الحسن عن بن وهب وروي ابو عثمان ايضا عن علي وابن مسعود وغيرهما روي عنه الزهري وقال ابو زرعة لا اعرف اسمه وقال يونس عن الزهري حدثني ابو عثمان بن سنة وكان من اهل دمشق فلحق بعلي فيمن خرج اليه من اهل الشام وكان يحضر مجلسه وحديثه وقع في نسخة حرملة بن يحيي عن بن وهب وعن براء بن المقري في حديث بن مسعود عثمان بن سنة الخزاعي وكان من اهل الشام وقال بن المقري كان في الاصل عثمان فاصلح ابا عثمان وهو الصواب ابو العشراء الدارمي ذكره بن الاثير قال وذكره بعضهم في الصحابة ولا يصح والصحبة لابيه قلت حديثه في السنن من طريق حماد بن سلمة عن ابي العشراء بن ابيه واختلف في اسمه واسم ابيه وساوضحه في المبهمات ولم يسم بن الاثير من ذكره في الصحابة وهو بن شاهين ذكره في مالك بن قهطم ولم يقف له علي رواية الا عن ابيه وقد افرد تمام الرازي حديثه بالتصنيف وجميع ما ذكره غراءب اكثرها مختلف الا الحديث الذي في السنن واخر في المسند ابو عصيمة الانصاري ذكره ابو معشر فيمن شهد بدرا وتعقبه ابو عمر فقال هذا تصحيف وانما هو ابو حميضة كما تقدم في الحاء اما بالمهملة والضاد المعجمة مع التصغير واما بالمعجمة والصاد المهملة بلا تصغير ابو عقيل بن عبد الله بن ثعلبة بن بيحان البلوي من حلفاء الاوس شهد بدرا ذكره المستغفري كذا ذكره الذهبي وكان ذكره قبل ذلك ابو عقيل البلوي اسمه عبد الرحمن بن عبد الله حليف بني جحجبي شهد بدرا فوهم في جعله اثنين فان بني جحجبي من الاوس ولم يذكر بن الاثير غير واحد فقال ابو عقيل واسمه عبد الرحمن بن عبد الله البلوي ثم الاوسي حليف بني جحجبي بن ثعلبة بن عمرو بن عوف قلت وعمرو بن عوف هو بن مالك بن الاوس ابو العلاء العامري ذكره الباوردي في الصحابة واورد من طريق الاسود بن شيبان عن ابي بكر بن سماعه عن ابي العلاء قال وفدت علي النبي صلي الله عليه وسلم في وفد بني عامر فقالوا يا رسول الله انت سيدنا وذو الطول علينا فقال مه مه قولوا بقولكم ولا يستجرءنكم الشيطان فانما السيد الله قال بن منده كذا رواه الاسود وخالفه غيره وقال ابو نعيم الصواب عن ابي العلاء عن ابيه وابو العلاء هو يزيد بن عبد الله بن الشخير وابوه هو الصحابي وهو الوافد وقد رواه قتادة عن غيلان بن جرير عن ابي العلاء عن ابيه ورواه ابو نضرة عن مطرف بن عبد الله بن الشخير عن ابيه والحديث حديثه قلت وكذا اخرجه ابو داود من رواية ابي سلمة شعيب بن مهدي عن ابي نضرة عن مطرف قال قال ابي انطلقت الي النبي صلي الله عليه وسلم ابو عليط الجمحي بمهملتين والصواب ابو غليظ بمعجمتين ياتي ذكره في المعجمة ابو عمرو بن حماس بكسر المهملة والتخفيف واخره مهملة تابعي معروف ارسل حديثا §  <> فذكره بن منده في الصحابة وقال عداده في اهل الحجاز وله ذكر في الصحابة واخرج من طريق بن ابي ذءب عن الحارث بن الحكم عن ابي عمرو بن حماس عن النبي صلي الله عليه وسلم ليس للنساء سواء الطريق وقد تقدم ذكر حماس فيمن ولد علي عهد النبي صلي الله عليه وسلم وله قصة مع عمر قال خليفة مات ابو عمرو بن حماس سنة تسع وثلاثين وماءة وقال الواقدي لم اسمع له باسم ابو عيسي الانصاري الحارثي مدني شهد بدرا ذكره ابو عمر تبعا لابي احمد الحاكم وابو احمد نقل عن البخاري انه قال قال بن ابي ذءب عن صالح مولي التوامة ان عثمان عاد ابا عيسي وكان بدريا ومات في خلافة عثمان انتهي وهذا خطا نشا عن تصحيف والذي في كتاب البخاري ابو عبس بفتح العين وسكون الموحدة بعدها سين وهو بن جبر وقد تقدمت ترجمته في القسم الاول وهو معروف في البدريين وقد ذكر ابو عمر في ترجمته انه مات سنة اربع وثلاثين في خلافة عثمان وصلي عليه عثمان حرف الغين المعجمة القسم الاول ابو الغادية الجهني اسمه يسار بتحتانية ومهملة خفيفة بن سبع بفتح المهملة وضم الموحدة قال خليفة سكن الشام وروي انه سمع النبي صلي الله عليه وسلم يقول ان دماءكم واموالكم حرام وقال الدوري عن بن معين ابو الغادية الجهني قاتل عمار له صحبة وفرق بينه وبين ابي الغادية المزني فقال في المزني روي عنه عبد الملك بن عمير وقال البغوي ابو غادية الجهني يقال اسمه يسار سكن الشام وقال البخاري الجهني له صحبة وزاد سمع من النبي صلي الله عليه وسلم وتبعه ابو حاتم وقال روي عنه كلثوم بن جبر وقال بن سميع يقال له صحبة وحدث عن عثمان وقال الحاكم ابو احمد كما قال البخاري وزاد وهو قاتل عمار بن ياسر وقال مسلم في الكني ابو الغادية يسار بن سبع قاتل عمار له صحبة وقال البخاري وابو زرعة الدمشقي جميعا عن دحيم اسم ابي الغادية الجهني يسار بن سبع ونسبوه كلهم جهنيا وكذا الدارقطني والعسكري وابن ماكولا وقال يعقوب بن شيبة في مسند عمار حدثنا مسلم بن ابراهيم حدثنا ربيعة بن كلثوم بن جبر حدثنا ابي قال كنت بواسط القصب عند عبد الاعلي بن عبد الله بن عامر فقال الاذن هذا ابو الغادية الجهني فقال ادخلوه فدخل رجل عليه مقطعات فاذا رجل ضرب من الرجال كانه ليس من رجال هذه الامة فلما ان قعد قال بايعت رسول الله صلي الله عليه وسلم قلت بيمينك قال نعم قال وخطبنا يوم العقبة فقال يا ايها الناس ان دماءكم واموالكم عليكم حرام الحديث وقال في خبره وكنا نعد عمار بن ياسر فينا حنانا فوالله اني لفي مسجد قباء اذ هو يقول ان معقلا فعل كذا يعني عثمان §  <> قال فوالله لو وجدت عليه اعوانا وطءته حتي اقتله فلما ان كان يوم صفين اقبل يمشي اول الكتيبة راجلا حتي اذا كان بين الصفين طعن الرجل في ركبته بالرمح وعثر فانكفا المغفر عنه فضربه فاذا راسه قال فكانوا يتعجبون منه انه سمع ان دماءكم واموالكم حرام ثم يقتل عمارا واخرجه احمد وابن سعد عن عفان زاد احمد عن عبد الصمد بن عبد الوارث كلاهما عن ربيعة وفي رواية عفان سمعت عمارا يقع في عثمان بالمدينة فتوعدته بالقتل فقلت لءن امكنني الله منك لافعلن فلما كان يوم صفين جعل يحمل علي الناس فقيل هذا عمار فطعنته في ركبته فوقع فقتلته فاخبر عمرو بن العاص فقال سمعت رسول الله صلي الله عليه وسلم يقول قاتل عمار وسالبه في النار فقيل لعمرو فكيف تقاتله فقال انما قال قاتله وسالبه واخرج بن ابي الدنيا عن محمد بن ابي معشر عن ابيه قال بينما الحجاج جالس اذ اقبل رجل يقارب الخطا فلما راه الحجاج قال مرحبا بابي غادية واجلسه علي سريره وقال انت قتلت بن سمية قال نعم قال كيف صنعت قال فعلت كذا وكذا حتي قتلته فقال الحجاج يا اهل الشام من سره ان ينظر الي رجل طويل الباع يوم القيامة فلينظر الي هذا ثم ساره ابو الغادية فساله شيءا فابي عليه فقال ابو الغادية نوطء لهم الدنيا ثم يسالهم منها فلا يعطوننا ويزعم اني طويل الباع يوم القيامة اجل والله ان من ضرسه مثل احد وفخذه مثل ورقان ومجلسه ما بين المدينة والربذة لعظيم الباع يوم القيامة قلت وهذا منقطع وابو معشر فيه تشيع مع ضعفه وفي هذه الزيادة تشنيع صعب والظن بالصحابة في تلك الحروب انهم كانوا فيها متاولين وللمجتهد المخطء اجر واذا ثبت هذا في حق احاد الناس فثبوته للصحابة بالطريق الاولي ابو الغادية المزني فرق غير واحد بينه وبين الجهني وخالفهم بن سعد فقال فيمن نزل البصرة من الصحابة ابو الغادية المزني قاتل عمار وقال مسلم في الكني ابو الغادية المزني يسار بن سبع قاتل عمار له صحبة وقال النساءي مثله الا قوله وله صحبة وقال بن حبان في الطبقة الثالثة من الثقات ابو الغادية المزني يسار بن سبع يروي المراسيل قلت وتسميته بذلك غلط انما هو اسمه الجهني واخرج تمام في فواءده من طريق مساور بن شهاب بن مسرور بن سعد بن ابي الغادية حدثني ابي عن ابيه عن جده سعد عن ابيه قال كان النبي صلي الله عليه وسلم في جماعة من الصحابة فمرت به جنازة فسال عنها فقالوا من مزينة فما جلس مليا حتي مرت به الثانية فقال ممن قالوا من مزينة فما جلس مليا حتي مرت به الثالثة فقال ممن قالوا من مزينة فقال سيري مزينة لا يدرك الدجال منك احد الحديث قال بن عساكر بعد تخريجه غريب لم اكتبه الا من هذا الوجه والراجح ان المزني غير الجهني لكن من قال ان المزني هو قاتل عمار فقد وهم ابو الغادية غير مسمي ولا منسوب ذكره بن السكن وقال بن عبد البر في ترجمة ام الغادية جاء ذكره من وجه مجهول ولم يترجمه ابو عمر في الكني فاستدركه بن فتحون قلت والحديث المشار اليه اخرجه ابو نعيم ايضا من طريق محمد بن عبد الرحمن الطفاوي عن العاص بن عمرو الطفاوي قال خرج ابو الغادية وحبيب بن الحارث وام الغادية مهاجرين الي رسول الله صلي الله عليه وسلم فاسلموا فقالت المراة يا رسول الله اوصني قال اياك وما يسوء الاذن وسياتي له طريق اخري في كني النساء واورد ابو موسي هذا الحديث في ترجمة المزني واورد ابو موسي ايضا في ترجمة المزني حديث سيكون §  <> بعدي فتن شداد خير الناس فيها مسلموا اهل البوادي الذين لا يتندون من دماء الناس واموالهم شيءا وهذا اورده الطبراني في مسند يسار بن سبع وجزم بن الاثير بان هذا الحديث للجهني لانه في معني الحديث الذي اوردناه من طريق كلثوم بن جبر عنه وفي الجزم بذلك نظر ابو غاضرة الفقيمي اسمه عروة تقدم في الاسماء ابو غزوان له ذكر في حديث عبد الله بن عمرو بن العاص اخرجه الطبراني من طريق بن وهب حدثني حي بن عبد الرحمن عن ابي عبد الرحمن الحلبي عن عبد الله بن عمرو قال جاء الي النبي صلي الله عليه وسلم سبعة رجال فاخذ كل رجل من اصحابه رجلا واخذ النبي صلي الله عليه وسلم رجلا فقال له رسول الله صلي الله عليه وسلم ما اسمك قال ابو غزوان قال فحلب له سبع شياه فشرب لبنها كله فقال له النبي صلي الله عليه وسلم هل لك يا ابا غزوان ان تسلم قال نعم فاسلم فمسح النبي صلي الله عليه وسلم صدره فلما اصبح حلب له شاة واحدة فلم يتم لبنها فقال مالك يا ابا غزوان قال والذي بعثك بالحق لقد رويت قال انك امرء لك سبع امعاء وليس لك اليوم الا معي واحد ابو غزوان اخر ذكر بن سعد انه سمع بعضهم يكني عتبة بن غزوان ابا غزوان والمعروف ان كنيته ابو عبد الله ابو غزية الانصاري روي عن رسول صلي الله عليه وسلم في النهي عن الجمع بين اسمه وكنيته من رواية يزيد بن ربيعة عن غزية بن ابي غزية الانصاري عن ابيه ذكره ابو عمر مختصرا وساق بن منده الحديث من طريق ابي حاتم الرازي عن ابي توبة عن ربيعة وله حديث اخر اورده مطين من طريق جابر الجعفي عن يزيد بن مرة عن ابي غزية الانصاري قال كان رجل يقرا فجاءت مثل الظلة فذكر ذلك للنبي صلي الله عليه وسلم فقال اما انك لو ثبت لرايت منها عجبا اخرجه ابو نعيم ويحتمل ان يكون غير الذي قبله ابو غسيل الاعمي ويقال له ابو بصير ذكر الثعلبي في التفسير من طريق حميد الطويل قال ابصر النبي صلي الله عليه وسلم اعمي يتوضا فقال له بطن القدم فجعل يغسل تحت قدمه حتي سمي ابا غسيل واخرج الخطيب في التاريخ من طريق ابي معاوية عن يحيي بن سعيد الانصاري عن محمد بن محمود بن محمد بن سلمة ان رسول الله صلي الله عليه وسلم مر علي رجل مصاب البصر يتوضا فقال باطن رجلك باطن رجلك يا ابا بصير فسمي ابا بصير وذكر ابو موسي في الذيل ان بن منده ذكره في تاريخه محمد بن محمود بن محمد بن سلمة واخرج ابو موسي من طريقين عن يحيي بن سعيد قال راي رسول الله صلي الله عليه وسلم اعمي يتوضا فقال اغسل باطن قدميك فجعل يغسل باطن قدميه ولم يذكر بقية الحديث ابو غطيف تقدم في عطيف في الاسماء واختلف فيه ابو غليظ بمعجمة بن امية بن خلف الجمحي وقيل هو بن مسعود بن امية بن خلف واختلف في اسم ابي غليظ فقيل عنبسة وقيل نشيط وهو الجد الاعلي لعبد الله بن معاوية الجمحي شيخ §  <> الترمذي واخرج الخطيب في ترجمة اسماعيل بن اسحاق الرقي من تاريخه عن ابي العباس بن نجيح وهو عندي في فواءد بن نجيح بعلو قال حدثنا اسماعيل حدثنا عبد الله بن معاوية سمعت ابي يحدث عن ابيه عن جده عن ابي غليظ بن امية بن خلف قال راني رسول الله صلي الله عليه وسلم وعلي يدي صرد فقال ان هذا اول طير صام يوم عاشوراء قال اسماعيل وكان عبد الله بن معاوية من ولد ابي غليظ ذكره بالمعجمتين في هذه الرواية واخرجه من وجه اخر عن اسماعيل بن اسحاق فقال ابو عليط بمهملتين ثم اخرجه من وجه ثالث عن عبد الله بن معاوية قال سمعت ابي انه سمع اباه يحدث عن جده عن ابي امية عنبسة بن امية بن خلف والاول هو المعتمد وقد اخرجه بن قانع فقال في كتابه عن عبد بن معاوية فذكر كالاول لكنه اورده في ترجمة سلمة بن امية بن خلف ظنا منه انها كنيته وليس كما ظن البغوي ابو غنيم اسمه قيس تقدم ابو الغوث بن الحصين الخثعمي رجل من الفرع بضم الفاء والراء بعدها مهملة مكان معروف بنواحي المدينة ذكره البغوي ولم يخرج له شيءا واخرج بن ماجة من حديثه سال النبي صلي الله عليه وسلم عن الحج عن الميت روي عنه عطاء الخراساني ولم يسمع منه قال وكان ينزل العرج وهو من نواحي الفرع القسم الثاني خال وكذا القسم الثالث القسم الرابع ابو غليظ يروي عنه حديث فيه من يجهل ولفظه عجيب واسمه سلمة بن الحارث كذا في التجريد وليس هو عند بن الاثير ولا ذكره في الاسماء والله المستعان حرف الفاء القسم الاول ابو فاطمة الازدي وقيل الدوسي ويقال الليثي ذكره بن يونس في تاريخ مصر فقال الدوسي صحابي شهد فتح مصر وذكره الحاكم ابو احمد فيمن لا يعرف اسمه وقال ذكره ابو زرعة §  <> والبغوي وابن سميع فيمن نزل الشام من الصحابة وذكره بن الربيع الجيزي فيمن دخل مصر من الصحابة وقال بن البرقي كان بمصر وله ثلاثة احاديث وقال مسلم في الكني وتبعه ابو احمد له صحبة وقال الفضل الغلابي قبره بالشام الي جانب قبر فضالة بن عبيد وفرق الحاكم ابو احمد بين ابي فاطمة الليثي فقال مصري وبين ابي فاطمة الازدي فقال يقال شامي والله اعلم وقال المزي في التهذيب اختلف في اسمه فقيل انيس وقيل عبد الله بن انيس روي عن النبي صلي الله عليه وسلم روي عنه كثير بن قليب وكثير بن مرة وابو عبد الرحمن الحبلي وارسل عنه مسلم بن عبد الله الجهني وحديثه عن دوس بسند حسن واخرج بن المبارك في الزهد من طريق الحارث بن يزيد عن كثير الاعرج قال كنا بذي الصواري ومعنا ابو فاطمة الازدي وكان قد اسودت جبهته وركبتاه من كثرة السجود ابو فاطمة الانصاري ذكره بن شاهين في الصحابة واورد له من وجه ضعيف عن ابان بن ابي عياش احد المتروكين عن انس ان ابا فاطمة الانصاري اتي رسول الله صلي الله عليه وسلم فقال عليك بالصوم فانه لا مثل له وهذا يحتمل ان يكون الازدي لان الانصاري من الازد وذكر الصوم ايضا وقع في بعض طرق حديث الازدي لكن مخرج الحديث مختلف ابو فاطمة الليثي افرده الحاكم ابو احمد عن الدوسي ونقل ذلك عن البخاري واستدركه الذهبي وقد قالوا في ترجمته الدوسي ويقال الليثي فهو محتمل ابو فاطمة الضمري قال البخاري قال بن ابي اويس حدثني اخي عن حماد ابي حميد عن مسلم بن عقيل مولي الزرقيين دخلت علي عبيد الله بن ابي اياس بن فاطمة الضمري فقال يا ابا عقيل حدثني ابي عن جدي قال اقبل علينا رسول الله صلي الله عليه وسلم فقال ايكم يحب ان يصح فلا يسقم الحديث وفيه ان الله ليبتلي المءمن وما يبتليه الا لكرامته عليه او لان له منزلة عنده ما يبلغه تلك المنزلة الا ببلاءه له واورده في ترجمة ابي عقيل المذكور ولم يزد علي ذلك ووقع لي بعلو في المعرفة لابن مندة من طريق ابي عامر العقدي عن محمد بن ابي حميد وهو حماد عن مسلم عن عبد الله بن ابي اياس عن ابيه عن جده قال بن مندة رواه رشدين بن سعد عن زهرة بن معبد عن عبد الله قلت لكن سمي اباه انسا بدل اياس كذا قال وقد ساقه الحاكم ابو احمد من طريق رشدين فقال اياس فلعل الوهم من النسخة ابو فراس الاسلمي ربيعة بن كعب من خدام النبي صلي الله عليه وسلم تقدم في الاسماء ابو فراس الاسلمي اخر لا يعرف اسمه فرقهما البخاري وتبعه الحاكم ابو احمد فذكر البخاري عن ابي عبد الصمد العمي عن ابي عمران الجوني عن ابي فراس رجل من اسلم قال قال رجل يا رسول الله ما الاسلام الحديث قال ابو عمر تبعا للحاكم الاقوي انهما اثنان لان ابا فراس عداده في اهل البصرة روي عنه ابو عمران الجوني وربيعة بن كعب عداده في اهل المدينة نزل علي زيد بن الدثنة الي ان مات بعد الحرة زاد الحاكم ابو احمد وحديث كل منهما علي حدة ورواية هذا غير رواية هذا وقوي غيره ذلك بانه اشتهر ان ربيعة بن كعب ما روي عنه الا ابو سلمة عبد الرحمن لكن رايت في مستدرك الحاكم من طريق مبارك بن فضالة عن ابي عمران الجوني حدثني ربيعة بن كعب §  <> الاسلمي قال كنت اخدم النبي صلي الله عليه وسلم الحديث فهذا هو حديث ربيعة الذي اخرجوه له وان كان مبارك بن فضالة حفظه فهو الاول تاخر حتي لقيه ابو عمران الجوني فسماه تارة وكناه اخري واخلق به ان يكون وهما نعم وجدت لابي فراس الاسلمي ذكرا في حديث اخر بسند اخرجه البغوي فقال ابو فراس الاسلمي سكن المدينة وروي عن النبي صلي الله عليه وسلم حديثا ثم اخرج من طريق بن لهيعة عن محمد بن عبد الله بن مالك عن محمد بن عمرو بن عطاء عن ابي فراس الاسلمي قال كان فتي منا يلزم رسول الله صلي الله عليه وسلم ويخف له في حواءجه فخلا به رسول الله صلي الله عليه وسلم ذات يوم فقال سلني اعطك فقال ادع الله ان يجعلني معك يوم القيامة قال فاعني بكثرة السجود وهذا يشبه حديث ربيعة بن كعب فكانه الفتي المذكور في هذه الرواية وبها يظهر ان ابا فراس غير ربيعة بن كعب ابو فروة مولي الحارث بن هشام ياتي في القاف قالوا فيه ابو قرة ابو فروة الاشجعي هو نوفل والد فروة تقدم في الاسماء وقع في الكني في مسند الحارث ابو فريعة السلمي قال ابو عمر له صحبة وشهد حنينا ولا اعلم له رواية انتهي وقد ساق بن مندة من طريق احفاده بسند اليه قال قال رسول الله صلي الله عليه وسلم حين افترق الناس عنه يوم حنين وصبرت معه بنو سليم لا ينسي الله لكم هذا اليوم يا بني سليم قال واسم ابي فريعة كنيته ابو فسيلة بكسر المهملة وزن عظيمة هو واثلة بن الاسقع تقدم اخرج حديثه البغوي وابن ماجة من طريق عباد بن كثير الفلسطيني عن امراة منهم يقال لها فسيلة سمعت ابي يقول سالت النبي صلي الله عليه وسلم فقلت يا رسول الله امن العصبية ان يحب الرجل قومه قال لا ولكن من العصبية ان يعين الرجل قومه علي الظلم واخرجه ابو داود من طريق سلمة بنت بسر عن بنت واثلة بن الاسقع عن ابيها قالت يا رسول الله ما العصبية قال ان تعين قومك علي الظلم فجزم بن عساكر ومن تبعه بان فسيلة هي بنت واثلة المبهمة في هذه الرواية ابو فضالة الانصاري ذكره احمد والحارث بن ابي اسامة في مسنديهما وابن ابي خيثمة والبغوي في الصحابة واسد بن موسي في فضاءل الصحابة وذكره البخاري في الكني مختصرا قال حدثنا موسي حدثنا محمد بن راشد حدثنا بن عقيل عن فضالة بن ابي فضالة الانصاري وقتل ابو فضالة بصفين مع علي وكان من اهل بدر واخرجه بن ابي خيثمة عن عارم عن بن راشد فقال عنه عن فضالة ان عليا قال اخبرني النبي صلي الله عليه وسلم اني لا اموت حتي اءمر ثم تخضب هذه من هذه قال فضالة فصحبه ابي الي صفين وقتل معه وكان ابو فضالة من اهل بدر وساقه احمد مطولا زاد فيه قصة لابي فضالة مع علي حضرها فضالة وكذلك اخرجه البغوي عن شيبان بن فروخ عن محمد بن راشد بطوله ابو الفضل العباس بن عبد المطلب الهاشمي عم رسول الله صلي الله عليه وسلم ابو فورة حدير الاسلمي تقدما في الاسماء ابو فكيهة الجهمي مولي صفوان بن امية وقيل مولي بني عبد الدار ويقال اصله من الازد §  <> اسلم قديما فربط امية بن خلف في رجله حبلا فجره حتي القاه في الرمضاء وجعل يخنقه فجاء اخوه ابي بن خلف فقال زده فلم يزل علي ذلك حتي ظن انه مات فمر ابو بكر الصديق فاشتراه واعتقه واسمه يسار وقد تقدم في التحتانية وقيل اسمه افلح بن يسار وقال عمر بن شبة قيل كان ينسب الي الاشعريين ابو الفيل الخزاعي ذكره مطين وابن السكن وغيرهما واوردوا من طريق سماك بن حرب حدثني عبد الله بن جبير الخزاعي عن ابي الفيل عن النبي صلي الله عليه وسلم قال لا تسبوه يعني ماعز بن مالك حين رجم قال البغوي ليس له غيره ولم يحدث به غير سماك بن حرب ووقع في رواية بن السكن لا تسبوه يعني عريب بن مالك وفي حاشية الكتاب عريب اسمه وماعز لقبه القسم الثاني لم يذكر فيه احد من الرجال القسم الثالث ابو فالج الانماري ذكره بن ابي حاتم فقال ليست له صحبة وذكره الحاكم ابو احمد وقال اكل الدم في الجاهلية وادرك زمان النبي صلي الله عليه وسلم وقدم حمص اول ما فتحت وصحب معاذ بن جبل ذكر ذلك كله بقية عن محمد بن زياد وقال ادرك رجالا من اصحاب النبي صلي الله عليه وسلم ورجالا ممن اسلم والنبي صلي الله عليه وسلم حي واكل الدم في الجاهلية روي عنه محمد بن زياد الالهاني ومروان بن رءية وقال البخاري قال ابو اليمان حدثنا صفوان بن عمرو عن مروان بن رءية عن ابي فالج قال قدمت حمص اول ما فتحت واخرج احمد من طريق شرحبيل بن مسلم قال رايت اثنين اكلا الدم في الجاهلية وهما ابو عنبة الخولاني وابو فالج الانماري وذكره ابو زرعة في الطبقة العليا بعد الصحابة وقال صحب معاذا وذكره ابو عيسي في الحمصيين فيمن صحب ابو عبيدة ومعاذا وحضر خطبة عمر بالجابية سنة ست عشرة ابو فراس النهدي له ادراك وله قصة مع عمر عند ابي داود وذكر اسحاق بن راهويه انه الربيع بن زياد الحارثي ورد ذلك البخاري وقال خليفة كنية الربيع بن زياد ابو عبد الرحمن ويمكن ان يكون له كنيتان ابو فرقد له ادراك وشهد فتح الاهواز سنة ثمان عشرة قال بن ابي شيبة حدثنا ريحان بن سعيد حدثنا مروان حدثني ابو فرقد قال كنا مع ابي موسي يوم فتحنا سوق الاهواز فسعي رجل من المشركين فقال له رجل من المسلمين تترس فقال ابو موسي هذا امان فخلي سبيله القسم الرابع §  <> ابو فاختة تابعي معروف في التابعين ارسل حديثا فذكره بعضهم في الصحابة وقال بن مندة ذكر في الصحابة ولا يثبت واورد من طريق هشام بن محمد بن عمارة عن عمرو بن ثابت عن ابيه عن ابي فاختة ان رسول الله صلي الله عليه وسلم زار عليا الحديث انتهي وذكره العجلي وابن حبان وغيرهما في ثقات التابعين وهو متجه واسمه سعيد بن علاقة وقد اخرج الحديث المذكور ابو داود الطيالسي عن عمرو بن ثابت عن ابيه فقال عن ابي فاختة عن علي قال زارنا رسول الله صلي الله عليه وسلم فبات عندنا الحديث ابو فاطمة الضمري ذكره بن مندة فاخرج في ترجمته حديثا لابي فاطمة الازدي مخرجهما واحد فكان بعض الرواة غلط في نسبه ويحتمل ان يكون الليثي القدم في الاول لان ليثا وضمرة من بني كنانة كما ان دوسا والانصار من الازد ابو الفحم بن عمرو ذكره ابو موسي عن المستغفري وانه حكي عن ابي علي بسمرقند عن ابي الفحم بن عمرو انه راي النبي صلي الله عليه وسلم عند احجار الزيت قلت وهو تغيير فاحش وانما هو عن عمير مولي ابي اللحم فحرف عميرا فجعله عمرا واخره عن موضعه وغير مولي فجعله ابنا وغير ابي وهو اسم فاعل فجعله اداة كنية وغير اللام فجعلها فاء والحديث معروف لعمير وبالله التوفيق حرف القاف القسم الاول ابو قابوس اسمه مخارق تقدم ويقال ابو مخارق ابو القاسم الانصاري قال انس كان رسول الله صلي الله عليه وسلم بالبقيع فنادي رجل يا ابا القاسم فالتفت رسول الله صلي الله عليه وسلم فقال يا رسول الله لم اعنك وانما عنيت فلانا فقال سموا باسمي ولا تكنوا بكنيتي اخرجه البخاري ولم اعرف اسم هذا الرجل ولا نسبه ابو القاسم مولي ابي بكر الصديق شهد خيبر ويقال اسمه القاسم اخرج بن ابي خيثمة من طريق مطرف عن ابي الجهم عن ابي القاسم مولي ابي بكر الصديق قال لما فتحت خيبر اكلنا من الثوم فقال النبي صلي الله عليه وسلم من اكل من هذه البقلة الخبيثة فلا يقربن مسجدنا حتي يذهب ريحها من فيه واخرج مطين والبغوي والدولابي من وجه اخر عن مطرف عن ابي الجهم عن ابي القاسم مولي ابي بكر الصديق قال ضرب رجل اخاه بالسيف علي عهد رسول الله صلي الله عليه وسلم فقضي له ان يموت فقال رسول الله صلي الله عليه وسلم اردت قتله قال نعم يا رسول الله قال انطلق فعش ما شءت لفظ بن ابي خيثمة وعند الاخرين فعش ما استطعت §  <> ابو القاسم محمد بن حاطب الجمحي وابو القاسم محمد بن طلحة بن عبيد الله تقدما في الاسماء ابو القاسم غير مسمي ولا منسوب روي عن النبي صلي الله عليه وسلم روي عنه بكرة بن سوادة ذكره المستغفري واستدركه ابو موسي وذكره ابو عمر فقال لا ادري اهو مولي ابي بكر او مولي زينب بنت جحش او هو مولي غيرهما قلت ولم يذكر مولي زينب ابو قبيصة ذءيب الخزاعي ذكره الحاكم ابو احمد وابو قبيصة هلب ذكره الدولابي وقد تقدما في الاسماء ابو قتادة بن ربعي الانصاري المشهور ان اسمه الحارث وجزم الواقدي وابن القداح وابن الكلبي بان اسمه النعمان وقيل اسمه عمرو وابوه ربعي هو بن بلدمة بن خناس بضم المعجمة وتخفيف النون واخره مهملة بن عبيد بن غنم بن سلمة الانصاري الخزرجي السلمي وامه كبشة بنت مطهر بن حرام بن سواد بن غنم اختلف في شهوده بدرا فلم يذكره موسي بن عقبة ولا بن اسحاق واتفقوا علي انه شهد احدا وما بعدها وكان يقال له فارس رسول الله صلي الله عليه وسلم ثبت ذلك في صحيح مسلم في حديث سلمة بن الاكوع الطويل الذي فيه قصة ذي قرد وغيرها واخرج الواقدي من طريق يحيي بن عبد الله بن ابي قتادة عن ابيه قال ادركني رسول الله صلي الله عليه وسلم يوم ذي قرد فنظر الي فقال اللهم بارك في شعره وبشره وقال افلح وجهه فقلت ووجهك يا رسول الله قال ما هذا الذي بوجهك قلت سهم رميت به قال ادن فدنوت فبصق عليه فما ضرب علي قط ولا فاح ذكره في حديث طويل وقال سلمة بن الاكوع في حديثه الطويل الذي اخرجه مسلم خير فرساننا ابو قتادة وخير رجالنا سلمة بن الاكوع ووقعت هذه القصة بعلو في المعرفه لابن مندة ووقعت لنا من حديث ابي قتادة نفسه في اخر المعجم الصغير للطبراني وكان يقال له فارس رسول الله صلي الله عليه وسلم وروي ايضا عن معاذ وعمر روي عنه ابناه ثابت وعبد الله ومولاه ابو محمد نافع الاقرع وانس وجابر وعبد الله بن رباح وسعيد بن كعب بن مالك وعطاء بن يسار واخرون قال بن سعد شهد احدا وما بعدها وقال ابو احمد الحاكم يقال كان بدريا وقال اياس بن سلمة عن ابيه قال قال رسول الله صلي الله عليه وسلم خير فرساننا ابو قتادة وقال ابو نضرة عن ابي سعيد اخبرني من هو خير مني ابو قتادة ومن لطيف الرواية عن ابي قتادة ما قرء علي فاطمة بنت محمد الصالحية ونحن نسمع عن ابي نصير بن الشيرازي اخبرنا عبد الحميد بن عبدالرشيد في كتابه اخبرنا الحافظ ابو العلاء العطار اخبرنا ابو علي الحداد اخبرنا ابو نعيم اخبرنا الطبراني حدثتنا عبدة بنت عبد الرحمن بن مصعب بن ثابت بن عبد الله بن ابي قتادة حدثني ابي عبد الرحمن عن ابيه مصعب عن ابيه ثابت عن ابيه عبد الله عن ابيه ابي قتادة انه حرس النبي صلي الله عليه وسلم ليلة بدر فقال اللهم احفظ ابا قتادة كما حفظ نبيك هذه الليلة وبه عن ابي قتادة قال انحاز المشركون علي لقاح رسول الله صلي الله عليه وسلم فادركتهم فقتلت مسعدة فقال رسول الله صلي الله عليه وسلم حين راني افلح الوجه قال الطبراني لم يروه عن ابي قتادة الا ولده ولا سمعناها §  <> الا من عنده وكانت امراة فصيحة عاقلة متدينة قلت الحديث الاول جاء عن ابي قتادة في قصة طويلة من رواية عبد الله بن رباح عن ابي قتادة قال كنت مع رسول الله صلي الله عليه وسلم في بعض اسفاره اذ مال عن راحلته قال فدعمته فاستيقظ فذكر الحديث وفيه حفظك الله كما حفظت نبيه اخرجه مسلم مطولا وفيه نومهم عن الصلاة وفيه ليس التفريط في النوم وفي اخره ان ساقي القوم اخرهم شربا وقوله في رواية عبدة ليلة بدر غلط فانه لم يشهد بدرا والحديث الثاني قد تقدمت الاشارة اليه وكانت وفاة ابي قتادة بالكوفة في خلافة علي ويقال انه كبر عليه ستا وقال انه بدري وقال الحسن بن عثمان مات سنة اربعين وكان شهد مع علي مشاهده وقال خليفة ولاه علي مكة ثم ولاها قثم بن العباس وقال الواقدي مات بالمدينة سنة اربع وخمسين وله اثنتان وسبعون سنة ويقال بن سبعين قال ولا اعلم بين علماءنا اختلافا في ذلك وروي اهل الكوفة انه مات بالكوفة وعلي بها سنة ثمان وثلاثين وذكره البخاري في الاوسط فيمن مات بين الخمسين والستين وساق باسناد له ان مروان لما كان واليا علي المدينة من قبل معاوية ارسل الي ابي قتادة ليريه مواقف النبي صلي الله عليه وسلم واصحابه فانطلق معه فاراه ويدل علي تاخره ايضا ما اخرجه عبد الرزاق عن معمر عن عبد الله بن محمد بن عقيل ان معاوية لما قدم المدينة تلقاه الناس فقال لابي قتادة تلقاني الناس كلهم غيركم يا معشر الانصار ابو قتادة السدوسي له في مسند بقي بن مخلد حديث كذا في التجريد ابو قتيلة بالتصغير اسمه مرثد بن وداعة الحمصي تقدم في الاسماء واخرج حديثه بن ابي خيثمة والبغوي في الكني ابو قحافة عثمان بن عامر التيمي والد ابي بكر الصديق تقدم في الاسماء ابو قحافة بن عفيف المري ذكره بن عساكر في تاريخه وقال يقال ان له صحبة سكن دمشق قال وذكر ابو الحسين الرازي والد تمام عن بعضهم ان الدار التي بسويقة جناح دار ابي قحافة ومعاوية ابني عفيف ولهما صحبة ابو قدامة الانصاري ذكره ابو العباس بن عقدة في كتاب الموالاة الذي جمع فيه طرق الحديث من كنت مولاه فعلي مولاه فاخرج فيه من طريق محمد بن كثير عن فطر عن ابي الطفيل قال كنا عند علي فقال انشد الله من شهد يوم غدير خم فقام سبعة عشر رجلا منهم ابو قدامة الانصاري فشهدوا ان رسول الله صلي الله عليه وسلم قال ذلك واستدركه ابو موسي وسياتي في الذي بعده ما يءخذ منه اسم ابيه وتمام نسبه ابو قدامة بن الحارث من بني عبد مناة بن كنانة ويقال من بني عبد بن كنانة بغير اضافة ذكره بن الدباغ عن العدوي وقال انه شهد احدا ذكره مستدركا علي بن عبد البر وتبعه بن الاثير وزاد بن الدباغ عن العدوي انه كان بن خمس باحد وبقي حتي قتل مع علي بصفين وقد انقرض عقبه قال ويقال هو ابو قدامة بن سهل بن الحارث بن جعدبة بن ثعلبة بن سالم بن مالك بن واقف وهو سالم قلت هذا الثاني من الانصار لا يجتمع مع بني كنانة فهو غيره ولعله المذكور قبله §  <> ابو قراد السلمي ذكره بن ابي عاصم وابن السكن وقال مخرج حديثه عن اهل البصرة واخرجا من طريق ابي جعفر الخطمي عن عبد الرحمن بن الحارث عن ابي قراد السلمي قال كنا عند النبي صلي الله عليه وسلم فدعا بطهور فغمس يده فيه فتوضا فتتبعناه فحسوناه فلما فرغ قال ما حملكم علي ما صنعتم قلنا حب الله ورسوله قال فان احببتم ان يحبكم الله ورسوله فادوا اذا اءتمنتم واصدقوا اذا حدثتم واحسنوا جوار من جاوركم ومداره علي عبد الله بن قيس وهو ضعيف وقد خالفه ضعيف اخر وهو الحسن بن ابي جعفر فرواه عن ابي جعفر الخطمي عن الحارث بن فضيل عن عبد الرحمن بن ابي قراد فاحد الطريقين وهم واخلق ان تكون هذه اولي وقد نبهت عليه في عبد الرحمن ابو قرصافة اسمه جندرة بفتح الجيم وسكون النون الكناني تقدم في الاسماء ابو قرة مولي عبد الرحمن بن الحارث بن هشام المخزومي ويقال ابو فروة بفتح الفاء وسكون الراء بعدها واو قال ابو عمر كان مسلما علي عهد رسول الله صلي الله عليه وسلم وذكر الواقدي عنه انه قال قسم ابو بكر الصديق قسما فقسم لي كما قسم لمولاي اورده ابو عمر في حرف الفاء واورده ابو احمد الحاكم في حرف القاف وهو اولي ابو قرة بن معاوية بن وهب بن قيس بن حجر الكندي ذكره بن الكلبي وقال وكان شريفا وفد علي النبي صلي الله عليه وسلم وذكر بن سعد ان ابنه عمرو بن قرة ولي قضاء الكوفة بعد شريح ابو قريع ذكره بن مندة وقال روي حديثه طالب بن قريع عن ابيه عن جده قال كنت تحت ناقة رسول الله صلي الله عليه وسلم في حجته ابو القصم بعد القاف صاد مهملة اكتني بها علي رضي الله عنه يوم احد عند القتال ذكره بن اسحاق ابو قطبة بن عمرو او عامر بن حديدة الانصاري اسمه يزيد ابو قطن بفتحتين هو قبيصة بن المخارق الهلالي تقدما في الاسماء ابو القلب ذكر في التجريد ان بقي بن مخلد اخرج له في مسنده حديثا ابو القمراء ذكره بن مندة واخرج من طريق ابي عبد الرحمن قال حدثنا شريك كانه بن ابي نمر عن ابي القمراء قال كنا في مسجد رسول الله صلي الله عليه وسلم حلقا نتحدث اذ خرج علينا رسول الله صلي الله عليه وسلم من بعض حجره فنظر الي الحلق ثم جلس الي اصحاب القران فقال بهذا المجلس امرت ابو القنشر هو حبان بن ابحر تقدم في الاسماء ذكر كنيته ابو احمد بفتح القاف وسكون النون ثم شين معجمة مكسورة ثم راء وكانه اصوب ابو قيس صرمة بن ابي قيس او بن ابي انس او غير ذلك تقدم مستوعبا في حرف الصاد ابو قيس بن الحارث بن قيس بن عدي بن سعد بن سهم القرشي كان من السابقين الي §  <> الاسلام ومن مهاجرة الحبشة شهد احدا وما بعدها وهو اخو عبد الله بن الحارث ذكر كل ذلك محمد بن اسحاق ونقل ابو عمر عن محمد بن اسحاق ان اسمه عبد الله بن الحارث وتعقبه بن الاثير بان نسخ المغازي عن بن اسحاق متفقة علي ان عبد الله اخوه واسمه كنيته وذكر موسي بن عقبة فيمن هاجر الي الحبشة وذكر بن اسحاق ايضا انه استشهد باليمامة وكذا ذكر الزبير بن بكار ابو قيس بن عمرو بن عبد ود بن عبد ابي قيس بن عبد ود بن نصر بن مالك بن حسل بن عامر القرشي العامري كان ابوه فارس قريش في زمانه وهو الذي بارزه علي يوم الخندق فقتله علي وذكر الزبير لابي قيس هذا بنتا لم يبق من نسل عمرو بن عبد ود احد الا من نسلها ابو قيس الجهني شهد الفتح مع رسول الله صلي الله عليه وسلم وسكن البادية وبقي الي اخر خلافة معاوية ذكر ذلك الواقدي ابو قيس بن المعلي بن لوذان بن حارثة الانصاري الخزرجي ذكر بن الكلبي انه شهد بدرا واستدركه بن الاثير ابو قيس بن الاسلت واسم الاسلت عامر بن جشم بن واءل بن زيد بن قيس بن عامر بن مرة بن مالك بن الاوس الاوسي مختلف في اسمه فقيل صيفي وقيل الحارث وقيل عبد الله وقيل صرمة واختلف في اسلامه فقال ابو عبيد القاسم بن سلام في ترجمة ولده عقبة بن ابي قيس له ولابيه صحبة وقال عبد الله بن محمد بن عمارة بن القداح كان يعدل بقيس بن الخطيم في الشجاعة والشعر وكان يحض قومه علي الاسلام ويقول استبقوا الي هذا الرجل وذلك بعد ان اجتمع بالنبي صلي الله عليه وسلم وسمع كلامه وكان قبل ذلك في الجاهلية يتاله ويدعي الحنيف وذكر بن سعد عن الواقدي باسانيد عديدة قالوا لم يكن احد من الاوس والخزرج اوصف لدين الحنيفية ولا اكثر مساءلة عنها من ابي قيس بن الاسلت وكان يسال من اليهود عن دينهم فكان يقاربهم ثم خرج الي الشام فنزل علي ال جفنة فاكرموه ووصلوه وسال الرهبان والاحبار فدعوه الي دينهم فامتنع فقال له راهب منهم يا ابا قيس ان كنت تريد دين الحنيفية فهو من حيث خرجت وهو دين ابراهيم ثم خرج الي مكة معتمرا فبلغ زيد عمرو بن نفيل فكلمه فكان يقول ليس احد علي دين ابراهيم الا انا وزيد بن عمرو وكان يذكر صفة النبي صلي الله عليه وسلم وانه يهاجر الي يثرب وشهد وقعة بعاث وكانت قبل الهجرة بخمس سنين فلما قدم النبي صلي الله عليه وسلم المدينة جاء اليه فقال الام تدعو فذكر له شراءع الاسلام فقال ما احسن هذا واجمله فلقيه عبد الله بن ابي بن سلول فقال لقد لذت من حزبنا كل ملاذ تارة تحالف قريشا وتارة تتبع محمدا فقال لا جرم لا تبعته الا اخر الناس فزعموا انه لما حضره الموت ارسل اليه النبي صلي الله عليه وسلم يقول له قل لا اله الا الله اشفع لك بها فسمع يقول ذلك وفي لفظ كانوا يقولون فقد سمع يوحد عند الموت وحكي ابو عمر هذه القصة الاخيرة فقال انه لما سمع كلام النبي صلي الله عليه وسلم قال ما احسن هذا انظر في امري واعود اليك فلقيه عبد الله بن ابي فقال له اهو الذي كانت احبار يهود تخبرنا عنه فقال له عبد الله كرهت حرب الخزرج فقال والله لا اسلم الي سنة فمات قبل ان يحول الحول علي راس §  <> عشرة اشهر من الهجرة وقال ابو عمر في اسلامه نظر وقد جاء عن بن اسحاق انه هرب الي مكة فاقام بها مع قريش الي عام الفتح ومن محاسن شعره قوله في صفة امراة وتكرمها جاراتها فيزرنها وتعتل من اتيانهن فتعتذر ومنها قوله وذكر ابو موسي عن المستغفري انه ذكر ابا قيس بن الاسلت هذا ونقل عن بن جريج عن عكرمة قال نزلت فيه وفي امراة كبشة بنت معن بن عاصم لا يحل لكم ان ترثوا النساء كرها كذا نقل والمنقول عن بن جريج عند الطبري وغيره انما هو قوله تعالي ولا تنكحوا ما نكح اباءكم من النساء الاية قال نزلت في كبشة بنت معن بن عاصم توفي عنها زوجها ابو قيس بن الاسلت فجنح عليها ابنه فنزلت فيهما وعن عدي بن ثابت قال لما مات ابو قيس بن الاسلت خطب ابنه امراته فانطلقت الي النبي صلي الله عليه وسلم فقالت ان ابا قيس قد هلك وان ابنه من خيار الحي قد خطبني فسكت فنزلت الاية قال فهي اول امراة حرمت علي بن زوجها اخرجه سنيد بن داود في تفسيره عن اشعث بن سوار عن عدي بهذا قال بن الاثير اخرج ابو عمر هذه القصة في هذه الترجمة وافردها ابو نعيم فاخرجها في ترجمة ابي قيس الانصاري ولم يذكر بن الاسلت واستدرك ابو موسي الترجمتين فذكر ما نقله عن المتسغفري وقال بن الاثير ما حاصله ان القصة واحدة قلت والمنقول في تفسير سنيد عن حجاج عن بن جريج ما تقدم من نزول ولا تنكحوا ما نكح اباءكم من النساء في ابي قيس بن الاسلت وامراته وابنه من غيرها وقد جاء ذلك من رواية اخري مبينة في اسباب النزول ابو قيس الانصاري لم يسم ولا ابوه ومات في حياة النبي صلي الله عليه وسلم اخرج حديثه الطبراني من طريق قيس بن الربيع عن اشعث بن سوار عن عدي بن ثابت عن رجل من الانصار قال توفي ابو قيس وكان من صالحي الانصار فخطب ابنه امراته فقالت انما اعدك ولدا وانت من صالحي قومك ولكن اتي النبي صلي الله عليه وسلم فاستامره فاتته فذكرت له ذلك فقال فارجعي الي بيتك ونزلت ولا تنكحوا ما نكح اباءكم من النساء وقد تقدم ان سنيدا اخرجه عن هشيم عن اشعث فقال عن عدي مرسلا وقال لما مات ابو قيس بن الاسلت الخ وقيل ان قوله الاسلت وهم من بعض رواته ويءيده ما تقدم في حرف القاف ان قيس بن الاسلت مات في الجاهلية فكان قيس بن ابي قيس الذي وقعت له هذه القصة اخر ووقع الغلط في تسميته قيسا كما سبقت اليه الاشارة هناك ابو القين الحضرمي له رءية روي عنه سعيد بن جمهان انه مر بالنبي صلي الله عليه وسلم ومعه شء من تمر في حديث ذكره وقيل انه ابو قين نصر بن دهر كذا ذكره ابو عمر مختصرا واخرجه الدولابي والبغوي وابن السكن وابن عدي في الكامل من طريق يحيي بن حماد عن حماد بن سلمة عن سعيد بن جمهان انه مر بالنبي صلي الله عليه وسلم علي حمار ومعه شء من تمر فقام النبي صلي الله عليه وسلم لياخذ منه شيءا ينثره بين اصحابه فانبطح عليه وبكي فقال زادك الله شحا فكان لا ينفك منه شء وفي رواية بن عدي بهذا السند الي سعيد بن جمهان ان عم ابي القين ركب حمارا وبين يديه شء من تمر فقام عم ابي القين لياخذ منه شيءا فانبطح فذكره واخرجه بن منده من طريق هدبة عن حماد فقال §  <> عن سعيد بن جمهان عن ابيه ان مولاه ابا القين الاسلمي مر علي النبي صلي الله عليه وسلم وهو غلام فقام اليه عمه فذكره وقال في اخره فكان من اشح الناس وانكر بن منده زيادة قوله عن ابيه وان الناس رووه عن سعيد بن جمهان عن ابي القين وقال البغوي ابو القين سكن البصرة ولم يحدث بغير هذا الحديث ولا رواه عن سعيد بن جمهان ولم ار من نسبه حضرميا كما قال ابو عمر فالله اعلم ابو القين الخزاعي روي اسيد بن عامر عن ابيه انه قال وقف علينا النبي صلي الله عليه وسلم ذكره بن منده مختصرا وافرده عن شيخ سعيد بن جمهان ويحتمل ان يكون هو اخر فان اسلم اخو خزاعة والصحيح في الاول انه اسلمي القسم الثاني ابو القاسم محمد بن الاشعث بن قيس ومحمد بن ابي بكر الصديق تقدما في الاسماء ابو قيس يسير بن عمرو ذكره بن منده القسم الثالث ابو قتادة المدلجي له ادراك وقصة مع عمر ذكر بن ابي شيبة من طريق عمرو بن شعيب ان ابا قتادة المدلجي قتل ابنه قتادة في عهد عمر تقدم في قتادة من وجه اخر ابو قدامة غير منسوب ذكر بن عيسي في رجال حمص في اصحاب ابي عبيدة ومعاذ الذين حضروا خطبة عمر بالجابية في سنة ست عشرة ابو قرعان الكندي له ادراك وذكره وثيمة فيمن ثبت علي الاسلام في الردة ابو قيس بن شمر الكندي ذكره دعبل بن علي في طبقات الشعراء وقال مخضرم وانشد له شعرا وسطا القسم الرابع ابو قيس بن الساءب المخزومي ذكره الدولابي في الكني والصواب قيس بن الساءب كما تقدم في القاف من الاسماء ابو قيس ذكره بن منده فقال روي عمرو بن قيس عن ابيه عن جده انه سمع النبي صلي الله عليه وسلم يقول ما من خطوة احب الي الله من خطوة الي صلاة قال بن منده وهو بشير بن عمر قلت له رءية ولا صحبة له §  <> حرف الكاف القسم الاول ابو كامل الاحمسي اسمه قيس بن عاءذ وقيل عبد الله بن مالك روي عن النبي صلي الله عليه وسلم روي حديثه اسماعيل بن ابي خالد عن اخيه عنه قال رايت النبي صلي الله عليه وسلم يخطب الناس يوم عيد علي ناقة وحبشي يمسك بخطامها الحديث وجاء هذا الحديث عن اسماعيل بن ابي خالد عن قيس بن عاءذ بلا واسطة وقال البغوي لا اعلم له غيرة وفي كني الدولابي من وجه اخر عن اسماعيل قال رايت ابا كاهل وكان امامنا وهلك ايام المختار وفي رواية البخاري قال اسماعيل وكان ابو كاهل امام الحي ابو كاهل اخر غير منسوب ذكره بن السكن في الصحابة وقال هو غير الاحمسي وكذا فرق بينهما ابو احمد الحاكم وغيره وقال لا يروي حديثه من وجه يعتمد قال ابو عمر ذكر له حديث طويل منكر فلم اذكره وقد ساقه ابو احمد والعقيلي في الضعفاء وابن السكن كلهم من طريق الفضل بن عطاء عن الفضل بن شعيب عن ابي منظور عن ابي معاذ عن ابي كاهل قال قال رسول الله صلي الله عليه وسلم اعلم يا ابا كاهل انه من ستر عورته من الله سرا وعلانية كان حقا علي الله ان يستر عورته يوم القيامة اقتصر بن السكن علي هذا القدر وقال اسناده مجهول واوله عند ابي احمد ان النبي صلي الله عليه وسلم قال له الا اخبرك بقضاء قضاه الله علي نفسه قال قلت بلي يا رسول الله قال من لي ان ابقي اخبرك به كله احيا الله قلبك فلا يميته حتي يميت بدنك ثم ذكره بطوله وهو يشتمل علي ثلاث عشرة خصلة يقول في كلها اعلمن يا ابا كاهل منها انه من صلي علي كل يوم ثلاث مرار وكل ليلة ثلاث مرار حبا او شوقا الي كان حقا علي الله ان يغفر له ذنوبه ذلك اليوم وتلك الليلة قال العقيلي في الفضل بن عطاء نظر واما الطبراني فجعلهما واحد وكذلك ابو احمد العسال ابو كبشة الانماري المذحجي مختلف في اسمه فقال بن حبان في ترجمة عبد الله بن ابي كبشة من الثقات اسم ابي كبشة الانماري سعيد بن عمر وقال غيره نزل الشام واسمه عمرو بن سعيد وقيل عمير بضم العين وقيل بفتح الياء اخر الحروف والزاي المنقوطة قراته بخط الخطيب في المءتلف نقلا عن دحيم وقيل عامر وقيل سليم وقال ابو احمد الحاكم له صحبة وجزم بانه عمير بن سعد وكذا جزم به الترمذي وحكي الخلاف في اسمه البخاري فيمن اسمه عمرو واخرج البيهقي في الدلاءل من طريق المسعودي عن اسماعيل بن اوسط عن محمد بن ابي كبشة عن ابيه قال لما كان في غزوة تبوك تسارع القوم الي الحجر فاتيت رسول الله صلي الله عليه وسلم وهو ممسك بعيره وهو يقول علام تدخلون علي قوم غضب الله عليهم الحديث وروي ابو كبشة ايضا عن ابي بكر الصديق روي عنه ابناه عبد الله ومحمد وسالم بن ابي الجعد وابو عامر الهوزني وابو البحتري الطاءي وثابت بن ثوبان وعبد الله بن بسر §  <> الحبراني وازهر بن سعيد الحرازي وغيرهم قال الاجري عن ابي داود ابو كبشة الانماري له صحبة وابو كبشة البلوي ليست له صحبة ابو كبشة مولي رسول الله صلي الله عليه وسلم مختلف في اسمه ايضا قال خليفة اسمه سليم وقال بن حبان اوس وقيل سلمة وقال العسكري قيل اوس ذكره موسي بن عقبة وابن اسحاق فيمن شهد بدرا وقال ابو احمد الحاكم كان من مولدي ارض اوس ومات اول يوم استخلف عمر وكذا ذكر بن سعد وفاته وقال كان يوم الثلاثاء من جمادي الاخرة سنة ثلاث عشرة ابو كبشة حاضن النبي صلي الله عليه وسلم الذي كانت قريش تنسبه اليه فتقول قال بن ابي كبشة قيل هو الحارث بن عبد العزي السعدي زوج حليمة تقدم في الاسماء وذكر بن الكلبي في كتاب الدقاءق عن ابيه عن ابي صالح عن بن عباس ان النبي صلي الله عليه وسلم قال حدثني حاضني ابو كبشة انهم لما ارادوا دفن سلول بن حبشية وكان سيدا معظما حفروا له فوقعوا علي باب مغلق ففتحوه فاذا سرير عليه رجل وعليه حلل وعند راسه كتاب انا ابو شمر ذو النون ماوي المساكين ومستعاذ الغارمين اخذني الموت غصبا وقد اعيا ذلك الجبابرة قبلي قال النبي صلي الله عليه وسلم وابو شمر هو سيف بن ذي يزن ويقال ان ابا كبشة الذي كان ينسب اليه هو جده من قبل جدة ابيه وهو والد سلمي الانصارية الخزرجية والدة عبد المطلب وهو بن عمرو بن زيد بن لبيد الخزرجي ووقع في الاستيعاب بدل لبيد اسد وهو تغيير ابو كبير بالموحدة الهذلي ذكره ابو موسي وقال ذكر عن ابي اليقظان انه اسلم ثم اتي النبي صلي الله عليه وسلم فقال احل لي الزنا قال اتحب ان يءتي اليك مثل ذلك قال لا قال فارض لاخيك ما ترضي لنفسك قال فادع الله ان يذهبه عني ابو كثير بالمثلثة مولي تميم الداري ذكره الدولابي واخرج من طريق عتبة بن عبد الملك بن ابي كثير وكان قد عاش ماءة سنة عمن حدثه عن عبد الملك ابيه عن ابي كثير قال قدمت مع تميم الداري الي النبي صلي الله عليه وسلم وكنت حمالا له واخرج الحسن بن رشيق في فواءده من طريق عتبة هذا بهذا الاسناد قال كنت مع تميم في مركب البحر فكسر بنا فخرجنا علي دابة لا نعرف راسها من ذنبها فقلنا ما انت قالت انا الجساسة فذكر قصة الدجال باختصار وفيها فقال لتميم اءته وامن به قال فادع الدابة فقال احملي هءلاء الي فلسطين الي قرية يقال لها بيت عينون قال ابو كثير فكنت مع تميم انا واخو هند واخوه نعيم ابو كريمة هو المقدام بن معد يكرب تقدم ابو كعب الاسدي تقدم ذكره في ترجمة زر بن حبيش في القسم الثالث من حرف الزاي ابو كعب غير منسوب قال الفاكهي في كتاب مكة حدثنا ابو الحسن حامد بن ابي عاصم حدثنا عبد الرحمن بن العلاء المكي في اسناد ذكره قال كان ابو كعب رجلا يحيض كما تحيض المراة فنذر لءن عافاه الله ليحجن وليعتمرن فعافاه الله من ذلك فكان يحج كل عام فانشد في ذلك شعرا فقال §  <> له رسول الله صلي الله عليه وسلم ما فعل جملك يا ابا كعب فقال شرد والذي بعثك بالحق منذ اسلمت ابو كعب الحارثي يقال له ذو الاداوة ذكر الرشاطي عن بن شق الليل الطليطلي ان له صحبة وذكر معمر في جامعه بسنده اليه قال خرجت في طلب ابل لي فتزودت لبنا في اداوة ثم قلت ما انصفت اين الوضوء فاهرقت اللبن وملات الاداوة ماء فقلت هذا وضوء وشراب فكنت اذا اردت ان اتوضا صببت من الادواة ماء واذا اردت ان اشرب شربت لبنا فمكثت بذلك ثلاثا فقالت له اسماء النجرانية احليبا ام قطينا فقال انك لبطالة كان يعصم من الجوع ويروي من الظما ابو كلاب بن ابي صعصعة واسم ابي صعصعة عمرو بن زيد بن عوف بن مبذول الانصاري المازني قال ابو عمر استشهد يوم مءتة ولعله الذي بعده وقد وحدهما بن عساكر ونقل في كتاب الكني من روايته الي ابي طاهر عبد الملك بن محمد بن ابي بكر عن عمه عبد الله بن ابي بكر قال وقتل بمءتة من بني مازن بن النجار ابو كليب وجابر ابنا عمرو بن زيد بن عوف بن مبذول بن عمرو بن غنم بن مازن بن النجار وقال عبد الله بن عمارة بن القداح قاله في نسب الانصار فمن ولد عوف قيس بن ابي صعصعة واخوه ابو كلاب شهدا احدا والمشاهد بعدها حتي استشهدا بمءتة وكذا ذكر بن سعد انهما استشهدا بمءتة ابو كليب بن عمرو بن زيد بن عوف بن مبذول الانصاري اخو جابر شقيقه ذكر بن هشام في زيادات السيرة انهما استشهدا بمءتة قال بن هشام ويقال ابو كلاب ابو كليب اخر قال ابو عمر ذكره بعضهم في الصحابة ولا اعرفه قلت يحتمل ان يكون اراد هذا ويحتمل ان يكون جد عاصم بن كليب فان لعاصم رواية عن ابيه عن جده ابو الكنود سعد بن مالك بن الاقيصر تقدم في الاسماء ابو كيسان هو مولي النبي صلي الله عليه وسلم ذكره الدولابي في الكني القسم الثاني ابو كثير بالمثلثة هو زبيد بتحتانيتين مثناتين مصغرا بن الصلت تقدم القسم الثالث ابو كبير افلح مولي ابي ايوب خالد بن زيد الانصاري تقدم في الاسماء ابو الكنود الازدي الكوفي مخضرم اسمه عبد الله بن عامر وقيل بن عمران وقيل بن عويمر وقيل بن سعد وقيل اسمه عمرو بن حبشي قال ابو موسي في الذيل ادرك الجاهلية واورد له حديثا مرسلا من طريق هنيدة بن خالد عنه قال اتي رسول الله صلي الله عليه وسلم رجل فقال §  <> يا رسول الله اعطني سيفان فذكر الحديث وذكره بن حبان في ثقات التابعين وله رواية عن خباب بن الارت عن بن ماجة روي عنه ابو اسحاق السبيعي وقيس بن وهب واسماعيل بن ابي خالد وابو سعد الازدي ابو كيسان غير منسوب ذكر عبد الرزاق في مصنفه عن معمر عن ايوب عن عدي بن عدي عن ابيه او عمه ان مملوكا يقال له كيسان سمي نفسه قيسا وانتفي من ابيه وادعي الي مولي ابيه ولحق بالكوفة فركب ابوه الي عمر فاخبره فقال انطلق فاقرن ابنك الي بعيرك ثم اضرب ابنك سوطا وبعيرك سوطا حتي تاتي به اهلك ابو كيسبة بسكون التحتانية بعدها مهملة ثم موحدة تقدم في عبد الله بن كيسبة روي قصته مع عمر بيان بن بشر عن قيس بن ابي حازم عن ابي كيسبة قال اني لارجز في عرض هذه الحاءط اقول اقسم بالله ابو حفص عمر الابيات قال فما راعني الا وهو خلف ظهري فقال اقسمت عليك هل علمت بمكاني فقلت لا والله يا امير المءمنين ما علمت بمكانك فقال وانا اقسم لاحملنك القسم الرابع ابو كبير بالموحدة وقيل ابو كبير بزيادة هاء وقيل ابو كثير بمثلثة بلا هاء هو مولي محمد بن جحش ذكره بن منده بسبب حديث وهم بعض رواته باسقاط صحابية فاخرج من طريق مسلم بن خالد الزنجي عن العلاء بن عبد الرحمن عن ابيه عن ابي كبير وكان من اصحاب النبي صلي الله عليه وسلم قال مر النبي صلي الله عليه وسلم بمعمر وفخذه مكشوفة فقال الفخذ عورة قال بن منده اخطا من قال فيه انه من اصحاب النبي صلي الله عليه وسلم وانما روي عن مولاه محمد بن عبد الله بن جحش وله صحبة قلت اخرج حديثه هذا احمد والبخاري في التاريخ والنساءي كلهم من طريق العلاء عن ابيه عن ابي كثير عن محمد بن جحش وهو محمد بن عبد الله بن جحش وقد بينته في التعليق ووهم العسكري فزعم ان ابا كبير ولد في عهد النبي صلي الله عليه وسلم وانما ذكروا هذه الصفة لمولاه محمد بن عبد الله بن جحش فانه كان في عهد النبي صلي الله عليه وسلم صغيرا ابو كرز ذكره بعضهم في الصحابة روي عنه احمد بن حنبل وهو خطا نشا عن سوء فهم فروي الخطيب في المءتلف من طريق اسحاق بن موسي عن ابي داود السجستاني سمعت احمد بن حنبل وذكر ابا كرز يحدث عنه نافع فقال هذا في الصحابة ثم بين المراد بذلك فنقل عن الجعابي فقال ابو كرز هذا اسمه عبد الله بن كرز واصله من الموصل وكان ببغداد ينزل في الموضع المعروف بدور الصحابة وكانوا من صحابة المنصور فاقطعهم ذلك الموضع وكان يروي عن نافع فظن الذي نقل هذا ان المراد بالصحابة اصحاب النبي صلي الله عليه وسلم وليس كذلك ابو كليب الجهني جد عثيم بن كليب ذكره ابو نعيم واورد من طريق الواقدي عن عثيم بن كليب عن ابيه عن جده انه راي النبي صلي الله عليه وسلم دفع من عرفة بعد ان غابت §  <> الشمس قال ابو موسي اورده ابو نعيم علي ظاهر الاسناد وعثيم نسب الي جده وانما هو عثيم بن كثير بن كليب والصحبة لجده كليب قلت وروايته عنه في سنن ابي داود وقد تقدم في الاسماء حرف اللام القسم الاول ابو لاس بالمهملة الخزاعي مختلف في اسمه فقيل عبد الله وقيل زياد روي عن النبي صلي الله عليه وسلم في الحمل علي ابل الصدقة في الحج روي عنه عمر بن الحكم بن ثوبان وذكر البخاري حديثه في الصحيح تعليقا وقد بينته في تعليق التعليق قال البغوي ويقال ابو لاس سكن المدينة واخرج هو وغيره من طريق محمد بن اسحاق عن محمد بن ابراهيم عن عمر بن الحكم بن ثوبان عن ابي سهل الخزاعي قال حملنا رسول الله صلي الله عليه وسلم علي ابل من ابل الصدقة الحديث ابو لبابة بن عبد المنذر الانصاري مختلف في اسمه قال موسي بن عقبة اسمه بشير بمعجمة وزن عظيم وكذا قال ابو الاسود عن عروة وقيل بالمهملة اوله ثم تحتانية ثانية وقال بن اسحاق اسمه رفاعة وكذا قال بن نمير وغيره وذكر صاحب الكشاف وغيره ان اسمه مروان قال بن اسحاق زعموا ان النبي صلي الله عليه وسلم رد ابا لبابة والحارث بن حاطب بعد ان خرجا معه الي بدر فامر ابا لبابة علي المدينة وضرب لهما بسهميهما واجرهما مع اصحاب بدر وكذلك ذكره موسي بن عقبة في البدريين وقالوا كان احد النقباء ليلة العقبة ونسبوه بن عبد المنذر بن زنبر بن زيد بن امية بن زيد بن مالك بن عوف بن عمرو بن عوف بن الاوس ويقال ان رفاعة ومعشرا اخوان لابي لبابة وكانت راية بني عمرو بن عوف يوم الفتح معه روي عن النبي صلي الله عليه وسلم روي عنه ولداه الساءب وعبد الرحمن وعبد الله بن عمر بن الخطاب وولده سالم بن عبد الله ونافع مولاه وعبد الله بن كعب بن مالك وعبد الرحمن بن يزيد بن جابر وعبيد الله بن ابي يزيد وغيرهم يقال مات في خلافة علي وقال خليفة مات بعد مقتل عثمان ويقال عاش الي بعد الخمسين ابو لبابة مولي رسول الله صلي الله عليه وسلم ذكره محمد بن حبيب في كتابه المحبر وذكر البلاذري انه كان من بني قريظة وانه كان مكاتبا فعجز فابتاعه رسول الله صلي الله عليه وسلم فاعتقه قال وهو الذي روي عن رسول الله صلي الله عليه وسلم من قال استغفر الله الذي لا اله الا هو الحي القيوم واتوب اليه غفرت ذنوبه ولو كان فر من الزحف وهو والد يسار بن زيد بن المنذر قلت المعروف ان الذي روي الحديث المذكور هو زيد بن بولا وقد تقدم في ترجمته انه كان نوبيا من سبي بني ثعلبة فهو غير هذا §  <> ابو لبابة الاسلمي قال الحاكم ابو احمد له صحبة واخرج البزار في مسنده من طريق ابي مريم عبد الغفار بن القاسم بن عبد الملك بن ميسرة عن ابي مالك قال حدثنا ابو لبابة الاسلمي ان ناقة من بلاده سرقت فوجدها عند رجل من الانصار قال فقلت له ناقتي اقيم عليها البينة فاقمت البينة واقام البينة عند رسول الله صلي الله عليه وسلم انه اشتراها بثماني عشرة شاة من مشرك من اهل الطاءف فتبسم رسول الله صلي الله عليه وسلم ثم قال ما شءت يا ابا لبابة ان شءت دفعت اليه ثماني عشرة شاة واخذت الراحلة وان شءت خليت عنها قال فقلت له ما عندي ما اعطيه اليوم ولكن يءخر ثمنه الي صرام النخل قال فقوم رسول الله صلي الله عليه وسلم كل شاة بثلاثين صاعا من تمر الي صرام النخل قلت وابو مريم فيه ضعف وهو من رواية علي بن ثابت عنه وفيه ضعف ابو لبيبة الاشهلي اخرج ابو يعلي في مسنده من طريق وكيع عن يحيي بن عبد الرحمن بن ابي لبيبة عن ابيه عن جده احاديث منها من استحل بدرهم في النكاح فقد استحل قال وبهذا الاسناد عدة احاديث ولم يرو عنه غير ابنه عبد الرحمن واخرج الزبير في كتاب النسب والطبراني من طريق حاتم بن اسماعيل عن يحيي بن عبد الرحمن بهذا السند والذي نفسي بيده انه لمكتوب عند الله في السماء السابعة حمزة بن عبد المطلب اسد الله واسد رسوله واخرج ابو نعيم من طريق بن ابي فديك عن يحيي بن عبد الرحمن بهذا السند من منع يتيمه النكاح فزني فالاثم بينهما واخرج بن ابي الدنيا في كتاب القبور من وجه اخر عن يحيي بن عبد الرحمن بهذا السند ان اهل القبور يتعارفون وفيه ان ام بشر بنت البراء بن معرور جزعت عليه جزعا شديدا الحديث وقد تقدم فيمن اسمه عبد الرحمن قول الباوردي انه يحيي بن محمد بن عبد الرحمن بن ابي لبيبة وان الصحبة لعبد الرحمن بن ابي لبيبة فالله اعلم ابو لجا هو خريم بن اوس الطاءي تقدم في الاسماء ابو لقيط مولي رسول الله صلي الله عليه وسلم كان عبدا حبشيا او نوبيا بقي الي زمن عمر قال ابو عمر ذكره بعضهم في الموالي ولا اعرفه قلت ذكره محمد بن حبيب في كتاب المحبر وقال جعفر المستغفري كان عند الديوان في خلافة عمر ابو ليلي عبد الرحمن بن عمرو بن كعب تقدم ابو ليلي الانصاري والد عبد الرحمن قيل اسمه بلال وقيل بليل بالتصغير وقيل داود بن بلال وقيل اوس وقيل يسار وقيل اليسر وقيل اسمه كنيته وقال الكلبي ابو ليلي بلال بن بليل بن احيحة بن الجلال بن الحريش بن جحجبي بن كلفة بن عوف بن عمرو بن عوف بن مالك بن الاوس وقال غيره شهد احدا وما بعدها ثم سكن الكوفة وكان مع علي في حروبه وقيل انه قتل بصفين روي عن النبي صلي الله عليه وسلم روي عنه ولده عبد الرحمن وحده ووقع عند الدولابي انه روي عنه ايضا عامر بن لدين قاضي دمشق وليس كما قال فان شيخ عامر هو ابو ليلي الاشعري وحديثه في السنن فمنه عند ابي داود من رواية ثابت عن عبد الرحمن بن ابي ليلي عن ابيه صليت الي جنب النبي صلي الله عليه وسلم في صلاة تطوع فسمعته يقول اعوذ بالله من النار الحديث وعند بن ماجة والبغوي من §  <> رواية بن حبان عن عبد الرحمن عن ابيه كنت جالسا عند النبي صلي الله عليه وسلم اذا جاءه اعرابي فقال له ان لي اخا وجعا قال وما وجعه قال به لمم الحديث وعند البغوي من طريق عيسي بن عبد الرحمن بن ابي ليلي عن ابيه عن جده قال كنت عند النبي صلي الله عليه وسلم فجء بالحسن فبال عليه الحديث وعند الدارمي والحاكم من طريق قيس بن مسلم عن بن ابي ليلي عن ابيه شهدت فتح خيبر فانهزم المشركون فوقعنا في رحالهم ابو ليلي هو النابغة الجعدي تقدم ابو ليلي كني بها بعضهم عثمان بن عفان رضي الله عنه وقيل انه المراد بقول الشاعر اني اري فتنة تغلي مراجلها والملك بعد ابي ليلي لمن غلبا ابو ليلي الخزاعي ذكره بن حبان في الصحابة وتبعه جعفر المستغفري ثم ابو موسي ابو ليلي الاشعري ذكره الطبراني في الصحابة واخرج من طريق ابي عمر القيسي عن سليمان بن حبيب عن عامر بن لدين الاشعري عن ابي ليلي الاشعري قال قال رسول الله صلي الله عليه وسلم تمسكوا بطاعة اءمتكم لا تخالفوهم فان طاعتهم طاعة الله وان معصيتهم معصية الله الحديث وفيه من ولي من اموركم شيءا فعمل بغير طاعة الله فعليه لعنة الله قال ابو نعيم اظن ابا عمر القيسي محمد بن سعيد المصلوب قلت ويءيده ان ابا احمد الحاكم اخرج هذا الحديث من طريق محمد بن ابي قيس عن سليمان بن حبيب وكذا اخرجه البغوي ومحمد بن ابي قيس هو محمد بن سعيد المصلوب وهو متروك ووقع في رواية ابي احمد حدثنا ابو ليلي الاشعري صاحب رسول الله صلي الله عليه وسلم ابو ليلي صاحب النبي صلي الله عليه وسلم لم يثبت حديثه ذكره البخاري في الكني المجردة قاله ابو احمد ويجوز ان يكون هو الذي قبله ابو ليلي الغفاري ذكره ابو احمد وابن منده وغيرهما واخرجوا من طريق اسحاق بن بشر الاسدي احد المتروكين عن خالد بن الحارث عن عوف عن الحسن عن ابي ليلي الغفاري قال سمعت رسول الله صلي الله عليه وسلم يقول سيكون من بعدي فتنة فاذا كان ذلك فالزموا علي بن ابي طالب فانه اول من امن بي واول من يصافحني يوم القيامة وهو الصديق الاكبر وهو فاروق هذه الامة وهو يعسوب المءمنين والمال يعسوب المنافقين القسم الثاني خال القسم الثالث ابو ليلي عبد الله بن يزيد بن اصرم بن سعيد بن الهزم بن رويبة بن عبد الله بن هلال بن عامر بن صعصعة الهذلي تقدم في الاسماء §  <> القسم الرابع ابي اللحم الغفاري ذكره الدولابي وابن السكن في حرف اللام من كني الصحابة وتبعهما بن منده وانكر ذلك ابو نعيم فاصاب قال ابي اسم فاعل من الاباء كما تقدم وليست اداة كنية وانما لقب بذلك لانه كان لا ياكل اللحم كما تقدم في ترجمته في اول حرف الالف قال بن الاثير بعد حكاية قول ابي نعيم ذكره المعافري وتوهم انه كنيته وهو لقب لا ريب في انه ليس بكنية وان ذكره في الكني وهم قلت لكن افراد بن منده بالوهم فيه ليس بانصاف فانه قلد بن السكن وابن السكن عمدة فاللوم عليه فيه اشد منه علي بن منده حرف الميم القسم الاول ابو مالك الاشعري الحارث بن الحارث مشهور باسمه وكنيته معا ابو مالك الاشعري كعب بن عاصم مشهور باسمه وربما كني تقدما في الاسماء قال البغوي يقال له ابو مالك ابو مالك الاشعري اخر مشهور بكنيته مختلف في اسمه قيل اسمه عمرو وقيل عبيد قال سعيد البرذعي سمعت ابا بكر بن ابي شيبة يقول ابو مالك الاشعري اسمه عمرو رواه الحاكم ابو احمد وزاد غيره هو عمرو بن الحارث بن هانء وقال غيره هو الذي روي عنه عبد الرحمن بن غنم حديث المعازف ابو مالك الانصاري رافع بن مالك ابو مالك الحنظلي شريك بن طارق ابو مالك العامري ابي بن مالك ابو مالك الفزاري عيينة بن حصن ابو مالك الخثعمي عبد الله تقدموا في الاسماء ابو مالك الجعدي ذكره البغوي ولم يخرج له شيءا ابو مالك الاشجعي لا يعرف اسمه قال الحاكم ابو احمد حديثه في الحجاز وليس هو الكوفي يعني سعد بن طارق التابعي وقال ابو عمر اسمه عمرو بن الحارث بن هانء ورد عليه بان هذا قيل في ابي مالك الاشعري ابو مالك الاسلمي ذكره ابو بكر بن ابي علي واورد من طريق بن ابي زاءدة عن اسماعيل بن ابي خالد عن ابي مالك الاسلمي ان النبي صلي الله عليه وسلم رد ماعزا ثلاث مرات فلما جاء في الرابعة امر به فرجم استدركه ابو موسي وذكر بن حزم هذا الحديث فقال ابو مالك لا اعرفه قلت وهو عند النساءي من طريق سلمة بن كهيل عن ابي مالك عن رجل من الصحابة §  <> ابو مالك القرظي والد ثعلبة ذكره الواقدي وقال انه قدم من اليمن وهو علي دين اليهودية فتزوج امراة من قريظة فانتسب فيهم وهو من كندة وقيل اسمه عبد الله وذكر الحاكم ابو احمد عن البخاري قال قال ابراهيم بن المنذر حدثني اسحاق بن جعفر عمن سمع عبد الله بن جعفر عن يزيد بن الهاد عن ثعلبة بن ابي مالك ان عمر دعا الاجناد فدعا ابا مالك ورواه الواقدي عن عثمان بن الضحاك عن بن الهاد عن ثعلبة ان عمر سال ابا مالك وكان من علماء اليهود عن صفة النبي صلي الله عليه وسلم في التوراة فقال صفته في كتاب بني هارون الذي لم يبدل ولم يغير احمد من ولد اسماعيل ياتي بدين الحنيفية دين ابراهيم ياتزر علي وسطه ويغسل اطرافه وهو اخر الانبياء فذكر الحديث بطوله ابو مالك النخعي قال بن السكن يقال له صحبة واورد من طريق صفوان بن عمر عن شريح بن عبيد ان ابا مالك النخعي لما حضرته الوفاة قال يا معشر النخع ليبلغ الشاهد منكم الغاءب اني سمعت رسول الله صلي الله عليه وسلم يقول حلوة الدنيا مرة الاخر ومرة الدنيا حلوة الاخرة ابو مالك العبدي اخرج حديثه ابو جعفر الطبري من طريق داود بن ابي هند عن ابي قزعة سويد بن حجير عن رجل في تفسير قوله تعالي سيطوقون ما بخلوا به يوم القيامة الحديث ومن طريق اخري عن ابي قزعة مرسلا ومن طريق اخري عن داود عن ابي قزعة عن ابي مالك العبدي به واخرجه الثعلبي من هذا الوجه لكن قال عن رجل من قيس وابو قزعة تابعي بصري مشهور لكنه كان يرسل عن الصحابة فهو علي الاحتمال ابو مالك غير منسوب ذكره بن منده وقال نزل مصر مجهول ثم اورد من طريق عبد الرحيم بن زيد العمي وهو متروك عن ابيه وهو ضعيف عن ابي مالك قال قال رسول الله صلي الله عليه وسلم من بلغ في الاسلام ثمانين سنة حرم الله عليه النار وكان في الدرجات العلاء ابو مالك غير منسوب ذكره بن منده فقال روي عنه سنان بن سعد قاله لي ابو سعيد بن يونس ثم اورد بن منده من طريق بن اسحاق عن يزيد بن ابي حبيب عن سنان بن سعد عن ابي مالك قال سءل النبي صلي الله عليه وسلم عن اطفال المشركين فقال هم خدام اهل الجنة قال ابو نعيم المعروف عن يزيد عن سنان عن انس بن مالك قلت وهو كذلك ولكن قول ابي سعيد بن يونس لا يرد بهذا لان هذا الحديث لم يتعين انه مراد ابي سعيد بن يونس ابو مالك غير منسوب ذكره المستغفري في الصحابة واخرج من طريق هشام بن الغاز بن ربيعة عن ابيه عن جده انه قال يا اهل دمشق ليكونن فيكم الخسف والمسخ والقذف قالوا وما يدريك يا ربيعة قال هذا ابو مالك صاحب رسول الله صلي الله عليه وسلم فسلوه وكان قد نزل عليه فاتوه فقالوا ما يقول ربيعة قال سمعته من رسول الله صلي الله عليه وسلم يقول يكون في امتي فذكره واستدركه ولا يبعد انه هو ابو مالك الاشعري ابو المجبر بالجيم او المهملة قال يحيي بن عبد الحميد الحماني في مسنده حدثنا مبارك بن سعيد الثوري عن جليد الثوري عن ابي المجبر قال قال رسول الله صلي الله عليه وسلم من عال ابنتين او ابنين §  <> او عمتين او جدتين فهو معي في الجنة كهاتين وضم رسول الله صلي الله عليه وسلم اصبعيه السبابة والتي جنبها فان كن ثلاثا فهو مفرح وان كن اربعا او خمسا فيا عباد الله ادركوه اقرضوه ضاربوه واخرجه مطين في الصحابة عن الحماني والطبراني عن مطين وابو موسي من طريقه واخرج من طريق الحسن بن عرفة عن المبارك بهذا السند حديثا اخر ابو مجزاة الاسلمي هو ازهر والد مجزاة مشهور باسمه وتقدم ووقع في مسند بقي بكنيته ابو مجيبة بضم اوله وكسر الجيم وبموحدة ذكره بن حبان في الصحابة وقال ابو عمر لا اعرفه وقال البغوي ابو مجيبة او عمها سكن البصرة قلت هو والد مجيبة الباهلي او الباهلية وقع عند بن ماجة عن مجيبة الباهلي عن ابيه وعند بن ابي داود مجيبة الباهلية عن ابيها وافاد البغوي ان اسم والد مجيبة عبد الله بن الحارث والصواب ان مجيبة امراة فقد وقع عند سعيد بن منصور عن بن علية عن الجريري عن ابي سليل عن مجيبة الباهلية عجوز من قومها ابو محجن الثقفي الشاعر المشهور مختلف في اسمه فقيل هو عمرو بن حبيب بن عمرو بن عمير بن عوف بن عقدة بن غيرة بن عوف بن ثقيف وقيل اسمه كنيته وكنيته ابو عبيد وقيل اسمه مالك وقيل اسمه عبد الله وامه كنود بنت عبد الله بن عبد شمس قال ابو احمد الحاكم له صحبة قال ويخيل الي انه صاحب سعد بن ابي وقاص الذي اتي به اليه وهو سكران فان يكن هو فان اسمه مالك ثم ساق من طريق ابي سعد البقال عن ابي محجن قال اشهد علي رسول الله صلي الله عليه وسلم انه قال اخاف علي امتي من بعيد ثلاثة تكذيب بالقدر وتصديق بالنجوم وذكر الثالثة واخرجه ابو نعيم من هذا الوجه فقال في الثالثة وحيف الاءمة وابو سعد ضعيف ولم يدرك ابا محجن وقال ابو احمد الحاكم الدليل علي ان اسمه مالك ما حدثنا ابو العباس الثقفي حدثنا زياد بن ايوب حدثنا ابو معاوية حدثنا عمرو بن المهاجر عن ابراهيم بن محمد بن سعد عن ابيه قال لما كان يوم القادسية اتي سعد بابي محجن وهو سكران من الخمر فامر به فقيد وكان بسعد جراحة فاستعمل علي الخيل خالد بن عرفطة وصعد سعد فوق البيت لينظر ما يصنع الناس فجعل ابو محجن يتمثل كفي حزنا ان ترتدي الخيل بالقنا واترك مشدودا علي وثاقيا ثم قال لامراة سعد وهي بنت خصفة ويلك خليني فلك الله علي ان سلمت ان اجء حتي اضع رجلي في القيد وان قتلت استرحتم مني فخلته ووثب علي فرس لسعد يقال لها البلقاء ثم اخذ الرمح وانطلق حتي اتي الناس فجعل لا يحمل في ناحية الا هزمهم الله فجعل الناس يقولون هذا ملك وسعد ينظر فجعل يقول الضبر ضبر البلقاء والطفر طفر ابي محجن وابو محجن في القيد فلما هزم العدو رجع ابو محجن حتي وضع رجله في القيد فاخبرت بنت خصفة سعدا بالذي كان من امره فقال لا والله لا احد اليوم رجلا ابلي الله المسلمين علي يديه ما ابلاهم قال فخلي سبيله فقال ابو محجن لقد كنت اشربها اذ كان يقام علي الحد اطهر منها فاما اذا بهرجتني فوالله لا اشربها ابدا قلت استدل ابو احمد رحمه الله بان اسمه مالك بما وقع في هذه القصة من قول الناس هذا ملك وليس هذا نصا فيما اراد بل الظاهر انهم ظنوه ملكا من الملاءكة ويءيد هذا الظاهر ان ابا بكر بن ابي شيبة اخرج هذه القصة عن ابي معاوية بهذا السند وفيها انهم ظنوه ملكا من §  <> الملاءكة وقوله في القصة الضبر ضبر البلقاء هو بالضاد المعجمة والباء الموحدة عدو الفرس ومن قال بالصاد المهملة فقد صحف نبه علي ذلك بن فتحون في اوهام الاستيعاب واسم امراة سعد المذكورة سلمي ذكر ذلك سيف في الفتوح وسماها ابو عمر ايضا وساق القصة مطولة وزاد في الشعر ابياتا اخري وفي القصة فقاتل قتالا عظيما وكان يكبر ويحمل فلا يقف بين يديه احد وكان يقصف الناس قصفا منكرا فعجب الناس منه وهم لا يعرفونه واخرج عبد الرزاق بسند صحيح عن بن سيرين كان ابو محجن الثقفي لا يزال يجلد في الخمر فلما اكثر عليهم سجنوه واوثقوه فلما كان يوم القادسية راهم يقتتلون فذكر القصة بنحو ما تقدم لكن لم يذكر قول المسلمين هذا ملك بل فيه ان سعدا قال لولا اني تركت ابا محجن في القيد لظننتها بعض شماءله وقال في اخر القصة فقال لا اجلدك في الخمر ابدا فقال ابو محجن وانا والله لا اشربها ابدا قد كنت انف ان ادعها من اجل جلدكم فلم يشربها بعد وذكر المداءني عن ابراهيم بن حكيم عن عاصم بن عروة ان عمر غرب ابا محجن وكان يدمن الخمر فامر ابا جهراء البصري ورجلا اخر ان يحملاه في البحر فيقال انه هرب منهما واتي العراق ايام القادسية وذكر ابو عمر نحوه وزاد ان عمر كتب الي سعد بان يحبسه فحبسه وذكر بن الاعرابي عن بن داب ان ابا محجن هوي امراة من الانصار يقال لها شموس فحاول النظر اليها فلم يقدر فاجر نفسه من بناء يبني بيتا بجانب منزلها فاشرف عليها من كوة فانشد ولقد نظرت الي الشموس ودونها حرج من الرحمن غير قليل فاستعدي زوجها عمر فنفاه وبعث معه رجلا يقال له ابو جهراء كان ابو بكر يستعين به فذكر القصة وفيها ان ابا جهراء راي من ابي محجن سيف فهرب منه الي عمر فكتب عمر الي سعد يامره بسجنه فسجنه فذكر قصته في القتل في القادسية وقال عبد الرزاق عن بن جريج بلغني ان عمر بن الخطاب حد ابا محجن بن حبيب بن عمرو بن عمير الثقفي في الخمر سبع مرات وقيل دخل ابو محجن علي عمر فظنه قد شرب فقال استنكهوه فقال ابو محجن هذا التجسس الذي نهيت عنه فتركه وذكر بن الاعرابي عن الفضل الضبي قال قال ابو محجن في تركه شرب الخمر رايت الخمر صالحة وفيها مناقب تهلك الرجل الحليما فلا والله اشربها حياتي ولا اشفي بها ابدا سقيما وذكر بن الكلبي عن عوانة قال دخل عبيد بن ابي محجن علي عبد الملك بن مروان فقال ابوك الذي يقول اذا مت فادفني الي جنب كرمة تروي عظامي بعد موتي عروقها فذكر قصته واوردها بن الاثير بلفظ قيل ان ابنا لابي محجن دخل علي معاوية فقال له ابوك الذي يقول فذكر البيت وبعده ولا تدفنني بالفلاة فانني اخاف اذا ما مت ان لا اذوقها قال لو شءت لقلت احسن من هذا من شعره قال وما ذاك قال قوله لا تسال الناس عن مالي وكثرته وساءل الناس عن حزمي وعن خلقي §  <> اليوم اعلم اني من سراتهم اذا تطيش يد الرعديدة الفرق قد اركب الهول مسدولا عساكره واكتم السر فيه ضربة العنق اعطي السنان غداة الروع حصته وعامل الرمح ارويه من العلق عف المطالب عما لست ناءله وان طلبت شديد الحقد والحنق قد يعسر المرء حينا وهو ذو كرم وقد يسوم سواء العاجز الحمق سيكثر المال يوما بعد قلته ويكتسي العود بعد اليبس بالورق فقال معاوية لءن كنا اسانا القول لنحسنن الفعل واجزل صلته وقد عاب بن فتحون ابا عمر علي ما ذكره في قصة ابي محجن انه كان منهمكا في الشراب فقال كان يكفيه ذكر حده عليه والسكوت عنه اليق والاولي في امره ما اخرجه سيف في الفتوح ان امراة سعد سالته فيم حبس فقال والله ما حبست علي حرام اكلته ولا شربته ولكني كنت صاحب شراب في الجاهلية فند كثيرا علي لساني وصفها فحبسني بذلك فاعلمت بذلك سعدا فقال اذهب فما انا بمءاخذك بشء تقوله حتي تفعله قلت سيف ضعيف والروايات التي ذكرناها اقوي واشهر وانكر بن فتحون قول من روي ان سعدا ابطل عنه الحد وقال لا يظن هذا بسعد ثم قال لكن له وجه حسن ولم يذكر وكانه اراد ان سعدا اراد بقوله لا يجلده في الخمر بشرط اضمره وهو ان ثبت عليه انه شربها فوفقه الله ان تاب توبة نصوحا فلم يعد اليها كما في بقية القصة قال قيل ان ابا محجن مات باذربيجان وقيل بجرجان ابو محذورة المءذن اسمه اوس ويقال سمرة بن معير بكسر اوله وسكون المهملة وفتح التحتانية المثناة وهذا هو المشهور وحكي بن عبد البر ان بعضهم ضبطه بفتح العين وتشديد التحتانية المثناة بعدها نون بن ربيعة بن معير بن عريج بن سعد بن جمح قال البلاذري الاثبت انه اوس وجزم بن حزم في كتاب النسب بان سمرة اخوه وخالف ابو اليقظان في ذلك فجزم بان اوس بن معير قتل يوم بدر كافرا وان اسم ابي محذورة سلمان بن سمرة وقيل سلمة بن معير وقيل اسم ابي محذورة معير بن محيريز وحكي الطبري ان اسم اخيه الذي قتل ببدر انيس وقال ابو عمر اتفق الزبير وعمه وابن اسحاق والمسيبي علي ان اسم ابي محذورة اوس وهم اعلم بانساب قريش ومن قال ان اسمه سلمة فقد اخطا وروي ابو محذورة عن رسول الله صلي الله عليه وسلم انه علمه الاذان وقصته بذلك في صحيح مسلم وغيره وفي رواية همام عن بن جريج ان تعليمه اياه كان بالجعرانة وقال بن الكلبي لم يهاجر ابو محذورة بل اقام بمكة الي ان مات بعد موت سمرة بن جندب وقال غيره مات سنة تسع وخمسين وقيل سنة تسع وسبعين ابو محصن الاشعري هو عكاشة بن محصن تقدم في الاسماء ابو محمد الانصاري ذكره مالك في الموطا من طريق عبد الله بن محيريز عن المذحجي ان رجلا كان بالشام يكني ابا محمد كانت له صحبة قال الوتر واجب وذكر له قصة مع عبادة بن الصامت واخرجه ابو داود وغيره من طريق مالك قيل اسمه مسعود بن اوس بن زيد بن اصرم وقيل مسعود بن زيد بن سبيع وقيل اسمه قيس بن عامر بن عبد بن الحارث الخولاني حليف بني حارثة من الاوس وقيل مسعود §  <> بن يزيد عداده في الشاميين وسكن داريا وقيل اسمه سعد بن اوس وقيل قيس بن عباية وقال بن يونس شهد فتح مصر وقال بن سعد مات في خلافة عمر وزعم بن الكلبي انه شهد مع علي صفين وفي كتاب قيام الليل لمحمد بن نصر من طريق عبد الله بن محيريز عن ابي رفيع قال تذاكرنا الوتر فقال رجل من الانصار يكني ابا محمد من الصحابة ابو محمد طلحة بن عبيد الله التيمي وعبد الرحمن بن عوف الزهري وجبير بن مطعم وعبد الله بن زيد بن ثعلبة بن عبد ربه صاحب الاذان وعبد الله بن زيد بن عاصم راوي حديث الوضوء وعبد الله بن بحينة الازدي وحاطب بن ابي بلتعة وثابت بن قيس بن شماس الانصاري وكعب بن عجرة البلوي وحمزة بن عمرو الاسلمي وفضالة بن عبيد الانصاري وحويطب بن عبد العزي القرشي وعبد الله بن ابي حدرد الاسلمي وعبد الرحمن بن يزيد بن حارثة وعبد الله بن مخرمة العامري والاشعث بن قيس الكندي ومحمود بن الربيع الانصاري وعبد الله بن عمرو بن العاص في قول تقدموا كلهم في الاسماء ابو محرث اسمه خالد تقدم ابو مخارق والد قابوس ذكر في قابوس في القاف ابو مخشي الطاءي حليف بني اسد كان من المهاجرين الاولين وممن شهد بدرا ويقال ان اسمه سويد بن مخشي ذكره بن سعد عن ابي حبيبة ويقال بن عدي ذكره عن ابي معشر ويقال زيد بن مخشي ويقال بن حمير ابو مخشي اخر فرق عبد الله بن محمد بن عمارة بينه وبين الذي قبله فقال في الاول اسمه زيد بن حمير شهد بدرا لا شك فيه وقال في الثاني اسمه سويد بن مخشي شهد احدا ولم يشهد بدرا حكاه بن سعد وجزم بن سعد بان زيد بن حمير يكني ابا مخشي وقد تقدمت ترجمته في حرف القاف ابو مدينة الدارمي عبد الله بن محصن تقدم في الاسماء ابو مذكر الراقي له ذكر في حديث ضعيف اخرجه الترمذي الحكيم في نوادر الاصول في الاصل الثالث والثمانين من طريق العرزمي احد الضعفاء عن ابي الزبير عن جابر قال كان بالمدينة رجل يكني ابا مذكر يرقي من العقرب فينفع الله بذلك فقال النبي صلي الله عليه وسلم يا ابا مذكر ما رقيتك هذه اعرضها علي فقال شجنة قرنية ملحة بحر قفطا فقال رسول الله صلي الله عليه وسلم لا باس بهذا وهذه مواثيق اخذها سليمان بن داود علي الهوام قال الحكيم ذكر لنا انها بلغة حمير ثم اسند من طريق مغيرة عن ابراهيم عن الاسود قال كلمات بالحميرية ابو مذكور الانصاري ثبت ذكره في حديث بيع المدبر اخرجه مسلم من طريق ايوب عن ابي الزبير عن جابر وجاء في ساءر الروايات غير مسمي ابو المرازم يعلي بن مرة الثقفي تقدم ابو مرازم اخر ذكره الدولابي في الكني ولم يذكر له اسما ابو مراوح الليثي قال ابو داود له صحبة وذكره بن منده وعزاه لابي داود وسماه §  <> واقد بن ابي واقد وهو غير ابي مراوح الغفاري فيرد علي المزي حيث قال في ترجمة الغفاري الليثي فجعلهما واحدا ابو مرثد الغنوي كناز بن الحصين ويقال حصين بن كناز وقيل اسمه ايمن قال البغوي كناز بن الحصين ويقال بن حصن والمشهور الاول وحكي بن ابي خيثمة عن ابيه وعن احمد بن حنبل الثاني قال البغوي وفي كتاب بن اسحاق كناز بن حصن بن يربوع بن عمرو بن خرشة بن سعد بن طريف بن جلان بن غنم بن غني بن يعصر بن سعد بن قيس بن غيلان بن مضر ابو مرثد الغنوي سكن الشام وروي عن النبي صلي الله عليه وسلم حديثا ذكره موسي بن عقبة وابن اسحاق فيمن شهد بدرا وقال الزهري ابو مرثد وابنه مرثد حليفان لحمزة وحديثه عند مسلم والبغوي وغيرهما من طريق بشر بن عبيد الله عن واثلة بن الاسقع انه سمعه يقول وهو في المقبرة سمعت ابا مرثد الغنوي صاحب رسول الله صلي الله عليه وسلم يقول سمعت رسول الله صلي الله عليه وسلم يقول لا تجلسوا علي القبور ولا تصلوا اليها ابو مرحب سويد بن قيس وابو مرحب محمد بن صفوان تقدما ابو مرحب اخر تقدم في مرحب ابو مرة الطاءفي ذكره مطين في الصحابة وله رواية عن النبي صلي الله عليه وسلم روي عنه مكحول قال البغوي سكن الطاءف ثم اخرج هو واحمد والنساءي من طريق سعيد بن عبد العزيز عن مكحول عن ابي مرة الطاءفي سمعت النبي صلي الله عليه وسلم يقول قال الله يعجز بن ادم ان يصلي اول النهار اربع ركعات اكفه اخره قال البغوي لا اعلمه الا من رواية سعيد بن عبد العزيز عن مكحول قلت هذه رواية يحيي بن اسحاق عن سعيد عن مكحول عن كثير بن مرة عن نعيم بن همام وهو المحفوظ اخرجه النساءي ابو مرة بن عروة بن مسعود الثقفي قال ابو عمر له ولابيه صحبة وقال ايضا ولد علي عهد النبي صلي الله عليه وسلم وقال الواقدي خرج ابو مرة وابو المليح ابنا عروة بن مسعود الي النبي صلي الله عليه وسلم فاعلماه بقتل ابيهما واسلما ولابي مرة بنت اسمها ليلي تزوجها الحسن بن علي وامها ميمونة بنت ابي سفيان بن حرب وفيها يقول الحارث بخالد المخزومي اطافت بنا شمس النهار ومن راي من الناس شمسا في المساء تطوف ابو امها اوفي قريش بذمة واعمامها اما سالت ثقيف ابو مرة غير منسوب ذكره الدولابي في الكني من طريق ابي حمزة السكري عن جابر هو بن يزيد الجعفي احد الضعفاء عن يزيد بن مرة عن جده قال كان رسول الله صلي الله عليه وسلم اذا ضحك وضع يده علي فمه ابو مرة مولي العباس تقدم في ابي حلوة ابو مروان الاسلمي اسمه معتب بن عمرو وقيل سعد وقيل عبد الرحمن بن مصعب روي عن عمر وعلي وابي ذر وابي معتب بن عمر وكعب الاحبار وغيرهم وقيل ان له صحبة ذكره §  <> في الصحابة وسماه معتب بن عمرو كما تقدم في حرف الميم وله قصة مع عمر قال بن ابي شيبة حدثنا وكيع عن عيسي بن حفص عن عطاء بن ابي مروان عن ابيه خرجنا مع عمر نستسقي فذكر بعضه ابو مريم الجهني عمرو بن مرة تقدم في الاسماء ابو مريم الجهني اخر ويحتمل ان يكون الاول ذكره الزبير بن بكار في اخبار المدينة من طريق خارجة بن رافع الجهني قال جاء رسول الله صلي الله عليه وسلم يعود رجلا من اصحابه من جهينة من بني الربعة يقال له ابو مريم فعاده بين منزل بني قيس العطار الذي فيه الاراكة وبين منزلهم الاخر الذي في دور الانصار فصلي في ذلك المنزل فقال نفر من جهينة لابي مريم لو لحقت برسول الله صلي الله عليه وسلم فسالته ان يخط لنا مسجدا فلحقه فقال ما لك يا ابا مريم قال لو خططت لقومي مسجدا قال فجاء فخط لهم مسجدهم في بني جهينة ابو مريم السلولي هو مالك بن ربيعة تقدم في الاسماء ابو مريم الكندي ذكره البغوي ولم يخرج له شيءا وذكره بن السكن في الصحابة وقال ابو احمد الحاكم له صحبة وحديثه في اهل الشام وليس هو الغساني ثم ساق من طريق اسماعيل بن عياش عن صفوان بن عمرو عن جحر بن مالك عن ابي مريم الكندي عن النبي صلي الله عليه وسلم انه اتي بضب وهو يسير فوضعه علي بسطة الرحل فنحزه بقضيب كان معه فتناول الضب القضيب بيده فقال النبي صلي الله عليه وسلم الا ان هذا واشباهه كانوا امما من الامم فعصوا الله فجعلهم خشاشا من خشاش الارض اسناده ضعيف ابو مريم الغساني جد ابي بكر بن ابي مريم وقال بن السكوني ابو مريم الازدي واخرج هو وابو احمد الحاكم وابن منده من طريق بقية عن ابي بكر بن ابي مريم عن ابيه عن جده قال اتيت النبي صلي الله عليه وسلم فقلت يا رسول الله انه ولدت لي الليلة جارية قال والليلة انزلت علي سورة مريم فسمها مريم فكان يكني ابا مريم ابو مريم الفلسطيني الازدي ذكره الطبري واخرج من طريق الوليد بن مسلم عن يزيد بن ابي مريم عن القاسم بن مخرمة عن ابي مريم الفلسطيني وكان من اصحاب النبي صلي الله عليه وسلم وقال البغوي ابو مريم سكن فلسطين وفد علي النبي صلي الله عليه وسلم يقال له عمرو بن مرة الجهني واخرج ابو داود في كتاب الخراج من السنن والترمذي من طريق يحيي بن حمزة عن يزيد بهذا الاسناد فقالا عن ابي مريم الازدي قال سمعت رسول الله صلي الله عليه وسلم يقول من ولي من امور الناس شيءا فاحتجب عن خلتهم وحاجتهم احتجب الله عن خلته وحاجته وفاقته قال فجعل معاوية رجلا علي الحواءج الناس واخرجه البغوي من طريق الوليد بن مسلم عن يزيد واخرج بن ابي عاصم وسمويه والطبراني في مسند الشاميين من طريق صدقة بن خالد عن يزيد عن رجل من اهل فلسطين يكني ابا مريم وفي رواية الطبراني عن رجل من بني الازد وترجم له بن ابي عاصم ابو مريم السكوني واظن قوله السكوني وهما وذكر الترمذي عن البخاري ان صاحب هذا الحديث هو عمرو بن مرة الجهني §  <> واورد الترمذي من طريق علي بن الحكم عن الحسن قال قال عمرو بن مرة لمعاوية اني سمعت رسول الله صلي الله عليه وسلم يقول من اغلق بابه فذكر الحديث بنحوه وقال غريب ويروي من غير وجه عن عمرو بن مرة وذكر البخاري انه عمرو بن مرة الجهني وكانه سلف البغوي في ذلك وفيه نظر فان سند الحديثين مختلف وكذا سياق المتن وقد جزم غير واحد بانه غيره وقال بن عساكر ابو مريم الازدي من الصحابة قدم دمشق علي معاوية وروي حديثا واحدا وساقه من طريق محمد بن شعيب بن سابور عن ابي المعطل مولي بني كلاب وكان قد ادرك معاوية قال قدم رجل من الصحابة يقال له ابو مريم غازيا فذكر قصته مع معاوية وزاد فقال معاوية ادعوا لي سعدا يعني حاجبه فقال اللهم اني اخلع هذا من عنقي واجعله في عنق سعد من جاء يستاذن علي فاءذن له يقضي الله علي لساني ما شاء واخرجه في ترجمة ابي المعطل من طريق الطبراني في الاوسط عن ابراهيم بن دحيم عن ابيه عن محمد بن شعيب وقال في اخره كان ابو المعطل من الثقات قال بن عساكر فرق بن سميع بين ابي مريم هذا وبين عمرو بن مرة واما قول بن ابي عاصم انه سكوني فلا يثبت وابو مريم السكوني اخر تابعي معروف يروي عن ثوبان وعنه عبادة بن نسي ذكره البخاري وغيره وهذا قد صرح بسماعه من النبي صلي الله عليه وسلم ابو المساكين هو جعفر بن ابي طالب كناه بها النبي صلي الله عليه وسلم لانه كان يلازمهم ابو مسعود البدري هو عقبة بن عمرو معروف باسمه وكنيته تقدم ابو مسعود بن مسعود الغفاري اسمه عبد الله وقيل عروة ولا يجء في الرواية الا غير مسمي ياتي في بن مسعود في المبهمات ابو مسلم اهبان بن صيفي الغفاري ابو مسلم اياس بن سلمة الاسلمي تقدما في الاسماء ابو مسلم الجليلي بالجيم ويقال الجلولي بالواو ياتي في القسم الثالث ابو مسلم الخزاعي ذكره الدولابي في الكني وقال له صحبة ابو مسلم المرادي سكن مصر ذكره بن يونس في تاريخها وقال له صحبة وكان علي شرطة مصر لعمرو بن العاص وقال البغوي وابن السكن له صحبة واوردا من طريق سويد بن ابي حاتم عن عبد الله بن عياش عن عمرو بن يزيد عن ابي مسلم رجل من اصحاب النبي صلي الله عليه وسلم ان رجلا قال يا رسول الله اخبرني بعمل يدخلني الجنة قال احية والدتك فتبرها قال ليس لي والدة قال فاطعم الطعام واطب الكلام قال البغوي لم يثبت ابو مصبح الهرمي مولي صفوان بن المعطل قال ابو علي الهجري في النوادر له صحبة ابو مصرف روي طلحة بن مصرف عن ابيه عن جده مختلف في اسم جده قيل كعب وقيل عمرو ذكره البغوي في الكني ابو مصعب الاسلمي تقدم في مصعب §  <> ابو مطرف سليمان بن صرد الخزاعي تقدم ابو معاذ رفاعة بن رافع الانصاري تقدم ابو معاوية الدءلي نوفل بن معاوية تقدم ابو معبد بن حزن بن ابي وهب المخزومي عم سعيد بن المسيب له ولاخيه المسيب صحبة وذكره الزبير بن بكار في كتاب النسب ابو معبد الخزاعي زوج ام معبد ذكره بن الاثير وقال تقدم في حبيش والذي تقدم في حبيش انما وصف بانه اخو ام معبد واما زوجها فلم يسم وقد ترجم بن منده لمعبد بن ابي معبد ولم يسم اباه واورد قصة ام معبد من روايته واخرج البخاري في التاريخ وابن خزيمة في صحيحه والبغوي قصة ام معبد من طريق الحر بن الصباح النخعي عن ابي معبد الخزاعي قال خرج رسول الله صلي الله عليه وسلم لما هاجر من مكة الي المدينة هو وابو بكر وعامر بن فهيرة مولي ابي بكر ودليلهم عبد الله بن اريقط الليثي فمروا بخيمة ام معبد وفي اخره عند البغوي قال عبد الملك بلغني ان ام معبد هاجرت واسلمت قال البخاري هذا مرسل وابو معبد مات قبل النبي صلي الله عليه وسلم ابو معتب بن عمرو الاسلمي والد ابي مروان المتقدم قريبا ذكره بن منده وقال ذكره ابو حاتم في الصحابة ولا يثبت ثم اورد من طريق بن اسحاق حدثني من لا اتهمه عن عطاء بن ابي مروان عن ابيه عن ابي معتب ان رسول الله صلي الله عليه وسلم لما اشرف علي خيبر قال لاصحابه وانا فيهم قفوا ندعو الله اللهم رب السماوات السبع وما اظللن ورب الارضين وما اقللن ورب الشياطين وما اظللن الحديث وذكر الواقدي في الردة عن صدقة بن عتبة الاسلمي عن عطاء بن ابي مروان عن ابيه عن جده ابي معتب قال كنت فيمن صالح اهل البحرين فصالح الاشعث زياد بن لبيد علي ان يءمن سبعين رجلا منهم واختلف في ضبطه فقيل بالمهملة والمثناة الثقيلة واخره موحدة وقيل بالمعجمة المكسورة واخره مثلثة وبالاول جزم بن عبد البر تبعا للواقدي وبالثاني بن ماكولا تبعا للطبري ابو معدان جد خالد بن معدان ذكره الدولابي في الكني وذكره غيره في المبهمات ابو معقل الاسدي ويقال الانصاري اسمه الهيثم كما تقدم التنبيه عليه في حرف الهاء ويقال انه انصاري حالف بني اسد ويقال بل هو اسدي حالف الانصار وهو الهيثم بن نهيك بن اساف بن عدي بن زيد بن جشم بن حارثة ويقال انه شهد احدا ويقال انه مات في حجة الوداع قال بن منده له صحبة روي حديثه الاعمش عن عمارة بن عمير وجامع بن شداد عن ابي بكر بن عبد الرحمن بن الحارث عنه انه جاء الي النبي صلي الله عليه وسلم فقال ان ام معقل جعلت عليه حجة الحديث هذه رواية النساءي واخرجه ابو داود من طريق الاعمش وزاد محمد بن عبد الله بن زكريا بن حيوة احد رواة السنن عن النساءي قال ابو معقل اسمه الهيثم واخرجه بن منده من طريق ابي عوانة عن ابراهيم بن مهاجر عن ابي بكر بن عبد الرحمن قال اخبرني رسول مروان الذي ارسله الي ام معقل قال تهيا ابو معقل حاجا مع رسول الله صلي الله عليه وسلم فقالت ام معقل قد علمت ان علي حجة وان لابي §  <> معقل بكرا قال ابو معقل صدقت جعلته في سبيل الله قال فلتحج عليه فانه في سبيل الله فاعطاها البكر فقالت يا رسول الله اني قد كبرت وسقمت فهل من عمل يجزي عني من حجتي قال عمرة في رمضان تعدل حجة واخرجه بن منده عاليا من رواية محاضر بن الموزع عن الاعمش فقال فيه جاء معقل او ابو معقل واخرجه النساءي من طريق الزهري عن ابي بكر بن عبد الرحمن عن امراة من بني اسد يقال لها ام معقل به واخرج الترمذي حديث عمرة في رمضان تعدل حجة من طريق اسراءيل عن ابي اسحاق عن الاسود عن بن ابي معقل عن ام معقل واخرجه بن ماجة من طريق ابي شيبة عن ابي اسحاق عن الاسود عن ابي معقل وابو شيبة ضعيف لكن تابعه شريك عن ابي اسحاق اخرجه بن السكن من طريقه وابو نعيم من طريق مطين عن شيخ له عن شريك قال بن منده ورواية اسراءيل عن ابي اسحاق عن الاسود عن ابي معقل عن ام معقل ورواه غيره عن ابي اسحاق عن عيسي بن معقل عن يوسف بن عبد الله بن سلام عن جدته ام معقل ورواه موسي بن عقبة عن عيسي بن معقل عن جدته ولم يذكر يوسف ورواه مسلم بن خالد عن جعفر بن محمد عن ابيه عن ام معقل ورواه ابراهيم بن محمد عن محمد بن اسحاق عن يحيي بن عباد عن الحارث بن عبد الرحمن بن الحارث عن ابيه عن ام معقل وله طريق اخري من رواية ابي سلمة بن عبد الرحمن عن معقل عن امه تقدمت في ترجمة معقل بن ام معقل في اسماء الرجال ابو معقل غير منسوب ذكر ابراهيم بن عبد الله الخزاعي في الكني انه هو الذي روي حديث النهي عن استقبال القبلتين حكي ذلك الحاكم ابو احمد والحديث المذكور عند ابي داود وغيره من حديث معقل بن ابي معقل وقد تقدم بيانه في الاسماء هل هو ولد ابي معقل الذي ذكره قبله او اخره ابو معقل بن نهيك بن اساف الانصاري تقدم ذكره في ترجمة ابنه عبد الله بن ابي معقل وقال ابو عمر يقال انه ابو معقل الاسدي الذي روي حديث عمرة في رمضان يعني الذي يسمي الهيثم وغاير غيره بينهما ابو معلق الانصاري استدركه ابو موسي واخرج من طريق بن الكلبي عن الحسن عن ابي بن كعب ان رجلا كان يكني ابا معلق الانصاري خرج في سفرة من اسفاره فذكر قصة له مع اللص الذي اراد قتله قال ابو موسي اوردته بتمامه في كتاب الوظاءف قلت ورويناه في كتاب مجابي الدعوة لابن ابي الدنيا قال حدثنا عيسي بن عبد الله النهمي اخبرني فهر بن زياد الاسدي عن موسي بن وردان عن الكلبي وليس بصاحب التفسير عن الحسن عن انس بن مالك قال كان رجل من اصحاب رسول الله صلي الله عليه وسلم يكني ابا معلق وكان تاجرا يتجر بمال له ولغيره وكان له نسك وورع فخرج مرة فلقيه لص متقنع في السلاح فقال ضع متاعك فاني قاتلك قال شانك بالمال قال لست اريد الا دمك قال فذرني اصل قال صل ما بدا لك فتوضا ثم صلي فكان من دعاءه يا ودود يا ذا العرش المجيد يا فعالا لما يريد اسالك بعزتك التي لا ترام وملكك الذي لا يضام وبنورك الذي ملا اركان عرشك ان تكفيني شر هذا اللص يا مغيث اغثني قالها ثلاثا فاذا هو بفارس بيده حربة رافعها بين اذني فرسه فطعن اللص فقتله ثم اقبل §  <> علي التاجر فقال من انت فقد اغاثني الله بك قال اني ملك من اهل السماء الرابعة لما دعوت سمعت لابواب السماء قعقعة ثم دعوت ثانيا فسمعت لاهل السماء ضجة ثم دعوت ثالثا فقيل دعاء مكروب فسالت الله ان يوليني قتله ثم قال ابشر واعلم انه من توضا وصلي اربع ركعات ودعا بهذا الدعاء استجيب له مكروبا كان او غير مكروب ابو المعلي بن لوذان الانصاري روي عن النبي صلي الله عليه وسلم روي عنه ان النبي صلي الله عليه وسلم خطب يوما فقال ان رجلا خيره الله الحديث اخرجه الترمذي واحمد وابو يعلي والبغوي من طريق ابي عوانة عن عبد الملك بن عمير عن بن ابي المعلي رجل من الانصار قال ابو عمر لا يعرف اسمه عند اكثر العلماء وقيل اسمه زيد بن المعلي وقال البغوي سكن الكوفة واخرجه احمد وابو يعلي في مسند ابي سعيد المعلي وذكر بن عساكر انه خطا قلت واختلف فيه علي عبد الملك فرواه عبيد الله بن عمرو عنه عن ابي المعلي عن ابيه وهذا عكس ما رواه ابو عوانة اخرجه الطبراني وقال غيرهما عن عبد الملك عن بن المعلي عن ابيه وهذا كرواية ابي عوانة لكنه سقطت منه اداة الكنية والله اعلم ابو المعلي السلمي يقال هو جد ابي الاسد السلمي له حديث في الاضحية ذكره ابو موسي عن الحسن بن احمد السمرقندي ابو معمر غير منسوب ذكره بن منده واورد من طريق المعلي الواسطي عن عبد الحميد بن جعفر عن ابي جعفر عن ابي معمر قال كنا نسمر عند ال محمد قال وهذا اسناد مجهول قلت وليس فيه ما يدل علي الصحبة ابو معن هو يزيد بن الاخنس السلمي تقدم ابو معن اخر قال مسلم له صحبة واخرجه مطين في الصحابة واخرج له من طريق ابي حمزة السكري عن عاصم بن كليب حدثنا سهيل بن ذراع انه سمع ابا معن يقول تكلم متكلم منا فابلغ فقال النبي صلي الله عليه وسلم ان من البيان لسحرا واخرجه بن شاهين من طريق ابي عوانة عن عاصم بن كليب حدثني سهيل بن ذراع سمعت ابا معن يزيد بن معن او معن بن يزيد يقول فذكره ابو مغيث الجهني استدركه ابو موسي وقال ذكره محمد بن عثمان بن ابي شيبة في الصحابة ثم ساق من طريقه عن جنادة عن يحيي بن العلاء عن معمر عن عثمان بن واقد عن مغيث الجهني عن ابيه قال قال رسول الله صلي الله عليه وسلم البر زيادة في العمر وفي سنده غير واحد من الضعفاء ابو مغيث الاسلمي تقدم ابو مكرم الاسلمي هو نيار بن مكرم ذكره ابو موسي ولعله كان في الرواية عن بن مكرم فتحرفت فصارت عن ابي مكرم ابو مكعت بضم ثم سكون ثم مهملة مكسورة ثم مثناة الاسدي الفقعسي تقدم ذكره §  <> مع حضرمي بن عامر وتقدم ان اسمه عرفطة بن نضلة وقيل اسمه الحارث بن عمرو بن الاشتر بن ثعلبة بن حجوان بن فقعس حكاه بن ماكولا وضبطه بن ماكولا تبعا للدارقطني بضم الميم واسكان الكاف ثم المهملة ثم مثناة وذكره ابو احمد العسكري في الصحابة واسند بن منده من طريق المفضل الضبي عن جدته ام ابيه امراة من بني اسد عن ابي مكعت الاسدي قال اتيت النبي صلي الله عليه وسلم فانشدته يقول ابو مكعت صادقا عليك السلام ابا القاسم سلام الاله وريحانه وروح المصلين والصاءم فقال صلي الله عليه وسلم يا ابا مكعت عليك السلام تحية الموتي واورد بن قانع من طريق سليمان بن عبد العزيز بن ابي ثابت حدثنا ابي قال قدم وفد بني اسد علي النبي صلي الله عليه وسلم فيهم عرفطة بن نضلة اخو خالد بن نضلة ويكني ابا مكعت فلما وقف بين يدي النبي صلي الله عليه وسلم قال فذكر البيتين لكن قال فقال النبي صلي الله عليه وسلم وعليك السلام واخرجه ابو نعيم من هذا الوجه فقال ابو مصعب ثم قال صحف فيه المتاخر يعني بن منده فقال ابو مكعت قلت ابو نعيم لا يزال ينسب بن منده الي الغلط فيصيب في ذلك تارة ويخطء تارة ولو سلم من التحامل عليه لكان غالب ما يتعقبه به صوابا وليست له موافقة في هذا ابو مكنف بكسر اوله وفتح النون اسمه عبد رضا تقدم وانه شهد فتح مصر ابو ملقام هو التلب العنبري تقدم ابو المليح بن عروة بن مسعود بن معتب الثقفي قال بن حبان له صحبة وذكر بن اسحاق انه قدم بعد قتل ابيه علي النبي صلي الله عليه وسلم فقال له وال من شءت قال اتولي الله ورسوله الحديث وتقدم شء من ذلك في ترجمة قارب في القاف من الاسماء ومليح مصغرا ابو المليح الهدادي بالتخفيف ذكره بن منده واورد له من طريق الوليد بن يزيد الهدادي عن ابي عبد الداءم عن ابي المليح الهدادي ان رسول الله صلي الله عليه وسلم انقطع شسعه فمشي في نعل واحدة واخرجه ابو مسلم الكجي وابو احمد الحاكم من طريق الوليد بن يزيد لكن لم يقع عندهما الهدادي ويحتمل ان يكون الهدادي تصحيفا وانما هو الهذلي وابو المليح هو بن اسامة الهذلي تابعي لابيه صحبة فالله اعلم ابو المليح الهذلي جري ذكره في قصة المراتين اللتين ضربت احداهما الاخري فاسقطت الحديث والمراتان كانتا تحت حمل بن النابغة الهذلي اخرجه بن منده من طريق الحسن بن عمارة عن الحكم بن عيينة عن ابي المليح الهذلي قال اتي المغيرة بن شعبة في امراة ضربت جنينا فقال ابو المليح ضربت امراة منا امراة فاتي وليا النبي صلي الله عليه وسلم فقال فيه غرة الحديث وابو المليح هذا ممن حضر القصة وليس هو ابو المليح بن اسامة التابعي المشهور وقد ظنهما بن الاثير واحدا فاورد في هذه الترجمة حديث شعبة عن يزيد الرشك عن ابي المليح عن النبي صلي الله عليه وسلم في جلود §  <> السباع واخرجه الترمذي هكذا مرسلا من طريق شعبة ثم قال وقد روي عنه عن ابي مليح عن ابيه وهو اصح واختصره بن الاثير فقال روي عنه الحكم والصواب عنه عن ابيه وابو المليح تابعي قلت بل الصواب ما قدمت انهما اثنان ابو مليكة الذماري قال ابو عمر قيل له صحبة وذكره البخاري في الكني واورد له من طريق راشد بن سعد عنه عن النبي صلي الله عليه وسلم قال لا يستكمل العبد الايمان كله حتي يحب لاخيه ما يحب لنفسه حكاه الحاكم ابو احمد في الكني وقال روي عنه ابنه ايضا ابو مليكة زهير بن عبد الله بن جدعان التيمي تقدم في الاسماء ابو مليكة الكندي ويقال البلوي ذكره بن منده ونقل عن ابي سعيد بن يونس ان له صحبة وللمصريين عنه حديثان او ثلاثة وقاله ابو عبد الله محمد بن الربيع الجيزي في الصحابة الذين نزلوا مصر منها ما اخرجه من طريق علي بن رباح عنه انه قال لابي راشد الذي كان بفلسطين كيف بك يا ابا راشد اذا وليك ولاة ان عصيتهم دخلت النار وان اطعتهم دخلت النار ابو مليكة عبد الله الانصاري الخزرجي له ذكر في قصة اولاد ابيرق في نزول قوله تعالي ومن يكسب خطيءة او اثما ثم يرمي به بريءا فقد احتمل بهتانا الاية واخرجه المستغفري من طريق بن جريج فذكر القصة وفيها فرمي بالدرع في دار ابي مليكة الخزرجي ابو مليك سليك بن الاغر مذكور في الصحابة كذا ذكره بن عبد البر مختصرا وانا اخشي ان يكون هو الذي بعده وقع فيه تصحيف وتحريف وجوز بن فتحون ان يكون هو الذي بعده ابو مليل بلامين بن الازعر بن زيد بن العطاف بن ضبيعة بن زيد الانصاري ذكره بن اسحاق وغيره فيمن شهد بدرا وزعم بن الكلبي انه ممن قال يوم الخندق ان بيوتنا عورة وذكره ابو عمر ايضا وقال بن فتحون انهما واحد ابو المنتفق عبد الله بن المنتفق العامري تقدم ابو المنتفق ويقال بن المنتفق اخرج الطبراني من طريق عبد الله بن عون عن محمد بن جحادة عن زميل له عن ابيه وكان يكني ابا المنتفق قال اتيت مكة فسالت عن رسول الله صلي الله عليه وسلم فقالوا بعرفة فاتيته فذهبت ادنو منه فقلت نبءني بما ينجيني من عذاب الله ويدخلني الجنة فقال اعبد الله لا تشرك به شيءا الحديث وفيه فانظر ما تحب الناس ان ياتوه اليك فافعله بهم قال الطبراني اضطرب بن عون في اسناده ولم يضبطه عن محمد بن جحادة وضبطه همام ثم اخرجه من طريق همام عن محمد بن جحادة عن المغيرة بن عبد الله اليشكري عن ابيه قال قدمت الكوفة ودخلت المسجد فاذا رجل من قيس يقال له بن المنتفق فسمعته يقول وصف لي رسول الله صلي الله عليه وسلم فطلبته بمكة فقيل لي هو بمني الحديث ابو المنذر يزيد بن عامر بن حديدة الانصاري ثم السلمي بفتحتين تقدم في الاسماء ابو المنذر الجهني ذكره بن منده واخرج من طريق عبد الرحمن بن محمد العرزمي عن §  <> ابيه عن بن ابي المجالد عن زيد بن وهب عن ابي المنذر الجهني قال قلت يا نبي الله علمني افضل الكلام قال قل لا اله الا الله وحده لا شريك له له الملك وله الحمد يحيي ويميت بيده الخير اليه المصير وهو علي كل شء قدير ماءة مرة كل يوم فانت افضل الناس عملا الحديث وفيه ولا تنسين الاستغفار في صلاتك فانها ممحاة للخطايا ابو المنذر غير منسوب ذكره مطين في الصحابة واخرج عن محمد بن حرب الواسطي عن حماد بن خالد عن هشام بن سعد عن يزيد بن ثعلب عن ابي المنذر ان النبي صلي الله عليه وسلم حثي في قبره ثلاث حثيات واخرجه الطبراني مطولا عن عمرو بن ابي الطاهر بن السرح عن ابيه عن عبد الله بن نافع عن هشام بن سعد ان رجلا جاء الي النبي صلي الله عليه وسلم فقال يا رسول الله ان فلانا هلك فصل عليه فقال عمر انه فاجر فلا تصل عليه فقال الرجل يا رسول الله ارايت الليلة التي صبحت فيها في الحرس فانه كان فيهم فقام رسول الله صلي الله عليه وسلم ثم اتبعته حتي اذا جاء قبره قعد حتي اذا فرغ منه حثي عليه ثلاث حثيات وقال يثني عليه الناس شرا واثني عليه خيرا فقال عمر وما ذاك يا رسول الله فقال رسول الله صلي الله عليه وسلم دعنا عنك يا عمر من جاهد في سبيل الله وجبت له الجنة قال ابو موسي في الذيل تقدم هذا المتن من حديث ابي عطية قلت وحديث ابي المنذر اخرجه ابو داود في كتاب المراسيل عن احمد بن منيع عن حماد بن خالد كرواية بن نافع ولم يذكره ابو احمد في الكني واما حديث ابي عطية فقد تقدم كما قال ابو موسي في ترجمته وذكره الحاكم ابو احمد وقال اخلق بهذا ان يكون صحابيا لكن مخرج الحديثين مختلف وان تقاربا في سياق المتن ابو منصور الفارسي ذكره الدولابي في الصحابة وذكره الحسن بن سفيان في مسنده من طريق الليث عن دويد بن نافع قلت لابي منصور يا ابا منصور لولا حدة فيك قال ما يسرني بحدتي كذا وكذا وقد قال رسول الله صلي الله عليه وسلم ان الحدة تعتري خيار امتي واخرجه الحسن بن سفيان ايضا عن ابي الربيع الزهراني عن عبد الرحمن بن ابان عن الليث عن دويد عن ابي منصور وكانت له صحبة وكذا اخرجه البغوي عن زياد بن ايوب عن عبد الرحمن وقال لا اعلم لابي منصور غير هذا وهو ممن سكن مصر وقال البخاري حديثه مرسل وقال ابو عمر يقال ان حديثه مرسل وليست له صحبة قال ورواه يونس بن محمد بن علي بن غراب وغير واحد عن الليث لم يقل احد منهم وكانت له صحبة الا عبد الرحمن بن ابان قلت سياتي له ذكر في حرف الياء الاخيرة في ترجمة يزيد بن ابي منصور ابو منظور غير منسوب جاء ذكره في خبر واه اورده ابو موسي من طريق ابي حذيفة عبد الله بن حبيب الهذلي عن ابي عبد الله السلمي عن ابي منظور قال لما فتح رسول الله صلي الله عليه وسلم اظنه خيبر اصاب حمارا اسود فكلمه فتكلم فقال ما اسمك قال يزيد بن شهاب فذكر الحديث بطوله وان رسول الله صلي الله عليه وسلم سماه يعفورا قال ابو موسي بعد تخريجه هذا حديث منكر جدا اسنادا ومتنا لا احل لاحد ان يرويه عني الا مع كلامي عليه وهو في كتاب تركة النبي صلي الله عليه وسلم تخريج ابي طاهر المخلص ابو منفعة بالفاء الحنفي تقدم في حرف الكاف فيمن اسمه كليب وقال البغوي ابو منفعة من بني حنيفة سكن البصرة واورد حديثه من طريق الحارث بن مرة عن كليب بن منفعة قال اتي جدي §  <> النبي صلي الله عليه وسلم وفي رواية له عن الحارث عن كليب عن جده قال قلت يا رسول الله من ابر الحديث ابو منقعة بالقاف الانماري ذكره احمد بن محمد بن عيسي البغدادي في كتاب الصحابة الذين نزلوا حمص فقال وممن نزلها من اصحاب رسول الله صلي الله عليه وسلم ابو منقعة الانماري قال ابو عمر اسمه نصر بن الحارث كذا قال وانما قال بن عيسي ان اسمه بكر وكذا قال الدارقطني وغيره وتقدم في الموحدة وزعم بن الاثير انه الذي قبله وليس كما قال ابو المنهال غير منسوب ذكره ابو بشر الدولابي في الصحابة ولم يخرج له شيءا ابو المنيب الكلبي ذكره البخاري في الكني واخرج له من طريق بقية بن الوليد عن مسلمة بن زياد قالت رايت اربعة نفر من اصحاب النبي صلي الله عليه وسلم منهم روح بن يسار وابو منيب الكلبي يلبسون العماءم ويرخون من خلفهم وثيابهم الي الكعبين واخرجه بن منده من طريق بقية قال حدثني مسلمة بن زياد ابو المهاجر غير منسوب ذكره الدولابي في الكني واورد من طريق عيينة بن سعيد عن مهاجر بن المنيب عن ابيه ان رجلا اتي رسول الله صلي الله عليه وسلم فقال يا رسول الله اني ادخل في صلاتي فلا ادري انصرفت عن شفع او عن وتر ابو موسي الاشعري عبد الله بن قيس مشهور بكنيته واسمه جميعا لكن كنيته اكثر تقدم ابو موسي الانصاري ذكره بن منده واخرج من طريق الدارمي عن محمد بن يزيد البزار عن السري بن عبد الله السلمي عن حاتم بن ربيعة وعبد الله بن عبد الله هو ابو اوس كلاهما عن نافع بن سهيل بن مالك حدثنا ابو موسي الانصاري صاحب رسول الله صلي الله عليه وسلم وكان من خيار اصحاب النبي صلي الله عليه وسلم قال انا لقاعدون عند النبي صلي الله عليه وسلم فقال ان رحي الايمان داءرة فدوروا مع رحي القران حيث دار الحديث قال عبيد الله بن واصل الراوي له عن الدارمي ذكرته لمحمد بن اسماعيل البخاري فانكره ولم يعرف ابا موسي الانصاري ولا حاتم بن ربيعة قلت وقد اخرجه ابو نعيم من وجه اخر عن محمد بن يزيد لكن قال عن جابر بن ربيعة عن ابي انس وقال بدل نافع بن سهيل محمد بن نافع بن عبد الحارث فالله اعلم وذكر بن منده ان محمد بن اسماعيل الجعفري رواه عن محمد بن جعفر عن مالك عن عمه ابي سهيل قال حدثنا انس بن مالك قال فيحتمل ان يكون بعض الرواة كني انس بن مالك ابا موسي بابنه موسي قلت ورواية ابي نعيم تدفع هذا الاحتمال وفي السند الي مالك من لا يوثق به ابو موسي الحكمي ذكره البغوي ولم يخرج له شيءا وابو نعيم في الصحابة وقال ذكره البخاري في الكني ولا ادري له صحبة واخرج بن منده من طريق الحسن بن حبيب عن ندبة عن الحجاج بن فرافصة عن عمرو بن ابي سفيان قال كنا عند مروان فجاءه ابو موسي الحكمي فقال له هل كان للقدر ذكر في §  <> عهد النبي صلي الله عليه وسلم فقال قال النبي صلي الله عليه وسلم لا تزال هذه الامة متمسكة بما هي فيه ما لم تكذب بالقدر وصنيع ابي احمد يدل علي انه عنده تابعي فانه ذكره فيمن لا يعرف اسمه بعد ذكر تابعي من التابعين ابو موسي الغافقي مالك بن عبادة ويقال مالك بن عبد الله ذكره بن ابي عاصم وغيره في الصحابة واخرجوا من طريق عمرو بن الحارث عن يحيي بن ميمون انه حدثه ان وداعة الحميري حدثه انه كان يجتنب مالك بن عبادة الغافقي وعقبة بن عامر يقص فقال مالك بن عبادة ان صاحبكم هذا غافل او هالك ان رسول الله صلي الله عليه وسلم عهد الينا في حجة الوداع فقال عليكم بالقران من افتري علي فليتبوا مقعده من النار والسياق للحاكم ابي احمد واخرجه احمد من طريق الليث عن عمرو عن يحيي بن ميمون ان ابا موسي الغافقي سمع عقبة بن عامر يحدث علي المنبر احاديث فقال عن ابي موسي الغافقي ان صاحبكم لحافظ او هالك فذكر الحديث وذكره محمد بن الربيع الجيزي في الصحابة الذي نزلوا مصر وتقدم له حديث في مالك بن عبد الله المعافري ابو المءمل ذكره محمد بن عبد الواحد السفاقسي المعروف بابن البنين شارح البخاري في كتاب المكاتبة فقال قيل اول من كوتب في الاسلام ابو المءمل فقال النبي صلي الله عليه وسلم اعينوا ابا المءمل فاعين فقضي كتابته وفضلت عنده فضله فقال له النبي صلي الله عليه وسلم انفقها في سبيل الله ابو مويهبه ويقال ابو موهبه وابو مهوبه وهو قول الواقدي مولي رسول الله صلي الله عليه وسلم قال البلاذري كان من مولدي مزينه وشهد غزوه المريسيع وكان ممن يقود لعاءشه جملها روي عنه عبد الله بن عمرو بن العاص وهو من اقرانه واخرج حديثه احمد عن يعقوب بن ابراهيم بن سعد عن ابيه والدارمي وخليفة بن خياط عن سليمان كلاهما عن محمد بن اسحاق حدثني عبد الله بن عمرو بن ربيعه العقيلي وفي روايه الدارمي حدثنا عبد الله بن عمر بن علي بن عدي عن عبيد بن حنين وفي روايه الدارمي ايضا عن عبيد مولي ابي الحكم بن ابي العاص عن عبد الله بن عمرو بن العاص عن ابي مويهبه مولي رسول الله صلي الله عليه وسلم قال اهبني رسول الله صلي الله عليه وسلم فقال يا ابا مويهبه اني قد امرت ان استغفر لاهل البقيع فخرجت فذكر حديثا طويلا وفيه فلما اصبح بدا به وجعه الذي قبضه الله فيه صلي الله عليه وسلم واخرجه الحاكم من وجه اخر عن ابراهيم بن سعد عن محمد بن اسحاق فقال عن عبد الله بن عمر بن حفص عن عبيد بن حنين به وقوله بن عمر بن حفص وهم قال ابو نعيم رواه عامه اصحاب بن اسحاق هكذا وخالفهم محمد بن مسلمه فقال عن بن اسحاق عن ابي مالك بن ثعلبة عن عمر بن الحكم بن ثوبان عن عبد الله بن عمرو فكان لابن اسحاق فيه شيخين ان كان محفوظا واخرجه الحاكم في المستدرك من رواية يونس بن بكير فقال عن محمد بن اسحاق عن عبد الله بن ربيعة فكانه نسبه لجده الاعلي عن عبيد بن ابي الحكم كذا فيه والصواب عن عبيد مولي ابي الحكم كما تقدم واخرجه احمد ايضا من طريق ابي يعلي بن عطاء عن عبيد بن حنين عن ابي مويهبة نفسه ليس بينهما عبد الله §  <> بن عمرو وقد سمعناه في الحلية من طريق سموية عن شيخ له عن محمد بن مسلمة قلت والعقيلي منسوب الي العقيلات وهم بطن من بني عبد شمس قال البغوي وقع في رواية بعضهم في هذا السند عن عبيد بن حنين بمهملة ونونين وبه جزم بن عبد البر وهو تصحيف وانما هو عبيد بن جبير بجيم وموحدة ونبه علي ذلك بن فتحون وهو عقيلي عبشمي القسم الثاني ابو محمد عبد الله بن ثعلبة وعبد الله بن عامر بن ربيعة وعبد الله بن نوفل بن الحارث بن هشام وعبد الرحمن بن عبد القارء وعبيد الله مصغرا بن العباس بن عبد المطلب تقدموا في الاسماء ابو مراوح الغفاري مولاهم يقال اسمه سعد ذكر ابو احمد الحاكم انه ولد علي عهد رسول الله صلي الله عليه وسلم قلت وروي عن ابي ذر وابي واقد الليثي وحمزة بن عمرو الاسلمي روي عنه عروة وزيد بن اسلم وروي عنه عمران بن ابي انس ومنهم من ادخل بينهما سليمان بن يسار قال العجلي مدني تابعي ثقة وقد تقدم في القسم الاول ما جاء في ابي مراوح الليثي القسم الثالث ابو محرز البكري ذكره البخاري في مفاريد الكني وقال ادرك الجاهلية وروي عنه ابنه عبد الله ابو محمد الفقعسي الراجز انشد له الزبير بن بكار شعرا قاله لما هزم خالد بن الوليد بني اسد بالبطاح مع طليحة بن خويلد في الردة يقول فيه سبقنا اليه يوم بويع خالد وجفر البطاح فوق ارجاءه الدم خططنا باطراف الرماح ركيها وارجاءها والماء حال مسدم ابو مخشي النميري استدركه بن فتحون وقال ذكر وثيمة في الردة ما يدل علي ان له ادراكا فاخرج من طريق المضارب بن عبد الله قال كان ابو مخشي النميري مع ابي عبيدة بن الجراح بالشام ففقده اصحابه اياما يسالون عنه ولا يخبرون وكان شجاعا ويذكرون من فضله فبينما هم جلوس قد يءسوا منه وظنوا انه قد اغتيل اذ طلع عليهم ومعه ورقتان لم ير الناس مثلهما ولا اعرض ولا اطول ولا اطيب ريحا ولا اشد خضرة ولا ابهي منظرا فسالوه فاخبرهم انه سقط في جب وانه مشي فيه فانتهي الي روضة لم ير قط احسن منها فاقام فيها اياما اذ اتاه ات فاخرجه منها قال وكنت قد قطعت هاتين الورقتين من سدرة جلست تحتها فبعثه ابو عبيدة الي عمر فسال كعبا فقال نجد في الكتب ان رجلا من هذه الامة يدخل الجنة في الدنيا بعد فتح الروم قال بن فتحون ذكر هذه القصة غير واحد لم يقل انه ابو §  <> مخشي الا وثيمة قلت ابو مرثد الخولاني له ادراك ذكر ابو اسماعيل الازدي عن الصعب بن زهير عن المهاجر بن صيفي عن راشد بن عبد الرحمن عنه انه راي رءيا فيها بشري للمسلمين وهو باليرموك ابو مريم زر بن حبيش الازدي تقدم في الاسماء ابو مريم الحنفي اليمامي ذكره الدولابي في الصحابة وقيل اسمه اياس بن صبيح وكان من اصحاب مسيلمة الكذاب فاسلم وولي بعد ذلك قضاء البصرة وذكر عمر بن شبة ان فتح رامهرمز كان علي يديه وقد تقدم في الاسماء ابو مريم الخصي له ادراك ذكره بن مندة واخرج من طريق الاوزاعي عن سليمان بن موسي قال قلت لطاوس ان ابا مريم الخصي اخبرني وقد ادرك النبي صلي الله عليه وسلم فقال احلني علي غير خصي ابو مريم الكندي اسمه عبيد له ادراك وصلي مع عمر ببيت المقدس فاخرج بن مندة من طريق عثمان بن عطاء الخراساني عن زياد بن ابي سودة عن ابي مريم قال دخلت مع عمر بن الخطاب محراب داود فقرا سورة ص وسجد واخرجه سيف في الفتوح عن الربيع بن النعمان عن ابي مريم مولي سلامة قال شهدت ايلياء مع عمر فمضي حتي دخل المسجد فانتهي الي محراب داود فقرا سجدة ص فسجد وسجدنا معه وقال البخاري ابو مريم روي عن عمر روي عنه زياد بن ابي سودة حديثه في الشاميين ابو مسافع غير منسوب ادرك الجاهلية وغزا في خلافة عمر اورده الحاكم ابو احمد وساق من طريق ابي اسحاق عن ابي الصلت وابي مسافع قالا بعث الينا عمر بن الخطاب ونحن بنهاوند ان اقيموا الصلاة لوقتها واذا لقيتم العدو فلا تفروا واذا غنمتم فلا تغلوا ابو مسلم الخولاني عبد الله بن ثوب وسمي بن السكن اباه مسلما تقدم في الاسماء ابو مسلم الجليلي بالجيم ويقال الجلولي قال بن عساكر والاول اصح ادرك النبي صلي الله عليه وسلم ولم يسلم واسلم في عهد معاوية وقيل في عهد ابي بكر وقيل في عهد عمر قال البخاري كان مثل كعب الاحبار وكان يكني ابا السموال فاسلم في عهد ابي بكر فكناه ابا مسلم قال البخاري ويروي عن اذرع الخولاني انه اسلم بعد ابي بكر واخرج البغوي من طريق ابي قلابة ان ابا مسلم الجليلي اسلم في عهد معاوية فقال له ابو مسلم الخولاني ما منعك ان تسلم في عهد النبي صلي الله عليه وسلم وابي بكر وعمر وبذلك ذكره بن مندة فقال اسلم في عهد معاوية واخرج عبد بن حميد في تفسيره وتمام في فواءده من طريق صالح المزي عن ابي عبد الله الشامي عن مكحول عن ابي مسلم الخولاني انه لقي ابا مسلم الجلولي وكان مترهبا فنزل عن صومعته في عهد عمر بن الخطاب فاسلم فقال له ما انزلك من صومعتك تركت الاسلام علي عهد رسول الله صلي الله عليه وسلم وعلي عهد ابي بكر فما حملك علي الاسلام اليوم قال يا ابا مسلم اني قرات في كتاب الله ان هذه الامة تصنف يوم القيامة علي ثلاثة اصناف صنف يدخلون الجنة بغير حساب وصنف يحاسبهم الله حسابا يسيرا وصنف يءخذ بهم ما شاء الله ثم يتجاوز الله عنهم §  <> فنظرت فاذا الصنف الاول قد مضي فرجوت ان اكون من الثاني والا يخطءني الثالث فاسلمت وصالح ضعيف وقد اخرجه بن عساكر من وجه اخر عن سعيد الجريري عن عقبة بن وساج قال كان لابي مسلم الخولاني جار يهودي يكني ابا مسلم فكان يقول له اسلم تسلم فيقول اني علي دين فمر به فراه يصلي فساله فقال قرات في التوراة التي لم تبدل ان هذه الامة فذكر نحوه وقال في الصنف الثالث اوزارهم علي ظهورهم فتقول الملاءكة هءلاء عبادك كانوا يوحدونك فيقول خذوا اوزارهم فضعوها علي المشركين فيدخلون الجنة وقال بن السكن ادرك الجاهلية وقال بعضهم له صحبة ثم اخرج من طريق معاوية بن يحيي الصدفي عن يحيي بن جابر عن خالد بن معدان عن جبير بن نفير عن ابي مسلم الجليلي قال قال رسول الله صلي الله عليه وسلم ذراري المشركين تحت عرش الرحمن باسماءهم ما تبلغ ثلاث عشرة قلت وهذا مرسل لان الذين صرحوا باسلامه بعد النبي صلي الله عليه وسلم اتقن واحفظ وهذا لم يصرح بسماعه قال بن سميع كان قد بعث كعبا الي النبي صلي الله عليه وسلم فلم يدركه وقال العجلي شامي تابعي ثقة ابو مشجعة بن ربعي الجهني له ادراك وشهد خطبة عمر بالجابية وحدث بها عنه مطولة اخرجها بن عساكر من طريق محمد بن سليمان بن عطاء عن ابيه عن مسلم بن عبد الله الجهني عن عمه ابي مشجعة واخرج ابو زرعة الدمشقي عن يحيي بن صالح عن سليمان بن عطاء عن مسلم عن عمه قال عدنا مع عثمان مريضا فذكر حديثا وله رواية ايضا عن ابي الدرداء وسلمان وغيرهم وما عرفت له راويا غير بن اخيه والراوي عنه سليمان ضعيف ابو معبد الجهني عبد الله بن عكيم تقدم في الاسماء ابو مفرز التميمي له ادراك ذكره سيف بن عمر في الفتوح في قصة وفاة ابي ذر عن اسماعيل بن رافع عن محمد بن كعب فقال في اخر القصة ان عدة الذين حضروا وفاة ابي ذر مع بن مسعود ثلاثة عشر نفسا منهم ابو مفرز التميمي وذكره سيف ايضا في قصة الذين شربوا الخمر في عهد عمر فحدهم قال وقال ابو مفرز في ذلك صبرنا وكان الصبر منا سجية ليالي ظفرنا بالقري والمعاصر ولم يستفه فيما هنا جبلة كما سفهت بالشام خل العشاءر ابو المقشعر بضم الميم وسكون القاف وفتح المعجمة وكسر المهملة وتشديد الراء ابو المهلب الجرمي عم ابي قلابة له ادراك ذكره بن سعد في الطبقة الاولي من تابعي اهل البصرة وقال كان ثقة قليل الحديث وله رواية عن عمر قال واختلف في اسمه فقيل عمرو بن معاوية بن زيد وجزم بذلك بن حبان في الثقات وقيل معاوية بن عمرو بن زيد وصححه بن عبد البر وقيل عبد الرحمن بن عمرو وقيل بن معاوية وقيل اسمه النضر وروي ايضا عن ابي بن كعب وعثمان وغيرهما روي عنه محمد بن سيرين وغيره §  <> ابو ميسرة عمرو بن شرحبيل تقدم في الاسماء القسم الرابع ابو مالك الغفاري تابعي معروف اسمه غزوان ارسل حديثا فذكره العسكري في الصحابة واخرج من طريق حصير بن عبد الرحمن عن ابي مالك الغفاري قال صلي النبي صلي الله عليه وسلم علي حمزة فكان يجاء بسبعة معه فلم يزل كذلك حتي صلي علي جماعتهم استدركه بن الاثير علي من تقدمه ولم يتفطن لعلته واما الذهبي فقال لعله تابعي ارسل ابو مالك الدمشقي قال الحاكم ابو احمد قال البخاري حديثه مرسل وكذا قال العسكري وقال بن مندة ذكر في الصحابة ولا يثبت روي معاوية بن صالح عن عبد الله بن دينار عنه وذكره ابو عمر لكنه قال النخعي وقال انه تابعي ارسل قيل ان له صحبة والصحيح ان حديثه مرسل ولا صحبة له روي معاوية بن صالح عن عبد الله بن دينار عنه عن النبي صلي الله عليه وسلم في المسخط لابويه والذي يءم قوما وهم له كارهون والمراة تصلي بغير خمار لا تقبل لهم صلاة قلت وقد تقدم ابو مالك النخعي في القسم الاول وان بن السكن ذكره واخرج له حديثا وانه صرح بسماعه من النبي صلي الله عليه وسلم فذهل ابو عمر عنه واقتصر علي ذكر هذا او ظنهما واحدا وهو بعيد لكن يظهر انه اخر والله سبحانه وتعالي اعلم ابو مبتذر ياتي في الذي بعده ابو المبتذل استدركه يحيي بن عبد الوهاب بن ابي عبد الله بن مندة علي جده وتبعه ابو موسي واورد من طريق احمد بن سليمان عن رشدين بن سعد عن يحيي بن عبد الله المعافري عن ابي المبتذل صاحب رسول الله صلي الله عليه وسلم وكان يكون بافريقية فذكر الحديث في القول اذا اصبح رضيت بالله ربا قال ابو موسي رواه احمد بن الطيب عن رشدين فقال ابو المبتذر او المبتذل وقال يحيي بن غيلان عن المبتذر او المبتذل واورده ابو عبد الله بن مندة في الاسماء قلت وهو كما قال ورواية احمد بن سليمان تصحيف وقد رايته بخط الحافظ ابراهيم الصريفيني مضبوطا الذي اخره لام بفتح المثناة الفوقانية ثم الموحدة وتشديد المعجمة المكسورة واما رواية احمد الطيب فبسكون الموحدة وتخفيف المعجمة وبدل اللام راء او بالنون بدل الموحدة واما رواية يحيي فكرواية الطيب الاولي او بالنون والتصغير والصواب من الجميع انه اسمه بغير اداة كنية وانه بالتصغير كما تقدم في اواخر حرف النون من الاسماء ابو المتوكل صحابي له قصة ذكرها ابو جعفر النحاس وتبعه المهدوي وغيره فقال القرطبي في تفسيره سورة الحشر من تفسيره وذكر المهدوي عن ابي هريرة ان قوله تعالي ويءثرون علي انفسهم ولو كان بهم خصاصة نزلت ثابت بن قيس رجل من الانصار يقال له ابو المتوكل نزل به ثابت فلم يكن عند ابي المتوكل الا قوته وقوة صبيانه فقال لامراته اطفءي السراج ونومي الصبية §  <> وقدم ما كان عنده الي ضيفه قال وذكر النحاس عن ابي هريرة قال نزل برجل من الانصار يقال له ابو المتوكل ثابت بن قيس ضعيف ولم يكن عنده شء فذكر نحوه وقال بن عساكر في الذيل علي التعريف للسهيلي قيل ان هذه الاية نزلت في ابي المتوكل الناجي نزل علي ثابت بن قيس حكاه المهدوي قال وقيل ان فاعلها ثابت بن قيس حكاه يحيي بن سلام انتهي وكل ذلك خبط يءذن بضعف معرفتهم بالرجال فابو المتوكل الناجي تابعي من وسط التابعين حديثه عن ابي سعيد ونحوه مخرج في الكتب الستة ولم يدرك اكابر الصحابة فضلا عن ان يكون له صحبة وراوي القصة لا هو الضيف ولا المضيف فانهما صحابيان وقد ورد ذلك واضحا فيما اخرجه عبد الله بن المبارك في البر والصلة وفي كتاب الزهد واخرجه بن ابي الدنيا في كتاب قري الضيف من طريقه قال عن اسماعيل بن مسلم عن ابي المتوكل الناجي ان رجلا من المسلمين نزل بالنبي صلي الله عليه وسلم فلبث ثلاثة ايام لم ياكل ففطن له ثابت بن قيس فذكر القصة فتبين ان ابا المتوكل راوي الحديث وقد ارسله وان الضيف لا يعرف اسمه وان المضيف ثابت بن قيس وكنيته ابو محمد لا ابو المتوكل والله المستعان ابو محرز بن زاهر ذكره ابو عمر مختصرا ولا اعرف له خبرا ولم ادر لا له اثرا قلت وهو خطا نشا عن تصحيف وانما هو ابو مجزاة زاهر وهو الاسلمي وكذا ترجم له الدولابي فقال ابو مجزاة زاهر الاسلمي فتصحف علي بن عبد البر ولم يعرف من حاله شيءا فقال ما قال ابو محمد روي عن النبي صلي الله عليه وسلم حديثه مرسل روي عنه شعيب قال ابو احمد الحاكم ذكره البخاري في الكني ابو مخارق روي عن النبي صلي الله عليه وسلم روي عنه الاعمش ذكر في الصحابة ولا يصح وذكره البخاري وقال حديثه مرسل قلت لعله والد قابوس ابو مرحب مجهول كذا ذكره الذهبي في الكني وهو احد الرجلين ابو مسعود بن عمرو بن ثعلبة ذكره ابو بكر بن علي وتبعه ابو موسي في الذيل فوهم في استدراكه فانه ابو مسعود البدري المقدم ذكره واسمه عقبة بن عمرو ابو مسلم الاشعري ذكره بن مندة واورد من طريق عثمان بن ابي العاتكة احد الضعفاء عن معاوية بن حاتم الطاءي عن عبد الرحمن بن غنم عن ابي مسلم الاشعري عن النبي صلي الله عليه وسلم قال يكون قوم يستحلون الخمر باسم يسمونها بغير اسمها الحديث قال وكذا قال ورواه غيره عن عبد الرحمن بن غنم عن ابي مالك الاشعري قلت وهو الصواب اخطا فيه عثمان وساقه ابو نعيم علي الصواب من طريق معاوية بن صالح عن حاتم بن حريث عن مالك بن ابي مريم عن عبد الرحمن بن غنم عن ابي مالك الاشعري فظهر ان عثمان خبط في سنده ايضا وان قوله معاوية بن حاتم غلط وانما هو معاوية عن حاتم معاوية هو بن حريث والله اعلم ابو مصعب الاسدي تقدم في ابي مكعت ابو مصعب الانصاري اخر تابعي ارسل حديثا ذكره ابو نعيم في الصحابة وقال §  <> مختلف فيه فاورد من طريق عبد الحميد بن جعفر سمعت ابا مصعب يقول اطلبوا الخير عند حسان الوجوه ابو معن صاحب الاسكندرية تابعي ارسل حديثا ذكره المستغفري في الصحابة وتبعه ابو موسي من طريق سعيد بن العلاء حدثني الحسين بن ادريس شيخ طالوت بن عباد حدثنا العباس بن طلحة القرشي حدثنا ابو معن صاحب الاسكندرية قال قال رسول الله صلي الله عليه وسلم اعمال البر كلها مع الجهاد في سبيل الله كبصقة في بحر جرار وبهذا الاسناد كل نعيم مسءول عنه الا النعيم في سبيل الله قال المستغفري مع براءتي الي الله من عهدة اسناده وهذا الرجل اسمه عبد الواحد بن ابي موسي ذكره بن يونس في تاريخ مصر وقال انه ادرك عمر بن عبد العزيز روي عنه الليث بن سعد وغيره وذكر ابو احمد الحاكم في الكني انه روي عن عبد الله بن عمر ابو معمر الاشج ذكر في التجريد وقال ورد انه صحابي وذلك افك قلت ورد ذلك في بعض طرق حديث ابي الدنيا الاشج ابو ملحة بكسر اوله وسكون اللام بعدها مهملة ذكره ابو محمد الحسين بن مسعود الفراء البغوي الفقيه الشافعي صاحب التهذيب في الفقه وشرح السنة في الحديث والمعالم في التفسير والمصابيح في المتون فقال في المصابيح عن النبي صلي الله عليه وسلم بدا الاسلام غريبا وسيعود غريبا الحديث رواه زيد بن ملحة عن ابيه عن جده وقال في شرح السنة له ويروي عن زيد بن ملحة عن ابيه عن جده عن النبي صلي الله عليه وسلم فذكر الحديث وهو وهم نشا عن سقط من السند لم يتيقظ له وذلك ان الحديث في الترمذي من طريق اسماعيل بن ابي اويس عن كثير بن عبد الله بن عمرو بن عوف بن زيد بن ملحة عن ابيه عن جده فكان النسخة التي وقعت عند البغوي من الترمذي كان فيها عن كثير بن عبد الله بن عمرو بن عوف عن زيد بن ملحة عن ابيه عن جده وهو تصحيف وانما هو بن زيد فزيد هو والد عوف وعوف والد عمرو وعمرو هو جد كثير وصحابي الحديث هو عمرو بن عوف وهو مشهور في الصحابة وترجمة كثير بن عبد الله بن عمرو بن عوف في سنن ابي داود وجامع الترمذي وغيرهما وملحة المذكور يقال فيه مليحة بالتصغير وهو بن عمرو بن بكر بن افرك بن عثمان بن عمرو بن اوس بن طابخة وقد اخرج البخاري في تاريخه عن اسماعيل بن ابي اويس بهذا السند حديثا وبين فيه ان الصحابي هو عمرو بن عوف قال عن كثير بن عبد الله بن عمرو بن عوف عن ابيه عن جده عمرو بن عوف قال كنا عند النبي صلي الله عليه وسلم فذكر الحديث ابو المنذر تقدم ابو المهلب ذكره مطين وغيره في الصحابة وهو خطا نشا عن تحريف وانما هو ابو المطلب بتشديد الطاء وتخفيف اللام المكسورة فاخرج ابو نعيم من طريقه عن ضرار بن صرد عن بن ابي فديك عن عبد العزيز بن المطلب بن عبد الله بن حنطب عن ابيه عن جده في القول لابي بكر وعمر انهما السمع والبصر قال كذا في كتابي والصواب عبد العزيز بن المطلب ولعله كان يكني ابا المهلب وهو تصحيف انتهي والثاني هو المجزوم به وقد تقدم الحديث بعينه في ترجمة عبد الله بن حنطب من رواية §  <> قتيبة عن بن ابي فديك وذكرت هناك الاختلاف في سنده وفي صحبة عبد الله وفي نسب عبد العزيز وسبق انه المطلب بن عبد الله بن المطلب بن حنطب وان الصحبة للمطلب الاعلي ابو ميسرة مولي العباس بن عبد المطلب ذكره المستغفري في الصحابة وتبعه ابو موسي واورد من طريق محمد بن احمد بن سعيد البزار الطوسي المعروف بابي كساء عن احمد بن محمد بن يحيي بن سعيد القطان عن عبيدة بن ابي قرة عن الليث بن سعد عن ابي قبيل عن ابي ميسرة مولي العباس بن عبد المطلب قال بت عند النبي صلي الله عليه وسلم فقال يا عباس انظر هل تري في السماء شيءا قلت نعم اري الثريا قال اما انه يملك هذه الامة بعددها من صلبك قلت وهذا الحديث معروف بعبيد بن ابي قرة تفرد بروايته عن الليث وسقط من السند العباس بن عبد المطلب فصار ظاهره ان الصحابي هو ابو ميسرة وليس كذلك فقد اخرجه احمد في مسنده عن عبيد بن ابي قرة وكذلك اخرجه ابو حاتم الرازي عن احمد بن محمد بن يحيي بن سعيد القطان شيخ ابي كساء عن عبيد واخرجه البخاري في الكني عن عبد الله بن محمد الجعفي والحاكم ابو احمد من طريق ابراهيم بن سعيد الجوهري والحاكم في المستدرك من طريق احمد بن ابراهيم الدورقي وابن ابي داود من طريق حجاج بن الشاعر كلهم عن عبيد قال بن ابي حاتم عن ابيه لم يرو هذا الحديث عن الليث الا عبيد بن ابي قرة وكان احمد يضن به قال وكان ابي يستحسن هذا الحديث ويسر به حيث وجده عند يحيي القطان وقال بن ابي داود سمع احمد بن ابي صالح هذا الحديث من ابي عن حجاج واتفقت هذه الطرق كلها في سياق السند علي انه عن ابي ميسرة عن العباس بن عبد المطلب فظهر ان الصواب اثباته وقد ذكرت حال عبيد بن ابي قرة في لسان الميزان وقد ذكر احمد بن حنبل في العلل حديثا من طريق زكريا بن ابي زاءدة عن ابي اسحاق عن ابي ميسرة حديثا فظن بعضهم انه صاحب الترجمة وليس كذلك وانما هو عمرو بن شرحبيل الماضي في الثالث وهو مرسل ايضا والله اعلم حرف النون القسم الاول ابو نافع اسمه كيسان بن عبد الله بن طارق ابو نافع اسمه طارق بن علقمة تقدما ابو ناءلة الانصاري اسمه سلكان بن سلامة بن وقش بن زغبة بن زعوراء بن عبد الاشهل الانصاري الاوسي الاشهلي اخو سلمة بن سلامة بن وقش وقيل اسمه سعد وقيل سعد اخوه وقيل سلكان لقب واسمه سعد وهو مشهور بكنيته ثبت ذكره في الصحيح في قصة قتل كعب بن الاشرف وشهد §  <> احدا وغيرها وكان شاعرا ومن الرماة المذكورين واخرج السراج في تاريخه من طريق عبد المجيد بن ابي عبس بن محمد بن جبر عن ابيه عن جده قال كان كعب بن الاشرف اليهودي يقول الشعر ويخذل عن النبي صلي الله عليه وسلم ويخرج في الناس وفي قباءل العرب من غطفان في ذلك فقال رسول الله صلي الله عليه وسلم من لي بابن الاشرف فقال محمد بن مسلمة الحارثي يا رسول الله اتحب ان اقتله فصمت فحدث محمد بن سعد بن عبادة فقال امض علي بركة الله تعالي واذهب معك بابن اخي الحارث بن اوس بن معاذ وابي عبس بن جبر وعباد بن بشر وابي ناءلة سلكان بن وقش الاشهلي قال فلقيتهم فذكرت ذلك لهم فاجابوني الا سلكان بن وقش فقال لا احب انا افعل ذلك حتي اشاور رسول الله صلي الله عليه وسلم قال فذكر ذلك له فقال له امض مع اصحابك قال فخرجنا اليه فساق القصة في قتله وانشد عباد بن بشر في ذلك صرخت له فلم يعرض لصوتي واوفي طالعا من فوق خدر فعدت له فقال من المنادي فقلت اخوك عباد بن بشر وهذي درعنا رهنا فخذها لشهر ان وفت او نصف شهر فاقبل نحونا يسعي سريعا وقال لنا لقد جءتم لامر فشد بسيفه صلتا عليه فقطره ابو عبس بن جبر وكان الله سادسنا فابنا بانعم نعمة واعز نصر وجاء براسه نفر كرام هم ناهيك من صدق وبر اورده الحاكم عن السراج عن محمد بن عباد عن محمد بن طلحة عن عبد المجيد وقال رواه ابراهيم بن المنذر عن محمد بن طلحة فقال عن عبد المجيد عن محمد بن ابي عبس عن ابيه عن جده قال والاول هو الصواب ابو نبقة بن عبد المطلب بن عبد مناف المطلبي من مسلمة الفتح قال ابو عمر ذكره بعضهم في الصحابة وهو عندي مجهول كذا قال وقد ذكره الطبري وذكر بن اسحاق ان النبي صلي الله عليه وسلم اطعمه من خيبر خمسين وسقا ذكر ذلك المستغفري بسنده الي بن اسحاق وتبعه ابو موسي في الذيل وقد ذكره اعلم الناس بنسب قريش الزبير بن بكار قال ولد علقمة بن المطلب ابا نبقة واسمه عبد الله وامه ام عمرو الخزاعية وكان له من الولد العلاء وهذيم قتلا باليمامة ولا عقب لهما وذكر ابو الوليد الفرضي ان من ولده محمد بن العلاء بن الحسين بن ابي نبقة النبقي المكي قال بن الاثير فكل هذا يدل علي ان الرجل ليس بمجهول في نفسه ولا نسبه ابو النجم غير منسوب ذكره ابو نعيم قال ذكره الحسين بن سفيان حديثه عند بن لهيعة عن كعب بن علقمة انه سمع ابا النجم يقول سمعت رسول الله صلي الله عليه وسلم يقول يكون في بني امية رجل اخنس واستدركه ابو موسي بهذا ابو نجيح عمرو بن عبسة السلمي تقدم في الاسماء §  <> ابو نجيح العبسي اورده بن منده قلت ذكره البخاري في الكني المجردة وافرده عن عمرو بن عبسة لكنه قال العبسي بمهملة ثم موحدة وقال روي ربيعة بن لقيط عن رجل عنه عن النبي صلي الله عليه وسلم حكاه الحاكم ابو احمد واشار الي انه عمرو بن عبسة وساوضحه في القسم الرابع ابو نجيح السلمي روي حديثه بن جريج عن ميمون عن ابي المغلس عنه قاله ابو نعيم ثم ساق من طريق عبد الرزاق عن بن جريج اخبرني ابو المغلس ان ابا نجيح اخبره ان رسول الله صلي الله عليه وسلم قال من كان موسرا فلم ينكح فليس مني ومن طريق محمد بن ثابت العقدي عن هارون بن رءاب عن ابي نجيح قال قال رسول الله صلي الله عليه وسلم مسكين مسكين رجل ليست له امراة الحديث قال بن الاثير وهو عمرو بن عنبسة فانه سلمي وحديثه في النكاح مشهور وقال الذهبي بل هو العرباض بن سارية قلت وجزم به الحاكم ابو احمد وجزم البغوي بانه ليس سلميا وقال يشك في صحبته ابو نجيح العرباض بن سارية السلمي اخرج البخاري بسند شامي عن العرباض بن سارية قال لولا ان يقول الناس فعل ابي نجيح لالحقت مالي سبله ابو نجيح والد عبد الله اسمه يسار ابو نجيد بجيم مصغرا هو عمران بن حصين تقدما ابو نحيلة بمهملة مصغرا كذا عند الدارقطني وغيره ورايته في نسخة معتمدة من الكني لابي احمد بفتح اوله والمعجمة وذكره عبد الغني بالتصغير والحاء المهملة وبالمهملة جزم ابراهيم الحربي وزاد هو رجل صالح من بجيلة حكاه الدارقطني عن يحيي بن معين وعن علي بن المديني ان سفيان بن عيينة قال ان ابا نخيلة له صحبة قال وهو بالخاء المعجمة البجلي ذكره الطبراني وغيره وقال بن المديني والبخاري وابو احمد الحاكم له صحبة روي حديثه الثوري عن منصور عن ابي واءل عن ابي نخيلة رجل من اصحاب النبي صلي الله عليه وسلم انه رمي بسهم فقيل له انتزعه فقال اللهم انقص من الوجع ولا تنقص من الاجر وقيل له ادع الله فقال اللهم اجعلني من المقربين واجعل امي من الحور العين ووقع لنا بعلو عند بن منده لكن قال في اوله خرج غازيا فرمي بحجر فقال اللهم انقص من الوجع والباقي سواء ونقل ابو عمر عن علي بن المديني انه قال قيل فيه ابو نخيلة يعني بالمعجمة والمعروف بالمهملة قال وله رواية عن جرير البجلي قلت هي عند البخاري في الادب المفرد والنساءي وغيرهما وقال ابو حاتم الرازي ليست له صحبة ابو نخيلة اللهبي بمعجمة مصغرا ذكره بن منده واخرج له من طريق سليمان بن داود المكي من اهل تبالة قال حدثنا محمد بن عثمان الطاءفي الثقفي حدثني عبد الله بن عقيل بن يزيد بن راشد عن ابيه قال خرجنا الي المسلم بن حذيفة العامري فاخبرنا ان ابا رهيمة السمعي وابا نخيلة اللهبي قالا اتينا رسول الله صلي الله عليه وسلم بتبر من العقيق فكتب لنا كتابا وقال فيه من وجد شيءا فهو له والخمس من الركاز والزكاة من كل اربعين دينارا دينار قال سليمان يعني من وجد شيءا من المعادن فليس فيه زكاة حتي يبلغ اربعين دينارا في رواته من لا يعرف الا انه من رواية ابي حاتم الرازي عن سليمان واللهبي رايته مجودا §  <> عند الصريفيني بكسر اللام وسكون الهاء ابو نضرة احد الذين شهدوا فتح خيبرا جري له ذكر هناك ولا اعرفه الا بذاك قاله ابو عمر قال بن الاثير قد ذكر بن هشام فيمن قطعه رسول الله صلي الله عليه وسلم من خيبر ابا نضرة بالضاد المعجمة واخره هاء فلا اعلم اهو ذا ام لا وقال بن فتحون في اوهام الاستيعاب اراه هو ابو نضرة بالضاد المعجمة في الذي قبله ابو نضير قيل هي كنية عبد الله بن عمرو بن العاص حكاه الحاكم ابو احمد واورد بسند صحيح الي ابي عبد الرحمن الحبلي يقول سالت عبد الله بن عمرو وقيل له يا ابا نضير ابو نضير بفتح اوله وكسر الضاد المعجمة بن التيهان الانصاري الاوسي اخو ابي الهيثم ذكر ابو عمر عن الطبري انه شهد احدا ابو النعمان بشير بن سعد الانصاري تقدم في الاسماء ابو النعمان الازدي جد الطبراني وهو جد ايوب بن النعمان ويقال ايوب بن العلاء تقدم في حرف العين فيمن كنيته ابو العلاء ذكره ابو موسي عن الطبراني وقرات بخط ابي اسحاق الصريفيني قال روي علي بن حرب عن ابي معاوية حدثنا ابو عرفجة القابسي عن ابي النعمان الازدي ان رجلا خطب امراة فقال النبي صلي الله عليه وسلم اصدقها قال ما عندي شء قال اما تحسن سورة من القران فاصدقها السورة ولا تكون لاحد بعدك مهرا ثم رايته في كتاب ابي علي بن السكن ساقه بسنده الي يعقوب بن ابراهيم الدورقي عن ابي معاوية وقال هذه الزيادة لا تحفظ الا في هذه الرواية ابو النعمان اخر غير منسوب ذكره مطين ومحمد بن عثمان بن ابي شيبة في الصحابة واخرجه ابو نعيم عنهما وتبعه ابو موسي وحديثه في مسند يحيي بن عبد الحميد عن قيس بن الربيع عن جابر هو الجعفي عن عمرو بن يحيي بن سعيد بن العاص عن ابي النعمان ان النبي صلي الله عليه وسلم صلي علي امراة نفساء وابنها من الزنا وقد نسبه بن الكلبي انصاريا فقال روي عن النبي صلي الله عليه وسلم انه صلي علي امراة ماتت في نفاسها وابنها معها وقال لم يروه غير جابر بن يزيد الجعفي وليس يثبت ابو النعمان بن ابي النعمان عبد الرحمن بن النعمان الانصاري ذكره البغوي في الكني وذكر له الحديث الاتي في ترجمة معبد بن هوذة ولم ينبه علي ان اسمه معبد ابو نعيم محمود بن الربيع الانصاري ذكره ابو احمد الحاكم وتقدم ابو نمر الكناني جد شريك بن عبد الله بن ابي نمر ذكره بن سعد في مسلمة واستدركه الذهبي قلت وذكره ابو علي بن السكن في الصحابة واغفله بن عبد البر وابن فتحون مع استمدادهما كثيرا من كتاب بن السكن واورد بن السكن من طريق محمد بن طلحة التيمي حدثني عبد الحكم بن سفيان بن ابي نمر عن عمه عن ابيه قال خرج رسول الله صلي الله عليه وسلم في مغزاه ومعه عاءشة فمر بجانب العقيق فقال يا عاءشة هذا المنزل لولا كثرة الهوام قال بن السكن عبد الحكم هذا هو بن اخي شريك بن ابي نمر وقرات في اخبار المدينة لعمر بن شبة ان ابا نمر بن عويف من بني الحارث بن عبد مناة §  <> بن كنانة قدم المدينة فنزل علي بني ليث بن بكر فاختط داره في بني اخرم بن ليث فعرفت بدار ابي نمر ابو نملة الانصاري اسمه عمار بن معاذ بن زرارة بن عمرو بن غنم بن عدي بن الحارث بن مرة بن ظفر الانصاري الظفري شهد بدرا مع ابيه وشهد احدا وما بعدها وتوفي في خلافة عبد الملك بن مروان وقتل له ابنان يوم الحرة عبد الله ومحمد حديثه عند بن شهاب في اهل الكتاب من رواية نملة بن ابي نملة عن ابيه ذكره هكذا بن عبد البر وسبقه الي اكثره ابو علي بن السكن وابو احمد الحاكم وزاد وله اخ يكني ابا ذر امهما ام زرارة بنت الحارث وقال ابو بشر الدولابي انه عمارة بن معاذ وقال بن البرقي هو معاذ بن زرارة قال بن منده ابو نملة الانصاري له صحبة ثم ساق حديثه عاليا من رواية معمر ويونس كلاهما عن الزهري بن ابي نملة عن ابيه انهم بينا هم جلوس مع النبي صلي الله عليه وسلم اذ مرت جنازة فقال له رجل من اليهود هل تكلم هذه الجنازة يا محمد قال لا ادري قال فانها تتكلم فقال النبي صلي الله عليه وسلم ما حدثكم اهل الكتاب فلا تصدقوهم ولا تكذبوهم واخرجه بن السكن والحارث بن ابي اسامة من طريق يونس وزاد في اخره وقولوا امنا بالله وكتبه ورسله فان يك حقا فلم تكذبوهم وان كان باطلا لم تصدقوهم واخرج حديثه ابو داود وقال البغوي ابو نملة سكن المدينة وساق حديثه ووجدت لنملة بن ابي نملة عن ابيه حديثا اخرجه بن سعد وابو نعيم في الدلاءل من طريق محمد بن صالح عن عاصم بن عمرو بن قتادة عن نملة بن ابي نملة عن ابيه قال كانت يهود بني قريظة يدرسون ذكر رسول الله صلي الله عليه وسلم في كتبهم ويعلمونه الولدان بصفته واسمه ومهاجرته الينا فلما ظهر حسدوا وبغوا وقالوا ليس به ابو نملة اخر ذكره الدولابي وقال هو غير الانصاري ابو نهيك الانصاري الاشهلي ذكره ابو عمر فقال لا اعرف له خبرا ولا رواية الا انه بعثه ابو بكر الصديق الي خالد بن الوليد مع سلمة بن سلامة بن وقش يامره ان يقتل من بني حنيفة كل من انبت فوجداه قد صالح مجاعة بن مرارة ابو نيزر بكسر اوله وسكون التحتانية المثناة وفتح الزاي المنقوطة بعدها مهملة ذكره الذهبي مستدركا وقال يقال انه ولد النجاشي جاء واسلم وكان مع النبي صلي الله عليه وسلم في مءنته قلت وقرات قصته في كتاب الكامل لابي العباس المبرد وهي في ربعه الاخير قال حدثنا ابو محلم محمد بن هشام باسناد ذكره ان ابا نيزر كان من ابناء بعض ملوك الاعاجم فرغب في الاسلام صغيرا فاسلم عند النبي صلي الله عليه وسلم فكان معه في مءنته ثم كان مع فاطمة ثم مع ولدها وكان يقوم بضيعتي علي اللتين في البقيع تسمي احداهما البغيبغة والاخري عين ابي نيزر فذكر ان عليا اتاه فاطعمه طعاما فيه قرع صنعه له باهالة فاكل وشرب من الماء فذكر قصة انه كتب بتحبيس الضيعتين فذكر صفة شرطه ومنه انه وقفهما علي فقراء المدينة وابن السبيل الا ان يحتاج الحسن او الحسين فهما طلق وفي اخر الخبر ان الحسين احتاج لاجل دين عليه فبلغ ذلك معاوية فدفع له في عين ابي نيزر ماءة الف فابي ان يبيعها §  <> وامضي وقفها القسم الثاني لم يذكر فيه احد من الرجال القسم الثالث ابو نجيح المكي والد عبد الله بن ابي نجيح اسمه يسار تقدم ابو النعمان حجر بن عمرو ابو النعمان غير منسوب له ادراك قال ثور عن خالد بن معدان ان ابا النعمان حدثه قال حججت في ولاية فذكر قصة ذكره البخاري وتبعه ابو احمد الحاكم ابو نخيلة بخاء معجمة مصغرا العكلي له ادراك ذكره الامدي في الشعراء وانشد له هجاء في سجاح التي ادعت انها نبيه ثم خدعها مسيلمة الكذاب فتزوجها وسلمت له الامر ابو نمر بن عويف ذكر في ابي نمر جد شريك بن عبد الله بن ابي نمر القسم الرابع ابو نجيح العبسي ذكره ابو عمر فقال له حديث واحد في النكاح من رواية يزيد بن ابي حبيب عن حبيب بن لقيط عنه ذكره البخاري في الكني المجردة وهو عندهم عمرو بن عبسة قلت اختصره من كلام الحاكم ابي احمد دون قوله حديث واحد في النكاح ولكن لفظه ابو نجيح العبسي عن النبي صلي الله عليه وسلم روي ربيعة بن لقيط عن رجل عن ابي نجيح ثم اسند الي محمد بن اسماعيل يعني البخاري انه ذكره هكذا في الكني المجردة قال ابو احمد وهي كنية عمرو بن عبسة كما اخرجه بالاسناد الي يزيد بن ابي حبيب وكان قد اخرج في ترجمة عمرو بن عبسة من طريق بن لهيعة عن يزيد بن ابي حبيب حدثني ربيعة بن لقيط عن رجل من قيس يقال له ابو نجيح ان رسول الله صلي الله عليه وسلم قال يوما الا اخبركم بخير القباءل قلنا بلي يا رسول الله قال السكون سكون كندة الحديث قال بن لهيعة فحدثت به ثور بن يزيد قال ابو نجيح هو عمرو بن عبسة صاحب رسول الله صلي الله عليه وسلم وهذا الذي جزم به ابو احمد محتمل ويحتمل ايضا ان يكون غيره اذ لا يلزم من كونه من رواية يزيد بن ابي حبيب عن ربيعة بن لقيط ان يكون ابو نجيح العبسي هو عمرو بن عبسة وقد صرح في الحديث الذي ساقه انه رجل من قيس وكذا ترجم له بن منده فقال ابو نجيح القيسي روي حديثه ربيعة بن لقيط عن رجل عنه ولا يثبت وعلي ابي عمر اعتراض في قوله له حديث واحد في النكاح من §  <> رواية يزيد عن ربيعة فان الحديث الذي ورد عن ابي نجيح في النكاح ليس من رواة يزيد عن ربيعة كما قدمته في القسم الاول وقدمت ان ابا احمد الحاكم قال انه العرباض بن سارية وهو محتمل كما ان هذا يحتمل ايضا ان يكون غير عمرو بن عبسة ولكن شهادة ثور انه هو تقتضي المصير اليه واستشكل بن الاثير قوله العبسي لان عمرو بن عبسة سلمي وصوب قول بن منده انه قيسي لان سليما من قيس وهو كذلك لكن يحتمل ان الراوي نسبه الي والده عبسة ويكون ابو نصر الهلالي ارسل شيءا روي عنه قتادة عند النساءي وقد ارسل شيءا ذكره بعضهم في الصحابة وقال بن منده لا يعرف اسمه قلت واظن انه حميد بن هلال ابو النضر السلمي روي حديثه المعافي بن عمران الظهري عن مالك بن انس فقال في حديثه عن ابي النضر والصواب بن النضر هكذا في الموطا اورده بن منده هكذا وتبعه ابو نعيم وقال بن الاثير قد رواه بن ابي عاصم عن يعقوب بن حميد عن عبد الله بن نافع عن مالك عن عبد الله بن ابي بكر عن ابي النضر فيمن مات له ثلاثة من الولد يعني فلم يتفرد المعافي انتهي وابو النضر هذا هو حرف الهاء القسم الاول ابو هارون كلاب بن امية الليثي تقدم في الاسماء ابو هاشم بن عتبة بن ربيعة بن عبد شمس القرشي يكني ابا سفيان العبشمي اخو ابي حذيفة بن عتبة لابيه واخو مصعب بن عمير العبدري لامه امهما خناس بنت مالك العامري من قريش اختلف في اسمه فقيل مهشم وقيل خالد وبه جزم النساءي وقيل اسمه كنيته وبه جزم محمد بن عثمان بن ابي شيبة وقيل هشيم وقيل هشام وقيل شيبة قال بن السكن اسلم يوم فتح مكة ونزل الشام الي ان مات في خلافة عثمان قال بن منده روي عنه ابو هريرة وسمرة بن سهم وابو واءل وقال بن منده الصحيح ان ابا واءل روي عن سمرة عنه قلت وروي حديثه الترمذي وغيره بسند صحيح من طريق منصور الاعمش عن ابي واءل قال جاء معاوية الي ابي هاشم بن عتبة وهو مريض يعوده فقال يا خال ما يبكيك اوجع يشءزك او حرص علي الدنيا قال لا ولكن رسول الله صلي الله عليه وسلم عهد الي عهدا لم اخذ به قال اما يكفيك من الدنيا خادم ومركب في سبيل الله فاجدني قد جمعت واخرجه البغوي وابن السكن من طريق مغيرة عن ابي واءل عن سمرة بن سهم رجل من قومه قال نزلت علي ابي هاشم بن عتبة بن ربيعة فاتاه معاوية يعوده فبكي ابو هاشم فذكره وزاد بعد قوله علي الدنيا فقد ذهب صفوها وقال فيه عهدا وددت اني كنت تبعته قال انك لعلك ان تدرك اموالا تقسم بين اقوام وانما يكفيك فذكره §  <> وقد روي ابو هريرة عن ابي هاشم هذا حديثا اخرجه ابو داود والترمذي والنساءي والبغوي والحاكم ابو احمد من طريق كهيل بن حرملة قال قدم ابو هريرة دمشق فنزل علي ابي كلثوم الدوسي فاتيناه فتذاكرنا الصلاة الوسطي فاختلفنا فيها فقال ابو هريرة اختلفنا فيها كما اختلفتم ونحن بفناء بيت رسول الله صلي الله عليه وسلم وفينا الرجل الصالح ابو هاشم بن عتبة بن ربيعة فقام فدخل علي رسول الله صلي الله عليه وسلم وكان جريءا عليه ثم خرج الينا فاخبرنا انها العصر وذكر ابو الحصين الرازي ان داره كانت من سوق النحاسين الي سوق الحدادين وقال بن سعد اسلم في الفتح وخرج الي الشام فلم يزل بها حتي مات واخرج يعقوب بن سفيان من طريق بن اسحاق قال صالح ابو هاشم بن عتبة من اهل انطاكية في مقبره مصربن وغيرهما في سنة احدي وعشرين وقال بن البرقي ذهبت عينه يوم اليرموك ومات في زمن معاوية وذكر خليفة ان معاوية استعمله علي الجزيرة وقال ابو زرعة الدمشقي عن ابي مسهر قديم الموت وقد تقدم له ذكر في ترجمة ابي عبد الله صحابي غير منسوب ابو هالة التميمي هو النباش بن زرارة ذكره ابو احمد في الكني عن يحيي بن معين ابو هانء جد عبد الرحمن بن ابي مالك ذكره ابو عمر فقال قدم علي رسول الله صلي الله عليه وسلم فمسح راسه ودعا له بالبركة وانزله علي يزيد بن ابي سفيان روي حديثه عبد الرحمن بن ابي مالك عن ابيه عن جده ابي هانء ابو هبيرة عاءذ بن عمرو المزني ممن بايع تحت الشجرة تقدم في الاسماء كناه علي بن المديني واسند ذلك ابو احمد الحاكم عنه ابو هبيرة بن الحارث بن علقمة بن عمرو بن كعب بن مالك بن مبذول الانصاري الخزرجي النجاري ذكره بن اسحاق فيمن استشهد باحد وقد تقدم ذكره في حرف الالف لان الواقدي وغيره قالوا فيه ابو اسيرة وقال ابو عمر ابو هبيرة اسمه كينته وهو اخو ابي اسيرة كذا قال ابو هبيرة الانصاري غير منسوب اورده ابو يعلي في مسنده من طريق مخرمة بن بكير عن ابيه عن سعيد بن نافع قال راني ابو هبيرة الانصاري صاحب رسول الله صلي الله عليه وسلم وانا اصلي الضحي حين طلعت الشمس فعاب علي ذلك ونهاني ثم قال ان رسول الله صلي الله عليه وسلم قال لا تصلوا حتي ترتفع الشمس فانها تطلع بين قرني شيطان خلطه بن الاثير بالذي قبله ثم قال سعيد تابعي لم يدرك من يقتل باحد فان كان غيره والا فهو منقطع انتهي وكيف يحتمل ان يكون منقطعا وهو يصرح بانه راه فتعين الاحتمال الاول ابو هدم الحضرمي اخو العلاء ذكره الدارقطني كذا في التجريد ابو هدمة الانصاري ذكره ابو موسي في الذيل فقال ذكره المستغفري وقال روي عنه ابنه محمد من حديث بن اخي الزهري عن عمه ووقع عندنا من حديث ابي حاتم الرازي قال المستغفري قاله لي البردعي ابو هذيل غير منسوب ذكره ابو موسي ايضا وقال ذكره ابو بكر بن ابي علي §  <> وساق من طريق ابي الاشعث عن عبد الله بن خداش عن اوسط عن ابي الهذيل قال قال رسول الله صلي الله عليه وسلم لياكل الرجل من اضحيته ابو هراسة هو قيس بن عاصم ذكره البغوي عن بن ابي خيثمة عن بن معين ابو هريرة بن عامر بن عبد ذي الشري بن طريف بن عتاب بن ابي صعب بن منبه بن سعد بن ثعلبة بن سليم بن فهم بن غنم بن دوس بن عدنان بن عبد الله بن زهران بن كعب الدوسي هكذا سماه ونسبه بن الكلبي ومن تبعه كابي وقواه ابو احمد الدمياطي وقال بن اسحاق كان وسيطا في دوس واخرج الدولابي من طريق بن لهيعة عن يزيد بن ابي حبيب قال اسم ابي هريرة عبد نهم بن عامر وهو دوسي حليف لابي بكر الصديق وخالف بن البرقي في نسبه فقال هو بن عامر بن عبد شمس بن عبد الساطع بن قيس بن مالك بن ذي الاسلم بن الاحمس بن معاوية بن المسلم بن الحارث بن دهمان بن سليم بن فهم بن عامر بن دوس قال ويقال هو بن عتبة بن عمرو بن عيسي بن حرب بن سعد بن ثعلبة بن عمرو بن فهم بن دوس وقال ابو علي بن السكن اختلف في اسمه فقال اهل النسب اسمه عمير بن عامر وقال بن اسحاق قال لي بعض اصحابنا عن ابي هريرة كان اسمي في الجاهلية عبد شمس بن صخر فسماني رسول الله صلي الله عليه وسلم عبد الرحمن وكنيت ابا هريرة لاني وجدت هرة فحملتها في كمي فقيل لي ابو هريرة وهكذا اخرجه ابو احمد الحاكم في الكني من طريق يونس بن بكير عن بن اسحاق واخرجه بن منده من هذا الوجه مطولا واخرج الترمذي بسند حسن عن عبيد الله بن ابي رافع قال قلت لابي هريرة لم كنيت بابي هريرة قال كنت ارعي غنم اهلي وكانت لي هرة صغيرة فكنت اضعها بالليل في شجرة واذا كان النهار ذهبت بها معي فلعبت بها فكنوني ابا هريرة انتهي وفي صحيح البخاري ان النبي صلي الله عليه وسلم قال له يا ابا هر واخرج البغوي من طريق ابراهيم بن الفضل المخزومي وهو ضعيف قال كان اسم ابي هريرة في الجاهلية عبد شمس وكنيته ابو الاسود فسماه رسول الله صلي الله عليه وسلم عبد الله وكناه ابا هريرة واخرج بن خزيمة بسند قوي عن محمد بن عمرو عن ابي سلمة عن ابي هريرة عبد شمس من الازد ثم من دوس واخرج الدولابي بسند حسن عن اسامة بن زيد الليثي عن عبيد الله بن ابي رافع والمقبري قالا كان اسم ابي هريرة عبد شمس بن عامر بن عبد الشري والشري اسم صنم لدوس فلما اسلم سمي بعبد الله بن عامر وقال عبد الله بن ادريس عن شعبة كان اسم ابي هريرة عبد شمس وكذا قال يحيي بن معين واحمد بن صالح المصري وهارون بن حاتم وكذا قال ابو زرعة عن ابي مسهر وقال ابو نعيم الفضل بن دكين مثله وزاد ويقال عبد عمرو وقال مرة اخري ابو هريرة سكين ويقال عامر بن عبد غنم وكذا قال اسماعيل بن ابي اويس وجدت في كتاب ابي كان اسم ابي هريرة عبد شمس واسمه في الاسلام عبد الله وعن ابي نمير مثله وذكر الترمذي عن البخاري مثله وقال صالح بن احمد بن حنبل عن ابيه ابو هريرة عبد شمس ويقال عبد نهم ويقال عبد غنم ويقال سكين ويقال عبد الله بن عامر اخرجه البغوي عن صالح وكذا قال الاحوص بن المفضل العلاءي عن ابيه وكذا حكاه يعقوب بن سفيان في تاريخه وذكر بن ابي شيبة مثله وزاد ويقال عبد الرحمن بن صخر وذكر البغوي §  <> عن عبد الله بن احمد قال سمعت شيخا لنا كبيرا يقول اسم ابي هريرة سكين بن دومة وهذا حكاه الحسن بن سفيان بسنده عن ابي عمر الضرير وزاد ويقال عبد عمرو بن غنم وقال عمرو بن علي الفلاس عن سفيان بن حسين عن الزهري عن المحرر بن ابي هريرة كان اسم ابي عبد عمرو بن عبد غنم اخرجه اسلم بن سهل في تاريخه واخرجه البغوي عن المقدمي عن عمه سفيان ولفظه كان اسم ابي هريرة عبد الرحمن بن غنم كذا في رواية عيسي بن علي عن البغوي واخرجه بن ابي الدنيا من طريق المقدمي مثل ما قال عمرو بن علي وكذا هو في الذهليات عن عمر بن بكار عن عمرو بن علي المقدسي وقال بن خزيمة قال الذهلي هذا اوضح الروايات عندنا علي القلب قال بن خزيمة واسناد محمد بن عمرو عن ابي سلمة احسن من سفيان بن حسين عن الزهري عن المحرر الا ان يكون كان له اسمان قبل اسلامه واما بعد اسلامه فلا احسب اسمه استمر قلت انكر ان يكون النبي صلي الله عليه وسلم غير اسمه فسماه عبد الرحمن كما نقل احمد بن حنبل عن ابي عبيدة الحداد واخرج ابو محمد بن زيد عن الاصمعي ان اسمه عبد عمرو بن عبد غنم ويقال عمرو بن عبد غنم وجزم بالاول النساءي وقال البغوي حدثنا الحسن بن عرفة حدثنا ابو اسماعيل المءدب عن الاعمش عن ابي صالح عن ابي هريرة واسمه عبد الرحمن بن صخر قلت وابو اسماعيل صاحب غراءب مع ان قوله واسمه عبد الرحمن بن صخر يحتمل ان يكون من كلام ابي صالح او من كلام من بعده واخلق به ان يكون ابو اسماعيل الذي تفرد به والمحفوظ في هذا قول محمد بن اسحاق واخرج ابو نعيم من طريق اسحاق بن راهويه قال ابو هريرة مختلف في اسمه فقيل سكين بن مل وقيل بن هانء وقال بعضهم عمر بن عبد شمس وقيل بن عبد نهم وقال عباس الدوري عن ابي بكر بن ابي الاسود سكين بن جابر واخرج ابو احمد الحاكم بسند صحيح عن صالح بن كيسان قال اسمه عامر ومثله حكاه الهيثم بن عدي عن بن عباس وهو المسوق وزاد انه بن عبد شمس بن عبد غنم بن عبد ذي الشري وقال ابو مسهر عن سعيد بن عبد العزيز هو عامر بن عبد شمس وقيل عبد غنم وقيل سكين بن عامر وقال خليفة اختلف في اسمه فقيل عمير بن عامر وقيل سكين بن دومة ويقال عبد عمرو بن عبد غنم وقيل عبد الله بن عامر وقيل برير او يزيد بن عشرقة وقال الفلاس اختلفوا في اسمه والذي صح انه عبد عمرو بن عبد غنم ويقال سكين وقال البغوي حدثنا محمد بن حميد حدثنا ابو نميلة حدثنا محمد بن عبيد الله قال اسمه سعد بن الحارث قال البغوي وبلغني ان اسمه عبد ياليل وقال بن سعد عن الواقدي كان اسمه عبد شمس فسمي في الاسلام عبد الله ونقل عن الهيثم مثله وزاد البغوي عن الواقدي ويقال انه عبد الله بن عاءذ وقال بن البرقي اسمه عبد الرحمن ويقال عبد شمس ويقال عبد غنم ويقال عبد الله ويقال بل هو عبد نهم وقيل عبد تيم وحكي بن منده في اسماءه عبد بغير اضافة وفي اسم ابيه عبد غنم وحكي ابو نعيم فيه عبد العزي وسكن بفتحتين قال النووي في مواضع من كتبه اسم ابي هريرة عبد الرحمن بن صخر علي الاصح من ثلاثين قولا وقال القطب الحلبي اجتمع في اسمه واسم ابيه اربعة واربعون قولا مذكورة في الكني للحاكم وفي الاستيعاب وفي تاريخ بن عساكر قلت وجه تكثره انه يجتمع في اسمه خاصة عشرة اقوال مثلا وفي اسم ابيه نحوها ثم تركبت ولكن لا يوجد جميع ذلك منقولا فمجموع ما قيل §  <> في اسمه وحده نحو من عشرين قولا عبد شمس وعبد نهم وعبد تيم وعبد غنم وعبد العزي وعبد ياليل وهذه لا جاءز ان تبقي بعد ان اسلم كما اشار اليه بن خزيمة وقيل فيه ايضا عبيد بغير اضافة وعبيد الله بالاضافة وسكين بالتصغير وسكن بفتحتين وعمرو بفتح العين وعمير بالتصغير وعامر وقيل برير وقيل بر وقيل يزيد وقيل سعد وقيل سعيد وقيل عبد الله وقيل عبد الرحمن وجميعها محتمل في الجاهلية والاسلام الا الاخير فانه اسلامي جزما والذي اجتمع في اسم ابيه خمسة عشر قولا فقيل عاءذ وقيل عامر وقيل عمرو وقيل عمير وقيل غنم وقيل دومة وقيل هانء وقيل مل وقيل عبد نهم وقيل عبد غنم وقيل عبد شمس وقيل عبد عمرو وقيل الحارث وقيل عشرقة وقيل صخر فهذا معني قول من قال اختلف في اسمه واسم ابيه علي اكثر من ثلاثين قولا فاما مع التركيب بطريق التجويز فيزيد علي ذلك نحو ماءتين وسبعة واربعين من ضرب تسعة عشر في ثلاثة عشر واما مع التنصيص فلا يزيد علي العشرين فان الاسم الواحد من اسماءه يركب مع ثلاثة او اربعة من اسماء الاب الي ان ياتي العد عليهما فيخلص للمغايرة مع التركيب عدد اسماءه خاصة وهي تسعة عشر مع ان بعضها وقع فيه تصحيف او تحريف مثل بر وبرير ويزيد فانه لم يرد شيءا منها الا مع عشرقة والظاهر انه تغيير من بعض الرواة وكذا سكن وسكين والظاهر انه يرجع الي واحد وكذا سعد وسعيد مع انهما ايضا لم يردا الا مع الحارث وبعضها انقلب اسم مع ابيه كما تقدم في قوله من قال عبد عمرو بن عبد غنم وقيل عن غنم بن عبد عمرو فعند التامل لا تبلغ الاقوال عشرة خالصة ومزجها من جهة صحة النقل الي ثلاثة عمير وعبد الله وعبد الرحمن الاولان محتملان في الجاهلية والاسلام وعبد الرحمن في الاسلام خاصة كما تقدم قال بن ابي داود كنت اجمع سند ابي هريرة فرايته في النوم وانا باصبهان فقال لي انا اول صاحب حدثت في الدنيا وقد اجمع اهل الحديث علي انه اكثر الصحابة حديثا وذكر ابو محمد بن حزم ان مسند بقي بن مخلد احتوي من حديث ابي هريرة علي خمسة الاف وثلاثماءة حديث وكسر وحدث ابو هريرة ايضا عن ابي بكر وعمر والفضل بن العباس وابي بن كعب واسامة بن زيد وعاءشة وبصرة الغفاري وكعب الاحبار روي عنه ولده المحرر بمهملات ومن الصحابة بن عمر وابن عباس وجابر وانس وواثلة بن الاسقع ومن كبار التابعين مروان بن الحكم وقبيصة بن ذءيب وعبد الله بن ثعلبة وسعيد بن المسيب وعروة بن الزبير وسلمان الاغر والاغر ابو مسلم وشريح بن هانء وخباب صاحب المقصورة وابو سعيد المقبري وسليمان بن يسار وسنان بن ابي سنان وعبد الله بن شقيق وعبد الرحمن بن ابي عمرة وعراك بن مالك وابو رزين الاسدي وعبد الله بن قارظ وبسر بن سعيد وبشير بن نهيك وبعجة الجهني وحنظلة الاسلمي وثابت بن عياض وحفص بن عاصم بن عمرو وسالم بن عبد الله بن عمر وابو سلمة وحميد ابنا عبد الرحمن بن عوف وحميد بن عبد الرحمن الحميري وخلاس بن عمرو وزرارة بن ابي اوفي وسالم ابو الغيث وسالم مولي شداد وعامر بن سعد بن ابي وقاص وسعيد بن عمرو بن سعيد بن العاص وابو الحباب سعيد بن يسار وعبد الله بن الحارث البصري ومحمد بن سيرين وسعيد بن مرجانة والاعرج وهو عبد الرحمن بن هرمز والمقعد وهو عبد الرحمن بن سعيد ويقال له الاعرج ايضا وعبد الرحمن بن ابي نعيم وعبد الرحمن بن يعقوب والد العلاء §  <> وابو صالح السمان وعبيدة بن سفيان وعبيد الله بن عبد الله بن عتبة بن مسعود وعطاء بن مينا وعطاء بن ابي رباح وعطاء بن يزيد الليثي وعطاء بن يسار وعبيد بن حنين وعجلان والد محمد وعبيد الله بن ابي رافع وعنبسة بن سعيد بن العاص وعمرو بن الحكم ابو الساءب مولي بن زهرة وموسي بن يسار ونافع بن جبير بن مطعم وعبد الله بن رباح وعبد الرحمن بن مهران وعمرو بن ابي سفيان ومحمد بن زياد الجمحي وعيسي بن طلحة ومحمد بن قيس بن مخرمة ومحمد بن عباد بن جعفر ومحمد بن ابي عاءشة والهيثم بن ابي سنان وابو حازم الاشجعي وابو بكر بن عبد الرحمن بن الحارث بن هشام وابو الشعثاء المحاربي ويزيد بن الاصم ونعيم المجمر ومحمد بن المنكدر وهمام بن منبه وابو عثمان الطنبذي وابو قيس مولي ابي هريرة واخرون كثيرون قال البخاري روي عنه نحو الثمانماءة من اهل العلم وكان احفظ من روي الحديث في عصره قال وكيع في نسخته حدثنا الاعمش عن ابي صالح قال كان ابو هريرة احفظ اصحاب محمد صلي الله عليه وسلم واخرجه البغوي من رواية ابي بكر بن عياش عن الاعمش بلفظ ما كان افضلهم ولكنه كان احفظ واخرج بن ابي خيثمة من طريق سعيد بن ابي الحسن قال لم يكن احد من الصحابة اكثر حديثا من ابي هريرة وقال الربيع قال الشافعي ابو هريرة احفظ من روي الحديث في دهره وقال ابو الزعيزعة كاتب مروان ارسل مروان الي ابي هريرة فجعل يحدثه وكان اجلسني خلف السرير اكتب ما يحدث به حتي اذا كان في راس الحول ارسل اليه فساله وامرني ان انظر فما غير حرفا عن حرف وفي صحيح البخاري من طريق وهب بن منبه عن اخيه همام عن ابي هريرة قال لم يكن من اصحاب رسول الله صلي الله عليه وسلم اكثر حديثا مني الا عبد الله بن عمر فانه كان يكتب ولا اكتب وقال الحاكم ابو احمد بعد ان حكي الاختلاف في اسمه ببعض ما تقدم كان من احفظ اصحاب رسول الله صلي الله عليه وسلم والزمهم له صحبة علي شبع بطنه فكانت يده مع يده يدور معه حيث دار الي ان مات ولذلك كثر حديثه وقد اخرج البخاري في الصحيح من طريق سعيد المقبري عن ابي هريرة قلت يا رسول الله من اسعد الناس بشفاعتك قال لقد ظننت الا يسالني عن هذا الحديث احد اولي منك لما رايت من حرصك علي الحديث واخرج احمد من حديث ابي بن كعب ان ابا هريرة كان جريءا علي ان يسال رسول الله صلي الله عليه وسلم عن اشياء لا يساله عنها غيره وقال ابو نعيم كان احفظ الصحابة لاخبار رسول الله صلي الله عليه وسلم ودعا له بان يحببه الي المءمنين وكان اسلامه بين الحديبية وخيبر قدم المدينة مهاجر وسكن الصفة وقال ابو معشر المداءني عن محمد بن قيس قال كان ابو هريرة يقول لا تكنوني ابا هريرة فان النبي صلي الله عليه وسلم كناني ابا هر والذكر خير من الانثي واخرجه البغوي بسند حسن عن الوليد بن رباح عن ابي هريرة وقال عبد الرحمن بن ابي لبيبة اتيت ابا هريرة وهو ادم بعيد ما بين المنكبين ذو ضفيرتين افرق الثنيتين واخرج بن سعد من طريق قرة بن خالد قلت لمحمد بن سيرين اكان ابو هريرة مخشوشنا قال لا كان لينا قلت فما كان لونه قال ابيض وكان يخضب وكان يلبس ثوبين ممشقين وتمخط يوما فقال بخ بخ ابو هريرة يتمخط في الكتان وقال ابو هلال عن محمد بن سيرين عن ابي هريرة قال لقد رايتني اصرع بين منبر رسول الله صلي الله عليه وسلم وحجرة عاءشة فيقال مجنون وما بي §  <> جنون زاد يزيد بن ابراهيم عن محمد عنه وما بي الا الجوع ولهذا الحديث طرق في الصحيح وغيره وفيها سءال ابي بكر ثم عمر عن اية وقال لعل ان يسبقني فيفتح علي الاية ولا يفعل وقال داود بن عبد الله عن حميد الحميري صحبت رجلا صحب النبي صلي الله عليه وسلم اربع سنين كما صحبه ابو هريرة وقال بن عيينة عن اسماعيل بن ابي خالد عن قيس بن ابي حازم نزل علينا ابو هريرة بالكوفة واجتمعت احمس فجاءوا ليسلموا عليه فقال مرحبا صحبت رسول الله صلي الله عليه وسلم ثلاث سنين لم اكن احرص علي ان اعي الحديث مني فيهن وقال البخاري حدثنا ابو نعيم حدثنا عمر بن ذر حدثنا مجاهد عن ابي هريرة قال والله الذي لا اله الا هو ان كنت لاعتمد علي الارض بكبدي من الجوع واشد الحجر علي بطني فذكر قصة القدح واللبن وقال احمد حدثنا عبد الرحمن هو بن مهدي حدثنا عكرمة بن عمار حدثني ابو كثير حدثني ابو هريرة قال اما والله ما خلق الله مءمنا يسمع بي ولا يراني الا احبني قال وما علمك بذلك يا ابا هريرة قال ان امي كانت مشركة واني كنت ادعوها الا الاسلام وكانت تابي علي فدعوتها يوما فاسمعتني في رسول الله صلي الله عليه وسلم ما اكره فاتيت رسول الله صلي الله عليه وسلم وانا ابكي فذكرت له فقال اللهم اهد ام ابي هريرة فخرجت عدوا فاذا بالباب مجاف وسمعت حصحصة الماء ثم فتحت الباب فقالت اشهد ان لا اله الا الله وان محمدا رسول الله فرجعت وانا ابكي من الفرح فقلت يا رسول الله ادع الله ان يحببني وامي الي المءمنين فدعا له وقال الجريري عن ابي بصرة عن رجل من الطفاوة قال نزلت علي ابي هريرة قال ولم ادرك من الصحابة رجلا اشد تشميرا ولا اقوم علي ضيف منه وقال عمرو بن علي الفلاس كان مقدمه عام خيبر وكانت في المحرم سنة سبع وفي الصحيح عن الاعرج قال قال ابو هريرة انكم تزعمون ان ابا هريرة يكثر الحديث عن رسول الله صلي الله عليه وسلم والله الموعد اني كنت امرا مسكينا اصحب رسول الله صلي الله عليه وسلم علي ملء بطني وكان المهاجرين يشغلهم الصفق بالاسواق وكانت الانصار يشغلهم القيام علي اموالهم فحضرت من النبي صلي الله عليه وسلم مجلسا فقال من يبسط رداءه حتي اقضي مقالتي ثم يقبضه اليه فلن ينسي شيءا سمعه مني فبسطت بردة علي حتي قضي حديثه ثم قبضتها الي فوالذي نفسي بيده ما نسيت شيءا سمعته منه بعد واخرجه احمد والبخاري ومسلم والنساءي من طريق الزهري عن الاعرج ومن طريق الزهري ايضا عن سعيد بن المسيب وابي سلمة عن ابي هريرة يزيد بعضهم علي بعض واخرجه البخاري وغيره من طريق سعيد المقبري عنه مختصرا قلت يا رسول الله اني لاسمع منك حديثا كثيرا انساه فقال ابسط رداءك فبسطته ثم قال ضمه الي صدرك فضممته فما انسيت حديثا بعد واخرج ابو يعلي من طريق الوليد بن جميع عن ابي الطفيل عن ابي هريرة قال شكوت الي رسول الله صلي الله عليه وسلم سوء الحفظ فقال افتح كساءك فذكر نحوه واخرج ابو نعيم من طريق عبد الله بن ابي يحيي عن سعيد بن ابي هند عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال الا تسالني عن هذه الغناءم قلت اسالك ان تعلمني مما علمك الله قال فنزع نمرة علي ظهري ووسطها بيني وبينه فحدثني حتي اذا استوعبت حديثه قال اجمعها فصرها اليك فاصبحت لا اسقط حرفا مما حدثني وقد تقدمت طرق هذا الحديث الصحيحة وله طرق اخري منها عند ابي يعلي من طريق يونس بن عبيد §  <> عن الحسن عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال من ياخذ مني كلمة او كلمتين او ثلاثا فيصرهن في ثوبه فيتعلمهن ويعلمهن قال فنشرت ثوبي وهو يحدث ثم ضممته فارجو الا اكون نسيت حديثا مما قال واخرجه احمد من طريق المبارك بن فضالة عن الحسن نحوه وفيه فقلت انا فقال ابسط ثوبك وفي اخره فارجو الا اكون نسيت حديثا سمعته منه بعد ذلك واخرج بن عساكر من طريق شعبة عن سماك بن حرب عن ابي الربيع عن ابي هريرة كنت عند النبي صلي الله عليه وسلم فبسطت ثوبي ثم جمعته فما نسيت شيءا بعد هذا مختصر مما قبله ووقع لي بيان ما كان حدث به النبي صلي الله عليه وسلم في هذه القصة ان ثبت الخبر فاخرج ابو يعلي من طريق ابي سلمة جاء ابو هريرة فسلم علي النبي صلي الله عليه وسلم في شكواه يعوده فاذن له فدخل فسلم وهو قاءم والنبي صلي الله عليه وسلم متساند الي صدر علي ويده علي صدره ضامة اليه والنبي صلي الله عليه وسلم باسط رجليه فقال ادن يا ابا هريرة فدنا ثم قال ادن يا ابا هريرة ثم قال ادن يا ابا هريرة فدنا حتي مست اطراف اصابع ابي هريرة اصابع النبي صلي الله عليه وسلم ثم قال له اجلس فجلس فقال له ادن مني طرف ثوبك فمد ابو هريرة ثوبه فامسك بيده ففتحه وادناه من النبي صلي الله عليه وسلم فقال له النبي صلي الله عليه وسلم اوصيك يا ابا هريرة بخصال لا تدعهن ما بقيت قال اوصني ما شءت فقال له عليك بالغسل يوم الجمعة والبكور اليها ولا تلغ ولا تله واوصيك بصيام ثلاثة ايام من كل شهر فانه صيام الدهر واوصيك بركعتي الفجر لا تدعهما وان صليت الليل كله فان فيها الرغاءب قالها ثلاثا ثم قال ضم اليك ثوبك فضم ثوبه الي صدره فقال يا رسول الله بابي وامي اسر هذا او اعلنه قال اعلنه يا ابا هريرة قالها ثلاثا والحديث المذكور من علامات النبوة فان ابا هريرة كان احفظ الناس للاحاديث النبوية في عصره وقال طلحة بن عبيد الله لا اشك ان ابا هريرة سمع من رسول الله صلي الله عليه وسلم ما لم نسمع وقال بن عمر ابو هريرة خير مني واعلم بما يحدث واخرج النساءي بسند جيد في العلم من كتاب السنن ان رجلا جاء الي زيد بن ثابت فساله فقال له زيد عليك بابي هريرة فاني بينما انا وابو هريرة وفلان في المسجد ندعو الله ونذكره اذ خرج علينا رسول الله صلي الله عليه وسلم حتي جلس الينا فقال عودوا للذي كنتم فيه قال زيد فدعوت انا وصاحبي فجعل رسول الله صلي الله عليه وسلم يءمن علي دعاءنا ودعا ابو هريرة فقال اني اسالك ما سال صاحبك واسالك علما لا ينسي فقال رسول الله صلي الله عليه وسلم امين فقلنا يا رسول الله ونحن نسالك علما لا ينسي فقال سبقكم بها الغلام الدوسي واخرج الترمذي من طريق سعيد المقبري عن ابي هريرة قال قلت يا رسول الله اني اسمع منك اشياء لا احفظها قال ابسط رداءك فبسطته فحدث حديثا كثيرا فما نسيت شيءا حدثني به وسنده صحيح واصله عند البخاري بلفظ فما نسيت شيءا سمعته بعد واخرج الترمذي ايضا عن عمر انه قال لابي هريرة انت كنت الزمنا لرسول الله صلي الله عليه وسلم واحفظنا لحديثه واخرج بن سعد من طريق سالم مولي بني نصر سمعت ابا هريرة يقول بعثني رسول الله صلي الله عليه وسلم بن العلاء الحضرمي فاوصاه بي خيرا فقال لي ما تحب قلت اءذن لك ولا تسبقني بامين واخرجه البخاري من طريق سعيد المقبري عن ابي هريرة قال حفظت من رسول الله صلي الله عليه وسلم وعاءين فاما احدهما فبثثته §  <> واما الاخر فلو بثثته لقطع هذا البلعوم وعند احمد من طريق يزيد بن الاصم عن ابي هريرة وقيل له اكثرت فقال لو حدثتكم بما سمعت لرميتموني بالقشع اي الجلود وفي الصحيح عن نافع قال قيل بن عمر حديث ابي هريرة ان من اتبع جنازة فصلي عليها فله قيراط الحديث فقال اكثر علينا ابو هريرة فسال عاءشة فصدقته فقال لقد فرطنا في قراريط كثيرة واخرج البغوي بسند جيد عن الوليد بن عبد الرحمن عن بن عمر انه قال لابي هريرة انت كنت الزمنا لرسول الله صلي الله عليه وسلم واعلمنا بحديثه واخرج بن سعد بسند جيد عن سعد بن عمر بن سعيد بن العاص قال قالت عاءشة لابي هريرة انك لتحدث بشء ما سمعته قال يا امه طلبتها وشغلك عنها المكحلة والمراة وما كان يشغله عنها شء والاخبار في ذلك كثيرة واخرج البيهقي في المدخل من طريق بكر بن عبد الله بن ابي رافع عن ابي هريرة قال لقي كعبا فجعل يحدثه ويساله فقال كعب ما رايت رجلا لم يقرا التوراة اعلم بما في التوراة من ابي هريرة واخرج احمد من طريق عاصم بن كليب عن ابيه سمعت ابا هريرة يبتدء حديثه بان يقول قال رسول الله الصادق المصدوق ابو القاسم صلي الله عليه وسلم من كذب علي متعمدا فليتبوا مقعده من النار واخرج مسدد في مسنده من رواية معاذ بن المثني عنه عن خالد عن يحيي بن عبيد الله عن ابيه عن ابي هريرة قال بلغ عمر حديثي فقال لي كنت معنا يوم كنا في بيت فلان قلت نعم ان رسول الله صلي الله عليه وسلم قال يومءذ من كذب علي الحديث قال اذهب الان فحدث واخرج مسدد من طريق عاصم بن محمد بن يزيد بن عبد الله بن عمر عن ابيه قال بن عمر اذا سمع ابا هريرة يتكلم قال انا نعرف ما نقول ولكنا نجبن ويجترء وروينا في فواءد المزكي تخريج الدارقطني من طريق عبد الواحد بن زياد عن الاعمش عن ابي صالح عن ابي هريرة رفعه اذا صلي احدكم ركعتي الفجر فليضطجع علي يمينه فقال له مروان اما يكفي احدنا ممشاه الي المسجد حتي يضطجع قال لا فبلغ ذلك بن عمر فقال اكثر ابو هريرة فقيل لابن عمر هل تنكر شيءا مما يقول قال لا ولكنه اجرا وجبنا فبلغ ذلك ابا هريرة فقال ما ذنبي ان كنت حفظت ونسوا وقد اخرج ابو داود الحديث المرفوع واخرج بن سعد من طريق الوليد بن رباح سمعت ابا هريرة يقول لمروان حين ارادوا ان يدفنوا الحسن عند جده تدخل فيما لا يعنيك وكان الامير يومءذ غيره ولكنك تريد رضا الغاءب فغضب مروان وقال ان الناس يقولون اكثر ابو هريرة الحديث وانما قدم قبل وفاة رسول الله صلي الله عليه وسلم بيسير فقال ابو هريرة قدمت ورسول الله صلي الله عليه وسلم بخير وانا يومءذ قد زدت علي الثلاثين فاقمت معه حتي مات ادور معه في بيوت نساءه واخدمه واغزو معه واحج فكنت اعلم الناس بحديثه وقد والله سبقني قوم بصحبته فكانوا يعرفون لزومي له فيسالونني عن حديثه منهم عمر وعثمان وعلي وطلحة والزبير ولا والله لا يخفي علي كل حديث كان بالمدينة وكل من كانت له من رسول الله صلي الله عليه وسلم منزلة ومن اخرجه من المدينة ان يساكنه قال فوالله ما زال مروان بعد ذلك كافا عنه واخرج بن ابي خيثمة من طريق بن اسحاق عن عمر او عثمان بن عروة عن ابيه قال ابي ادنني من هذا اليماني يعني ابا هريرة فانه يكثر فادنيته فجعل يحدث والزبير يقول صدق كذب فقلت ما هذا قال صدق انه سمع هذا من رسول الله صلي الله عليه وسلم ولكن منها ما وضعه في غير موضعه وتقدم قول طلحة قد سمعنا §  <> كما سمع ولكنه حفظ ونسينا وفي فواءد تمام من طريق اشعث بن سليم عن ابيه سمعت ابي يحدث عن ابي هريرة فسالته فقال ان ابا هريرة سمع واخرج احمد في الزهد بسند صحيح عن ابي عثمان النهدي قال تضيفت ابا هريرة سبعا فكان هو وامراته وخادمه يقسمون الليل اثلاثا يصلي هذا ثم يوقظ هذا واخرج بن سعد بسند صحيح عن عكرمة ان ابا هريرة كان يسبح كل يوم اثنتي عشرة الف تسبيحة يقول اسبح بقدر ذنبي وفي الحلية من تاريخ ابي العباس السراج بسند صحيح عن مضارب بن حزن كنت اسير من الليل فاذا رجل يكبر فلحقته فقلت ما هذا قال اكثر شكر الله علي ان كنت اجيرا لبسرة بنت غزوان لنفقة رحلي وطعام بطني فاذا ركبوا سبقت بهم واذا نزلوا خدمتهم فزوجنيها الله فانا اركب واذا نزلت خدمت واخرجه بن خزيمة من هذا الوجه وزاد وكانت اذا اتت علي مكان سهل نزلت فقالت لا اريم حتي تجعلي لي في عصيدة فها انا ذا اتيت علي نحو من مكانها قلت لا اريم حتي تجعل لي عصيدة وقال عبد الرزاق اخبرنا معمر عن ايوب عن بن سيرين ان عمر استعمل ابا هريرة علي البحرين فقدم بعشرة الالف فقال له عمر استاثرت بهذه الاموال فمن اين لك قال خيل نتجت واعطية تتابعت وخراج رقيق لي فنظر فوجدها كما قال ثم دعاه ليستعمله فابي فقال لقد طلب العمل من كان خيرا منك قال ومن قال يوسف قال ان يوسف نبي الله بن نبي الله وانا ابو هريرة بن اميمة واخشي ثلاثا ان اقول بغير علم او اقضي بغير حكم ويضرب ظهري ويشتم عرضي وينزع مالي واخرج بن ابي الدنيا في كتاب المزاح والزبير بن بكار فيه من طريق بن عجلان عن سعيد عن ابي هريرة ان رجلا قال له اني اصبحت صاءما فجءت ابي فوجدت عنده خبزا ولحما فاكلت حتي شبعت ونسيت اني صاءم فقال ابو هريرة الله اطعمك قال فخرجت حتي اتيت فلانا فوجدت عنده لقحة تحلب فشربت من لبنها حتي رويت قال الله سقاك قال ثم رجعت الي اهلي وثقلت فلما استيقظت دعوت بماء فشربته فقال يا بن اخي انت لم تعود الصيام واخرج بن ابي الدنيا في المحتضرين بسند صحيح عن ابي سلمة بن عبد الرحمن قال دخلت علي ابي هريرة وهو شديد الوجع فاحتضنته فقلت اللهم اشف ابا هريرة فقال اللهم لا ترجعها قالها مرتين ثم قال ان استطعت ان تموت فمت والله الذي نفس ابي هريرة بيده لياتين علي الناس زمان يمر الرجل علي قبر اخيه فيتمني انه صاحبه قلت وقد جاء هذا الحديث مرفوعا عن ابي هريرة عن عمير بن هانء قال كان ابو هريرة يقول تشبثوا بصدغي معاوية اللهم لا تدركني سنة ستين واخرج احمد والنساءي بسند صحيح عن عبد الرحمن بن مهران عن ابي هريرة انه قال حين حضره الموت لا تضربوا علي فسطاطا ولا تتبعوني بمجمرة واسرعوا بي واخرج ابو القاسم بن الجراح في اماليه من طريق عثمان الغطفاني عن محمد بن عمرو عن ابي سلمة عن ابي هريرة قال اذا مت فلا تنوحوا علي ولا تتبعوني بمجمرة واسرعوا بي واخرج البغوي من وجه اخر عن ابي هريرة انه لما حضرته الوفاة بكي فسءل فقال من قلة الزاد وشدة المفازة واخرج بن ابي الدنيا من طريق مالك عن سعيد المقبري قال دخل مروان علي ابي هريرة في شكواه الذي مات فيها فقال شفاك الله فقال ابو هريرة اللهم اني احب لقاءك فاحبب لقاءي فما بلغ مروان بعين وسط السوق حتي مات وقال بن سعد عن الواقدي حدثني ثابت بن قيس عن ثابت بن مسحل قال صلي الوليد بن عقبة بن ابي سفيان علي ابي هريرة بعد ان صلي بالناس العصر وفي القوم بن عمر وابو سعيد الخدري قال وكتب الوليد §  <> الي معاوية يخبره بموته فكتب اليه انظر من ترك فادفع الي ورثته عشرة الاف درهم واحسن جوارهم فانه كان ممن نصر عثمان يوم الدار قال ابو سليمان بن زبر في تاريخه عاش ابو هريرة ثمانيا وسبعين سنة قلت وكانه ماخوذ من الاثر المتقدم عنه انه كان في عهد النبي صلي الله عليه وسلم بن ثلاثين سنة وازيد من ذلك وكانت وفاته بقصره بالعقيق فحمل الي المدينة قال هشام بن عروة وخليفة وجماعة توفي ابو هريرة سنة سبع وخمسين وقال الهيثم بن عدي وابو معشر وضمرة بن ربيعة مات سنة ثمان وخمسين وقال الواقدي وابو عبيد وغيرهما مات سنة تسع وخمسين وزاد الواقدي وصلي علي عاءشة في رمضان سنة ثمان وعلي ام سلمة في شوال سنة تسع ثم توفي بعد ذلك قلت وهذا الذي قاله في ام سلمة وهل منه وان تابعه عليه جماعة فقد ثبت في الصحيح ما يدل علي ان ام سلمة عاشت الي خلافة يزيد بن معاوية كما سياتي في ترجمتها والمعتمد في وفاة ابي هريرة قول هشام بن عروة وقد تردد البخاري فيه فقال مات سنة سبع وخمسين ابو هلال الكلبي قدم علي النبي صلي الله عليه وسلم روي حديثه علقمة بن هلال عن جده وقيل عن ابيه عن جده كذا اخرجه بن منده مختصرا وقال ابو نعيم ابو هلال التيمي قدم علي رسول الله صلي الله عليه وسلم حديثه عند اولاده ثم ساق حديثه عن الطبراني من طريق الوليد بن مسلم حدثني من سمع علقمة بن هلال من بني تيم الله يحدث عن ابيه عن جده انه قدم علي رسول الله صلي الله عليه وسلم في رجل من قومه وهو بالمدينة بعد مهاجرته اليها قال فوافيناه يضرب اعناق اساري علي ماء قليل فقتل عليه حتي سفح الدم الماء قال صفوان الراوي عن الوليد سفح معناه غطي وقال ابو موسي استدركه يحيي بن منده علي جده فقال ابو هلال التيمي وقد ذكره جده لكن لم يسند عنه شيءا قال بن الاثير التيمي والكلبي واحد لان تيم الله بطن كبير من كلب وهو تيم اللات بن رفيدة بن ثور بن كلب بن وبرة ابو هند والد نعيم بن ابي هند الاشجعي تقدم في النعمان بن اشيم ابو هند الحجام مولي بني بياضة قال بن السكن يقال اسمه عبد الله وقال ابن منده يقال اسمه يسار ويقال سالم قال وقال بن اسحاق هو مولي فروة بن عمرو البياضي من الانصاري وروي عنه بن عباس وجابر وابو هريرة ووقع في موطا بن وهب حجم رسول الله صلي الله عليه وسلم ابو هند يسار وقال بن اسحاق في المغازي ايضا لما انتهي رسول الله صلي الله عليه وسلم في رجوعه من بدر الي عرق الظبية استقبله ابو هند مولي فروة بن عمرو البياضي بحيس اي بزق مملوء حيسا وكان قد تخلف عن بدر وشهد المشاهد بعدها واخرج بن منده من طريق شعيب بن ابي حمزة عن الزهري قال كان جابر يحدث ان رسول الله صلي الله عليه وسلم احتجم علي كاهله من اجل الشاة التي اكلها حجمه ابو هند مولي بني بياضة بالقرن واخرج ابو نعيم من طريق حماد بن سلمة عن محمد بن عمرو عن ابي سلمة عن ابي هريرة ان ابا هند حجم النبي صلي الله عليه وسلم في اليافوخ من وجع كان به قال ان كان في شء مما تداوون به خير فالحجامة كذا قال حماد بن سلمة وخالفه الدراوردي فرواه عن محمد بن عمرو عن ابي سلمة عن ابي هند قال حجمت رسول الله صلي الله عليه وسلم في اليافوخ فقال ان كان في شء من الدواء خير فهو في هذه الحجامة يا بني بياضة انكحوا ابا هند وانكحوا اليه اخرجه بن جريج والحاكم ابو احمد §  <> عنه وذكر الحاكم في الاكليل انه حلق راس رسول الله صلي الله عليه وسلم في عمرة الجعرانة واخرج بن السكن والطبراني من طريق الزهري عن عروة عن عاءشة ان ابا هند مولي بني بياضة كان حجاما يحجم النبي صلي الله عليه وسلم فقال من سره ان ينظر الي من صور الله الايمان في قلبه فلينظر الي ابي هند وقال انكحوه وانكحوا اليه وسنده الي الزهري ضعيف واخرجه الحاكم ابو احمد مختصرا وزاد ونزلت يا ايها الناس ان خلقناكم من ذكر وانثي وذكر الواقدي في كتاب الردة عن زرعة بن عبد الله بن زياد بن لبيد ان ابا بكر الصديق ارسل ابا هند مولي بني بياضة الي زياد بن لبيد عامل كندة وحضرموت يخبره باستخلافه بعد النبي صلي الله عليه وسلم ابو هند الداري من بني الدار بن هانء بن حبيب مشهور بكنيته واختلف في اسمه فقيل برير ويقال بر بن عبد الله بن ربيع بن دراع بن عدي بن الدار بن عم تميم الداري وقال بن حبان الصحيح ان اسمه بر بن بر وقال برير وقيل برين ورايت في رجال الموطا لابن الحذاء الاندلسي في ترجمة تميم الداري وقيل ان ابا هند ليس اخا تميم فان ابا هند هو الليث بن عبد الله بن رزين كذا في نسخة معتمدة وما ادري هل هو هذا او لا وقال ابو عمر كان يقال انه اخوه وليس شقيقة وانما هو اخوه لامه وابن عمه قال ابو نعيم هو اخو تميم قدم مع تميم ومن معها علي النبي صلي الله عليه وسلم وسالوه ان يقطعهم ارضا بالشام فكتب لهما بها فلما كان زمن ابي بكر اتوه بذلك الكتاب فكتب لهم الي ابي عبيدة بانفاذه قلت والكتاب المذكور مشهور بيد ذرية تميم وقد كتبت في شانه جزءا سميته البناء الجليل بحكم بلد الخليل قال ابو عمر يعد في اهل الشام ومخرج حديثه عن ولده قلت اخرج ابو نعيم وغيره من رواية زياد بن فاءد بن زياد عن ابيه عن جده زياد بن ابي هند الداري عن ابيه هند سمعت رسول الله صلي الله عليه وسلم يقول يعني عن ربه من لم يرض بقضاءي ولم يصبر علي بلاءي فليلتمس ربا سواءي وزياد بفتح الزاي المنقوطة وتشديد التحتانية المثناة وكذا جده وفاءد بالفاء هو وولده ضعيفان وقد جاء عنهما عدة احاديث مناكير واخرج الحارث بن ابي اسامة في مسنده من طريق مكحول سمعت ابا هند الداري يقول سمعت رسول الله صلي الله عليه وسلم يقول من قام باخيه مقام رياء وسمعة راءي الله تعالي به يوم القيامة وسمع به ابو هند مولي النبي صلي الله عليه وسلم ذكره محمد بن حبيب في كتاب المحبر ابو هنيدة واءل بن حجر الحضرمي تقدم في الاسماء اخرج ابو احمد في الكني من طريق محمد بن حجر سمعت ابي او عمي يقول اهل بيتي يقولون واءل بن حجر يعني ابا هنيدة وانشد محمد بن حجر قول الشاعر ان الاغر ابا هنيدة ودني بوساءل وقضاء بيت واسع ابو هود سعيد بن يربوع المخزومي تقدم في الاسماء ابو الهيثم العباس بن مرداس كناه البخاري في الكني المجردة قاله ابو احمد وقد تقدم ذكره في الاسماء §  <> ابو الهيثم بن التيهان بفتح المثناة الفوقانية مع كسر الياء بن مالك بن عتيك بن عمرو بن عبد الاعلم بن عامر بن زعوراء الانصاري الاوسي وزعوراء اخو عبد الاشهل ويقال التيهان لقب واسمه مالك وهو مشهور بكنتيه وقد وقع في مصنف عبد الرزاق ان اسمه عبد الله قال بن اسحاق فيمن شهد بدرا ابو الهيثم واسمه مالك واخوه عتيك ابنا التيهان وقال في بيعة العقبة وكان نقيب بني عبد الاشهل اسيد بن حضير وابو الهيثم بن التيهان وقال بن السكن ذكر بن اسحاق ان ابا الهيثم من بلي من بني عمرو بن الحاف بن قضاعة حالف بن عبد الاشهل واخي النبي صلي الله عليه وسلم بينه وبين عثمان بن مظعون وشهد المشاهد كلها وكذا قال موسي بن عقبة عن بن شهاب فيمن شهد بدرا والعقبة وكان اول من بايع قال بن السكن روي ابو هريرة قصة ابي الهيثم بن التيهان حين راه رسول الله صلي الله عليه وسلم وابو بكر وعمر وكذلك روي عن عكرمة عن بن عباس هذه القصة مطولة وقد اختصر بعضهم منها حديث المستشار مءتمن فاسنده عن ابي الهيثم وجاء عنه حديث اخر ثم ساقه من طريق ايوب بن خالد عن ابي امامة بن سهل عن مالك بن التيهان قال قال رسول الله صلي الله عليه وسلم من قال السلام عليكم كتب له عشر حسنات ومن قال السلام عليكم ورحمة الله كتب له عشرون حسنة ومن قال السلام عليكم ورحمة الله وبركاته كتب له ثلاثون حسنة وقال الروايات عن ابي الهيثم كلها فيها نظر وليست تاتي من وجه يثبت وذلك لتقدم موته فقيل مات سنة عشرين ويقال قتل بصفين سنة سبع وثلاثين انتهي ونقل ابو عمر عن الاصمعي قال سالت قوم ابي الهيثم فقالوا مات في حياة النبي صلي الله عليه وسلم قال وهذا لم يتابع عليه قاءله قال وقيل انه توفي سنة احدي وعشرين وقيل شهد صفين مع علي وهو الاكثر وقيل انه قتل بها وهذا ساقه ابو بشر الدولابي من طريق صالح بن الوجيه وقال ممن قتل بصفين ابو الهيثم بن التيهان وعبد الرحمن بن بديل اخرون ثم اسند ابو عمر من طريق ابي نعيم الفضل بن دكين قال اصيب ابو الهيثم مع علي بصفين وقال ابو احمد الحاكم قيل مات علي عهد النبي صلي الله عليه وسلم وقيل مات سنة عشرين وقيل سنة احدي وعشرين وقيل شهد صفين وكان الاصوب قول من قال سنة عشرين او احدي وعشرين انتهي وقال الواقدي لم ار من يعرف ذلك ولا يثبته يعني انه قتل بصفين والقول بانه مات سنة عشرين نقله بن ابي خيثمة عن صالح بن كيسان عن الزهري وانشده ابو الربيع بن سالم الكلاعي لابي الهيثم في النبي صلي الله عليه وسلم بمرثية يقول فيها لقد جدعت اذاننا وانوفنا غداة فجعنا بالنبي محمد ابو الهيثم اخر افرده ابو موسي في الذيل عن بن التيهان فاصاب وساق من طريق الطبراني بسنده الي الوليد بن مسلم عن بن لهيعة عن بكر بن سوادة حدثني ابو الهيثم قال راني رسول الله صلي الله عليه وسلم اتوضا فقال بطن القدم يا ابا الهيثم واورده بعض اصحاب المسانيد في مسند ابي الهيثم بن التيهان وليس بجيد لان بكر بن سوادة لم يدركه وافرده ابو موسي عن بن التيهان لان بكر بن سوادة لم يلق بن التيهان فتبين ان غيره ابو الهيثم بن عتبة بن ابي لهب بن عبد المطلب بن هاشم الهاشمي وقع ذكره في §  <> حديث يدل علي ان له صحبة فقرات في كتاب السنة لابي الحسن بن السري خالد ولد بن السني حدثنا محمد بن صالح حدثني مروان بن ضرار الفزاري حدثني عبد الرحمن بن الحكم بن البراء بن قبيصة الثقفي حدثنا ابي عن عامر بن الاسود عن عبد الله بن الغسيل قال كنت مع النبي صلي الله عليه وسلم فمر العباس فقال يا عم اتبعني بنيك فقال له ابو الهيثم بن عتبة بن ابي لهب يا عم انظرني حتي اجيءك فلم ياتهم فانطلق بستة من بنيه فذكر كقصة ابو الهيثم من الجن ذكر الشبلي في اكام المرجان قال دخل رجل المدينة فاخبر عن ابي موسي الاشعري بخبر فشاع ذلك ولم يعرف الرجل فبلغ ذلك عمر فقال هذا ابو الهيثم بريد المسلمين من الجن وسياتي بريد المسلمين من الانس فجاءه بعدها بايام ابو هيصم المزني وقع ذكره في اخبار المدينة لابن زبالة قال الزبير بن بكار حدثنا محمد بن الحسن عن عبد الله بن عمر عن محمد بن هيصم المزني عن ابيه قال دعا رسول الله صلي الله عليه وسلم ابي فقال اني مستعملك علي هذا الوادي فمن جاءك من هاهنا وها هنا فامنعه فقال اني رجل ليس لي الا بنات وليس معي احد يعاونني فقال ان الله سيرزقك ولدا ويجعل لك اولياء قال فعمل عليه وكان له بعد ذلك ولد فلم يزل الولاة يولون عليه وبه الي محمد بن هيصم عن ابيه عن جده ان رسول الله صلي الله عليه وسلم اشرف علي وسط البقيع فصلي فيه القسم الثاني ابو هارون مسعود بن الحكم الزرقي تقدم في الاسماء القسم الثالث ابو هاشم بن مسعود بن سنان بن ابي حارثة المزي له ادراك ومن ذريته ابراهيم بن محمد بن زياد بن سويد بن ابي هاشم وهو القاءل مهما فعلت فليس عندك من حاليك الا دون ما عندي القسم الرابع ابو هاشم مولي رسول الله صلي الله عليه وسلم تابعي ارسل حديثا فذكره ابو موسي في الذيل علي المعرفة فاخرج من طريق ابي نعيم اظنه في كتابه في فضاءل الصحابة من طريق يحيي بن يعلي عن ابي عبد الرحمن حلو بن السري الازدي حدثنا ابو هاشم مولي رسول الله صلي الله عليه §  <> وسلم قال كانت امي امة لرسول الله صلي الله عليه وسلم هو اعتق ابي وامي ان رسول الله صلي الله عليه وسلم جاء الي المسجد فوجد عليا وفاطمة مضطجعين قد غشيتهما الشمس فقام عند رءوسهما وعليه كساء خيبري فمده دونهم ثم قال قوما احب باد وحاضر ثلاث مرات ومن طريق عبد الله بن موسي حدثنا حلو الازدي عن ابي هاشم عن ابيه وكان مولي رسول الله صلي الله عليه وسلم ان رسول الله صلي الله عليه وسلم خرج غازيا فذكر الحديث مطولا قال ابو موسي فعلي هذا فالحديث لوالد ابي هاشم وقد جاء عن يحيي بن يعلي فقال عن حلو عن ابي هاشم عن ابيه ابو هاشم بن نافع اسمه عمر روي عنه ابنه عبد الله قال مسلم وقال البخاري نافع مولي بني هاشم سمع عمر قاله الحكم بن عيينة عن بن قانع عن ابيه ذكره هكذا ابو احمد الحاكم ثم قال والقلب الي قول محمد بن اسماعيل اميل قلت فكانه راي ان قول مسلم ابو هاشم تصحيف من قول بني هاشم فلو كان كما عند مسلم لكان من اهل القسم الثالث والله اعلم ابو هند الانصاري افرده بن منده عن البياضي وهما واحد قال بن منده روي حجاج عن بن جريج عن ابي الزبير عن جابر فوهم فيه ورواه اصحاب ابي الزبير عن ابي الزبير عن جابر ان ابا حميد اتي النبي صلي الله عليه وسلم بقدح وهو الصواب فجنح بن منده الي انه تصحيف من ابي حميد واما بن السكن فاورده في ترجمة ابي هند البياضي فاصاب ونبه مع ذلك علي ان المحفوظ ان الحديث عن ابي حميد فعلي التقديرين فعده زاءدا غلط وساقه بن السكن من رواية زياد بن ايوب عن حجاج ثم قال يقال هو خطا لان زكريا بن اسحاق رواه عن ابي الزبير عن جابر عن ابي حميد وكذا رواه الاعمش عن ابي سفيان عن جابر عن ابي حميد ابو هند البجلي شامي تابعي ارسل شيءا فذكره العسكري في الصحابي وقال عبد الحق في الاحكام ليس بمشهور روي عنه عبد الرحمن بن ابي عوف وحديثه عند ابي داود والنساءي حرف الواو القسم الاول ابو واثلة الهذلي قال بن عساكر له صحبة وشهد فتوح الشام واخرج له احمد في مسنده من طريق بن اسحاق حدثني ابان بن صالح عن شهر بن حوشب عن رجل من قومه كان خلف علي امه بعد ابيه وشهد طاعون عمواس قال لما اشتد الوجع قام ابو عبيدة فذكر الخبر في وفاته ثم وفاة معاذ بن جبل ووصله ابنه عبد الرحمن ثم قام عمرو بن العاص فقال تفرقوا من هذا الوجع في الجبال فقال له ابو واثلة الهذلي كذبت والله لقد صحبت رسول الله صلي الله عليه وسلم وانت شر من حماري §  <> هذا قال والله ما ارد عليك ما تقول ثم خرج وخرج الناس وتفرقوا ورفعه الله عنهم قال بن عساكر لا اعرفه الا من هذه الرواية وقد رويت هذه القصة من وجه اخر عن شهر عن عبد الرحمن بن غنم ونسب الكلام المذكور فيها بمعناه لشرحبيل بن حسنة فلعل من رد علي عمرو في ذلك متعدد والله اعلم ابو واقد الليثي مختلف في اسمه قيل الحارث بن مالك وقيل بن عوف وقيل عوف بن الحارث بن اسيد بن جابر بن عبد مناة بن شجع بن عامر بن ليث بن بكر بن عبد مناة بن علي بن كنانة كان حليف بن اسد قال البخاري وابن حبان والباوردي وابو احمد الحاكم شهد بدرا وقال ابو عمر قيل شهد بدرا ولا يثبت وقال بن سعد اسلم قديما وكان يحمل لواء بني ليث وضمرة وسعد بن بكر يوم الفتح وحنين وفي غزوة تبوك يستنفر بني ليث وكان خرج الي مكة فجاور بها سنة فمات وقال في موضع اخر دفن في مقبرة المهاجرين روي عن النبي صلي الله عليه وسلم وعن ابي بكر وعن عمر واسماء بنت ابي بكر روي عنه ابناه عبد الملك وواقد وابو سعيد الخدري وعطاء بن يسار وعروة واخرون وقال ابو عمر كان قديم الاسلام وكان معه لواء بني ليث وضمرة وسعد بن بكر يوم الفتح وقيل انه من مسلمة الفتح والاول اصح يعد في اهل المدينة وقد انكر ابو نعيم علي من قال انه شهد بدرا وقال بل اسلم عام الفتح او قبل الفتح وقد شهد علي نفسه انه كان بحنين قال ونحن حديثوا عهد بكفر انتهي وقد نص الزهري علي انه اسلم يوم الفتح واسند ذلك عن سنان بن ابي سنان الدءلي اخرجه بن منده بسند صحيح الي الزهري ومستند من قال انه شهد بدرا ما اورده يونس بن بكير في مغازي بن اسحاق عنه عن ابيه عن رجال من بني مازن عن ابي واقد قال اني لاتبع رجلا من المشركين يوم بدر لاضربه بسيفي فوقع راسه قبل ان يصل اليه سيفي فعرفت ان غيري قد قتله ويعارض قول من قال انه شهد بدرا ما ذكره الواقدي انه مات زمن ثمان وستين وله خمس وسبعون فانه يقتضي انه ولد بعد وقعة بدر وقيل مات بن خمس وسبعين سنة فعلي هذا يكون في وقعة بدر بن اثنتي عشرة سنة وعلي هذا ينطبق قول ابي حسان الزيادي انه ولد في السنة التي ولد فيها بن عباس ووافق ابو عمر علي ما قال الواقدي ثم قال وقيل مات سنة خمس وثمانين وبهذا الاخير جزم البغوي واخرون ونقل البخاري انه مات في خلافة معاوية واخرج البخاري بسند حسن عن اسحاق مولي محمد بن زياد انه سمع ابا واقد يقول رايت الرجل من العدو يوم اليرموك يسقط فيموت واخرجه خليفة من هذا الوجه فقال اسحاق مولي زاءدة وزاد في اخره حتي قلت في نفسي لو ان اضرب احدهم بطرف رداءي مات قال بن عساكر في مسند بن اسحاق من لا يعرف والصحيح ما قال الزهري عن سنان والقصة التي ذكرها بن اسحاق انما كانت لابي واقد يوم اليرموك كما تقدم ابو واقد مولي النبي صلي الله عليه وسلم ذكره بن منده فقال روي عنه زاذان بن عمر ثم ساق من طريق الهيثم بن جماز عن الحارث بن عتبان عن زاذان عنه رفعه فقال من اطاع الله فقد ذكر الله وان كثرت صلاته وصيامه وتلاوته للقران الحديث ابو واقد جوز الذهبي ان يكون الذي جزم البخاري وغيره بانه شهد بدرا اخر غير الليثي §  <> ابو واقد النميري ذكره بن شاهين في الصحابة واخرج من طريق ابي خيثم عن نافع بن سرجس عن ابي واقد النميري قال كان رسول الله صلي الله عليه وسلم اخف الناس صلاة علي الناس وادومها علي نفسه ابو وحوح الانصاري ذكره البغوي واخرج من طريق بن لهيعة عن الحارث بن يعقوب عن ابي شعيب مولي ابي وحوح قال غسلنا ميتا فدخل علينا ابو وحوح الانصاري صاحب النبي صلي الله عليه وسلم وقد لفت ابطه فجعل يباينه ويقول والله ما نحن بانجاس احياء ولا اموات والله اني خشيت ان تكون سنة ابو وداعة السهمي اسمه الحارث بن سبرة اسلم هو وابنه المطلب في الفتح قال بن عبد البر واسند بن منده من طريق اسماعيل بن عياش عن عبد الله بن عطاء المكي عن ابي سفيان بن عبد الرحمن بن ابي وداعة السهمي عن ابيه عن جده قال رايت رسول الله صلي الله عليه وسلم يصلي في باب بني سهم والناس يصلون بصلاته قال كذا قال وانما هو عن ابي سفيان بن عبد الرحمن بن المطلب بن ابي وداعة ابو وديعة ذكره البغوي ولم يخرج له شيءا ابو الورد المازني ذكره ابو عمر فقال قيل اسمه حرب له صحبة سكن مصر وله عندهم حديث واحد اياكم والسرية التي ان لقيت فرت وان غنمت غلت ويروي عنه مرفوعا وهو عند ابي لهيعة عن يزيد بن ابي حبيب عن لهيعة بن عتبة عنه قلت اخرجه بن ماجة والبغوي وتقدم ذكره في عبيد بن قيس وبيان الاختلاف في اسمه ابو الورد بن قيس بن قهد الانصاري قال بن الكلبي شهد مع علي صفين خلطه ابو عمر بالذي قبله والذي يظهر لي انه غيره ابو الورد غير منسوب قال بن منده روي حبيب بن الشهيد عن محمد بن سيرين ان ابا ايوب الانصاري قال اتيت النبي صلي الله عليه وسلم بابن عم لي ورجل احمر يبايعه فقال له النبي صلي الله عليه وسلم يا ابا الورد واخرج هو وعبدان من طريق جبارة بن المغلس عن بن المبارك عن حميد الطويل عن بن ابي الدرداء عن ابيه قال راي النبي صلي الله عليه وسلم رجل احمر فقال انت ابو الورد واظنه الذي ذكره ابو ايوب ابو الوصل استدركه ابو موسي وقال ذكره بن منده في تاريخه في ترجمة بعض احفاده واغفله في الصحابة واخرج من طريق احمد بن رشدين عن ابراهيم بن اسماعيل بن ابراهيم بن واصل بن اسحاق بن عبد الله بن يزيد بن قسيط بن ابي الوصل صاحب النبي صلي الله عليه وسلم عن اباءه ان ابا الوصل غزا مع النبي صلي الله عليه وسلم ذكره في ترجمة ابراهيم بن اسماعيل ابو الوقاص غير منسوب ذكره المستغفري واستدركه ابو موسي من طريقه ثم من رواية صالح بن سليمان عن غياث بن عبد الحميد عن مطر عن الحسن عن ابي وقاص صاحب النبي صلي الله §  <> عليه وسلم قال سهام المءذنين عند الله يوم القيامة كسهام المجاهدين وهم فيما بين الاذان والاقامة كالمتشحط بدمه في سبيل الله عز وجل قال عمر لو كنت مءذنا لكمل امري وذكر فيه عن عمر شيءا مرفوعا وفيه ان الله حرم لحوم المءذنين علي النار وهو يشعر ان عمر حضر القصة فقال ذلك فيكون الحديث عن هذا الصحابي مرفوعا وهذا هو الظاهر فان مثل هذا لا يقال بالراي ويحتمل ان يكون حدث به عمر فحدث عمر بما سمع ثم اورده من وجه اخر عن صالح بن سليمان قال بنحوه وزاد وقال عبد الله بن مسعود ما باليت الا احج ولا اعتمر ولا اجاهد وقالت عاءشة ولهم هذه الاية ومن احسن قولا ممن دعا الي الله وعمل صالحا الاية قلت وصالح بن سليمان هذا ضعيف وشيخه غياث بكسر المعجمة ثم تحتانية خفيفة ثم مثلثة ذكره الذهبي في الميزان وقال له حديث منكر ما اظن له غيره فذكره قلت وليس كما ظن فهذا اخر وقد اورد الخطيب في المءتلف ترجمة غياث من رواية يعقوب بن سفيان عن صالح فذكر الحديث الاول موقوفا ثم قال فذكر حديثا طويلا ولم يصله في رواية بالصحبة ابو الوليد حسان بن ثابت الانصاري الخزرجي وسهل بن حنيف الانصاري وعبادة بن الصامت وعتبة بن عبد السلمي تقدموا ابو وهب الجشمي اخرج له ابو داود والنساءي من طريق محمد بن مهاجر عن عقيل بن شبيب عن ابي وهب الجشمي وكانت له صحبة عن النبي صلي الله عليه وسلم في الخيل وفيه امسحوا بنواصيها وبهذا الاسناد رفعه عليكم بكل كميت اغر محجل الحديث قال البغوي سكن الشام وله حديثان فاخرج حديث الخيل وحديث تسموا باسماء الانبياء واحب الاسماء الي الله عبد الله وعبد الرحمن الحديث وذكره بن السكن وغير واحد في الصحابة وقال ابو احمد في الكني له صحبة وحديثه في اهل اليمامة واخرج من طريق ابي زرعة الرازي عن محمد بن رافع عن هشام بن سعيد عن محمد بن مهاجر الحديثين في الخيل والحديث في الاسماء مساقا واحدا وقال في اوله ايضا وكانت له صحبة وادعي ابو حاتم الرازي فيما حكاه عنه ابنه في العلل ان هذا الجشمي هو الكلاعي التابعي المعروف وان بعض الرواة وهم في قوله الجشمي وفي قوله وكانت له صحبة وزعم بن القطان الفاسي ان بن ابي حاتم وهم في خلطه ترجمة الجشمي بالكلاعي وكنت اظن انه كما قال حتي راجعت كتاب العلل فوجدته ذكره في كتاب العين ونقل عن ابيه انه نقب عن هذا الحديث حتي ظهر له انه عن ابي وهب الكلاعي وانه مرسل وان بعض الرواة وهم في نسبته جشميا وفي قوله ان له صحبة وبين ذلك بيانا شافيا ابو وهب صفوان بن امية الجمحي وشجاع بن وهب الاسدي والوليد بن عقبة الاسدي ومجزاة بن ثور تقدموا في الاسماء ابو وهب الجيشاني هو ديلم بن هوشع تقدم شرح حاله في الدال في الاسماء بما يغني عن الاعادة ابو وهب الانصاري روي عن النبي صلي الله عليه وسلم في القول اذا اخذ مضجعه من رواية خالد بن معدان قال الذهبي اخرجه السلفي فيما انتخبه من الفواءد لابن الطيوري قال وسنده §  <> قوي ولعله مرسل ابو وهب الكلبي ذكره بن مندة واخرج من طريق سعد بن الصلت عن ابراهيم بن محمد الاسلمي عن يحيي بن وهب الكلبي عن ابيه عن جده قال كتب رسول الله صلي الله عليه وسلم لال اكيدر كتابا فيه امان لهم من الظلم ولم يكن يومءذ معه خاتم فختمه لهم بظفره قال وذكره الواقدي عن اسحاق بن حبان عن يحيي بن وهب وادعي ابو نعيم انه عبد الملك صاحب دومة الجندل وفيه نظر وقد رده بن الاثير واظن قوله هو الصواب القسم الثاني ابو الوليد عبد الله بن عبد الله بن الهاد تقدم في الاسماء القسم الثالث ابو واءل شقيق بن سلمة الاسدي تقدم في الاسماء ابو وجزة السعدي له ادراك قال بن عساكر اظنه جد ابي وجزة الشاعر الذي روي عنه هشام بن عروة وقدم الشام مع عمر ثم ساق من طريق ابي رجاء التميمي عن الساءب بن يزيد المخزومي قال لما اتي عمر الشام نهي الناس ان يمدحوا خالد بن الوليد فدخل ابو وجزة السعدي وخالد عند عمر فقال اههنا خالد فحسر خالد اللثام عنه فقال له ابو وجزة والله انك لاصبحهم خدا واكرمهم جدا واوسعهم مجدا وابسطهم رفدا قال ثم راه عمر بالمدينة فقال الم انه عن مدح خالد عندي فقال ابو وجزة من اعطانا مدحناه ومن حرمنا سببناه كما يسب العبد سيده فقال عمر يا ابا وجزة وكيف يسب العبد سيده قال من حيث لا يعلم ولا يسمع يا امير المءمنين وجوز بن عساكر ان يكون هذا هو الحارث بن ابي وجزة الذي تقدم ذكره في القسم الاول من حرف الحاء وليس بجيد لان ذاك قرشي وهذا سعدي وسياق القصتين مختلف جدا والله اعلم القسم الرابع ابو وديعة غير منسوب استدركه ابو موسي وقال اورده محمد بن المسيب وجعفر المستغفري في الصحابة واخرج من طريقهما من رواية بشر بن الوليد عن ابي معشر عن سعيد المقبري عن ابيه عن ابي وديعة صاحب رسول الله صلي الله عليه وسلم قال قال رسول الله صلي الله عليه وسلم من اغتسل يوم الجمعة كغسله من الجنابة ومس من طيب او من دهن كان عنده ولبس احسن ما كان عنده من الثياب §  <> ثم لم يفرق بين اثنين وانصت الي الامام اذا جاء غفر له ما بين الجمعتين قلت وقول الراوي في السند صاحب رسول الله صلي الله عليه وسلم وهم فان ابا وديعة هذا تابعي معروف واسمه عبد الله بن وديعة اخرج حديثه البخاري من طريق بن ابي ذءب عن سعيد المقبري عن ابيه عن سلمان وقد رواه يحيي بن القطان عن محمد بن عجلان عن سعيد فقال عن ابي ذر بدل سلمان اخرجه بن ماجة وقد اقره بن الاثير فلم يتنبه لعلته واعجب منه الذهبي فانه قال في التجريد واورده المستغفري في الصحابة باسناد مقارب بين يعني ما اخرجه موسي قلت وابو معشر هو نجيح المدني ضعيف وسنده مقارب كما قال لو لم يخالف لكن مع المخالفة انما يقال له انه منكر وقد غلط في اسقاط الصحابي وتبقية وصفه والله المستعان حرف الياء اخر الحروف القسم الاول ابو يحيي صهيب بن سنان الرومي وابو يحيي عبد الله بن انيس الجهني وابو يحيي سنان جد يحيي بن عباد تقدموا في الاسماء ابو يحيي اسيد بن حضير الانصاري ويقال كنيته ابو عتيك تقدم ابو يحيي المقدام بن معد يكرب الكندي ويقال كنيته ابو كريمة ابو يحيي خريم بن فاتك الاسدي ويقال كنيته ابو ايمن ابو يحيي خباب بن الارت التميمي ويقال كنيته ابو عبد الله ابو يحيي سهل بن ابي حثمة الانصاري ويقال كنيته ابو محمد ابو يحيي عبد الله بن كعب بن عمرو بن عوف الانصاري البدري قال الحاكم ابو احمد قال الواقدي سمعت بعض الانصار يقول كنيته ابو يحيي كلهم تقدموا في الاسماء ابو يحيي الانصاري من بني حارثة ذكره بن اسحاق عن عاصم بن عمر عن انس قال كان ابعد الناس من المسجد رجلان من الانصار ابو لبابة وابو يحيي من بني حارثة فقال اخرجه الطبراني في ترجمة ابو لبابة ابو يحيي الانصاري قال البغوي لا ادري له صحبة ام لا ثم اورد من طريق الليث عن عبد الله بن يحيي الانصاري عن ابيه عن جده ان جدته اتت النبي صلي الله عليه وسلم بحلي لها وفيه لا يجوز لامراة في مالها امر الا باذن زوجها ابو يربوع سعيد بن يربوع تقدم في الاسماء ذكره ابو احمد §  <> ابو يزيد عقيل بن ابي طالب الهاشمي ابو يزيد سهل بن عمرو العامري ابو يزيد الساءب بن يزيد بن اخت النمر ابو يزيد انيس بن مرثد بن ابي مرثد الغنوي ابو يزيد معن بن يزيد الاخنس الاسلمي تقدموا في الاسماء ابو يزيد معقل بن سنان الاشجعي ويقال كنيته ابو محمد ويقال ابو عبد الرحمن تقدم ابو يزيد حارثة بن قدامة بن مالك التميمي السعدي ويقال كنيته ابو ايوب تقدم ابو يزيد بن عمرو الجذامي ذكره الواقدي فيمن اسلم من جذام واستدركه ابو علي الجياني وابن الدباغ وقد تقدم في حرف الزاي من الكني ابو زيد الجذامي فلا ادري اهو هذا او اخر ابو يزيد والد حكيم له حديث اختلف فيه علي عطاء بن الساءب قال الدوري عن بن معين روي عطاء بن الساءب عن حكيم بن ابي يزيد الكرخي عن ابيه عن النبي صلي الله عليه وسلم قيل له كانت لابيه صحبة قال لا ادري قلت اما بيان الاختلاف فيه فقال جرير عن عطاء عن حكيم بن ابي يزيد الكرخي عن ابيه قال قال رسول الله صلي الله عليه وسلم دعوا الناس يصيب بعضهم من بعض فاذا استنصح احدكم اخاه فلينصح له وذكره البخاري تعليقا ووصله ابو احمد وكذا قال عبد الوارث بن سعيد عن عطاء وكذا قال حماد بن زيد واسماعيل بن علية عن عطاء اخرجهما بن السكن واخرج رواية بن علية الحسن بن سفيان وقال وهيب بن خالد عن عطاء عن حكيم بن ابي يزيد اتبعته في حاجة فحدثني عن ابيه عن النبي صلي الله عليه وسلم اخرجه بن ابي خيثمة وقال البخاري في الكني ابو يزيد ممن سمع النبي صلي الله عليه وسلم قال ابو عوانة عن عطاء بن الساءب عن حكيم بن ابي يزيد عن ابيه ووصله في التاريخ عن مسدد عن ابي عوانة وكذا اخرجه احمد من رواية ابي عوانة ووافقه همام بن يحيي عند الطيالسي قلت ويحتمل ان كان محفوظا ان من قال بن ابي يزيد نسبه لجده فقد ذكر بن مندة ان صدقة رواه عن عطاء بن يزيد عن حكيم بن يزيد عن ابيه عن جده وترجم له بن مندة ابو يزيد جد حكيم ويكون الجد ابهم في رواية ابي عوانة والاضطراب فيه من عطاء بن الساءب فانه كان اختلط وقد قيل ان حماد بن سلمة ممن سمع منه قبل الاختلاط والله اعلم وحماد يقول فيه عن عطاء عن حكيم بن يزيد عن ابيه وتابعه همام كما تقدم في حرف الياء اخر الاسماء والاكثر قالوا بن ابي يزيد والله اعلم قال ابو عمر الذي اقول ان الصواب قول الثلاثة وهيب وجرير بن حازم واسماعيل بن علية وان ابا عوانة وهم فيه انتهي وقد ذكرت من وصلها الا ان قوله جرير بن حازم غلط والصواب جرير بن عبد الحميد فانه ذكر انه من رواية ابي خيثمة وابو خيثمة انما اخرجه عن ابيه عن جرير وكذا وصله الحاكم ابو احمد من رواية محمد بن قدامة عن جرير وابن قدامة وابو خيثمة لم يدركا جرير بن حازم وقد زدت عليه عبد الوارث وحماد بن زيد وقد خالفهم حماد بن سلمة فقال عن عطاء بن الساءب §  <> عن حكيم بن يزيد عن ابيه ابو يزيد اللقيطي له ذكر في حديث حزابة بن نعيم تقدم في الاسماء ابو يزيد النميري ياتي في القسم الاخير ابو اليسر بفتحتين الانصاري اسمه كعب بن عمرو بن عباد بن عمرو بن سواد بن غنم بن كعب بن سلمة وقيل كعب بن عمرو بن تميم بن سواد بن غنم بن كعب بن سلمة الانصاري السلمي بفتحتين مشهور باسمه وكنيته شهد العقبة وبدرا وله فيها اثار كثيرة وهو الذي اسر العباس قال بن اسحاق شهد بدرا والمشاهد وقال البخاري له صحبة وشهد بدرا وقال المداءني كان قصيرا دحداحا عظيم البطن ومات بالمدينة سنة خمس وخمسين وقال بن اسحاق وكان من اخر من مات من الصحابة كانه يعني اهل بدر روي عنه عبادة بن الوليد بن عبادة بن الصامت وحديثه مطول واخرجه مسلم ابو اليسع ذكره بن مندة فقال سال عن النبي صلي الله عليه وسلم فقيل هو بعرفات روي حديثه محمد بن خالد عن عبيد الله بن ابي حميد عن ابي عثمان النهدي بطوله وقال ابو عمر حديثه عند عبيد الله بن ابي حميد عن ابي المليح بن ابي اسامة عنه قال اتيت النبي صلي الله عليه وسلم فقلت يا رسول الله ما الذي يدخلني الجنة الحديث ابو يعقوب يوسف بن عبد الله بن سلام له ولابيه صحبة تقدم في الاسماء ابو يعلي حمزة بن عبد المطلب عم النبي صلي الله عليه وسلم وابو يعلي شداد بن اوس الانصاري تقدما في الاسماء ابو اليقظان غير منسوب قال الحاكم ابو احمد قال محمد بن اسماعيل له صحبة وقال بن مندة ذكره البخاري فيمن ص