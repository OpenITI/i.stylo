 والقي الله في قلوب الكفرة الرعب بعد قيامهم للصف ، فقال عتبة بن ربيعة : يا محمد اخرج الينا اكفاءنا من قريش نقاتلهم. فقام اليهم بنو عفراء من الانصار : عوذ ومعوذ ومعاذا امهم عفراء وابوهم الحارث ، فمشوا اليهم فقالوا لهم : ارجعوا وارسلوا الينا اكفاءنا من بني هاشم ، فخرج اليهم علي وحمزة وعبيدة بن الحارث ، قال علي : فمشيت الي الوليد بن عتبة ومشي الي ، فضربته بالسيف اطرت يده ، ثم بركت عليه فقتلته ، فقام شيبة بن ربيعة الي عبيدة بن الحارث فاختلفا بضربتين ، ثم ضرب عبيدة ضربة اخري فقطع ساق شيبة ، ثم قام حمزة الي عبيدة بن ربيعة فقال : انا اسد الله واسد رسوله ، ثم ضربه حمزة فقتله. فقام ابو جهل في اصحابه يحرضهم ويقول : لا يهولنكم ما لقي هءلاء ، فانهم عجلوا واستحمقوا ، ثم حمل هو بنفسه ، ثم حمل المسلمون كلهم علي قريش فهزموهم).
 قوله تعالي : { سالقي في قلوب الذين كفروا الرعب } ؛ اي ساقذف في قلوبهم المخافة منكم. علم الله المسلمين كيف يضربونهم ، فقال عز وجل : { فاضربوا فوق الاعناق } ؛ معناه علي الاعناق ، وقال عطية والضحاك : (معناه فاضربوا الاعناق) ، كقوله تعالي : { فاذا لقيتم الذين كفروا فضرب الرقاب }[محمد : ] ، وقال صلي الله عليه وسلم : " اني لم ابعث لاعذب بعذاب الله تعالي ، انما بعثت بضرب الرقاب وشد الوثاق) ".
 وقال بعضهم (فوق) بمعني (علي) ، اي فاضربوا علي الاعناق ، وقال عكرمة : (معناه فاضربوا الرءوس). وقال ابن عباس : (فاضربوا الاعناق فما فوقها) يعني الرءوس والاعناق ، نظيره قوله تعالي : { فان كن نساء فوق اثنتين }[النساء : ] اي اثنتين فما فوقهما ، وانما امر الله تعالي بضرب الرقاب والاعناق ؛ لان اعلي جلدة العنق هو المقتل. قوله تعالي : { واضربوا منهم كل بنان } ؛ قال عطية : (يعني كل مفصل) ، وقال ابن عباس والضحاك : (يعني الاطراف).
 وقال بعضهم معني قوله تعالي : { فاضربوا فوق الاعناق } الصناديد ، وقوله تعالي : { واضربوا منهم كل بنان } يعني السفلة. الا ان الاول اصح. وقيل : معناه : واضربوا منهم كل عضو امكنكم ، وليس عليكم توقي عضو دون عضو.
 وعن ابي سعيد الفاراني انه كان يقول : (اراد الله ان لا تتلطخ سيوف المسلمين بفرث الكفار ، فامرهم ان يضربوا فوق الاعناق ويضربوا منهم كل بنان). والبنان في اللغة : هو الاصابع وغيرها من الاعضاء التي بها يكون قوام الانسان صونا لمكانه وحياته ، ماخوذ من قولهم : ابنن الرجل بالمقام اذا اقام به.

