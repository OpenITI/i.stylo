 { افتطمعون } : ايها المءمنون ، فالخطاب للمءمنين ، وقيل لهم وللنبي A ، وقيل للني ، A ، خوطب بخطاب الجماعة تعظيما له ، A ، ووجه الاول ان الانصار كان لهم حرص علي اسلام اليهود للحلف والجوار الذي كان بينهم ، وكانوا يدعونهم الي الاسلام ، والاستفهام انكار ، لان يقع طمعهم موقعا صحيحا ، اي طمعتم في غير مطمع او انكار علي طريق النهي ، اي لا تطمعوا .

 { ان يءمنوا } : اي في ان يءمنوا .

 { لكم } : اي يصدقكم اليهود ، وانما عداه باللام لتضمنه معني الخضوع او الاذعان او الاقرار ، او اللام للتعليل ، اي ان يءمنوا لاجلكم اي لاجل دعاءكم اياهم الي الايمان .

 { وقد كان فريق } : طاءفة .

 { منهم } : من سلفهم .

 { يسمعون كلام الله ثم يحرفونه } : قال ابن عباس وابن اسحاق : هم السبعون الذين اختار موسي ، قيل انهم سمعوا كلام الله كموسي ، ولما رجعوا قالوا : سمعنا الله . يقول في اخر كلامه : ان استطعتم ان تفعلوا بهذه الاشياء ، فافعلوا ، وان شءتم فلا تفعلوا ، وقيل قالت ذلك طاءفة من السبعين لا كلهم ، فالباقون ادوا كما سمعوا فتحريفهم هو هذا الكذب ، ويحتمل ان يكون الله D قد قال ذلك تهديدا كقوله : { فمن شاء فليءمن ومن شاء فليكفر } ، وتحريفهم ايهام الناس ان ذلك اباحة لهم مع انهم قد علموا ان ذلك تهديد لدليل نصبه لهم الله سبحانه ، وتقدم الرد علي من قال انهم سمعوا كلام الله كما سمعه موسي ، بان ذلك يبطل خصوصية موسي بالكلام ، واقول لا يبطله لان الخطاب انما هو لموسي لا هم معه ، ولو كان بصيغة خطابهم ، وانما خاطبه بما يفعل وما يفعلون ، وما يترك وما يتركون ، ووجه الكلام اليه وهم يسمعون باذن الله تعالي ، والهاء في منهم عاءدة الي اليهود مطلق ، وقيل : المراد بالهاء في منهم عاءدة الي اليهود الذين في زمانه A ، والمراد بالفريق علماءهم الذين سمعوا التوراة ممن اقرهم اياها اوس معوها مما كتبت ، فهي عن الله ، فان من قرا كتابا من كتب الله واكتسبه من الاوراق ، فقد سمع كلام الله وعلي هذا فتحريفهم تبديلهم صفة سيدنا محمد A في التوراة واية الرجم وجدوه A : اكحل اعين ربعة اجعد الشعر حسن الوجه . فكتبوا بدل ذلك طويلا ازرق سبط الشعر ، وبدلوا الرجم للمحصن بالجلد والتحميم ، وهو تسويد الوجه ، وكتبوا ذلك وهكذا كتبوا ما يحبون بدل ما لا يحبون ، لانهم استحفظوه فلم يحفظ ، واما القران فحفظه الله جل وعلا ولم يكله لغيره ، فلم تكن لاحد طاقة علي تبديله . او المراد بتحريفه تحريفه عن معناه ، بان فسروه بما يشتهون ، وبهذا الوجه قال ابن عباس وعن الحسن تحريفها : اخفاءهم صفة محمد A ، كما قال الله جل وعلا :



 { تجعلونها قراطيس تبدونها وتخفون كثيرا } ، وقد يترجح كون المراد بالفريق علماءهم الذين علي عهده A ، بانه انسب للمضمر في قوله : { ان يءمنوا } وطعن بعضهم في الرواية المذكورة عن ابن عباس انهم السبعون الذين اختارهم موسي عليه السلام ، بان راويها الكلبي وهذا كذاب ، وعلي كل وجه من الاوجه المذكورة ، تكون الاية ملوحة بان لليهود سلف سوء ، فهم علي سنن سلفهم وباستبعاد ايمانهم ، اذ لم يءمنوا بموسي الذي كان منهم ، وكان نجاتهم من القبط والبحر علي يده ، فكيف يءمنون لكم؟ وتحريف الشء امالته عن حاله . وقرء ( يسمعون كلم الله ) بكسر اللام . اي كلماته .

 { من بعد ما عقلوه } : اي من بعد عهم اياه اي من بعد فهمهم اياه بعقولهم ، ولم يبق لهم فيه شك . وما مصدرية .

 { وهم يعلمون } : انهم كاذبون مبطلون .



  CHECK 

 { واذا لقوا } : قال ابن عباس : اي اليهود الذين نافقوا ولم يظهروا الشرك كما اظهره ساءر اليهود ، ولم يءمنوا ايمانا صادقا كما امن بعضهم ، وذلك تفسير بالواقع ، والا فالضمير عاءد للمجموع ، والحكم للمجموع ، وهكذا حيث لم يتقدم ذكر للخصوص ، مما مراو ياتي فلا تغفل ، وهذا وما بعده كلام مستانلف منقطع عما قبله ، وتحتمل اتصاله بما قبله علي العطف ، فيكون المعني افتطمعون في ايمانهم ، وقد كن من صفتهم انهم يحرفون وانهم اذا لقوا :

 { الذين امنوا قالوا امنا } : بمحمد انه رسول من الله حقا ، وانه المبشر في التوراة وانكم محقون في اتباعه ، روي ان رسول الله A قال : لا يدخل علينا قصب بنة المدينة الا مءمن ، فقال كعب الاشراف واشباهه : اذهبوا وتحسسوا واخبروا من امن بمحمد ، وقولوا لهم امنا واكفروا اذا رجعتم فنزلت الاية .

 { واذا خلا بعضهم الي بعض قالوا اتحدثونهم } : قال اليهود الذين اشركوا صراحا احبارا او غير احبار لمن نافق منهم ، حبرا كان او من الاتباع اتحدثون المسلمين .

 { بما فتح الله عليكم } : بما اعطاكم في التوراة من بيان صفة محمد ، والاستفهام للعتاب والتوبيخ والتقريع ، ولا مانع من ان يقال للانكار ، ويجوز ان يكون المعني : قال الذين نافقوا من اليهود لاولادهم : اتحدثون المءمنين بما فتح الله عليكم في التوراة من بيان صفة محمد؟ يقولون لهم ذلك انكارا ونهيا عن ان يقولوا ، واظهارا للتمسك باليهودية سواء راوهم يقولون او راوهم ارادوا ان يقولوا ، او راوهم لا يبالون بالاظهار ، فانكروا عليهم وامروهم بالثبوت علي اليهودية ، فيكفونون قد استعملوا النفاق مع اولادهم ومع المءمنين . وقال ابو العالية وقتادة : ان بعض اليهود تكلم بما في التوراة من صفات النبي A فقال لهم كفرة الاحبار : اتحدثونهم بما فتح الله عليكم ، اي عرفكم من صفات محمد A : ومن ذلك التحدث ما روي عن ابن عباس رضي الله عنهما : ان منافقي اليهود كانوا اذا لقوا اصحاب رسول الله A قالوا لهم امنا بالذي امنتم به ، وان صاحبكم صادق ، وان قوله حق ، وانا نجد نعته وصفته في كتابنا ، وانهم قالوا لاهل المدينة حين شاوروهم في اتباع محمد A : امنوا به فانه نبي حق . وروي عن ابن عباس رضي الله عنهما : انها نزلت في قوم من اليهود قالوا لبعض المءمنين نحن نءمن انه نبي ولكن ليس الينا ، وانما هو اليكم معشر العرب خاصة . ولما خلوا قال بعضهم لبعض لما تقرون بنبوته؟ وقيل ان رسول الله A قال ليهود بني قريظة يا اخوان القردة والخنازير .



 وقالوا ان اليهود اخبروا المءمنين بما عذبهم الله به من الجنايات ، فقال بعضهم لبعض اتحدثونهم بما فتح الله عليكم ، اي بما قضي عليكم من العذاب ليروا الكرامة لانفسهم عليكم عند الله كما قال :

 { ليحاجوكم به عند ربكم } : ليخاصمكم اصحاب محمد في الفضل فيغلبوكم في اثبات الكرامة لانفسهم عليكم في الدنيا والاخرة . والتفاسير الاولي في التحدث بما فتح الله اولي ، فيكون معني ليحاجوكم عند ربكم ليخاصموكم عند ربكم في الدنيا والاخرة ، فتكون الغلبة لهم يقولون قد اقررتم انه نبي حق في كتابكم فلم لا تتبعونه؟ واذا اقررتم انه رسلو الله الي العرب خاصة ، فان من ثبتت رسالته من الله ولو الي انسان واحد لا يكون كاذبا ، فكل ما قال A صدق ، وقد قال : « بعثت للناس كافة » فهو صادق في البعث للناس كافة ، وجاء بالقران فهو صادق انه من الله ، فثبتت رسالته الي الناس كلهم ، وبطلت دعواكم في اختصاصه بالعرب . وقيل معني : ( عند ربكم يوم القيامة ) واعترض تفسير العندية بيوم القيامة وحده ، او به وبالدنيا ، بان اخفاء ما بين لهم في التوراة لا يدفع المحاجة يوم القيامة ، وفي نفس الامر وان كان يدفعها في زعمهم . والجواب ان ذلك من كلام الكفرة ، ومعلوم انهم يقولون ما لا يصح اما جهلا منهم ، واما تجاهلا وعنادا وايهاما للباطل انه حق ، ويجوز ان يكون معني العندية المحاجة بكتاب الله تعالي وهو التوراة ، بان جعلوا المحاجة بما اخبروا المءمنين به مما في التوراة محاجة عند الله ، تقول : لا يجوز كذا عند الله او يجوز عنده ، تعني انه لا يجوز في كتابه او يجوز فيه ، وتقول : يجوز كذا عند سيبويه تريد انه يحكم به او انه في كتابه ، ويجوز ان يكون الكلام علي تقدير مضاف ، اي ليحاجوكم به عند ذكر ربكم ، فان ذكر امر الدين والرسالة ذكر الله D ، او ليحاجوكم به عند رسول ربكم ، اي بين يدي رسول ربكم وهو موسي ، واللام للصيرورة لانه ليس غرضهم في التحدث ان يحاجهم المءمنون ، لكن يءول التحدث الي ان يحاجهم المءمنون بما حدثونهم به ، وقد اغني الله المءمنين عما يحدثونهم بالقران ، والوحي الي رسول الله صلي الله عيه وسلم .

 { افلا تعقلون } : خطاب ممن لا يحدث من اليهود لمن يحدث ، او من يحدث لاولادهم ، اي افلا تعقلون انهم يحاجونكم بما تحدثونهم به ، فيغلبونكم في الحجة ، او خطاب من الله تبارك وتعالي للمءمنين متصل بقوله : { افتطمعون } اي افلا تعقلون انهم لا يءمنون .



  CHECK 

 { او لا يعلمون } : هذا من كلام اليهود اي او لا يعلم القاءلون { اتحدثونهم بما فتح الله عليكم . . الخ } { ان الله يعلم ما يسرون } : ما يخفيه الذين يحدثون المءمنين من كل ما يخفونه .

 { وما يعلنون } : وما يظهرونه مما حدثوا به المءمنين وغيرهم فهم محجوبون مقطوعوا العذر ، سواء حدثوا المءمنين او لم يحدثوهم ، ويجوز عود الواو من يعلمون ويسرون الي الذين يقولون امنا اذا لقوا الذين امنوا . او الي القاءلين اتحدثونهم ، او الي الفريقين ، او الي المحرفين . ومن جملة ما اسروا صفة محمد A وما حرفوا من كلام الله وما اخفوه من الكفر واظهروا الايمان ، ومن جملة ما اظهروه ايمان النفاق ، وما بقي من التوراة غير محرف ولم يدعهم داع الي اخفاءه ، وما بدلوا به ما في التوراة .



  CHECK 

 { ومنهم } : اي من اليهود .

 { اميون } : لا يكتبون ولا يقرءون الكتابة ، باقون علي حالهم التي خرجوا عليها من بطون امهاتهم ، لم يتعلموا كتابة ولا قراءة كتابة ، فذلك نسبة الي الام ، ويجوز ان يكون نسبوا الي الام لان من شان النساء الا يكتبن ولا يقران كتابة لا الي الاب ، لان من شان الرجال ان يكتبوا ويقرءوا الكتابة كما قيل في النبي الامي صلي الله عليه سولم انه نسب الي امة العرب لقلة الكتابة فيهم ، وقراتها حين بعث A ، وقيل انما ذلك في اللغة ، واما في العرف فالاميون العوام ، واقول هو خارج عما ذكرت لان الكاتب الذي يقرا الكتاب قد خرج عن العامة بالكتابة والقراءة ، وغيره من العامة باعتبار عدمهما ، ولو كان من الخاصة بسبب اخر فعلي ما ذكرته يكون قوله :

 { لا يعلمون الكتاب } : تاكيدا في المعني لقوله اميون ، او تفسيرا له ، واما علي ان الاميين العوام فهذا تفسير له باللازم ، والكتاب مصدر بمعني الكتابة ، اي لا يعرفون الكتابة فضلا عن ان يطالعوا التوراة فيتحققوا ما فيها ، ويجوز ان يكون الكتاب بمعني التوراة ، اي لم يعلموا معانيها واحكامها ، سواء علموا الكتابة او لم يعلموا وحفظوا بعض الفاظ التوراة او لم يحفظوا .

 { الا اماني } : جمع امنية بضم الهمزة واسكان الميم وكسر النون وتشديد الياء ، وهو مفرد بمعني الخصلة القريبة المتمناة كاصطورة واضحوكة واحدوثة واصله امنوية ابدلت الواء ياء وادغمت الياء في الياء وابدلت الضمة علي النون كسرة ، والاستثناء منقطع ، اي لكن اماني تمنوها وطمعوا فيها غير صادقة ، اخذوها تقليلا من المحرفين ، واعتقدوها صادقة ، وهي ان الجنة لا يدخلها الا من كان هودا ، والله يعفو عنهم ويرحمهم ، ولا يءاخذهم بخطاياهم ، وان اباءهم الانبياء يشفعون لهم ، وان من يدخل منهم النار يخرج منها بعد ايام معدودة ، ويجوز ان تكون الاماني بمعني الاكاذيب ، يقال تمني ام صدق ، اي اكذب ام صدق ، قال اعرابي لابن داب في شء حدث به : هذا شء رويته ام تمنيته ، اي افتريته وهي الاكاذيب التي قلدوا فيها المحرفين ، وقد مر ذكرها : ومن ذلك قولهم ان محمدا رسول الي العرب خاصة ، ويجوز ان يكون المعني الا قراءات عارية من معرفة المعني وتدبره بالقلب ، وكل ذلك من مني اذا قدر ، فان من يطمع في شء ويتمناه يقدره في نفسه ، ويحرزه ويشتغل بتفاصيله ، وكذا المفتري ، واما القارء فيقدر ان كلمة كذا بعد ذكا ، ولا يقال هذا لا يناسب وصفهم بانهم اميون ، لانا نقول هم اميون لا يكتبون ولا يقرءون ما كتب ، لكن يقرءون بالاملاء لا بالنظر في التكاب ، او لما كانوا لا يتدبرون ما يقرءون نظرا جعلوا كمن لا يقرا كتابه ، ومن التمني بمعني القراءة قول مادح عثمان بعد موته :

 تمني كتاب الله اول ليلة ... تمني داود الزبور علي رسل

 اي علي مهل ، وفي رواية :

 تمني كتاب الله اول ليلة ... واخره لاقي حمام المقادر

 { وان هم } : اي ما هم .

 { الا يظنون } : ما سمعوه من المحرفين حقا او مكتوبا في التوراة ، وليس بحق ولا هو مكتوب فيها ، وهم رجعوا انه حق مكتوب فيا كما هو ظاهر الظن ، او جزموا بانه حق مكتوب فيها ، فان الظن قد يطلق علي الاعتقاد الجازم سواء اصاب المعتقد ام لم يصب .



  CHECK 

 { فويل } : قال ابن عباس رضي الله عنهما : الويل شدة العذاب ، واخرج الترمذي عن ابي سعيد الخذري وقال حديث غريب عن رسول الله A : « الويل واد في جهنم يهوي فيه الكافر اربعين خريفا قبل ان يبلغ قعره » والخريف عبارة عن العام ، لانه بعض العام ، وفي رواية عن ابي سعيد : واد في جهنم بين جبلين يهوي فيه الهاوي اربعين خريفا ، وكذلك رواه غير الترمذي مرفوعا اليه A انه واد في جهنم . ورواه ابن المنذر مرفوعا عن ابن مسعود ، وروي سفيان الثوري وعطا ابن يسار انه واد يجري بفناء جهنم من صديد اهل النار ، وروي عثمان بن عفان عن النبي A انه جبل من جبال النار ، وقول الخليل انه شدة الشر هو في معني قول ابن عباس ، ومعني كونه لهم وهو واد او جبل ان لهم فيه مكانا يعذبون فيه ، وليسوا مختصين به ، واصله مصدر لا فعل له علي المشهور ، وقيل له فعل هو وال ، ومعناه تحسر وهلك ، وتقوله العرب لمن وقع في هلكة ، وقال ابو حيان : لم يصح عن العرب فانما سمي به الوادي او الجبل المذكور ، لانه سبب وملزوم للهلاك والتحسر ، والة العذاب ، فهو مجاز مرسل ، ويجوز ابقاءه في الاية علي المصدرية وساغ الابتداء به مع انه نكرة ، لانه جاء علي طريقة الدعاء في كلام العرب ، وليس بدعاء حقيقة لانه تعالي مالك كل شء وقادر علي كل شء .

 { للذين يكتبون الكتاب بايديهم } : فقط بدون ان تسبقهم كتابة من الله ، او من موسي ونحوه من الصادقين ، فكان ما يكتبوه كذبا اذ لم يكن من الله لفظه ومعناه ، ولا معناه والكتابة ، ولو كانت لا تكون الا باليد لكن لما اريد بذكر الايدي التعبير عن انهم كتبوا من عند انفسهم لا صدقا ، لم يكن ذكر الايدي تاكيدا في المعني ، لقوله : { يكتبون } وايضا قد يكون الانسان كاتبا بغير يده بان يامر من يكتب ، فاحترز عن هذا بقوله : { بايديهم } فليس تاكيدا ، لان ما احترز به عن المجاز ليس تاكيدا ، ولو كان لو لم يحترز عنه لحمل الكلام علي الحقيقة ، وكتابه الحرام والامر بها كلاهما لا يجوز واما الكتابة بالطابع فمن الكتابة باليد ، لان رسم حروفها ، والمسح عليها بالمداد وتطبيق الورقة عليها باليد . وقال القاضي جار الله : ان قوله بايديهم تاكيد في المعني لقوله : { يكتبون } ، مراعاة لكون الكتابة الحقيقة لا تكون الا باليد واظنهما غفلا عن كون الايدي ذكرت عبارة عن كون مكتوبهم كذبا ، ثم رايت ان ابن السراج ذكر ان قوله بايديهم كناية عن انه من تلقاءهم دون ان ينزل عليهم ، والحمد لله والكتاب اسم لما يكتب فيه من نحو ورق وجلد ، ولا يسمي كتابا الا بعد ان يكتب فيه بعض الكتابة ، وتسميته كتابا ، قبل ذلك من مجاز الاول ، فالاية من هذا المجاز ، ويجوز ان يراد الحقيقة بان سماه كتابا باعتبار ما يتحصل فيه اولا من ذكر ، ثم ذكر لهم الويل لما يكتبونه فيه بعد من تحريف وكذب .



 { ثم يقولون } : كاذبين .

 { هذا من عند الله } : اي مضمون هذا التكاب من الفاظ ومعان او من معان هو من عند الله .

 { ليشتروا به } : اي بذلك الكتاب الذي كتبوه .

 { ثمنا قليلا } : عرضا من اعراض الدنيا كماكول ومشروب ودنانير ودراهم ونحوها من الاموال ، وكالجاه والشهرة والرشوة ، فان كل ما نالوه بذلك قليل بالنسبة الي ما فاتهم به من النعيم الداءم ، وما استوجبوه من العذاب الخالد ، وليشتروا تعليل ليقولون وليكتبون ففيه تنازع ، علمت الاحبار والرءساء من اليهود لعنهم الله انه اذا تحققت عند اليهود صفة النبي A مالوا اليه ، فتذهب رءاستهم وعطاياهم التي تعطيهم العامة ، تعمدوا الي صفته A فكتبوا بدلها : طويل ازرق العينين سبط الشعر ، فكانوا اذا سالهم عامتهم قرءوا عليهم ما كتبوا ، فيجدونه A ليس كذلك فينكرون نبوته ورسالته . وذكر السدي انهم كانوا يكتبون كتبا يبدلون فيها صفة الني صلي الله عليه سولم ويبيعونها من الاعراب ويبثوها في اتباعهم ، ودخل في الاية كل ما كتبوا من باطل كما بدلوا الرجم والجلد والتحميم

 { فويل لهم مما كتبت ايديهم } : من الاكاذيب ومن التعليل ، اي لاجل ما كتبت ايديهم او للابتداء ، اي يتحصل لهم مما كتبت ايديهم وكذا في قوله :

 { وويل لهم مما يكسبون } : من الاثمان علي ذلك والرشا وساءر معاصيهم .



  CHECK 

 { وقالوا لن تمسنا النار الا اياما معدودة } : روي ان رسول الله A قال لليهود : من ابوكم؟ قالوا فلان ، قال : كذبتم ابوكم فلان ، قالوا صدقت وبررت . قال : من اهل النار؟ قالوا : نكون فيها مدة ثم تخلفوننا فيها ، قال : كذبتم اخسءوا فيها فوالله لا نخلفكم فيها ابدا . وفي الحديث زيادة من اوله نسبتها وياتي ان شاء الله تاما في موضع .

 قال ابن زيد وغيره : ان رسول الله A قال لليهود : من اهل النار؟ فقالوا : نحن ثم تخلفوننا فيها انتم . فقال لهم : كذبتم لقد علمتم انا لا نخلفكم . فنزلت الاية ، ونزل في النبي A ومن تبعه :

 { والذين امنوا وعملوا الصالحات اولءك اصحاب الجنة هم فيها خالدون } والايام المعدودة ايام الاسبوع سبعة ايام ، وعن ابن عباس رضي الله عنهما : قالت اليهود مدة الدنيا سبعة الاف سنة ، وانا نعذب بكل الف سنة يوما ، ثم ينقطع عنا العذاب بعد سبعة ايام . وكذا قال مجاهد . وقيل : قالوا نمكث في النار اربعين يوما مقدار الايام التي عبدوا فيها العجل ، وقيل : زعموا ان الله D عتب عليهم في امر فاقسم ليعذبنا اربعين يوما تحله القسم ، ويمكن الجمع بين ذلك الامر الذي عتب عليهم فيه هو عبادة العجل ، ثم رايت الشيخ هودا C ذكر ما يدل له والحمد لله اذ قال : قال بعض المفسرين ، قالت اليهود : لن يدخلنا الله النار الا تحلة القسم عدد الايام التي عبدوا فيها العجل ، فاذا انقضت تلك الايام انقطع عنا العذاب والشر ، ويمكن الجمع بين قول السبعة وقول الاربعين ، بان بعض اليهود قال : سبعة ، وبعضا قال : اربعين ، كما اشار اليه القاضي . قال الكلبي : فاذا دخلوا النار لبثوا فيها لكل يوم من الاربعين التي زعموا سنة ، فتلك اربعون سنة ، ثم يقال لهم : يا اعداء الله هذه الايام قد مضت والاجل الذي قلتم وبقي الابد لا تخرجون منها ابدا ، فعند ذلك انقطع الرجاء وايقنوا بالخلود في النار ، ومعني { لن تمسنا } لن تصيبنا ، ومعني المس اتصال الشء بالشء بحيث لا يبقي شء من الهواء بينهما ، وهدا علي عمومه ، وان قيل يختص بان يكون من الحيوان الي اخر او الي غيره فيقال : ايصال الحيوان جسمه بشء سواء تاثرت الحاسة به ام لم تتاثر مثل المس بالشعر ، فان الشعر لا يدرك الحس ، واللمس يطلق كالمس ، ويطلق بمعني طلب المس ، يقال لمسه والتمسه فلم يجده او فوجده اي طلبه فوجده ، واشاروا ، بكون الايام معددة الي قلتها كما يشار الي الكثرة بقولك لا يحصي ، ولو امكن احصاءه وانما نعت اياما بمفرد مءنث لانها في معني الجماعة ، وذكر الرضي ان جمع القلة بمنزلة المفرد وايام بوزن افعال جمع قلة ، ولذا وصف هنا بالمفرد ، ووصف به المفرد في قوله :



 { من نطفة امشاج } وياتي كلام فيه ان شاء الله تعالي .

 { قل اتخذتم } : باثبات الهمزة مفتوحة سواء نقلت حركتها بعد اللام كما هو قراءة ورش فتحذف ام لا ، وذلك لانها همزة استفهام ، واما همزة الوصل فمحذوفة من الخط كما حذفت من الكلام ، وهذا الاستفهام انكاري فتكون بمنزلة النفي وام منقطعة بمنزلة بل ، والهمزة او بل تقريري فتكون ام متصلة ، واظهر ابن كثير وحفص الذال ولم يدغمها في التاء ، قال ابو عمرو الداني : اظهر ابن كثير وحفص اتخذتم واخذت واتخذت وما كان مثله من لفظه ، وادغم ذلك الباقون ، واظهر ابن كثير وورش وهشام يلهث ذلك ، واختلف عن قالون وادغم ذلك الباقون ، وادغم ابو عمرو بن العلاء الراء الساكنة في اللام نحو قوله D : { نغفر لكم خطاياكم } { واصبر لحكم ربك } وشبهه ، بخلاف بين اهل العراق عنه في ذلك . قال ابو عمر الداني : وحدثنا محمد بن احمد علي قال حدثنا ابن مجاهد عن اصحابه عن اليزيدي عن ابي عمرو بالادغام ولم يذكر خلافا ولا اختيارا ، واظهرها الباقون ، واظهر ورش وابن عامر وحمزة : { با بني اركب معنا } واختلف عن قالون وعن البزي وعن خلاد ، واظهر ورش ( ويعذب من يشاء ) في البقرة ، واختلف عن قالون وعن البزي وعن خلاد ، واظهر ورش ( ويعذب من يشاء ) في البقرة ، واختلف فيه عن قنبل والبزي ، وادغم ذلك الباقون واجمعوا علي ادغام النون الساكنة والتنوين في الراء واللام بغير غنه ، واجمعوا علي ادغمها في الميم والنون بغنة ، واختلفوا عند الواو والياء فقرا خلف بادغامها فيهما بغير غنة نحو قوله D : { ومن يقل } { ويومءذ يصدعون } { ومن وال } و { يومءذ واهية } ، والباقون يدغمونها فيهما ويبقون الغنة فيمتنع القلب الصحيح مع ذلك ، واجتمعوا علي اظهارهما عند حروف الحلق الا ما كان من مذهب ورش عند الهمزة مع القاء حركة الهمزة عليها ، وكذا اجمعوا علي قلبهما ميما عند الباء خاصة وعلي اخفاءها عند باقي حروف المعجم والاخفاء حال بين حالين : الاظهار والادغام وهوعار من التشديد ، والمشهور عن ورش انه لا يدغم التنوين في الياء والواو ، واختلفوا في الذال من ( اذ ) عند ستة احرف : عند الجيم والزاي والسين والصاد والتاء والدال نحو قوله D : { واذ جعلنا } { واذ زين لهم } { واذ سمعتموه } { واذ صرفنا } { واذ تبرا } { واذ دخلوا } فكان الحرميان وعاصم يظهرون الذال عند ذلك كله ، وادغم ابن ذكوان في الدال وحدها ، وادغم خلف في الدال والتاء ، واظهر خلاد والكساءي عند الجيم فقط ، وادغم ابو عمرو وهشام الذال في الستة . واختلفوا في الدال قد عند ثمانية احرف : عند الجيم والسين والشين والصاد والزاي والذال والضاد والطاء نحو قوله D :



 { ام تقولون علي الله ما لا تعلمون } : اي لا اتخاذ بل تقولون او بل اتقولون او اقروا بما كندكم من احد الامرين باتخاذ العهد ، وقول مالا تعلمون او اقروا بالحق منهما فان احدهما واقع لا محالة .



  CHECK 

 { بلي } : نفي للنفي الذي في قولهم { لن تمسنا } اي لن تمسكم النار الا اياما معدودة ، بل تمسكم ابدا ونفيه بهذه الكلمة كلمة ( بلي ) فقط ابلغ لكونه كالبرهان علي بطلان قولهم ، لانه نفي اعم من كونه داءما او غير داءم ، وتختص بلي بالنفي غالبا وندركونها بعد الاثبات ، واستشهد له ابن هشام بما في صحيح البخاري في كتاب الايمان انه E قال لاصحابه : اترضون ان تكونوا ربع اهل الجنة؟ قالوا : بلي ، وبما في صحيح مسلم في كتاب الهبة : ايسرك ان يكونوا لك في البر سواء؟ قال : بلي ، قال : ابدا . او بما فيه ايضا انه قال : اانت الذي لقيتني بمكة؟ فقال له المجيب : بلي .

 { من كسب } : الكسب جلب النفع ، والاكتساب استجلابه ، ولكن علق الكسب هنا بالشر وهو السيءة ، علي طريق التهكم ، بمن فعل السيءة ، واحاطت به خطيءاته ، ووجه ذلك انه شبه عمل السيءة بعمل الحسنة جامع الرغبة في كل ، وعلاج العمل فاستعار لعمل السيءة ما وضع لعمل الحسنة ، والخير هو الكسب واشتق منه كسب وسيءة قرينة ووجه اخر انه اطلق الكسب المخصوص بالخير علي مطلق العمل استعمالا للخاص في العام ، فاشتق منه كسب فهو مجاز مرسل تبعي .

 { سيءة } : خصلة قبيحة وهي الذنب الكبير ، سواء كان نفاقا او شركا ، ومن الذنوب الكبيرة الاصرار فانه نفسه كبيرة سواء كان علي الصغيرة او الكبيرة ، والدليل علي ان السيءة الكبيرة قوله : { فاولءك اصحاب النار } ويحتمل وجه اخر وهي ان السيءة الذنب صغيرا او كبيرا ، ثم يختص الكلام بالكبير بقوله : { واحاطت به خطيءاته } . وان قلت روي قومنا عن ابن عباس رضي الله عنهما ان السيءة هنا الشرك وكذا قال الشيخ هود C انها الشرك ، قلت : ما ذكرته اولي مما ذكراه ، فان لفظ السيءة عام وحمله علي العموم اولي اذ ذلك تفسير منهما لا حديث ولا سيما انهما وقومنا يعترفون بان لفظ الخلود يطلق علي المكث الكبير سواء كان ابديا او غير ابدي ، وادعاء ان الخلود في الموحدين بمعني المكث الطويل ، وفي الشرك بمعني المكث الداءم استعمال للكلمة في حقيقتها ومجازها وهو ضعيف ، وايضا ذكر احاطة الخطيءات ولو ناسب الشرك كغيره لكنه انسب بغيره لان الشرك اقوي .

 { واحاطت به خطيءاته } : ربطته ذنوبه واوجبت له دخول النار فصار لا خلاص له منها كمن احاط به العدو او الحريق ، او حاءط السجن وذلك بان مات غير تاءب ، وقيل معني الاحاطة ان ذنبه اغلب من طاعته ، ومن مشدقة اصحابنا من يقول بذلك ، شبه الخطيءات بنحو الحاءط الداءر في مضرة علي شء ، واحاطت رمزا وشبه ايباق خطيءاته له الي النار وقصرها اياه علي النار بدوران الشء الضار علي شء ، وقرا غير نافع : خطيءته بالافراد والهمز وقرا بعض من هو خارج العشرة خطاياه وقرء خطيءته بالافراد ، وقلب الهمزة ياء وادغام الياء في الياء وخطياته بالجمع والادغام كذلك ، وتوحيد الموحد واقراره عن الاحاطة لاتفاق الامة علي جواز دخول الفاسق النار ، وقد غلط القاضي ، والخطيءة في قراءة الافراد يحتمل ان تكون هي السيءة المذكورة اولا ، ويحتمل ان يراد به الجنس كما صرحت به قراءة الجمع ، وفي قراءة الجمع واحتمال ارادة الجنس في قراءة الافراد تلويح بان المعصية تجر لاخري مثلها ودونها واكبر ، وهكذا اذا لم يشعر بالتوبة عنها ويستحسنها بالطبع ويبغض من يعارضه عنها وما يعارضه عنها ، ويعادي علي ذلك ويكذب ناصحه وهذا غير بعيد في الموحد ، وذلك اشد عقابا ان يعاقب علي معصية بجذلانه الي اخري ، ومن ذلك في المشرك قوله تعالي : { ثم كان عاقبة الذين اساءوا السوء ان كذبوا بايات الله } والفرق بين السيءة والخطيءة ان السيءة عامة فيما يقصد بالذات وفيما يقصد بالعرض ، والخطيءة تغلب فيما يقصد بالعرض ، لان اشتقاقها من الخطا ، فالزني مثلا سيءة ، والنوم علي بطنها مثلا بعده خطيءة ترتبت عليه ، ومثل ان يقصد امراة بالزني فلما راي وجهها استحسنها فقبله ، فهذا التقبيل خطيءة .



 وسءل الحسن عن الخطءية فقال : سبحان الله ان اراك ذا لحية ولا تدري ما الخطيءة؟ انظر في المصحف فكل اية نهي الله فيها عن خصلة واخبرك انه من عمل بها ادخله النار فهي خطيءة ، وهذا الذي قال انما هو في القران وليس متعينا في جيمعه ايضا ، واما في غيره فالخطيءة تحتمل الصغيرة وكذا السيءة والذنب والمعصية والله اعلم .

 فصل

 مذهب حمزة في الهمزة المتوسطة الساكنة ان تبدل حرفا خالصا كالمءمنين ويءفكون ، وكداب والذءب والبءر وبءس والهدي اننا والذي اءتمن ولقاءنا وفرعون اءتوني ، واختلف الاندلسيون في ادغام الحرف المبدل من الهمزة ، وفي اظهاره في قوله : ورءيا ، وتءوي ، وتءويه ، ومنهم من يدغم اتباعا للخط ، ومنهم من يظهر لعروض البدل ، والوجهان جاءزان جيدان ، واختلف اهل الاداء في تغير حركة الهاء مع ابدال الهمزة ياء قبلها في قوله D : { انبءهم } و { نبءهم } فكان بعض يكسرها للياء وبعض يضمها لعروض الياء وهما صحيحان ، واذا تحركت الهمزة وهي متوسطة فما قبلها يكون متحركا وساكنا ، فان كان ساكنا وكان اصليا وسهلتها القيت حركتها علي ذلك الساكن وحركته بها ما لم يكن الفا كقوله : شيءا وخطءا ، والمشءمة وكهيءة ويجارون ويسالون والقران ومنسوما ومسءولا وموءلا والموءودة واسال ، وان كان زاءدا ابدلت وادغمت ان كان ياء او واوا نحو قوله D :

 { هنيءا مريءا } وبريءون وبريءا وخطيءة وخطيءاتكم ولم تات الواو في القران ساكنة ، فان كان الساكن الفا مبدلة او زاءدة جعلت الهمزة بعدها بين بين ، وان شءت مكنت الالف قبلها ، وان شءت قصرتها ، والتمكين اقيس وذلك كقوله : نساءكم وابناءكم ، وماء وغثاء ، وسواء وهواء ، ومن اباءهم وملاءكته ، واذا كان قبل الهمزة متحركا فان انفتحت هي وانكسر ما قبلها او انضم ابدلت في حال التسهيل مع الكسرة ومع الضمة واوا وذلك نحو قوله : وينشءكم ، وان شانءك ، والخاطءة ، ولءلا ولءلءا ، ويءده ويءلف ، ثم بعد هذا يجعلها بين بين في جميع احوالها وحركتها وحركات ما قبلها ، فان انضمت جعلتها بين الهمزة والواو نحو قوله D : ويءسا ورءوف وبرءوسكم ولا يءده ومستهزءون وليواطءوا ويامنوكم ، ما لم تكن صورتها ياء نحو : انبءكم وسنقرءك وكان سيءة فانك تبدلها ياء مضمومة علي مذهب حمزة في اتباع الخط عند الوقف علي الهمزة ، وهو قول الاخفش اعني التسهيل في ذلك بالبدل ، وان انفتحت جعلتها بين الهمزة والياء نحو قوله : جبريل وييءس الذين وسءل موسي ويومءذ وحينءذ وجميع ما يسهله حمزة من الهمزات فانما يراعي فيها خط المصحف دون القياس ، وقد اختلف الاندلسيون في تسهيل ما يتوسط من الهمزات بدخول الزواءد عليهن نحو قوله D : { افانت } ، و { فباي الاء } و { بايكم } و { كاءن } ، و { كانه } و { فلا اقطعن } ، والارض ، والاخرة ، وكذا ما وصل من الكلمتين في الرسم فجعل كلمة نحو قوله : تعالي هءلاء ، وهاانتم ، ويا ايها ، ويا اخت ويا ادم ، ويا اولي الالباب .



 فبعض يسهل اعتداد بتوسطهن وبعض يحقق اعتدادا بكونهن مبتدءات ، وكلاهما جيد وبهما ورد نص الرواة . والله اعلم .

 فصل

 اعلم ان الهمزة اذا كانت مع حرف المد واللين في كلمة واحدة توسطت او تطرفت ، فلا خلاف في تمكين حرف المد زيادة نحو قوله D : اولءك ، وشاء الله ، والملاءكة ، وجء ، وجيء وخطيءات وخطيءة ، واذا كانت اول كلمة وحرف المد اخر كلمة اخري فانهم يختلفون ، فابن كثير وقالون بخلاف عنه ، وابو شعيب وغيره عن اليزيدي يقصرون حرف المد ولا يزيدونه تمكينا علي مافيه من المد الذي لا يوصل الا به ، كقوله D : { بما انزل اليك وما انزل من قبلك } ، { وفي اياتنا } وهءلاء المذكورون اقصروا مدا فيه من الضرب الاول المتفق عليه ، والباقون يطولون حرف المد في ذلك زيادة ، واطولهم مدا في الضربين جميعا ورش وحمزة ودونهما عاصم ودونه ابن عامر والكساءي ودونهما ابو عمرو من طريق اهل العراق ، وقالون من طريق ابي نشيط بخلاف عنه ، واذا كانت الهمزة قبل حرف المد سواء حققت او القي حركتها علي ساكن قبلها ، او ابدلت كادم وامن ولقد اتينا ، ومن اوتي ولءلا وقريش وللايمان فاهل الاداء من مشيخة المصريين الاخذين برواية ابي يعقوب عن ورش يزيدون في تمكين حرف المد في ذلك زيادة متوسطة علي مقدار التحقيق ، واستثنوا من ذلك قوله : بني اسراءيل فلم يزيدوا في تمكين الياء فيه ، واجمعوا علي ترك الزيادة اذا سكن ما قبل الهمزة ، وكان الساكن غير حرف مد ولين نحو قوله : مسءولا ومذءوما والقران والظمان وكذلك اذا كانت الهمزة مجتلبة للابتداء نحو : اتمن ، وايت بقران ، واءذن لي والباقون لي لا يزيدون في اشباع حرف المد فيما تقدم .



 وبالله التوفيق .

 { فاولءك } : البعداء عن مقامات الخير ، وانما عبر باشارة البعيد تلويحا لهذا المعني ، واعتبر معني من في اسم الاشارة وما بعده بعد ان اعتبر لفظها في كسب وهاء به وهاء خطيءاته .

 { اصحاب النار } : اي مستحقوها بكسبهم او ملازموها في الاخرة كما لزموا موجباتها في الدنيا وهي الذنوب .

 { هم فيها خالدون } : داءمون فيها لانهم ماتوا ، وقد احاطت بهم خطاياهم مصرين فلم يكن للبثهم فيها اخر كما ان المصر لا اخر للمعصية وملازمتها عنده والناس اما مصر واما غير مصر مرحوم يدخل الجنة .



  CHECK 

 { والذين امنوا وعملوا الصالحات اولءك اصحاب الجنة هم فيها خالدون } :

 المتبادر من العطف لانه يقتضي التغاير ان الايمان التصديق والاقرار او التصديق وان العمل الصالح ساءر الاعمال كالصلاة وكالاقرار اذا قيل الايمان مجرد التصديق ، وزعم بعض ان الايمان يدخل فيه جيمع الاعمال الصالحة ، لكن لما كن لفظ امن لا يدل صريحا ولا وضعا علي اكثر من فعل واحد ذكر بعده ، وعملوا الصالحات دالا علي تعدد الاعمال ، وقيل امنوا بمعني عملوا الصالحات ، لكنه للماضي فذكر بعده عملوا الصالحات ، بمعني داوموا علي عمل الصالحات ، وتدل هذه الاية علي ان المراد بمن كسب سيءة المشرك والفاسق ، لان هذه الاية ذكر فيها الموحد غير الفاسق ، فتشمل الايتان جميع الاقسام ، ولو اريد بمن كسب سيءة المشرك فقط لبقي الفاسق ، فبطل قول بعض قومنا ان هذا دليل علي ان المراد بمن كسب المشركون ، ولا يخفي ان ظاهر قوله : { من كسب سيءة . . الخ } عام سبق حجة علي القاءلين لن تمسنا النار الا اياما معدودة ، كانه قيل : ليس كما قلتم بل كل من كسب سيءة واحاطت به خطيءاته فهو خالد ابدا ، فليس كما زعم بعض قومنا ان المراد بمن كسب اليهود القاءلون لن تمسنا النار الا اياما معدودة ، لانه تاكيد والتاسيس اولي ، ولانه لا دليل علي هذا التخصيص ، فهو عام في كل من كسب سيءة واحاطت به خطيءاته ، كما ان قوله : { والذين امنوا . . الخ } عام في كل من امن وعمل الصالحات ، ذكره وعدا عاما بعد ذكره وعيدا عاما لترجي رحمته كما يخشي عذابه ، كما هو سنة الله تعالي في القران في ذكر الوعد بعد الوعيد .



  CHECK 

 { واذ اخذنا ميثاق بني اسراءيل } : حين رفع فوقهم الطور ليقبلوا التوراة ويعملوا بما فيها ، فقبلوا علي ان يعملوا فهذا مياقهم ، او حين طلبوا موسي ان ياتيهم بالكتاب الذي وعدهم ليعملوا به ، وهو التوراة او الميثاق هو الزامه اياهم التكاليف التي في التوراة سماه ميثاقا لانه عاهد اليهم ان يعملوا بها .

 { لا تعبدون الا الله } جواب للقسم ، لان اخذ الميثاق تحليف ، لان المعني واذا حلفناهم لا تعبدون الا الله ، كقولك حلفت عمرا الا يقوم ، وذلك قول سيبويه بالقسم اخذ الميثاق ، ويجوز كون ذلك جوابا للميثاق اي اخذنا حلفهم لا يعبدون الا الله كقولك : اعجبني حلف زيد ليقومن ، وان قلت : فهل حلفهم او حلفوا؟ قلت : اللازم الشء بشدة تحليف والتزامه بها حلف ، ولا نافية ، ويجوز كون لا تعبدون الا الله مقولا لحال محذوفة ، اي واذ اخذنا ميثاق بني اسراءيل ، وقلنا لا تعبدون الا الله ، وجاز حذف العاطف معه ، كما جاز حذف القول مع فاء الجزاء ، وعلي كون لا تعبدون الا الله ومقولا لقول محذوف علي الوجهين تكون لا نافية لفظا ناهية معني ، ونكتة الاتيان بما لقطه خبر ومعناه نهي التلويح الي ان هذا الميثاق مما يهتم بالوفاء به ، لو لمسارعة في اداءه فاتي بصيغة الخبر كان عبادة غير الله المنهي عنها منتفية ، فهو يخبر بانها لا تقع ، وهذا كما تعبر عن طلب ما ترغب فيه بصيغة وقوعه ، تقول : رحم الله الشيخ يوسف بن ابراهيم والشيخ عامر ومشايخ الديوان واصحابنا ، نزيد اللهم ارحمهم ، ويدل علي كون المعني نهيا قراءة ابن مسعود وابي بن كعب ، لا تعبدوا بحذف النون ، ويدل عليه ايضا عطف الامر عليه ، وهو قوله عز وعلا : { وقولوا للناس حسنا } ويجوز ان تكون لا نافية لفظا ومعني والناصب مقدر لما حذف ارتفع الفعل ، كقول طرفة بن العبد :

 الا ايهذا الزجري احضر الوغي ... وان اشهد اللذات هل انت مخلد

 الا ايها الذي يزجرني عن ان احضر انا الحرب فحذف عن وان احضر ، ويدل لذلك لفظ الزجر وقوله ان اشهد ، فالتقدير : { واذ اخذنا ميثاق بني اسراءيل علي ان تعبدوا } فحذف الجار وان هو متعلق باخذنا او ميثاق ، او يجوز تقدير ان بدون علي فيكون مصدر تعبد بدلا مطابقا او بيانا من ميثاق ويدل علي انتصاب الفعل بمحذوف قراءة عبدالله بن مسعود الا تعبدوا بذكر ان ، ولو ادغم نونها في اللام وبني اسم ظاهر ، والاسم الظاهر من قبيل الغيبة وتعبدون خطاب جء به كما نزل في التوراة ، وخوطبوا فيها فذلك علي طريق الالتفات من الغيبة للخطاب ، وذلك قراءة نافع وابن عامر وابي عمرو وعاصم ويعقوب ، وقرا غيرهم : ( لا يعبدون ) بالمثناة التحتية .



 { وبالوالدين احسانا } : بالوالدين متعلق بمحذوف ، واحسانا مفعول مطلق لذلك المحذوف ، ولو كان مصدرا مءكدا لان الصحيح جواز حذف عامل المصدر المءكد ، ولو اشتهر منعه او ندوره ، ولو علقنا بالوالدين بقوله احسانا لكان غير مءكد ، وجاز تقديمه لانه لا ينحل المصدر الي فعل وحرف مصدر هنا علي تقدير المحذوف ، لكن اذا علق به كان ناءبا عن الفعل المحذوف وذلك في الاخبار قليل ، وان قدرنا المحذوف امرا لفظا ومعني او معني فقط كان احسانا ناءيا عنه وعلقنا به الباء ، وكان غير مءكد ، وكبقية تقدير ذلك المحذوف تحسنون او احسنوا لا تعبدون ، فان قلنا خير لفظ ومعني فالتقدير تحسنون كذلك ، لكن ان قدرنا ان مع لا تعبدون جاز تقدير تحسنون بثبوت النون وبحذفها ، وتحسنوا وتقدير وان تحسنوا كما قال وان اشهد اللذات بعد رفع احضر ، وان قلنا خبر لفظا نهي معني جاز تقدير تحسنون بلفظ الخبر ، ومعني الامر جاز تقدير الستوا بصيغة الامر ، ويتعين تقدير احسنوا بصيغة الامر عند من قرا لا تعبدوا ، وعند من قرا الا تعبدوا ، وقدم عبادة الله D ، لان النعم كلها منه ، ولو جري ما جري علي يد مخلوق فشكره مقدم ، وذكر بعد ذلك بر الواليدن لان موجده بعد العدم ، ولو كان هو الله لا غيره لكنهما سبب في وجوده ، وانما قد ربياه وحق الام اعظم كما بينته في شرح النيل ، واختلف ابو خرز وابو القاسم فقال : الاب اعظم لانه الماخوذ بحقوقه ، وقال ابو القاسم : الام اعظم لانها اعظم مءنة ، والاحسان الي الوالدين هو طاعتهما في غير معصية والرعية في نفعهما وتعليم امر الدين لهما وامرهما ونهيهما بلطف .

 { وذي القربي } : عطف علي الوالدين ، اي وتحسنون احسانا بالوالدين وذي القربي ، وانما اتي بالقريب بعد الوالدين لان حقه تابع لهما لحقهما ، والقرابة تحصل بالوالدين ، فانما توجد بهما ، والمولي كالقريب لقوله A : « الولاء لحمة كلحمة النسب » ولا يلزم وصله ما لم يحتج ، وقيل : يلزم كساءر الارحام للحديث ، وكذا اختلف في قرابة الرضاع والقربي مصدر مءنث بمعني القرابة .

 { واليتامي } : جمع يتيم كنديم وندامي وذلك قليل ، واليتيم من بني ادم والجن من مات ابوه قبل بلوغه ، وتسميته بعد البلوغ يتيما مجاز ، قال A : « لا يتم بعد البلوغ » واليتيم من البهاءم من فقدت امه عنه حيث لا تنفعه ، ولو كانت حية ان كان يرضع ، فان فقدت بعد فطامه فليس بيتيم ، وقيل لا يسمي يتيما الا ان ماتت ، وذكر اليتامي بعد ذي القربي لشدة حاجتهم ، فانهم محتاجون لصغرهم ويتمهم ، وخلوهم عمن يقوم بمصالحهم فانهم لا يقومون بنفسهم فقدمهم علي المساكين ، فان المساكين قد يقومون بانفسهم وينفعون غيرهم بالخدمة واليتامي يقل فيهم ذلك .

 { والمساكين } : جمع مسكين ، ومسكين جمع كمفعيل من السكون كالفقر اسكنه ، وانما جمع اليتيم والمسكين دون القريب مراعاة للقربي ، فانه مفرد فكان افراد ما اضيف اليه اولي من ان يقال وذوي القربي ، ولكن المراد الجنس فكانه قيل وذي القربي .



 { وقولوا للناس حسنا } : بضم الحاء واسكان السين ، اي كلاما ذا حسن ، فحسنا مفعول به بمعني اذكروا للناس كلاما ذا حسن ، ويجوز ان يكون مفعولا مطلقا ، اي تولا ذا حسن ، ويجوز تقدير القول بمعني المقول ، فيكون ايضا مفعولا به ، ويجوز الا يقدر مضاف ، ولكن بولغ في حسن القول او الكلام حتي كانه نفس الحسن ، كقولك زيد صوم عدل علم ، ويجوز تاويله بحسن يفتح الحاء والسين الذي هو وصف ، وقد قرا حمزة والكساءي ويعقوب حسنا بفتح الحاء والسين الذي هو وصف ، وقد قرا حمزة والكساءي ويعقوب حسنا بفتح الحاء والسين ، وتقول انه وصف كما قال الزجاج : ويحتمل ان يكون مصدرا ، وبه قال الاخفش كحسن بضم فاسكان . وقرا بعض : حسنا بضم الحاء والسين جميعا وهو لغة الحجاز ، فان حسنا بفتحهما يكون وصفا ومصدرا ، كما يقال علي المصدرية رشد بضم فاسكان ، ورشد بفتحتين وكل ذلك مصدر ، وقرا حسناء كحمراء ، وحسني كفضلي ، فيحتمل ان الوصف اي قوله او كلمة حسناء وحسناء والمصدر كبشري ورجعي ، وان قلت : ما القول الحسن؟ قلت : الامر بالمعروف والنهي عن المنكر بلين في محل يصلح فيه اللين ، وبغلظه حيث تصلح الغلظة ، وتعليم الناس ما نزل في التوراة ومكارم الاخلاق ، والتكلم في المعاشرة وملاقاة الناس بما لا يضرهم ولا ينفرهم عند الحاجة الي التكلم ، وذلك خطاب لليهود في زمان موسي ، ويكون من بعدهم في حكمهم ، او لكل من يصلح للخطاب في زمانه او بعده ، وذلك خطاب في التوراة ، ولا يبعد ان يكون : { قولوا للناس حسنا } مع ما قبله وما بعده خطابا لليهود في زمان سيدنا محمد A واخذ الميثاق عليهم تكليفهم بما في التوراة من عبادة الله وحده ، وما ذكر بعدها وعلي هذا يكون الحسن ما تقدم ذكره ، فهو شامل للايمان بسيدنا محمد A والاخبار بصفاته كما هي بلا تغيير ، وقال محمد بن علي بن الحسين بن ابي طالب ، قولوا لهم ان محمدا رسول الله A ، وقد روي عن ابن عباس وابن جريج ان المعني : قولوا حقا وصدقا في شان محمد A فمن ساءلكم عنه فاصدقوه وبينوا صحته ولا تكتموه ، وفي رواية عنه : قولوا للناس لا اله الا الله ، ومروهم به ولعله مثل بذلك تمثيلا ، وقال سفيان الثوري : معناه مروهم بالمعروف وانهوهم عن المنكر . وقال ابو العالية : قولوا لهم الطيبات من القول وحاوروهم باحسن ما تحبون ان تحاوروا به ، وهذا حض علي مكارم الاخلاق قال عطاء : قولوا للناس ما تحبون ان يقال لكم ، قال ابن جريج : قلت لعطاء ان مجلسك هذا يحضره البار والفاجر افتامرني ان اغلظ فيه علي الفاجر؟ فقال : لا الم تستمع الي قوله تعالي : { قولوا للناس حسنا } وليس المراد تليين القول للفاسق واكرامه بالقول بلا ضرورة ، فان ذلك تهوين للدين ومداهنة فيه ، واختيار للدنيا علي الدين ، الا ان فعل ليجره للاسلام وتوهم بعض ان الاية خطاب لامة محمد A فزعم انها في ترك القتال ونسخت باية السيف .



 { واقيموا الصلاة } : المفروضة عليكم .

 { واتوا الزكاة } : هي ما فرض عليهم من زكاة ، وقيل هي ما يضعونه للنار التي تنزل فتاكل ما تقبل دون ما لم يتقبل وهذا القول اعم

 { ثم توليتم } : جار علي اسلوب الالتفات في قوله لا تعبدون بالمثناة الفوقية ، واما قراءة لا يعبدون بالتحتية ففي توليتم عليها التفات بالنظر الي قوله بني اسراءيل الغيبة الي الخطاب ، ويجوز ان يكون الخطاب في توليتم لمن في عهد سيدنا محمد A ودخل فيه من قبلهم تغليبا للحاضر علي الغاءب ومعني توليتم اعرضتم عما اخذ منكم من الميثاق ، فصرتم تعبدون غير الله ، ولا تحسنون بالوالدين ولا بذي القربي والمساكين واليتامي ، ولا تقولون للناس حسنا ، ولا تقيمون الصلاة ولا تءتون الزكاة ، وروي عن ابن عباس ان الخطاب لمن في عصره A اسند اليهم تولي اسلافهم لانهم كلهم بتلك السبيل .

 { الا قليلا منكم } : لم يتول وهم من عمل بما في التوراة قبل بعثته A ، وبما لم ينسخ منها بعد البعثة وامن به A ، كعبد الله بن سلام ، وكعب الاحبار ، والاستثناء من التاء فالعلة في عدد الاشخاص ، ويضعف ان يكون الاستثناء من التولي ، اي توليتكم كل تول الا توليا قليلا فانهم لم يتولوه ، وذلك بان فعلوا بعض ما امروا به دون بعض فيكون استثناء في الايجاب من محذوف ، وهو قليل ، واجاز بعضهم القياس عليه . ورويت رواية ضعيفة برفع قليل ، فيكون قليل بدلا من التاء ، وانما جاز ذلك مع ان الكلام تام موجب ، لان التولي بمعني النفي ، لان معناه الترك وعدم الفعل وذلك نفي ، وهو كما استثني في التفريع من الايجاب لتضمنه النفي في قوله :

 تغير الا النوي والوتد ... لان تغير بمعني لم يبق فيبطل اعتراض الصفاقصي اذا اعترض علي رفع قليل ، وعلي تاويل التولي ، بقولك لم يوفوا بالميثاق بانه مثل قولك قام القوم الا زيد علي تاويل لم يجلسوا ، ووجه البطلان ان توليتم موضوع لمفهوم تركتم وانتفيتم ، بخلاف قام فانه لم يكن مدلوله لم يجلس بل مدلول له فعل فعلا يسمي قياما ، ولو كان التعبير عنه بلم يجلس جاءز ، الا تري ان قولك لم يجلس حرف وفعل فكيف يفسر فعل بحروف وفعل .



 { وانتم معرضون } : هذه الجملة حال مءكدة لقوله : { توليتم } ، ويجوز ان يكون المعني وانتم ايها الذين في عهد محمد A معرضون عن الحق كاباءكم ، علي ان الخطاب قبل هذه الجملة لمن تقدمهم وان يكون المعني وانتم قوم من شانكم الاعرضا عن الوفاء بالميثاق ، او عن الطاعة ، سواء جعلنا هذه الجملة خطابا للذين في عهده A او لمن قبلهم او للكل ، فالجملة علي هذه الاوجه مستانفة او حال مءسسة ، والاعراض عن الشء عبارة عن تركه ، واصله الذهاب عن المواجهة الي جهة الاعراض .



  CHECK 

 { واذ اخذنا ميثاقكم } . . الخ : الكلام فيه كالكلام في الذي تقدم .

 { لا تسفكون دماءكم ولا يخرجون انفسكم من دياركم } : يحتمل تقدير مضافات اي لا يسفك بعضكم دماء بعضكم ، ولا يخرج بعضكم انفس بعضكم من ديار بعضكم ، اي من دياره ، ونكتة الحذف بقاء صورة الكلام دالة علي انه قاتل نفسه اذا قتل الاخر ، ومخرج نفسه اذا اخرج الاخر ، لانهما كواحد للنسب او للدين ، ولانه كما يدين يدان فيقتل اذا قتل : ويخرجه اذا اخرج من طبع الناس المجازاة ، فاذا قوي المغلوب اخرج ولا سيما القصاص ، فان الشرع والطبع كليهما يدعوان اليه ، وان قلت . كيف اضيفت دما لبعض والانفس كذلك؟ قلت : مسوغ ذلك ان البعض يجوز اطلاقه علي فرد وفردين وثلاثة واكثر ، فتشمل الانفس والدماء نفس المفروض علي حدة ، والمفروضين علي حدة ، والثلاثة المفروضين كذلك فصاعدا ودماءهم وكذلك الديار ولا سيما انه يجوز اعتبار اجزاء دم الواحد ، فيقال له دمه فيعبر عن قتله بسفك دماءه ، وكذا اجزاء نفسه وتشمل الديار ديار الواحد وديار كل احد ، ويجوز كون الاصل لا يسفك بعضكم دم بعضكم ، ولا يخرج بعضكم نفس بعض من دار بعضكم ، اي من داره كلما حذف المضاف ساغ جمع الدم والنفس والدار ، لانهن يضفن للجميع ويحتمل الا يقدر مضاف ، بل يخرج الكلام علي المجاز المرسل الذي علاقته سببية او المسببية او هما او اللازمية او الملزومية وهما بان عبر عن قتل الانسان اخروا اخراجه من داره بقتل الانسان نفسه واخراجه من داره ، لان فعله ذلك بالاخر يءدي الي ان يجازي بما فعل او علي المجاز الاستعاري بان يشبه الانسان بالاخر حتي كانه نفسه لجمع النسب ، او الدين او كليهما بينهما ، وقبل المعني لا تفعلوا ما يكون سببا لسفك دماءكم واخراجكم من دياركم من الشرك والزني وقتل النفس المحرمة والفساد في الارض ، فنهي عن المسبب وهو اللازم واراد النهي عن السبب وهو الملزوم ، وقيل المعني لا تخسروا انفسكم الخسران الحقيق بالاصرار علي الشرك والمعاصي ، فان هذا هو القتل الابدي الداءم ، ولا تخرجوا انفسكم بالاصرار علي ذلك من ما دياركم في الجنة ، فان هذا الاخراج الحقيقي ، واصل دم دمي باسكان الميم ، وقيل دمو كذلك حذفت لامه واعرب علي العين .

 { ثم اقررتم } : بالميثاق ولزوم الوفاء به ، او بانكم فيكم الميثاق واخذ منكم

 { وانتم تشهدون } : حال مءكدة وان جعلنا الخطاب السابق لاسلافنا وهذا لهم كانت الجملة مستانفة ، اي وانتم تشهدون علي اسلافكم انهم اقروا بالميثاق والتزامه ، ولك ان تجعل اقرارهم وانتم تشهدون كله خطاب لهم لا خطاب لاسلافهم ، كانت الجملة الثانية حالا مءكدا ، وكان اسناد الاقرار اليهم مجازا ، واصله ان يسند لاسلافهم ، وحقيقة الكلام ان يقال : ثم ذكرتم ذلك عن اسلافكم وانتم تشهدون ، او الجامع ان كلا من الاقرار والذكر تكلم بما هو الواقع او عبر بالاقرار لان مضرة اسلافهم مضرة لهم ، او لانهم علي طريقهم فاقرارهم علي اسلافهم اقرار علي انفسهم .



  CHECK 

 { ثم انتم هءلاء } : انتم مبتدا والاء خبرا والجملة معطوفة علي اقررتم عطف سيمة علي فعلية ، وانما كان العطف بثم الموضوعة علي تراخي وقوع الفعل او تراخي عدم وقوعه ، ليفيد استبعاد ما فعلوه من نقض الميثاق مع الاقرار به والشهادة عليه ، عن الصواب والدين ومقتضي العقل ، فقد استعملت ثم للتراخي في غير النسبة مع انها وضعت للتراخي في النسبة فقط استعمالا للمقيد في المطلق ، ولك ان تجعلها بمعني الواو او الترتيب في الاخبار بلا تراخ ، وهكذا في مثل ذلك مما لم تستعمل فيه للتراخي في النسبة ، واشار بلفظ هءلاء الي الناقضين للميثاق ، وان قلتك يف صح عطف هذه الجملة بثم الدالة علي التراخي علي الوجه الاول ، مع ان هءلاء الناقضين ابدا هم انفسهم اعينهم لا تمضي مدة متراخية ولا غير متراخية ، وهم فيها غير انفسهم فانه لا يقال لزيد ثم انت زيد ، لانه هو زيد قبل وبعد وفي الحال ، قلت : نزل تغير الصفة منزلة تغير الذات فان تغير الصفة التي هي الوفاء الواقع تحقيقا او امكانا الي الصفة التي هي النقض كتغير الذات ، ولذلك صح الاخبار عن لفظ انتم بما هو نفس مدلوله ، اذ المعني ثم انتم بعد ذلك هءلاء الناقضون ، كقولك ثم انت ذلك الرجل الذي خان وغدر بعد ما اكرمته واءتمنته ، ولذلك ايضا صح العطف علي اقررتم ، كانه قيل : اقررتم ثم نقضتم ، ومن تنزيل تغير الصفة منزلة تغير الذات قول المشركين في شان الذي ارسلوه الي سيدنا محمد صلي الله لعيه وسلم مشركا ورجع مءمنا : والله لقد رجع بغير الوجه الذي ذهب به . وقال ابو الحسن بن احمد الباد : انتم خبر وهءلاء مبتدا ، واعترضه ابو حيان بانه لا داعي الي جعل مبتدا انتم وهءلاء خبر مع سلامته من تقديم وتاخير . قلت : لعل داعيه انه قلما يجتمع الضمير والاشارة يخبر باحدهما عن الاخر الا قرن الضمير بها للتنبيه ، وجء بعده باسم الاشارة مجردا منها ومقرونا ، فحينءذ يتبادر كون الضمير مبتدا لقرنه بهاء التنبيه ، ومثل الاية قوله تعالي : { هم اولاء } والجملة علي كل حال وعيد لهم لا عتبار ما اسند اليهم من الافعال القبيحة حصورا للفظ انتم . . الخ ، وباعتبار ما حكي عنهم غيبا لقوله يردون .

 { تقتلون } : حال ناصبها معني الاشارة ، وبهذه الحال تم المعني كما قال ابن الباذش ، ويجوز كون هذه الجملة بدلا من قوله : { انتم هءلاء } او عطف بيان عند من اجازه في الجملة ، او مستانفة لبيان الجملة قبلها ، وقيل : هءلاء منادي بحرف محذوف ، وتقتلون خبر انتم ، اي ثم انتم يا هءلاء تقتلون وحذفه مع الاشارة قليل منع سيبويه القياس عليه ، قال ابن هشام : شذ حذفه معها في قوله :



 اذا هملت عيني لها قال صاحبي ... بمثلك هذا لوعدة وغرام

 اي يا هذا ، ولحسن بعضهم المتنبي في قوله :

 *هذي بررت لنا فهجت رسيسا* ... اي يا هذه واجيب بان هذي مفعول مطلق ، اي برزت هذه البرزة ، ورده ابن مالك بانه لا يشار الي المصدر الا منعونا بالمصدر المشار اليه كضربته ذلك الضرب ، ويرده بيت انشده هو وهو قوله :

 يا عمرو انك قد مللت صحابتي ... وصحابتك اخال ذاك قليل

 انتهي ولم يشترط غير ابن مالك نعته بالمصدر ، وفي تلحين المتنبي نظرا لانه كوفي والكوفي يجيز حذف حرف النداء مع الاشارة ومن ذلك قوله :

 ان الاولي وصفوا قومي لهم فيهم ... هذا اغتصم تلق من ذاك مخذولا

 اي يا هذا ، وقوله :

 ذا ارعواء فليس بعد اشتعا ... ل الراس شيبا الي الصبا من سبيل

 اي ارعوا رعواء بذا ، وذلك مقيس مطرد عند الكوفيين ، ومنع البصريون القياس عليه لانه انما ورد نصا في الضرورة فلا تحمل عليه الاية ، مع ان لها اوجها منها ما تقدم من كون هءلاء مبتدا او خبرا ، ومنها ما قيل انه توكيد لانتم والخبر تقتلون ، ومنها ما قيل انه موصول خبر لانتم او مبتدا له وتقتلون صلته ، وقرء بتشديد التاء للتكثير .

 { انفسكم } : اي يقتل بعضكم بعضا .

 { وتخرجون فريقا منكم } : من للتبعيض .

 { من ديارهم } : من للابتداء والدار ما يبني للاقامة مشتملا علي بيوت . وقال الخليل : الديار محلة القوم بناء او غيره .

 { تظاهرون عليهم بالاثم والعدوان } : الجملة حال من واو تخرجون ، او من فريق لانه منعوت بمنكم ، او حال منهما لاشتمال الجملة علي ضميرهما ، والتظاهر التعاون ماخوذ من الظهر ، يستعمل في المعاونة ، لان قوة الجوارح في الجيد والدفع بقوة الظهر ، ولانه كلما طال الظهر وكثرت فقراته وعظامه ازدادت القوة ، ولو صغر الحيوان كالحية فقد تغلب الانسان بالجيد ، وقد يكون علي شكلها لكنه اطول واغلظ بقليل منها ، فيقبض الانسان بذنبه وعجزه فيحمله ، والاصل تظاهرون بتاءين ابدلت الثانية ظاء وادغمت في الظاء ، وقرا عاصم وحمزة والكساءي بتاء واحدة ، وتخفيف الظاء حذف تاء الماضي وهي الثانية ، او تاء المضارع وقرء تتظاهرون باثباتهما وتخفيف الظاء ، وقرء تظهر بتاء وظاء مشددة واسقاط الالف بعدها ، وتشديد الهاء بوزن تتفعلون بتاءين ، وتشديد العين ، والاصل تتظهرون بهذا الوزن ، ابدلت التاء الثانية ظاء او ادغمت وكذا القراءات في التحريم والاثم والمعصية صغيرة كانت او كبيرة ، والعدوان الكبيرة التي عدت الكباءر اي جاوزته في العظم .

 { وان ياتوكم } : اي وان ياتكم الفريق الذين اخرجتم من ديارهم ، او ان ياتكم جماعة من الذين تخرجون منهم من قدرتم عليه ، وتقتلون من قدرتم عليه ، وهذا اعم والكلام السابق يدل عليه .

 { اساري } : بضم الهمزة جمع اسري بفتحها واسكان السين ، واسري جمع اسير بمعني ماسور فعيل بمعني مفعول ، كقتيل وقتلي لما كان اسري بوزن سكري جمع علي اساري كسكاري ، فاساري جمع الجمع ، ويجوز ان يكون جمع اسير للتشبيه بكسلان ، لان الاسير محبوس عن كثير من تصرفه ، كما لا يتوصل الكسلان الي كثير مما يحتاج اليه ، فجمع علي اساري كما يجمع كسلان علي كسالي ، والاصل اسير المشدود بالاسر ، اي الحبل اطلق علي كل من جلبه العدو ، لان من شانه ان يشد بالحبل لءلا يهرب سواء شد به او بغيره كالحديد او لم يشد ، ولان من جلبه العدو ممنوع عن اهله ، وما يريد كمن شد بالحبل عما يحب ، وقرا حمزة : وان ياتكم اساري .



 { تفادوهم } : تنقذوهم من الاسر بالمال ، او بامثالهم من الرجال او غير ذلك وقرا ابن كثير وابو عمرو وحمزة وابن عامر : تفدوهم بفتح التاء واسكان الفاء ، والمعني واحد ، ولكن المفاداة تدل بالمطالقة علي ان كلا من الغالبين والمغلوبين اخذ واعطي ، وفدي يدل علي ذلك بالالتزام ، او اما بالمطابقة فانما دل علي اعطاء المغلوبين واخذهم فقط فافهم ، وقال الثعالبي يقال : فدي اذا اعطي مالا واخذ رجلا ، وفادا اذا اعطي رجلا واخذ رجلا ، ومن استعمال فادي في اعطاء مال واخذ رجل قول العباس رضي الله عنه : فاني فديت نفسي وعقيلا . روي ان قريظة كانوا حلفاء الاوس ، والنضير حلفاء الخزرج ، فكان قريظة وهم يهود يعاونون الاوس وهم عرب ويقاتلون معهم عدوهم الخزرج ، وكان النضير وهم يهود فريق مع حلفاءه في القتال وتخريب الديار والاخراج منها ، واذا اسر الخزرج رجلا من قريظة جمعت له النضير حتي يفكوه من الخزرج ويفدوه ، وكذا اذا اسره النضير لانهم ، في القتال مع الخزرج ، الا ان سامحه الخزرج وتركوه وسبيله بلا فداء ، واذا اسر الاوسل رجلا من النضير جمعت له قريظة حتي يفدوه من الاوس علي حد ما مر كله ، وقيل ان النضير وقريظة حالفوا الاوس ، وبني قينقاع حالفوا الخزرج ، فاذا وقع الحرب بين الاوس والخزرج ذهبت كل طاءفة من اليهود مع احلافها ، وذكر ان العرب عيرتهم كيف تقتلونهم ثم تفدونهم؟ فقالوا : انا امرنا ان نفديهم ، فقال العرب : كيف تقاتلونهم؟ فقالوا : نستحي ان تذل حلفاءنا وذلك ان الله جل وعلا اخذ عليهم الميثاق في التوراة الا يقتل بعضهم بعضا ، ولا يخرج بعض بعضا من داره ، وايما عبد وامة من بني اسراءيل وجدتموه فاشتروه بما قام من ثمنه واعتقوه ، وخالفوا احكام التوراة وعيرهم الله جل وعلا بقوله : { واذ اخذنا ميثاقكم } الي قوله :

 { وهو محرم عليكم اخراجهم } : الجملة متصلة بقوله : { وتخرجون } وهي حال من واو تخرجون ، وجملة { وان ياتوكم اساري تفادوهم } ، معترضة او معطوفة علي تظاهرون عليهم بالاثم والعدوان ، ولفظ هو ضمير الشان ، ومحرم خبر مقدم ، واخراج مبتدا مءخر ، والجملة خبر ضمير الشان ويجوز ان يكون ضميرا مبهما يفسره لفظ اخراجهم علي ان يكون عطف بيان علي هو ، او بدلا منه ، ومحرم خبرا واخراج مبتدا سبق تفسيرا له ، ويجوز كون هو عاءد الي الاخراج الذي دل عليه تخرجون ، واخراجهم بدل او بيان له ، ومحرم علي هذا خبر ، ويجوز علي هذا كون اخراج ناءب محرم وضعا للظاهر موضع المضمر .



 { افتءمنون ببعض الكتاب } : المراد بالكتاب التوراة ، وبعضه الذي امنوا به هو لزوم الفداء المفروض عليهم فيه .

 { وتكفرون ببعض } : هو تحريم القتال والاخراج من الديار والمعاونة في ذلك بلا وجه شرعي .

 { فما جزاء من يفعل ذلك منكم الا خزي في الحياة الدنيا } : قال الكلبي : المراد بالخزي الاخراج من الديار والقتل اخرجت النضير وقتلت قريظة ، يا بن ادم كما تدين تدان ، وقال الحسن : الخزي الجزية ، ولعل ذلك منهما تمثيل ، والمراد يا يعم ذلك الجزية علي غيرهم ، ولما اخرجت النضير سكنت اريحاء واذرعات من ارض الشام ، وتلك الجزية هي اصل الجزية الي اخر الدهرن ولفظ الخزي : الفضيحة والعقوبة ، فهو عام يحتمل علي عمومه ، واصله ذلك يستحي منه ، ولذلك فسره بعضهم هنا بغلبة العدو ، والحياة مصدر ناءب عن اسم الزمان ، اي في وقت الحياة التي هي دانية ، اي قريبة الزوال او قريبة الاطراف ، فهي غير طويلة ، والدنيا مءنثة لاسم تفضيل ، وهو الادني باق علي الوصفية وباءه عن واو ابدلت فرقا بين الاسماء والصفات .

 { ويوم القيامة يردون الي اشد العذاب } : هو عذاب النار الداءم او عذابها والحشر بحال قبيحة يستحيون منها ، والتشديد عليهم والتضييق في المحشر والنداء علي رءوس الاشهاد بقباءحهم ردوا الي اشد العذاب ، لان عصيانهم من اشد العصيان . وقرا عاصم في رواية المفاضل شذوذا بالمثناة الفوقية .

 { وما الله بغافل عما تعملون } : بالياء المثناة التحتية عند نافع وابن كثير وابي بكر ، وقرا الباقون بالفوقية قاله ابو عمرو الداني : وقال القاضي قرا بالتحتية نافع ويعقوب ، والباقون بالفوقية ، فالتحتية في يردون ويعملون بالنظر الي من في قوله : من يفعل ، والفوقية علي طريق الخطاب السابق في الناقضين ، وانما صدق واحدا وعلي طريق الالتفات الي الخطاب عن الغيبة التي في قوله : من يفعل ، والجملة تا : يد للوعيد ، كانه قيل ان الله سبحانه وتعالي لبالمرصاد لا يغفل عما تعملون ، فهو مجازيكم بكل ما فعلتم من صغير او كبير ، والكلام في ذلك كله لليهود فقط ، وانما يدخل غيرهم بالمعني فقط ، اذ كل مكلف كذلك ، ويحتمل ان يكون قوله : { وما الله بغافل عما تعملون } بالفوقية خطابا لقريش ونحوهم ، اي لا يغفل عنكم كما لم يغفل عن اليهود ، وعن عمر بن الخطاب رضي الله عنه انه قال : ان بني اسراءيل قد مضوا وانتم الذين تعنون بهذا يا امة محمد ، يريد ان امة محمد A مكلفون بذلك الذي كلف به بنو اسراءيل ، ومعاقبون ان توفوا كما عوقبت بنو اسراءيل حين لم يوفوا ، وليس مراده ان الاية خطاب لهذه الامة ، واول ما ظهر هذا العقاب الظهور الفاحش الشنيع بخراسان من المشرق ، وبالاندلس من المغرب ، شاع الجور والمعصية فعوقبوا بايدي الروم . وفي الاثر عنه A من الحديث القدسي : « اذا عصاني من يعرفني سلطت عليه من لا يعرفني » وهذه المعرفة مراتب فانظر كيف سلط الله علي الموحدين لما عصوه الروم ، وسلط المخالفين علي الاباضية الوهبية وسلط عوام الاباضية الوهبية علي خواصهم لما عصت الخواص .



  CHECK 

 { اولءك الذين اشتروا الحياة الدنيا بالاخرة } : اي اخذوا الحياة الدنيا بدل الاخرة اختيارا لها علي الاخرة ، وذلك الشراء هو كسبهم المعاصي ، فان الجمع بين لذات الدنيا والاخرة غير ممكن ، فالاشتغال بالمعاصي الموجبة للنار هو ترك للاخرة وبيع لها .

 { فلا يخفف عنهم العذاب } : عذاب الاخرة بنقص بعض او قوته بتركه في مدة .

 { ولا هم ينصرون } : لا يدفع عنهم العذاب ولا ينقذون منه ، ويجوز ان يكون معني { لا يخفف عنهم العذاب } لا يخفف عنهم عذاب الدنيا بنقص الجزية ابدا ، او في مدة ، ولا يخفف عذاب الاخرة كذلك ، ومعني : { ولا هم ينصرون } لا يدفع عنهم عذاب الاخرة ولا الجزية ابدا ويجوز ان يكون المعني لا يخفف عنهم عذاب الدنيا ولا ينقذون من عذاب الاخرة .



  CHECK 

 { ولقد اتينا موسي الكتاب } : التوراة نزلت عليه بمرة ، واللام في قوله ( لقد ) لام ابتداء عند بعض ، ولام جواب قسم محذوف عند بعض ، ورجحه كثير ومعناه التوكيد علي القولين ، قال السهولي : موسي مفعول ثاني والكتاب مفعول اول ، ووجهه عندي ان ههمزة اتينا للتعدية ، صيرت الفاعل مفعولا وهي مزيدة علي اتي الثلاثي للتعدية والمفعول الذي اصله فاعل هو الذي يسمي مفعولا اولا ، والمعني ولقد جعلنا الكتاب اتيا موسي بالغا اليه ، وقال غيره : موسي مفعول اول والكتاب مفعول ثان ، ووجهه عندي انه ضمن اتينا معني اعطينا ، فكان موسي اخذا فهو الفاعل في المعني فهو المفعول الاول .

 { وقفينا من بعده بالرسل } : تشديد قفينا للتاكيد والياء للتعدية قاءمة مقام الهمزة التي للتعدية ، ويجوز كون التشديد للتعدية لا للتاكيد ، والرسل مفعول به والياء زاءدة فيه ، والمعني اتبعنا الرسل بعضها بعضا اي صيرنا بعضها يتبع بعضا . قفي زيد عمرا اي جعله قافيا اياه ، اي تابعا له وذلك من القفا ويقال ايضا : قفيت فلانا فلانا اذا جءت به من جهة قفاه ، وقفوته بالتخفيف تبعته ، وقفوته ببكر اي تبعته به ، ويقال ذنبته بالتشديد اي صيرته ذنبا ، والمعني اتبعنا الرسل الكثيرة بعد موسي خلف بعض ، وهم : يوشع واسمءيل وشمعون وداود وسليمان وشعيا وارميا وعزير وحزقيل والياس واليسع ويونس وزكريا ويحيي وغيرهم ، كما ذكره الزمخشري ، وكلهم يحكمون بالتوراة حتي بعث الله عيسي بن مريم وانزل عليه الانجيل وخالف بعض الانجيل بعض التوراة ، فقال بعضهم : الانجيل هو المراد بالايات البينات في قوله D :

 { واتينا عيسي بن مريم البينات } : اي الايات الواضحات الدالة علي الاحكام الشرعية ، وهي الايات التي تتلي في الانجيل ، وقال الكلبي : البينات المعجزات الواضحات كاحياء الموتي وابراء الاكمه والابرص ، والاخبار بالغيب باذن الله ، وقيل : الحجج التي يحتج بها في كلامه ، ويجوز ان يراد ذلك كله ، وعيسي بالسريانية وهي العبرية يشوع بالشين المعجمة ، ويقال ايضا بالمهملة ومريم علم لامه رضي الله عنها ، واصل هذا اللفظ بالعبرية صفة بمعني الخادم ، سميت به وتلقيت عليه الاسمية ، وقيل المريم في لسان العرب موجود بمعني المراة التي تحدث الرجال وتميل اليهم ، كالزءر بكسر الزاء بعده همزة وهو الرجل الذي يحب محادثة النساء ومجالستهن ، قال رءية يمدح السفاح او المنصور :

 قلت لزير لم تصله مريم ... قليل اهوي الصبي تندسي

 وهذه في لغة العرب ، وليست هذه الصفة في مريم الا ان احبت محادثة الانبياء والعلماء ، ووزن مريم بالمعني العربي ، مفعل فميم زاءدة والياء اصل من رامه يرميه اذا فارقه او لازمه يستعمل بالمعنيين ، وليس وزنه فعيل باصالة الميم وزيادة الياء لان هذا غير موجود في الابنية ، بل الموجودة فعيل بضم الفاء كعليب وفعيل بكسرها كعثير .



 { وايدناه } : قويناه والايد القسوة ، وقرء : ايدناه بهمزة فالف وفتح الياء خفيفة ، والمعني واحد كما قال اجده بتشديد الجيم بمعني قواه واجد بتخفيفها بعد الف وهمزة ، والمعني واحد ، ويقال الحمد لله الذي اجدني بعد ضعف ، اي قواني واوجدني بعد فقر ، اي اغناني .

 { بروح القدس } : اي بجبريل الطهارة ، فروح بمعني جبريل علم عليه ، فيكون من اضافة العلم لعلة المدح كما اضيف للبيان في قوله :

 علي زيدنا يوم الوغي راس زيدكم ... ونقول في المدح زيد العلم وزيد العقل وزيد الفوز ، والقدس الطهارة من الذنوب ، وجبريل طاهر منها ، فاضيف للقدس لاجل ذلك او لكرامته علي الله سبحانه ، وسمي روحا للطافته كروح الحيوان ، لانه روحاني خلق من النور ، وقيل سمي روحا لمكانه من الوحي الذي هو للقلب كالروح للجسد ، ويحتمل ان يكون روح هو جبريل والقدس من الطهارة كذلك ، لكن بمعني القدس من اضافة الموصوف للصفة ، وفيه تكلف ويحتمل ان يكون الروح جبريل ، والقدس الله ، كما يقال عبدالله ، وما ذكرته من كون روح هو جبريل هو قول السدي والضحاك والربيع وقتادة وهو الاصح لتعاقب روح القدس ، وجبريل في قوله ، A : « اهج قريشا وروح القدس معك » مع قوله A مرة اخري : « اهج قريشا وجبريل معك » فان المتبادر انهما في الحديثين واحد ، وان قلت : كيف قلت روح علم جبريل وقد قرن بال في قوله تعالي : { تنزل الملاءكة والروح } ؟ قلت : ال فيه للمنح ، وقيل الروح عيسي عليه السلام اضيف للقدس ، والقدس بمعني الطهارة مجرد اضافة المدح بالمعني المصدري ، او اضافة موصوف لصفته ، بمعني القدس اي المطهر ، ووجه نسبته للطهر انه سالم من مس الشيطان حين ولد ، او انه كريم علي الله تعالي ، ولذلك اضاف الروح الي نفسه في قوله : وروح الله كلمته ، او انه لم يكن في صلب الرجال ولا ارحام الحواءض ، كذا قيل ، ويبحث فيه بانه قد ضمه ظهر ادم ، وقد ذكر الواحدي وغيره ان الله سبحانه وتعالي اخرج الناس من ظهر ادم ، واخذ عليهم الميثاق { الست بربكم ، قالوا : بلي } ثم ردهم الا روح عيسي لم يردها بل حفظها ، الي ان قدر ان تحمل مريم ، فارسل جبريل بروح عيسي فنفخ فحملت .

 وقد يجاب بان المراد لم يكن في اصلاب جماعة الرجال العامة ، اما رجل واحد بني او رسول فلا ضير به ، ولو تصور تضمن انبياء كثيرة له لم يضر ذلك . ويبحث ايضا بان مريم لما رات جبريل بصورة شاب يتبادر انه نزل منه الماء الي رحمها وهي قد كانت في اصلاب الرجال ، فقد كان فيها بكون امه فيها الا ان يجاب بانه لم ينزل لها ماء ، ويبحث ايضا بان المشهور انها تحيض ، ويجاب بانه قول ، وعدم حيضها قول ، فلا يرد قول بمجرد قول .



 ويبحث ايضا بانه كان في ارحام الحواءض بكون امه في ارحام الحواءض ، الا ان يقال بانه لم ينزل لها ماء كما مر ، وبيان تاييد الله جل وعلا ، عيسي عليه السلام بجبريل ، ان جبريل امره الله الا يفارقه وان يسدده ، فكان كذلك فلم يفارقه حتي صعد هو به الي السماء . وقال ابن زيد : روح القدس هو الانجيل كما سمي الله تعالي القران روحا ، وقال ابن عباس : هو اسم الله الاعظم الذي كان يحيي به الموتي باذن الله D ، واضافة الانجيل او الاسم الاعظم للقدس تشريف ، والقدس الطهارة من النقاءص او اسم الله او الاضافة من اضافة الموصوف للصفة ، كما مر من القولين الاخيرين ايضا . قال ابو عمرو الداني : قرا ابن كثير القدس مخففا حيث وقع ، يعني مسكن الدال والباقون مثقلا يعني مشدد الدال . قال الكلبي : ولما سمعت اليهود بذكر عيسي وبيانه في هذه الاية قالوا لرسول الله A : فلا مثل ما جاء به موسي جءنا به ، ولا مثل ما عمل عيسي كما تزعم عملت ، ولا كما نقص علينا من اخبار الانبياء فعلت فاءتنا بما اتي به عيسي ان كنت صادقا ، وفي رواية اسقاط ذكر موسي ، فنزل قوله تعالي :

 { افكلما جاءكم رسول بما لا تهوي انفسكم استكبرتم ففريقا كذبتم وفريقا تقتلون } : ولما تلا رسول الله A ذلك سكتوا وعرفوا انه الوحي من الله D ، عيرهم بما فعلوا . والهمزة للاستفهام التوبيخي وفيها تجب من شانهم ، وهي في المعني داخلة علي قوله استكبرتم ، فهو محط الاستفهام ، لكن فصل بينهما بقوله : { افكلما جاءكم رسول بما لا تهوي انفسكم } والفاء للاستءناف مقدمة علي الهمزة في الاصل ، ولكن اخرت لتمام صدارة الهمزة ، وكذا تقول : ان جعلت الفاء عاطفة علي محذوف معطوف علي محذوف ، اي ولقد اتينا انبياءكم ما اتيناهم ففعلتم ما فعلتم ، افكلما . . الخ بعطف الاستفهام علي الاخبار ، وكذا يجوز العطف علي ولقد اتينا موسي الكتاب ، وليس كما قيل ان الهمزة في مكانها اذا جعلت الفاء للاستءناف ، فان حكم فاء الاستءناف في ذلك حكم فاء العطف ، ولو لم يذكروه ، بل اصل فاء الاستءناف العطف وكذا واو الاستءناف ، ولذا لا يءتي بهما للاستءناف في اول كلام لم يسبقه شء مذكور ولا مقدر ، وكل ظرف زمان متعلق باستكبرتم ، وذلك انه اضيف للمصدر الناءب عن اسم الزمان وهو المجء ، فان ما مصدرية ، وجاء في تاويل مصدر مضاف اليه ، وتهوي بفتح الواو بمعني تحب وماضيه هوي بكسرها واكثر ما يستعمل شرعا فيما ليس بحق واما لغة فيستعمل في الحق والباطل والمباح وهو حق ، وفي كل شء ، واما السقوط فيقول فيه هوي بفتحها يهوي بكسرها ، اي بما لا تحبه انفسكم من الحق ومعني استكبرتم تعظمتم وترفعتم عن الايمان بالحق ، واتباع الرسول الذي جاءكم في اي حين جاءكم ، والفريق الذين كذبوا كموسي وعيسي ومحمد وغيرهم ، وما جاء رسول الا كذبوا به كما هو نص الاية ، والفاء في قوله : ( ففريقا ) للاستءناف استءنف بها كذبتم ، وتقتلون ، وفيما بعدها من الجملتين تفصيل لما تضمنه الاستكبار ، وعاطفة علي استكبرتم وهي للتفصيل ايضا او عاطفة سببية ، بمعني ان ما بعدها من التكذيب والقتل مسبب عن الاستكبار المذكور قبلها ، والمعطوف هو جملة كذبتم وتقتلون ، والفريق الذي يقتلون كزكريا ويحيي وعدد كثير ، روي انهم قتلوا ثلثماءة نبي في يوم واحد ، ثم قامت سوق بقلهم اخر النهار ، وفي رواية يقتلون ثلثماءة نبي في اليوم الواحد ، ثم تقول سقو البقل اخره ، وهذه الرواية تدل علي تعدد قتل هذا العدد في ايام .



 وروي انهم قتلوا في يوم واحد سبعين نبيا ، وقامت سوق بقلهم اخر النهار ، ويمكن الجمع عندي بان السبعين انبياء رسل وثلثماءة انبياء غير رسل او انبياء فيهم رسل ، وتقتلون مضارع بمعني الماضي ، او شبه القتل الماضي المنقطع الذي لا يري بالقتل الحاضر المشاهد لتحقق وقوعه كتحقق المشاهد ، فعبر عنه بالمضارع الدال علي الحال ، او شبه هذا الزمان الذي نزلت فيه الاية بذلك الزمان الذي وقع فيه القتل ، كانه زمان حاضر يشاهد ما وقع فيه من القتل ، فان الحاضر اوقع في النفس ، فمعاينة القتل اشد علي النفس وهو في نفسه افظع ، واما حكايته فدون ذلك ولو اطمان القلب ، وفي ذلك مراعاة الفواصل ، فانها النون اخرها قبله واو او ياء ، ولو قال قلتم لم يكن ذلك ، ويجوز كونه للحال الحاضرة باعتبار انهم الي زمان النزول علي ذلك الطغيان ، فكم تشاوروا في قتل محمد رسول الله A وكم عدد تصدي لقتله ، وقد سحروه ، حتي نزلت المعوذتان عصمة له ، حتي سمته يهودية في ذراع شاة حين فتح خيبر ، فمات رجل اجل منها ، وكانت سبب موت رسول الله A مكثت فيه مضرة اكله منها سنين ، يتوجع بها تارة وتسكن اخري حتي مات بها ، فجمع الله تعالي له النبوة والشهادة ، قال A : « ما زالت اكلة خيبر تعاودني فهذا اوان قطعت ابهري »

 ثم سمت له اليهودية الشا ... ة وكم سام الشقوة الاشقياء

 وذلك كله لحبهم الدنيا ، فلا تري احب للدنيا من اليهود فيما يظهر لي مالها وجاهها ، كانوا كلما جاءهم رسول بما لا يحبون مما خالف شهواتهم كذبوه وقتلوه ان تهيا لهم قتله ، والا كذبوه ، وقد قصدوا عيسي بالقتل فنجاه الله اليه بعد ما عملوا في قتله ، وعالجوا حتي قتلوا اخاهم قبحهم الله وقيل قتلوا مءمنا عليه الشبه اكراما له .



  CHECK 

 { وقالوا } : لرسول الله A .

 { قلوبنا غلف } : مغطاة باغطية خلقت عليها فلا يصل اليها ما تقول يا محمد ولا نفقه ، وهذا كذب منهم بل ذل قلوبهم وفهموه حقا ولم تخلق عليهم اغطية وجحدوه عمدا ، ويحتمل ان يكونوا قالوا ذلك عنادا ظاهرا وجحودا مواجها ، بمعني ان قلوبهم لم تقبل ما جاء به ، ولو كان حقا . ويحتمل ان يكون ذلك كناية عن انهم لا يقبلون كلامه ، ولو قبلته قلوبهم وكان حقا ، ويحتمل ان يكون المعني ان قلوبهم تابي قبول ما قال ، لكونه خطا فذلك كناية منهم قبحهم الله عن ان ما يقول ليس بحق ، وانه لو كان حقا لاثر في قلوبهم . وان قلت : كيف صح الاحتمال الذي قبل هذا ، مع ان لفظ قلوبنا غلف ينافيه؟ قلت : صح لانه لا يلزم استعمال الكناية في المعني الحقيقي مع لازمه ، بل تستعمل فيها تارة وتستعمل في لازمة فقط اخري ، وعدم قبول كلام الانسان في الجملة يجوز ان يكون عن كون قلب السامع مغطي ، والغلف جمع اغلف ، والاغلف الذي لم يختن ، استعير للقلب المغطي بجامع كون الستر علي كل من القلب بما غطي به في زعمهم ، ومن راس الذكر بالغفلة التي يقطعها الخاتن ، ولذلك صح ذلك الجمع هنا ومفرده فان افعل وفعلا فيما هو خلقه او لون كابكم وبكم واحمر وحمر ، قال الحسن : غلف قلف لم تختن ، لقولك يا محمد ، وقال ابن مجاهد عن ابيه : غلف اي في اكنة ، والمعني واحد ، لان هذا معني لفظ الاستعارة في كلام الحسن ، وتفسير الغلف بالمغطاة مروي عن ابن عباس ، وهو ايضا معني ذلك اللفظ ، وذلك كقوله : { قلوبنا في اكنة مما تدعونا اليه } وفي رواية عن ابن عباس : ان الغلف جماعة ، والواحد غلاف واصله غلف بضم اللام كالغين سكن تخفيفا ، وقد روي عن ابي عمر شذوذا بضم اللام كالغين علي اصل ، وان المعني ان قلوبنا اوعية للعلم لا تسمع علما الا وعنه ، ولا تعي ما تقول لانه ليس حقا ، وقيل قلوبنا اوعية للعلم مملوءة به ، مستغنية عما تقول قال الله D ردا عليهم :

 { بل لعنتم الله بكفرهم } : اي لم يخلق الله غطاء علي قلوبهم مانعا من فهم ما يقول محمد . وقبوله وانما خلقهم علي الفطرة والتمكن من فهمه وقبوله ولذلك عصوا بمخالفة التوراة فكفروا فابعدهم الله بكفرهم الموجب للابعاد عن قبوله وفهمه ، فذلك خذلان فبطل تمكنهم بسوء اختيارهم مخالفة التوراة وذلك جزاء علي الذنب بذنب اعظم منه ، ويجوز ان يكون لما زعموا ان قلوبهم ممتنعة من قبوله وفهمه لكونه غير صواب ، رد الله تعالي عليهم بانها لم تمتنع لكونه غير صواب ، لانه صواب ، بل امتنعت للخذلان الذي جره كفرهم السابق من مخالفة امر التوراة ، كقوله :



 { يضل من يشاء } وقوله : { فاصمهم واعمي ابصارهم } او لما قالوا ان قلوبنا اوعية للعلم مملوءة به مستغنية عنك ، رد الله D عليهم بانهم كفرة ابعدهم الله عن مقامات العلم ، فمن اين لهم العلم والاستغناء عنك .

 { فقليلا ما يءمنون } : قليلا مفعول مطلق ليءمنون علي حد الموصوف ، وما صلة لتاكيد القلة اي يءمنون ايمانا قليلا قلة دقيقة ، ولا يجوز ان تكون ما نافية ، لان لا نافية الصدر فلا يعمل ما بعدها فيما قبلها ، وهنا قد عمل ما بعدها فيما قبلها فليست نافية ، واجازه بعضهم ان لم تعمل عمل ليس ، ولان في كونها نافية ايهاما فان المعني المقصود علي النفي انهم لا يءمنون ولو ايمانا قليلا ، واللفظ يوهم ان الايمان القليل لا يءمنونه ولكن يءمنون الايمان الكثير ، وهذا لا يصح ، والقلة في الاية علي اصلها كما مر في قولي يءمنون الايمان الكثير ، وهذا لا يصح ، والقلة في الاية علي اصلها كما مر في قولي يءمنون ايمانا قليلا قلة دقيقة ، ويجوز كونها بمعني النفي ، ولا يمكن كون ما علي هذا الوجه نافية الا علي تاكيد النفي تاكيدا لغويا اصطلاحيا ، فان اللغوي يكون في كل واحد من الفعل والاسم والحرف للاخر ، فكانه قيل لا لا يءمنون بتكرير لا ، ولو جعلت نافية غير مءكدة للنفي المستفاد من : قليلا ، لكان المعني انتفاء عدم ايمانهم وهذا غير مراد ، وابقاء القلة علي اصلها هو الراجح والقلة انها هي بالنسبة الي من امن من غيرهم اذ قد من اكثر من ثلاثة منهم كعبد الله بن سلام وكعب الاحبار ورفاعة القرضي ، وذكر رفاعة القرضي في قوله تعالي : { الذين اتيناهم الكتاب من قبله هم به يءمنون } انه من عشرة من اليهود ، وانهم المراد في هذه الاية { الذين اتيناهم . . الخ } ، وانا احدهم ولا ينافي قوله هذا قول الحسن عنه A انه لو امن بي واتبعني وصدقني عشرة من اليهود لم يبق علي ظهرها يهودي الا اتبعني ، لان المراد عشرة غير اثنين اتم بهما رفاعة العشرة التي ذكرها هو ، وقال كعب ردا علي الحسن لما روي الحديث بلفظ العشرة بل اثني عشر قال : ومصداقي في كتاب الله : { ولقد اخذ الله ميثاق بني اسراءيل وبعثنا منهم اثني عشر نقيبا } ويحتمل ان يراد في رواية الحسن عشرة بعد اثنين اسلما يتم بهما اثني عشر ، ولو اسلم عشرة وهذا علي انه لم يسلم الا اثنان كما زعم بعض المفسرين ، قال بعض لا نعلم احدا من اليهود اسلم علي عهد رسول الله A الا رجلا واحدا ، والحسن يذكر اخر ولا ادري من هو .



  CHECK 

 { ولما جاءهم كتاب } : القران .

 { من عند الله } : متعلق بجاء او بمحذوف نعت الكتاب .

 { مصدق لما معهم } : من التوراة . وقيل ما معهم التوراة والانجيل وذلك ان رسالة سيدنا محمد A وصفته مذكورتان في التوراة والانجيل كما ذكرت رسالته في القران وصفته ، مثل قوله تعالي : { انك لعلي خلق عظيم } وقرء ( مصدقا ) بالنصب علي الحال من كتا بعلي ان من عند الله نعت لكتاب وسوغ مجء الحال من النكرة وصفها ولك تعليق من عند الله ايضا في هذه القراءة بجاء ، والمسوغ الوصف المعني فان تنكير كتاب للتعظيم ، ومعناه كتاب عظيم ، ويحتمل ان يكون معني وقله : ( ما معهم ) الذي معهم من العلم برسالته وصفته او الذي معهم من رسالته وصفته وجواب لما محذوف يقدر قبل قوله :

 { وكانوا من قبل } : اي من قبل مجيءه .

 { يستفتحون } : والدليل عليه جواب لما الثانية فيقدر بلفظه ، اي ولما جاءهم كتاب من عند الله مصدق لما معهم كفروا به ، ويجوز تقديره بما يناسب جواب الثانية وجوابها ايضا دليل عليه ، فان الشء يدل علي مناسبه كما يدل علي مماثله ، ويستشعر بذكره اي ولما جاءهم كتاب من عند الله مصدق لما معهم كذبوا به او استهانوا به او ما اشبه ذلك ، ومعني يستفتحون يستنصرون . قال الله جل وعلا : { فعسي الله ان ياتي بالفتح } اي بالنصر ، اي يطلبون من الله الفتح اي النصر بسيدنا محمد A علي مشركي العرب اذ اذوهم ، كما قال الله جل وعلا :

 { علي الذين كفروا } : اي مشركي العرب يقولون اللهم انصرنا بالنبي المبعوث اخر الزمان الذي نجد صفته في التوراة ، ويقولون في ظل بعث نبي نقتلكم معه ، قتل عاد وارم ، وقيل : كانوا يقولون اللهم اءت بهذا النبي يقتل العرب ويذلهم ، فلما راوه من غيرهم كفروا به كما ذكره الله ، وقيل اذا غلبتهم الاوس او الخزرج قالوا لهم لو خرج النبي الذي اظل وقته لقاتلناكم معه واستنصرنا عليكم به . وذكر ابن القطان وهو حسن بن علي ابن عبد الملك ، وليس عبدالملك الذي هو سلطان جاءر مستعملا للحجاج : ان يهود المدنية كانوا يقاتلون العرب ، فكلما التقوا غلبهم العرب فقالوا : الهلم انا نسالك بحق محمد A النبي الامي الذي وعدتنا ان تخرجه لنا في اخر الزمان الا نصرتنا عليهم ، فنصرهم ، فكانوا يقولون وينصرون ، ولما بعثه الله كفروا به . وذكر ابن بكر محمد بن حسين الاحري عن ابن عباس : ان يهود خيبر يقاتلون غطفان ، فكلما التقوا هزمت اليهود فدعوا بهذا الدعاء فنصروا فكانوا يدعون وينصرون ، فلما بعث كفروا به ، وروي ان قريظة والنضير وجميع يهود الحجاز في ذلك الوقت يستنصرون علي ساءر العرب بخروج النبي ، A وكان اليهود ينتقلون الي الحجاز ويهاجرون اليه لعلمهم بانه موضع بعثته A ويجوز ان يكون المراد يستفتحون بالنبي ، A ، لانه نزل عليه ويعمل هو بما فيه من جهاد الذين كفروا ، ويجوز ان يكون المعني الفتح علي الذين كفروا فيما اغلق عنهم ، اي تبيينهم للذين كفروا ما لم يعرفوا من كون نبي يبعث من العرب هو اخر الانبياء مهاجره يثرب ومولده مكة ، وقد قرب زمانه .



 وعلي هذا الوجه لا تكون السين والتاء في ذلك للطلب ، بل للتاكيد اي بالغون في تبين ذلك للعرب ، وفيهما تلويح بانهم يطلبون انفسهم ان يبينوا ذلك للعرب ، ومن حرص علي امر طلب والح فيه ، والشء بعد طلبه ابلغ منه بدون طلب واعز ، وفي هذا تجريد بديعي اذ جردوا من انفسهم اشخاصا يطلبونها او بان بعضا يطلب بعضا ان يبين لهم حرصا علي البيان .

 { فلما جاءهم ما عرفوا } : وهو محمد A او القران او الحق الذي عرفوه وهو صفاته وبعثته ، وانه من العرب وانما صدق واحد .

 { كفروا به } : حسدا وانفة ان تخرج النبوة عن بني اسراءيل ، وخوفا علي زوال جاههم ورءاستهم وما يعطي لهم .

 { فلعنة الله } : ابعاده عن الخير وجزيه .

 { علي الكافرين } : اي عليهم ، اعني علي هءلاء الذين جاءهم ما عرفوا فكفروا ، ووضع الظاهر موضع المضمر ليدل الظاهر وهو لفظ الكافرين علي انهم لعنوا لكفرهم ، لان تعليق الحكم بالمشتق يءدن بعليته ، ولو قال فلعنة الله عليهم لم يكن ذلك ، قال للعهد الذكري ، ويجوز ان يكون المراد كل كافر اياهم وغيرهم علي ال للجنس الاستغراقي فيفهمون منه فهما اوليا ، لان الكلام سيق فيهم وقصدوا به قصدا اوليا بالذات وغيرهم ثانيا ، وبالتبع يحتمل وجها اخر ادق وهو ان ال للحقيقة لا للافراد خصوصا ولا عموما ، ويكون الكلام حجة ببرهان كانه قيل من اتصف بكفر فعليه اللعنة .



  CHECK 

 { بءس ما اشتروا به انفسهم ان يكفروا } : المضارع للحال ، لان كفرهم واقع متصل .

 { بما انزل الله } : من القران ورسالة سيدنا محمد A او القران او التوراة ، او القران والتوراة والانجيل ، والكفر ببعض ذلك كفر بالكل ، اصل بيس بءس بفتح الباء وكسر الهمزة خفيف باسكان الهمزة ، ونقلت كسرتها الي الباء فقلب ورش الهمزة بعد ذلك ياء مثناة ، وما عند سيبويه فاعل بءس وهي نكرة موصوفة بجملة اشتروا به ، وان يكفروا في تاويل مصدر بدل او بيان من ما او خبر لمحذوف ، اي هو ان يكفروا وهو المخصوص بالذم ، او مفعلو بمحذوف اي اعني ان يكفروا ، ويجوز عند بعضهم ان تكون ما اسما موصولا فاعلا ، واعراب الباقي كما مر ، ويجوز ان تكون ما معرفة تامة فاعلا ، والجملة بعدها نعت لمخصوص محذوف ، اي بءس الشء شء اشتروا به انفسهم وشء منكر بدل او بيان او خبر لمحذوف ، وان يكفروا فيه الاعاريب المذكورة فيه سابقا ، وليس حينءذ مخصوصا ولكن اذا صير الي ابداله ابدل من ما ومن المخصوص المحذوف ، وقد اختل ففي الابدال من البدل وفي تعدد البدل الصحيح عندي الجواز ، وهذا الوجه ضعيف لان فيه تقدير المخصوص مع الاستغناء عنه بقوله : { ان يكفروا } او المشهور عن سيبويه وغيره انما تمييز مفسر لفاعل مستتر ، وجملة اشتروا به انفسهم صفة لما ، وفي ان يكفروا ما تقدم من الاعاريب ، وهذا مذهب الاخفش والزجاج ، واحد قولي الفارس والزمخشري وكثير من المتاخرين ، ويضعف ان تجعل تمييز نكرة غير موصوفة مفسرة لفاعل مستتر ، والجملة بعدها صفة لمخصوص محذوف لا غناء ان يكفروا عن تقدير مخصوص ، وكذا يضعف ان تجعل ما كذلك والجملة بعدها صلة ، لما اخري موصولة هي المخصوص . ويبحث علي الوجهين ايضا بان ما مساوية للمضمير المستتر في بءس في الابهام ، فكيف تكون تمييزا مفسرة له؟ ويجاب ان ما معناها شء حقير بعد بءس وشء عظيم بعد نعم ، وايضا قد اجاز بعض ان يكون التمييز موحدا ، ويجوز علي الجوابين عنده مجيز جمع التمييز والفاعل الظاهر في باب نعم وبءس ان تكون تمييزا ، وان يكفروا فاعلا قيل معني الاية بءس ما اشتروا به انفسهم من عذاب النار وسخط الله ، او باعوا به انفسهم لله D بالجنة وهو كفرهم بما انزل الله علي سيدنا محمد A اشتراء او بيعا بحسب ظنهم في ثبوتهما ، وليسا بشء ثابت بل شء وجوابه النار والسخط ، ورد بانهم لم يظنوا ذلك بل فعلوا لك حسدا وظلما كما قال الله جل وعلا :

 { بغيا ان ينزل الله من فضله علي من يشاء } : اي طغيانا ومجاوزة للحد لاجل ان ينزل الله او علي ان ينزل الله فحرف الجر مقدر قبل ان متعلق ببغيا ، والمضارع للحال لان تنزيل الفضل واقع متصل ، اي وقعوا في الطغيان لتنزيل الله من فضله ، لان الله ينزل من فضله فيكفرون بما نزل ، ويجوز جعل يكفروا وينزل بمعني الماضي ، ولا يجوز ان يكون ان ينزل مفعولا له لبغيا لاختلاف الفاعل ، لان فاعل البغي اليهود ، وفاعل التنزيل هو الله تبارك وتعالي بل هو علي تقدير لام التعليل او علي التعليلية او غيرهما من حروف التعليل ، والاصل اللام او علي تضمن بغيا معنا حسدا في كذا ، او علي كذا ، او استعمال بغيا بمعني حسدا ، اي حسدا علي انزال الله .



 وقرا ابن كثير وابو عمرو ويعقوب باسكان نون ينزل ، وتخفيف الزاي ، قال ابو عمرو الداني : قرا ابن كثير وابو عمرو ينزل وتنزل وننزل مضموم الاول مخففا حيث وقع ، واستنثي ابن كثير وما تنزله في الحجر وننزل من القران وحتي ينزل علينا في سبحان ، واستثني ابو عمرو علي ان ينزل في الانعام والذي في الحجر مجمع عليه بالتشديد والباقون بالتشديد ، واستثني حمزة والكساءي من ذلك حرفين : { وينزل الغيث } في لقمان ، و { الذي ينزل الغيث } في { حم عسق } فخففاهما . . انتهي . ونصب بغيا علي انه مفعول لاجله ليكفروا ، اي ان يكفروا لما فيهم من بغي ، وقال جار الله مفعول لاجله لاشتروا وعارضه القاضي بفصل المخصوص ، وهو ان يكفروا وهو اجنبي من تمييز الفاعل ، ولو كان غير اجنبي من الفعل والفاعل ومفعول ينزل محذوف ، اي ينزل الوحي من فضله ، ومن زعم ان من التبعيضية اسم مضاف جعلها مفعول ينزل والفضل علي هذا بمعني الوحي ، وعلي تقدير المفعول يكون الفضل العام او بمعني الوحي وعليه ، فمن للابتداء ومن اجاز زيادة من في الايجاب والتعريف جعل فصله مفعولا به وهو الوحي او عام ويجوز علي الاوجه المذكورة كون الفضل مرادا به الرسالة ومن يشاء من عباده هو من اختار الرسالة .

 { فباءوا بغضب علي غضب } : اي رجعوا والرجوع هنا بمعني المضي اي مضوا او الصيرورة والباء عليها باعتبار المعني الاصلي اي صاروا احقاء بغضب بعد اخر او الماضي بمعني المضارع ، اي ترجعون الي الله بالموت او بالبعث بغضب علي غضب ، وتنكير الغضب للتعظيم ، ومعني الغضب العقاب اي لهم عقاب متكرر بلا نهاية وهو العذاب لكفرهم بمحمد وحسدهم ، فذلك الغضب مرتين من الاستغناء لذكر الشء مرتين او بالتثنية عن الجمع كقولك : دخلوا رجلا رجلا ، وعلمتك الكتاب بابا بابا ، ولبيك اللهم ، وعلي بمعني مع ولك ان تجعل الكلام علي اسلافهم فيكون باءوا بمعني رجعوا الي الله بالموت ، او يرجعون اليه بالبعث وقد استحقوا عذابا مكررا . وقال ابن عباس : الغضب الاول بتضييعهم التوراة ، والثاني بكفرهم بمحمد ، A وقيل : الاول بكفرهم بعيسي والانجيل ، والثاني بمحمد A وقيل الاول بقولهم عزير ابن الله ، والثاني بمحمد A او الاول قولهم يد الله مغلولة والثاني كفرهم بمحمد A وقيل الاول عبادة العجل والثاني الكفر بمحمد A وقيل الاول بالانجيل والثاني بالقران ، وهو عين القول بانهما الكفر بعيسي ومحمد عليهما الصلاة والسلام ، وتفسيري هو الاول وهو ثبوت العذاب المكرر لهم لكفرهم بمحمد ، اما اذا صير الي تعديد مساوءهم فالواضح ان يفسر الغضبان بذلك كله ، فيكون من اغناء ذكر اثنين عن ذكر الجمع ، فكانه قيل غضب مترادف متكرر من عبادة العجل ، وطلب الرءية ، وقولهم  { يد الله مغلولة } والكفر بالانجيل وعيسي ، والكفر بمحمد والقران ، وقولهم { عزير ابن الله } وغير ذلكن وفعل اسلافهم فعل لهم ارضاهم به ولولا يتهم اياهم مع فعلهم ولتصويبهم .

 { وللكافرين } : كفر نفاق او كفر شرك ، وقيل المراد هنا الكفر بمحمد A والعموم اولي .

 { عذاب } : في الدنيا كالقتل والجزية والاخرة .

 { مهين } : مذل لهم اريد به اذلالهم اذ كعذاب المءمن في الدنيا بالحدود او بالمصاءب او في القبر او في المحشر ، فانه اريد به تطهيره من الذنوب .



  CHECK 

 { واذا قيل لهم } : لليهود .

 { امنوا بما انزل الله } : وهو القران لان ما تقدم مسوق لتكذيبهم بالنبي A والتكذيب به تكذيب بالقران ، وكذبوا بالقران خصوصا ايضا ، ويجوز ان يراد بما انزل الله القران والانجيل معا ، لانهم قبحهم الله كذبوا ايضا بعيسي والانجيل ، ويناسب هذا ايضا قوله : { باءوا بغضب علي غضب } ، اذا فسر بتعديد مساوءهم ، ويجوز ان يراد بذلك القران والانجيل ، وجميع ما انزل الله ويناسبه ايضا قوله : { باءوا بغضب علي غضب } اذا فسر بالتعديد المذكور ايضا ، وان قلت : ما وجه امرهم بما انزل الله علي العموم مع انهم لم يكفروا به عموما؟ قلت : وجهه الزام ان يءمنوا بما انزل الله كله كانه قيل امنوا بما انزل الله كله لا ببعضه وحده ، وفيه فاءدة اخري هي ان كفرهم بالانجيل والقران كفر بجميع ما انزل الله ، فكانه قيل : قد كفرتم بجميع ما انزل الله فامنوا بجميعه ، ثم رايت بعد ذلك ثلاثة اقوال مجردة عن التعليل في تفسير ما انزل الله ، فقيل القران ، وقيل الانجيل ، وقيل جميع ما انزل الله والحمد لله اذ وافقن الاحتمالات التي ذكرت .

 { قالوا نءمن بما انزل علينا } : وهو التوراة فيحتمل وجهين : احدهما تقدير المضاف اي بما انزل علي نبينا لا بما لم ينزل اصلا ، وهو القران في زعمهم اصلا فضلا عن ان يكون علي نبي ، والاخر ان يريدوا نءمن بما انزل في شاننا خطابا وتكليفا لنا ، واما القران فلم ينزل فضلا عن ان نكلف به هذا في زعمهم لعنهم الله ثم ظهر لي وجه اخر هو ان هذه مقالة من زعم منهم انه مرسل الي العرب خاصلة ، اي نءمن بما انزل علينا ، واما ما يقول محمد فعلي العرب .

 { ويكفرون بما وراءه } : هذا من كلام الله سبحانه وتعالي لا من كلامهم والجملة مستانفة او حال من واو قالوا علي تقدير قد التحقيقية ، اي وقد يكفرون او المبتدا اي وهم يكفرون ، وقيل بجواز وقوع الجملة المضارعية المثبتة المجردة من قد حالا . قال الفراء : بما وراءه بما سواه ، وقال قتادة : بما بعده وما واقعه علي ما من قوله امنوا بما انزل الله وهو القران ، او هو والانجيل ، والهاء عاءدة الي التوراة او جميع ما انزل ، ووراء في الاصل مصدر من وري بمعني الستر والخفاء ، وهو كالمواراة استعمل ظرف مكان ويضاف الي المفعول ، ويراد به ما يواري ذلك المفعول ، والمفعول قدامه كما هنا اذا جعلنا التوراة مفعولة للمواراة ، ومرجع الهاء وهو التوراة وهو الذي يقال فيه لانه بعد ، واعتبرنا ان ما قبل الشء المستقبل هو الذي يقال انه قدام ، ويضاف الي فاعل المواراة فيراد به ما يتواري به الفاعل والفاعل خلفه

 { وهو } : اي ما وراءه وهو القران او هو والانجيل او جميع ما انزل .



 { الحق } : الثابت من الله والجملة حال من ما في قوله { بما وراءه } .

 { مصدقا } : حال من الحق وغير مءكدة ، لانه لا يلزم من كون الشء حقا كونه مصدقا لغيره ، والقران مثلا ولو كان مصدقا لما قبله ، لكن لفظ الحق لا يفيد انه مصدقا ، لانه اذا نظرنا الي اللغة امكن ان يكون القران لم ينزل فيه شء مما نزل قبله اصلا ، وانما نعرف الاتفاق بين القران وغيره في اشياء من خارج ، وكذا اذا جعلنا مصدقا حالا مما فليس كما قيل انه حال مءكدة للحق او لمانع هي مءكدة بالنظرة الي ما علمنا من الشرع ، ان كل ما انزل الله حق وانه يصدق بعضه بعضا ، وقد اطلق سيبويه وله اليد الطولي في الحديث والتفسير والنحو مشارك لغيره في ساءر العلوم الموجودة في زمانه ، كما اشار الي بعض ذلك الخضري في حاشية ابن عقيل ان { مصدقا } حال مءكدة .

 { لما معهم } : وهو التوراة والانجيل ، لانهم ولو كذبوا الانجيل لكنه موجود في زمانهم ، كلفوا به فجاز ان يقال معهم ، وفي قوله : { وهو الحق مصدق لما معهم } رد لقولهم : نءمن بما انزل علينا ، لانهم اذا كفروا بما يصدق التوراة من القران وغيره ، فقد كفروا ايضا بما انزل عليهم وهو التوراة ثم رد عليهم بقوله :

 { قل } : يا محمد لهم .

 { فلم تقتلون انبياء الله من قبل ان كنتم مءمنين } : اي لم قتلتم انبياء الله قبل هذا الزمان او قبل بعثة هذا النبي A ان كنتم مءمنين بالتوراة ، اذ هي محرمة لقتل الانبياء ناهية عنه فتقتلون بمعني الماضي ، ويناسبه قوله : { من قبل } ، ويجوز كونه للحال استحضارا للقتل وزمانه الماضي ، او تنزيلا لزمانهم منزلة زمانه ، لانهم او لما كانوا راضين بفعل اباءهم من القتل ، ومتولين لهم مع ذلك ومستمرين علي طريقتهم اذ ارادوا قتل رسول الله A صح ان يوصفوا بالملابسة في حالهم للقتل ، وقوله : { من قبل } دليل علي ان القتل الحقيق واقع في الزمان الماضي فهو كالتجريد في الاستعارة ، واسند القتل اليهم مع انه فعل اسلافهم لما ذكرت انفا من رضاهم بفعل اسلافهم وتوليهم اياهم ، واستمرارهم علي طريقتهم ، وفي الاثر اذا علمت المعصية في ارض فمن انكرها وكرهها فهو برء منها ، ومن رضيها كان من فعلها ، وكانوا لعنهم الله يقولون انك لم تاتنا بمثل الذي اتانا به نبينا ، ولم يكن لنا نبي الا ياتنا بقربان تاكله النار .



