 { واذ قتلتم نفسا } : رجلا يسمي عاميل ، اسند القتل اليهم لان القاتل منهم وفيهم ، وهذا نوع من انواع الحكم علي المجموع ، او يقدر مضاف اي واذا قتل بعضكم نفسا ، ومع ذلك فالخطاب لليهود الذين في زمان سيدنا محمد A بما فعل اسلافهم .

 { فاداراتم فيها } : تدافعتم في شانها بالخصام او بالتشاكك ، لان من شان المخاصمين ان يدفع بعضهم بعضا ، او يطرح بعضهم قتلها عن نفسه علي بعض وهو تفاعل من الدرء بمعني الدفع ، والاصل تداراتم ابدلت التاء دالا ، وادغمت الدال في الدال ، وزيدت همزة الوصل ليبتدا بها ، اذ لا يبدا بما هو ساكن ، وانما حذفت همزة الوصل نطقا للحرف قبلها وهو يقرا بهمزة ساكنة بعد الراء ، وكان ابو عمرو بن العلاء اذا قرا في الصلاة او ادرج قراءته او قرا بالادغام لم يهمز الهمزة الساكنة فاءا او عينا او لاما نحو : { يءمنون } ، و { يولون } ، و { المءتفكات } ، و { بءس } و { وبءسما } والذءب ، والبءر ، والرءيا ، ورءياك ، وكداب ، وجءت ، وجءتم ، وشءت ، وشءتم . فاداراتم واطماننتم الا ان يكون سكون الهمزة للجزم نحو : نشا ، وهي وجملته تسعة عشر موضعا او للبناء نحو : انبءهم . وقرا وهي لنا وجملته احد عشر موضعا او يكون ترك الهمزة فيه اثقل من الهمز وذلك في قوله : تءوي وتءويه ، او يوقع الالتباس بما لا يهمز ، وذلك في قوله : وريءا او يخرج من لغة الي لغة ، وذلك في قوله : موصدة ، فان ابن مجاهد كان يختار تحقيق الهمزة في ذلك كله من اجل تلك المعاني ، قال ابو عمرو الداني : وبذلك قرات فاذا تحركت الهمزة نحو قوله : يءلف ويءذن ويءخرهم فلا خلاف عنه في تحقيق الهمزة في ذلك كله . . انتهي . والذي اقرا به من رواية ورش ابدال الهمزة الساكنة التي هي فاء كما قال في الدرر اللوامع ، ابدل ورش كل فاء سكنت نحو يومن وان تحركت سهلها نحو : بواخذ ويولف ومود ، وقال ابو عمرو الداني : اعلم ان ورشا كان يسهل الهمزة سكنت او تحركت اذا كانت فاء نحو : ياخذ ، ولقاءنا ايت ، ويومن والمومنون ، والذي اوتمن والملك اتوني به ، وموجلا ولا تواخذنا الاتوي اليك والماوي وساءر مادة الايواء ، وفاووا الي الكهف ونحوه ولا يءده وتءزهم ومابا ومارب اخري وما تاخروا فاذا وشبهه اذا كانت صورتها الفا فهمز جميع ذلك والباقون يحققون الهمزة في ذلك كله ، وسهل ورش ايضا الهمزة من بيس وبيسما والبير والذيب ، ولءلا في جميع القران وتابعة الكساءي علي الذيب وحده فترك همزة والباقون يحققون الهمز في ذلك كله حيث وقع وبالله التوفيق .

 { والله مخرج ما كنتم تكتمون } : اي والله مظهر ما كنتم تكتمونه وهو القاءل ، او مخرج من حد الغيب الي حيز البيان ما كنتم تكتمون ، ويناسب الوجه الاول مقابلة الاخراج بالكتم والكاتم هو القاتل وحده ، كتم القاتل الصادر منه ولم يخبر الناس بانه هو القاتل ، واحتال في اخفاءه بان القاه بعد القتل حيث لا ينسب اليه ، فالكتم عدم اخباره عن نفسه انه القاتل او الاحتيال المذكور او كلاهما ، واسند الكتم اليهم لانه فيهم ومنهم ، او اسنده اليهم لانهم قد خافوا الفضيحة ، كما قيل ان سبب تباطءهم في الامتثال هو هذا الخوف كما مر ، وما مفعول لمخرج ، لان مخرجا للاستقبال المحكي ، وذلك ان الاخراج ماض بالنسبة الي نزول الاية ، لكنه فرض ان زمان تلك القصة حاضر ، وفرض ان الكتم واقع وان الاخراج سيقع ، ومذهب الكساءي جواز اعمال الوصف في المفعول ، ولو كان الماضي فيكون المعني والله اخرج ما كنتم ولا ينافي هذا الوجه قوله :



  CHECK 

 { فقلنا اضربوه ببعضها } : لانه معطوف علي اداراتم فيها ، وقوله : { والله مخرج ما كنتم تكتمون } معترض او حال مقدرة ، اي اداراتم فيها ، والله مقدر لاخراجها بعد ، ولا يتركها خفية القاتل ، والهاء في اضربوه عاءدة الي النفس في قوله : { واذ قتلتم نفسا } والنفس مءنث كما انث في قوله : وانما ذكر هنا للتاويل بالشخص او بالمقتول او الانسان او للنظر الي المعني ، لان المقتول رجل ، وقيل : النفس يذكر ويءنث ، والمراد بالبعض جزء غير معين ، فباي جزء ضربوه امتثلوا الامر واختلفوا في اي جزء ضربوه به ، وقيل : امروا بجزء معين ، وعلي هذا القول فلم يعين في الاية مثل ان يقال : فقلنا اضربوه بلسانها او بكذا ، لان الكلام ليس مسوقا في طريق بيانه ، بل في طريق تهوين الامر في قدرته ، بان قال ان ضربه بجزء من البقرة مذبوحة كاف ، وعدم التعيين لهم ادخل في الاعجاز والجزء الذي ضربوه به ، سواء عين لهم او لم يعين هو لسانها ، لانه الة الكلام والضرب ، انما ليتكلم الميت باسم قاتله وهو قول الضحاك ، قال الحسن بن الفضل : هذا اولي الاقوال ، لان المراد من احياء القتيل كلامه ، قلت بل كلما بعد الجزء عن مناسبة الحياة كان ادخل في الاعجاز ، لانه ولو كان المراد اظهار القاتل لكن قصد به الاعجاز ايضا ، ولا سيما قد استدل باحياءه علي البعث في الاية بعده ، وقيل بلسانها وقلبها ، لان الكلام يكون في القلب واللسان يعبر عنه ، وقال عطاء بن ابي رباح : هو العصعص ، قيل وهو اولي التاويلات بالصواب ، لان العصعص هو الاساس الذي ركب عليه الخلق ، وانه اول ما يخلق واخر ما يبلي ، وقال مجاهد : ذنبها . وقال عكرمة والكلبي : فخذها الايمن . وقال السدي : البضعة التي بين كتفيها ، وقيل : الاذن ، وقال ابن عباس : بالعظم الذي يلي الغضروف وهو اصل الاذن وهو مقتل . والصحيح انه غير معين اذ لا دليل علي تعينه في الاية والحديث ، وفي الكلام حذف ، والتقدير فقلنا اضربوه ببعضها ليحيا ويخبركم بقاتله فضربوه به فقام حيا باذن الله تعالي ، واوداجه تشخب دما ، وقال قتلني فلان ثم سقط ميتا ، فجرم الميراث وقتل به وقيل : قال قتلني فلان وفلان لابني عمه ، فسقط ميتا ثم قتلا وحرما الميراث كذا قيل ، ومقتضي شخب اوداجه دما انه قتل بالذبح والمتبادر من الاية انهم ضربوه في جسده ، وعن ابن عباس : ضربوه قبره وذكر عنه ان امر القتيل وقع قبل جواز البحر ، وانهم قاموا في طلب البقرة اربعين سنة ، روي انه كان في بني اسراءيل شيخ موسر فقتله بنو اخيه ليرثوه وطرحوه علي باب المدينة ، ثم جاءوا يطالبون بدمه ، فامرهم الله ان يذبحوا بقرة فيضربوه ببعضها فيحيا فيخبر بقاتله ، وكان الشيخ صالح منهم عجلة ، فاتي بها موضعا يجتمع فيه الماء وينبت فيه الشجر ، وقال : اللهم اني استودعتكها لابني حتي يكبر ، فشبت وكانت وحيدة بالصفات التي ذكر الله D فساوموها اليتيم وامه ، حتي اشتروها بملء جلدها ذهبا ، وكانت البقرة بثلاثة دنانير في ذلك الوقت ، ولما تبين قاتله حرم الميراث كما قال A :



 « ما ورث قاتل بعد صاحب البقرة » يعني ان حرمان القاتل من الميراث مستمر من زمان هذا القاتل الذي في قصة هذه البقرة . قيل كان في بني اسراءيل رجل غني له ابن عم فقير لا وارث له سواه ، فلما طالت عليه حياته قتله ليرثه وحمله الي قرية اخري ، والقاه علي بابها ، ثم اصبح يطلب ثاره وجاء بناس الي موسي يدعي عليهم القتل فجحدوا ، واشتبه امر القتل علي موسي عليه السلام : فسالوا موسي ان يدعوا الله ليبين لهم ما اشكل عليهم ، فسال موسي ربه في ذلك فامره بذبح بقرة ، وامره ان يضربه ببعضها ، قال عطاء والسدي : كان في بني اسراءيل رجل كثير المال اسمه عاميل ، وله ابن عم مسكين لا وارث له غيره ، فلما طالت عليه حياته قتله ليرثه ، وقال بعضهم : كانت تحت عاميل بنت عم له تضرب مثلا في بني اسراءيل بالحسن والجمال ، فقتله ابن عمها لينكحها ، فلما قتله حمله من قرية الي قرية اخري فالقاه هنالك .

 قال عكرمة : كان لبني اسراءيل مسجد له اثنا عشر بابا ، لكل سبط منهم باب ، فوجد قتيل علي باب سبط وجر الي باب سبط اخر ، فاختلف السبطان فيه ، وقال ابن سيرين : قتله القاتل ووضعه علي باب سبط منهم ، ثم اصبح يطلب ثاره ودمه ويدعيه عليهم ، وقيل القاه بين القريتين فاختم فيه اهلها فجاءوا اولياء المقتول الي موسي عليه السلام واتوا باناس وادعوا عليهم القتل وسالوه القصاص ، فسالهم موسي وجحدوا ، ولم تكن بينة ، واشتبه امر القتيل علي الناس ، فوقع بينهم خلاف يدعو الي القتال وذلك قبل نزول المقاسمة في التوراة ، فسالوا موسي عليه السلام ان يدعو الله تعالي ليبين لهم امر ذلكن فسال موسي ربه تبارك وتعالي ، فامرهم بذبح البقرة علي ما تقدم في تفسير الاية .

 قال السدي وغيره : كان رجل من بني اسراءيل بارا بابيه ، وبلغ من بر ابيه ان رجلا اتاه بلءلءة فابتاعها منه بخمسين الفا وكان فيها فضل وربح ، فقال الباءع اعطني ثمن اللءلءة ، فقال ان ابي ناءم ومفتاح الصندوق تحت راسه فامهلني حتي يستيقظ واعطيك الثمن ، فقال : ايقظ اباك واعطني الثمن ، فقال : ما كنت لافعل ولكن ازيدك علي الثمن عشرة الاف وامهلني حتي ينتبه فقال الرجلك انا اعطيتك عشرة الاف ان انت ايقظت اباك وعجلت النقد ، فقال : انا ازيدك عشرين الفا ان انت انتظرت انتباهه ، فقال : قبلت ، ففعل ولم يوقظ اباه ، ولما استيقظ ابوه اخبره ، فدعا له وجازاه خيرا ، وقال : احسنت يا بني ، وهذه البقرة لك بما صنعت لي ، وكانت بقري من بقية بقر ، وكانت له ، قال A في هذه القصة :



 « انظروا ما صنع البر » وقال ابن عباس ، ووهب بن منبه : كان في بني اسراءيل رجل صالح له ابن صغير ، وكانت له عجلة فاتي بها الي موضع الماء والشجر ، وقال : اللهم اني استودعتك هذه العجلة لابني حتي يكبر ، فمات الرجل فشبت العجلة حتي صارت عوانا ، وكانت تهرب ممن يرومها ، وكان الابن بارا بوالدته ، فلما كبر كان يقسم الليل ثلاثة : يصلي ثلثا ، ويجلس عند راس امه ثلثا ، وينام ثلثا ، فاذا اصبح انطلق يحتطب علي ظهره ، فيات السوق فيبيعه بما شاء الله فيتصدق بثلثه وياكل ثلثه ويعطي امه ثلثه ، فقالت له امه يوما : يا بني ان اباك ورثك عجلة وذهب بها الي موضع كذا ، واستودعها الله فانطلق اليها ، وادع الله ان يردها اليك وان علامتها اذا نظرت اليها ان يتخيل اليك ان بها شعاع الشمس يخرج من جلدها ، وكانت تسمي المذهبة لحسن لونها وصفاءها وصفرة لونها ، فاتي الموضع فراها ترعي فصاح عليها فقال : اعزم عليك بالله ، وروي باله ابراهيم واسماعيل واسحق ويعقوب ، فاقبلت تمشي حتي وقعت بين يديه فقبض علي عنقها وقادها ، فتكلمت البقرة باذن الله تعالي ، وقالت : ايها البار بوالدته اركبني فان ذلك اهون عليك ، قال الفتي : ان امي لم تامرني بذلك ، ولكن قالت لي خذ بعنقها ، فقالت البقرة : واله موسي واله بني اسراءيل لو ركبتني ما كنت تقدر علي ابدا ، فانطلق فانك لو اشرت الي الجبل ان ينقلع من اصله فينطلق معك لفعل ببرك بوالدتك . فانطلق الفتي بها فاستقبله عدو الله ابليس في صورة راع ، فقال : ايها الفتي اني راع من رعاة البقر اشتقت الي اهلي فاخذت ثورا من ثيراني وحملت عليه زادي حتي اذا بلغت شطر الطريق ذهبت لاقضي حاجتي ، فتعدي وصعد الي الجبل وما قدرت عليه ، واني لاخشي علي نفسي الهلكة فان رايت ان تحملني علي بقرتك وتنجيني من الموت ، واعطيك اجرتها بقرتين مثل بقرتك ، فلم يفعل الفتي وقال : اذهب وتوكل ، فلو علم منك الصدق لبلغتك بلا زاد ولا راحلة ، فقال ابليس لعنة الله ، ان شءت بعينها وان شءت فاحملني واعطيك عشرة مثلها ، فقال الفتي : ان امي لم تامرني بهذا . فبينما الفتي كذلك اذ طار طاءر من بين يديه ، ونفرت البقرة هاربة من الفتي ، وغاب الراعي فدعاها الفتي باسم اله ابراهيم فرجعت البقرة اليه ، وقالت : ايها الفتي البار بوالدته الم تر الي الطاءر الذي طار؟ قال : نعم . قالت : انه ابليس لعنه الله اختلسني ، فلما دعوت باله ابراهم جاء ملك فانتزعني منه وردني اليك لبرك بامك وطاعتك لها ، فجاء بها الفتي الي امه ، فقالت له امه : انك فقير لا مال لك ويشق عليك الاحتطاب بالنهار والقيام بالليل ، فانطلق وبع هذه البقرة وخذ ثمنها ، فقال : بكم ابيعها؟ فقلت : ثلاثة دنانير ، فانطلق بها الفتي الي السوق ، فبعث الله تعالي ملكا ليري خلقه قدرته وليختبر الفتي كيف بره بامه ، فقال له : بع هذه البقرة لي فباعها بثلاثة دنانير علي رضا امه .



 فقال له الملك : اعطيك ستة ولا تشاور امك . فقال الفتي : لو اعطيتني وزنها ذهبا لم ابع الا برضي امي ، فردها الي امه واخبرها ، فقالت له امه : ارجع وبعها بستة دنانير علي رضاءي ، فانطلق الفتي بالبقرة الي السوق فاتي الملك اليه ، فقال : اشاورت والدتك؟ فقال الفتي : نعم امرتني الا انقصها من ستة الدنانير ، وعلي ان استاذنها ، فقال الملك : اني اعطيك اثني عشر دينارا علي الا تستاذنها ، فابي الفتي ورجع الي امه فاخبرها بذلك . فقالت : ان ذلك الرجل الذي ياتيك هو ملك من الملاءكة ياتيك في صورة ادمي ليختبرك فاذا اتاك فقل اتامرني ان ابيع هذه البقرة ام لا؟ ففعل الفتي فقاله له الملك : اذهب الي امك وقل لها امسكي هذه البقرة فان موسي بن عمران يشتريها لقتيل بني اسراءيل ، فلا تبيعوها الا علي ملء جلدها دنانير ، فامسكوا البقرة وقدر الله سبحانه علي بني اسراءيل دبح تلك البقرة بعينها مكافاة له علي بره بوالدته فضلا منه ورحمة ، وذلك قوله تعالي : { قالوا ادع لنا ربك . . الايات } فاشتروها بملء جلدها ذهبا . وقال السدي : اشتروها بوزنها عشر مرات فذبحوها وضربوه ببعضها ، وحيي باذن الله تعالي ، فاوحي الله تعالي الي الارض المقدسة فينظر كل قتيل بجدوته بين قريتين او محلتين فياخذ اقرب قريتين اليه وليلزمهم الدية ، وان علموا قاتله سلموه ، وان لم يعلموه يحضروا الخمسين رجلا من شيوخهم وصلحاءهم ، ثم ياخذوا بقرة حولية فيذبحوها ويضعوا ايديهم عليها ، ويحلفوا بالله العظيم رب السموات اله بني اسراءيل ويعقوب انا ما قتلناه ولا علمنا له قاتلا ، واذا حلفوا برءوا من ديته ، وان لم يحلفوا ادوا ديته الي اولياءه ، فلم يزل موسي يقضي بالقسامة الي ان مات عليه اللام ، وكذلك بنو اسراءيل حتي جاء الله بالاسلام ، فقضي رسول الله A بالقسامة ، وياتي بيانه ان شاء الله ، وقيل : قتله ابن اخيه ، وقيل : ورثه غير معينين وتنازعوا في امر قاتله حتي حملوا السلاح كل يقول لاخرين انتم القاتلون اهل القريتين والسبطان ، فقال اهل النهي منهم انقتتل ورسول الله معنا ، فذهبوا الي موسي فقصوا له القصة وسالوه البيان ، فاوحي الله تعالي اليه ان يذبحوا بقرة فيضرب القتيل ببعضها فيحيا فيخبر بقاتله . وروي انه لما ذهب الفتي الي البقرة بامر امه فراته فجاءت اليه حتي اخذ بقرنها ، وكانت مستوحشة ، فلقيه بنو اسراءيل ووجدوا بقرته علي الصفة التي امروا بها فساوموه فاشتط عليهم ، فاتوا به موسي عليه السلام وقالوا له : ان هذا اشتط علينا ، فقال لهم : ارضوه في ملكه فاشتروها منه بوزنها مرة ، قاله عبيدة السلماني ، وقيل بوزنها مرتين ، وتقدم قول بعشر مرات ، واما حكم المقاسمة في هذه الشريعة فمذكور في الديوان ، والنيل واللفظ له هكذا باب شرط القسامة ان توجد في قتيل حر علامة قتل ، ولا يعلم قاتله ولا يدعي علي معين ، ولا يوجد بمسجد تصلي فيه جماعة ، ولا قتل من زحام ، ولا يكون في البلد قوم بينه وبينهم عداوة .



 ومن غيره فاذا كملت الشروط لزم تلك البلد او المحلة او قريبا منها ان يحلفوا خمسين يمينا ما قتلناه ولا علمنا قاتله ، وليس علي اعمي وصبي ومجنون وامراة ان لم تكن بالمحل وحدها قسامة ، وان وجد به احد ولو امراة تكررت عليها الايمان حتي تتم خمسين ثم يدفع الدية ، وتءدي علي امراة عاقلتها ان كانت لها ، والا فمن مالها وكذا ان لم يكن الا مشرك تكررت عليه وتديها عاقلته ، وعلي مولي العبد ان انفرد كذلك ومن لا عشيرة له لزمته في ماله والحي كالدار والبيت فان وجد في كدار ربها خصت القسامة به ، وكذا اهل الخطة لا تجاوزهم لغيرهم من ساكن او مسافر او مشرك ما دام احد من اهلها ، فان لم يكن لزمت هءلاء الاصناف ممن كان منهم بها وعلي عواقلهم الدية ،

 وان وجد بمحل تجب فيه ، ولو اب وابنه وزوج وزوجته لزمتهم ، وعلي عواقلهم الدية ، فمن ابي ان يحلف حبس حتي يحلف او يقر ، وتحب في الظهور لا في جارحة غير راس دون بدو ، وان وجد الراس وحده او القتيل مقسوما انصافا علي الطول فهل تجب فيه او لا؟ قولان . وان قسم بعرض لزمت فيما يلي الراس ، وان وجد بين قريتين او سكتين قيس ما بينهما ولزمت اهل القريبة اليه ، وان استوتا فالكل ، ويقاس من موضع رجليه ان وجدتا والا فمن بينهما ، وقيل من موضع كل لناحية اخري ، وقيل لنا حيتها وان وجد بوسط منزل او طرفه لزمت اهله ، وكذا شارعهم واهل الزنقة خاصة .

 وان وجد فيها وان بمسجد رجل او واديه خص بها ، وهل لزمت بوادي عامة اهلها اولا؟ قولان . وكذا بالسوق ولزمت بوجوده في الاميال او داخلها لا خارجها واقرب الحيين اليه ، وان وجد بينهما وهما معا ان استويا اليه ، وان برحلة مسافرين او حي فعليهم ، ولزمت ساءق دابة وجد عليها او قاءدها او راكبها ، وكلهم ان اجتمعوا وكانوا من اهلها وتدعيه عواقلهم ، وان لم يستووا اليه فعلي من كانت بيده يصرفها حيث شاء ، وان لم يوجد معها احد فعلي اهل موضع وجدت فيه لا علي صاحبها ، وان علي شجرة او حاءط او جبل او سارية فسواء .



 والخيار فيها للولي ، فمن اختاره للحلف حلف ، ومن يراه يري وان استمسك بواحد فهو ابراء لغيره ، وصح ابراء القتيل ، وان ادعي مستمسك به انه جرحه فابراء لغيره . ولا يقتل مدعي عليه الا باقراره او بيان عليه ، وهل يقبل من اهل خطة وجد فيها علي غيرهم اولا؟ قولان . ولا يقبل من وراثه وهو ابراء للغير ، ولزمت حاملا له علي ظهره وتتكرر عليه الايمان ، وتديه عاقتله كعواقل اهل الخطة ان كانوا من قباءل شتي ولزمت في سقط به اثر جرح ان كملت خلقته ، وان وجد قتيل بين قوم ولم يعرف له وارث اخذ منهم ديته الامام ، وتصح في مشرك لا في عبد لانه مال ، وان وجد بقرية اصلها لذوي الشرك ، والاسلام ، وهل لزمت الكل او تختص بذوي الاسلام خلاف .

 فصل

 يءدي علي مكاتب وساع ببعض قيمته ما بقي من ديتهما ، ولزمت من كان بسفينة وجد بها ، وان وجد جريح في قبيلة ولم يدر ما به ولم يزل ملازم فراش حتي مات لزمتهم قسامته وديته وفي اثنين وجد بينهما قتيل لابعد لقاء عسكر عدوه ، وان مات اهل قرية وجد بها وبقي فيها نساء واطفال ومجانين وغياب ، فهم لزمتهم قسامته اولا فيه دون تردد ، وان اعطي اهل خطة دية قتيل فاتي مقر بقتله او مبين عليه لزمه القود او الدية واخذها ردها لمعطيها فالقسامة علي اهل الديوان والقتال والفءتان ان وجد فيهم يده علي رءوسهم من اموالهم ، وقيل لا يحكم علي واحد منهم بشء حتي يتبين قاتله فيقتل به او يديه ان كان لا يقتل به ، وقيل انما يديه منهم الذين لم تقبل منهم ، وقيل : عكسه والحر والعبد والذكر والانثي ، والموحد وغيره والطفل والبالغ ، سواء كان كالليل والنهار في مقاتلتهما ، وقيل ان كانت ليلا ولو تعدد القتيل او قتل من كل والفيءة من ثلاثة فاكثر وجوز ان من ناحية اثنان ، وحكم بذلك ان ابطلتا او جهل حالهما فيدوه معا ، وان كانت احداهما محقة لزمت المبطلة ، وان كان القتيل من محقة لزم المبطلة ديته ، وقيل : يوقف حتي يتبين قاتله باقرار او بيان كانتا مشتركتين او بعضهما ، ويوقف امرهم ان كانتا اطفالا او مجانين حتي يتبين وترد الدية ان بان قاتله بعد اخذها واما القتل واتمام العدة بالاطفال والمجانين ففيه تردد . انتهي كلام الديوان بلفظ النيل .

 قالت الشافعية : اذ وجد قتيل في موضع لا يعرف قاتله فان كان ثم لوث علي انسان ادعي به ، واللون علي الظن صدق المدعي بان اجتمع جماعة في بيت او صحراء ، ثم تفرقوا علي قتيل فيغلب علي الظن ان القاتل فيهم ان وجد قتيل في محلة او ترية ، وكلهم اعداء القتيل لا يخالطهم غيرهم فيغلب علي الظن انهم قتلوه ، فان ادعي الولي علي بعضهم حلف خمسين يمينا علي من يدعي عليه ، وان كان الاولياء جماعة توزع الايمان عليهم ، فاذا حلفوا اخذوا الديه من عاقله المدعي عليه ولا قود عليه في قول الاكثرين ، وذهب عمر بن عبدالعزيز الي وجود القود به .



 قال مالك واحمد : فان لم يكن ثم لوث فالقول قول لما هي عليه ، لان الاصل براءة ذمته من القتل ، وهل يحلف يمينا واحدة كما في ساءر الدعاوي ، والثاني يحلف خمسين يمينا تغليظا لامر القتل ، وعند ابي حنيفة الا حكم للوث ولا يبدا بيمين المدعي ، بل اذا وجد قتيل في محلة يختار الامام خمسين رجلا من صلحاء اهلها فيحلفهم انهم ما قتلوه ولا يعرفون له قاتلا ، فان حلفوا والا اخذوا الدية من سكانها ، والدليل علي ان البداءة بيمين المدعي عند وجود اللوث ، ما روي عن سهل بن ابي حثمة قال : انطلق عبدالله بن سهل ومحيصة بن مسعود الي خبير وهي يومءذ صلح فتفرقا ، فاتي محيصة الي عبد الله بن سهل وهو يتشحط في دمه قتيلا ، فدفته ثم قدم المدينة فانطلق عبدالرحمن بن سهل وحويصة ابن مسعود الي رسول الله A فذهب عبدالرحمن يتكلم ، فقال رسول الله A : « كبر كبر » وهو احدث القوم سنا ، فسكت فتكلما ، فقال : اتحلفون وتستحقون قاتلكم ، او قال صاحبكم؟ قالوا : كيف نحلف ولم نشهد ولم نر . قال : فيحلف خمسون من اليهود . قال : كيف ناخذ بايمان قوم كفار . فعلقه النبي A من عنده ، وفي رواية يقسم خمسون منكم عفي رجل منهم فيدفع برمته ، وذكر نحوه ، وزاد في رواية : فكره رسول الله A ان يبطل دمه ففداه بماءة من ابل الصدقة . اخرجاه في الصحيحين ، وجه الدليل من هذا الحديث . ان رسول الله A بدا بايمان المدعين ليقوي جانبهم باللوث ، لان اليمين ابدا تكون لمن يقوي جانبه ، وعند عدم اللوث يكون من جانب المدعي عليه من حيث ان الاصل براءة ذمته ، فكان القول قول مع يمينه . والله اعلم . ذكره صاحب لباب التاويل والدميري من الشافعية .

 وقالت المالكية : يقسم الولاة خمسين يمينا اذا وجبت القسامة ، ويستحقون الدم ولا يحلف في العمل اقل من رجلين بشرط ان يكون من العصبة سواء ، ورثوا ام لا ، فان لم تكن عصبة من النسبة فالمولي الاعلون لقوله A لاخي المقتول بخير وبني عمه : « اتحلفون وتستحقون دم صاحبكم؟ » فجمعهم في الايمان فلم يفرد الاخ بها دون بني عمه ، ولما كان لا يقتل باقل من شهادة رجلين لم يستحق دمه باقل من قسامة رجلين؟ قال اشهب : وقد جعل الله لكل شهادة رجل من الزني يمينا من الزوج في لعانه ، قال ابن الماجشون : الا تري ان النساء لا يقسمن لما كان لا يشهدن فيه ، ولا يقتل بالقسامة اكثر من رجل واحد ، لانه لا يعلم اقتله الكل او البعض ، والمتحقق منهم واحد والمزيد عليه مشكوك فيه ، وتحت القسامة بقول الميت عند دمي فلان بشرط ان يكون بالغا حرا مسلما فلا يقبل قول الصبي ، ولو كان مراهقا علي المشهور ، ولا فرق في المدعي عليه بين ان يكون حرا او عبدا صغيرا او كبيرا ذكرا او انثي ، عدلا او مسخوطا ، مسلما او ذميا .



 قال في المدونة : ولو كان المدعي عليه القتل اروع اهل زمانه ، وقال ابن عبد الحكم : لا يقبل قول . المسخوط علي العدل لبعد دعواه ، والاول هو المشهور ، وظاهر صاحب الرسالة في قوله : دمي عند فلان انه يقبل ، ولو لم يكن فيه جرح وهو ظاهر المدونة ، ورواه ابن وهب عن مالك ، وبه قال اصبغ ، وعن ابن القاسم انه لا يقبل قوله الا مع الجرح المتبطن ، ويقول بن القاسم : العمل عند المالكية ، قال في المقتصر وهو المشهور ، وتجب القسامة ايضا بشهادة العدل بمعاينة القتل ، فيقسم الولاة مع شهادته ، ويستحقون الدم ولا يقسمون مع شهادة غير العدل علي المشهور ، لان شهادة غير العدل ساقطة شرعا ، وعن مالك ان شهادته لوث وبان يري العدل القتيل يتشحط في دمه والمتهم بالقتل بالقرب منه وعليه اثار القتل من التلطخ والمدية بيده ، هذا هو المشهور ، وحكي ابن سهل : ان العمل عندهم جار علي ان هذا ليس لوثا ، وبان يشهد المجروح ان فلانا جرحه او ضربه وشبه ذلك الجرح او الضرب او بان يشهد اثنان ان فلانا جرح فلانا او ضربه عمدا او خطا ، ولو لم يعاين الجرح او الضرب او اقراره بذلك يوما فاكير ، ولو اكل او شرب فيقسم الولاة انه من ذلك الجرح او الضرب مات ، وبان يشهد واحد بالجرح او الضرب ، سواء قال عمدا او خطا ، قال في المدونة : وان شهد شاهد ان ضربه وعاش الرجل وتكلم ، واكل وشرب ولم يسالوه اين دمك حتي مات ففيه القسامة ، ولذلك تثبت القسامة اذا شهد شاهد باقرار المقتول ان فلانا قتله عمدا ، فلو قال خطا لم تثبت ، لان قول المقتول في الخطا جار مجري الشهادة علي العاقلة بمال الشاهد ، لا ينقل عنه الا اثنان ، والفرق بين العمد والخطا لان العمد لرث محض ، والدماء يعمل فيها باللوث ، بخلاف الخطا فانه مال ، والاموال لا يعمل فيها باللوث ، ولا بد من ثبوت الموت في جميع امثلة اللوث لاحتمال ان يكون حيا ولا قسامة في حي ، واذا اختلف شاهدا القتل بان قال احدهما : قتل بخنجر : وقال الاخر : بل بسيف .



 بطل الحق لتعارضهما ، ولا يبقي الا مجرد الدعوي ، فليس للاولياء ان يقسموا مع شهادة احدهما نص عليه في المسونة ، واذ نكل مدعي القتل علي احد عمدا او بعضهم سقط الدم وردت الايمان علي المدعي ، فيحلف خمسين يمينا وحده وليس له الاستعانة فيها بحد من ولاته ، هذا هو المشهور ، ومذهب المدونة ، وقول مطرف ، وقال ، ابن القاسم : له ذلك ، وفي مقتضي الكلام ، وان ادعي القتل علي جماعة فكل مدعو او بعضهم سقط الدم ايضا فترد الايمان علي المدعي عليه ، فيحلف كل واحد منهم خمسين يمينا لانه يدفع عن نفسه القتل ، فكل واحد غريم ولا يضرنا انه لا يقتل بالقسامة الا واحد ، فان نكل احد ممن توجه عليه اليمين حبس ابدا حتي يحلف او يموت ، فان نكل مدعوا الحطا ردت الايمان علي عدة العاقلة ، فان حلفوا برءوا وان نكلوا غرموا ، وان نكل البعض وحلف البعض ، فمن حلف لم يلزمه غرم ، ومن نكل غرم حصته فقط ، والقاتل كرجل من العاقلة ، هذا قول ابن القاسم . قال ابن رشد : وهو ابين الاقوال ، ولابن القاسم ايضا ان الناكل يلزمه الجمع ، واذا وجد من عصبة المقتول خمسون رجلا فان الايمان توزع عليهم ، فيحلف كل واحد منهم واحدة فذلك خمسون يمينا وهو اوضح ، وان كانوا اقل قسمت عليهم الايمان الي اثنتين كما مر انه لا يحلف في العمد اقل من رجلين ، فيحلف كل واحد منهما خمسا وعشرين يمينا ، وان طلب ا حدهما ان يحلف اكثر من نصيبه لم يجز ، وان كانوا اكثر من اثنين قطاع منهم اثنان ان يحلفا جميع الايمان اكتفي بهما بشرط الا يكون ذلك نكولا ممن لم يحلف ، ويستحق البقية حينءذ ما وجب بالقسامة علي المشهور ، ولا تحلف المراة علي العمد ، وذكر ابن الحاجب ان القسامة ان يحلف الوارثون المكلفون في الخطا وكذا ان لم يكن الا واحد ، وسواء الذكر او الانثي خمسين يمينا متوالية علي البت ولو كان اعمي او غءبا ، وتوزع الايمان علي الميراث وجبر فسر اليمين علي ذي الاكثر من الكسر ، وقيل علي الجمع كما لو تساوي الكسر عليهم ، قال بعض الشيوخ : انما اشترط في الايمان توالي لانه ارهب واوقع في النفس ، واما اشتراط كونه بتا فلانه الذي ورد به النص في قصة حويصة ومحيصة ، وقول الاولياء كيف نحلف ولم نحضر ، واما العمي والغيبة فلا يمنعان من تحصيل اسباب العلم ، واما توزيع الايمان علي الميراث فظاهر لانها سبب لحصوله ، فان انكسرت يمين فاما ان يساوي الكسر او يختلف ، فان تساوي حلف كل واحد يمينا كاربع بنين فيحلف كل واحد ثلاث عشرة يمينا ، وان اختلف حلفها اكثرهم نصيبا من اليمين المنكسرة علي المشهور ، فان كان ابن وبنت حلف الابن ثلاثا وثلاثين ، وحلفت البنت سبع عشرة لانها قد خصها من اليمين المنكسرة ثلثها ، وقيل يحلف كل واحد يمينا كما اذا تساوي الكسر عليهم ، وقيل يحلفها صاحب الاكثر من الايمان ، لا من الكسر فيحلفها الابن في المثال ، فاذا حضر بعض ورثة دية الخطا واراد ان يحلف نصيبه من الايمان وياخذ نصيبه من الدية لم يكن له ، ولكن حتي يحلف جميع ايمان القسامة اذ لا يلزم العقيلة شء من الدية الا بعد ثبوت الدم ، وهو لا يثبت الا بعد حلف جميع ايمان القسامة ، فاذا وجبت الدية بايمان من حضر اولا فكل من حضر بعد ذلك حلف نصيبه من الايمان ، فيحلفون كلهم ولو كانوا عشرة الاف رجل ، والقاتل كرجل منهم ، فمن حلف لم يلزمه شء ون نكل لزمه ما يجب عليه خاصة ، وهو احد قولي ابي القاسم وابن رشد ، وهو ابين الاقاويل واصحها في النظر ، ويحلفون في القسامة قياما لانه اردع للحالف واهول في حقه ، لعله يرجع للحق ان كان مبطلا ، وان لم يحلف قياما كان ذلك نكولا منهم ، ويجلب الي مكة والمدينة وبيت المقدس من اهل اعمالها للقسامة ولا يجلب الي غير في غيره الا من الاميال اليسيرة ، لان ذلك ايضا اهول للحالف واردع للكاذب ، ولا قسامة في جرح ، لانه A حكم بالقسامة في نفس ، ولان حرمة الجرح اخفض من حرمة النفس ، الا تري ان لا كفارة فيه كما في النفس ، وكذلك لا قسامة في عبد لانه اخفض رتبة من الحر ، وكذلك لا قسامة في اهل الكتاب لنقصان حرمتهم بالكفر ، وان اقتتلت طاءفتان من المسلمين ، ثم انفصلوا عن قتلي ولم يعلم من قتلها من الطاءفتين ، فقيل لا قسامة ولا قود ، سواء ادعي المقتلو ان دمه عند احد ام لا .



 هكذا قال مالك في المدونة ، فابقاه بعض شيوخنا علي ظاهره ، وقيده اخرون بما اذا لم يكن لوث ، واذا كان في القسامة وهو تاويل ابن القاسم ، وبه قال اصبع ومطرف وابن الماجشون واشهب ، قال بعض المتاخرين : ينبغي الا يعدل عن هذا ، وقال بعض معني قوله فيها لا قسامة انه لو قال : دمي عند فلان لم تكن قسامة ، لانه اذا قدم علي قتله لا يستكثر عليه الكذب ، واما اذا قام له شاهد بمعاينة القتل فالقسامة ، وقيد ابن رشد القاتل بان يكون من غير الطاءفتين ، قال بعض : وهو تقييد لا بد منه ، وهذا اذا كانتا باغيتين وان تاولنا هدر دم المقتول ، وان تاولت واحدة هدر ما قتل من الباغية قاله ابن القاسم ، ووجود القتيل بقرية قوم او جدارهم ليست بلوث ، وعلله مالك في المجموعة بانه لو اخذ بذلك لم يشا رجل ان يلطخ قوما بذلك الا فعل ، لان الغالب ان من قتله لا يترك بموضع يتهم به .



 انتهي كلام المالكية .

 ومن قرا قوله تعالي : { فقلنا اضربوه ببعضها } علي قضيب برقوق يوم الجمعة عند طلوع الشمس اربعين مرة ، ثم ضرب به وجع كان من ساءر الحيوان او ورم سبع مرات ، ويتفل علي موضع الوجع او الورم في كل مرة ، فانه يبرا باذن الله تعالي .

 { كذلك يحيي الله الموتي } : اي يحيي الله الموتي يوم القيامة كما احيا هذا القتيل ، فهذا دليل علي انهم لما ضربوه حيي باذن الله تعالي ، فدل علي اي فقلنا اضربوه ببعضها فضربوه ، فحيي باذن الله او فقام حيا كما مر ، وهذا الخطاب لمن انكر البعث في زمان سيدنا محمد A ، من العرب وغيرهم ، ويجوز ان يكون خطابا للذين حضروا حياة القتيل ، علي تقدير : وقلنا لهم كذلك يحيي الله الموتي . واقتصر الطبري علي الوجه الاول .

 { ويريكم اياته } : دلاءله علي كمال قدرته كما قال : { وهو علي كل شء قدير } . والجملة مستانفة او معطوفة علي { يحيي الله الموتي } .

 { لعلكم تعقلون } : تتفكرون فتعلمون ان القادر علي احياء نفس قادر علي احياء النفوس كلها ، او لعلكم تدركون بعقولكم تلك ، او تعلمون علي مقتضي العقل ، او تكمل عقولكم ولعل كما مر للتعليل او للترجي في جانب المخلوق ، فان قلت لو امرهم الله بذبح البقرة ، ولم يامرهم بقتلها مطلقا او بالقطع منها ، قلت : لان ضرب القتيل ببعضها انتفاع به ، والانتفاع بالميتة لا يجوز لما روي عنه A : « لا تستنفعوا من الميتة بشء الا باهابها بعد الدبغ » وفيه روايات مختلفة بعضها عن الربيع بن حبيب ، والمعني واحد ولتءكل بعد الذبح ، ولو قتلت لحرمت ، ولان في القطع منها حية تعذيبا لها وتحريما للمقطوع وتصييرا له ميتة ، لان ما قطع من حي وهو حي فهو ميتة . وان قلت : فهلا احياه الله بلا ضرب ببعض البقرة؟ قلت : قضي احياءه بضربه بها لءلا يتوهم احد ان موسي احياه بضرب من السحر او الحيلة فتقوي الحجة ، ويعلموا ان ذلك من الله ، وخص ذلك بالبقرة الموصوفة لتوجد عند اليتيم المذكور وحده فيربح فيها ذلك الربح العظيم ، فلذلك لم يكن ببقرة مطلقا ولا بجمل ونحوه من الحيوان ، والتنبيه علي بركة التوكل فان ابا ذلك اليتيم استودع تلك البقرة في الصحراء ، وقال استودعتكها الله ، وللتنبيه علي الشفقة علي الاولاد ، والتنبيه علي ما يحصل من الخير لمن بر ابويه ، فانها ليتيم بر امه كما علمت ، ولم يعق اباه ، او لرجل بر اباه وامه كما علمت ، ولتحمل المشقة في تحصيل البقرة بصفاتها ، ولتقرب بقربان من اعظم القرابين ، وليتقربوا بقربان كما جرت العادة عندهم ، وليكونوا قد ادوا واجبا عظيما ، وللتنبيه علي ان من حق الطالب ان يقدم قربة ، وان من حق المتقرب ان يتحري الاحسن ، ويغالي بثمنه كما روي ابو داود وغيره ان عمر رضي الله عنه ضحي بنجيته اشتراها بثلاثماءة دينار ، وهي الناقة الكريمة العظيمة ، وللتنبيه علي ان المءثر في الحقيقة هو الله تعالي ، اذ لا تتصور حياة بين ميتين من غيره ، قاله القاضي وزكريا .



 وانا انزه فصاحة القران وبلاغته وجرياته علي اسلوب كلام العرب علي كلام صوفي اثبته القاضي هنا ، وهو ان في ذلك تنبيها ، علي ان من اراد ان يعرف اعدا عدوه الساعي في اماتته الموتي الحقيقي ، فطريقه ان يذبح بقرة نفسه التي هي القوة الشهوية حين زال عنها شره الصبي ، ولم يلحقها ضعف الكبر ، وكانت معجبة راءقة المنظر غير مذللة في طلب الدنيا ، ولم يلحقها ضعف الكبر ، وكانت معجبة راءقة المنظر غير مذللة في طلب الدنيا ، مسلمة عن دنسها لا سمة بها من مقابحها ، بحيث يصل اثره اي اثر الذبح الي نفسه فيحيا بها حياة طيبة ، ويعرب عما به ينكشف الحال ويرتفع ما بين العقل والوهم من التداوي والنزاع ، فان هذا كله حق لكن لا تعرفه العرب من الكلام ، فان كلامهم لا يفيده فلم يرد القاضي ان العبارة تفيد ذلك ، بل اشار الي ان ذلك تلويح من الله تعالي الي بني اسراءيل في زمان ذلك القتيل وينتبه له كل من اراد الله ، وليس ذلك في شء من معاني الكلام .



  CHECK 

 { ثم قست قلوبكم } : عطف علي محذوف ، اي فعقلتم ثم قست قلوبكم ، او فتذكرتم ثم قست قلوبكم ، او لنتم ثم قست قلوبكم ايها اليهود ، ومعني قسوتها امتناعها عن قبول الحق ، شبه عدم تاثير الحق فيها بعدم تاثير الغمز في الاجسام الصلبة كالحجر والحديد ، او شبه قلوبهم بالاجسام الصلبة ، ففي ذلك استعراة بالكناية رمز اليها بقست ، او شبه عدم قبول الحق بقسوة الاجسام الصلبة ، فالاستعارة تصريحية تبعية ، او شبه توجيه الحق الي قلوبهم وامتناعها عن قبولها بتوجيه نحو الغمز الي الاجسام الصلبة وعدم تاثيره فيها ، فهي استعارة تمثيلية تبعية ، ولا عبتار الاستعارة باوجهها حسن التفريع بقوله فهي كالحجارة ، ولك ان تعتبر التعقل الصادر منهم او التذكر او اللين الصادر منهم كلا تعقل او تذكر او لين لعدم كماله ورسوخه ، فتكون ثم لغير التراخي في الزمان بلا لاستبعاد قسوة القلوب بعد تلك الايات العظام ، فان نور العقل يستبعدها وتكون عنده مستحيلة ، فيجوز العطف بثم علي المحذوف الاخر ، وهو قولنا فحيي او علي يريكم وما ذكرته اولا اولي ، ويدل له قول قتادة وغيره المراد قلوب بني اسراءيل جميعا في معاصيهم وما ركبوه بعد ذلك ، وكذا يدل له قوله : { من بعد ذلك } فان ذلك يناسب كونها للتراخي في الزمان علي الاصل فيها .

 { من بعد ذلك } : المذكور في احياء القتيل او المذكور من احياء القتيل وتظليل الغمام ، وانزال المن والسلوي ، ورفع الجبل ، وفرق البحر ، ونحو ذلك فان كل واحد من ذلك مما يوجب الايمان ولين القلب والعمل بالشرع .

 { فهي } : اي قلوبهم .

 { كالحجارة } : في قسوتها .

 { او اشد } : منها فحذفه لدليل كقولك عمرو وكريم وزيد اكرم اي منه .

 { قسوة } : اي او زاءدة علي الحجارة في القسوة ، وقسوة تمييز ، ويجوز ان يكون المعني انها مثل الحجارة او مثل ما هو اشد من الحجارة وهو الحديد مثلا ، ووجه التوصل الي هذا الوجه ان تجعل الكاف اسما ظاهرا في محل رفع لا حرفا ، والحجارة مضاف اليها واشد بالرفع معطوفا علي الكاف علي حذف مضاف ، اي لو كاشد فالكاف معطوفة علي الكاف ، واشد مضاف اليه فلما حذف المضاف وهو الكاف الثانية ناب عنه المضاف اليه وهو اشد فارتفع وهذا علي اجارة مجء الكاف اسما في السعة ، وان تجعل اشد معطوفا علي ثابتة المقدر قبل الكاف او علي كالحجارة الناءب عنه علي مقدر مضاف ، اي او مثل اشد منها ، ويدل علي المعني الثاني وهو انها كالحجارة ، او مثل ما هو اشد بوجهي التوصل اليه . قراه الحسن البصري والاعمش ، او اشد بفتح الدال جرا عطفا علي الحجارة ، فهو بمنزلة قولك كالحجارة او اشد قسوة ، ولا يخفي ان الحديد اقوي من الحجر واقسي ، فانه يكسر الحجر ولا يكسره الحجر الا بعد اللذيا واللتيا والا ما رق منه او داخلته علة ، ولا يخفي ايضا ان الحجر لا يقبل الغمز والحديد يقبله بشدة ، ويقبله بالنار ، فجاز ان يقال او مثل اشد من الحجارة وهو الحديد مثلا من حيث انه يكسر الحجر ، وقد يقال اشد منه ليس مرادا به الحديد ، لان الكلام في عدم الليانة والحديد يلين بالنار ، بل المراد باشد الجسم الصلب الذي لا يلين بها ، لكن هذا باعتبار الغالب في اعمال الناس والا فالحجارة ايضا تلين بالنار ، لانها تذوب بعقاقيرها ، ولا يستدل علي لين الحديد بلينه لداود عليه السلام بلا نار ، لانه امر خارق للعادة ، وانما لم يقل فهي كالحجارة او اقسي ، مع ان قسا يقسو مستكمل لشروط صوغ اسم التفضيل ، لان بعض اشد ادل علي فرط القسوة من لفظ اقسي ، ولانه يدل علي شدة قسوة قلوبهم علي شدة قسوة الحجارة ، فان المفضل والمفضل عليه مشتركان في اصل ما فيه التفضيل ، وذكر بعض انه لم يكمل شروط اسم التفضيل لانه من الامور الحلقية والعيوب ، وقرء : قيساوة او علي اصلها من الدلالة علي النسبة لاحد الشيءين او الاشياء ، فهي لتلك باعتبار المخلوق ، يعني ان من عرف حال قلوبهم تردد بين ان يشبهها بالحجارة او بما هو اشد منها ، واختار ابو حيان انها للتنويع ، اي منها ما هو كالحجارة ومنها ما هو اشد ، ومن اجاز وقوع او التخييرية او الاباحية بعد غير الامر والنهي اجاز ان تكون هنا للتخيير اي الناس مخيرون بين ان يشبهوا قلوبكم يا بني اسراءيل بالحجارة او بما هو اشد او للاباحة اي ابيح للناس ان يشبهوها بالحجارة او بما هو اشد لصدق من يشبهها بالحجارة ، ولصدق من يشبهها بالحديد ، لان فيها شدة الحجارة وشدة ما هو اقوي منها ، ويجوز ان يكون للاضراب كبل ، وعليه اقتصر الشيخ هود C .



 قال ابن هشام : او بمعني بل ، عند الفراء : اي بل اشد . وقال بعض البصريين : للابهام ، وقيل للتخيير ، اي اذا راهم الراءي تحير بين ان يقول كالحجارة او اشد ، نقله ابن الشجري عن سيبويه ، وفي ثبوته عنه نظر اذ لا يصح التخيير بين شيءين ، الواقع في نفس الامر احدهما لا غير انتهي . قلت : يصح لان معني التخيير انه مخير باعتبار قصور نظره ، ويقدر في قوله كما يخير في امور شرعية ، ويعذر ولو لم يوافق الحق عند الله وكما يخير في شيءين ، وقد قضي الله في الازل باحدهما ، قال : وقيل هي للشك مصروفا الي الراي ، ذكره ابن جني ، ولا يجوز ان تكون بمعني الواو انتهي . قلت : يجوز ان تكون بمعني الواو فان في الحديد مثلا قوة الحجارة وزيادة ، فما اشبه الحديد قد اشبه الحجارة ايضا ، ففي قلوبهم قسوة الحجارة ، والقوة التي زيدت في الحديد مثلا ، روي البزاز عن النبي A :



 « اربعة من الشقاء : جمود العين ، وقساوة القلب ، وطول الامل ، والحرص علي الدنيا » قال الغزالي في المنهاج : اول الذنب قسوة واخره والعياذ بالله شءم وشقوة ، وسواد القلب يكون من الذنوب ، وعلامة سواد القلب الا تجد للذنوب مفرعا ، وللطاعة موقعا ، وللموعظة منجعا .

 { وان من الحجارة لما يتفجر } : نتفتح بسعة وكثرة وقرء هنا وفي الذين بعد هذا ، وان باسكان النون ، فتكون ان مخففة ، واللام في قوله لما فارقه بين النفي والاثبات . وقرا مالك بن دينار : ينفجر بالنون الساكنة . C .

 { منه الانهار } : والمراد كل حجر من الحجارة التي انفجر منها عين كبيرة . وقيل اراد الحجر الذي يضرب عليه موسي ، والاثني عشر عينا التي تتفجر منه .

 { وان منها لما يشقق } : ينخرق طولا وعرضا .

 { فيخرج منه الماء } : فيكون عينا صغيرة ، والاصل يتشقق ابدلت التاء شينا ، وادغمت الشين في الشين ، وقرا الاعمش : يتشقق علي الاصل .

 { وان منها لما يهبط } : وقرء بضم الباء الموحدة ، اي ينزل من علو لاسفله ، وقيل هبوط الحجر بفء ظله .

 { من خشية الله } : يخلق الله جل وعلا فيه تمييزا فيخاف الله خوفا مقرونا بتعظيم ، فينزل لتلك الخشية ، فمن للتعليل ، ويجوز ان تكون الخشية مجازا عن الانقياد لما اراد الله سبحانه به ، ثم رايت الوجه والحمد لله ، ذكره النسفي مستدلا له بقوله D : { لو انزلنا هذا القران علي جبل لرايته خاشعا متصدعا من خشية الله } واختاره ابن عطية ، قال بعض : يخلق في بعض الاحجار خشية يهبط بها من علو تواضعا ، وياتي كلام في ( سبحان ) ان شاء الله ، والاول للقاضي كجار الله ، ويجوز عود قوله : { من خشية الله } الي قوله : { يتفجر } وقوله : { يشقق } وقوله : { يهبط } فهو متنازع فيه ، ويدل له قول مجاهد : ما تردي حجر من راس جبل ولا تفجر نهر من حجر ، ولا خرج ماء منه الا من خشية الله D نزل بذلك القران . وقال مثله ابن جريج وقوله تعالي : { وان من الحجارة } الي قوله : { من خشية الله } تعليل في المعني لقوله : { او اشد قسوة } ومعطوف في اللفظ علي قوله { هي كالحجارة } ومن يزعم ان الواو تكون للتعليل كالفاء قال انه تعليل في اللفظ والمعني ، كانه قيل او اشد قسوة من الحجارة ، لان الحجارة يتاثر فيها كلام الله وجلاله وتطاوع فيما اريد منها فمنها ما يتفجر منه العيون ، ومنها ما يتشقق فيخرج منه الماء ، ومنها ما يهبط من خشية الله ، وقلوبكم لا يءثر فيها ذلك ولا تطاوع فهي لا تليل ولا تخشع . قال الشيخ هود C وقتادة : عذر الله الحجارة ولم يعذر شقي بني ادم ، يعني انه تعالي ذكر عن الحجر الاذعان والامتثال فهو غير مقطوع العذر عند الله لانه ممتثل .



 { وما الله بغافل عما تعملون } : ولكن يءخركم لوقت ياتي لا محالة ، فيجازيكم علي ما تعملون من المعاصي المترتبة علي قسوة القلوب ، او من قسوة القلوب ، لانها حصلت باسبابكم وذلك وعيد ، قال ابو عمرو والداني : قرا ابن كثير : { وما الله بغافل عما يعملون } بالتحتية والباقون بالفوقية ، وفي التحتية طريق الالتفات من الخطاب الي الغيبة ، فان الخطاب في قلوبكم لبني اسراءيل وكذا في ( تعلمون ) في قراءة الفوقية ، ولا يخفي ان في التحتية انضماما الي قوله : { ان يءمنوا لكم } وليس في الفوقية انضمام الي قوله : { افتطمعون } لان الخطاب في تعلمون ليس لهم وليس كما قيل : ان نافعا وابن كثير ويعقوب وخلفا وابا بكر يقرءون بالتحتية ، والباقين بالفوقية ، قالوا : [ من قسا قلبه علي اخيه او ضاق صدره علي اهله او تغير عن حاله الحسن فلياخذ شقف فخار جديد عمل من طين طيب الراءحة كما طلع من التنور ، ويكتب فيه بقلم شجرة الاس قوله تعالي : { ثم قست } الي قوله : { عما تعملون } بنية الشخص الذي يريد ان يلين قلبه ، بعسل لم تمسه النار ، وخل خمر يدبر الكتابة سبع مرات ويرمي به في القدح الذي يشرب منه المعمول له فانه يرجع الي حاله الاول ان شاء الله . واذا تغير السلطان علي الرعية فليكتب في قرطاسه كما تكتب في الشقفة باسمه واسم امه ، ويجعل في اعلي موضع من الجبل ، فان سيرته تصلح باذن الله ، وكذا اذا انقطع عليه البءر او العين او قل فاكتبها في شقف طين وارمه في البءر يكثر ماءها باذن الله ، وكذلك اذا قل لبن شاة او بقرة فاكتبها في طاسة نحاس وامحها بماء طاهر واسقها منه ، فان اللبن يكثر بحول الله تعالي ] .



