 اخر في الحلاج نفت بعين عقله فما شاهد سوي الاثار فكر فلم يجد في الدارين مطلو با سوي محبوبه فطلب وقال بلسان سكر قلبه انا الحق بصوته لحنا عرضه لحتفه . انتهي المقصود من كلامه رضي الله عنه وعو ظاهر في الحكم بشطحه تصويب واجراء الحكم انشرعي عليه وفي كلام منسوب الي الشيخ ابي الغيث بن جميل رضي الله عنه سقاك الله من شراب من حسا منه حسوة واحدة عدم عقله فن كان اكثر من ذنك ادعي الربوبية وانظامر انه دعاء غير مختار وانه لم يصدر عن روية ان عدم العقل لا فضيلة فيه ودعوي الربوبية خطا مع عدم انعقل وكفر مع وجود انعقل فكيف يدعي بشراب تكون منه هذه العاقبة فاما من يدعي بلوغ عذه الحانة في الصحو فمفتون عن دينه والعياذ بالله فلا يظن بالشيوخ المحققين انهم يثبتون ولاية من انتهي الي تلك الحال نه بل حكمه انه يكفر ويقتل بكفره وانعياذ بالله من مكره . والدليل علي انه ممكور به تول الله تعالي : واتل عليهم نبا الذي اتيناه فا نسلخ منها فاتبعه انشيطن فكان من انغاوين ونو شءنا لرفعناه بها ولكنه اخلد الي الارض واتبع هواه () . الايات كلها قال المفسرون نزنت في بلعم بن باعور اتاه الله حجج التوحيد وادلته والاسم الاعظم . وكان علي ما روي في قصنه يري من الثراء الي العلاء ولكنه اخلد الي الارض اي سكر الي الدنيا واتبع هواه فسلخه الله مما كان عليه حتي روي في انقصة ان الله نزع منه معرفة الاسم الاعظم والايمان بدعوة موسي عليه السلام فخرجت المعرفة من صدره كحمامة بيضاء ثم صار بحيث قيل انه اول من صنف ان ليس للعالم صانع قالوا وهذه الاية من اشد الاي علي اهل العلم وكذلك قوله تعالي : قل يا اهل الكتاب لستم علي شي، حتي تقيموا التورات والانجيل وما انزل اليكم من ز بكم وليزيدن كثيرا منهم ما انزل اليك من ربك طغيانا وكفرا () الاية وقد تقدم في العقاءد النسفية : ان السعيد قد يشقي والشقي قد يسعد . والتعيين علي السعادة واشقاوة دون الاسعاد والاشقاء وهما من صفاة الله تعالي ولا تغيروا علي الله ولا علي صفاته تبارك وتعالي وقال الاستاذ ابو الفاسم القشيري رضي الله عنه في باب الكرامة من رسالته : ولا يبعد ان يكون وليا في الحال صديقا . ثم يتغير . قال : وهذا الذي عباده نحن ؟ انتهي . وقال في باب الولاية ومن شرط الولي ان يكون محفوظا كما ان من شرط النبء ان يكون معصوما فكل من كان للشرع عليه اعتراض فيو مغرور مخادع انتهي كلامه رضي الله عنه . وقول الشيخ ابي العباس الشاذلي ما يكره من الفقها. الا خصلتين تكفيرهم الحلاج وحكمهم بموت الخضر . ثم قال والله لو جاء ماءة فقيه ما رجعت اليهم . يعني في الخصلتين . وقيل في موت الخضر خاصة . فاما الحلاج فقد علمت ما فيه مما تقدم واما موت الخضر صاحب موسي عليهما السلام فقد نقله المرسي كما نري عن الفقهاء مطلقا . والعجب من قوله لو جاء ماءة فقيه



![image file](./HusaynIbnAbdRahmanAhdal.KashfGhita_.png)
 ما رجعت اليهم وللفقيه ان يقول لو جاء ماءة صوفي ما رجعت اليهم . واعلم ان موت الخضر هو الذي يقول به المحتقون من المحدثين كالامام ابي عبد الله البخاري وابراهيم الحربي وابن المذدي وانفضي ابي بكر بن انعربي وابن عطية وابي العباس ابن تيمية وابن فيم الجوزية وغيرهم والنيه يرجع ابن الجوزي في العجالة التي صنفها في نفي حياة الخضر بعد ان صور في كتبه من حكايات حياته واستدلوا بقوله تعالي وما جعلنا لبشر من قبلك الخلد . ولقوله صلي الله عليه وسلم لما اعتم بصلاة انعشاء ارايتم ليلتكم هذه فان علي راس ماءة سنة لا يبقي ممن هو اليوم علي ظهر الارض احد وانما اغتر من اعتقد حياة الخضر الي الان بما وقع في التفاسير عن الاخباريين من ذكر حياته في قصص يرووبها من اذ سراءيليات فتواردت علينا الاوهام وانضاف الي ذنك دعوي بعض الصالحين لقاءه والاجتماع به وانتشرت تلك اندعاوي في كتب الدقاناق وجعلوها من المناقب والكرامات واصلها رواية تعزية اسل البيت بموت اننبء صلي الله عليه وسلم بصوت سمع من غير ظهور شخص فقيل هو الخضر عليه انسلام وحديت تعزية اهل البيت بالصوت المذكور نم يصح عند المحدثين وانما قال من قال انه الخضر بوهم واحتسل ون ذنك انصوت من بعض الملاءكة . او بعض مءمني الجن افرب من كونه صوت الحضر وانما تصح حياة الخضر بثبوت خبر عن النبء صلي الله عليه وسلم يخبر بانه حي ، او انه اجتمع به ، ولا يصح ذلك عن النبي. صلي الله عليه وسلم قط . وانما كثرت دعاوي حياته ، بعد عصر النبء صلي الله عليه وسلم ، وحكايتهم في ذلك مضطربة اضطرابا يوجب سقوطها . واحتجوا في اضطرابها بانه يتصور بصور كثيرة كانه يخلق نفسه وذلك باطل في حق البشر باتفاق العلماء والمحققين كما نبهنا عليه في غير هذا الموضع وبهذا يظهر ضعف قول ابن الصلاح في فتاويه هو حتي عند الخاصة من العلماء والصالحين والعامة معهم في ذلك وانما شذ بانكاره بعض المحدثين وضعف قول النووي جمهور العلماء علي انه حي موجود بين اظهرنا وذلك متفق عليه عند الصوفية واهل انصلاح والمعرفة ، ولا تجد نفتواهما مستندا سوي التقليد المشهور ورقة  وجه والروايات الضعيفة والحكايات المضطربة وتوارد الاوهام علي ذلك واين اقوال العلماء المعتبرين في ثبات حياته صريحا قصدا نلفتوي بذنك والحق انه لا وجود له في هذه الاونة فلا تصح دعوي رءيته ولقاءه اذ لا يعلم الراءي انه هو الا بدعوي ذلك المرءي او بمجرد وهم الراءي انه الخضر وبحملك لا يوجب علما يقينا بانه صاحب موسي عليهما انسلام ولانه لا يري علي صورة الاولين واقرب تاويل للصالحين ان الخضر الذي يلقاهم ولي من الرجال السياحين وربما كان شيطانا يلبس عليهم وعلي هذا يتعدد المتحضرون وتختلف صفاتهم وتضطرب الروايات عنهم فنسقط الثقة بقول من يقول انه لقي الخضر فاعلم ذلك ثم المحققون علي ان الخضر صاحب موسي نبء واختلفوا في كونه مرسلا جزم بنبوته الواحدي والسجاوندي . في مواضع والسهيلي والزمخشري في



![image file](./HusaynIbnAbdRahmanAhdal.KashfGhita_.png)
 مواضع من القصة والبيضاوي والكواشي والخبري المفسر وابن الصلاح والنووي في فتاويهما . ورجحه فخر الدين الرازي بنقله عن الاكثرين وصححه ابن عطية ، والقرطبي والشيخ ابوحيان وصاحبه ابن كثير في تفاسيرهم وظاهر كلام الثعلبي الاتفاق عليه فانه قال الخضر علي جميع الاقوال نبء معمر محجوب عن الابصار . فقوله معمر مستنده مذه الننرة عند العامة التي لا حقيقة لها وانما اخذنا بقوله وقول ابن انصلاح والنووي في قولهم نبي، لظهور الدليل ومساعدة المنقول عن المفسرين ، ونم ياخذ بقولهم في حياته لصعف مستندهم ومعارضة اقوال المحققين قوتهم وقد وقع في تفسير البغوي ان الخضر لم يكن نبيا عند اكثر اهل العلم وصوابه عند كثيرين كما قاله شيخه القشيري في الرساتة . فقلده البغوي غير مستحضر لاقوال المفسرين . والكثير المشار اليهم صوفية . ولا عبرة بكثرتهم في مقابلة المحققين ويدل علي نبوته ذكر المحدثين له مع الانبياء مع الصلاة عليه والتسليم ، في جميع نسخ كتب الحديث فيقونون باب فضاءل الخضريات . ذكر الحضر صلي الله عليه وسلم او عليه السلام ويدل عليه ايضا افعاله التي لا يجوز للولي ان يفعلها بمجرد الكشف كفتل الغلام الذي لا يطلع علي سبب جوازه الا بالوحي ولذلك لم يلتزم شريعة موسي وقال : وما فعلته عن امري () . قال المحققون بل الوحي الذي ياتي الانبياء من عند الله . واذا قلنا انه نبء بطل احتجاج من يدعي علم الباطن المخالف نظامر انشريعة محتجا بقصته مع موسي عليهما السلام ورقة  ظهر راندفعت اشكالات كثيرة هي داعية ضلال كبير وبالله التوفيق . وقد بسطت الكلام في بيان احوال الخضر واثبات نبوته ونفي حياثه في مذه الامة . وبيان ضعف القول بحياته في شرح دعاء ابي حربه وتصنيفه مفردة . وبالله التوفيق. وبهذا القول مع ما تقدم في ذكر مقتل الحلاج ، يظهر تساهل الصوفية في دعوي ولاية الحلاج وردهم علي الفقهاء في تكفيره لان مبني طريقتهم علي حسن انظن وتجنب الجرح الذي عني به المحدثون نصيحة للمسلمين وذبا عن الدين لا بعريق الغيبة المحرمة . وبهذا يظهر ضعف مستمدعم في دعوي حياة الخضر ولقاءه ونفي نبوته . ولا يستبعدن غلط الشيوخ وتساهلهم في مثل مذا. لضعف عنايتهم بتحقيق الروايات وقلة تحرزهم عن بواطل الحكايات وسياتي قول القشيري لا ينبغي للمريد ان يعتقد في المشايخ العصمة الي اخر المقالة . ولا تجوز دعوي علم انقاءلين بوجود ولايته علي انهم تلقوا ذلك من والكشف لا يوتق به في تحقيق العلم والغالب علي اكثر الصوفية عدم تحقيق العلوم وقد رد الشيخ ابو عبد الله بن حفيف بعض مقالات الشيوخ في تاويل



![image file](./HusaynIbnAbdRahmanAhdal.KashfGhita_.png)
 حديت الاغاثة علي قلب اننبء صلي الله عليه وسلم وان كان انشيخ بندار بن حسين قد رد عليه في رده ايضا . والمقصود ان كلامهم يقع فيه ما يقع من الوهم او الشطح كما نبهنا عليه قبل هذا . ولله در السيخ ابي عبد الله بن حفيف حيث قال لاصحابه وقد راهم يطالعون شيءا من كلام الصوفية اشتغلوا بتعلم ما ينفعكم ولا يغرنكم كلام الصوفية فانهم كانوا منعوني عن العلم وكنت اخبا محبرتي في جنب مرقعتي والكاغذ في حجرة سراويلي وكنت اذهب الي اهل العلم خفيا منهم فاذا علموا بي خاصموني وقالوا لي لا تفلح ، ثم احتاجوا الي بعد ذلك . رواه عنه الامام ابو القاسم بن عساكر في كتاب تبيين كذب المفتري وذكر الجندي وغيره وجادة عن الفقيه قطب الدين اسماعيل ابن محمد الحضرمي رحمه الله انه ذاكر بعض اصحاب الشيخ ابي الغيث ابن جميل البمني فقال له انفقيه اسماعيل كان الشيخ مخطء في كلامه في بعض ااجالس فاستعظم صاحبه ذنك وانكر قول انفقيه اسماعيل رحمه الله فلما كان تلك الليلة بعد العشاء رايت الشيخ ابا الغيث تمثلت لي صورته فقلت له بالله انت الشيخ ابو الغيث فقال لي نعم . ثم قال لي يا فقيه اخطانا كثيرا ووقعنا كثيرا ولكن قبلت منا العزاءم وصفحت عنا الجراءم في كلام اخر لا ينعلق بما نحن فيه ولنرجع الي التحذير من شطح الحلاج وامثاله . ونقول من لم يحفه التوفيق الالامي ولم يقومه ثقاف تاديب الشريعة المطهرة بالتزام اثار سنن الانبياء والترسم بسير الصحابة والاثقياء من السلف العلماء المجتهدين والاءمة المهتدين وركب راسه وقلد هواجسه وقنع بمواجيده في سلوكه وعقد توحيده زلت به القدم فهوي من اوج المعرفة الي حضيض الجهل فانقلبت معرفته نكرة والعياذ بالله من مكر الله وقد تقدم في عقيدة القشيري ان القوم احكموا اصول العقاءد بواضح الدلاءل ولاءح الشواهد يعني العلماء منهم المتقيدين بالكتاب والسنة لا الذين اشرنا الي الانكار علييم بعدم التقيد كما قال ابو محمد الجريري من لم يقف علي علم التوحيد بشاهد من شواهده زلت به قدم الغرور في مهواة من التلف معناه من لم يقف علي علم التوحيد الذي تشهد به الشريعة . وادعي طورا وراء ذلك من اطواز المعرفة سقط عن سنن البجاة كشطاح الصوفية وملاحدتيم كابن عربي والحلاج واتباعهم وعلي هذا الحكم ينبغي ان يحمل قول القاءل ومو منسوب الي الحلاج : من اطلعوه علي سر فباح به لم يامنوه علي الاسرار ما عاشا
 وعاقبوه علي ما كان من زلل وبدلوه مكان الانس فيحمل علي ان من فعل ذلك انسلخ من المعرفة . وسقط في مهاوي الكفر والضلال اذ لم يتداركه الله بالتوبة والعياذ بالله . ولعل الحلاج قال



