 وابي عبد الله محمد بن الحسن الشيباني رضي الله عنهم اجمعين وما يعتقدون من اصول الدين ويدينون به رب العالمين نقول في توحيد الله تعالي معتقدين بتوفيق الله : ان الله سبحانه وتعالي واحد لا شريك له ولا شء مثله ولا شي، يعجزه ولا الاه غيره ، قديم بلا ابتداء داءم بلا انتها، لا يفني ولا يبيد ولا يكون الا ما يريد . لا تبلغه الاوهام ولا تدر كه الافهام ولا بشبيه الا نام ، خالق بلا حاجة رازق بلا مءونة ، مميت بلا مخافة ، باعث بلا مشقة ، ما زال بصفاته قديما فبل خلقهم لم يزدد بكونهم شيءا لم يكن قبلهم من صفته وكما كان بصفاته از ليا كذلك لا يزال عليها ابديا ليس منذ خلق الخلق استفاد اسم الخالق ولا باحداثه البرية اسنفاد اسم الباري ، له معني الربوبية ولا مربوب ومعني الخالقية ولا مخلوق . وكما انه احيا الموتي بعد اما تتهم استحق هذا الاسم قبل احياءهم كذلك استنق اسم الخالق قبل . انشاءهم . ذلك بانه علي كل شء قدير ، وكل شء اليه فقير ، وكل امر عليه ورقة  تهر سير لا يحتاج الي شء ليس كمثله شء وهو السميع البصير خلق الخلق بعلمه وقدر ليم اقدارا . وضرب لهم اجالا . لم يخف عليه شء قبل ان يخلقهم ، وعلم ما هم عاملون قبل ان يخلقهم . وامرهم بطاعته ونهاهم عن معصيته وكل شي. يجري بقدرته ، ومشيءته تنفذ لا مشيءة للعباد الا ما شاء لهم ، فما شاء كان وما لم يشا لم يكن . يهدي من يشاء ويعصم ويعافي فضلا ويضل من يشاء ويخذل ويبتلي عدلا ، وكلهم يتقلبون في مشيءته وعدله . لاراد لفضاءه ولا مانع لعطاثه ولا معقب لحكمه ، ولا غالب لامره . امنا بذلك كله وايقنا ان كلا من عنده ، وان محمد اعبده المصطفي ونبيه المجتبي ورسوله المرتضي وانه خاتم الانبياء وامام الاتفياء المبعوث بالحق والهدي صلي الله عليه وسلم. فصل وان القران كلام الله تعالي منه سمع بلا كيفية قول وانزله علي نبيه وحيا وصدقه المءمنون علي ذلك حقا . وايقنوا انه كلام الله تعالي بالحقيقة وليس بمخلوق ، ككلام البرية ، فمن سمع فزعم انه كلام البشر فقد كفر وقذ ذمه الله تعالي وعابه واوعده عذابه حيث قال : ساصليه () سقر ، فلما اوعد الله تعالي بسقر لمن قال ان هذا الا قول البشر ، علمنا انه قول خالق البشر ولا يشبهه قول البشر ومن وصف الله تعالي بمعني من معاني البشر فقد كفر فمن ابصر هذا اعتبر ، وعن مثل قول الكفار اندحر وعلم ان الله تعالي بصفاته ليس كالبشر. فصل في الرءية حق لاهل الجنة بغير احاطة ولا كيفية ، كما نطق به كتاب ربنا : وجوه () يومءذ ناضرة الي ربها ناظرة . وتفسيره كما اراد الله وعلمه.



![image file](./HusaynIbnAbdRahmanAhdal.KashfGhita_.png)
 وكل ما جاء في ذلك من الحديث الصحيح عن رسول الله علي الله عليه وسلم فهو كما قال . ومعناه علي ما اراد لا يدخل في ذلك متاولين باراءنا ولا متوعمين باهواءنا فانه ما سلم في دينه الا من سلم لله ورسوله صلي الله عليه وسلم، ورد علم ما اشتبه عليه الي عالمه ولا يثبت قدم الاسلام الا علي ظهر التسليم ومن رام ما حضر عليه عامه ولم يقنع بالتسليم فهمه ازله مرامه عن خالص التوحيد وصافي المعرفة و(. . .) الايمان ، فيتذبذب بين الكفر والنفاق والايمان والتصديق والتكذيب ، والاقرار ، والانكار . موسوسا تاءها شاكا ، وايضا لا مءمنا مصدقا ولا جاحدا مكذبا . ولا يصح الايمان بالرءية لاهل دار الاسلام لمن اعنبرها بوهم او تاويلها بفهم ، ان كان تاويل الرءية وتاويل كل علي معني يضاف الي الربوبية ترك التاويل ولزوم التسليم ، وعليه دين المرسلين وشراءع النبءين ومن لم يتوق التقي والتشبيه زل ولم يصب التنزيه فان ربنا جل وعلا موصوف بصفات الوحدانية ، منعوت بنعوت الفردانية ، ليس بمعناه احد من البرية تعالي عن الحدود والغايات والاركان والاعضاء والادوات ولا تحويه الجهات الست كساءر المبدعة . فصل والمعراج حق ، وقد اسري برسول الله صلي الله عليه وسلم وعرج بشخصه في اليقظة الي السماء ثم الي حيث ما شاء الله من العلي واكرمه بما شاء واوحي اليه ما اوحي ، والحوض الذي اكرمه الله به غياءا لامته حق ، والشفاعة التي ادخرها لهم حق ، كما جاء في الاخبار ، والميثاق الذي اخذه الله تعالي من ادم ورقة  وجه عليه السلام وذريته حق ، وقد علم الله تعالي فيما لم يزل عدد من يدخل الجنة والنار جملة واحدة ، فلا يزاد في ذنك العدد ولا ينقص منه شء وكذلك افعالهم فيما علم منهم ان يفعلوا ، وكل ميسر لما خلق له ، وصاءر الي ما خلق له ، والاعمال بالخواتم . والسعيد من سعد بقضاء الله تعالي ، والشقي من شقي بقضا، الله تعالي. واصل القدر سر الله تعالي في خلقه لم يطلع علي ذلك ملك مقرب ، ولا نبي مرسل ، والتعمق والنظر في ذلك ذريعة الخذلان ، وسلم الحرمان ودرجة الطغيان فا نحدر من ذلك نظرا وفكرا ووسوسة . فان الله تعالي طوي علم القدر عن انامه ونهاهم عن مرامه فقال عز وجل لا يسال عما يفعل وهم يسالون ، فمن سال لم فعل ؟ . فقد رد حكم الكتاب ومن رد حكم الكتاب فهو من الكافرين . فهذه جملة يحتاج من هو منور قلبه من اولياء الله تعالي ، وهي درجة الراسخين في العلم. لان العلم علمان : علم في الخلق موجود ، وعلم في الخلق مفقود . فانكار العلم الموجود كفر وادعاء العلم المفقود كفر . ولا يثبت الايمان الا بقبول العلم الموجود وترك طلب العلم المفقود. فصل : ونءمن باللوح والقلم ، وبجميع ما فيه قد رقم ، فلو اجتمع الخلق كلهم علي شء كتبه الله فيه انه كاثان ليجعلوه غير كاءن ، لم يقدروا عليه



![image file](./HusaynIbnAbdRahmanAhdal.KashfGhita_.png)
 ولو اجتمع الخلق كلهم علي شء لم يكتبه الله فيه انه غير كاءن ليجعلوه كاثنا لم يقدرواعليه البتة . وما اخطا العبد لم يكن ليصبه ، وما اصابه لم يكن ليخطيه وعلي العبد ان يعلم ان الله جل وعلي قد سبق علمه في كل كاءن من خلقه وقدر ذلك بمشيءته تقديرا محكما مبررا ليس فيه ناقض . ورقة  ظهر معقب ولا مزيل ولا مغير ولا معقول ، ولا ناقص ولا زايد من خلقه في سمواته وارضه ، وذلك من عقد الايمان واصول المعرفة والاعتراف بتوحيد الله وربو بيته كما قال عز وجل في كتابه الكريم : وكان () امر الله قدرا مقدورا وقال الله تعالي : وخلق كل شء () فقدره تقديرا ، فويل لمن كان له قلب سقيم ، لقد التمس بوعمه في محض الغيب سرا كتيما ، وعاد بما قال افاكا اثيما . فصل : والعرش حق وانكرسي حق ، كما بينه سبحانه وتعالي في كتابه وعو جل جلاله مستغن عن العرش فما دونه ، محيط بكل شء وفوقه ، وقد اعجز عن الاحاطة خلقه . فصل : ونقول ان الله تبارك وتعالي اتخذ ابراهيم خليلا وكلم موسي تكليما ايمانا وتصديقا وتسليما . ونءمن بالملاءكة والنبيءين والكتب المنزلة علي المرسلين ، ونشهد انهم كانوا علي الحق المبين ونسمي اهل قبلتنا مسلمين ما داموا بما جاء به النبي، معترفين ، وله بكل ما قال واخبر مصدقين . لا نخوض في الدين ولا نجادل في القران ، ونعلم انه كلام رب العالمين . نزل به الروح الامين ، فعلمه محمدا صلي الله عليه وسلم وعلي اله اجمعين ، وكلام الله عز وجل لا يساويه شء من كلام المخلوقين ولا نقول بخلقه ولا نخالف جماعة المسلمين . ولا نكفر احدا من اهل القبلة بذنب لم يستحله ولا نقول لا يضر مع الايمان ذنب ونرجو للمحسنين من المءمنين ولا نامن عليه ولا نشهد لهم بالجنة ولا نقنطهم ونخاف عليهم ونستغفر لمسيءهم ، والامن والاياس ينقلان عن الملة وسبيل الحق بينهما لاصل القبلة . ولا يخرج العبد من الايمان الا بجحود ما ادخله فيه . والايمان هو الاقرار باللسان ، وتصديقه المعرفة بالجنان وجميع ما انزل الله في القران ، وجميع ما صح عن رسول الله علي الله عليه وسلم من الشرع والبيان كله حق ، والايمان واحد واهله في اصله سواء والتفاضل بينهم في الحقيقة ومخالفة الهوي ، والمءمنون كلهم اولياء الرحمان واكرمهم اطوعهم واتبعهم للقران ، وان الايمان هو الايمان بالله وملاءكته وكتبه ورسله واليوم الاخر ، وبالقدر خيره وشره حلوه ومره من الله تعالي ومن يءمنون بذلك كله لا نفرق بين احد من رسله () . ونصدقهم كلهم علي ما جاءوا به .



![image file](./HusaynIbnAbdRahmanAhdal.KashfGhita_.png)
 فصل : واهل الكباءر لا يخلدون في اتنار اذا ماثوا وهم موحدون وان لم يكو نوا تاءبين بعد ان لفوا الله عز وجل عارفين ، وهم (. . .) وعدله ان شاء غفر لنم وعفا عنهم كما قال تعالي ويغفر ما دون ذلك لمن يشاء () . وان شاء عذ بهم في النار بعدله ، ثم يخرجيم منها برحمته وشفاعة الشافعين من اعل طاعته ، ويبعنهم الي جنته ، ذلك بان الله تعالي مولي اهل معرفته ولم يجعلنم في الدارين كاهل نكرته ، الذين خابوا من مدايته ، ولم ينالوا من ولا يته . الليم ياولي الاسلام واهله مسكنا بالاسلام حتي نلقاك به . ذصمل : ونري الصلاة خلف كل بر وفاجر من اهل القبلة ، ونصلي علي من مات منهم ولا ننزل احدا منهم جنة ولا نارا ، ولا نشيد عليهم بكبر ولا بشرك ولا بنفاق ما لم يظنر منهم شي، من ذلك . ونذر سراثارهم الي الله تعالي ولا نري السيف علي احد من اهة محمد صلي الله عليه وسلم الا علي من وجب عليه السيف ولا الخروج علي ايمننا وولاة امرنا وان جاروا . ولا ندعو عليهم ولا ننزع يدا من طاعنيم ، ونري طاعتهم من طاعة الله تعالي فريغة . وندعو لهم بالصلاح و لمعاناة ونتبع السنة والجماعة ونجتنب الشذوذ والخلاف والفرقة ونحب اهل العدل والامانة ونبغض اعل الجور والخيانة ونقول ان الله تعالي فينا علما اشتبه تلينا علمه () ونري المسح علي الخفين في الحضر والسفر كما جاء في الاثر والحج والجهاد ماضيان مع اولي الامر من اءمة المسلمين ، برهم وفاجرعم الي قيام الساعة . لا يبطلهما شء ولا ينقضيما ، ونءمن بالكرام الكاتبين ، وان الله تع لي قد جعلهم علينا حافظين ، ونءمن بملك الموت الموكل بقبض ارواح العالمين وبعذاب القبر لمن كان له اهل وسءال منكر ونكير للميت في قبره عن ربه ودينه ونببه علي ما جاءت به الاخبار عن رسول الله صلي الله عليه وسلم . والقبر روضة من رياض الجنة او حفرة من حفر النيران ونءمن بالبعث وجزاء الاعمال يوم القيامة ، والعرض والحساب وقراءة الكتاب ، والثواب والعقاب والصراط والميزان ، والجنة واننار مخلوقتان قبل الخلق ، وخلق تهما اهلا فمن شاء منهم للجنة فضلا منه ومن شاء منهم نلنار عدلا منه ، والشر والخير مقدران علي العباد . والاستطاعة التي يجب بنا الفعل من نحو التوفيق الذي يجوز ان بوصف المخلوف به مع الفعل واما الاستطاعة من جهة الصحة والوسع والتمكين وسلامة الالات فهي قبل الفعل كما قال الله تعالي : لا يكلف الله نفسا الا وسعها . وافعال العباد خلق الله وكسب من العباد ، ولم يكلفهم الله الا ما يطيقون



