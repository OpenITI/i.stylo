 محمد بن جعفر الانصاري، حدثنا يحيي بن بكير المخزومي، ثنا مالك بن انس عن حبيب ابن عبد الرحمن بن حفص بن عاصم عن عمر بن الخطاب قال قال رسول الله صلي الله عليه وسلم: "من قرا في ليلة الف اية لقي الله وهو ضاحك في وجهه"، قيل يا رسول الله ومن يقوي علي قراءة الف اية؟ فقرا {بسم الله الرحمن الرحيم الهاكم التكاثر} الي اخرها، ثم قال: "والذي نفسي بيده، انها لتعدل الف اية". "خط في المتفق والمفترق" وقال الراوي له عن يحيي بن بكير مجهول والحديث غير ثابت.
 
  – "
  سورة الاخلاص
 " "علي رضي الله عنه" عن علي قال، "من قرا قل هو الله احد عشر مرات في دبر كل صلاة الغداة لم يلحق به ذلك اليوم ذنب، وان جهد الشيطان" "ص وابن الضريس".
    
 عن عيسي عن علي قال: "اني قارء عليكم القران قال فقرا عليهم: {قل هو الله احد} ثلاث مرات. "علي بن حرب الطاءي في الثاني من حديثه".
 
  – "
  المعوذتان
 " عن عقبة بن عامر الجهني: "كنت مع النبي صلي الله عليه وسلم في سفر فلما طلع الفجر اذن واقام، ثم اقامني عن يمينه، ثم قرا بالمعوذتين فلم انصرف قال كيف رايت؟ قلت قد رايت يا رسول الله قال اقرا بهما كلما نمت، وكلما قمت ". "ش".
 
  – "
  جامع السور
 " "من مسند الصديق رضي الله عنه"
 
 عن ابي بكر قال: "قلت يا رسول الله لقد اسرع اليك الشيب؟ قال: "شيبتني سورة هود والواقعة والمرسلات وعم يتساءلون واذا الشمس كورت". "مسدد ع وابن المنذر وابو الشيخ طب كر وابن مردويه والصابوني في الماتين كر".
    
 عن ابي بكر، قال قلت: "يا رسول الله عجل اليك الشيب؟ قال: " شيبتني هود واخواتها الحاقة والواقعة وعم يتساءلون وهل اتاك حديث الغاشية". "البزار وابن مردويه".
    
 عن ابي بكر قال قلت "يا رسول الله ما شيب راسك؟ قال هود واخواتها، شيبتني قبل المشيب، قلت وما اخواتها؟ قال: اذا وقعت الواقعة وعم يتساءلون، واذا الشمس كورت شيبتني قبل المشيب ". "ابن مردويه".
    
 عن سعيد بن جبير قال: "قال عمر بن الخطاب: من قرا البقرة وال عمران والنساء كتب عند الله من الحكماء" "ص هب".
    
 عن المسور بن مخرمة انه سمع عمر بن الخطاب يقول: "تعلموا سورة البقرة وسورة النساء وسورة الماءدة وسورة الحج وسورة النور فان فيهن الفراءض". "ك هب".
 
    
 عن عمر قال: "تعلموا سورة براءة وعلموا نساءكم سورة النور وحلوهن الفضة". "ابو عبيد في فضاءل القران ص وابو الشيخ في تفسيره هب".
 
  فصل في اداب التلاوة
    
 "من مسند الصديق رضي الله عنه" عن ابي صالح قال: "لما قدم اهل اليمن زمان ابي بكر، وسمعوا القران جعلوا يبكون، فقال ابو بكر هكذا كنا ثم قست القلوب". "حل" وقال: معني قوله قست القلوب قويت واطمانت بمعرفة الله تعالي، قلت: ويدخل هذا في المرفوع لقوله كنا.
    
 "ومن مسند عمر رضي الله عنه" عن ابن عمر "ان عمر قرا سورة مريم، فسجد ثم قال هذا السجود فاين البكاء". "ابن ابي الدنيا في البكاء وابن جرير وابن ابي حاتم هب".
    
 عن عمر قال: "حسنوا اصواتكم بالقران". "ش".
    
 عن عمر "انه كان اذا قرا {سبح اسم ربك الاعلي} قال سبحان ربي الاعلي" "ش".
 
    
 عن عمر قال: "اقرءوا القران واسالوا الله به قبل ان يقرا قوم يسالون الناس به". "ش".
    
 عن محمد بن المنتشر قال قال عمر لرجل: "اقرا يا فلان الحجر قال او ليست معك يا امير
 المءمنين؟ قال: اما بمثل صوتك فلا". "هب وابو عبيد الله الحسين بن خسر وفي مسند ابي حنيفة".
    
 عن محمد بن سيرين قال: "نبءت ان عمر بن الخطاب كان في قوم وهو يقرا فقام لحاجته، ثم رجع، وهو يقرا، فقال: له رجل لم لا تتوضا يا امير المءمنين وانت تقرا؟ فقال عمر: من افتاك بهذا؟ امسيلمة؟ " "مالك عب وابو عبيد في فضاءل القران وابن سعد وابن جرير".
    
 عن عمر قال: "اني لاحب ان انظر الي القارء ابيض الثياب". "مالك".
    
 عن عامر الشعبي قال: "كتب رجل مصحفا، وكتب عند كل اية تفسيرها فدعا به عمر فقرضه بالمقراضين". "ش".
    
 عن حارثة بن مضرب قال: "كتب الينا عمر ان تعلموا سورة النساء والاحزاب والنور". "ابو عبيد".
 
    
 عن عمر قال: "اقرءوا القران ما اتفقت عليه قلوبكم فاذا اختلفتم فيه فقوموا عنه" "ابو عبيد
 هب".
    
 عن ابن عباس قال: "كان عمر بن الخطاب اذا دخل البيت نشر المصحف فقرا فيه". "ابن ابي داود".
    
 عن عمر قال: "اذا قام احدكم من الليل فاستعجم عليه القران فلينم". "مسدد".
    
 "عثمان رضي الله عنه" عن عثمان قال: "ما احب ان ياتي علي يوم ولا ليلة الا انظر في كتاب الله، يعني القراءة في المصحف". "حم في الزهد كر".
    
 "علي رضي الله عنه" عن علي قال "نهي رسول الله صلي الله عليه وسلم ان يجهر القوم بعضهم علي بعض بين المغرب والعشاء بالقران". "حم".
    
 عن علي قال: "كان ابو بكر يخافت بصوته اذا قرا القران، وكان عمر يجهر بقراءته، وكان عمار اذا قرا ياخذ من هذه السورة وهذه فذكر ذلك للنبي صلي الله عليه وسلم فقال لابي بكر لم تخافت؟ قال اني لاسمع من اناجي، وقال لعمر لم تجهر بقراءتك؟ قال افزع الشيطان واوقظ الوسنان، وقال لعمار: لم تاخذ من هذه السورة وهذه؟ قال
 
 اتسمعني اخلط به ما ليس منه؟ قال لا قال فكله طيب". "حم والشاشي وسمويه هب ص".
    
 عن علي قال: "نهي رسول الله صلي الله عليه وسلم ان يرفع الرجل صوته بالقراءة قبل العتمة وبعدها، يغلط اصحابه في الصلاة وفي لفظ يغلط اصحابه والقوم يصلون". "ش حم وابو عبيد في فضاءله ومسدد ع والدورقي ص".
    
 عن عيسي بن عمر عن ابيه قال: "قرا علي بن ابي طالب في الصلاة ب {سبح اسم ربك} ، ثم قال: سبحان ربي الاعلي، فلما انقضت الصلاة قيل له يا امير المءمنين اتريد هذا في القران؟ قال: ما هو، قال سبحان ربي الاعلي، قال لا انما امرنا بشء فقلته". "ابن الانباري في المصاحف".
    
 عن علي قال: "ان افواهكم طرق القران فطيبوها بالسواك".
    
 عن عبد خير قال: "سمعت عليا قرا في صلاته. {سبح اسم ربك الاعلي} ثم قال سبحان ربي الاعلي". "عب والفريابي ش وابو عبيد في فضاءله وعبد بن حميد". 
    
 عن علي "ان رسول الله صلي الله عليه وسلم سءل عن قول الله تعالي: {ورتل القران ترتيلا} قال: بينه تبينا، ولا تهذه هذ الشعر قفوا عند عجاءبه، وجرحوا" به القلوب، ولا يكن هم احدكم اخر السورة". "العسكري".
    
 عن حجر بن قيس المدري، قال: "بت عند علي بن ابي طالب فسمعته وهو يصلي من الليل يقرا هذه الاية {افرايتم ما تمنون اانتم تخلقونه ام نحن الخالقون} قال بل انت يا رب ثلاثا، ثم قرا: {افرايتم ما تحرثون اانتم تزرعونه ام نحن الزارعون} قال بل انت يا رب ثلاثا ثم قرا: {افرايتم الماء الذي تشربون اانتم انزلتموه من المزن ام نحن المنزلون} قال بل انت يا رب ثلاثا، ثم قرا {افرايتم النار التي تورون اانتم انشاتم شجرتها ام نحن المنشءون} قال بل انت يا رب ثلاثا". "عب وابو عبيد في فضاءله وابن المنذر ك ق".
    
 "ابي بن كعب" عن عبد الكريم بن امية ان ابي بن كعب كان يفتتح ببسم الله الرحمن الرحيم.
 "عب". 
    
 عن ابي بن كعب قال: "اما انا فاقرا القران في ثلاث ليال". "ابن سعد كر".
    
 عن ابي بن كعب وعن رجل من ال الحكم بن ابي العاص "ان النبي صلي الله عليه وسلم صلي بالناس، فقرا سورة فاغفل منها اية فسالهم هل تركت شيءا، فسكتوا فقال: ما بال اقوام يقرا عليهم كتاب الله لا يدرون ما قرء عليهم فيه، ولا ما ترك، هكذا كانت بنو اسراءيل، خرجت خشية الله من قلوبهم، فغابت قلوبهم، وشهدت ابدانهم الا وان الله عز وجل لا يقبل من احد عملا حتي يشهد بقلبه ما شهد ببدنه ". "الديلمي".
    
 "انس" عن عبد الله بن ابي بكر ان زيادا النميري "جاء مع القراء الي انس بن مالك فقيل له: اقرا فرفع صوته، وكان رفيع الصوت فقال انس ما هذا ما هكذا كانوا يفعلون". "ش".
    
 عن انس قال: "كان النبي صلي الله عليه وسلم اذا قام من الليل يقرا زمزم في قراءته، فقيل يا رسول الله لم لا ترفع صوتك بالقران، قال: اكره ان اوذي رفيقي واهل بيتي ". "ابن النجار".
    
 "جابر" عن جابر قال: "خرج علينا رسول الله صلي الله عليه وسلم ونحن نقرا القران، وفينا العجمي والاعرابي، فاستمع، فقال: اقرءوا
 
 فكل حسن، سياتي قوم يقيمونه كما يقيم القداح يتعجلونه، ولا يتاجلونه". "ابن النجار".
    
 "جابر بن عبد الله" بن رءاب السلمي، عن الكلبي عن ابي صالح عن ابن عباس عن جابر بن عبد الله "ان النبي صلي الله عليه وسلم قرا: {واذا سالك عبادي عني فاني قريب} الاية ثم قال: " اللهم انت امرت بالدعاء وتكفلت بالاجابة، لبيك اللهم لبيك، لا شريك لك لبيك، ان الحمد والنعمة لك والملك، لا شريك لك لبيك، اشهد انك رب واحد صمد لم يلد ولم يولد ولم يكن له كفوا احد، واشهد ان وعدك حق ولقاءك حق، والجنة حق، والنار حق، وان الساعة اتية لا ريب فيها وانك تبعث من في القبور". "سلمان".
    
 عن علقمة قال: "اتينا سلمان الفارسي، فخرج علينا من كنيف له، فقلنا له: لو توضات يا ابا عبد الله، ثم قرات علينا سورة كذا وكذا، فقال: انما قال الله {في كتاب مكنون لا يمسه الا المطهرون} وهو الذكر الذي في السماء لا يمسه الا الملاءكة ثم قرا علينا من القران ما شءنا". "عب". 
    
 عن ابن عباس سءل رسول الله صلي الله عليه وسلم: "من احسن الناس قراءة؟ قال: من اذا قرا رايت انه يخشي الله ". "خط في المتفق والمفترق" وقال: تفرد بوصله عن مسعر اسماعيل بن عمر البجلي نزيل اصبهان، ورواه غيره عن مسعر مرسلا عن طاوس لم يذكر فيه ابن عباس انتهي واسماعيل المذكور قال في المغني ضعفه غير واحد.
    
 عن ابن عباس ان رجلا قال: "يا رسول الله اي الاعمال افضل قال: عليك بالحال المرتحل، قال: ومن الحال المرتحل؟ قال صاحب القران يضرب في اوله حتي يبلغ اخره، ويضرب في اخره حتي يبلغ اوله كلما حل ارتحل ". "الرامهرمزي في الامثال". ومر: [ و  و ] .
    
 عن ابن عباس "انه كان اذا قرا النبي صلي الله عليه وسلم: {اليس ذلك بقادر علي ان يحيي الموتي} قال: سبحانك اللهم، واذا قرا {سبح اسم ربك الاعلي} قال: سبحان ربي الاعلي ". "عب".
    
 عن ابن عباس قال: "لان اقرا البقرة ارتلها احب الي من ان اهذ القران كله". "عب".
    
 "ابن عمر" عن نافع قال: "كان ابن عمر لا يقرا القران الا طاهرا". "عب".
 
    
 عن سعيد بن جبير قال سمعت ابن عباس وابن عمر قالا: "انا لنقرا من القران بعد الحدث لا
 نمس ماء" "عب".
    
 "مسند عبد الله بن عمر" عن عبد الله بن عمرو قال: "قال رسول الله صلي الله عليه وسلم: اقرا القران في شهر، فقلت اني اقوي، قال: اقرا في كل خمس وعشرين، قلت اني اقوي، قال: اقراه في عشرين، قلت اني اقوي، قال: اقراه في خمس عشرة، قلت اني اقوي، قال: اقراه في عشر، قلت اني اقوي، قال: اقراه في خمس، قلت اني اقوي قال: لا ". "كر".
    
 عن عبد الله بن عمرو "انه سال النبي صلي الله عليه وسلم، كيف اقرا القران؟ قال: اقراه في سبع ليال، فما زلت اناقصه حتي قال: اقراه في كل يوم وليلة ". "ك".
    
 عن عبد الله بن عمرو قال: "جمعت القران، فقرات به في ليلة، فقال رسول الله صلي الله عليه وسلم: اقراه في شهر، قلت يا رسول الله دعني استمتع من قوتي وشبابي، قال اقراه في عشرين، قلت يا رسول الله دعني استمتع من قوتي وشبابي، قال: اقراه في عشر، قلت يا رسول الله دعني استمتع من قوتي وشبابي، قال: اقراه في سبع ليال قلت: يا رسول الله دعني استمتع من قوتي وشبابي فابي". "ع كر".
 
    
 "ابن مسعود" عن ابن مسعود قال: "اديموا النظر في المصحف". "ابن ابي داود في المصاحف".
    
 "المغيرة بن شعبة" استاذن رجل علي رسول الله صلي الله عليه وسلم وهو بين مكة والمدينة،
 فقال: "قد فاتني الليلة حزبي من القران، واني لا اوثر عليه شيءا". "ابن ابي داود في المصاحف".
    
 "معاذ" عن عبد الرحمن بن غنم قال قلت لمعاذ: "ايقرا الجنب؟ قال: نعم ان شاء، قلت والحاءض؟ قال: نعم، قلت والنفساء؟ قال نعم، لا يدعن احد ذكر الله، ولا تلاوة كتابه علي حال: قلت فان الناس يكرهونه، قال: من كرهه انما كرهه تنزيها عنه، ومن نهي عنه فانما يقول بغير علم، ما نهي رسول الله صلي الله عليه وسلم عن شء من ذلك". "ابن جرير" وسنده ضعيف.
    
 "ابو امامة" عن ابي امامة قال: "صليت مع رسول الله صلي الله عليه وسلم بعد حجته، فكان يكثر قراءة: {لا اقسم بيوم القيامة} فاذا قال: {اليس ذلك بقادر علي ان يحيي الموتي} سمعته يقول: بلي وانا علي ذلك من الشاهدين ". "ابن النجار".
    
 عن ابي سعيد: "اعتكف رسول الله صلي الله عليه وسلم في المسجد فسمعهم يجهرون بالقراءة وهو في قبة له فكشف الستور فقال: الا ان
 
 كلكم يناجي ربه، فلا يءذ بعضكم بعضا، ولا يرفعن بعضكم علي بعض في القراءة، او قال في الصلاة". "عب".
    
 "ابو هريرة" عن ابي هريرة قال: "قال رسول الله صلي الله عليه وسلم سمعتك يا ابا بكر تخافت بالقراءة، قال: قد اسمعت من ناجيت وقال: سمعتك يا عمر تجهر بقراءتك، قال: انفر الشيطان، واوقظ الوسنان، وسمعتك يا بلال من هذه السورة، ومن هذه السورة، قال كلام طيب يجمع الله بعضه الي بعض، فقال النبي صلي الله عليه وسلم: كلكم قد اصاب ". "كر".
    
 "مراسيل سعيد بن المسيب" عن ابن المسيب قال: "مر النبي صلي الله عليه وسلم بابي بكر وهو يصلي وهو يخافت، ومر بعمر وهو يجهر ومر ببلال وهو يخلط، فاصبحوا، فاجتمعوا عنده، فقال: مررت بك يا ابا بكر وانت تخافت بقراءتك، قال اجل، بابي انت وامي اني اسمع من اناجي، قال ارفع شيءا، قال: ومررت بك يا عمر وانت تجهر بقراءتك، قال اجل بابي انت وامي اسمع الرحمن، واطرد الشيطان، واوقظ الوسنان، قال اخفض شيءا، قال: مررت بك يا بلال وانت تقرا من هذه السورة ومن هذه السورة، قال اجل بابي انت وامي اخلط الطيب بالطيب، قال: اقرا كل سورة علي نحوها ". "عب".
 
    
 "مراسيل طاووس" عن طاووس قال: "سءل النبي صلي الله عليه وسلم من احسن الناس قراءة؟ فقال: اذا سمعت قراءته رايت انه يخشي الله". "عب".
    
 "مراسيل عطاء" عن عطاء "ان النبي صلي الله عليه وسلم استمع ليلة ابا بكر، فاذا هو يخافت بالقراءة في صلاته، واستمع عمر فاذا هو يرفع صوته، واستمع بلالا فاذا هو ياخذ من هذه السورة، ومن هذه السورة فقال استمعت اليك يا ابا بكر فاذا انت تخفض صوتك، قال اخفض صوتي بنجاء ربي، قال: واستمعت اليك يا عمر فاذا انت ترفع صوتك قال انفر الشيطان، واوقظ الناءم، وقال واستمعت اليك يا بلال فاذا انت تاخذ من هذه السورة، ومن هذه السورة، قال اخلط الطيب بالطيب اجمع بعضه الي بعض، قال كل قد احسن ". "عب".
    
 "مراسيل الزهري" عن الزهري قال: "مر رسول الله صلي الله عليه وسلم بعبد الله بن حذافة وهو يصلي يجهر بصوته، فقال له النبي صلي الله عليه وسلم: لا تسمعني يا حذافة واسمع الله ". "عب".
    
 عن جابر قال، "قرا رسول الله صلي الله عليه وسلم الرحمن حتي ختمها فقال: ما لي اراكم سكوتا للجن كانوا احسن ردا منكم ما قرات عليهم هذه الاية من مرة {فباي الاء ربكما تكذبان} الا قالوا: ولا
 
 بشء من نعمك ربنا نكذب فلك الحمد". "الحسن بن سفيان". مر برقم//.
    
 "مسند قيس بن ابي صعصعة" واسمه عمرو بن زيد، عن قيس بن ابي صعصعة انه قال: "يا رسول الله في كم اقرا القران؟ قال: في كل خمس عشرة، قال فاني اجدني اقوي من ذلك، قال ففي كل جمعة قال: فاني اجدني اقوي من ذلك، فسكت وهو مغضب، ثم رجع فقال اقرا في خمس عشرة ليلة، ثم قال: يا ليتني قبلت رخصة رسول الله صلي الله عليه وسلم". "ابن منده كر".
    
 عن يحيي بن سعيد ان ابا موسي الاشعري "قرا في الجمعة {سبح اسم ربك الاعلي} فقال سبحان ربي الاعلي و {هل اتاك حديث الغاشية} ". "هب".  
