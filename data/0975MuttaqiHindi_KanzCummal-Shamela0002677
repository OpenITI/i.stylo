 عن ابي هريرة قال: رسول الله صلي الله عليه وسلم: "انما انا لكم كالوالد لولده اعلمكم اذا اتي احدكم الغاءط فلا يستقبل القبلة ولا يستدبرها، واذا استطاب فلا يستطب بيمينه"، وكان يامر بثلاثة احجار، وينهي عن الروث والرمة وهي العظم". "ص".
   
 عن عبد الرحمن بن الاسود "عن رجل من اصحاب محمد صلي الله عليه وسلم ان رجلا قال: علمكم صاحبكم كل شء حتي يوشك ان
 
 يعلمكم كيف تاتون الغاءط والبول، قال: وذلك قد امرنا ان لا نستقبل القبلة لغاءط ولا بول وان نستنجي بثلاثة احجار؛ وامرنا ان لا نستنجي بروث ولا رجيع ولا يستنجي احدنا بيمينه". "عب".
   
 عن الحسن قال: اخبرني "من راي النبي صلي الله عليه وسلم بال قاعدا ففرج حتي ظننت ان وركه  ينفك". "عب، ش، ص".
   
 عن نافع قال: "سمعت رجلا يحدث عن ابن عمر عن ابيه ان النبي صلي الله عليه وسلم نهي ان نستقبل القبلتين ببول او غاءط". "ص، ش".
   
 "مسند عاءشة" "كان النبي صلي الله عليه وسلم اذا خرج من الغاءط قال: غفرانك". "ش".
   
 عن عاءشة قالت: "مرن ازواجكن ان يغسلوا اثر الغاءط والبول فان رسول الله صلي الله عليه وسلم كان يفعله، وفي لفظ: كان يامر به". "ص، ش، طس، كر".
   
 عن معاذ عن عاءشة انها قالت: "مرن ازواجكن ان يغسلوا 
 اثر الغاءط والبول، فاني لولا ان استحيي لامرتهم بذلك". "عب، ص".
   
 عن ابن مسعود قال: "خرج رسول الله صلي الله عليه وسلم لحاجة فقال: "التمس لي ثلاثة احجار" فاتيته بحجرين وروثة، فاخذ الحجرين وطرح الروثة وقال: "انها رجس اءتني بحجر". "عب".
   
 عن ابن مسعود قال: "خرجت مع رسول الله صلي الله عليه وسلم لحاجة فقال: " اءتني بشء استنجي به ولا تقربني حاءلا  ولا رجيعا". "ش".
   
 عن الحسن قال: "كان النبي صلي الله عليه وسلم اذا بال تفاج  حتي ناوي  له". "ص".
   
 عن ابي العالية قال: "ستر بين الجن وبين عورات بني ادم 
 ان يقول الرجل: بسم الله". "ص".
   
 "مسند اسامة" ان رسول الله صلي الله عليه وسلم "نهي ان يستقبل القبلة بغاءط او ببول". "البزار، ص".
   
 عن انس قال:"كان رسول الله صلي الله عليه وسلم اذا دخل الخلاء قال: "اعوذ بالله من الخبث والخباءث". "ش".
   
 عن انس "كان رسول الله صلي الله عليه وسلم اذا دخل الكنيف قال: "بسم الله اللهم اني اعوذ بك من الخبث والخباءث". "ش، ص".
   
 عن انس "كان رسول الله صلي الله عليه وسلم يدخل الخلاء فاحمل وانا غلام نحوي اداوة وعنزة فيستنجي بالماء". "ش".
   
 عن علي "ان رسول الله صلي الله عليه وسلم كان اذا دخل الخلاء حول خاتمه في يمينه فاذا خرج وتوضا حوله في يساره".
 "ابن الجوزي في الواهيات وقال لا يصح فيه عمرو بن خالد الواسطي كذاب يضع الحديث".
 
  ذيل الخلاء
   
 عن جعفر بن محمد عن اباءه عن علي قال: "خرج النبي صلي الله عليه وسلم البراز فاخذت الركوة فخرجت في اثره". "السلمي في الاربعين".
 
   
 عن قبيصة بن ذويب قال "رايت زيد بن ثابت يبول قاءما". "عب".
   
 عن عون بن عبد الله قال: "كنا عند ابي هريرة وهم يستفتونه فقال اعرابي: اني لاراهم لو استفتوك افنيتهم في الخراءة قال: وانا افتيك يا ابن اخي انهاك عن الملاعن : قارعة الطريق، وظل الحاءط، وظل الشجرة حيث ينزل المسافر". "عب".
   
 "مسند عاءشة" "دخلت علي امراة من اليهود فقالت: ان عذاب القبر من البول، قلت كذبت، قالت: بلي انه ليقرض منه الجلد والثوب، فخرج رسول الله صلي الله عليه وسلم الي الصلاة وقد ارتفعت اصواتنا فقال: "ما هذا"؟ فاخبرته فقال: "صدقت". "ش".
   
 "مسند عبد الله بن عمر" "كان رسول الله صلي الله عليه وسلم اذا اراد 
 الحاجة برز  حتي لا يري احدا وكان لا يرفع ثوبه حتي يدنو من الارض". "ش".
   
 "ايضا" "رايت النبي صلي الله عليه وسلم جالسا يقضي حاجته متوجها نحو القبلة". "ش".
   
 "ايضا" "ارتقيت فوق سطح لنا فرايت رسول الله صلي الله عليه وسلم وهو في بيت حفصة يضرب الخلاء بين لبنتين وهو متوجه نحو بيت المقدس". "عب".
   
 عن ابن عمر قال: "ظهرت علي اجار  في بيت حفصة في ساعة لم اكن اظن احدا يخرج فيها فرايت رسول الله صلي الله عليه وسلم علي لبنتين لحاجة مستقبل بيت المقدس". "ص".
   
 عن ابن عمر"انه كان يكره ان يتغوط علي الطريق او يصلي عليها". "عب". 
   
 "مسند عبد الرحمن بن ابي قراد" "حججت مع رسول الله صلي الله عليه وسلم فذهب لحاجته فابعد". "ش".
   
 عن عطاء قال: "لا تشهد الملاءكة وانت علي الخلاء". "عب".
   
 عن ابي ظبيان قال: "رايت عليا وعليه ازار اصفر وخميصة وفي يده عنزة اتي حاءط السجن فبال قاءما حتي رغا بوله، ثم تنحي فتوضا ثلاثا، ومسح علي نعليه وقدميه، ثم اخذ كفا من ماء فصبه علي صلعته فرايت الماء متحادرا علي منكبيه ثم دخل المسجد فخلع نعليه ثم صلي". "ص".
   
 عن ابن سيرين قال: "خرج علي من الخلاء يشرب ماء قبل ان يتوضا وقال: اطهر بطني اولا". "ص".
 
  الاستنجاء
   
 عن عبد الرحمن بن ابي ليلي قال: "رايت عمر بن الخطاب بال، ثم مسح ذكره بالتراب، ثم التفت الينا فقال: هكذا علمنا". "طس، حل".
 
   
 عن زيد بن وهب قال: "رايت عمر بن الخطاب يبول قاءما ففرج حتي رحمته". "عب".
   
 عن عبد الرحمن بن ابي ليلي قال: "كان عمر بن الخطاب يبول ثم يمسح ذكره بحجر او بغيره، ثم اذا توضا لم يمس ذكره الماء". "عب".
   
 عن الزهري ان عمر بن الخطاب "اتي الغاءط ثم استطاب بالماء بين راحلتين، فجعل اصحاب رسول الله صلي الله عليه وسلم يضحكون ويقولون: توضا كما توضا المراة". "عب".
   
 عن مولي عمر يسار بن نمير قال: "كان عمر اذا بال قال: ناولني شيءا استنجي به فاناوله العود والحجر او ياتي حاءطا يتمسح او يمسه الارض ولم يكن يغسله". "الترفقي".
   
 عن الحكم ان عمر بن الخطاب "كان له حجر او عظم في جحر في حاءط في مكان، فكان ياتيه فيبول فيه، ثم يمسحه بذلك الحجر او بذلك العظم، ثم يتوضا وما يمسه ماء". "ص".
   
 عن عثمان بن عبد الرحمن التيمي قال: "رايت عمر بن الخطاب بالبادية وهو يستنجي من الغاءط بالماء". "ص".
 
   
 عن ابي ظبيان قال: "رايت عليا بال وهو قاءم، ثم دعا بماء فتوضا ومسح علي خفيه، ثم دخل المسجد فصلي". "عب ومسدد والطحاوي، ش".
   
 عن عمر قال: "البول قاءما احصن للدبر، والبول جالسا ارخي للدبر". "عب".
   
 عن عثمان بن عبد الرحمن "ان اباه حدثه انه سمع عمر بن الخطاب يتوضا بالماء وضوءا لما تحت ازاره". "عب وابن وهب".
   
 "مسند علي" عن النخعي "ان عليا بال ثم توضا فقام يصلي، وما مس ذكره". "عب، هب".
   
 عن خزيمة بن ثابت قال: "قال النبي صلي الله عليه وسلم في الاستطابة ثلاثة احجار ليس فيها رجيع". "ش".
   
 عن عبد الله بن الزبير انه راي رجلا يغسل عنه اثر الغاءط فقال: ما كنا نفعله. "ش، ص".
   
 عن مجاهد قال: "غسل الدبر من الفطرة". "ص".
   
 "مسند علي" عن ابراهيم "ان سعد بن ابي وقاص راي رجلا
 
 يغسل ذكره فقال: لا تلحقوا في دينكم ما ليس منه يري احدكم ان حقا عليه يغسل ذكره اذا بال وان تركه جفاء". "عب. ص".
   
 "مسند ازداد ابي عيسي" عن عيسي بن ازداد  وقال خ: لا صحبة له عن ابيه قال: "كان رسول الله صلي الله عليه وسلم اذا بال نتر ذكره ثلاث مرات". "ابو نعيم".
   
 عن عبد الملك بن عمير قال: قال علي: "ان من كان قبلكم كانوا يبعرون بعرا وانتم تثلطون ثلطا  فاتبعوا الحجارة بالماء". "عب، ص".
   
 عن انس ان رسول الله صلي الله عليه وسلم "استنجي بالماء". "ص".
   
 "ايضا" عن يحيي بن ابي كثير قال: "كان انس بن مالك 
 يستنجي بالحرير". "ص".
 
  ازالة النجاسة وذكر بعض انواعها
   
 عن زيد بن وهب قال: "غزونا اذربيجان في امارة عمر وفينا يومءذ الزبير بن العوام فجاءنا كتاب عمر بلغني انكم في ارض يخالط طعامها الميتة ولباسها المتيية فلا تاكلوا الا ما كان ذكيا، ولا تلبسوا الا ما كان ذكيا". "ابن سعد" 
   
 عن ابي عثمان والربيع او ابي حارثة قال: "بلغ عمر ان خالد بن الوليد دخل الحمام فتدلك بعد النورة بخبز عصفر معجون بخمر، فكتب اليه: بلغني انك تدلكت بخمر، وانه قد حرم ظاهر الخمر وباطنها، وقد حرم مس الخمر كما حرم شربها، فلا تمسوها اجسامكم فانها نجس". "كر".
   
 عن سلمان بن موسي "ان عمر كتب الي خالد بن الوليد: انه بلغني انك دخلت حماما بالشام، وان من بها من الاعاجم اتخذوا 
 لكم دلوكا  عجن بخمر واني اظنكم ال المغيرة ذراء  النار."ابو عبيدة في الغريب".
   
 عن ابن عمر "ان عمر كان ينهي ان يصبغ العصب بالبول". "ق".
   
 عن سليمان بن موسي قال: "لما افتتح خالد بن الوليد الشام نزل امد  فاعد له من بها من الاعاجم الحمام ودلوكا عجن بالخمر، وكان لعمر عيونا من جيوشه يكتبون اليه بالاخبار، فكتبوا اليه بذلك، فكتب اليه عمر ان الله حرم الخمر علي بطونكم واشعاركم وابشاركم". "ص".
   
 عن عمر انه بلغه "ان خالد بن الوليد دخل الحمام فتدلك بعد النورة بخبز عصفر معجون بخمر، فكتب اليه عمر: انه بلغني انك 
 تدلكت بخمر، فان الله قد حرم ظاهر الخمر وباطنها، وحرم ظاهر الاثم وباطنه وقد حرم مس الخمر الا ان الغسل حرام كما حرم شربها فلا تمسوها اجسادكم، فانها نجس وان فعلتم فلا تعودوا فكتب اليه خالد: انا قد قتلناها فعادت غسولا غير خمر فكتب اليه عمر اني لاظن ال المغيرة قد ابتلوا بالجفاء فلا اماتكم الله عليه فانتهي لذلك". "سيف، كر".
   
 عن علي قال: "يغسل بول الجارية وينضح بول الصبي". 
   
 "مسند ابي سعيد" "سءل النبي صلي الله عليه وسلم عن الفارة تقع في السمن قال: "ان كان جامدا فالقوه وما حولها، وان كان ماءعا فلا تقربوه". "عب".
   
 "مسند ابي ليلي" "كنا عند النبي صلي الله عليه وسلم جلوسا والحسن ابن علي يحبو حتي جلس علي صدره فبال عليه فابتدرناه لناخذه فقال النبي صلي الله عليه وسلم "ابني ابني" ثم دعا بماء فصبه عليه". "ش".
   
 "مسند ابي هريرة" "دخل اعرابي المسجد ورسول الله 
 صلي الله عليه وسلم فيه فبال فامر بسجل  من ماء فافرغ علي بوله". "ش".
   
 "مسند ابي هريرة" "سءل النبي صلي الله عليه وسلم عن الفارة تقع في السمن قال: "اذا كان جامدا فالقوه وما حولها، وان كان ماءعا فلا تقربوه". "عب".
   
 عن ابن عباس "في بول الصبي يصب عليه مثله من الماء كذلك صنع رسول الله صلي الله عليه وسلم ببول الحسن بن علي". "عب".
   
 عن اسماء بنت ابي بكر قالت: "سءل النبي صلي الله عليه وسلم عن دم الحيض يكون في الثوب فقال: حتيه ثم اقرصيه بالماء واغسليه وصلي فيه". "الشافعي، ص، عب، ش، ن، حب، هق".
   
 عن زينب بنت جحش قالت: "كان رسول الله صلي الله عليه وسلم ناءما في بيتي فجاء حسين بن علي يدرج، فخشيت ان يوقظه فعللته بشء ثم غفلت فقعد علي بطن النبي صلي الله عليه وسلم، ووضع طرف ذكره في سرة رسول الله صلي الله عليه وسلم فبال فيها ففزعت لذلك فقال رسول الله صلي الله عليه وسلم: "هاتي ماء" فصببته عليه، ثم قال: "ينضح بول الغلام ويغسل من بول 
 الجارية". "عب".
   
 عن عاءشة قالت: "سالت رسول الله صلي الله عليه وسلم عن الرجل يطا في نعليه الاذي قال: "التراب له طهور". "عب".
   
 عن عاءشة قالت: "كانت احدانا تحيض فيكون في ثوبها الدم فتحته بالحجر او بالعود او بالعظم ثم ترشه وتصلي". "عب".
   
 عن عاءشة قالت: "كانت احدانا تغسل دم الحيضة بريقها تقرصه بظفرها". "عب".
   
 عن عكرمة قال: "جاء رجل الي ابن عباس فقال: ما تقول في جرة من سمن وقعت فيها فارة فماتت؟ فقال ابن عباس: ان كان ماءعا فاستسرجوا به وان كان جامدا فالقوها وما حولها ثم شانكم بالبقية". "ابن جرير".
   
 عن عاءشة قالت: "بال ابن الزبير علي النبي صلي الله عليه وسلم فاخذته اخذا عنيفا فقال: "دعوه فانه لم يطعم الطعام ولا يضر بوله". "ابن النجار".
   
 عن عاءشة قالت:" اتي رسول الله صلي الله عليه وسلم بصبي فبال عليه فاتبعه الماء ولم يغسله". "ز".
 
   
 عن عاءشة انها "سءلت عن دم الحيضة يغسل بالماء فلا يذهب اثره قالت جعل الله الماء طهورا". "عب".
   
 عن عاءشة قالت: "تغسله بالماء فقيل لها: لا يذهب اثره، قالت: فتلطخه بزعفران". "عب".
   
 عن ابن عمر "ان فارة وقعت في زيت فقال: استسرجوا به وادهنوا به الادم  "عب".
   
 "مسند ام سلمة" "كنت اطيل ذيلي فامر بالمكان القذر والمكان الطيب فدخلت علي ام سلمة، فسالتها فقالت ام سلمة: سمعت رسول الله صلي الله عليه وسلم يقول: "يطهره ما بعده". "ش".
   
 عن الحسن عن امه قالت: "رايت ام سلمة تغسل بول الجارية ما كانت ولا تغسل بول الغلام حتي يطعم تصب عليه الماء صبا". "ص".
   
 عن ام الفضل قالت: "بال الحسين بن علي في جحر النبي صلي الله عليه وسلم فقلت له: يا رسول الله اعطني ثوبك والبس ثوبا غيره حتي اغسله فقال: 
 "انما ينضح من بول الذكر، ويغسل من بول الانثي". "ص، ش".
   
 عن موسي بن عبد الله بن يزيد عن امراة من بني عبد الاشهل "انها سالت النبي صلي الله عليه وسلم ان بيني وبين المسجد طريقا قذرا قال: "فبعدها طريق انظف منها"؟ قالت: نعم قال: "هذه بهذه". "عب، ش".
   
 عن ابي مجلز عن فتي من ال علي اما ابن الحسن بن علي واما ابن الحسين بن علي قال: حدثتنا امراة من اهلنا قالت: "بينا رسول الله صلي الله عليه وسلم مستلقيا علي ظهره يلاعب صبيا علي صدره اذ بال فقامت لتاخذه فقال: "دعيه اءتني بكوز من ماء، فاتيته بكوز من ماء، فنضح الماء علي البول حتي تقايض  الماء علي البول وقال: هكذا يصنع بالبول من الذكر ويغسل من الانثي". "ص".
   
 "مسند ام قيس بنت محصن" عن ام قيس "سالت رسول الله صلي الله عليه وسلم عن دم الحيضة يصيب الثوب فقال: "اغسليه بماء وسدر وحكيه بضلع". "عب".
   
 "مسند ام قيس ابنة محصن الاسدية" عن ام قيس قالت: 
 "دخلت بابن لي علي رسول الله صلي الله عليه وسلم لم ياكل الطعام فبال عليه، فدعا بماء فرشه". "ص، ش".
   
