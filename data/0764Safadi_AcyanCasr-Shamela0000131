 وهءلاء ال فضل هم جمهرة العرب، وجمهرة الحرب والحرب، وسحب السماح اذا جر الكرم ذيله وانسحب.
 ومهنا جده: هو الامير مانع بن حديثة بن فضل بن ربيعة الطاءي الشامي التدمري، كان امير عرب الشام في دولة طغتكين صاحب دمشق، ولم يصرح لاحد من هذا البيت بامرة علي العرب بتقليد من السلطان الا من ايام العادل الكبير ابي بكر اخي السلطان صلاح الدين، امر منهم حديثة، ثم ان ابنه الكامل قسم الامرة نصفين لمانع بن حديثة ولغنام ابي طاهر بن غنام، ثم ان الامرة انتقلت الي ابي بكر بن علي بن حديثة، وعلا فيها قدره، وبعد صيته.
 ولما كان من البحرية ما كان، ساقت تصاريف الدهر الملك الظاهر بيبرس الي بيوتهم وهو طريد شريد، ولم يكن معه سوي فرس واحد يعول عليه، فسال علي بن حديثة فرسا يركبه فلم يعطه شيءا، وكان ذلك بمحضر من عيسي بن مهنا، فاخذه عيسي اليه، وضمه واواه واكرمه وقراه، وخيره في رباط خيله، فاختار منها فرسا، فاعطاه ذلك وزوده، وبالغ في الاحسان اليه، فعرفها الظاهر له، ولما تسلطن الظاهر، انتزع الامرة من ابي بكر بن علي، وجعلها لعيسي بن مهنا، واتاه احمد بن طاهر بن غنام وساله ان يشركه معه في الامرة، فارضاه بان يعطيه امرة ببوق،

 وبقي ابو بكر بن علي شردا طريدا، تارة بنجد، وتارة باطراف الشام الي ان مات. وامنه الملك الظاهر غير مرة وحلف له فما وثق به واطمان اليه.
 وعلت درجة عيسي بن مهنا عند الظاهر ولم يزل معظما الي ان مات.
 ثم ان الامرة صارت لولده الامير حسام الدين مهنا هذا في ايام الملك المنصور قلاوون، وعلت مكانته اكثر من مكانة ابيه.
 قال شيخنا شهاب الدين محمود: حضرت طرنطاي المنصوري، وهو مخيم بالخربة، وقد حضره احمد بن حجي امير ال مري يدعي بالف بعير اخذتها ال فضل لعربه، ومهنا حاضر، وكل منهما جالس الي جانب من طرنطاي فالح احمد بن حجي في المطالبة واحتد وارتفع صوته، ومهنا ساكت لا يتكلم، فلما طال تمادي احمد في الضجيج وتمادي مهنا في السكوت، اقبل طرنطاي علي مهنا وقال: ما تقول يا ملك العرب، فقال: وما اقول؟ نعطيهم ما طلبوا، هم اولاد عمنا، وان كانت لهم عندنا هذه البعيرات، اعطيناهم حقهم، وان كان ما لهم شء، فما هو كثير اذا اعطينا بني عمنا من مالنا. فقال احمد: الا قل، تكلم، وزاد في هذا ومثله، ومهنا ساكت، فلما زاد، رفع مهنا راسه اليه وقال: يا احمد: ان كان كلامك عليك هينا فكلامي انا علي ما هو هين، وهذه الاباعر اقل من ان يحصل فيها كلام، وانا اعطيك اياها. ثم قام فقال طرنطاي، هكذا والله يكون الامير.
 ولم يزل مهنا علي امرته الي ان جاءت الدولة الاشرفية. ولما خرج الاشرف لفتح قلعة الروم مرت العساكر بسرمين اقطاع مهنا، فاكلت زروعها واذت اهلها، فشكوا

 الي مهنا اذية العساكر، فشكا الي الاشرف، فعز علي الاشرف، واستنقص همته وقال: كم جهد ما اوذوا حتي تواجهني بالشكوي، وما كان يغتفر هذا الفعل لهذا الجيش العظيم الخارج لاجل اذلال العدو وقص جناح الكفر. واسمعه من هذا ومثله، ثم لما كان الفتح ركب الاشرف في الفرات في خواصه، ومعه جلساءه من بني مهدي وكانوا يضحكونه، فجاء مهنا بن عيسي فامر بمد الاسقالة له ليدخل، فلما دخل عليها غمز عليه فحركت الاسقالة فوقع في الماء وتلوث بالطين، فهزات به بنو مهدي، وضحك الاشرف ومن حوله، وطوي مهنا جوانحه علي المها، ثم انه استاذن في الانصراف الي بيوته، فاذن له وقال: الي لعنة الله، فاسرها مهنا في نفسه ولم يبدها، وركب من وقته وتوجه الي اهله واقام عندهم علي حذر، ثم لما عاد الاشرف ونزل بحماة، بعث اليه مهنا بخيل وجمال، فقبلها وخلع علي رسوله وبعث اليه خلعة سنية ليطمءنه بذلك ثم يكسبه، فلما جاءت اليه، لبسها اظهارا للطاعة، وارتحل لوقته ضاربا وجه البرية، فلم يتم للاشرف ما اراده منه. وعاد الي مصر وفي نفسه من امساك مهنا واخوته وبنيه. وظن مهنا ان لا حقد عنده، فلم يلبث الاشرف ان خرج الي الكرك وخرج منها علي انه يتصيد كباش الجبل، فعمل له مهنا ضيافة عظيمة، فحضرها الاشرف واكل منها، ولما فرغ من ذلك امسك مهنا ومعه جماعة، وجهزهم الي مصر وحبسهم في برج القلعة، وضيق عليهم الا في الراتب لهم.
 وكان مهنا في الحبس لا ياكل الا بعد مدة، واذا اكل اكل ما يقيم رمقه، ويصلي الصبح، ويدير وجهه الي الحاءط ويصمت ولا يكلم احدا حتي تطلع الشمس، ثم يقوم بعجلة وسرعة وياخذ كفا من حصي وتراب كان هناك، ثم يزمجر ويرمي به الي الحاءط كالاسد الصاءل. فلما خرج الاشرف الي الصيد، ترك ذلك الفعل، فقيل له في ذلك، فقال: قضي الامر، ولم ير منبسطا الا في ذلك الحين.

 قال القاضي شهاب الدين احمد بن فضل الله: حدثني الامير مظفر الدين موسي بن مهنا قال: لما كنا في الاعتقال كان عمي محمد بن عيسي مغري بدخول المرتفق والتطويل فيه، وكان المرتفق مقاربا لدور حريم السلطان او لبعض الامراء، فقلت له في ذلك فقال: يا ولد مهنا، لعلي اسمع خبرا من النسوان، فانهن يتحدثن بما لا يتحدث به الرجال. فبينما نحن ذات يوم، وانما بمحمد قد خرج وقال بشراكم، قد سمعت صاءحة النساء تقول: واسلطاناه، فقلنا له: دعنا مما تقول، فقال: هو ما اقول لكم. وكان لنا صاحب من العرب تنكر واقام بمصر، وكان يقف قبالة مرمي البرج الذي نحن فيه ويومء الينا ونومء اليه، غير انه لا يسمعنا ولا نسمعه، فلما كنا في تلك الساعة ومحمد يحدثنا، واذا بصاحبنا قد جاء واوما ثم مد يده الي التراب وصنع فيه هيءة قبر ونصب عليه عودا، عليه خرقة صفراء كانها صنجق سلطاني ثم نكسها وقعد كانه يبكي، ثم وقف قاءما ورقص، فتاكد الخبر عندنا بموت الاشرف. فلما فتح علينا من الغد سالنا الفتاح والسجانين فانكروا، ثم اعترف لنا بعضهم، فكان ذلك اعظم سرور دخل علي قلبنا.
 ولما خرجوا من السجن شكوا احتياجهم الي النساء، فاطلق لهم جماعة من الجواري الاشرفيات، ولم يكن مرادهم بذلك الا التشفي، واعيد الجماعة الي اهلهم الا مهنا، فانه اخر مدة ثم جهز، ولما خرج من دمشق لحقه البريد من دمشق الي ثنية العقاب بان يعود، فامتنع وتوجه الي اهله، وكانوا قد ندموا علي اطلاقه، ثم انه قدم مصر بعد ذلك مرات وهو كالطاءر الحذر الذي نصبت له الاشراك في كل مكان، واخر مرة قدمها في اواءل الدولة الناصرية الاخيرة سنة عشر وسبع مءة، وكان بلرلغي الكبير مملوك مهنا وهو الذي قدمه، فلما وجده قد امسك تحدث فيه مع السلطان، وقال هذا مملوكي وقدمته ليعطي اقطاعا في الحلقة فاعطي فوق حقه حتي جعلتموه ملكا من الملوك، وانا اريد ان تاخذ كل ماله ومماليكه وتعطيه اياه برقبته ليكون عندي الي ان

 يموت، فوعد بذلك. ثم ان بلرلغي مات في ذلك الوقت، فقيل له: قد مات، فعز ذلك عليه من عدم قبول شفاعته مع ما كان يمت به من سوابق الخدم للسلطان لما كان في الكرك.
 وخرج مهنا وقد طار خوفا ورعبا، ولما اجتمع بقراسنقر، وكانت بينهما صداقة مءكدة قديمة، وكل منهما مستوحش، فجددا الايمان والعهود علي المضافرة، وان لا يسلم واحد منهما صاحبه. ولما توجه قراسنقر الي حلب زاره مهنا وخلا به، فاراه قراسنقر كتابا من السلطان اليه فيه اعمال الحيلة علي امساك مهنا، فقال له مهنا: فما انت صانع، قال: انا اطيعه فيك واجاهره، وهو يجعلني وكده ودابه، فمن يحميني منه ان قصدني، قال له مهنا تجء الينا. فتحالفا علي ذلك. ثم ان مهنا وفي لقراسنقر لما توجه اليه  علي ما مر في ترجمة قراسنقر واجاره.
 واما زوجة مهنا عاءشة بنت عساف، فانها بالغت في خدمة قراسنقر، وكانت تقول لمهنا: يا مهنا، ذكر الدهر، لا تدعه. وكذلك محمد بن عيسي بن علي الافضل بن عيسي بن مهنا اخو مهنا، فما كان رايه الا التقرب بامساك قراسنقر والجماعة الي السلطان، فكانت عاءشة تقول: تعسا لام ولدت الفضل بن مهنا. وكتب مهنا الي السلطان يستعطفه ويقول: هءلاء مماليكك ومماليك ابيك وكبار بيتكم، وقد هربوا من الموت، وسالوا ان تكف عنهم وتهبهم البيرة لقراسنقر، الرحبة للافرم، وبهسنا للزردكاش، واذا حصل مهم جامع للاسلام حضروا اليه وجاهدوا بين يديك، علي ما مر في ترجمة قراسنقر.
 وما اطمانوا، وجهزهم مهنا الي خربندا وقال له: متي حميت هءلاء كنت انا في

 طاعتك وخفرت الركب العراقي، وسيرهم مع ابنه سليمان، وجهز معهم لخربندا ومن حوله خيولا مسومة من جهته، فقوبلوا بالاكرام والرعاية، وخلع علي سليمان، واطلق له اموالا جمة، وجهزت لمهنا خلع وانعامات وبرالغ بالبصرة له ولاهله، ومعها الحلة والكوفة وساءر البلاد الفراتية، واشتدت الوحشة بينه وبين السلطان الملك الناصر محمد، فاعطي الامرة لاخيه فضل، وتظاهر مهنا بالمنافرة والمباينة والوحشة، وحضر الي خربندا، فاكرمه غاية الاكرام واجله نهاية الاجلال، وقرر امر الركب العراقي، واعطي عصاه خفارة لهم وتامينا، وضاع الزمان وامتدت الايام والليالي في المراوغة من مهنا، وهو يعد السلطان انه يحضر اليه ويمنيه ويسوف به من وقت الي وقت، والبريد يروح ويجء، والرسل تتردد مثل الامير بهاء الدين ارسلان الدواردار والامير علاء الدين الطنبغا ناءب حلب والشيخ صدر الدين بن الوكيل، وما الوي ولا عاج، ثم كان اولاده واخوته يتناوبون الحضور الي السلطان وهو ينعم عليهم بمءين الوف وبالاقطاعات العظيمة والاملاك، وهم يمنونه حضوره ويعدونه بقدومه، ومهنا لا يزداد الا حذرا. والسلطان لا يزداد الا طمعا في حضوره، ومع ذلك في هذه المدة جميعها ما تنقطع المراسلات بينهما والمكاتبات والشفاعات، واذا ظهرت للمسلمين مصلحة نبه مهنا عليها واشار اليها، وكان السلطان يقبل نصحه.
 ثم لما كان سنة اربع وثلاثين وسبع مءة، توجه مهنا بنفسه من ذاته الي السلطان، ووصل الي دمشق يوم الجمعة رابع ذي الحجة من السنة، ودخل الديار المصرية، فاكرمه السلطان غاية الاكرام وانعم عليه بانعامات كثيرة الي الغاية. وعاد مهنا راجعا الي بلاده، وكان دخوله قلعة الجبل نهار الاحد عشري الحجة، وعاد الي دمشق فدخلها

 سادس المحرم سنة خمس وثلاثين وسبع مءة. ولم يزل بعد ذلك الي ان توفي في التاريخ المذكور.
 وله من الاولاد جماعة، وهم: موسي وسليمان واحمد وفياض وحمام وهيازع وحيار وجويف وقارا وشعبه وتوبلة وعنقا.
 ومن سيادة مهنا ما حكاه لي زغبان بن عبد المءمن الشقاري التدمري حاجب الامير معيقل بن فضل يومءذ، قال: كان قد دفن الامير فضل دفينا في الارض من الذهب مبلغه اثنا عشر الف دينار، ثم انه طلبه في وقت ولم يجده في المكان الذي دفنه، وانه اتهم به محمد بن نجام حاجبه، ولم يذكر له ذلك، وان ابن نجام بلغه ذلك، فخاف ابن نجام من الامير فضل، وتوجه الي مهنا، وشكا حاله اليه فاعطاه مهنا اثني عشر الف دينار، فاخذها ابن نجام واحضرها الي فضل، فابي ان ياخذها، وقال: ما مهنا اكرم مني، انا ما طالبتك بها ولا اخذها، فردها ابن نجام علي مهنا، فقال: انا خرجت عنها وهي لك، ولم ياخذها.
