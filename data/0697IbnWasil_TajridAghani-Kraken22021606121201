 الجزء الثاني من القسبم الاول من تجريد الاغاني وكان رسول الله صلي الله عليه وسلم يقول : اللهم لا يعجزنك يعني ابا جهل  فكان اول من لقيه معاذ بن عمرو بن الجموح . قال معاذ : فسمعت القوم ، وابو جهل في مثل الحرجة، وهم يقولون : ابو الحكم لا يخلص اليه ! فلما سمعتها جعلتها من شاني، فعمدت نحوه. فلما امكنني حملت عليه، فضربته ضربة اطنت () قدمه بنصف ساقه . فوالله ما شبهتها حين طاحت الا كالنواة تطيح من تحت مرضخة () النوي حين يضرب بها . قال : وضربني ابنه عكرمة علي عاتقي فطرح يدي فتعلقت بجلدة من جنبي . واجهضني القتال عنها . ولقد قاتلت عامة يومي واني لاسحبها خلفي ، فلما اذتني جعلت عليها رجلي ثم تمطيت بها حتي طرحتها. ثم عاش معاذ بعد ذلك حتي مات في خلافة عمان رضي الله عنه .
 ثم مر بابي جهل ، وهو عقير()، معوذ بن عفراء فضر به حتي اثبته، وتركه وبه رمق . وقاتل معوذ حتي قتل . ومر عبد الله بن مسعود رضي الله عته بابي جهل ، وقد امر رسول الله صلي الله عليه وسلم ان يلتمس في القتلي وقال : انظروا ان خفي عليكم في القتلي الي اثر جرح بركبته ، فاني ازدحمت انا وهو يوما علي مادبة لعبد الله بن جذعان ، ونحن غلامان، وكنت اشب منه ييسير، فدفعته فوقع علي ركبته فجحش () في احداهما جخشا لم يزل به اثره فيها بعد .
 فقال عبد الله بن مسعود : فوجدته باخر رمق فعرفته، فوضعت رجلي علي عنقه، وقدكان ضبث() بي مرة بمكة ولكزني ، ثم قلت : هل اخزاك الله يا عدو الله؟
 بري قال : وبماذا اخزاني ! اعمد( من رجل قتلتموه ا لمن الدبرة ؟قلت : لله ولرسوله .
 () اطنت : قطمت () المرضخة: حجر يرضخ به النوي . () العقير: الجريع.
 () جش : خدش . والرواية في بعضن اصول الاغاني : وخدش ... خدشا.
 () ضبث بالشء : قبض عليه بكفه.
 () اعمد : اعجب . يريد : هل زاد علي سيد قتله قومه ! وهل كان الا هذا ! اي ان هذا ليس بعار


 ============================================================
 غزوة بدر وقيل: انه قال له ابو جهل : رويعي غنم ! لقد ارتقيت مرتقي صعها : ثم قال : احتززت راسه ثم جءت به الي رسول الله صلي الله عليه وسلم وقلت : يا رسول الله، هذا راس عدو الله ابي جهل . فقال له رسول الله صلي الله عليه وسلم : الله الذي لا اله غيره ! وكانت هذه يمين رسول الله صلي الله عليه وسلم . فقلت : نعم ، والله الذي لا اله غيره. ثم القيت راسه بين يدي رسول الله صلي الله عليه وسلم .
 فحمد الله جل وعز وقال رسول الله صلي الله عليه وسلم لاصحابه يومءذ : اني عرفت ان رجالا من بني هاشم قد اخرجوا كرها لا حاجة لهم بقتالنا ، فمن لقي منكم احدا من بني هاشم فلا يقتله ، ومن لقي العباس بن عبد المطلب فلا يقتله ، فانه انما اخرج مستكرها . فقال ابو حذيفة بن عتبة بن ربيعة : انقتل اباء نا واخواننا وعشيرتنا ونترك العباس! اما والله لءن لقيته لا لجميه السيف . فبلغت رسول الله صلي الله عليه وسلم ، فجعل يقول لعمر بن الخطاب رضي الله عنه : يا ابا حفص، اما تسمع الي قول ابي حذيفة : اضرب وجه عم رسول الله ا فقال عمر : يارسول الله ، وغني فالاضرب عنقه بالسيف، فوالله لقد نافق . قال عمر : فوالله انه لاول يوم گتاني رسول الله صلي الله عليه وسلم بابي حفص . وكان ابو حذيفة رضي الله عنه يقول : ما انا بامن من تلك الكلمة التي قلت يوميذ ، ولا ازال خاءفا الي ان يكفرها الله عني . فقتل يوم اليمامة شهيدا في خلافة ابي بكر رضي الله عنه .
 ونهي رسول الله صلي الله عليه وسلم عن قتل ابي البختري . وانما نهي عن قتله لانه كان اكف الناس عن النبي صلي الله عليه وسلم وهو بمكة ، وكان لا يءذيه ولا يبلغه عنه شء يكرهه . وهو الذتي قام في نقض الصحيفة التي كتبت قريش علي بني هاشم وبني المطلب . فلقيه المجذر بن ذياد ، فقال له : ان رسول الله صلي الله عليه وسلم قد نهي عن قتلك  ومع ابي البختري زميل له خرج من مكة 


 ============================================================
 الجزء الثاني من القسم الاول من تجريد الاغاني

 قال : وزملي ا فقال المجذر : لا والله، ما نحن بتاركي زميلك ، ما امرنا رسول الله صلي الله عليه وسلم الا بك وحدك . قال : اذن والله لاموتن انا وهو جميعا ، لا تحدثت عني نساء قريش واهل () مكة اني تركت زملي جزصا علي الحياة وقال ابو البختري حين نازله المجذر وابي الا القتال، وهو يرتجز: ان يسلم ابن حرة زميله حتي يموت او يري سبيله فاقتتلا . فقتله المجذر بن ذياد . ثم اتي رسول الله صلي الله عليه وسلم فقال : والذي بعثك بالحق يا رسول الله ، لقد جهدت عليه ان يستاسر، فابي الا القتال، فقاتلته فقتلته.
 وكان امية بن خلف الجشمي يعذب بلالا بمكة علي ان يترك الاسلام ، فيخرجه الي رمضاء مكة اذا كميت فيضجعه، ثم يامر بالصخرة العظيمة فتجعل علي صدره، فيقول : لا تزال هكذا حتي تفارق دين محمد . فيقول بلال: احد ! احد!
 . فحكي عيد الرحمن بن عوف رضي الله عنه قال : كان امية بن خلف صديقا لي بمكة ، وكان اسمي عبد عمرو . فلما اسلمت شتميت : عبد الرحمن . فكان يلقاني ونحن بمكة فيقول : ياعبد عمرو، ارغبت عن اسم سماك به ابوك؟ فاقول : نعم . فيقول : اني لا اعرف عبد الرحمن، اخعل ييني وبينك شييا ادعوك به .
 اما انت فانك لاتجيبني باسمك الاول ، واما انا فلا ادعوك الا بما اعرف . وكان اذا دعاني: عبد عمرو، لا اجيبه . فقلت: اجعل بيني و بينك يا ابا علي ماشءت . قال: فانت عبد الاله . قلت : نعم . فكنت اذا مررت به قال : يا عبد الاله . فاجيه فاتحدث معه . حتي اذا كان يوم بدر مررت به ، وهو واقف مع ابنه علي بن امية اخذ بيده ، ومعي اذراع قد اشتلبتها وانا احملها ، فلما راني قال : يا عبد عمرو، () في يعض اصول الاغاني : "بين اهل " مكان " واهل"


 ============================================================
 غزوة بدر 
 فلم اجبه . فقال لي ، وانا بينه وبين ابنه اخذ بايديهما : يا عبد الاله ، من الرجل المعلم بريش النعامة في صدره ؟ قال : قلت : ذاك حمزة بن عبد المطلب . قال : الذي فعل بنا الافاعيل قال : فوالله اني لاقودهما اذ راه بلال معي، فقال بلال ،
 حين راه : راس الكفر امية بن خلف ! لا نجوت ان تجا! فقلت : يا بلال ، اباسيري ؟ قال : لا نجوت ان نجا ! قلت : اباسيري تسمع يابن الشوداء ا قال : لا نجوت ان نجا . ثم صاح باعلي صوته : راس الݣفر امية بن خلف الانجوت
 ان نجا ! قال : فاحاطوا بنا، وانا اذب عنه ، فضرب رجل ابته فوقع . وصاح امية  صيحة ما سمعت مثلها قط . فقلت : انج بنفسك ولا تجاء! فوالله ما اغني عنك شييا. فهبروهما باسيافهم حتي فرغوا منهما . فكان عبد الرحمن يقول : رحم الله بلالا، ذهب بادراعي وفجعني باسيري ثم امر رسول الله صلي الله عليه وسلم بطرح القتلي في قليب هناك، فطرحوا فيه، الا ما كان من امية بن خلف فانه انتفخ في درعه حتي ملاها ، فذهبوا ليجروه؛ فتزايل، فالقوا عليه ما غيبه من التراب والحجارة .
 ولما امر بهم النبء صلي الله عليه وسلم ان يكقوا في القليب اخذ عتبة بن ربيعة فسحب الي القليب . فنظر رسول الله صلي الله عليه وسلم الي وجه ابي حذيفة بن عتبة ، فاذا هو كثيب قد تغير . فقال رسول الله صلي الله عليه وسلم : لعلك دخلك من حال ابيك شء ؟ قال : فقلت : لا والله يا رسول الله ، ماشككت في حال ابي ولا متعترعه، ولكني كنت اعرف له رايا وفضلا وحلا، فكنت ارجو ان يهديه الله بذلك الي الاسلام، فلما رايت ما اصابه، وذكرت ماصار اليه من الݣفر بعد
 الذي كنت ارجو، احزنني ذلك . فدعا رسول الله صلي الله عليه وسلم له بخير وقال له خيرا . فلما القوا في القليب وقف رسول الله صلي الله عليه وقال : ياهل القليب، هل وجدتم ما وعد ربكم حقا، فاني وجدت ما وعدني ربي


 ============================================================
 الجزء الثاني من القسم الاول من تجريد الاغاتي حقا؟ فقال له اصحابه : يا رسول الله ، اتكام قوما موتي؟ قال : لقد علموا ان ماوعدهم ربهم حقا.
 وفي رواية : انه قال صلي الله عليه وسلم : ما اتم باسمع لما اقول منهم ، ولكنهم لا يستطيعون ان يجيبوني.
 وجمع رسول الله صلي الله عليه وسلم الاساري ، فكانوا اربعة واربعين، وكان من القتلي مثل ذلك . وكان في الاساري عقبة بن ابي معيط ، والنضربن الحارث، فضربت اعناقهما بين يديه صبرا . وقد تقدم ذكر ذلك في اخبار ابي قطيفة.
 وكان في الاساري العباس بن عبد المطلب رضي الله عنه . فروي ابن عباس قال: لما امسي القوم من يوم بدر، والاساري محبوسون في الوثاق، بات رسول الله صلي الله عليه وسلم ساهرا اول ليلة . فقال له اصحابه : يا رسول الله ، مالك لاتتام؟
 فقال : سمعت تضءر العباس في وثاقه . فقاموا الي العباس فاطلقوه . فنام رسول الله صلي الله عليه وسلم: وقال رسول الله صلي الله عليه وسلم لعته العباس، حين انتهي به الي المدينة : اقد نفسك وابني اخيك : عقيل بن ابي طالب ، ونوفل بن الحارث ، وحليفك عثبة بن عمرو بن جحدم ، فانك ذومال . فقال : يا رسول الله، اني كنت مسلما ، ولكن القوم استكرهوني . قال : الله اعلم باسلامك، ان يكن ما تقول حقا فالله يجزيك به، فاما ظاهر امرك فقد كان علينا ، فافد نفسك .
 وكان رسول الله صلي الله عليه وسلم قد اخذ منه عشرين اوقية من ذهب .
 فقال العباس : يارسول الله، احسبها لي في فداءي . قال : ذاك شء اعطاناه الله منك . قال : فانه ليس لي مال . قال : فاين المال الذي وضعته بمكة حين خرجت


 ============================================================
 زوة بدر 
 من عند ام الفضل بنت الحارث ليس معكما احد؟ ثم قلت لها : ان اصبت في سفري هذا فللقضل كذا ، ولعبد الله كذا ، ولقتم كذا ، ولعبيد الله كذا . قال : والذي بعشك بالحق ما علم بهذا احد غيري وغيرها ، واتي لاعلم انك رسول الله : قفدا نفسه وابني اخيه وحليفه.
 وقيل: اول من قدم مكة بمصاب قريش الحيسمان بن عبد الله اللخزاعي ، فقالوا : ما وراءك؟ فقال : قتل عتبة، وشيبة ، وابو الحكم، وامية بن خلف، وفلان .
 وجعل يعدد اشراف قريش . فقال صفوان بن امية، وهو قاعد في الحخر: والله ان يعقل هذا فسلوه عني . فقالوا : ما فعل صفوان بن امية ؟ قال : هو ذا جالس في الحجر ، وقد والله رايت اباه واخاه حين قتلا .
 وحدث ابو رافع مولي رسول الله صلي الله عليه وسلم قال : كنت غلاما للعباس بن عبد المطلب، وكان الاسلام قد دخلنا اهل البيت ، واسلمت ام الفضل . وكان العباس يهاب قومه ويكره ان يخالفهم ، وكان يكتم اسلامه، وكان ذا مال كثير متفرق في قومه . وكان ابو لهب عدء الله قد تخلف عن بدر وبعث مكانه العاص بن هشام بن المغيرة . وكذلك صسنعوا لم يتخلف رجل الا بعث . فلما جاء الخبرعن مصاب بدر من قريش، كبته الله فاخزاه ، ووجذنا في انفسنا قوة ومنعة وعزة ، وكنت رجلا ضعيفا اعمل القداح وانحتها في حجرة زمزم . فوالله اني لجالس فيها انحت القداح ، وعندي ام الفضل جالسة ،
 وقد سرنا ماجاء نا من الخبر، اذ اقبل الفاسق ابو لهب يجر رجليه بشر()، حتي جلس علي طنب الحجرة، وكان ظهره الي ظهري . فبينا هو جالس اذقال الناس: هذا ابو سفيان بن الحارث بن عبد للمطلب قد قدم . فقال له ابولهب : هلم الي يا بن اخي، فعندك الخبر . قال : فجلس والناس قيام عليه : فقال، يابن اخي، اخبرني () في بعض اصول الاغاني : * يسير مكان "بشر" ،


 ============================================================
  الجزء الثاني من القسم الاول من تجريد الاغاني كيف كان الناس ؟ قال : لا شء والله ، ان هو الا لقيناهم فمنحناهم اكتافنا يقتلون وياسرون كيف شاءوا . وايم الله ما لنت الناس ، لقينا رجالا بيضا علي خيل بلق بين السماء والارض ما تليق شء() ولا يقوم لها شء . قال ابو رافع : فرفعت طنب الحجرة بيدي، وقلت : تلك الملاءكة. فرفع ابو لهب يده فضرب وجهي ضربة شديدة. فساورته ، فاحتملني فضرب بي الارض وبرك علي يضربني ، وكنت رجلا ضعيفا . فقامت ام الفضل الي عمود من عمد الحجرة فضربته به ضربة فلقت راسه شجة منكرة ، وقالت: تستضعفه ان فاب سيده !
 فقام موليا ذليلا . فوالله ما عاش بعدها الا سبع ليال حتي رماه الله () بالعدسة فقتلته . فلقد تركه ابناه ليلتين او ثلاثا لم يدفناه حتي انتن في بيته  وكانت قريش تتقي العدسة كما يتقي الناس الطاعون  حتي قال لهما رجل من قريش : ويحكما ! لا تستحييان ان ابا كما قد انتن في بيته لاتغيبانه ! قالا : تخشي هذه القرحة . قال : فانطلقا وانا معكما ، فما غسلوه الا قذفا بالماء عليه من بعيد ، ما يمسونه  ثم احتملوه يذفنونه باعلي مكة علي جدار. وقذفوا عليه الحجارة حي وارءه.
 وروت عاءشة رضي الله عنها قالت : لما بعث اهل مكة في فداء اسراهم، بعشت زينب بنت رسول الله صلي الله عليه وسلم في فداء زوجها ابي العاص بن الربيع بقلادة لها . وكانت خديجة ت رضي الله عنها ادخلتها بها علي ابي العاص حين تبني بها . فلما راها رسول الله صلي الله عليه وسلم رق لها رقة شديدة وقال : ان رايتم ان تطلقوا لها اسيرها وتردوا عليها الذي لها فافعلوا . فقالوا : نعم يا رسول الله . فاطلقوه وردوا عليها الذي لها . ولما انقضت نوبة بدر ناحت قريش علي قتلاها ثم قالوا : لا تفعلوا () ما تليق شييا ، اي ما تبق علي شي، .
