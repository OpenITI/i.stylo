 بسم الله الرحمن الرحيم
 
 سمعت عن الشيخ الفقيه المشاور المحدث ابي محمد عبد الرحمن بن محمد بن عتاب رضي الله عنه في مسجده بحاضرة قرطبة حرسها الله سنة ثلاث عشرة وخمسماءة، قال: قرات علي الشيخ الفقيه ابي القاسم حاتم بن محمد بن عبد الرحمن الطرابلسي رحمه الله، قال: اخبرنا ابو الحسن علي بن محمد بن خلف القابسي، قال: اخبرنا ابو القاسم حمزة بن محمد الكناني، قال لي ابن عتاب،: واجاز لي الفقيه الحافظ ابو عمر يوسف بن عبد الله بن محمد بن عبد البر النمري، والقاضي ابو عمر احمد بن محمد بن يحيي بن الحذاء التميمي، قالا: اخبرنا ابو محمد القاضي الامام ابو علي حسين بن محمد بن فيرة الصدفي الحافظ رضي الله عنه اجازة، قال: اخبرني الشيخ ابو اسحاق ابراهيم بن سعيد بن عبد الله الحبال، رحمه الله اجازة، يلفظ لي بها في منزله بمصر، اذ كان قد امتنع من كتابة اجازة، ونقلت هذا الكتاب من كتاب قرء عليه واريت عليه خطه، اخبر به عن شيخه ابي الحسن احمد بن محمد بن القاسم بن مرزوق الانماطي، قراه عليه، قال: حدثنا ابو القاسم حمزة بن محمد بن علي بن محمد بن العباس الكناني، قراءة عليه من كتابه، وانا اسمع منه، قال: حدثنا ابو عبد الرحمن احمد بن شعيب بن علي بن سنان بن بحر النساءي، قال
  [ص: ]
    
 اخبرنا اسماعيل بن مسعود، حدثنا خالد يعني ابن الحارث، حدثنا شعبة، عن خبيب بن عبد الرحمن، قال: سمعت حفص بن عاصم يحدث عن ابي سعيد بن المعلي: ان النبي صلي الله عليه وسلم مر به وهو يصلي فدعاه قال: فصليت ثم اتيته، قال: «ما منعك ان تجيبني؟» قال: كنت اصلي، قال: " الم يقل الله عز وجل: {يا ايها الذين امنوا استجيبوا لله وللرسول اذا دعاكم لما يحييكم} [الانفال: ] الا اعلمك اعظم سورة قبل ان اخرج من المسجد؟ " قال: فذهب ليخرج قلت: يا رسول الله، قولك، قال: الحمد لله رب العالمين هي السبع المثاني والقران العظيم "
 
    
 اخبرنا سويد بن نصر، اخبرنا عبد الله، عن مالك، والحارث بن مسكين، قراءة عليه وانا اسمع منه، عن ابن القاسم، قال: حدثني مالك واللفظ له، عن العلاء بن عبد الرحمن انه سمع ابا الساءب، مولي هشام بن زهرة يقول: سمعت ابا هريرة، يقول: قال رسول الله صلي الله عليه وسلم: «كل صلاة لم يقرا فيها بام القران هي خداج، هي خداج، هي خداج، غير تمام» قلت: يا ابا هريرة، اني اكون احيانا وراء الامام؟ فغمز ذراعي وقال: اقرا بها يا فارسي في نفسك، فاني سمعت رسول الله صلي الله عليه وسلم يقول: " قال الله عز وجل: قسمت الصلاة بيني وبين عبدي نصفين، فنصفها لي، ونصفها لعبدي، ولعبدي ما سال " قال رسول الله صلي الله عليه وسلم: " اقرءوا يقول العبد: {الحمد لله رب العالمين} [الفاتحة: ] يقول الله تبارك وتعالي: حمدني عبدي، يقول العبد: {الرحمن الرحيم} [الفاتحة: ] يقول الله: اثني علي عبدي، يقول العبد: {مالك يوم الدين} يقول الله: مجدني عبدي، يقول العبد: {اياك نعبد واياك نستعين} [الفاتحة: ]، فهذه الاية بيني وبين عبدي، ولعبدي ما سال، يقول العبد: {اهدنا الصراط المستقيم صراط الذين انعمت عليهم غير المغضوب عليهم ولا الضالين} [الفاتحة: ]، فهءلاء لعبدي، ولعبدي ما سال "
 
  قوله جل ثناءه: {غير المغضوب عليهم ولا الضالين} 
 [الفاتحة: ]
 
    
 اخبرنا قتيبة بن سعيد، عن مالك، عن سمي، عن ابي صالح، عن ابي هريرة: ان رسول الله صلي الله عليه وسلم قال: " اذا قال الامام: {غير المغضوب عليهم ولا الضالين} [الفاتحة: ] فقولوا: امين، فانه من وافق قوله قول الملاءكة غفر له ما تقدم من ذنبه "
 
    سورة البقرة
 بسم الله الرحمن الرحيم
 
  قوله تبارك وتعالي: {وعلم ادم الاسماء كلها} 
 [البقرة: ]
 
    
 اخبرني ابراهيم بن الحسن، حدثنا الحارث بن عطية، عن هشام الدستواءي، عن قتادة، عن انس بن مالك: ان رسول الله صلي الله عليه وسلم قال: " يجتمع المءمنون يوم القيامة فيقولون: لو استشفعنا الي ربنا حتي يريحنا من مكاننا هذا؟ فياتون ادم فيقولون: يا ادم، انت ابو الناس، خلقك الله بيده، واسجد لك ملاءكته، وعلمك اسماء كل شء، فاشفع لنا الي ربك حتي تريحنا من مكاننا هذا " وساق حديث الشفاعة بطوله
 
  قوله جل ثناءه: {اسكن انت وزوجك الجنة وكلا منها رغدا حيث شءتما} 
 [البقرة: ]
 
    
 اخبرنا قتيبة بن سعيد، حدثنا يعقوب، عن عمرو، عن الاعرج، عن ابي هريرة: ان رسول الله صلي الله عليه وسلم قال: " احتج ادم وموسي عليهما السلام، فقال له موسي: يا ادم، خلقك الله بيده، ثم نفخ فيك من روحه، ثم قال لك: كن فكنت، ثم امر الملاءكة فسجدوا لك، ثم قال: {اسكن انت وزوجك الجنة وكلا منها رغدا حيث شءتما ولا تقربا هذه الشجرة فتكونا من الظالمين} [البقرة: ] فنهاك عن شجرة واحدة فعصيت ربك، فقال ادم: يا موسي، الم تعلم ان الله قدر هذا علي قبل ان يخلقني؟ " قال رسول الله صلي الله عليه وسلم: «لقد حج ادم موسي، لقد حج ادم موسي، لقد حج ادم موسي»
 
    
 اخبرنا عيسي بن حماد، اخبرنا الليث، عن محمد بن عجلان، عن القعقاع بن حكيم، عن ابي صالح، عن ابي هريرة عن رسول الله صلي الله عليه وسلم قال: " لقي ادم موسي، فقال له موسي: انت الذي فعلت بنا الفعل، كنت في الجنة، فاهبطتنا الي الارض؟ فقال له ادم عليه السلام: انت موسي الذي اتاك الله التوراة؟ قال: نعم، قال: في كم تجد التوراة كتبت قبل خلقي؟ قال موسي عليه السلام: بكذا وكذا، قال ادم: فلم تجد فيها خطيءتي؟ قال: بلي، قال: فتلومني في شء كتبه الله علي قبل خلقي؟ " قال رسول الله صلي الله عليه وسلم: «فحج ادم موسي، فحج ادم موسي»
 
  قوله تعالي: {فلا تجعلوا لله اندادا وانتم تعلمون} 
 [البقرة: ]
 
    
 اخبرنا قتيبة بن سعيد، حدثنا جرير، عن منصور، عن ابي واءل، عن عمرو بن شرحبيل، عن عبد الله، قال: سالت النبي صلي الله عليه وسلم: اي الذنب اعظم عند الله؟ قال: «ان تجعل لله ندا وهو خلقك» قلت: ان ذلك لعظيم، قلت: ثم اي؟ قال: «ثم تقتل ولدك ان يطعم معك» قلت: ثم اي؟ قال: «ان تزاني حليلة جارك»
 
  قوله تعالي: {وانزلنا عليكم المن والسلوي} 
 [البقرة: ]
 
    
 اخبرنا اسحاق بن ابراهيم، وعلي بن حجر، قالا: اخبرنا جرير، عن مطرف، عن الحكم بن عتيبة، عن الحسن العرني، عن عمرو بن حريث، عن سعيد بن زيد عن النبي صلي الله عليه وسلم قال: «الكماة من المن» قال علي في حديثه: «الذي انزل الله علي بني اسراءيل، وماءها شفاء للعين»
 
  قوله تعالي: {وادخلوا الباب سجدا} 
 [البقرة: ]
 
    
 اخبرنا محمد بن اسماعيل بن ابراهيم، عن عبد الرحمن، حدثنا عبد الله بن المبارك، عن معمر، عن همام بن منبه، عن ابي هريرة، قال: قيل لبني اسراءيل: {ادخلوا الباب سجدا وقولوا حطة} [البقرة: ] فدخلوا الباب يزحفون علي استاههم، وبدلوا فقالوا: حنطة حبة في شعرة "
 
  قوله تعالي: {وقولوا حطة} 
 [البقرة: ]
 
    
 اخبرني محمد بن عبيد بن محمد، حدثنا عبد الله بن المبارك، عن معمر، عن همام، عن ابي هريرة عن النبي صلي الله عليه وسلم في قوله: {حطة} [البقرة: ] قال: " بدلوا فقالوا: حبة "
 
  قوله تعالي: {فويل للذين يكتبون الكتاب بايديهم} 
 [البقرة: ]
 
    
 اخبرنا الحسن بن احمد بن حبيب، حدثنا محمد وهو ابن عبد الله بن نمير، حدثنا وكيع، حدثنا سفيان، عن عبد الرحمن بن علقمة، قال: سمعت ابن عباس، يقول: {للذين يكتبون الكتاب بايديهم} [البقرة: ] نزلت في اهل الكتاب
 
  قوله تعالي: {من كان عدوا لجبريل} 
 [البقرة: ]
 
    
 اخبرنا محمد بن المثني، حدثنا خالد يعني ابن الحارث، عن حميد، عن انس، ان شاء الله قال: جاء عبد الله بن سلام الي رسول الله صلي الله عليه وسلم مقدمه الي المدينة فقال: اني ساءلك عن ثلاث لا يعلمهن الا نبي: ما اول اشراط الساعة، واول ما ياكل اهل الجنة، والولد ينزع الي ابيه والي امه؟ فقال: «اخبرني بهن جبريل عليه السلام انفا» قال عبد الله: ذلك رذلة عدو لليهود من الملاءكة، قال: «اما اول اشراط الساعة فنار تحشرهم من المشرق الي المغرب، واما اول طعام ياكله اهل الجنة فزيادة كبد حوت، واما الولد فاذا سبق ماء الرجل نزعه، واذا سبق ماء المراة نزعت» قال: اشهد ان لا اله الا الله، واشهد انك رسول الله " قال: يا رسول الله، ان اليهود قوم بهت، وان علموا باسلامي قبل ان تسالهم عني بهتوني عندك، فجاءت اليهود فقال لهم رسول الله صلي الله عليه وسلم: «اي رجل فيكم عبد الله بن سلام؟» قالوا: خيرنا وابن خيرنا، وسيدنا وابن سيدنا، واعلمنا، قال: «ارايتم ان اسلم عبد الله بن سلام؟» قالوا: اعاذه الله من ذلك، فخرج اليهم فقال: اشهد ان لا اله الا الله، واشهد ان محمدا رسول الله، قالوا: شرنا وابن شرنا وانتقصوه، قال: هذا ما كنت اخاف يا رسول الله
 
  قوله تعالي: {وما كفر سليمان} 
 [البقرة: ]
 
    
 اخبرنا محمد بن العلاء، حدثنا ابو معاوية، حدثنا الاعمش، عن المنهال بن عمرو، عن سعيد بن جبير، عن ابن عباس، قال: كان الذي اصاب سليمان بن داود عليه السلام في سبب امراة من اهله يقال لها جرادة، وكانت احب نساءه اليه، وكان اذا اراد ان ياتي نساءه او يدخل الخلاء اعطاها الخاتم، فجاء اناس من اهل الجرادة يخاصمون قوما الي سليمان بن داود عليه السلام، فكان هوي سليمان ان يكون الحق لاهل الجرادة فيقضي لهم، فعوقب حين لم يكن هواه فيهم واحدا، فجاء حين اراد الله ان يبتليه فاعطاها الخاتم ودخل الخلاء، ومثل الشيطان في صورة سليمان، قال: هاتي خاتمي، فاعطته خاتمه فلبسه، فلما لبسه دانت له الشياطين والانس والجن وكل شء، قال: فجاءها سليمان، قال: هاتي خاتمي، قالت: اخرج لست بسليمان، قال سليمان عليه السلام: ان ذاك من امر الله، ابتلي به، فخرج فجعل اذا قال: انا سليمان رجموه حتي يدمون عقبه، فخرج يحمل علي شاطء البحر، ومكث هذا الشيطان فيهم مقيما ينكح نساءه، ويقضي بينهم، فلما اراد الله عز وجل ان يرد علي سليمان ملكه انطلقت الشياطين وكتبوا كتبا فيها سحر، وفيها كفر، فدفنوها تحت كرسي سليمان عليه السلام، ثم اثاروها وقالوا: هذا كان يفتن الجن والانس، قال: فاكفر الناس سليمان حتي بعث الله محمدا صلي الله عليه وسلم، فانزل الله عز وجل علي محمد عليه السلام {وما كفر سليمان ولكن الشياطين كفروا} [البقرة: ] يقول الذي صنعوا
  [ص: ]
 ، فخرج سليمان يحمل علي شاطء البحر، قال: ولما انكر الناس لما اراد الله ان يرد علي سليمان ملكه انكروا، انطلقت الشياطين جاءوا الي نساءه فسالوهن فقلن: انه لياتينا ونحن حيض، وما كان ياتينا قبل ذلك، فلما راي الشيطان انه حضر هلاكه هرب وارسل به فالقاه في البحر، وفي الحديث: فتلقاه سمكة فاخذه، وخرج الشيطان حتي لحق بجزيرة في البحر، وخرج سليمان عليه السلام يحمل لرجل سمكا، قال: بكم تحمل؟ قال: بسمكة من هذا السمك، فحمل معه حتي بلغ به اعطاه السمكة التي في بطنها الخاتم، فلما اعطاه السمكة شق بطنها يريد يشويها، فاذا الخاتم فلبسه، فاقبل اليه الانس والشياطين، فارسل في طلب الشيطان، فجعلوا لا يطيقونه، فقال: احتالوا له، فذهبوا فوجدوه ناءما قد سكر، فبنوا عليه بيتا من رصاص، ثم جاءوا لياخذوه، فوثب فجعل لا يثب في ناحية الا اماط الرصاص معه، فاخذوه فجاءوا به الي سليمان، فامر بحنت من رخام، فنقر، ثم ادخله في جوفه ثم سده بالنحاس، ثم امر به فطرح في البحر "
 
    
 اخبرنا محمد بن العلاء، عن ابي اسامة، حدثنا الاعمش، عن المنهال، عن سعيد بن جبير، عن ابن عباس، قال: كان اصف كاتب سليمان بن داود عليه السلام، وكان يعلم الاسم الاعظم، كان يكتب كل شء يامره به سليمان عليه السلام ويدفنه تحت كرسيه، فلما مات سليمان اخرجته الشياطين، فكتبوا بين كل سطر من سحر وكذب وكفر، فقالوا: هذا الذي كان يعمل سليمان بها، فاكفره جهال الناس وسفهاءهم وسبوه، ووقف علماءهم، فلم يزل جهالهم يسبونه حتي انزل الله جل وعز: {واتبعوا ما تتلوا الشياطين علي ملك سليمان وما كفر سليمان ولكن الشياطين كفروا} [البقرة: ]
 
  قوله تعالي: {ما ننسخ من اية او ننسها} 
 [البقرة: ]
 
    
 اخبرنا عمرو بن علي، حدثنا يحيي، حدثنا سفيان، عن حبيب، عن سعيد بن جبير، عن ابن عباس، قال: قال عمر: اقرءنا ابي، واقضانا علي، وانا لندع من قول ابي، وذلك انه يقول: " لا ادع شيءا سمعته من رسول الله صلي الله عليه وسلم، وقد قال الله عز وجل: «ما ننسخ من اية او ننساها نات بخير منها او مثلها»
 
    
 اخبرنا اسحاق بن ابراهيم، اخبرنا النضر، اخبرنا شعبة، عن يعلي بن عطاء، عن القاسم بن ربيعة، قال: قلت لسعد بن مالك: " ان سعيد بن المسيب يقرا ما ننسخ من اية او تنسها قال: ان القران لم يقراه الله علي المسيب ولا علي ابنه، وانه انما: ننسخ من اية او ننساها يا محمد قال: {واذكر ربك اذا نسيت} [الكهف: ]
 
  قوله تعالي: {فاينما تولوا فثم وجه الله} 
 [البقرة: ]
 
    
 اخبرني محمد بن ادم بن سليمان، عن ابن المبارك، عن عبد الملك بن ابي سليمان، عن سعيد بن جبير، عن ابن عمر: " ان النبي صلي الله عليه وسلم كان يصلي علي راحلته حيث توجهت به، ثم تلا هذه الاية {فاينما تولوا فثم وجه الله} [البقرة: ]
 
  قوله تعالي: {واتخذوا من مقام ابراهيم مصلي} 
 [البقرة: ]
 
    
 اخبرنا هناد بن السري، عن ابن ابي زاءدة، اخبرنا حميد الطويل، عن انس، عن عمر رضي الله عنه قال: قلت: " يا رسول الله، لو اتخذت من مقام ابراهيم مصلي، فانزل الله تبارك وتعالي {واتخذوا من مقام ابراهيم مصلي} [البقرة: ]
 
  قوله تعالي: {واذ يرفع ابراهيم القواعد من البيت} 
 [البقرة: ]
 
    
 اخبرنا محمد بن سلمة، والحارث بن مسكين، عن ابن القاسم، قال: حدثني مالك، عن ابن شهاب، عن سالم بن عبد الله، ان عبد الله بن محمد بن ابي بكر، اخبر عبد الله بن عمر، عن عاءشة، ان رسول الله صلي الله عليه وسلم قال: «الم تري الي قومك حين بنوا الكعبة اقتصروا عن قواعد ابراهيم؟» فقلت: يا رسول الله، الا تردها علي قواعد ابراهيم؟ فقال: «لولا حدثان قومك بالكفر» فقال عبد الله بن عمر: لءن كانت عاءشة سمعت هذا من رسول الله صلي الله عليه وسلم، ما اري رسول الله صلي الله عليه وسلم ترك استلام الركنين اللذين يليان الحجر، الا ان البيت لم يتم علي قواعد ابراهيم
 
  قوله تعالي: {سيقول السفهاء من الناس ما ولاهم عن قبلتهم} 
 [البقرة: ]
 
    
 اخبرنا محمد بن اسماعيل بن ابراهيم، حدثنا اسحاق، عن زكريا، عن ابي اسحاق، عن البراء بن عازب، قال: " قدم رسول الله صلي الله عليه وسلم المدينة فصلي نحو بيت المقدس ستة عشر شهرا، ثم انه وجه الي الكعبة، فمر رجل قد كان صلي مع النبي صلي الله عليه وسلم علي قوم من الانصار فقال: اشهد ان رسول الله صلي الله عليه وسلم قد وجه الي الكعبة فانحرفوا الي الكعبة "
 
    
 اخبرنا محمد بن حاتم، اخبرنا حبان، اخبرنا عبد الله، اخبرنا شريك، عن ابي اسحاق، عن البراء، في قوله: {سيقول السفهاء من الناس ما ولاهم عن قبلتهم التي كانوا عليها} [البقرة: ] قال: هم اهل الكتاب السفهاء
 
  قوله تعالي: {قد نري تقلب وجهك في السماء فلنولينك قبلة ترضاها} 
 [البقرة: ]
 
    
 اخبرنا قتيبة بن سعيد، عن مالك، عن عبد الله بن دينار، عن عبد الله بن عمر، قال: بينما الناس بقباء في صلاة الصبح جاءهم ات فقال: «ان رسول الله صلي الله عليه وسلم قد انزل عليه الليلة وامر ان يستقبل القبلة، فاستقبلوها وكانت وجوههم الي الشام فاستداروا الي الكعبة»
 
    
 اخبرنا محمد بن حاتم بن نعيم، اخبرنا حبان، اخبرنا عبد الله، عن شريك، عن ابي اسحاق، عن البراء، قال: صليت مع رسول الله صلي الله عليه وسلم نحو بيت المقدس ستة عشر شهرا، وكان نبي الله صلي الله عليه وسلم يحب ان يصلي نحو الكعبة، فكان يرفع راسه الي السماء، فانزل الله عز وجل: {قد نري تقلب وجهك في السماء فلنولينك قبلة ترضاها، فول وجهك شطر المسجد الحرام} [البقرة: ] قال البراء: والشطر فينا قبله، وقال في قول الله تعالي {ليضيع ايمانكم} [البقرة: ] قال: ما كان الله ليضيع صلاة من مات وهو يصلي نحو بيت المقدس
 
    
 اخبرنا محمد بن عبد الله بن عبد الحكم، عن شعيب، اخبرنا الليث، حدثنا خالد بن يزيد، عن ابن ابي هلال، قال: اخبرني مروان بن عثمان، ان عبيد بن حنين، اخبره، عن ابي سعيد بن المعلي، قال: كنا نغدوا للسوق علي عهد رسول الله صلي الله عليه وسلم فنمر علي المسجد فنصلي فيه، فمررنا يوما ورسول الله صلي الله عليه وسلم قاعد علي المنبر، فقلت: لقد حدث امر فجلست فقرا رسول الله صلي الله عليه وسلم {قد نري تقلب وجهك في السماء} [البقرة: ] حتي فرغ من الاية، قلت لصاحبي: تعال نركع ركعتين قبل ان ينزل رسول الله صلي الله عليه وسلم فنكون اول من صلي، فتوارينا فصلينا، ثم نزل رسول الله صلي الله عليه وسلم، فصلي للناس الظهر يومءذ "
 
    
 اخبرنا اسحاق بن ابراهيم، اخبرنا يحيي بن ادم، حدثنا ابو زبيد، عن سليمان التيمي، عن انس، قال: «ما بقي احد صلي القبلتين غيري»
 
  قوله تعالي: {وكذلك جعلناكم امة وسطا} 
 [البقرة: ]
 
    
 اخبرنا محمد بن المثني، عن هشام بن عبد الملك، حدثنا ابو معاوية، اخبرنا الاعمش، عن ابي صالح، عن ابي سعيد عن النبي صلي الله عليه وسلم: {جعلناكم امة وسطا} [البقرة: ] قال: «عدلا»
 
    
 اخبرنا محمد بن ادم بن سليمان، عن ابي معاوية، عن الاعمش، عن ابي صالح، عن ابي سعيد، قال: قال رسول الله صلي الله عليه وسلم: " يجء النبي يوم القيامة معه الرجل، ويجء النبي معه الرجلان، ويجء النبي معه اكثر من ذلك، فيقال له: هل بلغت قومك؟ فيقول: نعم، فيدعون فيقال: هل بلغكم؟ فيقولون: لا، فيقال: من يشهد لك؟ فيقول: امة محمد صلي الله عليه وسلم، فتدعي امة محمد صلي الله عليه وسلم فيقال: هل بلغ هذا؟ فيقولون: نعم، فيقال: وما علمكم بذلك؟ فيقولون: اخبرنا نبينا صلي الله عليه وسلم ان الرسل قد بلغوا فصدقناه، فذلك قوله: {وكذلك جعلناكم امة وسطا} [البقرة: ] قال: «عدلا، لتكونوا شهداء علي الناس»
 
  قوله تعالي: {فول وجهك شطر المسجد الحرام} 
 [البقرة: ]
 
    
 اخبرنا ابو بكر بن نافع، حدثنا بهز، حدثنا حماد بن سلمة، اخبرنا ثابت، عن انس ان النبي صلي الله عليه وسلم واصحابه كانوا يصلون نحو بيت المقدس، فلما نزلت هذه الاية: {فول وجهك شطر المسجد الحرام} [البقرة: ] مر رجل من بني سلمة فناداهم وهم ركوع في صلاة الفجر: الا ان القبلة قد حولت الي الكعبة، فمالوا ركوعا "
 
  قوله تعالي: {ان الصفا والمروة من شعاءر الله} 
 [البقرة: ]
 
    
 اخبرنا محمد بن سلمة، والحارث بن مسكين قراءة عليه، عن ابن القاسم، قال: حدثني مالك، عن هشام بن عروة، عن ابيه، قال: قلت لعاءشة زوج النبي صلي الله عليه وسلم، وانا يومءذ حديث السن: ارايت قول الله عز وجل: {ان الصفا والمروة من شعاءر الله فمن حج البيت او اعتمر، فلا جناح عليه ان يطوف بهما} [البقرة: ] فما اري علي احد شيءا الا يطوف بهما؟. قالت عاءشة: كلا، لو كانت كما تقول كانت: لا جناح عليه الا يطوف بهما، انما انزلت هذه الاية في الانصار، كانوا يهلون لمناة وكانت مناة حذو قديد، وكانوا يتحرجون ان يطوفوا بين الصفا والمروة، فلما جاء الاسلام سالوا رسول الله صلي الله عليه وسلم عن ذلك فانزل الله عز وجل {ان الصفا والمروة من شعاءر الله فمن حج البيت او اعتمر فلا جناح عليه ان يطوف بهما} [البقرة: ]
 
  قوله تعالي: {ان في خلق السموات والارض}
 
    
 اخبرنا هارون بن عبد الله، ويوسف بن سعيد واللفظ له، حدثنا حجاج، عن ابن جريج، قال: اخبرني اسماعيل بن امية، عن ايوب بن خالد، عن عبد الله بن رافع، عن ابي هريرة، قال: اخذ رسول الله صلي الله عليه وسلم بيدي فقال: «خلق الله التربة يوم السبت، وخلق الجبال يوم الاحد، وخلق الاشجار يوم الاثنين، وخلق المكروه يوم الثلاثاء، وخلق النور يوم الاربعاء، وبث فيها الدوابات يوم الخميس، وخلق ادم يوم الجمعة بعد العصر، اخر الخلق اخر ساعات النهار»
 
  قوله تعالي: {ومن الناس من يتخذ من دون الله اندادا} 
 [البقرة: ]
 
    
 اخبرنا اسحاق بن ابراهيم، اخبرنا النضر بن شميل، حدثنا شعبة، واخبرنا محمد بن عبد الاعلي، واسماعيل بن مسعود، قالا: حدثنا خالد وهو ابن الحارث، حدثنا شعبة، عن سليمان، عن ابي واءل، عن عبد الله، قال: قال رسول الله صلي الله عليه وسلم: «من مات يجعل لله ندا ادخله النار» وانا اقول: من مات لا يجعل لله ندا ادخله الجنة "
 
  قوله تعالي: {ان الذين يشترون بعهد الله وايمانهم ثمنا قليلا} 
 [ال عمران: ]
 
    
 اخبرنا الهيثم بن ايوب، حدثنا يحيي بن زكريا، عن الاعمش، عن شقيق، قال: قال ابن مسعود: قال رسول الله صلي الله عليه وسلم: " من حلف علي يمين يقطع بها مالا لقي الله وهو عليه غضبان، وتصديقه في كتاب الله تعالي {ان الذين يشترون بعهد الله وايمانهم ثمنا قليلا اولءك لا خلاق لهم في الاخرة} [ال عمران: ] قال: فجاء الاشعث بن قيس فقال: ما يحدثكم ابو عبد الرحمن؟ قلنا: كذا وكذا، قال: صدق والله، انزلت في وفي فلان بن فلان، كانت بيني وبينه خصومة، فقال رسول الله صلي الله عليه وسلم: «شهودك او يمينه» قلت: اذا يحلف، قال: «من حلف علي يمين يقطع بها مالا وهو فيها كاذب لقي الله وهو عليه غضبان» فانزل الله عز وجل هذه الاية
 
    
 اخبرنا محمد بن بشار، عن محمد، حدثنا شعبة، عن علي بن مدرك، عن ابي زرعة بن عمرو بن جرير، عن خرشة بن الحر، عن ابي ذر عن النبي صلي الله عليه وسلم قال: «ثلاثة لا يكلمهم الله يوم القيامة، ولا ينظر اليهم، ولا يزكيهم، ولهم عذاب اليم» قال ابو ذر: خابوا وخسروا، قال: «المسبل ازاره، والمنفق سلعته بالحلف الكاذب، والمنان عطاءه»
 
  قوله تعالي: {يا ايها الذين امنوا كتب عليكم القصاص} 
 [البقرة: ]
 
    
 اخبرنا عبد الجبار بن العلاء بن عبد الجبار، عن سفيان، عن عمرو، عن مجاهد، عن ابن عباس، قال: " كان القصاص في بني اسراءيل ولم يكن فيهم الدية، فقال الله تبارك وتعالي لهذه الامة: {يا ايها الذين امنوا كتب عليكم القصاص في القتلي الحر بالحر} [البقرة: ] الي قوله: {فمن عفي له من اخيه شء} [البقرة: ] فالعفو ان تقبل الدية في العمد، واتباع المعروف ان تتبع هذا بمعروف وتءدي هذا باحسان، فخفف عن هذه الامة "
 
  قوله تعالي: {كتب عليكم الصيام كما كتب علي الذين من قبلكم} 
 [البقرة: ]
 
    
 اخبرنا عبيد الله بن سعيد، حدثنا يحيي، عن هشام، اخبرني ابي، عن عاءشة، قالت: «كان يوم عاشوراء يوما تصومه قريش في الجاهلية، وكان رسول الله صلي الله عليه وسلم يصومه، فلما قدم المدينة صامه وامر بصيامه، فنزل صوم رمضان فكان رمضان هو الفريضة، فمن شاء صام يوم عاشوراء، ومن شاء ترك»
 
    
 اخبرنا قتيبة بن سعيد، قال: حدثنا الليث، عن يزيد بن ابي حبيب، ان عراكا، اخبره، ان عروة اخبره، عن عاءشة، ان قريشا، كانت تصوم يوم عاشوراء في الجاهلية، ثم امر رسول الله صلي الله عليه وسلم بصيامه حتي فرض رمضان، فقال رسول الله صلي الله عليه وسلم: «من شاء فليصمه، ومن شاء افطره»
 
  قوله تعالي: {وعلي الذين يطيقونه فدية طعام مسكين} 
 [البقرة: ]
 
    
 اخبرنا قتيبة بن سعيد، حدثنا بكر يعني ابن مضر، عن عمرو بن الحارث، عن بكير، عن يزيد، مولي سلمة بن الاكوع، عن سلمة بن الاكوع، قال: " لما نزلت هذه الاية {وعلي الذين يطيقونه فدية طعام مسكين} [البقرة: ] كان من اراد منا ان يفطر ويفتدي حتي نزلت الاية التي بعدها فنسختها "
 
    
 اخبرنا محمد بن اسماعيل بن ابراهيم، حدثنا يزيد بن هارون، حدثنا ورقاء، عن عمرو بن دينار، عن عطاء، عن ابن عباس، في قوله {وعلي الذين يطيقونه فدية طعام مسكين} [البقرة: ] قال: " تطيقونه: تكلفونه فدية طعام مسكين واحد، فمن تطوع فزاد مسكينا اخر ليست بمنسوخة، فهو خير له، {وان تصوموا خير لكم} [البقرة: ] لا يرخص في هذا الا للكبير الذي لا يطيق الصيام، والمريض الذي لا يشفي "
 
    
 اخبرنا محمد بن عبد الوهاب، حدثنا محمد بن سابق، حدثنا ورقاء، حدثنا ابن ابي نجيح، عن عمرو بن دينار، عن عطاء، عن ابن عباس، قال: «الذين يطوقونه»
 
  قوله تعالي: {فعدة من ايام اخر} 
 [البقرة: ]
 
    
 اخبرنا علي بن محمد بن علي، حدثنا خلف بن تميم، عن بشير ابي اسماعيل، حدثني خيثمة، عن انس بن مالك، في صوم رمضان في السفر، قلت: فاين هذه الاية {فعدة من ايام اخر} [البقرة: ] قال: «انها نزلت يوم نزلت، يعني علي النبي صلي الله عليه وسلم ونحن نرتحل جياعا وننزل علي غير شبع، واليوم نرتحل شباعا وننزل علي شبع»
 
  قوله تعالي: {وكلوا واشربوا حتي يتبين لكم الخيط الابيض من الخيط الاسود من الفجر} 
 [البقرة: ]
 
    
 اخبرنا علي بن حجر، اخبرنا جرير، عن مطرف، عن الشعبي، عن عدي بن حاتم، انه سال رسول الله صلي الله عليه وسلم عن قوله: {حتي يتبين لكم الخيط الابيض من الخيط الاسود} [البقرة: ] قال رسول الله صلي الله عليه وسلم: «الخيط الابيض من الخيط الاسود هذا هو سواد الليل وبياض النهار»
 
    
 اخبرنا ابو بكر بن اسحاق، حدثنا سعيد بن ابي مريم، اخبرنا ابو غسان، حدثني ابو حازم، عن سهل بن سعد، قال: " نزلت هذه الاية {وكلوا واشربوا حتي يتبين لكم الخيط الابيض من الخيط الاسود} [البقرة: ] ولم ينزل {من الفجر} [البقرة: ]، فكان رجال اذا ارادوا الصوم ربط احدهم في رجله الخيط الابيض والخيط الاسود، ولا يزال ياكل ويشرب حتي يتبين له رءيتهما، فانزل الله تبارك وتعالي بعد ذلك {من الفجر} [البقرة: ] فعلموا انما يعني بذلك: الليل والنهار "
 
    
 اخبرنا هلال بن العلاء، حدثنا حسين بن عياش، حدثنا زهير، حدثنا ابو اسحاق، عن البراء بن عازب: " ان احدهم كان اذا نام قبل ان يتعشي لم يحل له ان ياكل شيءا، ولا يشرب ليلته ويومه من الغد حتي تغرب الشمس حتي نزلت هذه الاية {وكلوا واشربوا} [البقرة: ] الي {الخيط الاسود} [البقرة: ] وانزلت في ابي قيس بن عمرو، اتي اهله وهو صاءم بعد المغرب، فقال: هل من شء؟ فقالت امراته: ما عندنا شء، ولكن اخرج التمس لك عشاء، فخرجت، ووضع راسه فنام، فرجعت اليه فوجدته ناءما، وايقظته فلم يطعم شيءا، وبات صاءما واصبح صاءما، حتي انتصف النهار، فغشي عليه وذلك قبل ان تنزل الاية، فانزل الله فيه "
 
  قوله تعالي: {وليس البر بان تاتوا البيوت من ظهورها} 
 [البقرة: ]
 
    
 اخبرنا علي بن الحسين، حدثنا امية، عن شعبة، عن ابي اسحاق، عن البراء: " كانت الانصار اذا حجت لم تدخل من ابوابها، ودخلت من ظهورها، فانزل الله تبارك وتعالي {وليس البر بان تاتوا البيوت من ظهورها} [البقرة: ]
 
    
 اخبرنا محمد بن حاتم بن نعيم، اخبرنا حبان، اخبرنا عبد الله، عن شريك، عن ابي اسحاق، عن البراء، في قوله: {وليس البر بان تاتوا البيوت من ظهورها} [البقرة: ] قال: كان ناس من اهل الجاهلية اذا احرموا لم يدخلوا البيوت من ابوابها، ودخلوها من ظهورها من الحيطان، فانزل الله جل ثناءه {وليس البر بان تاتوا البيوت من ظهورها، ولكن البر من اتقي واتوا البيوت من ابوابها} [البقرة: ]
 
  قوله جل ثناءه: {وقاتلوهم حتي لا تكون فتنة} 
 [البقرة: ]
 
    
 اخبرنا عمرو بن علي، عن عبد الرحمن بن مهدي، عن خالد بن عبد الله، عن بيان، عن وبرة، عن سعيد بن جبير، قال: خرج الينا ابن عمر ونحن نرجو ان يحدثنا حديثا عجيبا، فبدر اليه رجل بالمسالة فقال: يا ابا عبد الرحمن، ما يمنعك من القتال، والله تعالي يقول: {وقاتلوهم حتي لا تكون فتنة} [البقرة: ] قال: ثكلتك امك، اتدري ما الفتنة، انما كان رسول الله صلي الله عليه وسلم يقاتل المشركين، وكان الدخول في دينهم فتنة، وليس يقاتلهم علي الملك "
 
  قوله تعالي: {وانفقوا في سبيل الله} 
 [البقرة: ]
 
    
 اخبرنا محمد بن حاتم بن نعيم، اخبرنا حبان، اخبرنا عبد الله، عن زاءدة، عن الركين بن الربيع، عن الربيع بن عميلة، عن يسير بن عميلة، عن خريم بن فاتك الاسدي عن النبي صلي الله عليه وسلم قال: «من انفق نفقة في سبيل الله كتب له بسبع ماءة ضعف»
 
  قوله تعالي: {ولا تلقوا بايديكم الي التهلكة} 
 [البقرة: ]
 
    
 اخبرنا عبيد الله بن سعيد، عن حديث ابي عاصم، عن حيوة بن شريح، قال: حدثني يزيد بن ابي حبيب، قال: حدثني اسلم ابو عمران، قال: قال ابو ايوب صاحب النبي صلي الله عليه وسلم: " انا لما اعز الله الاسلام وكثر ناصريه قال بعضنا لبعض سرا بيننا: ان الله جل وعز اعز الاسلام وكثر ناصريه، فلو اقمنا في اموالنا واصلحنا منها، فانزل الله جل وعز ورد ذلك علينا {وانفقوا في سبيل الله ولا تلقوا بايديكم الي التهلكة واحسنوا ان الله يحب المحسنين} [البقرة: ] فكانت التهلكة الاقامة في اموالنا "
 
    
 اخبرنا محمد بن حاتم، اخبرنا حبان، اخبرنا عبد الله، عن حيوة، اخبرني يزيد بن ابي حبيب، حدثنا اسلم ابو عمران، قال: " كنا بالقسطنطينة، وعلي اهل مصر عقبة بن عامر، وعلي اهل الشام فضالة بن عبيد، فخرج من المدينة صف عظيم من الروم، وصففنا لهم صفا عظيما من المسلمين، فحمل رجل من المسلمين علي صف الروم حتي دخل بهم، ثم خرج الينا مقبلا، فصاح الناس فقالوا: سبحان الله، الفتي القي بيده الي التهلكة، فقال ابو ايوب صاحب رسول الله صلي الله عليه وسلم: يا ايها الناس، انكم تتاولون هذه الاية علي هذا التاويل، وانما انزلت هذه الاية فينا معشر الانصار لما اعز الله دينه وكثر ناصريه قلنا بيننا بعضنا لبعض سرا من رسول الله صلي الله عليه وسلم: ان اموالنا قد ضاعت، فلو انا اقمنا فيها واصلحنا ما ضاع منها، فانزل الله تبارك وتعالي في كتابه يرد علينا ما هممنا به قال: {وانفقوا في سبيل الله ولا تلقوا بايديكم الي التهلكة} [البقرة: ] فكانت التهلكة الاقامة التي اردنا ان نقيم في اموالنا فنصلحها، فامرنا بالغزو، فما زال ابو ايوب غازيا في سبيل الله حتي قبض "
 
  قوله تعالي: {فمن كان منكم مريضا او به اذي من راسه} 
 [البقرة: ]
 
    
 اخبرنا عمرو بن علي، حدثنا ازهر بن سعد، عن ابن عون، عن مجاهد، عن ابن ابي ليلي، عن كعب بن عجرة، قال: في انزلت هذه الاية، فاتيت فقال: «ادن» فدنوت، فقال: «ايءذيك هوامك؟» فامرني بصيام او صدقة او نسك، قال ابن عون: ففسره لي مجاهد فلم احفظه، فسالت ايوب فقال: الصيام ثلاثة ايام، والصدقة علي ستة مساكين، والنسك ما استيسر "
 
    
 اخبرنا محمد بن بشار، حدثنا محمد، حدثنا شعبة، عن عبد الرحمن بن الاصبهاني، عن عبد الله بن معقل، قال: جلست في هذا المسجد الي كعب بن عجرة فسالته عن هذه الاية {ففدية من صيام} [البقرة: ]. قال كعب: " في نزلت، وكان بي اذي من راسي، فحملت الي رسول الله صلي الله عليه وسلم والقمل يتناثر علي وجهي فقال: «ما كنت اري ان الجهد بلغ بك ما اري، اتجد شاة؟» قال: لا، فنزلت هذه الاية {ففدية من صيام او صدقة او نسك} [البقرة: ] فالصوم ثلاثة ايام، والصدقة علي ستة مساكين، لكل مسكين نصف صاع، والنسك شاة "
 
  قوله تعالي: {فمن تمتع بالعمرة الي الحج فما استيسر من الهدي} 
 [البقرة: ]
 
    
 اخبرنا محمد بن عبد الاعلي، حدثنا بشر، عن عمران بن مسلم، عن ابي رجاء، عن عمران، قال: نزلت اية المتعة، يعني متعة الحج، في كتاب الله وامر بها رسول الله صلي الله عليه وسلم، لم تنزل اية تنسخ اية متعة الحج، ولم ينه عنها رسول الله صلي الله عليه وسلم حتي مات، قال رجل برايه ما شاء "
 
  قوله تعالي: {وتزودوا فان خير الزاد التقوي} 
 [البقرة: ]
 
    
 اخبرنا سعيد بن عبد الرحمن، حدثنا سفيان، عن عمرو، عن عكرمة، عن ابن عباس، في قوله تعالي: {وتزودوا فان خير الزاد التقوي} [البقرة: ] قال: كان ناس يحجون بغير زاد، فنزلت {وتزودوا فان خير الزاد التقوي} [البقرة: ]
 
  قوله تعالي: {ثم افيضوا من حيث افاض الناس} 
 [البقرة: ]
 
    
 اخبرنا اسحاق بن ابراهيم، اخبرنا ابو معاوية، حدثنا هشام، عن ابيه، عن عاءشة، قالت: " كانت قريش تقف بالمزدلفة ويسمون الحمس، وساءر العرب تقف بعرفة، فامر الله نبيه صلي الله عليه وسلم ان يقف بعرفة، ثم يدفع منها، فانزل الله تعالي {ثم افيضوا من حيث افاض الناس} [البقرة: ]
 
  قوله جل ثناءه: {ومنهم من يقول ربنا اتنا في الدنيا حسنة وفي الاخرة حسنة} 
 [البقرة: ]
 
    
 اخبرنا اسحاق بن ابراهيم، حدثنا اسماعيل بن ابراهيم، عن عبد العزيز، قال: سال قتادة انسا: اية دعوة كان رسول الله صلي الله عليه وسلم يدعو بها اكثر؟ فقال: " كان يدعو اكثر ما يدعو بهذا القول: اللهم اتنا في الدنيا حسنة وفي الاخرة حسنة وقنا عذاب النار "
 
  قوله تعالي: {وهو الد الخصام} 
 [البقرة: ]
 
    
 اخبرنا اسحاق بن ابراهيم، حدثنا وكيع، حدثنا ابن جريج، عن ابن ابي مليكة، عن عاءشة، قالت: قال رسول الله صلي الله عليه وسلم: «ابغض الرجال الي الله الالد الخصم»
 
  قوله تعالي: {ويسالونك عن المحيض قل هو اذي فاعتزلوا النساء في المحيض} 
 [البقرة: ]
 
    
 اخبرنا اسحاق بن ابراهيم، اخبرنا سليمان بن حرب، حدثنا حماد بن سلمة، عن ثابت، عن انس، قال: " كانت اليهود اذا حاضت المراة منهم لم يءاكلوهن، ولم يشاربوهن، ولم يجامعوهن في البيوت، فسالوا النبي صلي الله عليه وسلم عن ذلك، فانزل الله تعالي {ويسالونك عن المحيض} [البقرة: ] قل هو اذي فاعتزلوا النساء في المحيض فامرهم رسول الله صلي الله عليه وسلم ان يءاكلوهن، وان يشاربوهن، وان يجامعوهن في البيوت، وان يصنعوا بهن كل شء ما خلا النكاح "
 
  قوله تعالي: {نساءكم حرث لكم فاتوا حرثكم اني شءتم} 
 [البقرة: ]
 
    
 اخبرنا اسحاق بن ابراهيم، اخبرنا سفيان، عن ابن المنكدر، عن جابر، قال: كانت اليهود تقول في الرجل ياتي امراته من قبل دبرها في قبلها ان الولد يكون احول، فنزلت {نساءكم حرث لكم فاتوا حرثكم اني شءتم} [البقرة: ]
 
    
 اخبرنا قتيبة بن سعيد، حدثنا ابو عوانة، عن محمد بن المنكدر، عن جابر بن عبد الله، قال: قالت اليهود: اذا اتي الرجل امراته من قبل دبرها كان الحول من ذلك، فانزل الله تبارك وتعالي {نساءكم حرث لكم فاتوا} [البقرة: ] قال: قاءما وقاعدا وباركا بعد ان يكون في الماتي "
 
    
 اخبرنا احمد بن الخليل، حدثنا يونس بن محمد، حدثنا يعقوب، حدثنا جعفر، عن سعيد بن جبير، عن ابن عباس، قال: جاء عمر بن الخطاب الي رسول الله صلي الله عليه وسلم فقال: " يا رسول الله، هلكت، قال: «وما الذي اهلكك؟» قال: حولت رحلي الليلة، فلم يرد عليه شيءا، قال: فاوحي الي رسول الله صلي الله عليه وسلم هذه الاية {نساءكم حرث لكم فاتوا حرثكم اني شءتم} [البقرة: ] يقول: اقبل وادبر، واتق الدبر والحيضة "
 
  قوله تعالي: {واذا طلقتم النساء فبلغن اجلهن فلا تعضلوهن} 
 [البقرة: ]
 
    
 اخبرنا سوار بن عبد الله بن سوار، حدثنا ابو داود الطيالسي، حدثنا عباد بن راشد، قال: سمعت الحسن، يقول: حدثني معقل بن يسار، قال: " كانت لي اخت تخطب فامنعها، فخطبها ابن عم لي فزوجتها اياه، فاصطحبا ما شاء الله ان يصطحبا، ثم طلقها طلاقا له عليها رجعة، فتركها حتي انقضت عدتها وخطبها الخطاب، جاء فخطبها فقلت: يا لكع، خطبت اختي فمنعتها الناس واثرتك بها طلقتها، فلما انقضت عدتها جءت تخطبها؟ لا والله الذي لا اله الا هو لا ازوجكما، ففي نزلت هذه الاية {واذا طلقتم النساء فبلغن اجلهن فلا تعضلوهن ان ينكحن ازواجهن اذا تراضوا} [البقرة: ] فقلت: سمعا وطاعة، كفرت عن يميني وانكحتها "
 
    
 اخبرنا ابو بكر بن علي، حدثنا سريج بن يونس، عن هشيم، اخبرنا يونس، عن الحسن، عن معقل بن يسار، قال: " زوجت اختي رجلا منا فطلقها، فلما انقضت العدة خطبها الي ووافقها ذلك، فقلت له: زوجتك واثرتك، ثم طلقتها، ما هي بالتي تعود اليك، فنزلت {واذا طلقتم النساء فبلغن اجلهن فلا تعضلوهن ان ينكحن ازواجهن اذا تراضوا بينهم بالمعروف} [البقرة: ] فقلت لما نزلت هذه الاية: اما انها ستعود اليك "
 
  قوله تعالي: {والذين يتوفون منكم ويذرون ازواجا} 
 [البقرة: ]
 
    
 اخبرنا محمد بن عبد الاعلي، اخبرنا خالد يعني ابن الحارث، اخبرنا ابن عون، عن محمد، قال: لقيت مالكا فقلت: كيف كان ابن مسعود يقول في شان سبيعة؟ قال: قال: «اتجعلون عليها التغليظ ولا تجعلون لها الرخصة، لانزلت سورة النساء القصري بعد الطولي»
 
    
 اخبرنا محمد بن سلمة، اخبرنا ابن القاسم، عن مالك، عن سعد بن اسحاق بن كعب بن عجرة، عن عمته زينب بنت كعب بن عجرة، ان الفريعة بنت مالك بن سنان، وهي اخت ابي سعيد الخدري اخبرتها انها جاءت الي رسول الله صلي الله عليه وسلم تساله: اترجع الي اهلها بني خدرة فان زوجها خرج في طلب اعبد له ابقوا حتي اذا كانوا في طرف القدوم لحقهم فقتلوه، قالت: فسالت رسول الله صلي الله عليه وسلم ان ارجع الي اهلي، فان زوجي لم يتركني في مسكن يملكه ولا نفقة، قالت: فقال رسول الله صلي الله عليه وسلم: «نعم» فخرجت حتي اذا كنت في الحجرة، او في المسجد، دعاني او امر بي فدعيت فقال: «كيف قلت؟» قالت: فرددت عليه، فقال: «امكثي في بيتك حتي يبلغ الكتاب اجله» فاعتددت اربعة اشهر وعشرا، فلما كان عثمان ارسل الي فاخبرته، فاتبعه وقضي به
 
    
 عن عمرو بن منصور، عن عبد الله بن يوسف، عن مالك، عن عبد الله بن ابي بكر بن حزم، عن حميد بن نافع، عن زينب بنت ابي سلمة، قالت " دخلت علي ام حبيبة، حين توفي ابوها ابو سفيان، فدعت بطيب، فدهنت منه جارية، ثم مست بعارضيها، ثم قالت: والله ما لي بالطيب من حاجة، غير اني سمعت رسول الله صلي الله عليه وسلم يقول: «لا يحل لامراة تءمن بالله واليوم الاخر ان تحد علي ميت فوق ثلاث، الا علي زوج اربعة اشهر وعشرا»
 
  قوله جل ثناءه: {حافظوا علي الصلوات والصلاة الوسطي} 
 [البقرة: ]
 
    
 اخبرنا اسحاق بن ابراهيم، اخبرنا عيسي، عن الاعمش، عن مسلم، عن شتير بن شكل، عن علي، عليه السلام قال: شغلوا النبي صلي الله عليه وسلم عن صلاة العصر حتي صلاها بين صلاتي العشاء، فقال: «شغلونا عن صلاة الوسطي، ملا الله بيوتهم وقبورهم نارا»
 
    
 اخبرنا قتيبة بن سعيد، عن مالك، والحارث بن مسكين قراءة عليه وانا اسمع عن ابن القاسم، قال: حدث مالك، عن زيد بن اسلم، عن القعقاع بن حكيم، عن ابي يونس، مولي عاءشة زوج النبي صلي الله عليه وسلم انه قال: امرتني عاءشة ان اكتب لها مصحفا وقالت: " اذا بلغت هذه الاية فاذني {حافظوا علي الصلوات والصلاة الوسطي} [البقرة: ] فلما بلغتها اذنتها فاملت علي: حافظوا علي الصلوات والصلاة الوسطي وصلاة العصر وقوموا لله قانتين، ثم قالت: سمعتها من رسول الله صلي الله عليه وسلم "
 
  قوله جل ثناءه: {وقوموا لله قانتين} 
 [البقرة: ]
 
    
 اخبرنا سويد بن نصر، اخبرنا عبد الله، عن اسماعيل بن ابي خالد، عن الحارث وهو ابن شبيل، عن ابي عمرو الشيباني، عن زيد بن ارقم، قال: " كنا في عهد النبي صلي الله عليه وسلم يكلم احدنا صاحبه في الصلاة في حاجته، حتي نزلت هذه الاية {حافظوا علي الصلوات والصلاة الوسطي وقوموا لله قانتين} [البقرة: ] فامرنا حينءذ بالسكوت "
 
  قوله تعالي: {لا اكراه في الدين} 
 [البقرة: ]
 
    
 اخبرنا ابراهيم بن يونس بن محمد، اخبرنا عثمان بن عمر، اخبرنا شعبة، عن ابي بشر، عن سعيد بن جبير، عن ابن عباس، قال: " كانت المراة من الانصار لا يكون لها ولد تجعل علي نفسها لءن كان لها ولد لتهودنه، فلما اسلمت الانصار قالوا: كيف نصنع بابناءنا؟ فنزلت هذه الاية {لا اكراه في الدين} [البقرة: ]
 
  قوله تعالي: {قد تبين الرشد من الغي} 
 [البقرة: ]
 
    
 اخبرنا محمد بن بشار، في حديثه، عن ابن ابي عدي، عن شعبة، عن ابي بشر، عن سعيد بن جبير، عن ابن عباس، قال: " كانت المراة تجعل علي نفسها ان عاش لها ولد ان تهوده، فلما اجليت بنو النضير كان فيهم من ابناء الانصار قالوا: لا ندع ابناءنا، فانزل الله عز وجل {لا اكراه في الدين قد تبين الرشد من الغي} [البقرة: ]
 
  قوله تعالي: {واذ قال ابراهيم رب ارني كيف تحيي الموتي} 
 [البقرة: ]
 
    
 اخبرنا عمرو بن منصور، حدثنا عبد الله بن محمد، حدثنا جويرية، عن مالك بن انس، عن الزهري، ان سعيد بن المسيب، وابا عبيد اخبراه، عن ابي هريرة: ان النبي صلي الله عليه وسلم قال: " رحم الله ابراهيم نحن احق بالشك منه، قال: {رب ارني كيف تحيي الموتي قال اولم تءمن قال بلي ولكن ليطمءن قلبي} [البقرة: ] فذكر الاية «ويرحم الله لوطا كان ياوي الي ركن شديد، ولو لبثت في السجن ما لبث يوسف، ثم جاءني الداعي لاجبته»
 
  قوله تعالي: {الشيطان يعدكم الفقر} 
 [البقرة: ]
 
    
 اخبرنا هناد بن السري، عن ابي الاحوص، عن عطاء، عن مرة، عن عبد الله، قال: قال رسول الله صلي الله عليه وسلم: " ان للشيطان لمة، وللملك لمة، فاما لمة الشيطان فايعاد بالشر، وتكذيب بالحق، واما لمة الملك فايعاد بالخير، وتصديق بالحق، فمن وجد من ذلك فليعلم انه من الله، فليحمد الله، ومن وجد من الاخر فليتعوذ من الشيطان، ثم قرا {الشيطان يعدكم الفقر ويامركم بالفحشاء والله يعدكم مغفرة منه وفضلا} [البقرة: ]
 
  قوله تعالي: {ليس عليك هداهم} 
 [البقرة: ]
 
    
 اخبرنا محمد بن عبد الله بن عبد الرحيم، حدثنا الفريابي، حدثنا سفيان، عن الاعمش، عن جعفر بن اياس، عن سعيد بن جبير، عن ابن عباس، قال: " كانوا يكرهون ان يرضخوا لانسباءهم من المشركين فسالوا، فرضخ لهم، فنزلت هذه الاية {ليس عليك هداهم ولكن الله يهدي من يشاء وما تنفقوا من خير فلانفسكم وما تنفقون الا ابتغاء وجه الله وما تنفقوا من خير يوف اليكم وانتم لا تظلمون} [البقرة: ]
 
  قوله تعالي: {لا يسالون الناس الحافا} 
 [البقرة: ]
 
    
 اخبرنا علي بن حجر، حدثنا اسماعيل، حدثنا شريك، عن عطاء بن يسار، عن ابي هريرة: ان رسول الله صلي الله عليه وسلم قال: " ليس المسكين الذي ترده التمرة والتمرتان، واللقمة واللقمتان، ان المسكين المتعفف، اقرءوا ان شءتم {لا يسالون الناس الحافا} [البقرة: ]
 
  قوله تعالي: {الذين ياكلون الربا} 
 [البقرة: ]
 
    
 اخبرنا ابو بكر بن حفص، عن المعتمر وهو ابن سليمان، عن ابيه، عن مغيرة، عن ابراهيم، قال: قلت لعلقمة: اقال عبد الله: " لعن النبي صلي الله عليه وسلم اكل الربا وموكله وشاهديه وكاتبه؟ قال: اكل الربا وموكله، قلت: وشاهديه وكاتبه؟ قال: انما نحدث بما سمعنا "
 
  قوله تعالي: {واحل الله البيع وحرم الربا} 
 [البقرة: ]
 
    
 اخبرنا محمود بن غيلان، حدثنا ابو داود، اخبرنا شعبة، عن الاعمش، واخبرنا بشر بن خالد، اخبرنا غندر، عن شعبة، عن سليمان، قال: سمعت ابا الضحي، عن مسروق، عن عاءشة، قالت: «لما نزلت الايات الاواخر من سورة البقرة خرج رسول الله صلي الله عليه وسلم الي المسجد فقراهن في المسجد، وحرم التجارة في الخمر» واللفظ لمحمود
 
  قوله تعالي: {يمحق الله الربا} 
 [البقرة: ]
 
    
 اخبرنا محمود بن غيلان، حدثنا وكيع، حدثنا سفيان، عن منصور، عن ابي الضحي، عن مسروق، عن عاءشة: «لما نزلت ايات الربا قام رسول الله صلي الله عليه وسلم علي المنبر فتلاهن علي الناس، ثم حرم التجارة في الخمر»
 
  قوله تعالي: {واتقوا يوما ترجعون فيه الي الله} 
 [البقرة: ]
 
    
 اخبرنا الحسين بن حريث، اخبرنا الفضل بن موسي، عن الحسين بن واقد، عن يزيد، عن عكرمة، عن ابن عباس قال: " اخر شء نزل من القران: {واتقوا يوما ترجعون فيه الي الله} [البقرة: ]
 
    
 اخبرنا محمد بن عقيل، اخبرنا علي بن الحسين، حدثني ابي، حدثني يزيد، عن عكرمة، عن ابن عباس في قوله: {واتقوا يوما ترجعون فيه الي الله، ثم توفي كل نفس ما كسبت وهم لا يظلمون} [البقرة: ] انها اخر اية انزلت علي رسول الله صلي الله عليه وسلم
 
  قوله تعالي {وان تبدوا ما في انفسكم او تخفوه} 
 [البقرة: ]
 
    
 اخبرنا محمود بن غيلان، اخبرنا وكيع، حدثنا سفيان، عن ادم بن سليمان، عن سعيد بن جبير، عن ابن عباس قال: لما نزلت هذه الاية: {وان تبدوا ما في انفسكم او تخفوه يحاسبكم به الله} [البقرة: ] دخل قلوبهم منها شء لم يدخله من شء، فقال النبي صلي الله عليه وسلم: " قولوا سمعنا واطعنا وسلمنا، فالقي الله الايمان في قلوبهم فانزل الله عز وجل {امن الرسول بما انزل اليه من ربه والمءمنون} [البقرة: ] الاية {لا يكلف الله نفسا الا وسعها لها ما كسبت وعليها ما اكتسبت ربنا لا تءاخذنا ان نسينا او اخطانا} [البقرة: ] قال: قد فعلت {ربنا ولا تحمل علينا اصرا كما حملته علي الذين من قبلنا} [البقرة: ] قال: قد فعلت {ربنا ولا تحملنا ما لا طاقة لنا به، واعف عنا، واغفر لنا، وارحمنا، انت مولانا، فانصرنا علي القوم الكافرين} [البقرة: ] قال: قد فعلت "
 
    سورة ال عمران
 بسم الله الرحمن الرحيم
 
  قوله تعالي: {ان مثل عيسي عند الله كمثل ادم خلقه من تراب ثم قال له كن فيكون} 
 [ال عمران: ]
 
    
 اخبرنا قتيبة بن سعيد، حدثنا يعقوب، عن عمرو، عن الاعرج، عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال: " احتج ادم وموسي عليهما السلام فقال له موسي: يا ادم، خلقك الله بيده، ونفخ فيك من روحه، ثم قال لك: كن فكنت، ثم امر الملاءكة فسجدوا لك، ثم قال: اسكن انت وزوجك الجنة فكلا منها حيث شءتم رغدا، ولا تقربا هذه الشجرة فتكونا من الظالمين فنهاك عن شجرة واحدة فعصيت ربك؟ فقال ادم عليه السلام: يا موسي، الم تعلم ان الله تعالي قدر علي هذا قبل ان يخلقني؟ " فقال رسول الله صلي الله عليه وسلم: «لقد حج ادم موسي، لقد حج ادم موسي، لقد حج ادم موسي»
 
  قوله تعالي: {ثم نبتهل فنجعل لعنة الله علي الكاذبين} 
 [ال عمران: ]
 
    
 اخبرنا عبد الرحمن بن عبيد الله، عن عبيد الله، عن عبد الكريم الجزري، عن عكرمة، عن ابن عباس، قال: قال ابو جهل: لءن رايت محمدا يصلي عند الكعبة اتيته حتي اطا علي عنقه، فقال رسول الله صلي الله عليه وسلم: «لو فعل اخذته الملاءكة عيانا، وان اليهود لو تمنوا الموت لماتوا وراوا مقاعدهم من النار، ولو خرج الذين يباهلون رسول الله صلي الله عليه وسلم لرجعوا لا يجدون مالا ولا اهلا»
 
  قوله تعالي: {ان الذين يشترون بعهد الله وايمانهم ثمنا قليلا} 
 [ال عمران: ]
 
    
 اخبرنا الهيثم بن ايوب، حدثنا يحيي بن زكريا، عن الاعمش، عن شقيق، قال عبد الله: قال رسول الله صلي الله عليه وسلم: " من حلف علي يمين يقطع بها مالا لقي الله وهو عليه غضبان، وتصديقه في كتاب الله {ان الذين يشترون بعهد الله وايمانهم ثمنا قليلا اولءك لا خلاق لهم في الاخرة} [ال عمران: ] فجاء الاشعث بن قيس فقال: ما يحدثكم ابو عبد الرحمن؟ فقلنا: كذا وكذا، فقال: والله لانزلت في وفي فلان كانت بيني وبينه خصومة، فقال رسول الله صلي الله عليه وسلم: «شهودك او يمينه» قلت: اذن يحلف، قال: «من حلف علي يمين يقطع بها مالا وهو فيها كاذب، لقي الله وهو عليه غضبان» وانزل الله عز وجل الاية "
 
    
 اخبرنا قتيبة بن سعيد، اخبرنا عبد الواحد بن زياد، عن اسماعيل بن سميع، حدثنا مسلم البطين، وعبد الملك بن اعين، عن ابي واءل، قال: قال ابن مسعود: " نزلت هذه الاية {ان الذين يشترون بعهد الله وايمانهم ثمنا قليلا} [ال عمران: ] الي اخر الاية، ثم لم ينسخها شء، فمن اقتطع مال امرء مسلم بيمينه فهو من اهل هذه الاية "
 
  قوله تعالي: {قل يا اهل الكتاب تعالوا الي كلمة سواء بيننا وبينكم} 
 [ال عمران: ]
 
    
 اخبرنا ابو داود سليمان بن سيف، حدثنا يعقوب بن ابراهيم بن سعد، حدثنا ابي، عن صالح، عن ابن شهاب، اخبرني عبيد الله بن عبد الله: ان عبد الله بن عباس قال: اخبرني ابو سفيان بن حرب، انه كان بالشام في رجال من قريش قدموا تجارا في المدة التي كانت بين رسول الله صلي الله عليه وسلم وبين كفار قريش، قال ابو سفيان: فوجدنا رسول قيصر ببعض الشام، فانطلق بي وباصحابي حتي قدمنا ايلياء، فادخلنا عليه فاذا هو جالس في مجلس ملكه وعليه التاج وحوله علماء الروم، فقال لترجمانه: سلهم ايهم اقرب نسبا الي هذا الرجل الذي يزعم انه نبي، قال ابو سفيان: انا اقربهم اليه نسبا، فقال: ما قرابة ما بينك وبينه؟ فقلت: هو ابن عمي، قال: وليس في الركب يومءذ رجل من بني عبد مناف غيري، قال: فقال قيصر: ادنوه مني، ثم امر باصحابي فجعلوا خلف ظهري عند كتفي، ثم قال لترجمانه: قل لاصحابه اني ساءل هذا عن هذا الرجل الذي يزعم انه نبي، فان كذب فكذبوه، قال ابو سفيان: والله لولا الحياء يومءذ ان ياثر علي اصحابي الكذب لحدثته عنه حين سالني، ولكن استحييت ان ياثروا علي الكذب فصدقته عنه، ثم قال لترجمانه: قل له: كيف نسب هذا الرجل فيكم؟ قلت: هو فينا ذو نسب، قال: فقال: هل قال هذا القول منكم احد قبله؟ قلت: لا، قال: فهل كنتم تتهمونه بالكذب قبل ان يقول ما قال؟ قلت: لا، قال: فهل كان من اباءه من ملك؟ قلت: لا، قال: فاشراف الناس اتبعوه ام ضعفاءهم؟ قلت: بل ضعفاءهم
  [ص: ]
 ، قال: فيزيدون ام ينقصون؟ قلت: بل يزيدون، قال: فهل يرتد احد سخطة لدينه بعد ان يدخل فيه، قلت: لا، قال: فهل يغدر؟ قلت: لا، ونحن منه الان في مدة، ونحن نخاف ان يغدر، قال ابو سفيان: ولم تمكني كلمة ادخل فيها شيءا انتقصه بها اخاف ان تءثر عني غيرها، قال: فهل قاتلتموه، وهل قاتلكم؟ فقلت: نعم، قال: فكيف كان حربكم وحربه؟ قلت: كانت دولا وسجالا، يدال علينا المرة، وندال عليه الاخري، قال: فما كان يامركم به؟ قلت: " يامرنا ان نعبد الله وحده ولا نشرك به شيءا، ونهانا عما كان يعبد اباءنا، ويامرنا بالصلاة والصدق والعفاف والوفاء بالعهد، واداء الامانة، فقال لترجمانه حين قلت ذلك: قل له اني سالتك عن نسبه فيكم، فزعمت انه فيكم ذو نسب، وكذلك الرسل تبعث في نسب قومها، وسالتك هل قال هذا القول احد منكم قبله، فزعمت ان لا، فقلت: ان لو قال هذا القول احد منكم قبله، قلت: رجل ياتم بقول قيل قبله، وسالتك: هل كنتم تتهمونه بالكذب قبل ان يقول ما قال، فزعمت ان لا، فقد علمت انه لم يكن ليذر الكذب علي الناس ويكذب علي الله، وسالتك: هل كان من اباءه من ملك، فزعمت ان لا، فقلت: ان لو كان من اباءه ملك لقلت: رجل يطلب ملك اباءه، وسالتك: اشراف الناس اتبعوه ام ضعفاءهم، فزعمت ان ضعفاءهم اتبعوه، وهم اتباع الرسل، وسالتك: هل يزيدون ام ينقصون، فزعمت انهم يزيدون، وكذلك الايمان حتي يتم، وسالتك: هل يرتد احد سخطة لدينه بعد ان يدخل فيه، فزعمت ان لا، وكذلك الايمان حين يخالط بشاشة القلب لا يبغضه احد، وسالتك: هل يغدر، فزعمت ان لا، وكذلك الرسل لا تغدر
  [ص: ]
 ، وسالتك: هل قاتلتموه وقاتلكم، فزعمت ان قد فعل، وان حربكم وحربه تكون دولا، يدال عليكم المرة، وتدالون عليه الاخري، وكذلك الرسل، تبتلي ويكون لها العاقبة، وسالتك: بماذا امركم، فزعمت انه يامركم ان تعبدوا الله وحده ولا تشركوا به شيءا، وينهاكم عما كان يعبد اباءكم، ويامركم بالصلاة والصدق والعفاف والوفاء بالعهد واداء الامانات، قال: وهذه صفة نبي قد كنت اعلم انه خارج، ولم اكن اظن انه منكم، وان يكن ما قلت حقا، فيوشك ان يملك موضع قدمي هاتين، فوالله لو ارجو ان اخلص اليه لتجشمت لقيه، ولو كنت عنده غسلت عن قدميه، قال ابو سفيان: ثم دعا بكتاب رسول الله صلي الله عليه وسلم فامر به فقرء، فاذا فيه: بسم الله الرحمن الرحيم، من محمد عبد الله ورسوله، الي هرقل عظيم الروم، سلام علي من اتبع الهدي، اما بعد، فاني ادعوك بدعاية الاسلام، اسلم تسلم، واسلم يءتك الله اجرك مرتين، وان توليت فان عليك اثم الاريسيين، و {قل يا اهل الكتاب تعالوا الي كلمة سواء بيننا وبينكم الا نعبد الا الله، ولا نشرك به شيءا، ولا يتخذ بعضنا بعضا اربابا من دون الله، فان تولوا فقولوا اشهدوا بانا مسلمون} [ال عمران: ] قال ابو سفيان: فلما قضي مقالته علت اصوات الروم حوله من عظماء الروم، وكثر لغطهم، فلا ادري ماذا قالوا، وامر بنا فاخرجنا، قال ابو سفيان: فلما خرجت مع اصحابي وخلصت بهم قلت: لقد امر امر ابن ابي كبشة، هذا ملك بني الاصفر يخافه، قال ابو سفيان: فوالله ما زلت ذليلا مستيقنا بان امره سيظهر حتي ادخل الله قلبي الاسلام وانا كاره
 
  قوله تعالي: {كيف يهدي الله قوما كفروا بعد ايمانهم} 
 [ال عمران: ]
 
    
 اخبرنا محمد بن عبد الله بن بزيع، حدثنا يزيد وهو ابن زريع، حدثنا داود، عن عكرمة، عن ابن عباس، قال: " كان رجل من الانصار اسلم ثم ارتد ولحق بالشرك، ثم ندم فارسل الي قومه: سلوا رسول الله صلي الله عليه وسلم: هل لي من توبة؟ فجاء قومه الي رسول الله صلي الله عليه وسلم فقالوا: ان فلانا قد ندم، وانه قد امرنا ان نسالك: هل له من توبة؟ فنزلت {كيف يهدي الله قوما كفروا بعد ايمانهم} [ال عمران: ] الي {غفور رحيم} [البقرة: ] فارسل اليه فاسلم "
 
  قوله تعالي: {لن تنالوا البر حتي تنفقوا مما تحبون} 
 [ال عمران: ]
 
    
 اخبرني هارون بن عبد الله، حدثنا معن، حدثنا مالك، عن اسحاق بن عبد الله بن ابي طلحة، عن انس: ان ابا طلحة، كان اكثر انصاري مالا بالمدينة بالنخل، وكان احب امواله اليه بيرحاء، وكانت مستقبلة المسجد، وكان رسول الله صلي الله عليه وسلم يدخلها فياكل من ثمرها، ويشرب من ماء فيها طيب، قال انس: فلما نزلت هذه الاية {لن تنالوا البر حتي تنفقوا مما تحبون} [ال عمران: ] قام ابو طلحة الي رسول الله صلي الله عليه وسلم فقال: يا رسول الله، ان الله يقول: {لن تنالوا البر حتي تنفقوا مما تحبون} [ال عمران: ] وان احب اموالي الي بيرحاء، وانها صدقة لله، ارجو برها وذخرها عند الله، فضعها يا رسول الله حيث اراك الله، فقال رسول الله صلي الله عليه وسلم: «بخ ذلك مال رابح، وقد سمعت ما قلت، واني اري ان تجعله في الاقربين» فقال ابو طلحة: افعل يا رسول الله، فقسمها ابو طلحة بين اقرباءه وبني عمه
 
    
 اخبرنا ابو بكر بن نافع، حدثنا بهز، حدثنا حماد بن سلمة، حدثنا ثابت، عن انس، قال: لما نزلت {لن تنالوا البر حتي تنفقوا مما تحبون} [ال عمران: ] قال ابو طلحة: اري ربنا يسالنا اموالنا، فاشهدك يا رسول الله، اني قد جعلت ارضي لله، فقال رسول الله صلي الله عليه وسلم: «اجعلها في قرابتك» فجعلها في حسان بن ثابت، وابي بن كعب
 
  قوله تعالي: {فاتوا بالتوراة فاتلوها ان كنتم صادقين} 
 [ال عمران: ]
 
    
 اخبرنا يحيي بن حبيب بن عربي، من كتابه، حدثنا يزيد يعني ابن زريع، حدثنا شعبة، حدثنا ايوب، عن نافع، عن ابن عمر، انه حدثه لما رفعا الي النبي صلي الله عليه وسلم قال: «ما تجدون في كتابكم؟» قالوا: لا نجد الرجم، فقال عبد الله بن سلام: كذبوا، الرجم في كتابهم، فقيل: {فاتوا بالتوراة فاتلوها ان كنتم صادقين} [ال عمران: ] فجاءوا بالتوراة وجاء قارءهم فوضع كفه علي موضع الرجم، فجعل يقرا ما خلا ذلك، قال عبد الله بن سلام: ادخل كفك، فاذا هو بالرجم يلوح، فامر نبي الله صلي الله عليه وسلم بهما فرجما "
 
  قوله تعالي: {ان اول بيت وضع للناس} 
 [ال عمران: ]
 
    
 اخبرنا بشر بن خالد، حدثنا غندر، عن شعبة، عن سليمان، قال: سمعت ابراهيم يحدث عن ابيه، عن ابي ذر عن النبي صلي الله عليه وسلم انه ساله عن اول مسجد وضع للناس، قال: «مسجد الحرام، وبيت المقدس» فسءل: كم بينهما؟ قال: «اربعون عاما، وحيث ما ادركتك الصلاة فصل، فثم مسجد»
 
  قوله تعالي: {يا ايها الذين امنوا اتقوا الله حق تقاته} 
 [ال عمران: ]
 
    
 اخبرنا بشر بن خالد، حدثنا غندر، عن شعبة، عن سليمان، عن مجاهد، عن ابن عباس، قال: قال رسول الله صلي الله عليه وسلم: {يا ايها الذين امنوا اتقوا الله حق تقاته ولا تموتن الا وانتم مسلمون} [ال عمران: ] لو ان قطرة من الزقوم قطرت علي الارض لامرت علي اهل الارض معيشتهم، فكيف من هو طعامه او ليس له طعام غيره "
 
  قوله تعالي: {كنتم خير امة اخرجت للناس} 
 [ال عمران: ]
 
    
 اخبرنا محمد بن عبد الله بن المبارك، حدثنا ابو داود الحفري، عن سفيان، عن ميسرة، عن ابي حازم، عن ابي هريرة، قال: {كنتم خير امة اخرجت للناس} [ال عمران: ] قال: نحن خير الناس للناس، نجء بهم الاغلال في اعناقهم، فندخلهم في الاسلام "
 
    
 اخبرنا قتيبة بن سعيد، حدثنا عمرو، حدثنا اسراءيل، عن سماك، عن سعيد بن جبير، عن ابن عباس، في قول الله تعالي: {كنتم خير امة اخرجت للناس} [ال عمران: ] قال: هم الذين هاجروا مع النبي صلي الله عليه وسلم من مكة الي المدينة "
 
  قوله تعالي: {ليسوا سواء من اهل الكتاب} 
 [ال عمران: ]
 
    
 اخبرنا محمد بن رافع، حدثنا ابو النضر، حدثنا ابو معاوية، عن عاصم، عن زر، عن ابن مسعود، قال: اخر رسول الله صلي الله عليه وسلم ليلة صلاة العشاء، ثم خرج الي المسجد فاذا الناس ينتظرون الصلاة، فقال: اما انه ليس من هذه الاديان احد يذكر الله هذه الساعة غيركم " قال: وانزلت هذه الاية {ليسوا سواء من اهل الكتاب} [ال عمران: ] حتي بلغ {والله عليم بالمتقين} [ال عمران: ]
 
  قوله تعالي: {ولقد نصركم الله ببدر وانتم اذلة} 
 [ال عمران: ]
 
    
 اخبرنا قتيبة بن سعيد، حدثنا الليث، عن ابي الزبير، عن جابر، ان عبدا لحاطب جاء الي رسول الله صلي الله عليه وسلم يشكو حاطبا، فقال: يا رسول الله، ليدخلن حاطب النار، فقال رسول الله صلي الله عليه وسلم: «كذبت، لا يدخلها فانه شهد بدرا والحديبية»
 
  قوله تعالي: {ليس لك من الامر شء} 
 [ال عمران: ]
 
    
 اخبرنا اسحاق بن ابراهيم، اخبرنا عبد الرزاق، حدثنا معمر، عن الزهري، عن سالم، عن ابيه انه سمع رسول الله صلي الله عليه وسلم يكبر حين يرفع راسه في صلاة الصبح من الركعة الاخيرة يقول: «اللهم العن فلانا وفلانا» دعا علي ناس من المنافقين، فانزل الله عز وجل {ليس لك من الامر شء او يتوب عليهم او يعذبهم فانهم ظالمون} [ال عمران: ]
 
    
 اخبرنا عمرو بن الحارث، حدثنا محبوب بن موسي، اخبرنا ابن المبارك، عن معمر، عن الزهري، قال: حدثني سالم، عن ابيه انه سمع رسول الله صلي الله عليه وسلم اذا رفع راسه من الركوع في الركعة الاخيرة من الفجر يقول: " اللهم العن فلانا وفلانا بعدما يقول: «سمع الله لمن حمده، ربنا ولك الحمد» فانزل الله تبارك وتعالي {ليس لك من الامر شء او يتوب عليهم او يعذبهم فانهم ظالمون} [ال عمران: ]
 
    
 اخبرنا علي بن حجر، اخبرنا اسماعيل بن ابراهيم، عن حميد، عن انس، واخبرنا محمد بن المثني، عن خالد، حدثنا حميد، قال: قال انس: كسرت رباعية رسول الله صلي الله عليه وسلم يوم احد وشج، فجعل الدم يسيل علي وجهه، ومسح الدم عن وجهه ويقول: «كيف يفلح قوم خضبوا وجه نبيهم وهو يدعوهم الي الاسلام؟» فانزل الله تبارك وتعالي {ليس لك من الامر شء او يتوب عليهم او يعذبهم فانهم ظالمون} [ال عمران: ] اللفظ لخالد
 
  قوله تعالي: {والذين اذا فعلوا فاحشة او ظلموا انفسهم ذكروا الله، فاستغفروا لذنوبهم ومن يغفر الذنوب الا الله} 
 [ال عمران: ]
 
    
 اخبرنا قتيبة بن سعيد، حدثنا ابو عوانة، عن عثمان بن المغيرة، عن علي بن ربيعة، عن اسماء بن الحكم الفزاري، قال: سمعت عليا رضي الله عنه يقول: اني كنت رجلا اذا سمعت من رسول الله صلي الله عليه وسلم حديثا ينفعني الله منه بما شاء ان ينفعني، فاذا حدثني رجل من اصحابه استحلفته، فاذا حلف لي صدقته، حدثني ابو بكر، وصدق ابو بكر رضي الله عنه قال: سمعت رسول الله صلي الله عليه وسلم يقول: «ما من رجل يذنب ذنبا ثم يقوم فيتطهر فيحسن الطهور، ثم يستغفر الله تبارك وتعالي الا غفر له» ثم قرا هذه الاية {والذين اذا فعلوا فاحشة او ظلموا انفسهم} [ال عمران: ] الي اخر الاية "
 
  قوله تعالي: {والرسول يدعوكم في اخراكم} 
 [ال عمران: ]
 
    
 اخبرني هلال بن العلاء، حدثنا حسين بن عياش، حدثنا زهير، حدثنا ابو اسحاق، قال: سمعت البراء بن عازب، يحدث قال: جعل رسول الله صلي الله عليه وسلم علي الرماة يوم احد، وكانوا خمسين رجلا عبد الله بن جبير قال: ووضعهم مكانا وقال لهم: «ان رايتمونا تخطفنا الطير فلا تبرحوا من مكانكم هذا حتي ارسل اليكم، فان رايتمونا هزمنا القوم واوطاناهم، فلا تبرحوا حتي ارسل اليكم» قال: وسار رسول الله صلي الله عليه وسلم ومن معه، قال: فهزمهم قال: فاما والله رايت النساء يشتددن علي الجبل بدت خلاخلهن واسوقهن رافعات ثيابهن، فقال اصحاب عبد الله بن جبير: الغنيمة، اي قوم الغنيمة، قد ظهر اصحابكم فماذا تنتظرون، قال عبد الله بن جبير: انسيتم ما قال لكم رسول الله صلي الله عليه وسلم؟ فقالوا: انا والله لناتين الناس فلنصيبن من الغنيمة، فلما اتوهم صرفت وجوههم، فاقبلوا منهزمين، فذاك حين يدعوهم الرسول في اخراهم، فلم يبق مع رسول الله صلي الله عليه وسلم غير اثني عشر رجلا، فاصابوا منا سبعين
  [ص: ]
 ، وكان رسول الله صلي الله عليه وسلم واصحابه اصاب من المشركين يوم بدر اربعين وماءة، سبعين اسيرا، وسبعين قتيلا، فقال ابو سفيان: افي القوم محمد؟ افي القوم محمد؟ فنهاهم رسول الله صلي الله عليه وسلم ان يجيبوه، ثم قال: افي القوم ابن ابي قحافة؟ ثلاث مرات، قال: افي القوم ابن الخطاب؟ ثلاث مرات، ثم رجع الي اصحابه فقال: اما هءلاء فقد قتلوا، فما ملك عمر نفسه فقال: كذبت يا عدو الله، ان الذي عددت لاحياء كلهم، وقد بقي لك ما يسوءك، فقال: يوم بيوم بدر، والحروب سجال، انكم سترون في القوم مثلة لم امر بها، ولم تسءني، ثم اخذ يرتجز: اعل هبل، فقال رسول الله صلي الله عليه وسلم: «الا تجيبوه؟» فقالوا: يا رسول الله، ما نقول؟ قال: " قولوا: الله اعلي واجل " قال: ان لنا عزي ولا عزي لكم، قال رسول الله صلي الله عليه وسلم: «الا تجيبوه» قالوا: يا رسول الله، ما نقول؟ قال: " قولوا: الله مولانا ولا مولي لكم "
 
  قوله تعالي: {اذ يغشيكم النعاس امنة} 
 [الانفال: ]
 
    
 اخبرنا محمد بن المثني، قال: حدثنا خالد، حدثنا حميد، قال انس: قال ابو طلحة: «كنت ممن القي عليه النعاس يوم احد حتي سقط السيف من يدي ثلاثا»
 
  قوله تعالي: {الذين قال لهم الناس ان الناس قد جمعوا لكم} 
 [ال عمران: ]
 
    
 اخبرنا محمد بن اسماعيل بن ابراهيم، وهارون بن عبد الله، قالا: حدثنا يحيي بن ابي بكير، حدثنا ابو بكر بن عياش، عن ابي حصين، عن ابي الضحي، عن ابن عباس، قال: " كان اخر كلام ابراهيم عليه السلام حين القي في النار: حسبي الله ونعم الوكيل، قال: وقال نبيكم صلي الله عليه وسلم مثلها {الذين قال لهم الناس ان الناس قد جمعوا لكم، فاخشوهم فزادهم ايمانا وقالوا حسبنا} [ال عمران: ] الله ونعم الوكيل
 
    
 اخبرنا اسماعيل بن يعقوب بن اسماعيل، حدثنا ابن موسي، حدثنا ابي، عن الاعمش، عن ابي صالح، عن ابي هريرة وذكر اسنادا اخر قال: قال رسول الله صلي الله عليه وسلم: «كيف انعم، وصاحب الصور قد التقم القرن واصغي بسمعه وحنا بجبهته ينتظر متي يءمر فينفخ؟» قالوا: يا رسول الله، كيف نقول؟ قال: " قولوا: {حسبنا الله ونعم الوكيل} [ال عمران: ] علي الله توكلنا "
 
  قوله تعالي: {فانقلبوا بنعمة من الله وفضل} 
 [ال عمران: ]
 
    
 اخبرنا محمد بن منصور، عن سفيان، عن عمرو، عن عكرمة، قال: قال ابن عباس: لما انصرف المشركون عن احد وبلغوا الروحاء، قالوا: لا محمدا قتلتموه، ولا الكواعب اردفتم، وبءس ما صنعتم ارجعوا، فبلغ ذلك رسول الله صلي الله عليه وسلم فندب الناس فانتدبوا حتي بلغوا حمراء الاسد وبءر ابي عنبة، فانزل الله تعالي: {الذين استجابوا لله والرسول من بعد ما اصابهم القرح} [ال عمران: ] وقد كان ابو سفيان قال للنبي صلي الله عليه وسلم: موعدك موسم بدر حيث قتلتم اصحابنا، فاما الجبان فرجع، واما الشجاع فاخذ اهبة القتال والتجارة، فلم يجدوا به احدا وتسوقوا، فانزل الله تعالي {فانقلبوا بنعمة من الله وفضل لم يمسسهم سوء} [ال عمران: ]
 
  قوله تعالي: {سيطوقون ما بخلوا به} 
 [ال عمران: ]
 
    
 اخبرنا مجاهد بن موسي، حدثنا ابن عيينة، عن جامع بن ابي راشد، عن ابي واءل، عن عبد الله، قال: قال رسول الله صلي الله عليه وسلم: «ما من رجل له مال لا يءدي حق ماله الا جعل له طوقا في عنقه شجاع اقرع فهو يفر منه وهو يتبعه» قال: ثم قرا مصداقه من كتاب الله {ولا يحسبن الذين يبخلون} [ال عمران: ] الي قوله: {يوم القيامة} [ال عمران: ]
 
  قوله تعالي: {فمن زحزح عن النار وادخل الجنة فقد فاز} 
 [ال عمران: ]
 
    
 اخبرنا محمد بن حاتم بن نعيم، اخبرنا سويد، اخبرنا عبد الله، عن شريك، عن محمد بن عمرو، عن ابي سلمة، عن ابي هريرة عن النبي صلي الله عليه وسلم قال: " قال الله تبارك وتعالي: اعددت لعبادي الصالحين ما لا عين رات، ولا اذن سمعت، ولا خطر علي قلب بشر، وان شءتم فاقرءوا {فلا تعلم نفس ما اخفي لهم من قرة اعين} [السجدة: ] وقال: " في الجنة شجرة يسير الراكب في ظلها ماءة عام، فاقرءوا {وظل ممدود} [الواقعة: ]، وموضع سوط في الجنة خير من الدنيا وما فيها، فاقرءوا {فمن زحزح عن النار وادخل الجنة فقد فاز وما الحياة الدنيا الا متاع الغرور} [ال عمران: ]
 
  قوله تعالي: {لا تحسبن الذين يفرحون بما اتوا} 
 [ال عمران: ]
 
    
 اخبرنا الحسن بن محمد، حدثنا حجاج، قال ابن جريج: اخبرنا، واخبرنا، يوسف بن سعيد، حدثنا حجاج، عن ابن جريج، قال: اخبرني ابن ابي مليكة، ان حميد بن عبد الرحمن بن عوف اخبره، ان مروان قال: اذهب يا رافع، لبوابه، الي ابن عباس فقل: لءن كان كل امرء منا فرح بما اتي واحب ان يحمد بما لم يفعل معذبا، لنعذبن اجمعون، فقال ابن عباس: مالكم ولهذه الاية، انما نزلت هذه في اهل الكتاب، ثم تلا ابن عباس: {واذ اخذ الله ميثاق الذين اوتوا الكتاب لتبيننه للناس} [ال عمران: ]، تلا ابن عباس {لا تحسبن الذين يفرحون بما اتوا ويحبون ان يحمدوا بما لم يفعلوا} [ال عمران: ] قال ابن عباس: سالهم النبي صلي الله عليه وسلم عن شء فكتموه، واخبروه بغيره، فخرجوا وقد اروه انهم اخبروه بما سالهم عنه واستحمدوا بذلك اليه، وفرحوا بما اتو من كتمانهم اياه ما سالهم عنه "
 
  قوله تعالي: {ان في خلق السموات والارض}
 
    
 اخبرنا قتيبة بن سعيد، عن مالك، عن مخرمة بن سليمان، عن كريب مولي ابن عباس: ان ابن عباس اخبره انه بات ليلة عند ميمونة زوج النبي صلي الله عليه وسلم وهي خالته، فاضطجعت في عرض الوسادة، واضطجع رسول الله صلي الله عليه وسلم واهله في طولها، فنام رسول الله صلي الله عليه وسلم حتي اذا انتصف الليل او قبله بقليل او بعده بقليل استيقظ رسول الله صلي الله عليه وسلم يمسح النوم عن وجهه، ثم قرا العشر الايات الخواتم من سورة ال عمران، ثم قام الي شن معلقة، فتوضا منها وضوءه، ثم قام يصلي، قال ابن عباس: فقمت فصنعت مثل ما صنع، وذهبت فقمت الي جنبه، فوضع رسول الله صلي الله عليه وسلم يده اليمني علي راسي، واخذ باذني يفتلها، فصلي ركعتين، ثم ركعتين، ثم ركعتين، ثم ركعتين، ثم ركعتين، ثم ركعتين، ثم اوتر فاضطجع حتي جاءه المءذن، ثم قام فصلي ركعتين، ثم خرج فصلي الصبح
 
    
 اخبرنا عمرو بن منصور، اخبرنا يزيد بن مهران، حدثنا ابو بكر بن عياش، عن حميد، عن انس، قال: لما جاء نعي النجاشي قال رسول الله صلي الله عليه وسلم: «صلوا عليه» قالوا: يا رسول الله، نصلي علي عبد حبشي؟ فانزل الله عز وجل {وان من اهل الكتاب لمن يءمن بالله وما انزل اليكم وما انزل اليهم خاشعين} [ال عمران: ] الاية،
    
 اخبرنا عمرو بن منصور، حدثنا يزيد بن مهران ابو خالد الخباز، اخبرنا ابو بكر بن عياش، عن حميد، عن الحسن، مثله
 
