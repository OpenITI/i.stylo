 >  قوله تعالي : ( وقل للذين لا يءمنون اعملوا علي مكانتكم ) تهديد ووعيد ( انا عاملون وانتظروا انا منتظرون ) تهديد اخر وقد تقدم معناه قوله تعالي : ( ولله غيب السماوات والارض ) اي غيبهما وشهادتهما فحذف لدلالة المعني وقال بن عباس : خزاءن السماوات والارض وقال الضحاك جميع ما غاب عن العباد فيهما وقال الباقون غيب السماوات والارض نزول العذاب من السماء وطلوعه من الارض وقال ابو علي الفارسي : ولله غيب السماوات والارض اي علم ما غاب فيهما اضاف الغيب وهو مضاف الي المفعول توسعا لانه حذف حرف الجر تقول : غبت في الارض وغبت ببلد كذا ( واليه يرجع الامر كله ) اي يوم القيامة اذ ليس لمخلوق امر الا باذنه وقرا نافع وحفص يرجع بضم الياء وبفتح الجيم اي يرد ( فاعبده وتوكل عليه ) اي الجا اليه وثق به ( وما ربك بغافل عما تعملون ) اي يجازي كلا بعمله وقرا اهل المدينة والشام وحفص بالتاء علي المخاطبة الباقون بياء علي الخبر قال الاخفش سعيد : يعملون اذا لم يخاطب النبي صلي الله عليه وسلم معهم قال : بعضهم وقال : تعملون بالتاء لانه خاطب النبي صلي الله عليه وسلم وقال : قل لهم وما ربك بغافل عما تعملون وقال كعب الاحبار : خاتمة التوراة خاتمة هود من قوله : ولله غيب السماوات والارض الي اخر السورة تمت سورة هود ويتلوها سورة يوسف عليه السلام  <
 > بسم الله الرحمن الرحيم <
 > <
 > تفسير سورة يوسف عليه السلام <
 > وهي مكية كلها وقال بن عباس وقتادة : الا اربع ايات منها وروي ان اليهود سالوا رسول الله صلي الله عليه وسلم عن قصة يوسف فنزلت السورة وسياتي وقال سعد بن ابي وقاص : انزل القران علي رسول الله صلي الله عليه وسلم فتلاه عليهم زمانا فقالوا : لو قصصت علينا فنزل : نحن نقص عليك فتلاه عليهم زمانا فقالوا : لو حدثتنا فانزل الله نزل احسن الحديث قال العلماء : وذكر الله اقاصيص الانبياء في القران وكررها بمعني واحد في وجوه مختلفة بالفاظ متباينة علي درجات البلاغة وقد ذكر قصة يوسف ولم يكررها فلم يقدر مخالف علي معارضة ما تكرر ولا علي معارضة غير المتكرر والاعجاز لمن تامل < <
  يوسف : (  ) الر تلك ايات . . . . .
 > > <
 > ( يوسف  ) <
 > قوله تعالي : ( الر ) تقدم القول فيه والتقدير هنا : تلك ايات الكتاب علي الابتداء والخبر وقيل : الر اسم السورة اي هذه السورة المسماة الر ( تلك ايات الكتاب المبين ) يعني بالكتاب المبين القران المبين اي المبين حلاله وحرامه وحدوده واحكامه وهداه وبركته وقيل : اي هذه تلك الايات التي كنتم توعدون بها في التوراة < <
  يوسف : (  ) انا انزلناه قرانا . . . . .
 > > <
 > ( يوسف  ) <
 > قوله تعالي : ( انا نزلناه قرانا عربيا ) يجوز ان يكون المعني : انا انزلنا القران عربيا نصب قرانا علي الحال اي مجموعا وعربيا نعت لقوله قرانا ويجوز ان يكون توطءة للحال كما تقول : مررت بزيد رجلا صالحا وعربيا علي الحال  اي يقرا بلغتكم يا معشر العرب اعرب بين ومنه ( الثيب تعرب عن نفسها ( لعلكم تعقلون ) اي لكي تعلموا معانيه وتفهموا ما فيه وبعض العرب ياتي بان مع لعل تشبيها بعسي واللام في لعل زاءدة للتوكيد كما قال الشاعر : * يا ابتا علك او عساكا * وقيل : لعلكم تعقلون اي لتكونوا علي رجاء من تدبره فيعود معني الشك اليهم لا الي الكتاب ولا الي الله عز وجل وقيل : معني انزلناه اي انزلنا خبر يوسف قال النحاس : وهذا اشبه بالمعني لانه يروي ان اليهود قالوا : سلوه لم انتقل ال يعقوب من الشام الي مصر وعن خبر يوسف فانزل الله عز وجل هذا بمكة موافقا لما في التوراة وفيه زيادة ليست عندهم فكان هذا للنبي صلي الله عليه وسلم اذ اخبرهم ولم يكن يقرا كتابا قط ولا هو في موضع كتاب بمنزلة احياء عيسي عليه السلام الميت علي ما ياتي فيه < <
  يوسف : (  ) نحن نقص عليك . . . . .
 > > <
 > ( يوسف  ) <
 > قوله تعالي : ( نحن نقص عليك ) ابتداء وخبر ( احسن القصص ) بمعني المصدر والتقدير : قصصنا احسن القصص واصل القصص تتبع الشء ومنه قوله تعالي : وقالت لاخته قصيه اي تتبعي اثره فالقاص يتبع الاثار فيخبر بها والحسن يعود الي القصص لا الي القصة يقال : فلان حسن الاقتصاص للحديث اي جيد السياقة له وقيل : القصص ليس مصدرا بل هو في معني الاسم كما يقال : الله رجاءنا اي مرجونا فالمعني علي هذا : نحن نخبرك باحسن الاخبار ( بما اوحينا اليك ) اي بوحينا ف ما مع الفعل بمنزلة المصدر ( هذا القران ) نصب القران علي انه نعت لهذا او بدل منه او عطف بيان واجاز الفراء الخفض قال : علي التكرير وهو عند البصريين علي البدل من ما  واجاز ابو اسحاق الرفع علي اضمار مبتدا كان ساءلا ساله عن الوحي فقيل له : هو هذا القران ( وان كنت من قبله لمن الغافلين ) اي من الغافلين عما عرفناكه مسالة واختلف العلماء لم سميت هذه السورة احسن القصص من بين ساءر الاقاصيص فقيل : لانه ليست قصة في القران تتضمن من العبر والحكم ماتتضمن هذه القصة وبيانه قوله في اخرها : لقد كان في قصصهم عبرة لاولي الالباب وقيل : سماها احسن القصص لحسن مجاوزة يوسف عن اخوته وصبره علي اذاهم وعفوه عنهم بعد الالتقاء بهم عن ذكر ماتعاطوه وكرمه في العفو عنهم حتي قال لاتثريب عليكم اليوم وقيل : لان فيها ذكر الانبياء والصالحين والملاءكة والشياطين والجن والانس والانعام والطير وسير الملوك والممالك والتجار والعلماء والجهال والرجال والنساء وحيلهن ومكرهن وفيها ذكر التوحيد والفقه والسير وتعبير الرءيا والسياسة والمعاشرة وتدبير المعاش وجمل الفواءد التي تصلح للدين والدنيا وقيل : لان فيها ذكر الحبيب والمحبوب وسيرهما وقيل : احسن هنا بمعني اعجب وقال بعض اهل المعاني : انما كانت احسن القصص لان كل من ذكر فيها كان ماله السعادة انظر الي يوسف وابيه واخوته وامراة العزيز قيل : والملك ايضا اسلم بيوسف وحسن اسلامه ومستعبر الرءيا الساقي والشاهد فيما يقال فما كان امر الجميع الا الي خير < <
  يوسف : (  ) اذ قال يوسف . . . . .
 > > <
 > ( يوسف  ) <
 > قوله تعالي : ( اذ قال يوسف ) اذ في موضع نصب علي الظرف اي اذكر لهم حين قال يوسف وقراءة العامة بضم السين وقرا طلحة بن مصرف يءسف بالهمز وكسر السين وحكي ابو زيد يءسف بالهمز وفتح السين ولم ينصرف لانه اعجمي وقيل : هو عربي وسءل ابو الحسن الاقطع وكان حكيما عن يوسف فقال : الاسف في اللغة  الحزن والاسيف العبد وقد اجتمعا في يوسف فلذلك سمي يوسف ( لابيه ياابت ) بكسر التاء قراءة ابي عمرو وعاصم ونافع وحمزة والكساءي وهي عند البصريين علامة التانيث ادخلت علي الاب في النداء خاصة بدلا من ياء الاضافة وقد تدخل علامة التانيث علي المذكر فيقال : رجل نكحة وهزاة قال النحاس : اذا قلت يا ابت بكسر التاء فالتاء عند سيبويه بدل من ياء الاضافة ولا يجوز علي قوله الوقف الا بالهاء وله علي قوله دلاءل : منها ان قولك : يا ابه يءدي عن معني يا ابي وانه لا يقال : يا ابت الا في المعرفة ولا يقال : جاءني ابت ولا تستعمل العرب هذا الا في النداء خاصة ولا يقال يا ابتي لان التاء بدل من الياء فلا يجمع بينهما وزعم الفراء انه اذا قال : يا ابت فكسر دل علي الياء لا غير لان الياء في النية وزعم ابو اسحاق ان هذا خطا والحق ما قال كيف تكون الياء في النية وليس يقال : يا ابتي وقرا ابو جعفر والاعرج وعبد الله بن عامر يا ابت بفتح التاء قال البصريون : ارادوا يا ابتي بالياء ثم ابدلت الياء الفا فصارت يا ابتا فحذفت الالف وبقيت الفتحة علي التاء وقيل : الاصل الكسر ثم ابدل من الكسرة فتحة كما يبدل من الياء الف فيقال : يا غلاما اقبل واجاز الفراء يا ابت بضم التاء ( اني رايت احد عشر كوكبا ) ليس بين النحويين اختلاف انه يقال : جاءني احد عشر ورايت ومررت باحد عشر وكذلك ثلاثة عشر وتسعة عشر وما بينهما جعلوا الاسمين اسما واحدا واعربوهما باخف الحركات قال السهيلي : اسماء هذه الكواكب جاء ذكرها مسندا رواه الحرث بن ابي اسامة قال : جاء بستانة وهو رجل من اهل الكتاب فسال النبي صلي الله عليه وسلم عن الاحد عشر كوكبا الذي راي يوسف فقال : ( الحرثان والطارق والذيال وقابس والمصبح والضروح وذو الكنفات وذو القرع والفليق ووثاب والعمودان راها يوسف عليه السلام تسجد له ( قال بن عباس وقتادة : الكواكب اخوته والشمس امه والقمر ابوه وقال قتادة ايضا : الشمس خالته لان امه كانت قد ماتت وكانت خالته تحت  ابيه ( رايتهم ) توكيد وقال : رايتهم لي ساجدين فجاء مذكرا فالقول عند الخليل وسيبويه انه لما اخبر عن هذه الاشياء بالطاعة والسجود وهما من افعال من يعقل اخبر عنها كما يخبر عمن يعقل وقد تقدم هذا المعني في قوله : وتراهم ينظرون اليك والعرب تجمع ما لا يعقل جمع من يعقل اذا انزلوه منزلته وان كان خارجا عن الاصل < <
  يوسف : (  ) قال يا بني . . . . .
 > > <
 > ( يوسف  ) <
 > فيه احدي عشرة مسالة : الاولي قوله تعالي : ( فيكيدوا لك كيدا ) اي يحتالوا في هلاكك لان تاويلها ظاهر فربما يحملهم الشيطان علي قصدك بسوء حينءذ واللام في لك تاكيد كقوله : ان كنتم للرءيا تعبرون الثانية الرءيا حالة شريفة ومنزلة رفيعة قال صلي الله عليه وسلم : ( لم يبق بعدي من المبشرات الا الرءيا الصالحة الصادقة يراها الرجل الصالح او تري له ( وقال : ( اصدقكم رءيا اصدقكم حديثا ( وحكم صلي الله عليه وسلم بانها جزء من ستة واربعين جزءا من النبوة وروي ( من سبعين جزءا من النبوة ( وروي من حديث بن عباس رضي الله عنهما ( جزءا من اربعين جزءا من النبوة ( ومن حديث بن عمر ( جزء من تسعة واربعين جزءا ( ومن حديث العباس ( جزء من خمسين جزءا من النبوة ( ومن حديث انس ( من ستة وعشرين ( وعن عبادة بن الصامت ( من اربعة واربعين من النبوة ( والصحيح منها حديث الستة والاربعين ويتلوه في الصحة حديث السبعين ولم يخرج مسلم في صحيحه غير هذين الحديثين اما ساءرها فمن احاديث الشيوخ قاله بن بطال قال ابو عبد الله المازري : والاكثر والاصح عند اهل الحديث ( من ستة واربعين ( قال الطبري : والصواب ان  يقال ان عامة هذه الاحاديث او اكثرها صحاح ولكل حديث منها مخرج معقول فاما قوله : ( انها جزء من سبعين جزءا من النبوة ( فان ذلك قول عام في كل رءيا صالحة صادقة ولكل مسلم راها في منامه علي اي احواله كان واما قوله : ( انها من اربعين او ستة واربعين ( فانه يريد بذلك من كان صاحبها بالحال التي ذكرت عن الصديق رضي الله عنه انه كان بها فمن كان من اهل اسباغ الوضوء في السبرات والصبر في الله علي المكروهات وانتظار الصلاة بعد الصلاة فرءياه الصالحة ان شاء الله جزء من اربعين جزءا من النبوة ومن كانت حاله في ذاته بين ذلك فرءياه الصادقة بين جزاين ما بين الاربعين الي الستين لا تنقص عن سبعين وتزيد علي الاربعين والي هذا المعني اشار ابو عمر بن عبد البر فقال : اختلاف الاثار في هذا الباب في عدد اجزاء الرءيا ليس ذلك عندي اختلاف متضاد متدافع والله اعلم لانه يحتمل ان تكون الرءيا الصالحة من بعض من يراها علي حسب ما يكون من صدق الحديث واداء الامانة والدين المتين وحسن اليقين فعلي قدر اختلاف الناس فيما وصفنا تكون الرءيا منهم علي الاجزاء المختلفة العدد فمن خلصت نيته في عبادة ربه ويقينه وصدق حديثه كانت رءياه اصدق والي النبوة اقرب : كما ان الانبياء يتفاضلون قال الله تعالي : ولقد فضلنا بعض النبيين علي بعض قلت : فهذا التاويل يجمع شتات الاحاديث وهو اولي من تفسير بعضها دون بعض وطرحه ذكره ابو سعيد الاسفاقسي عن بعض اهل العلم قال : معني قوله : ( جزء من ستة واربعين جزءا من النبوة ( فان الله تعالي اوحي الي محمد صلي الله عليه وسلم في النبوة ثلاثة وعشرين عاما فيما رواه عكرمة وعمرو بن دينار عن بن عباس رضي الله تعالي عنهما فاذا نسبنا ستة اشهر من ثلاثة وعشرين عاما وجدنا ذلك جزءا من ستة واربعين جزءا والي هذا القول اشار المازري في كتابه المعلم واختاره القونوي في تفسيره من سورة يونس عند قوله تعالي : لهم البشري في الحياة الدنيا وهو فاسد من وجهين  احدهما ما رواه ابو سلمة عن بن عباس وعاءشة بان مدة الوحي كانت عشرين سنة وان النبي صلي الله عليه وسلم بعث علي راس اربعين فاقام بمكة عشر سنين وهو قول عروة والشعبي وبن شهاب والحسن وعطاء الخرساني وسعيد بن المسيب علي اختلاف عنه وهي رواية ربيعة وابي غالب عن انس واذا ثبت هذا الحديث بطل ذلك التاويل الثاني : ان ساءر الاحاديث في الاجزاء المختلفة تبقي بغير معني الثالثة انما كانت الرءيا جزءا من النبوة لان فيها ما يعجز ويمتنع كالطيران وقلب الاعيان والاطلاع علي شء من علم الغيب كما قال عليه السلام : ( انه لم يبق من مبشرات النبوة الا الرءيا الصادقة في النوم ( الحديث وعلي الجملة فان الرءيا الصادقة من الله وانها من النبوة قال صلي الله عليه وسلم الرءيا من الله والحلم من الشيطان وان التصديق بها حق ولها التاويل الحسن وربما اغني بعضها عن التاويل وفيها من بديع الله ولطفه ما يزيد المءمن في ايمانه ولا خلاف في هذا بين اهل الدين والحق من اهل الراي والاثر ولا ينكر الرءيا الا اهل الالحاد وشرذمة من المعتزلة الرابعة ان قيل : اذا كانت الرءيا الصادقة جزءا من النبوة فكيف يكون الكافر والكاذب والمخلط اهلا لها وقد وقعت من بعض الكفار وغيرهم ممن لا يرضي دينه منامات صحيحة صادقة كمنام رءيا الملك الذي راي سبع بقرات ومنام الفتيين في السجن ورءيا بختنصر التي فسرها دانيال في ذهاب ملكه ورءيا كسري في ظهور النبي صلي الله عليه وسلم ومنام عاتكة عمة رسول الله صلي الله عليه وسلم في امره وهي كافرة وقد ترجم البخاري باب رءيا اهل السجن فالجواب ان الكافر والفاجر والفاسق والكاذب وان صدقت رءياهم في بعض الاوقات لا تكون من الوحي ولا من النبوة اذ ليس كل من صدق في حديث عن غيب يكون خبره ذلك نبوة وقد تقدم في الانعام ان الكاهن وغيره قد يخبر بكلمة الحق فيصدق لكن ذلك علي الندور والقلة فكذلك رءيا هءلاء قال المهلب : انما ترجم البخاري  بهذا لجواز ان تكون رءيا اهل الشرك رءيا صادقة كما كانت رءيا الفتيين صادقة الا انه لا يجوز ان تضاف الي النبوة اضافة رءيا المءمن اليها اذ ليس كل ما يصح له تاويل من الرءيا حقيقة يكون جزءا من النبوة الخامسة الرءيا المضافة الي الله تعالي هي التي خلصت من الاضغاث والاوهام وكان تاويلها موافقا لما في اللوح المحفوظ والتي هي من خبر الاضغاث هي الحلم وهي المضافة الي الشيطان وانما سميت ضغثا لان فيها اشياء متضادة قال معناه المهلب وقد قسم رسول الله صلي الله عليه وسلم الرءيا اقساما تغني عن قول كل قاءل روي عوف بن مالك عن رسول الله صلي الله عليه وسلم قال : ( الرءيا ثلاثة منها اهاويل الشيطان ليحزن بن ادم ومنها ما يهتم به في يقظته فيراه في منامه ومنها جزء من ستة واربعين جزءا من النبوة ( قال قلت : سمعت هذا من رسول الله صلي الله عليه وسلم قال : نعم سمعته من رسول الله صلي الله عليه وسلم السادسة قوله تعالي : ( قال يابني لا تقصص رءياك علي اخوتك ) الاية الرءيا مصدر راي في المنام رءيا علي وزن فعلي كالسقيا والبشري والفه للتانيث ولذلك لم ينصرف وقد اختلف العلماء في حقيقة الرءيا فقيل : هي ادراك في اجزاء لم تحلها افة كالنوم المستغرق وغيره ولهذا اكثر ما تكون الرءيا في اخر الليل لقلة غلبة النوم فيخلق الله تعالي للراءي علما ناشءا ويخلق له الذي يراه علي ما يراه ليصح الادراك قال بن العربي : ولا يري في المنام الا ما يصح ادراكه في اليقظة ولذلك لا يري في المنام شخصا قاءما قاعدا بحال وانما يري الجاءزات المعتادات وقيل : ان لله ملكا يعرض المرءيات علي المحل المدرك من الناءم فيمثل له صورا محسوسة فتارة تكون تلك الصور امثلة موافقة لما يقع في الوجود وتارة تكون لمعاني معقوله غير محسوسة وفي الحالتين تكون مبشرة او منذرة قال صلي الله عليه وسلم في صحيح مسلم وغيره : ( رايت سوداء ثاءرة الراس تخرج من المدينة الي مهيعة فاولتها الحمي  و رايت سيفي قد انقطع صدره وبقرا تنحر فاولتهما رجل من اهل بيتي يقتل والبقر نفر من اصحابي يقتلون ( و ( رايت اني ادخلت يدي في درع حصينة فاولتها المدينة ( و ( رايت في يدي سوارين فاولتهما كذابين يخرجان بعدي ( الي غير ذلك مما ضربت له الامثال ومنها ما يظهر معناه اولا فاولا ومنها ما لا يظهر الا بعد التفكر وقد راي الناءم في زمن يوسف عليه السلام بقرا فاولها يوسف السنين وراي احد عشر كوكبا والشمس والقمر فاولها باخوته وابويه السابعة ان قيل : ان يوسف عليه السلام كان صغيرا وقت رءياه والصغير لا حكم لفعله فكيف تكون له رءيا لها حكم حتي يقول له ابوه : لا تقصص رءياك علي اخوتك فالجواب ان الرءيا ادراك حقيقة علي ما قدمناه فتكون من الصغير كما يكون منه الادراك الحقيقي في اليقظة واذا اخبر عما راي صدق فكذلك اذا اخبر عما يري في المنام وقد اخبر الله سبحانه عن رءياه وانها وجدت كما راي فلا اعتراض روي ان يوسف عليه السلام كان بن اثنتي عشرة سنة الثامنة هذه الاية اصل في الا تقص الرءيا علي غير شفيق ولا ناصح ولا علي من لا يحسن التاويل فيها روي ابو رزين العقيلي ان النبي صلي الله عليه وسلم قال : ( الرءيا جزء من اربعين جزءا من النبوة ( و ( الرءيا معلقة برجل طاءر ما لم يحدث بها صاحبها فاذا حدث بها وقعت فلا تحدثوا بها الا عاقلا او محبا او ناصحا ( اخرجه الترمذي وقال فيه : حديث حسن صحيح وابو رزين اسمه لقيط بن عامر وقيل لمالك : ايعبر الرءيا كل احد فقال : ابالنبوة يلعب وقال مالك : لا يعبر الرءيا الا من يحسنها فان راي خيرا اخبر به وان راي مكروها فليقل خيرا او ليصمت قيل : فهل يعبرها علي الخير وهي عنده علي المكروه لقول من قال انها علي ما تاولت عليه فقال : لا ثم قال : الرءيا جزء من النبوة فلا يتلاعب بالنبوة التاسعة وفي هذه الاية دليل علي ان مباحا ان يحذر المسلم اخاه المسلم ممن يخافه عليه ولا يكون داخلا في معني الغيبة لان يعقوب عليه السلام قد حذر يوسف ان  يقص رءياه علي اخوته فيكيدوا له كيدا وفيها ايضا ما يدل علي جواز ترك اظهار النعمة عند من تخشي غاءلته حسدا وكيدا وقال النبي صلي الله عليه وسلم : ( استعينوا علي انجاح حواءجكم بالكتمان فان كل ذي نعمة محسود ( وفيها ايضا دليل واضح علي معرفة يعقوب عليه السلام بتاويل الرءيا فانه علم من تاويلها انه سيظهر عليهم ولم يبال بذلك من نفسه فان الرجل يود ان يكون ولده خيرا منه والاخ لا يود ذلك لاخيه ويدل ايضا علي ان يعقوب عليه السلام كان احس من بنيه حسد يوسف وبغضه فنهاه عن قصص الرءيا عليهم خوف ان تغل بذلك صدورهم فيعملوا الحيلة في هلاكه ومن هذا ومن فعلهم بيوسف يدل علي انهم كانوا غير انبياء في ذلك الوقت ووقع في كتاب الطبري لابن زيد انهم كانوا انبياء وهذا يرده القطع بعصمة الانبياء عن الحسد الدنيوي وعن عقوق الاباء وتعريض مءمن للهلاك والتامر في قتله ولا التفات لقول من قال انهم كانوا انبياء ولا يستحيل في العقل زلة نبي الا ان هذه الزلة قد جمعت انواعا من الكباءر وقد اجمع المسلمون علي عصمتهم منها وانما اختلفوا في الصغاءر علي ما تقدم وياتي العاشرة روي البخاري عن ابي هريرة قال سمعت رسول الله صلي الله عليه وسلم يقول : ( ( لم يبق من النبوة الا المبشرات ( قالوا : وما المبشرات قال ( الرءيا الصالحة ( وهذا الحديث بظاهره يدل علي ان الرءيا بشري علي الاطلاق وليس كذلك فان الرءيا الصادقة قد تكون منذرة من قبل الله تعالي لا تسر راءيها وانما يريها الله تعالي المءمن رفقا به ورحمة ليستعد لنزول البلاء قبل وقوعه فان ادرك تاولها بنفسه والا سال عنها من له اهلية ذلك وقد راي الشافعي رضي الله عنه وهو بمصر رءيا لاحمد بن حنبل تدل علي محنته فكتب اليه بذلك ليستعد لذلك وقد تقدم في يونس في تفسير قوله تعالي : لهم البشري في الحياة الدنيا انها الرءيا الصالحة وهذا وحديث البخاري مخرجه علي الاغلب والله اعلم  الحادية عشرة روي البخاري عن ابي سلمة قال : لقد كنت اري الرءيا فتمرضني حتي سمعت ابا قتادة يقول : وانا كنت لاري الرءيا فتمرضني حتي سمعت رسول الله صلي الله عليه وسلم يقول : ( الرءيا الحسنة من الله فاذا راي احدكم ما يحب فلا يحدث به الا من يحب واذا راي ما يكره فليتعوذ بالله من شرها وليتفل ثلاث مرات ولا يحدث بها احدا فانها لن تضره ( قال علماءنا : فجعل الله الاستعاذة منها مما يرفع اذاها الا تري قول ابي قتادة : اني كنت لاري الرءيا هي اثقل علي من الجبل فلما سمعت بهذا الحديث كنت لا اعدها شيءا وزاد مسلم من رواية جابر عن رسول الله صلي الله عليه وسلم انه قال : ( اذا راي احدكم الرءيا يكرهها فليبصق عن يساره ثلاثا وليتعوذ بالله من الشيطان ثلاثا وليتحول عن جنبه الذي كان عليه ( وفي حديث ابي هريرة عن النبي صلي الله عليه وسلم قال : ( اذا راي احدكم ما يكره فليقم فليصل ( قال علماءنا : وهذا كله ليس بمتعارض وانما هذا الامر بالتحول والصلاة زيادة فعلي الراءي ان يفعل الجميع والقيام الي الصلاة يشمل الجميع لانه اذا صلي تضمن فعله للصلاة جميع تلك الامور لانه اذا قام الي الصلاة تحول عن جنبه واذا تمضمض تفل وبصق واذا قام الي الصلاة تعوذ ودعا وتضرع لله تعالي في ان يكفيه شرها في حال هي اقرب الاحوال الي الاجابة وذلك السحر من الليل < <
