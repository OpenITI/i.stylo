 > قوله تعالي : ( افرايتم اللات والعزي ومناة الثالثة الاخري ) لما ذكر الوحي الي النبي ( ص ) وذكر من اثار قدرته ما ذكر حاج المشركين اذ عبدوا ما لا يعقل وقال : افرايتم هذه الالهة التي تعبدونها اوحينا اليك شيءا كما اوحي الي محمد وكانت اللات لثقيف والعزي لقريش وبني كنانة ومناة لبني هلال وقال هشام : فكانت مناة لهذيل وخزاعة فبعث رسول الله ( ص ) عليا رضي الله عنه فهدمها عام الفتح ثم اتخذوا اللات بالطاءف وهي احدث من مناة وكانت صخرة مربعة وكان سدنتها من ثقيف وكانوا قد بنوا عليها بناء فكانت قريش وجميع العرب تعظمها وبها كانت العرب تسمي زيد اللات وتيم اللات وكانت في موضع [ منارة ] مسجد الطاءف اليسري فلم تزل كذلك الي ان اسلمت ثقيف فبعث رسول الله ( ص ) المغيرة بن شعبة فهدمها وحرقها بالنار ثم اتخذوا العزي وهي احدث من اللات اتخذها ظالم بن اسعد وكانت بوادي نخلة الشامية فوق ذات عرق فبنوا عليها بيتا وكانوا يسمعون منها الصوت قال بن هشام : وحدثني ابي عن ابي صالح عن بن عباس قال : كانت العزي شيطانة تاتي ثلاث سمرات ببطن نخلة فلما افتتح رسول الله ( ص ) مكة بعث خالد بن الوليد رضي الله عنه فقال  ( ايت بطن نخلة فانك تجد ثلاث سمرات فاعضد الاولي ( فاتاها فعضدها فلما جاء اليه قال : ( هل رايت شيءا قال : لا قال : ( فاعضد الثانية ( فاتاها فعضدها ثم اتي النبي ( ص ) فقال : ( هل رايت شيءا ) قال : لا قال : ( فاعضد الثالثة ( فاتاها فاذا هو بحبشية نافشة شعرها واضعة يديها علي عاتقها تصرف بانيابها وخلفها دبية السلمي وكان سادنها فقال : يا عز كفرانك لا سبحانك * اني رايت الله قد اهانك ثم ضربها ففلق راسها فاذا هي حممة ثم عضد الشجرة وقتل دبية السادن ثم اتي النبي ( ص ) فاخبره فقال : ( تلك العزي [ ولن تعبد ابدا ] ) ) وقال بن جبير العزي حجر ابيض كانوا يعبدونه قتادة : نبت كان ببطن نخلة ومناة : صنم لخزاعة وقيل : ان اللات فيما ذكر بعض المفسرين اخذه المشركون من لفظ الله والعزي من العزيز ومناة من مني الله الشء اذا قدره وقرا بن عباس وبن الزبير ومجاهد وحميد وابو صالح ( اللات ) بتشديد التاء وقالوا : كان رجلا يلت السويق للحاج ذكره البخاري عن بن عباس فلما مات عكفوا علي قبره فعبدوه بن عباس : كان يبيع السويق والسمن عند صخرة ويصبه عليها فلما مات ذلك الرجل عبدت ثقيف تلك الصخرة اعظاما لصاحب السويق ابو صالح : انما كان رجلا بالطاءف فكان يقوم علي الهتهم ويلت لهم السويق فلما مات عبدوه مجاهد : كان رجل في راس جبل له غنيمة يسلي منها السمن وياخذ منها الاقط ويجمع رسلها ثم يتخذ منها حيسا فيطعم الحاج وكان ببطن نخلة فلما مات عبدوه وهو اللات وقال الكلبي كان رجلا من ثقيف يقال له صرمة بن غنم وقيل : انه عامر بن ظرب العدواني قال الشاعر : لا تنصروا اللات ان الله مهلكها * وكيف ينصركم من ليس ينتصر  والقراءة الصحيحة ( اللات ) بالتخفيف اسم صنم والوقوف عليها بالتاء وهو اختيار الفراء قال الفراء : وقد رايت الكساءي سال ابا فقعس الاسدي فقال ذاه لذات [ ولاه للات ] وقرا ( افرايتم اللاه ) وكذا قرا الدوري عن الكساءي والبزي عن بن كثير ( اللاه ) بالهاء في الوقف ومن قال : ان ( اللات ) من الله وقف بالهاء ايضا وقيل : اصلها لاهة مثل شاة [ اصلها شاهة ] وهي من لاهت اي اختفت قال الشاعر : لاهت فما عرفت يوما بخارجة * يا ليتها خرجت حتي رايناها وفي الصحاح : اللات اسم صنم كان لثقيف وكان بالطاءف وبعض العرب يقف عليها بالتاء وبعضهم بالهاء قال الاخفش : سمعنا من العرب من يقول اللات والعزي ويقول هي اللات فيجعلها تاء في السكوت وهي اللات فاعلم انه جر في موضع الرفع فهذا مثل امس مكسور علي كل حال وهو اجود منه لان الالف واللام اللتين في اللات لا تسقطان وان كانتا زاءدتين واما ما سمعنا من الاكثر في اللات والعزي في السكوت عليها فاللاه لانها هاء فصارت تاء في الوصل وهي في تلك اللغة مثل كان من الامر كيت وكيت وكذلك هيهات في لغة من كسرها الا انه يجوز في هيهات ان تكون جماعة ولا يجوز ذلك في اللات لان التاء لا تزاد في الجماعة الا مع الالف وان جعلت الالف والتاء زاءدتين بقي الاسم علي حرف واحد قوله تعالي : ( ومناة الثالثة الاخري ) قرا بن كثير وبن محيصن وحميد ومجاهد والسلمي والاعشي عن ابي بكر ( ومناءة ) بالمد والهمز والباقون بترك الهمز لغتان وقيل : سمي بذلك لانهم كانوا يريقون عنده الدماء يتقربون بذلك اليه وبذلك سميت مني لكثرة ما يراق فيها من الدماء وكان الكساءي وبن كثير وبن محيصن يقفون بالهاء علي الاصل  الباقون بالتاء اتباعا لخط المصحف وفي الصحاح : ومناة اسم صنم كان [ لهذيل وخزاعة ] بين مكة والمدينة والهاء للتانيث ويسكت عليها بالتاء وهي لغة والنسبة اليها منوي وعبد مناة بن اد بن طابخة وزيد مناة بن تميم بن مر يمد ويقصر قال هو بر الحارثي : الا هل اتي التيم بن عبد مناءة * علي الشنء فيما بيننا بن تميم قوله تعالي : ( الاخري ) العرب [ لا ] تقول للثالثة اخري وانما الاخري نعت للثانية واختلفوا في وجهها فقال الخليل : انما قال ذلك لوفاق رءوس الاي كقوله : مارب اخري ولم يقل اخر وقال الحسين بن الفضل : في الاية تقديم وتاخير مجازها افرايتم اللات والعزي الاخري ومناة الثالثة وقيل : انما قال ( ومناة الثالثة الاخري ) لانها كانت مرتبة عند المشركين في التعظيم بعد اللات والعزي فالكلام علي نسقه وقد ذكرنا عن [ بن ] هشام : ان مناة كانت اولا في التقديم فلذلك كانت مقدمة عندهم في التعظيم والله اعلم وفي الاية حذف دل عليه الكلام اي افرايتم هذه الالهة هل نفعت او ضرت حتي تكون شركاء لله ثم قال علي جهة التقريع والتوبيخ : ( الكم الذكر وله الانثي ) ردا عليهم قولهم : الملاءكة بنات الله والاصنام بنات الله قوله تعالي : ( تلك اذا ) يعني هذه القسمة ( قسمة ضيزي ) اي جاءرة عن العدل خارجة عن الصواب ماءلة عن الحق يقال : ضاز في الحكم اي جار وضاز حقه يضيزه ضيزا عن الاخفش اي نقصه وبخسه قال : وقد يهمز فيقال ضازه يضازه ضازا وانشد : فان تنا عنا ننتقصك وان تقم * فقسمك مضءوز وانفك راغم وقال الكساءي : يقال ضاز يضيز ضيزا وضاز يضوز وضاز يضاز ضازا اذا ظلم وتعدي وبخس وانتقص قال الشاعر : ضازت بنو اسد بحكمهم * اذ يجعلون الراس كالذنب  قوله تعالي : ( قسمة ضيزي ) اي جاءرة وهي فعلي مثل طوبي وحبلي وانما كسروا الضاد لتسلم الياء لانه ليس في الكلام فعلي صفة وانما هو من بناء الاسماء كالشعري والدفلي قال الفراء : وبعض العرب تقول ضوزي وضءزي بالهمز وحكي ابو حاتم عن ابي زيد : انه سمع العرب تهمز ( ضيزي ) قال غيره : وبها قرا بن كثير جعله مصدرا مثل ذكري وليس بصفة اذ ليس في الصفات فعلي ولا يكون اصلها فعلي اذ ليس فيها ما يوجب القلب وهي من قولهم ضازته اي ظلمته فالمعني قسمة ذات ظلم وقد قيل هما لغتان بمعني وحكي فيها ايضا سواهما ضيزي وضازي وضوزي وضءزي وقال المءرج : كرهوا ضم الضاد في ضيزي وخافوا انقلاب الياء واوا وهي من بنات الواو فكسروا الضاد لهذه العلة كما قالوا في جمع ابيض بيض والاصل بوض مثل حمر وصفر وخضر فاما من قال : ضاز يضوز فالاسم منه ضوزي مثل شوري < <
