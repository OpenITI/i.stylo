 > قوله تعالي : ( فانطلقا حتي اذا لقيا غلاما فقتله ) في البخاري قال يعلي قال سعيد : وجد غلمانا يلعبون فاخذ غلاما كافرا فاضجعه ثم ذبحه بالسكين ( قال اقتلت نفسا زكية بغير نفس ) لم تعمل بالحنث وفي الصحيحين وصحيح الترمذي : ثم خرجا من السفينة فبينما هما يمشيان علي الساحل اذ ابصر الخضر غلاما يلعب مع الغلمان فاخذ الخضر راسه بيده فاقتلعه بيده فقتله قال له موسي : ( اقتلت نفسا زكية بغير نفس لقد جءت شيءا نكرا قال الم اقل لك انك لن تستطيع معي صبرا ) قال : وهذه اشد من الاولي ( قال ان سالتك عن شء بعدها فلا تصاحبني قد بلغت من لدني عذرا ) لفظ البخاري وفي [ التفسير ] : ان الخضر مر بغلمان يلعبون فاخذ بيده غلاما ليس فيهم اضوا منه واخذ حجرا فضرب به راسه حتي دمغه فقتله قال ابو العالية : لم يره الا موسي ولو راوه لحالوا بينه وبين الغلام  قلت : ولا اختلاف بين هذه الاحوال الثلاثة فانه يحتمل ان يكون دمغه اولا بالحجر ثم اضجعه فذبحه ثم اقتلع راسه والله اعلم بما كان من ذلك وحسبك بما جاء في الصحيح وقرا الجمهور ( زاكية ) بالالف وقرا الكوفيون وبن عامر ( زكية ) بغير الف وتشديد الياء قيل : المعني واحد قاله الكساءي وقال ثعلب : الزكية ابلغ قال ابو عمرو : الزاكية التي لم تذنب قط والزكية التي اذنبت ثم تابت قوله تعالي : ( غلاما ) اختلف العلماء في الغلام هل كان بالغا ام لا فقال الكلبي : كان بالغا يقطع الطريق بين قريتين وابوه من عظماء اهل احدي القريتين وامه من عظماء القرية الاخري فاخذه الخضر فصرعه ونزع راسه عن جسده قال الكلبي : واسم الغلام شمعون وقال الضحاك : حيسون وقال وهب : اسم ابيه سلاس واسم امه رحمي وحكي السهيلي ان اسم ابيه كازير واسم امه سهوي وقال الجمهور : لم يكن بالغا ولذلك قال موسي زاكية لم تذنب وهو الذي يقتضيه لفظ الغلام فان الغلام في الرجال يقال علي من لم يبلغ وتقابله الجارية في النساء وكان الخضر قتله لما علم من سره وانه طبع كافرا كما في صحيح الحديث وانه لو ادرك لارهق ابويه كفرا وقتل الصغير غير مستحيل اذا اذن الله في ذلك فان الله تعالي الفعال لما يريد القادر علي ما يشاء وفي كتاب [ العراءس ] ان موسي لما قال للخضر : ( اقتلت نفسا زكية ) الاية غضب الخضر واقتلع كتف الصبي الايسر وقشر اللحم عنه واذا في عظم كتفه مكتوب : كافر لا يءمن بالله ابدا وقد احتج اهل القول الاول بان العرب تبقي علي الشاب اسم الغلام ومنه قول ليلي الاخيلية : شفاها من الداء العضال الذي بها * غلام اذا هز القناة سقاها وقال صفوان لحسان : تلق ذباب السيف عني فانني * غلام اذا هوجيت لست بشاعر  وفي الخبر : ان هذا الغلام كان يفسد في الارض ويقسم لابويه انه ما فعل فيقسمان علي قسمه ويحميانه ممن يطلبه قالوا وقوله : ( بغير نفس ) يقتضي انه لو كان عن قتل نفس لم يكن به باس وهذا يدل علي كبر الغلام والا فلو كان لم يحتلم لم يجب قتله بنفس وانما جاز قتله لانه كان بالغا عاصيا قال بن عباس : كان شابا يقطع الطريق وذهب بن جبير الي انه بلغ سن التكليف لقراءة ابي وبن عباس ( واما الغلام فكان كافرا وكان ابواه مءمنين ( والكفر والايمان من صفات المكلفين ولا يطلق علي غير مكلف الا بحكم التبعية لابويه وابوا الغلام كانا مءمنين بالنص فلا يصدق عليه اسم الكافر الا بالبلوغ فتعين ان يصار اليه والغلام من الاغتلام وهو شدة الشبق قوله تعالي : ( نكرا ) اختلف الناس ايهما ابلغ ( امرا ) او قوله ( نكرا ) فقالت فرقة : هذا قتل بين وهناك مترقب ف ( نكرا ) ابلغ وقالت فرقة : هذا قتل واحد وذاك قتل جماعة ف ( امرا ) ابلغ قال بن عطية : وعندي انهما لمعنيين وقوله : ( امرا ) افظع واهول من حيث هو متوقع عظيم و ( نكرا ) بين في الفساد لان مكروهه قد وقع وهذا بين قوله : ( ان سالتك عن شء بعدها فلا تصاحبني ) شرط وهو لازم والمسلمون عند شروطهم واحق الشروط ان يوفي به ما التزمه الانبياء والتزم للانبياء وقوله : ( قد بلغت من لدني عذرا ) يدل علي قيام الاعتذار بالمرة الواحدة مطلقا وقيام الحجة من المرة الثانية بالقطع قاله بن العربي بن عطية : ويشبه ان تكون هذه القصة ايضا اصلا للاجال في الاحكام التي هي ثلاثة وايام المتلوم ثلاثة فتامله قوله تعالي : ( فلا تصاحبني ) كذا قرا الجمهور اي تتابعني وقرا الاعرج ( تصحبني ) بفتح التاء والباء وتشديد النون وقرء ( تصحبني ) اي تتبعني وقرا يعقوب ( تصحبني ) بضم التاء وكسر الحاء ورواها سهل عن ابي عمرو قال الكساءي : معناها لا تتركني اصحبك ( قد بلغت من لدني عذرا ) اي بلغت مبلغا تعذر به في ترك مصاحبتي وقرا الجمهور : ( من لدني ) بضم الدال الا ان نافعا وعاصما خففا النون فهي ( لدن ) اتصلت بها ياء  المتكلم التي في غلامي وفرسي وكسر ما قبل الياء كما كسر في هذه وقرا ابو بكر عن عاصم ( لدني ) بفتح اللام وسكون الدال وتخفيف النون وروي عن عاصم ( لدني ) بضم اللام وسكون الدال قال بن مجاهد : وهي غلط قال ابو علي : هذا التغليط يشبه ان يكون من جهة الرواية فاما علي قياس العربية فهي صحيحة وقرا الجمهور ( عذرا ) وقرا عيسي ( عذرا ) بضم الذال وحكي الداني ان ابيا روي عن النبي صلي الله عليه وسلم ( عذري ) بكسر الراء وياء بعدها مسالة اسند الطبري قال : كان رسول الله صلي الله عليه وسلم اذا دعا لاحد بدا بنفسه فقال يوما : ( رحمة الله علينا وعلي موسي لو صبر علي صاحبه لراي العجب ولكنه قال ( فلا تصاحبني قد بلغت من لدني عذرا ) والذي في صحيح مسلم قال رسول الله صلي الله عليه وسلم : ( رحمة الله علينا وعلي موسي لولا انه عجل لراي العجب ولكنه اخذته من صاحبه ذمامة ولو صبر لراي العجب ( قال : وكان اذا ذكر احدا من الانبياء بدا بنفسه : رحمة الله علينا وعلي اخي كذا وفي البخاري عن النبي صلي الله عليه وسلم قال : ( يرحم الله موسي لوددنا انه صبر حتي يقص علينا من امرهما ( الذمامة بالذال المعجمة المفتوحة وهو بمعني المذمة بفتح الذال وكسرها وهي الرقة والعار من تلك الحرمة : يقال اخذتني منك مذمة ومذمة وذمامة وكانه استحيا من تكرار مخالفته ومما صدر عنه من تغليظ الانكار  < <
