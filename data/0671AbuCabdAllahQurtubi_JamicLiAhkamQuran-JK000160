 > قوله تعالي : ( يابن ام لا تاخذ بلحيتي ولا براسي ) بن عباس : اخذ شعره بيمينه ولحيته بيساره لان الغيرة في الله ملكته اي لا تفعل هذا فيتوهموا انه منك استخفاف  او عقوبة وقد قيل : ان موسي عليه السلام انما فعل هذا علي غير استخفاف ولا عقوبة كما ياخذ الانسان بلحية نفسه وقد مضي هذا في @QB@ الاعراف @QE@ مستوفي والله عز وجل اعلم بما اراد نبيه عليه السلام ( اني خشيت ان تقول فرقت بين بني اسراءيل ) اي خشيت ان اخرج واتركهم وقد امرتني ان اخرج معهم فلو خرجت لا تبعني قوم ويتخلف مع العجل قوم وربما ادي الامر الي سفك الدماء وخشيت ان زجرتهم ان يقع قتال فتلومني علي ذلك وهذا جواب هارون لموسي عليه السلام عن قوله : ( افعصيت امري ) وفي الاعراف ( ان القوم استضعفوني وكادوا يقتلونني فلا تشمت بي الاعداء ) لانك امرتني ان اكون معهم وقد تقدم ومعني ( ولم ترقب قولي ) لم تعمل بوصيتي في حفظه قاله مقاتل وقال ابو عبيدة : لم تنتظر عهدي وقدومي فتركه موسي ثم اقبل علي السامري ف ( قال فما خطبك يا سامري ) اي ما امرك وشانك وما الذي حملك علي ما صنعت قال قتادة : كان السامري عظيما في بني اسراءيل من قبيلة يقال لها سامرة ولكن عدو الله نافق بعد ما قطع البحر مع موسي فلما مرت بنو اسراءيل بالعمالقة وهم يعكفون علي اصنام لهم ( قالوا يا موسي اجعل لنا الها كما لهم الهة ) فاغتنمها السامري وعلم انهم يميلون الي عبادة العجل فاتخذ العجل ف ( قال ) السامري مجيبا لموسي : ( بصرت بما لم يبصروا به ) يعني : رايت ما لم يروا رايت جبريل عليه السلام علي فرس الحياة فالقي في نفسي ان اقبض من اثره قبضة فما القيته علي شء الا صار له روح ولحم ودم فلما سالوك ان تجعل لهم الها زينت لي نفسي ذلك وقال علي رضي الله عنه : لما نزل جبريل ليصعد بموسي عليه السلام الي السماء ابصره السامري من بين الناس فقبض قبضة من اثر الفرس وقيل قال السامري : رايت جبريل علي الفرس وهي تلقي خطوها مد البصر فالقي في نفسي ان اقبض من اثرها فما القيته علي شء الا صار له روح ودم وقيل : راي جبريل يوم نزل علي رمكة وديق فتقدم خيل فرعون في ورود البحر ويقال : ان ام السامري جعلته حين وضعته في غار خوفا  من ان يقتله فرعون فجاءه جبريل عليه السلام فجعل كف السامري في فم السامري فرضع العسل واللبن فاختلف اليه فعرفه من حينءذ وقد تقدم هذا المعني في @QB@ الاعراف @QE@ ويقال : ان السامري سمع كلام موسي عليه السلام حيث عمل تمثالين من شمع احدهما ثور والاخر فرس فالقاهما في النيل طلب قبر يوسف عليه السلام وكان في تابوت من حجر في النيل فاتي به الثور علي قرنه فتكلم السامري بذلك الكلام الذي سمعه من موسي والقي القبضة في جوف العجل فخار وقرا حمزة والكساءي والاعمش وخلف ( بما لم تبصروا ) بالتاء علي الخطاب الباقون بالياء علي الخبر وقرا ابي بن كعب وبن مسعود والحسن وقتادة ( فقبضت قبصة ) بصاد غير معجمة وروي عن الحسن ضم القاف من ( قبصه ) والصاد غير معجمة الباقون : ( قبضت قبضة ) بالضاد المعجمة والفرق بينهما ان القبض بجميع الكف والقبص باطراف الاصابع ونحوهما الخضم والقضم والقبضة بضم القاف القدر المقبوض ذكره المهدوي ولم يذكر الجوهري ( قبصة ) بضم القاف والصاد غير معجمة وانما ذكر ( القبضة ) بضم القاف والضاد المعجمة وهو ما قبضت عليه من شء يقال : اعطاه قبضة من سويق او تمر اي كفا منه وربما جاء بالفتح قال : والقبض بكسر القاف والصاد غير المعجمة العدد الكثير من الناس قال الكميت : لكم مسجدا الله المزوران والحصي * لكم قبصه من بين اثري واقتري ) اي طرحتها في العجل ( وكذلك سولت لي نفسي ) اي زينته قاله الاخفش وقال بن زيد : حدثتني نفسي والمعني متقارب قوله تعالي : ( قال فاذهب ) اي قال له موسي فاذهب اي من بيننا ( فان لك في الحياة ان تقول لا مساس ) اي لا امس ولا امس طول الحياة فنفاه موسي عن قومه وامر بني اسراءيل الا يخالطوه ولا يقربوه ولا يكلموه عقوبة له قال الشاعر : تميم كرهط السامري وقوله * الا لا يريد السامري مساسا  قال الحسن : جعل الله عقوبة السامري الا يماس الناس ولا يماسوه عقوبة له ولمن كان منه الي يوم القيامة وكان الله عز وجل شدد عليه المحنة بان جعله لا يماس احدا ولا يمكن من ان يمسه احد وجعل ذلك عقوبة له في الدنيا ويقال : ابتلي بالوسواس واصل الوسواس من ذلك الوقت وقال قتادة : بقاياهم الي اليوم يقولون ذلك لا مساس وان مس واحد من غيرهم احدا منهم حم كلاهما في الوقت ويقال : ان موسي هم بقتل السامري فقال الله تعالي له : لا تقتله فانه سخي ويقال لما قال له موسي : ( فاذهب فان لك في الحياة ان تقول لا مساس ) خاف فهرب فجعل يهيم في البرية مع السباع والوحش لا يجد احدا من الناس يمسه حتي صار كالقاءل لا مساس لبعده عن الناس وبعد الناس عنه كما قال الشاعر : حمال رايات بها قناعسا * حتي تقول الازد لا مسابسا مسالة : هذه الاية اصل في نفي اهل البدع والمعاصي وهجرانهم والا يخالطوا وقد فعل النبي صلي الله عليه وسلم ذلك بكعب بن مالك والثلاثة الذين خلفوا ومن التجا الي الحرم وعليه قتل لا يقتل عند بعض الفقهاء ولكن لا يعامل ولا يبايع ولا يشاري وهو ارهاق الي الخروج ومن هذا القبيل التغريب في حد الزني وقد تقدم جميع هذا كله في موضعه فلا معني لاعادته والحمد لله وحده وقال هارون القارء : ولغة العرب لا مساس بكسر السين وفتح الميم وقد تكلم النحويون فيه فقال سيبويه : هو مبني علي الكسر كما يقال اضرب الرجل وقال ابو اسحاق : لا مساس نفي وكسرت السين لان الكسرة من علامة التانيث تقول : فعلت يا امراة قال النحاس : وسمعت علي بن سليمان يقول سمعت محمد بن يزيد يقول : اذا اعتل الشء من ثلاث جهات وجب ان يبني واذا اعتل من جهتين وجب الا ينصرف لانه ليس بعد ترك الصرف الا البناء فمساس ودراك اعتل من ثلاث جهات : منها انه معدول ومنها انه مءنث وانه معرفة فلما وجب البناء فيه وكانت الالف قبل السين ساكنة كسرت السين لالتقاء الساكنين كما تقول : اضرب الرجل ورايت ابا اسحاق  يذهب الي ان هذا القول خطا والزم ابا العباس اذا سمي امراة بفرعون يبنيه وهذا لا يقوله احد وقال الجوهري في الصحاح : واما قول العرب لا مساس مثال قطام فانما بني علي الكسر لانه معدول عن المصدر وهو المس وقرا ابو حيوة ( لا مساس ) ( وان لك موعدا لن تخلفه ) يعني يوم القيامة والموعد مصدر اي ان لك وعدا لعذابك وقرا بن كثير وابو عمرو ( تخلفه ) بكسر اللام وله معنيان : احدهما ستاتيه ولن تجده مخلفا كما تقول : احمدته اي وجدته محمودا والثاني علي التهديد اي لا بد لك من ان تصير اليه الباقون بفتح اللام بمعني : ان الله لن يخلفك اياه قوله تعالي : ( وانظر الي الهك الذي ظلت عليه ) اي دمت واقمت عليه ( عاكفا ) اي ملازما واصله ظللت قال : خلا ان العتاق من المطايا * احسن به فهن اليه شوس اي احسسن وكذلك قرا الاعمش بلامين علي الاصل وفي قراءة بن مسعود ( ظلت ) بكسر الظاء يقال : ظللت افعل كذا اذا فعلته نهارا وظلت وظلت فمن قال : ظلت حذف اللام الاولي تخفيفا ومن قال : ظلت القي حركة اللام علي الظاء و ( لنحرقنه ) قراءة العامة بضم النون وشد الراء من حرق يحرق وقرا الحسن وغيره بضم النون وسكون الحاء وتخفيف الراء من احرقه يحرقه وقرا علي وبن عباس وابو جعفر وبن محيصن واشهب العقيلي ( لنحرقنه ) بفتح النون وضم الراء خفيفة من حرقت الشء احرقه حرقا بردته وحككت بعضه ببعض ومنه قولهم : حرق نابه يحرقه ويحرقه اي سحقه حتي سمع له صريف فمعني هذه القراءة لنبردنه بالمبارد ويقال للمبرد المحرق والقراءتان الاوليان معناهما الحرق بالنار وقد يمكن جمع ذلك فيه قال السدي : ذبح العجل فسال منه كما يسيل من العجل اذا ذبح ثم برد عظامه بالمبرد وحرقه وفي حرف بن مسعود ( لنذبحنه ثم لنحرقنه ) واللحم والدم اذا احرقا  صارا رمادا فيمكن تذريته في اليم فاما الذهب فلا يصير رمادا وقيل : عرف موسي ما صير به الذهب رمادا وكان ذلك من اياته ومعني ( لننسفنه ) لنطيرنه وقرا ابو رجاء ( لننسفنه ) بضم السين لغتان والنسف نفض الشء ليذهب به الريح وهو التذرية والمنسف ما ينسف به الطعام وهو شء متصوب الصدر اعلاه مرتفع والنسافة ما يسقط منه يقال : اعزل النسافة وكل من الخالص ويقال : اتانا فلان كان لحيته منسف حكاه ابو نصر احمد بن حاتم والمنسفة الة يقلع بها البناء ونسفت البناء نسفا قلعته ونسف البعير الكلا ينسفه بالكسر اذا اقتلعه باصله وانتسفت الشء اقتلعته عن ابي زيد قوله تعالي : ( انما الهكم الله الذي لا اله الا هو وسع كل شء علما ) لا العجل اي وسع كل شء علمه يفعل الفعل عن العلم ونصب علي التفسير وقرا مجاهد وقتادة ( وسع كل شء علما ) < <
