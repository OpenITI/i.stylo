 > ( كلا ) اي ليس الامر علي ما يظنه ابو جهل ( لا تطعه ) اي فيما دعاك اليه من ترك الصلاة ( واسجد ) اي صل لله ( واقترب ) اي تقرب الي الله جل ثناءه بالطاعة والعبادة وقيل : المعني : اذا سجدت فاقترب من الله بالدعاء روي عطاء عن ابي هريرة قال قال رسول الله صلي الله عليه وسلم : ( اقرب مايكون العبد من ربه واحبه اليه جبهته في الارض ساجدا لله ( قال علماءنا : وانما ] كان [ ذلك لانها نهاية العبودية والذلة ولله غاية العزة وله العزة التي لا مقدار لها فكلما بعدت من صفته قربت من جنته ودنوت من جواره في داره وفي الحديث الصحيح : ان النبي صلي الله عليه وسلم قال : ( اما الركوع فعظموا فيه الرب واما السجود فاجتهدوا في الدعاء فانه قمن ان يستجاب لكم ( ولقد احسن من قال : واذا تذللت الرقاب تواضعا * منا اليك فعزها في ذلها وقال زيد بن اسلم : اسجد انت يامحمد مصليا واقترب انت ياابا جهل من النار قوله تعالي : ( واسجد ) هذا من السجود يحتمل ان يكون بمعني السجود في الصلاة ويحتمل ان يكون سجود التلاوة في هذه السورة قال ابن العربي : والظاهر انه سجود الصلاة لقوله تعالي : ارايت الذي ينهي عبدا اذا صلي الي قوله كلا لا تطعه واسجد واقترب لولا ما ثبت في الصحيح من رواية مسلم وغيره من الاءمة عن ابي هريرة انه قال : سجدت مع رسول الله صلي الله عليه وسلم في اذا السماء انشقت وفي اقرا باسم ربك الذي خلق سجدتين فكان هذا نصا علي ان المراد سجود التلاوة وقد روي ابن وهب عن حماد ابن زيد عن عاصم بن بهدلة عن زر بن حبيش عن علي بن ابي طالب رضي الله عنه قال : عزاءم السجود اربع : الم وحم تنزيل من الرحمن الرحيم والنجم واقرا  باسم ربك وقال ابن العربي : وهذا ان صح يلزم عليه السجود الثاني من سورة الحج وان كان مقترنا بالركوع لانه يكون معناه اركعوا في موضع الركوع واسجدوا في موضع السجود وقد قال ابن نافع ومطرف : وكان مالك يسجد في خاصة نفسه بخاتمة هذه السورة من اقرا باسم ربك وابن وهب يراها من العزاءم قلت : وقد روينا من حديث مالك بن انس عن ربيعة بن ابي عبد الرحمن عن نافع عن ابن عمر قال : لما انزل الله تعالي اقرا باسم ربك الذي خلق قال رسول الله صلي الله عليه وسلم لمعاذ ( اكتبها يامعاذ ( فاخذ معاذ اللوح والقلم والنون وهي الدواة فكتبها معاذ فلما بلغ كلا لا تطعه واسجد واقترب سجد اللوح وسجد القلم وسجدت النون وهم يقولون : اللهم ارفع به ذكرا اللهم احطط به وزرا اللهم اغفر به ذنبا قال معاذ : سجدت واخبرت رسول الله صلي الله عليه وسلم فسجد ختمت السورة والحمد لله علي ما فتح ومنح واعطي وله الحمد والمنة <
 > تفسير سورة القدر <
 > وهي مدنية في قول اكثر المفسرين ذكره الثعلبي وحكي الماوردي عكسه قلت : وهي مدنية في قول الضحاك واحد قولي ابن عباس وذكر الواقدي انها اول سورة نزلت بالمدينة وهي خمس ايات بسم الله الرحمن الرحيم < <
  القدر : (  ) انا انزلناه في . . . . .
 > > <
 > ( القدر  ) <
 > قوله تعالي : ( انا انزلناه ) يعني القران وان لم يجر له ذكر في هذه السورة لان المعني معلوم والقران كله كالسورة الواحدة وقد قال : شهر رمضان الذي انزل فيه القران وقال : حم والكتاب المبين انا انزلناه في ليلة مباركة يريد : في ليلة القدر وقال  الشعبي : المعني انا ابتدانا انزاله في ليلة القدر وقيل : بل نزل به جبريل عليه السلام جملة واحدة في ليلة القدر من اللوح المحفوظ الي سماء الدنيا الي بيت العزة واملاه جبريل علي السفرة ثم كان جبريل ينزله علي النبي صلي الله عليه وسلم نجوما نجوما وكان بين اوله واخره ثلاث وعشرون سنة قاله ابن عباس وقد تقدم في سورة البقرة وحكي الماوردي عن ابن عباس قال : نزل القران في شهر رمضان وفي ليلة القدر في ليلة مباركة جملة واحدة من عند الله من اللوح المحفوظ الي السفرة الكرام الكاتبين في السماء الدنيا فنجمته السفرة الكرام الكاتبون علي جبريل عشرين سنة ونجمه جبريل علي النبي صلي الله عليه وسلم عشرين سنة قال ابن العربي : وهذا باطل ليس بين جبريل وبين الله واسطة ولا بين جبريل ومحمد عليهما السلام واسطة قوله تعالي : ( في ليلة القدر ) قال مجاهد : في ليلة الحكم ( وما ادراكما ليلة القدر ) قال : ليلة الحكم والمعني ليلة التقدير سميت بذلك لان الله تعالي يقدر فيها ما يشاء من امره الي مثلها من السنة القابلة من امر الموت والاجل والرزق وغيره ويسلمه الي مدبرات الامور وهم اربعة من الملاءكة : اسرافيل وميكاءيل وعزراءيل وجبريل عليهم السلام وعن ابن عباس قال : يكتب من ام الكتاب ما يكون في السنة من رزق ومطر وحياة وموت حتي الحاج قال عكرمة : يكتب حاج بيت الله تعالي في ليلة القدر باسماءهم واسماء اباءهم ما يغادر منهم احد ولا يزاد فيهم وقاله سعيد بن جبير وقد مضي في اول سورة الدخان هذا المعني وعن ابن عباس ايضا : ان الله تعالي يقضي الاقضية في ليلة نصف شعبان ويسلمها الي اربابها في ليلة القدر وقيل : انما سميت بذلك لعظمها وقدرها وشرفها من قولهم : لفلان قدر اي شرف ومنزلة قاله الزهري وغيره وقيل : سميت بذلك لان للطاعات فيها قدرا عظيما وثوابا جزيلا وقال ابو بكر الوراق  سميت بذلك لان من لم يكن له قدر ولا خطر يصير في هذه الليلة ذا قدر اذا احياها وقيل : سميت بذلك لانه انزل فيها كتابا ذا قدر علي رسول ذي قدر علي امة ذات قدر وقيل : لانه ينزل فيها ملاءكة ذوو قدر وخطر وقيل : لان الله تعالي ينزل فيها الخير والبركة والمغفرة وقال سهل : سميت بذلك لان الله تعالي قدر فيها الرحمة علي المءمنين وقال الخليل : لان الارض تضيق فيها بالملاءكة كقوله تعالي : ومن قدر عليه رزقه اي ضيق < <
  القدر : (  ) وما ادراك ما . . . . .
 > > <
 > (  :  ) <
 > قال الفراء : كل ما في القران من قوله تعالي : وما ادراك فقد ادراه وما كان من قوله : وما يدريك فلم يدره وقاله سفيان وقد تقدم ( ليلة القدر خير من الف شهر ) بين فضلها وعظمها وفضيلة الزمان انما تكون بكثرة ما يقع فيه من الفضاءل وفي تلك الليلة يقسم الخير الكثير الذي لا يوجد مثله في الف شهر والله اعلم وقال كثير من المفسرين : اي العمل فيها خير من العمل في الف شهر ليس فيها ليلة القدر وقال ابو العالية : ليلة القدر خير من الف شهر لا تكون فيه ليلة القدر وقيل : عني بالف شهر جميع الدهر لان العرب تذكر الالف في غاية الاشياء كما قال تعالي : يود احدهم لو يعمر الف سنة يعني جميع الدهر وقيل : ان العابد كان فيما مضي لا يسمي عابدا حتي يعبد الله الف شهر ثلاثا وثمانين سنة واربعة اشهر فجعل الله تعالي لامة محمد صلي الله عليه وسلم عبادة ليلة خيرا من الف شهر كانوا يعبدونها وقال ابو بكر الوراق : كان ملك سليمان خمسماءة شهر وملك ذي القرنين خمسماءة شهر فصار ملكهما الف شهر فجعل الله تعالي العمل في هذه الليلة لمن ادركها خيرا من ملكهما وقال ابن مسعود : ان النبي صلي الله عليه وسلم  ذكر رجلا من بني اسراءيل لبس السلاح في سبيل الله الف شهر فعجب المسلمون من ذلك فنزلت انا انزلناه الاية خير من الف شهر التي لبس فيها الرجل سلاحه في سبيل الله ونحوه عن ابن عباس وهب بن منبه : ان ذلك الرجل كان مسلما وان امه جعلته نذرا لله وكان من قرية قوم يعبدون الاصنام وكان سكن قريبا منها فجعل يغزوهم وحده ويقتل ويسبي ويجاهد وكان لا يلقاهم الا بلحيي بعير وكان اذا قاتلهم وقاتلوه وعطش انفجر له من اللحيين ماء عذب فيشرب منه وكان قد اعطي قوة في البطش لا يوجعه حديد ولا غيره : وكان اسمه شمسون وقال كعب الاحبار : كان رجلا ملكا في بني اسراءيل فعل خصلة واحدة فاوحي الله الي نبي زمانهم : قل لفلان يتمني فقال : يا رب اتمني ان اجاهد بمالي وولدي ونفسي فرزقه الله الف ولد فكان يجهز الولد بماله في عسكر ويخرجه مجاهدا في سبيل الله فيقوم شهرا ويقتل ذلك الولد ثم يجهز اخر في عسكر فكان كل ولد يقتل في الشهر والملك مع ذلك قاءم الليل صاءم النهار فقتل الالف ولد في الف شهر ثم تقدم فقاتل فقتل فقال الناس : لا احد يدرك منزلة هذا الملك فانزل الله تعالي : ليلة القدر خير من الف شهر من شهور ذلك الملك في القيام والصيام والجهاد بالمال والنفس والاولاد في سبيل الله وقال علي وعروة : ذكر النبي صلي الله عليه وسلم اربعة من بني اسراءيل فقال ( عبدوا الله ثمانين سنة لم يعصوه طرفة عين ( فذكر ايوب وزكريا وحزقيل بن العجوز ويوشع بن نون فعجب اصحاب النبي صلي الله عليه وسلم من ذلك فاتاه جبريل فقال : يا محمد عجبت امتك من عبادة هءلاء النفر ثمانين سنة لم يعصوا الله طرفة عين فقد انزل الله عليك خيرا من ذلك ثم قرا : انا انزلناه في ليلة القدر فسر بذلك رسول الله صلي الله عليه وسلم وقال مالك في الموطا من رواية ابن القاسم وغيره : سمعت  من اثق به يقول : ان رسول الله صلي الله عليه وسلم اري اعمار الامم قبله فكانه تقاصر اعمار امته الا يبلغوا من العمل مثل ما بلغ غيرهم في طول العمر فاعطاه الله تعالي ليلة القدر وجعلها خيرا من الف شهر وفي الترمذي عن الحسن بن علي رضي الله عنهما : ان رسول الله صلي الله عليه وسلم اري بني امية علي منبره فساءه ذلك فنزلت انا اعطيناك الكوثر يعني نهرا في الجنة ونزلت انا انزلناه في ليلة القدر وما ادراك ما ليلة القدر ليلة القدر خير من الف شهر يملكها بعدك بنو امية قال القاسم بن الفضل الحداني : فعددناها فاذا هي الف شهر لا تزيد يوما ولا تنقص يوما قال : حديث غريب < <
  القدر : (  ) تنزل الملاءكة والروح . . . . .
 > > <
 > ( القدر  ) <
 > قوله تعالي : ( تنزل الملاءكة ) اي تهبط من كل سماء ومن سدرة المنتهي ومسكن جبريل علي وسطها فينزلون الي الارض ويءمنون علي دعاء الناس الي وقت طلوع الفجر فذلك قوله تعالي : تنزل الملاءكة ( والروح فيها باذن ربهم ) اي جبريل عليه السلام وحكي القشيري : ان الروح صنف من الملاءكة جعلوا حفظة علي ساءرهم وان الملاءكة لا يرونهم كما لا نري نحن الملاءكة وقال مقاتل : هم اشرف الملاءكة واقربهم من الله تعالي وقيل : انهم جند من جند الله عز وجل من غير الملاءكة رواه مجاهد عن ابن عباس مرفوعا ذكره الماوردي وحكي القشيري : قيل هم صنف من خلق الله ياكلون الطعام ولهم ايد وارجل وليسوا ملاءكة وقيل : الروح خلق عظيم يقوم صفا والملاءكة كلهم صفا وقيل : الروح الرحمة ينزل بها جبريل عليه السلام مع الملاءكة في هذه الليلة علي اهلها دليله : ينزل الملاءكة بالروح من امره علي من يشاء من عباده اي بالرحمة ( فيها ) اي في ليلة القدر ( باذن ربهم ) اي بامره ( من كل امر ) : امر بكل امر قدره الله وقضاه في تلك السنة الي قابل قاله ابن عباس كقوله تعالي : يحفظونه من امر الله اي بامر الله وقراءة العامة تنزل بفتح التاء الا ان البزي  شدد التاء وقرا طلحة بن مصرف وابن السميقع بضم التاء علي الفعل المجهول وقرا علي وابن عباس وعكرمة والكلبي من كل امرء وروي عن ابن عباس ان معناه : من كل ملك وتاولها الكلبي علي ان جبريل ينزل فيها مع الملاءكة فيسلمون علي كل امرء مسلم فمن بمعني علي وعن انس قال : قال النبي صلي الله عليه وسلم : ( اذا كان ليلة القدر نزل جبريل في كبكبة من الملاءكة يصلون ويسلمون علي كل عبد قاءم او قاعد يذكر الله تعالي < <
