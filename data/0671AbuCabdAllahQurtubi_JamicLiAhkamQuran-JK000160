 > قوله تعالي : ( وجوه يومءذ ناضرة الي ربها ناظرة ) الاول من النضرة التي هي الحسن والنعمة والثاني من النظر اي وجوه المءمنين مشرقة حسنة ناعمة يقال : نضرهم الله ينضرهم نضرة ونضارة وهو الاشراق والعيش والغني ومنه الحديث ( نضر الله امرا سمع مقالتي فوعاها ( الي ربها الي خالقها ومالكها ناظرة من النظر اي تنظر الي ربها علي هذا جمهور العلماء وفي الباب حديث صهيب خرجه مسلم وقد مضي في يونس عند قوله تعالي : للذين احسنوا الحسني وزيادة وكان بن عمر يقول : اكرم اهل الجنة علي الله من ينظر الي وجهه غدوة وعشية ثم تلا هذه الاية : وجوه يومءذ ناضرة الي ربها ناظرة وروي يزيد النحوي عن عكرمة قال : تنظر الي ربها نظرا وكان الحسن يقول : نضرت وجوههم ونظروا الي ربهم  وقيل : ان النظر هنا انتظار ما لهم عند الله من الثواب وروي عن بن عمر ومجاهد وقال عكرمة : تنتظر امر ربها حكاه الماوردي عن بن عمر وعكرمة ايضا وليس معروفا الا عن مجاهد وحده واحتجوا بقوله تعالي : لا تدركه الابصار وهو يدرك الابصار وهذا القول ضعيف جدا خارج عن مقتضي ظاهر الاية والاخبار وفي الترمذي عن بن عمر قال : قال رسول الله صلي الله عليه وسلم : ( ان ادني اهل الجنة منزلة لمن ينظر الي جنانه وازواجه وخدمه وسرره مسيرة الف سنة واكرمهم علي الله من ينظر الي وجهه الي وجهه غدوة وعشية ( ثم قرا رسول الله صلي الله عليه وسلم وجوه يومءذ ناضرة الي ربها ناظرة قال هذا حديث غريب وقد روي عن بن عمرو ولم يرفعه وفي صحيح مسلم عن ابي بكر بن عبد الله بن قيس عن ابيه عن النبي صلي الله عليه وسلم قال : ( جنتان من فضة انيتهما وما فيهما وجنتان من ذهب انيتهما وما فيهما وما بين القوم وبين ان ينظروا الي ربهم جل وعز الا رداء الكبرياء علي وجهه في جنة عدن ( وروي جرير بن عبد الله قال : كنا عند رسول الله صلي الله عليه وسلم جلوسا فنظر الي القمر ليلة البدر فقال : ( انكم سترون ربكم عيانا كما ترون هذا القمر لا تضامون في رءيته فان استطعتم الا تغلبوا علي صلاة قبل طلوع الشمس وقبل غروبها فافعلوا ( ثم قرا وسبح بحمد ربك قبل طلوع الشمس وقبل الغروب متفق عليه وخرجه ايضا ابو داود والترمذي وقال حديث حسن صحيح وخرج ابو داود عن ابي رزين العقيلي قال : قلت يا رسول الله اكلنا يري ربه قال بن معاذ : مخليا به يوم القيامة قال : ( نعم يا ابا رزين ( قال : وما اية ذلك في خلقه قال ( يا ابا رزين اليس كلكم يري القمر ( قال بن معاذ : ليلة البدر مخليا به قلنا : بلي قال : ( فالله اعظم ( قال بن معاذ قال : ( فانما هو خلق من خلق الله يعني القمر فالله اجل واعظم ( وفي كتاب النساءي عن صهيب قال : ( فيكشف الحجاب فينظرون اليه فوالله ما اعطاهم الله شيءا احب اليهم من النظر ولا اقر لاعينهم ( وفي التفسير لابي اسحاق الثعلبي عن الزبير عن جابر قال  قال رسول الله صلي الله عليه وسلم : ( يتجلي ربنا عز وجل حتي ينظروا الي وجهه فيخرون له سجدا فيقول ارفعوا رءوسكم فليس هذا بيوم عبادة ( قال الثعلبي : وقول مجاهد انها بمعني تنتظر الثواب من ربها ولا يراه شء من خلقه فتاويل مدخول لان العرب اذا ارادت بالنظر الانتظار قالوا نظرته كما قال تعالي : هل ينظرون الا الساعة هل ينظرون الا تاويله وما ينظرون الا صيحة واحدة يس واذا ارادت به التفكر والتدبر قالوا : نظرت فيه فاما اذا كان النظر مقرونا بذكر الي وذكر الوجه فلا يكون الا بمعني الرءية والعيان وقال الازهري : ان قول مجاهد تنتظر ثواب ربها خطا لانه لا يقال نظر الي كذا بمعني الانتظار وان قول القاءل : نظرت الي فلان ليس الا رءية عين كذلك تقوله العرب لانهم يقولون نظرت اليه : اذا ارادوا نظر العين فاذا ارادوا الانتظار قالوا نظرته قال : فانكما ان تنظراني ساعة * من الدهر تنفعني لدي ام جندب لما اراد الانتظار قال تنظراني ولم يقل تنظران الي واذا ارادوا نظر العين قالوا : نظرت اليه قال : نظرت اليها والنجوم كانها * مصابيح رهبان تشب لقفال وقال اخر : نظرت اليها بالمحصب من مني * ولي نظر لولا التحرج عارم وقال اخر : اني اليك لما وعدت لناظر * نظر الفقير الي الغني الموسر اي اني انظر اليك بذل لان نظر الذل والخضوع ارق لقلب المسءول فاما ما استدلوا به من قوله تعالي : لا تدركه الابصار وهو يدرك الابصار فانما ذلك  في الدنيا وقد مضي القول فيه في موضعه مستوفي وقال عطية العوفي : ينظرون الي الله لا تحيط ابصارهم به من عظمته ونظره يحيط بها يدل عليه : لا تدركه الابصار وهو يدرك الابصار قال القشيري ابو نصر : وقيل : الي واحد الالاء : اي نعمه منتظرة وهذا ايضا باطل لان واحد الالاء يكتب بالالف لا بالياء ثم الالاء : نعمه الدفع وهم في الجنة لا ينتظرون دفع نقمه عنهم والمنتظر للشء متنغص العيش فلا يوصف اهل الجنة بذلك وقيل : اضاف النظر الي الوجه وهو كقوله تعالي : تجري من تحتها الانهار والماء يجري في النهر لا النهر ثم قد يذكر الوجه بمعني العين قال الله تعالي : فالقوه علي وجه ابي يات بصيرا يوسف اي علي عينيه ثم لا يبعد قلب العادة غدا حتي يخلق الرءية والنظر في الوجه وهو كقوله تعالي : افمن يمشي مكبا علي وجهه الملك فقيل : يا رسول الله كيف يمشون في النار علي وجوههم قال : ( الذي امشاهم علي اقدامهم قادر ان يمشيهم علي وجوههم ( ووجوه يومءذ باسرة ) اي وجوه الكفار يوم القيامة كالحة كاسفة عابسة وفي الصحاح : وبسر الفحل الناقة وابتسرها : اذا ضربها من غير ضبعة وبسر الرجل وجهه بسورا اي كلح يقال : عبس وبسر وقال السدي : باسرة اي متغيرة والمعني واحد ( تظن ان يفعل بها فاقرة ) اي توقن وتعلم والفاقرة : الداهية والامر العظيم يقال : فقرته الفاقرة : اي كسرت فقار ظهره قال معناه مجاهد وغيره وقال قتادة : الفاقرة الشر السدي : الهلاك بن عباس وبن زيد : دخول النار والمعني متقارب واصلها الوسم علي انف البعير بحديدة او نار حتي يخلص الي العظم قاله الاصمعي يقال : فقرت انف البعير : اذا حززته بحديدة ثم جعلت علي موضع الحز الجرير وعليه وتر ملوي لتذلله بذلك وتروضه ومنه قولهم : قد عمل به الفاقرة وقال النابغة : ابي لي قبر لا يزال مقابلي * وضربة فاس فوق راسي فاقره اي كاسرة  < <
