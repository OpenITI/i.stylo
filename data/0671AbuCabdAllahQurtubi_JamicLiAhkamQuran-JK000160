 > قوله تعالي : ( ثم انتم هءلاء ) انتم في موضع رفع بالابتداء ولا يعرب لانه مضمر وضمت التاء من انتم لانها كانت مفتوحة اذا خاطبت واحدا مذكرا ومكسورة  اذا خاطبت واحدة مءنثة فلما ثنيت او جمعت لم يبق الا الضمة ( هءلاء ) قال القتبي : التقدير يا هءلاء قال النحاس : هذا خطا علي قول سيبويه ولا يجوز هذا اقبل وقال الزجاج : هءلاء بمعني الذين و ( تقتلون ) دخل في الصلة اي ثم انتم الذين تقتلون وقيل : هءلاء رفع بالابتداء وانتم خبر مقدم وتقتلون حال من اولاء وقيل : هولاء نصب بالاضمار اعني وقرا الزهري تقتلون بضم التاء مشددا وكذلك فلم تقتلون انبياء الله وهذه الاية خطاب للمواجهين لا يحتمل رده الي الاسلاف نزلت في بني قينقاع وقريظة والنضير من اليهود وكانت بنو قينقاع اعداء بنو قريظة وكانت الاوس حلفاء بنو القينقاع والخزرج حلفاء بني قينقاع والخزرج حلفاء بني قريظة والنظير والاوس والخزرج اخوان وقريظة والنضير ايضا اخوان ثم افترقوا فكانوا يقتتلون ثم يرتفع الحرب فيفدون اساراهم فعيرهم الله بذلك فقال : وان ياتوكم اساري تفادوهم قوله تعالي : ( يظاهرون ) معني تظاهرون تتعاونون مشتق من الظهر لان بعضهم يقوي بعضا فيكون له كالظهر ومنه قول الشاعر : تظاهرتم استاه بيت تجمعت * علي واحد لا زلتم قرن واحد والاثم : الفعل الذي يستحق عليه صاحبه الذم والعدوان : الافراط في الضن والتجاوز فيه وقرا اهل المدينة واهل مكة تظاهرون بالتشديد يدغمون التاء في الظاء لقربها منها والاصل تتظاهرون وقرا الكوفيون تظاهرون مخففا حذفوا التاء الثانية لدلالة الاولي عليها وكذا وان تظاهرا عليه وقرا قتادة تظهرون عليهم وكله راجع الي معني التعاون ومنه : وكان الكافر علي ربه ظهيرا الفرقان وقوله : والملاءكة بعد ذلك ظهير فاعلمه قوله تعالي : ( وان ياتوكم اساري تفادوهم وهو محرم عليكم اخراجهم ) فيه ستة مساءل : الاولي قوله تعالي : ( وان ياتوكم اساري ) شرط وجوابه تفادوهم واساري نصب علي الحال قال ابو عبيد وكان ابو عمرو يقول : ما صار في ايديهم فهم  الاساري وما جاء مستاسرا فهم الاسري ولا يعرف اهل اللغة ما قال ابو عمرو انما هو كما تقول : سكاري وسكري وقراءة الجماعة اساري ما عدا حمزة فانه قرا اسري علي فعلي جمع اسير بمعني ماسور والباب في تكسيره اذا كان كذلك فعلي كما تقول : قتيل وقتلي وجريح وجرحي قال ابو حاتم : ولا يجوز اساري وقال الزجاج : يقال اساري كما يقال سكاري وفعالي هو الاصل وفعالي داخلة عليها وحكي عن محمد بن يزيد قال : يقال اسير واسراء كظريف وظرفاء قال بن فارس : يقال في جمع اسير اسري واساري وقرء بهما وقيل : اساري ( بفتح الهمزة ) وليست بالعالية الثانية الاسير مشتق من الاسار وهو القد الذي يشد به المحمل فسمي اسيرا لانه يشد وثاقه والعرب تقول : قد اسر قتبه اي شده ثم سمي كل اخيذ اسيرا وان لم يءسر وقال الاعشي : وقيدني الشعر في بيته * كما قيد الاسرات الحمارا اي انا في بيته يريد ذلك بلوغه النهاية فيه فاما الاسر في قوله عز وجل وشددنا اسرهم الانسان فهو الخلق واسرة الرجل رهطه لانه يتقوي بهم الثالثة قوله تعالي : ( تفادوهم ) كذا قرا نافع وحمزة والكساءي والباقون تفدوهم من الفداء والفداء : طلب الفدية في الاسير الذي في ايديهم قال الجوهري : الفداء اذا كسر اوله يمد ويقصر واذا فتح فهو مقصور يقال : قم فدي لك ابي ومن العرب من يكسر فداء بالتنوين اذا جاور لام الجر خاصة فيقول : فداء لك لانه نكرة يريدون به معني الدعاء وانشد الاصمعي للنابغة : مهلا فداء لك الاقوام كلهم * وما اثمر من مال ومن ولد ويقال : فداه وفاداه اذا اعطي فداءه فانقذه وفداه بنفسه وفداه يفديه اذا قال جعلت فداك وتفادوا اي فدي بعضهم بعضا والفدية والفدي والفداء كله بمعني واحد  وفاديت نفسي اذا اطلقتها بعد ان دفعت شيءا بمعني فديت ومنه قول العباس للنبي صلي الله عليه وسلم : فاديت نفسي وفاديت عقيلا وهما فعلان يتعديان الي مفعولين الثاني منهما بحرف الجر تقول : فديت نفسي بمالي وفاديته بمالي قال الشاعر : قفي فادي اسيرك ان قومي * وقومك ما اري لهم اجتماعا الرابعة قوله تعالي : ( وهو محرم عليكم اخراجهم ) هو مبتدا وهو كناية عن الاخراج ومحرم خبره واخراجهم بدل من هو وان شءت كان كناية عن الحديث والقصة والجملة التي بعده خبره اي والامر محرم عليكم اخراجهم ف اخراجهم مبتدا ثان ومحرم خبره والجملة خبر عن هو وفي محرم ضمير ما لم يسم فاعله يعود علي الاخراج ويجوز ان يكون محرم مبتدا واخراجهم مفعول ما لم يسم فاعله يسد مسد خبر محرم والجملة خبر عن هو وزعم الفراء ان هو عماد وهذا عند البصريين خطا لا معني له لان العماد لا يكون في اول الكلام ويقرا وهو بسكون الهاء لثقل الضمة كما قال الشاعر : فهو لا تنمي رميته * ما له لا عد من نفره وكذلك ان جءت باللام وثم وقد تقدم قال علماءنا : كان الله تعالي قد اخذ عليهم اربعة عهود : ترك القتل وترك الاخراج وترك المظاهرة وفداء اساراهم فاعرضوا عن كل ما امروا به الا الفداء فوبخهم الله علي ذلك توبيخا يتلي فقال افتءمنون ببعض الكتاب وهو التوراة وتكفرون ببعض قلت : ولعمر الله لقد اعرضنا نحن عن الجميع بالفتن فتظاهر بعضنا علي بعض ليت بالمسلمين بل بالكافرين حتي تركنا اخواننا اذلاء صاغرين يجري عليهم حكم المشركين فلا حول ولا قوة الا بالله العلي العظيم قال علماءنا : فداء الاساري واجب وان لم يبق درهم واحد قال بن خويز منداد : تضمنت الاية وجوب فك الاسري وبذلك وردت الاثار عن النبي صلي الله عليه وسلم انه  فك الاساري وامر بفكهم وجري بذلك عمل المسلمين وانعقد به الاجماع ويجب فك الاساري من بيت المال فان لم يكن فهو فرض علي كافة المسلمين ومن قام به منهم اسقط الفرض عن الباقين وسياتي الخامسة قوله تعالي : ( فما جزاء من يفعل ذلك منكم الا خزي في الحياة الدنيا ) ابتداء وخبر والخزي الهوان قال الجوهري : وخزي بالكسر يخزي خزيا اذا ذل وهان قال بن السكيت : وقع في بلية واخزاه الله وخزي ايضا يخزي خزاية اذا استحيا فهو خزيان وقوم خزايا وامراة خزيا السادسة قوله تعالي : ( ويوم القيامة يردون ) يردون بالياء قراءة العامة وقرا الحسن تردون بالتاء علي الخطاب ( الي اشد العذاب وما الله بغافل عما تعلمون ) تقدم القول فيه وكذلك : ( اولءك الذين اشتروا ) الاية فلا معني للاعادة يوم منصوب ب يردون < <
  البقرة : (  ) ولقد اتينا موسي . . . . .
 > > <
 > ( البقره  ) <
 > قوله تعالي :  ولقد اتينا موسي الكتاب ) يعني التوراة ( وقفينا ) اي اتبعنا والتقفية : الاتباع والارداف ماخوذ من اتباع القفا وهو مءخر العنق تقول استقفيته اذا جءت من خلفه ومنه سميت قافية الشعر لانها تتلو ساءر الكلام والقافية : القفا ومنه الحديث : ( يعقد الشيطان علي قافية راس احدكم ( والقفي والقفاوة : ما يدخر من اللبن وغيره لمن تريد اكرامه وقفوت الرجل : قذفته بفجور وفلان قفوتي اي تهمتي وقفوتي اي خيرتي قال بن دريد كانه من الاضداد قال العلماء : وهذه الاية مثل قوله تعالي : ثم ارسلنا رسلنا تتري المءمنون وكل رسول جاء بعد موسي فانما جاء باثبات التوراة والامر  بلزومها الي عيسي عليه السلام ويقال : رسل ورسل لغتان الاولي لغة الحجاز والثانية لغة تميم وسواء كان مضافا او غير مضاف وكان ابو عمرو يخفف اذا اضاف الي حرفين ويثقل اذا اضاف الي حرف واحد قوله تعالي : ( واتينا عيسي بن مريم البينات ) اي الحجج والدلالات وهي التي ذكرها الله في ال عمران والماءدة قاله بن عباس ( وايدناه ) اي قويناه وقرا مجاهد وبن محيصن ايدناه بالمد وهما لغتان ( بروح القدس ) روي ابو مالك وابو صالح عن بن عباس ومعمر عن قتادة قالا : جبريل عليه السلام وقال حسان : وجبريل رسول الله فينا * وروح القدس ليس به خفاء قال النحاس : وسمي جبريل روحا واضيف الي القدس لانه كان بتكوين الله عز وجل له روحا من غير ولادة والد ولده وكذلك سمي عيسي روحا لهذا وروي غالب بن عبد الله عن مجاهد قال : القدس هو الله عز وجل وكذا قال الحسن : القدس هو الله وروحه جبريل وروي ابو روق عن الضحاك عن بن عباس : بروح القدس قال : هو الاسم الذي كان يحيي به عيسي الموتي وقاله سعيد بن جبير وعبيد بن عمير وهو اسم الله الاعظم وقيل : المراد الانجيل سماه روحا كما سمي الله القران روحا في قوله تعالي : وكذلك اوحينا اليك روحا من امرنا والاول اظهر والله تعالي اعلم والقدس : الطهارة وقد تقدم وقوله تعالي : ( افكلما جاءكم رسول بما لا تهوي انفسكم ) اي بما لا يوافقها ويلاءمها وحذفت الهاء لطول الاسم اي بما لا تهواه ( استكبرتم ) عن اجابته احتقارا للرسل واستبعادا للرسالة واصل الهوي الميل الي الشء ويجمع اهواء كما جاء في التنزيل ولا يجمع اهوية علي انهم قد قالوا في ندي اندية قال الشاعر : في ليلة من جمادي ذات اندية * لا يبصر الكلب في ظلماءها الطنبا  قال الجوهري : وهو شاذ وسمي الهوي هوي لانه يهوي بصاحبه الي النار ولذلك لا يستعمل في الغالب الا فيما ليس بحق وفيما لا خير فيه وهذه الاية من ذلك وقد يستعمل في الحق ومنه قول عمر رضي الله عنه في اساري بدر : فهوي رسول الله صلي الله عليه وسلم ما قال ابو بكر ولم يهو ما قلت وقالت عاءشة للنبي صلي الله عليه وسلم في صحيح الحديث : والله ما اري ربك الا يسارع في هواك اخرجهما مسلم قوله تعالي : ( ففريقا كذبتم ) ففريقا منصوب ب كذبتم وكذا ( وفريقا تقتلون ) فكان ممن كذبوه عيسي ومحمد عليهما السلام وممن قتلوه يحيي وزكريا عليهما السلام علي ما ياتي بيانه في سبحان ان شاء الله تعالي < <
  البقرة : (  ) وقالوا قلوبنا غلف . . . . .
 > > <
 > ( البقره  ) <
 > قوله تعالي : ( وقالوا ) يعني اليهود ( قلوبنا غلف ) بسكون اللام جمع اغلف اي عليها اغطية وهو مثل قوله : قلوبنا في اكنة مما تدعونا اليه اي في اوعية قال مجاهد : غلف عليها غشاوة وقال عكرمة : عليها طابع وحكي اهل اللغة غلفت السيف جعلت له غلافا فقلب اغلف اي مستور عن الفهم والتمييز وقرا بن عباس والاعرج وبن محيصن غلف بضم اللام قال بن عباس : اي قلوبنا ممتلءة علما لا تحتاج الي علم محمد صلي الله عليه وسلم ولا غيره وقيل : هو جمع غلاف مثل خمار وخمر اي قلوبنا اوعية للعلم فما بالها لا تفهم عنك وقد وعينا علما كثيرا وقيل : المعني فكيف يعزب عنها علم محمد صلي الله عليه وسلم فرد الله تعالي عليهم بقوله : ( بل لعنهم الله بكفرهم فقليلا ما يءمنون ) ثم بين ان السبب في نفورهم عن الايمان انما هو انهم لعنوا بما تقدم من كفرهم واجتراءهم وهذا هو الجزاء علي الذنب باعظم منه واصل اللعن في كلام العرب الطرد والابعاد ويقال للذءب : لعين وللرجل الطريد : لعين وقال الشماخ : ذعرت به القطا ونفيت عنه * مقام الذءب كالرجل اللعين  ووجه الكلام : مقام الذءب اللعين كالرجل فالمعني ابعدهم الله من رحمته وقيل : من توفيقه وهدايته وقيل : من كل خير وهذا عام فقليلا نعت لمصدر محذوف تقديره فايمانا قليلا ما يءمنون وقال معمر : المعني لا يءمنون الا بقليل مما في ايديهم ويكفرون باكثره ويكون قليلا منصوب بنزع حرف الصفة وما صلة اي فقليلا يءمنون وقال الواقدي : معناه لا يءمنون قليلا ولا كثيرا كما تقول : ما اقل ما يفعل كذا اي لا يفعله البتة وقال الكساءي : تقول العرب مررنا بارض قل ما تنبت الكراث والبصل اي لا تنبت شيءا < <
  البقرة : (  ) ولما جاءهم كتاب . . . . .
 > > <
 > ( البقره  ) <
 > قوله تعالي : ( ولما جاءهم ) يعني اليهود ( كتاب ) يعني القران ( من عند الله مصدق ) نعت لكتاب ويجوز في غير القران نصبه علي الحال وكذلك هو في مصحف ابي بالنصب فيما روي ( لما معهم ) يعني التوراة والانجيل يخبرهم بما فيهما ( وكانوا من قبل يستفتحون ) اي يستنصرون والاستفتاح الاستنصار استفتحت : استنصرت وفي الحديث : كان النبي صلي الله عليه وسلم يستفتح بصعاليك المهاجرين اي يستنصر بدعاءهم وصلاتهم ومنه فعسي الله ان ياتي بالفتح او امر من عنده والنصر : فتح شء مغلق فهو يرجع الي قولهم فتحت الباب وروي النساءي عن ابي سعيد الخدري ان النبي صلي الله عليه وسلم قال : ( انما نصر الله هذه الامة بضعفاءها بدعوتهم وصلاتهم واخلاصهم وروي النساءي ايضا عن ابي الدرداء قال : سمعت رسول الله صلي الله عليه وسلم يقول  ( ابغوني الضعيف فانكم انما ترزقون وتنصرون بضعفاءكم ( قال بن عباس : كانت يهود خيبر تقاتل غطفان فلما التقوا هزمت يهود فعادت يهود بهذا الدعاء وقالوا : انا نسالك بحق النبي الامي الذي وعدتنا ان تخرجه لنا في اخر الزمان الا تنصرنا عليهم قال : فكانوا اذا التقوا دعوا بهذا الدعاء فهزموا غطفان فلما بعث النبي صلي الله عليه وسلم كفروا فانزل الله تعالي : ( وكانوا من قبل يستفتحون علي الذين كفروا ) اي بك يا محمد الي قوله : ( فلعنة الله علي الكافرين ) قوله تعالي : ( ولما جاءهم ) جواب لما الفاء وما بعدها في قوله ( فلما جاءهم ما عرفوا ) في قول الفراء وجواب لما الثانية كفروا وقال الاخفش سعيد : جواب لما محذوف لعلم السامع وقاله الزجاج وقال المبرد : جواب لما في قوله : كفروا واعيدت لما الثانية لطول الكلام ويفيد ذلك تقرير الذنب وتاكيدا له < <
  البقرة : (  ) بءسما اشتروا به . . . . .
 > > <
 > ( البقره  ) <
 > قوله تعالي : ( بءسما اشتروا ) بءس في كلام العرب مستوفية للذم كما ان نعم مستوفية للمدح وفي كل واحدة منها اربع لغات : بءس بءس بءس بءس نعم نعم نعم نعم ومذهب سيبويه ان ما فاعلة بءس ولا تدخل الا علي اسماء الاجناس والنكرات وكذا نعم فتقول نعم الرجل زيد ونعم رجلا زيد فاذا كان معها اسم بغير الف ولام فهو نصب ابدا فاذا كان فيه الف ولام فهو رفع ابدا ونصب رجل علي التمييز وفي نعم مضمر علي شريطة التفسير وزيد مرفوع علي وجهين : علي خبر ابتداء محذوف كانه قيل من الممدوح قلت هو زيد والاخر علي الابتداء وما قبله خبره واجاز ابو علي ان تليها ما موصولة وغير موصولة من حيث كانت مبهمة تقع علي الكثرة ولا تخص واحدا  بعينه والتقدير عند سيبويه : بءس الشء اشتروا به انفسهم ان يكفروا ف ان يكفروا في موضع رفع بالابتداء وخبره فيما قبله كقولك : بءس الرجل زيد وما علي هذا القول موصولة وقال الاخفش : ما في موضع نصب علي التمييز كقولك : بءس رجلا زيد فالتقدير بءس شيءا ان يكفروا ف اشتروا به انفسهم علي هذا القول صفة ما وقال الفراء : بءسما بجملته شء واحد ركب كحبذا وفي هذا القول اعتراض لانه يبقي فعل بلا فاعل وقال الكساءي : ما واشتروا بمنزلة اسم واحد قاءم بنفسه والتقدير بءس اشتراءهم ان يكفروا وهذا مردود فان نعم وبءس لا يدخلان علي اسم معين معرف والشراء قد تعرف باضافته الي الضمير قال النحاس : وابين هذه الاقوال قول الاخفش وسيبويه قال الفراء والكساءي : ان يكفروا ان شءت كانت ان في موضع خفض ردا علي الهاء في به قال الفراء : اي اشتروا انفسهم بان يكفروا بما انزل الله فاشتري بمعني باع وبمعني ابتاع والمعني : بءس الشء الذي اختاروا لانفسهم حيث استبدلوا الباطل بالحق والكفر بالايمان قوله تعالي : ( بغيا ) معناه حسدا قاله قتادة والسدي وهو مفعول من اجله وهو علي الحقيقة مصدر الاصمعي : وهو ماخوذ من قولهم : قد بغي الجرح اذا فسد وقيل : اصله الطلب ولذلك سميت الزانية بغيا ( ان ينزل الله ) في موضع نصب اي لان ينزل اي لاجل انزال الله الفضل علي نبيه صلي الله عليه وسلم وقرا بن كثير وابو عمرو ويعقوب وبن محيصن ان ينزل مخففا وكذلك ساءر ما في القران الا وما ننزله في الحجر وفي الانعام علي ان ينزل اية قوله تعالي : ( فباءوا ) اي رجعوا واكثر ما يقال في الشر وقد تقدم ( بغضب علي غضب ) تقدم معني غضب الله عليهم وهو عقابه فقيل : الغضب الاول لعبادتهم العجل والثاني لكفرهم بمحمد صلي الله عليه وسلم قاله بن عباس وقال عكرمة : لانهم كفروا بعيسي ثم كفروا بمحمد يعني اليهود وروي سعيد عن قتادة : الاول لكفرهم  بالانجيل والثاني لكفرهم بالقران وقال قوم : المراد التاييد وشدة الحال عليهم لا انه اراد غضبين معللين بمعصيتين و ( مهين ) ماخوذ من الهوان وهو ما اقتضي الخلود في النار داءما بخلاف خلود العصاة من المسلمين فان ذلك تمحيص لهم وتطهير كرجم الزاني وقطع يد السارق علي ما ياتي بيانه في سورة النساء من حديث ابي سعيد الخدري ان شاء الله تعالي < <
  البقرة : (  ) واذا قيل لهم . . . . .
 > > <
 > ( البقره  ) <
 > قوله تعالي : ( واذا قيل لهم امنوا ) اي صدقوا ( بما انزل الله ) يعني القران ( قالوا نءمن ) اي نصدق ( بما انزل علينا ) يعني التوراة ( ويكفرون بما وراءه ) اي بما سواه عن الفراء وقتادة : بما بعده وهو قول ابي عبيدة والمعني واحد قال الجوهري : وراء بمعني خلف وقد تكون بمعني قدام وهي من الاضداد قال الله تعالي : ( وكان وراءهم ملك ) اي امامهم وتصغيرها وريءة ( بالهاء ) وهي شاذة وانتصب وراءه علي الظرف قال الاخفش : يقال لقيته من وراء فترفعه علي الغاية اذا كان غير مضاف تجعله اسما وهو غير متمكن كقولك : من قبل ومن بعد وانشد : اذا انا لم اءمن عليك ولم يكن * لقاءك الا من وراء وراء قلت : ومنه قول ابراهيم عليه السلام في حديث الشفاعة : ( انما كنت خليلا من وراء وراء ( والوراء : ولد الولد ايضا قوله تعالي : ( وهو الحق ) ابتداء وخبر ( مصدقا ) حال مءكدة عند سيبويه ( لما معهم ) ما في موضع خفض باللام ومعهم صلتها ومعهم نصب بالاستقرار ومن اسكن جعله حرفا  قوله تعالي : ( قل فلم تقتلون انبياء الله من قبل ) رد من الله تعالي عليهم في قولهم انهم امنوا بما انزل عليهم وتكذيب منه لهم وتوبيخ المعني : فكيف قتلتم وقد نهيتم عن ذلك : فالخطاب لمن حضر محمدا صلي الله عليه وسلم والمراد اسلافهم وانما توجه الخطاب لابناءهم لانهم كانوا يتولون اولءك الذين قتلوا كما قال : ( ولو كانوا يءمنون بالله والنبي وما انزل اليه ما اتخذوهم اولياء فاذا تولوهم فهم بمنزلتهم وقيل : لانهم رضوا فعلهم فنسب ذلك اليهم وجاء تقتلون بلفظ الاستقبال وهو بمعني المضي لما ارتفع الاشكال بقوله : من قبل واذا لم يشكل فجاءز ان ياتي الماضي بمعني المستقبل والمستقبل بمعني الماضي قال الحطيءة : شهد الحطيءة يوم يلقي ربه * ان الوليد احق بالعذر شهد بمعني يشهد ( ان كنتم مءمنين ) اي ان كنتم معتقدين الايمان فلم رضيتم بقتل الانبياء وقيل : ان بمعني ما واصل لم لما حذفت الالف فرقا بين الاستفهام والخبر ولا ينبغي ان يوقف عليه لانه ان وقف عليه بلا هاء كان لحنا وان وقف عليه بالهاء زيد في السواد < <
  البقرة : (  ) ولقد جاءكم موسي . . . . .
 > > <
 > ( البقره  ) <
 > قوله تعالي : ( ولقد جاءكم موسي بالبينات ) اللام لام القسم والبينات قوله تعالي : ولقد اتينا موسي تسع ايات بينات وهي العصا والسنون واليد والدم والطوفان والجراد والقمل والضفادع وفلق البحر وقيل : البينات التوراة وما فيها من الدلالات قوله تعالي : ( ثم اتخذتم العجل ) توبيخ وثم ابلغ من الواو في التقريع اي بعد النظر في الايات والاتيان بها اتخذتم وهذا يدل علي انهم انما فعلوا ذلك بعد مهلة من النظر في الاية وذلك اعظم لجرمهم  < <
  البقرة : (  ) واذ اخذنا ميثاقكم . . . . .
 > > <
 > ( البقره  ) <
 > قوله تعالي : ( واذ اخذنا ميثاقكم ورفعنا فوقكم الطور خذوا ما اتيناكم بقوة واسمعوا ) تقدم الكلام في هذاومعني اسمعوا اطيعوا وليس معناه الامر بادراك القول فقط وانما المراد اعملوا بما سمعتم والتزموه ومنه قولهم : سمع الله لمن حمده اي قبل واجاب قال : دعوت الله حتي خفت الا * يكون الله يسمع ما اقول اي يقبل وقال الراجز : والسمع والطاعة والتسليم * خير واعفي لبني تميم ( قالوا سمعنا وعصينا ) اختلف هل صدر منهم هذا اللفظ حقيقة باللسان نطقا او يكونوا فعلوا فعلا قام مقام القول فيكون مجازا كما قال : امتلا الحوض وقال قطني * مهلا رويدا قد ملات بطني وهذا احتجاج عليهم في قولهم : نءمن بما انزل علينا قوله تعالي : ( واشربوا في قلوبهم العجل ) اي حب العجل والمعني : جعلت قلوبهم تشربه وهذا تشبيه ومجاز عبارة عن تمكن امر العجل في قلوبهم وفي الحديث : ( تعرض الفتن علي القلوب كالحصير عودا عودا فاي قلب اشربها نكت فيه نكتة سوداء ( الحديث خرجه مسلم يقال اشرب قلبه حب كذا قال زهير : فصحوت عنها بعد حب داخل * والحب تشربه فءادك داء  وانما عبر عن حب العجل بالشرب دون الاكل لان شرب الماء يتغلغل في الاعضاء حتي يصل الي باطنها والطعام مجاور لها غير متغلغل فيها وقد زاد علي هذا المعني احد التابعين فقال في زوجته عثمة وكان عتب عليها في بعض الامر فطلقها وكان محبا لها : تغلغل حب عثمة في فءادي * فباديه مع الخافي يسير تغلغل حيث لم يبلغ شراب * ولا حزن ولم يبلغ سرور اكاد اذا ذكرت العهد منها * اطير لو ان انسانا يطير وقال السدي وبن جريج : ان موسي عليه السلام برد العجل وذراه في الماء وقال لبني اسراءيل اشربوا من ذلك الماء فشرب جميعهم فمن كان يحب العجل خرجت برادة الذهب علي شفتيه وروي انه ما شربه احد الا جن حكاه القشيري قلت : اما تذريته في البحر فقد دل عليه قوله تعالي : ثم لننسفنه في اليم نسفا واما شرب الماء وظهور البرادة علي الشفاه فيرده قوله تعالي : واشربوا في قلوبهم العجل والله تعالي اعلم قوله تعالي : ( قل بءسما يامركم به ايمانكم ) اي ايمانكم الذي زعمتم في قولكم : نءمن بما انزل علينا وقيل : ان هذا الكلام خطاب للنبي صلي الله عليه وسلم امر ان يوبخهم اي قل لهم يا محمد : بءس هذه الاشياء التي فعلتم وامركم بها ايمانكم وقد مضي الكلام في بءسما والحمد لله وحده < <
  البقرة : (  ) قل ان كانت . . . . .
 > > <
 > ( البقره  :  ) <
 > لما ادعت اليهود دعاوي باطلة حكاها الله عز وجل عنهم في كتابه كقوله تعالي : لن تمسنا النار الا اياما معدودة وقوله : وقالوا لن يدخل الجنة الا من كان  هودا او نصاري البقرة وقالوا : نحن ابناء الله واحباءه اكذبهم الله عز وجل والزمهم الحجة فقال قل لهم يا محمد : ان كانت لكم الدار الاخرة يعني الجنة فتمنوا الموت ان كنتم صادقين في اقوالكم لان من اعتقد انه من اهل الجنة كان الموت احب اليه من الحياة في الدنيا لما يصير اليه من نعيم الجنة ويزول عنه من اذي الدنيا فاحجموا عن تمني ذلك فرقا من الله لقبح اعمالهم ومعرفتهم بكفرهم في قولهم : نحن ابناء الله واحباءه وحرصهم علي الدنيا ولهذا قال تعالي مخبرا عنهم بقوله الحق : ( ولن يتمنوه ابدا بما قدمت ايديهم والله عليم بالظالمين ) تحقيقا لكذبهم وايضا لو تمنوا الموت لماتوا وراوا مقامهم من النار وقيل : ان الله صرفهم عن اظهار التمني وقصرهم علي الامساك ليجعل ذلك اية لنبيه صلي الله عليه وسلم فهذه ثلاثة اوجه في تركهم التمني وحكي عكرمة عن بن عباس في قوله : فتمنوا الموت ان المراد ادعوا بالموت علي اكذب الفريقين منا ومنكم فما دعوا لعلمهم بكذبهم فان قيل : فالتمني يكون باللسان تارة وبالقلب تارة اخري فمن اين علم انهم لم يتمنوه بقلوبهم قيل له : نطق القران بذلك بقوله ولن يتمنوه ابدا ولو تمنوه بقلوبهم لاظهروه بالسنتهم ردا علي النبي صلي الله عليه وسلم وابطالا لحجته وهذا بين قوله تعالي : ( خالصة ) نصب علي خبر كان وان شءت كان حالا ويكون عند الله في موضع الخبر ( ابدا ) ظرف زمان يقع علي القليل والكثير كالحين والوقت وهو هنا من اول العمر الي الموت وما في قوله بما بمعني الذي والعاءد محذوف والتقدير قدمته وتكون مصدرية ولا تحتاج الي عاءد وايديهم في موضع رفع حذفت الضمة من الياء لثقلها مع الكسرة وان كانت في موضع نصب حركتها لان النصب خفيف ويجوز اسكانها في الشعر ( والله عليم بالظالمين ) ابتداء وخبر  < <
  البقرة : (  ) ولتجدنهم احرص الناس . . . . .
 > > <
 > ( البقره  ) <
 > قوله تعالي : ( ولتجدنهم احرص الناس علي حياة ) يعني اليهود ( ومن الذين اشركوا ) قيل : المعني واحرص فحذف من الذين اشركوا لمعرفتهم بذنوبهم والا خير لهم عند الله ومشركو العرب لا يعرفون الا هذه الحياة ولا علم لهم من الاخرة الا تري قول شاعرهم : تمتع من الدنيا فانك فان * من النشوات والنساء الحسان والضمير في احدهم يعود في هذا القول علي اليهود وقيل : ان الكلام تم في حياة ثم استءنف الاخبار عن طاءفة من المشركين قيل : هم المجوس وذلك بين في ادعياتهم للعاطس بلغاتهم بما معناه عش الف سنة وخص الالف بالذكر لانها نهاية العقد في الحساب وذهب الحسن الي ان الذين اشركوا مشركو العرب خصوا بذلك لانهم لا يءمنون بالبعث فهم يتمنون طول العمر واصل سنة سنهة وقيل : سنوة وقيل : في الكلام تقديم وتاخير والمعني ولتجدنهم وطاءفة من الذين اشركوا احرص الناس علي الحياة قوله تعالي : ( يود احدهم لو يعمر الف سنة ) اصل يود يودد ادغمت لءلا يجمع بين حرفين من جنس واحد متحركين وقلبت حركة الدال علي الواو ليدل ذلك علي انه يفعل وحكي الكساءي : وددت فيجوز علي هذا يود بكسر الواو ومعني يود : يتمني قوله تعالي : ( وما هو بمزحزحه من العذاب ان يعمر ) اختلف النحاة في هو فقيل هو ضمير الاحد المتقدم التقدير ما احدهم بمزحزحه وخبر الابتداء في المجرور ان يعمر : فاعل بمزحزح وقالت فرقة : هو ضمير التعمير والتقدير وما التعمير بمزحزحه والخبر في المجرور ان يعمر بدل من التعمير علي هذا القول وحكي الطبري عن فرقة انها قالت : هو عماد  قلت : وفيه بعد فان حق العماد ان يكون بين شيءين متلازمين مثل قوله : ان كان هذا هو الحق وقوله : ولكن كانوا هم الظالمين ونحو ذلك وقيل : ما عاملة حجازية وهو اسمها والخبر في بمزحزحه وقالت طاءفة : هو ضمير الامر والشان بن عطية : وفيه بعد فان المحفوظ عن النحاة ان يفسر بجملة سالمة من حرف جر وقوله : ( بمزحزحه ) الزحزحة : الابعاد والتنحية يقال : زحزحته اي باعدته فتزحزح اي تنحي وتباعد يكون لازما ومتعديا قال الشاعر في المتعدي : يا قابض الروح من نفس اذا احتضرت * وغافر الذنب زحزحني عن النار وانشده ذو الرمة : يا قابض الروج عن جسم عصي زمنا * وغافر الذنب زحزحني عن النار وقال اخر في اللازم خليلي ما بال الدجي لا يتزحزح * وما بال ضوء الصبح لا يتوضح وروي النساءي عن ابي هريرة رضي الله عنه عن النبي صلي الله عليه وسلم قال : ( من صام يوما في سبيل الله زحزح الله وجهه عن النار سبعين خريفا ( قوله تعالي : ( والله يصير بما يعملون ) اي بما يعمل هءلاء الذين يود احدهم ان يعمر الف سنة ومن قرا بالتاء فالتقدير عنده : قل لهم يا محمد الله بصير بما تعملون وقال العلماء : وصف الله عز وجل نفسه بانه بصير علي معني انه عالم بخفيات الامور والبصير في كلام العرب : العالم بالشء الخبير به ومنه قولهم : فلان بصير بالطب وبصير بالفقه وبصير بملاقاة الرجال قال : فان تسالوني بالنساء فانني * بصير بادواء النساء طبيب قال الخطابي : البصير العالم والبصير المبصر وقيل : وصف تعالي نفسه بانه بصير علي معني جاعل الاشياء المبصرة ذوات ابصار اي مدركة للمبصرات بما خلق لها من الالة المدركة والقوة فالله بصير بعباده اي جاعل عباده مبصرين  < <
  البقرة : (  ) قل من كان . . . . .
 > > <
 > ( البقره  ) <
 > سبب نزولها ان اليهود قالوا للنبي صلي الله عليه وسلم : انه ليس نبي من الانبياء الا ياتيه ملك من الملاءكة من عند ربه بالرسالة وبالوحي فمن صاحبك حتي نتابعك قال : ( جبريل ( قالوا : ذاك الذي ينزل بالحرب وبالقتال ذاك عدونا لو قلت : ميكاءيل الذي ينزل بالقطر وبالرحمة تابعناك فانزل الله الاية الي قوله : للكافرين اخرجه الترمذي وقوله تعالي : ( فانه نزله علي قلبك ) الضمير في انه يحتمل معنيين الاول : فان الله نزل جبريل علي قلبك الثاني : فان جبريل نزل بالقران علي قلبك وخص القلب بالذكر لانه موضع العقل والعلم وتلقي المعارف ودلت الاية علي شرف جبريل عليه السلام وذم معاوية وقوله تعالي : ( باذن الله ) اي بارادته وعلمه ( مصدقا لما بين يديه ) يعني التوراة ( وهدي وبشري للمءمنين ) تقدم معناه والحمد لله < <
  البقرة : (  ) من كان عدوا . . . . .
 > > <
 > ( البقره  ) <
 > قوله تعالي : ( من كان عدوا لله ) شرط وجوابه ( فان الله عدو للكافرين ) وهذا وعيد وذم لمعادي جبريل عليه السلام واعلان ان عداوة البعض تقتضي عداوة الله لهم وعداوة العبد لله هي معصيته واجتناب طاعته ومعاداة اولياءه وعداوة الله للعبد تعذيبه واظهار اثر العداوة عليه فان قيل : لم خص الله جبريل وميكاءيل بالذكر وان كان ذكر الملاءكة قد عمهما قيل له : خصهما بالذكر تشريفا لهما كما قال : فيهما فاكهة ونخل ورمان الرحمن وقيل : خصا لان اليهود ذكروهما ونزلت الاية بسببهما فذكرهما واجب لءلا تقول اليهود : انا لم نعاد  الله وجميع ملاءكته فنص الله تعالي عليهما لابطال ما يتاولونه من التخصيص ولعلماء اللسان في جبريل وميكاءيل عليهما السلام لغات فاما التي في جبريل فعشر : الاولي جبريل وهي لغة اهل الحجاز قال حسان بن ثابت : * وجبريل رسول الله فينا * الثانية جبريل بفتح الجيم وهي قراءة الحسن وبن كثير وروي عن بن كثير انه قال : رايت النبي صلي الله عليه وسلم في النوم وهو يقرا جبريل وميكاءيل فلا ازال اقرءهما ابدا كذلك الثالثة جبراءيل بياء بعد الهمزة مثال جبرعيل كما قرا اهل الكوفة وانشدوا : شهدنا فما تلقي لنا من كتيبة * مدي الدهر الا جبراءيل امامها وهي لغة تميم وقيس الرابعة جبرءل ( علي وزن جبرعل ) مقصور وهي قراءة ابي بكر عن عاصم الخامسة مثلها وهي قراءة يحيي بن يعمر الا انه شدد اللام السادسة جبراءل بالف بعد الراء ثم همزة وبها قرا عكرمة السابعة مثلها الا ان بعد الهمزة ياء الثامنة جبرييل بياءين بغير همزة وبها قرا الاعمش ويحيي بن يعمر ايضا التاسعة جبرءين بفتح الجيم مع همزة مكسورة بعدها ياء ونون العاشرة جبرين بكسر الجيم وتسكين الباء بنون من غير همزة وهي لغة بني اسد قال الطبري : ولم يقرا بها قال النحاس وذكر قراءة بن كثير : لا يعرف في كلام العرب فعليل وفيه فعليل نحو دهليز وقطمير وبرطيل وليس ينكر ان يكون في كلام العجم ما ليس له نظير في كلام العرب وليس ينكر ان يكثر تغيره كما قالوا : ابراهيم وابرهم وابراهم  وابراهام قال غيره : جبريل اسم اعجمي عربته العرب فلها فيه هذه اللغات ولذلك لم ينصرف قلت : قد تقدم في اول الكتاب ان الصحيح في هذه الالفاظ عربية نزل بها جبريل بلسان عربي مبين قال النحاس : ويجمع جبريل علي التكسير جباريل واما اللغات التي في ميكاءيل فست : الاولي ميكاءيل قراءة نافع الثانية وميكاءيل بياء بعد الهمزة قراءة حمزة الثالثة ميكال لغة اهل الحجاز وهي قراءة ابي عمرو وحفص عن عاصم وروي عن بن كثير الثلاثة اوجه قال كعب بن مالك : ويوم بدر لقيناكم لنا مدد * فيه مع النصر ميكال وجبريل وقال اخر : عبدوا الصليب وكذبوا بمحمد * وبجبرءيل وكذبوا ميكالا الرابعة ميكءيل مثل ميكعيل وهي قراءة بن محيصن الخامسة ميكاءيل بياءين وهي قراءة الاعمش باختلاف عنه السادسة ميكاءل كما يقال اسراءل بهمزة مفتوحة وهو اسم اعجمي فلذلك لم ينصرف وذكر بن عباس ان جبر وميكا واسراف هي كلها بالاعجمية بمعني : عبد ومملوك وايل : اسم الله تعالي ومنه قول ابي بكر الصديق رضي الله عنه حين سمع سجع مسيلمة : هذا كلام لم يخرج من ال وفي التنزيل : لا يرقبون في مءمن الا ولا ذمة في احد التاويلين وسياتي قال المارودي : ان جبريل وميكاءيل اسمان احدهما عبد الله والاخر عبيد الله لان ايل هو الله تعالي وجبر هو عبد وميكا هو عبيد فكان جبريل عبد الله وميكاءيل عبيد الله هذا قول بن عباس وليس له في المفسرين مخالف  قلت : وزاد بعض المفسرين : واسرافيل عبد الرحمن قال النحاس : ومن تاول الحديث جبر عبد وال الله وجب عليه ان يقول : هذا جبرءل ورايت جبرءل ومررت بجبرءل وهذا لا يقال فوجب ان يكون معني الحديث انه مسمي بهذا قال غيره : ولو كان كما قالوا لكان مصروفا فترك الصرف يدل علي انه اسم واحد مفرد ليس بمضاف وروي عبد الغني الحافظ من حديث افلت بن خليفة وهو فليت العامري وهو ابو حسان عن جسرة بنت دجاجة عن عاءشة رضي الله عنها قالت قال رسول الله صلي الله عليه وسلم : ( اللهم رب جبريل وميكايل واسرافيل اعوذ بك من حر النار وعذاب القبر < <
  البقرة : (  ) ولقد انزلنا اليك . . . . .
 > > <
 > ( البقره  ) <
 > قال بن عباس رضي الله عنهما : هذا جواب لابن صوريا حيث قال لرسول الله صلي الله عليه وسلم : يا محمد ما جءتنا بشء نعرفه وما انزل عليك من اية بينة فنتبعك بها فانزل الله هذه الاية ذكره الطبري < <
  البقرة : (  ) او كلما عاهدوا . . . . .
 > > <
 > ( البقره  ) <
 > قوله تعالي : ( او كلما عاهدة ا عهدا ) الواو واو العطف دخلت عليها الف الاستفهام كما تدخل علي الفاء في قوله : افحكم الجاهلية افانت تسمع الصم افتتخذونه وذريته الكهف وعلي ثم كقوله : اثم اذا ما وقع هذا قول سيبويه وقال الاخفش : الواو زاءدة ومذهب الكساءي انها او حركت الواو منها تسهيلا وقراها قوم او ساكنة الواو فتجء بمعني بل كما يقول القاءل : لاضربنك فيقول المجيب : او يكفي الله قال بن عطية : وهذا كله متكلف والصحيح قول سيبويه كلما نصب علي الظرف والمعني  في الاية مالك بن الصيف ويقال فيه بن الضيف كان قد قال : والله ما اخذ علينا عهد في كتابنا ان نءمن بمحمد ولا ميثاق فنزلت الاية وقيل : ان اليهود عاهدوا لءن خرج محمد لنءمن به ولنكونن معه علي مشركي العرب فلما بعث كفروا به وقال عطاء : هي العهود التي كانت بين النبي صلي الله عليه وسلم وبين اليهود فنقضوها كفعل قريظة والنضير دليله قوله تعالي : الذين عاهدت منهم ثم ينقضون عهدهم في كل مرة وهم لا يتقون قوله تعالي : ( نبذه فريق منهم ) النبذ : الطرح والالقاء ومنه النبيذ والمنبوذ قال ابو الاسود : وخبرني من كنت ارسلت انما * اخذت كتابي معرضا بشمالكا نظرت الي عنوانه فنبذته * كنبذك نعلا اخلقت من نعالكا اخر : ان الذين امرتهم ان يعدلوا * نبذوا كتابك واستحلوا المحرما وهذا مثل يضرب لمن استخف بالشء فلا يعمل به تقول العرب : اجعل هذا خلف ظهرك ودبرا منك وتحت قدمك اي اتركه واعرض عنه قال الله تعالي : واتخذتموه وراءكم ظهريا وانشد الفراء : تميم بن زيد لا تكونن حاجتي * بظهر فلا يعيا علي جوابها ( بل اكثرهم ) ابتداء ( لا يءمنون ) فعل مستقبل في موضع الخبر < <
  البقرة : (  ) ولما جاءهم رسول . . . . .
 > > <
 > ( البقره  ) <
 >  قوله تعالي : ( ولما جاءهم رسول من عند الله مصدق لما معهم ) نعت لرسول ويجوز نصبه علي الحال ( نبذ فريق ) جواب لما ( من الذين اوتوا الكتاب كتاب الله ) نصب ب نبذ والمراد التوراة لان كفرهم بالنبي عليه السلام وتكذيبهم له نبذ لها قال السدي : نبذوا التوراة واخذوا بكتاب اصف وسحر هاروت وماروت وقيل : يجوز ان يعني به القران قال الشعبي : هو بين ايديهم يقرءونه ولكن نبذوا العمل به وقال سفيان بن عيينة : ادرجوه في الحرير والديباج وحلوه بالذهب والفضة ولم يحلوا حلاله ولم يحرموا حرامه فذلك النبذ وقد تقدم بيانه مستوفي ( كانهم لا يعلمون ) تشبيه بمن لا يعلم اذ فعلوا فعل الجاهل فيجء من اللفظ انهم كفروا علي علم < <
  البقرة : (  ) واتبعوا ما تتلوا . . . . .
 > > <
 > ( البقره  ) <
 > فيه اربع وعشرون مسالة : الاولي قوله تعالي : ( واتبعوا ما تتلوا الشياطين علي ملك سليمان ) هذا اخبار من الله تعالي عن الطاءفة الذين نبذوا الكتاب بانهم اتبعوا السحر ايضا وهم اليهود وقال السدي : عارضت اليهود محمدا صلي الله عليه وسلم بالتوراة فاتفقت التوراة والقران فنبذوا التوراة واخذوا بكتاب اصف وبسحر هاروت وماروت وقال محمد بن اسحاق : لما ذكر رسول الله صلي الله عليه وسلم سليمان في المرسلين قال بعض احبارهم : يزعم محمد ان بن داءد  كان نبيا والله ما كان الا ساحرا فانزل الله عز وجل : ( وما كفر سليمان ولكن الشياطين كفروا ) اي القت الي بني ادم ان ما فعله سليمان من ركوب البحر واستسخار الطير والشياطين كان سحرا وقال الكلبي : كتبت الشياطين السحر والنيرنجيات علي لسان اصف كاتب سليمان ودفنوه تحت مصلاه حين انتزع الله ملكه ولم يشعر بذلك سليمان فلما مات سليمان استخرجوه وقالوا للناس : انما ملككم بهذا فتعلموه فاما علماء بني اسراءيل فقالوا : معاذ الله ان يكون هذا علم سليمان واما السفلة فقالوا : هذا علم سليمان واقبلوا علي تعليمه ورفضوا كتب انبياءهم حتي بعث الله محمدا صلي الله عليه وسلم فانزل الله عز وجل علي نبيه عذر سليمان واظهر براءته مما رمي به فقال : واتبعوا ما تتلوا الشياطين قال عطاء : تتلو تقرا من التلاوة وقال بن عباس تتلو تتبع كما تقول : جاء القوم يتلو بعضهم بعضا وقال الطبري : اتبعوا بمعني فضلوا قلت : لان كل من اتبع شيءا وجعله امامه فقد فضله علي غيره ومعني تتلو يعني تلت فهو بمعني المضي قال الشاعر : واذا مررت بقبره فاعقر به * كوم الهجان وكل طرف سابح وانضح جوانب قبره بدماءها * فلقد يكون اخادم وذباءح اي فلقد كان وما مفعول ب اتبعوا اي اتبعوا ما تقولته الشياطين علي سليمان وتلته وقيل : ما نفي وليس بشء لا في نظام الكلام ولا في صحته قاله بن العربي ( علي ملك سليمان ) اي علي شرعه ونبوته قال الزجاج قال الفراء علي عهد ملك سليمان وقيل : المعني في ملك سليمان يعني في قصصه وصفاته واخباره قال الفراء : تصلح علي وفي في مثل هذا الموضع وقال علي ولم يقل بعد لقوله تعالي : وما ارسلنا من قبلك من رسول  ولا نبي الا اذا تمني القي الشيطان في امنيته اي في تلاوته وقد تقدم معني الشيطان واشتقاقه فلا معني لاعادته والشياطين هنا قيل : هم شياطين الجن وهو المفهوم من هذا الاسم وقيل : المراد شياطين الانس المتمردون في الضلال كقول جرير : ايام يدعونني الشيطان من غزلي * وكن يهوينني اذ كنت شيطانا الثانية قوله تعالي : ( وما كفر سليمان ) تبرءة من الله لسليمان ولم يتقدم في الاية ان احدا نسبه الي الكفر ولكن اليهود نسبته الي السحر ولكن لما كان السحر كفرا صار بمنزلة من نسبه الي الكفر ثم قال : ( ولكن الشياطين كفروا ) فاثبت كفرهم بتعليم السحر ويعلمون في موضع نصب علي الحال ويجوز ان يكون في موضع رفع علي انه خبر ثان وقرا الكوفيون سوي عاصم ولكن الشياطين بتخفيف لكن ورفع النون من الشياطين وكذلك في الانفال ولكن الله رمي ووافقهم بن عامر الباقون بالتشديد والنصب ولكن كلمة لها معنيان : نفي الخبر الماضي واثبات الخبر المستقبل وهي مبنية من ثلاث كلمات : لا ك ان لا نفي والكاف خطاب وان اثبات وتحقيق فذهبت الهمزة استثقالا وهي تثقل وتخفف فاذا ثقلت نصبت كان الثقيلة واذا خففت رفعت بها كما ترفع بان الخفيفة الثالثة السحر قيل : السحر اصله التمويه بالحيل والتخايل وهو ان يفعل الساحر اشياء ومعاني فيخيل للمسحور انها بخلاف ما هي به كالذي يري السراب من بعيد فيخيل اليه انه ماء وكراكب السفينة الساءرة سيرا حثيثا يخيل اليه ان ما يري من الاشجار والجبال ساءرة معه وقيل : هو مشتق من سحرت الصبي اذا خدعته وكذلك اذا عللته والتسحير مثله قال لبيد : فان تسالينا فيم نحن فاننا * عصافير من هذا الانام المسحر  اخر : ارانا موضعين لامر غيب * ونسحر بالطعام وبالشراب عصافير وذبان ودود * واجرا من مجلحة الذءاب وقوله تعالي : انما انت من المسحرين الشعراء يقال : المسحر الذي خلق ذا سحر ويقال من المعللين اي ممن ياكل الطعام ويشرب الشراب وقيل : اصله الخفاء فان الساحر يفعله في خفية وقيل : اصله الصرف يقال : ما سحرك عن كذا اي ما صرفك عنه فالسحر مصروف عن جهته وقيل : اصله الاستمالة وكل من استمالك فقد سحرك وقيل في قوله تعالي : بل نحن قوم مسحورون اي سحرنا فازلنا بالتخييل عن معرفتنا وقال الجوهري : السحر الاخذة وكل ما لطف ماخذه ودق فهو سحر وقد سحره يسحره سحرا والساحر : العالم وسحره ايضا بمعني خدعه وقد ذكرناه وقال بن مسعود : كنا نسمي السحر في الجاهلية العضة والعضة عند العرب : شدة البهت وتمويه الكذب قال الشاعر : اعوذ بربي من النافثا * ت في عضة العاضة المعضة الرابعة واختلف هل له حقيقة ام لا فذكر الغزنوي الحنفي في عيون المعاني له : ان السحر عند المعتزلة خدع لا اصل له وعند الشافعي وسوسة وامراض قال : وعندنا اصله طلسم يبني علي تاثير خصاءص الكواكب كتاثير الشمس في زءبق عصي فرعون او تعظيم الشياطين ليسهلوا له ما عسر قلت : وعندنا انه حق وله حقيقة يخلق الله عنده ما شاء علي ما ياتي ثم من السحر ما يكون بخفة اليد كالشعوذة والشعوذي : البريد لخفة سيره قال بن فارس في المجمل : الشعوذة ليس من كلام اهل البادية وهي خفة في اليدين واخذه كالسحر ومنه ما يكون كلاما يحفظ ورقي من اسماء الله تعالي وقد يكون من عهود الشياطين ويكون ادوية وادخنة وغير ذلك  الخامسة سمي رسول الله صلي الله عليه وسلم الفصاحة في الكلام واللسانة فيه سحرا فقال : ( ان من البيان لسحرا ( اخرجه مالك وغيره وذلك لان فيه تصويب الباطل حتي يتوهم السامع انه حق فعلي هذا يكون قوله عليه السلام ( ان من البيان لسحرا ( خرج مخرج الذم للبلاغة والفصاحة اذ شبهها بالسحر وقيل : خرج مخرج المدح للبلاغة والتفضيل للبيان قال جماعة من اهل العلم والاول اصح والدليل عليه قوله عليه السلام : ( فلعل بعضكم ان يكون الحن بحجته من بعض ( وقوله : ( ان ابغضكم الي الثرثارون المتفيهقون الثرثرة كثرة الكلام وترديده يقال ثرثر الرجل فهو ثرثار مهذار والمتفيهق نحوه قال بن دريد فلان يتفيهق في كلامه اذا توسع فيه وتنطع قال : واصله الفهق وهو الامتلاء كانه ملا به فمه قلت : وبهذا المعني الذي ذكرناه فسره عامر الشعبي راوي الحديث وصعصعة بن صوحان فقالا : اما قوله صلي الله عليه وسلم : ( ان من البيان لسحرا ( فالرجل يكون عليه الحق وهو الحن بالحجج من صاحب الحق فيسحر القوم ببيانه فيذهب بالحق وهو عليه وانما يحمد العلماء البلاغة واللسانة ما لم تخرج الي حد الاسهاب والاطناب وتصوير الباطل في صورة الحق وهذا بين والحمد لله السادسة من السحر ما يكون كفرا من فاعله مثل ما يدعون من تغيير صور الناس واخراجهم في هيءة بهيمة وقطع مسافة شهر في ليلة والطيران في الهواء فكل من فعل هذا ليوهم الناس انه محق فذلك كفر منه قاله ابو نصر عبد الرحيم القشيري قال ابو عمرو : من زعم ان الساحر يقلب الحيوان من صورة الي صورة فيجعل الانسان حمارا او نحوه ويقدر علي نقل الاجساد وهلاكها وتبديلها فهذا يري قتل الساحر لانه كافر بالانبياء يدعي مثل اياتهم ومعجزاتهم ولا يتهيا مع هذا علم صحة النبوة اذ قد يحصل مثلها بالحيلة واما من زعم ان السحر خدع ومخاريق وتمويهات وتخييلات فلم يجب علي اصله قتل الساحر الا ان يقتل بفعله احدا فيقتل به  السابعة ذهب اهل السنة الي ان السحر ثابت وله حقيقة وذهب عامة المعتزلة وابو اسحاق الاسترابادي من اصحاب الشافعي الي ان السحر لا حقيقة له وانما هو تمويه وتخييل وايهام لكون الشء علي غير ما هو به وانه ضرب من الخفة والشعوذة كما قال تعالي : يخيل اليه من سحرهم انها تسعي ولم يقل تسعي علي الحقيقة ولكن قال يخيل اليه وقال ايضا : سحروا اعين الناس وهذا لا حجة فيه لانا لا ننكر ان يكون التخييل وغيره من جملة السحر ولكن ثبت وراء ذلك امور جوزها العقل وورد بها السمع فمن ذلك ما جاء في هذه الاية من ذكر السحر وتعليمه ولو لم يكن له حقيقة لم يمكن تعليمه ولا اخبر تعالي انهم يعلمونه الناس فدل علي ان له حقيقة وقوله تعالي في قصة سحرة فرعون : وجاءوا بسحر عظيم وسورة الفلق مع اتفاق المفسرين علي ان سبب نزولها ما كان من سحر لبيد بن الاعصم وهو مما خرجه البخاري ومسلم وغيرهما عن عاءشة رضي الله عنها قالت : سحر رسول الله صلي الله عليه وسلم يهودي من يهود بني زريق يقال له لبيد بن الاعصم الحديث وفيه : ان النبي صلي الله عليه وسلم قال لما حل السحر : ( ان الله شفاني ( والشفاء انما يكون برفع العلة وزوال المرض فدل علي ان له حقا وحقيقة فهو مقطوع به باخبار الله تعالي ورسوله علي وجوده ووقوعه وعلي هذا اهل الحل والعقد الذين ينعقد بهم الاجماع ولا عبرة مع اتفاقهم بحثالة المعتزلة ومخالفتهم اهل الحق ولقد شاع السحر وذاع في سابق الزمان وتكلم الناس فيه ولم يبد من الصحابة ولا من التابعين انكار لاصله وروي سفيان عن ابي الاعور عن عكرمة عن بن عباس قال : علم السحر في قرية من قري مصر يقال لها : الفرما فمن كذب به فهو كافر مكذب لله ورسوله منكر لما علم مشاهدة وعيانا الثامنة قال علماءنا : لا ينكر ان يظهر علي يد الساحر خرق العادات مما ليس في مقدور البشر من مرض وتفريق وزوال عقل وتعويج عضو الي غير ذلك مما قام الدليل علي استحالة كونه من مقدورات العباد قالوا : ولا يبعد في السحر ان يستدق جسم الساحر حتي يتولج في الكوات والخوخات والانتصاب علي راس قصبة والجري علي  خيط مستدق والطيران في الهواء والمشي علي الماء وركوب كلب وغير ذلك ومع ذلك فلا يكون السحر موجبا لذلك ولا علة لوقوعه ولا سببا مولدا ولا يكون الساحر مستقلا به وانما يخلق الله تعالي هذه الاشياء ويحدثها عند وجود السحر كما يخلق الشبع عند الاكل والري عند شرب الماء روي سفيان عن عمار الذهبي ان ساحرا كان عند الوليد بن عقبة يمشي علي الحبل ويدخل في است الحمار ويخرج من فيه فاشتمل له جندب علي السيف فقتله جندب هذا هو جندب بن كعب الازدي ويقال البجلي وهو الذي قال في حقه النبي صلي الله عليه وسلم : ( يكون في امتي رجل يقال له جندب يضرب ضربة بالسيف يفرق بين الحق والباطل ( فكانوا يرونه جندبا هذا قاتل الساحر قال علي بن المديني : روي عنه حارثة بن مضرب التاسعة اجمع المسلمون علي انه ليس في السحر ما يفعل الله عنده انزال الجراد والقمل والضفادع وفلق البحر وقلب العصا واحياء الموتي وانطاق العجماء وامثال ذلك من عظيم ايات الرسل عليهم السلام فهذا ونحوه مما يجب القطع بانه لا يكون ولا يفعله الله عند ارادة الساحر قال القاضي ابو بكر بن الطيب : وانما منعنا ذلك بالاجماع ولولاه لاجزناه العاشرة في الفرق بين السحر والمعجزة قال علماءنا : السحر يوجد من الساحر وغيره وقد يكون جماعة يعرفونه ويمكنهم الاتيان به في وقت واحد والمعجزة لا يمكن الله احدا ان ياتي بمثلها وبمعارضتها ثم الساحر لم يدع النبوة فالذي يصدر منه متميز عن المعجزة فان المعجزة شرطها اقتران دعوي النبوة والتحدي بها كما تقدم في مقدمة الكتاب الحادية عشرة واختلف الفقهاء في حكم الساحر المسلم والذمي فذهب مالك الي ان المسلم اذا سحر بنفسه بكلام يكون كفرا يقتل ولا يستتاب ولا تقبل توبته لانه امر يستسر به كالزنديق والزاني ولان الله تعالي سمي السحر كفرا بقوله : وما يعلمان من احد حتي يقولا انما نحن فتنة فلا تكفر وهو قول احمد بن حنبل وابي ثور واسحاق والشافعي  وابي حنيفة وروي قتل الساحر عن عمر وعثمان وبن عمر وحفصة وابي موسي وقيس بن سعد وعن سبعة من التابعين وروي عن النبي صلي الله عليه وسلم : ( حد الساحر ضربه بالسيف ( خرجه الترمذي وليس بالقوي انفرد به اسماعيل بن مسلم وهو ضعيف عندهم رواه بن عيينة عن اسماعيل بن مسلم عن الحسن مرسلا ومنهم من جعله عن الحسن عن جندب قال بن المنذر : وقد روينا عن عاءشة انها باعت ساحرة كانت سحرتها وجعلت ثمنها في الرقاب قال بن المنذر : واذا اقر الرجل انه سحر بكلام يكون كفرا وجب قتله ان لم يتب وكذلك لو ثبتت به عليه بينة ووصفت البينة كلاما يكون كفرا وان كان الكلام الذي ذكر انه سحر به ليس بكفر لم يجز قتله فان كان احدث في المسحور جناية توجب القصاص اقتص منه ان كان عمد ذلك وان كان مما لا قصاص فيه ففيه دية ذلك قال بن المنذر : واذا اختلف اصحاب رسول الله صلي الله عليه وسلم في المسالة وجب اتباع اشبههم بالكتاب والسنة وقد يجوز ان يكون السحر الذي امر من امر منهم بقتل الساحر سحرا يكون كفرا فيكون ذلك موافقا لسنة رسول الله صلي الله عليه وسلم ويحتمل ان تكون عاءشة رضي الله عنها امرت ببيع ساحرة لم يكن سحرها كفرا فان احتج محتج بحديث جندب عن النبي صلي الله عليه وسلم : ( حد الساحر ضربه بالسيف ( فلو صح لاحتمل ان يكون امر بقتل الساحر الذي يكون سحره كفرا فيكون ذلك موافقا للاخبار التي جاءت عن النبي صلي الله عليه وسلم انه قال : ( لا يحل دم امرء مسلم الا باحدي ثلاث ( قلت : وهذا صحيح ودماء المسلمين محظورة لا تستباح الا بيقين ولا يقين مع الاختلاف والله تعالي اعلم وقال بعض العلماء : ان قال اهل الصناعة ان السحر لا يتم الا مع الكفر والاستكبار او تعظيم الشيطان فالسحر اذا دال علي الكفر علي هذا التقدير والله تعالي اعلم وروي عن الشافعي : لا يقتل الساحر الا ان يقتل بسحره ويقول تعمدت القتل وان قال لم اتعمده لم يقتل وكانت فيه الدية كقتل الخطا وان اضر به ادب علي قدر الضرر قال بن العربي : وهذا باطل من وجهين احدهما : انه لم يعلم السحر وحقيقته انه كلام  مءلف يعظم به غير الله تعالي وتنسب اليه المقادير والكاءنات الثاني : ان الله سبحانه قد صرح في كتابه بانه كفر فقال : وما كفر سليمان بقول السحر ولكن الشياطين كفروا به وبتعليمه وهاروت وماروت يقولان : انما نحن فتنة فلا تكفر وهذا تاكيد للبيان احتج اصحاب مالك بانه لا تقبل توبته لان السحر باطن لا يظهره صاحبه فلا تعرف توبته كالزنديق وانما يستتاب من اظهر الكفر مرتدا قال مالك : فان جاء الساحر او الزنديق تاءبا قبل ان يشهد عليهما قبلت توبتهما والحجة لذلك قوله تعالي : فلم يك ينفعهم ايمانهم لما راوا باسنا فدل علي انه كان ينفعهم ايمانهم قبل نزول العذاب فكذلك هذان الثاية عشرة واما ساحر الذمة فقيل يقتل وقال مالك : لا يقتل الا ان يقتل بسحره ويضمن ما جني ويقتل ان جاء منه ما لم يعاهد عليه وقال بن خويز منداد : فاما اذا كان ذميا فقد اختلفت الرواية عن مالك فقال مرة : يستتاب وتوبته الاسلام وقال مرة : يقتل وان اسلم واما الحربي فلا يقتل اذا تاب وكذلك قال مالك في ذمي سب النبي صلي الله عليه وسلم : يستتاب وتوبته الاسلام وقال مرة يقتل ولا يستتاب كالمسلم وقال مالك ايضا في الذمي اذا سحر يعاقب الا ان يكون قتل بسحره او احدث حدثا فيءخذ منه بقدره وقال غيره : يقتل لانه قد نقض العهد ولا يرث الساحر ورثته لانه كافر الا ان يكون سحره لا يسمي كفرا وقال مالك في المراة تعقد زوجها عن نفسها او عن غيرها : تنكل ولا تقتل الثالثة عشرة واختلفوا هل يسال الساحر حل السحر عن المسحور فاجازه سعيد بن المسيب علي ما ذكره البخاري واليه مال المزني وكرهه الحسن البصري وقال الشعبي لا باس بالنشرة قال بن بطال : وفي كتاب وهب بن منبه ان ياخذ سبع ورقات من سدر  اخضر فيدقه بين حجرين ثم يضربه بالماء ويقرا عليه اية الكرسي ثم يحسو منه ثلاث حسوات ويغتسل به فانه يذهب عنه كل ما به ان شاء الله تعالي وهو جيد للرجل اذا حبس عن اهله الرابعة عشرة انكر معظم المعتزلة الشياطين والجن ودل انكارهم علي قلة مبالاتهم وركاكة دياناتهم وليس في اثباتهم مستحيل عقلي وقد دلت نصوص الكتاب والسنة علي اثباتهم وحق علي اللبيب المعتصم بحبل الله ان يثبت ما قضي العقل بجوازه ونص الشرع علي ثبوته قال الله تعالي : ولكن الشياطين كفروا وقال : ومن الشياطين من يغوصون له الانبياء الي غير ذلك من الاي وسورة الجن تقضي بذلك وقال عليه السلام : ( ان الشيطان يجري من بن ادم مجري الدم ( وقد انكر هذا الخبر كثير من الناس واحالوا روحين في جسد والعقل لا يحيل سلوكهم في الانس اذا كانت اجسامهم رقيقة بسيطة علي ما يقوله بعض الناس بل اكثرهم ولو كانوا كثافا لصح ذلك ايضا منهم كما يصح دخول الطعام والشراب في الفراغ من الجسم وكذلك الديدان قد تكون في بني ادم وهي احياء الخامسة عشرة قوله تعالي : ( وما انزل علي الملكين ) ما نفي والواو للعطف علي قوله : وما كفر سليمان وذلك ان اليهود قالوا : ان الله انزل جبريل وميكاءيل بالسحر فنفي الله ذلك وفي الكلام تقديم وتاخير التقدير وما كفر سليمان وما انزل علي الملكين ولكن الشياطين كفروا يعلمون الناس السحر ببابل هاروت وماروت فهاروت وماروت بدل من الشياطين في قوله ولكن الشياطين كفروا هذا اولي ما حملت عليه الاية من التاويل واصح ما قيل فيها ولا يلتفت الي سواه فالسحر من استخراج الشياطين للطافة جوهرهم ودقة افهامهم واكثر ما يتعاطاه من الانس النساء وخاصة في حال طمثهن قال الله تعالي : ومن شر النفاثات في العقد الفلق وقال الشاعر : اعوذ بربي من النافثات السادسة عشرة ان قال قاءل : كيف يكون اثنان بدلا من جمع والبدل انما يكون علي حد المبدل منه فالجواب من وجوه ثلاثة الاول : ان الاثنين قد يطلق عليهما اسم  الجمع كما قال تعالي : فان كان له اخوة فلامه السدس ولا يحجبها عن الثلث الي السدس الا اثنان من الاخوة فصاعدا علي ما ياتي بيانه في النساء الثاني : انهما لما كانا الراس في التعليم نص عليهما دون اتباعهما كما قال تعالي : عليها تسعة عشر المدثر الثالث : انما خصا بالذكر من بينهم لتمردهما كما قال تعالي : فيهما فاكهة ونخل ورمان الرحمن وقوله : وجبريل وميكال وهذا كثير في القران وفي كلام العرب فقد ينص بالذكر علي بعض اشخاص العموم اما لشرفه واما لفضله كقوله تعالي : ان اولي الناس بابراهيم للذين اتبعوه وهذا النبي وقوله : وجبريل وميكال واما لطيبه كقوله : فاكهة ونخل ورمان الرحمن واما لاكثريته كقوله صلي الله عليه وسلم : ( جعلت لي الارض مسجدا وتربتها طهورا ( واما لتمرده وعتوه كما في هذه الاية والله تعالي اعلم وقد قيل : ان ما عطف علي السحر وهي مفعولة فعلي هذا يكون ما بمعني الذي ويكون السحر منزلا علي الملكين فتنة للناس وامتحانا ولله ان يمتحن عباده بما شاء كما امتحن بنهر طالوت ولهذا يقول الملكان : انما نحن فتنة اي محنة من الله نخبرك ان عمل الساحر كفر فان اطعتنا نجوت وان عصيتنا هلكت وقد روي عن علي وبن مسعود وبن عباس وبن عمر وكعب الاحبار والسدي والكلبي ما معناه : انه لما كثر الفساد من اولاد ادم عليه السلام وذلك في زمن ادريس عليه السلام عيرتهم الملاءكة فقال الله تعالي اما انكم لو كنتم مكانهم وركبت فيكم ما ركبت فيهم لعملتم مثل اعمالهم فقالوا : سبحانك ما كان ينبغي لنا ذلك قال : فاختاروا ملكين من خياركم فاختاروا هاروت وماروت فانزلهما الي الارض فركب فيهما الشهوة فما مر بهما شهر حتي فتنا بامراة اسمها بالنبطية بيدخت وبالفارسية ناهيل وبالعربية الزهرة اختصمت اليهما وراوداها عن نفسها فابت الا ان يدخلا في دينها ويشربا الخمر ويقتلا النفس التي حرم الله فاجاباها وشربا الخمر والما بها فراهما رجل فقتلاه وسالتهما عن الاسم الذي يصعدان به الي السماء فعلماها فتكلمت به  فعرجت فمسخت كوكبا وقال سالم عن ابيه عن عبد الله : فحدثني كعب الحبر انهما لم يستكملا يومهما حتي عملا بما حرم الله عليهما وفي غير هذا الحديث : فخيرا بين عذاب الدنيا وعذاب الاخرة فاختارا عذاب الدنيا فهما يعذبان ببابل في سرب من الارض قيل : بابل العراق وقيل : بابل نهاوند وكان بن عمر فيما يروي عن عطاء انه كان اذا راي الزهرة وسهيلا سبهما وشتمهما ويقول : ان سهيلا كان عشارا باليمن يظلم الناس وان الزهرة كانت صاحبة هاروت وماروت قلنا : هذا كله ضعيف وبعيد عن بن عمر وغيره لا يصح منه شء فانه قول تدفعه الاصول في الملاءكة الذين هم امناء الله علي وحيه وسفراءه الي رسله لا يعصون الله ما امرهم ويفعلون ما يءمرون بل عباد مكرمون لا يسبقونه بالقول وهم بامره يعملون يسبحون الليل والنهار لا يفترون واما العقل فلا ينكر وقوع المعصية من الملاءكة ويوجد منهم خلاف ما كلفوه ويخلق فيهم الشهوات اذ في قدرة الله تعالي كل موهوم ومن هذا خوف الانبياء والاولياء الفضلاء العلماء لكن وقوع هذا الجاءز لا يدرك الا بالسمع ولم يصح ومما يدل علي عدم صحته ان الله تعالي خلق النجوم وهذه الكواكب حين خلق السماء ففي الخبر ان السماء لما خلقت خلق فيها سبعة دوارة زحل والمشتري وبهرام وعطارد والزهرة والشمس والقمر وهذا معني قول الله تعالي : وكل في فلك يسبحون فثبت بهذا ان الزهرة وسهيلا قد كانا قبل خلق ادم ثم ان قول الملاءكة : ما كان ينبغي لنا عورة : لا تقدر علي فتنتنا وهذا كفر نعوذ بالله منه ومن نسبته الي الملاءكة الكرام صلوات الله عليهم اجمعين وقد نزهناهم وهم المنزهون عن كل ما ذكره ونقله المفسرون سبحان ربك رب العزة عما يصفون السادسة عشرة قرا بن عباس وبن ابزي والضحاك والحسن : الملكين بكسر اللام قال بن ابزي : هما داءد وسليمان ف ما علي هذا القول ايضا نافية وضعف هذا القول بن العربي وقال الحسن : هما علجان كانا ببابل ملكين ف ما علي هذا القول مفعولة غير نافية  الثامنة عشرة قوله تعالي : ( ببابل ) بابل لا ينصرف للتانيث والتعريف والعجمة وهي قطر من الارض قيل : العراق وما والاه وقال بن مسعود لاهل الكوفة : انتم بين الحيرة وبابل وقال قتادة : هي من نصيبين الي راس العين وقال قوم : هي بالمغرب قال بن عطية : وهذا ضعيف وقال قوم : هو جبل نهاوند فالله تعالي اعلم واختلف في تسميته ببابل فقيل : سمي بذلك لتبلبل الالسن بها حين سقط صرح نمروذ وقيل : سمي به لان الله تعالي لما اراد ان يخالف بين السنة بني ادم بعث ريحا فحشرتهم من الافاق الي بابل فبلبل الله السنتهم بها ثم فرقتهم تلك الريح في البلاد والبلبلة : التفريق قال معناه الخليل وقال ابو عمر بن عبد البر : من اخصر ما قيل في البلبلة واحسنه ما رواه داءد بن ابي هند عن علباء بن احمر عن عكرمة عن بن عباس ان نوحا عليه السلام لما هبط الي اسفل الجودي ابتني قرية وسماها ثمانين فاصبح ذات يوم وقد تبلبلت السنتهم علي ثمانين لغة احداها اللسان العربي وكان لا يفهم بعضهم عن بعض التاسعة عشرة روي عبد الله بن بشر المازني قال قال رسول الله صلي الله عليه وسلم : ( اتقوا الدنيا فوالذي نفسي بيده انها لاسحر من هاروت وماروت ( قال علماءنا : انما كانت الدنيا اسحر منهما لانها تسحرك بخدعها وتكتمك فتنتها فتدعوك الي التحارص عليها والتنافس فيها والجمع لها والمنع حتي تفرق بينك وبين طاعة الله تعالي وتفرق بينك وبين رءية الحق ورعايته فالدنيا اسحر منهما تاخذ بقلبك عن الله وعن القيام بحقوقه وعن وعده ووعيده وسحر الدنيا : محبتها وتلذذك بشهواتها وتمنيك بامانيها الكاذبة حتي تاخذ بقلبك ولهذا قال رسول الله صلي الله عليه وسلم : ( حبك الشء يعمي ويصم ( الموفية عشرين قوله تعالي : ( هاروت وماروت ) لا ينصرف هاروت لانه اعجمي معرفة وكذا ماروت ويجمع هواريت ومواريت مثل طواغيت ويقال : هوارتة وهوار وموارتة وموار ومثله جالوت وطالوت فاعلم وقد تقدم هل هما ملكان او غيرهما خلاف قال الزجاج : وروي عن علي رضي الله عنه انه قال : اي والذي انزل  علي الملكين وان الملكين يعلمان الناس تعليم انذار من السحر لا تعليم دعاء اليه قال الزجاج : وهذا القول الذي عليه اكثر اهل اللغة والنظر ومعناه انهما يعلمان الناس علي النهي فيقولان لهم : لا تفعلوا كذا ولا تحتالوا بكذا لتفرقوا بين المرء وزوجه والذي انزل عليهما هو النهي كانه قولا للناس : لا تعملوا كذا ف يعلمان بمعني يعلمان كما قال : ولقد كرمنا بني ادم اي اكرمنا الحادية والعشرون قوله تعالي : ( وما يعلمان من احد ) من زاءدة للتوكيد والتقدير : وما يعلمان احدا ( حتي يقولا ) نصب بحتي فلذلك حذفت منه النون ولعة هذيل وثقيف عتي بالعين غير المعجمة والضمير في يعلمان لهاروت وماروت وفي يعلمان قولان احدهما : انه علي بابه من التعليم الثاني : انه من الاعلام لا من التعليم ف يعلمان بمعني يعلمان وقد جاء في كلام العرب تعلم بمعني اعلم ذكره بن الاعرابي وبن الانباري قال كعب بن مالك : تعلم رسول الله انك مدركي * وان وعيدا منك كالاخذ باليد وقال القطامي : تعلم ان بعد الغي رشدا * وان لذلك الغي انقشاعا وقال زهير : تعلمن ها لعمر الله ذا قسما * فاقدر بذرعك وانظر اين تنسلك وقال اخر : تعلم انه لا طير الا * علي متطير وهو الثبور ( انما نحن فتنة ) لما انبا بفتنتهما كانت الدنيا اسحر منهما حين كتمت فتنتها ( فلا تكفر ) قالت فرقة بتعليم السحر وقالت فرقة باستعماله وحكي المهدوي انه استهزاء لانهما انما يقولانه لمن قد تحققا ضلاله  الثانية والعشرون قوله تعالي : ( فيتعلمون منهما ) قال سيبويه : التقدير فهم يتعلمون قال ومثله كن فيكون وقيل : هو معطوف علي موضع ما يعلمان لان قوله : وما يعلمان وان دخلت عليه ما النافية فمضمنه الايجاب في التعليم وقال الفراء : هي مردودة علي قوله : يعلمون الناس السحر فيتعلمون ويكون فيتعلمون متصلة بقوله انما نحن فتنة فياتون فيتعلمون قال السدي : كانا يقولان لمن جاءهما : انما نحن فتنة فلا تكفر فان ابي ان يرجع قالا له : اءت هذا الرماد قبل فيه فاذا بال فيه خرج منه نور يسطع الي السماء وهو الايمان ثم يخرج منه دخان اسود فيدخل في اذنيه وهو الكفر فاذا اخبرهما بما راه من ذلك علماه ما يفرقون به بين المرء وزوجه ذهبت طاءفة من العلماء الي ان الساحر ليس يقدر علي اكثر مما اخبر الله عنه من التفرقة لان الله ذكر ذلك في معرض الذم للسحر والغاية في تعليمه فلو كان يقدر علي اكثر من ذلك لذكره وقالت طاءفة : ذلك خرج علي الاغلب ولا ينكر ان السحر له تاثير في القلوب بالحب والبغض وبالقاء الشرور حتي يفرق الساحر بين المرء وزوجه ويحول بين المرء وقلبه وذلك بادخال الالام وعظيم الاسقام وكل ذلك مدرك بالمشاهدة وانكاره معاندة وقد تقدم هذا والحمد لله الثالثة والعشرون ق وله تعالي : ( وما هم بضارين من احد الا باذن الله ) ما هم اشارة الي السحرة وقيل الي اليهود وقيل الي الشياطين بضارين به اي بالسحر من احد اي احدا ومن زاءدة الا باذن الله اي بارادته وقضاءه لا بامره لانه تعالي لا يامر بالفحشاء ويقضي علي الخلق بها وقال الزجاج : الا باذن الله الا بعلم الله قال النحاس : وقول ابي اسحاق الا باذن الله الا بعلم الله غلط لانه انما يقال في العلم اذن وقد اذنت اذنا ولكن لما لم يحل فيما بينهم وبينه وظلوا يفعلونه كان كانه اباحه مجازا الرابعة والعشرون قوله تعالي : ( ويتعلمون ما يضرهم ) يريد في الاخرة وان اخذوا بها نفعا قليلا في الدنيا وقيل : يضرهم في الدنيا لان ضرر السحر والتفريق يعود  علي الساحر في الدنيا اذا عثر عليه لانه يءدب ويزجر ويلحقه شءم السحر وباقي الاي بين لتقدم معانيها واللام في ولقد علموا لام توكيد لمن اشتراه لام يمين وهي للتوكيد ايضا وموضع من رفع بالابتداء لانه لا يعمل ما قبل اللام فيما بعدها ومن بمعني الذي وقال الفراء : هي للمجازاة وقال الزجاج : ليس هذا بموضع شرط ومن بمعني الذي كما تقول : لقد علمت لمن جاءك ما له عقل من خلاق من زاءدة والتقدير ما له في الاخرة خلاق ولا تزاد في الواجب هذا قول البصريين وقال الكوفيون : تكون زاءدة في الواجب واستدلوا بقوله تعالي : يغفر لكم من ذنوبكم نوح والخلاق : النصيب قاله مجاهد قال الزجاج : وكذلك هو عند اهل اللغة الا انه لا يكاد يستعمل الا للنصيب من الخير وسءل عن قوله تعالي : ( ولقد علموا لمن اشتراه ما له في الاخرة من خلاق ) فاخبر انهم قد علموا ثم قال : ( ولبءس ما شروا به انفسهم لو كانوا يعلمون ) فاخبر انهم لا يعلمون فالجواب وهو قول قطرب والاخفش : ان يكون الذين يعلمون الشياطين والذين شروا انفسهم اي باعوها هم الانس الذين لا يعلمون قال الزجاج وقال علي بن سليمان : الاجود عندي ان يكون ولقد علموا للملكين لانهما اولي بان يعلموا وقال علموا كما يقال : الزيدان قاموا وقال الزجاج : الذين علموا علماء اليهود ولكن قيل : لو كانوا يعلمون اي فدخلوا في محل من يقال له : لست بعالم لانهم تركوا العمل بعلمهم واسترشدوا من الذين عملوا بالسحر < <
