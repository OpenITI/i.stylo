 > فيه ثلاث عشرة مسالة : الاولي قوله تعالي : ( لا تحلوا شعاءر الله ) خطاب للمءمنين حقا اي لا تتعدوا حدود الله في امر من الامور والشعاءر جمع شعيرة علي وزن فعيلة وقال بن فارس : ويقال للواحدة شعارة وهو احسن والشعيرة البدنة تهدي واشعارها ان يجز سنامها حتي يسيل منه الدم فيعلم انها هدي والاشعار الاعلام من طريق الاحساس يقال : اشعر هديه اي جعل له علامة ليعرف انه هدي ومنه المشاعر المعالم واحدها مشعر وهي المواضع التي قد اشعرت بالعلامات ومنه الشعر لانه يكون بحيث يقع الشعور ومنه الشاعر لانه يشعر بفطنته لما لا يفطن له غيره ومنه الشعير لشعرته التي في راسه فالشعاءر علي قول ما اشعر من الحيوانات لتهدي الي بيت الله وعلي قول جميع مناسك الحج قاله بن عباس وقال مجاهد : الصفا والمروة والهدي والبدن كل ذلك من الشعاءر وقال الشاعر : نقتلهم جيلا فجيلا تراهم * شعاءر قربان بها يتقرب وكان المشركون يحجون ويعتمرون ويهدون فاراد المسلمون ان يغيروا عليهم فانزل الله تعالي : لا تحلوا شعاءر الله وقال عطاء بن ابي رباح : شعاءر الله جميع ما امر الله به ونهي عنه وقال الحسن : دين الله كله كقوله : ذلك ومن يعظم شعاءر الله فانها من تقوي القلوب اي دين الله  قلت : وهذا القول هو الراجح الذي يقدم علي غيره لعمومه وقد اختلف العلماء في اشعار الهدي وهي : الثانية فاجاز الجمهور ثم اختلفوا في اي جهة يشعر فقال الشافعي واحمد وابو ثور : يكون في الجانب الايمن وروي عن بن عمر وثبت عن بن عباس ان النبي صلي الله عليه وسلم اشعر ناقته في صفحة سنامها الايمن اخرجه مسلم وغيره وهو الصحيح وروي انه اشعر بدنه من الجانب الايسر قال ابو عمر بن عبد البر : هذا عندي حديث منكر من حديث بن عباس والصحيح حديث مسلم عن بن عباس قال : ولا يصح عنه غيره وصفحة السنام جانبه والسنام اعلي الظهر وقالت طاءفة : يكون في الجانب الايسر وهو قول مالك وقال : لا باس به في الجانب الايمن وقال مجاهد : من اي الجانبين شاء وبه قال احمد في احد قوليه ومنع من هذا كله ابو حنيفة وقال : انه تعذيب للحيوان والحديث يرد عليه وايضا فذلك يجري مجري الوسم الذي يعرف به الملك كما تقدم وقد اوغل بن العربي علي ابي حنيفة في الرد والانكار حين لم ير الاشعار فقال : كانه لم يسمع بهذه الشعيرة في الشريعة لهي اشهر منه في العلماء قلت : والذي رايته منصوصا في كتب علماء الحنفية الاشعار مكروه من قول ابي حنيفة وعند ابي يوسف ومحمد ليس بمكروه ولا سنة بل هو مباح لان الاشعار لما كان اعلاما كان سنة بمنزلة التقليد ومن حيث انه جرح ومثله كان حراما فكان مشتملا علي السنة والبدعة فجعل مباحا ولابي حنيفة ان الاشعار مثله وانه حرام من حيث انه تعذيب الحيوان فكان مكروها وما روي عن رسول الله صلي الله عليه وسلم انما كان في اول الابتداء حين كانت العرب تنتهب كل مال الا ما جعل هديا وكانوا لا يعرفون الهدي الا بالاشعار ثم زال لزوال العذر هكذا روي عن بن عباس وحكي عن الشيخ الامام ابي منصور الماتريدي رحمه الله تعالي انه قال : يحتمل ان ابا حنيفة كره اشعار اهل زمانه وهو المبالغة في البضع علي وجه يخاف منه السراية اما ما لم يجاوز الحد فعل كما كان يفعل في عهد رسول الله صلي الله عليه وسلم  فهو حسن وهكذا ذكر ابو جعفر الطحاوي فهذا اعتذار علماء الحنفية لابي حنيفة عن الحديث الذي ورد في الاشعار فقد سمعوه ووصل اليهم وعلموه قالوا : وعلي القول بانه مكروه لا يصير به احد محرما لان مباشرة المكروه لا تعد من المناسك الثالثة قوله تعالي : ( ولا الشهر الحرام ) اسم مفرد يدل علي الجنس في جميع الاشهر الحرم وهي اربعة : واحد فرد وثلاثة سرد ياتي بيانها في براءة والمعني : لا تستحلوها للقتال ولا للغارة ولا تبدلوها فان استبدالها استحلال وذلك ما كانوا يفعلونه من النسء وكذلك قوله : ولا الهدي ولا القلاءد اي لا تستحلوه وهو علي حذف مضاف اي ولا ذوات القلاءد جمع قلادة فنهي سبحانه عن استحلال الهدي جملة ثم ذكر المقلد منه تاكيدا ومبالغة في التنبيه علي الحرمة في التقليد الرابعة قوله تعالي : ( ولا الهدي ولا القلاءد ) الهدي ما اهدي الي بيت الله تعالي من ناقة او بقرة او شاة الواحدة هدية وهدية وهدي فمن قال : اراد بالشعاءر المناسك قال : ذكر الهدي تنبيها علي تخصيصها ومن قال : الشعاءر الهدي قال : ان الشعاءر ما كان مشعرا اي معلما باسالة الدم من سنامه والهدي ما لم يشعر اكتفي فيه بالتقليد وقيل الفرق ان الشعاءر هي البدن من الانعام والهدي البقر والغنم والثياب وكل ما يهدي وقال الجمهور : الهدي عام في جميع ما يتقرب به من الذباءح والصدقات ومنه قوله عليه الصلاة والسلام ( المبكر الي الجمعة كالمهدي بدنة ( الي ان قال : ( كالمهدي بيضة ( فسماها هديا وتسمية البيضة هديا لا محمل له الا انه اراد به الصدقة وكذلك قال العلماء : اذا قال جعلت ثوبي هديا فعليه ان يتصدق به الا ان الاطلاق انما ينصرف الي احد الاصناف الثلاثة من الابل والبقر والغنم وسوقها الي الحرم وذبحها فيه وهذا انما تلقي من عرف الشرع في قوله تعالي : فان احصرتم فما استيسر من الهدي واراد به الشاة وقال تعالي : يحكم به ذوا عدل منكم هديا بالغ الكعبة وقال تعالي : فمن تمتع بالعمرة الي الحج  فما استيسر من الهدي واقله شاة عند الفقهاء وقال مالك : اذا قال ثوبي هدي يجعل ثمنه في هدي والقلاءد ما كان الناس يتقلدونه امنة لهم فهو علي حذف مضاف اي ولا اصحاب القلاءد ثم نسخ قال بن عباس : ايتان نسختا من الماءدة اية القلاءد وقوله : فان جاءوك فاحكم بينهم او اعرض عنهم فاما القلاءد فنسخها الامر بقتل المشركين حيث كانوا وفي اي شهر كانوا واما الاخري فنسخها قوله تعالي : وان احكم بينهم بما انزل الله علي ما ياتي وقيل : اراد بالقلاءد نفس القلاءد فهو نهي عن اخذ لحاء شجر الحرم حتي يتقلد به طلبا للامن قاله مجاهد وعطاء ومطرف بن الشخير والله اعلم وحقيقة الهدي كل معطي لم يذكر معه عوض واتفق الفقهاء علي ان من قال : لله علي هدي انه يبعث بثمنه الي مكة واما القلاءد فهي كل ما علق علي اسنمة الهدايا واعناقها علامة انه لله سبحانه من نعل او غيره وهي سنة ابراهيمية بقيت في الجاهلية واقرها الاسلام وهي سنة البقر والغنم قالت عاءشة رضي الله عنها : اهدي رسول الله صلي الله عليه وسلم مرة الي البيت غنما فقلدها اخرجه البخاري ومسلم والي هذا صار جماعة من العلماء : الشافعي واحمد واسحاق وابو ثور وبن حبيب وانكره مالك واصحاب الراي وكانهم لم يبلغهم هذا الحديث في تقليد الغنم او بلغ لكنهم ردوه لانفراد الاسود به عن عاءشة رضي الله عنها فالقول به اولي والله اعلم واما البقر فان كانت لها اسنمة اشعرت كالبدن قاله بن عمر وبه قال مالك وقال الشافعي : تقلد وتشعر مطلقا ولم يفرقوا وقال سعيد بن جبير : تقلد ولا تشعر وهذا القول اصح اذ ليس لها سنام وهي اشبه بالغنم منها بالابل والله اعلم الخامسة واتفقوا فيمن قلد بدنة علي نية الاحرام وساقها انه يصير محرما قال الله تعالي : لا تحلوا شعاءر الله الي ان قال : فاصطادوا ولم يذكر الاحرام لكن لما ذكر التقليد عرف انه بمنزلة الاحرام  السادسة فان بعث بالهدي ولم يسق بنفسه لم يكن محرما لحديث عاءشة قالت : انا فتلت قلاءد هدي رسول الله صلي الله عليه وسلم بيدي ثم قلدها بيديه ثم بعث بها مع ابي فلم يحرم علي رسول الله صلي الله عليه وسلم شء احله الله له حتي نحر الهدي اخرجه البخاري وهذا مذهب مالك والشافعي واحمد واسحاق وجمهور العلماء وروي عن بن عباس انه قال : يصير محرما قال بن عباس : من اهدي هديا حرم عليه ما يحرم علي الحاج حتي ينحر الهدي رواه البخاري وهذا مذهب بن عمر وعطاء ومجاهد وسعيد بن جبير وحكاه الخطابي عن اصحاب الراي واحتجوا بحديث جابر بن عبد الله قال : كنت عند النبي صلي الله عليه وسلم جالسا فقد قميصه من جيبه ثم اخرجه من رجليه فنظر القوم الي النبي صلي الله عليه وسلم فقال : ( اني امرت ببدني التي بعثت بها ان تقلد وتشعر علي مكان كذا وكذا فلبست قميصي ونسيت فلم اكن لاخرج قميصي من راسي ( وكان بعث ببدنه واقام بالمدينة في اسناده عبد الرحمن بن عطاء بن ابي لبيبة وهو ضعيف فان قلد شاة وتوجه معها فقال الكوفيون : لا يصير محرما لان تقليد الشاة ليس بمسنون ولا من الشعاءر لانه يخاف عليها الذءب فلا تصل الي الحرم بخلاف البدن فانها تترك حتي ترد الماء وترعي الشجر وتصل الي الحرم وفي صحيح البخاري عن عاءشة ام المءمنين قالت : فتلت قلاءدها من عهن كان عندي العهن الصوف المصبوغ ومنه قوله تعالي : وتكون الجبال كالعهن المنفوش السابعة ولا يجوز بيع الهدي ولا هبته اذا قلد او اشعر لانه قد وجب وان مات موجبه لم يورث عنه ونفذ لوجهه بخلاف الاضحية فانها لا تجب الا بالذبح خاصة عند مالك الا ان يوجبها بالقول فان اوجبها بالقول قبل الذبح فقال : جعلت هذه الشاة اضحية تعينت وعليه ان تلفت ثم وجدها ايام الذبح او بعدها ذبحها ولم يجز له بيعها فان كان اشتري اضحية غيرها ذبحهما جميعا في قول احمد واسحاق وقال الشافعي : لا بدل عليه اذا ضلت او سرقت انما الابدال في الواجب وروي عن بن عباس انه قال : اذا ضلت فقد اجزات ومن  مات يوم النحر قبل ان يضحي كانت ضحيته موروثة عنه كساءر ماله بخلاف الهدي وقال احمد وابو ثور : تذبح بكل حال وقال الاوزاعي : تذبح الا ان يكون عليه دين لا وفاء له الا من تلك الاضحية فتباع في دينه ولو مات بعد ذبحها لم يرثها عنه ورثته وصنعوا بها من الاكل والصدقة ما كان له ان يصنع بها ولا يقتسمون لحمها علي سبيل الميراث وما اصاب الاضحية قبل الذبح من العيوب كان علي صاحبها بدلها بخلاف الهدي هذا تحصيل مذهب مالك وقد قيل في الهدي علي صاحبه البدل والاول اصوب والله اعلم الثامنة قوله تعالي : ( ولا امين البيت الحرام ) يعني القاصدين له من قولهم اممت كذا اي قصدته وقرا الاعمش : ولا امي البيت الحرام بالاضافة كقوله : غير محلي الصيد والمعني : لا تمنعوا الكفار القاصدين البيت الحرام علي جهة التعبد والقربة وعليه فقيل : ما في هذه الايات من نهي عن مشرك او مراعاة حرمة له بقلادة او ام البيت فهو كله منسوخ باية السيف في قوله : فاقتلوا المشركين حيث وجدتموهم وقوله : فلا يقربوا المسجد الحرام بعد عامهم هذا فلا يمكن المشرك من الحج ولا يءمن في الاشهر الحرم وان اهدي وقلد وحج روي عن بن عباس وقاله بن زيد علي ما ياتي ذكره وقال قوم : الاية محكمة لم تنسخ وهي في المسلمين وقد نهي الله عن اخافة من يقصد بيته من المسلمين والنهي عام في الشهر الحرام وغيره ولكنه خص الشهر الحرام بالذكر تعظيما وتفضيلا وهذا يتمشي علي قول عطاء فان المعني لا تحلوا معالم الله وهي امره ونهيه وما اعلمه الناس فلا تحلوه ولذلك قال ابو ميسرة : هي محكمة وقال مجاهد : لم ينسخ منها الا القلاءد وكان الرجل يتقلد بشء من لحاء الحرم فلا يقرب فنسخ ذلك وقال بن جريج : هذه الاية نهي عن الحجاج ان تقطع سبلهم وقال بن زيد : نزلت الاية عام الفتح ورسول الله صلي الله عليه وسلم بمكة جاء اناس من المشركين يحجون ويعتمرون فقال المسلمون : يا رسول الله انما هءلاء مشركون فلن ندعهم الا ان نغير عليهم فنزل القران ولا امين البيت الحرام وقيل  كان هذا لامر شريح بن ضبيعة البكري ويلقب بالحطم اخذته جند رسول الله صلي الله عليه وسلم وهو في عمرته فنزلت هذه الاية ثم نسخ هذا الحكم كما ذكرنا وادرك الحطم هذا ردة اليمامة فقتل مرتدا وقد روي من خبره انه اتي النبي صلي الله عليه وسلم بالمدينة وخلف خيله خارج المدينة فقال : الام تدعو الناس فقال : ( الي شهادة ان لا اله الا الله واقام الصلاة وايتاء الزكاة ( فقال : حسن الا ان لي امراء لا اقطع امرا دونهم ولعلي اسلم واتي بهم وقد كان النبي صلي الله عليه وسلم قال لاصحابه : ( يدخل عليكم رجل يتكلم بلسان شيطان ( ثم خرج من عنده فقال عليه الصلاة والسلام : ( لقد دخل بوجه كافر وخرج بقفا غادر وما الرجل بمسلم ( فمر بسرح المدينة فاستاقه فطلبوه فعجزوا عنه فانطلق وهو يقول : قد لفها الليل بسواق حطم * ليس براعي ابل ولا غنم ولا بجزار علي ظهر وضم * باتوا نياما وبن هند لم ينم بات يقاسيها غلام كالزلم * خدلج الساقين خفاق القدم فلما خرج النبي صلي الله عليه وسلم عام القضية سمع تلبية حجاج اليمامة فقال : ( هذا الحطم واصحابه ( وكان قد قلد ما نهب من سرح المدينة واهداه الي مكة فتوجهوا في طلبه فنزلت الاية اي لا تحلوا ما اشعر لله وان كانوا مشركين ذكره بن عباس التاسعة وعلي ان الاية محكمة قوله تعالي : لا تحلوا شعاءر الله يوجب اتمام امور المناسك ولهذا قال العلماء : ان الرجل اذا دخل في الحج ثم افسده فعليه ان ياتي بجميع افعال الحج ولا يجوز ان يترك شيءا منها وان فسد حجه ثم عليه القضاء في السنة الثانية فال ابو الليث السمرقندي : وقوله تعالي : ولا الشهر الحرام منسوخ بقوله : وقاتلوا المشركين كافة وقوله : ولا الهدي ولا القلاءد محكم ولم ينسخ فكل من قلد الهدي  ونوي الاحرام صار محرما لا يجوز له ان يحل بدليل هذه الاية فهذه الاحكام معطوف بعضها علي بعض بعضها منسوخ وبعضها غير منسوخ العاشرة قوله تعالي : ( يبتغون فضلا من ربهم ورضوانا ) قال فيه جمهور المفسرين : معناه يبتغون الفضل والارباح في التجارة ويبتغون مع ذلك رضوانه في ظنهم وطمعهم وقيل : كان منهم من يبتغي التجارة ومنهم من يطلب بالحج رضوان الله وان كان لا يناله وكان من العرب من يعتقد جزاء بعد الموت وانه يبعث ولا يبعد ان يحصل له نوع تخفيف في النار قال بن عطية : هذه الاية استءلاف من الله تعالي للعرب ولطف بهم لتنبسط النفوس وتتداخل الناس ويردون الموسم فيستمعون القران ويدخل الايمان في قلوبهم وتقوم عندهم الحجة كالذي كان وهذه الاية نزلت عام الفتح فنسخ الله ذلك كله بعد عام سنة تسع اذ حج ابو بكر ونودي الناس بسورة براءة الحادية عشرة قوله تعالي : ( واذا حللتم فاصطادوا ) امر اباحة باجماع الناس رفع ما كان محظورا بالاحرام حكاه كثير من العلماء وليس بصحيح بل صيغة افعل الواردة بعد الحظر علي اصلها من الوجوب وهو مذهب القاضي ابي الطيب وغيره لان المقتضي للوجوب قاءم وتقدم الحظر لا يصلح مانعا دليله قوله تعالي : فاذا انسلخ الاشهر الحرم فاقتلوا المشركين فهذه افعل علي الوجوب لان المراد بها الجهاد وانما فهمت الاباحة هناك وما كان مثله من قوله : فاذا قضيت الصلاة فانتشروا فاذا تطهرن فاتوهن من النظر الي المعني والاجماع لا من صيغة الامر والله اعلم الثانية عشرة قوله تعالي : ( لا يجرمنكم شنان قوم ان صدوكم عن المسجد الحرام ) اي لا يحملنكم عن بن عباس وقتادة وهو قول الكساءي وابي العباس وهو يتعدي الي مفعولين يقال : جرمني كذا علي بغضك اي حملني عليه قال الشاعر : ولقد طعنت ابا عيينة طعنة * جرمت فزارة بعدها ان يغضبوا  وقال الاخفش : اي ولا يحقنكم وقال ابو عبيدة والفراء : معني لا يجرمنكم اي لا يكسبنكم بغض قوم ان تعتدوا الحق الي الباطل والعدل الي الظلم قال عليه السلام : ( اد الامانة الي من اءتمنك ولا تخن من خانك ( وقد مضي القول في هذا ونظير هذه الاية فمن اعتدي عليكم فاعتدوا عليه بمثل ما اعتدي عليكم وقد تقدم مستوفي ويقال : فلان جريمة اهله اي كاسبهم فالجريمة والجارم بمعني الكاسب واجرم فلان اي اكتسب الاثم ومنه قول الشاعر : جريمة ناهض في راس نيق * تري لعظام ما جمعت صليبا معناه كاسب قوت والصليب الودك وهذا هو الاصل في بناء ج ر م قال بن فارس : يقال جرم واجرم ولا جرم بمنزلة قولك : لا بد ولا محالة واصلها من جرم اي اكتسب قال : * جرمت فزارة بعدها ان يغضبوا * وقال اخر : يا ايها المشتكي عكلا وما جرمت * الي القباءل من قتل واباس ويقال : جرم يجرم جرما اذا قطع قال الرماني علي بن عيسي : وهو الاصل فجرم بمعني حمل علي الشء لقطعه من غيره وجرم بمعني كسب لانقطاعه الي الكسب وجرم بمعني حق لان الحق يقطع عليه وقال الخليل : لا جرم ان لهم النار لقد حق ان لهم العذاب وقال الكساءي : جرم واجرم لغتان بمعني واحد اي اكتسب وقرا بن مسعود يجرمنكم بضم الياء والمعني ايضا لا يكسبنكم ولا يعرف البصريون الضم وانما يقولون : جرم لا غير والشنان البغض وقرء بفتح النون واسكانها يقال : شنءت الرجل اشنءه شنا وشناة وشنانا  وشنانا بجزم النون كل ذلك اذا ابغضته اي لا يكسبنكم بغض قوم بصدهم اياكم ان تعتدوا والمراد بغضكم قوما فاضاف المصدر الي المفعول قال بن زيد : لما صد المسلمون عن البيت عام الحديبية مر بهم ناس من المشركين يريدون العمرة فقال المسلمون : نصدهم كما صدنا اصحابهم فنزلت هذه الاية اي لا تعتدوا علي هءلاء ولا تصدوهم ( ان صدوكم ) اصحابهم بفتح الهمزة مفعول من اجله اي لان صدوكم وقرا ابو عمرو وبن كثير بكسر الهمزة ان صدوكم وهو اختيار ابي عبيد وروي عن الاعمش ان يصدوكم قال بن عطية : فان للجزاء اي ان وقع مثل هذا الفعل في المستقبل والقراءة الاولي امكن في المعني وقال النحاس : واما ان صدوكم بكسر ان فالعلماء الجلة بالنحو والحديث والنظر يمنعون القراءة بها لاشياء : منها ان الاية نزلت عام الفتح سنة ثمان وكان المشركون صدوا المسلمين عام الحديبية سنة ست فالصد كان قبل الاية واذا قرء بالكسر لم يجز ان يكون الا بعده كما تقول : لا تعط فلانا شيءا ان قاتلك فهذا لا يكون الا للمستقبل وان فتحت كان للماضي فوجب علي هذا الا يجوز الا ان صدوكم وايضا فلو لم يصح هذا الحديث لكان الفتح واجبا لان قوله : لا تحلوا شعاءر الله الي اخر الاية يدل علي ان مكة كانت في ايديهم وانهم لا ينهون عن هذا الا وهم قادرون علي الصد عن البيت الحرام فوجب من هذا فتح ان لانه لما مضي ( ان تعتدوا ) في موضع نصب لانه مفعول به اي لا يجرمنكم شنان قوم الاعتداء وانكر ابو حاتم وابو عبيد شنان باسكان النون لان المصادر انما تاتي في مثل هذا متحركة وخالفهما غيرهما وقال : ليس هذا مصدرا ولكنه اسم الفاعل علي وزن كسلان وغضبان الثالثة عشرة قوله تعالي : ( وتعاونوا علي البر والتقوي ) قال الاخفش : هو مقطوع من اول الكلام وهو امر لجميع الخلق بالتعاون علي البر والتقوي اي ليعن بعضكم بعضا وتحاثوا علي ما امر الله تعالي واعملوا به وانتهوا عما نهي الله عنه وامتنعوا منه وهذا موافق لما روي عن النبي صلي الله عليه وسلم انه قال : ( الدال علي الخير كفاعله ( وقد قيل  الدال علي الشر كصانعه ثم قيل : البر والتقوي لفظان بمعني واحد وكرر باختلاف اللفظ تاكيدا ومبالغة اذ كل بر تقوي وكل تقوي بر قال بن عطية : وفي هذا تسامح ما والعرف في دلالة هذين اللفظين ان البر يتناول الواجب والمندوب اليه والتقوي رعاية الواجب فان جعل احدهما بدل الاخر فبتجوز وقال الماوردي : ندب الله سبحانه الي التعاون بالبر وقرنه بالتقوي له لان في التقوي رضا الله تعالي وفي البر رضا الناس ومن جمع بين رضا الله تعالي ورضا الناس فقد تمت سعادته وعمت نعمته وقال بن خويز منداد في احكامه : والتعاون علي البر والتقوي يكون بوجوه فواجب علي العالم ان يعين الناس بعلمه فيعلمهم ويعينهم الغني بماله والشجاع بشجاعته في سبيل الله وان يكون المسلمون متظاهرين كاليد الواحدة ( المءمنون تتكافء دماءهم ويسعي بذمتهم ادناهم وهم يد علي من سواهم ( ويجب الاعراض عن المتعدي وترك النصرة له ورده عما هو عليه ثم نهي فقال : ( ولا تعاونوا علي الاثم والعدوان ) وهو الحكم اللاحق عن الجراءم وعن العدوان وهو ظلم الناس ثم امر بالتقوي وتوعد توعدا مجملا فقال : واتقوا الله ان الله شديد العقاب < <
