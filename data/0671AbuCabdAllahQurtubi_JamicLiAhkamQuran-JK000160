 > قوله تعالي : ( او كظلمات في بحر لجي ) ضرب تعالي مثلا اخر للكفار اي اعمالهم كسراب بقيعة او كظلمات قال الزجاج : ان شءت مثل بالسراب وان شءت مثل بالظلمات فاو للاباحة حسبما تقدم من القول في او كصيب وقال الجرجاني : الاية الاولي في ذكر اعمال الكفار والثانية في ذكر كفرهم ونسق الكفر علي اعمالهم لان الكفر ايضا من اعمالهم وقد قال تعالي : يخرجهم من الظلمات الي النور اي من الكفر الي  الايمان وقال ابو علي : او كظلمات او كذي ظلمات ودل علي هذا المضاف قوله تعالي : اذا اخرج يده فالكناية تعود الي المضاف المحذوف قال القشيري : فعند الزجاج التمثيل وقع لاعمال الكفار وعند الجرجاني لكفر الكافر وعند ابي علي للكافر وقال بن عباس في رواية : هذا مثل قلب الكافر ( في بحر لجي ) قيل : هو منسوب الي اللجة وهو الذي لا يدرك قعره واللجة معظم الماء والجمع لجج والتج البحر اذا تلاطمت امواجه ومنه ما روي عن النبي صلي الله عليه وسلم انه قال : ( من ركب البحر اذا التج فقد برءت منه الذمة ( والتج الامر اذا عظم واختلط وقوله تعالي : حسبته لجة النمل اي ما له عمق ولججت السفينة اي خاضت اللجة [ بضم اللام ] فاما اللجة [ بفتح اللام ] فاصوات الناس يقول سمعت لجة الناس اي اصواتهم وصخبهم قال ابو النجم : في لجة امسك فلانا عن فل والتجت الاصوات اي اختلطت وعظمت ( يغشاه موج ) اي يعلو ذلك البحر اللجي موج ( من فوقه موج ) اي من فوق الموج موج ومن فوق هذا الموج الثاني سحاب فيجتمع خوف الموج وخوف الريح وخوف السحاب وقيل : المعني يغشاه موج من بعده موج فيكون المعني : الموج يتبع بعضه بعضا حتي كان بعضه فوق بعض وهو اخوف ما يكون اذا توالي موجه وتقارب ومن فوق هذا الموج سحاب وهو اعظم للخوف من وجهين : احدهما انه قد غطي النجوم التي يهتدي بها الثاني الريح التي تنشا مع السحاب والمطر الذي ينزل منه ( ظلمات بعضها فوق بعض ) قرا بن محيصن والبزي عن بن كثير سحاب ظلمات بالاضافة والخفض قنبل سحاب منونا ظلمات بالجر والتنوين الباقون بالرفع والتنوين قال المهدوي : من قرا من فوقه سحاب ظلمات بالاضافة فلان السحاب يرتفع وقت هذه الظلمات فاضيف اليها كما يقال : سحاب رحمة اذا ارتفع في وقت المطر ومن قرا سحاب ظلمات جر ظلمات علي التاكيد لظلمات  الاولي او البدل منها وسحاب ابتداء ومن فوقه الخبر ومن قرا سحاب ظلمات فظلمات خبر ابتداء محذوف التقدير : هي ظلمات او هذه ظلمات قال بن الانباري : من فوقه موج غير تام لان قوله من فوقه سحاب صلة للموج والوقف علي قوله من فوقه سحاب حسن ثم تبتدء ظلمات بعضها فوق بعض علي معني هي ظلمات بعضها فوق بعض وروي عن اهل مكة انهم قرءوا ظلمات علي معني او كظلمات ظلمات بعضها فوق بعض فعلي هذا المذهب لا يحسن الوقف علي السحاب ثم قيل : المراد بهذه الظلمات ظلمة السحاب وظلمة الموج وظلمة الليل وظلمة البحر فلا يبصر من كان في هذه الظلمات شيءا ولا كوكبا وقيل : المراد بالظلمات الشداءد اي شداءد بعضها فوق بعض وقيل : اراد بالظلمات اعمال الكافر وبالبحر اللجي قلبه وبالموج فوق الموج ما يغشي قلبه من الجهل والشك والحيرة وبالسحاب الرين والختم والطبع علي قلبه روي معناه عن بن عباس وغيره اي لا يبصر بقلبه نور الايمان كما ان صاحب الظلمات في البحر اذا اخرج يده لم يكد يراها وقال ابي بن كعب : الكافر يتقلب في خمس من الظلمات : كلامه ظلمة وعمله ظلمة ومدخله ظلمة ومخرجه ظلمة ومصيره يوم القيامة الي الظلمات في النار وبءس المصير ( اذا اخرج يده ) يعني الناظر ( لم يكد يراها ) اي من شدة الظلمات قال الزجاج وابو عبيدة : المعني لم يرها ولم يكد وهو معني قول الحسن ومعني لم يكد لم يطمع ان يراها وقال الفراء : كاد صلة اي لم يرها كما تقول : ما كدت اعرفه وقال المبرد : يعني لم يرها الا من بعد الجهد كما تقول : ما كدت اراك من الظلمة وقد راه بعد ياس وشدة وقيل : معناه قرب من الرءية ولم ير كما يقال : كاد العروس يكون اميرا وكاد النعام يطير وكاد المنتعل يكون راكبا النحاس : واصح الاقوال في هذا ان المعني لم يقارب رءيتها فاذا لم يقارب رءيتها فلم يرها رءية بعيدة ولا قريبة ( ومن لم يجعل الله له نور ) يهتدي به حين اظلمت عليه الامور وقال بن عباس : اي من لم يجعل الله له دينا فما له من دين ومن لم يجعل الله له نورا يمشي به يوم القيامة لم يهتد  الي الجنة كقوله تعالي : ويجعل لكم نورا تمشون به الحديد وقال الزجاج : ذلك في الدنيا والمعني : من لم يهده الله لم يهتد وقال مقاتل بن سليمان : نزلت في عتبة بن ربيعة كان يلتمس الدين في الجاهلية ولبس المسوح ثم كفر في الاسلام الماوردي : في شيبة بن ربيعة وكان يترهب في الجاهلية ويلبس الصوف ويطلب الدين فكفر في الاسلام قلت : وكلاهما مات كافرا فلا يبعد ان يكونا هما المراد بالاية وغيرهما وقد قيل : نزلت في عبد الله بن جحش وكان اسلم وهاجر الي ارض الحبشة ثم تنصر بعد اسلامه وذكر الثعلبي : وقال انس قال النبي صلي الله عليه وسلم : ( ان الله تعالي خلقني من نور وخلق ابا بكر من نوري وخلق عمر وعاءشة من نور ابي بكر وخلق المءمنين من امتي من نور عمر وخلق المءمنات من امتي من نور عاءشة فمن لم يحبني ويحب ابا بكر وعمر وعاءشة فماله من نور ( فنزلت ومن لم يجعل الله له نورا فماله من نور < <
