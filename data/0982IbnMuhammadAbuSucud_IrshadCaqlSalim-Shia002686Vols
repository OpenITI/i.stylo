يل المراد هو الصلاح للنكاح والقيام بحقوقه «ان يكونوا فقراء يغنهم الله من فضله» ازاحة لما عسي يكون وازعا من النكاح من فقر احد الجانبين اي لا يمنعن فقر الخاطب او المخطوبة من المناكحة فان في فضل الله عز وجل غنية عن المال فانه فقر احد غاد وراءح يرزق من يشاء من حيث لا يحتسب او وعد منه سبحانه بالاغناء لقوله صلي الله عليه وسلم اطلبوا الغني في هذه الاية لكنه مشروط بالمشيءة كما في قوله تعالي وان خفتم عيلة فسوف يغنيكم الله من فضله ان شاء الله «والله واسع» غني ذو سعة لا يرزءه اغناء الخلاءق اذا لا نفاد لنعمته ولا غاية لقدرته مع ذلك «عليم» يبسط 
 الرزق لمن يشاء ويقدر حسبما تقضيه الحكمة والمصلحة «وليستعفف» ارشاد للعاجزين عن مبادي النكاح واسبابها الي ما هو اولي لهم واحري بهم بعد بيان جواز منا كحة الفقراء اي ليجتهد في العفة وقمع شهوة «الذين لا يجدون نكاحا» اي اسباب نكاح اولا يتمكنون مما ينكح به من المال «حتي يغنيهم الله من فضله» عدة كريمة بالتفضل عليه بالغني ولطف لهم في استعفافهم وتقوية لقلوبهم وايذان بان فضله تعالي اولي بالاعفاء وادني من الصلحاء «والذين يبتغون الكتاب» بعد ما امر بانكاح صالحي المماليك الاحقاء بالانكاح امر بكتابة من ستحقها منهم والكتاب مصدر كاتب كالمكاتبة اي الذين يطلبون المكاتبة «من ما ملكت ايمانكم» عبدا كان او امة وهي ان يقول المولي لمملوكه كاتبتك علي كذا درهما تءديه الي وتعتق ويقول المملوك قبلته او نحو ذلك فان اداه اليه عتق قالوا معناه وكتبت لك علي نفسي ان تعتق مني اذا وفيت بالمال وكتبت لي علي نفسك ان تفي بذلك او كتبت عليك الوفاء بالمال وكتبت علي العتق عنده والتحقيق ان المكاتبة اسم للعقد الحاصل من مجموع كلاميهما كساءر العقود الشرعية المنعقدة بالايجاب والقبول ولا ريب في ان ذلك لا يصدر حقيقة الا من المتعاقدين وليس وظيفة كل منهما في الحقيقة الا الاتيان باحد شطريه معربا عما يتم من قبله ويصدر عنه من الفعل الخاص به من غير تعرض لما يتم من قبل صاحبه ويصدر عنه من فعله الخاص به الا ان كلا من ذينك الفعلين لما كان بحيث لا يمكن تحققه في نفسه الا منوطا بتحقق الاخر ضرورة ان التزام العتق بمقابلة البدل من جهة المولي لا يتصور تحققه الا بالتزام البدل من طرف العبد كما ان عقد البيع الذي هو تمليك المبيع بالثمن من جهة الباءع لا يمكن تحققه بتملكه به من جانب المشتري لم يكن بد من تضمين احدهما الاخر وقت الانشاء فكما ان قول الباءع بعت انشاء لعقد البيع علي معني انه ايقاع لما يتم من قبله اصالة ولما يتم من قبل المشتري ضمنا ايقاعا متوقفا علي رايه توقفا شبيها بتوقف عقد الفضولي كذلك قول المولي كاتبتك علي كذا انشاء لعقد الكتابة اي ايقاع لما يتم من قبله من التزام العتق بمقابلة البدل اصالة ولما يتم من قبل العبد من التزام البدل ضمنا ايقاعا متوقفا علي قبوله فاذا قبل تم العقد ومحل الموصول الرفع علي الابتداء خبره «فكاتبوهم» والفاء لتضمنه معني الشرط او النصب علي انه مفعول لمضمر يفسره هذا والامر فيه للندب لان الكتابة عقد يتضمن الارفاق فلا تجب كغيرها ويجوز حالا ومءجلا ومنجما وغير منجم وعند الشافعي رحمه الله لا يجوز الا مءجلا منهما وقد فصل في موضعه «ان علمتم فيهم خيرا» اي امانة ورشدا وقدرة علي اداء البدل بتحصيله من وجه حلال وصلاحها لا يءذي الناس بعد العتق واطلاق العنان «واتوهم من مال الله الذي اتاكم» امر للوالي ببذل شء من اموالهم وفي حكمه حط شء 
 من مال الكتابة ويكفي في ذلك اقل ما يتمول وعن علي رضي الله عنه حط الربع وعن ابن عباس رضي الله عنهما الثلث وهو للندب عندنا وعند الشافعي للوجوب ويرده قوله صلي الله عليه وسلم المكاتب عبد ما بقي عليه درهم اذا لو وجب الحط لسقط عنه الباقي حتما وايضا لو وجب الحط لكان وجوبه معلقا بالعقد فيكون العقد موجبا ومسقطا معا وايضا فهو عقد معاوضة فلا يجبر علي الحطيطة كالبيع وقيل معني اتوهم اقرضوهم وقيل هو امر لهم بان ينفقوا عليهم بعد ان يءدوا ويعتقوا واضافة المال اليه تعالي ووصفه بايناءه اياهم للحث علي الامتثال بالامر بتحقيق المامور به كما في قوله تعالي وانفقوا مما جعلكم مستخلفين فيه فان ملاحظة وصول المال اليهم من جهته تعالي مع كونه هو المالك الحقيقي له من اقوي الدواعي الي صرفه الي الجهة المامور بها وقيل هو امر باعطاء سهمهم من الصدقات فالامر للوجوب حتما والاضافة والوصف لتعيين الماخذ وقيل هو امر ندب لعامة المسلمين باعانة المكاتبين بالتصدق عليهم ويحل ذلك للمولي وان كان غنيا لتبدل العنوان حسبما ينطق به قوله صلي الله عليه وسلم في حديث بريرة هو لها صدقة ولنا هدية «ولا تكرهوا فتياتكم» اي اماءكم فان كلا من الفتي والفتاة كناية مشهورة عن العبد والامة وعلي ذلك مبني قوله صلي الله عليه وسلم ليقل احدكم فتاي وفتاتي ولا يقل عبدي وامتي لهذه العبارة في هذا المقام باعتبار مفهومها الاصلي حسن موقع ومزيد مناسبة لقوله تعالي «علي البغاء» وهو الزنا من حيث صدوره عن النساء لانهن اللاتي يتوقع منهن ذلك غالبا دون من عداهن من العجاءز والصغاءر وقوله تعالي «ان اردن تحصنا» ليس لتخصيص النهي بصورة ارادتهن التعفف عن الزنا واخراج ما عداها من حكمه كما اذا كان الاكراه بسبب كراهتهن الزنا لخصوص الزاني او لخصوص الزمان او لخصوص المكان او لغير ذلك من الامور المصححة للاكراه في الجملة بل للمحافظة علي عادتهم المستمرة حيث كانوا يكرهونهن علي البغاء وهن يردن التعفف عنه مع وفور شهوتهن الامرة بالفجور وقصورهن في معرفة الامور الداعية الي المحاسن الزاجرة عن تعاطي القباءح فان عبد الله بن ابي كانت له ست جوار يكرهن علي الزنا وضرب عليهن ضراءب فشكت اثنتان منهن الي رسول الله صلي الله عليه وسلم فنزلت وفيه من زيادة تقبيح حالهم وتشنيعهم علي ما كانوا عليه من القباءح ما لا يخفي فان من له ادني مروءة لا يكاد يرضي بفجور من يحويه حرمه من اماءه فضلا عن امرهن به او اكراهن عليه لا سيما ارادتهن التعفف فتامل ودع عنك ما قيل من ان ذلك لان الاكراه لا يتاتي الا مع ارادة التحصن وما قيل من انه ان جعل شرطا للنهي لا يلزم من عدمه جواز الاكراه لجواز ان يكون ارتفاع النهي لامتناع المنهي عنه فانهما بمعزل من التحقيق وايثار كلمة ان علي اذا مع تحقق الارادة في مورد النص حتما للايذان بوجوب الانتهاء عن الاكراه عند كون ارادة التحصن في حيز التردد والشك فكيف اذا كانت محققة الوقوع كما هو الواقع وتعليله بان الارادة المذكورة منهن في حيز الشاذ النادر مع خلوه عن الجدوي بالكلية ياباه اعتبار تحققها اباء ظاهرا تعالي «لتبتغوا عرض الحياة الدنيا» قيد للاكراه لكن لا باعتبار انه مدار النهي عنه باعتبار انه المعتاد فيما بينهم كما قبله لهم فيما هم عليه من احتمال الوزر الكبير لاجل النزر الحقير اي لا تفعلوا ما انتم عليه من اكراههن علي البغاء لطلب المتاع السريع الزوال الوشيك الاضمحلال فالمراد بالابتغاء الطلب المقارن لنيل المطلوب واستيفاءه بالفعل اذ 
 هو الصالح لكونه غاية للاكراه مترتبا عليه لا المطلق المتناول للطلب السابق الباعث عليه «ومن يكرههن» الخ جملة مستانفة سيقت لتقرير النهي وتاكيد وجوب العمل به ببيان خلاص المكروهات عن عقوبة المكره عليه عبارة ورجوع غاءلة الاكراه الي المكرهين اشارة اي ومن يكرهن علي ما ذكر من البغاء «فان الله من بعد اكراههن غفور رحيم» اي لهن كما وقع في مصحف ابن مسعود عليه قراءة ابن عباس رضي الله تعالي عنهم وكما ينبء عنه قوله تعالي من بعد اكراههن اي كونهن مكرهات علي ان الاكراه مصدر من المبني للمفعول فان توسيطه بين اسم ان وخبرها للايذان بان ذلك هو السبب للمغفرة والرحمة وكان الحسن البصري رحمه الله اذا قرا هذه الاية يقول لهن والله لهن والله في تخصيصها بهن وتعيين مدارهما مع سبق ذكر المكرهين ايضا في الشرطية دلالة بينة علي كونهم محرومين منهما بالكلية كانه قيل لا للمكروه ولظهوره هذا التقدير اكتفي به عن العاءد الي اسم الشرط فتجويز تعلقها بهم بشرط التوبة استقلالا او معهن اخلال بجزالة النظم الجليل وتهوين لامر النهي في مقام التهويل وحاجتهن الي المغفرة المتنبءة عن سابقة الاثم اما باعتبار انهن وان كن مكروهات لا يخلون في تضاعيف الزنا عن شاءبة مطاوعة ما بحكم الجبلة البشرية واما باعتبار ان الاكراه قد يكون قاصرا عن حد الالجاء المزيل للاختيار بالمرة واما لغاية تهويل امر الزنا وحث المكرهات علي التثبت في التجافي عنه والتشديد في تحذير المكرهين ببيان انهن حيث كن عرضة للعقوبة لولا ان تداركهن المغفرة والرحمة مع قيام العذر في حقهن فما حال من يكرهن في استحقاق العذاب «ولقد انزلنا اليكم ايات مبينات» كلام مستانف جء به في تضاعيف ما ورد من الايات السابقة واللاحقة لبيان جلالة شءونها المستوجبة للاقبال الكلي علي العمل بمضمونها وصدر بالقسم الذي تعرب عنه اللام لابراز كمال العناية بشانه اي وبالله لقد انزلنا اليكم هذه السورة الكريمة ايات مبينات لكل ما بكم حاجة الي بيانه من الحدود وساءر الاحكام والاداب وغير ذلك مما هو من مبادء بيانها علي ان اسناد التبيين اليها مجازي او ايات واضحات تصدقها الكتب القديمة والعقول السليمة علي ان مبينات من بين بمعني تبين ومنه المثل قد بين الصبح لذي عينين وقرء علي صيغة التي بينت واوضحت في هذه السورة من معاني الاحكام والحدود وقد جوز ان يكون الاصل مبينا فيها الاحكام فانسع في الظرف باجراءه مجري المفعول «ومثلا من الذين خلوا من قبلكم» عطف علي ايات اي وانزلنا مثلا كاءنا من قبيل امثال الذين مضوا من قبلكم من القصص العجيبة والامثال المضروبة لهم في الكتب السابقة والكلمات الجارية علي السنة الانبياء عليهم السلام فينتظم قصة عاءشة رضي الله عنها المحاكية لقصة يوسف عليه السلام وقصة مريم رضي الله عنها وساءر الامثال الواردة في السورة الكريمة انتظاما واضحا وتخصيص الايات المبينات بالسوابق وحمل المثل علي القصة العجيبة فقط ياباه تعقيب الكلام بما سياتي من التمثيلات «وموعظة» تتعظون به وتنزجرون عما لا ينبغي من المحرمات والمكروهات وساءر ما يخل بمحاسن الاداب فهي عبارة عما سبق من الايات والمثل لظهور كونها من المواعظ بالمعني المذكور 
 ومدار العطف هو التغاير العنواني المنزل منزلة التغاير الذاتي وقد خصت الايات بما يبين الحدود والاحكام والموعظة بما وعظ به من قوله تعالي ولا تاخذكم بهما رافة في دين الله وقوله تعالي لولا اذ سمعتموه وغير ذلك من الايات الواردة في شان الاداب وانما قيل «للمتقين» مع شمول الموعظة للكل حسب شمول الانزال لقوله تعالي انزلنا اليكم حثا للخاطبين علي الاعتناء بالانتظام في سلك المتقين ببيان انهم المغتنمون لاثارها المقتبسون من انوارها فحسب وقيل المراد بالايات المبينات والمثل والموعظة جميع ما في القران المجيد من الايات والامثال والمواعظ فقوله تعالي «الله نور السماوات والارض» الخ حينءذ استءناف مسوق لتقرير ما فيها من البيان مع الاشعار بكونه في غاية الكمال علي الوجه الذي ستعرفه واما علي الاول فلتحقيق ان بيانه تعالي ليس مقصورا علي ما ورد في السورة الكريمة بل هو شامل لكل ما يحق بيانه من الاحكام والشراءع ومباديها وغاياتها المترتبة عليها في الدنيا والاخرة وغير ذلك مما له مدخل في البيان وانه واقع منه تعالي علي اتم الوجوه واكملها حيث عبر عنه بالتنوير الذي هو اقوي مراتب البيان واجلاها وعبر عن المنور بنفس النور تنبيها علي قوة التنوير وشدة التاثير وايذانا بانه تعالي ظاهر بذاته وكل ما سواه ظاهر باظهاره كما ان النور نير بذاته وما عداه مستنير به واضيف النور الي السماوات والارض للدلالة علي كمال شيوع البيان المستعار له وغاية شموله لكل ما يليق به من الامور التي لها مدخل في ارشاد الناس بوساطة بيان شمول المستعار منه لجميع ما يقبله ويستحقه من الاجرام العلوية والسفلية فانهما قطران للعالم الجسماني الذي لا مظهر للنور الحسي سواه او علي شمول البيان لاحوالهما واحوال ما فيهما من الموجودات اذ ما من موجود الا وقد بين من احواله ما يستحق البيان اما تفصيلا او اجمالا كيف لا ولا ريب في بيان كونه دليلا علي وجود الصانع وصفاته وشاهدا بصحة البعث او علي تعلق البيان باهلهما كما قال ابن عباس رضي الله عنهما هادي اهل السماوات والارض فهم بنوره يهتدون وبهداه من حيرة الضلالة ينجون هذا واما حمل التنوير علي اخراجه تعالي للماهيات من العدم الي الوجود اذ هو الاصل في الاظهار كما ان الاعدام هو الاصل في الاخفاء او علي تزيين السماوات بالنيرين وساءر الكواكب وما يفيض منها من الانوار او بالملاءكة عليهم السلام وتزيين الارض بالانبياء عليهم السلام والعلماء والمءمنين او بالنبات والاشجار او علي تدبيره تعالي لامورهما وامور ما فيهما فمما لا يلاءم المقام ولا يساعد حسن النظام «مثل نوره» اي نوره الفاءض منه تعالي علي الاشياء المستنيرة به وهو القران المبين كما يعرب عنه ما قبله من وصف اياته بالانزال والتبيين وقد صرح بكونه نورا ايضا في قوله تعالي وانزلنا اليكم نورا مبينا وبه قال ابن عباس رضي الله عنهما والحسن وزيد 
 ابن اسلم رحمهم الله تعالي وجعله عبارة عن الحق وان شاع استعارته له كاستعارة الظلمة للباطل ياباه مقام بيان شان الايات ووصفها بما ذكر من التبيين مع عدم سبق ذكر الحق ولان المعتبر في مفهوم النور هو الظهور والاظهار كما هو شان القران الكريم واما الحق فالمعتبر في مفهومه من حيث هو حق هو الظهور لا الاظهار والمراد بالمثل الصفة العجيبة اي صفة نوره العجيبة «كمشكاة» اي كصفة كوة نافذة في الجدار في الانارة والتنوير «فيها مصباح» سراج ضخم ثاقب وقيل المشكاة الانبوبة في وسط القنديل والمصباح الفتيلة المشتعلة «المصباح في زجاجة» اي قنديل من الزجاج الصافي الازهر وقرء بفتح الزاي وكسرها في الموضعين «الزجاجة كانها كوكب دري» متلالء وقاد شبيه بالدر في صفاءه وزهرته ودراري الكواكب عظامها المشهورة وقرء درء بدال مكسورة وراء مشددة وياء ممدودة بعدها همزة علي انه فعيل من الدرء وهو الدفع اي مبالغ في دفع الظلام بضوءه او في دفع بعض اجزاء ضياءه لبعض عند البريق واللمعان وقرء بضم الدال والباقي علي حاله وفي اعادة المصباح والزجاجة معرفين اثر سبقهما منكرين والاخبار عنهما بما بعدهما مع انتظام الكلام بان يقال كمشكاة فيها مصباح في زجاجة كانها كوكب دري من تفخيم شانهما ورفع مكانهما بالتفسير اثر الابهام والتفصيل بعد الاجمال وباثبات ما بعدهما لهما بطريق الاخبار المنبء عن القصد الاصلي دون الوصف المبني علي الاشارة الي الثبوت في الجملة ما لا يخفي ومحل الجملة الاولي الرفع علي انها صفة لمصباح ومحل الثانية الجر علي انها صفة لزجاجة واللام مغنية عن الرابط كانه قيل فيها لمصباح الجر علي انها صفة لزجاجة واللام مغنية عن الرابط كانه قيل فيها مصباح هو في زجاجة هي كانها كوكب دري «يوقد من شجرة» اي يبتدا ايقاد المصباح من شجرة «مباركة» اي كثيرة المنافع بان رويت ذبالته بزيتها وقيل انما وصفت بالبركة لانها تنبت في الارض التي بارك الله تعالي فيها للعالمين «زيتونة» بدل من شجرة وفي ابهامها ووصفها بالبركة ثم الابدال منها تفخيم لشانها وقرء توقد بالناء علي ان الضمير القاءم مقام الفاعل للزجاجة دون المصباح وقرء توقد علي صيغة الماضي من التفعل اي ابتداء ثقوب المصباح منها وقرء توقد بحذف احدي التاءين من تتوقد علي اسناده الي الزجاجة «لا شرقية ولا غربية» تقع الشمس عليها حينا دون حين بل بحيث تقع عليها طول النهار كالتي علي قلة او صحراء واسعة فتقع الشمس عليها حالتي الطلوع والغروب وهذا قول ابن عباس رضي الله عنهما وسعيد بن جبير وقتادة وقال الفراء والزجاج لا شرقية وحدها ولا غربية وحدها لكنها شرقية وغربية اي تصيبها الشمس عند طلوعها وعند غروبها فتكون شرقية وغربية تاخذ حظها من الامرين فيكون زيتها اضوا وقيل لا ثابتة في شرق المعمورة ولا في غربها بل في وسطها وهو الشام فان زيوتها اجود ما يكون وقيل لا في مضحي تشرق الشمس عليها داءما فتحرقها ولا في مقناة نغيب عنها داءما فتتركها نيا وفي الحديث لا خير في شجرة ولا في نبات في مقناة ولا خير فيهما في مضحي «يكاد زيتها يضء ولو لم تمسسه نار» اي هو في الصفاء والانارة بحيث يكاد يضء بنفسه من غير مساس نار اصلا وكلمة في امثال هذه المواقع ليست لبيان انتفاء شء في الزمان الماضي لانتفاء غيره فيه فلا يلاحظ لها جواب قد حذف ثقة بدلالة ما قبلها عليه ملاحظة قصدية الا عند القصد الي بيان الاعراب علي القواعد الصناعية بل هي لبيان تحقق ما يفيده الكلام السابق من الحكم الموجب او المنفي كلما 
 كل حال مفروض من الاحوال المقارنة له اجمالا بادخالها علي ابعدها منه اما لوجود المانع كما في قوله تعالي اينما تكونوا يدرككم الموت ولو كنتم في بروج مشيدة واما لعدم الشرط كما في هذه الاية الكريمة ليظهر بثبوته او انتفاءه معه ثبوته او انتفاءه مع عداه من الاحوال بطريق الاولوية لما ان الشء متي تحقق مع ما ينافيه من وجود المانع او عدم الشرط فلان يتحقق بدون ذلك اولي ولذلك لا يذكر معه شء اخر من ساءر الاحوال ويكتفي عنه بذكر الواو العاطفة للجملة عل نظيرتها المقابلة لها المتناولة لجميع الاحوال المغايرة لها عند تعددها وهذا معني قولهم انها لاستقصاء الاحوال علي سبيل الاجمال وهذا امر مطرد في الخبر الموجب والمنفي فانك اذا قلت فلان جواد يعطي ولو كان فقيرا او بخيل لا يعطي ولو كان غنيا تريد بيان تحقق الاعطاء في الاول وعدم تحققه في الثاني في جميع الاحوال المفروضة والتقدير يعطي لو لم يكن فقيرا ولو كان فقيرا ولا يعطي لو لم يكن غنيا ولو كان غنيا فالجملة مع ما عطفت هي عليه في حيز النصب علي الحالية من المستكن في الفعل الموجب او المنفي اي يعطي اولا يعطي كاءنا علي جميع الاحوال وتقدير الاية الكريمة يكاد زيتها يضء لو مسته نار ولو لم تمسه نار اي يضء كاءنا علي كل حال من وجود الشرط وعدمه وقد حذفت الجملة الاولي حسبما هو المطرد في الباب لدلالة الثانية عليها دلالة واضحة «نور» خبر مبتدا محذوف وقوله تعالي «علي نور» متعلق بمحذوف هو صفة له مءكدة لما افاده التنكير من الفخامة والجملة فذلكة للتمثيل وتصريح بما حصل منه وتمهيد لما يعقبه اي ذلك النور الذي عبر به عن القران ومثلت صفته العجيبة الشان بما فصل من صفة المشكاة نور عظيم كاءن علي نور كذلك لا علي انه عبارة عن نور واجد معين او غير معين فوق نور اخر مثله ولا عن مجموع نورين اثنين فقط بل عن نور متضاعف من غير تحديد لتضاعفه بحد معين وتحديد مراتب تضاعف ما مثل به من نور المشكاة بما ذكر لكونه اقصي مراتب تضاعفه عادة فان المصباح اذا كان في مكان متضايق كالمشكاة كان اضوا له واجمع لنوره بسبب انضمام الشعاع المنعكس منه الي اصل الشعاع بخلاف المكان المتسع فان الضوء ينبث فيه وينتشر والقنديل اعون شء علي الزيادة الانارة وكذلك الزي وصفاءه وليس وراء هذه المراتب مما يزيد نورها اشراقا ويمده باضاءة مرتبة اخري عادة هذا وجعل النور عبارة عن النور المشبه به مما لا يليق بشان التنزيل الجليل «يهدي الله لنوره» اي يهدي هداية خاصة موصلة الي المطلوب حتما لذلك النور المتضاعف العظيم الشان واظهاره في مقام الاضمار لزيادة تقريره وتاكيد فخامته الذاتية بفخامته الاضافية الناشءة من اضافته الي ضميره عز وجل «من يشاء» هدايته من عباده بان يوفقهم لفهم ما فيه من دلاءل حقيته وكونه من عند الله تعالي من الاعجاز والاخبار عن الغيب وغير ذلك من موجبات الايمان به وفيه ايذان بان ماط هذه الهداية وملاكها ليس الا مشيءته تعالي وان تظاهر الاسباب بدونها بمعزل من الافضاء الي المطالب «ويضرب الله الامثال للناس» في تضاعيف الهداية حسبما يقتضي حالهم فان له دخلا عظيما في باب الارشاد لانه ابرار للمعقول في هيءة المحسوس وتصوير لاوابد المعاني بصورة المانوس ولذلك مثل نوره المعبد به عن القران المبين بنور المشكاة واظهاره الاسم الجليل في مقام الاضمار للايذان 
 باختلاف حال ما اسند اليه تعالي من الهداية الخاصة وضرب الامثال الذي هو من قبيل الهداية العامة كما يفصح عنه تعليق الاولي بمن يشاء والثانية بالناس كافة «والله بكل شء عليم» مفعولا كان او محسوسا ظاهرا كان او باطنا ومن قضيته ان تتعلق مشيءته بهداية من يليق بها ويستحقها من الناس دون من عداهم لمخالفته الحكمة التي عليها مبني التكوين والتشريع وان تكون هدايته العامة علي فنون مختلفة وطراءق شتي حسبما تقتضيه احوالهم والجملة اعتراض تذييلي مقرر لما قبله واظهار الاسم الجليل لتاكيد استقلال الجملة والاشعار بعلة الحكم وبما ذكر من اختلاف حال المحكوم به ذاتا وتعلقا «في بيوت اذن الله ان ترفع ويذكر فيها اسمه» لما ذكر شان القران الكريم في بيانه للشراءع والاحكام ومباديها وغاياتها المترتبة عليها من الثواب والعقاب وغير ذلك من احوال الاخرة واهوالها واشير الي كونه في غاية ما يكون من التوضيح والاظهار حيث مثل بما فصل من نور المشكاة واشير الي ان ذلك النور مع كونه في اقصي مراتب الظهور انما يهتدي بهداه من تعلقت مشيءة الله تعالي بهدايته دون من عداه عقب ذلك بذكر الفريقين وتصوير بعض اعمالهم المعربة عن كيفية حالهم في الاهتداء وعدمه والمراد بالبيوت المساجد كلها حسبما روي عن ابن عباس رضي الله عنهما وقيل هي المساجد التي بناها نبي من انبياء الله تعالي الكعبة التي بناها ابراهيم واسماعيل عليهما السلام وبيت المقدس الذي بناه داود وسليمان عليهما السلام ومسجد المدينة ومسجد قباء اللذان بناهما رسول الله صلي الله عليه وسلم وتنكيرها للتفخيم والمراد بالاذن في رفعها الامر ببناءها رفيعة لا كساءر البيوت وقيل هو الامر برفع مقدارها بعبادة الله تعالي فيها فيكون عطف الذكر عليه من قبيل العطف التفسيري واياما كان ففي التعبير عنه بالاذن تلويح بان اللاءق بحال المامور ان يكون متوجها الي المامور به قبل ورود الامر به ناويا لتحقيقه كانه مستاذن كانه مستاذن في ذلك فيقع الامر به موقع الاذن فيه والمراد بذكر اسمه تعالي ما يعم جميع اذكاره تعالي وكلمة في متعلقة بقوله تعالي «يسبح له» وقوله تعالي «فيها» تكرير لها للتاكيد والتذكير لما بينهما من الفاصلة وللايذان بان التقديم للاهتمام لا لقصر التسبيح علي الوقوع في البيوت فقط واصل التسبيح التنزيه والتقديس يستعمل باللام وبدونها ايضا كما في قوله تعالي «سبح اسم ربك الاعلي» به الصلوات المفروضة كما ينبء عنه تعيين الاوقات بقوله تعالي «بالغدو والاصال» اي بالغدوات والعشايا علي ان الغدو اما جمع غداة كقني في جمع قناة كما قيل او مصدر اطلق علي الوقت حسبما يشعر به اقترانه بالاصال وهو هو جمع اصيل وهو العشي والعشي وهو الشامل الاوقات ما عدا صلاة الفجر المءداة بالغداة ويجوز ان يراد به نفس التنزيه علي انه عبارة عما يقع منه في اثناء الصلوات واوقاتها لزيادة شرفه وانافته علي ساءر افراده او عما يقع في جميع الاوقات وافراد طرفي النهار بالذكر لقيامهما مقام كلها لكونهما العمدة فيها بكونهما مشهودين وكونهما اشهر ما يقع فيه المباشرة للاعمال والاشتغال بالاشغال وقرء والايصال وهو الدخول في الاصيل وقوله تعالي 
 «رجال» فاعل يسبح وتاخيره عن الظروف لما مر مرارا من الاعتناء بالمقدم والتشويق الي المءخر ولان في وصفه نوع طول فيخل تقديمه بحسن الانتظام وقرء يسبح علي البناء للمفعول باسناده الي احد الظروف ورحال مرفوع بما ينبء عنه حكاية الفعل من غير تسمية الفاعل علي طريقة قوله لبيك يزيد ضارع لخصومة كانه قيل من يسبح له فقيل يسبح له رجال وقرء تسبح بتانيث الفعل مبنيا للفاعل لان جمع التكسير قد يعامل معاملة المءنث ومبنيا للمفعول علي ان يسند الي اوقات الغدو والاصال بزيادة الباء وتجعل الاوقات مسبحة مع كونها مسبحا فيها او يسند الي ضمير التسبيحة اي تسبيح له التسبيحة علي المجاز المسوغ لاسناده الي الوقتين كما خرجوا قراءة ابي جعفر ليجزي قوما اي ليجزي الجزاء قوما بل هذا اولي من ذل هنا مفعول صريح «لا تلهيهم تجارة» صفة لرجال مءكدة لما افاده التنكير من الفخامة مفيدة لكمال تبتلهم الي الله تعالي واستغراقهم فيها حكي عنهم من التسبيح من غير صارف يلويهم ولا عاطف يثنيهم كاءنا ما كان وتخصيص التجارة بالذكر لكونهما اقوي الصوارف عندهم واشهرها اي لا يشغلهم نوع من انواع التجارة «ولا بيع» اي ولا فرد من افراد البياعات وان كان في غاية الربح وافراده بالذكر مع اندراجه تحت التجارة للايذان بانافته علي ساءر انواعها لان ربحه متيقن ناجز وربح ما عداه متوقع في الثاني الحال عند البيع فلم يلزم من نفي الهاء ما عداه نفي الهاءه ولذلك كررت كلمة لا لتذكير النفي وتاكيده وقد نقل عن الواقدي ان المراد بالتجارة هو الشراء لانه اصلها ومبدءها وقيل هو الجلب لانه الغالب فيها ومنه يقال تجر في كذا اي جلبه «عن ذكر الله» بالتسبيح والتحميد «واقام الصلاة» اي اقامتها لمواقيتها من غير تاخير وقد اسقطت التاء المعوض عن العين الساقطة بالاعلال وعوض عنها الاضافة كما في قوله [واخلفوك عد الامر الذي وعدوا] اي عدة الامر «وايتاء الزكاة» اي المال الذي فرض اخراجه للمستحقين وايراده ههنا وان لم يكن مما يفعل في البيوت لكونه قرينة لا تفارق اقامة الصلاة في عامة المواضع مع ما فيه من التنبيه علي ان محاسن اعمالهم غير منحصرة فيما يقع في المساجد وكذلك قوله تعالي «يخافون» الخ فانه صفة ثانية لرجال او حال من مفعول لا تلهيهم وايا ما كان فليس خوفهم مقصورا علي كونهم في المساجد وقوله تعالي «يوما» مفعول ليخافون لا ظرف له وقوله تعالي «تتقلب فيه القلوب والابصار» صفة ليوما اي تضطرب وتتغير في انفسها من الهول والفزع وتشخص كما في قوله تعالي واذ زاغت والابصار وبلغت القلوب الحناجر او تتغير احوالها وتتقلب فتتفقه القلوب بعد ان كانت مطبوعا عليها وتبصر الابصار بعد ان كانت عمياء او تتقلب القلوب بين توقع النجارة وخوف الهلاك والابصار من اي ناحية يءخذ بهم ويءتي كتابهم «ليجزيهم الله» متعلق بمحذوف يدل عليه ما حكي من اعمالهم المرضية اي 
 يفعلون ما يفعلون من المداومة علي التسبيح والذكر وايتاء الزكاة والخوف من غير صارف لهم عن ذلك ليجزيهم الله تعالي «احسن ما عملوا» اي احسن جزاء اعمالهم حسبما وعد لهم بمقابلة حسنة واحدة عشرة امثالها الي سبعماءة ضعف «ويزيدهم من فضله» اي يتفضل عليهم باشياء لم توعد لهم بخصوصياتها او بمقاديرها ولم تخطر ببالهم كيفياتها ولا كمياتها بل انما وعدت بطريق الاجمال في مثل قوله تعالي للذين احسنوا الحسني وزيادة وقوله صلي الله عليه وسلم حكاية عنه عز وجل اعددت لعبادي الصالحين مالا عين رات ولا اذن سمعت ولا خطر علي قلب بشر وغير ذلك من المواعيد الكريمة التي من جملتها قوله تعالي «والله يرزق من يشاء بغير حساب» فانه تذييل مقرر للزيادة وعد كريم بانه تعالي يعطيهم غير اجزية اعمالهم من الخيرات ما لا يفي به الحساب واما عدم سبق الوعد بالزيادة ولو اجمالا وعدم خطورها ببالهم ولو بوجه ما فياباه نظمها في سلك الغاية والموصول عبارة عمن ذكرت صفاتهم الجميلة كانه قيل والله يرزقهم بغير حساب ووضعه موضع ضميرهم للتنبيه بما في حيز الصلة علي ان مناط الرزق المذكور في محض مشيءته تعالي لا اعمالهم المحكية كما انها المناط لما سبق من الهداية لنوره تعالي لا لظاهر الاسباب وللايذان بانهم ممن شاء الله تعالي لان يرزقهم كما انهم ممن شاء الله تعالي ان يهديهم لنوره حسبما يعرب عنه ما فصل من اعمالهم الحسنة فان جميع مل ذكر من الذكر والتسبيح واقام الصلاة وايتاء الزكاة وخوف اليوم الاخر واهواله ورجاء الثواب مقتبس من القران الكريم العظيم الذي هو المعني بالنور وبه يتم بيان احوال من اهتدي بهداه علي اوضح وجه واجلاه وهذا وقد قيل قوله تعالي في بيوت الخ من تتمة التمثيل وكلمة في متعلقة بمحذوف هي صفة لمشكاة اي كاءنة في بيوت وقيل لمصباح وقيل لزجاجة وقيل متعلقة بيوقد والكل مما لا يليق بشان التنزيل الجليل كيف لا وان ما بعد قوله تعالي ولو لم تمسسه نار علي ما هو الحق او ما بعد قوله تعالي نور علي نور علي ما قيل الي قوله تعالي بكل شء عليم كلام متعلق بالممثل قطعا فتوسيطه بين اجزاء التمثيل مع كونه من قبيل الفصل بين الشجر ولحاءه بالاجنبي يءدي الي كون ذكر حال المنتفعين بالتمثيل المهديين لنور القران الكريم بطريق الاستتباع والاستطراد مع كون بيان حال اضدادهم مقصودا بالذات ومثل هذا مما لا عهد به في كلام الناس فضلا ان يحمل عليه الكلام المعجز «والذين كفروا» عطف علي ما ينساق اليه ما قبله كانه قيل الذين امنوا اعمالهم حالا وما لا كما وصف والذين كفروا «اعمالهم» اي اعمالهم التي هي من ابواب البر كصلة الارحام وفك العناة وسقاية الحاج وعمارة البيت واغاثة الملهوفين وقري الاضياف ونحو ذلك مما لو قارنه الايمان لاستتبع الثواب كما في قوله تعالي مثل الذين كفروا بربهم اعمالهم كرماد الاية «كسراب» وهو ما يري في الفلوات من لمعان الشمس عليها وقت الظهيرة فيظن انه ماء يسرب اي يجري «بقيعة» متعلق بمحذوف هو صفة لسراب اي كاءن في قاع وهي الارض المنبسطة 
 المستوية وقيل هي جمع قاع كجيرة جمع جار وقرء بقيعات بتاء ممدودة كديمات اما علي انها جمع قيعة او علي ان الاصل قيعة قد اشبعت فتحة العين فتولد منها الف «يحسبه الظمان ماء» صفة اخري لسراب وتخصيص الحسبان بالظمان مع شموله لكل من يراه كاءنا من كان من العطشان والريان لتكميل التشبيه بتحقيق شركة طرفيه في وجه الشبه الذي هو المطلع المطمع والمقطع الموءس «حتي اذا جاءه» اي اذا جاء العطشان ما حسبه ماء وقيل موضعه «لم يجده» اي ما حسبه ماء وعلق به رجاءه «شيءا» اصلالا محققا ولا متوهما كما كان يراه من قبل فضلا عن وجدانه ماء وبه تم بيان احوال الكفرة بطريق التمثيل وقوله تعالي «ووجد الله عنده فوفاه حسابه والله سريع الحساب» بيان لبقية احوالهم العارضة لهم بعد ذلك بطريق التكملة لءلا يتوهم ان قصاري امرهم هو الخيبة والقنوط فقط كما هو شان الظمان ويظهر انه يعتريهم بعد ذلك التمثيل من عدم وجدان الكفرة من اعمالهم المذكورة عينا ولا اثرا كما في قوله تعالي وقدمنا الي ما عملوا من عمل فجعلناه هباء منثورا كيف لا وان الحكم بان اعمال الكفرة كسراب يحسبه الظمان ماء حتي اذا جاءه لم يجده سيءا حكم بانها بحيث يحسبونها في الدنيا نافعة لهم في الاخرة حتي اذا جاءوها لم يجدوها شيءا كانه قيل حتي اذا جاء الكفرة يوم القيامة اعمالهم التي كانوا في الدنيا يحسبونها نافعة لهم في الاخرة يجدوها شيءا ووجدوا الله اي حكمه وقضاءه عند المجء وقيل عند العمل فوفاهم اي اعطاهم وافيا كاملا حسابهم اي حساب اعمالهم المذكورة وجزاءها فان اعتقادهم لنفعها بغير ايمان وعملهم بموجبه كفر علي كفره وجب للعقاب قطا وافراد الضميرين الراجعين الي الذين كفروا اما لارادة الجنس كالضمان الواقع في التمثيل واما للحمل علي كل واحد منهم وكذا افراد ما يرجع الي اعمالهم هذا وقد قيل نزل في عتبة بن ربيعة بن امية كان قد تعبد في الجاهلية وليس المسوح والتمس الدين فلما جاء الاسلام كفر «او كظلمات» عطف علي كسراب وكلمة للتنويع  اثر ما مثلت اعمالهم التي كانوا يعتمدون عليها اقوي اعتماد ويفتخرون بها في كل واد وناد بما ذكر من حال السراب مع زيادة حساب وعقاب مثلت اعمالهم القبيحة التي ليس فيها شاءبة خيرية يغتر بها المغترون بظلمات كاءنة «في بحر لجي» اي عميق كثير الماء منسوب الي اللج وهو معظم ماء البحر وقيل الي اللجة وهي ايضا معظمه «يغشاه» صفة اخري للبحر اي يستره ويغطيه بالكلية «موج» وق