 وهذا اخر ما وقع عليه الاختيار من شعره، واما نثره فهو اقل بضاعته، واسهل صناعته، ومنه:
   ما كتبه الي بعض اصحابه:
 وهي ان الدويرة «» علي ما انهاه، وربما قصدت ان تكون فداه، قد ملت دعامها «» من طول الوقوف، وكلت نفثة جدرانها من حمل السقوف، وعزم
  
  
 
 جمعها علي ان ينقض، وكل جدار يريد اضن ينقض، ومولانا مسءول في تجديد المراسم، واولي من فك اسري منها واسر الدعاءم.
   وقوله وقد بعث اليه ابن حنا الوزير «» بماكل «» فصادف وصولها وصول طواءف من الفقراء اليه: (رمل)
   
 كان عندي فقراء احمديه ... عمهم جود الايادي العلويه
   
 وسعوديون قد اسعدهم ... وبهم بالمكرمات الصالحيه
 يا مولانا سيد الوزراء، وكهف الفقراء، اكل والله طعامك الابرار «» وافطر علي معروفك من لا نوي الافطار، وصلت عليك ملاءكة السماء البررة الاطهار.
 المملوك يقسم بالله لقد صادف الماكول الشريف من فضله المملوك علي الطواءف المذكورة (وعربهم) «» وعمهم كثر الطعام، وبركة سيد الصلحاء الكرام، وما راي الناس صاءما ابر بهذا الايثار «» ، ولا اقتفي احد في المكارم هذه الاثار، الحمد لله (طيبات «» الي «» من الدعاء المقبول في، واعلا مناقبه الشريفة من (اعتر) «» والجنة) .
  
 
   /ب وقوله:
 وقف المملوك موقف الاجلال لقدرها والاخلال بالعجز عن شكرها، واجتلي الانوار «» من زهرها وزهره، والهاه نسج الجوي عن الحريري ومقاماته «» ، والخوارزمي ومصنفاته «» ، والعتابي ومذهباته «» ، وكان رياض سطري «»  
 
 نسجت غلي منوال «» سطوره، واسرجت انوارها من ضياء وجهه ونوره، واجري انهارها جريان يمينه، مع صفاء ضميره، فنشرت باباتها العيوية «» ، ولثمت اثار يده الموسوية «» ، وامنت بموجزات معجزاتها المحمدية «» ، واءنت من يميني اليسار «» ، وباعدت بينها وبين الاعسار «» ، وجمعت بين المعلي «» والرقيب «» من سهام الايسار «» ، كما جمعت بين الفضل والافضال، ومحاسن القول والافعال، فراح مفضولا بها اليسان «» ، ومعمودا «» ببداءهما «» عماد
 
 اصفهان «» ، ومعمودا ببداءها عماد همذان) «» .
   وقوله يصف شعرا وسكرا اهداهما اليه ابو الحسين الجزار «» عند ولادة ولده محمد «»
 ويهنء ورود ما سمحت به الانامل الكريمة من درها «» الذي ملا الوطاب ودرها الذي ملك الرقاب، وكلتا الصنيعتين «» حلا موقعها، وعلا مصطنعها،
  
 
 وبكلتيهما «» النسب العالي، والثمن الغالي، فلا خلت الافاق من فواءده، ولا عطلت «» الاعناق من فراءده «» ، فلقد استنطق «» بحمده، حتي الوليد بمهده، وقد تفاءلت بهديه يحيي «» ، فقلت يهدي وتحيا. وكانت ابياتك اولي بتمامه، وهباتك «» اول مغانمه، وقد جدد المملوك السءال في تشريف مولانا بكراءمه، كما شرف بمكارمه، ورايه اعلي.
   وحكي ان ابن اسباسلار «» والي مصر قد طلع في ذكره دمل اطال ليلة، وقصر بطول القعود ذيله، فكف من جماحه «» الطمع، وفرق شمل مسراته بما جمع، فاتاه الطبيب والالم قد اوسعه فوق جهده وحمله (يبس) «» الصاحب في رقعة من خلده، فامره بتجنب الزفر، وزجره عن امور لو انزجر، فبعث الي
  
 
 ابي الحسين الجزار «» في عمل مزورات «» له، فعمل منها انواعا منوعة، وبعث بها فجاءت اليه مسرعة، وكتب اليه معها رقعة المقصود منها «» :
 وما علم المملوك ما تجدد من حديث ذلك الشخص الذي شكا الم تاجه «» وورم اوداجه، وانحراف مزاجه، وعجز ممرضيه عن مداواته وعلاجه. وظاهر الحال ان الذي احد باسه، والم راسه، كونه تقاوي «» وتسلط وترك الحمية وخلط، فلو انه لزم من الاغذية ما اعتاده، وجري من الرياضة والتورع «» علي ما جرت به العاده؛ لما ضعفت قواه، ولا تعذر دواه، ولا رجع بعد فطره يصوم ولا استغني بالمزورات عن الالية «» واللحوم، ولا عدم الراحة من الراحة باللمس، ولا افتقر لمباشرة البدر والشمس، فالله تعالي يبقيه لاولءك القوم، ويمتعه بالعافية قبل دخول شهر الصوم.
   /ب فامر السراج باجابته فكتب:
 
 وصلت الاواني العطرات، والالوان التي ازرت «» بالحبرات «» والحقاءق علي الحقاءق لا المزورات، فلفت «» مطعما، وشفت الما، ووفرت لكل حاسة من الحسن اسهما لمسا ومذاقا، ونظرا وانتشاقا ووصفا لها يعلق بالنفس اعتلاقا، سلم كشاجم «» الظرف لطاهيها، والوصف لمهديها، ونمت علي المخفية افاويها فلم تكد تخفيها، فجري الماء في ذلك الذي تعلمه، وشفي المه، وعادت شهوته اليه ونهمه «» ، وقام من الصحة علي ساق، وتشوق الزفر واشتاق، واليكم هذا الحديث يساق، وقد دعت الحاجة اليه في اليه، واعتمدت عليه في نيل البغيه «» ، ونادته بالاسمث واللقب والكنية، فطالما فضلت عنده اللوايا «» ، ووجدت في زواياه منها خبايا، وقبلت منها علي (لله) «» تقادم وهدايا، فليعجل بذلك قبل الصوم، وليلزم حالته الوسطي «» (بين اليقظة والنوم، وان شك في صحة المريض، وتوقف عن (ش: فحصره) «» المستريض، 
 
 فلينعم بجس نبضه، وبسط كفه عليه وقبضه، صرف الله عنه الشك باليقين، ولا زال بغير حجب بينه وبين ما يحبه يقين) .
   (وكتب «» الي ابن الخويي «» القاضي وهو بدمشق وقد بعث اليه بكتاب ونفقة) :
 ويهنء ورود المشرف لقدره، والمشنف «» سمعه بدره، المنثور لذهنه وفكره، المنوه «» بعد الخمول بذكره، متضمنا من الصدقات العميمة، والبركات العظيمة، والصلات «» الجسيمة، ما اعجز كاهل الشكر عن حمله، بل حمل اقله، ومساعي الكرماء ان يهتدوا السبيل من سبله، ودواعي البلغاء ان ياتوا 
 
 بسورة من مثله، فقبل مواقع القلم، ولقي به فرسان الكلام فالقوا السلم، واهتدوا بمعانيه الشهابيه في جنح الظلم، كاهتداء السفر بالفلم «» وفيه وفيه ولا او فيه، وهو لم يكن الا التنبيه، علي الاجتماع بخدمة القاضي النبيه، فحمدت طريقا هدي، وبسطت للقبض الداخل يدا، وقلت لي البشري اجتماع تولدا، فلله كتاب تضمن وقد، وهي التي بتحقيقها «» حق للسراج ان وقد «» ، وخالط لسانه لسان الميزان، فاثزن وانتقد، وقد كان الافلاس سقي «» بينهما بالنماءم «» ، فانفق الصلح يد الدراهم، واندمل «» من الجراح ما لا يندمل بالمراهم، ولا زالت الايادي الشهابية «» تصلح من الايام ما فسد، وتتقن من بضاءع الادب ما كسد، وتقوم في مصالح اهله مقام الروح للجسد.
 /اومنهم:
 $  احمد بن ابي الفرج بن عبد الله الشافعي: الدين «» ابو عبد الله:
 فقيه لا يطاق معه نهوض، وشاعر لا يركب معه عروض، طالما سلك البحور،
 
 وسلك الدرر للنحور، الي علم بالعربية، وفهم في اللطاءف الادبية، وامعان واف، لاوزان وقواف، بمعرفة لو فطن لها الخليل بن «» احمد، لاجراه مجري والده وترك طريف «» ما عنده لتالده «» .
 ومن شعره قوله في شيخنا قاضي القضاة ابي عبد الله بن جماعة «» وكان قد عزم علي الحج، فلما ركب بغلته سقط عن ظهرها فوقعت عمامته وانكشف راسه.
   وقوله: (كامل)
   
 بشراك يا قاضي القضاة بحجة ... تكسوك من حلل الكمال لبوسا
   
 قد شاقك الاحرام لما شقته ... فابي يقبل راسك المحروسا
 
 ومنهم:
 $  عبد الله بن علي بن منجد، تقي الدين ابو محمد السروجء:
  
 
 قيس «» هوي وغرام، وقيس «» جوي وضرام، من الفقهاء الفضلاء، والاكابر ذوي القدر والولاء، بدع «» فضاءل، وطلع «» كل طاءل وكان من الدنيا متقللا، وعلي الاخرة مقبلا. وكان يسكن الحسينية «» ، وهي اجل حواضر القاهرة، وبوادي حضرتها الزاهره وكان يقول: هي وادي الغزلان، ويهيم بظباءها، ويصف بهم اسقامه التي اعيت علي اطباءها، ولا يزال يميل به هوي كل قضيب، ويصرعه لحظ كل حبيب، بوجد لو لامس الصخر للان، وحب تساوي فيه السر والاعلان.
   ومن شعره قوله: «» (بسيط)
   
 يا ريس «» الوصل ادركني فقد وصلت ... مراكب الحب في بحري واشواقي
   المقطوعة في فوات الوفيات /.
 
   
 ولي بضاعة شعر ضاع اكثرها ... وقد بدا ذا الهوي يستغرق الباقي «»
 /ب ومنهم:
 $  الحسن بن عمر بن سالم، النقاش الاسطرلابي، زكي الدين:
 واثني عليه شيخنا ابو حيان «» بالعلم والادب، وشعره يدل علي كثرة ما له من الداب، وله ما يهز هزة الراح، ويبث في القلوب الافراح.
 
   ومن شعره قوله: (بسيط)
   
 الحر بالبر والاحسان تملكه ... والنذل بالصد افعالا واخلاقا
   
 يزداد لءما اذا ما زدته كرما ... كالنفط يزداد بالتكريم احراقا
 ومنهم:
 $  محمد بن عمر بن ابي بكر بن اسماعيل ابو عبد الله:
 شاعر له براعه، وساحر نفث «» في براعه «» ، طلع كل شرف «» ، واخذ بكل طرف «» ؛ لفضل قد فيه باعه، وملك حر الكلام واشتراه وباعه.
   ومن شعره قوله: (طويل)  
   
 احبتنا بنتم فبان تصبري ... وذقت عذابا لا يجد لواصف «»
 في الحاشية: ابو محمد، اطلع بادابه النجوم وسيرها، ووقت لها المواقيت وصيرها ولم يقنع بالدرر واسلاكها حتي طلع الي الدراري في افلاكها، فنسب المشارق والمغارب ...
 (كلمات غير مقروءة في حدود اربع كلمات) .
  
 
   
 وقد كنت ادري ان في البين اهة ... ولكنما التجريب فوق المعارف
 ومنهم:
 $  ضياء بن عبد الكريم بن حاتم الانصاري وجيه الدين ابو الحسن: «»
 
 بزغ «» من قحطان، ونزغ «» حيث لا (تمتد له) «» اشطان «» . من اصل معرق «» ، ودوح «» في الاسلام مورق «» . اتي بالحسن، وواني طوع ارادته اللسن «» ، الا انه مقل، وتقليله علي كثيره يستدل.
   «» ومن شعره قوله: (طويل)
   
 بروحي معشوق الجمال «» فما له ... شبيه ولا في حبه «» لي لاءم
   
 تثني فمات الغصن من حسد له ... الم تره ناحت عليه الحماءم
  
 
 /اومنهم:
 $  موسي بن علي بن موسي بن يوسف الزرزاري، شرف الدين ابو عمران «»
 
 شاعر نوءه «» مطير، وضوءه يكاد يستطير «» ، وذكاءه فوق ذكاء «» اتقادا، ومثل عين الشمس لا تكتحل رقادا.
   ومن شعره «» قوله: (طويل)
 تواضع «» كالنجم استبان لناظر ... علي صفحات الماء وهو رفيع
   
 ولم يك «» كالدخان يرفع نفسه ... الي طبقات الجو وهو وضيع
 هكذا ذكرها ابو حيان وانشد كالدخان مشددة.
 ومنهم:
 $  احمد بن محمد «» عبد المجيد بن صاعد الخزرجي، نجم الدين ابو العباس ابن الوزير عز الدين:
  
 
 قبس اضاء واري، ومضي ففري «» ، وجني الثمار وقد وشج «» في عرق الثري، سءدده «» قديم، ومحتده «» اليمني لفخار قيس قسيم «» ، ببيت يبيت وهو للنجم نزيل وسمير.
 وتقول به الخزرج للاوس:
 (منا امير ومنكم امير) «» . وقد ذكره شيخنا ابو حيان، وكان لا يزال في الاحيان.
 وله غرر لا تخفي محاسن اهلتها، ولا يكاثر علي قلتها.
 ومما انشد له:
   «» قوله: (طويل)
   
 رايت الفتي اهواه «» يبكي فسرني ... وقلت لما قد نالني يتوجع
  
 
 /ب
   
 وما ذاك منه رحمة غير انه ... سقي طرفه والسيف يسقي «» فيقطع
 ومنهم:
 $  علي بن احمد بن الحسين «» الاصفوني «» علاء الدين ابو الحسن:
 
 من بيت طلع في الوزارة نجمه، وتدفق في جانب الملك يمه «» ، وكان هو من خيار ابناءه، واركان بناءه، كان بالادب مليا «» ومن ذوي السمات والاسماء عليا.
   ومن شعره «» : قوله: (كامل)
   
 وقل المتيم جاءكم مستغفرا ... ومن الاحبة يعرف الغفران
   
 فاذا تصالحت القلوب علي الوفا ... فخذوا الفءاد فانه شكران «»
  
 
 ومنهم:
 $  اسماعيل بن احمد «» بن اسماعيل
 
 القوصي «» ، جلال الدين ابو الطاهر:
 ناجذ «» ادب مفتر «» ، وراءد»
 كنف «» مخضر، وكان صادق الوفاء، صادع «» الصباح بلا خفاء، من نبعة «» الشعراء، وبرعة «» اهل الادب بغير مراء «» ، يقول للمعني اصحب شءت او ابيت، وللشعر اخل فانا الذي رفع قواعد البيت «» .
 اثبت اسمه شيخنا ابو حيان وذكره، واثني عليه وشكره، وكان لا ينال ادني سبقه، ولا تثبت عين لسنا برقه.
 
 ووقفت له ايام مقامي بمصر علي شعر كثير لا يحضرني فيه الان الا ما قطفته «» من مجاني «» الهصر «» ، ومنه:
   «» /اقوله: (وافر)
   
 اقول ومدمعي قد جال «» بيني ... وبين احبتي يوم العتاب
   
 رددتم ساءل الاجفان نهرا ... تعثر «» وهو يجري في الثياب
   «» وقوله: (وافر)
   
 غزال كم غزا قلبي بعضب ... يجرده وليس له حماءل
   
 وضاع «» تمسكي بالند فيه ... وضاع المسك من تلك الغلاءل
  
  
 
 ومنهم:
 $  محمد بن «» الشرف القدسي الكاتب «» :
 
 تاءه يخبط «» في عشواء «» ، ويخلط في نطق وعواء، بين رشد وتضليل، وتحريم وتحليل. وكتب الانشاء مصرا وشاما، وجلا وجوه المعاني وساما، فجاءت حالية التراءب «» ، (وحاوية للغراءب، تسحر كان سفور الحور في جناتها، كان يطوي الضلوع للدين ويحنو ولم يكن) «» .
 وخدم الشجاعي وكان لديه اثيرا، وقليله عنده كثيرا، ثم سقط من عينه سقوط الدمع، وقط «» في مجلسه قط الشمع وذلك بدمشق عند ظهوره علي فساد معتقده، وبيان بهرجه «» في يد منتقده. وكان علي ما فيه من قبيح المعاءب، وخلق السوء الذي لا يءنبه الصريح المكاتب، مفري بحب الكيمياء ومعاناة عملها، ومعاداة ما له في صحبة املها.
 وقد خمس ديوان الشذور، ورجع بالخيبة رجعة الملوم المغدور. وحكي غير واحد، منهم والدي وشيخنا ابو الثناء محمود الكاتب «»
 
 /ب وابن البيع «» ، وعلي بن حمزة النقيب «» ، وغيرهم: انه كان والله يعفو عنه مغري بتربية صغار الاطفال، والميل اليهم والتخلق باخلاقهم، حتي كان يربي جري «» الكلاب العكلية من الطرقات، ويحملهن تحت ثيابه،
 
 لارضاء الصغار، ومن هذا ومثله، مما لو قذف في البحر لنجسه، او جلل به النهار لادمسه «» هذا اكثره حكوه من عظيم استهتاره «» ، وقبيح اشتهاره، مع فضل في الادب، وحظ ما مثله حظ من كتب، ولا سيما التعليق الذي كانه سلاسل الذهب «» ومن شعره:
   «» قوله: (طويل)
   
 عجبت له اذ دام توريد خده ... وما الورد في حال علي الغصن داءم
   
 واعجب من ذا ان حية شعره ... تجول علي اعطافه وهو سالم
   وقوله في بعض الفتوحات: (وافر)
   
 وما زال الحمام ينوح فيها ... الي ان صار موضعه الحمام
  
 
   
 وظنوا انهم قوم عظام «» ... فهاهم في جوانبها عظام
   
 اري اسوارها سجدت لخوف ... ولكن فاتها فيك السلام
 /اومنهم «» :
 $  السيد الشريف الجعفري الحاكم باخميم «»
 . ذكره السراج الوراق في مختصر «» ديوانه، ولم يعرفه باسم ولا لقب، ولا بجد ولا باب. وانما حسبك منه ما شهد به الادب، وعرف ثناءه وهو في مجمر «» البروق نشب «» ، ذكر الوراق ان هذا السيد الجعفري كتب اليه:
  
 
   وقوله: (كامل)
   
 لك عزمة ماثورة عمرية ... كالسيف اصلت «» في يمين المنتضي «»
   
 ويد اذا خطت بنقش اسود ... في طرسها جاءت بفضل ابيض
   /ب وقال انه اجابه: (كامل)
   
 ما الروض بين مفتق «» ومنمنم «» ... من زهره ومذهب ومفضض
   
 بكت السحاب له وشقت جيبها «» ... والبرق مبتسم بثغر مومض
   
 واحمر خد الارض فيه خجلة ... من لحظ نرجسه المريض الممرض «»
   
 يوما باحسن من سطور صاغها ... فكر الشريف فعد «» عن شعر الرضي «»
  
  
 
   
 من كل بيت جعفري «» ساده ... كالجعفري وما بني لم ينقض «»
 قلت (واظن هذا الشريف هو الذي عناه السراج وكتب اليه يقول (سريع) «»
   وقوله:
   
 وحاسد ما رق لما راي ... لي حالة ما معها بقيا
   
 قال وان الحق في قوله ... يكفيه ان يحيا له يحيي
 نقلتهما من خط السراج من ديوانه، وقد قال فيما انهما في مدح الشريف جمال الدين يحيي بن الجعفري رحمه الله ثم ذكرهما)
 
 /اومنهم
   
 ... «» مجد الدين ... «» عرف بابن الجباب «» :
 سليل اماجد، ورسيل «» اول مبكر الي المساجد، من قوم كانوا للزمان امارا، وللركبان «» اسمارا «» ، وللمعتفي «» مزنا «» ، وللمعتدي حزنا، وتاخرت منه قنة»
 من شواهقهم «» ، ولمعة من شوارقهم، يضء الدجي، (ويقر الحلم
 
 والحجي) «» ، اذ كان من تلك البقية، وابن جلا «» الطالع من كل ثنيه «» ، دينار من الوف، وزبرة «» من سيوف.
 ذكره «» السراج الوراق في غير موضع من ديوانه «» ، والكتاب يعرف بعنوانه.
 قال السراج الوراق: كنت طلبت من القاضي الرءيسي مجد الدين ابن الجباب قربة عند توجهي الي الحجاز الشريف، فبعث بها «» وكتب الي:
   وقوله: (كامل)
   
 يا شاعرا ما الاحنف «» المشهور في ... حلم يقاس به وليس معاويه
  
 
   
 اصبحت محتاجا لفاضل قرية ... هذا وكم من فاضل لك راويه «»
 فاجبته:
   وقاله: (كامل)
   
 قل للفتي السعدي افضل من له ... في الصدفتين «» قرينة «» او قافيه
   
 من ذا يجاري فيك بحرا زاخرا ... صارت به السبع البحار ثمانيه
   
 انا عنه راوية وحماد «» له ... خلفت حمادا يسير وراءيه
 ومنهم:
 $  احمد بن نصر الله «» بن باتكين المصري القاهري محيي الدين ابو العباس:
  
 
 /املا العيان «» ، وجاء علي فترة «» بمعجز البيان، فاطلع الالفاظ غرا، واطمع كل اديب قال لعل له عذرا، وظل يعاطي «» كءوس الادب معاطاة الراح،
 
 ويدافع علي «» عيونه «» دفاع الراح، فكلف «» به كلف ذوي الغرام، وشغف «» به شغف الروض بالغمام، فحاز «» منه الاقتراح، وجاز «» الغايات فحط «» الرق «» عنه واستراح. وكان ذهنه يتوقد الضرام، وجفنه يتجنب الكري الحلال تجنب الحرام، وتدفق خاطره بالمعاني التي فجرها «» وتوقد بالنار التي سجرها «» ، وتفنن بالفنون التي ما كان لاقلام البلغاء ان تنبت شجرها.
 وقد حكي انه كان علي قدمه الثابتة في الادب، وتقدمه في فنه الذي زم «» اليه ركاءب «» الطلب، ربما اخطا الوزن في مواضع وخرج عنه من غير موانع.
 وحكي السراج الوراق انه انتقد عليه وزن الكامل فبلغ ذلك ابن باتكين، فكتب:
 
   «» اليه: (كامل)
   
 يا جابرا كسر الضعيف بطوله «» ... ومصححا معلول كل سقيم
   
 لا تعجبن ان تبد مني توبة ... عن وزن بحر الكامل الموسوم
   
 لا زلت تستر كل عيب ظاهر ... مني وتاسو «» داميات كلومي
   فاجابه: (كامل)
   
 باكرتني «» بخميلة «» مطوية «» ... يسري لها ارج «» بكل نسيم
   
 فشكرت من انفاسها ادبية ... ذهبية في وشيها المرقوم
   
 ووردت بحرا كاملا من كامل ... ترك الخليل «» يجن قلب كليم
  
  
   «»
 
   
 يا جفن مقلته سكرت فعربد «» ... كيف اشتهيت علي «» فءادي المكمد «»
   
 من لم يبت بعذاب حبك قلبه ... متنعما لا فاز فيك بموعد
   
 لاموا علي ظماي اليك ولو دروا ... في ماء خدك ما حلاوة موردي
   
 وجه كما سفر الصباح وحوله ... حسنا بقايا جنح ليل اسود «»
   «» وقوله: (بسيط)
  
 
   
 اقسمت بالله واياته ... يمين بر صادق في اليمين «»
   
 لو زدت قلبي فوق ذا من اذي ... ما كنت عندي غير عيني اليمين
   «» وكتب اليه ابو الحسين ملغزا في الشطرنج: (وافر)
   
 وما شء له نفس ونفس «» ... ويءكل عظمه ويحك جلده
   
 يود به الفتي ادراك سءل «» ... وقد يلقي به ما لا يوده
   
 وياخذ «» منه اكثره بحق ... ولكن عند اخره يرده
  
 
   «» فكتب ابن باتكين جوابه: (وافر)
   
 لقد اهديت لي شعرا بديعا ... يضل عن اللبيب لديه رشده
  
 
   
 به ضدان مقتتلان وهنا ... ويصطحبان في نطع يمده
   
 هما ضدان من زنج وروم ... يقاتل كل قرن فيه ضده
   
 تقوم الحرب فيه كل وقت ... ولا تكفي من الوقعات جنده
   
 ويشتد القتال به طويلا ... ويحكم بالاصاغر فيه عقده
   
 ويقتل ملكه في كل حين ... ويبعثه النشاط فيسترده
   
 وما ينجي الهمام به حسام ... وقد نجي من الافات شده
 /اومنهم:
 
 $  الشهاب الاعزازي «»
 وهو احمد بن عبد الملك بن عبد المنعم بن عبد العزيز «» شهاب الدين ابو العباس:
 عود الادب ونبعته، وصيت الذكاء وسمعته، وكان حسان قول، واحسان طول يسحر ببيان كلم «» بوالغ «» ، وسنان كلوم في دم والغ «» . وهو جملة احسان، وجبلة «» كلام خلق للسان، بفكر يقذف بحره العنبر «» ، ولا يحدث
 
 فيه الا عن بر «» ، ولم يبرح شهابا يتوقد فرقدا «» ويتضرم موقدا، بصدر رحيب، وبرا من كل رقيب، الي ان بعد منه ما اقترب، وداني شهابه المغيب فغرب.
 اصله من عزاز، وسكن القاهرة المعزية «» وتمطر «» في عنان صباه المطرية «»
 
 والحزية «» ، ولم يفت منذ كان فتي رافلا «» في بردها الممصر «» ، وراقلا «» في بلدها الذي اعجز كسري وقيصر، وكان بقيسارية (جهاركس) «» في قطانها «» التجار، وسكانها بالابحار، والناس تنتابه «» ، واونة عتبه واونة اعتابه «» ، وكان
 
 يبيع البز «» ، ويعيب الاماعز، ومكانه نادي حسب، وبادي فضل حاضر ومكتسب، يغشاه «» اكابر الفضلا، وذوو الماثر من الاجلاء، فاما الادباء فكان عكاظ «» سوقهم، وغاية سبوقهم «» ، وعزت به عزاز، ورفلت القاهرة في ثوب لها منه طراز «» جالس بها الملوك وحاضرها، وجانس «» باديها وحاضرها، فزهت به مناظرها، وبهت «» بادبه مناظرها «» .
 سالت شيخنا ابا الثناء «» ، فقال: كان قوي التراكيب، صحيح الاساليب.
 قلت: وكان مظهرا للاعاجيب، ومظهرا لابكار «» من الجاذر في زي الاعاريب «» .
 
 وكتب الي شيخنا ابي الثناء يهنءه بطبقة كان بناها بحارة (زويلة) «» رفع سمكها «» ، (ورصع في عنق الجوزاء «» سلكها، وجلا عقلتها «» الحاليه، وطاول بها القصور فتضاءلت لطبقتها العاليه) «» .
   وقوله: (طويل)
   
 سلام علي تلك المحاسن والحلي ... وتلك السجايا «» الغر والخلق العذب
   
 سلام محب تطبيه «» صبابة «» ... اليك علي بعد من الدار او قرب
  
 
   
 ايا عمر الحمرات «» والمدرك العلي ... بمنصبه العالي ومنزله الرحب
   
 ابثك ما بي من هوي منك زاءد ... وشوق قنوط «» بالملامة والعتب
 /ب
   
 عهدتك سمحا بالتواصل واللقا ... فصرت ضنينا «» بالرساءل والكتب
   
 وما لي ذنب «» استحق به الجفا ... وان كان لي ذنب فحبكم ذنبي
   
 وما ازددت عندي جفوة بعد جفوة ... وحقك الا ازددت حبا علي حبي
   
 ايا طيفه زرني ليسكن مضجعي ... ويا شخصه عدني لتطفي لظي «» كربي «»
   
 ويا بارقات من رباه الا او مضي ... ويا نسمات من حماه الا هبي
   
 فتي كفه تهمي ونعماه تبتدي ... والفاظه تسبي وادابه تصبي «»
   
 انم من الريحان والبان ذكره ... واذكي «» من الجادي «» بالمندل «» الرطب
   
 له كلمات نشرها «» ومذاقها ... كراح الندامي او كريحانة الشرب
   
 الذ الي الاجفان من سنة «» الكري ... واسحر للالباب من حدق السرب «»
 
   
 شجاع القوافي ماءل ببداهة ... يروح بلا طعن ويغدو بلا ضرب
   
 اذا حاك شعرا او رواه محررا ... فمن احمد الكندي «» او عامر الشعبي
   
 سقي الله مصرا ما سقي عذب «» الحمي ... ولا اخطاتها صيبات «» من السحب
   
 ولا برحت مخضلة الدوح والثري ... معنبرة «» الارجاء مسكية الترب
   
 احن الي اطلالها وربوعها ... وما دارها داري ولا شعبها «» شعبي
   
 ولكن لمن قد حلها وثوي بها ... وان غاب عن عيني فمازال عن قلبي
   
 ساشكر منه نعمة عمرية ... وعارفة حسبي صناءعها حسبي
   
 واذكر اياما له ولياليا ... رايت بهن السرج «» اذكي من الشهب
 
   فاجابه: (طويل)
   
 لقد باكرتني روضة ادبية ... هززت بها اعطافنا هزة القضب «»
   
 واغنيتني عن كل غناء «» بالتي ... سقتها يمين منك اندي من السحب
 /ا
   
 لثمت بها للورد خدا مضرجا ... عليه سقيط «» الطل كاللءلء الرطب
   
 وقبلت ثغر الاقحوان مفلجا «» ... فاطفات حر القلب بالبارد العذب
   
 وغازلت لحظ النرجس الغض خاليا ... وللسحب هدب منه نيطت «» الي هدب
   
 فمن انبت الازهار فوق مهارق «» ... سواك ومن ذا انشا الروض في الكتب
   
 واعطش ليل النفس تشرق تحته ... معان اذا استجليت ابهي «» من الشهب
   
 لقد راق لي ما راق من حسن لفظها ... كما رق لي ما راق من ذلك القلب
   
 الذ لجفن المستهام من الكري ... واعذب في قلب المحب من الحب
   
 واطيب من ليل تنفس «» صبحه ... من الراح والريحان للفتية الشرب
  
 
   
 وقام ينادي للصبوح بسحرة «» ... غلام يغني للفتاة الا هبي
   
 وغني عليها جاءل» من وشاحها ... علي الصمت من خلخالها ومن القلب
 «»
   
 وطاف براح لونها من خدوده ... ورقتها في الكاس من دمعة الصب
   
 واطيب من ذا ساعة اجتلي بها ... محيا شهاب الدين محترق الحجب
   
 وتشنيف سمعي منه بالدرر التي ... عندها در التراءب في الترب
   
 ولا اختار الا شعب احمد دونهم ... وناهيك «» للاداب والعلم من شعب
   
 ومن احمد الكندي «» اذ قال احمد ... فريضا فاعيا قالة العجم والعرب
   
 وقصد «» احيانا ووشح «» تارة ... ليطلع في شرق شهابا وفي غرب
   
 اليك شهاب الدين «» عذري فان لي ... عواءق تلهيني عن الاكل والشرب
   
 وحسبك مني حسبك اليوم «» خجلتي ... لديك وحسبي فيك فرط الحيا حسبي
 
   
 وعادتك الحسني اذا لم ازر تزر ... فنحن سواء لا محالة في الذنب
 /ب
   
 فزرني وهب عيني برءياك حظها ... كما نال قلبي منك يا ساكنا قلبي
   (وكتب الي السراج الوراق) «» (كامل)
   
 قسما بوجهك انه الوجه المضي ... وبحسن خلقك انه الخلق الرضي
   
 وبحود راحتك التي نعماءها ... للمعتفي ونوالها للمنفض «»
   
 وبذكرك الحسن الجميل وفضلك ال ... غمر «» الذي «» بقليله لم انهض
   
 اني علي العهد الذي اسبابه ... لم تنصرم «» وبناءه لم ينقض
   
 يا فاقدا لم يخف عن لحظاته ... امر المحب من الحسود المبغض
   
 نبءت انك معرض «» متعرض «» ... روحي فداء المعرض المتعرض
  
 
   
 واتت خيولك بالعتاب سوابقا ... تردي «» وخيلي قبلها لم تركض
   
 فعجبت من حظي لمثلي اسود ... وخجلت من عرض لمثلك ابيض
   
 فابعث كتابك ضامنا عنك الرضا ... مما سمعت وداوني يا ممرضي
   
 فمدامعي لم تنبجس «» حتي اري ... منك الرضا ونواظري لم تغمض
   
 ضل امرء بسوي سراج الدين «» في ... جنح الحواري يهتدي او يستضي
 
   «» فاجابه: (اي السراج الوراق) (كامل)
   
 حبل المودة بيننا لم ينقض ... سخط الحسود بذاك منا او رضي
   
 فلءن تعرض او تعرض ناقل ... فالويل للمتعرض المتعرض
   
 ثبتت لدي كما لديك مودة ... تدلي اليك بحجة لم تدحض «»
   
 وبها اكتفيت فقد دعيت المكتفي ... وبها استضات وقد دعيت المستضي
   
 قسما شهاب الدين «» بالبشر الذي ... من غير وجهك ما اراه بمومض
 /ا
   
 وبراحة بسوي الندي لم تنبسط «» ... يوما وعن غير الخنا «» لم تقبض
   
 اني علي ود يزيدك صحة ... من (دونه) «» الم العتاب الممرض
   
 ولقد بعثت خميلة اغنيتني ... من زهرها بمذهب ومفضض
   
 واريتني اثار كفك في الندي ... يا فخر رويها الطروس وروض «»
   
 ومن الغلام فقد اطاعك بين ... امران المجد وبين حنك المحمض «»
  
 
 وكان السراج الوراق قد عمل قصيدة في الملك المظفر «» صاحب حماة فانشدها له بحضور العزازي في مناظر الشرف الاعلي المطل علي بركة الفيل «» ، وهي قصيدة سيارة، منها «» : (البسيط)
   
 اليك بالاذن صار الناس والجود ... فلا عدمنا فقيدا فيك موجود
   
 وللربيع لسان ظل ينشدنا ... النبت «» اغيد والسلطان محمود
   
 واقبل الغيث منه حاجبا ملكا ... كم شاع يوما «» له بالنصر مشهود
   
 والنيل كم حسد القاضي علي ملك ... تصور الجود فيه بل هو الجود
   
 ملك يصد بنعماه القلوب علي ... ما هذبته به اباءه الصيد
   
 فيا لجدود العوالي والجدود معا ... لواءه حيث حل النجم معقود
   
 له شريعة عدل عندها شرع ... اسد الفلا والمها والشاء «» والسيد «»
   
 يا ناظم الطعن في لبات «» حسده ... كصنعة «» ما خلا من نظمه جيد
   
 لقد اتيت بها جهد المقل «» ولل ... ساري بها ومقيم الدار تغريد
  
 
 فلما انصرف كتب الي العزازي يشكر حسن صنعه اليه، وجميل ثناءه عليه وهي «» :
   (طويل)
   
 وقد كنت دهرا للمروءة «» ناشدا «» ... اساءل عنها من اغار وانجدا «»
 /ب
   
 واسمع عنها ما يشوق ولا اري ... الي ان رات عيني العزازي احمدا
   
 فراش جناحي «» نحو ملك متوج ... تخر له الافلاك «» ما لاح سجدا
   
 وانشدته في حضرة الملك قاعدا ... وود ابن اوس «» ثم لو قام منشدا
   
 ولا بيت الا والشهاب (معزز) «» ... يقول اعد فالعود ما زال احمدا
  
 
   
 واردف «» لي النعمي بنعمي مشافها ... (بها) «» الافضل الملك الجواد ممجدا
   
 فانشدت كالحال التي قد تقدمت ... وعاد شهاب الدين يثني كما بدا
   
 يقول كذا فلينظم الشعر ناظم ... وياتي به الاملاك مثني وموحدا
   
 فحدثت نفسي بالغني غير كاذب ... لان بني ايوب «» هم منبع الندا
   
 ولم تر عيني شاعرا «» ود شاعرا ... لذا ولذا ما شاد «» هذا الفتي سدي
   
 فعاش شهاب الدين يفدي بحبهم ... وبينهم «» والعبد من جملة الفدا
   فاجابه العزازي: (طويل)
   
 لقد باكرتني روضة ادبية ... تغني بها طير الثناء وغردا
   
 فبت وقد هش «» الخليل بوصلها ... وارشقني «» منها الاراك (المبردا)
   
 اقبل منها مبسما طاب موردا ... كما قبل المشتاق خدا موردا
  
 
   
 اياتي بها شيخ الفضاءل فاضلا ... (سديد) «» القوافي زاخرا «» ومقصدا
   
 اري عمرا «» اولي الكرامة احمدا «» ... ومن غيره اولي «» باكرام احمدا
   
 سراج «» هدي الله الشهاب «» بنوره ... ولولاه في نهج البلاغة ما اهتدي
   
 تكاد العذاري يتخذن قلاءدا ... منظمة من شعره لو تجيدا
 /ا
   
 اترجو بناتي «» لحاقا نساءه «» ... وابناءه قد احرزت قصب المدي «»
   
 وهل يرتجي غير المظفر «» نازح ... وقد اشبه المنصور «» باسا وسءددا
   
 فادني سراج الدين مستمعا له ... فانسي حبيبا «» حين انشا وانشدا
   
 وساقط ذاك الدر من لهواته «» ... نظيما «» ولولا نظمه «» لتبددا
   
 ورنح اعطاف الندامي ولم يدر ... منه لكن ثناء مجددا «»
 
   
 وقمنا ووجهي للسفارة «» ابيض ... بمن ساد في نظم القريض «» وسودا «»
   
 واعرفه اسخي الملوك شماءلا ... واسمحهم نفسا وابسطهم يدا
   
 ولكن هي الاوراق «» يحرمها الفتي ... قريبا ويجني زهرها المرء مبعدا
   
 فلا تياس المداح من صدقاته ... فان فات يوما جوده لم يفت غدا
   ومن شعره قوله: (خفيف)
   
 وحديث كانه قطع الرو ... ض سقتها دموع وبل وطل
   
 وعتاب ارق من بسمة الفج ... ر تمنت ما هن: «» ماء وظل
   «» وقوله: (سريع)
   
 مذ فر مني الصبر في حكمه ... حكي عليه مدمعي ما جري
   
 اباح قتلي في الهوي «» عامدا ... وصاح كم من عاشق في الوري
   
 رميته في اسر حبي ومن ... اجفان عينيه اخذن الكري
  
  
 
   وقوله (مجزوء المتقارب)
   
 اقام لعشاقه ... علي حكم مشتاقه
 /ب
   
 وهذا دليل علي ... مكارم اخلاقه
   
 هلال بدا طالعا ... بافلاك «» اطواقه «»
   
 وهلال السماء ... يخر لاشراقه
   
 حمي اس «» اصداغه ... بنرجس احداقه
   
 وقال فخلنا القضيب ... يميل باوراقه
   وقوله (سريع)
   
 هل حكم ينصفني فهو لي ... مصارع يصرع اسد الشري
   وقوله: (سريع)
   
 ان اقبلوا من بين تلك الستور ... واقبلوا فوق القدود الشعور
  
 
   
 فقل شموس اشرقت في الدجي ... وقل غصون اثمرت بالبدور
   
 نواعس الاجفان بيض الطلي «» ... نواعم الابدان هيف الخصور
   
 كانما ادمع عشاقهم ... قد نظموها دررا في النحور
   
 يا كحلا حل بالحاظهم ... جرت كما جار علي الفتور
   
 وانت يا نرجس احداقهم ... شاركت في قتلي اقاح الثغور
   وقوله: (سريع)
  يا خصره الدارس اشكوك ما ... حملته من ردفه العامر
   
 يا ايها الفاحم من شعره ... لله كم افحمت من شاعر
   وقوله: (خفيف)
   
 ما علينا اذا التثمنا خدودا ... قد كسا الحسن فوقها انوافا «»
 /ا
   
 واقتطفنا واوا وراء ودالا ... وشممنا ميما وسينا «» وكافا
  
  
 
   «» وقوله (كامل)
   
 ما عذر مثلك والركاب تساق ... الا تفيض بدمعه «» الافاق
   
 فاذل مصونات «» الدموع فانما ... هي سنة قد سنها العشاق
   
 ولرب دمع خان بعد وفاءه ... مذ حان من ذاك الفريق فراق
   
 ووراء ذياك الكثيب «» منيزل ... لعبت بقلبك نحوه الاشواق
   
 خذ ايمن الوادي فكم من عاشق ... فتكت به من سربه الاحداق «»
   
 واحفظ فءادك ان هفا برق الحمي «» ... او هب منه نسيمه الخفاق
   وقوله: (خفيف)
   
 ايها المستبيح قتلي خف الل ... ه وانه عينيك للدم المستحله «»
  
  
 
   
 وابن لي باي ذنب تقلد «» ... ت دمي عامدا واية زله
   
 يا نحيف القوام من غير ضعف ... وسقيم الجفون من غير عله
   
 بابي منك وجنة لدم العش ... اق فيها شواهد وادله
   
 كتب الحسن فوقها سورة النم ... ل وكانت للعاشقين مضله
   
 مشكلات حروفها وهي لا تك ... تب الا بنقطة وبشكله
   
 بدر تم يلوح في فلك الح ... سن فيكسو البدور نقص الاهله
   
 واذا «» خطا فبانة حقف «» ... واذا ما عطا «» فجءذر رمله
   
 لو بدا للحسان تحت الاكالي ... ل «» تهتكن من ستور الاكله «»
   
 قلت لما بدا لعيني يا مو ... لاي (ان لي) «» حاجة وهي سهله
 /ب
   
 قال صفها فقلت قد شرحتها ... لك في الخد ادمعي المستهله «»
   
 قال لي قبلة اظنك تعني ... قلت لم بعدها اجل هي قبله
   
 فتصدق بها لتطفي اواما «» ... قد اذاب الحشا وتبرد عله
 
   
 فالي برد فيك واحر قلبا «» ... ه ومن لي من برد فيك بنهله «»
   
 اتري يسمح الزمان بلقيا ... ك وهل يغلط الرقيب بغفله
   
 كم امني بوصلك القلب في الس ... ر وفي الجهر والاماني ضله «»
   
 والاقي الاشجان مكثرة في ... ك بنفس من العزاء مقله
   
 انا اشكو لعزة منك ما ال ... بستني الحب من خضوع وذله
   
 لي دمع اجاد «» في الخد ما خ ... ط ولم لا يجيد وهو ابن مقله «»
   
 وفءاد مقلقل «» وضلوع ... واهيات ومهجة «» مضمحله «»
   
 يا نبي الجمال في امة العش ... اق لا تجعل الملالة «» مله «»
   
 وترفق بامة جعلت ح ... بك دينا (لنا) «» ووجهك قبله
 
   
 اطرق «» الغصن مذ خطرت حياء ... واعتري البدر مذ تبديت خجله
   
 قسما لا سلوت عنك ولو ذب ... ت سقاما او صرت في الحب مثله «»
   
 كيف اسلوك والملاحة تجلو ... ك لعيني في حلة بعد حله
   وقوله: (سريع)
   
 اثنت علي عطفيه لما انثني ... معاطف البان وسمر القنا
   
 غصن نقا ينبت في خده ... ازاهر للحسن لا تجتني
   
 يعطيك من احداقه نرجسا ... غضا ومن اصداغه سوسنا «»
 /ا
   
 فهو هلال طالع ان بدا ... وهو غزال راتع ان رنا
   
 لله ما افتك الحاظه ... في مهج الخلق وما افتنا
   
 يا ردفه رفقا علي خصره ... فقد تشكي بلسان الضني «»
  
 
   وقوله: (متقارب)
   
 اذا ما رنا ناظرا او جلا ... جبينا وهز قواما رطيبا
   
 فلا تلتفت لالتفات الغزال ... وذم الهلال وسب القضيبا
   وقوله: (بسيط)
   
 لو كنت تقبلني عبدا بلا ثمن ... رايتها منة من اعظم المنن
   
 يا معرضا عن عتابي في محبته ... كمثل اعراض اجفاني عن الوسن
   
 صف لي المنام فاني لست اعرفه ... كلا ولم اره يوما ولم يرني
   
 ولم يمر له شخص علي بصري ... لكن احاديثه مرت علي اذني
   وقوله: (بسيط)
   
 ان لم امت في هوي الاجفان والمقل ... فوا حياءي من العشاق وا خجلي
   
 ما اطيب الموت في عشق الملاح كذا ... لا سيما بسيوف الاعين النجل
   
 يا صاحبي اذا ما «» مت بينكما ... دون الشهيين: ورد الخد والقبل
   
 فاستغفرا لي وقولا عاشق غزل ... قضي صريع القدود الهيف والمقل
   
 راش الفتور له سهما فاخطاه ... حتي اتيح له سهم من الكحل
  
 
   
 وللعيون اللواتي هن من اسد ... الي القلوب سهام هن من ثعل «»
   وقوله: (خفيف)
   
 قال لي من احبه عند لثمي ... وجنات يحدث الورد عنها
 /ب
   
 خل عني اما شبعت فنادي ... ت الحياة يشبع منها؟
   وقوله (مجتث)
   
 يا راشق «» القلب مني «» ... اصبت فاكفف سهامك
   
 ويا كثير التجني ... قطعت حتي سلامك
   
 وخنت ذمة «» صب ... ما خان قط ذمامك
   
 فاردد علي منامي ... فلا سلبت منامك «»
  
 
   
 فمن راي سوء حالي ... بكي علي ولامك
   
 فلو اردت حياتي ... لما هززت قوامك
   
 بمن احلك قلبي ... ارفع قليلا لثامك
   
 وابسم لعلي احيا ... اذا رايت ابتسامك
   
 يا خده ما احيلي «» ... للعاشقين التثامك
   
 بكيت دالا وميما ... لما تاملت لامك
   وقوله: (مجزوء الكامل)
   
 غضبان جاد بوعده ... وطوي مسافات «» بعده
   
 فرشفت خمرة ريقه ... وقطفت وردة خده
   
 وشفيت حر جوانحي ... برضاب فيه وبرده
   
 ولقد نعمت بوصله ... ولكم شقيت بصده
   
 مذهز بانة عطفه ... وثني اراكة قده
   
 شهد القضيب بفضله ... وكفت شهادة ضده
  
 
   «» /اوقوله: (خفيف)
   
 بدوي كم حدثت مقلتاه ... عاشقا عن مقاتل الفرسان
   
 ذو محيا يصبح يا لهلال «» ... ولحاظ تصيح يا لسنان «»
   «» وقوله: (خفيف)
   
 ما يقول الهاجون في شيخ سوء ... راجح الجهل ناقص المقدار
   
 شان تلعفرا «» فاضحت به ال ... ام ارض نعم واخبث دار
   
 ذو محيا في غاية القبح ما ير ... خي عليه الحياء فضل خمار «»
   
 فلكم جاء لابسا ثوب عاب «» ... ولكم راح ساحبا ثوب عار
  
  
 
   
 بين ميمي مهانة ومساو ... ثم قافي قيادة وقمار «»
   وقوله ملغزا في هنات «»
   
 ولله ممشوق «» القوام اطعته ... وعاصيت في حبي له كل لاءم
   
 له شفة العناب في رشفاتها ... شفاء «» وروي «» للقلوب الحواءم «»
   
 كان الغواني اذ ترشفن ريقه ... وقبلنه قلدنه بالمباسم «»
   
 تبدي لنا في حلة عسجدية ... عليها طراز رق من در ناظم
   
 ووافي كخود «» اقبلت في حليها ... وشمس تجلت بالنجوم العواتم
   
 فاثبت فيه لحظه كل ناظر ... ومال الي تقبيله كل لاثم
   
 مسرة قلبي ان يكون مجالسي ... وقرة عيني «» ان يبيت منادمي
   
 اذا صحفوه كان شيمة ماجد ... وتصحيفه الثاني سجية اثم
   
 وان حذفوا منه اخير حروفه ... فقل في سرور مقبل لك داءم
 /ب
   
 يذكرني فقد الشيبة عكسه ... قدود العذاري او غناء الحماءم
  
 
   وقوله: (منسرح)
   
 قام يروم الطهور «» فانحسر الم ... ءزر عن ابيض له يقق
   
 فمد سقرا «» عليه من سبح ال ... شعر وغطي الصباح بالغسق «»
   
 فخلت بدرا يلوح في ظلمة الل ... يل وغصنا يميس «» في الورق
   «» وقوله في مليح مصارع (سريع)
   
 هل حكم ينصفني من هوي ... مصارع يصرع اسد الشري
   
 مذفر مني الصبر في حبه ... حكي عليه مدمعي ما جري
   
 اباح قتلي في الهوي عامدا ... وصاح كم من عاشق في الوري
   
 رميته في اسر حبي ومن ... اجفان عينيه اخذت الكري
  
  
 
   وقوله: مما يكتب علي حياصة «» : (خفيف)
   
 ما علوت الخصور حتي تبوا «» ... ت من السقم مقعدي ومكاني
   
 وصبرت الصبر الشديد علي البر ... د وذقت العذاب بالنيران
   
 وكاني اعلنت او بحت بالس ... ر فكفوا كما رايت لساني
   وقوله في القوس والنشاب «» ملغزا: (خفيف)
   
 ها عجوز كبيرة بلغت عم ... را «» طويلا وتتقيها «» الرجال
   
 قد علا جسمها صفار «» ولم تش ... ك سقاما ولا عراها هزال
  
  
 
   
 ولها في البنين سهم وقسم ... وبنوها كبار قدر نبال «»
   
 واراها لم يشبهوها ففي الا «» ... م اعوجاج وفي البنين اعتدال
   «» /اوقوله ملغزا في شبابة: (وافر)
   
 وما صفراء شاحبة ولكن ... يزينها «» النضارة والشباب
   
 مكتبة وليس لها بنان «» ... منقبة وليس لها نقاب
   
 تصيخ «» لها اذا قبلت فاها ... احاديثا تلذ وتستطاب
   
 ويحلو المدح والتشبيب فيها ... وما هي لا سعاد ولا الرباب «»
  
 
   (وقوله) : (بسيط)
   
 مهاجري في الهوي من غير ما سبب ... ها قد جعلت دموع العين انصاري
   
 لءن قطعت عن الاجفان راتبها «» ... من الكري فلها من دمعها جاري»
  
 
   (وقوله) : (مخلع البسيط)
   
 ما هز اعطافه النسيم ... الا انثني قده القويم
   
 بدر له من ذءابتيه «» ... ليل ومن ثغره نجوم
   
 اذا تثني قده فغصن ... وان لوي جيده فريم
   
 ان كان جسمي به سقيما ... فان سقمي به جسيم «»
 /ب ومنهم:
 $  احمد بن شهاب البغدادي «»
 . وحكي شيخنا ابو الثناء الحلبي «» قال: جلس الي ابن البغدادي ثم اخذ ورقة وكتب فيها:
   وقوله: (خفيف)
   
 قد عرفنا الذهاب لا شك فيه ... فعن العود بعده خبراني
  
 
   
 هل تعود الارواح في الجسم ام بال ... عكس ام لا رجوع ام يرجعان
 ثم ناولتها «» فقطعت قوله: (يرجعان) ، واعطيتها له، واقتصرت عليها في جوابه، فبهت وسكت، كانما القمته حجرا.
 ومن محاسن شعره:
   قوله: (طويل)
   
 حججت اليه «» والعذول يحجني «» ... عليه فكان العذل رنة «» حادي «»
   
 فاحرقت لكن مقلتي سنة الكري ... وطفت ولكن حوله بودادي «»
   وقال:
 (بسيط)
   
 لو كان (شرب) «» حرام كالنبيذ له ... ريح لعز وجود الزاهد الصاحي
  
  
  
 
 /اومنهم:
 $  عبد الرحيم بن محمد بن يوسف السمهودي الخطيب «» :
 
 ذكره الاتفوهي «» وقال: قال: حضر الي بعض اصحابي وسالني ان امضي معه الي زوجته لاصلح بينهما، فمضيت معه، فشكت زوجته من سوء خلقه، وقالت: انظر ما فعل بي، ضربني وكسر معصمي، ثم كشفت عن معصم كانه البلور فقلت: (بسيط)
   «» وقوله: (بسيط)
   
 قالت وقد كشفت عن سر معصمها ... انظر الي فعل من قد جار وابتدعا
   
 فما رايت به للكسر من اثر ... بلي رايت عمود الصبح منصدعا
  
 
 /اومنهم:
 $  ابن دانيال:
 ورد «» في النوادر «» ، وشبل سريع البوادر «» ، الطف مذهبا من ابن حجاج «» واحسن مذهبا من ابي الزجاج «» ، بتنذير اعمرت من سدير
 
 بشار «» واقرب مما يعد الهبارية «» في قلب الاشهار. ولم ير مثله الهرواني في منامه، ولا نادم بمثله الحوراني علي مدامه، بسرعة جواب لا يعد قريعه «» القاضي ابن قريعه «» ، ولا فتح علي مثله (عينا) «» ، ابو
 
 العيناء «» اخلق معه ثوب ابي خليل مما يرقع، وسءم من سءال الادب مما يشنع. روي خبر طري، ونسي خبر ابي الشمقمق مع البحتري «» . وكان ممن
 
 يورده الملك الصالح «» ابن المنصور بوده، وجري علي هذا الطلق «» سلار «» من بعده، وله معهما حكايات مضحكة، ليس هذا موضع مجونها، ولا مجمع شجونها. وكان علي هذا ممن له صناعة في الكحل يد علي كل عين، وميل لو منا لاري به من فرسخين. كل هذا لطلاوة «» محاضره، واجوبة حاضره، وطب للبس الاجسام ملابس صحتها، وادب سلب الرياض اريج نفحتها.
 /ب  وحكي لي النقيب علي بن حمزة «» انه كان قد امر بقطع رواتب الناس من
  
 
 اللحم، فقطع لابن دانيال، ممن قطع، فدخل علي الملك الصالح وهو يتعارج، فقال: ما بك يا بن دانيال؟ فقال: قطع لحم، وكان هناك شاب قد جاء يشكو علي الناس انهم امسكوه وفعلوا به القبيح، فقال ذاك الشاب بالله جءت تشكو من قطع لحم، فقال له اي والله كما جءت تشكو من تقطيع تين «» ، فضحك الملك الصالح «» وكل من حضره.
   وحكي لي ان (حنا) «» اخا «» سلار كان قد حصل له رمد شديد فطلب سلار ابن دانيال وامره بملازمته ومعالجته، فلازمه حتي افاق، وركب ومشي، ولم يعط ابن دانيال شيءا، فاتي ابن دانيال الي مجلس سلار ودخل علي سبيل الاتفاق، فنظر سلار الي ابن دانيال وقال له: اين الخلعة «» ؟ قال: اي خلعة،
  
 
 فقال: اي شء اعطاك الامير واشار الي اخيه (حنا) ، فقال ابن دانيال:
   (وافر)
   
 اذا كان الامير اخا (ضنينا) «» ... فكيف تكون احوال الحكيم
 فضحك سلار ومن حضره، ولام اخاه، وقال له: مثل هذا ما يعامل هذه المعاملة، وامر له بالف درهم، اعطيت لابن دانيال
   وحكي ان ابن دانيال دخل مجلس الوزير ابن الخليلي «» فجلس الي جانب ابن المجبي البغدادي «» ، ثم اخرج من كمه منديلا فيه قرعة «» فقدمها لابن 
  
 
 البغدادي، فاخذها وشمها، ثم التفت الي ابن دانيال وقال: عثرك «» الله ما جيتها «» حتي صلحت «» بها عميرة «» ، فضحك من حضر، واستحيا ابن دانيال.
   وحكي انه لما ولي علم الدين سنجر «» الخياط ولاية القاهرة حضر الناس ليهنءوه، وابن دانيال فيهم، فاحضرت خلعته فلبسها وقام يتعمم، واكثر من وضع اصابعه علي لفات العمامة لاصلاحها وتعديلها فبقي كانه يفتش علي شء فقال ابن دانيال «» ...
 /اوحكي ان نصرانيا قطع زناره في مجلس فيه ابن سعيد «» ، فاقترح العمل في ذلك.
  
 
   «» فقال: (مديد)
   
 قطعوا زناره «» فغدا ... بعد جمع الشمل مفترقا
   
 اتراه حين بات علي ... خصره من رتبة قلقا
   
 سرق الخصر الخفي فقد «» ... بات مقطوعا بما سرقا
   فلما فرغت هذه الابيات سمع ابن دانيال قال: (رمل)
  
 
   
 حسدوا زناره في ضمه ... دونهم ما عا (ده) «» عنه سنين
   
 فغدا يشدو لدي اسلامه ... ارحموا من كان احظي العاشقين
 وقد يذكر الشء بمثله او بضده، وبهذا ذكرت قول حسن بن الانصاري المصري () :
   وقوله: (خفيف)
   
 شد زناره فلله ماذا ... حل فيه من كل معني لطيف
   
 قاد بين الكثيب والغصن حتي ... غرس الفسق «» في ضمير العفيف
 وحكي انه علق بهوي انحله، وامطره بسواكب دمعه حتي امحله، (فا) نشد عن حاله:
   «» فقال: (متقارب)
   
 محب غدا جسمه ناحلا «» ... يكاد لفرط الضني ان يذوبا
  
  
  
 
   
 ورق فلو حركته الصبا ... لصار نسيما وعادت قضيبا «»
 وحكي انه حضر مرة عند بعض الولاة، وقد احضر لص سرق فلما قدم الي الوالي اخرج يديه فاذا هما مقطوعتان، وجعل يقول: من لا له يد كيف يسرق؟!، فقال ابن دانيال:
   «» وقوله: (مجزوء الرجز)
   
 واقطع قلت له ... هل «» انت لص اوحد
   
 فقال هذي صنعة ... لم يبق لي فيها يد
  
 
 وحكي ان السراج الوراق «» شكا رمدا، ثم شفي، ثم عاوده حتي كاد يذهب نور /ب السراج وينطفء، فعاوده الشريف القدسي «» ، وقد شكا مثله رمدة كادت تذهب بعينيه «» فاعطاه ابن دانيال كحلا جلا سيف بصره، وقوي صحة نظره، فوصفه للسراج، ليستهدي منه نورا، ويحدث به لانسان عينه سرورا، فبعث الي ابن دانيال في طلبه، فجهز اليه به، فلما جلا اكثر رمده، ودنا بجفنه ان ينتضي مهنده: كتب اليه:
   وقوله: (مجزوء الكامل)
   
 يا واحدا في الجود لا ... يثنيه «» قول ثاني
   
 قد جدت لي باللءلء ... ي ثنه بالاصفهاني «»
 ثم كتب اليه بعده:
 مولاي حسبي من الوساءل طلبي الاصفهاني من الفاضل، فبعث اليه ابن دانيال به وكتب معه ليقرا عليه:
  
 
   «» وقوله: (خفيف)
   
 قل لعين الاماثل «» الاعيان «» ... وسواد الانسان «» للانسان «»
   
 يا سراجا «» اسني من الشمس والشم ... س سراج قد جاء في القران
   
 خذه كحلا مثل «» السيوف فريدا «» ... وصقالا يروق في الاجفان
   
 حجر «» كسرة احد من الاكس ... ر «» فعلا في العين او في العيان
   
 الف عين تقيمها حبة من ... ه قياسا يصح «» بالبرهان
   
 ان يعظم «» مثاله في حجاز ... كان هذا معظما في اصفهان
 فكتب اليه السراج حين تم له العافية والابتهاج:
  
 
   وقوله: (خفيف)
   
 ايها الفاضل «» الذي قصر الفا ... ضل عن صنعتيه «» والاصفهاني «»
   
 والذي تنشء الرياض علي مه ... رقه «» هاطلات تلك البنان
   
 وصلتني منهن باسمة الاز ... هار تفتر عن شبيب «» المعاني
  
 
   
 تتحف «» الروضة التي انا فيها ... بافانين الروح «» والريحان «»
   
 ويضاهي موارد «» النيل فيها ... كل صاف من ماء ذاك البنان
   
 ولدي قربها بخفة (ذي) «» العي ... ن فلله انت من انسان
   
 بان لي في فرندها الق «» الشم ... س الذي قد علا علي كيوان
   
 شمس فضل قد وافق الشرف الا ... علي «» قرينا اسعد بذاك القران «»
   
 فاضاءت مذاهبي بعد ما ال ... زمني الدهر موقف الحيران
   
 ولقد جءت قرة لعيون ... سلمت ان تعد في العميان
 وحكي: انه حضر مجلس الملك الصالح «» وحوله من الغلمان الاتراك شبيبة «» ، اختلفت قدودهم، وايتلف «» خدودهم، ونسبت اليهم ظباء
 
 رامة «» ، ونسبت الي لحاظهم كل ظلامة «» ، وكان فيهم من قده كانه الرمح في التقريب، ومن قصر وهو كانه الغصن الرطيب، ومنهما شباب معتدل القامة، زاد عليهما حسنا وابي ان يكون رمحا او غصنا، فقال له الملك الصالح: اي الثلاثة اعلق بقلبك، واليك «» بحبك:
   «» فقال: (طويل)
   
 ايا ساءلي عن قد محبوبي الذي ... فتنت به وجدا وتهت غراما «»
   
 راي قصر «» الاغصان ثم راي القنا ... طوالا فاضحي بين ذاك قواما
 وحكي انه كان بينه وبين الوطواط «» ما يكون بين الادباء، ولا يخلو منه
  
 
 داب «» بين الاحباء، فعرضت للوطواط رمدة تكدر بها صفيحه «» ، وتثني له فيها صريحة «» ، فقيل له: لو طلبت ابن دانيال، فقال: ذاك لا يسمح بذرة، يعني من كحله، فبلغ ابن دانيال،
   «» فقال: /ا (طويل)
   
 ولم اقطع الوطواط بخلا بكحله ... ولا انا من يعييه «» يوما تردد
   
 ولكنه ينبو «» عن الشمس طرفه ... وكيف به لي قدرة وهو ارمد
   ومن شعره: (كامل)
   
 ولرب قاءلة اما من رحلة ... تمشي وقد اعسرت منها موسرا
   
 سر كالهلال كماله في سيره ... والماء اعذب ما يكون اذا جراي
   
 فاجبتها سيري ومكثي واحد ... النحس نحس منجدا ومغورا
   
 ان المداءن وهي اوسع بقعة ... ضاقت علي فكيف ارحل للقري
  
 
   
 فلاصبرن علي الزمان وانني ... لاخو الشقاء صبرت ام لم اصبرا «»
   وقوله: (طويل)
   
 احمل شيبي صبغة بعد صبغة ... وصبغة رب العرش احسن صبغة
   
 وحاولت «» ان يخفي مشيبي فما اختفي ... ويكفيك اني كاذب خوف لحيتي
   وقوله: (خفيف)
   
 يا نديمي باكرا الخمارا ... واشرباها صهبا «» ء صرفا عقارا
   
 البستها الرهبان ثوبا من القا ... ر لان السواد يكسو القفارا
   «» وقوله: (وافر)
   
 بليت بضيق الانفاس قاس ... فدمعي وهو جار فيه جاري
  
  
  
 
   
 وكم في الارض من حسن ولكن ... عليك لشقوتي «» وقع اختياري
   «» وقوله: (وافر) /ا
   
 خفيت عن العيون «» فلن تراني ... وعشقك في الحقيقة قد براني «»
   
 عيانا ما اشاهد «» ام مناما ... لقد افسدت من وله «» عياني
   «» وقوله: (كامل)
   
 حيث اتجهت فلي اليك تطلع ... ولشمس وجهك في ضميري مطلع
   
 (يا) «» موضع «» الوجناء «» عندي لم يكن ... ابدا لغيرك في فءادي موضع
  
  
  
 
   
 ان كنت يممت الحجاز فمقلتي ... وادي العقيق «» ودمع عيني ينبع «»
   
 قد كنت احسب «» قبل تشييعي «» لكم ... اني لقلبي في الحمول «» اشيع
   
 تبدو البلاقع «» منكم ماهولة ... ودياركم لما رحلتم بلقع
   وقوله: (كامل)
   
 لو لم يكن قلبي بحبك مبتلي ... ما بات طرفي بالسهاد موكلا
   
 يا من اطعت له الغرام تولها ... وعصيت من وجدي عليه العذلا
   
 انظر تري ربع المسرة ما خلا ... يا هاجري والعيش بعدك ما حلا
   
 انت الذي اكدت اسباب الهوي ... وتركتني بعد المودة مهملا
   
 وجعلت ما بين التواصل فترة ... وبعثت دمعي للعواذل مرسلا
   
 ويلاه «» من وجدي عليك واه من ... شوقي اليك فقلت لم لا تفعلا «»
   
 ما ضر لو احييتني بتحية ... او ان تمنيني الوصال تعللا «»
  
 
   
 امعذبي بدلاله وملاله ... امنت مثلي بالجفا ان يبتلي
   
 يا ساءلي عن حبه في حيه «» ... ونحول جسمي والضنا يكفي البلا
   «» وقوله: (مجزوء الرجز)
   
 لا ودخان المشعل ... وضوءه المشتعل «»
   
 يزهي «» بنار رفعت «» ... مثل اللواء المسبل «»
   
 مشاعل «» كانها ... لينوفر «» ذو خصل «»
   
 وكم هدتنا تاءها ... في جنح ليل اليل
   
 هذا وكم حش نزح ... نا ارضه بالمعول
   
 ففعلنا في جوفه ... فعل دواء المسهل «»
   
 صنعتنا محمودة ... وهو كبطن ممتلي «»
  
 
   
 وكم نقمنا لحدود «» ... الله من ذي الحيل
   
 تدب «» مثل النمل في ... البيت علي تمهل
   
 من كل لص طارق «» ... مثل البلاء النازل
   
 ادخل في الضيق بها ... من نفس متصل «»
   
 حتي اذا ما زل ذي ... ل ستره المنسدل «»
   
 تمسكه فيغتدي ... كالفرس المشكل»
   وقوله: (مجزوء الخفيف)
   
 اين من كان ايره ... قاءما يملا الفضا
   
 لا يري رد ساءل ... رحم الله من مضي
   وقوله: (خفيف)
   
 قل لغصن الاراك ويحك تحكي ... قد محبوبتي «» ولم تخش مني
  
 
   
 انا لولا غفلت عنها فماست «» ... ما تعلمت انت منها التثني
   «» /اوقوله: (خفيف)
   
 كل صعب علي رضاكم يهون ... وجفوني بمن هويت جنون «»
   
 يعجب الصبر من تصبر «» قلبي ... واحتمالي فما «» راته العيون
   
 جلدي مفرم بتمزيق جلدي «» ... وجفوني لها السيوف «» جفون «»
   «» وقوله: (طويل)
   
 ايا ساءلي عن قد محبوبي الذي ... به همت وجدا في الهوي وغراما «»
   
 ابي قصر الاغصان ثم راي القنا ... طوالا فاضحي بين ذاك قواما
  
  
 
   «» وقوله: (طويل)
   
 عجبت وشان الحب غير عجيب ... اذا مات بالاشواق كل غريب
   
 تباعدت الاجسام منا وانما ... لنا جامع من تربة وقلوب «»
   
 لنا كل يوم منزل نزعة النوي «» ... وقرب خليط «» وهو غير قريب «»
   
 كاني من كل البلاد فمدمعي ... علي كل باد او فراق حبيب «»
   
 علي انني لولا اغترابي لم اطب «» ... وما عاقل في بلدة بغريب
   «» وقوله: (خفيف)
   
 كل حي الي الممات يصير ... ما له ساعة النزاع «» نظير «»
   
 والسعيد الذي يري طرق الرش ... د بعين اليقين وهو بصير
  
  
 
   ومن نثره:
 وما هذا من اهل الملام «» ، وما لجرح بميت بايلام «» ؛ لانه شيخ كبير، واحول بنصف ضرير «» ، قد بلغ من التغفل والنسيان الي غاية صار بها حمارا في صورة انسان.
   /ب وقوله يصف امراة قبيحة:
 من الدواهي «» بانف كانف الحمل «» ، وشفاتير «» مثل شفاتير الجمل، باجفان مكحلة بالعمش «» ، وخدود مضمخة بالنمش «» واسنان مثل اسنان 
  
 
 المفتاح، ونكهة «» تفوح من المستراح.
   وقوله:
 وقد بحث بلسانه في الطبيعة بحثا شافيا «» حتي علم ان الياقوت من الجزع «» ، وان القرطم «» من الطلع، وان الخل من النارنج، وان القطاءف «» من الاسفنج «» ، وان الشمع من الشحم، وان الزفت من الفحم، وان الحرير من الارجوان، وان السمسم من الباذنجان، فهو اول ناقل عن باقل «» ، واحسن من محا نوادر جحا «» ، اجهل من تولس، واشام من طولس. فله من الحمار اذنه،
  
 
 ومن التيس ذهنه، ومن الثور قرنه، فما يفرق بين الخشب والقصب، ولا يميز بين الفضة والذهب، ولا يعرف النار الا باحراقها، ولا السلحة «» الا بمذاقها. ولو ختموا جانب الكنيف به ما قربته بنات وردان «» . طالما تشمس بالقمر، وتعشي في السحر، وفتح رجليه لسقوط الكواكب، وعلم زيادة النيل في ظهور المراكب، يمضغ «» من اللقمة قطعة من لسانه، ويءذن ثم يمشي ليسمع اين بلغ طرف اذانه، ينام وهو قاءم، ويمشي وهو ناءم.
   «» وقال ملغزا في السر موزة «» : (طويل)
   
 وجارية هيفاء قمشوقة القد ... لها وجنة ابهي احمرارا من الورد
   
 من اليمنيات «» التي حر «» وجهها ... يفوق صقالا صفحة الصارم الهندي
  
 
   
 وثيقة حبل الوصل منذ وطءتها ... فلست اراه قط منتقض «» العهد
   
 ومن عجب «» اني اذا ما وطءتها ... تءن انينا دونه انة الوجد «»
 
 /اومنهم:
 $  الشريف ابن الضياء القناوي:
 وهو تقي الدين ابو عبد الله محمد بن جعفر ابن محمد بن عبد الرحيم الحسيني، وهو من ولد جعفر الصادق رضي الله عنه:
 حدثني عنه الاديب ابن نباته «» ، واراني انباته «» . وشعره ناطق بمبلغ فضله، ومستودع ورده العذب وظله، ينطق بلسان فصيح، وبيان صحيح، واحسان. /ب لا غرو ان يجري فيه جواده علي اعراقه «» ، ويباهي في مصره نسيبه الرضي «» في عراقه.
 ومن شعره مما انشدني في شيخ مطيلس «» :
 
   «» قوله: (مجزوء الرجز)
   
 يا من راي الشيخ الذي ... كالعين اذ نعرفه
   
 وظهرها حديثه ... وراسها رفرفه «»
   وله في الشقيق: (متقارب)
   
 اتتك الشقيقة في نكتة «» ... ولون يدل بحسن غريب
  
  
 
   
 كخال باسفل خد المليح ... وكالشمس عند ابتداء الغروب 
 /اومنهم:
 $  شافع بن علي بن عباس الكاتب: ناصر الدين ابو علي
 قريب مني عند الظاهر، ونسيب ذلك العنصر الطاهر، كان من اعيان كتاب الانشاء، والمستقي «» من قليب لا يحتاج الي طول الرثاء، ثم اصيب بسهم وقع في عينه فاذهب نورها، واطبق عليها من الاجفان بثورها «» .
 
 والنظم اكثر بضاعته، واكبر صناعته. وكتب الي وانا بمصر، ولم يقدر لي به اجتماع، وانما اروي عنه ما كان «»
   ومنه شعره قوله: (طويل)
   
 عهدت لانعام الملوك تنوعا «» ... اذا «» لجميل القصد من برها تجري
   
 فما نالهم في ذا الزمان تسافل «» ... الي ان غدوا بخلا كسيحون «» في الجر
   «» وقوله: (في الوطواط الكتبي) «» (خفيف)
   
 كم علي درهم يلوح حراما ... يا لءيم الطباع سرا تواطي «»
   
 داءما في الظلام تمشي مع النا ... س وهذي عواءد الوطواط «»
  
  
 
   «» وقوله فيه (اي الوطواط) (سريع)
   
 قالوا تري الوطواط في شدة ... من تعب الكد وفي ويل
   
 فقلت هذا دابه داءما ... يسعي من الليل الي الليل
   وقوله: (مخلع البسيط)
   
 عابوا علي الظاهر احتفالا ... بزتك سبع به يراع
   
 فقلت كفوا ولا تعيبوا ... من بعده غابت السباع
   قلت «» لي مثل هذا في امراة اسمها غزالة، صار لها شان وشفاعة مقبولة:
 (وافر)
   
 رايت غزالة مهما ارادت ... من الاشياء كان بلا محاله
 /ب
   
 لقد غابت سباع الحي عنا ... فلا عجب اذا لعبت غزاله
 عدنا الي شعره ومنه:
  
  
 
   قوله: (كامل)
   
 وافي رياءك مبدعا اقوالا ... ومحققا بعزاءه اثقالا
   
 ونعيته «» فنعيته «» بمحاسن ... او ضحت فيها من علاه خصالا «»
   وقوله: (كامل)
   
 ان البطاركة «» الذين تصرمت «» ... نيران موطءهم علي الاحداق
   
 خرقوا «» شريعة «» هدنة عمرية ... فجزوا علي الاخراق «» بالاخراق
  
  
 
   وقوله: (مجزوء الرجز)
   
 من بعد اهل القلع «» ... هجرت طيب المضجع
   
 وجدت «» فيه بالذي ... املكه من ادمعي
   
 قوم لهم في خاطري ... اغلي واعلي موضع
   
 اني اتجهت لم يزل ... حديثهم معي معي
   وقوله: (طويل)
   
 اهيل النقا كدرتم العيش فاعطفوا ... ولا تجعلوا سلم الوداد بكم حربا
   
 الي كم اقاسي لوعة «» في هواكم ... ولا ذنب الا ان شغفت بكم حبا «»
   
 الا ترحموا «» ان تحرموا الصب زورة ... وانتم كما شاء الولاء ذوو القربي
   
 تري تجمع الايام بيني وبينكم ... واشفي فءادي ان ظفرت بكم عتبا
   وقوله: (بسيط)
   
 قالوا نري ابن فلان الدين ذا غلط ... كانه من جبال الصم منحوت
  
  
 
 /ا
   
 قلت اما قد غدا للقوت «» يخزنه ... وخازن القوت فيما قيل ممقوت
   وقوله: (طويل)
   
 اشاد «» بجسمي اخذا منه سوسه «» ... رفيق «» بها من جدة «» العمر يءيس
   
 فقلت اما اصبحت كالغصن ذاويا ... وذاوي غصون الدوح حقا يسوس «»
   وقوله: (سريع)
   
 سالت من اعجبني جرمه «» ... في بثه «» الاقوال والافعالا
   
 فقلت ما وضعك يا ذا الفتي ... فلم يجبني بسوي لا لا
  
  
  
 
   وقوله: (كامل)
   
 ويلاه من حزني عليه وانه ... حزن طويل «» ما له من اخر
   
 قد كان تم براعة وبلاغة ... والبدر ينقص في التمام الباهر
   
 مولاي عز اباه فيه فانه ... اولي بها من غاءب (او حاضر) «»
   
 واندبه عند ضريحه متفضلا ... واذكر له فعل الزمان الغادر
 قد مات ملء الصدر وانقطعت الي ... او طان
  ................ 
 .. «»
   وقوله: (طويل)
   
 تشوقت للاهرام «» من عظم «» وصفها ... واعجاب ما ابداه في وصفها الشعر
   
 فصرت اليها كي احقق خبرها ... فلما التقينا صغر الخبر الخبر «»
  
  
 
   وقوله: (مجنث)
   
 لدمع عيني تراكم «» ... اذ فاتها ان تراكم «»
   
 عودوا «» وعودوا «» عليلا ... اضناه طول جفاكم
 /ب
   
 لا تحسبوا ان قلبي ... والله يهوي سواكم
   
 رقوا علي ومنوا «» ... ولو بلثم ثراكم
 ومن نثره وهو اقل صناعته، واكسد بضاعته
   قوله:
 وهو فتح قلعة، المتينة «» الاسباب «» ، المتوارية من اسوارها ما منع حجاب، الشامخ علي السحب انف تساميها، الفاءت «» النجوم بما او تيته من تباهيها «» ، الا الله سبحانه اذلها الي ان قبلت «» بين يدي ركابنا الشريف 
  
 
 الثري. واراك معالمه «» بثباتنا «» وو ثباتنا «» . الي ان اصبحت خاوية علي عروشها «» ، فلا اذن تسمع، ولا عين تري، فاحدقنا بها «» احداق الخاتم بالخنصر «» ، والدملج بالساعد، وحسبنا بالمواياه «» الغرض في خصرها من شاهد، فلم يزل يراوحها «» بالعزاءم «» ويغاديها «» ، ويسمعها الصرخة فالصرخة بالسنة المجانيق «» تناديها، الي ان ازلنا بتكاتف «» الستاءر «» استارها، وتسورنا اسوارها، وهتكنا حريمها، واسترققنا «» جريمها «» فلياخذ حظه من البشري، وليقدر لها حقها بالسجود لله حمدا وشكرا.
 
   وقوله:
 فبادرنا القوم واحطنا بهم احاطة الداءرة بقطبها «» ، والاجفان بهدبها، واخذت السيوف حظها منهم لا منا، ونهبت الارماح لحومهم، والسبب «» ...
 فيهم سنا، ولم تدع منهم من لاذ بالفرار حتي ادركناه، ولا معلا «» غرته العافية بزعمه حتي رغمه اهلكناه.
   وقوله معارضا لتاج الدين ابن الاثير «» في منشور»
 صاحب كان معتقلا 
  
 
 واطلق وهو:
 وما احق وصف مناقبه «» بالاطياب «» ، واجلها من صحف تحويله «» بمحل الاعجاب، وابهر «» انواره الشمسية لولا اكتساءه برقيق غيم التعويق والحجاب، كم قضت ادابه لاولياء الدولة بالواجب، وكم رايت /اوجوهها باسفار ... «» واما الذي قاله ابن الاثير فمنه قوله:
 وكان فلان ممن قضي من حقوق الوفاء للسلف واجبا، وحل من الدولة محل العين، وان سمي حاجبا «» .
   عدنا الي قول ابي «» شافع، ومنه في ذكر وفاء النيل «» :
 والذي ينهيه «» لعلمه ان الله سبحانه من بنعمته في مجري النيل وكم به من، وجاد بوابله وطله كما في الظن وما ضن «» ، وزادا الي ان ملا اوطابه بما
  
 
 يحسن تاثيره من زاد، وبدا بالرحمة واعاد، ووفي بميعاده، ان الله لا يخلف الميعاد «» ، فلو راه سيدنا وقد طفا «» ونهج «» ، وجاء بالرجاء ورجج «» وبلغت اياديه النافعة الباقعة «» فوق امكانها، وامنت الامة في اوان الاحتياج وما احسن الاشياء في اوانها.. الصامت الناطق، الفاءق «» الراءق «» ، العامل المعمول، الناقل المنقول، الكافل «» المكفول، الباذل المبذول، قد اتسقت «» عقود تاثيراته مع تناقص هذه الاحوال، وامن علي صدق عزاءمه مع تغاير هذه الاقوال. ان عجل لا يكبو «» ، وان صوفحت الصفاءح لا ينبو «» يجري جواد تجويده ما وجد من الطرس ارضا، ويجول في ميدانها بمبدع التنميق «» طولا وعرضا.
 
   وقوله:
 قد جعل الله العلماء ورثة الانبياء كما ورد. واوضحوا المذاهب «» المذهبة، والحقوق التي هي للاماطيل «» مذهبة «» ، كالامام الشافعي رضي الله عنه «» ؛ فانه قام «» الشريعة المحمدية اتم قيام، وشهر «» لها بذكره، وذكره «» وذوو الساسي «» من الناس نيام واوي بني القلم الشريف من تاليفه الي احني ام واشفقها، وارفدها وارفقها، وادرها للعلم ضرعا، واخصبها مرعي، واتمها /ب عقلا وشرعا. وكانت مصر قد شرفت «» منه باشرف نزيل، واجل خليل، واقام الي ان حارحا تقي «» ويصيد، ويبدي ويعيد، 
 
 ويقمع «» المريد «» ، ويمد المريد «» ، ويجلس بجامع عمر «» بن العاص، الذي هو كما نعت [تاج الجوامع] «» ويحل منه باشرف المرابع «» وهو راويه الكريم منسحب عليها، وهلم جرا. ونسبتها اليه مستمرة، وبه اعلي الله بها قدرا، فلهذا لا يحل بصدرها الا من العقد علي اهليه «» الاجتماع، ومن اذا بحثت في مسالة من مساءله هز الاعطاف وشنف الاسماع، ومن درب «»
 
 ودرب «» واعرب «» واعرب «» . وكان فلان قد اخذ من مذهب هذا الامام بنصيب واي نصيب، وانصف «» من اراءه، وكانت كلها صاءبة بالراي المصيب، وافني عمره علي طول شقته «» في العلم، وتحصيل فنونه، وحيازة ابكاره وعونه، فقوبلت جلالة قدره بما يجب لها من هذه المنزلة، حتي حل اكثر منها واجلها، وولي وكانوا احق بها واهلها.
   وقوله:
 صدرت معلمة «» بصحة المزاج الفلاني من الالباب الذي حمت له الارواح، وحق لها ان تحم، وضمت الجوارح علي مثل جمر الغضا «» ، ويعذرها ان تضم. هذا علي خفة زورتها «» ، وضالة زورتها، ولكنها ثقلت علي القلوب، وان خفت وعفت «» معالم الاجسام، وان عفت «» ، واو كفت «» الدموع وان
  
 
 كفت «» ، الا انها والحمد لله ما المت «» حتي اقلعت، ولا سلمت حتي ودعت وجاءت الصحة، ووافت «» المحنة «» ، واذهب الباس «» رب الناس وسر حتي سرير الملك، وقد افترش صهوة صحته، وابتهل سرير التمرض «» ، اذا كان الانفصال علي خير من فرش فرشته.
 فالحياة ساجدة، والالسنة في شكر النعمة جاهدة، والاعين قريرة، والقلوب مسرورة. /اوالصدور منشرحة «» والخواطر «» منفسحة، وعقود التهاني منسقة، واعنة الجياد بيمين اليمن مطلقة، واركان المعاهد مخلقة ولا اقول وغير مخلقة «» .
 
 /ب ومنهم:
 $  ابن الجباس الدمياطي: وهو احمد بن منصور بن اسطوراس:
 
 خطيب الورادة «» من منازل الرمل، وكان يتردد الي، ويتجدد عرض ما عنده علي، وكان قليل الماده، جميل الجاده «» ، يظفر «» بمحبات المعاني، ويكسيها «» في اجل المعاني «» ، وكان كافا للسانه، مظهرا لاحسانه، مقبلا علي شانه، فما اهمه لا يعلق (به) «» مذمة.
 وقصيدته التي وصف فيها الموز لا تطاول «» ذيولها، ولا تعارض سيولها، ابدع فيها كل الابداع، وابعد منها الابتداع «» ومن المختار منها:
   «» قوله: (منسرح)
   
 كانما الموز في عراجنه «» ... وقد بدا يانعا علي شجره
  
 
   
 فروع «» شعر براس غانية ... عقصن «» من بعد ضم منتشره «»
   
 كان من ضمه وعقصه ... ارسل شرابة «» علي اثره «»
   
 وفي اعتدال الخريف احسن ما ... يرقل مثل الرداح «» في ازره «» «»
   
 كان اشجاره وقد نشرت ... ظلال اوراقه «» علي ثمره
 
   
 حاملة طفلها علي يدها ... تظله «» بالخمار من شعره
   
 كانما ساقه الصقيل وقد ... بدت عليه نقوش معتبره «»
   
 ساق عروس اميط «» مءزرها ... فبان وشء الخضاب في حبره «» «»
   
 تصاغ من جدول خلاخلها ... فينجلي «» والنثار من زهره
   
 حداءق خفقت «» سناجقها ... كانه «» الجيش ام في زمره
   
 زها «» فراق العيون منظره ... فما تمل العيون من نظره
 
   
 وكل اياته فباهرة «» ... تبين في ورده وفي صدره
 /ا
   
 كانما عمره القصير حكي ... زمان وصل الحبيب في قصره
   
 كان عرجونه المشيب اتي ... يخبر ان خانه انقضا عمره
   
 كانه البدر في الكمال وقد ... اصيب بالخسف في سنا قمره
   
 كانه بعد قطعه وقد اصف ... ر لما نال من اذي حجره «»
   
 متيم قد اذابه كمد ... يبيت من وجده علي خطره «»
   
 معلق بالرجاء ظاهره ... يخبر عما اجن «» من خبره «»
   
 يطيب ريحا ويستلذ جني ... علي اذي زاد فوق مصطبره «»
   
 كانه الحر حال محنته «» ... يزيد «» صبرا علي اذي ضرره
 
   «» وقوله وقد اصم «» : (مجزوء الكامل)
   
 ان قل سمعي ان لي ... فهما يوفر «» منه قسم
   
 يدني الي مقاصدي ... ويروقك الرمح الاصم «»
   
 ولرب ذي سمع بعي ... د الفهم عي «» النطق فدم «»
   
 زادوا علي عيب التصا ... مم انهم صم وبكم «»
   «» وقوله في رمانة: (كامل)
   
 كتمت هوي قد لج «» في اشجانها ... وحشت حشاها من لظي نيرانها
  
  
 
   
 فتشققت من حبها عن حبها ... وجدا وقد ابدي خفا «» كتمانها
   
 رمانة ترمي لها ايدي الندي ... من بعد ما رمت «» علي اغصانها
   
 فاعجب وقد بكت الدموع عقاءقا «» ... لا من محاجرها «» ولا اغصانها «»
 /ب ومنهم:
 $  محمد بن محمد المعروف بابن الحبلي «» الفرجوطي:
 انشد له الاتفوهي قوله:
 
   «»
   
 انظر الي النبق «» في الاغصان منتظما ... والشمس «» قد شرعت «» تجلوه في القضب
   
 تراه فيما تراه من تصوره ... يحكي جلاجل «» قد صيغت من الذهب
  
 
 /ا
 $  ومنهم «» ممن هو من ادباء هذا الزمان، ونادرة هذا العصر والاوان الشيخ عز الدين ابن الموصلي
 ناظر الفاظ تغني عن الحلل والحلي، يهيم للاسحار بعذوبة اشعاره البديعه، ويخطف الابصار ببوارق تبيهته السريعه، يتيم درر مبتكره، ونافث سحر ببيان يبطل به كيد السحره (يعاهد) للصنعة اللطيفه، وياتي في معانيها بكل لمعة ظريفه، بقريحة «» اينعت بالتريض، وروية روت وروت «» ، فهذا الراكب لغير البحر الطويل العريض، يسلك البديع والقوافي مطلقه، فيمطر صيب ادب اغدق من السحاءب الغدقه «» علي انه لم يشغل دابه من هذه الفنون، وطلقها من ذهنه (للافرقتا) علي سبيل المجون، بل انما هو من اهل العلماء شريف، واللغة والتصريف، وله في التفسير اياد، وما يحتاج اليه فيه يشهد له اتقانه للحاضر والبادي، وله الرحلة في الحديث المنور، والمحبة في البيت المعمر (يشكر بهرله) ريقه التي حلت بالفضاءل، ولهذا ما شهدت له بان ليس
 
 له مماثل، (نبرامعي) كشف له من العلوم اللدنية «» ، والمناهج السنيه، وهو لعمر «» اكثر من الوصف، ونهج الفاظه تعذب المدام، ويكد الوصف.
 /اومنهم:
 $  محمد بن محمد بن محمد بن نباتة جمال الدين «»
 
   «» /ب وقوله: (طويل)
   
 صحا القلب لولا نسمة تتخطر ... ولمعة برق بالفضا تتسعر
   
 وذكر جبين المالكية ان بدا ... هلال الدجي والشء بالشء يذكر
   
 سقي الله اكناف الغضا «» سبل «» الحيا «» ... وان كنت اسقي ادمعا تتحدر
  
 
   
 وعيشا نضا عنه الزمان بياضه ... وخلفه في الراس يزهي «» ويزهر
   
 تغير ذاك اللدن مع «» من احبه ... (ومن ذا الذي لا يعز لا يتغير)
   
 وكان الصبا ليلا وكنت كحالم ... فيا اسفي والشيب كالصبح يسفر «»
   
 يعللني «» تحت العمامة «» كتمه ... فيعتاد قلبي حسرة حين احسر «»
   
 وينكرني ليلي وما خلت انه ... اذا وضع المرء العمامة ينكر
   
 الا في سبيل الله صوم عن الصبا ... وقلب علي عهد الحسان يفطر «»
   
 تذكرت ايام الوصال «» فاشهب ... من الدمع في ميدان خدي واحمر
   
 اذا لم تفض عيني العقيق «» فلا رات ... منازله «» بالوصل تبهي وتبهر
   
 وان لم تواصل غادة السفح «» مقلتي ... فلا عادها عيش بمغناه «» اخضر
 
   
 ليالي تجني «» الحسن في اوجه الدمي ... وتجني «» علي اجسامها حين تنظر
   
 يءثر في خد المليحة لحظها ... وان كان في ميثاقها «» لا يءثر
   
 رايت الصبا مما يكفر «» للفتي ... ذنوبا اذا كان المشيب يكفر «»
   
 اذا حل مبيض المشيب بعارض «» ... فما هو الا للمدامع ممطر
   
 كاني لم اتبع صبا وصبابة ... خليع العدار «» حيث ما همت اعذر
   
 ولم اطرق «» الحي الخصيب زمانه ... يقابلني زهر «» لديك ومزهر «»
 /ا
   
 وغيداء «» اما جفنها فمءنث ... كليل «» واما لحظها فمذكر
   
 يروقك جمع الحسن «» في لحظاتها ... علي انه بالطرف جمع مكسر «»
   
 من الغيد تحتف «» الظبا لحجابها «» ... ولكنها كالبدر في الماء يظهر
   
 يشف وراء «» الحشر فية خدها ... كما شف من دون الزجاجة مسكر
   
 ولا عيب فيها غير سحر جونها ... واحبب بها سحارة حين تسحر
 
   
 اذا جردت من بردها فهي عبلة «» ... وان جردت الحاظها فهي عنتر
 «»
   
 اذا خطرت في الروض طاب كلاهما ... فلم يدر من ازهي واشهي واعطر
   
 خليلي كم روض نزلت فناءه «» ... وفيه ربيع للنزيل وجعفر
   
 وفارقته والطير صافر «» به «» ... وكم مثلها فارقتها وهي تصفر «»
   
 الي اعين بالماء نضاخة «» الصفا ... اذا سد فيها منخر «» جاش «» منخر
   
 نداماي من خود «» وراح وفتية «» ... (ثلاث شخوص كاعبان ومعصر «» )
   
 قضيت لبانات الشبيبة والهوي ... وطولت حتي ان «» اني اقصر
 
   
 ورب طموح «» العزم ادماء «» جسرة «» ... يظل بها عزمي علي البيد يجسر
   
 طوت بذراعي وخدها «» شقة «» الفلا ... ونجم الثريا «» في دجي الليل يشبر «»
   
 ومد جناحي ظلها الق الضحي ... فشدت كما شد «» النعام المنفر «»
   
 بصم الحصي ترمي الحداة كانما ... تغار علي محبوبها حين يذكر
   
 اذا ما حروف العين خطت بقفرة ... غدت موضع العنوان والعيش اسطر
   
 فلله حرف «» لا ترام كانها ... لو سك السري حرف «» لدي البيد مضمر
   
 تخطت بنا روض الشام الي حمي ... به روضة ريا الجنان ومنبر
 /ب
   
 الي حرم الامن المنيع جواره ... اذا ظلت الاصوات بالروع تجار «»
   
 الي من هو التبر الخلاص لناقد ... غداة الثنا والصفوة المتحير
   
 نبي اتم الله صورة فخره ... وادم في فخاره يتصور
   
 نظيم العلا والافق ما مد طرسه ... ولا فقر «» الزهر الكواكب ينثر
 
   
 ولا لعصا الجوزاء في الشهب اية ... تجر «» الدجي من تحتها يتفجر
   
 نبي له مجد قديم وسءدد ... صميم «» واخبار تجل ومخبر «»
   
 تحزم «» جبريل لخدمة وحيه ... واقبل عيسي بالبشارة يجهر «»
   
 فمن ذا يضاهيه «» وجبريل خادم ... لمقدمه الغالي وعيسي مبشر
   
 تهاوي لماتاه «» النجوم كانما ... تشافه بالخد الثري وتعفر «»
   
 وينضب «» طام «» من بحيرة ساوة «» ... ولم لا وقد وافت بكفيه ابحر
   
 نبي له الحوضان هذا اصابع ... تفيض وهذا في القيامة كوثر «»
   
 وعن جاهه الناران هذي بفارس «» ... تبوخ «» وهذي في غد حين تحشر
 
   
 اذا ما تشفعنا «» به كف غيظها ... وقالت عبارات الصراط لنا اعبروا
   
 تنقل نورا بين اصلاب «» سادة ... فلله منه في سما «» الفضل نير «»
   
 به ايد الطهر الخليلي «» فانتحت «» ... يداه علي الاصنام «» تغزو وتكسر
   
 ومن اجله جء الذبيحان بالفدا ... وصين دم «» بين الدماء مطهر
   
 ولما اراد الله اظهار دينه ... بدا قمرا والشرك «» كالليل يكفر
   
 فجلي الدجي واستوثق الدين واضحا ... وقام بنصر الله داع مظفر
   
 مخوف «» السطا «» بالرعب ينصر والظبا ... وداني الحيا في اليسر والعسر يهمر
 
 /ا
   
 عزاءم من لا يختشي «» يوم غزوه ... ردي وعطا من ليس للفقر يحذر
   
 علا عن محاكاة «» الغمام بفضله ... وكيف يحاكيه الخديم «» المسخر
   
 تظلله «» وقت المسير وتارة ... يشير اليها بالبنان فتمطر
   
 الم تر ان القظر في الغيم فارس ... اذا برزت الاءه «» يتقطر «»
   
 هو البحر فياض الموارد للوري ... ولكنه العذب الذي لا يكدر
   
 فمن لي بلفظ جوهري قصاءد ... تنظم حتي يمدح «» البحر جوهر
   
 وهيهات ان تحصي بتقدير مادح ... مناقب في الذكر الحكيم تقرر «»
   
 اذا شعراء الذكر قامت بمدحه ... فما قدر ما تنشي الانام وتشعر «»
   
 نبي زكا «» اصلا وفرعا واقبلت ... اليه اصول في الثري تتجرر
   
 وخاطبه وحش المهامه «» انسا ... اليه وما عن ذلك الحسن ينفر «»
 
   
 له راحة فيها علي الباس والندي ... دلاءل حق في الجهاد «» تءثر
   
 فبينا العصا فيها وريق «» قضيبها ... اذا هو مشحوذ «» الغرارين «» ابتر «»
   
 كذا فلتكن في شكرها وصفاتها ... يد بين اوصاف البنين تشكر
   
 سخت ومحت شكوي قتادة «» فاغتدت ... بها العين تجري «» او بها العين تخبر
   
 لعمري لقد سادت صفات محمد ... كذاك النجوم الزاهرات تسير
   
 اري معجز الرسل انطوي «» بانطواءهم ... ومعجزه حتي القيامة ينشر 
   
 كبير فخار الذكر في الخلق كل ما ... تلا قارء او قيل الله اكبر
   
 هو المرتقي السبع الطباق «» الي مدي ... لجبريل «» عنه موقف متاخر
   
 هو الثابت العليا علي كل مرسل ... بحيث له في حضرة «» القدس محضر
 
 /ب
   
 هو المصطفي والمقتفي «» لا مناره ... يحط ولا انواره تتكور «»
   
 اليك رسول الله مدت مطالبي ... علي انها اضحت علي الغور «» تقصر
   
 خلقت شفيعا «» للانام مشفعا ... فرجواك في الدارين اجدي «» واجدر «»
   
 ولي حالتا دنيا واخري اراهما ... يمران بي في عيشة تتمرد «»
   
 حياة ولكن بين ذل وغربة ... فلا العز يستحلي «» ولا البين يفتر «»
   
 وعزم علي الاخري يهم «» نهوضه ... ولكنه بالذنب كالظهر موقر «»
   
 تصبرت في هذا وذاك كانني ... من العجز والبءسي «» قتيل مصبر
   
 وها انا قد بلغت «» عذري قاصدا ... وايقنت ان النجح لا يتعذر
 
   
 عليك سلام الله في كل منزل ... تعبر «» عن سر الجنان وتعبر
   
 والك والصحب الذين عليهم ... تحل «» حبي «» مدح ويعقد خنصر
   
 بجاهك عند الله اقبلت لاءذا «» ... فكثرت حاجاتي وجاهك «» اكثر
   
 ونظمت شعري فيك تزهي قصيدة ... علي كل ذي «» بيت من الشعر يعمر «»
   
 معظمة المعني تكرر «» لفظها ... فيحلو نباتي «» الكلام المكرر
   
 دنت عن صفات الفضل منك وانها ... لتفضل ما قالته طي وبحتر «»
   
 وما ضرها اذ كان نشر نسيمها ... رخاء «» اذا ما لم يكن فيه صرصر «»
   «» وقوله: (كامل)
  
 
   
 حمت الخدود بناظر فتان ... او ما سمعت شقاءق النعمان «»
   
 وتبسمت من لءلء متمتع «» ... تبكي العيون عليه بالمرجان
   
 غيداء استجلي البدور لوجهها ... اذ ليس خظي منه غير عيان
 /ا
   
 تركية للقان «» ينسب خدها ... وا صبوتي منها بخد قان
   
 خد يريك تنعما بتلهب «» ... يا من راي الجنات في النيران
   
 ومحاسن تزهي «» وتخلف عهدها ... وكذا يكون الروض ذا الوان
   
 كالجنة الزهراء الا ان لي ... من ادمعي فيها حميما «» ان «»
   
 ترنو لواحظها علي عشاقها «» ... فتصول بالاسياف في الاجفان
 
   
 ويهز حلو قوامها مرح «» الصبا ... هز الكماة عوالي «» المران
   
 ان صدها عني المشيب فطالما ... عطفت شماءلها بما ارضاني
   
 وبلغت مالا سولته «» شبيبتي ... وفعلت مالا ظنه شيطاني
   
 وجنيت من ثمر الذنوب تعمدا ... لما رايت العفو حظ الجاني
   
 وحلبت هذا الدهر اشطر «» عيشه ... فوجدت زبدتها متاعا «» فاني «»
   
 ملك ترنحت «» المنابر باسمه ... حتي ادكرن معاهد الاغصان
   
 بادي الوقار اذا احتبي وحبا الندي ... ابصرت سير السيل من ثهلان «»
   
 قامت بسءدده ماثر بيته ... وعلي العماد اقامة البنيان
   
 قسما بمن اعلي واعلن مجده ... وافاض انعمه بكل مكان
   
 ما حاد عني «» الفقر حتي صحت في ... مدحي انا بالله والسلطان
 
   
 فوجدت للنعماء «» ملء ماربي «» ... ووجدت للاوصاف ملء لساني
   
 ومدحت من نشرت مداءح مجده ... ذكري فلو لم يعطني لكفاني
   
 ملكا ابر «» علي الاولي متاخرا ... عنهم كبسم الله والعنوان «»
   
 تعب الانامل «» لا يغب نواله ... ان العلي والمجد للتعبان «»
 /ب
   
 اعطي وقد منع الغمام وارشدت ... اراءه والنجم كالحيران
   
 واعتادت الهيجاء منه غضنفرا «» ... سار من اليزني في خفان «»
   
 تتالف «» العقبان «» فوق رماحه ... الف الحمام علي فروع البان
   
 ويصح علم الكيمياء لبيضه «» ... فتري اللجين يعود كالعقيان
 
   
 ويقول فيض فعاله ومقاله ... مرج «» التقي بحرين يلتقيان
   
 يا مشتري «» بلغ الثناء بماله ... هنءت مرتبة علي كيوان
   
 صانت يداك عن الانام وساءلي ... وثني حماك عن البلاد عناني
   
 فمحوت الا عن ثناك خواطري ... ونفضت الا من نداك «» بناني
   
 وتركت مدح العالمين وذمهم ... وشغلت من هذا «» الندي في شاني «»
   
 واقمت متصل الرجاء بواحد ... لم يختلف في الفضل منه اثنان
   
 متسلسل الكلمات في اوصافه ... متقيدا بصناءع الاحسان
   
 لا يعدم الدهر الاخير بداءعا ... تنثال «» بين سماحة «» وبيان
   
 امتار بالمكيال «» فضل هباته ... وابيحه الاقداح بالاوزان
 
   وقوله: (بسيط)
   
 اهلا بطيف علي الجرعاء «» مختلس «» ... والفجر في سحر كالثغر في لعس «»
  
 
   
 والنجم في الافق الغربي منحدر ... كشعلة سقطت من كف مقتبس «»
   
 يا حبذا زمن الجرعاء من زمن ... كل الليالي فيه ليلة العرس
   
 وحبذا العيش مع هيفاء لو ظهرت ... للبدر لم يزه او للغصن لم يمس
   
 خود لها مثل ما في الظبي من ملح «» ... وليس للظبي ما فيها من الانس «»
 /ا
   
 محروسة بشعاع البيض ملتمعا ... ونور ذاك المحيا اية «» الحرس
   
 يسعي ورا لحظها قلبي ومن عجب ... سعي الطريدة في اثار مفترس
   
 ليت العذول علي مراي محاسنها ... لو كان ثني عمي عينيه بالخرس «»
   
 اني وان طويت في القلب غلته «» ... لمحوج العيس «» طي الضوء والغلس «»
   
 سفينة ليس تجري بي الي بخل «» ... (ان السفينة لا تجري علي اليبس)
   
 تءم «» باب ابن ايوب «» اذا اعتكرت «» ... سود الخطوب كما يءتم بالقبس
 
   
 المانح الرفد افنانا «» مهدلة «» ... فما يرد جناها كف ملتمس
   
 والرافع البخل في الدنيا وساكنها ... بجود كفيه رفع الماء للبجس «»
   
 محا المءيد بءس المقترين «» فما ... تكاد تظفر جدواه بمبتءس
   
 واستانس الناس جدوي ملكه فرووا ... عن مالك «» خبر العليا وعن انس «»
   
 ملك يقاس «» حجاريه بسءدده ... اذا يقايس عير الدار «» بالفرس
   
 وينتهي لضحي بشر مءمله ... اذا انتهي من بني الدنيا الي عبس
   
 مظفر الجد مشاء علي جدد «» ... من حمله «» اللدن او من حربه الشرس
 
   
 يخفي اللها «» ودنانير الصلات بها ... تكاد تضرب للاسماع بالجرس
   
 وينشر العلم لا قول بمختلف ... اذا رواه «» ولا معني بملتبس «»
   
 ويشبع الامر اراء مسددة «» ... تمضي وتدفع صدر الحادث الشكس «»
   
 تكون كالعضب «» احيانا واونة ... تكون من وقعات العضب كالترس «»
   
 لو باشر الافق يوما يمن «» طلعته ... لما سمعت بنجم ثم «» منتحس «»
   
 ولو تولت حزون «» الارض راحته ... لم يبق في الارض صلد «» غير منبجس
 /ب
   
 من مبلغ قومي الزاكي «» نجارهم «» ... اني اعتزيت الي جم «» العلي ندس «»
   
 مجددا لي في امداحه نسبا ... ابر من نسب في الترب مندرس «»
   
 ما زلت اخبر ممدوحا واهجره ... حتي اعتلقت «» بحبل محصد «» المرس «»
   
 وطاهر الخيم «» لا تخلي «» خلاءقه ... علي الملال ولا تطوي علي الدنس
 
   
 ما شمت بارق جدواه فاخلفني ... ولا عهدت الي معروفه فنسي
   
 تلك العلي لابن حمدان «» علي حلب ... ولابن عمار شاو في طرابلس «»
   
 ما ضرني ان تولوا وهو مرتقب ... وخاس «» عهد الغوادي «» وهو لم يخس
   
 يا بن الملوك الاولي خذها عروس ثنا ... مصرية المنتمي غربية النفس
   
 الله اكبر صاغ الحق مادحكم ... كانه ناطق من حضرة «» القدس
   وقوله: (خفيف)
   
 قام يرنو «» بمقلة كحلاء ... علمتني الجنون بالسوداء «»
  
 
   
 رشا دب في سوالفه «» النم ... ل فحارت خواطر «» الشعراء
   
 عذلوني علي هواه فاغروا ... فهواه نصب «» علي الاغراء
   
 من معيني علي لواعج «» حب ... تتلظي من ادمعي بالماء
   
 وحبيب «» لدي يفعل بالقل ... ب فعال الاعداء بالاعداء
   
 يتثني كقامة الغصن اللد ... ن ويعطو كالظبية الادماء «»
   
 يا شبيبة الغصون رفقا بصب ... ناءح في الهوي مع الورقاء
   
 يذكر العهد بالعقيق فيبكي ... لهواه بدمعة حمراء
   
 يا لها دمعة علي الخد حمرا «» ... ء بدت من سوداء في حمراء
 /ا
   
 فكاني حملت رنك «» ابن ايو ... ب «» علي وجنتي لفرط ولاءي
 
   
 ملك حافظ المناقب تروي ... راحتاه عن واصل وعطاء «»
   
 في معاليه للمديح اجتماع ... كابي جاد «» في اجتماع الهجاء
   
 خل كعبا «» ورم نداه فما كع ... ب العطايا وراسها بالسواء
   
 وارج وعد المني لديه فاسما ... عيل «» ما زال معدنا «» للوفاء
   
 ما لكفيه في الثراء هدو ... فهو فيه كسابح في ماء
   
 جمعت في فناءه الخيل والاب ... ل وفودا اكرم به من وفاء «»
 
   
 لو سكتنا عن مدحه مدحته ... بصهيل من حوله ورغاء «»
   
 همة حازت السماك فلم يع ... با مداها بالحاسد العواء»
   
 وندي يخجل السحاب فيمشي ... من ورا جوده علي استحياء
   
 طال بيت الفخار منه علي الشع ... ر فماذا يقول بيت الثناء
   
 شرف في تواضع ونوال ... في اعتذار وهيبة في حياء
   
 يا مليكا علا علي الشمس حتي ... عم احسانه عموم الضياء
   
 صنت لفظي عن الانام وكفي ... فحرام نداهم وثناءي «»
   
 وسقتني مياه جودك سقيا ... رفعتني علي ابن ماء السماء «»
   
 فابق عالي المحل داني العطايا ... قاهر الياس طاهر الانباء «»
   
 يتمني حسودك «» العيش حتي ... اتمني له امتداد البقاء
 
   «» وقوله: (طويل)
   
 تصرمت «» الايام دون وصالك ... فمن شافعي في الحب يا ابنة مالك
 /ب
   
 وكان «» الكري يدني خيالك وانقضي ... فلا منك تنويل «» ولا من خيالك
   
 رويدك «» قد اوثقت بالهم مهجتي ... عليك فماذا يبتغي بملالك
   
 افي كل يوم لي اليك مطالب ... ولكنها محفوفة بمطالك «»
   
 وغيران «» قد مد الحجاب من الظبا ... وقد كان يكفيه حجاب دلالك
   
 فتنت بخال فوق خدك صانه ... ابوك فويلي من ابيك وخالك
   
 وعاينت منك الشمس بعدا وبهجة ... فيا عجبا من وابق «» بحبالك
  
 
   
 هجرت وما فاز المحب بزورة ... فديتك زوري واهجري بعد ذلك
   
 لي الله طرفا «» كل ما جر طرفه ... الي الحسن القي عروة المتماسك «»
   
 تابط شرا «» من اذي الوجد وانثني ... (كثير الهوي شتي النوي والمسالك)
   
 قفي تنطريه في لظي البيد تابعا ... سراك والا في رماد ديارك
   
 سقي الله اكناف الديار هوامعا ... تبيت بها الازهار غر ضواحك «»
   
 كان يد الملك «» المءيد جادها ... فاسفر نوار «» الربا عن سباءك «»
   
 مليك الي مغناه تستبق المني ... مسابقة الحجاج نحو المسالك «»
 
   
 له شيم تحصي المداءح وصفها ... اذا احصيت زهر النجوم الشوابك «»
   
 وفي الارض اخبار له وماثر ... تسير سري الاسمار «» بين الملاءك
   
 حمي الارض من اراءه وسيوفه ... بكل مضء في دجي الليل فاتك
   
 وسكنها «» حتي لو اختار لم تمس ... غصون النقا تحت الرياح السواهك «»
   
 مهيب السطا هامي العطا سامق العلي «» ... جلي الحلا كشاف ليل المعارك
   
 تولي فيا عجز الاكاسرة «» الاولي ... وجاد فقلنا يا حياء البرمك «»
   
 وشاركه العافون في ذات ماله ... وليس له في مجده من مشارك
   
 كريم يجيل «» الراي فعلا ومنطقا ... فلا يرتضي غير الدراري «» السوامك «»
 
   
 كعوب القنا عجبا براحته التي ... يروي نداها مشرعات «» طوالك
   
 اذا هز منها الملك «» كعبا مثقفا ... فيالك من كعب عليه مبارك
   
 وان جر في صون «» الثغور رءوسها ... جلت قلح الاعدا جلاء المساوك
   
 ولله من اقلام علم بكفه ... سوالب الباب الرجال سوالك «»
   
 كان معانيها كواعب تتكي «» ... علي حبك الادراج «» فوق اراءك
   
 كان بياض الطرس بين سطورها ... اياديه في طي السنين الحوالك
   
 امسدي «» الايادي البيض دعوة ظافر ... لديك علي رغم الزمان المماحك «»
   
 عطفت علي حالي بنظرة ساتر «» ... وقد مد فيها الدهر راحة هاتك
   
 فدونك من مدحي اجتهاد مقصر ... تداركت من احواله شلو «» هالك
   
 تملكه الهم المبرح «» برهة ... الي ان محار رضوان «» سطوة «» مالك
 
   وقوله: (بسيط)
   
 نفس عن الحب ما اعفت «» وما غفلت ... باي ذنب وقاك الله قد قتلت
   
 وعين صب الي مراك قد لمحت ... كفي من الدمع والتسهيد «» ما حملت
   
 دعها وقد مدمعها الجاري فقد لقيت ... ما قدمت «» من اذي قلبي وما عملت
   
 افديك من ناشط الاجفان في تلفي ... والسحر يوهم طرفي انها كسلت
   
 واوضح «» الحسن لو شاءت ذواءبه ... في الافق وصل دجي الظلماء لاتصلت
   
 معسل «» بنعاس في لواحظه ... اما تراها الي كل القلوب حلت «»
 /ب
   
 من لي بالحاظ ظبي تدعي كسلا ... وكم ثياب ضني حاكت وكم غزلت
   
 وسمرة فوق خديه ومرشفه «» ... هذي روت مجانيها وذي ذبلت
   
 اما كفاني تكحيل الجفون اسي ... حتي المراشف ايضا باللمي كحلت
   
 لو ذقت برد رضاب تحت مبسمها ... يا حار «» ما لمت اغصاني التي ذبلت
  
 
   
 استودع الله اعطافا شوت «» كبدي ... وكلما رمت تجديد الوصال قلت «»
   
 ومهجة لي كم القت بمسمعها ... الي الملام فلا والله ما قبلت
   
 كان عيني اذا رفضت «» مدامعها ... عن المءيد او صوب «» الحيا نقلت
   
 ملك له في الوغي والسلم بسط يد ... ماثورة الفضل ان صالت «» وان وصلت «»
   
 تعطي الالوف اذا جادت لمطلب ... ومثل اعدادها تردي اذا قتلت
   
 في كل نهج «» وموماة «» ركاب سري ... لولا ابن ايوب ما شدت ولا رحلت
   
 ان تغش ابواب مغناه التي فتحت ... وطال ما بالعطايا «» والندي قفلت
   
 سل عن عطاياه تسال كل وافدة «» ... من المداءح فازت قبل ما سالت
   
 فضل ابر فوفي الحمد غايته ... وراحة فعلت كل الندي فعلت
   
 وسيرة عدلت «» في الخلق قاطبة ... مع انها عن سبيل الحق ما عدلت «»
 
   
 هذي السيادة تعلو كلما اتضعت «» ... وانمل الفضل تهمي كلما عذلت
   
 اني يقايس بالانواء ناءله ... وهي التي باحمرار البرق قد خجلت
   
 جادت يداه بلا من ينغصها ... والمن قد يصحب الانواء «» ان نزلت
   
 وزاد بالجود ما شادت اواءله ... وتلك قد تهدم «» البنيان «» ان هطلت
   
 لا شء «» اليق من مراي انامله ... اذا تاملت امريها التي كفلت «»
 /ا
   
 تخط بالرمح في الاجساد صاءلة ... وتطعن «» العسر «» بالاقلام ان بذلت
   
 لو قيل ان شموس الصحو خافية ... ما قال عنها عدو انها بخلت
   
 يممه والسحب عقم واخش سطوته ... والخيل من سلب «» الهيجاء «» قد نسلت «»
 
   
 ذاك الكريم الذي يجدي مداءحنا ... وكان يكفي من الجدوي اذا قبلت «»
   
 من مبلغ الاهل اني ضيف انعمه ... وان كفي علي الامال قد حصلت
   
 عزيمة السعي ما خابت وساءلها ... واية المنطق السحار ما بطلت
   
 بسل علي الناس «» امداحي التي اشتهرت ... فانها في معاني مجده، اشتغلت
   
 اما ووصف ابن شاد قد سما وعلا ... والله لا قصرت «» عيني ولا سفلت
   
 لا نسال الله الا ان تدوم لنا ... لا ان تزاد معاليه «» فقد كملت
   «» وقوله: (كامل)
   
 عوذت «» شعرك بالظلام وما وسق «» ... وسناك بالقمر المنير اذا اتسق «»
   
 اها لها من طلعة في طرة ... لاحت فلا لاح الصباح ولا الغسق
   
 وهلال تم طالع في سعده ... لكن نجم حشاي فيه قد «» احترق
  
 
   
 رشا وجدت العذل فيه باطلا ... لما وجدت بمقلتيه السحر حق
   
 زعم المشنع «» انني واصلته ... ليت المشنع عن تواصلنا صدق
   
 بابي الذي اجريت احمر ادمعي ... في حبه فاذا ابتغي امدا سبق
   
 ما للجوانح «» والبكاء تطابقا ... هذي مقيدة وذاك قد انطلق
   
 قم يا غلام وهاتها في حبه ... صفراء مشرقة كما وضح الشفق
   
 هذي الحماءم في منابر ايكها ... تملي الغنا «» والطل يكتب في الورق
 /ب
   
 والقضب تخفق «» للسلام رءوسها ... والزهر يرفع زاءريه علي الحدق
   
 فعسي تجدد لي زمان تواصل ... قد كان في اللذات معني مسترق «»
   
 لا تسمعن بان قلبي قد سلا ... ذاك الزمان فذاك قول مختلق «»
   
 تتخالف الاخبار لكن الندي ... خبر عن الملك المءيد «» متفق
   
 ملك خزاءن ماله وعداته ... تشكو «» التفرق كل يوم والفرق «»
   
 البحر في كفيه او في صدره ... فانهل وان ناويته «» فاخش الغرق
 
   
 ذاك الذي بالناس يفدي مشخصه ... ويعاذ في ظلم الحوادث بالفلق «»
   
 للسيف في يمني يديه «» جدول ... فلذا يفيض علي جوانبه العلق «»
   
 وبكفه القلم الذي لا يشتكي ... فتق «» الامور لفضله الا رتق «»
   
 تجري البحار ولو رمي بجرابه «» ... لانشق ذاك البحر غيظا «» وانفلق «»
   
 فيه مارب للعلوم وللندي ... ان «» فاض راق وان افاض «» القول رق
   
 كالغصن يستحلي «» سنا ازهاره ... ويجود بالثمر الجني وينتشق «»
   
 فاز امرء القي يمين رجاءه ... لمقام اسماعيل «» يوما واعتلق «»
   
 المرتجي «» والافق محجوب الحيا ... والملتجا والدهر مرهوب الحنق
   
 لله كم خضعت لعليا مجده ... راس وكانت ذات صويل لم تطق «»
   
 سارت سيادته وامعن «» شوطها ... فغدت علي الاعناق واصلة العنق «»
 
   
 واراد ان يجري الي غاياته ... صوب الحيا فلذاك الجمه «» العرق
   
 النصر والدنيا الخصيبة والهدي ... ان صال او بذل الصناءع او نطق
   
 لاقيته فشفي رجاي وعانقت ... كفاي من جدواه اطيب معتنق
 /ا
   
 ورواءح المعروف لا تخفي علي ... حال فشموا من اناملي العبق «»
   
 يا ايها الملك المءيد دعوة ... تذر العداة بغيظها تشكو الحرق
   
 واصلت «» قصدي باللها وقطعت ما ... بيني وبين بني الزمان من العلق «»
   
 فلاشكرن جميل ما اوليتني ... شكر الرياض الزهر للماء الغدق «»
   
 بمداءح اهلني لنظامها ... فغدت محررة وعنقي مسترق «»
   
 درر خدمت بها علاك «» وانما ... عطفت «» علي درر العلي عطف النسق
 
   «» وقوله: (بسيط)
   
 لام العذار اطالت فيك تسهيدي ... كانها لغرامي لام توكيد «»
   
 وخلف وعدك خلق منك اعرفه ... فليت كان التجافي «» منك موعودي
   
 يا من افند في وجدي عليه فما ... ابقي «» الاسي في ما يصغي لتفنيد
   
 عاب العدا منك اصداغا مجعدة ... عيب المقصر عن نيل العناقيد
   
 وعقد بند «» علي خصر رجعت به ... ذا ناظر بنجوم الليل معقود
   
 كانه تحت وجدان» القبا «» عدم ... وا حيرتي بين معدوم وموجود
   
 رد الجفاء سءالي فيك اجمعه ... فما لساءل دمعي غير مردود
   
 لقد خضعت الي وجدي كما خضعت ... الي المءيد اعناق الصناديد «»
  
 
   
 داعي «» المقاصد في علم وفي كرم ... الي اللقاء «» ملي الفضل مقصود
   
 تسري سفين الاماني نحو منزله ... فتستوي من اياديه علي الجودي «»
   
 ذاك الذي اسعدت اعمارنا يده ... فما نفكر في حكم المواليد «»
   
 ملك اذا تليت اوصاف سءدده ... القي السراة «» اليه بالمقاليد «»
 /ب
   
 ذو العلم قلد طلاب الهدي مننا ... حتي وصفناه في علم «» وتقليد «»
   
 والجود راش «» ذوي الجدوي وطرقهم ... فما يزالون في سجع وتغريد
   
 والجيش قد الفت بالنسر رايته ... تالف الطرف في مغزاه «» بالسيد
   
 يبدو وقد سخر الله العباد له ... والطير «» والوحش في الافاق والبيد
   
 حتي يقول مواليه وحاسده ... هذا ابن ايوب ام هذا ابن داود «»
 
   
 لاشكر المدح «» الحسني وقد قرنت ... بشاهد من معاليه ومشهود
   
 اغني العباد فلولا ناهيات «» تقي «» ... استغفر الله سموه بمعبود
   
 وواصل الحرب حتي كل معركة ... كانها بيت معني ذات ترديد «»
   
 يهدي الرماح قدودا ذات منعطف «» ... والمرهفات خدودا ذات توريد
   
 اذا انتشي من دم الارواح «» صارمه ... رمي العدي بشديد السطو عربيد «»
   
 وان افاض حديثا او نوال يد ... وردت من حالتيه خير مورود «»
   
 جواهرا لا يحد الوصف غايتها ... فاعجب لجوهر شء غير محدود
   
 وانعما دابها اسداء «» بكر «» يد ... لكنهن اياد ذات توليد «»
   
 لو ان للبحر جدواه افاض «» علي ... وجه الثري بنفيس «» العقد منضود «»
   
 ولو امر علي جلد «» الصفا يده ... لانبت العشب عنها كل جلمود
 
   
 يا حبذا الملك الساري علي شيم ... يروي وينقل عن اباءه «» الصيد
   
 ادنيت من نار فكري عود نبعته «» ... عند الثناء ففاحت نفحة العود
   
 نعم العماد لراج مد رغبته ... فمد نحو لقاها طرف معمود «»
   
 يممت في حال مرحوم منازله ... ثم انثنيت وحالي حال محسود
 /ا
   
 ورحت انقل عن ايوب انعمه ... نحو الصلات فمن عطف وتوكيد «»
   
 ان شءت تنظر في زهر الربي مطرا ... فانظر نوال يديه في اناشيدي
   
 وان اردت عيانا او محادثة ... فاهرع «» الي سندي «» واسمع اسانيدي
   
 يا من تحليت عن الفاظه وندي ... كفيه حلية فضل ذات تجديد
   
 ان كان لفظك شبه القرط «» في اذني ... فان جدواك مثل العقد في جيدي
   «» وقوله: (كامل)
   
 بالغت في شجني «» وفي تعذيبي ... ومع الاذي افديك من محبوب
  
 
   
 يا قاسيا هلا تعلم قلبه ... لين الصبا من جسمه المشروب «»
   
 اها لورد فوق خدك احمر ... لو ان ذاك الورد كان نصيبي
   
 ولواحظ ترث الملاحة في الظبا ... ارث السماحة في بني ايوب
   
 بعثت بنو ايوب «» اموات الرجا ... واتت بحارهم بكل عجيب
   
 وبملكهم رفع الهدي اعلامه ... وحمي سرادق بيته المنصوب
   
 والي عمادهم انتهت علياءهم ... والي العلاء قد انتهت لنجيب
   
 ملكت «» بادني سطوه ونواله ... انسي ندي هرم «» وباس شبيب
   
 الجود ملء انامل والعلم مل ... ء مسامع والعز ملء قلوب
   
 الفت بانبوب البراعة والقنا ... يمناه يوم ندي ويوم حروب
 
   
 فاذا نظرت «» وجدت ارزاق الوري ... ودم العداة تفيض «» من انبوب
   
 كم مدحة لي صغتها واثابها ... فزهت علي التفضيض والتذهيب
   
 وتعودت في كل مصر عنده ... مرعي يقابل جدبها بخصيب «»
 /ب
   
 يا رب بشر منه طاءي الندي «» ... لاقي مداءحنا لقاء حبيب «»
   «» وقوله: (طويل)
   
 الا من لمسلوب الفءاد رهينه ... معني بمحجوب الوداد ضنينه
   
 تجلده شك اذا لام «» لاءم ... ولكن «» ذاك الوجد عقد «» يقينه «»
   
 وفي قلبه داء دفين من الاسي ... فلا غرو «» ان نبكي «» لاجل دفينه «»
  
 
   
 وظبي له في اسرة الترك نسبة ... وفي الهند معني من مضاء جفونه
   
 من الطالبي «» كتم الغرام صببانة «» ... واحسن بمكتوم الغرام مصونه
   
 كتمت الهوي في عشقه متفلسفا «» ... فاصبح عشقي قاءلا بكمونه «»
   
 وعاينت في خده خط عذاره ... فاقسمت في صحف الجمال بنونه
   
 يحن له قلبي فلله من راي ... حمي يتبع الغادين رجع حنينه «»
   
 برغمي طرف غاب عنه عريزه ... فعوده ماء «» البكا بمهينه
   
 روي «» بمعين الدمع طرفي فاسمعوا ... حديث جوي قلبي من ابن معينه
   
 واني لجلد في ممارسة «» الهوي ... مدل «» بمهدي الولاء امينه
   
 يقوم بنصري في الصبابة عون من ... اقام ابن ايوب عمادا لدينه
   
 ملك تولي الفضل بعد ضياعه ... وهذب هذا الدهر بعد جنونه «»
   
 ومد يمينا يعذر البحر والحيا ... اذا حلفا يوم الندي بيمينه
   
 اخو صدقات يقدر المدح قدره ... فما يشتري «» في المدح غير ثمينه
 
   
 وما ذاك «» حاج للثناء وانما ... سجية فياض الغمام هتونه «»
   
 شج «» في العلا «» والعلم والباس والندي ... فلله ما احلي حديث شجونه
 /ا
   
 له منزل تهوي المقاصد نحوه ... هوي حمام الايك نحو وكونه «»
   
 اذا طلب الملك المءيد معسر «» ... اتي بشره «» في وجهه كضمينه
   
 عجبت لبشر ضامن الوجه اذ غدا ... يطالبه عافي الندي بديونه
   
 واروع «» يهتز الزمان لامره ... وما الطود ارسي جانبا من سكونه
   
 كثير السري ما بين مشتجر القنا «» ... فيالك ليثا ساءرا في عرينه
   
 يلاقي العدا يوم الوغي متبسما ... كانك قد لا قيته بخدينه «»
   
 وتلهيه في الهيجاء رنة قوسه ... اذا وتر «» الهي امرا برنينه
 
   
 ولو شاء اغناه عن الجيش ذكره ... ورب حسام هازم بطنينه
   
 ايا ملجا «» اغني عن الغيث جوده ... واغنته حو مات «» الوغي عن حصونه
   
 بك ارتد مشكو الزمان عن الاذي ... واطلق ابناء المني من سجونه
   
 وقد كان ذا همز «» يحاذر فانتهي ... الي مدة بعد الاباء ولينه
   
 وكم لك عندي من ندي يفضل الثنا ... ويحلف ان الشعر غير قرينه
   
 اذا قلت قد قابلته بقصيدة ... بدا غيره مستظهرا بكمينه «»
   
 فدونك جهدا «» من قريحة مادح ... يقابل ابكار الصلات «» بعونه
   
 راي انك البحر الذي طاب ورده ... فجاءك من نظم القريض بنونه «»
   «» وقوله: (كامل)
   
 لولا معاني السحر من لحظاتها ... ما طال تردادي الي ابياتها
   
 ولما وقفت علي الديار مناديا ... قلبي المتيم من ورا حجراتها
   
 دار عرفت الوجد منذ اتيتها ... زمن الوصال فليتني لم اتها
  
 
 /ب
   
 حيث الظبا «» وكواعب وحداءق ... اني التفت وقعت في جنباتها «»
   
 والراح هادية السرور الي الحشا ... مثل الكواكب في اكف سقاتها
   
 لا تظلم «» الاحزان في ايامها ... او ما تري كسري علي كاساتها
   
 كم ليلة عاطيت «» صورته طلا ... كادت تحرك معطفيه بذاتها
   
 فلءن بكيت فان هذا الدمع من ... ذاك الحباب يفيض من جنباتها
   
 مالي ومال اللهو «» بعد مفارق ... قد نفرت «» غربانها ببزاتها
   
 والشيب في فودي يخط اهلة ... معني المنون يلوح في نوناتها «»
   
 سقيا لروضات الشباب وان جنت ... هذي القلوب «» علي قلوب جناتها
   
 ولدولة الملك المءيد انها ... جمعت فنون المدح بعد شتاتها
   
 ملك ليمناه عواءد انعم ... الفت نحاة «» الجود فيض صلاتها
   
 ما قال الا في مبادرة العطا ... وتناول الامداح هاك وهاتها «»
 
   
 اكرم بساحته التي لا صدح «» من ... ورق الثنا الا علي روضاتها
   
 غذي الرجاء نباتها فانظر لها ... وشاه من مدح فم ابن نباتها «»
   
 واهرع الي الشخص الذي قد الفت ... كل القلوب له علي رغباتها «»
   
 واذا حلي الملك المءيد اشرقت ... فاخشع لما تمليه من اياتها
   
 شرف يحار النجم دون مناله «» ... ولها يضيع الغيث في قطراتها
   
 لم يكف ان جلي الخطوب عن الوري ... حتي جلا بعلومه «» جهلاتها
   
 لله فيه سريرة «» مكنونة ... فصفاتها الاعياء «» دون «» صفاتها
   
 لا تطلبن من القراءح حصر ما ... افضي اليه وعد «» عن اعناتها «»
 /ا
   
 ركعت لذكراه الحروف فلم تكد ... تتبين الالفاظ «» من دالاتها
 
   
 وتقشعت «» انواء كل غمامة ... وهباته تجري علي عاداتها
   
 يا ابن المملوك الناشرين لبيتهم ... سيرا تبيض من وجوه رواتها
   
 مت القصير «» الي يديك بمنة ... اذ كان صنع الجود من لذاتها
   
 وصبت الي لقياك غير ملومة ... نفس رات جدواك اصل حياتها
   
 لا تعتب «» الايام كيف تقلبت ... بالقاطنين وانت من حسناتها
   «» وقوله: (بسيط)
   
 لثمت ثغر عذولي حين سماك ... فلذ حتي كاني لاثم فاك
   
 حبا لذكراك في سمعي وفي خلدي «» ... هذا وان جرحت في القلب ذكراك
   
 تيهي وصدي اذا ما شءت واحتكمي ... علي النفوس فان الحسن ولاك
   
 وطولي من عذابي «» في هواك عسي ... يطول في الحشر ايقافي واياك
   
 في فيك خمر وفي عطف الصباميد ... فما تثنيك الا من ثناياك
   
 وما بليت «» لكوني فيك ذا تلف ... الا لكون سعير القلب ماواك
  
 
   
 يا ادمعا لي قد انفقتها سرفا ... ما كان عن ذا الوفا والبر اغناك
   
 ويا مديرة صدغيها كقبلتها «» ... لقد غدت اوجه العشاق ترضاك
   
 مهما سلونا فلا نسلو ليالينا ... وما نسينا فلا والله ينساك «»
   
 نكاد نلقاك بالذكري اذا خطرت ... كانما اسمك يا سعدي «» مسماك
   
 ونشتكي الطير نعابا «» بفرقتنا ... وما طيور الندي الا مطاياك
   
 لقد عرفناك «» اياما وداومنا ... شجو فيا ليت انا لا عرفناك
 /ب
   
 نرعي عهودك في حل ومرتحل «» ... رعي ابن ايوب حال اللاءذ «» الشاكي
   
 العالم الملك السيار سءدده ... في الارض سير الدراري بين افلاك
   
 ذاك الذي قالت العليا لانعمه ... لا اصغر الله في الاحوال ممساك
   
 له احاديث تغني كل مجدبة ... عن الحيا وتجلي كل احلاك «»
   
 ما بين خيط الدجي «» والبدر واضحة ... كانها درر من بين اسلاك
   
 كافاك يا دولة الملك المءيد عن ... بر البرية من للفضل اعطاك
 
   
 لك الفتوة «» والفتوي محررة ... لله ماذا علي الحالين افتاك
   
 احييت ما مات من علم ومن كرم ... فزادك الله من فضل وحياك
   
 ماذا يجمع «» ما جمعت من شرف ... في الخافقين ومن يسعي كمسعاك
   
 انسي المءيد اخبار الاولي سلفوا «» ... في الملك ما بين فتاك وفتاك «»
   
 ذي الراي يشكو «» السلاح الجم حدته ... لذاك يسمي السلاح الجم بالشاكي
   
 والمكرمات التي افترت مباسمها ... والغيث بالرعد يبدي شهقة الباكي
   
 قل للبدور استجني «» في الغمام فقد ... محاسنا ابن علي «» حسن مسراك
   
 ان ادعيت من النشر المطيف به «» ... غيظا فقد ثبتت في الوجه دعواك
   
 يا ايها الملك المدلول قاصده ... وضده نحو ستار وهتاك
   
 لو ادركتك بنو العباس فانتصرت «» ... بمقدم «» في ظلام الخطب ضحاك
   
 مظفر الجد من حظ ومن نسب ... مبصر بخفي الرشد مدراك 
   
 وحدته في الوري بالقصد وارتفعت ... وساءلي فيه عن زيغ «» واشراك «»
 
   
 ما عارضت يد امداحي مواهبه ... الا رجعت بصفو المغنم الزاكي
 /ا
   
 ان الكرام اذا حاولت صيدهم ... كانت بيوت المعالي مثل اشراك «»
   
 سقيا لدنياك لاكف بخاءبة ... فيها لديك ولا وصف بافاك «»
   
 من كان في خيفة «» الانفاق يمسكها ... فانت تنفقها من خوف امساك
   «» وقوله: (طويل)
   
 عذيري من ساجي اللواحظ اغيد ... يصول باسياف الجفون ولا يد
   
 غزال يناجيني بلفظ معرب ... ولكنه يسطو بلحظ مهند
   
 وقد روت عن لينه واعتداله ... صحاح العوالي مسندا بعد مسند
  
 
   
 اذا قعدت اردافه قام عطفه ... فيا طول شجوي من متيم ومقعد
   
 يخيل لي اني له لست عاشقا ... لان ليس لي في عشقه «» من مفند «»
   
 ولولا الهوي ما بت بالدمع غارقا ... عليه واشكو للوري علة «» الصدي
   
 ورب مدام من يديه شربتها ... معتقة «» تدعي «» لعيش مجدد
   
 (اذا جءته تعشو الي ضوء كاسه ... تجد خير نار عندها خير موقد) «»
   
 كان سنا راووقها «» وصبيبها «» ... حبال شعاع الشمس تفتل باليد
   
 كان بقايا ما مضي من كءوسها «» ... اساور «» تبر في معاصم خرد
   
 سقي الغيث عني ذلك الشخص انه ... مضي شبه غصن البانة المتاود «»
   
 وفرق الا مقلتي وسهادها ... وجمع الا مهجتي وتجلدي «»
   
 فلا غزل الا له من قصيدة ... ولا مدح الا للمليك المءيد
 
   
 مليك راي ان لا مباري في العلا ... فظل «» يباري سءدد اليوم بالغد
   
 لو اختصمت اهل المكارم في الندي ... لقال مقال الحق ملكي وفي يدي «»
 /ب
   
 كذلك فليحفظ تراث جدوده ... مليك بني فوق الاساس الموطد «»
   
 يءم حماه طالب بعد طالب ... فذو القصد يستحذي «» وهو «» الدهر يفتدي «» «»
   
 ولا عيب فيه غير اسراف «» بذله «» ... وان مدي علياه غير محدد «»
   
 تجول ثغور اللثم في عتباته «» ... كما جال عقد في تراءب اجيد
   
 رعي الله ايام المءيد انها ... احق واولي بالثناء المءيد
   
 حمت وهمت فالناس ما بين هاجد «» ... امانا وداع «» في الدجي متهجد «»
 
   
 وما عرفت يومي ندي وشجاعة ... باخلاف «» موعود ولا متوعد «»
   
 دع المبتغي نحو المكارم «» شافعا ... وجءه فقيرا بالرجاء المجرد
   
 هنالك تلقي نعمة «» بعد نعمة ... لداعي الندي مثل النداء المءكد
   
 ومبيض اثار الصناءع اخمدت «» ... مناقبه ايام كل مسود
   
 اذا شام رايا في الملمات ردها «» ... بافتك من مر الزمان «» واكيد
   
 ولم تزل الهيجاء اثني مقامها ... عليه بالفاظ الوشيج «» المقصد «» «»
   
 ايا ملكا في منه وعقابه ... حياة لمعتد وموت لمعتدي «»
   
 اليك سلكت الخلق سمحا وباخلا ... وجبت الموامي «» فدفدا «» بعد فدفد
   
 فوفيتني وعد الاماني وانها ... سجية اسماعيل «» في صدق موعد
 
   
 وجاد بك الدهر البخيل وربما ... تدفق «» عذب الماء من قلب جلمد
   
 فياليت قومي يعلمون بانني ... تعجلت «» من نعماك اضعاف مقصدي
   
 وجملت «» فيك الشعر حتي نظمته ... فما البيت الا مثل قصر مشيد
   
 واخملت ارباب القريض كانني ... ادرت علي اسماعهم كاس مرقد
 /ا
   
 فلا زلت مخدوم المقام مخلدا ... ومن يكتسب هذا الثناء «» يخلد
   
 شكرتك حتي لم تدع لي لفظة ... وكدت بان اشكوك في كل مشهد
   
 لانك قد اوهيت «» جهدي باللها ... وانسيتني اهلي وكثرت «» حسدي
   «» وقوله: (كامل)
   
 اخفي الاسي ولسان سقمي يعلن ... وارد ما بي والسقام يبرهن»
  
 
   
 وتظل تعدي الغانيات مدامعي ... فمدامعي كعهودها تتلون
   
 بابي التي «» اسكنتها في خاطري ... فسرت فسار مع النزيل «» المسكن
   
 لمياء «» لي دين علي ميعادها ... مع ان قلبي عندها مسترهن
   
 تبدي اللالء منطقا وتبسما ... فكان فاها للالء معدن
   
 ويلومني فيها خلي ما دري ... الشمس «» ام تلك المليحة ازين؟ «»
   
 يا لاءمي انظر حسن تلك وهذه ... وادفع ملامك بالتي هي احسن
   
 كيف التصبر عن سعاد وحسنها ... كالفضل في الملك المءيد بين
   
 ملك علي عهد المعالي ثابت ... لكنه في فضله متقنن
   
 بينا يري بحر العلوم اذا به ... بحر الندي فحديثه متشجن «»
   
 ظعن «» الكرام الاولون واقبلت ... ايامه فكانهم لم يظعنوا
   
 لم يبق لولا جوده ومقالنا ... مال يكال ولا يقال «» فيوزن
   
 من اين للامال مثل مقامه ... الروض «» افيح والغماءم هتن «»
 
   
 خذ عن عواليه «» احاديث الوغي ... فحديثها عن راحتيه يعنعن «»
   
 شرف القتيل بسيفه فقتيله «» ... في الجو ما بين الحواصل «» يدفن
   
 فتطابقت افعاله لعفاته ... فالكيس «» يهزل والحقاءب «» تسمن
 /ب
   
 فضل يموت «» به الحسود تحسرا ... فكانه بثيابه متكفن
   
 ما ضر معشر «» حاسديه لو انهم ... فطنوا ليسر «» الله فيه واذعنوا 
   
 الله قدر والعزاءم «» انهم ... يتحارفون «» وانه يتسلطن «»
   
 يا ابن الملوك اذا دعاهم مقتر ... لانوا وان دعيت نزال «» اخشو شنوا «»
   
 نسب كصدر الرمح الا انه ... عند المحامد ليس فيه مطعن
 
   
 لله دهرك انه الدهر الذي ... سء الكفور به وسر المءمن
   
 شيدت باسماعيل «» اركان العلا ... فاليه يلتجء الرجاء ويركن «»
   
 ودعا ندي ابن علي «» كل مودة ... حتي استوي الشيعي والمتسنن
   
 فليعذر المداح فيه فانهم ... بالعجز عن ادني المدي قد ايقنوا
   
 عنت «» القراءح عن بلوغ صفاته ... وتسترت خلف الشفاه الالسن
   «» وقوله: (طويل)
   
 اجبت منادي الحب من قبل ما دعا ... فان شءتما لوما وان شءتما دعا
   
 لي الله قلبا صير الوجد شرعة ... عليه وجفنا صير الدمع مشرعا «» »
   
 كنانة «» لحظ خلفتني من الهنا ... قصيا وفكري للهموم مجمعا
   
 وسالف عهد بالعقيق ذكرته ... فعاد بدر المدمعين مرصعا
  
 
   
 يخوفني بالسقم لاح «» وليت من ... عناني «» ابقي في للسقم موضعا
   
 بليت فلو رامتني العين ما رات ... ولو ان فكري عارض «» السمع ما وعي
   
 ورب زمان كان لي فيه مالك ... حبيب سقي منه الفراق بما سعي «»
   
 (فلما تفرقنا كاني ومالكا ... لطول اجتماع لم نبت ليلة معا) «»
 /ا
   
 من الغيد لو كان الملاح قصيدة ... لكان سنا خديه للشمس مطلعا
   
 ادار علي الدمع كاسا وطال ما ... ادار علي البابلي «» المشعشعا «»
   
 كان التلاقي كان وفرا «» تسرعت ... ايادي ابن شاد «» فيه حتي تضعضعا
   
 اذا لم يكن في الغيث للعام نجعة «» ... فحسبك بالملك المءيد منجعا
   
 مليك اعاد الشعر سوقا بدهره ... فجءت الي ابوابه متبضعا «»
   
 فو الله «» لولا باعث من مديحه ... لاصبح بيت الشعر عندي بلقعا «»
   
 اتعذل اقلام المداءح ان غدت ... له سجدا لا للانام وركعا
 
   
 فدت «» طلعة البدر المنير ابا الفدا ... وان كان اعلي من فداها وارفعا
   
 الم تر انا قد سلونا بارضه ... مرادا لنا في ارض مصر ومربعا
   
 اذا ابن تقي الدين «» جاد بنانه «» ... علينا فلا مدت يد النيل اصبعا
   
 اما والذي انشا «» الغمام وكفه ... وجاد وقد مل الغمام فاقلعا
   
 لقد سمعت للاولين فضاءل ... ولكن لهذا الفضل ما جاز «» مسمعا
   
 سخاء كما ترجي السحاءب «» حفلا «» ... وباس كما تنضي الصواعق لمعا
   
 وعلم ملانا صحفنا «» من فنونه ... فكانت علي الايام بردا موشعا «»
   
 وذكر له في كل قلب محبة ... علي ابن علي «» يعذر المتشيعا «»
   
 له الله ما ازكاه في الملك نبعة ... واعذب من سقي «» المكارم منبعا
   
 هو الملك اغني ماء وجهي وصانه ... فان تقصر الامداح لا يقصر «» الدعا
   
 غدت كل عام لي اليه وفادة ... فيا حبذا من اجل لقياه كل عا «»
 
   
 وطوقت تطويق الحمام بجوده ... فلا عجبا «» لي ان احوم «» واسجعا
 /ب
   
 قضي الله الا ان يقوم لقاصد ... بغرض فان لم يلق فرضا «» تطوعا
   
 حلفت لقد ضاع الثنا عند غيره ... ضياعا واما عنده فتضوعا «»
   «» وقوله: (بسيط)
   
 يا شاهر اللحظ حبي فيك مشهور ... وكاسر «» الطرف قلبي منك مكسور
   
 امرت لحظك ان يسطو علي كبدي ... يا صدق من قال ان السيف مامور
   
 وجاوب الدمع ثغرا منك متسقا ... فبيننا الدر منظوم ومنثور
   
 لا تجعل اسمي للعذال منتصبا ... فما لتعريف وجدي فيه تنكير «»
   
 ولا توال اذي قلبي لتهدمه ... فانه منزل بالود معمور
   
 هل عند منظرك الشفاف جوهرة ... اني اليه فقير اللحظ مضرور «»
  
 
   
 او عند مبسمك الغرار «» بارقة ... اني بموعد صبري فيه مغرور
   
 اقسمت بالعارض المسكي «» ان به ... للمقسمين كتاب الحسن مسطور
   
 لقد تغير «» عهد الحال من جسدي ... وما لحال عهودي فيك تغيير
   
 حبي ومدح ابن شاه شاه «» من قدم ... كلاهما في حديث الدهر ماثور
   
 انشا المءيد الفاظي وانشرها ... فحبذا منشر «» فيها ومنشور «»
   
 ملك اذا شمت برقا من اسرته ... علمت ان مراد القصد ممطور
   
 مكمل الذات زاكي الاصل طاهره ... فعنده الفضل مسموع ومنظور
   
 اقام للملك اراء معظمة ... لشبهها في بروج اليمن «» تسيير
   
 وقام عنه لسان الجود ينشدنا ... زوروا «» فما الظن فيه كالوري زور
   
 هو الذي «» للثنا من نحو دولته ... وللجواءز مرفوع ومجرور
 
 /ا
   
 وللعلوم تصانيف «» بدت فغدت ... نعم السوار علي الاسلام والسور
   
 قد اثرت ما يسر الدين احرفها ... وللحروف كما قد قيل تاثير
   
 في كفه قلم صان الحمي فله «» ... مال علي صفحات الحمد منثور
   
 وصارم في ظلام النقع «» تحسبه ... برقا يشق به في الافق ديجور
   
 تفدي البرية ان قلوا وان كثروا ... ابا الفداء فثم الفضل والخير
   
 مدت الي مجده الامداح واقتصرت ... فاعجب لممدود شء وهو مقصور «»
   
 وسرها من اب وابن قد اجتمعا ... مءيد يتلقاها ومنصور «»
   
 يا مالكا اشرقت ايامه وزهت ... رياضها فتجلي النور والنور
   
 هنءت عيدا له منك اعتياد هنا ... فالصبح مبتهج والليل مسرور
   
 فطرت فيه الوري واللفظ متفق «» ... للوفد فطر وللحساد تفطير
   
 كان شكل هلال العيد في يده ... قوس علي مهج الاضداد موتور «»
   
 او مخلب مده نسر السماء لهم ... فكل طاءر قلب منه مذعور
 
   
 او منجل لحصاد «» القوم منعطف ... او خنجر مرهف النصلين «» مطرور «»
   
 او نعل تبر اجادت في هديته ... الي جوار ابن ايوب المقادير «»
   
 او حاجب اشمط «» ينبي «» بان له ... عمرا له في ظلال الملك تعمير
   
 او زورق جاء فيه العيد منحدرا ... حيث الدجي كعباب «» البحر مسجور «»
   
 او لا فقل شفة للكاس ماءلة ... تذكر العيش ان العيش مذكور
   
 او لا فقطعة قيد فك عن بشر ... اخني «» الصيام عليه فهو ماسور
   
 او لا فنصف سوار قام يطرحه ... كف الدجي حين عمته التباشير «»
 /ب
   
 او لا فمن رمضان النون قط سقطت ... لما مضي وهو من شوال «» محصور
   
 فانعم به «» وبامداح مشعشعة «» ... مديرها في صباح الفطر مبرور
 
   
 قالت وما كذبت رءيا محاسنها ... قبول غيري علي الاملاك محظور
   
 بعض الوري شاعر فاسمع مداءحه ... وبعضهم مثل ما قد قيل شعرور «»
   «» وقوله: (سريع)
   
 لا تسالوا في الحب عن شاني ... فقد كفي تعبير اجفاني
   
 هويت من طلعته روضة ... ففاضت العين بغدران
  
 
   
 غصن من البان اذا ما انثني ... ابصرت فيه الف بستان
   
 اشبهت في حبيه «» ورق الحمي ... فكلنا نبكي علي البان
   
 بالروح افدي وجنتي مالك ... كانه من حور رضوان «»
   
 فر عن الجنات من تيهه ... وعذب «» القلب بنيران
   
 ظبي الي القان «» له نسبة ... واحربا «» في خده القاني
   
 تقول لي نشطة «» اعطافه ... ضل الذي بالرمح حاكاني
   
 حلوان من عطفي قد اينعا ... فكيف تحكيها بمران
   
 يا فارع الفكرة من شقوتي ... يعينني من فيك اشقاني
   
 لا وندي ابن الافضل «» المرتجي ... لا نكثت «» بيعة اشجاني 
   
 ذاك الذي انقذني جوده ... من مخلب الدهر فاحياني
   
 ولم يزل تنويه «» تنويله «» ... حتي حمي وجهي واغناني
   
 قالت لامالي يداه انفذي ... لا تنفذني الا بسلطان
 
 /ا
   
 افضي لاسماعيل «» بيت العلا ... فشاد منه اي اركان
   
 مءيد تفتح «» يوم الوغي ... في مدحه السن خرسان «»
   
 ذو راحة بالبذل تعبانة ... وما العلا الا لتعبان
   
 تجني علي المال وتجني الثنا ... يا حبذا المجتني «» والجاني
   
 كيف علي كفيه يظما لرجا «» ... ما بين سيحان «» وجيحان «»
   
 اكرم به في الدهر من واحد «» ... لم يختلف في فضله اثنان
   
 يلقاك من علياه او علمه ... بملء ابصار واذهان
 
   
 باسط «» كفيه لطلابه ... فهو الوري وهي البسيطان «»
   
 له اذا حاولت نهب اللها ... خزاءن ليست بخزان
   
 للجود في امثالها «» مثل ما ... في قصتي عبس وذبيان
   
 اصبحت من غلمان ابوابه ... والسعد من جملة غلماني «»
   
 اطوي علي محض «» الولا مهجتي ... وانشر المدح بتبيان
   
 فكل ابياتي في مدحه «» ... ابيات سلمان «» وحسان «»
   
 يا رب هبه عمر نوح «» فقد ... جاء من الجود بطوفان «»
 
   «» وقوله:
   
 ما ضر من لم يجد في الحب تعذيبي ... لو كان يرفع عني هم «» تانيبي
   
 اشكو الي الله عذالا اكابدهم ... وما يزيدون قلبي غير تشبيب
   
 وخاطرا غنت «» الاشواق تعجبه ... سوالف الترك في عطف الاعاريب
   
 كانني لوجوه «» الترك معتكف «» ... ما بين اصداغ شعر كالمحاريب «»
 /ب
   
 لا يقرب الصبر قلبي او يفارقه ... كانه المال في كف ابن ايوب «»
   
 لولا ابن ايوب ما سرنا لمغترب ... في المكرمات ولا فزنا بمرغوب
   
 دعا المءيد بالترغيب قاصده ... فلو تاخر استدعي «» بترهيب
  
 
   
 ملك اذا مر يوم لا عفاة به ... فليس ذلك من ملك بمحسوب «»
   
 للجود والعلم اقلام براحته ... تجري المقاصد منها تحت مكتوب
   
 مجموعة فيه «» اخبار الاولي سلفوا «» ... كما تترجم اخبار بتبويب «»
   
 اذا تسابق للعلياء ذو خطر «» ... معي فادرك تبعيدا بتغريب
   
 وان امال الي الهيجاء صدر قنا «» ... اجري دماء الاعادي بالانابيب
   
 قد اقسم الجود لا ينفك عن يده ... اما لعا فيه او للنسر والذيب
   
 اما حماه فقد اضحي «» بدولته ... ملاذ كل قصي الدار محروب «»
   
 غريبة الباب تقري «» من الم بها ... فخل بغداد «» وانزل بابها النوبي «»
   
 وانعم بوعد الاماني عند رءيته ... فان ذلك وعد غير مكذوب
   
 وا عجب لانمل جود قط «» ما سءمت ... ان البحار لاباء الاعاجيب
   
 كل العفاة عبيد في صناءعه ... ودار كل عدو دار ملحوب «»
 
   
 يا مانحي مننا من بعدها منن ... كالماء يتبع «» مسكوبا بمسكوب
   
 من كان يلزم ممدوحا علي غرر «» ... فما لزمتك الا بعد تجريب
   
 انت الذي نبهت فكري مداءحه ... ودربتني والاشيا بتدريب «»
   
 حتي اقمت قرير العين في دعة «» ... وذكر مدحك في الافاق يسري «» بي
   
 مدح تغار «» لمسود المداد به ... (حمر الحلي والمطايا والجلابيب)
