  صالة ببا عز الدين




 بدات ببا عز الدين  واسمها الحقيقي فاطمة عز الدين  العمل الفني في بيروت عام ، عندما هربت من زوجها وانضمت كراقصة الي فرقة امين عطا الله، الذي اطلق عليها اسم «ببا». ولكن زوجها اخذ يطاردها واخيرا طلقها، فجاءت الي مصر، وانضمت الي فرقة يوسف عز الدين بروض الفرج عام ، ثم تركته وانضمت الي مسرح الفنتازيو. وفي احدي الليالي زارت بديعة مصابني هذا المسرح وشاهدت رقص ببا، ومن ثم ضمتها الي صالتها.

 

 ببا عز الدين.

 وفي صيف عام  انفصلت ببا عن صالة بديعة مصابني، وكونت فرقة باسمها عملت في كازينو مونت كارلو بالشاطبي بالاسكندرية، فقدمت المسرحيات والمنولوجات والرقص الشرقي، بمساعدة: فتحية احمد، فتحية محمود، حسين ابراهيم، محمد ادريس. ومن هذه المسرحيات: «اشمعني»، «متحف الفن»، «كاريوكا» لامين صدقي. و«خد بالك»، «غلطة»، «الهوسة الاصلي» لصالح سعودي. و«يا كتاكيتها»، «بكرة نشوف»، «قشطة» لعبد النبي محمد. واسكتشات: «ليلة حظ»، «بلاد نمنم»، «يا سخطة»، و«الحمامات»، «ليالي شهرزاد»، «الوان الحب» لابي السعود الابياري. و«التنويم المغناطيسي» لمحمد مصطفي، و«المءتمر التجاري» لعبد النبي محمد، و«نهضة مصر» لمحمد اسماعيل، و«واق الواق» لحسن كامل، و«اخر زمن»، «علي البلاج»، «النعيم» لامين صدقي. وهذه الاعمال من تلحين: عزت الجاهلي، ابراهيم فوزي، احمد صبرة، احمد شريف.

 

 وفي موسم  افتتحت ببا كازينو الف ليلة بمحطة الرمل بالاسكندرية في  /  / ، وفيه قدمت مسرحيات: «كل فولة»، «الناس مقامات»، «كنج كونج»، «عيب يا تيزة»، «وش وقفا» لعبد النبي محمد، و«عرسان للايجار» لابي السعود الابياري، و«انشودة الورد» لبيرم التونسي، و«برج الوفاق»، «البركة في اللمة»، «معرض الازواج»، «يومين في البندر»، «في الحفظ والصون»، «مبروك» لمحمود صادق سيف. و«معرض الغوازي» لامين صدقي. و«ازمة عمال»، «ايد علي ايد»، «بحر الغزال» لحسن كامل. واسكتشات: «ارمي بياضك» لعبد النبي محمد. و«الافلام المصرية» لابي السعود الابياري. و«اللي في الحلة»، «الدكتورة» لمحمد مصطفي. وهذه الاعمال من تلحين: ابراهيم فوزي، عزت الجاهلي، احمد صبرة. ومن تمثيل وغناء: ببا، رجاء عبده، فتحية محمود، عبد النبي محمد، حسين ابراهيم، موسي حلمي، زوزو لبيب، بيونشتا، جينا، مفيدة احمد، ديوريلس.

 

 وفي موسم  انتقلت ببا بفرقته لتعمل بصالة بديعة مصابني في شارع عماد الدين، وفي هذا الموسم قدمت الفرقة مسرحيات: «يوليوس قيصر»، «ملاية السرير»، «حلبسو»، «ليلة»، «بنتي نينتي»، «اغسل وشك»، «حانوتي الانس»، «غلطتي»، «حادي بادي»، «ماتحمرقش»، «المعلم»، «ليلة دخلتي»، «بوابة السعد»، «نم نم». كما قدمت اسكتشات: «ارتيست زمان»، «معرض الكوارع»، «فرفش وانجلي»، «كنوز سليمان»، «الف صنف»، «مصر»، «عرسان للبيع»، «الاحلام والسكلانس»، «مصارع الثيران»، «بنات الشركس»، «وادي الملوك»، «مشكلة الزواج»، «النيل»، «اصحاب العقول»، «مدرسة الزواج»، «التواليت»، «اغاخان»، «اخر رجل في العالم»، «البركان»، «اللي في الدست»، «نصف الدنيا»، «مصر سنة ».

 

 اما موسم  فقد تاخر عمل فرقة ببا فيه كثيرا بسبب قيام ببا ببطولة فيلم سينماءي هو «كله الا كده»، تاليف الشيخ محمد يونس القاضي. وقد عرض هذا الفيلم في سينما حديقة الازبكية الشتوية في ديسمبر ، وكان من تمثيل: محمد كمال المصري، عبد الحميد زكي، سيد مصطفي، سرينا ابراهيم، فتحية فءاد. وبعد نجاح الفيلم سافرت فرقة ببا في رحلة فنية الي طرابلس وتونس والجزاءر ومراكش، وعادت منها في اواءل مارس .

 

 وبعد عودة الفرقة من رحلتها واصلت عملها بكازينو بديعة مصابني بشارع عماد الدين، فقدمت مسرحيتي «عشرة مليون» لابي السعود الابياري، و«انا عصبي» لعبد الحليم القلعاوي. كما قدمت استعراضات: «ترولي رقص»، «اعياد الامم»، «الوجه المستعار» لابي السعود الابياري. وهذه الاعمال من تلحين فريد غصن، ومن تمثيل وغناء: ببا، عبد النبي محمد، حسين ابراهيم، الفريد حداد، عبد الحليم القلعاوي، محمود التوني، سيد فوزي، ليلي الشقراء، جمالات حسن، خيرية صدقي، سعاد عبده، روز عازوري، تيتي، صفية حلمي، كيكي المسيري، رجاء رستم، ميمي صيداوي، ليلي عاصم، حسين المليجي، نعمات المليجي.

 

 وفي صيف هذا الموسم انتقلت فرقة ببا الي كازينو مونت كارلو بالشاطبي بالاسكندرية، تحت ادارة عبد العزيز محجوب، حيث قدمت ابتداء من  مايو  مسرحيات: «الدنيا بخير»، «الملافظ سعد»، «جوز هالة»، «فالح» لعبد النبي محمد، و«ماعلش يوليوس قيصر» لابي السعود الابياري، و«التلفزيون» لمحمد اسماعيل. و«ليلة الدخلة» لامين النابكي وعبد النبي محمد. واسكتشات: «عرايس الربيع»، «معرض باريس»، و«حول الارض»، «نعيما» لعبد النبي محمد، و«عفاريت موديل »، «رحمة ونور»، «اختلاط الجنسين»، «ذوي العاهات» لامين صدقي، و«محضر خير» لمحمد مصطفي، و«عقبالكم» لمحمود حسني، و«التعداد» لمحمد اسماعيل. وهذه الاعمال من تلحين سيد مصطفي ومحمود الشريف، ومن تمثيل وغناء: ببا عز الدين، عبد النبي محمد، محمد عبد المطلب، حسين المليجي، نعمات المليجي، محمد ادريس، عايدة، فيفي، كريمة احمد، سارة.

 

 وفي اكتوبر  افتتحت ببا موسم  بكازينو بديعة مصابني بشارع عماد الدين تحت ادارة انطوان عيسي، وفيه قدمت مسرحيات: «يا بلاش»، «اصطلحنا»، «الغيرة مرة»، «فتح عينك»، و«جرس الخطر» لامين صدقي، و«ابو زيد»، «عرسان للبيع» للابياري، و«القصر المسحور»، «جه يكحلها» لمحمد مصطفي، و«مين فيهم» لعبد الفتاح عزو، و«مدرسة الرقص» لاميل عصاعيصو، و«يا ضنايا»، «جراند اوتيل» لمحمد اسماعيل. واسكتشات: «الزهور»، «بروفة جنرال»، «غرام الف صنف»، «درس نحوي»، و«من رضي بقليله عاش» لجميل امين، و«هوايين» لمحمود الشريف، و«الامير زاريو» لمحمد اسماعيل. واستعراضات: «المواصلات»، «حمام الهنا»، و«امنت بالله»، «وحوي يا وحوي» لمحمد مصطفي. وهذه الاعمال من تلحين: سيد مصطفي، فريد غصن، محمود الشريف، عزت الجاهلي. ومن تمثيل وغناء: فتحية محمود، سيد سليمان، صفية حلمي، سميرة امين، ببا عز الدين، عبد النبي محمد، موسي حلمي، عفيفة اسكندر، انصاف محمد، سيد بهنسي، لونا، اليس، هجران هانم.

 

 واذا نظرنا الي بعض موضوعات الاعمال المسرحية التي كانت تقدمها فرقة ببا عز الدين؛ سنجد مسرحية «القصر المسحور» لمحمد مصطفي تدور حول سجين هارب اسمه رزق اختفي في قصر مهجور، حيث يلتقي برجل اخر هارب من حماته التي حولت حياته الي جحيم لا يطاق. وبعد فترة من اختفاءهما في هذا القصر يظهر لهما في الظلام حارس القصر وهو من الجان، ومن خلال الحوار يعرض عليهما الحارس بعض فتيات حسان، فيوافقان علي ذلك، ثم يقوم الحارس ببعض الحركات السحرية، وفي لحظات تظهر نسوة عجاءز، فيوقعن الرعب في قلب الهاربين . وبعد مواقف كوميدية كثيرة تتبدل النسوة العجاءز بفتيات صغيرات، وتنتهي المسرحية.

 اما مسرحية «جرس الخطر» لامين صدقي، فتدور حول يوسف افندي ناظر محطة قطار غزة، وكانت له ابنة جميلة تدعي بلانش، وكان قد خطبها رستم افندي، ولكن والدها رفض ان يزوجها له. وفي يوم ما ترك يوسف المحطة وذهب لقضاء عمل شخصي له؛ لان القطار القادم في ذلك الوقت لا يقف في محطة غزة. ويشاء القدر ان احد المسافرين علي هذا القطار كان لا يحمل تذكرة، واراد ان ينزل في محطة غزة، فدق جرس القطار مما جعل الساءق يقف بالقطار في المحطة، وتشاء الظروف ان مفتش السكك الحديدية كان من ركاب هذا القطار، فنزل في المحطة يبحث عن ناظرها كي يعاقبه علي هذا الاهمال. وعندما يذهب الي مكتب الناظر يري بلانش فيعجب بها، وعندما ياتي الناظر يطلب المفتش منه يد ابنته بلانش بدلا من ان يوقع العقاب عليه. وتنتهي المسرحية بذلك.

 تصريح وزارة الداخلية بتمثيل مسرحية «جرس الخطر».

 اما مسرحية «مدرس الرقص» لاميل عصايصو، فتدور حول عزمي بك الذي يدير مدرسة للرقص وللالعاب الرياضية بمساعدة ابنته انشراح وابنة اخيه مكارم. وانشراح تحب فءاد الموظف عند ابيها، كما ان مكارم تحب ايضا كامل احمد الموظفين البسطاء. وبعد فترة يتقدم برعي للزواج من انشراح، وهو رجل كبير في السن، فيوافق عزمي، ولكن ابنته ترفض. وفي يوم ما يصل لكامل خطاب من ابيه يخبره بانه كتب له ثروة كبيرة، فيتبرع كامل بجزء منها الي فءاد، وبذلك يوافق عزمي علي زواج ابنته وابنة اخيه من كامل وفءاد.

 اما مسرحية «يا بلاش»، فتدور حول زوجة تخون زوجها، وفي يوم اللقاء مع العشيق تجعل خادمتها تعمل علي السطح كي تنفرد بالعشيق في المنزل، وتجعل الباب مفتوحا كي يحضر العشيق. وفي هذا الوقت يحضر لص ويدخل الي غرفة النوم، واثناء سرقته لساعة ثمينة كانت موجودة في الدولاب يحضر العشيق فيختفي اللص في الدولاب. وبعد فترة قصيرة يحضر الزوج، فتقوم الزوجة باخفاء العشيق في الدولاب ايضا. وفي الدولاب يتفق اللص مع العشيق علي الهرب بالساعة مقابل عدم ابلاغ الزوج بعلاقته مع زوجته. وعندما يترك الزوجان الغرفة يهرب اللص من علي سطح المنزل، ولكن الخادمة تفلح في الامساك به، وعندما يحضر البوليس يظهر العشيق ويتضح الامر للزوج فيطلق زوجته.

 واذا نظرنا الي موضوعات الاسكتشات التي قدمت في هذا الموسم؛ نجد اسكتش «من رضي بقليله عاش» لجميل امين يدور حول كثرة المشاحنات الزوجية بين خميس وزوجته، بسبب كثرة طلباتها وعدم قيامه بشراء ما تتمناه. وفي يوم يحضر الزوج ويخبر الزوجة بانه اشتري ورقة يانصيب ويامل في ان تكسب الجاءزة الاولي. واخذ الزوجان يحلمان بهذا المكسب، وماذا يفعلان بهذا المال، فقال الزوج انه سيتزوج بهذا المال فتاة جميلة فقامت الزوجة علي الفور بتمزيق ورقة اليانصيب كي تحرم الزوج من احلامه.

 وفي صيف هذا الموسم انتقلت ببا بفرقتها كالعادة الي كازينو مونت كارلو بالشاطبي، تحت ادارة جميل جمعة، ابتداء من  /  / ، وفيه قدمت مسرحيات: «اكسبريس»، «الفلوس»، «مش شغلك»، «فرمل»، «يحيا الحظ»، «فتح عينك»، «غانيات نهر دجلة». واسكتشات: «بتنجان فيلم»، «الكونجا»، «اذ»، «الابرازريو»، «اذواق الحب»، «تمثيل زمان». واستعراضات: «سوق الفاكهة»، «زفة العرب»، «يا جنايني»، «صالون الجمال»، «اخر مودات». وهذه الاعمال من تلحين سيد مصطفي، فريد غصن، احمد صبرة. ومن تمثيل وغناء ورقص: ببا عز الدين، عبد النبي محمد، نزهة العراقية، بدرية العراقية، بدرية احمد، عفيفة اسكندر.

 

 صورة من استعراض «زفة العرب».

 وفي موسم  ضمت ببا الي فرقتها المطربة فتحية احمد، وعملتا معا في كازينو بديعة بشارع عماد الدين في الشتاء، وقدمت الفرقة مسرحيات: «المعلم خميس»، «بيجي بيجي بك»، «الحاج بلاتشي»، «مصوراتي الانس»، و«الدكتور» للنجدي. واسكتشي: « جنيه»، «حفلة مدرسية». واستعراضات: «ناح الحمام»، «غنو غنو»، «اخر رجل في العالم»، «عديني يا ريس»، «النجوم»، «ليه كده»، و«الزار»، «روب الليل» لمحمد مصطفي، و«الزفاف» للبدري، و«يا جميل» للهواري. وبعض هذه الاعمال كانت من تاليف انور وجدي، واغلبها من تلحين: سيد مصطفي، احمد صبرة، علي العريس، يوسف بدروس. ومن تمثيل وغناء ورقص: ببا عز الدين، فتحية احمد، فتحية شريف، عفيفة اسكندر، انصاف محمد، نزهة العراقية، سيد سليمان، اسماعيل ياسين، ليلي حلمي، امين عطا الله، ثريا حلمي، فكتوريا مسلم، محمد عبد المطلب، علي العريس، نادية العريس.

 

 نموذجان من اعلانات ببا عز الدين.

 وفي موسم  قدمت فرقة ببا عز الدين في صالتها بشارع عماد الدين شتاء وبكازينو محطة الرمل بالاسكندرية صيفا، مسرحيات: «كعبور افندي»، «جمرك القنطرة»، «حرامي الارستقراط»، «تدبير منزلي»، و«الدنيا حظوظ» لابي الخير، و«محطة العواطلية»، «عندك» لامين صدقي، و«قلم الطرود»، «دقن الباشا»، «اما ورطة» لمحمد اسماعيل وجميل جمعة. واسكتشات: «دار الكتب»، «تمثيل في الهواء الطلق»، و«ارباب الفن» لامين صدقي، و«فلاحة من اكسفورد»، «التسعيرة» لمحمد اسماعيل. واستعراضات: «ملكة الزهور»، «غرام الامير»، «اضحك للدنيا»، «بلابل اسبانيا»، «مقالب ابليس»، «درس في التاريخ»، «الحب العسكري»، «فتاة الاندلس»، و«غاب الحبيب»، «النمر المقدس»، لمحمد اسماعيل وجميل جمعة، و«افتكرك» لحسن توفيق.

 وهذه الاعمال من اخراج عزيز عيد، ومن تلحين: عزت الجاهلي، سيد مصطفي، احمد صبرة. ومن تمثيل ورقص وغناء: اسعد مصطفي، امينة محمد، انصاف محمد، ببا عز الدين، تحية كاريوكا، ثرية حلمي، جمالات حسن، حامد مرسي، حسين المليجي، حكمت فهمي، خيرية صدقي، زينب السودانية، سميحة حسن، سميرة امين، سنية شوقي، سيد سليمان، سيد فوزي، سيد مصطفي، عايدة، عبد العزيز احمد، عبد النبي محمد، عزيز عيد، عقيلة راتب، فتحية فءاد، فتحية محمود، فيفي، كيكي عمار، محمد التابعي، محمد السباعي، محمد عبد المطلب، ميمي صيداوي، نادية العريس، هجران، هلدا.

 

 وظلت ببا عز الدين تواصل عملها الفني، حتي استطاعت ان تشتري كازينو الاوبرا تحت ادارة جاك، الذي كانت تملكه بديعة مصابني ثم ببا عز الدين، وقدمت عليه عروضا مسرحية وغناءية كثيرة كانت من تاليف ابي السعود الابياري، مثل مسرحية «يختي عليه» التي قدمت في  /  / ، من تلحين عزت الجاهلي، ومن تمثيل وغناء: ببا عز الدين، ثريا حلمي، حورية حسن، احمد عبد الله، سيد فوزي، عبد النبي محمد، فهمي امان، شوشو، نادية سلامة، زيزي سعيد، احمد عبد الحليم، ليز، لين.

 وفي  /  /  لقيت ببا عز الدين مصرعها في حادث سيارة اثناء عودتها من مدينة طوخ، بعد ان اشترت عزبة خاصة بها. وهكذا انتهت حياة هذه الفنانة التي كونت فرقة تمثيلية غناءية ضمت عددا من المشاهير، امثال: ابو العلا علي، احمد عبد الحليم، احمد عبد الله، اسعد مصطفي، اسماعيل ياسين، اليس، امين عطا الله، امينة محمد، انصاف محمد، انطوان عيسي، بدرية احمد، بدرية العراقية، بيونشتا، تحية كاريوكا، تيتي، ثريا حلمي، جمالات حسن، جميل جمعة، جينا، حامد مرسي، حسين ابراهيم، حسين المليجي، حكمت فهمي، حورية حسن، خيرية صدقي، ديوريلس، رجاء رستم، رجاء عبده، روز عازوري، زوزو لبيب، زيزي سعيد، زينب السودانية، سارة، سعاد عبده، سميحة حسن، سميرة امين، سنية شوقي، سيد بهنسي، سيد سليمان، سيد فوزي، سيد مصطفي، شوشو، صفية حلمي، عايدة، عبد الحليم القلعاوي، عبد العزيز احمد، عبد النبي محمد، عزيز عيد، عفيفة اسكندر، عقيلة راتب، علي العريس، فتحية احمد، فتحية الشريف، فتحية فءاد، فتحية محمود، الفريد حداد، فكتوريا مسلم، فهمي امان، فيفي، كريمة احمد، كيكي المسيري، كيكي عمار، لونا، ليز، ليلي الشقراء، ليلي حلمي، ليلي عاصم، لين، محمد ادريس، محمد التابعي، محمد السباعي، محمد عبد المطلب، محمود التوني، مفيدة احمد، موسي حلمي، ميمي صيداوي، نادية العريس، نادية سلامة، نزهة العراقية، نعمات المليجي، هجران هانم، هلدا.





  صالات اخري




 اذا كنا فيما سبق قد اسهبنا بعض الشء في الحديث عن صالات بديعة ورتيبة وانصاف وببا، فهذا راجع الي ان هذه الصالات من اهم الصالات الفنية التي استمرت فترات طويلة تقدم العروض المسرحية، بخلاف الصالات الاخري التي كانت مخصصة للغناء والرقص فقط، مثل: صالة فاطمة قدري، وصالة نعيمة المصرية، وصالة سعاد محاسن بالبيجو بالاس.

 سعاد محاسن واحد اعلانات صالاتها.

 كما كانت توجد بعض الصالات تتشابه الي حد كبير مع صالات بديعة ورتيبة وانصاف وببا، ولكن لم يكتب لها الاستمرار؛ حيث كانت تقدم بعض المواسم المتقطعة. وسنتوقف عند محطات معينة من تاريخ هذه الصالات.

 صالة ماري منصور

 ولدت ماري منصور في مدينة المنصورة عام ، وهي من الممثلات القلاءل التي تتحدث اكثر من لغة؛ منها الفرنسية والايطالية واليونانية. وقد تزوجت ماري ثم طلقت بعد ان رزقت بموريس وعايدة. وبدايتها الفنية كانت في مسرح رمسيس عام ، حيث قامت بتمثيل اغلب مسرحيات يوسف وهبي، ومنها: «الناءب هالير»، «راسبوتين»، «متي نتزوج»، «الذباءح»، «القاتل»، «كاترين دي مدسيس». وفي اواخر عام  انضمت ماري الي فرقة نجيب الريحاني، ومثلت مسرحيات: «الجنة»، «الشرك»، «حبوب عنتر»، «اللصوص». وفي مايو  انضمت الي الفرقة المستقلة، ومثلت في مسرحية «غلطة حصان» وفي اواخر عام  عادت مرة اخري الي فرقة رمسيس، وشاركت في تمثيل مسرحيات: «ملك الحديد»، «الفريسة»، «دكتور جيكل ومستر هايد»، «الجريمة».

 

 تركت ماري منصور التمثيل المسرحي، وافتتحت قبل عام  بشارع عماد الدين صالة للغناء والرقص والتمثيل، اطلقت عليها «صالة ماري منصور» وفي صيف  انتقلت بفرقتها للعمل بصالة اوزويتا بالاسكندرية.

 

 ويعتبر اهم موسم لماري منصور هو موسم ، حيث افتتحت فيه كازينو البسفور بميدان محطة باب الحديد، وكانت تقوم بادارته مع امتثال فوزي.

 وفي هذا الكازينو قدمت فرقتها مسرحيات: «خمسة وخميسة»، «استاذ البيانو»، «اسبتالية المجاذيب»، «الحبصبطول»، «الحدق يفهم»، «حاجة تفلق»، «الجهل نور»، «ادي العينة»، «اولاد العز»، «اللي ما يشتري يتفرج»، «التامين علي الحياة»، و«قلبي عندك» لصالح سعودي، و« فدان» لامين صدقي، و«سمكري الحظ» لمحمد البيه. كما قدمت ماري منصور اسكتشات: «شارع الكورنيش»، «متحف الشمع»، «زفة عروسة الفلاحين»، «الاسعاف»، «دين مصر»، «يا ننا نامي»، «مدام كنج كنج»، «رومية اخر ساعة»، «عشاق القمر»، «البوكس»، «فيضان النيل»، «الحب الاسبانيولي»، «يا ولاد الايه»، «مملكة الشياطين»، «المتنزهات العمومية»، «اللي يلعب بالنار»، «مكتب كل شء»، و«علي البلاج» لامين صدقي، و«بدر البدور»، «الحبيب المهاجر»، «عشاق القمر» لصالح سعودي، و«متحف الشمع» لمحمود الناصح. واخيرا قدمت استعراضين، هما: «مدرسة النكت»، «هيق هيق». وهذه الاعمال من تمثيل وغناء: ماري منصور، امتثال فوزي، عبد اللطيف جمجوم، عبد العزيز احمد، احمد عبد الله، محمود عقل، حكمت فهمي، حورية، زيزي، جينا، كوثر، حكمت كامل، اديل، فيتا، برفيكيتو، كيرا.

 

 صالة المطربة ملك

 بدات المطربة ملك  واسمها الحقيقي زينب محمد الجندي  كمغنية، ثم تالقت في الغناء مع تختها الموسيقي في عام  عندما كانت تغني الطقاطيق والادوار بين فصول مسرحيات فرقة عكاشة، وبالاخص مسرحية «الميت الحي» وفي ديسمبر ، اشتركت بالغناء في مسرحيات فرقة الجزايرلي وفوزي منيب بمسرح البسفور. وفي سبتمبر  انضمت كمطربة وممثلة في فرقة امين صدقي، حيث قامت ببطولة عدة مسرحيات علي مسرح سميراميس بشارع عماد الدين، ومنها: «الكونت زقزوق»، «مملكة العجاءب»، «عصافير الجنة». وبعد ذلك انفصلت عن الفرقة بسبب تاخر امين صدقي في دفع راتبها، ومن ثم عادت الي تختها لتغني الطقاطيق بكازينو البوسفور، وتحيي حفلات الجمعيات الخيرية، ومنها جمعية المواساة الاسلامية، وكان يطلق عليها في ذلك الوقت «مطربة العواطف».

 

 اتجهت المطربة ملك بعد ذلك الي تكوين فرقة خاصة بها للغناء والتمثيل المسرحي، وكانت تقدم اعمالها علي مسرح البوسفور عام ، وظلت فيه مدة طويلة، حتي تركته وبدات تعرض علي مسرح برنتانيا عام ، حيث قدمت مسرحيات: «الطابور الاول»، «طرزان يجد ام احمد»، «مايسة»، «مدام بترفلاي»، والعملان الاخيران لبيرم التونسي، ومن اخراج فءاد الجزايلي، ومن تمثيل حسين صدقي. كما قامت ملك في هذه الفترة ببطولة فيلم «العودة الي الريف» من اخراج احمد كامل مرسي.

 وبعد ذلك استاجرت ملك لفرقتها قطعة ارض كانت مملوكة للاميرة شويكار، واقامت عليها مسرحا اطلقت عليه «مسرح اوبرا ملك»، وهو يقع في شارع خليج الخور المتفرع من شارع عماد الدين، وافتتحته يوم  /  /  باوبريت «عروس النيل»، تاليف محمود تيمور، ومن اخراج زكي طليمات، ومن تمثيل: صلاح نظمي، عبد البديع العربي، كامل انور. وعلي هذا المسرح قدمت فرقتها العديد من المسرحيات، ومن اشهرها مسرحية «بنت بغداد»، تاليف بيرم التونسي، هذا بالاضافة الي مسرحيات: «اميرة ومملوك»، «سعدي»، «سفينة الغجر»، «طباخة بريمو»، «درية»، «روميو وجوليت»، «حاوي افرنجي»، «جواهر»، «الحب الاول»، «عشاق بالجملة»، «ليالي شهرزاد»، «حلويات»، «زينة»، «بلبل»، «بنت السلطان».

 وهذه الاعمال كانت من تاليف: محمود تيمور، صالح جودت، بيرم التونسي، عبد الحميد كامل، السيد زيادة، عبد العليم خطاب. وكانت من تلحين ملك نفسها، ومن اخراج فءاد الجزايرلي، زكي طليمات، حسن حلمي ، ومن تمثيل: محسن سرحان، السيد بدير، عبد المنعم اسماعيل. وظلت ملك تعمل في المجال الفني حتي توقفت نهاءيا عام ، بعد حريق القاهرة الذي دمر مسرحها تدميرا كاملا.

 

 وكان من المقرر ان تمثل عليه مسرحيتها الجديدة «افديه».

 صالة فتحية احمد

 ولدت مطربة القطرين فتحية احمد سري عام ، بحي الانفوشي بالاسكندرية. وبدات التالق الفني وهي في سن العاشرة من عمرها، حيث كان يتسابق مديرو الفرق المسرحية للاتفاق معها علي الغناء بين الفصول، وخصوصا الفرق المسرحية الشامية.

 الاحتفال العظيم بعيد شم النسيم.

 اما تالقها الغناءي المسرحي، فقد وصل ذروته في عام ، عندما التحقت بفرقة نجيب الريحاني بتياترو الاجبسيانة، حيث اشتركت بالغناء في مسرحيات: «حمار وحلاوة»، «ولو»، «ام احمد». وفي نفس العام اشتركت ايضا بالغناء في مسرحيات نادي التمثيل العصري، ومنها: «السقا»، «الا بلاش»، «جه يكحلها»، «الضحية». وفي عام  انضمت الي فرقة امين عطا الله وكاميل شامبير بتياترو الماجستيك، حيث اشتركت في غناء مسرحية «نعيما». وفي عام  انضمت الي فرقة امين صدقي وعلي الكسار، واشتركت في غناء وتمثيل مسرحية «راحت عليك» وفي عام  قامت بادوار البطولة في مسرحيات فرقة منيرة المهدية، بدلا من منيرة التي تركت الفرقة بسبب مشاكلها مع زوجها محمود جبر. ومن هذه المسرحيات: «كلام في سرك»، «ادنا»، «التالتة تابتة»، «الكابورال سيمون». وفي عام  انضمت فتحية الي فرقة امين صدقي ونجيب الريحاني، حيث قامت ببطولة مسرحيات: «قنصل الوز»، «مراتي في الجهادية»، «بنت الشبندر». وفي عام  اشتركت بالغناء في مسرحية «ليلة كليوباترا» لفرقة عكاشة. وفي عام  مثلت دور كليوباترا في مسرحية «كليوباترا ومارك انطوان» لفرقة منيرة المهدية، كما شاركت بتختها الموسيقي في الغناء بين فصول مسرحية «الامبراطور» لفرقة فاطمة رشدي.

 

 صورتان لفتحية احمد.

 وكان هذا العمل هو اخر عهد لها بالتمثيل والغناء المسرحي في هذه الفترة، حيث اتجهت بعد ذلك الي العمل الغناءي في الكازينوهات والصالات، وذلك في اواخر عام ، ومنها كازينو البوسفور، وصالة بديعة مصابني.

 

 وفي عام ، وبعد احتجاب طويل عن الفن كونت فتحية احمد فرقة مسرحية استعراضية، وافتتحت بها صالة مكشوفة بالكوبري الانجليزي، اطلقت عليها «حديقة فتحية»، وفيها عرضت مسرحيات: «اشكرك»، «انا المصري»، «النكتة البريءة» لمحمد اسماعيل. هذا بالاضافة الي استعراض «افتتاح كوبري الخديو اسماعيل» وهذه الاعمال كان من تلحين ابراهيم فوزي، وبطولة فتحية احمد.

 

 وفي عام  تركت فتحية حديقتها وعادت مرة اخري الي الغناء في صالات ومسارح الاخرين، مثل: صالة ببا، ومسرح رمسيس؛ حيث اشتركت بالغناء في مسرحيات: «صندوق الدنيا»، «اولاد الفقراء»، «الفاجعة» ... لفرقة يوسف وهبي. وظلت فتحية احمد بعد ذلك تعمل في مجال الغناء والتمثيل المسرحي والسينماءي فترة كبيرة، وكان من اهم افلامها «حنان»، وقامت ببطولته مع بشارة واكيم وتحية كاريوكا، ومن اخراج كمال سليم. وعندما بلغت فتحية احمد سن الخمسين اعتزلت العمل فترة طويلة حتي ماتت في  /  / .

 

 صالة حياة صبري

 تتلمذت المطربة حياة صبري،

 

 علي يد المرحوم الشيخ سيد درويش، الذي تزوجها فيما بعد. وقد بدا تالقها الغناءي عام  عندما عملت بفرقة امين عطا الله. وفي عام  انضمت الي فرقة الجزايرلي بكازينو البوسفور، وفي العام نفسه انضمت الي فرقة فوزي منيب بكازينو مونت كارلو بروض الفرج. وفي عام  عملت بصالة الاوبرا بالاسكندرية. وفي عام  كونت حياة صبري مع عبد اللطيف جمجوم فرقة مسرحية عملت بكازينو ليلاس بروض الفرق، ومثلت مسرحيات قليلة، منها مسرحية «انا وانت»، تاليف نجيب الريحاني وبديع خيري، ولكن هذه الفرقة لم تستمر طويلا.

 

 وفي عام  كونت حياة صبري فرقة مسرحية غناءية خاصة بها، عملت علي مسرح كازينو البسفور، حيث قدمت الكثير من الاسكتشات والاغاني للشيخ محمد يونس القاضي، ومنها اسكتش «فاتنة الاندلس»، تلحين عبده قطر نصر، واسكتش «عاشق الطبيعة» لنعيم مصطفي، تلحين جمال حمدي.

 

 وفي عام  وجدنا حياة صبري ضمن فرقة علي الكسار التي تعمل نهارا بكازينو سان استفانو بروض الفرج، وليلا في كازينو وكباريه الماجستيك. وفي عام  وجدناها كونت فرقة مسرحية غناءية بالفيوم، حيث كانت تعرض اعمالها بصالة تودري، ومنها مسرحية «علشان سواد عينها»، بطولة: يحيي المصري، حياة صبري، افكار كامل، محمد يوسف، كامل محمود. وظلت حياة صبري علي قيد الحياة حتي عام ، حيث كانت عضوة في نقابة المهن التمثيلية، وتحمل عضوية رقم «».

 

 صالة حورية محمد

 بدات حورية محمد عملها الفني في صالة بديعة مصابني عام ، وفي عام  كونت فرقة مسرحية خاصة بها، عرضت اعمالها علي مسرح كازينو مونت كارلو وكازينو الف ليلة بمحطة الرمل بالاسكندرية، ومن هذه الاعمال مسرحيات: «عين الحسود»، «بشاير الانس»، «اصحاب العقول»، «كذبة ابريل»، «مانجة وفراولة»، «جوز بماهية»، «جزيرة الورد»، «دقة المعلم»، و«الاستاذ بعرور» لوليم باسيلي. هذا بالاضافة الي اسكتشات: «بيانو الانس»، «لعنة الفراعنة»، «الكروان»، «الدنيا حر»، «امال مصر»، «جزيرة الذهب»، «مصر بعد المعاهدة»، «بلاد نم نم»، «رقصة المتوحشين»، «مجد الفراعنة». وهذه الاعمال كانت بطولة حورية محمد ورياض القصبجي.

 

 تصريح وزارة الداخلية بتمثيل مسرحية «عين الحسود». 

 وابتداء من عام  اتجهت حورية محمد الي الاشتراك بالرقص في الافلام السينماءية، ومنها فيلم «بحبح في بغداد»، بطولة فوزي الجزايرلي ومحمد الكحلاوي، الذي عرض بسينما مصر بشارع فاروق. كما شاركت ايضا عام  في فيلم «القرش الابيض»، بطولة: فوزي الجزايرلي، ليلي فوزي، عباس فارس، محمود اسماعيل، ثريا حلمي، اسماعيل ياسين. وهذا الفيلم كان من اخراج ابراهيم عمارة، وعرض بسينما رويال بالقاهرة. وظلت حورية محمد علي قيد الحياة حتي عام ، حيث كانت عضوة في نقابة المهن التمثيلية وتحمل عضوية رقم «».

 

 حورية محمد.

 واذا تطرقنا للموضوعات التي قدمتها فرقة حورية محمد، سواء بالنسبة للمسرحيات او الاسكتشات، سنجد موضوع «بشاءر السعد» يدور حول اميرة هندية اتت برجل اسمه «سمسم» الي قصر الحكم. وكان هذا الرجل يشبه والدها بصورة كبيرة، وهذا هو سبب استضافتها له. وعندما تحاول اخبار والدها الحاكم بهذه المفاجاة تجده متغيبا، حيث سافر الي احدي البلاد المجاورة كي يقيم معاهدة مع حاكمها. وفي فترة غياب الحاكم الحقيقي تحدث عدة مفاجات في القصر والدولة بسبب التشابه الكبير بين سمسم والحاكم.

 ويدور موضوع «بيانو الانس» لمحمود ناصح حول فلفل افندي، الذي يحرم علي اخته حورية اعطاء دروس البيانو لغير الجنس اللطيف. وفي يوم يحضر عمدة من الارياف لاخذ درس في البيانو، وفي هذا الوقت يحضر فلفل منفعلا ، فتضطر حورية لاخفاء العمدة خلف البيانو، ويخبرها فلفل بانه عاكس احدي السيدات في الطريق العام، فاستغاثت بالشرطي الذي يطارده الان، وهنا يطرق الشرطي باب الشقة بقوة، فيضطر فلفل للهرب من سطح المنزل، وعندما يقتحم الشرطي المنزل يجد العمدة، فيظنه الرجل المطلوب، وعندما يقبض عليه يخرج العمدة بطاقة توصية من احد الباشوات، فيضطر الشرطي لاطلاق سراحه.

 ويدور موضوع «الاستاذ بعرور» لوليم باسيلي حول سهام ابنة محروق بك، الذي يحاول ان يزوجها من رجل غني فيتقدم له مجموعة من الخطاب، فيقع اختياره علي الاستاذ بعرور لانه ثري جدا، رغم ان اصدقاءه يصفونه بالابله. وبعد الزواج يشاهد بعرور زوجته في حالة انفراد بشاب في بيت الزوجية، وعندما يسالها عنه تقول انه ابن عمها، وهو في الحقيقة عشيقها «لطيف». وبعد عدة مواقف مماثلة تنهرها ام بعرور، وتعاتبها علي هذه التصرفات المشينة، وبدلا من ان نجد الزوج يثور لكرامته وشرفه ويقف بجانبه امه، نجده يعاتب الام ويلتمس الاعذار لزوجته، ويحاول ارضاءها كي تمكث في البيت ولا تتركه.

 اما موضوع «دقة المعلم» لمصطفي ابراهيم، فيدور حول كوكا التي تتزوج حديثا من المعلم رحرح الجزار، وتاتي زوزو صديقة الزوجة لتبارك الزواج، فتعلم من صديقتها ان زوجها من الاغنياء، فتفكر الصديقة في مكيدة تستطيع من خلالها ان تجعل رحرح يطلق زوجته ويتزوجها هي. وتتمثل هذه المكيدة في ان وضعت بذور الشك في نفس الزوج تجاه زوجته، وقامت بنفس الشء بالنسبة للزوجة. وبعد عدة مواقف كوميدية تنكشف المكيدة للجميع، فيعود الزوجان لعش الزوجية مرة اخري بعد ان وقع الطلاق بينهما.

 صالة فتحية محمود

 بدات فتحية محمود  واسمها الحقيقي رقية محمود سليمان  عملها الفني كممثلة وراقصة عام ، عندما انضمت الي فرقة ببا عز الدين بكازينو مونت كارلو بالشاطبي بالاسكندرية، حيث شاركت في تمثيل الكثير من مسرحيات واسكتشات واستعراضات الفرقة، ومنها: «اشمعني»، «غلطة»، «متحف الفن»، «الوان الحب»، «قشطة»، «واق الواق»، «يا كتاكيتها»، «علي البلاج»، «الناس مقامات»، «كنج كونج»، «ازمة عمال». وفي نفس العام انضمت فتحية ايضا الي صالة بديعة مصابني، حيث شاركت في عروض: «كتب كتاب الهنا»، «شهيرات النساء»، «عرايس النيل»، «جوز الاثنين»، «المتحف».

 

 وفي عام  كونت فتحية محمود فرقة خاصة باسمها، عملت بكازينو البسفور، تحت ادارة جميل جمعة، حيث عرضت مسرحيات: «هنونا يا حبايب»، «الفقر حشمة»، «الريال جري»، و«يا واخد ندك» لامين صدقي. واسكتشات: «مراية الحب»، «الزار»، و«بشاير الهنا» لامين صدقي، و«راس السنة لابن الليل». واستعراضي: «يا واحشني»، و«خدامات موديل » لامين صدقي. وهذه الاعمال من تلحين محمود الشريف، ومن تمثيل: فتحية محمود، حسن سلامة، ابراهيم حمودة، احمد فريد، علي كامل.

 

 وفي عام  حلت فتحية فرقتها وانضمت الي فرقة ببا عز الدين مرة اخري، وشاركت في تمثيل عروضها التمثيلية، ومنها: «القصر المسحور»، «امنت بالله»، «مدرسة الرقص»، «وحوي يا وحي»، «جه يكحلها»، «يا ضنايا»، «جراند اوتيل»، «ابو زيد»، «عرسان للبيع»، «اصطلحنا»، «درس نحوي»، «المواصلات».

 

 وفي عام  كونت فتحية محمود فرقة مسرحية بالاشتراك مع فوزي منيب، كانت تعمل بكازينو نرفانا بالاسكندرية، حيث قدمت مسرحية «سكرة ليلة امبارح»، واسكتش «حلويتنا». وقدمت ايضا مسرحية «دقة المعلم» اقتباس كامل عبد السلام.

 

 تقرير الرقابة عن مسرحية «دقة المعلم» لفرقة فوزي منيب وفتحية محمود.

 تصريح وزارة الداخلية بتمثيل مسرحية «دقة المعلم» لفرقة فوزي منيب وفتحية محمود.

 وفي عام  انضمت فتحية محمود مرة اخري الي كازينو وكباريه بديعة مصابني بشارع عماد الدين، حيث اشتركت في الموسم الشتوي فقط، اما في الصيف فقد افتتحت كازينو كوت دازور بالاسكندرية تحت ادارة عبد النبي محمد، ومثلت بفرقتها مسرحيات: «بنسيون للايجار»، «خليك معايا»، و«عايدة» لمحمد اسماعيل. واسكتشات: «الحب الاسبانيولي»، «نادي الفنون»، «محصل الدايرة». واستعراضات: «الجهاد»، «الجواز»، «الحب الصيفي». وهذه الاعمال من تلحين محمود الشريف، ومن تمثيل: فتحية محمود، عبد النبي محمد، عقيلة راتب، يوسف حسني، حسين المليجي، نعمات المليجي، حسين ابراهيم.

 

 وفي عام  ايضا شاركت فتحية محمود فرقة فاطمة رشدي في العديد من الاعمال المسرحية، التي كانت تعرض بكازينو مونت كارلو، ومنها مسرحيتا «الشايب» و«المعلم حنفي»، واسكتشي «السندباد القبلي» و«عزراءيل في اجازة». وفي اواخر عام  انضمت فتحية للمرة الثالثة الي فرقة ببا عز الدين، وشاركت في تمثيل مسرحيتي «دقن الباشا»، و«عندك»، وفي استعراض «درس في التاريخ». وفي عام  انضمت الي فرقة علي الكسار التي كانت تعمل بكازينو سان استفانو بروض الفرج.

 

 وفي اواخر حياتها الفنية كونت فتحية محمود فرقة مسرحية استعراضية، عملت بها في اوبرج الترف خلف سينما ستوديو مصر، حيث قدمت اعمالا فنية من تاليف ابراهيم كامل رفعت. وكان من اعضاء فرقتها: سيد اسماعيل، عادل مامون، نادية فهمي، ناهد احمد، الراقصة كيتي، امينة السيد، شوشو سليم، نادية ابراهيم، سعاد احمد، عزيزة علي، فوزية سليمان، ملكة حمدي، نعيمة حسن، فكرية علي، ميمي محمد، كريمة محمود، عزيزة غنيم. اوركستر محمد فياض، تخت يعقوب طاطيوس، مدرب الرقص كلاكادكس، مدير المسرح عرابي سالم. وفي عام  انضمت فتحية محمود الي نقابة المهن التمثيلية، وكانت تحمل عضوية رقم .

 

 ولفظت انفاسها الاخيرة في مايو .





