 وكان يسمع شكوي المظلوم ، ويتولي كشف حاله بنفسه، ولا يكل ذلك الي حاجب ولا امير ولا غيره.
 لا جرم سار ذكره شرقا وغربا.
 وكان واقفاعند اوامر الشرع ، معظما لحرماته ، ويقول : نحن شحن() له واتفق انه كان يوما يلعب بدمشق بالكرة، وانه التفت فراي رجلا يحدث اخر، ويومء بيده اليه، فارسل اليه يساله عن حاجته، فقال : لي مع الملك العادل حكومة، وهذذا غلام القاضي ليحضره الي مجلس الحكم العزيز بسبب الملك الفلاني، فعاد اليه الرسول ولم يتجاسر ان يعرفه ما قال ذلك الرجل، فقال له : قل وما عليك في ذلك، انما انت مخبر، فذكر له مقالة الرجل ، فالقي الجوكان () من يده مسرعا وقال : قال الله تعالين : ( انما كان قول الشءمنين اذا دعوا الي الله ورسوليه ليخكر بينهم ان يقولوا سمعنا واطعنا) ، سمعا وطاعة لله عز وجل و لرسوله صلي الله عليه وسلم ثم خرج من الميدان، وسار الي القاضي، وارسل اليه يقول له: انني قد جءت محاكما، فاسلك معي مثل ما تسلك مع غيري وكان القاضي يومءذ كمال الدين الشهرزوري، فلما حضر نور الدين. . ساوي بينه وبين صه وحاكه، فلم يثبت علي نور الدين حق، وثبت الملك له فقال نور الدين حينيذ للقاضي ومن حضره : هل ثبت له عندي حق ؟ قالوا : لا، قال : فاشهدوا علي اني قد وهبت له الملك الذي قد حاكمني عليه، وهو في حل منه، وقد جعلته له دوني، وانا كنت اعلم انه لا حق له عندي، وانما حضرت معه تعظيما لحرمات الشرع، ولءلا يظن بي اني ظلمته ، فحيث ظهر ان الحق لي. . فقد وهبته له .
 واستدعي نور الدين ايضا مرة اخري بحلب الي مجلس الحكم بنفسه او ناءبه، فدخل حاجبه عليه متعجبا، واعلمه ان رسول الحاكم بالباب، فانكر عليه تعجبه وقام مسرعا، فوجد في اثناء طريقه ما منعه من العبور من حفر جب في بعض الحشوش، واستخراج ما فيه، فوكل من ثم وكيلا، واشهد عليه بالتوكيل ورجع: () الشحن جمع شحنة، وهي : الجماعة التي يقيمها السلطان في بلد ما لضبطه .
 () الجوكان : عصا معقوفة يلعب بها السلطان في قذف الكرة، وهي من الرياضات التي كان يمارسها سلاطين الدولة النورية والابوبية والمملوكية:


 ============================================================
 وكان من جملة عدله : انه لم يكن يعاقب علي الظنة والتهمة، بل علي وفق الشرع الشريف بطلب البينة علي المتهم، فان قامت البينة الشرعية. . عاقب العفوية الشرعية من غير تعد ولا مجاوزة عليها.
 وقامت بهذا الفعل والقصد الجميل بلاده كلها مع سعتها، وقل المفدون ببركة العدل واتباع اوامر الشرع الشريف ، واندفع عن الناس من الشر ما يوجد في غير ولايته، مع شدة السياسة والمبالغة في العقوبة وحكي قاضي القضاة بهاء الدين ابو المحاسن يوسف بن رافع بن تميم : ان نور الدين كان في كل سنة في شهر رمضان يطلب من الشيخ عمر الملاء شيءا يفطر عليه، فكان الشيخ عمر يرسل اليه الاكياس فيها الفتيت والوقاق() وغير ذلك، فكان نور الدين يفطر عليه، وكان اذا قدم الموصل . . لا ياكل الا من طعام الشيخ عمر الملاء : وكان قد امر نوابه في جميع بلاده الا يعملوا شيءا الا بالشرع الشريف ، وهو الذي يامر به القضاة وكان يقول لقاضي الموصل ولناءبه ان ياتمروا بما يقوله الشيخ عمر الملاء؛ لعلمه وصلاحه، فكان الناءب بالموصل لا يعمل شييا بالسياسة، ويطلب الشحنكية().
 فجاء اكابر الدولة وقالوا للناءب : قد كثر الثعار() وارباب الفساد، وهلذه الاشياء لا تجء الا بالقتل والصلب ، فلو كتبت الي نور الدين تستاذنه في ذلك : فقال : انا لا اجسر ان اكتب اليه في هاذا المعني ، ولككن قولوا للشيخ عمر يكتب اليه، فحضروا عنده ، وسالوه في ذلك ، واخبروه بان هذذه الاشياء لا تقوم الا بالقتل والصلب ، وتحتاج اليل نوع سياسة، وقالوا : اذا اخذ مال انسان في البرية. . من يجء يشهد له ؟ فكتب الشيخ عمر اليل نور الدين وقال : ان الثعار والمفسدين وقطاع الطريق قد كثروا ، ويحتاج هذذا الي نوع سياسة، ومثل هذذا لا يجء الا بقتل وصلب وضرب ، واذا اخذ مال الانسان في البرية. . من يجء يشهد له؟ فلما وصل اليه الكتاب. . قلبه وكتب علي ظهره : () الفتيت والرقاق : من انواع الخبز ، فالاول ما فت من الخبز وتكر ، والثاني : الخبز المبسط الرقيق .
 () الشحنكية : طاءفة من السحاربين مهمتهم حراسة البلد ومنشاتها، يراسهم الشحنة؛ اي : رنيس الشرطة او ال () الاعار : جمع داعر، وهو : المفسد في الارض بتمرده وعدم قبوله للموعظة .



