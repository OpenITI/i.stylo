 وقال مءلفه محمد بن الحسن عفا الله عنهما : هذا الجواب الذي اجاب به سهل التستري رحمه الله فيه سر خفي شريف، ومعني غامض لطيف، ساذكره قريبا ان شاء الله تعالي.
 وقال رويم : الاخلاص : هو الا يريد صاحبه عليه عوضا في الدارين، وهذا قريب مما اجاب به سهل، او هو هو؛ فان حظوظ النفس من الافات، سواء اكانت عاجلة ام اجلة، اذ العامل لاجل الشهوات في الجنة لاحظ الحظوظ الاجلة ، كما سنبين ذلك ان شاء الله تعالي: وقال ابو عثمان المغربي قدس الله روحه : الاخلاص : ما ليس للنفس فيه حظ بحال، وهذا اخلاص العوام، اما اخلاص الخواص : فهو ما يجري عليهم لا بهم، فتبدو منهم الطاعات من غير رءية منهم لها، كانهم عنها بمعزل، ولا يقع لهم عليها رءية ولا بها وقال يحيي بن معاذ الرازي : الاخلاص : تمييز العمل من العيوب كتمييز اللبن من بين الفرث والدم.
 وقال الفضيل بن عياض رحمه الله : ترك العمل لاجل الناس رياء ، والعمل لاجل الناس شرك، والاخلاص : ان يعافيك الله منهما.
 وقال بعضهم : هو دوام المراقبة، ونسيان الحظوظ كلها وقال الامام ابو حامد الغزالي  قدس الله روحه  : وهذذا اجمع الاقوال واقربها الي التحقيق، والاقوال في هلذا كثيرة ولا فاءدة في تكثير النقل بعد انكشاف الحقيقة() .
 وقالت فاطمة النيسابورية رحمها الله : من عمل علي رءية المشاهدة له جل جلاله.. فهو عارف، ومن عمل علي مشاهدة الحق عز وجل اياه. . فهو مخلص وقال بعضهم : المخلص : هو الذي يري عظيم منة الله عز وجل عليه في الاخلاص اكبر من الاخلاص حتي يغرق اخلاصه في المنة.
 والله سبحانه اعلم () الاحياء (/)


 ============================================================
 الفصل الثالث في مراتب المخلصين و راتبهم مختلفة بحسب اخلاصهم المرتبة الاولي  وهي اعلاها  : اخلاص الخواص : وهم الذين ياتون بالعبادات علي الوجه المامور به، وقد علم الله سبحانه وتعالي منهم انهم ليس لهم مقصود ولا هم في الدارين الا هو سبحانه وتعالي ، من ابتغاء رضوانه ، والنظر الي وجهه الكريم عز وجل؛ قال الله تعالي : ( يدعوب رنبهم بالغدوة والشتني يرييون وجهه ومن تتبع احوال الصحابة والتابعين وتابعيهم رضوان الله عليهم اجمعين.. وجدها علي ذلك ، وانهم قد اكتالوا من ذلك بالمكيال الاوفل ، وحازوا منه النصيب الاوفر، الا تري الي قول ابي سليمان الداراني رحمه الله حين سثل عن اقرب ما يتقرب به العبد الي ربه عز وجل، فيكل وقال : مثلي يسال عن هذا ؟! افضل ما يتقرب به العبد الي ربه عز وجل : ان يطلع علي قليك وانت لا تريد من الدنيا والاخرة شيءا غيره سبحانه وتعالي.
 وقال ابو سليمان ايضا : لو لم يكن لاهل المعرفة الا هذه الاية الكريمة .. لاكتفوا بها وافتخروا بها كل الفخار : ( وجوه يومهذ تاضرة * الي رتها ناظرة)، واي شء اراد اهل المعرفة ؟
 والله؛ ما ارادوا الا ما اراده النبي الكريم عليه الصلاة والسلام ، وهو رءية الله عز وجل: وقال يحيي بن معاذ : خرج الزاهدون من الدنيا بداء لا يشفيهم الا دخول الجنة، وخرج العارفون من الدنيا بداء لا يشفيهم الا رءيته سبحانه وتعالي.
 وقد قال ابراهيم بن ادهم لرجل : ما تري غاية العابدين من الله عز وجل في انفسهم ؟
 فقال : اظن سكني الجنة ، فقال ابراهيم : لقد ظننت ظنا ، والله؛ اني لاري اكبر الامر عندهم الا يعرض بوجهه الكريم عنهم سبحانه وتعالي.
 وقد قال ابو سليمان الداراني : ارجو ان اكون قد رزقت من الرضا طرفا ؛ فانه لو ادخلني النار.. لكنت بذلك راضيا .
 وقد قال غير واحد من العارفين : لو ادخلني الله عز وجل النار. . لكنت اشد رضا من بعض من هو في الجنان:


 ============================================================
 وقد سثل ابو الحسين النوري عن الرضا، فقال : عن وجدي تسالوني، او عن وجد الخلاءق؟ فقيل له : عن وجدك، فقال : لو كنت في الدرك الاسفل من النار.. لكنت ارضي ممن هو في الفردوس: وقال سهل التستري : قال العارفون: ليس خوفنا من نار جهنم ولا رجاءنا للحور العين، انما خوفنا من الحجاب، ومطلبنا لقاء الله عز وجل: وقد جاء ان بعض اهل الجنة لو حجب عن رءيته عز وجل.. لاستغاث من الجنة كما يستغيث اهل النار من النار:.
 وقد حكي غير واحد عن احمد بن خضرويه انه قال : رايت رب العزة جل جلاله في النوم ، فقال : (يا احمد؛ كل الناس يطلبون مني الا ابو يزيد ؛ فانه يطلبني) : وقد قال بعض اصحاب معروف : رايت معروفا الكرخي في المنام بعد موته كانه واقف تحت العرش يهتز، والله عز وجل يقول لملاءكته : (من هذا ؟) فقالت الملاءكة عليهم السلام : تباركت ربنا وتعاليت، انت اعلم، هذا معروف، سكر من حبك فلا يفيق الا بلقاءك؛ فانه لم يعبدك شوقا الي الجنة ولا خوفا من النار، وانما عبدك لذاتك وابتغاء مرضاتك جل جلالك.
 وقال بعضهم : رايت الشبلي رحمه الله في المنام بعد موته، فقلت له : ما فعل الله عز وجل بك ؟ قال : غفر لي، فقلت له : هل عوتبت علي شء ؟ قال : نعم، عوتبت علي قولي : اي خسارة اعظم ممن خسر دخول الجنة ؟ قال : فقال لي الحق جل جلاله : (لا خسران اعظم ممن خسر لقاءي) وقد حكي غير واحد عن ابي القاسم الجنيد انه قال : كنت ناءما عند السري، قال : فانبهني، وقال لي : يا جنيد؛ الساعة رايت كاني واقف بين يدي الله عز وجل ، فقال لي : (يا سري) فقلت: لبيك ربنا وسعديك، فقال لي : (خلقت الخلق، فكلهم ادعوا بتي، فخلقت الدنيا، فهرب مني تسعة اعشارهم وبقي معي العشر، فخلقت الجنة، فهرب مني تسعة اعشار العشر وبقي معي عشر العشر، فسلطت عليهم ذرة من البلاء، فهرب تسعة اعشار ذلك العشر، فقلت للباقين معي : لا للدنيا اردتم، ولا للجنة اخذتم ، ولا من البلاء هربتم، فماذا تريدون  فقالوا : وعزتك وجلالك ؛ انك لتعلم ما نريد، فقلت لهم : فاني مسلط عليكم من البلاء بعدد انفاسكم ما لا تقوم له الجبال الرواسي ، فقالوا : اذا كنت


 ============================================================
 انت المبتلي لنا. . فافعل ما شءت()، فهدءلاء عبادي حقا) . انتهن.
 كل ذلك محافظة علي ابتغاء رضوان الله والنظر الي وجهه الكريم، وانهم لا يريدون عوضا، وليس مقصودهم ولا هفهم الا الله رب العالمين ثم قال مءلفه محمد بن الحسن  عفا الله عنهما  : هاذه الرءيا مما اكرم الله عز وجل بها وليه سريا السقطي رحمه الله، وقد دل الكتاب والسنة علي صحتها من حيث الاجمال، ويمكن ان تدخل تحت قوله صلي الله عليه وسلم من حيث التفصيل: بيان ذلك : انه قد روينا في " صحيح البخاري" () عن رسول الله صلي الله عليه وسلم انه قال : " ان اول من يدعا يوم القيامة. . ادم ، فيقول الله عز وجل : يا ادم؛ اخرج بعث جهم من ذريتك، فيقول: يا رب؛ وما بعث النار؟ فيقول : اخرج من كل الف تسع مثة وتسعة وتسعين الي النار وواحدا الي الجنة "().
 وجه دخول رءيا السري تحث هذذا الحديث يظهر بالمثال ؛ فانه لما خلق الله عز وجل الخلق كلهم. . ادعوا المحبة، فخلق الدنيا، فهرب تسعة اعشارهم، مثاله: هرب من كل الف تسع مثة، فبقي مثة، فخلق الجنة، فطلبها تسعة اعشارهم وهم تسعون، بقي عشرة، فسلط عليهم ذرة من البلاء، فهرب تسعة اعشارهم وهم تسعة، فلم يبق صوي واحد.
 فان قلت : الحديث دل علي بعث اهل النار وبعث اهل الجنة، وكلامنا انما هو فيمن عمل لا خوفا من النار ولا شوقا الي الجنة .
 قلت : هذا صحيح ولا منافاة فيه ؛ فان من حصل له المقام الاعظم وعمل لاجله..
 لا يمتنع عليه حصول ما هو دونه؛ لكونه لم يعمل له، فان العامل لابتغاء الرضوان ورءية الرحمان جل جلاله يدخل الجنة برحمة الله وان لم يعمل لاجلها؛ فان مقصوده كان اعظم المقاصد، ولا اكبر منه مقصودا.
 () ان له عز وجل عبادا عبدوه لا خوفا من ناره، ولا طمعا في جنته سبحانه وتعالن ، عبدوه فقط لانه الله يستحق العبادة، ولما كان سبحانه وتعالي هم المقصود عندهم ولا شء غيره. . هان وطاب ولذ كل ما ياتي من قبله سبحانه وتعالي، ولاولياء الله رضي اله عنهم كلام في هذا الموضوع يعلب، واشارات عجيبة، واحوال غريبة، وحسبنا في هنا المقام قول الامام ابن عطاء الله رحمه الله : ليخفف الم البلاء عنك.. علمك بانه سبحانه وتعالي هو المبلي لك ؛ فالذي واجهتك منه الاقدار. . هو الذي عودك حسن الاختيار () اخرجه البخاري في عدة مواضع مع اختلاف بسيط في الالفاظ عما ذكره المءلف رحمه الله


 ============================================================
 وسنذكر تحقيق ذلك ان شاء الله تعالي: وقد قال الحارث بن اسد المحاسبي : بلغني ان الحسن رحمه الله قال : اوحي الله عز وجل الي ايراهيم الخليل عليه الصلاة والسلام : (يا ابراهيم؛ انك خليلي، فاحذر ان اطلع عليك فاجد قلبك مشغولا بغيري، فانما اختار لخلتي من لو القي في النار وهو في ذكري.: لم يجد لمسن النار الما، ومن لو ادخل الجنة وراها قد زخرفت وزينت بحورها وما فيها من التعيم.. لم يرها بغيته، ولا اشتغل بها عن ذكري، فاذا كان كذلك.. تواترت عليه الطافي، وقربته مني، ووهبت له محبتي، ومن وهبت له محبتي.. فقد استمسك بحبلي فاي نعمة تعدل ذلك ؟ واي شرف اشرف منه ؟ فوعزتي وجلالي ؛ لارينه وجهي ، ولاشفين صدره من النظر الي).
 وقال بعض العارفين : اذا اطلع الخبير سبحانه وتعالي علي الضمير، فلم ير فيه غير الخبير.. جعل فيه سراجا منيرا: ومن تامل احوال العارفين وسيرهم رضوان الله عليهم اجمعين. . علم يقينا انه ليس شء احب اليهم ولا اعظم في صدورهم من لقاء الله عز وجل، الا تري الي ما حكي عن غير واحد، منهم ابو سعيد الخراز قدس الله روحه، قيل للجنيد : ان ابا سعيد الخراز كان كثير التواجد عند الموت، فقال الجنيد : ليس ذاك بعجب ان تطير روحه اشتياقا الي لقاء الله عز وجل وقد قيل للنوري وهو محتضر : هل تشتهي شيءا فرفع راسه وقد انكسر لسانه، وقال : اي والله؛ شهوة كبيرة، رءية الله عز وجل، ثم تنفس نفسا عاليا كالمتواجد، وفارق الدنيا: وسءل بعضهم ، فقيل له : هل طالت بك الايام والليالي بالشوق الي لقاء الله؟ فسكت ، ثم جاء الي رابعة العدوية رحمها الله، فقال لها : اني سءلت عن شء، فسكث ولم ادر ما اقول، سثلت : هل طالت بك الايام والليالي بالشوق الي لقاء الله عز وجل؟ قال : فعت تخريق قيصها من وراء الحجاب، وهي تقول : اي والله، اي والله، قد طالت، قدطالت ولهاذا قالوا : دخل رجل علي الشبلي ، فقال له : اي الصبر اشد علي الصابرين؟
 فقال : الصبر في الله؟ قال : لا ، قال : فالصبر لله؟ قال : لا ، قال : فالصبر مع الله ؟



 ============================================================
 قال : لا ، قال الشبلي : فايش؟ قال : الصبر عن الله، قال : فصرخ الشبلي صرخة كادت روحه تتلف، فلما افاق انشد: الصبر يجمل في المواطن كلها الا عليك فانه لا يجمل وقال بعضهم : حب الله سبحانه وتعالي شوقا الي لقاءه ؛ فان له يوما يتجلي فيه لاحبابه وبالجملة : من تامل الكتاب والسنة واحوال الصحابة والتابعين وتابعيهم رضوان الله عليهم. وجدها علي ما ذكرناه ومقصود العارفين في الدنيا  معرفته جل جلاله وعبادته، ومقصودهم في الاخرة  ابتغاء رضوانه والنظر الي وجهه الكريم ولما علم الله عز وجل من عباده ما ارادوا بعبادته، وهو الذي وفقهم واعطاهم.. انعم عليهم بنعم لا تتناهن، ولا يطلع غالب الخلق علي اولاها فضلا عن منتهاها ، ثم ان تلك النعم منها ما هو عاجل ومنها ما هو اجل: اما النعم العاجلة: فنها: استغرافهم بالمشاهلة عما قطعهم عن طبعهم وعادتهم، فلم يشعروا بما يجري علي ابدانهم ولا بما حواليهم، وحتي انهم من شدة استغراقهم لعظيم المشاهدة لا يشعرون ايضا بما في محاريبهم، ويكون احدهم قد صلي فيه عشرين سنة واكثر، وكل ذلك لاستيلاء سلطان الهيبة والعظمة والاحترام علي قلوبهم، وما هم فيه مستغرقون من لذة المشاهدة وعظيم المراقبة وارباب المراقبة في ذلك علي حالين : اعظمها : من كان الغالب عليه مشاهدة الحق جل جلاله، فكانه يراه، ولعل النبي صلي الله عليه وسلم اشار الي هذه الحالة بقوله صلي الله عليه وسلم : "وجعلت قرة عيني في الصلاة "() ، لانه مشاهد للحق جل جلاله، ولا شء اقر لعينه صلي الله عليه وسلم من ذلك، وانه هو المراد ايضا بقوله صلي الله عليه وسلم : " ان تعبد الله كانك تراه "().
 وثانيهما : لا يتهي الي هلذه المرتبة ، للكن يغلب علي حاله ان الحق جل جلاله مطلع () اخرجه الحاكم (/).
 () اخرجه البخاري ()، ومسلم ().



 ============================================================
 عليه، ومشاهد له، وانه يراه، واليه الاشارة بقوله تعالي : ( الزي يريك حين تقوم) ويقوله تعالي : الا كنا عليكر شهودا اذتفيضون فيه) ويقوله صلي الله عليه وسلم : " ان تعبد الله كانك تراه، فان لم تكن تراه. . فانه يراك" ، فاشار صلي الله عليه وسلم الي الحالين، ورغب امته في الاجتهاد علي ان تقع عبادتهم علي المرتبة الاولي، فان لم يقدروا.: فيجتهدوا علي ان تقع علي المرتبة الثانية: وهكذا كان الصحابة والتابعون ومن بعدهم رضوان الله عليهم اجمعين، الا تري الي ما روي عن سعد بن معاذ رضي الله عنه انه قال : ثلاث اتا فيهن قوي وما سواهن ضعيف : ما صليت صلاة منذ اسلمت فحدثت نفسي ابغيرها] حتي افرغ منها.
 ولا تبعت جنازة فحدثت نفسي بغير ما هي قاءلة وما هو مقول لها حتي يفرغ من دفنها.
 وما سمعت النبي صلي الله عليه وسلم يقول قولا. الا علمت انه حق: فقال ابن المسيب رحمه الله : ما ظننت ان هلذه الخصال تجتمع الا في النبي صلي الله عليه وسلم وقد روي عن زين العابدين رحمه الله انه كان في صلاة، وان النار وقعت قريبا منه، فجعلوا يصيحون : يابن رسول الله؛ النار، يابن رسول الله؛ النار، وهو لا يلتفت، بل ولا يشعر، فلما فرغ من الصلاة. سالوه عن ذلك، واخبروه بوقوع النار، فقال: ما شعرت، فقيل له : ما الذي الهاك عنها؟ قال : النار الاخري: وكان بعض العارفين يقول : ما احسب ان احدا يكون في الصلاة فيقع في سمعه غير ما يخاطبه الله عز وجل به: وقد قال احمد بن سعيد الدارمي : صلي ابو زرعة في مسجده عشرين سنة، فلما كان في بعض الايام. قدم عليه قوم من اصحاب الحديث، فنظروا، فوجدوا في المحراب الذي كان يصلي فيه كتابة، فقالوا : ما تقول في الكتابة في المحاريب ؟ فقال : قد كرهه قوم ممن مضي، فقالوا له: هذذا في محرابك كتابة، اما علمت بها؟ فقال : سبحان الله! رجل يدخل علي الله عز وجل ويقف بين يديه جل جلاله، فهل يدري ما قدامه ا وكان ابو عثمان الحيري اذا دخل في الصلاة. . لا يشعر ولا يحس بشء من كلام او صياح او غيره.



 ============================================================
 ومنها : التلذذ بمجرد المعرفة لله عز وجل، والتلذذ بمناجاته، لا سيما حال الوقوف بين يدي الله سبحانه وتعالي وقد قال ابو سليمان الداراني رحمه الله : لو لم يبك العاقل فيما بقي من عمره الا علن لذة ما فاته من الطاعة فيما مضين. . لكان ينبغي له ان يبكي حتي يموت وقد قال يحبي بن معاذ الرازي : ان العبد علي قدر حبه لله عز وجل يحببه الي خلقه، وعلي قدر توقيره لامره يوقره خلقه، وعلي قدر التشاغل بعبادته يعظمه في صدور عباده وعلي قدر سكون قلبه علي ما وعده الله سبحانه وتعالي به يطيب له عيشه، وعلي قدر حلاوته لعبادته واستلذاذه بها يجد ما كان يامل منه، وغلي قدر ذكره يديم عليه الطاف بره، وعلي قدر استيحاشه من خلقه يكون انسه به، والله؛ لو لم يحصل للعبد من الثواب علي اعماله الا ما عجل له في دنياه.. لكان كثيرا، فكيف بما يصير اليه من جزيل ثواب وعظيم عطاء الي ما لا يحيط به الوصف مما لا عين رات، ولا اذن سمعت، ولا خطر علي قلب بشر ؟!
 وقال ابو القاسم الجنيد : ان الله عز وجل يعطي القلوب من بره بحسب ما اخلصت له القلوب في ذكره سبحانه وتعالي ومنها : ما يشاهدونه من روح النعيم عند الاسحار في تهجدهم، وهذا اخص من الاول، وهو سر لطيف لا يمكن التعبير عنه ، ولهاذا قال العارفون : ليس في الدنيا نعيم يشبه نعيم اهل الجنة الا ما يحل علي الاولياء في الاسحار: وقد قال بعضهم : كابدت الصلاة عشرين سنة، وتنعمت بها عشرين سنة فعبادته عز وجل في الدنيا هي قرة اعين المخلصين، ومنتهن بغية المتقين ، ولولاها.. لما اختاروا المقام في الدنيا ولا طرفة عين، لا سيما الصحابة والتابعون وتابعوهم رضوان الله عليهم الا تري الي ما روي عن معاذ بن جبل رضي الله عنه انه كان يقول عند الاحتضار : (اللهم؛ انك تعلم اني لم اكن احب البقاء في الدنيا لكزي() الانهار، ولا لغرس الاشجار، ولككن لظما الهواجر، ومكابدة الساعات، ومزاحمة العلماء بالروكب عند حلق الذكر) : وكان ابو الدرداء رضي الله عنه يقول : (لولا ثلاث ما احببت البقاء : وضع جبهتي في () كري الانهار : حفرها .



 ============================================================
 السجود في الليل والنهار، وظما الهواجر، ومجالسة اقوام يبتغون العلم لله عز وجل) .
 وقد قال ابو سليمان الداراني ومن قبله : ان اهل الطاعة في ليلهم اشد لنة من اهل اللهو في لهوهم ، ولولا الليل.. لما احببت البقاء في الدنيا .
 وكان بعض العارفين يقول : اذا دخل وقت الافطار.. احسست بان روحي تخرج اسفا علي ما يفوتني من لذة الذكر وحلاوة العبادة لله عز وجل: وقد قالوا : لما احتضرت معاذة العدوية.. بكت، ثم ضحكت، فقيل لها : مم بكيت ؟
 ومم ضحكت ؟ فقالت : اما البكاء : فاني والله ذكرت مفارقة الصلاة والصيام والذكر، فكان البكاه لذلك().
 ومنها : ما يشاهدونه من عظيم المنة لله عز وجل عليهم في العبادة حتي تغرق عبادتهم في المنة ؛ لانهم قد عرفوا ان الطاعات ان كانت من الفراءض. . فلله عز وجل عليهم فيها اعظم المنن، وان كانت من النوافل. . فالمنة فيها عظيمة ايضا؛ اذ اعطاهم ما يقربهم اليه ووفقهم لاعمال يحببهم بها اليه .
 الا تري الي قول بعض العارفين، وهو ابو الحسين محمد بن سمعون قدس الله روحه، قال : بلغني ان الله عز وجل يقول : (يا عبدي؛ اكرمتك لما امرتك، وصنتك لما نهيتك، فامري لك كرامة، ونهي لك صيانة، كلفتك الصلاة، ولعلمي بتوانيك لم اجعل لها وقتا واحدا، جعلت لها اولا واخرا، وانت تقول : الوقت واسع ، متي اتسع الوقت علي عاقل ؟
 اما علمت ان الوقت علي العقلاء اضيق من خرم الابرة ؟ تهتم لنفسك حتي كاني لست مولاك، وتدع الاهتمام بامري حتي كاني لست مطالبك، اما علمت اني اعلم خاءنة الاعين وما تخفي الصدور ؟).
 وقال يحيي بن معاذ : لو لم يكن للعارفين الا اقدارهم علي هاتين النعمتين : متي ما شاءوا ذكروه، ومهما رجعوا اليه قبلهم ووجدوه.. لكان يحق عليهم الا يخالفوه سبحانه وتعالي: وكان بعض العارفين يقول : من مثلك يا بن ادم وقد خلي بينك وبين المحراب، تقف بين يدي الله عز وجل متن شءت، ثم يبكي، ويقول: فرق الموت بين المصلين وبين () وتتمة الخبر من "الصفوة" (/) : (... واما الذي رايتم من تبمي وضحكي.. فاني نظرت الي ابي الصهياء قد اقيل في صحن الدار وعليه حلتان خضراوان، فضحكت اليه)


 ============================================================
 الصلاة، وبين الصاءمين وبين الصيام ، ويذكر انواعا من العبادة : ومنها : امر اخر لطيف، وتحته سر شريف، وهو شهودهم العبودية، واستغرافهم ببعض ما يجب للربوبية، ويرون ان نسبتهم الي العبودية هي اعظم مما يفتخرون به وينتمون اليه، حتي ان بعض العارفين قال : كل الناس يفرون من الحساب وانا اتمناه، فقيل له : ولم ذاك ؟ قال : لعله سبحانه وتعالي ان يقول لي في خلال خطابه : يا عبدي؛ فقوله سبحانه وتعالي : (ياعبدي).. احب الي من الدنيا وما فيها.
 وقد روي ان داوود الطاءي قال : رايت وليا من اولياء الله سبحانه وتعالي، فقلت له : ما غاية بلوغ محبة الله عز وجل من قلبك  فقال : لو جعل حساب الخلق كلهم معي.: لسرني ذلك ورغبت فيه، فقلت : ولم ذاك ؟ فقال : يا داوود؛ وهل للعبد مقام اشرف من العبودية، وهو واقف بين يدي مولاه ومالكه  رب العالمين جل جلاله وهو يشاهده ويخاطبه ؟ والله ؛ ان ذلك عندي من اشرف الدرجات ؛ فان في وقوفه بين يديه عز وجل تغشا عن نفسه وحسه، ويبقي بلا نفس ولا هوي ولا اعراض، بل متفكرا في ميدان العظمة والجلال، والجليل جل جلاله يفعل ما يشاء.
 وقد قال الشبلي : كل الناس يفرون من الحساب وانا اتمناه، فقيل له في ذلك، فقال : اليس حبيبي ومالكي رب العالمين جلت عظمته مخاطبي ؟ فقد يقول لي : (يا عبدي) ما الذ كلام الحبيب الرحيم ، ولو بالامر الي نار الجحيم ، وكفي بالعبودية شرفا وفخرا ان الله عز وجل قال لسيد المرسلين وحبيب رب العالمين محمد صلي الله عليه وسلم في افخر مقاماته : (شيحن الذي اشري يعبده لءلا ت المسجد الكراء الي السسهد الاقصا الذي بكركنا حوله لثريي من مابثنا انه هوالسميع البصير.
 ولهذا قال العارفون : لا مقام اعلي من العبودية.
 ومنها : انهم في حال اتيانهم بالعبادة يعلمون ان قيامهم واتيانهم بالعبادة انما كان بالله عز وجل بحسب ما وفقهم واعطاهم؛ فان العباد ليس لهم اعمال في الحقيقة ؛ اذ الافعال لله خلقا وللعبد كسبا ، قال الله تعالي : ( والله خلقكر وما تعملوذ)، وقال تعالي : ({ لها ما كسبث وعليهاما التسبت)، فلو عاش العبد عمر الدنيا وقام علي جفون عينيه في عبادة ربه عز وجل.. لما قضي ما يجب عليه، ولكان في التقصير منغمسا ومنها : ما اقتضاه الكرم العظيم والفضل العميم، وهو سر لطيف، ومعني غامض


 ============================================================
 شريف، ينبغي ان تلمحه ببصيرتك، وهو : انهم يعلمون ان الله عز وجل بلطفه وكرمه انعم علي عباده  بعد الايمان الذي هو اعظم النعم  بان شرع لهم انواع العبادات، واقلهم لفعلها، ولولا ذلك. لكان قذر العبد اقل واحقر من ان يقف بين يديه عز وجل ويناجيه، فكان ذلك من اجل النعم واكبر السعادات : ثم بعد ان شرع لهم ذلك.. وفق من شاء لفعلها، والتوفيق عزيز، ولعزته لم يرد في القران العظيم الا في موضع واحد ؛ قال تعالي : { وما توفيق الا يالله عليه توكلت)، ثم حببها اليهم واقدرهم علي فعلها ، ولولا اقداره وعطاءه عز وجل.. لما قدر عبد ان يتحرك بذرة؟
 قال الله تعالي : ( للا نمد هدءلاه وهكءلاه من عطله ريلك وما كان عطاء ريك محظورا)، ثم يثيهم علي ما هو من فعله وعطاءه، فانظر الي هذذا الكرم العظيم والفضل العميم ، فسبحان خالق الحياء والكرم وقد روي ان ايوب عليه الصلاة والسلام قال : يا رب؛ وعزتك وجلالك انك لتعلم اني منذ ثمانين سنة ما حضرني شء فيه رضاك وهواي.. الا اثرت رضاك علي هواي، قال : فنودي من غمامة من عشرة الاف صوت : يا ايوب؛ من فعل ذلك بك؟ قال : فوضبع التراب علي راسه، ثم قال : انت يا رب.
 وقال الحارث بن اسد المحاسبي : بلغني ان الله عز وجل قال لداوود عليه الصلاة والسلام : (يا داوود ؛ اذا رايت لي طالبا.. فكن له محبا، يا داوود ؛ لان يخرج عبد من عبيدي علي يديك من سكرة الدنيا حتي تستنقذه من سكر ما هو فيه، فان فعلت ذلك..
 سميتك عندي جهبذا، ومن كان جهبذا. . لم تكن به فاقة ولا وحشة الي احد) فقال داوود عليه الصلاة والسلام : يا رب؛ اعطني ذلك وارزقنيه؛ فانه لا وصول الي شء الا بعطاءك جل جلالك وقد قال ابو سليمان الداراني ومن قبله : كيف يعجب العاقل بعمله وانما عمله عطية من الله عز وجل ونعمة منه علي العبد يجب عليه الشكر فيها ! ولا يقدر ان يقوم به ابدا؛ لان التوفيق للشكر نعمة يجب عليها شكر، وهذكذا ابدا ويءدي ذلك الي ما لا يتناهي، سحان من نعمه لا تحد ولا تحصي وقد قال ابو سليمان الداراني رحمه الله وقد سءل : بم تنال معرفته سبحانه وتعالي ؟
 فقال : بطاعته، فقيل له : وبم تنال طاعته ؟ فقال : به سبحانه وتعالي


 ============================================================
 وقد قال ابو عثمان الحيري رحمه الله : الذكر الكبير ان تذكر الله في سرك، وتعلم يقينا انك لا تصل الي ذكره ولا الي شء من الطاعات الا بعطاءه سبحانه وتعالي.
 وقال ابو يزيد البسطامي رحمه الله: خصصت رجالا واكرمتهم، فاطاعوك فيما امرتهم، ولم يبلغوا ذلك الا بك، فكان رحمتك اياهم قبل طاعتهم لك، جل جلالك ما اعلي شانك واعظم سلطانك وقال احمد ابن ابي الحواري : سمعت جمفرا الحذاء يقول : سمعت فضيلا يقول : ما اشتد عجبي قط من عبادة ملك مقرب ، ولا نبي مرسل، ولا ولي من الاولياء ؛ لان الله عز وجل هو الذي اعطاهم ووفقهم والهمهم واقدرهم ، ولو اراد ان يعطيهم اكثر من ذلك. .
 لفعل، سبحانه وتعالي، وقد قامت الادلة والبراهين علي ان الذين اطاعوه. . به اطاعوه، ولله عز وجل عليهم في تلك الطاعات اعظم المنن، وان الذين عصوه. . به عصوه، ولله عليهم في ذلك الحجة البالغة هلذا ما تيسر في الاشارة الي بعض النعم العاجلة واما النعم الاجلة : فهي مما لا يحيط بها وصف الواصفين ولا ينتهي الي معرفتها العارفون، وفيما عرف منها يتنافس المتنافسون، وللكن لا بد من الاشارة الي ما هو اعظمها وارفعها، وهو ما لاجله عمل المتقون، وبه يتنعم المخلصون، وهو ما زءيناه في "صحيح البخاري " () في باب كلام الرب سبحانه وتعالي مع اهل الجنة، قال : وحدثنا يحبي بن سليمان، حدثني ابن وهب قال : حدثني مالك، عن زيد بن اسلم، عن عطاء بن يسار، عن ابي سعيد الخدري رضي الله عنه قال : قال النبي صلي الله عليه وسلم : " ان الله يقول لاهل الجنة : (يا اهل الجنة) فيقولون : لبيك ربنا وسعديك، والخير في يديك، فيقول : (هل رضيتم ؟) فيقولون : وما لنا لا ترضي وقد اعطيتنا مالم تعط احدا من خلقك ، فيقول : ( الا اعطيكم افضل من ذلك ؟) فيقولون : يا رب ؛ واي شء افضل من ذلك ؟
 فيقول : (احل عليكم رضواني، فلا اسخط عليكم [بعده] ابدا... " الحديث .
 فقد صرح فيه وفي غيره من الاحاديث بانهم ما اعطوا شيءا احب اليهم من حلول الرضوان والنظر الي وجهه الكريم سبحانه وتعالي وهذذا هو الذي كان مقصودهم ، ولا اكبر منه مقصود ؛ قال الله تعالي : (ورضوان يب الله اكبر) فلا سعادة اعظم من سعادة من حل عليه ذلك ، ولا خسران اعظم من فواته،


 ============================================================
 اسال الله العظيم رب العرش العظيم، واتوسل اليه بمحمد سيد المرسلين صلي الله عليه، وعلي ساءر النبيين، وال كل وساءر الصالحين ، وسلم تسليما كثيرا.. ان يرزقنا ذلك بفضله وكرمه، وان يوفقنا لطاعته، ويجعلنا من احبابه واهل خاصته، وان يتوفانا علي محبتهم، ويجمع بيننا وبينهم في دار كرامته بمنه وكرمه، انه ذو الفضل العظيم .
 ومنها : ما قد دل عليه الكرم العظيم والادلة والبراهين، وهو رفع الدرجات، والتمتع في الجنة بالشهوات، وهذا وان لم يكن مقصودهم بالعبادة.. فكرم الله عز وجل اعظم من الا بعطيهم ما لا عين رات، ولا اذن سمعت، ولا خطر علي قلب بشر؛ فانه سبحانه وتعالي يعطيهم ما هو اعظم من ذلك واكبر، وهو حلول الرضوان والنظر الي وجهه الكريم كما مربيانه، فمحال ان بمنعهم ما دون ذلك، وهم في دخولهم الجنة وتمتعهم بالشهوات ممتثلون مءتمرون امره سبحانه وتعالي؛ فان امره عز وجل واحد في المنشط والمكره، والامتثال فيهما واحد، فقد كانوا في الدنيا وليس لهم هم ولا مقصود الا الله سبحانه وتعالي، والمسارعة الي امتثال اوامره.
 وهذكذا في الجنة، ليس مقصودهم الا هو يرون امتثال امر المنعم جل جلاله اكبر من التنعم بالنعمة واعظم، وغاية ما فيها من الفرق ارتفاع التكليف فقط، واشارات العارفين كلهم الي ذلك.
 الا تري الي قول احمد ابن ابي الحواري حيث قال : ان نعيم اهل الجنة برضوان الله سبحانه وتعالي اكبر وافضل من نعيمهم بما في الجنان ؟!
 وهذذا امر واضح غني عن البيان ؛ اذ قد تقدم ما ثبت في " الصحيح" ، من ان اهل الجنة لم يعطوا شيءا احب اليهم من حلول رضوانه عليهم ونظرهم الي وجهه الكريم ، وكفي بذلك دليلا قاطعا وبرهانا ساطعا، ولا شك ان مفصودهم وهءتهم في الدنيا انما كان هو الله رب العالمين جل جلاله وابتغاء رضوانه الا تري الي قول بعض العارفين : تعلق الناس بالاسباب، وتعلق الصديقون بمسبب الاسباب سبحانه وتعالي ؟ وحتي انهم لو ادخلهم النار.. لا يغيب همهم عنه سبحانه وتعالي وابلغ من ذلك قول بعضهم حيث قال : ان ادني مراتب الانس بالله عز وجل : ان لو القاء في النار.. لا يغيب هءه ولا ماموله منه سبحانه وتعالي


 ============================================================
 واذا كان هذا حالهم في الدنيا.. افتراهم يخطر ببالهم غير الله عز وجل في الاخرة، او يتغير حالهم عند مشاهدة ما كانوا ياملونه في العقبي ؟ هيهات هيهات! هذذا محال في القياس بديع: وقد ان انجاز ما كنت وعدت به من ابراز ما في جواب سهل الثستري رحمه الله من الحسن واللطافة ، حيث قال : الاخلاص : ما ليس للنفس فيه حظ فاعلم : ان الحظوظ ثلاثة : عاجل، واجل، والاجل : متعارف، وغير متعارف.
 اما العاجل : فهو الدنيوي، ومن حقه الا يذكر؛ لانه ليس مما تحن فيه في شء، وانما ذكرناه لضرورة التقسيم : واماالاجل : فهو الاخروي، وهو قسمان : متعارف، وغير متعارف فاما المتعارف : فهو الذي يعده اكثر الناس ويسمونه حظا، وعمل غالب الخلق عليه، وهو رفع الدرجات ، والتمتع بالشهوات في الجنة، والنجاة من النار، والعامل لذلك قاصد للعوض، وهو قصد صحيح؛ اذ هو عمل علي ما وعد الله تعالي عباده الابرار في الاخرة، وصاحبه مخلص بالاضافة الي طلب الحظوظ العاجلة، ولا يقدح ذلك في اخلاصه بالاتفاق، وان كان نازلا عن درجة صاحب الاخلاص المطلق، فلما كان هذذا هو الحظ المطلوب المتعارف عندهم. . اطلقوا الحظ عليه وسلبوه عما سواه وقد ورد : " اكثر اهل الجنة البله، وعليون : لذوي الالباب "() ، حيث رضوا من الحق بدون الحق جل جلاله واما فير المتعارف : وهو حلول الرضوان والنظر الي وجهه الكريم، فهاذا لا يسمونه حظا؛ لعزة العمل عليه، ولعدم تعارفه بينهم، وان كان في الحقيقة هو الحظ الاعظم والنصيب الاوفر الاجزل، والعاملون لاجل هذذا هم الذين يعبر عنهم بانهم هم الذين لا يريدون عوضا في الدارين، وهم صفوة الخلق، واخلاصهم يسمن: الاخلاص المطلق.
 اذا عرفت ذلك. . فحيث وجدت في كلام الانمة بان المخلص هو الذي لا يريد عوضا في الدارين. فمعناه هاذا، وهو انه لا يريد عوضا متعارفا يعده اكثر الناس عوضا، وليس () اخرج الشطر الاول منه البيهقي في " الشعب" ، والمراد من البله في الحديث : الذين سلمت صدورهم من الناس، وغلبت عليهم الغفلة من الشر، وطبعوا علي الخير:


 ============================================================
 المراد نفي العوض بالكلية، انما المراد نفي العوض المتعارف، علي ما صرح به غير واحد من العارفين ، منهم : ابو حامد الغزالي  قدس الله روحه  حيث قال : القوم انما ارادوا البراءة مما يسميه الناس حظوظا، وهو الشهوات الموصوفة في الجنة فقط، واما التلذذ بمجرد المعرفة والمناجاة والنظر الي وجهه الكريم. . فهو اعظم الحظوظ واوفر الانصباء ، ولككن غالب الناس لا يسمونه حظا . [انتهن "الاحياء"/) : فقول سهل التستري : (ليس للنفس فيه حظ) اي : حظ متعارف يعده اكثر الناس حظا .
 وينشا من هذذا الجواب تعريف اخر للاخلاص، فيقال : الاخلاص : ما ليس للنفس فيه حظ متعارف يغده اكثر الناس حظا ، والله اعلم .
 المرتبة الثانية والثالثة : العاملون للرفية والرهبة : وهما يجتمعان في شء ويفترقان في شء: فاجتماعهما : ان كلا منهما عمل لله عز وجل، لكن اجابة لباعث الرجاء والخوف ؛ ليحصل له الحظ الاجل الموعود في الاخرة من الفوز بالجنة ، والتمتع بالشهوات ، والنجاة من النار، وهذذا قصد صحيح ، والعامل لاجله مخلص بالاتفاق كما تقدم، قال الله تعالي : { ويرخوذ رخمته ويخافر عذابه وافتراقهما : من حيث ان احدهما عمل اجابة لباعث الرجاء من الرغبة في الدرجات والتمتع بالشهوات، وهو عمل علي الموعود في الاخرة، وهو من جنس المالوفات في الدنيا، واغلب البواعث باعث البطن والفرج، وموضع قضاء وطرهما في الجنة، للكن قال العارفون : ان العامل لاجل ذلك كالاجير السوء ، ولهاذا ورد : ان اكثر اهل الجنة البله ، حيث رضوا من الحق بدون الحق جل جلاله واما الاخر: فانه عمل اجابة لباعث الخوف، وهو قصد النجاة من النار، وهو قصد صحيح كما تقدم، والعامل عليه مخلص بالاتفاق، بالاضافة الي صاحب الغرض العاجل، للكنه مع ذلك  نازل عن درجة صاحب الاخلاص المطلق.
 ولهذذا قال العارفون : ان الله عز وجل وصف عباده فقال : ( يوتون ماماتوا وقلوبهم وجلة انهم ان رهم رجمون ثم قالوا : ان العباد في عباداتهم محتاجون الي طلب العفو عما وقع لهم من التقصير اللازم، والغفلة الغالبة، والاخلال بما يجب عليهم من تعظيم حرمات الله في الوقوف بين


 ============================================================
 يديه جل جلاله، فكيف يعلق بقلوبهم مع ذلك تطلب مجازاة من دخول جنة او نجاة من نار ؟ تالله ؛ ان ذلك لا بمر بقلوبهم ، وانما قصدهم التجاوز والعفو عن تقصيرهم فيها الا تري الي قول بعض العارفين : ان لم تخش ان يعذبك الله علي احسن اعمالك .
 فانت هالك.
 وقول بعضهم : ريما اصلي ركعتين فانصرف منهما بمنزلة المنصرف من السرقة؛ حياء من الله عز وجل من التقصير والغفلة، وكان اذا فرغ يقول : اللهم ؛ اغفر لي ما وقع فيها من التقصير والغقلة والاخلال، كانه قد جني جناية او ذنبا، ومشارب القوم مختلفة، والله تعالي عند قصدهم لا عند حاصلهم وما احسن ما قال معروف الكرخي رحمه الله : ان قوما عبدوا الله رغبة فتلك عبادة التجار، وان قوما عبدوا الله رهبة فتلك عبادة العبيد، وان قوما عبدوه لا رغبة ولا رهبة فتلك عبادة الاحرار، فاشار الي المراتب الثلاثة في هلذه الكلمات الوجيزة.
 الفصل الرابع في بيان درجات الشواءب والافات المكدرة للاخلاص والافات المشءشة بعضها جلي وبعضها خفي، ومراتبها تتفاوت، ويظهر ذلك بالمثال .
 واكثر مشوشات الاخلاص انما هو الرياء، مثاله : ان يصوم ليتفع بالحمية الحاصلة بالصوم مع قصد التقرب الي الله عز وجل، او يعتق رقبة ليتخلص من مءنته وسوء خلقه، او بحج ليصح مزاجه بحركة السفر، او ليخلص من شء يعرض له في بلده، او ليهرب من اعداءه، او تبرم باهله وولده فاراد ان يستريح اياما، او يغزو ليمارس الحروب، او يصلي بالليل وله غرض في دفع النعاس عنه ليراقب رحله او اهله، او يتعلم العلم ليحصل له ما يكفيه من المال، او ليكون عزيزا بين العشيرة، او ليكون عقاره وامواله محروسة بعز العلم، او اشتغل بالدرس والوعظ عن كرب الصمت() ويتلذذ بالعلم ، او تكفل بخدمة العلماء والفقراء لتكون حرمته وافرة عندهم، او لينال به رفقا في الدنيا، او كتب مصحفا ليجود خطه بالمواظبة علي الكتابة، او حج ماشيا لءخفف عن نفسه الاجرة، او توضا لينظف () رب الصت : تقله وشدته


 ============================================================
 ويتبرد، او اغتسل ليطيب راءحته، او روي الاحاديث ليعرف بعلء الاسناد، او اعتكف لتخ عليه اجرة المسكن، او صام ليخفف عن نفسه الاشتغال بالطبخ، او ليتفرغ لاشغاله، او تصدق علي الساءل ليدفع ابرامه في السءال عن نفسه، او عاد مريضا ليعاد اذا مرض، او فعل شيءا من ابواب الخير لءعرف به ويذكر وينظر اليه بعين الصلاح والوقار.
 فمهما كان باعثه هو التقرب الي الله تعالي، وللكن انضاف اليه خطرة من هذذه الخطرات، وصار العمل عليه  بسبب هذذه الامور  اخف وايسر.. فقد خرج عمله عن حد الاخلاص، وخرج عن ان يسمي مخلصا، وتطرق اليه نوع من الشرك، وقد ورد ان الله عز وجل يقول : ( انا اغني الشركاء عن الشرك) .
 وبالجملة : فكل حظ من حظوظ الدنيا تستريح اليه النفس ويميل اليه القلب، قليلا كان او كثيرا ، اذا تطرق الي العمل. . تكدر به صفوه ، وزال به اخلاصه .
 وهذذه الحظوظ ان كانت هي الباعثة وحدها. . فلا يخفي شدة الامر علي صاحبها، وهو معرض للهلاك، وليس لنا الان غرض في الكلام فيه ؛ اذ ليس هاذا موضع ذكره : واقل اموره : ماورد؛ ان المراءي يدعي يوم القيامة باربعة اسماء : يا مراءي، يا مخادع، يا مشرك، يا كافر ، وانما نتكلم الان فيما اذا كان القصد الاصلي التقرب الي الله تعالي، وانضافت اليه هلذه الامور، وهي اما ان تكون في رتبة الموافقة ، او في رتبة المشاركة، او في رتبة المعاونة ، وذلك لان الباعث النفسي اما ان يكون مثل الباعث الديني، او اقوي منه، او اضعف، ولكل واحد حكم سنذكره ان شاء الله تعالي .
 فالاخلاص : تخليص العمل عن هاذه الشواءب حتي يتجرد فيه قصد القربة، فلا يكون فيه باعث سواه، مثاله : اجر المصلي، مهما كان مخلصا في صلاته.. فقد يدخل علي اخلاصه الافة وهو لا يشعر، وذلك من وجوه : الاول : اذا دخل في الصلاة، ثم نظر اليه جماعة، او دخل اليه انسان، فيقول له الشيطان : حشن صلاتك حتي ينظر اليك هذذا الحاضر بعين الوقار والصلاح ولا يزدريك ولا يغتابك، فتخشع جوارحه، وتسكن اطرافه، وتحن صلاته، وهاذا هو الرياء الظاهر، ولا يخفي ذلك علي المبتدءين: الوجه الثاني : ان يكون الانسان قد فهم هذذه الافة واخذ حذره منها، فصار لا يطيع الشيطان فيها ولا يلتفت اليه، ويستمر في صلاته كما كان، فياتيه في معرض الخير، ويقول


 ============================================================
 له: انت متبوع ومفتدي بك ومنظور اليك، وما تفعله يءثر عنك ويقتدي بك غيرك، فيكون لك ثواب اعمالهم ان احسنت، وعليك الوزر ان اسات، فاحسن صلاتك، فعسن ان يقتدي بك في الخشوع وفي تحسين العبادة، وهذا اغتض من الاول ، وقد ينخدع به من لا ينخدع بالاول، وهو ايضا عين الرياء ومبطل للاخلاص؛ فان الخشوع وحسن العبادة ينبغي ان يكون لازما له في الخلوة ، لا انه يوجد عند وجود من يراه، والمقتدي به هو الذي استقام في نفسه، واستنار قلبه، فانتشر نوره الي غيره : فاما هذذا : فهو محض النفاق والتلبيس، فمن اقتدي به.. اثيب عليه، واما هو: فيطالب بتلبيسه، ويعاقب علي اظهاره من نفسه ما ليس متصفا به.
 الوجه الثالث : وهو ادق مما قبله، وهو ان يحدث العبد نفسه في ذلك، ويتنبه لكيد الشيطان، ويعلم ان الاخلاص في ان تكون صلاته في الخلوة مثل صلاته في الملا ، ويستحيي من الله تعالي ان يحسن صلاته لاجل مخلوق، فيقبل علي نفسه في الخلوة، ويحسن صلاته علي الوجه الذي يرتضيه في الملا، ويصلي في الملا كذلك، فهذا ايضا من الرياء الغامض؛ لانه حمن صلاته في الخلوة لتحسن في الملا ، فكان التحسين لاجل المخلوق، وهو مبطل للاخلاص ايضا، والاخلاص ان تكون مشاهدة البهاءم لصلاته ومشاهدة الخلق علي وتيرة واحدة فكان هذذا لا تسمح نفسه باساءة الصلاة في الملا ثم يستحيي من نفسه ان يكون في صورة المراءين، ويظن ان ذلك يزول بان تستوي صلاته في الخلاء والملا .
 وهيهات! ان ذلك لا يزول بهذا، وانما طريق الزوال ان يقطع نظره عن الخلق ولا يلتفت اليهم ، كما لا يلتفت الي الجمادات في الخلاء والملا جميعا، والا.. فهلذا شخص مشغول الهم في الخلاء والملا جميعا، وهذذا من المكاءد الخفية للشيطان : الوجه الرابع : ادق واخفي، وهو : ان يكون قد تنبه لهاذه الدقاثق واخذ حذره منها، فيقول له : تفكز في عظمة الله وجلاله ومن انت واقف بين يديه ، واستحيي من ان ينظر الله عز وجل الي قلبك وانت غافل عنه، فيحضر العبد قلبه ، ويجمع جوارحه، ويظن ان ذلك عين الاخلاص، وهو عين المكر والخداع ؛ فان خشوعه لو كان لله عز وجل. . لكانت هذذه الخطرة تلازمه في الخلاء والملا مهما كان في الصلاة : وعلامة الامن من هلذه الافة : ان يكون هلذا الخاطر مما يالفه في الخلوة كما يالفه في


 ============================================================
 الملا، ولا يكون حضور الغير هو السبب في حضور هذذا الخاطر، كما لا يكون حضور البهيمة سببا، فما دام يفرق في احواله بين مشاهدة انسان ومشاهدة بهيمة.. فهو بعد ما وصل الي صفو الاخلاص، وباطنه مدنس بالشرك الخفي من الرياء ، والشرك اخفي في قلب ابن ادم من دبيب التملة السوداء في الليلة الظلماء كما ورد به الخبر: ولا يسلم من الشيطان الا من دق نظره، وسعد بعصمة الله سبحانه وتعالي وتوفيقه وهدايته، والا. فالشيطان ملازم للمتشمرين في العبادة لا يغفل عنهم لحظة حتي يحملهم علي الرياء في كل حركة من الحركات، حتي في كحل العين، وقص الشارب، وطيب يوم الجمعة، ولبس الثياب، فان هذذه سنن في اوقات مخصوصة، وللنفس فيها حظ خفي؛ لارتباط نظر الخلق بها ، ولاستثناس الطبع بها، فيدعوه الشيطان الي فعل ذلك، ويقول : هلذه سنة لا ينبغي ان تتركها، ويكون انبعاث القلب لها في الباطن لاجل تلك الشهوات الخفية، او مشوبة بها شوبا يخرج عن حد الاخلاص بسببها.
 وكل ما لم يسلم من هذه الافات كلها لا يكون خالصا، فان من يعتكف في مسجد معمور نظيف يانس الطبع به.. فالشيطان يرغبه فيه ويكثر عليه من فضاءل الاعتكاف، ويكون الباعث الخفي في سره هو الانس بحسن صورة المسجد واستراحة الطبع، ويتبين ذلك بميله الي احد المسجدين اذا كان احدهما احسن من الاخر: وكل ذلك امتزاج بشواءب الطبع وكدورات النفس ، ومبطل لحقيقة الاخلاص، ولا شك ان الغش الذي يمتزج بالذهب درجاته متفاوتة، فمنها : ما يغلب، ومتها : ما يقل وللكن يسهل دركه، ومنها: ما يدق عن معرفته بحيث لا يدركه الا الناقد البصير، ودغل () الشيطان وخبث النفس اغمض من ذلك وادق كثيرا.
 ولهذا قيل : ركعتان من رجل عالم.. افضل من عبادة سنة من جاهل، واريد بالعالم : العالم البصير بدينه وبدقاءق افات الاعمال حتي يخلص عنها؛ فان الجاهل نظره الي ظاهر العبادة والاغترار بها كنظر السوادي () الي حمرة الدينار الممءه واستدارته ، وهو مغشوش زاءف في نفسه، وقيراط من الخالص الذي يرتضيه الناقد البصير خير من دينار يرتضيه الغر الغبي () الدقل: الفساد.
 () السولدي : القوري


 ============================================================
 فهكذا يتفاوت امر العبادة بل اشد واعظم.
 ومداخل الافات المتطرقة الي فنون الاعمال لا يمكن حصرها واحصاءها، فلنقنع بما ذكرناه مثالا ، والفطن يغنيه القليل عن الكثير، والله سبحانه وتعالي اعلم .
 الفصل الخامس في بيان حكم العمل المشوب بالرياء اعلم : ان العمل اذالم يكن خالصا. . فقد احتلف العلماء رضي الله عنهم فيه، هل هو صحيح، او لا؟
 واذا قيل به.. فهل يفتضي ثوابا ، او لا يقتضي ثوابا ولا عقابا، او يقتضي عقابا ؟
 والكلام انما هو في المشوب بالرياء، والذي ادين الله عز وجل به عدم الصحة فيه، وقد ذهب الي ذلك بعض الاءمة من اصحاب الشافعي رحمه الله، حكاه عنه الشيخ العالم الرباني محي الدين النووي قدس الله روحه في "شرحه لمسلم" ، وهو الذي تقتضيه الادلة الشرعية علي ما سياتي بيانه ، وءدان الله عز وجل به ، وللكن الراجح عند الاكثرين : الصحة؛ لانهم يرون انه ليس بين التحريم والصحة ملازمة، وقد اشبعت القول في هلذه المسالة في تصنيف اخر قبل هذذا : ملخص ما اذكره ههنا هو ان يقال : ان العمل المشوب بالرياء هل يقتضي ثوابا ، او لا ؟
 اعلم : انه قد ثبت عن النبي صلي الله عليه وسلم في حديث الثلاثة الذين يكون اول قضاء الله عز وجل عليهم يوم القيامة ان الله تعالي يقول لكل واحد منهم : (كذبت، انما اردت ان يقال : فلان كذا، وقد قيل ، اذهبوا به الي النار)().
 وقد ثبت بالكتاب والشنة : ان كل عمل يمكن ان يراد به وجه الله عز وجل. . فانه اذا لم يعمل لمجرد التقرب اليه سبحانه وتعالي وابتغاء رضوانه لا يستحق ثوابا ثم فيه تفصيل، وهو : انه ان كان فرضا، واراد به فاعله الفرض فاداه بنية الفرض، ليقول الناس: انه فعل كذا لا لطلب رضوان الله واتقاء سخطه.. سقط عنه الفرض، ولم ) اخرجه بتحوه مسلم ()


 ============================================================
 يعاقب في الاخرة عقوبة التارك له، ولككنه لا يستوجب ثوابا، انما ثوابه ثناء الناس عليه في الدنيا بما فعل: وان كان تطوعا، وفعله لوجوه الناس لا لوجه الله سبحانه وحده.. حبط اجره، ولم يحصل من عمله علي شء، بخلاف الاول، حيث حصل منه علي سقوط الفرض عنه، ثم ان حالهما يحتمل امرين: احدها : انه مع كونه لا يثاب.. يعاقب علي ذلك، يدل عليه ظاهر قوله صلي الله عليه وسلم [عن رب العزة جل جلاله] : " اذهبوا به الي النار" ، فهو اخبار بان المراءي يعاقب علي غدوله عن قصده وجه الله سبحانه وتعالي الي قصده وجوه الناس؛ لانه كالباءع لثواب الله بمحمدتهم، فلا يتقاصر ذلك عن بعض الذنوب الموجبة للعقاب .
 وثانيهما: انه لا يعاقب ولا يثاب ، ويكون  علي هذذا  معني الحديث : ان العمل الذي اتي به علي وجه الرياء لا ينفعه، ولا يثقل به ميزانه ، وقوله : (اذهبوا به الي النار) ؛ اي : بمعاصيه، لا انه يعاقب علي الرياء بالنار، انما عقوبة الرياء احباط العمل فقط؛ لان المراءي اراد بعمله حمد الناس، فاذا احيل عليهم.. فقد جوزي بصنيعه؛ فان جميع ما صدر عنه سيان، فعله الذي لم يخل عن كونه عبادة لله  اذلو اراد به عبادة غير الله.. لكفر وقصده لمدح الناس لا لثواب الله، والاول ليس بذنب ، والثاني قصاراه الا يثاب، ويكون جزاءه علي هاذا مدح الناس، وهذذا احتمال ضعيف فان قيل : لو لم يشتغل الناس به ولامدحوه بل ولا علموا به انه فعل خيرا او شرا..
 فالجواب : انه لا يءجر بشء لا عاجل ولا اجل، وانما هذا رجل خسر الدنيا والاخرة، نسال الله العافية ويشبه ان يكون من عذاب الاخرة ابعد ؛ لان الله تعالي لما صرف هم الناس عنه حتي لم يحصل له منهم ما اراد.. كان من جملة العقوية ، اذا كان ثناءهم  اذا اثنوا عليه  هو جميع جزاءه. . جاز ان يكون فوث ثناثهم عليه جميع عقوبته وجميع ما ذكرناه من الثواب والعقاب داخل تحت قوله صلي الله عليه وسلم : ( انما الاعمال بالنيات " والله اعلم واما الامام حجة الاسلام ابو حامد الغزالي  قدس الله روحه  فانه قال : ظاهر الاخبار يدل علي انه لا ثواب فيه، وليس تخلو الاخبار عن تعارض فيه، والذي ينقدح لنا فيه 


