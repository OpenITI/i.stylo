 ومنهم الامام : ابو صالح الحنفي ماهان رضي الله هنه وقيل : ان اسمه عبد الرحمان بن قيس اخو طليق () .
 قال الحافظ  رحمه الله  : قال ماهان الحنفي : اما يستحيي احدكم ان تكون دابته وثوبه الذي يلبس اكثر ذكرا لله عز وجل منه () .
 وكان لا يفتر من التكبير والتسبيح والتهليل: وقال ابراهيم مءذن بني حيفة : رايت ابا صالح ماهان لما صلبه الحجاج علي بابه، فلما رفع علي خشبة.. رايته يسبح ويهلل ويكبر ويعقد بيده حتي بلغ تسعا وعشرين، قال : فطعنه الرجل علي تلك الحال، فلقد رايته بعد شهر معقودا بيده تسعا وعشرين، وكنا نري عنده الضوء بالليل شبه السراج: وعن ابي اسحاق الشيباني قال : دنوت من ماهان ابي صالح لما اراد ابن ابي مسلم ان يقطعه ويصلبه، فقال : تنح يابن اخي ، لا تسال عن هذذا المقام .
 وقال : ما ابالي ما قالت ابنتي ، اعافي فاشكر ، او ابتلي فاصبر.
 وقال : الحق ثقيل، وابن ادم ضعيف، والذكر ساعة بعد ساعة وسءل ماهان : ما كانت اعمال القوم؟ فقال : كانت اعمالهم قليلة، وكانت قلوبهم ليه () وفرق ابن سعد في والطبقات " (/) بين اثنين كنية كل منهما ابو صالح الحنفي ، فسمن واحدا ابا صالح الحنفي عبد الرحمان بن قيس اخا طليق بن قيس ، والاخر ابا صالح الحنفي واسمه ماهان وكذلك فعل الحافظ المزي في ل تهذيب الكمال () لعله اشار بذلك الين قوله تعالي : ( تس له الشنوث الشبع والارش ومن فيهن وان ين شفه الا يسمح بحترو ولكن لا تفقهود تييكهم اتث كان حليما غفورا). ومنه سماع تسبيح الحصي في يد المصطفن صلي الله عليه وسلم ، وتاويب الجبال مع سيدنا داود عليه السلام ، وتامين اسكتة الباب، وغير ذلك كثير


 ============================================================
 اسند ماهان عن علي بن ابي طالب، وابن مسعود، وحذيفة، رضي الله عنهم.
 فمما رواه عن علي بن ابي طالب رضي الله عنه قال : قال لي رسول الله صلي، الله عليه وسلم ولابي بكر يوم بدر : "علي يمين احدكم جبريل، والاخر ميكاءيل، واسرافيل ملك عظيم يشهد القتال ويكون في الصف "() انتهي ( الحلية/) .
 والله سبحانه وتعالي اعلم () اخرجه الحاكم (/).



 ============================================================
 ومنهم الامام: ربعي بن حراش رضي الله عنه قال الحافظ  رحمه الله  : عن ربعي بن حراش قال : كنا اربعة اخوة، وكان الربيع اكثرنا صلاة وصياما في الهواجر، فتوفي، فبينا نحن حوله وقد بعثنا من يشتري كفنا. . اذ كشف الثوب عن وجهه فقال : السلام عليكم، فقال القوم : وعليكم السلام، اعيش بعد الموت الان، فقال : نعم، اني لقيت ربي عز وجل، فلقيت ربا غير غضبان، استقبلني بروح وريحان، واستبرق مختلف الوان، وان ابا القاسم محمدا صلي الله عليه وسلم ينتظر الصلاة علي، فعجلوا بي ولا تءخروني، ثم كان بمنزلة حصاة زمي بها في طست، فوصل الحديث الي عاءشة رضوان الله عليها، فقالت: اما اني سمعت رسول الله صلي الله عليه وسلم يقول : "يتكلم رجل من امتي بعد الموت ".
 وفي رواية اخري : وانه كساني ثيابا خضرا من سندس واستبرق، وان الامر ايسر مما في انفسكم فلا تغتروا() .
 وكان ربعي بن حراش لم يكذب قط، فسعي به ساع الي الحجاج، وقالوا : ههنا رجل من اشجع، زعم قومه انه لم يكذب قط، وانه سيكذب لك اليوم ، لانك ضربت علي ابنيه البعث() فعصيا، وهما في البيت، فبعث اليه، فلما حضره.. قال له : ما فعل ابناك ؟
 قال : هما هذان في البيت، قال : فحمله وكساه واوصي به خيرا لصدقه.
 اسند ربعي عن عمر بن الخطاب، وعلي بن ابي طالب، وحذيفة، وغيرهم، رضوان الله عليهم اجمعين () وقد روي هاذه القصة ابن عبد البر في "الاستيعاب * (/ ) في ترجمة زيد بن خارجة الصحابي، والذي تكلم ايضا بعد الموت، وللحافظ ابن ابي الدنيا رسالة سماها : من عاش بعد الموت " ، ذكر فيها كثيرا ممن تكلم بعد موته.
 () البعث : بمث الجند الي الغزو ؛ اي : انه الزمهما الجندية.



 ============================================================
 فمما رواء عن حذيفة : قال : قال رسول الله صلي الله عليه وسلم : " سياتي عليكم زمان لا يكون فيه شء اعز من ثلاثة : من اخ يستانس به ، او درهم حلال، او سنة يعمل بها "() غريب من حديث الثوري، تفرد به روح بن صلاح عنه . انتهي [ه الحلية/) .
 وقال ابو الفرج  رحمه الله  : الي ربعي بن حراش الا يضحك حتي يعلم ايصير الي الجنة ام الي النار، قال : فلقد اخبر غاسله انه لم يزل متبسما علي سريره ونحن نغسله حتي فرغنا منه توفي سنة اربع ومثة، رضي الله عنه . انتهل [" الصفوة "/] .
 والله سبحانه وتعالي اعلم () اخرجه الطبراني في " الاوسط " (/).



 ============================================================
 ومنهم الامام: ابو عبد الله محمد بن سوقة رضي الله عنه قال الحافظ رحمه الله : قال يعلي بن عبيد : دخلنا علي محمد بن سوقة، فقال لنا : قال لي عطاء : ان من كان قبلكم كانوا يكرهون فضول الكلام، وهو ما عدا اية من كتاب الله، وسنة رسوله صلي الله عليه وسلم، او امرا بمعروف، او نهيا عن منكر، وان ينطق بحاجته التي لا بد منها : (وان عليكم لحتفظين كراما كتيين) اما يستحي احدكم لو نشرت صحيفته في اخر نهاره وقد املي فيها ما ليس له فيه حاجة من حاجات الدنيا والاخرة وقال محمد بن سوقة : امران لو لم نعذب الا بهما.. لكنا مستحقين بهما العذاب : يزداد احدنا في دنياه فيفرح فرحا يعلم الله عز وجل انه لم يفرح بمثله لزيادة في دينه، وينقص من دنياه فيحزن حزنا يعلم الله عز وجل انه لم يحزن بمثله علي نقص دينه.
 وكان محمد بن سوقة وضرار بن مرة اذا كان يوم الجمعة. . اجتمعا يبكيان وعن جعفر الاحمر قال : كان اصحابنا البكاءون اربعة : مطرف بن طريف ، ومحمد بن سوقة، وعبد الملك بن ابجر، وضرار بن مرة: وقال طلحة : لا اعلم بالكوفة رجلين يريدان الله عز وجل الا : محمد بن سوقة، وعبد الجبار بن واثل: وقال سفيان : ما اري كان يدفع عن اهل هلذه المدينة .. الا بمحمد بن سوقة، ورث عن ابيه مثة الف، فتصدق بها كلها واشتري محمد بن سوقة من غزوان خزا() بوزن معلوم ، فدفعه اليه بالوزن الذي اشتراء ه فوزنه، فوجده يزيد ثلاث مثة دينار، فقال محمد بن سوقة لغزوان : اشتريت منك كذا () الخز: نوع من الثياب.



 ============================================================
 وكذا من() ، فوجدته كذا وكذا منا، فقال له غزوان : لا ادري ما تقول ، اشتريت كذا وكذا منا، فدفعت اليك بالوزن الذي اشتريت فمكثا يترادان الكلام ، محمد بن سوقة يريد ان يرد الفضل علي غزوان، وغزوان يابي ان يقبله، فقال له غزوان : يا هذذا ؛ ان يكن لي.. فهو لك، واذ يكن لك.. فهولك: وقال سفيان الثوري رحمه الله : ما رايت بالكوفة شيخا افضل من محمد بن سوقة، كان له مال، فلم يزل يحج ويغزو وقال ابو حنيفة رحمه الله وهو في جنازة محمد بن سوقة : لقد دخل مكة ثمانين مرة ما بين حجة وعمرة: وعن سفيان، عن ابن سوقة انه كان يحج وعليه دين، فيقول : اتحج وعليك دين ؟
 فيقول : الحج اقضي للدين: وطلب رجل من ابن سوقة شيءا ، فبكي، فقال له الرجل : والله يا عم؛ لو علمت ان مسالتي تبلغ منك هلذا.. ما سالتك، قال : ما بكيت لسءالك، انما بكيت لاني لم ابتديك قبل سءالك.
 وكان ابن سوقة يعجن في جفنة ودموعه تسيل، وهو يقول : لما قل مالي.. جفاني احبابي.
 وقال سفيان بن عيينة : عن ابن سوقة : دخلت مع عمر() قصرا بالكوفة، فقلت له : رايثنا في زمان الحجاج وقد جء بنا ونحن في هذذا المكان محبوسين مرعوبين، نفرق فرقا شديدا، فمررت كانك لم تدعه الي ضر معك، ارجع الي ذلك المكان، فادعه واحمده واشكره علي ما اعطاك وقال محمد بن سوقة : ما استفاد رجل اخا في الله عز وجل.. الا رفعه الله بذلك دره ادرك محمد بن سوقة من الصحابة رضي الله عنهم انس بن مالك ، وابا الطفيل عامر بن واثلة وسمع منهما () المن : كيل ، وهو رطلان .
 () في هامش نسخة : (عمر بن عبد العزيز)


 ============================================================
 واكثر روايته عن علية التابعين رضي الله عنهم اجمعين فمن احاديثه : عن ابراهيم، عن الاسود ، عن عبد الله قال : كنا عند النبي صلي الله عليه وسلم جلوسا، فجاء ساءل، فسال، فناوله رجل درهما، فاخذه رجل، فناوله اياه، فقال النبي صلي الله عليه وسلم : " من فعل مثل هلذا. كان له مثل اجر المعطي، من غير ان ينقص من اجورهم شيءا * هاذا حديث غريب وعنه عن الحارث، عن علي، عن النبي صلي الله عليه وسلم قال : " من اشتاق الي الجنة.. سارع في الخيرات، ومن اشفق من النار.. لهي عن الشهوات ، ومن ترقب الموت.. هانت عليه اللذات، ومن زهد في الدنيا.. هانت عليه المصاءب "() حديث رب وعنه عن نافع، عن ابن عمر قال : ( ان كنا لنع لرسول الله صلي الله عليه وسلم في المجلس الواحد يقول : "رب اغفر لي وتب علي انك انت التواب الرحيم "() مثة مرة) وعنه عن نافع، عن ابن عمر قال : سمعت رسول الله صلي الله عليه وسلم يقول : " من راي مبتلي فقال : الحمد لله الذي عافاني مما ابتلي هذذا به، وفضلني عليه وعلي كثير ممن خلق تفضيلا، عافاه الله عز وجل من ذلك البلاء كاءنا ما كان "() انتهي [ الحلية" /) : والله سبحانه وتعالي اعلم () احرجه الديلمي (/) () اخرجه بتحوه الترمذي () .
 () اخرجه بتحوه الترمذي ()، والطبراني في " الاوسط" (/) .



 ============================================================
 ومنهم الامام: ابو محمد طلحة بن مصرف رضي الله عنه قال الحافظ  رحمه الله  : ارسل طلحة بن مصرف رحمه الله الي جار له يستاذنه في ان يتد في جداره وتدا ، فارسل اليه الجار : نعم ، وافتح فيه كوة .
 ودخلت جارية منزل طلحة تقتبس نارا وطلحة يصلي، فقالت لها امراته: مكانك يا فلانة حتي نشوي لابي محمد هذا القديد () علي قصبتك يفطر عليه، قال : فلما قضي الصلاة. . قال : ما صنعت؟ لا اذوقها حتي ترسلي الي سيدتها فتستاذنيها حبسك اياها وشواءك علي قصبتها.
 وقال طلحة بن مصرف : لولا اني علي وضوه . . لاخبرتك بما تقول الرافضة وقيل له : لو ابتعت طعاما() فربحت فيه ، قال : اني اكره ان يعلم الله عز وجل من قلبي ارادة غلاء علي المسلمين: وقال : يستحب من الدعاء ان يقول العبد : اللهم؛ اجعل صمتي تفݣرا، واجعل نظري عبرا ، واجعل منطقي ذكرا .
 وقال الفضيل بن عياض : بلغني عن طلحة انه ضحك يوما، فوتب علي نفسه، وقال : فيم الضحك؟ انما يضحك من قطع الاهوال، وجاز الصراط ، ثم قال : اليت الا افتر ضاحكا حتي اعلم بم تقع الواقعة ، فما رثي ضاحكا حتي صار الي الله عز وجل وكان يقول في دعاءه : اللهم ؛ اغفر لي رياءي وسمعتي: وعن الفضيل قال : دخلنا علي طلحة بن مصرف نعوده، فقال له ابو كعب : شفاك الله، قال: استخير الله () القديد من اللحم : ما تطع طولا وملح وجفف في الهواء والشمس: () في هامش نسحخة : (الطعام : هو القمح في عرف اهل العراق) .



 ============================================================
 وسمع طلحة رجلا يعتذر الي رجل ، فقال : لا تكثر الاعتذار الي اخيك ؛ اخاف ان يبلغ بك الكذب .
 : كنت امشي مع طلحة، فقال : لو علمت انك اسن مني في ليلة..
 وعن ليث قال: ما تقدمتك : اخبرت ان طلحة اشتهر بالقراءة ، فقرا علي الاعمش؛ ليزول ذلك وقال ابو خالد: وقال الاعمش : كان طلحة يجء، فيجلس علي الباب، فتخرج الجارية وتدخل لا يقول لها شيءا، حتي اخرج، فيجلس، فيقرا، فما ظنكم برجل لا يخطء ولا يلحن، فان استندت الي الحاءط. قال: السلام عليكم، ثم يذهب قالوا : وسبب قراءته عليه ما ذكرناه من الشهرة، فاحب زوالها عنه وعن ليث قال : حدثت طلحة في مرضه الذي مات فيه : ان طاووسا كان يكره الانين ، قال : فماشمع طلحة يثن حتي مات، رحمه الله.
 وكان طلحة اذا ذكر عنده الاختلاف . . قال : لا تقولوا الاختلاف، وللكن قولوا الشعة وعن ابي حصين وطلحة، قال احدهما : لقد ادركت اقواما لو رايتهم.. احترقت كبدك، وقال الاخر : لقد ادركت اقواما ما كنا في جنبهم الا لصوصا .
 وقال طلحة : اذا اكلنا بالدين. . اءتدمنا بالخل ، واذا لم ناكل بالدين. . اكلنا بالادام .
 وقال عبد الملك بن ابجر، عن ابيه قال : ما رايت طلحة بن مصرف في ملا .. الا رايت له الفضل عليهم ادرك طلحة جماعة من الصحابة، وسمع من بعضهم ومن كبار التابعين، رضي الله عنهم اجمعين انتهي [" الحلية /] .
 وقال ابو الفرج  رحمه الله  : خرج طلحة مع قراء الكوفة الي الجماجم ايام الحجاج، وتوفي بعد ذلك سنة اثنتي عشرة ومثة، رحمه الله . (انتهن "الصفوة"/) .
 والله سبحانه وتعالي اعلم


 ============================================================
 ومنهم الامام : ال ابو عبد الرحمان زييد اليامي رضي الله عنه قال الحافظ  رحمه الله  : قال اسماعيل بن حماد : كنت اذا رايت زبيدا مقبلا من السوق.. رجف قلبي: وقال شعبة : ما رايت رجلا خيرا وافضل من زبيد .
 وعن سفيان قال : كان لزبيد جارية اعجمية، فكان اذا فرغ من صلاته . . يقول : سبحان الملك القدوس، فتقول الجارية : روزامد()، يعني : جاء النهار.
 وعن سفيان قال : دخلنا علي زبيد وهو مريض، فقلنا له : استشف الله او شفاك الله تعالي، فقال : استخير الله.
 وقال سفيان : راي زييد في بيته بعرا ، فقال : ما يسرني ان لي عدد كل بعرة دينارا.
 وكان يءذن في مسجده، ويقول للصبيان : تعالوا صلوا حتي اهب لكم الجوز، فيجيءون، فيصلون، ثم يحيطون حوله، فقلنا : ما تصنع ؟ فقال : وما علي ان اشتري لهم جوزا بخمسة دراهم ويتعودون الصلاة ؟] وكانت له شاة داجن () في البيت ، وعنده بعر كثير ، فيقول : ما احب ان لي بكل بعرة منها درهما.
 واذا كانت الليلة المطيرة . اخذ شعلة نار، ويطوف علي عجاءز الحي، ويقول لهم : اوكف () عليكم؟ اتريدون نارا؟ فاذا اصبح. . طاف عليهم ، ويقول: الكم في السوق حاجة ؟ اتريدون شيءا؟
 () كلمة فارسية.
 () الداجن : الشاة التي يعلفها الناس في منازلهم .
 () وكف الماء وفيره : سال وقطر، ووكف البيت بالمطر : تقاطر سقفه .



