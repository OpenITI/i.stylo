 ومنهم الامام : محمد بن واسع رضي الله عنه قال القشبري = رحمه الله  : قال بعض العارفين : رايت كان القيامة قد قامت، فقيل : ادخلوا مالك بن دينار ومحمد بن واسع الجنة، فنظرت ايهما يتقدم، فتقدم محمد بن واسع، فسالت عن سبب ذلك، فقيل : انه كان له قميص واحد ولمالك قميصان وقال الغزالي قدس الله روحه  : دخل محمد بن واسع علي قتيبة بن مسلم وعليه جبة صوف، فقال له قتيبة: ما دعاك الي الصوف؟ فسكت، فقال : اكلمك فلا تجيبني، فقال : اكره ان اقول زهدا فازكي نفسي ، او فقرا فاشكو ربي عز وجل وكان محمد بن واسع واصحابه يدخلون منزل الحسن، فياكلون ما يجدون بغير اذن، وكان الحسن يدخل، فيري ذلك، فيسر، ويقول : هنكذا ادركناهم . انتهي (" الاحياء" وقال الحافظ  رحمه الله: قال مالك بن دينار : كان محمد بن واسع من قراء الرحمدن وعن محمد بن واسع قال : اذا اقبل العبد بقلبه الي الله عز وجل. . اقبل الله اليه بقلوب المءمنين وكان يقول في دعاءه : اللهم؛ اني استغفرك من كل مقام سوء، ومقعد سوء، ومدخل سوء، ومخرج سوء، وعمل سوء، ونية سوء.. فاغفر لي وتب علي، انك انت التواب الرحيم وقال سليمان التيمي : ما احد احب الي من ان القي الله عز وجل بمثل صحيفته من حمد بن واسع وقدم من مكة الي البصرة ، فكان يصلي الليل كله في المخمل جالسا ، يومء براسه


 ============================================================
 ايماء، ويامر الحادي خلفه فيرفع صوته؛ لثلا يعرف انه يصلي: وجاء حوشب الي مالك بن دينار فقال له : يا ابا يحيي؛ رايت البارحة كان مناديا ينادي يقول : يا ايها الناس؛ الرحيل الرحيل ، فما رايت احدا يرحل.. الا محمد بن واسع، فصاح مالك وخر مغشيا عليه .
 وقال محمد بن واسع : القران بستان العارفين، فاينا حلوا منه. . حلوا في نزهة .
 وقال : ادركت رجالا كان الرجل منهم راسه مع راس امراته علي وسادة واحدة، قد بل ما تحت خده من دموعه عشرين سنه، لا تشعر به امراته، ولقد ادركت رجالا يقوم احدهم في الصف، فتسيل دموعه علي خده لا يشعر به الذي الي جانبه وقال جعفر: كنت اذا وجدت من قلبي قسوة. . نظرت الي وجه محمد بن واسع نظرة، وكنت اذا نظرت اليه. حسبت ان وجهه وجه ثكلي وكان اذا قيل له : كيف اصبحت؟ يقول : ما ظنك برجل يرتحل الي الله عز وجل كل يوم مرحلة، ويلقاه باعمال غير صالحة وقال وهب بن منبه  رحمه الله تعالي : رايت رسول الله صلي الله عليه وسلم في المنام ، فقلت : يا رسول الله؛ اين الابدال من امتك؟ فاوما بيده الكريمة قبل الشام ، فقلت : يا رسول الله؛ اما بالعراق منهم احد ؟قال : "بلي، محمد بن واسع ".
 ولما ثقل محمد بن واسع في مرضه.. كثر الناس عليه في العيادة، ناس قيام، وناس قعود، فلما نظر اليهم.. قال : ما يغني عني هلءلاء غدا اذا اخذ بناصيتي وقذف بي في النار، ثم تلا هلذه الاية: يعرف الشنرمون يسيكهم فيوخذ بالنوصي والاقدكع)، وقال : يا اخوتاه ؛ اتدرون اين يذهب بي؟ والله الذي لا الكه الا هو؛ الي النار ، او يعفو الله عز وجل عني: وقال له شخص : اني لاحبك في الله عز وجل، قال : احبك الله الذي احببتني له، ثم قال : اللهم ؛ اني اعوذ بك ان احب فيك وانت لي ماقت او مبغض .
 وقال : لو كان للذنوب ريح. . لما قدر احد ان يدنو مني من نتن ريحي، لكثرة ذتويي وقال مالك بن دينار : انما هو طاعة الله عز وجل او النار، فقال محمد بن واسع : انما هوعفو الله او النار.
 وطلب مالك بن المنذر  وكان عاملا علي البصرة  محمد بن واسع، فقال له : اجلس


 ============================================================
 علي القضاء، فابي، فعاوده، فابي، فقال : تجلس او اجلدك ثلاث مثة، فقال : ان تفعل. فانت مسلط ، ولا ذل خير من الذل في رضي الله سبحانه وتعالي وساله بعض الامراء في قبول شء ، فابين ، فقال له : انك احمق، فقال : ما زلت يقال لي هذذا مذكنت صغيرا.
 ونظر محمد بن واسع الي ابن له يخطر بيده() ، فقال له : تعال ويحك! اتدري ابن من انت؟ امك اشتريتها بمثتي درهم ، واما ابوك. . فلا كثر الله في المسلمين اضرابه، او : نحوه، او: مثله.
 وقال : انه ليعرف فجور الفاجر في وجهه.
 وقال : من مقت نفسه في ذات الله عز وجل . امنه الله تعالي من مقته .
 وكان يصوم الدهر، وءخفي ذلك:.
 وعن عبد العزيز ابن ابي رواد قال : رايت في يد محمد بن واسع قرحة، فكانه علم ما شق علي منها، فقال : اتدري ماذا لله عز وجل علي في هذه القرحة من نعمة ؟ قال : فسكت، قال: حيث لم يجعلها علي حدقتي، ولا علي طرف لساني، ولا علي طرف ذكري، قال : فهانت علي قرحته.
 وكان محمد بن واسع مع يزيد بن المهلب بخراسان غازيا، فاستاذنه للحج ، فاذن له ، فقال له : نامر لك بشء ؟ قال : تامر للجيش كله بمثله؟ قال : لا، قال : لا حاجة لي ودخل محمد بن واسع رحمه الله علي بلال ابن ابي بردة، فدعاه الي طعامه، فابي واعتل عليه، فغضب بلال، وقال : اراك تكره طعامنا، فقال : لا تقل مذذا ايها الامير، فوالله!
 ان خياركم احب الينا من ابناءنا : وكان محمد بن واسع مع قتيبة بن مسلم صاحب خراسان في جيش، وكان الترك قد خرجت اليهم، فبعث الي المسجد ينظر من فيه، فقيل له : ليس فيه الا محمد بن واسع رافعا اصبعه، فقال قتيبة : تلك الاصبع احب الي من ثلاثين الف عنان () بغطر بيده : اي يتمايل ويمشي مشية المعجب، وررد في " السير* (/ ) : (سبب هذذا القول : ان رجلا شكن الي محمد ابنه بانه كان يستطيل علي الناس) .
 


 ============================================================
 وكانهيقول : اللهم ؛ ان كان اخلق وجهي كثرة ذنوبي. . فهبني لمن احببت من خلقك .
 ولما اريد علي القضياء وامتنع.. عاتبته امراته، وقالت : لك عيال وانت محتاج، فقال لها : ما دمت تريني اصبر علي الخل والبقل. . فلا تطمعي في هذذا مني وقسم امير من امراء البصرة مالا علي قراء اهل البصرة، فارسل الي مالك بن دينار، فقبل، ولم يقبل محمد بن واسع، ثم قال له : يا مالك؛ قبلت جواءز السلطان ؟ فقال : يا ابا بكر؛ سل جلساءي ، قالوا : اشتري بها رقابا، فاعتقهم، فقال له محمد بن واسع : انشدك الله اقلبك الساعة له علي ما كان عليه قبل ان يرسل اليك الجاءزة قال : اللهم لا ، قال : اتعلم اي شء دخل عليك ؟ فقال مالك لجلساءه : ان مالكا حمار، انما يعبد الله مثل محمد بن واسع: وقال بلال ابن ابي بردة لمحمد بن واسع : ما تقول في القضاء والقدر؟ قال : ايها الامير؛ ان الله عز وجل لا يسال الناس يوم القيامة عن قضاءه وقدره، وانما يسالهم عن اعمالهم وقال محمد بن واسع : جاءني رجل في حاجة لرجل اخر، فقال : اتيتك في حاجة رفعتها الي الله عز وجل قبلك، فان يانن الله في قضاءها. . قضيتها وكنت محمودا، وان لم باذن الله في قضاءها. . لم تقضها وكنت معنورا.
 وقال محمد بن واسع  رحمه الله  : ليس لملول صديق، ولا لحاسد غنن، واياك ان تشير عليي معجب برايه؛ فانه لا يقبل منك .
 اسند عن جماعة من الصحابة، رضوان الله تعالي عليهم . انتهين ( الحلية/) .
 وقال ابو الفرج  رحمه الله  : توفي محمد بن واسع رحمه الله سنة عشرين ومثة .
 انتهين () [" الصفوة"/ .
 والله سبحانه وتعالي اعلم () جاء في هامش نسخة : (وعن علي ين الجعد قال : سمعت ابا جعفر يقول : راي رجل من اهل البصرة وكان مناديا ينادي من السماء : خير رجل بالبصرة محمد بن واسع).



 ============================================================
 ومنهم الامام : ابو يحيي مالك بن دينار رضي الله عنه قال الامام الحافظ  رحمه الله  : قال مالك بن دينار : خرج اهل الدنيا من الدنيا ولم يذوقوا اطيب شء فيها، قيل : وما هو يا ابا يحي  قال : معرفة الله عز وجل: وقال : ما تنعم المتنعمون بمثل ذكر الله سبحانه وتعالي وقال : ان الصديقين اذا قرء عليهم القران. . طربت قلوبهم الي الاخرة : وقال : لا يبلغ الرجل منزلة الصديقين حتي يترك زوجته كانها ارملة ، وياوي الي مزابل الكلاب: وقال : نظرت في اصل كل اثم . فوجدته حب الدنيا، فمن القي عنه حبها. . استراح.
 وقال : رايت في بعض الكتب : ان الله عز وجل يقول : (ان اهون ما انا صانع بالعالم اذا احب الدنيا. . ان اخرج حلاوة ذكري من قلبه) .
 وقال : اذا لم يكن في القلب حزن.  خرب ، كما اذا لم يكن في البيت ساكن.. فانه رب وقال : لولا اخشي ان تكون بدعة . . لامرت اني اذا مث ان اغل ، فادفع الي ربي سبحانه وتعالي مغلولا ، كما يدفع العبد الابق الي مولاء : وكان في مرض موته يقول : اللهم؛ انك تعلم اني لم اكن احب البقاء في الدنيا لبطن ولا فرج: وكان يصلي العشاء، ثم يقرب رغيفه، فيفطر عليه بعد افطاره بالماء في اول الوقت، ثم يقوم، فيصلي، وياخذ بلحيته، ويقول : يا رب؛ اذا جمعت الاولين والاخرين. . فحرم شيبة مالك بن دينار علي النار، فلا بزال يصلي ويقول ذلك الي الفجر .



 ============================================================
 وقال مالك بن دينار : قرات في الحكمة : ( ان الله تعالي يبغض كل حبر() سمين) .
 وقال : كم من رجل يحب ان يلقي اخاه ويزوره ، فيمنعه من ذلك الشغل والامر يعرض له؛ عسي الله ان يجمع بينهما في دار لا فرقة فيها .
 ثم يقول مالك : وانا اسال الله عز وجل ان يجمع بيننا ويينكم في ظل طوبن، ومستراح العابدين وكان يقول : اذا ذكر الصالحون . . فاف لي وت .
 وكان يقول : ان القلب المحب لله عز وجل يحب النصب لله سبحانه وتعالي وقال : قد اصطلحنا علي حب الدنيا، فلا يامر بعضنا بعضا، ولا ينهن بعضنا بعضا، ولا يذرنا الله سبحانه وتعالي علي هذا ، فليت شعري اي عذاب ينزل بنا ؟ وقال : انكم في زمان قد طلبت الدنيا فيه بعمل الاخرة، فاحذروا اولثك علي انفسكم، لا يوقعونكم في شبكاتهم وقال : ان البدن اذا سقم. . لم ينجع فيه طعام ولا شراب ولا نوم ولا راحة، وكذلك القلب اذا علق فيه حب الدنيا. . لم تنجع فيه الموعظة وكان يقول : لو اني اعلم ان قلبي يصلح علي كناسة.. لجلست عليها.
 وكان يقول : اتقوا الشخارة ، فانها تسحر قلوب العلماء . يعني : الدنيا:.
 وعنه قال : قال موسي عليه الصلاة والسلام : يا رب؛ اين اطلبك ؟ قال : (اطلبني عند المنكسرة قلوبهم) وحدثنا الحارث بن نبهان قال : قدمت من مكة، فاهديت الي مالك بن دينار ركوة، قال: فجءت يوما، فقال : يا حارث؛ تعال فخذ تلك الركوة، فقد شغلت علي قلبي، جاءني الشيطان فقال لي : يا مالك؛ ان الركوة قد سرقت، فقد شغلت علي قلبي: وقال : من تباعد عن زهرة الدنيا. . فذلك الغالب لهواه ، ومن فرح بمدح الباطل.. فقد استمكن الشيطان من قلبه () الحبر : العالم.
 


 ============================================================
 وقال : ينبغي للعالم ان يقتصد في لباسه، ويفر من ذنوبه الي الله سبحانه وتعالي، ويحوش العباد () علي طاعة الله عز وجل.
 وقال : ان استطعت ان تجعل بينك وبين الشهوات حاءطا من حديد. . فافعل.
 وقال : من غلب شهوة الدنيا. . فذلك الذي يخاف الشيطان من ظلله وكان رجل من الاغنياء بالبصرة له ابنة نفيسة فاءقة في الجمال ، فقال لها ابوها يوما : قد خطبك بنو هاشم والعرب والموالي ، فابيت، فمن تريدين قالت : ما اريد الا مالك بن دينار، هو  والله  غايتي، فقال الاب لاخ له : اءت مالك بن دينار، فاخبره بمكان ابنتي وهواها له، قال : فاتاه، وقال له : فلان يقرءك السلام، ويقول لك : انك تعلم اني اكثر اهل هذذه المدينة مالا، وافشاهم ضيعة، ولي ابنة نفيسة، وقد هويتك فشانك وهي، فقال مالك للرجل : عجبا لك يا فلان! اوما تعلم اني قد طلقت الدنيا ثلاثا وعن سلام ابن ابي مطيع قال : دخلنا علي مالك ليلا وهو في بيته بغير سراج، وفي يده رغيف يكدمه()، فقلنا : ابا يحي؛ الا سراج ؟ الا شء تضع عليه خبزك؟ قال: دعوني، فوالله؛ اني لنادم علي ما مضي: وقال لرجل من اصحابه : اني لاشتهي رغيفا لينا بلبن راءب ، فجاءه به، فجعل يقلبه وينظر اليه، وقال : اشتهيتك منذ اربعين سنة، فغلبتك حتي اذا كان اليوم.. تريد ان تغلبني، اليك عني، وابي ان ياكله : وقال : انه لتاتي علي السنة لا اكل فيها لحما ، الا في يوم الاضحي؛ فاني اكل من اضحيتي؛ لما يذكر فيه.
 وقال: اشتريت لاهلي طيبا بدرهم، واني لاحاسب نفسي فيه منذ عشرين سنة، فما اجد لي مخرجا.
 وما كان يملك من الدنيا الا درهمين، درهم يتقوت به، ودرهم يشتري به خوصا يعمل فيه، فاشتري بفلسين ملحا وكان ادمه في جميع سنته .
 وكان ياخذ حصاة من المسجد فيقول : وددت ان تكون هذه اجزاتني عن الدنيا .
 وقال مالك : لما وقعت الفتنة. . اتيت الحسن ثلاثة ايام اقول : يا ابا سعيد؛ () يحوش العباد : ياخذمم من حواليهم : ليضهم الي طاعة الله () الكدم : العض بادني الفم .



 ============================================================
 ما تامرني؟ فلا يجيبني ، قال : فقلت : يا ابا سعيد ؛ اتيتك ثلاثة ايام اسالك وانت معلمي فلا تجيبني! والله ؛ لقد هممت ان اخذ الارض بقدمي، واشرب من افواه الانهار، ومن نبات البرية، حتي يحكم الله بين عباده، فارسل الحسن عينيه وبكن وقال : يا مالك ؛ ومن يطيق ما تطيق  للكنا والله ما نطيق هذذا .
 وقال جعفر : كنت عند مالك بن دينار، قجاء هشام بن حسان  وكان ياتيه هشام كثيرا وسعيد ابن ابي عروية، وحوشب، يطلبون قلوبهم، فجاء هشام، فسال عن ابي يحي فقيل له : عند البقال، فقال : قوموا بتا اليه، قال : فحانت منه نظرة الي هشام، فقال له : يا هشام؛ اني اعطي هلذا البقال كل شهر درهما ودانقين، واخذ منه في كل شهر سءين رغيفا؛ لكل ليلة رغيفين، فاذا اصبتهما سخنين.. فهو ادامها وكان يلبس ازارا من صوف ، وعباءة خفيفة، فاذا كان الشتاء. . ففروة وعباءة.
 وكان يكتب المصاحف، ولا ياخذ عليها من الاجرة اكثر من عمل يده، فيعطيه للبقال ، وكان يكتب المصحف في كل اربعة اشهر.
 ووقع حريق في بيت مالك، فاخذ المصحف والقطيفة، فاخرجهما، فقيل له: يا ابا يحي؛ البيت، فقال : ما فيه الا السندانة()، ما ابالي ان يحترق.
 وفي رواية : جر بطرف كساءه وقال : هلك اصحاب الاثقال وكان يقول : لولا ان جهالكم كثير. . للبست المسوح().
 وقال : قال عيسي ابن مريم عليه الصلاة والسلام : خشية الله وحب الفردوس يباعدان من زهرة الدنيا ، ويءرثان الضبر علي المشقة .
 وعنه قال : قال عيسي عليه الصلاة والسلام : بحق اقول لكم : ان اكل الشعير والنوم علي المزابل مع الكلاب. . لقليل في طلب الفردوس: وعن سلام بن مسكين قال : دخلت علي مالك بن دينار في مرضه الذي مات فيه ؛ فاذا البيت فيه سرير اثل()، مزمول() بالشريط، وعليه قطعة بوري ()، وتحت راسه قطعة () السدان : ما يطرق الحداد الحديد عليه () اليوح : الاكسية المصنوعة من الشعر.
 () الاقل: شجر يشبه الطرفاء ، الا انه اعظم منه واكرم واجود، ومته اتخذ مبر رسول الله صلي الله عليه وسلم .
 ) مزمول : ملفوف.
