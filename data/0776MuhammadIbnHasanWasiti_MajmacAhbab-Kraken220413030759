 ومنهم الامام : علي الجرجراءي رضي الله عنه قال الحافظ ابو نعيم  رحمه الله  : قال سري السقطي قدس الله روحه: كان علي الجرجراءي() من الزهاد الكبار، واتفق اني خرجت من بغداد الي عبادان لاجل الرباط، وكنت عزمت علي ان اصوم بها رجبا وشعبان ورمضان، فاتفق في طريقي علي الجرجراءي، فقصدته وتعدت عنده، فلما ان كان وقت الافطار كان معي ملح مدقوق واقراص، فقلت له: هلم يرحمك الله، فقال : ملحك مدقوق ؟! [لن تفلح) ولن تدخل بستان المحبين ما دام ملحك مدقوقا، ثم نظرت الي مزود معه فيه سويق الشعير، فسف منه، فقلت له : ما دعاك الي هذذا؟ فقال : اني حسبت ما بين المضغ الي الاستفاف قدر سبعين تسبيحة، فما مضغت الخبز منذ اربعين سنة، قال : فلما دخلنا عبادان.. قلت : موعظة احفظها عنك ؟ فقال : نعم ان شاء الله تعالي : احنظ عني خمس خصال: عانق الفقر، وتوسد الصبر، وعاد الشهوات، وخالف الهوي، وافزع الي الله سبحانه وتعالي في جميع امورك، فاذا فعلت ذلك . . وهب الله عز وجل لك خمسا : الزهد، ومع الزهد القنوع ، ومع القنوع الرضا ، ومع الرضا المعرفة، ومع المعرفة الشوق، ثم يهب لك خمسا : السباق()، والبدار()، والتخفف، وحسن البشارة، وحسن المنقلب الي الله سبحانه وتعالي اولءك احباء الله، قلت : فاين تري لي ان اسكن؟ قال : ارحل نحو جبل لكام، () ي "الحلية" : (الجرجاني)، ولعل الصواب ما اثبت، لانها نسبة الن جرجرايا، وهي بلد بين بغداد وواسط، وقد خرج منها جماعة من العلماء والشعراء والكتاب والوزراء . اتظر "معجم البلدان" .( () الشباق : اي ان يعمل الانسان في الدنيا للاستباق في الجنة، ومته ما رواء الطبراني في "الاوسط، (/) عن عاءشة رضي الله عنها، عن النبي صلي اله عليه وسلم : " اليوم المضمار، وغدا السباق" () البقار : الاحتساب عند المصاءب ؛ وذلك طلبا للاجر وتحصيله بالتليم والصبر.



