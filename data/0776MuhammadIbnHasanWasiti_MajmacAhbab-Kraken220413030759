 وقال يوسف بن يعقوب بن الفرج : سمعت علي بن محمد القرشي قال : لما قدم احمد ابن حنبل ليضرب بالسياط، وجرود فلم يبق عليه سوي السراويل، فبينا هو يضرب.. اذ انحل السراويل، فجعل يحرك شفتيه، فرايت يدين خرجتا من تحته وهو يضرب، فشدتا السراويل، قال: فلما كان بعد ذلك.. سالته ما الذي كان يحرك به شفتيه حين اتحل السراويل، فقال : قلت : يا من لا يعلم العرش منه اين هو الا هو؛ ان كنت انا علي الحق. فلا تبد عورتي وقال صالح : لما جاء نعي المامون.. رد ابي ومحمد بن نوح الي الروقة ، واخرجنا من الرقة في سفينة، فلما كان (فيا بعض الطريق.. توفي محمد بن نوح، فتقدم ابي وصلي عليه، ثم حمل ابي الي بغداد وهو مقيد، فمكث اياما في دار، ثم صير الي الحبس في دار، ثم حمل الي حبس العامة في درب الموصلية، فمكث في السجن من حين اخذ وحمل الي ان ضرب، وخلي عنه  ثمانية وعشرين شهرا ، قال ابي : وكنت اصلي بهم وانا مقيد، وكنت اري بوران يحمل اليه الماء البارد في دورق()، ويجء به اليه في السجن، قال صالح : قال ابي : فلما كان شهر رمضان لسبع عشرة خلت منه.. حولت من السجن الي دار اسحاق بن ابراهيم وانا مقيد بقيد واحد، يبعث الي في كل يوم رجلان سماهما ابي، وهما: احمد بن رباح، وابو شعيب الحجام، فيكلماني ويناظراني، فاذا ارادا الانصراف. . دعي بقيد اخر قيدت به، فمكثت علي هذذه الحال ثلاثة ايام، وصار في رجلي اربعة اقياد.
 فقال لي احدهما في بعض الايام في كلام دار بيننا، وسالته عن علم الله تعالي ، فقال : علم الله تعالي مخلوق، فقلت له : يا كافر؛ كفرت، فقال لي الرسول الذي كان يحضر معهم من قبل اسحاق : هاذا رسول امير المءمنين، فقلت له : هذا قد كفر، وكان صاحبه الذي يجء معه خارجا، فلما دخل.. قلت له : ان هذذا زعم ان علم الله تعالي مخلوق، فنظر اليه كالمنكر عليه، ثم قاما وانصرفا.
 قال ابي : فلما كانت الليلة الرابعة بعد العشاء الاخرة . . بعث المعتصم مملوكا له اسمه بغا الي اسحاق بن ايراهيم يامره بحملي، فادخلت الي اسحاق، فقال : يا احمد؛ انها والله فسك، فانظر لها، انه قد حلف انه لا يقتلك بالسيف بل يضربك ضربا بعد ضرب، () الدورق : اناء للشراب، فارسي معرب


 ============================================================
 ويلقيك في موضع لا تري فيه الشمس، اليس قد قال الله عز وجل : { انا جعلنه قرهانا عربا) ؟ افيكون مجعولا الا مخلوقا؟ فقال له ابي : قد قال الله عز وجل : ( فجعلهم كعصف تاكول) افخلقهم ؟ قال اسحاق : اذهبوابه.
 قال ابي: فانزلت الي شاطء دجلة، واخذت الي الموضع المعروف بباب البستان ومي بغا الكبير ورسول من قبل اسحاق، قال : فقال بغا لمحمد المحاربي بالفارسية: ما تريدون من هذا الرجل ؟ فقال : يريدون منه ان يقول القران مخلوق، فقال: انا ما اعرف شيءا من هلذا ، ما اعرف الا قول : لا الله الا الله وان محمدا رسول الله، وقرابة امير المءمنين من رسول الله صلي الله عليه وسلم، فلما وصلنا اخرجت من السفينة، وجعلت علي دابة والاقياد في رجلي ، وما معي احد يمسكني، فبقيت كاني اجد علي وجهي حتي انتهينا الي الدار، فادخلت ، ثم غرج بي الي حجرة، فصيرت في بيت منها، واغلق الباب، واقعد عليه رجل، وكان ذلك في جوف الليل، وليس عندي سراج، فاحتجت الي الوضوء، فمددت يدي اطلب شيءا، فاذا انا باناء فيه ماء وطست، فتوضات وقمت اصلي فلما اصبحت.. جاءني الرسول، فاخذ بيدي وادخلني الدار، واذا الخليفة جالس وابن ابي دءاد حاضر، وقد جمع اصحابه والدار غاصة باهلها، فلما دنوت مته. . سلمت، فقال لي: ادنه ادنه، فلم يزل يدنيني حتي قربت منه، ثم قال لي: اجلس، فجلست، وقد اتقلتني الاقياد ، فلما مكثت ساعة . . قلت : اتاذن لي في الكلام ؟ قال : تكلم، فقلت : الي اي شء دعا الله عز وجل رسوله محمدا صلي الله عليه وسلم ؟ فقال : الي شهادة ان لا الكه الا الله، فقلت : انا اشهد ان لا الكه الا الله، ثم قلت له : ان جدك عبد الله بن عباس رضي الله عنهما روي : ان وفد عبد القيس لما قدموا علي رسول الله صلي الله عليه وسلم: امرهم بالايمان بالله وحده، قال : " اتدرون ما الايمان بالله وحده ؟ * قالوا : الله ورسول اعلم، قال : لاشهادة ان لا الكه الا الله وان محمدا رسول الله، واقام الصلاة، وايتاء الزكاة، وصوم رمضان، وان تعطوا الخمس من المغنم "()، فقال المعتصم : لولا اني وجدتك في يد من كان قبلي.. ما تعرضت لك، ثم التفت الي عبد الرحمان بن اسحاق، فقال له : يا عبد الرحمان؛ الم امرك برفع المحنة ؟ قال ابي : فقلت في نفسي : الله اكبر ، ان في هنذا لفرجا علي المسلمين، ثم قال المعتصم : ناظروه، كلموه، ثم قال : () اخرجه بنحوه ابن حبان () .
 


 ============================================================
 يا عبد الرحمان؛ كلمه، فقال لي عبد الرحمان : ما تقول في القران ؟ فقلت : ما تقول في علم الله تعالي؟ قال : فسكت، قال ابي : وجعل يكلمني هذذا وهذذا ، فارد علي ذا واكلم ذا، ثم اقول : يا امير المءمنين؛ اعطوني شيءا من كتاب الله عز وجل او سنة رسوله صلي الله عليه وسلم اقول به، قال : فيقول ابن ابي دءاد : وانت لا تقول الا ما في كتاب الله تعالي او سنة رسوله صلي الله عليه وسلم ؟ ثم قال ابن ابي دءاد : هذذا  والله  يا امير المءمنين ضال مضل مبتدع ، وهلءلاء قضاتك والفقهاء، فسلهم، فيقول لهم : ما تقولون ؟ فيقولون : يا امير المءمنين؛ هو ضال مضل مبتدع، ثم انهم لم يزالوا معي في جدال، وجعل صوتي يعلو علي اصواتهم، فقال لي انسان منهم : قال الله سبحانه وتعالي: ما يانيهم من ذكر من زيهم تحدث)، افيكون محدثا الا مخلوقا ؟ فقال : فقلت له : (ص والقرهان ذي الذكر)، فالذكر هنا هو القران ، وهناك ليس فيه الف ولام، فليس هو القران، قال : فجعل ابن سماعة لا يفهم ما اقول، فجعل يقول : ما الذي تقولون؟ فقالوا : انا نقول كذا وكذا، فقال لي انسان : ما تقول في حديث خباب : "تقرب الي الله تعالي ما استطعت؛ فانك لن تتقرب اليه بشء هو احب اليه من كلامه "()؟ فقال لهم ابي : وما الذي يلزم من هذذا ؟ وجعل ابن ابي دءاد ينظر الي ابي نظر الغيظ والغضب .
 فقال بعضهم : اليس قد قال تعالي : { الله خلق كل شء} ؟ فقلت : وقد قال الله تعالي:تدمر كل شقء)، فدمرت كل شء الا ما اراد الله سبحانه وتعالي .
 وقال بعضهم : ما تقول في حديث عمران بن الحصين : " ان الله تعالي خلق الذكر " ؟
 قلت : هذذا خطا، حدثنا غير واحد : " ان الله تعالي كتب الذكر "().
 وكان اذا انقطع الرجل منهم ؛ اعترض ابن ابي دءاد، فتكلم ، فلما قارب الزوال ؛ قال لهم: قوموا، ثم احتبس عبد الرحمنن بن اسحاق، وخلا بي وبعبد الرحان، وجعل يقول لي : اما تعرف صالحا الرشيدي؟ وكان مءدبي، وكان في هذذا الموضع جالسا، واشار الي ناحية من الدار ، وذكر القران، فخالفني ، فامرت به، فشحب وءطء الي ان مات، ثم ان عبد الرحمن جعل يقول : يا امير المءمنين؛ اني اعرفه منذ ثلاثين سنة، وهو يري طاعتك وطاعة من قبلك والحج والجهاد معك، وهو لازم لمنزله، فقال المعتصم : () اخرجه الحاكم (/).
 () اخرجه البخاري في " التاريخ الكبير" (/).
 


 ============================================================
 والله، انه لفقيه، وانه لعالم، ويسرني ان يكون مثله معي يرد علي اهل الملل، ولءن اجابني الي شء له فيه ادني فرج؛ لاطلقن عنه بيدي ، ولاطان عقبه، ولاركبن اليه بجندي، ثم يلتفت الي ويقول : ويحك يا احمدا ما تقول؟ فاقول : يا امير المءمنين؟
 اعطوني شيءا من كتاب الله تعالي او سنة رسوله صلي الله عليه وسلم.
 فلما طال بنا المجلس؛ ضجر وقام، ورددت الي الموضع الذي كنت فيه، ثم وجه الي برجلين من اصحاب ابن ابي دءاد يناظراني الي وقت الفطر، فاذا حان وقت الفطر؛ بعث الينا ماءدة، فاكلا منها، وانا اتعلل حتي ترفع الماءدة، ثم يقيمان عندي طول الليل، وفي خلال ذلك يجء ابن ابي دءاد ، فيقول : يا احمد؛ امير المءمنين يقول لك : ما تقول في القران ؟ فاقول : اعطوني شيءا من كتاب الله تعالي او سنة رسوله صلي الله عليه وسلم حتي اقول به، فقال لي : والله؛ لقد كتب اسمك في السبعة فمحوته، ولقد ساءني اخذهم اياك، انه والله ليس يقتلك بالسيف، وانما هو ضرب بعد ضرب، ثم يقول : ما تقول ؟
 فارد عليه كما رددت اولا، فيمضي من عندي، ثم ياتيني رسوله، فيقول: ان امير المءمنين يقول لك : ما تقول ؟ فارد عليه كالاول، ولا تزال رسله تختلف فيما بيني وبينه، وهم يقولون : امير المءمنين يقول : اجبني حتي اطلق عنك بيدي.
 فلما كان في اليوم الثاني ؛ ادخلت عليه، فقال : ناظروه وكلموه، قال : فشرعوا في الكلام من كل ناحية، يتكلم هاذا من هنا وهذذا من هنا، فارد عليهم، فاذا شرعوا في شء مما ليس من الادلة الشرعية؛ اقول لهم : ما ادري ما تقولون، فيقولون : يا امير المءمنين ؛ اذا توجه له الحجة علينا؛ وثب، واذا كلمناه بشء من الكلام؛ يقول: لا ادري، ما هذا؟ فيقول الخليفة : ناظروه، ثم يلتفت الخليفة الي ويقول : يا احمد؛ اني عليك شفيق، ويقول ابن ابي دءاد : والله يا امير المءمنين ؛ لءن اجابك الي ما تقول ؛ لهو احب الي من مثة الف دينار ومثتي الف دينار، ويعد ما شاء الله.
 ثم من بعد ذلك امرهم الخليفة بالانصراف، وخلا بي وبعبد الرحمن، فدار بيننا كلام كثير وفي خلال ذلك يقول : اندعو ابن ابي دءاد، فاقول : ذاك اليكم، فيطلبه، فيجء ويدور بيننا كلام كثير، الي ان طال المجلس وضجر الخليفة، فقام، ورددت انا الي الموضع الذي كنت فيه ، وجاءني الرجلان اللذان كانا عندي بالامس، وجعلا يتكلمان وانا ارد عليهما الي وقت الافطار، فلما جء بالطعام ؛ افطرا، وانا اتعلل، ورسل الخليفة تاتيني كالليلة الماضية.



 ============================================================
 ثم جاء ابن ابي دءاد فقال : ان الخليفة قد حلف انه لا يزال يضربك ضربا بعد ضرب ويحبسك في موضع لا تري فيه الشمس، ولم يزل يكلمني وانا ارد عليه الي قريب الفجر، ثم مضي، فقلت : ان يحدث في هلذا اليوم من امري شء، وكنت قبل ذلك قد اخرجت تكتي من سراويلي شددت بها الاقياد احملها بها اذا توجهت اليه، فقلت لبعض الموكلين بي: اريد خيطا، فجاءني بخيط فشددت به الاقياد ، واعدت التكة الي سراويلي؛ خيفة ان يحدث شء فتبدو عورتي، فلما اصبحنا في اليوم الثالث؛ ادخلت عليه والمجلس غاص محفل، وجعلوا يدخلوني من دار الي دار، وقوم معهم السيوف، وقوم معهم السياط الي غير ذلك من الاسلحة، وقد امتلات الدار بالجند بخلاف اليومين الماضيين، فلما وصلت اليه؛ قال : ناظروه، كلموه، فشرعوا في المناظرة، ولم نزل في حجاج وجدال الي ان ارتفع النهار، وجاء الوقت الذي يخلو معي، نحاني، وجعهم، وشاورهم، ثم تحاهم، ودعاني، فلما جءت؛ خلا بي وبعبد الرحمان، وقال لي : ويحك يا احمدا انا والله عليك شفيق، واني لاشفق عليك مثل شفقتي علي ابني هارون، فاجبني، فارد عليه كما رددت اولا.
 وفي رواية اخري : قال لي : من اين قلت هذذا؟ قلت : من كتاب الله عز وجل وسنة رسوله صلي الله عليه وسلم، فقال : استدد علي ذلك، فقلت : حدثني عبد الرزاق، عن معمر، عن الزهري، عن سالم، عن ابيه ان البي صلي الله عليه وسلم قال : " ان الله سبحانه وتعالي كلم موسي عليه الصلاة والسلام بمءة الف كلمة وعشرين الف كلمة وثلاث مثة كلمة وثلاث عشرة كلمة ، وكان الكلام من الله عز وجل والاستماع من موسي عليه الصلاة والسلام"، فقال الخليفة : كذبت علي رسول الله صلي الله عليه وسلم، فقال احمد: قال الله عز وجل في محكم كتابه العزيز : ( ولتكن حق القول مني لاملان جهنم مب الجنة والناس اجمعير}، قال : فالتفت الخليفة الي ابن ابي دءاد وابن الزيات، وقال : ناظروه، كلموه، فقالوا : يا امير المءمنين؛ اقتله، ودثه في اعناقنا، قال : فرفع الخليفة يده ولطم بها وجه احمد ابن حنبل رحمه الله، فخر مغشيا عليه قال : فتعرق وتمعر وجوه قواد راسان وكان عمه فيهم، فخاف الخليفة علي نفسه، ودعا بماه فرش منه علي وجهه فلما افاق؛ رفع راسه الي عمه وهو واقف بين يدي الخليفة، فقال له : يا عم؛ لعل هذذا الماء الذي وش منه علي وجهي غصب عليه صاحبه، فقال الخليفة عند ذلك : ويحكم! اما ترون ما يهجم علي من هنذا وقرابتي من رسول الله صلي الله عليه وسلم؛ لا رفعت السوط


 ============================================================
 عنه حتي يقول : القران مخلوق، ثم التفت الي احمد، واعاد عليه القول، فرد احمد كالاول، ولا زال كذلك حتي ضجر وطال المجلس، فعند ذلك قال : عليك لعنة الله، لقد كنت طمعت فيك خذوه، خلعوه، اسحبوه() قال احمد : فاخذت وسجنت، ثم خلعت، ثم قال الخليفة : علي بالعقابين () والسياط، فجء بالعقابين والسياط، قال احمد : وكان عندي شعرات من شعر النبي صلي الله عليه وسلم، فصررتها في كم قميصي، فنظر اسحاق بن ابراهيم الي الصرة، فقال : ما هذا؟ فقلت : شعر من شعر النبي صلي الله عليه وسلم، وجاء بعض القوم الي تميصي ليحرقه، فقال لهم الخليفة : لا تحرقوه، انزعوه عنه، وانما درء عن القميص الحرق ببركة شعر النبي صلي الله عليه وسلم؛ لكونه فيه، ثم صيرت بين العقابين، وشدت يداي، وجء بكرسي، فجلس عليه المعتصم، وابن ابي دءاد قاءم، والناس اجمعون قيام، ثم قال لي انسان: امسك راس الخشبتين بيديك، وشد عليهما، فلم افهم مقاله، فلم افعل، فتخلعت يداي لما شدت، ولم اكن احسن ان امسك الخشبتين كما قيل لي، فلم يزل احمد رحمه الله يتوجع منهما الين ان مات.
 ثم قال الخليفة للجلادين : تقدموا، ونظر الي السياط، فقال : اثتوني بغيرها، ثم قال لهم: تقدموا، وقال لاحدهم : ادنه، اوجع قطع الله يدك، فتقدم، فضربني سوطين، ثم تنحي، ثم قال لاخر: ادنه، وشد قطع الله يدك فتقدم، فضربني سوطين، ثم تشحي) ولم يزل يستدعي جلادا بعد جلاد، فيضربني كل واحد سوطين ويتنحي، ثم قام المعتصم، وجاءني، وهم محدقون بي، فقال لي : ويحك يا احمدا تقتل نفسك، اجبني حتي اطلق عنك بيدي قال: وجعل بعضهم يقول لي: امامك علي راسك قاءم، وعجيف ينخسني بقاءم سيفه، ويقول : اتريد ان تغلب هلءلاء كلهم، واسحاق بن ابراهيم يقول : ويلك! الخليفة قاءم علي راسك، وبعضهم يقول: يا امير المءمنين؛ دمه في عنقي، قال : فرجع المعتصم الي الكرسي، ثم قال للجلادين : ادنه قطع الله يدك، شد قطع الله يدك، ثم لم يزل يدعو بجلاد بعد جلاد، فيضربني كل واحد سوطين ويتنحن، وهو يقول له: شد قطع الله يدك، ثم جاء الي ثانيا، وقال لي : يا احمد؛ اجبني، وعبد الرحمان بن اسحاق () في نسخة : (اسجنوه) () العابان : عشبتان تغزران بالارض بينهما جلد، يلقن عليه الرجل المضروب ممدودا


 ============================================================
 يقول: من صنع بنفسه من اصحابك مثل ما صنعت انت بنفسك ؟ هذا فلان، وهذا فلان ، يعد علي من اجاب، والمعتصم يقول: ويحك! اجبني حتي اطلق عنك بيدي، فارد كالاول، فرجع وجلس علي الكرسي، ثم قال للجلادين : شد قطع الله يدك : قال احمد : فذهب عقلي، وما عقلت الا وانا في حجرة مطلق عني الاقياد، فقال لي انسان ممن حضر : انا كببناك علي وجهك، وطرحنا علي ظهرك بارية، ودسناك، فقلت : والله؛ ما شعرت بذلك، ثم جاءوني بسويق، وقيل لي : اشرب وتقيا، فقلت : لا افطر : ثم جء بي الي دار اسحاق بن ابراهيم، ونودي لصلاة الظهر، فصلينا الظهر، فقال لي ابن سماعة: اصليت والدم يسيل من ضربك؟ فقلت له : قد صلي عمر بن الخطاب رضي الله عنه وجرحه يثعب() دما، فسكت : ثم خلي عني، فجءت الي المنزل، ثم وجه الي المعتصم رجلا ينظر الضرب والجراحات، ويعالج، فنظر، وقال : والله؛ لقد رايت من ضرب الف سوط، وما رايت ضربا اشد من هذا ، ثم ادخل ميلا في بعض تلك الجراحات، ومكث زمانا يتردد اليه ويعالجه، وكان قد اصاب وجهه غيرما ضربة، واستمر ما شاء الله يعالج فيه، ثم قال : ان ههنا شيءا لا بد من قطعه، فجاء بحديدة، وجعل يعلق اللحم بها، ويقطع مواضع، وبقي اثر الضرب بينا في ظهره الي ان مات رحمه الله : قال صالح : سمعت ابي يقول : والله يا بني؛ لقد اعطيت المجهود من نفسي، ولوددت اني انجو من هلذا الامر كفافا لا علي ولا لي: قال صالح : واخبرني احد الرجلين اللذين كانا معه قال : والله؛ ما رايت احدا بعيني كان يشبهه، ولقد كنت اقول له لما يجء الطعام : يا ابا عبد الله؛ انت صاءم وعطشان، وهذذا الماء والثلج، فينظر اليه ولا يشرب منه، وكنت اعجب من صبره علي الجوع والعطش، وما هو فيه من الهول قال صالح : وكنت احتال ان اوصل اليه طعاما او رغيفا، فلم اقدر علي ذلك، واخبرني رجل ممن حضره، قال : لقد ترصدته في ايام المناظرة وهو في تلك المحنة، فما لحن في كلمة ما، وما ظننت ان احدا يكون في شجاعة هذا وشدة قلبه .
 وقال صالح: دخلت علي ابي يوما، فقلت له : بلغني ان رجلا جاء الي فضل ) بنب: يسيل


 ============================================================
 الانماطي، فقال له : اجعلني في حل اذ لم اقم بنصرك، فقال فضل : لا جعلت احدا في حل ممن قدر علي نصرتي وتاخر، فتبسم ابي وسكت، فلما كان بعد ثلاثة ايام؛ قال لي ابي : قد مررت بهذه الاية الكريمة : فمن عفا واصلح فاجر علي اله) فنظرت في تفسيرها ؟
 فاذا هو ما حدثني به هاشم بن القاسم بن المبارك، حدثني من سمع الحسن قال : (اذا جثت الامم بين يدي رب العالمين يوم القيامة ؛ نودوا : ليقم من اجره علي الله، فلا يقوم الا من عفا في الدنيا)()، قال ابي : فجعلت الميت في حل من ضربه اياي ، ثم جعل ابي يقول : وما علي رجل الا يعذب الله عز وجل بسببه احدا؟
 قال : ثم ان اسحاق بن ابراهيم وجه الي احمد، وقال له : الزم بيتك، ولا تخرج الي جمعة ولا جماعة، والا.. نزل بك مانزل في ايام المعتصم، ثم ان احمد اقام مختفيا لا يخرج الين صلاة ولا الي غيرها الي ان مات الواءق ، وولي المتوكل ، ورفع المحنة، واظهر العدل والسنة.
 وقال عبد الله بن احمد : قال ابي : اول سماعي من هشيم سنة تسع وسبعين ومءة، وكان ابن المبارك قد قدم في هلذه الينة، وهي اخر قدمة قدمها، فذهبت الي مجلسه، فقالوا : قد خرج الي طرسوس، فتوفي سنة احدي وثمانين ومثة .
 قال عبد الله : وخضب ابي راسه ولحيته، وهو ابن ثلاث وستين سنة، وطلب الحديث وهو ابن ست عشرة سنة، ومات هشيم وقد بلغ ابي من العمر عشرين سنة.
 وقال محمد بن عبد الملك : رايت يزيد بن هارون يصلي، فجاء اليه احمد ابن حنبل) فلما فرغ من الصلاة؛ التفت الي احمد، وقال له : يا ابا عبد الله؛ ما تقول في العارية ؟
 قال : مءداة، فقال يزيد بن هارون : اخبرنا حجاج بن الحكم انه قال : ليست بمضمونة، فقال له احمد : قد استعار النبي صلي الله عليه وسلم من صفوان بن امية ادراعا، فقال له : عارية مءداة؟ فقال النبي صلي الله عليه وسلم : "عارية مءداة "()، فسكت يزيد بن هارون، وصار الي قول احمد.
 وقال قتيبة بن سعيد : لولا سفيان الثوري؛ لمات الورع ، ولولا احمد ابن حنبل ؛ لادخل في الدين.
 () اخرجه بشحوه الطبراني في "الاوسط* (/).
 () اخرجه الحاكم (/).
 


