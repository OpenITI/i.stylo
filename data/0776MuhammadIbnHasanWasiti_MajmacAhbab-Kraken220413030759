 ومنهم الامامان : يزيد بن شريك التيمي وابنه ابراهيم رضي الله عنهما قال الحافظ  رحمه الله : عن يزيد بن شريك قال : قدمت البصرة، فربحت فيها عشرين الفا، فما اكترثت بها فرحا .
 وقال : ما اريد ان اعود اليها؛ لاني سمعت ابا ذر يقول : صاحب الدرهم يوم القيامة اخف حسابا من صاحب الدرهمين وقال : اني لاقعد من امراتي مقعد الرجل من اهله، فاذكر الموت، فما انا باقدر عليه مني من ان امس السماء .
 وقال ابراهيم التيمي بن يزيد : مثلت نفسي في النار اعالج اغلالها وسعيرها ، واكل من زقومها، واشرب زمهريرها()، فقلت : يا نفس؛ اي شء تشتهين ؟ قالت : ارجع الي الدنيا، فاعمل عملا صالحا؛ لعلي انجو به من هلذا العذاب ، ومثلت نفسي في الجنة مع حورها، والبس من سندسها واستبرقها وحريرها، فقلت : يا نفس؛ اي شء تشتهين ؟
 قالت : ارجع الي الدنيا، فاعمل عملا ازداد به من هلذا الثواب ، قلت : فانت في الدنيا وفي الامنية : وقال ابراهيم التيمي : ما عرضت عملي علي قولي. . الا خشيت ان اكون مكذبا .
 وربما قيل لابراهيم : تكلم، فيقول : ما يحضرني نية وكان من دعاته: اللهم؛ اعصمني بكتابك وسنة نبيك محمد صلي الله عليه وسلم من الاختلاف في الحق، ومن اتباع الهوي بغير هدي منك، ومن سبل الضلالة ، ومن شبهات الامور، ومن الزيغ واللبس والخصومات .
 () الزمهرير : هو ريح جهنم، وقيل هو: الصديد وما يسيل من دموع وغسالة اهل النار، ولعله المراد هنا ، اعاذنا الله والمسلمين منها .



 ============================================================
 وقال: ما اكل اكل اكلة تسره، ولا شرب شربة تسره.. الا نقص بها من حظه في الاخرة: وكان اذا سجد. . تجء العصافير، فتنقر علي ظهره، كانه جذم() حاءط.
 وقال : كم بينكم وبين القوم ؟ اقبلت عليهم الدنيا فهربوا منها، وادبرت عنكم فاتبعتموها وقرا في قصصه : ( فالذين كفروا قطعت لثم نياب من نار)، فقال ابراهيم : سبحان من قطع من النيران ثيابا وقال في قوله تعالي : (ويايه الموث من كل مكان}، قال : حتل من موضع كل شعرة، وقال الحسن بن هارون : من اطراف كل شعرة.
 وقال ابراهيم النخعي : ما احد ممن يتكلم احري ان يطلب به وجه الله من ابراهيم التيي وعن العوام بن حوشب قال : ما رايت رجلا قط خيرا من ابراهيم التيمي، وما رايته رافعا بصره الي السماء في صلاة ولا في غيرها، وسمعته يقول : ان الرجل ليظلمني فارحمه وقال في قوله تعالي : { في يوم كان مقداره الف سنة) قال : ما طول يوم القيامة علي المءمنين الا ما بين الظهر والعصر: وقال ابراهيم التيمي : رايت في المنام كاني وردت علي نهر، فقيل لي : اشرب واسق من شءت ؛ بما صبرت وكنت من الكاظمين . انتهي [ الحلية"/) .
 وقال ابو الفرج  رحمه الله  : توفي ابراهيم التيمي في حبس الحجاج، سنة اثنتين وتسعين، قال علي بن محمد : كان سبب حبس ابراهيم التيمي : ان الحجاج طلب ايراهيم النخعي، فجاء الذي طلبه، فقال : اريد ايراهيم ، فقال : انا ابراهيم، فاخذه وهو لا يعلم انه ابراهيم التيمي، ولم يستحل ان يدل عليه()، فجاء الحجاج، فامر بحبسه في الديماس() ، ولم يكن له ظل من الشمس ، ولا كي من البرد ، وكان كل اثنين في سلسلة ، () جذم الحاءط: بقيته () اي : لم يبح لنفسه ان يدل رسول الحجاج علي ابراهيم النخمي () الديماس : البيت المظلم في جوف الارض وايضا : الحمام .



 ============================================================
 فتغير ابراهيم، فجاءته امه في الحبس، فلم تعرفه حتي كلمها، فمات في السجن، فراي الحجاج في منامه قاءلا يقول له : مات في هذه البلدة الليلة رجل من اهل الجنة، فلما اصبح.. قال : مات الليلة احد بواسط؟ قالوا : نعم، ابراهيم التيمي مات في السجن، فقال : حلم، نزغة من نزغات الشيطان ، فامر به، فالقي علي الكناسة انتهل (" الصنوة" وقال الحافظ : قال الاعمش : قلت لابراهيم التيمي : بلغني انك تمكث شهرا لا تاكل شيءا، قال: نعم، وشهرين، ما اكلت منذ اربعين ليلة، الا حبة عنب، ناولنيها اهلي) فاكلتها، ثم لفظتها .
 ومن كلامه : اي حسرة علي امرء اكبر من ان يكون له غلام في الدنيا يراه يوم القيامة افضل منزلة منه عند الله عز وجل واي حسرة علي امرء اكبر من ان يصيب مالا، فيرثه غيره، فيعمل فيه بطاعة الله فيصير وزره عليه واجره لغيره! واي حسرة علي امرء اكبر من ان يري من كان مكفوف البصر ، ففتح له عن بصره يوم القيامة وعمي هوا ان من كان قبلكم يفرون من الدنيا وهي مقبلة عليهم، ولهم من القدم ما لهم، وانتم تتبعونها وهي مدبرة عنكم، ولكم من السيءات ما لكم، فقيسوا امركم وامر القوم .
 وقال : بلغني انه يقسم للرجل من اهل الجنة شهوة مثة واكلهم ونهمتهم ، فاذا اكل..
 سقي شرابا طهورا، فخرج من جلده رشح كرشح المسك ، ثم تعود شهوته .
 وقال : اذا رايت الرجل يتهاون في التكبيرة الاولي. . فاغسل يدك منه .
 وقال : ينبغي لمن لم يحزن ان يخاف ان يكون من اهل النار؛ لان اهل الجنة قالوا : الحمد لله الذي اذهب عنا الحزن)، وينبغي لمن لم يشفق () ان يخاف الا يكون من اهل الجنة ؛ لانهم قالوا : ( انا كنا قبل في اهلنا مشفقين وقال : اعظم الذنب عند الله عز وجل. . ان يحدث العبد بما ستر الله سبحانه وتعالي ليه اسند ابراهيم بن يزيد عن جماعة، واكثر روايته عن ابيه، وعن الحارث بن سويد.
 انتهي ("السلية/).
 () شفق : الشفقة هنا بمعني الخوف من اله عز وجل، وبسبب هنه الشفقة من الله علي المءمنين بالسغفرة والرحة


