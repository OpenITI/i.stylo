 وعنه : باسناده عن محمد بن شهاب الزهري : ان مالك بن اوس بن الحدثان حدثه قال: ارمل الي عمر بن الخطاب رضي الله عنه، فجءته حين تعالي النهار، قال : فوجدته في بيته جالسا علي سرير مفضيا الي رماله، متكيا علي وسادة من ادم ، فقال لي : يا مالك ؛ انه قددف اهل ابيات من قومك ()، وقد امرت فيهم برضخ فخذه، فاقسمه بينهم، فقلت : لو امرت بهذا غيري، قال : خذه يا مال، قال : فجاء يرفا() فقال : هل لك يا امير المءمنين في عثمان وعبد الرحمان بن عوف والزبير وسعد ؟ قال عمر : نعم، فاذن لهم، فدخلوا، ثم جاء، فقال : هل لك في عباس وعلي؟ قال : نعم، فاذن لهما، قال عباس: يا امير المءمنين؛ اقض بيني وبين هذا، فقال بعض القوم : اجل يا امير المءمنين، فاقض بينهما، قال مالك بن اوس : فخيل الي انهم كانوا قدموهم لذلك ، قال عمر: انشدكم الله الذي باذنه تقوم السموات والارض، اتعلمون ان رسول الله صلي الله عليه وسلم قال: "لا نورث، وان ما تركنا صدقة" () قالوا : نعم ، ثم اقبل علي العباس وعلي رضي الله عنهما ، فقال : انشدكما بالله الذي باذنه تقوم السماء والارض؛ اتعلمان ان رسول الله صلي الله عليه وسلم قال : " لا نورث، وان ما تركنا صدقة "؟ قالا : نعم، قال عمر رضي الله عنه : فان الله تبارك وتعالي كان خص رسول الله صلي الله عليه وسلم بخاصة لم يخص بها احدا غيره ؛ قال : ( ما افله الله علي رسوله من اهل القري ذلله وللرشول ولزي القري واليتن) ، ما ادري هل قرا الاية التي قبلها، ام لا؟
 قال: فقسم رسول الله صلي الله عليه وسلم بينكم النضير، فوالله؛ ما استاءر عليكم ولا اخذها دونكم حتي بقي هذذا المال، فكان رسول الله صلي الله عليه وسلم ياخذ منه نفقة سنته، ثم يجعل ما بقي اسوة المال، ثم قال : انشدكم بالله الذي باذنه تقوم السماء والارض؛ اتعلمون ذلك؟ قالوا : نعم، ثم نشد عباسا وعليا بمثل ما نشد به القوم، اتعلمان ذلك ؟ قالا: نعم، قال : فلما توفي رسول الله صلي الله عليه وسلم.. قال ابو بكر : انا ولي رسول الله صلي الله عليه وسلم، فجتما تطلب ميراءك [من ابن اخيك]، ويطلب هذذا ميراث امراته [من ابيها]، فقال ابو بكر رضي الله عنه : قال رسول الله صلي الله عليه وسلم: "لا نورث، ما تركثا صدقة "، ثم توفي ابو بكر رضي الله عنه، فقلت : انا () دفت علينا دافة : اي اتت علينا جماعة من بلد الن بلد ، يسيرون سيرا علن فهل ) برفا : هو حاجب سيدتا عمر () اخرجه البخاري () .



 ============================================================
 ولي رسول الله صلي الله عليه وسلم وولي ابي بكر، فءليتها، ثم جثتماني جميعا وامءكما واحد فقلتما : ادفعها الينا، فقلت : ان شءتما.. دفعتها اليكما، علي ان عليكما عهد الله ان تعملا فيه بالذي كان يعمل رسول الله صلي الله عليه وسلم، فاخذتماها بذلك، فقال : اكذلك ؟ قالا : نعم، ثم جءتماني لاقضي بينكما، ولا والله ؛ لا اقضي بينكما بغير ذلك حتي تقوم الساعة، فان عجزتما عنها.. فرداها الي زاد في رواية اخري : ان عمر رضي الله عنه قال : وليتها بعد ابي بكر سنتين من امارتي، ثم بدا لي ان ادفعها اليكم، فاخذت عليكما عهد الله وميثاقه ان تعملا فيها بما عمل فيها رسول الله صلي الله عليه وسلم وابو بكر بعده، فقلتما : ادفعها الينا علي ذلك، ان كنتما عجزتما عنها. . فادفعاها الي، قال : فغلبه عليە رضي الله عنه عليها، فكانت بيد علي، ثم بيد الحن، ثم بيد الحسين، ثم بيد علي بن الحسين، ثم بيد حن بن حسن، ثم بيد زيد بن حسن قال معمر: ثم كانت بيد عبد الله بن حسن حتي ولي يعني : بني العباس فقبضوها رواه مسلم في "الصحيح [).
 زاد في رواية اخري : قال مالك بن اوس بن الحدثان النصري : ان عمر بن الخطاب رضي الله عنه دعاه بعدما ارتفع النهار، قال : فدخلت عليه؛ فاذا هو جالس علي رمال سرير ليس بينه وبين الرمال فراش زاد في رواية اخري : فكانت هاذه الصدقة بيد علي بن ابي طالب رضي الله عنه، وطالت فيها خصومتهما، فابي عمر رضي الله عنه ان يقسها بينهما حتي اعرض عنها عباس، ثم كانت بعد علي بيد حسن بن علي، ثم بيد حسين بن علي، ثم بيد علي بن حسين وحسن بن حن، كلاهما كانا يتداولانها، ثم بيد زيد بن حسن، وهي صدقة رسول الله صلي الله عليه وسلم حقا وفي رواية : عن عاءشة رضي الله عنها : ان فاطمة والعباس رضي الله عنهما اتيا ابا بكر يلتمسان ميراءها من رسول الله صلي الله عليه وسلم، وهما حينثذ يطلبان ارضه من فدك، وسهمه من خيبر، فقال لهما ابو بكر رضي الله عنه : سمعت رسول الله صلي الله عليه وسلم يقول : "لا نورث، ما تركنا صدقة ، انما ياكل ال محمد في هذذا المال، والله؛ اني لا ادع امرا رايت رسول الله صلي الله عليه وسلم يصنعه بعذ. . الا صنعته .



 ============================================================
 وفي رواية اخري : قال : كانت فاطمة تسال ابا بكر نصيبها مما ترك رسول الله صلي الله عليه وسلم من خيبر وفدك وصدقته بالمدينة، فابي ابو بكر عليها ذلك، قال : لست تاريا شيءا كان رسول الله صلي الله عليه وسلم يعمل به.. الا عملت، فاني اخشي ان تركت شيءا من امره.. ان ازيغ، فاما صدقته بالمدينة.. فدفعها عمر الي علي والعباس رضي الله عنها، فغلب عليق عليها، واما خيبر وفدك. فامسكهما عمر، وقال : هما صدقة رسول الله صلي الله عليه وسلم، كانت لحقوقه التي تعروه ونواءيه، وامرهما الي ولي الامر، فهما علي ذلك الي اليوم . رواه البخاري في " الصحيح " [) .
 زاد في رواية : عن الشعبي قال : لما مرضت فاطمة رضي الله عنها.. اتاها ابو بكر الصديق رضي الله عنه، فاستاذن عليها، فقال علي رضي الله عنه : يا فاطمة.. هذا ابو بكر يستاذن عليك فقالت : اتحب ان اذن له ؟ قال : نعم، فاذنت له، فدخل عليها يترضاها، وقال : والله؛ ما تركت الدار والمال والاهل والعشيرة. . الا لابتغاء مرضاة الله ومرضاة رسول الله ومرضاتكم اهل البيت، ثم ترضاها حتي رضيت . هلذا مرسل حن باسناد صيح وفي رواية: عن المغيرة قال : جمع عمر بن عبد العزيز بني مروان حين اسءخلف، فقال : ان رسول الله صلي الله عليه وسلم كانت له فدك، وكان ينفق منها ويعود منها علي صغير بني هاشم، ويزوج فيه ايتهم، وان فاطمة رضي الله عنها سالته ان يجعلها لها، فابن، فكانت كذلك في حياة رسول الله صلي الله عليه وسلم حتي مضي لسبيله، فلما ولي ابو بكر رضي الله عنه. . عمل فيها بما عمل النبي صلي الله عليه وسلم في حياته حتي مضي لسبيله، فلما ولي عمر رضي الله عنه.. عمل فيها بمثل ما عملا حتي مضي لسبيله، ثم اقطعها مروان، ثم صارت لعمر بن عبد العزيز قال عمر بن عبد العزيز : فرايت امرا منعه رسول الله صلي الله عليه وسلم فاطمة رضي الله عنها ليس لي بحق، واني اشهدكم اني قد رددتها علي ما كانت؛ يعني: علي عهد رسول الله صلي الله عليه وسلم قال الشيخ : انما اقطع مروان فدكا في ايام عثمان بن عفان رضي الله عنه ، وكانه تاول في ذلك ما روي عن النبي صلي الله عليه وسلم : " اذا اطعم الله نبيا طعمة.. فهي للذي يقوم من بعده، وكان مستغنيا عنها بماله، فجعلها لاقرباءه، ووصل بها رحمهم، وكذلك


