 ومنهم الامام : ابو موسي الاشعري رضي الله عنه قال ابو الفرج  رحمه الله تعالي : اسلم ابو موسي يمكة، وهاجر الي الحبشة، ثم قدم مع امل السفينتين ورسول الله صلي اله عليه وسلم بخيبر، وبعضهم ينكر هجرته الي الحبشة وقد روي : ان رسول الله صلي الله عليه وسلم بعث معاذا وابا موسي الي اليمن، وامرهما ان يعلما الناس القران().
 وقد صح من حديث ابي موسي، قال : قال رسول الله صلي الله عليه وسلم : "لو رايتني وانا استمع قراءتك البارحة ، لقد اوتيت مزمارا من مزامير ال داوود" ، فقلت : يا رسول الله ؛ لو علمت انك تستمع قراءتي. . لحبرته لك تحبيرا().
 وفي " الصحيحين " [خ  م ] : من حديث ابي موسي قال : خرجنا مع رسول الله صلي الله عليه وسلم في غزاة، ونحن ستة نفر علي بعير تعتقبه ()، قال : فنقبت اقدامنا، ونقبت قدمي، وسقطت اظفاري، فكنا نلف الخرق علي ارجلنا، فسميت غزاة ذات الرقاع؛ لما كنا نعصب علي ارجلنا من الخرق، ثم ان ابا موسي ندم علي ذكر ذلك ، وقال : ما كنت اصنع بان اذكره، كانه كره ان يكون شيءا من عمله افشاه وكان عمر بن الخطاب رضي الله عنه يقول لابي موسي : ذكرنا ربنا تعالي ، فيقرا .
 وعن ابي بردة قال : لما احتضر ابو موسي. . قال : (يا بني؛ اذكروا صاحب الرغيف، قال : كان رجل يتعبد في صومعة سبعين سنة، لا ينزل الا في يوم واحد، قال : فشب الشيطان في عينه امراة، قال : فكان معها سبعة ايام او سبع ليال، ثم كشف عن الرجل () احرجه احمد(/) .
 () اخرجه ابو نعيم في " المند التخرج علن صحيح مسلم* (/) () اي : نتعاقيه في الركوب واحدا بعد واحد.
 


 ============================================================
 غطاءه، فخرج تاءبا، فكان كلما خطا خطوة.. صلي وسجد، واواه الليل الي دكان عليه اثنا عشر مسكينا، فادركه الاعياء، فرمي بين رجلين منهم ، وكان ثم راهب يبعث اليهم كل ليلة باثني عشر رغيفا، فيعطي كل انسان رغيفا، فجاء صاحب الرغيف، فاعطي كل انسان رغيفا، ومر علي ذلك الرجل الذي خرج تاثبا، فظن انه مسكين ، فاعطاه رغيفا، فقال المتروك لصاحب الرغيف : ما لك لم تعطني رغيفي؟ فقال : اتراني امسكته عنك، اهل اعطيت احدا منكم رغيفين ؟ قالوا : لا، فعمد التاءب الي الرغيف الذي معه، فاعطاه لذلك المسكين المتروك، فاصبح التاءب ميتا، فوزنت السبعون سنة بالسبع ليال، فرجحت الليالي، ووزن الرغيف بالسبع الليالي ، فرجح الرغيف، فقال ابو موسي : يا بني؛ اذكروا صاحب الرغيف)().
 وقال اهل السير: توفي ابو موسي سنة اثنتين وخمسين، وقيل : اثتتين واربعين، ودفن بمكة، وقيل : بالثوية علي ميلين من الكوفة [انتين "الصفوة / .
 وروي الحافظ ابو نعيم : عن ابي موسي الاشعري قال : قال رسول الله صلي الله عليه وسلم : "لقدمر بالصخرة من الروحاء سبعون نبيا حفاة عليهم العبا" وروي ابو موسي قال : خرجنا غازين في البحر، فسمعنا صوتا يقول : ان الله عز وجل قضي علي نفسه انه من عطش نفسه لله في يوم حار. كان حقا علي الله ان يرويه يوم القيامة، فكان ابو موسي يتوخي ذلك اليوم الحار الشديد الحر، فيصومه .
 وخطب يوما بالبصرة ، فقال : (ايها الناس؛ ابكوا ، فان لم تبكوا. . فتباكوا، فان اهل النار يبكون الدموع حتي تنقطع، ثم يبكون الدماء، حتي لو ارسلت فيها السفن.: لجرت) وقال : ( ان الشمس فوق الناس يوم القيامة، واعمالهم تظلهم وتصحبهم) وقال : (ايها الناس؛ انكم اليوم في زمان للعامل فيه لله عز وجل اجر، وسيكون بعدكم زمان يكون للعامل فيه اجران) انتهن ( العلية /) .
 والله سبحانه وتعالي اعلم () احرجه ابن ابي شيبة () . 


