 وقال محمد بن عبد الحكم : ما رايت مثل الشافعي ، ولا هو رايي مثله وقال محمد بن عبد الحكم : ليس فلان عندنا بفقيه؛ لانه يجمع اقوال الناس، ويختار بعضها، قيل : من الفقيه؟ قال : الذي يستنبط اصلا من كتاب او سنة لم يسبق اليه، ثم يشعب من الاصل مثة شعب، قيل له : فمن يقوي علي ذلك ؟قال: محمد بن ادريس.
 وقال علي الرازي : حج بشر المريسي ، فلما قدم. . قيل له : من لقيت بمكة ؟ قال : رايت رجلا ان كان منكم. . لن تغلبوا، وان كان عليكم.. فتاهبوا وخذوا حذركم، وهو محمد بن ادريس الشافعي وقال بشر المريسي: مع الشافعي رحمه الله نصف عقل اهل الدنيا.
 وقال : ما رايت اعقل من الشافعي ولا امهر منه.
 وقال : رايت بمكة فتي، لثن بقي. . ليكونن رجل الدنيا : وقال المزني : لو كنا نفهم عن الشافعي كل ما قاله.. لاتيناكم بصنوف العلم، اي علم كان يذهب علي الشافعي ؟ا ولكن لم نكن نفهم، فقصرنا وعاجله الموت.
 وقال الربيع : لو رايتم الشافعي. . لقلتم : ما هلذه كتبه، كان  والله  لسانه اكبر من كتبه وقال حرملة : كان ابي قد رتب معي كاتبا، وقال للكاتب : اكتب كل ما تكلم به الشافعي وقال داوود بن علي الظاهري : كان الشافعي سراجا لحملة الاثار ونقلة الاخبار، من تعلق بشء من بيانه.. صار محجاجا، ومن فضاءل الشافعي رحمه الله : حفظه لكتاب الله عز وجل، وجمعه للسنن، واثار الصحابة رضوان الله تعالي عليهم اجمعين، ومعرفته باقسام الخطاب، وتقديمه ذلك علي الراي، وكشفه عن تمويه المخالفين، وما ابطله من زيوفهم، وقذف به علي باطلهم فدمغه، ثم ما بين من الحق الذي سهل له بتوفيق الله سبحانه وتعالي معرفته حتي استطال ، ثم ما من الله تعالي به عليه من منطقه الذي لا يداني فيه، وما وقاه من شح نفسه ، قال تعالي : { ومن يرق شح نفسيه فاولكيك هم التفلحوب)، وسماحته، وجوده، وجميل سيرته، وورعه، ونسبه... ثم ساق الكلام الي ان قال : وما علمت احدا كان في عصره امن علي الاسلام منه؛ لما تشر من الحق، ودفع من الباطل، واظهر من الحجج، وعلم من الخير رحمة الله تعالي عليه ورضوانه، وشكر له


 ============================================================
 يع ذلك، وجمع بينتا وبينه في جنته مع جميع الاحبة، انه لطيف خبير وقال ابراهيم الحربي : قدم الشافعي بغداد وفي الجامع الغربي عشرون حلقة لاصحاب الراي، فلما كانت الجمعة.. لم يثبت منها الا ثلاث حلق او اربع وقال هلال بن العلاء : اصحاب الحديث عيال علي الشافعي؛ فتح لهم الاقفال واقوال السلف في مدحه غير منحصرة فتا فيمن روي عنهم الشافعي من علماء الحجاز واليمن ومصر والعراق وهم جع غفير: الاول : الامام ابو عبد الله مالك بن انس امام المدينة، ومالك بن انس عن ربيعة عن انس، ونافع عن ابن عمر رضي الله عنهم ، كلاهما عن النبي صلي الله عليه وسلم والثاني : سفيان بن عيينة عن عمرو بن دينار عن ابن عمر وابن عباس رضي الله عنهم والثالث: ابو خالد مسلم بن خالد الزنجي مفتي مكة وامام العلماء، ومسلم عن ابي الوليد عبد الملك بن عبد العزيز بن جريج، وابن جريج عن عطاء ابن ابي رباح، وعطاء عن عبد الله بن العباس: وقد جمعهم البيهفي في كتاب " المناقب * واما الذين سمعوا منه وتفقهوا عليه. . فمنهم خلاءق لا يحصون من اعلام الاءمة وغيرهم؛ كاحمد ابن حبل، وابي ثور، والحميدي، والبويطي، والمزني، وغيرهم: ولما حضرت الشافعي الوفاة .. اوصي ان يكون القاعد في حلقته والخليفة بعده البويطي و هو ابو يعقوب يوسف بن يحي فش كان الشافعي رحمه الله يخضب لحيته بالحناء حمراء قانءة، وتارة بصفرة ؛ اتباعا للسنة، وكان طويلا، ساءل الخدين، قليل لحم الوجه، خفيف شعر العارضين، طويل العنق، طويل القصب، ادم، حن الصوت، حسن السمت، عظيم العقل، حسن الوجه، حسن الخلق، مهيبا، فصيحا، اذا اخرج لسانه. . بلغ انفه، وكان كثير الاسقام .



 ============================================================
 وقولهم: (طويل القصب) : قال الاصمعي: هو عظم العضد والفخذ والساق، وكل عظم فيه قصبة، وقولهم : (ساءل الخدين) اي: رقيقهما، مستطيلهما، والقانءة بالهمز : هي شدة الحمرة.
 وقال يونس بن عبد الاعلي : ما رايت احدا لقي من السقم ما لقي الشافعي رحمه الله، وسبب هلذا  والله اعلم  : لطف الله تعالي به ومعامليه بمعاملة الاولياء! لقوله صلي الله عليه وسلم : ل" نحن معاشر الانبياء اشد بلاء ثم الامثل فالامثل "() .
 وقال الربيع : كان الشافعي رحمه الله حسن الوجه، حسن الخلق، مهيبا، محببا لكل من كان بمصر في وقته من الفقهاء والنبلاء والامراء ، كلهم يجل الشافعي ويعظمه، وكان مقتصدا في لباسه، ويتختم في يساره، نقش خاتم : كفي بالله ثقة لمحمد بن ادريس وكان مجلسه مصونا، واذا خيض في مجلسه في الكلام.. نهل عنه.
 وكان ذا معرفة تامة بالطب والرمي، حتي كان يصيب عشرة من عشرة وقال الربيع : كان الشافعي اشجع الناس، وافرسهم، وكان ياخذ باذنه واذن الفرس والفرس تعدو، وكان ذا معرفة بالفراسة، وكان مع حسن خلقه مهيبا.
 وقال الربيع  وهو صاحبه  : والله؛ ما اجترات ان اشرب الماء والشافعي ينظر الي ؛ هيبةله وقال : سمعت الشافعي رحمه الله يقول : رايت النبي صلي الله عليه وسلم في المنام قبل خلمي، فقال لي : "يا غلام " فقلت : لبيك يارسول الله، فقال : " ممن انت ؟ " فقلت : من رهطك، قال : "ادن مني"، فدنوت منه، ففتح فمي، فامر من ريقه المبارك صلي الله عليه وسلم علي لساني وفمي وشفتي، وقال : " امض بارك الله تعالي فيك" ، فما اذكر اني لحنت في حديث بعد ذلك ولا شعر وعن ابي الحسن علي بن احمد الدينوري الزاهد قال : رايت النبي صلي الله عليه وسلم في المنام ، فقلت : يا رسول الله ؛ بقول من اخذ؟ فاشار الي علي بن ابي طالب ، قال : "خذ بيد هذا فات به ابن عمنا الشافعي؛ ليعمل بمذهبه فيرشد ويبلغ الجنة * وكان يقول بعد ذلك : الشافعي بين العلماء كالبدر بين الكواكب .
 () اخرجه بنحوه الحاكم (/)، وابن حبان ().



