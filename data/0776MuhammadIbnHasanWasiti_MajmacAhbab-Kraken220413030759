 وقال سفيان : ما يريد مني ابو جعفر؟ فوالله، لثن قمت عنده. لاقولن له : قم من مقامك، فغيرك اولي به منك.
 وقال ابن المبارك : قيل لسفيان : لو دخلت عليهم ؟ فقال : اني اخشي ان يسالني الله عز وجل عن مقامي : ما قلت فيه ؟ فقيل له : تقول وتتحفظ، قال : افتامرونني ان اسبح في البحر ولا تبتل ثيابي، والله؛ ليس اخاف ضربهم، وانما اخاف ان يميلوا علي بدنياهم، ثم لا اري سيءتهم سيءة، او قال : سيءهم سيءا.
 وقال سفيان : ادخلت علي ابي جعفر المنصور، فقلت له : اتق الله؛ فانما انزلت هذذه المنزلة وصرت في هذذا الموضع بسيوف المهاجرين والانصار، وابناءهم يموتون جوعا، ج عمر بن الخطاب رضي الله عنه، فما انفق الا خمسة عشر دينارا، وكان ينزل تحت الشجر ، فقال لي : اتريد ان اكون مثلك؟ قلت : لا تكن مثلي، ولككن كن دون ما انت فيه ، وفوق ما انا فيه، فقال لي : اخرج: وعن محمد بن عاصم بن يزيد قال : سمعت ابي يقول : كتب سفيان معي كتابا الي المهدي والن وزيره ابي عبيد الله يعقوب بن داوود، فلما دخلت عليه. . جري الكلام بيني وبينه، فقال المهدي : لو جاءتا ابو عبد الله.. لوضعنا ايدينا في يله، وارتدينا برداء، واتزرنا باخر، وخرجنا الي السوق، فامرنا بالمعروف ، ونهينا عن المنكر، فاذا تواري عنا مثل ابي عبد الله .. كيف اصنع ؟ لقد جاءني قراءكم الذين مم قراءكم ، فامروني ونهوني، ووعظوني، وبكوا  والله  لي، وتباكيت لهم ، ثم لم يفجاني من احدهم ان اخرج من ككمه رقعة، افعل لي كذا، وافعل لي كذا، ففعلت ذلك لهم، ومقءهم عليه، وانما كتب سفيان اليه ان يعطيه الامان ، لانه طال مهربه، فكتب اليه بالامان ، فمات قبل وصول الامان.
 وفي رواية اخري عنه قال : قلت : يا ابا عبد الله؛ انك توجهني الي المهدي ، وانا غلام غر لعلي اسقط بشء، فلا يكون مرضيا عندك، فقال لي : قل ما تعلم، ولا تقل ما لا تعلم قال محمد : قال ابي : فلما رجعت الي سفيان.. قلت له : لاي شء تهرب من هذذا الرجل؟ والرجل يقول : لو جاءنا.. لخرجت معه الي السوق، فامزنا ونهينا، فقال : يا ناعس؛ حتي يتقي الله عز وجل، ويدفع الحق الي اربابه، فاذا فعل ذلك. . اجتمعت به .
 وقال يحيي بن سعيد : املي علي سفيان الثوري كتابا كتبه الي المهدي، فقال : اكتب :


 ============================================================
 من سفيان بن صعيد الي محمد بن عبد الله، فقلت : اذا كتبت هذا.. لم يقراه، فقال : اكتب كما تريد، فكتبت، ثم قال : اكتب : باني احمد الله اليك الذي لا اله الا هو تبارك وتعالي: اما بعد : فانك طردتني وشردتني وخوفتني، والله بيني ويينك، وارجو ان يخير الله عز وجل لي قبل مرجوع الكتاب، قال : فرجع الكتاب وقد مات رحمه الله.
 وقال سفيان : ادخلت علي المهدي فقال : ارفع الينا حاجتك، فقلت : قد ملات ظهر الارض ظلما وجورا، فاتق الله، وازل هذه المظالم ، فطاطا راسه ، ثم رفعه، وقال : ارايت ان لم استطع رفعه قال : قلت : تخليه لغيرك، قال : فطاطا راسه، ثم قال : ارفع الينا حاجتك، قال : قلت: ابناء المهاجرين والانصار ومن تبعهم باحسان بالباب، فاتق الله، واوصل اليهم حقوقهم، قال : فطاطا راسه، فقال ابو عبيد الله وزيره : ايها الرجل؛ ارفع الينا حاجتك، فقلت : وما ارفع؟ حدثني اسماعيل بن خالد قال : حج عمر بن الخطاب رضي الله عنه، فقال لخادمه: كم انفقت ؟ قال: بضعة عشر دينارا، واري ههنا امورا لا تطيقها الجبال .
 وقال يوسف بن اسباط : قال سفيان : من دعا لظالم بالبقاء. . فقد احب ان يعصي الله عزوجل: وقال : قال عيسي ابن مريم عليه الصلاة والسلام : تقربوا الي الله سبحانه وتعالي ببغض اهل المعاصي، والتمسوا رضوانه بالتباعد منهم، قالوا : فمن نجالس؟ قال : من يذكركم الله تعالي رءيثه ، ويرغبكم في الاخرة عمله ، ويزيد في فهمكم منطقه: وقال عبد الله بن الفرج  مولي معن بن زاءدة  قال : طلب الثوري ، فصار الي اليمن ، فاخبرت معن بن زاءدة بقدومه، فاينه، وامر له بالف دينار، فابي ان يقبلها، فلما كان اوان الحج.. ترك عندي عباءة له، كان يتمسح فيها للصلاة، فلم القه الا بالموقف ، فقال لي : ما فعلت العباءة ؟ قلت : حاضرة، قال : هاتها، فاعطيته اياها، فلما فضي حجه.. سار الي البصرة، فنزل علي بقالي في جوار يحيي بن سعيد، وعبد الرحمان بن مهدي، قال عبد الله : فقال لي البقال : ما زال ليلة مات يقوم ويتمسح للصلاة حتي عددت له خمسين مرة، ثم مات من اخر الليل رحمه الله ولقي سفيان الثوري شريكا بعدما ولي قضاء الكوفة، فقال : يا ابا عبد الله؛ بعد الفقه 


