 ومنهم الامام : يزيد بن موثد رضي الله هنه قال الحافظ  رحمه الله : قال عبد الرحمان بن يزيد بن جابر : قلت ليزيد بن مرثد : ما لي اري عينيك لا تجف ؟ قال : وما مسالتك عنه ؟ قلت : عسي الله ان ينفعني به، قال : يا اخي؛ ان الله عز وجل قد توعدني ان انا عصيته. . ان يسجني في الثار، والله؛ لو لم يتوعدني الا ان يسجتني في الحمام. لكنت حريا الا تجف لي دمعة عين ، قال : فقلت له : فهكذا انت في خلوتك ؟ قال : وما مسالتك عنه ؟ قلت : عسي الله ان ينفعني به ، فقال : والله؛ ان ذلك ليعرض لي حين اسكن الي اهلي، فيحول بيني وبين ما اريد، وانه ليوضع الطعام بين يدي، فيعرض لي، فيحول بيني وبين اكله.. حتي تبكي امراتي، ويبكي صبياتنا، مايدرون ما ابكانا، ولربما اضجر ذلك امراتي، فتقول يا ويحها: ما خصصت به من طول الحزن معك في الحياة الدنيا ؟ ما تقر لي عين معك وعن يزيد بن مرثد : ان ابا الدرداء قال لمعاوية : والذي نفسي بيده ؛ لا تنقصون من ارزاق الناس شيءا. . الا نقص من الارض مثله .
 واراد الوليد بن عبد الملك ان يولي يزيد بن مرءد القضاء ، فلبس يزيد فروا قد قلبه، فجعل الجلد علي ظهره والصوف خارجا، واخذ بيده رغيفا وعرقل()، وخرج بلا رداء، ولا قلنسوة، ولا نعل، ولا خف، وجعل يمشي في الاسواق، وياكل الخبز واللحم، فقيل للوليد : ان يزيد بن مرءد قد اختلط، واخبر بما فعل، فتركه .
 اسند عن معاذ بن جبل، وابي الدرداء، وغيرها، رضي الله عنهم اجمعين فمما رواه عن ابي ذر : عن النبي صلي الله عليه وسلم قال : " ان داوود عليه الصلاة () العرق بسكون الراء  : العظم اذا اخذ عنه معظم اللحم.



