 ) وقالوا ما هي الا حياتنا الدنيا نموت ونحيا وما يهلكنا الا الدهر وما لهم بذلك من علم ان هم الا يظنون (
 الجاثية : (  ) وقالوا ما هي . . . . .
 ) نموت ونحيا ( نموت نحن ويحيا واولادنا . او يموت بعض ويحيا بعض . او نكون مواتا نطفا في الاصلاب ، ونحيا بعد ذلك . او يصيبنا الامران : الموت والحياة ، يريدون : الحياة في الدنيا والموت بعدها ، وليس وراء ذلك حياة . وقرء : ( نحيا ) بضم النون . وقرء ( الا دهر يمر ) ما يقولون ذلك عن علم ، ولكن عن ظن وتخمين : كانوا يزعمون ان مرور الايام والليالي هو المءثر في هلاك الانفس ، وينكرون ملك الموت وقبضه الارواح بامر الله ، وكانوا يضيفون كل حادثة تحدث الي الدهر والزمان ، وتري اشعارهم ناطقة بشكوي الزمان . ومنه قوله عليه السلام :
 (  ) ( لا تسبوا الدهر ، فان الله هو الدهر ) اي : فان الله هو الاتي بالحوادث لا الدهر .
 ) واذا تتلي عليهم ءاياتنا بينات ما كان حجتهم الا ان قالوا اءتوا بااباءنا ان كنتم صادقين قل الله يحييكم ثم يميتكم ثم يجمعكم الي يوم القيامة لا ريب فيه ولاكن اكثر الناس لا يعلمون (
 الجاثية : (  ) واذا تتلي عليهم . . . . .
 وقرء ( حجتهم ) بالنصب والرفع ، علي تقديم خبر كان وتاخيره . فان قلت : لم  " صفحة رقم  "
 سمي قولهم حجة وليس بحجة ؟ قلت : لانهم ادلوا به كما يدلي المحتج بحجته وساقوه مساقها ، فسميت حجة علي سبيل التهكم . او لانه في حسبانهم وتقديرهم حجة . او لانه في اسلوب قوله : تحية بينهم ضرب وجيع ;
 كانه قيل : ما كان حجتهم الا ما ليس بحجة . والمراد : نفي ان تكون لهم حجة البتة . فان قلت : كيف وقع قوله : ) قل الله يحييكم ( جوابا لقولهم : ) اءتوا بااباءنا ان كنتم صادقين ( ؟ قلت : لما انكروا البعث وكذبوا الرسل ، وحسبوا ان ما قالوه قول مبكت . الزموا ما هم مقرون به : من ان الله عز وجل هو الذي يحييهم ثم يميتهم ، وضم الي الزام ذلك الزام ما هو واجب الاقرار به ان انصفوا واصغوا الي داعي الحق ، وهو جمعهم الي يوم القيامة ، ومن كان قادرا علي ذلك كان قادرا علي الايتان باباءهم ، وكان اهون شء عليهم .
 ) ولله ملك السماوات والا رض ويوم تقوم الساعة يومءذ يخسر المبطلون وتري كل امة جاثية كل امة تدعي الي كتابها اليوم تجزون ما كنتم تعملون هاذا كتابنا ينطق عليكم بالحق ان كنا نستنسخ ما كنتم تعملون فاما الذين ءامنوا وعملوا الصالحات فيدخلهم ربهم في رحمته ذلك هو الفوز المبين واما الذين كفروا افلم تكن ءاياتي تتلي عليكم فاستكبرتم وكنتم قوما مجرمين (
 الجاثية : (    ) ولله ملك السماوات . . . . .
 عامل النصب في ) يوم تقوم ( يخسر ، و) يومءذ ( بدل من ( يوم تقول ) ) جاثية ( باركة مستوفزة علي الركب . وقرء ( جاذية ) والجذو : اشد استيفازا من الجثو : لان الجاذي هو الذي يجلس علي اطراف اصابعه : وعن ابن عباس رضي الله عنهما : جاثية مجتمعة . وعن قتادة جماعات من الجثوة ، وهي الجماعة ، وجمعها : جثي . وفي الحديث :
 (  ) ( من جثي جهنم ) وقرء : ) كل امة ( علي الابتداء : وكل امة : علي  " صفحة رقم  "
 الابدال من كل امة ) الي كتابها ( الي صحاءف اعمالها ، فاكتفي باسم الجنس ، كقوله تعالي : ) ووضع الكتاب فتري المجرمين مشفقين مما فيه ( ( الكهف :  ) . ) اليوم تجزون ( محمول علي القول . فان قلت : كيف اضيف الكتاب اليهم والي الله عز وجل ؟ قلت : الاضافة تكون للملابسة ، وقد لابسهم ولابسه ، اما ملابسته اياهم ، فلان اعمالهم مثبتة فيه . واما ملابسته اياه ؛ فلانه مالكه ، والامر ملاءكته ان يكتبوا فيه اعمال عباده ) ينطق عليكم ( يشهد عليكم بما عملتم ) بالحق ( من غير زيادة ولا نقصان ) انا كنا نستنسخ ( الملاءكة ) ما كنتم تعملون ( اي نستكتبهم اعمالكم ) في رحمته ( في جنته . وجواب اما محذوف تقديره : واما الذين كفروا فيقال لهم ) واما الذين كفروا افلم تكن ( والمعني الم ياتكم رسلي فلم تكن اياتي تتلي عليكم ، فحذف المعطوف عليه .
 ) واذا قيل ان وعد الله حق والساعة لا ريب فيها قلتم ما ندري ما الساعة ان نظن الا ظنا وما نحن بمستيقنين وبدا لهم سيءات ما عملوا وحاق بهم ما كانوا به يستهزءون (
 الجاثية : (  ) واذا قيل ان . . . . .
 وقرء : ( والساعة ) بالنصب عطفا علي الوعد ، وبالرفع عطفا علي محل ان واسمها ) ما الساعة ( اي شء الساعة ؟ فان قلت : ما معني ( ان نظن الا ظنا ) ؟ قلت : اصله نظن ظنا . ومعناه : اثبات الظن فحسب ، فادخل حرفا النفي والاستثناء ، ليفاد اثبات الظن مع نفي ما سواه وزيد نفي ما سوي الظن توكيدا بقوله : ) وما نحن بمستيقنين سيءات ما عملوا ( اي قباءح اعمالهم . او عقوبات اعمالهم السيءات ، كقوله تعالي : ) وجزاء سيءة سيءة مثلها ( ( الشوري :  ) .
 ) وقيل اليوم ننساكم كما نسيتم لقاء يومكم هاذا وماواكم النار وما لكم من ناصرين ذلكم بانكم اتخذتم ءايات الله هزوا وغرتكم الحيواة الدنيا فاليوم لا يخرجون منها ولا هم يستعتبون (
 الجاثية : (  ) وقيل اليوم ننساكم . . . . .
 ) ننساكم ( نترككم في العذاب كما تركتم عدة ) لقاء يومكم هاذا ( وهي الطاعة ، او نجعلكم بمنزلة الشء المنسي غير المبالي به ، كما لم تبالوا انتم بلقاء يومكم ولم تخطروه ببال ، كالشء الذي يطرح نسيا منسيا . فان قلت : فما معني اضافة اللقاء الي اليوم ؟ قلت : كمعني اضافة المكر في قوله تعالي : ) بل مكر اليل والنهار ( ( سبا :  ) اي نسيتم لقاء اليوم في يومكم هذا ولقاء جزاءه . وقرء ( لا يخرجون ) بفتح الياء ) ولا هم يستعتبون ( ولا يطلب منهم ان يعتبوا ربهم اي يرضوه .
 ) فلله الحمد رب السماوات ورب الا رض رب العالمين وله الكبرياء في السماوات والا رض وهو العزيز الحكيم (  )
 الجاثية : (    ) فلله الحمد رب . . . . .

 " صفحة رقم  "
 ) فلله الحمد ( فاحمدوا الله الذي هو ربكم ورب كل شء من السماوات والارض والعالمين ، فان مثل هذه الربوبية العامة يوجب الحمد والثناء علي كل مربوب . وكبروه فقد ظهرت اثار كبرياءه وعظمته ) في السماوات والارض ( وحق مثله ان يكبر ويعظم .
 عن رسول الله ( صلي الله عليه وسلم ) :
 (  ) ( من قرا حم الجاثية ستر الله عورته وسكن روعته يوم الحساب ) .

  AUTO " صفحة رقم  "
 ( سورة الاحقاف )
 مكية ( الا الايات  و و فمدنية )
 واياتها  وقيل  اية ( نزلت بعد الجاثية )
 بسم الله الرحمن الرحيم
 ) حم تنزيل الكتاب من الله العزيز الحكيم ما خلقنا السماوات والا رض وما بينهما الا بالحق واجل مسمي والذين كفروا عما انذروا معرضون (
 الاحقاف : (    ) حم
 ) الا بالحق ( الا خلقا ملتبسا بالحكمة والغرض الصحيح ( و) بتقدير ) اجل مسمي ( ينتهي اليه وهو يوم القيامة ) والذين كفروا عما انذروا ( من هول ذلك اليوم الذي لا بد لكل خلق من انتهاءه اليه ) معرضون ( لا يءمنون به ولا يهتمون بالاستعداد له . ويجوز ان تكون ما مصدرية ، اي : عن انذارهم ذلك اليوم .
 ) قل ارايتم ما تدعون من دون الله اروني ماذا خلقوا من الا رض ام لهم شرك في السماوات اءتوني بكتاب من قبل هاذا او اثارة من علم ان كنتم صادقين (
 الاحقاف : (  ) قل ارايتم ما . . . . .
 ) بكتاب من قبل هاذا ( اي من قبل هذا الكتاب وهو القران ، يعني : ان هذا الكتاب ناطق بالتوحيد وابطال الشرك . وما من كتاب انزل من قبله من كتب الله الا وهو ناطق بمثل ذلك ، فاتوا بكتاب واحد منزل من قبله شاهد بصحة ما انتم عليه من عبادة غير الله ) او اثارة من علم ( او بقية من علم بقيت عليكم من علوم الاولين ، من قولهم : سمنت الناقة علي اثارة من شحم ، اي : علي بقية شحم كانت بها من شحم ذاهب . وقرء ( اثرة ) اي : من شء اوثرتم به وخصصتم من علم لا احاطة به لغيركم . وقرء ( اثرة ) الحركات الثلاث في الهمزة مع سكون الثاء ، فالاثرة بالكسر بمعني الاثرة . واما الاثرة فالمرة من مصدر : اثر الحديث اذا رواه . واما الاثرة بالضم فاسم ما يءثر ، كالخطبة : اسم ما يخطب به .

 " صفحة رقم  "
 ) ومن اضل ممن يدعو من دون الله من لا يستجيب له الي يوم القيامة وهم عن دعاءهم غافلون (
 الاحقاف : (  ) ومن اضل ممن . . . . .
 ) ومن اضل ( معني الاستفهام فيه انكار ان يكون في الضلال كلهم ابلغ ضلالا من عبدة الاصنام ، حيث يتركون دعاء السميع المجيب القادر عل تحصيل كل بغية ومرام ، ويدعون من دونه جمادا لا يستجيب لهم ولا قدرة به علي استجابة احد منهم ما دامت الدنيا والي ان تقوم القيامة ، واذا قامت القيامة وحشر الناس : كانوا لهم اعداء ، وكانوا عليهم ضدا ، فليسوا في الدارين الا علي نكد ومضرة ، لا تتولاهم في الدنيا بالاستجابة ؛ وفي الاخرة تعاديهم وتجحد عبادتهم . وانما قيل : ) من ( و( هم ) لانه اسند اليهم ما يسند الي اولي العلم من الاستجابة والغفلة ، ولانهم كانوا يصفونهم بالتمييز جهلا وغباوة . ويجوز ان يريد : كل معبود من دون الله من الجن والانس والاوثان ، فغلب غير الاوثان عليها . قري : ( ما لا يستجيب ) وقرء : ( يدعو غير الله من لا يستجيب ) ووصفهم بترك الاستجابة والغفلة طريقه طريق التهكم بها وبعبدتها . ونحوه قوله تعالي : ) ان تدعوهم لا يسمعوا دعاءكم ولو سمعوا ما استجابوا لكم ويوم القيامة يكفرون بشرككم ( ( فاطر :  ) .
 ) واذا حشر الناس كانوا لهم اعداء وكانوا بعبادتهم كافرين واذا تتلي عليهم ءاياتنا بينات قال الذين كفروا للحق لما جاءهم هاذا سحر مبين (
 الاحقاف : (    ) واذا حشر الناس . . . . .
 ) بينات ( جمع بينة : وهي الحجة والشاهد . او واضحات مبينات . واللام في  " صفحة رقم  "
 ) للحق ( مثلها في قوله : ) وقال الذين كفروا للذين ءامنوا لو كان خيرا ( ( الاحقاف :  ) اي لاجل الحق ولاجل الذين امنوا . والمراد بالحق : الايات ، وبالذين كفروا : المتلو عليهم ، فوضع الظاهران موضع الضميرين ؛ للتسجيل عليهم بالكفر ، وللمتلو بالحق ) لما جاءهم ( اي : بادهوه بالجحود ساعة اتاهم ، واول ما سمعوه من غير اجالة فكر ولا اعادة نظر . ومن عنادهم وظلمهم : انهم سموه سحرا مبينا ظاهرا امره في البطلان لا شبهة فيه .
 ) ام يقولون افتراه قل ان افتريته فلا تملكون لي من الله شيءا هو اعلم بما تفيضون فيه كفي به شهيدا بيني وبينكم وهو الغفور الرحيم (
 الاحقاف : (  ) ام يقولون افتراه . . . . .
 ) ام يقولون افتراه ( اضراب عن ذكر تسميتهم الايات سحرا الي ذكر قولهم : ان محمدا افتراه . ومعني الهمزة ام : الانكار والتعجيب ، كانه قيل : دع هذا واسمع قولهم المستنكر المفضي منه العجب ، وذلك ان محمدا كان لا يقدر عليه حتي يقوله ويفتريه علي الله ، ولو قدر عليه دون امة العرب لكانت قدرته عليه معجزة لخرقها العادة ، واذا كانت معجزة كانت تصديقا من الله له ، والحكيم لا يصدق الكاذب فلا يكون مفتريا . والضمير للحق ؛ والمراد به الايات ) قل ان افتريته ( علي سبيل الفرض عاجلني الله تعالي لا محالة بعقوبة الافتراء عليه . فلا تقدرون علي كفه عن معاجلتي ولا تطيقون دفع شء من عقابه عني ، فكيف افتريه واتعرض لعقابه . يقال : فلان لا يملك اذا غضب ، ولا يملك عنانه اذا صمم ، ومثله : ) فمن يملك من الله شيءا ان اراد ان يهلك المسيح ابن مريم ( ( الماءدة :  ) ، ) ومن يرد الله فتنته فلن تملك له من الله شيءا ( ( الماءدة :  ) ومنه قوله عليه السلام :
 (  ) ( لا املك لكم من الله شيءا ) ، ثم قال : ) هو اعلم بما تفيضون فيه ( اي تندفعون فيه من القدح في وحي الله تعالي ، والطعن في اياته ، وتسميته سحرا تارة وفرية اخري ) كفي به شهيدا بيني وبينكم ( يشهد لي بالصدق والبلاغ ، ويشهد عليكم بالكذب والجحود . ومعني ذكر العلم والشهادة وعيد بجزاء افاضتهم ) وهو الغفور الرحيم ( موعدة بالغفران والرحمة ان رجعوا عن الكفر وتابوا وامنوا ، واشعار بحلم الله عنهم مع عظم ما  " صفحة رقم  "
 ارتكبوا . فان قلت : فما معني اسناد الفعل اليهم في قوله تعالي : فلا تملكون لي ؟ قلت : كان فيما اتاهم به النصيحة لهم والاشفاق عليهم من سوء العاقبة وارادة الخير بهم ، فكانه قال لهم : ان افتريته وانا اريد بذلك التنصح لكم وصدكم عن عبادة الالهة الي عبادة الله ، فما تغنون عني ايها المنصوحون ان اخذني الله بعقوبة الافتراء عليه .
 ) قل ما كنت بدعا من الرسل وما ادري ما يفعل بي ولا بكم ان اتبع الا ما يوحي الي وما انا الا نذير مبين (
 الاحقاف : (  ) قل ما كنت . . . . .
 البدع ، بمعني : البديع ، كالخف بمعني الخفيف . وقرء ( بدعا ) بفتح الدال ، اي : ذا بدع ويجوز ان يكون صفة علي فعل ، كقولهم : دين قيم ، ولحم زيم : كانوا يقترحون عليه الايات ويسالونه عما لم يوح به اليه من الغيوب . فقيل له : ) قل ما كنت بدعا من الرسل ( فاتيكم بكل ما تقترحونه ، واخبركم بكل ما تسالون عنه من المغيبات ؛ فان الرسل لم يكونوا ياتون الا بما اتاهم من اياته ، ولا يخبرون الا بما اوحي اليهم . ولقد اجاب موسي صلوات الله عليه عن قول فرعون : ( فما بال القرون الاولي ) ؟ بقوله : ( علمها عند ربي ) ) وما ادري ( لانه لا علم لي بالغيب ما يفعل الله بي وبكم فيما يستقبل من الزمان من افعاله ، ويقدر لي ولكم من قضاياه ) ان اتبع الا ما يوحي الي ( وعن الحسن : وما ادري ما يصير اليه امري وامركم في الدنيا ، ومن الغالب منا والمغلوب . وعن الكلبي : قال له اصحابه وقد ضجروا من اذي المشركين : حتي متي نكون علي هذا ؟ فقال : ( ما ادري ما يفعل بي ولا بكم ) ااترك بمكة ام اومر بالخروج  " صفحة رقم  "
 الي ارض قد رفعت لي ورايتها يعني في منامه ذات نخيل وشجر ؟ وعن ابن عباس : ما يفعل بي ولا بكم في الاخرة ، وقال : هي منسوخة بقوله : ) ليغفر لك الله ما تقدم من ذنبك وما تاخر ( ( الفتح :  ) ويجوز ان يكون نفيا للدراية المفصلة . وقرء ( ما يفعل ) بفتح الياء ، اي : يفعل الله عز وجل . فان قلت : ان ( يفعل ) مثبت غير منفي ، فكان وجه الكلام : ما يفعل بي وبكم . قلت : اجل ، ولكن النفي في ) ما ادري ( لما كان مشتملا عليه لتناوله ) ما ( وما في حيزه : صح ذلك وحسن . الا تري الي قوله : ) اولم يروا ان الله الذي خلق السماوات والارض ولم يعي بخلقهن بقادر ( ( الاحقاف :  ) كيف دخلت الياء في حيز ان وذلك لتناول النفي اياها مع ما في حيزها . و( ما ) في ( ما يفعل ) يجوز ان تكون موصولة منصوبة ، وان تكون استفهامية مرفوعة . وقرء : ( يوحي ) اي الله عز وجل .
 ) قل ارءيتم ان كان من عند الله وكفرتم به وشهد شاهد من بني اسراءيل علي مثله فاامن واستكبرتم ان الله لا يهدي القوم الظالمين (
 الاحقاف : (  ) قل ارايتم ان . . . . .
 جواب الشرط محذوف تقديره : ان كان القران من عند الله وكفرتم به الستم ظالمين . ويدل علي هذا المحذوف قوله تعالي : ) ان الله لا يهدي القوم الظالمين ( والشاهد من بني اسراءيل : عبد الله بن سلام ، لما قدم رسول الله ( صلي الله عليه وسلم ) المدينة نظر الي وجهه ، فعلم انه ليس بوجه كذاب . وتامله فتحقق انه هو النبي المنتظر وقال له :
 (  ) اني ساءلك عن ثلاث لا يعلمهن الا نبي : ما اول اشراط الساعة ؟ وما اول طعام ياكله اهل الجنة ؟ وما بال الولد ينزع الي ابيه او الي امه ؟ فقال عليه الصلاة  " صفحة رقم  "
 والسلام : ( اما اول اشراط الساعة فنار تحشرهم من المشرق الي المغرب . واما اول طعام ياكله اهل الجنة فزيادة كبد حوت ، واما الولد فاذا سبق ماء الرجل نزعه ، وان سبق ماء المراة نزعته ) . فقال : اشهد انك رسول الله حقا ، ثم قال : يا رسول الله ، ان اليهود قوم بهت وان علموا ان تسالهم عني بهتوني عندك . فجاءت اليهود فقال لهم النبي ( صلي الله عليه وسلم ) : اي رجل عبد الله فيكم ؟ فقالوا : خيرنا وابن خيرنا ، وسيدنا وابن سيدنا ، واعلمنا وابن اعلمنا . قال : ارايتم ان اسلم عبد الله ؟ قالوا : اعاذه الله من ذلك ، فخرج اليهم عبد الله فقال : اشهد ان لا الاه الا الله واشهد ان محمدا رسول الله ، فقالوا : شرنا وابن شرنا انتقصوه . قال : هذا ما كنت اخاف عليه يا رسول الله واحذر . قال سعد بن ابي وقاص :
 (  ) ما سمعت رسول الله ( صلي الله عليه وسلم ) يقول لاحد يمشي علي وجه الارض انه من اهل الجنة الا لعبد الله بن سلام ، وفيه نزل : ) وشهد شاهد من بني اسراءيل علي مثله ( الضمير للقران ، اي : علي مثله في المعني ، وهو ما في التوراة من المعاني المطابقة لمعاني القران من التوحيد والوعد والوعيد وغير ذلك . ويدل عليه قوله تعالي : ) وانه لفي زبر الاولين ( ( الشعراء :  ) ، ) ان هاذا لفي الصحف الاولي ( ( الاعلي :  ) ، ) كذلك يوحي اليك والي الذين من قبلك ( ( الشوري :  ) ويجوز ان يكون المعني : ان كان من عند الله وكفرتم به وشهد شاهد علي نحو ذلك ، يعني كونه من عند الله . فان قلت : اخبرني عن نظم هذا الكلام لاقف علي معناه من جهة النظم . قلت : الواو الاولي عاطفة لكفرتم علي فعل الشرط ، كما عطفته ( ثم ) في قوله تعالي : ) قل ارءيتم ان  " صفحة رقم  "
 كان من عند الله ثم كفرتم به ( ( فصلت :  ) وكذلك الواو الاخرة عاطفة لاستكبرتم علي شهد شاهد ، واما الواو في ( وشهد شاهد ) فقد عطفت جملة قوله . شهد شاهد من بني اسراءيل علي مثله فامن واستكبرتم : علي جملة قوله : ( كان من عند الله وكفرتم به ) ونظيره قولك : ان احسنت اليك واسات ، واقبلت عليك واعرضت عني ، لم نتفق في انك اخذت ضميمتين فعطفتهما علي مثليهما ، والمعني : قل اخبروني ان اجتمع كون القران من عند الله مع كفركم به ، واجتمع شهادة اعلم بني اسراءيل علي نزول مثله وايمانه به ، مع استكباركم عنه وعن الايمان به ، الستم اضل الناس واظلمهم ؟ وقد جعل الايمان في قوله : ) فاامن ( مسببا عن الشهادة علي مثله : لانه لما علم ان مثله انزل علي موسي صلوات الله عليه ، وانه من جنس الوحي وليس من كلام البشر ، وانصف من نفسه فشهد عليه واعترف كان الايمان نتيجة ذلك .
 ) وقال الذين كفروا للذين ءامنوا لو كان خيرا ما سبقونا اليه واذ لم يهتدوا به فسيقولون هاذا افك قديم ومن قبله كتاب موسي اماما ورحمة وهاذا كتاب مصدق لسانا عربيا لينذر الذين ظلموا وبشري للمحسنين ان الذين قالوا ربنا الله ثم استقاموا فلا خوف عليهم ولا هم يحزنون اولاءك اصحاب الجنة خالدين فيها جزاء بما كانوا يعملون (
 الاحقاف : (  ) وقال الذين كفروا . . . . .
 ) للذين ءامنوا ( لاجلهم وهو كلام كفار مكة ، قالوا : عامة من يتبع محمدا السقاط ، يعنون الفقراء مثل عمار وصهيب وابن مسعود ، فلو كان ما جاء به خيرا ما سبقنا اليه هءلاء . وقيل : لما اسلمت جهينة ومزينة واسلم وغفار : قالت بنو عامر وغطفان واسد واشجع : لو كان خيرا ما سبقنا اليه رعاء البهم . وقيل : ان امة لعمر اسلمت ، فكان عمر يضربها حتي يفتر ثم يقول لولا اني فترت لزدتك ضربا ، وكان كفار قريش يقولون : لو كان ما يدعو اليه محد حقا ما سبقتنا اليه فلانة . وقيل : كان اليهود يقولونه عند اسلام عبد الله بن سلام واصحابه . فان قلت : لا بد من عامل في الظرف في قوله : ) واذ لم  " صفحة رقم  "
 يهتدوا به ( ومن متعلق لقوله : ) فسيقولون ( وغير مستقيم ان يكون ) فسيقولون ( هو العامل في الظرف ، لتدافع دلالتي المضي والاستقبال ، فما وجه هذا الكلام ؟ قلت : العامل في اذ محذوف ، لدلالة الكلام عليه ، كما حذف في قوله : ( فلما ذهبوا به ) وقولهم : حينءذ الان ، وتقديره : واذ لم يهتدوا به ظهر عنادهم ، فسيقولون هذا افك قديم ، فهذا المضمر صح به الكلام ، حيث انتصب به الظرف وكان قوله : ) فسيقولون ( مسببا عنه كما صح باضمار ان قوله : ) حتي يقول الرسول ( ( البقرة :  ) لمصادفة ( حتي ) مجرورها ، والمضارع ناصبه . وقولهم : ) افك قديم ( كقولهم : اساطير الاولين ) كتاب موسي ( مبتدا ومن قبله ظرف واقع خبرا مقدما عليه ، وهو ناصب ) اماما ( علي الحال ، كقولك : في الدار زيد قاءما . وقرء : ومن قبله كتاب موسي ، علي : واتينا الذين قبله التوراة . ومعني ) اماما ( : قدوة يءتم به في دين الله وشراءعه ، كما يءتم بالامام ) ورحمة ( لمن امن به وعمل بما فيه ) وهاذا ( القران ) كتاب مصدق ( لكتاب موسي . او لما بين يديه وتقدمه من جميع الكتب . وقرء ( مصدق لما بين يديه ) ) لسانا عربيا ( حال من ضمير الكتاب في مصدق ، والعامل فيه ( مصدق ) ويجوز ان ينتصب حالا عن كتاب لتخصصه بالصفاة ، ويعمل فيه معني الاشارة . وجوز ان يكون مفعولا لمصدق ، اي : يصدق ذات لسان عربي وهو الرسول . وقرء : ( لينذر ) بالياء والتاء ، ولينذر : من نذر ينذر اذا حذر ) وبشري ( في محل النصب معطوف علي محل لينذر ، لانه مفعول له .
 ) ووصينا الانسان بوالديه احسانا حملته امه كرها ووضعته كرها وحمله وفصاله ثلاثون شهرا حتي اذا بلغ اشده وبلغ اربعين سنة قال رب اوزعني ان اشكر نعمتك التي انعمت علي وعلي والدي وان اعمل صالحا ترضاه واصلح لي في ذريتي اني تبت اليك واني من المسلمين اولاءك الذين نتقبل عنهم احسن ما عملوا ونتجاوز عن سيءاتهم في اصحاب الجنة وعد الصدق الذي كانوا يوعدون (
 الاحقاف : (  ) ووصينا الانسان بوالديه . . . . .
 قرء : ( حسنا ) بضم الحاء وسكون السين . وبضمهما ، وبفتحهما . واحسانا ، وكرها ، بالفتح والضم ، وهما لغتان في معني المشقة ، كالفقر والفقر . وانتصابه علي  " صفحة رقم  "
 الحال : اي : ذات كره . او علي انه صفة للمصدر ، اي : حملا ذا كره ) وحمله وفصاله ( ومدة حمله وفصاله ) ثلاثون شهرا ( وهذا دليل علي ان اقل الحمل ستة اشهر ؛ لان مدة الرضاع اذا كانت حولين لقوله عز وجل : ) حولين كاملين لمن اراد ان يتم الرضاعة ( ( البقرة :  ) بقيت للحمل ستة اشهر . وقرء : ( وفصله ) والفصل والفصال : كالفطم والفطام . بناء ومعني . فان قلت : المراد بيان مدة الرضاع لا الفطام ، فكيف عبر عنه بالفصال ؟ قلت : لما كان الرضاع يليه الفصال ويلابسه لانه ينتهي به ويتم : سمي فصالا ، كما سمي المدة بالامد من قال : كل حي مستكمل مدة العم
