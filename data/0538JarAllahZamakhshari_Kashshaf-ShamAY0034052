 وانما هو بتوفيق الله ولطفه وعصمته فقال ) وما ابرء نفسي ( من الزلل ، وما اشهد لها بالبراءة الكلية ولا ازكيها . ولا يخلو ، اما ان يريد في هذه الحادثة ، لما ذكرنا من الهم الذي هو ميل النفس عن طريق الشهوة البشرية لا عن طريق القصد والعزم . واما ان يريد به عموم الاحوال ) ان النفس لامارة بالسوء ( اراد الجنس ، اي ان هذا الجنس يامر بالسوء ويحمل عليه بما فيه من الشهوات ) الا ما رحم ربي ( الا البعض الذي رحمه ربي بالعصمة كالملاءكة . ويجوز ان يكون ) ما رحم ( في معني الزمن ، اي : الا وقت رحمة ربي ، يعني انها امارة بالسوء في كل وقت واوان ، الا وقت العصمة . ويجوز ان يكون استثناء منقطعا ، اي : ولكن رحمة ربي هي التي تصرف الاساءة ، كقوله : ) ولا هم ينقذون الا رحمة ( ( يس :  ) وقيل معناه : ذلك ليعلم اني لم اخنه لان المعصية خيانة . وقيل : هو من كلام امراة العزيز ، اي ذلك الذي قلت ليعلم يوسف اني لم اخنه ولم اكذب عليه في حال الغيبة وجءت بالصحيح والصدق فيما سءلت عنه وما ابرء نفسي مع ذلك من الخيانة ، فاني قد خنته حين قرفته وقلت ما جزاء من اراد باهلك سوءا الا ان يسجن واودعته السجن تريد الاعتذار مما كان منها ان كل نفس لامارة بالسوء الا ما رحم ربي : الا نفسا رحمها الله بالعصمة كنفس يوسف ) ان ربي غفور رحيم ( استغفرت ربها واسترحمته مما ارتكبت . فان قلت : كيف صح ان يجعل من كلام يوسف ولا دليل علي ذلك ؟ قلت : كفي بالمعني دليلا قاءدا الي ان يجعل من كلامه ونحوه قوله : ) قال الملا من قوم فرعون ان هاذا لساحر عليم يريد ان يخرجكم من ارضكم بسحره ( ( الشعراء :  ) ثم قال : ) فماذا تامرون ( ( الشعراء :  ) وهو من كلام فرعون يخاطبهم ويستشيرهم . وعن ابن جريج : هذا من  " صفحة رقم  "
 تقديم القران وتاخيره ، ذهب الي ان ) ذالك ليعلم ( ( يوسف :  ) متصل بقوله : ) وقال الملك اءتوني به فلما جاءه الرسول ( ( يوسف :  ) ولقد لفقت المبطلة روايات مصنوعة ، فزعموا ان يوسف حين قال : ) اني لم اخنه بالغيب ( ( يوسف :  ) قال له جبريل : ولا حين هممت بها ، وقالت له امراة العزيز : ولا حين حللت تكة سراويلك يا يوسف ، وذلك لتهالكهم علي بهت الله ورسله .
 ) وقال الملك اءتوني به استخلصه لنفسي فلما كلمه قال انك اليوم لدينا مكين امين (
 يوسف : (  ) وقال الملك اءتوني . . . . .
 يقال استخلصه واستخصه ، اذا جعله خالصا لنفسه وخاصا به ) فلما كلمه ( وشاهد منه ما لم يحتسب ) قال ( ايها الصديق ) انك اليوم لدينا مكين ( ذو مكانة ومنزلة ) امين ( مءتمن علي كل شء . روي ان الرسول جاءه فقال : اجب الملك ، فخرج من السجن ودعا لاهله : اللهم اعطف عليهم قلوب الاخيار ولا تعم عليهم الاخبار ، فهم اعلم الناس بالاخبار في الواقعات . وكتب علي باب السجن : هذه منازل البلوي وقبور الاحياء وشماتة الاعداء وتجربة الاصدقاء ، ثم اغتسل وتنظف من درن السجن ، ولبس ثيابا جددا فلما دخل علي الملك قال : اللهم اني اسالك بخيرك من خيره ، واعوذ بعزتك وقدرتك من شره ، ثم سلم عليه ودعا له بالعبرانية ، فقال : ما هذا اللسان ؟ قال لسان اباءي ، وكان الملك يتكلم بسبعين لسانا ، فكلمه بها فاجابه بجميعها ، فتعجب منه وقال : ايها الصديق ، اني احب ان اسمع رءياي منك . فقال : رايت بقرات فوصف لونهن واحوالهن ومكان خروجهن ، ووصف السنابل وما كان منها علي الهيءة التي راها الملك لا يخرم منها حرفا ، وقال له : من حقك ان تجمع الطعام في الاهراء ، فياتيك الخلق من النواحي يمتارون منك ، ويجتمع لك من الكنوز ما لم يجتمع لاحد قبلك .
 ) قال اجعلني علي خزاءن الا رض اني حفيظ عليم (
 يوسف : (  ) قال اجعلني علي . . . . .
 ) اجعلني علي خزاءن الارض ( ولني خزاءن ارضك ) اني حفيظ عليم ( امين احفظ ما  " صفحة رقم  "
 تستحفظنيه ، عالم بوجوه التصرف ، وصفا لنفسه بالامانة والكفاية اللتين هما طلبة الملوك ممن يولونه ، وانما قال ذلك ليتوصل الي امضاء احكام الله تعالي واقامة الحق وبسط العدل ، والتمكن مما لاجله تبعث الانبياء الي العباد ، ولعلمه ان احدا غيره لا يقوم مقامه في ذلك ، فطلب التولية ابتغاء وجه الله لا لحب الملك والدنيا . وعن النبي ( صلي الله عليه وسلم ) :
 (  ) ( رحم الله اخي يوسف ، لو لم يقل اجعلني علي خزاءن الارض ، لاستعمله من ساعته ، ولكنه اخر ذلك سنة ) فان قلت : كيف جاز ان يتولي عملا من يد كافر ويكون تبعا له وتحت امره وطاعته ؟ قلت : روي مجاهد انه كان قد اسلم : وعن قتادة . هو دليل علي انه يجوز ان يتولي الانسان عملا من يد سلطان جاءر ، وقد كان السلف يتولون القضاء من جهة البغاة ويرونه . واذا علم النبي او العالم انه لا سبيل الي الحكم بامر الله ودفع الظلم الا بتمكين الملك الكافر او الفاسق . فله ان يستظهر به . وقيل : كان الملك يصدر عن رايه ولا يعترض عليه في كل ما راي ، فكان في حكم التابع له والمطيع .
 ) وكذالك مكنا ليوسف في الا رض يتبوا منها حيث يشاء نصيب برحمتنا من نشاء ولا نضيع اجر المحسنين (
 يوسف : (  ) وكذلك مكنا ليوسف . . . . .
 ) وكذالك ( ومثل ذلك التمكين الظاهر ) مكنا ليوسف ( في ارض مصر . روي انها كانت اربعين فرسخا في اربعين ) يتبوا منها حيث يشاء ( قرء بالنون والياء ، اي : كل مكان اراد ان يتخذه منزلا ومتبوا له ، لم يمنع منه لا ستيلاءه علي جميعها ودخوله تحت ملكته وسلطانه . روي : ان الملك توجه ، وختمه بخاتمه ، ورداه بسيفه . ووضع له سريرا من ذهب مكللا بالدر والياقوت . روي انه قال له : اما السرير فاشد به ملكك . واما الخاتم فادبر به امرك ، واما التاج فليس من لباسي ولا لباس اباءي . فقال : قد وضعته اجلالا لك واقرارا بفضلك . فجلس علي السرير ودانت له الملوك ، وفوض الملك اليه امره وعزل قطفير ، ثم مات بعده ، فزوجه الملك امراته زليخا ، فلما دخل عليها قال : اليس هذا خيرا مما طلبت ؟ فوجدها عذراء ، فولدت له ولدين : افراثيم وميشا ، واقام العدل بمصر ، واحبته الرجال والنساء ، واسلم علي يديه الملك وكثير من الناس ، وباع من اهل مصر في سني القحط الطعام بالدنانير والدراهم في السنة الاولي حتي لم يبق معهم شء منها ، ثم بالحلي والجواهر ، ثم بالدواب ، ثم بالضياع والعقار ، ثم برقابهم حتي استرقهم جميعا ، فقالوا : والله ما راينا كاليوم ملكا اجل ولا اعظم منه فقال الملك كيف رايت صنع اليه بي فيما  " صفحة رقم  "
 خولني فما تري قال الراي رايك : قال : فاني اشهد الله واشهدك اني اعتقت اهل مصر عن اخرهم ، ورددت عليهم املاكهم ، وكان لا يبيع من احد من الممتارين اكثر من حمل بعير ، تقسيطا بين الناس . واصاب ارض كنعان وبلاد الشام نحو ما اصاب ارض مصر ، فارسل يعقوب بنيه ليمتاروا واحتبس بنيامين ) برحمتنا ( بعطاءنا في الدنيا من الملك والغني وغيرهما من النعم ) من نشاء ( من اقتضت الحكمة ان نشاء له ذلك ) ولا نضيع اجر المحسنين ( ان ناجرهم في الدنيا .
 ) ولاجر الا خرة خير للذين ءامنوا وكانوا يتقون (
