 ) افمن هو قاءم ( احتجاج عليهم في اشراكهم بالله ، يعني افا الله الذي هو قاءم رقيب ) علي كل نفس ( صالحة او طالحة ) بما كسبت ( يعلم خيره وشره ، ويعد لكل جزاءه ، كمن ليس كذلك . ويجوز ان يقدر ما يقع خبرا للمبتدا ويعطف عليه وجعلوا ، وتمثيله : افمن هو بهذه الصفة لم يوحدوه ) وجعلوا ( له وهو الله الذي يستحق العبادة وحده ) شركاء قل سموهم ( اي جعلتم له شركاء فسموهم له من هم ونبءوه باسماءهم ، ثم قال : ) ام ( علي ام المنقطعة ، كقولك للرجل : قل لي من زيد ام هو اقل من ان يعرف ، ومعناه : بل اتنبءونه بشركاء لا يعلمهم في الارض وهو العالم بما في السموات والارض ، فاذا لم يعلمهم علم انهم ليسوا بشء يتعلق به العلم ، والمراد نفي ان يكون له شركاء . ونحو : ) قل اتنبءون الله بما لا يعلم في السماوات ولا في الارض ( ( يونس :  ) ، ) ام بظاهر من القول ( بل اتسمونهم شركاء بظاهر من القول من غير ان يكون لذلك حقيقة كقولك ، ) ذالك قولهم بافواههم ( ( التوبة :  ) ، ) ما تعبدون من دونه الا اسماء سميتموها ( ( يوسف :  ) وهذا الاحتجاج واساليبه العجيبة التي ورد عليها مناد علي نفسه بلسان طلق ذلق : انه ليس من كلام البشر لمن عرف وانصف من نفسه ، فتبارك الله احسن الخالقين . وقرء : ( اتنبءونه ) بالتخفيف ) مكرهم ( كيدهم للاسلام بشركهم ) وصدوا ( قرء بالحركات الثلاث . وقرا ابن ابي اسحاق : ( وصد ) بالتنوين ) ومن يضلل الله ( ومن يخذله لعلمه انه لا يهتدي ) فما له من هاد ( فما له من احد يقدر علي هدايته ) لهم عذاب في الحيواة الدنيا ( وهو ما ينالهم من القتل والاسر وساءر المحن ، ولا يلحقهم الا عقوبة لهم علي الكفر ، ولذلك سماه عذابا ) وما لهم من الله من واق ( وما لهم من حافظ من عذابه . او ما لهم من جهته واق من رحمته .

 " صفحة رقم  "
 ) مثل الجنة التي وعد المتقون تجري من تحتها الانهار اكلها داءم وظلها تلك عقبي الذين اتقوا وعقبي الكافرين النار (
 الرعد : (  ) مثل الجنة التي . . . . .
 ) مثل الجنة ( صفتها التي هي في غرابة المثل ، وارتفاعه بالابتداء والخبر محذوف علي مذهب سيبويه ، اي فيما قصصناه عليكم مثل الجنة . وقال غيره : الخبر ) تجري من تحتها الانهار ( كما تقول : صفة زيد اسمر ، وقال الزجاج : معناه مثل الجنة جنة تجري من تحتها الانهار ، علي حذف الموصوف تمثيلا لما غاب عنا بما نشاهد . وقرا علي رضي الله عنه ( امثال الجنة ) علي الجمع اي صفاتها ) اكلها داءم ( كقوله ) لا مقطوعة ولا ممنوعة ( ( الواقعة :  ) ) وظلها ( داءم لا ينسخ ، كما ينسخ في الدنيا بالشمس .
 ) والذين اتيناهم الكتاب يفرحون بما انزل اليك ومن الا حزاب من ينكر بعضه قل انما امرت ان اعبد الله ولا اشرك به اليه ادعو واليه ماب (
 الرعد : (  ) والذين اتيناهم الكتاب . . . . .
 ) والذين ءاتيناهم الكتاب ( يريد من اسلم من اليهود ، كعبد الله بن سلام وكعب واصحابهما ، ومن اسلم من النصاري وهم ثمانون رجلا : اربعون بنجران ، واثنان وثلاثون بارض الحبشة ، وثمانية من اهل اليمن ، هءلاء ) يفرحون بما انزل اليك ومن الاحزاب ( يعني ومن احزابهم وهم كفرتهم الذين تحزبوا علي رسول الله ( صلي الله عليه وسلم ) بالعداوة نحو كعب بن الاشرف واصحابه ، والسيد والعاقب اسقفي نجران واشياعهما ) من ينكر بعضه ( لانهم كانوا لا ينكرون الاقاصيص وبعض الاحكام والمعاني هو ثابت في كتبهم غير محرف ، وكانوا ينكرون ما هو نعت الاسلام ونعت رسول الله ( صلي الله عليه وسلم ) وغير ذلك مما حرفوه وبدلوه من الشراءع . فان قلت : كيف اتصل قوله : ) قل انما امرت ان اعبد الله ( بما قبله ؟ قلت : هو جواب للمنكرين معناه : قل انما امرت فيما انزل الي بان اعبد الله ولا اشرك به . فانكاركم له انكار لعبادة الله وتوحيده فانظروا ماذا تنكرون مع ادعاءكم وجوب عبادة الله وان لا يشرك به ) قل يااهل اهل الكتاب تعالوا الي كلمة سواء بيننا وبينكم ان لا نعبد الا الله ولا نشرك به شيءا ( ( ال عمران :  ) وقرا نافع في رواية ابي خليد : ( ولا اشرك ) بالرفع علي الاستءناف كانه قال : وانا لا اشرك به ويجوز ان يكون في موضع الحال علي معني : امرت ان اعبد الله غير مشرك به ) اليه ادعو ( خصوصا لا ادعو الي غيره ) واليه ( لا الي غيره مرجعي ، وانتم تقولون مثل ذلك ، فلا معني لانكاركم .
 ) وكذالك انزلناه حكما عربيا ولءن اتبعت اهواءهم بعد ما جاءك من العلم ما لك من الله من ولي ولا واق (  )
 الرعد : (  ) وكذلك انزلناه حكما . . . . .

 " صفحة رقم  "
 ) وكذالك انزلناه ( ومثل ذلك الانزال انزلناه مامورا فيه بعبادة الله وتوحيده والدعوة اليه والي دينه ، والانذار بدار الجزاء ) حكما عربيا ( حكمة عربية مترجمة بلسان العرب ، وانتصابه علي الحال . كانوا يدعون رسول الله ( صلي الله عليه وسلم ) الي امور يوافقهم عليها منها ان يصلي الي قبلتهم بعد ما حوله الله عنها ، فقيل له : لءن تابعتهم علي دين ما هو الا اهواء وشبه بعد ثبوت العلم عندك بالبراهين والحجج القاطعة ، خذلك الله فلا ينصرك ناصر ، واهلكك فلا يقيك منه واق ، وهذا من باب الالهاب والتهييج ، والبعث للسامعين علي الثبات في الدين والتصلب فيه ، وان لا يزل زال عند الشبهة بعد استمساكه بالحجة ، والا فكان رسول الله ( صلي الله عليه وسلم ) من شدة الشكيمة بمكان .
 ) ولقد ارسلنا رسلا من قبلك وجعلنا لهم ازواجا وذرية وما كان لرسول ان ياتي بااية الا باذن الله لكل اجل كتاب يمحو الله ما يشاء ويثبت وعنده ام الكتاب (
 الرعد : (  ) ولقد ارسلنا رسلا . . . . .
 كانوا يعيبونه بالزواج والولاد ، كما كانوا يقولون : ما لهذا الرسول ياكل الطعام ، وكانوا يقترحون عليه الايات ، وينكرون النسخ فقيل : كان الرسل قبله بشرا مثله ذوي ازواج وذرية . وما كان لهم ان ياتوا بايات برايهم ولا ياتون بما يقترح عليهم ، والشراءع مصالح تختلف باختلاف الاحوال والاوقات ؛ فلكل وقت حكم يكتب علي العباد ، اي : يفرض عليهم علي ما يقتضيه استصلاحهم ) ويفعل الله ما يشاء ( ينسخ ما يستصوب نسخه ، ويثبت بدله ما يري المصلحة في اثباته ، او يتركه غير منسوخ ، وقيل : يمحو من ديوان الحفظة ما ليس بحسنة ولا سيءة ؛ لانهم مامورون بكتبة كل قول وفعل ) ويثبت ( غيره . وقيل يمحو كفر التاءبين ومعاصيهم بالتوبة ، ويثبت ايمانهم وطاعتهم . وقيل : يمحو بعض الخلاءق ويثبت بعضا من الاناسي وساءر الحيوان والنبات والاشجار وصفاتها واحوالها ، والكلام في نحو هذا واسع المجال ) وعنده ام الكتاب ( اصل كل كتاب وهو اللوح المحفوظ ، لان كل كاءن مكتوب فيه . وقرء : ( ويثبت ) .
 ) وان ما نرينك بعض الذي نعدهم او نتوفينك فانما عليك البلاغ وعلينا الحساب (
 الرعد : (  ) واما نرينك بعض . . . . .
 ) وان ما نرينك ( وكيفما دارت الحال اريناك مصارعهم وما وعدناهم من انزال العذاب عليهم . او توفيناك قبل ذلك ، فما يجب عليك الا تبليغ الرسالة فحسب ، وعلينا لا عليك حسابهم وجزاءهم علي اعمالهم ، فلا يهمنك اعراضهم ، ولا تستعجل بعذابهم .
 ) اولم يروا انا ناتي الا رض ننقصها من اطرافها والله يحكم لا معقب لحكمه وهو سريع الحساب (
 الرعد : (  ) او لم يروا . . . . .
 ) او لم يروا انا ناتي الارض ( ارض الكفر ) ننقصها من اطرافها ( بما نفتح علي المستلمين  " صفحة رقم  "
 من بلادهم ، فننقص دار الحرب ونزيد في دار الاسلام ، وذلك من ايات النصرة والغلبة ونحوه ) افلا يرون انا ناتي الارض ننقصها من اطرافها ( ( الانبياء :  ) ، ) افهم الغالبون ( ( الانبياء :  ) ، ) سنريهم ءاياتنا في الافاق ( ( فصلت :  ) والمعني : عليك بالبلاغ الذي حملته ؛ ولا تهتم بما وراء ذلك فنحن نكفيكه ونتم ما وعدناك من الظفر ، ولا يضجرك تاخره ؛ فان ذلك لما نعلم من المصالح التي لا تعلمها ثم طيب نفسه ونفس عنها بما ذكر من طلوع تباشير الظفر . وقرء ( ننقصها ) بالتشديد ) لا معقب لحكمه ( لا راد لحكمه . والمعقب : الذي يكر علي الشء فيبطله ، وحقيقته : الذي يعقبه اي يقفيه بالرد والابطال . ومنه قيل لصاحب الحق : معقب ؛ لانه يقفي غريمه بالاقتضاء والطلب . قال لبيد : طلب المعقب حقه المظلوم ;
 والمعني : انه حكم للاسلام بالغلبة والاقبال ، وعلي الكفر بالادبار والانتكاس ) وهو سريع الحساب ( فعما قليل يحاسبهم في الاخرة بعد عذاب الدنيا . فان قلت : ما محل قوله لا معقب لحكمه ؟ قلت : هو جملة محلها النصب علي الحال ، كانه قيل : والله يحكم نافذا حكمه ، كما تقول جاءني زيد لا عمامة علي راسه ولا قلنسوة ، تريد حاسرا .
 ) وقد مكر الذين من قبلهم فلله المكر جميعا يعلم ما تكسب كل نفس وسيعلم الكفار لمن عقبي الدار (
 الرعد : (  ) وقد مكر الذين . . . . .
 ) وقد مكر الذين من قبلهم ( وصفهم بالمكر ، ثم جعل مكرهم كلا مكر بالاضافة الي مكره فقال ) فلله المكر جميعا ( ثم فسر ذلك بقوله : ) يعلم ما تكسب كل نفس وسيعلم الكافر لمن عقبي الدار ( لان من علم ما تكسب كل نفس ، واعد لها جزاءها فهو المكر كله ؛ لانه ياتيهم من حيث لا يعلمون . وهم في غفلة مما يراد بهم . وقرء : ( الكفار ) ، و( الكافرون ) . و( الذين كفروا ) . والكفر : اي اهله . والمراد بالكافر الجنس : وقرا جناح بن حبيش ، و( سيعلم الكافر ) ، من اعلمه اي سيخبر :
 ) ويقول الذين كفروا لست مرسلا قل كفي بالله شهيدا بيني وبينكم ومن عنده علم الكتاب (
 الرعد : (  ) ويقول الذين كفروا . . . . .
 ) كفي بالله شهيدا ( لما اظهر من الادلة علي رسالتي ) ومن عنده علم الكتاب (  " صفحة رقم  "
 والذي عنده علم القران وما الف عليه من النظم المعجز الفاءت لقوي البشر . وقيل : ومن هو من علماء اهل الكتاب الذين اسلموا . لانهم يشهدون بنعته في كتبهم : وقيل : هو الله عز وعلا والكتاب : اللوح المحفوظ وعن الحسن : لا والله ما يعني الا الله . والمعني : كفي بالذي يستحق العبادة وبالذي لا يعلم علم ما في اللوح الا هو ، شهيدا بيني وبينكم . وتعضده قراءة من قرا : ( ومن عنده علم الكتاب ) علي من الجارة ، اي ومن لدنه علم الكتاب ، لان علم من علمه من فضله ولطفه . وقرء : ( ومن عنده علم الكتاب ) علي من الجارة ، وعلم ، علي البناء للمفعول وقرء : ( وبمن عنده علم الكتاب ) . فان قلت : بم ارتفع علم الكتاب ؟ قلت : في القراءة التي وقع فيها عده صلة يرتفع العلم بالمقدر في الظرف ، فيكون فاعلا ؛ لان الظرف اذا وقع صلة اوغل في شبه الفعل لاعتماده علي الموصول ، فعمل عمل الفعل ، كقولك ، مررت بالذي في الدار اخوه ، فاخوه فاعل ، كما تقول : بالذي استقر في الدار اخوه . وفي القراءة التي لم يقع فيها عنده صلة يرتفع العلم بالابتداء عن رسول الله ( صلي الله عليه وسلم ) :
 (  ) ( من قرا سورة الرعد اعطي من الاجر عشر حسنات بوزن كل سحاب مضي وكل سحاب يكون الي يوم القيامة ، وبعث يوم القيامة من الموفين بعهد الله .

  AUTO " صفحة رقم  "
 ( سورة ابراهيم عليه السلام )
 مكية ، ( الا ايتي  و فمدنيتان )
 واياتها  ( نزلت بعد سورة نوح )
 بسم الله الرحمن الرحيم
 ) الر كتاب انزلناه اليك لتخرج الناس من الظلمات الي النور باذن ربهم الي صراط العزيز الحميد الله الذي له ما في السماوات وما في الا رض وويل للكافرين من عذاب شديد الذين يستحبون الحيواة الدنيا علي الا خرة ويصدون عن سبيل الله ويبغونها عوجا اولاءك في ضلال بعيد (
 ابراهيم : (    ) الر كتاب انزلناه . . . . .
 ) كتاب ( هو كتاب ، يعني السورة . وقرء : ( ليخرج الناس ) . والظلمات والنور : استعارتان للضلال والهدي ) باذن ربهم ( بتسهيله وتيسيره ، مستعار من الاذن الذي هو تسهيل للحجاب ، وذلك ما يمنحهم من اللطف والتوفيق ) الي صراط العزيز الحميد ( بدل من قوله الي النور بتكرير العامل ، كقوله : ) للذين استضعفوا لمن ءامن منهم ( ( الاعراف :  ) ويجوز ان يكون علي وجه الاستءناف ، كانه قيل : الي اي نور ؟ فقيل : الي صراط العزيز الحميد . وقوله : ) يخافون ربهم من فوقهم ويفعلون ما يءمرون ( عطف بيان للعزيز الحميد ؛ لانه جري مجري الاسماء الاعلام لغلبته واختصاصه بالمعبود الذي تحق له العبادة كما غلب النجم في الثريا . وقرء بالرفع علي : ( هو الله ) . الويل : نقيض الوال ، وهو النجاة اسم معني ، كالهلاك ؛ الا انه لا يشتق منه فعل ، انما يقال : ويلا له ، فينصب نصب المصادر ، ثم يرفع رفعها لافادة معني الثبات ، فيقال : ويل له ، كقوله سلام عليك . ولما ذكر الخارجين من ظلمات الكفر الي نور الايمان توعد الكافرين بالويل . فان قلت : ما وجه اتصال قوله : ) من عذاب شديد ( بالويل ؟ قلت : لان المعني انهم يولولون من عذاب شديد ، ويضجون منه ، ويقولون : يا ويلاه ، كقوله : ) دعوا هنالك ثبورا ( ( الفرقان :  ) ) الذين يستحبون ( مبتدا خبره : اولءك في ضلال بعيد ويجوز ان يكون مجرورا صفة للكافرين ، ومنصوبا علي الذم . او مرفوعا علي اعني الذين يستحبون او هم الذين يستحبون ، والاستحباب : الايثار والاختيار ، وهو استفعال من المحبة ؛ لان المءثر للشء علي غيره كانه يطلب من نفسه ان يكون احب اليها وافضل عندها من الاخر . وقرا الحسن ( ويصدون ) ، بضم الياء وكسر الصاد . يقال : صده عن كذا ، واصده ، قال :

