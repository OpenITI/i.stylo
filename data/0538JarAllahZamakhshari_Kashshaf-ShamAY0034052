 وقرء : ( سادتنا ) و( ساداتنا ) : وهم رءوساء الكفر الذين لقنوهم الكفر وزينوه لهم . يقال : ضل السبيل واضله اياه ، وزيادة الالف لاطلاق الصوت : جعلت فواصل الاي كقوافي الشعر ، وفاءدتها الوقف والدلالة علي ان الكلام قد انقطع ، وان ما بعده مستانف . وقرء : ( كثيرا ) تكديرا لاعداد اللعاءن . وكبيرا ، ليدل علي اشد اللعن واعظمه ) ضعفين ( ضعفا لضلاله وضعفا لاضلاله : يعترفون ، ويستغيثون ، ويتمنون ، ولا ينفعهم شء من ذلك .
 ) ياايها الذين ءامنوا لا تكونوا كالذين ءاذوا موسي فبراه الله مما قالوا وكان عند الله وجيها (
 الاحزاب : (  ) يا ايها الذين . . . . .
 ) لا تكونوا كالذين ءاذوا موسي ( قيل : نزلت في شان زيد وزينب ، وما سمع فيه من قالة بعض الناس . وقيل : في اذي موسي عليه السلام : هو حديث المومسة التي ارادها قارون علي قذفه بنفسها ، وقيل : اتهامهم اياه بقتل هارون ، وكان قد خرج معه الجبل فمات هناك ، فحملته الملاءكة ومروا به عليهم ميتا فابصروه حتي عرفوا انه غير مقتول . وقيل : احياه الله فاخبرهم ببراءة موسي عليه السلام . وقيل : قرفوه بعيب في جسده من برص او ادرة ، فاطلعهم الله علي انه برء منه ) وجيها ( ذا جاه ومنزلة عنده ، فلذلك كان يميط عنه التهم ، ويدفع الاذي ، ويحافظ عليه ، لءلا يلحقه وصم ولا يوصف بنقيصة ، كما يفعل الملك بمن به عنده قربة ووجاهة . وقرا ابن مسعود والاعمش وابو حيوة : ( وكان عبد الله وجيها ) قال ابن خالويه : صليت خلف ابن شنبوذ في شهر رمضان ، فسمعته يقرءها . وقراءة العامة اوجه ؛ لانها مفصحة عن وجاهته عند الله ، كقوله تعالي : ) عند ذي العرش مكين ( ( التكوير :  ) وهذه ليست كذلك ، فان قلت : قوله : ) مما قالوا ( معناه : من قولهم ، او من مقولهم ؛ لان ( ما ) اما مصدرية او موصولة ، وايهما كان فكيف تصح البراءة منه ؟ قلت : المراد بالقول او المقول : مءداه ومضمونة وهو الامر المعيب ، الا تري انهم سموا السبة بالقالة ، والقالة بمعني القول ؟ .
 ) ياايها الذين ءامنوا اتقوا الله وقولوا قولا سديدا يصلح لكم اعمالكم ويغفر لكم ذنوبكم ومن يطع الله ورسوله فقد فاز فوزا عظيما انا عرضنا الا مانة علي السماوات والا رض والجبال فابين ان يحملنها واشفقن منها وحملها الانسان انه كان ظلوما جهولا ليعذب الله المنافقين والمنافقات والمشركين والمشركات ويتوب الله علي المءمنين والمءمنات وكان الله غفورا رحيما (  )
 الاحزاب : (  ) يا ايها الذين . . . . .

 " صفحة رقم  "
 ) قولا سديدا ( قاصدا الي الحق والسداد : القصد الي الحق ، والقول بالعدل . يقال : سدد السهم نحو الرمية : اذا لم يعدل به عن سمتها ، كما قالوا : سهم قاصد ، والمراد : نهيهم عما خاضوا فيه من حديث زينب من غير قصد وعدل في القول ، والبعث علي ان يسد قولهم في كل باب ؛ لان حفظ اللسان وسداد القول راس الخير كله . والمعني : راقبوا الله في حفظ السنتكم ، وتسديد قولكم ، فانكم ان فعلتم ذلك اعطاكم الله ما هو غاية الطلبة : من تقبل حسناتكم والاثابة عليها ، ومن مغفرة سياتكم وتكفيرها . وقيل : اصلاح الاعمال التوفيق في المجء بها صالحة مرضية وهذه الاية مقررة للتي قبلها ، بنيت تلك علي النهي عما يءذي رسول الله ( صلي الله عليه وسلم ) ، وهذه علي الامر باتقاء الله تعالي في حفظ اللسان ؛ ليترادف عليهم النهي والامر ، مع اتباع النهي ما يتضمن الوعيد من قصة موسي عليه السلام ، واتباع الامر الوعد البليغ فيقوي الصارف عن الاذي والداعي الي تركه . لما قال : ) ومن يطع الله ورسوله ( وعلق بالطاعة الفوز العظيم ، اتبعه قوله : ) انا عرضنا الامانة ( وهو يريد بالامانة الطاعة ، فعظم امرها وفخم شانها ، وفيه وجهان ، احدهما : ان هذه الاجرام العظام من السماوات والارض والجبال قد انقادت لامر الله عز وعلا انقياد مثلها وهو ما يتاتي من الجمادات واطاعت له الطاعة التي تصح منها وتليق بها . حيث لم تمتنع علي مشيءته وارادته ايجادا وتكوينا وتسوية علي هيات مختلفة واشكال متنوعة ، كما قال : ) قالتا اتينا طاءعين ( ( فصلت :  ) واما الانسان فلم تكن حاله فيما يصح منه من الطاعات ويليق به من الانقياد لاوامر الله ونواهيه ، وهو حيوان عاقل صالح للتكليف مثل حال تلك الجمادات فيما يصح منها ويليق بها من الانقياد وعدم الامتناع ، والمراد بالامانة : الطاعة ؛ لانها لازمة الوجود ، كما ان الامانة لازمة الاداء . وعرضها علي الجمادات واباءها واشفاقها : مجاز . واما حمل الامانة فمن قولك : فلان حامل للامانة ومحتمل لها ، تريد انه لا يءديها الي صاحبها حتي تزول عن ذمته ويخرج عن عهدتها ؛ لان الامانة كانها راكبة للمءتمن عليها وهو حاملها ، الا تراهم يقولون : ركبته الديون ، ولي عليه حق ، فاذا اداها لم تبق راكبة له ولا هو حاملا لها . ونحوه قولهم ، لا يملك مولي لمولي نصرا . يريدون : انه يبذل النصرة له ويسامحه بها ، ولا يمسكها كما يمسكها الخاذل ، ومنه قول القاءل : اخوك الذي لا تملك الحس نفسه
 وترفض عند المحفظات الكتاءف  " صفحة رقم  "
 اي لا يمسك الرقة والعطف امساك المالك الضنين ما في يده ، بل يبذل ذلك ويسمح به . ومنه قولهم ابغض حق اخيك ؟ لانه اذا احبه لم يخرجه الي اخيه ولم يءده ، واذا ابغضه اخرجه واداه ، فمعني ، فابين ان يحملنها وحملها الانسان ، فابين الا ان يءدينها وابي الانسان الا ان يكون محتملا لها لا يءديها . ثم وصفه بالظلم لكونه تاركا لاداء الامانة ، وبالجهل لاخطاءه ما يسعده مع تمكنه منه وهو اداءها . والثاني : ان ما كلفه الانسان بلغ من عظمه وثقل محمله : انه عرض علي اعظم ما خلق الله من الاجرام واقواه واشده : ان يتحمله ويستقل به ، فابي حمله والاستقلال به واشفق منه ، وحمله الانسان علي ضعفه ورخاوة قوته ) انه كان ظلوما جهولا ( حيث حمل الامانة ثم لم يف بها ، وضمنها ثم خاس بضمانة فيها ، ونحو هذا من الكلام كثير في لسان العرب . وما جاء القران الا علي طرقهم واساليبهم من ذلك قولهم : لو قيل للشحم : اين تذهب ؟ لقال : اسوي العوج ، وكم وكم لهم من امثال علي السنة البهاءم والجمادات . وتصور مقاولة الشحم محال ، ولكن الغرض ان السمن في الحيوان مما يحسن قبيحه ، كما ان العجف مما يقبح حسنه ، فصور اثر السمن فيه تصويرا هو اوقع في نفس السامع ، وهي به انس وله اقبل ، وعلي حقيقته اوقف ، وكذلك تصوير عظم الامانة وصعوبة امرها وثقل محملها والوفاء بها . فان قلت : قد علم وجه التمثيل في قولهم للذي لا يثبت علي راي واحد : اراك تقدم رجلا وتءخر اخري ؛ لانه مثلت حاله في تميله وترجحه بين الرايين وتركه المضي علي احدهما بحال من يتردد في ذهابه فلا يجمع رجليه للمضي في وجهه . وكل واحد من الممثل والممثل به شء مستقيم داخل تحت الصحة والمعرفة ، وليس كذلك ما في هذه الاية ؛ فان عرض الامانة علي الجماد واباءه واشفاقه محال في نفسه ، غير مستقيم ، فكيف صح بناء التمثيل علي المحال ، وما مقال هذا الا ان تشبه شيءا والمشبه به غير معقول . قلت : الممثل به في الاية وفي قولهم : لو قيل للشحم اين تذهب . وفي نظاءره مفروض ، والمفروضات تتخيل في الذهن كما المحققات : مثلت حال التكليف في صعوبته وثقل محمله بحالة المفروضة لو عرضت علي السماوات والارض والجبال لابين ان يحملنها واشفقن منها . واللام في ) ليعذب ( لام التعليل علي طريق المجاز : لان التعذيب نتيجة حمل الامانة ، كما ان التاديب في ضربته للتاديب نتيجة الضرب . وقرا الاعمش : ( ويتوب ) ؛ ليجعل العلة قاصرة علي فعل الحامل ، ويبتدء :

