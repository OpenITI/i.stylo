  AUTO كتاب تحريم القتل ومن يجب عليه القصاص ومن لا قصاص عليه   كتاب تحريم القتل ومن يجب عليه القصاص ومن لا قصاص عليه

  AUTO   لا يجب القصاص الا علي مكلف ملتزم للاحكام، فلا يجب بجناية الحربي وان دخل بعد الجناية في الذمة او الاسلام، وفي السكران خلاف.

 ويقتل الذكر بالانثي، والانثي بالذكر، والذمي بالذمي، وان اختلفت الملتان والدينان، فيقتل النصراني بالمجوسي.
 ويقتل الرقيق بالرقيق، وان كان القاتل مكاتبا، او مدبرا، او ام ولد، ولا يسقط القصاص عن ام الولد بعتقها.
 ولا يقتل الحر برقيق، ولا بمن فيه جزء من الرق، ويقتل العبد بالحر، والذمي بالمسلم، والولد بالوالد.
 ولا يقتل والد بولد، ولا مسلم بكافر.
 ولا يجبر بعض هذه الصفات ببعض، فلا يقتل حر كافر بعبد مسلم، ولا عبد مسلم بحر كافر.
 فان قتل الذمي ذميا، او العبد عبدا، ثم اسلم القاتل، او عتق، لم يسقط القصاص، وان جرح ذمي ذميا، او عبد عبدا، فاسلم الجارح، او عتق، ثم مات المجروح بالسراية، لم يقتل به علي الاصح.



 ولو قتل عبد [مسلم] (¬) لمسلم، او لكافر، عبدا مسلما لكافر، ففي قتله به وجهان؛ فان القود مستحق للسيد، ولذلك يسقط بعفوه، ولا يسقط بعفو العبد، ولو قتل حر ذمي عبدا، ثم نقض العهد وارق لم يقتل به.
 ولو قتل ذمي ذميا، ثم اسلم القاتل، فمات ولي القتيل عن ورثة كفار، ورثوا القصاص علي الاصح.
 وان تبعض الرق والحرية في القتيل والقاتل؛ فان كان ما في القاتل من الحرية اكثر مما في القتيل منها لم يقتل به، وان كان مساويا، او اقل، قتل به عند العراقيين، وقالت المراوزة: لا يقتل به؛ فان ذلك يءدي الي ان يقتص من جزء حر بجزء رقيق، ولهذا لو ال الامر الي المال تعلق كل واحد من نصيب الحرية والرق بالذمة والرقبة.

  AUTO   فرع

 :
 يقتل الذمي بالمعاهد اتفاقا، وفيه احتمال من الخلاف في قطع المعاهد بالسرقة، وان قتل ذمي مرتدا فقولان؛ فانه مهدر، وخرج الاصطخري قولا: انه يقتل ان تعمد، ولا دية عليه ان اخطا؛ للاهدار، فان قلنا: يقتل به، فالقصاص للامام، وعلي قول غريب: يثبت لمن يرثه لو مات مسلما.
 وان قتل مرتد ذميا؛ فان قلنا: لا يقتل الذمي بالمرتد، قتل المرتد به، وان قلنا: يقتل بالمرتد، ففي قتل المرتد به قولان؛ لعلقة الاسلام.
 ويقتل المرتد بالمرتد، وابعد من منع لاجل الاهدار.



 وان قتل الذمي مسلما زانيا محصنا، قتل به اتفاقا، ولا يقتل به المسلم علي اقيس الوجهين، وبه قطع المراوزة.

  AUTO   فرع

 :
 اذا قوبلت جملة بجملة قوبلت اجزاءها باجزاءها، فكل شخصين يقتل احدهما بالاخر، فطرف احدهما مقطوع بطرف الاخر، فتقطع يد الرجل بيد المراة؛ لان يد كل واحد منهما اذا نسبت اليه كانت نصف جملته، ولا تقطع يد المراة السليمة بيد الرجل الشلاء وان ساوت حكومتها نصف دية المراة.
 * * *

  AUTO   فصل في قتل الوالد ولده

 لا يقتل الابوان بالولد اتفاقا، ولا الاجداد والجدات الا علي قول غريب، ومن قتل من يرثه ابنه، او يرث بعض ماله، فلا قصاص عليه.
 ومن وجب عليه او علي ابيه قصاص، فورث ذلك القصاص، او ورث بعضه، سقط جميع القصاص، فلو قتل عتيق ابنه، فمات وارث العتيق، فورثه الابن، سقط القصاص.

  AUTO   فرع

 :
 اذا قتل احد الاخوين اباهما، والاخر امهما؛ فان كانا علي الزوجية سقط القصاص عن السابق، وثبت علي اللاحق، وان لم يكن بينهما زوجية فلكل واحد منهما ان يقتص من الاخر، وهل يبدا بالاقتصاص من السابق، او يقرع بينهما؟ فيه وجهان، فان بدانا بالسابق فهل يرثه المقتص؟ فيه   خلاف، فان قلنا: يرثه، سقط القصاص عن الاخر (¬)، وان قلنا: لا يرثه، اقتص منه ورثة السابق.
 واذا استحق احدهما التقديم بالقرعة، او السبق، فبدر الاخر بالقتل وقع قصاصا، وفي الارث الخلاف.
 وان قتلا ابويهما معا، فعلي كل واحد منهما القصاص للاخر، سواء كانت الزوجية باقية، او لم تكن، فيقرع بينهما، وان بادر احدهما بالقتل وقع قصاصا، ولا يمكن كل واحد منهما من قتل الاخر، ولا يقال: من ابتدر منكما وقع قتله قصاصا؛ خوفا من ابتدار كل واحد منهما.

  AUTO   فرع

 :
 اذا تنازع اثنان ولدا يمكن لحاقه بكل واحد منهما، فقتله احدهما، لم يقتل به؛ لاحتمال ابوته، فان الحقته القافة بالاخر قتل قاتله، وان الحقته بالقاتل لم يقتل به، وان اشتركا في قتله لم يقتل به واحد منهما، فان الحقته القافة باحدهما قتل به الاخر.
 * * *

  AUTO   فصل في قتل الجماعة بالواحد

 اذا قتل جماعة واحدا بحيث لو انفرد كل واحد منهم بقتله لقتل به، وجب القصاص علي الجميع، وان تفاوتوا في عدد الجراحات، فاذا قتلوا به، وقع قتل كل واحد منهم قصاصا باتفاق الاصحاب.



 وقال الحليمي (¬): اذا كانوا عشرة مثلا كان عشر كل واحد منهم قصاصا، والباقي وسيلة الي استيفاءه، كما تقلع ابواب الغاصب لتخليص المغصوب (¬).
 وهذا باطل؛ فانا لا نوجب القصاص في الساعد؛ خوفا من الزيادة علي المستحق، فكيف نريق تسعة اعشار الدم بغير القصاص، ولا يصح الاستدلال باتحاد الدية؛ فانا نقتل الرجل بالمراة مع نقص ديتها.

  AUTO   فرع

 :
 تقطع (¬) الاطراف بالطرف اذا تحاملوا علي الة القطع؛ بحيث لا ينفرد بعضهم بالجناية علي بعض الطرف، فان قطع احدهما بعض الطرف، وقطع الاخر ما بقي، لم يجب القصاص علي واحد منهما، وخرج صاحب "التقريب" قولا من وجوب القصاص في المتلاحمة: بان يقطع من كل واحد منهما مثل ما قطع، وهذا لا يصح؛ لتناسب لحم المتلاحمة، وتفاوت الاطراف في وضع العروق والاعصاب.



 ولو جر كل واحد منهما الحديدة كجر المنشار؛ فان انفرد كل واحد منهما بجذبة، فلا قصاص عليهما، وان اشتركا في كل جذبة، قطعت يد كل واحد منهما؛ لاشتراكهما.
 * * *



  AUTO   باب كيفية قتل العمد وجراح العمد التي فيها القصاص وغير ذلك

 الجرح والقتل ثلاثة اضرب: عمد، وخطا، وشبه عمد.
 والقتل منقسم الي: مذفف كالذبح، والي سبب يتعلق بالظاهر تارة كالضرب، وبالباطن تارة كالجرح. 
 فاما المتعلق بالظاهر من العمد: فهو كل ما يقصد به القتل غالبا اذا تجرد القصد اليه، ويختلف باختلاف الاحوال والاشخاص والازمان، وما لا يقصد به القتل غالبا فهو شبه العمد، واما الجرح فلا يشترط فيه ان يقصد به القتل غالبا، وضبطه الامام بكل جرح يتحقق حصول الموت به اذا تجرد القصد اليه، فعلي هذا: كل ما علم حصول الموت به من الاسباب الظاهرة او الباطنة، فهو عمد اذا تجرد القصد اليه، ولا يقدح فيما ذكره الا نص الشافعي علي ان الكف اذا تاكلت بالجرح فلا قصاص فيها، وان علم حصول التاكل بالجرح كما علم حصول الموت باسبابه المتعمدة، وان قصد ما يمكن حصول الموت به، ولم يعلم حصوله به، فهو شبه العمد.
 وقال ابو محمد: العمد ما يكون القتل مقصودا به، وشبه العمد ما يكون الفعل مقصودا به، ثم قد يفضي الي القتل.
 * * *



  AUTO   فصل في غرز الابرة

 قال الاصحاب: اذا غرز ابرة في مقتل انسان كثغرة النحر، والمثانة، والاخدع، والعجان (¬)، فمات، وجب القود، وان غرزها في غير مقتل؛ فان كان في جلد غليظ لم يتعلق به ضمان؛ فان الفعل المتعمد اقسام:
 احدها: ما يعلم حصول الموت به، فيوجب القود.
 الثاني: ما يمكن حصول الموت به، ولا يعلم، فيوجب الضمان.
 الثالث: ما لا يمكن حصول الموت به، كغرز الابرة في جلد غليظ، فلا قود ولا ضمان.
 وان غرزها في اللحم، وجاوزت الجلد، فطريقان:
 احداهما: في وجوب القود وجهان.
 والثانية: ان تورم محل الغرز وجب، وان اشتد الالم من غير ورم فوجهان.
 * * *

  AUTO   فصل في الالقاء في الماء والنار

 اذا القاه في ماء غير مغرق؛ فان شد اطرافه، والقاه بحيث يلجمه الماء، ولا يمكنه الخلاص، وجب القصاص، وان لم يشده، فاضطجع   حتي هلك، لم يضمن، وان القاه في ماء مغرق تظهر النجاة منه بالسباحة فغرق؛ فان جهل السباحة وجب القود، وان عرفها ففي الضمان وجهان، فان اوجبناه لم يجب القود علي الاصح.
 وان القاه في نار يمكن التخلص منها، فتخاذل، فوجهان مرتبان، واولي بالوجوب، فان لم نوجب الضمان، فكان للفح الاول اثر، افرد بالضمان، وان منعه اللفح الاول من الخروج، فليس هذا محل الخلاف.
 * * *

  AUTO   فصل في دفع الاسباب

 اذا وقع سبب يقدر المجني عليه علي دفع الهلاك معه، فلم يفعل، فله احوال:
 الاولي: ان يكون السبب مهلكا، والدفع عسيرا، والبرء مظنونا، كترك مداواة الجرح، فلا يسقط الضمان.
 الثاني: الا يكون السبب مهلكا، والدفع يسير مقطوع به، كترك الخروج من الضحضاح، وكترك المحبوس الاكل من الطعام الحاضر، فلا ضمان، وكذلك ترك ربط الفصد عند الامام.
 الثالث: ان يكون السبب جناية، والخلاص ممكنا، وقد يقع دهش يمنع منه، كترك السباحة والخروج من النار، ففيه الخلاف، وكذا لو ترك تعصيب الجرح حتي نزف دمه عند الامام.
 * * *



  AUTO   فصل فيمن القي انسانا في مهلكة فهلك بسبب اخر

 اذا القاه علي سبب مهلك، فهلك بسبب ثان، فللسبب الثاني احوال:
 احدها: الا يكون له فعل ولا اختيار، كما لو القاه من شاهق مهلك، او في بءر مهلكة، فصادف سكاكين منصوبة، ورماحا مشرعة، او جرحه بسكين، ثم ظهر انه مات بسم فيها يجهله الجارح، فيجب القود.
 الثاني: ان يكون فعل انسان مختار، مثل ان يلقيه من شاهق، فيقتله انسان قبل الوصول الي الارض، فلا قود علي الملقي ولا ضمان وان لم يكن القاتل ضامنا كالحربي.
 الثالث: ان يكون فعل حيوان يفعل بطبعه، كما لو القاه في لجة فالتقمه حوت عند الوصول الي الماء، او القاه من شاهق، فقتلته حية عادية او سبع ضار قبل الوصول الي الارض، فيجب القود، خلافا للربيع، فانه اسقط القود، واوجب الضمان، وهذا لا يصح؛ فان الحيوان الضاري بطبعه كالسيف المصادف لمضربه، بخلاف فعل المختار، ولذلك قال الشافعي: لو ادخله بيتا فيه سباع ضارية، او هدفه لوثبة اسد ضار، وجب القود، ولو امسكه ليقتله انسان مختار، لم يجب القود بالامساك، وان كان القاتل غير ضامن كالحربي.

  AUTO   فرع

 :
 اذا القاه من شاهق، فقتله مجنون؛ فان كان ضاريا بالطبع فهو كالسبع، وان لم يكن كذلك فهو كالعاقل.
 ولو التقمه الحوت قبل الوصول الي اللجة، فقد نقل القاضي عن الاصحاب وجوب الضمان، ونقل عنهم نفيه، واختار الوجوب، والوجه:



 القطع بوجوبه الا علي قول الربيع، ولا يصح هذا النقل عن الاصحاب؛ اذ لا فرق بين الهواء وصدمة الماء، فان التلف لا يحصل بمصادمة الماء؛ لرقته ولطافته، وانما يحصل بالغرق بعد المصادمة.

  AUTO   فرع

 :
 اذا القاه علي سبب غير مهلك، فهلك بغيره؛ فان لم يشعر به الجاني مثل ان القاه في ضحضاح، فالتقمه حوت لم يشعر به، او دفعه دفعا خفيفا، فوقع علي سكين لم يشعر بها وجب الضمان دون القود، وان علم بذلك وجب القود.
 * * *

  AUTO   فصل في التجويع وسقي السم

 اذا حبس انسانا، فمات بالجوع والعطش، او باحدهما؛ فان تمكن المحبوس من تحصيلهما بوجه من الوجوه فلا ضمان علي الحابس، وان منعه منهما، او من احدهما؛ فان كان حين حبسه شبعان ريان وجب القود، وان كان جوعان؛ فان جهل جوعه ففي القود قولان، وان علمه فطريقان، فان قلنا: يجب القود، وجبت الدية، وان قلنا: لا يجب، فهل يجب كمال الدية، او توزع علي الجوعين؟ فيه خلاف.
 ولو جهل مرض انسان، فضربه ضربا يقتل مثله مريضا، ولا يقتله صحيحا، وجب القود، بخلاف مبادء الجوع، فانه يعد من الرياضات واصلاح الاجساد.
 ولو وضع عدلا في سفينة مشحونة، فغرقت، فهل يلزمه كمال الضمان،   او نصفه، او يتوزع الضمان علي الاثقال؟ فيه ثلاثة اوجه، ولا ينبغي ان يخرج ثقل السفينة عن الاعتبار.
 وان سقاه سما؛ فان لم يغلب علي الظن انه قاتل فهو عند الاصحاب كغرز الابرة في غير مقتل، وان كان مذففا؛ فان اوجره به وجب القود، وان اكرهه علي شربه؛ فان جهل الشارب كونه سما وجب القود، وان علم لم يجب؛ فان المكره من يخلص نفسه بفعل ما اكره عليه.
 ولو دعاه الي اكل طعام مسموم بقول او قرينة حال، ففي القود قولان اقيسهما: انه لا يجب، فان اوجبناه وجبت الدية، وكذا ان لم نوجبه علي ما قطع به الاصحاب، وحكي ابو محمد قولين.
 وان دس السم في طعام، فاكله صاحب الطعام فقد قيل: لا يجب القود، وقيل: فيه القولان.
 * * *

  AUTO   فصل في اغراء السباع وانهاش العقارب والحيات

 اذا انهشه حية او عقربا لا يقتل جنسها في الغالب، فهو كغرز الابرة عند الاصحاب، وان كانت من جنس قتال، كحيات مصر، وعقارب نصيبين، وجب القود.
 وان اغري به كلبا ضاريا؛ او سبعا ضاريا، فان كان في مضيق لا يمكنه الخلاص منه وجب القود، وان كان في صحراء لم يجب القود؛ لامكان الهرب.
 وقال القاضي والامام: ان علم ان الهرب لا ينجيه وجب القود، وان   امكنه الهرب فتخاذل، فهو كترك السباحة عند الامام.
 ولو اغري في الصحراء سبعا غير ضار، فقد قال الامام: ان كان السبع مطلقا فلا قود ولا ضمان؛ لان افتراسه وقع اتفاقا، وان كان مربوطا فحله واغراه؛ فان نظرنا الي عدم الضراوة فالوجه نفي الضمان، وان نظرنا الي امكان الهرب فهو كترك السباحة.
 وان جمعه مع سبع، او حيات في بيت، فافترسه السبع، او نهشته الحيات، وجب القود بالافتراس دون النهش؛ لان الحية تنفر بطبعها، والاسد يثب في المضيق بطبعه، وذكر صاحب "التقريب" قولا في الافتراس، وهذا لا يصح؛ فان الاحكام تتبع الصور، فان كان من الحيات ما يقصد، ومن السباع ما ينفر، فالاحكام مبنية علي ذلك، فان تحققت العمدية وجب القود، وان شككنا فيها لم يجب.
 * * *

  AUTO   فصل في اجتماع الجارح والمذفف

 اذا قطع حلقومه ومريءه، او اخرج حشوته، فجرحه اخر، او قطع يده وهو يتحرك، قتل الاول، وعزر الثاني، ولا ضمان عليه؛ لانه جني علي ميت.
 ولو جرحه جرحا يهلكه لا محالة، ولكن بقيت فيه حياة مستقرة، فذففه اخر، وجب علي الاول ما يجب علي الجارح، وعلي الثاني ما يجب علي القاتل.
 مثاله: ان يقطع احدهما معاه، فيذبحه الاخر، او يخرج حشوته، او يقده بنصفين مع بقاء الحياة المستقرة، ولو قطع مريءه فالحياة مستقرة ما لم   يصل الي حركة المذبوح، فاذا وصل اليها حكم بموته، بخلاف ما لو انتهي انسان بالمرض الي مثل تلك الحال، فمهما قتل وهو يتنفس وجب القصاص بقتله.
 ولو قده بنصفين، وترك حشوته في النصف الاعلي، فما دام يتكلم او ينظر فهو حي عند الاءمة، وقال الامام: لا يجب القصاص بقتله؛ فانه معدود من الموتي، وكلامه غير منتظم.
 * * *

  AUTO   فصل فيمن قطع يد انسان ثم قتله قبل الاندمال او بعده

 اذا سرت الجراحات الي النفس اندرجت دياتها في دية النفس، ولا يندرج قصاصها في قصاص النفس؛ فان قطع يدي انسان ورجليه، فاندملتا، فعفا عن القود، وجب ديتان، وان مات بالسراية وجبت دية واحدة، وان قتله اجنبي، قبل الاندمال فلا ادراج اتفاقا، وان قتله القاطع بعد الاندمال وجب ثلاث ديات، وان قتله قبل الاندمال؛ فان اتفقت صفة القطع والقتل بان كانا عمدا، او خطا فالنص وجوب دية واحدة؛ للادراج، وخرج ابن سريج قولا منقاسا: انه يجب ثلاث ديات؛ لان تعذر الادراج بالقتل كتعذره بالاندمال.
 وان اختلفت صفة الجناية، فكان القطع عمدا، والقتل خطا، او بالعكس، ففي الادراج قولان منصوصان مرتبان عند الامام، واولي بنفي الادراج، فلو قطع يده ثم قتله؛ فان منعنا الادراج، فاختلفت صفة الجنايتين (¬)   كانت دية الخطا منهما مخففة علي العاقلة، ودية العمد مغلظة علي الجاني، وان قلنا بالادراج، فقد جعل الشافعي نصف الدية مخففا علي العاقلة، ونصفها مغلظا علي الجاني.
 وقال الامام: ان كان القتل عمدا فجميع الدية مغلظة علي الجاني، وان كان خطا فجميعها مخفف علي العاقلة؛ لان معني الادراج سقوط دية الاطراف اكتفاء بدية النفس.
 وعلي قول الشافعي: لو قطع يديه عمدا، ثم قتله خطا، او بالعكس، او قطع يديه ورجليه عمدا، ثم قتله خطا، او بالعكس، او قطع اصبعه عمدا، وقتله خطا، فالوجه: ايجاب نصف الدية علي العاقلة، ونصفها علي الجاني؛ اذ لا نظر الي اعداد الجراحات اذا صارت نفسا.

  AUTO   فرع

 :
 اذا قلنا بالادراج، فقطع يديه عمدا، ثم قتله عمدا، فقطع الولي يديه، ثم عفا عن نفسه، فلا دية له علي اظهر الوجهين، ولو قطع احداهما، ثم قتله، فقطع الولي احدي يديه، ثم عفا، وجب نصف الدية علي الاظهر، وعلي الاخر يجب الدية.
 * * *

  AUTO   فصل في مشاركة العامد لمن لا يلزمه القصاص

 اذا شارك العامد مخطءا، فلا قصاص علي واحد منهما، وان شارك عامدا لا يلزمه القصاص، فللشريك احوال:
 الاولي: ان يلزمه الدية، كما لو شارك الاجنبي الاب في قتل الولد،   او الحر عبدا في قتل عبد، او الذمي مسلما في قتل ذمي، فيجب القود علي الاجنبي والعبد والذمي.
 الثانية: الا يلزمه دية ولا كفارة، كما لو جرح حربيا او مرتدا، فجرحه اخر بعد الاسلام، او قطعت يده في حد، او قصاص، وجرحه اخر، او جرح ذمي حربيا فالتزم الذمة، فجرحه ذمي اخر، ففي وجوب القصاص علي الضامن منهما قولان.
 الثالثة: ان تلزمه الكفارة لا غير، كالسيد يشارك في قتل عبده، فهل يلحق شريك السيد بمن يلزمه الدية، او بمن لا يلزمه شء؟ فيه وجهان، وان شارك في قتل نفسه؛ فان لم نوجب عليه الكفارة ففي القود علي شريكه القولان، وان اوجبناها، فان جعلناها كالدية وجب القود اتفاقا، وان لم نجعلها كالدية ففيه القولان.
 ولو جرح، فداوي جرحه بسم غير مذفف، او خاطه في لحم حي، وامكن احالة الموت علي الجرح والخياطة والسم فطريقان:
 احداهما: انه كالمشارك في قتل نفسه.
 والثانية: لا يجب القود قولا واحدا؛ لانه قصد بذلك الاصلاح، فصار شريكه كشريك المخطء، وعلي هذا: لو قطعت يده حدا او قصاصا، فجرحه اخر، فينبغي الا يجب القصاص، لانه شريك محق، ولا اثر للخياطة في اللحم الميت.
 ولو داوي الجرح بسم مذفف، فليس علي الجارح سوي ارش الجرح، او قوده، وان شارك سبعا في القتل فطريقان:



 احداهما: لا يجب القود؛ لانتفاء العمد.
 والثانية: فيه القولان؛ لانه عامد غير ضامن.

  AUTO   فرع

 :
 اذا اتحد الجاني، واختلف حكم جراحاته، فكان بعضها عمدا وبعضها خطا، او غير مضمون، فلا قود عليه في النفس اتفاقا؛ فان جرح عمدا وخطا كان الخطا علي العاقلة، والعمد في ماله.
 وان جرح عبده، ثم جرحه بعد العتق، او جرح حربيا، او مرتدا، ثم جرحه بعد الاسلام، او قطع يد انسان قصاصا، وجرحه ظلما، او جرح المسلم ذميا، ثم جرحه بعد الاسلام، فلا قود في النفس اتفاقا.

  AUTO   فرع

 :
 اذا ضرب انسانا بسياط يقتل مجموعها غالبا، لزمه القود اتفاقا وان كانت كل ضربة ليست بعمد محض، ولو وقع ذلك من جماعة، فضربه كل واحد ضربة فاوجه؛ ثالثها: ان تواطءوا علي ذلك وجب القود، والا فلا، والاقيس: انه لا يجب بحال؛ فان كل واحد كشريك مخطء، ولا يقال: ان ذلك يصير ذريعة، فان الذريعة ما ينتشر وقوعها ويعم، فان لم نوجب القود وجب ضمان العمد.

  AUTO   فرع

 :
 اذا جرح جرحا، وجرح اخر جرحين، او اشلي (¬) الاخر حية فنهشته،   وسبعا فعضه، فالدية عليهما نصفين؛ اذ لا ينظر في الشركة الي كثرة الجراحات وقلتها.
 ولو جرحه، فنهشته حية، وعضه سبع؛ فان كان ذلك خطا من الحيوان فلا قود علي الجارح، وان كان عمدا، فالجارح شريك عامد عند الاكثرين، وشريك مخطء عند المحققين، فان ال الامر الي المال، فهل يجب نصف الدية، او ثلثها؟ فيه وجهان.
 * * *

  AUTO   فصل في تغير حال المجروح بين الجرح والموت

 اذا جرح انسانا، فتغير حاله، ثم مات بالسراية، فله احوال:
 احدها: ان يتغير من الاهدار الي الضمان، كما لو جرح مرتدا فاسلم، او حربيا فاسلم او استامن، فلا ضمان اتفاقا، وعند العراقيين وجهان.
 ولو جرحه قصاصا، ثم عفا، او جرح الحربي مسلما او ذميا، ثم اسلم الجارح او استامن، او جرح عبده ثم اعتقه، لم يضمن عند المراوزة؛ نظرا الي حال الاهدار، ونص الشافعي علي ذلك في العتق، وقال: لو جني احد الشريكين علي الجارية المشتركة الحامل، ثم اعتقها، وسري عتقه، فاجهضت، فعليه غرة كاملة، ففرق بعضهم: بانا لم نتحقق اتصال الجناية بالجنين قبل العتق، فصار كمن رمي عبدا، فعتق، فاصابه السهم بعد العتق.
 ومنهم من جعل المسالتين علي قولين نقلا وتخريجا:



 احدهما: يجب الغرة والدية.
 واقيسهما: وجوب نصف الغرة، والا يجب شء من الدية، فان اوجبنا ضمان العبد والمرتد والحربي، فهو دية مخففة علي العاقلة.
 الثانية: ان يتغير من الضمان الي الاهدار، مثل ان يجرح مسلما فيرتد، او ذميا فيحارب، فيجب ضمان الجرح دون دية النفس.
 الثالثة: ان يتغير من نقص الضمان الي كماله، مثل ان يجرح ذميا فيسلم، او عبد غيره فيعتق، فيجب تكميل الدية اتفاقا؛ لان اعتبار الجرح المضمون في الزيادة والنقصان بالمال، ولهذا لو قطع يد انسان، او يديه ورجليه، فسري القطع الي نفسه، وجبت دية واحدة.
 * * *

  AUTO   فصل في تغير حال المرمي بين الرمي والاصابة

 اذا رمي الي انسان، فتغير حاله، ثم اصابه السهم فمات؛ فان تغير من الضمان الي الاهدار مثل ان يرمي مسلما فيرتد، او ذميا فينقض العهد فلا ضمان؛ نظرا الي حال الاصابة، سواء ذففه الجرح، او مات بسرايته علي الاهدار.
 وان تغير من الاهدار الي الضمان مثل ان رمي حربيا او مرتدا، فاسلم، فاصابه السهم ففيه اوجه ثالثها: يضمن المرتد دون الحربي؛ فان قتل المرتد مخصوص بالاءمة، ولا يجوز قتله بالرمي.
 ولو رمي الي عبد نفسه، فاعتقه، ثم اصابه السهم، او الي قاتل ابيه،   ثم عفا، فاصابه السهم، فوجهان.
 ورتب الامام الجاني علي المرتد، وعبد الرامي علي الجاني، وجعل الجاني والعبد اولي بالضمان، فان العبد مضمون بالكفارة، والجاني لا يهدر اهدار المرتد.
 وان تغير من نقص الضمان الي كماله مثل ان رمي الي عبد غيره، فعتق، فاصابه السهم، او الي ذمي، فاسلم، فاصابه السهم وجب في الذمي دية مسلم، وفي العبد دية الحر اتفاقا؛ فان الاعتبار بحال الاصابة، فاشبه ما لو رمي الي حي فمات، او الي عبد فنقصت قيمته، فان الاعتبار بحال الاصابة.

  AUTO   فرع

 :
 اذا وقع في حال الاهدار سبب غير مهلك، فلا عبرة به اتفاقا، مثل ان حفر بءر عدوان في مكان فيه حربي، او مرتد، او عبد للحافر، فعتق العبد، واسلم الحربي والمرتد، ثم هلكوا بالبءر، فيجب الضمان اتفاقا؛ اعتبارا بحال التردي.

  AUTO   فرع

 :
 قال الاءمة: اذا اقترن مسقط القصاص بالرمي، او الاصابة، او تخللهما، لم يجب القصاص، ولا تجب الدية علي العاقلة، فان تحملها علي خلاف القياس، فيحتاط له احتياط القصاص، فان كان الرامي مسلما عند الرمي، كافرا عند الاصابة، او بالعكس، او كان مسلما عند الرمي والاصابة، كافرا بينهما، فلا قصاص، والدية في ماله دون عاقلته من المسلمين والكفار.
 ولو رمي الكافر سهما، ثم اسلم، فاصاب انسانا، او رمي المسلم   سهما، ثم ارتد، فاصاب انسانا، فالدية عليه دون عاقلته المسلمين والكفار.
 وان كان مسلما عند الرمي والاصابة، كافرا بينهما، فقولان:
 اصحهما: ان الدية عليه.
 والثاني: علي عاقلته المسلمين؛ نظرا الي الطرفين، ويجب طرد القولين في القصاص.

  AUTO   فرع

 :
 اذا جرح الذمي انسانا خطا ثم اسلم، فمات المجروح، فارش الجرح علي عاقلته الكفار، وبقية الدية عليه دون عاقلته المسلمين؛ لاستناد السراية الي الجرح الواقع في الكفر.
 ولو قطع اصبعه خطا، فسرت الي كفه، فاسلم، فسرت الي نفسه، فنصف الدية عليه، ونصفها علي عاقلته الكفار.
 ولو قطع اصبعا في الكفر، واصبعا في الاسلام، فعلي عاقلته المسلمين نصف الدية، وعلي عاقلته الكفار ارش اصبع، وعليه ما بينهما.
 * * *

  AUTO   فصل فيمن جرح مسلما فارتد ومات

 اذا جرح مسلما، فارتد، فسري الي نفسه، فله حالان:
 احداهما: ان يسلم، ثم يموت، فلا قود في النفس علي النص.
 ولو جرح ذمي ذميا، فحارب المجروح، ثم التزم الذمة، فسري الي نفسه، وجب القود في النفس.



 وفي النصين ثلاث طرق:
 احداهن: في المسلمين قولان نقلا وتخريجا؛ اقيسهما: انه لا يجب؛ لاقتران المهدر ببعض اجزاء السبب.
 والثانية: تنزيل النصين علي طول الزمان وقصره، فان قصر بحيث لا يظهر للسراية وقع محسوس وجب القود، وان طال الزمان مع السريان لم يجب.
 الثالثة، وهي طريقة المحصلين: ان طال الزمان لم يجب القود، وان قصر فقولان، فان اوجبنا القصاص وجبت الدية، وان لم نوجبه؛ فان طال الزمان: فهل تجب الدية، او نصفها، او ثلثها؟ فيه ثلاثة مذاهب، والمنصوص اولها، وان قصر فقد قيل: تجب الدية اتفاقا، وقيل: علي المذاهب الثلاثة، فان غور السراية لا يظهر للحس.
 الثانية: ان يموت كافرا، فلا قصاص في النفس، وفي الطرف قولان:
 احدهما: لا يجب؛ لعدم الوارث الخاص.
 والثاني: يجب للامام؛ بناء علي انه يقتص لمن لا وارث له؛ فان الارث مضاف الي جهة الاسلام دون الاشخاص، ولذلك يجوز صرف بدله الي من يولد بعد القتل.
 وقيل: يثبت لوليه الخاص؛ لان غرضه التشفي.
 فان لم نوجب القصاص وجب الارش علي الاصح، وابعد من قال: لا يجب؛ لاندراجه في نفس مهدرة، واذا وجب الارش فهو لاهل الفء.



 فان زاد علي الدية بان قطع يديه ورجليه، فمات، فالواجب دية واحدة علي الاصح، وقيل: ديتان؛ لتعذر الادراج بالاهدار، فيشبه ما لو اندملت، او قتل لردته (¬)، او مات بعد الجرح.

  AUTO   فرع

 :
 اذا قطع يدي نصراني تمجس، وسري الي نفسه، فان قلنا: لا يقر علي التمجس، كان كمن جرح مسلما فارتد ومات بالجرح، وان قلنا: يقر، ففيه دية مجوسي نظرا الي المال.
 * * *

  AUTO   فصل فيمن جرح عبدا، فعتق ثم مات بالسراية

 اذا جرح عبدا قيمته اقل من دية الحر او اكثر باضعاف، فعتق، فسري الجرح الي نفسه، ففيه دية حر اعتبارا بالمال، اذ لا خلاف ان من قطع اطرافا فيها ديات فسرت، وجبت دية واحدة.
 ثم للجاني علي العبد اذا مات بالسراية بعد العتق احوال:
 الاولي: ان يقطع يده، فيعتق ويموت، ففيما يستحقه السيد من ديته قولان:
 احدهما: الاقل من كل الدية او نصف القيمة، ويعبر عن هذا القول في جميع الصور بانه: الاقل مما لزم الجاني بالجناية علي الملك بتقدير الاندمال، او مما لزمه بسبب الجناية علي الملك.



 والثاني وهو مخرج: انه يستحق الاقل من كل الدية او كل القيمة، ويعبر عنه بانه: الاقل مما لزمه بالجناية علي الملك، او مثل نسبته من القيمة.
 الثانية: ان يقطع يده، فيعتق، ثم يقطع اخر يده الاخري، ويقطع اخر رجله، فعلي كل واحد ثلث الدية، وفيما يستحقه السيد منهما قولان منصوصان:
 احدهما: الاقل من نصف الدية او ثلث القيمة.
 والثاني: الاقل من ثلث الدية او ثلث القيمة، فانه مثل نسبته، وهذا القول مخرج في بقية الصور.
 الثالثة: ان يقطع يده، فيعتق، فيقطع يده الاخري، ويقطع اخر رجله، ويقطع اخر رجله الاخري، فعلي كل واحد ثلث الدية، وفيما يستحقه السيد قولان:
 احدهما: الاقل من سدس الدية، او نصف القيمة.
 والثاني: الاقل من سدس الدية او سدس القيمة.
 الرابعة: ان يوضحه، فيجرحه اخر بعد العتق، فعلي كل واحد نصف الدية، وفيما يستحقه السيد قولان:
 احدهما: الاقل من نصف عشر القيمة او نصف الدية.
 والثماني: الاقل من نصف القيمة او نصف الدية.
 الخامسة: ان يوضحه، فيعتق، فيجرحه، ثم يجرحه اخر، فعلي كل واحد نصف الدية، وفيما يستحقه السيد قولان:
 احدهما: الاقل من نصف عشر القيمة او ربع الدية.



 والثاني: الاقل من ربع القيمة او ربع الدية.

  AUTO   فرع

 :
 اذا جرح عبدا قيمته عشرون بعيرا، ثم جرحه تسعة انفس بعد العتق، فعلي كل واحد عشر من الابل، وللسيد بعير علي قول؛ لانه اقل من عشر الدية، وبعيران علي اخر؛ لانهما عشر القيمة، وهما اقل من عشر الدية.

  AUTO   فرع

 :
 اذا كانت قيمته مءة من الابل، صرفت الي السيد اتفاقا، وليس له طلب النقد الغالب اعتبارا بالمال في جنس الواجب كما تعين في قدره، وهل له طلب الابل؟ فيه وجهان منقدحان للامام:
 احدهما: نعم؛ لان الفاءت نصف حر.
 والثاني: يتخير الجاني بين الابل والنقد الغالب، فايهما دفع اجبر السيد عليه.
 * * *

  AUTO   فصل في الاكراه وما يباح به وما لا يباح

 ولا يباح الزنا والقتل بالاكراه، ويباح به التلفظ بكلمة الكفر، ولا يجب علي الاصح، ويجب به شرب الخمر، كما يجب اساغة اللقمة بها، وكما يجب علي المضطر اكل الميتة، وان اضطر الي اكل مال الغير، واكره علي اتلافه، وخاف علي نفسه، لزمه اكله واتلافه.
 ولا يجوز التداوي بالخمر علي المذهب؛ اذ لا يوثق بشفاءها، بخلاف   اساغة اللقمة بها.
 * * *

  AUTO   فصل في الاكراه علي القتل

 اذا اكره رجلا علي القتل وجب القود علي المكره، وفي المكره قولان. فان اوجبناه فال الامر الي المال، فهما شريكان علي كل واحد منهما الكفارة ونصف الدية، وان لم نوجبه: فهل يلزم المكره نصف الدية؟ فيه وجهان. فان قلنا: يلزمه، وجبت الكفارة وحرم الارث، وفي ضربه علي العاقلة تردد للامام. وان قلنا: لا يلزمه، ففي الكفارة وجهان، فان قلنا: تجب، حرم الارث، وان قلنا: لا تجب، ففي الحرمان وجهان.

  AUTO   فرع

 :
 اذا اكره الاجنبي الاب علي قتل الولد، او اكره العبد حرا علي قتل عبد، او اكره الذمي مسلما علي قتل ذمي، فالقود علي الاجنبي والعبد والذمي دون الاب والحر والمسلم.
 وان اكره الاب اجنبيا علي قتل الولد، او المسلم ذميا علي قتل ذمي، فلا قود علي الاب والمسلم، وفي الاجنبي والذمي قولان.

  AUTO   فرع

 :
 اذا قال: اقتلني والا قتلتك، فقد اذن له في قتل نفسه، ومن اذن في قتل نفسه ففي وجوب ديته خلاف مبني علي ان الدية تثبت له ثم تورث عنه، او تثبت ابتداء للورثة، فان قلنا: تثبت للورثة، فلا قصاص علي الاصح؛ للشبهة.



 وفيه قول مخرج، اذ لا اثر للعفو عن حق الغير.

  AUTO   فرع

 :
 اذا قال: اقتل نفسك والا قتلتك، فقتل نفسه، فهو مختار، اذ المكره من يتخلص بما اكره به مما اكره عليه.
 ولو اكره رجلا علي ان يكره اخر علي قتل ثالث، وجب القود علي الاول، وفي الثاني والثالث القولان.
 وان اكره علي اتلاف مال، فقرار الضمان علي المكره، وفي مطالبة المكره وجهان.
 * * *

  AUTO   فصل في اكراه الصبيان

 اذا اكره البالغ صبيا مميزا علي القتل، فان اوجبنا القصاص علي المكره، ففي وجوبه هاهنا علي المكره قولان ماخوذان من القولين في عمد الصبيان، فان جعل عمدا وجب القصاص علي المكره، وكانت الدية عليهما نصفين، وان جعل خطا فلا قصاص علي المكره.
 وان قلنا: لا يجب القصاص علي المكره، فان جعل عمد الصبي عمدا وجب القصاص علي المكره، وان جعل خطا فوجهان ماخذهما: ان فعل المكره بصفته فعل ينقل الي المكره، او يجعل المكره كالمباشر ولا ينظر الي فعل المكره، فيه خلاف يخرج عليه ما لو اكره انسانا علي الرمي الي ما يظنه الرامي صيدا والمكره يعلم انه انسان، ففي وجوب القصاص علي المكره الوجهان.



 وان اكره الصبي رجلا علي القتل وقلنا: يجب القصاص علي المكره، فان جعل عمد الصبي عمدا وجب القصاص، والا فلا.
 * * *

  AUTO   فصل في امر السلطان

 اذا امر السلطان بقتل رجل ظلما، فللمامور احوال:
 احداهن: ان يجهل ظلمه، فلا قصاص عليه اتفاقا وان كان متمكنا من الامتناع.
 الثانية: ان يعلم انه ظالم، ففي تنزيل امره منزلة الاكراه وجهان خصهما الامام بمن الف من عادته السطوة عند المخالفة، فهل يتنزل ذلك منزلة التصريح بالاكراه؟ فيه الخلاف، وقال: فان لم يعرف ذلك من عادته فليس باكراه.
 الثالثة: ان يعتقد المامور انه ظالم، ففي تنزيل امره منزلة الاكراه عند بعض الاصحاب الوجهان، فان ظنه قد يخلف، والظاهر ان السلطان لا يامر الا بحق.
 * * *

  AUTO   فصل في امر من لا يميز بالقتل

 اذا كان طبع المجنون او الصبي والعبد اللذين لا يميزان انهم اذا امروا بشء فعلوه لا محالة، فامروا بقتل، فعلي الامر القود والضمان، وهل يتعلق الضمان برقبة العبد ومال الصبي والمجنون؟ فيه وجهان يجريان فيما لو اتلفوا شيءا بغير اغراء، فانهم بمثابة الحيوان المغري، ومن اغري حيوانا   بالقتل لم يتعلق الضمان برقبة الحيوان، فان علقنا الضمان برقبة العبد ففضل شء فهو علي السيد ان امر بذلك، وان امر به اجنبي وجب عليه التخليص، فان المامور هاهنا بمثابة الالة للامر.
 وان كان الصبي او العبد مميزين لا يستشليان استشلاء السباع، فامرهما بقتل، فلا ضمان علي الامر، فان اكرههما وجب عليه القود وتعلق الضمان بالعبد.
 وقال الامام: ان جعلنا المكره شريكا في الضمان تعلق هاهنا بالرقبة، وان لم نجعله شريكا، ففيه الوجهان، فانه بسقوط الاختيار صار كمن لا يميز.

  AUTO   قاعدة

 :
 للمتسبب مع المباشر احوال:
 احداهن: ان يلجءه الي المباشرة كالمكره والشاهد، فعلي المتسبب القود والضمان.
 الثانية: ان لا يحمله علي المباشرة كالممسك مع القاتل، فلا قود علي المتسبب ولا ضمان.
 الثالثة: ان يحمله علي المباشرة بالتغرير، كما لو ضيفه بطعام مسموم، او غطي بءرا في داره ودعا اليها من يغلب علي الظن انه لا يجد محيصا عنها، ففي القود قولان.

  AUTO   فرع

 :
 اذا امسك عبدا فقتله اخر، او امسك المحرم صيدا فقتله محرم اخر، طولب كل واحد منهما، والقرار علي القاتل، وابعد من جعل ممسك   الصيد شريكا في الاتلاف.

  AUTO   فرع

 :
 لا قصاص علي صبي ولا مجنون، وفي السكران خلاف تقدم في الطلاق.
 * * *

  AUTO   فصل في الجناية علي الخنثي

 اذا قطع رجل ذكر خنثي وانثييه وشفريه، فللخنثي احوال:
 احدها: ان يتوقف الي ان يتضح حاله بالحيض او الامناء، فان بانت ذكورته اقتص في الذكر والانثيين، واخذ حكومة الشفرين، وان بانت انوثته، اخذ دية الشفرين وحكومة الذكر والانثيين.
 الثانية: ان يعفو عن القصاص ويطلب المال، فياخذ دية الشفرين بتقدير الانوثة وحكومة الذكر والانثيين، وابعد من قال: ياخذ حكومة الجميع، وهذا لا يصح الا ان يقطع رجل ذكره وانثييه، ويقطع الاخر شفريه، فيءخذ من كل واحد منهما حكومة لانها متيقنة.
 الثالثة: ان يقف عن القصاص ويطلب حقه من المال، فقد قيل: لا يدفع اليه شء؛ لانا لا ندري عماذا ياخذه، وهذا لا اصل له.
 وقيل: ياخذ الاقل من دية الشفرين بتقدير الذكورة، او حكومة الذكر والانثيين بتقدير الانوثة. وهذا بعيد ايضا.
 والاصح: انه لا ياخذ شيءا عما يمكن جريان القصاص فيه، فان كان   الجاني امراة، اخذ حكومة الذكر والانثيين دون دية الشفرين؛ لامكان القصاص فيهما، وان كان الجاني رجلا، اخذ حكومة الشفرين بتقدير الذكورة وان بلغت تسعين بعيرا، ولا ياخذ حكومة الذكر والانثيين؛ لتوقع القصاص فيهما.
 قال الامام: وتحقيق هذا: انه ياخذ الاقل من حكومة الشفرين بتقدير الذكورة، او حكومة الذكر والانثيين مع دية الشفرين؛ لانه متيقن، وعلي هذا: لو قطع رجل ذكره وانثييه وقطعت امراة شفريه، لم ياخذ في الحال شيءا؛ لتوقع القصاص في الجميع، وان قطع رجل شفريه وامراة ذكره وانثييه، فعلي كل واحد حكومة جنايته، وان قطع خنثي ذكره وانثييه وشفريه، فلا شء له في الحال؛ لتوقع القصاص في الاصلي بالاصلي والزاءد بالزاءد، ومن اوجب اقل الحكومتين فهو غالط عند تساوي الاعضاء.

  AUTO   فرع

 :
 اذا روجع الخنثي عند عدم العلامات، فاخبر انه رجل، ثم جني عليه رجل بعد ذلك، وجب القصاص في الذكر والانثيين، ولو تقدمت الجناية ثم اخبر، لم يقبل علي اصح القولين، وقطع الامام برد خبره في كل حق لولا الاخبار لما ثبت، سواء كان الحق مالا او غيره، بخلاف الخبر قبل الجناية.



  AUTO   باب الخيار في القصاص

 لا خلاف ان الولي مخير بين الدية والقصاص، وايهما اختار ثبت وان كره الجاني، ومهما فات محل القصاص تعين المال، وهل الواجب القود، او احد الامرين من الدية والقود؟ فيه قولان.
 فان اوجبنا احدهما فعفا، فله احوال:
 الاولي: ان يعفو عنهما فيسقطان.
 الثانية: ان يعفو عن القصاص مطلقا، فيسقط وتجب الدية.
 الثالثة: ان يصير بمثابة قولنا: الواجب القود، فان عفا علي مال ثبت وان اطلق فقولان.

  AUTO   فرع

 :
 اذا قال: عفوت علي ان لا مال، ففي سقوط القود والمال وجهان، وان قال: اخترت الدية، تعينت وسقط القود، وان قال: اخترت القود، وقلنا: لا يلغا عفوه عن المال، فهل له الرجوع الي الدية؟ فيه وجهان، وان قلنا: الواجب القود، فعفا عنه علي مال ثبت، وان عفا مطلقا [سقط] (¬) القود، وفي المال قولان.



  AUTO   فرع

 :
 اذا قال: عفوت عنك، فان قلنا: الواجب القود، سقط اتفاقا، وفي المال قولان، وان قلنا: الواجب احدهما، ففي سقوط القصاص وجهان، فان قلنا: يسقط، فزعم انه قصد العفو عن الدية، لم يقبل، وان قلنا: لا يسقط، رجع الي نيته، فان قال: نويت العفو عن الدية، قبل، ثم يخرج علي الخلاف في العفو عن المال، فان قال: لم تكن لي نية، ففي سقوط القصاص وجهان، وان قلنا: لا يسقط وبه قطع ابو علي قيل له: انو الان ايهما شءت، فان نوي العفو عن الدية وقلنا بالغاءه، فلا اثر لذلك.
 * * *

  AUTO   فصل في عفو المحجور عليه

 للمحجور عليه حالان:
 احداهما: ان يكون مسلوب العبارة، فلا حكم لعفوه.
 الثانية: ان يكون صحيح العبارة، وله حالان:
 احداهما: ان يحجر عليه لحق الغير كالمفلس، فان قلنا: الواجب احد الامرين، لم يصح عفوه عن المال، فيتخير، وله الخيار بين العفو والقود، ولا يلزمه تعجيل واحد منهما، فان عفا عن القصاص صرف المال الي الغرماء، وان قلنا: الواجب القود، فعفا علي مال ثبت، وان عفا مطلقا فقولان، فان ما لا يوجب المال من المطلق (¬) لا يوجبه من المحجور عليه، وان عفا علي   ان لا مال، فان لم نوجب المال بالعفو المطلق لم يجب هاهنا، وان اوجبناه ثم، فان كان العافي مطلقا لم يجب، وان كان محجورا عليه فوجهان يعبر عنهما بانه اسقاط للمال ودفع لوجوبه، ووجه الايجاب: انه لو اطلق لوجب، فاذا نفاه كان مسقطا لما له حكم الواجب، ووجه قولنا: لا يجب، انا لو كلفناه اطلاق العفو لكان ذلك تكليفا للكسب، ولا خلاف انه لا يلزم قبول الهبات.
 وحكم المريض فيما زاد علي الثلث، والورثة اذا احاط الدين بالتركة، كحكم المفلس في العفو.
 الثاني: ان يحجر عليه نظرا له كالمبذر، ففيه طريقان:
 احداهما: انه كالمفلس، واصحهما: القطع ببطلان عفوه عن المال بكل حال، فانه لو وصي له بمال او وهب منه شء فرده، بطل رده اتفاقا، ويقبله الولي، وفي نفوذ الرد احتمال للامام.
 * * *

  AUTO   فصل في ميراث الدية والقصاص

 القود والدية موروثان لكل من يرث المال، فلا يجوز استيفاء القود الا برضا الجميع، فان كان فيهم مجنون او صبي او غاءب لم يستوف حتي يحضر الغاءب ويبلغ الصبي ويفيق المجنون، وليس لولي الصبي والمجنون عفو ولا قصاص، فيحبس الجاني حتي يحضر الغاءب ويبلغ الصبي ويفيق المجنون، وان طال حبسه الي الممات.

  AUTO   فرع

 :
 اذا ثبت القصاص لصبي او مجنون، فاستوفياه بغير اذن الجاني، ففي   وقوعه الموقع وجهان، فانهما ليسا من اهل القبض، فان قلنا: لا يقع، فلهما الدية في ماله، ودية عليهما ان جعلناهما عامدين، وان جعلناهما مخطءين، فالدية علي عاقلتيهما، وان وقع ذلك برضا الجاني، مثل ان اخرج يده ومكنهما من قطعها، لم يقع الموقع اتفاقا، ولا ضمان عليهما، والدية عليه؛ لفوات محل القصاص.
 * * *



  AUTO   باب القصاص بالسيف وغيره

 ليس للولي ان يقتص ما لم يرفع الامر الي الوالي، فان اقتص قبل الرفع عزر وحصل القصاص، فان طلبه من الوالي، فان كان امراة او عاجزا عنه لم يفوض اليه، وان كان قادرا، فان كان في النفس فوضه اليه، وان كان في الطرف فوجهان.
 وليس له تفويض حد القذف الي المقذوف عند الاءمة؛ لتفاوت الجلدات.
 وان فوض الاولياء القصاص الي احدهم جاز، وان تشاجروا قرع بينهم، وتراجع المراة والضعيف في ذلك، وفي ادخالهما في القرعة وجهان، فان قلنا: يدخلان، فخرجت القرعة لهما، فوضاه الي من يريانه من الاجانب او الاولياء، ومهما خرجت القرعة لاحدهم: فهل له القصاص بغير رضا الباقين؟ فيه وجهان.
 وقال الامام: ان منعوه لم يقتص، وان اظهروا قصد القصاص وتنازعوا في المباشرة، فخرجت القرعة لاحدهم، ففيه الوجهان.
 وينبغي ان يقتص باحد سيف واسرع ضربة؛ لقوله عليه السلام: "فاذا قتلتم فاحسنوا القتلة" (¬) ويتفقد الوالي الالة، فان كانت مسمومة، فان كان   القصاص في الطرف منع منها، وان كان في النفس، فان كان السم يفتته قبل الدفن منع منها، وفيما يفتت بعد الدفن وجهان.

  AUTO   فرع

 :
 اذا قصد الولي ضرب العنق فاصاب غيره، فان ظهر تعمده بان ضرب الفخذ او الساق عزر، وفي عزله وجهان خصهما الامام بمن لم يتكرر ذلك منه، وقال: ان تكرر عزل اتفاقا، ووجه قولنا: لا يعزل ان ظلمه لا يصلح لابطال حقه، ولو جرح [الجاني] قبل ان يصل الي الوالي فيبعد منعه (¬) من الاستيفاء.
 وان ظهر خطءه بان وقع السيف بالكتف او القمحدوة (¬) لم يعزر، ولا يعزل ان قلنا: يعزل العامد، وان قلنا: لا يعزل العامد، عزل وخص الامام الخلاف بمن لا يعرف حذقه ولا خرقه، وقال بصرف من عرف خرقه دون من عرف حذقه.
 * * *

  AUTO   فصل فيمن وكل في القصاص ثم عفا

 اذا وكل من يستوفي القصاص بحضوره جاز اتفاقا، فان تنحي به (¬)   قليلا بحيث يكون بمراي من الموكل ومسمع، فعفا، فلم يسمع الوكيل العفو وقتل الجاني، فان وقع القتل قبل العفو لم يصح العفو، وان شككنا: هل وقع قبل العفو او بعده؟ حصل القصاص اتفاقا، وان وقع القتل بعد العفو لم يقتص من الوكيل.
 فان ادعي عليه العلم بالعفو، حلف علي نفي العلم به، وفي وجوب الدية علي الوكيل قولان بناهما بعضهم علي القولين في انعزال الوكيل قبل بلوغ الخبر بالعزل، وقال: ان قلنا: لا ينعزل، وقع القتل قصاصا. وبناهما اخرون علي القولين فيمن تعمد قتل رجل في صف الكفار فظهر انه مسلم؛ لان كل واحد منهما معذور عامد، وهذه الطريقة امثل، فان تصرف الموكل يتضمن عزل الوكيل؛ كما لو وكله في بيع عبد، ثم باعه الموكل او اعتقه، فالعفو هاهنا بمثابة الاعتاق.
 ويمكن ايضا ان يفرق بين الوكيل والرامي الي صف الكفار: بان الوكيل مقصر بتنحيه عن الموكل بخلاف الرامي الي الكفار.
 فان اوجبنا الدية فهي مغلظة كشبه العمد، وهي علي الوكيل او علي عاقلته؟ فيه قولان يجريان في كل عمد في شخص معين يظن القاتل فيه الاستحقاق.
 فان جعلت علي الوكيل فهي حالة او مءجلة؟ فيه وجهان، فان اوجبناها عليه او علي العاقلة فغرمت، ففي الرجوع بها علي الموكل طريقان:
 احداهما: التخريج علي الخلاف في تقديم الطعام المغصوب.
 والثانية: القطع بنفي الرجوع، فان الموكل محسن بالعفو غير مغرر.



 فان قلنا بالرجوع بالدية فلا رجوع بالكفارة علي الاصح.

  AUTO   فرع

 :
 ان اوجبنا الدية وجبت الكفارة، وان لم نوجب الدية ففي الكفارة وجهان:
 ظاهر النص: انها لا تجب.
 والوجه: القطع بالايجاب، وهو مذهب المزني وطواءف من الاصحاب، اذ لا يتجه اسقاطها الا اذا جعل القتل قصاصا.
 ويمكن التخريج علي اصل اخر، وهو: ان من عفا عن النفس بعد الجرح، فسري جرحه، بطل عفوه وكانت السراية قصاصا، ولو عفا بين الرمي والاصابة، ففي حصول القصاص وجهان يمكن اجراءهما هاهنا اذا فرض عفوه والسيف هاو الي الجاني بحيث يعسر استدراكه.

  AUTO   فرع

 :
 اذا اوجبنا الدية علي الوكيل فدم المجني عليه في تركة الجاني، وان لم نوجب الدية علي الوكيل سقطت دية المجني عليه عند الاصحاب، اذ يبعد ايجابها علي الجاني مع اهدار ديته.
 وقال الامام: ان جعلنا قتل الوكيل قصاصا فلا دية علي الجاني، وان لم نجعله قصاصا، فالوجه القطع بوجوب الدية عليه، وتهدر ديته (¬) حتي كانه   مات حتف انفه؛ اعتبارا بمن قتله مسلم في صف الكفار وقلنا: لا تجب ديته.
 * * *

  AUTO   فصل في القصاص من الحامل

 لا يقتص من الحامل في نفس ولا طرف، ولا بقطع في حد، ولا تجلد فيه حتي تضع الولد وتسقيه اللبا وهو اول اللبن بعد الوضع، فان الفقهاء زعموا ان الولد لا يعيش دونه، فاذا شرب اللبا فوجدنا مرضعا، قتلت امه، ولا تمهل مدة الرضاع اتفاقا، فان امتنعت المرضع قتلنا الجانية واجبرنا المرضع علي الرضاع بالاجرة.
 وان وجب رجم الحامل، لم ترجم حتي تكمل الرضاع، ثم تجد من يكفل الولد بعد الرضاع، وتحبس لاجل القصاص، ولا تحبس لاجل الرجم علي المذهب، وابعد من قال: تحبس، ولا يتجه ان يثبت الرجم بالاقرار.
 وليس للحاكم ان يحبس في دين الغاءب (¬) الا بالطلب، وله حبس القاتل عند غيبة الاولياء، فانه يحبس من يسء الادب او تخشي غاءلته علي المسلمين، فكيف لا يحبس القاتل؟ .
 * * *

  AUTO   فصل في قتل الحامل

 اذا اذن الوالي للولي في قتل الحامل، فاجهضت جنينا، فللولي والوالي احوال:



 الاول: ان يعلما بالحمل علم مثله او يجهلاه، فضمانه علي الولي، او الوالي، او عليهما؟ فيه ثلاثة اوجه، والاكثرون علي ايجابه علي الولي؛ لمباشرته، والنص ايجابه علي الوالي، وينزل الولي منزلة الجلاد، وايجابه علي الولي اذا جهلا اولي عند ابي محمد، لانه قصر بترك البحث المختص به.
 الثانية: ان يجهله الولي ويعلمه الوالي، فان علقنا الضمان بالوالي اذا علما فها هنا اولي، وان علقناه بالولي ثم فها هنا وجهان يقربان من القولين في تقديم الطعام المغصوب.
 الثالثة: ان يعلمه الولي ويجهله الوالي، فان علقنا الضمان بالولي اذا علما فها هنا اولي، وان علقناه بالوالي ثم فقد قطع الاصحاب بتعلقه بالولي ها هنا، وفيه وجه غريب.
 ومتي علقنا الضمان بالولي فهو علي عاقلته، وان علقناه بالوالي، فان علم حملته العاقلة، وان جهل: فهو علي العاقلة او علي بيت المال؟ فيه قولان، فان جعل علي بيت المال: فالكفارة عليه او علي بيت المال؟ فيه وجهان.

  AUTO   فرع

 :
 اذا قتل الجلاد من لا يجوز قتله، فان لم يعرف خطا الوالي فلا قود عليه ولا كفارة ولا ضمان، وان علم خطءه علم مثله كما ذكرناه في قتل الحامل، ففي تضمينه خلاف مرتب علي الخلاف في الولي اذا علم بالحمل، واولي بنفي الضمان؛ لانه لم يقتل لغرض نفسه، وان علم خطا الامام او عمده فقد قطع الامام بوجوب القود والضمان ان لم تعلم سطوته عند   المخالفة وان علمت ففيه الخلاف.

  AUTO   فرع

 :
 اذا وجب القصاص فادعت الحمل، فان قامت البينة بمخايل الحمل امهلت، وان لم تقم بينة فوجهان، ولعل من يشرط البينة لا يبالي بنطفة تستشعرها المراة، ولعل من لا يشرط البينة لا ينظرها اربع سنين، بل يحبسها مدة يظهر في مثلها مخايل الحمل، ولو وجب القصاص علي الحاءل، فوطءت، فلا تقتل في هذه الصورة، وتوقف فيها الامام.
 * * *

  AUTO   فصل فيمن قتل جماعة

 من قتل جماعة دفعة واحدة او علي الترتيب، قتل باحدهم وللباقين الديات، فان اتفق الاولياء علي ان يقتلوه بالجميع ثم ياخذ كل واحد ما تبقي من دية قتيله، فليس لهم ذلك اتفاقا فان فعلوا ذلك وقع القتل قصاصا، ورجع كل واحد الي بقية الدية، وابعد من قال بصرف القتل الي احدهم بالقرعة.
 وقال الحليمي: يقع قتله قصاصا عن الكل، ولا يجب شي من الدية.
 ولا يعد هذا من المذهب.
 واذا وقع القتل مرتبا بدء بالاول فالاول، فيتخير ولي الاول بين تعجيل القصاص او تاخيره، ولا يلزمه تعجيله ولا ان يعفو، فان عفا ثبت القصاص للثاني وصار كالاول، فان عفا ثبت للثالث، وهكذا الي تمام العدد.
 فان قتله المتاخر قبل عفو المتقدم، حصل القصاص ولم يغرم الدية   للمتقدم، وابعد من قال: يغرمها، فانه تقويم للقصاص، ويلزم منه ان الاجنبي اذا قتل القاتل ان يغرم دية القتيل للاول، وليس الامر كذلك.
 وان قتلهم معا، فاذن الاولياء لاحدهم، جاز، فان رجعوا عن الاذن وتشاجروا في الابتداء، اقرع بينهم، فيتعين من تخرج قرعته، وليس لغيره القصاص الا ان يعفو، فان بدر من لم تخرج قرعته بالقتل، وقع قتله قصاصا.

  AUTO   فرع

 :
 اذا قتل العبد جماعة قتل باحدهم علي المذهب، وللباقين الديات في ذمته كالحر المعسر، وقيل: يقتل بالجميع؛ اذ لا مرجع وراء الرقبة.
 وان قتل الحر جماعة في المحاربة، فان غلبنا الحد قتل بالجميع، وان غلبنا القصاص قتل باحدهم وللباقين الديات.
 وان قتل جماعة جماعة بحيث اشتركوا في قتل كل واحد منهم، فان وقع القتل معا اقرع بينهم (¬)، فمن خرجت له القرعة قتل الجميع بوليه (¬).

  AUTO   فرع

 :
 اذا اقتص الجاني من نفسه، فان كان بغير اذن المستحق لم يحصل الاستيفاء، وان كان باذنه حصل الاستيفاء علي الاصح، ووجه المنع: ان مهلك نفسه يخرج عن كونه ناءبا لغيره.
 * * *



  AUTO   فصل في حكم السراية

 اذا قطع يد انسان فاندملت، فقطعنا يده، فسرت الي نفسه، كانت السراية هدرا، ولو قطع يده فسرت الي نفسه، فقطعنا يد الجاني فسرت الي نفسه، كانت السراية قصاصا.
 ولو قطعنا يده بيده ثم ماتا بالسراية، فان تقدم موت المجني عليه كانت السراية قصاصا، وان تقدم موت الجاني فالجناية هدر او قصاص؟ فيه وجهان.
 ولو قطع يده فسرت الي نفسه، فقطعنا يده فاندملت، فللولي ضرب عنقه، فان عفا علي مال ثبت نصف الدية؛ لانه استوفي ما يقابل نصفها، ولو قطع يديه (¬) فسري القطع الي نفسه، فقطعنا يديه فاندملتا، فعفا الولي علي الدية، لم تثبت علي المذهب؛ لاستيفاءه ما يقابلها، وعلي المذهب: اذا اصطلحا عن القصاص علي مال، فان جوزنا الصلح عن حد القذف جاز الصلح عن الدم، وان منعناه ثم فها هنا وجهان؛ لان الدماء متقومة بخلاف الاعراض، فان جوزناه فصالح عنه اجنبي، لم يجز علي الاصح، وقيل: يجوز كخلع الاجنبي.

  AUTO   فرع

 :
 اذا صالح علي مءتي بعير في غير هذه الصورة، فان قلنا: الواجب احد الامرين، لم يصح الصلح، وان قلنا: الواجب القود، فوجهان.



  AUTO   فرع

 :
 اذا قطع يد انسان وقتل اخر قبل القطع او بعده، قطع ثم قتل، ولو قطع يمين انسان واصبعا من يمين اخر، فان تقدم قطع الاصبع قطعت اصبعه لصاحب الاصبع، ثم تقطع بقية يده لصاحب اليد، وان تقدم قطع اليد قطعت يده لصاحب اليد، وعليه ارش الاصبع لتعذر القصاص فيها، فان الطرف ينقص بنقصان بعضه ولا تنقص النفس بفوات الاطراف.

  AUTO   فرع

 :
 ولو قطع يده من الكوع، فجاء اخر فقطعها من المرفق قبل الاندمال، فمات، وجب عليهما القصاص في النفس، وتقطع يد الاول من الكوع، ويد الثاني من المرفق وان لم يكن لها كف، وان كان فوجهان، اظهرهما: انها تقطع؛ لان النفس مستحقة ولا نظر الي مثل ذلك.
 * * *

  AUTO   فصل في قتل احد الوليين بغير اذن الاخر

 اذا ترك القتيل ولدين، لم يكن لاحدهما الاقتصاص الا باذن الاخر، ويسقط قصاصهما بعفو احدهما، فان قتله احدهما قبل عفو الاخر ففي وجوب القصاص عليه قولان:
 احدهما: يجب كما لو قتله اجنبي.
 والثاني: لا يجب، اما لانه شريك في القصاص، او لشبهة الخلاف، فان علماء المدينة يجوزون لاحدهما الانفراد بالقصاص قبل عفو الاخر وبعده؛ اعتبارا بحد القذف.



 فان اوجبنا القصاص، فاقتص منه، فدية ابيهما علي الجاني بينهما نصفين، وان عفي عنه فلاخيه نصف الدية علي الجاني، ونجري النصف الذي له علي اقوال القصاص ان استوت الديتان، وان تفاوتتا تقاصا في قدر التساوي.
 وان قلنا: لا يجب القصاص، فنصيب اخيه من الدية عليه، او علي الجاني؟ فيه قولان ماخذهما المعنيان، والاقيس: انه علي الجاني؛ كما لو قتله اجنبي، فانه لا يضمن للاخوين شيءا علي ما قطع به الاصحاب، لكن الفرق: ان الاخ مستوف للقصاص كما قال علماء المدينة، او لانه فوت قصاص اخيه بما استوفاه من قصاص نفسه، بخلاف قتل الاجنبي، فانه ظلم محض لا استيفاء فيه، فان جعلناه علي الجاني، اخذ من تركته ورجع ورثة الجاني بذلك علي الاخ القاتل، وان جعلناه علي الاخ القاتل، اخذ من تركته، وليس له طلبه من تركة الجاني؛ لان الاخ القاتل قد استوفي حقه من القصاص، فلا يجمع بينه وبين المال.
 وان قتله بعد عفو اخيه، فان علم بالعفو فقولان مرتبان: ان عللنا باشتراكهما في القصاص فقد زالت الشركة بالعفو، وان عللنا بشبهة الخلاف فهي باقية. وان لم يعلم بالعفو، فان لم نوجب القصاص اذا علم لم نوجبه اذا جهل، وان اوجبناه ثم فها هنا قولان؛ كالقولين فيمن قتل من عهده مرتدا ثم بان انه اسلم.

  AUTO   قاعدة

 :
 قال ابو محمد: اذا اختلف العلماء في العقوبة، لم يدراها الخلاف،   سواء كانت لله او للعباد، وان اختلفوا في سبب العقوبة، فان كانت لله فالمذهب انه يدرءها الخلاف كالحد في نكاح المتعة، وان كانت للعباد كالقصاص في مسالتنا فقولان.
 * * *



  AUTO   باب القصاص بغير السيف

 اذا قتل انسانا بسبب فلوليه ان يقتله بمثله ما لم يكن فاحشة، وله ان يضرب عنقه، فان ضرب العنق اوحي اسباب القتل، فاذا قتل بتغريق، او تحريق، او القاء من شاهق، او وقذ، او موالاة بضرب بالمثقلات، او تجويع، او تعطيش، فعل به ما قد فعل بشرط ان يتماثل الفعلان في القدر والزمان، فيقتل بمثل ناره التي قتل بها، وكلما عظمت النار كان اوحي لها، ويضرب بمثل الالة التي ضرب بها علي عدد الضربات.
 ويردي من مثل مسافة ترديته وعلي صلابة موقعها، ويجوع كمدة تجويعه.
 فان فعل به مثل ما فعل، فلم يمت، فان كان ضرب العنق اهون عليه عدل اليه عند الجمهور، وعلي قول: يستمر علي مثل ما فعل، وان كان ابقاءه في مثل ما فعل اهون من ضرب العنق، فان كان الفعل متواصلا كالجوع والعطش والالقاء في النار فهل يبقي، او تضرب عنقه فيه وجهان، وان كان منقطعا، فان كان ضربا عدل الي السيف عند الاكثرين، واجراه ابو محمد علي الخلاف.



 وان كان جرحا، فان كان مما يتعلق به القصاص بتقدير الاندمال كقطع الاطراف عدل الي السيف اتفاقا، وان لم يتعلق به القود كالجاءف ففي العدول الي ضرب العنق قولان، فان قلنا: لا يجب العدول اليه، لم يزد علي جواءفه علي الاصح، وابعد من خرجه علي الخلاف في الضربات.

  AUTO   فرع

 :
 اذا قتل ضعيفا بضربات، يعلم او يظن ان الجاني لا يموت بمثلها، وقلنا: يعدل الي السيف اذا فعل به مثل ما فعل، عدل الي السيف ها هنا، ولم يفعل به مثل ما فعل، علي ما قطع به الامام، فانه ايسر طريقا في الاستيفاء.
 وليس كل جناية مقابلة بمثلها، ولو قتل باللواط او سقي الخمر، قتل بالسيف ولم يفعل به مثل ما فعل، وقال الاصطخري: يولج في اللاءط خشبة بقدر الالة، وفي الخمر يسقي الماء.
 وقال الامام: ان ظننا انه يهلك بتلك الالة فعلنا، والا فلا.

  AUTO   فرع

 :
 اذا قتل بالخنق جاز العدول الي السيف عند ابي محمد، ورمز الي خلافه.

  AUTO   فرع

 :
 اذا قتل بالنار، فالقي في مثلها وبقدر زمانها فلم يمت، فان كان السيف اوحي فاراد الولي او الجاني البقاء في النار، لم يجز، وان تراضيا بذلك لم يجز علي الاظهر؛ لان تحريم المثلة حق لله، وان كان بقاءه في النار اهون   بان يطول عناءه باخراجه منها، ولو بقي فيها تعجل هلاكه، فهل للولي ان يخرجه لضرب عنقه، فيه وجهان، ولا يتجه الاخراج الا اذا كان ضرب العنق اوحي واسرع، فان استوت المدتان، او كان الابقاء اوحي، فلا وجه للاخراج، وقال ابو محمد: ضرب العنق اوحي جهات القتل بكل حال.

  AUTO   فرع

 :
 اذا قطع يدي انسان فسرت الي نفسه، فقطعنا يديه، فطلب ان نمهله مثل مدة السراية، لم نجبه الي ذلك، فان امهله الولي، فقال: اقتلني لاستريح او اعف عني، لم تلزمه اجابته.
 * * *



  AUTO   باب القصاص في الشجاج والجراح والاسنان وغير ذلك

 الجناية علي الاطراف ضربان: قطع يبين، وجرح يشق، وهو ضربان: احدهما الشجاج، ومحلها الوجه والراس (¬)، والثاني جراح ساءر البدن، فجواءفها لا قصاص فيها اتفاقا، ولا فيما ينتهي الي عظم، واما ما يصل الي العظم فلا قصاص فيه خلافا للعراقيين، وواجبه الحكومة اتفاقا.
 واما الشجاج فعشرة:
 الخارصة: الشاقة للجلد.
 والدامية: المسيلة للدم.
 والباضعة: القاطعة للحم.
 والمتلاحمة: الغاءصة في اللحم غوصا بالغا.
 والسمحاق: التي تبقي بينها وبين العظم جلدة ولا تقطعها.
 والموضحة: الواصلة الي العظم.
 والهاشمة: التي تهشمه.



 والمنقلة: التي تكسره وتنقل القطع عن اماكنها.
 والمامومة والامة: التي تبلغ ام الراس ولا تخرق الخريطة.
 والدامغة: التي تخرق الخريطة فتصل الي الدماغ، وهي مذففة.
 ومحل هذه الشجاج الراس والوجه وقصبة الانف واللحيان، وكل ما يصل الي الفم: فهل يثبت فيه ارش الجاءفة (¬) وحكمها؟ فيه وجهان اجراهما ابو محمد في خرق الاجفان.
 * * *

  AUTO   فصل في قصاص الشجاج

 يجب القصاص في الموضحة اتفاقا، ولا يجب في الخارصة والمنقلة والهاشمة، وكذا الدامية عند القفال، وتردد فيها ابو محمد، وفي الباضعة والمتلاحمة والسمحاق قولان اجراهما صاحب "التقريب" في قطع بعض اليد والرجل من غير ابانة، وهذا لا يصح؛ لتناسب اجزاء الراس واختلاف اليد والرجل في وضع العروق والاعصاب.
 وان قطع بعض الاذن او بعض المارن من غير ابانة، وجب القصاص علي الاصح.



 واذا جعلنا الجرح النافذ الي الفم جاءفة ففيه القصاص؛ لانه منضبط، وشبب بعض الاصحاب بخلاف.
 ولا يتصور اجراء القصاص في المتلاحمة الا بان يكون علي راس الجاني والمجني عليه موضحتان طريتان، ليتعرف بهما سمك اللحم، فيقع القصاص فيها باعتبار النسبة دون عمق الجرح، فاذا كان لحم راس الجاني سمك شعيرة ولحم المجني عليه سمك شعيرتين، وعمق الجناية قدر شعيرة، اقتص بنصف شعيرة، فان جهلنا النسبة اقتص من المستيقن وتوقف في محل الشك.
 * * *

  AUTO   فصل في كيفية قصاص الموضحة

 اذا وصلت الجراحة الي العظم وجب القصاص الكامل، سواء ان كانت صغيرة كمغرز الابرة، او مستوعبة للراس، بشرط ان لا نزيد علي مساحة الجناية ولا نتعدي محلها من الوجه او الراس.
 ولا يشترط ان يظهر العظم للابصار، ولا يبالي بتفاوت سمك اللحمين اتفاقا، كما لا يبالي بتفاوت الاعضاء في الصغير والكبير، وغلط من شرط تساوي السمك، فان ضاق المحل عن قدر الجناية لم يكمل ايضاح الراس بالوجه، ولا ايضاح الوجه بالراس، ويكمل ايضاح الناصية ببقية اجزاء الراس.
 فان استوعبت الجناية راس المجني عليه، فان كان راس الجاني اصغر لم يكمل بالوجه اتفاقا، بل يرجع بجزء من الارش، وان كان راسه اكبر اقتص منه بقدر جنايته، وهل يبتدء بالقصاص من حيث بدا او يتخير   الجاني والمجني عليه؟ فيه ثلاثة اوجه.
 ولو كان بعض راسه موضحا، وبقيته بقدر راسي المجني عليه، اوضحت بقيته من غير خيار.
 وان اوضح وهشم اقتص في الموضحة وحدها؛ لتعذر القصاص في كسر العظام، ولا يقتص في الايضاح وقطع الاطراف الا بالحديد، سواء وقعت الجناية بمثقل او محدد.
 * * *

  AUTO   فصل في تعدد الموضحة واتحادها

 ارش الموضحة من كل دية نصف عشرها، ويتعدد الارش بتعدد الايضاح، ويتحد باتحاده، فيجب في المستوعبة للراس مثل ما يجب في مغرز الابرة.
 فان اوضحه داءرة في وسطها حاجز في الظاهر والباطن، لزمه اروش بعددهن، وان اتصلن في الظاهر دون الباطن اتحد الارش علي المذهب، وفيه وجه، وان اتصلن بالعظم في الباطن دون الظاهر، فتاكلت الحواجز بالسراية، اتحد الارش.
 وان ازال الحواجز اجنبي قبل الاندمال، فعلي الاول اروش موضحاته، وعلي الثاني ارش كامل لكل حاجز، وان ازالها الاول قبل الاندمال، كان كمن قطع يد رجل ثم قتله، فيتحد الارش عند الشافعي، وعند ابن سريج يتنزل منزلة الاجنبي.



 ولو اوضح الناصية، فزادها ثان ثم ثالث ثم رابع ثم خامس، وهكذا الي ان اكملها مءة جان، فعلي كل واحد ارش كامل.

  AUTO   فرع

 :
 اذا زاد المقتص في الايضاح، فان تعمد وجب القود، وان اخطا فالاصح وجوب ارش كامل فيما زاد؛ لان اختلاف الحكم كتعدد الجاني، وقيل: يوزع الارش عليهما، ويلزمه ما يقابل الخطا، وان اوضح خطا واتمه عمدا فلا نعرف خلافا في وجوب القود.

  AUTO   فرع

 :
 اذا طلب القصاص في بعض الموضحة لياخذ ارش ما بقي، فهل له ذلك؟ فيه وجهان؛ لان الجرح متحد بخلاف نظيره في الاصابع، ولو قال: عفوت عن نصف الايضاح، ففي سقوط القصاص في الجميع الوجهان: ان نظرنا الي الاتحاد سقط، والا فلا.

  AUTO   فرع

 :
 قال الاصحاب: اذا نفذ الجرح من الوجنة الي الفم، ولم نجعله جاءفة، ففي جروح الوجنة ارش منقلة و [زيادة] حكومة لاجل النفوذ، وفي جرح الخد ارش متلاحمة وزيادة [حكومة] (¬) للنفوذ، وشرط ابو محمد ان ينقص عن ارش موضحة.
 ويجب الحكومة في الباضعة والمتلاحمة والسمحاق ان لم نوجب فيها   القصاص، وان اوجبناه نسب ارشها الي الموضحة واخذ بحسابه.

  AUTO   فرع

 :
 اذا اشترك جماعة في الايضاح في التحامل علي الة واحدة حتي استوعبوا الراس، فهل يجب علي كل واحد ارش، او يجب علي الجميع ارش واحد؟ فيه احتمال، ويحتمل ان يوضح من راس كل واحد منهم بالحساب، لان القصاص يجري في بعض الموضحة بخلاف اليد، ويحتمل ان يستوعب رءوسهم بالايضاح اذا سادت راس المجني عليه كما تءخذ ايديهم بيده.
 * * *

  AUTO   فصل في ما يجب فيه القصاص من المفاصل والاعضاء

 يجب القصاص في كل ما يمكن فيه المساواة من المفاصل والاعضاء، فلا يجب في فلقة من الفخذ او الساق، ولا في الجواءف وكسر العظام، ويشترط اتفاق العضو في المحل والاسم، فلا تءخذ يسري بيمني، ولا خنصر بابهام، فمن المفاصل: الانامل، والاصابع، والاكف، والمرافق، والاكتاف، والافخاذ، والركب، والاقدام.
 وغلط من منع القصاص في المرافق، ولعله نظر الي تداخل العظمين، فيجب طرد ذلك في الركبتين.
 ومن اعضاء القصاص: المارن (¬)، والاجفان، والاذنان، والشفتان،   والذكر، والانثيان، والشفران، وكذا العجيزة علي اظهر الوجهين.

  AUTO   فرع

 :
 اذا قطعت فلقة من المارن او الاذن او الحشفة او اللسان، وعرفت نسبتها بالجزءية الي ما بقي، وجب فيها القود، ولا تخرج علي الخلاف في المتلاحمة لسهولة ضبطها.

  AUTO   فرع

 :
 اذا قطع الرجل من الحقو، او اليد من الكتف، من غير اجافة فيهما، فان غلب علي الظن ان ذلك وفاق والغالب من مثله الاجافة، فلا قود فيه، ولو قطعهما فاجاف، وقال اهل البصر: يمكن قطعهما مع الاقتصار علي مثل تلك الاجافة، وجب قطعهما عند الاصحاب، فان الاجافة ها هنا تبع غير مقصودة بالقصاص، وقطع ابو محمد بنفي القصاص، اذ لا قصاص في الجواءف، وان حصلت برفع الطبقات من غير تغويص حديدة.
 * * *

  AUTO   فصل في السراية الي اللطاءف والاطراف

 اذا جني علي بعض عضو، فتاكل باقيه بالسراية، فلا قصاص فيما تاكل، ولو زال البصر بالايضاح وجب القصاص في البصر والايضاح، فقيل: فيهما قولان بالنقل والتخريج، والمذهب الذي عليه الجمهور: تقرير النصين، فان تاكل الاعضاء لا يقصد بالسراية، بخلاف اللطاءف، فعلي هذا: اذا زال البصر بالايضاح، فاوضحناه، فزال البصر، حصل القصاص، وان لم يزل   البصر وامكن ازالته من غير افساد الحدقة ازلناه.
 والسمع كالبصر عند الاصحاب، ويليهما الكلام عند الاصحاب، وفي العقل وبطش الاعضاء الباطشة خلاف؛ لبعد تناولها بالسراية، ورتب الامام العقل علي البطش، والبطش علي الكلام.

  AUTO   فرع

 :
 اذا اوضح رجلا فزال شعره وبصره، فاوضحناه فذهب شعره وبصره، حصل القصاص بذلك علي ما نقله المزني، فمن الاصحاب من غلطه في النقل في الشعر؛ اذ لا قصاص فيه بحال، وذكر اخرون قولين، وقالوا: ما يجب القصاص فيه بالسراية يحصل القصاص فيه بالسراية، وما لا يجب القصاص فيه بالسراية ففي حصول القصاص فيه بالسراية قولان يجريان فيما لو قطع يد انسان، فقطع المجني عليه اصبع الجاني، فسرت الي كفه، ففي حصول القصاص بهذه السراية قولان.
 وقطع الامام بحصوله، فان اليد من اعضاء القصاص، والسراية منسوبة الي فعله، بخلاف الشعر فانه ليس من اعضاء القصاص.
 ثم قال: الوجه ان يقال: كل عضو يجب فيه القصاص فتاكله بالسراية قصاص (¬)، وكل ما لا قصاص فيه اذا قوبل بمثله فلا يقع الجرح فيه بالجرح ولا التاكل بالتاكل، وان سري الجرح الموجب للقصاص الي ما لا قصاص   فيه كالشعر ففيه الخلاف، فان قلنا: لا يحصل القصاص اذا تاكلت اليد بقطع الاصبع، كان التاكل هدرا والجاني في عهدة جنايته الا قدر الاصبع، واهدار يده مع التعدي بقطع اصبعه مشكل.
 ويمكن ان يقال: لا اثر للتعدي بقطع الاصبع، فان اليد مستحقة للمجني عليه، فاشبه من استحق النفس فتعدي بقطع الاطراف.
 ولو قتل انسانا، فضربه الولي بسوط خفيف، فمات، حصل القصاص عند الامام؛ اذ لا يتجه ضمان نفس الجاني مع انها مستحقة للولي، ويعسر اهدار دمه مع بقاء الضمان عليه، ويجب تخريجه علي مقتضي ما ذكره الاصحاب علي القولين، فان ضرب السوط لا يقصد به القتل ولا يجب به القصاص، كما لا يقصد الطرف بالسراية، ولو رمي الولي الجاني مخطءا حصل القصاص من غير محل خلاف.
 * * *

  AUTO   فصل في شلل الاعضاء

 يشترط في قصاص الاعضاء ان يكون الجاني ممن يقتل بالمجني عليه، وان يستوي العضوان في الخلقة والسلامة، وان تكون نسبة عضو كل واحد منهما كنسبة عضو الاخر الي نفسه، ولا نظر الي تفاوت البدل، فتقطع يد الرجل بيد المراة؛ لان نسبة كل واحد منهما الي النفس بالنصف.
 وان اختلفت النسبتان امتنع القصاص، فلا تءخذ كاملة بناقصة ولا صحيحة بشلاء وان رضي الجاني بذلك؛ لحق الله في الدنيا.



 فان بادر المجني عليه فقطع كاملة الاصابع بناقصة الاصابع، حصل القصاص فيما تساويا فيه من الاصابع، وان قطع الصحيحة بالشلاء، لم يحصل القصاص، كما لو قتل الحر بالعبد او المسلم بالكافر.

  AUTO   فرع

 :
 قال الفقهاء: اذا كانت يد الجاني شلاء، فان خيف من نزف الدم لم تءخذ بالصحيحة، وان لم يخف ذلك، فان رضي المجني عليه بها فله قطعها ولا ارش له اتفاقا، كما لو قتل العبد بالحر والذمي بالمسلم.

  AUTO   فرع

 :
 وتءخذ الشلاء بالشلاء، الا ان يكون الشلل في يد المجني عليه اظهر، فلا يجب القصاص اتفاقا؛ لتفاوت النسبتين.
 وحمل الامام تفاوت العضوين في الشلل علي نضارة العضو وحسنه وقبحه، فان الشلل زوال اصل الحركة، وشرط فيه ابو محمد زوال الحس، وخالفه الامام وجوز بقاء اصل الحس، وليس الشلل موت العضو ولا رعشته.

  AUTO   فرع

 :
 اذا تفاوتت اليدان في البطش اخذت احداهما بالاخري لتساوي النسبة، فتقطع يد الشاب الايد بيد الشيخ الهرم، وان نقص بطش المجني عليه وكمل بطش الجاني، فان كان ذلك بافة قطعت يد الجاني وكملت الدية.
 وقال ابو محمد: اذا لم يبق الا ادني حركة لم يءخذ بها الباطشة. ولا اصل لما قال.



 وان كان النقص بجناية لم تقطع يد الجاني، وكذلك لا تكمل ديتها علي الاصح، وشبه الفقهاء الصورتين بمن وصل الي حركة المذبوح بجناية او افة ثم جني عليه.
 * * *

  AUTO   فصل في زيادة الاعضاء ونقصها

 ويءخذ الزاءد بالزاءد اتفاقا بشرط تساوي الوصف والمحل، فان اختلف المحل فكانت احدي الاصبعين علي الخنصر، والاخري علي البهام (¬)، فلا قصاص، وان اختلفا في الصغري والكبري والطول والقصر، فوجهان خصهما الامام بما لو استوت الحكومتان او لم يكن لواحدة منهما حكومة، فان تفاوت الحكومة يقتضي تفاوت النسبة، ووجه المنع عند استواء الحكومة: ان العضوين زاءدان، فتعين تساويهما في الصورة، بخلاف الاعضاء الاصلية، فان اجرينا الخلاف مع تفاوت النسبة فهو جار مع تفاوت الالوان وغيرها من الاوصاف، وان شرطنا التساوي في النسبة فلا نظر الي الالوان، بخلاف تفاوت الاجرام.
 * * *

  AUTO   فصل في قطع اليد من المفاصل وغيرها

 اذا قطع اليد من نصف الساعد فللمجني عليه قطع الكوع وحكومة نصف الساعد؛ لعجزه عن محل القصاص، وليس له قطع الاصابع لقدرته   علي قطع الكوع، فلو قطع الجاني الكوع، وكانت اصابعه ناقصة، قطعت يده وعليه ارش ما نقص، وان نقصت اصابع المجني عليه لم يقطع كوع الجاني، وقطع من اصابعه بعدد اصابع المجني عليه لعجزنا عن محل الجناية.
 ولو قطعه الجاني من نصف العضد او المنكب، وخيفت الاجافة، فللمجني عليه قطع المرفق وحكومة الزيادة، وهل له ترك المرفق وقطع الكوع؟ فيه وجهان، فان قطع المرفق فله حكومة الساعد ان منعنا قطع الكوع، وان اخترناه فوجهان.
 وان قطع الجاني المرفق لم يكن للمجني عليه قطع الكوع، بل لو قنع بانملة واحدة عن جميع اليد لم نجبه الي ذلك، فانا لا نعدل عن محل القصاص مع الامكان، فان قطع الكوع فقد اساء، وسقط حقه من قطع المرفق وحكومة الساعد علي ما ذكره الاصحاب.
 * * *

  AUTO   فصل في شلل بعض الاصابع

 اذا قطع يد انسان ولكل واحد منهما اصبعان شلاوان (¬)، فان اتفقتا قطعت يد الجاني، وان اختلفتا لم تقطع يده، وان اختص (¬) شلل الاصبعين بيد الجاني، فالمجني عليه مخير بين ان يقطع يده ولا ارش له، وبين ان يقطع اصابعه الثلاث ويرجع بارش اصبعيه، وهل يسقط ما يقابل الاصابع   المقطوعة من حكومة الكف؟ فيه وجهان، فان اسقطناه سقط ما يقابل الاصبعين من الحكومة، وكذا ان لم نسقطه علي الاصح، فان الحكومة مجانسة للدية، بخلاف القصاص.
 وان اختص شلل الاصبعين بيد المجني عليه، لم نقطع يد الجاني، وله قطع الاصابع السليمة وحكومة الشلاوين، وفي حكومة ما يقابل السليمة من الكف الوجهان، واما ما يقابل الشلاوين فان لم ندرجه تحت دية السليمة لم يندرج تحت حكومة الشلاوين، وكذا اذا ادرجناه علي الاصح، فان الدية اصل، فجاز ان تستتبع، بخلاف الحكومة.

  AUTO   فرع

 :
 اذا اختصت يد الجاني باصبع زاءدة لم تقطع يده، فان طلب المجني عليه دية الاصابع الخمس فلا حكومة للكف، وكذا ان طلب دية بعضهن علي الاظهر، وان اقتص في الخمس فلا حكومة للكف علي الاظهر؛ كوقوع القصاص في الجميع، وان اقتص في بعضهن، فوجهان مرتبان، فان جميع الاصابع تستتبع ما لا يستتبعه البعض، وكذلك تندرج حكومة الكف تحت دية الاصابع، وفي اندراج البعض تحت بعض الاصابع الخلاف. 
 * * *

  AUTO   فصل في تعجيل القصاص والمال قبل الاندمال

 اذا قطع اطراف انسان فله القصاص علي الفور، وابعد من اخره الي الاندمال، ولو قطعه في الشتاء، فطلب ان يقتص في حمارة القيظ، وقد يغلب   علي الظن هلاكه بذلك، فله التعجيل عند القفال، وان قطع اعضاءه وتخلل بين كل عضوين اندمال، فله ان يقطع اعضاءه علي الولاء.
 قلت: اذا غلب علي الظن هلاكه بالولاء او بالقصاص في القيظ، او كان الجاني مدنفا ضعيف القوي، فينبغي ان يءخر القصاص، فانا نسقطه في اليد الشلاء اذا خيف نزف الدم، وفي الكتف والفخذ اذا خيفت الاجافة، فكان تاخيره ها هنا بالجواز اولي من اسقاطه.
 ثم وان طلب تعجيل المال قبل الاندمال، فالنص انه لا يعجل، ولو جني علي مكاتبه عجل علي النص، وفي النصين طريقان:
 اصحهما: في التعجيل اقوال:
 احدها: لا يعجل شء، اذ لا نامن ان يشاركه غيره فيموت بالجراحات.
 والثاني: نعجل ديات الجميع، فان مات بالسراية استرجعنا ما زاد علي الدية.
 الثالث وهو الاظهر: تعجيل دية النفس فما دونها.
 والطريقة الثانية: تقرير النص والتفرقة بالتشوف الي العتق، وهل يختص ذلك بما يحصل العتق؟ فيه وجهان، فان قلنا به كان فيما عداه بمثابة الاحرار.

  AUTO   فرع

 :
 اذا كان الجراح موجبا للحكومة لم تعجل قبل الاندمال، وابعد من قال: تعجل اقل ما يمكن من الحكومة.
 * * *



  AUTO   فصل في تعليق الجناية لمن له ست اصابع

 اذا قطع يد انسان ولاحدهما ست اصابع، فلها حالان:
 احداهما: ان يعرف ان السادسة زاءدة، فان كانت يد المجني عليه قطعت يد الجاني، فيلزمه حكومة الزاءدة، وان كانت علي يد الجاني، فان مالت عن منابت الاصليات، فلا حكومة للكف علي الاظهر، او كانت علي منابتها وامكن قطع الاصليات دونها، قطعت الاصليات ولا حكومة للكف علي الاظهر، وان ادي قطع بعض الاصليات الي فساد الزاءدة لم يقطع ما يءدي الي فسادها.
 الثانية: ان تلتبس السادسة بالاصليات، فلها حالان:
 احداهما: ان يحكم اهل الخبرة بان السادسة اصلية، وان الطبيعة قسمت مادة الاصابع علي الست مع تساوي العمل والقوة، فيجب القصاص اتفاقا، فان كانت علي يد المجني عليه، قطعت يد الجاني ولزمه ارش السادسة، وان كانت علي يد الجاني، قطع من اصابعه خمس متواليات ولزمه سدس دية المجني عليه، ويحط منه شء بالاجتهاد، فان الخمس التي قطعت منه مشابهة لخمس من معتدل الخلقة.
 الثانية: ان يجهل اهل الخبرة كون السادسة اصلية او زاءدة، فان كانت علي يد الجاني لم تقطع من الكوع، ولا يقطع شء من اصابعه اتفاقا خوفا من اخذ الزاءد بالاصلي، فان بدر المجني عليه فقطع خمسا، فقد استوفي حقه ولا ارش له؛ لجواز ان يكون قد استوفي خمسا اصليات، ولا حكومة   للكف علي الاظهر.
 * * *

  AUTO   فصل في زيادة الانامل

 اذا كان لاصبع الجاني اربع انامل، فللانملة الزاءدة حالان:
 الاولي: ان لا يزيد اصبعها علي طول الاصابع، فان قطع انملة معتدل قطعت انملته ولزمه ما بين الثلث والربع من دية الاصبع، وان قطع انملتين قطعت انملتيه ولزمه سدس دية الاصبع، وان قطع اصبعا اقتصرنا علي قطع اصبعه، فان اربعة الارباع معادلة لثلاثة الاثلاث، وابعد من منع ذلك مع موافقته علي ان في كل انملة ربع دية الاصبع.
 وان قطع المعتدل انملة من الاربع، لم تقطع انملته، وان قطع انملتين قطعت انملته واخذ منه سدس دية الاصبع، وان قطع ثلاثة قطعت انملتاه ولزمه نصف سدس دية الاصبع، فان قطع الاربع اكتفي باصبعه.
 والحال الثانية: ان يزيد طول اصبعها علي ساءر الاصابع، فالانملة الرابعة كالاصبع السادسة، فان ظهرت زيادتها بضعف او استحشاف، لم تقطع باصبع معتدلة، وفيها دية اصبع وحكومة لاجل الانملة، وان ساوت ساءر الانامل في القوة والعمل، فالانامل الاربع كالاصابع الاربع التي قسمتها المادة الاصلية ستة اقسام، ففي كل انملة ربع دية اصبع وزيادة؛ كما يجب في احدي الاصابع الست سدس دية اليد وزيادة، وتءخذ انملته بانملة المعتدل، ولا يءخذ اصبعه باصبع معتدل، بل يقطع منها ثلاث انامل ويرجع المعتدل بزيادة.



 وان كان للاصبع ثلاث انامل متساوية في القوة والعمل، ولكنها اقصر من بقية الاصابع، ففيها ارش كامل، وان كانت اطول منهن فالوجه ان يزاد شء لاجل الطول.
 وان كان لاصبعه المساوية لساءر اصابعه انملتان، فلا نقل في هذه الصورة، والاظهر: ان في كل انملة نصف دية الاصبع، ويحتمل ان يحكم بنقصان انملة.
 وان لم يكن للاصبع مفصل فالظاهر عند الامام تنقيص ديتها لفوات منفعة الانثناء بالقبض والاحتواء.
 * * *

  AUTO   فصل في كفين علي ساعد وانملتين علي اصبع ورجلين علي ساق

 اذا كان علي راس اصبع انملتان احداهما مستديرة عاملة والاخري زاءدة ماءلة، ففي المستديرة ارش انملة، وفي الزاءدة حكومة، وتءخذ المستديرة بانملة المعتدل، ولا شء له، وكذلك تءخذ بها انملة المعتدل.
 وان لم تتميز احداهما عن الاخري لاستواءهما في الانتصاب والعمل، فهما كالاصابع الست الاصلية، فلا نقطع انملة المعتدل باحداهما وان قطعها المعتدل قطعت انملته وعليه حكومة لزيادة الخلقة، ولا تقطعان بانملة المعتدل، بل تقطع احداهما مع زيادة ارش، ويجب تنقيص الارش عند الامام عن نصف ارش الانملة المعتدلة، والخيرة في تعيين الانملة المقطوعة الي الجاني عند الامام، لانه مستحق لاحداهما علي سبيل البدل.



 وان كان علي راس الانملة الوسطي عظم عليه الانملتان، فان لم يكن لواحدة منهما مفصل فلا قصاص؛ لتعذره في العظام، وان كان لكل واحد منهما مفصل، فهذه اصبع ذات خمس انامل انقسمت علياهن باثنتين.
 وحكم قدمين علي ساق، وكفين علي معصم، كحكم انملتين علي اصبع ان استوتا، ففيهما نصف الدية وزيادة كما ان في الانملتين ثلث دية الاصبع وزيادة.
 * * *

  AUTO   فصل في اخذ المال عند تعذر القصاص

 اذا ثبت القصاص لمجنون لم يجز لوليه ان يقتص، وله اخذ المال علي النص، وفيه قول مخرج، وعلي النص: لو اخذه فافاق المجنون ففي رده وثبوت القصاص خلاف مشهور.
 ولو قطع من انسان انملة مسبحته العليا، وقطع من اخر انملة مسبحته الوسطي ولا عليا للثاني، لم يقتص صاحب الوسطي حتي تسقط عليا الجاني بقصاص او غيره، فله القصاص حينءذ، فان عفا مع بقاء عليا الجاني، اخذ ارش الوسطي، وان لم يعف ففي اخذ الارش للحيلولة وجهان، فان اخذه فسقطت العليا: فهل له ان يرده ويطلب القصاص؟ فيه وجهان؟
 وان اخذه من غير عفو ففي سقوط القصاص وجهان بناهما الامام علي الخلاف في طلب المال، وقال: ان لم يثبت الطلب سقط القصاص باخذ المال.
 وان عفا صاحب العليا التحقت هذه الصورة بمسالة المجنون، فان   زوال العليا لا امد له، فاشبه الجنون، وان لم يعف فينبغي ان ترتب علي مسالة الجنون، فان الظاهر من صاحب العليا الاستيفاء، وليس زوال الجنون كذلك.
 وان وجب القصاص لصبي، او وجب علي حامل، لم يءخذ المال للحيلولة؛ لان الامد معلوم بخلاف الجنون وزوال العليا، وقال ابو بكر: ينبغي ان يخرج علي الخلاف في الانملة.

  AUTO   فرع

 :
 اذا قطع الانملة الوسطي ممن لا عليا له، فزالت انملة الجاني العليا، فقد تردد القفال في ثبوت القصاص، بخلاف المسالة السابقة، فان استحقاق العليا بمثابة قطعها، بخلاف الحمل، فانه عارض علي الخلقة، فلم يمنع القصاص بعد الوضع.
 ولو قطع يدا شلاء فشلت يده بعد ذلك، لم يجب القصاص، اذ لا عبرة بالمكافاة بعد الجناية، كما لو قتل الحر الذمي عبدا ذميا ثم نقض العهد وارق، وقد تردد القفال في مسالة الشلل ثم قطع بنفي القصاص.
 * * *

  AUTO   فصل في ابانة الاذن او بعضها

 اذا ابان قطعة من الاذن نسبت الي ما بقي، فان كانت نصفا او ثلثا اقتص بمثل تلك النسبة اتفاقا، وان قطع البعض ولم يبنه وجب القصاص علي الاصح، فان التصقت فابانها اخر، اقتص منه عند القفال.
 ولو قطعها الجاني الا جلدة، فقد قطع الاصحاب بانا نقطع اذنه الا   جلدة، فان التحمت ايجب ازالتها (¬)، وان قطعت بعد ذلك وجب القصاص بقطعها.
 وان ابانها، فالتحمت في حرارة الدم، وجب ازالتها لاجل الصلاة ان لم يخف، وان خاف فوجهان؛ لانها نجسة علي راي، او لان الدم قد ثبت له حكم النجاسة بظهوره، فوجبت ازالته، فان اوجبنا ازالتها لم يجب القصاص بقطعها، وان لم نوجب ازالتها، فقطعها انسان، فسرت الي النفس، وجب القصاص في النفس عند المحققين، ويحتمل ان يجعل الخلاف في وجوب الازالة شبهة في درء القصاص، كما لو بادر احد الوليين فقتل الجاني.

  AUTO   فرع

 :
 للعراقيين: تءخذ الاذن الصحيحة بالمثقوبة ان لم يشنها الثقب، ولا تءخذ صحيحة بمخرومة قد زال بعضها بالخرم، بل يقطع منها بقدر ما يتساويا فيه علي الاصح، وتءخذ هذه المخرومة بالصحيحة مع قسط الارش، وان شان الخرم الاذن ولم يزل بعضها، فلا يءخذ بها صحيحة عند العراقيين، وخالفهم الامام، ولم يجروا ذلك في بقية الاعضاء، ولعلهم ظنوا ان الغرض الاظهر من الاذن الجمال، ولذلك قالوا بقطع اليد السليمة الاظفار (¬)؛ لان البطش هو الغرض الاظهر، وقال الشافعي: لا تءخذ يد   ذات اظفار بيد ليس لها اظفار. واستبعده الامام، وقال: يلزم عليه ان لا تكمل الدية في يد ليس لها اظفار، ولا يتجه استبعاده.
 * * *

  AUTO   فصل في الاختلاف في شلل الاعضاء

 اذا جني علي عضو وادعي شلله من اصل خلقته، فالقول قوله في نفي الدية والقصاص، وذكر بعضهم قولا ضعيفا: ان القول قول المجني عليه. وان ادعي شللا طارءا، فقولان يجريان فيمن قد ملفوفا وادعي انه كان ميتا، وابعد من فرق بين الملفوف في ثياب الاحياء والملفوف في صورة الاكفان.
 وان كان العضو باطنا فطريقان:
 احداهما: انه كالعضو الظاهر.
 والثانية: فيه القولان سواء اتفقا علي اصل السلامة او اختلفا في ذلك.
 فان تنازعا في وجاء الانثيين، فعلي الخلاف في الاعضاء الظاهرة، وان ادعي، عليه بقطع الذكر والانثيين، فاعترف بقطع احدهما، فالقول قوله، وكذلك لو انكر وجود العضو من اصل الخلقة، او اعترف (¬) بانه كان فبان [بسبب اخر] (¬)، فانه اذا انكر وجوده كان منكرا لاصل الجناية.
 فاما العضو الباطن فقد رمزوا فيه الي وجهين:
 اظهرهما: انه الذي يعتاد ستره للمروءة.



 والثاني: العورة التي يجب سترها عن الاعين.
 * * *

  AUTO   فصل في الجناية علي الانف المجذوم

 يءخذ الانف الصحيح بالمجذوم وما بقيت فيه حياة وان اسود ويءس من بروءه، وكذلك حكم ساءر الامراض، بخلاف شلل اليد فانه يسقط منفعتها ولا تسقط منفعة الانف بالجذام، ولهذا ذكروا في تكميل الدية في الانف المستخشف والاذن المستخشفة وجهين، والاستخشاف: موت العضو.
 ولا يءخذ انف صحيح بانف سقط بعضه بجذام او غيره، وان سقط من انف الجاني والمجني عليه جزءان متساويان في النسبة والمحل، او سقط من ايديهما اصبعان متساويتان، وجب القصاص فيما بقي، سواء كان السقوط بجناية او جذام، او سقط من الجاني بجناية، ومن المجني عليه بجذام.

  AUTO   فرع

 :
 لا يختلف حكم العضو بسقوط منفعة في غيره وان كان طريقا اليها، فيءخذ انف المدرك واذن السميع بانف الاخشم واذن الاصم.
 وقال الاءمة: الخصيتان بالنسبة الي المني كالاذن بالنسبة الي السمع، فان كسر فقار انسان فابطل المشي والماء، وجب ديتان علي الاصح، فان الماء لا يختص بالفقار.
 * * *



  AUTO   فصل فيمن طلب الجاني اخراج اليمين فاخرج اليسار

 نقدم علي ذلك: ان من قال لانسان: ابحني يدك، او: اخرجها اقطعها، او: مكني من قطعها، فاخرجها، فقطعها، فلا ضمان علي القاطع، وان قصد قطع يد انسان، وحرمنا الاستسلام، فسكت من غير دهش و [ ... ] (¬)، ففي الحاق السكوت بالاباحة وجهان.
 وان طاوعت المراة علي الزنا: فهل يسقط مهرها للاباحة، او لعدم حرمة الوطء؟ فيه خلاف مبني عليه الخلاف في مهر الامة الزانية.
 فاذا قال المقتص للجاني: اخرج يمينك، فاخرج اليسار، فقطعها، فللجاني احوال:
 الاولي: ان يقول: قصدت الاباحة، فيسال القاطع عن قصده، فان قال: قصدت الاستباحة، فلا خلاف في بقاء القصاص في اليمين واهدار اليسار، وبهذا يسقط قول من شرط التلفظ في تقديم الطعام للضيفان.
 وان قال القاطع: دهشت، فلا قصاص في اليسار، وفي سقوط قصاص اليمين خلاف، وقطع القاضي بالسقوط، وهذا الخلاف مرتب علي الخلاف فيما اذا احضر الجاني الدية، وسال الولي ان ياخذها ويعفو عن القصاص، ففي سقوط القصاص بمجرد اخذها خلاف، فان اخذ الدية عن القصاص جاءز، ولا يجوز ان يعتاض عن اليمين باليسار.
 وان قال: علمت انها لا تءخذ عن اليسار، ولكن جعلتها عوضا من   تلقاء نفسي، فلا قصاص في اليسار، ولا يسقط قصاص اليمين عند القاضي، وخرجه الامام علي الخلاف، وجعله اولي بالاسقاط.
 الحال الثانية: للجاني ان يقول: دهشت، فيراجع القاطع، فان قال: دهشت، او قال: علمت وتعمدت قطع اليسار، فلا يسقط قصاص اليمين، ويجب القصاص في اليسار، وان قال: ظننت انها تجزء عن اليمين، او علمت انها لا تجزء فجعلتها عوضا من تلقاء نفسي، فلا قصاص في اليسار وفي قصاص اليمني الخلاف السابق، والوجه ايجاب دية اليسار، وان قال: ظننت المخرج يمينا (¬) فلا يسقط قصاصها، وفي قصاص اليسار قولان طردهما الامام فيما اذا قال: ظننت ان اليسار تجزء عن اليمين، واصلهما القولان فيمن قتل من يظنه قاتل ابيه.
 الحال الثالثة: للجاني ان يقول: قصدت بالاخراج ايقاعها عن اليمين، فيراجع القاطع، فان قال: ظننت انها تجزء عن اليمين، فقصاص اليمين علي الخلاف، واولي بالسقوط؛ لان اتفاق القصدين كمعاوضة فاسدة، فان اسقطنا القصاص فالوجه القطع بايجاب الدية، فانه لم يقصد الاباحة بالاخراج، ولا قصاص في اليسار ان اسقطنا قصاص اليمين، وكذا ان لم نسقطه علي الاصح، فانه سلط علي القطع، وان قال: ظننت المخرج يمينا، فلا قصاص في اليسار اتفاقا، وفي ضمان ديتها للعراقيين وجهان.
 وحيث حكمنا ببقاء القصاص في اليمين، فليس استيفاءها في الحال؛ خوفا من الهلاك، مع ان احد الجرحين غير مستحق، وعلي قول مخرج: له   الاستيفاء في الحال، ولو قطع اطراف انسان والينا عليه بالقطع، فان غلب علي الظن انه يهلك بالموالاة فلا نظر الي ذلك علي المذهب، وابعد من منع الموالاة، وقد ذكرت اشكال هذا فيما تقدم.

  AUTO   فرع

 :
 اذا قال الجلاد للسارق: اخرج يمينك اقطعها، فاخرج اليسار، فقطعها، وقالا: دهشنا، او قال السارق: ظننت انها تجزء عن اليمين، سقط قطع اليمين علي النص، وخرج قول بعيد: انه لا يسقط، لكن لا تقطع حتي تندمل اليسار اتفاقا، وان قال: علمت انها لا تجزء عن اليمين فغالطت الجلاد، فقال الجلاد: غلطت، ففيه القولان، واولي ببقاء القطع في اليمين، وان قالا: تعمدنا، فالوجه بقاء قطع اليمين، ويبقي النظر في قصاص اليسار لاجل البذل.
 ولا يجزء الاستبدال في حدود الله تعالي مع التعمد، ومن استحق قصاص طرف، فقطعه خطا، حصل القصاص.
 * * *

  AUTO   فصل في القتل المستند الي ظنون كاذبة

 اذا تعمد القتل علي ظن لو تحقق لما وجب القصاص، فظهر كذب الظن، فله احوال:
 الاولي: ان يحرم القتل ويبعد الظن، مثل ان يقتل من يظن انه قاتل ابيه ثم يظهر حياة ابيه، او يقتل من يظنه مرتدا فيظهر انه لم يرتد، فيجب القصاص اتفاقا والدية في ماله لبعد ظنه.



 الثانية: ان يجوز القتل في ظاهر الامر او يجب، مثل ان يقتل رجلا مع اهل الحرب علي زيهم في دار الاسلام او دار الحرب؛ ظنا انه منهم، فيظهر انه اسير مسلم، فلا قصاص عليه لعذره، وفي الدية قولان، فان قلنا: تجب، فهي علي القاتل، او علي عاقلته؟ فيه قولان، او رمي الي صف الكفار فمرق السهم فاصاب مسلما وراء الصف، فهذا قتيل السهم الغرب، فلا دية فيه ولا قصاص، وتجب الكفارة اتفاقا.
 الثالثة: ان يحرم القتل ولا يبعد الظن، كما لو قتل في دار الاسلام رجلا علي زي اهل الحرب يظن انه دخل خفية، او قتل في دار الاسلام او دار الحرب من يظنه قاتل ابيه، فظهر خلافه، او قتل من عهده مرتدا فظهر انه اسلم، فيجب الضمان، وفي القصاص قولان، فان اوجبناه فالدية علي الجاني، وان لم نوجبه فطريقان:
 احداهما: انها علي الجاني.
 والثانية: فيها القولان.
 الرابعة: ان يحرم القتل علي وجه لو تحقق الظن لما حل القتل في نفس الامر، مثل ان يقتل من عهده عبدا او ذميا بناء علي انه لا يقتل به، فيظهر الحرية والاسلام، فيجب الضمان، وفي القصاص قولان مرتبان علي القولين فيمن عهده مرتدا او ظن انه حربي دخل دار الاسلام، واولي بوجوب القصاص ممن ظنه حربيا، وفيهما مع من ظنه مرتدا وجهان:
 احدهما: انهما اولي بوجوب القصاص لعصمتهما واهدار المرتد.
 والثاني: المرتد اولي منهما، لبعد الظن فيه، اذ يبعد ابقاءه علي   الردة في دار الاسلام.
 واختلف المحققون في هذه الصور:
 فقال بعضهم: ان وقع التوافق فيها علي الظن ففيها التفصيل والخلاف السابق.
 وقال بعضهم: ان اتفقا علي وقوع الظن اثر، وانما الخلاف اذا اختلفا فيه، اذ لا يمكن معرفته الا من جهة الظان.
 * * *

  AUTO   فصل في الاختلاف في سراية القصاص

 اذا قطع يدي رجل او رجليه ومات، فاختلف الجاني والوارث، فلهما احوال:
 الاولي: ان يقول الجاني: مات بالسراية فلك دية، ويقول الوارث: مات بعد الاندمال فلي ديتان، فان طال الزمان الي حد يغلب في مثله الاندمال، فيصدق الوارث بيمينه اتفاقا، وان قصر الزمان فان علم انه لا يقع في مثله الاندمال فالقول قول الجاني بغير يمين، وان غلب علي الظن انه لا يقع فيه الاندمال صدق الجاني بيمينه اتفاقا.
 الثانية: ان يقول الجاني: مات بالسراية، فيقول الوارث: بل مات بسبب طار كالريح والتردي من مكان عال، فان امكنت السراية والاندمال، او امكنت السراية وتعذر الاندمال، فهل يصدق الوارث بيمينه من غير ان يثبت السبب؟ فيه لصاحب "التقريب" تردد واحتمال.



 وقال الصيدلاني: ان عين السبب ففيه تردد صاحب "التقريب"، وان ادعي السبب ولم يعينه لم يقبل قوله؛ لان ترك التعيين مشعر بعدم السبب.
 وان كان الاندمال ممكنا، فظاهر كلام الصيدلاني التخريج علي تردد صاحب "التقريب".
 الثالثة: ان يقول الوارث: مات بالسراية فلي القصاص في النفس، فيقول الجاني: مات بعد الاندمال، فان طال الزمان علي الشرط السابق فالقول قول الجاني، وان قصر علي الشرط المقدم فالقول قول الوارث، وان قال الجاني: مات بسبب طار، فان عينه ففيه تردد صاحب "التقريب"، وان لم يعينه ففيه كلام الصيدلاني، وحيث صدق مدعي الاندمال في الدية او القصاص، فقامت البينة ان المجني عليه لم يزل زمنا ضمنا لما به، فالقول (¬) قول منكر الاندمال.
 * * *

  AUTO   فصل في رفع الحاجز بين الموضحتين

 اذا اوضح موضحتين، فزال الحاجز بينهما، فقال الجاني: زال بالسراية فلك ارش موضحة، وقال المشجوج: بل ازاله غيرك، ففيه تردد صاحب "التقريب"، فان جعلنا القول قول المشجوج وجب ارشان لا غير، فان قال الجاني: انا رفعت الحاجز، فقال المشجوج: بل انا رفعته، وجب القطع   بتصديق المشجوج؛ لان السبب مذكور من الجانبين وقد اعترف بموضحتين، فان قال الجاني: انا رفعته قبل الاندمال، فقال المشجوج: بل بعد الاندمال، فان قصر الزمان اتحد الارش، وان طال وجب ارشان، وفي الثالث وجهان.

  AUTO   فرع

 :
 اذا قال جنيت وانا مجنون، فقال: بل كنت عاقلا، فهو كالقاذف اذا ادعي الجنون حال القذف، فان اقاما بينتين: فهل تقدم بينة الجنون، او يتعارضان؟ فيه وجهان فان قلنا بالتعارض والتهاتر فهو كاختلافهما في الجنون من غير بينة.

  AUTO   خاتمة

 :
 ينبغي للامام ان يحضر موضع القصاص عدلين خبيرين بمجاري الاحوال يتفقدان حديدة القصاص، فان خشيا ان تكون مسمومة بدلاها بما لا تهمة فيه.
 وينبغي للامام ان يرزق من يستوفي الحدود والقصاص من سهم المصالح العامة ان اتسع المال، وان ضاق فاجرة القصاص علي الجاني، وابعد من جعلها علي بيت المال، واجرة الحد علي المحدود، او علي بيت المال؟ فيه وجهان مشهوران، فان القصاص واجب علي الجاني، والحد لا يجب علي المحدود، ولذلك لا يلزمه اظهار موجب الحد، ولو هرب لسقط الحد، وماخذ الخلاف في القصاص: ان الواجب تحصيل القطع، او التمكين من القطع؟ كما في تسليم الثمار.
 وشبهه الامام بالخلاف في مءنة قطع الثمار اذا جعلناها من ضمان   الباءع، وعلي كلا الوجهين: اذا مات بعد التسليم وقبل القطع وجبت الدية، بخلاف تلف الثمار بعد التسليم.
 * * *



  AUTO   باب عفو المجني عليه ثم يموت

 اذا قال المالك لامر نفسه لانسان: اقطع يدي، فقطعها، فهي هدر، فان سرت الي بعض الاعضاء ثم اندملت، فالسراية هدر.
 وان قال: اقتلني، فقتله، لم يجب القصاص، وفي الدية قولان:
 احدهما: تثبت ارثا، فلا تجب ها هنا ولا يعتبر سقوطها من الثلث؛ لانه منع وجوبها باذنه ولم يسقطها بعد الوجوب، وعلي القاتل الكفارة، خلافا لابن سريج فانه جعلها تبعا لحق العبد.
 والثاني: تثبت للورثة ابتداء، فلا يءثر اذنه في حق غيره، وعلي القاتل الكفارة.
 وان قطع طرفه، فقال: عفوت عن ارش هذا الجرح وقوده، فان اندمل فلا ارش له ولا قود، وان سري الي عضو ووقف، وجب ارش السراية علي الاصح، الا ان يقول: عفوت عن هذا الجرح وعما يحدث منه، ففي سقوط الارش قولا الابراء عما وجد سبب وجوبه ولم يجب، وان سري الي النفس فلا قصاص فيها، خلافا لابي الطيب بن سلمة.
 وفي اسقاط ارش الطرف قولا الوصية للقاتل، فان قلنا: تصح، سقط ارش الطرف من الثلث وضمن السراية، ولا يخرج الوجه الضعيف   فيما اذا سري الي عضو ثم اندمل، وان ابطلنا الوصية وجب ارش الطرف وضمان السراية.
 وان قال: عفوت عن الجرح وعما يحدث منه، فسري الي النفس، فان ابطلنا الوصية وجبت الدية، وان اجزناها سقط ارش الطرف، وفي السراية القولان، فعلي هذا: لو قطع يده فقال: عفوت عن هذه الجناية وعما يحدث منها، فسرت، وجبت الدية علي قول وسقطت علي قول، ويجب نصفها علي قول، وان قطع اليدين ثم عفا عنهما وعما يحدث منهما، وجبت الدية علي قول وسقطت علي اخر.

  AUTO   فرع

 :
 اذا وصي بارش الطرف وبما يجب بالسراية، فان ابطلنا الوصية للقاتل بطلت فيهما، وان اجزناها صحت فيهما، فانها قابلة للتعليق بالاغرار.

  AUTO   فرع

 :
 اذا جني العبد تعلق الارش برقبته، وفي تعليقه بذمته خلاف، فان علقناه بذمته: فهل للمستحق فك الرقبة عن التعليق مع بقاء الارش في الذمة؟ فيه خلاف، فان التعليق بالذمة والرقبة متلازمان بخلاف وثيقة الرهن مع الدين، وان قال: عفوت عن الارش، فان قلنا: لا يتعلق بالذمة، صح العفو؛ لانه وصية لغير قاتل، وان علقناه بالذمة فقد خرجه الاصحاب علي الوصية للقاتل.
 قال الامام: ان ابطلنا الوصية للقاتل، فينبغي ان لا ينفك التعليق بالرقبة، ولا يخرج علي الوجهين، فانه لم يجرد قصده الي الفك.



  AUTO   فرع

 :
 اذا عفا عن دية الخطا، فان قلنا: الوجوب لا يلاقي الجاني، صح العفو، وان قلنا: يلاقيه، فان قال: عفوت عن العاقلة، او اطلق، صح العفو، وان قال: عفوت عن الجاني، فان قال ذلك بعد استقرار الوجوب علي العاقلة لم يصح العفو اتفاقا، وان قاله قبل الاستقرار، فان قلنا بالملاقاة خرج علي الوصية للقاتل، وان قلنا: لا يلاقيه، فوجهان، فان قلنا: يصح، برءت العاقلة كما يبرا الكفيل ببراءة الاصيل، وتشبيهه بالحوالة اولي، وكذلك لو تعذر الاخذ من العاقلة لم يرجع علي الجاني، ولو اقر بالجناية فاكذبته العاقلة، او كان ذميا والعاقلة مسلمون فعفي عن الارش، فعلي قولي الوصية للقاتل.

  AUTO   فرع

 :
 اذا قطع العبد يدي عبد، فعتق المقطوع ومات بالسراية، فقصاص نفسه لورثته، وقصاص طرفه لسيده اتفاقا، فان عفا عن القصاص في الطرف، بقي قصاص النفس، كما لو قطع انسانا وقتل اخر، فعفا المقطوع، فلا يسقط قصاص النفس.
 ولو ثبت قصاص النفس والطرف لواحد، فعفا عن قصاص النفس، بقي قصاص الطرف، وان عفا عن قصاص الطرف، بقي قصاص النفس علي الاصح.
 وان قتله بالاجافة وقلنا: يجيفه، فعفا عن قصاص النفس، سقطت الاجافة؛ اذ لا قصاص فيها علي الانفراد.
 ولو قطع يده، فعفا عن قصاصها، فسرت الي النفس، فلا قصاص   فيها علي المذهب، ولو قطعها فعفا عن قصاصها ثم قتله قبل الاندمال، فله القصاص في النفس علي الاصح، فان زهوقها لم يترتب علي جناية معفو عنها، وابعد من خرجه علي خلاف الشافعي وابن سريج.
 وان جرح جرحا لا قصاص فيه، فاخذ منه ارشه، ثم سري الي النفس، لم يسقط قصاصها اتفاقا، وفيه احتمال.

  AUTO   فرع

 :
 اذا جني العبد علي نفس او مال، فاشتراه المستحق بالارش، فان كان دراهم معلومة صح الشراء، فان رده بعيب عاد التعلق بالرقبة ولا شء علي السيد، بل يتخير بين تسليمه للبيع وفداءه، وان كان الارش ابلا معلومة، فان اجزنا بيع ابل الدية صح الشراء ها هنا، وان منعناه ثم فها هنا وجهان يجريان في المراة اذا لزمها خمس من الابل بالجناية، فتزوجها المجني عليه بها، فان مقصود هذه المعاملة السقوط والابراء.

  AUTO   خاتمة

 :
 الالتجاء الي الحرم لا يمنع الحد والقصاص، وان لاذ الجاني بشء من المساجد اخرج منه للقصاص، واسرف من اجاز القصاص في المسجد اذا راي الامام اقامة الهيبة بذلك بشرط ان تبسط الانطاع حتي لا يتلوث المسجد.
 * * *



  AUTO كتاب الديات   كتاب الديات

  AUTO   الجنايات ثلاثة

 :
 احدها: العمد، وهو قصد القتل بما يقصد به القتل غالبا، وديته مغلظة بالضرب علي الجاني، والحلول، والتثليث: ثلاثون حقة وثلاثون جذعة واربعون خلفة.
 الثاني: شبه العمد، وهو ان يقصد ضرب المجني عليه بما لا يقتل غالبا، ولا يقصد القتل، وديته مغلظة بالتثليث مخففة بالضرب علي العاقلة والتاجيل.
 الثالث: الخطا، وهو ان لا يقصد الفعل، مثل ان يرمي هدفا فيعرض انسان فيصيبه السهم، او ينفلت من يده فيصيب انسانا، فان قصد شيءا يظنه حجرا او حيوانا فظهر انسانا، فان لم يقصر بان كان في صحراء يندر استقرار الانسان فيها، ولا يمر بها الا عابرا، فقد قطع ابو محمد بانه خطا.
 وراي الامام ان يجعل عمد خطا علي قول، وخطا علي اخر، اذ لا يقصر عن رمي من يظنه حربيا فيظهر مسلما، الا انا نسقط الدية ثم علي قول ولا نسقطها ها هنا؛ لانا مامورون بالتحفظ في دار العصمة.
 ودية الخطا مخففة بالضرب علي العاقلة، والتاجيل، والتخميس:



 عشرون بنت مخاض، وعشرون بنت لبون، وعشرون ابن لبون، وعشرون حقة، وعشرون جذعة.
 وتعتبر نسبة التخميس والتثليث في الديات الناقصة وارش الجنايات وان ادي ذلك الي التشقيص، ففي موضحة العمد وشبه العمد حقة ونصف وجذعة ونصف وخلفتان.
 ولا خلاف في تغليظ دية النساء واهل الكتاب والمجوس، وغلظ ابو محمد في المجوس، ولا يظهر التخفيف والتغليظ في الغرة، لكن يظهر في بدلها من الابل.
 * * *

  AUTO   فصل في صفة الخلفات

 الخلفة: هي الحامل، وتجزي الثنية فما فوقها، فان حملت الجذعة نادرا اجزات علي الاصح، ولا يلزم الولي الخلفات حتي يشهد عدلان خبيران بالحمل، فان قال: لا اخذها بقولهم المبني علي الظن، لزمه الصبر الي ان يظهر الحمل اتفاقا، وان قبضها علي ظن الحمل ثم ادعي الحيال، فان ثبت الحمل بالبينة انقطع ظنه ولزمه الصبر الي التبين.
 وان شهدوا بالحيال او شكوا فيه، فله ان يردها ويطلب الحوامل، ولا يلزمه الصبر الي التبين فان ادعي الجاني انها اجهضت، فاكذبه القابض، وامكن صدقهما، فان كان قد اخذها بقول الجاني فالقول قول القابض، وان كان قد اخذها بالبينة فوجهان؛ لان حقه ثابت بيقين، فلا يسقط بالظن والتخمين.



  AUTO   فرع

 :
 اذا وقع الخطا في الحرم، او الاشهر الحرم، او في ذي رحم محرم، تغلظت الدية كشبه العمد، وفي حرم المدينة وجهان، والوجه اعتباره بضمان الصيد، فان كان القاتل في الحل والقتيل في الحرم، او بالعكس، تغلظت الدية، والاصح انها لا تتغلظ باحرام القاتل، ولا بقتل رحم لا محرمية له، فان اجتمعت اسباب التغليظ، بان تعمد قتل الرحم المحرم في الحرم والاشهر الحرم، فلا يتضاعف التغليظ اتفاقا.
 * * *



  AUTO   باب اسنان ابل الخطا وتقويمها وديات النفس والجراح وغيرها

 المذهب: ان دية الحر المسلم مءة من الابل، واصنافها كثيرة؛ كالنجيبة والمهرية المجيدية والارحبية، فلا يتخير الجاني ولا العاقلة بين الاصناف اتفاقا، فان لم يكن له ابل لزمه من ابل الناحية التي ينتسب اليها اتفاقا، فيجب من الصنف الغالب، فان لم يغلب صنف، او غلب صنفان فما زاد، تخير الغارم، ولا تقسط علي الاصناف، لما فيه من العسر.
 وان كان له ابل تخالف ابل الناحية بنفاسة او خساسة، فالمذهب الاعتبار بابل الناحية؛ لانها غرامة متلف.
 وقال العراقيون: الاعتبار بابله، وهو ظاهر النص فان اعتبرنا بابله فاختلفت اصنافها، قسطت الدية عليها عند العراقيين، ويلزمهم تخريجه علي القولين في نظيره من الزكاة.

  AUTO   فرع

 :
 يعتبر في قباءل البادية ابلها التي تسير معها، فان اختلفت قباءل العاقلة اخذ من كل قبيلة ابلها.

  AUTO   فرع

 :
 اذا فقدت ابل الناحية اعتبر بابل اقرب البلدان اليه ان امكن، وان   تعذر ذلك وجبت قيمتها، ويعتبر التعذر بان لا يمكن تحصيلها في الناحية الا بزيادة يعد مثلها غبينة في الابل لو حضرت.
 ولو قال الولي: انا اصبر الي ان يتيسر له الابل، فله ذلك علي الاظهر، وفيه احتمال؛ فان قيمتها اذا وجبت لا تءخر للحيلولة، ولذلك لا يجب ردها اذا تيسرت الابل اتفاقا.
 وتعتبر القيمة بغالب نقد البلد، وتختلف باختلاف التخفيف والتغليظ، ولا فرق بين الدية الكاملة والناقصة، وقال في القديم: يتخير الجاني بين الف دينار او اثني عشر الف درهم مسكوكة خالصة، وفي الدية الناقصة بحساب ذلك، وابعد من طرد هذا القول مع وجود الابل وخيره في ذلك، ويسقط اثر التغليظ علي القديم، وابعد من زاد للتغليظ اربعة الاف درهم، وضعفه باجتماع اسبابه، فاوجب في قتيل الحرم في الاشهر الحرم عشرين الفا، وطرد ذلك في ساءر (¬) اسباب التغليظ، ولا يعد هذا من المذهب.
 * * *

  AUTO   فصل في ارش الموضحة

 ارش الموضحة نصف عشر دية المشجوج، ويعتبر في ذلك الاسم، فيجب فيما يقرعه (¬) الميل مثل ما يجب في المستوعبة للراس، ولا تتعدد باختلاف اجزاء الراس، فان نزلت الي الجبهة ففي التعدد وجهان، والعظم   المغمورة وراء القمحدوة من الراس؛ لانها من القحف، وابعد من جعلها كالجبهة.
 وان استوعب الراس بالايضاح، وراسه اكبر، لم يكمل القصاص بالجبهة اتفاقا.
 ومحل المواضح جميع كرة الراس، ويدخل فيه الجبين، والوجنة، والجبهة، وقصبة الانف، واللحيان من جهة المقابلة ومن تحت وما ينطبق عليه، وصدفة الاذن وان لم يثبت له حكم الراس في مسح الوضوء والاحرام، ولا يدخل فيه شء من عظام الرقبة.
 وان اوضح موضحتين بينهما لحم ولا جلد فوقه، او جلد ولا لحم تحته، فاوجه:
 احدها: التعدد.
 واقيسها: الاتحاد.
 والثالث: ان بقي اللحم تعددت، وان بقي الجلد اتحدت.
 والرابع: عكس الثالث، وهو ضعيف.
 فان قلنا بالاتحاد اذا زال الجلد واكتسي الحاجز بالجلد واللحم، فلا اثر له، وان قلنا بالتعدد عند زوال الجلد او اللحم، فاوضح موضحتين ثم سلك الحديدة من (¬).



  AUTO   فرع

 :
 اذا ظهرت في لسان الطفل امارات النطق بالتحريك (¬) الصحيح بالضحك والبكاء والمص، وجبت الدية والقصاص، وان ظهرت امارات الخرس، او لم تظهر امارات النطق ولا الخرس، وجبت الحكومة علي ما قطع به الاصحاب.

  AUTO   فرع

 :
 اذا قطع من لسان الطفل ما لو قطعه من لسان البالغ لاذهب ربع كلامه مثلا، فبلغ الطفل الي حد الكلام فلم يتكلم، وجبت الحكومة؛ لظهور امارة الخرس، وان تكلم بثلاثة ارباع الكلام وجب ربع الدية.

  AUTO   فرع

 :
 اختلاف الجاني والمجني عليه في الخرس كالاختلاف في الشلل.
 * * *

  AUTO   فصل في الجناية علي الاعضاء الناقصة بجناية او افة

 اذا جني علي عضو قد نقص بجناية او افة، فان كان ارش النقص مقدرا كدية اصبع، حط ارشها عن الجاني، وان كان الارش حكومة، فان وجب بسبب البطش مع توفر المنفعة كملت الدية علي الجاني اتفاقا، وان وجبت بسبب نقص المنفعة مثل ان نقصت منفعة البطش او البصر والسمع فان نقصت بافة كملت الدية علي الجاني، وان نقصت بجناية ففي التكميل احتمال.



 ولو شجه متلاحمة فاوضحها اخر لزمه ارش موضحة، ويحط منه ارش المتلاحمة، ولو اكتست المتلاحمة بالجلد وبقي محلها منخفضا، فاوضحها اخر، فالاظهر تكميل ارش الموضحة، وفيه احتمال، فان اللحم الذي فات لم يعد.
 * * *

  AUTO   فصل في الجناية علي المنافع بعد النقصان

 اذا نقص شء من المنافع كالسمع والبصر والبطش، فقطع قاطع عضو المنفعة، او ابطل ما بقي منها، فان كان النقص بافة كملت الدية، ففي يد الهرم ما في يدي الشاب الايد اعتبارا بنقص القوة الحيوانية، فانا نكمل دية النفس فيمن صار الي السياف.
 وان كان النقص بجناية، فان لم تكن المنفعة مضبوطة ففي كلام المشايخ احتمالات:
 احدها: الحط في قطع العضو او ابطال المنفعة.
 والثاني: التكميل فيها.
 والثالث: التكميل في القطع والحط في الابطال؛ لتعذر عود المنفعة في القطع وامكانها في الابطال.
 وان كانت المنفعة مضبوطة كالكلام، فان بطل نصف الكلام بالجناية، فازال الثاني النصف الاخر مع بقاء اللسان، وجب علي الثاني نصف الدية اتفاقا، وان قطع اللسان كملت الدية عند الجمهور، وعند ابي اسحاق: يجب   نصف الدية وحكومة.
 وان بطل بعض الكلام بافة من الخلقة، ففي التكميل وجهان؛ لانضباط المنفعة، بخلاف السمع والبصر، فان قلنا: لا تكمل، فكان لا يحسن سوي عشرين حرفا لكنه يعبر بها عن جميع اغراضه لتبحره في اللغة، ففي التكميل وجهان.
 * * *

  AUTO   فصل في دية السن

 في كل سن نصف عشر دية المجني عليه، ففي سن الحر المسلم خمس من الابل، سواء قلعها مع سنخها او قطع ما ظهر منها، فان قطع بعض الظاهر، او بعض الحشفة، او بعض الحلمة، فالاصح توزيع الدية علي الحشفة والحلمة وعلي ما ظهر من السن، وان قطع بعض المارن، وقلنا: لا حكومة في القصبة، فالاصح التوزيع علي المارن، والتوزيع علي ما ظهر من السن اولي من التوزيع علي الحلمة والحشفة؛ لحصول الانتفاع بالثدي وبقية الذكر، ولا منفعة في السنخ، والمارن اولي بالتوزيع منهما.

  AUTO   فرع

 :
 السنخ مع الظاهر كالكف مع الاصابع (¬)، فان قطع الظاهر ثم قلع السنخ متصلا كان او منفصلا وجبت حكومته (¬)، وان قطع بعض الظاهر او   بعض الحشفة، ثم قطع ما بقي، وجبت الحكومة في السنخ وما زاد علي الحشفة علي النص، فان الحكومة لا تندرج تحت بعض الحشفة وبعض الظاهر من السن، وفي فحوي كلام الاصحاب وجهان اخران:
 احدهما: لا يجب شء.
 والثاني: توزع الحكومة علي الفاءت والباقي.
 * * *

  AUTO   فصل في عود السن

 اذا ظهر لنا زوال شء من المعاني بالجناية؛ كالعقل، والبطش، والسمع، والبصر، وساءر المعاني والحواس، فان اوجبنا الدية ثم عاد ما ظننا زواله، وجب رد الدية اتفاقا، فان المعاني لا تزول وانما تستتر ثم تظهر.
 ولا يسقط قصاص الموضحة ولا ارشها بالتحامها اتفاقا، وكذا الجاءفة علي المذهب، وابعد من خالف فيها. وقال الامام: ان زال بعض اللحم بالاجافة او الايضاح لم يسقط الارش، وان لم يزل شء من اللحم بالاجافة، او اوضحه بابرة فالتحمت، ففيه الخلاف.
 وان قلع سن صبي لم يثغر، فلا ارش ولا قصاص حتي نياس من نباتها، فان عادت قبل الياس: فان بقي شين وجبت الحكومة، وان لم يبق فوجهان، وان ظهر الياس بطول المدة، فاخذ الارش، ثم عادت، رده اتفاقا، وان لم تعد كمل الارش، ويجب القصاص عند المعظم، وتوقف الامام في القصاص.



  AUTO   فرع

 :
 اذا مات الصبي في مدة الانتظار، ففي تكميل الارش خلاف، ولو افسد منبتها جان اخر وقيل: لولا الافساد لنبتت، فالارش علي الثاني، وهل يجب علي الاول حكومة، او ارش؛ فيه احتمال.
 ولو انقلع السن بنفسه، فافسد انسان منبته، ففي وجوب الارش احتمال، ويتجه ايجابه، لعدم الاحالة علي جان اخر.
 وان قلع سنا مثغورة فلم يعد، وجب الارش والقصاص، ويرجع في مدة الانتظار الي اهل الخبرة، فقد تزيد علي مدة عود سن الصغير، فان عادت لم يرد الارش علي اقيس القولين، وان قطع بعض اللسان فنبت، ففيه القولان عند الاكثرين، وقيل: لا يرد اتفاقا، فان في جنس الاسنان ما يوجب عودة الرد، بخلاف اللسان.
 وعلي القولين في السن فروع:
 الاول: اذا قلنا: لا حكم لعود السن، وجب القصاص والارش في الحال، وان جعلنا له حكما فطريقان:
 احداهما: القطع بوجوبهما في الحال.
 والثانية للاكثرين في وجوبهما القولان.
 الثاني: اذا قطعنا سن الجاني، فعاد سن المجني عليه، فان قلنا: لا حكم لعوده، وقع القصاص موقعه، وان اثبتنا له حكما لم يحصل القصاص، وعلي المجني عليه ضمان سن الجاني، وغلط من خالف في ذلك.
 الثالث: اذا عاد سن الجاني بعد القصاص، فان قلنا: لا عود للحكم،   وقع القصاص موقعه، وان جعلنا له حكما لم نقلع السن العاءدة عند المراوزة، وعلي الجاني ارش سن المجني عليه، وفي طريق العراق وجه: انا نقلع سنه وان تكرر عودها الي ان يفسد منبتها.
 الرابع: اذا عاد السنان فلا نجد حكما اخر علي القولين، فانا ان لم نجعل للعود حكما فقد تمت الجناية والقصاص، وان جعلنا له حكما فكان القصاص والجناية لم يقعا.
 * * *

  AUTO   فصل في قلع جميع الاسنان

 اروش الاسنان متساوية كاروش الاصابع، والغالب: ان الاسنان اثنان وثلاثون، وان الثنايا اطول من الرباعيات، فان ساوت ثنايا انسان رباعياته او نقصت عنها، لم يكمل الارش عند المعظم، بل يوزع علي الفاءت والباقي بالحساب، وغلط من اوجب الحكومة، الا ان يريد بها ما ذكرناه، ورمزوا الي وجه في تكميل الارش لغلبة تفاوت الاسنان، ولو استوت السنخة لم يكمل ارش الوسطي.
 فان قلع جميع الاسنان علي التعاقب، وتخلل اخذ الارش بين كل سنين، او تخلل الاندمال، او قلع عشرين سنا، فقلع اخر ما بقي، وانفرد كل جان بقلع سن، وجبت اروش الجميع اتفاقا وان زادت علي الدية، وكذا ان قلعها دفعة واحدة علي اصح القولين، وعلي القول الاخر: لا تزاد علي دية النفس، وان قلعها علي التعاقب ولم يتخلل ارش ولا اندمال، فطريقان:



 احداهما: تكميل الاروش.
 والثانية: القولان.

  AUTO   فرع

 :
 في اللحيين الدية، فان قلعهما مع الاسنان لزمه ديتان علي اقيس الوجهين.

  AUTO   فرع

 :
 اذا جني علي سن فاسود، ففي تكميل الارش اختلاف نص، فجعلهما المزني قولين، وحملهما الاءمة علي حالين: ان سقطت المنفعة وجب الارش، وان لم تسقط وجبت الحكومة.
 وقال الامام: ان ضعف القطع به والمضغ وجبت الحكومة، كما لو ضعف بطش اليد، وان انبتر بعضه وجب بحسابه.
 ولو قلع بعد ذلك فقال الاءمة: ان اوجبنا الارش علي الاول فالحكومة علي الثاني، وان اوجبنا الحكومة علي الاول فالارش علي الثاني.
 وقال الامام: ينبغي ان تحط حكومة الاول من دية الثاني، وكذلك في ضعف البطش.
 ولو قطعت هذه السن او اليد الضعيفة البطش، وجب القود عند الاءمة، وهذا واضح في الضعف الخلقي او بالافة الطارءة، ولا خلاف في وجوب القود في الاعضاء الضعيفة، ولو تقلقل السن لمرض او هرم، فاصح القولين تكميل الارش ولزوم القصاص، ووجه الاسقاط: تشبيهه بسن الصبي،   وخص الامام الخلاف بما اذا غلب علي الظن انه سقط، وقال: لو بقيت المنفعة وغلب علي الظن انه لا يسقط كمل الارش ووجب القود.
 ولو اتخذ سنا من ذهب، فتشبث به اللحم، وانتفع به في القطع والمضغ، ففي وجوب الحكومة بقلعه وجهان.

  AUTO   فرع

 :
 اذا بلغ الصبي في العاشرة وله سن غير مثغورة، فقلع سنا تماثل سنه، فلا قصاص في الحال، فان لم يعد سن المجني عليه، فقلعنا سن الجاني (¬)، فان لم تعد حصل القصاص، وان عادت قلعت علي اظهر الوجهين، فان الاول لم تكن مثغورة، وان لم تقلع سن الجاني كمل الارش في سن المجني عليه.
 * * *

  AUTO   فصل في دية اليدين والرجلين

 اذا قطع اليدين من الكوعين، او اشلهما، او قطع الرجلين من الكعبين، او اشلهما، وجبت الدية واندرجت حكومة الكف والقدم في دية الاصابع اتفاقا، وان قطع الاصابع ثم قطع الكفين او القدم، وجبت حكومتهما اتفاقا، وتكمل الدية في اصابع الرجلين اتفاقا، وتكمل الدية في رجل الاعرج؛ لان الخلل في الفخذ او الحقو او في تشنج العصب.



 وان قطع اليد من المرفق او الساعد، او قطع الرجل من الركبة او الفخذ، ففيما زاد علي الكف والقدم الحكومة.
 وان كسرها فجبرها المجني عليه جبرا معوجا، وجبت الحكومة، فان طلب الجاني ان يكسرها ليجبرها مستقيما، لم نجبه الي ذلك، فان تعدي به وجبت حكومة اخري.
 * * *

  AUTO   فصل في زيادة اليد ونقصها

 لا يتصور ان يكون علي معصم كفان اصليان، ولا علي ساق قدمان اصليتان، بل تكون احداهما زاءدة، او يكونا ناقصين في مقابلة يد واحدة ورجل واحدة، كما ذكرناه في الاصابع الستة، فان تميزت الزاءدة ففيها حكومة، وفي الاصلية الدية والقصاص، والاعتبار في اليمين بالبطش او بزيادته، ولا يعارضه شء من الصفات.
 فان تساويا من كل وجه وانفردت احداهما بالبطش او بزيادته، فهي الاصلية وان انحرفت واستدت الضعيفة.
 وان استويا في البطش وغيره ونقص خلق احداهما فالكاملة هي الاصلية، وان زادت احداهما اصبعا فلا اثر لذلك، خلافا للقاضي.
 فان استوي البطش واحداهما كاملة منحرفة والاخري مستدة تنقص اصبعا، فايتهما الزاءدة؟ فيه احتمال.
 وان استويا من كل وجه، فقطعهما معتدل، قطع، وعليه حكومة له   لزيادة الخلقة، وان قطع احداهما لم يقطع، وعليه نصف دية اليد وحكومة لزيادة الخلقة، فان قويت الباقية قوة لو كانت عليها في الابتداء لكانت هي الاصلية، كملت فيها الدية ووجب القصاص، وفي استرداد دية الاول وجهان، فان قلنا: تسترد، وجبت الحكومة.
 ولو اختصت احداهما بالبطش، فقطعت، فبطش بالاخري بطش الاصليات، ففيها الدية والقصاص اتفاقا.
 ولو استويا من كل وجه، فقطعت احداهما، فاخذ الارش والحكومة، ثم عاد الجاني فقطع الاخري، لزمه ارشها وحكومتها، وفي القصاص وجهان من جهة انه معذور باخذ ارش الاول، فلم يسقط بذلك القصاص.
 * * *

  AUTO   فصل في دية الاليتين والصلب

 في الاليتين الدية، وفي احداهما نصفها، وحدهما جميع ما يشرف علي الظهر واصل الفخذ، ولا يشترط القطع الي العظم اتفاقا، وان كسر الصلب فابطل المشي وجبت الدية، وان ضعف المشي او احتاج الي عكازة وجبت الحكومة، وان تعطلت الرجل مع سلامتها لم تجب ديتها اتفاقا، فان من جني علي عضو فتعطل الانتفاع بغيره مع سلامته، فلا دية للمتعطل.
 * * *

  AUTO   فصل في دية المراة

 دية المراة نصف دية الرجل، وجراحها كجراحه من ديته، ففي   موضحتها نصف عشر ديتها، وعلي قول قديم: تعاقل الرجل الي ثلث ديته، ففي اصبعها عشر، وفي اصبعين عشرون، وفي ثلاث ثلاثون، وفي اربع عشرون.
 وان قلع ست اسنان وجب ثلاثون، فان قلع السابع رجعت الاروش الي سبعة عشر ونصف، ولو قطع ثلاث اصابع فلم يغرم الارش حتي قلع الرابعة، رجعت الاروش الي عشرين.
 * * *

  AUTO   فصل في دية الحلمتين

 في حلمة المراة الدية، وفي احدهما نصفها، فان قطعها ثم قطع الثديين وجب في كل ثدي حكومة لا تبلغ دية الحلمة، وحد الحلمة ما يلتقمه الطفل عند الرضاع.
 وان قطع الحلمتين مع الثديين، او المارن مع القصبة، او الحشفة مع الذكر، او السن مع السنخ، ففي اندراج الحكومة في دية ذلك طرق:
 احداهن: في الادراج وجهان.
 والثانية: لا تندرج حكومة القصبة علي الاصح؛ للاختلاف، وتندرج حكومة الباقي للتجانس.
 والثالثة وهي بعيدة: لا تندرج حكومة السنخ لاستتاره، وفي غيره وجهان.
 وتندرج حكومة الكف في دية الاصابع اتفاقا، فان اوجبت الحكومة، فقطع جزءا من الحلمة او المارن او الحشفة او ما ظهر من السن، لزمه بقسطه   من الحلمة والمارن والحشفة وظاهر السن، وكذلك ان لم نوجب الحكومة علي الاصح.
 وفي حلمتي الرجل حكومة، وعلي قول مخرج: فيهما الدية، ولا تندرج حكومة الثندوة فيها اتفاقا، فانهما لا يعدان عضوا واحدا.

  AUTO   فرع

 :
 قال الاصحاب: اذا جني علي الثدي او الصلب، فزعم اهل الخبرة انه بطل اللبن والمني، وجبت الحكومة في ابطال اللبن، والدية في ابطال المني، فانه صفة لازمة واللبن عارض علي اصل الخلقة.
 * * *

  AUTO   فصل في الافضاء ودية الشفرين

 في شفري السليمة والرتقاء والقرناء الدية، فان زالت البكارة وجبت الدية وارش البكارة، وحد الامام الشفرين بالقدر الناتء.
 وان افضي زوجته بوطء او غيره، او افضي امراة بزنا طوعا او كرها، وجبت الدية.
 وفي الافضاء مذهبان:
 احدهما: ان يجعل سبيل البول والحيض واحدا.
 والثاني: ان يجعل سبيل البول والغاءط واحدا.
 فان استرسل البول بسبب الافضاء، ففي اندراج حكومته في دية الافضاء وجهان.



  AUTO   فرع

 :
 قال الشافعي: اذا افتض البكر مكرهة وجب مهر المثل وارش البكارة، واستشكله القاضي لما فيه من تضعيف الغرامة.
 وقال ابو محمد: المنقول عن الشافعي ايجاب المهر والارش من غير تقدير مهر بكر؛ اذ لا فرق بين ايجاب مهر البكر وبين ايجاب مهر ثيب مع ارش البكارة، فلا يجمع بينهما ان اختلف مهر البكر والثيب، وان لم يختلف كان كجناية لا تورث شيءا، ففي الحكومة وجهان.
 * * *

  AUTO   فصل في بيان الحكومات

 الحكوم: ما يجب في كل جرح غير مقدر الارش، ويجب ان تنقص عن دية العضو المجني عليه، فتنقص حكومة الاصبع عن ديتها، وحكومة الاصابع عن دياتها، وكذلك الانامل وساءر الاعضاء، وتحط حكومة العين القاءمة عن ديتها، وحكومة العضو الاشل عن ديته، وحكومة الكف عن دية الاصابع، وكذا عن دية اصبع علي اظهر الوجهين، ولا يبعد ان تزيد حكومة اليد الشلاء علي دية اصبع.
 وتجب الحكومة في ازالة الشعور مع افساد منابتها، وفي الاعين القاءمة والاعضاء الشل، وفي ازالة الجمال وتغيير الالوان.
 وفي الضلع والترقوة طريقان:
 احدهما ايجاب الحكومة.



 والثانية: قولان، والثاني: يجب فيهما جملان، واقيسهما: ايجاب الحكومة.

  AUTO   فاءدة

 :
 يعرف الشلل بسقوط اصل الحركة، والقحل (¬)، والذبول، ومن علاماته: ان ينقبض العضو ولا ينبسط، او ينبسط ولا ينقبض.
 ويد المفلوج ان حكم اهل الخبرة بانها لا تعود عاملة مع سلامتها، فان كان ذلك لخلل في الاعصاب لم يبعد الحاقها بالشلاء، وان كان لخلل في الدماغ لم يبعد ايجاب الدية، كرجل من انكسر صلبه.
 وان ذهبت حركة اليدين والبطش بالجناية: فان كان ذلك لخلل في الاعضاء وجبت دياتها، وان كان لخلل في الدماغ وجبت دية واحدة، لذهاب القوة المحركة، والحكومة: ان ننظر بعد الاندمال، فان بقي شين، قدر المجني عليه عبدا معينا بذلك الشين وقدر سليما منه، وينظر الي ما بين القيمتين، ويوجب مثل نسبته من الدية، فان كان عشر القيمة او اقل وجب عشر الدية او اقل ان نقص عن دية العضو المجني عليه، وان ساوي دية العضو او زاد عليها فلا بد من الحط، ولا يكتفي فيه باقل القليل.
 واختار الامام ان يضبط نسبة نقص العضو مع بقاءه، ثم يقدر النقص بسبب فوات العضو، ويضبط ما بين النقصين، ويحط مثل نسبته اعتبارا لنقص   الجزء عن الجزء ونقص (¬) الكل عن الكل.
 وان اندملت الجراحة ولم تعقب شيءا، فلا حكومة لها علي اقيس الوجهين، واختاره الامام، فان قلنا: تجب، فهل تقدر باجتهاد الحاكم، او ينظر الي الجرح وهو مءلم او مدم (¬)؟ فيه وجهان، فان اعتبرنا الالم فقد قال الامام: ينبغي ان يشرط الخوف من عاقبة الجناية او يخاف التنقيص وان لم يقع ما يتخوفه.

  AUTO   فرع

 :
 اذا قلع سنا شاغية (¬) مءذية، او اصبعا زاءدة، او نتف لحية امراة وافسد منبتها، فزادت القيمة بذلك كله، ففي الحكومة وجهان، فان اوجبناها فزاد جمال المراة بذلك، قدرناها غلاما افسد منبت لحيته في اوانها علي قول الاصحاب، وقال الامام: ينبغي ان يحط عما يجب في لحية الغلام، وخص الاصحاب هذا الخلاف بالحر، ولم يوجبوا في العبد شيءا اذا لم ينقص بعد الاندمال، وهذا واضح ان اوجبنا ارش ما نقص، وان جعلنا جراحة من قيمته كجراح الحر من ديته، فالقياس تخريجه علي الخلاف في الاحرار.

  AUTO   فرع

 :
 اذا حصل حول جرح الحكومة شين كالقحل، وتغير اللون او الارتفاع   والانخفاض، فالاصح ايجاب حكومة للجرح والشين.
 وقيل: ننظر الي ما علي محل الجرح من الشين والي ما حوله، ونوجب اكثرهما حكومة، وهذا بعيد وهو المنصوص، فان قلنا به فاستوت
 الحكومتان، وجبت احداهما، ويحتمل ايجابهما.
 ولو حصل حول الموضحة شين فلا حكومة له، فانه لو اوضح محله لم يزد علي ارش الموضحة.
 وان حصل حول المتلاحمة شين، فان اوجبنا فيها الحكومة: فهل يجب حكومة الكل، او ينظر الي الاكثر؟ فيه الخلاف، وان قدرنا ارشها ففي حكومة الشين خلاف.
 * * *

  AUTO   فصل في منافع تجب فيها ديات

 اذا ابطل المني بالجناية، او ابطل شهوة الجماع، او شهوة الطعام، او سلخ جلده، او ابطل منفعة المضغ مع بقاء لحييه واسنانه، وجبت الدية. وان سلخ جلده ثم قطع يديه، فقد قال ابو علي: يسقط من دية اليدين ما يخصهما من دية الجلد.

  AUTO   فرع

 :
 اذا زال شء من هذه المنافع او من غيرها؛ كالسمع والبصر، وقال اهل الخبرة: سيعود عن قرب، انتظر عوده، وان قالوا: يمكن عوده بعد زمن طويل، وجب الارش في الحال، فان عاد رددناه، وان قدروا مدة   للعود فقد قيل: يجب الانتظار.
 وقال الامام: ان غلب علي الظن تصرم عمره في تلك المدة وجب الارش في الحال، وان كانت المدة مما يقرب (¬) رجاء الحياة الي مثلها لم يبعد الانتظار.

  AUTO   فرع

 :
 اذا كسر عنقه فلم يسغ الطعام والشراب، وجبت الدية، فان مات جوعا وعطشا، احتمل ان لا يزاد علي الدية كالسرايات، واحتمل ان تجب علي النص دية، وعلي قول ابن سريج ديتان، ولو كسر الصلب فابطل المني، ففي تعدد الدية وجهان، فان كسر صلب من لا مني له، وجبت الدية اتفاقا.

  AUTO   فرع

 :
 كل عضو تجب الدية في منفعته مفردا فاذا قطع مع اشتماله علي منفعته، لم يزد علي ديته، فان زال بذلك منفعة عضو اخر وجب ديتان، ولا وجه للخلاف في زوال العقل بالجناية علي الاعضاء.
 والضابط: ان كل منفعة لو زالت لوجبت الحكومة في عضوها، فان العضو يتبعها في الحكومة اذا لم يفرد بالقطع، وكل منفعة يعلم حلولها في غير عضو الجناية، فلا تندرج في عضو الجناية، وكل منفعة تخيل انها في عضو الجناية من غير قطع كالمني بالنسبة الي الصلب، ففيه الخلاف.
 * * *



  AUTO   فصل في دية الكافر

 دية اليهودي والنصراني ثلث دية المسلم، والمستامن كالذمي اتفاقا، وقيل: ان السامرة والصابءة من اليهود والنصاري، فان صح ذلك ولم يكونوا معطلة، فديتهم (¬) كدية اليهود والنصاري.
 ودية المجوسي خمس دية اليهودي، وان استامن وثني ففيه دية مجوسي.
 ولا امان للمرتدين، فان حاربونا لم نعرض لرسولهم، فان قتل فقد قيل: لا يضمن.
 والزنديق الذي لم يلتزم الاسلام: كالوثني او المرتد؟ فيه تردد لابي محمد.

  AUTO   فرع

 :
 من لم تبلغه دعوة ملة من الملل، ان كان علي دين حق لبعض الانبياء، لم يجز ان نتعرض له حتي ندعوه الي الاسلام، فان قتله مسلم فقد قتله محكوما له بالسعادة، ولا قصاص عليه خلافا للقفال؛ اذ لا يكافء المسلم، فان اوجبنا القصاص وجبت دية مسلم، وان لم نوجبه: فهل يجب دية مسلم، او دية اهل دينه؟ ففيه وجهان.
 وان لم يكن علي شء من الاديان، فلا قصاص علي المسلم بقتله خلافا للقفال، وهل يجب فيه دية مجوسي او مسلم؟ فيه قولان، وقال   بعضهم: يجب دية المجوسي وحمل القول الاخر علي التمسك بدين صحيح.
 ولو تمسك بدين موسي بعد التغيير، ولم تبلغه دعوة نبينا، فالوجه ان نبلغ الدعوة، ولا قصاص علي المسلم بقتله اتفاقا، وفيه دية مجوسي علي ظاهر النص، وينبغي ان تجب دية يهودي، وفي اصل ضمانه احتمال.
 * * *

  AUTO   فصل فيما يجب في جراح العبد

 جراح العبد من قيمته كجراح الحر من ديته، ففي موضحته نصف عشر قيمته، وفي يديه قيمته، وفي احداهما نصفها، وكذلك ساءر اطرافه، وفي اجراء القسامة فيه وتحمل العاقلة لقيمته قولان تغليبا للمالية، فخرج قول: ان في جراحه ارش ما نقص كالبهاءم.
 وان قطع ذكره وانثياه وجب قيمتان علي النص، وعلي المخرج: في وجوب الحكومة عند بعضهم وجهان، وقطع الامام بانها لا تجب؛ اذ لا يعرف خلافا ان من خصي بهيمة فزادت قيمتها فلا شء عليه.
 * * *

  AUTO   فصل في عمد الصبي والمجنون

 العامد: من له روية قبل الفعل، وفكر ينعطف (¬) عليه بعد الفعل،   وقد يتصور هذا من الصبي والمجنون، فان لم يكونا كذلك كان فعلهما خطا محضا؛ اذ لا يتصور شبه العمد الا ممن يتصور منه العمد، وان كانا مميزين تعمدا، فقولان:
 احدهما: يثبت حكم العمد في وجوب القصاص علي شريكهما وتغليظ الدية في مالهما.
 والثاني: انه خطا محض، فتخفف الدية علي عاقلتيهما.
 * * *

  AUTO   فصل فيمن صاح بانسان فزال عقله او مات

 اذا كان البالغ او المراهق مستقرا علي جدار، فصاح بهما صاءح، فسقطا وماتا، فان تغفلهما بالصياح من وراءهما، فلا قود اتفاقا، ولا دية علي اظهر القولين، وان واجههما بالصياح فلا قود ولا دية، وابعد من طرد القولين في الدية.
 وان صاح بصبي ضعيف البنية بعيد التماسك وجبت الدية، وفي القود وجهان.
 وتختلف هذه الصور باختلاف الاشخاص في القوة والضعف، فقد يجعل من تعتريه الوساوس ويردعه ادني شء بمثابة الصغير، ويجعل الصياح كالضرب، فان كل ما يقصد بمثله الهلاك غالبا وجب القود، وان لم يغلب الهلاك منه وامكن ان يضاف اليه، فهو شبه عمد، فمتي علم ان السبب مهلك، وغلب علي الظن حصول الهلاك به، وجب الضمان اتفاقا، وان وقع   النظر في كون السبب مهلكا، فهو محل الخلاف.
 وان صاح بمستقر علي الارض، فزال عقله او مات، فان كان كبيرا متثبتا لم يضمن، وان كان صغيرا، فقد الحقه بعضهم بالسقوط من الجدار، وهذا لا يصح؛ اذ يبعد حصول الموت وزوال العقل بالصياح.
 * * *

  AUTO   فصل فيمن طلب انسانا فهرب منه فهلك 

 اذا طلب انسانا بسيف، فالقي نفسه من شاهق، او في بءر او ماء او نار، فهلك لم يضمنه؛ كما لو اكرهه علي قتل نفسه.
 وان طلبه في الصحراء، فافترسه اسد في هروبه، لم يضمنه.
 وان هرب علي سطح فسقط، فان كان اعمي او في ظلمة وجب الضمان، وان كان بصيرا والطلب نهارا لم يضمن.
 وان سقط في بءر، فان كانت مغطاة او في ظلمة ضمن، وان كانت مكشوفة ولا ظلام لم يضمن عند الاصحاب، وقال الامام: ان منعته شدة الهرب من تامل البءر وجب الضمان.
 ولو انخسف به السطح لم يضمن عند الاصحاب، بخلاف البءر المغطاة، فانها ليست محلا للاقامة والتردد، وقال الامام: هذا مشكل، فان الانخساف لا يحصل الا بضعف السقف، فان كنا نفرق في البءر بين ان يعلم بها الطالب وبين ان لا يعلم، صح مثله في السقف، وان لم نفرق نظر الي تعدي الطالب، فينبغي ان يضمن اذا جهل ضعف المنخسف.



  AUTO   فرع

 :
 اذا تهدد السلطان الحامل حيث يجوز له ذلك فاجهضت بذلك، او تهدد المهيب رجلا فهلك بذلك، وجب الضمان، وقد يقع بهذه الافعال شبه عمد.

  AUTO   فرع

 :
 اذا نقل حرا صغيرا الي مسبعة، فاتفق ان افترسه سبع، فان كان بحيث يتاتي منه المشي والانتقال لم يضمن، وان لم يمكن ذلك فوجهان.

  AUTO   فرع للعراقيين

 :
 اذا تسلم السابح الصبي ليعلمه السباحة، فغرق في تعليمه، ضمنه؛ لثبوت يده عليه، وقال الامام: ان القاه في الماء ضمن، وان امره بالدخول ففيه احتمال، فان اثبات اليد علي الاحرار بعيد، وان كان بالغا لم يضمنه اذ لا يد له عليه، ويحتمل الحاق المميز بالبالغ.
 * * *

  AUTO   فصل في جناية العبد والامة

 اذا جني الرقيق او اتلف مالا تعلق الضمان برقبته، وكذا بذمته علي الاصح، فيطالب به او بما بقي منه فاضلا عن الرقبة بعد العتق واليسار، والسيد مخير بين ان يفديه او يسلمه ليباع في الجناية، فان اختار الفداء فداه بالاقل من قيمته او ارش الجناية علي الاصح، وعلي قول: يفديه بالارش بالغا ما بلغ، فان قتله اجنبي، او قتله المالك او اعتقه، وقلنا: ينفذ عتقه، وجبت قيمته، وابعد من طرد القولين في قتل السيد واعتاقه، واذا وجبت   القيمة علي الاجنبي تعلق بها حق المجني عليه، ويخير المالك بين ان يسلمها او يءدي الارش من غيرها.

  AUTO   فرع

 :
 اذا قال السيد: انا افديه، او قال: اخترت فداءه، فالتزمه، لم يلزمه علي المذهب، وابعد من الزمه ذلك، وذكر في وطءه الامة الجانية وجهين، وعلي الاصح: لو ضمن الارش اجنبي، فان لم نعلقه بذمة العبد لم يصح الضمان، وان علقناه بها صح علي الاصح، وضمان السيد والتزامه الفداء اولي بالصحة من الاجنبي.
 وضمان الدين الذي لا يتعلق بالرقبة اولي بالصحة من ضمان الارش، ولا خلاف في صحة ضمان ما يتعلق بكسبه كمهر النكاح ونفقته.

  AUTO   فرع

 :
 اذا تكررت جنايته، فان تخللها فداء كانت كل جناية كالجناية الاول يتخير فيها بين التسليم والفداء، فان اختار الفداء ففي قدره القولان، وان لم يتخلل فداء كان جميع الاروش كالارش الواحد، فيفديه باقل الامرين علي الجديد، وبجميع الاروش علي القديم.
 * * *

  AUTO   فصل في جناية ام الولد

 اذا جنت ام الولد وجب فداءها اتفاقا، ويفديها بالاقل، وابعد من طرد القولين، والاعتبار بقيمة يوم الجناية او يوم الاستيلاد؟ فيه وجهان، فان   تكررت جنايتها، فان لم يتخلل فداء فهي كجناية واحدة، وفي قدر الفداء الطريقان، وان تخلل الفداء: فهل يلزم الفداء فيما سوي الجناية الاول؟ فيه قولان، فان قلنا: لا يجب، فان كان قد فداها بالقيمة، قسمت بينهما علي قدر الجنايتين، واخذ الثاني ما يخصه من الاول، وان نقصت الجناية الاول عن القيمة اخذت بقيتها من المالك وقسم الجميع بينهما علي قدر الجنايتين، وشبهه الاصحاب بمن حفر بءرا مضمنة ثم مات عن الف درهم، فاقتسمها الورثة، فهلك بالبءر بهيمة قيمتها الف درهم، فانا ننقض القسمة وندفع القيمة الي مالك البهيمة، فان هلك فيها بهيمة اخري، استرد صاحبها من الاول ما يقتضيه المحاصة، وكلما هلك فيها شء استرد من الاولين ما تقتضيه المحاصة.
 * * *



  AUTO   باب التقاء الفارسين واصطدام السفينتين

 اذا اصطدم راكبان او ماشيان، فهلكا وهلكت الدابتان، فان كانتا متقابلتين وتعمدا ذلك، فعلي كل واحد منهما نصف دية الاخر ونصف قيمة دابته؛ لاشتراكهما في الاتلاف، وعلي كل واحد كفارة عن صاحبه، وفي تكفيره عن نفسه خلاف، ولا نظر الي تفاوتهما وتفاوت الدابتين في القوة والضعف، الا ان يعلم انه لا اثر لاحدي الصدمتين، ولا يشترط العلم بتاثير الصدمتين، بل يكفي الامكان في ذلك اعتبارا بتفاوت الجرحين، ثم تجري اقوال التقاص فيما يلزمهما، فان فضل لاحدهما شء رجع به.
 وقال صاحب"التلخيص": ان سقطا منكبين اهدرت دياتهما، وان سقطا مستلقيين كملت الديتان، وان استلقي احدهما وانكب الاخر اهدر المستلقي وكملت دية المنكب.
 وغلطه جميع الاصحاب، فان سقوطهما يدل علي اضافة الهلاك اليهما.
 وان لم يقصدا الصدمة كان ذلك شبه عمد، فعلي عاقلة كل واحد منهما نصف دية مغلظة.
 وان وقع ذلك خطا، فان كانا مدبرين او اعميين، او وقع ذلك في ظلمة تمنع من الرءية، فعلي عاقلة كل واحد نصف الدية مخففا.



 وان حصل الاصطدام بغلبة الدابتين: فهل يهدران، او يكون خطا محضا؟ فيه قولان.

  AUTO   فرع

 :
 اذا تجاذب اثنان حبلا، فانقطع فسقطا فماتا، فان كان الحبل لاحدهما والثاني ظالم، اهدر الظالم وعلي عاقلته نصف دية المظلوم، وان كان الحبل لهما او مغصوبا فهو كاصطدام الراكبين، وعلي قياس صاحب "التلخيص" تهدر الديتان ان استلقيا ويكملان ان انكبا.

  AUTO   فرع

 :
 اذا اصطدم عبدان وقلنا بالتقاص، سقطت القيمتان بالتقاص، فان فضل لاحدهما شء سقط لفوات محله، وان اصطدم حر وعبد وجب نصف قيمة العبد، وتعلق بها نصف دية الحر.

  AUTO   فرع

 :
 اذا قتل العبد الجاني او المرهون، فلم يطالب المالك بقيمته، فالوجه اثبات المطلب للمرتهن وللمجني عليه.

  AUTO   فرع

 :
 اذا اصطدم حرتان حاملان فاجهضتا وهلكتا، فعلي عاقلة كل واحدة منهما نصف دية الاخري ونصف الغرتين؛ لاشتراكهما في قتل نفسيهما وقتل الجنينين، وعلي كل واحدة ثلاث كفارات، وفي الكفارة الرابعة وجهان.
 ولو اجهضت المراة بجناية نفسها او بمعالجة، وجبت الغرة، ولم   ترث منها شيءا.
 * * *

  AUTO   فصل في اصطدام المستولدتين

 اذا اصطدم مستولدتان لرجلين، وقلنا بالتقاص وايجاب اقل الامرين، فان استوت القيمتان فلا شء للمالكين، وان تفاوتتا فعلي صاحب الخسيسة التفاوت لصاحب النفيسة، فاذا كانت قيمة الخسيسة مءة وقيمة النفيسة مءتين، فلصاحب النفيسة نصف التفاوت وهو خمسون.
 وان كانتا حاملتين بحرين، ولم يكن للحرين وارث سوي المالكين، فان تساوت القيمة اهدرت القيمتان والغرتان، وان كانت احداهما مءة والاخري مءتين، وقيمة كل غرة اربعون، فلصاحب النفيسة ثلاثون؛ لان نصف قيمتها مءة ونصف الغرة عشرون، ونصف قيمة الخسيسة خمسون ونصف الغرة عشرون، فيقع التقاص بينهما فيبقي ثلاثون؛ لان الفداء بالاقل يقتضي ذلك، فيتقاصان في سبعين بسبعين، فيبقي ثلاثون.
 وان كان لكل واحد من الجنينين ام ام، فلكل واحدة منهما سدس الغرة.
 * * *

  AUTO   فصل في اصطدام الصبيين

 اذا ركب صبيان واصطدما فماتا، فان ركبا بانفسهما فعلي كل واحد نصف قيمة دابة الاخر، وعلي عاقلة كل واحد منهما نصف دية مخففة ان كانت الصدمة خطا، وان اصطدما مقبلين وقلنا: لا عمد لهما، فعلي العاقلة   نصف الدية مخففا، وان قلنا بالعمد فعلي العاقلة نصف الدية مغلظة؛ لان اصطدامهما مقبلين شبه عمد.
 وان اركبهما اجنبي لزمه قيمتان، وعلي عاقلته ديتان، فان الاجنبي اذا اركب الصبي ضمن ما تتلفه الدابة بالوطء او الرفس او غيرهما.
 وان اركبهما اجنبيان فعليهما قيمتان، وعلي عاقلتهما ديتان.
 وان اركبهما الوليان، فان لم تكن مصلحة فهما كالاجنبيين، وان كانت مصلحة فالاصح اهدار القيمة والديتين، وقال الامام: ان كانت الدابة شرسة جموحا وجب الضمان، وان لم تكن كذلك وغلب علي الظن السلامة، فان [كان] (¬) الركوب لزينة او حاجه قريبة ففيه الخلاف، وان كان لحاجة نقلة لا بد منها فلا ضمان، كما لو فصده براي الاطباء فهلك، فانه لا يضمن.
 * * *

  AUTO   فصل فيمن هلك برمي المنجنيق

 اذا قصد معينا برمي المنجنيق فهلك وجب القود، وان رمي جماعة لا يمكن قصد احدهم، وهو يعلم انه يصيب واحدا غير معين، لم يجب القود؛ كما لو اكره انسانا علي قتل رجل من رجال، فان العمد لا يتحقق الا بقصد في معين، ولو علم انه لو قصد الجميع لاتي عليهم واحدا بعد واحد، وقال المكره: اقتل هءلاء وان ابقيت منهم احدا قتلتك، وجب القود عند الامام.



 وان رمي عشرة بالمنجنيق، فرجع الحجر عليهم فقتل احدهم، سقط عشر ديته ووجبت بقيتها علي عاقلة اصحابه، وان قتل الجميع سقط العشر من دية كل واحد منهم، ووجبت البقية علي عواقل الباقين.
 * * *

  AUTO   فصل في اصطدام السفن

 اذا اصطدم سفينتان في كل واحدة منهما عشرة انفس مثلا، فهلكتا بما فيهما من الانفس والمتاع، فان كان بفعل الملاحين، فان كانا مالكين للسفينتين متبرعين بالحمل، فان عمدا عمدا يغلب من مثله التكسر والغرق فهما شريكان في قتل العشرين، فان هلكوا معا اقرع بين اولياءهم، فمن خرجت قرعته قتل الملاحين، ويجب في تركة كل واحد منهما تسع عشرة دية ونصف لاولياء الباقين، وعلي كل واحد عشرون كفارة وقيمة نصف السفينتين بما فيهما من المتاع.
 وان تعمدا صدما لا يغلب من مثله الهلاك فهذا شبه عمد، فعلي عاقلتيهما عشرون دية، وعلي كل واحد منهما عشرون كفارة مع قيمة نصف سفينة الاخر بما فيها من المتاع، وكذلك ان كان الصدم خطا، الا ان الدية مخففة علي العاقلتين.
 وان كانا غير مالكين، وهما متبرعان او اجيران، فحكمهما حكم المالكين الا انا لا نهدر شيءا من قيمة السفينتين وما فيهما من المتاع، فان فعل المالك مهدر في ملكه بخلاف الاجير والامين، فانه يضمن في الخطا والعمد.



 هذا ان وقع الصدم بفعل الملاحين، فان وقع بغلبة الريح وعجزا عن دفعه، فان كانا مالكين او متبرعين ففي الاهدار قولان، وهذا اولي بالاهدار من غلبة الدابة في الاصطدام؛ لغلبة الرياح في البحار، فان قلنا: لا يهدر، فهو خطا محض، هذا اذا غلبت الريح والقلوع مشرعة في المرسي، فاما اذا اجريا السفينتين فغلبتهما الريح، ففيه القولان علي الاصح، وابعد من قطع بايجاب الضمان.
 وقال الامام: ان تجاريا بحيث يفرض وقوع التصادم عند اغتلام البحر وهيج الريح وجب الضمان، وان تقاربا قربا يغلب من مثله العجز عن دفع الاصطدام فلا يجوز ان يختلف في الضمان، فان افراط القرب سبب في الاصطدام.
 وان كانا اجيرين مشتركين فان ضمنا المالكين وجب الضمان علي الاجيرين، وان لم نضمن المالكين، فلا ضمان علي الاجيرين ان جعلناهما امينين، وان جعلناهما ضامنين فلا ضمان في النفوس، ويضمنان المتاع، الا ان يكون اربابه من جملة الركبان فلا يلزمهما الضمان، وكذلك يضمنان الرقيق ان لم تستحفظهم السادة في المتاع، وان استحفظوهم فيه، فلا ضمان [فيهم] (¬) ولا في المتاع؛ لان ايديهم ايدي السادة، ومن كانت يده علي شء لم يكن في يد غيره.

  AUTO   فرع

 :
 اذا قلنا بالاهدار، فاختلف الركبان والملاح في غلبة الرياح، فالقول   قول الملاح ان كان امينا او مالكا، وان كان اجيرا: فان جعلناه امينا فالقول قوله، وان جعلناه ضامنا فلا معني لهذا الاختلاف فيما يضمنه باليد.
 * * *

  AUTO   فصل في القاء المتاع في البحر لخوف الغرق

 اذا خيف الغرق لاغتلام البحر وثقل المتاع، فالقي انسان متاعه دفعا للغرق، فان كان في تلك السفينة لم يرجع علي احد اتفاقا، وكذلك ان كان في سفينة اخري، علي ما دل عليه كلام الاصحاب، ولو اوجر طعامه لمختار لم يرجع اتفاقا، فان اوجره لمضطر فوجهان.
 ولو قال رجل في سفينة اخري لصاحب المتاع: الق متاعك في البحر وعلي ضمانه، فان لم يكن خوف لم يضمن، كما لو قال: خرق ثوبك، او: اقتل عبدك، وعلي الضمان، فان خيف الغرق، فان لم يكن مالك المتاع في السفينة صح الضمان اتفاقا، وان كان فيها وحده لم يصح، وان كان معه غيره لزمه جميع الضمان عند الشافعي واصحابه، وقال القاضي: يوزع علي رءوسهم، فيلزمه حصته ولا شء علي بقية الركبان.
 ولو كان الضامن والمالك في السفينة: فهل يلزمه الجميع، او ما يخصه؛ فيه الخلاف، فان اوجبنا الجميع فله احوال (¬):
 احداهما: ان يصرح بضمان الجميع، فيلزمه.
 الثانية: ان يصرح بما يقتضي التوزيع، مثل ان يقول: انا والركبان   ضامنون، فيلزمه ما يخصه، الا ان يقول: اردت ضمان الجميع، فيلزمه الجميع، فان تنازعوا في الارادة فالقول قوله مع يمينه.
 فان قال: انا ضامن وركبان السفينة، او: انا ضامن والركبان ضامنون، لزمه الجميع عند الشافعي، وقال المزني: يلزمه ما يخصه، فخرجه بعضهم قولا، وقطع بعضهم بما قال المزني، وحمل النص علي اصل الضمان، وان قال: اردت بهذا القول التقسيط لم يقبل الا علي قول المزني.
 واذا اضاف الضمان الي الركبان، ثم قال: اردت انهم اقروا بالضمان، فان صدقوه لزمهم ذلك، وان انكروا حلفوا، وان قال: اردت انشاء الضمان عنهم، فان رضوا بذلك لزمهم عند الاصحاب، وخرجه القاضي علي قولي وقف العقود؛ لان الرضا اجازة وليس بانشاء، وكذلك لو قال لانسان: طلقت امراتك واعتقت (¬) زوجتك، فقال ة رضيت، لم يقع الطلاق والعتق مع قوتهما.

  AUTO   فرع

 :
 اذا صح الضمان لم يزل الملك عن المتاع بالقاءه، فان ظفر به مالكه اخذه ورد ما اخذه من الضمان، وهل يتعين حق الضامن فيه، ام يجوز ابداله؛ فيه وجهان، وحيث صححنا الضمان وطلب الالقاء ولم يعرض للضمان، ففي وجوبه وجهان.



  AUTO   فرع

 :
 اذا خرق سفينة فاغرقها بما فيها، وجب ضمانها بما فيها من النفوس والاموال، وعليه كفارات النفوس، وان تعمد وجب القود، وان خرقها خرقا لا يغلب من مثله الغرق فهو شبه عمد، كان قصد الاصلاح فمال القدوم فخرقها، فهو خطا محض.

  AUTO   فرع

 :
 اذا وضع عدلا في سفينة، فاغرقها بما فيها: فهل يضمنها بما فيها، او يضمن النصف، او ما يقتضيه التوزيع بالوزن؟ فيه ثلاثة اوجه.
 * * *



  AUTO   باب بيان العاقلة الذين يغرمون

 دية الخطا وشبه العمد علي العاقلة اجماعا، والعاقلة: عصبة النسب والولاء وبيت المال، ولا اثر للتحالف في عقل ولا ارث، فان كان الجاني غريبا لا يعرف له عاقلة، بحث الحاكم عنها، فان لم يجدها ضرب العقل علي بيت المال، ولا يضرب علي جنسه ولا علي اهل بلده، كان انتسب الي طاءفة فصدقوه: فان ثبت النسب لزمهم العقل، وان لم يثبت فوجهان.
 * * *

  AUTO   فصل في معرفة العاقلة

 العاقلة: كل ذكر حر بالغ عاقل عصبة للقاتل بنسب او ولاء، وفي العتيق قولان، ولا يعقل مسلم عن كافر ولا كافر عن مسلم، ويعقل الذمي عن الذمي ان اتحدت ملتهما، وان اختلفت فقولان.
 ولا يعقل صبي، ولا مجنون، ولا امراة، ولا فقير كسوب، وفي الزمن الموسر المايوس من برءه وجهان.
 ويجب علي الغني نصف دينار، وعلي المتوسط ربع دينار، وذلك حصة سنة، او حصة للسنين الثلاث؟ فيه وجهان.
 * * *



  AUTO   فصل في كيفية الضرب علي العاقلة

 دية الخطا وعمد الخطا مءجلة بثلاث سنين، في كل سنة ثلثها، اذا كان القتيل حرا مسلما، سواء وجبت علي الجاني، او علي العاقلة، او بيت المال، ولا تضرب علي اصول الجاني وفروعه اتفاقا، وكذلك لا تضرب عليه مهما امكن الضرب علي العاقلة، فاذا تم الحول نظر الي درجات العصبات وترتبوا ترتبهم في الارث، الا في الاصول والفروع، فاذا كان في بعض الدرجات من يدلي بالابوين ومن يدلي بالاب، ففي تقديم المدلي بالابوين قولان، فنبدا بالدرجة الاول فنضرب علي غنيهم نصف دينار وعلي متوسطهم ربعا، فان بقي شء من النجم ضرب علي الدرجة الثانية كذلك، فان بقي شء ضرب علي الثالثة، ثم علي الرابعة، فان بقي شء فعلي المعتق، فان لم يكن فعلي عصباته، فان لم يكن له فعلي معتقه، فان لم يكن فعلي عصباته، علي ما تقدم في الارث، فان لم يكن فعلي بيت المال.
 ومهما قام اهل درجة بالنجم لم نعدل الي من دونهم، واذا انتهي الامر الي عصبات المعتق فلا عقل علي اصوله وفروعه عند المعظم، وفيه وجه.
 وابتداء الاجل من حين القتل، ولا يقف شء من الاجال علي ضرب الحاكم الا اجل العنة، وان قطع يد انسان او يديه، فابتداء الاجل من حين القطع اتفاقا، فان حال الحول قبل الاندمال، ففي مطالبة العاقلة خلاف كالخلاف في مطالبة العامد قبل الاندمال، ولو قطع اصبعا فتاكل بذلك الكف، فالاجل من حين القطع، وابعد من جعله من حين سقط الكف.



  AUTO   فرع

 :
 الغني: من يملك عشرين دينارا او ما يساوي قيمتها، بعد ما يحتاج اليه من المسكن والخادم وغيرهما مما يعتبر في الكفارات، والمتوسط: من يملك دون العشرين فاضلا عما يعتبر في الكفارة، بشرط ان لا يرده ربع دينار الي رتبة الحاجة، ومتي بقي شء من النجم فاوجبناه علي الجاني او بيت المال، اخذ منه تمام النجم وان زاد علي النصف والربع.

  AUTO   فرع

 :
 الاعتبار في صفة المتحمل باخر الحول دون ما قبله وما بعده، فان مات قبل الحول، او كان موسرا فاعسر عند الحول، فلا شء عليه لذلك الحول وان ايسر بعد ذلك، وان كان موسرا عند الحول فاعسر بعد ذلك، لم يسقط ما لزمه، بل يءخذ منه اذا ايسر، وان مات اخذ من تركته، ولا يءخذ من بيت المال، ولا تقوم ابل الدية الا في اخر الحول، فاذا قومت ضربت القيمة علي العاقلة.

  AUTO   فرع

 :
 لا يضرب العقل علي عصبات المعتق الا بعد موته، فيضرب علي كل واحد منهم ما كان يضرب علي المعتق اذا اتفقا في التوسط او اليسار، فان اعتقه اثنان لزمهما ما يلزم المعتق الواحد، فيلزمهما نصف او ربع، فان اختلفا في التوسط واليسار، وجب علي الموسر ربع دينار، وعلي المتوسط ثمن، فان مات المعتقان او احدهما، وجب علي كل واحد من عصباتهما مثل ما كان يلزم المعتق، فان اعتقه ستة انفس فعلي كل واحد من عصبة كل   واحد منهم نصف سدس دينار، وان اختلفت الدرجة في عصبات المعتق: فهل تختص الدرجة القربي بالتحمل، او توزع علي القريب والبعيد؟ فيه تردد، والاصح الضرب علي الجميع.

  AUTO   فرع

 :
 اذا كان ابن الجاني معتقا او ابن عمه، لزم العقل علي اقيس الوجهين.
 * * *

  AUTO   فصل في ضرب العقل علي الجاني

 اذا ضرب علي العاقلة ما يخصها، فبقي من النجم شء ضرب علي بيت المال من سهم المصالح، فان لم يكن في بيت المال شء، ففي الضرب علي الجاني قولان مبنيان علي القولين في ان الوجوب: هل يلاقيه ام لا؟ فان قلنا: لا يضرب عليه، وبذلك قطع القاضي، فايسر بيت المال بعد ذلك، فوجهان:
 احدهما: لا يضرب علي بيت المال؛ اعتبارا بيسار العاقلة بعد الاعسار.
 والثاني: يضرب عليه، فانه مرصد للمصالح من غير تقيد بزمان، بخلاف العاقلة فان الضرب عليهم مقيد بالحول، فاذا اعسرت بعد الحول فلا عبرة باليسار بعده.
 ولا وجه لما قطع به القاضي؛ لانه مخالف لجميع الاصحاب.
 ويمكن تخريج الخلاف في تغريم القاتل علي الخلاف في يسار بيت المال، فان قلنا: يءخذ منه اذا ايسر، فلا غرم علي الجاني، وان قلنا: لا يءخذ منه شء، وجب تغريم الجاني كيلا تهدر الدماء.



 ولو اقر بجناية الخطا، فان صدقته العاقلة لزمها الدية، وان اكذبته فلا تضرب عليها ولا علي بيت المال، بل تضرب عليه اجماعا من الاصحاب، وقال الامام: ينبغي ان يخرج علي الخلاف في ملاقاة الوجوب، فان قلنا: لا يلاقيه، لم يضرب عليه؛ لانه اقر علي غيره، فان غرم الدية ثم صدقته العاقلة، لزمها الغرم، وهل يرجع بما غرم علي العاقلة، او علي ولي الدم؟ فيه وجهان، فان قلنا: يرجع علي الولي، رجع الولي علي العاقلة.
 * * *

  AUTO   فصل في اجل الديات الناقصة

 اذا كان القتيل حرا مسلما فدية نفسه مءجلة بثلاث سنين باجماع المسلمين، وهل ذلك التاجيل لمقدارها، او لكونها دية نفس؟ فيه وجهان.
 وغرة الجنين علي العاقلة اتفاقا، وهل تتاجل بثلاث سنين؛ فيه وجهان يجريان في الديات الناقصة؛ كدية المجوسي والمراة المسلمة، فان قلنا: لا تتاجل بالثلاث، فاجل دية المجوسي سنة، واجل دية المراة المسلمة في سنتين: في الاول ثلث دية كاملة، والباقي في السنة الثانية.

  AUTO   فرع

 :
 اذا اشترك جماعة في القتل ضربت حصة كل واحد في ثلاث سنين علي المذهب، وقيل: ان كانت حصة كل واحد ثلث الدية فما دون، ضربت في سنة واحدة، فان قتل واحد ثلاثة، فان نظرنا الي القدر تاجلت بتسع سنين، وان نظرنا الي النفس فالاصح التاجيل بثلاث سنين، وابعد من اجلها بالتسع.



 وقال الامام: ان اعتبرنا النفس تاجلت بثلاث، وان اعتبرنا القدر فوجهان؛ لامتياز كل نفس عن الاخري، بخلاف قطع اليدين والرجلين من شخص واحد فان اختلف تاريخ قتل الثلاثة وجب في كل قتل ما يخصه عند تمام حوله ثم يفعل كذلك الي تمام التسع او الثلاث.
 وان قتل امراتين: فان اعتبرنا القدر فالديتان في ثلاث، وان اعتبرنا النفس: فثلاث او ست؟ فيه وجهان، وعلي راي الامام: ان اعتبرنا النفس فثلاث، وان اعتبرنا القدر: فثلاث او سنتان؟ فيه وجهان.
 * * *

  AUTO   فصل في عقل الرقيق

 اذا كان القتيل عبدا، ففي قيمته قولان:
 احدهما: تجب حالة علي القاتل.
 والثاني وهو اقيس: تجب مءجلة علي العواقل، فان بلغت دية كاملة تاجلت بثلاث، وان زادت علي الدية بقدر يسير تاجل ذلك القدر بالسنة الرابعة اتفاقا، فان الارش اليسير لا ينقص اجله عن سنة اتفاقا، وان بلغت ديتين، فالاجل ست ان نظرنا الي القدر، وان نظرنا الي النفس فثلاث.
 * * *

  AUTO   فصل في عقل الارش

 المذهب: ان اروش الاطراف علي العاقلة، وفيها قولان اخران بعيدان:
 احدهما: لا يلزم العاقلة بحال.



 والثاني: لا يلزمها الا قدر ثلث الدية الكاملة فما زاد.
 وعلي كلا القولين تجب علي الجاني، وما اظن احدا يجعلها حالة كقيم المتلفات.
 فان قطع يدي مسلم فالاجل ثلاث اتفاقا، لانها تشبه دية النفس جنسا وقدرا ووصفا، وابعد من قال: ان نظرنا الي النفس ضربت في سنة.
 ولو قطع احدي اليدين، فان اعتبرنا القدر، وجبت في السنة الاول ثلث الدية، وفي الثانية سدسها، وعلي الوجه الاخر: تجب في ثلاث سنين، واذا قلنا بالاصح، فدية يدي المراة في ثلاث اعتبارا بدية نفسها، ودية احدي يديها في سنة اتفاقا، فان الارش اذا نقص عن دية المجني عليه نظر الي القدر اتفاقا.
 وان قطع يدي حر مسلم ورجليه، فان نظرنا الي القدر فالاجل ست سنين، وان نظرنا الي النفس: فست او ثلاث؟ فيه وجهان، وابعد من قال: تتاجل الاروش سنة واحدة وان بلغت ديات، فيحصل ثلاثة اوجه.

  AUTO   فرع

 :
 اذا جني الرجل علي نفسه او طرفه خطا، لم تحمله العاقلة، وفي الطرف قوله بعيد: انها تحمل ارشه ويجب طرده في دية النفس، ولا سيما ان جعلت للورثة ابتداء.
 * * *



  AUTO   باب عقل الموالي

 اذا جني من ابوه عبد وامه عتيقة، فعتق ابوه بعد الجناية، فانجر الولاء الي موالي الاب، فللجناية احوال:
 فان كانت الجناية قتلا فالدية علي موالي الام، ولا تنتقل الي موالي الاب نظرا الي حال القتل، وهذا يدل علي وجوب الدية بالقتل، ويلزم منه صحة الابراء عنها قبل حلول النجوم.
 وان كانت الجناية جرحا، فسري بعد عتق الاب، فارش الجرح علي موالي الام، وبقية الدية علي الجاني دون موالي الاب وبيت المال، كما لو اوضح ذمي انسانا ثم اسلم، فسرت، فارش الموضحة علي عاقلة الذمة، والباقي عليه دون عاقلة المسلمين وبيت المال، وان كان الجرح موجبا للحكومة، فقد اوجبها الاصحاب علي موالي الام، وهذا مشكل، فان الجرح لم يندمل، لكن ينبغي ان يجعل وقت انجرار الولاء كالاندمال، فيقوم حينءذ من غير تقدير اندمال، وان سري الجرح بعض السراية ولم يسقط من الطرف شء، فان كان الارش مقدرا لم يضرب علي موالي الام سواه، وان لم يتقدر ضرب مع السراية علي موالي الام، فان السراية تتبع المقدرات دون الحكومات.
 وان كانت الجناية بقطع اليدين، او اليدين مع الرجلين، فسرت بعد   عتق الاب، فجميع الدية علي موالي الام.
 وان كانت الجناية بان قطع يديه، ثم قتله بعد عتق الاب وقبل الاندمال، فعلي النص: تجب دية واحدة علي موالي الام، وعلي قول ابن سريج: تجب دية علي موالي الاب، ودية اخري علي موالي الام.
 وان قطع احدي يديه، ثم قطع الاخري بعد عتق الاب، او قطعها مع الرجلين بعد عتق الاب، فتجب نصف الدية علي موالي الاب، ونصفها الاخر علي موالي الام.
 وان اوضحه ثم قطع يده بعد عتق الاب، فمات بالسراية، فارش اليد علي موالي الاب، وارش الايضاح علي موالي الام، والباقي علي الجاني.

  AUTO   فرع

 :
 اذا جني الذمي ثم اسلم فحكمه كحكم المتولد بين الرقيق والعتيقة في جميع ما ذكرناه، ويجعل اسلامه كعتق الاب، وما لا يضرب علي عاقلته المسلمين فلا يضرب علي بيت المال.
 * * *



  AUTO   باب اين تكون العاقلة

 اذا حضر اهل الدرجة البعدي وغاب اهل القربي المستوعبون لجميع الواجب، فايسر قريب المسافة، لم تضرب الدية علي البعدي، وكذا ان بعدت علي اقيس القولين، فان قلنا: لا تضرب، كتب الحاكم الي قاضي الناحية التي فيها اهل الدرجة القربي لياخذ منهم ما لزمهم، وان قلنا: تضرب علي البعدي، لم يجب للولي اخذ الدية الا باذن الامام، فان اخذها باذن الامام ثم حضرت القربي، ففي رجوع البعدي علي القربي بما غرمت احتمال، ولا تعتبر البعدي بمسافة القصر، وضبطه الامام بما لا يمكن تحصيل النجم منه في سنة.

  AUTO   فرع

 :
 اذا لم تعلم العاقلة بالجناية حتي انقضت السنة، اخذ منهم العقل اذا وجدوا.

  AUTO   فرع

 :
 اذا كثرت العاقلة وقل الارش بحيث يشق جمعهم وتقسيطه عليهم، فالاصح توزيعه علي الجميع؛ كما لو اتلفوا نصف درهم علي انسان، وفيه قول: ان للامام ان ياخذ ممن شاء، ولا رجوع لهم علي الباقين، ولو عين   الولي واحدا منهم بغير اذن الامام (¬)، ففي جوازه تردد.
 * * *

  AUTO   فصل في عقل الذمي

 اذا قتل الذمي مسلما فديته علي عاقلته الذمة، وان قتل ذميها خرج علي التفصيل في ترافعهم الينا، فان كانت عاقلته مسلمة او حربية فالدية في ماله، ولا شء منها علي ابنه وابيه، وابعد من اوجب علي ابنه وابيه نصف دينار او ربعه، وابعد من جعل الدية عليهم اثلاثا. وان كانت عاقلته ذمة في دار الحرب فان قربت المسافة فالدية عليهم، وان بعدت بحيث لا يمكن التحصيل في السنة، ففيه القولان المذكوران في الضرب علي الاباعد اذا غاب الاقارب.

  AUTO   فرع

 :
 المعاهد فيما ذكرناه كالذمي ان اتسع عهده لاجل الدية، فان كان العهد سنة واحدة، فحصتها علي العاقلة والباقي في ماله.
 * * *



  AUTO   باب وضع الحجر حيث لا يجوز وضعه

 اذا سم طعاما واضاف به انسانا فهلك، ففي الضمان قولان، وان سم بعض الطعام وامكن الضيف ان يكتفي بغير المسموم وان لا ياكل المسموم، فقولان مرتبان.
 وان حفر بءرا في ملكه فهلك بها انسان، لم يجب الضمان، وان دعاه فسقط فيها، فان كانت في طريق ضيق لا طريق للمالك سواه ولم يمكن الضيف العدول عنها، فان كانت مغطاة او في ظلمة، فقولان رتبهما بعضهم علي اكل الطعام المسموم، فانه تعاطي باكله السبب المتلف بخلاف دخوله الي الدار، وان كانت ماءلة عن الطريق يمكن العدول عنها، فلا ضمان علي الاصح، وقيل: علي القولين في البءر المحتفرة في الطريق.

  AUTO   فرع

 :
 اذا حفر في ملكه بءرا للفضلات، فانهارت، فتندي جدار جاره فانهدم، لم يضمن اتفاقا؛ لاحتياج الاملاك الي الارتفاق بالبالوعات والابار.
 واتفق اهل التحقيق علي انا نشترط في ارتفاق الملك الاقتصاد المعتاد، فان حفر البءر في ارض حوارة ولم يطوها بالطوب، او في حجرة ضيقة ستنهار فيها الحجرة، وجب الضمان، فان هذا لا يعد ارتفاقا بالملك.



 ولو اجج نارا لخبز او طبخ او غيرهما، فطارت شرارة منها الي كدس (¬) او دار فاحرقت ذلك، فان اقتصد علي العادة لم يضمن، وان خرج عن العادة بتاجيج نار لا تحتمل مثلها تلك الدار ضمن، وهكذا الحكم في شتي البساتين.
 والضابط: ان الرجوع في ذلك كله الي العادة، فان اختلف في شء منه فهو للاختلاف في العادة، وكل مالو فعله الولي في مال الطفل لضمن به، فان المالك يضمن بمثله ما يفسده علي جاره.
 ولو وضع علي السطح جرة او حجرا، فسقطت، لم يضمن ما يتلفه الا ان يخرج علي المعتاد.
 ولو اجج النار علي السطح او بقرب السطح، فان كان في وقت هبوب الرياح بحيث يغلب علي الظن طيران شرارها ضمن، وان كانت الريح ساكنة نادرة الهبوب، فهبت الريح ولم يتمكن من اطفاءها، لم يضمن.
 ومتي فعل شيءا مما ذكرناه لغير منفعة ولا تقصير لم يضمن، فان التصرف المقتصد في الملك لا يوجب الضمان، الا ان يحفر بءرا في ملكه في الحرم، فيهلك به صيد، ففي الضمان وجهان.

  AUTO   فرع

 :
 اذا بني الجدار مستقيما، فسقط او مال الي ملكه فتركه، فطارت قطع منه الي خارج الملك فاتلفت شيءا، لم يجب الضمان.
 * * *



  AUTO   فصل في حفر البءر في الشوارع وفي الموات

 اذا نصب في الموات اعلاما او احجازا، او حفر فيه زبية (¬) او ابارا، قاصدا للتملك او غير قاصد، فهلك بذلك شء، لم يضمنه، الا ان يحفرها في موات الحرم، فيضمن الصيد اتفاقا، ولو فعل ذلك في ارض مغصوبة وجب الضمان.
 وان حفر بءرا في شارع او مكان يرتفق به الناس، فان كان الطريق ضيقا قد يغلب علي الظن السقوط فيها والتاذي بها، ضمن ما يتلف بها، وان اذن الامام في ذلك لم يجز، ولم يسقط الضمان؛ لان اذنه علي خلاف الشرع عدوان، وان كان الطريق واسعا لا يشق علي سالكها توقي البءر: فان حفرها لغرضه بغير اذن الامام ضمن، وكذا ان اذن علي الاصح، وان حفرها لمنفعة الناس كالاستقاء وانصباب مياه الميازب فطريقان:
 احداهما: ان استاذن الامام لم يضمن، وان لم يستاذن فقولان.
 والثانية: ان لم يستاذن ضمن، وان استاذن فقولان.
 ولو اذن الامام ابتداء في الحفر، فلا نوجب الضمان لتقصيرهم في حفظها او جهلهم بصفتها.
 وارتفاق الملاك بالشوارع ان منعناه ضمن، وان اجزناه: فان خفت الحاجة اليه كالاجنحة والعوامل وجب الضمان، وان اشتدت كالميازيب وقشور البطيخ والقمامات فوجهان.



  AUTO   فاءدة

 :
 قال الامام: كل ما ابحناه بشرط سلامة العاقبة كاشراع القوابيل فاذا تلف به شء تبين انه غير مباح، وعلي هذا: يجب ان يرعي في اخراج القابول (¬) من الاحكام في الابتداء، والصون عن السقوط في الدوام، ما لا يرعي في الملك، فان احكمه فسقط برجة او صاعقة، فلا ضمان عند الامام؛ تعليلا منه: بان المباح الحقيقي لا يوجب الضمان.
 وبناء الجدار في الملك مردد بين التصرف في الملك والارتفاق بالشارع، فان بناه ماءلا الي الشارع كان طرفه الماءل كالجناح، وان بناه مستقيما فمال الي الطريق، فان لم يمكنه استدراكه لم يضمن، وكذا ان تمكن علي الاصح، ولو فرق بين ان يعلم بالميل فيمهل الاستدراك وبين ان لا يعلم، لكان متجها، ولم ار ذلك لاحد من الاصحاب.

  AUTO   فرع

 :
 اذا حفر بءرا مضمنة، فهلك بها شء بعد موته، تعلق بتركته من ذلك ما كان يتعلق بها في حال الحياة، فتتعلق بها القيمة والكفارة والدية علي العاقلة.
 * * *

  AUTO   فصل في وضع الحجر في الطريق والقعود فيه والقيام

 اذا وضع حجرا في الطريق تعلق به الضمان اتفاقا، اذ ليس من مصالح



  CHECK   فصل فيمن القي انسانا [في بءر] حفرها غيره، او القي علي شفيرها حجرا

 الاستطراق، ولو قعد في الطريق او نام، فتعثر به انسان فهلكا، فالمذهب: ان الماشي مضمون والقاعد والناءم مهدران، فان القعود والنوم ليسا من مرافق الاستطراق.
 ولو تعثر الماشي بواقف، فالمذهب ان الواقف مضمون والماشي مهدر به؛ لان الوقوف من جملة رفق الطروق، فصار كجزء منه.
 وقيل: في المساءل قولان:
 احدهما: اهدار العاثر لانه الفاعل، وايجاب ضمان الواقف والقاعد والناءم.
 والثاني: اهدار القاعد والواقف والناءم، وايجاب ضمان العاثر، ولم يصر احد الي الحاقهما بالمصطدمين.
 وفي "التقريب" قول ثالث: انه يتعلق بكل واحد كمال دية الاخر.
 * * *

   فصل فيمن القي انسانا [في بءر] (¬) حفرها غيره، او القي علي شفيرها حجرا
 اذا حفر بءرا او نصب سكينا، فوضع اخر حجرا، فعثر به انسان، فسقط في البءر او علي السكين فهلك، فالضمان علي واضع الحجر؛ لانه كالدافع عليهما، والحافر وناصب السكين بمثابة من يهء الة للقتل، ولذلك قال الاصحاب: لو جر السيل حجرا فالقاه علي شفير البءر، او وضعه حربي،   فلا ضمان علي الحافر، ويلزم علي هذا: انه لو حفر بءرا بقرب نشز من الارض، فتعثر انسان بالنشز وسقط في البءر، فلا ضمان علي الحافر، ويلزم من ذلك: ان المتردي لا يضمن الا اذا [كان] (¬) ترديه بسبب تخطيه.

  AUTO   فرع للاصحاب

 :
 اذا نصب في يده سكينا، فدفع علي انساني، فهلك بالسكين، فان لم يحرك يده في صوبه او انخنس قليلا، فالضمان علي الدافع، وان حرك يده الي صوبه فالضمان عليه.
 وقال الامام: ان تلقاه بالسكين فالضمان عليه وعلي الدافع، وان لم يتلقه بها ولم يتمكن من طرحها فالضمان علي الدافع.
 ولو حفر بءرا، ونصب فيها اخر سكينا، فالضمان علي الحافر؛ لانه كالدافع.
 ولو حفر بءرا فعمقها اخر، فالضمان علي الاول؛ لانه كالدافع، وقيل: يجب الضمان عليهما وهذا يهدم ما قررناه من الدفع.
 ولو القاه من شاهق، فقده اخر بنصفين، فليسا بشريكين، بل القود والدية علي القاد، وابعد من اوجبهما علي الملقي وجعله منفردا بالقتل.
 * * *

  AUTO   فصل فيمن سقط في بءر فجذب غيره

 اذا وقع واحد علي واحد في بءر مضمنة من غير جذب، فديتهما علي   عاقلة الحافر، ويحتمل ان تجب دية الاول علي عاقلة الثاني، ثم يرجع بها علي عاقلة الحافر.
 وان وقع واحد فجذب ثانيا، والثاني ثالثا، فماتوا، فان اختلفت مساقطهم فدياتهم علي عاقلة الحافر، وان وقع الثاني علي الاول والثالث علي الثاني، فان عمدوا ففيه اوجه:
 احدها وهو المذهب وعليه الجمهور: انا نهدر الثلث من دية الاول، ونوجب ثلثها علي الثاني؛ لجذبه الثالث، وثلثها علي عاقلة الحافر لاجل صدمة البءر، فيسقط ما يقابل فعله وهو جذبه الثاني، وللثاني نصف الدية علي الاول، ويهدر النصف لاجتذابه الثالث، ويلزمه دية الثالث، ولا يخفي حكم ذلك ان كان خطا او شبه عمد.
 وفيه وجهان اخران بعيدان:
 احدهما: نهدر دية الاول والثاني؛ لانهما قطعا تسبب الحافر بمباشرتهما، وعليهما دية الثالث؛ لانه مات بجذبهما، وهذا باطل فان الثاني مات بجذب الاول وجذب الثالث، ولا وجه لابطال اثر الصدمة، فان اثرها محسوس.
 والوجه الاخر: نهدر نصف دية الاول، ويجب النصف الاخر علي عاقلة الحافر؛ لانه جذب الثاني وتسبب الي جذب الثالث، وتجب نصف دية الثاني علي الاول، ويهدر النصف لجذبه الثالث، وللثالث الدية علي الثاني، ومهما اضفنا جذب الثالث الي الثاني، فينبغي ان يقال: ان جذب الاول الثاني، فسقط بحيث لا يتماسك، فتعلق بالثالث، فالجذب مضاف الي الثاني وحده، وان جذبه بغتة وهو متعلق بالثالث قبل اعمال للفكر   والاختيار في ترك التعلق به، فهذا موضع النظر والاحتمال.
 وعلي الاصح: لو كانوا اربعة، فقد مات الاول باربعة اسباب فيهدر من الدية ربعها، والثاني بثلاثة فيهدر ثلثها، والثالث بسببين فيهدر نصفها، ودية الرابع علي الثالث.

  AUTO   فرع للامام

 :
 اذا اختصم اثنان فشهرا سيفين، فقتل كل واحد منهما الاخر، فادعي ورثة كل واحد منهما انه كان دافعا، حلفا واهدرت الديتان، فان فاءدة عرض هذه اليمين النكول. ولو التقي اثنان بسيفين، فظن كل واحد منهما ان الاخر صاءل عليه، وغلب علي ظنه انه ان لم يبادره اوقع به، فلكل واحد مدافعة الاخر علي تدريج دفع الصاءل، فان قتل كل واحد منهما الاخر اهدرنا ديتهما.
 * * *



  AUTO   باب دية الجنين

 للاجنة خمسة احكام: وجوب الغرة، والكفارة باجهاضه، وانقضاء العدة بوضعه، وثبوت الاستيلاد لامه، والارث منه، ولا يرث اذا انفصل ميتا.
 فاذا جني علي حامل فماتت من غير اجهاض، فلا شء في الجنين اتفاقا، وان اجهضت في حياتها او بعد موتها، فان كان الجنين حرا مسلما، وجبت الغرة لورثته علي فراءض الله تعالي، ويجب الارش في جرح الام ان بقي شين، وان لم يبق فوجهان، وان لم تكن الجناية الا بمجرد الم فلا ارش للام، وابعد من خالف فيه.
 وتجب الغرة مهما بدا في الجنين تخليق او تخطيط، ولو في بعض اعضاءه كالطفر او الشعر، والتخليق: ظهور شكل الاعضاء، والتخطيط: ظهور مراسم الاعضاء بالخطوط، فان القت لحما لم يظهر تخطيطه، فشهد القوابل بظهور التخطيط، واختصصن بمعرفة ذلك، حكم بقولهن، وان قلن: ليس بلحم ولد، لم يثبت شء من احكام الاجنة، وان شهدن بانه لحم ولد ففيه اختلاف نص، وان القت علقة او مضغة لم تنتظم انتظام اللحم، فشهدن بانها اصل الولد وقطعن بذلك، او تشككن في اللحم، لم يثبت شء من الاحكام الخمسة، وابعد من خالف في انقضاء العدة.
 * * *



  AUTO   فصل في صفة الغرة

 في الجنين الحر المسلم غرة: عبد او امة، وفي الكافر اوجه:
 احدها: فيه عشر دية امة، فتختص الغرة بالحر المسلم.
 والثاني: ان كان يهوديا او نصرانيا ففيه ثلث غرة الحر المسلم، وكذلك تعتبر هذه النسبة في الجنين المجوسي.
 والثالث: فيه عبد كامل نسبة قيمته الي دية الكافر كنسبة خمس من الابل الي دية المسلم.
 ولا تعتبر الغرة برقيق البلد ولا برقيق الغارم، بل يتخير الجاني بين العبد والامة اتفاقا، وكذلك يتخير في صنفها ونوعها، ولا تءخذ قيمتها مع وجودها الا بمعاوضة، ولا يجزء فيها معيب بعيب يرد به المبيع اتفاقا الا ان يرضي المستحق، ولا يجزء فيها الا مميز قد بلغ سبعا او ثمانيا، ولا يجزء ما اثر الهرم في حل قواه، ويجزء ما دون الهرم عند الجمهور.
 وقيل: لا يجزء ما بلغ العشرين.
 وقيل: لا يجزء ما بلغ خمس عشرة من الغلمان، ومن الجواري ما بلغ العشرين.
 واذا اجتمعت الصفات المشروطة، فكانت قيمة الغرة دينارا واحدا، اجزات عند الجمهور، وشرط القاضي ان تبلغ القيمة خمسا من الابل المجزءة في الدية او خمسين دينارا.

  AUTO   فرع

 :
 اذا وجد ولي الدم بالغرة او بابل الدية عيبا يرد بمثله المبيع، فله الرد   وان زادت قيمة ذلك علي القدر المستحق؛ كنظيره في المبيع اذا زاد علي قدر الثمن، فاذا رد ذلك رجع بالقدر المستحق ولم يرجع بقيمة المردود، ولو اشتري للطفل ما يزيد علي الثمن، فوجد به عيبا، وقيمته مع العيب زاءدة علي الثمن، فلا رد له ولا ارش.

  AUTO   فرع

 :
 الاعتياض عن الغرة كالاعتياض عن ابل الدية حرفا بحرف.
 * * *

  AUTO   فصل في فقد الغرة

 اذا فقدت الغرة علي ما ذكرناه في كيفية فقد الابل، ففيما يجب طريقان:
 احداهما: ان فقدها كفقد ابل الدية، فيرجع الي قيمة الغرة علي الجديد، والي المقدار الذي نذكره علي القديم.
 والطريقة الثانية، وهي الصحيحة: فيما يرجع اليه قولان:
 اصحهما: انه خمس من الابل المجزية في الدية، فان فقدت الابل: فهل تجب قيمتها، او خمسون دينارا؟ فيه القولان.
 والقول الثاني: تجب قيمة الغرة، ومتي اوجبنا قيمتها: فان نسبناها الي الدية بالجزية وجبت قيمة عبد يساوي خمسا من الابل، وان لم ننسبها الي الدية وجبت قيمة عبد له سبع سنين، سليم من العيوب، من احسن جنس يفرض.
 * * *



  AUTO   فصل فيما يجب في الجنين المتولد من مختلفي الدين

 المتولد من اليهود والنصاري كالمتولد من احدي الطاءفتين، والمتولد من اليهود والمجوس: معتبر باكثر ابويه دية، او باقلهما دية، او بابيه؛ فيه ثلاثة اوجه؛ اصحها وهو المذهب اولها.
 واحكام الاولاد اضرب:
 احدها: ما يتبع فيه ابويه وكل واحد منهما، وهو: الاسلام، وتحريم المتولد من الحلال والحرام كالبغال، واخذ الجزية من المتولد ممن يءخذ منه الجزية وممن لا يءخذ، وفي اسقاط الزكاة، ووجوب الجزاء في الاحرام، ومنع الاجزاء في التضحية والجزاء كالمتولد من الغنم والظباء، وفي اسقاط سهم الغناءم عن البغال.
 الثاني: ما يتبع فيه الاب، وهو النسب وما يبتني عليه؛ كالتزام الجزية اذا زادت علي دينار، والكفاءة في النكاح.
 الثالث: ما يتبع فيه الام، وهو الرق والحرية والنتاج.
 الرابع: ما يعتبر بالاغلظ؛ كسن الياس اذا اعتبرنا بنساء العشيرة، فكان حيض نساء الاب ينقطع علي ستين سنة، وحيض نساء الام ينقطع علي سبعين سنة، فالاعتبار بالسبعين، ويعبر عنه: بان الاعتبار باقصي امراة في العشيرة، والاعتبار في الذباءح والنكاح بجانب الاب، او بالاغلظ؟ فيه قولان.

  AUTO   فرع

 :
 اذا جني علي حامل بكافر، فاسلمت ثم اجهضت، او علي حامل   برقيق، فعتقت ثم اجهضت، ففي الجنين غرة كاملة نظرا الي المال.

  AUTO   فرع

 :
 اذا جرح حربيا، فاسلم ثم مات بالجرح، لم يضمنه علي الاصح، وابعد من اوجب الضمان، فان قلنا: لا يضمن، فرمي حربيا فاسلم، ثم اصابه السهم فقتله، لم يضمن علي الاصح.
 وان جني علي حربية، فاسلمت ثم اجهضت: فهل يلحق الجنين في ضمانه بجرح الحربي، او بالرمي اليه؟ فيه وجهان.
 ولو جني علي مرتدة جنينها مسليم، فاجهضته، وجب ضمانه، فان كان جنينها من مرتد: فان جعلناه مسلما وجب ضمانه، وان جعلناه مرتدا: فان اصرت حتي اجهضته لم يضمن، وان اسلمت ثم اجهضته كان كما لو جني علي حربية فاسلمت ثم اجهضت.

  AUTO   فرع

 :
 اذا اشترك مسلم وذمي في وطء ذمية بشبهة، فاجهضت ولدا يمكن ان يكون من كل واحد منهما، فان الحقته القافة بالمسلم وجب فيه غرة كاملة، وان الحقته بالذمي ضمن بما يضمن به جنين الذمي، وان اشكل علي القاءف وقف حتي يبلغ وينسب الي احدهما، ولا شء علي الجاني حتي يعرف الاب.
 * * *

  AUTO   فصل فيمن تلزمه الغرة

 الغرة علي العاقلة اجماعا، اذ لا يتصور فيها العمد مع الجهل بوجود   الحمل وحياته، واذا ضربت الحصص من الدية او الغرة علي العاقلة، فللامام الزامهم بشراءهما، وله مساعدتهم علي الشراء، فان قالوا: نحن نشتريها، لم يجز للامام الاستبداد بشراءها، وان بذلوا القيمة لم يجب قبولها، فان لم يف عددهم الا بثصف الغرة، لزمهم نصف قيمتها، لا قيمة نصفها، واخذ الباقي من بيت المال.
 * * *

  AUTO   فصل في الشارع في الاجهاض وغيره

 اذا قالت المراة: اجهضت هذا الولد بجنايتك، فانكر الجناية، او اقر بها وقال: استعرت هذا الولد او التقطته، فالقول قوله مع يمينه.
 وان تصادقا علي الجناية والاجهاض، فقال: اجهضت بسبب غير جنايتي، فان اجهضت عقيب الجناية، فالقول قولها مع يمينها؛ كما لو مات الجريح عقيب الجرح، فقال الولي: مات بالجرح، وقال الجاني: بل مات بغيره، فالقول قول الولي مع يمينه. فان شهد القوابل بانها القته في اوان الولادة، لم تسمع شهادتهن؛ اعتبارا بالسبب الظاهر وهو الجناية، فان الولادة تتقدم وتتاخر وان حان وقتها.
 وان تاخر الاجهاض عن الجناية، فان كانت ضنية (¬) متالمة ذات فراش   حتي اجهضت، فالقول قولها مع يمينها، والا فالقول قوله مع يمينه، والاختلاف في الاجهاض كالاختلاف في ان المجروح مات بالجرح او بسبب اخر.
 وان اتفقا علي الاجهاض بالجناية، فقالت اجهضته حيا وعليه اثر الجناية فمات بها، فقال: بل اجهضته ميتا، فالقول قوله مع يمينه.

  AUTO   فاءدة

 :
 لا يضاف موت الجنين الي الجناية الا ان يكون اثرها علي الولد، فان اتفقا علي انفصاله حيا، وان الاجهاض اتصل بالجناية، فادعي انه مات بسبب اخر متصل من غير تخلل مدة معتبرة، فالقول قوله، فان موت الولد عقيب الولادة كثير غالب، بخلاف ما لو جرح جرحا يفضي الي الهلاك، فهلك الجريح عقيبه، فادعي انه هلك بسبب اخر، فلا يقبل قوله الا ببينة.

  AUTO   فرع

 :
 اذا شهد النسوة بحياة الولد، فان طال الزمان الي حد لا يبعد اطلاع الرجال في مثله علي الولد، لم تقبل شهادتهن اتفاقا، وان قصر بحيث يبعد اطلاع الرجال عليه، قبلت عند الاكثرين، وحكي الربيع قولا: انها لا تثبت الا برجلين.
 * * *

  AUTO   فصل فيما يجب في الجنين اذا انفصل حيا ثم هلك بالجناية

 اذا انفصل الجنين ووجد منه ما يدل علي الحياة قطعا كالصراخ وتحريك   الجفن او الاطراف ثم هلك، حكم بحياته من غير يمين ووجبت الدية وان كان علي حركة المذبوح، وان صدر منه ما يصدر مثله من مثله من الجماد كالاختلاج، وجبت الغرة ولم يحكم بالحياة، وان ترددنا بين الامرين، لم نحكم بالحياة علي اصح القولين، فان حكمنا بها وجبت اليمين.
 ولو قتل حاملا ظهر حملها، فلم ينفصل جنينها، فلا شء فيه باجماع العلماء، وان قدها بنصفين، فرايناه مقدودا غير منفصل وجبت الغرة علي الاصح.
 وان خرج بعض الجنين لم تنقض العدة اتفاقا، والاصح وجوب الغرة ان كان ميتا والدية ان كان حيا، فان صرخ فقتل، فان كانت حياته مستقرة فالاصح وجوب الدية والقصاص، ومدار هذه الصورة علي انا نعتبر اليقين في وجه والانفصال في اخر.
 واذا انفصل حيا متاثرا بالجناية، فمات وظهر انه مات بالجناية، كملت فيه الدية وان كان ممن لا تتم لمثله حياة باتفاق الاصحاب، خلافا للمزني.
 فان قتل بعد الاجهاض، فان لم تكن حياته مستقرة فديته علي المجهض دون القاتل، وان كانت حياته مستقرة، فالقود والدية علي القاتل وان كان ممن لا يتم لمثله حياة، وفي وجوب الحكومة علي المجهض وجهان، فلو انفصل من غير جناية علي حياة غير مستقرة، فقتله انسان، لزمه القصاص كما لو ذبح الواقع في سكرات الموت، ولا نجعل ما يصيبه من عسر الانفصال كجناية جان.



  AUTO   في القاء بعض الولد

 :
 تكمل الغرة بالقاء عضو من اعضاء الجنين اذا انفصل العضو اتفاقا، وهذا يدل علي وجوبها بخروج بعضه، وان القت بدنين وجبت غرتان، وان القت راسين او اربعة ايد فما زاد، وجبت غرة واحدة، سواء ظهر عليه اثر انقطاع اليد او لم يظهر، وان القته حيا فاستمرت حياته، فان كان له يدان وجبت حكومة اليد الساقطة، وان كانت له يد واحدة فالمذهب وجوب نصف الدية، فان مات بعد ذلك بالجناية وجب نصف اخر.
 وقال في "التقريب": نراجع القوابل، فان قلن لا تتصور اليد الا بعد الحياة، وجب نصف الدية، وان قلن: تخلق الارواح ثم تنسلك فيه، او شككن في ذلك، وجب نصف الغرة، وهذالا يصح، اذ لا معرفة لهن بذلك.
 * * *



  AUTO   باب جنين الامة

 اذا جني علي امة، فاجهضت الجنين حيا، فمات بالجناية، وجبت قيمته باعتبار يوم الانفصال، وان القته ميتا ففيه عشر قيمة امه اكثر ما كانت من حين الجناية الي الاجهاض، وقال المزني وبعض الاصحاب: العبرة بقيمتها يوم الاجهاض، فعلي هذا: لو ماتت ثم اجهضت، احتمل ان يعتبر بيوم موتها، واحتمل ان يعتبر بيوم الاجهاض، وتقدر الحياة حينءذ فان كان جنينها حرا او كان جنين الذمية مسلما، وجبت غرة حر ومسلم تقديرا للحرية والاسلام في الام.
 فان كانت الامة سليمة والجنين زمنا، او بالعكس، فالاصح انا نقوم الام بصفتها، وقيل: نقدر لها صفة ولدها ونقومها بذلك، كما نقدر حريتها واسلامها، فان قدرنا ذلك فالقت يدا يحتمل ان تكون زاءدة، فقد قطع الامام بوجوب عشر قيمة الام من غير نظر الي صفته.

  AUTO   فرع

 :
 اذا جني علي حرة، فوضعت جنينا حيا، فذبحه اخر، فقال الولي: صيره [الاول] (¬) الي حركة المذبوح، برء الثاني، والقول قول الاول مع   يمينه، فان نكل حلف الولي، وان ادعي ان الثاني ذبحه عن حياة مستقرة، فقد برء الاول من بدل الجنين، وفي الحكومة الخلاف، والقول قول الذابح مع يمينه، وله القسامة علي احدهما؛ لانه قتيل متردد بين شخصين.

  AUTO   فرع لابن الحداد

 :
 اذا كان لرجلين امة حامل برقيق، فجنيا عليها ثم اعتقاها، فاجهضت الجنين ميتا، فعلي كل واحد ربع الغرة، فيصرف الي ام الجنين ثلث الغرة مما غرماه والباقي للعصبة، وبني الامام هذه المسالة علي اصلين:
 احدهما: ان من جني علي عبد نفسه، ثم عتق ومات بالسراية، فالاصح اهدار نفسه.
 والثاني: اذا جني اجنبي علي عبد، فعتق ثم مات بالسراية، فالاصح انا نصرف الي اليد الاقل مما وجب اخرا بالجناية او ارش جناية الملك.
 فان قلنا بالاصح فيهما، فغرم كل واحد منهما ربع الغرة، فلصاحبه من ذلك الربع الاقل من ربع الغرة او ربع عشر قيمة الام، فان فضل شء فلامه الثلث والباقي للعصبة، وان اوجبنا علي السيد ضمان السراية الواقعة بعد العتق، فعلي كل واحد منهما نصف الغرة: نصفه وهو الربع للورثة، والربع الاخر لشريكه منه الاقل من ربع الغرة او ربع عشر قيمة الام.
 * * *

  AUTO   فصل في جناية عبد التركة علي الزوجة

 اذا مات عن عبد وزوجة حامل وعصبة، فجني العبد علي الزوجة   فاجهضت، فلا ارث للجنين، ولامه ثلث الغرة تقديرا، وللعصبة الثلثان، كما لو جني علي الجنين اجنبي، فيسقط ربع الغزة عن نصيب الزوجة من العبد وهو ربع العبد، ولها نصف سدس الغرة متعلقا بنصيب العصبة، ويسقط نصيب العصبة من الغرة؛ لان الذي تملكه من العبد اكثر من نصيب الغرة.
 ولو قتل عبد لرجلين عبدا لهما، فان كان القتيل بينهما نصفين فلا طلبة لواحد منهما، وان كان لاحدهما ثلث وللاخر ثلثان، فلا يتعلق قدر التفاوت برقبة العبد.
 * * *

  AUTO   فصل فيمن مات بجراحات بعضها مهدرا

 (¬)
 اذا جرح ثلاث جراحات بعضها مهدرا، فمات الجريح بالسراية، فان تخلل المضمون بين المهدرين، مثل ان جرح مرتدا، فاسلم فجرحه، ثم ارتد فجرحه، او جرح صاءلا، فهرب فجرحه، ثم صال فجرحه، لزمه ثلث الدية واهدر الثلثان، وان لم يتخلل المضمون بين المهدرين، مثل ان جرح جرحين في الردة او الصيال، ثم جرح جرحا اخر بعد الهرب والاسلام، لزمه نصف الدية واهدر نصفها.
 فان تعددت الجناة وقد جرح بعضهم جرحا مهدرا او جرحا مضمونا، فهل توزع الدية علي الرءوس، او الجراح؟ فيه وجهان؛ اظهرهما: التوزيع علي الجناة.



 فان جرح مرتدا فاسلم، ثم جرحه بعد الاسلام مع ثلاثة انفس، فان وزعنا علي الرءوس لزم كل واحد من الثلاثة ربع الدية، ويجب علي الجاني في الحالين ثمن الدية، ويهدر عنه الثمن، وان وزعنا علي الجراح اهدر خمس الدية عن الجميع، ولزم كل واحد خمسها.
 ولو جرحه ثلاثة، فاسلم، فجرحه احدهم مع رابع، فان وزعنا علي الرءوس لزم الجاني في الحالين ثمن واهدر عنه ثمن، وعلي كل واحد من اصحابه ربع، وان وزعناها علي الجراح، اهدر ثلاثة اسباع الدية عن الجميع، ولزم كل واحد سبع.
 ولو جرحه اربعة، فاسلم، فجرحه احدهم بعد الاسلام مع ثلاثة، فان وزعنا علي الرءوس اهدر ثلاثة اسباع الدية عمن اختصت جنايته بالردة، وعلي كل واحد من جناة الاسلام سبع، ويجب علي الجاني في الحالين نصف سبع، وان وزعناها علي الجراح، اهدر نصف الدية عن الجميع، وعلي كل واحد منهم ثمنها، ولو جرحه اربعة، فاسلم، ثم جرحه احدهم بعد الاسلام، فان وزعنا علي الرءوس، فعلي كل واحد من جناة الردة ربع الدية، وعلي الجاني في الحالين ثمن، ويهدر عنه ثمن، وان وزعناها علي الجراح، اهدر اربعة اخماس الدية، ويجب الخمس علي الجاني في الحالين.
 وان جرحه اثنان، فاسلم، فجرحاه، اهدر نصف الدية، وعلي كل واحد ربعها، سواء وزعنا علي الرءوس او الجراح.
 * * *



  AUTO   فصل فيمن مات بجراح مضمون مختلف الحكم

 اذا كان احد الجرحين عمدا والاخر خطا، فعلي الجاني نصف الدية مغلظا، والنصف الاخر علي عاقلته مخففا، وان جرحه خطا ثم جرحه مع اخر متعمدين، فقياس التوزيع علي الرءوس: ان يجب علي الثاني نصف مغلظ، ويجب علي الجاني في الحالين ربع مغلظ وربع مخفف، وان وزعنا علي الجراح: فعلي كل واحد منهما ثلث الدية مغلظا وسدسها مخففا؛ اذ لا سبيل الي الاهدار سواء وزعنا علي الرءوس او الجراح، فان الجميع مضمون.
 وان جرح عبد حرا، فعتق، ثم جرحه بعد العتق مع اخر، فعلي صاحبه نصف الدية، وعليه نصفها: يتعلق الربع منها بذمته، والربع الاخر برقبته، فيجب علي سيده؛ لانه التزم فداءه بعتقه.
 ولو جني عبد علي حر، فقطعت يد العبد عدوانا، ثم جرح بعد ما عتق حرا اخر، ومات العبد والجريحان بالسراية، فقيمة العبد علي قاطعه، ويختص المجروح في الرق بما يقابل يد العبد، ويتحاصان فيما بقي، والاصح انه تقابل اليد بارش النقص، وغلط من قابلها بنصف الدية، اذ يلزم منه ان يصرف اليه كمال الدية لو قطع يديه.
 ولو جني علي حر، فقطعت يده او يداه، ثم عتق فقتله اجنبي، فالقيمة علي قاتله، وعلي العبد القيمة ان قطع يديه، ونصفها ان قطع يده، فيصرف النصف الي من قطع العبد يده، او الجميع الي من قطع يديه.
