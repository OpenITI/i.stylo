 ولا نعلم روي ابو اسحاق عن القاسم عن ابيه عن عبد الله الا هذا الحديث 
  منصور بن المعتمر عن القاسم
  كتب الي محمد بن حميد يخبرني في كتابه ان هارون بن المغيرة حدثه قال نا عمرو بن ابي قيس عن منصور يعني بن المعتمر عن القاسم بن عبد الرحمن عن ابيه عن عبد الله قال قال رسول الله رضيت لامتي ما رضي لها بن ام عبد وكرهت لامتي ما كره لها بن ام عبد
 ولا نعلم اسند منصور عن القاسم عن ابيه عن عبد الله الا هذا الحديث ولا نعلم رواه مسندا الا عمرو بن ابي قيس من  حديث محمد بن حميد عن هارون وقد روي عن منصور عن القاسم بن عبد الرحمن مرسلا 
  الاعمش عن القاسم
  حدثنا علي بن مسلم الطوسي قال نا محمد بن ابي عبيدة قال حدثني ابي عن الاعمش عن القاسم بن عبد الرحمن عن ابيه عن عبد الله قال لقد رايتني واني لسادس ستة ما علي ظهر الارض مسلم غيرنا
 وهذا الحديث لا نعلم رواه عن الاعمش بهذا الاسناد الا ابو عبيدة بن معن ولا عنه الا ابنه 
  حدثنا محمد بن موسي الحرشي قال نا فضيل بن سليمان النميري قال نا عبد الله بن عثمان عن القاسم بن عبد الرحمن عن ابيه عن جده عبد الله بن مسعود ان رسول الله قال يا عبد الله سياتي بعدي قوم يءخرون الصلاة  عن مواقيتها قال عبد الله فقلت كيف تامرني يا رسول الله قال يا بن ام عبد ان ادركتهم فلا طاعة لمخلوق في معصية الخالق
 وهذا الكلام لا نعلمه يروي عن عبد الله الا بهذا الاسناد 
  سماك عن القاسم
  حدثنا يوسف بن موسي وعبدة بن عبد الله قالا نا الحسين بن علي الجعفي عن زاءدة عن سماك بن حرب عن القاسم بن عبد الرحمن عن ابيه عن عبد الله قال كنا مع رسول الله في غزاة فادلجنا ذات ليلة فقلت لو نزلت استرحنا قال ومن يحرسنا قال انا احرسكم فنوموا ونمت كما ناموا حتي طلعت الشمس فقام رسول الله فتوضا وتوضانا لصلاة الصبح ثم صلينا الصبح ضحي
 وهذا الحديث رواه سماك عن القاسم ورواه عن سماك زاءدة ويزيد بن عطاء
  حدثنا احمد بن محمد بن سعيد الانماطي قال نا محمد بن  سعيد بن سابق قال نا عمرو بن ابي قيس عن سماك يعني بن حرب عن القاسم بن عبد الرحمن عن ابيه عن عبد الله بن مسعود عن النبي ان بني اسراءيل استخلفوا خليفة عليهم بعد موسي فقام يصلي ليلة في القمر فوق بيت المقدس فذكر امورا كان صنعها فخرج فتدلي بسبب فاصبح السبب متعلقا في المسجد وقد ذهب قال فانطلق حتي اتي قوما علي شط البحر فوجدهم يضربون لبنا او يصنعون لبنا فسالهم كيف تاخذون علي هذا اللبن قال فاخبروه فلبن معهم فكان ياكل من عمل يده فاذا كان حين الصلاة قام يصلي فرفع ذلك العمال الي دهقانهم ان فينا رجلا يفعل كذا وكذا فارسل اليه فابي ان ياتيه ثلاث مرات ثم انه جاءه يسير علي دابته فلما راه فر فاتبعه فسبقه فقال انظرني اكلمك قال فقام حتي كلمه فاخبره خبره فلما اخبره انه كان ملكا وانه فر من رهبة الله قال اني لاظنني لاحق بك قال فاتبعه فعبد الله حتي ماتا برميلة مصر قال عبد الله لو اني كنت ثم لاهتديت الي قبريهما من صفة رسول الله التي وصف لنا 
 وهذا الحديث لا نعلم احدا رواه عن سماك عن القاسم عن ابيه عن عبد الله الا عمرو بن ابي قيس وقد رواه المسعودي عن سماك عن عبد الرحمن بن عبد الله عن ابيه ولم يذكر القاسم 
  عبد الرحمن بن اسحاق عن القاسم
  حدثنا محمد بن عبد الله المخرمي قال نا محمد ابو اسماعيل قال نا عبد الرحمن بن اسحاق عن القاسم بن عبد الرحمن عن ابيه عن عبد الله بن مسعود
  وحدثناه محمد بن الحارث بن اسماعيل الخزاز قال نا سيار بن حاتم قال نا عبد الواحد بن زياد قال نا عبد الرحمن بن اسحاق عن القاسم بن عبد الرحمن عن ابيه عن عبد الله بن مسعود عن النبي قال لما كان ليلة اسري بي لقيت ابراهيم في السماء السابعة فقال يا محمد اقرا علي امتك السلام واخبرهم ان الجنة عذب ماءها طيب شرابها  وان فيها قيعان وان غرس شجرها سبحان الله والحمد لله ولا اله الا الله والله اكبر
  وحدثناه ابو كامل قال نا عبد الواحد بن زياد عن عبد الرحمن بن اسحاق عن القاسم بن عبد الرحمن عن عبد الله عن النبي بنحوه ولم يقل عن القاسم عن ابيه عن عبد الله
 وهذا الكلام لا نعلمه يروي عن عبد الله الا من هذا الوجه بهذا الاسناد 
  حدثنا اسحاق بن بهلول قال نا اسحاق بن عيسي قال نا محمد بن صالح الثقفي قال نا عبد الرحمن بن اسحاق عن القاسم بن عبد الرحمن عن ابيه عن عبد الله بن مسعود قال كان رسول الله يعلمنا هذا الدعاء اللهم اني عبدك بن عبدك بن امتك ناصيتي بيدك ماض في حكمك نافذ في قضاءك اسالك بكل اسم سميت به نفسك او انزلته في كتابك او علمته احدا من خلقك او استاثرت به في علم الغيب عندك ان تجعل القران ربيع قلبي ونور صدري وجلاء حزني وذهاب غمي الا اذهب الله غمه وابدله بحزنه فرحا قالوا يا رسول الله ينبغي لنا ان نتعلم هءلاء الكلمات قال اجل ينبغي لمن سمعهن ان يتعلمهن 
  عمر بن قيس عن القاسم
  حدثنا علي بن حرب الجنديسابوري قال نا سليمان بن ابي هوذة الرازي قال نا عمرو بن ابي قيس قال نا عمر بن قيس يعني الماصر عن القاسم بن عبد الرحمن عن ابيه عن عبد الله عن النبي قال اذا اختلف البيعان وليس بينهما بينة فالقول ما قال الباءع او يترادان البيع 
 وهذا الحديث لم نسمعه الا من علي بن حرب بهذا الاسناد ولا نعلم رواه عن عمر بن قيس الا عمرو بن ابي قيس 
  سليمان بن ابي سليمان عن القاسم
  حدثنا محمد بن معمر قال نا يزيد بن هارون قال انا العوام بن حوشب عن سليمان بن ابي سليمان عن القاسم بن عبد الرحمن عن ابيه عن عبد الله قال قال رسول الله تدور رحي الاسلام علي خمس وثلاثين او ستة وثلاثين او سبعة وثلاثين فان يهلكوا فسبيل من هلك وان بقوا او بقي لهم دينهم سبعين سنة 
  مجالد عن القاسم
  وحدثناه الفضل بن سهل قال نا الاسود بن عامر قال نا شريك عن مجالد قال فحدثني القاسم بن عبد الرحمن عن ابيه عن عبد الله عن النبي بنحوه
 وانما حدثنا به الفضل عن الاسود بن عامر عن شريك عن مجالد عن الشعبي عن مسروق عن عبد الله عن النبي بهذا الكلام
 قال شريك فحدثني مجالد قال فحدثني القاسم عن ابيه عن عبد الله عن النبي بنحوه
 ولا نعلم روي مجالد عن القاسم حديثا مسندا الا هذا الحديث ولا رواه عنه الا شريك 
  الحارث بن حصيرة عن القاسم
  حدثنا محمد بن عبد الرحيم قال نا عفان بن مسلم قال نا عبد الواحد بن زياد عن الحارث بن حصيرة عن القاسم بن عبد الرحمن عن ابيه عن عبد الله بن مسعود قال كنت مع رسول الله يعني يوم حنين فتفرق الناس وبقيت معه في ثمانين رجلا من المهاجرين والانصار وهم الذين انزل الله عليهم السكينة ورسول الله علي بغلته فقال النبي ناولني كفا من تراب فرمي به وجوههم فامتلات اعينهم ترابا واقبل المهاجرون والانصار وسيوفهم بايمانهم كانها الشهب وولي المشركون مدبرين
  حدثنا عمرو بن بشر الناجي قال نا عفان بن مسلم قال نا  عبد الواحد بن زياد عن الحارث بن حصيرة عن القاسم بن عبد الرحمن عن ابيه عن عبد الله قال قال لنا رسول الله كيف انتم وربع اهل الجنة لكم ولساءر الناس ثلاثة ارباعها قالوا الله ورسوله اعلم قال كيف انتم وثلثها قالوا ذاك اكثر قال كيف انتم والشطر قالوا ذاك اكثر فقال رسول الله اهل الجنة عشرون وماءة صف امتي منها ثمانون صفا
 وهذان الحديثان لا نعلمهما يرويان عن عبد الله بن مسعود الا بهذا الاسناد 
  عطاء بن الساءب عن القاسم
  حدثنا الفضل بن سهل قال نا محمد بن الصلت قال نا ابو كدينة عن عطاء بن الساءب عن القاسم بن عبد الرحمن عن ابيه عن عبد الله بن مسعود قال جاء رجل من اهل الكتاب الي رسول الله فساله عن الشبه فقال النبي اذا علا ماء الرجل غلب الشبه واذا علا ماء المراة غلب الشبه
 وهذا الحديث لا نعلم رواه عن القاسم عن ابيه عن عبد الله الا عطاء بن الساءب ولا نحفظ ان احدا رواه عن عطاء الا ابو كدينة 
  محمد بن عبد الرحمن عن القاسم
  حدثنا علي بن سهل المداءني قال نا يحيي بن ادم قال نا مندل عن بن ابي ليلي وهو محمد بن عبد الرحمن بن ابي ليلي عن القاسم بن عبد الرحمن عن ابيه عن عبد الله
  وحدثناه احمد بن سنان القطان قال نا اسماعيل بن ابان قال نا مندل عن بن ابي ليلي عن القاسم بن عبد الرحمن عن ابيه عن عبد الله واللفظ لفظ يحيي بن ادم قال راني رسول الله واضع شمالي علي يميني في الصلاة فقال ضع يمينك علي شمالك
 وهذا الحديث لا نعلم رواه عن القاسم عن ابيه عن عبد الله الا بن ابي ليلي 
  حدثنا محمود بن بكر بن عبد الرحمن قال حدثني ابي عن عيسي بن المختار عن بن ابي ليلي عن القاسم بن عبد الرحمن عن ابيه عن عبد الله بن مسعود ان رسول الله قال اذا اختلف البيعان ليس بينهما بينة فالقول ما قال الباءع او يترادان البيع
 وهذا الحديث انما يعرف من حديث بن ابي ليلي عن القاسم الا ما رواه عمرو بن ابي قيس عن عمر بن قيس  الماصر عن القاسم بن عبد الرحمن وقد روي هذا الحديث غير واحد عن بن ابي ليلي 
  المسعودي عن القاسم
  حدثنا عبيد الله رجل من ولد المغيرة بن مسلم جليسا كان لابراهيم بن محمد التيمي وكان رجلا له ستر وامانة قال نا موسي بن داود قال نا المسعودي عن القاسم بن عبد الرحمن عن ابيه عن عبد الله قال كنت عند النبي فقلت لا حول ولا قوة الا بالله فقال رسول الله تدري ما تفسيرها قلت الله ورسوله اعلم قال لا حول عن معصية الله الا بعصمة الله ولا قوة علي طاعة الله الا بعون الله
 وهذا الحديث لم نسمع موصلا عن القاسم عن ابيه عن عبد الله الا من هذا الوجه
  وقد حدثناه الحسن بن قزعة قال نا عبد الله بن خراش بن  حوشب عن المسعودي عن القاسم بن عبد الرحمن عن عبد الله بن مسعود ولم يقل عن القاسم عن ابيه انما ارسله
  حدثنا ابراهيم بن عبد الله بن الجنيد قال نا سعيد بن سليمان قال نا مصعب بن سلام عن الحجاج يعني بن ارطاة عن القاسم بن عبد الرحمن عن ابيه عن عبد الله بن مسعود رفعه قال اذا اكرم الرجل اخاه فانما يكرم ربه
 وهذا الكلام لا نعلمه يروي عن النبي الا بهذا الاسناد ومصعب بن سلام ليس بالقوي وقد روي عنه غير واحد وهو رجل من اهل الكوفة 
  جابر عن القاسم
  حدثنا محمد بن عمارة بن صبيح الكوفي قال نا قبيصة بن عقبة قال نا سفيان الثوري عن جابر عن القاسم بن عبد الرحمن عن ابيه عن عبد الله قال اتي النبي بسبي فجعل يعطي اهل البيت وكره ان يفرق بينهم
 ولا نعلم روي هذا الحديث عن القاسم الا جابر ورواه غير واحد عن جابر 
  ابو المليح عن عبد الرحمن بن عبد الله عن ابيه
  حدثنا محمد بن عبد الرحيم والفضل بن سهل قالا نا شبابة بن سوار قال نا ابو بكر الهذلي قال نا ابو المليح عن عبد الرحمن بن عبد الله عن ابيه قال دفعت يوم بدر الي ابي جهل وقد تظاهر عليه الحديد كانه بصلة وقد اقعد فاخذت سيفه فرفع راسه فقال ارويعينا بمكة قال فضربته بسيفي حتي برد ثم اتيت رسول الله فقلت قتلت ابا جهل فقال عقيل وهو اسير عند النبي كذبت ما قتلته فقلت بل انت الكذاب الاشم يا عدو الله قد والله قتلته قال فما علامته قلت بفخذه حلقة كحلقة كذا لشء ذكره يعني اثرا في فخذه قال صدقت
 ولا نعلم روي ابو المليح عن عبد الرحمن عن ابيه الا هذا الحديث 
  الحسن بن سعد عن عبد الرحمن بن عبد الله عن ابيه
  حدثنا محمد بن العلاء ابو كريب وعمرو بن علي قالا نا ابو معاوية عن الشيباني عن الحسن بن سعد عن عبد الرحمن بن عبد الله عن ابيه قال قال رسول الله لا يعذب بالنار الا رب النار
  حدثنا محمد بن معمر ومحمد بن يحيي القطعي قالا نا ابو داود عن المسعودي عن الحسن بن سعد عن عبد الرحمن بن عبد الله عن ابيه ان رسول الله كان في سفر فدخل غيضة فاخذ رجل بيض حمرة فجاءت الحمرة فجعلت ترف علي  راس رسول الله واصحابه فقال رسول الله ايكم فجع هذه بيضها فقال رجل يا رسول الله انا اخذت بيضها قال اردده رحمة لها
 وهذا الحديث انما نحفظه بهذا الاسناد 
  سماك بن حرب عن عبد الرحمن بن عبد الله عن ابيه
  حدثنا محمد بن المثني قال نا محمد بن جعفر قال نا شعبة عن سماك عن عبد الرحمن بن عبد الله عن ابيه ان رسول الله قال انكم منصورون ومفتوح عليكم فمن ادرك ذلك فليتق الله وليامر بالمعروف ولينة عن المنكر
 وهذا الحديث لا نعلمه يروي بهذا اللفظ عن عبد الله الا من هذا الوجه بهذا الاسناد
  حدثنا محمد بن المثني قال نا محمد بن جعفر قال نا شعبة عن سماك عن عبد الرحمن بن عبد الله عن ابيه عن  النبي لعن اكل الربا وموكله وكاتبه وشاهديه
 وهذا الكلام قد روي عن عبد الله من غير وجه
  حدثنا محمد بن المثني قال نا محمد بن جعفر قال نا شعبة عن سماك عن عبد الرحمن بن عبد الله عن ابيه قال قال رسول الله مثل الذي يعين قومه علي غير الحق كمثل بعير اردي في بءر فهو ينزع منها بذنبه 
 وهذا الكلام لا نعلمه يروي عن عبد الله الا من هذا الوجه
  حدثنا محمد بن المثني قال نا محمد بن جعفر قال نا شعبة عن سماك بن حرب عن عبد الرحمن بن عبد الله عن ابيه عن النبي قال نضر الله امرءا سمع منا حديثا فبلغه كما سمعه فرب مبلغ اوعي من سامع 
  حدثنا محمد بن معمر قال نا مءمل قال نا سفيان عن سماك عن عبد الرحمن بن عبد الله عن ابيه قال اتيت النبي وهو في قبة حمراء في نحو من اربعين رجلا فقال انكم منصورون ومفتوح عليكم فمن ادرك ذلك فليتق الله وليامر بالمعروف ولينه عن المنكر ومن كذب علي متعمدا فليتبوا مقعده من النار
  حدثنا محمد بن عثمان بن ابي صفوان الثقفي قال نا ابي قال نا سفيان يعني الثوري عن سماك عن عبد الرحمن بن  عبد الله عن ابيه انه قال لا يصلح صفقتان في صفقة قال وامرنا رسول الله باسباغ الوضوء
 وهذا الحديث لم نسمعه الا من محمد بن عثمان عن ابيه واخرج الينا محمد بن عثمان كتابا ذكر انه كتاب ابيه فيه هذا الحديث
  حدثنا الفضل بن سهل قال نا اسود بن عامر عن شريك عن سماك عن عبد الرحمن بن عبد الله عن ابيه قال نهي رسول الله عن صفقتين في صفقة
 وهذا الحديث اسنده شريك بهذا الاسناد 
