 فوجد العدو السبيل الي الاستيلاء علي ثغور المسلمين وانتهاز الفرصة فيها بالتضريب بين ملوكها واغراء بعضهم بعض وكان منهم ابن عباد باشبيلية وابن الافطس ببطليوس وابن ذي النون بطليطلة وابن هود بسرقسطة ومجاهد العامري بدانية وغير هءلاء وكلهم يداري الطاغية ويتقيه بالجزية الي ان كان من امر الاذفونش ما كان من تخريب بلاد المسلمين واستيلاءه علي طليطلة بعد حصاره اياها سبع سنين ثم حصاره سرقسطة
 فلما راي رءساء الاندلس ما نزل بهم من مضايقة عدو الدين واستطالته علي ثغور المسلمين اجمع رايهم علي اجازة يوسف بن تاشفين فكاتبه اهل الاندلس كافة من الخاصة والعلماء يستصرخونه في تنفيس العدو عن مخنقهم ويكونوا معه يدا واحدة عليه  فلما تواترت رسلهم وكتبهم عليه بعث ابنه المعز بن يوسف في عساكر المرابطين الي سبتة فرضه المجاز فنازلها برا واحاطت بها اساطيل ابن عباد بحرا فاقتحموها عنوة في ربيع الاخر سنة سبع وسبعين واربعماءة وقبض علي صاحبها ضياء الدولة يحيي بن سكوت البرغواطي وجء به الي المعز اسيرا فقتله صبرا وبعث بكتاب الفتح الي ابيه وهو بفاس ينظر في امر الجهاد ويستعد له ففرح يوسف بفتح سبتة وخرج من حينه قاصدا نحوها ليعبر منها الي الاندلس
 ولما سمع المعتمد ابن عباد بفتح سبتة ركب البحر الي المغرب لاستنفار يوسف الي الجهاد فلقيه مقبلا ببلاد طنجة بموضع يعرف ببليطة علي ثلاث مراحل من سبتة وقال ابن خلدون لقيه بفاس فاخبره بحال الاندلس وما هي عليه من الضعف وشدة الخوف والاضطراب وما يلقاه المسلمون من عدوهم من القتل والاسر والحصار كل يوم فقال له يوسف ارجع الي بلادك وخذ في امرك فاني علي اثرك فرجع ابن عباد الي الاندلس ونزل ليوسف عن الجزيرة الخضراء لتكون رباطا لجهاده ودخل يوسف سبتة فنظر في امرها واصلح سفنها وقدمت عليه بها جنود الله من المغرب والصحراء والقبلة والزاب فشرع في اجازتها الي الاندلس
 ولما تكاملت بساحل الخضراء عبر هو في اثرها في موكب عظيم من قواد المرابطين وانجادهم وصلحاءهم فلما استوي علي ظهر السفينة رفع يديه وقال اللهم ان كنت تعلم ان في جوازنا هذا صلاحا للمسلمين فسهل علينا هذا البحر حتي نعبره وان كان غير ذلك فصعبه حتي لا نعبره فسهل الله عليهم العبور في اسرع وقت وكان ذلك يوم الخميس عند الزوال منتصف ربيع الاول سنة تسع وسبعين واربعماءة ونزل بالخضراء فصلي بها الظهر من يومه ذلك ولقيه المعتمد ابن عباد صاحب اشبيلية وابن الافطس صاحب بطليوس وغيرهما من ملوك الاندلس 
 واتصل الخبر بالاذفونش وهو محاصر لسرقسطة فارتحل عنها وقصد نحو امير المسلمين وبعث الي ابن ردمير والبرهانس وغيرهما من كبار النصرانية واستنفر اهل قشتالة وجليقية وساءر المجاورين له من امم النصرانية فاجتمع له منهم ما يفوت الحصر وصمد الي ابن تاشفين والمسلمين هكذا وقع مساق هذه الغزوة عند ابن خلدون وابن ابي زرع وغيرهما
 وساقها ابن الاثير وابن خلكان وابن عبد المنعم الحميري مساقا غير هذا ولنذكر بعض ما نقلوه من ذلك فنقول لما ملك يوسف بن تاشفين المغرب وبني مراكش وتلمسان الجديدة واطاعته البربر مع شكيمتها الشديدة وتمهدت له الاقطار العريضة المديدة تاقت نفسه الي العبور لجزيرة الاندلس فهم بذلك واخذ في انشاء السفن والمراكب ليعبر فيها فلما علم بذلك ملوك الاندلس كرهوا المامه بجزيرتهم واعدوا له العدة والعدد الا انهم استهولوا جمعه واستصعبوا مدافعته وكرهوا ان يصبحوا بين عدوين الفرنج عن شمالهم والملثمين عن جنوبهم وكانت الفرنج قد اشتدت وطاتها عليهم فتغير وتنهب وربما يقع بينهم صلح علي شء معلوم كل سنة ياخذونه من المسلمين والفرنج مع ذلك ترهب جانب ملك المغرب يوسف بن تاشفين اذ كان له اسم كبير وصيت عظيم لنفاذ امره ونقله دولة زناتة وملك المغرب اليه في اسرع وقت مع ما ظهر لابطال الملثمين ومشايخ صنهاجة في المعارك من ضربات السيوف التي تقد الفارس والطعنات التي تنظم الكلي فكان لهم بذلك ناموس ورعب في قلوب المنتدبين لقتالهم
 وكان ملوك الاندلس يفيءون الي ظلم يوسف ويحذرونه خوفا علي ملكهم مهما عبر اليهم وعاين بلادهم فلما راوا عزيمته متوفرة علي العبور راسل بعضهم بعضا يستنجدون اراءهم في امره وكان فزعهم في ذلك الي المعتمد ابن عباد لانه اشجع القوم واكبرهم مملكة فوقع اتفاقهم علي مكاتبته وقد تحققوا انه يقصدهم يسالونه الاعراض عنهم وانهم تحت  طاعته فكتب عنهم كاتب من اهل الاندلس يقول
 اما بعد فانك ان اعرضت عنا نسبت الي كرم ولم تنسب الي عجز وان اجبنا داعيك نسبنا الي عقل ولم تنسب الي وهن وقد اخترنا لانفسنا اجمل نسبتينا فاختر لنفسك اكرم نسبتيك فانك بالمحل الذي لا يجوز ان نسبق فيه الي مكرمة وان في استبقاءك ذوي البيوت ما شءت من دوام لامرك وثبوت والسلام فوصله الكتاب مع تحف وهدايا وكان يوسف لا يعرف اللسان العربي لكنه كان ذكي الطبع يجيد فهم المقاصد وكان له كاتب يعرف اللغتين العربية والمرابطية فقال له ايها الملك هذا الكتاب من ملوك الاندلس يعظمونك فيه ويعرفونك انهم اهل دعوتك وتحت طاعتك ويلتمسون منك ان لا تجعلهم في منزلة الاعادي فانهم مسلمون وهم من ذوي البيوتات فلا تغير بهم وكف بهم من وراءهم من الاعداء الكفار وبلدهم ضيق لا يحتمل العساكر فاعرض عنهم اعراضك عمن اطاعك من اهل المغرب فقال يوسف بن تاشفين لكاتبه فما تري انت فقال ايها الملك اعلم ان تاج الملك وبهجته وشاهده الذي لا يرد بانه خليق بما حصل في يده من الملك ان يعفو اذا استعفي وان يهب اذا استوهب وكلما وهب جزيلا كان اعظم لقدره فاذا عظم قدره تاصل ملكه واذا تاصل ملكة تشرف الناس بطاعته واذا كانت طاعته شرفا جاءه الناس ولم يتجشم المشقة اليهم وكان وارث الملك من غير اهلاك لاخرته واعلم ان بعض الملوك الاكابر والحكماء البصراء بطريق تحصيل الملك قال من جاد ساد ومن ساد قاد ومن قاد ملك البلاد فلما القي الكاتب هذا الكلام علي السلطان يوسف فهمه وعلم صحته فقال للكاتب اجب القوم واكتب بما يجب في ذلك واقرا علي كتابك فكتب الكاتب بسم الله الرحمن الرحيم من يوسف بن تاشفين سلام عليكم ورحمة الله وبركاته تحية من سالمكم وسلم اليكم وحكمه التاييد والنصر فيمن حكم عليكم وانكم مما بايديكم من الملك في اوسع اباحة مخصوصون منا باكرم ايثار وسماحة فاستديموا وفاءنا بوفاءكم واستصلحوا اخاءنا باصلاح اخاءكم والله ولي التوفيق لنا لكم  والسلام فلما فرغ من كتابه قرا علي يوسف بن تاشفين بلسانه فاستحسنه وقرن به ما يصلح لهم من التحف ودرق اللمط مما لا يكون الا في بلاده وانفذ ذلك اليهم فلما وصلهم ذلك وقرءوا كتابه فرحوا به وعظموه واعتزوا بولايته وتقوت نفوسهم علي دفع الفرنج وازمعوا ان راوا من الفرنج ما يريبهم ان يجيزوا اليه يوسف بن تاشفين ويكونوا من اعوانه عليه فتاتي ليوسف بن تاشفين براي وزيره ما اراد من محبة اهل الاندلس له وكفاه حربهم
 وقال ابن الاثير في الكامل كان المعتمد ابن عباد اعظم ملوك الاندلس وممتلكا لاكبر بلادها مثل قرطبة واشبيلية وكان مع ذلك يءدي الضريبة الي الاذفونش كل سنة فلما تملك الاذفونش طليطلة ارسل اليه المعتمد الضريبة علي عادته فردها عليه ولم يقبلها منه ثم ارسل اليه يتهدده ويتوعده بالمسير الي قرطبة وتملكها من يده الا ان يسلم اليه جميع الحصون التي في الجبل ويبقي السهل للمسلمين وكان الرسول في جمع كثير نحو خمسماءة فارس فانزله المعتمد وفرق اصحابه علي قواد عسكره ثم امر القواد ان يقتل كل منهم من عنده واحضر الرسول فصفعه حتي برزت عيناه وسلم من الجماعة ثلاثة نفر فعادوا الي الاذفونش واخبروه الخبر وكان متوجها الي قرطبة ليحاصرها فلما بلغه هذا الخبر رجع الي طليطلة ليجمع الات الحصار ويستعد استعدادا غير الذي سبق وعاد المعتمد الي اشبيلية واقام بها وترك قرطبة بدون مدافع يدافع عنها
 وقال ابن عبد المنعم الحميري في كتابه الروض المعطار ما ملخصه ان المعتمد ابن عباد اخر في سنة من السنين الضريبة التي كان يدفعها للاذفونش عن وقتها ثم ارسلها اليه بعد فغضب الاذفونش واشتط وطلب بعض الحصون زيادة علي الضريبة وامعن في التجني حتي طلب ان تاتي زوجته الي الجامع الاعظم بقرطبة فتلد فيه اذ كانت حاملا وكان بالجانب الغربي من المسجد المذكور موضع كنيسة قديمة بني المسلمون عليها المسجد فاشار عليه الاطباء والقسيسون ان تكون زوجته ساكنة قرب ولادتها  بمدينة الزهراء التي بناها عبد الرحمن الناصر لدين الله وابدع في تشييدها وتنجيدها وتتردد المراة مع ذلك الي الجامع المذكور حتي تكون ولادتها بين طيب نسيم الزهراء وفضيلة موضع الكنيسة وكان الرسول في ذلك يهوديا وكان وزيرا للاذفونش فامتنع ابن عباد من ذلك فراجعه اليهودي واغلظ له في القول ولسعه بكلمة اسفته فاخذ ابن عباد محبرة كانت بين يديه وضرب بها راس اليهودي فانزل دماغه في حلقه وامر به فصلب منكوسا بقرطبة
 ولما سكن غضبه استفتي الفقهاء عن حكم ما فعله باليهودي فبادره الفقيه محمد بن الطلاع بالرخصة في ذلك لتعدي الرسول حدود الرسالة الي ما استوجب به القتل اذ ليس له ذلك وقال للفقهاء انما بادرت بالفتوي خوفا ان يكسل الرجل عما عزم عليه من منابذة العدو وعسي الله ان يجعل في عزيمته للمسلمين خيرا
 وبلغ الاذفونش ما صنعه ابن عباد فاقسم بالهته ليغزونه باشبيلية وليحاصرنه في قصره ثم زحف في عسكرين احدهما عليه والاخر علي بعض قواده حتي نزل علي ضفة النهر الاعظم باشبيلية قبالة قصر ابن عباد وفي ايام مقامه هنالك كتب الي ابن عباد زاريا عليه كثر بطول مقامي في مجلسي هذا علي الذباب واشتد الحر فاتحفني من قصرك بمروحة اروح بها علي نفسي واطرد بها الذباب عن وجهي فوقع له ابن عباد بخط يده في ظهر الرقعة قرات كتابك وفهمت خيلاءك واعجابك وسانظر لك في مراوح من جلود اللمط تروح منك لا عليك ان شاء الله فلما وصلت رسالة ابن عباد الاذفونش وقرءت عليه وفهم مقتضاها اطرق اطراق من لم يخطر له ذلك ببال وفشا في الاندلس توقيع ابن عباد وما اظهر من العزيمة علي اجازة يوسف بن تاشفين والاستظهار به علي العدو فاستبشر الناس وفرحوا بذلك وانفتحت لهم ابواب الامال
 واما ملوك طواءف الاندلس فلما تحققوا عزم ابن عباد وانفراده برايه في ذلك اهتموا منه فمنهم من كاتبه ومنهم من شافهه وحذروه عاقبة ذلك وقالوا له الملك العقيم والسيفان لا يجتمعان في غمد فاجابهم ابن عباد بكلمته  التي صارت مثلا رعي الجمال خير من رعي الخنازير ومعناه ان كونه ماكولا ليوسف بن تاشفين اسيرا يرعي جماله في الصحراء خير من كونه ممزقا للاذفونش اسيرا له يرعي خنازيره وقال لمن لامه يا قوم اني من امري علي حالتين حالة يقين وحالة شك ولا بد لي من احداهما اما حالة الشك فاني استندت الي ابن تاشفين او الي الاذفونش ففي الممكن ان يفي لي ويبقي علي وفاءه ويمكن ان لا يفعل فهذه حالة شك واما حالة اليقين فاني ان استندت الي ابن تاشفين فاني ارضي الله وان استندت الي الاذفونش اسخطت الله فاذا كانت حالة الشك فيهما عارضة فلاي شء ادع ما يرضي الله واتي ما يسخطه فحينءذ اقصر اصحابه عن لومه
 ولما عزم ابن عباد علي رايه امر صاحب بطليوس المتوكل علي الله عمر بن الافطس وصاحب غرناطة عبد الله بن حبوس الصنهاجي ان يبعث اليه كل منهما قاضي حضرته ففعلا واستحضر قاضي الجماعة بقرطبة عبد الله بن محمد بن ادهم وكان اعقل اهل زمانه فلما اجتمع عند ابن عباد القضاة باشبيلية اضاف اليهم وزيره ابا بكر بن زيدون وعرفهم اربعتهم انهم رسله الي يوسف بن تاشفين واسند الي القضاة ما يليق بهم من وعظ يوسف وترغيبه في الجهاد واسند الي الوزير ما لا بد منه من ابرام العقود السلطانية
 وكان يوسف بن تاشفين لا تزال تفد عليه وفود ثغور الاندلس مستعطفين مجهشين بالبكاء ناشدين بالله والاسلام مستنجدين بفقهاء حضرته ووزراء دولته فيسمع اليهم ويصغي لقولهم وترق نفسه لهم
 ولما انتهت الرسل الي ابن تاشفين اقبل عليهم واكرم مثواهم وجرت بينه وبينهم مراوضات ثم انصرفوا الي مرسلهم
 ثم عبر يوسف البحر عبورا سهلا حتي اتي الجزيرة الخضراء فخرج اليه اهلها بما عندهم من الاقوات والضيافات واقاموا له سوقا جلبوا اليه ما عندهم من ساءر المرافق واذنوا للغزاة في دخول البلد والتصرف فيها  فامتلات المساجد والرحاب بالمطوعة وتواصوا بهم خيرا هذا مساق صاحب الروض المعطار
 وقال ابن الاثير لما رجع المعتمد ابن عباد الي اشبيلية وترك قرطبة بدون مدافع وسمع مشايخها بما جري من قتل ابن عباد لليهودي وراوا قوة الفرنج وضعف المسلمين واستعانة بعض ملوكهم بالفرنج علي بعض اجتمعوا وقالوا هذه بلاد الاندلس قد غلب عليها الفرنج ولم يبق منها الا القليل وان استمرت الاحوال علي ما نري عادت نصرانية كما كانت وساروا الي القاضي ابي بكر عبد الله بن محمد بن ادهم فقالوا له الا تنظر الي ما فيه المسلمون من الصغار والذلة واعطاءهم الجزية بعد ان كانوا ياخذونها وقد راينا رايا نعرضه عليك قال ما هو قالوا نكتب الي عرب افريقية ونشترط لهم اذا وصلوا الينا قاسمناهم اموالنا وخرجنا معهم مجاهدين في سبيل الله وقال اخاف اذا وصلوا الينا ان يخربوا بلادنا كما فعلوا بافريقية ويتركوا الفرنج ويبدءوا بنا والمرابطون اصلح منهم واقرب الينا قالوا له فكاتب يوسف بن تاشفين وراغب اليه في العبور الينا او يرسل بعض قواده
 وبينما هم يتفاوضون اذ قدم عليهم ابن عباد وهم في ذلك فعرض عليه القاضي ابن ادهم ما كانوا فيه فقال له ابن عباد انت رسولي اليه في ذلك فامتنع القاضي وانما اراد ان يبرء نفسه من تهمة تلحقه فالح عليه المعتمد فعبر القاضي البحر الي امير المسلمين يوسف بن تاشفين فابلغه الرسالة واعلمه ما فيه المسلمون من الخوف من الاذفونش وكان امير المسلمين يومءذ بمدينة سبتة ففي الحال امر بعبور العساكر الي الاندلس وارسل الي مراكش في طلب من بقي من عساكره فاقبلت اليه يتلو بعضها بعضا فلما تكاملت عنده عبر البحر وسار فاجتمع بالمعتمد ابن عباد باشبيلية
 وكان المعتمد قد جمع عساكره ايضا وخرج من اهل قرطبة عسكر كبير وقصده المطوعة من ساءر بلاد الاندلس ووصلت الاخبار الي الاذفونش فجمع عساكره وحشد جنوده وسار من طليطلة وكتب الي امير  المسلمين يوسف بن تاشفين كتابا كتبه له بعض غواة ادباء المسلمين يغلظ له في القول ويصف ما معه من القوة والعدد وبالغ في ذلك فلما وصل وقراه يوسف امر كاتبه ابا بكر بن القصيرة ان يجيبه وكان كاتبا مفلقا فكتب واجاد فلما قراه علي امير المسلمين قال هذا كتاب طويل واحضر كتاب الاذفونش وكتب علي ظهره الذي يكون ستراه وارسله اليه فلما وقف عليه الاذفونش ارتاع له وعلم انه بلي برجل له دهاء وعزم
 وذكر ابن خلكان ان يوسف بن تاشفين امر بعبور الجمال فعبر منها ما اغص الجزيرة وارتفع رغاءها الي عنان السماء ولم يكن اهل الجزيرة راوا جملا قط ولا خيلهم راتها قط فصارت الخيل تجمح من رءية الجمال ورغاءها وكان ليوسف في عبورها راي مصيب فكان يحدق بها عسكره ويحضرها الحرب فكانت خيل الفرنج تجمح منها
 وقدم يوسف بن تاشفين بن يديه كتابا للاذفونش يعرض عليه فيه الدخول في الاسلام او الجزية او الحرب كما هي السنة ومن جملة ما في الكتاب بلغنا يا اذفونش انك دعوت الله في الاجتماع بنا وتمنيت ان تكون لك سفن تعبر عليها البحر الينا فقد عبرناه اليك وقد جمع الله تعالي في هذه العرصة بيننا وبينك وستري عاقبة دعاءك وما دعاء الكافرين الا في ضلال فلما سمع الاذفونش ما كتب اليه يوسف جاش بحر غيظه وزاد في طغيانه واقسم ان لا يبرح من موضعه حتي يلقاه
 ولنرجع الي كلام صاحب الروض والمعطار قال رحمه الله فلما عبر يوسف وجميع جيوشه البحر الي الخضراء نهض الي اشبيلية علي احسن الهيءات جيشا بعد جيش واميرا بعد امير وقبيلا بعد قبيل وبعث المعتمد ابنه الي لقاء يوسف وامر عمال البلاد بجلب الاقوات والضيافات وراي يوسف ما سره من ذلك ونشطه وتواردت الجيوش مع امراءها علي اشبيلية
 وخرج المعتمد الي لقاء يوسف من اشبيلية في ماءة فارس من وجوه اصحابه فلما اتي محلة يوسف ركض نحوهم وركضوا نحوه ثم برز اليه  يوسف وحده والتقيا منفردين وتصافحا وتعانقا واظهر كل منهما لصاحبه المودة والخلوص وشكرا نعم الله وتواصيا بالصبر والرحمة وبشرا انفسهما بما استقبلاه من غزو اهل الكفر وتضرعا الي الله في ان يجعل ذلك خالصا لوجهه مقربا اليه وافترقا فعاد يوسف لمحلته وابن عباد الي جهته والحق ابن عباد ما كان اعده من هدايا وتحف وضيافات اوسع بها علي محلة يوسف بن تاشفين
 وباتوا تلك الليلة فلما اصبحوا وصلوا الصبح ركب الجميع واشار ابن عباد علي يوسف بالتقدم نحو اشبيلية ففعل وراي الناس من عزة سلطانهم ما سرهم ولم يبق من ملوك الطواءف بالاندلس الا من بادر او اعان وكذلك فعل الصحراويون مع يوسف اهل كل صقع من اصقاعه رابطوا وكابدوا
 وكان الاذفونش لما راي اجتماع العزاءم علي مناجزته علم انه عام نطاح فاستنفر الفرنجة للخروج ورفع القسيسون والرهبان والاساقفة صلبانهم ونشروا اناجيلهم فاجتمع له من الجلالقة والافرنج ما لا يحصي عدده وجواسيس كل فريق تتردد من الجميع وبعث الاذفونش الي ابن عباد ان صاحبكم يوسف قد تعني بالمجء من بلاده وخوض البحر وانا اكفيه العناء فيما بقي ولا اكلفكم تعبا امضي اليكم والقاكم في بلادكم رفقا بكم وتوفيرا عليكم وقال لخاصته واهل مشورته اني رايت اني ان امكنتهم من الدخول الي بلادي فناجزوني فيها وبين جدرها وربما كانت الداءرة علي يستحكمون البلاد ويحصدون من فيها غداة واحدة ولكني اجعل يومهم معي في حوز بلادهم فان كانت علي اكتفوا بما نالوه ولم يجعلوا الدروب وراءهم الا بعد اهبة اخري فيكون في ذلك صون لبلادي وجبر لمكاسري وان كانت الداءرة عليهم كان مني فيهم وفي بلادهم ما خفت ان يكون في وفي بلادي اذا ناجزوني في وسطها
 ثم برز بالمختار من جنوده وانجاد جموعه علي باب دربه وترك بقية جموعه خلفه وقال حين نظر الي ما اختاره منهم بهءلاء اقاتل الجن والانس وملاءكة السماء فالمقلل يقول المختارون اربعون الف دارع  ولكل واحد اتباع واما النصاري فيعجبون ممن يزعم ذلك ويرون انهم اكثر من ذلك كله
 واتفق الكل ان عدد المسلمين كان اقل من عدد الكفار وراي الاذفونش في نومه كانه راكب فيلا وبين يديه طبل صغير وهو ينقر فيه فقص رءياه علي القسيسين فلم يعرفوا تاويلها فاحضر رجلا مسلما عالما بتفسير الرءيا فقصها عليه فاستعفاه من تعبيرها فلم يعفه فقال تاويل هذه الرءيا من كتاب الله تعالي وهو قوله تعالي @QB@ الم تر كيف فعل ربك باصحاب الفيل @QE@ الي اخر السورة وقوله تعالي @QB@ فاذا نقر في الناقور فذلك يومءذ يوم عسير علي الكافرين غير يسير @QE@ وذلك يقتضي هلاك هذا الجيش الذي تجمعه فلما اجتمع جيشه وراي كثرته اعجبه فاحضر ذلك المعبر وقال له بهذا الجيش القي اله محمد صاحب كتابكم فانصرف المعبر وقال لبعض المسلمين هذا الملك هالك وكل من معه وذكر الحديث ثلاث مهلكات وفيه واعجاب المرء بنفسه
