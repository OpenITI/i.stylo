 ومن تامل سيرته صلي الله عليه وسلم مع اهله واصحابه وغيرهم من الفقراء والايتام والارامل والضعفاء والمساكين علم انه صلي الله عليه وسلم بلغ الغاية في التواضع ورقة القلب ولين الجانب
 وعن انس رضي الله عنه ارسلني رسول الله صلي الله عليه وسلم في حاجة يوما فقلت والله لا اذهب وفي نفسي اني اذهب فخرجت علي صبيان يلعبون في السوق واذا رسول الله صلي الله عليه وسلم قد قبض ثيابي من وراءي فنظرت اليه صلي الله عليه وسلم وهو يضحك فقال يا انيس اذهب حيث امرتك فقلت نعم انا اذهب يا رسول الله ا ه
 وكان صلي الله عليه وسلم احسن الناس خلقا وارجح الناس حلما واعظم الناس عفوا واسخي الناس كفا
 وكان صلي الله عليه وسلم اجود بالخير من الريح المرسلة وقال صلي الله عليه وسلم يوما لاصحابه وقد اضطروه الي شجرة فخطفت رداءه الشريف فوقف ثم قال اعطوني رداءي لو كان لي عدد هذه العضاه نعما لقسمته بينكم
 وفي رواية لو ان لي مثل جبال تهامة ذهبا لقسمته بينكم ثم لا تجدوني كذوبا ولا بخيلا ولا جبانا كما تقدم
 وكان صلي الله عليه وسلم اشجع الناس قلبا واشد الناس حياء وكان اشد حياء من البنت البكر في خدرها اي بيتها وسترها وكان اذا فرح غض طرفه واذا اخذه العطاس وضع يده او ثوبه علي فيه وخفص صوته وربما غطي وجهه بيده او ثوبه
 وكان يحب الفال الحسن ويغير الاسم القبيح بالحسن كما تقدم وربما غير الحسن القبيح كما تقدم وكان يقول لاصحابه اذا ارسلتم لي رسولا فليكن حسن الاسم حسن الوجه
 من ذلك ان شخصا كان سادنا اي خادما لصنم وكان يسمي غاوي بن ظالم فبينما هو عند صنمه اذ اقبل ثعلبان الي الصنم ورفع كل واحدة منهما رجله وبال علي راس ذلك الصنم فلما راي ذلك كسر ذلك الصنم وانشد  ارب يبول الثعلبان براسه  لقد ذل من بالت عليه الثعالب  $ 
 واتي رسول الله صلي الله عليه وسلم فقال له كيف اسمك فقال غاوي بن ظالم فقال صلي الله عليه وسلم له بل انت راشد بن عبد ربه
 ومن هذا السياق يعلم ان الثعلبان بفتح الثاء المثلثة مثني ثعلب لا بضمها ذكر الثعالب كما قيل
 ومن تغيير الاسم القبيح بالحسن ما وقع له صلي الله عليه وسلم في غزوة ذي قرد انه مر علي ماء فسال عنه فقيل له هذا اسمه بءسان وهو مالح فقال لا بل اسمه نعمان وهو طيب فانقلب عذبا واشتراه طلحة بن عبيد الله رضي الله عنه ثم تصدق به فلما جاء اليه صلي الله عليه وسلم واخبره بذلك قال له رسول الله صلي الله عليه وسلم ما انت يا طلحة الا فياض فسمي طلحة الفياض
 وكان صلي الله عليه وسلم يشاور اصحابه في الامر قالت عاءشة رضي الله عنها ما رايت رحلا اكثر مشاورة للرجال من رسول الله صلي الله عليه وسلم
 وكان صلي الله عليه وسلم اذا حلف قال لا ومقلب القلوب وربما قال في يمينه واستغفر الله واذا اجتهد في اليمين قال لا والذي نفس ابي القاسم بيده وربما قال والذي نفس محمد بيده وربما قال في يمينه لا واستغفر الله والذي نفسي بيده
 وكان صلي الله عليه وسلم اكثر الناس اغضاء عن العورات وكان اذا كره شيءا عرف في وجهه ولم يشافه احدا بمكروه حتي اذا بلغه عن احد ما يكرهه لم يقل ما بال فلان يقول او يفعل كذا بل يقول ما بال اقوام يقولون او يفعلون كذا
 لا يجزي بالسيءة السيءة ولكن يعفو ويصفح اوسع الناس صدرا واصدق الناس لهجة والينهم عريكة واكرمهم عشيرة ما دعاه احد من اصحابه او اهل بيته الا قال لبيك يخالط اصحابه ويحادثهم ويداعب اي يمازح صبيانهم ويجلسهم في حجره الشريف
 اي فقد كان صلي الله عليه وسلم يصف اولاد عمه العباس عبد الله وعبيد الله وغيرهما رضي الله عنهم ويقول من سبق الي فله كذا فيستبقون اليه فيقعدون علي صدره الشريف فيقبلهم ويلتزمهم ويجيب دعوة الحر والعبد والامة والمسكين ويعود المرضي في اقصي المدينة ويشهد الجناءز ويقبل عذر المعتذر ما وضع احد فمه في اذنه الا استمر صاغيا له حتي يفرغ من حديثه ويذهب وما اخذ احد بيده فيرسل يده صلي الله عليه وسلم منه حتي يكون الاخذ هو الذي يرسلها 
 وكان صلي الله عليه وسلم يبدا من لقيه بالسلام ويبدا اصحابه بالمصافحة لم ير قط مادا رجليه بين اصحابه يكرم من يدخل عليه وربما بسط له رداءه واثره بالوسادة التي تحته ويعزم عليه بالجلوس عليها ان ابي ويدعو اصحابه باحب اسماءهم ويكنيهم ولا يجلس اليه احد وهو يصلي الا خفف صلاته وساله عن حاجته فاذا فرغ عاد الي صلاته وطعن في الحديث الذي ورد بذلك واذا سمع بكاء الصغير وهو يصلي تجوز فيها اي خففها
 اكثر الناس شفقة علي خلق الله تعالي وارافهم بهم وارحمهم بهم قال تعالي @QB@ وما ارسلناك الا رحمة للعالمين @QE@ ومن ثم رغب صلي الله عليه وسلم الي الله تعالي ان يجعل سبه ولعنه لاحد من المسلمين رحمة له اي اذا كان لا يستحق ذلك السب في باطن الامر ويستحقه في ظاهر الامر اي وقال صلي الله عليه وسلم من لا يرحم لا يرحم اوصل الناس للرحم واقومهم بالوفاء وحسن العهد
 وكان صلي الله عليه وسلم يقول انما انا عبد اكل كما ياكل العبد واجلس كما يجلس العبد
 وكان يركب الحمار اي وربما ركبه عريانا ويردف خلفه فعن انس رضي الله عنه رايته صلي الله عليه وسلم يوما علي حمار خطامه ليف اي وقد جاء ان ركوب الحمار براءة من الكبر وكان يجلس علي الارض وكان يشرب قاءما وقاعدا وينتعل قاءما وقاعدا ويصلي منتعلا وحافيا
 وفي لفظ كان اكثر صلاته صلي الله عليه وسلم في نعليه وكان يحب التيامن في شانه كله في طهوره وترجله وتنعله وكان يحب السواك حتي لقد احفي لثته وكان يكتحل بالاثمد عند النوم ثلاثا في كل عين وفي لفظ ثلاثا في اليمني ومرتين في اليسري وقال صلي الله عليه وسلم عليكم بالاثمد فان يحلو البصر وينبت الشعر وانه من خير اكحالكم وكان يعود المساكين ويجلس بين اصحابه
 وحج صلي الله عليه وسلم علي رحل رث عليه قطيفة ما تساوي اربعة دارهم وقال اللهم اجعله حجا مبرورا لا رياء فيه ولا سمعة كما تقدم واهدي في حجة ذلك ماءة بدنة كما تقدم
 وكان يفلي ثوبه اي وان كان من خصاءصه صلي الله عليه وسلم ان القمل لا يءذيه  ويحلب شاته ويخصف نعله ويرقع ثوبه ويخدم نفسه ويعلف ناضحه وهو الجمل الذي يسقي عليه الماء ويقم البيت
 قال وعن عاءشة رضي الله عنها كان رسول الله صلي الله عليه وسلم يعمل عمل البيت واكثر ما يعمل الخياطة ما يري فارغا قط في بيته اما يخصف نعلا لرجل مسكين او يخيط ثوبا لارملة انتهي وياكل مع الخادم ويحمل بضاعته من السوق ويحب الطيب ويامر به
 وكان يتطيب بالمسك والغالية ويتبخر بالعود والعنر والكافور ويامر اصابه بالمشي امامه ويقول خلوا ظهري للملاءكة زاهدا في الدنيا ما ترك درهما وا دينارا
 توفي ودرعه مرهونة وتقدم انها ذات الفضول عند يهودي وتقدم انه ابو الشحم علي نفقة عياله وتقدم ان ذلك كان ثلاثين صاعا من الشعير وكان الاجل سنة
 وكان صلي الله عليه وسلم يقول اللهم اجعل رزق ال محمد قوتا ما شبع ثلاثا ايام تباعا من خبر البر حتي فارق الدنيا وعن النعمان بن بشير رضي الله عنه قال لقد رايت نبيكم صلي الله عليه وسلم وما يجد من الدقل ما يملا بطنه
 وفي رواية ما شبع يومين من خبر الشعير اي ومعلوم ان ذلك انما هو لتتاسي به امته في الاعراض عن الدنيا قالت عاءشة رضي الله عنها قال لي رسول الله صلي الله عليه وسلم اني عرض علي ان يجعل لي بطحاء مكة ذهبا فقلت لا يارب اجوع يوما واشبع يوما فاما اليوم الذي اجوع فيه فاضرع اليك وادعوك واما اليوم الذي اشبع فيه فاحمدك واثني عليك
 قال صلي الله عليه وسلم مالي وللدنيا انما انا في الدنيا كرجل سار في يوم صاءف فاستظل تحت شجرة حتي مال الفء فتركها ولم يرجع اليها
 وقال صلي الله عليه وسلم ما ابالي بما رددت به عني الجوع ولم ينخل له صلي الله عليه وسلم دقيق الشعير قال وعن عاءشة رضي الله عنها انها قالت والذي بعث محمدا بالحق ما راي منخلا ولا اكل خبزا منخولا منذ بعثه الله تعالي الي ان قبض فقيل لها كيف كنتم تصنعون بالشعير قالت كنا نقول اف اف انتهي اي فيطير ما طار وما بقي عجناه ولا خبز له صلي الله عليه وسلم مرقق ولا اكل النقي من الخبر
 وعن انس رضي الله عنه قال جاءت فاطمة رضي الله عنها بكسرة خبز الي النبي  صلي الله عليه وسلم فقال ما هذه الكسرة يا فاطمة قالت قرص خبزته فلم تطب نفسي حتي اتيتك بهذه الكسرة فقال صلي الله عليه وسلم اما انه اول طعام دخل فم ابيك منذ ثلاثة ايام اي فانه صلي الله عليه وسلم كان يبيت الليالي المتابعة طاويا ولا اكل علي خوان قط انما كان ياكل علي السفرة وربما وضع صلي الله عليه وسلم طعامه علي الارض
 اي وخطب صلي الله عليه وسلم يوما فقال والله ما امسي في بيت محمد صاع من طعام وانها لتسعة ابيات قال الحسن والله ما قالها استقلالا لرزق الله ولكن اراد صلي الله عليه وسلم ان تتاسي به امته
 وعن ابي هريرة رضي الله عنه كان يمر هلال ثم هلال لا يوقد في بيت من بيوت رسول الله نار لا لخبز ولا لطبخ فقيل له باي شء كانوا يعيشون يا ابا هريرة فقال بالاسودين الماء والتمر
 وعن ابن عباس رضي الله عنهما قال والله لقد كان ياتي علي ال محمد صلي الله عليه وسلم الليالي ما يجدون فيها عشاء
 وعن عاءشة رضي الله تعالي عنها اهدي لنا ابو بكر شاة قالت اني لاقطعها مع رسول الله صلي الله عليه وسلم في ظلمة البيت فقال لها قاءل اما كان لكم سراج فقالت لو كان لنا ما نسرج به اكلناه
 وكان صلي الله عليه وسلم لا يجمع في بطنه بين طعامين ان اكل لحما لم يزد عليه وان اكل تمرا لم يزد عليه وان اكل خبزا لم يزد عليه ولم يكن له صلي الله عليه وسلم الا ثوب واحد من قطن قصير الكمين كمه الي الرسغ وطوقه مطلق من غير ازرار اي وفي لفظ كان قميص رسول الله قطنا قصير الطول قصير الكمين كمه الي الرسغ
 وكان له صلي الله عليه وسلم جبة ضيقة الكمين وكان له رداء طوله اربعة اذرع وعرضه ذراعان وشبر من نسج عمان
 وكان له صلي الله عليه وسلم بردة يمانية طولها ستة اذرع في عرض ثلاثة اذرع وشبر كان يلبسهما في يوم الجمعة والعيدين ثم يطويان
 وكان له صلي الله عليه وسلم رداء اخضر طوله اربعة اذرع وعرضه ذراعان وشبر تداولته الخلفاء 
 وكان له صلي الله عليه وسلم عمامة تسمي السحاب كساها علي بن ابي طالب كرم الله وجهه فكان ربما طلع عليه كرم الله وجهه فيقول صلي الله عليه وسلم اتاكم علي في السحاب يعني عمامته التي وهبي له صلي الله عليه وسلم
 وكان اذا اعتم يرخي عمامته بين كتفيه وكان يلبس القلنسوة اللاطءة اي اللاصقة بالراس وذات الاذان كان يلبسها في الحروب والقلانس الطوال انما حدثت في ايام الخليفة المنصور
 وكان صلي الله عليه وسلم يقول فرق بيننا وبين المشركين العماءم علي القلانس اي فانه صلي الله عليه وسلم كان يلبس القلانس تحت العماءم ويلبس القلانس بغير عماءم ويلبس العماءم بغير قلانس
 وكان له صلي الله عليه وسلم عمامة سوداء دخل يوم فتح مكة لابسها وعن جابر ابن عبد الله رضي الله تعالي عنهما قال كان للنبي صلي الله عليه وسلم عمامة سوداء يلبسها في العيدين ويرخيها خلفه
 وجاء ان جبريل عليه السلام كانت عمامته يوم غرق فرعون سوداء ومقدار عمامته الشريفة صلي الله عليه وسلم لم يثبت في حديث قال بعض الحفاظ والظاهر انها كانت نحو العشرة اذرع او فوقها بيسير وكانت له صلي الله عليه وسلم خرقة اذا توضا تمسح بها هذا
 وفي سفر السعادة لم يكن صلي الله عليه وسلم ينشف اعضاءه بعد الوضوء بمنديل ولا منشفة وان احضروا له شيءا من ذلك ابعده والحديث المروي عن عاءشة رضي الله عنها كانت له صلي الله عليه وسلم نشافة يتنشف بها بعد الوضوء وحديث معاذ رضي الله عنه في معناه كلاهما ضعيف وقال تنشيف الاعضاء من الوضوء لم يصح فيه الحديث
 وكانت له صلي الله عليه وسلم ملحفة مورسة اذا اراد ان يدور علي نساءه رشها بالماء اي لتظهر راءحتها وكان يصبغ قميصه ورداءه وعمامته بالزعفران اي وفي لفظ كان يصبغ ثيابه كلها بالزعفران حتي العمامة
 وعن ابي هريرة رضي الله تعالي عنه قال خرج علينا رسول الله صلي الله عليه وسلم وعليه قميص اصفر ورداء اصفر وعمامة صفراء
 وعن ابن ابي اوفي رضي الله تعالي عنه كان احب الصبغ الي رسول الله صلي الله عليه  وسلم وسلم الصفرة وقال الحافظ الدمياطي رحمه الله ويعارض هذه الاحاديث ما روي في الصحيح ان رسول الله صلي الله عليه وسلم نهي عن المزعفر وفي لفظ نهي عن ان يتزعفر الرجل
 اي وقد يقال علي تقدير صحة تلك الاحاديث فهي منسوخة او كان ذلك من خصوصياته صلي الله عليه وسلم وقد صح انه صلي الله عليه وسلم اشتري السراويل واختلف هل لبسها فقيل نعم ففي الاوسط للطبراني ومسند ابي يعلي عن ابي هريرة رضي الله تعالي عنه قال دخلت يوما السوق مع رسول الله صلي الله عليه وسلم فجلس الي بزازين فاشتري سراويل باربعة دراهم وكان لاهل السوق وزان فقال له رسول الله صلي الله عليه وسلم اوزن وارجح واخذ رسول الله صلي الله عليه وسلم السراويل فذهبت لاحمله عنه فقال صاحب الشء احق بشيءه ان يحمله الا ان يكون ضعيفا يعجز عنه فيعينه اخوه المسلم قلت يا رسول الله انك لتلبس السراويل قال اجل في السفر والحضر وبالليل والنهار فاني امرت بالستر فلم اجد شيءا استر منه ومخرجه هو وشيخه ضعيفان
 وكان صلي الله عليه وسلم يقول اللهم توفني فقيرا ولا توفني غنيا واحشرني في زمرة المساكين وفي لفظ اخر اللهم احيني مسكينا وامتني مسكينا واحشرني في زمرة المساكين فان اشقي الاشقياء من اجتمع عليه فقر الدنيا وعذاب الاخرة اتتني الدنيا خضرة حلوة ورفعت الي راسها وتزينت لي فقلت اني لا اريدك لا حاجة لي فيك ولو كانت الدنيا تزن عند الله جناح بعوضة ما سقي الكافر منها شربة ماء انتهي
 وعن ابن عباس رضي الله عنهما كان النبي صلي الله عليه وسلم يبيت هو واهله الليالي المتتابعة طاويا لا يجدون عشاء
 قال وكان صلي الله عليه وسلم يقول لو تعلمون ما اعلم لضحكتم قليلا ولبكيتم كثيرا الفاقة احب الي من اليسار وعن عاءشة رضي الله عنها قالت كنت ارثي له صلي الله عليه وسلم من الجوع واقول نفسي لك الفداء لو تبلغت من الدنيا بقدر ما يقويك ويمنع عنك الجوع فيقول يا عاءشة ان اخواني من اولي العزم من الرسل قد صبروا علي ما هو اشد من هذا فمضوا علي حالهم فقدموا علي ربهم فاكرمهم واجزل ثوابهم اخشي ان ترفعت في معيشتي ان يقصر بي دونهم فاصبر اياما يسيرة احب الي من ان ينقص حظي غدا في الاخرة وما من شء احب الي من اللحوق باخواني 
 قال وقال صلي الله عليه وسلم يا عاءشة ان الدنيا لا تنبغي لمحمد ولا لال محمد يا عاءشة ان الله لم يرض من اولي العزم من الرسل الا بالصبر وقال @QB@ فاصبر كما صبر اولوا العزم من الرسل @QE@ والله لاصبرن جهدي ولا قوة الا بالله انتهي
 وكان صلي الله عليه وسلم يقول لا تطروني كما اطرت النصاري عيسي ابن مريم فانما انا عبد فقولوا عبد الله ورسوله وكان صلي الله عليه وسلم علي غاية من الاعراض عن الدنيا وكان يصلي علي الحصير وعلي الفروة المدبوغة وربما نام علي الحصير فاثرت في جسده الشريف
 وكان ينام علي شء من ادم محشو ليفا فقيل له في ذلك فقال مالي وللدنيا
 وعن عاءشة رضي الله عنها دخلت امراة من الانصار فرات ذلك الادم وفي لفظ رات فراش رسول الله صلي الله عليه وسلم عباءة مثنية فانطلقت فبعثت اليه بفراش حشوه صوف فدخل علي رسول الله صلي الله عليه وسلم فقال ما هذا فقلت يا رسول الله فلانه الانصارية دخلت علي فرات فراشك فذهبت فبعثت هذا فقال رديه فلم ارده واعجبني ان يكون في بيتي حتي قال ذلك ثلاث مرات فقال والله يا عاءشة لو شءت لاجري الله معي جبال الذهب الفضة
 وعنها رضي الله عنها كانت تفرش تلك العباءة مثنية طاقين ففي بعض الليالي ربعتها فنام صلي الله عليه وسلم عليها ثم قال يا عاءشة مالفراشي الليلة ليس كما يكون قلت يا رسول الله ربعتها قال فاعيديه كما كان
 وكان صلي الله عليه وسلم اذا استجد ثوبا قال اللهم لك الحمد انت كسوتنيه اسالك من خيره ما صنع له واعوذ بك من شره وشر ما صنع له وكان يقول لاصحابه كلهم رضي الله عنهم اذا لبس احدكم ثوبا فليقل الحمد لله الذي كساني ما اواري به عورتي واتجمل به في حياتي وكان ارجح الناس عقلا والعقل ماءة جزء تسعة وتسعون في النبي صلي الله عليه وسلم وجزء في ساءر الناس
 وعن وهب بن منبه قرات في احد وسبعين كتابا انه صلي الله عليه وسلم ارجح الناس وافضلهم رايا وفي رواية وجدت في جميعها ان الله تعالي لم يعط جميع الناس من بدء الدنيا الي انتهاءها من العقل في جنب عقله صلي الله عليه وسلم الا كحبة بين رمال الدنيا ومما يتفرع علي العقل اقتناء الفضاءل واجتناب الرذاءل واصابة الراي وجودة الفطنة  وحسن السياسة والتدبير وقد بلغ من ذلك صلي الله عليه وسلم الغاية التي لم يبلغها بشر سواه
 ومما يكاد يقضي منه العجب حسن تدبيره صلي الله عليه وسلم للعرب الذين هم كالوحوش الشاردة كيف ساسهم واحتمل جفاهم وصبر علي اذاهم الي ان انقادوا اليه صلي الله عليه وسلم واجتمعوا عليه واختاروه علي انفسهم وقاتلوا دونه اهلهم واباءهم وابناءهم وهاجروا في رضاه اوطانهم انتهي والله اعلم & باب يذكر فيه مدة مرضه وما وقع فيه ووفاته صلي الله عليه وسلم التي هي مصيبة الاولين والاخرين من المسلمين
 ذكر انه صلي الله عليه وسلم خرج الي البقيع من جوف الليل فاستغفر لهم فعن ابي مويهيه مولي رسول الله صلي الله عليه وسلم ان رسول الله صلي الله عليه وسلم قال له في جوف الليل اني قد امرت ان استغفر لاهل البقيع فانطلق معي قال فانطلقت معه فلما وقف بين اظهرهم قال السلام عليكم يا اهل المقابر ليهن لكم ما اصبحتم فيه مما اصبح الناس فيه لو تعلمون ما نجاكم الله منه اقبلت الفتن كقطع الليل المظلم يتبع اخرها اولها والاخيرة شر من الاولي قال ثم اقبل علي وقال يا ابا مويهية هل علمت اني قد اوتيت مفاتيح خزاءن الدنيا والخلد فيها ثم الجنة وخيرت بين ذلك وبين لقاء ربي فاخترت لقاء ربي والجنة اي وفي رواية ان ابا مويهية قال له والله يا ابا مويهية لقد اخترت لقاء ربي والجنة ثم رجع صلي الله عليه وسلم الي اهله فلما اصبح ابتدء بوجعه من يومه ذلك ابتداه الصداع اي وفي رواية ذهب بعد ذلك الي قتلي احد فصلي عليهم فرجع معصوب الراس فكان ذلك بدء الوجع الذي مات فيه وفي رواية رجع من جنازة البقيع
 قالت عاءشة رضي الله عنها لما رجع من البقيع وجدني وانا اجد صداعا في راسي وانا اقول واراساه فقال صلي الله عليه وسلم بل انا واراساه قال لو كان ذلك وانا حي فاستغفر لك وادعو لك واكفنك وادفنك وفي لفظ وما يضرك لو مت قبلي فقمت عليك وكفنتك  وصليت عليك ودفنتك فقلت واثكلاه والله انك لتحب الموتي فلو كن ذلك لظللت يومك معرسا ببعض ازواجك قالت فتبسم رسول الله صلي الله عليه وسلم فقال النبي صلي الله عليه وسلم بل انا واراساه لقد هممت ان ارسل الي ابيك واخيك فاقص امري واعهد عهدي فلا يطمع في الدنيا طامع وفي لفظ ثم قلت يابي الله ويدفع المءمنون او يدفع الله ويابي المءمنون وفي رواية انها قالت قال لي رسول الله صلي الله عليه وسلم في مرضه ادعي لي اباك ابا بكر واخاك حتي اكتب كتابا فاني اخاف ان يتمني متمن او يقول قاءل انا اولي ويابي الله والمءمنون الا ابا بكر وفي رواية لما ثقل رسول الله صلي الله عليه وسلم قال لعبد الرحمن بن ابي بكر رضي الله عنهما اءتني بكتف او لوح حتي اكتب لابي بكر كتابا لا يختلف عليه فلما ذهب عبد الرحمن ليقوم قال ابي الله والمءمنون ان يختلف عليك يا ابا بكر
 قال ابن كثير رحمه الله وقد خطب رسول الله صلي الله عليه وسلم خطبة بين فيها فضل الصديق رضي الله عنه من بين الصحابة رضوان الله عليهم اجمعين ولعل خطبته صلي الله عليه وسلم هذه كانت عوضا عما اراد صلي الله عليه وسلم ان يكتبه في الكتاب
 وفي رواية انه اجتمع عنده صلي الله عليه وسلم رجال فقال صلي الله عليه وسلم هلموا اكتب لكم كتابا لا تضلوا بعده فقال بعضهم اي وهو سيدنا عمر رضي الله عنه ان رسول الله صلي الله عليه وسلم قد اشتد عليه الوجع وعندكم القران اي وانما قال ذلك رضي الله عنه تخفيفا علي رسول الله صلي الله عليه وسلم فارتفعت اصواتهم فامرهم بالخروج من عنده
 وجاء ان العباس رضي الله عنه قال لعلي كرم الله وجهه لا اري رسول الله صلي الله عليه وسلم يصح من مرضه هذا فاني اعرف وجوه بني عبد المطلب عند الموت اي وفي راوية خرج علي بن ابي طالب كرم الله وجهه من عند رسول الله صلي الله عليه وسلم وهو في مرضه الذي مات فيه فقال الناس يا ابا الحسن كيف اصبح رسول الله صلي الله عليه وسلم فقال اصبح بحمد الله بارءا فاخذ بيده عمه العباس رضي الله عنهما وقال له والله انت بعد ثلاث عبد العصي واني لا اري رسول الله صلي الله عليه وسلم من وجعه هذا بعد ثلاث الا ميتا فاني رايت في وجهه ما كنت اعرفه في وجوه بني عبد المطلب عند الموت فاذهب بنا الي رسول الله صلي الله عليه وسلم فنساله فيمن هذا الامر فان  كان فينا علمنا ذلك وان كان في غيرنا كلمناه فاوصي بنا فقال علي كرم الله وجهه والله لا اسالها رسول الله صلي الله عليه وسلم قالت عاءشة رضي الله عنها وصار صلي الله عليه وسلم يدور علي نساءه فاشتد به المرض عند ميمونة رضي الله عنها وقيل في بيت زينب رضي الله عنها وقيل في بيت ريحانة رضي الله عنها قالت عاءشة رضي الله عنها فدعا صلي الله عليه وسلم نساءه فاستاذنهن ان يمرض في بيتي فاذن له وفي رواية صار يقول وهو في بيت ميمونة اين انا غدا اين انا غدا يريد يوم عاءشة رضي الله عنها وفي البخاري يقول اين انا اليوم اين انا غدا استبطاء ليوم عاءشة رضي الله عنها فاذن له ازواجه ان يكون حيث شاء فكان في بيت عاءشة
 وفي رواية عنها ان رسول الله صلي الله عليه وسلم بعث الي النساء في مرضه فاجتمعن فقال اني لا استطيع ان ادور بينكن فان رايتن ان تاذن لي فاكون في بيت عاءشة فعلتن فاذن له قالت فخرج رسول الله صلي الله عليه وسلم يمشي بين رجلين من اهله معتمدا عليهما الفضل بن العباس ورجل اخر وفي رواية بين عباس بن عبد المطلب وبين رجل اخر وفي رواية بين اسامة ورجل اخر عاصبا راسه الشريف تخط قدماه الارض حتي دخل بيتي قال ابن عباس رضي الله عنهما الرجل الذي لم تسمه علي بن ابي طالب كرم الله وجهه اي فانه كان بينها وبين علي ما يقع بين الاحماء وقد صرحت بذلك ولما ارادت ان تتوجه من البصرة بعد انقضاء وقعة الجمل وخرج الناس ومن جملتهم علي كرم الله وجهه لتوديعها حيث قالت والله ما كان بيني وبين علي في القديم الا ما يكون بين المراة واحماءها فقال علي ايها الناس صدقت والله وبرت ما كان بيننا الي ذلك وانها لزوجة نبيكم في الدنيا والاخرة وقد تقدم ذلك
 ثم غمر رسول الله صلي الله عليه وسلم واشتد به وجعه فقال هريقوا علي من سبع قرب من ابار شتي حتي اخرج الي الناس فاعهد اليهم فاقعدناه صلي الله عليه وسلم في مخضب اناء من حجر ثم صببنا عليه الماء حتي طفق يقول حسبكم حسبكم وفي لفظ حتي طفق يشير الينا بيده ان قد فعلتن اي وصب المياه المذكورة له دخل في دفع السم اي فانه صلي الله عليه وسلم صار يقول لعاءشة يا عاءشة ما ازال اجد الم الطعام الذي اسممته بخيبر فهذا اوان انقطاع ابهري من ذلك السم فخرج رسول الله صلي الله عليه وسلم عاصبا راسه الشريف علي المنبر حتي جلس علي المنبر ثم كان اول من تكلم به ان صلي علي اصحاب  احد اي دعا لهم فاكثر عليهم واستغفر لهم ثم قال ان عبدا من عباد الله خيره الله بين الدنيا وبين ما عنده فاختار ذلك العبد ما عند الله ففهمها ابو بكر رضي الله تعالي عننه وعرف ان نفسه يريد اي فبكي ابو بكر فقال نفديك بانفسنا وابناءنا فقال علي رسلك يا ابا بكر اي وفي رواية قال يا ابا بكر لا تبك ايها الناس امن الناس علي في صحبته وماله ابو بكر وهذا حديث صحيح جاء عن بضعه عشر صحابيا ولكثرة طرقه عد من المتواتر
 وفي اخري ان اعظم الناس علي منا في صحبته وذات يده ابو بكر وفي اخري فاني لا اعلم امرا افضل عندي يدا في الصحابة من ابي بكر
 وعن عاءشة رضي الله عنها قالت قال رسول الله صلي الله عليه وسلم ما من نبي يموت حتي يخير بين الدنيا والاخرة اي وفي الحديث حياتي خير لكم ومماتي خير لكم تعرض علي اعمالكم فان رايت شرا استغرت لكم اي وهذا بيان للثاني لاستغناء الاول عن البيان ومعلوم ان خيرا وشرا هنا ليسا افعل تفضيل الذي يوصل بمن حتي يلزم التناقض بل المراد ان ذلك فضيلة ثم قال صلي الله عليه وسلم انظروا هذه الابواب اللاصقة في المسجد اي وفي لفظ هذه الابواب الشوارع في المسجد فسدوها الا باب ابي بكر اي وفي لفظ الا ما كان من باب ابي بكر فاني وجدت عليه نورا وفي لفظ سدوا عني كل خوخة في هذا المسجد الا خوخة ابي بكر فان المراد بالابواب الخوخ فاني لا اعلم ان احدا كان افضل في الصحبة عند يدا منه اي وفي لفظ ابو بكر صاحبي ومءنسي في الغار سدوا كل خوخة في المسجد غير خوخة ابي بكر وفي لفظ لا تءذوني في صاحبي ولولا ان الله سماه صاحبا لاتخذته خليلا الا فسدوا كل خوخة الا خوخة ابن ابي قحافة اي وجاء في الحديث لكل نبي خليل من امته وان خليلي ابو بكر وان الله اتخذ صاحبكم خليلا وفي رواية وان خليلي عثمان بن عفان وجاء لكل نبي خليل وخليل سعد ابن معاذ
 وفي اسباب النزول للثعالي عن ابي امامة رضي الله تعالي عنه قال قال رسول الله صلي الله عليه وسلم ان الله اتخذني خليلا كما اتخذ ابراهيم خليلا وانه لم يكنم نبي الا وله خليل الا وان خليلي ابو بكر وفي رواية الجامع الصغير ان الله اتخذني خليلا كما اتخذ ابراهيم خليلا وان خليلي ابو بكر وفي رواية الجامع الصغير خليلي من هذه الامة  اويس القرني ولعل هذا كان قبل ان يقول صلي الله عليه وسلم في مرض موته قبل موته بخمسة ايام اني ابرا الي الله ان يكون لي منكم خليل فان الله قد اتخذني خليلا كما اتخذ ابراهيم خليلا ولو كنت متخذا خليلا من امتي لا تخذت ابا بكر خليلا لكن خلة الاسلام افضل وفي رواية ولكن اخوه الاسلام ومودته وفي رواية لكن اخي وصاحبي
 وجمع بان الاول اي اثبات الخلة لغير الله محمول علي نوع منها ونفيها عن غير الله محمول علي كمالها
 ثم لا يخفي ان قوله صلي الله عليه وسلم ولو كنت متخذا خليلا غير ربي لاتخذت ابا بكر خليلا يدل علي ان مقام الخلة ارقي من مقام المحبة وان المحبة والخلة ليسا سواء خلافا لمن زعم ذلك
 اي ولا مانع ان يوجد في المفضول مالا يوجد في الفاضل فلا حاجة الي ما تكلفه بعضهم مما يدل علي ان مقام المحبة افضل من مقام الخلة اي الذي يدل عليه ما جاء الا قاءل قولا غير هجر ابراهيم خليل الله وموسي صفي الله وانا حبيب الله وانا سيد ولد ادم يوم القيامة وعند ذلك اي اغلاق الابواب قال الناس اغلق ابوابنا وترك باب خليله فقال النبي صلي الله عليه وسلم واري علي ابوابكم ظلمة لقد قلتم كذبت وقال ابو بكر صدقت وامسكتم الاموال وجاد لي بماله وخذلتموني وواساني اي ولعل قولهم وترك باب خليله لا ينافي ما تقدم من عدم اتخاذه خليلا
 وروي انه صلي الله عليه وسلم لما امر بسد الابواب الا باب ابي بكر قال عمر يا رسول الله دعني افتح كوة انظر اليك حيث تخرج الي الصلاة فقال رسول الله صلي الله عليه وسلم لا وقال العباس بن عبدالمطلب يا رسول الله ما بالك فتحت ابواب رجال في المسجد يعني ابا بكر وما بالك سددت ابواب رجال في المسجد فقال يا عباس ما فتحت عن امري ولا سددت عن امري وفي لفظ ما انا سددتها ولكن الله سدها
 وجاء عن ابن عباس رضي الله تعالي عنهما ان رسول الله صلي الله عليه وسلم امر بسد الابواب الا باب علي قال الترمذي حديث غريب وقال ابن الجوزي هو موضوع  وضعه الرافضة ليقابلوا به الحديث الصحيح في باب ابي بكر وجمع بعضهم بان قصة علي متقدمة علي هذا الوقت وان الناس كان لكل بيت بابان باب يفتح للمسجد وباب يفتح خارجه الا بيت علي كرم الله وجهه فانه لم يكن له الا باب من المسجد وليس له باب من خارج فامر صلي الله عليه وسلم بسد الابواب اي التي تفتح للمسجد اي بتضييقها وصيرورتها خوخا الا باب علي كرم الله وجهه فان عليا لم يكن له الا باب واحد ليس له طريق غيره كما تقدم فلم يامر صلي الله عليه وسلم بجعله خوخة ثم بعد ذلك امر صلي الله عليه وسلم بسد الخوخ الا خوخة ابي بكر رضي الله تعالي عنه
 وقول بعضهم حتي خوخة علي كرم الله وجهه فيه نظر لما علمت ان عليا كرم الله وجهه لم يكن له الا باب واحد فالباب في قصة ابي بكر رضي الله تعالي عنه ليس المراد به حقيقته بل الخوخة وفي قصة علي كرم الله وجهه المراد به حقيقته
 اقول ومما يدل علي تقدم قصة علي كرم الله وجهه ما روي عنه قال ارسل رسول الله صلي الله عليه وسلم الي ابي بكر ان سد بابك قال سمعا وطاعة فسد بابه ثم ارسل الي عمر ثم ارسل الي العباس بمثل ذلك ففعلا وامرت الناس ففعلوا وامتنع حمزة فقلت يا رسول الله قد فعلوا الي حمزة فقال صلي الله عليه وسلم قل لحمزة فليحول بابه فقلت ان رسول الله صلي الله عليه وسلم يامرك ان تحول بابك فحوله وعند ذلك قالوا يا رسول الله سددت ابوابنا كلها الا باب علي فقال ما انا سددت ابوابكم ولكن الله سدها وفي رواية ما انا سددت ابوابكم وفتحت باب علي ولكن الله فتح باب علي وسد ابوابكم
 وجاء انه صلي الله عليه وسلم خطب الناس فحمد الله واثني عليه وقال اما بعد فاني امرت بسد هذه الابواب غير باب علي فقال فيكم قاءلكم واني والله ما سددت شيءا ولا فتحته ولكني امرت بشء فاتبعته انما انا عبد مامور ما امرت به فعلت @QB@ ان اتبع الا ما يوحي الي @QE@ ومعلوم ان حمزة رضي الله تعالي عنه قتل يوم احد فقصة علي كرم الله وجهه متقدمة جدا علي قصة ابي بكر رضي الله تعالي عنه
 وعلي كون المراد بسد الابواب تضييقها وجعلها خوخا يشكل ما جاء امر رسول الله صلي الله عليه وسلم بسد الابواب كلها غير باب علي فقال العباس يا رسول الله قدر ما ادخل انا وحدي واخرج قال ما امرت بشء من ذلك فسدها كلها غير باب  علي فعلي تقدير صحة ذلك يحتاج الي الجواب عنه وعلي هذا الجميع يلزم ان يكون باب علي كرم الله وجهه استمر مفتوحا في المسجدمع خوخة ابي بكر رضي الله تعالي عنه لما علم انه لم يكن لعلي باب اخر من غير المسجد
 وحينءذ قد يتوقف في قول بعضهم في سد الخوخ الا خوخة ابي بكر اشارة الي استخلاف ابي بكر لانه يحتاج الي المسجد كثيرا دون غيره لكن في تاريخ ابن كثير رحمه الله وهذا اي سد جميع الابواب الشارعة الي المسجد الا باب علي لا ينافي ما ثبت في صحيح البخاري من امره صلي الله عليه وسلم في مرض الموت بسد الابواب الشارعة الي المسجد الا باب ابي بكر لان في حال حياته صلي الله عليه وسلم كانت فاطمة رضي الله تعالي عنها تحتاج الي المرور من بيتها الي بيت ابيها صلي الله عليه وسلم فابقي صلي الله عليه وسلم باب علي كرم الله وجهه لذلك رفقا بها واما بعد وفاته صلي الله عليه وسلم فزالت هذه العلة فاحتيج الي فتح باب الصديق رضي الله تعالي عنه لاجل خروجه الي المسجد ليصلي بالمسلمين لانه الخليفة بعده عليه الصلاة والسلام هذا كلامه وهو يفيد ان باب علي كرم الله وجهه سد مع سد الخوخ ولم يبق الا خوخة ابي بكر رضي الله تعالي عنه وجعل لبيت علي كرم الله وجهه باب من الخارج
 وعن ابي سعيد الخدري رضي الله تعالي عنه قال قال رسول الله صلي الله عليه وسلم لعلي يا علي لا يحل لاحد جنب مكث في المسجد غيري وغيرك
 وعن ام سلمة رضي الله تعالي عنها انها قالت خرج رسول الله صلي الله عليه وسلم في مرضه حتي انتهي الي صرحة المسجد فنادي باعلي صوته انه لا يحل المسجد لجنب ولا لحاءض الا لمحمد وازواجه وعلي وفاطمة بنت محمد الا هل بينت لكم ان لا تضلوا قال الحافظ ابن كثير وهذا اي الثاني اسناده غريب وفيه ضعف هذا كلامه والمراد المكث في المسجد لا المرور به والاستطراق منه فان ذلك لكل احد
 ثم رايت الحافظ السيوطي رحمه الله اشار الي ذلك وذكر ان مثل علي كرم الله وجهه فيما ذكر ولداه حسن والحسين حيث قال وكذا علي بن ابي طالب والحسن والحسين اختصوا بجواز المكث في المسجد مع الجنابة والله اعلم ثم قالي صلي الله عليه وسلم يا معشر المهاجرين استوصوا بالانصار خيرا انهم كانوا عيبتي التي اويت اليهم فاحسنوا الي محسنهم وتجاوزوا عن مسيءهم ثم نزل رسول الله صلي الله عليه وسلم 
 وروي انه صلي الله عليه وسلم قال في خطبته هذه ايها الناس من احس من نفسه شيءا فليقم ادع الله له فقام اليه رجل فقال يا رسول الله اني لمنافق واني لكذوب واني لنءوم فقال له عمر بن الخطاب رضي الله تعالي عنه ويحك ايها الرجل لقد سترك الله لو سترت علي نفسك فقال رسول الله صلي الله عليه وسلم يا ابن الخطاب فضوح الدنيا اهون من فضوح الاخرة اللهم ارزقه صدقا وايمانا واذهب عنه النوم اذا شاء
 قال ابن كثير في اسناده ومتنه غرابة شديدة وامر صلي الله عليه وسلم في مرضه ابا بكر ان يصلي بالناس قال وكانت تلك الصلاة صلاة العشاء وقد اذن بلال وقال ضعوا لي ماء في المخضب اي وهو شبه الاجانة من نحاس فاغتسل فيه اي وهذا مع ما سبق يدل علي انه صلي الله عليه وسلم كان له مخضب من حجر ومخضب من نحاس
 ثم اراد صلي الله عليه وسلم ان يذهب فاغمي عليه ثم افاق فقال اصلي الناس فقلنا لاهم ينتظرونك اي وعند ذلك ضعوا الي ماء في المخضب فاغتسل ثم اراد ان يذهب فاغمي عليه ثم افاق فقال اصلي الناس قلنا لا هم ينتظرونك يا رسول الله قال ضعوا لي ماء في المخضب فاغتسل ثم اراد ان يذهب فاغمي عليه ثم افاق فقال اصلي الناس قلنا لاهم ينتظرونك يا رسول الله والناس ملمومة في المسجد ينتظرون النبي صلي الله عليه وسلم لصلاة العشاء الاخرة فارسل الي ابي بكر رضي الله تعالي عنه بان يصلي بالناس فاتاه الرسول فقال له ان رسول الله صلي الله عليه وسلم يامرك ان تصلي بالناس فقال ابو بكر رضي الله تعالي عنه لعمر يا عمر صل بالناس فقال له عمر رضي الله تعالي عنه انت احق بذلك
 وفي رواية ان بلالا رضي الله تعالي عنه دخل عليه صلي الله عليه وسلم فقال الصلاة يا رسول الله فقال صلي الله عليه وسلم لا استطيع الصلاة خارجا ومر عمر بن الخطاب فليلصل بالناس فخرج بلال رضي الله تعالي عنه وهو يبكي فقال له المسلمون ما وراءك يا بلال فقال ان رسول الله صلي الله عليه وسلم لا يستطيع ان الصلاه خارجا فبكوا بكاء شديدا وقال لعمر ان رسول الله صلي الله عليه وسلم يامرك ان تصلي بالناس فقال عمر رضي الله عنه ما كنت لاتقدم بين يدي ابي بكر ابدا فادخل علي نبي الله صلي الله عليه وسلم فاخبره ان ابا بكر علي الباب فدخل عليه صلي الله عليه وسلم بلال رضي الله تعالي عنه فاخبره بذلك فقال نعم ما راي مر ابا بكر فليصل بالناس فخرج الي ابي بكر فامره ان يصلي فصلي بالناس  وفي روايه فقال مروا ابا بكر فليصل بالناس فقالت عاءشه رضي الله تعالي عنها فقلت ان ابا بكر رجل اسيف اي رقيق القلب اذا قام مقامك لم يسمع الناس من البكاء فقال صلي الله عليه وسلم مروا ابا بكر فليصل بالناس فعاودته فقال مروا ابا بكر فليصل بالناس فقلت لحفصه قولي له ان ابا بكر اذا قام مقامك لم يسمع الناس من البكاء فمر عمر فليصل بالناس ففعلت حفصه فقال رسول الله صلي الله عليه وسلم لحفصه مه انكن صواحب يوسف عليه الصلاة والسلام وفي لفظ انكن لانتن صواحب يوسف عليه الصلاه والسلام فقالت حفصه رضي الله تعالي عنها لعاءشه ما كنت لاصيب منك خيرا ومروا ابا بكر فليصل بالناس اي مثل صاحبه يوسف عليه الصلاه والسلام وهي زليخا اظهرت خلاف ما تبطن وظهرت للنساء اللاتي جمعتهن انها تريد اكرامهن بالضيافه وانما قصدها ان ينظرن لحسن يوسف عليه الصلاه والسلام فيعذرنها في حبه والنبي صلي الله عليه وسلم فهم عن عاءشه رضي الله تعالي عنها انها تظهر كراهه ذلك مع محبتها له باطنا هكذا يقتضيه ظاهر اللفظ
 والمنقول عن عاءشه رضي الله تعالي عنهاانها انما قصدت بذلك خوف ان يتشاءم الناس ابا بكر فيكرهونه حيث قام مقامه صلي الله عليه وسلم فقد جاء عنها رضي الله تعالي عنهاانها قالت ما حملني علي كثرة مراجعتي له صلي الله عليه وسلم الا انه لم يقع في قلبي ان يحب الناس بعده رجلا قام مقامه ابدا ولا كنت اري انه يقوم احد مقامه الا تشاءم الناس منه
 وفي رواية ان الانصار رضي الله تعالي عنهم لما راوا رسول الله صلي الله عليه وسلم يزادد وجعا طافوا بالمسجد واشفقوا من موته صلي الله عليه وسلم فدخل عليه الفضل رضي الله تعالي عنه فاخبره بذلك ثم دخل عليه علي كرم الله وجهه فاخبره بذلك ثم دخل عليه العباس رضي الله تعالي عنه فاخبره بذلك فخرج النبي صلي الله عليه وسلم متوكءا علي علي والفضل والعباس امامه والنبي صلي الله عليه وسلم معصوب الراس يخط برجليه حتي جلس علي اسفل مرقاة من المنبر وثار الناس اليه فحمد الله واثني عليه وقال ايها الناس بلغنمي انكم تخافون من موت نبيكم هل خلد نبي قبلي فيمن بعث اليه فاخلد فيكم الا واني لا حق بربي وانكم لاحقون به فاوصيكم بالمهاجرين الاولين خيرا واوصي المهاجرين فيما بينهم بخير فان الله يقول @QB@ والعصر ان الانسان لفي خسر @QE@ السورة  وان الامور تجري باذن الله ولا يحملكم استبطاء امر علي استعجاله فان الله عز وج لا يعجل لعجلة احد ومن غالب الله غلبه ومن خادع الله خدعه @QB@ فهل عسيتم ان توليتم ان تفسدوا في الارض وتقطعوا ارحامكم @QE@ واوصيكم بالانصار خيرا فانهم الذين تبوءوا الدار والايمان من قبلكم ان تحسنوا اليهم الم يشاطروكم في الثمار الم يوسعوا لكم في الديار الم يءثركم علي انفسكم وبهم الخصاصة الا فمن ولي انه يحكم بين رجلين فليقبل من محسنهم وليتجاوز عن مسيءهم الا ولا تستاثروا عليهم الا فاني فرطكم وانتم لاحقوني بي الا وانه موعدكم الحوض الا فمن احب ان يرده علي غدا فليكفف يده ولسانه الا فيما ينبغي ايها الناس ان الذنوب تغير النعم فاذا بر الناس برتهم اءمتهم واذا فجر الناس عقوا اءمتهم وفي الحديث حياتي خير لكم ومماتي خير لكم
 وقد اشار صلي الله عليه وسلم الي خيرية الموت بانه فرط فخير صفة لا افعل تفضيل حتي يشكل بانه يقتضي ان حياتي خير لكم من مماتي ومماتي خير لكم من حياتي كما مر ثم لا زال ابو بكر رضي الله تعالي عنه يصلي بالناس سبع عشرة صلاة وصلي النبي صلي الله عليه وسلم مءتما به ركعة ثانية من صلاة الصبح ثم قضي الركعة الثانية اي اتي بها منفردا
 وقال صلي الله عليه وسلم لم يقبض نبي حتي يءمه رجل من قومه اي وقد قال ذلك صلي الله عليه وسلم خلف عبدالرحمن بن عوف كما تقدم في تبوك
 قال وفي رواية عن عاءشة رضي الله تعالي عنها ان رسول الله صلي الله عليه وسلم وجد خفة
 اي وابو بكر في الصلاة فخرج بين رجلين احدهما العباس لصلاة الظهر فلما راه ابو بكر رضي الله تعالي عنه ذهب ليتاخر فاوما اليه ان لا يتاحر وامرهما فاجلساه الي جنب ابي بكر عن يساره وفي رواية عن يمينه وانه صلي الله عليه وسلم دفع في ظهر ابي بكر وقال صل بالناس اي ومنعه من التاخر فجعل ابو بكر رضي الله تعالي عنه يصلي قاءما كبقية الصحابة ورسول الله صلي الله عليه وسلم يصلي قاعدا انتهي
 وهذا صريح في انه صلي الله عليه وسلم مقتديا بابي بكر رضي الله تعالي عنه وحينءذ لا يحسن التفريع علي ذلك بما جاء في لفظ فكان ابو بكر رضي الله تعالي عنه يصلي وهو قاءم بصلاة النبي صلي الله عليه وسلم وفي لفظ ياتم بصلاة النبي صلي الله عليه وسلم  والناس يصلون بصلاة ابي بكر وفي لفظ يقتدي ابو بكر بصلاة رسول الله صلي الله عليه وسلم والناس يقتدون بصلاة ابي بكر وهذا يدل علي ان الصحابة رضي الله تعالي عنهم صلوا خلف ابي بكر وابو بكر يصلي خلف النبي صلي الله عليه وسلم وصار يسمع الصحابة التكبير وقد بوب البخاري علي ذلك باب من اسمع الناس تكبير الامام وقال بعد ذلك باب الرجل ياتم بالامام وياتم الناس بالماموم فان منعه صلي الله عليه وسلم ابا بكر رضي الله تعالي عنه من التاخر مع صلاته علي يسار ابي بكر او علي يمينه يدل علي ان ابا بكر رضي الله تعالي عنه لم يقتد بالنبي صلي الله عليه وسلم بل استمر اماما اذ لا يجوز عندنا ان يقتد ابو بكر بالنبي صلي الله عليه وسلم قول فقهاءنا ان الصحابة رضي الله تعالي عنهم اقتدوا برسول الله صلي الله عليه وسلم بعد اقتداءهم بابي بكر وجعلوه دليلا علي جواز الصلاة بامامين علي التعاقب اذ لا يحسن ذلك الا ان يكون ابو بكر رضي الله تعالي عنه تاخر ونوي الاقتداء به صلي الله عليه وسلم الا ان يقال يجوز ان تكون صلاته صلي الله عليه وسلم خلف ابي بكر تكررت ففي مرة منعه صلي الله عليه وسلم من التاخر واقتدي به وفي مرة تاخر ابو بكر رضي الله تعالي عنه عن موقفه واقتدي بالنبي صلي الله عليه وسلم واقتدي الناس بالنبي بعد اقتداءهم بابي بكر وصار ابو بكر يسمع الناس التكبير ولا ينافي ذلك قول البخاري للرجل ياتم بالامام وياتم الناس بالماموم لجواز ان يكون المراد يقتدون ويتبعون تكبير الماموم ثم رايت الترمذي رحمه الله تعالي صرح بتعدد صلاته صلي الله عليه وسلم خلف ابي بكر رضي الله تعالي عنه حيث قال ثبت انه صلي الله عليه وسلم صلي الله عليه وسلم خلف ابي بكر مقتديا به في مرضه الذي مات فيه ثلاث مرات ولا ينكر هذا الا جاهل لا علم له بالرواية هذا كلامه
 وبه يرد قول البيهقي رحمه الله والذي دلت عليه الروايات ان النبي صلي الله عليه وسلم صلي الله عليه وسلم خلفه في تلك الايام التي كان يصلي بالناس فيها مرة وصلي ابو بكر رضي الله تعالي عنه خلفه صلي الله عليه وسلم مرة وقال صلي الله عليه وسلم في مرضه ذلك يوما لعبد الله ابن زمعة بن الاسود مر الناس فليصلوا اي صلاة الصبح وكان ابو بكر رضي الله تعالي عنه غاءبا فقدم عبد الله عمر رضي الله تعالي عنه يصلي بالناس فلما سمع رسول الله صلي الله عليه وسلم صوته اخرج راسه الشريف حتي اطلعه للناس من حجرته ثم قال  صلي الله عليه وسلم لا لا لا ثلاث مرات ليصل بهم ابن ابي قحافة فانتفضت الصفوف وانصرف عمر رضي الله تعالي عنه اي من الصلاة فما برح القوم حتي طلع ابن ابي قحافة فتقدم وصلي بالناس الصبح وفي روية انه صلي الله عليه وسلم لما سمع صوت عمر رضي الله تعالي عنه قال اليس هذا صوت عمر فقالوا بلي يا رسول الله فقال يابي ذلك والمءمنون وفي لفظ يابي الله والمسلمون الا ابا بكر قال ذلك ثلاثا قال في السيرة الشامية فبعث صلي الله عليه وسلم الي ابي بكر فجاء بعد ان صلي الله عليه وسلم عمر رضي الله تعالي عنه تلك الصلاة فصلي الناس
 وقد يقال المراد صلي عمر تلك الصلاة ودخل فيها فلا يخالف ما تقدم من انتفاض الصفوف وانصراف عمر رضي الله تعالي عنه من الصلاة وقال عمر رضي الله تعالي عنه لعبد الله بن زمعة ويحك ماذا صنعت يا ابن زمعة والله ما ظننت حين امرتني الا ان رسول الله صلي الله عليه وسلم امرك بهذا فقال عبد الله بن زمعة رضي الله تعالي عنه ما امرني رسول الله صلي الله عليه وسلم بذلك ولكن حيث لم ار ابا بكر ورايتك احق من حضر بالصلاة وفي اخر يوم اخرج رسول الله صلي الله عليه وسلم راسه من الستارة والناس خلف ابي بكر فاراد الناس ان ينحرفوا فاشار اليهم صلي الله عليه وسلم ان امكثوا وتبسم رسول الله صلي الله عليه وسلم لما راي من هيءة المسلمين في صلاتهم سرورا منه صلي الله عليه وسلم بذلك وذلك يوم الاثنين يوم موته صلي الله عليه وسلم ثم القي الستارة
 وفي السيرة الهشامية لما كان يوم الاثنين قبض الله تبارك وتعالي فيه رسول الله صلي الله عليه وسلم وخرج الي الناس وهم يصلون الصبح فرفع الستر وفتح الباب فخرج رسول الله صلي الله عليه وسلم فقام علي باب عاءشة رضي الله تعالي عنها فكاد المسلمون يقتتلون في صلاتهم برسول الله صلي الله عليه وسلم حين راوه فرحا به فاشار اليهم ان اثبتوا علي صلاتكم ثم رجع وانصرف الناس وهم يرون ان رسول الله صلي الله عليه وسلم قد افاق من وجعه فرجع ابو بكر رضي الله تعالي عنه الي اهله بالسنح وفيها في رواية انه لما كان يوم الاثنين خرج رسول الله صلي الله عليه وسلم عاصبا راسه الي صلاة الصبح ابو بكر يصلي بالناس فلما خرج رسول الله صلي الله عليه وسلم فرح الناس فعرف ابو بكر رضي الله تعالي عنه ان الناس لم يصيبوا ذلك الا لرسول الله صلي الله عليه وسلم  فنكص عن مصلاة فدفع رسول الله صلي الله عليه وسلم في ظهره وقال صل بالناس وجلس رسول الله صلي الله عليه وسلم الي جنبه علي يمين ابي بكر رضي الله تعالي عنه فصلي قاعدا فلما فرغ صلي الله عليه وسلم من الصلاة اقبل علي الناس رافعا صوته حتي خرج من باب المسجد يقول ايها الناس سعرت النار واقبلت الفتن كقطع الليل المظلم اني والله ما تمسكون علي بشء اني لم احل القران ولم احرم الا ما حرم القران
 ولما فرغ رسول الله صلي الله عليه وسلم من كلامه قال له ابو بكر رضي الله تعالي عنه يا رسول الله قد اراك اصبحت بنعمة من الله وفضل كما تحب واليوم يوم بنت خارجة افاتيها قال نعم ثم دخل صلي الله عليه وسلم وخرج ابو بكر رضي الله تعالي عنه الي اهله بالسنح فتوفي رسول الله صلي الله عليه وسلم حين اشتد الضحي من ذلك اليوم فليتامل الجمع بين هذه الروايات وقد امر صلي الله عليه وسلم ابا بكر رضي الله تعالي عنه ان يصلي بالناس قبل مرضه فانه صلي الله عليه وسلم خرج الي قباء بعد ان صلي الظهر وقد وقع بين طاءفتين من بني عمرو بن عوف تشاجر حتي تراموا بالحجارة ليصلح بينهم فقال صلي الله عليه وسلم لبلال رضي الله تعالي عنه ان حضرت صلاة العصر ولم اتك فمر ابا بكر فليصل بالناس فلما حضرت صلاة العصر اذن بلال ثم اقام ثم امر ابا بكر رضي الله تعالي عنه فتقدم وصلي بالناس فجاء رسول الله صلي الله عليه وسلم يشق الناس حتي قام خلف ابي بكر فصفح الناس اي صفقوا فلما كثر ذلك التفت ابو بكر رضي الله تعالي عنه فراي رسول الله صلي الله عليه وسلم خلفه فاراد التاخر فاوما اليه صلي الله عليه وسلم ان يكون علي حاله وتقدم رسول الله صلي الله عليه وسلم فصلي بالناس فلما قضي رسول الله صلي الله عليه وسلم صلاته قال يا ابا بكر ما يمنعك اذ اومات اليك ان لا تكون ثبت فقال ابو بكر يا رسول الله لم يكن لابن ابي قحافة ان يءم رسول الله صلي الله عليه وسلم فقال للناس اذا نابكم في صلاتكم شء فلتسبح الرجال ولتصفق النساء
 وهذا استدل به القاضي عياض رحمه الله علي انه لا يجوز لاحد ان يءمه صلي الله عليه وسلم لانه لا يصلح للتقدم بين يديه صلي الله عليه وسلم في الصلاة ولا في غيرها لا لعذر ولا لغيره
 وقد نهي الله المءمنين عن ذلك ولا يكون احد شافعا له صلي الله عليه وسلم وقد  قال صلي الله عليه وسلم اءمتكم شفعاءكم وحينءذ يحتاج للجواب عن صلاته صلي الله عليه وسلم خلف عبدالرحمن بن عوف رضي الله تعالي عنه ركعة وسياتي الجواب عن ذلك ولعل هذه المرة كانت في اليوم الذي توفي فيه صلي الله عليه وسلم
 فقد جاء انه صلي الله عليه وسلم صلي بالناس الغداة وراي المسلمون انه صلي الله عليه وسلم قد برء ففرحوا فرحا شديدا ثم جلس صلي الله عليه وسلم في مصلاه يحدثهم حتي اضحي ثم قام صلي الله عليه وسلم الي بيته فلم يتفرق الناس من مجلسهم حتي سمعوا صياح الناس وهب يقلب الماء ظنا انه غشي عليه وابتدر المسلمون الباب فسبقهم العباس رضي الله تعالي عنه فدخل واغلق الباب دونهم فلم يلبث ان خرج اليهم فنعي رسول الله صلي الله عليه وسلم فقالوا يا عباس ما ادركت منه صلي الله عليه وسلم فقال ادركته وهو يقول جلال ربي الرفيع قد بلغت ثم قضي فكان هذا اخر شء تكلم به رسول الله صلي الله عليه وسلم ثم رايته في الامتاع نقل هذا القول الذي قدمته عن البيهقي
 وذكر في رواية اخري لم يزل ابو بكر رضي الله تعالي عنه يصلي بالناس حتي كانت ليلة الاثنين فاقلع عن رسول الله صلي الله عليه وسلم الوعك واصبح مفيقا فعمد الي صلاة الصبح يتوكا علي الفضل وعلي غلام له يدعي ثوبان ورسول الله صلي الله عليه وسلم بينهما وقد شهد الناس مع ابي بكر رضي الله تعالي عنه ركعة من صلاة الصبح وقام لياتي بالركعة الاخري فجاء اليه رسول الله صلي الله عليه وسلم والناس ينفرجون له حتي قام الي جنب ابي بكر رضي الله تعالي عنه فاستاخر ابو بكر رضي الله تعالي عنه عن رسول الله صلي الله عليه وسلم فاخذ رسول الله صلي الله عليه وسلم بثوبه فقدمه في مصلاه وجلس صلي الله عليه وسلم الركعة الاخيرة ثم انصرف الي جذع من جذوع المسجد فجلس الي ذلك الجذع واجتمع اليه المسلمون يسلمون عليه ويدعون له بالعافية ثم قام صلي الله عليه وسلم فدخل بيت عاءشة ودخل ابو بكر رضي الله تعالي عنه علي عاءشة رضي الله تعالي عنها وقال الحمد لله قد اصبح رسول الله صلي الله عليه وسلم معافي وارجو ان يكون الله عز وجل قد شفاه ثم ركب رضي الله تعالي عنه فلحق باهله بالسنح وانقلبت كل امراة من نساءه صلي الله عليه وسلم الي بيتها فلما دخل صلي الله  عليه وسلم اشتد عليه الوعك فرجع اليه من كان ذهب من نساءه واخذ في الموت فصار يغمي غليه ثم يفيق ويشخص بصره الي السماء فيقول في الرفيق الاعلي الاله وكان عنده صلي الله عليه وسلم وقد اشتد به الامر قدح فيه ماء وفي لفظ بدل قدح علياء وفي لفظ ركوة فيها ماء فلما اشتد عليه صلي الله عليه وسلم الامر صار يدخل يده الشريفة في القدح ثم يمسح وجهه الشريف بالماء ويقول اللهم اني علي سكرات الموت اي غمراته
 وعن فاطمة رضي الله تعالي عنها صار صلي الله عليه وسلم لما يغشاه الكرب وتقول واكرب ابتاه يقول لها رسول الله صلي الله عليه وسلم ليس علي ابيك كرب بعد اليوم
 اقول وجاء انه صلي الله عليه وسلم قال واكرباه وقال لا اله الا الله ان للموت لسكرات اللهم اعني علي سكرات الموت وفي رواية اللهم اعني علي كرب الموت والحكمة في ذلك اي فيما شوهد من شدة ما لقي من الكرب عند الموت تسلية امته صلي الله عليه وسلم اذا وقع لاحد منهم شء من ذلك عند الموت ومن ثم قالت عاءشة رضي الله تعالي عنها لا اكره شدة الموت لاحد ابدا بعد رسول الله صلي الله عليه وسلم وفي رواية لا ازال اغبط المءمن بشدة الموت بعد شدته علي رسول الله صلي الله عليه وسلم وليحصل لمن شاهده من اهله وغيرهم من المسلمين الثواب لما يلحقهم من المشقة عليه كما قبل بمثل ذلك في حكمة ما يشاهد من حال الاطفال عند الموت من الكرب الشديد
 ثم رايت الاستاذ الاعظم الشيخ محمد البكري رحمه الله ونفعنا به سءل عن ذلك فاجاب باجوبة منها هذا الذي ذكره ومنها ان مزاجه الشريف كان اعدل الامزجة فاحساسه صلي الله عليه وسلم بالالم اكثر من غيره
 ومن ثم قال صلي الله عليه وسلم اني لاوعك كما يوعك رجلان منكم ولان تشبت الحياة الانسانية ببدنه الشريف اقوي من تشبثها ببدن غيره لانه اصل الموجودات كلها اي كما تقدم اي وعن عاءشة رضي الله تعالي عنها انها قالت ما رايت الوجع علي احد اشد منه علي رسول الله صلي الله عليه وسلم وقال صلي الله عليه وسلم في مرضه ليس احد اشد بلاء من الانبياء كان النبي من انبياء الله يسلط عليه القمل حتي يقتله وكان النبي صلي الله عليه وسلم ليعري حتي ما يجد ثوبا يواري به عورته الا العباءة يدرعها وان كانوا ليفرحون بالبلاء كما تفرحون بالرخاء  وقال صلي الله عليه وسلم ما يبرح البلاء علي العبد حتي يدعه يمشي علي الارض ليس عليه خطيءه وقال ليس من عبد مسلم يصيبه اذي فما سواه الا حط عنه خطاياه كما تحط الشجرة ورقها وفي لفظ لا يصيب المءمن نكبه من شوكه فما قوقها الا رفع الله له بها درجه وحط عنه بها خطيءه وعن عاءشه رضي الله تعالي عنها ان النبي صلي الله عليه وسلم جعل يشتكي ويتقلب علي فراشه وكان يعوذ بهذه الكلمات اذا اشتكي احد من الناس منه اذهب الباس رب الناس واشف انت الشافي لاشفاء الا شفاءك شفاء لا يغادر سقما فلما ثفل علي رسول الله صلي الله عليه وسلم مرضه الذي مات فيه اخذت بيده اليمني وجعلت امسحه بها فاعوذه بتلك الكلمات فانزع صلي الله عليه وسلم يده الشريفة من يدي وقال الهم اغفر لي واجعلني من الرفيق الاعلي مرتين
 وفي روايه لم يشتك صلي الله عليه وسلم شكوي الا سال الله العافيه حتي مان مرضه الذي مات فيه فانه لم يكن يدعو بالشفاء وطفق صلي الله عليه وسلم يقول يا نفس مالك تلوذين كل ملاذ
 اي وعن عاءشه رضي الله تعالي عنها دحل علي عبد الرحمن بن ابي بكر رضي الله عنهما ومعه سواك يستن به اي من عسيب النحل وكان احب السواك الي رسول الله صلي الله عليه وسلم ضريع الاراك وهو قضيب يلتوي من الاراكه حتي يبلغ التراب فيبقي في ظلها فهو الين من فروعها فنظر اليه رسول الله صلي الله عليه وسلم فعرفت انه يريده لانه كان يحب السواك فقالت له اخذه لك فاشار براسه ان نعم فتناولته فقضمته ثم مضغته وفي روايه فتناولته وناولته اياه فاشتد عليه فقالت الينه لك فاشار براسه ان نعم فلينته فاعطيته رسول الله صلي الله عليه وسلم فاستن به وهو مستند الي صدري وكانت رضي الله تعالي عنها تقول ان من نعم الله علي الرسول الله صلي الله عليه وسلم توفي وهو في بيتي وبين سحري ونحري اي والسحر الرءه وفي رواية بين حاقنتي وذاقنتي وان الله جمع بين ريقي وريقه عند موته وفي روايه فجمع الله بين ريقي وريقه في اخر يوم من الدنيا واول يوم من الاخرة
 وجاء انهم لددوه صلي الله عليه وسلم في هذا المرض اي سقوه لدودا من احدجانبي فمه وجعل يشير اليهم وهو صلي الله عليه وسلم مغمي عليه ان لا يفعلوا به وهم يظنون ان الحامل له علي ذلك كراهه المريض للدواء فلما افاق قال الم انهاكم ان تلدوني  لا يبقي احد في البيت الا لد وانا انظره الا العابس فانه لم يشهدكم وهذا ردعليم فانه قد جاء انهم قالوا له عمك العابس امر بذلك ولم يكن له في ذلك راي انما قالوا ذلك تعللا وخوفا منه صلي الله عليه وسلم قالوا وتخوفنا ان يكون ذات الجنب فان الخاصرة اي وهو عرق في الكلية اذا تحرك وجع صاحبه كانت تاخذ رسول الله صلي الله عليه وسلم فاخذته ذلك اليوم فاغمي عليه حتي ظنوا انه قد هلك فلددوه اي لددته اسماء بنت عميس رضي الله تعالي عنها فلما افاق واراد ان يلدد من في البيت لدد جميع من في البيت حتي ميمونة رضي الله تعالي عنها وكانت صاءمة هذا
 وفي رواية انه لما اشتد عليه صلي الله عليه وسلم المرض دخل عليه عمه العباس رضي الله تعالي عنه وقد اغمي عليه فقال لازواج النبي صلي الله عليه وسلم لو لددتنه قلن انا لا نجترء علي ذلك فاخذ العباس يلدده فافاق رسول الله صلي الله عليه وسلم فقال من لدني فقد اقسمت ليلددن الا ان يكون العباس فانكم لددتموني وانا صاءم قلن فان العباس هو قد لدك وقالت له اسماء بنت عميس رضي الله تعالي عنها انما فعلنا ذلك ظننا ان بك يا رسول الله ذات الجنب فقال لها ان ذلك لداء ما كان الله ليعذبني به وفي رواية انا اكرم علي الله من ان يعذبني بها وفي اخري انها من الشيطان وما كان الله ليسلطها علي
 قال بعضهم وهذا يدل علي انها من سء الاسقام التي استعاذ صلي الله عليه وسلم منها بقوله اللهم اني اعوذ بك من الجنون والجذام وسء الاسقام
 وفي السيرة الهشامية لما اغمي عليه صلي الله عليه وسلم اجتمع عليه نساء من نساءه منهم ام سلمة وميمونة ومن نساء المءمنين منهم اسماء بنت عميس وعنده صلي الله عليه وسلم العباس عمه واجتمعوا علي ان يلددوه فلددوه فلما افاق صلي الله عليه وسلم قال من صنع هذا بي قالوا يا رسول الله عمك فقال عمه العباس رضي الله تعالي عنه حسبنا يا رسول الله ان يكون بك ذات الجنب فقال ان ذلك داء ما كان الله ليعذبني به لا يبقي في البيت احد الا لد الا عمي فلدوا حتي ميمونة وكانت رضي الله تعالي عنها صاءمة عقوبة لهم بما صنعوا
 واعتق رسول الله صلي الله عليه وسلم في مرضه هذه اربعين نفسا وكانت عنده صلي الله عليه وسلم سبعة دنانير او ستة فامر عاءشة رضي الله تعالي عنها ان تتصدق بها بعد ان  وضعها صلي الله عليه وسلم في كفه وقال ما ظن محمد بربه ان لو لقي الله وهذه عنده فتصدقت بها
 وفي رواية امرها بارسالها الي علي كرم الله وجهه ليتصدق بها فبعثت بها اليه فتصدق بها بعد ان وضعها في كفه وقد كان العباس رضي الله تعالي عنه قبل ذلك بيسير راي ان القمر قد رفع من الارض الي السماء فقصها علي النبي صي فقال له هو ابن اخيك
 وجاءه صلي الله عليه وسلم جبريل عليه السلام صحبة ملك الموت وقال له يا احمد ان الله قد اشتاق اليك قال فاقبض يا ملك الموت كما امرت فتوفي رسول الله صلي الله عليه وسلم وفي لفظ اتاه جبريل عليه السلام فقال يا محمد ان الله ارسلني اليك تكريما لك وتشريفا يسالك عما هو اعلم به منك يقول لك كيف تجدك قال اجدني يا جبريل مغموما واجدني يا جبريل مكروبا ثم جاء اليوم الثاني والثالث فقال له ذلك فرد عليه صلي الله عليه وسلم بمثل ذلك وجاء معه في اليوم الثالث ملك الموت فقال له جبريل عليه السلام هذا ملك الموت يستاذن عليك ما استاذن علي احد قبلك ولا يستاذن علي دمي بعدك اتاذن له فدخل فسلم عليه ثم قال يا محمد ان الله ارسلني اليك فان امرتني ان اقبض روحك قبضت وان امرتني ان اترك تركت قال او تفعل قال نعم وبذلك امرت فنظر النبي صلي الله عليه وسلم لجبريل عليه السلام فقال له يا محمد ان الله قد اشتاق الي لقاءك اي وفي رواية اتاه جبريل عليه السلام فقال له يا محمد ان الله يقرءك السلام ورحمة الله ويقول لك ان شءت شفيتك وكفيتك وان شءت توفيتك وغفرت لك قال ذلك الي ربي يصنع بي ما يشاء
 وفي رواية الخلد في الدنيا ثم في الجنة احب اليك ام لقاء ربك ثم الجنة فقال رسول الله صلي الله عليه وسلم لقاء ربي ثم الجنة
 اي وجاء ان جبريل عليه السلام قال هذا اخر وطء بالارض وي لفظ اخر عهدي بالارض بعدك ولن اهبط الي الارض لاحد بعدك قال الحافظ السيوطي رحمه الله هو حديث ضعيف جدا ولو صح لم يكن فيه معارضة اي لما ورد انه ينزل ليلة القدر مع الملاءكة يصلون علي كل قاءم وقاعد يذكر الله لانه يحمل علي انه اخر نزوله بالوحي
 وفيه انه ذكر ان حديث يوحي الله الي عيسي عليه السلام اي بعد قتله الدجال صريح  في انه يوحي اليه بعد النزول والظاهر ان الجاءي اليه عليه السلام بالوحي جبريل عليه السلام بل هو الذي يقطع به ولا يتردد فيه لان ذلك وظيفته لانه السفير بين الله ورسله عليهم الصلاة والسلام فقال رسول الله صلي الله عليه وسلم لملك الموت امض لما امرت به فقبض روحه الشريفة وعند اشتداد الامر به صلي الله عليه وسلم ارسلت عاءشة رضي الله عنها خلف ابي بكر رضي الله تعالي عنه اي لانه كما تقدم لما راي رسول الله صلي الله عليه وسلم مفيقا وقال له رد الله بك علينا عقولنا وقد اصبحت بنعمة من الله وفضل فقال له ابو بكر يا رسول الله اليوم يوم بنت خارجة يعني زوجته وكانت بالسنح قال له اءت اهلك فقام ابو بكر وذهب وارسلت حفصة خلف عمر وارسلت فاطمة خلف علي كرم الله وجهه فلم يجء احد منهم حتي توفي رسول الله صلي الله عليه وسلم وهو في صدر عاءشة وذلك يوم الاثنين حين زاغت الشمس لاثنتي عشرة ليلة خلت من ربيع الاول هكذا ذكر بعضهم
 وقال السهيل لا يصح ان يكون وفاته يوم الاثنين الا في ثالث عشرة او رابع عشرة لاجماع المسلمين علي ان وقفة عرفة كانت يوم الجمعة وهو تاسع ذي الحجة وكان المحرم اما بالجمعة واما بالسبت فان كان السبت فيكون اول صفر اما الاحد او الاثنين فعلي هذا لا يكون الثاني عشر من شهر ربيع الاول بوجه وقال الكلبي انه توفي في الثاني من شهر ربيع الاول قال الطبري وهذا القول وان كان خلاف الجمهور فلا يبعد ان كانت لثلاثة اشهر التي قبلها كلها تسعة وعشرين يوما وفيما قاله نظر لمتابعة انس بن مالك فيما حكاه البيهقي والواقدي
 وقال الخورازمي توفي اول شهر ربيع الاول وفي رواية ان سالم بن عبيد ذهب وراء الصديق الي السنح فاعلمه بموت رسول الله صلي الله عليه وسلم ولا يخالف ما قبله لان يجوز ان يكون ذلك ذهب الي الصديق بعد الرسول الذي ارسلته عاءشة رضي الله عنها قبل موته صلي الله عليه وسلم واخر ما تكلم به عليه الصلاة والسلام الصلاة الصلاة وما ملكت ايمانكم حتي جعل رسول الله صلي الله عليه وسلم يترغرغ بها في صدره ولا يفيض بها لسانه واخر عهد به رسول الله صلي الله عليه وسلم لا يترك بجزيرة العرب دينان وكانت مدة شكواه صلي الله عليه وسلم ثلاث عشرة ليلة وقيل اربع عشرة ليلة وقيل اثنتي عشرة ليلة وقيل عشرا وقيل ثمانية 
 وقالت فاطمة رضي الله عنها لما توفي رسول الله صلي الله عليه وسلم واابتاه اجاب داع دعاه يا ابتاه الفردوس ماواه يا ابتاه الي جبريل ننعاه
 قال ابن كثير رحمه الله وهذا لا يعد نياحة بل هو من ذكر فضاءل الحق عليه عليه افضل الصلاة والسلام قال وانما قلنا ذلك لان رسول الله صلي الله عليه وسلم نهي عن النياحة
 وعن عاءشة رضي الله تعالي عنها انها قالت من سفاهة رايي وحداثه سني اني اخذت وسادة فوسدت بها راسه الشريف من حجري ثم قمت مع النساء ابكي وانتدم والانتدام ضرب الخد باليد عند المصيبة
 وسمعوا قاءلا ولا يرون شخصه يقال انه الخضر عليه السلام اي قال علي كرم الله وجهه اترون من هذا هذا الخضر عليه السلام وفي اسناده متروك يقول السلام عليكم يا اهل البيت ورحمة الله وبركاته @QB@ كل نفس ذاءقة الموت وانما توفون اجوركم يوم القيامة @QE@ ان في الله عزاء من كل مصيبة وخلفا عن كل هالك ودركا من كل فاءت فبالله فثقوا واياه فارجو فان المصاب من حرم الثواب والسلام عليك ورحمة الله وبركاته
 قال ابن كثير رحمه الله هذا الحديث مرسل وفي اسناده ضعف وسجي صلي الله عليه وسلم بثوب حبرة اي بالاضافة برد من برود اليمن ولم اقف علي ان ثيابه صلي الله عليه وسلم التي كانت عليه قبل الموت نزعت عنه ثم سجي الا ان كلام فقهاءنا يشعر بذلك حيث جعلوا ذلك دليلا لنزع ثياب الميت وستره بثوب
 وعند ذلك دهش الناس وطاءت عقولهم واختلفت احوالهم فاما عمر رضي الله تعالي عنه فخبل واما عثمان رضي الله تعالي عنه فاخرس واماعلي كرم الله وجهه فاقعد وجاء ابو بكر وعيناه تهملان فقبل النبي صلي الله عليه وسلم فقال بابي انت وامي طبت حيا وميتا وتكلم كلاما بليغا سكن به نفوس المسلمين وثبت جاشهم
 اي فان عمر رضي الله تعالي عنه صار في ناحية المسجد يقول والله مات رسول الله صلي الله عليه وسلم ولا يموت رسول الله صلي الله عليه وسلم حتي يقطع ايدي ناس من المنافقين كثير وارجلهم وصار رضي الله تعالي عنه يتوعد من قال انه مات بالقتل او القطع
 ونقل عنه رضي الله عنه انه قال ان رجالا من المنافقين يزعمون ان رسول الله صلي الله عليه وسلم مات ولكن ما مات ولكن ذهب الي ربه كما ذهب موسي بن عمران عليه  عليه السلام ثم رجع الي قومه بعد اربعين ليلة بعد ان قيل قد مات والله ليرجعن رسول الله صلي الله عليه وسلم كما رجع موسي بن عمران عليه الصلاة والسلام فليقطعن ايدي رجال وارجلهم ولا زال رضي الله عنه يتوعد المنافقين حتي ازبد شدقاه
 فقام ابو بكر رضي الله عنه وصعد المنبر وقال كلاما بليغا ثم قال ايها الناس من كان يعبد محمدا فان محمدا قد مات @QB@ وما محمد الا رسول قد خلت من قبله الرسل افان مات او قتل انقلبتم علي اعقابكم ومن ينقلب علي عقبيه فلن يضر الله شيءا وسيجزي الله الشاكرين @QE@ فقال عمر رضي الله عنه هذه الاية في القران وفي لفظ فكاني لم اسمع بها في كتاب الله تعالي قبل الان لما نزل ثم قال @QB@ انا لله وانا اليه راجعون @QE@ صلوات الله وسلامه علي رسوله صلي الله عليه وسلم وعند الله نحتسب رسوله قال يعني ابا بكر رضي الله عنه وقال الله تعالي لمحمد صلي الله عليه وسلم @QB@ انك ميت وانهم ميتون @QE@ وقال تعالي @QB@ كل شء هالك الا وجهه له الحكم واليه ترجعون @QE@ وقال تعالي @QB@ كل من عليها فان ويبقي وجه ربك ذو الجلال والاكرام @QE@ وقال تعالي @QB@ كل نفس ذاءقة الموت وانما توفون اجوركم يوم القيامة @QE@ فلما بويع ابو بكر رضي الله عنه بالخلافة كما سياتي اقبلوا علي جهاز رسول الله صلي الله عليه وسلم واختلفوا هل يغسل في ثيابه او يجرد منها كما تجرد الموتي فالقي الله عليهم النوم وسمعوا من ناحية البيت قاءلا يقول لا تغسلوه فانه كان طاهرا فقال اهل البيت صدق فلا تغسلوه فقال العباس رضي الله عنه لا ندع سنة لصوت لا ندري ما هو فغشيهم النعاس ثانية فناداهم ان غسلوه وعليه ثيابه اي وزاد في رواية فان ذلك ابليس وانا الخضر وفي رواية لا تنزعوا عن رسول الله صلي الله عليه وسلم قميصه قال الذهبي حديث منكر فقاموا الي رسول الله صلي الله عليه وسلم فغسلوه وعليه قميصه وفي لفظ وعليه قميص ومحول مفتوح يصبون عليه الماء ويدلكونه والقميص دون ايديهم علي والعباس وكذا ولدا العباس الفضل وقثم فكان العباس وابناه الفضل وقثم يقلبونه مع علي وفي لفظ غسله علي والفضل محتضنه والعباس يصب الماء وجعل الفضل رضي الله عنه يقول ارحني قطعت وتيني واسامة وشقران مولاه وفي لفظ وصالح مولاه صلي الله عليه وسلم يصبان الماء ولف علي كرم الله وجهه علي يده خرقة وادخلها تحت القميص يغسل بها جسده الشريف
 وعن علي كرم الله وجهه ذهبت التمس منه ما يلتمس من الميت اي ما يخرج من بطن  الميت فلم ار شيءا فكان صلي الله عليه وسلم طيبا حيا وميتا وما تناولت منه صلي الله عليه وسلم عضوا الا كانما يقلبه معي ثلاثون رجلا اي ويحتاج الي الجمع بين هذا وما تقدم عن الفضل رضي الله عنه
 قيل وتغسيل علي كرم الله وجهه له صلي الله عليه وسلم كان بوصية منه صلي الله عليه وسلم له فعن علي كرم الله وجهه ان رسول الله صلي الله عليه وسلم اوصي ان لا يغسله احد غيري وقال لا يري احد عورتي الا طمست عيناه غيرك اي علي فرض وقوع ذلك فلا ينافي ما تقدم وادعي الذهبي ان هذا الحديث منكر وفي رواية فكان الفضل واسامة رضي الله عنهما يناولان الماء من وراء الستر واعينهما معصوبة وفي لفظ كان العباس واسامة يناولان الماء من وراء الستر لان العباس رضي الله عنه نصب علي رسول الله صلي الله عليه وسلم كلة اي خيمة رفيعة من ثياب يمانية في جوف البيت وادخل عليها فيها زاد بعضهم والفضل وابا سفيان بن الحارث ابن عمه صلي الله عليه وسلم
 ونصب الكلة دليل لقول فقهاءنا رحمه الله والاكمل وضع الميت عند الغسل بموضع خال من الناس مستور عنهم لا يدخله الا الغاسل ومن يعينه والذي رواه ابن ماجه رحمه الله انه تولي غسله صلي الله عليه وسلم علي والفضل واسامة بن زيد يناول الماء والعباس واقف اي لا يغسل ولا يناول الماء اي ويحتاج للجمع بين هذه الروايات
 وقيل ان العباس لم يشاهد غسله صلي الله عليه وسلم وعن علي رضي الله عنه لما غسلت النبي صلي الله عليه وسلم اجتمع ماء في حقوبه فرفعته بلساني وازدردته فاورثني ذلك قوة حفظي
 ويروي انه كرم الله وجهه راي في عينه صلي الله عليه وسلم قذاة فادخل لسانه فاخرجها منها
 وعن عاءشة رضي الله عنها لو استقبلت من امري ما استدبرت ما غسل رسول الله صلي الله عليه وسلم الا نساءه اي لو ظهر لها قولها المذكور وقت غسله صلي الله عليه وسلم ما غسله صلي الله عليه وسلم الا نساءه وغسل ثلاث غسلام واحدة بالماء القراح وواحدة بالماء والسدر اي والغسلة التي كانت بالماء القراح كانت قبل الغسلة التي بالسدر فهي المزيلة وواحدة بالماء مع الكافور اي وهذه هي المجزءة في الغسل هذا
 وفي كلام سبط ابن الجوزي رحمه الله وغسل صلي الله عليه وسلم في المرة الاولي بالماء القراح وفي الثانية بالماء والسدر وفي الثالثة بالماء والكافور 
 وفي لفظ فغسلوه بالماء القراح وطيبوه بالكافور في مواضع سجوده ومفاصله وغسل من ماء بءر غرس وهي بءر بقباء قال صلي الله عليه وسلم نعم البءر بءر غرس هي من غيون الجنة وماءها اطيب الماء وكان صلي الله عليه وسلم يشرب منها ويءتي له بالماء منها
 وعند ابن ماجه رحمه الله انه صلي الله عليه وسلم قال لعلي كرم الله وجهه اذا انامت فاغسلني بسبع قرب من بءري بءر غرس
 وكفن صلي الله عليه وسلم بثلاثة اثواب سحوليه اي بيض من القطن من عمل سحولة قرية من قري اليمن وفي رواية الشيخين عنها كفن رسول الله صلي الله عليه وسلم في ثلاثة اثواب بيض يمانية ليس فيها قميص ولا عمامة قيل ازار ورداء ولفافة وقوله ليس فيها قميص ولا عمامة اي لم يكن في كفنه صلي الله عليه وسلم ذلك كما فسر بذلك امامنا الشافعي رحمه الله وجمهور العلماء قال بعضهم وهو الصواب الذي يقتضيه ظاهر الحديث
 وما قيل ان معناه ان القميص والعمامة زاءدان علي الاثواب الثلاثة ليس في محله لانه لم يثبت انه صلي الله عليه وسلم كفن في قميص وعمامة وهذا يدل علي انه نزع عنه صلي الله عليه وسلم القميص الذي غسل فيه قبل تكفينه في الاثواب الثلاثة
 وقيل كفن في ذلك الثوب بعد عصره وفيه انه لا يخلو عن الرطوبة وهي تفسد الاكفان ويءيد كونه صلي الله عليه وسلم كفن في ذلك الثوب ما جاء في رواية كفن صلي الله عليه وسلم في ثوبه الذي مات فيه وحله نجرانية والحلة ثوب فوق ثوب قال ابن كثير وهذا غريب جدا وفي كلام بعضهم انه حديث ضعيف لا يصح الاحتجاج به
 وفي رواية انه صلي الله عليه وسلم كفن في الاثواب الثلاثة المتقدمة وزيادة برد حبرة احمر
 وعن عاءشة رضي الله عنها انها قالت اتي بالبرد ولفوه فيه ولكنهم ردوه اي ثم نزع عنه صلي الله عليه وسلم ولم يكفنوه فيه وفي رواية ثوبين وبرد احمر وهذا يخالف ما عليه اءمتنا ان من كفن في ثلاثة اثواب يجب ان تكون لفاءف يستر كل منها جميع البدن وفي رواية كفن في سبعة اثواب
 وبعد تكفينه صلي الله عليه وسلم وذلك يوم الثلاثاء وضع علي السرير وفي لفظ ثم  ادرج صلي الله عليه وسلم في اكفانه وجمروه عودا وندا ثم احتملوه حتي وضعوه علي سرير وسجوه
 وذكر انه كان عند علي كرم الله وجهه مسك وقال انه من فضل حنوط رسول الله صلي الله عليه وسلم
 وصلي عليه صلي الله عليه وسلم الناس افذاذا لم يءمهم احد وفي لفظ لما ادرج صلي الله عليه وسلم في اكفانه وضع علي سريره ثم وضع علي شفير حفرته ثم صار الناس يدخلون عليه رفقاء رفقاء لا يءمهم احد
 وذكر انه دخل عليه صلي الله عليه وسلم ابو بكر وعمر معهما نفر من المهاجرين والانصار بقدر ما يسع البيت فقالا السلام عليك ايها النبي ورحمة الله وبركاته وسلم المهاجرون والانصار كما سلم ابو بكر وعمر رضي الله عنهم ثم صفوا صفوفا لا يءمهم احد اللهم انا نشهد انه صلي الله عليه وسلم قد بلغ ما انزل اليه ونصح لامته وجاهد في سبيل الله حتي اعز الله دينه وتمت كلمته فاجعلنا الهنا ممن تبع القول الذي انزل معه واجمع بيننا وبينه حتي تعرفه بنا وتعرفنا به فانه كان بالمءمنين رءوفا رحيما لا نبتغي بالايمان به بدلا ولا نشتري به ثمنا ابدا فيقول الناس امين امين وهذا يدل علي انه المراد بالصلاة عليه صلي الله عليه وسلم الدعاء لا الصلاة علي الجنازة المعروفة عندهم والصحيح ان هذا الدعاء كان ضمن الصلاة المعروفة التي باربع تكبيرات
 فقد جاء ان ابا بكر رضي الله عنه دخل عليه صلي الله عليه وسلم فكبر اربع تكبيرات ثم دخل عمر رضي الله عنه فكبر اربعا ثم دخل عثمان رضي الله عنه فكبر اربعا ثم طلحة ابن عبيد الله والزبير بن العوام رضي الله عنهما ثم تتابع الناس ارسالا يكبرون عليه اي وعلي هذا انما خصوا الدعاء بالذكر لانه الذي يليق به صلي الله عليه وسلم ومن ثم استشاروا كيف يدعون له فاشير بمثل ذلك
 قال وقال ابن كثير رحمه الله وهذا الامر اي صلاتهم عليه صلي الله عليه وسلم فرادي من غير امام يءمهم مجمع عليه ولا يقال لان المسلمين لم يكن لهم حينءذ امام لانهم لم يشرعوا في تجهيزه عليه الصلاة والسلام الا بعد تمام البيعة لابي بكر رضي الله عنه لانه لما تحقق موته صلي الله عليه وسلم واجتمع غالب المهاجرين علي ابي بكر وعمر وانضم اليهم  من الانصار اسيد بن حضير في بني عبد الاشهل ومن معه من الاوس وتخلف علي والزبير اي ومن كان معهما المهاجرين كالعباس وطلحة بن عبيد الله والمقداد وجمع من بني هاشم في بيت فاطمة رضي الله تعالي عنها وتخلف الانصار باجمعهم واجتمعوا في سقيفة بني ساعدة اي وفي دار سعد بن عبادة وكان سعد مريضا مزملا بثيابه بينهم اي اجتمعوا اولا ثم تفرق عنهم اسيد بن حضير رضي الله عنه ومن معه من الاوس
 فلا يخالف ذلك ما تقدم من انضمام اسيد بن حضير رضي الله عنه ومن معه من المهاجرين رضي الله عنهم مع ابي بكر رضي الله عنه ولا يخالف ذلك ما في بعض الروايات عن عمر رضي الله عنه وتخلف الانصار عنا باجمعهم في سقيفة بني ساعدة
 واجتمع المهاجرون الي ابي بكر رضي الله عنه الا عليا والزبير ومن معهما تخلفوا في بيت فاطمة رضي الله عنها فقال عمر رضي الله عنه لابي بكر رضي الله عنه انطلق بنا الي اخواننا من الانصار اي فانه اتاهم ات فقال ان هذا الحي من الانصار مع سعد بن عبادة رضي الله عنه في سقيفة بني ساعدة قد انحازوا اليه فان كان لكم بامر الناس حاجة فادركوا الناس قبل ان يتفاقم امرهم
 اي فعن عمر رضي الله عنه بينا نحن في بيت رسول الله صلي الله عليه وسلم اذا رجل ينادي من وراء الجدران اخرج الي يا ابن الخطاب فقلت اليك عني فانا عنك متشاغل يعني بامر رسول الله صلي الله عليه وسلم فقال انه قد حدث امر ان الانصار قد اجتمعوا في سقيفة بني ساعدة فادركهم قبل ان يحدثوا امرا يكون فيه حرب
 قال فانطلقنا نءمهم اي نقصدهم حتي راينا رجلين صالحين اي وهما عويمر بن ساعدة ومعدة بن عدي وهما من الاوس قالا اين تريدون فقلت نريد اخواننا من الانصار فقالا لا عليكم ان تقربوهم واقضوا امركم يا معشر المهاجرين بينكم فقلت والله لناتينهم فنطلقنا حتي جءناهم في سقيفة بني ساعدة فاذا هم مجتمعون واذا بين اظهرهم رجل مزمل فقلت من هذا قالوا سعد بن عبادة فقلت ما له قالوا انه وجع فلما جلسنا قام خطيبهم فاثني علي الله بما هو اهله ثم قال اما بعد فنحن انصار الله وكتيبة الاسلام وانتم يا معشر المهاجرين رهط منا وقد ذفت ذافة منكم اي دب قوم الاستعلاء والترفع علينا تريدون ان تختزلونا من اهلنا اي تنحونا عنه تستبدون به دوننا فلما سكت اردت ان اتكلم وقد كنت زورت مقالة اعجبتني اردت ان قولها بين يدي ابي بكر  فقال ابو بكر رضي الله تعالي عنه علي رسلك يا عمر فكرهت ان اغضبه وكنت اري منه بعض الحده فسكت وكان اعلم مني والله ما ترك من كلمه اعجبتني في تزويري الا قالها في بديهته وافضل فقال اما بعد فما ذكرتم من خيرفانتم له اهل ولم تعرف العرب هذا الامر الا لهذا الحي من قريش هم اوسط العرب نسبا ودارا يعني مكه ولدتنا العرب كلها فليست منها قبيله الا لقريش منها ولاده ودار وكلنا معاشر المهاجرين اول الناس اسلاما ونحن عشيرته صلي الله عليه وسلم واقاربه وذوو رحمه فنحن اهل النبوه ونحن اهل الخلافه ولم يترك شيءا انزل في الكتاب بايدتهم الا قاله ولا شيءا قاله رسول الله صلي الله عليه وسلم في شان الانصار الا ذكره ومنه لو سلكت الناس واديا وسلكت الانصار واديا لسلكت وادي الانصار وقال لقد علمت يا سعد ان رسول الله صلي الله عليه وسلم قال وانت قاعد قريش ولاة هذا الامر فقال سعد رضي الله تعالي عنه صدقت فقال اي الصديق رضي الله عنه نحن الامراء وانتم الوزراء اي وفي الروايه انه اي الصديق رضي الله عنه قال لهم انتم الذين امنوا ونحن الصادقون وانما امركم الله ان تكونوا معنا فقال تعالي @QB@ يا ايها الذين امنوا اتقوا الله وكونوا مع الصادقين @QE@ والصادقون هم المهاجرون قال الله تعالي @QB@ للفقراء المهاجرين @QE@ الي قوله @QB@ اولءك هم الصادقون @QE@
 وفي روايه ان ابا بكر رضي الله عنه احتج علي الانصار بخبر الاءمه من قريش وهو حديث صحيح ورد نحو اربعين صحابيا وانتم يا معشر الانصار اخواننا في كتاب الله وشركاءنا في الدين وانتم احق بالرضا بقضاء الله وقد رضيت لكم احد هذين الرجلين ايهما شءت واخذ بيدي ويد ابي عبيده بن الجراح فلم اكره ما قال غيرها وكان والله ان اقدم فتضرب عنقي ولا يقربني ذلك من اثم احب الي من اتامر علي قوم فيهم ابو بكر فقال كل من عمر وابي عبيده لا بنبغي لاحد ان يكون فوقك يا ابا بكر اي وفي لفظ بل نبايعك وانت سيدنا وخيرنا واحبنا الي رسول الله صلي الله عليه وسلم وهذا من عمر رضي الله عنه كان بعد ان اتي ابا عبيده وقال انك امين هذه الامه علي لسان رسول الله صلي الله عليه وسلم فقال ما رايت بك ضعف راي قبلها ممذ اسلمت اما بقي فيكم الصديق وثاني اثنين وفي روايه ان ابا بكر رضي الله عنه قال لعمر ابسط يدك لابايعك فقال له انت افضل مني فاجابه بانت اقوي مني ثم كرر ذلك فقال له فاين قوتي مع فضلك
 واعترض قول ابي بكر المذكور بانه كيف يقول ذلك مع علمه بانه احق بالخلافه وكيف يقدم ابا عبيده علي عمر مع انه افضل منه  واجيب بانه رضي الله الله عنه قال ذلك لانه استحي ان يقول رضيت لكم نفسي مع علمه بان كلا من عمر وابي عبيده لا يقبل وان ابا بكر رضي الله عنه كان يري جواز توليه المفضول علي من هو افضل منه وهو الحق عند اهل السنه لانه قد يكون اقدر من الافضل علي القيام بمصالح الدين واعرف بتدبير الامر وما فيه انتظام حال الرعيه
 وعند قول ابي بكر رضي الله عنه ما ذكر قال قاءل من الانصار اي وهو الحباب بحاء مهمله مضمومه فموحدة رضي الله عنه ابن المنذر انا جذيلها المحك وعذيقها المرجب بالجيم والجذبل تصغير الجذل وهو عود ينصب للابل الجرباء فتحتك به ليزول جربها والمحك الذي كثر به الاحتكاك حتي صار املس والعذيق تصغير العذق بفتح العين وهو النخله والمرجب المسند بالرجيه وهي خشبه ذات شعبتين يستند بها النخله اذا كثر حملها اي اناذ والراي والتدبير الذي يستشفي به في الحوادث لاسيما هذه الحادثه منا امير ومنكم امير يا معشر قريش وتتابعت خطباءهم علي ذلك وقالوا ان رسول الله صلي الله عليه وسلم كان اذا استعمل الرجل منكم قرن معه رجلا منا فنري ان يلي هذا الامر رجلان منا ومنكم فقام زيد بن ثابت رضي الله عنه وقال للانصار اتعلمون ان رسول الله صلي الله عليه وسلم كان من المهاجرين وكنا نحن انصاره فنحن انصاره خليفته كما كنا انصاره ثم اخذ بيد ابي بكر رضي الله عنه وقال هذا صاحبكم فقال الحباب بن المنذر رضي الله عنه يا معشر الانصار لا تسمعوا مقالة هذا فتذهب قريش بنصيبكم من هذا الامر فان ابو اعليكم فاجلوهم من بلادكم فانتم احق به منهم اما والله وان شءتم لنقيمها جذعة فقال له عمر رضي الله عنه اذن يقتلك الله فقال بل اراك تقتل فقام بشير بن سعد ابو النعمان بن بشير رضي الله تعالي عنهما فقال يا معيشر الانصر انا كنا اول من سبق الي هذا الدين وجهاد المشركين ما قدصنا الا رضا الله ورسوله فلا ينبغي لنا ان نستطيل علي الناس ولا نطلب عرض الدنيا وان قريشا اولي بهذا الامر فلا ننازعهم فقال له الحباب الفيت علي ابن عمك يعني سعد بن عبادة فقال لا والله ولكني كرهت ان انازع قوما حقا جعله الله لهم وفي رواية قال عمر رضي الله عنه يا معشر الانصار الستم تعلمون ان رسول الله صلي الله عليه وسلم قد امر ابا بكر يءم الناس وايكم تطيب نفسه ان يتقدم ابا بكر وفي لفظ ان يقيمه عن مقامة الذي اقامه فيه رسول الله صلي الله عليه وسلم فقالت الانصار نعوذ بالله ان نتقدم ابا بكر رضي الله عنه وفي لفظ قالوا نستغفر الله لا تطيب انفسنا ولعل المراد قال معظمهم 
 فلا يخالف ذلك ما جاء عن عمر رضي الله تعالي عنه ولما كثر اللغط وعلت الاصوات حتي خشيت الاختلاف وقلت سيفان في غمد واحد لا يكونان وفي رواية هيهات لا يجتمع فحلان في مغرس فقلت ابسط يدك يا ابا بكر وكذا قال له من الانصر زيد بن ثابت واسيد بن حضير وبشير بن سعد رضي الله عنهم فبسط يده فبايعته وبايعه المهاجرون ثم بايعه الانصار اي حتي سعد بن عبادة رضي الله عنه خلافا لمن قال ان سعد ابن عبادة ابي ان يبايع ابا بكر حتي لقي الله اي فانه رضي الله تعالي عنه توجه الي الشام ومات بها
 قال الحافظ ابن حجر رحمه الله والعذر له في ذلك انه رضي الله عنه تاول ان للانصار في الخلافة استحقاقا فبني علي ذلك وهو معذور وان لم يكن ما اعتقده من ذلك حقا هذا كلامه
 ولا ينافيه ما جاء عن عمر رضي الله عنه وثبنا علي سعد بن عبادة فقال قاءل منهم قتلتم سعد بن عبادة اي فعلتم معه من الاعراض والاذلال ما يقتله فقلت قتل الله سعبد بن عبادة فانه صاحب فتنة نعم ينافيه ما حكاه ابن عبد البر ان سعد بن عبادة رضي الله عنه ابي ان يبايع ابا بكر حتي لقي الله
 قال بعضهم ويضعفه ما جاء في بعض الروايات ان ابا بكر رضي الله عنه لما قال لسعد لقد علمت يا سعد ان رسول الله صلي الله عليه وسلم قال وانت قاعد قريش ولاة هذا الامر قال له سعد صدقت نحن الوزراء وانتم الامراء وبه يظهر التوقف فيما تقدم عن ابن حجر رحمه الله هذا
 وفي كلام سبط ابن الجوزي رحمه الله فانكروا علي سعد امره وكادوا يطءون سعدا فقال ناس من اصحابه اتقوا سعدا لا تطءوه فقال عمر رضي الله عنه اقتلوا سعدا قتله الله ثم قام عمر رضي الله عنه علي راس سعد وقال قد هممت ان اطاك حتي تندر عيونك فاخذ قيس بن سعد رضي الله عنهما بلحية عمر رضي الله عنه وقال والله لو خفضت منه شعرة ما رجعت وفيك جارجة فقال ابو بكر مهلا يا عمر الرفق الرفق ما هنا ابلغ فقال سعد اما والله لو كان لي قوة علي النهوض لالحقتك بقوم كنت فيهم تابعا غير متبوع فلما عاد ابو بكر وعمر رضي الله عنهما الي محلهما ارسلا له بايع فقد بايع الناس فقال لا والله حتي ارميكم بما في كنانتي من نبل واخضب من دماءكم  سنان رمحي واضربكم بسيفي ما ملكته يداي والله لو اجتمع لكم الجن والانس لما بايعتكم فلما عاد الرسول واخبرهم بما قالب قال له عمر لا ندعه حتي يبايع فقال له قيس بن سعد دعه فقد لح فاتركوه وكان سعد رضي الله عنه لا يحضر معهم ولا يصلي في المسجد ولا يسلم علي من لقي منهم فلم يزل مجانبا لهم حتي اذا كان بعرفة يقف ناحية عنهم فلما ولي عمر رضي الله عنه الخلافة لقيه في بعض طرق المدينة فقال له ايه يا سعد فقال له ايه يا عمر فقال له عمر انت صاحب المقالة قال نعم انا ذاك وقد افضي الله اليك هذا الامر كان والله صاحبك خيرا لنا واحب الينا من جوارك وقد اصبحت كارها لجوارك فقال له عمر رضي الله عنه انه من كره جوار جاره تحول عنه فقال له سعد اني متحول الي جوار من هو خير من جوارك فخرج رضي الله عنه الي الشام واستمر بها الي ان مات في السنة ا لخامسة عشر من الهجرة
 وذكر الطبري رحمه الله ان سعدا رضي الله عنه بايع مكرها وهو وهم هذا كلام سبط ابن الجوزي رحمه الله
 قال عمر رضي الله عنه وانما بايعت ابا بكر خشية ان فارقنا القوم ولم تكن بيعة ان يحدثوا بعدنا بيعة فاما ان نبايعهم علي مالا نرضي واما ان نخالفهم فيكون فيه فساد وذلك كان في يوم موته صلي الله عليه وسلم الذي هو يوم الاثنين فلما كان الغد كانت البيعة العامة صعد ابو بكر رضي الله عنه المنبر وقام عمر رضي الله عنه بين يدي ابي بكر فحمد الله واثني عليه ثم قا ان الله قد جمع امركم علي خيركم صاحب رسول الله صلي الله عليه وسلم وثاني اثنين اذ هما بالغار فقوموا فبايعوه فبايعوه فبايع الناس ابا بكر رضي الله عنه بيعة عامة بعد بيعة السقيفة ثم تكلم ابو بكر رضي الله عنه فقال في خطبته بعد ان حمد الله واثني عليه ايها الناس اني قد وليت عليكم ولست بخيركم فان احسنت فاعينوني وان اسات فقوموني الصدق امانة والكذب خيانة والضعيف فيكم قوي حتي ارتج عليه حقه ان شاء الله والقوي فيكم ضعيف حتي اخذ الحق منه ان شاء اللله لا يدع قوم الجهاد في سبيل الله الا ضربهم الله بالذل ولا اشيعت الفاحشة في قوم قط الا عمهم الله بالبلاء اطعيوني ما اطعت الله ورسولنه فاذا عصيت الله ورسوله فلا طاعة لي عليكم فقوموا الي صلاتكم رحمكم الله
 وشن الغارة بعض الرافضة علي قول الصديق رضي الله عنه فقوموني بانه كيف  تجوز امامة من يستعين بالرعية علي تقويمه مع ان الرعية تحتاج اليه ورد بان هذا من اكبر الدلاءل علي فضله لقوله الاخر اطعيوني ما اطعت الله فان عصيته فلا طاعة لي عليكم لان كل احد ما عدا الانبياء عليهم الصلاة والسلام تجوز عليه المعصية
 ولما بويع بالخلافة اصبح رضي الله تعالي عنه علي ساعدة قماش وهو ذاهب به الي السوق فقال له عمر اين تريد قال السوق قال تصنع هذا وقد وليت امر المسلمين قال فمن اين اطعم عيالي فقال انطلق يفرض لك ابو عبيدة فانطلقا اليه فقال افرض لك قوت رجل من المهاجرين ليس بافضلهم اي في سعة النفقة ولا باوكسهم وكسوة الشتاء والصيف واذا ابليت شيءا رددته واخذت غيره ففرض له كل يوم نصف شاة وفي رواية جعل له الفين فقال زيدوني فان لي عيالا وقد شغلت عن السفارة فزادوه خمسماءة
 وهو رضي الله تعالي عنه اول من جمع القران وسماه مصحفا واتخذ بيت المال وسها من جعل ذلك من اوليات عمر رضي الله تعالي عنه
 ولما اختلف علي والزبير ومن معهما كالعباس وطلحة بن عبيد الله والمقداد وجمع من بني هاشم في بيت فاطمة كما تقدم عن المبايعة استمروا علي ذلك مدة لانهم رضي الله عنهما وجدوا في انفسهم حيث لم يكونوا في المشورة اي في سقيفة بني ساعدة مع ان لهم فيها حقا وقد اشار سيدنا عمر رضي الله عنه الي ان بيعة ابي بكر رضي الله تعالي عنه كانت فلتة اي بغته لا عن استعداد لها ولكن وقي الله شرها اي لم يقع فيها مخالفة ولا منازعة ولذلك لما اجتمعوا اي علي والزبير والعباس وطلحة بن عبيد الله ومن تخلف عن المبايعة منهم بابي بكر رضي الله عنه قام خطيبا وقال والله ما كنت حريصا علي الامارة يوما ولا ليلة قط ولا كنت راغبا فيها ولا سالتها الله في سر ولا علانية ولكن اشفقت من الفتنة اي لو اخرت الي اجتماعكم
 وقد روي ان شخصا قال لابي بكر رضي الله عنه ما حملك علي ان تلي امر الناس وقد نهيتني ان اتامر علي اثنين فقال لم اجد من ذلك بدا خشيت علي امة محمد صلي الله عليه وسلم الفرقة وقال ما في الامارة من راحة لقد قلدت امرا عظيما ما لي به من طاقة فقال علي والزبير رضي الله تعالي عنهما ما غضبنا الا لانا اخرنا عن المشورة وانا نري ابا بكر احق الناس بها انه لصاحب الغار وانا لنعرف شرفه وخيره ولذا امره  رسول الله صلي الله عليه وسلم بالصلاة من بين الناس وهو حي فلم يكن تاخرهم رضي الله تعالي عنهم للقدح في خلافة ابي بكر رضي الله تعالي عنه لانهم لم يجدوا تحت اديم السماء خيرا من ابي بكر فولوه رقابهم اي فالامة اجمعت علي حقية امامة ابي بكر رضي الله تعالي عنه وهذا اي اجتماع علي كرم الله وجهه بابي بكر رضي الله تعالي عنهما كان بعد ما ارسل اليه علي كرم الله وجهه في الاجتماع به واجتمع به كما سياتي لكن سياتي ان ذلك كان بعد موت فاطمة بنت النبي صلي الله عليه وسلم ورضي عنها وسياق غير واحد يدل علي ان اجتماع علي والزبير ومبايعتهما ابا بكر رضي الله تعالي عنه كان قبل موت فاطمة رضي الله تعالي عنها وهو ما صححه ابن حبان وغيره ويءيده ما حكاه بعضهم ان الصديق رضي الله تعالي عنه خرج يوم الجمعة فقال اجمعوا لي المهاجرين والانصار فاجتمعوا ثم ارسل الي علي بن ابي طالب كرم الله وجهه والنفر الذين كانوا تخلفوا معه فقال له ما خلفك يا علي عن امر الناس فقال خلفني عظيم المعتبة ورايتكم استقليتم برايكم فاعتذر اليه ابو بكر رضي الله تعالي عنه بخوف الفتنة لو اخر ثم اشرف علي الناس وقال ايها الناس هذا علي بن ابي طالب لا بيعة لي في عنقه وهو بالخيار من امره الا وانتم بالخيار جميعا في بيعتكم فان رايتم لها غيري فانا اول من يبايعه فلما سمع ذلك علي كرم الله وجهه زال ما كان داخله فقال اجل لا نري لها غيرك امدد يدك فبايعه هو والنفر الذين كانوا معه فان هذا دليل علي ان عليا كرم الله وجهه بايع ابا بكر بعد وفاة رسول الله صلي الله عليه وسلم بثلاثة ايام
 وفي كلام المسعودي لم يبايع ابا بكر احد من بني هاشم حتي ماتت فاطمة رضي الله تعالي عنها وقال رجل للزهري لم يبياع علي كرم الله وجهه ابا بكر ستة اشهر فقال لا والله لا احد من بني هاشم بايعه علي كرم الله وجهه فليتامل الجمع علي تقدير الصحة
 وقد جمع بعضهم بان عليا كرم الله وجهه بايع اولا ثم انقطع عن ابي بكر لما وقع بينه وبين فاطمة ما وقع
 اي ويدل لهذا الجمع ان في رواية ان ابا بكر رضي الله تعالي عنه لما صعد المنبر ونظر في وجوه القوم فلم ير الزبير رضي الله تعالي عنه فدعا به فجاء فقال قلت ابن عمة رسول الله حواريه اردت ان تشق عصا المسلمين فقال لا تثريب يا خليفة رسول الله  فقام فبايعه ثم نظر في وجو القوم فلم ير عليا كرم اللله وجهه فدعا به فجاء فقال قلت ابن عم رسول الله صلي الله عليه وسلم وختنه علي ابنته اردت ان تشق عصا المسلمين فقال لا تثريب ياخليفة رسول الله صلي الله عليه وسلم فقام فبايعه
 ويبعد هذا الجمع ما في البخاري عن عاءشة رضي الله تعالي عنها فلما توفيت فاطمة رضي الله عنها التمس اي علي كرم الله وجهه مصالحة ابي بكر رضي الله تعالي عنه ولم يكن بايع تلك الاشهر فارسل الي ابي بكر الحديث
 والسبب الذي اقتضي الوقوع بين فاطمة وابي بكر رضي الله تعالي عنهما ان فاطمة رضي الله تعالي عنها جاءت الي ابي بكر تطلب ارثها مما اعطاه الانصار له صلي الله عليه وسلم من ارضهم وما اوصي به اليه صلي الله عليه وسلم وهو وصية مخيريق عند اسلامه وهي سبعة حواءط في بني النضير قال سبط ابن الجوزي وهو اول وقف كان في الاسلام ومما افاء الله علي رسوله صلي الله عليه وسلم من ارض بني النضير وفدك ونصيبه صلي الله عليه وسلم من خيبر وهما حصنان من حصونها الوطيح وسلالم فانه صلي الله عليه وسلم اخذهما صلحا كما تقدم وحصته صلي الله عليه وسلم مما افتتح منها عنوة وهو الخمس فان ذلك كله كان للنبي صلي الله عليه وسلم خاصة فكان صلي الله عليه وسلم ينفق من ذلك علي اهل بيته سنة ومابقي جعله في الكراع اي الخيل والسلاح في سبيل الله فربما احتاج صلي الله عليه وسلم الي شء ينفقه قبل فراغ السنة فيقترض ولهذا توفي رسول الله صلي الله عليه وسلم ودرعه مرهونة عند اليهودي علي اصع من شعير وافتكها ابو بكر وتلك الدرع كانت ذات الفضول التي اهداها له صلي الله عليه وسلم سعد بن عبادة لما توجه الي بدر كما تقدم ولم يشبع هو ولا اهل بيته ثلاثة ايام تباعا اي متتابعة كما تقدم فقال لها ابو بكر رضي الله تعالي عنه لست بالذي اقسم من ذلك شيءا ولست تاركا شيءا كان رسول الله صلي الله عليه وسلم يعمل به فيها الا عملته واني اخشي ان تركت امره او شيءا من امره ان ازيغ وفي رواية قال لها قد سمعت رسول الله صلي الله عليه وسلم يقول انما هي طعمة اطعمينها الله فاذا مت عادت علي المسلمين فان اتهمتيني فسلي المسلمين يخبرونك بذلك وقال لها قد قال رسول الله صلي الله عليه وسلم لا نورث ما تركناه صدقة ولكن اعول من كان رسول الله صلي الله عليه وسلم يعوله وانفق علي من كان ينفق عليه وقوله صدقة هو بالرفع كما هو الرواية اي الذي تركناه فهو صدقة وقد منع بذلك عاءشة وبقية ازواجه صلي الله عليه وسلم لما جءن اليه يطلبن ثمنهن 
 وزعمت الرافضة ان الصديق رضي الله تعالي عنه كان ظالما لفاطمة رضي الله عنها بمنعه اياها من مخلف والدها وانه لا دليل له في هذا الخبر الذي رواه لان فيه احتجاجا بخبر الواحد مع معارضته لاية المواريث
 ورد بانه حكم بما سمعه من رسول الله صلي الله عليه وسلم وهو عنده قطعي فساوي اية المواريث من قطعية المتن وكان مخصصا لاية المواريث
 وذكر عن الرافضة انهم زعموا ان صدقة بالنصب وانا ما نافيه ويرده صدر الحديث انا معاشر الانبياء لا نورث واما رواية نحن معاشر الانبياء فلم تجء في كتاب من كتب الحديث كما قاله غير واحد ومن رواه بذلك رواه بالمعني لان نحن وانا مفادهما واحد ولا يعارض ذلك قوله تعالي @QB@ وورث سليمان داود @QE@ وقوقه تعالي حكاية عن زكريا @QB@ فهب لي من لدنك وليا يرثني ويرث @QE@ اذ المراد وراثة العلم والحكمة
 وفي لفظ انها رضي الله تعالي عنها قالت له من يرثك قال اهلي وولدي فقالت فمالي لا ارث ابي فقال لها سمعت رسول الله صلي الله عليه وسلم يقول لا نورث فغضبت رضي الله تعالي عنها من ابي بكر رضي الله تعالي عنه وهجرته الي ان ماتت اي فانها عاشت بعد رسول الله صلي الله عليه وسلم ستة اشهر علي ما تقدم ومعني هجرانها لابي بكر رضي الله تعالي عنه انها لم تطلب منه حاجة ولم تضطر الي لقاءه اذ لم ينقل انها رضي الله تعالي عنه لقيته ولم تسلم عليه ولا كلمته
 وروي ابن سعد ان ابا بكر رضي الله تعالي عنه جاء الي بيت علي لما مرضت فاطمة فاستاذن عليها فقال علي كرم الله وجهه هذا ابو بكر علي الباب يستاذن فان شءت ان تاذني فاذني قالت وذاك احب اليك قال نعم فاذنت له رضي الله تعالي عنه فدخل واعتذر اليها فرضيت عنه وان ابا بكر رضي الله تعالي عنه صلي عليها
 وقال الواقدي وثبت عندنا ان عليا كرم الله وجهه دفنها رضي الله تعالي عنها ليلا وصلي عليها ومعه العباس والفضل رضي الله تعالي عنهم ولم يعلموا بها احدا قال بعضهم وكانها تاولت قوله صلي الله عليه وسلم لا نورث وحملت ذلك علي الاموال اي الدراهم والدنانير كما جاء في بعض الروايات لا تقسم ورثتي دينارا ولا درهما بخلاف الاراضي ولعل طلب ارثها من فدك كان منها بعد ان ادعت رضي الله تعالي عنه ان النبي صلي الله عليه وسلم اعطاها فدكا وقال لها هل لك بينة فشهد لها علي كرم الله وجهه وام ايمن فقال لها رضي الله تعالي عنه ابرجل وامراة تستحقيها  واعترض عليه الرافضه بان فاطمه معصومه بنص @QB@ انما يريد الله ليذهب عنكم الرجس اهل البيت @QE@ وخبر فاطمه بضعه مي فدعوها صادقه لعصمتها وايظا شهد لها بذلك الحسن والحسين وام كلثوم رضي الله تعالي عنهم
 ورد عليهم بان من جمله اهل البيت ازواجه صلي الله عليه وسلم ولسن بمعصومات اتفاقا فكذلك بقيه اهل البيت وما كونها بضعه فمنه فمجاز قطعا وانها كبضعه فيما يرجع للخير والشفقه واما زعم انه شهد لها الحسن وام كلثوم فباطل لم ينقل عن احد ممن يعتمد عليه علي ان شهادة الفرع للاصل غير مقبوله
 وفي كلام سبط ابن الجوزي رحمه الله انه رضي الله تعالي عنه كتب لها بفدك ودخل عليه عمررضي الله تعالي عنه فقال ما هذا فقال كتاب كتبته فاطمه بميراثها من ابيها فقال مماذا تنفق علي المسلمين وقد حار بتك العرب كما تري ثم احذ عمر الكتاب فشقه
 وقد جاء ان بعد موت فاطمه رضي الله تعالي عنها اي وذلك بعد ستة اشهر من موته صلي الله عليه وسلم الا ليالي علي ما تقدم ارسل علي كرم الله وجه وقد اجتمع علي وبنو هاشم الي ابي بكر وقالوا اءتنا ولا يات معك احد كراهه ان يحضر عمر رضي الله تعالي عنه لما علموا من شدته فخافوا ان ينتصر لابي بكر رضي الله تعالي عنه فيتكلم بكلام يوحش قلوبهم علي ابي بكر رضي الله تعالي عنه فقال عمر رضي الله تعالي عنه لابي بكر لا والله لا تدخل عليهم وحدك قال ذلك خوفا عليه ان يغلظوا عليه في المعاتبه وربما كان ذلك سببا لتغير قلبه فيترتب عليه مالا ينبغي فقال ابو بكر رضي الله تعالي عنه وما يفعلون بي والله لاتينهم اي فدخل عليهم ابو بكر رضي الله تعالي عنه وحده فقال له كرم الله وجه انا قد عرفنا لك فضلك وما اعطاك الله ولم ننفس عليك خيرا ساقه الله اليك اي لا نحسدك عليه ولكن استبديت علينا بالامر اي لم تشاورنا فيه وكنا نري لقرابتنا من رسول الله صلي الله عليه وسلم ان لنا نصيبنا اي في المشاوره ففاضت عينا ابي بكر رضي الله تعالي عنه وقال والذي نفسي بيده لقرابة رسول الله صلي الله عليه وسلم احب الي من قرابتي فقال له علي كرم الله وجه موعدك العشيه للبيعه فلما صلي ابو بكر رضي الله تعالي عنه الظهر اي وقد حضر عنده علي كرم الله وجه رقي المنبر بكسر القاف فتشهد وذكر شان علي كرم الله وجه وعذره في تخلفه عن البيعه ثم ان عليا رضي الله تعالي عنه بايعه اي بعد ان عظم ابا بكر رضي الله تعالي عنه  وذكر فضيلته وسابقته وذكر انه لم يحمله علي الذي صنع نفاسة حق علي ابي بكر فاقبل الناس علي علي كرم الله وجه وقالوا اصبت واحسنت
 وقد علمت الجمع بين من قال بايع بعد ثلاثة ايام من موته صلي الله عليه وسلم ومن قال لم ينبع الا بعد موت فاطمه رضي الله تعالي عنها بعد ستة اشهر وهو انه بايع اولا ثم انقطع عن ابي بكر رضي الله تعالي عنه لما وقع بينه وبين فاطمه ما وقع ثم بايعه مبايعه اخري فتوهم من ذلك بعض من لا يعرف باطن الامر ان تخلفه انما هو لعدم رضاه بيعته فاطلق ذلك من اطلقه ومن ثم اظهر علي كرم الله وجه مبايعه لابي بكر ثانيا بعد ثوبتها علي المنبر لازالة هذه الشبهه
 وبهذا يعلم ما وقع في صحيح مسلم عن ابي سعيد من تاخر بيعة علي هو وغيره من بني هاشم الي موت فاطمة ومن ثم حكم بعضهم عليه بالضعف
 ومما يءيد الضعف ما جاء ان عليا وابا بكر رضي الله عنهما جاا لزيارة قبر النبي صلي الله عليه وسلم بعد وفاته بستة ايام فقال علي كرم الله وجهه تقدم يا خليفة رسول الله فقال ابو بكر رضي الله تعالي عنه ما كنت لاتقدم رجلا سمع رسول الله صلي الله عليه وسلم يقول فيه علي مني بمنزلتي من ربي وصلاة ابي بكر رضي الله تعالي عنه بالناس لم تختص بالمرض فقد جاء انه وقع قتال بين بني عمرو بن عوف فبلغ النبي صلي الله عليه وسلم ذلك فاتاهم بعد الظهر ليصلح بينهم فقال يا بلال ان حضرت الصلاة ولم ات مر ابا بكر فليصل بالناس فلما حضرت صلاة العصر اقام بلال الصلاة ثم امر ابا بكر كما تقدم
 وفي شرح مسلم للامام النووي رحمه الله وتاحر علي كرم الله وجهه اي ومن تاخر معه عن البيعة لابي بكر ليس قادحا فيها لان العلماء اتفقوا علي انه لا يشترط لصحتها مبايعة كل اهل العقد والحل بل مبايعة من تيسر منهم وتاخره كان للعذر اي الذي تقدم وكان عذر ابي بكر وعمر وبقية الصحابة واضا لانهم راوا ان المبادرة بالبيعة من اعظم مصالح المسلمين لان تاخرها ربما لزم عليه اختلاف فينشا عنه مفساد كثيرة كما افصح به ابو بكر رضي الله تعالي عنه فيما تقدم
 وجاء كما تقدم انه قيل لعلي كرم الله وجهه هل عهد اليك رسول الله صلي الله عليه وسلم بالخلافة فحدثنا فانت الموثوق به والمامون علي ما سمعت فقال لاوالله لءن كنت  اول من صدق به لا اكون اول من كذب عليه لو كان عندي من النبي صلي الله عليه وسلم عهد في ذلك ما تركت القتال علي ذلك ولو لم اجد الا بردتي هذه وما تركت اخا بني تميم وعمر بن الخطاب ينوبان علي منبره صلي الله عليه وسلم ولقاتلتهما بيدي والنبي صلي الله عليه وسلم لم يمت فجاه بل مكث في مرضه اياما وليالي ياتيه المءذن فيءذنه بالصلاة فيامر ابا بكر فيصلي بالناس وهو يري مكاني فلما مات رسول الله صلي الله عليه وسلم اخترنا لدنيانا من رضيه النبي صلي الله عليه وسلم لديننا فبايعناه وكان لذلك اهلا لم يختلف عليه منا اثنان فلما قبض تولاها عمر رضي الله تعالي عنه بمبايعته واقام فيها لم يختلف عليه منا اثنان واعطيت ميثاق لعثمان رضي الله تعالي عنه فلما مضوا بايعني اهل الحرمين واهل هذين المصرين اي الكوفة والبصرة فوثب فيها من ليس مثلي ولا قرابته كقرابتي ولا علمه كعلمي ولاسابقته كسابقتي وكنت احق بها منه يعني معاوية فهو راي رايته وفي لفظ لكن شء رايناه من قبل انفسنا فهذا تصريح منه كرم الله وجهه بانه صلي الله عليه وسلم لم ينص عليه امامته
 واما قوله صلي الله عليه وسلم يوم غدير خم عند مرجعه من حجة الوداع بعد ان جمع الصحابة وكرر عليهم الست اولي من انفسكم ثلاثا وهم يجيبونه بالتصديق والاعتراف ثم رفع يد علي كرم الله وجهه وقال من كنت مولاه فعلي مولاه الحديث فتقدم الكلام عليه وا ذلك لا يدل علي الخلافة
 وانما قال سيدنا عمر رضي الله تعالي عنه ان بيعة ابي بكر رضي الله تعالي عنه كانت فلت اي من غير استعداد ولا مشورة كما تقدم ردا علي من بلغه عنه انه قال اذا مات عمر بايعت فلانا والله ما كانت بيعة ابي بكر بمشورة فالبيعة لا تتوقف علي ذلك فغضب فلما رجع من اخر حجة حجها المدينة قال علي المنبر قد بلغني ان فلانا قال والله لو مات عمر بن الخطاب لقد بايعت فلانا ان بيعة ابي بكر كانت فلتة من غير مشورة فلا يغترن امرء ان يقول ان بيعة ابي كانت فلتة فنعم وانها كانت كذلك الا ان الله قد وقي شرها وليس فيكم من تنقطع الاعناق اليه مثل ابي بكر فمن بايع رجلا من غير مشورة المسلمين فانه لا بيعة له ولا الذي بايعه
 ولما ثقل المرض علي الصديق رضي الله تعالي عنه دعا عبد الرحمن فقال اخبرني عن عمر بن الخطاب فقال انت اعلم به مني فقال الصديق وان فقال عبد الرحمن هو  والله افضل من رايك فيه ثم دعا عثمان بن عفان رضي الله تعالي عنه فقال اخبرني عن عمر فقال انت اخبرنا به ثم دعا عليا كرم الله وجهه وقال له مثل ذلك ثم قال علي كرم الله وجهه اللهم عملي به ان سريرته خير من علانيته وانه ليس فينا مثله ودعا جمعا من الانصار فيهما اسيد بن حضير وسالهم فقال اللهم اعلمه يرضي للرضا ويسخط للسخط الذي يسر خير من الذي يعلن ولن يلي هذا الامر احد اقوي عليه منه فعند ذلك دعا عثمان رضي الله تعالي عنه فقال اكتب بسم الله الرحمن الرحيم هذا ما عهد ابو بكر ابن ابي قحافة في اخر عهده بالدنيا خارجا منها واول عهده بالاخرة داخلا فيها حيث يءمن ويوقن الفاجر ويصدق الكاذب اني استحلفت عليكم بعدي عمر بن الخطاب فاسمعوا له واطيعوا فان عدل فذلك ظني فيه وعلمي به وان بدل فلكل امرء ما اكتسب والخير اردت ولا اعلم الغيب @QB@ وسيعلم الذين ظلموا اي منقلب ينقلبون @QE@ والسلام عليكم ورحمة الله وبركاته ثم امر بالكتاب فختم ثم دعا عمر خاليا فاوصاه بالمسلمين وقبل ان يظهر الصديق رضي الله عنه هذا الامر اطلع علي الناس من كوة وقال ايها الناس اني قد عهدت عهدا افترضون به فقال الناس رضينا يا خليفة رسول الله فقام علي كرم الله وجهه فقال لا نرضي الا ان يكون عمر قال فانه عمر قال وكانت صلاتهم عليه صلي الله عليه وسلم كصلاتهم علي غيره اي بتكبيرات اربع لا مجرد الدعاء من غيرتكبيرات ا ه وهو يخالف ما تقدم المفيد ان صلاتهم انما كانت مجرد الدعاء لا الصلاة المعهودة
 وق يقال لا مخالفة وانما نصوا علي الدعاء لكونه مخالفا للدعاء المعروف في صلاة الجنازة علي غيره صلي الله عليه وسلم 
 وفي شرح مسلم عن القاضي عياض واختلف هل صلي الله عليه وسلم فقيل لم يصل عليه احد اصلا وانما كان الناس يدخلون ارسالا يدعون ويتضرعون والصحيح الذي عليه الجمهور انهم صلوا عليه افرادا فكان يدخل عليه فوج يصلون فرادي ثم يخرجون ثم يدخل فوج اخر فيصلون كذلك
 وعن ابن الماجشون صلي الله عليه وسلم اثنان وسبعون صلاة كحمزة رضي الله عنه قيل له من اين لك هذا قال من الصندوق الذي تركه مالك رحمه الله تعالي بخطه عن نافع عن ابن عمر رضي الله عنهما فصلي عليه الرجال الاحرار اولا ثم النساء الاحرار ثم الصبيان ثم العبيد ثم الاماء 
 واختلفوا في الموضع الذي يدفن فيه فمن قاءل يدفن في البقيع ومن قاءل ينقل ويدفن عند ابراهيم الخليل فقال ابو بكر رضي الله تعالي عنه ادفنوه في الموضع الذي قبض فيه فان الله لم يقبض روحه الا في مكان طيب
 اي وفي رواية انه رضي الله عنه قال ان عندي في هذا خبرا سمعت رسول الله صلي الله عليه وسلم يقول لا يدفن نبي الا حيث قبض وفي لفظ لا يقبض الله روح نبي الا في الموضع الذي يحب ان يدفن فيه
 وعن ابي بكر رضي الله عنه سمعت رسول الله صلي الله عليه وسلم يقول لا يقبض النبي الا في احب الامكنة اليه قال بعضهم ولا شك ان احبها اي الامكنة اليه احبها الي ربه تعالي فان حبه صلي الله عليه وسلم تابع لحب ربه جل وعلا وفي الحديث ما مات نبي الا دفن حيث قبض فحول فراشه وحفر له ودفن في ذلك ا لموضع الذي توفاه الله فيه
 واختلفوا هل يجعل له صلي الله عليه وسلم لحد او يجعل له شق وكان في المدينة شخصان احدهما يصنع اللحد والاخر يصنع الشق والاول هو ابو طلحة زيد بن سهل والثاني ابو عبيدة بن الجراح رضي الله عنه
 وفي لفظ كان ابو عبيدة يحفر حينءذ لاهل مكة وكان ابو طلحة زيد بن سهل يحفر لاهل المدينة فكان يلحد فقال عمر رضي الله عنه ترسلها لهما وكل من حضر منهما نزلناه فارسلوا خلفهما رجلين وقال عمر رضي الله عنه اللهم خر رسولك وقيل المرسل والقاءل ما ذكر العباس رضي الله عنه فسبق ابو طلحة رضي الله عنه فصنع له صلي الله عليه وسلم لحدا واطبق عليه بتسع لبنات ثم اهيل التراب وقد جاء في الحديث لحدوا ولا تشقوا فان اللحد والشق لغيرنا وقد وي مسلم عن سعد بن ابي وقاص رضي الله عنه انه قال في مرض موته الحدوا لي لحدا وانصبوا علي اللبن نصبا كما صنع برسول الله صلي الله عليه وسلم وسل من قبل راسه كما رواه البيهقي وصححه ابن عباس رضي الله عنهما اي وضع سريه صلي الله عليه وسلم عند مءخر القبر فكان راسه الشريف عند المحل الذي يكون فيه رجلاه فلما ادخل القبر سل من قبل راسه ودخل قبره العباس وعلي والفضل وقثم وشقران واقتصر ابن حبان عن ابن عباس رضي الله عنهما علي الثلاثة الاول وفرش شقران في اللحد تحته صلي الله عليه وسلم قطيفة حمراء 
 وفي رواية بيضاء كان يجعلها علي رجليه اذا سافر لان الارض كانت ندية وقال والله لا يبلسها احد بعدك فدفنت مع رسول الله صلي الله عليه وسلم
 وقيل اخرجت اي عملا بوصيته صلي الله عليه وسلم فقد روي البيهقي عن ابي موسي رضي الله عنه انه صلي الله عليه وسلم اوصي ان لا تتبعوني بصارخة ولا مجمرة ولا تجعلوا بيني وبيي الارض شيءا لكن في رواية الجامع الصغير افرشوا لي قطيفتي في لحدي فان الارض لم تسلط علي اجسا الانبياء عليهم الصلاة والسلام
 وكان دفنه صلي الله عليه وسلم ليلة الاربعاء وعن ام سلمة رضي الله عنه كنا مجتمعين نبكي تلك الليلة لم ننم فسمعنا صوت المساحي فصحنا وصاح اهل المسجد فارتجت المدينة صيحة واحدة فاذن بلال بالفجر فلما ذكر النبي صلي الله عليه وسلم بكي وانتحب فزادنا حزنا فيالها من مصيبة ما اصابنا بعدها من مصيبة الا هانت اذا ذكرنا مصيبتنا به صلي الله عليه وسلم
 وعن فاطمة رضي الله عنها لما دفن رسول الله صلي الله عليه وسلم قالت لانس يا انس كيف طابت نفوسكم ان تحثوا علي رسول الله صلي الله عليه وسلم التراب وفي لفظ اطابت نفوسكم ان دفنتم رسول الله صلي الله عليه وسلم في التراب ورجعتم وفي رواية انها قالت لعلي كرم الله وجهه يا ابا الحسن دفنتم رسول الله صلي الله عليه وسلم قال نعم قالت كيف طابت قلوبكم ان تحثوا التراب عليه كان نبي الرحمة قال نعم ولكن لاراد لامر الله وقد جاء ان الانسان يدفن في التربة التي خلق منها وهو يدل علي انه صلي الله عليه وسلم وابا بكر وعمر رضي الله عنهما خلقوا من تربة واحدة لانهم دفنوا ثلاثتهم في تربة واحدة
 فقد روي ان ابا بكر رضي الله عنه لما حضرتي الوفاة قال لمن حضره اذا انامت وفرغتم من جهازي فاحملوني حتي تقفوا بباب البيت الذي فيه قبر النبي صلي الله عليه وسلم فقفوا بالباب وقولوا السلام عليك يا رسول الله هذا ابو بكر يستاذن فان اذن لكم بان فتح الباب وكان الباب مغلقا بقفل فادخلوني وادفنوني وان لم يفتح الباب فاخرجوني الي البقيع وادفنوني به فلما وقفوا علي الباب وقالوا ما ذكر سقط القفل وانفتح الباب وسمع هاتف من داخل البيت ادخلوا الحبيب الي الحبيب فان الحبيب الي الحبيب مشتاق
 ولما احتضر عمر رضي الله عنه قال لابنه عبد الله رضي الله عنه يا عبد الله اءت  ام المءمنين عاءشة رضي الله عنه فقل لها ان عمر يقرءك السلام ولا تقل امير المءمنين فاني لست اليوم بامير المءمنين وقل يستاذن ان تدفنيه مع صاحبيه فان اذنت فادفنوني وان ابت فردوني الي مقابر المسلمين فاتاها عبد الله وهو يبكي فقال ان عمر يستاذن ان يدفن معه صاحبيه فقالت لقد كنت ادخرت ذلك المكان لنفسي ولاوثرنه اليوم علي نفسي فلما رجع عبد الله الي ابيه واقبل عليه قال عمر اقعدوني ثم قال لعبد الله ما وراءك قال قد اذنت لك قال الله اكبر ما شء اهم الي من ذلك المضجع
 وقد ذكر ان الحسن رضي الله عنه لما سقي السم وراي كبده تقطع ارسل الي عاءشة رضي الله عنه ان يدفن عند جده صلي الله عليه وسلم فاذنت له فلما مات منع من ذلك مروان وبنو امية فدفن بالبقيع ويذكر انه رضي الله عنه قال لاخيه الحسين رضي الله عنه كنت بلغت الي عاءشة اذا مت ان تاذن لي ان ادفن في بيتها مع رسول الله صلي الله عليه وسلم فقالت نعم ولا ادري لعلها كان ذلك منها حياء فاذا انامت فاطلب ذلك منها فان طابت نفسها فادفني في بيتها وما اظن القوم الا سيمنعونك فان فعلوا فلا تراجعهم في ذلك وادفني في بقيع الغرقد فان لي فيمن فيه اسوة فلما مات الحسن رضي الله عنه جاء الحسين رضي الله عنه الي عاءشة رضي الله عنها فطلب منها ذلك فقالت نعم وكرامة فبلغ ذلك مروان فقال كذب وكذبت والله لا يدفن هناك ابدا منعوا عثمان من دفنه هناك ويريدون دفن حسن فبلغ ذلك الحسين رضي الله عنه فلبس الحديد هو ومن معه وكذلك مروان لبس الحديد هو ومن معه فبلغ ذلك ابا هريرة رضي الله عنه فانطلق الي الحسين وناشده الله وقال له اليس اخوك قد قال لك ما قال فلم يزل به حتي رضي الله عنه بدفنه بالبقيع فدفن بجانب امه رضي الله عنها ولم يشهد جنازته احد من بني امية الا سعيد ابن العاص لانه كان اميرا علي المدينة قدمه الحسين فصلي عليه اماما وقال هي السنة
 قال ابن كثير رحمه الله والذي نص عليه غير واحد من ا لاءمة سلفا وخلفا انه صلي الله عليه وسلم توفي يوم الاثنين قبل ان ينتصف النهار ودفن يوم الثلاثاء قبل وقت الضحي والقول انه مكث ثلاثة ايام لا يدفن غريب والصحيح انه صلي الله عليه وسلم مكث بقية يوم الاثنين وليلة الثلاثاء ويوم الثلاثاء وبعض ليلة الاربعاء
 وكان السبب في تاخره صلي الله عليه وسلم ما علمت من اشتغالهم ببيعة ابي بكر رضي الله عنه حتي تمت وقيل لعدم اتفاقهم علي موته صلي الله عليه وسلم وكان اخر من طلع من  قبره الشريف قثم بن العباس رضي الله عنهما وقيل المغيرة بن شعبة رضي الله عنه لانه القي خاتمة في القبر الشريف وقال لعلي يا ابا الحسن خاتمي وانما طرحته عمدا لامس رسول الله صلي الله عليه وسلم واكون اخر الناس عهدا به قال انزل فخذه وقيل القي الفاس في القبر وقال الفاس الفاس فنزل واخذها ويقال ان عليا كرم الله وجهه لما قال له المغيرة ذلك نزل وناوله الخاتم اي او الفاس او امر من نزل وناوله ذلك وقال له انما فعلت ذلك لتقول انا اخر الناس برسول الله صلي الله عليه وسلم عهدا واعترض بان المغيرة رضي الله عنه لم يكن حاضرا للدفن
 وقد روي ان جماعة من العراق قدموا علي علي كرم الله وجهه فقالوا يا ابا الحسن جءناك لنسالك عن امر نحب ان تخبرنا عنه فقال لهم اظن ان المغيرة بن شعبة يحدثكم انه كان اخر الناس عهدا برسول الله صلي الله عليه وسلم قالوا اجل عن هذا جءنا نسالك قال كان اخر الناس عهدا برسول الله صلي الله عليه وسلم قثم بن العباس رضي الله عنهما
 وقام الاجماع علي ان هذا الموضع الذي ضم اعضاءه الشريفة صلي الله عليه وسلم افضل بقاع الارض حتي موضع الكعبة الشريفة قال بعضهم وافضل من بقاع السماء ايضا حتي من العرش
 وعن انس بن مالك رضي الله عنه ما نفضنا الايدي من دفن رسول الله صلي الله عليه وسلم حتي انكرنا قلوبنا قال بعضهم واظلمت الدنيا حتي لم ينظر بعضنا الي بعض وكان احدنا يبسط يده فلا يراها وقال رسول الله صلي الله عليه وسلم انا فرط لامتي لن يصابوا بمثلي وفي مسلم انه صلي الله عليه وسلم قال ان الله سبحانه وتعالي اذا اراد بامة خيرا قبض نبيها قبلها فجعله لها فرطا وسلفا بين يديها فياله من خطب جل عن الخطوب ومصاب علم دمع العيون كيف يصوب وطارق هجم هجوم الليل وحادث هد كل القوي والحيل ولشدة اسف حماره عليه صلي الله عليه وسلم الذي كان يركبه القي نفسه في حفيرة فمات كما تقدم وتركت ناقته صلي الله عليه وسلم الاكل والشرب حتي ماتت وانشد الحافظ الدمياطي عن غير  الا يا ضريحا ضم نفسا زكية  عليك السلام الله في القرب والبعد   عليك سلام الله ما هبت الصبا  وما ناح قمري علي البان والرند    وما سجعت ورق وغنت حمامة  وما اشتاق ذو وجد الي ساكني نجد   ومالي سوي حبي لكم ال احمد  امرغ من شوقي علي بابكم خدي  $ = باب بيان ما وقع من الحوادث من عام ولادته صلي الله عليه وسلم الي زمان وفاته صلي الله عليه وسلم علي سبيل الاجمال وبيان زمن ولادته عاما ويوما وشهرا ومكانا اعلم ان الاكثر علي انه ولد عام الفيل وحكي بعضهم الاجماع عليه قال وكل قول خالفه فهو وهم
 وقيل بعد عام الفيل بخمسين يوما وقيل بزيادة خمسة ايام وقيل شهر وقيل باربعين يوما وقيل بشهرين وعشرة ايام وقيل بعشرين سنة وقيل بعشر سنين وقيل بخمس عشرة سنة
 وكانت ولادته صلي الله عليه وسلم يوم الاثنين في شهر ربيع الاول لعشر خلون منه وقيل لليلتين وقيل لثمان خلت واختاره الحميدي تبعا لشيخه ابن حزم وحكي القضاعي رحمه الله عنه عيون المعارف اجماع اهل التاريخ عليه وقيل لاثنتي عشرة ليلة وهو المشهور وقيل لسبع عشرة وقيل لثمان بقين منه وذلك في النهار عند طلوع الفجر وقيل ولد ليلا وعليه عمل اهل مكة في زيارة موضع مولده الشريف صلي الله عليه وسلم وكونه في شهر ربيع الاول هو قول الجمهور من العلماء وحكي ابن الجوزي رحمه الله الاتفاق عليه وقيل في صفر وقيل في ربيع الاخر وقيل في رجب وقيل في شهر رمضان
 واختلف في مكان ولادته صلي الله عليه وسلم فقيل بمكة وعليه قيل بالدار التي كانت لمحمد بن يوسف اخي الحجاج وقيل بالشعب شعب بني هاشم وذلك المحل يزار الان وقيل بالردم وقيل ولد صلي الله عليه وسلم بعسفان
 وفي السنة الثالثة من مولده صلي الله عليه وسلم شق صدره الشريف عند ظءره حليمة رضي الله عنها وقيل كان في الرابعة وفيها ولد ابو بكر الصديق رضي الله تعالي عنه بمني 
 وفي السنة السادسة من مولده صلي الله عليه وسلم كان وفاة امة امنة ودفنت بالابواء وقيل بشعب ابي ذءب بالحجون محل مقابر اهل مكة وقيل في دار راءعة بالمعلاة وفيها ولد عثمان بن عفان رضي الله عنه
 وفي السنة السابعة من مولده صلي الله عليه وسلم استقل بكفالته جده عبد المطلب وفيها اصابه صلي الله عليه وسلم رمد شديد وفيها استسقي عبد المطلب وهو صلي الله عليه وسلم معه بسبب رءيا دقيقة وفيها خرج عبد المطلب لتهنءة سيف بن ذي يزن الحميري بالملك
 وفي السنة الثامنة من مولده صلي الله عليه وسلم كانت وفاة جده عبد المطلب وكفالة عمه ابي طالب له صلي الله عليه وسلم
 وفي هذه السنة مات حاتم الطاءي الذي يضرب به المثل في الجود والكرم ومات كسري انو شروان
 وفي السنة التاسعة من مولده صلي الله عليه وسلم قيل سافر به عمه ابو طالب الي بصري من ارض الشام وهي مدينة هوازن
 وفي السنة العاشرة من مولده صلي الله عليه وسلم كانت حرب الفجار الاولي
 وفي السنة العاشرة وقيل الحادية عشرة من مولده صلي الله عليه وسلم كان شق صدره الشريف
 وفي السنة الثانية عشرة من مولده صلي الله عليه وسلم كان حرب الفجار الثانية وكان سفر عمه ابي طالب به صلي الله عليه وسلم الي بصري من ارض الشام علي ما عليه الاكثر
 وفي السنة الثالثة عشرة من مولده صلي الله عليه وسلم ولد عمر بن الخطاب رضي الله عنه
 وفي السنة الرابعة عشرة من مولده صلي الله عليه وسلم كان عمه الزبير والعباس ابني عبد المطلب لليمن للتجارة وصحبهما النبي صلي الله عليه وسلم
 وفي السنة الخامسة والعشرين من مولده صلي الله عليه وسلم كان سفره صلي الله عليه  وسلم الي الشام مع ميسرة غلام خديجة رضي الله عنها وتزوج صلي الله عليه وسلم خديجة
 وفي سنة ثلاثين من مولده صلي الله عليه وسلم ولد علي بن ابي طالب كرم الله وجهه في الكعبة
 وفي سنة اربع وثلاثين من مولده صلي الله عليه وسلم ولدع معاوية بن ابي سفيان رضي الله عنه ومعاذ بن جبل رضي الله عنه
 وفي سنة خمس وثلاثين من مولده صلي الله عليه وسلم هدمت قريش الكعبة وبنتها
 وفي سنة سبع وثلاثين راي صلي الله عليه وسلم الضوء والنور وكان صلي الله عليه وسلم يسمع الاصوات
 وفي السنة الاولي من النبوة كان نزول الوحي عليه صلي الله عليه وسلم في اليقظة بعد ان مكث صلي الله عليه وسلم ستة اشهر يوحي اليه في المنام
 وفي السنة الثالثة من النبوة قيل توفي ورقة بن نوفل
 وفي السنة الرابعة من النبوة كان اظهار الدعوة
 وفي السنة الخامسة من النبوة ولدت عاءشة رضي الله عنها وقيل ولدت في الرابعة
 وفي السنة الخاسمة ايضا كانت الهجرة الاولي الي ارض الحبشة وفيها ماتت سمية ام عمار بن ياسر رضي الله عنهم وهي اول شهدية في الاسلام
 وفي السنة السادسة من النبوة اسلم حمزة بن عبد المطلب رضي الله عنه وعمر بن الخطاب رضي الله عنه وقيل اسلما رضي الله عنهما في سنة خمس وكان اسلام حمزة رضي الله عنه قبل اسلام عمر رضي الله عنه بثلاثة ايام
 وفي السنة السابعة من النبوة تقاسمت قريش وتعاهدت علي معاداة بني هاشم وبني المطلب وقيل كان ذلك في السادسة وقيل في الخامسة وقيل في الثامنة وذلك في خيف بني كنانة بالابطح ويسمي محصبا وهو باعلي مكة شرفها الله عند المقابر
 وفي السنة التاسعة من النبوة كان انشقاق القمر له صلي الله عليه وسلم
 وفي السنة العاشرة من النبوة مات ابو طالب وماتت خديجة رضي الله عنها وكان صلي الله عليه وسلم يسمي ذلك العام عام الحزن وفيها جاءه صلي الله عليه وسلم جن نصيبين واسلموا وفيها تزوج صلي الله عليه وسلم سودة رضي الله عنها بنت زمعة ودخل عليها في مكة وفيها عقد صلي الله عليه وسلم عقده علي عاءشة رضي الله عنها ولم يدخل صلي الله عليه وسلم عليها الا في المدنية 
 وفي السنة الحادية عشرة من النبوة كان ابتداء اسلام الانصار رضي الله عنهم
 وفي السنة الثانية عشرة من النبوة كان الاسراء والمعراج وفيها وقعت بيعة العقبة الاولي
 وفي السنة الثالثة عشرة من النبوة كانت بيعة العقبة الثانية التي هي الكبري وبعضم يسميها العقبة الثالثة ويسمي اسلام الانصار عقبة مع انه لا مبايعة فيه وفي هذه السنة اراد ابو بكر رضي الله عنه ان يهاجر للحبشة فلما بلغ برك الغماد رده ربيعة بن الدغنة سيد القاره
 وفي السنة الرابعة عشرة من النبوة وهي السنة الاولي من الهجرة الي المدينة فكانت الهجرة فيها في صفر او في غرة ربيع الاول وفيها كان بناء المسجد ومساكنه صلي الله عليه وسلم ومسجد قباء والمءاخاة بين المهاجرين والانصار رضي الله عنهم قيل وكان ابتداء خدمة انس رضي الله عنه له صلي الله عليه وسلم فقد جاء انه صلي الله عليه وسلم لما قدم المدينة صارت الانصار يبعثون اليه صلي الله عليه وسلم بالهدايا رجالهم ونساءهم وكانت ام انس رضي الله عنهما لا شء لها تهديه له صلي الله عليه وسلم فكانت تتاسف فاخذت يوما بيد انس رضي الله عنه وقالت يا رسول الله هذا يخدمك وجاء ان زوجها ابا طلحة رضي الله عنه جاء به الي رسول الله صلي الله عليه وسلم وقال يا رسول الله ان انسا غلام كيس فليخدمك
 وجمع بان امه جاءت به اولا ثم جاء به ابو طلحة ثانيا لانه وليه وعصبته قال في الخميس وهذا غير مجيءه به لخدمته صلي الله عليه وسلم في غزوة خيبر وفيها كما في الاصل وقيل في السنة الثانية زيد في صلاة الحضر ركعتان وتركت صلاة الفجر وصلاة المغرب لانها وتر النهار واقرت صلاة السفر وتركت علي الفريضة الاولي كذا قيل وفي هذه السنة مات من مشركي مكة الوليد بن المغيرة ولما احتضر جزع فقال له ابو جهل لعنه الله يا عم ما جزعك فقال والله ما بي من جزع من الموت ولكن اخاف ان يظهر دين ابن ابي كبشة بمكمة فقال ابو سفيان رضي الله عنه لا تخلف اني ضامن ان لا يظهر وفيها مات العاص بن واءل وفيها مات اسعد بن زرارة رضي الله عنه وفيها ابتدءت الغزوات فكان فيها غزوة الابواء وغزوة ودان كما في الاصل وفي هذه السنة بني صلي الله عليه وسلم بعاءشة رضي الله عنها وفيها شرع الاذان وفيها صلي صلي الله  عليه وسلم الجمعة في طريقه حيث ارتحل صلي الله عليه وسلم من قباء الي المدينة وهي اول جمعة صلاها واول خطبة خطبها في الاسلام وفيها اسلم عبد الله بن سلام رضي الله عنه وكان فيها بعث عمه حمزة رضي الله عنه يعترض عيرا لقريش وبعث ابن عمه عبيدة بن الحارث رضي الله عنه الي بطن رابغ وبعث سعد بن ابي وقاص رضي الله عنه الي الخرار يعترض عيرا لقريش
 وفي السنة الخامسة عشرة من النبوة والثانية من الهجرة تزوج علي كرم الله وجهه بفاطمة رضي الله عنها وتكنيته بابي تراب وغزوة بواط وغزوة العشيرة وسرية عبدالله بن جحش رضي الله عنه الي بطن نخلة وتحويل القبلة وتجديد بناء مسجد قباء وفرض رمضان وغزوة بدر الكبري ووفاة رقية بنت النبي صلي الله عليه وسلم ورضي عنها وقتل عصماء وفرض زكاة الفطر وشروع صلاة عيده وفرض زكاة الاموال وغززوة قرقرة الكدر وسرية سالم بن عمير رضي الله عنه وغزوة بن قينقاع وغزوة السويق وموت عثمان بن مظعون رضي الله عنه والتضحية وصلاه عيدها
 وفي السنة السادسة عشرة من النبوة والثالثة من الهجرة سرية محمد بن سلمة رضي الله عنه لقتل كعب بن الاشرف لعنه الله وتزوج عثمان رضي الله عنه ام كلثوم رضي الله عنها وغزوة غطفان وغزوة بحران وسرية زيد بن حارثة رضي الله عنهما الي قردة وتزوج حفصه رضي الله عنها وتزوج زينب بنت خزيمة رضي الله عنها وولادة الحسن وغزوة احد وغزوة حمراء الاسد وعلوق فاطمة بالحسين رضي الله عنها
 وفي السنة السابعة عشرة من النبوة والرابعة من الهجرة سرية ابي سلمة رضي الله عنه الي قطن ووفاته وسرية عبد الله بن انيس رضي الله عنه الي عرنة لقتل سنان بن خالد وسرية القراء رضي الله عنهم الي بءر معونة وقصة الرجيع وسرية عمرو بن امية الضمري رضي الله عنه الي مكة لقتل ابي سفيان رضي الله عنه وغزوة بني النضير ووفاة زينب بنت خزيمة وغزوة ذات الرقاع وصلاة الخوف وولادة الحسين رضي الله عنه وغزوة بدر الصغري وتزوج ام سلمة رضي الله عنها وتحريم الخمر عند بعضهم
 وفي السنة الثامنة عشرة من النبوة والخامسة من الهجرة غزوة دومة الجندل وغزوة المريسيع ونزول اية التيمم وتزوج جويرية رضي الله عنها وقصة الافك وغزوة الخندق وغزوة بني قريظة وقصة اولاد جابر رضي الله عنهما وتزوج زينب بنت جحش رضي الله عنها ونزول اية الحجاب وفرض الحج  وفي السنة التاسعة عشرة من النبوة والسادسة من الهجرة سرية محمد بن مسلمة رضي الله عنه الي القرطاء وقصة ثمامة وغزوة بني لحيان وغزوة الغابة وسرية عكاشة رضي الله عنه الي الغمر وسرية محمد بن مسلمة رضي الله عنه الي ذي القصة وسرية ابي عبيدة ابن الجراح رضي الله عنه الي مصارع اصحاب محمد بن مسلمة رضي الله عنهم وسرية زيد ابن حارصة رضي الله عنهما الي بني سليم بالجموم وسرية زيد بن حارثة رضي الله عنهما الي العيص وسرية زيد بن حارثة رضي الله عنهما الي الطرف وسرة زيد بن حارثة رضي الله عنهما الي وادي القري وسرية زيد بن حارثة رضي الله عنهما الي ام قرفة وسرية عبد الله ابن عتيك رضي الله عنه لقتل ابي رافع وسرية عبد الله بن رواحة رضي الله عنه الي اسير ابن رزام اليهودي بخيبر وسرية زيد بن حارثة رضي الله عنهما الي حسمي وغزوة الحديبية ونزول حكم الظهار وتحريم الخمر وتزوجه صلي الله عليه وسلم ام حبيبة رضي الله عنها
 وفي السنة العشرين من النبوة والسابعة من الهجرة كان اتخاذ الخاتم وارسال الرسل الي الملوك ووقوع السحر به صلي الله عليه وسلم وغزوة خيبر وفتح وادي القري والدخول بام حبيبة رضي الله عنها وسرية عمر بن الخطاب رضي الله عنه الي طاءفة من هوازن وعمرة القضاء وتزوج ميمونة رضي الله عنها وسرية ابن ابي العوجاء رضي الله عنه الي بني سليم
