 وجاء رضي الله تعالي عنه بالف دينار فصبها في حجر النبي صلي الله عليه وسلم فجعل رسول الله صلي الله عليه وسلم يقلبها بيديه ويقول ما ضر عثمان ما عمل بعد اليوم يرددها مرارا ا ه
 وفي رواية جاء بعشرة الاف دينار الي رسول الله صلي الله عليه وسلم فصبت بين يديه فجعل صلي الله عليه وسلم يقول بيديه ويقلبها ظهرا لبطن ويقول غفر الله لك يا عثمان ما اسررت وما اعلنت وما كان منك وما هو كاءن الي يوم القيامة ما يبالي ما عمل بعدها اي ولعل هذه العشرة الالاف هي التي جهز بها العشرة الاف انسان وانها اي العشرة غير الالف التي صبها في حجره صلي الله عليه وسلم
 وانفق غير عثمان ايضا من اهل الغني قال وكان اول من جاء بالنفقة ابو بكر الصديق رضي الله تعالي عنه جاء بجميع ماله اربعة الاف درهم فقال له رسول الله صلي الله عليه وسلم هل ابقيت لاهلك شيءا قال ابقيت لهم الله ورسوله وجاء عمر بن الخطاب رضي الله تعالي عنه بنصف ماله فقال له رسول الله صلي الله عليه وسلم هل ابقيت لاهلك شيءا قال النصف الثاني وجاء عبد الرحمن بن عوف رضي الله تعالي عنه بماءة اوقية اي ومن ثم قيل عثمان بن عفان وعبد الرحمن بن عوف رضي الله تعالي عنهما كانا خزنتين من خزاءن الله في الارض ينفقان في طاعة الله تعالي وجاء العباس رضي الله تعالي عنه بمال كثير وكذا طلحة رضي الله تعالي عنه وبعثت النساء رضي الله تعالي عنهن بكل  ما يقدرن عليه من خليهن وتصدق عاصم بن عدي رضي الله تعالي عنه بسبعين وسقا من تمر ا ه معناه صلي الله عليه وسلم جمع اي سبعة انفس من فقهاء الصحابة يتحملونه اي يسالونه ان يحملهم فقال صلي الله عليه وسلم لا اجد ما احملكم به وعند ذلك تولوا واعينهم تفيض من الدمع حزنا ان لا يجدوا ما ينفقون اي ما يحملهم ومن ثم قيل لهم البكاءون ومنهم العرباض بن سارية رضي الله تعالي عنه ولم يذكره القاضي البيضاوي في السبعة وحمل العباس رضي الله تعالي عنه منهم اثنين وحمل منهم عثمان رضي الله تعالي عنه بعد الجيش الذي جهز ثلاثة اي وحمل يا ميز بن عمرو النضري اثنين دفع لهما ناضحا له وزود كل واحد منهما صاعين من تمر وعدهم مغلطاي ثمانية عشر
 وفي البخاري عن ابي موسي الاشعري قال ارسلني اصحابي الي رسول الله صلي الله عليه وسلم اساله الحملان لهم فقلت يا نبي الله ان اصحابي ارسلوني اليك لتحملهم فقال والله لا احملكم عي شي وفي رواية والله لا احملكم ولا اجد ما احملكم عليه فرجعت حزينا الي اصحابي من منع النبي ومن مخافة ان يكون النبي صلي الله عليه وسلم وجد في نفسه حيث حلف علي ان لا يحملهم قال فرجعت الي اصحابي فاخبرتهم الذي قال النبي صلي الله عليه وسلم فلم البث الا سويعة اذ سمعت بلالا ينادي اين عبد الله ابن قيس فاجبته قال احب رسول الله صلي الله عليه وسلم يدعوك فلما اتيته قال خذ هذه الستة ابعرة فانطلق بها الي اصحابك زاد بعضهم فعند ذلك قال بعضهم لبعض اغلقنا رسول الله صلي الله عليه وسلم اي حملناه علي يمين الغلق وقد حلف ان لا يحملنا ثم حملنا فو الله لا بارك لنا في ذلك فاتوه فذكروه فقال عليه الصلاة السلام انا ما حملتكم الله حملكم ثم قال اني لا احلف يمينا فاري غيرها خيرا منا الا كفرت عن يمني واتيت الذي هو خير اي فهو صلي الله عليه وسلم انما حلف ان لا يتكلف لهءلاء حملا بقرض ونحوه ما دام لا يجد لهم حملا فلا حنث وفيه ان هذا لا يناسب قوله اني لا احلف الي اخره
 واجيب بان هذه استثبات قاعدة لا تدل علي ان النبي صلي الله عليه وسلم حنث في يمينة بل خرج الكلام علي تقدير كانه قال لو حنثت في يمني حيث كان الحنث خيرا وكفرت عنها لكان ذلك شرعا واسعا بل ندبا راجحا ويءيده انه لم ينقل ان رسول الله صلي الله عليه وسلم كفر عن هذه اليمين وحينءذ يحتاج الي الجمع بين هذا وما قبله 
 وقد يقال ان حمل العباس رضي الله تعالي عنه اثنين منهم الي اخره كان قبل وجود هذه الابعرة الستة او يدعي ان هءلاء غير من تقدم
 فلما تجهز رسول الله صلي الله عليه وسلم وسار بالناس وهم ثلاثون الفا اي وقيل اربعون الفا وقيل سبعون الفا وكانت الخيل عشرة الاف فرس وقيل بزيادة الفين
 وخلف علي المدينة محمد بن مسلمة الانصاري رضي الله تعالي عنه علي ما هو المشهور وقال الحافظ الدمياطي رحمه الله وهو اثبت عندنا وقيل سباع بن عرفطة اي وقيل ابن ام مكتوم وقيل علي بن ابي طالب قال ابن عبد البر وهو الاثبت هذا كلامه
 وفي كلام ابن اسحاق وخلف عليا كرم الله وجهه علي اهله وامره بالاقامة فيهم وتخلف عنه عبد الله بن ابي ابن سلول ومن كان من المنافقين بعد ان خرج بهم وعسكر عبد الله بن ابي علي ثنية الوداع اي اسفل منها لان معسكره صلي الله عليه وسلم كان علي ثنية الوداع وكان عسكر بعد الله بن ابي اسفل منه قال ابن اسحاق رحمه اله وما كان فيما يزعمون باقل العسكرين اي والتعبير عن ذلك بالزعم واضح لانه يبعد ان يكون عسكر عبد الله مساويا لعسكره صلي الله عليه وسلم فضلا عن كونه اكثر منه فليتامل وقال عند تخلفه يغزو محمد بني الاصفر مع جهد الحال والحر والبلد البعيد اي مالا طاقة له به يحسب محمد ان قتال بني الاصفر معه اللعب والله لكاني انظر الي اصحابه مقرنين في الحبال يقول ذلك ارحاما برسول الله صلي الله عليه وسلم وباصحابه اي وقيل للروم بنو الاصفر لانهم ولد روم بن العيص بن اسحاق نبي الله عليه السلام وكان يسمي الاصفر لصفرة به
 فقد ذكر العلماء باخبار القدماء ان العيص تزوج بنت عمه اسماعيل فولدت له الروم وكان به صفرة فقيل له الاصفر وقيل الصفرة كانت بابيه العيص
 ولما ارتحل رسول الله صلي الله عليه وسلم عن ثنية الوداع متوجها الي تبوك عقد الالوية والرايات فدفع لواءه الاعظم لابي بكر الصديق رضي الله عنه ورايته صلي الله عليه وسلم العظمي للزبير رضي الله عنه ودفع راية الاوس لاسيد بن حضير رضي الله عنه وراية الخزرج الي الحباب بن المنذر رضي الله عنه ودفع لكل بطن من الانصار ومن قباءل العرب لواء وراية اي لبعضهم راية ولبعضهم لواء وكان قد اجتمع جمع من المنافقين اي في بيت سويلم اليهودي فقال بعضهم لبعض اتحسبون جلاد بني الاصفر  اي وهم الروك كقتال العرب بعضهم بعضا والله لكانهم يعني الصحابة غدا مقرنون في الحبال يقولون ذلك ارجافا وترهيبا للمءمنين والجلاد الضرب بالسيوف فقال رسول الله صلي الله عليه وسلم عند ذلك لعمار بن ياسر رضي الله عنه ادرك القوم فانهم قد احترقوا فاسالهم عما قالوا فان انكروا فقل بل قلتم كذا وكذا فانطلق اليهم عمار فقال لهم فاتوا رسول الله صلي الله عليه وسلم يعتذرون اليه وقالوا انما كان نخوض ونلعب فانزل الله تعالي @QB@ ولءن سالتهم ليقولن انما كنا نخوض ونلعب @QE@ وقال صلي الله عليه وسلم للجد بن قيس يا جد هل لك في جلاد بني الاصفر قال يا رسول الله او تاذن لي اي في التخلف ولا تفتني فوالله لقد عرف قومي انه ما من رجل اشد عجبا بالنساء مني واني اخشي ان رايت نساء بني الاصفر ان لا اصبر فاعرض عنه رسول الله صلي الله عليه وسلم وقال قد اذنت لك فانزل الله تعالي @QB@ ومنهم من يقول اءذن لي ولا تفتني @QE@ الاية وفي لفظ انه صلي الله عليه وسلم قال اغزوا تبوك تغنموا بنات بني الاصفر نساء الروم فقال قوم من المنافقين اءذن لنا ولا تفتنا فانزل الله تعالي الاية @QB@ الا في الفتنة سقطوا @QE@ اي التي هي التخلف عن رسول الله صلي الله عليه وسلم والرغبة عنه
 وفي لفظ انه صلي الله عليه وسلم قال للجد بن قيس يا ابا قيس هل لك ان تخرج معنا لعلك تحقب اي تردف خلفك من بنات بني الاصفر فقال ما تقدم وعند ذلك لامه ولده عبد الله رضي الله عنه وقال له والله ما يمنعك الا النفاق وسينزل الله فيك قرانا فاخذ نعله وضرب به وجه ولده فلما نزلت الاية قال له الم اقل لك فقال له اسكت يالكع فوالله لانت اشدعلي من محمد وفي رواية ان الجد بن قيس لما امتنع واعتذر بما تقدم قال للنبي صلي الله عليه وسلم ولكن اعينك بمالي فانزل الله تعالي @QB@ قل انفقوا طوعا او كرها لن يتقبل منكم @QE@ وتقدم انه لم يبايع بيعة الرضوان وتقدم انه تاب من النفاق وحسنت توبته وانه صلي الله عليه وسلم قال لبني ساعدة من سيدكم فقالوا الجد بن قيس علي بخل فيه فقال واي داء ادوا من البخل قالوا يا رسول الله من سيدنا فقال بشر بن البراء بن معرور وفي رواية سيدكم الجعد الابيض عمرو بن الجموح وذكر ابن عبد البر ان النفس اميل الي الاول ومات الجد بن قيس في خلافة عثمان رضي الله عنه وقال بعض المنافقين لبعض لا تنفروا في الحر فانزل الله تعالي @QB@ قل نار جهنم اشد حرا لو كانوا يفقهون @QE@ اي يعلمون @QB@ وجاء المعذرون @QE@ اي وهم الضعفاء والمقلون من  الاعراب ليءذن لهم في التخلف فاذن لهم وكانوا اثنين وثمانين رجلا وقعد اخرون من المنافقين بغير عذر واظهار علة جراءة علي الله ورسوله وقد عناهم الله تعالي بقوله وقعد الذي كذبوا الله ورسوله
 قال السهيلي واهل التفسير يقولون ان اخر براة نزل قبل اولها وان اول ما نزل منها @QB@ انفروا خفافا وثقالا @QE@ قيل معناه شبابا وشيوخا وقيل اغنياء وفقراء وقيل اصحاب شغل وغيرذي شغل وقيل ركبانا ورجالة ثم نزل اولها في نبذ كل ذي عهد الي صاحبه كما تقدم
 وتخلف جمع من المسلمين منهم كعب بن مالك وهلال بن امية ومرارة بن الربيع من غير عذر وكانوا ممن لا ينهم في اسلامه
 ولما خلف صلي الله عليه وسلم عليا كرم الله وجهه ارجف به المنافقون وقالوا ما خلفه الا استثقالا له وحين قيل فيه ذلك اخذ علي كرم الله وجهه سلاحه ثم خرج حتي لحق برسول الله صلي الله عليه وسلم وهو نازل بالجرف فقال يا نبي الله زعم المنافقون انك ما خلفتني الا استثقلتني وتخففت مني فقال كذبوا ولكنني خلفتك لما تركت وراءي فارجع فاخلفني في اهلي واهلك افلا ترضي يا علي ان تكون مني بمنزلة هرون من وموسي الا انه لا بني بعدي اي فان موسي عليه السلام حين توجه الي ميقات ربه استخلف هرون عليه السلام في قومه فرجع علي الي المدينة
 وعن علي كرم الله وجهه قال خرج رسول الله صلي الله عليه وسلم في غزوة وخلف جعفرا في اهله فقال جعفر والله لا اتخلف عنك فخلفني فقلت يا رسول الله اتخلفني الي شء تقول قريش اليس يقولون ما اسرع ما خذل ابن عمه وجلس عنه واخري ابتغي الفضل من الله لاني سمعت الله يقول ولا يطءون موطءا يغيظ الكفار الاية فقال اما قولك ان تقول قريش ما اسرع ما خذل ابن عمه وجلس عنه فقد قالوا اني سامر واني كاهن وغي كذاب واما قولك تبتغي الفضل من الله فلك ابي اسوة اي حيث تخلفت عن بعض مواطن القتال اما ترضي ان تكون مني بمنزلة هرون من موسي عليهما السلام اي ولم يتخلف عنه علي كرم الله وجهه في مشهد من المشاهد الا في هذه الغزوة
 وادعت الرافضة والشيعة ان هذه من النص التفصيلي علي خلافة علي كرم الله وجهه  قالوا لانه جميع المنازل الثابتة لهرون من موسي سوي النبوة ثابتة لعلي كرم الله وجهه من النبي صلي الله عليه وسلم والا لما صح الاستثناء اي استثناء النبوة بقوله الا انه لا نبي بعدي ومما ثبت لهرون من موسي عليه السلام استحقاقه للخلافة عنه لو عاش بعده اي دون النبوة
 ورد بان هذ الحديث غير صحيح كما قاله الامدي وعلي تسليم صحته بل صحته هي الثابتة لانه في الصحيحين فهو من قبيل الاحاد وكل من الرافضة والشيعة لا يراه حجة في الامامة وعلي تسليم انه حجة فلا عموم له بل المراد ما دل عليه ظاهر الحديث ان عليا كرم الله وجهه خليفة عن النبي صلي الله عليه وسلم في اهله خاصة مدة غيبته بتبوك كما ان هارون كان خليفة عن موسي في قومه مدة غيبته عنهم للمناجاة فعلي تسليم انه عام لكنه مخصوص والعام المخصوص غير حجة في الباقي او حجة ضعيفة وقد استخلف صلي الله عليه وسلم في مرار اخري غير علي فيلزم ان يكون مستحقا للخلافة وصار بعد مسيره صي يتخلي عنه الرجل فيقال تخلف فلان فيقول دعوه فان يك فيه خير فسيلحقه الله بكم وان يك غير ذلك فقد اراحكم الله منه
 وكان ممن تخلف عن مسيره معه صلي الله عليه وسلم ابو خيثمة ولما ان سار صلي الله عليه وسلم اياما دخل ابو خيثمة علي اهله في يوم حار فوجد امراتين له في عريشيتين لهما في حاءط قد رشت كل منهما عريشتها وبردتا فيها ماء وهياتا طعاما وكان يوما شديد الحر فلما دخل نظر الي امرايته وماصنعتا فقال رضي الله عنه رسول الله صلي الله عليه وسلم في الحر وابو خيثمة في ظل بارد وماء مهيا وامراه حسناء ما هذا بالنصف ثم قال والله لا ادخل عريش واحدة منكما حتي الحق برسول الله صلي الله عليه وسلم فهيءا لي زادا ففعلتا ثم قدم ناضحة فارتحل واخذ سيفه ورمحه كما في الكشاف اي ثم خرج في طلب رسول الله صلي الله عليه وسلم حتي ادركه حين نزل بتبوك وقد كان ابو خيثمة ادرك عمير بن وهب في طريق يطلب رسول الله فترافقا حتي دنوا من تبوك فقال خيثمة لعمير ان لي ذنبا فلا عليك ان تتخلف عن حتي اتي رسول الله صلي الله عليه وسلم ففعل فلما دنا ابو خيثمة قال الناس هذا ركب مقبل فقال رسول الله كن ابا خيثمة فقالوا يا رسول الله هو والله ابو خيثمة فلما اناخ اقبل يسلم علي الرسول الله صلي الله عليه وسلم فقال له رسول الله صلي الله عليه  وسلم اولي لك يا ابا خيثمة ثم اخبر رسول صلي الله عليه وسلم الخبر فقال له رسول الله خيرا ودعا له بخير اي واولي كلمة تهديد وتوعد
 ولما مر رسول الله صلي الله عليه وسلم بالحجر ديار ثمود سجي ثوبه علي راسه واسحث راحلته وقال لا تدخلوا بيوت الذين ظلموا الا وانتم باكون خوفا ان يصيبكم ما اصابهم اي لان البكاء يتبعه التفكر والاعتبار فكانه امرهم بالتفكر في احوال توجب البكاء من تقدير الله عز وجل علي اولءك بالكفر مع تمكينه لهم في الارض وامهالهم مدة طويلة ثم ايقاع نقمته الي مثل ذلك ونهي صلي الله عليه وسلم الناس ان يشربوا من ماءها شيءا وان لا يتوضءوا به للصلاة وان لا يعجن به عجين وان لا يحاس به حيس ولا يطبخ به طعام وان العجين الذي عجن به او الحيس الذي فعل به يعلفونه الابل وان الطبيخ الذي طبخ به يلقي ولا ياكلوا منه شيءا
 ثم ارتحل بالناس اي لا زال ساءرا حتي نزل علي البءر التي كانت تشرب منها الناقة واخبرهم صلي الله عليه وسلم انها تهب عليهم الليلة ريح شديدة اي وقال من كان له بعير فليشد عقاله ونهي الناس في تلك الليلة علي ان يخرج واحد منهم وحده بل معه صاحبه شخص وحده لحاجته فخنق وخرج اخر كذلك في طلب بعير له ند فاحتمله الريح حتي القته بجبل طء فاخبر بذلك رسول الله صلي الله عليه وسلم فقال الم انهكم ان يخرج احد منكم الا ومعه صاحبه ثم دعا للذي خنق فشفي والذي القته الريح بجبل طيء فارسلته طء له صلي الله عليه وسلم حين قدم المدينة
 وفي سيرة الحافظ الدمياطي وكان رسول الله صلي الله عليه وسلم يستخلف علي عسكره ابا بكر الصديق رضي الله عنه يصلي بالناس واستعمل علي حرس العسكر عباد ابن بشر فكان يطوف في اصحابه بن علي العسكر ثم اصبح الناس ولا ماء معهم اي وحصل لهم من العطش ما كاد يقع رقابهم حتي حملهم ذلك علي نحر ابلهم ليشقوا اكراشها ويشربوا ماءها
 فعن عمر رضي الله عنه خرجنا في حر شديد فنزلنا منزلا اصابنا فيه عطش حتي ان الرجل لينحر بعير فيعصر فرثه فيشربه ويجعل ما بقي علي كبده وفي لفظ علي صدره فشكوا ذلك للنبي صلي الله عليه وسلم اي قال له ابو بكر يا رسول الله قد  عودك الله من الدعاء خيرا فادع الله لنا قال اتحب ذلك قال نعم فدعا اي ورفع يديه فلم يرجعهما حتي ارسل الله سحابة فمطرت حتي ارتوي الناس واحتملوا ما يحتاجون اليه قال وذكر بعضهم ان تلك السحابة لم تتجاوز العسكر وان رجلا من الانصار قال لاخر متهم بالنفاق ويحك قد تري فقال انما مطرنا بنوء كذا وكذا فانزل الله تعالي @QB@ وتجعلون رزقكم @QE@ اي بدل شكر رزقكم @QB@ انكم تكذبون @QE@ اي حيث تنسوبه للانواء وقيل انه قال له ويحك هل بعد هذه شء قال سحابة مارة انتهي
 وفي لفظ انهم لما شكوا اليه صلي الله عليه وسلم شدة العطش قال لعلي لو استسقيت لكم فسقيتم قلتم هذه بنوء كذا وكذا فقالوا يا نبي الله ما هذا بحين انواء فدعا رسول الله صلي الله عليه وسلم بماء فتوضا ثم قام فصلي فدعا الله تعالي فهاجت ريح وثار سحاب فمطروا حتي سال كل واد فمر رسول الله صلي الله عليه وسلم برجل يغرف بقدحه ويقول هذه نوء فلان فنزلت الاية
 وضلت ناقته صلي الله عليه وسلم فقال رجل من المنافقين الذين خرجوا معه صلي الله عليه وسلم ليس غرضهم الا الغنيمة ان محمدا يزعم انه بني وانه يخبركم بخبر السماء وهو لا يدري اين ناقته فقال صلي الله عليه وسلم ان رجلا يقول كذا وكذا واني والله لا اعلم الا ما علمني الله وقد دلني الله عليها انها في شعب كذا وكذا وقد حبستها شجرة بزمامها فانطلقوا حتي تاتوني بها فذهبوا فوجدوها كذلك فجاءوا بها اي وتقدم له صلي الله عليه وسلم نظير هذا في غزوة بني المصطلق التي هي المريسيع ولا بعد في تعدد الواقعة ويحتمل ان يكون من خلط بعض الرواة
 ولما سمع بذلك بعض الصحابة جاء الي رحله فقال لمن به والله لعجب في شء حدثناه رسول صلي الله عليه وسلم عن مقاله قاءل اخبره الله عنه وذكر المقالة فقال له بعض من في رحله هذه المقالة قالها فلان يعني شخصا في رحله ايضا قالها قبل ان تاتي بيسير فقال يا عباد الله في رحلي داهية وما اشعر اي عدو الله اخرج من رحلي ولا تصحبني فيقال انه تاب ويقال انه لم يزل منها بشر حتي هلك
 وتباطا جمل ابي ذر رضي الله عنه لما به من الاعياء والتعب فتخلف عن الجيش فاخذ متاعه وحمله علي ظهره ثم خرج يتبع اثر رسول الله ماشيا فادركه نازلا في بعض المنازل اي وقبل مجيءه قالوا له يا رسول الله تخلف ابو ذر وابطا به بعيره  فقال صلي الله عليه وسلم دعوه فان يك فيه خير فسيلحقه الله بكم وان يك غير ذلك فقد اراحكم الله منه
 ولما اشرف علي ذلك المنزل ونظره شخص يمشي فقال يا رسول الله ان هذا الرجل يمشي علي الطريق وحده فقال يا رسول الله صلي الله عليه وسلم كن ابا ذر فلما تامله القوم قالوا يا رسول الله هو والله ابو ذر فقال رسول الله صلي الله عليه وسلم رحم الله ابا ذر يمشي وحده ويموت وحده ويبعث وحده وكان كما قال صلي الله عليه وسلم انه يموت وحده فقد مات رضي الله عنه وحده بالربذة لما اخرجه عثمان رضي الله عنه اليها
 اي فانه بعد موت ابي بكر رضي الله عنه خرج من المدينة الي الشام فلما ولي عثمان رضي الله عنه شكاه معاوية رضي الله عنه اليه فانه كان يغلظ علي معاوية في بعض امور تقع منه فاستدعاه عثمان رضي الله عنه من الشام ثم اسكنه بالربذة ولم يكن معه الا امراته وغلامه فوصاهما عند موته ان غسلاني وكفنانني ثم اجعلاني علي قارعة الطريق فاول من يمر بكم قولا له هذا ابو ذر صاحب رسول الله صلي الله عليه وسلم فاعينوناعلي دفنه فلما مات رضي الله عنه الله عنه فعلا به ذلك واقبل عبد الله بن مسعود في رهط من اهل العراق فوجدوا الجنازة علي ظهر الطريق قد كادت الابل تطءها فقام اليهم الغلام وقال هذا ابو ذر صاحب رسول الله صلي الله عليه وسلم فاعينونا علي دفنه فاستهل عبد الله ابن مسعود يبكي ويقول صدق رسول الله تمشي وحدك وتموت وحدك وتبعث وحدك ثم نزل هو واصحابه فوارواه ثم حدثهم عبد الله بن مسعود خبره
 اي وفي الحداءق عن ام ذر قالت لما حضرت ابا ذر الوفاة بكيت فقال ما يبكيك قلت ومالي لا ابكي وانت تموت بفلاة من الارض ولا بد لنا من معين علي دفنك وليس معنا ثوب يسعك كفنا فقال لا تبكي وابشري فاني سمعت رسول الله صلي الله عليه وسلم يقول لنفر انا فيهم ليموتن رجل منكم بفلاة من الارض يشهده عصابة من المءمنين وليس من اولءك النفر احد الا وقد مات في قرية واني انا الذي اموت بالفلاة والله ما كذب رسول الله صلي الله عليه وسلم ولا كذبت وفي رواية ما كذبت ولا كذبت فانظري الطريق فقالت قد ذهب الحاج وتقعطت السبل فقال انظري فقالت كنت اشتد الي الكثيب فاقوم عليه ثم ارجع اليه فامرضه فبينما انا كذلك اذا انا برجال علي  رواحلهم كانهم الرخم فالحث بثوبي فاسرعوا الي ووضعوا السياط في نحورها يستقبلوا الي فقالوا مالك يا امة الله فقلت امرء من المسلمين يموت تكفنونه قالوا ومن هو قلت ابو ذر قالوا صاحب رسول الله صلي الله عليه وسلم قلت نعم فاسرعوا اليه حتي دخلوا عليه فسلموا عليه فرحب بهم وقال ابشروا فانكم عصابة من المءمنين وحدثهم الحديث وقال والله لو كان لي او لها ما يسعني كفنا ما كفنت الا فيه واني انشدكم الله والاسلام لا يكفنني منكم رجل كان اميرا ولا عريفا ولا بريدا او نقيبا ولم يكن منهم احد سلم من ذلك الا فتي من الانصار فقال والله لم اصب مما ذكرت شيءاان اكفنك في رداءي هذا وثوبين معي من غزل امي فمات فكفنه الفتي الانصاري ودفنه في النفر الذين معه
 اقول يحتاج الي الجمع بين هذا وما تقدم وقد يقال لا ينافي ذلك ما تقدم عن ابن مسعود رضي الله عنه لجواز ان يكون قدومه بعد ان كفن بكفن الانصاري ولا ينافي ذلك ما تقدم من قول الراوي فلما مات فعلا اي زوجته وغلامه ذلك اي غسله وتكفينه ولا ينافي ذلك قول الغلام لابن مسعود ومن معه اعينونا علي دفنه ولا ينافي ذلك قول الراوي هنا ودفنه اي للفتي الانصاري في النفر الذين معه لان ذلك يقال اذا اشتركوا مع غيرهم في ذلك
 وابو ذر رضي الله عنه اسمه جندب وقيل اسمه سلمة بن جنادة وكان من اوعية العلم المبرزين في الزهد والورع بالحق وقد قال في حقه ما اظلت الخضراء ولا اقلت الغبراء من ذي لهجة اصدق من ابي ذر وكان رضي الله عنه من الاقدمين في الاسلام قال ابن عبد البر كان خامس رجل اسلم فليتامل وقال صلي الله عليه وسلم ابو ذر في امتي شبيه عيسي ابن مريم في زهده وبعضهم يرويه من ينظر الي تواضع عيسي ابن مريم فلينظر الي ابي ذر وغلي وجود ما اخبر عن ابي ذر من انه يموت وحده اشار الامام السبكي رحمه الله تعالي في تاءيته بقوله  وعاش ابو ذر كما قلت وحده  ومات وحيدا في بلاده بعيدة  $
 قال وعن المغيرة بن شعبة رضي الله عنه انه قال لما كنا فيما بني الحجر وتبوك ذهب رسول الله صلي الله عليه وسلم لحاجته بعد الفجر وتبعته بماء فاسفر الناس بصلاتهم التي هي صلاة الفجر فقدموا عبد الرحمن بن عوف رضي الله عنه فصلي بهم فانتهي صلي الله عليه  وسلم بعد ان توضا ومسح خفيه بن عوف وقد صلي ركعة فصلي رسول الله مع عبد الرحمن ركعة وقام لياتي بالركعة الثانية وقال لهم صلي الله عليه وسلم بعد فراغه احسنتم او اصبتم ثم قال صلي الله عليه وسلم لم يتوف نبي حتي يءمه رجل صالح من امته ا ه اي ولعل هذا لا ينافي ما تقدم
 وكان رسول الله صلي الله عليه وسلم يستخلف علي عسكره اباابكر الصديق رضي الله عنه يصلي بالناس وقوله لم يتوف نبي حتي يءمه رجل صالح من امته يقتضي انه صلي الله عليه وسلم لم يصل خلف الصديق في هذه الغزوة حيث يصلي بالعسكر فليتامل
 اي وجاء انه صلي الله عليه وسلم قال عبد الرحمن سيد من سادات المسلمين ولا يخالف هذا ماروي عن ابن عباس رضي الله عنهما لم يصل النبي صلي الله عليه وسلم خلف احد من امته الا خلف ابي بكر اي في فرض موته لان المراد صلاة كاملة او تكرر الصلاة هذا
 وفي الخصاءص الصغري ومن خصاءصه صلي الله عليه وسلم فيما حكي القاضي عياض رحمه الله انه لا يجوز لاحد ان يءمه صلي الله عليه وسلم لانه لا يصح التقدم بين يديه في الصلاة ولا غيرها لا لعذر ولا لغيره
 وقد نهي الله المءمنين عن ذلك ولا يكون احد شافعا له وقد قال اءمتكم شفعاءكم ولذلك قال ابو بكر رضي الله عنه ما كان لابن ابي قحافة ان يتقدم بين يدي رسول الله صلي الله عليه وسلم فليتامل
 ولما نزلوا تبوك وجدوا عينها قليلة الماء فاعترف رسول الله صلي الله عليه وسلم بيده غرفة من ماءها فمضمض بها فاه ثم بصقه فيها ففارت عينها حتي امتلات
 قال وعن حذيفة رضي الله عنه بلغ رسول الله ان في الماء قلة اي ماء عين تبوك اي وقد قال لهم صلي الله عليه وسلم انكم لتاتون غدا ان شاءاله تعالي عين تبوك وانكم لن تنالوها حتي يضحا النهار فمن جاءها فلا يمس من ماءها شيءا حتي اتي وامر مناديا ينادي بذلك فجءناها فاذا العين مثل الشراك تبض من ماءها وقد سبق اليها رجلان اي من المنافقين ومسا من ماءها فسبهما رسول الله صلي الله عليه وسلم لما بلغه ذلك وفي رواية سبق اليها اربعة من المنافقين ثم انهم غرفوا من تلك العين قليلا قليلا حتي اجتمع شءفي شن فغسل رسول الله صلي الله عليه وسلم وجهه ويديه ومضمض ثم اعاده فيها فجرت العين بماء كثير وفي رواية فجعلوا فيها سهاما  دفعها صلي الله عليه وسلم لهم فجاشت بالماء والي ذلك اشار الامام السبكي رحمه الله تعالي في تاءيته بقوله  فيوما بوقع النيل جءت بشربهم  ويوما بوقع الوبل جدت بسقية  $
 وحينءذ اي وحين اذ ثبت انه صلي الله عليه وسلم جعل السهام في عين تبوك يسقط الاعتراض بان وقع النبل لم يكن بتبوك وانما كان بالحديبية علي ان الذي بالحديبية انما هو غرز سهم واحد لا سهام فليتامل
 ثم قال صلي الله عليه وسلم لمعاذا يا معاذ يوشك ان طالت بك حياة ان تري ما هنا ملء جنانا اي بستانين وذكر ابن عبد البر رحمه الله عن بعضهم قال انا رايت ذلك الموضع كله حوالي تلك العين جنانا خضرة نضرة
 وقبل قدومهم تبوك نام رسول الله صلي الله عليه وسلم فلم يستيقظ حتي كادت الشمس قيد رمح اي وقد كان صلي الله عليه وسلم قال لبلال اكلا لنا الفجر فاسند بلال ظهره الي راحلته فغلبته عيناه قال الم اقل لك يا بلال اكلا لنا الفجر وفي رواية ان بلالا رضي الله عنه قال لهم ناموا وانا اوقظكم فاضطجعوا فقال له رسول الله صلي الله عليه وسلم يا بلال اين ما قلت قال يا رسول الله ذهب بي مثل الذي ذهب بك اي وفي لفظ اخذ بنفسي الذي اخذ بنفسك وقال صلي الله عليه وسلم للصديق ان الشيطان صار يهدء بلالا للنوم كما يهدء الصبي حتي ينام ثم دعا رسول الله صلي الله عليه وسلم بلالا وساله عن سبب نومه فاخبر النبي صلي الله عليه وسلم بما اخبر به النبي الصديق فقال الصديق للنبي صلي الله عليه وسلم اشهد انك رسول الله فانتقل رسول الله صلي الله عليه وسلم من منزله غير بعيد ثم صلي وتقدم في خيبر اي في غزوة وادي القري فانها كانت عند منصرفه من خيبر الخلاف في اي غزوة كان وسار صلي الله عليه وسلم مسرعا بقية يومه وليلته فاصبح بتبوك
 وفي منصرفه من تبوك قال ابو قتادة رضي الله عنه بينا نحن نسير مع رسول الله وهو قافل من تبوك وانا معه اذ خفق خفقه هو علي راحلته فمال علي شقه فدنوت منه فدعمته فانتبه فقال من هذا فقلت ابو قتادة يا رسول الله خفت ان تسقط فدعمتك فقال حفظك الله كما حفظت رسوله ثم سار غير كثير ثم فعل مثلها  فدعمته فانتبه فقال يا ابا قتادة هل لك في التعريس فقلت ما شءت يا رسول الله فقال انظر من خلفك فنظرت فاذا رجلان او ثلاثة فقال ادعهم فقلت اجيبوا رسول الله صلي الله عليه وسلم فجاءوا فعرسنا
 وفي رواية قال ابو قتادة رضي الله عنه بينا رسول الله صلي الله عليه وسلم يسير حتي ابهار الليل وانا الي جنبه فنعمس فمال عن راحلته فاتيته فدعمته من غيران اوقظه حتي اعتدل علي راحلته ثم سار حتي تهور الليل مال عن راحلته فدعمته حتي اعتدل علي راحلته ثم سار حتي اذا كان من اخر السحر مال ميلة هي اشد من الميلتين الاولتين حتي كاد يسقط فاتيته فدعمته فرفع راسه فقال من هذا قلت ابو قتادة قال متي كان هذا مسيرك مني قلت ما زال هذا مسيري منذ الليلة قال حفظك الله نبيه وهذا تقدم في منصرفه من خيبر ولا مانع من التعدد ويحتمل ان هذا خلط وقع من بعض الرواة فليتامل ثم قال صلي الله عليه وسلم هل تري من احد يعني من الجيش قلت هذا راكب ثم قلت هذا راكب اخر حتي اجتمعنا وكنا سبعة وفي رواية خمسة برسول الله صلي الله عليه وسلم فمال رسول الله صلي الله عليه وسلم عن الطريق ثم قال احفظوا علينا صلاتنا وكان اول من استيقظ رسول الله صلي الله عليه وسلم والشمس في ظهره فقمنا فزعين ثم قال اركبوا فركبنا فسرنا حتي ارتفعت الشمس ثم دعا بميضاة كانت معي فيها شء من ماء فتوضا منها وبقي فيها شء وفي رواية جرعة من ماء ثم قال لي احفظ علينا ميضاتك وفي رواية ازدهر بها يا ابا قتادة فسيكون لها نبا الحديث
 وفي رواية ماايقظنا الاحر الشمس فقلنا انا لله فاتنا الصبح فقال رسول الله صلي الله عليه وسلم لنغيظن الشيطان كما غاظنا فتوضا من الاداوة التي هي الميضاة فضل فضل فقال يا ابا قتادة احتفظ بما في الاداو واحتفظ بالركوة فان لهما شانا فصلي بنا رسول الله صلي الله عليه وسلم الفجر بعد طلوع الشمس وفي لفظ ان عمر رضي الله عنه هو الذي ايقظ النبي صلي الله عليه وسلم بالتكبير
 اقول ظاهر هذه الرواية انهم صلوا بمحلهم ولم ينتقلوا وفي رواية قال لهم صلي الله عليه وسلم تحولوا عن مكانكم الذي اصابتكم فيه الغفلة وفي لفظ ارتحلوا فان هذا منزل حضرنا فيه الشيطان 
 وفي البخاري عن عمران بن حصين رضي الله عنه قال كنا في سفر مع النبي صلي الله عليه وسلم وانا اسرينا حتي كنا في اخر الليل وقعنا وقعة ولا وقعة احلي عند المسافر منها فما ايقظنا الا حر الشمس وكان صلي الله عليه وسلم اذا نام لم نوقظه حتي يكون هو يستيقظ لانا لا ندري ما يحدث له صلي الله عليه وسلم في نومه اي من الوحي فكانوا يخافون من ايقاظه قطع الوحي كما تقدم في غزوة بني المصطلق فلما استيقظ عمر رضي الله عنه وراي ما اصاب الناس اي من فوات صلاة الصبح كبر ورفع صوته بالتكبير فما زال يكبر ويرفع صوته بالتكبير حتي استيقظ النبي صلي الله عليه وسلم
 وفي رواية ان الصديق رضي الله عنه استيقظ اولا ثم لا زال يسبح ويكبر حتي استيقظ عمر ولا زال يكبر حتي استيقظ رسول الله صلي الله عليه وسلم فلما استيقظ شكوا اليه الذي اصابهم اي من فوات صلاة الصبح قال لا ضير ارتحلوا فارتحلوا فسار غير بعيد ثم نزل فدعا بالوضوء فتوضا ونودي بالصلاة فصلي بالناس وهذا كما نري فيه التصريح بان هاتين اليقظتين وقعتا في غزوة تبوك الاولي عند ذهابهم لها والثانية عند منصرفهم منها
 وفي دلاءل النبوة للبيهقي عن بعض الصحابة وبعد ان صلينا وركبنا جعل بعضنا يهمس الي بعض ما كفارة ما صنعنا بتفريطنا في صلاتنا فقال النبي صلي الله عليه وسلم ما هذا الذي تهمسون دوني فقلنا يا رسول الله بتفريطنا في صلاتنا قال اما لكم في اسوة حسنة ثم قال ليس في النوم تفريط انما التفريط علم من لم يصل الصلاة حتي يجء وقت الاخري
 وفي فتح الباري اختلف في تعيين هذا السفر ففي مسلم انه كان في رجوعهم من خيبر قريب من هذه القصة وفي ابي داود اقبل النبي صلي الله عليه وسلم من الحديبية ليلا فنزل فقال من يكلءنا فقال بلال انا الحديث وفي مصنف عبد الرزاق ان ذلك كان بطريق تبوك
 وقد اختلف العلماء هل كان ذلك اي نومهم عن صلاة الصبح مرة او اكثر فجزم الاصيلي رحمه الله بان القصة واحدة
 وتعقبه القاضي عياض رحمه الله بان قصة ابي قتادة مغايرة لقصة عمران بن حصين ومما يدل علي تعدد القصة اختلاف مواطنها 
 وفي الطبراني قصة شبيهة بقصة عمران وان الذي كلام لهم الفجر ذو مخبر قال ذو مخبر فما ايقظني الا حر الشمس فجءت ادني القوم فايقظته وايقظ الناس بعضهم بعضا حتي اسيتقظ النبي صلي الله عليه وسلم فليتامل وتقدم علي الامتاع قال عطاء بن يسار ان ذلك كان بتبوك وهذا لا يصح والا فالاثار الصحاح علي خلاف مقولة مسندة ثابتة والله اعلم
 واستشكل ذلك بقوله صلي الله عليه وسلم نحن معاشر الانبياء تنام اعيننا ولا تنام قلوبنا وقوله صلي الله عليه وسلم لعاءشة وقد قالت له اتنام قبل ان توتر قال تنام عيني ولا ينام قلبي
 واجيب عنه باجوبه حسنها ان القلب انما يدرك الحسيات المتعلقة به كالحدث والالم لا يدرك ما يتعلق بالعين كرءية الشمس وطلوع الفجر
 ومن الاجوبة انه صلي الله عليه وسلم كان له نومان نوم تنام فيه عينه وقلبه ونوم تنام فيه عينه فقط وينبغي ان يكون هذا الثاني اغلب احواله وان كان الانبياء عليهم الصلاة والسلام مثله في ذلك ويكون قوله صلي الله عليه وسلم نحن معاشر الانبياء تنام اعيننا ولا تنام قلوبنا اي غالبا ويكون هذا حاله داءما وابدا اذا كان متوضءا لقولهم انه لا ينقض وضوءه صلي الله عليه وسلم بالنوم وفي جعله العين محلا للنوم نظر لان العين انما هي محل السنة ومحل النعاس الراس ومحل النوم القلب
 قال الحافظ السيوطي وكون القلب محلا للنوم دون العين لا يشكل عليه قوله صلي الله عليه وسلم تنام عيناي ولا ينام قلبي لانه من باب المشاكلة وفيه بحث هذا كلامه
 واستشكل قوله صلي الله عليه وسلم ارتحلوا فان هذا منزل حضرنا فيه الشيطان وفي لفظ ارتحلوا فان هذا واد به الشيطان بانه يقتضي تسلط الشيطان علي النبي صلي الله عليه وسلم لان الظاهر ان وجود الشيطان هو السبب في النوم عن الصلاة
 واجيب بانه علي تسليم ذلك فان تسليطه انما كان علي من كان يحفظ الفجر بلال او غيره ففي بعض الروايات كما تقدم ان الشيطان اتي بلالا فلم يزل يهدءه كما يهدا الصبي حتي نام
 ثم لحق صلي الله عليه وسلم بالجيش وقبل لحوقه صلي الله عليه وسلم بهم قال لاصحابه ما ترون الناس يعني الجيش فعلوا قالوا الله ورسوله اعلم فقال صلي الله عليه وسلم واطاعوا ابا بكر وعمر ورشدوا وذلك ان ابا بكر وعمر رضي الله عنهما ارادا ان ينزلا  بالجيش علي الماء فابوا ذلك عليهما فنزلا علي الماء فابوا ذلك عليهما فنزلا علي غير ماء بفلاة من الارض لاماء بها عند زوال الشمس وقد كادت اعناق الخيل والركاب تقطع عطشا فدعا رسول صلي الله عليه وسلم وقال اين صاحب الميضاة قيل هو ذايار رسول الله قال جءني بميضاتك فجاءه بها وفيها شء من ماء وفي رواية دعا رسول الله صلي الله عليه وسلم بالركوة فافرغ ما في الادواة فيها ووضع اصابعه الشريفة عليها فنبع الماء من بين اصابعه واقبل الناس فاستقوا وفاض الماء حتي رووا ورووا خيلهم وركابهم وكان في العسكر من الخيل اثنا عشر الف فرس اي علي ما تقدم ومن الابل خمسة عشر الف بعير والناس ثلاثون الفا وقيل سبعون الفا وواضح ان هذه العطشة غير المتقدمة التي دعا فيها رسول الله صلي الله عليه وسلم فنزل المطر
 وفي كلام بعضهم انه لما حصل للقوم العطس ارسل صلي الله عليه وسلم نفرا ويقال عليا والزبير يستعرضون الطريق واعلمهم ان عجوزا تمر بهم في محل كذا علي ناقة معها سقاء ماء فقال لهم صلي الله عليه وسلم اشتروا منها بما عز وهان واءتوا بها مع الماء فلما بلغوا المكان اذا بالمراة ومعها السقاء وفي رواية اذا نحن بامراة سادلة رجلها بين مزادتين فسالوها في الماء فقالت انا واهلي احوج اليه منكم فسالوها ان تاتي رسول الله صلي الله عليه وسلم مع الماء فابت وقالت من هو رسول الله لعله الساحر وفي رواية الذي يقال له الصابء وخير الاشياء اني لا اتيه فشدوها وثاقا واتوا بها الي رسول الله فقال لهم خلوا عنها وفي رواية قلنا لها اي الماء قالت اهاه اهاه لا حالكم بينكم وبين الماء مسيرة يوم وليلة ثم قال لها رسول الله صلي الله عليه وسلم اتاذنين لنا في الماء ولتصيبن ماءك كما جءت به فقالت شانكم فقال رسول الله صلي الله عليه وسلم لابي قتادة هات الميضاة فقربت اليه فحل السقاء وتفل فيه وصب في الميضاة ماء قليلا ثم وضع يده الشريفة فيه ثم قال ادنوا فخذوا فجعل الماء يفور ويزيد والناس ياخذون حتي ما تركوا معهم اناء الا ملاوه ورووا ابلهم وخيلهم وبقي في الميضاة ثلثاها والميضاة هي الاداوة لانها يتوضا منها وفي الدلاءل للبيهقي فجعل في اناء من زادتيها ثم قال فيه ما شاء الله ان يقول زاد في رواية ثم مضمض ثم رد الماء في المزادتين واوكا افواههما واطلق العزالي ثم امر الناس ان يملءوا انيتهم واسقيتهم ثم قال لها تعلمي والله ما رزانا من ماءك شيءا ولكن الله عز وجل هو الذي سقانا  والعزالي جمع عزلاء والعزلاء هي التي تجعل في فم القربة لينزل فيها الماء من الراوية وهي المرادة بالمزادة وهذالسياق يدل علي ان هذه عطشة ثالثة لان الثانية وضع علي صلي الله عليه وسلم يده في الركوة التي صب فيها من الميضاة وهذه وضع يده في الميضاة بعد ان لم يجدوا في الميضاة شيءا
 وفي رواية ان تلك المراة اخبرته انها مءتمة اي لها صبيان ايتام فقال هاتوا ما عندكم فجمعنا من كسر وتمروصرتها صرة ثم قال لها اذهبي فاطمعي هذا عيالك
 وفي رواية ايتامك وصارت تعجب مما رات ولما قدمت علي اهلها قالوا لها لقد احتبست علينا قالت حبسني اني رايت عجبا من العجب ارايتم مزادتي هاتين فوالله لقد شرب منهما قريب من سبعين بعيرا واخذوا من القرب والمزاد والمطاهر مالا احصي ثم هما الان اوفر منهما يومءذ فلبثت شهرا عند اهلها ثم اقبلت في ثلاثين راكبا علي رسول الله صلي الله عليه وسلم فاسلمت واسلموا
 وفي مسلم لما كان يوم غزوة تبوك اصاب الناس مجاعة بحيث صارت تمص التمرة الواحدة جماعة يتناوبنها فقالوا يا رسول الله لو اذنت لنا فننحر نواضحنا فاكلنا وادهنا فقال عمر رضي الله عنه يا رسول الله فيها بالبركة لعل الله ان فعلت فتي الظهر ولكن ادعهم بفضل ازوادهم وادع الله لهم فيها بالبركة لعل الله ان يجعلها في ذلك فقال رسول الله صلي الله عليه وسلم نعم فدعا بنطع فبسطه ثم دعاهم بفضل ازوادهم فجعل الرجل ياتي بكف ذره ويجء الاخر بكف من تمر ويجء الاخر بكسرة حتي اجتمع علي النطع من ذلك شء يسير فدعا رسول الله بالبركة ثم قال لهم خذوا في اوعيتكم فاخذوا حتي ما تركوا في العسكر وعاء الا ملءوه واكلوا حتي شعبوا وفضلت فضلة فقال رسول الله صلي الله عليه وسلم اشد ان لا اله الا الله واني رسول الله لا يلقي الله بها عبد غير شاك فيحجب عن الجنة وفي رواية الا وقاه الله النار وتقدم نظير ذلك في الرجوع من غزة الحديبية اي ولا مانع من التعدد او هو من خلط بعض الرواة ولعل هذا كان بعد ان ذبح لهم طلحة بن عبيد الله جزورا فاطعمهم واسقاهم فقال له رسول الله صلي الله عليه وسلم انت طلحة الفياض وسماه يوم احد طلحة الخير ويوم حنين طلحة الجود لكثرة انفاقة علي العسكر رضي الله عنهم
 وعن بعض الصحابة رضي الله عنهم قال كنت في غزوة تبوك علي نحي السمن  فنظرت الي النحي وقد قل مافيه وهيات النبي صلي الله عليه وسلم طعاما ووضعت النحي في الشمس ونمت فانتبهت بخرير النحي فقمت فاخذت راسه بيدي فقال رسول الله صلي الله عليه وسلم وقد راي لو تركته لسال الوادي سمنا
 وعن العرباض بن سارية رضي الله عنه قال كنت مع رسول الله صلي الله عليه وسلم بتبوك فقال ليلة لبلال هل من عشاء فقال والذي بعثك بالحق لقد نفضنا جربنا فقال انظر عسي ان تجد شيءا فاخذ الجرب ينفضها جرابا جرابا فتقع التمرة والتمرتان حتي رايت في يده صلي الله عليه وسلم سبع تمرات ثم دعا بصحفة فوضع التمر فيها ثم وضع يده الشريفة علي التمرات وقال كلوا بسم الله فاكلنا ثلاثة انفس واحصيت اربعا وخمسين تمرة اعدها عدا ونواها في يدي الاخري وصاحباي يصنعان كذلك فشبعنا ورفعنا ايدينا فاذا التمرات السبع كما هي فقال يا بلال ارفعها فانه لا ياكل منها احد الا نهل شبعا فلما كان من الغد دعا صلي الله عليه وسلم بلالا بالتمرات فوضع صلي الله عليه وسلم يده الشريفة عليهن ثم قال كلوا بسم الله فاكلنا حتي شبعنا وانا لعشرة ثم رفعنا ايدينا واذا التمرات كما هي قال رسول الله صلي الله عليه وسلم لولا ان استحي من ربي لاكلنا من هذه التمرات حتي نرد الي المدينة من اخرنا فاعطاهن غلاما فولي وهو يلوكهن
 واتاه صلي الله عليه وسلم وهو بتبوك يحنة بضم المثناة تحت وفتح الحاء المهملة ثم نون مشددة مفتوحة ثم تاء التانيث ابن رءبة بالموحدة صاحب ايلة وصحبته اهل جرباء تانيث اجرب يمد ويقصر قرية بالشام واهل اذرح بالذال المعجمة والراء المهملة المضمومة والحاء المهملة مدينة تلقاء السراة واهل ميناء واهدي يحنة لرسول الله صلي الله عليه وسلم بغلة بيضاء فكساه رسول الله صلي الله عليه وسلم بردا فصالح رسول الله صلي الله عليه وسلم علي اعطاء الجزية اي بعد ان عرض عليه الاسلام فلم يسلم
 وكتب له صلي الله عليه وسلم ولاهل ايلة كتابا صورته بسم الله الرحمن الرحيم هذا امنة من الله ومحمد النبي رسول الله لحينه بن رءية واهل ايلة سفنهم وسيارتهم في البر والبحر لهم ذمة الله ومحمد النبي ومن كان معهم من اهل الشام واهل اليمن واهل البحر فمن احدث منهم حدثا فانه لا يحوز ماله دون نفسه وانه لطيبة لمن اخذه من الناس وانه لا يحل ان يمنعوا ماء يردونه ولا طريقا يريدونه من بر او بحر  وكتب صلي الله عليه وسلم لاهل اذرح وجرباء ما صورته بسم الله الرحمن الرحيم هذا كتاب من محمد النبي صلي الله عليه وسلم لاهل اذرح وجرباء انهم امنون بامان الله وامان محمد وان عليهم ماءة دينار في كل رجب وافية طيبة والله كفيل بالنصح والاحسان الي المسلمين وصالح صلي الله عليه وسلم اهل ميناء علي ربع ثمارهم
 وعن ابن مسعود رضي الله عنه قال رايت ونحن بتبوك شعلة من نار في ناحية العسكر اي ضوء شمعة كما صرح به الجلال السيوطي رحمه الله حيث اجاب من ساله هل الشمع كان موجودا قبل البعثة وهل وقد عنده صلي الله عليه وسلم بانه كان موجودا قبل البعثة فقد ذكر العسكري رحمه الله في الاواءل ان اول من اوقده جزيمة الابرش اي وقد تقدم وهو قبل البعثة بدهر وورد في حديث انه اوقد للنبي صلي الله عليه وسلم عند دفنه عبد الله ذا البجادين قال وقد الفت في المسالة تاليفا سميته مسامرة السموع في ضوء الشموع قال ابن مسعود رضي الله تعالي عنه فاتبعتها انظر اليها فاذا رسول الله صلي الله عليه وسلم وابو بكر وعمر واذا عبد الله ذو البجادين المزني قد مات واذا هم قد حفروا له ورسول الله صلي الله عليه وسلم في حفرته وابو بكر وعمر يدليانه وهو يقول ادليا الي اخاكما فادلياه اليه فلما هياه لشقه قال اللهم قد امسيت راضيا عنه فارض عنه يقول ابن مسعود يا ليتني كنت صاحب الحفرة اي والبجاد بموحدة ككتاب الكساء المخطط الغليظ لانه لم يكن لعبد الله المذكور الا بجاد واحد فشقه نصفين فاتزر بواحد وارتدي بالاخر وقدم المدينة واسلم وقرا قرانا كثيرا وكان اسمه عبد العزي فسماه رسول الله صلي الله عليه وسلم عبد الله
 ولما خرج رسول الله صلي الله عليه وسلم الي تبوك خرج معه وقال يا رسول الله ادع الله لي بالشهادة فقال صلي الله عليه وسلم اءتني بلحاء شجرة اي بقشرها فاتاه بذلك قربطه علي عضده وقال اللهم حرم دمه علي الكفار قال يا رسول الله ليس هذا ما اردت قال انك اذا اخذتك الحمي فقتلتك فانت شهيد فاخذته الحمي بعد الاقامة بتبوك اياما ومات بها اي وهذا هو المشهور
 وروي عن الادرع الاسلمي وكان في حرس رسول الله صلي الله عليه وسلم قال جءت ليلة احرس رسول الله صلي الله عليه وسلم فاذا رجل ميت فقيل هذا عبد الله ذو البجادين توفي بالمدينة وفرغوا من جهازه وحملوه فقال النبي صلي الله عليه وسلم  ارفقوا به رفق الله بكم فانه كان يحب الله ورسوله قال ابن الاثير وهذا حدث غريب لايعرف الا من هذا الوجه وتقدم
 وعن الحافظ السيوطي رحمه الله لما ذكر انه اوقد للنبي صلي الله عليه وسلم الشمع عند دفنه عبد الله ذا البجادين قال وقد دل ذلك علي اباحة استعماله اي الشمع ولا يعد استعماله اسرافا مع قيام غيره من الادهان مقامه
 واقام صلي الله عليه وسلم بتبوك بضع عشرة ليلة وفي سيرة الحافظ الدمياطي عشرين ليلة يصلي ولم يجاوز تبوك ويحتاج اءمتنا الي الجواب عن ذلك علي تقدير صحته
 قال وقد استشار النبي صلي الله عليه وسلم اصحابه في مجاوزتها فقال له عمر رضي الله تعالي عنه ان كنت امرت بالسير فسر فقال رسول الله صلي الله عليه وسلم لو امرت بالسير لم استشركم فيه فقال يا رسول الله ان للروم جموعا كثيرة وليس بها احد من اهل الاسلام وقد دنونا وقد افزعهم دنوك فلو رجعنا هذه السنة حتي نري او يحدث الله امرا هذا تصريح بان تبوك لم يقع بها مقاتلة ولا حصل فيها غنيمة وبه يرد ما ذكره الزمخشري في فضاءل العشرة انه صلي الله عليه وسلم جلس في المسجد يقسم غناءم تبوك فدفع لكل واحد سهما ودفع لعلي كرم الله وجهه سهمين فقام زاءدة بن الاكوع وقال يا رسول الله اوحي نزل من السماء ام امر من نفسك فقال صلي الله عليه وسلم انشدكم الله هل رايتم في مينمتكم صاحب الفرس الاغر المحجل والعمامة الخضراء بها ذءابتان مرخاتين علي كتفيه بيده حربة قد حمل بها علي الميمنة فازالها قالوا نعم قال هو جبريل عليه الصلاة والسلام وانه امرني ان ادفع سهمه لعلي فقال زاءدة حبذا سهم مسهم وخطب صلي الله عليه وسلم خطبة فيها اما بعد فان احسن الحديث كتاب الله وخير الغني غني النفس وخير الزاد التقوي وراس الحكمة مخافة الله عز وجل والنساء حبالة الشيطان والشباب شعبة من الجنون والسعيد من وعظ بغيره ومن يغفر غفر له ومن يعف يعف الله عنه ومن يصبر علي الرزية يعوضه الله استغفر الله لي ولكم
 واهدي له صلي الله عليه وسلم بعض اهل الكتاب جبنة فدعا بالسكين فسمي الله وقطع واكل ثم انصرف صلي الله عليه وسلم قافلا الي المدينة وكان في الطريق ماء يخرج من وشل قليل جدا فقال رسول الله صلي الله عليه وسلم من سبقنا الي ذلك الماء فلا يسقين منه شيءا حتي ناتيه فسبق اليه نفر من المنافقين فاستقوا ما فيه فلما اتاه رسول الله صلي الله  عليه وسلم وقف عليه فلم يجد فيه شيءا فقال من سقبنا الي هذا الماء فقيل له فلان وفلان وفلان فقال او لم انههم ان يستقوا منه شيءا حتي اتيه ثم لعنهم ودعا عليهم ثم نزل صلي الله عليه وسلم فوضع يده تحت الوشل فصار يصب في يده ما شاء الله ان يصب ثم نضحه ومسح بيده ودعا رسول الله صلي الله عليه وسلم بما شاء ان يدعو به فانخرق من الماء وكان له حس كحس الصواعق فشرب الناس واستقوا حاجتهم منه فقال رسول الله صلي الله عليه وسلم لءن بقيتم او بقي منكم احد لتسمعن بهذا الوادي وقد اخصب ما بين يديه وما خلفه اي وهذا خلاف عين تبوك الذي تقدم له صلي الله عليه وسلم فيها ما يشبه هذا وقوله يا معاذ يوشك ان طالت بك حياة ان تري ههنا ملء جنانا الي اخره لان تلك العين كانت بتبوك وهذا عند منصرفه من تبوك
 قال واجتمع راي من كان معه صلي الله عليه وسلم من المنافقين وهم اثنا عشر رجلا وقيل اربعة عشر وقيل خمسة عشر رجلا علي ان ينكثوا برسول الله صلي الله عليه وسلم في العقبة التي بين تبوك والمدينة فقالوا اذا اخذ في العقبة دفعناه عن راحلته في الوادي فاخبر الله تعالي رسوله بذلك فلما وصل الجيش العقبة نادي منادي رسول الله صلي الله عليه وسلم ان رسول الله صلي الله عليه وسلم يريد ان يسلك العقبة فلا يسلكها احد واسلكوا بطن الوادي فانه اسهل لك واوسع فسلك الناس بطن الوادي وسلك رسول الله صلي الله عليه وسلم العقبة فلما سمعوا بذلك استعدوا وتلثموا وسلكوا العقبة وامر صلي الله عليه وسلم عمار بن ياسر رضي الله تعالي عنه ان ياخذ بزمام الناقة يقودها وامر صلي الله عليه وسلم حذيفة بن اليمان رضي الله تعالي عنهما ان يسوق من خلفه
 وفي الدلاءل عن حذيفة قال كنت ليلة العقبة اخذا بخطام ناقة رسول الله صلي الله عليه وسلم اقود به وعمار بن ياسر يسوقه او انا اسوقه وعمار يقوده اي يتناوبان ذلك فبينا رسول الله صلي الله عليه وسلم يسير في العقبة اذ سمع حس القوم قد غشوه فنفرت ناقة رسول الله صلي الله عليه وسلم حتي سقط بعض متاعه فغضب رسول الله صلي الله عليه وسلم وامر حذيفة ان يردهم فرجع حذيفة اليهم وقد راي غضب رسول الله صلي الله عليه وسلم ومعه محجن فجعل يضرب به وجوه رواحلهم وقال اليكم اليكم يا اعداء الله فاذه هو بقوم ملثمين وفي رواية انه صلي الله عليه وسلم صرخ بهم فولوا مدبرين فعلموا ان رسول الله صلي الله عليه وسلم اطلع علي مكرهم به فانحطوا من العقبة مسرعين الي بطن  الوادي واختلطوا بالناس فرجع حذيفة يضرب الناقة فقال له رسول الله صلي الله عليه وسلم هل عرفت احدا من الركب الذين رددتهم قال لا كان القوم ملثمين والليلة مظلمة
 وعن حمزة بن عمرو الاسلمي رضي الله تعالي عنه انه كان يقول لما سقط متاع النبي صلي الله عليه وسلم واردت جمعة نور لي في اصابعي الخمس فاضاءت حتي جمعت ما سقط حتي ما بقي من المناع شء وفي لفظ ان حذيفة رضي الله تعالي عنه قال لا قال انهم مكروا ليسيروا معي في العقبة فيزحموني فيطرحوني منها ان الله اخبرني بهم وبمكرهم وساخبركما بهم واكتماهم فلما اصبح رسول الله صلي الله عليه وسلم جاء اليه اسيد بن حضير فقال يا رسول الله ما منعك البارحة من سلوك الوادي فقد كان اسهل من سلوك العقبة فقال اتدري ما اراد المنافقون وذكر له القصة فقال يا رسول الله قد نزل الناس واجتمعوا فمر كل بطن ان يقتل الرجل الذي هم بهذا فان احببت بين باسماءهم والذي بعثك بالحق لا ابرح حتي اتيك برءوسهم فقال صلي الله عليه وسلم اني اكره ان يقول الناس ان محمدا قاتل بقوم حتي اذا اظهره الله تعالي بهم اقبل عليهم يقتلهم فقال يا رسول الله هءلاء ليسوا باصحاب فقال رسول الله صلي الله عليه وسلم اليس يظهرون الشهادة ثم جمعهم رسول الله صلي الله عليه وسلم واخبرهم بما قالوه وما اجمعوا عليه فحلفوا بالله ما قالوا ولا ارادوا الذي ذكر فانزل الله تعالي @QB@ يحلفون بالله ما قالوا ولقد قالوا كلمة الكفر @QE@ الاية وانزل الله تعالي @QB@ وهموا بما لم ينالوا @QE@ ودعا عليهم رسول الله صلي الله عليه وسلم فقال اللهم ارمهم بالدبيلة هي سراج من نار يظهر بين اكتافهم حتي ينجم من صدورهم انتهي اي وفي لفظ شهاب من نار يقع علي نياط قلب احدهم فيهلكه
 وفي الامتاع ان النبي صلي الله عليه وسلم هو بتبوك الي نخلة فجاء شخص فمر بينه وبين تلك النخلة بنفسه وفي رواية وهو علي حمار فدعا عليه صلي الله عليه وسلم فقال قطع صلاتنا قطع الله اثره فصار مقعدا وكان يقال لحذيفة رضي الله تعالي عنه صاحب سر رسول الله صلي الله عليه وسلم قال حذيفة نزل رسول الله صلي الله عليه وسلم عن راحلته فاوحي اليه وراحلته باركة فقامت تجر زمامها فلقيتها فاخذت بزمامها  وجءت الي قرب رسول الله صلي الله عليه وسلم فانختها ثم جلست عندها حتي قام النبي صلي الله عليه وسلم فاتيته بها فقال من هذا قلت حذيفة فقال النبي صلي الله عليه وسلم اني مسر اليك سرا فلا تذكرنه اني نهيت ان اصلي علي فلان وفلان وعد جماعة من المنافقين فلما توفي رسول الله صلي الله عليه وسلم كان عمر بن الخطاب رضي الله تعالي عنه من خلافته اذا مات الرجل ممن يظن به انه من اولءك الرهط اخذ بيد حذيفة رضي الله تعالي عنه فقاده الي الصلاة عليه فان مشي معه حذيفة صلي عليه عمر رضي الله تعالي عنه وان انتزع يده من يده ترك الصلاة عليه
 وقال صلي الله عليه وسلم للمسلمين عند انصرافه ان بالمدينة لاقواما ما سرتهم مسيرا ولا قطعتم واديا الا كانوا معكم قالوا يا رسول الله وهم بالمدينة قال نعم حبسهم العذر ثم اقبل رسول الله صلي الله عليه وسلم حتي نزل بذي اوان محل بينه وبين المدينة ساعة من نهار اي وقال البكري اظن ان الراء سقطت من بين الهمزة والواو اي اروان منسوب الي البءر المشهورة
 وحين ننزل صلي الله عليه وسلم اتاه خبر مسجد الضرار فانزل الله تعالي @QB@ والذين اتخذوا مسجدا ضرارا @QE@ الاية اي لاضرار اهل قباء اي فان بني عمرو بن عوف لما بنوا مسجد قباء حسدتهم اخوتهم بنو غنم بن عوف وقالوا نصلي في مربط حمار لا لعمر الله اي لانه كان لا مراة كانت تربط فيه حمارها ولكننا نبني مسجدا ونرسل الي رسول الله فيه ويصلي فيه ابو عامر الراهب اذا قدم من الشام فيثبت لنا الفضل والزيادة علي اخواننا وكان المسلمون في تلك الناحية كلهم يصلي في مسجد قباء جماعة فلما بني هذا المسجد فصرف عن مسجد قباء جماعة وصلوا بذلك المسجد فكان به تفريق للمءمنين فكانوا يجتمعون فيه ويعيبون النبي صلي الله عليه وسلم ويستهزءون به اي وقال ان ابا عامر الراهب الذي سماه النبي صلي الله عليه وسلم فاسقا هو الامر لهم ببناءه فقال لهم ابنوا لي مسجدا واستمدوا ما استطعتم من قوة سلاح فاني ذاهب الي قيصر ملك الروم فاتي بجند من الروم فاخرج محمدا واصحابه من المدينة وانهم لما فرغوا من بناءهم ارسلوا الي النبي صلي الله عليه وسلم ان ياتيهم ويصلي فيه كما صلي الله عليه وسلم في مسجد قباء فهم ان ياتيهم فانزل الله تعالي الاية
 وفي رواية اتوه صلي الله عليه وسلم وهو يتجهز الي تبوك فقالوا يا رسول الله قد  بنينا مسجدا لذي العلة والحاجة والليلة المطيرة والليلة الشاتية وانا نحب انا تاتينا فتصلي لنا فيه وتدعو لنا بالبركة قال اني علي جناح سفر وحال شغل ولو قدمنا ان شاء الله تعالي لاتيناكم فصلينا لكم فيه فلما قفل من السفر وسالوه اتيان المسجد جاءه الخبر من السماء فامر جماعة منهم وحشي قاتل حمزة رضي الله تعالي عنه وقال لهم انطلقوا الي هذا المسجد الظالم اهله فاحرقوه واهدموه علي اصحابه ففعل به ذلك قال وكان ذلك بين المغرب والعشاء ووصل الهدم الي الارض واعطاه صلي الله عليه وسلم لثابت بن ارقم رضي الله تعالي عنه يجعله بيت فلم يولد في ذلك البيت مولود قط وحفر فيه بقعة فخرج منها الدخان ولعل هذا اي جعله بيتا كان بعد ان امر صلي الله عليه وسلم ان يتخذه محلا لالقاء الكناسة والجيفة
 وفي الكشاف ان مجمع بن حارثة كان امامهم في مسجد الضرارا فكلم بنو عمرو بن عوف اصحاب مسجد قباء عمر بن الخطاب رضي الله تعالي عنه في خلافته ان ياذن لمجمع بن حارثة ان يءمهم في مسجدهم فقال لا ولانعمة اليس بامام مسجد الضرار فقال يا امير المءمنين لا تعجل علي فو الله لقد صلت بهم والله يعلم اني لا اعلم ما اضمروا فيه ولو علمت ما صليت معهم فيه وكنت غلاما قارءا للقران وكانوا شيوخا لا يقرءون من القران شيءا فعذره وصدقه وامره بالصلاة بهم
 ولما اشرف رسول الله صلي الله عليه وسلم علي المدينة قال هذه طابة اسكننيها ربي تنفي خبث اهلها كما ينفي الكير خبث الحديد
 ولما راي صلي الله عليه وسلم جبل احد قال هذا احد جبل يحبنا ونحبه وتقدم ما في ذلك في غزوة احد وعن عاءشة رضي الله تعالي عنها ولما قدم رسول الله صلي الله عليه وسلم تلقاه النساء والصبيان يقلن  طلع البدر علينا  من ثنيات الوداع   وجب الشكر علينا  ما دعا لله داع  $
 قال البيهقي رحمه الله وهذا يذكره علماءنا عند مقدمه صلي الله عليه وسلم المدينة من مكة لا انه عند مقدمة المدينة من تبوك هذا كلامه ولا مانع من تعدد ذلك
 ولما دنا صلي الله عليه وسلم من المدينة تلقاه عامة الذين تخلفوا فقال رسول الله صلي الله عليه وسلم لاصحابه لا تكلموا رجلا منهم ولا تجالسوهم حتي اذن لكم فاعرض  عنهم رسول الله صلي الله عليه وسلم حتي ان الرجل ليعرض عن ابيه واخيه انتهي
 اي وعن فضالة بن عبيد ان رسول الله صلي الله عليه وسلم لما غزا عزوة تبوك جهد الظهر جهدا شديد حتي صارا يسوقونه فشكوا اليه صلي الله عليه وسلم ذلك وراهم يسوقونه فوقف صلي الله عليه وسلم في مضيق والناس فيه فنفخ في الظهر وقال اللهم احمل عليها في سبيلها فانك تحمل علي القوي والضعيف والرطب واليابس في البر والبحر فزال ما بها من الاعياء وما دخلنا الا وهي تنازعنا ازمتها
 وجاء ان حية عارضتهم في الطريق عظيمة الخلقة فانحاز الناس عنها فاقبلت حتي وقفت علي رسول الله صلي الله عليه وسلم وهو علي راحلته طويلا والناس ينظرون اليها ثم التوت حتي اعتزلت الطريق فقامت قاءمة فقال رسول الله صلي الله عليه وسلم تدرون من هذا قالوا الله ورسوله اعلم قال هذا احد الرهط الثمانية من الجن الذين وفدوا الي يستمعون القران اي بنخلة عند منصرفه صلي الله عليه وسلم من الطاءف وتقدم الكلام عليه فراي عليه من الحق حين الم رسول الله صلي الله عليه وسلم ببلده ان يسلم عليه وها هو يقرءكم السلام فقال الناس وعليه السلام ورحمة الله
 وقد كان تخلف عنه صلي الله عليه وسلم رهط من المنافقين وكانوا بضعة وثمانين رجلا وتخلف عنه ايضا كعب بن مالك وكان من الخزرج مرارة بن الربيع وهلال بن امية وكانا من الاوس فاما المنافقون فجعلوا يحلفون ويعتذرون فقبل رسول الله صلي الله عليه وسلم منهم علانيتهم ووكل سراءرهم الي الله واستغفر لهم واما الثلاثة فعن كعب بن مالك الخزرجي رضي الله تعالي عنه انه قال لما جءته صلي الله عليه وسلم وسلمت عليه تبسم المغضب وقال لي تعال فجءت حتي جلست بين يديه فقال ما خلفك فصدقته وقلت والله ما كان لي من عذر والله ما كنت قط اقوي ولا ايسر مني حين تخلفت عنك وفي رواية قلت يا رسول الله لو جلست عند غيرك من اهل الدنيا لرايت ان ساخرج من سخطه بعذر ولقد اعطيت جدلا ولكني والله لقدعلمت لءن حدثتك اليوم حديث كذب ترضي به عني ليوشكن الله ان يسخط علي فيه ولءن حدثتك اليوم حديث كذب ترضي به عني ليوشكن الله ان يسخط علي فيه ولءن حدثتك حديث صدق تجد علي فيه اني لارجو فيه عفو الله ما كان لي من عذر فقال رسول الله صلي الله عليه وسلم اما هذا فقد صدق فقم حتي يقضي الله فيك وقال الرجلان  الاخران وهما مرارة بن الربيع وهلال بن امية وكانا ممن شهد بدرا وهما من الاوس مثل قول كعب فقال لهما صلي الله عليه وسلم مثل ما قال لكعب ونهي صلي الله عليه وسلم المسلمين عن كلامهم فاجتنبهم الناس فاما الرجلان فمكثا في بيوتهما يبكيان واما كعب فكان يشهد الصلاة مع المسلمين ويطوف بالاسواق فلا يكلمه احد منهم قال ولما طال ذلك علي من جفوة الناس تسورت جدار حاءط ابي قتادة وهو ابن عمي واحب الناس الي فسلمت عليه والله مارد علي السلام فقلت يا ابا قتادة انشدك الله هل تعلمني احب الله ورسوله فسكت فعدت اليه فنشدته فسكت فعدت اليه فنشدته فقال الله ورسوله اعلم ففاضت عيناي وتوليت حتي تسورت الجدار قال بينما انا امشي بسوق المدينة اذا نبطي من انباط اهل الشام ممن قدم بالطعام يبيعه بالمدينة يقول من يدلني علي كعب بن مالك فطفق اي جعل الناس يشيرون له حتي اذا جاءني دفع الي كتابا من ملك غسان اي وهو الحارث بن ابي شمر او جبلة بن الايهم وكان الكتاب ملفوفا في قطعة من الحرير فاذا فيه اما بعد فانه بلغني ان صاحبك قد جفاك ولم يجعلك الله بدار هوان ولا مضيعة فالحق بنا نواسك فقلت لما قراته وهذا ايضا من البلاء فيممت اي قصدت به التنور فسجرته بها اي القيته فيها اي والانباط قوم يسكنون البطاءح بين العراقين قال حتي اذا مضت اربعون ليلة جاءني رسول الله صلي الله عليه وسلم فقال ان رسول الله صلي الله عليه وسلم يامرك ان تعتزل امراتك فقلت اطقلها ام ماذا قال لا بل اعتزلها ولا تقربها وارسل صلي الله عليه وسلم الي صاحبي اي وهما هلال بن امية ومرارة بن الربيع بمثل ذلك فقلت لامراتي الحقي باهلك فكوني عندهم حتي يقضي الله في هذ الامر فجاءت امراة هلال بن امية رسول الله صلي الله عليه وسلم فقالت يا رسول الله ان هلال بن امية شيخ ضاءع ليس له خادم فهل تكره ان اخدمه فقال صلي الله عليه وسلم لا ولكن لا يقربك قالت والله انه ما به حركة الي شء والله ما زال يبكي منذ كان من امره ما ما كان الي يومه هذا قال كعب فقال بعض اهلي قال في النور الظاهر ان القاءل له امراة لان النساء لم يدخلن في النهي لان في الحديث ونهي المسلمين وهذه الخطاب لا يدخل فيه النساء فدل علي ان المراد الرجال قالت لو استاذنت رسول الله صلي الله عليه وسلم في امراتك كما اذن لامراة هلال بن امية ان تخدمه فقلت لا استاذن فيها رسول الله صلي الله عليه وسلم وما يدريني ما يقول لي رسول الله صلي الله  عليه وسلم اذا استاذنته فيها وانا رجل شاب ثم مضي بعد ذلك عشر ليال حتي كملت خمسون ليلة من حين نهي رسول الله صلي الله عليه وسلم عن كلامنا فلما كان صلاة الفجر صبح تلك الليلة سمعت صوتا فوق جبل سلع يقول باعلي صوته يا كعب بن مالك ابشر فخررت ساجدا وعرفت ان رسول الله صلي الله عليه وسلم قد ادن اي اعم بتوبة الله علينا فلما جاءني الرجل الذي سمعت صوته يبشرني اي وهو حمزة بن عمرو الاوسي نزعت له ثونبي فكسوته اياهما ببشراه والله لا املك غيهما يومءذ واستعرت اي من ابي قتادة رضي الله عنه ثوبين فلبستهما وانطلقت الي رسول الله صلي الله عليه وسلم فتلقاني الناس فوجا فوجا اي جماعة جماعة يهنءوني بالتوبة يقولون ليهنءك توبة الله عليك حتي دخلت المسجد فاذا رسول الله صلي الله عليه وسلم جالس حوله الناس فقام الي طلحة بن عبيد الله يهرول حتي صافحني وهناني والله ما قام الي رجل من المهاجرين غيره ولا انساها لطلحة اي لانه صلي الله عليه وسلم كان اخي بينهما حين قدم المدينة قال كعب فلما سلمت علي رسول الله صلي الله عليه وسلم قال وهو يبرق وجهه من السرور وكان صلي الله عليه وسلم اذا سر استنار وجهه كانه قطعة قمر فلما جلست بين يديه صلي الله عليه وسلم قال ابشر بخير يوم يمر عليك منذ ولدتك امك قلت امن عندك يا رسول الله ام عند الله عز وجل قال لا بل من عند الله فقلت يا رسول الله ان من توبتي ان انخلع من مالي صدقة الي الله والي رسوله قال رسول الله صلي الله عليه وسلم امسك عليك بعض مالك فهو خير لك اي وكان المبشر لهلال بن امية اسعد بن اسد وكان المبشر لمرارة بن الربيع سلطان بن سلامة او سلامة بن وقش
 اي وفي البخاري عن كعب رضي الله عنه فانزل الله توبتنا علي نبيه صلي الله عليه وسلم حين بقي الثلث الاخير من الليل ورسول الله صلي الله عليه وسلم عند ام سلمة وكانت ام سلمة رضي الله عنها محسنة في شاني معينة في امري فقال رسول الله صلي الله عليه وسلم يا ام سلمة تيب علي كعب قالت افلا ارسل اليه فابشره قال اذن يحطمكم الناس فيمنعونكم النوم ساءر الليل حتي اذا صلي رسول الله صلي الله عليه وسلم صلاة الفجر اعلم بتوبة الله علينا وانزل الله تعالي قد تاب الله علي النبي والمهاجرين والانصار الذين اتبعوه في ساعة العسرة الي قوله وكونوا مع الصادقين وقال في حق من اعتذر له صلي الله عليه وسلم @QB@ سيحلفون بالله لكم @QE@ الي قوله @QB@ فان الله لا يرضي عن القوم الفاسقين @QE@  واستشكل نزول الوحي بالقران في بيت ام سلمة بقوله صلي الله عليه وسلم في حق عاءشة رضي الله عنها ما نزل علي الوحي في فراش امراة غيرها واجاب بعضهم بانه يجوز ان يكون ما تقدم في حق عاءشة كان قبل هذه القصة او ان الذي خصت به عاءشة رضي الله عنها نزول الوحي في خصوص الفراش لا في البيت
 وعن ابن عباس رضي الله عنهما في قوله تعالي @QB@ واخرون اعترفوا بذنوبهم @QE@ الاية قال كانوا عشرة ابو لبابة واصحابه تخلفوا عن رسول الله صلي الله عليه وسلم في غزوة تبوك فلما رجع صلي الله عليه وسلم اوثق سبعة منهما انفسهم بسواري المسجد منهم ابو لبابة فلما مر بهم رسول الله قال من هءلاء قالوا ابو لبابة واصحاب له تخلفوا عنك حتي تطلقهم وتغذرهم قال وانا اقسم بالله لا اطلقهم ولا اعذرهم حتي يكون الله هو الذي يطلقهم رغبوا عني وتخلفوا عن الغزو مع المسلمين فلما بلغهم ذلك قالوا ونحن لا نطلق انفسنا حتي يكون الله هو الذي يطلقنا فانزل الله تعالي @QB@ واخرون اعترفوا بذنوبهم @QE@ الاية فعند ذلك اطلقهم رسول الله صلي الله عليه وسلم وعذرهم فجاءوا باموالهم وقالوا يا رسول الله هذه اموالنا فتصدق بها عنا واستغفر لنا فقال صلي الله عليه وسلم ما امرت ان اخذ اموالكم فانزل الله تعالي @QB@ خذ من اموالهم صدقة تطهرهم @QE@ الي قوله @QB@ واخرون مرجون لامر الله اما يعذبهم واما يتوب عليهم @QE@ وهم الذين لم يربطوا انفسهم بالسواري وتقدم ان ابا لبابة رضي الله عنه الله عنه ربط نفسه ببعض سواري المسجد في قصة بني قريظة وعلي هذا فقد تكرر منه ربط نفسه وقد ذكره ابن اسحاق فليتامل ذلك
 ولما قدم صلي الله عليه وسلم من تبوك وجد عويمرا العجلاني رضي الله عنه امراته حبلي اي وهي خولة بنت عمه قيس فلا عن بينهما صلي الله عليه وسلم اي في المسجد بعد العصر وكان قد قذفها بشريك بن سحماء ابن عمه وقال وجدته علي بطنها واني ما قربتها منذ اربعة اشهر فدعا رسول الله صلي الله عليه وسلم عويرما وقال له اتق الله في زوجتك وابنة عمك فلا تقذفها بالبهتان فقال يا رسول الله اقسم بالله اني رايت شريكا علي بطنها واني ما قربتها منذ اربعة اشهر ودعا صلي الله عليه وسلم بالمراة التي هي خولة وقال لها اتقي الله ولا تخبريني الا بما صنعت قالت يا رسول الله ان عويمرا رجل غيور وانه ياتي وشريكا يطيل السهر ويتحدث حملته الغيرة علي ان قال ما قال فدعا شريكا  وقال له ما تقول فقال مثل قول المراة فانزل الله تعالي @QB@ والذين يرمون ازواجهم ولم يكن لهم شهداء الا انفسهم @QE@ الاية فامر رسول الله صلي الله عليه وسلم ان ينادي بالصلاة جماعة فلما صلي العصر اي وقد نودي بذلك واجتمع الناس قال لعويمر قم فقام وقال اشهد الله ان خولة لزاتنية واني لمن الصادقين ثم قال في الثانية اشهد بالله اني رايت شريكا علي بطنها واني لمن الصادقين ثم قال في الثالثة اشهد بالله انها حبلي من غيري واني لمن الصادقين ثم قال في الرابعة اشهد بالله اني ما قربتها منذ اربعة اشهر واني لمن الصادقين ثم قال في الخامسة لعنة الله علي عويمر يعني نفسه ان كان من الكاذبين ثم امره صلي الله عليه وسلم بالقعود وقال لخولة قومي فقامت فقالت اشهد الله ما انا زانية وان عويمرا لمن الكاذبين ثم قالت في الثانية اشهد بالله ما راي شريكا علي بطني وانه لمن الكاذبين ثم قالت في الثالثة اشهد بالله اني لحبلي منه وانه لمن الكاذبين ثم قالت في الرابعة اشهد بالله انه ما راني قط علي فاحشة وانه لمن الكاذبين ثم قالت في الخامسة ان غضب الله علي خولة تعني نفسها ان كان من الصادقين ففرق رسول الله صلي الله عليه وسلم بينهما اي قال له لا سبيل لك عليها وهو دليل لامامنا الشافعي رضي الله تعالي عنه القاءل ان الفرقة بين الزوجين تحصل بنفس التلاعن
 وما جاء في بعض الروايات انه طلقها ثلاثا قبل ان يامره صلي الله عليه وسلم اي بعدم الاجتماع بها فهو محمول علي انه ظن ان التلاعن لا يحرمها عليه فاراد تحريمها بالطلاق فقال هي طالق ثلاثا ومن ثم قال صلي الله عليه وسلم عقب ذلك لا سبيل لك عليها اي لا ملك لك عليها فلا يقع طلاقك ثم قال له صلي الله عليه وسلم ان جاء الولد علي صفة كذا فعويمر صادق وان جاء علي صفة كذا فعويمر كاذب فجاء علي الصفة التي تصدق عويمرا فكان الولد ينسب الي امه
 وفي البخاري ان عويمرا اتي عاصم بن عدي وكان سيد بني عجلان فقال كيف تقولون في رجل وجد مع امراته رجلا ايقتله فتقتلونه ام كيف يصنع سل لي رسول الله صلي الله عليه وسلم فاتي عاصم النبي صلي الله عليه وسلم فساله فكره النبي صلي الله عليه وسلم تلك المسالة وعابها حتي كبر علي عاصم ما سمع من رسول الله صلي الله عليه وسلم فساله عويمر فقال له عاصم لم تاتني بخير قد كره رسول الله صلي الله عليه وسلم المسالة وعابها اي لانه صلي الله عليه وسلم كان يكره المسالة التي لا يحتاج  اليها اي التي لم يكن وقعت لا سيما ان كان فيها هتك ستر مسلم او مسلمة قال عويمر رضي الله عنه لم يكن وقع له مثل ذلك حينءذ ثم اتفق له وقوع ذلك بعد فقال عويمر والله لا انتهي حتي اسال رسول الله صلي الله عليه وسلم عن ذلك فجاءه عويمر وهو وسط الناس فقال يا رسول الله ارايت رجلا وجد مع امراته رجلا ان تكلم جلدتموه وان قتله قتلتموه او سكت سكت علي غيظ فقال رسول الله صلي الله عليه وسلم اللهم افتح وجعل يدعو فنزلت اية اللعان وعند ذلك قال صلي الله عليه وسلم لعويمر قد انزل الله فيك وفي صاحبتك قرانا فاذهب فاءت بها اي وذلك بعد ان ذكر له عويمر قصته
 وفي رواية وقد قضي فيك وفي امراتك فتلاعنا وفيه ان هلال بن امية احد المتخلفين عن تبوك قذف امراته عند النبي صلي الله عليه وسلم بشريك بن سحماء او كانت حاملا فقال النبي صلي الله عليه وسلم البينة زاد في رواية اوحد في ظهرك فقال يا رسول الله اذا راي احدنا علي امراته رجلا يتكلف يلتمس البينة فجعل النبي صلي الله عليه وسلم يقول والا فحد في ظهرك فقال هلال والذي بعثك بالحق اني لصادق فلينزلن الله ما يبرء ظهري من الحد فنزل جبريل عليه السلام اي بعد ان قال صلي الله عليه وسلم اللهم افتح اي بين لنا الحكم فانزل الله تعالي والذين يرمون ازواجهم فارسل صلي الله عليه وسلم الي المراة فجاءت وتلاعنا وعند الخامسة تلكات ونكصت حتي ظن انها ترجع اي لانه صلي الله عليه وسلم قال لها انها اي اللعنة موجبة اي للعذاب في الاخرة وعذاب الدنيا اهون من عذاب الاخرة ثم قالت جاءت به كذا فهو لهلال وان جاءت به كذا فهو لشريك فجاءت به علي الوصف الذي ذكرانه يكون لشريك فقال صلي الله عليه وسلم لولا ما سبق من كتاب الله تعالي لكان لي ولها شان
 وجمهور العلماء علي ان سبب نزول اية اللعان قصة هلال بن امية وانه اول لعان وقع في الاسلام
 وذهب جمع الي ان سبب نزولها قصة عويمر العجلاني لقوله صلي الله عليه وسلم قد  انزل الله فيك وفي صاحبتك قرانا واجيب بان معناه لما نزل في قصة هلال لان ذلك عام في جميع الناس
 قال الامام النووي رحمه الله ويحتمل انها نزلت فيهما جميعا فلعلهما سالا في وقتين متقاربين اي وقال صلي الله عليه وسلم في كل اللهم افتح فنزلت هذه الاية فيهما وسبق هلال باللعان فكان اول من لاعن
 وفي مسلم ان سعد بن عبادة قال يا رسول الله ارايت الرجل يجد مع امراته رجلا ايقتله قال رسول الله صلي الله عليه وسلم وسلم لا قال سعد بلي والذي اكرمك بالحق وفي رواية كلاوالذي بعثك بالحق ان كنت لاعاجله باليف وفي لفظ لضربته بالسيف من غير صفح اي بل اضربه بحده فقال رسول الله صلي الله عليه وسلم
 اسمعوا الي ما يقول سيدكم وليس ذلك من سعد رضي الله عنه ردا عليه صلي الله عليه وسلم وانما هو اخبار عن حاله ومن ثم قال صلي الله عليه وسلم انه لغيور وانا اغير منه والله اغير مني فاخبر صلي الله عليه وسلم عن سعد بانه غيور وانه صلي الله عليه وسلم اغير منه وان الله غير منه صلي الله عليه وسلم ومن ثم جاء في الحديث لا احد اغير من الله من اجل ذلك حرم الفواحش ما ظهر منها وما بطن ولا احب اليه العذر من الله ومن اجل ذلك ارسل مبشرين ومنذرين ولا احب اليه المدح من الله ومن اجل ذلك وعد الجنة ليكثر سءال العباد اياها والثناء منهم عليه
 وفي تفسير الفخر الرازي رحمه الله لا شخص اغير من الله وبه استدل علي جواز اطلاق الشخص علي الله تعالي
 وفي الحلية لابي نعيم رحمه الله عن حذيفة رضي الله تعالي عنه قال قال رسول الله صلي الله عليه وسلم يا ابا بكر ارايت لو وجدت مع ام رومان رجلا ما كنت صانعا قال كنت فاعلا به شرا ثم قال صلي الله عليه وسلم يا عمر ارايت لو وجدت رجلا اي مع زوجتك ما كنت صانعا قال كنت والله قاتله فقرا صلي الله عليه وسلم @QB@ والذين يرمون ازواجهم @QE@ الاية
 وفي الام لامامنا الشافعي رضي الله تعالي عنه عن سعيد بن المسيب رضي الله تعالي عنه ان رجلا من اهل الشام وجد مع امراته رجلا فقتله فرفع الامر الي معاوية رضي الله تعالي عنه فاشكل علي معاوية القضاء فها فكتب معاوية الي ابي موسي الاشعري رضي الله  تعالي عنه ان يسال عن ذلك علي بن ابي طالب كرم الله وجهه فاستخبر علي ابا موسي عن القصة فاخبره ابو موسي ت ان معاوية كتب اليه في ذلك فقال علي كرم الله وجهه انا ابو الحسن ان لم يات باربعة شهداء قتلناه فليتامل
 وفي الخصاءص الكبري ان في غزوة تبوك اجتمع صلي الله عليه وسلم بالياس فعن انس رضي الله تعالي عنه سمعتا صوتا يقول اللهم اجعلني من امة محمد الله عليه وسلم المرحومة المغفور لها المستجاب لها فقال النبي صل يا انس انظر ما هذا الصوت قال انس رضي الله تعالي عنه فدخلت الجبل فاذا رجل عليه ثياب بيض ابيض الراس واللحية طوله اكثر من ثلثماءة ذراع فلما راني قال انت خادم رسول الله صلي الله عليه وسلم قلت نعم قال ارجع اليه واقراه السلام وقل له اخوك الياس يريد ان يلقاك فرجعت الي رسول الله صلي الله عليه وسلم فاخبرته فجاء صلي الله عليه وسلم يمشي وانا معه حتي اذا كنت منه قريبا تقدم النبي صلي الله عليه وسلم وتاخرت انا فتحدثا طويلا فنزل عليما من السماء شء شبه السفرة ودعاني فاكلت معهما قليلا فاذا فيها كماة ورمان وحوت وتمر وكرفس فلما اكلت قمت فتنحيت ثم جاءت سحابة فاحتملته وانا انظر الي بياض ثوبه فيها قال الحافظ ابن كثير هذا حدث موضوع مخالف للاحاديث الصحيحين وهذا مما يستدرك به علي الحاكم الصحاح من وجوه واطال في بيان ذلك والعجيب من الحاكم كيف يستدركه علي الصحيحين وهذا مما يستدرك به علي الحاكم
 وفي النور لم يجء في حديث صحيح اجتماعه صلي الله عليه وسلم بالياس وفي الجامع الصغير الياس اخو الخضر وفي تفسير البغوي اربعة من الانبياء احياء الي يوم البعث اثنان في الارض وهما الخضر والياس اي والياس في البر والخضر في البحر يجتمعان كل ليلة علي ردم ذي القرنين يحرسانه واكلهما الكرفس والكماة واثنان في السماء ادريس وعيسي عليهما الصلاة السلام
 وعن ابن اسحاق الخضر من ولد فارس والياس من بني اسراءيل اي وقد يقال لا ينافي ذلك ما تقدم انهما اخوان لجواز ان يكونا اخوين لام
 قال الحافظ ابن كثير رحمه الله لم ينقل بسند صحيح ولا حسن تسكن اليه النفس ان الخضر عليه الصلاة السلام اجتمع برسول الله صلي الله عليه وسلم في يوم من الايام ولو  كان حيا في زمان رسول الله صلي الله عليه وسلم لكان اشرف احواله اجتماعه به صلي الله عليه وسلم
 وفي الخصاءص الكبري عن انس رضي الله تعالي عنه انه قال خرجت ليلة مع النبي صلي الله عليه وسلم احمل الطهور فسمع قاءلا يقول اللهم اعني علي ما ينجيني مما خوفتني منها فقال رسول الله صلي الله عليه وسلم يا انس ضع الطهور وات هذا فقل له ادع لرسول الله صلي الله عليه وسلم ان يعينه علي ما بعثه به وادع لامته ان ياخذوا ما اتاهم به من الحق فاتيته فقلت له فقال مرحبا برسول الله صلي الله عليه وسلم انا كنت احق ان اتيه اقرا علي رسول الله صلي الله عليه وسلم مني السلام وقل له اخوك الخضر يقرا عليك السلام ويقول لك ان الله فضلك علي النبيين كما فضل شهر رمضان علي الشهور وفضل امتك علي الامم كما فضل يوم الجمعة علي ساءر الايام فلما وليت سمعته يقول اللهم اجلعني من هذه الامة المرحومة المتاب عليها قال بعضهم وهذا حديث واه منكر الاسناد سقيم المتن ولم يراسل الخضر عليه الصلاة والسلام نبينا صلي الله عليه وسلم لم يلقه
 قال السيوطي في اللالء قلت قد اخرج هذا الحديث الطبراني في الاوسط وقال الحافظ ابن حجر رحمه الله في الاصابة قد جاء من وجهين وفي الخصاءص الصغري ومن خصاءصه صلي الله عليه وسلم انه جمعت له الشريعة والحقيقة ولم يكن للانبياء عليهم الصلاة و السلام الا احدهما بدليل قصة موسي مع الخضر عليهما الصلاة و السلام والمراد بالشريعة الحكم بالظاهر وبالحقيقة الحكم بالباطن
 وقد نص العلماء علي ان غالب الانبياء عليهم الصلاة والسلام انما بعثوا ليحكموا بالظاهر دون ما اطلعوا عليه من بواطن الامور وحقاءقها ومن ثم انكر موسي عليه الصلاة والسلام علي الخضر صلي الله عليه وسلم في قتله الغلام بقوله @QB@ لقد جءت شيءا نكرا @QE@ فقال له الخضر عليه الصلاة والسلام @QB@ وما فعلته عن امري @QE@ ومن ثم قال الخضر لموسي عليهما الصلاة والسلام اني علي علم من عند الله لا ينبغي لك ان تعلمه اي تعمل به لانك لست مامورا بالعمل به وانت علي علم من عند الله لا ينبغي لي ان اعلمه اي لا ينبغي لي ان اعمل به لاني لست مامورا بالعمل به
 وفي تفسير ابي حيان والجمهور علي ان الخضر نبي وكان علمه معرفة بواطن امور  اوحيت اليه اي ليعمل بها وعلم موسي عليه الصلاة والسلام الحكم بالظاهر اي دون بالحكم بالباطن
 ونبينا صلي الله عليه وسلم حكم بالظاهر في اغلب احواله وحكم بالباطن اي في بعضها بدليل قتله صلي الله عليه وسلم للسارق وللمصلي لما اطلع علي باطن امرهما وعلم منها ما يوجب القتل
 وقد ذكر بعض السلف رحمه الله ان الخضر الي الان ينفذ الحكم بالحقيقة وان الذين يموتون فجاة هو الذي يقتلهم فان صح ذلك فهو في هذه الامة بطريق النيابة عن النبي صلي الله عليه وسلم فانه عليه الصلاة والسلام صار من اتباعه صلي الله عليه وسلم كما ان عيسي عليه الصلاة والسلام لما ينزل يحكم بشريعته عنه لانه من اتباعه
 وفيه ان عيسي عليه الصلاة والسلام اجتمع به صلي الله عليه وسلم اجتماعا متعارفا ببيت المقدس فهو صحابي وجاء في حديث مطعون فيه اي عن ابن عباس رضي الله تعالي عنهما ان الخضر والياس عليهما الصلاة والسلام يجتمعان في كل عام اي في الموسم ويحلق كل منهما راس صاحبه ويفترقان عن هذه الكلمات بسم الله ما شاء الله لا يسوق الخير الا الله ما شاء الله لا يصرف السوء الا الله ما شاء الله ما يكون من نعمة فمن الله ما شاء الله لاحول ولا قوة الا بالله قال ابن عباس رضي الله تعالي عنهما من قالها حين يصبح وحين يمسي ثلاث مرات عوفي من السرق والحرق والغرق ومن السلطان ومن الشيطان ومن الحية والعقرب
 وعن علي كرم الله وجهه مسكن الخضر بيت المقدس فيما بين باب الرحمة الي باب الاسباط والله اعلم  $ باب سراياه صلي الله عليه وسلم وبعوثه
 لا يخفي ان ما كان فيه رسول الله صلي الله عليه وسلم يقال له غزوة وما خلا عنه صلي الله عليه وسلم يقال له سرية ان كان طاءفة اثنين فاكثر فان كان واحدا قيل له بعث وربما سمعوا بعض السرايا غزوة كما في مءته حيث قالوا غزوة مءته وكما في سرية الرجيع حيث عبر عنها السيوطي في الخصاءص بغزوة الرجيع وعن سرية ذات السلاسل بغزوة ذات السلاسل وعن سرية سيف البحر بغزوة سيف البحر وربما سموا الواحد سرية وهو في الاصل كثير وبما سموا الاثنين فاكثر بعثا ومنه قول الاصل كالبخاري بعث الرجيع وظاهر كلامهم انه لا فرق في ذلك بين ان يكون ارسال ذلك لقتال او لغير قتال كتجسس الاخبار او لتعليمهم الشراءع كما في بءر معونة والرجيع او للتجارة كما في سرية زيد بن حارثة رضي الله تعالي عنهما حيث ذهب مع جمع بالتجارة للشام فلقيه بنو فزراة فضربوه وضربوا اصحابه واخذوا ما كان معهم كما سياتي
 والسرية في الاصل الطاءفة من الجيش تخرج منه ثم تعود اليه خرجت ليلا او نهارا وقيل السرية هي التي تخرج ليلا والسارية هي التي تخرج نهارا وهي من ماءة الي خمسماءة وقيل الي اربعماءة اي وفي القاموس السرية من خمس انفس الي ثلثماءة او اربعماءة وعليه فما دون ذلك لا يقال له سرية فما زاد علي الثلثماءة او اربعماءة الي ثمانماءة يقال له بنسر بالنون فان زاد علي لك الي اربعة الاف قيل له جيش اي وقيل الجيش من الف الي اربعة الاف فان زاد علي ذلك قي له جحفل وجيش جرار اي الي اثني عشر الفا
 والبعث في الاصل الطاءفة تخرج من السرية ثم تعود اليها وهو من عشرة الي اربعين يقال له حفيرة ومن اربعين الي ثلثماءة يقال له معتقب وما زاد علي ذلك يسمي حمزة قال بعضهم والكتيبة ما اجتمع ولم ينتشر وعن ابن عباس رضي الله تعالي عنهما قال رسول الله خير الاصحاب اربعة وخير السريا اربعماءة وخير الجيوش اربعة الاف وما هزم قوم بلغوا اثني عشر الفا من قلة اذا صدقوا وصبروا اي فلا يرد انهزام القدر المذكور يوم حنين قال في الاصل وكانت سراياه صلي الله  عليه وسلم التي بعث بها سبعا واربعين سرية وهو في ذلك موافق لما ذكره ابن عبد البر في الاستيعاب قال الشمس الشامي والذي وقفت عليه من السرايا والبعوث لغير الزكاة يزيد علي السبعين ا ه
 اي وكان صلي الله عليه وسلم اذا امر اميرا علي سرية اوصاه في خاصته بتقوي الله وبمن معه من المسلمين خيرا ثم قال اغزوا بسم الله قاتلوا من كفر بالله ولا تغلوا ولا تغدوا ولا تمثلوا ولا تقتلوا وليدا والوليد الصبي اي مالم يقتل كالنساء ولا قتلوا
 وفي رواية لا تقتلوا شيخا فانيا ولا طفلا صغيرا ولا امراة وهذا عند العمد فلا ينافي انه يجوز الاغارة علي المشركين ليلا وان لزم علي ذلك قتل الصبيان والنساء والشيوخ
 فقد روي الشيخان سءل صلي الله عليه وسلم عن المشركين يبيتون اي يغار عليهم ليلا فيصيبون من نساءهم وذراريهم فقال هم منهم وكان صلي الله عليه وسلم يقول من اطاعني فقد اطاع الله ومن اطاع اميري فقد اطاعني ولا سمع ولا طاعة في معصية الله وكان صلي الله عليه وسلم يعتذر عن تخلفه عن تلك السرايا ويقول والذي نفسي بيده لولا ان رجالا من المءمنين لا تطيب نفوسهم ان يتخلفوا عني ولا اجد ما احملهم عليه ما تخلفت عن سرية تغزو في سبيل الله والذي نفسي بيده لوددت ان اقتل في سبيل الله ثم احيا ثم اقتل ثم احيا ثم اقتل
 من جملة وصيته صلي الله عليه وسلم لمن يوليه علي سرية واذا لقيت عدوك من المشركين فادعهم الي ثلاث خصال فان هم اجابوك فاقبل منهم وكف عنهم ادعهم الي الاسلام فان هم ابوا فاسالهم الجزية فان هم ابوا فاستعن بالله وقاتلهم
 ومن جملة قوله صلي الله عليه وسلم لمن يوليه علي سرية واذا لقيت عدوك من المشركين فادعهم الي ثلاث خصال فان هم اجابوك فاقبل منهم وكف عنهم ادعهم الي الاسلام فان هم ابوا فسالهم الجزية فان هم ابوا فاستعن بالله وقاتلهم
 ومن جملة قوله صلي الله عليه وسلم للسرايا بشروا ولا تنفروا ويسروا ولا تعسروا ولما بعث صلي الله عليه وسلم معاذ بن جبل وابا موسي رضي الله تعالي عنهما الي اليمن قال لهما يسرا ولا تعسرا وبشرا ولا تنفرا وتطاوعا ولا تختلفا $ سرية حمزة بن عبد المطلب رضي الله تعالي عنه
