 قيل سميت ذات الرقاع باسم شجرة كانت في ذلك المحل يقال لها ذات الرقاع او لانهم رقعوا راياتهم او لانهم لفوا علي اقدامهم الخرق لما حصل لهم الحفاء كما تقدم او لان الصلاة رقعت فيها او لان الجبل الذي نزلوا به كانت ارضه ذات الوان تشبه الرقاع فيه بقع حمر وسود وبيض واستغربه الحافظ ابن حجر
 قال الامام النووي رحمه الله ويحتمل انها سميت بالمجموع قال وفي هذه الغزوة جاءته صلي الله عليه وسلم امراة بدوية باني لها فقالت يا رسول الله هذا ابني قد غلبني عليه الشيطان ففتح فاه فبزق فيه وقال اخسا عدو الله انا رسول الله ثم قال صلي الله عليه وسلم شانك بابنك لن يعود اليه شيء مما كان يصيبه اي فكان كذلك 
 وفيها ايضا جاء رجل بفرخ طاءر فاقبل احد ابويه حتي طرح نفسه بين يدي الذي اخذ فرخه فعجب الناس من ذلك فقال رسول الله صلي الله عليه وسلم اتعجبون من هذا الطاءر اخذتم فرخه فطرح نفسه رحمة لفرخه ولله لربكم ارحم بكم من هذا الطاءر بفرخه
 وفيها ايضا جء له صلي الله عليه وسلم بثلاث بيضات من بيض النعام فقال لجابر دونك يا جابر قال جابر فاعمل هذه البيضات رضي الله تعالي عنه فعملتهن ثم جءت بهن في قصعة فجعلنا نطلب خبزا فلم نجد فجعل رسول الله صلي الله عليه وسلم واصحابه ياكلون من ذلك البيض من بغير خبز حتي انتهي كل الي حاجته اي الي الشبع والبيض في القصعة كما هو
 وفيها ايضا جاء جمل يرفل اي حتي وقف عنده صلي الله عليه وسلم وارغي فقال رسول الله صلي الله عليه وسلم اتدرون ماقال هذا الجمل هذا جمل يستعيذ بي علي سيده يزعم انه كان يحرث عليه منذ سنين وانه اراد ان ينحره اذهب يا جابر الي صاحبه فات به قال جابر رضي الله تعالي عنه فقلت لااعرفه قال انه سيدلك عليه قال جابر فخرج بين يدي حتي وقف علي صاحبه فجءته به فكلمه صلي الله عليه وسلم في شان الجمل اه
 وعن عبدالله بن جعفر رضي الله تعالي عنهما ان النبي صلي الله عليه وسلم دخل حاءط رجل من الانصار فاذا جمل فلما راي النبي صلي الله عليه وسلم حين وذرفت عيناه فاتاه النبي صلي الله عليه وسلم فمسح عليه فسكن ثم قال من رب هذا الجمل فجاء فتي من الانصار فقال هذا لي يا رسول الله فقال الا تتقي الله عز وجل في هذ البهيمة التي ملكك الله فانه شكا الي انك تجيعه وتدءبه
 وفي رواية كنا جلوسا مع النبي صلي الله عليه وسلم اذا بعير اقبل حتي وقف علي هامة رسول الله صلي الله عليه وسلم فرغا فقال له النبي صلي الله عليه وسلم ايها البعيراسكن فان تك صادقا فلك صدقك وان تك كاذبا فعليك كذبك ان الله تعالي قد امن عاءدنا ولن يخيب لاءذنا فقلنا يا رسول الله ما يقول هذا البعير قال يريد اهله نحره واكل لحمه فهرب منهم واستغاث بنبيكم فبينما نحن كذلك اذ اقبل اصحابه يتقعادون فلما ظر اليهم البعير عاد الي هامة الرسول صلي الله عليه وسلم فلاذ بها فقالوا يا رسول الله  بعيرنا هرب منذ ثلاثة ايام فلم نجده الابين يديك فقال لهم رسول الله صلي الله عليه وسلم اما انه يشكو فقالوا يا رسول الله ما يقول قال انه ربي فيكم سنين وكنتم تحملون عليه في الصيف الي موضع الكلافاذا كان الشتاء حملتم عليه الي موضع الدفء فلما كبر استفحلتموه فرزقكم الله ابلا سليمة فلما ادركت هذه السنة الجذبة هممتم بنحره واكل لحمه فقالوا والله يا رسول الله قد كا ن ذلك فقال لهم رسول الله صلي الله عليه وسلم ما هذا جزاء المملوك الصالح من مواليه فقالوا لرسول الله صلي الله عليه وسلم انا لا نتعبه ولاننحره فقال رسول الله صلي الله عليه وسلم كذبتم قد استغاث بكم فلم تغيثوه وانااولي بالرحمة منكم لان الله قد نزع الرحمة من قولب المنافقين واسكنها في قولوب المءمنين فاشتراه الرسول صلي الله عليه وسلم منهم بماءة درهم منهم وقال ايها البعير انطلق حيث شءت فرغا البعير علي هامة رسول الله صلي الله عليه وسلم فقال له امين ثم رغا الثانية فقال له امين ثم رغا الثالثة فقال له امين ثم رغا الرابعة فبكي النبي صلي الله عليه وسلم فقلنا يا رسول الله ما يقول هذا البعير قال قال جزاك الله خيرا ايها النبي عن الاسلام والقران قلت امين قال سكن الله رعب امتك كما سكنت قلبي قلت امن قال حقنت الله دماء امتك كما حنت دمي قلت امين قال لا جعل الله باسهم بينهم شديد فبكيت لاني سالت الله ربي فيها اي في هذه الرابعة فمنعني اعطاءها وقوله صلي الله عليه وسلم للجمل اذهب كيف شءت لا يناسب ما عليه اءمتنا من عدم جواز ارسال الدواب تقربا الي الله تعالي لانه في معني سواءب الجاهلية الا ان يقال المراد بقوله صلي الله عليه وسلم له اذهب كيف شءت اي انت امن في ساءر احوالك مما شكوت منه
 ورايت في كلام ابن الجوزي رحمه الله ما يءيد ذلك وهو ان رسول الله لي الله عليه وسلم وسمه سمة نعم الصدقة ثم بعث به وعليه لا اشكال والي قصة الجمل اشار الامام السبكي رحمه الله في تاءيته بقوله  ورب بعير قد شكي لك حاله  فاذهبت عنه كل كل وثقلة  $
 وفي هذه اعني السنة الرابعة تزوج صلي الله عليه وسلم ام سلمة هند رضي الله تعالي عنها بعد موت ابي سلمة بن عبد الاسد رضي الله تعالي عنه وما روي عن ابن عمر رضي الله تعالي عنهما انه قال تزوجها سنة اثنتين ليس بشء قيل وفيها شرع التيمم  $ غزوة بدر الاخرة
 ويقال لها بدر الموعد اي لموعد ابي سفيان رضي الله تعالي عنه حيث قال حين منصرفه من احد موعد ما بيننا وبينكم بدر اي موسمها فقال رسول الله صلي الله عليه وسلم لعمر بن الخطاب رضي الله تعالي عنه قل نعم ان شاء الله تعالي كما تقدم
 لما قدم رسول الله صلي الله عليه وسلم من غزوة ذا الرقاع اقام بقية جمادي الاولي الي اخر رجب ثم خرج رسول الله صلي الله عليه وسلم في شعبان وعليه اقتصر الاصل وقيل خرج في شوال وقيل في مستهل ذي القعدة كل ذلك في سنة اربع ومن الوهم قول موسي بن عقبة رحمه الله انها كانت في شعبان سنة ثلاث لما علمت انها بعداحد واحد كانت في شوال سنة ثلاث والحافظ الدمياطي قدم هذه الغزوة علي غزوة ذات الرقاع وتبعه الشمس الشامي وصاحب الامتاع
 وكان وصوله صلي الله عليه وسلم الي بدر هلال ذي القعدة وهذا لايناسب الاالقول بان خروجه صلي الله عليه وسلم كان في شوال وكان ذلك موسم لبدر في كل سنة يحضره الناس ويقيمون به ثمانية ايام كما تقدمت الحوالة عليه وحين خرج صلي الله عليه وسلم من المدينة استخلف عليها عبد الله بن عبدالله بن ابي ابن سلول رضي الله تعالي عنه وقيل عبد الله بن رواحة رضي الله تعالي عنه وخرج في الف وخمسماءة من اصحابه وكان الخيل عشرة افراس
 وعند تهيء المسلمين للخروج قدم نعيم بن مسعود الاشجعي اي وكان ذلك قبل اسلامه رضي الله تعالي عنه واخبر قريش ان المسلمين تهياوا للخروج لقتالهم ببدر فكره ابو سفيان الخروج لذلك وجعل لنعيم ان رجع الي المدينة وخذل المسلمين عن الخروج لبدر عشرين بعيرا وفي لفظ عشرة من الابل وحمله علي بعير اي وقال له ابو سفيان انه بدا لي ان لا اخرج واكره ان يخرج محمد ولا اخرج انا فيزيدهم ذلك جراءة يكون الخلف منة لهم احب الي من ان يكون من قبلي فالحق بالمدينة واعلمهم انا في جمع كثير ولا طاقة لهم بنا ولك عندي من الابل كذا وكذا ادفعها لك علي يد سهيل بن عمر فجاء نعيم الي سهيل بن عمرو فقال له يا ابا يزيد تضمن لي هذه الابل وانطلق الي محمد واثبطه قال نعم فقدم نعيم المدينة وارجف بكثرة المجموع  ابي سفيان اي وصار يقول فيهم حتي قذف الرعب في قولوب المسليمن ولم يبقي لهم نية في الخروج واستبشر المنافقون اي واليهود وقالو محمد لايفلت من هذا الجمع فجاء ابو بكر وعمر رضي الله تعالي عنهما الي النبي صلي الله عليه وسلم وقد سمعا ما ارجف به المسلمون وقالا له يا رسول الله ان الله مظهر نبيه ومعز دينه وقد وعدنا القوم موعط لا نحب ان نتخلف عنه فيرون ان هذا جبن فسر لموعدهم فوالله ان في ذلك لخيرة فسر رسول الله صلي الله عليه وسلم بذلك ثم قال والذي نفسي بيده لاخرجن وان لم يخرج معي احد فاذهب الله عنهم ما كانوا يجدون وحمل لواء رسول الله صلي الله عليه وسلم علي بن ابي طالب كرم الله وجهه وخرج المسلمون معهم بتجارات الي بدر فربحت الضعف
 ثم ان ابا سفيان قال لقريش لقد بعثنا نعيما ليخذل اصحاب محمد عن الخروج ولكن نخرج نحن فنسيرليلة او ليلتين ثم نرجع فان كان محمد لم يخرج وبلغه انا خرجنا فرجعنا لانه ان لم يخرج كان هذا لنا عليه وان خرج اظهرنا ان هذا عام جدب ولا يصلحنا الا عام عشب قالوا نعم ما رايت فخرج ابو سفيان في قريش اي وهم الفان ومعهم خمسون فرسا حتي انتهوا الي مجنة اي بفتح الميم والجيم وتشديد النون وهو سوق معروف من ناحية مر الظهران وقيل الي عفان ثم قال يا معشر قريش لا يصلحكم الا عام خصب ترعون فيه الشجر وتشربون فيه الماء وان عامكم هذا عام جدب واني راجع فارجعوا فرجع الناس فسماهم اهل مكة جيش السويق يقولون انما خرجتم لتشربوا السويق
 واقام رسول الله صلي الله عليه وسلم علي بدر ينتظر ابا سفيان لميعاده مدة الموسم التي هي ثمانية ايام اي فانه صلي الله عليه وسلم انتهي الي بدر هلال ذي القعدة كما تقدم وقام السوق صبيحة الهلال فاقاموا ثمانية ايام والسوق قاءمة اي وصار المسلمون كلما سالوا عن قريش وقيل لهم قد جمعوا لكم يقولون حسبنا الله ونعم الوكيل حتي قيل لهم لما قربوا من بدر انها قد امتلات من الذين جمعهم ابو سفيان يرعبونهم ويرهبونهم فيقول المءمنون حسبنا الله ونعم الوكيل فلما قدموا بدرا وجدوا اسواقا لا ينازعهم فيها احد فانزل الله تعالي @QB@ الذين قال لهم الناس ان الناس قد جمعوا لكم فاخشوهم فزادهم ايمانا وقالوا حسبنا الله ونعم الوكيل @QE@ فالمراد بالناس الاول نعيم نزل منزلة الجماعة 
