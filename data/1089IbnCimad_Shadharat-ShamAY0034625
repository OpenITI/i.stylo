ع علي كل شء ويري الله عند كل شء فيغيب بالله عن كل شء ولا شيءا سواه فيظن ان الله عين كل شء وهذا اول المقامات فاذا ترقي عن هذا المقام واشرف علي مقام اعلي منه وعضده التاييد الالهي راي ان الاشياء كلها فيض وجوده تعالي لاعين وجوده فالناطق حينءذ بما ظنه في اول مقام اما محروم ساقط واما نادم تاءب وربك يفعل ما يشاء انتهي ولقد بالغ ابن المقري في روضته فحكم بكفر من شك في كفر طاءفة ابن عربي فحكمه علي طاءفته بذلك دونه يشير الي انه انما قصد التنفير عن كتبه وان من لم يفهم كلامه ربما وقع في الكفر باعتقاده خلاف المراد اذ للقوم اصطلاحات ارادوا بها معاني غير المعاني المتعارفة فمن حمل الفاظهم علي معانيها المتعارفة بين اهل العلم الظاهر ربما كفر كما قاله الغزالي ثم قال المناوي وعول جمع علي الوقف والتسليم قاءلين الاعتقاد صبغة والانتقاد حرمان وامام هذه الطاءفة شيخ الاسلام النووي فانه استفتي فيه فكتب ( ^ تلك امة قد خلت لها ما كسبت ولكم ما كسبتم ) الاية وتبعه علي ذلك كثيرون سالكين سبيل السلامة وقد حكي العارف زروق عن شيخه النوري انه سءل عنه فقال اختلف فيه من الكفر   الي القطبانية والتسليم واجب ومن لم يذق ما ذاقه القوم ويجاهد مجاهداتهم لا يسعه من الله الانكار عليهم انتهي واقول وممن صرح بذلك من المتاخرين الشيخ احمد المقري المغربي قال في كتابه زهر الرياض في اخبار عياض والذي عند كثير من الاخيار في اهل هذه الطريقة التسليم ففيه السلامة وهي احوط من ارسال العنان وقول يعود علي صاحبه بالملامة وما وقع لابن حجر وابي حيان في تفسيره من اطلاق اللسان في هذا الصديق وانظاره فذلك من غلس الشيطان والذي اعتقده ولا يصح غيره ان الامام ابن عربي ولي صالح وعالم ناصح وانما فوق اليه سهام الملامة من لم يفهم كلامه علي انه دست في كتبه مقالات قدره يجل عنها وقد تعرض من المتاخرين ولي الله الرباني سيدي عبد الوهاب الشعراني نفعنا الله به لتفسير كلام الشيخ علي وجه يليق وذكر من البراهين علي ولايته ما يثلج صدور اهل التحقيق فليطالع ذلك من اراده والله ولي التوفيق انتهي كلام المقري ثم قال المناوي وفريق قصد بالانكار عليه وعلي اتباعه الانتصار لحظ نفسه لكونه وجد قرينه وعصريه يعتقده وينتصر له فحملته حمية الجاهلية علي معاكسته فبالغ في خذلانه وخذلان اتباعه ومعتقديه وقد شوهد عود الخذلان والخمول علي هذا الفريق وعدم الانتفاع بعلومهم وتصانيفهم علي حسنها قال وممن كان يعتقده سلطان العلماء ابن عبد السلام فانه سءل عنه اولا فقال شيخ سوء كذاب لا يحرم فرجا ثم وصفه بعد ذلك بالولاية بل بالقطبانية وتكرر ذلك منه وحكي عن اليافعي انه كان يطعن فيه ويقول هو زنديق فقال له بعض اصحابه يوما اريد ان تريني القطب فقيل هو هذا فقيل له فانت تطعن فيه فقال اصون ظاهر الشرع ووصفه في ارشاده بالمعرفة والتحقيق فقال اجتمع الشيخان الامامان العارفان المحققان الربانيان السهروردي وابن عربي فاطرق كل منهما ساعة ثم افترقا من غير كلام فقيل لابن عربي ما تقول في السهروردي فقال مملوء سنة من فرقه الي قدمه وقيل   للسهروردي ما تقول فيه قال بحر الحقاءق ثم قال المناوي واقوي ما احتج به المنكرون انه لا ياول الا كلام المعصوم ويرده قول النووي في بستان العارفين بعد نقله عن ابي الخير التبياني واقعة ظاهرها الانكار قد يتوهم من يتشبه بالفقهاء ولا فقه عنده ان ينكر هذا وهذا جهالة وغباوة ومن يتوهم ذلك فهو جسارة منه علي ارسال الظنون في اولياء الرحمن فليحذر العاقل من التعرض لشء من ذلك بل حقه اذا لم يفهم حكمهم المستفادة ولطاءفهم المستجادة ان يتفهمها ممن يعرفها وربما رايت من هذا النوع مما يتوهم فيه من لا تحقيق عنده انه مخالف ليس مخالفا بل يجب تاويل افعاله اولياء الله الي هنا كلامه واذا وجب تاويل افعالهم وجب تاويل اقوالهم اذ لا فرق وكان المجد صاحب القاموس عظيم الاعتقاد في ابن عربي ويحمل كلامه علي المحامل الحسنة وطرز شرحه للبخاري بكثير من كلامه انتهي واقول ومما يشهد بذلك ما اجاب به علي سءال رفع اليه لفظه ما تقول العلماء شد الله بهم ازر الدين والم بهم شعث المسلمين في الشيخ محي الدين بن العربي وفي كتبه المنسوبة اليه كالفتوحات والفصوص وغيرهما هل تحل قراءتها واقراءها للناس ام لا افتونا ماجورين فاجاب رحمه الله رحمة واسعة اللهم انطقنا بما فيه رضاك الذي اقوله في حال المسءول عنه واعتقده وادين الله سبحانه وتعالي به انه كان شيخ الطريقة حالا وعلما وامام الحقيقة حدا ورسما ومحي رسوم المعارف فعلا واسما اذا تغلغل فكر المرء في طرف من بحره غرقت فيه خواطره في عباب لا تدركه الدلاء وسحاب تتقاصر عنه الانواء واما دعواته فانها تخرق السبع الطباق وتفترق بركاته فتملا الافاق واني اصفه وهو يقينا فوق ما وصفته وغالب ظني اني ما انصفته ( وما علي اذا ما قلت معتقدي * دع الجهول يظن الجهل عدوانا ) ( والله تالله بالله العظيم ومن * اقامه حجة لله برهانا )   ( ان الذي قلت بعض من مناقبه * مازدت الا لعلي زدت نقصانا ) واما كتبه فانها البحار الزواخر جواهرها لا يعرف لها اول من اخر ما وضع الواضعون مثلها وانما خص الله بمعرفتها اهلها فمن خواص كتبه انه من لازم مطالعتها والنظر فيها انحل فهمه لحل المشكلات وفهم المعضلات وهذا ما وصلت اليه طاقتي في مدحه والحمد لله رب العالمين وكذلك اجاب ابن كمال باشا بما صورته بسم الله الرحمن الرحيم الحمد لمن جعل من عباده العلماء المصلحين وورثة الانبياء والمرسلين والصلاة والسلام علي محمد المبعوث لاصلاح الضالين والمضلين واله واصحابه المجدين لاجراء الشرع المبين وبعد ايها الناس اعلموا ان الشيخ الاعظم المقتدي الاكرم قطب العارفين وامام الموحدين محمد بن علي بن العربي الطاءي الاندلسي مجتهد كامل ومرشد فاضل له مناقب عجيبة وخوارق غريبة وتلامذة كثيرة مقبولة عند العلماء والفضلاء فمن انكره فقد اخطا وان اصر في انكاره فقد ضل يجب علي السلطان تاديبه وعن هذا الاعتقاد تحويله اذ السلطان مامور بالامر بالمعروف والنهي عن المنكر وله مصنفات كثيرة منها فصوص حكمية وفتوحات مكية وبعض مساءلها معلوم اللفظ والمعني وموافق للامر الالهي والشرع النبوي وبعضها خفي عن ادراك اهل الظاهر دون اهل الكشف والباطن فمن لم يطلع علي المعني المرام يجب عليه السكوت في هذا المقام لقوله تعالي ( ^ ولا تقف ما ليس لك به علم ان السمع والبصر والفءاد كل اولءك كان عنه مسءولا ) والله الهادي الي سبيل الله الصواب واليه المرجوع والماب انتهي وكلا الجوابين مكتوب في ضريح المترجم فوق راسه والله اعلم ثم قال المناوي واخبر الشعراوي عن بعض اخوانه انه شاهد رجلا اتي ليلا بنار ليحرق تابوته فخسف به وغبا بالارض فاحسن اهله فحفروا فوجدوا راسه فكلما حفروا نزل في الارض فعجزوا واهالوا عليه التراب قال ومن تامل سيرة ابن عرابي واخلاقه الحسنة وانسلاخه من حظوظ نفسه وترك العصبية   حمله ذلك علي محبته واعتقاده ومما وقع له ان رجلا من دمشق فرض علي نفسه ان يلعنه كل يوم عشر مرات فمات وحضر ابن عربي جنازته ثم رجع فجلس ببيته وتوجه للقبلة فلما جاء وقت الغداء احضر اليه فلم ياكل ولم يزل علي حاله الي بعد العشاء فالتفت مسرورا وطل بالعشاء واكل فقيل له في ذلك فقال التزمت مع الله اني لا اكل ولا اشرب حتي يغفر لهذيا الذي يلعنني وذكرت له سبعين الف لا اله الا الله فغقر له وقد اوذي الشيخ كثيرا في حياته وبعد مماته بما لم يقع نظيره لغيره وقد اخبر هو عن نفسه بذلك وذلك من غرر كراماته فقد قال في الفتوحات كنت ناءما في مقام ابراهيم واذا بقاءل من الارواح ارواح الملا الاعلي يقول لي عن الله ادخل مقام ابراهيم انه كان اواها حليما فعلمت انه لا بد ان يبتليني بكلام في عرضي من قوم فاعاملهم بالحلم قال ويكون اذي كثيرا فانه جاء بحليم بصيغة المبالغة ثم وصفه بالاواه وهو من يكثر منه التاوه لما يشاهد من جلال الله انتهي وقال الصفي بن ابي منصور جمع بن عربي بين العلوم الكسبية والعلوم الوهبية وكان غلب عليه التوحيد علما وخلقا وخلقا لا يكترث بالوجود مقبلا كان او معرضا وقال تلميذه الصدر القونوي الرومي كان شيخنا ابن عربي متمكنا من الاجتماع بروح من شاء من الانبياء والاولياء الماضين علي ثلاثة انحاء ان شاء الله استنزل روحانيته في هذا العالم وادركه متجسدا في صورة مثالية شبيهة بصورته الحسية العصرية التي كانت له في حياته الدنيا وان شاء الله احضره في نومه وان شاء انسلخ عن هيكله واجتمع به وهو اكثر القوم كلاما في الطريق فمن ذلك ما قال ما ظهر علي العبد الا ما استقر في باطنه فما اثر فيه سواه فمن فيهم هذه الحكمة وجعلها مشهودة اراح نفسه من التعلق بغيره وعلم انه لا يءتي عليه بخير ولا شر الا منه واقام العذر لكل موجود وقال اذا ترادفت عليك الغفلات وكثرة النوم فلا تسخط ولا تلتفت لذلك فان من نظر الاسباب مع الحق اشرك  كن مع
  الله بما يرد لا مع نفسك بما تريد لكن لا بد من الاستغفار وقال علامة الراسخ ان يزداد تمكنا عند سلبه لانه مع الحق بما احب فمن وجد اللذة في حال المعرفة دون السلب فهو مع نفسه غيبة وحضورا وقال من صدق في شء وتعلقت همته بحصوله كان له عاجلا او اجلا فان لم يصل اليه في الدينا فهو له في الاخرة ومن مات قبل الفتح رفع الي محل همته وقال العارف يعرف ببصره ما يعرفه غيره ببصيرته ويعرف ببصيرته ما لا يدركه احد الا نادرا ومع ذلك فلا يامن علي نفسه من نفسه فكيف يامن علي نفسه من مقدور ربه وهذا مما قطع الظهور سنستدرجهم من حيث لا يعلمون وقال لا ينقص العارف قوله لتلميذه خذ هذا العلم الذي لا تجده عند غيري ونحوه مما فيه تزكية نفسه لان قصده حث المتعلم علي القبول وقال كلام العارف علي صورة السامع بحسب قوة استعداده وضعفه وشبهته القاءمة بباطنه وقال كل من ثقل عليك الجواب عن كلامه فلا تجبه فان وعاءه ملان لا يسع الجواب وقال من صح له قدم في التوحيد انتفت عنه الدعاوي من نحو رياء واعجاب فانه يجد جميع الصفات المحمودة لله لا له والعبد لا يعجب بعمل غيره ولا بمتاع غيره وقال من ملكته نفسه عذب بنار التدبير ومن ملكه الله عذب بنار الاختبار ومن عجز عن العجز اذاقه الله حلاوة الايمان ولم يبق عنده حجاب وقال من ادرك من نفسه التغير والتبديل في كل نفس فهو العالم بقوله تعالي ( ^ كل يوم هو في شان ) وقال من طلب دليلا علي وحدانية الله تعالي كان الحمار اعرف بالله منه وقال الجاهل لا يري جهله لانه في ظلمته والعالم لا يري علمه لانه في ضياء نوره ولا يدري شء الا بغيره فالمراة تخبرك بعيوب صورتك وتصدقها مع جهلك بما اخبرت به والعالم يخبرك بعيوب نفسك مع علمك بما اخبرك به وتكذبه فماذا بعد الحق الا الضلال وقال حسن الادب في الظاهر اية حسنه في الباطن فاياك وسوء   الظن والسلام وقال معني الفتح عندهم كشف حجاب النفس او القلب او الروح او السر لما في الكتاب والسنة وقال وربما فهم احدهم من اللفظ ضد ما قصده المتكلم سمع بعض علماء بغداد رجلا من شربة الخمر ينشد ( اذا العشرون من شعبان ولت * فواصل شرب ليلك بالنهار ) ( ولا تشرب باقداح صغار * فان الوقت ضاق علي الصغار ) فهام علي وجهه في البرية حتي مات وقال كثيرا ما تهب في قلوب العارفين نفحات الهيبة فان نطقوا بها جهلهم كمل العارفين وردها عليهم اصحاب الادلة من اهل الظاهر وغاب عن هءلاء انه تعالي كما اعطي اولياءه الكرامات التي هر فرع المعجزات فلا بدع ان تنطق السنتهم بعبارات تعجز العلماء عن فهمهما وقال من لم يقم بقلبه تصديق ما يسمعه من كلام القوم فلا يجالسهم فان مجالستهم بغير تصديق سم قاتل وقال شدة القرب حجاب كما ان غاية البعد حجاب وان كان الحق اقرب الينا من حبل الوريد فاين السبعون الف حجاب وقال لا تدخل الشبهة في المعارف والاسرار الربانية وانما محلها العلوم النظرية وقال نهاية العارفين منقولة غير معقولة فما ثم عندهم الا بداية وتنقضي اعمارهم وهم مع الله علي اول قدم وقال كل من امن بدليل فلا وثوق بايمانه لانه نظري فهو معرض للقوادح بخلاف الايمان الضروري الذي يوجد في القلب ولا يمكن دفعه وكل علم حصل عن نظل وفكر لا يسلم من دخول الشبه عليه ولا الحيرة فيه وقال شرط الكامل الاحسان الي اعداءه وهم لا يشعرون تخلقا باخلاق الله فانه داءم الاحسان الي من سماهم اعداءه مع جهل الاعداء به وقال شرط الشيخ ان يكون عنده جميع ما يحتاجه المريد في التربية لا ظهور كرامة ولا كشف باطن المريد وقال الشفقة علي الخلق احق بالرعاية من الغيرة في الله لان الغيرة لا اصل لها في الحقاءق الثبوتبية لانها من الغيرية ولا غيرية هناك وان جنحوا للسلك فاجنح لها وجزاء سيءة سيءة مثلها فجعل القصاص   سيءة اي ان ذلك الفعل سء مع كونه مشروعا وكل ذلك تعظيما لهذه النشاة التي تولي الحق خلقها بيده واستخلفها في الارض وحرم علي عباده السعي في اتلافها بغير اذنه وقال الصوفي من اسقط الياءات الثلاث فلا يقول لي ولا عندي ولا متاعي اي لا يضيف لنفسه شيءا وقال الدعاء مخ العبادة وبالمخ تكون القوة للاعضاء فلذا تتقوي به عبادة العابدين وقال تحفظ من لذات الاحوال فانها سموم قاتلة وحجب مانعة وقال لا يغرنك امهاله فان بطشه شديد والشقي من اتعظ بنفسه لا يغرنك من خالف فجوزي باحسان المعارف ووقف في احسن المواقف وتجلت له المشاهد هذا كله مكر به واستدراج من حيث لا يعلم قل له اذا احتج عليك بنفسه ( سوف تري اذا انجلي الغبار * افرس تحتك ام حمار ) وقال لا يصح لعبد مقام المعرفة بالله وهو يجهل حكما واحدا من شراءع الانبياء فمن ادعي المعرفة واستشكل حكما واحدا في الشريعة المحمدية او غيرها فهو كاذب وقال اجمعت الطاءفة علي ان العلم بالله عين الجهل به تعالي وقال اذ ذكر الله الذاكر ولم يخشع قلبه ولا خضع عند ذكره اياه لم يحترم الجناب الالهي ولم يات بما يليق به من التعظيم واول ما تمقته جوارحه وجميع اجزاء بدنه وقال الاسماء الالهية كلها التي عليها يتوقف وجود العالم اربعة لا غير الحي القادر المريد العالم وبهذا الاسماء ثبت كونه الها وقال اخبرني من اثق به قال دخلت علي رجل فقيه عالم متكلم فوجدته بمجلس فيه الخمر وهو يشرب ففرغ النبيذ فقيل له انفذ الي فلان ياتي بنبيذ فقال لا فاني ما اصررت علي معصية قط ولي بين الكاسين توبة ولا انتظره فاذا حصل بيدي انظر هل يوفقني ربي فاتركه او يخذلني فاشربه ثم قال اعني ابن عربي فهكذا العلماء انتهي كلام المناوي ملخصا واقول ومن كلامه ايضا ( ما نال من جعل الشريعة جانبا * شيءا ولو بلغ السماء مناره )   ومن شعره الراءق قوله ( حقيقتي همت بها * وما راها بصري ) ( ولو راها لغدا * قتيل ذاك الحور ) ( فعندما ابصرتها * صرت بحكم النظر ) ( فبت مسحورا بها * اهيم حتي السحر ) ( يا حذري من حذري * لو كان يغني حذري ) ( والله ما هيمني * جمال ذاك الخفر ) ( يا حسنها من ظبية * ترعي بذات الخمر ) ( اذا رنت او عطفت * تسبي عقول البشر ) ( كانما انفاسها * اعراف مسك عطر ) ( كانها شمس الضحي * في النور او كالقمر ) ( ان سفرت ابرزها * نور صباح مسفر ) ( او سدلت غيبها * ظلام ذاك الشعر ) ( يا قمر تحت دجي * خذي فءادي او ذري ) ( عسي لكي ابصركم * اذ كان حظي نظري ) وكان يقول اعرف الاسم الاعظم واعرف الكيمياء بطريق المنازلة لا بطريق الكسب وكان مجتهدا مطلقا بلا ريب قال في راءيته ( لقد حرم الرحمن تقليد مالك * واحمد والنعمان والكل فاعذروا ) وقال ايضا في نونيته ( لست ممن يقول قال ابن حزم * لا ولا احمد ولا للنعمان ) وهذا صريح بالاجتهاد المطلق كيف لا وقد قال عرضت احاديثه جميعها عليه فكان يقول عن احاديث صحت من جهة الصناعة ما قلتها وعن احاديث ضعفت من جهتها قلتها واذا لم يكن مجتهدا فليس لله مجتهد   ان لم تريه فهذه اثاره هذا وما نقم عليه احد فيما اعلم بغير ما فهمه من كلامه من الحلول او الاتحاد وما تفرع عليهما من كفر او الحاد وساحته النزهة منهما وشاوه ابعد شاو عنهما وكلامه بنفسه يشهد بهذا خلي افتراك فذاك خلي لاذا قال في فتوحاته المكية التي هي قرة عين السادة الصوفية في الباب الثاني والتسعين وماءتين من اعظم دليل علي نفي الحلول والاتحاد الذي يتوهمه بعضهم ان تعلم عقلا ان القمر ليس فيه من نور الشمس شء وان الشمس ما انتقلت اليه بذاتها وانما كان القمر محلالها فلذلك العبد ليس فيه من خالقه شء ولا حل فيه وقال ايضا فيها في الباب الثامن والسبعين كما نقله عنه الشعراني في كتابه اليواقيت والجواهر وفي بيان عقاءد الاكابر ان الله تعالي لم يوجد العالم لافتقاره اليه وانما الاسباب في حال عدمها الامكاني لها طلبت وجودها ممن هي مفتقرة اليه بالذات وهو الله تعالي لا تعرف غيره فلما طلبت بفقرها الذاتي من الله تعالي ان يوجدها قبل الحق سءالها لا من حاجة قامت به اليها لانها كانت مشهودة له تعالي في حال عدمها النسبي كما هي مشهودة له في حال وجودها سواء فهو يدركها سبحانه علي ما هي عليه في حقاءقها حال وجودها وعدمها بادراك واحد فلهذا لم يكن ايجاده للاشياء عن فقر بخلاف العبد فان الحق تعالي لو اعطاه جزء كن واراد ايجاد شء لا يوجده الا عن فقر اليه وحاجة فما طل بالعبد الا ما ليس عنده فقد افترق ايجاد العبد عن ايجاد الحق تعالي قال وهذه مسءلة لو ذهبت عينك جزاء لتحصيلها لكان قليلا في حقها فانها مزلة قدم زل فيها كثير من اهل الله تعالي والتحقوا فيها بمن ذمهم الله تعالي في قوله ( ^ لقدكفر الذين قالوا ان الله فقير ونحن اغنياء ) انتهي فان قلت قد نقل بعضهم عن الشيخ انه كان ينشد ( الكل مفتقر ما الكل مستغني * هذا هو الحق قد قلنا ولا نكني )   فالجواب ان هذا ومثله من المدسوس عليه في كتاب الفصوص وغيره فان هذا يكذبه الناقل عنه خلاف ذلك انتهي كلام الشعراني توفي رحمه الله ورضي عنه في الثاني والعشرين من ربيع الاخر بدمشق في دار القاضي محيي الدين بن الزكي وحمل الي قاسيون فدفن في ترتبه المعلومة الشريفة التي هي قطعة من رياض الجنة والله تعالي اعلم وفيها امين الدين ابو بكر وابو عبد الله احمد بن محمد بن طلحة بن الحسن بن طلحة بن حسان البصري الاصل البغدادي المصري الفقيه الحنبلي المحدث المعدل ولد سنة ثلاث وسبعين وخمسماءة تقريبا وطلب الحديث وسمع الكثير من ابن كليب وذاكر ابن كامل وابي الفرج بن الجوزي وابن المعطوس وخلق كثير من هذه الطبقة وكتب بخطه كثيرا وتفقه في المذهب وتكلم في الخلاف وحصل طرفا صالحا من الادب وسافر الي بلاد فارس والروم ومصر وشهد عند ابن اللمعاني وله مجموعات وتخاريج في الحديث وجمع الاحاديث السباعيات والثمانيات التي له ومعجما لشيوخه وحدث ببغداد وغيرها ذكر ذلك ابن النجار وقال سمعت منه وهو فاضل عالم ثقة صدوق متدين امين نزه حسن الطريقة جميل السيرة طاهر السريرة سليم الجانب مسارع الي فعل الخير محبوب الي الناس انتهي توفي ليلة الاحد ثالث ربيع الاول ببغداد وفيها تقي الدين ابو عبد الله يوسف بن عبد المنعم بن نعمة بن سلطان بن سرور بن رافع بن حسن بن جعفر المقدسي النابلسي الفقيه الحنبلي المحدث ولد سنة ست وثمانين وخمسماءة تقديرا ببيت المقدس وسمع بدمشق من ابن طبرزد وغيره قال المنذري توافقنا في السماع كثيرا وكان علي طريقة حسنة توفي عاشر ذي القعدة بمدينة نابلس سنة تسع وثلاثين وستماءة فيها توفي الشمس بن الخباز النحوي ابو عبد الله احمد بن الحسين بن احمد   ابن معالي الاربلي ثم الموصلي الضرير صاحر التصانيف الادبية توفي في رجب بالموصل وله خمسون سنة قاله في العبر وفيها المارستاني ابو العباس احمد بن يعقوب بن عبد الله البغدادي الصوفي قيم جامع المنصور روي عن ابي المعالي بن اللحاس وحفدة العطاردي وجماعة وتوفي في ذي الحجة وفيها ابو العباس احمد بن محفوظ بن مهنا بن شكر بن الصافيوني الرصافي البغدادي الحنبلي الفقيه المحدث سمع الكثير وعني بالسماع وكتب الطباق بخطه وهو حسن وتفقه علي القاضي ابي صالح نصر بن عبد الرزاق وكان خيرا صالحا متعبدا توفي يوم الاحد تاسع عشر صفر ودفن بمقبرة معروف الكرخي وفيها تقي الدين اسحق بن طرخان بن ماضي الفقيه الشافعي الشاغوري اخر من حدث عن حمزة بن كروش توفي في رمضان بالشاغور وفيها النفيس بن قادوس القاضي ابو الكرم اسعد بن عبد الغني العدوي المصري اخر من روي عن الشريف ابي الفتوح الخطيب وابي العباس بن الحطية وتوفي في ذي الحجة وله ست وتسعون سنة وفيها ابو الطاهر اسمعيل بن مظفر بن احمد بن ابراهيم بن مفرج بن منصور بن ثعلب بن عيينة بن ثابت بن بكار بن عبد الله بن شرف بن مالك بن المنذر بن النعمان بن المنذر المنذري النابلسي الدمشقي المولد المحدث الحنبلي ولد سنة اربع وسبعين وخمسماءة بدمشق وارتحل في طلب الحديث الي الامصار فسمع بمكة من ابن الحصري وبمصر من البوصيري والارتاحي والحافظ عبد الغني وجماعة وببغداد من المبارك بن كليب وابن الجوزي وغيرهما وباصبهان من ابي المكارم اللبان وغيره وبخراسان من عبد المنعم الفراوي والمءيد الطوسي وجماعة وبنيسابور من ابي سعد الصفار وغيره وبحران من الحافظ عبد القادر الرهاوي وانقطع اليه مدة وكتب الكثير بخطه وحدث بالكثير قال المنذري سمعت منه بحران ودمشق وكتب عنه   ابن النجار ببغداد وقال كان شيخا صالحا وقال عمر بن الحاجب كان عبدا صالحا صاحب كرامات ذا مروءة مع فقر مدقع صحيح الاصول روي عنه الحافظ الضياء والمنذري والبرزالي والقاضي سليمان بن حمزة وتوفي في رابع شوال بسفح قاسيون ودفن به وفيها ابو علي الحسن بن ابراهيم بن هبة الله بن دينار المصري الصانع روي عن السلفي ومات في جمادي الاخرة عن تسع وثمانين سنة وفيها الاسعردي ابو الربيع سليمان بن ابراهيم بن هبة الله بن رحمة الحنبلي المحدث خطيب بيت لهيا ولد باسعرد سنة سبع وستين وخمسماءة ورحل فسمع بدمشق من الخشوعي وابن طبرزد وجماعة كثيرة وبمصر من البوصيري وغيره وبالاسكندرية من ابن علاس وانقطع الي الحافظ عبد الغني المقدسي مدة وتخرج به وسمع منه الكثير وكتب بخطه كثيرا وكان كثير الافادة حسن السيرة سءل عنه الحافظ الضياء فقال خير دين ثقة واقام ببيت لهيا وتولي امامتها وخطابتها قال المنذري اجتمعت به ولم يتفق لي السماع منه وافادنا اجازة عن جماعة من شيوخ المصريين وغيرهم شكر الله سعيه وجزاه خيرا توفي في ثاني عشري ربيع الاخر ببيت لهيا ورحمة اسم ام ابي جده وبها عرف جده وفيها ابو المعالي عماد الدين عبد الرحمن بن نفيل العلامة قاضي القضاة الواسطي الشافعي ولد سنة سبعين وخمسماءة وتفقه فدرس وافتي وناب في القضاء عن ابي صالح الجيلي ثم ولي بعده القضاء ودرس بالمستنصرية ثم عزل عن الكل سنة ثلاث وثلاثين وستماءة فتزهد وتعبد ثم ولي مشيخة رباط في سنة خمس وثلاثين وحدث عن ابن كليب وتوفي في ذي القعدة وفيها عبد السيد بن احمد الضبي خطيب يعقوبا روي عن يحيي بن ثابت واحمدالمرقعاتي وتوفي في صفر وله تسع وسبعون سنة وفيها ابو محمد سيف الدين عبد الغني بن فخر الدين ابي عبد الله محمد بن تيمية   الحراني الحنبلي خطيب حران وابن خطيبها الفخر ولد في ثاني صفر سنة احدي وثمانين وخمسماءة بحارن وسمع بها من والده وعبد القادر الرهاوي وغيرهما ورحل الي بغداد فسمع من ابن سكينة وابن طبرزد وغيرهما واخذ الفقه عن غلام ابن المني وغيره ورجع الي حران وقام مقام ابيه بعد وفاته فكان يخطب ويعظ ويدرس ويلقي التفسير في الجامع علي الكرسي قال ابن حمدان كان خطيبا فصيحا رءيسا ثابتا رزين العقل وله تصنيف الزوايد علي تفسير الوالد واهداء القر الي ساكني الترب قال ولم اسمع منه ولا قرات عليه شيءا وسمعت بقراءته علي والده كثيرا توفي في سابع المحرم بحران وفيها البدر علي بن عبد الصمد بن عبد الجليل المرازقي المءدب بمكتب جاروخ بدمشق روي عن السلفي ثماني الاجري وتوفي في ربيع الاخر وفيها ابو فضيل قايماز المعظمي مجاهد الدين والي البحيرة روي عن السلفي ومات في سلخ شوال وفيها شرف الدين بن الصفراوي قاضي قضاة مصر ابو المكارم محمد بن القاضي ابي المجد حسن الاسكندراني ثم المصري الشافعي ولد بالاسكندرية سنة احدي وخمسين وخمسماءة وقدم القاهرة فناب في القضاء سنة اربع وثمانين عن نصر الدين بن درباس ثم ناب عن غير واحد وولي قضاء الديار المصرية في سنة سبع عشرة وستماءة وتوفي في تاسع عشر ذي القعدة وفيها ابن نعيم القاضي ابو بكر محمد بن يحيي بن مظفر البغدادي الشافعي المعروف بابن الحبير ولد سنة تسع وخمسين وسمع من شهدة وجماعة وكان من اءمة الشافعية صاحب ليل وتهجد وحج طويل الباع في النظر والجدل ولي تدريس النظامية مدة قال الاسنوي كان اماما عارفا بالمذهب ودقاءقه وتحقيقاته وليه اليد الطولي في الجدل والمناظرة دينا خيرا كثير التلاوة عليه وقار وسكينة وتفقه علي المحبر البغدادي بعد ان كان حنبليا ونا بفي القضاء عن ابن فضلان وحدث وتوفي في سابع شوال   وفيها الكمال بن يونس العلامة ابو الفتح موسي بن يونس بن محمد بن منعة بن مالك الموصلي الشافع ياحد الاعلام ولد سنة احدي وخمسين بالموصل وتفقه علي والده وببغداد علي معيد النظامية السديد السلماني وبرع عليه في الاصول والخلاف وقرا النحو علي ابن سعدون القرطبي والكمال الانباري واكب علي الاشتغال بالعقليات حتي بلغ فيها الغاية وكان يتوقد ذكاء ويموج بالمعارف حتي قيل انه كان يتقن اربعة اربعة عشر فنا واشته رذكره وطار صيته وخبره ورحلت الطلبة اليه من الاقطار وتفرد باتقان علم الرياضي ولم يكن له في وقته نظير قال ابن خلكان كان يتهم في دينه لكون العلوم العقلية غالبة عليه كما قال العماد المغربي فيه ( وعاطيته صهباء من فيه مزجها * كرقة شعري او كدين ابن يونس ) وقال ابن خلكان ايضا ولقد رايته بالموصل في شهر رمضان سنة ست وعشرين وستماءة وترددت اليه دفعات عديدة لما كان بينه وبن الوالد رحمه الله من المءانسة والمودة الاكيدة ولم يتفق لي الاخذ عنه لعدم الاقامة وسرعة الحركة الي الشام وكان الفقهاء يقولون انه يدري اربعة وعشرين علما دراية متقنة فمن ذلك المذهب وكان فيه اوحد اهل زمانه وكان جماعة من الحنيفية يشتغلون عليه بمذهبهم ويحل لهم مساءل الجامع الكبير احسن حل مع ما هي عليه من الاشكال المشهور وكان يتقن فن الخلاف العراقي والبخاري واصول الفقه والدين ولما وصلت كتب فخر الدين الرازي الي الموصل وكان بها اذ ذاك جماعة من الفضلاء لم يفهم احد اصطلاحه فيها سواه وكذلك الارشاد للعميدي لما وقف عليها في ليلة واحدة واقراها علي ما قالوه وبالجملة فقد كان كمال الدين كما قال الشاعر ( وكان من العلوم بحيث يقضي * له في كل علم بالجميع ) واستخرج في علم الاوفاق طرقا لم يهتد اليها احد وكان يحفظ من التواريخ   وايام العرب ووقاءعهم والاشعار والمحاضرات شيا كثيرا وكان اهل الذمة يقراون عليه التوارة والانجيل ويشرح لهما هذين الكتابين شرحا يعترفون انهم لا يجدون من يوضحهما لهم مثله وبالجملة فان مجموع ما كان يعرف من العلوم لم يكن يسمع عن احد ممن كان تقدمه انه جمع مثله وتوفي رحمه الله تعالي بالموصل رابع عشر شعبان انتهي كلاما بن خلكان ملخصا سنة اربعين وستماءة فيها جهز الملك الصالح ايوب عسكره وعليهم كمال الدين بن الشيخ لاخذ دمشق من عمه الصالح اسمعيل فمات مقدم العسكر كما الدين بغزة ويقال انه سم وفيها توفي الزين احمد بن عبد الملك بن عثمان المقدسي الحنبلي الشروطي الناسخ روي عن يحيي الثقفي والبوصيري وابن المعطوس وطبقتهم وطلب وكتب الاجزاء توفي في رمضان عن ثلاث وستين سنة وفيها ابو اسحق ابراهيم بن الشيخ ابي طاهر بركات بن ابراهيم بن طاهر الدمشقي الخشوعي اخر من سمع من عبد الواحد بن هلال وما يدري ما سمع من ابن عساكر توفي في رجب وله اثنتان وثمانون سنة وفيها اسية المقدسية والدة السيف بن المجد قال اخوها الضياء ما في زماننا مثلها لا تكاد تدع قيام الليل وفيها الحجة الاتابكية امراة الاشرف موسي صاحبة المدرسة والتربة بجبل قاسيون تركان بنت الملك عز الدين مسعود بن قطب الدسن مودود بن اتابك زنكي وفيها جمال النساء بنت احمد بن ابي سعد العراف البغدادية سمعت من ابن البطي واحمد بن محمد الكاغدي وبقية عشرة شيوخ وتوفيت في جمادي الاولي وفيها ابو محمد الحسن بن الاكرم عرف بابن الزاهد العلوي الاديب   ومن شعره ( صد عني وجاء شينا فريا * فنبذت الكري مكانا قصيا ) ( ورعيت النجوم في الليل حتي * بات طرفي موكلا بالثريا ) ( وبراني الاسي فقلت لقلبي * ذق اليم الغرام ما دمت حيا ) ( كيف تهوي من لا يرق لصب * قد كوت قلبه الصبابة كيا ) ( يا طبيب القلوب عالج مريضا * يشتكي من جفاك داء دويا ) ( ترك الحزم من احب كحبي من بني الترك ظالما تركيا ) ( يا بخيلا بوصله ولعمري * ضيق العين لا يكون سخيا ) وفيها سعيدة بن