   شهاب بن الحسن العكبري روي عن عبد الملك بن قريب الاصمعي حدث عنه علي بن محمد الحبيبي المروزي اخبرني ابو الوليد الحسن بن محمد الدربندي اخبرنا محمد بن ابي بكر الوراق البخاري حدثنا ابو احمد علي بن محمد بن عبد الله المروزي املاء حدثنا شهاب بن الحسن العكبري قال سمعت الاصمعي يقول سمعت ابان بن جرير يقول قال المهلب بن ابي صفرة يعجبني من الرجل الكريم خصلتان يعجبني ان اري عقل الرجل الكريم زاءدا علي لسانه ولا يعجبني ان اري لسانه زاءدا علي عقله 
   شقران بن عبدوس بن المبارك حدث عن محمد بن هشام النصيبي روي عنه محمد بن حميد المخرمي اخبرنا هلال بن محمد بن جعفر الحفار حدثنا محمد بن حميد بن سهيل المخرمي حدثنا شقران بن عبدوس بن المبارك في سويقة نصر حدثنا محمد بن هشام النصيبي الاهوازي قال حدثتنا حكامة ام سلم بن دينار قالت حدثني ابي عن مالك بن دينار عن انس بن مالك قال قال رسول الله صلي الله عليه و سلم كل مسكر حرام
   شاكر بن عبد الله ابو الحسن المصيصي قدم بغداد وحدث بها عن محمد بن موسي النهرتيري وعمر بن سعيد المنبجي والحسن بن احمد بن ابراهيم بن فيل الانطاكي وابي سعيد الحسن بن علي الفقيه ومحمد بن عبد الصمد بن ابي الجراح وايوب بن سليمان العطار المصيصيين ومحمد بن ابراهيم بن البطال اليمامي حدثنا عنه ابو الحسن بن رزقويه وعبد الله بن يحيي السكري ومحمد بن طلحة النعالي وعلي بن احمد الرزاز وما علمت من حاله الا خيرا وقال لنا بن رزقويه قدم علينا شاكر بن عبد الله مستنفرا اخبرنا السكري حدثنا شاكر بن عبد الله المصيصي حدثنا ابو سعيد الحسن بن علي الفقيه حدثنا احمد بن عيسي المصري حدثنا ضمام يعني بن اسماعيل عن ابي قبيل عن عبد الله بن عمرو قال كنا نسمع في الجاهلية الجهلاء زر غبا تزدد حبا حتي سمعتها من رسول الله صلي الله عليه و سلم قال لي ابو الحسن علي بن احمد الرزاز توفي ابو الحسن شاكر بن عبد الله المصيصي في صفر سنة اربع وخمسين وثلاثماءة قلت وببغداد كانت وفاته باب الصاد ذكر من اسمه صالح 
   صالح بن حسان ابو الحارث الانصاري من بني النضير مديني روي عن محمد بن كعب القرظي وعروة بن الزبير قال بن ابي حاتم الرازي هو حجازي قدم بغداد وروي عنه بن ابي ذءب وانس بن عياض وعاءذ بن حبيب وسعيد بن محمد الوراق قلت في قول بن ابي حاتم روي عنه بن ابي ذءب عندي نظر لان الذي يروي عنه بن ابي ذءب هو صالح بن ابي حسان لا بن حسان وذاك يروي عن سعيد بن المسيب وابي سلمة بن عبد الرحمن فالله اعلم وقد روي عن صالح بن حسان ابو حفص عمر بن عبد الرحمن الابار وابراهيم بن عيينة وابو يحيي الحماني وحفص بن عمر قاضي حلب وابو عاصم النبيل وابو داود الحفري روي عنه ايضا صالح بن ابي الاسود عن جعفر بن محمد بن علي اخبرني السكري اخبرنا محمد بن عبد الله الشافعي حدثنا جعفر بن محمد بن الازهر حدثنا المفضل بن غسان الغلابي حدثنا يحيي بن صالح الوحاظي عن حفص بن عمر قال حدثنا صالح بن حسان عن محمد بن كعب عن بن عباس قال قال رسول الله صلي الله عليه و سلم لا تاخذوا الحديث الا عمن تجيزون شهادته رواه ابو حفص الابار عن صالح فاختلف عليه في رفعه ووقفه علي بن عباس ورواه ابو داود الحفري عن صالح عن محمد بن كعب عن النبي صلي الله عليه و سلم لم يذكر فيه بن عباس ولا نعلم رواه عن محمد بن كعب غير صالح اخبرنا ابو نعيم الحافظ حدثنا عبد الله بن جعفر بن احمد بن فارس حدثنا اسماعيل بن عبد الله بن مسعود العبدي حدثنا سعيد بن سليمان حدثنا منصور بن ابي الاسود حدثنا صالح بن حسان عن جعفر بن محمد عن ابيه عن جده عن علي بن ابي طالب قال قال رسول الله صلي الله عليه و سلم اتق يا علي دعوة المظلوم فانما يسال الله حقه وان الله لن يمنع ذا حق حقه اخبرنا علي بن القاسم بن الحسن الشاهد بالبصرة حدثنا علي بن اسحاق المادراني حدثنا عباس بن محمد الدوري وابراهيم بن اسحاق الحربي واللفظ لابراهيم قال حدثنا سعيد بن سليمان حدثنا منصور بن ابي الاسود عن صالح بن حسان باسناده نحوه قال ابراهيم الحربي صالح بن حسان هذا من اهل المدينة من خلفاء الاوس كان له نبل وشرف وكان له قيان فهي التي وضعت منه اخبرنا الازهري والجوهري قالا حدثنا محمد بن العباس اخبرنا ابو ايوب سليمان بن اسحاق الجلاب حدثنا الحارث بن محمد حدثنا محمد بن سعد قال صالح بن حسان النضيري من خلفاء الاوس قال محمد بن عمر ادرك المهدي وكان سريا مريا يملا المجلس اذا تحدث وكان عنده جوار مغنيات فهن وضعنه عند الناس وكان يحدث عن محمد بن كعب القرظي وغيره وقدم الكوفة فسمع منه الكوفيون وكان قليل الحديث اخبرنا ابو سعيد محمد بن موسي الصيرفي قال سمعت ابا العباس محمد بن يعقوب الاصم يقول سمعت العباس بن محمد الدوري يقول سمعت يحيي بن معين يقول صالح بن حسان مديني وليس حديثه بشء روي عنه ابو ضمرة وغيره اخبرنا ابو بكر الاشناني قال سمعت احمد بن محمد بن عبدوس الطراءفي يقول سمعت عثمان بن سعيد الدارمي يقول وسالته يعني يحيي بن معين عن صالح بن حسان قال ليس بشء اخبرني السكري اخبرنا محمد بن عبد الله الشافعي حدثنا جعفر بن محمد بن الازهر حدثنا بن الغلابي قال قال ابو زكريا صالح بن حسان ليس بثقة اخبرنا بن الفضل اخبرنا علي بن ابراهيم المستملي حدثنا ابو احمد بن فارس حدثنا البخاري قال صالح بن حسان الانصاري المديني منكر الحديث قرات في كتاب ابي الحسن بن الفرات بخطه اخبرنا محمد بن العباس الهروي حدثنا يعقوب بن اسحاق بن محمود الفقيه قال قال ابو علي صالح بن محمد بن صالح بن حسان يروي عن محمد بن كعب ضعيف الحديث اخبرنا احمد بن ابي جعفر اخبرنا محمد بن عدي البصري في كتابه حدثنا ابو عبيد محمد بن علي الاجري قال سالت ابا داود عن صالح بن حسان فقال ضعيف الحديث وقال في موضع اخر في حديثه نكارة اخبرنا البرقاني اخبرنا احمد بن سعيد بن سعد حدثنا عبد الكريم بن احمد بن شعيب النساءي حدثنا ابي قال صالح بن حسان متروك الحديث مديني وقيل بصري 
   صالح بن عبد القدوس ابو الفضل البصري مولي لاسد احد الشعراء اتهمه المهدي امير المءمنين بالزندقة فامر بحمله اليه واحضره بين يديه فلما خاطبه اعجب بغزارة ادبه وعلمه وبراعته وحسن بيانه وكثرة حكمته فامر بتخلية سبيله فلما ولي رده وقال له الست القاءل ... والشيخ لا يترك اخلاقه ... حتي يواري في ثري رمسه ... ... اذا ارعوي عاد الي جهله ... كذي الضني عاد الي نكثه ... قال بلي يا امير المءمنين قال فانت لا تترك اخلاقك ونحن نحكم فيك بحكمك في نفسك ثم امر به فقتل وصلب علي الجسر ويقال ان المهدي ابلغ عنه ابيات يعرض فيها بالنبي صلي الله عليه و سلم فاحضره المهدي وقال له انت القاءل هذه الابيات قال لا والله يا امير المءمنين والله ما اشركت بالله طرفة عين فاتق الله ولا تسفك دمي علي الشبهة وقد قال النبي صلي الله عليه و سلم ادرءا الحدود بالشبهات وجعل يتلو عليه القران حتي رق له وامر بتخليته فلما ولي قال انشدني قصيدتك السينية فانشده حتي بلغ البيت اوله والشيخ لا يترك اخلاقه فامر به حينءذ فقتل ويقال انه كان مشهورا بالزندقة وله مع ابي الهذيل العلاف مناظرات وشعره كله امثال وحكم واداب ومن مستحسنات قصاءده صالح القصيدة القافية انشدناها عبيد الله بن ابي الفتح واحمد بن عبد الواحد الوكيل قالا انشدنا محمد بن جعفر بن هارون التميمي الكوفي قال انشدنا ابو بكر الدارمي عن عمه لصالح بن عبد القدوس ... المرء يجمع والزمان يفرق ... ويظل يرقع والخطوب تمزق ... ... ولان يعادي عاقلا خيرا له ... من ان يكون له صديق احمق ... ... فارغب بنفسك لا تصادق احمقا ... ان الصديق علي الصديق مصدق ... ... وزن الكلام اذا نطقت فانما ... يبدي عيوب ذوي العقول المنطق ... ... ومن الرجال اذا استوت احلامهم من يستشار ... اذا استشير فيطرق ... ... حتي يجيل بكل واد قلبه ... فيري ويعرف ما يقول فينطق ... ... فبذاك يوثق كل امر مطلق ... وبذاك يطلق كل امر يوثق ... ... وان امرء لسعته افعي مرة ... تركته حين يجر حبل يفرق ... ... لا الفينك ثاويا في غربة ... ان الغريب بكل سهم يرشق ... ... ما الناس الا عاملان فعامل ... قد مات من عطش واخر يغرق ... ... والناس في طلب المعاش وانما ... بالجد يرزق منهم من يرزق ... ... لو يرزقون الناس حسب عقولهم ... الفيت اكثر من تري يتصدق ... ... لكنه فضل المليك عليهم ... هذا عليه موسع ومضيق ... ... واذا الجنازة والعروس تلاقيا ... الفيت من تبع العراءس يطلق ... ... ورايت من تبع الجنازة باكيا ... ورايت دمع نواءح يترقرق ... كذا في الرواية ورايت في غير الرواية ... واذا الجنازة والعروس تلاقيا ... ورايت دمع نواءح يترقرق ... ... سكت الذي تبع العروس مبهتا ... ورايت من تبع الجنازة ينطق ... ... لو سار الف مدجج في حاجة ... لم يقضها الا الذي يترفق ... ... ان الترفق للمقيم موافق ... واذا يسافر فالترفق اوفق ... ... بقي الذين اذا يقولوا يكذبوا ... ومضي الذين اذا يقولوا يصدقوا ... اخبرني علي بن ايوب القمي اخبرنا محمد بن عمران بن موسي حدثني علي بن هارون المنجم عن ابيه قال من مختار شعر صالح بن عبد القدوس قوله ... ان الغني الذي يرضي بعيشته ... لا من يظل علي ما فات مكتءبا ... ... لا تحقرن من الايام محتقرا ... كل امرء سوف يجزي بالذي اكتسبا ... ... قد يحقر المرء ما يهوي فيركبه ... حتي يكون الي توريطه سببا ... بلغني عن عبد الله بن المعتز قال حدثني احمد بن عبد الرحمن بن المعبر قال رايت صالح بن عبد القدوس في المنام ضاحكا مستبشرا فقلت ما فعل بك ربك وكيف نجوت مما كنت ترمي به قال اني وردت علي رب لا تخفي عليه خافية فاستقبلني برحمته وقال قد علمت براءتك مما كنت تقذف به 
   صالح بن بشير ابو بشر القارء المعروف بالمري من اهل البصرة حدث عن الحسن ومحمد بن سيرين وبكر بن عبد الله المزني وثابت البناني وسليمان التيمي ويزيد الرقاشي وجعفر بن زيد العبدي روي عنه شجاع بن ابي نصر البلخي وسريج بن النعمان الجوهري ويونس بن محمد المءدب وعفان بن مسلم وابو ابراهيم الترجماني وخالد بن خداش المهلبي وبشر بن الوليد الكندي وصالح بن مالك الخوارزمي وكان عبدا صالحا وكان المهدي امير المءمنين قد بعث اليه فاقدمه عليه بغداد كذلك اخبرني الازهري عن ابي الحسن الدارقطني قال اخبرنا ابو حاتم محمد بن حبان اجازة قال صالح بن بشير المري من اهل البصرة حمله المهدي الي بغداد فسمع منه البغداديون واخبرني السكري اخبرنا محمد بن عبد لله الشافعي حدثنا جعفر بن محمد بن الازهر حدثنا بن الغلابي حدثنا 
 شيخ من الكتاب ان صالح المري لما ارسل اليه المهدي قدم عليه فلما ادخل عليه ودنا بحماره من بساط المهدي امر ابنيه وهما وليا العهد موسي بن وهارون فقال قوما فانزلا عمكما فلما انتهيا اليه اقبل صالح علي نفسه فقال يا صالح لقد خبت وخسرت ان كنت انما عملت لهذا اليوم وقال بن الغلابي حدثني ابي عن ابي دهمان وكان عالما بفقهاء البصرة قال كان صالح المري مملوكا لامراة من بني مرة بن الحارث بن عبد القيس وهو صالح بن بشير اخبرني علي بن ايوب اخبرنا محمد بن عمران بن موسي حدثنا بن احمد الكاتب حدثنا الحسين بن فهم حدثني ابو همام حدثني ابراهيم بن اعين قال قال صالح المري دخلت علي المهدي ها هنا بالرصافة فلما مثلت بين يديه قلت يا امير المءمنين احمل لله ما اكلمك به اليوم فان اولي الناس بالله احملهم لغلظة النصيحة فيه وجدير بمن له قرابة برسول الله صلي الله عليه و سلم ان يرث اخلاقه وياتم بهديه وقد ورثك الله من فهم العلم وانارة الحجة ميراثا قطع به عذرك فمهما ادعيت من حجة او ركبت من شبهة لم يصح لك بها برهان من الله حل بك من سخط الله بقدر ما تجاهلته من العلم او اقدمت عليه من شبهة الباطل واعلم ان رسول الله صلي الله عليه و سلم خصم من خالفه في امته يبتزها احكامها ومن كان محمد خصمه كان الله خصمه فاعد لمخاصمة الله ومخاصمة رسول الله حججا تضمن لك النجاة او استلم للهلكة واعلم ان ابطا الصرعي نهضة صريع هوي يدعيه الي الله قربة وان اثبت الناس قدما يوم القيامة اخذهم بكتاب الله وسنة نبيه صلي الله عليه و سلم فمثلك لا يكابر بتجريد المعصية ولكن تمثل له الاساءة احسانا ويشهد له عليها خونة العلماء وبهذه الحبالة تصيدت الدنيا نظراءك فاحسن الحمل فقد احسنت اليك الاداء قال فبكي المهدي قال ابو همام فاخبرني بعض الكتاب انه راي هذا الكلام مكتوبا في دواوين المهدي اخبرني علي بن محمد 
 بن الحسن المالكي اخبرنا عبد الله بن عثمان الصفار اخبرنا محمد بن عمران الصيرفي حدثنا عبد الله بن علي بن المديني قال وجدت في كتاب لي بخط ابي صالح المري هو صالح بن بشير بن وادع بن ابي بن ابي الاقعس من الاقاعسة من ولد عامر بن حنيفة واعتقت صالحا المري امراة من بني حنيفة بن جارية بن مرة وام صالح ميمونة امراة خراسانية وانما صار صالح بن بشير لانه كان في كتاب رجل من كندة وكانت ميمونة ام صالح امة للمراة المرية تزوجها بشير بن وادع وهو عربي حنفي فولدت له صالحا فكان مملوكا لهذه المراة فقاتل صالح وهو صبي في الكتاب له ذءابة صبيا فجاء ابو الصبي يتفقده وقال لصالح يا عبد يا خبيث ومد ذءابته حتي ادماها فدخل وهو يبكي فاخبر مولاته فقالت اذهب انت واخوك حرين لوجه الله فصار ولاءه للمراة المرية فقدم بشير ابوه فاشتد عليه حين صار ابنه مولي المراة المرية وطلب ميمونة اراه قال اشتريها فابت المراة قال وقالت لا يملكها احد غيري فاعتقتها فصالح مولي للمرية وابوه بشير عربي اخبرنا محمد بن الحسين بن الفضل القطان اخبرنا دعلج بن احمد اخبرنا احمد بن علي الابار حدثنا ابراهيم بن سعيد قال سمعت خالد بن خداش يقول ذكر لحماد بن زيد حديث عن صالح المري في فضل القران فقال كان صالح صاحب قران فلعله سمعه ولم اسمعه انا اخبرنا بن الفضل اخبرنا عبد الله بن جعفر حدثنا يعقوب بن سفيان قال سمعت سليمان بن حرب قال قال رجل لحماد بن زيد تعرف ايوب عن ابي قلابة قال من شهد فاتحة الكتاب حين تستفتح كان كمن شهد فتحا في سبيل الله ومن شهدها حين يختم كان كمن شهد الغناءم حين تقسم قال فانكر حماد انكارا شديدا قال ثم قال له بعد من حدثك بهذا قال صالح المري قال استغفر الله ما اخلقه ان يكون حقا فان صالحا كان هذا ونحوه من باله ويتعني ويطلب بهذا النحو ما اخلقه ان يكون 
 صحيحا قال يعقوب وحدثني بعض الشيوخ عن عبد الرحمن بن مهدي قال قال سفيان اما لكم مذكر قال قلت بلي لنا قاص قال فمر بنا اليه قال فذهبت معه ما بين المغرب والعشاء فلما انصرف قال يا عبد الرحمن تقول قاص هذا نذير قوم يعني صالحا المري اخبرنا البرقاني اخبرنا ابراهيم بن محمد بن يحيي المزكي اخبرنا ابو العباس محمد بن اسحاق الثقفي حدثنا حاتم بن الليث الجوهري حدثنا عفان بن مسلم قال كنا ناتي مجلس صالح المري نحضره وهو يقص وكان اذا اخذ في قصصه كانه رجل مذعور يفزعك امره من حزنه وكثرة بكاءه كانه ثكلي وكان صالح شديد الخوف من الله كثير البكاء اخبرنا محمد بن عبد الواحد حدثنا محمد بن العباس قال اخبرنا احمد بن سعيد بن مرابا حدثنا عباس بن محمد قال سمعت يحيي بن معين يقول صالح المري ليس به باس روي غيره عن يحيي سوء القول في صالح قرات في كتاب ابي الحسن بن الفرات بخطه اخبرنا محمد بن العباس الضبي الهروي حدثنا يعقوب بن اسحاق بن محمود الفقيه قال قال صالح بن محمد صالح المري هو بن بشير او بشر كان يقص وليس هو في الحديث شيءا يروي احاديث مناكير عن ثابت البناني وعن الجريري وعن سليمان التيمي احاديث لا تعرف اخبرنا بن الفضل اخبرنا دعلج اخبرنا احمد بن علي الابار حدثنا ابراهيم بن سعيد قال سمعت عفان قال ذكر عند حماد بن سلمة صالح المري في حديثه عن ايوب فقال كذب اخبرنا محمد بن احمد بن رزق ومحمد بن الحسين بن الفضل قالا اخبرنا دعلج حدثنا وفي حديث بن الفضل اخبرنا الابار واخبرنا الحسن بن علي قال سمعت عفان قال حدثت حماد بن سلمة عن صالح المري بحديث فقال كذب وحدثت هماما عن صالح المري بحديث فقال كذب اخبرنا بن رزق اخبرنا هبة الله بن محمد بن حبش الفراء حدثنا محمد بن عثمان بن ابي شيبة قال سالت يحيي بن معين عن 
 اسماعيل بن ابراهيم الترجماني وقلت له انه حدثنا عن صالح المري فقال كان صالح المري ضعيفا دفع الي بن رزق اصل كتابه الذي سمعه من مكرم بن احمد القاضي فنقلت منه ثم اخبرنا الازهري اخبرنا عبيد الله بن عثمان اخبرنا مكرم حدثني يزيد بن الهيثم قال سمعت يحيي بن معين يقول صالح الذي هو قاص ليس بشء اخبرنا عبيد الله بن عمر الواعظ حدثنا ابي حدثنا محمد بن يونس حدثنا جعفر بن ابي عثمان قال قال يحيي بن معين صالح المري كان قاصا وكان كل حديث يحدث به عن ثابت باطلا اخبرني السكري اخبرنا محمد بن عبد الله الشافعي حدثنا جعفر بن محمد بن الازهر حدثنا بن الغلابي قال قال ابو زكريا صالح المري ضعيف اخبرنا عبيد الله بن عمر حدثنا ابي حدثنا محمد بن مخلد حدثنا محمد بن اسحاق قال قال يحيي بن معين وسءل عن صالح المري فقال ليس بشء اخبرنا ابو نعيم الحافظ حدثنا موسي بن ابراهيم بن النضر العطار قال حدثنا محمد بن عثمان بن ابي شيبة قال سالت عليا وهو بن المديني عن صالح المري فقال ليس بشء ضعيف ضعيف اخبرني علي بن محمد المالكي اخبرنا عبد الله بن عثمان اخبرنا محمد بن عمران الصيرفي حدثنا عبد الله بن علي بن المديني قال وسالت ابي عن صالح المري فضعفه جدا اخبرنا بن الفضل اخبرنا عثمان بن احمد الدقاق حدثنا سهيل بن احمد الواسطي قال قال ابو حفص عمرو بن علي وصالح المري ضعيف في الحديث يحدث باحاديث مناكير عن قوم تقات مثل سليمان التيمي وهشام بن حسان والحسن والجريري وثابت وقتادة وكان رجلا صالحا وكان يهم في الحديث حدثنا عبد العزيز بن احمد الكتاني حدثنا عبد الوهاب بن جعفر الميداني حدثنا عبد الجبار بن عبد الصمد السلمي حدثنا القاسم بن عيسي العصار حدثنا ابراهيم بن يعقوب الجوزجاني قال صالح المري كان قاصا واهي الحديث اخبرنا بن الفضل اخبرنا علي بن ابراهيم المستملي قال اخبرني محمد بن ابراهيم بن شعيب الغازي قال سمعت محمد بن اسماعيل البخاري يقول صالح بن بشير او بشر المري البصري القاص منكر الحديث اخبرنا احمد بن ابي جعفر اخبرنا محمد بن عدي البصري في كتابه حدثنا ابو عبيد محمد بن علي الاجري قال قلت لابي داود تكتب حديث صالح المري فقال لا اخبرنا البرقاني اخبرنا احمد بن سعيد بن سعد حدثنا عبد الكريم بن احمد بن شعيب النساءي حدثنا ابي قال صالح المري متروك الحديث اخبرنا ابو سعيد بن حسنويه اخبرنا عبد الله بن محمد بن جعفر حدثنا عمر بن احمد الاهوازي حدثنا خليفة بن خياط قال وصالح بن بشير المري يكني ابا بشر مات سنة اثنتين وسبعين وماءة اخبرنا بن الفضل اخبرنا علي بن ابراهيم حدثنا ابو احمد بن فارس حدثنا البخاري قال صالح بن بشير او بشر المري البصري القاص يقال مات سنة ست وسبعين وماءة 
   صالح بن بيان الثقفي ويقال العبدي ويعرف بالساحلي من اهل الانبار ولي قضاء سيراف وحدث عن شعبة وسفيان الثوري وفرات بن الساءب وعبد الرحمن المسعودي روي عنه الفضل بن شخيت ومحمد بن خلف الحداد واحمد بن مطهر العبدي ومحمد بن ابي سمينة التمار واسحاق بن ابي اسحاق الصفار وكان ضعيفا يروي المناكير عن الشيوخ الثقات اخبرنا احمد بن عبد الله المحاملي قال وجدت في كتاب جدي الحسين بن اسماعيل بخط يده حدثنا اسحاق بن ابي اسحاق الصفار واخبرنا عبد الغفار بن محمد بن جعفر المءدب اخبرنا ابو الفتح محمد بن الحسين الازدي حدثني جعفر بن احمد بن مجاشع الختلي ببغداد حدثنا اسحاق بن ابراهيم الصفار حدثنا صالح بن بيان الانباري الثقفي حدثنا سفيان الثوري عن ابي عبيدة عن انس قال قال النبي صلي الله عليه و سلم من سقي الماء في موضع يقدر علي الماء فله بكل شربة يشربها برا كان او فاجرا عشر حسنات تكتب له وعشر درجات ترفع له وعشر سيءات تحط عنه وان شربه العطشان فعتق نسمة فان شربه العطشان الذي قد هجم علي الموت فعتق ستين نسمة ومن سقي الماء في موضع لا يقدر علي الماء فكانما احيا الناس جميعا قلت له وما احيا الناس جميعا قال اليس اذا احييت نفسا فثوابك الجنة وكذا من احيا الناس جميعا فثوابه الجنة لفظ حديث المحاملي اخبرنا الحسين بن علي الطناجيري اخبرنا عمر بن احمد الواعظ حدثنا احمد بن محمد بن شيبة حدثنا احمد بن المطهر العبدي حدثنا صالح بن بيان قال سالت سفيان الثوري عن حديث فقال لست احدثك حتي تضمن لي ان تخرج عن بغداد فضمنت له فحدثني عن ابي عبيدة عن انس بن مالك قال قال النبي صلي الله عليه و سلم تبني مدينة بين دجلة ودجيل لهي اسرع ذهابا في الارض من الوتد الحديد في الارض الرخوة اخبرنا البرقاني قال رايت بخط الدارقطني صالح بن بيان متروك 
   صالح بن اسحاق الجهبذ حدث عن معرف بن واصل روي عنه محمد بن منصور الطوسي اخبرنا ابو نعيم الحافظ قال حدثنا سليمان بن احمد الطبراني حدثنا محمد بن العباس بن ايوب حدثنا محمد بن منصور الطوسي حدثنا صالح بن اسحاق الجهبذ دلني عليه يحيي بن معين حدثنا معرف بن واصل عن يعقوب بن ابي نباتة عن عبد الرحمن الاغر عن انس بن مالك قال قال رسول الله صلي الله عليه و سلم ان اناسا من اهل لا اله الا الله يدخلون النار بذنوبهم فيقول لهم اهل اللات والعزي ما اغني عنكم قولكم لا اله الا الله وانتم معنا في النار فيغضب الله فيخرجهم فيلقيهم في نهر الحياة فيبرءون من حروقهم كما يبرا القمر من كسوفه فيدخلون الجنة ويسمون فيها الجهنميون فقال رجل يا انس انت سمعت هذا من رسول الله صلي الله عليه و سلم فقال انس سمعت رسول الله صلي الله عليه و سلم يقول من كذب علي متعمدا فليتبوا مقعده من النار نعم انا سمعت رسول الله صلي الله عليه و سلم يقول هذا 
   صالح بن عبد الكريم العابد ذكر بن ابي حاتم انه بغدادي حدث عن فضيل بن عياض وسفيان بن عيينة روي عنه اسحاق بن موسي الانصاري ومحمد بن الحسين البرجلاني وعلي بن الموفق وغيرهم حدثنا محمد بن احمد بن رزق املاء حدثنا احمد بن سلمان الفقيه حدثنا عبد الله بن ابي الدنيا حدثني مشرف بن ابان قال سمعت صالح بن عبد الكريم قال قال لنا فضيل بن عياض تدرون لم حسنت الجنة لان عرش رب العالمين سقفها اخبرنا البرقاني حدثنا ابراهيم بن محمد بن يحيي المزكي اخبرنا محمد بن اسحاق الثقفي قال سمعت علي بن الموفق قال حدثني صالح بن عبد الكريم قال رايت غلاما اسود في طريق مكة عند ميل يصلي قلت له عبد انت قال نعم قلت فعليك ضريبة قال نعم قلت افلا اكلم مولاك ان يضع عنك قال وما الدنيا كلها فاجزع من ذلها قال فاشتريته واعتقته قال فقعد يبكي وقال اعتقتني قلت نعم قال اعتقك الله يوم القيامة وقعد يبكي ويقول اشتد علي الامر قال فناولته دنانير فابي ان ياخذها قال فحججت بعد ذلك باربع سنين فسالت عنه فقالوا غاب عنا فمذ غاب عنا قحطنا وصار الي جدة كتب الي عبد الرحمن بن عثمان الدمشقي وحدثنيه عنه ابو طاهر محمد بن احمد ابي الصقر الخطيب بالانبار قال حدثنا خيثمة بن سليمان الاطرابلسي حدثنا ابو العباس النساءي صاحب ابي ثور قال سمعت بعض الاشياخ يقول قال لي صالح بن عبد الكريم يوما ايش في كمك يا ابا يوسف قلت حديث قال يا اصحاب الحديث ما كان ينبغي ان يكون احد ازهد منكم انما تقلبون ديوان الموتي لعل ليس بينك وبين النبي صلي الله عليه و سلم في كتابك احد الا وقد مات اخبرني الحسن بن ابي بكر اخبرنا محمد بن ابراهيم الجوري في كتابه قال اخبرنا احمد بن حمدان بن الخضر حدثنا احمد بن يونس الضبي حدثني ابو حسان الزيادي قال سنة ثمان وماءتين فيها مات صالح بن عبد الكريم العابد 
   صالح بن نصر بن مالك بن الهيثم ابو الفضل الخزاعي هو اخو احمد بن نصر الشهيد سمع بن ابي ذءب وشعبة بن الحجاج وشريك بن عبد الله النخعي واسماعيل بن عياش والمبارك بن سعيد اخا سفيان الثوري والهيثم بن عدي الطاءي روي عنه منصور بن ابي مزاحم وخالد بن خداش ومحمد بن عبد الملك بن زنجويه وعباس بن محمد الدوري واحمد بن ابي خيثمة النساءي اخبرنا عبد الملك بن محمد بن عبد الله الواعظ اخبرنا ابو سهل احمد بن محمد بن عبد الله بن زياد القطان حدثنا احمد بن ابي خيثمة حدثنا صالح بن نصر حدثنا شعبة عن قتادة عن ابي الاسود الدءلي قال نزل القران بلسان الكعبين كعب بن لءي وكعب بن عمرو قال فقال خالد بن سلمة لسعد بن ابراهيم الا تسمع ما يقول هذا الاعمي نزل القران بلسان الكعبين وانما نزل بلسان قريش تفرد به صالح بن نصر عن شعبة انبانا محمد بن جعفر بن علان واحمد بن محمد بن عبد الله الكاتب قالا اخبرنا مخلد بن جعفر حدثنا محمد بن جرير الطبري قال صالح بن نصر بن مالك بن الهيثم الخزاعي كان ثقة وكان من ساكني بغداد وبها كانت وفاته في سنة تسع عشرة وماءتين
   صالح بن اسحاق ابو عمر الجرمي النحوي صاحب الكتاب المختصر في النحو قدم بغداد وناظر بها يحيي بن زياد الفراء وقيل انه مولي بجيلة بن انمار بن اراش بن الغوث بن خثعم وقيل له الجرمي لانه كان ينزل في جرم وكان ممن اجتمع له مع العلم صحة المذهب وحسن الاعتقاد واسند الحديث عن يزيد بن زريع ويحيي بن كثير الكاهلي روي عنه احمد بن ملاعب المخرمي وابو خليفة الجمحي وغيرهما اخبرنا ابو بكر عبد القاهر بن محمد بن عترة الموصلي اخبرنا ابو هارون موسي بن محمد بن هارون الانصاري الزرقي حدثنا احمد بن ملاعب حدثنا صالح بن اسحاق الجرمي حدثنا يحيي بن كثير وكان يثني عليه خيرا قال حدثنا هشام بن حسان عن بن سيرين عن ابي هريرة قال قال رسول الله صلي الله عليه و سلم كان رجل فيمن كان قبلكم يبايع بالامانة فجاءه رجل فبايعه بالامانة فحضره الاجل وقد خب البحر وفسد فلم يقدر علي اتيانه فنقر خشبة وجعل فيها زنة ذلك الذهب وذكر ذلك الحديث قال عبد القاهر كذا في كتاب ابي هارون اخبرنا ابو الحسين محمد بن عبد الواحد بن علي البزار اخبرنا ابو سعيد الحسن بن عبد الله السيرافي قال ابو عمر الجرمي اسمه صالح بن اسحاق وهو مولي لجرم بن ريان وجرم من قباءل اليمن وقال ابو العباس محمد بن يزيد هو مولي لبجيلة بن انمار بن اراش بن الغوث قال ابو سعيد اخذ ابو عمر النحو عن الاخفش وغيره ولقي يونس بن حبيب ولم يلق سيبويه واخذ اللغة عن ابي عبيدة وابي زيد والاصمعي وطبقتهم وكان ذا دين واخا ورع اخبرنا القاضي ابو العلاء محمد بن علي الواسطي اخبرنا محمد بن جعفر التميمي بالكوفة اخبرنا ابو الحسن العروضي اخبرنا ابو اسحاق الزجاج قال سمعت ابا العباس المبرد يقول كان الجرمي اثبت القوم في كتاب سيبويه وعليه قراءة الجماعة وكان عالما باللغة حافظا لها وله كتب انفرد بها وقال العروضي ايضا اخبرنا الزجاج عن محمد بن يزيد قال كان الجرمي جليلا في الحديث والاخبار وله كتاب في السيرة عجيب اخبرني علي بن ابي علي حدثنا احمد بن يوسف بن يعقوب بن اسحاق التنوخي اخبرنا ابو سعيد داود بن الهيثم حدثنا ابو العباس ثعلب قال قال لي بن قادم قدم ابو عمر الجرمي علي الحسن بن سهل فقال لي الفراء بلغني ان ابا عمر الجرمي قدم وانا احب ان القاه فقلت له فاني اجمع بينكما فاتيت ابا عمر فاخبرته فاجاب الي ذلك وجمعت بينهما فلما نظرت الي الجرمي قد غلب الفراء وافحمه ندمت علي ذلك قال ثعلب قلت له ولم ندمت علي ذلك فقال لي لان علمي علم الفراء فلما رايته مقهورا قل في عيني ونقص علمه عندي سمعت ابا القاسم عبد الواحد بن علي الاسدي يقول مات الجرمي في سنة خمس وعشرين وماءتين 
   صالح بن عبد الله ابو عبد الله الترمذي سكن بغداد وحدث بها عن مالك بن انس وحماد بن يحيي الابح وعبد الوارث بن سعيد وعبثر بن القاسم وشريك بن عبد الله وجعفر بن سليمان وفرج بن فضالة وابي النضر يحيي بن كثير ويحيي بن زكريا بن ابي زاءدة وعمر بن هارون البلخي ومحمد بن فضيل بن غزوان ومعاذ بن معاذ العنبري روي عنه محمد اسحاق الصاغاني وعباس بن محمد الدوري واحمد بن زياد السمسار وابو بكر بن ابي الدنيا وعبد الله بن احمد بن حنبل وصالح بن محمد جزرة وابو زرعة وابو حاتم الرازيان وقال ابو حاتم هو صدوق اخبرنا محمد بن الحسين بن محمد الازرق حدثنا ابو سهل احمد بن محمد بن عبد الله القطان حدثنا عبد الله بن احمد بن حنبل حدثني صالح بن عبد الله الترمذي حدثنا سفيان بن عامر وكان رجلا صالحا قال صالح حدثني عمر بن هارون عن سفيان بن عامر هذا غير الحديث عن عبد الله بن طاوس قال اشهد علي والدي طاوس انه قال اشهد علي جابر بن عبد الله انه قال اشهد علي رسول الله صلي الله عليه و سلم انه قال امرت ان اقاتل الناس حتي يقولوا لا اله الا الله فاذا قالوها عصموا بها مني دماءهم واموالهم فيما عشت الا بحقها وحسابهم علي الله تعالي اخبرني ابو الوليد الحسن بن محمد الدربندي اخبرنا محمد بن احمد بن محمد بن سليمان الحافظ ببخاري حدثنا ابو بكر احمد بن سعد بن نصر حدثنا ابو علي صالح بن محمد حدثنا صالح بن عبد الله الترمذي املاه علينا ببغداد حدثنا يحيي بن كثير ابو النضر حدثنا عطاء بن الساءب عن ابي عبد الرحمن السلمي قال حدثني النفر الذين كانوا يقرءونا من اصحاب رسول الله صلي الله عليه و سلم عثمان بن عفان وعبد الله بن مسعود وابي بن كعب ان رسول الله صلي الله عليه و سلم كان يعلمهم القران عشرا عشرا فلا يجاوزونها الي غيرها حتي يعلموا ما فيها اخبرنا بن الفضل اخبرنا علي بن ابراهيم حدثنا ابو احمد بن فارس حدثنا البخاري قال مات صالح بن عبد الله الترمذي سنة نيف وثلاثين وماءتين او نحوها اخبرنا علي بن السمسار حدثنا عبد الله بن عثمان الصفار قال حدثنا عبد الباقي بن قانع ان صالح بن عبد الله الترمذي مات بمكة في سنة احدي وثلاثين وماءتين اخبرني الطناجيري حدثنا عمر بن احمد الواعظ قال وجدت في كتاب جدي سمعت احمد بن محمد بن بكر قال بلغني موت صالح بن عبد الله الترمذي سنة تسع وثلاثين وماءتين اخبرنا احمد بن ابي جعفر اخبرنا محمد بن المظفر قال قال عبد الله بن محمد البغوي سنة تسع وثلاثين وماءتين مات صالح الترمذي فيها 
   صالح بن مالك ابو عبد الله الخوارزمي سكن بغداد وحدث بها عن عبد العزيز بن عبد الله الماجشون وعبد الاعلي بن ابي المساور وصالح المري وابي عبيدة الناجي وحفص بن سليمان البزاز وابي مسلم قاءد الاعمش وعيسي بن يونس روي عنه ابو بكر بن ابي الدنيا وعبد الله بن احمد بن حنبل وابراهيم بن عبد الله المخرمي وابو القاسم البغوي وكان صدوقا اخبرنا محمد بن عمر بن القاسم النرسي اخبرنا محمد بن عبد الله الشافعي حدثنا عبد الله بن احمد بن حنبل حدثنا صالح بن مالك حدثنا عبد الاعلي بن ابي المساور حدثنا حماد عن ابراهيم عن علقمة عن عبد الله قال لقد صمنا مع رسول الله صلي الله عليه و سلم تسعا وعشرين اكثر مما صمنا ثلاثين
   صالح بن حرب بن خالد ابو معمر مولي سليمان بن علي بن عبد الله بن العباس حدث عن عبد الاعلي بن عبد الاعلي السامي وسلام بن ابي خبزة وخالد بن يزيد الهدادي واسماعيل بن يحيي التميمي روي عنه ابو بكر بن ابي الدنيا وعبيد العجل واحمد بن ابي عوف البزوري وعبد الله بن محمد بن ناجية وابو حامد محمد بن هارون الحضرمي اخبرني محمد بن الفرج بن علي البزاز اخبرنا عبد الله بن ابراهيم الزبيبي حدثنا احمد بن عبد الرحمن بن مرزوق البزروي حدثنا ابو معمر صالح بن حرب مولي سليمان بن علي الهاشمي قال حدثنا اسماعيل بن يحيي قال حدثنا عبد الله بن عمر عن نافع عن بن عمر عن صهيب قال سمعت النبي صلي الله عليه و سلم يقول لا يدخل الجنة الا من قال بالمال هكذا وهكذا يمنة ويسري انبانا احمد بن علي الاصبهاني اخبرنا ابو احمد محمد بن محمد الحافظ النيسابوري قال ابو معمر صالح بن حرب الهاشمي مولاهم سكن بغداد 
   صالح بن حكيم ابو سعيد البصري التمار نزل سر من راي وحدث بها عن مسلم بن ابراهيم ذكره عبد الرحمن بن ابي حاتم الرازي وقال كتبت عنه مع ابي بسامرا
   صالح بن خلف بن داود بن سعيد بن عبد الله الجواربي حدث عن داود بن مهران الدباغ وعاصم بن علي وموسي بن ابراهيم المروزي روي عنه ابنه محمد بن صالح وقد ذكرنا له حديثا في باب احمد
   صالح بن احمد بن محمد بن حنبل بن هلال بن اسد ابو الفضل الشيباني سمع اباه وابا الوليد الطيالسي وابراهيم بن الفضل الذارع وعلي بن المديني روي عنه ابنه زهير وابو القاسم البغوي ومحمد بن جعفر الخراءطي ويحيي بن صاعد ومحمد بن مخلد وقال بن ابي حاتم كتبت عنه باصبهان وهو صدوق ثقة قلت وكان قد ولي قضاء اصبهان وخرج اليها فمات بها اخبرني ابو يعلي محمد بن الحسين بن محمد الفراء قال وجدت في كتاب عبد العزيز صاحب الزجاج قال ابو بكر بن ابي صالح العكبري قدم صالح بن احمد من طرطوس وقد كان ولي القضاء بها فكان يجلس ببغداد للفقه فجاءت عجوز فقالت من منكم صالح فدخلت فوقفت به وقالت صالح كيف اصبحت فرفع راسه اليها وقال ايش هذا فقالت له اني لاعرف اباك وهو يخرج ولا شء علي راسه ما رفعه بهذه يعني الطويلة انما رفعه من فوق قال لي ابو يعلي وذكر ابو بكر الخلال في كتاب ادب القضاة من الجامع قال اخبرني محمد بن العباس قال حدثني محمد بن علي قال لما صار صالح الي اصبهان وكنت معه اخرجني هو ودخل اصبهان فبدا بمسجد الجامع فدخله وصلي ركعتين واجتمع الناس والشيوخ وجلس وقرء عهده الذي كتب له الخليفة جعل يبكي بكاء شديدا حتي غلبه فبكي الشيوخ الذين قربوا منه فلما فرغ من قراءة العهد جعل المشايخ يدعون له ويقولون له ما ببلدنا احد الا وهو يحب ابا عبد الله ويميل اليك فقال لهم تدرون ما الذي ابكاني ذكرت ابي ان يراني في مثل هذا الحال وكان عليه السواد قال كان ابي يبعث خلفي اذا جاءه رجل زاهد او رجل متقشف لانظر اليه يحب ان اكون مثله افتراني مثله ولكن الله يعلم ما دخلت في هذا الامر الا لدين قد غلبني وكثرة عيال احمد الله وكان صالح غير مرة اذا انصرف من مجلس الحكم يترك سواده ويقول لي تراني اموت وانا علي هذا اخبرنا علي بن ابي علي قال انشدنا محمد بن العباس الخزاز قال انشد ابو القاسم التوزي ابي وانا اسمع للعباس الخياط في صالح بن احمد بن حنبل ... جاد بدينارين لي صالح ... اصلحه الله واخزاهما ... ... فواحد تحمله ذرة ... ويلعب الريح باقواهما ... ... بل لو وزنا لك ظليهما ... ثم عمدنا فوزناهما ... ... لكان لا كانا ولا افلحا ... عليهما يرجح ظلاهما ... قلت قد اعتدي هذا القاءل في قوله وما ذكر به صالحا لانه كان من السماحة علي خلاف ما ذكره حدثت عن عبد العزيز بن جعفر قال حدثنا ابو بكر الخلال قال كان صالح بن احمد بن حنبل سخيا جدا اخبرني الحسن بن علي الفقيه بالمصيصة قال كان صالح قد افتصد فدعا اخوانه قال وانفق في ذلك اليوم نحوا من عشرين دينارا في طيب وغيره واحسب قال كان في الدعوة بن ابي مريم وذكر عدة قال فاذا ابو عبد الله قد دق الباب قال فقال له بن ابي مريم اسبل علينا الستر لا نفتضح ولا يشم ابو عبد الله راءحة الطيب قال فدخل ابو عبد الله فقعد في الدار وساله عن احواله وقال له خذ هذين الدرهمين فانفقها اليوم وقام فخرج فقال بن ابي مريم لصالح فعل الله بك وفعل لم اردت ان تاخذ الدرهمين منه سمعت ابا نعيم الحافظ يقول صالح بن احمد بن حنبل قدم اصبهان قاضيا عليها وتوفي بها سنة خمس وستين وماءتين اخبرنا محمد بن عبد الواحد حدثنا محمد بن العباس قال قرء علي بن المنادي وانا اسمع قال وكان صالح بن احمد بن حنبل قد ولي القضاء باصبهان فخرج من ها هنا فمات بها وذلك في شهر رمضان سنة ست وستين وله حينءذ ثلاث وستون سنة كان مولده في سنة ثلاث وماءتين 
   صالح بن محمد بن عبد الله بن زياد بن دراج وقيل درعاز ابو توبة الكاتب سمع ابا العتاهية الشاعر وابا عمرو الشيباني وهارون بن حاتم وابا سعيد الاصمعي ومحمد بن زياد بن الاعرابي حدث عنه ابو علي الحسن بن عليل العنزي ومحمد بن خلف بن المرزبان ومحمد بن عبد الملك التاريخي وابو عبد الله الحكيمي اخبرنا علي بن المحسن المعدل حدثنا احمد بن محمد بن يعقوب الكاغدي حدثنا محمد بن احمد الحكيمي حدثنا ابو توبة صالح بن محمد بن دراج الكاتب قال انشدنا بن الاعرابي ... كانت سليمي اذا ما جءت طارقها ... واخمد الليل نار الموقد الصالي ... ... قارورة من عبير عند ذي لطف ... من الدنانير كالوه بمثقال 
   صالح بن الهيثم ابو علي الطحان حدث عن ابي الوليد الطيالسي روي عنه ابو الحسين بن المنادي وذكر انه سمع منه بحضرة جده ابي جعفر محمد بن عبيد الله المنادي
   صالح بن محمد بن عبد الله بن عبد الرحمن ابو الفضل الرازي سكن بغداد في مربعة ابي عبيد الله من الجانب الشرقي وحدث عن عباد بن موسي الازرق وعفان بن مسلم ومحمد بن عمر القصبي وسليمان بن حرب ومعاوية بن عمرو وعاصم بن علي وسعيد بن سليمان والحسن بن بشر بن سلم وعلي بن الجعد والحكم بن موسي وخالد بن خداش ويحيي بن ايوب العابد روي عنه ابو عمرو بن السماك واحمد بن الفضل بن خزيمة وعبد الصمد بن علي الطستي وابو بكر بن كامل وابو سهل بن زياد وابو بكر الشافعي وذكره الدارقطني فقال ثقة اخبرنا عبد الملك بن محمد بن عبد الله الواعظ اخبرنا ابو علي احمد بن الفضل بن العباس بن خزيمة حدثنا صالح بن محمد الرازي حدثنا عفان حدثنا همام حدثنا قتادة عن ابي نضرة قال قلت لجابر بن عبد الله ان بن الزبير نهي عن المتعة وان بن عباس يامر بها قال علي يدي جري الحديث تمتعنا مع رسول الله صلي الله عليه و سلم ومع ابي بكر اخبرنا محمد بن عبد الواحد حدثنا محمد بن العباس قال قرء علي بن المنادي وانا اسمع قال وتوفي من جانبنا الشرقي ابو الفضل صالح بن محمد الرازي لايام خلت من شوال سنة ثلاث وثمانين قرات علي الحسن بن ابي بكر عن احمد بن كامل القاضي قال وتوفي ابو الفضل صالح بن محمد الرازي المولد لايام خلت من العشر الاول من شوال سنة ثلاث وثمانين وماءتين كان ثقة مامونا قارءا للقران وفي حفظي عن ابي بكر احمد بن محمد بن غزال انه قال سمعت صالح بن محمد الرازي يقول ختمت القران اربعة الاف ختمة ولم يغير شيبه 
   صالح بن عمران بن حرب وقيل صالح بن عمران بن صالح بن عمران بن عبد الله ابو شعيب الدعا بخاري الاصل سمع سعيد بن داود الزنبري وابا نعيم الفضل بن دكين وابا غسان النهدي وسليمان بن حرب ومسلم بن ابراهيم وعفان بن مسلم وعبيد الله العيشي والحسن بن بشير بن سلم وابا عبيد القاسم بن سلام ومحمد بن حميد الرازي روي عنه يحيي بن محمد بن صاعد واحمد بن كامل القاضي واسماعيل بن علي الخطبي وابو بكر الشافعي وغيرهم وقال الدارقطني لا باس به اخبرنا محمد بن عبد الواحد الاكبر حدثنا محمد بن العباس قال قرء علي بن المنادي وانا اسمع قال وابو شعيب الدعا واسمه صالح بن عمران كتب الناس عنه ولم يكن بذاك القوي اخبرنا محمد بن احمد بن رزق اخبرنا اسماعيل بن علي الخطبي قال ومات ابو شعيب الدعا صالح بن عمران بن حرب يوم السبت لتسع بقين من ذي القعدة سنة خمس وثمانين وماءتين
   صالح بن مقاتل بن صالح الاعور حدث عن ابيه روي عنه ابو الطيب احمد بن محمد بن اسماعيل المنادي وابو سهل بن زياد وعبد الباقي بن قانع القاضي وذكره الدارقطني فقال ليس بقوي اخبرنا عبد الملك بن محمد الواعظ اخبرنا عبد الباقي بن قانع حدثنا صالح بن مقاتل حدثنا ابي حدثنا محمد بن الزبرقان عن نصر بن طريف عن قتادة عن انس قال كان رسول الله صلي الله عليه و سلم من اخف الناس صلاة في تمام اخبرنا السمسار اخبرنا الصفار حدثنا بن قانع ان صالح بن مقاتل بن صالح الاعور مات في سنة سبع وثمانين وماءتين اخبرنا محمد بن عبد الواحد حدثنا محمد بن العباس قال قرء علي بن المنادي وانا اسمع ان صالح بن مقاتل الذي كان عنده احاديث هدبة بن المنهال مات اما في اخر المحرم واما في اول صفر سنة تسع وثمانين وماءتين 
   صالح بن محمد بن عمرو بن حبيب بن حسان بن المنذر بن عمار ابي الاشرس الاسدي مولي اسد بن خزيمة يكني ابا علي ويقلب جزرة وكان حافظا عارفا من اءمة الحديث وممن يرجع اليه في علم الاثار ومعرفة نقلة الاخبار رحل كثير ولقي المشايخ بالشام ومصر وخراسان وانتقل عن بغداد الي بخاري فسكنها فحصل حديثه عند اهلها وحدث دهرا طويلا من حفظه ولم يكن معه كتاب استصحبه وكان قد سمع من سعيد بن سليمان وعلي بن الجعد وخالد بن خداش وعبيد الله العيشي وابي نصر التمار وهدبة بن خالد وابراهيم بن الحجاج السامي ويحيي بن معين ومنجاب بن الحارث وعلي بن المديني وابي بكر وعثمان والقاسم بني ابي شيبة ومحمد بن عبد الله بن نمير ويحيي بن الحماني وابي الربيع الزهراني واحمد بن صالح المصري وهشام بن عمار الدمشقي والحكم بن موسي والهيثم بن خارجة وهارون بن معروف وابراهيم بن زياد سبلان وابراهيم بن المنذر الحزامي وداود بن عمرو الضبي ونوح بن حبيب القومسي ووهب بن بقية الواسطي ومحمد بن عباد المكي وسريج بن يونس وخلق كثير غيرهم وكان صدوقا ثبتا امينا وكان ذا مزاح ودعابة مشهورا بذلك اخبرني محمد بن احمد بن يعقوب اخبرنا محمد بن عبد الله النيسابوري قال سمعت ابا زكريا يحيي بن محمد العنبري يقول سمعت ابا حامد بن الشرقي يقول كان صالح جزرة يقرا علي محمد بن يحيي الزهريات فلما بلغ حديث عاءشة انها كانت تسترقي من الخرزة قال من الجزرة فلقب بجزرة قلت هذا غلط لان صالحا لقب جزرة قديما في حداثته وكان سبب 
 ذلك ما اخبرنا ابو سعد الماليني قراءة اخبرنا عبد الله بن عدي الحافظ قال سمعت محمد بن احمد بن سعدان يقول سمعت صالحا يعني جزرة يقول قدم علينا بعض الشيوخ من الشام وكان عنده عن جرير بن عثمان فقرات انا عليه حدثكم جرير بن عثمان قال كان لابي امامة خرزة يرقي بها المريض فصحفت الخرزة فقلت كان لابي امامة جزرة وانما هو خرزة واما البرقاني فقال سمعت ابا حاتم بن ابي الفضل الهروي بها وسالته لم قيل لصالح البغدادي جزرة فقال حدثني ابي انه كان يقرا علي شيخ ان عبد الله بن بشر كان يرقي ولده بخرزة فجري علي لسانه بجزرة فلقب بذلك قلت لابي حاتم هل غمز بشء فقال كان متثبتا في الحديث جدا ولكن كان ربما يطنز كما يكون في البغداديين كان ببخاري رجل حافظ يلقب بجمل فكان صالح وهذا الحافظ يمشيان ببخاري فاستقبلهما جمل عليه وقر جزر فاراد ذلك الحافظ ان يخجل صالحا فقال يا ابا علي ما هذا الذي علي البعير فقال له صالح اما تعرفه قال لا قال هذا انا عليك اراد جزر علي جمل اخبرنا القاضي ابو العلاء محمد بن علي الواسطي اخبرنا عبد الله بن موسي السلامي اجازة قال قال لي ابو نوح سنان بن الاغر الاديب قال لي ابو علي صالح بن محمد البغدادي كان ببغداد شاعران احدهما صاحب حديث والاخر معتزلي فاجتاز بي المعتزلي يوما فقال لي يا بني كم تكتب يذهب بصرك ويحد ودب ظهرك وتزدار قبرك ثم اخذ كتابي وكتب عليه ... ان القراءة والتف قه ... والتشاغل بالعلوم ... ... اصل المذلة والاضا قة ... والمهانة والهموم ... قال ثم ذهب وجاء الاخر فقرا هذين البيتين فقال كذب عدو نفسه بل يرتفع ذكرك وينتشر علمك ويبقي اسمك مع اسم رسول الله صلي الله عليه و سلم الي يوم القيامة ثم كتب هذين البيتين 
 ان التشاغل بالدفا تر ... والكتابة والدراسة ... ... اصل التقية والتزهد ... والرياسة والسياسة ... اخبرنا الازهري اخبرنا علي بن عمر الحافظ قال صالح بن محمد الحافظ البغدادي لقبه جزرة وهو من ولد حبيب بن ابي الاشرس وقع الي بخاري واقام بها حتي مات وحديثه عند البخاريين وكان ثقة صدوقا حافظا عارفا حدثني الحسين بن محمد اخو الخلال عن ابي سعيد عبد الرحمن بن محمد الادريسي قال صالح بن محمد ابو علي الحافظ الملقب بجزرة ما اعلم كان في عصره بالعراق وخراسان في الحفظ مثله دخل خراسان وما وراء النهر فحدث بها مدة طويلة من حفظه من غير كتاب او اصل يصحبه وما اعلم اخذ عليه مما حدث خطا او شء ينقم عليه رايت ابا احمد بن عدي الحافظ بجرجان يفخم امره ويعظمه ويفضله بالحفظ علي غيره اخبرنا ابو بكر بن عبد الله بن علي بن حمويه الهمذاني بها اخبرنا احمد بن عبد الرحمن الشيرازي قال سمعت ابا اسحاق ابراهيم بن احمد المستملي ببلخ يقول سمعت ابا حفص محمد بن حامد بن ادريس البخاري يقول سمعت صالحا جزرة يقول عبرت جيحونكم وما معي كتاب حدثني محمد بن علي الصوري لفظا حدثني عبد الغني بن سعيد الحافظ قال سمعت حمزة بن محمد هو الكناني يقول سمعت ابا بكر محمد بن محمد الباغندي يقول كنا في مجلس عثمان بن ابي شيبة ومعنا صالح جزرة فقال رجل من اصحاب الحديث لصالح من روي عن المغيرة بن شعبة حديث المسح علي الخفين قال فقال له صالح رواه ابو سلمة بن عبد الرحمن وعروة بن المغيرة بن شعبة وذكر جماعة قال فقال له بقي عليك قد روي هذا عن المغيرة خلق كثير نحو الاربعين قال فقال له صالح يا هذا قد ذكرت لك جمهور الرواة عنه وفي ذلك كفاية او كما قال ولكن من روي عن المغيرة بن شعبة ان امراتين اقتتلتا فرمت احداهما 
 الاخري بعمود قال فبلح الرجل ولم يات بشء فقال له يا اعمي القلب اليس الساعة قرء علي ابي الحسن عثمان بن ابي شيبة عن غندر عن شعبة عن منصور عن ابراهيم عن عبيد عن نضيلة عن المغيرة بن شعبة قال الباغندي ويضرب الدهر ضربه واجتمع انا وصالح بمصر فنحن في الجامع اذ اقبل ذلك الرجل فقعد معنا ثم التفت الي صالح جزرة فقال له ما اسند ابان بن تغلب قال فقال له صالح ومن ابان حتي يهتم بحديثه او يجمع قال واساء عليه الثناء في مذهبه انفع من هذا ايش اسند سعيد بن المسيب عن ابي هريرة ما عند الزهري عنه ما عند يحيي بن سعيد عنه ما عند علي بن يزيد بن جدعان عنه قال فبلح الرجل قال الباغندي فوقع لسعيد بن المسيب في ذلك الوقت في قلبي حلاوة فما زلت اجمعه او كما قال حمزة اخبرني ابو الوليد الدربندي اخبرنا محمد بن احمد بن محمد بن سليمان الحافظ ببخاري حدثنا ابو نصر احمد بن محمد بن الحسين قال سمعت ابا سعيد جعفر بن محمد بن محمد الطستي يقول كنا ببغداد سنة احدي وتسعين وماءتين عند ابي مسلم الكجي وكان معنا عبد الله بن عامر بن اسد فقال مستملي ابي مسلم لابي مسلم ان هذا الشيخ يعني عبد الله مستملي صالح فقال ابو مسلم ومن صالح فقال صالح الجزري فقال ابو مسلم ويحكم ما اهونه عندكم لا تقولون سيد الدنيا ولا سيد المسلمين تقولون صالح الجزري قال وكنا في اخريات الناس فقدمنا بعد ذلك حتي جلسنا بين يديه فقال كيف اخي وكبيري وقال لنا ما تريدون فقلنا احاديث بن عرعرة وحكايات الاصمعي فاملي علينا عن ظهر قلبه ومات ببغداد بعد خروجنا اخبرني محمد بن احمد بن يعقوب اخبرنا محمد بن نعيم الضبي قال سمعت ابا احمد علي بن محمد المروزي يقول سمعت صالحا جزرة يقول كان هشام بن عمار ياخذ علي الحديث ولا يحدث ما لم ياخذ فدخلت عليه يوما فقال يا ابا علي حدثني بحديث لعلي بن 
 الجعد فقلت حدثنا علي بن الجعد حدثنا ابو جعفر الرازي عن الربيع بن انس عن ابي العالية قال علم مجانا كما علمت مجانا فقال تعرضت بي يا ابا علي فقلت ما تعرضت بك بل قصدتك قرات علي الحسين بن محمد بن الحسن المءدب عن عبد الرحمن بن محمد الاستراباذي قال سمعت ابا احمد عبد الله بن عدي الحافظ يقول سمعت عصمة بن بجماك البخاري بمصر يقول سمعت صالحا جزرة يقول كنت شارطت هشام بن عمار علي ان اقرا عليه كل ليلة بانتخابي ورقة فكنت اخذ الكاغد الفرعوني واكتب مقرمطا فكان اذا جاء الليل اقرا عليه الي ان يصلي العتمة فاذا صلي العتمة يقعد واقرا عليه فيقول يا صالح ليس هذه ورقة هذه شقة قال وسمعت صالحا جزرة يقول الاحول في المنزل مبارك يري الشء شيءين اخبرنا البرقاني قال قال لي ابو حاتم بن ابي الفضل الهروي بلغني ان صالحا يعني جزرة سمع بعض الشيوخ يقول ان السين والصاد يتعاقبان قال فسال بعض تلامذته عن كنية الشيخ فقال له ابو صالح قال فقلت للشيخ يا ابا سالح اسلحك الله هل يجوز ان تقرا نحن نقس عليك احسن القسس قال فقال لي بعض تلامذته اتواجه الشيخ بهذا فقلت انه يكذب انما تتعاقب السين والصاد في بعض المواضع وهذا يذكره علي الاطلاق اخبرني محمد بن احمد بن يعقوب اخبرنا محمد بن نعيم قال سمعت ابا احمد بكر بن محمد الصيرفي بمرو يقول سمعت صالحا جزرة يقول كان عبد الله بن عمر بن ابان يمتحن كل من يجءه من اصحاب الحديث فانه كان غاليا في التشيع فدخلت عليه فقال من حفر بءر زمزم قلت معاوية بن ابي سفيان قال فمن نقل ترابها قلت عمرو بن العاص فصاح وزبرني ودخل منزله وقال بن نعيم سمعت ابا النضر الفقيه يقول كنا نقرا علي صالح جزرة وهو عليل فتحرك فبدت عورته فاشار اليه بعض اهل المجلس بان يجمع عليه ثيابه فقال رايته لا ترمد عينيك ابدا اخبرني محمد بن علي المقرء اخبرنا محمد بن عبد الله 
 ابو عبد الله الحافظ قال سمعت ابا الوليد حسان بن محمد الفقيه يقول سمعت الوزير ابا الفضل البلعمي يقول لمحمد بن خزيمة انه سمع كتاب المزني من صالح جزرة قال فصاح محمد بن اسحاق وقال صالح لم يسمع هذا الكتاب من المزني قط فكيف قرا عليكم هو ركن من اركان الحديث لا يتهم بالكذب فخجل ابو الفضل البلعمي من مقالته تلك وكتب الي بخاري في ذلك قال فكتبوا اليه انهم سالوا صالحا عندك مختصر المزني فقال نعم فاستاذنوه في قراءته فاذن لهم فقراوه عليه فلما فرغوا من قراءته قالوا كما قرانا عليك قال نعم فساله بعضهم حدثكم المزني قال ولا حرفا كنت انا بمصر اتفرغ الي سماع هذا انما كان المزني يجالسنا ونجالسه وسالتموني عندك الكتاب قلت نعم وكان عندي منه نسخة فاستاذنتموني في قراءة الكتاب فاذنت لكم ولم تطالبوني بسماعي منه الي الان وقال ابو عبد الله سمعت ابا علي خلف بن محمد البخاري يقول حضرت قراءة كتاب المزني علي ابي علي صالح وجوابه اياهم عند الفراغ فقال لهم كنت بمصر وبها جماعة يحدثون عن الليث وبن لهيعة والمزني ممن يختلف معنا اليهم كنت اتفرغ له حتي يحدثني بالارسال عن الشافعي من كلامه اخبرني محمد بن علي المقرء اخبرنا محمد بن عبد الله النيسابوري الحافظ قال سمعت ابا عبد الله محمد بن العباس يقول سمعت ابا الفضل بن اسحاق يقول كنت عند صالح جزرة فدخل عليه رجل من اهل الرستاق فاخذ يساله عن المحدثين ويكتب جوابه فيهم فقال له يا ابا علي ما تقول في سفيان الثوري فقال صالح كذاب فكتب ذلك الرجل فتعجبت من ذلك فقلت يا ابا علي هذا لا يحل لك فان الرجل يتوهم انك قلته علي الحقيقة فيحكيه عنك فقال ما اعجبك من يسال مثلي عن مثل سفيان الثوري يفكر فيه ان يحكي او لا يحكي اخبرني محمد بن احمد بن يعقوب اخبرنا محمد بن نعيم قال سمعت احمد بن سهل الفقيه ببخاري يقول كنت مع صالح جزرة جالسا علي باب داره اذ اقبل ابنه وعن يمينه رجل اقصر منه وعن يساره صبي فقال صالح يا ابا نصر تبت اخبرني ابو الوليد الدربندي اخبرنا محمد بن احمد بن محمد بن سليمان الحافظ حدثنا خلف بن محمد قال سمعت ابا الحسن علي بن صالح بن محمد يقول ولد ابي بالكوفة في سنة عشر وماءتين وقدم بخاري في ربيع الاخر سنة ست وستين وماءتين ومات يوم الثلاثاء لثمان بقين من ذي الحجة سنة ثلاث وتسعين وماءتين اخبرنا ابو نعيم الحافظ قال سمعت ابا محمد عبد الله بن محمد بن جعفر بن حيان يقول سمعت احمد بن محمود بن صبيح يقول سنة ثلاث وتسعين فيها مات صالح بن محمد الحافظ جزرة ببخاري اخبرني يعقوب اخبرنا محمد بن نعيم قال سمعت ابا صالح خلف بن محمد بن اسماعيل البخاري يقول مات صالح بن محمد البغدادي الملقب بجزرة ببخاري في ذي الحجة سنة ثلاث وتسعين وماءتين حدثنا محمد بن عبد الواحد قال حدثنا محمد بن العباس قال قرء علي بن المنادي وانا اسمع قال وجاءتنا من سمرقند وفاة صالح بن محمد بن معروف بجزرة سنة اربع وتسعين اخبرني اخو الخلال عن ابي سعد الادريسي ان صالح بن محمد مات ببخاري في سنة اربع وتسعين وماءتين 
   صالح بن عبد الله مولي المعتمد علي الله امير المءمنين حدث عن عثمان بن ابي شيبة روي عنه عبد الله بن عدي الجرجاني وذكر انه سمع منه بسر من راي
   صالح بن محمد ابو علي الجلاب حدث بدمشق وبمصر عن ابي عمرو حفص بن عمر الدوري ويعقوب الدورقي ورزق الله بن موسي الاسكاف واسحاق بن بهلول التنوخي ومحمد بن اسماعيل الحساني روي عنه الحسن بن حبيب الدمشقي كتب الينا عبد الرحمن بن عثمان الدمشقي يذكر ان الحسن بن حبيب بن عبد الملك الفقيه اخبرهم قال حدثنا ابو علي صالح بن محمد الجلاب بغدادي حدثنا ابو عمر حفص بن عمر الازدي حدثنا محمد بن عبد الاعلي الكوفي الكناسي عن عمرو بن ذر الهمذاني عن ابيه قال قال رسول الله صلي الله عليه و سلم ان الله تعالي عند لسان كل قاءل فليتق الله عبد ولينظر ماذا يقول اخبرنا محمد بن الحسين الازرق اخبرنا ابو سهل احمد بن محمد بن عبد الله القطان حدثنا محمد بن الفرج الازرق حدثنا محمد بن كناسة حدثنا عمرو بن ذر عن ابيه قال ان الله عند لسان كل قاءل فلينظر عبد ماذا يقول ولم يذكر فيه النبي صلي الله عليه و سلم حدثنا الصوري اخبرنا محمد بن عبد الرحمن الازدي حدثنا عبد الواحد بن محمد بن مسرور حدثنا ابو سعيد بن يونس قال صالح بن محمد الجلاب بغدادي قدم مصر بعد الثلاثماءة وحدث بها 
   صالح بن احمد بن يونس ابو الحسين البزاز وهو صالح بن ابي مقاتل ويعرف بالقيراطي هروي الاصل حدث عن محمد بن معاوية بن مالج ويعقوب بن ابراهيم الدورقي ويوسف بن موسي القطان ومحمد بن يحيي القطعي والحسن بن زيد الجصاص ومحمد بن الحسن بن تسنيم وعبيد الله بن جرير بن جبلة وعبيد الله بن سعد الزهري والمنذر بن الوليد الجارودي وفضلك الرازي وعلي بن داود القنطري واحمد بن سنان الواسطي والحسن بن علي بن عفان العامري وعيسي بن جعفر الوراق واحمد بن سعيد الجمال وغيرهم روي عنه ابو بكر الشافعي وابو علي بن الصواف ومحمد بن المظفر ومحمد بن عبيد الله بن الشخير وابو بكر بن شاذان وابو حفص بن شاهين وكان يذكر بالحفظ غير ان حديثه كثير المناكير قرات علي الازهري عن ابي الحسن الدارقطني قال اخبرنا ابو حاتم محمد بن حسان البستي اجازة قال صالح بن احمد بن ابي مقاتل شيخ كتبنا عنه ببغداد يسرق الحديث يقلبه ولعله قد قلب اكثر من عشرة الاف حديث فيما خرج من الشيوخ والابواب لا يجوز الاحتجاج به بحال قال الدارقطني صالح حمو ابي علي بن الصواف ذكر ابو عبد الرحمن السلمي انه سال الدارقطني عن صالح القيراطي فقال كذاب دجال يحدث بما لم يسمعه قال لي البرقاني لم نكن نكتب حديث صالح بن ابي مقاتل قلت ولم ذاك لضعفه فقال نعم هو ذاهب الحديث حدثني الازهري قال قال لنا ابو بكر بن شاذان توفي صالح بن احمد بن ابي مقاتل في شهر ربيع الاخر سنة ست عشرة وثلاثماءة 
   صالح بن محمد بن نصر بن محمد بن عيسي بن موسي بن عبد الله ابو محمد الترمذي قدم بغداد حاجا وحدث بها عن حمدان بن ذي النون والقاسم بن عباد الترمذي روي عنه ابو الحسن بن الخلال المقرء اخبرني محمد بن جعفر بن علان الشروطي اخبرنا احمد بن جعفر بن محمد الخلال حدثنا ابو محمد صالح بن محمد بن نصر بن محمد بن عيسي بن موسي بن عبد الله بن جموكيان بن شاذخ بن عبد الله الترمذي قدم حاجا حدثنا القاسم بن عباد الترمذي حدثنا صالح بن عبد الله الترمذي عن ابي عامر عن نوح بن ابي مريم عن يزيد الهاشمي عن الزهري عن ابي سلمه عن ابي هريرة قال قال رسول الله صلي الله عليه و سلم الدم مقدار الدرهم يغسل وتعاد منه الصلاة
   صالح بن بيان بن السكن الدقاق حدث عن حماد بن الحسن بن عنبسة ومحمد بن الخليل المخرمي وابي اسماعيل الترمذي روي عنه ابو حفص بن شاهين اخبرنا محمد بن عبد الملك القرشي اخبرنا عمر بن احمد الواعظ حدثنا صالح بن بيان بن السكن الدقاق حدثنا محمد بن الخليل المخرمي حدثنا عبد الوهاب بن عطاء حدثنا سعيد عن ايوب عن ابي قلابة عن هشام بن عامر ان النبي صلي الله عليه و سلم نهي عن بيع الذهب بالفضة نسيءة وانبانا ان ذلك ربا
   صالح بن محمد بن صالح ابو علي الموصلي حدث ببغداد عن احمد بن الحسن بن عبد الجبار الصوفي روي عنه عمر بن ابراهيم الكتاني المقرء وقال قدم علينا 
   صالح بن محمد بن عبد الوهاب بن حمزة ابو الطيب البغدادي سكن سمرقند وحدث بها عن عبد الله بن محمد البغوي ذكر ابو سعد الادريسي فيما حدثني به الحسين بن محمد اخو الخلال عنه وقال كان فاضلا خيرا ناسكا ثقة كتبنا عنه بسمرقند سنة اربع وخمسين وثلاثماءة ومات بعد ذلك بايام
   صالح بن ادريس بن صالح ابو سهل البغدادي حدث بدمشق عن يحيي بن محمد بن صاعد روي عنه تمام بن محمد بن عبد الله الرازي
   صالح بن احمد بن محمد بن احمد بن صالح بن عبد الله بن قيس بن الهذيل بن يزيد بن العباس بن الاحنف بن قيس ابو الفضل التميمي الهمذاني قدم بغداد وحدث بها عن عبد الرحمن بن ابي حاتم ومحمد بن قارن الرازيين والحسن بن علي المكتب وابراهيم بن عمروس والقاسم بن بندار وعبد الرحمن بن حمدان الهمذانيين ومحمد بن حمدان بن سفيان الطراءفي وسليمان بن داود وعلي بن ابراهيم بن سلمة القزوينيين وعمر بن احمد بن علي المروزي ومحمد بن علي بن الحسين الصيدلاني وغيرهم وكان حافظا فهما ثقة ثبتا صنف كتابا في طبقات الهمذانيين وكتابا في سنن التحديث حدثنا عنه ممن سمع منه ببغداد محمد بن الفرج بن علي البزاز وعلي بن طلحة المقرء وقال لي علي قدم علينا صالح في سنة سبعين وثلاثماءة
   صالح بن محمد بن المبارك بن اسماعيل ابو طاهر المقرء المءدب من اهل الجانب الشرقي حدث عن ابي ذر احمد بن محمد بن محمد الباغندي وابي بكر بن مجاهد المقرء ومن بعدهما حدثنا عنه عبد العزيز بن علي الازجي واحمد بن محمد العتيقي والحسن بن محمد بن اسماعيل بن اشناس البزاز اخبرنا العتيقي وبن اشناس قالا حدثنا ابو طاهر صالح بن محمد بن المبارك المقرء في سوق الثلاثاء قال بن اشناس في سنة خمس وسبعين وثلاثماءة وقال العتيقي وكان ثقة ثم اتفقا قال حدثنا ابو ذر بن الباغندي حدثنا عبيد الله بن سعد الزهري حدثنا عمي اخبرني وفي حديث العتيقي حدثنا بن اخي الزهري عن عمه قال اخبرني عروة انه سمع بسرة بنت صفوان تقول سمعت النبي صلي الله عليه و سلم يقول من مس فرجه فليتوضا وفي حديث العتيقي من مس ذكره فليتوضا 
   صالح بن جعفر بن محمد بن جعفر بن زياد بن ميسرة ابو الفرج ويعرف بالرازي حدث عن عبد الله بن محمد البغوي وابي بكر النيسابوري واحمد بن علي بن العلاء الجوزجاني حدثنا عنه الازهري والعتيقي والقاضيان ابو عبد الله الصيمري وابو القاسم التنوخي واحاديثه مستقيمة تدل علي صدقه حدثني احمد بن محمد العتيقي قال توفي صالح بن جعفر الرازي يوم الجمعة الخامس من رجب سنة ست وثمانين وثلاثماءة
   صالح بن محمد بن صالح بن علي بن يحيي بن عبد الله بن محمد بن عبيد الله بن عيسي بن موسي بن محمد بن علي بن عبد الله بن العباس بن عبد المطلب ابو عيسي الهاشمي ويعرف بابن ام شيبان حدث عن عبد الله بن اسحاق بن ابراهيم المعروف بابن الخرساني حدثني عنه القاضي ابو عبد الله الصيمري
   صالح بن محمد بن الحسن بن موسي ابو محمد المءدب سمع احمد بن سلمان النجاد وعلي بن محمد بن الزبير الكوفي واحمد بن كامل القاضي وابا علي بن الصواف كتبت عنه في سنة ثمان واربعماءة وكان صدوقا
 (
  AUT ذكر من اسمه صدقة
 )
   صدقة بن ابراهيم المقابري احد من يذكر بالصلاح والزهد والعلم والفضل وكان بينه وبين معروف الكرخي مودة واخاء كما اخبرنا علي بن محمد بن عبد الله المعدل اخبرنا عثمان بن احمد الدقاق حدثنا احمد بن المغلس قال حدثني يعقوب بن اخي معروف قال كان عمي مءاخيا لصدقة بن ابراهيم واسود بن سالم وكانا جميعا يودان معروفا مودة صحيحة ويتجاوبان بالعلم والعمل وذكر خبرا طويلا حدثني الحسن بن محمد بن الحسن الخلال لفظا حدثنا اسماعيل بن محمد بن زنجي حدثنا محمد بن خلف القاضي وكيع حدثنا الحسين بن داود حدثنا صدقة بن ابراهيم المقابري اخبرنا النضر بن سهل عن ابيه قال قال علي بن ابي طالب ليهوديين سالاه عن الدرهم لم سمي درهما وعن الدينار لم سمي دينارا قال اما الدرهم فسمي درهم واما الدينار فضربته المجوس فسمته دي نارا اخبرنا احمد بن محمد العتيقي اخبرنا عثمان بن محمد بن القاسم الادمي حدثنا عبد الله بن اسحاق المداءني حدثنا سعدان بن يزيد عن صدقة وهو المقابري قال بلغني ان رجلا عاده اخوانه فقالوا كيف نجدك فقال ان الذي بي من البلاء اقل مما اصبت من لذة الهوي اخبرنا محمد بن احمد بن رزق اخبرنا عثمان بن احمد الدقاق حدثنا محمد بن احمد بن البراء حدثنا احمد الخلال قال قال صدقة المقابري وذكر شيءا من امر المعاش فقال لا ترضي ولا تشكر اذ لم بذلك بالسجود لغيره اخبرنا ابو نعيم الحافظ قال سمعت نصر بن ابي نصر الطوسي يحكي عن بعض مشايخه قال كان صدقة المقابري من المبالغين في التحقق كان يقول اتي علي عشرون سنة لم اكلم احدا حتي اومر بكلامه ولا تركت كلام احد حتي اومر بترك كلامه 
   صدقة بن موسي بن تميم بن ربيعة ابو العباس مولي علي بن ابي طالب روي احمد بن عبد الله بن نصر الذارع عنه عن ابي نعيم الفضل بن دكين وابي سعيد الاصمعي وابي الوليد الطيالسي وعبد الله بن محمد بن عاءشة ومحمد بن سلام الجمحي وسويد بن سعيد وابي الربيع الزهراني وابراهيم بن المنذر الحزامي وعلي بن المديني ويحيي بن معين وابراهيم بن سعيد الجوهري وكان الذارع غير ثقة اخبرنا الحسن بن الحسين النعالي اخبرنا احمد بن عبد الله بن نصر الذارع حدثنا صدقة بن موسي بن تميم بن ربيعة ابو العباس مولي علي بن ابي طالب بالبصرة وببغداد سنة تسع وثمانين وماءتين حدثنا ابو الوليد عن شعبة عن يعلي بن عطاء قال سمعت عبد الله بن سفيان الثقفي يحدث عن ابيه قال قلت يا رسول الله اوصني بامر لا اسال عنه بعدك غيرك قال قل ربي الله واستقم قلت فما اتقي قال فاشار الي لسانه هذا الشيخ مجهول وقد روي عنه الذارع احاديث منكرة والحمل فيها عندي علي الذارع والله اعلم 
   صدقة بن زكريا بن عمرو ابو عمرو الدهقان العاقولي حدث ابو القاسم عبد الله بن محمد بن الثلاج عنه عن عبد الكريم بن الهيثم ذكر انه سمع منه بدير العاقول
   صدقة بن هبيرة ابو عبد الله الموصلي قدم بغداد وحدث بها عن محمد بن عبيد الله الرفاعي ويوسف بن يعقوب المعدل وهما شيخان مجهولان روي عنه يوسف بن عمر القواس وذكر انه سمع منه ببغداد في دار الخليفة فاخبرني الحسن بن ابي طالب حدثنا يوسف بن عمر القواس قال قرء علي صدقة بن هبيرة وانا اسمع قيل له حدثك يوسف بن يعقوب المعدل حدثنا حفص بن ابراهيم حدثنا ابراهيم بن العلاء الاسكندراني عن بقية بن الوليد عن ثور بن يزيد عن ام الدرداء عن ابي الدرداء عن ابي امامة عن النبي صلي الله عليه و سلم قال من مات وهو يقول القران مخلوق لقي الله يوم القيامة ووجهه الي قفاه من بين بن هبيرة وبقية لا يعرف وثور بن يزيد لم يدرك ام الدرداء
   صدقة بن علي بن محمد بن المءمل ابو القاسم التميمي الدارمي من اهل الموصل كان يتولي القضاء بنصيبين وقدم بغداد وحدث بها عن ابراهيم بن ثمامة الحنفي شيخ مجهول ذكر صدقة انه حدثه عن قتيبة بن سعيد وعبد الله بن معاوية الجمحي اسحاق بن ابي اسراءيل وابراهيم بن سعيد الجوهري وروي صدقة ايضا عن عبد الرحمن بن احمد بن محمد بن الحجاج بن رشدين المصري وبكر بن احمد الشعراني واحمد بن الحسن بن محمد بن بكار الدمشقي وعبد الله بن زياد بن المغيرة الموصلي والحسين بن علي بن زياد الطبراني وابي عبيد الله محمد بن الربيع بن سليمان الجيزي واحمد بن عبد الرحمن بن واقد التنوخي وابي بكر محمد بن القاسم بن بشار الانباري وغيرهم حدثنا عنه علي بن المحسن التنوخي اخبرنا التنوخي حدثنا صدقة بن علي الموصلي وكان خليفة ابي علي قضاء نصيبين واعمالها قرا علينا من لفظه في منزلنا ببغداد في ذي القعدة من سنة سبعين وثلاثماءة بعد ان كتبه لنا من حفظه حدثنا ابراهيم بن ثمامة الحنفي بمصر حدثنا قتيبة بن سعيد حدثنا مالك بن انس عن بن شهاب عن عطاء بن يزيد الليثي عن ابي سعيد ان النبي صلي الله عليه و سلم قال اذا سمعتم النداء فقولوا مثل ما يقول المءذن قال التنوخي ذكر لنا صدقة انه ولد في سنة سبع وثلاثماءة 
 (
  AUT ذكر من اسمه صلة
 )
   صلة بن زفر ابو العلاء ويقال ابو بكر العبسي الكوفي حدث عن عبد الله بن مسعود وحذيفة بن اليمان روي عنه ابو واءل شقيق بن سلمة وعامر الشعبي وابو اسحاق السبيعي وربعي بن حراش وابراهيم النخعي والمستورد بن الاحنف وكان ثقة ورد المداءن في حياة حذيفة اخبرنا احمد بن ابي جعفر حدثنا محمد بن العباس الخزاز حدثنا يحيي بن محمد بن صاعد قال حدثنا الحسين بن الحسن المروزي اخبرنا يزيد بن هارون حدثنا ابو مالك الاشجعي عن ربعي بن حراش عن صلة بن زفر قال سرت مع حذيفة حتي اذا كنا بالصحراء دون ساباط فالتفت وراءه الي الافق فقال يا صلة ارايت لو كان معك رغيف وعرق اكنت اكلا وانت تريد الصوم قال قلت لا والله ثم سار هنية فقلت يا ابا عبد الله الصلاة فالتفت الي الافق فقال يا صلة ارايت لو كان معك قدح من لبن وانت تريد الصوم اكنت شاربه قال قلت لا والله قد اصبحت قال لكني انا وايم الله لو رميت بسهم ما خفي علي حيث يقع قال صلة فقلت في نفسي انما هذا شء يعلمنيه اخبرني هبة الله بن الحسن بن منصور الطبري اخبرنا احمد بن عبد الله اخبرنا عبد الرحمن يعني بن ابي حاتم حدثنا عمر بن شبة حدثنا زيد بن يحيي الانماطي حدثنا شعبة عن ابي اسحاق عن صلة عن حذيفة قال قلب صلة بن زفر من ذهب اخبرني الحسين بن علي الصيمري حدثنا علي بن الحسن الرازي اخبرنا محمد بن محمد بن داود الكرجي حدثنا عبد الرحمن بن يوسف بن خراش قال صلة بن زفر كوفي ثقة اخبرنا ابو سعيد بن حسنويه الاصبهاني اخبرنا عبد الله بن محمد بن جعفر اخبرنا عمر بن احمد بن اسحاق الاهوازي حدثنا خليفة بن خياط وصلة بن زفر العبسي مات في ولاية مصعب 
   صلة بن سليمان ابو زيد العطار من اهل واسط سكن بغداد وحدث عن هشام بن حسان وعبد الملك بن جريج ومحمد بن عمرو واشعث بن عبد الملك روي عنه حيدون بن عبد الله ومحمد بن عبد الملك الدقيقي الواسطيان وقال بن ابي حاتم سالت ابي عنه قال متروك الحديث احاديثه عن اشعث منكرة اخبرنا محمد بن عمر النرسي حدثنا محمد بن عبد الله الشافعي حدثنا محمد بن حنيفة ابو حنيفة حدثنا حيدون ابو حيدرة حدثنا صلة بن سليمان العطار حدثنا اشعث عن بن سيرين عن ابي هريرة عن النبي صلي الله عليه و سلم قال لجلساءه خذوا جنتكم من النار قولوا سبحان الله والحمد لله ولا اله الا الله والله اكبر ولا حول ولا قوة الا بالله فانهن المقدمات وهن المعقبات وهن الباقيات الصالحات اخبرني عبد الله بن يحيي العسكري اخبرنا محمد بن عبد الله الشافعي حدثنا جعفر بن محمد بن الازهر حدثنا بن الغلابي قال قال ابو زكريا وصلة هو بن سليمان ليس بثقة اخبرنا يوسف بن رباح البصري اخبرنا البصري اخبرنا احمد بن محمد بن اسماعيل المهندس بمصر حدثنا ابو بشر الدولابي حدثنا معاوية بن صالح عن يحيي بن معين قال صلة بن سليمان ضعيف اخبرنا عبيد الله بن عمر الواعظ حدثنا ابي حدثنا محمد بن مخلد قال حدثنا العباس بن محمد قال سمعت يحيي بن معين يقول صلة بن سليمان كان واسطيا وكان ببغداد وكان كذابا اخبرنا بن الفضل اخبرنا علي بن ابراهيم المستملي اخبرني محمد بن ابراهيم بن شعيب الغازي قال سمعت محمد بن اسماعيل البخاري يقول صلة بن سليمان ليس بذاك القوي حدثنا محمد بن علي الصوري اخبرنا الخصيب بن عبد الله القاضي اخبرنا عبد الكريم بن احمد بن شعيب النساءي اخبرني ابي قال ابو زيد صلة بن سليمان واسطي ليس بثقة اخبرنا احمد بن ابي جعفر حدثنا محمد بن عدي البصري في كتابه حدثنا ابو عبيد محمد بن علي الاجري قال سالت ابا داود عن صلة بن سليمان فقال كذاب 
   صلة بن المءمل بن خلف ابو القاسم البزاز نزل مصر وحدث بها عن ابي بكر بن مالك القطيعي وابي محمد بن ماسي ومخلد بن جعفر وابي الحسن بن لءلء وغيرهم ذكر لي ابو طاهر محمد بن احمد بن ابي الصقر الامام بالانبار انه كتب عنه بمصر في سنة ثلاث وعشرين واربعماءة وكان صدوقا وذكر ابراهيم بن سعيد الحبال المصري انه مات في يوم الخميس الثالث من شهر ربيع الاخر سنة تسع وعشرين واربعماءة
 (
  AUT ذكر من اسمه الصباح
 )
   الصباح بن سهل ابو سهل المداءني حدث عن زياد بن ميمون روي عنه محمد بن سلام البيكندي اخبرني ابو الوليد الدربندي اخبرنا محمد بن احمد بن سليمان الحافظ ببخاري حدثنا محمد بن نصر بن خلف حدثنا ابو كثير سيف بن حفص حدثني علي بن الجنيد ابو الحسن ومحمد بن حميد بن فروة قالا حدثنا محمد بن سلام حدثنا ابو سهل المداءني يعني الصباح بن سهل عن زياد بن ميمون عن انس بن مالك قال كانت امراة بالمدينة عطارة يقال لها الحولاء فجاءت الي عاءشة فقالت يا ام المءمنين نفسي لك الفداء اني ازين نفسي لزوجي كل ليلة حتي كاني العروس ازف اليه وذكر الحديث 
   الصباح بن بيان اخبرنا الازهري اخبرنا ابو الحسن الدارقطني قال الصباح بيان بغدادي يحدث عن يزيد بن اوس الحمصي عن عامر بن شرحبيل عن عبد الله بن سعيد بن قيس الهمداني بحديث غزاة مسلمة حدثنا بذلك ابو عمرو بن السماك عن الحسن بن سلام عنه قلت واخبرنا بن رزقويه اخبرنا ابو عمرو بن السماك بقصة غزاة مسلمة بن عبد الملك بن مروان الي بلاد الروم وخبر دخوله القسطنطينية كما ذكر الدارقطني وهي في جزء مفرد
 (
  AUT ذكر من اسمه صبيح
 )
   صبيح الخلدي المراق قرات في نسخة الكتاب الذي ذكر لنا ابو سعيد محمد بن موسي الصيرفي انه سمعه من ابي العباس محمد بن يعقوب الاصم وذهب اصله به ثم اخبرني العتيقي قراءة اخبرنا عثمان بن محمد بن محمد المخرمي اخبرني الاصم ان العباس بن محمد حدثهم قال سمعت يحيي بن معين وابا خيثمة يقولان صبيح كان ينزل الخلد وكان يحدث عن عثمان بن عفان وعن عاءشة ام المءمنين وكان كذابا خبيثا اخبرنا محمد بن عبد الواحد اخبرنا محمد بن العباس حدثنا احمد بن سعيد بن مرابا حدثنا عباس قال سمعت يحيي بن معين وابا خيثمة يقولان كان صبيح ينزل عند الخلد وكان كذابا اخبرني محمد بن ابي علي الاصبهاني اخبرنا ابو علي الحسين بن محمد الشافعي بالاهواز اخبرنا ابو عبيد محمد بن علي الاجري قال سالته يعني ابا داود سليمان بن الاشعث عن صبيح البغدادي فقال ليس بشء 
   صبيح بن عبد الله ابو الفتح الاسود مولي القاضي ابي عبد الله الحسين بن هارون الضبي سمع ابا بكر بن مالك القطيعي والحسين بن احمد بن محمد الشماخي الهروي وجماعة من هذه الطبقة كتبت عنه وكان سماعه صحيحا اخبرنا صبيح بن عبد الله في سنة ثمان واربعماءة حدثنا ابو عبد الله الحسين بن احمد بن محمد بن عبد الرحمن الهروي حدثنا ابو حاتم محمد بن المنذر الباشاني حدثنا علي بن خشرم حدثنا الفضل بن موسي عن هشام بن عروة عن ابيه عن عاءشة قالت ما حسدت من الناس ما حسدت خديجة ما تزوجني الا بعد ما ماتت وذلك ان رسول الله صلي الله عليه و سلم بشرها ببيت في الجنة من قصب ذكر من اسمه الصقر
   الصقر بن عبد الرحمن بن بنت مالك بن مغول يكني ابا بهز وهو كوفي نزل بغداد وحدث بها عن عبد الله بن ادريس الاودي وخلف بن خليفة الاشجعي روي عنه ابو بدر عباد بن الوليد الغبري وابو يعلي الموصلي وغيرهما اخبرني علي بن محمد بن الحسن المالكي اخبرنا عبد الله بن عثمان الصفار اخبرنا محمد بن عمران بن موسي الصيرفي حدثنا عبد الله بن علي بن المديني قال قلت لابي في حديث ابي بهز عن بن ادريس عن المختار بن فلفل عن انس كان في حاءط فقال ايذن له وبشره بالجنة مثل حديث ابي موسي فقال كذب هذا موضوع لم يكن عند بن ادريس الا ثلاثة احاديث عن المختار عن انس في الاشربة اخبرنا بحديث ابي بهز هذا القاضي ابو العلاء محمد بن علي الواسطي اخبرنا عبد الله بن محمد بن عثمان المزني حدثنا ابو يعلي وحدثناه الحسن بن علي الجوهري املاء اخبرنا محمد بن النضر الموصلي اخبرنا ابو يعلي احمد بن علي بن المثني حدثنا ابو بهز صقر بن عبد الرحمن بن بنت مالك بن مغول حدثنا عبد الله بن ادريس عن المختار بن فلفل عن انس بن مالك قال جاء النبي صلي الله عليه و سلم فدخل الي بستان فاتي ات فدق الباب فقال يا انس قم فافتح له وبشره بالجنة وبشره بالخلافة من بعدي قال قلت يا رسول الله اعلمه قال اعلمه فاذا ابو بكر قلت ابشر بالجنة وابشر بالخلافة من بعد رسول الله صلي الله عليه و سلم ثم جاء ات فدق الباب فقال يا انس قم فافتح له وبشره بالجنة وبشره بالخلافة من بعد ابي بكر قلت يا رسول الله اعلمه قال اعلمه فخرجت فاذا عمر قال قلت ابشر بالجنة وابشر بالخلافة من بعد ابي بكر ثم جاء ات فدق الباب فقال قم يا انس فافتح له وبشره بالجنة وبالخلافة من بعد عمر وانه مقتول قال فخرجت فاذا عثمان قلت ابشر بالجنة وبالخلافة من بعد عمر وانك مقتول قال فدخل الي النبي صلي الله عليه و سلم فقال يا رسول الله لمه والله ما تغنيت ولا تمنيت ولا مسست ذكري بيميني منذ بايعتك قال هو ذاك يا عثمان اخبرنا محمد بن علي المقرء اخبرنا ابو مسلم بن مهران اخبرنا عبد المءمن بن خلف النسفي قال سالت ابا علي صالح بن محمد عن حديث الصقر بن عبد الرحمن عن بن ادريس عن مختار بن فلفل عن انس عن النبي صلي الله عليه و سلم باكروا بالصدقة الحديث فقال سالت ابا بكر بن ابي شيبة عن هذا الحديث في سنة ثلاثين وماءتين فقال من روي هذا الحديث يحتاج الي ان يقلع له اربعة اضراس قال عبد المءمن سالت ابا علي عن الصقر فقال كان شيخا مغفلا مطروحا ببغداد وهذا حديث رواه عبد الاعلي بن ابي المساور وهو ضعيف عن المختار لا اصل له وابو الصقر عبد الرحمن بن مالك بن مغول كان يعني الصقر يضع الحديث كان جده مالك بن مغول قرات في كتاب ابي الحسن بن الفرات بخطه اخبرنا محمد بن العباس الهروي حدثنا يعقوب بن اسحاق بن محمود الفقيه قال قال ابو علي صالح بن محمد عبد الرحمن بن مالك بن مغول من اكذب الناس وابو بهز ابنه كان اكذب من ابيه 
   الصقر بن عبد الرحمن بن جميع ابو الليث الدينوري يعرف بالقواس سكن بغداد وحدث بها عن عبد الله بن محمد بن زياد النيسابوري واحمد بن الفضل البخاري روي عنه ابو نصر محمد بن ابي بكر الاسماعيلي الجرجاني وقال كان امام جامع براثي وعبد العزيز بن علي الازجي اخبرني عبد العزيز بن علي حدثنا صقر بن عبد الرحمن بن جميع ابو الليث الدينوري في سوق السلاح حدثنا ابو بكر النيسابوري حدثني محمد بن عزيز حدثني سلامة عن عقيل عن بن شهاب عن عطاء بن يزيد انه سمع ابا هريرة يقول سءل رسول الله صلي الله عليه و سلم عن ذراري المشركين فقال الله اعلم بما كانوا عاملين ذكر مفاريد الاسماء في هذا الباب
   صعصعة بن يزيد تابعي كان يسكن المداءن وحدث بها عن عبد الله بن عباس روي عنه ابو اسحاق السبيعي اخبرنا بن الفضل القطان اخبرنا علي بن ابراهيم المستملي حدثنا ابو احمد بن فارس حدثنا محمد بن اسماعيل البخاري حدثنا حجاج حدثنا حسن الاشيب حدثنا زهير حدثنا ابو اسحاق عن صعصعة بن يزيد وكان منزله بالمداءن قال البخاري سمع بن عباس وقال الثوري بن زيد وقال اسراءيل وشريك عن ابي اسحاق عن صعصعة بن يزيد خالفوه وقال شعبة عن ابي اسحاق عن زيد بن صعصعة قرات علي القاضي ابي العلاء محمد بن علي الواسطي عن ابي الفتح محمد بن الحسين الازدي الحافظ في تسمية من روي عنه ابو اسحاق ولم يحدث عنه غيره قال صعصعة بن يزيد ويقال بن زيد ويقال بن معاوية عن بن عباس
   الصلت بن مسعود الجحدري بصري ولي القضاء بسر من راي وحدث بها عن حماد بن زيد وعبد الوارث بن سعيد وجعفر بن سليمان ومسلم بن خالد ومحمد بن عبد الرحمن الطفاوي وسفيان بن عيينة وعباد بن عباد وسلمة بن رجاء ومعلي بن راشد روي عنه الحسن بن مكرم وعبد الله بن ابي سعد واحمد بن الحسين بن نصر الحذاء واحمد بن ابي عوف البزوري ومحمد بن محمد الباغندي وغيرهم اخبرنا هلال بن الحفار حدثنا عثمان بن احمد الدقاق املاء حدثنا ابو عبد الله محمد بن خلف المروزي حدثنا الصلت بن مسعود الجحدري حدثنا المعلي بن راشد ابو اليمان القواس حدثنا زياد بن ميمون ابو عمار عن انس بن مالك قال بينما رسول الله صلي الله عليه و سلم قاعد في ملا من اصحابه اذ ضحك او بكي فقال له اصحابه يا نبي الله ما الذي اضحكك او ابكاك قال عجبت من رجل يجء يوم القيامة متعلقا برجل الي ربه فيقول يا رب خذ لي حقي من هذا قال فيقول له الرب تعالي اعط اخاك حقه فيقول يا رب والله ما لي حسنة قال فيقول له الرب زعم اخوك هذا انه ليس له حسنة قال فيقول يا رب فخذ من سيءاتي فاحملها عليه فيقول الرب ارفع طرفك فانظر قال فيرفع طرفه فينظر فيفتح له ابواب الجنان فيري فيها قصورا من الدر والياقوت والذهب قال فيقول يا رب لمن هذا لابي مالك هذا او لابي مصطفي هذا قال فيقول له الرب تعالي هذا لمن اعطي ثمنه فيقول ومن عنده ثمن هذا او من يقدر قال فيقول له الرب تعالي هو عندك وانت تقدر عليه فيقول يا رب وما هو قال تعفو عن اخيك هذا قال فيقول يا رب عفوت يا رب عفوت يا رب عفوت عنه ثلاثا قال فيقول الرب خذ بيده قال فياخذ بيده ثم ينطلقان جميعا حتي يدخلا الجنة قال ابو عبد الله سمعت هذا الحديث مع احمد بن حنبل من هذا الشيخ اخبرني الازهري حدثنا احمد بن ابراهيم حدثنا ابراهيم بن محمد بن عرفة قال سنة ست وثلاثين يعني وماءتين فيها ولي الصلت بن مسعود القضاء بسر من راي قلت لم يزل الصلت قاضيا بسر من راي الي ان عزل في سنة تسع وثلاثين وماءتين قبيل وفاته بيسير اخبرني محمد بن احمد بن يعقوب اخبرني محمد بن نعيم الضبي اخبرني علي بن محمد المروزي قال وسالته يعني صالح بن محمد المعروف بجزرة عن الصلت بن مسعود فقال ثقة اخبرنا بن الفضل اخبرنا جعفر الخلدي حدثنا محمد بن عبد الله الحضرمي قال سنة تسع وثلاثين وماءتين فيها مات الصلت بن مسعود الجحدري 
   صرد بن حماد بن سالم ابو سهل الصيرفي الواسطي سكن بغداد وحدث بها عن ابي قطن عمرو بن الهيثم وعبد الرحمن بن مسهر اخي علي والحسن بن الحكم بن طهمان وبكر بن بكار روي عنه ابو بكر بن ابي الدنيا وقاسم بن زكريا المطرز واسماعيل بن العباس الوراق ومحمد بن مخلد العطار وما علمت من حاله الا خيرا اخبرنا محمد بن علي بن الفتح اخبرنا علي بن عمر الحافظ حدثنا اسماعيل بن العباس بن محمد الوراق حدثنا صرد بن حماد ابو سهل قال حدثنا الحسن بن الحكم بن طهمان حدثنا ابو معدان عن عون بن ابي جحيفة عن ابيه قال جاءت امراة الي النبي صلي الله عليه و سلم ومعها جارية لها سوداء فقالت يا رسول الله اتجزي عني هذه ان اعتقتها قال فقال لها رسول الله صلي الله عليه و سلم اين الله قالت في السماء قال من انا قالت انت رسول الله قال لها تشهدين ان لا اله الا الله واني رسول الله قالت نعم قال اعتقيها فانها تجزي عنك قال علي بن عمر هذا غريب من حديث عون بن ابي جحيفة عن ابيه تفرد به ابو معدان وهو غريب من حديث ابي معدان عبد الله بن معدان تفرد الحسن بن الحكم عنه ولا اعلم حدث به غير صرد بن حماد اخبرني الحسين بن علي الطناجيري حدثنا عمر بن احمد الواعظ قال قال محمد بن مخلد فيما قرات عليه ومات صرد الصيرفي سنة ثمان وخمسين يعني وماءتين زاد غيره عن بن مخلد في يوم الاحد لاربع خلون من شعبان 
   صاحب بن حاتم الفرغاني قدم بغداد حاجا وحدث بها حدثنا عبد العزيز بن علي الوراق لفظا حدثنا علي بن عمر بن محمد السكري حدثنا صاحب بن حاتم الفرغاني قدم علينا للحج حدثنا احمد بن حرب عن محمد بن اسماعيل بن ابي فديك قال اخبرني داود بن قيس الفراء عن محمد بن صالح عن ابي امامة ان رسول الله صلي الله عليه و سلم قال من توضا فاحسن الوضوء ثم خرج عامدا الي مسجد قباء لا ينزعه الا الصلاة فيه فصلي فيه ركعتين كانتا عدل عمرة
   صاعد بن محمد ابو العلاء النيسابوري ثم الاستواءي من اهل استواء وهي قرية من رستاق نيسابور سمع عبد الله بن محمد بن علي بن زياد واسماعيل بن نجيد النيسابوريين وبشر بن احمد الاسفراءيني ومن بعدهم وورد العراق في حداثته حاجا فسمع بالكوفة من علي بن عبد الرحمن البكاءي وولي بعد ذلك قضاء نيسابور ثم عزل وولي مكانه ابو الهيثم عتبة بن خيثمة وكان احد شيوخه فحدثني علي بن المحسن التنوخي قال لما عزل صاعد بن محمد عن قضاء نيسابور باستاذه ابي الهيثم عتبة بن خيثمة كتب اليه ابو بكر محمد بن موسي الخوارزمي هذين البيتين وانشدناهما لنفسه ... واذا لم يكن من الصرف بد ... فليكن بالكبار لا بالصغار ... ... واذا كانت المحاسن بعد ال صرف ... محروسة فليس بعار ... وكان صاعد عالما فاضلا صدوقا وانتهت اليه رياسة اصحاب الراي بخراسان وقدم بغداد وحدث بها فحدثني القاضي ابو عبد الله الصيمري حدثنا القاضي ابو العلاء صاعد بن محمد الفقيه ببغداد واسند لي عنه حديثا فسالت الصيمري عن قدوم صاعد بغداد فقال اخر سنة قدمها سنة ثلاث واربعماءة قلت وقد لقيته انا بنيسابور وسمعت منه وبلغني انه مات في سنة اثنتين وثلاثين واربعماءة 
 (
  AUT باب الضاد
 )
   ضرار بن سهل الضراري حدث عن الحسن بن عرفة العبدي روي عنه عبد الله بن احمد الغباغبي حدثت عن عبد الوهاب بن الحسن الدمشقي قال حدثنا ابو القاسم عبد الله بن احمد بن محمد التميمي المعلم المعروف بالغباغبي لفظا قال حدثني ضرار بن سهل الضراري ببغداد في دار الخلنجيين في راس الجسر قال حدثنا الحسن بن عرفة حدثنا ابو حفص الابار عمر بن عبد الرحمن عن حميد عن انس قال قال لي علي بن ابي طالب قال لي رسول الله صلي الله عليه و سلم يا علي ان الله امرني ان اتخذ ابا بكر والدا وعمر مشيرا وعثمان سندا وانت يا علي ظهيرا انتم اربعة قد اخذ الله لكم الميثاق في ام الكتاب لا يحبكم الا مءمن تقي ولا يبغضكم الا منافق شقي انتم خلفاء نبوتي وعقد ذمتي وحجتي علي امتي هذا الحديث منكر جدا لا اعلم رواه بهذا الاسناد الا ضرار بن سهل وعنه الغباغبي وهما جميعا مجهولان
   ضرار بن احمد بن ثابت ابو الطيب الحنبلي قرات في كتاب ابي القاسم بن الثلاج بخطه حدثني ابو الطيب ضرار بن احمد بن ثابت الحنبلي حدثني ابو علي الخرقي حدثني المروذي قال سءل ابو عبد الله احمد بن حنبل وانا اسمع عن الحقنة فقال اكرهها لانها تشبه باللواط
   ضرار بن رافع بن ضرار بن رافع بن عصم ابو عمرو الضبي من اهل هراة قدم بغداد وحدث بها عن علي بن محمد بن احمد بن رزين الهروي وغيره حدثنا عنه القاضي ابو العلاء الواسطي اخبرنا ابو العلاء محمد بن علي بن احمد حدثنا ابو عمرو ضرار بن رافع بن عصم بن بلال الضبي الهروي قدم علينا بغداد حدثنا عبد الرحمن بن احمد المروزي المعروف بابن علك حدثنا عبدان بن عيسي المروزي حدثنا بندار حدثنا يحيي بن سعيد القطان عن يحيي بن سعيد الانصاري عن محمد بن ابراهيم عن علقمة بن وقاص عن عمر بن الخطاب قال قال رسول الله صلي الله عليه و سلم انما الاعمال بالنيات الحديث اخبرنا عبد الكريم بن محمد المحاملي انبانا ابو الحسن الدارقطني قال ضرار بن رافع بن ضرار بن رافع بن عصم بن بلال بن عصم بن عباس بن سعيد بن المجشر بن عامر الضبي العصمي الهروي قدم علينا في سنة خمس وستين وثلاثماءة قلت ذكر غيره بدل سعيد بن المجشر شعبة بن المجشر فالله اعلم 
   ضياء بن احمد بن محمد بن يعقوب ابو عبد الله الخياط هروي الاصل سكن بغداد بالجانب الشرقي منها ناحية الرصافة وحدث بها عن عمر بن احمد بن شادران القرميسيني وعيسي بن احمد بن علي بن زيد الدينوري ومحمد بن الحسن بن شيبان الابلي وعلي بن احمد بن محمد بن غسان البصري كتبت عنه وكان سماعه صحيحا اخبرنا ضياء بن احمد اخبرنا ابو حفص عمر بن احمد بن شادران القرميسيني بالدينور في سنة ثلاث وثمانين وثلاثماءة حدثنا محمد بن ابراهيم بن زياد الطيالسي حدثنا عبد الاعلي يعني بن حماد النرسي حدثنا المعتمر بن سليمان عن عبيد الله بن عمر عن سعيد المقبري عن ابي هريرة قال قال رسول الله صلي الله عليه و سلم لولا ان اشق علي امتي لامرتهم بالسواك عند كل صلاة سالت ضياء عن مولده فقال في صفر من سنة ثمان وسبعين وثلاثماءة وولدت ببغداد وحملني ابي الي الدينور وانا صغير ثم ردني الي بغداد وحدرني الي البصرة بعد ذلك كان ضياء حيا ببغداد الي ان خرج عنها وبلغنا انه مات في اول سنة اثنتين وخمسين واربعماءة 
 (
  AUT باب الطاء
 )
