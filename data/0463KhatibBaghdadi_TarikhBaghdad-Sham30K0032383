 شاذويه قال سمعت علي بن خشرم يقول وماشيت وكيعا الي الجمعة فقال لي يا علي الي من تختلف فقلت الي فلان والا فلان والي ابي معاوية الضرير قال فقال وكيع اختلف اليه فانك ان تركبته ذهب علم الاعمش علي انه مرجء فقلت يا ابا سفيان دعاني الي الارجاء فابيت عليه فقال لي وكيع هلا قلت له كما قال له الاعمش لا تفلح انت ولا اصحابك المرجءة اخبرنا ابو نعيم الحافظ حدثنا ابو بكر بن المقرء حدثنا عبد الله بن جابر حدثنا جعفر بن نوح قال سمعت محمد بن عثمان كذا قال لنا ابو نعيم وليس بمحمد بن عثمان وانما هو محمد بن عيسي بن الطباع يقول قال بن البادش ابو معاوية مرجء كبير اخبرنا حمزة بن محمد بن طاهر الدقاق حدثنا الوليد بن بكر الاندلسي حدثنا علي بن احمد بن زكريا الهاشمي با طرابلس الغرب حدثنا ابو مسلم صالح بن احمد بن عبد الله بن صالح العجلي حدثني ابي قال ابو معاوية الضرير محمد بن خازم الحماني كوفي ثقة وكان يري الارجاء كان لين القول يعني فيه وسمع من الاعمش الفي حديث فمرض مرضة فنسي منها ستماءة حديث اخبرنا ابو بكر البرقاني اخبرنا احمد بن حمدويه الهروي اخبرنا الحسن بن ادريس الانصاري قال قال بن عمار سمعت ابا معاوية الضرير يقول كل حديث اقول فيه حدثنا فهو ما حفظته من في المحدث وما قلت وذكر فلان فهو ما لم احفظ من فيه وقرء علي من كتاب فعرفته فحفظته مما قرء علي اخبرني عبد الباقي بن عبد الكريم المءدب قال قرانا علي الحسين بن هارون الضبي عن ابي العباس بن سعيد قال حدثني عبد الله بن ابراهيم بن قتيبة قال سمعت بن نمير يقول كان ابو معاوية لا يضبط شيءا من حديثه ضبطه لحديث الاعمش كان يضطرب في غيره اضطرابا شديدا اخبرنا محمد بن احمد بن رزق اخبرنا محمد بن احمد بن الحسن حدثنا عبد الله بن احمد قال قال لي ابو معاوية في غير حديث الاعمش مضطرب 
 لا يحفظها حفظا جيدا اخبرنا احمد بن ابي جعفر اخبرنا محمد بن عدي البصري في كتابه حدثنا ابو عبيد محمد بن علي قال قال ابو داود ابو معاوية اذا جاز حديث الاعمش كثر خطءه يخطء علي هشام بن عروة وعلي بن اسماعيل وعلي عبد الله بن عمر اخبرنا محمد بن عبد الواحد اخبرنا محمد بن العباس حدثنا بن مرابا حدثنا عباس قال سمعت يحيي يقول روي ابو معاوية عن عبيد الله بن عمر احاديث مناكير قال يحيي وروي ابو معاوية عن سهيل حديثا لم يروه غيره كنا نعد زمن النبي صلي الله عليه و سلم اخبرنا علي بن طلحة بن محمد المقرء اخبرنا محمد بن ابراهيم الطرسوسي اخبرنا محمد بن محمد بن داود الكردي قال حدثنا عبد الرحمن بن يوسف بن خراش قال ابو معاوية الضرير صدوق وهو في الاعمش ثقة وفي غير الاعمش فيه اضطراب اخبرنا ابو بكر احمد بن محمد بن محمد بن ابراهيم الاشناني قال سمعت احمد بن محمد بن عبدوس الطراءفي يقول سمعت عثمان بن سعيد الدارمي يقول سالت يحيي بن معين قلت فابو معاوية احب اليك ام وكيع فقال ابو معاوية اعلم به يعني الاعمش اخبرنا هبة الله بن الحسن الطبري اخبرنا احمد بن عبيد حدثنا محمد بن الحسين حدثنا احمد بن زهير قال قيل ليحيي بن معين ايما احب اليك في الاعمش عيسي بن يونس او حفص بن غياث او ابو معاوية قال ابو معاوية اخبرنا ابراهيم بن محمد بن سليمان المءدب باصبهان اخبرنا ابو بكر بن المقرء حدثنا سلامة بن محمود القيسي بعسقلان حدثنا ايوب بن اسحاق بن سافري قال سالت احمد ويحيي عن ابي معاوية وجرير قالا ابو معاوية احب الينا يعنيان في الاعمش اخبرنا محمد بن عبد الواحد اخبرنا محمد بن العباس اخبرنا بن مرابا حدثنا عباس بن محمد قال سمعت يحيي بن معين يقول ابو معاوية اثبت من جرير في الاعمش اخبرنا البرقاني اخبرنا بن خميرويه حدثنا الحسين بن ادريس قال سالت بن عمار عن علي بن مسهر وابي معاوية ايهما اكثر في الاعمش قالا ابو معاوية اخبرني الازهري حدثنا عبد الرحمن بن عمر حدثنا محمد بن احمد بن يعقوب بن شيبة حدثنا جدي قال محمد بن خازم الضرير مولي لبني عمرو بن سعد بن زيد مناه بن تميم رهط سعير بن الخمس وكان من الثقات وربما دلس وكان يري الارجاء فيقال ان وكيعا لم يحضر جنازته لذلك اخبرنا محمد بن الحسين القطان اخبرنا جعفر بن محمد الخالدي حدثنا محمد بن عبد الله بن سليمان الحضرمي حدثنا محمد بن عبد الله بن نمير قال مات ابو معاوية سنة اربع وتسعين وماءة اخبرنا ابن الفضل القطان اخبرنا دعلج بن احمد اخبرنا احمد بن علي الابار حدثنا سلم بن جنادة ابو الساءب واخبرنا علي بن محمد بن عبد الله المعدل اخبرنا عثمان بن احمد الدقاق حدثنا محمد بن احمد بن البراء واخبرني الحسن بن علي الجوهري اخبرنا محمد بن المظفر اخبرنا محمد بن محمد بن سليمان قالا قال علي بن المديني واخبرني الحسين بن علي الطناجيري حدثنا عمر بن احمد الواعظ حدثنا محمد بن سليمان الباهلي قال سمعت محمد بن الحجاج يقول توفي ابو معاوية وفي حديث ابي الساءب وعلي مات ابو معاوية سنة خمس وتسعين وماءة اخبرنا الازهري اخبرنا محمد بن العباس اخبرنا ابراهيم بن محمد الكندي حدثنا ابو موسي محمد بن المثني قال ومات ابو معاوية ومحمد بن الفضيل سنة خمس وتسعين وماءة في شهر واحد اخبرنا بن الفضل اخبرنا بن درستويه حدثنا يعقوب بن سفيان حدثنا محمد بن فضيل قال مات ابو معاوية الضرير سنة خمس وتسعين وماءة في اخر صفر او في اول شهر ربيع وولد ابو معاوية سنة ثلاث عشرة وماءة 
   محمد بن ابي الخصيب الانطاكي سمع مالك بن انس وعبد الله بن لهيعة وعبد الجبار بن الورد روي عنه عباس بن محمد الدوري وابراهيم بن اسحاق الحربي واحمد بن زكريا الجوهري ومحمد بن يوسف الصابوني ومحمد بن غالب التمتام وكان ثقة قدم بغداد وبها كانت وفاته اخبرنا ابو سعيد محمد بن موسي بن الفضل بن شاذان الصيرفي حدثنا ابو العباس محمد بن يعقوب الاصم حدثنا العباس بن محمد الدوري حدثنا محمد بن ابي الخصيب الانطاكي حدثنا بن لهيعة حدثني بكير بن الاشج عن نافع قال قلت لعبد الله بن عمر ما كان اكثر ما سمعت من رسول الله صلي الله عليه و سلم في الرخصة قال سمعت رسول الله صلي الله عليه و سلم يقول اني لارجو ان لا يموت احد يشهد ان لا اله الا الله مخلصا من قلبه فيعذبه الله عز و جل اخبرنا علي بن محمد السمسار اخبرنا عبد الله بن عثمان الصفار حدثنا بن قانع ان محمد بن ابي الخصيب الانطاكي مات سنة ثمان عشرة وماءتين ببغداد 
   محمد بن خاقان بن موسي بن صبيح بن مرزوق مروزي الاصل وهو عم عبيد الله بن يحيي بن خاقان الوزير حكي عن عبد الله بن المبارك روي عنه اخوه احمد بن خاقان اخبرنا علي بن طلحة المقرء اخبرنا محمد بن العباس حدثنا ابو مزاحم الخاقاني حدثني ابو زكريا يحيي بن زكريا المعروف بالسني حدثني ابو الحسن احمد بن خاقان بن موسي قال سمعت اخي محمد بن خاقان يقول شيعنا بن المبارك في اخر خرجة خرج فقلنا له اوصنا فقال لا تتخذوا الراي اماما
   محمد بن الخليل بن عيسي ابو جعفر المخرمي سمع عبيد الله بن موسي وروح بن عبادة وحجاج بن محمد وعبد الصمد بن النعمان ومحمد بن عبد الله البياضي ومحمد بن عبيد الطنافسي وسعيد بن منصور روي عنه وكيع القاضي وعبد الله بن الهيثم الطبني ومحمد بن مخلد الدوري ومحمد بن جعفر المطيري وحمزة بن القاسم الهاشمي وكان ثقة اخبرنا ابو الحسن احمد بن محمد بن احمد بن حماد الواعظ مولي بني هاشم حدثنا ابو عمر حمزة بن القاسم الهاشمي حدثنا محمد بن الخليل حدثنا محمد بن عبد الله بن عمران البياضي حدثنا طلحة بن يحيي عن الضحاك عن نافع عن بن عمر ان رسول الله صلي الله عليه و سلم قال علي الرجل السمع والطاعة فيما احب وكره الا ان يءمر بمعصية فاذا امر بمعصية فلا طاعة لاحد في معصية الله عز و جل اخبرنا ابو بكر البرقاني اخبرنا محمد بن العباس الخزاز حدثنا ابو محمد عبيد الله بن عبد الرحمن السكري حدثني محمد بن حجة قال محمد بن الخليل صاحبنا كان من خيار الناس قرات في كتاب محمد بن مخلد بخطه سنة تسع وستين وماءتين فيها جاء نعي محمد بن الخليل من بلد في شعبان 
   محمد بن خشيش ابو بكر يعرف بابن ابي خشة سمع يحيي بن معين روي عنه محمد بن مخلد اخبرنا الازهري اخبرنا علي بن عمر الحافظ حدثنا محمد بن مخلد حدثنا ابو بكر بن ابي خشة قال سمعت يحيي يعني بن معين يقول علي الحناط كان كوفيا وانتقل الي المدينة وكان خياطا ترك ذاك وصار حناطا ثم ترك ذاك وصار يبيع الخبط قرات في كتاب بن مخلد سنة اربع وسبعين وماءتين فيها مات ابو بكر محمد بن ابي خشة في صفر
   محمد بن خليفة بن صدقة ابو جعفر يعرف بعنبر من اهل دير العاقول قدم بغداد وحدث بها عن مسلم بن ابراهيم وابي سلمة التبوذكي ومحمد بن كثير العبدي وعبد السلام بن مطهر وابي نعيم الفضل بن دكين وعفان بن مسلم واسماعيل بن ابي ادريس وسعيد بن منصور روي عنه محمد بن عبد الله بن عتاب واحمد بن محمد بن الضحاك وابو سهل بن زياد القطان ورواياته مستقيمة ذكره الدارقطني فقال صدوق اخبرني محمد بن الحسين الازرق وحدثنا ابو سهل احمد بن محمد بن زياد حدثنا عنبر محمد بن خليفة بن صدقة حدثنا مسلم بن ابراهيم حدثنا عقبة بن خالد الشني حدثني ابو عمرو الندبي قال خرجت مع بن عمر في جنازة رافع بن خديج فسمع نسوة يبكين فقال سمعت رسول الله صلي الله عليه و سلم يقول الميت يعذب ببكاء الحي بلغني ان محمد بن خليفة مات بدير العاقول في سنة ست وسبعين وماءتين 
   محمد بن خشنام ابو عبد الله الاصبهاني قدم بغداد وحدث بها عن يوسف بن عدي وسعيد بن عفير وابراهيم بن محمد الشافعي روي عنه محمد بن مخلد الدوري
   محمد بن الخطاب ابو الخطاب الخطابي العدوي مولي ال عمر بن الخطاب حدث عن ابي نعيم الفضل بن دكين روي عنه عبد الباقي بن قانع انبانا احمد بن علي اليزدي اخبرنا ابو احمد قال ابو الخطاب محمد بن الخطاب العدوي مولي عمر بن الخطاب سكن بغداد اخبرنا السمسار اخبرنا الصفار حدثنا بن قانع ان محمد بن الخطاب الخطابي توفي سنة اربع وثمانين وماءتين
   محمد بن خميس بن جميل ابو بكر حدث بصور عن هشام بن اسحاق الكناني صاحب جعفر بن محمد القلانسي الرملي وعن ابي عبد الله الروذباري حدثني عنه محمد بن علي الصوري حدثني الصوري اخبرنا ابو بكر محمد بن خميس بن جميل البغدادي بصور حدثنا ابو عبد الله احمد بن عطاء بن احمد اخبرني محمد بن الحسن صاحب سهل بن عبد الله قال قال سهل من كان مقيما علي ادني شبهة في ادني وقت فقلبه محجوب عن الله عز و جل
