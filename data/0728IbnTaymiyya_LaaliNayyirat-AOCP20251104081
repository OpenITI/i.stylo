 وقد ثبت عن النبي صلي الله عليه وسلم ان لما اشرف علي خيبر قال : الله اكبر، خربت خيبر، انا اذا نزلنا بساحة قوم فساء صباح المنذرين» وكان يكبر علي الاشراف مثل التكبير اذا ركب دابة، واذا علا نشزا من الارض، واذا صعد علي الصفا والمروة، وقال جابر : لكنا مع رسول الله الهل صلي الله عليه وسلم ا علونا كبرنا، واذا هبطنا سبحنا، فوضعت الصلاة علي ذلك رواه ابو داود. وجاء التكبير مكررا في الاذان في اوله وفي اخره، والاذان هو الذكر الرفيع، وفي اثناء الصلاة، وهو حال الرفع والخفض والقيام اليها، كما قال : لتحريمها التكبير وروي : ان التكبير يطفء الحريق.
 فالتكبير شرع ايضا لدفع العدو من شياطين الانس والجن، والنار التي هي عدو لنا، وهذا كله يبين ان التكبير مشروع في المواضع الكبار، لكثرة الجمع، او لعظمة الفعل ، او لقوة الحال . او نحو ذلك من الامور الكبيرة: ليبين ان الله اكبر، وتستولي كبرياءه في القلوب علي كبرياء تلك الامور الكبار، فيكون الدين كله لله ويكون العباد له مكبرون، فيحصل لهم مقصودان . مقصود العبادة بتكبير قلوبهم لله، ومقصود الاستعانة بانقياد ساءر المطالب لكبرياءه، ولهذا شرع التكبير علي الهداية والرزق والنصر؛ لان هذه الثلاث اكبر ما يطلبه العبد، وهي جماع مصالحه . والهدي اعظم من الرزق والنصر، لان الرزق والنصر قد لا ينتفع بهما الا في الدنيا، واما الهدي فمنفعته في الاخرة قطعا، وهو المقصود بالرزق والنصر، فخص بصريح التكبير ؛ لانه اكبر نعمة الحق. وذانك دونه، فوسع الامر فيهما بعموم ذكر اسم الله.
 فجماع هذا ان التكبير مشروع عند كل امر كبير من مكان وزمان وحال ورجال، فتبين ان الله اكبر لتستولي كبرياءه في القلوب علي كبرياء ما سواه، ويكون له الشرف علي كل شرف . قال تعالي فيما روي عنه رسول صلي الله عليه وسلم : العظمة



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 ازاري، والكبرياء رداءي، فمن نازعني واحدا منهما عذبته .
 ولما قال سبحانه : (ولتحملوا العدة ولكبروا الله علك ما هدبكم ولعلكم تنكروب)[ البقرة :  ذكر التكبير والشكر، كما في قوله : (فاذكرون اذكركم واشكروالي ولا تتقرون )[ البقرة :  والشكر يكون بالقول وهو الحمد، ويكون بالعمل كما قال تعالي : (اعملواال داءد شكرا ) سبا :  فقرن بتكبير الاعياد الحمد . فقيل : الله اكبر، الله اكبر، لا اله الا الله، والله اكبر الله اكبر ولله الحمد؛ لانه قد طلب فيه التكبير والشكر . ولهذا روي في الاثر انه يقال فيه : ( الله اكبر علي ما هدانا، والحمد لله علي ما اولانا ليجمع بين التكبير والحمد حمد الشكر، كما جمع بين التحميد تحميد الثناء، والتكبير في قوله : (وقل الحمد لله الذي لم يتخذ ولدا ولر يكن لم شرك في الملك ولم يكن لر ول من الذل وكبره تكبيا ) فامر بتحميده وتكبيره.
 ومعلوم ان الكلمات التي هي افضل الكلام بعد القران اربع : سبحان الله، والحمد لله، ولا اله الا الله، والله اكبر وهي شطران: فالتسبيح قرين التحميد، ولهذا قال النبي صلي الله عليه وسل: كلمتان خفيفتان علي اللسان ثقيلتان في الميزان، حبيبتان الي الرحمن سبحان الله وبحمده، سبحان الله العظيم) اخرجاه في الصحيحين عن ابي هريرة.
 وقا صلي الله عليه وسلم،فيما رواه مسلم عن ابي ذر: افضل الكلام ما اصطفي الله لملاءكته: سبحان الله وبحمده)
 وفي القران : (ونخن نسبح بحمدك ) (فسبح بحمد ربك واستغفرة انه كان توارب )ل . فكان النبيصلي الله عليه وسلم يقول في ركوعه : سبحانك اللهم ربنا وبحمدك، اللهم اغفر لي يتاول القران هكذا في الصحاح عن عاءشة فجعل قوله: لا سبحانك اللهم وبحمدك تاويل (فسبح بحمد ريك) وقد قال تعالي : (فاصر اب وعد الله حق واستغفر لذنبك وسبح بحمد رب بالعشي والايبكر)اف وقال: (فسبحان الله حين تمسون وحين تصبحون وله الحمد في السماوات والارض) والاثار في اقترانهما كثيرة.
 واما التهليل فهو قرين التكبير، كما في كلمات الاذان: الله اكبر الله اكبر،



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 اشهد ان لا اله الا الله، اشهد ان محمدا رسول الله، ثم بعد دعاء العباد الي الصلاة: الله اكبر، الله اكبر، لا اله الا الله، فهو مشتمل علي التكبير والتشهد اوله واخره. وهو ذكر لله تعالي، وفي وسطه دعاء الخلق الي الصلاة، والفلاح. فالصلاة هي العمل . والفلاح هو ثواب العمل لكن جعل التكبير شفعا، والتشهد وترا، فمع كل تكبيرتين شهادة؛ وجعل اوله مضاعفا علي اخره. ففي [اول] الاذان يكبر اربعا، ويتشهد مرتين والشهادتان جميعا باسم الشهادة، وفي اخره التكبير مرتان فقط مع التهليل الذي لم يقترن به لفظ الشهادة، ولا الشهادة الاخري.
 وهذا والله اعلم بمنزلة الركعتين الاولتين، من الصلاة، مع الركعتين الاخريين، فان الاولتين فضلتا بقراءة السورة، وبالجهر في القراءة، فحصل الفضل في قدر القراءة، ووصفها، كما ان الشطر الاول من الاذان، فضل في قدر الذكر، وفي وصفه، لكن الوصف هنا كون التوحيد قرن به لفظ اشهد، ولهذا حذف في الاقامة عند من يختار ايتارها، وهي اقامة بلال، ما فضل به من القدر، كما يخفض من صوت الاقامة ، لان هذا المزيد من جنس الاصل فاشبه حذف الركعتين الاخريين في صلاة المسافر . واما الكلمات الاصول فلم يحذف منها شء.
 وهكذا سنة النبي صلي الله عيه وسلم في قيام الليل، وصلاة الكسوف، وغيرهما تطويل اول العبادة علي اخرها؛ لاسباب تقتضي ذلك.
 وكما جمع بين التكبير والتهليل في الاذان، جمع بينهما في تكبير الاشراف، فكان علي الصفا والمروة، واذا علا شرفا في غزوة او حجة او عمرة يكبر ثلاثا. ويقول : للا اله الا الله وحده لا شريك له، له الملك وله الحمد وهو علي كل شء قدير، لا اله الا الله وحده، صدق وعده، ونصر عبده، واعز جنده، وهزم الاحزاب وحدهل يفعل ذلك ثلاثا. وهذا في الصحاح وكذلك علي الدابة كبر ثلاثا، وهلل ثلاثا، فجمع بين التكبير والتهليل. وكذلك حديث عدي بن حاتم الذي رواه احمد والترمذي، فيه ان النبي صلي الله عليه وسلم ال له : يا عدي ما يفرك ? ايفرك ان يقال: لا اله الا الله، فهل تعلم من اله الا الله ? يا عدي! ما يفرك، ايفرك ان يقال: الله اكبر? فهل من شء اكبر من الله فقرن النبي صلي الله عليه وسلم ني التهليل والتكبير.
 وفي صحيح مسلم حديث ابي مالك الاشعري عن النبي صلي الله علي وسلم قال : لا الطهور شطر الايمان، والحمد لله تملا الميزان، وسبحان الله، والحمد لله تملان، او قال تملا ما ابين السماء والارض، والصلاة نور، والصدقة برهان، والصبر ضياء، والقران



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 حجة لك او عليك، كل الناس يغدو، فباءع نفسه، فمعتقها او موبقها فاخبر انه يملا ما بين السماء والارض، وهذا اعظم من ملءه للميزان.
 وفي الحديث الذي في الموطا حديث طلحة بن عبد الله بن كريز ان النبي صلي الله عليه وسل قال : افضل الدعاء دعاء يوم عرفة، وافضل ما قلت انا والنبيون من قبلي لا اله الا الله وحده لا شريك له، له الملك، وله الحمد، وهو علي كل شء قدير . فجمع في هذا الحديث بين : افضل الدعاء وافضل الثناء، فان الذكر نوعان: دعاء، وثناء، فقال : افضل الدعاء، دعاء يوم عرفة. وافضل ما قلت هذا الكلام. ولم يقل افضل ما قلت يوم عرفة، هذا الكلام. وانما هو افضل ما قلت مطلقا. وكذلك في حديث رواه ابن ابي الدنيا : «افضل الذكر لا اله الا الله، وافضل الدعاء الحمد لله.
 وايضا ففي الصحيح عن ابي هريرة عن النبي صلي الله عليه وسلم انا قال : الايمان بضع وسبعون شعبة : اعلاها قول لا اله الا الله، وادناها اماطة الاذي عن الطريق فقد صرح بان اعلي شعب الايمان هي هذه الكلمة.
 وايضا ففي صحيح مسلم ان النبي صلي الله عليه وسلم ال : يا ابي : اتدري اية اية في كتاب الله اعظم? قال : (الله لا اله الا هو الحي القيوم) فقال رسولالله ل صلي الله عليه وسلم : ليهنك العلم ابا المنذر فاخبر في هذا الحديث الصحيح انها اعظم اية في القران وفي ذاك انها اعلي شعب الايمان، وهذا غاية الفضل، فان الامر كله مجتمع في القران والايمان، فاذا كانت اعظم القران، واعلي الايمان ثبت لها غاية الرجحان.
 وايضا فان التوحيد اصل الايمان، وهو الكلام الفارق بين اهل الجنة واهل النار، وهو ثمن الجنة، ولا يصح اسلام احد الا به، ومن كان اخر كلامه لا اله الا الله دخل الجنة، وكل خطبة ليس فيها تشهد، فهي كاليد الجذماء، فمنزلته منزلة الاصل، ومنزلة التحميد والتسبيح منزلة الفرع.
 وايضا فانه مشروع علي وجه التعظيم، والجهر، وعند الامور العظيمة مثل



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 الاذان الذي ترفع به الاصوات وعند الصعود علي الاماكن العالية لما في ذلك من العلو والرفعة، ويجهر بالتكبير في الصلوات، وهو المشروع في الاعياد.
 وقال جابر : «كنا مع رسول اللهال صلي الله عليه وسل ا علونا كبرنا، واذا هبطنا سبحنا، فوضعت الصلاة علي ذلك رواه ابو داود وغيره. فبين ان التكبير مشروع عند العلو من الامكنة، والافعال، كما في الصلاة والاذان، والتسبيح مشروع عند الانخفاض في الامكنة والافعال، كما في السجود والركوع. ولهذا كانت السنة في التسبيح الاخفاء حين شرع، فلم يشرع من الجهر به والاعلان ما شرع من ذلك في التكبير والتهليل، ومعلوم ان الزيادة في وصف الذكر انما هو للزيادة في امره.
 واما حديث ابي ذر : «افضل الكلام ما اصطفي الله لملاءكته: سبحان الله وبحمده فيشبه والله اعلم ان يكون هذا في الكلام الذي لا يسن فيه الجهر، كما في الركوع والسجود، ونحوه، ولا يلزم ان يكون افضل مطلقا، بدليل ان قراءة القران افضل من الذكر، وقد نهي النبي صلي الله عليه وسلم عنها في الركوع والسجود. وقال : اني نهيت ان اقرا القران راكعا او ساجدا، اما الركوع فعظموا فيه الرب، واما السجود فاجتهدوا في الدعاء فقمن ان يستجاب لكم
 وهنا اصل ينبغي ان نعرفه. وهو ان الشء اذا كان افضل من حيث الجملة لم يجب ان يكون افضل في كل حال، ولا لكل احد، بل المفضول في موضعه الذي شرع فيه افضل من الفاضل المطلق، كما ان التسبيح في الركوع والسجود افضل من قراءة القران، ومن التهليل والتكبير، والتشهد في اخر الصلاة والدعاء بعده افضل من قراءة القران. وهذا كما قال النبي صلي الله عليه وسلم: يءم القوم اقراهم لكتاب الله، فان كانوا في القراءة سواء فاعلمهم بالسنة، فان كانوا في السنة سواء فاقدمهم هجرة، فان كانوا في الهجرة سواء فاقدمهم سنا او اسلاما ثم اتبع ذلك بقوله : ولا يءمن الرجل في سلطانه، ولا يجلس علي تكرمته الا باذنه فذكر الافضل فالافضل في الامامة، ثم بين ان صاحب المرتبة ذو السلطان مثل الامام الراتب كامير الحرب في العهد القديم، وكاءمة المساجد ونحوهم مقدمون علي غيرهم، وان كان غيرهم افضل منهم، وهذا كما ان الذهب افضل من الحديد، والنورة، وقد تكون هذه المعادن مقدمة علي الذهب عند الحاجة اليها دونه، وهذا ظاهر.
 وكذلك ايضا: اكثر الناس يعجزون عن افضل الاعمال، فلو امروا بها لفعلوها



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 علي وجه لا ينتفعون به، او ينتفعون انتفاعا مرجوحا، فيكون في حق احد هءلاء العمل الذي يناسبه وينتفع به افضل له مما ليس كذلك. ولهذا يكون الذكر لكثير من الناس افضل من قراءة القران؛ لان الذكر يورثه الايمان، والقران يورثه العلم، والعلم بعد الايمان . قال الله تعالي : ( يرفع الله الذين ء امنوا منكم والذين اوتوا العلر درجات) المجادلة : ] والقران يحتاج الي فهم وتدبر، وقد يكون عاجزا عن ذلك، لكن هءلاء يغلطون فيعتقد احدهم ان الذكر افضل مطلقا؛ وليس كذلك، بل قراءة القران في نفس الامر افضل من الذكر باجماع المسلمين؛ قال النبي صلي الله عليه وسلم، : افضل الكلام بعد القران اربع وهن من القران : سبحان الله، والحمد لله، ولا اله الا الله، والله اكبر رواه مسلم. وقال له رجل : اني لا استطيع ان احمل من القران شيءا، فعلمني ما يجزءني في صلاتي . فقال : لقل : سبحان الله، والحمد لله، ولا اله الا الله، والله اكبر ولهذا كان العلماء علي ان الذكر في الصلاة بدل عن القراءة لا يجوز الانتقال اليه الا عند العجز عن القراءة، بمنزلة التيمم مع الوضوء، وبمنزلة صيام الشهرين مع العتق، والصيام مع الهدي .
 وفي الحديث الذي في الترمذي : لما تقرب العباد الي الله بافضل مما خرج منه يعني القران، وفي حديث ابن عباس الذي رواه ابو داود والترمذي، وصححه عن النبي صلي الله علي وسلم ال : ان لله اهلين من الناس، قيل : من هم يا رسول الله? قال : اهل القران هم اهل الله وخاصته وكان النبي صلي الله عليه وسلم يدم اهل القران في المواطن، كما قدمهم يوم احد في القبور، فاذن لهم ان يدفنوا الرجلين والثلاثة في القبر الواحد، وقال : «قدموا الي القبلة اكثرهم قرانا.
 فقول النبي صلي الله عليه وسلم في حديث ابي ذر لما سءل : اي الكلام افضل : لفقال : سبحان الله وبحمده هذا خرج علي سءال ساءل . فربما علم من حال الساءل حالا مخصوصة، كما انه لما قال : افضل ما قلت انا والنبيون من قبلي لا اله الا الله



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 الي اخره . اراد بذلك من الذكر لا من القراءة، فان قراءة القران افضل من جنس الذكر من حيث الجملة، وان كان هذا الكلام قد يكون افضل من القراءة، كما ان الشهادتين في وقت الدخول في الاسلام، او تجديده، او عندما يقتضي ذكرهما مثل عقب الوضوء، ودبر الصلاة والاذان، وغير ذلك : افضل من القراءة. وكذلك في موافقة المءذن، فانه اذا كان يقرا وسمع المءذن فان موافقته في ذكر الاذان افضل له حيتءذ من القراءة حتي يستحب له قطع القراءة لاجل ذلك؛ لان هذا وقت هذه العبادة يفوت بفوتها، والقراءة لا تفوت.
 فنقول : الاحوال ثلاثة : حال يستحب فيها الاسرار، ويكره فيها الجهر؛ لانها حال انخفاض كالركوع والسجود . فهنا التسبيح افضل من التهليل والتكبير، وكذلك في بطون الاودية، واما ما السنة فيه الجهر والاعلان كالاشراف والاذان فالسنة فيه التهليل والتكبير، واما ما يشرع فيه الامران، فقد يكون هذا.
 واذا عرف ان التحميد قرين التسبيح، وان التهليل قرين التكبير، ففي تكبير الاعياد جمع بين القرينين، فجمع بين التكبير والتهليل، وبين التكبير والتحميد لقوله: (ولتكبروا الله علي ما هددكم ولعلكم تشكرون): فان الهداية اقتضت التكبير عليها، فضم اليه قرينه، وهو التهليل. والنعمة اقتضت الشكر عليها، فضم اليه ايضا التحميد، وهذا كما ان ركوب الدابة لما اجتمع فيه انه شرف من الاشراف، وانه موضع نعمة، كان النبي صلي الله عليه وسلم يجمع عليها بين الامرين، فانه قال سبحاته : (لتستوا علي ظهوره، ثم تذكروا نعمة رببكتم اذا استويتم عليه وتقولوا سبحان الذي سخر لنا هذا وما كنا له مقرنين وانا الي ربنا لمنقلبون)، فامر بذكر نعمة الله عليه، وذكرها بحمدها، وامر بالتسبيح الذي هو قرين الحمد فكان النبي صلي الله عليه وسلم ما اتي بالدابة فوضع رجله في الغرز قال : بسم الله فلما استوي علي ظهرها قال : الحمد لله ثم قال : (سبحن الذي سخر لنا هاذا وما كتا له مقرنين * وانا الي ربنا لمنقلبون) ،] ثم لحمد ثلاثا، وكبر ثلاثا ثم قال : لا اله الا انت سبحانك، ظلمت نفسي فاغفر لي، ثم ضحك وقال : ضحكت من ضحك الرب اذا قال العبد ذلك يقول الله: علم عبدي انه لا يغفر الذنوب غيري.
 فذكر بعد ذلك الاشراف وهو التكبير مع التهليل، وختمه بالاستغفار لانه مقرون



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 بالتوحيد، كما قد رتب اقتران الاستغفار بالتوحيد في غير موضع، كقوله: (فاعلر انه لا اله الا الله واستعفر لذنبك) وقوله : (الا تعبدوا الا الله انني لكر منه نذير وبشير * وان استغفروا ربكر) وقوله : (فاستقيموا اليه واستغفروة)صلت:  فكان ذكره علي الدابة مشتملا علي الكلمات الاربع الباقيات الصالحات مع الاستغفار.
 فهكذا ذكر الاعياد اجتمع فيه التعظيم، والنعمة، فجمع بين التكبير والحمد. فالله اكبر علي ما هدانا، والحمد لله علي ما اولانا.
 وقد روي عن ابن عمر انه كان يكبر ثلاثا، ويقول : لا اله الا الله وحده لا شريك له، له الملك، وله الحمد، وهو علي كل شء قدير. فيشبهه بذكر الاشراف في تثليثه، وضم التهليل اليه، وهذا اختيار الشافعي.
 واما احمد وابو حنيفة وغيرهما فاختاروا فيه ما رووه عن طاءفة من الصحابة، ورواه الدارقطني من حديث جابر مرفوعا الي النبي صلي الله عليه وسلم ان قال : «الله اكبر، الله اكبر، لا اله الا الله، والله اكبر، الله اكبر، ولله الحمد فيشفعونه مرتين، ويقرنون به في احداهما التهليل، وفي الاخري الحمد، تشبيها له بذكر الاذان. فان هذا به اشبه، لانه متعلق بالصلاة، ولانه في الاعياد التي يجتمع فيها اجتماعا عاما، كما ان الاذان لاجتماع الناس، فشابه الاذان، في انه تكبير اجتماع لا تكبير مكان، وانه متعلق بالصلاة لا بالشرف، فشرع تكريره كما شرع تكرير تكبير الاذان، وهو في كل مرة مشفوع، وكل الماثور حسن.
 ومن الناس من يثلثه اول مرة، ويشفعه ثاني مرة، وطاءفة من الناس تعمل بهذا.
 وقاعدتنا في هذا الباب اصح القواعد، ان جميع صفات العبادات من الاقوال والافعال اذا كانت ماثورة اثرا يصح التمسك به لم يكره شء من ذلك، بل يشرع ذلك كله كما قلنا في انواع صلاة الخوف، وفي نوعي الاذان الترجيع وتركه، ونوعي الاقامة شفعها وافرادها، وكما قلنا في انواع التشهدات، وانواع الاستفتاحات، وانواع الاستعاذات وانواع القراءات، وانواع تكبيرات العيد الزواءد، وانواع صلاة الجنازة وسجود السهو، والقنوت قبل الركوع، وبعده، والتحميد باثبات الواو وحذفها، وغير ذلك، لكن قد يستحب بعض هذه الماثورات، ويفضل علي بعض اذا قام دليل يوجب التفضيل، ولا يكره الاخر.
 ومعلوم انه لا يمكن المكلف ان يجمع في العبادة المتنوعة بين النوعين في الوقت الواحد، لا يمكنه ان ياتي بتشهدين معا، ولا بقراءتين معا، ولا بصلاتي



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 خوف معا، وان فعل ذلك مرتين كان ذلك منهيا عنه، فالجمع بين هذه الانواع محرم تارة، ومكروه اخري، ولا تنظر الي من قد يستحب الجمع في بعض ذلك، مثل ما رايت بعضهم قد لفق الفاظ الصلوات علي النبي الماثورة عن النبي صلي الله عليه وسلم واستحب فعل ذلك الدعاء الملفق، وقال في حديث ابي بكر الصديق المتفق عليه لما قال للنبي الله عليه وسلم: علمني دعاء ادعو به في صلاتي فقال : لقل : اللهم اني ظلمت نفسي ظلما كبيرا، وفي رواية : كثيرا، وانه لا يغفر الذنوب الا انت الغفور الرحيم . فقال: يستحب ان يقول : كثيرا، كبيرا، وكذلك يقول في اشباه هذا، فان هذا ضعيف، فان هذا اولا ليس سنة، بل خلاف المسنون، فان النبي صلي الله عليه وسلم لم يقل ذلك جميعه جميعا، وانما كان يقول هذا تارة، وهذا تارة، ان كان الامران ثابتين عنه، فالجمع بينهما ليس سنة ، بل بدعة وان كان جاءزا.
 الثاني : ان جمع الفاظ الدعاء، والذكر الواحد، علي وجه التعبد مثل جمع حروف القراء كلهم لا علي سبيل الدرس والحفظ، لكن علي سبيل التلاوة والتدبر ، مع تنوع المعاني، مثل ان يقرا في الصلاة: (في قلوبهم مرض فزادهم الله مرضا ولهم عذاب اليم بما كانوا يكذبون) بما كانوا يكذبون. (ربنا باعد بين اسفارنا ) [سبا : ] بعد بين اسفارنا» . (وما الله بغافل عما تعملون):  عما يعملون» . (ويضع عنهم اصرهم)عراف: ] اصارهم. وارجلكم الي الكعبين» (وارجلكم). (ولا تقربوهن حت يطهرن) [البقرة: حتي يطهرن. (ولا يحل لكم ان تاخذوا مما اتيتموهن شيءا الا ان يخافا )] الا ان يخافا، (او لامسنم النساء ) «او لمستم» . ومعلوم ان هذا بدعة مكروهة قبيحة .
 الثالث : ان الاذكار المشروعة ايضا لو لفق الرجل له تشهدا من التشهدات الماثورة فجمع بين حديث ابن مسعود، و وصلواته، وبين زاكيات تشهد عمر، ومباركات ابن عباس، بحيث يقول : التحيات لله، والصلوات، والطيبات، والمباركات، والزاكيات، لم يشرع له ذلك، ولم يستحب، فغيره اولي بعدم الاستحباب.
 الرابع : ان هذا انما يفعله من [ذهب] الي كثرة الحروف. والالفاظ، وقد ينقص المعني، او يتغير بذلك، ولو تدبر القول لعلم ان كل واحد من الماثور يحصل لمقصود، وان كان بعضها يحصله اكمل فانه اذا قال: ظلما كثيرا، فمتي كثر فهو كبير في المعني، ومتي كبر فهو كثير في المعني.



![image file](./IbnTaymiyya.LaaliNayyirat_.png)

 واذا قال : اللهم صل علي محمد، وعلي اله محمد او قال : اللهم صل علي محمد، وازواجه وذريته، فازواجه وذريته من اله بلا شك، او هم اله، فاذا جمع بينهما وقال : «علي ال محمد، وعلي ازواجه وذريته» لم يكن قد تدبر المشروع. فالحاصل ان احد الذكرين ان وافق الاخر في اصل المعني كان كالقراءتين للتين معناهما واحد، وان كان المعني متنوعا، كان كالقراءتين المتنوعتي المعني، علي التقديرين فالجمع بينهما في وقت واحد لا يشرع.
 واما الجمع في صلوات الخوف، او التشهدات، او الاقامة او نحو ذلك بين نوعين، فمنهي عنه باتفاق المسلمين، واذا كانت هذه العبادات القولية او الفعلية لا بد من فعلها علي بعض الوجوه، كما لا بد من قراءة القران علي بعض القراءات، لم يجب ان يكون كل من فعل ذلك علي بعض الوجوه انما يفعله علي الوجه الافضل عنده، او قد لا يكون فيها افضل، وانما ذلك بمنزلة الطرق الي مكة، فكل اهل ناحية يحجون من طريقهم، وليس اختيارهم لطريقهم؛ لانها افضل، بحيث يكون حجهم افضل من حج غيرهم، بل لانه لا بد من طريق يسلكونها، فسلكوا هذه اما ليسرها عليهم، واما لغير ذلك، وان كان الجميع سواء. فينبغي ان يفرق بين اختيار بعض الوجوه المشروعة لفضله في نفسه عند مختاره، وبين كون اختيار واحد منها ضروري. والمرجح له عنده سهولته عليه، او غير ذلك.
 والسلف كان كل منهم يقرا ويصلي ويدعو ويذكر علي وجه مشروع، واخذ ذلك الوجه عنه اصحابه، واهل بقعته، وقد تكون تلك الوجوه سواء، وقد يكون بعضها افضل، فجاء في الخلف من يريد ان يجعل اختياره لما اختاره لفضله، فجاء الاخر فعارضه في ذلك، ونشا من ذلك اهواء مردية مضلة، فقد يكون النوعان سواء عند الله ورسوله فتري كل طاءفة طريقها افضل، وتحب من يوافقها علي ذلك وتعرض عمن يفعل ذلك الاخر، فيفضلون ما سوي الله بينه، ويسوون ما فضل الله بينه، وهذا باب من ابواب التفرق والاختلاف الذي دخل علي الامة، وقد نهي عنه الكتاب والسنة، وقد نهي النبي صلي الله عليه وسلم، عن عين هذا الاختلاف، في الحديث الصحيح، كما قررت مثل ذلك في « الصراط المستقيم»، حيث قال : «اقراوا كما علمتم» فالواجب ان هذه الانواع لا يفضل بعضها علي بعض الا بدليل شرعي، لا يجعل نفس



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 تعيين واحد منها لضرورة اداء العبادة موجبا لرجحانه؛ فان الله اذا اوجب علي عتق رقبة ، او صلاة جماعة، كان من ضرورة ذلك، ان اعتق رقبة واصلي جماعة، ولا يجب ان تكون افضل من غيرها، بل قد لا تكون افضل بحال، فلا بد من نظر في الفضل، ثم اذا فرض ان الدليل الشرعي يوجب الرجحان، لم يعب علي من فعل الجاءز، ولا ينفر عنه لاجل ذلك، ولا يزاد الفضل علي مقدار ما فضلته الشريعة، فقد يكون الرجحان يسيرا .
 لكن هنا مسالة تابعة، وهو انه مع التساوي او الفضل، ايما افضل للانسان المداومة علي نوع واحد من ذلك، او ان يفعل هذا تارة، وهذا تارة، كما كان النبي صل الله عليه وسلم فعل . فمن الناس من يداوم علي نوع من ذلك مختارا له، او معتقدا انه افضل، ويري ان مداومته علي ذلك النوع افضل. واما اكثرهم فمداومته عادة، ومراعاة لعادة اصحابه واهل طريقته، لا لاعتقاد الفضل.
 والصواب ان يقال : التنوع في ذلك متابعة للنبي صلي الله عليه وسلم، فان في هذا اتباعا للسنة والجماعة، واحياء لسنته، وجمعا بين قلوب الامة، واخذا بما في كل واحد من الخاصة، افضل من المداومة علي نوع معين، لم يداوم عليه النبي صلي الله عليه وسلم وجوه :
 احدها : ان هذا هو اتباع السنة والشريعة، فان النبي صلي الله عليه وسلم ا كان قد فعل هذا تارة، وهذا تارة، ولم يداوم علي احدهما كان موافقته في ذلك هو التاسي والاتباع المشروع، وهو ان يفعل ما فعل علي الوجه الذي فعل لانه فعله.
 الثاني : ان ذلك يوجب اجتماع قلوب الامة واءتلافها، وزوال كثرة التفرق والاختلاف والاهواء بينها، وهذه مصلحة عظيمة، ودفع مفسدة عظيمة، ندب الكتاب والسنة الي جلب هذه، ودرء هذه، قال الله تعالي : (واعتصموا بحبل الله جميعا ولا تفرقوا) لال عمران: ] وقال تعالي : (ولا تكونوا كالذين تفرقوا واختلفوا من بعد ما جاءهم البيتكت) ل عمران: وقال تعالي : (ان الذين فرقوا دينهم وكاناوا شيعا لست منهم في شء) ].
 الثالث : ان ذلك يخرج الجاءز المسنون عن ان يشبه بالواجب، فان المداومة علي المستحب او الجاءز مشبهة بالواجب، ولهذا اكثر هءلاء المداومين علي بعض الانواع الجاءزة او المستحبة لو انتقل عنه لنفر عنه قلبه، وقلب غيره اكثر مما ينفر عن ترك كثير من الواجبات؛ لاجل العادة التي جعلت الجاءز كالواجب.
 الرابع : ان في ذلك تحصيل مصلحة كل واحد من تلك الانواع، فان كل نوع لا بد له من خاصة، وان كان مرجوحا، فكيف اذا كان مساويا، وقد قدمنا ان المرجوح يكون راجحا في مواضع.



![image file](./IbnTaymiyya.LaaliNayyirat_.png)

 الخامس: ان في ذلك وضعا لكثير من الاصار والاغلال التي وضعها الشيطان علي الامة بلا كتاب من الله، ولا اثارة من علم، فان مداومة الانسان علي امر جاءز مرجحا له علي غيره ، ترجيحا يحب من يوافقه عليه، ولا يحب من لم يوافقه عليه، بل ربما ابغضه، بحيث ينكر عليه تركه له، ويكون ذلك سببا لترك حقوق له وعليه، يوجب ان ذلك يصير اصرا عليه، لا يمكنه تركه، وغلا في عنقه يمنعه ان يفعل بعض ما امر به، وقد يوقعه في بعض ما نهي عنه.
 وهذا القدر الذي قد ذكرته واقع كثيرا، فان مبدا المداومة علي ذلك يورث اعتقادا ومحبة غير مشروعين، ثم يخرج الي المدح والذم، والامر والنهي، بغير حق، ثم يخرج ذلك الي نوع من الموالاة والمعاداة غير المشروعين، من جنس اخلاق الجاهلية كاخلاق الاوس والخزرج في الجاهلية، واخلاق
 ثم يخرج من ذلك الي العطاء والمنع، فيبذل ماله علي ذلك عطية ودفعا، وغير ذلك من غير استحقاق شرعي، ويمنع من امر الشارع باعطاءه ايجابا او استحبابا، ثم يخرج من ذلك الي الحرب والقتال، كما وقع في بعض ارض المشرق، ومبدا ذلك تفضيل ما لم تفضله الشريعة والمداومة عليه، وان لم يعتقد فضله سبب لاتخاذه فاضلا اعتقادا وارادة فتكون المداومة علي ذلك اما منهيا عنها، واما مفضولة، والتنوع في المشروع بحسب ما تنوع فيه الرسول صلي الله عليه وسلم فضل واكمل.
 السادس : ان في المداومة علي نوع دون غيره هجران لبعض المشروع وذلك سبب لنسيانه والاعراض عنه، حتي يعتقد انه ليس من الدين، بحيث يصير في نفوس كثير من العامة انه ليس من الدين، وفي نفوس خاصة هذه العامة عملهم مخالف علمهم، فان علماءهم يعلمون انه من الدين ثم يتركون بيان ذلك اما خشية من الخلق، واما اشتراء بايات الله ثمنا قليلا من الرءاسة والمال، كما كان عليه اهل الكتاب، كما قد راينا من تعءد ان لا يسمع اقامة الا موترة، او مشفوعة، فاذا سمع الاقامة الاخري نفر عنها وانكرها، ويصير كانه سمع اذانا ليس اذان المسلمين وكذلك من اعتاد القنوت قبل الركوع او بعده. 
 وهجران بعض المشروع سبب لوقوع العداوة والبغضاء بين الامة. قال الله تعالي : (ومب الذين قالوا انا نصااري احدنا ميثاقهم فنسوا حظا مما ذكروا به فاغرتنا بينهم العداوة والبغضاء ال يوم القيامة) فاخبر سبحانه ان نسيانهم حظا مما ذكروا به سبب لاغراء العداوة والبغضاء بينهم، فاذا اتبع الرجل جميع المشروع المسنون، واستعمل الانواع المشروعة، هذا تارة، وهذا تارة، كان قد



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 حفظت السنة علما وعملا، وزالت المفسدة المخوفة من ترك ذلك.
 ونكتة هذا الوجه انه وان جاز الاقتصار علي فعل نوع، لكن حفظ النوع الاخر من الدين ليعلم انه جاءز مشروع، وفي العمل به تارة حفظ للشريعة، وترك ذلك قد يكون سببا لاضاعته ونسيانه.
 السابع : ان الله يامر بالعدل والاحسان، والعدل التسوية بين المتماثالين، وحرم الظلم علي نفسه، وجعله محرما بين عباده، ومن اعظم العدل العدل في الامور الدينية، فان العدل في امر الدنيا من الدماء والاموال كالقصاص والمواريث، وان كان واجبا، وتركه ظلم فالعدل في امر الدين اعظم منه، وهو العدل بين شراءع الدين، وبين اهله .
 فاذا كان الشارع قد سءي بين عملين او عاملين : كان تفضيل احدهما من الظلم لعظيم، واذا فضل بينهما كانت التسوية كذلك، والتفضيل او التسوية بالظن وهو النفوس من جنس دين الكفار، فان جميع اهل الملل والنحل يفضل احدهم دينه اما ظنا، واما هوي، اما اعتقادا، واما اقتصادا، وهو سبب التمسك به وذم غيره.
 فاذا كان رسول الله له صلي الله عليه وسلم د شرع تلك الانواع، اما بقوله، واما بعمله، وكثير منها لم يفضل بعضها علي بعض، كانت التسوية بينها من العدل والتفضيل من الظلم، وكثير مما تتنازع الطواءف من الامة في تفاضل انواعه، لا يكون بينها تفاضل، بل هي متساوية وقد يكون ما يختص به احدهما مقاوما لما يختص به الاخر، ثم تجد احدهم يسال : ايما افضل هذا او هذا? وهي مسالة فاسدة، فان السءال عن التعيين فرع ثبوت الاصل، فمن قال ان بينهما تفاضلا، حتي نطلب عين الفاضل?!.
 والواجب ان يقال: هذان متماثلان، او متفاضلان، وان كانا متفاضلين، فهل التفاضل مطلقا، او فيه تفصيل بحيث يكون هذا افضل في وقت، وهذا افضل في وقت? ثم اذا كانت المسالة كما تري فغالب الاجوبة صادرة عن هوي وظنون كاذبة خاطءة، ومن اكبر اسباب ذلك المداومة علي ما لم تشرع المداومة عليه، والله اعلم.
 وسءل رحمه الله تعالي : هل التهنءة في العيد وما يجري علي السنة الناس: عيدك مبارك» وما اشبهه، هل له اصل في الشريعة? ام لا? واذا كان له اصل في الشريعة، فما الذي يقال? افتونا ماجورين
 فاجاب: اما التهنءة يوم العيد يقول بعضهم لبعض اذا لقيه بعد صلاة العيد: تقبل الله منا ومنكم، واحاله الله عليك، ونحو ذلك، فهذا قد روي عن طاءفة من الصحابة انهم كانوا يفعلونه، ورخص فيه الاءمة، كاحمد وغيره.



![image file](./IbnTaymiyya.LaaliNayyirat_.png)

 لكن قال احمد: انا لا ابتدء احدا، فان ابتداني احد اجبته، وذلك لان جواب التحية واجب، واما الابتداء بالتهنءة فليس سنة مامورا بها، ولا هو ايضا مما نهي عنه، فمن فعله فله قدوة، ومن تركه فله قدوة. والله اعلم.
 باب صلاة الكسوف
 سءل شيخ الاسلام رحمه الله تعالي : عن قول اهل التقاويم: في ان الرابع عشر من هذا الشهر يخسف القمر، وفي التاسع والعشرين تكسف الشمس، فهل يصدقون في ذلك? واذا خسفا هل يصلي لهما? ام يسبح? واذا صلي كيف صفة الصلاة؟ ويذكر لنا اقوال العلماء في ذلك
 فاجاب : الحمد لله. الخسوف والكسوف لهما اوقات مقدرة، كما لطلوع الهلال وقت مقدر، وذلك ما اجري الله عادته بالليل والنهار. والشتاء والصيف، وساءر ما يتبع جريان الشمس والقمر.
 وذلك من ايات الله تعالي . كما قال تعالي : (وهو الذي خلق اليل والنبار والشمس والقمر كل في فلك يسبحون ) وقال تعالي : (هو الذي جعل الشمس ضياء والقمر نورا وقدره منازل لنعلموا عدد السنين والحساب ما خلق الله ذلك الا بالحق)ون:] وقال تعالي : (الشمس والقمر بحسبان) وقال تعالي : (فالق الاصباح وجعل التل سكنا والشمس والقمر حسبانا ذلك تقدير العزبيز العليم ) وقال تعالي: (يكلونك عن الاهلة قل هي مواقيت للناس والحج) وقال تعالي : (ان عدة الشهور عند الله اثنا عشر شهرا في كتاب الله يوم خلق السماوات والارض منها ازبعة حرم ذلك الدين القيم ).
 رقال تعالي : (واية لهم اليل نسلخ منه النهار فاذاهم مظلمون * والشمس تجري لمستقر لها ذلك تقدير العربيز العليم * والقيمر قدرناه منازل حت عاد كالعرجون القديم لا الشمس ينبغي لها ان تدرك القمر ولا اليل سابق النمار وكل في فلك يسبحون )
 وكما ان العادة التي اجراها الله تعالي ان الهلال لا يستهل الا ليلة ثلاثين من الشهر، او ليلة احدي وثلاثين، وان الشهر لا يكون الا ثلاثين، او تسعة وعشرين. فمن ظن ان الشهر يكون اكثر من ذلك، او اقل، فهو غالط.
 فكذلك اجري الله العادة ان الشمس لا تكسف الا وقت الاستسرار، وان القمر لا يخسف الا وقت الابدار، ووقت ابداره هي الليالي البيض التي يستحب صيام ايامها : ليلة الثالث عشر، والرابع عشر، والخامس عشر، فالقمر لا يخسف الا في هذه الليالي.



![image file](./IbnTaymiyya.LaaliNayyirat_.png)

 والهلال يستسر اخر الشهر : اما ليلة، واما ليلتين. كما يستسر ليلة تسع وعشرين، وثلاثين، والشمس لا تكسف الا وقت استسراره وللشمس والقمر ليالي معتادة ، من عرفها عرف الكسوف والخسوف. كما ان من علم كم مضي من الشهر يعلم ان الهلال يطلع في الليلة الفلانية او التي قبلها.
 لكن العلم بالعادة في الهلال علم عام، يشترك فيه جميع الناس، واما العلم بالعادة في الكسوف والخسوف فانما يعرفه من يعرف حساب جريانهما، وليس خبر الحاسب بذلك من باب علم الغيب، ولا من باب ما يخبر به من الاحكام التي يكون كذبه فيها اعظم من صدقه، فان ذلك قول بلا علم ثابت، وبناء علي غير اصل صحيح.
 وفي سنن ابي داود عن النبي صلي الله عليه وسلما قال : لامن اقتبس شعبة من النجوم فقد اقتبس شعبة من السحر زاد ما زاد». وفي صحيح مسلم عن النبي صلي الله ليه وسلم ان قال : من اتي عرافا فساله عن شء فصدقه لم يقبل الله صلاته اربعين يوما. والكهان اعلم بما يقولونه من المنجمين في الاحكام، ومع هذا صح عن النبي صلي الله عليه وسلم ان نهي عن اتيانهم، ومسالتهم، فكيف بالمنجم!? وقد بسطنا هذا في غير هذا الموضع، عن هذا الجواب.
 واما ما يعلم بالحساب فهو مثل العلم باوقات الفصول، كاول الربيع، والصيف، والخريف، والشتاء، لمحاذاة الشمس اواءل البروج، التي يقولون فيها ان الشمس نزلت في برج كذا : اي حاذته.
 ومن قال من الفقهاء ان الشمس تكسف في غير وقت الاستسرار فقد غلط، وقال ما ليس له به علم. وما يروي عن الواقدي من ذكره: ان ابراهيم ابن النبي صلي الله عليه وسلم. مات يوم العاشر من الشهر، وهو اليوم الذي صلي فيه النبي صلي الله عليه وسلم علاة الكسوف: غلط. والواقدي لا يحتج بمسانيده، فكيف بما ارسله من غير ان يسنده الي احد، وهذا فيما لم يعلم انه خطا، فاما هذا فيعلم انه خطا. ومن جوز هذا فقد قفا ما ليس له به علم، ومن حاج في ذلك فقد حاج في ما ليس له به علم.
 واما ما ذكره طاءفة من الفقهاء من اجتماع صلاة العيد والكسوف فهذا ذكروه في ضمن كلامهم فيما اذا اجتمعت صلاة الكسوف وغيرها من الصلوات، فقد راوا اجتماعها مع الوتر، والظهر، وذكروا صلاة العيد، مع عدم استحضارهم هل يمكن



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 ذلك في العادة او لا يمكن، فلا يوجد في تقديرهم ذلك العلم بوجود ذلك في الخارج، لكن استفيد من ذلك العلم علم ذلك علي تقدير وجوده، كما يقدرون مساءل يعلم انها لا تقع لتحرير القواعد، وتمرين الاذهان علي ضبطها.
 واما تصديق المخبر بذلك وتكذيبه فلا يجوز ان يصدق الا ان يعلم صدقه، ولا يكذب الا ان يعلم كذبه، كما قال النبي صلي الله عليه وسلم :( اذا حدثكم اهل الكتاب فلا تصدقوهم، ولا تكذبوهم فاما ان يحدثوكم بحق فتكذبوهم، واما ان يحدثوكم بباطل فتصدقوهم».
 والعلم بوقت الكسوف والخسوف وان كان ممكنا، لكن هذا المخبر المعين قد يكون عالما بذلك، وقد لا يكون، وقد يكون ثقة في خبره، وقد لا يكون. وخبر المجهول الذي لا يوثق بعلمه وصدقه ولا يعرف كذبه موقوف. ولو اخبر مخبر بوقت الصلاة وهو مجهول لم يقبل خبره، ولكن اذا تواطا خبر اهل الحساب علي ذلك فلا يكادون يخطءون، ومع هذا فلا يترتب علي خبرهم علم شرعي، فان صلاة الكسوف والخسوف لا تصلي الا اذا شاهدنا ذلك، واذا جوز الانسان صدق المخبر بذلك، او غلب علي ظنه فنوي ان يصلي الكسوف والخسوف عند ذلك، واستعد ذلك الوقت لرءية ذلك، كان هذا حثا من باب المسارعة الي طاعة الله تعالي وعبادته، فان الصلاة عند الكسوف متفق عليها بين المسلمين، وقد تواترت بها السنن عن النبي صلي الله عليه وسلم، ورواها اهل الصحيح، والسنن، والمسانيد من وجوه كثيرة. واستفاض عنه انه صلي بالمسلمين صلاة الكسوف يوم مات ابنه ابراهيم.
 وكان بعض الناس ظن ان كسوفها كان لان ابراهيم مات، فخطبهم النبي صلي الله عليه وسلم وقال : لاان الشمس والقمر ايتان من ايات الله، لا يخسفان لموت احد، ولا لحياته، فاذا راييتموهما فافزعوا الي الصلاة. وفي رواية في الصحيح: ولكنهما ايتان من ايات الله يخوف بهما عباده.
 وهذا بيان مده صلي الله عليه وسلماناما سبب لنزول عذاب بالناس، فان الله انما يخوف عباده بما يخافونه اذا عصوه، وعصوا رسله، وانما يخاف الناس مما يضرهم، فلولا امكان حصول الضرر بالناس عند الخسوف ما كان ذلك تخويفا، قال تعالي : (وءانينا ثمود الناقة مبصرة فظلموا ببا وما نرسل بالايات الا تخويفا)، وامر النبي صلي الله عليه وسلم ما يزيل الخوف. امر بالصلاة والدعاء، والاستغفار، والصدقة، والعتق، حتي يكشف ما بالناس، وصلي بالمسلمين في الكسوف صلاة طويلة.



![image file](./IbnTaymiyya.LaaliNayyirat_.png)

 وقد روي في صفة صلاة الكسوف انواع؛ لكن الذي استفاض عند اهل العلم بسنة رسول الل صلي الله عليه وسلم، ورواه البخاري ومسلم من غير وجه، وهو الذي استحبه اكثر اهل العلم : كمالك، والشافعي، واحمد: انه صلي بهم ركعتين، في كل ركعة ركوعان، يقرا قراءة طويلة، ثم يركع ركوعا طويلا، دون القراءة، ثم يقوم فيقرا قراءة طويلة دون القراءة الاولي، ثم يركع ركوعا دون الركوع الاول، ثم يسجد سجدتين طويلتين . وثبت عنه في الصحيح : انه جهر بالقراءة فيها.
 والمقصود ان تكون الصلاة وقت الكسوف الي ان يتجلي، فان فرغ من الصلاة قبل التجلي ذكر الله ودعاه، الي ان يتجلي .
 والكسوف يطول زمانه تارة، ويقصر اخري، بحسب ما يكسف منها، فقد تكسف كلها، وقد يكسف نصفها، او ثلثها. فاذا عظم الكسوف طول الصلاة، حتي يقرا بالبقرة ونحوها، في اول ركعة، وبعد الركوع الثاني يقرا بدون ذلك.
 وقد جاءت الاحاديث الصحيحة عن النبي صلي الله عليه وسلم ما ذكرناه كله مثل ما في الصحيحين عن ابي مسعود الانصاري قال : انكسفت الشمس يوم مات ابراهيم ابن النبي صلي الله عليه وسلم فقال الناس : انكسفت الشمس لموت ابراهيم، فقال رسول الله له صلي الله عليه وسلم، : ان الشمس والقمر ايتان من ايات الله، لا ينكسفان لموت احد، ولا لحياته، فاذا رايتم ذلك فافزعوا الي ذكر الله، والي الصلاة.
 وفي الصحيح عن ابي موسيلها صلي الله عليه وسلم فل : هذه الايات التي يرسلها الله لا تكون لموت احد، ولا لحياته، ولكن الله يخوف بها عباده، فاذا رايتم شيءا من ذلك، فافزعوا الي ذكره، ودعاءه، واستغفاره
 وفي الصحيحين من حديث جابرله صلي الله عليه وسلم ال : ان الشمس والقمر ايتان من ايات الله وانهما لا ينكسفان لموت احد من الناس، فاذا رايتم شيءا من ذلك فصلوا حتي ينجلي» وفي رواية عن ابن مسعود : فاذا رايتم شيءا منها فصلوا وادعوا، حتي يكشف ما بكم. وفي رواية لعاءشة : فصلوا حتي يفرج الله ما بكم.
 وفي الصحيحين عن عاءشة : ان الشمس خسفت علي عهد رسولالله صليالل عليهوسلم فخرج رتسول اللل ا ل الي المسجد، فقام وكبر، وصف الناس وراءه، فاقترا



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 رسول الله صله صلي الله عليه وسلم واءة طويلة، ثم كبر فركع ركوعا طويلا، ثم رفع راسه. فقال : سمع الله لمن حمده، ربنا ولك الحمد. ثم قام فاقترا قراءة طويلة، هي ادني من القراءة الاولي، ثم كبر فركع ركوعا طويلا هو ادني من الركوع الاول، ثم قال : سمع الله لمن حمده، ربنا ولك الحمد، ثم سجد، ثم فعل في الركعة الاخري مثل ذلك، حتي استكمل اربع ركعات، واربع سجدات، وانجلت الشمس قبل ان ينصرف.
 وقد جاء اطالته للسجود في حديث صحيح، وكذلك الجهر بالقراءة لكن روي في القراءة المخافتة، والجهر اصح. واما تطويل السجود فلم يختلف فيه الحديث، كين في كل چديث زيادة ليست في الاخر، والاحاديث الصحيحة كلها متفقة لا تختلف، والله اعلم.



![image file](./IbnTaymiyya.LaaliNayyirat_.png)

 سءل شيخ الاسلام رحمه الله تعالي : عن قوم مسلمين مجاوري النصاري: فهل يجوز للمسلم اذا مرض النصراني ان يعوده ? واذا مات ان يتبع جنازته? وهل علي من فعل ذلك من المسلمين وزر، ام لا?
 فاجاب : الحمد لله رب العالمين. لا يتبع جنازته، واما عيادته فلا باس بها. فانه قد يكون في ذلك مصلحة لتاليفه علي الاسلام، فاذا مات كافرا فقد وجبت له النار؛ ولهذا لا يصلي عليه. والله اعلم.
 وسءل رحمه الله تعالي: عن مرارة ما يذبح وغيره مما يحل اكله، او يحرم، هل يجوز التداوي بمرارته؟ ام لا؟
 فاجاب : الحمد لله. ان كان المذبوح مما يباح اكله جاز التداوي بمرارته، والا فلا .
 وسءل رحمه الله تعالي : عن المداواة بالخمر : وقول من يقول انها جاءزة. فما معني قول النبي صلي الله عليه وسلم انها داء وليست بدواء فالذي يقول تجوز للضرورة فما حجته وقالوا ان الحديث الذي قال فيه : ان الله لم يجعل شفاء امتي فيما حرم عليها ضعيف والذي يقول بجواز المداواة به فهو خلاف الحديث والذي يقول ذلك ما حجته?
 فاجاب : واما التداوي بالخمر فانه حرام عند جماهير الاءمة: كمالك واحمد، وابي حنيفة، وهو احد الوجهين في مذهب الشافعي؛ لانه قد ثبت في الصحيح عن النبي صلي الله عليه وسلم ان سءل عن الخمر تصنع للدواء، فقال: انها داء، وليست بدواء وفي سنن ابي داود عن النبي صلي الله عليه وسلم : انه نهي عن الدواء الخبيث والخمر ام الخباءث،



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 وذكر البخاري وغيره عن ابن مسعود انه قال : ان الله لم يجعل شفاء امتي فيما حرم عليها» ورواه ابو حاتم بن حبان في صحيحه مرفوعا الي النبي صلي الله عليه وسلم
 والذين جوزوا التداوي بالمحرم قاسوا ذلك علي اباحة المحرمات : كالميتة والدم للمضطر، وهذا ضعيف لوجوه:
 احدها : ان المضطر يحصل مقصوده يقينا بتناول المحرمات، فانه اذا اكلها سدت رمقه، وازالت ضرورته، واما الخباءث بل وغيرها فلا يتيقن حصول الشفاء بها، فما اكثر من يتداوي ولا يشفي، ولهذا اباحوا دفع الغصة بالخمر لحصول المقصود بها، وتعينها له، بخلاف شربها للعطش، فقد تنازعوا فيه، فانهم قالوا: انها لا تروي.
 الثاني : ان المضطر لا طريق له الي ازالة ضرورته الا الاكل من هذه الاعيان، واما التداوي فلا يتعين تناول هذا الخبيث، طريقا لشفاءه، فان الادوية انواع كثيرة، وقد يحصل الشفاء بغير الادوية كالدعاء، والرقية، وهو اعظم نوعي الدواء . حتي قال بقراط : نسبة طبنا الي طب ارباب الهياكل، كنسبة طب العجاءز الي طبنا.
 وقد يحصل الشفاء بغير سبب اختياري، بل بما يجعله الله في الجسم من القوي الطبيعية، ونحو ذلك.
 الثالث: ان اكل الميتة للمضطر واجب عليه في ظاهر مذهب الاءمة وغيرهم، كما قال مسروق : من اضطر الي الميتة فلم ياكل حتي مات دخل النار . واما التداوي فليس بواجب عند جماهير الاءمة. وانما اوجبه طاءفة قليلة، كما قاله بعض اصحاب الشافعي واحمد، بل قد تنازع العلماء، ايما افضل: التداوي? ام الصبر? للحديث الصحيح. حديث ابن عباس عن الجارية التي كانت تصرع، وسالت النبي صلي الله عليه وسلمان يدعو لها، فقال : «ان احببت ان تصبري ولك الجنة، وان احببت دعوت الله ان يشفيك فقالت : بل اصبر، ولكني اتكشف فادع الله لي ان لا اتكشف، فدعا لها ان لا تتكشف ولان خلقا من الصحابة والتابعين لم يكونوا يتداوون، بل فيهم من اختار المرض. كابي بن كعب، وابي ذر، ومع هذا فلم ينكر عليهم ترك التداوي.
 واذا كان اكل الميتة واجبا، والتداوي ليس بواجب، لم يجز قياس احدهما علي الاخر، فان ما كان واجبا قد يباح فيه ما لا يباح في غير الواجب؛ لكون مصلحة اداء



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 الواجب تغمر مفسدة المحرم، والشارع يعتبر المفاسد والمصالح، فاذا جتمعا قدم المصلحة الراجحة علي المفسدة المرجوحة؛ ولهذا اباح في الجهاد الواجب ما لم يبحه في غيره ، حتي اباح رمي العدو بالمنجنيق، وان افضي ذلك الي قتل النساء والصبيان، وتعمد ذلك يحرم، ونظاءر ذلك كثيرة في الشريعة، والله اعلم.
 وسءل رحمه الله تعالي : عن رجل وصف له شحم الخنزير لمرض به: هل يجوز له ذلك؟ ام لا؟
 فاجاب : واما التداوي باكل شحم الخنزير فلا يجوز.
 واما التداوي بالتلطخ به، ثم يغسله بعد ذلك، فهذا ينبني علي جواز مباشرة النجاسة في غير الصلاة. وفيه نزاع مشهور. والصحيح انه يجوز للحاجة. كما يجوز استنجاء الرجل بيده، وازالة النجاسة بيده.
 وما ابيح للحاجة جاز التداوي به . كما يجوز التداوي بلبس الحرير علي اصح القولين، وما ابيح للضرورة كالمطاعم الخبيثة فلا يجوز التداوي بها. كما لا يجوز التداوي بشرب الخمر ، لا سيما علي قول من يقول : انهم كانوا ينتفعون بشحوم الميتة في طلي السفن، ودهن الجلود، والاستصباح به، واقرهم النبي صلي الله عليه وسلم علي ذلك. وانما نهاهم عن ثمنه .
 ولهذا رخص من لم يقل بطهارة جلود الميتة بالدباغ في الانتفاع بها في اليابسات، في اصح القولين، وفي الماءعات التي لا تنجسها.
 وسءل رحمه الله تعالي : عمن يتداوي بالخمر، ولحم الخنزير وغير ذلك من المحرمات : هل يباح للضرورة ام لا? وهل هذه الاية: (وقد فصل لكم ماحرم عليكم الاما اضطررتم اليه) في اباحة ما ذكر ? ام لا?
 فاجاب : لا يجوز التداوي بذلك، بل قد ثبت في الصحيح عن النبي صلي الله عليه وسلم ا سءل عن الخمر يتداوي بها فقال : «انها داء وليست بدواء وفي السنن عنه انه نهي عن الدواء بالخبيث وقال : «ان الله لم يجعل شفاء امتي فيما حرم عليها
 وليس ذلك بضرورة، فانه لا يتيقن الشفاء بها، كما يتيقن الشبع باللحم المحرم؛ ولان الشفاء لا يتعين له طريق، بل يحصل بانواع من الادوية، وبغير ذلك بخلاف المخمصة فانها لا تزول الا بالاكل.



![image file](./IbnTaymiyya.LaaliNayyirat_.png)

 وسءل غفر الله له: عمن اصيب بمرض، فاذا اشتد عليه الوجع استغاث بالله تعالي ويبكي. فهل تكون استغاثته مما ينافي الصبر المامور به? او هو تضرع والتجاء?
 فاجاب : دعاء الله، واستغاثته به، واشتكاءه اليه، لا ينافي الصبر المامور به. وانما ينافيه في ذلك الاشتكاء الي المخلوق. ولقد قال يعقوب عليه السلام: (فصبر جميت ) [يوسف : ] وقال : (انما اشكوابتي وحزن الي الله)ف.
 وقد روي عن طاوس: انه كره انين المريض. وقال: انه شكوي، وقرء ذلك علي احمد بن حنبل في مرض موته، فما ان حتي مات. ويروي عن السري السقطي انه جعل قول المريض : اه! من ذكر الله، وهذا اذا كان بينه وبين الله، وهذا كما يروي عن عمر بن الخطاب رضي الله عنه انه قرا في صلاة الفجر : (انما اشكوا بتي وحرن الي الله) ثم بكي، حتي سمع نشيجه من اخر الصفوف، فالانين والبكاء من خشية الله، والتضرع والشكاية الي الله عز وجل حسن، واما المكروه فيكره، والله اعلم.
 وسءل رحمه الله تعالي: عن رجل مبتلي سكن في دار بين قوم اصحاء، فقال بعضهم : لا يمكننا مجاورتك، ولا ينبغي ان تجاور الاصحاء، فهل يجوز اخراجه?
 فاجاب : نعم لهم ان يمنعوه من السكن بين الاصحاء، فان النبي صلي الله عليه وسلم قال : لالا يورد ممرض علي مصح» فنهي صاحب الابل المراض ان يوردها علي صاحب الابل الصحاح، مع قوله : «لا عدوي ولا طيرة . وكذلك روي انه لما قدم مجذوم ليبايعه، ارسل اليه بالبيعة، ولم ياذن له في دخول المدينة.
 وسءل رحمه الله تعالي : عن الصلاة علي الميت الذي كان لا يصلي، هل لاحد فيها اجر ? ام لا? وهل عليه اثم اذا تركها، مع علمه انه كان لا يصلي? وكذلك الذي يشرب الخمر، وما كان يصلي، هل يجوز لمن كان يعلم حاله ان يصلي عليه ام لا?
 فاجاب : اما من كان مظهرا للاسلام فانه تجري عليه احكام الاسلام الظاهرة: من المناكحة، والموارثة، وتغسيله، والصلاة عليه، ودفنه في مقابر المسلمين، ونحو



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 ذلك؛ لكن من علم منه النفاق والزندقة فانه لا يجوز لمن علم ذلك منه الصلاة عليه. وان كان مظهرا للاسلام فان الله نهي نبيه عن الصلاة علي المنافقين. فقال : (ولا تصل علم احد منبم مات ابدا ولا نقم علي قبره انهم كفروا بالله ورسوله وماتوا وهم فاسقون) وقال : ( سواء عليهم استغفرت لهم ام لم تستغفر لمم لن يغفر الله لهم).
 واما من كان مظهرا للفسق مع ما فيه من الايمان كاهل الكباءر، فهءلاء لا بد ان يصلي عليهم بعض المسلمين . ومن امتنع من الصلاة علي احدهم زجرا لامثاله عن مثل ما فعله، كما امتنع النبي صلي الله عليه ولم عن الصلاة علي قاتل نفسه وعلي الغال، وعلي المدين الذي لا وفاء له، وكما كان كثير من السلف يمتنعون من الصلاة علي اهل البدع  كان عمله بهذه السنة حسنا. وقد قال لجندب بن عبد الله البجلي ابنه: اني لم انم البارحة بشما، فقال : اما انك لو مت لم اصل عليك. كانه يقول: قتلت نفسك بكثرة الاكل. وهذا من جنس هجر المظهرين للكباءر حتي يتوبوا، فاذا كان في ذلك مثل هذه المصلحة الراجحة كان ذلك حسنا، ومن صلي علي احدهم يرجو له رحمة الله، ولم يكن في امتناعه مصلحة راجحة، كان ذلك حسنا، ولو امتنع في الظاهر ودعا له في الباطن ليجمع بين المصلحتين كان تحصيل المصلحتين اولي من تفويت احداهما.
 وكل من لم يعلم منه النفاق وهو مسلم يجوز الاستغفار له، والصلاة عليه، بل يشرع ذلك، ويءمر به. كما قال تعالي : (واستغفر لذنبك ولمءمنين والمءمنت) مد: ] وكل من اظهر الكباءر فانه تسوغ عقوبته بالهجر وغيره، حتي ممن في هجره مصلحة له راجحة فتحصل المصالح الشرعية في ذلك بحسب الامكان، والله اعلم.
 وسءل غفر الله له : عن رجل يصلي وقتا، ويترك الصلاة كثيرا، او لا يصلي، هل يصلي عليه؟،
 فاجاب : مثل هذا ما زال المسلمون يصلون عليه، بل المنافقون الذين يكتمون لنفاق يصلي المسلمون عليهم، ويغسلون، وتجري عليهم احكام الاسلام. كما كان المنافقون علي عهد رسول لله ل صلي الله عليه وسلم
 وان كان من علم نفاق شخص لم يجز له ان يصلي عليه، كما نهي النبي صلي الله عليه وسلم. عن الصلاة علي من علم نفاقه.
 واما من شك في حاله فتجوز الصلاة عليه، اذا كان ظاهر الاسلام. كما صلي ي صلي الله علي ولاي من لم ينه عنه، وكان فيهم من لم يعلم نفاقه .كما قال تعالي: رييبن خولكي مرن الاعرب مبرفقوك ومن اهل المد ية مردوا علي التفاق لا تعلم ه نحن نعلمهم) [التوبة: ومثل هءلاء لا يجوز النهي عنه، ولكن صلاة البي صلي الله عليه وسلم لمءمنين علي المنافق لا تنفعه.



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 كما قال النبي صلي الله عليه وسلم لما البس ابن ابي قميصه  : وما يغني عنه قميصي من الله وقال تعالي : (سواء عليهم استغفرت لهم ام لم تستغفر لهم لن يغفر الله لهم).
 وتارك الصلاة احيانا، وامثاله من المتظاهرين بالفسق، فاهل العلم والدين اذا كان في هجر هذا، وترك الصلاة عليه منفعة للمسلمين بحيث يكون ذلك باعثا لهم علي المحافظة علي الصلاة عليه [هجروه ولم يصلوا عليه]، كما ترك النبي صلي الله عليه وسلم الصلاة علي قاتل نفسه والغال، والمدين الذي لا وفاء له، وهذا شر منهم.
 وقال شيخ الاسلام رحمه الله تعالي.
 قد ثبت عن النبي صل الله عليه وسلمان امتنع عن الصلاة علي من عليه دين حتي يخلف وفاء، قبل ان يتمكن من وفاء الدين عنه، فلما تمكن صار هو يوفيه من عنده، فصار المدين يخلف وفاء.
 هذا مع قوله فيما رواه ابو موسي عنه : ان اعظم الذنوب عند الله ان يلقاه عبد بها، بعد الكباءر التي نهي عنها، ان يموت الرجل وعليه دين لا يدع قضاء رواه احمد . فثبت بهذا ان ترك الدين بعد الكباءر.
 فاذا كان قد ترك الصلاة علي المدين الذي لا قضاء له، فعلي فاعل الكباءر اولي، ويدخل في ذلك قاتل نفسه، والغال : لما لم يصل عليهما، ويستدل بذلك علي انه يجوز لذوي الفضل ترك الصلاة علي ذوي الكباءر الظاهرة، والدعاة الي البدع، وان كانت الصلاة عليهم جاءزة في الجملة.
 فاما قوله : الشهيد يغفر له كل شء الا الدين) فاراد به ان صاحبه يوفاه.
 وسءل غفر الله له : عن رجل له مملوك هرب، ثم رجع. فلما رجع اخذ سكينته وقتل نفسه، فهل ياثم سيده? وهل تجوز عليه الصلاة?()



![image file](./IbnTaymiyya.LaaliNayyirat_.png)

 فاجاب : الحمد لله. لم يكن له ان يقتل نفسه. وان كان سيده قد ظلمه، واعتدي عليه، بل كان عليه اذا لم يمكنه رفع الظلم عن نفسه ان يصبر الي ان يفرج الله.
 فان كان سيده ظلمه حتي فعل ذلك، مثل ان يقتر عليه في النفقة، او يعتدي عليه في الاستعمال، او يضربه بغير حق، او يريد به فاحشة ونحو ذلك. فان علي سيده من الوزر بقدر ما نسب اليه من المعصية.
 ولم يصل النبي صلي الله عليه وسلمعلي من قتل نفسه. فقال لاصحابه: صلوا عليه فيجوز لعموم الناس ان يصلوا عليه. واما اءمة الدين الذين يقتدي بهم. فاذا تركوا الصلاة عليه زجرا لغيره، اقتداء بالنبي صلي الله عليه وسلم فذا حق، والله اعلم.
 وسءل رحمه الله تعالي : عن رجل يدعي المشيخة، فراي ثعبانا، فقام بعض من حضر ليقتله، فمنعه عنه، وامسكه بيده، علي معني الكرامة له، فلدغه الثعبان فمات. فهل تجوز الصلاة عليه؟ ام لا؟()
 فاجاب : الحمد لله رب العالمين. ينبغي لاهل العلم والدين ان يتركوا الصلاة علي هذا، ونحوه، وان كان يصلي عليه عموم الناس كما امتنع النبي صلي الله عليه وسلم من الصلاة علي قاتل نفسه، وعلي الغال من الغنيمة، وقال : صلوا علي صاحبكم.
 وقالوا لسمرة بن جندب: ان ابنك البارحة لم يبت، فقال: بشما? قالوا: نعم ! قال: اما انه لو مات لم اصل عليه. فبين سمرة انه لو مات بشما لم يصل عليه؛ لانه يكون قاتلا لنفسه بكثرة الاكل.
 فهذا الذي منع من قتل الحية، وامسكها بيده حتي قتلته، اولي ان يترك اهل العلم والدين الصلاة عليه، لانه قاتل نفسه، بل لو فعل هذا غيره به لوجب القود عليه .
 وان قيل : انه ظن انها لا تقتل، فهذا شبيه عمله بمنزلة الذي اكل حتي بشم، فانه لم يقصد قتل نفسه، فمن جني جناية لا تقتل غالبا، كان شبه عمد، وامساك الحيات من نوع الجنايات، فانه فعل غير مباح . وهذا لم يقصد بهذا الفعل الا اظهار خارق العادة، ولم يكن معه ما يمنع انخراق العادة.
 كيف وغالب هءلاء كذابون ملبسون خارجون عن امر الله تعالي ونهيه، يخرجون الناس عن طاعة الرحمن الي طاعة الشيطان، ويفسدون عقل الناس ودينهم



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 ودنياهم، فيجعلون العاقل مولها كالمجنون، او متولها بمنزلة الشيطان المفتون، ويخرجون الانسان عن الشريعة التي بعث الله بها رسوله صلي الله عليه وسلم اي بدع مضادة لها، فيفتلون الشعور ويكشفون الرءوس، بدلا عن سنة رسوللها له صلي الله عليه وسلم من ترجيل الشعر، وتغطية الراس ويجتمعون علي المكاء والتصدية، بدلا عن سنة الله ورسوله من الاجتماع علي الصلوات الخمس، وغيرها من العبادات، ويصلون صلاة ناقصة الاركان والواجبات، ويجتمعون علي بدعهم المنكرة علي اتم الحالات، ويصنعون اللاذن، وماء الورد، والزعفران، لامساك الحيات، ودخول النار بانواع من الحيل الطبيعية، والاحوال الشيطانية بدلا عما جعله الله لاولياءه المتقين من الطرق الشرعية والاحوال الرحمانية، ويفسدون من يفسدونه من النساء والصبيان بدلا عما اقر الله به من العفة وغض البصر، وحفظ الفرج، وكف اللسان.
 ومن كان مبتدعا ظاهر البدعة، وجب الانكار عليه ومن الانكار المشروع ان يهجر حتي يتوب، ومن الهجر امتناع اهل الدين من الصلاة عليه لينزجر من يتشبه بطريقته، ويدعو اليه، وقد امر بمثل هذا مالك بن انس، واحمد بن حنبل، وغيرهما من الاءمة، والله اعلم. 
 وسءل غفر الله له : عن رفع الصوت في الجنازة ?
 فاجاب : الحمد لله . لا يستحب رفع الصوت مع الجنازة، لا بقراءة ولا ذكر، ولا غير ذلك . هذا مذهب الاءمة الاربعة، وهو الماثور عن السلف من الصحابة والتابعين، ولا اعلم فيه مخالفا؛ بل قد روي عن النبي صلي الله عليه وسلم،: انه نهي ان يتبع بصوت، او نار» رواه ابو داود. وسمع عبد الله بن عمر رضي الله عنهما رجلا يقول في جنازة : استغفروا لاخيكم. فقال ابن عمر : لا غفر الله بعد. وقال قيس بن عباد  وهو من اكابر التابعين من اصحاب علي بن ابي طالب رضي الله عنه  : كانوا يستحبون خفض الصوت عند الجناءز، وعند الذكر، وعند القتال.
 وقد اتفق اهل العلم بالحديث والاثار ان هذا لم يكن علي عهد القرون الثلاثة المفضلة.
 واما قول الساءل : ان هذا قد صار اجماعا من الناس فليس كذلك، بل ما زال في المسلمين من يكره ذلك، وما زالت جناءز كثيرة تخرج بغير هذا في عدة امصار من امصار المسلمين.



![image file](./IbnTaymiyya.LaaliNayyirat_.png)

 واما كون اهل بلد، او بلدين، او عشر : تعودوا ذلك فليس هذا باجماع؛ بل اهل مدينة النبي صلي الله عليه وسلم لتي نزل فيها القران والسنة، وهي دار الهجرة، والنصرة، والايمان، والعلم، لم يكونوا يفعلون ذلك؛ بل لو اتفقوا في مثل زمن مالك وشيوخه علي شء، ولم ينقلوه عن النبي صلي الله عليه وسلم، او خلفاءه، لم يكن اجماعهم حجة عند جمهور المسلمين، وبعد زمن مالك واصحابه ليس اجماعهم حجة، باتفاق المسلمين فكيف بغيرهم من اهل الامصار.
 واما قول القاءل : ان هذا يشبه بجناءز اليهود والنصاري، فليس كذلك، بل اهل الكتاب عادتهم رفع الاصوات مع الجناءز، وقد شرط عليهم في شروط اهل الذمة ان لا يفعلوا ذلك، ثم انما نهينا عن التشبه بهم فيما ليس هو من طريق سلفنا الاول، واما اذا اتبعنا طريق سلفنا الاول كنا مصيبين، وان شاركنا في بعض ذلك من شاركنا، كما انهم يشاركوننا في الدفن في الارض، وفي غير ذلك.
 وسءل رحمه الله تعالي : عن تلقين الميت في قبره بعد الفراغ من دفنه، هل صح فيه حديث عن النبي صلي الله عليه وسلم: او عن صحابته? وهل اذا لم يكن فيه شء يجوز فعله? ام لا?
 فاجاب : هذا التلقين المذكور قد نقل عن طاءفة من الصحابة: انهم امروا به، كابي امامة الباهلي، وغيره. وروي فيه حديث عن النبي صلي الله عليه وسلم، لكنه مما لا يحكم بصحته؛ ولم يكن كثير من الصحابة يفعل ذلك، فلهذا قال الامام احمد وغيره من العلماء : ان هذا التلقين لا باس به، فرخصوا فيه، ولم يامروا به. واستحبه طاءفة من اصحاب الشافعي، واحمد، وكرهه طاءفة من العلماء من اصحاب مالك، وغيرهم.
 والذي في السنن عن النبي صلي الله عليه وسلم: انه كان يقوم علي قبر الرجل من اصحابه اذا دفن، ويقول : ل سلوا له التثبيت، فانه الان يسال .
 وقد ثبت في الصحيحين ان الني صلي الله عليه وسلم ال : القنوا امواتكم لا اله الا الله. فتلقين المحتضر سنة، مامور بها.
 وقد ثبت ان المقبور يسال، ويمتحن، وانه يءمر بالدعاء له، فلهذا قيل: ان التلقين ينفعه، فان الميت يسمع النداء. كما ثبت في الصحيح عن البيبيي ال ليه سلم ا قال:



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 «انه ليسمع قرع نعالهم» وانه قال : «ما انتم باسمع لما اقول منهم» وانه امرنا بالسلام علي الموتي . فقال : لما من رجل يمر بقبر الرجل كان يعرفه في الدنيا فيسلم عليه الا رد الله روحه حتي يرد عليه السلام والله اعلم.
 وسءل غفر الله له : هل يشرع تلقين الميت الكبير والصغير? او لا?
 فاجاب : واما تلقين الميت فقد ذكره طاءفة من الخراسانيين من اصحاب الشافعي، واستحسنوه ايضا. ذكره المتولي. والرافعي، وغيرهما. واما الشافعي نفسه فلم ينقل عنه فيه شء.
 ومن الصحابة من كان يفعله: كابي امامة الباهلي، وواثلة بن الاسقع وغيرهما من الصحابة.
 ومن اصحاب احمد من استحبه. والتحقيق انه جاءز، وليس بسنة راتبة، والله اعلم.
 وسءل رحمه الله تعالي : عن الختمة التي تعمل علي الميت، والمقرءين بالاجرة . هل قراءتهم تصل الي الميت? وطعام الختمة يصل الي الميت? ام لا? وان كان ولد الميت يداين لاجل الصدقة الي الميسور : تصل الي الميت?
 فاجاب : استءجار الناس ليقراوا، ويهدوه الي الميت، ليس بمشروع، ولا استحبه احد من العلماء، فان القران الذي يصل ما قرء لله. فاذا كان قد استءجر للقراءة لله، والمستاجر لم يتصدق عن الميت، بل استاجر من يقرا عبادة لله عز وجل لم يصل اليه.
 لكن اذا تصدق عن الميت علي من يقرا القران، او غيرهم: ينفعه ذلك باتفاق المسلمين. وكذلك من قرا القران محتسبا، واهداه الي الميت نفعه ذلك، والله اعلم.
 وسءل رحمه الله تعالي: عن جعل المصحف عند القبر، ووقيد قنديل في موضع يكون من غير ان يقرا فيه، مكروه ام لا?
 فاجاب: واما جعل المصحف عند القبور، وايقاد القناديل هناك. فهذا مكروه



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 منهي عنه، ولو كان قد جعل للقراءة فيه هنالك، فكيف اذا لم يقرا فيه، فان النبي صلي الله عليه ولم قال : «لعن الله زوارات القبور، والمتخذين عليها المساجد، والسرج فايقاد السرج من قنديل وغيره علي القبور منهي عنه، مطلقا؛ لانه احد الفعلين اللذين لعن رسول ال صلي الله عليه وسلمن يفعلهما.
 كما قال : للا يخرج الرجلان يضربان الغاءط، كاشفين عن عوراتهما يتحدثان، فان الله يمقت علي ذلك رواه ابو داود وغيره. ومعلوم انه ينهي عن كشف العورة وحده، وعن التحدث وحده، وكذلك قوله تعالي: (والذين لا يدعون مع الله النها ءاخر ولا يقتلون النفس التي حرم الله الا بالحق ولا يزنوب ومن يفعل ذلك يلق اثاما يضدعف له العذاب يوم القيامة ويخلد فيه مهانا)،] فتوعد علي مجموع افعال، وكل فعل منها محرم .
 وذلك لان ترتيب الذم علي المجموع، يقتضي ان كل واحد له تاثير في الذم، ولو كان بعضها مباحا لم يكن له تاثير في الذم. والحرام، لا يتوكد بانضمام المباح المخصص اليه .
 والاءمة قد تنازعوا في القراءة عند القبر، فكرهها ابو حنيفة، ومالك، واحمد في اكثر الروايات، ورخص فيها في الرواية الاخري عنه: هو وطاءفة من اصحاب ابي حنيفة، وغيرهم.
 واما جعل المصاحف عند القبور لمن يقصد قراءة القران هناك، وتلاوته، فبدعة منكرة، لم يفعلها احد من السلف. بل هي تدخل في معني اتخاذ المساجد علي القبور وقد استفاضت السنن عن النبي صلي الله عليه وسلم في النهي عن ذلك، حتي قال : للعن الله اليهود والنصاري، اتخذوا قبور انبياءهم مساجد . يحذر ما صنعوا. قالت عاءشة: ولولا ذلك لابرز قبره؛ ولكن كره ان يتخذ مسجدا. وقال : ان من كان قبلكم كانوا يتخذون القبور مساجد، الا فلا تتخذوا القبور مساجد، فاني انهاكم عن ذلك. ولا نزاع بين السلف والاءمة في النهي عن اتخاذ القبور مساجد.
 ومعلوم ان المساجد بنيت للصلاة والذكر، وقراءة القران، فاذا اتخذ القبر لبعض



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 ذلك كان داخلا في النهي، فاذا كان هذا مع كونهم يقراون فيها، فكيف اذا جعلت المصاحف بحيث لا يقرا فيها?. ولا ينتفع بها لا حي ولا ميت. فان هذا لا نزاع في النهي عنه.
 ولو كان الميت ينتفع بمثل ذلك لفعله السلف، فانهم كانوا اعلم بما يحبه الله ويرضاه، واسرع الي فعل ذلك، وتحريه.
 وسءل رحمه الله تعالي: عن الميت هل يجوز نقله، ام لا? وارواح الموتي هل تجتمع بعضها ببعض، ام لا? وروح الميت هل تنزل في القبر، ام لا? ويعرف الميت من يزوره، ام لا؟
 فاجاب : الحمد لله. لا ينبش الميت من قبره، الا لحاجة. مثل ان يكون المدفن الاول فيه ما يءذي الميت، فينقل الي غيره، كما نقل بعض الصحابة في مثل ذلك .
 واوراح الاحياء اذا قبضت تجتمع بارواح الموتي، ويسال الموتي القادم عليهم عن حال الاحياء فيقول : ما فعل فلان? فيقولون: فلان تزوج. فلان علي حال حسنة. ويقولون: ما فعل فلان? فيقول: الم ياتكم? فيقولون : لا . ذهب به الي امه الهاوية.
 واما ارواح الموتي فتجتمع : الاعلي ينزل الي الادني، والادني لا يصعد الي الاعلي . والروح تشرف علي القبر، وتعاد الي اللحد احيانا. كما قال النبي صلي الله عليه وسلم،: ما من رجل يمر بقبر الرجل كان يعرفه في الدنيا، فيسلم عليه، الا رد الله عليه روحه، حتي يرد عليه السلام»
 والميت قد يعرف من يزوره، ولهذا كانت السنة ان يقال : لالسلام عليكم، اهل دار قوم مءمنين، وانا ان شاء الله بكم لاحقون. ويرحم الله المستقدمين منا ومنكم. والمستاخرين. والله اعلم.
 وسءل رحمه الله تعالي: عن قوله تعالي: (واان ليس للانسان الا ما سع) وقوله صلي الله عليه وسلم: اذا مات ابن ادم انقطع عمله الا من ثلاث صدقة جارية، او علم ينتفع به، او ولد صالح يدعو له » فهل يقتضي ذلك اذا مات لا يصل اليه شء من افعال البر؟(
 فاجاب: الحمد لله رب العالمين. ليس في الاية، ولا في الحديث ان الميت لا ينتفع بدعاء الخلق له، وبما يعمل عنه من البر، بل اءمة الاسلام متفقون علي انتفاع



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 الميت بذلك، وهذا مما يعلم بالاضطرار من دين الاسلام، وقد دل عليه الكتاب والسنة والاجماع، فمن خالف ذلك كان من اهل البدع.
 قال الله تعالي : (الذين يحلون العرش ومن حوله يسبحون بحمد ربهم ويءمنون به ويستغنرون للذين عامنوا ربنا وسعت كلي شء رحمة وعلما فاغفر للذين تابوا واتبعوا سبيلك وقهم عناب الحيم * ربنا وادخلهم جنات عدن التي وعدتهم ومن صلح من ابابهم وازوجهم وذريتهذ انك انب العزيز الحكيم وقهم السييات ومن تق السيات يوميذ فقد رحمته)). فقد اخبر سبحانه ان الملاءكة يدعون للمءمنين بالمغفرة، ووقاية العذاب، ودخول الجنة ودعاء الملاءكة ليس عملا للعبد.
 وقال تعالي : (واستغفر لذنبك وللمءمنين والمءمنات) وقال الخليل عليه السلام : (ربنا اغفر لي ولوالدي وللمءمنين يوم يقوم الحساب)اهيم وقال نوح عليه السلام : (رب اغفر لي ولوالدي ولمن دخل بيت مءمنا وللمءمنين والمءمنت) فقد ذكر استغفار الرسل للمءمنين، امرا بذلك، واخبارا عنهم بذلك.
 ومن السنن المتواترة التي من جحدها كفر: صلاة المسلمين علي الميت، ودعاءهم له في الصلاة. وكذلك شفاعة النبي صلي الله عليه وسلم يوم القيامة، فان السنن فيها متواترة، بل لم ينكر شفاعته لاهل الكباءر الا اهل البدع، بل قد ثبت انه يشفع لاهل الكباءر، وشفاعته دعاءه، وسءاله الله تبارك وتعالي. فهذا وامثاله من القران، والسنن المتواترة . وجاحد مثل ذلك كافر بعد قيام الحجة عليه .
 والاحاديث الصحيحة في هذا الباب كثيرة، مثل ما في الصحاح عن ابن عباس  رضي الله عنهما  ان رجلا قال للني صلي الله عليه وسلم، ان امي توفيت، افينفعها ان اتصدق عنها ? قال : نعم! قال : ان لي مخرفا  اي بستانا  اشهدكم اني تصدقت به عنها.
 وفي الصحيحين عن عاءشة رضي الله عنها : ان رجلا قال ليصلي اله عليه وسلم، ان امي فتلتت نفسها، ولم توصي، واظنها لو تكلمت تصدقت، فهل لها اجر ان تصدقت عنها؟ قال : تعم») .
 وفي صحيح مسلم عن ابي هريرة رضي الله عنه: ان رجلا قال لليبي الل عليه وسلم ان ابي مات ولم يوص، اينفعه ان تصدقت عنه ? قال : نعم
 وعن عبد الله بن عمرو بن العاص: ان العاص بن واءل نذر في الجاهلية ان يذبح



