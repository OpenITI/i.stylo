 ولهذا يتنازع الفقهاء المتاخرون في اللفظ بالنية: هل هو مستحب مع النية التي في القلب? فاستحبه طاءفة من اصحاب ابي حنيفة، والشافعي، واحمد. قالوا لانه اوكد، واتم تحقيقا للنية، ولم يستحبه طاءفة من اصحاب مالك واحمد وغيرهما، وهو المنصوص عن احمد وغيره، بل راوا انه بدعة مكروهة.
 قالوا : لو انه كان مستحبا لفعله رسول الله له صلي الله عليه وسلم و لامر به فاله صلي الله عليه وسلم د بين كل ما يقرب الي الله، لا سيما الصلاة التي لا تءخذ صفتها الا عنه، وقد ثبت عنه في الصحيح انه قال : صلوا كما رايتموني اصلي
 قال هءلاء فزيادة هذا وامثاله في صفة الصلاة بمنزلة ساءر الزيادات المحدثة في العبادات، كمن زاد في العيدين الاذان والاقامة، ومن زاد في السعي صلاة ركعتين علي المروة، وامثال ذلك.
 قالوا : وايضا فان التلفظ بالنية فاسد في العقل؛ فان قول القاءل : انوي ان افعل كذا وكذا، بمنزلة قوله انوي اكل هذا الطعام لاشبع، وانوي البس هذا الثوب لاستتر، وامثال ذلك من النيات الموجودة في القلب التي يستقبح النطق بها، وقد قال الله تعالي : ( اتعلمون الله بدينكم والله يعدم ما في السمكوات وما في الارض) رات. وقالت طاءفة من السلف في قوله : (انا نظعمك لوبه الله) قالوا: لم يقولوا بالسنتهم، وانما علمه الله من قلوبهم، فاخبر به عنهم.
 وبالجملة : فلا بد من النية في القلب بلا نزاع. واما التلفظ بها سرا فهل يكره او يستحب؟ فيه نزاع بين المتاخرين .
 واما الجهر بها فهو مكروه منهي عنه، غير مشروع باتفاق المسلمين، وكذلك تكريرها اشد واشد.
 وسواء في ذلك الامام والماموم والمنفرد، فكل هءلاء لا يشرع لاحد منهم ان يجهر بلفظ النية، ولا يكررها باتفاق المسلمين؛ بل ينهون عن ذلك، بل جهر المنفرد بالقراءة اذا كان فيه اذي لغيره لم يشرع، كما خرج النبي صلي الله عليه وسلم لي اصحابه وهم يصلون فقال : ايها الناس كلكم يناجي ربه، فلا يجهر بعضكم علي بعض بالقراءة »() .
 واما الماموم فالسنة له المخافتة باتفاق المسلمين، لكن اذا جهر احيانا بشء من الذكر فلا باس، كالامام اذا اسمعهم احيانا الاية في صلاة السر، فقد ثبت في الصحيح عن ابي قتادة انه اخبر عن النبي صلي الله عليه وسلما كان في صلاة الظهر والعصر



![image file](./IbnTaymiyya.LaaliNayyirat_.png)
 يسمعهم الاية احيانا» وثبت في الصحيح؛ ان من الصحابة المامومين من جهر بدعاء حين افتاح الصلاة، وعند رفع راسه من الركوع، ولم ينكر النبي صلي الله عليه وسلم لك، ومن اصر علي فعل شء من البدع وتحسينها فانه ينبغي ان يعزر تعزيرا يردعه، وامثاله عن مثل ذلك.
 ومن نسب الي رسول الله له صلي الله عليه وسلم باطل خطا، فانه يعرف، فان لم ينته عوقب، ولا يحل لاحد ان يتكلم في الدين بلا علم ولا يعين من تكلم في الدين بلا علم، او ادخل في الدين ما ليس منه.
 واما قول القاءل: كل يعمل في دينه الذي يشتهي. فهي كلمة عظيمة يجب ان يستتاب منها، والا عوقب؛ بل الاصرار علي مثل هذه الكلمة يوجب القتل؛ فليس لاحد ان يعمل في الدين الا ما شرعه الله ورسوله، دون ما يشتهيه ويهواه، قال الله تعالي : (ومن اغل ممن اتبع هوله بغير هدي مب الله) وقال تعالي : (وان كثيا ليضلون باموابهم بغير علر)] (ولا تتبع الهوي فيضلك عن سبيل الله) وقال: (ولا تتبعوا اهواء قوم قد ضلوا من قبل واضلوا كثيا وصلوا عن سواء السبيل) وقال تعالي : (اريت من اتخذ الاهه هوله افانت تكون عليه وكيلا ام تحسب ان اكثرهم يسمعوب او يعقلوب ان هم الا كالانعام بل هم اضل سبيلا)، وقال تعالي : ( فلا وربك لا يءمثون حتي يحكموك فيما شجر بلنهم ثم لا يجدوا في انفسهم حرجا مما قضيت ويسلموا تسليما).
 وقد روي عه صلي الله عليه وسلم ان قال : والذي نفسي بيده لا يءمن احدكم حتي يكون هواه تبعا لما جءت به قال تعالي : ( الم ترالي الذيب يزعمون انهم عامنوا بما انزل اليك وما انزل من قبلك يريدون ان يتحاكموا الي الطغوت وقد امروا ان يكفروا به ويريد الشيطن ان يضلهم لالا بعيدا * واذا قيل لهم تعالوا الي ما انزل الله والي الرسول رايت المنافقين يصدون عنك صدودا)] وقال تعالي : ( ام لهر شركاوا شرعوا لهم من الدين مالم ياذن به الله) وقال تعالي : (العص* كتب ازل اليك فلا يكن في صدرك حرج منه لننذر به وذكري للمءمنين اتمعواما انزل التكم من ربك ولا تتبعوا من دونه اولياء قليلا ما تذكرون) [الاعيراف:   ] وقال تجالي: (ولو اتبع الحق افواء هم لفسدت السموات والارض ومن فيهب) وامثال هذا في القران كثير.
 فتبين ان علي العبد ان يتبع الحق الذي بعث الله به رسوله، ولا يجعل دينه تبعا لهواه، والله اعلم.



