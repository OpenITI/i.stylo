 فالموجب لتحرير هذا الكتاب هو النصيحة لكم ، والشفقة عليكم ، والمعذرة الي الله في ابلاغكم. فاعلموا وفقنا الله واياكم ان الله سبحانه خلق عباده جنهم وانسهم لعبادته وحده لا شريك له ، كما قال تعالي : ( @QUR@ وما خلقت الجن والانس الا ليعبدون ) [الذاريات : ]. وقال تعالي : ( @QUR@ * واعبدوا الله ولا تشركوا به شيءا ) [النساء : ]. وقال تعالي : ( @QUR@ وقضي ربك الا تعبدوا الا اياه ) [الاسراء : ].
 فعبادته هي توحيده وطاعته ، بامتثال ما امر به علي السنة رسله. فاذا علم الانسان ان الله سبحانه انما خلقه لعبادته ، فحق عليه ان يسال عن معني العبادة التي خلق لها ، حتي يتصف بها علما وعملا. واعظم الفراءض ، واوجب الواجبات توحيد الله تبارك وتعالي ، الذي اتفقت عليه

 دعوة جميع الرسل ، من اولهم الي اخرهم ، كما قال تعالي : ( @QUR@ وما ارسلنا من قبلك من رسول الا نوحي اليه انه لا اله الا انا فاعبدون ) [الانبياء : ].
 والتوحيد اقرار الله تعالي بجميع انواع العبادة ، كالدعاء ، والخوف ، والرجاء ، والرغبة ، والرهبة ، والخشوع ، والخشية ، والالتجاء ، والاستعانة ، والاستعاذة ، والذبح ، والنذر. فكل هذه الانواع ، وما في معناها عبادات لا تصلح الا لله تبارك وتعالي. فمن حرف منها شيءا لغير الله ، فهو مشرك كافر ، كما قال تعالي : ( @QUR@ ومن يدع مع الله الها اخر لا برهان له به فانما حسابه عند ربه انه لا يفلح الكافرون ) [الحج : ]. وقال تعالي : ( @QUR@ فلا تدعوا مع الله احدا ) [الجن : ]. وقال تعالي : ( @QUR@ ومن اضل ممن يدعوا من دون الله من لا يستجيب له الي يوم القيامة وهم عن دعاءهم غافلون ) [الاحقاق : ]. فقول : يا رسول الله ، او : يا بن عباس ، او : يا خديجة ، هو من دعاء غير الله ، وهو من الشرك الاكبر. اذ العبادة خالص حق رب العالمين ، ولا يجوز صرفها الي غيره ، لا ملك مقرب ، ولا نبي مرسل ، فضلا عن غيرهما من الاولياء ، والاشجار ، والاحجار. والنبي صلي الله عليه وسلم حقه علينا هو تعظيمه باتباع امره ، واجتناب ما نهي عنه ، وتعزيزه وتوقيره ، وتقديم محبته علي محبة النفس والاهل والمال ، وان يكون هو كالعبد تابعا لما جاء به صلي الله عليه وسلم . وحق الصالحين الدعاء لهم ، واتباع اثارهم ، لا دعاءهم والتمسح بقبورهم.
 فليحذر الانسان كل الحذر ان يقع في الشرك ، الذي لا يغفره الله ، كما قال تعالي : ( @QUR@ ان الله لا يغفر ان يشرك به ويغفر ما دون ذلك لمن يشاء ) [النساء : ]. وقال عن المسيح عليه السلام : انه من يشرك بالله فقد حرم الله عليه الجنة وماواه النار وما للظالمين من انصار. فمن دعا غير الله ، فهو

 مشرك لو قال : اني اقول ذلك علي سبيل المجاز. ولو سماه ما سماه ، اذ العبرة بالحقاءق والمعاني ، لا بالاسماء.
 ومن الامور المنكرة البناء علي القبور ، والصلاة عندها ، ولو كان المصلي انما يصلي لله ، لقول النبي صلي الله عليه وسلم : «لعنة الله علي اليهود والنصاري ، اتخذوا قبور انبياءهم مساجد». يحذر ما صنعوا. ونهي النبي صلي الله عليه وسلم عن البناء علي القبور وتجصيصها في عدة احاديث ، وكذلك السراج علي القبور. ولعن النبي صلي الله عليه وسلم زاءرات القبور ، والمتخذين عليها المساجد والسرج. فعبادة الله عند القبور بدعة ، وعبادة اصحابها شرك اكبر ينافي التوحيد.
 وكذلك من البدع : سءال الله بجاه المخلوقين. فان هذا لم يشرعه الله ولا رسوله ، ولا ورد بسند صحيح صريح ، لا عن النبي صلي الله عليه وسلم ، ولا عن احد من الخلفاء الراشدين المقتدي بهم. ونحن متبعون لا مبتدعون. وانما المشروع : ان يسال العبد ربه باسماءه وصفاته كما قال تعالي : ( @QUR@ ولله الاسماء الحسني فادعوه بها ) [الاسراء : ].
 ومن اقسام الشرك الاصغر : الحلف بغير الله ، لقول النبي صلي الله عليه وسلم : «من حلف بغير الله ، فقد كفر او اشرك». وذلك كالحلف بالامانة ، والبيت ، وغير ذلك.
 فافهموا ما ذكرنا ومن اشكل عليه شء من ذلك ، فليسال الله ان يهده الصراط المستقيم ، وليراجع تفاسير الكتاب العزيز ، كتفسير ابن جرير ، وابن كثير ، والبغوي ، وغير ذلك من تفاسير اهل السنة. وليراجع كلام المحققين كالاءمة الاربعة ، فمن بعدهم من علماء السنة ، وليراجع

 تصانيف شيخنا محمد بن عبد الوهاب رحمه الله ، فانه ان كان منصفا طالبا للحق ، راي ما يثلج الصدور ، ويزيل الاشكال من الاستدلال بالايات القرانية ، والاحاديث النبوية ، والاثار السلفية ، والحق ضالة المءمن.
 ثم بعد ذلك الاهتمام بشان الصلوات في اوقاتها في الجماعات ، والمحافظة علي شراءطها ، والطمانينة فيها ، وترك مسابقة الامام ، فانها محرمة في الاحاديث. قال بعض الصحابة لما راي رجلا يسابق الامام : لا وحدك صليت ، ولا بامامك اقتضيت والصلاة هي عمود الاسلام ، واخر ما يفقد من الدين ، واكد شراءع الاسلام بعد الشهادتين من حفظها ، فقد حفظ دينه من ضيعها لما سواها اضيع. فاهتموا بشانها ، وتناصحوا فيما بينكم ، ومن رايتم منه خللا او تاخرا ، افعلوه وازجروه فان لم يقبل ، فارفعوا امره الي الولاة فانه ورد : ان المحسن شريك المسء اذا لم ينهه.
 وكذلك الزكاة ، فاهتموا بها ، فانها قرينة الصلاة في الكتاب والسنة ، وهي طهرة للمال وتعاونوا علي البر والتقوي ، وامروا بالمعروف ، وانهوا عن المنكر امتثالا لقوله تعالي : ( @QUR@ ولتكن منكم امة يدعون الي الخير ويامرون بالمعروف وينهون عن المنكر واولءك هم المفلحون ) [ال عمران : ].
 وقال تعالي : ( @QUR@ لعن الذين كفروا من بني اسراءيل علي لسان داود وعيسي ابن مريم ذلك بما عصوا وكانوا يعتدون () كانوا لا يتناهون عن منكر فعلوه لبءس ما كانوا يفعلون ) [الماءدة :  ، ]. وورد : «ان الناس اذا راوا المنكر ، فلم يغيروه اوشك ان يعمهم الله بعقاب من عنده».
 اذا تقرر ذلك ، فاعظم المنكرات : الشرك ووساءله وذراءعه الموصلة

 اليه ، كالبناء علي القبور ، واسراجها ، واتخاذها عيدا ، وتحري الصلاة عندها ، كما استفاض الحديث عن النبي صلي الله عليه وسلم في النهي عن ذلك ، ولعن فاعله.
 وكذلك ارتكاب ما حرمه الله من الزنا ، والسرقة ، وشرب المسكرات علي اختلاف انواعها ، وخيانة الامانة ، واكل اموال الناس بالباطل ، كالمعاملة الربوية ، والغش ، وبخس المكاييل والموازين ، وكذلك شهادة الزور ، واليمين الغموس الذي يقتطع بها مال امرء مسلم بغير حق ، وقذف المحصنات الغافلات المءمنات.
 وبالجملة فاهم ما علي الانسان معرفة ما خلقه الله له ، وما اوجبه عليه ، او العمل بذلك ، واجتناب ما نهاه الله عنه في كتابه ، وعلي لسان رسوله صلي الله عليه وسلم . وانتم جيران بيت الله ، وسكان مهابط وحيه ، فينبغي لكم الاهتمام بتطهيره مما يسخط الله ، كما امر الله بتطهيره وتوعد علي الالحاد فيه ، فقال تعالي : ( @QUR@ ومن يرد فيه بالحاد بظلم نذقه من عذاب اليم ) [الحج : ].
 فنسال الله ان يهدينا واياكم الصراط المستقيم ، وان يجنبنا طريق المغضوب عليهم ولا الضالين. امين وصلي الله وسلم علي سيد المرسلين ، وامام المتقين ، وقاءد الغر المحجلين ، نبينا محمد واله وصحبه اجمعين.

  * وهذا ما كتبه علماء مكة علي هذه الرسالة

  * بسم الله الرحمن الرحيم
 والصلاة والسلام علي من لا نبي بعده.

 فقد اطلعنا نحن الواضعون اسماءنا فيه ادناه علي الرسالة المنسوبة لحضرة الشيخ عبد الرحمن بن داود ، وحضرة الشيخ محمد بن عثمان المشاوي ، فوجدناها مشتملة علي الحق والصواب ، واعتقادنا ان دعاء الاموات ، وطلب الحواءج منهم بقوله : يا فلان اغثني ، او انقذني وانا في حسبتك ، او طلب جلب نفع منهم ، او دفع ضر ، ان هذا شرك وكفر يحل الدم والمال ، وكذلك جميع ما فيها من اخلاص انواع العبادة لله تعالي ، وتحريم البناء علي القبور واسراجها ، وما يتبع جميع ذلك ، هو عين الحق والصواب وصلي الله علي سيدنا محمد وعلي اله وصحبه وسلم.
 تحريرا في اليوم الحادي والعشرين من شهر ربيع الثاني من عامنا هذا عام الثالث والاربعين والثلاث مءة والالف.
 عمر باجنيد ، حسين بن محمد عابد المالكي ، جمال بن محمد الامير المالكي ، عباس بن عبد العزيز المالكي ، درويش بن حسن العجمي الحنفي ، حسين بن عبد الغني الحنفي ، عبد الملك ميرداد ، عباس بن عبد اله عطي ميرداد ، محمد سعيد ابو الخير ميرداد ، المرزوقي ابو حسين ، محمد حبيب الله الشنقيطي ، علي بابصيل ، ابو بكر بابصيل ، سيد علي كتبي ، سليمان غزاوي ، عبد الله حمدوة ، خليفة قسام الماء ، عمر جان ، يحيي امان ، زيني كتبي.
 وصل الي مكة كتاب مءرخ في  ربيع الاخر  من السلطان عبد العزيز بن عبد الرحمن ، هذا نصه :

 من عبد العزيز بن عبد الرحمن ال فيصل السعودي الي اخواننا اهالي مكة المكرمة ، عبد القادر بن علي الشيبي ، ومحمد حبيب الله الشنقيطي ، وحسين بن محمد عابد ، ومحمد بن عبد الله باجنيد ، وجمال بن محمد الامير ، وناءب الحرم سليمان ، وعقيل بن محمد السقاف ، وعباس بن عبد العزيز ، ومحمد عباس بن عبد المعطي ، وابي بكر بابصيل ، وشرف حجي ، ومحمد صالح قطب ، ومحمد سعيد ابو الخير ، وابراهيم عبد الرحمن اغا ، وقاسم اغا ، وكافة العلماء ، وفقنا الله واياهم لما يحبه ويرضاه ، وجعلنا واياهم من عبيده واولياءه امين سلام عليكم ورحمة الله وبركاته.
 اما بعد ، وفقنا الله واياكم الصواب ، لا يخفي عليكم ان الخير كله بحذافيره في طاعة الله ورسوله ، واتباع ما امرت به الشريعة الغراء ، واجتناب ما نهت عنه والشر كله بحذافيره في ضد ذلك. ومعلوم حضراتكم ان هذا امر متعين علي كل مسلم. وايضا ، والله ما اعلم شيءا يرجي به النجاة من غضب رب العزة ، وامرا يستعين به المسلمون علي نواءبهم في امور دينهم ودنياهم الا بطاعة الله ، والسير علي صراطه المستقيم الذي امرنا الله سبحانه وتعالي باتباعه واجتناب ضده ، كما قال سبحانه وتعالي : ( @QUR@ اهدنا الصراط المستقيم () صراط الذين انعمت عليهم غير المغضوب عليهم ولا الضالين ) [الفاتحة :  ، ].
 فالمسلم واجب عليه :
 اولا : ان يعرف ربه حقا ، ويعرف ما خلق له ، كما قال تعالي : ( @QUR@ وما خلقت الجن والانس الا ليعبدون ) [الحجر : ].

 وثانيا : يقتدي بالسلف الصالح ، الذي يفتخر بهم ، ويذب عنهم ، وينفر من كل امر يباعد عنهم ، وان يتاسي باقوالهم وافعالهم. وليس لنا قدوة واسوة الا بهذا النبي الكريم صلوات الله وسلامه عليه وعلي اله واصحابه ومن حذا حذوهم الي يوم الدين ، كما قال تعالي : ( @QUR@ لقد كان لكم في رسول الله اسوة حسنة لمن كان يرجوا الله واليوم الاخر ) [الاحزاب : ].
 فهذا امر متعين علي كل مسلم ، وبالاخص انتم يا اخواننا المجاورين لحرم الله ، لانكم احق لذلك ، لامور كثيرة منها : مجاورتكم لهذا البيت الشريف ، ومنها : اذ من الله عليكم باتباع هذه الشريعة الغراء ، انكم تكونون ركنا لجميع المسلمين في هذا الحرم ، الذي جعله الله مثابة للناس وامنا ، واملي بالله انكم ازود مما اظن ، ويظن به اخوانكم. واننا نعذركم عما فات للمانع القوي ، وهم الاتراك والاشراف الذين شنعوا باسم الوهابية عند اخوانهم المسلمين ، لاجل امضاء لوازمهم ، ولكن كما قال الله سبحانه وتعالي : ( @QUR@ يريدون ان يطفءا نور الله بافواههم ويابي الله الا ان يتم نوره ولو كره الكافرون ) [التوبة : ].
 والان احببت ان اشرح لكم بعض المواد التي ان شاء الله تعالي تريح خاطركم ، واعتقد ان كل مسلم علي الفطرة يسر بذلك.
 اولا : اننا ما سعينا في هذا الامر الا لاجل ان تكون كلمة الله هي العليا ، ودينه هو الظاهر ، وان يصير مرجعنا واخواننا المسلمين عموما الي كتاب الله وسنة رسوله ، خصوصا في هذه البقعة المباركة التي هي مهبط الوحي.
 وثانيا : دفاعا عن الظلم والجور الذي فعل لجميع المسلمين

 المجاورين لحرم الله ، والوافدين لاداء فراءضهم التي اوجبها الله عليهم.
 وثالثا : دفاعا عن انفسنا واوطاننا عما فعله هذا الرجل المغرور واعوانه.
 والحمد لله الذي اقر اعيننا ، واعين المسلمين لجمع كلمة المسلمين ، وبقمع الملحدين المعاندين ، فلهذا السبب الواجب ان اعرفكم ان تتقوا ان شاء الله تعالي بالله ، وانني ابذل جهدي وجدي فيما يامن الله به بيته الحرام ، ويريح جميع الوافدين اليه ، وان يكون الامر شوري بين المسلمين علي ما شرع الله ورسوله ، وان لا يستبد فيه ان شاء الله تعالي بشء من المظالم والزخارف ، التي تنهي الشريعة ، وتجحف بحقوق المسلمين.
 فانا احببت ان اقدم لكم ما عندي مع هذه النسخ التي هي عقيدة اخوانكم النجديين ، لتنظروا فيها بعين البصيرة ، وهي مجموعة الحديث والهدية السنية. فما وجدتم مطابقا لما في كتاب الله وسنة رسوله صلي الله عليه وسلم ، فاقروه. وارجو انه صالحنا نحن واياكم وان وجدتم مخالفا لكلامنا من كتاب الله وسنة رسوله ، فنبهونا عليه ، ونحن ان شاء الله تعالي اقرب عن كل احد الي الرجوع الي الحق ، اذا قام الدليل عليه من كتاب الله ، وسنة رسوله ، وكلام العلماء من سلف هذه الامة واءمتها. ونتبرا الي الله من اتباع الهوي والغي ، وان نعمل عملا مخالفا لكتاب الله ورسوله ، وتعجيل هذا الجواب من تلك النسخ المذكورة رجاء ان شاء الله ان تطمءن به نفوسكم ، وتعلموا ان شاء الله تعالي ان ما عندنا الا الصدق والاخلاص.

 نرجوا ان الله يلهمنا واياكم الصواب ، وان يعيذنا واياكم من شرور انفسنا ، وسيءات اعمالنا ، وصلي الله علي سيدنا محمد وعلي اله وصحبه وسلم.
  ربيع الاخر سنة  ه
 وكتب جواب هذا الكتاب الشيخ عبد القادر الشيبي في  ربيع الثاني من مكة ، وهذا نصه :

  * بسم الله الرحمن الرحيم
 الحمد لله وحده ، والصلاة والسلام علي من لا نبي بعده ان اشرف ما يهدي من البيت والحرم ، واحسن ما يسدي من الحطيم والملتزم سلام الله الاتم ، ورضوانه الاعم ، نخص بذلك قدوة السلاطين العظام ، وعمدة الملك ذوي الاحترام ، من من الله عليه بخدمة البيت والحرم ، وجعله قدوة ورحمة لجيران بيت الله المحترم ، جناب المقام العالي ، الامام عبد العزيز بن عبد الحمن ال فيصل ال سعود ، ادام مجده الملك المتعال ، ووفقه لما يحبه ويرضاه من صالح الاعمال. امين.
 وبعد : فانا رافعون اكف الابتهال الي الله ذي الجلال ان يمن علينا بسرعة قدومكم الي البلدة المشرفة ، فان الشدة زادت لتعدي المغتصبين بجدة ، ومنع الارزاق من جيران بيت الله ، ولذا تجاسرنا ورفعنا الي الهند تلغرافا من اليمن ، من ثغر الليث ، الذي هو الان من اعمالكم ، وهذه صورته في طي هذا. ومثله الي الجامعة الاسلامية بمصر ، هذا ونامل من جانب الامام مساعدتنا بما تقتضيه الانظار الملوكية ، لا زالت بعناية الله محمية.

 وقد اسرنا التفاهم بجوابكم ، المتضمن رضاكم عن جيران بيت الله الحرام. وقد ظهر لنا من نواياكم الطيبة ما هديتموه الينا من الهدية السنية ، والمجموعة العلمية الحديثية ، فشكرنا هذا الاعتناء ، ولم نزل نهتم بالمطالعة فيما احتويتا عليه من التوحيد ، الذي هو الاصل في سعادة الدارين.
 لا زالت ايام دولتكم طوال ، محفوفة بالصحة والعد والاقبال ، ودمتم فوق ما رقم ، والسلام في المبدا والختام  ربيع الثاني سنة  ه.

عن عموم جيران بيت الله الحرام عبد القادر الشيبي

  * صورة تلغراف التي ارسلت باتفاق اعيان مكة الي مصر وهند

  * الي الهند بمبي ... الي مصر القاهرة
 جميعة الخلافة الاسلامية ، بناء علي ان كلمة التوحيد هي الجامعة بيننا ، نستصرخ ، بالله ، ثم بكم في ازالة ما حل بنا من منع الارزاق من جدة الي جيران بيت الله الحرام ، حتي فقدنا القوت والنقود اسرعوا اثابكم الله تعالي.

عن عموم جيران بيت الله الحرام عبد القادر الشيبي
 ووصل كتاب الي مكة من السلطان عبد العزيز ، المءرخ  ربيع ثاني سنة  ه ، هذا نصه :

 من عبد العزيز بن عبد الرحمن ال فيصل ال سعود الي حضرة الاخ الشيخ عبد القادر الشيبي ، سلمه الله امين.
 السلام عليكم ورحمة الله وبركاته.
 وبعد ، فقد اخذ بيد السرور كتابكم المملوء حكمة الفاءض اخلاصا ، فاشكركم علي بعد نظركم وحميتكم نسال الله تعالي ان يوفقنا الي خدمة البيت الشريف واهله الخدمة الجديرة به ، واننا قريبا نصل الي بلدكم المباركة ، ونقوم بما يجب علينا من الواجب ، ولقد عمدنا الي طرفكم حضرة الشيخ حافظ وهبة ، والدكتور عبد الله بيك الدملوجي ، لابلاغكم غايتنا ، واخباركم بقدومنا ، والوقوف علي رغاءبكم وامانيكم ، وفقنا الله واياكم لما يحبه ويرضاه ، ودمتم محفوظين.

في  ربيع الثاني سنة  ه عبد العزيز بن عبد الرحمن ال فيصل

  * خطبة السلطان في الرياض قبل سفره الي مكة
 وفي العشرة الاولي من ربيع الثاني سنة  ه تاهب السلطان عبد العزيز السفر الي الحجاز ، وقد حضر في ذلك الحين رءساء القباءل والاعيان ليودعوه ، فخطب فيهم قاءلا : اني مسافر الي مكة ، لا للتسلط عليها ، بل لرفع المظالم التي ارهقت كاهل العباد اني مسافر الي مكة مهبط الوحي ، لبسط احكام الشريعة وتاييدها ، ان مكة للمسلمين كافة ، وسنجتمع هناك بوفود العالم الاسلامي ، فنتبادل واياهم الراي في الوساءل التي تجعل بيت الله بعيدا عن

 الشهوات السياسية. وسيكون الحجاز مفتوحا لكل من يريد عمل الخير من الافراد والجماعات.
 كتاب السلطان عبد العزيز الي الامام يحيي وغيره من امراء الاسلام المستقلين.
 ارسل السلطان عبد العزيز الي الامام يحيي وغيره من امراء الاسلام المستقلين الكتاب الاتي : اما بعد ، فقد استقبلت الطريق الي مكة غير باغ ولا اثم ، فليتفضل الاخ العظيم بارسال من يمثله في مءتمر مكة حبا بنشر السلام بين امم الاسلام.
 سلطان نجد عبد العزيز
 وفي اول شهر جمادي الاولي سنة  ه وصل الشيخ حافظ وهبة ، والدكتور عبد الله الدملوجي مكة المشرفة محرمين بالعمرة ، وبعد ما اديا مناسكها ، نزلا في دار الحكومة الحميدية. وبعد صلاة المغرب ، اجتمعا بالشيخ عبد القادر الشيبي ، فاتح بيت الله الحرام ، في داره بالصفا ، وكان حاجزا هناك جملة من العلماء والاماثل واخبرا الحاضرين بمقاصد الامام ابن سعود في هذه النهضة. قالا : ان عندنا بعض امور نريد ان نقراها علي العموم من اهالي مكة ومجاوريها في الساعة الثالثة صباحا ، فامر الشيبي بتبليغ ذلك للعلماء ، والسادات ، والاشراف والاءمة والخطباء ، وخدمة الحرم ، والمطوفين ، وغيرهم من اهل الحرف والصناءع فاجتمعوا زهاء خمسماءة او اكثر في دار الحكومة المذكورة ، في الساعة المذكورة ، وكان ذلك اليوم يوم الاثنين. وازدحمت الاماكن ، وانتظروا

 حتي كانت الساعة الرابعة والنصف حضر المذكوران : حافظ وهبة ، والدكتور عبد الله الدملوجي ، فرحبوا غاية الترحيب. وبعد لحظة قام الشيخ حافظ وهبة وافتتح مقاله ، وقال : السلام عليكم ورحمة الله وبركاته ، نعلمكم ايها الاخوان اننا وفدنا من عند الامام ابن سعود ، تركناه من مدة عشرة ايام ، وسيطل ان شاء الله عن قريب طرفكم ، وهو يبلغكم جزيل تحياته ، ويقول : انه يتاسف كثيرا مما حصل من جيشه الذي تقدم الي الطاءف ، وانه يرجوكم السماح في ذلك ، ونحن من هذا اليوم علي حد سواء ، الا فيما يخالف كتاب الله وسنة رسوله.
 وان الامام لم يقصد بهذا القيام سلطة علي بلادكم ، وانما قصد اخراج الشريف الحسين واولاده من ارض الحجاز ، ونفيهم بحيث لا يكون تسلط في هذه البلاد المقدسة ، والحمد لله علي ذلك ، فان جيشه المنصور ، دخل هذه البلدة ، ولم يحصل منهم ادني خلاف علي الاهالي والمجاورين ، الا علي من كان في خدمة الشريف الحسين ، او كان مواليه وموافقا علي ظلمه واعتداءه علي حجاج بيت الله الحرام ، والاهالي ، والمجاورين.
 الان الامام سيجمع لديه من لدن العالم الاسلامي بحوله تعالي وفود من جميع الجهات ، وسيكون لكم في ذلك شان وكلمة ، لاجل انتخاب من يقوم بشءون هذه البلاد المقدسة. ويكون ذلك كجمهورية ، لا دخل لاحد من الاشخاص ، خاصة في امور البلاد. بل تكون بحرية خالصة لجماعة المسلمين ، لا تءخذ منهم جباية علي اشخاصهم ، ولا علي

 جمالهم ، ولا شيءا من الامور الذي كان يفعلها الشريف حسين ، كما هو معلوم لديكم. وسترون ان شاء الله ما يسركم ، وجميع المسلمين في خصوص هذه البلدتين المحترمتين ، وان لا يكون ذلك الانتخاب لاحد من اولاده مطلقا ، بل من اي عاءلة تكون ، ويرضي به عموم المسلمين ، ويكون تعيينه لمدة سنة واحدة لا غير ، فان استقام ، فيكون انتخاب جديد اخر له ، فيبقي هكذا ، ونسال الله سبحانه وتعالي ان يوفقنا جميعا لصالح الاعمال امين.
 وانقضي المجلس علي ذلك ، وتفرق ذلك الجمع كل في شانه. انتهي.
 نقل الكتاب الذي ارسل السلطان عبد العزيز الي الامير خالد بن منصور من الشعري ، وهذا نصه :

  * بسم الله الرحمن الرحيم
 من عبد العزيز بن عبد الرحمن الفيصل الي جناب الاخ المكرم الافخم خالد بن منصور سلمه الله وابقاه. امين.
 السلام عليكم ورحمة الله وبركاته علي الدوام بعد ذلك ، نعرفكم بان حنا حالا مثورين من الشعري ، متوجهين اليكم نسال الله التسهيل والذي اخرنا هذه الايام موجبه منتظر ثوار الاخوان اهل دخنة والشبيكة وهجرها القصيم ، كذلك ثوار الاخوان اهل دخنة واهل نضر وغزو القصيم ، فهم معنا. واهل الدخنة والشبيكة وهجرها القصيم ، فهم تواروا كلهم ، مواعيدهم علي العشير وحنا قدمناها لحظ قدامنا والاحنا علي اثره الاخبار من الراس عجل ان شاء الله تعالي.

 نرجوا الله ان ينصر دينه ، ويعلي كلمته ، ويوفقنا واياكم لما به الخير. هذا ما لزم تعريفه ، مع ابلاغ السلام الي المشايخ والاخوان ، ومن عندنا العيال يسلموا عليكم.
  ربيع الاخر سنة  ه

  * وصول عظمة السلطان عبد العزيز الي ام القري
 وفي ليلة الجمعة ثامن من جمادي الاولي سنة  وصل السلطان عبد العزيز بن عبد الرحمن ال فيصل بجيوشه الي مكة ، وخيم في الابطح.
 وفي الساعة الثالثة من ليله طاف وسعي ، وفي تلك الليلة اسرجت الكهرباء في الحرم الشريف من المغرب.
 بعد ما ترك تسريجها مدة عشرة ايام ، بسبب غلاء القاز. وكذلك اسرجت الاتاريك ايضا بعد العشاء. ولما وصل السلطان الي باب السلام ، مشت المشدية والاغادات بالبخور والاتاريك قدامه ، فطاف واغوات الحرم قدامه ، حاملين الاتاريك ، ثم بعد فراغه من الطواف ، خرج للسعي من باب الصفا ، فسعي ماشيا علي قدميه. وبعد فراغه من السعي ، طلع في بيت باناجة ، حيث كان الناس بانتظاره فيه فجلس هناك حصة ، وحل احرامه ، ثم سار الي المخيم. 
 وفي صباح يوم الجمعة ، خرج اعيان مكة من الاشراف ، والعلماء ، والتجار ، والمطوفين ، وغيرهم في الابطح للقاء السلطان عبد العزيز ، فجلسوا ينتظرون في السرادقات المنصوبة هناك خروج الامام ، ولما سار الموكب السلطاني من مقره استعرض قسم الخيالة من جنده ، فكنت تراهم يعدون ، وكل واحد يصيح : انا خيال التوحيد ، اخو من طاع الله ويضرب

 برصاصة في الفضاء. ولما انتهت الخيالة ، تقدم الركب قليلا حتي صار علي بعد بضعة امتار من السرادق المنصوب ، اناخ الامام راحلته وترجل ، فاحاط به الاخوان من كل جانب ، واقبلوا عليه يهنءونه بالسلامة ، ويصافحونه ، ويقبلون جبهته ، وازدحموا عليه ازدحاما كثيرا ، ولم يستطع الامام ان يقطع خمسة عشر مترا الي السرادق باقل من نصف ساعة.
 ولما دخل السرادق ، اذن لوفود الاهلين بالدخول عليه ، فقدموا في مقدمتهم الشيخ عبد القادر الشيبي امين مفتاح بيت الله الحرام فتقدم ، وحمد الله الي الامام وصوله بالسلامة ، ثم قدم له الناس. يعرف بهم الشيخ بني شيبة واحدا واحدا ، وكلهم يصافح بيده ، ولم يشا ان يقبلوا يده ، قال : ان المصافحة من عادات العرب ، ومن فعل الصحابة مع الرسول صلي الله عليه وسلم ، ومع بعضهم بعضا ، وعادات تقبيل اليد جاءتنا من الاعاجم.
 ثم تكلم عظمة السلطان عن غايته من حركته الاخيرة في الحجاز ، ولخص القول عن حقيقة معتقد الوهابيين. ثم انتقل القول عن بعض حوادث الطاءف ، فاظهر اسفه الشديد لما وقع ، وقال : ان جنده اتخذ جميع الاسباب لمنع وقوع الحرب داخل مدينة الطاءف ، ولكن الشريف عليا لم يشا الا ان يحارب في داخل المدينة ، فحصل ما حصل ، مما اسف له اشد الاسف. وقد واسي قلوب بعد الموتورين من تلك الحادثة. وبعد ان اتم الامام اقواله هذه ، طلب شيخ بني شيبة ان يجتمع بعلماء البلد الحرام في وقت متسع ، فيحدثهم بالحديث الذي ذكر في السرادق ، فضرب له الامام الموعد في الساعة الثامنة من الغد السبت ، وانصرف القوم مسرورين فرحين مستبشرين.
 وما ازفت الساعة المعينة حتي غص بهو الحميدية بعلماء البلد الحرم

 من اهله ، ومن المجاورين فيه. ولما اخذ القوم مجالسهم ، نهض الاستاذ الشيخ حافظ وهبة ، فتكلم بما خلاصته : نكرر عليكم في هذا الموقف ما كنا ذكرناه لكم من قبل في اجتماع سابق ، وهو ان عظمة السلطان عبد العزيز بن سعود يري ان هذه البقعة المباركة من اقدس بلاد الله ، وان قلوب مثات الملايين من المسلمين تهفوا اليها ، ويحجونها. فاذا كانت هذه البلاد التي هي مسطح النور ، ومهبط الوحي ، ومنشا الهدي للناس اجمعين ، يرجع الامر فيها كما بدء به اول مرة ، وتتطهر من البدع والضلالات ، يزداد مقامها في لقوب المسلمين اضعافا مضاعفة. وعلي العكس ، اذا بدلت معالم الدين. انكم تعلمون ان اكثر البلاد الاسلامية قد كثرت فيها البدع ، والسبب في ذلك ان اكثر الامارات الاسلامية ظهرت فيها بدعة عمت ، وهي ما يسمونه بطلب الترقي المدني.
 اما نحن ، فلا نريد الارتقاء الذي يدعون اليه. وانما ندعو ، ونريد الارتقاء الديني. ونعتقد انه لا يمكن ارجاع الرقي للمسلمين الا برجوعهم للسير علي السنن الذي سنها لهم الله من قبل في كتابه ، وعلي لسان نبيه.
 وهذا هو الذي يريده عبد العزيز بن السعود اصوات : وفقه الله وهذا هو الاول.
 الامر الثاني : هو ان عبد العزيز يريد ان يرجع لهذه البلاد عهد الشوري الذي نشا فيها ، وهو لا يريد ان يستبدكم ، ولا ان يجري في بلادكم الا ما يوافق شرع الله اصوات جزاه الله خيرا انه يريد ان يستفيد من تجارب المجرمين. وبابه مفتوح لسماع نصيحة كل ناصح.
 واكره الاخلاق عنده التملق ، وكل من اراد التقرب اليه بالتملق ، فلا يعكس الامر الا علي نفسه اصوات : هذا هو المطلوب .

 الامر الثالث : هو ان عبد العزيز ، وكما ستسمعون منه لا يريد هذا البيت ملكا لاحد ، بل مشاعا بين المسلمين ، ولكل شعب من الشعوب الاسلامية ، ولكل فرد من افراد العالم الاسلامي حق فيه.
 والامر الرابع : وهو ان التجارب السابقة دلت علي ان الحسين واله غير صالحين لادارة هذه الامور ، لذلك سنضحي نفوسنا واموالنا في تطهير البلاد المقدسة.
 ثم تكلم الشيخ حبيب الله الشنقيطي ، فقال : قال الله تعالي في كتاب الله العزيز : ( @QUR@ ولينصرن الله من ينصره ) [الحج : ] ، وما دامت غاية السلطان عبد العزيز نصرة الاسلام ، فالله ينصره.

  * خطاب عظمة السلطان
 وبعد ذلك اقبل عظمة السلطان علي الناس ، فقال ما ملخصه بما يلي :

  * اداب القران
 ان الامور كلها بيد الله ، وان الله قد ضرب الامثال في القران ، ولم يترك شيءا يءدي لتاديبنا الا ذكره في كتابه. ولقد كان رسول الله صلي الله عليه وسلم الذي من احبه ، فقد احب الله. ومن اطاعه ، فقد اطاع الله ، ياخذ نفسه باداب القران الذي انزل به امين السماء جبريل علي امين الارض محمد صلي الله عليه وسلم . ولا اظن رجلا عنده ذرة من عقل ، وعرف ما جاء في الكتاب الكريم من الاداب العالية ، الا قدر هذه الاداب حق قدرها ، وراي ان الخير كله في اتباع هذا الهدي الحكيم. ومع ذلك ، فلا حول ولا قوة الا بالله. فقد اعطي الله الناس امورا ، وسلط عليهم احوالا ، فكل يعمل لما هو موفق

 له ، ليتميز الخبيث من الطيب : ( @QUR@ ليبلوكم ايكم احسن عملا ) [هود : ].
 قال تعالي : ( @QUR@ لءن شكرتم لازيدنكم ) [ابراهيم : ].
 وتتفاوت درجات الناس بمقدار كبحهم لجماح اهواءهم. وما جاءت الرسل الا ليبينوا للناس طريق الهدي ، حتي يسيروا فيها. ويحذروهم من الطرق الشيطانية ، فيبتعدوا عنها. وانتم تعلمون ان رسولنا ونبينا محمدا عليه الصلاة والسلام ما جاء الا ليدلنا علي طرق الخير ، ويبين لنا السبيل الاقوم. جاء الرسول عليه الصلاة والسلام بهديه ، فتقبله الناس ، وعملوا به. ولكنكم تعلمون ان الزمان طويل ، وان الاهواء قد لعبت. ولو لا ان الله قد حفظ كتابه ، لما وجدنا من هدي الرسول الذي جاءنا به شيءا. ولكن الرسول قال : «لا تزال طاءفة من امتي علي الحق ، لا يضرهم من خذلهم ، حتي ياتي امر الله وهم علي ذلك».

  * الشرف بالعمل الصالح
 ان افضل البقاع هي البقاع التي يقام فيها شرع الله ، وافضل الناس من اتبع امر الله ، وعمل به. وهذا ثابت محقق. فهل تعلمون قبيلة من العرب خير من قريش؟ ولو لم يكونوا افضل العرب ، لما بعث الرسول منهم. وهل في البلاد افضل من مكة؟ ولو لم تكن كذلك ، لما كان بيت الله فيها ، ولما نشا الاسلام والرسول فيها. او ليس كذلك؟ او لم يقاتل الرسول عليه السلام قريشا ، وهم اهله وذوو قرباه؟ او لم يهاجر الي المدينة؟ او لم يقاتل من كان بمكة؟ نعم كان هذا ، وذلك ان قريشا عصوا الله واعرضوا عن الحق. او لم يشرف بلال الحبشي ، وسلمان الفارسي بالاسلام؟ والاول عبد حبشي ، والاخر رجل فارسي. او لم يذل ابو جهل ،

 وابو لهب بالكفر ، وهما عما رسول الله صلي الله عليه وسلم ؟ فالشرف ليس بالحب ، ولا النسب ، وانما هو بالعمل الصالح. نعم ان هذا البيت هو شرف الاسلام الخالد. وما عمل فيه من الاعمال الحميدة ، يضاعف الله اجرها. وما عمل فيه من السيءات ، يضاعف الله وزرها.
 ونتمني لجميع من في هذا البيت وجواره من اهله ، او ممن جاوره ان يهدي الله قلبه للايمان ، والعمل الصالح. فان هءلاء المجاورين اذا صلحوا وعلموا الحقاءق ، استفادوا وافادوا المسلمين عامة.
 ان لهذا البيت شرفه ومقامه منذ رفع سمكه بيد سيدنا ابراهيم عليه السلام . وقد عظم العرب امره في جاهليتهم ، فتحالفوا وتعاقدوا ان لا يقر ببطن مكة ظالم ، صيانة لهذا البيت ان يقع الظلم فيه. واولءك كانوا علي الشرك والضلالة ، فهل يليق بنا ونحن المسلمون ان نقر فيه ظلما؟
 او نتعدي فيه حدود الله؟

  * دين الله وحدة
 ان العقاءد التي جاء الانبياء بها من قبل ذات اصل واحد ، وهي اخلاص العبادة لله وحده. وينحصر ذلك في قول : لا اله الا الله. فلفظ الا الله ، معناه : اثبات العبادة لله وحده. فكل عمل صالح اذا لم يكن مبنيا علي هذا الاساس ، فهو باطل. قال تعالي : ( @QUR@ فمن كان يرجوا لقاء ربه فليعمل عملا صالحا ولا يشرك بعبادة ربه احدا ) [الكهف : ]. فدلت هذه الاية الكريمة علي ان النجاة لا يكفي بها العمل الصالح وحده ، بل لا بد فيها من اخلاص العبادة والدعاء لله وحده من جميع المخلوقات.

  * ما كان يتمناه للحسين
 ووالله ، وبالله ، وتالله ، ورب هذا البيت ، والمقدر كاءن ، لقد كان من احب الامور عندي ان الحسين بن علي في هذا البيت المبارك يقيم شرع الله ، ولا يعمل لابادتنا من الوجود. وانني قد افد عليه من الوافدين احب اقبل علي يده ، واساعده في جميع الامور علي كل شء يريده ، ولكن هكذا شاءت ارادة الله. ولو لم يلحق الامر الاديان والنفوس ، لما اقدمنا عليه. فقد قرر الحسين تقسيم بلادنا وتوزيعها ، واصر عليه ، واخذ يعمل له. وهذه جريدة القبلة عندكم تعرفكم عن نواياه بنا. فاذا كان الحسين اتي بهذه الديار مءمرا من قبل الترك ، واقام فيها ، ثم خلع طاعتهم ، فنحن في ديارنا ، لم يءمرنا غير سيوفنا ، واتباع ما امر الله به. ان هذا المحل ليس بالذي يبحث فيه بالسياسة ، ولكن اذكركم بما كان يسعي له الحسين ، حتي اضطرنا لان نقوم بما قمنا به نحوه من الاعمال.

  * ما يطلبه ويرجوه
 وصلنا لهذا الحد والحمد لله ولا ينفعنا غير الاخلاص في كل شء ، اخلاص العبادة لله وحده ، والاخلاص في الاعمال كلها. وليس عندنا مما يتعلق بحقيقة معتقدنا غير ما رايتموه في الهداية السنية ، وقد بعثت لكم بنسختين منها. والذي ابتغيه في هذه الديار ، هو ان يعمل بما في كتاب الله وسنة نبيه في الامور الاصلية. اما في الامور الفرعية الاخري ، فاختلاف الاءمة فيها رحمة ، والكلام في هذا طويل.
 والان انا بذمتكم ، وانتم بذمتي ، والدين النصيحة ، وانا منكم ، وانتم مني. والكلام غير الصحيح لا يليق في هذا المقام ، وهذه عقيدتنا

 في الكتب التي بين ايديكم. فان كان فيها خطا يخالف كتاب الله ، فردونا عنه. وما اشكل عليكم منها ، فاسالونا عنه. والحكم بيننا وبينكم كتاب الله ، وما جاء في كتب الحديث الستة : (فان تنازعتم في شء فردوه الي الله والرسول ان كنتم تءمنون بالله واليوم الاخر ذلك خير واحسن تاويلا) اننا نطع ابن عبد الوهاب ولا غير ، الا مما ايدوه بقول من كتاب الله ، وسنة نبيه محمد صلي الله عليه وسلم . اما احكامنا ، فنشير فيها طبق ما اجتهد فيها الامام احمد بن الحنبل.

  * دحض الاكاذيب
 لقد اشاع الترك الشء الكثير عن عقاءدنا ، وشنعوا عليها من قبل.
 وكذلك فعل من جاء بعدهم. وبلغني انهم قالوا في جملة ما كذبوه عنها : اننا لا نصلي علي محمد ، واننا نعد الصلاة عليه شركا بالله نعوذ بالله من ذلك ، وليست الصلاة علي محمد صلي الله عليه وسلم ركنا من اركان الصلاة ، وانها لا تتم بغيرها. ويقولون : اننا ننكر شفاعة محمد صلي الله عليه وسلم يوم القيامة معاذ الله ان نقول هذا ، وانما نطلب من الله ان يشفع فينا نبينا محمدا صلي الله عليه وسلم ، نقول : الله شفع فينا نبينا محمدا صلي الله عليه وسلم ، ( @QUR@ من ذا الذي يشفع عنده الا باذنه ) [البقرة : ]. وندعوا الله ان يشفع فينا الولد الصغير ، ونقول : اللهم اجعله فرطا لابويه ، ولا نطلب الشفاعة من الطفل. واما محبة الاولياء والصالحين ، فمن ذا الذي يبغضهم منا. ولكن محبتهم الحقيقية هي العمل بما عملوا به ، واتباع سنتهم في التقوي ، ومنهم اولءك الاولياء هم الذين قال الله فيهم : ( @QUR@ الذين ان مكناهم في الارض اقاموا الصلاة واتوا الزكاة وامروا بالمعروف ونهوا عن المنكر ) [الحج : ]. فهءلاء هم الذين نحبهم

 ونقتفي اثارهم ، ولكننا لا نرفعهم فوق المرتبة التي يريدونها لانفسهم ، ولا يريدها لهم الله.
 هذا الذي نحن عليه ، وهذا الذي ندين الله به. فان كان عندكم ما ينقضه في كتاب الله ، او سنة ، فاتونا به لنرجع عنه.

  * تعالوا لكتاب الله
 فان كان هذا مقبولا عندكم ، فتعالوا نتابع علي العمل بكتاب الله وسنة رسوله ، وسنة الخلفاء الراشدين من بعده فتعالت الاصوات : كلنا نتابع ، كلنا نتابع . قال الامام : قولوا لنا بصريح القول ما عندكم ما عندنا غير هذا ، ثم قال : اعندكم بالله من التقية ، فلا تكتموا علينا شيءا.
 وكانت قد دنت ساعة العصر ، فاذن الامام الشيخ عبد الله بن حسن بوقت الصلاة ، وطلب تاجيل البحث لاجتماع اخر. فقال الشيخ حبيب الله الشنقيطي : اذا اردنا المناظرة في بعض المساءل مع علماء نجد ، فيقتضي ان يعرف كل واحد طبيعة الاخر ، حتي اذا اقيمت عليه الحجة يذعن لها ، ولا زعل. فقال الامام : ما دام المرجع كتاب الله ، فلا نزعل في شء.
 ثم انفض الاجتماع علي ان يجتمع نخبة من علماء نجد مع نخبة من علماء مكة للتفاهم والتعارف. ولما اراد الامام السير للحرم ، قال له الشنقيطي : ان امور البدع في الدين كنا نحذر الناس عنها في دروسنا ، ولكن الامر ليس بيدنا لنزجرهم عنها. فقال له الامام : اننا خدام طلبة العلم ، وكل ما افتونا به انفذناه علي وجهه ، فهم المسءولون المبينون ونحن المنفذون. بذلك انفرط عقد الاجتماع ، وذهب الناس الي صلاتهم.

  * ذكر بعض من وفدوا علي السلطان

  * في مخيمه من رءساء القباءل
 وفد علي عظمة السلطان في مخيمه ابن مبيريك صاحب رابغ ووفد من حرب المقيمين بين رابغ وجدة وفي قادتهم ابن حمادي ، وابن جاسم ، وسلمان النتاق ، والمصباحي ، وعطية بن عبد العزيز ، وصالح بن عجيب ، وحفيظ بن حتيرش ، وعبد الله بن محمد ، والشريف عبد الله بن عبيد ، ومبرك بن مبارك بن سليم. وقدموا طاعتهم لعظمته ، وعاهدوه علي السمع والطاعة ، ومولاة من ولاه ، ومعاداة من عاداه ، وان يحموا الطريق بين جدة ورابغ. واقسموا الايمان علي ذلك ، ثم ساروا الي ديارهم ، بعد ما امنهم السلطان علي ما عندهم.

  * ذكر من كانوا في معية عظمة السلطان

  * في هذا السفر من الرجال
 قد كان في معية عظمته من ال بيته وذوي قرابته : اخو السلطان الامير محمد ، والامير عبد الله وولداه : الامير محمد ، والامير خالد ، وناصر بن السعود ، ومساعد بن سويلم ، ومشاري بن جلوي ال السعود.
 ومن العلماء : الشيخ عبد الله بن حسن قاضي جيش الامام وامامه في الصلاة ، والشيخ عبد الرحمن بن عبد اللطيف وهما من ال الشيخ محمد بن عبد الوهاب والشيخ عبد الرحمن بن علي بن الشيخ ، واخوه سليمان ، وكذلك محمد بن عبد العزيز ، والشيخ عبد الله العجيري احد رواة العرب والشيخ حمد الخطيب ، والشيخ عبد الرحمن النفيسة ، واخوه حسين ، وعبد الرحمن بن مشاري بن سويلم ، وعبد الله بن سعد

 السديري ، وعبد العزيز ال ابراهيم ، ومحمد بن حوبان. ومن ال سبهان :
 عبد الله الناصر ، وابراهيم السبهان امير حاءل السابق ، وفي صحبته حمد الشويعر صاحب بيت المال في حاءل وخدام بن فاءز ، ومبارك ال حماد العميم ، وسليمان العبيد ، ومحمد ابن عبد الكريم السبهان ، وفهد ال عبد الله السبهان ، ومحمد الصالح ، وعبد العزيز ال حمود. ومن ال طلال : الرشيد فهد ، ورشيد ، وسلطان. ومن ال عساف : حسين وولده سليمان ، وعساف الحسين ال منصور ، وحشر البواردي ، ومحمد بن حجرف البواردي ، وعبد الرحمن بن عبد الله السبيي. وحضر في معيته عظمة السيد حمزة ، من اهل المدينة المنورة ، وهو من رجال خاصة عظمة السلطان. وكذلك طبيب عظمته الخاص الدكتور محمود حمدي ، ومحمد بك النحاس ، وبشير بك الامين.

  * اهل الالوية
 وقد لحق بعظمته وهو في الطريق خمسة عشر لواء ، كل لواء ينقسم تحته فريق من جنده ، منهم لاهل الحضر خمسة الوية : لواء اهل بريدة ، ولواء اهل عنيزة اهل القصيم ولواء اهل البكيرية ، ولواء اهل المذنب ، ولواء اهل الخبراء. ومنهم عشرة الوية لسكان الهجر : لواء اهل هجرة الداهنة ، ولواء اهل دخنة ، ولواء اهل هجرة الدليمية ، ولواء هجرة مسكة ، ولواء اهل البدع ، ولواء اهل نفس ، ولواء اهل هجرة الشبيكة ، ولواء عبد المنعم بن شمس ، ولواء اهل خبرية ، ولواء اهل شريفة.
 وفي  جمادي الاول سنة  ه وزع البلاغ المطبوع في البلد الحرام بامر سلطاني ، هذا نصه :

 لمن في مكة وضواحيها من سكان الحجاز ، الحاضر منهم والباد ، نحمد اليكم الله الذي لا اله الا هو ، رب هذا البيت العتيق ، ونصلي ونسلم علي خاتم انبياءه محمد صلي الله عليه وسلم .
 اما بعد ، فلم يقدمنا من ديارنا اليكم الا انتصارا لدين الله الذي انتهكت محارمه ، ودفعا لشرور كان يكيدها لنا ولديارنا من استبد في الامر فيكم قبلنا. وقد شرحنا لكم غايتنا هذه من قبل ، وها نحن اولاء بعد ان بلغنا حرم الله نوضح لكم الخطة التي سنسير اليها في هذه الديار المقدسة ، لتكون معلومة عند الجميع فنقول :
  سيكون اكبر همنا تطهير هذه الديار المقدسة من اعداء انفسهم ، الذين مقتهم العالم الاسلامي في مشارق الارض ومغاربها ، لما اقترفوه من الاثام في هذه الديار المباركة ، وهم : الحسين ، وانجاله ، واذهابهم.
  سنجعل الامر في هذه البلاد المقدسة بعد هذا شوري بين المسلمين. وقد ابرقنا لكافة المسلمين في ساءر الانحاء ان يرسلوا وفودهم لعقد مءتمر اسلامي عام ، يقرر شكل الحكومة التي يرونها صالحة لانفاذ احكام الله في هذه البلاد المطهرة.
  ان مصدر التشريع والاحكام لا يكون الا من كتاب الله ، ومما جاء عن رسوله عليه الصلاة والسلام ، او ما اقره علماء الاسلام الاعلام بطريق القياس ، او اجمعوا عليه ، مما ليس في كتاب ولا سنة. فلا يحل في هذه الديار غير ما احله الله ، ولا يحرم فيها غير ما حرم.
  كل من كان من العلماء في هذه الديار ، او من موظفي الحرم

 الشريف والمطوفين ، ذو راتب معين ، فهو له علي ما كان عليه من قبل.
 ان لم نزده ، فلا ننقصه شيءا ، الا رجلا اقام الناس عليه الحجة انه لا يصلح لما هو قاءم عليه ، فذلك ممنوع مما كان له من قبل. وكذلك كل من كان له حق ثابت سابق في بيت مال المسلمين اعطيناه حقه ، ولم ننقصه منه شيءا.
  لا كبير عندي الا الضعيف ، حتي اخذ الحق له. ولا ضعيف عندي الا الظالم ، حتي اخذ الحق منه. وليس عندي في اقامة حدود الله هوادة ، ولا يقبل فيها شفاعة. من التزم حدود الله ، ولم يعتزلها ، فاولءك من الامنين. ومن عصي واعتدي ، فانما اثمه علي نفسه ، ولا يلومن الا نفسه.
 والله علي ما نقول وكيل وشهيد ، وصلي الله علي سيدنا محمد النبي الامي ، وعلي اله وصحبه وسلم ..

في  جمادي الاولي سنة  ه عبد العزيز بن عبد الرحمن الفيصل ال سعود
 وفي صباح يوم الاثنين  جمادي الاولي سنة  ه اجتمع علماء نجد مع علماء مكة ، ليشرح كل فريق ما عنده من العقاءد لاخيه ، فدار البحث بينهم في المساءل الفرعية ، وبعد تمام البحث اتفقوا علي نشر البيان الاتي :

  * بسم الله الرحمن الرحيم
 الحمد لله وحده ، والصلاة والسلام علي من لا نبي بعده. من

 علماء حرم الله الشريف واءمته : الشيخ حبيب الله الشنقيطي ، والشيخ عمر باجنيد ابي بكر والشيخ درويش عجيمي ، والشيخ محمد مرزوقي ، والشيخ احمد بن علي النجار ، والشيخ جمال المالكي ، والشيخ عباس مالكي ، والشيخ حسين بن سعيد عبد الغني ، والشيخ حسين مفتي المالكية والشيخ عبد الله حمودة ، والشيخ عبد الستار ، والشيخ سعد وقاس ، والشيخ عمر بن صديق خان ، والشيخ عبد الرحمن الزواوي ، الي من يراه من علماء الحكومات الاسلامية ، وملوكهم وامراءهم.
 اما بعد ، فقد اجتمعنا نحن المذكورون مع مشاءخ نجد حين قدومهم الي الحرم الشريف مع الامام عبد العزيز حفظه الله وهم : الشيخ عبد الرحمن بن عبد اللطيف ، والشيخ عبد الله بن حسن ، والشيخ عبد الوهاب بن مزاحم ، والشيخ عبد الرحمن بن محمد بن داود ، والشيخ محمد بن عثمان الشاوي ، والشيخ مبارك بن عبد المحسن بن باز ، والشيخ ابراهيم بن ناصر حسين فجري بيننا وبين المذكورين والمحترمين مباحثة ، فعرضوا علينا عقيدة اهل نجد ، وعرضنا عليهم عقيدتنا ، فحصل الاجتماع بيننا وبينهم ، وبعد البحث والمراجعة ، في مساءل اصولية ، منها : ان من اقر بالشهادتين ، وعمل باركان الاسلام الخمسة ، ثم اتي بمكفر ، بنقض اسلامه قولي ، او فعلي ، او اعتقادي انه يكون كافرا بذلك ، يستتاب ثلاثا ، فان تاب ، والا قتل.
 ومنها : من جعل بينه وبين الله وساءط من خلقه يدعوهم ويرجوهم في جلب نفع ، او دفع ضر ، او يقربونه الي الله زلفي انه كافر ، يحل دمه وماله ، ومن طلب الشفاعة من غير الله فيما لا يقدر عليه الا الله ، ان ذلك

 شرك ، فان الشفاعة ملك لله ، ولا تطلب الا منه اليه ، ولا يشفع احد الا باذنه ، كما قال تعالي : ( @QUR@ من ذا الذي يشفع عنده الا باذنه ) [البقرة : ] ، وهو لا ياذن الا فيمن رضي قوله وعمله ، كما قال تعالي : ( @QUR@ ولا يشفعون الا لمن ارتضي ) [الانبياء : ] ، وهو لا يرضي الا التوحيد ، والاخلاص.
 ومنها : تحريم البناء علي القبور ، واسراجها ، وترك الصلاة عندها.
 ان ذلك بدعة محرمة في الشريعة.
 ومنها : ان من سال الله بجاه احد من خلقه ، فهو مبتدع مرتكب حراما.
 ومنها : انه لا يجوز الحلف بغير الله ، لا الكعبة ، ولا الامانة ، ولا النبي ، ولا غير ذلك ، لقول النبي صلي الله عليه وسلم : «من حلف بغير الله ، فقد اشرك».
 فهذه المساءل كلها لما وقعت المباحثة فيها ، حصل الاتفاق بيننا وبين المذكورين ، ولم يحصل خلاف في شء ، فاتفقت بذلك العقيدة بيننا معشر علماء الحرم الشريف ، وبين اخواننا علماء نجد ، نسال الله ان يوفق الجميع لما يحبه ويرضاه ، وصلي الله علي محمد واله وسلم.
 وفي  جمادي الاولي سنة  ه : كتب اهالي مكة الي عظمة السلطان كتابا ، هذا مضمونه :.

  * بسم الله الرحمن الرحيم
 الي مقام السلطنة السنية ، الامام عبد العزيز دام جلاله. امين.
 اما بعد ، سلمك الله ، ما يخفاكم ان اهل البلد جيران بيت الله حصل عليهم بعد الضيق في هذه الايام ، ولو انكم لم تقصروا عليهم في

 السعي لجلب الارزاق من اليمن وغيرها ، ولكن معلومكم كبر البلد وكثرة سكانها ، ولا يخفاكم ذلك. وبموجب انكم اجرتمونا واعطيتونا امان الله ، وانكم تسعون لتامين هذا البيت واهله ، كما في منشوراتكم ، واقوالكم ، ثم بعد ذلك شاورتمونا في مسالة جدة ، واشرنا عليكم بالتوقف عن العجلة ، لعل الله يفتحها بهدوء وسكون ، واجبتمونا علي ذلك ، فالان نعرض لحضرتكم ان تنظروا بهذا الكتاب المقدم طية ، لتسعوا في دفعه لعلي فان اجاب ، فالحمد لله ، وان ابي فنرجو الاغاثة من الله ، والفرج لبيته الحرام وجيرانه ، نرجوا الله ان يوفقكم والسلام.
  جمادي الاولي سنة .
 من عموم جيران بيت الله الحرام عبد القادر الشيبي ، عقيل بن محمد بن يحيي ، ابو بكر بابصيل ، عبد الرحمن الزواوي ، عباس المالكي ، صالح بن سليمان حجازي ، محمد نور ابراهيم ملاءكة

  * جواب عظمة السلطان علي ذلك الكتاب
 من عبد العزيز بن عبد الرحمن الفيصل الي حضرات الكرام ، عبد القادر الشيبي ، وعموم جيران بيت الله الحرام.
 السلام عليكم ورحمة الله وبركاته. مكتوبكم المكرم كان معلوما.
 اما من خصوص بعض الامور التي تشعرون بها من قبل المعيشة ، فتعلمون ان الذي يءلمكم يءلمني كثيرا ، وما اقدر عليه من الامور باذل جهدي فيه.
 وهذه الواردات من الارزاق ترد يوميا كما ترون ، انني خوفا من الضيق علي البلد ارسل فاجلب الارزاق لجندنا من الخارج.

 واما من جهة جدة ، فنحن لم يمنعنا عنها الا رجاء سلامتها ، وسلامة اهلها في دماءهم واموالهم. ولكنني ما اري عليا وجماعته يرغبون في سلام البلد ، وعدم التضيق علي بيت الله واهله ، وهم لا يزالون في طغيانهم يعمهون ، حيث انهم جماعة الله ربنا وربهم تلعب بهم التخيلات ، وعدم المبالاة باحوال المسلمين.
 واما الكتاب الذي طلبتم منا ارساله اليه ، فاجابة لطلبكم نرسله اليه ، ولكن لا اظن القوم يوفقون للرشاد ، ولا اظن ان هذا الكتاب يفيد فيهم شيءا ، بل ربما اولوه علي معني ثان ولكن نظرا لاعتمادنا علي الله ، ثم التماسنا لصالح المسلمين ، نجيبكم الي ذلك ، ونرسله ان شاء الله.
 انه بعد وصول مكتوبكم هذا اليه لا نكون مسءولين من قبل الله ، ولا من قبلكم ، ولا من قبل عموم المسلمين ، نرجو من الله تعالي ان يوفقنا واياكم وكافة المسلمين لما فيه الخير ، وان ينصر دينه ، ويعلي كلمته وصلي الله علي سيدنا محمد واله وصحبه وسلم.
