 س: ما هو الراي في الاحتفالات البهيجة التي يقيمها المسلمون في ترنيداد بمناسبة الزواج والانتقال الي دار جديدة، واعياد الميلاد الفردية وغيرها من المناسبات السارة، والتي يتلون خلالها القران الكريم، وينشدون اناشيد المديح في الرسول الكريم صلي الله عليه وسلم، ثم يختمون الحفل بالوقوف احتراما وتقديرا للرسول الكريم صلي الله عليه وسلم؟
 ج: اولا: حرم النبي صلي الله عليه وسلم نكاح السر، وامر باعلان النكاح، والاحتفال بمناسبة الزواج والانتقال بالعروس الي دار زوجها من اعلان النكاح، فكان مشروعا الا اذا كان فيه غناء ماجن، او اختلاط نساء برجال، او ما اشبه ذلك من المحرمات. ثانيا: الاعياد في الاسلام ثلاثة: يوم عيد الفطر، ويوم عيد الاضحي، ويوم الجمعة، اما اعياد الميلاد الفردية، وغيرها مما يجتمع فيه من المناسبات السارة، كاول يوم من السنة الهجرية والميلادية، وكيوم نصف شعبان او ليلة النصف منه، ويوم مولد النبي صلي الله عليه وسلم، ويوم تولي زعيم الملك او رءاسة جمهورية مثلا، فهذه وامثالها لم تكن في عهد النبي صلي الله عليه وسلم، ولا في عهد خلفاءه الراشدين، ولا في القرون الثلاثة التي شهد لها النبي صلي الله عليه وسلم بالخير، فهي من البدع المحدثة
 
 التي سرت الي المسلمين من غيرهم، وفتنوا بها، وصاروا يحتفلون فيها كاحتفالهم بالاعياد الاسلامية او اكثر، وقد يحدث في بعض هذه الاحتفالات غلو في الاشخاص، واسراف في الاموال، واختلاط نساء برجال ليسوا بمحارم لهن، ومضاهاة لاهل الكفر فيما هو عادة لهم في احتفالهم بما يسمي عندهم اعياد، وقد قال النبيصلي الله عليه وسلم: «اياكم ومحدثات الامور، فان كل محدثة بدعة، وكل بدعة ضلالة () » وقال: «من احدث في امرنا هذا ما ليس منه فهو رد () » وهذا ظاهر فيما اذا كان الاحتفال لتعظيم من احتفل من اجله، او لرجاء بركته، او المثوبة من القيام؛ كمولد النبي صلي الله عليه وسلم، ومولد الحسين ومولد البدوي وغيرهم، ولتعظيم ما احتفل به من الايام والليالي، ورجاء المثوبة من الاحتفال به والبركة من ذلك؛ كالاحتفال بليلة النصف من شعبان او يومها، وليلة الاسراء والمعراج ونحو ذلك، فان الاحتفال بما ذكر وامثاله ضرب من الزلفي والتقرب وقصد المثوبة، اما ما لم يقصد به التبرك ولا المثوبة، كالاحتفال بميلاد الاولاد، واول السنة الهجرية او الميلادية، وبيوم تولي الزعماء لمناصبهم فهو وان كان من بدع العادات الا ان فيه مضاهاة للكفار في اعيادهم، وذريعة الي انواع اخري من 
 الاحتفالات المحرمة، التي ظهر فيها معني التعظيم والتقرب، فكانت ممنوعة سدا للذريعة، وبعدا عن مشابهة الكفار في اعيادهم واحتفالاتهم، وقد قال صلي الله عليه وسلم: «من تشبه بقوم فهو منهم () » ثالثا: تلاوة القران من خير القربات والاعمال الصالحات، لكن جعلها ختاما لاحتفالات مبتدعة لا يجوز؛ لان فيه مهانة له بوضعه في غير موضعه، واما انشاد الاناشيد في مديح النبي صلي الله عليه وسلم فحسن، الا اذا تضمنت غلوا فيه، وكونها ختاما للمناسبات المذكورة ونحوها فلا يجوز؛ لقوله صلي الله عليه وسلم: «لا تطروني كما اطرت النصاري ابن مريم وانما انا عبد، فقولوا: عبد الله ورسوله () » وقال صلي الله عليه وسلم: «اياكم والغلو، فانما اهلك من كان قبلكم الغلو () » كما لا يجوز ان يخصوا ذلك بيوم يتخذ موسما وعيدا. رابعا: اختتام الاحتفال بالقيام احتراما للرسول صلي الله عليه وسلم، وتقديرا له، اختتام سيء، لا يرضاه الله، ولا تقره الشريعة، فانه من انواع الشرك الذي حرمه الله علي عباده، فان الوقوف احتراما لمن قد لقي ربه نوع من التقرب اليه والعبادة له، كما ان القيام في الصلاة قربة يتقرب بها الي الله تعالي، وهو ضرب من الغلو في الرسول صلي الله عليه وسلم، وقد نهانا النبي صلي الله عليه وسلم عن ذلك. 
 وبالله التوفيق، وصلي الله علي نبينا محمد واله وصحبه وسلم.
