  ( الباب الاول في تعريفهما حقيقة ومجازا ، وفيه فصلان )

  ( الفصل الاول في حقيقتهما واركانهما )
  ( خ م ت س ) عبد الله بن عمر : قال : قال رسول الله  صلي الله عليه وسلم  : ( بني الاسلام علي خمس : شهادة ان لا اله الا الله ، وان محمدا عبده ورسوله ،  واقام الصلاة وايتاء الزكاة ، وحج البيت ، وصوم رمضان ) . وفي رواية ان رجلا قال له : الا تغزو ؟ فقال له : اني سمعت رسول الله  صلي الله عليه وسلم  يقول : ( ان الاسلام بني علي خمس . . ) وذكر الحديث . وفي اخري : ( بني الاسلام علي خمسة : علي ان يوحد الله ، واقام الصلاة ، وايناء الزكاة ، وصيام رمضان ، والحج ) ، فقال رجل : الحج وصيام رمضان ؟ قال : ( لا ، صيام رمضان والحج ) ، هكذا سمعته من رسول الله  صلي الله عليه وسلم  . وفي اخري ( بني الاسلام علي خمس : [ علي ] ان يعبد الله ويكفر بما دونه ، واقام الصلاة ، وايتاء الزكاة ، وحج البيت ، وصوم رمضان ) اخرج طرقه جميعها مسلم ، ووافقه علي الاولي : الترمذي ، وعلي الثانية : البخاري والنساءي .
  ( م ت د س ) يحيي بن يعمر : قال : كان اول من قال في القدر بالبصرة : معبد الجهني ، فانطلقت انا وحميد بن عبد الرحمن الحميري حاجين ، او معتمرين ، فقلنا : لو لقينا احدا من اصحاب رسول الله  صلي الله عليه وسلم   فسالناه عما يقول هءلاء في القدر ؟ فوفق لنا عبد الله بن عمر بن الخطاب  رضي الله عنه  داخلا المسجد ، فاكتنفته انا وصاحبي ، احدنا عن يمينه ، والاخر عن شماله ، فظننت ان صاحبي سيكل الكلام الي ، فقلت : ابا عبد الرحمن ! انه قد ظهر قبلنا اناس يقرءون القران ، ويتقفرون العلم ، وذكر من شانهم ، وانهم يزعمون ان لا قدر ، وان الامر انف ، فقال : اذا لقيت اولءك فاخبرهم : اني برء منهم ، انهم براء مني ، والذي يحلف به عبد الله بن عمر : لو ان لاحدهم مثل احد ذهبا فانفقه ، ما قبل الله منه حتي يءمن بالقدر ، ثم قال : حدثني ابي عمر بن الخطاب ، قال : بينما نحن جلوس عند رسول الله  صلي الله عليه وسلم  ذات يوم ، اذ طلع علينا رجل شديد بياض الثياب ، شديد سواد الشعر ، لا يري عليه اثر السفر ، ولا يعرفه منا احد ، حتي جلس الي النبي  صلي الله عليه وسلم  فاسند ركبتيه اي ركبتيه ، ووضع كفيه علي فخذيه وقال : يا محمد ، اخبرني عن الاسلام ، فقال رسول الله  صلي الله عليه وسلم  : ( الاسلام ان تشهد ان لا اله الا الله ، وان محمدا رسول الله ، وتقيم الصلاة ، وتءتي الزكاة ، وتصوم رمضان ، وتحج البيت ان استطعت اليه سبيلا ) . قال : صدقت ، قال : فعجبنا له يساله ويصدقه ، قال : فاخبرني عن الايمان ؟ قال : ( ان تءمن بالله ، وملاءكته ، وكتبه ، ورسله ، واليوم الاخر ، وتءمن بالقدر خيره وشره ) . قال : صدقت ، قال : فاخبرني عن الاحسان ، قال : ( ان تعبد الله كانك تراه ، فان لم تكن تراه ، فانه يراك ) . قال : فاخبرني عن الساعة ؟ قال : ( ما المسءول  عنها باعلم من الساءل ) . قال : فاخبرني عن اماراتها ؟ قال : ( ان تلد الامة ربتها ، وان تري الحفاة العراة ، العالة رعاء الشاء يتطاولون في البنيان ) ، قال : ثم انطلق ، فلبث مليا ثم قال لي : ( يا عمر ، اتدري من الساءل ؟ ) قلت : الله ورسوله اعلم ، قال : ( فانه جبريل اتاكم يعلمكم دينكم ) ، هذا لفظ مسلم . قال الحميدي : جمع مسلم فيه الروايات ، وذكر ما اوردنا من المتن ، وان في بعض الروايات زيادة ونقصانا . واخرجه الترمذي بنحوه ، وتقديم بعضه وتاخيره . وفيه : قال عمر : فلقيني رسول الله  صلي الله عليه وسلم  بعد ثلاث ، فقال لي : ( يا عمر ، هل تدري من الساءل ؟ . . . ) الحديث . واخرجه ابو داود بنحوه ، وفيه ( فلبث ثلاثا ) . وفي اخري له : قال : فما الاسلام ؟ قال : ( اقام الصلاة ، وايتاء الزكاة ، وحج البيت ، وصوم شهر رمضان ، والاغتسال من الجنابة ) .  وفي اخري لابي داود : عن يحيي بن يعمر ، وحميد بن عبد الرحمن قالا : لقينا عبد الله بن عمر ، فذكرنا له القدر ، وما يقولون فيه ؟ فذكر نحوه ، وزاد : قال : وساله رجل من مزينة ، او جهينة ، فقال : يا رسول الله ، فيم نعمل ؟ في شء خلا ومضي ، او شء يستانف الان ؟ قال : ( في شء خلا ومضي ) . فقال الرجل  او بعض القوم  ففيم العمل ؟ قال : ( ان اهل الجنة ميسرون لعمل اهل الجنة ، وان اهل النار ميسرون لعمل اهل النار ) . واخرجه النساءي مثل رواية مسلم ، الا انه اسقط حديث يحيي بن يعمر ، وذكر معبد ، وما جري له مع ابن عمر في ذكر القدر  الي قوله : ( حتي تءمن بالقدر ) . واول حديثه قال ابن عمر : حدثني ابي  وسرد الحديث الي قوله  ( البنيان ) . ثم قال : قال عمر : فلبث ثلاثا ، ثم قال لي رسول الله  صلي الله عليه وسلم  : ( اتدري من الساءل ؟ . . . ) الحديث . وزاد هو والترمذي وابو داود بعد ( العراة )  ( العالة ) .  * * * غريب الحديث * * * القدر : القدر : مصدر قدر يقدر ، وقد تسكن داله ، وهو ما قضاه الله تعالي ، وحكم به من الامور . اكتنفه : كنفت الرجل واكتنفته ، اي صرت مما يليه ، وكذلك اذا قمت بامره . سيكل : وكلت الامر اليه اكله : اذا رددته اليه ، واعتمدت فيه عليه ، واستكفيته اياه . يقتفرون : الاقتفار ، والتقفر ، والاقتفاء ، والاقتداء : الاتباع ، يقال : اقتفرت الارض والاثر ، وتقفرت . الانف : انف : اي مستانف ، من غير ان يسبق له سابق قضاء وتقدير ، وانما هو مقصور علي الاختيار . الاحسان : قال الخطابي : انما اراد بالاحسان هنا : الاخلاص ، وهو شرط في صحة الايمان ، والاسلام معا ، وذلك ان من تلفظ بالكلمة ، وجاء بالعمل من غير نية واخلاص لم يكن محسنا ، ولا كان ايمانه صحيحا . ربتها ، وربها : الرب : السيد ، والمالك ، والصاحب ، والمدبر ، والمربي ، والمولي ، والمراد به في الحديث : السيد ، والمولي ، وهي الامة تلد للرجل فيكون ابنها مولي لها ، وكذلك ابنتها ، لانها في الحسب كابيها ،  والمراد : ان السبي يكثر ، والنعمة تفشو في الناس وتظهر . رعاء الشاء : الرعاء : جمع راع ، والشاء : جمع شاة . مليا : الملي : طاءفة من الزمان طويلة ، يقال : مضي ملي من النهار ، اي : ساعة طويلة منه . العالة : الفقراء : جمع عاءل ، والعيل : الفقر .
  ( خ م د س ) ابو هريرة وابو ذر  رضي الله عنهما  : قال : كان رسول الله  صلي الله عليه وسلم  يوما بازرا للناس ، فاتاه رجل فقال : يا رسول الله ، ما الايمان ؟ قال : ( ان تءمن بالله ، وملاءكته ، وكتابه ، ولقاءه ، ورسله ، وتءمن بالبعث الاخر ) قال : يا رسول الله ما الاسلام ؟ قال : ( الاسلام ان تعبد الله ، لا تشرك به شيءا ، وتقيم الصلاة المكتوبة ، وتءدي الزكاة المفروضة ، وتصوم رمضان ) . قال : يا رسول الله ما الاحسان ؟ قال : ( ان تعبد الله كانك تراه ، فانك ان لم تره فانه يراك ) . قال : يا رسول الله ، متي الساعة ؟ قال : ( ما المسءول عنها باعلم من الساءل ، ولكن ساحدثك عن اشراطها : اذا ولدت الامة ربتها ، فذاك من اشراطها ، واذا كانت العراة الحفاة رءوس الناس ، فذاك من اشراطها ، واذا تطاول  رعاء البهم في البنيان ، فذاك من اشراطها ، في خمس لا يعلمهن الا الله ، ثم تلا رسول الله  صلي الله عليه وسلم  : { ان الله عنده علم الساعة ، وينزل الغيث ، ويعلم ما في الارحام }  الي قوله : { ان الله عليم خبير } ( لقمان : الاية  ) . قال : ثم ادبر الرجل ، فقال رسول الله  صلي الله عليه وسلم  : ردوا علي الرجل ) ، فاخذوا ليردوه ، فلم يروا شيءا ، فقال رسول الله  صلي الله عليه وسلم  : ( هذا جبريل جاء ليعلم الناس دينهم ) . وفي رواية قال : ( اذا ولدت الامة بعلها ) يعني السراري . وفي اخري نحوه : وفي اوله : ان رسول الله  صلي الله عليه وسلم  قال : ( سلوني ) فهابوه ان يسالوه ، فجاء رجل ، فجلس عند ركبتيه ، فقال : يا رسول الله ، ما الاسلام  وذكر نحوه  وزاد : انه قال له في اخر كل سءال منها : صدقت  وقال في الاحسان : ( ان تخشي الله كانك تراه ) . وقال فيها : ( واذا رايت الحفاة العراة الصم البكم ملوك الارض ، فذاك من اشراطها )  وفي اخرها  ( هذا جبريل اراد ان تعلموا ، اذ لم تسالوا ) . هذا لفظ البخاري ومسلم عن ابي هريرة وحده . واخرجه ابو داود عن ابي هريرة وابي ذر ، بمثل حديث قبله ، وو حديث يحيي اابن يعمر ، وهذا لفظه : قال ابو هريرة وابو ذر : كان رسول الله  صلي الله عليه وسلم  يجلس بين ظهراني اصحابه ، فيجء الغريب ، فلا يدري : ايهم هو حتي يسال ، فطلبنا الي رسول الله  صلي الله عليه وسلم  ان نجعل له مجلسا ، يعرفه الغريب اذا اتاه ، قال : فبنينا له  دكانا من طين يجلس عليه ، وكنا نجلس بجنبته  وذكر نحو حديث يحيي بن يعمر  فاقبل رجل ، وذكر هياته ، حتي سلم من طرف السماط ، فقال : السلام عليك يا محمد ، فرد عليه النبي  صلي الله عليه وسلم  . واخرجه النساءي عن ابي هريرة وابي ذر بمثل حديث ابي داود ، الي قوله : من طين كان يجلس عليه ، ثم قال : وانا لجلوس ورسول الله  صلي الله عليه وسلم  ، اذ اقبل رجل احسن الناس وجها ، واطيب الناس ريحا ، كان ثيابه لم يمسها دنس ، حتي سلم من طرف السماط ، قال : السلام عليك يا محمد ، فرد عليه السلام ، قال : ادنو يا محمد ؟ قال : ( ادنه ) . قال : فما زال يقول : ادنو مرارا ، ويقول : ( ادنه ) حتي وضع يده علي ركبتي رسول الله  صلي الله عليه وسلم  . قال : يا محمد ، اخبرني ما الاسلام ، قال : ( الاسلام ان تعبد الله لا تشرك به شيءا ، وتقيم الصلاة ، وتءتي الزكاة ، وتحج البيت ، وتصوم رمضان ) . قال : واذا فعلت ذلك ، فقد اسلمت ؟ قال : ( نعم ) . قال : صدقت ، فلما سمعنا قول الرجل : صدقت ، انكرناه . قال : يا محمد ، اخبرني عن الايمان ؟ قال : ( ان تءمن بالله والملاءكة ، والكتاب ، والنبيين ، وتءمن بالقدر ) قال : ( فاذا فعلت ذلك ، فقد امنت ؟ ) قال رسول الله  صلي الله عليه وسلم  : ( نعم ) قال : صدقت ، قال : يا محمد ، اخبرني : ما الاحسان ؟ قال : ( ان تعبد الله كانك تراه ، فان لم تكن تراه فانه  يراك ) . [ قال : صدقت ] ، قال : يا محمد ، اخبرني : متي الساعة ؟ قال : فنكس ، فلم يجبه شيءا ، ثم عاد ، فلم يجبه شيءا ، ثم رفع راسه ، قال : ( ما المسءول عنها باعلم من الساءل ، ولكن لها علامات تعرف بها : اذا رايت رعاء البهم يتطاولون في البنيان ، ورايت الحفاة العراة ملوك الارض ، ورايت الامة تلد ربها ، في خمس لا يعلمها الا الله ، { ان الله عنده علم الساعة }  ثم تلا الي قوله  : { ان الله عليم خبير } ( لقمان : الاية  ) ، قال : لا والذي بعث محمدا بالحق هاديا وبشيرا ، ما كنت باعلم به من رجل منكم ، وانه لجبريل نزل في صورة دحية الكلبي ) . * * * غريب الحديث * * * البهم : جمع بهمة ، وهي صغار الغنم . اشراطها : الاشراط : جمع شرط ، وهو العلامة . رءوس الناس : اراد : مقدميهم ، وسادتهم . الصم : جمع اصم ، وهو الذي لا يسمع شيءا . البكم : جمع ابكم ، وهو الذي خلق اخرس ، لا يتكلم .  ظهراني : يقال : اقام فلان بين اظهر قومه ، وظهراني قومه : اي اقام بينهم ، والاظهر : جمع ظهر ، وفاءدة ادخاله في الكلام : ان اقامته بينهم علي سبيل الاستظهار بهم ، والاستناد اليهم . واما ظهرانيهم : فقد زيدت فيه الالف والنون علي ظهر ، عند التثنية للتاكيد ، وكان معني التثنية : ان ظهرا منهم قدامه ، واخر وراءه ، فكانه مكنوف من جانبيه ، هذا اصله ، ثم كثر حتي استعمل في الاقامة بين القوم ، وان لم يكن مكنوفا بينهم . دكانا : الدكان : الدكة المبنية للجلوس عليها . السماط : السماطان من الناس والنخل : الجانبان ، يقال : مشي بين السماطين ، والمراد بالسماط : الجماعة من الناس الجلوس عنده . دنس : الدنس : الوسخ ، وقد دنس الثوب اذا توسخ . ادنه : امر بالدنو ، وهو القرب ، والهاء فيه هاء السكت ، جء بها لبيان الحركة .
  ( خ م ت د س ) انس بن مالك  رضي الله عنه  : قال : ( بينما نحن جلوس مع النبي  صلي الله عليه وسلم  في المسجد ، اذ دخل رجل علي جمل ، ثم اناخه في المسجد ، ثم عقله ، ثم قال [ لهم ] : ايكم محمد ؟ والنبي  صلي الله عليه وسلم  متكء بين  ظهرانيهم ، فقلنا : هذا الرجل الابيض المتكء ، فقال له [ الرجل ] : ابن عبد المطلب ؟ فقال له النبي  صلي الله عليه وسلم  : ( قد اجبتك ) . فقال الرجل [ للنبي ] : اني ساءلك فمشدد عليك في المسالة ، فلا تجد علي في نفسك ، قال : ( سل عما بدا لك ) . فقال اسالك بربك ورب من قبلك ، الله ارسلك الي الناس كلهم ؟ قال : ( اللهم نعم ) . قال : انشدك بالله : الله امرك ان تصلي الصلوات الخمس في اليوم والليلة ؟ قال : ( اللهم نعم ) . قال : انشدك بالله ، الله امرك ان تصوم هذا الشهر من السنة ؟ قال : [ اللهم ] نعم ) . قال : انشدك بالله ، الله امرك ان تاخذ هذه الصدقة من اغنياءنا ، فتقسمها علي فقراءنا ؟ . فقال النبي  صلي الله عليه وسلم  : ( اللهم نعم ) . قال الرجل : امنت بما جءت به ، وانا رسول من وراءي من قومي ، انا ضمام بن ثعلبة ، اخو بني سعد بن بكر . هذا لفظ البخاري . واخرجه مسلم ، وهذا لفظه ، قال انس  رضي الله عنه  : نهينا في القران ان نسال رسول الله  صلي الله عليه وسلم  عن شء ، فكان يعجبنا ان يجء الرجل من اهل البادية العاقل ، فيساله ونحن نسمع ، فجاء رجل من اهل البادية ، فقال : يا محمد ، اتانا رسولك ، فزعم لنا انك تزعم ان الله ارسلك ، فقال : ( صدق ) .  قال : فمن خلق السماء ؟ قال : ( الله ) . قال : فمن خلق الارض ؟ قال : ( الله ) . قال : فمن نصب هذه الجبال وجعل فيها ما جعل ؟ قال : ( الله ) . قال : فبالذي خلق السماء وخلق الارض ، ونصب هذه الجبال ، الله ارسلك ؟ قال : ( نعم ) . قال : وزعم رسولك ان علينا خمس صلوات في يومنا وليلتنا ؟ قال : ( صدق ) . قال : فبالذي ارسلك ، الله امرك بهذا ؟ قال : ( نعم ) . قال : وزعم رسولك ان علينا زكاة في اموالنا ؟ قال : ( صدق ) . قال : فبالذي ارسلك ، الله امرك بهذا ؟ قال : ( نعم ) ، قال : وزعم رسولك ان علينا صوم شهر رمضان في سنتنا ؟ قال : ( صدق ) . قال : فبالذي ارسلك ، الله امرك بهذا ؟ قال : ( نعم ) ، قال : وزعم رسولك ان علينا حج البيت من استطاع اليه سبيلا ؟ قال : ( صدق ) . قال : [ فبالذي ارسلك . الله امرك بهذا ؟ قال : ( نعم ) . قال ] : ثم ولي ، وقال : والذي بعثك بالحق لا ازيد عليهن ، ولا انقص منهن ، فقال النبي  صلي الله عليه وسلم  : ( لءن صدق ليدخلن الجنة ) . واخرجه الترمذي مثل رواية مسلم . واخرجه النساءي مثل رواية البخاري ومسلم . واخرج ابو داود منه طرفا من اول رواية البخاري الي قوله اني ساءلك ، ثم قال  وساق الحديث  ولم يذكر لفظه . * * *  غريب الحديث * * * متكء : قال الخطابي : كل من استوي قاعدا علي وطاء فهو متكء ، والعامة لا تعرف المتكء ، الا من مال في قعوده معتمدا علي احد شقيه . فلا تجد : يقال : وجدت عليه اجد موجدة  اذا غضبت عليه ، يقول له : اني ساءلك فلا تغضب من سءالي . انشدك : يقال : نشدتك بالله ، ونشدتك الله ، اي سالتك به ، واصله من النشيد ، وهو رفع الصوت ، فكان معناه : طلبت اليك بالله برفع نشيدي : اي صوتي بطلبها .
  ( د ) عبد الله بن عباس  رضي الله عنهما  قال : بعث بنو سعد بن بكر ضمام ابن ثعلبة الي رسول الله  صلي الله عليه وسلم  فقدم اليه ، فاناخ بعيره علي باب المسجد ، ثم عقله ، ثم دخل المسجد  فذكر نحوه  قال : فايكم ابن عبد المطلب ؟ فقال رسول الله  صلي الله عليه وسلم  : ( انا ابن عبد المطلب ) . فقال : يا ابن عبد المطلب . . . وساق الحديث . هكذا  اخرجه ابو داود ، ولم يذكر لفظ الحديث ، وانما اورده عقيب حديث انس المذكور .
  ( س ) ابو هريرة  رضي الله عنه  قال : بينما النبي  صلي الله عليه وسلم  مع اصحابه ، جاءهم رجل من اهل البادية ، فقال : ايكم ابن عبد المطلب ؟ فقالوا : هذا الامغر المرتفق  قال حمزة : الامغر : الابيض المشوب بحمرة  قال : اني ساءلك ، فمشتد عليك في المسالة ، قال : ( سل عما بدا لك ) ، قال : انشدك برب من قبلك ، ورب من بعدك : الله ارسلك ؟ قال : ( اللهم نعم ) . قال : انشدك به : الله امرك ان تصلي خمس صلوات في كل يوم وليلة ؟ قال : ( اللهم نعم ) . قال : فانشدك به : الله امرك ان تاخذ من اموال اغنياءنا فترده علي فقراءنا ؟ قال : ( اللهم نعم ) . قال : فانشدك به ، الله امرك ان تصوم هذا الشهر من اثني عشر شهرا ؟ قال : ( اللهم نعم ) . قال : فانشدك بالله ، الله امرك ان يحج ذا البيت من استطاع اليه سبيلا ؟ قال : ( اللهم نعم ) . قال : [ فاني ] امنت وصدقت ، وانا ضمام بن ثعلبة . اخرجه النساءي . * * * غريب الحديث * * * الامغر : قد جاء تفسيره في الحديث : انه الابيض المشرب بالحمرة  ، وفي كتب الغريب : هو الاحمر ، ماخوذ من المغرة ، وقال الازهري : اراد بالامغر : الابيض ، كما اراد في موضع اخر بالاحمر : الابيض ، بدليل قوله العرب : امراة حمراء ، يعنون : بيضاء ، ومنه قوله  صلي الله عليه وسلم  لعاءشة  رضي الله عنها  : ( يا حميراء ) والكل متقارب . المرتفق : المتكء علي مرفقه .
  ( خ م ط د س ) طلحة بن عبيد الله  رضي الله عنهما  قال : جاء رجل الي رسول الله  صلي الله عليه وسلم  ، من اهل نجد ، ثاءر الراس ، نسمع دوي صوته ، ولا نفقه ما يقول ، حتي دنا من رسول الله  صلي الله عليه وسلم  ، فاذا هو يسال عن الاسلام ؟ فقال رسول الله  صلي الله عليه وسلم  : ( خمس صلوات في اليوم والليلة ) . فقال : هل علي غيرهن ؟ قال : ( لا ، الا ان تطوع ) . فقال رسول الله  صلي الله عليه وسلم  : ( وصيام رمضان ) . فقال : هل علي غيره ؟ قال : ( لا ، الا ان تطوع ) . قال : وذكر له رسول الله  صلي الله عليه وسلم  الزكاة ، فقال : هل علي غيرها ؟ قال : ( لا ، الا  ان تطوع ) . قال : فادبر الرجل ، وهو يقول : والله لا ازيد علي هذا ولا انقص منه . فقال رسول الله  صلي الله عليه وسلم  : ( افلح ان صدق ، او دخل الجنة ان صدق ) . اخرجه البخاري ومسلم و ( الموطا ) وابو داود والنساءي . الا ان ابا داود والنساءي قالا : ( الصدقة ) عوض ( الزكاة ) . وقال ابو داود : ( افلح وابيه ان صدق ) . واخرجه النساءي ايضا من رواية اخري : ( ان اعرابيا جاء الي رسول الله  صلي الله عليه وسلم  ثاءر الراس ، فقال : يا رسول الله ، اخبرني ماذا فرض الله من الصلاة ؟ ) قال : ( الصلوات الخمس ، الا ان تطوع ، قال : اخبرني : ماذا فرض الله علي من الصوم ؟ ) فذكر الحديث كما سبق . * * * غريب الحديث * * * الثاءر الراس : الشعث الشعر ، البعيد العهد بالغسل والتسريح والدهن . الدوي : كصوت النحل وغيره . نفقه : الفقه : الفهم والعلم ، اي : لا يفهم كلامه  . افلح وابيه : كلمة جارية علي السن العرب ، تستعملها كثيرا في خطابها ، وتريد بها : التاكيد ، وقد نهي رسول الله  صلي الله عليه وسلم  ان يحلف الرجل بابيه . فيحتمل ان يكون هذا القول منه قبل النهي ، ويحتمل ان يكون جري منه علي عادة الكلام ، والجاري علي الالسن ، وهو لا يقصد به القسم ، كاليمين المعفو عنها من قبيل اللغو ، او انه اراد به التوكيد ، لا اليمين ، فان هذه اللفظة تجري في كلام العرب علي ضربين : للتعظيم ، وللتاكيد ، والتعظيم هو المنهي عنه ، واما التوكيد فلا ، كقوله : لعمر ابي الواشين لا عمر غيرهم لقد كلفتني خطة لا اريدها فهذا توكيد ؛ لانه لا يقصد ان يقسم بابي الواشين ، وهذا في كلامهم كثير .
  ( خ م ت د س ) عبد الله بن عباس  رضي الله عنهما  اتته امراة تساله عن نبيذ الجر ، فقال : ان وفد عبد القيس اتوا النبي  صلي الله عليه وسلم  ، فقال رسول الله  صلي الله عليه وسلم  : ( من الوفد ؟  او من القوم  ؟ ) قالوا : ربيعة ، قال : ( مرحبا بالقوم ، او بالوفد ، غير خزايا ، ولا ندامي ) . قال : فقالوا : يا رسول الله ، انا ناتيك من شقة بعيدة ، وان بيننا وبينك هذا الحي من كفار مضر ، وانا لا نستطيع ان ناتيك الا في الشهر الحرام ، فمرنا بامر فصل ، نخبر به من وراءنا ، وندخل به الجنة ، قال : فامرهم باربع ، ونهاهم عن اربع ، قال : امرم بالايمان بالله وحده ، قال : ( هل تدرون ما الايمان ؟ ) قالوا : الله ورسوله اعلم . قال :  ( شهادة ان لا اله الا الله ، وان محمدا رسول الله ، واقام الصلاة ، وايتاء الزكاة ، وصوم رمضان ، وان تءدوا خمسا من المغنم ) ، ونهاهم عن الدباء والحنتم ، والمزفت ، النقير  قال شعبة : وربما قال : المقير  وقال : ( احفظوه ) واخبروا به من وراءكم ) . وفي رواية نحوه ، قال : ( انهاكم عما ينبذ في الدباء والنقير والحنتم والمزفت ) . وزاد في رواية قال : وقال رسول الله  صلي الله عليه وسلم  للاشج  اشج عبد القيس : ( ان فيك خصلتين يحبهما الله تعالي : الحلم والاناة ) . وفي اخري ( شهادة ان لا اله الا الله ) وعقد بيده واحدة . هذا لفظ البخاري ومسلم . واخرج الترمذي بعضه ، وهذا لفظه : قال : لما قدم وفد عبد القيس علي رسول الله  صلي الله عليه وسلم  ، فقالوا : انا هذا الحي من ربيعة ، ولسنا نصل اليك الا في الشهر الحرام ، فمرنا بشء ناخذه عنك ، وندعو اليه من وراءنا ، قال : ( امركم باربع : الايمان بالله ( ثم فسرها لهم ب : ) شهادة ان لا اله الا الله ، واني رسول الله ، واقام الصلاة ، وايتاء الزكاة ، وان تءدوا خمس ما غنمتم ) . واخرجه النساءي وابو داود بطوله . واول حديثهما : لما قدم وفد عبد القيس علي رسول الله  صلي الله عليه وسلم  ، فقالوا  : يا رسول الله ، ان هذا الحي من ربيعة ، وقد حال بيننا وبينك كفار مضر ، وليس نخلص اليك الا في شهر حرام ، فمرنا بشء ناخذ به ، وندعو من وراءنا . وذكر الحديث مثل البخاري ومسلم . وفي اخري لابي داود ( النقير والمقير ) ولم يذكر ( المزفت ) . وفي اخري له مختصرا مثل الترمذي ، الا ان اولها : ان وفد عبد القيس لما قدموا علي رسول الله  صلي الله عليه وسلم  : امرهم بالايمان بالله . قال : ( اتدرون ما الايمان بالله ؟ قالوا : الله ورسوله اعلم ، قال : ( شهادة ان لا اله الا الله . . ) وذكر الحديث ، وقال في اخره : ( وان تعطوا الخمس من المغنم  ) . * * * غريب الحديث * * * الجر : والجرار ، جمع جرة ، وهو من الخزف ، معروف ، وقيل : هو ما كان منه مدهونا . خزايا : جمع خزيان ، من الخزاية ، وهي الاستحياء ، وكذلك ندامي جمع ندمان ، وهو فعلان من الندم ، وهذا البناء من ابنية المبالغة . شقة : يقال : بيني وبينك شقة بعيدة ، اي : مسافة بعيدة ، والشقة : السفر البعيد . فصل : امر فصل : اي : فاصل قاطع ، لا رجعة فيه ، ولا مرد له . الدباء : القرع ، واحدها : دباءة . الحنتم : جرار خضر كانوا يخزنون فيها الخمر . النقير : اصل خشبة تنقر ، وقيل : اصل نخلة . المزفت : الوعاء المطلي بالزفت من داخل ، وكذلك المقير ، وهذه الاوعية تسرع بالشدة في الشراب ، وتحدث فيه القوة المسكرة عاجلا . وتحريم الانتباذ في هذه الظروف كان في صدر الاسلام ، ثم نسخ وهو المذهب .  وقال بعضهم : التحريم باق ، واليه ذهب مالك ، واحمد بن حنبل .
  ( ت ) علي بن ابي طالب  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( لا يءمن عبد حتي يءمن باربع : يشهد ان لا اله الا الله ، واني محمد رسول الله ، بعثني بالحق ، ويءمن بالموت ، ويءمن بالبعث بعد الموت ، ويءمن بالقدر ) . اخرجه الترمذي .
  ( ط ) عبيد الله بن عبد الله بن عتبة بن مسعود  رضي الله عنه  قال : ان رجلا من الانصار جاء الي رسول الله  صلي الله عليه وسلم  بجارية له سوداء ، فقال : يا رسول الله ، [ ان ] علي رقبة مءمنة ، افاعتق هذه ؟ فقال لها رسول الله  صلي الله عليه وسلم  : ( اتشهدين ان لا اله الا الله ) ؟ قالت : نعم ، قال : ( اتشهدين ان محمدا رسول الله ) ؟ قالت : نعم . قال : ( اتءمنين بالبعث بعد الموت ؟ ) قالت : نعم ، قال رسول الله  صلي الله عليه وسلم  : ( اعتقها ) اخرجه ( الموطا ) .
  ( د س ) الشريد بن سويد الثقفي  رضي الله عنه  قال : ان امه اوصته ان يعتق عنها رقبة مءمنة ، فاتي رسول الله  صلي الله عليه وسلم  ، فقال :  يا رسول الله ، ان امي اوصت ان اعتق عنها رقبة مءمنة ، وعندي جارية سوداء نوبية ، افاعتقها ؟ فقال رسول الله  صلي الله عليه وسلم  : ( ادع بها ) . فدعوتها ، فجاءت ، فقال لها النبي  صلي الله عليه وسلم  : ( من ربك ) ؟ قالت : الله ، قال : ( فمن انا ) ؟ قالت : رسول الله ، قال : ( اعتقها ، فانها مءمنة ) . اخرجه ابو داود والنساءي .
  ( م ط د س ) معاوية بن الحكم السلمي  رضي الله عنه  قال : اتيت رسول الله  صلي الله عليه وسلم  فقلت : يا رسول الله ، ان جارية كانت لي ، ترعي غنما لي ، فجءتها ، وقد فقدت شاة من الغنم ، فسالتها عنها ؟ فقالت : اكلها الذءب . فاسفت عليها ، وكنت من بني ادم ، فلطمت وجهها ، وعلي رقبة ، افاعتقها ؟ فقال لها رسول الله  صلي الله عليه وسلم  : ( اين الله ) فقالت : في السماء ، فقال : ( من انا ؟ ) فقالت : انت رسول الله . فقال رسول الله  صلي الله عليه وسلم  : ( اعتقها ) . هذا لفظ ( الموطا ) . وقد اخرجه مسلم ، وابو داود ، والنساءي ، في حديث طويل يتضمن ذكر الصلاة ، وهو مذكور في كتاب الصلاة ، من حرف الصاد ، وزاد في اخره ( فانها مءمنة ) .  واخرجه ابو داود ايضا مختصرا ، واول حديثه ، قال : قلت : يا رسول الله ، جارية لي صككتها صكة ، فعظم ذلك علي رسول الله  صلي الله عليه وسلم  قلت : افلا اعتقها ؟ . . . . وذكر الحديث . وكلهم اخرجوه عن معاوية بن الحكم السلمي ، الا مالكا ، فانه اخرجه عن هلال بن اسامة عن عطاء بن يسار عن عمر بن الحكم . قال بعض العلماء : هكذا قال مالك ( عمر بن الحكم ) ولم تختلف الرواة عنه في ذلك ، وهو وهم عند جميع اهل العلم ، وليس في الصحابة من يقال له : عمر ابن الحكم ، وانما هو معاوية بن الحكم . كذلك قال فيه كل من روي هذا الحديث عن هلال وغيره . واما ( عمر بن الحكم ) فهو من التابعين ، وهو عمر بن الحكم بن ابي الحكم ، من بني عمرو بن عامر ، وقيل : هو حليف لهم ، وكان من ساكني المدينة ، وتوفي سبع عشرة وماءة . * * * غريب الحديث * * * فاسفت : اسف الرجل ياسف اسفا ، فهو اسف : اذا غضب . رقبة : الرقبة في الاصل : العنق ، جعل عبارة عن ذات الانسان  الرقيق ، ذكرا كان او انثي . صككتها : الصك : الضرب ، اراد انه لطمها ، وقد جاء في بعض الروايات : ( فلطمتها ) .
  ( د ) ابو هريرة  رضي الله عنه  قال : ان رجلا اتي النبي  صلي الله عليه وسلم  بجارية سوداء ، فقال : يا رسول الله ، ان علي رقبة مءمنة ، فقال لها رسول الله  صلي الله عليه وسلم  : ( اين الله ) ؟ فاشارت الي السماء باصبعها ، فقال لها : ( فمن انا ) ؟ فاشارت الي النبي  صلي الله عليه وسلم  والي السماء  تعني : انت رسول الله  فقال : ( اعتقها ، فانها مءمنة ) اخرجه ابو داود . * * * غريب الحديث * * * فانها مءمنة : قال الخطابي : انما حكم بانها مءمنة بهذا القدر من قولها ، وهو انه لما سالها : اين الله ؟ قالت : في السماء ، وهذا القدر لا يكفي في ثبوت الاسلام والايمان ، دون الاقرار بالشهادتين ، والتبرء من ساءر الاديان ؛ لانه  صلي الله عليه وسلم  راي منها امارة الاسلام ، وانها في دار الاسلام ، وبين المسلمين ، وتحت رق المسلم ، وهذا القدر يكفي علما لذلك . الا تري انا اذا راينا رجلا وامراة مقيمين في بيت ، فسالناه عنها ، فقال : هي زوجتي ، وصدقته علي ذلك ، فاننا نقبل قولهما ، ولا نكشف عن امرهما  ولا نطلب منهما شراءط العقد ، فاذا جاءنا رجل وامراة اجنبيان ، يريدان ابتداء عقد النكاح ، فاننا نطالبهما بشروط النكاح ، من احضار الولي ، والشهود ، وغير ذلك ، وكذلك الكافر اذا عرض عليه الاسلام ، لم نقتصر منه علي قوله : اني مسلم ، حتي يصف الاسلام بكماله وشراءطه . واذا جاءنا من يجهل حاله في الكفر والايمان ، فقال : اني مسلم ، قبلناه ، فاذا كان عليه امارة الاسلام  من هيءة واشارة ودار  كان قبول قوله اولي ، بل يحكم عليه بالاسلام ، وان لم يقل شيءا .
  ( م ت ) العباس بن عبد المطلب  رضي الله عنه  قال : انه سمع رسول الله  صلي الله عليه وسلم  يقول : ( ذاق طعم الايمان من رضي بالله ربا ، وبالاسلام دينا وبمحمد رسولا ) . . اخرجه مسلم والترمذي .
  ( د ) عبد الله بن معاوية الغاضري  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( ثلاث من فعلهن فقد طعم طعم الايمان : من عبد الله وحده ، وعلم انه لا اله الا الله ، واعطي زكاة ماله طيبة بها نفسه رافدة عليه كل عام ، ولم يعط الهرمة ، لا الدرنة ولا المريضة ، ولا الشرط اللءيمة ، ولكن من وسط اموالكم ، فان الله لم يسالكم خيره . ولم يامركم بشره ) .  اخرجه ابو داود . * * * غريب الحديث * * * رافدة عليه : الرافدة : الفاعلة من الرفد ، وهي العطاء والاعانة ، اي : معينة له علي اداء الزكاة ، غير محدثة نفسه بمنعها ، فهي ترفده وتعينه . الهرمة : المسنة ، الكبيرة السن من كل حيوان . الدرنة : اراد بها : الرديءة ، فجعل الرداءة درنا ، والدرن : الوسخ . الشرط : الرذيلة من المال ، كالصغيرة ، والمسنة ، والعجفاء ، ونحو ذلك . اللءيمة : اردا المال وارذله .
  ( س ) بهز بن حكيم  رضي الله عنه  عن ابيه عن جده قال : قلت : يا نبي الله ، ما اتيتك حتي حلفت اكثر من عددهن  لاصابع يديه  : ان لا اتيك ، ولا اتي دينك ، واني كنت امرءا لا اعقل شيءا ، الا ما علمني الله ورسوله ، واني سالتك بوجه الله ، بم بعثك الله الينا ؟ قال : ( بالاسلام ) قال : وما ايات الاسلام ؟ قال : ( ان تقول : اسلمت وجهي لله ، وتخليت ، وتقيم الصلاة ، وتءتي الزكاة ) . زاد في اخري ( كل مسلم علي مسلم محرم ، اخوان نصيران ، لا يقبل عن مشرك بعد ما اسلم عمل ، او يفارق المشركين الي المسلمين ) . اخرجه  النساءي . * * * غريب الحديث * * * تخليت : تبرات من الشرك ، وانقطعت عنه . كل مسلم علي مسلم محرم : يقال : احرم الرجل : اذا اعتصم بحرمة تمنع عنه ، ويقال : انه لمحرم عنك : اي يحرم اذاك عليه ، ويقال : مسلم محرم ، وهو الذي لم يخل من نفسه شيءا يوقع به ، يريد : ان المسلم معتصم بالاسلام ، ممتنع بحرمته ممن اراده ، او اراد ماله . اخوان نصيران : اي هما اخوان نصيران ، اي : يتناصران ويتعاضدان ، والنصير : فعيل بمعني فاعل ، ويجوز ان يكون بمعني مفعول .
  ( م ) سفيان بن عبد الله الثقفي  رضي الله عنه  قال : قلت : يا رسول الله ، قل لي في الاسلام قولا لا اسال عنه احدا بعدك ، قال :  ( قل : امنت بالله ، ثم استقم ) . اخرجه مسلم .
  ( س ) انس بن مالك  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( من صلي صلاتنا ، واستقبل قبلتنا ، واكل ذبيحتنا فهو مسلم ) . اخرجه النساءي .
  ( الفصل الثاني ' في المجاز ' )
  ( خ م ت د س ) ابو هريرة  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( الايمان بضع وسبعون شعبة ) . وفي رواية ( بضع وستون ، والحياء شعبة من الايمان ) . زاد في رواية : ( وافضلها قول : لا اله الا الله ، وادناها : اماطة الاذي  عن الطريق ) . اخرجوه ، الا ( الموطا ) . واسقط الترمذي من روايته ( والحياء شعبة من الايمان ) . وعنده في اخري ( الايمان اربعة وستون بابا ) . وعند النساءي في رواية اخري ( الحياء شعبة من الايمان ) مختصرا . * * * غريب الحديث * * * بضع : البضع : القطعة من الشء ، وهو في العدد ما بين الثلاث الي التسع ؛ لانه قطعة من العدد . الحياء من الايمان : جعل الحياء  وهو غريزة  من الايمان  وهو اكتساب  ؛ لان المستحيي ينقطع باستحياءه عن المعاصي ، وان لم يكن له تقية ، فصار كالايمان الذي يقطع بينها وبينه ، وانما جعله بعضا من الايمان ؛ لان الايمان بمجموعه ينقسم الي اءتمار بما امر الله به ، وانتهاء عما نهي الله عنه ، فاذا حصل الانتهاء بالحياء كان بعضه  . الشعبة : الطاءفة من كل شء ، والقطعة منه . اماطة الاذي : اماط الشء : اذا ازاله عنه ، واذهبه ، والاذي في هذا الحديث ، نحو الشوك والحجر وما اشبهه .
  ( خ م ت س ) انس بن مالك  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( ثلاث من كن فيه وجد بهن طعم الايمان : من كان الله ورسوله احب اليه مما سواهما ، ومن احب عبدا لا يحبه الا لله ، ومن يكره ان يعود في الكفر  بعد ان انقذه الله منه  كما يكره ان يلقي في النار ) . وفي اخري ( من كان ان يلقي في النار احب اليه من ان يرجع يهوديا او نصرانيا . . ) اخرجه البخاري ومسلم والترمذي والنساءي . وللنساءي في رواية اخري : ( ثلاث من كن فيه وجد حلاوة الايمان  وطعمه : ان يكون الله احب اليه مما سواهما ، وان يحب في الله ، ويبغض في الله ، وان توقد نار عظيمة فيقع فيها احب اليه من ان يشرك بالله شيءا ) . * * * غريب الحديث * * * انقذه : الانقاذ : التخليص والانجاء .
  ( خ م س ) انس بن مالك  رضي الله عنه  قال : سمعت رسول الله  صلي الله عليه وسلم  يقول : ( لا يءمن احدكم حتي اكون احب اليه من والده وولده والناس اجمعين ) . اخرجه البخاري ومسلم والنساءي . وللنساءي في اخري ( حتي اكون احب اليه من ماله واهله والناس اجمعين ) .
  ( خ س ) ابو هريرة  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( والذي نفسي بيده ، لا يءمن احدكم حتي اكون احب اليه من ولده ووالده ) . اخرجه البخاري والنساءي . 
  ( خ م ت س ) انس بن مالك  رضي الله عنه  قال : سمعت رسول الله  صلي الله عليه وسلم  يقول : ( لا يءمن احدكم حتي يحب لاخيه ما يحب لنفسه ) . وفي اخري : ( حتي يحب لاخيه ) او قال : ( لجاره ) . وفي اخري قال : ( والذي نفسي بيده لا يءمن عبد . . . ) الحديث . اخرجه البخاري ومسلم . ووافقهما الترمذي والنساءي علي الرواية الاولي . والنساءي علي الثالثة ، وزاد ( من الخير ) .
  ( د ) ابو امامة الباهلي  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  قال : ( من احب لله ، وابغض لله ، واعطي لله ومنع لله ، فقد استكمل الايمان ) . اخرجه ابو داود . 
  ( ت ) معاذ بن انس الجهني  رضي الله عنه  ان النبي  صلي الله عليه وسلم  قال : ( من اعطي لله ، ومنع لله ، واحب لله ، وابغض لله ، فقد استكمل ايمانه ) اخرجه الترمذي . وقال : هذا حديث منكر .
  ( ت س ) ابو هريرة  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( المسلم من سلم المسلمون من لسانه ويده ، والمءمن : من امنه الناس علي دماءهم واموالهم ) . اخرجه الترمذي والنساءي .
  ( خ م د س ) عبد الله بن عمرو بن العاص  رضي الله عنهما  ان رسول الله  صلي الله عليه وسلم  قال : ( المسلم : من سلم المسلمون من لسانه ويده ، والمهاجر  من هجر ما نهاه الله عنه ) . هذا لفظ البخاري وابي داود والنساءي . الا ان النساءي قال : ( من هجر ما حرم الله عليه ) . واخرجه مسلم فقال : ان رجلا سال النبي  صلي الله عليه وسلم  : اي المسلمين خير ؟ قال : ( من سلم المسلمون من لسانه ويده ) . * * * غريب الحديث * * * المهاجر : اصل المهاجرة عند العرب : ان ينتقل الانسان من البادية الي المدن والقري . والمراد به في الشريعة : من فارق اهله ووطنه وجاء الي بلد الاسلام ، وقصد النبي  صلي الله عليه وسلم  رغبة فيه وايثارا .
  ( م ) جابر بن عبد الله  رضي الله عنهما  قال : انه سمع رسول الله  صلي الله عليه وسلم  يقول : ( المسلم من سلم المسلمون من لسانه ويده ) . اخرجه مسلم .
  ( خ م ت س ) ابو موسي الاشعري  رضي الله عنه  قال : قلت : يا رسول الله ، اي المسلمين افضل ؟ قال : ( من سلم المسلمون من لسانه  ويده ) . اخرجه البخاري ومسلم والترمذي والنساءي .
  ( خ م س ) عبد الله بن عمرو بن العاص  رضي الله عنهما  ان رجلا سال النبي  صلي الله عليه وسلم  ، قال : اي الاسلام خير ؟ قال : ( تطعم الطعام ، وتقرا السلام علي من عرفت ومن لم تعرف ) . اخرجه البخاري ومسلم والنساءي .
  ( ت ) ابو سعيد الخدري  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  قال : ( اذا رايتم الرجل يعتاد المسجد ، فاشهدوا له بالايمان ، فان الله عز وجل يقول : { انما يعمر مساجد الله من امن بالله واليوم الاخر . . . } الاية [ التوبة : الاية  ] . ) اخرجه الترمذي .
  ( د ) انس  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  قال : ( ثلاثة من اصل الايمان : الكف عمن قال : لا اله الا الله ، ولا نكفره بذنب ، ولا  نخرجه من الاسلام بعمل ، والجهاد ماض منذ بعثني الله الي ان يقاتل اخر هذه الامة الدجال ، لا يبطله جور جاءر ولا عدل عادل ، والايمان بالاقدار ) . اخرجه ابوداود .
  ( م د ) ابو هريرة  رضي الله عنه  قال : جاء ناس من اصحاب رسول الله  صلي الله عليه وسلم  ، الي النبي  صلي الله عليه وسلم  ، فسالوه : انا نجد في انفسنا ما يتعاظم احدنا ان يتكلم به ؟ قال : ( وقد وجدتموه ؟ ) قالوا : نعم ، قال : ( ذاك صريح الايمان ) . وفي اخري ( الحمد لله الذي رد كيده الي الوسوسة ) . اخرجه مسلم وابو داود .
  ( م ) عبد الله بن مسعود  رضي الله عنه  قال : سءل رسول الله  صلي الله عليه وسلم  عن الوسوسة ؟ فقال : ( تلك محض الايمان ) .  وفي رواية قال : سءل رسول الله  صلي الله عليه وسلم  عن الوسوسة ؟ فقالوا : ان احدنا ليجد في نفسه ما لان يحترق حتي يصير حممة ، او يخر من السماء الي الارض ، احب اليه من ان يتكلم به ؟ قال : ( ذلك محض الايمان ) . اخرجه مسلم . * * * غريب الحديث * * * محض : المحض : الخالص من كل شء ، وكذلك الصريح مثله ، ومنه الصريح الظاهر : وهو ضد الكناية ، وانما قال في هذا الحديث : ( ذاك صريح الايمان ) يعني ان صريح الايمان : هو الذي يمنعكم من قبول ما يلقيه الشيطان في انفسكم ، والتصديق به ، حتي يصير ذلك وسوسة ، لا تتمكن في قلوبكم ، ولا تطمءن اليه نفوسكم ، وليس معناه : ان الوسوسة نفسها صريح الايمان ، لانها انما تتولد من فعل الشيطان وتسويله ، فكيف تكون ايمانا صريحا ؟ ! . حممة : الحممة : الفحمة ، وجمعها : حمم . يخر : خر يخر : اذا وقع من موضع عال . 
  الباب الثاني ' في احكام الايمان والاسلام ' ' وفيه ثلاثة فصول '

  ( الفصل الاول في حكم الاقرار بالشهادتين )
  ( خ م ) عبد الله بن عمر  رضي الله عنهما  قال : قال رسول الله  صلي الله عليه وسلم  : ( امرت ان اقاتل الناس حتي يشهدوا ان لا اله الا الله ، ان محمدا رسول الله ، ويقيموا الصلاة ، ويءتوا الزكاة ، فاذا فعلوا ذلك عصموا مني دماءهم ، الا بحق الاسلام ، وحسابهم علي الله ) . اخرجه البخاري ومسلم ، الا ان مسلما لم يذكر ( الا بحق الاسلام ) . * * * غريب الحديث * * * عصموا : العصمة : المنع ، والعصمة من الله تعالي : ان يدفع الشر عن العبد . 
  ( خ م ت د س ) ابو هريرة  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( امرت ان اقاتل الناس حتي يقولوا : لا اله الا الله ، فمن قال : لا اله الا الله ، فقد عصم مني نفسه وماله الا بحقه ، وحسابه علي الله ) . وفي رواية ( حتي يشهدوا ان لا اله الا الله ، ويءمنوا بي وبما جءت به ، فاذا فعلوا ذلك عصموا مني دماءهم واموالهم الا بحقها ، وحسابهم علي الله ) . هذه رواية البخاري ومسلم والنساءي . ورواية الترمذي وابي داود ( امرت ان اقاتل الناس حتي يقولوا : لا اله الا الله ، فاذا قالوها عصموا . . . ) الحديث . وقال ابو داود : ( منعوا مني دماءهم واموالهم الا بحقها وحسابهم علي الله ) . مثل حديث ابي هريرة .
  ( م ت ) جابر  رضي الله عنه  زيادة في اخره ، وقرا :  { انما انت مذكر * لست عليهم بمسيطر } [ الغاشية : الاية  ،  ] . واخرجه الترمذي ومسلم من حديث جابر . * * * غريب الحديث * * * المسيطر : المتسلط علي الشء ليتعهد احواله ، ويكتب اعماله ، ويشرف عليه ، واصله من السطر : الكتابة .
  ( خ ت د س ) انس  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  قال : ( امرت ان اقاتل الناس حتي يقولوا : لا اله الا الله ، وان محمدا رسول الله ، فاذا شهدوا ان لا اله الا الله وان محمدا رسول الله ، واستقبلوا قبلتنا ، واكلوا ذبيحتنا ، وصلوا صلاتنا ، حرمت علينا دماءهم واموالهم الا بحقها ) . زاد في رواية : ( وحسابهم علي الله ) . وفي اخري قال : سال ميمون بن سياه انسا : ما يحرم دم العبد وماله ؟ قال : ( من شهد ان لا اله الا الله ، واستقبل قبلتنا ، وصلي صلاتنا ، واكل ذبيحتنا ، فهو المسلم ، له ما للمسلم ، وعليه ما علي المسلم ) . موقوف ، هذا لفظ البخاري ، ووافقه الترمذي علي الاولي ، والنساءي علي الروايتين ، وابو داود والنساءي ايضا علي الاولي . وزاد فيها  بعد قوله  ( بحقها )  : ( لهم ما للمسلمين ، وعليهم ما علي المسلمين ) .
  ( س ) النعمان بن بشير  رضي الله عنهما  قال : كنا مع النبي  صلي الله عليه وسلم  فجاءه رجل ذات يوم ، فساره ، فقال : ( اقتلوه ) ، ثم قال : ( ايشهد ان لا اله الا الله ؟ ) قال : قالوا : نعم ، ولكنه يقولها تعوذا ، فقال رسول الله  صلي الله عليه وسلم  : ( لا تقتلوه ، فاني انما امرت ان اقاتل الناس حتي يقولوا : لا اله الا الله ، فاذا قالوها عصموا مني دماءهم واموالهم الا بحقها ، وحسابهم علي الله ) . اخرجه النساءي . * * * غريب الحديث * * * تعوذا : تعوذت به ، واستعذت به ، اي : لجات اليه ، واعتصمت به ، والمراد في الحديث : انه يقر بالشهادة لاجءا اليها ، لتدفع عنه القتل ، وليس بمخلص ، فلذلك قال له النبي  صلي الله عليه وسلم  : ( ذره ) اي اتركه ودعه .
  ( س ) اوس بن حذيفة  رضي الله عنه  قال : اتيت رسول الله  صلي الله عليه وسلم  في وفد ثقيف ، فكنت معه في قبة ، فنام من كان في القبة ، غيري وغيره ، فجاء رجل فساره ، فقال : اذهب فاقتله . ثم قال : ايشهد  ان لا اله الا الله ، واني رسول الله ؟ قال : انه يقولها ، فقال رسول الله  صلي الله عليه وسلم  : ( ذره ) . ثم قال : ( امرت ان اقاتل الناس حتي يقولوا : لا اله الا الله ، فاذا قالوها ، حرمت دماءهم واموالهم الا بحقها ) . وفي اخري : دخل علينا رسول الله  صلي الله عليه وسلم  ، ونحن في قبة في مسجد المدينة ، وقال : ( انه اوحي الي ان اقاتل الناس حتي يقولوا : لا اله الا الله ) . وذكر نحوه . اخرجه النساءي .
  ( ط ) عبيد الله بن عدي بن الخيار  رضي الله عنه  قال : بينما رسول الله  صلي الله عليه وسلم  ، جالس بين ظهري الناس ، اذ جاءه رجل ، فساره ، فلم ندر ما ساره ، حتي جهر رسول الله  صلي الله عليه وسلم  ، فاذا هو يستاذنه في قتل رجل من المنافقين ، فقال رسول الله  صلي الله عليه وسلم  ، حين جهر : ( اليس يشهد ان لا اله الا الله ، وان محمدا رسول الله ؟ ) فقال الرجل : بلي ! ولا شهادة له ، قال : ( اليس يصلي ؟ ) قال : بلي ! ولا صلاة له ، قال رسول الله  صلي الله عليه وسلم  : ( اولءك الذين نهاني الله عن قتلهم ) . اخرجه ( الموطا ) .
  ( م ) طارق الاشجعي  رضي الله عنه  قال : سمعت رسول  الله  صلي الله عليه وسلم  يقول : ( من قال : لا اله الا الله ، وكفر بما يعبد من دون الله ، حرم ماله ودمه ، وحسابه علي الله ) . وفي رواية ( من وحد الله ) وذكر مثله . اخرجه مسلم .
  ( الفصل الثاني في احكام البيعة )
  ( خ م ت س ) عبادة بن الصامت  رضي الله عنه  قال : ( كنا مع رسول الله في مجلس ، فقال : ( تبايعوني علي الا تشركوا بالله شيءا ، ولا تسرقوا ، ولا تزنوا ، ولا تقتلوا النفس التي حرم الله الا بالحق ) . وفي رواية : ( ولا تقتلوا اولادكم ، ولا تاتوا ببهتان تفترونه بين ايديكم وارجلكم ، ولا تعصوني في معروف ، فمن وفي منكم فاجره علي الله ، ومن اصاب شيءا من ذلك فعوقب به في الدنيا فهو كفارة له وطهر ، ومن اصاب شيءا من ذلك فستره الله عليه ، فامره الي الله ، ان شاء عفا عنه ، وان شاء عذبه ) . قال : فبايعناه علي ذلك . وفي اخري ، فتلا علينا اية النساء : { الا يشركن بالله شيءا . . . } الاية [ الممتحنة : الاية  ] . وفي اخري : اني لمن النقباء ، الذين بايعوا رسول الله  صلي الله عليه وسلم  ، بايعناه  علي الا نشرك بالله شيءا ، وذكر نحوه . وزاد : ( ولا ننتهب ولا نعصي بالجنة ، ان فعلنا ذلك ، فان غشينا من ذلك شيءا ، كان قضاء ذلك الي الله عز وجل ) . هذا لفظ البخاري ومسلم . وفي رواية لمسلم قال : اخذ علينا رسول الله  صلي الله عليه وسلم  ، كما اخذ علي النساء : الا نشرك بالله شيءا ، ولا نسرق ، ولا نزني ، ولا نقتل اولادنا ، ولا يعضه بعضنا بعضا ) ثم ذكر نحوه ، ووافقهما الترمذي علي الرواية الاولي . واخرجه النساءي . قال : بايعت رسول الله  صلي الله عليه وسلم  [ ليلة العقبة ] في رهط ، فقال : ( ابايعكم علي الا تشركوا بالله شيءا ، ولا تسرقوا ، ولا تزنوا ، [ ولا تشربوا ] ، ولا تقتلوا اولادكم ، ولا تاتوا ببتهان تفترونه بين ايديكم وارجلكم ، ولا تعصوني في معروف ، فمن وفي منكم فاجره علي الله ، ومن اصاب من ذلك شيءا فاخذ به في الدنيا ، فهو كفارة له وطهور ، ومن ستره الله ، فذلك الي الله ، ان شاء عذبه ، وان شاء غفر له  ) . وله في اخري نحو الرواية الاولي . * * * غريب الحديث * * * بهتان : البهتان : الكذب ، وهو في الاية والحديث : كناية عن ولد الزنا ، يريد : ان المراة لا تاتي بولد من غير بعلها ، فتنسبه الي بعلها . تفترونه : الافتراء : الكذب . معروف : كل ما ندب اليه الشرع ، او نهي عنه من المحسنات والمقبحات . البيعة : المعاقدة علي الاسلام ، والامامة ، والامارة ، والمعاهدة علي كل ما يقع عليه اتفاق ، والمراد بها في الحديث : المعاقدة علي الاسلام ، واعطاء العهود به . النقباء : جمع نقيب ، وهو عريف القوم والمقدم عليهم ، الذي يتعرف اخبارهم ، وينقب عن احوالهم ، وكان النبي  صلي الله عليه وسلم  قد جعل ليلة العقبة كل واحد من الجماعة الذين بايعوه نقيبا علي قومه وجماعته ، لياخذوا  عليهم الاسلام ، ويعرفوهم شراءطه ، وكان عبادة بن الصامت من جملتهم ، وكان عدد النقباء ليلتءذ اثني عشر نقيبا من الانصار . يعضه : عضهت الرجل : رميته بالعضيهة ، وهي الكذب والبهتان . العقبة : هي عقبة مني ترمي بها الحجرة في الحج ، وهما ليلتان : ليلة العقبة الاولي ، وليلة العقبة الثانية من قابل ، وكانت البيعة في شعب قريب من العقبة ، وبه الان مسجد يعرف بموضع البيعة . الرهط : الجماعة من الناس ، من الثلاثة الي التسعة ، قال الجوهري : لا تكون فيهم امراة . فاخذ به : اخذ به فلان ، يعني بذنبه : اي عوقب به وجوزي عليه . الكفارة : الفعلة التي من شانها ان تكفر الخطيءة ، اي تسترها ، وهي فعالة منه .
  ( خ م ط س ) عبادة بن الصامت  رضي الله عنه  قال : بايعنا رسول الله  صلي الله عليه وسلم  علي السمع والطاعة ، في العسر واليسر ، والمنشط ، والمكره وعلي اثرة علينا ، وعلي الا ننازع الامر اهله ، وعلي ان نقول بالحق اينما كنا لا نخاف في الله لومة لاءم . وفي رواية بمعناه ، وفيه ( ولا ننازع الامر اهله ) . قال : ( الا ان تروا كفرا بواحا ، عندكم فيه من الله برهان ) .  واخرجه البخاري ومسلم و ( الموطا ) والنساءي . * * * غريب الحديث * * * المنشط : الامر الذي تنشط له ، وتخف اليه ، وتءثر فعله . المكره : الامر الذي تكرهه ، وتتثاقل عنه . الاثرة : الاستءثار بالشء ، والانفراد به ، والمراد في الحديث : ان منعنا حقنا من الغناءم ، والفء ، واعطي غيرنا ، نصبر علي ذلك . كفرا بواحا : الكفر البواح : الجهار . البرهان : الحجة والدليل .
  ( م د س ) ابو ادريس الخولاني  رضي الله عنه  قال : ( حدثني الحبيب الامين  اما هو فحبيب الي ، واما هو عندي فامين  عوف بن مالك الاشجعي ، قال : كنا عند رسول الله  صلي الله عليه وسلم  تسعة ، او ثمانية ، او سبعة ، فقال : الا تبايعون رسول الله ؟ ) وكنا حديث عهد ببيعة ، فقلنا : قد بايعناك يا رسول الله ، ثم قال : ( الا تبايعون رسول الله ؟ قال : فبسطنا ايدينا ، وقلنا : قد بايعناك يا رسول الله ، فعلام نبايعك ؟ قال : ( ان تعبدوا  الله ولا تشركوا به شيءا ، وتصلوا الصلوات الخمس ، وتسمعوا وتطيعوا )  واسر كلمة خفية  قال : ( ولا تسالوا الناس شيءا ) . فلقد رايت بعض اولءك النفر يسقط سوط احدهم ، فما يسال احدا يناوله اياه ) . واخرجه مسلم وابو داود والنساءي ، الا ان لفظ النساءي اخصر .
  ( ط ت س ) اميمة بنت رقيقة  رحمها الله  قالت : اتيت رسول الله  صلي الله عليه وسلم  في نسوة من الانصار ، نبايعه علي الاسلام ، فقلنا : نبايعك علي الا نشرك بالله شيءا ، ولا نسرق ، ولا نزني ، ولا نقتل اولادنا ، ولا ناتي ببهتان نفتريه بين ايدينا وارجلنا ، ولا نعصيك في معروف ، فقال رسول الله  صلي الله عليه وسلم  : ( فيما استطعتن واطقتن ) . فقلنا : ( الله ورسوله ارحم بنا منا بانفسنا ، هلم نبايعك يا رسول الله ، فقال : اني لا اصافح النساء ، انما قولي لماءة امراة كقولي لامراة واحدة ) . هذه رواية ( الموطا ) والنساءي . ورواية الترمذي مختصرة ، قالت : بايعت رسول الله  صلي الله عليه وسلم  في نسوة فقال : ( فيما استطعتن واطقتن ) . قلت : الله ورسوله ارحم بنا من انفسنا ، قلت : يا رسول الله : يايعنا  قال سفيان : تعني صافحنا  فقال رسول الله   صلي الله عليه وسلم  : ( انما قولي لماءة امراة كقولي لامراة واحدة ) . ( سقط ) * * [ شرح الغريب : ] * *  ( هلم ) بمعني تعال وهات ، وفيها لغتان ، فاهل الحجاز يسوون فيها بين المذكر والمءنث ، والواحد والاثنين والجمع ، بصيغة واحدة ، مبنية علي الفتح ، وبنو تميم يلحقونها علامة ما اقترنت به ، فيقولون هلما ، وهلمي ، وهلموا
  ( خ م د ت س ) عبد الله بن عمر  رضي الله عنهما  قال : كنا اذا بايعنا رسول الله  صلي الله عليه وسلم  علي السمع والطاعة يقول لنا : ( فيما استطعت  او قال : استطعتم ) . اتفق الستة علي اخراجه .
  ( خ م ) مجاشع بن مسعود  رضي الله عنه  قال : انه جاء باخيه مجالد بن مسعود الي النبي قال رسول الله  صلي الله عليه وسلم  فقال : هذا مجالد ، يبايعك علي الهجرة ، فقال : ( لا هجرة بعد فتح مكة ، ولكن ابايعه علي الاسلام والايمان والجهاد ) .  وفي اخري ( ولكن ابايعه علي الاسلام ) . وفي اخري : قال : اتيت النبي  صلي الله عليه وسلم  انا واخي ، فقلت : بايعنا علي الهجرة . فقال : ( مضت الهجرة لاهلها ) فقلت : علام تبايعنا ؟ قال : ( علي الاسلام والجهاد ) . وفي اخري : قال : اتيت النبي  صلي الله عليه وسلم  ابايعه علي الهجرة ، فقال : ( ان الهجرة قد مضت لاهلها ، ولكن علي الاسلام والجهاد والخير ) . اخرجه البخاري ومسلم .
  ( س ) الهرماس بن زياد  رضي الله عنه  قال : ( مددت يدي الي رسول الله  صلي الله عليه وسلم  وانا غلام ليبايعني ، فلم يبايعني ) ، اخرجه النساءي .
  ( د ) عبد الله بن هشام  رضي الله عنه  وكان قد ادرك النبي  صلي الله عليه وسلم  ، وذهبت به امه زينب بنت حميد الي رسول الله  صلي الله عليه وسلم   فقالت : يا رسول الله بايعه ، فقال رسول الله  صلي الله عليه وسلم  : ( هو صغير ، ومسح راسه ) . اخرجه ابو داود .
  ( خ م د ) عروة بن الزبير  رضي الله عنهما  ان عاءشة  رضي  الله عنها  اخبرته عن بيعة النساء قالت : ما مس رسول الله  صلي الله عليه وسلم  بيده امراة قط ، الا ان ياخذ عليها ، فاذا اخذ عليها واعطته ، قال : ( اذهبي ، فقد بايعتك ) . اخرجه البخاري ومسلم وابو داود .
  ( الفصل الثالث في احكام متفرقة )
  ( ت ) سليمان بن عمرو بن الاحوص  رحمه الله  قال : حدثني ابي : انه شهد حجة الوداع مع رسول الله  صلي الله عليه وسلم  ، فحمد الله واثني عليه ، وذكر ووعظ ، ثم قال : ( اي يوم احرم ؟ اي يوم احرم ؟ اي يوم احرم ؟ ) قال : فقال الناس : يوم الحج الاكبر يا رسول الله ، قال : ( فان دماءكم واموالم واعراضكم عليكم حرام كحرمة يومم هذا ، في بلدكم هذا ، في  شهركم هذا ، الا لا يجني جان الا علي نفسه ، ولا يجني والد علي ولده ، ولا يجني ولد علي والده الا ان المسلم اخو المسلم ، فليس يحل لمسلم من اخيه شء الا ما احل من نفسه . الا وان كل ربا في الجاهلية موضوع ، لكم رءوس اموالكم لا تظلمون ولا تظلمون ، غير ربا العباس ، فانه موضوع كله ، الا وان كل دم كان في الجاهلية موضوع ، واول دم اضع من دم الجاهلية : دم الحارث بن عبد المطلب ، وكان مسترضعا في بني ليث ، فقتلته هذيل ، الا واستوصوا بالنساء خيرا ، فانهن عوان عندكم ، ليس تملكون شيءا غيرذلك ، الا ان ياتين بفاحشة مبينة ، فان فعلن ذلك فاهجروهن في المضاجع ، واضربوهن ضربا غير مبرح ، فان اطعنكم فلا تبغوا عليهن سبيلا ، الا وان لكم علي نساءكم حقا ، ولنساءكم عليكم حقا ، فاما حقكم علي نساءكم ، فلا يوطءن فرشكم من تكرهون ، ولا ياذن في بيوتكم لمن تكرهون ، الا وان حقهن عليكم : ان تحسنوا اليهن في كسوتهن وطعامهن ) . وفي رواية قال : سمعت رسول الله  صلي الله عليه وسلم  يقول في حجة الوداع للناس : ( اي يوم هذا ؟ ) قالوا : يوم الحج الاكبر ، قال : ( فان دماءكم واموالكم واعراضكم بينكم حرام كحرمة يومكم هذا ، الا لا يجني جان علي ولده ، ولا مولود علي والده ، الا وان الشيطان قد ايس ان يعبد في  بلدكم هذا ابدا ، ولكن سيكون له طاعة فيما تحتقرون من اعمالكم ، فسيرضي به ) . اخرجه الترمذي . * * * غريب الحديث * * * الحج الاكبر : هو يوم النحر ، وقيل : يوم عرفة ، وانما سمي الحج الاكبر ؛ لانهم يسمون العمرة : الحج الاصغر . واعراضكم : الاعراض ، جمع عرض ، وهو النفس ، وقيل : الحسب . لا يجني جان : الجناية : الذنب ، وما يفعله الانسان مما يوجب عليه الجزاء ، اما في الدنيا واما في الاخرة ، فقوله  صلي الله عليه وسلم  : ( لا يجني جان الا علي نفسه ) يريد : انه لا يطالب بجنايته غيره ، من اقاربه واباعده ، وقد فسره في الحديث بقوله : ( لا يجني ولد علي والده ، ولا يجني والد علي ولده ) اي اذا جني احدهما ، لا يطالب الاخر بجنايته ، وقد كان ذلك معتادا بين العرب . عوان : جمع عانية ، وهي مءنثة العاني ، وهو الاسير ، شبه النساء بالاسري عند الرجال ، لتحكمهم فيهن ، واستيلاءهم عليهن . بفاحشة : الفاحشة : الفعلة القبيحة ، واراد هاهنا الزنا . مبينة  : ظاهرة واضحة . مبرح : ضربته ضربا مبرحا ، اي : شديدا شاقا . فلا تبغوا عليهن سبيلا : اي ان اطعنكم فيما تريدون منهن ، فلا يبقي لكم عليهن طريق ولا حكم فيما عداه ، الا ان يكون جورا وتعسفا .
  ( خ م ) عبد الله بن عمر  رضي الله عنهما  قال : ( قال رسول الله  صلي الله عليه وسلم  في حجة الوداع : ( الا اي شهر تعلمونه اعظم حرمة ؟ ) قالوا : الا شهرنا هذا ، قال : ( الا اي بلد تعلمونه اعظم حرمة ؟ ) قالوا : الا بلدنا هذا ، قال : ( الا اي يوم تعلمونه اعظم حرمة ؟ ) قالوا : الا يومنا هذا . قال : ( فان الله تبارك وتعالي قد حرم عليكم دماءكم واموالكم واعراضكم الا بحقها كحرمة يومكم هذا في بلدكم هذا ، في شهركم هذا ، الا هل بلغت ؟ ) ثلاثا  كل ذلك يجيبونه : الا نعم ، قال : ويحكم ،  او ويلكم  لا ترجعن بعدي كفارزا يضرب بعضكم رقاب بعض ) .  اخرجه البخاري ، لمسلم نحوه .
  ( خ ) عبد الله بن عباس  رضي الله عنهما  ان رسول الله  صلي الله عليه وسلم   خطب الناس يوم النحر فقال : ( يا ايها الناس ، اي يوم هذا ؟ ) قالوا : يوم حرام ، قال : ( واي بلد هذا ؟ ) قالوا : بلد حرام ، قال : ( فاي شهر هذا ؟ ) قالوا : شهر حرام ، قال : ( فان دماءكم واموالكم واعراضكم عليكم حرام ، كحرمة يومكم هذا ، في بلدكم هذا ، في شهركم هذا )  فاعادها مرارا  ثم رفع راسه فقال : ( اللهم هل بلغت ؟ اللهم هل بلغت ) قال ابن عباس : فوالذي نفسي بيده انها لوصيته الي امته ، ( فليبلغ الشاهد الغاءب ، لا ترجعوا بعدي كفارا يضرب بعضكم رقاب بعض ) . اخرجه البخاري .
  ( خ م د ) ابو بكرة  رضي الله عنه  ان النبي  صلي الله عليه وسلم  قال : ( ان الزمان قد استدار كهياته يوم خلق الله السموات والارض ، السنة اثنا عشر شهرا منها : اربعة حرم ، ثلاثة متواليات : ذو القعدة ، وذو الحجة والمحرم ، ورجب مضر الذي بين جمادي وشعبان ، اي شهر هذا ؟ ) قلنا : الله ورسوله اعلم ، فسكت حتي ظننا انه سيسميه بغير اسمه ، فقال : ( اليس ذا الحجة ؟ ) قلنا : بلي ، قال : ( اي بلد هذا ؟ ) قلنا : الله ورسوله اعلم ، فسكت حتي ظننا انه سيسميه بغير اسمه ، قال : ( اليس البلدة الحرام ؟ ) قلنا : بلي ، قال : ( فاي يوم هذا ؟ ) قلنا : الله ورسوله اعلم ، فسكت حتي ظننا انه سيسميه بغير اسمه ، قال : ( اليس يوم النحر ؟ ) قلنا : بلي ، قال : ( فان دماءكم واموالكم واعراضكم عليكم حرام ، كحرمة يومكم هذا ،  في بلدكم هذا ، في شهركم هذا ، وستلقون ربكم فيسالكم عن اعمالكم الا فلا ترجعوا بعدي كفارا ، يضرب بعضكم رقاب بعض ، الا ليبلغ الشاهد الغاءب ، فلعل بعض من يبلغه ان يكون اوعي من بعض من سمعه ) ثم قال : ( الا هل بلغت ؟ الا هل بلغت ؟ ) قلنا : نعم ! قال : ( اللهم اشهد ) . وفي رواية : ان النبي  صلي الله عليه وسلم  قعد علي بعيره ، وامسك انسان بخطامه ، او بزمامه ، فقال : ( اي شهر هذا ؟ )  وذكر نحوه مختصرا  اخرجه البخاري ومسلم . وزاد مسلم في رواية ( ثم انكفا الي كبشين املحين ، فذبحهما ، والي جزيعة من الغنم فقسمها بيننا ) . واخرج ابو داود طرفا من اوله ، الي قوله ( بين جمادي وشعبان ) . قال الحميدي : قال الدارقطني : زيادة مسلم وهم من ابن عون عن ابن سيرين ، وانما رواه ابن سيرين عن انس . وزاد في رواية ( فلما كان يوم حرق ابن الحضرمي ، حين حرقه جارية  بن قدامة ، قال : اشرفوا علي ابي بكرة ، فقالوا : هذا ابو بكرة يراك ، قال عبد الرحمن : فحدثتني امي عن ابي بكرة انه قال : لو دخلوا علي ما بهشت لهم بقصبة ) . ووجدت في كتاب رزين بن معاوية العبدري  رحمه الله  ، الجامع لهذه الصحاح زيادة في اخر هذا الحديث لم اجدها في الاصول التي نقلت منها : وهي هذه : ( ثلاث لا يغل عليهن قلب مسلم ابدا : اخلاص العمل لله ، ومناصحة ولاة الامر ، ولزوم جماعة المسلمين ، فان دعوتهم تحيط من وارءهم ) .  * * * غريب الحديث * * * الزمان قد استدار : بمعني : دار ، وذلك ان العرب كانوا يءخرون المحرم الي صفر ، وهو النسء ، ويفعلون ذلك سنة بعد سنة ، فينتقل المحرم من شهر الي شهر ، حتي جعلوه في جميع شهور السنة ، فلما كان تلك السنة كان قد عاد الي زمنه المخصوص به قبل ان ينقلوه . رجب مضر : اضاف رجبا الي مضر ؛ لانهم كانوا يعظمونه ، فكانهم اختصوا به ، وقوله  صلي الله عليه وسلم  : ( الذي بين جمادي وشعبان ) ذكره تاكيدا للبيان وايضاحا ؛ لانهم كانوا ينسءونه ، ويءخرونه من شهر الي شهر ، فيحولونه عن موضعه ، فبين لهم ان رجبا هو الشهر الذي بين جمادي وشعبان ، لا ما كانوا يسمون علي حسب النسء . اوعي : وعي يعي : اذا حفظ ، واوعي افعل ، مثله . قوله : ( لا ترجعن بعدي كفارا يضرب بعضكم رقاب بعض ) قال  الهروي : قال الازهري : فيه قولان : احدهما : لابسين السلاح ، يقال : كفر فوق درعه : اذا لبس فوقها ثوبا ، والثاني : انه يكفر الناس فيكفر ، كما تفعله الخوارج اذا استعرضوا الناس ، وذلك كقوله عليه الصلاة والسلام : ( من قال لاخيه : يا كافر ، فقد باء به احدهما ) . الانكفاء : الرجوع الي الشء والميل اليه . املحين : الاملح من الغنم : النقي البياض ، وقيل : هو المختلط سواده وبياضه ، الا ان البياض فيه اكثر . جزيعة : القطعة من الغنم ، هكذا ذكره الجوهري ، وذكرها ابن فارس في المجمل : الجزيعة ، بفتح الجيم وكسر الزاي . بهشت : اذا ملت اليه ، واقبلت نحوه ، يقال لكل من نظر الي شء فمال اليه ، واعجبه : بهش اليه ، وقد يكون للمدافعة والذب ، والمراد به : ما دفعتهم بقصبة ، ولا قاتلتهم بها . لا يغل عليهن قلب مءمن : تروي هذه الكلمة بفتح الياء وكسر الغين ، وهو من الغل : الحقد والضغن ، يقول : لا يدخله شء من الحقد يزيله عن الحق ، ويروي بضم الياء وكسر الغين من الخيانة ، والاغلال : الخيانة في كل شء . وقوله : ( عليهن ) في موضع الحال ، اي : لا يغل كاءنا عليهن قلب  مءمن ، وانما انتصب علي النكرة لتقدمه ، والمعني : ان هذه الحلال المذكورة في الحديث ، تستصلح بها القلوب ، فمن تمسك بها ، طهر قلبه من الدغل والفساد .
  ( خ م ط ت د ) ابو هريرة  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( ما من مولود الا يولد علي الفطرة ) ثم يقول : ( اقرءوا { فطرة الله التي فطر الناس عليها ، لا تبديل لخلق اله ، ذلك الدين القيم } [ الروم : الاية  ] ) كذا عند مسلم . وزاد البخاري : فابواه يهودانه ، او ينصرانه ، او يمجسانه ، كما تنتج البهيمة بهيمة جمعاء ، هل تحسون فيها من جدعاء ، ثم يقول ابو هريرة :  { فطرة الله التي فطر الناس عليها ، لا تبديل لخلق الله ، ذلك الدين القيم } . وزاد مسلم ايضا من رواية اخري . وفي رواية لهما قال : ( ما من مولود الا يولد علي الفطرة ، فابواه يهودانه وينصرانه ، كما تنتجون الابل ، فهل تجدون فيها جدعاء ، حتي تكونوا انتم تجدعونها ) قالوا : يا رسول الله ، افرايت من يموت صغيرا ؟ قال : ( الله اعلم بما كانوا عاملين ) . وفي اخري لمسلم : ( ما من مولود الا يولد علي الفطرة ، فابواه يهودانه وينصرانه ، ويشركانه ) . فقال رجل : يا رسول الله ، ارايت لو مات قبل ذلك ؟ قال : ( الله اعلم بما كانوا عاملين ) . وفي اخري : ( ما من مولود يولد الا وهو علي الملة ) . زاد في اخري ( علي الملة ، حتي يبين عنه لسانه ) . هذه هي طرق البخاري ومسلم .  ووافقهما الموطا والترمذي وابو داود نحو ذلك وبمعناه . * * * غريب الحديث * * * الفطرة : الخلقة ، اراد بقوله : ( كل مولود يولد علي الفطرة ) اي يولد علي ابتداء الخلقة في علم الله تعالي مءمنا او كافرا ، وقيل : يولد علي الخلقة التي فطر عليها في الرحم : من سعادة ، او شقاوة ، فابواه يهودانه ، يعني في حكم الدنيا ، وقيل : كل مولود يولد علي الملة الاسلامية ، والدين الحق ، وانما ابواه ينقلانه الي دينهما ، وقيل معناه : ان كل مولود من البشر انما يولد في مبدا الخلقة ، واصل الجبلة ، علي الفطرة السليمة ، والطبع المتهيء لقبول الدين الحق ، فلو ترك عليها لاستمر علي لزومها ، ولم يفارقها الي غيرها ؛ لان هذا الدين الحق حسنه موجود في النفوس ، وبشره في القلوب ، وانما يعدل عنه من يعدل الي غيره لافة من افات الشر والتقليد ، فلو سلم المولود من تلك الافات لم يعتقد غيره ، ثم تمثل باولاد اليهود والنصاري في اتباعهم لاباءهم ، والميل الي اديانهم فيزلون بذلك عن الفطرة السليمة . الدين القيم : المستقيم لا زيغ فيه ، ولا ميل عن الحق . تنتج : نتجت الناقة تنتج ، فهي منتوجة : اذا ولدت . جمعاء : الجمعاء من البهاءم وغيرها التي لم يذهب من بدنها شء . تحسون : احسست بالشء : اذا شعرت به وعلمته . جدعاء : اي : هل ترون فيها من جدعاء ؟ والجدعاء : المقطوعة الاذن  او الانف ، او الشفة ، او اليد ونحو ذلك . ومعني هذا الحديث : ان المولود يولد علي نوع من الجبلة ، وهي فطرة الله تعالي ، وكونه متهيءا لقبول الحقيقة طبعا وطوعا ، ولو خلته شياطين الانس والجن وما يختار ، لم يختر الا اياها ، وضرب لذلك  الجمعاء والجدعاء  مثلا ، يعني : ان البهيمة تولد سوية الاطراف ، سليمة من الجدع ونحوه ، لولا الناس وتعرضهم اليها ، لبقيت كما ولدت سليمة . وقوله : ( الله اعلم بما كانوا عاملين ) اشارة الي تعلق المثوبة والعقوبة بالعمل .
  ( الباب الثالث في احاديث متفرقة ، تتعلق بالايمان والاسلام )
  ( خ م ت ) ابو هريرة  رضي الله عنه  : قال : قال رسول الله  صلي الله عليه وسلم  : ( مثل المءمن كمثل خامة الزرع ، من حيث اتتها الريح تفيءها ، فاذا اعتدلت تلقي بالبلاء ، والفاجر كالارزة صماء معتدلة ، حتي يقصمها الله اذا شاء ) . وفي اخري : ( مثل المءمن مثل الزرع ، لا تزال الريح تميله ، ولا يزال المءمن يصيبه البلاء ، ومثل المنافق كمثل شجرة الارز لا تهتز حتي تستحصد ) .  اخرجه البخاري ، والترمذي مثل الرواية الثانية ، الا انه ذكر فيها ( الخامة من الزرع ) . * * * غريب الحديث * * * خامة : الخامات من النبات : الغضة الرطبة اللينة . تفيءها : اي تميلها كذا وكذا ، حتي ترجع من جانب الي جانب . كالارزة : بفتح الراء : شجرة الارزن ، وهو خشب معروف ، وبسكونها : شجرة الصنوبر ، والصنوبر : ثمرها . يقصمها : القصم : الكسر ، يقال : قصمت الشء قصما : كسرته حتي يبين وينفصل . تستحصد : الاستحصاد : التهيء للحصد ، وهو القطع . صماء : الصماء المكتنزة التي لا تخلخل فيها .
  ( خ م ) كعب بن مالك  رضي الله عنه  : قال : قال رسول الله  صلي الله عليه وسلم  : ( مثل المءمن : كمثل الخامة من الزرع ، تفيءها الريح ، تصرعها مرة ، وتعدلها اخري ، حتي تهيج ) . وفي اخري : ( حتي ياتيه اجله ، ومثل المنافق : مثل الارزة المجذية علي اصلها ، لا يفيءها شء ، حتي يكون انجعافها مرة واحدة ) . اخرجه  البخاري ، ومسلم . * * * غريب الحديث * * * تصرعها : اي ترميها وتلقيها ، من المصارعة . تهيج : هاج النبات هيجا : اذا اخذ في الجفاف والاصفرار ، بعد الغضاضة والاخضرار . المجذية : الثابتة ، يقال : جذا يجذو ، واجذي يجذي لغتان . انجعافها : الانجعاف : الانقلاع ، وهو مطاوع : جعفت الشء : اذا قلعته .
  ( خ م ) ابن عمر  رضي الله عنهما  : قال : قال رسول الله  صلي الله عليه وسلم  : ( مثل المءمن كمثل شجرة خضراء ، لا يسقط ورقها ، ولا يتحات ) . فقال القوم كذا ، هي شجرة كذا ، فاردت ان اقول : هي النخلة ، وانا غلام شاب ، فاستحييت ، فقال : ( هي النخلة ) . اخرجه البخاري ، ومسلم ، واخرجاه من طرق اخري ، اطول من هذا بزيادة اوجبت ذكره في غير هذا الموضع . * * * غريب الحديث * * * يتحات : تحات ورق الشجر : اذا انتثر وتساقط بنفسه . 
  ( ت ) النواس بن سمعان  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( ان الله ضرب مثلا صراطا مستقيما ، علي كنفي الصراط ، زوران لهما ابواب مفتحة ، علي الابواب ستور ، وداع يدعو علي راس الصراط ، وداع يدعو فوقه : { والله يدعو الي دار السلام ويهدي من يشاء الي صراط مستقيم } [ يونس :  ] ، والابواب التي علي كنفي الصراط حدود الله ، فلا يقع احد في حدود الله حتي يكشف الستر ، والذي يدعو من فوقه واعظ ربه ) . اخرجه الترمذي . * * * غريب الحديث * * * كنفي : كنف الشء : جانبه . حدود : جمع حد ، وهي احكام الشرع ، واصل الحد : الفاصل  بين الشيءين ، فكان حدود الشرع فواصل بين الحلال والحرام . وهذا حديث وجدته في كتاب رزين بن معاوية ، ولم اجده في الاصول .
  ( ابن مسعود  رضي الله عنه  ) : قال : ان رسول الله  صلي الله عليه وسلم  قال : ( ضرب الله مثلا صراطا مستقيما ، وعن جنبتي الصراط سوران فيهما ابواب مفتحة ، وعلي الابواب ستور مرخاة ، وعند راس الصراط داع يقول : استقيموا علي الصراط ولا تعوجوا ، وفوق ذلك داع يدعو كلما هم عبد ان يفتح شيءا من تلك الابواب ، قال : ويحك ، لا تفتحه ، فانك ان تفتحه تلجه . ثم فسره فاخبر : ان الصراط : هو الاسلام ، وان الابواب المفتحة ، محارم الله ، وان الستور المرخاة : حدود الله ، والداعي علي راس الصراط : هو القران ، وان الداعي من فوقه : هو واعظ الله في قلب كل مءمن ) .
  ( م ) ابو هريرة  رضي الله عنه  : قال : ان رسول الله  صلي الله عليه وسلم  قال : ( بدا الاسلام غريبا ، وسيعود غريبا كما بدا ، فطوبي للغرباء ) .  اخرجه مسلم .
  ( ت ) عبد الله بن مسعود  رضي الله عنه  : قال : ان رسول الله  صلي الله عليه وسلم  قال : ( ان الاسلام بدا غريبا ؛ وسيعود غريبا كما بدا ، فطوبي للغرباء ) . اخرجه الترمذي . 
  ( الكتاب الثاني في الاعتصام بالكتاب والسنة وفيه بابان )

  ( الباب الاول في الاستمساك بهما )
  ( ط ) مالك بن انس  رحمه الله  : بلغه ، ان رسول الله  صلي الله عليه وسلم  قال : ( تركت فيكم امرين لن تضلوا ما تمسكتم بهما : كتاب الله ، وسنة رسوله ) . اخرجه الموطا .
  ( ت ) جابر بن عبد الله  رضي الله عنهما  : قال : رايت رسول الله  صلي الله عليه وسلم  في حجة الوداع يوم عرفة ، وهو علي ناقته القصواء ، يخطب ، فسمعته يقول : ( اني تركت فيكم ما ان اخذتم به لن تضلوا : كتاب الله ، وعترتي اهل بيتي ) . اخرجه الترمذي . * * [ شرح الغريب ] * *  ( القصواء ) : اسم ناقة النبي & ، ولم تكن قصواء ، لان الناقة  القصواء هي التي قطع طرف اذنها ، ولم تكن ناقته كذلك ، يقال : ناقة قصواء ، وشاة قصواء ، ولا يقال : جمل اقصي ، وانما يقال : مقصو ، ومقصي ، تركوا فيه القياس
  ( ت ) زيد بن ارقم  رضي الله عنه  : قال : قال رسول الله  صلي الله عليه وسلم  : ( اني تارك فيكم ما ان تمسكتم به لن تضلوا بعدي ، احدهما اعظم من الاخر ، وهو كتاب الله ، حبل ممدود من السماء الي الارض ، وعترتي اهل بيتي ، لن يفترقا حتي يردا علي الحوض ، فانظروا كيف تخلفوني فيهما ؟ ) . اخرجه الترمذي .
  ( د ت ) قال عبد الرحمن بن عمرو السلمي وحجر بن حجر : اتينا العرباض بن سارية  رضي الله عنه  وهو ممن نزل فيه : { ولا علي الذين اذا ما اتوك لتحملهم قلت لا اجد ما احملكم عليه } [ التوبة :  ] فسلمنا ، وقلنا : اتيناك زاءرين ، وعاءدين ، ومقتبسين ، فقال العرباض : صلي بنا رسول الله  صلي الله عليه وسلم  ذات يوم ، ثم اقبل علينا بوجهه ، فوعظنا موعظة بليغة ، ذرفت منها العيون ، ووجلت منها القلوب ، فقال رجل : يا رسول الله ، كان هذه موعظة مودع ، فماذا تعهد الينا ؟ قال : ( اوصيكم بتقوي الله ، والسمع والطاعة  ، وان عبدا حبشيا ، فانه من يعش منكم بعدي فسيري اختلافا كثيرا ، فعليكم بسنتي وسنة الخلفاء الراشدين المهديين ، تمسكوا بها ، وعضوا عليها بالنواجذ ، واياكم ومحدثات الامور ، فان كل محدثة بدعة ، وكل بدعة ضلالة ) . هذه رواية ابي داود . واخرجه الترمذي ، ولم يذكر الصلاة ، وفي اخره : تقديم وتاخير . * * * غريب الحديث * * * مقتبسين : الاقتباس في الاصل : اخذ القبس من النار ، واراد به : الاخذ من العلم والادب . ذرفت : العين تذرف : اذا دمعت . وجلت : وجل القلب يوجل : اذا خاف وفزع ، والوجل : الفزع . تعهد : عهد اليه بكذا يعهد : اذا اوصي اليه . الراشدين : الراشد : اسم فاعل من رشد يرشد ، ورشد يرشد رشدا ، وهو خلاف الغي ، وارشدته انا : اذا اوصي اليه . المهديين : المهدي : الذي قد هداه الله الي الحق ، هداه يهديه فهو مهدي ، والله هاديه . وان  عبدا حبشيا : اي : اطع صاحب الامر ، واسمع له ، وان كان عبدا حبشيا ، فحذف ( كان ) وهي مرادة . وعضوا عليها بالنواجذ : النواجذ : الاضراس التي بعد الناب ، جمع ناجذ ، وهذا مثل في شدة الاستمساك بالامر ؛ لان العض بالنواجذ عض بمعظم الاسنان التي قبلها والتي بعدها . الهدي : بفتح الهاء ، وسكون الدال : الطريقة والسيرة . محدثات الامور : ما لم يكن معروفا في كتاب ، ولا سنة ، ولا اجماع . بدعة : الابتداع : اذا كان من الله وحده فهو اخراج الشء من العدم الي الوجود ، وهو تكوين الاشياء بعد ان لم تكن ، وليس ذلك الا الي الله تعالي ، فاما الابتداع من المخلوقين ، فان كان في خلاف ما امر الله به ورسوله ، فهو في حيز الذم والانكار ، وان كان واقعا تحت عموم ما ندب الله اليه ، وحض عليه او رسوله ، فهو في حيز المدح ، وان لم يكن مثاله موجودا ، كنوع من الجود والسخاء ، وفعل المعروف ، فهذا فعل من الاعمال المحمودة لم يكن الفاعل قد سبق اليه ؛ ولا يجوز ان يكون ذلك في خلاف ما ورد الشرع به ؛ لان رسول الله  صلي الله عليه وسلم  ، قد جعل له في ذلك ثوابا فقال : ( من سن سنة حسنة ، كان له اجرها واجر من عمل بها ) وقال في ضده : ( من سن سنة سيءة ، كان عليه وزرها ووزر من عمل بها ) . وذلك اذا كان في خلاف ما امر الله به ورسوله ، ويعضد ذلك قول  عمر بن الخطاب  رضي الله عنه  في صلاة التراويح : ( نعمت البدعة هذه ) لما كانت من افعال الخير ، وداخلة في حيز المدح ، سماها بدعة ومدحها ، وهي وان كان النبي  صلي الله عليه وسلم  قد صلاها  الا انه تركها ، ولم يحافظ عليها ، ولا جمع الناس عليها ، فمحافظة عمر عليها ، وجمعه الناس لها ، وندبهم اليها بدعة ، لكنها بدعة محمودة ممدوحة .
  ( د ت ) المقدام بن معد يكرب  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( الا هل عسي رجل يبلغه الحديث عني ، هو متكء علي اريكته ، فيقول : بيننا وبينكم كتاب الله ، فما وجدنا فيه حلالا استحللناه ، وما وجدنا فيه حراما حرمناه ، وان ما حرم رسول الله كما حرم الله ) هذه رواية الترمذي . ورواية ابي داود : قال : قال رسول الله  صلي الله عليه وسلم  : ( الا اني اوتيت هذا الكتاب ، ومثله معه ، الا يوشك رجل شبعان علي اريكته ، يقول : عليكم بهذا القران ، فيما وجدتم فيه من حلال فاحلوه ، وما وجدتم فيه من حرام فحرموه ، الا لا يحل لكم الحمار الاهلي ، ولا كل ذي ناب من السباع ، ولا لقطة معاهد ، الا ان يستغني عنها صاحبها ، ومن نزل بقوم ، فعليهم ان يقروه ، فان لم يقروه ؛ فله ان يعقبهم بمثل قراه ) .  * * * غريب الحديث * * * اريكته : الاريكة : السرير في الحجلة ، ولا يسمي منفردا اريكة ، وقيل : هو كل اتكء عليه . يوشك : اوشك : اذا اسرع وقرب ، يوشك ايشاكا . اللقطة : ما وجدته مرميا في الارض ، لا تعرف له صاحبا . معاهد : المعاهد : الذي بينك وبينه عهد وموادعة ، والمراد به : من كان بينه وبين المسلمين معاقدة وموادعة ، ومهادنة ، فلا يجوز ان تتملك لقطته ؛ لانه معصوم المال ، يجري حكمه مجري حكم الذمي . يقروه : القري : ما يعد للضيف النازل من النزل . يعقبهم : ويعقبهم  مشددا ومخففا  بمعني انه ياخذ منهم ، ويغنم من اموالهم ، بقدر قراه ، ومثله قوله تعالي : { وان فاتكم شء من ازواجكم الي الكفار فعاقبتم } [ الممتحنة :  ] وعقبتم ، اي : فكانت الغلبة لكم ، فغنمتم منهم . اوتيت : قال الخطابي في شرح هذا الحديث : قوله  صلي الله عليه وسلم  : ( اوتيت هذا الكتاب ومثله ) يحتمل وجهين من التاويل : احدهما : ان معناه : انه اوتي من الوحي الباطن غير المتلو مثل ما اعطي من الظاهر المتلو انه اوتي الكتاب وحيا ، واوتي من البيان مثله ، اي : اذن له ان يبين ما في الكتاب ، فيعم ويخص ، ويزيد عليه ، ويشرع ما ليس في الكتاب ، فيكون في وجوب العمل به ، ولزوم قبوله كالظاهر المتلو من القران .  وقوله : ويوشك رجل شبعان علي اريكته ، يقول : عليكم بهذا القران ، فانه  صلي الله عليه وسلم  يحذر بهذا القول من مخالفة السنن التي سنها هو مما ليس في القران . وانما اراد بالاريكة : صفة اصحاب الترفه والدعة الذين لزموا البيوت ، ولم يطلبوا العلم من مظانه . وقوله : ( الا ان يستغني عنها صاحبها ) معناه : ان يتركها صاحبها لمن ياخذها ، استغناء عنها ، كقوله تعالي : { فكفروا وتولوا واستغني الله } [ التغابن :  ] معناه : تركهم الله استغناء عنهم ، وقوله : ( فله ان يعقبهم بمثل قراه ) هذا في الحال المضطر الذي لا يجد طعاما ، ويخاف التلف علي نفسه ، فله ان ياخذ من مالهم بقدر قراه ، عوض ما حرموه من قراه .
  ( د ت ) ابو رافع  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  قال : ( لا اعرفن الرجل منكم ياتيه الامر من امري : اما امرت به ، او نهيت عنه ، وهو متكء علي اريكته ، فيقول ، ما ندري ما هذا ؟ عندنا كتاب الله ، وليس هذا فيه . وما لرسول الله ان يقول ما يخالف القران ، وبالقران هداه الله ) . اخرجه الترمذي وابو داود . ولفظهما اخصر من هذا ، وهو : ان رسول الله  صلي الله عليه وسلم  قال : ( لا الفين احدكم متكءا علي اريكته ، ياتيه امري : مما امرت به ، او نهيت عنه ، فيقول : لا ادري ، ما وجدنا في كتاب الله اتبعناه ) .  واللفظ الاول مما وجدته في كتاب رزين : * * * غريب الحديث * * * لا الفين : الفيت الشء الفيه ، اذا وجدته وصادفته .
  ( خ م ) ابو موسي الاشعري  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( ان مثل ما بعثني الله به من الهدي والعلم ، كمثل غيث اصاب  ارضا ، فكانت منها طاءفة طيبة ، قبلت الماء فانبتت الكلا والعشب الكثير ، وكان منها اجادب امسكت الماء ، فنفع الله بها الناس ، فشربوا منها ، وسقوا ورعوا ، واصاب طاءفة منها اخري ، انما هي قيعان لا تمسك ماءا ، ولا تنبت كلا ، فذلك مثل من فقه في دين الله عزو جل ، ونفعه ما بعثني الله به ، فعلم وعلم ، ومثل من لم يرفع بذلك راسا ، ولم يقبل هدي الله الذي ارسلت به ) . اخرجه البخاري ومسلم .
  ( خ م ) وعنه  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  قال : ( ان مثلي ومثل ما بعثني الله به ، كمثل رجل اتي قومه فقال : اني رايت الجيش بعيني ، و [ اني ] انا النذير العريان ، فالنجاء ، النجاء ، فاطاعه طاءفة من  قومه ، فادلجوا ، فانطلقوا علي مهلهم فنجوا ، وكذبت طاءفة منهم ، فاصبحوا مكانهم ، فصبحهم الجيش فاهلكهم ، اجتاحهم ، فذلك مثل من اطاعني ، واتبع ما جءت به ، ومثل من عصاني ، وكذب ما جءت به من الحق ) . اخرجه البخاري ومسلم . * * * غريب الحديث * * * الكلا : العشب ، وسواء يابسه ورطبه . اجادب : قال ابو عبد الله الحميدي  صاحب كتاب ( الجمع بين الصحيحين ) في شرح غريب كتابه  الذي رايناه من الروايات في هذا الحديث : اجادب ، بدال قبل باء ، قال : وحكاه الهروي في الجمع بين الغريبين : اجارد ، براء قبل دال ، يقال : مواضع منجردة من النبات ، ويقال : مكان اجرد ، وارض جرداء : اذا لم تنبت ، والحديث يدل علي ان المراد به الارض الصلبة ، التي تمسك الماء . قلت : وقال الجوهري في كتاب ( الصحاح ) ، ويقال : فضاء اجرد ، لا نبات به ، والجمع اجارد ، الا ان لفظة الحديث في الروايات ( اجادب ) ولعل لها معني لم يعرف ، والله بلطفه يهدي اليه . قلت : وذكر الهروي  رحمه الله  ايضا في كتابه ، في موضع اخر :  ( وكانت فيها اخاذات امسكت الماء ) وقال : الاخاذات : الغدران التي تاخذ ماء السماء ، فتحبسه علي الشاربين ، واحدتها : اخاذة ، وهذا مناسب للفظ الحديث ، فانه قال : ( وكان منها اجادب امسكت الماء ، فنفع الله به الناس ، وشربوا منه ) والله اعلم . قال الخطابي : واما اجادب فهو غلط وتصحيف ، قال : وقد روي احادب بالحاء المهملة والباء . النجاء : اي : اطلبوا الخلاص ، وانجوا انفسكم وخلصوها . فاجتاحهم : استاصلهم ، وهو من الجاءحة التي تهلك الاشياء . القيعان : جمع قاع ، وهو المستوي من الارض . النذير العريان : الذي لا ثوب عليه ، وخص العريان ؛ لانه ابين في العين ، واصل هذا : ان الرجل منهم كان اذا انذر قومه ، وجاء من بلد بعيد انسلخ من ثيابه ، ليكون ابين للعين . ادلجوا : اذا خفف  من ادلج يدلج  كان بمعني : سار الليل كله ، واذا ثقل  من ادلج يدلج  كان اذا سار اخر الليل .
  ( خ م ت ) ابو هريرة  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  يقول : ( انما مثلي ومثل الناس ، كمثل رجل استوقد نارا ، فلما اضاءت ما حوله ، جعل الفراش وهذي الدواب ، التي تقع في النار ، تقع فيها ،  فجعل ينزعهن ويغلبنه ، فيتقحمن فيها ، فانا اخذ بحجزكم عن النار ، وانتم تقحمون فيها ) . هذه رواية البخاري . ولمسلم نحوها ، وقال في اخرها : ( فذلك مثلي ومثلكم ، انا اخذ بحجزكم عن النار ، هلم عن النار ، هلم عن النار ، فتغلبوني وتقحمون فيها ) . واخرجه الترمذي بنحوه .
  ( م ) جابر  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( مثلي  ومثلكم كمثل رجل اوقد نارا ، فجعل الجنادب والفراش يقعن فيها ، وهو يذبهن عنها ، وانا اخذ بحجزكم عن النار ، وانتم تفلتون من يدي ) . اخرجه مسلم . * * * غريب الحديث * * * الجنادب : جمع جندب ، وهو طاءر كالجراد ، يصر في الحر . تفلتون : التفلت والانفلات : التخلص من اليد .
  ( خ ) بن مسعود  رضي الله عنه  قال : ( ان احسن الحديث كتاب الله ، واحسن الهدي هدي محمد  صلي الله عليه وسلم  ، وشر الامور محدثاتها ، وان ما توعدون لات ، وما انتم بمعجزين ) اخرجه البخاري . * * * غريب الحديث * * * الهدي : بفتح الهاء ، وسكون الدال : الطريقة والسيرة .
  ( خ م د ) عاءشة  رضي الله عنها  قالت : قال رسول الله  صلي الله عليه وسلم  : ( من احدث في امرنا هذا ما ليس منه فهو رد ) . وفي رواية ( من عمل عملا ليس عليه امرنا ، فهو رد ) . اخرجه  البخاري ومسلم وابو داود . * * * غريب الحديث * * * فهو رد : امر رد : اذا كان مخالفا لما عليه السنة .
  ( د ) ابو ذر  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( من فارق الجماعة شبرا ، فقد خلع ربقة الاسلام من عنقه ) اخرجه ابو داود . * * * غريب الحديث * * * ربقة الاسلام : اراد بربقة الاسلام : عقد الاسلام ، واصله : ان الربق : حبل فيه عدة عري ، تشد بها الغنم ، الواحدة من العري : ربقة .
  ( خ ) علي  رضي الله عنه  قال : ( اقضوا كما كنتم تقضون ،  فاني اكره الخلاف ، حتي يكون الناس جماعة ، واموت كما مات اصحابي ، فكان ابن سيرين يري عامة ما يروون عن علي كذبا ) . اخرجه البخاري .
  ( خ ت ) انس بن مالك  رضي الله عنه  قال الزهري : دخلت علي انس وهو يبكي ، فقلت : ( ما يبكيك ؟ ) قال : ( لا اعرف شيءا مما ادركت ، الا هذه الصلاة ، وهذه الصلاة قد ضيعت ) . وفي اخري : قال انس : ( لا اعرف شيءا مما كان علي عهد رسول الله  صلي الله عليه وسلم  ) . قيل : ( الصلاة ؟ ) قال : ( اليس صنعتم ما صنعتم فيها ؟ ) . اخرجه البخاري ، واخرج الثانية الترمذي . وهذه احاديث وجدتها في كتاب رزين ، ولم اجدها في الاصول .
  ( ) ابو هريرة  رضي الله عنه  دخل السوق فقال : ( اراكم ها هنا وميراث محمد  صلي الله عليه وسلم  يقسم في المسجد ؟ ) ! فذهبوا وانصرفوا ، فقالوا : ما راينا  شيءا يقسم ، راينا قوما يقرءون القران ، قال : ( فذلكم ميراث نبيكم ) .
  ( ) ابن مسعود  رضي الله عنه  قال : ( من كان مستنا ، فليستن بمن قد مات ، فان الحي لا تءمن عليه الفتنة ، اولءك اصحاب محمد  صلي الله عليه وسلم  ، كانوا افضل هذه الامة : ابرها قلوبا ، واعمقها علما ، واقلها تكلفا ، اختارهم الله لصحبة نبيه ، ولاقامة دينه ، فاعرفوا لهم فضلهم ، واتبعوهم علي اثرهم ، وتمسكوا بما استطعتم من اخلاقهم وسيرهم ، فانهم كانوا علي الهدي المستقيم ) . * * * غريب الحديث * * * مستنا : المستن : الذي يعمل بالسنة ، سن واستن .
  ( ) ابن عباس  رضي الله عنهما  ( من تعلم كتاب الله ثم اتبع ما فيه هداه الله من الضلالة في الدنيا ، ووقاه يوم القيامة سوء الحساب ) . وفي رواية قال : من اقتدي بكتاب الله ، لا يضل في الدنيا ولا يشقي في الاخرة ، ثم تلا هذه الاية : { فمن اتبع هداي فلا يضل ولا يشقي } . [ طه : الاية  ] .
  ( ) عمر بن عبد العزيز  رحمه الله  ينميه الي عمر بن الخطاب انه قال : ( تركتم علي الواضحة ، ليلها كنهارها ، وكونوا علي دين الاعراب وغلمان  الكتاب ) . * * * غريب الحديث * * * ينميه : نميت الشء انميه اليه : اذا اسندته اليه ورفعته . الواضحة : البينة ، وهي صفة لمحذوف ، تقديره : علي الملة الواضحة الظاهرة . دين الاعراب : اراد بقوله : دين الاعراب والغلمان والصبيان ، الوقوف عند قبول ظاهر الشريعة ، واتباعها من غير تفتيش عن الشبه ، وتنقير عن اقوال اهل الزيغ والاهواء ، ومثله قوله : ( عليكم بدين العجاءز ) .
  ( ) علي بن ابي طالب  رضي الله عنه  ( تركتم علي الجادة ، منهج عليه ام الكتاب ) .
  ( الباب الثاني في الاقتصاد والاقتصار في الاعمال )
  ( خ م س ) انس بن مالك  رضي الله عنه  جاء ثلاثة رهط  الي بيوت ازواج النبي  صلي الله عليه وسلم  ، يسالون عن عبادة النبي  صلي الله عليه وسلم  ، فلما اخبروا كانهم تقالوها ، قالوا : فاين نحن من رسول الله  صلي الله عليه وسلم  ، وقد غفر له ما تقدم من ذنبه وما تاخر ؟ قال احدهم : اما انا فاصلي الليل ابدا ، وقال الاخر : وانا اصوم الدهر ولا افطر ، وقال الاخر : وانا اعتزل النساء ولا اتزوج ابدا ، فجاء رسول الله  صلي الله عليه وسلم  اليهم ، فقال : ( انتم الذين قلتم كذا وكذا ؟ اما والله ، اني لاخشاكم لله ، واتقاكم له ، ولكني اصوم وافطر ، واصلي وارقد ، واتزوج النساء ، فمن رغب عن سنتي فليس مني ) . اخرجه البخاري ومسلم . واخرجه النساءي ، وهذا لفظه : ان نفرا من اصحاب رسول الله  صلي الله عليه وسلم  قال بعضهم : لا اتزوج [ النساء ] ، وقال بعضهم : لا اكل اللحم ، وقال بعضهم : لا انام علي فراش ، وقال بعضهم : اصوم ولا افطر ، فبلغ ذلك رسول الله  صلي الله عليه وسلم  ، فحمد الله واثني عليه ، ثم قال : ( ما بال اقوام يقولون كذا وكذا ؟ لكني اصلي وانام ، واصوم وافطر ، واتزوج النساء ، فمن رغب عن سنتي فليس مني ) .  * * * غريب الحديث * * * تقالوه : التقال : تفاعل من القلة ، كانهم استقلوا ذلك لانفسهم من الفعل ، فارادوا ان يكثروا منه . رغب عن الشء : الرغبة في الشء : ايثاره ، والميل اليه ، والرغبة عنه : تركه ، والصدوف عنه .
  ( خ م ) عاءشة  رضي الله عنها  قالت : صنع رسول الله  صلي الله عليه وسلم  شيءا فرخص فيه ، فتنزه عنه قوم ، فبلغ ذلك رسول الله  صلي الله عليه وسلم  ، فخطب ، فحمد الله [ واثني عليه ] ، ثم قال : ( ما بال اقوام يتنزهون عن الشء اصنعه ، فوالله اني لاعلمهم بالله ، واشدهم له خشية ) . اخرجه البخاري ومسلم . * * * غريب الحديث * * * فتنزه : التنزه : التباعد عن الشء ، اي : انهم تركوه ولم يعملوا به ، ولا اقتدوا برسول الله  صلي الله عليه وسلم  فيه .
  ( د ) عاءشة  رضي الله عنها  قالت : بعث رسول الله  صلي الله عليه وسلم  الي  عثمان بن مظعون : ( ارغبة عن سنتي ؟ ) فقال : لا ، والله يا رسول الله ولكن سنتك اطلب ، قال : ( فاني انام ، واصلي ، واصوم ، وافطر ، وانكح النساء ، فاتق الله يا عثمان ، فان لاهلك عليك حقا ، وان لنفسك عليك حقا ، فصم وافطر ، وصل ونم ) . اخرجه ابو داود . ووجدت في كتاب رزين زيادة لم اجدها في الاصول ، وهي : قالت عاءشة : وكان حلف ان يقوم الليل كله ، ويصوم النهار ، ولا ينكح النساء ، فسال عن يمينه ، فنزل { لا يءاخذكم الله باللغو في ايمانكم } [ البقرة : الاية  ] . وفي رواية انه هو الذي سال رسول الله  صلي الله عليه وسلم  عما نواه ، قبل ان يعزم ، وهو اصح . ووجدت له فيه عن عاءشة قالت : كان رسول الله  صلي الله عليه وسلم  اذا امرهم  امرهم من العمل بما يطيقون ، قالوا : لسنا كهيءتك ، ان الله عز وجل قد غفر لك ما تقدم من ذنبك وما تاخر ، فيغضب ، حتي يعرف الغضب في وجهه ، ثم يقول : ( ان اتقاكم واعلمكم بالله انا ) .
  ( خ م د س ) عبد الله بن عمرو بن العاص  رضي الله عنهما  قال : ( اخبر رسول الله  صلي الله عليه وسلم  : اني اقول : والله لاصومن النهار ، ولاقومن الليل ما عشت ، فقال رسول الله  صلي الله عليه وسلم  : ( انت الذي تقول ذلك ؟ ) فقلت له : قد قلته ، بابي انت وامي يا رسول الله ، قال : ( فانك لا تستطيع ذلك ، فصم  وافطر ، ونم ، وقم ، وصم من الشهر ثلاثة ايام ، فان الحسنة بعشر امثالها ، وذلك مثل صيام الدهر ) ، قلت : اني اطيق افضل من ذلك ، قال : ( فصم يوما افطر يومين ) ، قلت : فاني اطيق افضل من ذلك ، قال : ( فصم يوما وافطر يوما ، فذلك صيام داود عليه السلام ، وهو اعدل الصيام )  وفي رواية : افضل الصيام  قلت : فاني اطيق افضل من ذلك ، فقال رسول الله  صلي الله عليه وسلم  : ( لا افضل من ذلك ) . زاد في رواية ، قال عبد الله بن عمرو ، لان اكون قبلت الثلاثة الايام التي قال رسول الله  صلي الله عليه وسلم  ، احب الي من اهلي ومالي ) . وفي رواية اخري : قال : قال لي رسول الله : ( الم اخبر انك تصوم النهار ، وتقوم الليل ؟ قال : قلت : بلي يا رسول الله ، قال : ( فلا تفعل ، صم وافطر ، ونم وقم ، فان لجسدك عليك حقا ، وان لعينك عليك حقا ، وان لزوجك عليك حقا ، وان لزورك عليك حقا ، وان بحسبك ان تصوم من كل شهر ثلاثة ايام ، فان لك بكل حسنة عشر امثالها ، فاذا ذلك صيام الدهر ) . فشددت فشدد علي ، قلت : يا رسول الله : اني اجد قوة ، قال : ( صم صيام نبي الله داود عليه السلام ، لا تزد عليه ) . قلت : وما كان  صيام داود ؟ قال : ( نصف الدهر ) . فكان عبد الله يقول بعد ما كير : يا ليتني قبلت رخصة النبي  صلي الله عليه وسلم  . وفي اخري قال : ( الم اخبر انك تصوم الدهر ، وتقرا القران كل ليلة ؟ ) فقلت : بلي ، يا نبي الله ، ولم ارد بذلك الا الخير ، وفيه قال : ( فصم صوم داود ، فانه كان اعبد الناس )  وفيه قال  : ( واقرا القران في كل شهر ) ، قال : قلت : يا نبي الله ، اني اطيق افضل من ذلك ، قال : ( فاقراه في كل عشرين ) ، قال : فقلت : يا نبي الله ، اني اطيق افضل من ذلك ، قال : ( فاقراه في عشر ) ، قلت : يا نبي الله ، اني اطيق افضل من ذلك ، قال : ( فاقراه في سبع ، لا تزد علي ذلك ) . قال : فشددت فشدد علي ، وقال لي النبي  صلي الله عليه وسلم  : انك لا تدري لعلك يطول بك عمر ) ، قال : فصرت الي الذي قال لي رسول الله  صلي الله عليه وسلم  ، فلما كبرت وددت اني كنت قبلت رخصة نبي الله  صلي الله عليه وسلم  . زاد مسلم ( فان لولدك عليك حقا ) . وفي اخري : قال النبي  صلي الله عليه وسلم  : ( انك لتصوم النهار ، وتقوم الليل ؟ ) قلت : نعم ، قال : ( اذا فعلت ذلك هجمت له العين ، ونفهت له النفس ، لا صام من صام الابد ، صوم ثلاثة ايام صوم الدهر كله ) . قلت : فان اطيق اكثر من ذلك ، قال : ( فصم صوم داود ، كان يصوم يوما ويفطر يوما ، ولا يفر اذا لاقي ) .  وزاد في رواية : ( من لي بهذه يا نبي الله ) . وفي رواية نحوه ، وفيه ( وصم من كل عشرة ايام يوما ، ولك اجر تسعة )  وفي  فقال النبي  صلي الله عليه وسلم  : ( لا صام من صام الابد ) ثلاثا . هذه روايات البخاري ومسلم . ووافقهما ابو داود علي الرواية الاولي . والنساءي علي الاولي والثانية ، والفاظهم جميعهم متقاربة باتفاق المعني . واخرج البخاري والنساءي عنه . قال البخاري : قال عبد الله بن عمرو : انكحني ابي امراة ذات حسب ، وكان يتعاهد كنته ، فيسالها عن بعلها ، فتقول له : نعم الرجل من رجل لم يطا لنا فراشا ، ولم يفتش لنا كنفا مذ اتيناه ، فلما طال ذلك عليه ، ذكر ذلك للنبي  صلي الله عليه وسلم  ، فقال : ( القني به ) فلقيته بعد ، فقال : ( كيف تصوم ؟ ) قلت : كل يوم . قال : ( وكيف تختم ؟ ) قلت : كل ليلة ، فقال : ( صم كل شهر ثلاثة ايام ، واقرا القران في كل شهر ) . قال : قلت : فاني اطيق اكثر من ذلك ، قال : ( صم ثلاثة ايام في الجمعة ) . قال : قلت : اطيق اكثر من ذلك ، قال : ( افطر يومين وصم يوما ) . قال : قلت : اطيق اكثر من ذلك ، قال : ( صم افضل الصوم ، صوم داود : صيام يوم . وافطار يوم . واقرا في كل سبع ليال مرة ) قال : فليتني قبلت رخصة رسول الله  صلي الله عليه وسلم  ، وذلك  اني كبرت وضعفت ، وكان يقرا علي بعض اهله السبع من القران بالنهار ، والذي يقرءه يعرضه من الليل ، ليكون اخف عليه بالليل ، واذا اراد ان يتقوي افطر اياما ، واحصي وصام مثلهن ، كراهية ان يترك شيءا فارق عليه النبي  صلي الله عليه وسلم  . ورواية النساءي قال : زوجني ابي امراة ، فجاء يزورنا ، فقال : كيف ترين بعلك ؟ قالت : نعم الرجل ، لا ينام الليل ، ولا يفطر النهار ، فوقع بي وقال : زوجتك امراة من المسلمين ، فعضلتها ، قال : فجعلت لا التفت الي قوله ، مما عند من القوة والاجتهاد ، فبلغ ذلك النبي  صلي الله عليه وسلم  . فقال : ( لكني انا اقوم وانام ، واصوم وافطر ، فقم ونم ، وصم وافطر )  وذكر الصوم نحو ما تقدم ، وقال : ( اقرا القران في شهر ) ، ثم انتهي الي خمس عشرة ، وانا اقول : انا اقوي من ذلك . واخرجه مثل رواية البخاري ، ولم يذكر فيه القراءة . واخرج الترمذي طرفا من هذه الروايات ، وهو قوله : ( افضل الصوم صوم اخي داود ، كان يصوم يوما ويفطر يوما ، ولا يفر اذا لاقي ) . ولقلة ما اخرج منه لم نعلم عليه علامته .  وسيجء ذكره مع باقي روايات هذا الحديث في كتاب الصوم من حرف الصاد . وقد اخرج البخاري ومسلم وابو داود والنساءي هذا الحديث مختصرا جامعا ، فقال : ان رسول الله  صلي الله عليه وسلم  قال : ( ان احب الصيام الي الله : صيام داود ، واحب الصلاة الي الله : صلاة داود ، كان ينام نصف الليل ، ويقوم ثلثه ، وينام سدسه ، وكان يصوم يوما ويفطر يوما ) . * * * غريب الحديث * * * بحسبك : احسبه هذا الامر يحسبه : اذا كفاه . هجمت : العين : اذا غارت ودخلت في نقرتها من الضعف والمرض . نفهت النفس : اذا اعيت وكلت . ذات حسب : الحسب : ما يعده الرجل من مفاخر اباءه ، ويقال :  حسبه : دينه ، ويقال : ماله ، وقيل : الحسب يكون في الرجل وان لم يكن له اباء لهم شرف . كنته : الكنة : امراة الابن او الاخ . بعلها : بعل المراة : زوجها . كنفا : لم يفتش لنا كنفا ، الكنف : الجانب ، ارادت : انه لم يقربها ، ولم يستعلم لها حالا خفيت عنه . فوقع بي : وقع بي فلان : اذا لامك وعنفك ، واما وقعت فيه ، فهو من الوقيعة ، وهي الغيبة . فعضلتها : العضل : المنع ، والمراد : انك لم تعاملها معاملة الازواج لنساءهم ، ولا تركتها بنفسها لتتزوج ، وتتصرف في نفسها كما تريد .
  ( خ م ط د ت س ) عاءشة  رضي الله عنها  قالت : كان للنبي  صلي الله عليه وسلم  حصير ، وكان يحجره بالليل فيصلي فيه ، ويبسطه بالنهار ، فيجلس عليه ، فجعل الناس يثوبون الي النبي  صلي الله عليه وسلم  ، يصلون بصلاته ، حتي كثروا ، فاقبل ، فقال : ( يا ايها الناس ، خذوا من الاعمال ما تطيقون ، فان الله لا يمل  حتي تملوا ، وان احب الاعمال الي الله ما دام وان قل ) . زاد في رواية : ( وكان ال محمد اذا عملوا عملا اثبتوه ) . وفي رواية قال : ان رسول الله  صلي الله عليه وسلم  سءل ، اي العمل احب الي الله ؟ قال : ( ادومه وان قل ) . زاد في رواية ( واكلفوا من العمل ما تطيقون ) . وفي رواية ان رسول الله  صلي الله عليه وسلم  قال : ( سددوا وقاربوا ، واعلموا انه لن يدخل احدكم عمله الجنة ، وان احب الاعمال الي الله ادومها وان قل ) . زاد في اخري : ( وابشروا ، قالوا : ولا انت يا رسول الله ؟ قال : ولا انا ، الا ان يتغمدني الله بمغفرة ورحمة ) .  هذه روايات البخاري ومسلم . وللبخاري و ( الموطا ) . قالت : كان احب الاعمال الي الله الذي يدوم عليه صاحبه . ولمسلم : كان احب الاعمال الي الله ادومها وان قل . وكانت عاءشة اذا عملت العمل لزمته . وفي رواية الترمذي : كان احب العمل الي رسول الله  صلي الله عليه وسلم  ما ديم عليه . وفي اخري له قال : سءلت عاءشة وام سلمة : اي العمل كان احب الي رسول الله  صلي الله عليه وسلم  ؟ قالتا : ما ديم عليه وان قل . وفي رواية ابي داود : ان رسول الله  صلي الله عليه وسلم  قال : ( اكلفوا من العمل ما تطيقون ، فان الله لا يمل حتي تملوا ، وان احب العمل الي الله ادومه وان قل ، وكان اذا عمل عملا اثبته ) . وفي اخري له قال : سالت عاءشة : كيف كان عمل رسول الله  صلي الله عليه وسلم  ؟ هل كان يخص شيءا من الايام ؟ قالت : لا ، كان عمله ديمة ، وايكم يستطيع ما كان رسول الله  صلي الله عليه وسلم  يستطيع ؟ . وفي رواية النساءي . قالت : كان لرسول الله  صلي الله عليه وسلم  حصيرة يبسطها ، ويحتجرها باللي ، فيصلي فيها ، ففطن له الناس ، فصلوا بصلاته ، وبينهم وبينه الحصيرة ، فقال : ( اكلفوا من العمل ما تطيقون ، فان الله تبارك وتعالي لا يمل حتي تملوا ، فان احب العمل الي الله ادومه وان قل ، ثم ترك مصلاه ذلك . فما عاد له حتي قبضه الله عز وجل ، وكان اذا عمل عملا اثبته ) .  * * * غريب الحديث * * * يحجره : حجره يحجره ، اي : يتخذه حجرة وناحية ينفرد عليه فيها . يثوبون : اي : يرجعون اليه ، ويجتمعون عنده . لا يمل حتي تملوا : المراد بهذا الحديث ، ان الله لا يمل ابدا ، مللتم او لم تملوا ، فجري مجري قولهم : لا افعله حتي يشيب الغراب ، ويبيض القار . وقيل معناه : ان الله لا يطرحكم حتي تتركوا العمل له ، وتزهدوا في الرغبة اليه ، فسمي الفعلين مللا ، وكلاهما ليس بملل ، كعادة العرب في وضع الفعل اذا وافق معناه ، نحو قوله ثم اضحوا لعب الدهر بهم وكذاك الدهر يودي بالرجال فجعل اهلاكه اياهم لعبا . وقيل معناه : ان الله لا يقطع عنكم فضله ، حتي تملوا سءاله ، فسمي فعل الله مللا ، وليس بملل ، علي جهة الازدواج ، كقوله تعالي : { فمن اعتدي عليكم فاعتدوا عليه } وكقوله تعالي : { وجزاء سيءة سيءة مثلها } وهذا شاءع في  العربية ، وكثير في القران . سددوا : اقصدوا السداد من الامر ، وهو الصواب . وقاربوا : اطلبوا المقاربة ، وهي القصد في الامر الذي لا غلو فيه ولا تقصير . يتغمدني : تغمده الله برحمته : اذا غفر له ورحمه ، واصله : كانه جعل رحمته له غمدا ستره بها وغشاه . اكلفوا : كلفت بهذا الامر ، اكلف به : اذا اولعت به ، وكلفه تكليفا : اذا امره بما شق عليه ، والمتكلف : المتعرض لما لا يعنيه ، وتكلفت الشء : تجشمته . ديمة : الديمة : المطر الداءم في سكون ، شبهت عمله في دوامه مع الاقتصاد بديمة المطر .
  ( خ م س ) ابو هريرة  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( لن يدخل احدا منكم عمله الجنة ) . قالوا : ولا انت ؟ قال : ( ولا انا ، الا ان يتغمدني الله بفضل ورحمة ) . هذا للبخاري  وزاد مسلم ( ولكن سددوا ) . في بعض طرقه  .  وفي اخري لمسلم . قال : قال رسول الله  صلي الله عليه وسلم  : ( قاربوا وسددوا ، واعلموا انه لن ينجي احدا منكم عمله ) . قالوا : ولا انت ؟ قال : ( ولا انا ، الا ان يتغمدني الله برحمة منه وفضل ) . وللبخاري مثلها ، الي قوله ( برحمة ) وزاد ( سددوا وقاربوا ، واغدوا وروحوا ، وشيءا من الدلجة ، والقصد القصد تبلغوا ) . وفي اخري للبخاري وللنساءي قال : قال رسول الله  صلي الله عليه وسلم  : ( ان هذا الدين يسر ، ولن يشاد الدين احد الا غلبه ، فسددوا وقاربوا ، ابشروا ، واستعينوا بالغدوة والروحة ، وشء من الدلجة ) . * * * غريب الحديث * * * واغدوا : الغدو : الخروج بكرة .  وروحوا : الرواح : العود عشيا ، والمراد : اعملوا اطراف النهار وقتا وقتا . الدلجة : سير الليل ، والمراد به العمل في الليل ، وقوله : ( وشيءا من الدلجة ) اشارة الي تقليله . والقصد : العدل في الفعل والقول ، والوسط بين الطرفين . يشاد : المشادة : مفاعلة من الشدة ، اي : لن يغالب ، ولن يقاوي احد الدين الا غلبة .
  ( م ) جابر بن عبد الله  رضي الله عنهما  قال : سمعت رسول الله  صلي الله عليه وسلم  يقول : ( لا يدخل احدا منكم عمله الجنة ، ولا يجيره من النار ، ولا انا ، الا برحمة الله عز وجل ) . وفي رواية قال : ( قاربوا وسددوا ، واعلموا انه لن ينجو منكم احد بعمله ) . قالوا : يا رسول الله ، ولا انت ؟ قال : ( ولا انا ، الا ان يتغمدني الله برحمة منه وفضل ) اخرجه مسلم . * * * غريب الحديث * * * يجيره : الاجارة : الاعانة والنصرة .
  ( خ م ) انس بن مالك  رضي الله عنه  ان النبي  صلي الله عليه وسلم  قال : ( يسروا ولا تعسروا ، وبشروا ولا تنفروا ) .  وفي روابة : ( وسكنوا ولا تنفروا ) . اخرجه البخاري ومسلم . * * * غريب الحديث * * * التيسير : ضد التعسير ، اراد به : التسهيل في الدين ، وترك التشديد .
  ( د ) سهل بن ابي امامة  رضي الله عنهما  انه دخل هو وابوه علي انس ابن مالك بالمدينة ، في زمان عمر بن عبد العزيز ، وهو امير المدينة فاذا هو يصلي صلاة خفيفة دقيقة ، كانها صلاة مسافر ، او قريب منها ، فلما سلم قال : يرحمك الله ، ارايت هذه الصلاة المكتوبة ، او شء تنفلته ؟ قال : انها للمكتوبة ، وانها لصلاة رسول الله  صلي الله عليه وسلم  ما اخطات الا شيءا سهوت عنه ، ثم قال : ان رسول الله  صلي الله عليه وسلم  قال : ( لا تشددوا علي انفسكم فيشدد عليكم ، فان قوما شددوا علي انفسهم ، فشدد عليهم ، فتلك بقاياهم في الصوامع والديار ، رهبانية ابتدعوها ما كتبناها عليهم ) . ثم غدا من الغد ، فقال الا تركب لننظر ونعتبر ؟ قال : نعم ، فركبوا جميعا ، فاذا بديار باد اهلها وانقضوا وفنوا ، خاوية علي عروشها ، فقال : تعرف هذه الديار ؟ فقال : ( ما اعرفني بها وباهلها ، هءلاء اهل ديار اهلكهم البغي والحسد ، ان الحسد يطفء نور الحسنات ، والبغي يصدق ذلك او يكذبه ، والعين تزني ، والكف والقدم  والجسد واللسان ، والفرج يصدق ذلك او يكذبه ) . اخرجه ابو داود . * * * غريب الحديث * * * دقيقة : اراد بقوله : ( صلاة دقيقة ) اي : خفيفة لا اطالة فيها ، ولا تكلف ولا رياء . رهبانية ابتدعوها : الرهبانية : ترك الملاذ من المطعم ، والمشرب ، والمنكح ، والمسكن الحلال ، والانقطاع في الصوامع ، كما يفعله رهابين النصاري ، وابتداعها : فعلها من عند انفسهم ، من غير ان تفرض عليهم ، او تسن لهم . باد اهلها : باد القوم : اذا هلكوا وانقرضوا . خاوية : خوي البيت : اذا سقط واذا خلا . عروشها : عريش البيت ، سقفه ، والمعني : ان البيت اذا سقط سقط بعضه علي بعض ، واصل ذلك : ان يسقط السقف ، ثم تسقط الحيطان عليه . البغي : مجاوزة الحد في الظلم والتعدي .
  ( خ د س ) انس بن مالك  رضي الله عنه  قال : دخل رسول الله  صلي الله عليه وسلم  المسجد ، فاذا حبل ممدود بين الساريتين ، فقال : ما هذا الحبل ؟  قالوا : حبل لزينب ، فاذا فترت تعلقت به ، فقال النبي  صلي الله عليه وسلم  : ( لا ، حلوه ، ليصل احدكم نشاطه ، فاذا فتر فليقعد ) هذه رواية البخاري والنساءي . وفي رواية ابي دواد : ( ما هذا الحبل ) ؟ فقيل : يا رسول الله ، حمنة بنت جحش تصلي ، فاذا اعيت تعلقت به ، فقال : ( حلوه ، لتصلي ما اطاقت ، فاذا اعيت فلتجلس ) . وفي رواية له قالوا : زينب تصلي ، فاذا كسلت ، او فترت امسكت به ، فقال : ( حلوه ، ليصل احدكم نشاطه ، فاذا كسل او فتر فليقعد ) . * * * غريب الحديث * * * فترت : الفتور : ضد النشاط والخفة . اعيت : الاعياء : التعب .
  ( خ م ط س ) عاءشة  رضي الله عنها  قالت : كانت عندي امراة من بني اسد ، فدخل علي رسول الله  صلي الله عليه وسلم  فقال : ( من هذه ؟ ) قلت : فلانة ، لا تنام من الليل ، تذكر من صلاتها ، قال : ( مه ، عليكم من الاعمال ما تطيقون ، فان الله لا يمل حتي تملوا ، وكان احب الدين ما داوم  عليه صاحبه ) ، اخرجه البخاري ومسلم والنساءي . وفي اخري لمسلم : ان الحولاء بنت تويت مرت بها ، وعندها رسول الله  صلي الله عليه وسلم  فقلت : هذه الحولاء بنت تويت ، وزعموا انها لا تنام الليل ، فقال رسول الله  صلي الله عليه وسلم  : ( لا تنام الليل ؟ خذوا من العمل ما تطيقون ، فوالله لا يسام الله حتي تساموا ) . واخرجه ( الموطا ) مرسلا عن اسماعيل بن ابي حكيم ، انه بلغه ان رسول الله  صلي الله عليه وسلم  سمع امراة من الليل تصلي ، فقال : ( من هذه ؟ ) قيل : الحولاء بنت تويت لا تنام الليل ، فكره ذلك ، حتي عرفت الكراهية في وجهه ، ثم قال : ( ان الله لا يمل حتي تملوا ، اكلفوا من العمل ما لكم به طاقة ) . * * [ شرح الغريب ] * * ( مه ) بمعني : اسكت . ( لا يسام ) السامة : الضجر والملل ، والمعني مثله في قوله : ' لا يمل حتي تملوا ' . 
  ( ت ) ابو هريرة  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  قال : ( ان لكل شء شرة ، ولكل شرة فترة ، فان صاحبها سدد وقارب فارجوه ، وان اشير اليه بالاصابع فلا تعدوه ) اخرجه الترمذي . * * * غريب الحديث * * * شرة : الشرة : النشاط ، ويقال : شرة الشباب : اوله .
  ( خ ت ) ابو جحيفة  رضي الله عنه  قال : اخي النبي  صلي الله عليه وسلم  بين سلمان وابي الدرداء ، فزار سلمان ابا الدرداء ، فراي ام الدرداء متبذلة ، فقال لها : ما شانك ؟ فقالت : اخوك ابو الدرداء ليس له حاجة في الدنيا ،  فجاء ابو الدرداء ، فصنع له طعاما ، فقال له : كل ، فاني صاءم ، قال : ما انا باكل حتي تاكل ، فاكل ، فلما كان الليل ذهب ابو الدرداء يقوم ، فقال : نم ، فنام ، ثم ذهب يقوم ، فقال : نم ، فلما كان من اخر الليل ، قال : سلمان : قم الان ، فصليا ، فقال له سلمان : ان لربك عليك حقا ، وان لنفسك عليك حقا ، ولاهلك عليك حقا ، فاعط كل ذي حق حقه ، فاتي النبي  صلي الله عليه وسلم  ، فذكر ذلك له ، فقال النبي  صلي الله عليه وسلم  : ( صدق سلمان ) اخرجه البخاري والترمذي . وزاد الترمذي فيه ( ولضيفك عليك حقا ) .
  ( م ت ) حنظلة بن الربيع الاسيدي  رضي الله عنه  وكان من كتاب رسول الله  صلي الله عليه وسلم  قال : لقيني ابو بكر ، فقال : كيف انت يا حنظلة ؟ قال : قلت : نافق حنظلة قال : سبحان الله ! ما تقول ؟ قال : قلت : نكون عند رسول الله  صلي الله عليه وسلم  ، يذكرنا بالنار والجنة [ حتي ] كانا راي  عين ، فاذا خرجنا من عند رسول الله  صلي الله عليه وسلم  ، عافسنا الازواج والاولاد ، والضيعات ، ونسينا كثيرا ، قال ابو بكر  رضي الله عنه  : فوالله انا لنلقي مثل هذا ، فانطلقت انا وابو بكر حتي دخلنا علي رسول الله  صلي الله عليه وسلم  ، فقلت : نافق حنظلة يا رسول الله . فقال رسول الله  صلي الله عليه وسلم  : ( وما ذاك ؟ ) قلت : يا رسول الله نكون عندك تذكرنا بالنار والجنة [ حتي ] كانا راي عين ، فاذا خرجنا من عندك عافسنا الازواج والاولاد والضيعات ، ونسينا كثيرا . فقال رسول الله  صلي الله عليه وسلم  : ( والذي نفسي بيده ، لو تدومون علي ما تكونون عندي ، وفي الذكر ، لصافحتكم الملاءكة علي فرشكم ، وفي طرقكم ، ولكن يا حنظلة ساعة وساعة  ثلاث مرار  ) . وفي رواية قال : كنا عند رسول الله  صلي الله عليه وسلم  ، فذكر النار ، ثم جءت الي البيت ، فضاحكت الصبيان ، ولاعبت المراة ، فخرجت ، فلقيت ابا بكر ، فذكرت ذلك له . فقال : وانا قد فعلت مثل ما تذكر ، فلقينا رسول الله  صلي الله عليه وسلم  ، فقلت : يا رسول الله نافق حنظلة ، فقال : ( مه ؟ ) فحدثته بالحديث . وقال ابو بكر : وانا فعلت مثل ما فعل . فقال : ( يا حنظلة ، ساعة وساعة ، لو كانت تكون قلوبكم كما تكون عند الذكر لصافحتكم الملاءكة ، حتي تسلم عليكم في الطريق ) . اخرجه مسلم والترمذي . الا  ان الترمذي قال : ( ساعة وساعة ، ساعة وساعة ) . واقتصر الترمذي ايضا منه علي طرف يسير قال : قال رسول الله  صلي الله عليه وسلم  : ( لو انكم تكونون كما تكونون عندي ، لاظلتكم الملاءكة باجنحتها ) . * * * غريب الحديث * * * نافق : النفاق : ضد الاخلاص ، واراد به في الحديث : انني في الظاهر اذا كنت عند النبي  صلي الله عليه وسلم  اخلصت ، واذا انفردت عنه رغبت في الدنيا ، وتركت ما كنت عليه ، فكانه نوع من الظاهر والباطن ، وما كان يرضي ان يسامح به نفسه ، وكذلك كان الصحابة  رضي الله عنهم  اجمعين ، يءاخذون انفسهم باقل الاشياء . راي عين : جعلت الشء راي عينك ، اي : بمراي منك ، وفي مقابلتك ، وهو منصوب باضمار ( نري ) . عافسنا : المعافسة : المعالجة والممارسة والملاعبة . الضيعات : جمع ضيعة ، وهي الصناعة والحرفة .
  ( ط ) مالك بن انس  رحمه الله  بلغه : ان عاءشة ، كانت ترسل الي اهلها بعد العتمة ، فتقول : الا تريحون الكتاب ؟ . اخرجه ( الموطا ) .  وهذه احاديث وجدتها في كتاب رزين ، ولم اجدها في الاصول * * * غريب الحديث * * * الكتاب : جمع كاتب ، وارادت الحفظة الكرام الكاتبين ، وذلك بعثا لهم علي ترك العمل ، وطلب الاقتصاد .
  ( ) ابن عباس  رضي الله عنهما  قال : كانت مولاة لرسول الله  صلي الله عليه وسلم  خبر عنها : انها تقوم الليل ، وتصوم النهار ، فقال رسول الله  صلي الله عليه وسلم  : ( لكل عامل شرة ، ولكل شرة فترة ، فمن صارت فترته الي سنتي فقد اهتدي ، ومن اخطا فقد ضل ) .
  ( ) معاذ بن جبل  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  قال : ( لن ينجي احدكم عمله ) . قالوا : ولا انت ؟ قال : ( ولا انا الا ان يتغمدني الله برحمة منه ، فسددوا ، وقاربوا ، واغدوا ، وروحوا ، وشيءا من الدلجة والقصد القصد القصد ، تبلغوا ، وان احب الاعمال الي الله تعالي ما داوم عليه صاحبه ، وان قل ، فاكلفوا من العمل ما تطيقون ، فان الله لا يمل حتي تملوا ) .
  ( ) ابو هريرة  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  :  ( خير الامور اوساطها ) . * * [ شرح الغريب ] * * ( خير الامور اوساطها ) معناه : ان كل خصلة محمودة ، فان لها طرفين مذمومين ، مثل ان السخاء وسط بين البخل والتبذير ، والشجاعة وسط بين الجبن والتهور ، والانسان مامور ان يتجنب كل وصف مذموم ، وتجنبه بالتعري منه ، والتبعد عنه ، فكلما ازداد منه بعدا ازداد منه تعريا ، وابعد الجهات والاماكن والمقادير من كل طرفين ، فانما هو وسطها ، لان الوسط ابعد الجهات من الاطراف ، وهوغاية البعد عنها ، فاذا كان في الوسط ، فقد تعري عن الاطراف المذمومة بقدر الامكان ، فلهذا كان خير الامور اوساطها .
  ( الكتاب الثالث في الامانة )
  ( خ م ت ) حذيفة بن اليمان  رضي الله عنه  قال : حدثنا رسول الله  صلي الله عليه وسلم  حديثين ، وقد رايت احدهما ، وانا انتظر الاخر ، حدثنا  ان الامانة نزلت في جذر قلوب الرجال ، ثم نزل القران ، فعلموا من القران ، وعلموا من السنة . ثم حدثنا عن رفع الامانة ، فقال : ( ينام الرجل النومة ، فتقبض الامانة من قلبه ، فيظل اثرها مثل اثر الوكت ، ثم ينام النومة ، فتقبض الامانة من قبله ، فيظل اثرها مثل اثر المجل ، كجمر دحرجته علي رجلك فنفط ، فتراه منتبرا ، وليس فيه شء  ثم اخذ حصي فدحرجه علي رجله  فيصبح الناس يتبايعون ، فلا يكاد احد يءدي الامانة ، حتي يقال : ان في بني فلان رجلا امينا ، حتي يقال للرجل : ما اجلده ، ما اظرفه ، ما اعقله ، وما في قلبه مثقال حبة من خردل من ايمان ، ولقد اتي علي زمان وما ابالي ايكم بايعت ، لءن كان مسلما ليردنه علي دينه ، وان كان  نصرانيا او يهوديا ليردنه علي ساعيه ، واما اليوم فما كنت ابايع منكم الا فلانا وفلانا ) اخرجه البخاري ومسلم والترمذي . * * * غريب الحديث * * * جذر : الشء : بفتح الجيم وكسرها : اصله . الوكت : النقطة في الشء من غير لونه . المجل : غلظ الجلد من اثر العمل ، وقيل : انما هي النفاطات في الجلد . منتبرا : المنتبر : المنتفخ وليس فيه شء ، وكل شء رفع شيءا ، فقد نبره ، ومنه اشتق المنبر . ساعيه : الساعي : واحد السعاة ، وهم الولاة علي القوم ، يعني ان المسلمين كانوا مهتمين بالاسلام ، فيحتفظون بالصدق والامانة ، والملوك ذوو عدل ، فما كنت ابالي من اعامل : ان كان مسلما رده الي بالخروج عن الحق عمله بمقتضي الاسلام ، وان كان غير مسلم انصفني منه عامله .
  ( خ ) ابو هريرة  رضي الله عنه  قال : بينما رسول الله  صلي الله عليه وسلم  في مجلس يحدث القوم ، جاءه اعرابي فقال : متي الساعة ؟ فمضي رسول الله  صلي الله عليه وسلم  يحدث ، فقال بعض القوم : سمع ما قال ، فكره ما قال ، وقال بعضهم :  بل لم يسمع ، حتي اذا قضي حديثه ، قال : ( اين الساءل عن الساعة ؟ ) قال : ها انا يا رسول الله ، قال : ( اذا ضيعت الامانة فانتظر الساعة ) . قال : كيف اضاعتها يا رسول الله ؟ قال : ( اذا وسد الامر الي غير اهله فانتظر الساعة ) . اخرجه البخاري . * * * غريب الحديث * * * وسد : بمعني : اسند .
  ( ت د ) ابو هريرة  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( اد الامانة الي من اءتمنك ، ولا تخن من خانك ) . اخرجه الترمذي  وابو داود .
  ( د ) يوسف بن ماهك  رحمه الله  [ تابعي مكي ] قال : كنت اكتب لفلان نفقة ايتام كان وليهم ، فغالطوه بالف درهم ، فاداها اليهم ، فادركت لهم من اموالهم مثلها ، قال : قلت : اقبض الالف الذي ذهبوا به منك ، قال : حدثني ابي انه سمع رسول الله  صلي الله عليه وسلم  يقول : ( اد الامانة الي من اءتمنك ، ولا تخن من خانك ) . اخرجه ابو داود .
  ( خ م د س ) ابو موسي الاشعري  رضي الله عنه  ان النبي   صلي الله عليه وسلم  قال : ( ان الخازن المسلم الامين الذي يعطي ما امر به ، فيعطيه كاملا موفرا ، طيبة به نفسه ، فيدفعه ، الي الذي امر له به ، احد المتصدقين ) . هذه رواية البخاري ومسلم وابي داود . ورواية النساءي قال : ( المءمن للمءمن كالبنيان يشد بعضه بعضا )  وقال : ( الخازن الامين الذي يعطي ما امر به طيبا به نفسه ، احد المتصدقين ) .
  ( الكتاب الرابع في الامر بالمعروف والنهي عن المنكر )
  ( م ت د س ) ابو سعيد الخدري  رضي الله عنه  قال طارق بن شهاب : اول من بدا بالخطبة يوم العيد قبل الصلاة مروان ، فقام اليه رجل فقال : الصلاة قبل الخطبة ، قال : قد ترك ما هنالك ، فقال ابو سعيد : اما هذا فقد قضي ما عليه ، سمعت رسول الله  صلي الله عليه وسلم  يقول : ( من راي منكم منكرا فليغيره بيده ، فان لم يستطع فبلسانه ، فان لم يستطع فبقلبه ، وذلك اضعف الايمان ) . هذه رواية مسلم .  ورواية الترمذي مثلها ، الا انه قال : فقام رجل فقال : يا مروان ، خالفت السنة . فقال : يا فلان ، ترك ما هنالك . وفي رواية ابي داود : قال : يا مروان ، خالفت السنة ، اخرجت المنبر في يوم عيد ، ولم يكن يخرج فيه ، وبدات بالخطبة قبل الصلاة ، فقال ابو سعيد : من هذا ؟ قالوا : فلان ابن فلان ، فقال : اما هذا فقد قضي ما عليه . . . وذكر الحديث . وفي رواية النساءي ، لم يذكر العيد والخطبة ، وهذا لفظه : ان رسول الله  صلي الله عليه وسلم  قال : ( من راي منكم منكرا فغيره فقد برء ، ومن لم يستطع ان يغيره بيده ، فغيره بلسانه فقد برء ، ومن لم يستطع ان يغيره بلسانه فغيره بقلبه فقد برء ، وذلك اضعف الايمان ) . * * * غريب الحديث * * * ترك ما هنالك : اي ترك ما تعرفه من السنة التي قد انكرت مخالفتي لها .
  ( م ) عبد الله بن مسعود  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم   قال : ( ما من نبي بعثه الله في امة قبلي ، الا كان له من امته حواريون ، واصحاب ياخذون بسنته ، ويقتدون بامره ، ثم انها تخلف من بعدهم خلوف يقولون ما لا يفعلون ، ويفعلون ما لا يءمرون ، فمن جاهدهم بيده فهو مءمن ، ومن جاهدهم بلسانه فهو مءمن ، ومن جاهدهم بقلبه فهو مءمن ، ليس وراء ذلك من الايمان حبة خردل ) . قال ابو رافع : فحدثت عبد الله بن عمر ، فانكره علي ، فقدم ابن مسعود فنزل بقناة فاستتبعني اليه ابن عمر يعوده ، فانطلقت معه ، فلما جلسنا سالت ابن مسعود عن هذا الحديث ؟ فحدثنيه ، كما حدثته ابن عمر . اخرجه مسلم .  * * * غريب الحديث * * * حواريون : الحواري : الناصر ، والمختص بالرجل المصافي له ، ومنه الحواريون اصحاب المسيح [ عيسي ] عليه السلام . خلوف : جمع خلف ، وهو من يجء بعد من مضي ، قال الله تعالي : { فخلف من بعدهم خلف } [ مريم :  ] . فاستتبعني : استتبعني : اخذني معه ، وجعلني تبعا له .
  ( د ت ) وعنه قال : قال رسول الله  صلي الله عليه وسلم  : ( ان اول ما دخل النقص علي بني اسراءيل : انه كان الرجل يلقي الرجل ، فيقول له : يا هذا اتق الله ، ودع ما تصنع ، فانه لا يحل لك ، ثم يلقاه من الغد ، وهو علي حاله ، فلا يمنعه ذلك ان يكون اكيله وشريبه وقعيده ، فلما فعلوا ذلك ، ضرب الله قلوب بعضهم ببعض . ثم قال : { لعن الذين كفروا من بني اسراءيل علي لسان داود وعيسي ابن مريم ، ذلك بما عصوا وكانوا يعتدون * كانوا لا يتناهون عن منكر فعلوه ، لبءس ما كانوا يفعلون * تري كثيرا منهم يتولون الذين كفروا ، لبءس ما قدمت لهم انفسهم }  الي قوله  { فاسقون } [ الماءدة : الايات    ] ثم قال : كلا والله ، لتامرن بالمعروف ، ولتنهون عن المنكر ، ولتاخذن علي يد الظالم ، ولتاطرنه علي الحق اطرا ، او لتقصرنه علي الحق قصرا ) .  زاد في رواية : ( او ليضربن الله بقلوب بعضكم بعضا ، ثم ليلعننكم كما لعنهم ) . هذه رواية ابي داود . ورواية الترمذي قال : قال رسول الله  صلي الله عليه وسلم  : ( لما وقعت بنو اسراءيل في المعاصي ، نهتهم علماءهم ، فلم ينتهوا ، فجالسوهم في مجالسهم ، واكلوهم وشاربوهم ، فضرب الله قلوب بعضهم ببعض ، ولعنهم علي لسان داود وعيسي بن مريم ، ذلك بما عصوا وكانوا يعتدون ) فجلس رسول الله  صلي الله عليه وسلم  وكان متكءا ، فقال : ( لا ، والذي نفسي بيده ، حتي تاطروهم علي الحق  اطرا ) . * * * غريب الحديث * * * اكيله وشريبه وقعيده : الاكيل والشريب والقعيد : المءاكل والمشارب ، والمقاعد : المجالس ، وهذا البناء فعيل بمعني مفاعل . لتاطرنه : الاطر : العطف ، اي : لتعطفونه ، وتردونه الي الحق الذي خالفه . لتقصرنه : القصر : الحبس ، يقال : قصرت نفسي علي الشء ، اي : حبستها عليه .
  ( ت ) ابو عبيدة بن عبد الله بن مسعود  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  قال : لما وقع النقص في بني اسراءيل ، كان الرجل منهم يري اخاه يقع علي الذنب ، فينهاه عنه ، فاذا كان الغد ، لم يمنعه ما راي منه ان يكون اكيله وشريبه وخليطه ، فضرب الله قلوب بعضهم ببعض ، ونزل فيهم القران فقال : { لعن الذين كفروا من بني اسراءيل علي لسان داود وعيسي ابن مريم ، ذلك بما عصوا وكانوا يعتدون } وقرا حتي بلغ  { ولو كانوا يءمنون  بالله والنبي وما انزل اليه ما اتخذوهم اولياء ، ولكن كثيرا منهم فاسقون } . [ الماءدة : الايات  :  ] . قال : وكان متكءا فجلس وقال : ( لا ، حتي تاخذوا علي يد الظالم ، فتاطروه علي الحق اطرا ) . اخرجه الترمذي . وقال : قد رواه ابو عبيدة عن ابن مسعود عن النبي  صلي الله عليه وسلم  بمثله ، فيكون هذا الحديث ، هو الحديث الذي قبله من رواية ابي داود .
  ( ت د ) قيس بن ابي حازم  رضي الله عنه  قال : قال ابو بكر ، بعد ان حمد الله واثني عليه : يا ايها الناس ، انكم تقرءون هذه الاية وتضعونها علي غير موضعها ، { يا ايها الذين امنوا عليكم انفسكم لا يضركم من ضل اذا اهتديتم } [ الماءدة : الاية  ] ، وانما سمعنا رسول الله  صلي الله عليه وسلم  يقول : ( ان الناس اذا راوا الظالم فلم ياخذوا علي يديه ، اوشك ان  يعمهم الله بعقاب ) . واني سمعت رسول الله  صلي الله عليه وسلم  يقول : ( ما من قوم يعمل فيهم بالمعاصي ، ثم يقدرون علي ان يغيروا ولا يغيرون ، الا يوشك ان يعمهم الله بعقاب ) . وقال شعبة فيه : ( ما من قوم يعمل فيهم بالمعاصي ، وهم اكثر ممن يعمل بها ) هذه رواية ابي داود . وله ايضا ، وللترمذي مختصرا الي قوله : ( ان يعمهم الله بعقاب ) . الاولي . * * * غريب الحديث * * * اوشك : اسرع ، وقد سبق ذكره في كتاب ( الاعتصام ) .
  ( د ) جرير بن عبد الله [ البجلي ]  رضي الله عنه  قال : سمعت رسول الله  صلي الله عليه وسلم  يقول : ( ما من رجل يكون في قوم يعمل فيهم بالمعاصي ، يقدرون علي ان يغيروا عليه ولا يغيرون ، الا اصابهم الله منه بعقاب قبل ان يموتوا ) .  اخرجه ابو داود .
  ( ت ) حذيفة [ بن اليمان ]  رضي الله عنه  عن النبي  صلي الله عليه وسلم  قال : ( والذي نفسي بيده لتامرن بالمعروف ولتنهون عن المنكر ، او ليوشكن الله يبعث عليكم عقابا منه ، ثم تدعونه فلا يستجيب لكم ) . اخرجه الترمذي .
  ( د ) ابن مسعود  رضي الله عنه  قال : سمعت رسول الله  صلي الله عليه وسلم  يقول : ( انكم منصورون ومصيبون ومفتوح عليكم ، فمن ادرك ذلك منكم فليتق الله ، وليامر بالمعروف ، ولينه عن المنكر ، ومن كذب علي متعمدا فليتبوا مقعده من النار ) . اخرجه ابو داود . * * * غريب الحديث * * * فليتبوا : اي : فليتخذ له مباءة ، والمباءة : المنزل . 
  ( د ) هرس بن عميرة الكندي  رضي الله عنه  ان النبي  صلي الله عليه وسلم  قال : ( اذا عملت الخطيءة في الارض ، كان من شهدها وكرهها  وفي رواية  فانكرها ، كمن غاب عنها ، ومن غاب عنها فرضيها ، كان كمن شهدها ) . اخرجه ابو داود .
  ( ت د ) ابو سعيد الخدري  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( ان من اعظم الجهاد كلمة عدل عند سلطان جاءر ) . هذه رواية الترمذي . ورواية ابي داود : ( افضل الجهاد كلمة عدل عند سلطان جاءر ، وامير جاءر ) .
  ( س ) طارق بن شهاب  رضي الله عنه  ان رجلا سال النبي  صلي الله عليه وسلم  ، وقد وضع رجله في الغرز : اي الجهاد افضل ؟ قال : ( كلمة حق عند سلطان جاءر ) . اخرجه النساءي .  * * * غريب الحديث * * * الغرز : ركاب رحل البعير من جلد ، فاذا كان من خشب او حديد ، فهو ركاب . كذا ذكره الجوهري .
  ( ) ابو هريرة  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( اتدرون كيف دخل النقص علي بني اسراءيل ؟ . . . ) وذكر الحديث بنحو حديث ابن مسعود ، وابي عبيدة وقد سبق ، هذا وجدته في كتاب رزين ، ولم اجده في الاصول .
  ( الكتاب الخامس في الاعتكاف )
  ( خ م ط د ت س ) عاءشة  رضي الله عنها  ان النبي  صلي الله عليه وسلم  كان يعتكف العشر الاواخر من رمضان ، حتي توفاه الله عز وجل ، ثم اعتكف ازواجه بعده . وفي رواية : كان يجاور العشر الاواخر من رمضان ، ويقول : ( تحروا ليلة القدر في العشر الاواخر من رمضان ) . وفي رواية : كان يعتكف في كل رمضان ، فاذا صلي الغداة ، جاء  مكانه الذي اعتكف فيه ، قال : فاستاذنته عاءشة ان تعتكف ، فاذن لها ، فضربت فيه قبة ، فسمعت بها حفصة ، فضربت فيه قبة ، وسمعت زينب ، فضربت قبة اخري ، فلما انصرف رسول الله  صلي الله عليه وسلم  من الغداة ، ابصر اربع قباب ، فقال : ( ما هذا ؟ ) فاخبر خبرهن . فقال : ( ما حملهن علي هذا ؟ البر ؟ انزعوها ، فلا اراها ) ، فنزعت ، فلم يعتكف في رمضان حتي اعتكف في اخر العشر من شوال . وفي اخري : كان رسول الله  صلي الله عليه وسلم  اذا اراد ان يعتكف ، صلي الفجر ثم دخل معتكفه  ثم ذكر نحوه . . .  الي ان قال : فلما صلي رسول الله  صلي الله عليه وسلم  الفجر ، نظر فاذا الاخبية ، فقال : ( البر يردن ؟ ) فامر بخباءه فقوض ، وترك الاعتكاف في شهر رمضان ، حتي اعتكف في العشر الاول من شوال . هذه روايات البخاري ومسلم . ورواية ( الموطا ) ان رسول الله  صلي الله عليه وسلم  اراد ان يعتكف ، فلما انصرف الي المكان الذي اراد ان يعتكف فيه ، وجد اخبية : خباء عاءشة ، وخباء حفصة ، وخباء زينب ، فلما راها سال عنها ؟ فقيل له : هذا خباء عاءشة وحفصة وزينب ، فقال رسول الله  صلي الله عليه وسلم  : ( البر يقولون بهن ، ثم  انصرف فلم يعتكف ، حتي اعتكف عشرا من شوال ) . واخرجه الترمذي عن عاءشة وابي هريرة معا مختصرا ، قال : كان يعتكف العشر الاواخر من رمضان حتي قبضه الله عزوجل . وله في اخري عن عاءشة : كان اذا ان يعتكف صلي الفجر ، ثم دخل في معتكفه . واخرجه ابو داود مثل رواية البخاري ومسلم الاولي . واخرجه ايضا قال : كان رسول الله  صلي الله عليه وسلم  اذا اراد ان يعتكف صلي الفجر ، ثم دخل معتكفه ، وانه اراد مرة ان يعتكف في العشر الاواخر من رمضان ، قالت : فامر ببناءه فضرب ، فلما رايت ذلك امرت ببناءي فضرب ، قالت : وامر غيري من ازواج النبي  صلي الله عليه وسلم  ببناءها فضرب ، فلما صلي الفجر ، نظر الي الابنية ، فقال : ( ما هذه ؟ البر يردن ؟ البر يردن ؟ )  وفي رواية : ( البر يردن ؟ ) مرة واحدة  فامر ببناءه فقوض ، وامر ازواجه بابنيتهن فقوضت ، ثم اخر الاعتكاف الي العشر الاول ، يعني من شوال . وفي رواية قال : اعتكف عشرين من شوال . واخرجه النساءي بنحو من رواية البخاري ومسلم الاخرة .  * * * غريب الحديث * * * يعتكف : العكف : الحبس ، يقال : عكفه يعكفه ويعكفه عكفا : حبسه ووقفه ، ومنه الاعتكاف في المسجد ، وهو حبس النفس به ، وعكف علي الشء يعكف ويعكف عكوفا : اقبل عليه مواظبا . يجاور : المجاورة : الاعتكاف في المسجد . تحروا : التحري : القصد والاجتهاد في الطلب . قبة : القبة من الابنية : ذوات الجدران معروفة ، ومن الخيام : بيت صغير . خباء : الخباء : واحد الاخبية من وبر او صوف ، ولا يكون من شعر ، وهو علي عمودين او ثلاثة ، وما فوق ذلك فهو بيت . فقوض : تقويض الخباء والخيمة : رفعهما وازالتهما . ببناءه : البناء : واحد الابنية ، وهي البيوت التي يسكنها العرب في الصحراء ، فمنها الطراف ، ويكون من ادم ، والخباء ، وقد ذكر ، والقبة ، وقد ذكرت . البر : اسم جامع للخير كله ، ومنه قوله تعالي : { ولكن البر من ءامن بالله . . . } الاية [ البقرة :  ] . 
  ( خ م ) ابو سعيد الخدري  رضي الله عنه  قال : اعتكفنا مع رسول الله  صلي الله عليه وسلم  العشر الاوسط ، فلما كان صبيحة عشرين نقلنا متاعنا ، فاتي النبي  صلي الله عليه وسلم  فقال : ( من كان اعتكف فليرجع الي معتكفه ، فاني رايت هذه الليلة ، ورايتني اسجد في ماء وطين ، فلما رجع الي معتكفه ، هاجت السماء ، فمطرنا ، فوالذي بعثه بالحق ، لقد هاجت السماء من اخر ذلك اليوم ، وكان المسجد علي عريش ، فلقد رايت علي انفه وارنبته اثر الماء والطين ) . وفي رواية نحوه ، الا انه قال : حتي اذا كان ليلة احدي وعشرين ، وهي الليلة التي يخرج من صبيحتها من اعتكافه ، قال : ( من كان اعتكف معي فليعتكف العشر الاواخر ) . وفي اخري : كان النبي  صلي الله عليه وسلم  يجاور في رمضان العشر التي في وسط الشهر ، فاذا كان حين يمسي من عشرين ليلة تمضي ، ويستقبل احدي وعشرين ، رجع الي مسكنه ، ورجع من كان يجاور معه ، وانه قام في شهر جاور فيه الليلة التي كان يرجع فيها فخطب الناس ، وامرهم بما شاء الله ، ثم قال : ( كنت اجاور  هذه العشر ، ثم قد بدا لي ان اجاور هذه العشر الاواخر ، فمن كان اعتكف معي فليثبت في معتكفه )  ثم ذكره  وفي ( فوكف المسجد في مصلي النبي  صلي الله عليه وسلم  ليلة احدي وعشرين . . . ) الحديث . اخرجه البخاري ومسلم . * * * غريب الحديث * * * هاجت السماء : اذا تغيمت ، وكثر ريحها فامطرت . عريش : العريش : سقف من خشب وحشيش ، ونحو ذلك . وارنبته : ارنبة الانف : هي طرف الانف من مقدمه .
  ( خ م د ) عبد الله بن عمر  رضي الله عنهما  ان رسول الله  صلي الله عليه وسلم  كان يعتكف العشر الاواخر من رمضان ، اخرجه البخاري ومسلم . وزاد مسلم في رواية اخري ، قال نافع : وقد اراني ابن عمر المكان الذي كان يعتكف فيه رسول الله  صلي الله عليه وسلم  من المسجد ، واخرجه ابو داود بزيادة مسلم . 
  ( خ د ) ابو هريرة  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  كان يعتكف رمضان عشرة ايام ، فلما كان العام الذي قبض فيه اعتكف عشرين . اخرجه البخاري وابو داود .
  ( ت ) انس بن مالك  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  كان يعتكف العشر الاواخر من رمضان ، فلم يعتكف عاما ، فلما كان من العام المقبل اعتكف عشرين . اخرجه الترمذي .
  ( د ) ابي بن كعب  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  كان يعتكف العشر الاواخر من رمضان . . . وذكر مثله . اخرجه ابو داود .
  ( خ م ط د ت س ) عاءشة  رضي الله عنها  كانت ترجل النبي  صلي الله عليه وسلم  وهي حاءض . وهو معتكف في المسجد ، وهي في حجرتها يناولها راسه . زاد في رواية : وكان لا يدخل البيت الا لحاجة اذا كان معتكفا . وفي رواية : كان لا يدخل البيت الا لحاجة الانسان .  وفي رواية : قالت عاءشة  رضي الله عنها  : ان كنت لادخل البيت للحاجة والمريض فيه ، فما اسال عنه الا وانا مارة ، هذه رواية البخاري ومسلم . وفي رواية الترمذي وابي داود و ( الموطا ) : كان اذا اعتكف ادني الي راسه فارجله . وكان لا يدخل البيت الا لحاجة الانسان . وفي اخري للموطا : ان عاءشة كانت اذا اعتكفت لا تسال عن المريض الا وهي تمشي ، لا تقف . وفي اخري لابي داود قالت : كان رسول الله  صلي الله عليه وسلم  يكون معتكفا في المسجد ، فيناولني راسه من خلل الحجرة ، فاغسل راسه . وفي رواية : فارجله وانا حاءض . وفي اخري لابي داود قالت : كان رسول الله  صلي الله عليه وسلم  يمر بالمريض وهو معتكف . فيمر ولا يعرج يسال عنه .  وفي رواية : قالت : والسنة للمعتكف الا يعود مريضا ، ولا [ يشيع ] جنازة ، ولا يمس امراة ولا يباشرها ، ولا يخرج لحاجة ، الا لما لابد منه ، قالت : ولا اعتكاف الا بصوم ، ولا اعتكاف الا في مسجد جامع . وفي رواية النساءي : كان يخرج الي راسه من المسجد ، وهو مجاور ، فاغسله ، وانا حاءض . وفي اخري : كان يومء الي راسه ، وهو معتكف ، فاغسله ، وانا حاءض . * * * غريب الحديث * * * ترجل : الترجيل : تسريح الشعر . حواءج الانسان : كثيرة ، والمراد منها هاهنا : كل ما يضطر اليه مما لا يجوز له فعله في معتكفه .
  ( خ د ) عاءشة  رضي الله عنها  قالت : لقد اعتكفت مع رسول الله  صلي الله عليه وسلم  امراة من ازواجه مستحاضة ، فكانت تري الدم والصفرة ،  وهي تصلي ، وربما وضعت الطست تحتها وهي تصلي . اخرجه البخاري وابو داود . وفي اخري للبخاري نخوه ، وفيه : وهي مستحاضة تري الدم ، فربما وضعت الطست تحتها من الدم . وزعم [ عكرمة ] ان عاءشة رات ماء العصفر ، فقالت : كان هذا شء كانت فلانة تجده .
  ( ط ) ابن شهاب  رحمه الله  ان رسول الله  صلي الله عليه وسلم  : كان يذهب لحاجة الانسان في البيوت ، وهو معتكف . اخرجه ( الموطا ) مرسلا .
  ( خ م د ) علي بن الحسين  رضي الله عنهما  ان صفية زوج النبي  صلي الله عليه وسلم   ورضي الله عنها  قالت : كان النبي  صلي الله عليه وسلم  معتكفا ، فاتيته ازوره ليلا ، فحدثته ثم قمت لانقلب ، فقام معي ليقلبني ، وكان مسكنها في دار اسامة بن زيد ، فمر رجلان من الانصار ، فلما رايا النبي  صلي الله عليه وسلم  اسرعا ، فقال النبي  صلي الله عليه وسلم   ( علي رسلكما ، انها صفية بنت حيي ) فقالا : سبحان الله ، فقال : ( ان الشيطان يجري من ابن ادم مجري الدم ، واني خشيت ان يقذف في قلوبكما شرا )  او قال : شيءا  . وفي رواية : انها جاءت تزوره في اعتكافه في المسجد في العشر الاواخر من رمضان  وفيه : حتي اذا بلغت باب المسجد عند باب ام سلمة  ثم ذكر معناه ، وقال فيه : ( ان الشيطان يبلغ من الانسان مبلغ الدم ) . ومن الرواة من قال : عن علي بن الحسين : ان النبي  صلي الله عليه وسلم  اتته صفية . اخرجه البخاري ومسلم وابو داود .  * * * غريب الحديث * * * لانقلب : الانقلاب : الرجوع من حيث جءت . علي رسلكما : يقال : افعله علي رسلك  بكسر الراء  اي : علي هينتك ومهلك . يقذف : يلقي ويوقع في انفسكم .
  ( خ م ت د س ) ابن عمر  رضي الله عنهما  ان عمر قال : يا رسول الله : اني نذرت في  الجاهلية ان اعتكف ليلة في المسجد الحرام . قال : ( فاوف بنذرك ) . ومنهم من قال : ( يوما ) . وفي رواية : عن ابن عمر عن عمر ، فجعله من مسند عمر . وفي اخري عن ابن عمر : ان عمر سال رسول الله  صلي الله عليه وسلم  ، وهو بالجعرانة ، بعد ان رجع من الطاءف ، فقال : يا رسول الله ، اني نذرت في الجاهلية ان اعتكف يوما في المسجد الحرام ، فكيف تري ؟ قال : ( اذهب فاعتكف يوما ) . قال : وكان رسول الله  صلي الله عليه وسلم  قد اعطاه جارية من الخمس ، فلما اعتق رسول الله  صلي الله عليه وسلم  سبايا الناس ، سمع عمر بن الخطاب اصواتهم يقولون : اعتقنا رسول الله  صلي الله عليه وسلم  . فقال : ما هذا ؟ قالوا : اعتق رسول الله  صلي الله عليه وسلم  سبايا الناس ، فقال عمر : يا عبد الله ، اذهب الي تلك الجارية فخل سبيلها . هذه رواية البخاري ومسلم . وفي اخري لهما : قال : ذكر عند ابن عمر عمرة رسول الله  صلي الله عليه وسلم  من الجعرانة ، فقال : لم يعتمر منها . قال : وكان عمر نذر اعتكاف يوم في الجاهلية . . . وذكر نحوه . واخرجه ابو داود ، نحو حديثه قبله ، ولم يذكر اللفظ . ثم قال : وذكر حديث السبي نحو ذلك . وفي رواية اخري له : قال عمر : يا رسول الله : اني نذرت [ في الجاهلية ] ان اعتكف في المسجد الحرام ليلة . وفي رواية : عند الكعبة ، فقال النبي  صلي الله عليه وسلم  : ( اوف بنذرك ) . واخرجه الترمذي والنساءي مختصرا ، ولم يذكر السبي ، ولا الجعرانة . 
  ( الكتاب السادس في احياء الموات )
  ( خ ) عاءشة  رضي الله عنها  ان النبي  صلي الله عليه وسلم  قال : ( من عمر ارضا ليست لاحد فهو احق ) .  قال عروة بن الزبير : قضي به عمر في خلافته . اخرجه البخاري . * * * غريب الحديث * * * الموات : الارض التي لم تزرع ولم تعمر ، ولا هي ملك احد ، واحياءها : مباشرة عمارتها بتاثير شء فيها ، من زرع او عمارة ، او احاطة حاءط او نحو ذلك .
  ( ط ت د ) عروة بن الزبير  رضي الله عنهما  ان رسول الله  صلي الله عليه وسلم  قال : ( من احيا ارضا ميتة فهي له ، وليس لعرق ظالم حق ) . اخرجه ( الموطا ) والترمذي . وزاد ابو داود : قال عروة : ولقد حدثني الذي حدثني هذا الحديث : ان رجلين اختصما الي رسول الله  صلي الله عليه وسلم  ، غرس احدهما في ارض الاخر ، فقضي لصاحب الارض بارضه ، وامر صاحب النخل ان يخرج نخله منها ،  قال : فلقد رايتها ، وانا لتضرب اصولها بالفءوس ، وانها لنخل عم ، حتي اخرجت منها . وفي اخري لابي داود بمعناه : وفيها  عوض الذي حدثني هذا  فقال الرجل من اصحاب النبي  صلي الله عليه وسلم  ، واكبر ظني انه ابو سعيد الخدري  قال : فانا رايت الرجل يضرب في اصول النخل . قال ابو داود : قال مالك : قال هشام : العرق الظالم : ان يغرس الرجل في ارض غيره ، فيستحقها بذلك . قال مالك : والعرق الظالم : كل ما اخذ واحتفر وغرس بغير حق . وفي اخري لابي داود ، قال عروة : اشهد ان رسول الله  صلي الله عليه وسلم  قضي ان الارض ارض الله ، والعباد عباد الله ، فمن احيا مواتا فهو احق به ، جاءنا بهذا عن رسول الله  صلي الله عليه وسلم  : الذين جاءوا بالصلاة عنه . * * * غريب الحديث * * * عم : جمع عميمة ، وهي التامة في الطول والالتفاف .
  ( د ) سمرة بن جندب  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  قال : ( من احاط حاءطا في موات فهو له ) . اخرجه ابو داود . 
  ( ت د ) سعيد بن زيد وجابر  رضي الله عنهما  ان رسول الله  صلي الله عليه وسلم  قال : ( من احيا ارضا ميتة فهي له ) . زاد سعيد : وليس لعرق ظالم حق . اخرجه الترمذي عنهما ، وابو داود عن سعيد وحده . * * * غريب الحديث * * * عرق ظالم : العرق الظالم قد ذكر تفسيره وشرحه في متن الحديث ، وفي الكلام مضاف محذوف ، تقديره : لذي عرق ظالم .
  ( ت ) جابر بن عبد الله  رضي الله عنهما  ان رسول الله  صلي الله عليه وسلم  قال : ( من احيا ارضا ميتة فهي له ) . اخرجه الترمذي . 
  ( ط ) ابن عمر  رضي الله عنهما  ان عمر بن الخطاب قال : ( من احيا ارضا ميتة فهي له ) . اخرجه ( الموطا ) .
  ( ) سعيد بن زيد  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  قال : ( من احيا ارضا ، قد عجز صاحبها عنها ، وتركها بمهلكة فهي له ) . هذا في كتاب رزين ، ولم اجده في الاصول . * * * غريب الحديث * * * بمهلكة : المهلكة ، موضع الهلاك ، او الهلاك نفسه .
  ( الكتاب السابع في الايلاء )
  ( خ ت س ) انس بن مالك  رضي الله عنه  قال : الي رسول الله  صلي الله عليه وسلم  من نساءه شهرا ، فكانت انفكت قدمه ، فجلس في علية له ، فجاء  عمر ، فقال : اطلقت نساءك ؟ قال : ( لا ، ولكن اليت منهن شهرا ، فمكث تسعا وعشرين ، ثم نزل ، فدخل علي ساءر نساءه ) . وفي رواية نحوه ، ولم يذكر عمر ، وفيه : فقالوا : يا رسول الله ، اليت شهرا ؟ قال : ( ان الشهر يكون تسعا وعشرين ) . وفي اخري : ان النبي  صلي الله عليه وسلم  صرع من فرس ، فجحش شقه ، او كتفه ، والي من نساءه شهرا ، فجلس في مشربة له ، درجها من جذوع ، فاتاه اصحابه يعودونه ، فصلي بها جالسا وهم قيام ، فلما سلم قال : ( انما جعل الامام ليءتم به ، فاذا صلي قاءما ، فصلوا قياما ، وان صلي قاعدا فصلوا قعودا ، ولا تركعوا حتي يركع ، ولا ترفعوا حتي يرفع ) . قال : ونزل لتسع وعشرين ، فقالوا : يا رسول الله ، انك اليت شهرا ، فقال : ( ان الشهر تسع وعشرون ) . هذه روايات البخاري ، ووافقه علي الرواية الثانية الترمذي والنساءي .  * * * غريب الحديث * * * الايلاء : الايلاء : اليمين ، والي يءلي : اذا حلف . هذا هو الاصل ، وله في الفقه احكام تخصه ، لا يسمي عندهم ايلاء دونها . انفكت : يقال : سقط فلان ، فانفكت قدمه : اذا انفرجت وزالت . صرع : اي : سقط عن ظهر دابته . فجحش : جحش جلد الانسان : اذا اصابه شء فسلخه ، او خدشه يقال : جحش فهو مجحوش . مشربة : بضم الراء وفتحها : الغرفة والعلية .
  ( خ م ) ام سلمة  رضي الله عنها  : ان النبي  صلي الله عليه وسلم  حلف : لا يدخل علي بعض اهله شهرا ، فلما مضي تسعة وعشرون يوما غدا عليهم ، او راح ، فقيل له : يا نبي الله ، حلفت ان لا تدخل عليهن شهرا ؟ فقال : ( ان الشهر يكون تسعا وعشرين ) . اخرجه البخاري ، ومسلم .
  ( م ) جابر بن عبد الله  رضي الله عنهما  : قال : اعتزل النبي  صلي الله عليه وسلم  نساءه شهرا ، فخرج الينا صباح تسع وعشرين ، فقال بعض القوم : يا رسول الله ، انما اصبحنا لتسع وعشرين ، فقال النبي  صلي الله عليه وسلم  : ( ان الشهر يكون تسعا  وعشرين ) ، ثم طبق النبي  صلي الله عليه وسلم  يديه ثلاثا ، مرتين باصابع يديه كلها ، والثالثة بتسع منها . اخرجه مسلم .
  ( م س ) ابن شهاب الزهري  رحمه الله  : قال : ان النبي  صلي الله عليه وسلم  ( اقسم ان لا يدخل علي ازواجه شهرا ) .  قال الزهري : فاخبرني عروة عن عاءشة قالت : لما مضي تسع وعشرون ليلة اعدهن ، دخل علي رسول الله & ، قالت : بدا بي ، فقلت : يا رسول الله ، انك اقسمت انك لا تدخل علينا شهرا ، وانك دخلت من تسع وعشرين اعدهن ، قال : ' ان الشهر تسع وعشرون ' . اخرجه مسلم والنساءي
  ( خ ط ) نافع مولي ابن عمر  رضي الله عنهما : قال : قال ابن عمر : ( اذا مضت اربعة اشهر ، يوقف حتي يطلق ، ولا يقع عليه الطلاق ،  حتي يطلق ، يعني المءلي ) . قال : ويذكر ذلك عن عثمان ، وعلي ، وابي الدرداء ، وعاءشة ، واثني عشر رجلا من اصحاب النبي  صلي الله عليه وسلم  . وفي رواية : ان ابن عمر كان يقول في الايلاء الذي سمي الله  عز وجل  : ( لا يحل لاحد بعد الاجل ، الا ان يمسك بالمعروف ، او يعزم الطلاق ، كما امر الله تعالي ) . اخرجه البخاري . ووافقه الموطا علي الرواية الاولي ، وهذا لفظه : ان ابن عمر كان يقول : ( ايما رجل الي من امراته فانه اذا مضت الاربعة الاشهر يوقف حتي يطلق او يفء ، ولا يقع عليه طلاق اذا مضت الاربعة الاشهر حتي يوقف ) . * * * غريب الحديث * * * يفء : فاء يفء : اذا رجع ، اي يرجع الي امراته ويترك يمينه .
  ( خ س ) ابن عباس  رضي الله عنهما  قال : ( اصبحنا يوما ، ونساء النبي  صلي الله عليه وسلم  يبكين ، عند كل امراة منهن اهلها ، فخرجت الي المسجد . فاذا هو ملان من الناس ، فجاء عمر بن الخطاب ، فصعد الي النبي  صلي الله عليه وسلم  وهو في غرفة له ، فسلم ، فلم يجبه احد ، ثم سلم ، فلم يجبه احد ، فناداه ، فدخل  علي النبي  صلي الله عليه وسلم  ، فقال : اطلقت نساءك ؟ قال : لا ، ولكن اليت منهن شهرا ) . فمكث تسعا وعشرين ، ثم دخل علي نساءه . اخرجه البخاري ، والنساءي . وزاد النساءي : فقيل : يا رسول الله ، اليس قد اليت علي شهر ؟ قال : ( الشهر تسع وعشرون ) .
  ( ط ) علي بن ابي طالب  رضي الله عنه  : كان يقول : ( اذا الي الرجل من امراته لم يقع عليه طلاق ، وان مضت الاربعة الاشهر حتي يوقف ، فاما ان يطلق ، واما ان يفء ) . اخرجه الموطا . وقال مالك : من حلف لامراته الا يطاها حتي تفطم ولدها ، فان ذلك لا يكون ايلاء ، وقد بلغني ان علي بن ابي طالب سءل عن ذلك ، فلم يره ايلاء .
  ( ت ) عاءشة  رضي الله عنها  : قالت : ( الي رسول الله  صلي الله عليه وسلم  من نساءه ، وحرم ، فجعل الحرام حلالا ، وجعل في اليمين الكفارة ) . اخرجه الترمذي .  * * * غريب الحديث * * * فجعل الحرام حلالا : قوله : فجعل الحرام حلالا ، يعني : ما كان قد حرمه علي نفسه من نساءه بالايلاء ، عاد فاحله ، وجعل في اليمين الكفارة . وكفارة اليمين تجء في كتاب الايمان ، من حرف الياء .
  ( الكتاب الثامن في الاسماء والكني وفيه خمسة فصول )

  ( الفصل الاول في تحسين الاسماء : المحبوب منها والمكروه )
  ( د ) ابو الدرداء  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( انكم تدعون يوم القيامة باسماءكم واسماء اباءكم ، فاحسنوا اسماءكم ) . اخرجه ابو داود . 
  ( م ت د ) ابن عمر  رضي الله عنهما  : قال : قال رسول الله  صلي الله عليه وسلم  : ( احب الاسماء الي الله تعالي عبد الله ، وعبد الرحمن ) . اخرجه مسلم ، والترمذي ، وابو داود .
  ( د س ) وهب الجشمي  رضي الله عنه  وكانت له صحبة : قال : ( قال رسول الله  صلي الله عليه وسلم  : تسموا باسماء الانبياء ، واحب الاسماء الي الله تعالي : عبد الله ، وعبد الرحمن ، واصدقها حارث وهمام ، واقبحها حرب ، ومرة ) . هذا لفظ ابي داود . واخرجه النساءي الي قوله : عبد الرحمن ، وزاد فيه زيادة في ذكر الخيل ، والوصية بها ، واختيارها . وهو بطوله مذكور في كتاب السبق من حرف السين . وقد اخرج ابو داود ايضا ذكر الخيل ، مثل النساءي مفردا ، فيكون النساءي قد جمع المعنيين ، وابو داود فرقهما .  * * * غريب الحديث * * * اصدقها : حارث وهمام : الحارث : الكاسب ، والاحتراث : الاكتساب ، وهمام : فعال من هم يهم فهو هام ، وانما كان همام اصدق الاسماء ؛ لان الانسان كاسب وهمام بالطبع ، ولا يكاد يخلو من كسب وهم . واقبحها حرب : وانما كان حرب ومرة اقبح الاسماء ؛ لان الحرب مما يتفاءل بها ، وتكره لما فيها من القتل والاذي . واما مرة فلان معناه : المر ، والمر كريه بغيض الي الطباع ، او لانه كنية ابليس ، فان كنيته ابو مرة .
  ( خ م ت د ) ابو هريرة  رضي الله عنه  : ان رسول الله  صلي الله عليه وسلم  قال : ( ان اخنع اسم عند الله : رجل تسمي ملك الاملاك ) . زاد في رواية : ( لا مالك الا الله ) ، قال سفيان : مثل ( شاهان شاه ) .  وقال احمد بن حنبل : سالت ابا عمرو عن ( اخنع ) ، فقال : ( اوضع ) . هذه رواية البخاري ، ومسلم . واخرجه الترمذي ، وابو داود مثلها ، وزاد فيها : يوم القيامة ، بعد قوله : عند الله . وللبخاري ، وابي داود ايضا : قال اخني الاسماء يوم القيامة عند الله : رجل تسمي ملك الاملاك . ولمسلم : اغيظ رجل علي الله يوم القيامة واخبثه ، رجل تسمي ملك الاملاك ، لا ملك الا الله . * * * غريب الحديث * * * اخنع : الخانع : الذليل . اخني : والخنا : الفحش .
  ( م د ) جابر بن عبد الله  رضي الله عنه  قال : اراد رسول الله  صلي الله عليه وسلم  ان ينهي عن ان يسمي ب : يعلي ، وبركة ، وافلح ، ويسار ، ونافع ،  وبنحو ذلك ، ثم رايته سكت بعد عنها ، ولم يقل شيءا ، ثم قبض رسول الله  صلي الله عليه وسلم  ولم ينه عنها . هذه رواية مسلم . وفي رواية ابي داود : قال : قال رسول الله  صلي الله عليه وسلم  : ( ان عشت ان شاء الله انهي امتي ان يسمو نافعا ، وافلح ، وبركة ) . قال الاعمش : ولا ادري اذكر ( نافعا ) ام لا ؟ فان الرجل يقول : اثم بركة ؟ فيقولون : لا . وفي اخري له نحوه ، ولم يذكر ( بركة ) .
  ( م ت د ) سمرة بن جندب  رضي الله عنه  : قال : قال رسول الله  صلي الله عليه وسلم  : ( لا تسم غلامك رباحا ، ولا يسارا ، ولا افلح ، ولا نافعا ) . هذه رواية الترمذي ، وابو داود . واخرجه مسلم قال : قال رسول الله  صلي الله عليه وسلم  : ( احب الكلام الي الله اربع : سبحان الله ، والحمد لله ، ولا اله الا الله ، والله اكبر ، لا يضرك بايهن بدات ، لا تسمين غلامك يسارا ، ولا رباحا ، ولا نجيحا ، ولا افلح ، فانك تقول : اثم هو ؟ فيقول : لا ، انما هن اربع ، فلا تزيدن علي ) .  واخرجه ابو داود ايضا مثل مسلم ، الا انه اسقط المعني الاول .
  ( ت ) عمر  رضي الله عنه  : قال : قال رسول الله  صلي الله عليه وسلم  : ( لانهين ان يسمي رافع ، وبركة ، ويسار ) . اخرجه الترمذي . * * * غريب الحديث * * * رباح : لغة في الربح ، واليسار : الغني .
  ( د ) اسلم مولي عمر  رضي الله عنهما  : ان عمر  رضي الله عنه  ضرب ابنا له تكني ابا عيسي ، وان المغيرة بن شعبة تكني ابا عيسي . فقال له عمر : ( اما يكفيك ان تكني بابي عبد الله ، فقال : ان رسول الله  صلي الله عليه وسلم  كناني ابا عيسي ، فقال : ان رسول الله  صلي الله عليه وسلم  قد غفر له ما تقدم من ذنبه ، وما تاخر ، وانا بعد في جلحتنا ، فلم يزل يكني بابي عبد الله حتي هلك ) . اخرجه ابو داود . * * * غريب الحديث * * * جلحتنا : قال الازهري : الجلحة : واحدة الجلاح ، وهي الرءوس ،  ومعناه : وانا بعد في عداد اقراننا واخواننا ، لم ندر ما يصنع بنا .
  ( ط ) يحيي بن سعيد القطان  رحمه الله  : ان رسول الله  صلي الله عليه وسلم  قال للقحة تحلب : ( من يحلب هذه ؟ ) فقام رجل ، فقال له رسول الله  صلي الله عليه وسلم  : ( ما اسمك ؟ ) فقال له الرجل : مرة ، فقال له رسول الله  صلي الله عليه وسلم  : ( اجلس ) ، ثم قال : ( من يحلب هذه ؟ ) فقام رجل ، فقال له رسول الله  صلي الله عليه وسلم  : ( ما اسمك ؟ ) ، فقال له الرجل : حرب ، فقال له رسول الله  صلي الله عليه وسلم  : ( اجلس ) . ثم قال : ( من يحلب هذه ؟ ) فقام رجل ، فقال له رسول الله  صلي الله عليه وسلم  : ( ما اسمك ؟ ) . فقال : يعيش ، فقال له رسول الله  صلي الله عليه وسلم  : ( احلب ) . اخرجه الموطا . * * [ شرح الغريب ] * * ( اللقحة )  بفتح اللام وكسرها  ذات اللبن من الابل ، وجمعها : لقاح ، وقيل : هي الحديثة النتاج .
  ( الفصل الثاني فيمن سماه النبي & ابتداء )
  ( خ م ) سهل بن سعد السعدي  رضي الله عنه  : ان رجلا  جاء الي سهل بن سعد ، فقال : هذا فلان  لامير المدينة  يذكر عليا عند المنبر ، قال : فيقول ماذا ؟ قال : يقول ابو تراب ، فضحك ، وقال : والله ما سماه به الا النبي  صلي الله عليه وسلم  ، وما كان له اسم احب اليه منه ، فاستطعمت الحديث سهلا ، وقلت : يا ابا عباس ، كيف ؟ قال : دخل علي علي فاطمة  رضي الله عنها  ثم خرج ، فاضطجع في المسجد ، فوجد رداءه قد سقط عن ظهره ، وخلص التراب الي ظهره ، فجعل يمسح عن ظهره ، ويقول : اجلس ابا تراب  مرتين . وفي رواية قال : جاء رسول الله  صلي الله عليه وسلم  بيت فاطمة فلم يجد عليا في البيت ، فقال : ( اين ابن عمك ؟ ) فقالت : كان بيني وبينه شء ، فغاضبني ، فخرج ، فلم يقل عندي ، فقال رسول الله قال رسول الله  صلي الله عليه وسلم  لانسان : ( انظر اين هو ؟ ) فقال : يا رسول الله ، هو في المسجد راقد ، فجاءه رسول الله  صلي الله عليه وسلم  وهو مضطجع ، قد سقط رداءه عن شقه ، فاصابه تراب ، فجعل رسول الله  صلي الله عليه وسلم  يقول : ( قم ابا تراب ، قم ابا تراب ) . اخرجه البخاري ومسلم .  * * * غريب الحديث * * * فلم يقل : عندي ، اي : لم يقض القاءلة عندي .
  ( خ م ) اسماء بنت ابي بكر  رضي الله عنها وعن ابيها  : انها حملت بعبدالله بن الزبير بمكة ، قالت : فخرجت وانا متم ، فقدمت المدينة فنزلت بقباء ، فولدته بقباء ، ثم اتيت رسول الله  صلي الله عليه وسلم  ، فوضعه في حجره ، ثم دعا بتمرة فمضغها ، ثم تفل في فيه ، فكان اول شء دخل جوفه : ريق رسول الله  صلي الله عليه وسلم  ، ثم حنكه بالتمرة ، ثم دعا له ، وبرك عليه ، فكان اول مولود ولد في الاسلام . زاد في رواية : ( ففرحوا به فرحا شديدا ؛ لانهم قيل لهم : ان اليهود قد سحرتكم ، فلا يولد لكم ) . اخرجه البخاري ، ومسلم عن اسماء ، ولم يذكرا فيه ( وسماه ) . واخرجاه عن عاءشة بنحوه ، وقالا فيه : ( وسماه عبد الله ) .  * * * غريب الحديث * * * متم : امراة متم : اذا كانت حاملا ، وقد دنا ولادها . بقباء : قباء  بالمد  موضع بالمدينة معروف ، يصرف ولا يصرف . تفل : التفل : ان يبصق اقل شء ، وهو فوق النفث . حنكه : التحنيك : ان يدلك بالتمر حنك الصبي . وبرك عليه : التبريك علي الولد : ان يدعو له بالبركة .
  ( خ م ) ابو موسي الاشعري  رضي الله عنه  : قال : ولد لي غلام ، فاتيت به رسول الله  صلي الله عليه وسلم  ، فسماه ابراهيم ، وحنكه بتمرة ودعا له بالبركة ، ودفعه الي ، وكان اكبر ولد ابي موسي . اخرجه البخاري ، ومسلم .
  ( خ م د ) انس بن مالك  رضي الله عنه  : قال : كان ابن لابي طلحة يشتكي ، فخرج ابو طلحة فقبض الصبي ، فلما رجع ابو طلحة ، قال : ما فعل ابني ؟ قالت ام سليم : هو اسكن ما كان عليه ، فقربت له العشاء فتعشي ، ثم اصاب منها ، فلما فرغ ، قالت : واروا الصبي ، فلما اصبح ابو طلحة اتي رسول الله  صلي الله عليه وسلم  ، فاخبره ، فقال : ( اعرستم الليلة ؟ ) قال : نعم ،  قال : ( اللهم بارك لهما ) ، فولدت غلاما ، فقال لي ابو طلحة : احمله حتي تاتي به النبي  صلي الله عليه وسلم  ، وبعثت معه بتمرات ، فاخذه النبي  صلي الله عليه وسلم  فقال : ( امعه شء ؟ ) ، قال : نعم ، تمرات ، فاخذها النبي  صلي الله عليه وسلم  فمضغها ، ثم اخذها من فيه : فجعلها في في الصبي ، ثم حنكه ، وسماه عبد الله . وفي رواية مختصرا قال : غدوت الي رسول الله  صلي الله عليه وسلم  بعبد الله بن ابي طلحة ليحنكه ، فوافيته ، في يده الميسم يسم به ابل الصدقة . وفي اخري مختصرا قال : لما ولدت ام سليم ، قالت : يا انس ، انظر هذا الغلام ، فلا يصيبن شيءا ، حتي تغدو به الي النبي  صلي الله عليه وسلم  يحنكه ، فغدوت ، فاذا هو في الحاءط ، وعليه خميصة جونية ، وهو يسم الظهر الذي قدم في الفتح . هذه رواية البخاري ، ومسلم . ولمسلم وحده قال : مات ابن لابي طلحة من ام سليم ، فقالت لاهلها : لا تحدثوا ابا طلحة بابنه ، حتي اكون انا احدثه ، قال : فجاء ، فقربت اليه عشادا ، فاكل وشرب ، قال : ثم تصنعت له احسن ما كانت تصنع قبل ذلك ، فوقع بها ، فلما رات انه قد شبع واصاب منها ، قالت : يا ابا طلحة ، ارايت لو ان قوما اعاروا عاريتهم اهل بيت ، فطلبوا عاريتهم ، الهم ان يمنعوهم ؟  قال : لا ، قالت : فاحتسب ابنك ، قال : فغضب ، وقال : تركتيني حتي تلطخت ، ثم اخبرتيني بابني ، فانطلق حتي اتي رسول الله  صلي الله عليه وسلم  فاخبره بما كان ، فقال رسول الله  صلي الله عليه وسلم  : ( بارك الله في ليلتكما ) ، قال : فحملت ، فكان رسول الله في سفر ، وهي معه ، وكان رسول الله  صلي الله عليه وسلم  اذا اتي المدينة من سفر لا يطرقها طروقا ، فدنوا من المدينة ، فضربها المخاض ، فاحتبس عليها ابو طلحة ، فانطلق رسول الله  صلي الله عليه وسلم  ، قال : يقول ابو طلحة : انك لتعلم يا رب انه يعجبني ان اخرج مع رسول الله  صلي الله عليه وسلم  اذا خرج ، وادخل معه اذا دخل ، وقد احتبست بما تري ، قال : تقول ام سليم : يا ابا طلحة ، ما اجد الذي كنت اجد ، فانطلق ، فانطلقنا ، وضربها المخاض حين قدما ، فولدت غلاما ، فقالت لي امي : يا انس لا يرضعه احد حتي تغدو به علي رسول الله  صلي الله عليه وسلم  ، فلما اصبح ، احتملته ، فانطلقت به الي رسول الله  صلي الله عليه وسلم  ، قال : فصادفته ومعه ميسم ، فلما راني قال : لعل ام سليم ولدت ؟ قلت : نعم ، فوضع الميسم ، قال : وجءت به ، فوضعته في حجره ، ودعا رسول الله  صلي الله عليه وسلم  بعجوة من عجوة المدينة ، فلاكها في فيه حتي ذابت ، ثم قذفها في في الصبي ، فجعل الصبي يتلمظها ، قال : قال رسول الله  صلي الله عليه وسلم  : ( انظروا الي حب الانصار التمر ) ، قال : فمسح وجهه وسماه عبد الله . وفي اخري لمسلم قال : ذهبت بعبد الله بن ابي طلحة الانصاري الي رسول الله  صلي الله عليه وسلم  حين ولد ، ورسول الله  صلي الله عليه وسلم  في عباءة يهنا بعيرا له ،  فقال : ( هل معك تمر ؟ ) فقلت : نعم ؟ فناولته تمرات ، فالقاهن في فيه ، فلاكهن ، ثم فغر فا الصبي فمجه في فيه ، فجعل الصبي يتلمظه ، فقال رسول الله  صلي الله عليه وسلم  : ( حب الانصار التمر ) وسماه عبد الله . واخرجه ابو داود مثل رواية مسلم هذه الاخيرة . * * * غريب الحديث * * * اعرستم : الاعراس هاهنا ، اراد به : الجماع . الميسم : الحديدة التي تسم بها الدواب ، تتركها في النار حتي تحمي  ثم تسمها بها . الحاءط : هاهنا : البستان من نخل . خميصةغ جوانيه : الخميصة : ثوب خز ، او صوف معلم ، وهو اسود ، والجون : الاسود ، نسبها الي السواد ، هكذا جاء في كتاب الحميدي ( خميصة جونية ) والذي رايته في كتاب مسلم ( خميصة جوينية ) وفي نسخة ( جوتكية ) وما اعرف له معني ، الا ان يكون قد نسبها الي القصر ، فان الجوتكي : الرجل القصير الخطو ، المتقارب في المشي ، اراد : انها خميصة قصيرة ، كانها لرجل جوتكي ، والله اعلم . فاحتسب ابنك : اذا مات للانسان ولد ، قيل له : احتسبه عند الله ، اي : اجعله لك عنده ذخرا . لا يطرقها : الطروق : اتيان المنزل ليلا . المخاض : الطلق عند الاحساس بالولادة . بعجوة : العجوة : نوع من جيد التمر ، من تمر المدينة . يتلمظها : التلمظ : تطعم ما يبقي في الفم من اثار الطعام . يهنا : هنات البعير : لطخته بالهناء ، وهو القطران . بعيرا : البعير من الابل : الذكر والانثي ، كالانسان من بني ادم . فلاكها : لاك اللقمة في فيه : اذا مضغها . فغر : فاه : اذا فتحه .  فمجه : مج ريقه من فمه : اذا رماه .
  ( د ) عاءشة  رضي الله عنها  قالت : قلت : يا رسول الله : كل صواحبي لهن كني ، قال : ( فاكتني بابنك عبد الله بن الزبير ) . فكانت تكني : ام عبد الله . اخرجه ابو داود . وزاد رزين في كتابه ، فان الخالة ام . ولم اجدها في كتاب ابي داود .
  ( الفصل الثالث فيمن غير النبي & اسمه )
  ( ت ) عاءشة  رضي الله عنها  ان رسول الله  صلي الله عليه وسلم  كان يغير الاسم القبيح . اخرجه الترمذي .
  ( خ م ) ابو هريرة  رضي الله عنه  ان زينب بنت ابي  سلمة ، كان اسمها : برة ، فقيل : تزكي نفسها ، فسماها رسول الله  صلي الله عليه وسلم  زينب . اخرجه البخاري ومسلم . * * * غريب الحديث * * * برة : برة : اسم امراة ، وهو تانيث بر ، والبر : ضد الفاجر . تزكي نفسها : زكي الرجل نفسه : اذا وصفها واثني عليها ، وهو مكروه .
  ( م ) ابن عباس  رضي الله عنهما  قال : ( كان امس جويرية بنت الحارث برة ، فحول رسول الله  صلي الله عليه وسلم  اسمها جويرية ، وكان يكره ان يقال : خرج من عند برة ) . اخرجه مسلم .
  ( م د ) محمد بن عمرو بن عطاء  رحمه الله  قال : سميت ابنتي برة ، فقالت لي زينب بنت ابي سلمة : ان رسول الله  صلي الله عليه وسلم  نهي عن هذا الاسم ، وسميت برة ، فقال رسول الله  صلي الله عليه وسلم  : ( لا تزكوا انفسكم الله اعلم باهل البر منكم ) . فقالوا : بم نسميها ؟ فقال : ( سموها زينب ) . وفي رواية قالت زينب : كان اسمي برة ، فسماني رسول الله  صلي الله عليه وسلم  زينب ، قالت : ودخلت عليه زينب بنت جحش ، واسمها برة ، فسماها زينب .  اخرجه مسلم ، وابو داود ووافقه علي الاولي .
  ( د س ) شريح بن هانء  رضي الله عنه  عن ابيه قال : لما وفد بي رسول الله  صلي الله عليه وسلم  الي المدينة مع قومه ، سمعهم يكنونه بابي الحكم ، فدعاه رسول الله  صلي الله عليه وسلم  . فقال : ( ان الله هو الحكم ، واليه الحكم ، فلم تكني ابا الحكم ؟ ) فقال : ان قومي اذا اختلفوا في شء اتوني ، فحكمت بينهم ، فرضي كلا الفريقين بحكمي ، فقال رسول الله  صلي الله عليه وسلم  : ( ما احسن هذا ؛ فما لك من الولد ؟ ) قال : لي شريح ، ومسلم وعبد الله ، قال : ( فمن اكبرهم ؟ ) قال : قلت : شريح ، قال : ( فانت ابو شريح ) . اخرجه ابو داود والنساءي . * * * غريب الحديث * * * الحكم : انما كره الحكم ؛ لان الحكم : الحاكم ، ولا حكم الا لله تعالي . 
  ( د ) بشير بن ميمون  رضي الله عنه  عن عمه اسامة بن اخدري ان رجلا كان اسمه : اصرم ، وكان في نفر اتوا رسول الله  صلي الله عليه وسلم  ، فقال له : ( ما اسمك ؟ ) قال : اصرم ، قال : ( بل انت زرعة ) . اخرجه ابو داود . * * * غريب الحديث * * * اصرم : انما كره اصرم ، لما فيه من معني الصرم ، وهو القطع . زرعة : فجعله زرعة ؛ لانه من الزرع ، والزرع : النبات ، وهو ضد القطع .
  ( خ د ) سعيد بن المسيب عن ابيه  رحمه الله  ان اباه جاء الي النبي  صلي الله عليه وسلم  ، فقال : ( ما اسمك ؟ ) قال : حزن ، قال : ( انت سهل ) . قال : لا اغير اسما سمانيه ابي .  وفي رواية : قال عبد الحميد بن جبر بن شيبة : جلست الي سعيد بن المسيب ، فحدثني ان جده حزنا قدم علي النبي  صلي الله عليه وسلم  ، فقال : ( ما اسمك ) ، قال : اسمي حزن ، قال : ( بل انت سهل ) قال : ما انا بمغير اسما سمانيه ابي . قال ابن المسيب : فما زالت فينا الحزونة بعد . هذه رواية البخاري ، واخرجه ابو داود قال : ( لا ، السهل يوطا ، ويمتهن ) . قال سعيد : فظننت انه سيصيبنا بعده حزونة . قال ابو داود : وغير رسول الله  صلي الله عليه وسلم  اسم العاص ، وعزيز ، وعتلة ، وشيطان ، والحكم ، وغراب ، وحباب ، وشهاب ، فسماه : هشاما ، وسمي حربا : سلما ، وسمي المضطجع : المنبعث ، وارضا تسمي : عفرة ، سماها : خضرة ، وشعب الضلالة ، سماه : شعب الهدي ، وبني الزنية ، سماهم : بني الرشدة ، وسمي بني مغوية : بني رشدة . قال ابو داود : تركت اسانيدها للاختصار . * * * غريب الحديث * * * حزونة : الحزونة : ضد السهولة ، وهو ما خشن وغلظ من الارض . يمتهن : اي يداس ويهان ، او من المهنة ، يعني الخدمة .  العتلة : الشدة والغلظة ، يقال : عتلت الرجل : اذا جذبته جذبا عنيفا ، ومنه قيل : رجل عتل ، وهو الجافي الغليظ . الحباب : الحية ، وبه يسمي الشيطان حبابا . عزيز : انما كره العزيز ؛ لان العبد موصوف بالذل والخضوع لله تعالي . شهاب : وكره شهابا ؛ لان الشهاب الشعلة ، ولانه يرجم به الشيطان . غراب : وكره غرابا ؛ لان معناه : البعد ، والغراب : من اخبث الطيور ، وقد اباح قتله في الحل والحرم . عفرة : العفرة : من عفرة الارض ، وهو لونها ، ورويت ( عثرة ) بالثاء وهي التي لا نبات فيها ، انما هي صعيد قد علاها العثير ، وهو الغبار . بني الزنية : يقال : فلان لزنية : اذا كان ولد زنا ، وفلان لرشدة : اذا كان لنكاح صحيح .
  ( م د ) ابن عمر  رضي الله عنهما  ان رسول الله  صلي الله عليه وسلم  غير اسم عاصية ، وسماها جميلة . هذه رواية مسلم والترمذي وابي داود . وفي اخري لمسلم : ان ابنة كانت لعمر : يقال لها : عاصية ، فسماها رسول الله  صلي الله عليه وسلم  جميلة . 
  ( د ) مسروق  رحمه الله  قال : لقيت عمر بن الخطاب  رضي الله عنه  ، قال : من انت ؟ قلت : مسروق بن الاجدع ، قال عمر : سمعت رسول الله  صلي الله عليه وسلم  يقول : ( الاجدع : شيطان ) . اخرجه ابو داود .
  ( خ م ) سهل بن سعد  رضي الله عنه  ان رسول الله  صلي الله عليه وسلم  اتي بالمنذر ابن ابي اسيد ، حين ولد ، فوضعه علي فخذه ، وابو اسيد جالس ، فلهي رسول الله  صلي الله عليه وسلم  بشء كان بين يديه ، فامر ابو اسيد بابنه ، فاحتمل من علي فخذ النبي  صلي الله عليه وسلم  ، فقلبوه ، فاستفاق رسول الله  صلي الله عليه وسلم  ، فقال : ( اين الصبي ؟ ) فقال ابو اسيد : قلبناه يا رسول الله ، قال رسول الله  صلي الله عليه وسلم  : ( ما اسمه ؟ ) قال : فلان ، قال : ( لا ، ولكن اسمه المنذر ، فسماه يومءذ : المنذر ) . اخرجه البخاري ومسلم . * * * غريب الحديث * * * فلهي : لهيت عن الشء الهي : اذا غفلت [ عنه ] . قلبت : الصبي وغيره : اذا رددته من حيث جاء .  فاستفاق : الاستفاقة : استفعال من افاق : اذا رجع الي ما كان قد شغل عنه ، وعاد الي نفسه ، ومنه افاقة المريض والمجنون .
  ( الفصل الرابع ما جاء في التسمية باسم النبي & وكنيته )
  ( خ م د ) ابو هريرة  رضي الله عنه ان رسول الله  صلي الله عليه وسلم  قال : ( تسموا باسمي ، ولا تكتنوا بكنيتي ) هذه رواية البخاري ومسلم وابي داود . وزاد البخاري ومسلم في رواية اخري : ( ومن راني في المنام فقد راني ، فان الشيطان لا يتمثل في صورتي ، ومن كذب علي متعمدا فليتبوا مقعده من النار ) . * * * غريب الحديث * * * فليتبوا : التبوا : اتخاذ المباءة ، وهي المنزل .
  ( خ م ت ) انس بن مالك  رضي الله عنه  قال : كان رسول الله  صلي الله عليه وسلم  يوما يمشي بالبقيع ، فسمع قاءلا يقول : يا ابا القاسم ، فرد راسه اليه ،  فقال الرجل : يا رسول الله ، اني لم اعنك ، وانما دعوت فلانا ، فقال رسول الله  صلي الله عليه وسلم  : ( تسموا باسمي ، ولا تكنوا بكنيتي ) . اخرجه البخاري ومسلم والترمذي .
  ( خ م ت د ) جابر بن عبد الله  رضي الله عنهما  قال : ولد لرجل منا غلام ، فسماه القاسم ، فقلنا : لا نكنيك ابا القاسم ، ولا ننعمك عينا ، فاتي النبي  صلي الله عليه وسلم  ، فذكر ذلك له ، فقال : ( اسم ابنك عبد الرحمن ) . وفي رواية : لا نكنيك ابا القاسم ، ولا كرامة . وفي اخري قال : ولد لرجل منا غلام ، فسماه القاسم ، فقلنا : لا نكنيه حتي نسال النبي  صلي الله عليه وسلم  فقال : ( تسموا باسمي ، ولا تكنوا بكنيتي ) . وفي اخري : فقالت الانصار : لا نكنيك ابا القاسم ، ولا ننعمك عينا ، فقال رسول الله  صلي الله عليه وسلم  : ( احسنت الانصار ، تسموا باسمي ، ولا تكنوا بكنيتي ) . وفي اخري قال : اراد ان يسميه القاسم ، فقال النبي  صلي الله عليه وسلم  : ( تسموا باسمي ، ولا تكنوا بكنيتي ، فاني انما جعلت قاسما ، اقسم بينكم ) .  وفي اخري : فسماه محمدا ، فقال له قومه : لا ندعك تسمي باسم رسول الله  صلي الله عليه وسلم  ، فانطلق بابنه ، حامله علي ظهره ، فكر انه ذكر له ذلك ، فقال رسول الله  صلي الله عليه وسلم  : ( تسموا باسمي ، ولا تكنوا بكنيتي . . . ) الحديث . هذه رواية البخاري ومسلم . واخرجه ابو داود مختصرا عن جابر وانس : ان رسول الله  صلي الله عليه وسلم  قال : ( تسموا باسمي ، ولا تكنو بكنيتي ) . وفي اخري لابي داود عن جابر وحده : ان رسول الله  صلي الله عليه وسلم  قال : ( تسموا باسمي ، ولا تكنوا بكنيتي ) . وفي اخري لابي داود عن جابر وحده : ان رسول الله  صلي الله عليه وسلم  قال : ( من تسمي باسمي ، فلا يتكني بكنيتي ، ومن تكني بكنيتي ، فلا يتسمي باسمي ) . واخرجه الترمذي : ان رسول الله : نهي ان يجمع احد بين اسمه وكنيته ، فيسمي محمدا ابا القاسم . وفي اخري له ، قال : قال رسول الله  صلي الله عليه وسلم  : ( اذا تسميتم بي فلا تكتنوا بي ) .  * * * غريب الحديث * * * ولا ننعمك عينا : اي : لا نقول لك : نعمت عينك ، بمعني قرت ، ومنه قولهم : نعم ونعمي عين .
  ( د ) عاءشة  رضي الله عنها  قالت : جاءت امراة الي النبي  صلي الله عليه وسلم  فقالت : يا رسول الله ، اني ولدت غلاما ، فسميته محمدا ، وكنيته ابا القاسم ، فذكر لي : انك تكره ذلك ، فقال : ( ما الذي احل اسمي ، وحرم كنيتي ) او ( ما الذي حرم كنيتي ، واحل اسمي ؟ ) . اخرجه ابو داود .
  ( د ) محمد بن الحنفية عن ابيه علي بن ابي طالب  رضي الله عنهما  قال : ( قلت : يا رسول الله : ارايت ان ولد لي بعدك ولد ، اسمه باسمك ، واكنيه بكنيتك ؟ ) قال : ( نعم ) اخرجه ابو داود . 
  ( الفصل الخامس في احاديث متفرقة )
  ( ت ) ابن عمر  رضي الله عنهما  ان رسول الله  صلي الله عليه وسلم  امر بتسمية المولود يوم سابعه ، ووضع الاذي عنه ، والعق عنه . اخرجه الترمذي .  * * * غريب الحديث * * * ووضع الاذي : عن المولود : هو ان يزال ما عليه من اثر الولادة ، وما يخرج علي جسده من اثرها . العق : هو ان يخلق الشعر الذي يخرج علي راسه من بطن امه ، وهو من جملة وضع الاذي عنه ، وان يذبح عنه شاة او شاتان ، كما سياتي بيانه في باب العقيقة ، من كتاب الطعام ، من حرف الطاء .
  ( م د ) عاءشة  رضي الله عنها  قالت : كان رسول الله  صلي الله عليه وسلم  يءتي بالصبيان ، فيدعو لهم بالبركة . وزاد في رواية : ( ويحنكهم ) ولم يذكر ( بالبركة ) . اخرجه ابو داود . وفي رواية مسلم ، ان رسول الله  صلي الله عليه وسلم  : كان يءتي بالصبيان فيبرك عليهم ويحنكهم .
  ( ت د ) ابو رافع مولي رسول الله  صلي الله عليه وسلم  قال : ( رايت رسول الله  صلي الله عليه وسلم  اذن في اذن الحسن بن علي ، حين ولدته فاطمة  رضي الله عنهم  ) . زاد رزين في كتابه : قرا في اذنه سورة الاخلاص وحنكه بتمرة وسماه .  ولم اجد هذه الزيادة في الاصول . اخرجه الترمذي وابو داود .
  ( ط ) يحيي بن سعيد ان عمر بن الخطاب قال لرجل : ما اسمك ؟ قال : جمرة ، قال : ابن من ؟ قال : ابن شهاب ، قال : ممن ؟ قال : من الحرقة ، قال : اين مسكنك ؟ قال : بحرة النار . قال : بايها ؟ قال : بذات لظي . قال عمر : ادرك اهلك فقد احترقوا ، فكان كما قال عمر . اخرجه ( الموطا ) . 
  ( الكتاب التاسع في الانية )
  ( خ م ت د س ) عبدالرحمن بن ابي ليلي  رحمه الله  قال : انهم كانوا عند حذيفة بالمداءن ، فاستسقي ، فسقاه مجوسي في اناء من فضة ، فرماه به ، وقال : اني قد امرته الا يسقيني فيه ، اني سمعت رسول الله  صلي الله عليه وسلم  يقول : ( لا تلبسوا الحرير ولا الديباج ، ولا تشربوا في انية الذهب والفضة ، ولا تاكلوا في صحافها ، فانها لهم في الدنيا ) . زاد في رواية : ( ولكم في الاخرة ) . هذه رواية البخاري ومسلم . ولمسلم ايضا بنحوه ، وليس فيه ، ولا ( تاكلوا في صحافها ) . واخرجه الترمذي وابو داود نحو مسلم . واخرجه النساءي قال : استسقي حذيفة ، فاتاه دهقان بماء في اناء من فضة ، فحذفه ثم اعتذر اليهم مما صنع به ، وقال : انني نهيته ، فلم ينته ، سمعت رسول الله  صلي الله عليه وسلم  يقول : . . . وذكر الحديث ، مثل مسلم .  * * * غريب الحديث * * * دهقان : الدهقان : رءيس القرية ، والمقدم علي الجماعة من الفلاحين والتناء .
  ( خ م ط ) ام سلمة  رضي الله عنها  قالت : قال رسول الله  صلي الله عليه وسلم  : ( الذي يشرب في اناء الفضة ، انما يجرجر في بطنه نار جهنم ) هذه  رواية البخاري ومسلم و ( الموطا ) . ولمسلم زيادة في رواية : ( ان الذي ياكل ويشرب في انية الفضة والذهب ) . وفي اخري له : ( من شرب في اناء من ذهب او فضة ، فانما يجرجر في بطنه نارا من جهنم ) . * * * غريب الحديث * * * يجرجر : اي يحدر في جوفه ، فجعل للشرب جرجرة ، وهي وقوع صوت الماء في الجوف ، وقيل : هي تردده في فيه ، وقيل : هي صب الماء في الحلق .
  ( د ) جابر بن عبد الله  رضي الله عنهما  قال : ( كنا نغزو مع رسول الله  صلي الله عليه وسلم  فنصيب منانية المشركين واسقيتهم ونستمتع بها ، فلا يعيب ذلك علينا ) . اخرجه ابو داود . * * * غريب الحديث * * * نستمتع : الاستمتاع بالشء : الانتفاع به .
  ( د ت ) ابو ثعلبة الخشني  رضي الله عنه  قال : انه سال  رسول الله  صلي الله عليه وسلم  : انا نجاور اهل الكتاب ، وهم يطبخون في قدورهم الخنزير ، ويشربون في انيتهم الخمر ، فقال رسول الله  صلي الله عليه وسلم  : ( ان وجدتم غيرها ، فكلوا واشربوا ، فان لم تجدوا غيرها فارحضوها بالماء ، وكلوا واشربوا ) . هذه رواية ابي داود . ورواية الترمذي قال : سءل رسول الله  صلي الله عليه وسلم  عن قدور المجوس فقال : ( انقوها غسلا ، واطبخوا فيها ) ونهي عن كل سبع ذي ناب . وفي اخري له قال : اتيت رسول الله  صلي الله عليه وسلم  فقلت : يا رسول الله ، انا بارض قوم اهل كتاب ، ناكل في انتيهم ؟ قال : ( ان وجدتم غير انيتهم فلا تاكلوا فيها ، فان لم تجدوا فاغسلوها وكلوا فيها ) . * * * غريب الحديث * * * فارحضوها : الرحض : الغسل . انقوها : الانقاء : المبالغة في الغسل والتنظيف .
  ( ) ابن عمر  رضي الله عنهما  قال : ( توضا عمر بالحميم في جر  نصرانية ، ومن بيتها ) . اخرجه رزين ، ولم اجده في الاصول الا في تراجم ابواب البخاري ، فانه قال في احد ابواب كتاب الوضوء قولا مجملا : وتوضا عمر بالحميم ، ومن بيت نصرانية . * * * غريب الحديث * * * بالحميم : الماء الحار . جر نصرانية : الجر : جمع جرة ، وهي الاناء من الخزف ، وتجمع ايضا علي جرار . 
  ( الكتاب العاشر في الامل والاجل )
  ( خ ت ) ابن مسعود  رضي الله عنه  قال : خط رسول الله  صلي الله عليه وسلم  خطا مربعا ، وخط خطا في الوسط خارجا منه ، وخط خطا صغارا ، الي هذا الذي في الوسط ، من جانبه الذي في الوسط ، فقال : ( هذا الانسان ، وهذا اجله محيط به  او قد احاط به  وهذا الذي هو خارج امله ، وهذه الخطط الصغار : الاعراض ، فان اخطاه هذا ، نهشه هذا ، وان اخطاه هذا ، نهشه هذا ) .  اخرجه البخاري والترمذي .
  ( خ ت ) انس بن مالك  رضي الله عنه  قال : خط رسول الله  صلي الله عليه وسلم  خطا ، [ وقال : ( هذا الانسان ) ، وخط الي جانبه خطا ، وقال : ( هذا اجله ) ، وخط اخر بعيدا منه ] ، فقال : ( هذا الامل ) ، فبينما هو كذلك ، اذ جاءه الاقرب ، هذه رواية البخاري . واخرجه الترمذي قال : قال رسول الله  صلي الله عليه وسلم  : ( هذا ابن ادم ، وهذا  اجله ) ، ووضع يده عند قفاه ، ثم بسطها ، وقال : ( وثم امله ، وثم امله ) .
  ( خ ت ) ابن عمر  رضي الله عنهما  قال : اخذ رسول الله  صلي الله عليه وسلم  بمنكبي ، فقال : ( كن في الدنيا كانك غريب ، او عابر سبيل ) . وكان ابن عمر يقول : اذا امسيت فلا تنتظر الصباح ، واذا اصبحت فلا تنتظر المساء ، وخذ من صحتك لمرضك ، ومن حياتك لموتك . هذه رواية البخاري ، واخرجه الترمذي قال : اخذ رسول الله  صلي الله عليه وسلم  ببعض جسدي ، فقال : ( كن في الدنيا كانك غريب ، او عابر سبيل ، وعد نفسك من اهل القبور ) . قال مجاهد : فقال لي ابن عمر : اذا اصبحت فلا تحدث نفسك بالمساء ، واذا امسيت فلا تحدث نفسك بالصباح ، وخذ من صحتك لسقمك ، ومن  حياتك قبل موتك ، فانك لا تدري يا عبد الله : ما اسمك غدا ؟ .
  ( ت ) بريدة  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( هل تدرون ما مثل هذه وهذه ؟ ) ورمي بحصاتين ، قالوا : الله ورسوله اعلم ، قال : ( هذا الامل ، وهذاك الاجل ) . اخرجه الترمذي .
  ( خ ت ) ابو هريرة  رضي الله عنه  قال : قال رسول الله  صلي الله عليه وسلم  : ( اعذر الله الي امرء اخر اجله حتي بلغ ستين سنة ) . هذه رواية البخاري .  وفي رواية الترمذي ، قال : قال رسول الله  صلي الله عليه وسلم  : ( عمر امتي ما بين ستين سنة الي سبعين ) . زاد في رواية : ( واقلهم : من يجوز ذلك ) . ووجدت لرزين رواية لم اجدها في الاصول : ان رسول الله  صلي الله عليه وسلم  قال : ( معترك المنايا : ما بين الستين الي السبعين ، ومن انسا الله في اجله الي اربعين ، فقد اعذر اليه ) . 
  ( ترجمة الابواب التي اولها همزة ، ولم ترد في حرف الهمزة )
