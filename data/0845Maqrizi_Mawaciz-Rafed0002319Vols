 قلت هذا الدير عند النصاري علي اسم بوجرج ويجتمع فيه النصاري من النواحي : دير اقفاص : وصوابها اقفهس وقد خرب.
 دير خارج ناحية منهري : خامل الذكر لانهم لا يطعمون فيه احدا.
 دير الخادم : علي جانب المنهي باعمال البهنسا ، علي اسم غبريال الملك ، به بستان فيه نخل وزيتون.
 دير اشنين : عرف بناحية اشنين ، فانه في بحريها ، وهو لطيف علي اسم السيدة مريم ، وليس به سوي راهب واحد.
 دير ايسوس : ومعني ايسوس يسوع ، ويقال له دير ارجنوس ، وله عيد في خامس عشري بشنس ، فاذا كان ليلة هذا اليوم سدت بءر فيه تعرف ببءر ايسوس ، وقد اجتمع الناس

 الي الساعة السادسة من النهار ، ثم كشفوا الطابق عن البءر فاذا بها قد فاض ماءها ثم ينزل ، فحيث وصل الماء قاسوا منه الي موضع استقر فيه الماء ، فما بلغ كانت زيادة النيل في تلك السنة من الاذرع.
 دير سدمنت : علي جانب المنهي بالحاجر بين الفيوم والريف علي اسم بوجرج ، وقد ضعفت احواله عما كان عليه وقل ساكنه.
 دير النقلون : ويقال له دير الخشبة ، ودير غبريال الملك ، وهو تحت مغارة في الجبل الذي يقال له طارف الفيوم ، وهذه المغارة تعرف عندهم بمظلة يعقوب ، يزعمون ان يعقوب عليه السلام لما قدم مصر كان يستظل بها ، وهذا الجبل مطل علي بلدين يقال لهما اطفيح شيلا ، وشلا. ويملا الماء لهذا الدير من بحر المنهي ومن تحت دير سدمنت ، ولهذا الدير عيد يجتمع فيه نصاري الفيوم وغيرهم ، وهو علي السكة التي تنزل الي الفيوم ولا يسكلها الا القليل من المسافرين.
 دير القلمون : هذا الدير في برية تحت عقبة القلمون ، يتوصل المسافر منها الي الفيوم ، يقال لها عقبة الغريق ، وبني هذا الدير علي اسم صمويل الراهب ، وكان في زمن الفترة ما بين عيسي ومحمد صلي الله عليه وسلم ، ومات في ثامن كيهك ، وفي هذا الدير نخل كثير يعمل من تمره العجوة ، وفيه ايضا شجر البلخ ، ولا يوجد الا فيه ، وثمره بقدر الليمون ، طعمه حلو في مثل طعم الرامخ ، ولنواه عدة منافع ، وقال ابو حنيفة في كتاب النبات : ولا ينبت اللبخ الا بانصنا ، وهو عود تنشر منه الواح السفن ، وربما ارعف ناشرها ، ويباع اللوح منها بخمسين دينارا ونحوها ، واذا شد لوح منها بلوح وطرحا في الماء سنة التاما وصارا لوحا واحدا ، وفي هذا الدير قصران مبنيان بالحجارة ، وهما عاليان كبيران لبياضهما اشراق ، وفيه ايضا عين ماء تجري ، وفي خارجه عين اخري ، وبهذا الوادي عدة معابد قديمة ، وثم واد يقال له الاميلح فيه عين ماء تجري ونخيل مثمرة تاخذ العرب ثمرها ، وخارج هذا الدير ملاحة يبيع رهبان الدير ملحها فيعم تلك الجهات.
 دير السيدة مريم : خارج طنبدي ، ليس فيه سوي راهب واحد وهو علي غير الطريق المسلوك ، وكان باعمال البهنسا عدة ديارات خربت.
 دير برقانا : بحري بني خالد ، وهو مبني بالحجر وعمارته حسنة ، وهو من اعمال المنية ، وكان به في القديم الف راهب ، وليس به الان سوي راهبين ، وهو في الحاجر تحت الجبل.
 دير بالوجه : علي جنب المنهي ، وهو لاهل دلجة ، وهو من الاديرة الكبار ، وقد خرب حتي لم يبق به سوي راهب او راهبين ، وهو بازاء دلجة بينه وبينها نحو ساعتين.

 دير مرقورة : ويقال ابو مرقورة ، هذا الدير تحت دلجة بخارجها من شرقيها وليس به احد.
 دير صنبو : في خارجها من بحريها علي اسم السيدة مريم وليس به احد.
 دير تادرس : قبلي صنبو وقد تلاشي امره لاتضاع حال النصاري.
 دير الريرمون : في شرقي ناحية الريرمون ، وهو شرقي ملوي وغربي انصنا ، وهو علي اسم الملك غبريال.
 دير المحرق : تزعم النصاري ان المسيح عليه السلام اقام في موضعه ستة اشهر واياما ، وله عيد عظيم يعرف بعيد الزيتونة وعيد العنصرة يجتمع فيه عالم كثير.
 دير بني كلب : عرف بذلك لنزول بني كلب حوله ، وهو علي اسم غبريال ، وليس فيه احد من الرهبان وانما هو كنيسة لنصاري منفلوط وهو غربيها.
 دير الجاولية : هذا الدير ناحية الجاولية من قبليها ، وهو علي اسم الشهيد مرقورس الذي يقال له مرقورة ، وعليه رزق محبسة ، وتاتيه النذورات والعواءد وله عيدان في كل سنة.
 دير السبعة جبال : هذا الدير علي راس الجبل الذي غربي سيوط ، علي شاطء النيل ، ويعرف بدير بخنس القصير ، وله عدة اعياد ، وخرب في سنة احدي وعشرين وثمانماءة من منسر طرقه ليلا. بخنس : ويقال ابو بخنس القصير ، كان راهبا قمصا ، له اخبار كثيرة منها : انه غرس خشبة يابسة في الارض بامر شيخه له ، وسقاها الماء مدة فصارت شجرة مثمرة تاكل منها الرهبان ، وسميت شجرة الطاعة ودفن في ديره.
 دير المطل : هذا الدير علي اسم السيدة مريم ، وهو علي طرف الجبل تحت دير السبعة جبال قبالة سيوط ، وله عيد يحضره اهل النواحي وليس به احد من الرهبان.

  اديرة ادرنكة
 اعلم ان ناحية ادرنكة هي من قري النصاري الصعايدة ، ونصاراها اهل علم في دينهم ، وتفاسيرهم في اللسان القبطي ، ولهم اديرة كثيرة في خارج البلد من قبليها مع الجبل ، وقد خرب اكثرها وبقي منها :
 دير بوجرج : وهو عامر البناء وليس به احد من الرهبان ويعمل فيه عيد في اوانه.
 دير ارض الحاجر ودير ميكاءيل ودير كرفونه : علي اسم السيدة مريم ، وكان يقال له ارافونه واغرافونا ومعناه النساخ ، فان نساخ علوم النصاري كانت في القديم تقيم به وهو علي

 طرف الجبل ، وفيه مغاير كثيرة منها ما يسير الماشي بجنبه نحو يومين.
 دير ابي بغام : تحت دير كرفونة بالحاجر ، وقد كان ابو بغام جنديا في ايام ديقلطيانوس فتنصر وعذب ليرجع عن دينه ، ثم قتل في ثامن عشري كانون الاول ، وثاني كيهك.
 ديربوساويرس : بحاجر ادرنكة ، كان علي اسم السيدة مريم ، وكان ساويرس من عظماء الرهبان فعمل بطركا ، وظهرت اية عند موته ، وذلك انه انذرهم لما سار الي الصعيد بانه اذا مات ينشق الجبل وتقع منه قطعة عظيمة علي الكنيسة فلا تضرها ، فلما كان في بعض الايام سقطت قطعة عظيمة من الجبل كما قال ، فعلم رهبان هذا الدير بان ساويرس قد مات ، فارخوا ذلك فوجدوه وقت موته فسموا الدير حينءذ باسمه.
 دير تادرس : تحت دير بوساويرس ، وتادرس اثنان كانا من اجناد ديقلطيانوس ، احدهما يقال له قاتل التنين والاخر الاسفهسلار ، وقتلا كما قتل غيرهما.
 دير منسي اك : ويقال منساك ، وبني ساك وايسااك ، ومعني ذلك اسحاق ، وكان علي اسم السيدة ماريهام يعني مار مريم ، ثم عرف بمنساك ، وكان راهبا قديما له عندهم شهرة ، وبهذا الدير بءر تحته في الحاجر منها شرب الرهبان فاذا زاد النيل شربوا من ماءه.
 دير الرسل : تحت دير منساك ، ويعرف بدير الاثل ، وهو لاعمال بوتيج ، ودير منساك لاهل ربقة هو ودير ساويرس ، ودير كرفونة لاهل سيوط ، ودير بوجرج لاهل ادرنكة ، ودير الاءل كان في خراب فعمر بجانبه كفر لطيف عرف بمنشاة الشيخ ، لان الشيخ ابا بكر الشاذلي انشاه وانشا بستانا كبيرا ، وقد وجد موضعه بءرا كبيرة وجد بها كنزا ، اخبرني من شاهد من ذهبه دنانير مربعة باحد وجهيها صليب وزنة الدينار مثقال ونصف. واديرة ادرنكة المذكورة قريب بعضها من بعض ، وبينها مغاير عديدة منقوش علي الواح فيها نقوشات من كتابة القدماء كما علي البرابي ، وهي مزخرفة بعدة اصباغ ، ملونة تشتمل علي علوم شتي ، ودير السبعة جبال ودير المطل ودير النساخ خارج سيوط في المقابر ، ويقال انه كان في الحاجرين ثلاثماءة وستون ديرا ، وان المسافر كان لا يزال من البدرشين الي اصفون في ظل البساتين ، وقد خرب ذلك وباد اهله.
 دير موشه : وموشه خارج سيوط من قبليها بني علي اسم توما الرسول الهندي ، وهو بين الغيطان قريب من ربقة ، وفي ايام النيل لا يوصل اليه الا في مركب ، وله اعياد والاغلب علي نصاري هذه الاديرة معرفة القبطي الصعيدي ، وهو اصل اللغة القبطية ، وبعدها اللغة القبطية البحرية ، ونساء نصاري الصعيد واولادهم لا يكادون يتكلمون الا بالقبطية الصعيدية ، ولهم ايضا معرفة تامة باللغة الرومية.
 دير ابي مقروفة : وابو مقروفة اسم للبلدة التي بها هذا الدير ، وهو منقور في لحف

 الجبل وفيه عده مغاير وهو علي اسم السيدة مريم ، وبمقروفة نصاري كثيرة غنامة ورعاة اكثرهم همج ، وفيهم قليل من يقرا ويكتب ، وهو دير معطش.
 دير بومغام : خارج طما واهلها نصاري وكانوا قديما اهل علم.
 دير بوشنوده : ويعرف بالدير الابيض ، وهو غربي ناحية سوهاي وبناءه بالحجر وقد خرب ولم يبق منه الا كنيسته ، ويقال ان مساحته اربعة فدادين ونصف وربع ، والباقي منه نحو فدان وهو دير قديم.
 الدير الاحمر : ويعرف بدير ابي بشاي ، وهو بحري الدير الابيض بينهما نحو ثلاث ساعات ، وهو دير لطيف مبني بالطوب الاحمر ، وابو بشاي هذا من الرهبان المعاصرين لشنوده ، وهو تلميذه ، وصار من تحت يده ثلاث الاف راهب ، وله دير اخر في برية شبهات.
 دير ابي ميساس : ويقال ابو ميسيس ، واسمه موسي ، وهذا الدير تحت البلينا وهو دير كبير. وابو ميسيس هذا كان راهبا من اهل البلينا وله عندهم شهرة ، وهم ينذرونه ويزعمون فيه مزاعم ، ولم يبق بعد هذا الدير الا اديرة بحاجر اسنا ونقادة قليلة العمارة ، وكان باصفون دير كبير وكانت اصفون من احسن بلاد مصر واكثر نواحي الصعيد فواكه ، وكان رهبان ديرها معروفين بالعلم والمهارة ، فخربت اصفون وخرب ديرها. وهذا اخر اديرة الصعيد وهي كلها يحمل متلاشية اءلة الي الدثور بعد كثرة عمارتها ووفور اعداد رهبانها وسعة ارزاقهم ، وكثرة ما كان يحمل اليهم.
 واما الوجه البحري : فكان فيه اديرة كثيرة خربت وبقي منها بقية ، فكان بالمقس خارج القاهرة من بحريها عدة كناءس هدمها الحاكم بامر الله ابو علي منصور في تاسع عشر ذي الحجة سنة تسع وتسعين وثلاثماءة واباح ما كان فيها ، فنهب منها شء كثير جدا بعد ما امر في شهر ربيع الاول منها بهدم كناءس راشدة خارج مدينة مصر من شرقيها ، وجعل موضعها الجامع المعروف براشدة ، وهدم ايضا في سنة اربع وتسعين كنيستين هناك ، والزم النصاري بلبس السواد وشد الزنار ، وقبض علي الاملاك التي كانت محبسة علي الكناءس والاديرة وجعلها في ديوان السلطان ، واحرق عدة كثيرة من الصلبان ، ومنع النصاري من اظهار زينة الكناءس في عيد الشعانين ، وتشدد عليهم وضرب جماعة منهم ، وكانت بالروضة كنيسة بجوار المقياس فهدمها السلطان الملك الصالح نجم الدين ايوب في سنة ثمان وثلاثين وستماءة ، وكان في ناحية ابي النمرس من الجيزة كنيسة قام في هدمها رجل من الزيالعة ، لانه سمع اصوات النواقيس يجهر بها في ليلة الجمعة بهذه الكنيسة ، فلم يتمكن من ذلك في ايام الاشرف شعبان بن حسين لتمكن الاقباط في الدولة ، فقام في ذلك مع الامير الكبير برقوق ، وهو يومءذ القاءم بتدبير الدولة ، حتي هدمها علي يد القاضي جمال الدين محمود

 العجمي محتسب القاهرة في ثامن عشر رمضان سنة ثمانين وسبعماءة ، وعملت مسجدا.
 دير الخندق : ظاهر القاهرة من بحريها ، عمره القاءد جوهر عوضا عن دير هدمه في القاهرة ، كان بالقرب من الجامع الاقمر حيث البءر التي تعرف الان ببءر العظمة ، وكانت اذ ذاك تعرف ببءر العظام من اجل انه نقل عظاما كانت بالدير وجعلها بدير الخندق ، ثم هدم دير الخندق في رابع عشري شوال سنة ثمان وسبعين وستماءة ، في ايام المنصور قلاون ، ثم جدد هذا الدير الذي هناك بعد ذلك ، وعمل كنيستين ياتي ذكرهما في الكناءس.
 دير سرياقوس : كان يعرف بابي هور ، وله عيد يجتمع فيه الناس ، وكان فيه اعجوبة ذكرها الشابشتي ، وهو ان من كان به خنازير اخذه رءيس هذا الدير واضجعه وجاءه بخنزير فلحس موضع الوجع ، ثم اكل الخنازير التي فيه فلا يتعدي ذلك الي الموضع الصحيح ، فاذا نظف الموضع ذر عليه رءيس الدير من رماد خنزير فعل مثل هذا الفعل من قبل ودهنه بزيت قنديل البيعة ، فانه يبرا ثم يءخذ ذلك الخنزير الذي اكل خنازير العليل فيذبح ويحرق ، ويعد رماده لمثل هذه الحالة ، فكان لهذا الدير دخل عظيم ممن يبرا من هذه العلة ، وفيه خلق من النصاري.
 دير اتريب : ويعرف بماري مريم ، وعيده في حادي عشري بءنه ، وذكر الشابشتي ان حمامة بيضاء تاتي في ذلك العيد فتدخل المذبح ، لا يدرون من اين جاءت ولا يرونها الي يوم مثله. وقد تلاشي امر هذا الدير حتي لم يبق به الا ثلاثة من الرهبان ، لكنهم يجتمعون في عيده ، وهو علي شاطء النيل قريب من بنها العسل.
 دير المغطس : عند الملاحات قريب من بحيرة البراس ، وتحج اليه النصاري من قبلي ارض مصر ، ومن بحريها ، مثل حجهم الي كنيسة القيامة ، وذلك يوم عيده ، وهو في بشنس ويسمونه عيد الظهور من اجل انهم يزعمون ان السيدة مريم تظهر لهم فيه مزاعم كلها من اكاذيبهم المختلفة ، وليس بحذاء هذا الدير عمارة سوي منشاة صغيرة في قبليه بشرق ، وبقربه الملاحة التي يءخذ منها الملح الرشيدي ، وقد هدم هذا الدير في شهر رمضان سنة احدي واربعين وثمانماءة بقيام بعض الفقراء المعتقدين.
 دير العسكر : في ارض السباخ علي يوم من دير المغطس ، علي اسم الرسل ، وبقربه ملاحة الملح الرشيدي ولم يبق به سوي راهب واحد.
 دير جميانة : علي اسم بوجرج قريب من دير العسكر علي ثلاث ساعات منه ، وعيده عقب عيد دير المغطس وليس به الان احد.
 دير الميمنة : بالقرب من دير العسكر ، كانت له حالات جليلة ، ولم يكن في القديم دير بالوجه البحري اكثر رهبانا منه ، الا انه تلاشي امره وخرب ، فنزله الحبش وعمروه ،

 وليس في السباخ سوي هذه الاربعة الاديرة. واما وادي هبيب وهو وادي النطرون ، ويعرف ببرية شيهات وببرية الاسقط وبميزان القلوب ، فانه كان بها في القديم ماءة دير ، ثم صارت سبعة ممتدة غربا علي جانب البرية القاطعة بين بلاد البحيرة والفيوم ، وهي في رمال منقطعة وسباخ مالحة وبرار منقطعة معطشة وقفار مهلكة ، وشارب اهلها من حفاءر ، وتحمل النصاري اليهم النذور والقرابين ، وقد تلاشت في هذا الوقت بعدما ذكر مءرخو النصاري انه خرج الي عمرو بن العاص من هذه الاديرة سبعون الف راهب بيد كل واحد عكاز ، فسلموا عليه وانه كتب لهم كتابا هو عندهم.
 فمنها دير ابي مقار الكبير : وهو دير جليل عندهم ، وبخارجه اديرة كثيرة خربت ، وكان دير النساك في القديم ، ولا يصح عندهم بطركية البطرك حتي يجلسوه في هذا الدير بعد جلوسه بكرسي اسكندرية ، ويذكر انه كان فيه من الرهبان الف وخمسماءة لا تزال مقيمة به ، وليس به الان الا قليل منهم ، والمقارات ثلاثة : اكبرهم صاحب هذا الدير ، ثم ابو مقار الاسكندراني ، ثم ابو مقار الاسقف. وهءلاء الثلاثة قد وضعت رممهم في ثلاث انابيب من خشب ، وتزورها النصاري بهذا الدير ، وبه ايضا الكتاب الذي كتبه عمرو بن العاص لرهبان وادي هبيب بجرانة نواحي الوجه البحري علي ما اخبرني من اخبر برءيته فيه.
 ابو مقار الاكبر : هو مقاريوس ، اخذ الرهبانية عن انطونيوس ، وهو اول من لبس عندهم القلنسوة والاشكيم ، وهو سير من جلد فيه صليب يتوشح به الرهبان فقط ، ولقي انطونيوس بالجبل الشرقي من حيث دير العزبة ، واقام عنده مدة ، ثم البسه لباس الرهبانية وامره بالمسير الي وادي النطرون ليقيم هناك ، ففعل ذلك واجتمع عنده الرهبان الكثيرة العدد ، وله عندهم فضاءل عديدة منها : انه كان لا يصوم الاربعين الا طاويا في جميعها لا يتناول غذاء ولا شرابا البتة ، مع قيام ليلها. وكان لا يعمل الخوص ويتقوت منه ، وما اكل خبزا طريا قط ، بل ياخذ القراقيش فيبلها في نقاعة الخوص ويتناول منها هو ورهبان الدير ما يمسك الرمق من غير زيادة ، هذا قوتهم مدة حياتهم حتي مضوا لسبيلهم ، واما ابو مقار الاسكندراني فانه ساح من الاسكندرية الي مقاريوس المذكور وترهب علي يديه ، ثم كان ابو مقار الثالث وصار اسقفا.
 دير ابي بخنس القصير : يقال انه عمر في ايام قسطنطين بن هيلانة ، ولابي بخنس هذا فضاءل مذكورة ، وهو من اجل الرهبان ، وكان لهذا الدير حالات شهيرة وبه طواءف من الرهبان ، ولم يبق به الان الا ثلاثة رهبان.
 دير الياس : عليه السلام ، وهو دير للحبشة ، وقد خرب دير بخنس كما خرب دير الياس ، اكلت الارضة اخشابهما فسقطا ، وصار الحبشة الي دير سيدة بوبخنس القصير ، وهو دير لطيف بجوار دير بوبخنس القصير. وبالقرب من هذه الاديرة.

 دير انبانوب : وقد خرب هذا الدير ايضا انبانوب هذا من اهل سمنود قتل في الاسلام ووضع جسده في بيت بسمنود.
 دير الارمن : قريب من هذه الاديرة وقد خرب. وبجوارها ايضا :
 دير بوبشاي : وهو دير عظيم عندهم ، من اجل ان بوبشاي هذا كان من الرهبان الذين في طبقة مقاريوس وبخنس القصير ، وهو دير كبير جدا.
 دير بازاء دير بوبشاي : كان بيد اليعاقبة ، ثم ملكته رهبان السريان من نحو ثلاثماءة سنة ، وهو بيدهم الان ، ومواضع هذه الاديرة يقال لها بركة الاديرة.
 دير سيدة برموس : علي اسم السيدة مريم فيه بعض رهبان. وبازاءه :
 دير موسي : ويقال ابو موسي الاسود ، ويقال برمءس ، وهذا الدير لسيدة برمءس ، فبرموس اسم الدير وله قصة حاصلها ان مكسيموس ودوماديوس كانا ولدي ملك الروم ، وكان لهما معلم يقال له ارسانيوس ، فسار المعلم من بلاد الروم الي ارض مصر ، وعبر برية شيهات هذه ، وترهب واقام بها حتي مات ، وكان فاضلا. واتاه في حياته ابنا الملك المذكوران وترهبا علي يديه ، فلما ماتا بعث ابوهما فبني علي اسمهما كنيسة برموس. وابو موسي الاسود كان لصا فاتكا قتل ماءة نفس ، ثم انه تنصر وترهب وصنف عدة كتب ، وكان ممن يطوي الاربعين في صومه وهو بربري.
 دير الزجاج : هذا الدير خارج مدينة الاسكندرية ، ويقال له الهايطون ، وهو علي اسم بوجرج الكبير ، ومن شرط البطرك انه لا بد ان يتوجه من المعلقة بمصر الي دير الزجاج هذا ، ثم انهم في هذا الزمان تركوا ذلك ، فهذه اديرة اليعاقبة.
 وللنساء ديارات تختص بهن : فمنها دير الراهبات بحارة زويلة من القاهرة ، وهو دير عامر بالابكار المترهبات وغيرهن من نساء النصاري.
 دير البنات : بحارة الروم بالقاهرة عامر بالنساء المترهبات.
 دير المعلقة : بمدينة مصر ، وهو اشهر ديارات النساء عامر بهن.
 دير بربارة : بمصر بجوار كنيسة بربارة عامر بالبنات المترهبات بربارة : كانت قديسة في زمان دقلطيانوس ، فعذبها لترجع عن ديانتها وتسجد للاصنام ، فثبتت علي دينها وصبرت علي عذاب شديد وهي بكر لم يمسها رجل ، فلما يءس منها ضرب عنقها وعنق عدة من النساء معها وللنصاري الملكية قلاية بطركهم بجوار كنيسة ميكاءيل بالقرب من جسر الافرم خارج مصر ، وهي مجمع الرهبان الواردين من بلاد الروم.

 دير بخنس القصير : المعروف بالقصير ، وصوابه عندهم دير القصير علي وزن شهيد ، وحرف فقيل دير القصير ، بضم القاف وفتح الصاد وتشديد الياء ، فسماه المسلمون دير القصير بضم القاف وفتح الصاد واسكان الياء اخر الحروف ، كانه تصغير قصير ، واصله كما عرفتك دير القصير الذي هو ضد الطويل ، وسمي ايضا دير هر قل ، ودير البغل ، وقد تقدم ذكره. وكان من اعظم ديارات النصاري وليس به الان سوي واحد يحرسه ، وهو بيد الملكية.
 دير الطور : قال ابن سيده : الطور الجبل ، وقد غلب علي طور سيناء جبل بالشام ، وهو بالسريانية طوري والنسب اليه طوري وطواري. وقال ياقوت : طور سبعة مواضع : الاول طور زيتا بلفظ الزيت من الادهان مقصور علم لجبل بقرب راس عين. الثاني طور زيت ايضا جبل بالبيت المقدس ، وهو شرقي سلوان. الثالث الطور علم لجبل بعينه مطل علي مدينة طبرية بالاردن. الرابع الطور علم لجبل كورة تشتمل علي عدة قري بارض مصر من الجهة القبلية بين مصر وجبل فاران. الخامس طور سيناء اختلفوا فيه فقيل هو جبل بقرب ايلة ، وقيل جبل بالشام ، وقيل سيناء حجازية ، وقيل سحرتية. السادس طور عبدين بفتح العين وسكون الباء الموحدة وكسر الدال المهملة وياء اخر الحروف ونون ، اسم لبلدة من نواحي نصيبين في بطن الجبل المشرف عليها المتصل بجبل جودي. السابع طور هارون اخي موسي عليهما السلام . وقال الواحدي : في تفسيره ، وقال الكلبي وغيره : والجبل في قوله تعالي ، ولكن انظر الي الجبل اعظم جبل بمدين يقال له زبير ، وذكر الكلبي ان الطور سمي بيطور بن اسماعيل. قال السهيلي : فلعله محذوف الياء ان كان صح ما قاله.
 وقال عمر بن شيبة : اخبرني عبد العزيز عن ابي معشر عن سعيد بن ابي سعيد عن ابيه عن ابي هريرة رضياللهعنه قال : قال رسول الله صلي الله عليه وسلم : «اربعة انهار في الجنة واربعة اجبل واربع ملاحم في الجنة ، فاما الانهار فسيحان وجيحان والنيل والفرات ، واما الاجبل فالطور ولبنان واحد وورقان ، وسكت عن الملاحم». وعن كعب الاحبار معاقل المسلمين ثلاثة : فمعقلهم من الروم دمشق ، ومعقلهم من الدجال الاردن ، ومعقلهم من ياجوج وماجوج الطور. وقال شعبة عن ارطاة بن المنذر : اذا خرج ياجوج وماجوج اوحي الله تعالي الي عيسي بن مريم عليه السلام اني قد اخرجت خلقا من خلقي لا يطيقهم احد غيري. فمر بمن معك الي جبل الطور ، فيمر ومعه من الذراري اثنا عشر الفا. وقال طلق بن حبيب عن زرعة : اردت الخروج الي الطور فاتيت عبد الله بن عمر رضياللهعنهما فقلت له : فقال انما تشد الرحال الي ثلاثة مساجد : الي مسجد رسول الله صلي الله عليه وسلم ، والمسجد الحرام ، والمسجد الاقصي. فدع عنك الطور فلا تاته. وقال القاضي ابو عبد الله محمد بن سلامة القضاعي ، وقد ذكر كور ارض مصر : ومن كور القبلة قري الحجاز وهي : كورة الطور وفاران ، وكورة

 راية والقلزم ، وكورة ايلة وحيزها ، ومدين وحيزها ، والعويبد والحوراء وحيزهما ، ثم كورة بدا وشعيب. قلت لا خلاف بين علماء الاخبار من اهل الكتاب ان جبل الطور هذا هو الذي كلم الله تعالي نبيه موسي عليه السلام عليه ، او عنده ، وبه الي الان دير بيد الملكية وهو عامر وفيه بستان كبير به نخل وعنب وغير ذلك من الفواكه. وقال الشابشتي : وطور سينا هو الجبل الذي تجلي فيه النور لموسي بن عمران عليه السلام ، وفيه صعق ، والدير في اعلي الجبل مبني بحجر اسود ، عرض حصنه سبع اذرع ، وله ثلاثة ابواب حديد ، وفي غربيه باب لطيف ، وقدامه حجر اقيم اذا ارادوا رفعه رفعوه ، واذا قصدهم احد ارسلوه فانطبق علي الموضع فلم يعرف مكان الباب ، وداخل الدير عين ماء ، وخارجه عين اخري ، وزعم النصاري ان به نارا من انواع النار التي كانت ببيت المقدس ، يقدمون منها في كل عشية ، وهي بيضاء لطيفة ضعيفة الحر لا تحرق ، ثم تقوي اذا اوقد منها السراج ، وهو عامر بالرهبان ، والناس يقصدونه ، وهو من الديارات الموصوفة. قال ابن عامر فيه :
 يا راهب الدير ما ذا الضوء والنور ~ فقد اضاء بما في ديرك الطور
هل حلت الشمس فيه دون ابرجها ~ او غيب البدر فيه وهو مستور
فقال ما حله شمس ولا قمر ~ لكن تقرب فيه اليوم قورير
 قلت ذكر مءرخو النصاري ان هذا الدير امر بعمارته يوسطيانوس ملك الروم بقسطنطينية ، فعمل عليه حصن فوقه عدة قلالي ، واقيم فيه الحرس لحفظ رهبانه من قوم يقال لهم بنو صالح من العرب ، وفي ايام هذا الملك كان المجمع الخامس من مجامع النصاري ، وبينه وبين القلزم ، وكانت مدينة ، طريقان احداهما في البر والاخري في البحر ، وهما جميعا يءديان الي مدينة فاران ، وهي من مداءن العمالقة ، ثم منها الي الطور مسيرة يومين ، ومن مدينة مصر الي القلزم ثلاثة ايام ، ويصعد الي جبل الطور بستة الاف وستماءة وست وستين مرقاة ، وفي نصف الجبل كنيسة لايلياء النبي ، وفي قلته كنيسة علي اسم موسي عليه السلام باساطين من رخام ، وابواب من صفر ، وهو الموضع الذي كلم الله تعالي فيه موسي ، وقطع منه الالواح ولا يكون فيها الا راهب واحد للخدمة ، ويزعمون انه لا يقدر احد ان يبيت فيها ، بل يهيا له موضع من خارج يبيت فيه ، ولم يبق لهاتين الكنيستين وجود.
 دير البنات بقصر الشمع بمصر : وهو علي اسم بوجرج ، وكان مقياس النيل قبل الاسلام ، وبه اثار ذلك الي اليوم ، فهذا ما للنصاري اليعاقبة ، والملكية رجالهم ونساءهم من الديارات بارض مصر قبليها وبحريها ، وعدتها ستة وثمانون ديرا منها لليعاقبة ... () ديرا وللملكية ... ().

  ذكر كناءس النصاري
 قال الازهري : كنيسة اليهود جمعها كناءس ، وهي معربة اصلها كنشت. انتهي. وقد نطقت العرب بذكر الكنيسة. قال العباس بن مرداس السلمي :
 بدورون بي في ظل كل كنيسة ~ وما كان قومي يبنون الكناءسا
 وقال ابن قيس الرقيات : كانها دمية مصورة في بيعة من كناءس الروم.
 كنيستا الخندق : ظاهر القاهرة ، احداهما علي اسم غبريال الملاك ، والاخري علي اسم مرقوريوس ، وعرفت برويس ، وكان راهبا مشهورا بعد سنة ثمانماءة ، وعند هاتين الكنيستين يقبر النصاري موتاهم ، وتعرف بمقبرة الخندق ، وعمرت هاتان الكنيستان عوضا عن كناءس المقس في الايام الاسلامية.
 كنيسة حارة زويلة بالقاهرة : كنيسة عظيمة عند النصاري اليعاقبة ، وهي علي اسم السيدة ، وزعموا انها قديمة تعرف بالحكيم زايلون ، وكان قبل الملة الاسلامية بنحو ماءتين وسبعين سنة ، وانه صاحب علوم شتي ، وان له كنزا عظيما يتوصل اليه من بءر هناك.
 كنيسة تعرف بالمغيءة : بحارة الروم من القاهرة علي اسم السيدة مريم ، وليس لليعاقبة بالقاهرة سوي هاتين الكنيستين ، وكان بحارة الروم ايضا كنيسة اخري يقال لها كنيسة بربارة هدمت في سنة ثمان عشرة وسبعماءة ، وسبب ذلك ان النصاري رفعوا قصة للسلطان الملك الناصر محمد بن قلاون يسالون الاذن في اعادة ما تهدم منها ، فاذن لهم في ذلك فعمروها احسن ما كانت ، فغضبت طاءفة من المسلمين ورفعوا قصة للسلطان بان النصاري احدثوا بجانب هذه الكنيسة بناء لم يكن فيها ، فرسم للامير علم الدين سنجر الخازن ، والي القاهرة بهدم ما جددوه ، فركب وقد اجتمع الخلاءق ، فبادروا وهدموا الكنيسة كلها في اسرع وقت ، واقاموا في موضعها محرابا واذنوا وصلوا وقرءا القران ، كل ذلك بايديهم ، فلم تمكن معارضتهم خشية الفتنة ، فاشتد الامر علي النصاري وشكوا امرهم للقاضي كريم الدين ناظر الخاص ، فقام وقعد غضبا لدين اسلافه ، وما زال بالسلطان حتي رسم بهدم المحراب فهدم ، وصار موضعه كوم تراب ومضي الحال علي ذلك.
 كنيسة بومنا : هذه الكنيسة قريبة من السد فيما بين الكيمان بطريق مصر ، وهي ثلاث كناءس متجاورة ، احداها لليعاقبة ، والاخري للسريان ، واخري للارمن ، ولها عيد في كل سنة تجتمع اليه النصاري.
 كنيسة المعلقة : بمدينة مصر في خط قصر الشمع ، علي اسم السيدة ، وهي جليلة القدر عندهم ، وهي غير القلاية التي تقدم ذكرها.

 كنيسة شنوده : بمصر ، نسبت لابي شنودة الراهب القديم ، وله اخبار منها : انه كان ممن يطوي في الاربعين اذا صام ، وكان تحت يده ستة الاف راهب يتقوت هو واياهم من عمل الخوص ، وله عدة مصنفات.
 كنيسة مريم : بجوار كنيسة شنودة ، هدمها علي بن سليمان بن علي بن عبد الله بن عباس امير مصر لما ولي من قبل امير المءمنين الهادي موسي ، في سنة تسع وستين وماءة ، وهدم كناءس محرس قسطنطين ، وبذل له النصاري في تركها خمسين الف دينار فامتنع ، فلما عزل بموسي بن عيسي بن موسي بن محمد بن علي بن عبد الله بن عباس في خلافة هارون الرشيد ، اذن موسي بن عيسي للنصاري في بنيان الكناءس التي هدمها علي بن سليمان ، فبنيت كلها بمشورة الليث بن سعد ، وعبد الله بن لهيعة. وقالا هو من عمارة البلاد ، واحتجا بان الكناءس التي بمصر لم تبن الا في الاسلام في زمن الصحابة والتابعين.
 كنيسة بوجرج الثقة : هذه الكنيسة في درب بخط قصر الشمع بمصر يقال له درب الثقة ، ويجاورها كنيسة سيدة بوجرج.
 كنيسة بربارة : بمصر ، كبيرة جليلة عندهم ، وهي تنسب الي القديسة بربارة الراهبة ، وكان في زمانها راهبتان بكران ، وهما ايسي وتكلة ، ويعمل لهن عيد عظيم بهذه الكنيسة يحضره البطريق.
 كنيسة بوسرحه : بالقرب من بربارة بجوار زاوية ابن النعمان ، فيها مغارة يقال ان المسيح وامه مريم عليها السلام جلسا بها.
 كنيسة بابليون : في قبلي قصر الشمع بطريق جسر الافرم ، وهذه الكنيسة قديمة جدا ، وهي لطيفة ، ويذكر ان تحتها كنز بابليون وقد خرب ما حولها.
 كنيسة تاودورس الشهيد : بجوار بابليون ، نسبت للشهيد تاودورس الاسفهسلار.
 كنيسة بومنا بجوار بابليون ايضا : وهاتان الكنيستان مغلوقتان لخراب ما حولهما.
 كنيسة بومنا : بالحمراء ، وتعرف الحمراء اليوم بخط قناطر السباع ، فيما بين القاهرة ومصر ، واحدثت هذه الكنيسة في سنة سبع عشرة وماءة من سني الهجرة باذن الوليد بن رفاعة امير مصر ، فغضب وهيب اليحصبي وخرج علي السلطان وجاء الي ابن رفاعة ليفتك به ، فاخذ وقتل ، وكان وهيب مدريا من اليمن ، قدم الي مصر فخرج القراء علي الوليد بن رفاعة غضبا لوهيب وقاتلوه ، وصارت معونة امراة وهيب تطوف ليلا علي منازل القراء تحرضهم علي الطلب بدمه ، وقد حلقت راسها ، وكانت امراة جزلة ، فاخذ ابن رفاعة ابا عيسي مروان بن عبد الرحمن اليحصبي بالقراء ، فاعتذر وخلي ابن رفاعة عنهم ، فسكنت

 الفتنة بعد ما قتل جماعة ، ولم تزل هذه الكنيسة بالحمراء الي ان كانت واقعة هدم الكناءس في ايام الناصر محمد بن قلاون علي ما ياتي ذكر ذلك ، والخبر عن هدم جميع كناءس ارض مصر وديارات النصاري في وقت واحد.
 كنيسة الزهري : كانت في الموضع الذي فيه اليوم البركة الناصرية بالقرب من قناطر السباع في بر الخليج الغربي ، غربي اللوق ، واتفق في امرها عدة حوادث ، وذلك ان الملك الناصر محمد بن قلاون لما انشا ميدان المهاري المجاور لقناطر السباع ، في سنة عشرين وسبعماءة ، قصد بناء زريبة علي النيل الاعظم بجوار الجامع الطيبرسي ، فامر بنقل كوم تراب كان هناك ، وحفر ما تحته من الطين لاجل بناء الزريبة ، واجري الماء الي مكان الحفر ، فصار يعرف الي اليوم بالبركة الناصرية ، وكان الشروع في حفر هذه البركة من اخر شهر ربيع الاول سنة احدي وعشرين وسبعماءة ، فلما انتهي الحفر الي جانب كنيسة الزهري ، وكان بها كثير من النصاري لا يزالون فيها ، وبجانبها ايضا عدة كناءس في الموضع الذي يعرف اليوم بحكر اقبغا ، ما بين السبع سقايات وبين قنطرة السد خارج مدينة مصر ، اخذ الفعلة في الحفر حول كنيسة الزهري حتي بقيت قاءمة في وسط الموضع الذي عينه السلطان ليحفر ، وهو اليوم بركة الناصرية ، وزاد الحفر حتي تعلقت الكنيسة ، وكان القصد من ذلك ان تسقط من غير قصد لخرابها ، وصارت العامة من غلمان الامراء العمالين في الحفر وغيرهم في كل وقت يصرخون علي الامراء في طلب هدمها وهم يتغافلون عنهم الي ان كان يوم الجمعة التاسع من شهر ربيع الاخر من هذه السنة ، وقت اشتغال الناس بصلاة الجمعة ، والعمل من الحفر بطال ، فتجمع عدة من غوغاء العامة بغير مرسوم السلطان وقالوا بصوت عال مرتفع الله اكبر ، ووضعوا ايديهم بالمساحي ونحوها في كنيسة الزهري وهدموها حتي بقيت كوما ، وقتلوا من كان فيها من النصاري ، واخذوا جميع ما كان فيها ، وهدموا كنيسة بومنا التي كانت بالحمراء ، وكانت معظمة عند النصاري من قديم الزمان ، وبها عدة من النصاري قد انقطعوا فيها ، ويحمل اليهم نصاري مصر ساءر ما يحتاج اليه ، ويبعث اليها بالنذور الجليلة والصدقات الكثيرة ، فوجد فيها مال كثير ما بين نقد ومصاغ وغيره ، وتسلق العامة الي اعلاها وفتحوا ابوابها واخذوا منها مالا وقماشا وجرار خمر ، فكان امرا مهولا.
 ثم مضوا من كنيسة الحمراء بعد ما هدموها الي كنيستين بجوار السبع سقايات تعرف احداهما بكنيسة البنات ، كان يسكنها بنات النصاري وعدة من الرهبان ، فكسروا ابواب الكنيستين وسبوا البنات وكن زيادة علي ستين بنتا ، واخذوا ما عليهن من الثياب ونهبوا ساءر ما ظفروا به ، وحرقوا وهدموا تلك الكناءس كلها ، هذا والناس في صلاة الجمعة ، فعندما خرج الناس من الجوامع شاهدوا هولا كبيرا من كثرة الغبار ودخان الحريق ومرج الناس وشدة حركاتهم ، ومعهم ما نهبوه ، فما شبه الناس الحال لهوله الا بيوم القيامة ، وانتشر الخبر وطار الي الرميلة تحت قلعة الجبل ، فسمع السلطان ضجة عظيمة ورجة منكرة افزعته ،

 فبعث لكشف الخبر ، فلما بلغه ما وقع انزعج انزعاجا عظيما وغضب من تجري العامة واقدامهم علي ذلك بغير امره ، وامر الامير ايدغمش اميراخور ان يركب بجماعة الاوشاقية ويتدارك هذا الخلل ، ويقبض علي من فعله ، فاخذ ايدغمش يتهيا للركوب واذا بخبر قد ورد من القاهرة ان العامة ثارت في القاهرة وخربت كنيسة بحارة الروم ، وكنيسة بحارة زويلة ، وجاء الخبر من مدينة مصر ايضا بان العامة قامت بمصر في جمع كثير جدا وزحفت الي كنيسة المعلقة بقصر الشمع فاغلقها النصاري وهم محصورون بها وهي علي ان توخذ ، فتزايد غضب السلطان وهم ان يركب بنفسه ويبطش بالعامة ، ثم تاخر لما راجعه الامير ايدغمش ونزل من القلعة في اربعة من الامراء الي مصر ، وركب الامير بيبرس الحاجب ، والامير الماس الحاجب الي موضع الحفر ، وركب الامير طينال الي القاهرة ، وكل منهم في عدة وافرة ، وقد امر السلطان بقتل من قدروا عليه من العامة ، بحيث لا يعفو عن احد ، فقامت القاهرة ومصر علي ساق ، وفرت النهابة ، فلم يظفر الامراء منهم الا بمن عجز عن الحركة بما غلبه من السكر بالخمر الذي نهبه من الكناءس ، ولحق الامير ايدغمش بمصر وقد ركب الوالي الي المعلقة قبل وصوله ليخرج من زقاق المعلقة من حضر للنهب ، فاخذه الرجم حتي فر منهم ، ولم يبق الا ان يحرق باب الكنيسة ، فجرد ايدغمش ومن معه السيوف يريدون الفتك بالعامة ، فوجدوا عالما لا يقع عليه حصر ، وخاف سوء العاقبة ، فامسك عن القتل وامر اصحابه بارجاف العامة من غير اهراق دم ، ونادي منادية : من وقف حل دمه. ففر ساءر من اجتمع من العامة وتفرقوا ، وصار ايدغمش واقفا الي ان اذن العصر خوفا من عود العامة ، ثم مضي والزم والي مصر ان يبيت باعوانه هناك ، وترك معه خمسين من الاوشاقية.
 واما الامير الماس فانه وصل الي كناءس الحمراء وكناءس الزهري ليتداركها ، فاذا بها قد بقيت كيمانا ليس بها جدار قاءم ، فعاد وعاد الامراء ، فردوا الخبر علي السلطان وهو لا يزداد الا حنقا ، فما زالوا به حتي سكن غضبه ، وكان الامر في هدم هذه الكناءس عجبا من العجب ، وهو ان الناس لما كانوا في صلاة الجمعة من هذا اليوم بجامع قلعة الجبل ، فعندما فرغوا من الصلاة قام رجل موله وهو يصيح من وسط الجامع : اهدموا الكنيسة التي في القلعة ، اهدموها. واكثر من الصياح المزعج حتي خرج عن الحد ، ثم اضطرب. فتعجب السلطان والامراء من قوله ، ورسم لنقيب الجيوش والحاجب بالفحص عن ذلك ، فمضيا من الجامع الي خراءب التتر من القلعة ، فاذا فيها كنيسة قد بنيت فهدموها ، ولم يفرغوا من هدمها حتي وصل الخبر بواقعة كناءس الحمراء والقاهرة ، فكثر تعجب السلطان من شان ذلك الفقير ، وطلب فلم يوقف له علي خبر ، واتفق ايضا بالجامع الازهر ان الناس لما اجتمعوا في هذا اليوم لصلاة الجمعة ، اخذ شخصا من الفقراء مثل الرعدة ، ثم قام بعد ما اذن قبل ان يخرج الخطيب وقال : اهدموا كناءس الطغيان والكفرة ، نعم الله اكبر ، فتح الله ونصر.

 وصار يزعج نفسه ويصرخ من الاساس الي الاساس ، فحدق الناس بالنظر اليه ولم يدروا ما خبره ، وافترقوا في امره. فقاءل هذا مجنون ، وقاءل هذه اشارة لشء. فلما خرج الخطيب امسك عن الصياح ، وطلب بعد انقضاء الصلاة فلم يوجد. وخرج الناس الي باب الجامع فراوا النهابة ومعهم اخشاب الكناءس وثياب النصاري وغير ذلك من النهوب ، فسالوا عن الخبر فقيل : قد نادي السلطان بخراب الكناءس ، فظن الناس الامر كما قيل ، حتي تبين بعد قليل ان هذا الامر انما كان من غير امر السلطان ، وكان الذي هدم في هذا اليوم من الكناءس بالقاهرة ، كنيسة بحارة الروم ، وكنيسة بالبندقانيين ، وكنيستين بحارة زويلة. وفي يوم الاحد الثالث من يوم الجمعة الكاءن فيه هدم كناءس القاهرة ومصر ، ورد الخبر من الامير بدر الدين بيلبك المحسني والي الاسكندرية ، بانه لما كان يوم الجمعة تاسع ربيع الاخر بعد صلاة الجمعة ، وقع في الناس هرج ، وخرجوا من الجامع وقد وقع الصياح : هدمت الكناءس فركب المملوك من فوره فوجد الكناءس قد صارت كوما ، وعدتها اربع كناءس ، وان بطاقة وقعت من والي البحيرة بان كنيستين في مدينة دمنهور هدمتا والناس في صلاة الجمعة من هذا اليوم ، فكثر التعجب من ذلك ، الي ان ورد في يوم الجمعة سادس عشرة الخبر من مدينة قوص بان الناس عند ما فرغوا من صلاة الجمعة في اليوم التاسع من شهر ربيع الاخر ، قام رجل من الفقراء وقال يا فقراء اخرجوا الي هدم الكناءس ، وخرج في جمع من الناس فوجدوا الهدم قد وقع في الكناءس ، فهدمت ست كناءس كانت بقوص وما حولها في ساعة واحدة ، وتواتر الخبر من الوجه القبلي والوجه البحري بكثرة ما هدم في هذا اليوم وقت صلاة الجمعة وما بعدها من الكناءس والاديرة ، في جميع اقليم مصر كله ، ما بين قوص والاسكندرية ودمياط ، فاشتد حنق السلطان علي العامة خوفا من فساد الحال ، واخذ الامراء في تسكين غضبه وقالوا : هذا الامر ليس من قدرة البشر فعله ، ولو اراد السلطان وقوع ذلك علي هذه الصورة لما قدر عليه ، وما هذا الا بامر الله سبحانه ، وبقدره لما علم من كثرة فساد النصاري وزيادة طغيانهم ، ليكون ما وقع نقمة وعذابا لهم ، هذا والعامة بالقاهرة ومصر قد اشتد خوفهم من السلطان لما كان يبلغهم عنه من التهديد لهم بالقتل ، ففر عدة من الاوباش والغوغاء ، واخذ القاضي فخر الدين ناظر الجيش في ترجيع السلطان عن الفتك بالعامة وسياسة الحال معه ، واخذ كريم الدين الكبير ناظر الخاص يغريه بهم الي ان اخرجه السلطان الي الاسكندرية بسبب تحصيل المال ، وكشف الكناءس التي خربت بها.
 فلم يمض سوي شهر من يوم هدم الكناءس حتي وقع الحريق بالقاهرة ومصر في عدة مواضع ، وحصل فيه من الشناعة اضعاف ما كان من هدم الكناءس ، فوقع الحريق في ربع بخط الشوايين من القاهرة ، في يوم السبت عاشر جمادي الاولي ، وسرت النار الي ما حوله واستمرت الي اخر يوم الاحد ، فتلف في هذا الحريق شء كثير ، وعند ما اطفء وقع الحريق بحارة الديلم في زقاق العريسة بالقرب من دور كريم الدين ناظر الخاص ، في خامس عشري

 جمادي الاولي ، وكانت ليلة شديدة الريح ، فسرت النار من كل ناحية حتي وصلت الي بيت كريم الدين ، وبلغ ذلك السلطان فانزعج انزعاجا عظيما لما كان هناك من الحواصل السلطانية ، وسير طاءفة من الامراء لاطفاءه ، فجمعوا الناس لاطفاءه وتكاثروا عليه وقد عظم الخطب من ليلة الاثنين الي ليلة الثلاثاء ، فتزايد الحال في اشتعال النار وعجز الامراء والناس عن اطفاءها لكثرة انتشارها في الاماكن وقوة الريح التي القت باسقات النخل ، وغرقت المراكب ، فلم يشك الناس في حريق القاهرة كلها ، وصعدوا الماذن ، وبرز الفقراء واهل الخير والصلاح وضجوا بالتكبير والدعاء ، وجاروا وكثر صراخ الناس وبكاءهم ، وصعد السلطان الي اعلي القصر فلم يتمالك الوقوف من شدة الريح ، واستمر الحريق والاستحثاث يرد علي الامراء من السلطان في اطفاءه الي يوم الثلاثاء ، فنزل ناءب السلطان ومعه جميع الامراء وساءر السقاءين ، ونزل الامير بكتمر الساقي ، فكان يوما عظيما لم ير الناس اعظم منه ولا اشد هولا ، ووكل بابواب القاهرة من يرد السقاءين اذا خرجوا من القاهرة لاجل اطفاء النار ، فلم يبق احد من سقاءي الامراء وسقاءي البلد الا وعمل ، وصاروا ينقلون الماء من المدارس والحمامات ، واخذ جميع النجارين وساءر البناءين لهدم الدور ، فهدم في هذه النوبة ما شاء الله من الدور العظيمة والرباع الكبيرة ، وعمل في هذا الحريق اربعة وعشرون اميرا من الامراء المقدمين ، سوي من عداهم من امراء الطبلخانات والعشراوات والمماليك ، وعمل الامراء بانفسهم فيه ، وصار الماء من باب زويلة الي حارة الديلم في الشارع بحرا من كثرة الرجال والجمال التي تحمل الماء ، ووقف الامير بكتمر الساقي والامير ارغون الناءب علي نقل الحواصل السلطانية من بيت كريم الدين الي بيت ولده بدرب الرصاصي ، وخربوا ستة عشر دارا من جوار الدار وقبالتها ، حتي تمكنوا من نقل الحواصل ، فما هو الا ان كمل اطفاء الحريق ونقل الحواصل ، واذا بالحريق قد وقع في ربع الظاهر خارج باب زويلة ، وكان يشتمل علي ماءة وعشرين بيتا ، وتحته قيسارية تعرف بقيسارية الفقراء ، وهب مع الحريق ريح قوية ، فركب الحاجب والوالي لاطفاءه وهدموا عدة دور من حوله حتي انطفا ، فوقع في ثاني يوم حريق بدار الامير سلار في خط بين القصرين ، ابتدا من الباذهنج ، وكان ارتفاعه عن الارض ماءة ذراع بالعمل ، فوقع الاجتهاد فيه حتي اطفء ، فامر السلطان الامير علم الدين سنجر الخازن والي القاهرة ، والامير ركن الدين بيبرس الحاجب ، بالاحتراز واليقظة ، ونودي بان يعمل عند كل حانوت دن فيه ماء ، او زير مملوء بالماء ، وان يقام مثل ذلك في جميع الحارات والازقة والدروب ، فبلغ ثمن كل دن خمس دراهم بعد درهم ، وثمن الزير ثمانية دراهم ، ووقع حريق بحارة الروم وعدة مواضع ، حتي انه لم يخل يوم من وقوع الحريق في موضع ، فتنبه الناس لما نزل بهم ، وظنوا انه من افعال النصاري ، وذلك ان النار كانت تري في منابر الجوامع وحيطان المساجد والمدارس ، فاستعدوا للحريق وتتبعوا الاحوال حتي وجدوا هذا الحريق من نفط قد لف عليه خرق مبلولة بزيت وقطران. فلما كان

 ليلة الجمعة النصف من جمادي ، قبض علي راهبين عند ما خرجا من المدرسة الكهارية بعد العشاء الاخرة ، وقد اشتعلت النار في المدرسة ، وراءحة الكبريت في ايديهما ، فحملا الي الامير علم الدين الخازن والي القاهرة ، فاعلم السلطان بذلك فامر بعقوبتهما ، فما هو الا ان نزل من القلعة واذا بالعامة قد امسكوا نصرانيا وجد في جامع الظاهر ومعه خرق علي هيءة الكعكة ، في داخلها قطران ونفط ، وقد القي منها واحدة بجانب المنبر ، وما زال واقفا الي ان خرج الدخان فمشي يريد الخروج من الجامع ، وكان قد فطن به شخص وتامله من حيث لم يشعر به النصراني ، فقبض عليه وتكاثر الناس فجروه الي بيت الوالي وهو بهيءة المسلمين ، فعوقب عند الامير ركن الدين بيبرس الحاجب ، فاعترف بان جماعة من النصاري قد اجتمعوا علي عمل نفط وتفريقه مع جماعة من اتباعهم ، وانه ممن اعطي ذلك وامر بوضعه عند منبر جامع الظاهر ، ثم امر بالراهبين فعوقبا فاعترفا انهما من سكان دير البغل ، وانهما هما اللذان احرقا المواضع التي تقدم ذكرها بالقاهرة ، غيرة وحنقا من المسلمين لما كان من هدمهم للكناءس ، وان طاءفة النصاري تجمعوا واخرجوا من بينهم مالا جزيلا لعمل هذا النفط. واتفق وصول كريم الدين ناظر الخاص من الاسكندرية ، فعرفه السلطان ما وقع من القبض علي النصاري ، فقال : النصاري لهم بطرك يرجعون اليه ويعرف احوالهم ، فرسم السلطان بطلب البطرك عند كريم الدين ليتحدث معه في امر الحريق وما ذكره النصاري من قيامهم في ذلك ، فجاء في حماية والي القاهرة في الليل خوفا من العامة ، فلما ان دخل بيت كريم الدين بحارة الديلم واحضر اليه الثلاثة النصاري من عند الوالي ، قالوا لكريم الدين بحضرة البطرك والوالي جميع ما اعترفوا به قبل ذلك ، فبكي البطرك عند ما سمع كلامهم وقال : هءلاء سفهاء النصاري ، قصدوا مقابلة سفهاء المسلمين علي تخريبهم الكناءس ، وانصرف من عند كريم الدين مبجلا مكرما ، فوجد كريم الدين قد اقام له بغلة علي بابه ليركبها ، فركبها وسار ، فعظم ذلك علي الناس وقاموا عليه يدا واحدة ، فلو لا ان الوالي كان يسايره والا هلك ، واصبح كريم الدين يريد الركوب الي القلعة علي العادة ، فلما خرج الي الشارع صاحت به العامة ما يحل لك يا قاضي تحامي للنصاري وقد احرقوا بيوت المسلمين وتركبهم بعد هذا البغال ، فشق عليه ما سمع وعظمت نكايته ، واجتمع بالسلطان ، فاخذ يهون امر النصاري الممسوكين ويذكر انهم سفهاء وجهال ، فرسم السلطان للوالي بتشديد عقوبتهم ، فنزل وعاقبهم عقوبة مءلمة ، فاعترفوا بان اربعة عشر راهبا بدير البغل قد تحالفوا علي احراق ديار المسلمين كلها ، وفيهم راهب يصنع النفط ، وانهم اقتسموا القاهرة ومصر ، فجعل للقاهرة ثمانية ، ولمصر ستة ، فكبس دير البغل وقبض علي من فيه واحرق من جماعته اربعة بشارع صليبة جامع ابن طولون في يوم الجمعة ، وقد اجتمع لمشاهدتهم عالم عظيم ، فضري من حينءذ جمهور الناس علي النصاري وفتكوا بهم ، وصاروا يسلبون ما عليهم من الثياب حتي فحش الامر وتجاوزوا فيهم المقدار ، فغضب السلطان من ذلك وهم ان يوقع

 بالعامة ، واتفق انه ركب من القلعة يريد الميدان الكبير في يوم السبت ، فراي من الناس امما عظيمة قد ملات الطرقات وهم يصيحون نصر الله الاسلام ، انصر دين محمد بن عبد الله. فخرج من ذلك ، وعندما نزل الميدان احضر اليه الخازن نصرانيين قد قبض عليهما وهما يحرقان الدور ، فامر بتحريقهما ، فاخرجا وعمل لهما حفرة واحرقا بمراي من الناس ، وبينا هم في احراق النصرانيين اذا بديوان الامير بكتمر الساقي قد مر يريد بيت الامير بكتمر ، وكان نصرانيا ، فعندما عاينه العامة القوه عن دابته الي الارض وجردوه من جميع ما عليه من الثياب وحملوه ليلقوه في النار ، فصاح بالشهادتين واظهر الاسلام ، فاطلق.
 واتفق مع هذا مرور كريم الدين ، وقد لبس التشريف ، من الميدان ، فرجمه من هنالك رجما متتابعا وصاحوا به : كم تحامي للنصاري وتشد معهم ، ولعنوه وسبوه ، فلم يجد بدا من العود الي السلطان وهو بالميدان ، وقد اشتد ضجيج العامة وصياحهم حتي سمعهم السلطان ، فلما دخل عليه واعلمه الخبر امتلا غضبا واستشار الامراء ، وكان بحضرته منهم الامير جمال الدين ناءب الكرك ، والامير سيف الدين البوبكري ، والخطيري ، وبكتمر الحاجب في عدة اخري ، فقال الابوبكري : العامة عمي والمصلحة ان يخرج اليهم الحاجب ويسالهم عن اختيارهم حتي يعلم. فكره هذا من قوله السلطان ، واعرض عنه. فقال ناءب الكرك : كل هذا من اجل الكتاب النصاري ، فان الناس ابغضوهم ، والراي ان السلطان لا يعمل في العامة شيءا ، وانما يعزل النصاري من الديوان. فلم يعجبه هذا الراي ايضا ، وقال للامير الماس الحاجب : امض ومعك اربعة من الامراء وضع السيف في العامة من حين تخرج من باب الميدان الي ان تصل الي باب زويلة ، واضرب فيهم بالسيف من باب زويلة الي باب النصر ، بحيث لا ترفع السيف عن احد البتة. وقال لوالي القاهرة : اركب الي باب اللوق والي باب البحر ، ولا تدع احدا حتي تقبض عليه وتطلع به الي القلعة ، ومتي لم تحضر الذين رجموا وكيلي ، يعني كريم الدين ، والا وحياة راسي شنقتك عوضا عنهم ، وعين معه عدة من المماليك السلطانية ، فخرج الامراء بعد ما تلكءوا في المسير حتي اشتهر الخبر ، فلم يجدوا احدا من الناس حتي ولا غلمان الامراء وحواشيهم ، ووقع القول بذلك في القاهرة ، فغلقت الاسواق جميعها ، وحل بالناس امر لم يسمع باشد منه ، وسار الامراء فلم يجدوا في طول طريقهم احدا الي ان بلغوا باب النصر ، وقبض الوالي من باب اللوق وناحية بولاق وباب البحر كثيرا من الكلابزية والنواتية واسقاط الناس ، فاشتد الخوف وعدي كثير من الناس الي البر الغربي بالجيزة ، وخرج السلطان من الميدان فلم يجد في طريقه الي ان صعد قلعة الجبل احدا من العامة ، وعند ما استقر بالقلعة سير الي الوالي يستعجل حضوره ، فما غربت الشمس حتي احضر ممن امسك من العامة نحو ماءتي رجل ، فعزل منهم طاءفة امر بشنقهم ، وجماعة رسم بتوسيطهم ، وجماعة رسم بقطع ايديهم ، فصاحوا باجمعهم : يا خوند ما يحل لك ، ما نحن الذين رجمنا ، فبكي الامير بكتمر الساقي ومن

 حضر من الامراء رحمة لهم ، وما زالوا بالسلطان الي ان قال للوالي : اعزل منهم جماعة ، وانصب الخشب من باب زويلة الي تحت القلعة بسوق الخيل ، وعلق هءلاء بايديهم. فلما اصبح يوم الاحد علق الجميع من باب زويلة الي سوق الخيل ، وكان فيهم من له بزة وهيءة ، ومر الامراء بهم فتوجعوا لهم وبكوا عليهم ، ولم يفتح احد من ارباب الحوانيت بالقاهرة ومصر في هذا اليوم حانوتا ، وخرج كريم الدين من داره يريد القلعة علي العادة فلم يستطع المرور علي المصولبين ، وعدل عن طريق باب زويلة ، وجلس السلطان في الشباك وقد احضر بين يديه جماعة ممن قبض عليهم الوالي فقطع ايدي وارجل ثلاثة منهم والامراء لا يقدرون علي الكلام معه في امرهم لشدة حنقه ، فتقدم كريم الدين وكشف راسه وقبل الارض وهو يسال العفو ، فقبل سءاله وامر بهم ان يعملوا في حفير الجيزة ، فاخرجوا وقد مات ممن قطع ايديهم اثنان ، وانزل المعلقون من علي الخشب.
 وعند ما قام السلطان من الشباك وقع الصوت بالحريق في جهة جامع ابن طولون ، وفي قلعة الجبل ، وفي بيت الامير ركن الدين الاحمدي بحارة بهاء الدين ، وبالفندق خارج باب البحر من المقس وما فوقه من الربع ، وفي صبيحة يوم هذا الحريق قبض علي ثلاثة من النصاري وجد معهم فتاءل النفط ، فاحضروا الي السلطان واعترفوا بان الحريق كان منهم ، واستمر الحريق في الاماكن الي يوم السبت ، فلما ركب السلطان الي الميدان علي عادته ، وجد نحو عشرين الف نفس من العامة قد صبغوا خرقا بلون ازرق وعلموا فيها صلبانا بيضا ، وعند ما راوا السلطان صاحوا بصوت عال واحد لا دين الا دين الاسلام ، نصر الله دين محمد بن عبد الله ، يا ملك الناصر ، يا سلطان الاسلام انصرنا علي اهل الكفر ، ولا تنصر النصاري. فارتجت الدنيا من هول اصواتهم ، واوقع الله الرعب في قلب السلطان وقلوب الامراء ، وسار وهو في فكر زاءد حتي نزل بالميدان وصراخ العامة لا يبطل ، فراي ان الراي في استعمال المداراة ، وامر الحاجب ان يخرج وينادي بين يديه : من وجد نصرانيا فله ماله ودمه. فخرج ونادي بذلك ، فصاحت العامة وصرخت : نصرك الله. وضجوا بالدعاء ، وكان النصاري يلبسون العماءم البيض ، فنودي في القاهرة ومصر من وجد نصرانيا بعمامة بيضاء حل له دمه وماله ، ومن وجد نصرانيا راكبا حل له دمه وماله ، وخرج مرسوم بلبس النصاري العمامة الزرقاء ، وان لا يركب احد منهم فرسا ولا بغلا ، ومن ركب حمارا فليركبه مقلوبا ، ولا يدخل نصراني الحمام الا وفي عنقه جرس ، ولا يتزيا احد منهم بزي المسلمين ، ومنع الامراء من استخدام النصاري ، واخرجوا من ديوان السلطان. وكتب لساءر الاعمال بصرف جميع المباشرين من النصاري ، وكثر ايقاع المسلمين بالنصاري حتي تركوا السعي في الطرقات ، واسلم منهم جماعة كثيرة ، وكان اليهود قد سكت عنهم في هذه المدة ، فكان النصراني اذا اراد ان يخرج من منزله يستعير عمامة صفراء من احد من اليهود ويلبسها ، حتي يسلم من العامة ، واتفق ان بعض دواوين النصاري كان له عند يهودي مبلغ اربعة الاف درهم

 نقرة ، فصار الي بيت اليهودي وهو متنكر في الليل ليطالبه ، فامسكه اليهودي وقال : انا بالله وبالمسلمين ، وصاح. فاجتمع الناس لاخذ النصراني ، ففر الي داخل بيت اليهودي واستجار بامراته ، واشهد عليه بابراء اليهودي حتي خلص منه ، وعثر علي طاءفة من النصاري بدير الخندق يعملون النفط لاحراق الاماكن ، فقبض عليهم وسمروا ونودي في الناس بالامان ، وانهم يتفرجون علي عادتهم عند ركوب السلطان الي الميدان ، وذلك انهم كانوا قد تخوفوا علي انفسهم لكثرة ما اوقعوا بالنصاري ، وزادوا في الخروج عن الحد ، فاطمانوا وخرجوا علي العادة الي جهة الميدان ، ودعوا للسلطان ، وصاروا يقولون نصرك الله يا سلطان الارض ، اصطلحنا اصطلحنا ، واعجب السلطان ذلك وتبسم من قولهم ، وفي تلك الليلة وقع حريق في بيت الامير الماس الحاجب من القلعة ، وكان الريح شديدا ، فقويت النار وسرت الي بيت الامير ايتمش ، فانزعج اهل القلعة واهل القاهرة وحسبوا ان القلعة جميعها احترقت ، ولم يسمع باشنع من هذه الكاءنة ، فانه احترق علي يد النصاري بالقاهرة ربع في سوق الشوايين ، وزقاق العريسة بحارة الديلم ، وستة عشر بيتا بجوار بيت كريم الدين ، وعدة اماكن بحارة الروم ، ودار بهادر بجوار المشهد الحسيني ، واماكن باصطبل الطارمة وبدرب العسل ، وقصر امير سلاح ، وقصر سلار بخط بين القصرين ، وقصر بيسري ، وخان الحجر ، والجملون ، وقيسارية الادم ، ودار بيبرس بحارة الصالحية ، ودار ابن المغربي بحارة زويلة ، وعدة اماكن بخط بءر الوطاويط وبيشكر وفي قلعة الجبل وفي كثير من الجوامع والمساجد الي غير ذلك من الاماكن بمصر والقاهرة يطول عددها.
 وخرب من الكناءس كنيسة بخراءب التتر من قلعة الجبل ، وكنيسة الزهري في الموضع الذي فيه الان البركة الناصرية ، وكنيسة الحمراء ، وكنيسة بجوار السبع سقايات تعرف بكنيسة البنات ، وكنيسة ابي المنيا ، وكنيسة الفهادين بالقاهرة ، وكنيسة بحارة الروم ، وكنيسة بالبندقانيين ، وكنيستان بحارة زويلة ، وكنيسة بخزانة البنود ، وكنيسة بالخندق ، واربع كناءس بثغر الاسكندرية ، وكنيستان بمدينة دمنهور الوحش ، واربع كناءس بالغربية ، وثلاث كناءس بالشرقية ، وست كناءس بالبهنساوية ، وبسيوط ومنفلوط ومنية الخصيب ثمان كناءس ، وبقوص واسوان احدي عشرة كنيسة ، وبالاطفيحية كنيسة ، وبسوق وردان من مدينة مصر ، وبالمصاصة وقصر الشمع من مصر ثمان كناءس ، وخرب من الديارات شء كثير ، واقام دير البغل ودير شهران مدة ليس فيهما احد ، وكانت هذه الخطوب الجليلة في مدة يسيرة. قلما يقع مثلها في الازمان المتطاولة ، هلك فيها من الانفس وتلف فيها من الاموال وخرب من الاماكن ما لا يمكن وصفه لكثرته ، ولله عاقبة الامور.
 كنيسة ميكاءيل : هذه الكنيسة كانت عند خليج بني واءل خارج مدينة مصر قبلي عقبة يحصب ، وهي الان قريبة من جسر الافرم ، احدثت في الاسلام وهي مليحة البناء.

 كنيسة مريم : في بساتين الوزير قبلي بركة الحبش خالية ليس بها احد.
 كنيسة مريم : بناحية العدوية من قبليها قديمة وقد تلاشت.
 كنيسة انطونيوس : بناحية بياض قبلي اطفيح ، وهي محدثة. وكان بناحية شرنوب عدة كناءس خربت ، وبقي بناحية اهريت الجبل قبلي بياض بيومين. كنيسة السيدة : بناحية اشكر وعلي بابها برج مبني بلبن كبار يذكر انه موضع ولد موسي بن عمران عليه السلام .
 كنيسة مريم : بناحية الخصوص وهي بيت فعملوه كنيسة لا يعبا بها.
 كنيسة مريم وكنيسة بخنس القصير وكنيسة غبريال : هذه الكناءس الثلاث بناحية ابنوب.
 كنيسة اسبوطير ومعناه المخلص : هذه الكنيسة بمدينة اخميم ، وهي كنيسة معظمة عندهم ، وهي علي اسم الشهداء ، وفيها بءر اذا جعل ماءها في القنديل صار احمر قانيا كانه الدم.
 كنيسة ميكاءيل : بمدينة اخميم ايضا ، ومن عادة النصاري بهاتين الكنيستين اذا عملوا عيد الزيتونة المعروف بعيد الشعانين ان يخرج القسوس والشمامسة بالمجامر والبخور والصلبان والاناجيل والشموع المشتعلة ويقفوا علي باب القاضي ، ثم ابواب الاعيان من المسلمين ، فيبخروا ويقرءوا فصلا من الانجيل ، ويطرحوا له طرحا ، يعني يمدحونه.
 كنيسة بوبخوم : بناحية اتفه ، وهي اخر كناءس الجانب الشرقي ، وبخوم ويقال بخوميوس ، كان راهبا في زمن بوشنودة ، ويقال له ابو الشركة من اجل انه كان يربي الرهبان ، فيجعل لكل راهبين معلما ، وكان لا يمكن من دخول الخمر ولا اللحم الي ديره ، ويامر بالصوم الي اخر التاسعة من النهار ، ويطعم رهبانه الحمص المصلوق ، ويقال له عندهم حمص القلة ، وقد خرب ديره وبقيت كنيسته هذه باتفه قبلي اخميم.
 كنيسة مرقص الانجيلي : بالجيزة ، خربت بعد سنة ثمانماءة ثم عمرت. ومرقص هذا احد الحواريين ، وهو صاحب كرسي مصر والحبشة.
 كنيسة بوجرج : بناحية ابي النمرس من الجيزة ، هدمت في سنة ثمانين وسبعماءة ، كما تقدم ذكره ثم اعيدت بعد ذلك.
 كنيسة بوفار : اخر اعمال الجيزة.
 كنيسة شنودة : بناحية هربشت.
 كنيسة بوجرج : بناحية ببا ، وهي جليلة عندهم ياتونها بالنذور ويحلفون بها ، ويحكون لها فضاءل متعددة.

 كنيسة ماروطا القديس : بناحية شمسطا ، وهم يبالغون في ماروطا هذا ، وكان من عظماء رهبانهم ، وجسده في انبوبة بدير بوبشاء من برية شيهات ، يزورونه الي اليوم.
 كنيسة مريم بالبهناس : ويقال انه كان بالبهنسا ثلاثماءة وستون كنيسة خربت كلها ، ولم يبق بها الا هذه الكنيسة لا غير.
 كنيسة صمويل : الراهب بناحية شبري.
 كنيسة مريم : بناحية طنبدي وهي قديمة.
 كنيسة ميخاءيل : بناحية طنبدي وهي كبيرة قديمة ، وكان هناك كناءس كثيرة خربت ، واكثر اهل طنبدي نصاري اصحاب صناءع.
 كنيسة الايصطولي : اعني الرسل ، بناحية اشنين ، وهي كبيرة جدا.
 كنيسة مريم : بناحية اشنين ايضا وهي قديمة.
 كنيسة ميخاءيل و
 كنيسة غبريال : بناحية اشنين ايضا ، وكان بهذه الناحية ماءة وستون كنيسة خربت كلها الا هذه الكناءس الاربع ، واكثر اهل اشنين نصاري ، وعليهم الدرك في الخفارة ، وبظاهرها اثار كناءس يعملون فيها اعيادهم ، منها كنيسة بوجرج ، وكنيسة مريم ، وكنيسة ماروطا ، وكنيسة بربارة ، وكنيسة كفريل ، وهو جبريل عليه السلام .
 وفي منية ابن خصيب ست كناءس : كنيسة المعلقة وهي كنيسة السيدة ، وكنيسة بطرس وبولص ، وكنيسة ميكاءيل ، وكنيسة بوجرج ، وكنيسة انيابولا الطمويهي ، وكنيسة الثلاث فتية ، وهم حنانيا وعزاريا وميصاءيل ، وكانوا اجنادا في ايام بخت نصر فعبدوا الله تعالي خفية ، فلما عثروا عليهم راودهم بخت نصر ان يرجعوا الي عبادة الاصنام فامتنعوا من ذلك ، فسجنهم مدة ليرجعوا فلم يرجعوا ، فاخرجهم والقاهم في النار فلم تحرقهم ، والنصاري تعظمهم ، وان كانوا قبل المسيح بدهر.
 كنيسة بناحية طحا : علي اسم الحواريين الذين يقال لهم عندهم الرسل.
 كنيسة مريم : بناحية طحا ايضا.
 كنيسة الحكيمين : بناحية منهري ، لها عيد عظيم في بشنس يحضره الاسقف ، ويقام هناك سوق كبير في العيد ، وهذان الحيكمان هما قزمان ودميان الراهبان.
 كنيسة السيدة : بناحية بقرقاس قديمة كبيرة.
 وبناحية ملوي كنيسة كنيسة الرسل ، وكنيستان خراب ، احداهما علي اسم بوجرج ، والاخري علي اسم الملك ميخاءيل. وبناحية دلجة كناءس كثيرة لم يبق منها الا ثلاث

 كناءس : كنيسة السيدة ، وهي كبيرة. وكنيسة شنودة ، وكنيسة مرقورة ، وقد تلاشت كلها. وبناحية صنبو كنيسة انبابولا ، وكنيسة بوجرج ، وصنبو كثيرة النصاري. وبناحية ببلاو وهي بحري صنبو كنيسة قديمة بجانبها الغربي علي اسم جرجس ، وبها نصاري كثيرون فلاحون. وبناحيا دروط كنيسة وفي خارجها شبه الدير علي اسم الراهب ساراماتون ، وكان في زمان شنودة ، وعمل اسقفا ، وله اخبار كثيرة. وبناحية بوق بني زيد كنيسة كبيرة علي اسم الرسل ، ولها عيد. وبالقوصية كنيسة مريم ، وكنيسة غبريال ، وبناحية دمشير كنيسة الشهيد مرقوريوس ، وهي قديمة وبها عدة نصاري. وبناحية ام القصور كنيسة بوبخنس القصير وهي قديمة. وبناحية بلوط من ضواحي منفلوط كنيسة ميخاءيل وهي صغيرة. وبناحية البلاعزة من ضواحي منفلوط كنيسة صغيرة يقيم بها القسيس باولاده. وبناحية شقلقيل ثلاث كناءس كبار قديمة احداها علي اسم الرسل ، واخري باسم ميخاءيل ، واخري باسم بومنا. وبناحية منشاة النصاري كنيسة ميخاءيل. وبمدينة سيوط كنيسة بوسدرة وكنيسة الرسل ، وبخارجها كنيسة بومينا. وبناحية درنكة كنيسة قديمة جدا علي اسم الثلاثة فتية حنانيا وعزاريا وميصاءيل ، وهي مورد لفقراء النصاري ، ودرنكة اهلها من النصاري يعرفون اللغة القبطية ، فيتحدث صغيرهم وكبيرهم بها ، ويفسرونها بالعربية. وبناحية ريفة كنيسة بوقلتة الطبيب الراهب صاحب الاحوال العجيبة في مداواة الرمدي من الناس ، وله عيد يعمل بهذه الكنيسة. وبها كنيسة ميخاءيل ايضا ، وقد اكلت الارضة جانب ريفة الغربي. وبناحية موشة كنيسة مركبة علي حمام علي اسم الشهيد بقطر ، وبنيت في ايام قسطنطين ابن هيلانة ، ولها رصيف عرضه عشرة اذرع ، ولها ثلاث قباب ارتفاع كل منها نحو الثمانين ذراعا ، مبنية بالحجر الابيض كلها ، وقد سقط نصفها الغربي ، ويقال ان هذه الكنيسة علي كنز تحتها ، ويذكر انه كان من سيوط الي موشة هذه ممشاة تحت الارض.
 وبناحية بقور من ضواحي بوتيج كنيسة قديمة للشهيد اكلوديس ، وهو يعدل عندهم مرقوريوس ، وجاارجيوس ، وهو ابو جرج والاسفهسلارتا ادروس وميتاوس ، وكان اكلوديوس ابوه من قواد ديقلطيانوس ، وعرف هو بالشجاعة فتنصر ، فاخذه الملك وعذبه ليرجع الي عبادة الاصنام ، فثبت حتي قتل وله اخبار كثيرة.
 وبناحية القطيعة كنيسة علي اسم السيدة ، وكان بها اسقف يقال له الدوين ، بينه وبينهم منافرة فدفنوه حيا ، وهم من شرار النصاري معروفون بالشر ، وكان منهم نصراني يقال له جرجس ابن الراهبة ، تعدي طوره فضرب رقبته الامير جمال الدين يوسف الاستادار بالقاهرة في ايام الناصر فرج بن برقوق.
 وبناحية بوتيج كناءس كثيرة قد خربت ، وصار النصاري يصلون في بيت لهم سرا ، فاذا طلع النهار خرجوا الي اثار كنيسة وعملوا لها سياجا من جريد شبه القفص واقاموا هناك عباداتهم.

 وبناحية مقروفه كنيسة قديمة لميخاءيل ، ولها عيد في كل سنة ، واهل هذه الناحية نصاري ، اكثرهم رعاة غنم وهم همج رعاع.
 وبناحية دوينة كنيسة علي اسم بوبخنس القصير ، وهي قبة عظيمة وكان بها رجل يقال له يونس ، عمل اسقفا واشتهر بمعرفة علوم عديدة فتعصبوا عليه حسدا منهم له علي علمه ودفنوه حيا ، وقد توعك جسمه.
 وبالمراغة التي بين طهطا وطما كنيسة.
 وبناحية قلفا كنيسة كبيرة ، وتعرف نصاري هذه البلدة بمعرفة السحر ونحوه ، وكان بها في ايام الظاهر برقوق شماس يقال له ابصاطيس له في ذلك يد طولي ، ويحكي عنه ما لا احب حكايته لغرابته ، وبناحية فرشوط كنيسة ميخاءيل ، وكنيسة السيدة مارت مريم ، وبمدينة هو كنيسة السيدة وكنيسة بومنا. وبناحية بهجورة كنيسة الرسل. وباسنا كنيسة مريم وكنيسة ميخاءيل وكنيسة يوحنا المعمداني ، وهو يحيي بن زكريا عليهما السلام . وبنقادة كنيسة السيدة ، وكنيسة يوحنا المعمداني ، وكنيسة غبريال ، وكنيسة يوحنا الرحوم ، وهو من اهل انطاكية ذوي الاموال ، فزهد وفرق ماله كله في الفقراء وساح وهو علي دين النصرانية في البلاد ، فعمل ابواه عزاءه وظنوا انه قد مات ، ثم قدم انطاكية في حالة لا يعرف فيها ، واقام في كوخ علي مزبلة ، واقام رمقه بما يلقي علي تلك المزبلة حتي مات ، فلما عملت جنازته كان ممن حضرها ابوه ، فعرف غلاف انجيله ، ففحص عنه حتي عرف انه ابنه ، فدفنه وبني عليه كنيسة انطاكية. وبمدينة قفط كنيسة السيدة ، وكان باصفون عدة كناءس خربت بخرابها ، وبمدينة قوص عدة اديرة وعدة كناءس خربت بخرابها ، وبقي بها كنيسة السيدة ولم يبق بالوجه القبلي من الكناءس سوي ما تقدم ذكرنا له.

  ** واما الوجه البحري :
 ففي منية صرد من ضواحي القاهرة كنيسة السيدة مريم ، وهي جليلة عندهم. وبناحية سندوة كنيسة محدثة علي اسم بوجرج ، وبمر صفا كنيسة مستجدة علي اسم بوجرج ايضا ، وبسمنود كنيسة علي اسم الرسل عملت في بيت ، وبسنباط كنيسة جليلة عندهم علي اسم الرسل ، وبصندفة كنيسة معتبرة عندهم علي اسم بوجرج ، وبالريدانية كنيسة السيدة ولها قدر جليل عندهم ، وفي دمياط اربع كناءس للسيدة ولميخاءيل وليوحنا المعمداني ولماري جرجس ، ولها مجد عندهم. وبناحية سبك العبيد كنيسة محدثة في بيت مخفي علي اسم السيدة ، وبالنحراوية كنيسة محدثة في بيت مخفي ، وفي لقانة كنيسة بوبخنس القصير ، وبدمنهور كنيسة محدثة في بيت مخفي علي اسم ميخاءيل ، وبالاسكندرية المعلقة علي اسم السيدة وكنيسة بوجرج وكنيسة يوحنا المعمداني وكنيسة الرسل ، فهذه كناءس اليعاقبة بارض مصر ، ولهم بغزة كنيسة مريم ، ولهم بالقدس القمامة وكنيسة صهيون.

 واما الملكية فلهم بالقاهرة كنيسة ماري نقولا بالبندقانيين ، وبمصر كنيسة غبريال الملاك بخط قصر الشمع ، وبها قلاية لبطركهم ، وكنيسة السيدة بقصر الشمع ايضا ، وكنيسة الملاك ميخاءيل بجوار بربارة بمصر ، وكنيسة مار يوحنا بخط دير الطين ، والله اعلم.
 وهذا اخر الجزء الثاني وبتمامه تم الكتاب والحمد لله وحده وصلي الله علي من لا نبي بعده وسلم ورضي الله عن اصحاب رسول الله اجمعين وحسبنا الله ونعم الوكيل ، ولا عدوان الا علي الظالمين.
 قول المستعين بربه القوي ، محمد ابن المرحوم الشيخ عبد الرحمن قطة العدوي ، مصحح دار الطباعة المصرية ، بلغه الله من الخير كل امنية : ان من جملة المحاسن الممدوحة بكل لسان ، واحاسن الاثار الغني فضلها عن البيان ، التي ظهرت في ايام صاحب العز والاقبال ، من طبع علي المرحمة والعدالة في الاقوال والافعال ، واختص بحسن التبصر وسداد النظر ، ورعاية المصالح العامة لاهل البدو والحضر ، ووهب من صفات الكمال وكمال الصفات ، ما تقصر دون تعداده العبارات والاشارات ، من هو الفرقد الثاني ، في افق الصدارة العثماني ، عزيز الديار المصرية ، ذي المناقب الفاخرة السنية ، حضرة افندينا الحاج عباس باشا ، لا زال بصولة عدله جيش المظالم يتلاشي ، ولا برح قرير العين بانجاله ، محفوظ الجناب نافذ القول في حاله واستقباله ، ولا فتء لواء عزه منشورا ، ولا انفك سعيه مشكورا ، طبع كتاب الخطط للعلامة المقريزي الشهير ، المجمع علي فضله وعموم نفعه بلا نكير ، كيف لا وقد جمع من تخطيط الحكومة المصرية ، وما يتعلق بها من المواد الجغرافية والتاريخية ، وذكر اصناف اهلها وولاتها ، وما عرض لها من تقلبات الازمان وتغيراتها ، وما تضمنته من الاخلاق والعواءد ، الصحيح منها والفاسد ، وما توارد عليها من الدول والحكومات ، واختلاف الملل والديانات ، وغير ذلك من الفواءد ، وصحيح الادلة والشواهد ، وعجاءب الاخبار ، وغراءب الاثار ، ما يغني الحاذق اللبيب ، ويكفي الماهر الاريب ، ويعتبر به المعتبرون ، ويتفكه به المتامرون ، بل هو النديم الذي لا يمل ، والانيس الذي في استصحابه تهون الكراءم وتبذل ، بيد انه يتحفك من تاريخ مصر باظرف تحفه ، ويمنحك من طريف جغرافيتها وتليدها الطف طرقه ، ويسكنك من قصور انباءها علي غرفه ، وينشقك من زهر روض اخبارها شميمه وعرفه ، غير انه لما كان فن التاريخ مع جليل نفعه ، وجزيل فاءدته عند ارباب المعارف وعظيم وقعه ، قد رميت سوقه في هذه الازمان بالكساد ، وتقاصرت عنه الهمم من كل حاضر وباد ، كان هذا الكتاب مما خيمت عليه عناكب النسيان ، وعزت نسخه في ديارنا حتي كاد لا يعثر بها انسان ، فانها فيها قليلة محصورة ، متروكة الاستعمال مهجورة ، فكانت مع قلتها عارية عن صحتها ، فكم فيها من تحريف فاحش وسقط متفاحش ، وغلط مخل ، وخطا مضجر وممل ، ويفضي بالقاري الي الملل ، ويعوضه

 عن النشاط الكسل ، لكن بحمد الله وعونه ، وعظيم فضله ومنه ، وبذل المجهود في التصحيح ، واستفراغ الوسع في التحرير والتنقيح ، جاءت النسخة المطبوعة صحيحة حسب الامكان ، جديرة بان تحل محل القبول والاستحسان ، فان ما كان من عباراته بالتحريف سقيما ، ولم يفهم معني مستقيما ، اجلت فيه ذهني مع قصوره ، وكلفته التسلق علي قصوره ، فان فتح له باب الرشاد ، والهم المعني المراد ، حمدت ربي ، حيث نلت اربي ، وان كانت الاخري ، وكبا زند الفهم وما اوري ، نبهت علي وجه التوقف في الحاشية بالعبارة ، او رقمت فيها رقما هنديا ليكون الي التوقف اشارة ، وربما اشرت الي الصواب ، لكن علي سبيل الرجاء في الاستصواب ، وربما مر بك تعداد بعض اشياء يشم منها مخالفة العربية ، وتفصيل امور تاباه بحسب الظاهر القواعد النحوية ، وعذرنا في ذلك ، ان المءلف تقلها كذلك ، عمن نقلها عن جريدة حساب ، واثبتها علي ما هي عليه في تقييدات الكتاب ، فابقيناها علي حالها ، ولم ننسجها علي غير منوالها ، حرصا علي عدم التغيير في عبارات المءلفين ، حسبما نص عليه اءمة الدين ، لا سيما والمعني معه ظاهر ، لا يخفي علي السامع والناظر ، ثم انه لبعض الاسباب ، فاتني تصحيح نحو اثنتين وعشرين ملزمة من اول الجزء الاول ، ومثلها من اول الثاني من هذا الكتاب ، لكن ان شاء الله تعالي يحصل الاطلاع عليها ، والنظر بعين التامل اليها ، فان عثر فيها علي ما يلزم التنبيه عليه ، والاشارة اليه ، نبهت عليه واثبت ما يخص كل جزء بلصقه ، ليكون كل منهما مستوفيا لحقه ، هذا وكاني بمتشقشق متشدق ، يعجل ببذاءة اللسان ولا يحقق ، قد استولي عليه الحسد فاعمي بصيرته ، ورفع بالذم والتشنيع عقيرته ، قاءلا ما لا يليق الا به ، مذيعا ما هو اولي به ، وما دري الجهول ان فن التصحيح خطر دقيق ، وصاحبه بضد ما تبجح به جدير حقيق ، ولو ذاق لعرف ، وبالعجز اقر واعترف ، وبالجملة فذمه يشهد لي بالكمال ، اخذا بقول من قول :
 واذا اتتك مذمتي من ناقص ~ فهي الشهادة لي باني كامل
 علي اني والله معترف بقلة البضاعة ، وعدم الاهلية لهذه الصناعة ، ولكنما هي اقامات ، وانما الاعمال بالنيات.
 وافوض امري الي اللطيف الخبير ، فانه نعم المولي ونعم النصير ، وكان طبع هذا الكتاب بدار الطباعة المصرية ، المنشاة ببولاق القاهرة المعزية ، لا زالت بانفاس الحضرة الاصفية ، منبعا لنشر الكتب النافعة العلمية ، تحت ملاحظة صاحب نظارتها ، القاءم بتدبيرها وادارتها ، رب القلم الذي لا يباري ، والانشاء الذي لا يجاري ، من احرز قصب السبق في ميدان البراعة ، وانقاد له كل معني ابي واطاعه ، حضرة علي افندي جودة ، بلغه الله في الدارين ماموله وقصده ، وكان طبعه علي ذمة ملتزمة ، المتسبب بعد الطي في نشر علمه ، واشتهاره في الاقطار ، واستعماله عند اهل القري والامصار ، الباذل في ذلك نفاءس الكراءم ،

 المستصغر في استحصاله الصعاءب والعظاءم ، المستنصر بمولاه في حالتي الضعف والايد الخواجة رفاءيل عبيد ، وقد وافق تاريخ تمامه ، وانتهاء الطبع الي حد ختامه ، يوم الاثنين التاسع عشر ، من شهر اليمن والخير صفر ، الذي هو من شهور سنة الف وماءتين وسبعين ، من هجرة سيد النبيين والمرسلين صلي الله وسلم عليه وعليهم اجمعين ، وعلي كل الصحابة والتابعين ، ورزقنا بجاههم الاعتصام بحبله علي الدوام ، ومنحنا التوفيق لما يرضيه ، والفوز بحسن الختام. امين.

