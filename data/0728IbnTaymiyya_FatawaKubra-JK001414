لا يكون زانيا . الخامس : ان تحريم الزنا قد علمه المسلمون بايات نزلت بمكة ، وتحريمه اشهر من ان تنزل هذه الاية بتحريمه . السادس : قال : @QB@ لا ينكحها الا زان او مشرك @QE@ النو الجواب  ] فلو اريد الوطء لم يكن  حاجة الي ذكر لمشرك فانه زان ، وكذلك المشركة اذا زني بها رجل فهي زانية فلا حاجة الي التقسيم . السابع : انه قد قال قبل ذلك : @QB@ الزانية والزاني فاجلدوا كل واحد منهما ماءة جلدة @QE@ النو الجواب  ] فاي حاجة الي ان يذكر تحريم الزنا بعد ذلك ، واما النسخ فقال سعيد بن المسيب وطاءفة : نسخها قوله : @QB@ وانكحوا الايامي منكم @QE@ النو الجواب  ] ، ولما علم اهل هذا القول ان دعوي النسخ بهذه الاية ضعيف جدا ، ولم يجدوا ما ينسخها فاعتقدوا انه لم يقل بها احد قالوا : هي منسوخة بالاجماع ، كما زعم ذلك ابو علي الجباءي وغيره . اما علي قول من يري من هءلاء ان الاجماع ينسخ النصوص كما يذكر ذلك عن عيسي بن ابان وغيره ، وهو قول في غاية الفساد مضمونة ان الامة يجوز لها تبديل دينها بعد نبيها ، وان ذلك جاءز لهم ، كما يقول النصاري : ابيح لعلماءهم ان ينسخوا من شريعة المسيح ما يرونه ، وليس هذا من اقوال المسلمين ، وممن يظن الاجماع من يقول : الاجماع دل علي نص ناسخ لم يبلغنا ، ولا حديث اجماع في خلاف هذه الاية ، وكل من عارض نصا باجماع وادعي نسخه من غير نص يعارض ذلك النص فانه مخطء في ذلك ، كما قد بسط الكلام علي هذا في موضع اخر ، وبين ان النصوص لم ينسخ منها شء الا بنص باق محفوظ عند الامة ، وعلمها بالناسخ الذي العمل به اهم عندها من علمها بالمنسوخ الذي لا يجوز العمل به ، وحفظ الله النصوص الناسخة اولي من حفظه المنسوخة ، وقول من قال : هي منسوخة بقوله : @QB@ وانكحوا الايامي منكم @QE@ النو الجواب  ] في غاية الضعف فان كونها زانية وصف عارض لها ، ويوجب تحريما عارضا : مثل كونها محرمة ، ومعتدة ، ومنكوحة للغير ، ونحو ذلك مما يوجب التحريم الي غاية ، ولو قدر انها محرمة علي التابيد لكانت كالوثنية ، ومعلوم ان هذه الاية لم تتعرض للصفات التي بها تحرم المراة مطلقا او مءقتا ، وانما امر بانكاح الايامي من حيث الجملة ، وهو امر بانكاحهن بالشروط التي بينها وكما انها لا تنكح في  العدة والاحرام لا تنكح حتي تتوب ، وقد احتجوا بالحديث الذي فيه : ان امراتي لا ترد يد لامس فقال : طلقها فقال : اني احبها . قال : فاستمتع بها . الحديث . رواه النساءي ، وقد ضعفه احمد وغيره فلا تقوم به حجة في معارضة الكتاب والسنة ، ولو صح لم يكن صريحا فان من الناس من يءول اللامس بطالب المال ، لكنه ضعيف . لكن لفظ اللامس قد يراد من مسها بيده ، وان لم يطاها فان من النساء من يكون فيها تبرج ، واذا نظر اليها رجل او وضع يده عليها لم تنفر عنه ، ولا تمكنه من وطءها ، ومثل هذه نكاحها مكروه ، ولهذا امره بفراقها ، ولم يوجب ذلك عليه ، لما ذكر انه يحبها فان هذه لم تزن ، ولكنها مذنبة ببعض المقدمات ، ولهذا قال : لا ترد يد لامس فجعل اللمس باليد فقط ، ولفظ اللمس والملامسة اذا عني بهما الجماع لا يحص باليد بل اذا قرن باليد فهو كقوله تعالي : @QB@ ولو نزلنا عليك كتابا في قرطاس فلمسوه بايديهم @QE@ الانعام :  ] . وايضا فالتي تزني بعد النكاح ليست كالتي تتزوج وهي زانية فان دوام النكاح اقوي من ابتداءه ، والاحرام والعدة تمنع الابتداء دون الدوام فلو قدر انه قام دليل شرعي علي ان الزانية بعد العقد لا يجب فراقها ، لكان الزنا كالعدة تمنع الابتداء دون الدوام جمعا بين الدليلين فان قيل : ما معني قوله : @QB@ لا ينكحها الا زان او مشرك @QE@ النو الجواب  ] قيل : المتزوج بها ان كان مسلما فهو زان ، وان لم يكن مسلما فهو كافر فان كان مءمنا بما جاء به الرسول من تحريم هذا وفعله فهو زان ، وان لم يكن مءمنا بما جاء به الرسول فهو مشرك ، كما كانوا عليه في الجاهلية ، كانوا يتزوجون البغايا ، يقول : فان تزوجتم بهن كما كنتم تفعلون من غير اعتقاد تحريم ذلك فانتم مشركون ، وان اعتقدتم التحريم فانتم زناة لان هذه تمكن من نفسها غير الزوج من وطءها فيبقي الزوج يطءها كما يطءها اولءك . وكل امراة اشترك في وطءها رجلان فهي زانية فان الفروج لا تحتمل  الاشتراك بل لا تكون الزوجة الا محصنة ، ولهذا لما كان المتزوج بالزانية زانيا كان مذموما عند الناس ، وهو مذموم اعظم مما يذم الذي يزني بنساء الناس ، ولهذا يقول في الشتمة : سبه بالزاي والقاف . اي : قال : يا زوج القحبة فهذا اعظم ما يتشاتم به الناس ، لما قد استقر عند المسلمين من قبح ذلك فكيف يكون مباحا ولهذا كان قذف المراة طعنا في زوجها فلو كان يجوز له التزويج ببغي لم يكن ذلك طعنا في الزوج ، ولهذا قال من قال من السلف : ما بغت امراة نبي قط ف الله تعالي اباح للانبياء ان يتزوجوا كافرة ، ولم يبح تزوج البغي لان هذه تفسد مقصود النكاح ، بخلاف الكافرة ، ولهذا اباح الله للرجل ان يلاعن مكان اربعة شهداء اذا زنت امراته واسقط عنه الحد بلعانه ، لما في ذلك من الضرر عليه . وفي الحديث : لا يدخل الجنة ديوث ، والذي يتزوج ببغي هو ديوث ، وهذا مما فطر الله علي ذمه وعيبه بذلك جميع عباده المءمنين بل وغير المسلمين من اهل الكتاب وغيرهم ، كلهم يذم من تكون امراته بغيا ، ويشتم بذلك ، ويعير به فكيف ينسب الي شرع الاسلام اباحة ذلك ، وهذا لا يجوز ان ياتي به نبي من الانبياء فضلا عن افضل الشراءع بل يجب ان تنزه الشريعة عن مثل هذا القول الذي اذا تصوره المءمن ولوازمه استعظم ان يضاف مثل هذا الي الشريعة ، وراي ان تنزيهها عنه اعظم من تنزيه عاءشة عما قاله اهل الافك . وقد امر الله المءمنين ان يقولوا : @QB@ سبحانك هذا بهتان عظيم @QE@ النو الجواب  ] والنبي صلي الله عليه وسلم انما لم يفارق عاءشة لانه لم يصدق ما قيل اولا ، ولما حصل له الشك استشار عليا ، وزيد بن حارثة ، وسال الجارية ، لينظر ان كان حقا فارقها حتي انزل الله براءتها من السماء فذلك الذي ثبت نكاحها ، ولم يقل مسلم : انه يجوز امساك بغي ، وكان المنافقون يقصدون بالكلام فيها الطعن في الرسول ، ولو جاز التزوج ببغي لقال : هذا لا حرج علي فيه ، كما كان النساء احيانا يءذينه حتي يهجرهن فليس ذنوب المراة طعنا ، بخلاف بغاءها فانه طعن فيه عند الناس قاطبة . ليس احد يدفع الذم عمن تزوج بمن يعلم انها بغية مقيمة علي البغاء ، ولهذا  توسل المنافقون الي الطعن حتي انزل الله براءتها من السماء ، وقد كان سعد بن معاذ لما قال النبي صلي الله عليه وسلم : من يعذرني من رجل بلغني اذاه في اهلي و الله ما علمت علي اهلي الا خيرا ، ولقد ذكروا رجلا ما علمت عليه الا خيرا ، فقام : سعد بن معاذ  الذي اهتز لموته عرش الرحمن  فقال : انا اعذرك منه : ان كان من اخواننا من الاوس ضربت عنقه ، وان كان من اخواننا الخزرج امرتنا ففعلنا فيه امرك فاخذت سعد بن عبادة غيرة ، قالت عاءشة : وكان قبل ذلك امرا صالحا ، ولكن اخذته حمية لان ابن ابي كان كبير قومه ، فقال ] : كذبت لعمر الله لا تقتله ، ولا تقدر علي قتله فقام اسيد بن حضير فقال : كذبت لعمر الله لنقتلنه فانك منافق تجادل عن المنافقين ، وثار الحيان حتي نزل رسول الله صلي الله عليه وسلم فجعل يسكنهم . فلولا ان ما قيل في عاءشة طعن في النبي صلي الله عليه وسلم لم يطلب المءمنون قتل من تكلم بذلك من الاوس والخزرج لقذفه لامراته ، ولهذا كان من قذف ام النبي صلي الله عليه وسلم يقتل لانه قدح في نسبه ، وكذلك من قذف نساءه يقتل ، لانه قدح في دينه ، وانما لم يقتلهم النبي صلي الله عليه وسلم لانهم تكلموا بذلك قبل ان يعلم براءتها ، وانها من امهات المءمنين اللاتي لم يفارقهن عليه . . . اذا كان يمكن ان يطلقها فتخرج بذلك من هذه الامومة في اظهر قولي العلماء فان فيمن طلقها النبي صلي الله عليه وسلم ثلاثة اقوال في مذهب احمد وغيره . احدها : انها ليست من امهات المءمنين . والثاني : انها من امهات المءمنين . والثالث : يفرق بين المدخول بها وغير المدخول بها . الاول اصح لان النبي صلي الله عليه وسلم لما خير نساءه بين الامساك والفراق ، وكان المقصود لمن فارقها ان يتزوجها غيره فلو كان هذا مباحا لم يكن ذلك قدحا في دينه ، وبالجملة فهذه المسالة في قلوب المءمنين اعظم من ان تحتاج الي كثرة الادلة  فان الايمان والقران يحرم مثل ذلك ، لكن لما كان قد اباح مثل ذلك كثير من علماء المسلمين الذين لا ريب في علمهم ودينهم من التابعين ومن بعدهم وعلو قدرهم بنوع تاويل تاولوه احتيج الي البسط في ذلك ، ولهذا نظاءر كثيرة : يكون القول ضعيفا جدا ، وقد اشتبه امره علي كثير من اهل العلم والايمان وسادات الناس لان الله لم يجعل العصمة عند تنازع المسلمين الا في الرد الي الكتاب والسنة ، وكل احد يءخذ من قوله ويترك الا رسول الله صلي الله عليه وسلم الذي لا ينطق علي الهوي فان قيل : فقد قال : @QB@ الزاني لا ينكح الا زانية او مشركة @QE@ النو الجواب  ] قيل : هذا يدل علي ان الزاني الذي لم يتب لا يجوز ان يتزوج عفيفة ، كما هو احدي الروايتين عن احمد فانه اذا كان يطا هذه وهذه وهذه كما كان كان وطءه لهذه من جنس وطءه لغيرها من الزواني ، وقد قال الشعبي : من زوج كريمته من فاجر فقد قطع رحمها ، وايضا فانه اذا كان يزني بنساء الناس كان هذا مما يدعو المراة الي ان تمكن منها غيره ، كما هو الواقع كثيرا فلم ار من يزني بنساء الناس او ذكر ، ان الا فيحمل امراته علي ان تزني بغيره مقابلة علي ذلك ومغايظة . وايضا فاذا كان عادته الزنا استغني بالبغايا فلم يكف امراته في الاعفاف فتحتاج الي الزنا ، وايضا فاذا زني بنساء الناس طلب الناس ان يزنوا بنساءه ، كما هو الواقع فامراة الزاني تصير زانية من وجوه كثيرة ، وان استحلت ما حرمه الله كانت مشركة ، وان لم تزن بفرجها زنت بعينها وغير ذلك فلا يكاد يعرف في نساء الرجال الزناة المصرين علي الزنا الذين لم يتوبوا منه امراة سليمة سلامة تامة ، وطبع المراة يدعو الي الرجال الاجانب اذا رات زوجها يذهب الي النساء الاجانب ، وقد جاء في الحديث : بروا اباءكم تبركم ابناءكم ، وعفوا تعف نساءكم فقوله : @QB@ الزاني لا ينكح الا زانية @QE@ النو الجواب  ] اما ان يراد ان نفس نكاحه ووطءه لها زنا ، او ان ذلك يفضي الي زناها ، واما الزانية فنفس وطءها مع اصرارها علي  الزنا زنا ، وكذلك @QB@ المحصنات من المءمنات @QE@ النساء :  ] الحراءر ، وعن ابن عباس : هن العفاءف فقد نقل عن ابن عباس تفسير @QB@ المحصنات @QE@ النساء :  ] بالحراءر ، وبالعفاءف ، وهذا حق . فنقول مما يدل علي ذلك قوله تعالي : ^ يسالونك ماذا احل لهم قل احل لكم الطيبات ، اليوم احل لكم الطيبات وطعام الذين اوتوا الكتاب حل لكم وطعامكم حل لهم والمحصنات من المءمنات والمحصنات من الذين اوتوا الكتاب من قبلكم اذا اتيتموهن اجورهن محصنين غير مسافحين ^ النساء :  ] . المحصنات قد قال اهل التفسي الجواب هن العفاءف . هكذا قال الشعبي ، والحسن والنخعي والضحاك ، والسدي ، وعن ابن عباس : هن الحراءر ، ولفظ المحصنات ان اريد به الحراءر فالعفة داخلة في الاحصان بطريق الاولي فان اصل المحصنة هي العفيفة التي احصن فرجها ، قال الله تعالي : @QB@ ومريم ابنة عمران التي احصنت فرجها @QE@ التحريم :  ] ، وقال تعالي : @QB@ ان الذين يرمون المحصنات الغافلات المءمنات @QE@ النو الجواب  ] وهن العفاءف ، قال حسان بن ثابت : حصان رزان ما تزن بريبة وتصبح غرثي من لحوم الغوافل ثم عادة العرب ان الحرة عندهم لا تعرف الزنا ، وانما تعرف بالزنا الاماء ، ولهذا لما بايع النبي صلي الله عليه وسلم هند امراة ابي سفيان علي الا تزني قالت : او تزني الحرة فهذا لم يكن معروفا عندهم ، والحرة خلاف الامة صارت في عرف العامة ان الحرة هي العفيفة لان الحرة التي ليست امة كانت معروفة عندهم بالعفة ، وصار لفظ الاحصان يتناول الحرية مع العفة لان الاماء لم تكن عفاءف ، وكذلك الاسلام هو ينهي عن الفحشاء والمنكر وكذلك المراة المتزوجة زوجها يحصنها ، لانها تستكفي به ، ولانه يغار عليها فصار لفظ الاحصان يتناول : الاسلام ، والحرية ، والنكاح ، واصله انما هو العفة فان العفيفة هي التي احصن فرجها من غير صاحبها ، كالمحصن الذي يمتنع من غير اهله ، واذا كان الله انما ابا