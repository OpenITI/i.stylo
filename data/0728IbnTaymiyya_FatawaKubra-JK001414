 ما يخلقه فيسمعه البشر ، وحينءذ فيكون كلاهما من وراء حجاب فلايكون الله مكلما للملاءكة قط الا من وراء حجاب . وقوله : @QB@ من وراء حجاب @QE@ الشوري :  ] ، دليل علي انه قد يكلم من شاء بلا حجاب ، كما استفاضت بذلك السنن عن النبي صلي الله عليه وسلم فلما ابتدعت الجهمية هذه المقالات ، انكر ذلك سلف الامة واءمتها من بقايا التابعين واتباعهم وصاروا يظهرون اعظم المقالات شبهة كقولهم : القران مخلوق لانهم يشبهون بهذا علي العامة ما لا يشبهونه بغيرهم ، اذ يقول القاءل كل ما سوي الله مخلوق ، ولان نقيض هذا اللفظ ليس مشهورا كشهرة احاديث الرءية والعرش وغير ذلك ، ومع هذا فكان انكار السلف والاءمة لذلك من اعظم الانكار دع ما هو اظهر فسادا ،  قال الامام الحافظ ابو القاسم اللالكاءي ، وقد ذكر اقوال السلف والاءمة بان القران كلام الله غير مخلوق ، وما ورد عنهم من تكفير من يقول ذلك ، ثم قال : فهءلاء خمسماءة وخمسون نفسا واكثر من التابعين ، واتباع التابعين والاءمة المرضيين سوي الصحابة الخبيرين علي اختلاف الاعصار ومضي السنين والاعوام وفيهم نحو ماءة امام ممن اخذ الناس بقولهم وتدينوا بمذاهبهم ، قال : ولو اشتغلت بنقل قول المحدثين لبلغت اسماءهم الوفا كثيرة ، لكن اختصرت فنقلت عن هءلاء عصرا بعد عصر ، لا ينكر عليهم منكر ، ومن انكر قولهم استتابوه وامروا بقتله او نفيه او صلبه ، قال : ولا خلاف بين الامة ان اول من قال : القران مخلوق الجعد بن درهم في سني نيف وعشرين ثم الجهم ابن صفوان ، فاما جعد فقتله خالد بن عبد الله القسري ، واما جهم فقتل بمرو في خلافة هشام بن عبد الملك وساذكر قصتهما ان شاء الله . ومع هذا فقد حفظ عن اءمة الصحابة كعلي وابن مسعود وابن عباس هذا القول . ( فصل ) ومع هذا فقد حفظ عن اءمة الصحابة كعلي وابن مسعود وابن عباس هذا القول ، وفي ذلك حجة علي من يزعم ان اقوال هءلاء الاءمة بدون الصحابة ليس بحجة فروي اللالكاءي من طريقين ، من طريق محمد بن المصفي ، ومن طريق الفضل بن عبد الله الفارسي ، كلاهما عن عمرو بن جميع ابي المنذر ، عن ميمون بن مهران ، عن ابن عباس ، قال : لما حكم علي الحكمين ، قالت له الخوارج : حكمت رجلين قال ، ما حكمت مخلوقا انما حكمت القران ، ورواه عبد الرحمن بن ابي حاتم باسناد اخر الي علي ، وقال : حدثنا محمد بن حجاج الحضرمي المصري : حدثنا يعلي بن عبد العزيز ، حدثنا عتبة بن السكن الفزاري : حدثنا الفرج بن يزيد الكلاعي ، قال : قالوا لعلي يوم صفين حكمت كافرا او منافقا قال : ما حكمت مخلوقا ، ما حكمت الا القران ، وهذا السياق يبطل تاويل من يفسر كلام السلف ، بان المخلوق هو المفتري المكذوب ، والقران غير مفتر ولا مكذوب ، فانهم لما قالوا : حكمت مخلوقا ، انما ارادوا مربوبا مصنوعا خلقه الله ، لم يريدوا مكذوبا فقوله : ما حكمت مخلوقا ، نفي لما ادعوه ،  وقوله : ما حكمت الا القران ، نفي لهذا الخلق عنه ، وقد روي ذلك عن علي من طريق ثالث ، واما قول ابن مسعود ، فمن المحفوظ الثابت عنه ، الذي رواه الناس من وجوه كثيرة صحيحة ، من حديث يحيي بن سعيد القطان وغيره ، عن سفيان الثوري ، عن الاعمش ، عن عبد الله بن مرة ، عن ابي كنف ، قال : قال عبدالله : من حلف بالقران فعليه بكل اية يمين ، قال : فذكرت ذلك لابراهيم قال فقال عبدالله : من حلف بالقران فعليه بكل اية يمين ، ومن كفر بحرف منه فقد كفر به اجمع ، وروي محمد بن هارون الروياني : حدثنا ابو الربيع : حدثنا ابو عوانة ، عن ابي سنان عن عبد الله بن ابي الهذيل ، عن حنظلة بن خويلد العنزي ، قال : اخذ عبد الله بيدي ، فلما اشرفنا علي السد اذ نطر الي السوق ، قال : اللهم اني اسالك خيرها وخير اهلها ، واعوذ بك من شرها وشر اهلها ، قال : فمر برجل يحلف بسورة من القران واية ، قال : فغمزني عبد الله بيدي ، ثم قال : اتراه مكفرا اما ان كل اية فيها يمين ، ولا نزاع بين الامة ان المخلوقات لا يجب في الحلف بها يمين ، كالكعبة وغيرها ، الا ما نازع فيه بعضهم من الحلف برسول الله صلي الله عليه وسلم لكون الايمان به احد ركني الايمان ، وقوله : عليه كل اية يمين ، قد اتبعه الاءمة وعملوا به كالامام احمد واسحق وغيرهما ، لكن هل تتداخل الايمان اذا كان المحلوف عليه واحدا كما لو حلف ب الله لا يفعل ، ثم حلف ب الله لايفعل ، هذا فيه قولان للعلماء ، هما روايتان عن احمد . واما قول ابن عباس ، فقال الامام عبد الرحمن بن ابي حاتم : حدثنا ابي : حدثنا ابن صالح بن جابر الانماطي : حدثنا علي بن عاصم ، عن عمران بن حدير ، عن عكرمة قال : كان ابن عباس في جنازة ، فلما وضع الميت في لحده ، قام رجل فقال : اللهم رب القران اغفر له فوثب اليه ابن عباس ، فقال مه القران منه ، زاد الصهيبي في حديثه ، فقال ابن عباس : القران كلام الله وليس بمربوب ، منه خرج واليه يعود فلما ابتدعت الجهمية هذه المقالات في اثناء  الماءة الثانية ، انكر ذلك سلف الامة واءمتها ، ثم استفحل امرهم في اواءل الماءة الثالثة بسبب من ادخلوه في شركهم وفريتهم من ولاة الامور ، وجرت المحنة المشهورة ، وكان اءمة الهدي علي ما جاءت به الرسل عن الله ، من ان القران كلام الله تكلم به هو سبحانه ، وهو منه وقاءم به ، وما كان كذلك لم يكن مخلوقا ، انما المخلوق ما يخلقه من الاعيان المحدثة وصفاتها ، وكثير منهم يرد قول الجهمية باطلاق القول بان القران كلام الله ، لان حقيقة قولهم : انه ليس كلامه ، ولا تكلم ولا يتكلم به ولا بغيره ، فان المستقر في فطر الناس وعقولهم ولغاتهم ، ان المتكلم بالكلام ، لا بد ان يقوم به الكلام فلا يكون متكلما بشء لم يقم به بل هو قاءم بغيره كما لا يكون عالما بعلم قاءما بغيره ، ولا حيا بحياة قاءمة بغيره ولا مريدا بارادة قاءمة بغيره ولا محبا ومبغضا ولا راضيا وساخطا بحب وبغض ورضي وسخط قاءم بغيره ، ولا متالما ولا متنعما وفرحا وضاحكا يتالم وتنعم وفرح وضحك قاءم بغيره فكل ذلك عند الناس من العلوم الضرورية البديهية الفطرية التي لا ينازعهم فيها الا من احيلت فطرته . وكذلك عندهم لا يكون امرا وناهيا بامر ونهي لا يقوم به ، بل يقوم بغيره ولا يكون مخبرا ومحدثا ومنبا بخبر ، وحديث ونبا لا يقوم به بل بغيره ، ولا يكون حامدا او ذاما ومادحا ومثنيا بحمد وذم ومدح وثناء لا يقوم به بل بغيره ، ولايكون مناجيا ومناديا وداعيا بنجاء ودعاء ونداء لا يقوم به ، بل لا يقوم الا بغيره ، ولا يكون واعدا وموعدا بوعد ووعيد لا يقوم به بل لا يقوم الا بغيره ، ولا يكون مصدقا ومكذبا بتصديق وتكذيب لا يقوم به ، بل لا يقوم الا بغيره ، ولا يكون حالفا ومقسما موليا بحلف وقسم ويمين لا يقوم به ولا يقوم الا بغيره ، بل من اظهر العلوم الفطرية الضرورية التي علمها بنو ادم ، وجوب قيام هذه الامور بالموصوف بها ، وامتناع انها لا تقوم الا بغيره فمن قال : ان الحمد والثناء ، والامر والنهي ، والنبا والخبر ، والوعد والوعيد ، والحلف واليمين ، والمناداة والمناجاة ، وساءر ما يسمي ويوصف به انواع الكلام ، يمتنع ان تكون قاءمة بالامر الناهي المناجي المنادي المنبء المخبر الواعد المتوعد الحامد المثني  الذي هو الله تعالي ، ويجب ان تكون قاءمة بغيره ، فقد خالف الفطرة الضرورية المتفق عليها بين الادميين ، وبدل لغات الخلق اجمعين ، ثم مع مخالفته للمعقولات واللغات فقد كذب المرسلين اجمعين ، ونسبهم الي غاية التدليس والتلبيس علي المخاطبين لان الرسل اجمعين اخبروا ان الله امر ونهي ، وقال ويقول ، وقد علم بالاضطرار ان مقصودهم ان الله هو نفسه الذي امر ونهي ، وقال : لا ، ان ذلك شء لم يقم به ، بل خلقه في غيره ، ثم لو كان مقصودهم ذلك ، فمعلوم ان هذا ليس هو المعروف من الخطاب ، ولا المفهوم منه ، لا عند الخاصة ولا عند العامة : بل المعروف المعلوم ان يكون الكلام قاءما بالمتكلم فلو ارادوا بكلامه وقوله : انه خلق في بعض المخلوقات كلاما ، لكانوا قد اضلوا الخلق علي زعم الجهمية ولبسوا عليهم غاية التلبيس ، وارادوا باللفظ ما لم يدلوا الخلق عليه ، و الله تعالي قد اخبر ان الرسل بلغت البلاغ المبين فمن نسبهم الي هذا فقد كفر ب الله ورسوله . وهذا قول الزنادقة المنافقين ، الذين هم اصل الجهمية الذين يصفون الرسل بذلك من المتفلسفة والقرامطة ونحوهم ، بل كون المتكلم الامر الناهي لا يوصف بذلك الا لقيام الكلام بغيره مع امتناع قيامه به امر لا يعرف في اللغة لا حقيقة ولا مجازا . وزعمت الجهمية الملحدة في اسماء الله واياته المحرفة للكلم عن مواضعه المبدلة لدين الله من المعتزلة ونحوهم ان المتكلم في اللغة من فعل الكلام ، وان كان قاءما بغيره ، كالجني المتكلم علي لسان الانسي المصروع فانه هو المتكلم بما يسمع من المصروع لانه فعل ذلك ، وان كان الكلام لم يقع الا بالانسي دون الجني ، وهذا من التمويه والتدليس ، فاما قولهم المتكلم من فعل الكلام فقد نازعهم فيه طاءفة من الصفاتية وقالوا : بل المتكلم من قام به الكلام ، وان لم يفعله كما يقوله الكلابية والاشعرية وبين الفريقين في ذلك نزاع طويل . واما السلف والاءمة واكثر الناس فلم ينازعوهم هذا النزاع ، بل قالوا : الكلام وان قيل : انه فعل للمتكلم فلا بد ان يكون قاءما به ، فلا يكون الكلام لازما لمتكلم يمتنع ان يقوم به الكلام ، وجميع المسموع من اللغات والمعلوم في  فطرة البريات يوافق ذلك ، واما تكلم الجني علي لسان الانسي فلا بد ان يقوم بالجني كلام ، ولكن تحريكه مع ذلك لجوارح الانسي يشبه تحريك روح الانسي لجوارحه بكلامه ، ويشبه تحريك الانسان بكلامه وحركته ، وتصويته ، كما يصوت بقصبة ونحوها ، مع انه في ذلك كله قد قام به من الفعل ما يصح به نسبة ذلك اليه ، وقولهم : المتكلم من فعل الكلام وان كان قاءما بغيره ، كلام متناقض فان الفعل ايضا لا يقوم بغير الفاعل ، وانما الذي يقوم بغيره هوالمفعول . واما قول من يقول : ان الخلق لا يكون الا بمعني المخلوق فهو من بدع الجهمية ، وعامة اهل الاسلام علي خلاف هذا ، وكذلك قال الاءمة مثل ما ذكره الامام احمد فيما خرجه في الرد علي الزنادقة والجهمية قال : ففيما يسال عنه الجهمي يقال له : تجد في كتاب الله انه يخبر عن القران انه مخلوق فلا يجد ، فيقال له : فبم قلت فيقول : من قول الله : @QB@ انا جعلناه قرانا عربيا @QE@ الزخرف :  ] ، وزعم ان كل مجعول مخلوق ، فادعي كلمة من الكلام المتشابه يحتج بها من اراد ان يلحد في تنزيلها ، ويبتغي الفتنة في تاويلها ، وذلك ان جعل في القران من المخلوقين علي وجهين علي معني التسمية ، وعلي معني فعل من افعالهم ، قوله : @QB@ الذين جعلوا القران عضين @QE@ الحج الجواب  ] ، قالوا : هو شعرا وانباء الاولين واضغاث احلام ، فهذا علي معني التسمية ، وقال : @QB@ وجعلوا الملاءكة الذين هم عباد الرحمن اناثا @QE@ الزخرف :  ] ، يعني انهم سموهم اناثا ثم ذكر جعل علي غير معني التسمية فقال : @QB@ يجعلون اصابعهم في اذانهم @QE@ البقرة :  ] فهذا علي معني فعل من افعالهم وقال : @QB@ حتي اذا جعله نارا @QE@ الكهف :  ] ، هذا علي معني فعل ، هذا جعل المخلوقين ، ثم ذكر جعل من الله علي معني خلق ، وجعل علي غير معني خلق ، والذي قال الله جل ثناءه جعل علي معني خلق لا يكون الا خلقا ولا يقوم الا مقام خلق لا يزول عن المعني ، فما قال الله جعل علي معني خلق كذلك قوله : ^ الحمد & الذي خلق السموات والارض وجعل الظلمات والنور ^ الانعام :  ] ، بمعني خلق الظلمات والنور ، @QB@ وجعلنا الليل والنهار ايتين @QE@ الاسراء :  ] ، يقول خلقنا الليل والنهار ايتين ، قال : ^  وجعل الشمس سراجا ^ النوح :  ] ، وقال : ^ هو الذي خلقكم من نفس واحدة وجعل منها زوجها ^ الاعراف :  ] ، يقول خلق منها زوجها خلق من ادم حواء ، وقال : ^ وجعل لها رواسي ^ النمل :  ] ، ومثله في القران كثير فهذا وما كان مثاله لا يكون مثاله الا علي معني خلق وقوله : ^ ما جعل الله من بحيرة ^ الماءد :  ] ، لا يعني ما خلق الله من بحيرة . وقال الله لابراهيم : ^ اني جاعلك للناس اماما ^ البقرة :  ] ، لا يعني : اني خالقك للناس اماما ، لان خلق ابراهيم كان متقدما ، قال ابراهيم : ^ رب اجعل هذا البلد امنا ^ البقرة :  ] ، وقال : ^ رب اجعلني مقيم الصلاة ^ ابراهيم :  ] ، لا يعني : خلقني مقيم الصلاة ، وقال : ^ يريد الله ان لا يجعل لهم حظا في الاخرة ^ ال عمران :  ] ، لا يعني يريد الله ان لا يخلق لهم حظا في الاخرة ، وقال لام موسي : ^ انا رادوه اليك وجاعلوه من المرسلين ^ القصص :  ] ، لا يعني وخالقوه من المرسلين لان الله تعالي وعد ام موسي ان يرده اليها ثم يجعله من بعد ذلك مرسلا ، وقال : ^ ويجعل الخبيث بعضه علي بعض فيركمه جميعا فيجعله في جهنم ^ الانفال :  ] ، لا يعني فيخلقه في جهنم ، وقال : ^ ونريد ان نمن علي الذين استضعفوا في الارض ونجعلهم اءمة ونجعلهم الوارثين ^ القصص :  ] ، وقال : ^ فلما تجلي ربه للجبل جعله دكا ^ الاعراف :  ] ، لا يعني خلقه دكا ومثله في القران كثير ، وما كان علي مثاله لا يكون علي معني خلق ، فاذا قال تعالي جعل علي معني خلق ، وقال : جعل علي غير معني خلق فباي حجة قال الجهمي : جعل علي معني الخلق فان رد الجهمي الجعل الي المعني الذي وصفه الله فيه ، والا كان من الذين يسمعون كلام الله ثم يحرفونه من بعدما عقلوه وهم يعلمون فلما قال الله عز وجل : ^ انا جعلناه قرانا عربيا لعلكم تعقلون ^ الزخرف :  ] ، يقول جعله جعلا علي معني فعل من افعال الله علي غيرمعني خلق ، وقال في سورة يوسف : ^ انا انزلناه قرانا عربيا لعلكم تعقلون ^ يوسف :  ] ، وقال : ^ بلسان عربي مبين ^ الشعراء :  ] ، وقال : ^ فانما يسرناه بلسانك ^ مريم :  ] فلما جعل الله القران عربيا ويسره بلسان نبيه كان ذلك فعلا من افعال الله جعل به القران عربيا ، ففي هذا بيان لمن اراد الله هداه . وقال البخاري في صحيحه ، باب ما جاء في تخليق السموات والارض وغيرها من الخلاءق ، وهو فعل الرب وامره فالرب بصفاته وفعله وامره وكلامه هو الخالق المكون غير مخلوق ، وما كان بفعله وامره وتخليقه وتكوينه فهو مفعول مخلوق مكون ، وقال الامام احمد فيما خرجه في الرد علي الجهمية : بيان ما انكرت الجهمية  ان يكون الله كلم موسي صلي الله عليه وسلم وعلي نبينا وعلي ساءر الانبباء ، قلنا : لم انكرتم ذلك قالوا : لان الله لم يتكلم ولا يتكلم انما كون شيءا فعبر عن الله وخلق صوتا فسمع فزعموا ان الكلام لا يكون الا من جوف وفم وشفتين ولسان فقلنا : فهل يجوز لمكون او لغير الله ان يقول لموسي : ^ لا اله الا انا فاعبدني واقم الصلاة لذكري ، واني انا ربك ^ طه :  ] فمن زعم ذلك فقد زعم ان غير الله ادعي الربوبية ، ولو كان كما زعم الجهمية ان الله كون شيءا كان يقول ذلك المكون ، يا موسي انا الله رب العالمين ، ولا يجوز ان يقول اني انا الله رب العالمين ، وقد قال الله جل ثناءه : @QB@ وكلم الله موسي تكليما @QE@ النساء :  ] ، وقال : @QB@ ولما جاء موسي لميقاتنا وكلمه ربه @QE@ الاعراف :  ] ، وقال : اني اصطفيتك علي الناس برسالاتي وبكلامي فهذا منصوص القران ، قال : واما ما قالوا ان الله لم يتكلم ولا يتكلم فكيف يصنعون بحديث سليمان الاعمش عن خيثمة عن عدي بن حاتم الطاءي ، قال : قال رسول الله صلي الله عليه وسلم : ما منكم من احد الا سيكلمه الله ليس بينه وبينه ترجمان ، قال : واما قولهم : ان الكلام لايكون الا من جوف وفم وشفتين ولسان . اليس الله عز وجل قال للسموات والارض : @QB@ اءتيا طوعا او كرها قالتا اتينا طاءعين @QE@ فصلت :  ] ، اتراه انها قالت بجوف وشفتين ولسان وقال الله : @QB@ وسخرنا مع داود الجبال يسبحن @QE@ الانبياء :  ] ، اتراها انها سبحت بفم وجوف ولسان وشفتين والجوارح اذا شهدت علي الكافر فقالوا : ^ لم شهدتم علينا قالوا انطقنا الله الذي انطق كل شء ^ فصلت :  ] ، اتراها نطقت بجوف وشفتين وفم ولسان ولكن الله انطقها كيف شاء من غير ان يقول فم ولسان وشفتان ، قال : فلما خنقته الحجج قال : ان الله كلم موسي الا ان كلامه غيره فقلنا : وغيره مخلوق قال : نعم ، قلنا : هذا مثل قولكم الاول الا انكم تدفعون الشنعة عن انفسكم بما تظهرون ، وحديث الزهري : قال : لما سمع موسي كلام ربه ، قال : يارب هذا الكلام الذي سمعته هو كلامك قال : نعم ياموسي هو كلامي ، وانما كلمتك بقوة عشرة الاف لسان ، ولي قوة الالسن كلها ، وانا اقوي من ذلك ، وانما كلمتك علي قدر ما يطيق بدنك ، ولو كلمتك باكثر من ذلك مت ، قال : فلما رجع موسي الي قومه ، قالوا له : صف لنا كلام ربك فقال : سبحان الله وهل استطيع ان اصفه لكم قالوا : تشبهه ، قال : اسمعتم اصوات الصواعق التي تقبل في احلا حلاوة سمعتموها  فكانه مثله . قال : وقلنا للجهمية : من القاءل لعيسي يوم القيامة : يا عيسي بن مريم انت قلت للناس اتخذوني وامي الهين من دون الله اليس الله هو القاءل قالوا : يكون الله شيءا يعبر عن الله كما يكون فعبر لموسي فقلنا : فمن القاءل : @QB@ فلنسالن الذين ارسل اليهم ولنسالن المرسلين @QE@ الاعراف :  ] ، اليس الله هو الذي يسال قالوا : هذا كله انما يكون الله شيءا فيعبر عن الله قلنا : قد اعظمتم علي الله الفرية ، حتي زعمتم ان الله لا يتكلم فشبهتموه بالاصنام التي تعبد من دون الله لان الاصنام لا تتكلم ولا تتحرك ولا تزول عن مكان الي مكان ، فلما ظهرت عليه الحجة ، قال : اقول ان الله قد يتكلم ، ولكن كلامه مخلوق ، قلنا : وكذلك بنو ادم كلامهم مخلوق ، ففي مذهبكم ان الله قد كان في وقت من الاوقات لا يتكلم حتي خلق التكلم ، وكذلك بنو ادم كانوا لا يتكلمون حتي خلق لهم كلاما ، فقد جمعتم بين كفر تشبيه ، فتعالي الله عن هذه الصفة ، بل نقول ان الله جل ثناءه لم يزل متكلما اذا شاء ، ولا نقول : انه كان ولا يتكلم حتي خلق كلاما ، ولا نقول : انه قد كان لا يعلم حتي خلق علما فعلم ، ولا نقول : انه قد كان ولا قدرة حتي خلق لنفسه قدرة ولا نقول : انه قد كان ولا نور له حتي خلق لنفسه نورا ، ولا نقول : انه كان ولا عظمة حتي خلق لنفسه عظمة . فقالت الجهمية لنا : لما وصفنا من الله هذه الصفات : ان زعمتم ان الله ونوره و الله وقدرته ، و الله وعظمته فقد قلتم بقول النصاري حين زعمتم ان الله لم يزل ونوره ، ولم يزل وقدرته ، فقلنا : لا نقول : ان الله لم يزل وقدرته ولم يزل ونوره ، ولكن نقول : لم يزل بقدرته ونوره لا متي قدر ولا كيف قدر فقالوا : لا تكونون موحدين ابدا حتي تقولوا كان الله ولا شء ، فقلنا : نحن نقول كان الله ولا شء ، ولكن اذا قلنا : ان الله لم يزل بصفاته كلها اليس انما نصف الها واحدا بجميع صفاته وضربنا لهم مثلا في ذلك ، فقلنا لهم : اخبرونا عن هذه النخلة اليس لها جذوع وكرب وليف وسعف وخوص وجمار واسمها اسم واحد ، وسميت نخلة بجميع صفاتها فكذلك الله جل ثناءه وله المثل الاعلي بجميع صفاته اله واحد ، لا نقول : انه قد كان في وقت من الاوقات ولا قدرة له حتي خلق قدرة ، والذي ليس له قدرة هو عاجز ، ولا نقول : انه قد كان في وقت من الاوقات ولا علم له حتي خلق فعلم ، والذي لا يعلم فهو جاهل ، ولكن نقول لم يزل الله قادرا عالما مالكا لامتي ولا كيف ، وقد سمي الله رجلا كافرا اسمه الوليد بن المغيرة المخزومي فقال : ^ ذرني  المءمنون :  ] ، @QB@ واقبل بعضهم علي بعض يتساءلون @QE@ الصافات :  ] ، ^ ولا يكتمون الله حديثا النساء :  ] ، ^ و الله ربنا ما كنا مشركين ^ الانعام :  ] فقد كتموا في هذه الاية وقال : ^ ام السماء بناها ^  الي قوله  ^ دحاها ^ النازعات :    ] فذكر خلق السماء قبل خلق الارض ، ثم قال : ^ اانكم لتكفرون بالذي خلق الارض في يومين ^ ،  الي  : ^ طاءعين ^ فصلت :    ] فذكر في هذه الاية خلق الارض قبل السماء وقال : وكان الله غفورا رحيما عزيزا حكيما سميعا بصيرا ، فكانه كان ثم مضي ، فقال : لا انساب في النفخة الاولي ، ونفخ في الصور فصعق من في السموات ، ومن في الارض الا من شاء الله فلا انساب عند ذلك ولا يتساءلون ثم في النفخة الاخرة اقبل بعضهم علي بعض يتساءلون ، واما قوله : ما كنا مشركين ولا يكتمون الله حديثا فان الله لا يغفرلاهل الاخلاص ذنوبهم ، قال  المشركون : تعالوا نقل لم نكن مشركين فختم علي افواههم فتنطق ايديهم ، فعند ذلك عرفوا ان الله لا يكتم حديثا ، وعنده : @QB@ يود الذين كفروا @QE@ النساء :  ] الاية ، وخلق الارض في يومين ثم خلق السماء ، ثم استوي الي السماء فسواهن في يومين اخرين ثم دحا الارض ودحاها : ان اخرج منها الماء والمرعي وخلق الجبال والاكام ، ومابينهما في يومين اخرين فخلقت الارض وما فيها من شء في اربعة ايام وخلقت السموات في يومين ، وكان الله غفورا رحيما سمي نفسه ذلك ، وذلك قوله اني لم ازل كذلك ، فان الله لم يرد شيءا الا اصاب فيه الذي اراد فلا يختلف عليك القران فان كلا من عند الله هكذا ، رواه البخاري مختصرا ، ورواه البرقاني في صحيحه من الطريق الذي اخرجها البخاري بعينها من طريق شيخ البخاري بعينه بالفاظه التامة : ان ابن عباس جاءه رجل فقال : يا بن عباس اني اجد في القران اشياء تختلف علي فقد وقع ذلك في صدري فقال ابن عباس : اتكذيب فقال الرجل ، ما هو بتكذيب ولكن اختلاف قال : فهلم ما وقع في نفسك ، فقال له الرجل : اسمع الله يقول : @QB@ فلا انساب بينهم يومءذ ولا يتساءلون @QE@ المءمنون :  ] ، وقال في اية اخري : @QB@ فاقبل بعضهم علي بعض يتساءلون @QE@ الصافات :  ] ، وقال في اية اخري : @QB@ ولا يكتمون الله حديثا @QE@ النساء :  ] ، وقال في اية اخري : ^ و الله ربنا ما كنا مشركين ^ الانعام :  ] فقد كتموا في هذه الاية وفي قول : @QB@ ام السماء بناها رفع سمكها فسواها واغطش ليلها واخرج ضحاها والارض بعد ذلك دحاها @QE@ النازعات :    ] فذكر في هذه الاية : خلق السماء قبل الارض ، وقال في الاية الاخري : ^ اانكم لتكفرون بالذي خلق الارض في يومين وتجعلون له اندادا ذلك رب العالمين وجعل فيها رواسي من فوقها وبارك فيها وقدر فيها اقواتها في اربعة ايام سواء للساءلين ثم استوي الي السماء وهي دخان فقال لها وللارض اءتيا طوعا او كرها قالتا اتينا طاءعين ^ فصلت :    ] ، وقوله : @QB@ وكان الله غفورا رحيما @QE@ ، @QB@ وكان الله عزيزا حكيما @QE@ ، @QB@ وكان الله سميعا بصيرا @QE@ ، وكانه كان ثم انقضي فقال ابن عباس : هات ما في نفسك من هذا ، فقال الساءل : اذا انباتني بهذا فحسبي ، قال ابن عباس ، قوله : @QB@ فلا انساب بينهم يومءذ ولا يتساءلون @QE@ ، فهذا في النفخة الاولي ينفخ في الصور فيصعق من في السموات ومن في الارض الا من شاء الله فلا انساب بينهم يومءذ ولا يتساءلون ثم اذا كان في النفخة الاخري قاموا فاقبل بعضهم علي بعض يتساءلون ، واما قول الله عز وجل : ^ و الله ربنا ما كنا مشركين ^ ، وقوله : @QB@ ولا يكتمون الله حديثا @QE@ النساء :  ] فان الله تعالي يوم القيامة يغفر لاهل الاخلاص ذنوبهم لايتعاظم عليه ذنب ان يغفره ولا يغفر شركا ، فلما راي المشركون قالوا : ان ربنا يغفر الذنوب ولا يغفر الشرك تعالوا نقول انا كنا اهل ذنوب ولم نكن مشركين فقال الله تعالي : اما اذا كتموا الشرك فاختم علي افواههم فيختم علي افواههم فتنطق ايديهم وارجلهم بما كانوا يكسبون ، ، فعند ذلك عرف المشركون ان الله لا يكتم حديثا فذلك قوله : @QB@ يومءذ يود الذين كفروا وعصوا الرسول لو تسوي بهم الارض ولا يكتمون الله حديثا @QE@ النساء :  ] ، واما قوله : @QB@ ام السماء بناها رفع سمكها فسواها واغطش ليلها واخرج ضحاها والارض بعد ذلك دحاها @QE@ النازعات :    ] فانه خلق الارض في يومين قبل خلق السماء ، ثم استوي الي السماء فسواهن في يومين اخرين يعني ثم دحي الارض ، ودحيها ان اخرج منها الماء والمرعي ، وشق فيها الانهار ، وجعل فيها السبل ، وخلق الجبال والرمال والاكام وما فيها في يومين اخرين ، فذلك قوله : @QB@ والارض بعد ذلك دحاها @QE@ النازعات :  ] ، وقوله : ^ اانكم لتكفرون بالذي خلق الارض في يومين وتجعلون له اندادا ذلك رب العالمين وجعل فيها رواسي من فوقها وبارك فيها وقدر فيها اقواتها في اربعة ايام سواء للساءلين ^ فصلت :  ] ، وجعلت السموات في يومين اخرين ، واما قوله : @QB@ وكان الله سميعا بصيرا @QE@ ، @QB@ غفورا رحيما @QE@ ، @QB@ وكان الله عزيزا حكيما @QE@ فان الله جعل نفسه ذلك وسمي نفسه ذلك ولم ينحله احد غيره وكان الله اي لم يزل كذلك ثم قال ابن عباس : احفظ عني ما حدثتك واعلم ان ما اختلف عليك من القران اشباه ما حدثتك ، فان الله لم ينزل شيءا الا اصاب به الذي اراد ولكن الناس لا يعلمون ، فلا يختلف عليك القران فان كلا من عند الله . وهكذا رواه يعقوب بن سفيان في تاريخه عن شيخ البخاري كما رواه البرقاني ، وانما يختلفان في يسير من الاحرف ، وما ذكره اءمة السنة والحديث متعين ، لما جاء في الاثار من انه سبحانه لم يزل كاملا بصفاته ، لم تحدث له صفة ولا تزول  والاستطاعة له ، ليس كمثله شء وهو خالق كل شء ، وهو كما وصف نفسه سميع بصير بلا حد ولا تقدير ، وقال تعالي حكاية عن قول ابراهيم لابيه : @QB@ لم تعبد ما لا يسمع ولا يبصر @QE@ مريم :  ] فثبت ان الله سميع بصير صفاته منه لا تتعدي القران والحديث ، والخبر بضحك الله ، ولا نعلم كيف ذلك الا بتصديق الرسول ، وتبيين القران لا يصفه الواصفون ولا يحده احد ، تعالي الله عما يقول الجهمية والمشبهة قلت له : والمشبهة ما يقولون قال : من قال بصر كبصري ، ويد كيدي  وقال حنبل في موضع اخر  : وقدم كقدمي فقد شبه الله بخلقه وهذا يحده ، وهذا كلام سوء وهذا محدود الكلام في هذا لا احبه . قال عبد الله : جردوا القران ، وقال النبي صلي الله عليه وسلم : يضع قدمه ، نءمن به ولا نحده ولا نرده علي رسول الله صلي الله عليه وسلم بل نءمن به ، قال الله تبارك وتعالي : @QB@ وما اتاكم الرسول فخذوه وما نهاكم عنه فانتهوا @QE@ الحش الجواب  ] فقد امرنا الله عز وجل بالاخذ بما جاء والنهي عما نهي ، واسماءه وصفاته غير مخلوقة ، ونعوذ ب الله من الزلل والارتياب والشك انه علي كل شء قدير ، قال الخلال : ونباني ابو القاسم ابن الجبلي عن حنبل في هذا الكلام ، وقال تبارك وتعالي : @QB@ لا اله الا هو الحي القيوم @QE@ البقرة :  ] ، : @QB@ لا اله الا هو الملك القدوس السلام المءمن المهيمن العزيز الجبار المتكبر @QE@ ، هذه صفات الله عز وجل واسماءه تبارك وتعالي . وقد روي البخاري في صحيحه عن سعيد بن جبير ، عن ابن عباس قال : قال رجل لابن عباس : اني اجد في القران اشياء تختلف علي ، قال : @QB@ فلا انساب بينهم يومءذ ولا يتساءلون @QE@  المءمنون :  ] ، @QB@ واقبل بعضهم علي بعض يتساءلون @QE@ الصافات :  ] ، ^ ولا يكتمون الله حديثا النساء :  ] ، ^ و الله ربنا ما كنا مشركين ^ الانعام :  ] فقد كتموا في هذه الاية وقال : ^ ام السماء بناها ^  الي قوله  ^ دحاها ^ النازعات :    ] فذكر خلق السماء قبل خلق الارض ، ثم قال : ^ اانكم لتكفرون بالذي خلق الارض في يومين ^ ،  الي  : ^ طاءعين ^ فص