 ومواجها به في قراءة الجاعة لما يءذن به كشف هذه الازمات من القرب المقتضي للخطاب ، ولذلك اكد بزيادة ( ما ) فقال : ( قليلا ما تذكرون ( اي بان من انجاكم من ذلك وحده حين اخلصتم له التوجه عند اشتداد الكربات ، في الامور المهمات ، فان هذا قياس ظاهر ، ودليل باهر ، ولكن من طبع الانسان نسيان ما كان فيه من الضير ، عند مجء الخير ، ومن قرا بالتحتانية وهم ابو عمرو وهشام وروح ، فللايذان بالغضب الاليق بالكفران ، مع عظيم الاحسان .
 ولما ذكر ايات الارض ، وختم بالمضطر ، وكان المضطر قد لا يتهدي لوجه حيلة ، اتبعها ايات السماء ذاكرا ما هو من اعظم صور الاضطرار فقال : ( امن يهديكم ( اي اذا سافرتم بما رسم لكم من المعالم العلوية والسفلية ) في ظلمات البر ) اي بالنجوم والجبال والرياح ، وهي وان كانت اضعفها فقد يضطر اليه حيث لا يبدو شء من ذينك ) والبحر ( بالنجوم والرياح .
 ولما كانت الرياح كما كانت من ادلة السير ، كان بعضها من ادلة المطر ، قال : ( ومن يرسل الرياح ) اي التي هي من دلاءل السير ) نشرا ( اي تنشر السحاب وتجمعها ) بين يدي رحمته ) اي التي المطر تسمية للمسبب باسم السبب ؛ والرياح التي يهتدي بها في المقاصد اربعك الصبا ، والدبور ، والشمال ، والجنوب ، وهي اعف الدلاءل ؛ قال الامام ابو هلال الحسن بن عبد الله العسكري في كتاب اسماء الاشياء وصفاتها : الرياح اربع : الشمال ، وهي التي تجء عن يمينك اذا استقبلت قبلة العراق  يعني : وذلك ما بين مطالع الشمس الصيفيةة وبنات نعش ، وهي في الصيف حارة ، واسمها البارح ، والجنوب تقابلها ، والصبا من مطلع الشمس وهي القبول ، والدبور تقابلها ، ويقال الجنوب : النعامي والارنب  انتهي .
 وهذه العبارة ابين العبارات في تعيين هذه الرياح ، وقال الامام ابو العباس احمد بن ابي احمد بن القاص الطبري الشافعي في كتابه ادلة القبلة : ان قبلة العارقيين الي باب الكعبة كله الي الركن الشامي الذي عند الحجر ، وقال : وقد اختلف اهل العلم بهذا الشان  اي في التعبير عن مواطن الرياح  اختلافا متباينا ، واقرب ذلك  علي ما جربته وتعاهدته بمكة  ان الصبا تهب ما بين مطالع الشمس في الشتاء الي مطلع سهيل ، وسهيل يمان مسقطه في راي العين علي ظهر الكعبة اذا ارتفع ، وقال صاحب القاموس : والصبا ريح مهبها من مطلع الثريا الي بنات نعش ، وقال : والقبول كصبور : ريح الصبا ، لانها تقابل الدبور ، او لانها تقابل باب  صفحة رقم 
 الكعبة ، او لان النفس تقلبها .
 وقال الامام ابو عبد الله القزاز : الصبا : الريح التي تهب من مطلع الشمس ، والقبول : الريح التي تهب من مطلع الشمس ، وذلك لانها تستقبل الدبور ، وقيل : لانها تستقبل باب الكعبة وهي الصبا ، فقد اتفقت اقولهم كما تري علي خلاف ابن القاص ، وقال ابن القاص : وهي  اي الصبا  ريح معها روح وخفة ، ونسيم تهب مما بين مشرق الشتاء ومطلع سهيل ، ولها برد يقرص اشد من هبوبها ، وتلقح الاشجار ، ولاتهب الا بليل ، سلطانها اذا اظلم الليل ، الي ان يسفر النهار وتطلع الشمس ، واشد ما يكون في وقت الاسحار وما بين الفجرين ، والجنوب تهب ما بين مطلع سهيل الي مغارب الشمس في الصيف .
 وقال في القاموس : والجنوب : ريح تخالف الشمال ، مهبها من مطلع شهيل الي مطلع الثريا ، وعن ابن هشام اللخمي ان الجنوب هي الريح القبلية .
 وفي الجمع بين العباب والمحكم : والجنوب ريح تخالف الشمال تاتي عن يمين القبلة ، وقيل : هي من الرياح ما استقبلك عن شمالك اذا وقفت في القبلة ، قال ابن الاعرابي : ومهب الجنوب من مطلع شهيل الي مطلع الثريا ، وقال الاصمعي : اذا جاءت الجنوب جاء معها خير وتلقيح ، واذا جاءت الشمال نشفت ، ويقال للمتصافيين : ريحهما جنوب ، واذا تفرقا قيل : شملت ريحهما ، وعن ابن الاعرابي : الجنوب في كل موضع حارة الا بنجد فانها باردة ؛ وقال ابن القاص : واذا هبت فقوتها في العلو والهواء اكثر لانها موكلة بالسحاب ، وتحرك الاغصان ورءوس الاشجار ، ومع ذلك فتراها تءلف الغيم في السماء ، فتراه متراكما مشحونا ، قال : وسمعت من يقول : ما اشتد هبوبها الا خيف المطر ، ولا هبت جنوب قط ثم يتبعها دبور الا وقع مطر ، وهي تهيج البحر وتظهر بكل ندي كامل في الارض ، وهي من ريح الجنة .
 والدبور  قال في القاموس : ريح تقابل الصبا ، وقال القزاز : هي التي تاتي من دبر الكعبة وهي لتي تقابل مطلع الشمس ، وقال ابن القاص : تهب ما ين مغارب الشمس في الصيف الي مطلع بنات نعشن وقوتها في الارض اشد من قوتها في الهواء ، وهي اذا هبت تثير الغبار .
 وتكسح الارض .
 وترفع الذيول ، وتضرب القدام ، واشد ما تثير الغبار اذا تنكبت ، تراها كانها تعلب بالتراب علي وجه الارض ، وتري الاشجار في البوادي والرمال لها دوي من ناحية الدبور ، وقد اجتمع في اصلها التراب وما يلي الجنوب عاريا مكشوفا متحفزا وقوتها في الارض  والله اعلم ، لان عادا او عدت بالتدمير بالرياح ، فحفرت الابار واستكنت فيها ، فبعث الله الدبور فدخلت الابار وقذفتهم متدمرين حتي اهلكتهم .
 والشمال  قال في القاموس : الريح التي تهب من قبل ا لحجر ، والصحيح انه ما مهبه ما بين مطله الشمس وبنات نعش ، او من مطلع النعش الي مسقط  صفحة رقم 
 النسر الطاءر ، ولا تكاد تهب ليلا .
 وقال القزاز : هي الريح التي تاتي عن شمالك اذا استقبلت مطلع الشمس ، والعرب تقول : ان الجنوب قالت للشمال : ان لي عليك فضلا ، انا اسري وانت لا تسرين ، فقالت الشمال : ان الحرة لا تسرين ، وقال الصغاني في مجمع البحرين : والشمال : الريح التي تهب من ناحية القطب ، وعن ابي حنيفة : هي التي تهب من جهة القطب الشمالي وهي الجربياء وهي الشامية لانها تاتيهم من شق الشام ، وفي الجمع بين العباب والمحكم ، والبوارح : شدة الرياح من الشمال في الصيف دون الشتاء كانه جمع بارحة ، وقيل : البوارح : الرياح الشداءد التي تحمل التراب ، واحدتها بارح ، والجربياء : الريح التي بين الجنوب والصبا ، وقيل : هي النكباء التي تجري بين الشمال والدبور ، وهي ريح تقشع السحاب ، وقيل هي الشمال ، وجربياءها بردها  قالهالاصمعي ، وقال الليث : هي الشمال الباردة ، وقال ابن القاص : والشمال تهب ما بين مطلع بنات نعش الي مطلع الشمس في الشتاء ، وهي تقطع الغيم وتمحوها ، ولذلك سميت الشمال المحوة ، قال : وهذا بارض الحجاز ، اما ارض العراق والمشرق فربما ساق الجنوب غيما واستداره ولم يحلبه حتي تهب الشمال فتحلبه ، والجنوب والشمال متماثلتان ، لانهما مولكتان لاسحاب ، فالجنوب تطردها وهي مشحونة ، والشمال تردها وتمحوها اذا افرغت ، قال ابو عبيدة : الشمال عند العرب للروح ، والجنوب للامطار والندي ، والدبور للبلاء ، واهونه ان يكون غبارا عاصفا يقذي العيون ، والصبا لالقاح الشجر ، وكل ريح من هذه الرياح انحرفت فوقعت بين ريحيين فهي نكباء ، وسميت لعدولها عن مهب الاربع اللواتي وصفن قبل  انتهي .
 وقال المسعودي في مروج الذهب في ذكر البوادي من الناس وسبب اختيار البدو : ان شخصا من خطباء العرب وفد علي كسري فساله عن اشياء منها الرياح فقال : ما بين سهيل الي طرف بياض الفجر جنوب ، وما بازاءهما مما يستقبلهما من المغرب شمال ، وما جاء من وراء الكعبة فهي دبور ، وما جاء من قبل ذلك فهي صبا ، ونقل ابن كثير في سورة النور عن ابن ابي حام وابن جرير عن عبيد بن عمير الليثي انه قال : يبعث الله المثيرة فتقم الارض قما ، ثم يبعث الله الناشءة فتنشء السحاب ، ثم يبعث الله المءلفة فتءلف بينه ، ثم يبعث الله اللواقح فتلقح السحاب .
 ولما انكشف بما مضي من الايات .
 ما كانوا في ظلامه من واهي الشبهات ، واتضحت الادلة ، ولم تبق لاحد في شء من ذلك علة .
 كرر سبحانه الانكار في قوله : ( االه مع الله ) اي الذي كمل علمه فشملت قدرته .
 ولما ذكر حالة الاضطرار ، واتبعها من صورها ما منه ظلمه البحر ، وكانوا في  صفحة رقم 
 البحر يخلصون له سبحانه ويتركون شركاءهم ، نبههم علي ان ذلك موجب لاعتقاد كون الاخلاص له واجبا داءمان فاتبعه قوله علي سبيل الاستعظام ، معرضا عنهم باجماع العشرة اعراض من بلغ به الغضب : ( تعلي الله ) اي الفاعل الادر المختار الذي لا كفوء له ) عما يشركون ( ، اي فان شيءا منها لا يقدر علي شء من ذلك ، واين رتبة العجز من رتبة القدرة .
 ولما رتب سبحانه هذه الادلة علي هذا الوجه ترقيا من اعم الي اخص ، ومن ارض الي سماء ، ختمها بما يعمها وغيرها ، ارشادا غلي قياس ما غاب منها علي ما شوهد ، فلزم من ذلك قطعا القدرة علي الاعادة ، فساقها لذلك سياق المشاهد المسلم ، وعد من انكره في عداد من لا يلتفت اليه فقال : ( امن يبدءا الخلق ( اي كله : ما علمتم منه وما لم تعلموا ، ثم بيده لان كل شء هالك الا وجهه ، له هذا الوصف باعترافكم يتجدد ابدا تعلقه .
 لما كان من اللازم البين لهم الاقرار بالاعادة لاعترافهم بان كل من ابدي شيءا قادر علي اعادته ، لان الاعادة اهون ، قال : ( ثم يعيده ) اي بعد ما يبيده .
 ولما كان الامطار والانبات من ادل نما يكون علي الاعادة ، قال مشيرا اليهما علي وجه عم جميع ما مضي : ( ومن يرزقكم من السماء ( اي بالنبات والمعادن والحيوان وغيرهما مما لا يعلمه الا الله ، وعر عنهما بالرزق لان به تمام النعمة ) االه مع الله ) اي الذي له صفات الجلال والاكرام ، كاءن ، او يفعل شيءا من ذلك .
 ولما كانت هذه كلها براهين ساطعة ، ودلاءل قاطعة ، وانوارا لامعة ، وحججا باهرة ، وبينات ظاهرة ، وسلاطين قاهرة ، علي التوحيد المستلزم للقدرة علي البعث وغيره نم كل ممكن ، امره ( صلي الله عليه وسلم ) اعراضا عنهم ، ايذانا بالغضب في اخرها بامرهم بالاتيان ببرهان واحد علي صحة معتقدهم فقال : ( قل ) اي هءلاء المدعين للعقول ) هاتوا برهانكم ) اي علي نفي شء من ذلك عن الله تعالي ، او علي اثبات شء منه لغيره ، لتثبت دعوي الشركة في الخلق فتسمع دعوي الشركة في الالوهية ، وليكن اتيانكم بذلك ناجزا من غير مهلة ، لان من يدعي العقل لا يقدر علي شء الا ببرهان حاضر ) ان كنتم صادقين ( اي في انكم علي حق في ان مع الله غيره .
 واضاف البرهان اليهم اضافة ما كانه عنيد ، لا كلام في وجوده وتحققه ، وانما المراد الاتيان به كل ذلك تهكما بهم وتنبيها علي انهم ابعدوا في الضلال ، واعرقوا في المحال ، حيث رضوا لانفسهم بتدن لا يضير اليه عاقل غلا بعد تحقق القطع بصحته ، ولا شبهة في انه لا شبهة لهم علي شء منه .

