 ولما كان العدد الكثير لا يمكن ناظره الوقوع فيه علي حقيقة عدده ، بل يصير  وان اثبت الناس نظرا  يقول : هم كذا يزيدون قليلا او ينقصونه ، وتارة يجزم بانهم لا ينقصون عن كذا ، واما الزيادة فممكنة ، وتارة يغلب علي ظنه الزيادة ، وهو المراد هنا ، قال : ( او يزيدون ( لان الترجية في كثرة الاتباع اقر للعين واسر للقلب ، وافهاما لان الزيادة واقعة ، وهءلاء المرسل اليهم هم اهل نينوي وهم من غير قومه ، فان حدود ارض بني اسراءيل الفرات ، ونينوي من شرقي الفرات بعيدة عنه جدا .
 ولما تسبب عن ايتانه اليهم انشراح صدره بعد ما حصل له من الضيق الذي اوجب له ما تقدم قال : ( فامنوا ) اي تجرديدا لانفسهم من الحظوظ النفسانية ولحوقا بالصفات الملكية .
 ولما كان ايمانهم سبب رفع العذاب الذي كان اوجبه لهم كفرهم قال : ( فمتعناهم ) اي ونحن علي ما نحن عليه من العظمة لم ينقص ذلك من عظمتنا شيءا ولا زاد فيها ) الي حين ) اي الي انقضاء اجالهم التي ضربناها لهم في الازل .
 ذكر قصة يونس عليه السلام من سفر الانبياء
 قال مترجمه : نبدا بمعونة الله وقوته بكتب نبوة يونان بن متي النبي : كانت كلمة الرب علي يونان بن متي ، يقول له : قم فانطلق الي نينوي المدينة العظيمة وناد فيها بان شرارتكم قد صعدت قدامي ، وقام يونان ليفر الي ترسيس من قدام الرب ، وهبط الي يافا ووجد سفينة تريد تدخل الي ترسيس فاعطي الملاح اجرة ونزلها ليدخل معهم الي  صفحة رقم 
 ترسيس هاربا من قدام الرب ، والرب طرح ريحا عظمية في البحر ، فكان في البحر موج عظيم ، والسفينة كانت تتمايل لتنكسر وفرق الملاحون وجار كل انسان الي الاهه ، وطرحوا متاع السفينة في البحر ليخففوا عنهم ، بحق هبط يونان الي اسفل السفينة ونام فدنا منه سيد الملاحين وقال له : لماذا انت ناءم ؟ قم فادع الاهك لعل الله يخلصنا ولا نهلك ، وقال الرجل لصاحبه : تعالوا نقترع ونعلم هذا الشر من قبل من جاء علينا ؟ فاقترعوا فجاءت القرعة علي يونان ، فقالوا له : اخبرنا ما هذا الشر ؟ وماذا هو عملك ، ومن اين انت ، ومن اي شعب انت ، وايتها ارضك ؟ فقال لهم يونان : انا عبراني ولله رب السماء اخشي الذي خلق البر والبحر ، ففرق اولءك القوم فرقا شديدا ، فقالوا له : ماذا صنعت ؟ لان اولءك الناس علموا انه من قدام الاه هرب ، فلما اخبرهم قالوا : ما نصنع بك حتي يسكن عنا البحر لان البحر هو ذا منطلق يزخر علينا ؟ قال لهم يونان : خذوني فاطرحوني في البحر فيسكن عنكم البحر لاني اعلم ان هذا الموج العظيم من اجلي هاج عليكم ، فجهد اولءك الناس ان يرجعوا الي الساحل ، فلم يجدوا الي ذلك سبيلا ، لان البحر كان ذاهبا يزخر عليهم ، ودعوا الي الرب وقالوا : ايها الرب لا يحسب علينا دم زكي ، ولا نهلك بنفس هذا الرجل من اجل انك انت الرب ، وكل ما شءت تصنع ، فاخذوا يونان وطرحوه في البحر ، فاستقر البحر من امواجه ، وفرق اولءك الناس من قدام الرب فرقا شديدا ، وذبحوا ذباءح للرب ونذروا له النذور ، وهيا الرب سمكة عظيمة فابتلعت يونان ، وكان يونان في امعاء السمكة ثلاثة ايام وثلاث ليالي وقال : دعوت الرب في حزني فاجابني ، ومن بطن الجحيم تضرعت اليه ، وسمع صوتي وطرحني في الغوط في قلب البحر ، والانهار احاطت بي ، وكل امواجك واهياجك علي جازت ، انا بحق قلت : اني قد تباعدت من قدام عينيك ، من الان اتري اعود فانظر الي هيكلك المقدس ، وقد احاطت بي المياه حتي نفسي والاهوال احاطت بي ، وفي اسفل البحر احتبس راسي ، والي اسفل الجبال هبطت ، والارض اطبقت اغلاقها في وجهي الي الدهر ، اذا اغتنمت نفسي للرب ذكرت ودخلت صلاتي قدامك الي هيكلك المقدس ، فكل الذين يحفظون الانساك البطالة رحمتهم فتركوا ، انا بحق بصوت الشكر اقرب لك واذبح ، والذي نذرته اوفيه للرب فامر الرب السمكة فقذفت يونان في اليبس ، واتي الكلام الرب اليه المرة الثانية ، وقال له : قم يا يونان فانطلق الي نينوي المدينة العظمية وناد فيها بالنداء الذي اقوله لك ، فقام يونان وانطلق الي نينوي مثل كلمة الرب ، ونينوي كانت مدينة عظمية للرب مسيرة ثلاثة ايام ، وتبدا يونان ان يدخل الي نينوي مسيرة يوم واحد ونادي وقلال : من الان والي اربعين يوما نينوي تنقلب ، فامن  صفحة رقم 
 اهل نينوي لله وفرضوا الصوم ولبسوا المسوح من عظماءهم حتي صغاءرهم ، وانتهت الكلمة الي ملك نينوي فقام عن كرسيه ونزع تاجه ، واكتسي مسح شعر ، وجلس علي الرماد ، ونادي في نينوي وقال الملك واشرافه : وكل الناس والغداءر والثيران والغنم فلا يذوقون شيءا من الطعام ولا يرعون ، وماء فلا يشربون ، ولكن فليلبس الناس والغداءر ويدعو الله بالتضرع ، ويرجع كل انسان عن طريقة السوء ، وعن الاختطاف الذي في يده ، وقالوا : من ذا الذي يعلم ان الله يقبل منا ويترحم علينا ويرد عنا غصبه ورجزه لكيلا نهلك ، ونظر الله الي اعمالهم انهم قد تابوا عن طرقهم السوء فرد عنهم غضب رجزه ولم يبدهم ، وحزن يونان حزنا شديدا ، وتكره من ذلك جدا ، وصلي قدام الرب وقال : ايها الرب الم تكن هذه كلمتي ، وانا بعد في بلادي ولذلك سبقت وفررت الي ترسيس ، قد عرفت بحق انك الرحمن الاله الرءوف ، طويل صبرك وكثيرة نعمتك ، وترد السوء الان يا رب انزع نفسي مني لان الموت انفع لي في الحياة ، فقال له : جدا حزنت يا يونان ، وخرج يونان من المدينة واتخذ له ثمة مظلة وجلس تحتها في الظل لينظر ما الذي يعرض للمدينة ، وامر الله الرب اصل القرع ، ونبت وارتفع علي راس يونان ، فكان ظل علي راسه فتفرج من شدته وفرح فرحا كثيرا يونان باصل القرع .
 وفي اليوم الاخر امر الله الرب دودة في مطلع الصبح فضربت اصل القرع وقرضته ، فلما طلعت الشمس امر الله ريح السموم فيبست اصل القرع ، وحميت الشمس في راس يونان ، واغتنم وسال الموت لنفسه وقال : انك يا رب تقدر تنزع نفسي مني ، لاني لم اكن اخبر من اياي ، وقال الرب ليونان : جدا حزنت علي اصل القرع ، فقال يونان : جدا احزن حتي الموت ، قال له الرب : انت اشفقت علي اصل القرع الذي لم تعن به ولم تربه ، الذي في ليلة نبت ، وفي ليلة يبس ، فكيف لا اشفق انا علي نينوي المدينة العظيمة التي فيها اكثر من اثنتي عشرة ربوة من الناس الذين لا يدرون ما بين يمنيهم من شمالهم وكثرة من الغداءر  انتهي .
 ولعل اصل القرع المذكور هنا كان نبت عليه حين خرج من بطن الحوت ، فلما اتفق له ما ذكر هنا رجع اليه وقد زاد عظمه فبني تحته عريشا وجلس تحته ، فكان منه ما كان ، فلا يكون حينءذ ما هنا مخالفا لما ذكر اهل الاخبار في هذه القصة  والله الموفق .
