 ولما تمت الدعوي ، حصل التشوف الي الجواب فاستءنف قوله : ( قال ) اي علي تقدير صحة ما قلت ، وذلك انه لما راي الخصم قد سكت ولم ينكر مما قال المدعي شيءا ، وربما اظهر هيءة تدل علي تصديقه قال ذلك فعوتب وان كان له مخرج ، كل ذلك تدريبا وربما اظهر هيءة تدل علي تصديقه قال ذلك فعوتب وان كان له مخرج ، كل ذلك تدريبا علي التثبت في القضاء وان لا ينحي نحو القراءن ، وان لا يقنع فيه الا بمثل الشمس ، واكد قوله في سياق القسم ردعا للظالم علي تقدير صحة الدعوي بالمبالغة في انكار فعله لان حال من فعل شيءا مءذن بانكار كونه ظالما وكون فعله ظلما .
 مفتتحا لقوله بحرف التوقع لاقتضاء حال الدعوي له : ( لقد ظلمك ) اي والله قد اوقع ما فعله معك في غير موقعه علي تقدير صحة دعواك ) بسءال نعجتك ) اي بان سالك ان يضمها ، وافاد ان ذلك علي وجه الاختصاص بقوله : ( الي نعاجه ( بنفسه او بغيره نيابة عنه ولذا لم يقل : ولما كانت الخلطة موجبة لظن الالفة لوجود العدل والنصفة واستبعاد وجود البغي معها ، اكد قوله واعظا للباغي ان كان وملوحا بالاغضاء والصلح للمظلوم : ( وان كان كثيرا من الخلطاء ) اي مطلقا منكم ومن غيركم ) ليبغي ) اي يتعدي ويستطيل ) بعضهم ( عاليا ) علي بعض ( فيريدون غير الحق ) الا الذين امنوا ( من الخلطاء ) وعملوا ) اي تصديقا لما ادعوه من الايمان ) الصالحات ) اي كلها فانهم لا يقع منهم بغي ) وقليل ( واكد قلتهم وعجب منها بما ابهم في قوله : ( ما ( مثل نعما ولامرها ) هم ( واخر هذا المبتدا وقدم الخبر اهتماما به لان المراد التعريف بشدة الاسف علي ان العدل في غاية القلة ، اي فتاس بهم ايها المدعي وكن منهم ايها المدعي عليه .

 صفحة رقم 
 ولما اتم ذلك ذهب الداخلون عليه فلم ير منهم احدا فوقع في نفسه انه لا خصومة ، وانهم انما ارادوا ان يجربوه في الحكم ويدربوه عليه ، وانه يجوز للشخص ان يقول ما لم يقع اذا انبني عليه فاءدة عظيمة تعين ذلك الكلام طريقا للوصول اليها او كان احسن الطرق مع خلو الامر عن فساد ، وحاصله انه تذكر كلام ، والمراد به بعض لوازمه ، فهو مثل دلالة التضمن في المفردات ، وهذا مثل قول سليمان عليه السلام ( اءتوني بالسكين اشقه بينهما ) وليس مراده الا ما يلزم عن ذلك من معرفة الصادقة والكاذبة باباء الام لذلك وتسليم المدعية كذبا ، وتحقيقه انه لا ملازمة بين الكلام وارادة المعني المطابقي لمفردات الفاظه بدليل لغوو اليمين ، وقول النبي ( صلي الله عليه وسلم ) لصفية رضي الله عنها ( عقري حلقي ) ولام سلمة رضي الله عنها ( تربت يمينك ) وقوله ( صلي الله عليه وسلم ) ( ثلاث جدهن جد وهزلهن جد ) مشير الي ان الكلام قد لا يراد به معناه ، ومن هنا كان الحكم في الفاظ الكنايات انه لا يقع بها شء الا ان اقترن بقصد المعني ، ولما كان هذا القدر معلوما عطف عليه قوله : ( وظن داود ) اي بذهابهم قبل فصل الامر وقد دهمه من ذلك امر عظيم من عظمة الله لا عهد له بمثله ) انما فتناه ) اي اختبرناه بهذه الحكومة في الاحكام التي يلزم الملوك مثلها ليتبين امرهم فيها .
 وعلم انه بادر الي نسبة المدعي عليه الي انه ظلم من قبل ان يسمع كلامه ويساله المدعي الحكم ، فعاتبه الله علي ذلك ، والانبياء عليهم السلام لعلو مقاماتهم يعاتبون علي مثل هذا ، وهو من قصر الموصوف علي الصفة قلبا ، اي هذه القصة مقصورة علي الفتنة لا تعلق لهم بالخصوصة ، ولو كان المراد ما قيل من قصة المراة التي علي كل مسلم تنزيهه وساءر اخوانه عليهم السلام عن مثلها لقيل ( وعلم داود ) ولم يقل : وظن  كما يشهد بذلك كل من له ادني ذوق في المحاورات  والله الموفق ، وقال الزمخشري : وعن سعيد بن المسيب والحارث الاعور ان علي بن ابي طالب رضي الله عنه قال : من حدثكم بحديث داود علي ما يرويه القصاص جلدته ماءة وستين ، وهو حد الفرية علي الانبياء عليهم السلام ، وروي انه حدث بذلك عمر بن عبد العزيز ، وعنده رجل من اهل الحق ، فكذب المحدث به  صفحة رقم 
 وقال : ان كانت القصة علي ما في كتاب الله عز وجل فما ينبغي ان يلتمس خلافها ، واعظم بان يقال غير ذلك ، وان كانت علي ما ذكرت وكف الله عنها سترا علي نبيه ( صلي الله عليه وسلم ) فما ينبغي اظهارها عليه ، فقال عمر بن عبد العزيز : لسماعي هذا الكلام احب الي مما طلعت عليه الشمس .
 وتلك القصة وامثالها من كذب اليهود ، واخبرني بعض من اسلم منهم انهم يتعمدون ذلك في حق داود عليه السلام لان عيسي عليه السلام من ذريته ليجدوا السبيل الي الطعن فيه .
 ولما ظن هذا ، سبب له تحقيق ما وصفه الله من الاوبة فعبر عن ذلك بقوله : ( فاستغفر ( ولما استغرقته العظمة التي هذا مخرها ، رجع الي ذكر الاحسان واللطف فقال : ( ربه ) اي طلب الغفران من مولاه الذي احسن اليه باحلاله ذلك المحل العظيم من ان يعود للحكم للاول بدون ان يسمع الاخر ) وخر ) اي سقط من قيامه توبة لربه عن ذلك ، ولما كان الخرور قد يكون لغير العبادة قال : ( راكعا ) اي ساجدا لان الخرور لا يكون الا للسقوط علي الارض ، ولان النبي ( صلي الله عليه وسلم ) فسره بالسجود فيما روي النساءي عن ابن عباس رضي الله عنهما ان النبي ( صلي الله عليه وسلم ) سجد في ( ص ) وقال ( سجدها داود توبة ونسجدها شكرا ) .
 وعين بالركوع عن السجود ليفهم انه كان عن قيام وانه في غاية السرعة لقوة الاهتمام به وتوفر الداعي اليه بحيث انه وصل الي السجود في مقدار ما يصل غيره الي الركوع ، قال ابن التياني في كتابه الموعب : وكل شء يكب لوجهه فتمس ركبته الارض بعد ان يطاطء راسه فهو راكع .
 ابن دريد : الراكع الذي يكبو علي وجهه  انتهي .
 والركعة  بالضم : الهوة من الارض ، كانها سميت بذلك لانها تسقط فيها علي الوجه ، وكانها هي اصل المادة ، وقال في القاموس : ركع اي صلي ، فحينءذ يكون المعني : سقط مصليا ، ومعلوم ان صلاتهم لا ركوع فيها وقد تقدم ذلك في ال عمران والبقرة ) واناب ) اي تاب اي رجع عن ان يعود لمثلها .
 ولما كان الحال قد يشكل في الاخبار عم المغفرة لو عبر بضمير الغاءب لايهام ان ربه غير المتكلم ، وكان الغفران لا يحسن الا مع القدرة ، عاد الي مظهر العظمة اثباتا للكمال ونفيا للنقص : فقال : ( فغفرنا ) اي بسبب ذلك وفي اثره علي عظمتنا وتمام قدرتنا غفرا يناسب مقداره ما لنا من العظمة ) له ذلك ) اي الوقوع في الحديث عن اسناد الظلم الي احد بدون سماع لكلامه ، وكان النبي ( صلي الله عليه وسلم ) اشترط علي ربه سبحانه لاجل هذه القصة ان كل من سبه او دعا عليه وليس اهلا لذلك ان يكون ذلك له صلاة وبركة ورحمة ، والحاصل ان هذه  صفحة رقم 
 القضية لتدريب النبي ( صلي الله عليه وسلم ) علي الصبر علي قومه ، والثاني فان هذه السورة علي ما روي عن جابر بن زيد من اواءل ما انزل بمكة ، وعلي هذا دل الحديث السابق عن ابن عباس رضي الله عنهما في شكوي المشركين منه ( صلي الله عليه وسلم ) الي عمه ابي طالب الوقوع في الهتهم فانه كان في اواءل الامر ، فان النبي ( صلي الله عليه وسلم ) اول ما دعاهم لم يءمر بذكر الهتهم فلم يجيبوه ولم يبعدوا عن كل البعد ، ثم امره الله بذكر الهتهم فناكروه حينءذ وباعدوه ، وتقدموا ذلك بالشكوي الي ابي طالب مرة بعد اخري ليرده عنه ، فكانت هذه الدعوي تدريبا لداود عليه السلام في الاحكام ، وذكرها للنبي ( صلي الله عليه وسلم ) تدريبا له علي الاناة في جميع اموره علي الداوم .
 ولما كان ذكر هذا ربما اوهم شيءا في مقامه ( صلي الله عليه وسلم ) ، سيق في اسلوب التاكيد قوله : ( وان له ) اي مع الغفران ، وعظم ذلك بمظهر العظمة لان ما ينسب الي العظيم لا يكون الا عظيما فقال : ( عندنا ( وزاد في اظهار الاهتمام بذلك نفيا لذلك الذي ربما مرجع في كل ما يءمل من الخير ، وفرق ذلك ، وادل دليل علي ما ذكرته  ان هذه الفتنة انما هي بالتدريب في الحكم لا بامراة ولا غيرها وان ما ذكروه من قصة المراة باطل الاستثمار منها صارفا القول عن مظهر العظمة الي المواجهة بلذيذ الخطاب ، علي نحو ما يجري بين الاحباب ) يا داود ( .
 ولما كان مضمون الخبر لزيادة عظمة مما من شانه ان تستنكره نفوس البشر ، اكده لذلك واظهارا لانه مما يرغب فيه لحسنه وجميل اثره وينشط غاية النشاط لذكره فقال : ( انا ) اي علي ما لنا من العظمة ) جعلناك ( فلا تحسب لشء من اسبابه حسابا ولا تخش له عاقبة ) خليفة ) اي من قبلنا تنفذ اوامرنا في عبادنا فحكمك حكمنا ، وحذف ما يعلم انه مراد من نحو ) قلنا ( اشارة الي انه استقبل بهذا الكلام الالذ عند فراغه من السجود اعلاما بصدق ظنه ، وقال : ( في الارض ) اي كلها بهذا الكلام الالذ عن فراغه من السجود اعلاما بصدق ظنه ، وقال : ( في الارض ) اي كلها اشارة الي اطلاق امره في جميعها ، فلا جناح عليه فيما فعل في اي بلد ارادها ، ولم يذكر المخلوف تعظيما له بالاشارة الي ان كل ما جوزه العقل فيه فهو كذلك فهو كان خليفة في بيت المقدس بالفعل علي ما اقتضاه صريح الكلام بالتعبير بفي ، واشار الاطلاق والتعبير بال الي انها خليفة في جميع الارض بالقوة بمعني انه مهما حكم فيها صح ، وذلك ان النبي ( صلي الله عليه وسلم ) كان يرسل الي قومه خاصة فيكون ما يءديه اليه واجبا عليه ، واما بقية الناس فامره معهم  صفحة رقم 
 من باب الامر بالمعروف والنهي عن المنكر ، مهما فعله منه صح ومضي ، ثم كان خليفة في جميع الارض حقيقة بالفعل بابنه سليمان عليه السلام فاستوفي الاطلاق ) وال ( المكملة اقصي ما يراد منه ، اعلاما بان كلام القدير كله كذلك وان لم يظهر في الحالة الراهنة ، وذلك كما ان المنزل عليه هذا الذكر وبسببه محمد ( صلي الله عليه وسلم ) كان خليفة بالفعل في ارض العرب التي هي قيام لهم ، ومن انبسط القيام بالنور والعدل علي جميع الارض وفي جميع الارض بالقوة بمعني انه مهما حكم به فيها مضي ، فقد اعطي تميما الداري رضي الله عنه ارض بلد الخليل من بلاد الشام قبل ان يفتح وصح نفذ ، واعطي شويلا رضي الله عنه بنت بقيلة من اهل الحيرة وصح ذلك ونفذ وقبض كل منهما عند الفتح ما اعطاه ( صلي الله عليه وسلم ) الذي هو من ذرية داود عليه السلام ثم في جميع الوجود يوم القيامة يوم الشفاعة العظمي يوم يكون الانبياء كلهم تحت لواءه ، ويغبطه الاولون والاخرون بذلك المقام المحمود .
 ولما تمت النعمة ، سبب عنها قوله : ( فاحكم بين الناس ) اي الذين يتحاكمون اليك من اي قوم كانوا ) بالحق ) اي الامر الثابت الذي يطابقه الواقع .
 ولما كان اعدي عدو للانسان نفسه التي بين جنبيه لما لها من الشهوات ، واعظم جناياته واقبح خطاياه ما تاثر عنها من غير استناد الي امر الله ، مشيرا بصيغة الافتعال الي انه سبحانه عفا الخطرات ، وما بادر الانسان الرجوع عنه والخلاص منه توبة الي الله تعالي : ( ولا تتبع الهوي ) اي ما يهوي بصاحبه فيسقطه من اوج الرضوان الي حضيض الشيطان ، ثم سبب عنه قوله : ( فيضلك ) اي ذلك الاتباع او الهوي لان النفس اذا ضربت علي ذلك صار لها خلقا فغلب صاحبها عن ردها عنه ، ولفت القول عن مظهر العظمة الي الاسم الاعظم الجامع لجميع الاسماء الحسني والصفات العلي تعظيما لامر سبيله ، وحثا علي لزومه والتشرف بحلوله ، فقال : ( عن سبيل الله ) اي طريقه التي شرعها للوصول اليه بما انزل من النقل المءيد بادلة ما خلق من العقل ، ولا يوصل اليه بدونها لان اتباعه يوجب الانهماك في اللذات الجسمانية ، والاهمال لتكميل القوي الروحانية ، الموصلة الي السعادة الابدية ، فان دواعي البدن والروح متضادتان فبقدر زيادة احداهما تنقص الاخري .
 ولما كانت النفس نزاعة الي الهوي ، ميالة عن السوي ، قال معللا للنهي مءكدا لما للنفس من التعللات عن المخالفة بالكرم والمغفرة الدافع للعذاب : ( ان الذين يضلون (  صفحة رقم 
 اي يوجدون الضلال باهمالهم التقوي لاتباع الهوي المقتضي لان يكون متبعه ضالا ) عن سبيل الله ( اعادة تفخيما لامره وتيمنا لامره وايذانا بان سبيله مامور به مطلقا من غير تقييد بداود عليه السلام ولا غيره فيه ) لهم عذاب شديد ) اي بسبب ضلالهم .
 ولما امر سبحانه ونهي ، وذكر ان السبب في النهي كراهة الضلال وعلم منه ان سبب الضلال الهوي ، ذكر سبب هذا السبب فقال معبرا بالنسيان اشارة الي انه من شدة ظهوره كما كان محفوظا فنسي ، وفك الصدور لانه اصرح لانه لو عبر بالمصدر لامكن اضافته الي المفعول ، واختيرت ) ما ( دون ) ان ( لان صورتها صورة الموصول الاسمي ، وهو ابلغ مما هو حرف صورة ومعني : ( بما نسبوا يوم الحساب ) اي عاملوه معاملة المنسي بعضهم بالانكار وبعضهم بخبث الاعمال ، فانهم لو ذكروه حقيقة لما تابعوا الهوي المقتضي للضلال علي انه مما لا يجهله من له ادني مسكة من عقل فانه لا يخطر في عقل عاقل اصلا ان اقل الناس واجهلهم يرسل احدا الي مزرعة له يعملها ، ثم لا يحاسبه عليها فكيف اذا كان حكيما فكيف اذا كان ملكا فكيف وهو ملك الملوك ، وقال الغزالي في اخر كتاب العلم من الاحياء في الكلام علي العقل : ثم لما كان الايمان مركوزا في النفوس بالفطرة انقسم الناس الي من اعرض فنسي ، وهم الكفار ، والي من جال فكره فتذكر ، وكان كمن حمل شهادة فنسيها بغفلة ثم تذكرها ، ولذلك قال تعالي ) لعلهم يتذكرون ( ) وليتذكر اولوا الالباب ( ) ) واذكروا نعمة الله عليكم وميثاقه الذي واثقكم به ( ) [ الماءدة :  ] ) ) ولقد يسرنا القران للذكر فهل من مدكر ( ) [ القمر :  ] وتسمية هذا النمط تذكرا ليس ببعيد ، وكان التذكر ضربان : احدهما ان يذكر صورة كانت حاضرة الوجود في قلبه ، لكن غابت بعد الوجود ، والاخر ان يكون عن صورة كانت متضمنة فيه الفطرة ، وهذه حقاءق ظاهرة لناظر بنور البصيرة صقيلة علي من يستروح المعني : اصبر علي ما يقولون الان ، فلننصرك فيما ياتي من الزمان ، ولنءيدنك كما ايدنا داود العظيم الشان .
