 ولما كان من الحق الواضح كالشمس ان ما قالوه لا يقوله عاقل ، وكان التقدير : فقد اظلهم الله اهانة لهم وهداك اكراما لك ، بين انه سبحانه قسرهم علي ذلك ليكون اضلاله لهم اية كما ان هداه اية ، فقال مخففا عنه ( صلي الله عليه وسلم ) في اذهاب نفسه عليهم حسرات دامغا للقدرية : ( ومن يضلل الله ) اي الذي له الامر كله فلا يرد امره ) فما له ( لاجل انه هو الذي اضله ) من هاد ) اي فخفض من حزنك عليهم ) ومن يهد الله ) اي الذي لا يعجزه شء ابدا ) فما له من مضل ( فهو سبحانه يهدي من شاء منهم ان اراد .
 ولما لم تبق شبهة ولا شء من شك ان الهادي المضل انما هو الله وحده وانه جعل شيءا واحدا سببا لضلال قوم ليكون ضلالهم في الظاهر علة للنقمة ، وهدي لاخرين فيكون هداهم سببا للنعمة ، بلغ النهاية في الحسن قوله : ( اليس الله ) اي الذي بيده كل شء ) بعزيز ) اي غالب لما يريد في اضلاله قوما يدعون انهم النهاية في كمال العقول لما هدي به غيرهم ) ذي انتقام ) اي له هذا الوصف ، فمن اراد النقمة منه سلط عليه ما يريد مما يحزنه ويذله كما انه اذا اراد يعميه عن انور النور ويضله .

 صفحة رقم 
 الزمر : (    ) ولءن سالتهم من. .. . .
 ) ولءن سالتهم من خلق السماوات والارض ليقولن الله قل افرايتم ما تدعون من دون الله ان ارادني الله بضر هل هن كاشفات ضره او ارادني برحمة هل هن ممسكات رحمته قل حسبي الله عليه يتوكل المتوكلون قل يقوم اعملوا علي مكانتكم اني عامل فسوف تعلمون من ياتيه عذاب يخزيه ويحل عليه عذاب مقيم انا انزلنا عليك الكتاب للناس بالحق فمن اهتدي فلنفسه ومن ضل فانما يضل عليها وما انت عليهم بوكيل ( ( )
 ولما علم بهذه البراهين انه سبحانه المتصرف في المعاني بتصرفه في القلوب بالهداية والاضلال ، وكان التقدير : فلءن قررتم بهذا الاستفهام الانكاري ليقولن : بلي عطف عليه بيان ان الخالق للذات كما انه المالك للمعاني والصفات ، فقال مفسدا لدينهم باعترافهم باصلين : القدرة التامة له والعجز الكامل لمعبوداتهم : ( ولءن سالتهم ) اي فقلت لمن شءت منهم فرادي او مجتمعين : ( من خلق السماوات ) اي علي ما لها من الاتساع والعظمة والارتفاع ) والارض ( علي ما لها من العجاءب وفيها من الانتفاع ) ليقولن ( بعد تخوفيهم لك بشركاءهم الذين هم من جملة خلق من ارسلك بما انت فيه : الذي خلقها ) الله ) اي وحده الذي لا سمي له والباس بوجه في امره ، ولا ي يصدهم عن ذلك الحياء من التناقض ولا الخوف من التهافت بالتعارض .
 ولما كان هذا مخيرا لان بين ولا بد انهم لا يقبلون ولا يعرضون كان كانه قيل : فماذا اصنع ؟ فقال : ( قل ( مسببا من اعترافهم له سبحانه بجميع التعبير عنها سابقا باداة الذكور العقلاء بيانا لغلطهم ، فقال معبرا عن مفعول ) رايت ( الاول والثاني جملة الاستفهام ، ) ما تدعون ) اي دعاء عبادة ، وقرر بعدهم عن التخويف بهد بادعاء الهيتهم بقوله : ( من دون الله ) اي الذي هو ذو الجلال والاكرام فلا شء الا وهو من دونه وتحت قهره ، ولما كانت العافية اكثر من البلوي ، اشار اليها باداة الشك ونبه علي مزيد عظمته سبحانه باعادة الاسم الاعظم فقال : ( ان ارادني الله ) اي الذي لا راد لامره ولما كان درا المفاسد مقدما قال : ( بضر ) اي ان اطعتكم في الجنوح اليها خوفا منها ، وبالغ في تنبيههم نصحا لهم ليرجعوا عن ظاهر غيهم بما ذكر من دناءتها وسفولها بالتانيث بعد سفولها بعدم العقل مع دناءتها وبعد التهكم بهم بالتعبير عنها باداة الذكور العقلاء  صفحة رقم 
 فقال : ( هل هن ) اي هذه الاوثان التي تعبدونها ) كاشفات ) اي عني مع اعترافكم بانه لا خلق لها وانها مخلوقة لله تعالي ) ضره ) اي الذي اصابني به نوعا من الكشف ، لارجوها في وقت شدتي ) او ارادني برحمة ( لطاعتي اياه في توحيده ، وخلع ما سواه من عبيده ) هل هن ممسكات ) اي عني ) رحمته ) اي لاجل عصياني لهن نوع امساك ، لاطيعكم في الخوف منهن  هذه قراءة ابي عمرو بالتنوين واعمال اسم الفاعل بنصب ما بعده ، وهو الاصل في اسم الفاعل ، والباقون بالاضافة ، ولا فاءدة غير التخفيف ، وقد يتخيل منها ان الاوثان مختصة بهذا المعني معروفة .
 ولما كان من المعلوم انهم يسكتون عند هذا السءال لما يعلمون من لزوم التناقض ان اجابوا بالباطل ، ومن بطلان دينهم ان اجابوا بالحق ، وكان الجواب قطعا عن هذا : لا سوء نطقوا او اسكتوا ، تحرر انه لا متصرف بوجه الا الله ، فكانت النتيجة قوله : ( قل ( اذا القمتهم الحجر : ( حسبي ) اي كافي ) الله ( الذي افردته بالعبادة لانه له الامر كله مما يخوفونني به ومن غيره ) عليه ( وحده لان له الكمال كله ) يتوكل المتوكلين ) اي الذين يريدون ان يعلو امرهم كل امر ، وامره بالقول اعلاما بان حالهم عند هذا السءال التناقض الظاهر جدا .
 ولما كانوا مع هذه الحجج القاطعة ، والادلة القامعة والبراهين الساطعة ، التي لا دافع له بوجه ، كالبهاءم لا يبصرون الا الجزءيات حال وقوعها ، قال مهددا مع القيام بما يحاولونه ) قل يا قوم ) اي افعلوا افعالا مبينة علي العلم ) علي مكانتكم ) اي حالتكم التي ترتبتم فيها وجمدتم عليها لانه جبلة لكم من الكون والمكنة لتبصروا حقاءق الامور ، فتنتقلوا عن احوالكم السافلة الي المنازل العالية ، فكانه يشير الي انهم كالحيوانات العجم ، لا اختيار لهم ويعرض بالعمل الذي مبناه العلم والمكانة التي محطها الجمود بان افعالهم ليس فيها ما ينبني علي العلم ، وانما هي جزاف لا اعتبار لها ولا وزن لها .
 ثم اجاب من عساه ان يقول له منهم : فماذا تعمل انت ؟ بقوله : ( اني عامل ( علي كفاية الله لي ، ليس لي نظر الي سواه ، ولا اخشي غيره ، وليس لي مكانة التزم الجمود عليها ، بل انا واقف علي ما يرد من عند الله ، ان نقلني انتقلت وان امرني بغير ذلك امتثلت وانا مرتقب كل وقت للزيادة ، ثم سبب عن قول من لعله يقول منهم : وماذا عساه يكون قوله ؟ ايذانا بانه علي ثقة من امره ، لان المخبر له به الله : ( فسوف تعملون ) اي بوعد لا خلف فيه ) من ياتيه ) اي منا ومنكم ) عذاب يخزيه ( بان يزيل عنه كل شء يمكنه ان يستعذبه ) ويحل عليه ) اي بجب في قوته ، من حل  صفحة رقم 
 عليه الحق يحل بالكسر اي وجب ، والدين : صار حالا بحضور اجله ) عذاب مقيم ( لاقامته علي حالته وجموده علي ضلالته ، ومن يءتيه الله انتصارا يعليه وينقله الي نعيم عظيم ، لانتقاله بارتقاءه في مدارج الكمال ، باوامر ذي الجلال والجمال ، ولقد علموا ذلك في قصة المستهزءين ثم في وقعة بدر فان من اهلكه الله منهم جعل اهلاكه اول عذابه ونقله به غلي عذاب البرزخ ثم عذاب النار ، فلا انفكاك له من العذاب ، ولا رجاء لحسن الماب .
 ولما تجلت عراءس هذه المعاني اخذة بالالباب ، ولمعت سيوف تلك المباني من المثاني قاطعة الرقاب ، وختمها بما ختم من صادع الارهاب ، انتجت ولا بد قوله معللا لايتان ما توعدهم به مءكدا لما لهم من الانكار لمضمون هذا الاخبار : ( انا انزلنا ) اي بما لنا من باهر العظمة ونافذ الكلمة .
 ولما كان توسط بعد ان اثبت وساطته اول السورة فقال مقرونا بالامر بالعبادة اشارة الي بداية الحال ، فلما حصل التمكن فصار الكتاب خلقا له ( صلي الله عليه وسلم ) وصار ظهوره فيه هاديا لغيره ، نبه علي ذلك باداة الاستعلاء فقال : ( عليك ) اي خاصة لا علي غيرك من اهل هذا الزمان ، لانك عندنا الخالص لنا دون اهل القريتين ودون اهل الارض كلهم ، لم يكن لشء دوننا فيك حظ ) الكتاب ( الجامع لكل خير لكونه في غاية الكمال بما دل عليه ( ال ) ) الناس ( عامة لان رسالتك عامة ) بالحق ( مصاحبا له ، لا يقدر الخلق علي ان يزيحوا معني من معانيه عن قصده ، ولا لفظا من الفاظه عن سبيله وحده ، بل هو معجز في معانيه  حاضرة كانت او غاءبه  ونظومه ، والفاظه واسماء واياته وجميع رسومه ، فلا بد من ايتان ما فيه من وعد ووعيد .
 ولما تسبب عن علم ذلك وجوب المبادرة الي الاذعان له لفوز الدارين ، حسن جدا قوله تعالي تسلية له ( صلي الله عليه وسلم ) لعظيم ما له من الشفقة عليهم وتهديدا لهم : ( فمن اهتدي ) اي طاوع الهادي ) فلنفسه ) اي فاهتداءه خاص نفعه بها ليس له فيه الا اجر التسبب ) ومن ضل ) اي وقع منه ضلال بمخالفته لداعي الفطرة ثم داعي الرسالة عن علم معتمد ، او اهمال للنظر وتهاون .
 ولما كان ربما وقع في وهم انه يحلق الداعي بعد البيان ومن اثم الضال ، وكان السياق لتهديد الضالين .
 زاد في التاكيد فقال : ( فانما يضل عليها ) اي ليس عليك بشء من ضلاله ، فلا تذهب نفسك عليهم حسرات .
 ولما هدي السياق الي ان التقدير : فما انت عليهم بجبار لتقهرهم علي الهدء ، عطف عليه قوله : ( وما انت ) اي في هذا الحال ، ولمزيد العناية بنفي القهر اداة  صفحة رقم 
 الاستعلاء فقال : ( عليهم بوكيل ( لتحفظهم عن الضلال ، فان الرسالة اليهم لاقامة الحجة لا لقدرة الرسول علي هدايتهم ولا لعجز المرسل عن ذلك .
 الزمر : (    ) الله يتوفي الانفس. .. . .
 ) الله يتوفي الانفس حين موتها والتي لم تمت في منامها فيمسك التي قضي عليها الموت ويرسل الاخري الي اجل مسمي ان في ذلك لايات لقوم يتفكرون ام اتخذوا من دون الله شفعاء قل اولو كانوا لا يملكون شيءا ولا يعقلون قل لله الشفاعة جميعا له ملك السماوات والارض ثم اليه ترجعون ( ( )
 ولما كان الوكيل في الشء لا تصلح وكالته فيه الا ان كان قادرا عليه بطريق من الطرق ، وكان حفظهم علي الهدي وعن الضلال لا يكون عليه الا لحاضر لا يغيب ولا يعتريه نوم ولا يطرقه موت ، ولم تصح وكالة احد من الخلق فيه ، وكان كانه قيل : لانه لو وكل اليك امرهم لضاعوا عند نومك وموتك ، فدل عليه بما ادي معناه وزاد عليه من الفواءد ما يعرف بالتامل من تشبيه الهداية بالحياة واليقظة والضلال بالموت والنوم ، فكما انه لا يقدر علي الاماتة والانامة الا الله فكذلك لا يقدر علي الهداية والاضلال الا الله ، فمن عرف هذه الدقيقة عرف سر الله في القدرة ، ومن عرف السر فيه هانت عليه المصاءب ، فهي تسلية له ( صلي الله عليه وسلم ) ، لفت القول الي التعبير بالاسم الاعظم لاقتضاء الحال له ، واسند التوفي اليه سبحانه لانه في بيان انه لا يصلح للوكالة غيره اصلا ، فقال : ( الله ) اي الذي له مجامع الكمال ، وليس لشاءبة نقص اليه سبيل ) يتوفي الانفس ( التي ماتت عند انقضاء اجالها ، اي يفعل في وفاتها فعل من يجتهد في ذلك بان يقبضها وافية لا يدع شيءا منها في شء من الجسد ، وعبر عن جمع الكثرة بجمع القلة اشارة الي انها وان تجاوزت الحصر فهي كنفس واحدة ، ولعله لم يوحده لءلا يظن ان الوحدة علي حقيقتها ) حين موتها ) اي منعها من التصرف في اجسادها في هذه الحياة الدنيا كاءنة في مماتها محبوسة فيه مظروفة له ، وعطف علي الانفس قوله : ( والتي ) اي ويتوفي الانفس التي ) لم تمت ( لانها لم تنقص اجالها حين نومها كاءنة ) في منامها ( بمنعها من التصرف بالحس والادراك ما دام النوم موجودا مظروفة له لا شء منها في الجسد علي حال اليقظة ، فالجانع بينهما عدم الادراك والشعور والتصرف ، ولو قيل : بموتها وبمنامها ، لم يفد ان كلص من الموت والوفاة اية مغايرة للاخري .
 ولما كان النوم منقضيا ، دلنا بقرانه بالموت علي ان الموت ايضا منقض ، ولا بد لان الفاعل لكل منهما واحد ، فسبب عن ذلك قوله : ( فيمسك ) اي فيتسبب عن  صفحة رقم 
 الوفاتين انه يمسك عنده ) التي قضي ) اي ختم وحكم وبت بتا مقدرا مفروغا منه ، وقراءة البناء للمفعول موضحة لهذا المعني بزيادة اليسر والسهولة ) عليها الموت ( مظروفة لمماتها ، لا تقدر علي تصريف جسدها ما دام الموت محيطا بها كما ان الناءمة كذلك ما دام النوم محيطا بها ) ويرسل الاخري ) اي التي اخر موتها ، وجعلها مظروفة للمنام لانها لم ينقض اجلها الذي ضربه لها بان ينفي بالمنام فيوقظها لتصريف ابدانها ، ويجعل ذلك الامساك للميتة ، والارسال للناءمة ) الي اجل مسمي ( لبعث الميتة ولموت الناءمة ، لا يعلمه غيره ، فاذا جاء ذلك الاجل امات الناءمة وبعث الميتة ، وقد ظهر من التقدير الذي هدي اليه قطعا السياق ان النفس التي تنام هي التي تموت وهي الروح ، قال ابن الصلاح في فتاويه : وهو الاشبه بظاهر الكتاب والسنة  انتهي .
 روي الطبراني في الاوسط  قال الهيثمي : ورجاله رجال الصحيح  عن ابن عباس رضي الله الله عنهما قال : تلتقي ارواح الاحياء والاموات ، فيتسالون بينهم ، فيمسك الله ارواح الموتي ويرسل ارواح الاحياء الي اجسادها .
 وروي البخاري عن ابي هريرة رضي الله عنه ان النبي ( صلي الله عليه وسلم ) قال ( اذا اوي احدكم الي فراشه فليقل ) باسمك ربي وضعت جنبي اللهم ان امسكت نفسي فارحمها وان ارسلتها فاحفظها بما تحفظ به عبادك الصالحين ( وظهر ايضا ان الاية من الاحتباك : ذكر الحين اولا دليلا علي تقدير مثله في النوم ثابتا ، والمنام ثانيا دليلا علي حذف الممات اولا .
 ولما تم هذا علي الاسلوب الرفيع ، والنظم المنيع ، نبه علي عظمته وما فيه من الاسرار بقوله مءكدا قرعا بمن يرميه بالاساطير وغيرها من الاباطيل : ( ان في ذلك ) اي الامر العظيم من الوفاة والنوم علي هذه الكيفية والعبارة عنه علي هذا الوجه ) لايات ) اي علي انه لا يقدر علي الاحياء والحفظ غيره ، وانه قادر علي البعث وغيره من كل ما يريده ) لقوم ) اي ذوي قوة في مزاولة الامور .
 ولما كان هذا الامر لا يحتاج الي غير تجريد النفس من الشواغل والتدبر قال : ( يتفكرون ) اي في عظمة هذا التدبير ليعلم به عظمة الله ، وذلك ان النفس جوهر روحاني له في التعلق بالبدن ثلاث حالات : احداهما ان يقع ضوء النفس علي البدن ظاهرا وباطنا ، وذلك هو الحياة مع اليقظة ، وثانيتها انقطاع ضوء النفس عن البدن ظاهرا لا باطنا ، وذلك بالنوم ، وثالثها انقطاع ذلك ظاهرا وباطنا وهو بالموت ، فالموت والنوم من جنس واحد الا ان الموت انقطاع تام ، والنوم انقطاع ناقص ، فلا يقدر علي ايجاد شء واحد علي نوعين ، ثم  صفحة رقم 
 يجعلهما في شء واحد علي التعاقب ويفصل كلا منهما من الاخر الا هو سبحانه ، وكلما قدر علي انهاء الموتة الصغري بحد جعله لها فهو قادر علي انهاء الكبري بمثل ذلك .
