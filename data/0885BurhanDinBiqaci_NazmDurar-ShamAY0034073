 ولما رموه بهذه الاقوال التي هم فيها في خبط عشواء ، وكانت مع مونها ظاهرة العوار ، عند ن له ادني ااستبصار ، تروج علي بعض العرب بعض الرواج ، مع سعة عقولهم ، وصحة افكارهم ، لشبه واهية مكنهم فيها التقليد ، وشدة الالف لما هم عليه من الزمن المديد ، امره سبحانه بجوابهم مستانفا فقال : ( قل ) اي دالا علي بطلان ما قالوه مهددا لهم : ( انزله ) اي القران من خزاءن علمه خلافا لجميع ما تقولتموه ) الذي يعلم السر ) اي كله ، لا يخفي عليه منه خافية فكيف بالجهر ) في السماوات والارض ( فهو يجيبكم عن كل ما تقولتموه في وفي كتابه وان اسررتموه ، ويبين جميع ما يحتاج اليه العباد في الدارين في كلام معجز لفظا ومعني علي وجه يتحقق كل ذي لب انه لا يقوله الا عالم بجميع المعلومات ، ولا يحيط بجميع المعلومات سواه ، وهذا ظاهر جدا من اخباره بالماضي بما يصدقه العلماء من الماضين ، وحكمه علي الاتي بما يكون ضربة لازم ، واظهاره الخبء واحكامه لجميع ما يقوله ، وقد جرت عادته سبحانه وتعالي بالانتقام ممن كذب عليه باظهار كذبه اولا ، ثم باخذه ثانيا ، ثم عذابه العذاب الاكبر ثالثا ، فستنظرون من يفعل به ذلك ، وقد بان لعمري صدقه لما وقع منالامور الثلاثة .
 ولما كان من المعلوم ان العالم بكل شء قادر علي شء كما مضي تقريره في سورة طه ، وكانت العادة جارية بان من علم استخفاف غيره به وكان قادرا عليه عاجله بالاخذ ، اجيب من كانه قال : فما له لا يهلك المكذبين له ؟ بقوله مرغبا لهم في التوبة ، مشيرا غليقدرته بالستر والانعام ، ومبينا لفاءدة انزاله اليهم هذا الذكر من الرجوع عما تمادت عليه ازمانهم من الكفر وانواع المعاصي : ( انه كان ( ازلا وابدا ) غفورا ( اي بليغ الستر لما يريد من ذنوب عباده ، بان لا يعاتبهم عليها ولا يءاخذهم بها ) رحيما ( بهم في الانعام عليهم بعد خلقهم ، برزقهم وتركيب العقول فيهم ، ونصب الادلة لهم ، وارسال الرسل وانزال الكتب فيهم ، وامهالهم في تكذيبهم ، اي فليس لامهالهم ووعظهم بما نزله اليهم سبب الا رحمته وغفرانه وعلمه بان كتابه صلاح لاحوالهم في الدارين .
 ولما اتم سبحانه ما اراد من ذكر المنزل والمنزل ، واخبر عن طعنهم في المنزل الذي هو المقصود بالذات من الرسالة ، واقام تعالي ذلك الدليل علي كذبهم ، اتبعه الاخبار عن طعنهم في الرسول الاتي به ، فقال معجبا عقولهم التي يعدونها اصفي العقول افكارا ، واعلاها اثارا ، فيما ابدوه من ذلك مما ظنوا انه دليل علي عدم الرسالة ، ولا شء منه يصلح ان يكون شبهة لذي مسكة من امره ، فضلا عن ان يكون دليلا : ( وقالوا ) اي مستفهمين تهكما بوصفه ، قادحين فيه بفعله ، قول من هو علي ثقة من ان  صفحة رقم 
 وصف الرسالة ينافيه : ( مال هذا ( والاشارة علي هذا الوجه تفهم الاستهانة والتصغير ؛ ثم اظهروا السخرية بقولهم : ( الرسول ) اي الذي يزعم انه انفرد عن بقية البشر في هذا الزمان بهذا الوصف العالي ) ياكل الطعام ) اي مثل ما ناكل ) ويمشي في الاسواق ) اي التي هي مطالب الدنيا ، كما نمشي .
 ولما كانت ترجمة ما مضي : ما له مثلنا وهو يدعي الاختصاص عنا بالرسالة ؟ اتبعوه التعنيف علي عدم كونه علي واحد من وجوه مغايرة علي سبيل التنزل جوابا لمن كانه قال : فماذا يفعل ؟ بقولهم : ( لولا ) اي هلا ، وهي تاتي للتوبيخ ، وهو مرادهم ) انزل ) اي من السماء ، من اي منزل كان ، منتهيا ) اليه ) اي علي الهيءة التي هو عليها في السماء ) ملك ) اي من الملاءكة الله علي هيءاتهم المباينة لهيءات الادميين ) فيكون ( بالنصب جوابا للتحضيض ذلك الملك وان كان هو انسانا ) معه نذيرا ( فيكون ممتازا بحال ليس لواحد منا ، ليكون اهيب في النذارة ، لما له من الهيبة والقوة ، وكانهم عبروا بالماضي اعلاما بان مرادهم كونه ي الظهور لهم علي غير الهيءة التي يخبركم بها من تجدد نزول الملك عليه في كل حين مستسرا بحيث لا ينظره غيره ، او لان الملك يمكن ان يكون علي حالة المصاحبة له للنذارة ، وانما لا يتحول عنها بصعود الي السماء ولا غيره ، بخلاف الكنز فانه للنفقة ، فان لم يتعهد كل وقت نفد ، زهذا سر التعبير ب ( الي ) دون ( علي ) التي هي للتغشي بالوحي ، ولذلك عبروا بالمضارع في قولهم ، متنزلين عن علو تلك الدرجة : ( او يلقي ) اي من اي ملق كان .
 ولما كان الالقاء دالا علي العلو ، عدلوا عن اداة الاستعلاء التي تقدم التعبير بها في هود عليه السلام من الانزال الي حرف النهاية فقالوا : ( اليه ) اي ان لم تكن له تلك الحالة ) كنز ) اي يوجد له هذا الامر ويتجدد له القاءه غير مكترث ولا معبوء به ، برفعه عن مماثلتنا العامة من كل وجه ، وايضا التعبير في هذا الذي بعده بالمضارع ادل علي تكالبهم علي الدنيا وانها اكبر همهم .
 ثم تنزلوا ايضا في قولهم : ( او تكون له ) اي ان لم تكن له شء مما مضي ) جنة ) اي بستان او حديقة كما لبعض اكابرنا ) ياكل منها ( فتفرغه عما يتعاطاه في بعض الاحايين من طلب المعاش ، ويكون غناه اعز له واجلب للخواطر اليه ، واحث لعكوف الاتباع عليه ، واجع فيما يريده  هذا علي قراءة الجماعة بالياء التحتية ، وعلي قراءة حمزة والكساءي بالنون يكون المعني : انا اذا امكنا منها ، كان ذلك اجلب لنا الي اتباعه ، وما قالوه كله فاسد اذ لم يدع هو ( صلي الله عليه وسلم ) ولا احد من اتباعه انه هو ولا احد من الانبياء قبله يباين البشر ، ولا ان وصفا من اوصاف البشر الذاتية ينافي النبوة والرساله ، واما الاستكثار من الدنيا فهو عاءق في الاغلب عن السفر الي دار  صفحة رقم 
 الكرامة ، ومطن السلامة ، وحامل علي التجبر ، ولا يفرح به الا ادنياء الهمم ، وخفة ذات اليد لا تقدح الا في ناقص يسال الناس تصريحا او تلويحا ارادة لتكميل نقصه بالحطام الفاني ، وقد شرف الله نبيه ( صلي الله عليه وسلم ) عن ذلك بما له من صفات الكمال ، والاخلاق العوال .
 ولما كانوا بهذا واضعين الكلام في غير مواضعه ، بعيدين عن وجه الصواب ، قال معجبا من امرهم : ( وقال الظالمون ( فاظهر الوصف الموجب لهم ذلك : ( ان ) اي ما ) تتبعون ( ان اتبعتم ) الا رجلا مسحورا ) اي يتكلم بما لا يجديه ، فحاله لذلك حال من غلب علي عقله بالسحر ، او ساحرا صار السحر له طبعا ، فهو يفرق بما جاء به بين المرء وزوجه وولده ونحو ذلك ، وعبروا بصيغة المفعول اشارة الي هذا ، وهو انه لكثرة ما يقع منه من ذلك  صار كانه ينشا عنه علي غير اختياره .
 الفرقان : (    ) انظر كيف ضربوا. .. . .
 ) انظر كيف ضربوا لك الامثال فضلوا فلا يستطيعون سبيلا تبارك الذي ان شاء جعل لك خيرا من ذلك جنات تجري من تحتها الانهار ويجعل لك قصورا بل كذبوا بالساعة واعتدنا لمن كذب بالساعة سعيرا اذا راتهم من مكان بعيد سمعوا لها تغيظا وزفيرا واذا القوا منها مكانا ضيقا مقرنين دعوا هنالك ثبورا لا تدعوا اليوم ثبورا واحدا وادعوا ثبورا كثيرا ( ( )
 ولما اتم سبحانه ما ذكر من اقوالعهم الناشءة عن ضلالهم ، التفت سبحانه الي رسول ( صلي الله عليه وسلم ) مسليا له فقال : ( انظر ( ثم اشار الي التعجب منهم بان ما قالوه يستحق الاستفهام بقوله : ( كيف ضربوا ( وقدم ما به العناية فقال : ( لك الامثال ( فجعلوك تارة مثلهم في الاحتياج الي الغذاء ، وتارة نظيرهم في التوسل الي التوصل اليالارباح والفواءد ، بلطيف الحيلة وغريز العقل ، وتارة مغلوب العقل مختلط المزاج تاتي بما لا يرضي به عاقل ، وتارة ساحرا تاتي بما يعجز عنه قواهم ، وتحير فيه افكارهم ) فضلوا ) اي عن جميع طرق العدل ، وساءر انحاء البيان بسبب ذلك فلم يجدوا قولا يستقرون عليه وابعدوا جدا ) فلا يستطيعون ( في الحال ولا في المالن بسبب هذا الضلال ) سبيلا ) اي سلوك سبيل من السبل الموصلة غلي ما يستحق ان يقصد ، بل هم في مجاهل موحشة ، وفيافي مهلكة .
 ولما ثبت انه لا وجود لهم لانهم لا علم لهم ولا قدرة ، وانهم لا يمن لهم ولا بركة ، لا علي انفسهم ولا غيرهم ، اثيت لنفسه سبحانه ما يستحق من المال الذي يفيض به علي من يشاء من عباده ما يشاء فقال : ( تبارك ) اي ثبت ثباتا مقترنا باليمن  صفحة رقم 
 والبركة ، لا ثبات الا هو ) الذي ان شاء ( فانه لا مكره له ) جعل لك خيرا من ذلك ) اي الذي قالوه علي سبيل التهكم ؛ ثم ابدل منه قوله : ( جنات ( فضلا عن جنة واحدة ) تجري من تحتها الانهار ) اي تكون ارضها هيونا نابعة ، اي موضع اريد منه اجراء نهر جري ، فهي لا تزال ريا تغني صاحبها عن كل حاجة ولا تحوجه في استثمارها الي سقي .
 ولما كان القصر  وهو بيت المشيد  ليس مما يستمر فيه الجعل كالجنة التي هذه صفتها ، عبر فيه بالمضارع ايذانا بالتجديد كلما حصل خلل يقدح في مسمي القصر فقال : ( ويجعل لك قصورا ( اي بيوتا مشيدة تسكنها بما يليق بها من الحشم والخدم ، قال البغوي : والعرب تسمي كل بيت مشيد قصرا .
 وهذه العبارة الصالحة لان يجعل له سبحانه ذلك في الدنيا مما فتت في اعضادهم ، وخافوا غاءلتها فسهلت من قيادهم ، لعلهم بان مراسله قادر علي ما يريد ، بلكنه سبحانه اغناه عن ذلك يتاييده بالاعوان ، من الملاءكة والانس والجان ، حتي اضمحل امرهم ، وعيل صبرهم ، ولم يشا سبحانه ما اشار اليه في هذه الاية الشريفة في هذه الدنيا الفانية ، واخره الي الاخرة الباقية ، وقد عرض سبحانه عليه ما شاء من ذلك في الدنيا فاباه ، روي البغوي من طريق ابن المبارك ، والترميذي  وقالك حسن عن ابي امامة رضي الله عنه عن النبي ( صلي الله عليه وسلم ) قال : ( عرض علي ربي ان يجعل لي بطحاء مكة ذهبا ، فقلت : لا يا رب ولكن اشبع يوما واجوع يوما ، فاذا جعت تضرعت اليك ودعوتك ، واذا شبعت حمدتك وشكرتك ) وروي عن طريق ابي الشيخ عن عاءشة رضي الله عنها قالت : قال رسول الله ( صلي الله عليه وسلم ) : ( لو شءت لسارت معي الجبال الذهب جاءني ملك ان حجزته لتساوي الكعبة ) فقال : ان ربك يقرا عليك السلام ويقول لك : ان شءت نبيا عبدا وان شءت نبيا ملكا ، ( فنظرت الي جبريل عليه الصلاة والسلام فاشار الي ان ضع نفسك ، فقلت : نبياعبدا ) قال : فكان رسول الله ( صلي الله عليه وسلم ) بعد ذلك لا ياكل متكءا ويقول : ( اكل كما ياكل العبد ، واجلس كما يجلس العبد ) وسياتي في سورة سبا عند
  ( ) وارسلنا له عين القطر ( ) 
 [ سبا :  ] ما يتم هذا ، ولا يبعد عندي ان يكون اشير بالاية الشريفة  وان كانت في اسلوب الشرط غلي ما فتح عليه ( صلي الله عليه وسلم ) من الحداءق التي لم يكن مثلها في بلاد العرب لما فتح الله عليه خبير ووادي القري ، وتصرف في ذلك بنفسه الشريفة واكل منه والي ما فتح علي اصحابه من  صفحة رقم 
 بعده من بلاد فارس والروم ذات القصور والجنان التي لا مثل لها ولذلك عبر في الجنات بالماضي ، وفي القصور بالمضارع ، واتيحوا كنوز كسري بن هرمز ، فان اللاءق بمقام ا لملوك ان تكون اشارتهم اوسع من عباراتهم ، فاذا ذكروا شيءا ممكنا علي سبيل الفرض كان من ارادتهم ايجاده ، ويحبون ان يكتفي منهم بالايماء ، وان يعتمد علي تلويحهم اعظم مما يعتمد علي تصريح غيرهم ، وان يعد المفروض منهم بمنزلة المجزوم به من غيرهم ، والممكن في كلامهم كالواجب ، فما ظنك بملك الملوك القادر علي كل شء وهو قد صرف سبحانه الخطاب الي اعلي الناس فهما ، واغزرهم علما ، وقد اراه سبحانه ما يكون من ذلك من بعده في غزوة الخندق .
 روي البيهقي في دلال النبوة عن عمرو بن عوف المزني رضي الله عنه ان النبي ( صلي الله عليه وسلم ) لما خط الخندق ليحفره جعل علي كل عشرة اربعين ذراعا ، وكان سلمان الفارسي رضي الله عنه رجلا قويا ، فاختلف فيه المهاجرون والانصار ، فقال النبي ( صلي الله عليه وسلم ) : ( سلمان منا اهل البيت ) فخرجت لهم صخرة بيضاء مدورة ، قال عمرو : فكسرت حديدنا .
 وشقت علينا ، فقلنا : يا سلمان ارق الي رسول الله ( صلي الله عليه وسلم ) فاخبره خبر هذه الصخرة ، فاخبر فاخذ ( صلي الله عليه وسلم ) المعول من سلمان فضربها ثلاث ضربات صدع فيها في كل ضربة صدعا ، وكسرها في الثالثة ، وبرقت مع كل ضربة برقة اضاءت ما بين لابتي المدينة حتي لكان مصباحا في جوف بيت مظلم ، وكبر رسول الله ( صلي الله عليه وسلم ) مع كل برقة تكبيرة ، ثم اخذ بيد سلمان فرقي فساله سلمان للقوم : ( هل رايتم ما يقول سلمان ؟ ) قالوا : نعم يا رسول الله بابينا انت وامنا قد رايناك تضرب فيخرج برق كالموج فرايناك تكبر ، لانري شيءا غير ذلك ، فقال : ( اضاءت لي من البرقة الاولي قصور الحيرة ومداءن كسري كانها انياب الكلاب ، ومن الثانية القصور الحمر من ارض الروم كانها انياب الكلاب ، ومن الثالثة قصور صنعاء كانها انياب الكلاب ، واخبرني ، جبريل عليه الصلاة والسلام ان امتي ظاهرة عليها ) فاستبشر المسلمون وقالوا : الحمد لله موعود صادق بان وعدنا النصر بعد الحصر ، فطلعت الاحزاب فقال المسلمون
