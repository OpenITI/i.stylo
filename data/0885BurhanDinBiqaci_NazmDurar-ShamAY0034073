 ولما حصل الغرض من تصوير حالهم بهذا الفعل المضارع ، عطف عليه بصيغة المضي التي معناها الاستقبال اعلاما بتحقق الامر تحقق ما مضي وكان ، وتحققه مع القيام سواء من غير تخلف ولا تخلل زمان اصلا فقال : ( وقالوا ) اي كل من جمعه البعث من الكفرة معلمين بما انكشف لهم من انه لا ملازم لهم غير الويل : ( يا ويلنا ( اي يا من ليس لنا نديم غيره ) هذا يوم الدين ) اي الجزاء لكل عامل .
 ولما كان قولهم هذا انما هو للتحسر علي ما فاتهم من التصديق النافع به ، زادوا في ذلك بقولهم يخاطب بعضهم بعضا بدلا او وصفا بعد وصف دالين باعادة اسم الاشارة علي ما داخلهم من الهول : ( هذا يوم الفصل ) اي الذي يفصل فيه بين  صفحة رقم 
 الخصوم ، ثو زادوا تاسفا وتغمما وتلهفا بقولهم ، لافتين القول عن التكلم الي الخطاب لانه ادل علي ذم بعضهم لبعض عن الانصاف بالاعتراف : ( الذي كنتم ) اي يا دعاة الويل جبلة وطبعا ) به تكذبون ( وقدموا الجار اشارة الي عظيم تكذيبهم به ، فبينما هم في هذا التاسف اذ برز النداء بما يهدء قواهم ، ويقر قلوبهم وكلاهم ، لمن لا يعصون الله ما امرهم ويفعلون ما يءمرون من الملاءكة الشداد الغلاظ باذلالهم واصغارهم ، ولبيان السرعة لذلك من غير تنفيس اسقط ما يدل علي النداء من نحو قوله : فقيل الملاءكة ، او فقلنا ، او فبرز النداء من جانب سلطاننا  ونحو هذا : ( احشروا ) اي اجمعوا بكره وصغار وذل ايها الموكلون بالعباد من الاجناد ، واظهر تعريفا بوصفهم الموجب لحتفهم فقال : ( الذين ظلموا ) اي بما كانوا فيه في الدنيا بوضع الاشياء في غير محالها من الخبط الذي لا يفعله الا من هو في اشد الظلام ) وازواجهم ) اي اتباعهم ولو بشطر كلمة او رضي فعلهم لتصير كل طاءفة علي حدة فيصير بعضهم يبكت بعضا وبعضهم يشتم بعضا ) وما كانوا ( لاي بما دعتهم اليه طباعاتهم المعوجة ) يعبدون ) اي مواظبين علي عبادته رجاء منفعته تحقيقا لخسارتهم بتحقق اعتمادهم علي غير معتمد ، وهو يعم المعبود حقيقة او مجازا بالتزيين ) ومن سبقت له الحسني ( مستثني باية الانبياء ، واشار الي سفول رتبة معبوداتهم وتسفيه اراءهم بانتحال الاذي بقوله صارفا الاسلوب من المتكلم ولو بمظهر العظمة الي اعظم منه : ( من دون الله ) اي الذي تفرد بنعوت العظمة وصفات الكمال ، والمراد الذين رضوا بعبادتهم لهم ولم ينكروا عليهم ذلك ويامروهم بتوحيد الله .
 ولما كانوا قد سلكوا في الدنيا طريق الشقاء المعنوية استحقوا ان يلزموا في القيامة سلوك طريقة الحسية ، فلذلك سبب عن الامر بحشرهم قوله تهكما بهم وتحسيرا لهم : ( فاهدوهم ) اي دلوهم دلالة لا يرتابون معها ليعرفوا  مع ما هم فيه من الاكراه علي سلوكها  مالهم ، فيكون اعظم في نكدهم ؛ قال الرازي : واصل الهداية التقدم ، والعرب تسمي السابق هاديا ، يقال : اقبلت هوادي الخيل اي اعناقها ، والهادية : العصي  لانها تتقدم ممكسها ، ونظر فلان هدي امره اي جهته .
 ثم اشار الي طول وقوفهم وسوء مقامهم بقوله باداة الانتهاء : ( الي صراط الجحيم ) اي طريق النار الشديدة التوقد الواضح الذي لا لبس عندهم بانه يشترطهم فيءديهم اليها ، وخص هذا الاسم غعلاما بشديد توقدها وعظيم تاججها ، وبعد قعرها وضخامة غمرتها ، بتراكم بعضها فوق بعض وقوة اضطرامها ، وعلو شانها واصطلاحها ، وصلابة اضطرابها وتحرقها واشتمالها  صفحة رقم 
 علي داخليها وتضايقها ، وفيه تهكم بهم في كونهم علي غير ما كانوا عليه في الدنيا من التناصر والتعاضد .
 ولما كان المقصود من تعريفهم طريق النار اولا ازدياد الحسرة ، صرح بما افهمه حرف الغاية من طول الحبس فقال : ( وقفوهم ) اي احبسوهم واقفين بعد ترويعهم بتلك الهداية التي سببها الضلال ، فكانت ثمرتها الشقاوة ، وايقافهم يكون عند الصراط  نقله البغوي عن المفسرين ، قال : لان السءال عند الصراط .
 ثم علل ذلك بقوله : ( انهم مسءولون ( وجمع عليهم الهموم بهذه الكلمة لتذهب اوهامهم كل مذهب ، فلا تبقي حسرة الا حضرتهم ، ولا مصيبة الا علت قلوبهم فقهرتهم ، فان المكلف كله ضعف وعورة ، فموقف السءال عليه اعظم حسرة .
 ولما اوقفوا هذا الموقف الذليل ، قد شغلهم ما دهمهم من الاسف عن القال والقيل ، نودوا من مقام السطوة ، وحجاب الجبروت والعزة ، زيادة في تاسيفهم وتوبيخهم وتعنيفهم لفتا عن سياق الغيبة الي الخطاب دلالة علي اعظم خيبة : ( ما لكم ) اي اي شء حصل لكم فشغلكم والهاكم حال كونكم ) لا تناصرون ) اي ينصر بعضكم بعضا ، ويتسابقون في ذلك تسابق المتناظرين فيه اولي الجد والشكيمة والنخوة والحمية ولو بادني التناصر  بما يفهمه اسقاط التاء ، او بعد تمكث واعمال حلية  بما اشارت اليه قراءة البزي عن ابن كثير بالمد والادغام : اين قولكم في بدر ( نحن جميع منتصر ) معبرين بما دل علي ثبات المناصرة .
 ولما كان قد دهمهم من الامر ما اوجب ابلاسهم ، واحد ادراكهم واحساسهم ، اشار الي ذلك باحلالهم في محل الغيبة المءذنة بالابعاد بان قال مضربا عما تقديره : انهم لا يتناصرون : ( بل هم ( وزاد في تعظيم ذلك الوقت والتذكير به فقال : ( اليوم مستسلمون ) اي ثابت لهم استسلامهم ثباتا لا زوال له ، قد خذل بعضهم بعضا موجدين الاسلام اي الانقياد ايجاد من كانه يطلبه ويعظم فيه رغبته رجاء ان يخفف ذلك عنهم .
 ولما اخبر بانهم سءلوا فلم يجيبوا ، كان ربما ظن انهم اخرسوا فنبه علي انهم يتكلمون بما يزيد نكدهم ، فقال عاطفا علي قوله ) وقالوا يا ويلنا هذا يوم الدين ( اشارة الي اقبالهم علي الخصام ، حين تمام القيام ، والاخذ في تحريك الاقدام ، بالسير علي هيءة الاجتماع والازحام ، الي مواطن النكد والاغتنام ، ولم يعطفه بالفاء لانه ليس مسببا عن القيام ، ولا عن الايقاف للسءال ، بخلاف ما ياتي عن اهل الجنة : ( واقبل بعضهم (  صفحة رقم 
 اي الذين ظلموا ) علي بعض ) اي بعد ايافهم وتوبيخهم ، وعبر عن خصامهم تهكما بهم بقوله : ( يستاءلون ) اي سءال خصومة .
 ولما كان كانه قيل : عما ذا ؟ اجيب بقوله : ( قالوا ) اي الاتباع لرءساءهم مشرين باداة الكون الي المداومة علي اضلالهم مءكدين لاجل تكذيب الرءساء لهم : ( انكم كنتم ( ولما كانوا يستغوونهم ويغرونهم بما تقبله عقولهم علي ما جرت به عواءدهم بحيث يقطعون بذلك قطع من كان يريد الذهاب الي امر فتطير بالسانح والبارح ، فراي ما يحب فاقدم عليه وهو قاطع بحصوله ، اشاروا الي ذلك بقوله : ( تاتوننا ( مجاوزين لنا ) عن اليمين ) اي عن القوة والقهر والغلبة والسلطان في حملكم لنا علي الضلال ، ففعلنا في طاعتكم فعل من خرج لحاجة ، فراي ما اوجب اقدامه عيلها ، فهذا كان سبب كفرنا ، وكان هذا التفاءل مما نسيت العرب كيفيته لما نسخه الشرع كما وقع في الميسر فاضطرب كلام اهل اللغة في تفسيره ، قال صاحب القاموس : البارح من الصيد ما مر من ميامنك الي مياسرك ، وسنح الظبي سنوحا ضد برح .
 وقال ابن القطاع في كتاب الافعال : وسنح الشء سنوحا : تيسر ، والطاشر والظبي : جري عن يمينك الي يسارك وهو يتيمن به ، وقال في مادة ( برح ) : وبرح الطاءر والظبي وغيرهما ضد سنح ، وهو ما اراك ميامنه ، واهل الحجاز يتشاءمون به ، وغيرهم يتيمنون به ويتشاءمون بالسانح ، وقال ابن مكتوم في الجمع بين العباب والمحكم في مادة ( برح ) : والبارح خلاف السانح ، وقد برح الظبي  اذا والاك مياسره يمر من ميامنك الي مياسرك ، والعرب تختلف في عيافه وقيل ، السانح ما يجء عن يمينك فتلي مياسره مياسرك ، والعرب تختلف في عيافة ذلك ، فمنهم من يتيمن بالسانح ويتشاءم بالبارح ، وعلي هذا المثل : من لي بالسانح بعد البارح ، قال في القاموس : اي بالمبارك بعد المشءوم ، ومنهم من يتشاءم بالسانح ، وقال الامام ابو عبد الله القزاز في مادة ( سنح ) : والسانح من الطير والظباء وغيرهما هو الذي يلقاك وشماءله عن شماءلك ، وهو مما يتمين به اهل العالية ، ويتشاءمون بالسانح ، والسانح هو الذي يلقاك وميامنه عن ميامنك ، وهو مما يتيمن به اهل نجد ويتشاءمون بالبارح ، والبارح ابين في التشاءم من السانح ، لان البارح هو الذي ياخذ عن يسارك الي يمينك فلا يمكنك طعنه ، فيتشاءم به لتعذره علي الطاعن او الرامي ، ولذلك قال ابو  صفحة رقم 
 داود : قلت : لما برز امن فيه كذب العير وان كان برح ، يقول : كذب اذ طمع ان يجنو ، وان كان برح وصعب علي امكان طعنه ، وتطير ومن تيمن به بسلامته وخلاصة من الطاعن ، وتطير من تيمن بالسانح بانه ياتي من ميامنك الي مياسرك ، فيمكنك من طعنه ، ومن تشاءم به تطير بقلة سلامته ووقوعه فيما يكره ، ومن الطير الجابه وهو الذي يلقاك مواجهة ، ومنه الناطح ايضا ومنه القعيد ، وهو الذي ياتيك من خلفك  انتهي ما وقفت عليه من كلام اهل اللغة في ذلك فافهم ، والظاهر كما تفهمه الاية ان العرب مطبقة علي ان ما اتي عن اليمين كان مباركا سواء كان اتي من قدام مواجها لك ومر الي جهة الخلف فوليتك ميامته ، او اتي من الجانب الايمن سواء كان ابتداء ايتانه من خلف او لا فمر من قدامك عرضا الي جهة اليسار ، فوليتك في الحالتين مياسره ، وما اتي من جهة اليسار علي ضد ذلك كان مشءوما ، وكانهم اختلفوا في التسيمة فاكثرهم سمي الاول سانحا من السنح بالضم وهو اليمن والبركة ، وهو من قولهم : سنح لي راي : تيسر  لشهرة معني اليمن عندهم في ذلك ، والثاني بارحا من البرح ، وهو الشدة والشر لشهرة هذا المعني عندهم في مادة برح ، وبعهضم عكس فسمي الاول بارحا من البرحة ، وهي الناقة تكون من خيار الابل لشهرة ذلك عندهم ، وسمي الثاني سانحا من قولهم : سنحه عما اراد : صرفه ، وسنح بالرجل وعليه : اخرجه او اصابه بشر ، فمن الاختلاف في التسمية اتي الخلاف ، ولذلك عبر سبحانه وتعالي بالمعني دون الاسم ، لان كلامه سبحانه لا يخص قوما دون غيرهم ، واما التعليل بامكان الطعن والرمي فلا معني له لان الانسان ينفتل عن هيءة وقوفه بادني حركة فينعكس بالنسبة اليه امر المياسر والميامن ، ويتغير حال الطعن والرمي ، هذا اذا سلم ان الطعن والرمي يعسر من جهة المياسر علي انه غير مسلم ، ولو كان المعني داءرا عليه لما اختلف فيه الا بالنسبة الي الاعسر وغيره ، لا بالنسبة الي اهل العالية وغيرهم ، واما البيت الذي استدل به فيمكن حمله علي ان قاءله كان في حاجة له لا بد له منها ، فراي البارح فلم يتطير منه ولج في امره ذلك تكذيبا له فيما دل عليه عند العرب ، واما الجابه وغيره فاسماء اخر لبعض انواع كل من السانح والبارح  والله اعلم ، وقال ابو حاتم احمد بن حمدان الرازي في كتابه الزينة : العيافة والقيافة والزجر نوع من الكهانة من يعبد كما يعبد الصنم ، وكانوا سدنة الاصنام ، بمنزلة الحاكم ، وكان من الكهان من يعبد كما يعبد الصنم ، وكانوا سدنة الاصنام ، قلت : والكاهن في اللغة من يقضي بالغيب وذلك هو غاية العلم ، فهو وصف يدل علي التوغل في العلم  انتهي ، قال ابو حاتم : وسمعت بعض اهل الادب قال : الكاهن بالعبرانية العالم ، وكانوا يسمون هارون عليه السلام كهنا ربا ، معناه عالم الرب ، ثم  صفحة رقم 
 قال : ان الكهانة والسحر كان عند المتقدمين نوعا من العلم ، فكان الساحر والكاهن اسمين محمودين ، فلما جاء الله بالاسلام صار هذان الاسمان مذمومين عند المسلمين لما كشف لهم ما في ذلك من الشر ، ثم قال : فاما العاءف والقاءف والزاجر فلم يكن سبيلهم كذلك  يعني كالكاهن في انه ربما عبد ، قال : وانما كره لانه كان يخبر بشء غاءب فكره كما كره امر النجوم توقيا ان يكون مثل الدعوي في علم الغيب ، والعاءف هو الذي يعيف الطير ويزجرها ويعتبر باسماءها واصواتها ومساقطها ومجاريها ، فاذا سمع صوت طاءر او جري من يمينه الي شماله او من شماله الي يمينه قضي في ذلك بخير او بشر في الامر الذي يريد ان يفعله ، فاذا قضي فيه بشر تجنب ذلك الامر ، يقال : عاف يعيف  اذا فعل ذلك ، ومعني عاف اي امتنع وتجنب ، يقال : عافت الابل الماء  اذا لم تشرب ، وكذلك يقال في غير الابل الزاجر ايضا : هو مثل العاءف ، يقال : يزجر ايضا زجرا ، وذلك انه ينظر الي الطير فيقضي فيها مثل العاءف ، فاذا راي شيءا كرهه رجع عن امر يريد ان يشرع فيه او حاجة يريد قضاءها ، والزاجر معناه الناهي ، فكان الطير قد زجره عن ذلك الفعل ، او ان من عاف له زجره عن ذلك ، ويكون المعني الزجر ايضا انه اذا راي منها شيءا صاح بها وطردها ، فكان طرده اياها زجرا لها ، ومنه قوله ( صلي الله عليه وسلم ) : ( اقروا الطير علي مكانتها ) قلت : انهم كانوا اذا لم يروا سانحا ولا بارحا نفروا الطير لينظروا الي اي جهة تطير  والله اعلم ، وقال ابو حاتم : والاصل في هذا انهم كانوا يزجرون الطير ثم كانوا يزجرون الظبي والثعلب ، وبصوت الانسان يستدلون بلفظه وبغير ذلك ، ثم نسبت كلها الي الطير فقيل : يتطير ، اي يستدل بالطير ، وروي عن الاصعمي قال : سالت ابن عون : ما الفال ؟ فقال : هو ان تكون مريضا فتسمع : يا سالم ، وتكون باغيا فتسمع يا واجد ، قال : وكان ابن سيريت يكره الطيرة ويحب الفال ، وفي الحديث ( اصدق الطير الفال ) .
 والفال ماخوذ من الفيال ، وهي لعبة يتاقمرون بها ، كانوا ياخذون  صفحة رقم 
 الدراهم فيخلطونها بالتراب ثم يجمعونه طويلا ثم يقسمونه بنصفين ويتقارعون عليه ، فمن اصابه القرعة اختار من القسمين واحدا ، فلما كان المفايل يختار منهما ما احب سمي الفال ، لانه يتفاءل بما يحبه ، وكان هذا في العرب كثيرا ، واكثره في بني اسد ، قال الاصمعي : اخبرني سعد بن نصر ان نفرا ومن الجن تذاكروا عيافة بني اسد فاتوهم فقالوا : ضلت لنا ناقة ، فلو ارسلتم معنا من يعيف ، فقالوا لغليهم لهم : انطلق معهم ، فاستردفه احدهم ، ثم ساروا فلقيتهم عقاب كاسرة احدي جناحيها ، فاقشعر الغليم فبكي فقالوا له : ما لك ؟ فقال : كسرت جناحا ، ورفعت جناحا ، وحلفت بالله صراحا ، ما انت بانسي ولا تبغي لقاحا .
