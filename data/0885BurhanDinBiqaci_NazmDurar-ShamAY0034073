 ولما اخبر تعالي بعراقتهم في الفسق ، دل عليه بان خيانتهم ليست خاصة بالمخاطبين ، بل عامة لكل من اتصف بصفتهم من الايمان ، فمدار خيانتهم علي الوصف ، فقال : ( لايرقبون في مءمن الا ) اي قرابة واصلا خيدا ثابتا ) ولاذمة ) اي عهدا اكيدا ) واولءك ) اي البعداء من كل خير ) هم ) اي خاصة لتناهي عدوانهم ) المعتدون ) اي عادتهم المبالغة في حمل انفسهم علي ان يعدوا الحدود لعدم ما يردهم عن ذلك من وازع الهي ورادع شرعي كما فعل عامر بن الطفيل باهل بءر معونة مع انهم في جوار عمه وكان من خبرهم ان عمه ابا براء عامر بن مالك بن جعفر ملاعب الاسنة قدم علي رسول الله ( صلي الله عليه وسلم ) فقال له : لو بعثت رجالا من اصحابك الي اهل نجد رجوت ان يستجيبوا لك ، فقال رسول الله ( صلي الله عليه وسلم ) : اني اخشي عليهم اهل نجد ، قال ابوبراء : انا لهم جار .
 فبعث رسول اله ( صلي الله عليه وسلم ) : المنذر بن عمرو اخا بني ساعدة المعنق ليموت في سبعين رجلا من اصحاب من خيار المسلمين ، فما نزلوا بءر معونه بعثوا حرام بن ملحان بكتاب رسول الله ( صلي الله عليه وسلم ) الي عامر بن الطفيل فلم ينظر في كتابه وعدا عليه فقتله ، ثم استصرخ عليهم بني عامر فابوا وقالوا : لن نخفر اب براء ، فاستصرخ عليهم قباءل من بني سليم : عصية ورعلا وذكوان فقتلوهم فلم يفلتمنهم الا ثلاثة نفر عمرو بن امية الضمري احدهم ، فعظم ذلك النبي ( صلي الله عليه وسلم ) ودعا علي قتلتهم شهرا ؛ قال البغوي : وقال ابن عباس رضي الله عنهما : ان اهل الطاءف امدوهم  يعني قريشا  بالاموال ليقووهم علي حرب رسول الله ( صلي الله عليه وسلم ) ، فهذا الذي احكمه تعالي من نبذ العهد نظر للدين ، لانه نظر لجميع اهله الذين لا يوجد الا بهم .
 ولما بين ما اوجب بعدهم منهم ومعادتهم لهم ، بين ما يصيرون به اهلا فقال ) فان تابوا ) اي بالايمان بسبب ما ابديتم لهم من الغلطة ) واقاموا ) اي ايدوا ذلك بان اقاموا ) الصلاة ) اي بجميع حدودها ) واتواالزكاة ) اي كما حدة رسول الله ( صلي الله عليه وسلم ) ) فاخوانكم ( ايهم ، وبين انها ليست اخوة النسب فقال : ( في الدين ( لهم ما لكم وعليهم ما عليكم ، فلا تعرضوا لهم بما يكرهونه .
 ولما كان كانه قيل بعثا وتحريضا علي تامل ما فصل : قد فصلنا لكم امرهم في هذه الايات تفصيلا ، عطف عليه قوله : ( ونفصل ) اي في كلامر يحتاجون جميع ) الايات ( وعظم هذه الايات وحثم علي تدبرها بقوله : ( لقوم يعلمون ) اي صار العلم لهم صفة فلهم ملكة يتصرفون بها في اصوله وفروعه ، لا يغترون بمجرد كلام من شانه الرداءة والمخالفة بين القول والعمل ، والاعتراض بهذا بين هذه الجمل المتلاحمة  صفحة رقم 
 اشارة الي عظم الامر الذي نبه عليه وتحريض علي انعام النظر فيه ليعلم ان مدخوله جليل الامر عظيم القدر لءلا يظن انه تكرار ولما بين السبب الموجب لمجازاتهم بجنس عملهم ، وهو البراءة منهم وما يتبع ذلك الي ان ختم بتقدير توبتهم ، رجع الي قسم قوله ) فما استقاموا لكم ( فقال : ( وان نكثوا ايمانهم ) اي التي حلفوها لكم ؛ ولما كان النقض ضارا وغن قصر زمنه ، اتي بالجار فقال : ( من بعد عهدهم ) اي الذي عقدوه ) وطعنوا ) اي اوقعوا الطعن ) في دينكم ) اي بقول او فعل ولما كان هذا الفعل لا يستقل به في الاغلب الا الرءساء ، اشار الي ذلك بقوله : ( فقاتلوا ( ووضع موضع ضميرهم تحريضا علي قتالهم واشارة الي انهم ما نكثوا واقدموا علي هجنة الكذب ولم يستهجنوا الخروج عن عادات الكرام الا وقد رسخوا في الكفر فقال : ( اءمة الكفر ( ثم اشار  بقوله معللا لجواز المقاتله : ( انهم لا ايمان لهم ( الي ان ذلك ولو فعله الاتباع ولم يكفهم الرءساء فهو عن تمال منهم فابدءوا بالرءوس فاقطعوها تنقطع الاذناب ، وقراءة ابن عامر بالكسر معناها : لا امان لهم لانهم قد نقضوا العهد الموجب له بما وقع منهم ، ومن طعن من اهل الذمة في الاسلام طعنا ظاهرا جاز قتله ، فان العهد ماخوذ عليه ان لا يطعن ، ثم علل المقاتله بقوله : ( لعلهم ينتهون ) اي اجعلوا قصدكم لقتالهم ان يكون حالهم حال من ينتهي عن غيه بما يري منكم من صادق الجد بماضي الحد ، روي البخاري في التفسير عن حذيفة رضي الله عنه قال : ما بقي من اصحاب هذه الاية الا ثلاثة ولا من المنافقين الا اربعة احدهم شيخ كبير لو شرب الماء البارد لما وجد برده .
 ولما نفي ايمانهم بنفي ايمانهم ، شرع يقيم الدليل علي ذلك بامور ارتكبوها ، كل منها بسبب باعث علي الاقدام عليهم ، ويحث علي قتالهم في صورة تعجيب ممن يتواني فيه فقال : ( الا ( وهو حرف عرض ، ومعناه هنا الحض لدخول همزة الانكار علي النافي فنفته فصار مدخولها مثبتا علي سبيل الحث عليه فهو ابلغ مما لو اثبت بغير هذا الاسلوب ) تقاتلون قوما ) اي وان كانوا ذوي منعة عظيمة ) نكثوا ايمانهم ) اي في قصة عاصم واصحاب والمنذر واصحاب والاعانة علي خزاعة وغير ذلك ، فكان النكث لهم عادة وخلقا ، وهذا يدل علي ان قتال الناكثين اولي من قتال غيرهم ليكون ذلك زاجرا عن النقض ، وكانت قصة خزاعة انه كان كان بينهم وبين بني بكر بن عبد مناة بن كنانة قتل  صفحة رقم 
 في الجاهلية ، وكانت خزاعة قد دخلت في عهد النبي ( صلي الله عليه وسلم ) بالحديبة لما كان لهم فيه من المجبة من مسلمهم وكافرهم لما بينهم من الحلف  كما تقدم اخر الانفال ، ودخلت بنو بكر في عهد قريش فمرت علي ذلك مدة ، ثم ان انس بن زنيم الديلي هجا رسول الله ( صلي الله عليه وسلم ) فسمعه غلام من خزاعة فوقع به فشجه فخرج الي قومه فاراهم شجته فثار الشر مع ما كان بينهم ، وما تطلب بنو بكر من خزاعة من دماءها ، فكلمت بنو نفاثة من بني بكر اشراف قريش فوجدوا القوم الي ذلك سراعا فاعانوهم بالسلاح والكراع والرجال ، فخرج نوفل بن معاوية الديلي وهو يومءذ قاءدهم ؛ قال ابن اسحاق : وليس كل بني بكر بايعة  وقال الوافدي : اعتزلت بنو مدلج فلم ينقضوا العهد  حتي بيت خزاعة وهم علي الوتير ماء لهمن فاصبوا منهم رجلا وتجاوزوا واقتتلوا وقاتل معهم من قريش من قاتل بالليل مستخفا متنكرين منتقبين : صفوان بن امية ومكرز بن حفص بن الاحنف وحويطب بن عبد العزي وعكرمة بن ابي جهل واجلبوا معهم ارقابهم ، وكانت خزاعة امنة لمكان العهد والموادعة ولما ذكرهم بمطلق نكثهم في حقهم عامة ، وذكرهم بما خصوا به سيدهم بل سيد الخلق كلهم فقال : ( وهموا باخراج الرسول ) اي من مكة في عمرة القضاء ، بل امروه بالخروج عند انقضاء الثلاثة الايام والحو في ذلك وهو وان كان قاضاهم علي ذلك ، لكن قد نقل ابن اسحاق وغيره في قصة النداء بسورة براءة انه كان في القضية والعهد الذي كان بينه وبينهم ان لا يمنع من البيت احد جاءه زاءرا ، ولعلهم هموا باخراجه قبل الثلاثة الايام لما داخلهم من الحسد عند ما عاينوا من نشاط اصحابه وكثرتهم وحسن حالهم ، وذلك غير بعيد من افعالهم ، واظهارهم التبرء به ( صلي الله عليه وسلم ) حتي اجترءوا  وهو اعلي الخلق مقدارا ، واظهرهم هيءة وانوارا واطهرهم رسوما واثارا  علي الالحاح عليه في الخروج من بلد اباءه واجداده الذين هم احقهم بها ومسقط راسه وموضع مرباه ، ولكن لم اراه مصرحا به ، وهوعنمدي علي ما فيه اولي مما ذكروه من الهم باخراجه عند الهجرة علي ما لا يخفي ، او يكون المراد ما هم به ابن ابي المنافق ومن تابعه من اصحابه من اخراج النبي ( صلي الله عليه وسلم ) من المدينة حيث قال في غزوة المريسيع : لءن رجعنا الي المدينة ليخرجن الاعز منها الذل بعد اعطاءهم العهود علي الايواء والنصرة والاسلام ، وذلك لتذكير المءمنين بمسارعتهم الي النقض بعد ان اثبت انهم في الالتحام في كيد الاسلام كالجسد الواحد ، فكانه يقول : اذا ترك هءلاء ايمانهم فاولءك احري ان ينقضوا ايمانهم ، وهو بعث للمءمنين علي التبرء من الكافرين منافقين كانوا او مجاهرين مقاربين او مباعدين  صفحة رقم 
 ولما ذكرهم بالخيانة عامة وخاصة ، اتبعها ما حققها بالقتال فقال : ( وهم بدءوكم ( اي بتطابق من ضماءرهم وظواهرهم ) اول مرة ( اي بالقتال والصد في الحديبية بعد اخباركم اياهم بانكم لم تجيءوا للقتال وانكم ما جءتم الا زوارا للبيت الحرام الذي الناس فيه سواء وانتماحق به منهم ، وذلك اول بالنسبة الي هذا الثاني مثل قوله ) انكم رضيتم بالعقود اول مرة ( وقال بعض المفسرين : المراد باول مرة قتالهم خزاعة ، وهو واضح لانه بعد عقد الصلح ، وقيل : في بدر بعد ما سلمت عيرهم وقالوا : لا نرجع حتي نستاصل محمدا واصحابه ، وقيل : المراد به مطلق القتال لان النبي ( صلي الله عليه وسلم ) جاءهم بالكتاب المنير ودعاهم بغاية اللين ، وتحداهم به عند التكذيب ، فعدلوا عن ذلك الي القتال فهم البادء اظلم .
 ولما امرهم بالقتال وكان مكرها الي النفوس علي كل حال .
 شرع يبين الاسباب الحاملة علي التواني عن قتالهم ، وحصرها في في الخشية والعاطفة ، وقسم العاطفة الي ما سببه القرب في محاسن الافعال والي ما سببه القرب في النسب والصهر ، ونقض الكل وبين انه لا شء منها يصلح للسببية ، فقال بادءا بالخشية لانها السبب الاعظم في ترك المصادمة منكرا عليهم موبخا لهم ليكون ابلغ في الحث علي قتالهم منبها علي ان التواني عنهم مصحح للوصف بالجبن ورقة الدين : ( اتخشونهم ) اي اتخافون ان يظفرون بكم في القتال بان يكونوا علي باطلهم اشد منكم علي حقكم ) فالله ) اي الذي له مجامع العظمة ) احق ) اي منهم ) ان تخشوة ) اي بان يكون مخشيا لكم لما تعلمون من قدرته في اخذه لمن خالفه ولو بعد طول الاناة ) ان كنتم مءمنين ) اي فان من صدق بانه الواحد الذي تفرد بصفات العظمة لم ينظر الي غير هيبته ولما بكت في التواني عنهم ، وعدهم بما يزيل خشيتهم منهم ، بل يوجب اقدامهم عليهم ورغبتهم فيهم ، فقال مصرحا فيهم ، فقال مصرحا بما تضمنه الاستفهام الانكاري في ) الاتقاتلون ( من الامر : ( قاتلوهم ) اي الله لا لغرض غيره ) يعذبهم الله ) اي الذي انتم مءمنون بانه المتفرد بصفات الجلال والجمال ) بايديكم ) اي بان تقتلوهم وتاسروهم وتهزموهم ) ويخزهم ( اي بالذل في الدنيا والفضيحة والعذاب في الاخري .
 ولما كان ذلك قولا لا يقتضي النصر الذي هو علو العاقبة قال : ( وينصركم عليهم ( اي فترضوا ربكم بذلك لاذلالة من يعاديه بكم ؛ ولما كان نكالهم بما بعد ثباته علي لبعض المءمنين سرورا لهم فيه حظ ، بين تعالي انه لا يءثر في العمل بعد ثباته علي اساس افخلاص فقال : ( ويشف ) اي بذلك ) صدور قوم مءمنين ( اي راسخين في  صفحة رقم 
 الايمان ، اسلفوا اليهم مساوء اوجبت ضغاءن واحنا كخزاعة وغيرهم ممن اعانوا عليه او اساءوا اليه .
