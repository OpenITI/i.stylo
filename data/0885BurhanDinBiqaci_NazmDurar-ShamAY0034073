 ولما كان ما بعد العلقة من الاطوار المتصاعدة مسببا كل واحد منه عما قبله بتقدير العزيز العليم الذي اختص به من غير تراخ ، وليس تسببه من العادة التي يقدر عليها غيره سبحانه ، عبر بالفاء والخلق فقال : ( فخلقنا العلقة مضغة ) اي قطعة لحم صغيرة لا شكل فيها ولا تخطيط ) فخلقنا المضغة ( بتصفيتها وتصلبيها بما سببنا لها من الحرارة والامور اللطيفة الغامضة ) عظاما ( من راس ورجلين وما بينهما ) فكسونا ( بما لنا من قدرة الاختراع ، تلك ) العظام لحما ( بما ولدنا منها ترجيعا لحالها قبل كونها عظما ، فسترنا تلك العظام وقويناها وشددناها بالروابط والاعصاب .
 ولما كان التصوير ونفخ الروح من االجلالة بمكان اي مكان ، اشار اليه بقوله : ( ثم انشاناه ) اي هذا المحدث عنه بعظمتنا ) خلقا اخر ) اي عظيما جليلا متحركا ناطقا خصيما مبينا بعيدا من الطين جدا ؛ قال الرازي : واصل النون والشين والهمزة يدل علي ارتفاع شء وسموه .
 ولما كان هذا التفصيل لتطوير الانسان سببا لتعظيم الخالق : ( فتبارك ) اي ثبت ثباتا لم يثبته شء ، بان حاز جميع صفات الكمال ، وتنزه عن كل شاءبة نقص ، فكان قادرا علي كل شء ، ولو داناه شء من عجز لم يكن تام الثبات ، ولذلك قال : ( الله ( فعبر بالاسم العلم الجامع لجميع الاسماء الحسني ؛ واشار الي جمال الانسان بقوله : ( احسن الخالقين ) اي المقدرين ، اي قدر هذا الخلق العجيب هذا التقدير ، ثم طوره في اطواره ما بين طفل رضيع ، ومحتلم شديد ، وشاب نشيط ، وكهل عظيم ، وشيخ هرم  غلي ما بين ذلك من شءون لا يحيط بها الا اللطيف الخبير .
 ولما كانت اماتة ما صار هكذا  بعد القوة العظيمة والادراك التام  من الغراءب ، وكان وجودها فيه وتكرارها عليه في كل وقت قد صيرها امرا مالوفا ، وشيءا ظاهرا مكشوفا ، وكان عتو الانسان علي خالقه وتمرده ومخالفته لامره نسيانا لهذا المالوف كالانكار له ، اشار الي ذلك بقوله تعالي مسببا مبالغا في التاكيد : ( ثم انكم ( ولما كان من الممكن ليس له من ذاته الا العدم ، نزع الجار فقال : ( بعد ذلك ) اي الامر العظيم من الوصف بالحياة والمد في العمر في اجال متفاوتة ) لميتون ( واشار بهذا النعت  صفحة رقم 
 الي ان الموت امر ثابت للانسان حي في حال حياته لازم له ، بل ليس لممكن من ذاته الا العدم .
 ولما تقرر بذلك القدرة علي البعث تقررا لا يشك فيه عاقل ، قال نافيا ما يوهمه اعراء الظرف من الجار : ( ثم انكم ( وعين البعث الاكبر التام ، الذي هو محط الثواب والعقاب ، لان من اقر به اقر بما هو دونه من الحياة في القبر وغيرها ، فقال : ( يوم القيامة ) اي الذي يجمع فيه جميع الخلاءق ) تبعثون ( فنقصه عن تاكيد الموت تنبيها علي ظهوره ، ولم يخله عن التاكيد لكنه علي خلاف العادة ، وليس في ذكر هذا نفي للحياة في القبر عند السءال .
 المءمنون : (    ) ولقد خلقنا فوقكم. .. . .
 ) ولقد خلقنا فوقكم سبع طراءق وما كنا عن الخلق غافلين وانزلنا من السماء ماء بقدر فاسكناه في الارض وانا علي ذهاب به لقادرون فانشانا لكم به جنات من نخيل واعناب لكم فيها فواكه كثيرة ومنها تاكلون ( ( )
 ولما بين لهم ان فكرهم فيهم يكفيهم ، ولا عتقاد البعث يعنيهم ، اتبعه دليلا اخر بالتذكير بخلق ما هو اكبر منهم ، وبتدبيرهم بخلقه وخلق ما فيه من المنافع لاستبقاءهم ، فقال : ( ولقد خلقنا قوقكم ( في جميع جهة الفوق في ارتفاع لا تدركونه حق الادراك ) سبع ( ولارادة التعظيم اضاف الي جمع كثرة فقال : ( طراءق ) اي سماوات لا تتغير عن حالتها التي دبرناها عليها الي ان نريد ، وبعضها فوق بعض متابقة ، وكل واحدة منها علي طريقة تخصها ، وفيها طرق لكواكبها ؛ قال الامام عبد الحق الاشبيلي في كتابه الواعي : سميت طراءق لانها مطارقة بعضها في اثر بعض  انتهي .
 وهذا من قولهم : فلان علي طريقه  اي حاله  واحدة ، وهذا مطراق هذا ، اي تلوه ونظيره ، وريش طراق  اذا كان بعضه فوق بعض .
 وقال ابن القطاع : واطرق جناح الطاءر  اي مبنيا للمجهول : البس الريش الاعلي السفل .
 وقال ابو عبيد الهروي : واطرق جناح الطير  اذا وقعت ريشة علي التي تحتها فالبستها ، وفي ريشه طرق  اذا ركب بعضه بعضا .
 وقال الصغاني في مجمع البحرين : والطرق ايضا بالتحريك في الريش ان يكون بعضها فوق بعض ، وقال ابن الاثير في النهاية : طارق النعل  اذا صيرها طاقا فوق طاق وركب بعضها علي بعض ، وفي القاموس : والطراق  ككتاب : كل خصفة يخصف بها النعل وتكون حذوها سواء وان يقور جلد علي مقدار الترس فيلزق بالترس ، وقال القزاز : يقال : ترس مطرق  اذا جعل له ذلك ، وقال الصغاني في المجمع : والمجان المطرقة التي يطرق بعضها علي بعض كالنعل المطرقة  اي المخصوفة بعضها علي بعض ، ويقال : اطرقت بالجلد والعصب ، اي البست ، وقال ابو عبيد : طارق النعل  اذا صير خصفا فوق خصف ،  صفحة رقم 
