 وهذا نص مت عندهمة من التوارة في القصاص ، قال في السفر الثاني : وكل من  صفحة رقم 
 ضرب رجلا فمات فليقتل قتلا ، واذا تشاجر رجلان فاصابا امراة حبلي فاخرجا جنيفها ولم تكن الروح حلت في السقط بعد ، فليغرم عهلي قدر ما يلزمه زوج المراة ، وليءد ما حكم عليه الحاكم ، فان كانت الروح حلت في السقط فالنفس والعين بالعين والسن بالسن واليد باليد والرجل بالرجل والجراحة بالجراحة واللطمة باللطمة ، وقال في السفر الثالث بعد ذكر الاعياد في الاصحاح السابع عشر : ومن قتل انسانا يقتل ، ومن قتل بهيمة يدفع الي صاحبها مثلها ، والرجل يضرب صاحبه ويءثر فيه اثرا يعاب به يصنع به كما صنع ، والجروح قصاص : الكسر بالكسر والعين بالعين والسن بالسن ، كما يصنع الانسان بصاحبه كذلك يصنع به ، القضاء واحد لكم وللذين يقبلون الي ، وقال في الثاني : اذا ضرب الرجل عين عبده او امته ففقاها فليعتقه بدل عينيه ، واذا قلع سن عبده او امته فليعتقه بدل سنة  وذكر احكاما كثيرة ، ثم قال : ومن ذبح للاوثان فيهلك ، بل لله وحده ، وقال في الرابع : ومن يقتل نفسا لا يقتل الا ببينة عادلة ، ولا تقبل شهادة شاهد واحد علي قتل النفس ، ولا تقبلوا رشوة في انسان يجب عليه القتل بل يقتل ، لوا تاخذوا منه رشوة ليهرب الي قرية الي الملجا ليسكنها الي وفات الحبر العظيم ، ولا تنجسوا الارض التي تسكنونها ، لان الدم ينجس الارض ، والارض التي يسفك فيها الدم لا يغفر لتلك الارض حتي يقتل القاتل الذي قتل ، وقال في الخامس : ولا يقتل من قد وجب عليه القتل الا بشهادة رجلين ، لا يقتل بشهادة رجل واحد ، واذا رجمتم فالذي يشهد عليه فليبدا برجمه الشهود اولا ثم يبدا به جميع الشعوب ، واهلكوا الذين يعملون الشر واستاصلوهم من بينكم ، ون شهد رجل علي صاحبه شهادة زور يقوم الرجلان قدام الحبر والقاضي فيفحصون عن امرهما فحصا شديدا ، فان وجدوا رجلا شهد شهادة ، زور يصنعوا به مثل ما اراد ان يصنع باخيه ، ونحوا الشر من بينكم ، وعاقبوا بالحق ليسمع الذين يتقون فيفزعوا ولا يعودوا ان يفعلوا مثل هذا الفعل القبيح بينكم ، ولا تشفق اعينكم علي الظالم ، بل يكون قضاءكم نفسا بنفس وعينا بعين وسنا بسن ويدا بيد ورجلا برجل .
 ولما كانت هذه الايات كلها  مع ما فيها من الاسرار  ناقضة ايضا لما ادعوا من البنوة بما ارتكبوه من الذنوب من تحريف كلام الله وسماع الكذب واكل السحت والاعراض عن احكام التوراة والحكم بغير حكم الله ، اتبعها ما اتي به عيسي عليه السلام الذ ادعي فيه النصاري النبوة الحقيقية والشركة في الالهية ، وقد اتي بتصديق التوراة في الشهادة لعي من خالفها من اليهود بالتبرء من الله ، مءكدا لما فيها من التوحيد الذي هو عماد الدين واعظم اياتها التي اخذت عليهم بها العهود ووضعت في تابوت  صفحة رقم 
 الشهادة الذي كانوا يقدمونه امامهم في الحروب ، فان كانوا باقين علي ما فيه من الميثاق نصروا والا خذلوا ، وناسخا لشريعتهم مجازاة لهم من جنس ما كانوا يعملون من التحريف ، وشاهدا علي من اطراه بالضلال فقال : ( وقفينا ( ايلي اخرها ، وكذا كل ما بعدها من اياتهم الي اخر السورة ، لا تخلوا اية منها نم التعرض الي نقض دعواهم لها بذكر ذنب ، او ذكر عقوبة عليه ، او ذكر تكذيب لهم من كتابهم او نبيهم ، والمعني : اوجدنا التقفية ، وهي اتباع شء بشء تقدمه ، فيكون اتيا في قفاه لكوهه وراءه ، والقاءه في مظهر العظمة لتعظيم شان عيسي عليه السلام ) علي اثارهم ) اي النبيين الذين يحكمون بالتوراة ، وذكر الاثر يدل علي انهم كانوا قد تركوا دينهم ، لم يبق منه الا رسم خفي ) بعيسي ( ونسبه الي امه اشارة الي انه لا والد له تكذيبا لليهود ، والي انه عبد مربوب تكذيبا للنصاري ، فقال : ( ابن مريم مصدقا ) اي عيسي عليه السلام في الاصول وكثير من الفروع و) لما يبن يديه ) اي مما اتي به موسي عليه السلام قبله ) من التوراة ( واشار الي انه ناسخ لكثير من احكامها بقوله : ( واتيناه الانجيل ) اي انزلناه بعظمتنا عليه كما انزلنا التوراة علي موسي عليه السلام .
 ولما كان في الانجيل المحكم الذي يفهمه كل احد ، والمتشابه الذي لا يفهمه الا الافراد من خلص العباد ، ولا يقف بعد فهمه عند حدوده الا المتقون ، قال مبينا لحاله : ( فيه ) اي اتيناه اياه بحكمتنا وعظمتنا كاءنا فيه ) هدي ) اي وهو المحكم ، يهتدي به كل احد سمعه الي صراط مستقيم ) ونور ) اي حسن بيان كاشف للمشكلات ، لا يدع بذلك الصراط لبسا .
 ولما كان الناسخ للشء بتغيير حكمه قد يكون مكذبا له ، اعلم انه ليس كذلك ، بل هو مع النسخ للتوراة مصدق لها فقال  اي مبينا لحال الانجيل عطفا علي محل ) فيه هدي ( : ( ومصدقا ) اي الانجيل بكماله ) لما بين يديه ( ولما كان الذي نزل قبله كثيرا ، عين المراد بقوله : ( من التوراة ( فالاول صفة لعيسي عليه السلام ، والثاني صفة لكتابه ، بمعني انه هو والتوراة والانجيل متصادقون ، فكل من الكتابين يصدق الاخر وهو يصدقهما ، لم يتخالفوا في شء ، بل هو متخلق بجميع ما اتي به .
 ولما كان المتقون خلاصة الخلق ، فهم الذين ينزلون كل ما في كتب الله من محكم ومتشابه علي ما يتحقق به انه هدي ويتطابق به المتشابه والمحكم ، وكان قد بين انه فيه من الهدي ما يسهل به رد المتشابه اليه فصار بعد البيان كله هدي ، قال معمما بعد ذلك التخصيص : ( وهدي وموعظة للمتقين ) اي كل ما فيه يهتدون به ويتعظون فترق قلوبهم ويعتبرون به وينتقلون مترقين من حال عالية الي حال اعلي منها .

 صفحة رقم 
 ذكر بعض ما يدل علي ذلك من الانجيل الذي بين ظهراني النصاري الان وقد مزجت فيه كلام بعض الاناجيل ببعض واغلب السياق لمتي ، وعينت بعض ما خالفه ، قال لوقا : وجاء اليه قوم واخبروه خبر الجليليين الذين خلط بيلاطس دماءهم مع دماء ذباءحهم ، فاجاب يسوع وقال لهم : لا تظنوا ان اولءك الجليليين اشد خطا من كل الجليليين اذا اصابتهم هذه الاوجاع ، ان لم تتوبوا كلكم انتم تهلكون مثلهم ، وهءلاء الثمانية عشر الذين سقط عليهم البرج في سيلوخا وقتلهم اتظنون انهم اكبر جرما من جميع سكان يروشليم ، كلا اقول لكم ، ان لم تتوبوا فجميعكم يهلك ؛ وقال لهم : شجرة تين كانت لواحد مغروسة في كرمه ، جاء يطلب فيها ثمرة فلم يجد ، فقال للكرام : هذه ثلاث سنين اتي واطلب فيها ثمرة فلا اجد ، اقطعها لءلا تبطل الارض ، فقال : يا رب دعها في هذه السنة لانكحها واصلحها ، لعلها تثمر في السنة الاتية ، فان هي امثرت والا اقطعها .
 قال متي : ولما نزل من الجبل تبعه جمع كبير واذا ابرص قد جاء فسجد له وقال : ان شءت فانت قادر ان تطهرني ، فمد يده ولمسه وقال له : قد شءت فاطهر ، وللوقت طهر برضه ، وقال له يسوع : لا تقل لاحد ولكن امض فار نفسك للكاهن وقدم قربانا كما امر موسي للشهادة عليهم  وقال مرقس : بشهادتهم  قال لوقا : فلذاع عنه الكلام زواد ، واجتمع جمع كثير ليسمعوا منه ويستشفوا من امراضهم ، واما هو فكان يمضي الي البرية ويصلي هناك .
 وقال متي : ولما دخل كفرنا حوم جاء اليه قاءد ماءة فطلب اليه قاءلا : يا رب فتاي ملقي في البيت مخلع وسقيم جدا ، فقال له : اني اتي وابرءه ، فاجاب قاءد الماءة وقال : يا رب لست مستحقاان تدخل تحت سقف بيتي ، ولكن قل كلمة فقط فيبرا فتاي لاني تحت سلطان ، ولي جند ، ان قلت لهذا : اذهب ، ذهب ، ولاخر : اءت ، اتي ، ولعبدي : اعمل هذا ، عمل ، فلما سمع يسوع تعجب وقال للذين يتبعونه : الحق اقول لكم انني لم اجد مثل هذه الامانة في اسراءيل ، اقول لكم : ان كثيرا ياتون من المشرق والمغرب  وقال لوقا : والشمال واليمين  يتكءون مع ابراهيم واسحاق ويعقوب ؛ قال لوقا : وكل الانبياء في ملكوت الله السماوات ، وبنو ويكون الاولون اخرين والاخرون اولين ؛ وقال متي : في ملكوت السماوات ، وبنو الملكوت يلقون في الظلمة البرانية ، الموضع الذي يكون فيه البكاء وصرير الاسنان ، وقال يسوع لقاءد الماءة : اذهب كامانتك يكن لك ، فبرا الفتي في تلك الساعة ، وقال لوقا : ولما اكمل جميع كلامه ودخل كفرنا حوم ، وكان عبد لقاءد الماءة قد قارب الموت وكان كريما عنده ، فلما سمع بيسوع ارسل اليه شيوخ اليهود يسالونه المجء ليخلص عبده ، فلما جاءوا الي يسوع طلبوا منه باجتهاد وقالوا : انه مستحق ان يفعل معه هذا ،  صفحة رقم 
 لانه محب لامتنا وهو بني لنا كنيسة ، فمضي يسوع معهم ، وفيما هو قريب من البيت ارسل اليه قاءد الماءة اصدقاءه قاءلا : يا رب لا تتعب فاني لا استحق ان تدخل تحت سقف بيتي ، من اجل في بني اسراءيل مثل هذه الامانة ، فرجع المرسلون الي اليبت فوجدوا المريض قد برا ، وفي غد كان يسوع ماضيا الي مدينة اسمها نايين وتبعه تلاميذه اجمع وجمع كبير ، فلما قرب من باب المدينة اذا محمول قد مات وحيدا لامه وكانت ارملة ، وجمع كبير من اهل المدينة معها ، فلما راها الرب تحنن عليها وقال لها : لا تبكي ، وتقدم ولمس النعش فوقف الحاملون له ، وقال له : ايها الشاب لك اقول : قم واجلس فجلس الميت وبدا يتكلم ، ودفعه لامه ، ولحقهم خوف ومجدوا الله قاءلين : لقد قام فينا نبي عظيم ، وتعاهد الله شعبه بصلاح ، فذاع هذا الكلام في كل اليهودية وكل الكور التي حولها .
 قال متي : وجاء يسوع الي بيت بطرس فنظر " لي حماته ملقاة تحمي ؛ وقال مرقس : وجاء الي بيت سمعان واندراوس مع يعقوب ويوحنا فراي حماة سمعون في حمي شديدة فقالوا له من اجلها ، فقدم وامسك بيدها واقامها ؛ وقال متي : فمس يديها فتركها الحمي وقامت تخدمهم ؛ وقال لوقا : ونهضت للوقت تخدمهم ، فلما كان المساء  قال مرقس : عند غروب الشمس  قدموا اليه مجانين كثيرا ، قال مرقس : ووقف جميع اهل المدينة علي الباب ، وابرا كثيرا ممن به علة رديءة ، واخرج شياطين كثيرة ؛ وقال متي : وكان يخرج الارواح بكلمة ، وابرا كل سقيم لكي يتم ما قيل في اشعياء النبي القاءل : انه اخذ امراضنا وحمل اوجاعنا .
 وسحرا جدا قام وخرج الي البرية ليصلي هناك وسمعون ومن معه يطلبونه ، فلما وجدوه قالوا له : ان لاجمع يطلبك ، فقال لهم : سيروا بنا الي القري والمدن القريبة لنكرز ، فاني لهذا وافيت ، فاقبل يبشر في مجمعهم في كل الجليل ويخرج الشياطين ؛ وقال لوقا : وفي غد اليوم خرج وذهب الي موضع قفر والجمع يطلبونه ، وجاءوا اليه وامسكوه لءلا لءلا يمضي من عندهم ، فقال لهم : انه ينبغي ان ابشر في المدن الاخر بملكوت الله ، لاني لهذا ارسلت ، وكان يكرز في مجامع الجليل ، وكان لما اجتمع اليه جمع ليسمعوا كلام الله كان هو واقفا علي بحيرة جاناسر ، فراي سفينتين موقفتين علي شاطء البحيرة واللصيادون قد صعدوا عليها ليغسلوا شباكهم ، فصعد الي احداهما التي لسمعان ، وامر ان يبعدها عن الشط قليلا ، وجلس يعلم في الجمع من السفينة ؛ ولما اكمل كلامه قال لسمعان : تقدم الي اللج والقوا شباككم  صفحة رقم 
 فقال : يا معلم قد تعبنا الليل اجمع ولم ناخذ شيءا ، وبكلمتك نحن نلقي شباكنا ، ولما فعلوا ذلك اخذوا سمكا كثيرا ، وكادت شباكهم تتخرق ، فاشاروا الي شركاءهم في السفينة الاخري لياتوا يعينوهم ، فلما جاءوا ملءوا السفينتين حتي كادتا ان تغرقا ، فلما راي سمعان ذلك خر عند قدمي يسوع وقال له : ابعد عني يا سيدي لاني رجل خاطء ، لان الخواف اعتراه وكل من معه لاجل صيد الحيتان التي اصطادوا ، وكذلك يعقوب ويوحنا ابنا زبدي اللذان كانا صديقي سمعان ، فقال يسوع لسمعان : لا تخف ، من الان تكون صيادا تصيد للناس ، وقربوا السفن الي الشط وتركوا كل شء وتبعوه ؛ وقال متي : فلما نظر يسوع الي الجمع الذي حوله امر ان يذهبوا الي العبر ، فجاء اليه كاتب وقال له : يا معلم اتبعك الي حيث تمضي ، فقال له يسوع : ان للثعالي اجحارا ، ولطير السماء اوكارا ، فاما ابن الانسان فليس له موضع يسند راسه ؛ وقال لوقا : وقال اخر : اتبعني ، فقال : يا رب اءذن لي ان امضي اولا وادفن ابي ، فقال له يسوع : اتبعني ودع الموتي يدفنوا موتاهم ، وقال الاخر ايضا : بل تاذن لي اولا ان ارتب اهل بيتي ، فقال : ما من احد يضع يده علي سكة الفدان وينظر الي وراءه يستحق ملكوت الله ؛ وقال متي : فلما صعد السفينة تبعه تلاميذه  وقال لوقا : صعد السفينة هو وتلاميذه وقال لهم : امضوا بنا الي عبر البحيرة ، فساروا وفيما هم ساءرون نام  واذا اضطراب عظيم كان في البحر حتي كادت الامواج تغطي السفينة  لان الريح كانت مضادة لهم  وهو ناءم ، فتقدم اليه تلاميذه وقالوا : يا رب  وقال مرقس : وكانت رياح عواصف عظيمة ، وكانت الامواج تضرب السفينة وتدخلها المياه حتي كادت تمتلء ، وهو ناءم في مءخرها علي وسادة  فايقظوه وقالوا له : يا معلم نجنا فقد هلكنا فقال لهمخ : ما اخافكم يا قليلي الامانة ؟ حينءذ قام وانتهر الرياح ولابرح ، فصار هدوءا عظيما ، ثم قال متي : فلما صعد السفينة وجاء الي العبر ودخل مدينته قدم اليه مخلع ملقي علي سرير  وفي انجيل مرقس ولوقا : انهم ارادوا الدخول به اليه فلم يقدروا لكثرة الجمع ، فصعدوا الي السطح ودلوه بسريره اليه  حينءذ قال للمخلع : قم امل سريرك واذهب الي بيتك فقام ومضي الي بيته ، فنظر الجمع وتعجبوا ومجدوا الله الذي اعطي هذا السلطان كذا للناس ؛ وقال يوحنا في انجيله : وبعد هذا كان عيد اليهود فصعد يسوع الي يروشليم ، وكان هناك بيروشليم مكان يسمي بالعبرانية بيت الرحمة ، وكان فيه خمسة اروقة ، وكان خلق كثير من المرضي مطروحين فيها وعمي ومقعدون وجافون ، فكانوا يتوقعون تحريك الماء ، لان ملاكا كان ينزر الي الصبغة في حين بعد حين ، وكان يحرك الماء ، والذي كان ينزل فيه اولا من بعد حركة الماء يبرا من كل الوجع الذي به ، وكان هنا رجل سقيم  صفحة رقم 
 منذ ثمان وثلاثين سنة ، فنظر اليه يسوع ملقي فقال له : اتحب ان تبرا ؟ فقالك نعم يا سيدي ولكن ليس لي انسان اذا تحرك الماء يلقيني في البركة اولا ، فالي ان اجء انا ينزل قدامي اخر ، فقال له : قم ، احمل سريرك وامضن فمن ساعته برا ونهض حاملا سريره ، وكان ذلك اليوم يوم سبت ، فقال له اليهود : انه يوم سبت ، ولا يحل لك ان تحمل سريرك ، فاجابهم : الذي ابراني هو قال ليك احمل سريرك وامش ، فسالوه : من هو ؟ فلم يكن يعلم من هو ، لان يسوع كان قد استتر في الجمع لاكبير الذي كان في ذلك الموضع ، ثم قال : وقال لهم يسوع : لقد عملت عملا واحدا فعجبتم باجمعكم ، اعطاكم موسي الختان وليس هو من موسي ولكنه من الاباء ، وقد تختنون الانسان يوم السبت لءلا تنقضوا سنة موسي ، فلم تتذمرون علي لابراءي الانسان يوم السبت ، لا تحكموا بالمحاباة ولكن احكموا حكما عدلا ، ثم قال : فبينما هو مار راي رجلا ولد اعمي فقال تلاميذه : يا معلم من اخطا ؟ هذا ام ابواه حتيانه ولد اعمي ، فقال : لا هو ولا ابواه ، ولكن لتظهر اعمال الله فيه ، ينبغي ان اعمل اعمال من ارسلني ما دام النهار ، سياتي الليل الذي لا يستطيع احد ان يعمل فيه عملا ، ما دمت في العالم ان نور العالم  قال هذا وتفل علي التراب وصنع من تفله طينا وطلي به عيني ذلك الاعمي وقال له : امض واغتسل في عين سيلوخا التيتاويلها المبعوثة ، فمضي وغسلهما فعاد ينظر ، فاما جيرانه والذين كانوا يرونه يتسول فقالوا : ليس هو هذا الذي كان يجلس ويتسول ، واخرون قالوا : انه هو ، واخرون قالوا : انه يشهبه ، فاما هو فكان يقول : اني انا هو ، فقالوا له : كيف انفتحت عيناك ؟ فقص عليهم القصة ، فقالوا : اين هو ذاك ؟ فقال : ما ادري ، فاتوا به الي الفريسيين ، لان يسوع صنع الطين يوم السبت ، فساله الفريسيون فاخبرهم ، فقال قوم منهم : ليس هذا الرجل من الله اذ لا يحفظ السبت ، واخرون قالوا : كيف يقدر رجل خاطء ان يعمل هذه الايات فوقع بينهم لذلك شقاق ، فقالوا للاعمي : ما تقول انت من اجله ؟ قال لهم : انه نبي ، ولم يصدق اليهود انه كان اعمي حتي دعوا ابويه وسالوهما ، فقالا : نحن نعلم ان هذا ولدنا وانه ولد اعمي ، ووقعت بين الاعمي وبينهم محاورة ، كان اخر ما قالوا له : انت ولدت بالخطايا وانت تعلمنا واخرجوه .
 وقال متي : واجتاز يسوع هناك فراي انسانا جالسا علي التعشير اسمه متي فقال له : اتبعني ، فترك كل شء وقام وتبعه .
 وقال لوقا : وبعد هذا خرج فنظر الي عشار اسمه لاوي جالسا علي المكس ، فقال له : اتبعني ، فترك كل شء وقام وتبعه ، وصنع له لاوي في بيته وليمة عظيمة ، وكان جمع كثير من العشارين واخرين متكءين معه .
 وقال مرقس : ثم خرج الاي شاطء البحر واجتمع اليه جمع كبير وعلمهم ، وعند  صفحة رقم 
 مضيه راي لاوي ابن حلفي جالسا علي العشارين فقال له : اتبعني ، فقام وتبعه ، وبينما هو متكء في بيته  وقال متي : وبينما هو متكء في بيت سمعان  جاء عشارون وخطاة كثيرون ، فاتكءوا مع يسوع وتلاميذه ، فلما نظر الفريسيون قالوا لتلاميذه : لماذا معلمكم ياكل مع العشارين والخطاة ؟ فلما سمع يسوع قال لهم : الاصحاء لا يحتاجون الي طبيب ، لكن ذوو الاسقام ، اذهبوا فاعلموا ما هو ، اني اريد رحمة لا ذبيحة ، لم ات لادعو الصديقين لكنم الخطاة للتوبة .
 وقال لوقا : وطلب اليه واحد من الفريسيين ان ياكل معه ، فدخل بيت ذلك الفريسي وجلس ، وكان في تلك المدينة امراة خاطءة ، فلما علمت انه متكء في بيت ذلك الفريسي اخذت قارورة طيب ووقفت من وراءه عند رجليه باكية ، وبدات تبل قدميه بدموعها وتمسحها بشعر راسها ، وكانت تقبل قدميه وتدهنهما بالطيب ، فلما راي ذلك الفريسي الذي دعاه فكر في نفسه قاءلا : لوكان هذا نبيا علم ما هذه وانها خطاءة ، فاجاب يسوع وقال له : يا سمعان غريمان عليها لانسان دين ، علي احدهما خمسماءة دينار وعلي الاخر خمسون ، وليس لهما ما يوفيان فوهب لهما ، فايهما اكثر حبا له ؟ فقال : اظن الذي وهب له الاكثر ، فقال له : بالحق حكمت ؛ ثم التفت الي المراة وقال : يا سمعان دخلت بيتك فلم تسكب علي رجلي ماء وهذه بلت رجلي بالدموع ومسحتهما بشعر راسها ، انت لم تقبلني وهذه منذ دخلت لم تكف عن تقبيل قدمي ، انت لم تدهن راس بزيت وهذه دهنت بالطيب قدمي ، لاجل ذلك اقول لك : ان خطاياه مغفورة لها ، لانها احبت كثيران ثم قال لها : اذهبي بسلام ايمانك خلصك ؛ وكان بعد ذلك يسير الي كل مدينة ويكرز ويبشر بملكوت الله ومعه الاثنا عشر ونسوة كن ابراهن من الامراض والارواح الخبيثة : مريم التي تدعي المجدلانية التي اخرج منها سبعة شياطين ، ويونا امراة خوزي خازن هيرودس ، واخر كثيرات .
 وقل متي : حينءذ جاء اليه تلاميذ يوحنا قاءلين : لماذا نحن والفريسيون نصوم كثيرا وتلاميذك لا يصومون ؟ فقال لهم يسوغ : لا يستطيع بنو العرس ان ينوحوا ما دام العريس معهم ، وستاتي ايام اذا ارتفع العريس عنهم حينءذ صومون ؛ ليس احد ياخذ خرقة جديدة يجعلها في ثوب بال ، لانها تاخذ ملاها من الثوب فيصير الخرق اكبرن وقال مرقس : انه لا يرقع انسان ثوبا باليا بخرقة جديدة الا مد الجديد البالي فيخرقه ؛ وقال متي : ولا تجعل خمر جديدة في زقاق جدد فيتحفظان جميعا ؛ وقال لوقا : وما من احد يشرب قديما فيحب الجديد للوقت لانه يقول : ان القديم اطيب ، وقال متي : وفيما هو يكلمهم اذا رءيس قد جاء اليه ساجدا قاءلا : ان ابنتي ماتت الان ، تاتي فتضع يدك عليها  صفحة رقم 
 فتحيي فقام يسوع وتبعه تلاميذه ، فاذا امراة بها نزيف دم منذ اثنتي عشرة سنة ؛ قال مرقس : اعيت من الاطباء ، انفقت كل مالها ، لم تجد راحة بل تزداد وجعا ، فلما سمعت بيسوع  قال متي : جاءت من خلفه ومست طرفه ثوبه  فالتفت يسوع فراها فقال لها : ثقي يا ابن ايمانك خلصك ، فبرءت المراة من تلك الساعة ، وجاء يسوع الي بيت الرءيس ؛ وقال مرقس : ولم يدع احدا يتبعه الا بطرس ويعقوب ويوحنا اخا يعقوب  انتهي .
 فنظر الي الجمع مضطربين ، فقال لهم : اخرجوا ، لم تمت الجارية لكنها ناءمة ، فضحكوا منه ، فلما خرج الجمع دخل وامسك يدها فقامت الجارية ؛ وقال مرقس : واخرج جميعهم واخذ معه ابا الصبية وامها والذين معه ، ثم دخل الي الموضع الذي فيه الصبية موضوعة ، واخذ بيدها وقال لها : طليثا قومي ، الذي تاويله : يا صبية لك اقول : قومي ، فللوقت قامت الصبية ومشت ، وكان لها اثنتا عشرة سنة ، فبهتوا وعجبوا عجبا عظيما ، فامرهم كثيرا ان لا يعلموا احدا بهذا ، وقال : اطعموها تاكل ؛ وقال متي : وخرج خبرها في جميع تلك الارض .
