 ولما ذكر سبحانه بطشه ، وكان القادر علي العنف قد لا يقدر علي اللطف ، وان قدر فربما لم يقدر علي الابلاغ في ذلك ، وكان لا يقدر علي محو الذنوب اعيانها واثارها علي كل احد بحيث لا يحصل لصاحبها عقاب ولا عتاب من احد اصلا الا من كان قادرا علي كل شء ، قال مبينا لجميع ذلك دليلا علي انه الفاعل المختار ، ومءكدا لخروجه عن العواءد : ( وهو ) اي وحده ) الغفور ) اي المحاء لاعيان الذنوب واثارها اذا اراد بحيث لا يحصل لمن محا ذنبه كدر من جهة ذلك الذنب اصلا ) الودود ) اي الذي يفعل بمن اراد فعل المحب الكثير المحبة فيجيبه الي ما شاء ويلقي علي صاحب الذنب الذي محاه عنه ودا اي محبة كبيرة واسعة يجعل له في قلوب الخلق رحمة ، ومادة ( ود ) تدور علي الاتساع كما بينته في سورة الروم ، وزاد الامر تاكيدا بذكر ما لا ينازع اصلا في اختصاصه به تشريفا له وتنبيها علي انه اعظم المخلوقات : ( ذو العرش ) اي العز الاعظم او السرير الدال علي اختصاصه الملك بالملك وانفراده بالتدبير والسيادة والسياسة ، الذي به قوام الامور ) المجيد ) اي الشريف الكريم العظيم في ذاته وصفاته الحسن الجميل الرفيع العالي الكثير العطاء  هذا اذا رفع علي انه صفة ل ( ذو ) وكذا ان جر علي انه صفة للعرش في قراءة حمزة والكساءي .
 ولما كان الاختصاص يدل قطعا علي كمال القدرة ، انتج ذكر هذه الاختصاصات قوله : ( فعال ) اي علي سبيل التكرار والمبالغة ) لما يريد ( لا يءده شء من الافعال سواء كانت منسوبة اليه من غير واسطة او نسبت في الظاهر الي غيره .
 ولما تمت الدلالة علي ان بطشه شديد ، قرره بما وجد من ذلك وذكره به تخويفا وتسلية له لان النظر في المحسوسات امكن في النفوس فقال : ( هل اتاك ) اي يا اعظم خلقنا ) حديث الجنود ) اي اذكر ما اتاك مما حدث لهم من بطشنا وما وقع بهم من سطواتنا لتكذيبهم رسلنا عليهم افضل الصلاة والسلام بحيث صار حديثا يتلي ، وذكرا بين الخلق  صفحة رقم 
 لعظمته لا يبلي ، والجنود جمع جند بالضم وهو العسكر المعد للقتال والاعزان والمدينة ، والكل ناظر الي النجدة العظيمة والغلبة الزاءدة .
 ولما كان المعلوم من السياق ان المراد من حديثهم ما حصل لهم من البطش لتكذيب الرسل لا يسما في البعث الذي السياق له ، وكان الواقع من بيانه بايات موسي وصالح عليهما الصلاة والسلام ابين مما وقع بايات غيرهم ممن تقدم من الخلق كثيرة ، حكي ان طليعته يوم تبع بني اسراءيل وغرق كانت ستماءة الف ، ابدل من ( الجنود ) اعلاما بانهم اعداء الله قوله : ( فرعون ( وكذا اتباعه الذين كانوا اشد اهل زمانهم واعتاهم واكثرهم رعونة في دعوي الالهية منه والتصديق منهم وكان هذا من عمارة قلوبهم مع ظهور علامات الربوبية السماوية والارضية ، والرسوخ في التكذيب والسفه والخفة والطيش مع رءية تلك الايات العظيمة علي كثرتها وطول زمنها حتي دخل الحبر علي امان من الغرق مع ان خطر الغرق به في تلك الحالة لم يكن يخفي علي من له ادني مسكة من عقله فاغرقه واتباعهم الطاءفة الاتحادية العربية الفارضية الذين يكفي في ظهور كفرهم تصويبهم فرعون الذي اجمع علي كفره جميع الفرق ) وثمود ( الذين حملتهم الخفة علي ان عقروا الناقة بعد رءيتهم اياها تتكون من الصخرة الصماء غير مجوزين ان الذي خرق العادة باخراجها ذلك يهلكهم في شانها ، وقد جمع سبحانه بهما الساعة ، وانما كانت اياتهما ابين لان اية ثمود ناقة خرجت من صخرة صماء ، ومن ايات موسي عليه الصلاة والسلام ابداع القمل الذي لا يحصي كثرة من الكثبان ، وابداع الضفادع كذلك والجراد واحياء العصا مرة اخري ، ولا شك عند عاقل ان من قدر علي ذلك ابتداء من شء لا اصل في الحاية فهو علي اعادة ما كان قبل ذلك حيا اشد قدرة .
 ولما كان التقدير : نعم قد اتاني ذلك وعلمت من خبرهما وغيره انك قادر علي ما تريد ، ولكن الكفار لا يصدقونني ، عطف عليه قوله : ( بل الذين كفروا ) اي جاهروا بالكفر من هءلاء القوم وغيرهم وان كانوا في ادني رتبة ) في تكذيب ) اي لما راوا من الايات لا مستند لهم فيه وهو شديد محيط بهم لاتباعهم اهواءهم وتقليدهم اباءهم ، فهم لا يقدرون علي الخروج من ذلك التكذيب الذي صار ظرفا لهم بعد سماعهم لاخبار هءلاء المهلكين ورءية بعض اثارهم ، وبعد ما اقمت لهم من الادلة علي البعث  صفحة رقم 
 في هذا القران المعجز ، ولم يعتبروا بشء من ذلك لما عندهم من داء الحسد ، فحالهم اعجب من حالهم فحذرهم مثل مالهم .
 ولما كان هذا ربما اوهم ان تكذيبهم علي غير مراده سبحانه وتعالي ، قال دافعا لذلك مءكدا قدرته علي اخذهم تحذيرا لهم وتسلية لمن كذبوه : ( والله ) اي والحال ان الملك الذي اختص بالجلال والاكرام ) من وراءهم ) اي من كل جهة يوارونها او تواريهم ، وذلك كل جهة ) محيط ( فهو محيط بهم نمكل جهة بعلمه وقدرته ، فهو كناية عن انهم في قبضته لا يفوتونه بوجه كام انه لا يفوت من صار في القبضة باحاطة العدو به من غير مانع ، فهو سبحانه قادر علي ان يحل بهم ما احل باولءك ، ولعله خص الوراء لان الانسان يحمي ما وراءه ولانه جهة الفرار من المصاءب .
 ولما كان من تكذيبهم ، وهو اعظم تكذيبهم ، طعنهم في اعظم ايات القران بان يقولوا : هو كذب مختلق ، انما هو اساطير الاولين ، اي اكذوباتهم لا حقاءق لا يخبر به مع انه قد اقام الدليل الاعظم لنفسه بنفسه بما له من الاعجاز علي انه حق ، قال معبرا بالضمير ايذانا بانه لعظمه في كل قلب لا غيبة له اصلا ، ليس لاحد حديث الا فيه ، بانيا علي ما تقديره : ليس الامر كما يزعم الكفار في القران : ( بل هو ) اي جامع لكل منقبة جليلة بالغ الذروة العليا في كل شرف ) مجيد ) اي شريف كريم ليس فيه شء من شواءب الذم عزيز عظيم شريف عال جواد حسن الخلال وحيد في نظمه معانيه المغيبة والمشاهدة حاو لمجامع الحمد حسن الخلال وحيد في نظمه ومعانيه المغيبة والمشاهدة حاو لمجامع الحمد ليس بقول مخلوق ولا هو مخلوق بل هو صفة الخالق بل هو جواد بكل ما يراد منه من المحاسن لمن صدقت نيته وطهرت طويته ، وعلت همته وكرمت سجيته ، فهو يابي له مجده ان يلم بساحته طعن بوجه من الوجوه ، ومجده تجريب احكامه من بين عاجل ما شهد واخل ما علم بعالم ما شهد ، فكان معلوما بالتجربة المتيقنة بما تواتر من القصص الماضي وما شهد له من الاثر الحاضر وما يتجدد مع الاوقات من امثاله واشباهه واشكاله ، فكذب من قال انه شعر او كهانة او سحر  او غير ذلك من الاباطيل .
 ولما وصفه في نفسه مما يابي له لحاق شء من شبهة ، وصف محله في الملا الاعلي اعلاما بانه لا يطرا عليه ما يغيره فقال : ( في لوح ( وهو كل صفيحة عريضة من خشب او عظم او غيرهما ) محفوظ ) اي له الحفظ داءما علي اتم الوجوه من كل خلل ومن ان يصل اليه الا الملاءكة الكرام ، قال حجة الاسلام الغزالي رحمه الله تعالي في كتاب الموت من الاحياء : يعبر عنه تارة باللوح ، وتارة بالكتاب المبين ، وتارة بامام  صفحة رقم 
