 ولما كان نسبة هذا اليه توبيخا وتقريعا لقصور نظره فان الاقتار قد يءدي الي سعادة الدارين ، والتوسعة قد تءدي الي شقاوتهما ، وهذا اكثر ما يوجد ، قال ردعا عن مثل هذا القول باعظم ادوزات الزجر معللا للتوسعة والاقتار : ( كلا ) اي اني لا اكرم بتكثير الدنيا ولا اهين بتقليلها ، لا التوسعة منحصرة في الاكرام ولا التضييق منحصر في الاهانة والصغار ، وانما اتتهم الاهانة من حيث انهم لا يطيعون الله ، وربما كان بالتوسعة ، وربما كانت بالاقتار ، فربما عصي فوسع عليه اهانة له ، وهذا لمن يريد بالتوسعة ، وربما كانت بالاقتار ، فربما عصي فوسع عليه اهانة له ، وهذا لمن يريد سبحانه به الشقاء فيعجل له طيباته في الدنيا استدراجا ، وربما عصي فضيق عليه اكراما له لان ذلك يكفر عنه ، وفي الصحيح في حديث اقرع وابرص واعمري في بني اسراءيل شاهد عظيم لذلك .
 ولما زجر عن اعتقاد ان التوسعة للاكرام والتضييق للاهانة ، ذكر ان معيار من جبل علي حب الطاعة ومن جبل علي حب المعصية بغض الدنيا وحبها ، فقال معربا عن كلام الانسان في الشقين وافرد اولا لانه انص علي التعميم وجمع ثانيا اعلاما بان المراد الجنس ) بل ) اي يستهينون بامر الله بما عندهم من العصيان ، فيوسع علي بعض من  صفحة رقم 
 جبل علي الشقاء اهانة له بالاستدراج ويضيق علي بعض من لم يجبل علي ذلك اكراما له وردعا عن اتباع الهوي وردا الي الاحسان الي الضعفاء ، وترجم هذا العصيان الذي هو سبب الخذلان بقوله : ( لا يكرمون ) اي اكثر الناس ) اليتيم ( بالاعطاء ونحوه شفقة عليه ورحمة له لانه ضعيف لا يرجي من قبله نفع بثناء ولا غيره .
 ولما كان الانسان لا يمنعه من حث غره علي الخير الا حب الدنيا ان كان المحثوث اعظم منه فيدخره لحواءجه وان كان مثله فانه يخشي ان يقارضه بذلك فيحثه علي مسكين اخر ، وكان الاحسان بالحث علي الاعطاء اعظم من الاعطاء لانه يلزم منه الاعطاء بخلاف العكس ، قال : ( ولا يحضون ) اي يحثون حثا عظيما لاهلهم ولا لغيرهم ) علي طعام المسكين ) اي بذله له سخاء وجودا ، فكانت اضافته اليه اشارة الي انه شريك للغني ما له بقدر الزكاة .
 ولما دل علي حب الدنيا بامر خارجي ، دل عليه بامر في الانسان فقال تعالي : ( وياكلون ) اي علي سبيل التجديد والاستمرار ) التراث ) اي الميراث ، اصله وراث ابدلت الواو تار ، وكانه عبر عنه به دلالة علي اخذ الظاهر الذي تشير اليه الواو ، والتفتيش عن الباطن المشار اليه بمخرج التاء تفتيشا ربما ادي غلي اخذ بعض مال الغير : ( اكلا لما ) اي ذا لم اي جمع وخلط بين الحلال والحرام فانهم كانوا لا يءرثون النساء ولا الصبيان وياكلون ما جمعه المءرث وان كانوا يعلمون انه حرام ويقولون : لا يستحق المال الا من يقاتل ويحمي الحوزة .
 ولما كان ذلك قد يفعل عن ضرورة مع الكراهة قال ما هو صريح في المقصود : ( ويحبون ) اي علي سبيل الاستمرار ) المال ) اي هذا النوع من اي شء كان ، واكده بالمصدر والوصف فقال : ( حبا جما ) اي كثيرا مع حرص وشره ، فصار قصاري امرهم النظر الدنيوي ، ولم يصرفوا انفسهم عن حبه الي ما دعا اليه العقل الذي يعقل النفس عن الهوي ، والحجر الذي يحجرها عن الحظوظ ، والنهية التي تنهاها عن الشهوات الي الاقبال علي الله .
 ولما كان السياق هاديا الي ان التقدير : يحسبون ان ذلك يوفر اموالهم ويحسن احوالهم ويصلح بالهم ، زجر عنه بمجامع الزجر فقال : ( كلا ) اي ما هكذا ينبغي ان يكون الامر ، ثم استانف ذكر ما يوجب ندمهم وينبههم من رقدتهم ويعرفهم ان حب المال لا يقتضي نموه ، ولو اقتضي نموه ما اقتضي ايجابه للسعادة فقال : ( اذ دكت الارض ) اي حصل دكها ورجها وزلزلتها لتسويتها فتكون كالاديم الممدود بشدة المط لا عوج فيها بوجه ، واشار بالبيناء للمفعول الي سهولة ذلك لان الامر عظيم لعظمة  صفحة رقم 
 الفاعل الحق ، ولذلك قال : ( دكا دكا ) اي مكررا بالتوزيع علي كل موضع نات فيها ، فيكون لكل جبل واكمه وثنية وعقبة دك يخصه علي حدته ليفيد ذلك انه دك مبالغ فيه فتصير جبالها واكمامها هباء منثورا ثم تستوي حتي لا يكون فيها شء من عوج ، وهو كناية عن زلازل عظيمة لا تحملها الجبال الرواسي فيكف بغيرها .
 ولما دلت التسسوية علي مجء امر عظيم ، فان العادة في الدنيا ان الطرق لا تعم بالكنس او الرش او التسوية الا لحضور عظيم كالسلطان ، قال متطلفا بالمخاطب من اواخر سورة البروج الي هنا بذكر صفة الاحسان علي وجه يفتت اكباد اضداده ، ) وجاء ربك ) اي امر المحسن اليك باظهار رفعتك العظمي في ذلك اليوم الاعظم لفصل القضاء بين العباد بشفاعتك ) والملك ) اي هذا النوع حال كون الملاءكة مطفين ) صفا صفا ) اي موزعا اصطفافهم علي اصنافهم كل ، صنف صف علي حدة ، ويحيط اهل السماء الدنيا بالجن والانس ، واهل كل سماء كذلك ، وهم علي الضعف ممن احاطوا به حتي يحيطوا اهل السماء السابعة بالكل وهم علي الضعف من جميع من احاطوا به من الخلاءق ، ومعني مجيءه سبحانه وتعالي بعد ان ننفي عنه ان يشبه مجء شء من الخلق لانه سبحانه وتعالي ليس كمثله شء في ذاته ولا في صفاته ولا في افعاله ، فاذا صححنا العقد في ذلك في كل ما كان من المتشابه قلنا في هذا انه مثل امره سبحانه وتعالي في ظهور ايات اقتداره وتبيين اثار قدرته وقهره وسلطانه يحال الملك اذا حضر بنفسه فظهر بحضوره من اثار الهيبة والسياسة ما لا يظهر بظهور عساكره كلها خالية عنه ، فمجيءه عبارة عن حكمه واظهار عظمته وبطشه وكل ما يظهره الملوك اذا جاءوا الي مكان ، وهو سبحانه وتعالي شانه حاضر مع المحكوم بينهم بعلمه وقدرته ، لم يوصف بغيبة اصلا ازلا ولا ابدا ، فحضوره في ذلك الحال وبعده كما كان قبل ذلك من غير فرق اصلا ولم يتجدد شء غير تعليق قدرته علي حسب ارادته بالفصل بين الخلق ، ولو غاب في وقت او امكنت غيبته بحيث يحتاج الي المجء لكان محتاجا ، ولو كان محتاجا لكان عاجزا ، ولو عجز او امكن عجزه في حال من الاحوال لم يصلح للالهية  تعالي الله عما يقول الظالمون والجاحدون علوا كبيرا ، وفي تكرير ( صفا ) تنبيه علي صرف المجء عن حقيقته وارشاد الي ما ذكرت من التمثيل .
