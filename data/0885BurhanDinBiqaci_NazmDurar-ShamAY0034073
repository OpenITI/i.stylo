 ولما كان من المعلوم علي ما جرت به العواءد انهم يتاثرون من هذا القول فيحصل التشوق الي ما يكون من امرهم هل يجيبونهم ام تمنعهم هيبتهم علي ما كانوا في الدنيا ، اعلم بما يعلم منه انقطاع الاسباب هناك ، فلا يكون من احد منهم خوف من اخر ، فقال مستانفا : ( قالوا ) اي الاتباع المعبر عنهم بالفوج لسفولهم وبطون امرهم : ( بل انتم ) اي خاصة ايها الرءساء ) لا مرحبا ( وبينوا بقولهم : ( بكم ) اي هذا الذي دعوتم به علينا انتم احق به منا ، ثم عللوا قولهم بما افهم انهم شاركوهم في الضلال وزادوا عليهم بالاضلال فقالوا : ( انتم ) اي خاصة ) قدمتموه ) اي الاقتحام في العذاب بما اقحتمتونا فيه من اسبابه وقدمتم في دار الغرور من تزيينه ) لنا ( ولما كان الاقتحام وهو الوثوب او الدخول علي شء بسرعة كانها الوثوب ينتهي من الي استقرارا ، وكان الفريقان قد استقروا في مقاعدهم في النار ، سببوا عن ذلك قولهم : ( فبءس القرار ) اي قراركم .
 ولما كان قول الاتباع هذا مفهما لانهم علموا ان سبب ما وصلوا اليه من الشقاء هو الرءساء ، وكان هذا موجبا لنهاية غيظهم منهم ، تشوف السامع لما يكون من امرهم معهم ؟ هل يكتفون بما اجابوهم به او يكون امنهم شء اخر ؟ فاستانف قوله اعلاما بانهم لم يكتفوا بذلك وعلموا انهم لا يقدرون علي الانتقام منهم : ( قالوا ) اي الاتباع : ( ربنا ) اي ايها المحسن الينا الذي منعنا هءلاء عن الشكر له ) من قدم لنا هذا ) اي العذاب بما قدم لنا من الاسباب التي اقتحمناه ، وقدموا ذلك اهتماما به واجابوا الشرط بقولهم : ( فزده ) اي علي العذاب الذي استحقه بما استحققنا به نحن وهو الضلال ) عذابا ضعفا ) اي زاءدا علي ذلك مثله مرة اخري بالاضلال ، وقيدوه طلبا لفخامته بقولهم معبرين بالظرف لافهام الضيق الذي تقدم الدعاء المجاب فيه به ليكون عذابا اخر فهو ابلغ في الاعراف لان السياق هنا للطاغين وهناك الكافرين ) في النار ) اي كاءنا فيها ، وهذا مثل الاية الاخري ربنا اتهم ضعفين من العذاب والعنهم لعنا كبيرا اي مثل عذابنا مرتين .
 ولما ذكر من اقتحامهم في العذاب وتقاولهم بما دل علي خزيهم وحسرتهم وحزنهم ، اعلم بما دل علي زيادة خسرانهم وحسرتهم وهوانهم بمعرفتهم بنجاة المءمنين الذين كانوا يهزءون بهم ويذلونهم فقال : ( وقالوا ) اي الفريقان : الرءساء والاتباع بعد ان قضوا وطرهم مما لم يغن عنهم شيءا من تخاصمهم : ( ما ) اي اي شء حصل ) لنا ( مانعا في انا ) لا نري ) اي في المحل الذي ادخلناه ) رجالا ( يعنون فقراء  صفحة رقم 
 المءمنين ) كنا نعدهم ) اي في دار الدنيا ) من الاشرار ) اي الارذال الذين لا خير فيهم بانهم قد قطعوا الرحم ، وفرقوا بين العشيرة وافسدوا ذات البين ، وغيروا الدين بكونهم لا يزالون يخالفون الناس في اقوالهم وافعالهم ، مع ما كانوا فيه من الضعف والذل والهوان وسوء الحال في الدنيا ، فيظن اهلها نقص حظهم منه وكثرة مصاءبهم فيها لسوء حالهم عند الله وما دروا انه تعالي يحمي احباءه منها كما يحي الانسان عليله الطعام والشراب من يرد به خيرا يصب منه .
 ولما كانوا يسخرون من المءمنين ويستهزءون بهم ، وهم ليسوا موضعا لذلك ، بل حالهم في جدهم وجدهم في غاية البعد عن ذلك ، قالوا مستفهمين ، اما علي قراءة الحرمين وابن عامر وعاصم فتحقيقا ، واما علي قراءة غيرهم فتقديرا : ( اتخذناهم ) اي كلفنا انفسنا وعالجناها في اخذهم ) سخريا ) اي نسخر منهم ونستهزء بهم علي قراءة الكسر ، ونسخرهم اي نستخدمهم علي قراءة الضم ، وهم ليسوا اهلا لذلك ، بل كانوا خيرا منا فلم يدخلوا هنا لعدم شرارتهم ، وكانهم الي تجويز كونهم في النار معهم ومنعهم من رءيتهم اميل ، فدلوا علي ذلك بتانيث الفعل ناسبين خفاءهم عنهم الي رخاوة في ابصارهم علي قوتها في ذلك الحين فقالوا : ( ام زاغت ) اي مالت متجاوزة ) عنهم ( .
 ولما كان تعالي يعيد الخلق في القيامة علي غاية الاحكام في ابدانهم ومعانيها فتكون ابصارهم احد ما يمكن ان تكون وانفذه ) اسمع بهم وابصر يوم ياتوننا فبصرك اليوم حديد ( عدوا ابصارهم في الدنيا بالنسبة اليها عدما ، فلذلك عرفوا قولهم : ( الابصار ) اي منا التي لا ابصار في الحقيقة سواها فلم نرها وهم فينا ومعنا في النار ولكن حجبهم عنا بعض اوديتها وجبالها ولهبها .
 ف ) ام ( معادلة لجملة السخرية ، وقد علم بهاذ التقدير ان معني الاية الي انفصال حقيقي معناه : اهم معنا ام لا ؟ فهي من الاحتباك : اثبت الاتخاذ المذكور الذي يلزمه بحكم العناد بين الجملتين عدم كون المستسخر بهم معهم في النار اولا دليلا علي ضده ثانيا ، وهو كونهم معهم فيها ، واثبت زيغ الابصار ثانيا اللازم منه بمثل ذلك كونهم معهم في النار دليلا علي ضده اولا وهو كونهم ليسوا معهم ، وسر ذلك ان الموضع لتسحرهم ولومهم لانفسهم ، في غلطهم والذي ذكر عنهم اقعد في ذلك .
 ولما كان هذا امرا راءعا جدا زاجرا لمن له عقل فتامله مجردا لنفسه من الهوي ، وكانت الجدود تمنعهم عن التصديق به ، كان موضعا لتاكيد الخبر عنه فقال : ( ان ذلك ) اي الامر العظيم الذي تقدم الاخبار به ) لحق ) اي ثابت لا بد من وقوعه اذا وقع  صفحة رقم 
 مضمونة وافق الواقع منه هذا الاخبار عنه ، ولما كان اشق ما فيه وانكا تخاصمهم جعله هو المخبر به وحده ، فقال مبينا له مخبرا عن مبتدا استنافا تقديره : هو ) تخاصم اهل النار ( لانه ما اناره لهم الا الشر والنكد فسمي تخاصما .
