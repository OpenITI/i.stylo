 قال الشيخ الامام العالم القاضي العادل ابو العباس سيدي احمد بن سيدي الحسن بن عرضون الزجلي رحمه الله :
 الحمد لله الذي من علي عباده بالالفة تطولا وامتنانا، فاصبحوا بنعمته اخوانا، ونزع الحقد والغل من صدورهم فظلوا في الدنيا اصدقاء، وفي الاخرة رفقاء وخلانا، والصلاة والسلام علي مولانا محمد وعلي اله واصحابه والذين اتبعوه وتمسكوا بسنته، واقتدوا به قولا وفعلا وعدلا واحسانا ().
 اما بعد : فلما كان التودد والتحابب () في الله تعالي، والاخوة في دينه من افضل القربات والطف ما يستفاد من الطاعات، وان بمراعاة حقوقها وشروطها تصفو الاخوة عن شواءب الكدرات، وبالمحافظة عليها يتقرب الي الله تعالي وتنال الدرجات، وكان كثير ممن يدعي الاخوة والمحبة في هذه الازمان، لعدم مراعاتهم للشروط والحقوق ينزغ بينهم الشيطان، فتقع بينهم المنافرة والمقاطعة والمدابرة، والمنازعة، صار تعلم شروطها واسبابها وحقوقها وادابها، من اجل مايستفيد تعلمه من يريد الالفة علي الطاعة، والسلوك علي منهاج السنة والجماعة .
 وقد اردت ان اقيد في ذلك جملة كافية لنفسي، ولمن ارادها من ابناء جنسي، وينحصر الكلام فيها بحسب مقصدنا في مقدمة، وبابين، وخاتمة .
 اما المقدمة، ففي الصحبة معه تعالي، واما الباب الاول . ففي فضل الالفة والاخوة في الله، وشروطها، وفواءدها، واما الباب الثاني : ففي اداب الصحبة وحقوقها، واما الخاتمة، ففي اداب وحقوق مع ساءر الخلق .



![image file](./IbnCardun.AdabSuhba_.png)

 المقدمة : في الصحبة معه تعالي اعلم ان الصاحب الذي لا يفارق في السفر والحضر والنوم واليقظة هو الله تعالي، الخالق الرازق، فاتخذه صاحبا، وذرهم جانبا بمواصلة الحضور بلا فترة، ومهما فترت، جدد طهرك، واخل به ابدا، ملازما للاداب واياك ثم اياك ان تخلي ليلك ونهارك عن وقت تخلو فيه بنفسك مع مولاك، تتلذذ بمناجاته، وتتعرض لنفحات رحمته ومرضاته، وعليك ان تتعلم اداب الصحبة معه تعالي باطراق الطرف، وجمع الهم، ودوام الصمت وسكون الجوارح، ومبادرة الامر، واجتناب النهي، والتسليم لقدره تعالي، وملازمة الذكر والفكر، وايثار الحق، والخضوع تحت الهيبة والانكسار بالحياء، وقلة السعي في الكسب، ثقة بضمانه تعالي، وتوكلا عليه، والمراقبة والاستقامة ابدا، فانه اداب الصحبة مع من لايفارقك.



![image file](./IbnCardun.AdabSuhba_.png)




![image file](./IbnCardun.AdabSuhba_.png)

 الكلام في هذا الباب في فصلين : الفصل الاول : في فضيلة الالفة والاخوة : لاخفاء ان صحبة الصلحاء والفضلاء واخوتهم عون كبير، قال تعالي : «وتعاونوا علي البر والتقوي»، () وقال تعالي «اشداء علي الكفار رحماء بينهم» () وتامل تاثير الصحبة في كل شء، هذه الطيور المفترسة بالصحبة رفعت علي الملوك، وهذا العود بصحبة النجار يعتق من النار، وبصحبة الحطاب (تلتهمه) النار ولله در القاءل : عليك بارباب الصدور فمن غدا مضافا لارباب الصدور تصدرا واياك ان ترضي بصحبة ساقط فتنحط قدرا عن علاك وتحقرا
 واعلم ان الالفة ثمرة حسن الخلق، والتفرق ثمرة سوء الخلق، فالخلق الحسن، يزين فيوجب التحابب والتوالف، والخلق السء يشين فيوجب التباغض والتحاسد والتدابر، فحسن الخلق لاتخفي فضيلته، قال تعالي في مدح نبيه صلي الله عليه وسلم «وانك لعلي خلق عظيم»، () فالخلق الحسن صفة الانبياء والصديقين، وضده سموم قاتلة، فاعرف العلة، ثم شمر في علاجها، فالخلق قد يكتسب بالتعلم.
 قال السيد البلالي (ه) وكيف ينكر تغير الاخلاق، والكلب يعلم، والفرس والطير، اذ هي صفة الي اعتدال، وافراطها وتفريطها نقص، قال



![image file](./IbnCardun.AdabSuhba_.png)
 تعالي : «والكاظمين الغيض» () ولم يقل، والعادمين، كقوله «ولاتسرفوا» ()، وقوله : «وكان بين ذلك قواما»، () ويحصل الكمال، بحمل نفسه علي افعال تحليه، فمن كلفها افعال الجود ليصير طبعا، صار جوادا، وكذا افعال التواضع، وكل خلق فان للعادة اثرا عظيما بالدوام، فلا يستهين بقليل ذنوبه، او كسله، فيصير عادة تحرمه الخير، ويكتسب الخلق بالصحبة ايضا، لان الطبع يسرق من الطبع، لقوله صلي الله عليه وسلم «يحشر المرء علي دين خليله، فلينظر احد كم من يخالل» ()
 قيل للاحنف بن قيس : () ممن تعلمت الحلم ؟ قال من قيس بن عاصم المنقري، () قيل له، ومابلغك من خلقه ؟ قال : كان يوما قاعدا في مجلسه، اذ جاءته خادم له بسفود عليه شواء، فسقط السفود من يدها فوقع علي ابن له فمات، فدهشت الخادم، فقال لها : لاروعة عليك، انت حرة لوجه الله تعالي» :
 وقيل : من حسنت خلاءقه، وجبت محبته، ومالت القلوب اليه، ومن ساءت خلاءقه تعينت بغضته، ونفرت النفوس عنه، وانشدوا : اذا ساء خلق المرء لم يصف عيشه وضاقت عليه في الامور مذاهبه وذل وان كان العزيز ولم تنل مراتب اهل المكرمات مراتبه وجاهد من اخلاقه ما يمله علي مثلها اصحابه واقاربه وما حمد الناس امرءا ساء خلقه ولكن حسن الخلق يحمد صاحبه



![image file](./IbnCardun.AdabSuhba_.png)

 قال الغزالي : () «ولا يخفي ان ثمرة الخلق الحسن، الالفة وانقطاع الوحشة، ومهما طاب المثمر، طابت الثمرة، فكيف وقد ورد الثناء علي نفس الالفة سيما علي الدين والتقوي»، قال تعالي «لو انفقت ما في الارض جميعا ما الفت بين قلوبهم ولكن الله الف بينهم» ().
 وقال : «فاصبحتم بنعمته اخوانا» () اي بالالفة، وقال في ذم الفرقة «واعتصموا بحبل الله جميعا ولا تفرقوا» الي قوله : «لعلكم تهتدون» () وقال عليه السلام : «ان اقربكم مني مجلسا احاسنكم اخلاقا الموطءون اكنافا، الذين يالفون ويولفون» ().
 وقال صلي الله عليه وسلم «المومن الف مالوف، ولاخير فيمن لا يالف ولا يولف» () صح من الاحياء ().
 وقال الراجز : لا خير فيمن لم يكن الوفا
 ولم يكن لغيره مالوفا
 وروي : «مثل الاخوين كاليدين يغسل احدهما الاخري» ().
 وروي : «ما اصطحب اثنان قط الا كان احبهما الي الله ارفقهما بصاحبه» ().



![image file](./IbnCardun.AdabSuhba_.png)

 قال الغزالي : «وقال ابو ادريس الخولاني () لمعاذ : () اني احبك في الله، قال : ابشر ثم ابشر، فاني سمعت النبي صلي الله عليه وسلم يقول : ينصب لطاءفة من الناس كراسي حول العرش ومنابر من نور تضء عليها يوم القيامة، وجوههم كالقمر ليلة البدر، يفزع الناس ولا يفزعون، يخاف الناس ولا يخافون، هم اولياء الله الذين لا خوف عليهم ولا هم يحزنون، فقيل من هءلاء يا رسول الله، قال هم المتحابون في الله» (). اذا كان احدهما اعلي مقاما من الاخر رفع الاخر معه الي مقامه، وانه يلحق به كما يلحق الذرية بالابوين، والاهل بعضهم ببعض، لان الاخوة اذا اكتسبت في الله لم تكن دون اخوة الولادة، وقد قال تعالي : «الحقنا بهم ذرياتهم وما التناهم من عملهم من شء»، () وقال صلي الله عليه وسلم «سبعة يظلهم الله تحت عرشه يوم لاظل الا ظله، امام عادل، وشاب نشا في عبادة الله تعالي : ورجل قلبه متعلق بالمسجد اذا خرج منه حتي يعود اليه، ورجلان تحابا في الله، واجتمعا علي ذلك وتفرقا عليه، ورجل ذكر الله تعالي خاليا ففاضت عيناه، ورجل دعته امراة ذات حسن وجمال فقال : اني اخاف الله تعالي، ورجل تصدق بصدقة فاخفاها حتي لايعلم شماله ما تنفق يمينه «() قلت : وفي المعني انشدنا شيخنا ابو يوسف اليدري () بيتين : الاول منهما للاديب ابي زيد عبد الرحمن



![image file](./IbnCardun.AdabSuhba_.png)
 البردعي () احد ادباء فاس، والثاني للشيخ الامام ابي عبد الله محمد القوري () رحمه الله تعالي وهما هذان البيتان : يظل الله تحت العرش قوما وهم سبع كما قال المصدق امام شب في حب وجمع و وبكاء ومدعو تصدق
 فالبيت الثاني تضمن السبعة كلهم فتامله. ()
 قال الغزالي : وقال علي () كرم الله وجهه عليكم بالاخوان فانهم عدة في الدنيا والاخرة، الا تسمع الي قول اهل النار «فما لنا من شافعين ولاصديق حميم ().
 وقال عمر( رضي الله عنه : اذا اصاب احدكم ودا من اخيه فليتمسك به، فقل من يصيب ذلك، وقال مجاهد : () المتحابون في الله اذا التقوا



![image file](./IbnCardun.AdabSuhba_.png)
 فتبسم () بعضهم الي بعض تتحات عنهم الخطايا كما تتحات ورق الشجر في يوم عاصف، وقيل كما تتحات ورق الشجر في الشتاء اذا يبس، () وقال الفضيل : () نظر الرجل الي وجه اخيه علي المودة والرحمة عبادة» ().
 وقيل اعجز العجزة من الناس من فرط في كسب الاخوان، واعجز منه من فرط فيما ظفر به منهم . قلت : لاسيما المفرط في صحبة الصلحاء والفضلاء، فبصحبتهم يستفاد خير الدنيا والاخرة، قال البلالي : ولابد من صحبة كامل تغني عن مرادك لمراده ابدا، فنقب عنه ما خلا قطر من مثله، وبالله لا تعش بدونه فسلامتك مع غيره عزيزة، ووصلك اعز، فعدو عرفك عيبا انفع من اخ مداهن وكانوا رضي الله عنهم يحبون من ينبههم علي عيوبهم، واصل كل معصية وغفلة وشهوة، رضاك عن نفسك واصل كل طاعة ويقظة وعفة عدم رضاك عنها.



![image file](./IbnCardun.AdabSuhba_.png)




![image file](./IbnCardun.AdabSuhba_.png)

 اعلم انه لا يصلح للصحبة كل انسان، ولا كل من يصلح للصحبة في الحضر يصلح للصحبة في السفر، فقد يصلح لصحبة الحضر من لا يصلح لصحبة السفر، وكل من يصلح للصحبة في السفر يصلح في الحضر، فلابد للانسان ان يختار من يصلح للصحبة، قال صلي الله عليه وسلم «المرء علي دين خليله، فلينظر احد كم من يخالل» () واعلم ان الصحبة والعزلة اختلف ايهما ارجح، فرجح قوم الصحبة ورجح اخرون العزلة، واختار المحققون الجمع بينهما، فبهما يحصل الكمال، فبالصحبة يستفاد التعليم والتعلم، والنفع والانتفاع، والتاديب والتادب والاستيناس ونيل الثواب وانالته في القيام بالحقوق، ويكتسب الاخلاق الحسنة من الحلم والاحتمال والتواضع والالفة، واستفادة امور لازمة من التجارب ومشاهدة الاحوال، لما روي «انما العلم بالتعلم» () وبالعزلة يعمل بما علم لانسه بدوام الذكر، او معرفته بدوام الفكر يثمر حبه تعالي وهي الغاية، وسيلتها قطع علاءقه، واخراج محبة الغير، ودوام المجاهدة، ويقين بلا شك، وتوبة بلا ذنب، وزهد بلا رغبة، وتجريد بلا فترة، مظنتها العزلة بعد صحبة مرشد يرقيه بصدقه واخلاصه، وفناء مراده، ليبقي بصفات مرشده، ليتم امره بربه تعالي، فهناك نتاج الموهبة بازدواج الصحبة والعزلة، نعم، ويحتاج اليهما كل مرشد اذ قلبه كالموسي يحلق بخلوته، ويحلق بصحبته، فهذه فواءد الصحبة والعزلة، وقد اقتطفتها من كلام الامام الغزالي () والسيد البلالي رضي الله عنهما واعلم ان في العزلة ايضا فواءد اخر، منها : التخلص من المعاصي التي يتعرض لها غالبا بالخلطة من الغيبة والرياء، والسكوت عن الامر بالمعروف والنهي عن المنكر، ومسارقة الطبع من الاخلاق الرديءة .



![image file](./IbnCardun.AdabSuhba_.png)

 ومنها : الخلاص من الفتن وصيانة الدين والنفس، والخلاص من شر الناس واذاهم، لاسيما في هذه الازمنة التي كثرت فيها الفتن والمعاصي وقد قيل :
 اذا مارايت الشر يبعث اهله
 وقام جناة الشر للشر فانقد
 ذيل هذا البيت الوالد (ه) رحمه الله تعالي بقوله :
 وبيتك فالزم تنج من كل فتنة
 ومن صالح الاعمال دابا تزود
 واعلم ان الصحبة تقع اتفاقية واختيارية، فالاتفاقية كالصحبة بالجوار وسبب الاجتماع في المكتب او في المدرسة او في السوق، او علي باب ملك او في الاسفار، او في شء من المعاملات التي تقع بسبب الاضطرار، فقد يضطر الانسان لصحبة العامة، بل ولصحبة السفهاء، وفي صحبة العامة قيل : صحبناهم لما اضطررنا اليهم كما اضطر صياد الي صحبة الكلب وهل انا الا كالمصلي بقفرة اذا لم يجد ماء تيمم بالتراب
 وقد يضطر ايضا لصحبة السفهاء ليتقي بهم سفاهة من هو اشر منهم، فقد قيل : ضاع من لاسفيه له، ولما انشد النابغة () بين يدي النبي صلي الله عليه وسلم . ولا خير في حلم اذا لم تكن () له بوادر تحمي صفوه ان يكدرا ولاخير في جهل اذا لم يكن له حليم اذا ما اورد الامر اصدرا
 قال له رسول الله (ص) لايفضض الله فاك، () فكان من احسن الناس ثغرا، اذا سقط له سن نبت اخر مكانه، وقال مصعب بن الزبير : () «ماقل



![image file](./IbnCardun.AdabSuhba_.png)
 سفهاء قوم الا ذلوا وفي هذا المعني قال اخونا شقيقنا الفقيه الاديب النبيه ابو عبد الله محمد () حفظه الله وهداه : من لم يكن ذا كلاب عدت عليه الذءاب من لم يواخ سفيها كشط عنه الاهاب
 وهذا كله مع الاضطرار، ولابد من مراعات حقوق الجميع، وستاتي ار شاء الله في الخاتمة .
 واما الصحبة الاختيارية كمن اراد مصاحبة انسان لمرافقته في سفر او في عمل من الاعمال من شركة او غيرها او في امر دين، او علم، او غير ذلك من الفواءد المرادة، فقد تستفاد من الصحبة فواءد دينية ودنيوية، اما الدنيوية، فالانتفاع بالمال او بالجاه او بالنفس والاعانة باليد، او مجرد الاستيناس بالمشاهدة والمجاورة، واما الدينية، فيجتمع فيها ايضا اغراض مختلفة، منها : الاستفادة في العلم والعمل، ومنها الاستفادة من الجاه تحصنا به عن ايذاء من يشوش القلب، ويصد عن العبادة، ومنها : استفادة المال للاكتفاء به عن تضييع الاوقات في طلب القوت، ومنها : الاستعانة في المهمات، فيكون عدة في المصاءب، وعمدة في الاحوال، ومنها : التبرك بمجرد الدعاء، ومنها انتظار الشفاعة في الاخرة، فقد قال بعض السلف : استكثروا من الاخوان، فان لهم الشفاعة، ولكل مومن شفاعة، فلعلك تدخل في شفاعة اخيك، الي غير ذلك من الفواءد المرادة عند عقد الاخوة، فالاخوة في الدين واقعة في هذا القسم، ولا ثواب الا في الافعال الاختيارية، فلا ترغيب الا فيها :
 واعلم ان الصحبة عبارة عن المجالسة والمخالطة والمعاشرة، وهذه لا يقصد الانسان بها غيره الا اذا احبه، والمحبوب اما ان يحب لذاته، او لغرض فالغرض الذي يقصد، اما ان يكون من اغراض الدنيا، او يكون متعلقا بالاخرة اويكون متعلقا بالله، فهي اربعة اقسام :
 الاول : ان يكون محبوبا بذاته تتلذذ برءيته ومشاهدته، لاتصافه بحسن الخلقة، او حسن الخلق، وساءر الاوصاف المحمودة، او لمناسبة باطنة توجب الالفة



![image file](./IbnCardun.AdabSuhba_.png)
 والموافقة، فان شبيه الشء ينجذب اليه، وقد قيل : ان الطيور علي اشكالها تقع، وقد جاء : «الارواح جنود مجندة، فما تعارف منها اءتلف، وما تناكر منها اختلف» ().
 قال الناظم : اما سمعت عن الارواح ما ذكروا فيها وجاعت به الاثار والحجج ان التناكر يكسوها مخالفة وما تعارف منها فهو ممتزج
 وهذا الحب لا يدخل فيه الحب لله، بل هو حب بالطبع، ان اتصل به غرض مذموم صار مذموما، والا فهو مباح، اذ الحب اما محمود، واما مذموم، واما مباح.
 الثالي : ان يحبه لغرض دنيوي يتوصل به الي محبوب اخر، كحب الذهب والفضة ليتوصل بهما لقضاء الحاجات والمارب، كحب اهل الجاه لينتفع بجاههم في الدنيا، او اهل الصناءع، والحرف، والعلم ليقتبس منهم ما ينتفع به في دنياه وهذا ينقسم الي مذموم ومباح، ان قصد به التوصل الي مقاصد مذمومة فهو حب مذموم، والا فهو مباح .
 الثالث : ان يحبه لغرض اخروي، كمن يحب استاذه وشيخه لتحصيل العلم، وتحسين العمل، ان كان قصده الفوز في الاخرة، فهذا من جملة المحبين في الله، وكذلك من يحب تلميذه لينال بواسطته رتبة التعليم، اذ لا يتم التعليم الا بمعلم، وكذلك من يحب خدمته ليتفرغ بذلك للعلم والعمل والتفرغ لعبادة الله تعالي، فهو محب في الله، وكذلك من يحب من يواسيه بماله، ويقضي اغراضه بقصد الفراغ للعلم والعمل، والتقرب الي الله تعالي فهو محب في الله، وكذا من يحب زوجته لكونها حصنته عن الوساوس، وصان بها دينه، وليولد له ولد صالح يدعو له فهو محب في الله.
 قال الغزالي : وليس من شرط حب الله الا يحب في العاجل حظا البتة، اذ الدعاء الذي امر به الانبياء فيه جمع بين الدنيا والاخرة، قال : فكل حب لولا الايمان بالله واليوم الاخر لم يتصور وجوده، فهو حب لله تعالي، وكل زيادة



![image file](./IbnCardun.AdabSuhba_.png)
 في الله ().
 الرابع : ان يحب لله وفي الله لا لغرض، وهذا اعلي الدرجات، ويتفاوت الناس فيه بحسب تفاوتهم في حب الله تعالي، والمواساة بالمال هي علي قدر المحبة، فمنهم من يسمح بالشطر، ومنهم باقل من ذلك، فمقادير الاموال بموازين المحبة، والاجر والثواب في المحبة في الله ولله بقدر قوة المحبة .



![image file](./IbnCardun.AdabSuhba_.png)
 فمنهم من عد خمس () شروط تعتبر في الصاحب، وهي : العقل، والخلق الحسن، والصلاح، والزهد في الدنيا، والصدق، وعلي هذه الخمس اقتصر الامام الغزالي في الاحياء، () وبداية الهداية. () ومنهم من انهاها الي سبعة، فعد فيها ان يكون سليم الصدر، وان يكون ثابت العهد، وان يقوم بحقوقك كما تقوم بحقوقه . ومنهم من انهاها الي اربعة عشر، فعد فيها ان يكون عالما وعاملا وورعا وشفيقا ورفيقا وكريما وحليما ونصوحا وامينا، ومحبا للفقراء والخير واهله، وبقية الاربعة عشر، وبقية السبعة قبلها مذكورة في الخمسة الاولي . اما الشرط الاول : وهو العقل، فهو راس المال، وهو الاصل، فلا خير في صحبة الاحمق، فالي الوحشة والقطيعة يرجع اخرها، واخس احواله انه يضرك حيث يريد ان ينفعك، والعدو العاقل، خير من الصديق الاحمق قال علي رضي الله عنه : فلا تصحب اخا جهل واياك واياه فكم من جاهل اردي حليما حين واخاه يقاس المرء بالمرء اذا ما المره ماشاه وللشء علي الشء مقاييس واشباه وللقلب علي القلب دليل حين يلقاه ()



![image file](./IbnCardun.AdabSuhba_.png)

 ولذلك قيل : مقاطعة الاحمق قربان الي الله تعالي، قال الثوري () : النظر الي وجه الاحمق خطيءة مكتوبة، ويعني بالعاقل الذي يفهم الامور علي ما هي عليه اما بنفسه، واما اذا فهم وعلم، فقد قيل، الصحبة مع العاقل زيادة في الدين والصحبة مع الاحمق نقصان في الدين، وحسرة وندامة عند الموت، وخسارة في الاخرة .
 وقال عمر بن عبد العزيز : () اني لالتقي العاقل فاكون عاقلا اياما، ومن اسقط ذكر العاقل من الشروط استغني بالعلم والعمل، اذ العالم العامل، لا يكون الا عاقلا، والعالم العامل هو العاقل حقيقة، وبصحبته يستفيد الانسان العلم وينشط في العمل، كما ان صحبة العاقل تزيد في العقل .
 واما جسن الخلق : فلابد منه، اذ رب عاقل يدرك الاشياء علي ما هي عليه ولكن اذا غلبه غضب او شهوة او بخل او جبن اطاع هواه، وخالف ما هو المعلوم عنده، لعجزه عن فهمه صفاته، وتقويم اخلاقه، فلا خير في صحبته، وقد جمع علقمة العطاردي () في وصيته لابنه لما حضرته الوفاة قال : يابني ان عرضت لك صحبة انسان فاصحب من اذا خدمته صانك، وان صحبته زانك، وان قعدت بك مءنة، مانك، اصحب من اذا مددت يدك بخير مدها، وان راي منك حسنة عدها وان راي منك سيءة سدها، من اذا سالته اعطاك، وان. سكت ابتداك، وان نزلت بك نازلة، واساك، من اذا قلت قولا صدقك، وان حاولت امرا امرك، وان نازعته اثارك، () قال ابن اكثم، قال المامون : رو) فاين هذا ؟ قيل تدري لم اوصاه بذلك ؟ لانه اراد ان لا يصحب



![image file](./IbnCardun.AdabSuhba_.png)
 احدا، ( وقال بعض الادباء : لا تصحب من الناس من لا يكتم سرك، ويستر عيبك، ويكون معك في النواءب، ويوثرك بالرغاءب، وينشر حسنتك، ويطوي سيءتك فان لم تجده فلا تصحب الا نفسك «وقال علي رضي الله عنه : ان اخاك الحق من كان معك ومن يضر نفسه لينفعك ومن اذا ريب الزمان صدعك شتت شمل نفسه ليجمعك ()
 وقال يوسف بن الحسين () رضي الله عنه : احب من الاخوان كل موات وفي غضيض الطرف عن عترات يوافقني في كل امر احبه ويحفظني حيا وبعد ممات فمن لي بهذا ليتني قد وجدته فقاسمته مالي من الحسنات
 وقال الجنيد : () لان يصحبني فاسق حسن الخلق احب الي ان يصحبني قارء سء الخلق.
 واما الصلاح : فامر لابد منه ايضا، ولابد في الصاحب من وصفين : ان يكون سنيا في اعتقاده، وان يكون تقيا في دينه، فانه ان كان بدعيا او فاسقا ربما جر الناس الي مذهبه، او ظن الناس فيه ذلك، فان المرء علي دين خليله () كما قيل :
 عن المرء لا تسال وسل عن قرينه
 فكل قرين بالمقارن مقتدي
 فمن خالط العلماء والفضلاء حسب منهم، ومن خالط الاشرار والفجار حسب منهم.



![image file](./IbnCardun.AdabSuhba_.png)

 قال يوسف بن اسباط ر) : كان اعمامي قدرية، واخوالي رافشية، فانقذني الله تعالي بسفيان الثوري حين صحبته، فهذه فاءدة الصحبة، فلا تسحب فاسقا، ولا مصرا علي معصية ابدا، فمن لم يخف الله تعالي لا تومن عاءلته، ولا يرثق بصداقته، لانه يتغير لتغير الاغراض، قال تعالي : «ولا تطع من اغفلنا قبله عن ذكرنا واتبع هواه، () ومشاهدة الفاسق المصر تزيل الخوف من القلب، وتهون المعصية، لان الطبع يسرق وفي صحبة المبتدع ايضا خطر بسراية البدعة، وتعدي شءمها اليه .
 وقال عمر رضي الله عنه : «عليك باخوان الصدق تعش في اكنافهم فانهم زينة في الرخاء، وعدة في البلاء، وضع امر اخيك علي احسنه حتي يجيءك ما يغلبك منه، واعتزل عدوك، واحذر صديقك الا الامين، ولا امين الا من خشي الله، ولا تصحب الفاجر فتتعلم من فجوره، ولا تطلعه علي سرك، واستشر في امورك الذين يخشون الله.
 وقال السيد ابن عطاء الله : () «لا تصحب من لا ينهضك حاله، ولا بدلك علي الله مقاله، ربما () كنت مسيءا فاراك الاحسان منك (صحبتك)() الي من () هو اسوا حالا منك ()، قال ناظمه السيد ابن عباد : () () يوسف بن اسباط الشيباني واعظ زاهد روي عن سفيان الثوري وثقة ابن معين وقال فيه البخاري كان قد دفن كتبه فكان لا يجء بحديثه كما ينبغي انظر ميزان الاعتدال /. () سورة الكهف اية . ) احمد بن محمد بن عبد الكريم الاسكندري فقيه متصوف شاذلي الطريقة اخذ عن ابي العباس المرسي
