 [البقرة: ]
 
    
 وبه عن ابن عباس: {قالوا انءمن} [البقرة: ] يقول: انقول "
 
  قوله: {كما امن السفهاء} 
 [البقرة: ]
 
    
 وبه عن ابن عباس، قالوا: {انءمن كما امن السفهاء} [البقرة: ] يقولون: «انقول كما يقول السفهاء، يعنون اصحاب محمد صلي الله عليه وسلم بخلافهم لدينهم»
 
    
 حدثنا عصام بن الرواد، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية: {قالوا انءمن كما امن السفهاء} [البقرة: ] «يعنون اصحاب محمد صلي الله عليه وسلم» وكذا فسره السدي
 
  قوله تعالي: {الا انهم هم السفهاء} 
 [البقرة: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن العلاء، ثنا عثمان بن سعيد، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، يقول الله: {الا انهم هم السفهاء} [البقرة: ] يقول: الجهال "
 
  قوله: {ولكن لا يعلمون} 
 [البقرة: ]
 
    
 حدثنا علي بن الحسين، به، عن ابن عباس: {ولكن لا يعلمون} [البقرة: ] يقول: ولكن لا يعقلون "
 
  قوله تعالي: {واذا لقوا الذين امنوا قالوا امنا} 
 [البقرة: ]
 
    
 وبه عن ابن عباس، في قوله: {واذا لقوا الذين امنوا قالوا امنا} [البقرة: ] قال: " كان رجال من اليهود اذا لقوا اصحاب النبي صلي الله عليه وسلم او بعضهم قالوا: انا علي دينكم "
 
 حدثنا محمد بن يحيي، انبا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، مولي زيد بن ثابت، عن عكرمة او سعيد بن جبير، عن ابن عباس: {واذا لقوا الذين امنوا قالوا امنا} [البقرة: ] اي: «صاحبكم رسول الله، ولكنه اليكم خاصة»
 
  قوله: {واذا خلوا} 
 [البقرة: ]
 
    
 حدثنا ابو بكر بن ابي موسي الانصاري، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، ثنا اسباط بن نصر، عن السدي، عن ابي مالك، قوله: {خلوا} [البقرة: ] يعني: مضوا "
 
    
 حدثنا علي بن الحسين: ثنا محمد بن العلاء، ثنا عثمان بن سعيد، عن بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: " {واذا خلوا الي شياطينهم} [البقرة: ] وهم اخوانهم "
 
    
 حدثنا محمد بن يحيي، انبا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، قال: فيما حدثنا محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس، {واذا خلوا الي شياطينهم} [البقرة: ] من يهود الذين يامرونهم بالتكذيب وخلاف ما جاء به الرسول صلي الله عليه وسلم "
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا عبد الوهاب بن عطاء، عن سعيد، عن قتادة، قوله: {واذا خلوا الي شياطينهم} [البقرة: ] قال: الي رءساءهم وقادتهم في الشرك والشر "
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {واذا خلوا الي شياطينهم} [البقرة: ] الي اصحابهم من المنافقين والمشركين "
 
    
 حدثنا ابو بكر بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط بن نصر، عن السدي، عن ابي مالك، {واذا خلوا الي
  [ص: ]
 شياطينهم} [البقرة: ] يعني رءوس اليهود، وكعب بن الاشرف " قال ابو محمد: وكذا فسره ابو العالية، والسدي، والربيع بن انس
 
  قوله: {قالوا انا معكم} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، ثنا ابو غسان، ثنا سلمة، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، مولي زيد بن ثابت، عن عكرمة او سعيد بن جبير، عن ابن عباس: {قالوا انا معكم} [البقرة: ] اي: انا علي مثل ما انتم عليه "
 
  قوله: {انما نحن مستهزءون الله يستهزء بهم}
 
    
 حدثنا علي بن الحسين، ثنا محمد بن العلاء، ثنا عثمان بن سعيد، عن بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: {قالوا انا معكم انما نحن مستهزءون} «ساخرون باصحاب محمد صلي الله عليه وسلم» وروي عن قتادة، والربيع بن انس نحو ذلك
 
  قوله: {الله يستهزء بهم} 
 [البقرة: ]
 
    
 به عن ابن عباس: يقول الله عز وجل: {الله يستهزء بهم} [البقرة: ] «يسخر منهم للنقمة منهم»
 
  قوله: {ويمدهم} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، {يمدهم} [البقرة: ] يقول: يملي لهم "
 
  الوجه الثاني
 
    
 حدثنا الحسين بن الحسن، ثنا ابراهيم بن عبد الله بن حاتم الهروي، انبا الحجاج بن محمد، عن ابن جريج، عن مجاهد، {يمدهم} [البقرة: ] يزيدهم
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية، قوله {ويمدهم في طغيانهم يعمهون} [البقرة: ] يعني " يترددون يقول: زادهم ضلالا الي ضلالتهم، وعمي الي عماهم "
 
  قوله {في طغيانهم} 
 [البقرة: ]
 
    
 وبه عن ابي العالية، في قوله: {ويمدهم في طغيانهم} [البقرة: ] يعني في ضلالتهم "
 
  الوجه الثاني
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: {في طغيانهم} [البقرة: ] قال: في كفرهم " قال: ابو محمد: وتابع ابا العالية قتادة والربيع بن انس، وتابع ابن عباس السدي
 
  قوله: {يعمهون} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: {يعمهون} [البقرة: ] قال: يتمادون " وكذا فسره السدي، وخالفه اخرون فقالوا: يترددون
 
  الوجه الثاني
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: {يعمهون} [البقرة: ] قال: في كفرهم يترددون " وكذلك فسره مجاهد، وابو مالك، وابو العالية، والربيع بن انس
 
  والوجه الثالث
 
    
 حدثنا علي بن الحسن، ثنا عثمان بن ابي شيبة، ثنا معاوية بن هشام، عن سفيان، عن الاعمش، {في طغيانهم يعمهون} [البقرة: ] قال: يلعبون "
 
  في قوله: {اولءك الذين اشتروا} 
 [البقرة: ]
 
    
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انبا معمر، عن قتادة، في قوله: " {اولءك الذين اشتروا الضلالة بالهدي} [البقرة: ] قال: استحبوا الضلالة علي الهدي "
 
  قوله: {اشتروا الضلالة بالهدي} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير: عن ابن عباس، {اولءك الذين اشتروا الضلالة بالهدي} [البقرة: ] اي الكفر بالايمان "
 
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد،: {اولءك الذين اشتروا الضلالة بالهدي} [البقرة: ] امنوا ثم كفروا "
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: {اولءك الذين اشتروا الضلالة بالهدي} [البقرة: ] يقول: اخذوا الضلالة وتركوا الهدي "
 
  قوله: {فما ربحت تجارتهم وما كانوا مهتدين} 
 [البقرة: ]
 
    
 حدثنا الحسن بن ابي ربيع، انبا عبد الرزاق، ثنا معمر، عن قتادة، في قوله: {فما ربحت تجارتهم وما كانوا مهتدين} [البقرة: ] قال: هذه في المنافقين "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد بن ابي عروبة، عن قتادة: {فما ربحت تجارتهم وما كانوا مهتدين} [البقرة: ] قد والله رايتموهم فخرجوا من الهدي الي الضلالة، ومن الجماعة الي الفرقة، ومن الامن الي الخوف، ومن السنة الي البدعة، يقول: {فما ربحت تجارتهم وما كانوا مهتدين} [البقرة: ] "
 
  قوله: {مثلهم كمثل الذي استوقد نارا} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا ابو صالح كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: {مثلهم كمثل الذي استوقد نارا} [البقرة: ] قال: هذا مثل ضربه الله للمنافقين انهم كانوا يعتزون بالاسلام، فيناكحهم المسلمون ويقاسمونهم الفء، فلما ماتوا سلبهم الله ذلك العز كما سلب صاحب النار ضوءه "
 
    
 حدثنا عصام بن الرواد، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع بن انس، عن ابي العالية: {مثلهم كمثل الذي استوقد نارا} [البقرة: ] فانما ضوء النار ما اوقدتها، فاذا خمدت ذهب نورها، وكذلك المنافق كلما تكلم بكلمة الاخلاص بلا اله الا الله اضاء له، فاذا شك وقع في الظلمة "
 
    
 حدثنا عصام بن الرواد، ثنا ادم، ثنا ابو شيبة يعني شعيب بن رزيق، عن عطاء الخراساني، في قوله: {مثلهم كمثل الذي استوقد نارا} [البقرة: ] قال: هذا مثل المنافق
  [ص: ]
 يبصر احيانا ثم يدركه عمي القلب " وروي عن عكرمة، والحسن، والسدي، والربيع بن انس نحو قول عطاء الخراساني
 
  قوله تعالي: {فلما اضاءت ما حوله} 
 [البقرة: ]
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {فلما اضاءت ما حوله} [البقرة: ] اما اضاءة النار فاقبالهم الي المءمنين والهدي "
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: {فلما اضاءت ما حوله} [البقرة: ] «زعم ان اناسا دخلوا في الاسلام مقدم النبي صلي الله عليه وسلم المدينة، ثم انهم نافقوا فكان مثلهم كمثل رجل في ظلمة فاوقد نارا، فلما اضاءت ما حوله من قذي او اذي فابصره حتي عرف ما يتقي منها فبينما هو كذلك اذ اطفءت ناره فاقبل لا يدري ما يتقي من اذي، فذلك المنافق كان في ظلمة الشرك فاسلم فعرف الحلال والحرام، والخير من الشر، فبينما هو كذلك اذ كفر فصار لا يعرف الحلال من الحرام ولا الخير من الشر»
 
  قوله: {ذهب الله بنورهم} 
 [البقرة: ]
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {ذهب الله بنورهم} [البقرة: ] وذهاب نورهم: اقبالهم الي الكفار والضلالة "
 
  والوجه الثاني
 
    
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انا معمر، عن قتادة: «حتي اذا ماتوا يعني المنافقين، ذهب بنورهم»
 
  الوجه الثالث
 
    
 اخبرنا ابو الازهر احمد بن الازهر النيسابوري فيما كتب الي، ثنا وهب بن جرير، ثنا ابي، عن علي بن الحكم، عن الضحاك، في قوله: {ذهب الله بنورهم} [البقرة: ] «فهو ايمانهم الذي تكلموا به»
 
  قوله: {وتركهم في ظلمات} 
 [البقرة: ]
 
    
 ذكر ابو زرعة، ثنا سعيد بن محمد الجرمي، ثنا يحيي بن واضح ابو تميلة، ثنا ابو الحارث عبيد بن سليمان، عن الضحاك بن مزاحم: {وتركهم في ظلمات} [البقرة: ] قال: «هم اهل النار»
 
    
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، {وتركهم في ظلمات} [البقرة: ] يقول: «في عذاب اذا ماتوا»
 
  الوجه الثاني
 
    
 حدثنا محمد بن يحيي، انبا محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس، {وتركهم في ظلمات} [البقرة: ] «حتي خرجوا به من ظلمة الكفر طغوا بكفرهم به ونفاقهم فيه؛ فتركهم الله في ظلمات الكفر فهم لا يبصرون هدي ولا يستقيمون علي حق»
 
    
 اخبرنا ابو الازهر، فيما كتب الي، ثنا وهب بن جرير، ثنا ابي، عن علي بن الحكم، عن الضحاك، في قوله: «اما الظلمة فهي ضلالتهم وكفرهم»
 
    
 حدثنا الحسن بن احمد ابو فاطمة، ثنا ابراهيم بن عبد الله بن بشار الواسطي، ثنا سرور بن المغيرة بن زاذان ابن اخي منصور بن زاذان، عن عباد بن منصور، عن الحسن، في قوله: {وتركهم في ظلمات لا يبصرون} [البقرة: ] «فذلك حين يموت المنافق فيظلم عليه عمله عمل السوء، فلا يجد له عملا من خير عمل به يصدق به قول لا اله الا هو»
 
  قوله: {لا يبصرون} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس، {لا يبصرون} [البقرة: ] «اي لا يبصرون الحق يقولون»
 
  قوله تعالي {صم بكم عمي} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، {صم بكم عمي} [البقرة: ] يقول: «لا يسمعون الهدي، ولا يبصرونه، ولا يعقلونه»
 
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، {صم بكم} [البقرة: ] قال: «فهم الخرس العمي»
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد بن بشير، عن قتادة، {صم} [البقرة: ] عن الحق، فهم لا يسمعونه، {بكم} [البقرة: ] عنه فهم لا ينطقون به، {عمي} [البقرة: ] عنه فهم لا يبصرونه "
 
  قوله: {بكم} 
 [البقرة: ]
 
    
 حدثنا موسي بن ابي موسي الانصاري، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط بن نصر، عن السدي، عن ابي مالك، قوله {بكم} [البقرة: ] يعني خرسا عن الكلام بالايمان فلا يستطيعون الكلام {صم} [البقرة: ] يعني صم الاذان "
 
  قوله: {عمي} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد بن بشير، عن قتادة، قوله: " {عمي} [البقرة: ] قال: عمي عن الحق فهم لا يبصرونه "
 
  قوله: {فهم لا يرجعون} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، ثنا ابو غسان، ثنا سلمة، قال: قال محمد بن اسحاق: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس: {صم بكم عمي فهم لا يرجعون} [البقرة: ] «اي لا يرجعون الي هدي» وكذلك فسره الربيع بن انس
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: {صم بكم عمي فهم لا يرجعون} [البقرة: ] الي الاسلام "
 
  الوجه الثاني
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، يقول الله: {فهم لا يرجعون} [البقرة: ] «اي لا يتوبون ولا يذكرون»
 
  قوله: {او كصيب من السماء} 
 [البقرة: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا احمد بن بشير، عن هارون بن عنترة، عن ابيه، عن ابن عباس: {او كصيب من السماء} [البقرة: ] قال: «المطر» قال: ابو محمد: وكذلك فسره ابو العالية، والحسن، وسعيد بن جبير، ومجاهد، وعطاء، وعطية العوفي، وقتادة، وعطاء الخراساني، والسدي، والربيع بن انس
 
  الوجه الثاني
 
    
 حدثنا علي بن الحسين، ثنا ابو بكر بن ابي شيبة، ثنا مروان، عن جويبر، عن الضحاك: {او كصيب من السماء} [البقرة: ] قال: «هو السحاب»
 
  قوله: {فيه ظلمات} 
 [البقرة: ]
 
    
 ثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: {فيه ظلمات} [البقرة: ] يقول: «ابتلاء»
 
  الوجه الثاني
 
    
 حدثنا محمد بن يحيي، انا ابو غسان: ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، مولي زيد بن ثابت، عن عكرمة او سعيد بن جبير، عن ابن عباس: {فيه ظلمات} [البقرة: ] «اي هم في ظلمة ما هم فيه من الكفر والحذر من القتل علي الذي هم عليه من الخلاف والتخوف لكم، علي مثل ما وصف من الذي هو في ظلمة الصيب»
 
  الوجه الثالث
 
    
 اخبرنا ابو الازهر، فيما كتب الي، ثنا وهب بن جرير، ثنا ابي، عن علي بن الحكم، عن الضحاك: {فيه ظلمات} [البقرة: ] «اما الظلمة فالضلالة»
 
  قوله تعالي: {ورعد} 
 [البقرة: ]
 
    
 حدثنا ابو سعيد احمد بن محمد بن يحيي بن سعيد القطان، ثنا ابو احمد
  [ص: ]
 الزبيري، ثنا عبد الله بن الوليد، يعني من ولد معقل بن مقرن، حدثني بكير بن شهاب، عن سعيد بن جبير، عن ابن عباس، قال: اقبلت يهود الي رسول الله صلي الله عليه وسلم، فقالوا: يا ابا القاسم، اخبرنا ما هذا الرعد؟ قال: «ملك من ملاءكة الله موكل بالسحاب بيده، او في يده مخاريق من نار يزجر به السحاب ويسوقه حيث امره الله» قالوا: فما هذا الصوت الذي يسمع؟ قال: «صوته» قالوا: صدقت "
 
  الوجه الثاني
 
    
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، {ورعد} [البقرة: ] يقول: «تخويف»
 
  الوجه الثالث
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن ادريس، عن الحسن بن فرات، عن ابيه، عن ابي الجلد، قال: كتب اليه ابن عباس يساله عن الرعد، فكتب اليه: «ان الرعد ريح»
 
  قوله: {وبرق} 
 [البقرة: ]
 
    
 وبه عن ابي الجلد، قال: كتب اليه ابن عباس يساله عن البرق، فكتب اليه ان «البرق ماء»
 
    
 حدثنا علي بن المنذر الطريقي، ثنا ابن فضيل، ثنا عطاء بن السايب، عن الشعبي، قال: كتب ابن عباس الي ابي الجلد يساله عن البرق، وكان، عالما يقرا الكتب، فكتب اليه: «البرق من تلالء الماء»
 
  الوجه الثاني
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو نعيم، ثنا سفيان، عن سلمة بن كهيل، عن ابن اشوع، عن ربيعة بن الابيض، عن علي، قال: «البرق مخاريق الملاءكة»
 
    
 حدثنا ابي، ثنا سليمان بن حرب، وابو الربيع، واللفظ، لسليمان، قالا: ثنا حماد بن زيد، عن عبد الجليل، عن شهر بن حوشب، عن ابي هريرة، انه سءل عن البرق، فقال: «اصطفاق البرد»
  [ص: ]
 وقال ابو الربيع في حديثه: " البرق: اصطفاق البرد
 
    
 حدثنا ابي، ثنا ابو سلمة، ثنا حماد يعني ابن سلمة، عن عبد الجليل، عن شهر بن حوشب، قال عبد الله بن عمرو لرجل: سل كعبا عن البرق، فقال كعب: «البرق تصفيق ملك البرد» وحكي حماد بيده، لو ظهر لاهل الارض لصعقوا
 
    
 حدثنا ابي، ثنا عبيد الله بن موسي، انبا عثمان بن الاسود، عن مجاهد، قال: «البرق مصع ملك يسوق به السحاب»
 
  الوجه الثالث
 
    
 اخبرنا ابو الازهر احمد بن الازهر فيما كتب الي، ثنا وهب بن جرير، ثنا ابي، عن علي بن الحكم، عن الضحاك، في قوله: {فيه ظلمات ورعد وبرق} [البقرة: ] «فاما البرق فالايمان، عني بذلك اهل الكتاب»
 
  قوله: {يجعلون اصابعهم في اذانهم} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، قوله: {يجعلون اصابعهم في اذانهم من الصواعق} [البقرة: ] قال: كان المنافقون اذا حضروا مجلس النبي صلي الله عليه وسلم جعلوا اصابعهم في اذانهم فرقا من كلام النبي صلي الله عليه وسلم ان ينزل فيهم شء او يذكروا بشء فيقتلوا "
 
  قوله: {من الصواعق} 
 [البقرة: ]
 
    
 حدثنا علي بن المنذر الطريقي، ثنا ابن فضيل، ثنا عطاء بن السايب، عن الشعبي، قال: كتب ابن عباس الي ابي الجلد يساله عن الصواعق، فكتب اليه ان «الصواعق، مخاريق يزجر بها السحاب»
 
  قوله: {حذر الموت} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس: {يجعلون اصابعهم في اذانهم من الصواعق حذر الموت} [البقرة: ] «والحذر من
  [ص: ]
 القتل علي الذي هم عليه من الخلاف، والتخوف لكم علي مثل ما وصف من الذي هو في ظلمة الصيب»
 
  قوله تعالي: {والله محيط بالكافرين} 
 [سورة: البقرة، اية رقم: ]
 
    
 وبه عن ابن عباس: {والله محيط بالكافرين} [البقرة: ] يقول الله: «والله منزل ذلك بهم من النقمة اي محيط بالكافرين»
 
    
 اخبرنا علي بن المبارك، فيما كتب الي، ثنا زيد بن المبارك، ثنا ابن ثور، عن ابن جريج، عن مجاهد، في قوله: {والله محيط بالكافرين} [البقرة: ] قال: «جامعهم يوم القيامة في جهنم»
 
  الوجه الثاني
 
    
 حدثنا الحسن بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {والله محيط بالكافرين} [البقرة: ] قال: " جامعهم، يعني: يوم القيامة "
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن الدشتكي، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع بن انس: {والله محيط بالكافرين} [البقرة: ] «يبعثهم الله من بعد الموت، فيبعث اولياءه واعداءه فينبءهم باعمالهم» فذلك قوله: {والله محيط بالكافرين} [البقرة: ]
 
  قوله: {يكاد البرق} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: {يكاد البرق يخطف ابصارهم} [البقرة: ] يقول: «يكاد محكم القران يدل علي عورات المنافقين»
 
  قوله: {يخطف ابصارهم} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {يكاد البرق يخطف ابصارهم} [البقرة: ] ، «يلتمع ابصارهم ولما يخطف»
 
 حدثنا ابي، ثنا محمد بن ابي عمر العدني، ثنا سفيان، عن عمرو بن دينار، قال: «لم اسمع باحد ذهب البرق ببصره» لقول الله: {يكاد البرق يخطف ابصارهم} [البقرة: ]
 
  الوجه الثاني
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس، {يكاد البرق يخطف ابصارهم} [البقرة: ] «اي لشدة ضوء الحق»
 
  الوجه الثالث 
 
    
 اخبرنا علي بن المبارك، فيما كتب الي، ثنا زيد بن المبارك، ثنا ابن ثور، عن ابن جريج، عن مجاهد: {يكاد البرق يخطف ابصارهم} [البقرة: ] قال: " هذا مثل اخر، كما اذا كانوا في البر في المطر فرقوا من الصواعق، قال: هذا قول الله لمن شك من الكفار فيما جاء به محمد صلي الله عليه وسلم "
 
  قوله: {كلما اضاء لهم مشوا فيه} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: {كلما اضاء لهم مشوا فيه} [البقرة: ] يقول: " كلما اصاب المنافقون من الاسلام خيرا اطمانوا اليه، وان اصاب الاسلام نكبة قاموا ليرجعوا الي الكفر، ثم اذا اظلم عليهم قاموا، كقوله: {ومن الناس من يعبد الله علي حرف فان اصابه خير اطمان به} [الحج: ] الي اخر الاية "
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس، {كلما اضاء لهم مشوا فيه واذا اظلم عليهم قاموا} [البقرة: ] اي يعرفون الحق ويتكلمون به فهم من قولهم به علي استقامة، فاذا ارتكسوا منه الي الكفر قاموا اي متحيرين "
 
 حدثنا عصام بن رواد العسقلاني، بها، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قوله: {كلما اضاء لهم مشوا فيه واذا اظلم عليهم قاموا} [البقرة: ] «فمثله كمثل قوم ساروا في ليلة مظلمة لها مطر ورعد وبرق علي جادة كلما ابرقت ابصروا الجادة فمضوا فيها فاذا ذهب البرق تحيروا فكذلك المنافق كلما تكلم بكلمة الاخلاص اضاء له، وكلما شك تحير ووقع في الظلمة» قال ابو محمد: وروي عن الحسن، وقتادة، والسدي، والربيع بن انس نحو ذلك
 
  قوله: {اذا اظلم عليهم قاموا} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس: {واذا اظلم عليهم قاموا} [البقرة: ] «اي متحيرين»
 
  قوله: {لو شاء الله لذهب بسمعهم وابصارهم} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، {ولو شاء الله لذهب بسمعهم وابصارهم} [البقرة: ] قال: «ذكر اسماعهم وابصارهم التي عاثوا بها في الناس»
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: فيما حدثنا محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس، {ولو شاء الله لذهب بسمعهم وابصارهم} [البقرة: ] «اي لما تركوا من الحق بعد معرفته، ان الله علي كل شء قدير»
 
  قوله: {ان الله علي كل شء قدير} 
 [البقرة: ]
 
    
 حدثنا محمد بن العباس، ثنا محمد بن عمرو زنيج، ثنا سلمة، قال محمد بن اسحاق: {ان الله علي كل شء قدير} [البقرة: ] «اي ان الله علي كل ما اراد بعباده من نقمة او عفو قدير»
 
  قوله تعالي: {يا ايها الناس} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن
  [ص: ]
 اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس: {يا ايها الناس} [البقرة: ] «اي الفريقين جميعا من الكفار والمنافقين»
 
  قوله: {اعبدوا ربكم} 
 [البقرة: ]
 
    
 وبه عن ابن عباس: قوله {يا ايها الناس اعبدوا ربكم} [البقرة: ] «اي وحدوا ربكم»
 
  قوله: {الذي خلقكم والذين من قبلكم} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: {يا ايها الناس اعبدوا ربكم الذي خلقكم والذين من قبلكم} [البقرة: ] يقول: «خلقكم وخلق الذين من قبلكم» وروي عن مجاهد نحو ذلك
 
  قوله: {لعلكم} 
 [البقرة: ]
 
    
 حدثنا موسي بن ابي موسي الانصاري، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، ثنا اسباط، عن السدي، عن ابي مالك، قوله: {لعلكم} [البقرة: ] " يعني غير اية في الشعراء {لعلكم تخلدون} [الشعراء: ] يعني كانكم تخلدون "
 
  قوله: {لعلكم تتقون} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد العسقلاني، ثنا ادم، ثنا ابو صفوان القاسم بن يزيد بن عوانة، عن يحيي ابي النضر، ثنا جويبر، عن الضحاك، في قوله: {لعلكم تتقون} [البقرة: ] قال: يقول: «لعلكم تتقون النار بالصلوات الخمس»
 
  الوجه الثاني
 
    
 حدثنا موسي بن عبد الرحمن المسروقي، ثنا ابو داود الحفري، عن سفيان، عن ابن ابي نجيح، عن مجاهد: {لعلكم تتقون} [البقرة: ] «لعلكم تطيعونه»
 
  قوله تعالي: {الذي جعل لكم الارض فراشا} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد العسقلاني، ثنا ادم، ثنا ابو جعفر يعني الرازي، عن الربيع، عن ابي العالية: {الذي جعل لكم الارض فراشا} [البقرة: ] قال: «مهادا»
 
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: {الذي جعل لكم الارض فراشا} [البقرة: ] «اما فراشا، فهي فراش يمشي عليها، وهي المهاد والقرار» وروي عن قتادة، والربيع بن انس نحو ذلك
 
  قوله: {والسماء بناء} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا محمد بن بشار، ثنا وهب بن جرير، ثنا ابي قال: سمعت محمد بن اسحاق، يحدث عن يعقوب بن عتبة، وجبير بن محمد بن جبير بن مطعم، عن ابيه، عن جده: قال رسول الله صلي الله عليه وسلم: «ويحك، اتدري ما الله؟ ان الله علي عرشه، وعرشه علي سماواته، وسماواته علي ارضيه هكذا» ، وقال باصبعه مثل القبة
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: {والسماء بناء} [البقرة: ] " اما {السماء بناء} [البقرة: ] ، فبناء السماء علي الارض كهيءة القبة وهي سقف علي الارض " وروي عن قتادة نحو ذلك
 
  قوله: {وانزل من السماء ماء} 
 [البقرة: ]
 
    
 حدثنا احمد بن الفضل العسقلاني، ثنا بشر بن بكر، حدثتني ام عبد الله، يعني ابنة خالد بن معدان، عن ابيها، قال: «ان المطر ماء يخرج من تحت العرش، فينزل من سماء الي سماء، حتي يجتمع في السماء الدنيا، فيقع في شء يقال له الابزم فيجتمع فيه، ثم يجء السحاب السوداء فتدخله فتشربه مثل شرب الاسفنجة، فيسوقها الله حيث يشاء»
 
    
 حدثنا ابي، ثنا احمد بن حنبل، ثنا عباد بن العوام، ثنا سفيان بن حسين، عن الحكم، عن ابي ظبيان، عن ابن عباس، قال: «يرسل الله الريح فتحمل الماء من السحاب فيمر به السحاب فتدره كما تدر الناقة، وثجاج مثل العزالي غير انه مفرق»
 
  قوله: {فاخرج به من الثمرات رزقا لكم} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا علي بن جعفر الاحمر، ثنا محمد بن سليمان بن الاصبهاني، عن عمه عبد الرحمن، عن عكرمة، قال: «ما انزل الله من السماء قطرة الا انبت بها في الارض عشبة او في البحر لءلءة»
 
  قوله تعالي: {فلا تجعلوا لله اندادا} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر، يعني ابن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: {فلا تجعلوا لله اندادا} [البقرة: ] قال: «اشباها»
 
    
 حدثنا احمد بن عمرو بن ابي عاصم الضحاك بن مخلد، حدثني ابي عمرو، حدثني ابو عاصم، انبا شبيب بن بشر، ثنا عكرمة، عن ابن عباس، في قوله: {فلا تجعلوا لله اندادا} [البقرة: ] قال: " الانداد هو الشرك، اخفي من دبيب النمل علي صفاة سوداء في ظلمة الليل، وهو ان يقول: والله، وحياتك يا فلانة، وحياتي، ويقول: لولا كلبه هذا لاتانا اللصوص، ولولا البط في الدار لاتي اللصوص، وقول الرجل لصاحبه: ما شاء الله وشءت، وقول الرجل: لولا الله وفلان، لا تجعل فيها فلانا؛ فان هذا كله به شرك "
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قوله: {اندادا} [البقرة: ] اي عدلا شركا " وروي عن الربيع بن انس، وقتادة، والسدي، وابي مالك، واسماعيل بن ابي خالد نحو ذلك
 
  قوله: {وانتم تعلمون} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير عن ابن عباس: {فلا تجعلوا لله اندادا وانتم تعلمون} [البقرة: ] «اي لا تشركوا بالله غيره من الانداد التي لا تنفع ولا تضر، وانتم تعلمون انه لا رب لكم يرزقكم غيره، وقد علمتم الذي يدعوكم اليه الرسول من توحيده هو الحق لا يشك فيه»
 
    
 اخبرني عمرو بن ثور القيساري، فيما كتب الي، ثنا الفريابي، ثنا سفيان، عمن حدثه عن مجاهد، في قوله: {فلا تجعلوا لله اندادا وانتم تعلمون} [البقرة: ] قال: «تعلمون انه اله واحد في التوراة والانجيل»
 
    
 حدثنا محمد بن يحيي، ثنا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: {فلا تجعلوا لله اندادا وانتم تعلمون} [البقرة: ] «ان الله خلقكم وخلق السماوات والارض، ثم انتم تجعلون له اندادا»
 
  قوله تعالي: {وان كنتم في ريب} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، ثنا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس: {وان كنتم في ريب مما نزلنا علي عبدنا} [البقرة: ] «اي في شك مما جاءكم به»
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قوله {وان كنتم في ريب} [البقرة: ] قال: «في شك» وكذلك فسره الحسن، وقتادة، والربيع بن انس
 
  قوله: {مما نزلنا علي عبدنا} 
 [البقرة: ]
 
    
 حدثنا الحسن بن احمد، ثنا ابراهيم بن عبد الله بن بشار، ثنا سرور بن المغيرة، عن عباد بن منصور، عن الحسن، في قوله: {وان كنتم في ريب مما نزلنا علي عبدنا} [البقرة: ] «فهذا قول الله لمن شك من الكفار فيما جاء به محمد صلي الله عليه وسلم»
 
  قوله تعالي: {فاتوا بسورة من مثله} 
 [البقرة: ]
 
    
 حدثنا الحسن بن محمد الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، {فاتوا بسورة من مثله} [البقرة: ] قال: «مثل القران»
 
    
 حدثنا ابو زرعة، ثنا العباس بن الوليد النرسي، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، قوله {فاتوا بسورة من مثله} [البقرة: ] قال: «من مثل هذا القران حقا وصدقا لا باطل فيه ولا كذب»
 
    
 حدثنا الحسن بن احمد ابو فاطمة، ثنا ابراهيم بن عبد الله بن بشار الواسطي، ثنا سرور بن المغيرة، عن عباد بن منصور، عن الحسن، في قوله: {فاتوا بسورة من مثله} [البقرة: ] قال: «فلا يستطيعون والله ان ياتوا بسورة من مثله ولو حرصوا»
 
  قوله: {وادعوا شهداءكم من دون الله ان كنتم صادقين} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن
  [ص: ]
 اسحاق، فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير عن ابن عباس: {وادعوا شهداءكم} [البقرة: ] «من استطعتم من اعوانكم علي ما انتم عليه ان كنتم صادقين»
 
    
 حدثنا ابو بكر بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك: {وادعوا شهداءكم من دون الله} [البقرة: ] يعني شركاءكم "
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، {وادعوا شهداءكم} [البقرة: ] قال: «ناس يشهدون به»
 
  قوله {فان لم تفعلوا ولن تفعلوا} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد بن بشير، عن قتادة، {فان لم تفعلوا} [البقرة: ] «فان لم تطيقوه ولن تطيقوه فاتقوا النار»
 
  قوله: {فاتقوا النار التي وقودها الناس والحجارة} 
 [البقرة: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن مسعر، عن عبد الملك بن ميسرة، عن ابن سابط، عن عمرو بن ميمون، عن عبد الله بن مسعود، قال: " ان الحجارة التي سماها الله في القران {وقودها الناس والحجارة} [البقرة: ] حجارة من كبريت خلقها الله تعالي عنده كيف يشاء "
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، {فاتقوا النار التي وقودها الناس والحجارة} [البقرة: ] فاما الحجارة فهي حجارة في النار من كبريت اسود، يعذبون به مع النار "
 
    
 حدثنا ابي، ثنا محمد بن عبد الرحمن ابن ابنة عبد الملك بن ابي سليمان العرزمي، ثنا ابي، عن جدي، عن ابن ابي نجيح، عن مجاهد، {فاتقوا النار التي وقودها الناس والحجارة} [البقرة: ] قال: «حجارة انتن من الجيفة من كبريت» قال ابو محمد: وروي عن ابي جعفر محمد بن علي قال: «حجارة من كبريت»
 
 اخبرنا علي بن المبارك، فيما كتب الي، ثنا زيد بن المبارك، ثنا ابن ثور، عن ابن جريج، عن عمرو بن دينار، {فاتقوا النار التي وقودها الناس والحجارة} [البقرة: ] قال: «حجارة اصلب من هذه الحجارة واعظم»
 
  قوله تعالي: {اعدت للكافرين} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس: {اعدت للكافرين} [البقرة: ] «اي لمن كان علي مثل ما انتم عليه من الكفر»
 
  قوله تعالي {وبشر الذين امنوا وعملوا الصالحات ان لهم جنات تجري من تحتها الانهار} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله {وبشر الذين امنوا} [البقرة: ] يقول: «بشرهم بالنصر في الدنيا، والجنة في الاخرة»
 
  قوله: {الذين امنوا} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا نصر بن علي، اخبرني ابي، عن خالد بن قيس، عن قتادة، في قوله: " المءمن، قال: يعني الذي امن بكتابه "
 
  قوله: {وعملوا الصالحات} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا ابراهيم بن موسي، ثنا هشام بن يوسف، عن ابن جريج، قال: وقال عطاء: عن ابن عباس، قال: " اعمال الصالحة: سبحان الله، والحمد لله، ولا اله الا الله، والله اكبر "
 
  قوله: {ان لهم جنات تجري من تحتها الانهار} 
 [البقرة: ]
 
    
 قرء علي الربيع بن سليمان، ثنا اسد بن موسي، ثنا ابن ثوبان، عن عطاء بن قرة، عن عبد الله بن ضمرة، عن ابي هريرة، قال: قال رسول الله صلي الله عليه وسلم: «انهار الجنة تفجر من تحت تلال او من تحت جبال المسك»
 
 حدثنا ابو بكر بن ابي موسي الانصاري، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك، قوله {تجري من تحتها الانهار} [البقرة: ] يعني: «المساكن تجري اسفلها انهارها»
 
    
 حدثنا ابو سعيد الاشج، ثنا وكيع، عن الاعمش، عن عبد الله بن مرة، عن مسروق، قال: قال عبد الله: «انهار الجنة تفجر من جبل مسك»
 
  قوله: {كلما رزقوا منها من ثمرة رزقا} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية يعني {كلما رزقوا منها من ثمرة رزقا} [البقرة: ] قال: " كلما اوتوا منه بشء، ثم اوتوا باخر قالوا: هذا الذي اوتينا من قبل "
 
  الوجه الثاني
 
 حدثنا المنذر بن شاذان، ثنا هوذة، ثنا عوف، عن علي بن زيد، قال: {كلما رزقوا منها من ثمرة رزقا} [البقرة: ] قال: «يعني به ما رزقوا به من فاكهة الدنيا قبل الجنة»
 
  قوله تعالي: {قالوا هذا الذي رزقنا من قبل} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: اما قوله {هذا الذي رزقنا من قبل} [البقرة: ] " فانهم اتوا بالتمرة في الجنة، فلما نظروا اليها قالوا: هذا الذي رزقنا من قبل من الدنيا "
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {كلما رزقوا منها من ثمرة رزقا قالوا هذا الذي رزقنا من قبل} [البقرة: ] يقولون: " ما اشبهه به، يقول: من كل صنف مثل "
 
    
 حدثني ابو عبد الله الطهراني، انبا حفص بن عمر العدني، ثنا الحكم بن ابان، عن عكرمة، في قوله {هذا الذي رزقنا من قبل} [البقرة: ] قال: معناه «مثل الذي كان بالامس» وروي عن قتادة، والربيع بن انس نحو ذلك
 
  قوله: {واتوا به متشابها} 
 [البقرة: ]
 
    
 حدثنا احمد بن سنان الواسطي، ثنا ابو معاوية، عن الاعمش، عن ابي ظبيان، عن ابن عباس، قال: «ليس في الجنة شء يشبه ما في الدنيا الا الاسماء»
 
 حدثنا ابي، ثنا سعيد بن سليمان، ثنا عامر بن يساف، عن يحيي بن ابي كثير، قال: " عشب الجنة الزعفران، وكثبانها المسك، ويطوف عليهم الولدان بالفواكه فياكلونها، ثم يءتون بمثلها فيقول لهم اهل الجنة: هذا الذي اتيتمونا به انفا، فيقول لهم الولدان: كلوا فان اللون واحد، والطعم مختلف، وهو قول الله: {واتوا به متشابها} [البقرة: ] "
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية: {واتوا به متشابها} [البقرة: ] «يشبه بعضه بعضا، ويختلف في الطعم» وروي عن مجاهد، والضحاك، والربيع بن انس، والسدي نحو ما حكينا عن ابي العالية
 
    
 اخبرنا العباس بن الوليد بن مزيد، قراءة اخبرنا ابن شعيب، يعني محمد بن شعيب بن شابور، اخبرني سعيد بن بشير، عن قتادة، انه حدثهم عن قول الله: {واتوا به متشابها} [البقرة: ] يقول: «شبه ثمار الدنيا، وهي خيار كلها ليس يرذل منها شء» وروي عن عكرمة نحو قول ابن عباس
 
  قوله: {ولهم فيها ازواج مطهرة} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، {ازواج مطهرة} [البقرة: ] يقول: «مطهرة من القذر والاذي»
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، في قوله {ازواج مطهرة} [البقرة: ] قال: «مطهرة من الحيض والغاءط والبول والنخام والبزاق والمني والولد»
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا عبد الوهاب بن عطاء، عن سعيد، وابان، عن قتادة، {لهم فيها ازواج مطهرة} [النساء: ] قال: «مطهرة من الاذي والماثم»
 
    
 حدثنا ابي، ثنا ابن نفيل، ثنا خليد، عن قتادة: {ازواج مطهرة} [البقرة: ] قال: «لا حيض، ولا كلف» قال ابو محمد: وروي عن عطاء، والحسن، والضحاك، وابي صالح، وعطية، والسدي نحو ما تقدم من التفسير
 
  قوله: {وهم فيها خالدون} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة بن الفضل، عن محمد يعني ابن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير عن ابن عباس: {وهم فيها خالدون} [البقرة: ] «اي خالدون ابدا، يخبرهم ان الثواب بالخير والشر مقيم علي اهله ابدا لا انقطاع له»
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير في قول الله: {وهم فيها خالدون} [البقرة: ] يعني: «لا يموتون»
 
  قوله تعالي: {ان الله لا يستحيي ان يضرب مثلا ما بعوضة فما فوقها} 
 [البقرة: ]
 
    
 حدثنا عصام بن الرواد بن الجراح العسقلاني، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قوله {ان الله لا يستحيي ان يضرب مثلا ما بعوضة فما فوقها} [البقرة: ] «فاذا جاءت اجالهم وانقطعت مدتهم، صاروا كالبعوضة تحيا ما جاعت، وتموت اذا رويت، فكذلك هءلاء الذين ضرب لهم هذا المثل اذا امتلءوا من الدنيا ريا اخذهم الله فاهلكهم»
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله {ان الله لا يستحيي ان يضرب مثلا ما بعوضة فما فوقها} [البقرة: ] «الامثال كبيرها وصغيرها، يءمن به المءمنون، ويعلمون انه الحق من ربهم فاخذهم الله فاهلكهم»
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله {ان الله لا يستحيي ان يضرب مثلا ما بعوضة فما فوقها} [البقرة: ] «الامثال كبيرها وصغيرها، يءمن به المءمنون، ويعلمون انه الحق من ربهم ويهديهم الله به»
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، قال: " فلما ضرب الله هذين المثلين للمنافقين، قال المنافقون: الله اعلي واجل من ان يضرب هذه الامثال "، فانزل الله: {ان الله لا يستحيي ان يضرب مثلا ما بعوضة فما فوقها} [البقرة: ]
 
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انبا معمر، عن قتادة، قال: " لما ذكر الله تبارك وتعالي العنكبوت والذباب، قال المشركون: ما بال العنكبوت والذباب يذكران؟ فانزل الله: {ان الله لا يستحيي ان يضرب مثلا ما بعوضة فما فوقها} [البقرة: ] وروي عن الحسن، واسماعيل بن ابي خالد نحو قول السدي، وقتادة
 
  قوله: {فاما الذين امنوا} 
 [البقرة: ]
 
    
 اخبرنا محمود بن ادم، فيما كتب الي، قال: سمعت النضر بن شميل، يقول: «تفسير المءمن انه امن من عذاب الله»
 
  قوله تعالي: {فيعلمون انه الحق من ربهم} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد، ثنا ابو جعفر، عن الربيع، عن ابي العالية: {فاما الذين امنوا فيعلمون انه الحق من ربهم} [البقرة: ] «يعني هذا المثل»
 
  والوجه الثاني
 
    
 حدثنا ابو زرعة، ثنا العباس بن الوليد النرسي، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: {فاما الذين امنوا فيعلمون انه الحق من ربهم} [البقرة: ] «اي يعلمون انه كلام الرحمن»
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، اخبرني سعيد بن بشير، عن قتادة مثله، وزاد: انه كلام الرحمن وانه من عند الله وروي نحو ذلك عن الربيع بن انس، ومجاهد
 
    
 حدثنا الحسن بن احمد ابو فاطمة، ثنا ابراهيم بن عبد الله بن بشار، حدثني سرور بن المغيرة، عن عباد بن منصور، عن الحسن، في قوله {فاما الذين امنوا فيعلمون انه الحق من ربهم} [سورة: البقرة، اية رقم: ] «اي يعلمون انهم ابتلوا بذلك ليعلم الله من يعرف امره ويصدق قوله ويستيقن بما انزل الله من كتابه انه حق وان ما قال كما قال»
 
  قوله: {واما الذين كفروا فيقولون ماذا اراد الله} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان بن صالح، ثنا الوليد، اخبرنا سعيد، عن قتادة: {واما الذين كفروا} [سورة: البقرة، اية رقم: ] : " في قلوبهم مرض، {فيقولون ماذا اراد الله بهذا مثلا} [سورة: البقرة، اية رقم: ] "
 
  قوله: {فيقولون ماذا اراد الله بهذا مثلا} 
 [البقرة: ]
 
    
 اخبرنا علي بن المبارك، فيما كتب الي، ثنا زيد بن المبارك، ثنا ابن ثور، عن ابن جريج {فيقولون ماذا اراد الله بهذا مثلا} [البقرة: ] قال: قال غير مجاهد: " قال ذلك الكافرون لما سمعوا ذكر العنكبوت والذباب وغير ذلك لما ضربه مثلا من خلقه في كتابه، قالوا: {ماذا اراد الله بهذا مثلا} [البقرة: ] اي ذكر العنكبوت والذباب، فقال: {ان الله لا يستحيي ان يضرب مثلا} [البقرة: ] "
 
  قوله: {يضل به كثيرا} 
 [البقرة: ]
 
    
 حدثنا اسحاق بن سليمان، عن ابي سنان، عن عمرو بن مرة، عن مصعب بن سعد، عن سعد: {يضل به كثيرا} [البقرة: ] «يعني الخوارج»
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية: {واما الذين كفروا فيقولون ماذا اراد الله بهذا مثلا يضل به كثيرا ويهدي به كثيرا وما يضل به الا الفاسقين} [البقرة: ] «فهم اهل النفاق» وروي عن الربيع بن انس نحوه
 
  قوله: {ويهدي به كثيرا} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: {ويهدي به كثيرا} [البقرة: ] «يعني به المءمنين»
 
  قوله: {وما يضل به الا الفاسقين} 
 [البقرة: ]
 
    
 وبه عن السدي، {وما يضل به الا الفاسقين} [البقرة: ] قال: «هم المنافقون»
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، اخبرني سعيد، عن قتادة، قوله: {وما يضل به الا الفاسقين} [البقرة: ] «فسقوا فاضلهم الله علي فسقهم»
 
    
 اخبرنا علي بن المبارك، فيما كتب الي، ثنا زيد بن المبارك، ثنا ابن ثور، عن ابن جريج، عن مجاهد، عن ابن عباس: {وما يضل به الا الفاسقين} [البقرة: ] يقول: «يعني الكافرين»
 
  قوله: {الذين ينقضون عهد الله من بعد ميثاقه} 
 [البقرة: ]
 
    
 حدثنا احمد بن سنان الواسطي، ثنا وهب بن جرير، ثنا شعبة، عن عمرو بن مرة، عن مصعب بن سعد، قال: سالت ابي فقلت: قوله: {الذين ينقضون عهد الله من بعد ميثاقه} [البقرة: ] الي اخر الاية، فقال: «هم الحرورية»
 
  الوجه الثاني
 
    
 حدثنا عصام بن رواد، ثنا ادم عن ابي جعفر، عن الربيع، عن ابي العالية، في قوله: " {الذين ينقضون عهد الله من بعد ميثاقه} [البقرة: ] الي قوله: {اولءك هم الخاسرون} [البقرة: ] قال: " هي ست خصال في المنافقين، اذا كانت فيهم الظهرة علي الناس اظهروا هذه الخصاءص: اذا حدثوا كذبوا، واذا وعدوا اخلفوا، واذا اءتمنوا خانوا، ونقضوا عهد الله من بعد ميثاقه، وقطعوا ما امر الله به ان يوصل، وافسدوا في الارض، واذا كانت الظهرة عليهم اظهروا الخصال: اذا حدثوا كذبوا، واذا وعدوا اخلفوا، واذا اءتمنوا خانوا "
 
  الوجه الثالث 
 
    
 حدثنا ابو زرعة، ثنا صفوان بن صالح، ثنا الوليد، اخبرني بكير بن معروف، عن مقاتل بن حيان: قول الله: {الذين ينقضون عهد الله من بعد ميثاقه} [البقرة: ] «يعني ميثاقه الاول الذي اخذ عليهم ان يعبدوه ولا يشركوا»
 
  الوجه الرابع
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، قوله: {الذين ينقضون عهد الله من بعد ميثاقه} [البقرة: ] «هو ما عهد عليهم في القران، فاقروا به، ثم كفروا فنقضوه» وروي عن الربيع بن انس نحو قول ابي العالية
 
  قوله: {من بعد ميثاقه} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، اخبرني بكير بن معروف، عن مقاتل
  [ص: ]
 بن حيان، قوله: {من بعد ميثاقه} [البقرة: ] «في التوراة ان يءمنوا بمحمد صلي الله عليه وسلم ويصدقوه، فكفروا ونقضوا الميثاق الاول»
 
  قوله: {ويقطعون ما امر الله به ان يوصل} 
 [البقرة: ]
 
    
 حدثنا الحسن بن الصباح، ثنا يزيد بن هارون، ويحيي بن عباد، وشبابة بن سوار، قالوا: ثنا شعبة، عن عمرو بن قرة، عن مصعب بن سعد، عن ابيه، قال: " الحرورية الذين قال الله: {ويقطعون ما امر الله به ان يوصل} [البقرة: ] " والسياق ليزيد
 
  والوجه الثاني
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: {ويقطعون ما امر الله به ان يوصل} [البقرة: ] «من الارحام»
 
  والوجه الثالث
 
    
 حدثنا ابو زرعة، ثنا صفوان بن صالح، ثنا الوليد، اخبرني بكير بن معروف، عن مقاتل بن حيان، قوله: {ويقطعون ما امر الله به ان يوصل} [البقرة: ] «في محمد صلي الله عليه وسلم والنبيين والمرسلين من قبله، ان يءمنوا بهم جميعا، ولا يفرقوا بين احد منهم»
 
  قوله: {ويفسدون في الارض} 
 [البقرة: ]
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا يزيد بن هارون، وشبابة بن سوار، ويحيي بن عباد، قالوا: ثنا شعبة، عن عمرو بن مرة، عن مصعب بن سعد، عن ابيه: {ويفسدون في الارض} [البقرة: ] : فكان سعد يسميهم الفاسقين "
 
  الوجه الثاني
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: {ويفسدون في الارض} [البقرة: ] «يعملون فيها بالمعصية»
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، اخبرني بكير بن معروف، عن مقاتل، في قوله: {ويفسدون في الارض} [البقرة: ] قال: «اعمالهم السيءة التي يعملون بها في الارض»
 
  قوله: {اولءك هم الخاسرون} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، به، عن مقاتل بن حيان: {اولءك هم الخاسرون} [البقرة: ] «في الاخرة»
 
    
 قرات علي محمد بن الفضل، ثنا محمد بن علي بن الحسن بن شقيق، انبا محمد بن مزاحم ابو وهب، ثنا بكير بن معروف، عن مقاتل بن حيان: قوله {اولءك هم الخاسرون} [البقرة: ] " في الاخرة، يقول: هم اهل النار "
 
  قوله: {كيف تكفرون بالله وكنتم امواتا فاحياكم} 
 [البقرة: ]
 
    
 حدثنا احمد بن سنان، ثنا عبد الرحمن يعني ابن مهدي، عن سفيان، عن ابي اسحاق، عن ابي الاحوص، عن عبد الله: {قالوا ربنا امتنا اثنتين واحييتنا اثنتين} [غافر: ] : قال: " هي التي في البقرة: {كنتم امواتا فاحياكم ثم يميتكم ثم يحييكم} [البقرة: ] وروي عن الضحاك، وعطاء نحو ذلك
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر يعني ابن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: {ربنا امتنا اثنتين واحييتنا اثنتين} [غافر: ] " قال: كنتم ترابا قبل ان يخلقكم فهذه ميتة، ثم احياكم فخلقكم فهذه حياة، ثم يميتكم فترجعون الي القبور فهذه ميتة اخري، ثم يبعثكم يوم القيامة فهذه حياة، فهما ميتتان، وحياتان "، فهو قوله: {كيف تكفرون بالله وكنتم امواتا فاحياكم ثم يميتكم ثم يحييكم} [البقرة: ] "
 
    
 حدثنا ابي، ثنا ابراهيم بن موسي، انبا هشام بن يوسف، عن ابن جريج، عن عطاء، عن ابن عباس: {كنتم امواتا فاحياكم} [البقرة: ] في اصلاب اباءكم لم تكونوا شيءا حتي خلقكم، ثم يميتكم موتة الحق، ثم يحييكم حين يبعثكم، قال: وهي مثل قوله: {امتنا اثنتين واحييتنا اثنتين} [غافر: ] وروي عن ابي العالية، والحسن البصري، وابي صالح، والسدي، وقتادة نحو ذلك
 
  قوله: {ثم اليه ترجعون} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم عن ابي جعفر، عن الربيع، عن ابي العالية: {ثم اليه ترجعون} [البقرة: ] قال: «ترجعون اليه بعد الحياة»
 
  قوله تعالي: {هو الذي خلق لكم ما في الارض جميعا} 
 [البقرة: ]
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا حجاج بن محمد، عن ابن جريج، اخبرني اسماعيل بن امية، عن ايوب بن خالد، عن عبد الله بن رافع، مولي ام سلمة، عن ابي هريرة، قال: اخذ رسول الله صلي الله عليه وسلم بيدي فقال: «خلق الله التربة يوم السبت، وخلق الجبال فيها يوم الاحد، وخلق الشجر فيها يوم الاثنين، وخلق المكروه يوم الثلاثاء، وخلق النور يوم الاربعاء، وبث فيها الدواب يوم الخميس، وخلق ادم بعد العصر يوم الجمعة في اخر ساعة من ساعات الجمعة فيما بين العصر الي الليل»
 
    
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انبا معمر، عن ابن ابي نجيح، عن مجاهد، في قوله: {هو الذي خلق لكم ما في الارض جميعا} [البقرة: ] قال: " خلق الله الارض قبل السماء، فلما خلق الارض ثار منها دخان فذلك حين يقول: {ثم استوي الي السماء وهي دخان} [فصلت: ] ، قال: بعضهن فوق بعض، وسبع ارضين بعضهن تحت بعض "
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط بن نصر، عن السدي، قوله: {هو الذي خلق لكم ما في الارض جميعا ثم استوي الي السماء فسواهن سبع سماوات} [البقرة: ] قال: " ان الله كان عرشه علي الماء ولم يخلق شيءا غير ما خلق قبل الماء، فلما اراد ان يخلق الخلق اخرج من الماء دخانا، فارتفع فوق الماء فسما عليه، فسماه سماء، ثم ايبس الماء فجعله ارضا واحدة، ثم فتقها فجعل سبع ارضين في يومين في الاحد والاثنين، فخلق الارض علي حوت، والحوت هو النون الذي ذكر الله في القران، يقول {ن والقلم} [القلم: ] ، والحوت في الماء، والماء علي صفاة، والصفاة علي ظهر ملك، والملك علي الصخرة، والصخرة في الريح، وهي الصخرة التي ذكر لقمان، ليست في السماء ولا في الارض، فتحرك الحوت فاضطرب فتزلزلت الارض، فارسي عليها الجبال فقرت بالجبال، فالجبال تفخر علي الارض، فذلك قوله: {وجعلنا في الارض رواسي ان تميد بهم} [الانبياء: ] وخلق الجبال فيها واقوات اهلها وشجرها وما ينبغي لها في يومين، {وتجعلون له اندادا ذلك رب العالمين، وجعل فيها رواسي من فوقها وبارك فيها} [فصلت: ] ، يقول
  [ص: ]
 : انبت شجرها {وقدر فيها اقواتها} [فصلت: ] ، يقول: اقواتها لاهلها، {في اربعة ايام سواء للساءلين} [فصلت: ] ، يقول: من سال فهو كذا الامر "
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، اخبرني سعيد بن بشير، عن قتادة، في قول الله: {هو الذي خلق لكم ما في الارض جميعا} [البقرة: ] «اي سخر لكم ما في الارض جميعا كرامة من الله، ونعمة لابن ادم»
 
  قوله: {ثم استوي الي السماء} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قوله: {ثم استوي الي السماء} [البقرة: ] يقول: «ارتفع» وروي عن الحسن، والربيع بن انس مثله
 
  قوله تعالي: {فسواهن سبع سماوات} 
 [البقرة: ]
 
    
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، عن معمر، عن قتادة، في قوله: {فسواهن سبع سماوات} [البقرة: ] قال: «بعضهن فوق بعض، بين كل سماءين مسيرة خمسماءة عام»
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قوله: {فسواهن} [البقرة: ] يقول: «سوي خلقهن»
 
    
 حدثنا ابن ابي الربيع، انبا عبد الرزاق، انبا معمر، عن ابن ابي نجيح، عن مجاهد في قوله: {فسواهن سبع سماوات} [البقرة: ] «بعضهن فوق بعض، وسبع ارضين بعضهن تحت بعض»
 
  قوله: {وهو بكل شء عليم} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: {وهو بكل شء عليم} [البقرة: ] «يعني من اعمالكم عليم»
 
  قوله: {واذ قال ربك للملاءكة} 
 [البقرة: ]
 
    
 حدثنا ابو بكر بن ابي موسي الانصاري، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط بن نصر، عن السدي، عن ابي مالك، قوله: {واذ} [البقرة: ] «فقد كان»
 
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، {واذ قال ربك للملاءكة اني جاعل في الارض خليفة} [البقرة: ] «فاستشار الملاءكة في خلق ادم» وكذا روي عن قتادة
 
  قوله: {اني جاعل} 
 [البقرة: ]
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا سعيد بن سليمان، ثنا مبارك بن فضالة، ثنا الحسن، قال: قال الله للملاءكة: {اني جاعل في الارض خليفة} [البقرة: ] قال لهم: «اني فاعل»
 
    
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة يعني ابن الفضل، حدثني محمد بن اسحاق، قوله {اني جاعل في الارض خليفة} [البقرة: ] يقول: «ساكنا وعامرا يسكنها ويعمرها خلقا ليس منكم»
 
  قوله: {في الارض} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا ابو سلمة، ثنا حماد، انبا عطاء بن السايب، عن ابن سابط، ان النبي صلي الله عليه وسلم قال: " دحيت الارض من مكة، واول من طاف بالبيت الملاءكة، فقال: {اني جاعل في الارض خليفة} [البقرة: ] يعني مكة "
 
    
 حدثنا احمد بن عصام الانصاري، وحميد بن عياش، قالا: ثنا مءمل، ثنا حماد بن سلمة، وحماد بن زيد، عن خالد الحذاء، قال: سالت الحسن فقلت: يا ابا سعيد، ادم للسماء خلق ام الارض؟ قال: " اما تقرا القران؟: {اني جاعل في الارض خليفة} [البقرة: ] لا بل للارض خلق "
 
  قوله: {خليفة} 
 [البقرة: ]
 
    
 حدثنا عمرو بن عبد الله الاودي، ثنا وكيع، ثنا سفيان، عن سالم بن ابي حفصة، عن رجل، عن ابن عباس، قال: " اخرج الله ادم من الجنة قبل ان يسكنها اياه، ثم قرا: {اني جاعل في الارض خليفة} [البقرة: ] "
 
  قوله: {قالوا اتجعل فيها} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا هشام بن عبيد الله، انبا عتاب بن اعين، عن سفيان الثوري، عن عطاء بن الساءب، عن ابن سابط، في قول الله: {اتجعل فيها من يفسد فيها ويسفك الدماء} [البقرة: ] قال: «يعنون الحرام»
 
  قوله: {من يفسد فيها ويسفك الدماء} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا علي بن محمد الطنافسي، ثنا ابو معاوية، ثنا الاعمش، عن بكير بن الاخنس، عن مجاهد، عن عبد الله بن عمرو، قال: " كان الجن بنو الجان في الارض قبل ان يخلق ادم بالفي سنة، فافسدوا في الارض، سفكوا الدماء، فبعث الله جندا من الملاءكة فضربوهم حتي الحقوهم بجزاءر البحور، فقال الله للملاءكة: {اني جاعل في الارض خليفة قالوا اتجعل فيها من يفسد فيها ويسفك الدماء} [البقرة: ] قال: {اني اعلم ما لا تعلمون} [البقرة: ] "
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قوله: {اني جاعل في الارض خليفة} [البقرة: ] الي قوله: {واعلم ما تبدون وما كنتم تكتمون} [البقرة: ] قال " خلق الله الملاءكة يوم الاربعاء، وخلق الجن يوم الخميس، وخلق ادم يوم الجمعة، فكفر قوم من الجن، فكانت الملاءكة تهبط اليهم في الارض فتقاتلهم، فكانت الدماء بينهم، وكان الفساد في الارض فمن ثم قالوا: {اتجعل فيها من يفسد فيها} [البقرة: ] كما افسدت الجن ويسفك الدماء كما سفكوا "
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا سعيد بن سليمان، ثنا مبارك بن فضالة، ثنا الحسن، قال: قال الله تعالي للملاءكة: {اني جاعل في الارض خليفة} [البقرة: ] قال لهم " اني فاعل، افضوا برايهم فعلمهم علما وطوي عنهم علما علمه ولم يعلموه، فقالوا بالعلم الذي علمهم: {اتجعل فيها من يفسد فيها ويسفك} [البقرة: ] الدماء قال {اني اعلم ما لا تعلمون} [البقرة: ] قال الحسن: ان الجن كانوا في الارض يفسدون ويسفكون الدماء، ولكن جعل الله في قلوبهم ان ذلك سيكون، فقالوا بالقول الذي علمهم "
 
  والوجه الثاني
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله بن موسي، انبا اسراءيل، عن السدي
  [ص: ]
 ، عمن حدثه عن ابن عباس، قوله: {اني جاعل في الارض خليفة قالوا اتجعل فيها من يفسد فيها ويسفك الدماء ونحن نسبح بحمدك ونقدس لك} [البقرة: ] قال الله: اني خالق بشرا وانهم يتحاسدون فيقتل بعضهم بعضا، ويفسدون في الارض، فلذلك قالوا ما قالوا " يعني {اتجعل فيها من يفسد فيها ويسفك الدماء} [البقرة: ]
 
    
 حدثنا الحسن بن ابي الربيع الجرجاني، انبا عبد الرزاق، انبا معمر، عن قتادة، في قوله: {اتجعل فيها من يفسد فيها ويسفك الدماء} [البقرة: ] قال: " كان الله اعلم انه اذا كان في الارض خلق افسدوا فيها وسفكوا الدماء، فذلك حين قالوا: {اتجعل فيها من يفسد فيها} [البقرة: ] يعنون الناس "
 
    
 حدثنا احمد بن عصام، ثنا ابو احمد الزبيري، ثنا سفيان، عن عطاء بن الساءب، عن ابن سابط، في قوله: {اتجعل فيها من يفسد فيها ويسفك الدماء} [البقرة: ] «يعنون الناس»
 
  والوجه الثالث
 
    
 حدثنا ابي، ثنا هشام الرازي، ثنا ابن المبارك، عن معروف يعني ابن خربوذ المكي، عمن سمع ابا جعفر محمد بن علي يقول: " السجل ملك، وكان هاروت، وماروت من اعوانه، وكان له كل يوم ثلاث لمحات ينظرهن في ام الكتاب، فنظر نظرة لم تكن له فابصر فيها خلق ادم وما فيه من الامور، فاسر ذلك الي هاروت، وماروت وكانا من اعوانه، فلما قال {اني جاعل في الارض خليفة قالوا اتجعل فيها من يفسد فيها ويسفك الدماء} [البقرة: ] قالا ذلك استطالة علي الملاءكة "
 
  والوجه الرابع
 
    
 حدثنا ابي، ثنا هشام بن عبيد الله، ثنا عبد الله بن يحيي بن ابي كثير، قال: سمعت ابي يقول، " ان الملاءكة الذين قالوا: {اتجعل فيها من يفسد فيها ويسفك الدماء ونحن نسبح بحمدك ونقدس لك} [البقرة: ] «كانوا عشرة الاف، فخرجت نار من عند الله فاحرقتهم»
 
  قوله: {ونحن نسبح بحمدك} 
 [البقرة: ]
 
    
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انبا معمر، عن قتادة، في قوله: {ونحن نسبح بحمدك} [البقرة: ] قال: «التسبيح التسبيح»
 
  الوجه الثاني
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: {ونحن نسبح بحمدك} [البقرة: ] يقول: «نصلي لك»
 
  قوله: {ونقدس لك} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: {ونقدس لك} [البقرة: ] قال: " التقديس: التطهير "
 
  الوجه الثالث
 
    
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انا معمر، عن قتادة، في قوله {ونقدس لك} [البقرة: ] قال: " التقديس: الصلاة " قال ابو محمد: وكذا فسره السدي
 
  قوله تعالي: {قال اني اعلم ما لا تعلمون} 
 [البقرة: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله بن موسي، عن اسراءيل، عن السدي، عمن حدثه، عن ابن عباس، قال: " كان ابليس علي ملاءكة سماء الدنيا فاستكبر وهم بالمعصية وطغي، فذلك قول الله: {اني اعلم ما لا تعلمون} [البقرة: ] في نفس ابليس البغي " وروي عن السدي نحو ذلك
 
    
 حدثنا ابو سعيد الاشج، ثنا احمد بن بشير، عن محمد بن مسلم، عن علي بن بذيمة، عن مجاهد: {اني اعلم ما لا تعلمون} [البقرة: ] قال: «علم من ابليس المعصية، وخلقه لها»
 
  الوجه الثاني
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، اخبرني سعيد بن بشير، عن قتادة
  [ص: ]
 ، قوله: {اني اعلم ما لا تعلمون} [البقرة: ] قال: «كان من علم الله انه سيكون من ذلك الخليفة رسل وانبياء وقوم صالحون وساكن الجنة»
 
  قوله: {وعلم ادم الاسماء كلها} 
 [البقرة: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله بن موسي، انبا اسراءيل، عن السدي، عمن حدثه عن ابن عباس: {وعلم ادم الاسماء كلها} [البقرة: ] قال: " عرض عليه اسماء ولده انسانا انسانا، والدواب، فقيل: هذا الحمار، هذا الجمل، هذا الفرس "
 
    
 حدثنا ابي، ثنا عبد المءمن بن علي، ثنا عبد السلام بن حرب الملاءي، عن عاصم بن كليب، عن سعيد بن معبد، عن ابن عباس: {وعلم ادم الاسماء كلها} [البقرة: ] قال: " علمه اسم الصحفة والقدر. قال: نعم، حتي الفسوة والفسية "
 
    
 حدثني ابي، ثنا ابو عبد الرحمن عبد الله بن محمد بن اسحاق الاذرمي، ثنا قاسم بن يزيد الجرمي، ثنا سفيان، عن ابن ابي نجيح، عن مجاهد: {وعلم ادم الاسماء كلها} [البقرة: ] قال: «علمه كل دابة وكل طير وكل شء» قال ابو محمد: وروي عن مجاهد، وسعيد بن جبير، وقتادة نحو قول ابن عباس
 
  والوجه الثاني
 
    
 حدثنا علي بن الحسين، ثنا ابراهيم بن سعيد الجوهري، ثنا ابو احمد الزبيري، عن الحسن بن صالح، عن ابيه، عن حميد الشامي، قال: «علم ادم النجوم» قال ابو محمد: " يعني اسماء النجوم
 
  قوله: {ثم عرضهم علي الملاءكة} 
 [البقرة: ]
 
    
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انبا معمر، عن قتادة، قال: " ثم عرض تلك الاسماء علي الملاءكة فقال: {انبءوني باسماء هءلاء ان كنتم صادقين} [البقرة: ] "
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: {وعلم ادم الاسماء كلها} [البقرة: ] «ثم عرض الخلق علي الملاءكة»
 
  قوله: {فقال انبءوني باسماء هءلاء ان كنتم صادقين} 
 [البقرة: ]
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: فقال: {انبءوني باسماء هءلاء ان كنتم صادقين} [البقرة: ] «باسماء هذه التي حدث بها ادم»
 
  قوله: {قالوا سبحانك} 
 [البقرة: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا حفص بن غياث، عن حجاج، عن ابن ابي مليكة، عن ابن عباس: سبحان الله قالوا: قال: تنزيه نفسه عن السوء، قال: ثم قال عمر لعلي واصحابه عنده: لا اله الا الله قد عرفناه، فما سبحان الله؟ فقال له علي: «كلمة احبها الله لنفسه ورضيها واحب ان تقال»
 
  والوجه الثاني
 
    
 حدثنا ابي، ثنا ابن نفيل، ثنا النضر بن عربي، قال: سال رجل ميمون بن مهران عن سبحان الله، فقال: «اسم يعظم الله به ويحاشي به من السوء»
 
  الوجه الثالث
 
    
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا زيد بن الحباب، حدثني ابو الاشهب، عن الحسن، قال: «سبحان الله اسم لا يستطيع الناس ان ينتحلوه»
 
  قوله: {لا علم لنا الا ما علمتنا} 
 [البقرة: ]
 
    
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة بن الفضل، عن ابن اسحاق: {قالوا سبحانك لا علم لنا الا ما علمتنا انك انت العليم الحكيم} [البقرة: ] " اي: انما اجبناك فيما علمتنا، فاما ما لم تعلمنا فانك اعلم به منا "
 
  قوله: {انك انت العليم الحكيم} 
 [البقرة: ]
 
    
 وبه عن سلمة، ثنا محمد بن اسحاق: {العليم} [البقرة: ] «اي عليم بما تخفون»
 
  قوله: {الحكيم} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية، قوله: {الحكيم} [البقرة: ] قال: «حكيم في امره»
 
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة، قال محمد بن اسحاق: وحدثني محمد بن جعفر بن الزبير، قوله: {الحكيم} [البقرة: ] قال: «الحكيم في عذره وحجته الي عباده»
 
  قوله: {يا ادم انبءهم باسماءهم} 
 [البقرة: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن المثني، ثنا ابراهيم بن سليمان، ثنا محمد بن ابان، قال: سالت زيد بن اسلم عن قوله: {انبءهم باسماءهم} [البقرة: ] قال: «انت جبريل، انت ميكاءيل، انت اسرافيل، حتي عدد الاسماء كلها، حتي بلغ الغراب»
 
    
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا ابو داود، ثنا قيس، عن خصيف، عن مجاهد، في قول الله تعالي: {يا ادم انبءهم باسماءهم} [البقرة: ] قال: «اسم الحمامة والغراب، واسم كل شء» وروي عن سعيد بن جبير، والحسن، وقتادة نحو ذلك
 
  قوله: {فلما انباهم باسماءهم} 
 [البقرة: ]
 
    
 حدثنا الحسين بن الحسن الرازي، ثنا ابراهيم بن عبد الله الهروي، ثنا حجاج بن محمد، عن ابن جريج، عن مجاهد،: {فلما انباهم} [البقرة: ] «انبا ادم الملاءكة، باسماءهم اسماء اصحاب الاسماء»
 
  قوله تعالي: {قال الم اقل لكم اني اعلم غيب السموات والارض}
 
    
 حدثنا الحسن بن احمد ابو فاطمة، ثنا ابراهيم بن عبد الله بن بشار الواسطي، ثنا سرور بن المغيرة، عن عباد بن منصور، عن الحسن بن ابي الحسن البصري، قال: " فجعل ادم ينبءهم باسماءهم ويقول: هذا اسم كذا وكذا من خلق الله، وهذا اسم كذا وكذا، فعلم الله ادم من ذلك ما لم يعلموا حتي علموا انه اعلم منهم "، قال: {فلما انباهم باسماءهم قال الم اقل لكم اني اعلم غيب السموات والارض} "
 
  قوله: {واعلم ما تبدون وما كنتم تكتمون} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ الفضل بن خالد النحوي، عن عبيد يعني ابن سليمان، عن الضحاك، قال: كان ابن عباس يقول: فذلك قوله للملاءكة: {اني اعلم غيب السموات والارض واعلم ما تبدون وما كنتم تكتمون} «يعني ما اسر ابليس في نفسه من الكبر»
 
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، ثنا صالح بن حيان، ثنا عبد الله بن بريدة، قال: " فكان الله قد علم من ابليس فيما يخفي انه غير فاعل، فذلك قوله: {واعلم ما تبدون وما كنتم تكتمون} [البقرة: ] «اما ابداءه فاقراره بالسجود، واما ما يخفي فاباءه له»
 
  الوجه الثاني
 
    
 حدثنا عصام بن رواد بن الجراح العسقلاني، ثنا ادم، ثنا ابو جعفر يعني الرازي، عن الربيع، عن ابي العالية: {واعلم ما تبدون وما كنتم تكتمون} [البقرة: ] " فكان الذي كتموا قولهم: لن يخلق ربنا خلقا الا كنا نحن اعلم منه واكرم " وروي عن الحسن نحو ذلك
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن، ثنا عبد الله بن ابي جعفر الرازي، عن ابيه، عن الربيع بن انس، قوله: {واعلم ما تبدون وما كنتم تكتمون} [البقرة: ] فكان الذي كتموا بينهم قولهم: لم يخلق الله تعالي خلقا الا كنا اكرم منه واعلم، فعرفوا ان الله فضل ادم عليهم في العلم والكرم " وتابع ابن عباس علي تفسيره قوله: {وما كنتم تكتمون} [البقرة: ] : مجاهد، وسعيد بن جبير، والسدي، والضحاك، وتابع ابا العالية قتادة، والحسن
 
  قوله: {واذ قلنا للملاءكة} 
 [البقرة: ]
 
    
 حدثني ابي، ثنا ابراهيم بن محمد بن يوسف الفريابي، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قول الله: {واذ قلنا للملاءكة اسجدوا لادم} [البقرة: ] قال: «الملاءكة الذين كانوا في الارض»
 
  قوله: {اسجدوا لادم} 
 [البقرة: ]
 
    
 حدثنا الحسن بن ابي احمد، ثنا ابراهيم بن عبد الله بن بشار الواسطي، ثنا سرور بن المغيرة، عن عباد بن منصور، عن الحسن {واذ قلنا للملاءكة اسجدوا لادم} [البقرة: ] «ثم امرهم ان يسجدوا لادم فسجدوا له كرامة من الله اكرم بها ادم، وليعلموا ان الله لا يخفي عليه شء وانه يصنع ما اراد»
 
 حدثنا ابو زرعة، ثنا صفوان بن صالح، ثنا الوليد، ثنا سعيد، عن قتادة، عن عبد الله بن عباس، في قول الله تعالي: {واذ قلنا للملاءكة اسجدوا لادم} [البقرة: ] قال: «كانت السجدة لادم، والطاعة لله»
 
  قوله: {فسجدوا الا ابليس} 
 [البقرة: ]
 
    
 حدثنا ابي، حدثني سعيد بن سليمان، ثنا عباد يعني ابن العوام، عن سفيان بن حسين، عن يعلي بن مسلم، عن سعيد بن جبير، عن ابن عباس، قال: «كان ابليس اسمه عزازيل، وكان من اشرف الملاءكة من ذوي الاربعة الاجنحة ثم ابلس بعد»
 
    
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر، عن ابي روق، عن الضحاك، عن ابن عباس، قال: «انما سمي ابليس لان الله ابلسه من الخير كله ايسه منه» وروي عن قتادة " انه ابلس من الطاعة وروي عن السدي نحو قول ابن عباس
 
  قوله: {ابي} 
 [البقرة: ]
 
    
 حدثنا محمد بن حبال القهندزي، فيما كتب الي، ثنا عمر بن عبد الغفار القهندزي، قال: سءل سفيان بن عيينة عن قوله: «ليدخلن الجنة الا من ابي» قال: " الا من عصي الله، لقوله عز وجل {فسجدوا الا ابليس} [البقرة: ] "
 
  قوله: {ابي واستكبر} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد بن ابي عروبة، عن قتادة، قوله {ابي واستكبر وكان من الكافرين} [البقرة: ] " حسد عدو الله ابليس ادم علي ما اعطاه الله من الكرامة، وقال: انا ناري وهذا طيني، فكان بدء الذنوب الكبر، استكبر عدو الله ان يسجد لادم "
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله، انبا اسراءيل، عن السدي، عمن حدثه عن ابن عباس، قال: " كان ابليس امينا علي ملاءكة سماء الدنيا، قال: فهم بالمعصية وبغي واستكبر "
 
  قوله: {وكان من الكافرين} 
 [البقرة: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، ثنا صالح بن حيان، ثنا عبد الله بن بريدة، قوله: {وكان من الكافرين} [البقرة: ] «من الذين ابوا فاحرقتهم النار»
 
 حدثنا عصام بن رواد العسقلاني، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية، في قوله: {وكان من الكافرين} [البقرة: ] «يعني من العاصين»
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو يحيي الرازي، يعني اسحاق بن سليمان، عن موسي بن عبيدة الربذي، عن محمد بن كعب القرظي، قال: «ابتدا الله عز وجل خلق ابليس علي الكفر والضلالة، وعمل بعمل الملاءكة فصيره الي ما ادي اليه خلقه من الكفر» ، قال الله تعالي: {وكان من الكافرين} [البقرة: ] "
 
    
 ذكر عن عمرو بن محمد العنقزي، ثنا اسباط، عن السدي: {وكان من الكافرين} [البقرة: ] قال: «من الكافرين الذين لم يخلقهم الله يومءذ يكونون بعد»
 
  قوله: {وقلنا يا ادم} 
 [البقرة: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبدة بن سليمان، عن الاعمش، عن ابي الضحي، عن ابن عباس، قال: «وانما سمي ادم، لانه خلق من اديم الارض»
 
  قوله: {يا ادم اسكن انت وزوجك الجنة} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد العسقلاني، ثنا ادم بن ابي اياس، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية، قال: قال الله تبارك وتعالي: {يا ادم اسكن انت وزوجك الجنة} [البقرة: ] قال: «خلق الله ادم يوم الجمعة، وادخله الجنة يوم الجمعة، فجعله في جنات الفردوس»
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، قال: " اخرج ابليس من الجنة واسكن ادم الجنة، فكان يمشي فيها وحشا ليس له زوج يسكن اليها، فنام نومة فاستيقظ وعند راسه امراة قاعدة خلقها الله من ضلعه، فسالها: ما انت؟ فقالت: امراة، قال: ولم خلقت؟ قالت: تسكن الي، قالت له الملاءكة ينظرون ما بلغ من علمه: ما اسمها يا ادم؟ قال: حواء، قالوا: ولم حواء؟ قال: انها خلقت من شء حي "، فقال الله: {يا ادم اسكن انت وزوجك الجنة} [البقرة: ] "
 
  قوله: {وكلا منها رغدا حيث شءتما} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: {وكلا منها رغدا} [البقرة: ] قال: «الرغد سعة المعيشة»
 
  الوجه الثاني
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: {رغدا} [البقرة: ] قال: «لا حساب عليهم»
 
  الوجه الثالث
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد بن طلحة، عن السدي: {وكلا منها رغدا حيث شءتما} [البقرة: ] «والرغد الهنء»
 
  قوله {ولا تقربا هذه الشجرة فتكونا من الظالمين} 
 [البقرة: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله، عن اسراءيل، عن السدي، عمن حدثه عن ابن عباس، قال: «الشجرة التي نهي ادم عنها الكرم» وكذلك فسره سعيد بن جبير، والشعبي، وجعدة بن هبيرة، والسدي، ومحمد بن قيس
 
  الوجه الثاني
 
    
 حدثنا محمد بن اسماعيل بن سمرة الاحمس، ثنا ابو يحيي الحماني، حدثنا النضر ابو عمر الخزاز، عن عكرمة، عن ابن عباس، قال: «الشجرة التي نهي الله عنها ادم السنبلة» وكذلك فسره الحسن البصري، ووهب بن منبه، وعطية العوفي، وابو مالك، ومحارب بن دثار، وعبد الرحمن بن ابي ليلي
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة بن الفضل، حدثني محمد بن اسحاق، عن بعض اهل اليمن، عن وهب بن منبه، انه كان يقول: «هي البر ولكن الحبة منها في الجنة ككلي البقر، الين من الزبد، واحلي من العسل»
 
  الوجه الثالث
 
    
 حدثنا ابو زرعة، ثنا ابراهيم بن موسي، انبا ابن ابي زاءدة، قال ابن جريج، عن مجاهد: {ولا تقربا هذه الشجرة} [البقرة: ] قال: «تينة» وكذلك فسره قتادة، وابن جريج
 
  الوجه الرابع
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو احمد، عن سفيان، عن حصين، عن ابي مالك: {ولا تقربا هذه الشجرة} [البقرة: ] قال: «النخلة»
 
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية، قال: «كانت الشجرة من اكل منها احدث، ولا ينبغي ان يكون في الجنة حدث»
 
    
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انبا عمر بن عبد الرحمن بن مهرب، قال: سمعت وهب بن منبه، يقول: «لما اسكن الله ادم وزوجه الجنة نهاه عن الشجرة، وكانت شجرة غصونها متشعب بعضها في بعض، وكان لها ثمر ياكله الملاءكة لخلدهم، وهي الثمرة التي نهي الله عنها ادم وزوجته»
 
  قوله: {فازلهما الشيطان عنها} 
 [البقرة: ]
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا عبد الوهاب يعني ابن عطاء، عن ابان العطار، عن عاصم بن بهدلة، {فازلهما} [البقرة: ] قال: «فنحاهما»
 
  الوجه الثاني
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا عبد الوهاب، عن اسماعيل، عن الحسن: {فازلهما} [البقرة: ] قال: «من قبل الزلل»
    
 حدثنا الحسن بن محمد بن الصباح، ثنا عبد الوهاب، عن ابان العطار، عن قتادة، مثل ذلك
 
  الوجه الثالث
 
    
 اخبرنا علي بن المبارك، فيما كتب الي، ثنا زيد بن المبارك، ثنا ابن ثور، عن ابن جريج، عن ابن عباس: {فازلهما الشيطان} [البقرة: ] قال: «فاغواهما»
 
  قوله: {الشيطان} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا خالد بن خداش المهلبي، ثنا حماد بن زيد، عن الزبير بن خريت، عن عكرمة، قال: «انما سمي الشيطان؛ لانه تشيطن»
 
  قوله: {فاخرجهما مما كانا فيه} 
 [البقرة: ]
 
    
 حدثنا علي بن الحسين بن اشكاب، ثنا علي بن عاصم، عن سعيد بن ابي عروبة، عن قتادة، عن الحسن، عن ابي بن كعب، قال: قال رسول الله صلي الله عليه وسلم: " ان الله عز وجل خلق ادم رجلا طوالا كثير شعر الراس كانه نخلة سحوق
  [ص: ]
 ، فلما ذاق الشجرة سقط عنه لباسه، فاول ما بدا منه عورته، فلما نظر الي عورته جعل يشتد في الجنة، فاخذت شعره شجرة فنازعها، فناداه الرحمن: يا ادم مني تفر؟ فلما سمع كلام الرحمن، قال: يا رب لا، ولكن استحياء "
 
    
 حدثني جعفر بن احمد بن الحكم القومسي، سنة اربع وخمسين وماءتين، ثنا سليم بن منصور بن عمار، ثنا علي بن عاصم، عن سعيد، عن قتادة، عن ابي بن كعب، قال: قال رسول الله صلي الله عليه وسلم: " لما ذاق ادم من الشجرة فر هاربا فتعلقت شجرة بشعره فنودي: يا ادم، افرارا مني؟ قال: بل حياء منك، قال: يا ادم اخرج من جواري، فبعزتي لا اساكن فيها من عصاني، ولو خلقت ملء الارض مثلك خلقا ثم عصوني لاسكنتهم دار العاصين "
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر الرازي، قال الربيع بن انس: «فاخرج ادم من الجنة للساعة التاسعة او العاشرة، فاخرج ادم معه غصنا من شجر الجنة، علي راسه تاج من شجر الجنة، وهو الاكليل من ورق الجنة»
 
  قوله: {وقلنا اهبطوا} 
 [البقرة: ]
 
    
 حدثنا ابو هارون محمد بن خالد الخراز، ثنا يحيي بن زياد، حدثني ابن ابي الخطيب، اخبرني ضمرة، عن رجاء بن ابي سلمة قال: «اهبط ادم يداه علي ركبتيه مطاطءا راسه، واهبط ابليس مشبكا بين اصابعه رافعا راسه الي السماء»
 
    
 حدثنا محمد بن عمار بن الحارث، ثنا محمد بن سعيد بن سابق، ثنا عمرو بن ابي قيس، عن ابي عدي يعني الزبير بن عدي، عن ابن عمر، قال: «اهبط ادم بالصفا، وحواء بالمروة»
 
    
 حدثنا علي بن الحسين، ثنا المقدمي، ثنا عمران بن عيينة، عن عطاء بن السايب، عن سعيد بن جبير، عن ابن عباس: «ان اول ما اهبط الله ادم الي الارض اهبطه بدحنا ارض بالهند»
 
 حدثنا ابو زرعة، ثنا عثمان بن ابي شيبة، ثنا جرير، عن عطاء، عن سعيد بن جبير، عن ابن عباس، قال: «اهبط ادم عليه السلام الي ارض يقال لها دحنا بين مكة، والطاءف»
 
    
 حدثنا علي بن الحسين، ثنا هشام بن عمرو الغساني، ثنا عباد بن ميسرة، عن الحسن، قال: «اهبط ادم بالهند، وحواء بجدة، وابليس بدست ميسان من البصرة علي اميال، واهبطت الحية باصبهان»
 
    
 اخبرني ابي، حدثني ايوب بن محمد الرقي، ثنا ضمرة، عن السري يعني ابن يحيي، قال: «اهبط ادم من الجنة ومعه البذور، فوضع ابليس عليها يده، فما اصاب يده ذهب منفعته»
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، قال: قال الله: {اهبطوا منها جميعا} [البقرة: ] فهبطوا فنزل ادم بالهند، وانزل معه بالحجر الاسود وقبضة من ورق الجنة فبثه بالهند فنبتت شجر الطيب، فانما اصل ما يجاء به من الطيب من الهند من قبضة الورق التي هبط بها ادم، وانما قبضها ادم حين اخرج من الجنة اسفا علي الجنة حين اخرج منها "
 
  قوله: {بعضكم لبعض عدو} 
 [البقرة: ]
 
    
 اخبرنا يونس بن عبد الاعلي، قراءة، اخبرني ابن وهب، حدثني عبد الرحمن بن مهدي، عن اسراءيل، عن اسماعيل السدي، حدثني من، سمع ابن عباس، يقول: {اهبطوا بعضكم لبعض عدو} [البقرة: ] قال: ادم وحواء وابليس والحية "
 
  قوله: {ولكم في الارض مستقر} 
 [البقرة: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله بن موسي، انبا اسراءيل، عن السدي، عن ابن عباس، في قوله: {ولكم في الارض مستقر} [البقرة: ] قال: «المستقر القبور»
 
    
 حدثنا ابي، ثنا محمد بن حاتم الزمي، ثنا عبيدة بن حميد، عن عمار الدهني، عن حميد المدني، عن كريب، عن ابن عباس: قوله {ولكم في الارض مستقر} [البقرة: ] قال: مستقر فوق الارض، ومستقر تحت الارض "
 
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قوله: {ولكم في الارض مستقر} [البقرة: ] قال: " هو قوله: {الذي جعل لكم الارض فراشا} [البقرة: ] "
 
  قوله: {ومتاع} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، قوله: {ومتاع الي حين} [البقرة: ] يقول: «بلاغ الي الموت»
 
  قوله: {الي حين} 
 [البقرة: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله، انبا اسراءيل، عن السدي، عن عكرمة، عن ابن عباس، {ومتاع الي حين} [البقرة: ] قال: «الحياة»
 
    
 حدثنا ابي، ثنا محمد بن حاتم الزمي، ثنا عبيدة بن حميد، عن عمار الدهني، عن حميد المدني، عن كريب، عن ابن عباس، قوله: {ومتاع الي حين} [البقرة: ] قال: «حتي يصير الي الجنة او النار»
 
    
 حدثني عبد الله بن احمد بن عبد الرحمن بن عبد الله بن سعد، حدثني ابي يعني احمد بن عبد الرحمن، عن ابيه، عن ابراهيم، يعني الصايغ، عن يزيد النحوي، قال: قال عكرمة: {ومتاع الي حين} [البقرة: ] قال: «الحين الذي لا يدرك»
 
  قوله: {فتلقي ادم من ربه كلمات} [البقرة: ] اختلف في تفسيره علي ستة اوجه، فاحدها
 
 حدثنا علي بن الحسين بن اشكاب، ثنا علي بن عاصم، عن سعيد بن ابي عروبة، عن قتادة، عن الحسن، عن ابي بن كعب، قال: قال رسول الله صلي الله عليه وسلم: " قال ادم عليه السلام: ارايت يا رب ان تبت ورجعت، اعايدي الي الجنة؟ قال: نعم "، قال: فذلك قوله: {فتلقي ادم من ربه كلمات} [البقرة: ] "
 
  والوجه الثاني
 
 حدثنا ابو سعيد الاشج، ثنا عبيد الله، ثنا اسراءيل، عن السدي، عمن حدثه، عن ابن عباس: {فتلقي ادم من ربه كلمات} [البقرة: ] قال: قال ادم: يا رب، الم تخلقني بيدك؟
  [ص: ]
 قيل له: بلي، ونفخت في من روحك؟ قيل له: بلي، وعطست فقلت: يرحمك الله، وسبقت رحمتك غضبك؟ قيل: بلي، وكتبت علي ان اعمل هذا؟ قيل: بلي، قال: ارايت ان تبت هل انت راجعي الي الجنة؟ قال: نعم " وكذلك فسره عطية، والسدي
 
  الوجه الثالث
 
    
 حدثنا ابي، ثنا عبد الله بن محمد النفيلي، ثنا زهير، ثنا ابو اسحاق، عن رجل، من بني تميم، قال: اتيت ابن عباس فسالته: ما الكلمات التي تلقي ادم من ربه؟ قال: «علم شان الحج، فهي الكلمات»
 
  والوجه الرابع
 
    
 حدثنا احمد بن سنان، ثنا عبد الرحمن، يعني ابن مهدي، عن سفيان، عن عبد العزيز بن رفيع، اخبرني من، سمع عبيد بن عمير، يقول: " قال ادم: يا رب، خطيءتي التي اخطات، شء كتبت علي قبل ان تخلقني، او شء ابتدعته من قبل نفسي؟ قال: بل كتبته عليك قبل ان اخلقك، قال: فكما كتبته علي فاغفره لي "، قال: فذلك قوله: {فتلقي ادم من ربه كلمات} [البقرة: ] "
 
  والوجه الخامس
 
    
 حدثنا احمد بن سنان، ثنا ابن مهدي، عن سفيان، عن خصيف، عن مجاهد، وسعيد بن جبير: {فتلقي ادم من ربه كلمات} [البقرة: ] قالا: قوله: {ربنا ظلمنا انفسنا وان لم تغفر لنا وترحمنا لنكونن من الخاسرين} [الاعراف: ] " وروي عن الحسن، وقتادة، ومحمد بن كعب القرظي، وخالد بن معدان، وعطاء الخراساني، والربيع بن انس نحو ذلك
 
  الوجه السادس
 
    
 حدثنا ابي، ثنا ابو حذيفة، ثنا شبل، حدثني عبد الله بن كثير، ان مجاهدا، كان يقول في قول الله {فتلقي ادم من ربه كلمات} [البقرة: ] " الكلمات: اللهم لا اله الا انت سبحانك، وبحمدك، رب اني ظلمت نفسي فاغفر لي انك خير الغافرين، اللهم لا اله الا انت سبحانك وبحمدك، رب اني ظلمت نفسي فتب علي انك انت التواب الرحيم "
 
  قوله: {فتاب عليه انه هو التواب الرحيم} 
 [البقرة: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا جرير، عن عمارة، يعني ابن القعقاع، عن ابي زرعة، يعني ابن عمرو بن جرير، قال: " ان اول شء كتب: انا التواب، اتوب علي من تاب "
 
    
 حدثنا الحسين بن الحسن الرازي، ثنا ابراهيم بن عبد الله الهروي، ثنا حجاج بن محمد، عن ابن جريج، عن مجاهد: {فتلقي ادم من ربه كلمات} [البقرة: ] قال: " اي رب اتتوب علي ان تبت؟ قال: نعم، فتاب ادم، فتاب عليه ربه "
 
  قوله: {التواب الرحيم} 
 [البقرة: ]
 
    
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة، قال محمد بن اسحاق في قوله: {الرحيم} [البقرة: ] قال: «يرحم العباد علي ما فيهم»
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير: قوله: {الرحيم} [البقرة: ] «قال رحيم بهم بعد التوبة»
 
  قوله: {قلنا اهبطوا منها جميعا} 
 [البقرة: ]
 
    
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا يحيي بن حماد، ثنا ابو عوانة، عن اسماعيل بن سالم، عن ابي صالح، مولي ام هانء في قوله: {اهبطوا منها جميعا} [البقرة: ] قال: «يعني ادم، وحواء والحية» وروي عن السدي نحو ذلك، وزاد فيه ابليس
 
    
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، قال: قال معمر: واخبرني عوف، عن قسامة، عن ابي موسي، قال: «ان الله تعالي حين اهبط ادم من الجنة الي الارض علمه صنعة كل شء وزوده من ثمار الجنة مثل ثمرتكم هذه من ثمار الجنة غير ان هذه تتغير وتلك لا تتغير»
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد بن طلحة، ثنا اسباط، عن السدي: {اهبطوا منها جميعا} [البقرة: ] فهبطوا فنزل ادم بالهند، وانزل معه بالحجر الاسود، وانزل بقبضة من ورق الجنة فبثه بالهند، فنبت شجر الطيب، فانما اصل ما يجاء به من الهند من الطيب من قبضة الورق التي هبط بها ادم، وانما قبضها ادم حين اخرج من الجنة اسفا علي الجنة حين اخرج منها "
 
  قوله: {فاما ياتينكم مني هدي} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية، في قوله: {فاما ياتينكم مني هدي} [البقرة: ] قال: «الهدي الانبياء والرسل، والبيان»
 
  الوجه الثاني
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، اخبرني بكير بن معروف، عن مقاتل بن حيان، في قول الله عز وجل {فاما ياتينكم مني هدي} [البقرة: ] «يعني بالهدي محمدا صلي الله عليه وسلم»
 
  الوجه الثالث
 
    
 حدثنا محمود بن الفرج الاصبهاني الزاهد، ثنا محمد بن يحيي بن فياض الزماني، ثنا ابو بكر الحنفي، ثنا البراء بن يزيد، عن الحسن، في قوله: {فاما ياتينكم مني هدي} [البقرة: ] قال: «القران»
 
  قوله: {فمن تبع هداي} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قوله: {فمن تبع هداي} [البقرة: ] «يعني البيان»
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، اخبرني بكير بن معروف، عن مقاتل بن حيان، في قول الله: {فمن تبع هداي} [البقرة: ] يقول: «فمن تبع محمدا صلي الله عليه وسلم»
 
    
 حدثنا ابي، ثنا شهاب بن عباد، ثنا ابراهيم بن حميد، عن ابي خالد {فمن تبع هداي} [البقرة: ] «يعني كتابي»
 
  قوله: {فلا خوف عليهم} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: {فلا خوف عليهم} [البقرة: ] «يعني في الاخرة»
 
  قوله: {ولا هم يحزنون} 
 [البقرة: ]
 
    
 وبه عن سعيد بن جبير، في قوله: {ولا هم يحزنون} [البقرة: ] «يعني لا يحزنون للموت»
 
  قوله: {والذين كفروا وكذبوا باياتنا} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد النرسي، ثنا يزيد بن سعيد، عن قتادة، قوله: {والذين كفروا} [البقرة: ] قال: «المشركون من قريش»
 
  قوله تعالي: {باياتنا} 
 [البقرة: ]
 
    
 حدثنا احمد بن عثمان بن حكيم، ثنا احمد بن المفضل، ثنا اسباط، عن السدي: «اما ايات الله فمحمد صلي الله عليه وسلم»
 
  والوجه الثاني
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، قوله: {باياتنا} [البقرة: ] «يعني القران»
 
  قوله: {اولءك اصحاب النار} 
 [سورة: البقرة، اية رقم: ]
 
    
 حدثنا ابو بكر بن ابي موسي الانصاري، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، ثنا اسباط بن نصر، عن السدي، عن ابي مالك، في قوله: {اصحاب النار} [البقرة: ] «يعذبون فيها»
 
  قوله: {هم فيها خالدون} 
 [سورة: البقرة، اية رقم: ]
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير عن ابن عباس: {اولءك اصحاب النار هم فيها خالدون} [البقرة: ] «اي خالدون ابدا»
 
    
 حدثنا ابي، ثنا ابو صفوان نصر بن قديد بن نصر بن سيار الليثي، ثنا ربعي بن عبد الله بن الجارود بن ابي سبرة الهذلي، عن الجارود بن ابي سبرة، عن انس، يرفعه قال: «المخلدون في النار في توابيت من حديد مطبقة»
 
  قوله: {يا بني اسراءيل} 
 [البقرة: ]
 
    
 حدثنا يونس بن حبيب، ثنا ابو داود، ثنا عبد الحميد بن بهرام، عن شهر، حدثني عبد الله بن عباس، قال: " حضرت عصابة من اليهود نبي الله صلي الله عليه وسلم فقال لهم: «هل تعلمون ان اسراءيل يعقوب؟» فقالوا: اللهم نعم، قال النبي صلي الله عليه وسلم: «اشهد عليهم»
 
  قوله: {اذكروا نعمتي التي انعمت عليكم} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير عن ابن عباس، قال: " يا اهل الكتاب، للاحبار من يهود: {اذكروا نعمتي التي انعمت عليكم} [البقرة: ] اي بلاءي عندكم وعند اباءكم؛ لما كان نجاهم به من فرعون وقومه "
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية، قال: «نعمته ان جعل، منهم الانبياء والرسل وانزل عليهم الكتب»
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: {يا بني اسراءيل اذكروا نعمتي التي انعمت عليكم} [البقرة: ] «فنعمة الله التي انعم بها علي بني اسراءيل فيما سمي وفيما سوي ذلك، فجر لهم الحجر وانزل عليهم المن، والسلوي، وانجاهم من عبودية ال فرعون»
 
  قوله: {واوفوا بعهدي} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: {واوفوا بعهدي} [البقرة: ] يقول: «ما امرتكم به من طاعة ونهيتكم عنه من معصية في النبي صلي الله عليه وسلم وغيره» وروي عن الربيع بن انس نحو ذلك من رواية حاتم بن اسماعيل، عن ابي جعفر
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة، عن محمد بن اسحاق، فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس: «اوفوا بعهدي الذي اخذت في اعناقكم للنبي صلي الله عليه وسلم اذ جاءكم»
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قوله: {واوفوا بعهدي} [البقرة: ] قال «عهده الي عبادة دينه الاسلام ان يتبعوه» وروي عن الضحاك، وقتادة، والسدي، والربيع نحو ذلك
 
  قوله: {اوف بعهدكم} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: {اوف بعهدكم} [البقرة: ] يقول: «ارضي عنكم وادخلكم الجنة»
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير عن ابن عباس، {اوف بعهدكم} [البقرة: ] «انجز لكم ما وعدتكم عليه بتصديقه واتباعه، فوضع عنكم ما كان عليكم من الاصر والاغلال التي كانت في اعناقكم بذنوبكم التي كانت من احداثكم» وروي عن ابي العالية، والضحاك، والسدي، والربيع بن انس نحو ما ذكرنا عن الضحاك عن ابن عباس
 
  قوله: {واياي فارهبون} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير عن ابن عباس: {واياي فارهبون} [البقرة: ] «ان انزل بكم ما انزلت بمن كان قبلكم من اباءكم من النقمات التي قد عرفتم من المسخ وغيره»
 
    
 حدثنا عصام بن الرواد العسقلاني، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية، {واياي فارهبون} [البقرة: ] «فاخشون» قال ابو محمد: وكذا روي عن السدي، والربيع بن انس، وقتادة
 
  قوله: {وامنوا بما انزلت مصدقا لما معكم} 
 [البقرة: ]
 
    
 به عن ابي العالية، في قوله: " {وامنوا بما انزلت مصدقا لما معكم} [البقرة: ] يقول: " يا معشر اهل الكتاب، امنوا بما انزلت علي محمد مصدقا لما معكم، يقول: لانهم يجدون محمدا مكتوبا عندهم في التوراة والانجيل "
 
  الوجه الثاني
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح
  [ص: ]
 ، عن مجاهد، قوله: {وامنوا بما انزلت مصدقا لما معكم} [البقرة: ] يقول: «بما انزلت القران، لما معكم الانجيل» قال: وروي عن الربيع بن انس، وقتادة نحو قول ابي العالية
 
  قوله: {ولا تكونوا اول كافر به} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة، عن محمد بن اسحاق، فيما حدثنا محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس: {ولا تكونوا اول كافر به} [البقرة: ] «وعندكم فيه من العلم ما ليس عند غيركم»
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قوله: {ولا تكونوا اول كافر به} [البقرة: ] يقول: «لا تكونوا اول من كفر بمحمد صلي الله عليه وسلم»
 
    
 حدثنا ابي، اخبرني عبيد الله بن حمزة، قال سمعت ابي، ثنا ابو سنان، في قوله: {ولا تكونوا اول كافر به} [البقرة: ] قال: «انزلت في يهود يثرب» قال ابو محمد: وروي عن الحسن، والسدي، والربيع بن انس نحو قول ابي العالية
 
  قوله: {ولا تشتروا باياتي ثمنا قليلا واياي فاتقون} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد بن الجراح، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قوله: {ولا تشتروا باياتي ثمنا قليلا} [البقرة: ] يقول: " لا تاخذوا عليه اجرا، قال: وهو مكتوب عندهم في الكتاب الاول: يا ابن ادم، علم مجانا كما علمت مجانا "
 
  قوله: {باياتي} 
 [البقرة: ]
 
    
 ذكر عن الحسن بن علي الحلواني، عن سعيد بن ابي مريم، اخبرني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قوله: {ولا تشتروا باياتي ثمنا قليلا} [البقرة: ] «وان اياته كتابه الذي انزل اليهم، وان الثمن القليل هو الدنيا وشهواتها»
 
  قوله: {ثمنا قليلا} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: {ولا تشتروا باياتي ثمنا قليلا} [البقرة: ] يقول: «لا تاخذوا طمعا قليلا، وتكتموا اسم الله، فذلك الطمع وهو الثمن»
 
  الوجه الثاني
 
    
 حدثنا علي بن الحسين، ثنا محمد بن علي بن حمزة المروزي، ثنا علي بن الحسن، انبا عبد الله بن المبارك، انبا عبد الرحمن بن يزيد بن جابر، عن هارون بن يزيد، قال: سءل الحسن عن قوله: {ثمنا قليلا} [البقرة: ] قال: " الثمن القليل: الدنيا بحذافيرها "
 
  قوله: {واياي فاتقون} 
 [البقرة: ]
 
    
 حدثنا ابو عمر الدوري، ثنا ابو اسماعيل المءدب، عن عاصم الاحول، عن ابي العالية، عن طلق بن حبيب، قال: «التقوي ان يعمل، بطاعة الله رجاء رحمة الله علي نور من الله، والتقوي ان يترك معصية الله مخافة عذاب الله علي نور من الله»
 
  قوله: {ولا تلبسوا الحق بالباطل} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قوله: {ولا تلبسوا الحق بالباطل} [البقرة: ] يقول: «ولا تخلطوا الحق بالباطل، وادوا النصيحة لعباد الله في امر محمد صلي الله عليه وسلم»
 
  الوجه الثاني
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد، عن قتادة، في قول الله: {ولا تلبسوا الحق بالباطل} [البقرة: ] قال: لا تلبسوا اليهودية، والنصرانية بالاسلام، ان دين الله الاسلام، واليهودية، والنصرانية بدعة ليست من الله " قال ابو محمد: وروي عن سعيد بن جبير، والربيع بن انس نحو ما ذكرنا عن ابي العالية، وروي عن الحسن نحو قول قتادة
 
  قوله: {وتكتموا الحق} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قول الله: {وتكتموا الحق} [البقرة: ] قال: «كتموا نعت محمد، وهم يجدونه مكتوبا عندهم»
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير عن ابن عباس: {وتكتموا الحق وانتم تعلمون} [البقرة: ] «اي تكتموا ما عندكم من المعرفة برسولي، وبما جاء به وانتم تجدونه عندكم فيما تعلمون من الكتب التي بايديكم»
 
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: {وتكتموا الحق} [البقرة: ] قال «الحق هو محمد صلي الله عليه وسلم» وروي عن مجاهد، وقتادة، والربيع بن انس نحو ذلك
 
  قوله: {وانتم تعلمون} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير عن ابن عباس: {وانتم تعلمون} [البقرة: ] «اي انتم تجدونه عندكم فيما تعلمون من الكتب التي بايديكم»
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد، عن قتادة، قوله: {وانتم تعلمون} [البقرة: ] قال: «وهم يعلمون انه رسول الله، وكتموا الاسلام وهم يعلمون انه دين الله»
 
  قوله: {واقيموا الصلاة} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا مبارك بن فضالة، عن الحسن، في قوله: {واقيموا الصلاة} [البقرة: ] قال: «فريضة واجبة لا تنفع الاعمال الا بها وبالزكاة»
 
    
 حدثنا علي بن الحسين، ثنا عبد الرحمن بن ابراهيم دحيم، ثنا الوليد، ثنا عبد الرحمن بن نمر، قال: سالت الزهري عن قول الله، {واقيموا الصلاة} [البقرة: ] قال الزهري: «اقامتها ان تصلي الصلوات الخمس لوقتها» . قال ابو محمد: وكذا روي عن عطاء بن ابي رباح، وقتادة نحو قول الحسن
 
    
