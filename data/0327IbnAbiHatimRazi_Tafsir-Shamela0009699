 [النور: ]
 
    
 حدثنا الحسين بن الحسن، ثنا ابراهيم بن عبد الله الهروي، انبا حجاج، عن ابن جريج، عن مجاهد: " {لواذا} [النور: ] قال: خلافا "
 
    
 قرات علي محمد بن الفضل، ثنا محمد بن علي، ثنا محمد بن مزاحم، ثنا بكير بن معروف، عن مقاتل بن حيان: قوله: " {قد يعلم الله الذين يتسللون منكم لواذا} [النور: ] هم المنافقون كان يثقل عليهم الحديث في يوم الجمعة، ويعني بالحديث: الخطبة ليلوذون ببعض اصحاب محمد حتي يخرجوا من المسجد، وكان لا يصلح للرجل ان يخرج من المسجد الا باذن من النبي صلي الله عليه وسلم، في يوم الجمعة بعد ما ياخذ في الخطبة وكان اذا اراد احدهم الخروج اشار باصبعه الي النبي صلي الله عليه وسلم فياذن له من غير ان يتكلم الرجل؛ لان الرجل كان اذا تكلم والنبي صلي الله عليه وسلم يخطب بطلت جمعته "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: قوله: " {قد يعلم الله الذين يتسللون منكم لواذا} [النور: ] قال: كانوا اذا كانوا معه في جماعة لاذ بعضهم ببعضهم حتي يتغيبوا عنه فلا يراهم "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن ابي حماد، ثنا مهران، عن سفيان: " {قد يعلم الله الذين يتسللون منكم لواذا} [النور: ] قال: فرارا "
 
  قوله تعالي {فليحذر الذين يخالفون عن امره} 
 [النور: ]
 
    
 قرات علي محمد بن الفضل، ثنا محمد بن علي، ثنا محمد بن مزاحم، ثنا بكير بن معروف، عن مقاتل بن حيان: قوله: " {فليحذر الذين يخالفون عن امره،} [النور: ] يعني: المنافقين "
 
    
 حدثنا ابي، ثنا علي بن محمد الطنافسي، ثنا ابو علي عبد الصمد بن صبيح، عن الحسن بن صالح، قال: " اني لخاءف علي من ترك المسح علي الخفين ان يكون داخلا في هذه الاية {فليحذر الذين يخالفون عن امره ان تصيبهم فتنة} [النور: ] "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ، قال: سمعت ابن زيد، في قول الله: " {فليحذر الذين يخالفون عن امره} [النور: ] الذين يصنعون هذا "
 
  قوله تعالي {ان تصيبهم فتنة} 
 [النور: ]
 
    
 قرات علي محمد بن الفضل، ثنا محمد بن علي، ثنا محمد بن مزاحم، ثنا بكير بن معروف، عن مقاتل: قوله: " {ان تصيبهم فتنة} [النور: ] يعني بالفتنة الكفر " وروي عن السدي، وعبد الرحمن بن زيد بن اسلم نحو ذلك
 
  قوله تعالي {او يصيبهم عذاب اليم} 
 [النور: ]
 
    
 وبه عن مقاتل بن حيان: " {او يصيبهم عذاب اليم} [النور: ] يعني: القتل في الدنيا "
 
  قوله تعالي {الا ان لله ما في السموات والارض}
 
    
 حدثنا علي بن طاهر، ثنا محمد بن العلاء يعني ابا كريب ثنا عثمان بن سعيد الزيات، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قال: " قال جبريل عليه السلام: يا محمد «لله الخلق كله، السموات كلهن ومن فيهن، والارضون كلهن ومن فيهن، وما بينهن مما يعلم ومما لا يعلم»
 
  قوله تعالي {قد يعلم ما انتم عليه} 
 [النور: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: " {الا ان لله ما في السموات والارض، قد يعلم ما انتم عليه} قال
  [ص: ]
 : ما كان قوم قط علي امر ولا حال الا كانوا بعين الله والا كان عليهم شاهد من الله عز وجل "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد، في قوله تعالي: " {قد يعلم ما انتم عليه} [النور: ] صنيعكم هذا "
 
  قوله تعالي {ويوم يرجعون اليه} 
 [النور: ]
 
    
 حدثنا عصام بن رواد العسقلاني، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية: " {يرجعون اليه} [النور: ] قال: يرجعون اليه بعد الحياة "
 
  قوله تعالي {فينبءهم بما عملوا والله بكل شء عليم} 
 [النور: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله عز وجل: " {والله بكل شء عليم} [النور: ]
 
  سورة الفرقان 
 بسم الله الرحمن الرحيم
 
  قوله تعالي: {تبارك} 
 [الاعراف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن العلاء، ثنا عثمان بن سعيد الزيات، انبا بشر بن عمارة، ثنا ابو روق، عن الضحاك، عن ابن عباس، قال: " {تبارك} [الفرقان: ] تفاعل من البركة وروي عن ابي مالك الغفاري نحو ذلك
 
  قوله تعالي {الذي نزل الفرقان} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا عبدة، انبا عبد الله بن المبارك، انبا صفوان بن عمرو، حدثني عبد الرحمن بن جبير بن نفير، عن ابيه، قال: جلسنا الي المقداد بن الاسود يوما فقال: " لقد بعث النبي صلي الله عليه وسلم وجاهلية ما يرون ان دينا افضل من عبادة الاوثان فجاء بفرقان فرق بين الحق والباطل وفرق بين الوالد وولده حتي ان الرجل ليري والده او ولده او اخاه كافرا قد فتح الله قفل قلبه للايمان يعلم انه ان هلك دخل النار فلا يقر عينا وهو يعلم ان حبيبه في النار وانها للتي قال الله: {الذين يقولون ربنا هب لنا من ازواجنا وذرياتنا قرة اعين} [الفرقان: ] الاية "
 
    
 حدثنا ابو سعيد الاشج، ثنا تليد بن سليمان، عن عطاء بن الساءب، عن سعيد بن جبير، في قوله: " {نزل الفرقان} [الفرقان: ] قال: خواتيم سورة البقرة من كنز تحت العرش "
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن الدشتكي، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع، في قوله: " {نزل الفرقان} [الفرقان: ] قال: الفرقان فرق بين الحق والباطل "
 
    
 حدثنا علي بن الحسين، ثنا عثمان بن ابي شيبة، ثنا معاوية بن هشام، ثنا سفيان، عن رجل، عن مجاهد، قال: انما «سمي الفرقان؛ لانه فرق بين الحق والباطل»
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {تبارك الذي نزل الفرقان علي عبده} [الفرقان: ] يقول: «الفرقان فيه حلال الله وحرامه وشراءعه ودينه فرق بين الحق والباطل»
 
  قوله تعالي {علي عبده} 
 [الكهف: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو كريب، ثنا يونس بن بكير، قال ابن اسحاق: {علي عبده} [الفرقان: ] يعني: «محمدا صلي الله عليه وسلم»
 
  قوله تعالي {ليكون للعالمين نذيرا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا الوليد، ثنا الفرات بن الوليد، عن مغيث بن سمي، عن تبيع، قال: «العالمين الف امة، فستماءة في البحر واربعماءة في البر»
 
    
 حدثنا ابي، ثنا ابو غسان مالك بن اسماعيل، ثنا قيس، عن عطاء بن الساءب، عن سعيد بن جبير، عن ابن عباس، في قوله: " {للعالمين} [الفرقان: ] قال: الجن والانس "
 
    
 حدثنا الحسن بن احمد، ثنا موسي بن محلم، ثنا ابو بكر الحنفي، ثنا عباد بن منصور، عن الحسن، في قوله: " {العالمين} [الفرقان: ] قال: الناس كلهم "
 
  قوله تعالي {نذيرا} 
 [الفرقان: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، عن سعيد، عن قتادة: قوله: " {ليكون للعالمين نذيرا} [الفرقان: ] بعث الله محمدا صلي الله عليه وسلم نذيرا من النار وينذر باس الله ووقاءعه بمن خلا قبلكم "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي انبا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد، في قول الله: " {ليكون للعالمين نذيرا} [الفرقان: ] قال: النبي صلي الله عليه وسلم النذير، وقرا: {وان من امة الا خلا فيها نذير} [فاطر: ] وقرا: {وما اهلكنا من قرية الا لها منذرون} [الشعراء: ] قال: رسل. المنذرون: الرسل، قال: وكان نذيرا واحدا بلغ ما بين المشرق والمغرب ذو القرنين، ثم بلغ السدين، وكان نذيرا ولم اسمع بحق انه كان نبيا "
 
  قوله تعالي {الذي له ملك السموات والارض}
 
    
 حدثنا علي بن الحسين، ثنا محمد بن العلاء ابو كريب، ثنا عثمان بن سعيد، ثنا سعيد، ثنا بشر بن عمارة، ثنا ابو روق، عن الضحاك، عن عبد الله بن عباس، قال: " قال جبريل: يا محمد " لله الخلق كله: السموات كلهن ومن فيهن، والارضون كلهن ومن فيهن وما بينهن مما يعلم ومما لا يعلم يقول: اعلم يا محمد ان ربك هذا لا يشبهه شء بالصفة التي الهمك "
 
  قوله تعالي {ولم يتخذ ولدا} 
 [الفرقان: ]
 
    
 حدثنا ابو عبد الله الطهراني، انبا حفص بن عمر العدني، ثنا الحكم بن ابان، عن عكرمة، قال: " قالت اليهود: عزير ابن الله، وقالت النصاري: المسيح ابن الله وقالت الصابءة: نحن نعبد الملاءكة من دون الله، وقالت المجوس: نحن نعبد الشمس والقمر من دون الله، وقال اهل الاوثان نحن نعبد الاوثان من دون الله، فاوحي الله الي نبيه صلي الله عليه وسلم؛ ليكذب قولهم {ولم يتخذ ولدا} [الفرقان: ] "
 
  قوله تعالي {ولم يكن له شريك في الملك} 
 [الاسراء: ]
 
    
 اخبرنا يونس بن عبد الاعلي، قراءة، انبا ابن وهب، انبا ابو صخر، عن القرظي محمد بن كعب في هذه الاية: " {ولم يكن له شريك في الملك} [الاسراء: ] قال: قالت اليهود والنصاري: اتخذ الله ولدا، وقالت العرب: لبيك اللهم لبيك لا شريك لك الا شريكا هو لك، وقالت الصابءة والمجوس: لولا اولياء الله لذل الله فانزل الله عز وجل: {لم يتخذ ولدا ولم يكن له شريك في الملك} [الاسراء: ] "
 
  قوله تعالي {وخلق كل شء} 
 [الانعام: ]
 
    
 اخبرنا ابو عبد الله محمد بن حماد الطهراني فيما كتب الي، انبا اسماعيل بن عبد الكريم، حدثني عبد الصمد بن معقل، انه سمع عمه وهب بن منبه، يقول: " قال عزير: اللهم رب انك تسميت الرحمن الرحيم ارحم الراحمين؛ لانك ترحم الخاطءين وتتجاوز عن المذنبين، وتسميت الجواد؛ لانك تعطي اكثر مما تسال، انما نحن خلقك وعمل يديك، خلقت اجسادنا في ارحام امهاتنا وصورتنا كيف تشاء، بقدرتك جعلت لنا اركانا، وجعلت فيها عظاما، وشققت لنا اسماعا وابصارا، ثم جعلت لها في تلك الظلمة نورا وفي ذلك الضيق فسحا، وفي ذلك الفم روحا، ثم هيات لها بحكمتك
  [ص: ]
 رزق الحامل والمحمول، كلاهما انت تحمل وترزق، فلما اخرجته لمدته امرت الاركان فتجلبت وامرت العروق فتشبكت، وخلقت له لبنا صافيا من فضلك، وجعلته لخلقك الذي خلقت رزقا، ثم هيات له من فضلك رزقا يقوته علي مشيءتك، ثم وعظته بكتابك، ثم قضيت عليه الموت لا محالة، ثم انت تعيده كما بداته "
 
  قوله تعالي {فقدره تقديرا} 
 [الفرقان: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {وخلق كل شء فقدره تقديرا} [الفرقان: ] من خلقه وصلاحه وجعل ذلك بقدر معلوم "
 
  قوله تعالي {واتخذوا من دونه الهة} 
 [الفرقان: ]
 
    
 به عن قتادة، " {واتخذوا من دونه الهة} [الفرقان: ] وهي هذه الاوثان التي تعبد من دون الله عز وجل "
 
  قوله تعالي {لا يخلقون شيءا وهم يخلقون} 
 [النحل: ]
 
    
 وبه عن قتادة: قوله: " {لا يخلقون شيءا وهم يخلقون} [النحل: ] وهو الله الخالق الرازق، وهذه الاوثان التي تعبد من دون الله تخلق ولا تخلق شيءا "
 
  قوله تعالي {ولا يملكون لانفسهم ضرا ولا نفعا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابو حذيفة، ثنا شبل، عن ابن ابي نجيح، عن مجاهد: " {ضرا ولا نفعا} [الماءدة: ] ضرا قال: ضلالة "
 
  قوله تعالي {ولا يملكون موتا ولا حياة} 
 [الفرقان: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {ولا يملكون موتا ولا حياة} [الفرقان: ] وهي هذه الاوثان التي تعبد من دون الله لا تضر ولا تنفع ولا تملك موتا ولا حياة، وفي قوله: {ولا نشورا} [الفرقان: ] اي: ولا بعثا "
 
  قوله تعالي {وقال الذين كفروا} 
 [ابراهيم: ]
 
    
 حدثنا علي بن الحسين الهسنجاني، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة يعني: " قوله {وقال الذين كفروا} [الفرقان: ] قال: هذا قول مشركي العرب "
 
  قوله تعالي {ان هذا الا افك افتراه} 
 [الفرقان: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا يحيي بن يمان، عن اشعث، عن جعفر، عن سعيد بن جبير، قال: «كل شء في القران افك فهو كذب»
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {وقال الذين كفروا ان هذا الا افك افتراه} [الفرقان: ] والافك هو الكذب "
 
  قوله تعالي {واعانه عليه} 
 [الفرقان: ]
 
    
 به عن قتادة: قوله: " {واعانه عليه} [الفرقان: ] اي: علي حديثه هذا وامره "
 
  قوله تعالي {قوم اخرون} 
 [الفرقان: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {واعانه عليه قوم اخرون} [الفرقان: ] قال: يهود "
 
  قوله تعالي {فقد جاءوا ظلما وزورا}
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد، ثنا سعيد، عن قتادة: قوله: « {فقد جاءوا ظلما وزورا} قد اتوا ظلما وزورا»
 
  قوله تعالي {وزورا} 
 [الفرقان: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {ظلما وزورا} [الفرقان: ] كذبا "
 
  قوله تعالي {وقالوا اساطير الاولين} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد، عن قتادة: " {وقالوا اساطير الاولين} [الفرقان: ] اي: كذب الاولين وباطلهم "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة: " {قالوا اساطير الاولين} [النحل: ] يقول: احاديث الاولين وباطلهم "
 
  قوله تعالي {فهي تملي عليه بكرة واصيلا} 
 [الفرقان: ]
 
    
 حدثنا علي بن الحسين، ثنا عبد الرحيم الرزيقي، ثنا ابن المبارك، عن الربيع بن انس، حدثني ابو العالية، في قوله: " {بكرة} [الفرقان: ] قال: صلاة الفجر وقوله: {واصيلا} [الفرقان: ] قال: صلاة العصر "
 
  قوله تعالي {قل انزله الذي يعلم السر في السموات والارض}
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، قال: قال ابن عباس: " خلق الله اللوح المحفوظ كمسيرة ماءة عام فقال للقلم قبل ان يخلق الخلق وهو علي العرش تبارك وتعالي: اكتب، فقال القلم: وما اكتب؟ قال: علمي في خلقي الي يوم تقوم الساعة، فجري القلم بما هو كاءن في علم الله الي يوم القيامة فذلك يقول للنبي صلي الله عليه وسلم: يعلم ما في السماء والارض "
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {يعلم السر} [الفرقان: ] قال: السر ما اسر ابن ادم في نفسه "
 
    
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا ابو عامر العقدي، ثنا سفيان، عن ابي روق، عن الضحاك بن مزاحم، قال: «السر ما حدثت به نفسك»
 
    
 اخبرنا يونس بن عبد الاعلي، قراءة، انا ابن وهب، انبا حفص بن ميسرة، عن زيد بن اسلم، في قول الله: " {يعلم السر} [الفرقان: ] قال: يعلم سرار العبد. تقدم تفسيره غير مرة
 
  قوله تعالي {انه كان غفورا رحيما} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني ابن لهيعة، حدثني عطاء، عن سعيد بن جبير: قوله: " {غفورا} [النساء: ] يعني: لما كان منهم في الشرك: {رحيما} [النساء: ] بهم في الاسلام "
 
  قوله تعالي {وقالوا ما لهذا الرسول ياكل الطعام}
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: « {وقالوا ما لهذا الرسول ياكل الطعام ويمشي في الاسواق} عجب الكفار من ذلك ان يكون رسول ياكل الطعام ويمشي في الاسواق»
 
  قوله تعالي {ويمشي في الاسواق} 
 [الفرقان: ]
 
    
 حدثنا عبد الله بن سليمان بن الاشعث، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: قوله: " {ياكل الطعام ويمشي في الاسواق} [الفرقان: ] قال: هي الطريق "
 
  قوله تعالي {لولا انزل اليه ملك فيكون معه نذيرا} 
 [الفرقان: ]
 
    
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، قال: " وانزل الله جل وعز عليه في قولهم ان خذ لنفسك ما قالوا ان تاخذ لها ان تجعل لهم جنات وقصورا وكنوزا، وان تبعث معه ملكا يصدق ما يقول ويرد عنك من خاصمك: {وقالوا ما لهذا الرسول ياكل الطعام ويمشي في الاسواق لولا انزل اليه ملك فيكون معه نذيرا او يلقي اليه كنز او تكون له جنة ياكل منها} "
 
  قوله تعالي {وقال الظالمون ان تتبعون الا رجلا مسحورا} 
 [الفرقان: ]
 
    
 حدثنا احمد بن سنان الواسطي، ثنا ابو معاوية، عن الاعمش، عن عبد الله بن مرة، عن البراء: قوله: " {الظالمون} [الفرقان: ] قال: اليهود "
 
  قوله تعالي {انظر كيف ضربوا لك الامثال فضلوا} 
 [الاسراء: ]
 
    
 حدثنا محمد بن العباس، ثنا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، يقول الله سبحانه وبحمده: " {انظر كيف ضربوا لك الامثال فضلوا} [الاسراء: ] اي: التمسوا الهدي في غير ما بعثك به اليهم فضلوا "
 
  قوله تعالي {فلا يستطيعون سبيلا} 
 [الاسراء: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {فلا يستطيعون سبيلا} [الاسراء: ] مخرجا يخرجهم من الامثال التي ضربوا لك "
 
    
 حدثنا محمد بن العباس، ثنا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق: قوله: " {فلا يستطيعون سبيلا} [الاسراء: ] اي: التمسوا الهدي في غير ما بعثتك فلن يستطيعوا ان يصيبوا الهدي في غيره "
 
  قوله تعالي {تبارك الذي ان شاء جعل لك خيرا من ذلك} 
 [الفرقان: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو نعيم، عن سفيان، عن حبيب بن ابي ثابت، عن خيثمة، قال: قيل للنبي صلي الله عليه وسلم نعطيك خزاءن الارض ومفاتيحها لم نعطها احدا قبلك لا ينقصك ذلك عند الله شيءا، قال: «اجمعها لي في الاخرة» فقال الله عز وجل: {تبارك الذي ان شاء جعل لك خيرا من ذلك جنات} [الفرقان: ] الاية "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {ان شاء جعل لك خيرا من ذلك} [الفرقان: ] مما قالوا "
 
    
 حدثنا محمد بن يحيي، انبا العباس، ثنا يزيد، ثنا سعيد، عن قتادة: " قوله {تبارك الذي ان شاء جعل لك خيرا من ذلك} [الفرقان: ] اي: مما قال الكفار من الكنز والجنة جنات تجري من تحتها الانهار "
 
    
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو زنيج، ثنا سلمة بن الفضل، ثنا محمد بن اسحاق، قال: " ثم قال: {تبارك الذي ان شاء جعل لك خيرا من ذلك} [الفرقان: ] ان تمشي في الاسواق وتلتمس المعاش كما يلتمسه الناس جنات تجري من تحتها الانهار ويجعل لك قصورا "
 
  قوله تعالي {جنات} 
 [البقرة: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: " {جنات تجري من تحتها الانهار} [البقرة: ] قال: حواءط. تقدم تفسيره غير مرة
 
  قوله تعالي {ويجعل لك قصورا} 
 [الفرقان: ]
 
    
 به عن مجاهد: قوله: " {ويجعل لك قصورا} [الفرقان: ] بيوتا مبنية مشيدة كانت قريش تري البيت من حجارة قصرا كاءنا ما كان "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر، ثنا اسباط، عن السدي: قوله: " {ويجعل لك قصورا} [الفرقان: ] قال: جعل الله له في الاخرة الجنات والقصور "
 
  قوله تعالي {بل كذبوا بالساعة واعتدنا لمن كذب بالساعة سعيرا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا يحيي بن عبد الحميد، عن يحيي بن يمان، عن سلمة بن كهيل، عن سعيد بن جبير: " السعير قال: واد من فيح في جهنم {اذا راتهم من مكان بعيد} [الفرقان: ] "
 
  قوله تعالي {اذا راتهم من مكان بعيد} 
 [الفرقان: ]
 
    
 حدثنا ادريس بن حاتم بن الاحنف الواسطي، انه سمع محمد بن الحسن الواسطي، عن اصبغ بن زيد، عن خالد بن كثير، عن خالد بن دريك، عن رجل من اصحاب النبي صلي الله عليه وسلم قال: قال رسول الله صلي الله عليه وسلم: «من يقل علي ما لم اقل، وادعي الي غير والديه، وانتمي الي غير مواليه فيتبوا بين عيني جهنم مقعدا» ، قيل: يا رسول الله وهل لها من عينين؟ قال: " اما سمعتم الله يقول: {اذا راتهم من مكان بعيد} [الفرقان: ] " الاية
 
  قوله تعالي {من مكان بعيد} 
 [الفرقان: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر، ثنا اسباط، عن السدي: قوله: " {من مكان بعيد} [الفرقان: ] قال: من مسيرة ماءة عام "
 
  قوله تعالي {سمعوا لها تغيظا وزفيرا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا علي بن محمد الطنافسي، ثنا ابو بكر بن عياش، عن عيسي بن سليم، عن ابي واءل، قال: خرجنا مع عبد الله ومعنا ربيع بن خثيم " فمروا علي حداد فقام عبد الله ينظر الي حديدة في النار ونظر الربيع بن خثيم اليها فتمايل ليسقط فمر عبد الله علي اتون علي شاطء الفرات فلما راه عبد الله والنار تلتهب في جوفه قرا هذه الاية: {اذا راتهم من مكان بعيد سمعوا لها تغيظا وزفيرا} [الفرقان: ] الاية صعق فحملوه الي اهله ورابطه عبد الله الي الظهر فلم يفق "
 
  قوله تعالي {وزفيرا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا عبد الله بن رجاء، ثنا اسراءيل، عن ابي يحيي، عن مجاهد، عن ابن عباس، قال: ان «العبد ليجر الي النار فتشهق اليه شهقة البغلة الي الشعير ثم تزفر زفرة لا يبقي احد الا خاف»
 
    
 اخبرنا ابو عبد الله محمد بن حماد الطهراني فيما كتب الي، انبا عبد الرزاق، انبا معمر، عن منصور، عن مجاهد، عن عبيد بن عمير الليثي، في قوله: " {سمعوا لها، تغيظا وزفيرا} [الفرقان: ] قال: ان جهنم تزفر زفرة لا يبقي ملك ولا نبي الا خر ترتعد فراءصه حتي ان ابراهيم ليجثو علي ركبتيه فيقول: رب لا اسالك اليوم الا نفسي "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر، ثنا اسباط، عن السدي: " قوله {سمعوا لها تغيظا وزفيرا} [الفرقان: ] قال: الزفير الصوت تغيظا عليهم "
 
  قوله تعالي {واذا القوا منها مكانا ضيقا} 
 [الفرقان: ]
 
    
 قرء علي يونس بن عبد الاعلي، انبا ابن وهب، اخبرني نافع بن يزيد، عن يحيي بن ابي اسيد، يرفع الحديث الي رسول الله صلي الله عليه وسلم انه سءل عن قول الله عز وجل: {واذا القوا منها مكانا ضيقا مقرنين} [الفرقان: ] قال: «والذي نفسي بيده» انهم ليستكرهون في النار كما يستكره الوتد في الحاءط "
 
    
 حدثنا ابي، ثنا عبدة بن سليمان، انبا ابن المبارك، انبا محمد بن يسار، عن قتادة، في قوله: {واذا القوا منها مكانا ضيقا مقرنين} [الفرقان: ] قال: ذكر لنا ان عبد الله بن عمرو كان يقول: " ان جهنم لتضيق علي الكفار كتضيق الزج علي الرمح قال ابو محمد: لم يروه عنه الا ابن المبارك
 
    
 حدثنا ابي، ثنا محمود بن غيلان، ثنا مءمل، عن يزيد بن زريع، عن سعيد، عن قتادة، عن ابي ايوب، عن عبد الله بن عمرو: " {واذا القوا منها مكانا ضيقا} [الفرقان: ] قال: مثل الزج في الرمح وروي عن يحيي بن الجزار، عن مجاهد نحو ذلك
 
  قوله تعالي {مقرنين} 
 [ابراهيم: ]
 
    
 حدثنا ابي، ثنا محمد بن المصفي، ثنا معاوية بن حفص، عن يحيي بن زكريا بن ابي زاءدة، عن اسماعيل بن ابي خالد، عن ابي صالح، في قوله: " {مقرنين} [الفرقان: ] قال: مكتفين "
 
  قوله تعالي {دعوا هنالك ثبورا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {ثبورا} [الفرقان: ] يقول: ويلا "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو بكير النخعي، عن جويبر، عن الضحاك: " {دعوا هنالك ثبورا} [الفرقان: ] قال: دعوا بالهلاك فقالوا: واهلاكا واهلكتاه "
 
  قوله تعالي {لا تدعوا اليوم ثبورا واحدا} 
 [الفرقان: ]
 
    
 حدثنا احمد بن سنان، ثنا عفان، ثنا حماد بن سلمة، انبا علي بن زيد، عن انس بن مالك، قال: قال رسول الله صلي الله عليه وسلم: «ان» اول من يكسي حلة من النار ابليس، فيضعها علي حاجبه ويسحبها خلفه وهو ينادي: واثبوراه، وذريته خلفه ينادون: يا ثبورهم فيقال: {لا تدعوا اليوم ثبورا واحدا وادعوا ثبورا كثيرا} [الفرقان: ] "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو بكير النخعي، عن جويبر، عن الضحاك: " {لا تدعوا اليوم ثبورا واحدا} [الفرقان: ] فقيل لهم: لا تدعوا بهلاك واحد "
 
    
 اخبرنا محمد بن سعد العوفي، فيما كتب الي حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، عن ابن عباس: قوله: " {لا تدعوا اليوم ثبورا واحدا} [الفرقان: ] يقول: لا تدعوا اليوم ويلا واحدا "
 
  قوله تعالي {وادعوا ثبورا كثيرا} 
 [الفرقان: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو بكير النخعي، عن جويبر، عن الضحاك: " {وادعوا ثبورا كثيرا} [الفرقان: ] قال: ولكن ادعوا بهلاك كثير "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: " {لا تدعوا اليوم ثبورا واحدا وادعوا ثبورا كثيرا} [الفرقان: ] اي: ويلا كثيرا "
 
  قوله تعالي {قل اذلك خير ام جنة الخلد التي وعد المتقون} [الفرقان: ] قد تقدم تفسير المتقين: لا يكون الرجل من المتقين، الحديث. غير مرة
 
  قوله تعالي {كانت لهم جزاء ومصيرا} 
 [الفرقان: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {كانت لهم جزاء} [الفرقان: ] اي: جزاء من الله باعمالهم، {ومصيرا} [الفرقان: ] اي: منزلا "
 
  قوله تعالي {لهم فيها ما يشاءون}
 
    
 حدثنا ابي، حدثنا ابو صالح كاتب الليث بن سعد، حدثني الليث بن سعد حدثني عبيد الله بن ابي جعفر، عن عطاء بن يسار، عن كعب الاحبار، قال: " من مات وهو يشرب الخمر لم يشربها في الاخرة وان دخل الجنة، فقال عطاء: يا ابا اسحاق فان الله عز وجل يقول: {لهم فيها ما يشاءون} ، قال كعب: «انه ينساها فلا يذكرها»
 
    
 حدثنا ابي، ثنا عمرو بن رافع، ثنا يعقوب القمي، عن جعفر، عن سعيد بن جبير، عن ابن عباس، قال: " اخس اهل الجنة منزلا له سبعون الف خادم مع كل خادم صحفة من ذهب لو نزل به جميع اهل الارض او جلهم لا يستعين عليهم بشء من عند غيره وذلك في قول الله عز وجل: {لهم فيها ما يشاءون} "
 
    
 حدثنا علي بن الحسين، ثنا عثمان بن ابي شيبة، ثنا معاوية بن هشام، عن سفيان، عن منصور، قال: سءل ابن عباس " في الجنة ولد؟ قال: ان شاءوا "
 
  قوله تعالي {خالدين} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة، قال: قال محمد بن اسحاق حدثني محمد بن ابي محمد، عن سعيد بن جبير، او عكرمة، عن ابن عباس: " {خالدين} [الفرقان: ] يخبرهم ان الثواب بالخير والشر مقيم علي اهله ابدا لا انقطاع له "
 
  قوله تعالي {كان علي ربك وعدا مسءولا}
 
    
 حدثنا ابي، ثنا ابراهيم بن موسي، انبا هشام بن يوسف، عن ابن جريج، عن عطاء، عن ابن عباس: " {كان علي ربك وعدا مسءولا} يقول: سلوا الذي واعدتكم او قال: واعدناكم تنجزوه "
 
    
 قرء علي يونس بن عبد الاعلي، انا ابن وهب، اخبرني عمرو بن الحارث، حدثني سعيد بن ابي هلال، انه سمع القرظي، يقول في قول الله عز وجل: " {كان علي ربك وعدا مسءولا} ان الملاءكة تسال لهم في قولهم ذلك: {وادخلهم جنات عدن التي وعدتهم} [غافر: ]
 
 قال سعيد: وسمعت ابا حازم يقول: " اذا كان يوم القيامة قال المءمنون: ربنا عملنا لك بالذي امرتنا فانجز لنا ما وعدتنا فذلك قوله: {وعدا مسءولا} "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي انبا اصبغ، قال: سمعت عبد الرحمن بن زيد، في قول الله عز وجل: " {كان علي ربك وعدا مسءولا} قال: سالوه اياها في الدنيا طلبوا ذلك فاعطاهم وعدهم اذا سالوه ووقت ارزاق العباد في الارض قبل ان يخلقهم فجعلها اقواتا للساءلين ووقت ذلك علي مساءلهم وقرا فيها قال: {وقدر فيها اقواتها في اربعة ايام سواء للساءلين} [فصلت: ] "
 
  قوله تعالي {ويوم يحشرهم} 
 [الانعام: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة: قوله: " {يوم} [الفرقان: ] قال: يوم القيامة "
 
    
 حدثنا ابو زرعة، ثنا ابن نمير، عن حنظلة القاص، عن الضحاك، عن ابن عباس، قال: «يحشر كل شء حتي ان الذباب ليحشر»
 
    
 حدثنا عمرو الاودي، ثنا وكيع، عن الاعمش، قال: سمعتهم يذكرون، عن مجاهد: " {ويوم يحشرهم} [الفرقان: ] قال: حشر الموت "
 
  قوله تعالي {وما يعبدون من دون الله} 
 [مريم: ]
 
    
 حدثنا الحجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {ويوم يحشرهم وما يعبدون من دون الله} [الفرقان: ] «هءلاء عيسي وعزير والملاءكة»
 
  قوله تعالي {فيقول اانتم اضللتم عبادي هءلاء ام هم ضلوا السبيل} 
 [الفرقان: ]
 
    
 قرات علي محمد بن الفضل بن موسي، ثنا محمد بن علي، ثنا محمد بن مزاحم، ثنا بكير، عن مقاتل بن حيان يعني قوله: " {ام هم ضلوا السبيل} [الفرقان: ] يقول: قد اخطا قصد السبيل "
 
  قوله تعالي {قالوا سبحانك ما كان ينبغي لنا ان نتخذ} 
 [الفرقان: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {قالوا سبحانك ما كان ينبغي لنا ان نتخذ من دونك من اولياء} [الفرقان: ] هذا قول الالهة "
 
  قوله تعالي {من اولياء} 
 [هود: ]
 
    
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن الفضل، ثنا اسباط، عن السدي: قوله: " {من اولياء} [هود: ] قال: اما الولي فالذي يتولاه الله ويقر له بالربوبية "
 
  قوله تعالي {ولكن متعتهم واباءهم} 
 [الفرقان: ]
 
    
 اخبرنا محمد بن سعد العوفي، فما كتب الي حدثني ابي، حدثني عمي، حدثني ابي، عن جده، عن ابن عباس: قوله: " {ولكن متعتهم واباءهم حتي نسوا الذكر} [الفرقان: ] يقول: قوم قد ذهبت اعمالهم في الدنيا ولم يكن لهم اعمال صالحة "
 
  قوله تعالي {حتي نسوا الذكر} 
 [الفرقان: ]
 
    
 قرء علي يونس بن عبد الاعلي، انبا ابن وهب، قال: سالت عبد الرحمن بن زيد بن اسلم، عن قول الله " {الذكر} [الفرقان: ] قال: القران "
 
  قوله تعالي {وكانوا قوما بورا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {بورا} [الفرقان: ] يقول: هلكي "
 
    
 حدثنا ابي، ثنا ابو ربيعة زيد بن عوف، ثنا عوف بن موسي، ثنا فرقد السبخي، عن شهر بن حوشب، في قوله: " {وكانوا قوما بورا} [الفرقان: ] قال: معناه فسدتم "
 
    
 حدثنا ابي، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، " {وكانوا قوما بورا} [الفرقان: ] قال: هو الفساد "
 
    
 حدثنا ابي، انبا ابو الجماهر، ثنا سعيد، حدثني سويد، عن قتادة «البور بكلام عمان»
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {وكانوا قوما بورا} [الفرقان: ] والبور: الفاسد وانه والله ما نسي قوم قط ذكر الله الا باروا وفسدوا "
 
    
 اخبرنا ابو عبد الله محمد بن حماد الطهراني فيما كتب الي، انبا عبد الرزاق، انبا معمر، عن الحسن، في قوله: " {وكنتم قوما بورا} [الفتح: ] قال: هم الذين لا خير فيهم "
 
  قوله تعالي {فقد كذبوكم بما تقولون} 
 [الفرقان: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، " {فقد كذبوكم بما تقولون} [الفرقان: ] يقول الله للذين كانوا يعبدون عيسي وعزيرا والملاءكة حيث قالوا: سبحانك انت ولينا من دونهم، يقول الله: {فقد كذبوكم بما تقولون} [الفرقان: ] عيسي وعزير والملاءكة حيث يعذبون  او قال: حين يكذبون  المشركين "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، قال: سمعت عبد الرحمن بن زيد، في قول الله: " {فقد كذبوكم بما تقولون} [الفرقان: ] قال: كذبوكم بما جاء من عند الله جاءت به الانبياء، المءمنون امنوا به، وكذبوا هءلاء "
 
  قوله تعالي {فما تستطيعون صرفا ولا نصرا} 
 [الفرقان: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {فما تستطيعون صرفا ولا نصرا} [الفرقان: ] المشركون لا يستطيعون صرف العذاب ولا نصر انفسهم "
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، انبا اصبغ، قال: سمعت عبد الرحمن بن زيد، في قول الله عز وجل: " {فما تستطيعون صرفا ولا نصرا} [الفرقان: ] فما يستطيعون يصرفوا العذاب عنهم الذي نزل بهم حين كذبوا ولا ان ينصروا قال: وينادي مناد يوم القيامة حيث يجمع الله الخلاءق: {ما لكم لا تناصرون} [الصافات: ] قال: من عبد من دون الله لا ينصر اليوم من عبده، وما للعابدين دون الله لا ينصرون اليوم الههم الذي يعبد من دون الله؟ فقال الله: {بل هم اليوم مستسلمون} [الصافات: ] وقرا قول الله: {فان كان لكم كيد فكيدون} [المرسلات: ] "
 
  قوله تعالي {ومن يظلم منكم نذقه عذابا كبيرا} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قال: " كل شء نسبه الي غير الاسلام من اسم مثل مسرف وظالم ومجرم وفاسق وخاسر فانما يعني به الكفر، وما نسبه الي الاسلام فانما يعني به الذنب قال: {ومن يظلم منكم نذقه عذابا كبيرا} [الفرقان: ] يقول: ومن يكفر منكم قال: {واعتدنا للظالمين} [الفرقان: ] يقول للكافرين "
 
    
 اخبرنا محمد بن حماد الطهراني، فيما كتب الي انبا اسماعيل بن عبد الكريم، حدثني عبد الصمد، انه سمع وهبا، يقول: " قرات اثنين وسبعين كتابا نزلت من السماء ما سمعت كتابا اكثر تكريرا فيه الظلم ومعاتبة عليه من القران؛ وذلك لان الله علم ان فتنة هذه الامة تكون في الظلم، واما الاخرون من الامم فانه اكثر معاتبة اياهم في الشرك وعبادة الاوثان وانه ذكر معاتبة هذه الامة بالظلم فقال: {ومن يظلم منكم نذقه عذابا كبيرا} [الفرقان: ] و {ان لعنة الله علي الظالمين} [الاعراف: ] . ونزع باشباه هذا من القران "
 
  قوله تعالي {وما ارسلنا قبلك من المرسلين} 
 [الفرقان: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {وما ارسلنا قبلك من المرسلين الا انهم لياكلون الطعام ويمشون في الاسواق} [الفرقان: ] اي: ان الرسل قبل محمد صلي الله عليه وسلم كانوا بهذه المنزلة ياكلون الطعام ويمشون في الاسواق "
 
  قوله تعالي {وجعلنا بعضكم لبعض فتنة} 
 [الفرقان: ]
 
    
 حدثنا يونس بن عبد الاعلي، ثنا عبد الله بن وهب، اخبرني مخرمة، عن ابيه، عن عبيد الله بن رفاعة، عن ابي رافع الزرقي، قال: قال رجل: يا رسول الله، كيف تري رقيقنا، قوم مسلمون يصلون صلاتنا، ويصومون صيامنا، نضربهم؟ فقال رسول الله صلي الله عليه وسلم: «توزن ذنوبهم وعقوبتكم اياهم فان كان عقوبتكم اكثر من ذنوبهم اخذوا منكم» ، قالوا: افرايت سبنا اياهم؟ قال: توزن ذنوبهم واذاكم اياهم فان كان اذاكم اياهم اكثر اعطوا منكم "، قال الرجل: ما اسمع عدوا اعرب الي منهم فتلا رسول الله صلي الله عليه وسلم هذه الاية: {وجعلنا بعضكم لبعض فتنة اتصبرون وكان ربك بصيرا} [الفرقان: ] قال الرجل: ارايت يا رسول الله ولدي اضربهم؟ قال: انك لا تتهم في ولدك ولا تطيب نفسك تشبع ويجوعوا، ولا تكتسي ويعروا "
 
  الوجه الثاني
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن علية، عن ابي رجاء، حدثني عبد القدوس، عن الحسن، " {وجعلنا بعضكم لبعض فتنة اتصبرون وكان ربك بصيرا} [الفرقان: ] قال: يقول هذا الفقير: لو شاء الله جعلني غنيا مثل فلان، ويقول هذا السقيم: لو شاء الله جعلني صحيحا مثل فلان "
 
    
 حدثنا علي بن الحسن، ثنا جعفر بن مسافر، ثنا يحيي بن حسان، ثنا رشيد بن سعد، عن الحسن بن ثوبان، عن عكرمة، في قوله: " {وجعلنا بعضكم لبعض فتنة اتصبرون} [الفرقان: ] قال: هو التفاضل في الدنيا والقدرة وقهر بعضكم لبعض فهي الفتنة التي قال الله: {وكان ربك بصيرا} [الفرقان: ] "
 
    
 حدثنا علي بن الحسين، ثنا ابن ابي حماد، ثنا الحكم بن بشير، عن عمرو بن قيس، في قوله: " {وجعلنا بعضكم لبعض فتنة} [الفرقان: ] ان يحسن المليك الي مملوكه "
 
  قوله تعالي {اتصبرون} 
 [الفرقان: ]
 
    
 حدثنا محمد بن العباس، ثنا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، " {وجعلنا بعضكم لبعض فتنة اتصبرون وكان ربك بصيرا} [الفرقان: ] اي: جعلت بعضكم لبعض بلاء لتصبروا علي ما تسمعون منهم وترون من خلافهم، وتتبعوا الهدي بغير ان اعطيهم عليه الدنيا ولو شءت ان اجعل الدنيا مع رسلي فلا يخالفون لفعلت ولكني قد اردت ان ابتلي العباد بكم وابتليكم بهم "
 
  قوله تعالي {وكان ربك بصيرا} 
 [الفرقان: ]
 
    
 حدثنا علي بن الحسين، ثنا المقدمي، ثنا عون بن معمر، عن ابراهيم الصاءغ، عن عبد الله بن عبيد بن عمير، في قوله: " {وجعلنا بعضكم لبعض فتنة اتصبرون وكان ربك بصيرا} [الفرقان: ] قال: يعني: الناس عامة "
 
  قوله تعالي {وقال الذين لا يرجون لقاءنا} 
 [الفرقان: ]
 
    
 ذكر عن محمد بن مرزوق، ثنا عبيد بن عقيل، ثنا جرير بن حازم، عن عبد الله بن عبيد بن عمير، في قوله: " {وقال الذين لا يرجون لقاءنا} [سورة: الفرقان، اية رقم: ] قال: لا يبالون. وانشدني جرير بن حازم قول خبيب:
 [البحر الطويل]
 لعمرك ما ارجو اذا كنت مسلما ... علي اي حال كان في الله مصرعي
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {لولا انزل علينا الملاءكة} [الفرقان: ] اي: فنراهم عيانا او نري ربنا "
 
  قوله تعالي {لقد استكبروا في انفسهم وعتوا عتوا كبيرا}
 
    
 حدثنا حجاج بن حمزة، ثنا علي بن الحسن بن شقيق، انبا الحسين بن واقد، ثنا يزيد النحوي، عن عكرمة، قال: «العتو في كتاب الله التجبر»
 
  قوله تعالي {يوم يرون الملاءكة} 
 [الفرقان: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {يوم يرون الملاءكة} [الفرقان: ] قال: يوم القيامة "
 
  قوله تعالي {لا بشري يومءذ للمجرمين} 
 [الفرقان: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن ادريس، عن ابيه، عن عطية: قوله: " {لا بشري يومءذ للمجرمين} [الفرقان: ] قال: اذا كان يوم القيامة تلقي المءمن بالبشري فاذا راي ذلك الكفار قالوا للملاءكة: بشرونا، قالوا: حجرا محجورا قال: «حراما محرما ان نتلقاكم بالبشري»
 
    
 حدثنا ابي، ثنا ابن ابي عمر العدني، ثنا سفيان، عن فطر، عن مجاهد، " {لا بشري يومءذ للمجرمين ويقولون حجرا محجورا} [الفرقان: ] قال: تقول الملاءكة: حراما محرما ان تكون البشري اليوم الا للمءمنين "
 
  قوله تعالي {ويقولون حجرا محجورا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابو نعيم، ثنا موسي بن قيس، عن عطية العوفي، عن ابي سعيد الخدري، " {ويقولون حجرا محجورا} [الفرقان: ] قال: حراما محرما ان نبشركم بما نبشر به المتقين "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن ادريس، عن ابيه، عن عطية، " {ويقولون حجرا محجورا} [الفرقان: ] قال: حراما محرما "
 
    
 حدثنا ابو سعيد الاشج، ثنا محمد بن عبيد، عن جويبر، عن الضحاك: " {ويقولون حجرا محجورا} [الفرقان: ] قال: تقول لهم الملاءكة حراما ان تكون لكم البشري "
 
    
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ، عن عبيد، عن الضحاك: قوله: " {لا بشري يومءذ للمجرمين ويقولون حجرا محجورا} [الفرقان: ] لما جاءت زلازل الساعة فكان من زلازلها ان السماء انشقت {فهي يومءذ واهية والملك علي ارجاءها} [الحاقة: ] علي شقة كل شء يشقق من السماء فذلك قوله: {يوم يرون الملاءكة لا بشري يومءذ للمجرمين} [الفرقان: ] حراما محرما ايها المجرمون ان تكون لكم البشري اليوم حيث رايتمونا " وروي عن مجاهد والحسن وعطاء الخراساني وخصيف انه حراما محرما
 
    
 حدثني ابو عبد الله الطهراني، انبا حفص بن عمر العدني، ثنا الحكم بن ابان، عن عكرمة، في قوله: " {ويقولون حجرا محجورا} [الفرقان: ] قال: يقولون يوم القيامة انا لا نصل الي شء من الخير "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {حجرا محجورا} [الفرقان: ] عوذا معاذ الله، الملاءكة تقوله "
 
    
 اخبرنا الطهراني، فيما كتب الي، انبا عبد الرزاق، انبا معمر، عن الحسن، وقتادة، في قوله: " {حجرا محجورا} [الفرقان: ] قال: هي كلمة كانت العرب تقولها كان الرجل اذا نزلت به شديدة قال: حجرا محجورا، يقول: حراما محرما "
 
  قوله تعالي {وقدمنا} 
 [الفرقان: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {وقدمنا} [الفرقان: ] عمدنا " وروي عن السدي، وسفيان الثوري، مثل ذلك
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسن بن علي بن مهران، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: قوله: " {وقدمنا الي ما عملوا من عمل} [الفرقان: ] يقول: عمدنا، وبعضهم يقول: اتينا عليه "
 
  قوله تعالي {وقدمنا الي ما عملوا من عمل} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا عبيد الله بن موسي، انبا سفيان، عن عيسي، عن قيس بن سعد، عن مجاهد: قوله: " {وقدمنا الي ما عملوا من عمل} [الفرقان: ] قال: قدمنا الي ما عملوا من خير لا يتقبل منهم "
 
    
 حدثنا ابي، ثنا هشام بن عبيد الله الرازي، قال: سمعت ابن المبارك، يقول في قوله: " {وقدمنا الي ما عملوا من عمل فجعلناه هباء منثورا} [الفرقان: ] قال: كل عمل صالح لا يراد به وجه الله "
 
  قوله تعالي {فجعلناه هباء منثورا} 
 [الفرقان: ]
 
    
 حدثني ابي، ثنا قبيصة، عن سفيان، عن ابي اسحاق، عن الحارث، عن علي، رضي الله عنه {هباء منثورا} [الفرقان: ] قال: ينثر من الكوة: و {هباء منبثا} [الواقعة: ] قال: رهج الدواب "
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا مسدد، ثنا ابو الاحوص، ثنا ابو اسحاق، عن الحارث، عن علي، في قوله: " {هباء منثورا} [الفرقان: ] قال: «الهباء رهج الدواب» وروي عن ابن عباس في بعض الروايات وعبد الرحمن بن زيد بن اسلم والضحاك نحو ذلك
 
  والوجه الثاني
 
    
 حدثنا علي بن الحسن، ثنا مسدد، ثنا محمد بن جابر، عن ابي اسحاق، عن سعيد بن جبير، عن عقيل الجزري، عن علي رضي الله عنه في قوله: " {هباء منثورا} [الفرقان: ] قال: شعاع الشمس اذا دخل في الكوة " وروي عن ابن عباس في بعض الروايات، ومجاهد، وابي مالك، وعكرمة، وسعيد بن جبير، والضحاك في احدي الروايات نحو ذلك
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن علية، عن ابي رجاء، عن الحسن، " {وقدمنا الي ما عملوا من عمل فجعلناه هباء منثورا} [الفرقان: ] قال: الشعاع في كوة احدكم لو ذهب يقبض عليه لم يستطع "
 
  والوجه الثالث
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {هباء منثورا} [الفرقان: ] يقول: الماء المهراق "
 
  والوجه الرابع
 
    
 حدثنا ابي، ثنا نصر بن علي، اخبرني ابي، عن خالد بن قيس، عن قتادة، في قوله: " {هباء منثورا} [الفرقان: ] قال: اما رايت يبس الشجر اذا ذرته الريح فهو ذلك، يعني الورق "
 
  والوجه الخامس
 
    
 ذكر عن ابن وهب، اخبرني عاصم بن حكيم، عن ابي سريع الطاءي، عن عبيد بن تعلي، قال: «وان الهباء الرماد»
 
  قوله تعالي {اصحاب الجنة} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا عبد الله بن صالح بن مسلم، انبا فضيل بن مرزوق، عن عطية العوفي، عن ابي سعيد الخدري، قال: قال رسول الله صلي الله عليه وسلم ان «اول زمرة تدخل الجنة يوم القيامة وجوههم علي مثل صورة القمر ليلة البدر، والزمرة الثانية علي لون احسن كوكب دري في السماء»
 
  قوله تعالي {يومءذ} 
 [ال عمران: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير: قوله: " {يومءذ} [الفرقان: ] يعني: يوم القيامة "
 
  قوله تعالي {خير مستقرا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا عبيد الله بن حمزة بن اسماعيل، قال: سمعت ابي حمزة بن اسماعيل، حدثني يحيي بن الضريس، ثنا ابو سنان، في قوله: " {خير مستقرا} [الفرقان: ] قال: المستقر الجنة والمقيل دونهما "
 
  قوله تعالي {واحسن مقيلا} 
 [الفرقان: ]
 
    
 حدثنا اسيد بن عاصم، ثنا الحسين بن حفص، ثنا سفيان، عن ميسرة، عن المنهال، عن ابي عبيدة، عن ابن مسعود، في قول الله: " {اصحاب الجنة يومءذ خير مستقرا واحسن مقيلا} [الفرقان: ] قال: لا ينتصف النهار حتي يقيل هءلاء وهءلاء ثم قرا: {اصحاب الجنة يومءذ خير مستقرا واحسن مقيلا} [الفرقان: ] ثم ان مقيلهم لالي الجحيم "
 
    
 حدثنا ابي، ثنا عيسي بن يونس الرملي، ثنا رواد بن الجراح، عن نهشل، عن الضحاك، عن ابن عباس، في قول الله: " {اصحاب الجنة يومءذ خير مستقرا واحسن مقيلا} [الفرقان: ] قال: انما هي ضحوة فيقيل اولياء الله علي الاسرة مع الحور العين، ويقيل اعداء الله مع الشياطين المقرنين "
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني ابن لهيعة، حدثني عطاء، عن سعيد بن جبير، في قول الله: " {اصحاب الجنة يومءذ خير مستقرا واحسن مقيلا} [الفرقان: ] قال: يفرغ الله من حساب الناس نصف النهار فيقيل اهل الجنة في الجنة واهل النار في النار فيقول الله يومءذ {اصحاب الجنة يومءذ خير مستقرا واحسن مقيلا} [الفرقان: ] "
 
    
 حدثنا ابي، ثنا سعيد بن سليمان، ثنا عبد الله بن ميسرة، ثنا رجل، قد سماه قال عكرمة: " اني لاعرف الساعة التي يدخل فيها اهل الجنة الجنة واهل النار النار، الساعة التي تكون في الدنيا ارتفاع الضحي الاكبر اذا انقلب الناس الي اهليهم للقيلولة، فينصرف اهل النار الي النار، واما اهل الجنة، فينطلق بهم الي الجنة، فكانت قيلولتهم في الجنة، واطعموا كبد حوت فاشبعهم ذلك كلهم فذلك قوله: {اصحاب الجنة يومءذ خير مستقرا واحسن مقيلا} [الفرقان: ] "
 
    
 اخبرنا محمد بن سعد العوفي، فيما كتب الي حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، في قوله: " {اصحاب الجنة يومءذ خير مستقرا واحسن مقيلا} [الفرقان: ] قالوا: في الغرف من الجنة وكان حسابهم ان عرضوا علي ربهم عرضة واحدة وذلك الحساب اليسير وهو مثل قوله: {فاما من اوتي كتابه بيمينه فسوف يحاسب حسابا يسيرا وينقلب الي اهله مسرورا} [الانشقاق: ] "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {اصحاب الجنة يومءذ خير مستقرا واحسن مقيلا} [الفرقان: ] اي: ماوا ومنزلا "
 
    
 قال قتادة، حدث صفوان بن محرز، انه قال: " يجء يوم القيامة برجلين كان احدهما ملكا في الدنيا الي الحمرة والبياض فيحاسب، فاذا عبد لم يعمل خيرا فيءمر به الي النار، والاخر صاحب كساء في الدنيا فيحاسب فيقول: يا رب ما اعطيتني من شء فتحاسبني به فيقول: صدق عبدي فارسلوه فيءمر به الي الجنة، ثم يتركان ما شاء الله ثم يدعي صاحب النار فاذا هو مثل الحممة السوداء، فيقال له: كيف وجدت؟ فيقول: شر مقيل فيقال له: عد، ثم يدعي بصاحب الجنة فاذا هو مثل القمر ليلة البدر فيقال له: كيف وجدت؟ فيقول رب: خير مقيل، فيقال له: عد "
 
  قوله تعالي {ويوم تشقق السماء} 
 [الفرقان: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {يوم} [الفرقان: ] قال: يوم القيامة "
 
    
 حدثنا ابو زرعة، ثنا عبد الله بن محمد بن ابي شيبة، ثنا مروان بن معاوية، عن جويبر، عن الضحاك، " {ويوم تشقق السماء بالغمام} [الفرقان: ] قال: هو قطع السماء اذا تشققت "
 
  قوله تعالي {بالغمام} 
 [الفرقان: ]
 
    
 حدثنا الحسين بن الحسن، ثنا ابراهيم بن عبد الله بن حاتم الهروي، انبا الحجاج، عن ابن جريج، عن مجاهد، " {السماء بالغمام} [الفرقان: ] قال: هو الذي في ظلل من الغمام ياتي الله فيه يوم القيامة ولم يكن قط الا لبني اسراءيل "
 
  قوله تعالي {ونزل الملاءكة تنزيلا} 
 [الفرقان: ]
 
    
 حدثنا محمد بن عمار بن الحارث، ثنا مءمل، ثنا حماد بن سلمة، عن علي بن زيد، عن يوسف بن مهران، عن ابن عباس، انه قرا هذه الاية: {ويوم تشقق السماء بالغمام ونزل الملاءكة تنزيلا} [الفرقان: ] قال ابن عباس: «يجمع الله الخلق يوم القيامة في صعيد واحد الجن والانس والبهاءم والسباع والطير وجميع الخلق وتنشق السماء الدنيا فينزل اهلها وهم اكثر من الجن والانس ومن جميع الخلق فيحيطون بالجن والانس وبجميع الخلق ثم تنشق السماء الثانية فينزل اهلها وهم اكثر من اهل السماء الدنيا ومن الجن والانس ومن جميع الخلق فيحيطون بالملاءكة الذين نزلوا قبلهم والجن والانس وجميع الخلق، ثم تنشق السماء الثالثة فينزل اهلها وهم اكثر من اهل السماء الثانية والسماء الدنيا ومن جميع الخلق، فيحيطون بالملاءكة الذين نزلوا قبلهم وبالجن والانس وجميع الخلق، ثم كذلك كل سماء حتي تنشق السماء السابعة، وهم اكثر ممن نزل قبلهم من اهل السموات ومن الجن والانس ومن جميع الخلق، فيحيطون بالملاءكة الذين نزلوا قبلهم وبالجن والانس وجميع الخلق، وربنا عز وجل في ظلل من الغمام وحوله الكروبيون وهم اكثر من اهل السموات السبع والجن والانس وجميع الخلق لهم قرون كاكعب القنا، وهم تحت العرش لهم زجل بالتسبيح والتهليل والتقديس لله عز وجل
  [ص: ]
 ما بين اخمص قدم احدهم الي كعبه مسيرة خمسماءة عام، وما بين كعبه الي ركبتيه مسيرة خمسماءة عام، وما بين ركبتيه الي ارنبته مسيرة خمسماءة عام، وما بين ارنبته الي ترقوته مسيرة خمسماءة عام، وما بين ترقوته الي موضع القرط مسيرة خمسماءة عام، وما فوق ذلك مسيرة خمسماءة عام وجهنم مجنبته»
 
  قوله تعالي {الملك يومءذ الحق للرحمن} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا عبد الله بن محمد بن ابي شيبة، ثنا ابو اسامة، عن عمر بن حمزة، عن سالم بن عبد الله، اخبرني عبد الله بن عمر، قال: قال رسول الله صلي الله عليه وسلم: " يطوي الله السموات يوم القيامة، ثم يطوي الارضين، ثم يقول: انا الملك اين الجبارون؟ اين المتكبرون؟ "
 
  قوله تعالي {للرحمن} 
 [مريم: ]
 
    
 حدثنا علي بن طاهر، ثنا محمد بن العلاء ابو كريب، ثنا عثمان بن سعيد الزيات، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: " {للرحمن} [الفرقان: ] الفعلان من الرحمة وهو من كلام العرب الرحمن "
 
    
 حدثنا ابي، ثنا محمد بن عبد الرحمن العرزمي، ثنا ابي، عن جويبر، عن الضحاك، في قوله: " {للرحمن} [مريم: ] قال: الرحمن بجميع خلقه "
 
  قوله تعالي {وكان يوما علي الكافرين عسيرا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا سعيد بن اسحاق، ثنا سعيد، عن قتادة: " قال الله عز وجل: {يوما علي الكافرين عسيرا} [الفرقان: ] ، فبين الله علي من يقع فقال: {علي الكافرين} [الفرقان: ] "
 
  قوله تعالي {ويوم يعض الظالم علي يديه} 
 [الفرقان: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {ويوم يعض الظالم علي يديه} [الفرقان: ] عقبة بن ابي معيط دعا مجلسا فيهم النبي صلي الله عليه وسلم لطعام فابي النبي صلي الله عليه وسلم ان ياكل وقال
  [ص: ]
 : لا اكل حتي تشهد ان لا اله الا الله وان محمدا رسول الله فلقيه امية بن خلف فقال: اقد صبوت؟ قال: اني اخوك علي ما تعلم ولكن صنعت طعاما فابي ان ياكل حتي اقول ذلك فقلته وليس من نفسي "
 
    
 حدثنا ابي، ثنا محمد بن المصفي، ثنا معاوية بن حفص، عن هشيم، عن ابي بلج، عن عمرو بن ميمون، في قوله: {ويوم يعض الظالم علي يديه} [الفرقان: ] قال: نزلت في عقبة بن ابي معيط وابي بن خلف قال: دخل النبي صلي الله عليه وسلم علي عقبة في حاجة وقد صنع طعاما للناس قال: فدعا النبي صلي الله عليه وسلم الي طعامه فقال: " قد علمت اني لا اكل طعامك ولست علي ديني، قال: لا، حتي تسلم قال: فاسلم وجلس النبي صلي الله عليه وسلم فاكل وبلغ الخبر ابي بن خلف فاتي عقبة فذكر له ما صنع، فقال له عقبة: اتري مثل محمد يدخل منزلي وفيه طعام ثم يخرج ولا ياكل؟ قال ابي: فوجهي من وجهك حرام حتي ترجع اليه وتتفل في وجهه وترجع عما دخلت فيه، قال: فجاء ففعل ذلك، ونزل القران: {ويوم يعض الظالم علي يديه} [الفرقان: ] قال: عقبة
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: {ويوم يعض الظالم علي يديه} [الفرقان: ] ذكر لنا ان عقبة بن ابي معيط كان يغشي نبي الله صلي الله عليه وسلم فلقيه امية بن خلف وكان له صديقا فلم يزل به حتي صرفه وصده عن غشيان النبي صلي الله عليه وسلم فانزل الله عز وجل فيهما: {ويوم يعض الظالم علي يديه} [الفرقان: ] "
 
    
 اخبرنا محمد بن سعد العوفي، فيما كتب الي حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، عن ابن عباس: قوله: " {ويوم يعض الظالم علي يديه} [الفرقان: ] قال: هو ابي بن خلف وكان يحضر النبي صلي الله عليه وسلم فزجره عقبة بن ابي معيط "
 
    
 حدثنا محمد بن يحيي، قال: وجدت في كتاب جدي يحيي بن الضريس قال: قال سفيان: في قوله: " {ويوم يعض الظالم علي يديه} [الفرقان: ] قال: ياكل يده ثم تنبت "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد النرسي، ثنا ابو فاطمة مسكين قال: سمعت هشاما، قال: في قول الله عز وجل: " {ويوم يعض الظالم علي يديه} [الفرقان: ] قال: ياكل كفه ندامة حتي يبلغ منكبه لا يجد مسها "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن نمير، ثنا سفيان، عن ابي السوداء النهدي، ثنا ابن سابط، قال: صنع ابي بن خلف طعاما ثم اتي مجلسا فيه النبي صلي الله عليه وسلم قال: قوموا فقاموا غير النبي صلي الله عليه وسلم فقال له: قم، قال: «لا حتي تشهد ان لا اله الا الله واني رسول الله» ، فشهد فقام النبي صلي الله عليه وسلم، فلقيه عقبة بن ابي معيط فقال: فعلت كذا وكذا، قال: انما اردت لطعامنا، فذلك قوله: {ويوم يعض الظالم علي يديه يقول يا ليتني اتخذت مع الرسول سبيلا} [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا الفيض بن وثيق الثقفي، ثنا جعفر بن سليمان، قال: سمعت ابا عمران الجوني، " {ويوم يعض الظالم علي يديه} [الفرقان: ] قال: بلغني انه يعضه حتي يكسر العظم ثم يعود "
 
    
 حدثنا ابي، ثنا محمد بن المصفي، ثنا معاوية بن حفص، عن هشيم، عن ابي بلج، عن عمرو بن ميمون، في قوله: " {يقول يا ليتني اتخذت مع الرسول سبيلا} [الفرقان: ] عقبة بن ابي معيط "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر، ثنا اسباط، عن السدي، " {ويوم يعض الظالم علي يديه يقول يا ليتني اتخذت مع الرسول سبيلا} [الفرقان: ] قال: " نزلت في عقبة بن ابي معيط، كان قد غشي مجلس النبي صلي الله عليه وسلم وهم ان يسلم فلقيه امية بن خلف، فقال: يا عقبة بلغني انك قد صبوت فتبعت محمدا، فقال: فعلت، قال: فوجهي من وجهك حرام حتي تاتيه فتتفل في وجهه وتتبرا منه فيعلم قومك انك عدو لمن عاداهم، وفرق عليهم جماعتهم، فاطاعه فاتي النبي صلي الله عليه وسلم فتفل في وجهه وتبرا، فاشتد ذلك علي النبي صلي الله عليه وسلم، فانزل الله عز وجل فيه يخبر بما هو صاءر اليه من الندامة وتبرءه من خليله امية بن خلف فقال: {ويوم يعض الظالم علي يديه يقول يا ليتني اتخذت مع الرسول سبيلا} [الفرقان: ] والسبيل: الطاعة
 
  قوله تعالي {سبيلا} 
 [ال عمران: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {يا ليتني اتخذت مع الرسول سبيلا} [الفرقان: ] اي: بطاعة الله " وروي عن السدي مثل ذلك
 
  قوله تعالي {يا ويلتا ليتني لم اتخذ فلانا خليلا}
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن نمير، ثنا سفيان، عن ابي السوداء النهدي، حدثني ابن سابط، « {يا ويلتا ليتني لم اتخذ فلانا خليلا} يعني ابي بن خلف» وروي عن عمرو بن ميمون نحو ذلك
 
  والوجه الثاني
 
    
 حدثنا محمد بن عمار، ثنا سهل بن بكار، ثنا هشيم، انبا علي بن زيد، عن سعيد بن المسيب، قال: " نزلت في امية بن خلف وعقبة بن ابي معيط: {ويوم يعض الظالم علي يديه يقول يا ليتني اتخذت مع الرسول سبيلا} [الفرقان: ] قال: هذا عقبة: {يا ليتني اتخذت مع الرسول سبيلا يا ويلتا ليتني لم اتخذ فلانا خليلا} قال: امية وكان عقبة خدنا لامية، فبلغ امية ان عقبة يريد الاسلام فقال: وجهي من وجهك حرام ان اسلمت ان اكلمك ابدا "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي، " {يا ويلتا ليتني لم اتخذ فلانا خليلا} وفلان: امية بن خلف "
 
  الوجه الثالث
 
    
 حدثنا ابو زرعة، ثنا مسدد، ثنا خالد بن عبد الله، ثنا حصين بن عبد الرحمن، عن ابي مالك الغفاري، في قوله: " {يا ويلتا ليتني لم اتخذ فلانا خليلا} قال: كان امية بن خلف وعقبة بن ابي معيط مءاخيين في الجاهلية، فيقول امية بن خلف: يا ليتني لم اتخذ عقبة بن ابي معيط خليلا "
 
  والوجه الرابع
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {يا ويلتا ليتني لم اتخذ فلانا خليلا} قال: الشيطان "
 
    
 حدثنا ابي، ثنا مسلم بن ابراهيم، ثنا ابو عقيل الدورقي، عن ابي رجاء في قوله: " {يا ويلتا ليتني لم اتخذ فلانا خليلا} قال: خليله الشيطان "
 
  قوله تعالي {لقد اضلني عن الذكر بعد اذ جاءني} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا محمد بن المصفي، ثنا معاوية بن حفص، عن هشيم، عن ابن بلج، عن عمرو بن ميمون، في قوله: " {لقد اضلني عن الذكر بعد اذ جاءني} [الفرقان: ] يعني: الاسلام "
 
  قوله تعالي {وكان الشيطان} 
 [الاسراء: ]
 
    
 حدثنا ابي، ثنا النفيلي، ثنا محمد بن سلمة، عن خصيف: " {الشيطان} [الفرقان: ] ابليس "
 
  قوله تعالي {للانسان} 
 [يوسف: ]
 
    
 حدثنا محمد بن عبد الله بن يزيد المقرء، ثنا سفيان، عن ابراهيم بن نافع، عن قيس بن سعد، عن سعيد بن جبير، عن ابن عباس، قال: «خلق الله ادم في اخر ساعات النهار من يوم الجمعة ثم عهد اليه فنسي فسمي الانسان»
 
  قوله تعالي {خذولا} 
 [الفرقان: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد النرسي، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {وكان الشيطان للانسان خذولا} [الفرقان: ] خذله يوم القيامة وتبرا منه "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي، " {لقد اضلني عن الذكر، بعد اذ جاءني وكان الشيطان للانسان خذولا} [الفرقان: ] فقتلا يوم بدر جميعا "
 
  قوله تعالي {وقال الرسول يا رب} 
 [الفرقان: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد النرسي، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {وقال الرسول يا رب ان قومي اتخذوا هذا القران مهجورا} [الفرقان: ] فهذا قول نبيكم يشتكي قومه الي ربه "
 
  قوله تعالي {ان قومي اتخذوا هذا القران مهجورا} 
 [الفرقان: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، " {اتخذوا هذا القران مهجورا} [الفرقان: ] يهجرون فيه بالقول يقولون: هو سحر "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو نعيم، عن سفيان، عن مغيرة، عن ابراهيم، " {اتخذوا هذا القران مهجورا} [الفرقان: ] قالوا فيه: هجرا "
 
    
 حدثنا ابي، ثنا عمرو بن رافع، ثنا هشيم، عن مغيرة، عن ابراهيم، في قوله: " {اتخذوا هذا القران مهجورا} [الفرقان: ] قال: قالوا فيه غير الحق، الم تر الي المريض اذا هزي قيل: هجر، اي: قال ما لا علم له به "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي انبا اصبغ، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {يا رب ان قومي اتخذوا هذا القران مهجورا} [الفرقان: ] لا يريدون ان يستمعوه "
 
  قوله تعالي {وكذلك جعلنا لكل نبي عدوا} 
 [الانعام: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد النرسي، ثنا يزيد بن زريع، عن سعيد، عن قتادة: " قال الله عز وجل يعزي نبيه: {وكذلك جعلنا لكل نبي عدوا من المجرمين} [الفرقان: ] الاية اي: ان الرسل قد لقيت هذا من قومها قبلك فلا يكبرن عليك "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: قوله: " {وكذلك جعلنا لكل نبي عدوا من المجرمين} [الفرقان: ] قال: لم يبعث نبي قط الا كان بعض المجرمين له اعداء ولم يبعث نبي قط الا كان بعض المجرمين اشد عليه من بعض "
 
  قوله تعالي {من المجرمين} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {من المجرمين} [الفرقان: ] قال: الكفار "
 
    
 حدثنا عبد الله بن سليمان بن الاشعث، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: قوله: " {عدوا من المجرمين} [الفرقان: ] فكان عدوا للنبي صلي الله عليه وسلم من قريش بنو امية وبنو المغيرة "
 
  قوله تعالي {وكفي بربك هاديا ونصيرا} 
 [الفرقان: ]
 
    
 حدثنا محمد بن العباس، ثنا زنيج، ثنا سلمة، قال محمد بن اسحاق يعني: " {ونصيرا} [الفرقان: ] اي: ان ينصرك الله فلا يضرك خذلان من خذلك "
 
  قوله تعالي {وقال الذين كفروا لولا نزل عليه القران جملة واحدة} 
 [الفرقان: ]
 
    
 حدثنا ابو بكر احمد بن القاسم بن عطية، ثنا احمد بن عبد الرحمن بن عبد الله بن سعد الدشتكي، حدثنا ابي، حدثني الاشعث، عن جعفر بن ابي المغيرة، عن سعيد بن جبير، عن ابن عباس، قال: " قال المشركون: ان كان محمد كما يزعم نبيا فلم يعذبه ربه؟ الا ينزل عليه القران جملة واحدة؟ ينزل عليه الاية والايتين والسورة؟ فانزل الله علي نبيه جواب ما قالوا: {وقال الذين كفروا لولا نزل عليه القران جملة واحدة} [الفرقان: ] الي اخر الاية "
 
    
 ذكر عن عبد الرحمن بن عمر بن رسته الاصبهاني، ثنا ابن مهدي، ثنا ابو سلمة، عن حكيم بن جبير، عن سعيد بن جبير، قلت لابن عباس: اخبرني عن قول الله عز وجل: {انا انزلناه في ليلة القدر} [القدر: ] : و {انا انزلناه في ليلة مباركة} [الدخان: ] ، وعن {شهر رمضان الذي انزل فيه القران} [البقرة: ] اكله ام بعضه؟ فقال ابن عباس: " انزل الله القران جملة واحدة من السماء السابعة الي سماء الدنيا في ليلة القدر فجعل عند مواقع النجوم: {فلا اقسم بمواقع النجوم} [الواقعة: ] الي قوله: {المطهرون} [الواقعة: ] الملاءكة، وينزل به جبريل عليه السلام، كلما اتي بمثل يلتمس عيبه، نزل به كتاب الله ناطقا، فقالت اليهود: يا ابا القاسم لولا انزل هذا القران جملة واحدة كما انزلت التوراة علي موسي فانزل الله: {كذلك لنثبت به فءادك ورتلناه ترتيلا، ولا ياتونك بمثل الا جءناك بالحق واحسن تفسيرا} [الفرقان: ] وقرا: {وقرانا فرقناه لتقراه علي الناس علي مكث} [الاسراء: ] "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، " {وقال الذين كفروا لولا نزل عليه القران جملة واحدة} [الفرقان: ] كما انزل علي موسي وكما انزل علي عيسي عليهم السلام "
 
    
 حدثنا احمد بن سنان، ثنا ابو يحيي الحماني، ثنا الاعمش، عن حسان ابي الاشرس، عن سعيد بن جبير، عن ابن عباس، قال: «انزل الله القران ليلة القدر فجعل في بيت العزة»
 
  قوله تعالي {لولا نزل عليه القران جملة واحدة} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر بن عمارة، ثنا ابو روق، عن الضحاك، عن ابن عباس، " {وقال الذين كفروا لولا نزل عليه القران جملة واحدة} [الفرقان: ] قال: يقولون: هلا انزل عليه القران جملة واحدة "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر، ثنا اسباط، عن السدي، " {وقال الذين كفروا لولا نزل عليه القران جملة واحدة} [الفرقان: ] قال: هلا جاء به كما جاء به موسي صلي الله عليهما "
 
  قوله تعالي {كذلك لنثبت به فءادك} 
 [الفرقان: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن العلاء، ثنا عثمان بن سعيد، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، " {لنثبت به فءادك} [الفرقان: ] يا محمد يقول: لنشدد به فءادك ونربط علي قلبك يعني: بوحيه الذي نزل به جبريل عليك من عند الله وكذلك يفعل بالمرسلين من قبلك "
 
  قوله تعالي {ورتلناه ترتيلا} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، " قال الله عز وجل: {كذلك لنثبت به فءادك} [الفرقان: ] ، يا محمد {ورتلناه ترتيلا} [الفرقان: ] يقول: ورسلناه ترسيلا يقول: شيءا بعد شء "
 
    
 اخبرنا ابو عبد الله الطهراني، فيما كتب الي انبا عبد الرزاق، انبا معمر، عن الحسن، في قوله: " {ورتلناه ترتيلا} [الفرقان: ] قال: كان ينزل الاية والايتين والايات، كان ينزل جوابا لهم اذا سالوا رسول الله صلي الله عليه وسلم عن شء انزل الله جوابا لهم وردا عن النبي صلي الله عليه وسلم فيما تكلموا به وكان من اوله واخره نحو من عشرين سنة "
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا مسدد، عن هشيم، عن مغيرة، عن ابراهيم، في قوله: " {ورتلناه ترتيلا} [الفرقان: ] قال: نزل متفرقا "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي، " {ورتلناه ترتيلا} [الفرقان: ] يقول: فصلناه تفصيلا "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد النرسي، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {ورتلناه ترتيلا} [الفرقان: ] اي: بيناه تبيينا "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي انبا اصبغ، قال: سمعت عبد الرحمن بن زيد، عن اسلم: قوله: " {ورتلناه ترتيلا} [الفرقان: ] قال: فسرناه تفسيرا "
 
  والوجه الثاني
 
    
 اخبرنا محمد بن سعد العوفي، فيما كتب الي حدثني ابي، حدثني عمي، عن ابيه، عن جده، عن ابن عباس: قوله: " {كذلك لنثبت به فءادك ورتلناه ترتيلا} [الفرقان: ] قال: كان الله جل وعز ينزل الاية عليه فاذا علمها نبي الله صلي الله عليه وسلم نزلت اية اخري؛ ليعلمه الكتاب عن ظهر قلبه ويثبت به فءاده "
 
  قوله تعالي {ولا ياتونك بمثل} 
 [الفرقان: ]
 
    
 ذكر عن عبد الرحمن بن عمر بن رسته، ثنا ابن مهدي، ثنا ابو سلمة، عن حكيم بن جبير، عن سعيد بن جبير: قوله: {ولا ياتونك بمثل الا جءناك} [الفرقان: ] قال ابن عباس: «اي ينزل به جبريل كلما اتي بمثل يلتمس عيبه نزل به كتاب الله ناطقا»
 
  قوله تعالي {الا جءناك بالحق} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، " {ولا ياتونك بمثل الا جءناك بالحق} [الفرقان: ] يقول: لو انزلنا عليك القران جملة واحدة ثم سالوك لم يكن عندك ما تجيب ولكنا نمسك عليك فاذا سالوك اجبت "
 
  قوله تعالي {واحسن تفسيرا} 
 [الفرقان: ]
 
    
 اخبرنا العباس بن الوليد بن مزيد البيروتي، قراءة اخبرنا محمد بن شعيب بن شابور، اخبرني عثمان بن عطاء، عن ابيه، " واما {واحسن تفسيرا} [الفرقان: ] فاحسن تفصيلا " وروي عن ابن عباس، والضحاك، وقتادة مثل ذلك
 
    
 حدثنا الحسين بن الحسن، ثنا ابراهيم بن عبد الله الهروي، انبا الحجاج، عن ابن جريج، عن مجاهد، " {واحسن تفسيرا} [الفرقان: ] بيانا "
 
  قوله تعالي {الذين يحشرون علي وجوههم} 
 [الفرقان: ]
 
    
 حدثنا اسحاق بن ابراهيم البغوي، ثنا الحسين بن محمد، ثنا شيبان، عن قتادة، عن انس، ان رجلا قال: يا رسول الله كيف يحشر الكافر علي وجهه يوم القيامة؟ قال نبي الله صلي الله عليه وسلم: «ان الذي امشاه علي رجليه قادر ان يمشيه علي وجهه»
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا مسدد، ثنا حزم، قال: سمعت الحسن، يقول: {الذين يحشرون علي وجوههم الي جهنم} [الفرقان: ] قال: قيل يا نبي الله: كيف يمشون علي وجوههم؟ قال: «ارايت الذي امشاهم علي اقدامهم قادر ان يمشيهم علي وجوههم»
 
    
 حدثني ابي، ثنا عمرو بن علي، ثنا يحيي بن سعيد، ثنا الاشعث، عن الحسن، قال: " لما سير عامر بن عبد قيس الي الشام قال: الحمد لله الذي حشرني راكبا، قال الحسن: قد والله علم عامر ان قوما يحشرون علي وجوههم "
 
  قوله تعالي {اولءك شر مكانا} 
 [الماءدة: ]
 
    
 اخبرنا عبيد بن محمد بن يحيي بن حمزة الدمشقي، فيما كتب الي، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة، ذكر لنا ان رجلا قال: يا نبي الله كيف يحشر الكافر علي وجهه يوم القيامة؟ قال نبي الله صلي الله عليه وسلم: " اليس الذي امشاه علي رجليه قادر علي ان يمشيه علي وجهه، قال الله عز وجل: {اولءك شر مكانا واضل سبيلا} [الفرقان: ] "
 
  قوله تعالي {واضل سبيلا} 
 [الاسراء: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {واضل سبيلا} [الاسراء: ] يقول: وابعد حجة "
 
  قوله تعالي {ولقد اتينا موسي} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا ابن نفيل، ثنا عتاب، عن خصيف، عن زياد بن ابي مريم: قوله: " {اتينا} [الفرقان: ] قال: اعطينا "
 
    
 حدثنا ابي، ثنا عثمان بن ابي شيبة، ثنا جرير، عن الاعمش، عن مسلم، عن سعيد بن جبير، عن ابن عباس، قال: «اتي رسول الله صلي الله عليه وسلم سبعا من المثاني الطوال واتي موسي ستا من المثاني»
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {الكتاب} [البقرة: ] قال: التوراة وفي قوله: {وجعلنا معه اخاه هارون وزيرا} [الفرقان: ] اي: عونا وعضدا "
 
  قوله تعالي {فقلنا اذهبا الي القوم الذين كذبوا باياتنا} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، قال: " فاقبل موسي الي اهله فسار بهم نحو مصر حتي اتاها ليلا فتضيف علي امه وهو لا يعرفهم في ليلة كانوا ياكلون فيها الطفشيل فنزل في جانب الدار فجاء هارون فلما ابصر ضيفه سال عنه امه فاخبرته انه ضيف فدعاه فاكل معه فلما قعدا تحدثا فساله هارون من انت؟ قال انا موسي فقام كل واحد الي صاحبه، وذكر الحديث وقد كتب غير مرة وذكر ايضا حديث وهب بن منبه له
 
    
 حدثنا علي بن الحسين، ثنا الربيع بن ثعلب، ثنا ابو اسماعيل المءدب، عن عبد الله بن مسلم، عن عبد الله بن عبيد بن عمير، قال: «كان يغلق دون فرعون ثمانون بابا فما ياتي موسي بابا منها الا انفتح ولا يكلم احدا حتي يقوم بين يديه»
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {باياتنا} [الفرقان: ] بالبينات "
 
  قوله تعالي {فدمرناهم تدميرا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {فدمرناهم تدميرا} [الفرقان: ] يقول: اهلكناهم بالعذاب " وروي عن السدي نحو ذلك
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع، في قوله: " {فدمرناهم تدميرا} [الفرقان: ] يقول: تبرناهم تتبيرا، يقول: قطع الله انواع العذاب "
 
  قوله تعالي {وقوم نوح لما كذبوا الرسل اغرقناهم} 
 [الفرقان: ]
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا ابو زهير، عن رجل، من اصحابه قال: بلغني ان «قوم نوح عاشوا في ذلك الغرق اربعين يوما»
 
    
 حدثنا محمد بن العباس، ثنا ابن سلمة، ثنا سلمة، قال: حدثني محمد بن اسحاق، قال: «فلقد غرقت الارض وما فيها وانتهي الماء الي ما انتهي اليه وما جاوز الماء ركبته ودام الماء حين ارسله الله خمسين وماءة يوم كما يزعم اهل التوراة فكان بين ان ارسل الله الطوفان وبين ان غاض الماء ستة اشهر وعشر ليال، ولما اراد الله ان يكف ذلك، ارسل الله ريحا علي وجه الماء فسكت الماء، واستدت ينابيع الارض الغمر الاكبر، وابواب السماء فجعل الماء ينقص ويفيض ويدبر فكان استواء الفلك علي الجودي فيما يزعم اهل التوراة في الشهر السابع لسبع عشرة ليلة مضت منه في اول يوم من الشهر العاشر، زوي رءوس الجبال فلما مضي بعد ذلك اربعون يوما فتح نوح كوة الفلك التي صنع فيها ثم ارسل الغراب لينظر له ما فعل الماء فلم يرجع فارسل الحمامة فرجعت اليه فلم تجد لرجليها موضعا فبسط يده للحمامة فاخذها فادخلها فمكث سبعة ايام ثم ارسلها لتنظر له فرجعت اليه حيث امست وفي فمها ورقة زيتونة فعلم نوح ان الماء قد قل عن وجه الارض ثم مكث سبعة ايام ثم ارسلها فلم ترجع اليه فعلم نوح ان الارض قد برزت»
 
  قوله تعالي {وجعلناهم للناس اية} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن الدشتكي، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع بن انس " يعني قوله: {للناس اية} [الفرقان: ] يقول: عبرة ومتفكرا "
 
  قوله تعالي {واعتدنا للظالمين} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر، عن ابي روق، عن الضحاك، عن ابن عباس، " {واعتدنا للظالمين} [الفرقان: ] يقول: للكافرين: {عذابا اليما} [النساء: ] قال: العذاب النكال "
 
  قوله تعالي {اليما} 
 [النساء: ]
 
    
 حدثنا احمد بن عمرو بن ابي عاصم، حدثني ابي، انبا شبيب بن بشير، انبا عكرمة، عن ابن عباس، في قول الله: " {اليما} [النساء: ] قال: اليم كل شء موجع "
 
  قوله تعالي {وعادا وثمود} [الفرقان: ] قد تقدم تفسيرها
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: «فلما اهلك الله عادا وانقضي امرها عمرت ثمود بعدها فاستخلفوا في الارض فربلوا فيها وانتشروا ثم عتوا علي الله فلما ظهر فسادهم وعبدوا غير الله بعث الله اليهم صالحا  وكانوا قوما عربا وهو من اوسطهم نسبا وافضلهم موضعا  رسولا وكانت منازلهم الحجر الي ترج وهو وادي القري وبين ذلك ثمانية عشر ميلا فيما بين الحجاز والشام فبعث الله اليهم غلاما شابا فدعاهم الي الله حتي شمط وكبر لا يتبعه منهم احد الا قليل مستضعفون»
 
  قوله تعالي {واصحاب الرس} 
 [الفرقان: ]
 
    
 حدثنا احمد بن عمرو بن ابي عاصم النبيل، حدثني ابي، انبا شبيب بن بشير، عن عكرمة، عن ابن عباس، في قوله: " {واصحاب الرس} [الفرقان: ] بءر باذربيجان "
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله بن موسي، عن اسراءيل، عن ابي يحيي، عن مجاهد، " {واصحاب الرس} [الفرقان: ] قال: الرس بءر "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن يمان، عن سفيان، عن رجل، عن عكرمة، قال: " {واصحاب الرس} [الفرقان: ] رسوا نبيهم في بءر "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، " {واصحاب الرس} [الفرقان: ] حدثني ان اصحاب الرس كانوا اهل فلج وابار كانوا عليها ". وروي عن جعفر بن محمد انه قال: «كل نهر وبءر هو رس»
 
  قوله تعالي {وقرونا بين ذلك كثيرا} 
 [الفرقان: ]
 
    
 حدثنا محمد بن عوف الحمصي، ثنا سلامة بن جواس، انبا محمد بن القاسم الطاءي، ان عبد الله بن بسر، قال: قلت يا رسول الله كم القرن؟ قال: «ماءة سنة» وروي عن ابي سلمة بن عبد الرحمن نحو ذلك
 
  والوجه الثاني
 
    
 حدثنا ابي، ثنا ادم بن ابي اياس العسقلاني، ثنا حماد بن سلمة، عن ابي محمد، عن زرارة بن اوفي، قال: «القرن عشرون وماءة سنة بعث النبي صلي الله عليه وسلم في قرن كان اخرهم يزيد بن معاوية»
 
  والوجه الثالث
 
    
 حدثنا ابي، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، قال: «القرن سبعون سنة»
 
  الوجه الرابع
 
    
 حدثنا ابي، ثنا ابو بشر اسماعيل بن مسلمة بن قعنب، ثنا ابو عبيدة الناجي، عن الحسن البصري، قال: «القرن ستون سنة»
 
  الوجه الخامس
 
    
 حدثنا ابو سعيد الاشج، ثنا حفص، عن الحجاج، عن الحكم، عن ابراهيم، قال: «القرن اربعون سنة»
 
  الوجه السادس
 
    
 حدثنا ابي، ثنا مسلم بن ابراهيم، ثنا محمد بن عقبة الرافعي، ثنا مالك بن دينار، قال: " سالت الحسن عن القرن، فقال: «عشرون سنة»
 
  الوجه السابع
 
    
 حدثنا ابي، ثنا الربيع بن نافع الحلبي بطرسوس، ثنا معاوية بن سلام، عن اخيه زيد بن سلام انه سمع ابا سلام، قال: حدثني ابو امامة الباهلي، ان رجلا قال: يا رسول الله: " انبي كان ادم؟ قال: «نعم مكلم» قال: كم بينه وبين نوح؟ قال: «عشرة قرون» ، قال: كم كان بين نوح وابراهيم؟ قال: «عشرة قرون»
 
    
 حدثنا ابي، ثنا عبد الله بن عمران، ثنا ابو داود، ثنا همام، عن قتادة، عن عكرمة، عن ابن عباس، قال: «كان بين ادم وبين نوح عشرة قرون، كل امة منهم علي شريعة من الحق» وروي عن عكرمة نحوه
 
    
 حدثنا ابي، ثنا محمد بن عثمان ابو الجماهر التنوخي، ثنا سعيد بن بشير، عن قتادة، قال: «كان بين موسي وعيسي صلي الله عليهما اربعماءة سنة، وكان بين عيسي وبين محمد صلي الله عليهما ستماءة سنة وبين نوح وادم صلي الله عليهما الف دار وبين نوح ابراهيم صلي الله عليهما الف دار، وبين ابراهيم وبين موسي صلي الله عليهما وسلم الف دار» يعني: الف دار: الف سنة
 
    
 حدثنا ابي، ثنا موسي بن ايوب النصيبي، ثنا ضمرة، عن عثمان بن عطاء، عن ابيه، قال: «بين النبي صلي الله عليه وسلم وبين ادم تسعة واربعون ابا»
 
    
 حدثنا علي بن الحسين، ثنا اسماعيل بن سعيد الغلاس، ثنا ابراهيم ابن هراسة، عن سفيان، عن الاعمش، قال: «كان بين موسي وعيسي الف نبي»
 
    
 قرء علي يونس بن عبد الاعلي، انبا ابن وهب، اخبرني ابن لهيعة، عن ابي الاسود، قال: سمعت عروة بن الزبير، يقول: «ما وجدنا احدا يعرف ما وراء معد بن عدنان»
 
  قوله تعالي {وكلا ضربنا له الامثال} 
 [الفرقان: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {وكلا ضربنا له الامثال وكلا تبرنا تتبيرا} [الفرقان: ] كلا قد اعذر الله اليه وبين له ثم انتقم منه "
 
  قوله تعالي {وكلا تبرنا تتبيرا} 
 [الفرقان: ]
 
    
 اخبرنا ابو عبد الله محمد بن حماد الطهراني، فيما كتب الي، انبا عبد الرزاق، انبا معمر، عن الحسن، في قوله: " {وكلا تبرنا تتبيرا} [الفرقان: ] قال: تبر الله كلا بالعذاب تتبيرا "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قوله: " {وكلا تبرنا تتبيرا} [الفرقان: ] قال: اضللنا الذين اضللناهم، لم ينتفعوا من دينهم بشء "
 
  قوله تعالي {ولقد اتوا علي القرية التي امطرت مطر السوء} 
 [الفرقان: ]
 
    
 اخبرنا العباس بن الوليد بن مزيد البيروتي، قراءة، اخبرني محمد بن شعيب بن شابور، اخبرني عثمان بن عطاء، عن ابيه، «واما القرية التي امطرت مطر السوء فقرية لوط»
 
    
 حدثنا علي بن الحسين، ثنا المقدمي، ثنا ابو معشر البراء، ثنا ابو رجاء، قال: سمعت الحسن، قرا: " {ولقد اتوا علي القرية التي امطرت مطر السوء} [الفرقان: ] قال: هي والله بين الشام والمدينة "
 
  قوله تعالي {افلم يكونوا يرونها} [الفرقان: ] الاية
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة: قوله: " {لا يرجون} [الفرقان: ] اي: لا يخافون "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، " {لا يرجون نشورا} [الفرقان: ] اي: بعثا ولا حسابا "
 
  قوله تعالي {واذا راوك ان يتخذونك الا هزوا} 
 [الفرقان: ]
 
    
 حدثنا محمد بن العباس مولي بني هاشم، ثنا محمد بن عمرو زنيج، ثنا سلمة، قال: قال محمد بن اسحاق: " قال ابو جهل يوما وهو يهزا برسول الله صلي الله عليه وسلم وبما جاء به من الحق: يا معشر قريش " يزعم محمد ان جنود الله الذين يعذبونكم في النار ويحبسونكم فيها تسعة عشر وانتم اكثر الناس عددا وكثرة افيعجزكم ماءة رجل منكم عن رجل منهم؟ فانزل الله عز وجل في ذلك من قوله: {وما جعلنا اصحاب النار الا ملاءكة وما جعلنا عدتهم الا فتنة للذين كفروا "} [المدثر: ] الي اخر القصة "
 
  قوله تعالي {ان كاد ليضلنا عن الهتنا لولا ان صبرنا عليها} 
 [الفرقان: ]
 
    
 حدثنا محمد، ثنا محمد، ثنا سلمة، عن محمد بن اسحاق، قال: فحدثني يحيي بن عروة بن الزبير، عن ابيه عروة، عن عبد الله بن عمرو بن العاص، قال: قلت له: ما اكثر ما رايت قريشا اصابت من رسول الله صلي الله عليه وسلم فيما كانت تظهر من عداوته؟ فقال: حضرتهم وقد اجتمع اشرافهم يوما في الحجر فذكروا
  [ص: ]
 رسول الله صلي الله عليه وسلم فقالوا: ما راينا مثل ما صبرنا عليه من هذا الرجل قط، سفه احلامنا وشتم اباءنا وعاب ديننا وفرق جماعتنا وسب الهتنا لقد صبرنا منه علي امر عظيم، او كما قالوا، فبينما هم في ذلك طلع رسول الله صلي الله عليه وسلم فاقبل يمشي حتي استلم الركن ثم مر بهم طاءفا بالبيت فلما مر بهم غمزوه ببعض القول قال: فعرفت ذلك في وجه رسول الله صلي الله عليه وسلم، ثم مضي طاءفا فلما مر بهم الثانية فغمزوه بمثلها فوقف، ثم قال: «اتسمعون يا معشر قريش اما والذي نفسي بيده لقد جءتكم بالذبح» فاخذت القوم كلمته حتي ما منهم من رجل الا كانما علي راسه طاءر واقع وحتي ان اشدهم فيه وضاءة قبل ذلك ليرفءه بافضل ما يجد من القول، حتي انه ليقول: انصرف يا ابا القاسم راشدا فوالله ما كنت جهولا، قال: فانصرف رسول الله صلي الله عليه وسلم حتي اذا كان الغد، اجتمعوا في الحجر وانا معهم فقال بعضهم لبعض: ذكرتم الرجل وما بلغ منكم وما بلغكم منه، حتي اذا بداكم بما تكرهون تركتموه، فبينما هم في ذلك طلع رسول الله صلي الله عليه وسلم، فوثبوا اليه وثبة رجل واحد فاحاطوا به يقولون له: انت الذي تقول كذا وكذا، لما كان يبلغهم من عيب الهتهم ودينهم قال: فيقول رسول الله صلي الله عليه وسلم: «نعم، انا الذي اقول ذلك» ، قال: فلقد رايت رجلا اخذ بمجمع رداءه قال: وقام ابو بكر الصديق دونه يقول وهو يبكي: ويلكم اتقتلون رجلا ان يقول ربي الله ثم انصرفوا عنه فان ذلك لاشد ما رايت قريشا بلغت منه قط
 
  قوله تعالي {وسوف يعلمون حين يرون العذاب} [الفرقان: ] الاية
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن فضيل، عن ابيه، عن اسماعيل بن مسلم، عن الحسن، " {وسوف يعلمون} [الفرقان: ] قال: وعيد "
 
  قوله تعالي من اضل سبيلا تقدم تفسيره في هذه السورة
 
  قوله تعالي {ارايت من اتخذ الهه هواه} 
 [سورة: الفرقان، اية رقم: ]
 
    
 حدثنا ابي، ثنا يحيي بن عبد الحميد الحماني، ثنا يعقوب بن عبد الله، عن جعفر، عن سعيد بن جبير، عن ابن عباس: قوله: " {ارايت من اتخذ الهه هواه} [الفرقان: ] قال: كان الرجل يعبد الحجر الابيض زمانا من الدهر في الجاهلية، فاذا وجد حجرا احسن منه يعبد الاخر ويترك الاول " وروي عن سعيد بن جبير نحو ذلك
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، " {ارايت من اتخذ الهه هواه} [الفرقان: ] قال: ذلك الكافر اتخذ الهه بغير هدي من الله ولا برهان واضله الله علي علم يقول: اضله في سابق علمه "
 
    
 حدثنا ابو سعيد الاشج، ثنا وكيع، ثنا مبارك، عن الحسن، " {ارايت من اتخذ الهه هواه} [الفرقان: ] قال: لا يهوي شيءا الا اتبعه "
 
    
 حدثنا ابو زرعة، ثنا ابراهيم بن موسي، انبا ابن ابي زاءدة، انبا ابن المبارك، عن الحسن، في قوله: " {ارايت من اتخذ الهه هواه} [الفرقان: ] قال: ذلك المنافق نصب هواه فما هوي من شء ركبه "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {ارايت من اتخذ الهه هواه} [الفرقان: ] والله لكلما هوي شيءا ركبه وكلما اشتهي شيءا اتاه لا يحجزه عن ذلك ورع ولا تقوي "
 
  قوله تعالي {افانت تكون عليه وكيلا} 
 [الفرقان: ]
 
    
 حدثنا محمد بن يحيي، انبا عبد الاعلي بن جهاد النرسي، ثنا يزيد بن زريع، عن سعيد، عن قتادة: قوله: " {وكيلا} [النساء: ] قال: ناصرا "
 
  قوله تعالي {ام تحسب ان اكثرهم يسمعون او يعقلون} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قال: «لا يسمعون الهدي ولا يبصرونه ولا يعقلونه» .
    
 وذكر ايضا حديث سلمان الفارسي رضي الله عنه: " القلوب اربعة: قلب اغلف فذلك قلب الكافر " الحديث الي اخره وقد تقدم
 
  قوله تعالي {ان هم الا كالانعام} 
 [الفرقان: ]
 
    
 اخبرنا محمد بن سعد العوفي، فيما كتب الي حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، عن ابن عباس، قال: " مثل الذين كفروا كمثل البعير والحمار والشاة ان قلت لبعضهم: كل، لم يعلم ما تقول غير انه يسمع صوتك، كذلك الكافر ان امرته بخير او نهيته عن شر ووعظته لم يعقل ما تقول، غير انه يسمع صوتك "
 
  قوله تعالي {بل هم اضل سبيلا} 
 [الفرقان: ]
 
    
 قرات علي محمد بن الفضل، ثنا محمد بن علي، ثنا محمد بن مزاحم، ثنا بكير بن معروف، عن مقاتل بن حيان: قوله: " {اضل سبيلا} [الفرقان: ] يقول: اخطا السبيل "
 
  قوله تعالي {الم تر الي ربك كيف مد الظل} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا يزيد بن عبد العزيز الطلاس، ثنا اسحاق بن سليمان، عن ابي سنان الشيباني، عن ابي اسحاق الهمداني، عن عمرو بن ميمون الاودي: قوله: " {الم تر الي ربك كيف مد الظل} [الفرقان: ] قال: ازالته عنكم الشمس "
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {مد الظل} [الفرقان: ] يقول: ما بين طلوع الفجر الي طلوع الشمس "
 
    
 حدثنا ابي، ثنا اصبغ بن الفرج، اخبرني ابن وهب، انبا عمرو بن الحارث، عن قيس الحاجب، سمع ابا حفص المديني، سمع ابن عباس، يقول في قول الله: " {مد الظل ولو شاء لجعله ساكنا} [الفرقان: ] قال: هو بعد الفجر قبل طلوع الشمس ". وروي عن ابن عمر وابي مالك وسعيد بن جبير وابي العالية، وابراهيم النخعي، ومسروق، والحسن، والضحاك، والسدي، وقتادة، وابي سنان الشيباني نحو ذلك
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {كيف مد الظل} [الفرقان: ] قال: الغداة قبل طلوع الشمس "
 
    
 اخبرنا العباس بن الوليد بن مزيد البيروتي، قراءة، ثنا محمد بن شعيب بن شابور، اخبرني عثمان بن عطاء، عن ابيه، {مد الظل} [الفرقان: ] قال ابن عطاء: «قبل طلوع الشمس غدوة»
 
    
 حدثنا علي بن الحسين، ثنا شيبان، ثنا مبارك، عن الحسن، في قوله: " {الم تر الي ربك كيف مد الظل} [الفرقان: ] قال: مده من المشرق الي المغرب، وفيما بين طلوع الفجر الي طلوع الشمس "
 
    
 حدثنا ابي، ثنا يحيي بن سليمان بن نضلة الخزاعي، عن مسلم بن خالد، عن ايوب بن موسي، في قوله: " {الم تر الي ربك كيف مد الظل} [الفرقان: ] قال: الارض كلها ظل ما بين صلاة الغداة الي طلوع الشمس "
 
  قوله تعالي {ولو شاء لجعله ساكنا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، " {ولو شاء لجعله ساكنا} [الفرقان: ] يقول: داءما "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {لجعله ساكنا} [الفرقان: ] لا تصيبه الشمس ولا يزول "
 
    
 حدثنا ابو زرعة، ثنا ابراهيم بن موسي، انبانا ابن ابي زاءدة، انبا مبارك، عن الحسن، " {ولو شاء لجعله ساكنا} [الفرقان: ] قال: يدعه كما هو ظل ممدود "
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا شيبان، ثنا مبارك، ثنا الحسن: " {ولو شاء لجعله ساكنا} [الفرقان: ] قال: اقره كما هو ممدود "
 
  قوله تعالي {ثم جعلنا الشمس عليه دليلا} 
 [الفرقان: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {الشمس عليه دليلا} [الفرقان: ] قال: تحويه "
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن ابن ابي طلحة، عن ابن عباس: قوله: " {ثم جعلنا الشمس عليه دليلا} [الفرقان: ] يقول: طلوع الشمس "
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا مسدد، ثنا هشيم، عن العوام، عن ابراهيم التيمي، في قوله: " {ثم جعلنا الشمس عليه دليلا} [الفرقان: ] قال علي الظل "
 
    
 حدثنا محمد بن يحيي، انبا العباس، ثنا يزيد، ثنا سعيد، عن قتادة: قوله: " {ثم جعلنا الشمس عليه دليلا} [الفرقان: ] تتلوه وتتبعه حتي تاتي عليه كله "
 
    
 حدثنا عبد الله بن سليمان بن الاشعث، ثنا الحسين بن علي بن مهران، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: قوله: " {ثم جعلنا الشمس عليه دليلا} [الفرقان: ] يقول: تتبعه فتقبضه حيث كان "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي انبا اصبغ، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول في قول الله: " {ثم جعلنا الشمس عليه دليلا} [الفرقان: ] قال اخرجت ذلك الظل فذهبت به "
 
  قوله تعالي {ثم قبضناه الينا} 
 [الفرقان: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، " {ثم قبضناه الينا} [الفرقان: ] حوي الشمس اياه "
 
    
 حدثنا ابي، ثنا محمد بن كثير العبدي، انبا سليمان يعني: اخاه، عن حصين، عن ابي مالك: " {قبضناه الينا} [الفرقان: ] قبضه حين تطلع "
 
    
 حدثنا علي بن الحسين، ثنا شيبان، ثنا مبارك، عن الحسن: " {ثم قبضناه الينا قبضا يسيرا} [الفرقان: ] قال: القبض للظل "
 
  قوله تعالي {قبضا يسيرا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {قبضا يسيرا} [الفرقان: ] يقول: سريعا "
 
  والوجه الثاني
 
    
 حدثنا ابي، ثنا ابو نعيم، ثنا سفيان، عن عبد العزيز بن رفيع، عن مجاهد: " {ثم قبضناه الينا قبضا يسيرا} [الفرقان: ] قال: خفيا "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي بن مهران، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: قوله: " {ثم قبضناه الينا قبضا يسيرا} [الفرقان: ] يقول: قبضا خفيا حتي لا يبقي في الارض ظل الا تحت سقف او تحت شجرة، وقد اظلت ما فوقه "
 
    
 حدثنا ابي، ثنا يحيي بن سليمان بن نضلة الخزاعي، عن مسلم بن خالد، عن ايوب بن موسي، في قوله: " {ثم قبضناه الينا قبضا يسيرا} [الفرقان: ] قال: قليلا قليلا "
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع بن انس، في قوله: " {مد الظل} [الفرقان: ] قال: الظل فيما بين طلوع الفجر الي ان تطلع الشمس، فيما ذلك كله ظل، ثم جعلت الشمس عليه دليلا، ثم قبضه الرب
  [ص: ]
 تعالي قبضا يسيرا حتي اذا زالت الشمس علي نصف النهار كان في انتقاص الي ان تغرب الشمس قال: ان النهار اثنا عشر ساعة، فاول الساعة ما بين طلوع الفجر الي ان تري شعاع الشمس، ثم ان الساعة الثانية اذا رايت شعاع الشمس الي ان يضء الاشراق، عند ذلك لم يبق من قرونها شء وصفا لونها قال: فهو فيما سمعنا اذا كنت في ارض مستوية او في مكان لا يحول بينك وبينها شء، فاذا كانت بقدر ما تريك عينك قيد رمحين، فذلك اول الضحي وذلك اول ساعة من ساعات الضحي، ثم من بعد ذلك الضحي ساعتين ثم الساعة السادسة حين نصف النهار، فاذا زالت الشمس عن نصف النهار فتلك ساعة صلاة الظهر وهي التي قال الله: {اقم الصلاة لدلوك الشمس} [الاسراء: ] ثم من بعد ذلك العشي ساعتين ثم ان الساعة العاشرة هي ميقات صلاة العصر قال: وهي الاصال، قال الله عز وجل: {وسبحوه بكرة واصيلا} [الاحزاب: ] ثم بعد ذلك ساعتين الي الليل "
 
  قوله تعالي {وهو الذي جعل لكم الليل لباسا والنوم سباتا وجعل النهار نشورا} 
 [الفرقان: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {النهار نشورا} [الفرقان: ] ينشر فيه "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {وهو الذي جعل لكم الليل لباسا والنوم سباتا وجعل النهار نشورا} [الفرقان: ] لمعايشهم ولحواءجهم ولتصرفهم "
 
  قوله تعالي {وهو الذي ارسل الرياح} 
 [الفرقان: ]
 
    
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي: قوله: " {ارسل الرياح} [الفرقان: ] قال: ان الله عز وجل يرسل الرياح فتاتي بالسحاب من بين الخافقين طرفا السماء والارض حيث يلتقيان فيخرجه من ثم، ثم ينشره فيبسطه في السماء كيف يشاء، ثم يفتح ابواب السماء ليسيل الماء علي السحاب، ثم تمطر السحاب بعد ذلك "
 
    
 حدثنا ابو عبد الله محمد بن حماد الطهراني فيما كتب الي، حدثني اسحاق بن محمد المسيب، عن نافع بن عبد الرحمن بن ابي نعيم، عن جماعة من التابعين، عن ابي بن كعب، قال: «كل شء في القران من الرياح فهي رحمة، وكل شء في القران من الريح فهو عذاب»
 
  قوله تعالي {بشرا بين يدي رحمته} 
 [الاعراف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر، عن ابي روق، عن الضحاك، عن ابن عباس: قوله: " {بشرا بين يدي رحمته} [الاعراف: ] قال: يستبشر بها الناس "
 
  قوله تعالي {بين يدي رحمته} 
 [الاعراف: ]
 
    
 حدثني احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي: قوله: " {بين يدي رحمته} [الفرقان: ] قال: اما رحمته فهو المطر "
 
  قوله تعالي {وانزلنا من السماء ماء طهورا} [الفرقان: ] تقدم الماء
 
    
 حدثنا عبد الله بن احمد بن عبد الرحمن الدشتكي، حدثني ابي، حدثني ابي، عن ابيه، عن عكرمة، قال ابن عباس: ان الماء لا ينجسه شء يطهر ولا يطهره شء فان الله عز وجل قال: {وانزلنا من السماء ماء طهورا} [الفرقان: ] "
 
    
 حدثنا ابو زرعة، ثنا مسدد، ثنا معتمر، عن حميد الطويل، عن ثابت، عن ابي رافع، او عن ابي العالية، " في طين المطر يصيب ثوب الرجل فقرا هذه الاية: {وانزلنا من السماء ماء طهورا} [الفرقان: ] "
 
    
 حدثنا ابي، ثنا عمر بن حفص بن غياث، ثنا ابي، عن ابي جعفر الرازي، حدثني حميد الطويل، عن ثابت البناني، قال: دخلت مع ابي العالية في يوم مطير وطرق البصرة قذرة فصلي، فقلت له: فقال: " {وانزلنا من السماء ماء طهورا} [الفرقان: ] قال: طهره ماء السماء "
 
    
 حدثنا ابي، ثنا ابو سلمة، ثنا وهيب، عن داود، عن سعيد بن المسيب، في هذه الاية: " {وانزلنا من السماء ماء طهورا} [الفرقان: ] قال: انزل الله ماء طهورا لا ينجسه شء "
 
  قوله تعالي {لنحيي به بلدة ميتا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا علي بن جعفر الاحمر، ثنا محمد بن سليمان بن الاصبهاني، عن عمه عبد الرحمن، عن عكرمة، قال: «ما انزل الله عز وجل من السماء قطرة الا كانت بها في الارض عشبة او في البحر لءلءة»
 
    
 حدثنا ابي، ثنا ابو الاشعث، ثنا معتمر، قال: سمعت ابي يحدث عن سيار، عن خالد بن يزيد، قال: كان عند عبد الملك بن مروان قال: " فذكروا الماء، فقال خالد بن يزيد: منه من السماء ومنه ما يسقيه الغيم من البحر فيعذبه الرعد والبرق، واما ما كان من البحر فلا يكون له نبات، واما النبات فمما كان من السماء "
 
  قوله تعالي {ونسقيه مما خلقنا انعاما واناسي كثيرا} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: قوله: " {انعاما} [الفرقان: ] قال: الراعية "
 
  قوله تعالي {ولقد صرفناه بينهم ليذكروا} 
 [الفرقان: ]
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا مسدد، ثنا معتمر، عن ابيه، قال: سمعت الحسن بن مسلم، يحدث طاوسا، عن سعيد بن جبير، عن ابن عباس، انه قال: " ما من عام باكثر مطرا من عام ولكن الله يصرفه بين عباده وقرا: {ولقد صرفناه بينهم} [الفرقان: ] "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن نضر بن عربي، عن عكرمة، " {ولقد صرفناه بينهم} [الفرقان: ] قال: الغيث يسقي هذه ويمنع هذه "
 
    
 حدثنا علي بن الحسين، ثنا اسماعيل بن عبد الرحمن بن محمد بن عبيد بن كثير بن الصلت المديني، بالمدينة قال: سمعت اسحاق بن ابراهيم بن فسطاط، يقول: عن عمر مولي غفرة قال: كان جبريل في موضع الجناءز فقال له النبي صلي الله عليه وسلم: «يا جبريل اني احب ان اعلم امر السحاب» قال: فقال جبريل عليه السلام: يا نبي الله هذا ملك السحاب فساله قال: تاتينا صكاك مختمة اسق بلاد كذا وكذا قطرة
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد النرسي، ثنا يزيد بن زريع، انبا سعيد، عن قتادة: قوله: " {ولقد صرفناه بينهم ليذكروا فابي اكثر الناس الا كفورا} [الفرقان: ] وان الله عز وجل قسم هذا الرزق بين عباده وصرفه بينهم "
 
  قوله تعالي {ليذكروا} 
 [الاسراء: ]
 
    
 حدثنا ابي، ثنا محمود بن خالد، وعبد الرحمن بن ابراهيم دحيم قالا: ثنا الوليد، ثنا ابن جابر، قال: سالت عطاء الخراساني، عن قول الله: {ولقد صرفناه بينهم ليذكروا} [الفرقان: ] قال: " القران الا تري الي قوله فيها: {ولو شءنا لبعثنا في كل قرية نذيرا فلا تطع الكافرين وجاهدهم به جهادا كبيرا} [الفرقان: ] "
 
  قوله تعالي {فابي اكثر الناس الا كفورا} 
 [الاسراء: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن نضر بن عربي، عن عكرمة: " {فابي اكثر الناس الا كفورا} [الاسراء: ] قال: قيل له ما كفرهم؟ قال: يقولون: مطرنا بالانواء فانزل الله في الواقعة: {وتجعلون رزقكم انكم تكذبون} [الواقعة: ] "
 
  قوله تعالي {ولو شءنا لبعثنا في كل قرية نذيرا} 
 [الفرقان: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، عن سعيد، عن قتادة: قوله: " {في كل قرية نذيرا} [الفرقان: ] قال: لها رسل "
 
  قوله تعالي {فلا تطع الكافرين وجاهدهم به جهادا كبيرا} 
 [الفرقان: ]
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي انبا اصبغ، قال: سمعت ابن زيد، في قول الله: " {وجاهدهم به جهادا كبيرا} [الفرقان: ] قال: يريد الاسلام والدين وقرا: {واغلظ عليهم} [التوبة: ] وقرا: {وليجدوا فيكم غلظة} [التوبة: ] وقال: هذا الجهاد الكبير "
 
  قوله تعالي {وهو الذي مرج البحرين} 
 [الفرقان: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا هانء بن سعيد، عن جويبر، عن الضحاك، قال: «المرج ارسال واحد علي الاخر»
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: {مرج البحرين} [الفرقان: ] قال: «افاض احدهما في الاخر»
 
    
 حدثنا ابي، ثنا ابو الدرداء عبد العزيز بن منيب، ثنا ابو معاذ الفضل بن خالد، عن عبيد بن سليمان، عن الضحاك: قوله: " {وهو الذي مرج البحرين} [الفرقان: ] يقول: خلع احدهما علي الاخر فلا يغير احدهما طعم الاخر "
 
  قوله تعالي {البحرين} 
 [الكهف: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن يمان، عن اشعث، عن جعفر، عن سعيد: " {مرج البحرين} [الفرقان: ] قال: بحر السماء وبحر الارض " وروي عن عطية ومجاهد قالا: «بحر في السماء وبحر في الارض»
 
  والوجه الثاني
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن يمان، عن سفيان، عن رجل، عن الحسن، " {مرج البحرين} [الفرقان: ] قال: بحر فارس والروم "
 
  قوله تعالي {هذا عذب فرات وهذا ملح اجاج} 
 [الفرقان: ]
 
    
 اخبرنا العباس بن الوليد بن مزيد البيروتي، قراءة اخبرني محمد بن شعيب بن شابور، اخبرني عثمان بن عطاء، عن ابيه، عن عطاء: " واما الفرات فالماء العذب وفي قوله: {وهذا ملح اجاج} [الفرقان: ] واما الاجاج: فالماء المالح "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {وهذا ملح اجاج} [الفرقان: ] اي مر "
 
  قوله تعالي {وجعل بينهما برزخا} 
 [الفرقان: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن علية، عن ابي رجاء، عن الحسن: " {وجعل بينهما برزخا} [الفرقان: ] قال: هو اليبس "
 
    
 حدثنا ابو سعيد الاشج، حدثني عقبة، عن اسراءيل، عن جابر، عن مجاهد، قال: «البرزخ عرض الدنيا»
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {برزخا} [الفرقان: ] قال: محبسا "
 
  والوجه الثاني
 
    
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ، عن عبيد بن سليمان، عن الضحاك: قوله: " {برزخا} [الفرقان: ] قال: بينهما البرزخ، وهو الاجل ما بين الدنيا والاخرة "
 
  والوجه الثالث
 
    
 اخبرنا ابو عبد الله الطهراني، فيما كتب الي، انبا عبد الرزاق، انبا معمر، عن قتادة، في قوله: " {برزخا} [الفرقان: ] قال: البرزخ: التخوم "
 
  الوجه الرابع
 
    
 حدثنا الحسين بن الحسن، ثنا ابراهيم بن عبد الله الهروي، ثنا حجاج، عن ابن جريج، عن مجاهد: " {برزخا} [الفرقان: ] حاجزا لا يراه احد لا يختلط العذب بالبحر ولا يختلط بحر الروم وفارس، وبحر الروم ملح " قال ابن جريج: " فلم اجد بحرا عذبا الا الانهار العذاب تمور فيه بينهما مثل الخيط الابيض فاذا رجعت لم ترجع في طريقهما من البحر شء والنيل زعموا ينصب في البحر فلم اجد في قول مجاهد: العذب بالبحر فلم اجد العذاب الا الانهار "
 
    
 حدثنا ابو سعيد الاشج، ثنا هانء بن سعيد، عن جويبر، عن الضحاك: قوله: " {حجرا محجورا} [الفرقان: ] قال: جعل بينهما حاجزا من امره لا يسيل المالح علي العذب ولا العذب علي المالح "
 
    
 اخبرنا محمد بن سعد العوفي، فيما كتب الي، حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، عن ابن عباس: قوله: " {وحجرا محجورا} [الفرقان: ] يقول: حجز احدهما عن الاخر بامره وقضاءه وهو مثل قوله: {وجعل بين البحرين حاجزا} [النمل: ] "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {حجرا محجورا} [الفرقان: ] لا يختلط البحر بالعذاب " وروي عن قتادة انه قال: «حجر العذب عن المالح، والمالح عن العذب»
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قوله: " {وجعل بينهما برزخا وحجرا محجورا} [الفرقان: ] قال: جعل بينهما سترا لا يلتقيان قال: والعرب اذا كلم احدهما الاخر بما يكره قال: سترا ودون الذي تقول "
 
    
 حدثنا ابي، ثنا ابن نفيل محمد بن سلمة، عن خصيف في قوله: " {وجعل بينهما برزخا وحجرا محجورا} [الفرقان: ] قال: حجازا محجوزا "
 
  قوله تعالي {وهو الذي خلق من الماء بشرا} 
 [الفرقان: ]
 
    
 حدثنا ابراهيم بن مرزوق البصري، نزيل مصر، ثنا ابو عامر، ثنا مبارك بن فضالة، عن ثمامة، عن انس بن مالك، قال: سءل رسول الله صلي الله عليه وسلم عن العزل فقال: «لو ان الماء الذي يكون منه الولد صب علي صخرة لاخرج الله منها ما قدر ليخلق الله نفسا هو خالقها»
 
  قوله تعالي {فجعله نسبا} 
 [الفرقان: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو بكر بن ابي شيبة، وعثمان، قالا: ثنا ابو معاوية، عن جويبر، عن الضحاك، قال: «النسب الرضاع»
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {وهو الذي خلق من الماء بشرا فجعله نسبا وصهرا وكان ربك قديرا} [الفرقان: ] ذكر الله الصهر مع النسب وحرم اربع عشرة امراة: سبعا من النسب وسبعا من الصهر، واستوي تحريم الله في النسب والصهر "
 
  قوله تعالي: {وصهرا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا سليمان بن معبد، ثنا عبد الرزاق، انبا معمر، عن ابن طاوس، عن ابيه: " {نسبا وصهرا} [الفرقان: ] قال: الرضاعة من الصهر "
 
    
 حدثنا علي بن الحسين، ثنا ابو بكر، وعثمان ابنا ابي شيبة، ثنا ابو معاوية، عن جويبر، عن الضحاك، قال: «الصهر الختونة»
 
  قوله تعالي {وكان ربك قديرا} 
 [الفرقان: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو يحيي الرازي، عن عمرو بن ابي قيس، عن مطرف، عن المنهال، عن سعيد بن جبير، عن ابن عباس، قال: اتاه رجل فقال: يا ابن عباس سمعت الله يقول: {وكان الله} [النساء: ] كانه شء كان؟ قال: " اما قوله: {وكان الله} [النساء: ] ، فانه لم يزل ولا يزال وهو الاول والاخر والظاهر والباطن "
 
  قوله تعالي {ويعبدون من دون الله ما لا ينفعهم ولا يضرهم} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة: قوله: " {ويعبدون من دون الله} [يونس: ] هذا الوثن وهذا الحجر "
 
  قوله تعالي {وكان الكافر علي ربه ظهيرا} 
 [الفرقان: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن فضيل، عن مطرف، عن عامر: " {وكان الكافر علي ربه ظهيرا} [الفرقان: ] قال: ابو جهل ". وروي عن مجاهد، وسعيد بن جبير، وعطية، مثل ذلك
 
  قوله تعالي {علي ربه ظهيرا} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {وكان الكافر علي ربه ظهيرا} [الفرقان: ] يقول: عونا للشيطان علي ربه بالعداوة والشرك "
 
    
 حدثنا ابي، ثنا ابو غسان زنيج، ثنا حكام، ثنا عنبسة، عن ليث، عن مجاهد: " {وكان الكافر علي ربه ظهيرا} [الفرقان: ] قال: يظاهر الشيطان علي معصية الله يعينه "
 
    
 حدثنا علي بن الحسين بن الجنيد، ثنا ابن ابي حماد، ثنا الصباح بن محارب، ثنا محمد بن ابان، عن زيد بن اسلم: قوله: " {وكان الكافر علي ربه ظهيرا} [الفرقان: ] قال: مواليا "
 
  قوله تعالي {وما ارسلناك الا مبشرا} 
 [الاسراء: ]
 
 حدثنا ابي، ثنا عبد الرحمن بن صالح، ثنا عبد الرحمن بن محمد بن عبيد الله الفزاري، عن شيبان النحوي، اخبرني قتادة، عن عكرمة، عن ابن عباس، قال: لما نزلت: {وما ارسلناك الا مبشرا} [الاسراء: ] قد كان امر عليا ومعاذا ان يسيرا الي اليمن فقال: " انطلقا فبشرا ولا تنفرا ويسرا ولا تعسرا انه قد نزلت علي: {يا ايها النبي انا ارسلناك شاهدا ومبشرا} [الاحزاب: ] "
 
  قوله تعالي {الا مبشرا ونذيرا} 
 [الاسراء: ]
 
    
 حدثنا ابي، ثنا عبد الرحمن بن صالح، ثنا عبد الرحمن بن محمد بن عبد الله الفزاري، عن شيبان النحوي، اخبرني قتادة، عن عكرمة، عن ابن عباس: قوله: " {مبشرا} [الاسراء: ] قال: يبشر بالجنة قال: ونذيرا من النار " وروي عن قتادة مثل ذلك
 
  قوله تعالي {قل ما اسالكم عليه من اجر} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: قوله: " {قل ما اسالكم عليه من اجر} [الفرقان: ] قال: قل لهم يا محمد: لا اسالكم علي ما ادعوكم اليه من اجر "
 
    
 قرء علي يونس بن عبد الاعلي انبا ابن وهب، اخبرني سعيد بن ابي ايوب، عن عطاء بن دينار، في قول الله: " {قل ما اسالكم عليه من اجر} [الفرقان: ] يقول: لا اسالكم علي ما جءتكم به اجرا "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد، يقول في قول الله: " {قل ما اسالكم عليه من اجر} [الفرقان: ] يقول: لا اسالكم علي القران اجرا "
 
  قوله تعالي: {من اجر} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {من اجر} [الفرقان: ] يقول عرضا من عرض الدنيا "
 
  قوله تعالي {الا من شاء ان يتخذ الي ربه سبيلا} 
 [الفرقان: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {ما اسالكم عليه من اجر الا من شاء ان يتخذ الي ربه سبيلا} [الفرقان: ] اي: بطاعة الله "
 
  قوله تعالي {وتوكل علي الحي الذي لا يموت} 
 [الفرقان: ]
 
    
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو زنيج، ثنا سلمة، قال محمد بن اسحاق: قوله: " {وتوكل علي الحي} [الفرقان: ] اي: ارض به من العباد "
 
  قوله تعالي {علي الحي الذي لا يموت} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا عبد الله بن محمد بن علي بن نفيل، قال: قرات علي معقل يعني ابن عبيد الله، عن عبد الله بن ابي حسين، عن شهر بن حوشب، قال: لقي سلمان رسول الله صلي الله عليه وسلم في بعض فجاج المدينة فسجد له فقال: «لا تسجد لي يا سلمان واسجد للحي الذي لا يموت»
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي الدامغاني، ثنا عمرو بن حمران، عن سعيد، عن قتادة: قوله: " {الحي} [الفرقان: ] قال: الحي: الذي لا يموت "
 
  قوله تعالي {وسبح بحمده} 
 [الفرقان: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة يعني: قوله: " {وسبح بحمده} [الفرقان: ] اي: بمعرفته وطاعته "
 
  قوله تعالي {وكفي به بذنوب عباده خبيرا} 
 [الفرقان: ]
 
    
 به عن قتادة: " {خبيرا} [النساء: ] قال: خبير بخلقه "
 
  قوله تعالي {الذي خلق السموات والارض وما بينهما}
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة بن الفضل الرازي، ثنا ابن اسحاق: قوله: " {الذي خلق السموات والارض وما بينهما في ستة ايام} قال: ابتدع السموات والارض ولم يكونا الا بقدرته، لم يستعن علي ذلك
  [ص: ]
 باحد من خلقه ولم يشركه في شء من امره بسلطانه القاهر وقوله النافذ الذي يقول به لما اراد ان يكون له كن فيكون، ففرغ من خلق السموات والارض في ستة ايام "
 
    
 اخبرنا محمد بن حماد، فيما كتب الي، انبا اسماعيل بن عبد الكريم، اخبرنا عبد الصمد بن معقل، انه سمع عمه وهب بن منبه يقول: " قال عزير: امرت الماء فجمد في وسط الهواء فجعلت منه سبعا وسميتها السموات، ثم امرت الماء ينبثق من التراب وامرت التراب ان يتميز من الماء فكان كذلك فسميت جميع ذلك الارضين وجميع الماء البحار "
 
  قوله تعالي {في ستة ايام} 
 [الاعراف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: قوله: " {خلق السموات والارض وما بينهما في ستة ايام} قال: يوم مقداره الف سنة "
 
  قوله تعالي {ثم استوي علي العرش} 
 [الاعراف: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، عن ابن ابي عروبة، عن قتادة: قوله: " {ثم استوي علي العرش} [الفرقان: ] قال: اليوم السابع "
 
    
 حدثنا يزيد بن سنان البصري، نزيل مصر، ثنا يزيد بن ابي حكيم، حدثني الحكم بن ابان، قال: سمعت عكرمة، يقول: «ان الله بدا خلق السموات والارض وما بينهما يوم الاحد، ثم استوي علي العرش يوم الجمعة في ثلاث ساعات فخلق في ساعة منها الشموس كي يرغب الناس الي ربهم في الدعاء والمسالة، وخلق في ساعة النتن الذي يسقط علي ابن ادم اذا مات لكي يقبر»
 
    
 حدثنا عصام بن رواد العسقلاني، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع بن انس، عن ابي العالية، في قوله: " {ثم استوي} [الفرقان: ] يقول: ارتفع ". وروي عن الحسن والربيع بن انس مثل قول ابي العالية
 
  قوله تعالي {العرش} [الاعراف: ] تقدم تفسيره
 
  قوله تعالي {الرحمن} [الفاتحة: ] تقدم تفسيره
 
    
 حدثنا ابي، ثنا جعفر بن مسافر، ثنا زيد بن المبارك الصنعاني، ثنا سلام بن وهب الجندي، ثنا ابي، عن طاوس، عن ابن عباس، ان عثمان بن عفان، سال رسول الله صلي الله عليه وسلم عن الرحمن فقال: «هو اسم من اسماء الله وما بينه وبين اسم الله الاكبر الا كما بين سواد العينين وبياضهما من القرب»
 
  قوله تعالي {فاسال به خبيرا} 
 [الفرقان: ]
 
    
 حدثنا المنذر بن شاذان، ثنا زكريا بن عدي، انبا ابن عيينة، عن ابن ابي نجيح، عن مجاهد، في قول الله: " {فاسال به خبيرا} [الفرقان: ] قال: ما اخبرتك من شء فهو كما اخبرتك "
 
    
 حدثنا علي بن الحسين، ثنا ابو بكر بن ابي شيبة، وعثمان، وابو عامر بن براد قالوا: انا اسحاق بن منصور، ثنا يعقوب القمي، عن ابي عبيدة، قال ابو محمد: كذا قال، وانما هو عبيد بن حميد، عن شمر بن عطية: " {الرحمن فاسال به خبيرا} [الفرقان: ] قال: هذا القران خبيرا "
 
  قوله تعالي {واذا قيل لهم اسجدوا للرحمن قالوا وما الرحمن} 
 [الفرقان: ]
 
    
 حدثنا الفضل بن شاذان، ثنا ابراهيم بن موسي، انبا ابن ابي زاءدة، اخبرني اسراءيل، عن سماك، عن عكرمة، عن ابن عباس، قال: «ليس احد يسمي الرحمن غيره»
 
    
 حدثنا الفضل بن شاذان، ثنا سهل بن عثمان العسكري، ثنا محبوب يعني ابن محمد القواريري، عن طلحة، عن عطاء: " {واذا قيل لهم اسجدوا للرحمن قالوا وما الرحمن} [الفرقان: ] ما نعرف الرحمن الا رحمن اليمامة فانزل الله عز وجل: {والهكم اله واحد لا اله الا هو الرحمن الرحيم} [البقرة: ] "
 
    
 حدثنا الفضل بن شاذان، ثنا احمد بن يزيد الحلواني، ثنا هارون بن حاتم، قال: سمعت حسينا الجعفي، يقول: " {واذا قيل لهم اسجدوا للرحمن قالوا وما الرحمن} [الفرقان: ] قال: جوابها: {الرحمن علم القران} [الرحمن: ] "
 
  قوله تعالي {انسجد لما تامرنا وزادهم نفورا} 
 [الفرقان: ]
 
    
 حدثنا محمد بن العباس مولي بني هاشم، ثنا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، قال: " وانزل الله علي نبيه صلي الله عليه وسلم في قولهم: انه قد بلغنا انه انما يعلمك هذا الذي تاتي به رجل من اهل اليمامة يقال له
  [ص: ]
 : الرحمن، وانا والله لن نءمن به ابدا، وانزل عليه فيما قالوا من ذلك: {واذا قيل لهم اسجدوا للرحمن قالوا وما الرحمن انسجد لما تامرنا وزادهم نفورا} [الفرقان: ] "
 
  قوله عز وجل: {تبارك الذي جعل في السماء بروجا} 
 [الفرقان: ]
 
    
 حدثنا علي بن الحسين، ثنا احمد بن الصباح، ثنا علي بن حفص، ثنا حبان بن علي، عن سعد بن طريف، عن الاصبغ بن نباتة، عن علي، قال: " ان الشمس اذا طلعت هتف معها ملكان موكلان بها فيجريان معها ما جرت، حتي اذا وقعت في قطها، قيل لعلي: وما قطها؟ قال: حذي بطنان العرش قال: فتخر ساجدة حتي يقال لها: امضي فتمضي بقدر الله، فاذا طلعت اضاء وجهها لسبع سموات وقفاها لاهل الارض، يعني قوله: {جعل في السماء بروجا} [الفرقان: ] قال: وفي السماء ثلاثماءة وستون برجا كل برج منها اعظم من جزيرة العرب، للشمس في كل برج منها منزل تنزله "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن ادريس، عن ابيه، عن عطية: " {تبارك الذي جعل في السماء بروجا} [الفرقان: ] قال: قصورا في السماء فيها الحرس "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو معاوية، عن ابن ابي خالد، عن يحيي بن رافع: " {تبارك الذي جعل في السماء بروجا} [الفرقان: ] قال: قصورا في السماء «وروي عن ابن عباس ومحمد بن كعب القرظي وابي صالح في احدي الروايات وابراهيم النخعي والاعمش» انها القصور "
 
  والوجه الثاني
 
    
 حدثنا ابو سعيد، ثنا ابو اسامة، عن اسماعيل، عن ابي صالح: " {تبارك الذي جعل في السماء بروجا} [الفرقان: ] قال: الكواكب العظام "
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {تبارك الذي جعل في السماء بروجا} [الفرقان: ] قال: نجوما " روي عن مجاهد والحسن وقتادة مثل ذلك
 
  قوله تعالي {وجعل فيها سراجا} 
 [الفرقان: ]
 
    
 حدثنا علي بن الحسين، ثنا احمد بن الصباح، ثنا علي بن حفص، ثنا حبان بن علي، عن سعد بن طريف، عن الاصبغ بن نباتة، عن علي يعني: قوله: " {وجعل فيها سراجا} [الفرقان: ] قال: ان الشمس اذا طلعت اضاء وجهها لسبع سموات، وقفاها لاهل الارض "
 
    
 اخبرنا موسي بن هارون الطوسي، فيما كتب الي، انبا الحسين بن محمد المروذي، ثنا شيبان، عن قتادة: قوله: " {وجعل فيها سراجا} [الفرقان: ] قال: سراجا شمسا "
 
  قوله {وقمرا منيرا} 
 [الفرقان: ]
 
    
 اخبرنا عبيد بن محمد بن حمزة، فيما كتب الي، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة: قوله: " {وقمرا منيرا} [الفرقان: ] اي: مضيءا "
 
  قوله تعالي {وهو الذي جعل الليل والنهار خلفة} 
 [الفرقان: ]
 
    
 حدثنا احمد بن سنان الواسطي، ثنا عبد الرحمن بن مهدي، عن سفيان، عن ابيه، عن عكرمة، قال: سءل ابن عباس عن الليل، كان قبل او النهار؟ قال: «ارايتم السموات حيث كانتا رتقا هل كان بينهما الا ظلمة؛ ذلك لتعلموا ان الليل كان قبل النهار»
 
    
 حدثنا ابي، ثنا ابو سلمة، ثنا حماد، عن عطاء بن الساءب، عن عكرمة، ان اليهود، قالوا للنبي صلي الله عليه وسلم: ما يوم الجمعة؟ قال: «خلق الله في ساعتين منه الليل والنهار»
 
    
 اخبرنا ابو عبد الله محمد بن حماد الطهراني فيما كتب الي، انبا اسماعيل بن عبد الكريم، حدثني عبد الصمد بن معقل، انه سمع عمه وهب بن منبه يقول: " قال عزير: اللهم بكلمتك خلقت جميع خلقك فاتي علي مشيءتك لم تان فيه مءنة ولم تنصب فيه نصبا، كان عرشك علي الماء والظلمة والهواء، والملاءكة يحملون عرشك ويسبحون بحمدك، والخلق مطيع لك خاشع من خوفك، لا يري فيه نور الا نورك ولا يسمع فيه صوت الا سمعك، ثم فتحت خزانة النور وطريق الظلمة فكانا ليلا ونهارا يختلفان بامرك "
 
  قوله تعالي {خلفة} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: قوله: " {وهو الذي جعل الليل والنهار خلفة} [الفرقان: ] قال: ابيض واسود "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن ادريس، عن الحكم، عن مجاهد: " {الذي جعل الليل والنهار خلفة} [الفرقان: ] قال: سواد الليل من بياض النهار "
 
    
 اخبرنا موسي بن هارون الطوسي، فيما كتب الي، ثنا الحسين بن محمد المروذي، ثنا شيبان، عن قتادة: قوله: " {وهو الذي جعل الليل والنهار خلفة} [الفرقان: ] قال: مختلفان هذا اسود وهذا ابيض، وان المءمن قد ينسي بالليل ويذكر بالنهار وينسي بالنهار ويذكر بالليل "
 
    
 حدثنا سليمان بن داود القزاز، ثنا ابو داود، ثنا ابو حرة، عن الحسن، ان عمر اطال صلاة الضحي فقيل له: صنعت اليوم شيءا لم تكن تصنعه فقال: " انه بقي علي من وردي شيءا فاحببت ان اتمه او اقضيه وتلا هذه الاية: {جعل الليل والنهار خلفة لمن اراد ان يذكر او اراد شكورا} [الفرقان: ] "
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {جعل الليل والنهار خلفة} [الفرقان: ] يقول: من فاته شء من الليل ان يعمله ادركه بالنهار، او من النهار ادركه بالليل "
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، ثنا عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {وهو الذي جعل الليل والنهار خلفة لمن اراد ان يذكر او اراد شكورا} [الفرقان: ] يقول: جعل الليل خلفا من النهار، والنهار خلفا من الليل لمن فرط في عمله ان يقضيه "
 
    
 حدثنا ابو سعيد الاشج، ثنا عبدة، وابو عبد الرحمن الحارثي، عن جويبر، عن ابي سهل، عن الحسن: " {جعل الليل والنهار خلفة لمن اراد ان يذكر او اراد شكورا} [الفرقان: ] قال: من لم يستطع ان يعمل بالنهار فليعمل بالليل، ومن لم يستطع ان يعمل بالليل فليعمل بالنهار في كل واحد منهما خلف من الاخر "
 
    
 حدثنا يونس بن حبيب، ثنا ابو داود، ثنا ابو الاشهب، قال: سمعت الحسن، يقول: " {جعل الليل والنهار خلفة} [الفرقان: ] الاية قال: من عجز بالليل كان له في النهار مستعتب، ومن عجز بالنهار كان له في الليل مستعتب "
 
    
 حدثني ابو عبد الله الطهراني، حدثني حفص بن عمر، ثنا الحكم بن ابان، عن عكرمة، في قوله: " {خلفة لمن اراد ان يذكر او اراد شكورا} [الفرقان: ] قال: خذ من ليلك فان فاتك من نهارك فمن ليلك "
 
    
 حدثنا احمد بن سنان، ثنا ابو احمد، عن سفيان، عن عمرو بن قيس الماصر، قال: سمعت مجاهدا يقول في قوله: " {وهو الذي جعل الليل والنهار خلفة} [الفرقان: ] قال: هذا يخلف ذا، وهذا يخلف ذا "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم في قول الله: " {وهو الذي جعل الليل والنهار خلفة} [الفرقان: ] الاية كلها قال: لو لم يخلقه خلفة لم يدر احد كيف يعمل، لو كان الدهر كله ليلا، كيف يدري احد كيف يصوم؟ او كان الدهر نهارا كله كيف يدري احد كيف يصلي؟ قال: والخلفة يخلفان يذهب هذا وياتي هذا جعلهما خلفة لعباده وقرا: {لمن اراد ان يذكر او اراد شكورا} [الفرقان: ] "
 
  قوله تعالي {لمن اراد ان يذكر} 
 [الفرقان: ]
 
    
 حدثنا الحسين بن الحسن، ثنا ابراهيم بن عبد الله الهروي، ثنا حجاج، عن ابن جريج، عن مجاهد: " {ان يذكر} [البقرة: ] اية له "
 
    
 حدثنا ابي، ثنا المعلي بن اسد، ثنا محمد بن سواء، ثنا جويبر، عن الضحاك: " {لمن اراد ان يذكر} [الفرقان: ] قال: يتعظ "
 
  قوله تعالي {او اراد شكورا} 
 [الفرقان: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {او اراد شكورا} [الفرقان: ] شكر نعمة ربه عليه فيها "
 
    
 حدثنا ابي، ثنا المعلي بن اسد، ثنا محمد بن سواء، ثنا جويبر، عن الضحاك: قوله: " {او اراد شكورا} [الفرقان: ] قال: طاعة "
 
  قوله تعالي {وعباد الرحمن} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن ابن ابي طلحة، عن ابن عباس: قوله: " {وعباد الرحمن} [الفرقان: ] قال: هم المءمنون يمشون علي الارض هونا "
 
  قوله تعالي {الذين يمشون} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا عمرو بن علي، ثنا عيسي بن خالد الخراساني، ثنا ابو سنان، عن الضحاك بن مزاحم، في قوله: " {يمشون علي الارض} [الفرقان: ] قال: يمشون يعملون علي الارض "
 
  قوله تعالي {هونا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابو غسان، ثنا اسراءيل، عن مسلم بياع الملاءي، عن مجاهد، عن ابن عباس: " {يمشون علي الارض هونا} [الفرقان: ] قال: علماء حلماء "
 
    
 حدثنا ابو سعيد الاشج، ثنا المحاربي، عن جويبر، عن الضحاك: " {هونا} [الفرقان: ] اعفاء اتقياء حلماء "
 
    
 حدثنا احمد بن سنان، ثنا عبد الرحمن، عن ابي الاشهب، عن الحسن: " {يمشون علي الارض هونا} [الفرقان: ] قال: حلماء " وروي عن سعيد بن جبير في احدي الروايات وميمون بن مهران مثل قول الحسن
 
    
 حدثنا ابي، ثنا ابو صالح بن زياد الرقي، ثنا يحيي بن سعيد الحمصي، ثنا النضر بن عربي، عن ميمون بن مهران، في قوله: " {هونا} [الفرقان: ] قال: حلماء بالسريانية "
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، في قوله: " {هونا} [الفرقان: ] قال: بالطاعة والعفاف والتواضع "
 
    
 حدثنا علي بن الحسين، ثنا المقدمي، ثنا عامر بن صالح، عن ابيه، عن ابي عمران الجوني: " {يمشون علي الارض هونا} [الفرقان: ] قال: بالعبرانية: يمشون علي الارض حلماء "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو بكير النخعي، عن ليث، عن مجاهد: " {يمشون علي الارض هونا} [الفرقان: ] قال: بالسكينة والوقار "
 
    
 حدثنا ابي، ثنا عبد الصمد بن عبد العزيز المقرء، ثنا جسر، عن الحسن، في قوله: " {هونا} [الفرقان: ] قال: الهون بالعربية السكينة والحلم والوقار قال: فالمءمن حليم وان جهل عليه حلم، ولا يظلم، وان ظلم غفر، ولا يبخل وان بخل عليه صبر "
 
    
 حدثنا ابو زرعة، ثنا ابراهيم بن موسي، ثنا ابن ابي زاءدة، ثنا مبارك، عن الحسن: قوله: " {يمشون علي الارض هونا} [الفرقان: ] قال: الهون في كلام العرب اللين والسكينة والوقار "
 
    
 حدثنا المنذر بن شاذان، ثنا زكريا بن عدي، ثنا ابن المبارك، عن معمر، عن يحيي بن المختار، عن الحسن: " {وعباد الرحمن الذين يمشون علي الارض هونا} [الفرقان: ] قال: ان المءمنين قوم ذلل ذلت والله منهم الاسماع والابصار والجوارح حتي تحسبهم مرضي وما بالقوم من مرض وانهم لاصحاء ولكن دخلهم من الخوف ما لم يدخل غيرهم، ومنعهم من الدنيا علما بالاخرة فقالوا: {الحمد لله الذي اذهب عنا الحزن} [فاطر: ] اما والله ما احزنهم حزن الناس ولا تعاظم في انفسهم شء طلبوا به الجنة، ابكاهم الخوف من النار، انه من لا يتعز بعزاء الله تقطع نفسه علي الدنيا حسرات، ومن لم ير لله نعمة الا في مطعم او مشرب فقد قل " اري ابن المبارك قال: علمه وحضر عذابه
 
    
 حدثنا ابي، ثنا عبدة بن سليمان، ثنا ابن المبارك، ثنا محمد بن سليم، ثنا قتادة، في قوله: " {يمشون علي الارض هونا} [الفرقان: ] قال: تواضعا لله لعظمته كانوا لا يجاهلون اهل الجهل "
 
    
 حدثنا ابي، ثنا محمد بن عباد بن زكريا، ثنا يحيي بن يمان، عن اسامة بن زيد، عن زيد بن اسلم: " {يمشون علي الارض هونا} [الفرقان: ] قال: لا يفسدون "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {يمشون علي الارض هونا} [الفرقان: ] قال: لا يتكبرون علي الناس ولا يتجبرون ولا يفسدون في الارض "
 
    
 حدثنا علي بن الحسين، ثنا القاسم بن عيسي الواسطي الطاءي، ثنا هشيم، عن ابي اسحاق الكوفي، عن الضحاك، في قوله: " {هونا} [الفرقان: ] سريانية وقال: هو هونا "
 
  قوله تعالي {واذا خاطبهم الجاهلون} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا عبد الصمد بن عبد العزيز المقرء، ثنا جسر، عن الحسن، في قول الله: " {واذا خاطبهم الجاهلون} [الفرقان: ] قال: المءمن حليم وان جهل عليه حلم " الحديث وهو معاد
 
    
 حدثنا علي بن الحسين، ثنا محمد بن ابي حماد، ثنا مهران، عن المبارك بن مجاهد، عن جويبر، عن الضحاك، " {واذا خاطبهم الجاهلون قالوا سلاما} [الفرقان: ] قال: اذا سفه عليه الجاهل قال: وعليك السلام "
 
  قوله: {الجاهلون} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {واذا خاطبهم الجاهلون قالوا سلاما} [الفرقان: ] يعني: السفهاء من الكبار "
 
  قوله تعالي {قالوا سلاما} 
 [هود: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو خالد، عن سفيان، عن ابن ابي نجيح، عن مجاهد: " {واذا خاطبهم الجاهلون قالوا سلاما} [الفرقان: ] قالوا: سدادا "
 
    
 قرء علي يونس بن عبد الاعلي، انبا ابن وهب، حدثني سفيان بن عيينة، ومسلم بن خالد، عن ابن ابي نجيح، عن مجاهد، في قول الله: " {واذا خاطبهم الجاهلون قالوا سلاما} [الفرقان: ] قالوا: سدادا من القول "
 
    
 حدثنا ابو سعيد الاشج، ثنا عبد الوهاب الخفاف، عن عمرو، عن الحسن: " {واذا خاطبهم الجاهلون قالوا سلاما} [الفرقان: ] قال: السلام عليكم "
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {قالوا سلاما} [هود: ] يعني: ردوا معروفا "
 
    
 حدثنا ابي، ثنا سعيد بن سليمان الواسطي، ثنا مبارك، عن الحسن: " {واذا خاطبهم الجاهلون قالوا سلاما} [الفرقان: ] قال: حلماء لا يجهلون وان جهل عليهم حلموا يصاحبون عباد الله نهارهم مما تسمعون، ثم ذكر ليلهم خير ليل "
 
    
 اخبرنا عبيد بن محمد بن يحيي بن حمزة، فيما كتب الي، ثنا ابو الجماهر، ثنا سعيد بن بشر، ثنا قتادة: قوله: " {واذا خاطبهم الجاهلون قالوا سلاما} [الفرقان: ] اهل حياء وكرم يعفون ويكنون "
 
  قوله تعالي {والذين يبيتون لربهم سجدا وقياما} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني عبد الله بن لهيعة، حدثني عطاء، عن سعيد بن جبير، في قول الله: " {والذين يبيتون لربهم سجدا وقياما} [الفرقان: ] يعني: يصلون بالليل وهم في ذلك سجود وقيام "
 
    
 حدثنا المنذر بن شاذان، ثنا احمد بن اسحاق، ثنا ابو الاشهب، ثنا الحسن: " {والذين يبيتون لربهم سجدا وقياما} [الفرقان: ] قال: هذا ليلهم اذا خلوا فيما بينهم وبين ربهم يروحون من اطرافهم "
 
    
 حدثنا ابي، ثنا سعيد بن سليمان الواسطي، ثنا مبارك، عن الحسن: " {والذين يبيتون لربهم سجدا وقياما} [الفرقان: ] ينتصبون لله علي اقدامهم ويفترشون وجوههم سجدا لربهم تجري دموعهم علي خدودهم خوفا من ربهم قال الحسن: لامر ما سهر ليلهم ولامر ما تخشع لهم نهارهم "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، في قوله: {يبيتون لربهم سجدا وقياما} [الفرقان: ] ذكر لنا ان نبي الله صلي الله عليه وسلم كان يقول: «اصيبوا من هذا الليل ولو ركعتين او اربعا»
 
  قوله تعالي {والذين يقولون ربنا اصرف عنا عذاب جهنم ان عذابها كان غراما} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا شيبان بن فروخ، ثنا ابو الاشهب، عن الحسن، في قوله: " {ان عذابها كان غراما} [الفرقان: ] قال: اعلموا ان كل غريم مفارق غريمه الا غريم جهنم "
 
    
 حدثنا ابي، ثنا سعيد بن سليمان الواسطي، ثنا مبارك، عن الحسن: " {والذين يقولون ربنا اصرف عنا} [الفرقان: ] الاية: قال: كل شء يصيب ابن ادم يزول عنه وليس بغرام، وانما الغرام اللازم ما دامت السموات والارض "
 
    
 حدثنا ابو زرعة، ثنا سعيد بن سليمان، ثنا ابو معشر، عن محمد بن كعب: " {ان عذابها كان غراما} [الفرقان: ] قال: ما نعموا في الدنيا "
 
    
 حدثنا ابو زرعة، ثنا عبد الرحيم بن مطرف، ثنا عيسي بن يونس، عن موسي بن عبيدة، انبا محمد بن كعب، في قول الله: " {ان عذابها كان غراما} [الفرقان: ] قال: ان الله جل وعز سال الكفار عن النعمة فلم يردوها عليه "
 
    
 حدثنا ابي، ثنا عمرو بن علي، ثنا محمد بن الزبرقان، ثنا موسي بن عبيدة، عن محمد بن كعب، في قوله: " {ان عذابها كان غراما} [الفرقان: ] قال: سالهم عن النعيم فلم ياتوا به فاغرمهم فادخلهم النار "
 
    
 اخبرنا عبد الله بن حماد الطهراني، فيما كتب الي، ثنا عبد الرزاق، ثنا جعفر بن سليمان التيمي، قال: سمعته وساله رجل، فقال: يا ابا المعتمر، ارايت قول الله عز وجل: {ان عذابها كان غراما} [الفرقان: ] ، ما الغرام؟ قال: «الله اعلم» ثلاثا، ثم قال: «كل اسير لا بد ان يفك اساره يوما او يموت الا اسير جهنم فهو الغرام ولا يفك ابدا»
 
  قوله تعالي {انها ساءت مستقرا ومقاما} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا الحسين بن الربيع، ثنا ابو الاحوص، عن الاعمش، عن مالك بن الحارث، قال: " اذا طرح الرجل في النار هوي فيها فاذا انتهي الي بعض ابوابها قيل: مكانك حتي تتحف قال: فيسقي كاسا من سم الاساود والعقارب، قال: فتميز الجلد علي حدة، والشعر علي حدة، والعصب علي حدة، والعروق علي حدة "
 
    
 حدثنا ابي، ثنا الحسين بن الربيع، ثنا ابو الاحوص، عن الاعمش، عن مجاهد، عن عبيد بن عمير، قال: ان " في النار لجبابا فيها حيات امثال البخت وعقارب امثال البغال الدلم قال: فاذا قذف بهم في النار خرجت اليهم من اوطانهم فاخذت بشفافهم وابشارهم واشعارهم فكشطت لحومهم الي اقدامهم فاذا وجدت حر النار رجعت "
 
  قوله تعالي {والذين اذا انفقوا لم يسرفوا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {والذين اذا انفقوا} [الفرقان: ] قال: هم المءمنون "
 
    
 حدثنا ابي، ثنا هشام بن عمار، ثنا الوليد، ثنا ابن لهيعة، عن يزيد بن ابي حبيب، في قوله: " {والذين اذا انفقوا لم يسرفوا ولم يقتروا وكان بين ذلك قواما} [الفرقان: ] قال: اولءك اصحاب رسول الله صلي الله عليه وسلم "
 
  قوله تعالي {لم يسرفوا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {والذين اذا انفقوا لم يسرفوا} [الفرقان: ] قال: لا يسرفون فينفقون في معصية الله "
 
    
 قرء علي يونس بن عبد الاعلي، انبا ابن وهب، اخبرني خالد بن حميد، عن عقيل، عن ابن شهاب انه كان يقول: " {والذين اذا انفقوا لم يسرفوا} [الفرقان: ] قال: لا ينفقه في باطل "
 
    
 حدثنا ابو سعيد الاشج، ثنا عبد السلام بن حرب، انبا مغيرة، عن ابراهيم، في قوله: " {والذين اذا انفقوا لم يسرفوا} [الفرقان: ] لا ينفق نفقة يقول الناس قد سرف "
 
    
 حدثنا ابي، ثنا علي بن ميمون الرقي، ثنا خالد بن حيان، عن جعفر بن برقان، عن ميمون بن مهران، قال: «في المال ثلاث خصال ان نجا من خصلة كان قمن ان لا ينجو من الثنتين، وان نجا من ثنتين كان قمن ان لا ينجو من الثالثة وينبغي ان يكون اصله من طيب. فايكم الذي يسلم كسبه ولم يدخله الا طيبا، فان سلم فايكم الذي ادي الحقوق كلها، فان سلم من هذه فانه ينبغي له ان يكون في نفقته ليس بمسرف ولا مقتر»
 
    
 حدثنا ابي، ثنا هشام بن عمار، ثنا الوليد، ثنا ابن لهيعة، عن يزيد بن حبيب، في قوله: " {والذين اذا انفقوا لم يسرفوا ولم يقتروا وكان بين ذلك قواما} [الفرقان: ] قال: اولءك اصحاب رسول الله صلي الله عليه وسلم كانوا لا ياكلون طعاما يريدون به نعيما، ولا يلبسون ثوبا يريدون به جمالا، كانت قلوبهم علي قلب واحد "
 
    
 حدثنا ابي، ثنا ابو صالح كاتب الليث، ثنا الليث، حدثني ابراهيم بن نشيط، قال: سالت عمر مولي غفرة عن الاسراف ما هو؟ قال: " ليس شء انفقته في طاعة اسرافا، يعني: في طاعة الله "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي انا اصبغ، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {والذين اذا انفقوا لم يسرفوا} [الفرقان: ] قال: لم يسرفوا في معاصي الله، وكل ما انفق في معصية الله وان قل فهو اسراف "
 
    
 حدثنا ابي، ثنا الوليد بن صالح، ثنا خالد بن عبد الله الواسطي، عن داود بن ابي هند، قال: قلت للحسن: الرجل يصنع الطعام ينفق فيه النفقة الكثيرة، قال: «ليس في الطعام اسراف»
 
    
 حدثنا علي بن الحسين، ثنا عمرو بن علي، ثنا يزيد بن هارون، انبا سفيان بن حسين، عن ابي بشر جعفر بن ابي وحشية قال: اطاف الناس باياس بن معاوية بالكوفة فقالوا: ما السرف؟ قال: «ما جاوزت به امر الله فهو سرف» قال سفيان بن حسين: وما قصرت به عن امر الله فهو سرف "
 
    
 حدثنا ابي، ثنا موسي بن ايوب، ثنا مخلد بن الحسين، عن هشام، قال ابن سيرين اذ سءل عن السرف، ما هو؟ قال: «النفقة في غير حقها»
 
    
 حدثنا ابي، ثنا موسي بن ايوب، انبا بقية، عن هشام، عن الحسن، قال: «ليس في النفقة في سبيل الله سرف»
 
    
 حدثنا ابي، ثنا عصام بن رواد، ثنا ابي، ثنا رجل، عن الحسن، قال: «من الاسراف ان ياكل الرجل كل ما اشتهي»
 
  قوله تعالي {ولم يقتروا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {ولم يقتروا} [الفرقان: ] قال: هم المءمنون لا يقترون فيمنعون حقوق الله "
 
    
 قرء علي يونس بن عبد الاعلي، انبا ابن وهب، اخبرني خالد بن حميد، عن عقيل، عن ابن شهاب، انه كان يقول: " {ولم يقتروا} [الفرقان: ] يقول: لا يمنعه من حق ولا ينفقه في باطل "
 
    
 حدثنا ابو سعيد الاشج، ثنا عبد السلام، ثنا مغيرة، عن ابراهيم: " {ولم يقتروا} [الفرقان: ] قال: لا يجيعهم ولا يعريهم "
 
    
 حدثنا علي بن الحسين، ثنا عثمان بن ابي شيبة، ثنا معاوية بن هشام، عن سفيان، عن الاعمش، في قوله: " {ولم يقتروا} [الفرقان: ] قال: لم يقصروا عن الحق "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انا اصبغ، قال: سمعت عبد الرحمن بن زيد: " {ولم يقتروا} [الفرقان: ] فيمسكوا عن طاعة الله وما امسك عن طاعة الله وان كثرت فهو اقتار "
 
  قوله تعالي {وكان بين ذلك قواما} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا يحيي بن عثمان بن سعيد بن كثير بن دينار، ثنا رواد، عن المسعودي، عن قتادة، عن مطرف بن الشخير، قال: " العلم خير من العمل وخير الامور اوساطها، والحسنة بين السيءتين ذلك بان الله عز وجل يقول: {والذين اذا انفقوا لم يسرفوا} [الفرقان: ] يقول: سيءة: {ولم يقتروا} [الفرقان: ] يقول: سيءة {وكان بين ذلك قواما} [الفرقان: ] يقول: حسنة "
 
    
 حدثنا ابي، ثنا ابو صالح كاتب الليث، حدثني ابراهيم بن نشيط، قال: سالت عمر مولي غفرة قلت له ما القوام؟ قال: «القوام الا تنفق في غير حق ولا تمسك من حق هو عليك»
 
    
 حدثنا ابي، ثنا بشر بن ادم ابن بنت ازهر بن سعد، ثنا ابو عاصم، عن سفيان، عن ابي سليمان، عن وهب بن منبه: " {وكان بين ذلك قواما} [الفرقان: ] قال: الشطر من اموالهم "
 
    
 حدثنا علي بن الحسين، ثنا عثمان بن ابي شيبة، ثنا معاوية بن هشام، عن سفيان، عن الاعمش، في قوله: " {وكان بين ذلك قواما} [الفرقان: ] قال: عدلا "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {وكان بين ذلك قواما} [الفرقان: ] قال: ان الله عز وجل قد اقاتكم قيتة فانتهوا الي قيتة الله عز وجل "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ بن الفرج، قال: سمعت ابن زيد، في قول الله: " {وكان بين ذلك قواما} [الفرقان: ] والقوام بين ذلك ان تنفقوا في طاعة الله وتمسكوا عن محارم الله "
 
  قوله تعالي {والذين لا يدعون مع الله الها اخر} 
 [الفرقان: ]
 
    
 حدثنا احمد بن سنان الواسطي، ثنا عبد الله بن نمير، انبا الاعمش، عن شقيق بن سلمة، عن عمرو بن شرحبيل، عن عبد الله بن مسعود، قال: سءل رسول الله صلي الله عليه وسلم عن الكباءر قال: " ان تدعو لله ندا وهو خلقك، وان تقتل ولدك خشية ان يطعم معك، وان تزاني حليلة جارك ثم قرا: {والذين لا يدعون مع الله الها اخر ولا يقتلون النفس التي حرم الله الا بالحق ولا يزنون} [الفرقان: ] "
 
    
 حدثنا محمد بن عبد الملك بن زنجويه، ثنا عبد الرزاق، انبا معمر، عن منصور، عن ابي واءل، عن عمرو بن شرحبيل، عن عبد الله بن مسعود، قال: قلت يا رسول الله او قاله غيري: اي الذنب اعظم عند الله؟ قال: «ان تجعل لله ندا وهو خلقك» ، قال: ثم اي؟ قال: «ان تقتل ولدك خشية ان يطعم معك» ، قال: ثم اي؟ قال: «ان تزاني حليلة جارك» ، قال: فانزل الله تصديق ذلك في كتابه: {والذين لا يدعون مع الله الها اخر "} [الفرقان: ] الاية "
 
    
 حدثنا ابي، ثنا الحسن بن محمد بن الصباح الزعفراني، ثنا حجاج، عن محمد، عن ابن جريج، عن سعيد بن جبير، انه سمعه يحدث عن ابن عباس، ان ناسا من اهل الشرك قد قتلوا فاكثروا وزنوا فاكثروا، ثم اتوا محمدا صلي الله عليه وسلم فقالوا: ان الذي تقوله وتدعو اليه لحسن لو تخبرنا ان لما عملنا كفارة، فنزلت: {والذين لا يدعون مع الله الها اخر ولا يقتلون النفس التي حرم الله الا بالحق ولا يزنون} [الفرقان: ] ونزلت: {يا عبادي الذين اسرفوا علي انفسهم} [الزمر: ] "
 
    
 حدثنا ابي، ثنا ابن ابي عمر، ثنا سفيان، عن عمرو، عن ابي فاختة، قال: قال رسول الله صلي الله عليه وسلم لرجل: «ان الله ينهاك ان تعبد المخلوق وتدع الخالق، وينهاك ان تقتل ولدك وتغذو كلبك، وينهاك ان تزني بحليلة جارك» . قال سفيان: وهو قوله: {والذين لا يدعون مع الله الها اخر} [الفرقان: ]
 
    
 حدثنا ابي، ثنا ادم بن ابي اياس العسقلاني، ثنا شعبة، ثنا يزيد الرشك، عن ابي مجلز، قال: كنت جالسا عند عبد الله بن عمر ساله رجل عن الشرك؟ فقال: «ان تجعل مع الله الها اخر»
 
  قوله تعالي {ولا يقتلون النفس التي حرم الله الا بالحق} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {ولا يقتلون النفس التي حرم الله الا بالحق} [الفرقان: ] يعني: نفس المءمن "
 
    
 حدثنا علي بن الحسين، ثنا ابو هشام، ثنا ابن ابي غنية، عن سعد الاسكاف، عن ابي جعفر: " {ولا يقتلون النفس التي حرم الله الا بالحق} [الفرقان: ] قال: هم اهل الذمة "
 
  قوله تعالي {التي حرم الله} 
 [الانعام: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني عبد الله بن لهيعة، حدثني عطاء، عن سعيد بن جبير، قول الله: " {ولا يقتلون النفس التي حرم الله} [الفرقان: ] قتلها الا بالحق "
 
  قوله تعالي {الا بالحق} 
 [الانعام: ]
 
    
 به عن سعيد بن جبير، في قول الله: {ولا يقتلون النفس التي حرم الله الا بالحق} [الفرقان: ] قال النبي صلي الله عليه وسلم: اني «امرت ان اقاتل الناس حتي يقولوا لا اله الا الله فاذا قالوها حرمت دماءهم الا بحقها وحسابهم علي الله» ، قالوا: يا نبي الله وما حقها؟ قال: النفس بالنفس والثيب الزاني والمرتد عن الاسلام التارك لدينه فغير ايمانه المفارق للجماعة "
 
  قوله تعالي: {ولا يزنون} 
 [الفرقان: ]
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا مسدد، ثنا عبد الواحد، ثنا عاصم، عن الشعبي، قال مسروق: اني لاعجب ممن يقول: ان القذف اشد من الزنا وقد قرن الله الزنا بالقتل والاشراك قال الله: {والذين لا يدعون مع الله الها اخر ولا يقتلون النفس التي حرم الله الا بالحق ولا يزنون} [الفرقان: ] "
 
  قوله تعالي {ومن يفعل ذلك} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {ومن يفعل ذلك} [البقرة: ] من هذه الايات الثلاث {يلق اثاما} [الفرقان: ] وفي قوله: {يلق اثاما} [الفرقان: ] يعني: جزاءه اثام "
 
  قوله تعالي {يلق اثاما} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة، عن ابي ايوب، عن عبد الله بن عمر: " {اثاما} [الفرقان: ] قال: واد في جهنم " وروي عن مجاهد وسعيد بن جبير في احدي الروايات وعكرمة مثل ذلك
 
    
 اخبرنا العباس بن الوليد بن مزيد، انبا محمد بن شعيب، انبا سعيد بن بشير، ان قتادة حدثهم: ان «اثاما اودية في جهنم»
 
    
 حدثنا علي بن الحسين، ثنا علي بن زنجة، ومحمد بن علي، قالا: ثنا علي بن الحسن، انبا الحسين، عن يزيد النحوي، عن عكرمة، حدثهم: " {يلق اثاما} [الفرقان: ] : اودية في جهنم فيها الزناة "
 
    
 حدثنا محمد بن يحيي، انبا العباس، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {ومن يفعل ذلك يلق اثاما} [الفرقان: ] اي: نكالا كنا نحدث انه واد في جهنم وقد ذكر لنا ان لقمان كان يقول: يا بني اياك والزنا فانه اوله مخافة واخره ندامة "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي، " {يلق اثاما} [الفرقان: ] قال: جزاء "
 
  قوله تعالي {يضاعف له العذاب يوم القيامة} 
 [الفرقان: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، قال: سمعت سعيدا، عن قتادة: قوله: " {يضاعف له} [الفرقان: ] اي: عذاب الدنيا والاخرة "
 
  قوله تعالي {ويخلد} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا عمرو بن اسلم الطرسوسي، ثنا محمد بن سعيد
  [ص: ]
 القطان، عن عيسي بن راشد، عن ابي عون الانصاري، انه سمع عمر بن عبد العزيز، يقول: «كل شء في القران خلود فانه لا توبة له»
 
  قوله تعالي {فيه} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {ويخلد فيه} [الفرقان: ] يعني: في العذاب وفي قوله: {مهانا} [الفرقان: ] يعني: يهان فيه "
 
  قوله تعالي {الا من تاب} 
 [مريم: ]
 
    
 حدثنا ابي، ثنا ادم العسقلاني، ثنا شعبة، عن منصور، عن سعيد بن جبير، قال: سالت ابن عباس، عن قوله: {والذين لا يدعون مع الله الها اخر} [الفرقان: ] الي قوله: {الا من تاب} [مريم: ] قال: «كانت هذه في الجاهلية»
 
    
 حدثنا ابي، ثنا ادم، ثنا شعبة، عن ابي اياس معاوية بن قرة اخبرني شهر بن حوشب، انه سمع ابن عباس، يقول: " نزلت هذه الاية: {ومن يقتل مءمنا متعمدا فجزاءه جهنم} [النساء: ] بعد قوله: {الا من تاب وامن وعمل عملا صالحا} [الفرقان: ] بسنة "
 
    
 حدثنا ابو زرعة، ثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني عبد الله بن لهيعة، حدثني عطاء، عن سعيد بن جبير، قال: نزلت هذه الاية: {والذين لا يدعون مع الله الها اخر} [الفرقان: ] الاية في كفار مكة فلما هاجر النبي صلي الله عليه وسلم الي المدينة كتب وحشي غلام المطعم بن عدي بن نوفل الي النبي صلي الله عليه وسلم بالمدينة اني قد اشركت وزنيت وقتلت، وكان قتل حمزة بن عبد المطلب يوم احد قال: هل لي من توبة؟ فنزلت فيه فاستثني: {الا من تاب} [مريم: ] يعني: من الشرك "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن ابي حماد، ثنا ابراهيم بن المختار، وابو زهير، عن الحجاج، عن عطية، عن ابي سعيد، قال: " لما اسلم وحشي انزل الله عز وجل: {والذين لا يدعون مع الله الها اخر ولا يقتلون النفس التي حرم الله الا بالحق} [الفرقان: ] قال وحشي واصحابه: فنحن قد ارتكبنا هذا كله فانزل الله عز وجل: {يا عبادي الذين اسرفوا علي انفسهم "} [الزمر: ] الاية "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر، ثنا اسباط، عن السدي، قال: ونزلت في المشركين قالوا: كيف تامرنا يا محمد ان نتبعك وانت تقول: انه من اشرك او قتل او زنا فانزل الله: {الا من تاب وامن وعمل عملا صالحا} [الفرقان: ] "
 
    
 حدثنا ابي، ثنا محمد بن كثير العبدي، ثنا سليمان يعني: اخاه، عن حصين، عن ابي مالك، قال: " لما نزلت هذه الاية: {والذين لا يدعون مع الله الها اخر} [الفرقان: ] الاية، قال بعض اصحاب رسول الله صلي الله عليه وسلم: قد كنا اشركنا في الجاهلية وقتلنا فنزلت: {الا من تاب وامن وعمل عملا صالحا} [الفرقان: ] "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {الا من تاب} [مريم: ] اي: من ذنوبه "
 
    
 اخبرنا محمد بن سعد العوفي، فيما كتب الي حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، عن ابن عباس: قوله: " {الا من تاب وامن وعمل عملا صالحا} [الفرقان: ] قال: هم الذين يتوبون فيعملون بطاعة الله "
 
  قوله تعالي {وامن} 
 [مريم: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني ابن لهيعة، حدثني عطاء، عن سعيد بن جبير، في قول الله: " {وامن} [الفرقان: ] يعني: وصدق بتوحيد الله "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد، انبا سعيد، عن قتادة: قوله: " {وامن} [مريم: ] اي: بربه وفي قوله: {وعمل عملا صالحا} [الفرقان: ] اي: فيما بينه وبين الله عز وجل "
 
  قوله تعالي {فاولءك} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي، حدثني ابن لهيعة، حدثني عطاء، عن سعيد، في قول الله: " {فاولءك} [البقرة: ] يعني: الذين فعلوا ما ذكر الله عز وجل في هذه الاية "
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن طلحة، عن ابن عباس: " {فاولءك يبدل الله سيءاتهم حسنات} [الفرقان: ] قال: هم المءمنون "
 
  قوله تعالي {يبدل الله} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي، حدثني ابن لهيعة، حدثني عطاء، عن سعيد، في قول الله: " {يبدل الله} [الفرقان: ] يعني: يحول الله "
 
    
 حدثني ابي، ثنا صفوان بن صالح، ثنا الوليد، ثنا سعيد بن عبد العزيز، عن مكحول، في قول الله: " {فاولءك يبدل الله سيءاتهم حسنات} [الفرقان: ] قال: يجعل سيءاتهم حسنات "
 
  قوله تعالي {فاولءك يبدل الله سيءاتهم حسنات} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا هشام بن عمار، ثنا سليمان بن موسي الزهري ابو داود، ثنا ابو العنبس، عن ابيه، عن ابي هريرة، قال: «لياتين الله باناس يوم القيامة راوا انهم قد استكثروا من السيءات» قيل: من هم يا ابا هريرة؟ قال: «الذين يبدل الله بسيءاتهم حسنات»
 
    
 حدثنا ابي، ثنا عمرو بن رافع، انبا هشيم، انبا يونس بن عبيد، عن شعيب بن الحبحاب، قيل لابي العالية: ان ناسا يقولون ودوا انهم استكثروا من الذنوب، فقال ابو العالية: " ولم يقولون ذلك؟ قال: قيل يتاولون هذه الاية: {فاولءك يبدل الله سيءاتهم حسنات} [الفرقان: ] فاستعاذ بالله من الشيطان الرجيم ثم تلا هذه الاية: {يوم تجد كل نفس ما عملت من خير محضرا "} [ال عمران: ] الاية "
 
    
 حدثنا محمد بن عمار بن الحارث، ثنا سهل بن بكار، ثنا ابو عوانة، عن جابر، عن مجاهد، عن ابن عباس: " {فاولءك يبدل الله سيءاتهم حسنات} [الفرقان: ] قال: بدلن بعد حره خريفا وبعد طول النفس الوجيفا "
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {فاولءك يبدل الله سيءاتهم حسنات} [الفرقان: ] قال: هم المءمنون كانوا قبل ايمانهم علي السيءات فرغب الله بهم عن ذلك فحولهم الي الحسنات وابدلهم مكان السيءات الحسنات "
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني ابن لهيعة، حدثني عطاء، عن سعيد، في قوله: " {فاولءك يبدل الله سيءاتهم حسنات} [الفرقان: ] قال: يبدلهم بمكان الشرك الاسلام وبمكان القتال الكف، وبمكان الزنا العفاف "
 
 حدثنا ابي، ثنا عمرو بن رافع، ثنا هشيم، عن يونس، عن الحسن البصري: " {فاولءك يبدل الله سيءاتهم حسنات} [الفرقان: ] قال: التبديل في الدنيا ابدلهم الله بالعمل السيء العمل الصالح وابدلهم بالشرك اخلاصا وابدلهم بالفجور احصانا، وبالكفر ايمانا واسلاما "
 
    
 حدثنا ابي، ثنا عمرو بن رافع، ثنا يعقوب بن عبد الله الاشعري، عن جعفر، عن سعيد: " {فاولءك يبدل الله سيءاتهم حسنات} [الفرقان: ] فابدلهم بعبادة الاوثان عبادة الله، وابدلهم بقتال المسلمين قتالا مع المسلمين المشركين، وابدلهم بنكاح المشركات نكاح المءمنات "
 
    
 حدثنا احمد بن عصام، ثنا ابو عاصم، ثنا سهل بن ابي الصلت، قال: سمعت الحسن، يقول: " {فاولءك يبدل الله سيءاتهم حسنات} [الفرقان: ] قال: هذه ليست لكم هذه في اهل الشرك "
 
    
 حدثنا ابي، ثنا الحسن بن قزعة، ثنا حصين بن نمير، ثنا حصين بن عبد الرحمن، عن ميسرة ابي جميلة، في قوله: " {فاولءك يبدل الله سيءاتهم حسنات} [الفرقان: ] قال: هم الذين ولجوا الي الاسلام من المشركين "
 
    
 قرء علي يونس بن عبد الاعلي، انبا ابن وهب، اخبرني رجل، عن عمرو بن الحارث، ان عطاء بن ابي رباح قال: في قول الله: " {فاولءك يبدل الله سيءاتهم حسنات} [الفرقان: ] قال: انما هذا في الدنيا الرجل يكون علي الهيءة القبيحة ثم يبدله الله بها خيرا "
 
    
 اخبرنا العباس بن الوليد بن مزيد البيروتي، قراءة، اخبرني محمد بن شعيب، انبا سعيد بن بشير، عن قتادة: " {فاولءك يبدل الله سيءاتهم حسنات} [الفرقان: ] قال: ذكر الله بعد نسيانه وطاعة الله بعد معصيته "
 
  والوجه الثاني
 
    
 حدثنا ابي، ثنا ابو سلمة، وعارم، قالا: ثنا ثابت يعني: ابن يزيد ابو زيد، ثنا عصام، عن ابي عثمان، عن سلمان، قال: «يعطي رجل يوم القيامة صحيفة فيقرا اعلاها فاذا سيءاته فاذا كاد يسوء ظنه ينظر في اسفلها فاذا حسنات ثم ينظر في اعلاها فاذا هي قد بدلت حسنات»
 
    
 حدثنا ابي، ثنا ابو سلمة، ثنا حماد بن سلمة، عن علي بن زيد، عن علي بن الحسين: " {يبدل الله سيءاتهم حسنات} [الفرقان: ] قال: في الاخرة "
 
    
 حدثنا ابي، ثنا محمد بن الوزير الدمشقي، ثنا الوليد، ثنا سعيد بن عبد العزيز، عن مكحول، وقرا: " {فاولءك يبدل الله سيءاتهم حسنات} [الفرقان: ] قال: يغفرها لهم فيجعلها حسنات "
 
    
 حدثنا ابي، ثنا عبد الله بن ابي زياد، ثنا سيار، ثنا جعفر، ثنا ابو حمزة، عن ابي الضيف، وكان من اصحاب معاذ بن جبل قال: " يدخل اهل الجنة الجنة علي اربعة اصناف المتقين، ثم الشاكرين، ثم الخاءفين، ثم اصحاب اليمين، قلت: لم سموا اصحاب اليمين؟ قال: لانهم عملوا بالحسنات والسيءات فاعطوا كتبهم بايمانهم فقرءوا سيءاتهم حرفا حرفا قالوا: يا ربنا هذه سيءاتنا فاين حسناتنا؟ فعند ذلك محا الله السيءات وابدلها حسنات فعند ذلك قالوا: {هاءم اقرءوا كتابيه} فهم اهل الجنة "
 
  قوله تعالي {وكان الله غفورا رحيما} [النساء: ] تقدم تفسير {كان} [البقرة: ] غير مرة في هذه السورة
 
  قوله تعالي {غفورا} 
 [النساء: ]
 
    
 حدثنا ابو زرعة، ثنا ابراهيم بن المنذر، ثنا عيسي بن شعيب بن ثوبان، عن فليح الشماس، عن عبيد بن ابي عبيد، عن ابي هريرة، قال: جاءتني امراة فقالت: هل لي من توبة؟ اني زنيت وولدت وقتلته، فقلت: لا ولا نعمت العين ولا كرامة فقامت وهي تدعو بالحسرة، ثم صليت مع النبي صلي الله عليه وسلم الصبح فقصصت عليه ما قالت المراة وما قلت لها، فقال رسول الله صلي الله عليه وسلم: " بءس ما قلت، اما كنت تقرا هذه الاية: {والذين لا يدعون مع الله الها اخر} [الفرقان: ] الي قوله: {الا من تاب وامن وعمل عملا صالحا فاولءك يبدل الله سيءاتهم حسنات وكان الله غفورا رحيما} [الفرقان: ] " فقراتها عليها فخرت ساجدة وقالت: الحمد لله الذي جعل لي مخرجا
 
    
 حدثنا ابي، ثنا محمد بن الوزير بن الحكم السلمي الدمشقي، ثنا الوليد بن مسلم، ثنا ابن جابر، انه سمع مكحولا، يحدث قال: جاء شيخ كبير هرم قد سقطت
  [ص: ]
 حاجباه علي عينيه فقال: يا رسول الله، رجل غدر وفجر، لم يدع حاجة ولا داجة الا اقتطعها بيمينه، لو قسمت خطيءته بين اهل الارض لاوبقتهم، فهل له من توبة؟ فقال: النبي صلي الله عليه وسلم: «اسلمت؟» فقال: اما انا، فاشهد ان لا اله الا الله وحده لا شريك له، وان محمدا عبده ورسوله فقال النبي صلي الله عليه وسلم: «فان الله غافر لك ما كنت كذلك ومبدل سيءاتك حسنات» ، قال: يا رسول الله: وغدراتي وفجراتي قال: «وغدراتك وفجراتك» ، قال: فولي الرجل يكبر ويهلل
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني ابن لهيعة، حدثني عطاء، عن سعيد بن جبير، في قول الله: " {وكان الله غفورا رحيما} [النساء: ] يعني: لما كان في الشرك رحيما بهم في الاسلام "
 
  قوله تعالي {ومن تاب} 
 [هود: ]
 
    
 به عن مجاهد: قوله: " {ومن تاب} [هود: ] قال: تاب الله عليه "
 
  قوله تعالي {وعمل صالحا فانه يتوب الي الله متابا} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابراهيم بن موسي، انبا هشام بن يوسف، عن ابن جريج، عن عطاء، عن ابن عباس، قال: «الاعمال الصالحة سبحان الله والحمد لله ولا اله الا الله والله اكبر»
 
  قوله تعالي {والذين لا يشهدون} 
 [الفرقان: ]
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ، قال: سمعت عبد الرحمن بن زيد يعني: ابن اسلم، في قول الله: " {والذين لا يشهدون الزور} [الفرقان: ] قال: هءلاء المهاجرون "
 
  قوله تعالي {لا يشهدون الزور} 
 [الفرقان: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {لا يشهدون الزور} [الفرقان: ] قال: لا يساعدون اهل الباطل علي باطلهم ولا يمالءونهم فيه "
 
  قوله تعالي {الزور} 
 [الحج: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله بن موسي، عن اسماعيل بن سلمان، عن ابن عمر الاسدي البزار، عن ابن الحنفية: " {والذين لا يشهدون الزور} [الفرقان: ] قال: اللهو والغناء «. وروي عن مجاهد، وابي الجحاف» انه الغناء "
 
  والوجه الثاني
 
    
 حدثنا ابو سعيد الاشج، ثنا عبدة بن سليمان، عن جويبر، عن الضحاك: " {والذين لا يشهدون الزور} [الفرقان: ] قال: الشرك "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو يحيي الرازي، عن ابي سنان، عن الضحاك: " {والذين لا يشهدون الزور} [الفرقان: ] قال: كلام الشرك "
 
    
 حدثنا الاشج، ثنا عبد الله بن سعيد ابو بكير النخعي، عن العلاء بن المسيب، عن عمرو بن مرة: " {والذين لا يشهدون الزور} [الفرقان: ] قال: لا يمالءون اهل الشرك علي شركهم ولا يخالطونهم " وروي عن السدي نحو قول الضحاك
 
  والوجه الثالث
 
    
 حدثنا الاشج، اخبرنا عبد الرحمن بن سعيد الخراز، ثنا الحسين بن عقيل، عن الضحاك: " {والذين لا يشهدون الزور} [الفرقان: ] قال: عيد المشركين "، وروي عن ابي العالية، وطاوس، والربيع بن انس، والمثني بن الصباح نحو ذلك
 
  والوجه الرابع
 
    
 حدثنا محمد بن اسماعيل الاحمسي، ثنا عبد الرحمن بن ابي حماد، حدثني ابو قتيبة البصري، قال: سمعت ابن سيرين، يقول في قوله: " {والذين لا يشهدون الزور} [الفرقان: ] قال: هو الشعانين "
 
  والوجه الخامس
 
    
 حدثنا محمد بن اسماعيل، ثنا عمرو العنقزي، انبا مسلمة بن جعفر الاحمسي، عن عمرو بن قيس، في قوله: " {والذين لا يشهدون الزور} [الفرقان: ] قال: مجالس الخنا "
 
    
 حدثنا ابي، ثنا احمد بن ابراهيم الدورقي، ثنا عثمان بن اليمان، عن ابي بكر بن ابي عون، عن عمرو بن قيس الملاءي: " {والذين لا يشهدون الزور} [الفرقان: ] قال: مجالس السوء "
 
  الوجه السادس
 
    
 ذكر عن عمرو بن علي، ثنا يزيد بن زريع، عن عمارة بن ابي حفصة، عن عكرمة: " {والذين لا يشهدون الزور} [الفرقان: ] قال: لعب كان في الجاهلية "
 
  والوجه السابع
 
    
 ذكر عن عبد الله بن ابي زياد القطواني، ثنا زيد بن حباب، عن الحسين بن واقد، عن خالد بن كثير: " {والذين لا يشهدون الزور} [الفرقان: ] قال: مجلس كان يشتم فيه النبي صلي الله عليه وسلم "
 
  الوجه الثامن
 
    
 اخبرنا موسي بن هارون الطوسي، فيما كتب الي، انبا الحسين بن محمد المروذي، ثنا شيبان، عن قتادة: " {والذين لا يشهدون الزور} [الفرقان: ] قال: الكذب "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ، قال: سمعت عبد الرحمن بن زيد، في قول الله: " {والذين لا يشهدون الزور} [الفرقان: ] قال: والزور قولهم لالهتهم وتعظيمهم اياها ما كانوا فيه من الباطل، وقرا: {واجتنبوا قول الزور} [الحج: ] "
 
  الوجه التاسع
 
    
 حدثنا ابي، ثنا احمد بن ابراهيم الدورقي، ثنا محمد بن يزيد الواسطي، عن رجل، عن الحسن: " {والذين لا يشهدون الزور} [الفرقان: ] قال: الغناء والنياحة، لا يحرك له سمعه ولا يرتاح له قلبه ولا يشتهيه "
 
  قوله تعالي {واذا مروا باللغو} 
 [الفرقان: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو الحسين العكلي، عن محمد بن مسلم، اخبرني ابراهيم بن ميسرة، ان ابن مسعود، مر بلهو فلم يقف فقال رسول الله صلي الله عليه وسلم: «لقد اصبح ابن ام عبد او امسي كريما»
 
    
 حدثنا الحسن بن محمد بن سلمة النحوي، ثنا حبان، انبا عبد الله، انبا محمد بن مسلم، اخبرني ابراهيم بن ميسرة، قال: بلغني، ان ابن مسعود مر بلهو معرضا فقال رسول الله صلي الله عليه وسلم: «لقد اصبح ابن مسعود او امسي كريما» . ثم تلا ابراهيم بن ميسرة: {واذا مروا باللغو مروا كراما} [الفرقان: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو الحسين العكلي، عن قيس، عن اسماعيل بن سلمان، عن ابي عمر البزار، عن ابن الحنفية: " {واذا مروا باللغو مروا كراما} [الفرقان: ] قال: اللغو "
 
  والوجه الثاني
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو خالد، وعبدة، عن جويبر، عن الضحاك: " {واذا مروا باللغو} [الفرقان: ] قال: بالشرك "
 
  والوجه الثالث
 
    
 حدثنا ابي، ثنا ابو سلمة، عن هشيم، عن العوام، عن مجاهد: " {واذا مروا باللغو مروا كراما} [الفرقان: ] اذا اتوا علي ذكر النكاح كنوا عنه "
 
    
 حدثنا ابي، ثنا احمد بن ابراهيم الدورقي، ثنا عثمان بن اليمان، عن ابي عون، عن عمرو بن قيس الملاءي: " {واذا مروا باللغو مروا كراما} [الفرقان: ] في كلامهم كنوا عنه "
 
  الوجه الرابع
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: " {واذا مروا باللغو مروا كراما} [الفرقان: ] "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: " {واذا مروا باللغو مروا كراما} [الفرقان: ] قال: اللغو الباطل والوقيعة من المشركين في المسلمين "
 
  قوله تعالي {مروا كراما} 
 [الفرقان: ]
 
    
 حدثنا حجاج بن حمزة العجلي، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {واذا مروا باللغو مروا كراما} [الفرقان: ] قال: صفحوا "
 
    
 حدثنا علي بن الحسين، ثنا عمرو بن علي، ثنا المعتمر بن سليمان، عن ابيه، عن سيار ابي الحكم: " {واذا مروا باللغو مروا كراما} [الفرقان: ] كنوا عنه "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: قوله: " {مروا كراما} [الفرقان: ] قال: يعرضون عنهم لا يكلمونهم "
 
  قوله تعالي {والذين اذا ذكروا} 
 [الفرقان: ]
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {والذين اذا ذكروا بايات ربهم} [الفرقان: ] قال: هءلاء المهاجرون "
 
  قوله تعالي {بايات ربهم} 
 [الانفال: ]
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {والذين اذا ذكروا بايات ربهم} [الفرقان: ] يقول: انتفعوا بما سمعوا من كتاب الله "
 
  قوله تعالي {لم يخروا عليها صما وعميانا} 
 [الفرقان: ]
 
    
 حدثنا الحجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {لم يخروا عليها صما وعميانا} [الفرقان: ] لم يسمعوا ولم يبصروا ولم يفقهوا حقا "
 
    
 حدثنا محمد بن يحيي، انبا العباس، ثنا يزيد، ثنا سعيد، عن قتادة: قوله: " {والذين اذا ذكروا بايات ربهم لم يخروا عليها صما وعميانا} [الفرقان: ] يقول لم يصموا، عن الحق ولم يعموا فيه، هم والله قوم عقلوا عن الله وانتفعوا بما سمعوا من كتاب الله "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط: قوله: " {والذين اذا ذكروا بايات ربهم لم يخروا عليها صما وعميانا} [الفرقان: ] يقول: صموا عنها وعموا عنها "
 
    
 حدثنا المنذر بن شاذان، ثنا احمد بن اسحاق، ثنا ابو الاشهب، قال الحسن في قوله: " {والذين اذا ذكروا بايات ربهم لم يخروا عليها صما وعميانا} [الفرقان: ] قال كم من رجل يقرءه ويخر عليها اصم واعمي "
 
    
 حدثنا اسيد بن عاصم، ثنا عبد الله بن حمران، ثنا ابن عون، قال: سالت الشعبي قلت: الرجل يري القوم سجدوا ولم يسمع ما سجدوا ايسجد معهم؟ قال: فتلا هذه الاية: " {والذين اذا ذكروا بايات ربهم لم يخروا عليها صما وعميانا} [الفرقان: ] "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي انبا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد، في قول الله: " {والذين اذا ذكروا بايات ربهم لم يخروا عليها صما وعميانا} [الفرقان: ] قال: هذا مثل ضربه الله لهم لم يدعوها الي غيرها، وقرا: {انما المءمنون الذين اذا ذكر الله وجلت قلوبهم "} [الانفال: ] الاية "
 
  قوله تعالي {والذين يقولون ربنا هب لنا من ازواجنا} [الفرقان: ] الاية
 
    
 حدثنا ابي، ثنا نعيم بن حماد، وعبدة بن سليمان، قالا: ثنا ابن المبارك، ثنا صفوان بن عمرو، اخبرني عبد الرحمن بن جبير بن نفير، عن ابيه، قال: جلسنا الي المقداد بن الاسود يوما فمر به رجل فقال: طوبي لهاتين العينين اللتين راتا رسول الله صلي الله عليه وسلم والله لوددنا انا راينا ما رايت وشهدنا ما شهدت فاستغضب المقداد فجعلت اعجب من غضبه فقلت: والله ما قال الا خيرا ثم اقبل عليه فقال: " ما بال الرجل يتمني محضرا غيب عنه لو شهده كيف يكون فيه، والله لقد حضر رسول الله صلي الله عليه وسلم اقوام اكبهم الله علي مناخرهم في جهنم لم يجيبوه ولم يصدقوه. اولا تحمدون ربكم اذ اخرجكم الله لا تعرفون الا ربكم مصدقين بما جاء به نبيكم فقد كفيتم البلاء؟ والله لقد بعث نبيكم علي اشد حال بعث عليه نبي من الانبياء في فترة وجاهلية ما يرون ان دينا افضل من عبادة الاوثان فجاء بفرقان فرق بين الحق والباطل وفرق بين الوالد وولده، حتي ان الرجل ليري والده او ولده او اخاه كافرا وقد فتح الله قفل قلبه للايمان فيعلم انه ان هلك دخل النار فلا تقر عينه وهو يعلم ان حبيبه في النار وانها للتي قال الله: {والذين يقولون ربنا هب لنا من ازواجنا وذرياتنا قرة اعين} [الفرقان: ] "
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {ربنا هب لنا من ازواجنا وذرياتنا قرة اعين} [الفرقان: ] ، يعنون: من يعمل بالطاعة فتقر به اعيننا في الدنيا والاخرة "
 
    
 حدثنا ابو عبد الله محمد بن حماد الطهراني انبا حفص بن عمر، ثنا الحكم بن ابان، عن عكرمة، في قوله: " {هب لنا من ازواجنا وذرياتنا قرة اعين} [الفرقان: ] لم يريدوا بذلك صاحبة ولا جمالا ولكن ارادوا ان يكونوا مطيعين "
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا مسدد، ثنا يحيي، عن حزم القطعي، قال: سمعت كثير بن زياد، قال للحسن: يا ابا سعيد قول الله: " {هب لنا من ازواجنا وذرياتنا قرة اعين} [الفرقان: ] ما هذه القرة الاعين افي الدنيا ام في الاخرة؟ قال: لا والله بل في الدنيا قال: فما هي؟ قال: ان يري الله العبد المسلم من زوجته، من اخيه، من ولده، من حميمه طاعة الله، لا والله ما شء اقر لعين المسلم من ان يري والدا او ولدا او اخا او حميما مطيعا لله "
 
  قوله تعالي {واجعلنا للمتقين} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {للمتقين} [الفرقان: ] يعني: الذين يتقون الشرك "
 
  قوله تعالي {اماما} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {واجعلنا للمتقين اماما} [الفرقان: ] يقول: اءمة هدي ليهتدي بنا ولا تجعلنا اءمة ضلالة؛ لانه قال لاهل السعادة: {وجعلناهم اءمة يهدون بامرنا} [الانبياء: ] ولاهل الشقاوة {وجعلناهم اءمة يدعون الي النار} [القصص: ] «وروي عن ابي صالح وعبد الله بن شوذب نحو ذلك»
 
    
 حدثنا محمد بن يزيد المقرء، ثنا سفيان، عن ابن ابي نجيح، عن مجاهد، في قوله: " {واجعلنا للمتقين اماما} [الفرقان: ] قال: يءتم بهم ويقتدي بهم حين يقتدي بنا من بعدنا "
 
    
 حدثنا ابي، ثنا عبد الرحمن بن يحيي بن اسماعيل، ثنا الوليد بن جابر، قال: سالت مكحولا عن قول الله: " {واجعلنا للمتقين اماما} [الفرقان: ] قال: اءمة في التقوي حتي ناتم بمن كان قبلنا وياتم بنا من بعدنا "، وروي عن الحسن، وقتادة، والربيع بن انس، والسدي نحو ذلك
 
    
 حدثنا ابي، ثنا محمد بن سعيد بن الوليد الخزاعي، ثنا وكيع، عن النضر بن عربي، عن عكرمة، في قوله: " {واجعلنا للمتقين اماما} [الفرقان: ] قال: مثالا "
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني عبد الله بن لهيعة، حدثني عطاء، عن سعيد بن جبير، في قول الله: " {واجعلنا للمتقين اماما} [الفرقان: ] يعني: اجعلنا اءمة في الخير نعبدك ربنا. فاخبر بثوابهم "
 
    
 حدثنا علي بن الحسين، ثنا يحيي بن ايوب الزاهد، قال: سمعت ابا حفص الابار، يقول: قلت للسدي: رايتك في المنام كانك تءم الناس. قال: فقال: ان " قوله: {واجعلنا للمتقين اماما} [الفرقان: ] ليس ان يءم الرجل الناس، انما قالوا: اجعلنا اءمة لهم في الحلال والحرام يقتدون بنا فيه "
 
    
 حدثنا علي بن الحسين، ثنا عبد الله بن عامر بن زرارة الحضرمي، ثنا سعيد بن خثيم، عن القاسم بن الارقم، قال: قلت لجعفر بن محمد: يقول الرجل في الصلاة: اللهم اجعلني للمتقين اماما قال: «نعم وتدري ما ذاك؟» قال: قلت: لا، قال: يقول: «اللهم اجعلني في المسلمين رضيا، واذا قلت صدقوني وقبلوا ذاك مني»
 
  قوله تعالي {اولءك} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني ابن لهيعة، حدثني عطاء، عن سعيد بن جبير، في قول الله: " {اولءك} [الفرقان: ] يعني: الذين في هءلاء الايات، وفي قوله: {يجزون} [الفرقان: ] يعني: في الاخرة "
 
  قوله تعالي {الغرفة} 
 [الفرقان: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو خالد، عن جويبر، عن الضحاك: " {اولءك يجزون الغرفة} [الفرقان: ] قال: الغرفة الجنة " وروي عن سعيد بن جبير، وابي جعفر محمد بن علي والسدي مثل ذلك
 
  قوله تعالي {بما صبروا} 
 [الاعراف: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {بما صبروا} [الفرقان: ] علي امر ربهم "
 
    
 حدثنا ابي، ثنا عبدة بن سليمان، ثنا ابو الربيع الصوفي، عن ابي حمزة الثمالي، عن ابي جعفر، في قول: " {اولءك يجزون الغرفة بما صبروا} [الفرقان: ] علي الفقر في الدنيا "
 
  قوله تعالي {ويلقون فيها} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا يحيي بن المغيرة، ثنا جرير، عن الاعمش، عن مجاهد يعني: قوله: " {ويلقون فيها} [الفرقان: ] قال: تتلقاهم الملاءكة الذين كانوا قرناءهم في الدنيا يوم القيامة "
 
    
 حدثنا ابو زرعة، ثنا يحيي، حدثني ابن لهيعة، حدثني عطاء، عن سعيد، في قول الله: " {ويلقون فيها} [الفرقان: ] يعني: تتلقاهم الملاءكة "
 
  قوله تعالي {تحية وسلاما} 
 [الفرقان: ]
 
    
 به عن سعيد، في قول الله: " {ويلقون فيها تحية وسلاما} [الفرقان: ] يعني: تتلقاهم الملاءكة بالتحية والسلام "
 
    
 حدثنا علي بن حرب الموصلي، ثنا ابو داود الحضري، عن سفيان، عن عاصم، قال: لقي ابن سيرين رجل فقال: حياك الله فقال: ان «افضل التحية تحية اهل الجنة السلام»
 
  قوله تعالي {خالدين فيها حسنت مستقرا ومقاما} 
 [الفرقان: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي، حدثني ابن لهيعة، حدثني عطاء، عن سعيد، في قول الله: " {خالدين فيها} [الفرقان: ] يعني: لا يموتون، قوله: {حسنت مستقرا} [الفرقان: ] يعني مستقرهم في الجنة وقوله: {ومقاما} [الفرقان: ] يعني مقام اهل الجنة "
 
  قوله تعالي {قل ما يعبا بكم ربي} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا عبدة، ثنا مصعب يعني: ابن ماهان، عن سفيان، عن ابي يعلي، عن عمرو بن شعيب، في قوله: " {قل ما يعبا بكم ربي} [الفرقان: ] قال: ما يصنع بكم ربي "
 
    
 حدثنا ابي، ثنا ادم، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {قل ما يعبا بكم ربي} [الفرقان: ] يقول: ما يفعل بكم ربي "
 
  قوله تعالي {لولا دعاءكم} 
 [الفرقان: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {لولا دعاءكم} [الفرقان: ] يقول: لولا ايمانكم فاخبر الله الكفار انه لا حاجة له بهم اذ لم يخلقهم مءمنين ولو كان له بهم حاجة لحبب اليهم الايمان كما حببه الي المءمنين "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن شبل، عن ابن ابي نجيح، عن مجاهد: " {لولا دعاءكم} [الفرقان: ] قال: دعاءه اياكم لتعبدوه وتطيعوه "
 
    
 حدثني ابي، ثنا عبدة بن سليمان، ثنا مصعب بن ماهان، عن سفيان، عن ابي يعلي الثقفي، عن عمرو بن شعيب، في قوله: " {لولا دعاءكم} [الفرقان: ] قال: لولا ادعوكم الي الاسلام فتستجيبون لي "
 
  قوله تعالي {فقد كذبتم} 
 [الفرقان: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الطاهر، حدثني موسي بن ربيعة بن موسي بن سويد الجمحي، قال: سمعت الوليد بن ابي الوليد، يقول بلغني ان تفسير هذه الاية " {قل ما يعبا بكم ربي لولا دعاءكم فقد كذبتم} [الفرقان: ] ما خلقتكم لي بكم حاجة الا ان تسالوني فاغفر وتسالوني فاعطيكم "
 
    
 حدثنا علي بن الحسين، ثنا الهيثم بن يمان، ثنا رجل، سماه، عن السدي: " {فقد كذبتم} [الفرقان: ] يقول لقريش "
 
    
 حدثنا ابو زرعة، ثنا ابو الربيع الزهراني، ثنا ابو قتيبة، ثنا سعيد بن ادهم بن طريف السدوسي، قال: سمعت سلمان ابا عبد الله، قال: صليت خلف عبد الله بن الزبير فقرا «فقد كذب الكافرون فسوف يكون لزاما»
 
    
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ، عن عبيد بن سليمان، عن الضحاك، في قوله: " {فقد كذبتم} [الفرقان: ] الكفار كذبوا رسول الله صلي الله عليه وسلم فيما جاء به من عند الله "
 
  قوله تعالي {فسوف يكون لزاما} 
 [الفرقان: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله، عن اسراءيل، عن السدي، عن ابي مالك: " {فسوف يكون لزاما} [الفرقان: ] يوم بدر " وروي عن ابي بن كعب، وعبد الله بن مسعود، ومحمد بن كعب القرظي، ومجاهد، وقتادة، والضحاك نحو ذلك 
 
  والوجه الثاني
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: " {فسوف يكون لزاما} [الفرقان: ] قال: كان الحسن يقول: ذلك يوم القيامة "
 
  والوجه الثالث
 
    
 حدثنا ابي، ثنا يحيي بن صالح الوحاظي، ثنا ابو معشر، عن محمد بن كعب، في قوله: " {لزاما} [طه: ] قال: موتا "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: قوله: " {يكون لزاما} [الفرقان: ] قال: اللزام القتل الذي اصابهم يوم بدر "
 
    
 حدثنا علي بن الحسين، ثنا الهيثم بن يمان، ثنا رجل، سماه، عن السدي: " {فسوف يكون لزاما} [الفرقان: ] يقول: عذابا، فكان يوم بدر العذاب "
 
  سورة الشعراء
 
  قوله عز وجل: {طسم} 
 [الشعراء: ]
 
    
 حدثنا ابي، ثنا ابو صالح كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {طسم} [الشعراء: ] قال: انه قسم اقسمه الله وهي من اسماء الله "
 
    
 حدثنا علي بن الحسين، ثنا المقدسي، ثنا رجل، سماه، ثنا محمد بن اسحاق، عن محمد بن كعب، " {طسم} [الشعراء: ] قال: الطاء من الطول، والسين من القدوس، والميم من الرحمن " قال السدي: «هذه حروف من الهجاء من الاسماء المقطعة» وروي عن مجاهد انه هجاء مقطوع
 
  والوجه الثاني
 
    
 حدثنا علي بن الحسين، ثنا اسماعيل بن موسي، ثنا سفيان بن عيينة، عن ابي بكر الهذلي، قال: لقد رايت الحسن البصري قصر عن التفسير حين قدم عكرمة البصرة، فاتيت الحسن يوما في منزله فوجدته يصلي، فقعدت مع ابنه حتي قضي صلاته، فلما قضي اتيته فقلت: يا ابا سعيد قول الله عز وجل في كتابه: " {طسم} [الشعراء: ] ؟ قال: فواتح افتتح الله بها كتابه او القران "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: قوله: " {طسم} [الشعراء: ] قال: اسم من اسماء القران اقسم به ربك "
 
  قوله {تلك} 
 [البقرة: ]
 
    
 حدثنا موسي بن ابي موسي الانصاري، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، ثنا اسباط، عن السدي، عن ابي مالك: قوله: " {تلك} [الشعراء: ] يعني: هذه "
 
  قوله: {ايات} 
 [البقرة: ]
 
    
 حدثنا علي بن الحسين، ثنا علي بن زنجة، ثنا علي بن الحسين، عن الحسين بن واقد، عن مطر، " {تلك ايات} [الشعراء: ] قال: الزبور "
 
  قوله {الكتاب} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني ابن لهيعة، حدثني عطاء، عن سعيد بن جبير، في قول الله: " {الكتاب} [الشعراء: ] يعني: القران "، وروي عن ابن عباس، والحسن البصري مثل ذلك
 
  والوجه الثاني
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا ابن السماك، عن ابي بكر، عن الحسن، في هذه الاية " {تلك ايات الكتاب} [الشعراء: ] قال: التوراة والزبور "
 
 حدثنا علي بن الحسن الهسنجاني، ثنا ابو الجماهر، وثنا سعيد يعني: ابن بشير، عن قتادة " {طسم تلك ايات الكتاب} [الشعراء: ] قال: الكتب التي خلت قبل القران {المبين} [الشعراء: ] قال: اي والله تبين بركته وهداه ورشده "
 
  قوله تعالي {لعلك} 
 [طه: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني ابن لهيعة، حدثني عطاء، عن سعيد بن جبير: قوله: " {لعلك} [الشعراء: ] يعني: لكي "
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله بن موسي، عن اسراءيل، عن ابي يحيي، عن مجاهد، في قوله " {لعلك باخع نفسك} [الشعراء: ] قال: قاتل نفسك ". وروي عن الحسن، وعكرمة، وقتادة، وعطية، والضحاك مثل ذلك
 
    
 حدثنا علي بن الحسين، ثنا نصر بن علي، قال: سالت الاصمعي عن حديث النبي صلي الله عليه وسلم اتاكم اهل اليمن فقال: افصح، فقلت: ان ابا احمد الزبيري حدثني عن اسراءيل، عن ابي يحيي، عن مجاهد " {لعلك باخع نفسك} [الشعراء: ] قال: قاتل نفسك، قال: هذا الذي قلت لك بلغت بهم النصيحة حتي قتلوا انفسهم "
 
    
 اخبرنا العباس بن الوليد بن مزيد البيروتي قراءة، اخبرني محمد بن شعيب بن شابور، اخبرني عثمان بن عطاء، عن ابيه عطاء بن ابي مسلم الخراساني " اما {لعلك باخع نفسك} [الشعراء: ] فيقال: فلعلك مخرج نفسك وقاتلها "
 
    
 حدثنا عبد الله بن سليمان بن الاشعث، ثنا الحسين بن علي بن مهران، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: قوله: " {لعلك باخع نفسك} [الشعراء: ] قال: قاتل نفسك حزنا ان لم يءمنوا "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قوله: " {لعلك باخع نفسك الا يكونوا مءمنين} [الشعراء: ] قال: لعلك من الحرص علي ايمانهم مخرج نفسك من جسدك "
 
  قوله: {الا يكونوا مءمنين} 
 [الشعراء: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: قوله: " {ان الذين كفروا سواء عليهم اانذرتهم ام لم تنذرهم لا يءمنون} [البقرة: ] وقوله: {ولو شاء الله لجمعهم علي الهدي} [الانعام: ] وقوله: {فمن يرد الله ان يهديه يشرح صدره للاسلام، ومن يرد ان يضله يجعل صدره ضيقا حرجا} [الانعام: ] وقوله: {ما كانوا ليءمنوا الا ان يشاء الله} [الانعام: ] قوله: {ولو شءنا لاتينا كل نفس هداها} [السجدة: ] وقوله: {ولو شاء ربك لامن من في الارض كلهم جميعا} [يونس: ] وقوله: {جعلنا في اعناقهم اغلالا} [يس: ] وقوله: {من اغفلنا قلبه عن ذكرنا} [الكهف: ] وقوله: {انك لا تسمع الموتي} [النمل: ] وقوله: {انك لا تهدي من احببت ولكن الله يهدي من يشاء} [القصص: ] ونحو هذا من القران فان رسول الله صلي الله عليه وسلم كان يحرص ان يءمن جميع الناس ويتبعوه علي الهدي، فاخبره الله انه لا يءمن الا من سبق له من الله السعادة في الذكر الاول ولا يضل الا من سبق له من الله الشقاء في الذكر الاول "
 
  قوله: {ان نشا ننزل عليهم من السماء اية} 
 [الشعراء: ]
 
    
 حدثنا ابي، ثنا هشام بن عمارة، ثنا الوليد، ثنا سعيد، عن قتادة، في قوله: " {ان نشا ننزل عليهم من السماء اية} [الشعراء: ] قال: لو نشاء
 
  قوله: {من السماء اية} 
 [الشعراء: ]
 
 حدثنا ابي، ثنا محمد بن كثير، عن زاذان في قوله: " {ننزل عليهم من السماء} [الشعراء: ] : الشمس من مغربها "
 
  قوله {فظلت اعناقهم} 
 [الشعراء: ]
 
    
 حدثنا ابي، ثنا هشام بن عمار، ثنا الوليد، عن سعيد، عن قتادة، " {فظلت اعناقهم لها خاضعين} [الشعراء: ] حتي لا يلتفت احد الي معصية "
 
    
 اخبرنا ابو عبد الله محمد بن حماد الطهراني فيما كتب الي، انا عبد الرزاق، عن معمر، عن قتادة، " {فظلت اعناقهم لها خاضعين} [الشعراء: ] قال: لو شاء الله انزل عليهم ايه يذلون بها فلا يلوي احد منهم عنقه الي معصية الله "
 
  قوله تعالي {خاضعين} 
 [الشعراء: ]
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ، قال: سمعت عبد الرحمن بن زيد، في قوله تعالي: " {فظلت اعناقهم لها خاضعين} [الشعراء: ] قال: الخاضع الذليل قوله: {وما ياتيهم من ذكر من الرحمن محدث الا كانوا عنه معرضين} [الشعراء: ] "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد النرسي، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، " {وما ياتيهم من ذكر من الرحمن محدث} [الشعراء: ] يقول: ما ياتيهم من شء من كتاب الله {الا كانوا عنه معرضين} [الشعراء: ] يقول: الا اعرضوا عنه، وفي قوله: {فقد كذبوا فسياتيهم انباء} [الشعراء: ] يعني: يوم القيامة {ما كانوا به يستهزءون} [الشعراء: ] يقول: انباء ما استهزءوا به من كتاب الله عز وجل "
 
  قوله {اولم يروا الي الارض كم انبتنا فيها من كل زوج كريم} 
 [الشعراء: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {من كل زوج كريم} [الشعراء: ] قال: من نبات الارض مما ياكل الناس والانعام "
 
  الوجه الثاني
 
 حدثنا ابي، ثنا قبيصة، ثنا سفيان، عن رجل، عن الشعبي، في قوله: " {كم انبتنا فيها من كل زوج كريم} [الشعراء: ] قال: الناس من نبات الارض فمن دخل الجنة فهو كريم، ومن دخل النار فهو لءيم "
 
  قوله {كريم} 
 [الانفال: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني ابن لهيعة، حدثني عطاء، عن سعيد بن جبير: قوله: " {كريم} [الشعراء: ] يعني: حسنا " وروي عن قتادة مثل ذلك
 
  قوله تعالي {ان في ذلك لاية} 
 [البقرة: ]
 
    
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا ابو اسامة، ثنا سفيان، عن سماك، عن سعيد بن جبير، عن ابن عباس، " {ان في ذلك لاية} [الشعراء: ] قال: علامة، الم تر الي الرجل اذا اراد ان يرسل الي اهله في حاجة ارسل بخاتمه او بثوبه فعرفوا انه حق " وروي عن سعيد بن جبير نحو ذلك
 
  قوله: {وما كان اكثرهم مءمنين} 
 [الشعراء: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي، حدثنا ابن لهيعة، حدثني عطاء، عن سعيد بن جبير: قوله: " {مءمنين} [الشعراء: ] يعني: مصدقين "
 
  قوله {وان ربك لهو العزيز} 
 [الشعراء: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع بن انس، عن ابي العالية، " {العزيز} [الشعراء: ] قال: عزيز في نقمته اذا انتقم "، وروي عن قتادة، والربيع بن انس نحو ذلك
 
    
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا مسلمة، قال محمد بن اسحاق " {العزيز} [الشعراء: ] قال: العزيز في نصرته ممن كفر به اذا شاء "
 
  قوله {الرحيم} 
 [الفاتحة: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي، حدثني ابن لهيعة، حدثني عطاء، عن سعيد، في قول الله: " {الرحيم} [الشعراء: ] يعني: رحيما بهم بعد التوبة "
 
  قوله {واذ نادي ربك موسي} 
 [الشعراء: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي، " {واذ نادي ربك موسي} [الشعراء: ] قال: حين نودي من جانب الطور الايمن "
 
  قوله {ان اءت القوم الظالمين} 
 [الشعراء: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، " {الظالمين} [الشعراء: ] يقول: الكافرين "
 
  قوله {قوم فرعون الا يتقون} 
 [الشعراء: ]
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، قال: «خرج موسي وتبعهم فرعون علي مقدمته هامان في الف الف وسبعماءة الف حصان ليس فيها ماذيانة»
 
  قوله تعالي {قال: رب اني اخاف ان يكذبون} [الشعراء: ] الي قوله: {ينطلق لساني} 
 [الشعراء: ]
 
    
 حدثنا محمد بن عبد الله بن ابي الثلج، انبا يزيد بن هارون، انبا اصبغ بن زيد، ثنا القاسم بن ابي ايوب، ثنا سعيد بن جبير، عن ابن عباس، قال: " شكي موسي الي ربه ما يتخوف من ال فرعون في القتيل، وعقدة لسانه فانه كان في لسانه عقدة تمنعه من كثير الكلام، فاتاه الله سءله فحل عقدة لسانه وفي قوله: {فارسل الي هارون} [الشعراء: ] قال: سال ربه ان يعينه باخيه هارون يكون له ردءا ويتكلم عنه بكثير مما لا يفصح به لسانه "
 
  قوله: {ولهم علي ذنب} 
 [الشعراء: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {ولهم علي ذنب فاخاف ان يقتلون} [الشعراء: ] قال: قتل النفس التي قتل فيهم "
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا ابن زريع، ثنا سعيد، عن قتادة: قوله: " {ولهم علي ذنب} [الشعراء: ] يعني: النفس التي قتل "
 
  قوله {فاخاف ان يقتلون} 
 [الشعراء: ]
 
    
 حدثنا عمار بن خالد الواسطي، حدثنا محمد بن الحسن، ويزيد بن هارون، عن اصبغ بن زيد، عن القاسم بن ابي ايوب، حدثني سعيد بن جبير، عن ابن عباس يعني: قوله: " {فاخاف ان يقتلون} [الشعراء: ] قال: شكي موسي  صلي الله عليه وسلم  الي ربه ما يتخوف من ال فرعون في القتيل "
 
  قوله {كلا فاذهبا باياتنا} 
 [الشعراء: ]
 
    
 حدثنا ابي، ثنا سعيد بن داود، حدثني حجاج، عن ابي معشر، عن محمد بن كعب، يعني قوله: " {قال كلا} [الشعراء: ] قال: يقول الجبار عز وجل: كلا "
 
  قوله {انا معكم مستمعون} 
 [الشعراء: ]
 
    
 حدثنا ابو عبد الله الطهراني محمد بن حماد فيما كتب الي، اخبرنا اسماعيل بن عبد الكريم، عن عبد الصمد بن معقل، قال: سمعت وهبا، يقول: " قال لموسي يعني ربه عز وجل: اني قد اقمتك اليوم في مقام لا ينبغي لبشر بعدك ان يقوم مقامك ادنيتك وقربتك حتي سمعت كلامي وكنت باقرب الامكنة مني فانطلق برسالتي فانك بعيني وسمعي، وان معك يدي وبصري. قوله تعالي: {فاتيا فرعون فقولا انا رسول رب العالمين} [الشعراء: ] "
 
    
 حدثنا محمد بن عمار بن الحارث، ثنا سهل بن بكار، ثنا ابو عوانة، عن يزيد بن ابي زياد، عن مقسم، عن ابن عباس، قال: " لقد دخل موسي علي فرعون وعليه زرمانقة من صوف ما يجاوز يديها مرفقه فاستءذن علي فرعون فقال: ادخلوه، فدخل فقال: ان الهي ارسلني اليك، فقال: للقوم حوله {ما علمت لكم من اله غيري} [القصص: ] قال: خذوه "
 
    
 حدثنا عمار بن خالد الواسطي، ثنا محمد بن الحسن الواسطي، ويزيد بن هارون، واللفظ لمحمد، عن اصبغ بن زيد الوراق، عن القاسم بن ابي ايوب، حدثني سعيد بن جبير، عن ابن عباس، قال: " فانطلقا جميعا فاقاما علي بابه حينا لا يءذن لهما ثم اذن لهما بعد حجاب شديد، فقالا: {انا رسولا ربك} [طه: ] ، {قال فمن ربكما يا موسي} [طه: ] فاخبراه الذي قص الله عز وجل في القران " وذكر ايضا عن السدي: " لما نزل موسي علي امه بمصر ليلة الطفشيل ذهب هو وهارون. وقد كتب غير مرة، وذكر ايضا غير ذلك في موضع اخر
 
  قوله {ان ارسل معنا بني اسراءيل} 
 [الشعراء: ]
 
    
