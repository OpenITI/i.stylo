  قوله تعالي: {ولو كنت اعلم الغيب} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {ولو كنت اعلم الغيب لاستكثرت من الخير} [الاعراف: ] ، قال: لعلمت اذا اشتريت شيءا ما اربح فيه فلا ابيع شيءا الا ربحت فيه ولا يصيبني الفقر "
 
 حدثنا ابو بكر محمد بن القاسم بن عطية، ثنا الحسن بن داود بن محمد بن المنكدر، ثنا عبد الرزاق، انبا الثوري، عن منصور، عن مجاهد، في قوله: " {ولو كنت اعلم الغيب لاستكثرت من الخير} [الاعراف: ] ، قال: ولو كنت اعلم متي اموت لعملت عملا صالحا "
 
  قوله تعالي: {لاستكثرت من الخير} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا محمد بن عمران بن محمد بن عبد الرحمن بن ابي ليلي، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {ولو كنت اعلم الغيب لاستكثرت من الخير} [الاعراف: ] من المال "
 
  قوله تعالي: {وما مسني السوء} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر، عن ابي روق، عن الضحاك، عن ابن عباس، قال: " {وما مسني السوء} [الاعراف: ] ، قال: «الفقر»
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {وما مسني السوء} [الاعراف: ] ، قال: لاجتنبت ما يكون من الشر قبل ان يكون واتقيه "
 
  قوله تعالي: {ان انا الا نذير} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا عبد الرحمن بن صالح، ثنا عبد الرحمن بن محمد بن عبيد الله الفزاري، عن شيبان النحوي، اخبرنا قتادة، عن عكرمة، عن ابن عباس، قوله: " {نذير} [الاعراف: ] ، قال: نذير من النار "
 
  قوله تعالي: {وبشير لقوم يءمنون} 
 [الاعراف: ]
 
 وبه عن ابن عباس، قوله: " {وبشير} [الاعراف: ] ، قال: بشر بالجنة "
 
  قوله تعالي: {هو الذي خلقكم من نفس واحدة} 
 [الاعراف: ]
 
 حدثنا ابو سعيد الاشج، ثنا ابو عبد الرحمن الحارثي، عن جويبر، عن الضحاك، " {خلقكم من نفس واحدة} [النساء: ] ، قال: يعني ادم صلي الله عليه وسلم " وروي عن مجاهد، وابي مالك، وقتادة، والسدي، ومقاتل بن حيان نحو ذلك
 
  قوله تعالي: {وجعل منها زوجها} 
 [الاعراف: ]
 
 حدثنا ابو سعيد الاشج، ثنا ابو عبد الرحمن الحارثي، عن جويبر، عن الضحاك، " {وخلق منها زوجها} [النساء: ] ، قال: خلق حواء من ادم من ضلع الخلف وهو من اسفل الاضلاع " وروي عن مقاتل بن حيان، وقتادة نحو ذلك
 
  قوله تعالي: {زوجها} 
 [النساء: ]
 
 حدثنا ابي، ثنا مقاتل بن محمد، ثنا وكيع، عن ابي هلال، عن قتادة، عن ابن عباس، يعني قوله: " {منها زوجها} [الاعراف: ] ، قال: خلقت المراة من الرجل فجعل نهمتها في الرجل، وخلق الرجل من الارض فجعل نهمته في الارض فاحبسوا نساءكم "
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {منها زوجها} [الاعراف: ] ، قال: حواء من قصيري ادم وهو ناءم فاستيقظ، فقال: اثا؟ بالنبطية امراة " وروي عن السدي، وقتادة، ومقاتل بن حيان انها حواء
 
  قوله تعالي: {ليسكن اليها} 
 [الاعراف: ]
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد، عن سعيد، عن قتادة، " {جعل منها زوجها} [الاعراف: ] ، قال: خلقت حواء من ضلع من اضلاعه ليسكن اليها "
 
  قوله تعالي {فلما تغشاها} 
 [الاعراف: ]
 
 حدثنا علي بن الحسين، ثنا محمد بن علي بن حمزة، ثنا حبان، عن عبد الله بن المبارك، عن شريك، عن خصيف، عن سعيد بن جبير، عن ابن عباس، " {فلما تغشاها} [الاعراف: ] ادم حملت "
 
  قوله تعالي: {حملت حملا خفيفا} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا هلال بن الفياض، ثنا عمر بن ابراهيم، عن قتادة، عن الحسن، عن سمرة، قال: قال رسول الله صلي الله عليه وسلم: «ان حواء لما حملت كان لا يعيش لها ولد» ، فقال لها الشيطان: سميه عبد الحارث فانه يعيش فسمته وكان ذلك من وحي الشيطان وامره فحملت حملا خفيفا ولم يستبن "
 
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني ابي، حدثني عمي الحسين، عن ابيه، عن جده، عن ابن عباس، قوله: " {فلما تغشاها حملت حملا خفيفا} [الاعراف: ] فشكت احملت ام لا "
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، قوله: " {فلما تغشاها حملت حملا خفيفا} [الاعراف: ] فاستبان حملها "
 
 حدثنا ابو زرعة، ثنا عمرو بن حماد بن طلحة، ثنا اسباط، عن السدي، قال: «فوقع علي حواء فحملت حملا خفيفا فمرت به وهي النطفة»
 
  قوله تعالي: {فمرت به} 
 [الاعراف: ]
 
 ثنا ابو زرعة، ثنا هلال بن الفياض، ثنا عمر بن ابراهيم، عن قتادة، عن الحسن، عن سمرة، قال: قال رسول الله صلي الله عليه وسلم: «ان حواء لما حملت كان لا يعيش لها ولد، فحملت حملا خفيفا» ، يقول: خفيفا لم يستبن فمرت به لما استبان حملها "
 
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن شبل، عن ابن ابي نجيح، عن مجاهد، " {فمرت به} [الاعراف: ] قال: فاستمرت بحملها " وروي عن الحسن، وابراهيم النخعي، والسدي، مثل ذلك
 
  والوجه الثاني
 
 حدثنا ابي، ثنا منصور بن ابي مزاحم، ثنا ابو سعيد هو ابن ابي الوضاح، عن عمرو بن ميمون بن مهران، عن ابيه، في قوله: " {فمرت به} [الاعراف: ] ، قال: استخفته "
 
  قوله تعالي: {فلما اثقلت} 
 [الاعراف: ]
 
 حدثنا محمد بن عمار، ثنا عبيد الله بن محمد بن عاءشة، ثنا عبد الواحد، ثنا سالم بن ابي حفصة، قال: سمعت سعيد بن جبير، يقول في هذه الاية: " {فلما اثقلت دعوا الله ربهما لءن اتيتنا صالحا} [الاعراف: ] ، قال: اهبط ادم، وحواء، وابليس الي الارض، قال: فدنا ادم من امراته، فوقعت في نفسه الشهوة فقام اليها فجامعها، فحملت وهي لا تعلم، فجعل بطنها يعظم، فقالت لادم: ما هذا الذي قد عظم له بطني، قال: فسمع ذلك ابليس، قال لها: انك قد حملت فتلدين "
 
  قوله تعالي: {دعوا الله ربهما} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا عمرو بن حماد بن طلحة، ثنا اسباط بن نصر، عن السدي، " {فلما اثقلت دعوا الله ربهما} [الاعراف: ] ، كبر الولد في بطنها، جاءها ابليس فخوفها وقال لها: ما يدريك ما في بطنك كلب او خنزير او حمار؟ وما يدريك من اين يخرج من دبرك فيقتلك، ام من قبلك ان ينشق بطنك فيقتلك؟ فذلك حين دعوا الله ربهما "
 
 حدثنا محمد بن عمار، ثنا عبيد الله بن محمد، ثنا عبد الواحد، ثنا سالم بن ابي حفصة، قال: سمعت سعيد بن جبير، يقول في هذه الاية: " {دعوا الله ربهما لءن اتيتنا صالحا} [الاعراف: ] فسمع ذلك ابليس قال لها: انك قد حملت فتلدين، قالت: وما الد؟ قال: بعض ما ترين بعيرا، بقرة، وضانية وماعزة، قال فهو قوله: {دعوا الله ربهما لءن اتيتنا صالحا} [الاعراف: ] لما تخوفهما به ابليس من البعير، والبقرة والضانية، والماعزة "
 
  قوله تعالي: {لءن اتيتنا صالحا} 
 [الاعراف: ]
 
 حدثنا ابو سعيد الاشج، ثنا محمود بن عبيد، عن اسماعيل، عن ابي صالح، " {لءن اتيتنا صالحا} [الاعراف: ] ، قال: اشفقنا ان تكون بهيمة " وروي عن ابي البحتري نحو ذلك
 
 حدثنا الاشج، ثنا ابن يمان، عن سفيان، عن ابن ابي نجيح، عن مجاهد، قال: «اشفقنا ان لا يكون انسانا» وروي عن ابي ملك مثل ذلك
 
 حدثنا ابي، ثنا سهل بن عثمان، ثنا مهران بن ابي عمر الرازي، عن ابن ابي خالد، عن ابي صالح، في هذه الاية " {لءن اتيتنا صالحا} [الاعراف: ] ، قال: خشينا ان يكون بهيمة، فقالا: لءن اتيتنا بشرا سويا "
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي الصنعاني، ثنا محمد بن ثور، عن معمر، قال: وقال الحسن: " {لءن اتيتنا صالحا} [الاعراف: ] ، قال: غلاما "
 
 حدثنا محمد بن عمار، ثنا عبيد الله بن محمد، ثنا عبد الواحد، ثنا سالم بن ابي حفصة، قال: سمعت سعيد بن جبير، في هذه الاية " {لءن اتيتنا صالحا} [الاعراف: ] مثل خلقنا {لنكونن من الشاكرين} [الاعراف: ] " وروي عن السدي مثل قول سعيد بن جبير
 
  قوله تعالي: {لنكونن من الشاكرين} 
 [الانعام: ]
 
 حدثنا علي بن الحسن الهسنجاني، ثنا ابو عمر الحوضي، ثنا خالد بن عبد الله، عن عطاء، عن سعيد بن جبير، عن ابن عباس، في هذه الاية يعني قوله: " {لءن اتيتنا صالحا لنكونن من الشاكرين} [الاعراف: ] ، قال: ما اشرك ادم ان ضربه لمن بعده "
 
  قوله تعالي: {فلما اتاهما صالحا جعلا له شركاء فيما اتاهما} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو الجماهر، انبا سعيد بن بشير، عن عقبة، عن قتادة، عن مجاهد، عن ابن عباس، عن ابي بن كعب، قال: " لما حملت حواء اتاها الشيطان، فقال: اتطيعيني ويسلم لك ولدك؟ سميه عبد الحارث، فلم تفعل فولدت فمات، ثم حملت، فقال لها مثل ذلك فلم تفعل، ثم حملت الثالث فجاءها فقال: ان تطيعيني يسلم، والا فانه يكون بهيمة فهيبهما فاطاعا "
 
 حدثنا علي بن الحسين، ثنا محمد بن علي بن حمزة، ثنا حبان، عن عبد الله بن المبارك، عن شريك، عن خصيف، عن سعيد بن جبير، عن ابن عباس، في قوله: " {فلما اتاهما صالحا جعلا له شركاء فيما اتاهما} [الاعراف: ] ، قال: الله هو الذي خلقكم من نفس واحدة، وجعل منها زوجها ليسكن اليها، فلما تغشاها ادم حملت اتاهما ابليس، فقال: اني صاحبكما الذي اخرجتكما من الجنة، لتطيعنن او لاجعلن لها قرني ابل فيخرج من بطنك فيشقه ولافعلن ولافعلن يخوفهما سمياه عبد الحارث، فابيا ان يطيعاه فخرج ميتا، ثم حملت يعني الثانية فاتاهما ايضا فقال: انا صاحبكما الذي فعلت ما فعلت لتفعلن او لافعلن ولافعلن يخوفهما فابيا ان يطيعانه فخرج ميتا، ثم حملت الثالثة فاتاهما ايضا فذكر لهما فادركهما حب الولد فسمياه عبد الحارث، فذلك قوله: {جعلا له شركاء فيما اتاهما} [الاعراف: ] "
 
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انبا ابن عيينة، قال: سمعت صدقة، قال ابي: يعني ابن عبد الله بن كثير المكي يحدث عن السدي، قال: " هذا من الموصول المفصل قول: " {جعلا له شركاء فيما اتاهما} [الاعراف: ] ، قال: شان ادم وحواء "
 
 حدثنا ابي، ثنا ابن ابي عمر، ثنا سفيان، عن الهذلي، عن السدي، في قوله: " {جعلا له شركاء فيما اتاهما} [الاعراف: ] ، قال: هو ادم وحواء "
 
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، يقول الله: " {جعلا له شركاء فيما اتاهما} [الاعراف: ] يعني في الاسماء "
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا معتمر بن سليمان، عن ابيه، ثنا بكر بن عبد الله المزني، " {جعلا له شركاء فيما اتاهما} [الاعراف: ] ، ان ادم سمي ابنه عبد الشيطان "
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، عن سعيد، عن قتادة، " {جعلا له شركاء فيما اتاهما} [الاعراف: ] «فكان شركا في طاعته، ولم يكن شركا في عبادته» وكان الحسن يقول: هم اليهود والنصاري رزقهم الله اولادا فهودوا ونصروا
 
  قوله تعالي: {فتعالي الله عما يشركون} 
 [الاعراف: ]
 
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انبا ابن عيينة، قال: سمعت
  [ص: ]
 صدقة، يحدث عن السدي، " {فتعالي الله عما يشركون} [الاعراف: ] ، يقول: عما اشرك المشركون، ولم يعنهما "
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {فتعالي الله عما يشركون} [الاعراف: ] ، قال: هذه فصل من اية ادم، خاصة في الهة العرب "
 
 حدثنا الحسين بن الحسن، ثنا ابراهيم بن عبد الله الهروي، ثنا حجاج، عن ابن جريج، عن مجاهد، " {فتعالي الله عما يشركون} [الاعراف: ] " هو الانتكاف انكف نفسه عز وجل يقول: عظم نفسه وانكفته الملاءكة وما سبح له "
 
 حدثنا علي بن الحسين، ثنا محمد بن ابي حماد، ثنا مهران، عن سفيان، عن السدي، عن ابي مالك، قال: " هذه مفصولة اطاعاه في الولد {فتعالي الله عما يشركون} [الاعراف: ] ، وقال: هذه لقوم محمد ابو مالك يقوله
 
  قوله تعالي: {ايشركون ما لا يخلق شيءا وهم يخلقون} 
 [الاعراف: ]
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول: " ولد لادم ولد فسماه عبد الله فاتاهما ابليس، فقال: ما سميتما ابنكما هذا انت يا ادم وانت يا حواء؟ قال: وكان ولد لهما قبل ذلك ولد فسمياه عبد الله، فقال ابليس: اتظنان ان الله تارك عبده عندكما؟ والله ليذهبن به كما ذهب بالاخر ولكن ادلكما علي اسم يبقي لكما ما بقيتما فسمياه عبد الشمس، فسمياه فذلك قوله تعالي: {ايشركون ما لا يخلق شيءا وهم يخلقون} [الاعراف: ] الشمس لا تخلق شيءا؟ انما هي مخلوقة، قال: وقال رسول الله صلي الله عليه وسلم خدعهما مرتين "، قال: «زيد خدعهما في الجنة، وخدعهما في الارض»
 
  قوله تعالي: {ولا يستطيعون لهم نصرا} 
 [الاعراف: ]
 
  قوله تعالي: {وان تدعوهم الي الهدي لا يتبعوكم} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قال: «ان اجاب من يدعوه الي الهدي اهتدي الي الطريق»
 
  قوله تعالي: {ان الذين تدعون من دون الله عباد امثالكم} 
 [الاعراف: ]
 
 حدثنا ابو سعيد الاشج، ثنا يحيي بن يمان، عن اشعث بن اسحاق القمي، عن جعفر بن ابي المغيرة، عن سعيد بن جبير، قال: " يجاء بالشمس والقمر يوم القيامة حتي يلقيان بين يدي الله، ويجاء بمن كان يعبدهما فيقال: {فادعوهم فليستجيبوا لكم ان كنتم صادقين} [الاعراف: ] "
 
  قوله تعالي: {الهم ارجل يمشون بها ام لهم ايد يبطشون بها} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا عبيد الله حمزة بن اسماعيل، انبا اسحاق بن سليمان، عن ابي سنان، عن عمرو بن مرة، عن ابي البحتري، عن سلمان الفارسي، قال: «القلوب اربعة، قلب اغلف فذلك قلب الكافر، وقلب منكوس فذلك قلب المنافق، وقلب مصفح فذاك قلب فيه ايمان ونفاق، فمثل الايمان كمثل البقلة يسقيها الماء، ومثل النفاق فيه كمثل القرحة يسقيها الصديد، فهما يقتتلان في جوفه فايتهما ما غلبت اكلت صاحبها حتي يصيره الله تعالي الي ما يصيره، وقلب اجرد فيه سراج وسراجه نوره وذلك قلب المءمن»
 
  قوله تعالي: {ان وليي الله الذي نزل الكتاب وهو يتولي الصالحين} 
 [الاعراف: ]
 
 اخبرنا محمد بن سعد العوفي، فيما كتب الي، حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، عن ابن عباس، قوله: " {نزل الكتاب} [الاعراف: ] هو القران "
 
 ذكر عن نصر بن علي، ويعقوب الدورقي، عن محمد بن مروان العقيلي، عن عمارة بن ابي حفصة، قال: " دخل مسلمة علي عمر بن عبد العزيز يعوده في مرضه الذي مات فيه، فقال: له من توصي باهلك؟ فقال: " اذا نسيت الله فذكرني، فاعاد عليه ثلاثا فقال: {ان وليي الله الذي نزل الكتاب وهو يتولي الصالحين} [الاعراف: ] "
 
  قوله تعالي: {والذين تدعون من دونه} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة، قوله: " {والذين تدعون من دونه} [الاعراف: ] ، قال: هذا الوثن "
 
  قوله تعالي: {وان تدعوهم الي الهدي} 
 [الاعراف: ]
 
 اخبرنا احمد بن عثمان، حكيم فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {وان تدعوهم الي الهدي} [الاعراف: ] لا يسمعوا دعاهم "
 
  قوله تعالي: {وتراهم ينظرون اليك} 
 [الاعراف: ]
 
 وبه الي السدي، قوله: " {وتراهم ينظرون اليك وهم لا يبصرون} [الاعراف: ] ، قال: هءلاء المشركون "
 
  قوله تعالي: {وهم لا يبصرون} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو حذيفة، ثنا شبل، عن ابن ابي نجيح، عن مجاهد، " {ينظرون اليك وهم لا يبصرون} [الاعراف: ] ما تدعوهم اليه من الهدي "
 
  قوله تعالي: {خذ العفو} 
 [الاعراف: ]
 
 حدثنا احمد بن سنان، ثنا ابو معاوية، ثنا هشام بن عروة، عن وهب بن كيسان، قال: سمعت عبد الله بن الزبير، علي المنبر يقول: " {خذ العفو} [الاعراف: ] وامر بالعرف واعرض عن الجاهلين والله ما امر بهما الا ان تءخذ لا من اخلاق الناس، والله لاخذنها منهم ما صحبتهم "
 
 حدثنا ابي، ثنا عمرو بن محمد الناقد، ثنا محمد بن عبد الرحمن الطفاوي ابو المنذر، عن هشام بن عروة، عن ابيه، عن ابن عمر، في قوله: " {خذ العفو} [الاعراف: ] ، قال: امر الله نبيه صلي الله عليه وسلم ان ياخذ العفو من اخلاق الناس "
 
 حدثنا ابي، ثنا عبد الله بن جعفر الرقي، ثنا عبد الله بن المبارك، عن ابن ابي ليلي، عن المنهال، عن سعيد بن جبير، عن ابن عباس، " {خذ العفو} [الاعراف: ] ، قال: الفضل "
 
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، ثنا شبل، عن ابن ابي نجيح، عن مجاهد، في قوله: " {خذ العفو} [الاعراف: ] خذ العفو من اخلاق الناس واعمالهم بغير تجسيس "
 
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {خذ العفو} [الاعراف: ] ، يقول: خذ الفضل، انفق الفضل " وروي عن عروة بن الزبير، قال: ما صفا لك من اخلاقهم
 
  والوجه الثاني
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، في قوله: " {خذ العفو وامر بالعرف} [الاعراف: ] ، يقول: خذ ما عفا لك من اموالهم ما اتوك به من شء فخذه، وكان هذا قبل ان تنزل براءة تفرض الصدقات وتفصيلها وما انتهت الصدقات اليها " وروي عن الضحاك نحو ذلك
 
  والوجه الثالث
 
 حدثنا ابي، ثنا علي بن ميسرة الهمداني، ثنا حجاج بن محمد، عن ابن جريج، قال: سالت عطاء، عن قوله: " {خذ العفو} [الاعراف: ] ، قال: ما لم يسرفوا "
 
  والوجه الرابع
 
 كتب الي، ابو يزيد القراطيسي، ثنا اصبغ، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {خذ العفو} [الاعراف: ] ، قال: عفا عن المشركين عشر سنين بمكة "
 
 اخبرنا يونس بن عبد الاعلي، قراءة، انبا سفيان، عن امي، قال: " لما انزل الله علي نبيه صلي الله عليه وسلم: {خذ العفو وامر بالعرف واعرض عن الجاهلين} [الاعراف: ] ، قال النبي صلي الله عليه وسلم: «ما هذا يا جبريل؟» ، قال: ان الله يامرك ان تعفو عمن ظلمك، وتعطي من حرمك وتصل من قطعك " اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت سفيان بن عيينة، عن امي، عن الشعبي، نحوه
 
  قوله تعالي: {وامر بالعرف} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قوله: " {وامر بالعرف} [الاعراف: ] ، يقول: بالمعروف " وروي عن عروة بن الزبير، والسدي، وسفيان الثوري نحو ذلك
 
  قوله تعالي: {واعرض عن الجاهلين} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو اليماني الحكم بن نافع، اخبرني شعيب، هو ابن ابي حمزة، عن الزهري، اخبرني عبيد الله بن عبد الله بن عتبة، ان عبد الله بن عباس، قال: قدم عيينة بن حصن بن حذيفة بن بدر، فنزل علي ابن اخيه الحر بن قيس بن حصن، وكان من النفر الذين يدينهم عمر بن الخطاب، فقال عيينة لابن اخيه: هل لك وجه عند هذا الامير فتستاذن لي عليه؟، فقال: ساستاذن لك عليه، قال ابن عباس: فاستاذن الحر لعيينة، فاذن له عمر فلما دخل عليه، قال: هيا ابن الخطاب والله ما تعطينا الجزل ولا تحكم بيننا بالعدل، فغضب عمر حتي هم ان يوقع به فقال له الحر: يا امير المءمنين ان الله قال لنبيه: {خذ العفو وامر بالعرف واعرض عن الجاهلين} [الاعراف: ] ، وان هذا من الجاهلين، قال: فوالله ما جاوزها حين تلاها وكان وقافا عند كتاب الله "
 
 حدثنا ابي، ثنا عبدة بن سليمان المروزي، بطرسوس، انبا ابن المبارك، انبا معمر، عن قتادة، قال: «الاعراض عن الناس ان يكلمك احد وانت معرض عنه وتتكبر»
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول في قول الله: " {خذ العفو وامر بالعرف واعرض عن الجاهلين} [الاعراف: ] ، قال: امره فاعرض عنهم عشر سنين، ثم امره بالجهاد "
 
 اخبرنا يونس بن عبد الاعلي، قراءة، انبا ابن وهب، اخبرني مالك بن انس، عن عبد الله بن نافع، ان سالم بن عبد الله، " مر علي عير لاهل الشام وفيها جرس، فقال: «ان هذا ينهي عنه» فقالوا: نحن اعلم بهذا منك، انما يكره الجلجل الكبير، فاما مثل هذا فلا باس به، فسكت سالم وقال: " {واعرض عن الجاهلين} [الاعراف: ] "
 
  قوله تعالي: {واما ينزغنك من الشيطان نزغ} 
 [الاعراف: ]
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد، ثنا سعيد، عن قتادة، قوله: " {واما ينزغنك من الشيطان نزغ فاستعذ بالله} [الاعراف: ] ، قال: علم الله ان هذا العدو مبتغي ومريد "
 
  قوله تعالي: {فاستعذ بالله} 
 [الاعراف: ]
 
 حدثنا ابو سعيد الاشج، ثنا ابن فضيل، عن عطاء بن السايب، عن ابي عبد الرحمن، عن عبد الله بن مسعود، عن النبي صلي الله عليه وسلم انه كان يقول: " اللهم اني اعوذ بك من الشيطان من همزه ونفثه ونفخه، قال: فهمزه الموتة، ونفثه الشعر، ونفخه الكبرياء "
 
 اخبرنا هاشم بن خالد بن ابي جميل الدمشقي، فيما كتب الي، قال: سمعت ابا سليمان الداراني، يقول: «لولا ان الله، تبارك وتعالي امرنا بالتعوذ من الشيطان ما تعوذت منه ابدا لانه لا يملك ضرا ولا نفعا» وكان ابو سليمان لا يذكر قبلها من الشيطان اتباعا لقول الله عز وجل
 
  قوله تعالي: {انه سميع عليم} 
 [الاعراف: ]
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو زنيج، ثنا سلمة، ثنا محمد بن اسحاق: " {انه سميع عليم} [الاعراف: ] اي سميع ما يقولون عليم بما يخفون "
 
  قوله تعالي: {ان الذين اتقوا} 
 [الاعراف: ]
 
 حدثنا الحسين بن الحسن، ثنا ابراهيم بن عبد الله الهروي، انبا حجاج، عن ابن جريج، عن مجاهد قوله: " {ان الذين اتقوا} [الاعراف: ] ، قال: هم المءمنون "
 
  قوله تعالي: {اذا مسهم طاءف من الشيطان} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {ان الذين اتقوا اذا مسهم طاءف من الشيطان تذكروا} [الاعراف: ] والطاءف اللمة {من الشيطان تذكروا فاذا هم مبصرون} [الاعراف: ] "
 
  الوجه الثاني
 
 حدثنا ابو عبد الله بن حماد الطهراني، انبا حفص بن عمر، ثنا الحكم بن ابان، عن عكرمة، قوله: " {ان الذين اتقوا اذا مسهم طاءف من الشيطان} [الاعراف: ] ، قال ابن عباس: الطاءف الغضب " وروي عن سعيد بن جبير، ومجاهد، وعبد الرحمن بن زيد بن اسلم نحو ذلك
 
  قوله تعالي: {تذكروا} 
 [الاعراف: ]
 
 ذكر عن الحسن بن فرقد، عن سليط بن عبد الله بن يسار، قال: سمعت عبد الله بن الزبير، يقول: " {اذا مسهم طاءف من الشيطان} [الاعراف: ] ، تاملوا "
 
 حدثنا علي بن الحسين، ثنا احمد بن الصباح، انبا محمد بن ربيعة، عن الحر بن جرموز، عن ابي نهشل، عن الضحاك، قوله: " {ان الذين اتقوا اذا مسهم طاءف من الشيطان} [الاعراف: ] بالالام {تذكروا} [الاعراف: ] ، قال: هم بفاحشة ولم يعملها «قال الحر بن جرموز، وقال العلاء بن بدر،» قد عملها "
 
 اخبرنا احمد بن عثمان، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، " {ان الذين اتقوا اذا مسهم طاءف من الشيطان تذكروا} [الاعراف: ] ، يقول: اذا زلوا وتابوا "
 
  قوله تعالي: {فاذا هم مبصرون} 
 [الاعراف: ]
 
 اخبرنا محمد بن سعد العوفي، فيما كتب الي، حدثني ابي، حدثني عمي الحسين، عن ابيه، عن جده، عن ابن عباس، قوله: " {تذكروا فاذا هم مبصرون} [الاعراف: ] ، يقول: اذا هم منتهون عن المعصية، اخذون بامر الله عاصون للشيطان "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {تذكروا فاذا هم مبصرون} [الاعراف: ] يبصرون ما هم فيه "
 
  قوله تعالي: {واخوانهم} 
 [الانعام: ]
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، يعني قوله: " {واخوانهم يمدونهم} [الاعراف: ] ، قال: اخوان الشياطين يمدونهم في الغي "
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي، " {واخوانهم يمدونهم في الغي} [الاعراف: ] ، قال: اخوان الشيطان من المشركين يمدهم الشيطان في الغي " وروي عن مجاهد، وقتادة
 
  والوجه الثاني
 
 حدثنا ابي، ثنا ابراهيم بن المنذر، ثنا حسين بن علي بن حسن بن ابي الحسن البراد، عن ابي مودود، عن محمد بن كعب، في قوله: " {واخوانهم يمدونهم في الغي} [الاعراف: ] ، يقول: هم من الجن " وروي عن ابن عباس، وعبد الله بن كثير نحو ذلك
 
  قوله تعالي: {يمدونهم} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا محمد بن سعيد الاصبهاني، وعبدة، قالا: انبا ابن المبارك، عن عثمان بن عطاء، عن ابيه، عن ابن عباس، " {واخوانهم يمدونهم في الغي} [الاعراف: ] ويءزونهم " وروي عن عطاء الخراساني مثل ذلك
 
  والوجه الثاني
 
 اخبرنا محمد بن سعد فيما كتب الي، حدثني ابي، حدثني عمي الحسين، عن ابيه، عن ابن عباس، قوله: " {واخوانهم يمدونهم في الغي} [الاعراف: ] ، قال: هم الجن يوحون الي اولياءهم من الانس "
 
 حدثنا علي بن الحسين، ثنا ابن ابي حماد، ثنا مهران، عن سفيان، " {واخوانهم يمدونهم في الغي} [الاعراف: ] ، قال: قولهم له لولا فعلت كذا وكذا "
 
 حدثنا ابي، ثنا عبدة، انبا ابن المبارك، قراءة، عن ابن جريج، عن ابن كثير، " {يمدونهم} [الاعراف: ] ، قال: المد الزيادة "
 
  قوله تعالي: {في الغي} 
 [سورة: الاعراف، اية رقم: ]
 
 حدثنا حجاج، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {يمدونهم في الغي} [الاعراف: ] استجهالا "
 
  قوله تعالي: {ثم لا يقصرون} 
 [سورة: الاعراف، اية رقم: ]
 
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {ثم لا يقصرون} [سورة: الاعراف، اية رقم: ] ، قال: لا يقصرون الانس عما يعملون من السيءات، ولا الشياطين تمسك عنهم "
 
  الوجه الثاني
 
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني ابي، حدثني عمي الحسين، عن ابيه، عن جده، عن ابن عباس، قوله: " {ثم لا يقصرون} [الاعراف: ] ، يقول: لا يسامون "
 
  والوجه الثالث
 
 حدثنا ابي، ثنا عبدة بن سليمان، انبا ابن المبارك، قراءة، عن ابن جرير، عن ابن كثير، " {ثم لا يقصرون} [الاعراف: ] ، قال: الجن يمدون اخوانهم من الانس، ثم لا يقصر الانس اهل الشرك فما يقصر الذين اتقوا لا يرعون لا يحجزهم الايمان "
 
  قوله تعالي: {واذا لم تاتهم باية} [الاعراف: ] الاية
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قوله: " {لولا اجتبيتها} [الاعراف: ] . يقولون: «هلا افتعلتها من تلقاء نفسك»
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {لولا اجتبيتها} [الاعراف: ] ، يقول: لولا احدثتها، يقول: لولا تلقيتها فانساتها "
 
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، ثنا عبيد بن سليمان، عن الضحاك، قوله: " {واذا لم تاتهم باية قالوا لولا اجتبيتها} [الاعراف: ] ، يقول: لولا اخرتها انت فجءت بها من السماء "
 
 اخبرنا محمد بن سعد العوفي، فيما كتب الي، حدثني ابي، حدثني عمي، عن ابيه، عن جده، عن ابن عباس، قوله: " {قالوا لولا اجتبيتها} [الاعراف: ] ، يقولون: لولا تقبلتها من الله "
 
 اخبرنا احمد بن عثمان، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {لولا اجتبيتها} [الاعراف: ] ، يقول: لولا احدثتها "
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، قوله: " {واذا لم تاتهم باية قالوا لولا اجتبيتها} [الاعراف: ] اي لولا اتيتنا بها من قبل نفسك، هذا قول كفار قريش "
 
  قوله تعالي: {قل انما اتبع ما يوحي الي من ربي} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو حذيفة، ثنا شبل، عن ابن ابي نجيح، عن مجاهد، قوله: " {لولا اجتبيتها} [الاعراف: ] ابتدعتها من عندك قال تعالي: {قل انما اتبع ما يوحي الي من ربي} [الاعراف: ] "
 
  قوله تعالي: {هذا بصاءر من ربكم} 
 [الاعراف: ]
 
 حدثنا محمد بن يحيي، انبا العباس، ثنا يزيد، ثنا سعيد، عن قتادة، قوله: " {هذا بصاءر من ربكم} [الاعراف: ] اي بينة من ربكم "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول في قوله: " {بصاءر من ربكم} [الانعام: ] ، قال: البصاءر الهدي بصاءر ما في قلوبهم لدينهم، وليست ببصاءر الرءوس وقرا: {فانها لا تعمي الابصار ولكن تعمي القلوب التي في الصدور} [الحج: ] ، وقال: انما الدين بصره وسمعه في هذا القلب "
 
  قوله تعالي: {وهدي} 
 [البقرة: ]
 
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انبا الثوري، عن بيان، عن الشعبي، " {هدي} [ال عمران: ] ، قال: من الضلالة "
 
  الوجه الثاني
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، " {هدي} [الاعراف: ] يعني تبيانا "
 
  الوجه الثالث
 
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، قوله: " {هدي} [الاعراف: ] ، قال: نور "
 
  قوله تعالي: {ورحمة لقوم يءمنون} 
 [الاعراف: ]
 
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية، في قوله: " {ورحمة} [الاعراف: ] ، قال: رحمته القران "
 
 حدثنا ابو سعيد الاشج، ثنا ابو معاوية، عن حجاج، عن عطية، عن ابي سعيد، قوله: " {ورحمة} [الاعراف: ] ، قال: رحمته ان جعلكم من اهل القران "
 
  قوله تعالي: {واذا قرء القران فاستمعوا له وانصتوا} 
 [الاعراف: ]
 
 حدثنا العباس بن الوليد بن مزيد، اخبرني ابي، قال: سمعت الاوزاعي، حدثني عبد الله بن عامر، حدثني زيد بن اسلم، عن ابيه، عن ابي هريرة، عن هذه الاية: " {واذا قرء القران فاستمعوا له وانصتوا} [الاعراف: ] ، قال: نزلت في رفع الاصوات وهم خلف رسول الله صلي الله عليه وسلم في الصلاة "
 
 حدثنا يونس بن عبد الاعلي، انبا ابن وهب، ثنا ابو صخر، عن محمد بن كعب القرظي، قال: كان رسول الله صلي الله عليه وسلم " اذا قرا في الصلاة اجابه من وراءه، اذا قال: بسم الله الرحمن الرحيم، قالوا مثل ما يقول حتي تنقضي الفاتحة والسورة فلبث ما شاء الله ان يلبث ثم نزلت: {واذا قرء القران فاستمعوا له وانصتوا لعلكم ترحمون} [الاعراف: ] ، فقرا وانصتوا "
 
 حدثنا ابو سعيد الاشج، ثنا ابو خالد، عن الهجري، عن ابي عياض، عن ابي هريرة، قال: " كانوا يتكلمون في الصلاة فنزلت: {واذا قرء القران فاستمعوا له وانصتوا لعلكم ترحمون} [الاعراف: ] ، فهذا في الصلاة "
 
 حدثنا ابي، ثنا محمد بن يحيي القطعي، ثنا محمد بن بكر، عن عمران ابي العوام، عن عاصم، عن ابي واءل، ان ابن مسعود، سلم علي رسول الله صلي الله عليه وسلم، فلم يرد عليه، فلما فرغ، قال: " ان الله يفعل ما يشاء، وكان قبل ذلك يتكلم في صلاته ويامر بحاجته فلما فرغ رسول الله صلي الله عليه وسلم رد عليه وقال: " انها نزلت: {واذا قرء القران فاستمعوا له وانصتوا لعلكم ترحمون} [الاعراف: ] "
 
  الوجه الثاني
 
 حدثنا ابو سعيد الاشج، ثنا ابن فضيل، وابو خالد، عن داود بن ابي هند، عن ابي نضرة، عن اسير بن جابر المحاربي، عن عبد الله، قال: " لعلكم تقرون؟ قلنا نعم، قال: الا تفقهون؟ ما لكم لا تعقلون؟ {واذا قرء القران فاستمعوا له وانصتوا لعلكم ترحمون} [الاعراف: ] "
 
 حدثنا ابو سعيد الاشج، ثنا ابو خالد، عن حجاج، عن ابن جريج، عن مجاهد، قال: " قرا رجل خلف رسول الله صلي الله عليه وسلم فانزلت: {واذا قرء القران فاستمعوا له وانصتوا لعلكم ترحمون} [الاعراف: ] "
 
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن ابي المقدام، عن معاوية بن قرة المزني، قال: احسبه عن عبد الله بن مفضل، قال: انما نزلت: " {واذا قرء القران فاستمعوا له وانصتوا لعلكم ترحمون} [الاعراف: ] ، في قراءة الامام اذا قرا فاستمع له وانصت "
 
 حدثنا ابي، ثنا النفيلي، ثنا مسكين بن بكير، ثنا ثابت بن عجلان، عن سعيد بن جبير، عن ابن عباس، قال: " ان المءمن في سعة من الاستماع الي يوم جمعة، او في صلاة مكتوبة او يوم اضحي او يوم فطر في قوله: {واذا قرء القران فاستمعوا له وانصتوا} [الاعراف: ] "
 
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انبا الثوري، عن جابر، عن مجاهد، قال: «وجب الانصات في اثنين من الصلاة، والامام يقرا وفي الجمعة والامام يخطب»
 
 قرء علي يونس بن عبد الاعلي، انبا ابن وهب، اخبرني ابن زيد، عن ابيه، قال: حين انزلت: " {واذا قرء القران فاستمعوا له وانصتوا} [الاعراف: ] ، قال: يكون قاءما في الصلاة "
 
  الوجه الثالث
 
 ذكر محمد بن مسلم، حدثني محمد بن موسي بن اعين، ثنا خطاب، ثنا خصيف، عن عكرمة، عن ابن عباس، في قوله: " {واذا قرء القران فاستمعوا له وانصتوا لعلكم ترحمون} [الاعراف: ] ، قال: في الصلاة وحين ينزل الوحي عن الله عز وجل "
 
  قوله تعالي: {وانصتوا لعلكم ترحمون} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو عمر الحوضي، ثنا مبارك، عن الحسن: " {واذا قرء القران فاستمعوا له وانصتوا} [الاعراف: ] ، قال: اذا جلست الي القران فانصت له "
 
  قوله تعالي: {واذكر ربك في نفسك تضرعا وخيفة} 
 [الاعراف: ]
 
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انبا ابن التيمي، عن ابيه، عن حيان بن عمير، عن عبيد بن عمير، في قول الله: " {واذكر ربك في نفسك} [الاعراف: ] ، قال: يقول الله: اذا ذكرني عبدي في نفسه ذكرته في نفسي، واذا ذكرني عبدي وحده ذكرته وحدي، واذا ذكرني في ملا ذكرته في احسن منهم واكرم "
 
 حدثنا محمد بن يحيي، انبا العباس، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، قوله: " {واذكر ربك في نفسك تضرعا وخيفة} [الاعراف: ] ، امر الله بذكره ونهي عن الغفلة "
 
  الوجه الثاني
 
 اخبرنا يونس بن عبد الاعلي، قراءة، ثنا ابن وهب، حدثني ابن زيد عبد الرحمن، عن ابيه زيد بن اسلم " {واذكر ربك في نفسك} [الاعراف: ] ، قال: الذكر ان تذكر الله وتسبحه وتهلله وتحمده "
 
 ذكره ابي، ثنا عبدان بن عثمان المروزي، عن ابي حمزة، يعني السكري، عن مطرف، عن الحكم بن عتيبة، في قوله: " {واذكر ربك في نفسك تضرعا وخيفة} [الاعراف: ] ، قال: اذا اسمعك الامام القراءة فلا تنطقن بشء "
 
  قوله تعالي: {ودون الجهر من القول} 
 [الاعراف: ]
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت ابن زيد، في قوله: " {ودون الجهر من القول} [الاعراف: ] لا تجهر بذلك "
 
 اخبرنا يونس بن عبد الاعلي، قراءة، انبا ابن وهب، حدثني ابن زيد عبد الرحمن، عن ابيه زيد بن اسلم " {دون الجهر من القول} [الاعراف: ] ، قال: لا تجهر بالغدو والاصال "
 
 وباسناده قال: {ودون الجهر من القول بالغدو} [الاعراف: ] يجهر فيها "
 
  قوله تعالي: {بالغدو} 
 [الاعراف: ]
 
 حدثنا محمد بن يحيي، انبا العباس، ثنا يزيد، ثنا سعيد، عن قتادة، قوله: " {بالغدو} [الاعراف: ] قال: اما بالغدو فصلاة الصبح "
 
  قوله تعالي: {والاصال} 
 [الاعراف: ]
 
 وبه عن قتادة، " {والاصال} [الاعراف: ] ، قال: «بالعشي»
 
 حدثنا علي بن الحسن الهسنجاني، ثنا سعيد بن ابي مريم، انبا مفضل بن فضالة، عن ابي صخر، في قوله: " {بالغدو والاصال} [الاعراف: ] والاصال ما بين الظهر والعصر "
 
 اخبرنا يونس بن عبد الاعلي، انبا ابن وهب، حدثني عبد الرحمن بن زيد بن اسلم، عن ابيه، قال: " {دون الجهر من القول بالغدو والاصال} [الاعراف: ] ، قال: فالاصال لا يجهر فيها "
 
  قوله تعالي: {ولا تكن من الغافلين} 
 [الاعراف: ]
 
 وبه عن ابن زيد، عن ابيه اسلم، قال: " {ولا تكن من الغافلين} [الاعراف: ] ، قال: «مع الغافلين»
 
 حدثنا علي بن الحسين، ثنا محمد بن ابي حماد، ثنا يحيي بن الضريس، عن ابي سنان، عن عمرو بن مرة، عن بكير بن الاخنس، قال: «ما اتي يوم الجمعة علي احد وهو لا يعلم انه يوم جمعة الا كتب من الغافلين»
 
  قوله تعالي: {ان الذين عند ربك لا يستكبرون عن عبادته ويسبحونه وله يسجدون} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، " يسبح قال: يصلي "
 
  سورة الانفال 
 تفسير السورة التي يذكر فيها الانفال. بسم الله الرحمن الرحيم {وما توفيقي الا بالله عليه توكلت} [هود: ]
 
  قوله عز وجل {يسالونك} 
 [البقرة: ]
 
 حدثنا ابو سعيد الاشج، ثنا ابو بكر النخعي، عن جويبر، عن الضحاك، " {يسالونك عن الانفال،} [الانفال: ] ، قال: يقولون: اعطنا "
 
 حدثنا ابي، حدثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {يسالونك} [الانفال: ] يعني: قرابة النبي صلي الله عليه وسلم "
 
  قوله تعالي: {الانفال} 
 [الانفال: ]
 
 وبه عن ابن عباس، قوله: " {يسالونك عن الانفال} [الانفال: ] ، قال: الانفال: المغانم، كانت لرسول الله صلي الله عليه وسلم خالصة ليس لاحد منها شء " وروي عن مجاهد، والضحاك، وعطاء الخراساني، ومقاتل بن حيان، انهم قالوا: المغانم
 
  قوله تعالي: {قل الانفال لله والرسول} 
 [الانفال: ]
 
 حدثنا يونس بن حبيب الاصبهاني، ثنا ابو داود، اخبرنا شعبة، اخبرني سماك بن حرب، قال: سمعت مصعب بن سعد، يحدث، عن سعد، قال: " نزلت في اربع ايات: اصبت سيفا يوم بدر، وربما قال: اصاب ابني سيفا يوم بدر، قال: فاتيت النبي صلي الله عليه وسلم فقلت: نفلنيه، فقال: ضعه من حيث اخذته مرتين، ثم عاودته، فقال رسول الله صلي الله عليه وسلم: ضعه من حيث اخذته، فنزلت هذه الاية {يسالونك عن الانفال} [الانفال: ] "
 
 حدثنا ابي، ثنا محمد بن سعيد بن الاصبهاني، انبا ابو بكر بن عياش، عن عاصم، عن سعد، قال " جءت الي رسول الله صلي الله عليه وسلم بسيف فقلت: يا رسول الله، ان الله قد شفي نفسي اليوم من المشركين فهب لي هذا السيف، فقال: «ان هذا السيف ليس لي ولا لك فاطرحه» ، فطرحته، فقلت: لعله يعطاه رجل لم يبل مثل بلاءي، قال: فبينا انا اذ جاءني الرسول، فقال: اجب، فظننت انه نزل في شء لكلامي فجءت، فقال لي رسول الله صلي الله عليه وسلم: «انك سالتني هذا السيف، وليس هو لي ولا لك، فان الله قد جعله لي فهو لك»
 
 اخبرني علي بن عبد العزيز، فيما كتب الي قال: قال ابو عبيد في الانفال " انها المغانم وفي كل نيل ناله المسلمون لقول الله عز وجل {يسالونك عن الانفال قل الانفال لله والرسول} [سورة: الانفال، اية رقم: ] فقسمها يوم بدر علي ما اراه الله من غير ان يخمسها علي ما ذكرناه في حديث سعد، ثم نزلت بعد ذاك اية الخمس فنسخت الاولي، وفي ذلك اثار والانفال: اصلها جماع الغناءم، الا ان الخمس منها مخصوص لاهله علي ما نزل به الكتاب وجرت به السنة ومعني الانفال في كلام العرب: كل احسان فعله فاعل تفضلا من غير ان يجب ذلك عليه، فكذلك النفل الذي احله الله للمءمنين من اموال عدوهم، انما هو شء خصهم الله به تطولا منه عليهم، بعد ان كانت الغناءم محرمة علي الامم قبلهم فنفلها الله هذه الامة، فهذا اصل النفل، وبه سمي ما جعل الامام للمقاتلة نفلا وهو تفضيله بعض الجيش علي بعض بشء سوي سهامهم، يفعل ذلك علي قدر الغني عن الاسلام، والنكي في العدو، وفي النفل الذي ينفله الامام سنن اربع كل واحدة منهن موضع غير موضع الاخري فاحداهن: في النفل لا خمس فيه وذلك السلب والثانية: النفل الذي يكون من الغنيمة بعد اخراج الخمس، وهو ان يوجه الامام السرايا في ارض الحرب فتاتي بالغناءم فيكون للسرية مما جاءت به الربع والثلث بعد الخمس، والثالثة، في النفل من الخمس نفسه وهو ان تحاز الغنيمة كلها ثم تخمس فاذا صار الخمس في يدي الامام نفل منه علي قدر ما يري، والرابعة: في النفل في
 
 جملة الغنيمة قبل ان يخمس منها شء، وهو ان تعطي الادلاء ورعاء الماشية والسواق لها وفي كل ذلك اختلاف قال الربيع بن سليمان، قال الشافعي: الانفال: ان لا يخرج من راس الغنيمة قبل الخمس شء غير السلب
 
  والوجه الثاني من النفل هو شء زيدوه غير الذي كان لهم، وذلك من خمس النبي صلي الله عليه وسلم، فان له خمس الخمس من كل غنيمة فينبغي للامام ان يجتهد، فاذا كثر العدو واشتدت شوكتهم وقل من بازاءه من المسلمين نفل منه اتباعا لسنة رسول الله صلي الله عليه وسلم، 
 واذا لم يكن ذلك لم ينفل
 
  والوجه الثالث من النفل اذا بعث الامام سرية او جيشا، فقال لهم قبل اللقاء: من غنم شيءا فهو له بعد الخمس، فذلك لهم علي ما شرط الامام، لانهم علي ذلك غزوا، وبه رضوا من فسر الاية بان السلب الذي يتقرب الرجل بقتل المشرك له من غير ان يخمس او يشركه فيه احد
 
 اخبرنا يونس بن عبد الاعلي، قراءة، انبا ابن وهب، ان مالكا، حدثه، عن يحيي بن سعيد، عن عمر بن كثير بن افلح، عن ابي محمد، مولي ابن قتادة، عن ابن قتادة، انه قال: " خرجنا مع رسول الله صلي الله عليه وسلم عام حنين، فقال رسول الله صلي الله عليه وسلم: «من قتل قتيلا له عليه بينة فله سلبه» ، فقمت فقال رسول الله صلي الله عليه وسلم: «ما لك يا ابا قتادة؟» ، فقصصت عليه القصة، اني ضربت رجلا من المشركين بالسيف علي حبل عاتقه ثم ادركه الموت، فقال رجل من القوم: صدق يا رسول الله، وسلب ذلك القتيل عندي، فقال له رسول الله صلي الله عليه وسلم: «اعطه اياه»
 
 حدثنا ابو سعيد الاشج، ثنا معن، عن مالك بن انس، عن الزهري، عن القاسم بن محمد، قال: " سال رجل ابن عباس، عن الانفال، فقال: «الفرس من النفل والسلب من النفل»
 
  من فسر الاية بان النفل يكون ما يخرج الخمس منه
 
 حدثنا ابي، ثنا عون بن الحكم بن سنان الباهلي، ومحمد بن ابي نعيم الواسطي، وعبيد بن محمد بن بحر العبدي، قالوا: حدثنا ابو عوانة، عن عاصم بن كليب، حدثني ابو الجويرية، عن رجل، من اصحاب رسول الله صلي الله عليه وسلم من بني سليم يقال له: معن بن يزيد قال: سمعت رسول الله صلي الله عليه وسلم يقول: «لا نفل الا بعد الخمس»
 
  من فسر الاية علي ان النفل يكون من الخمس
 
 اخبرنا يونس بن عبد الاعلي، قراءة، انبا ابن وهب، ان مالكا، حدثه، عن ابي الزناد، عن ابن المسيب، انه قال: «كان الناس يعطون النفل من الخمس»
 
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا ابن المبارك، عن معمر، عن ايوب، عن ابن سيرين، ان انس بن مالك، كان مع عبيد الله بن ابي بكرة في غزاة غزاها فاصابوا سبيا، واراد عبيد الله بن ابي بكرة ان يعطي انسا من السبي قبل ان يقسم، قال انس: «لا ولكن اقسم ثم اعطني من الخمس»
 
  من فسر الاية علي ان النفل من جميع الغنيمة قبل ان تخمس
 
 حدثنا محمد بن اسماعيل الاحمسي، حدثنا وكيع، عن عكرمة بن عمار، عن اياس بن سلمة بن الاكوع، عن ابيه، قال: " غزونا مع ابي بكر هوزان علي عهد رسول الله صلي الله عليه وسلم فنفلني جارية من بني فزارة اجمل العرب، عليها قشع لها، فما كشفت لها عن ثوب حتي اتيت المدينة، فلقيني النبي صلي الله عليه وسلم في السوق فقال: «لله ابوك هبها لي» ، فوهبتها له فبعث بها ففادي بها اساري من المسلمين كانوا بمكة "
 
  من فسر الاية علي ان النفل قبل التقاء الزحفان
 
 حدثنا ابي، حدثني الفضل بن دكين، ثنا شريك، عن جابر، عن القاسم بن عبد الرحمن بن عبد الله بن مسعود، عن ابيه، عن عبد الله، قال: " النفل ما لم يلتق
  [ص: ]
 الزحفان، او قال: صفان، فاذا التقي الصفان، او قال: الزحفان، فالمغنم " وروي، عن مسروق انه قال: لا نفل يوم الزحف "
 
  من فسر الاية علي ان النفل مما تصيبه السرايا
 
 حدثنا ابي، ثنا ابو نعيم، حدثنا الحسن بن صالح، عن ابيه، عن الشعبي، " {يسالونك عن الانفال} [الانفال: ] ، قال: ما اصابت السرايا "
 
  من فسر الاية انها منسوخة، نسختها {واعلموا انما غنمتم من شء} [الانفال: ] الاية
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {يسالونك عن الانفال، قل الانفال لله والرسول} [الانفال: ] ، قال: الانفال: المغانم كانت لرسول الله صلي الله عليه وسلم خالصة ليس لاحد منها شء ما اصاب سرايا المسلمين من شء اتوه به، فمن حبس منه ابرة او سلكا فهو غلول، فسالوا النبي صلي الله عليه وسلم ان يعطيهم منها، قال الله تعالي: {يسالونك عن الانفال} [الانفال: ] يعني: قرابة النبي صلي الله عليه وسلم، {قل الانفال} [الانفال: ] ، جعلتها لرسولي، ليس لكم منه شء {فاتقوا الله واصلحوا ذات بينكم} [الانفال: ] ثم انزل {واعلموا انما غنمتم من شء فان لله خمسه وللرسول ولذي القربي} [الانفال: ] «الاية»
 
  قوله تعالي: {فاتقوا الله واصلحوا} 
 [الانفال: ]
 
 حدثنا علي بن الحسين، ثنا ابو بكر بن ابي شيبة، وعمر بن صالح الواسطي، قالا: حدثنا عباد بن العوام، عن سفيان بن حسين، عن الحكم، عن مجاهد، عن ابن عباس، في قوله: " {فاتقوا الله واصلحوا ذات بينكم} [الانفال: ] ، قال: «هذا تحريج من الله علي المءمنين ان يتقوا الله، وان يصلحوا ذات بينهم»
 
  قوله تعالي: {واصلحوا ذات بينكم} 
 [الانفال: ]
 
 حدثنا ابي، حدثنا المسيب بن واضح، ثنا ابو اسحاق، عن سفيان، عن عبد الرحمن بن الحارث بن عياش بن ابي ربيعة، عن سليمان بن موسي، عن مكحول، عن ابي سلام، عن ابي امامة الباهلي، عن عبادة بن الصامت، قال: " خرجنا مع رسول الله صلي الله عليه وسلم وشهدت معه بدرا. فلقينا المشركين فهزم الله العدو، فانطلقت طاءفة في اثارهم يهزمون ويقتلون، واكبت طاءفة في العسكر يحوزونه
 
 ويجمعونه، واحدقت طاءفة برسول الله صلي الله عليه وسلم لا يصيب العدو منه غرة. قال الذين جمعوا الغناءم: نحن حويناهم وجمعناهم فليس لاحد فيها نصيب، وقال الذين خرجوا في طلب العدو: لستم باحق بها منا، نحن نفينا عنها العدو وهزمناهم، وقال الذين احدقوا برسول الله صلي الله عليه وسلم لستم باحق بها منا، احدقنا برسول الله صلي الله عليه وسلم وخفنا ان يصيب العدو منه غرة فاشتغلنا به فنزلت {يسالونك عن الانفال قل الانفال لله والرسول فاتقوا الله واصلحوا ذات بينكم واطيعوا الله ورسوله ان كنتم مءمنين} [سورة: الانفال، اية رقم: ] ، فقسمها رسول الله صلي الله عليه وسلم بين المسلمين، وكان يقول: ليرد قوي المسلمين علي ضعيفهم "
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، حدثنا احمد بن مفضل، حدثنا اسباط، عن السدي، " واصلحوا ذات بينكم، قال: لا تستبوا "
 
 حدثنا ابي، ثنا هشام بن عمار، ثنا الوليد، حدثنا سعيد بن عبد العزيز، انه سمع مكحولا، يحدث: «ان صلاح ذات بينهم كان ان ردت الغناءم، فقسمت بين من ثبت عند رسول الله صلي الله عليه وسلم. وبين من قاتل وغنم» وروي عن قتادة، ومطر انهما قالا: «امرهم ان يرد بعضهم علي بعض»
 
  قوله تعالي: {واطيعوا الله ورسوله} 
 [الانفال: ]
 
 حدثنا المنذر بن شاذان، ثنا يعلي بن عبيد، ثنا عبد الملك، عن عطاء، في قوله: " {اطيعوا الله ورسوله} [الانفال: ] ، قال: طاعة الرسول اتباع الكتاب والسنة "
 
  الوجه الثاني
 
 حدثنا علي بن الحسين، حدثنا ابو الطاهر، انبا ابن وهب، حدثني ابو صخر، عن محمد بن كعب القرظي، قال: واخبرنا ابو معاوية البجلي، عن سعيد بن جبير، " {واطيعوا الله ورسوله} [الانفال: ] اسلموا السيف اليه ثم نسخت {واعلموا انما غنمتم من شء فان لله خمسه} [الانفال: ] "
 
  الوجه الثالث
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله " {واطيعوا الله ورسوله ان كنتم مءمنين} [الانفال: ] سلموا لله ورسوله، يحكمان فيها بما شاء ويضعانه حيث ارادا "
 
  قوله تعالي: {ان كنتم مءمنين} 
 [البقرة: ]
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، قوله: " {مءمنين} [الانفال: ] ، قال: «مصدقين»
 
  قوله تعالي: {انما المءمنون الذين اذا ذكر الله} 
 [الانفال: ]
 
 حدثنا ابو سعيد الاشج، ثنا وكيع، عن سفيان، عن السدي، في قول الله: " {الذين اذا ذكر الله وجلت قلوبهم} [الانفال: ] ، قال: الذي اذا ذكر الله عند الشء وجل قلبه "
 
  قوله تعالي: {وجلت قلوبهم} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، " {انما المءمنون الذين اذا ذكر الله وجلت قلوبهم} [الانفال: ] ، قال: فرقت " وروي عن مجاهد، وقتادة. نحو ذلك
 
  الوجه الثاني
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، في قوله: " {انما المءمنون الذين اذا ذكر الله وجلت قلوبهم} [الانفال: ] ، قال: المنافقون لا يدخل قلوبهم شء من ذكر الله عند اداء فراءضه، فلا يءمنون بشء من ايات الله، ولا يتوكلون علي الله، ولا يصلون اذا غابوا، ولا يءدون زكاة اموالهم، فاخبر الله انهم ليسوا بمءمنين، ثم وصف المءمنين فقال: {انما المءمنون الذين اذا ذكر الله وجلت قلوبهم} [الانفال: ] ، فادوا فراءضه "
 
 حدثنا ابي، ثنا عبدة بن سليمان المروزي، انبا ابن المبارك، انبا سفيان، قال: سمعت السدي، يقول في قوله: " {انما المءمنون الذين اذا ذكر الله وجلت قلوبهم} [الانفال: ] ، قال: " هو الرجل يريد ان يظلم، او قال: يهم بمعصية فيقال له: اتق الله، فيجل قلبه "
 
  قوله تعالي: {واذا تليت عليهم اياته} 
 [الانفال: ]
 
 حدثنا ابو زرعة، حدثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، قوله: " {اياته} [الانفال: ] يعني: القران "
 
  قوله تعالي: {زادتهم ايمانا} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {واذا تليت عليهم اياته زادتهم ايمانا} [الانفال: ] ، يقول: تصديقا "
 
 حدثنا ابي، ثنا احمد بن عبد الرحمن، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع بن انس، قوله: " {واذا تليت عليهم اياته زادتهم ايمانا} [الانفال: ] ، يقول: زادتهم خشية "
 
 حدثنا ابي، ثنا عبيد الله بن موسي، انبا سفيان، عمن، سمع مجاهدا، يقول في قوله: " {زادتهم ايمانا} [الانفال: ] ، قال: الايمان يزيد وينقص "
 
  قوله تعالي: {وعلي ربهم يتوكلون} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، " {وعلي ربهم يتوكلون} [الانفال: ] ، يقول: لا يرجون غيره "
 
 حدثنا ابي، ثنا مالك بن اسماعيل، قال هريم: ثنا عن ابي سنان، عن سعيد بن جبير، قال: «التوكل علي الله جماع الايمان»
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، عن سعيد، عن قتادة، قوله: " {وعلي ربهم يتوكلون} [الانفال: ] ، قال: «هذا نعت اهل الايمان، نعتهم فاثبت نعتهم ووصفهم فاثبت صفتهم»
 
 حدثنا ابو سعيد الاشج، حدثنا ابن فضيل، ثنا ضرار بن مرة، عن سعيد بن جبير، قال: «التوكل علي الله نصف الايمان»
 
  قوله تعالي: {الذين يقيمون الصلاة} 
 [الماءدة: ]
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: " {الذين يقيمون الصلاة} [الانفال: ] ، قال: الصلوات الخمس "
 
 حدثنا محمد بن يحيي، انبا ابو غسان محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، قال: فيما ثنا محمد بن ابي محمد، مولي زيد بن ثابت، عن عكرمة او سعيد بن جبير، عن ابن عباس، يقول الله سبحانه وبحمده: " {الذين يقيمون الصلاة} [الماءدة: ] اي: يقيمون الصلاة بفرضها "
 
 حدثنا الحسن بن محمد بن الصباح، ثنا عبد الوهاب بن عطاء الخفاف، عن سعيد، عن قتادة، " {يقيمون الصلاة} [الماءدة: ] : «اقامة الصلاة» المحافظة علي مواقيتها، ووضوءها وركوعها وسجودها "
 
 قرات علي محمد بن الفضل بن موسي، ثنا محمد بن علي بن الحسن بن شقيق، ثنا محمد بن مزاحم، انبا بكير بن معروف، عن مقاتل بن حيان، قوله: " {يقيمون الصلاة} [الانفال: ] اقامتها: المحافظة علي موقيتها، واسباغ الطهور فيها، وتمام ركوعها وسجودها، وتلاوة القران فيها والتشهد والصلاة علي النبي صلي الله عليه وسلم، فهذا اقامتها "
 
  قوله تعالي: {ومما رزقناهم ينفقون} 
 [البقرة: ]
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {ومما رزقناهم ينفقون} [البقرة: ] ، يقول: زكاة اموالهم "
 
  والوجه الثاني
 
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: " {ومما رزقناهم ينفقون} [البقرة: ] ، «فهي نفقة الرجل علي اهله، وهذا قبل ان تنزل الزكاة»
 
  الوجه الثالث
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: " {ومما رزقناهم ينفقون} [البقرة: ] فانفقوا مما اعطاكم الله، فانما هذه الاموال عواري ووداءع عندك يا ابن ادم اوشكت ان تفارقها "
 
  قوله تعالي: {اولءك هم المءمنون حقا} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: " {اولءك هم المءمنون حقا} [الانفال: ] برءوا من الكفر "
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، عن سعيد، عن قتادة: " {اولءك هم المءمنون حقا} [الانفال: ] ، قال: استحقوا الايمان بحق، فاحقه الله لهم "
 
 حدثنا ابي، ثنا عبيد الله بن حمزة بن اسماعيل، عن يحيي الضريس، ثنا ابو سنان، قال: سءل عمرو بن مرة، عن قوله: " {اولءك هم المءمنون حقا} [الانفال: ] ، قال: " انما انزل القران بلسان العرب، كقولك: فلان سيد حقا وفي القوم سادة، وفلان تاجر حقا وفي القوم تجار، وفلان شاعر حقا وفي القوم شعراء "
 
  قوله تعالي: {لهم درجات عند ربهم} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا عبد الله بن لهيعة، ثنا عطاء بن دينار، عن سعيد بن جبير، قوله: " {درجات} [الانفال: ] يعني: فضاءل ورحمة "
 
 حدثنا ابو سعيد الاشج، ثنا عبيد الله، انبا اسراءيل، عن ابي يحيي، عن مجاهد: " {لهم درجات عند ربهم} [الانفال: ] ، قال: «اعمال رفيعة»
 
  الوجه الثاني
 
 حدثنا ابي، ثنا ابو نعيم، ثنا سلمة بن نبيط، عن الضحاك، في قوله: " {لهم درجات عند ربهم} [الانفال: ] ، قال: اهل الجنة بعضهم فوق بعض، فيري الذي هو فوق فضله علي الذي هو اسفل منه، ولا يري الذي هو اسفل انه فضل عليه احد "
 
  قوله تعالي: {ومغفرة} 
 [البقرة: ]
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، انبا عبد الرحمن بن زيد بن اسلم، في قول الله: " {ومغفرة} [الانفال: ] بترك الذنوب "
 
 حدثنا ابي، ثنا ابو عبيد الله ابن اخي ابن وهب، ثنا عمي، عن يحيي بن ابي كثير، عن سعيد بن عبد الرحمن الجمحي، قال: قال ابو حازم: قال محمد بن كعب القرظي: " اذا سمعت الله، يقول: {رزق كريم} [الانفال: ] فهي الجنة "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، انبا عبد الرحمن بن زيد بن اسلم، " {ورزق كريم} [الانفال: ] ، قال: الاعمال الصالحة "
 
  قوله تعالي: {كما اخرجك ربك من بيتك بالحق} 
 [الانفال: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، " {كما اخرجك ربك من بيتك بالحق} [الانفال: ] كذلك "
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي، " {كما اخرجك ربك من بيتك بالحق} [الانفال: ] ، قال: خروج النبي صلي الله عليه وسلم الي بدر "
 
  قوله تعالي: {وان فريقا من المءمنين لكارهون} 
 [الانفال: ]
 
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا زيد بن الحباب، ثنا ابن لهيعة، ثنا يزيد بن ابي حبيب، ان اسلم ابا عمران، حدثه، قال: سمعت ابا ايوب الانصاري، يقول: " قال لنا رسول الله صلي الله عليه وسلم ونحن بالمدينة، وبلغه ان عير ابي سفيان قد اقبلت فقال: «ما ترون فيها؟ لعل الله يغنمناها ويسلمنا» ، فخرجنا فسرنا يوما او يومين، فقال: «ما ترون فيهم؟» فقلنا: يا رسول الله، ما لنا طاقة بقتال القوم، انما خرجنا للعير، قال المقداد: لا تقولوا كما قال قوم موسي لموسي: {اذهب انت وربك فقاتلا انا ها هنا قاعدون} ، فانزل الله تعالي: {كما اخرجك ربك من بيتك بالحق وان فريقا من المءمنين لكارهون} [الانفال: ] "
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن الفضل، ثنا اسباط، عن السدي، " {وان فريقا من المءمنين لكارهون} [الانفال: ] لطلب المشركين "
 
  قوله تعالي: {يجادلونك في الحق بعد ما تبين}
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {يجادلونك في الحق} [الانفال: ] القتال "
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي، « {يجادلونك في الحق بعد ما تبين} انك لا تصنع الا ما امرك الله به»
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، انبا عبد الرحمن بن زيد بن اسلم، في قول الله " {يجادلونك في الحق بعد ما تبين} ، قال: «هءلاء المشركون يجادلونك في الحق»
 
  قوله تعالي: {كانما يساقون الي الموت} 
 [الانفال: ]
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {كانما يساقون الي الموت} [الانفال: ] حين قيل هم المشركون "
 
  الوجه الثاني
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، انبا عبد الرحمن بن زيد بن اسلم، في قول الله " {كانما يساقون الي الموت} [الانفال: ] ، حين يدعون الي الاسلام "
 
  قوله تعالي: {وهم ينظرون} 
 [الانفال: ]
 
 وبه حدثنا عبد الرحمن بن زيد، " {كانما يساقون الي الموت} [الانفال: ] : حين يدعون الي الاسلام، وهم ينظرون وليس هذه من صفة الاخرين، هذه صفة مبتداة لاهل الكفر "
 
  قوله تعالي: {واذ يعدكم الله} 
 [الانفال: ]
 
 حدثنا اسماعيل بن اسراءيل، ثنا سماك بن حرب، عن عكرمة، عن ابن عباس، قال: " قيل للنبي صلي الله عليه وسلم لما فرغ من بدر: " عليك بالعير ليس دونها شء، فناداه العباس وهو اسير: لا يصلح لك ذاك، فقال له رسول الله صلي الله عليه وسلم: «ولم؟» ، قال: «لان الله قد وعدك احدي الطاءفتين، وقد اعطاك ما وعدك»
 
  قوله تعالي: {احدي الطاءفتين} 
 [الانفال: ]
 
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا زيد بن الحباب، ثنا ابن لهيعة، ثنا يزيد بن حبيب، ان ابا عمران، اسلم حدثه، قال: سمعت ابا ايوب الانصاري
  [ص: ]
 ، يقول: " قال لنا رسول الله صلي الله عليه وسلم: «ما ترون فيهم؟» فقلنا: يا رسول الله، ما لنا طاقة بقتال القوم، انما خرجنا للعير، ثم انزلت: {واذ يعدكم الله احدي الطاءفتين انها لكم} [الانفال: ] ، وطابت انفسنا حين وعد الله احدي الطاءفتين فالطاءفة: العير "
 
  الوجه الثاني
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، قوله: " {اذ يعدكم الله احدي الطاءفتين انها لكم} [الانفال: ] فالطاءفتان: احدهما ابو سفيان اقبل بالعير من الشام، والطاءفة الاخري: ابو جهل بن هشام معه نفير قريش. "
 
  قوله تعالي: {وتودون ان غير ذات الشوكة تكون لكم} 
 [الانفال: ]
 
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا زيد بن الحباب، ثنا ابن لهيعة، ثنا يزيد بن ابي حبيب، ان اسلم ابا عمران، حدثه، قال: سمعت ابا ايوب، يقول: " قال لنا رسول الله صلي الله عليه وسلم ونحن بالمدينة: «وبلغه ان عير ابي سفيان قد اقبلت» ، ثم نزلت، {واذ يعدكم الله احدي الطاءفتين انها لكم وتودون ان غير ذات الشوكة} [الانفال: ] والشوكة: هم العدو "
 
 حدثنا ابي، ثنا يحيي بن سليمان الجعفي، حدثني ابن وهب، حدثني ابن لهيعة، عن يزيد بن ابي حبيب، ان اسلم ابا عمران التجيبي حدثه، انه سمع ابا ايوب الانصاري، يقول: " قال لنا رسول الله: {واذ يعدكم الله احدي الطاءفتين انها لكم وتودون ان غير ذات الشوكة تكون لكم} [الانفال: ] ، والشوكة: القوم، وغير الشوكة: العير "
 
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، ثنا عبيد بن سليمان، عن الضحاك، قوله: " {وتودون ان غير ذات الشوكة تكون لكم} [الانفال: ] : هي عير ابي سفيان، ود اصحاب محمد صلي الله عليه وسلم ان العير كانت لهم وان القتال صرف عنهم "
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، حدثني محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {وتودون ان غير، ذات الشوكة تكون لكم} [الانفال: ] اي الغنيمة دون الحرب "
 
  قوله تعالي: {ويريد الله ان يحق الحق بكلماته} 
 [الانفال: ]
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي، " {وتودون ان غير، ذات الشوكة تكون لكم} [الانفال: ] ، ارادوا العير والله يريد ان يحق الحق بكلماته "
 
  قوله تعالي: ويقطع دابر الكافرين
 
 حدثنا ابي، ثنا عمرو بن علي، ثنا ابن ابي عدي، عن محمد بن عمرو، قال: قال صفوان بن سليم، " {ويقطع دابر الكافرين} [الانفال: ] ، فاوحي الله اليه القتال "
 
 حدثنا ابو بكر بن ابي موسي، حدثنا هارون بن حاتم، حدثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك، قوله: " {دابر} [الانفال: ] يعني: اصل "
 
 حدثنا ابي، حدثنا الحسن بن الربيع، حدثنا ابن ادريس، عن ابن اسحاق، " {ويقطع دابر الكافرين} [الانفال: ] ، الوقعة التي اوقع الله بقريش يوم بدر
 
  قوله تعالي: {ليحق الحق ويبطل الباطل} 
 [الانفال: ]
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {ليحق الحق ويبطل الباطل ولو كره المجرمون} [الانفال: ] ، وهم المشركون "
 
  قوله تعالي: {اذ تستغيثون ربكم} 
 [الانفال: ]
 
 حدثنا يزيد بن سنان، ثنا عمر بن يونس بن القاسم، ثنا عكرمة بن عمار، حدثنا ابو زميل، ثنا عبد الله بن عباس، ثنا عمر بن الخطاب، قال: " لما كان يوم بدر نظر نبي الله صلي الله عليه وسلم الي المشركين، وهو واصحابه ثلاثماءة وتسعة عشر رجلا، قال: فاستقبل نبي الله صلي الله عليه وسلم القبلة، ثم مد يديه فجعل يهتف بربه: " اللهم انجز لي ما وعدتني الله، اين ما وعدتني؟ اللهم ان تهلك هذه العصابة من اهل الاسلام لا تعبد في الارض ابدا، فما زال يهتف بربه مادا يديه مستقبل القبلة حتي سقط رداءه عن منكبيه، فاتاه ابو بكر فاخذ رداءه فالقاه علي منكبيه، ثم التزمه من وراءه فقال: يا نبي الله، كفاك مناشدتك ربك، فانه سينجز لك ما وعدك، فانزل الله تعالي: {اذ تستغيثون ربكم} [الانفال: ] "
 
 حدثنا ابي، حدثنا الحسن بن الربيع، حدثنا ابن ادريس، عن ابن اسحاق، " {اذ تستغيثون ربكم} [الانفال: ] اي: «دعاء رسول الله صلي الله عليه وسلم والمسلمين معه»
 
  قوله تعالي: {فاستجاب لكم اني ممدكم بالف من الملاءكة} 
 [الانفال: ]
 
 حدثنا يزيد بن سنان، ثنا عمر بن يونس، ثنا عكرمة بن عمار، ثنا ابو زميل، ثنا عبد الله بن عباس، ثنا عمر بن الخطاب، قال: " لما كان يوم بدر نظر رسول الله صلي الله عليه وسلم الي المشركين، وهو واصحابه ثلاثماءة وتسعة عشر رجلا فاستقبل القبلة، ثم مد يديه فجعل يهتف بربه، فانزل الله تعالي: {اذ تستغيثون ربكم فاستجاب لكم اني ممدكم بالف من الملاءكة مردفين} [الانفال: ] فامده الله بالملاءكة "
 
  قوله تعالي: {مردفين} 
 [الانفال: ]
 
 حدثنا ابي، حدثنا مقاتل بن محمد، حدثنا وكيع، عن سفيان، عن هارون بن عنترة، عن ابيه، عن ابن عباس، في قوله: " {مردفين} [الانفال: ] ، قال: متتابعين " وروي عن قتادة، وابي مالك، ومحمد بن كعب، والسدي، والضحاك، وعبد الرحمن بن زيد بن اسلم، نحو ذلك
 
 حدثنا ابي، حدثنا هلال بن عبد الملك بن سعيد العيشي، حدثنا ابو هلال الراسبي، عن داود بن ابي هند، عن الشعبي، قال: «كان الف مردفين وثلاثة الاف منزلين، فكانوا اربعة الاف، وهم مدد المسلمين في ثغورهم»
 
  قوله تعالي: {وما جعله الله الا بشري} 
 [ال عمران: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {وما جعله الله الا بشري} [ال عمران: ] ، قال: انما جعلهم الله ليستبشروا بهم "
 
  قوله تعالي: {ولتطمءن به قلوبكم} 
 [الانفال: ]
 
 وبه، عن مجاهد، " {ولتطمءن به قلوبكم} [الانفال: ] ، تطمءنوا اليه "
 
  قوله تعالي: {وما النصر الا من عند الله} 
 [ال عمران: ]
 
 حدثنا محمد بن العباس، ثنا زنيج، ثنا سلمة، قال: قال محمد بن اسحاق: " {وما النصر الا من عند الله} [ال عمران: ] الا من عندي، الا بسلطاني وقدرتي، وذلك ان العز والحكم الي لا الي احد من خلقي "
 
  قوله تعالي: {ان الله عزيز} 
 [البقرة: ]
 
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع بن انس، عن ابي العالية، " {ان الله عزيز حكيم} [البقرة: ] ، يقول: عزيز في نقمته اذا انتقم " وروي عن قتادة، والربيع بن انس نحو ذلك
 
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة، قال محمد بن اسحاق: " {عزيز حكيم} [الانفال: ] العزيز في نصرته ممن كفر به اذا شاء "
 
  قوله تعالي: {حكيم} 
 [البقرة: ]
 
 حدثنا عصام بن رواد، ثنا ادم، حدثنا ابو جعفر، عن الربيع بن انس، عن ابي العالية، " {ان الله عزيز حكيم} [البقرة: ] ، يقول: حكيم في امره "
 
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة، قال محمد بن اسحاق: " {عزيز حكيم} [الانفال: ] ، قال: الحكيم في عذره وحجته الي عباده "
 
  قوله تعالي: {اذ يغشيكم النعاس} 
 [الانفال: ]
 
 حدثنا احمد بن سنان، ثنا عبد الرحمن بن مهدي، عن سفيان، عن عاصم بن ابي النجود، عن ابي رزين، عن عبد الله بن مسعود، قال: " النعاس في القتال: امنة، يعني من الله، والنعاس في الصلاة من الشيطان "
 
 حدثنا علي بن الحسن، حدثنا ابو الجماهر، قال: سمعت سعيد بن بشير، يقول: سمعت قتادة، يقول: «النعاس في الراس، والنوم في القلب»
 
 حدثنا ابي، ثنا الانصاري، ثنا حميد الطويل، عن انس بن مالك، قال: قال ابو طلحة «كنت فيمن انزل عليه النعاس يوم احد، حتي سقط سيفي من يدي مرارا»
 
 حدثنا علي بن الحسين، ثنا احمد بن صالح، ثنا ابن وهب، اخبرني يونس، عن ابن شهاب، عن قول الله: " {اذ يغشيكم النعاس امنة منه} [الانفال: ] ، قال: «بلغنا ان هذه الايات انزلت في المءمنين يوم بدر، فيما اغشاهم الله من النعاس امنة منه»
 
  قوله تعالي: {امنة منه} 
 [الانفال: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {النعاس امنة منه} [الانفال: ] : امن من الله "
 
  الوجه الثاني
 
 اخبرنا العباس بن الوليد بن مزيد، قراءة، انبا ابن شعيب بن شابور، انبا سعيد بن بشير، عن قتادة، في قوله: " {اذ يغشيكم النعاس امنة منه} [الانفال: ] ، رحمة منه امنة من العدو "
 
  قوله تعالي: {وينزل عليكم من السماء ماء} 
 [الانفال: ]
 
 حدثنا ابو سعيد الاشج، ثنا حفص بن غياث، عن داود بن ابي هند، عن سعيد بن المسيب، " {وينزل عليكم من السماء ماء ليطهركم به} [الانفال: ] ، قال: طش يوم بدر، يعني اصابهم " وروي عن الشعبي: مثل ذلك
 
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا ابن ادريس، عن ابن اسحاق، حدثني يزيد بن رومان، عن عروة بن الزبير، قال: «بعث الله السماء وكان الوادي دهسا واصاب رسول الله صلي الله عليه وسلم واصحابه منها ما لبد الارض ولم يمنعهم المسير، واصاب قريش ما لم يقدروا علي ان يرتحلوا معه»
 
  الوجه الثاني
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {وينزل عليكم من السماء ماء ليطهركم به} [الانفال: ] ، المطر انزله عليهم قبل النعاس فاطفا بالمطر الغبار والتبدت به الارض وطابت به انفسهم وثبتت به اقدامهم " وروي عن الضحاك، وعبد الرحمن بن زيد بن اسلم، نحو ذلك
 
  قوله تعالي: {ليطهركم به} 
 [الانفال: ]
 
 اخبرنا العباس بن الوليد بن مزيد، قراءة، انبا ابن شعيب، انبا سعيد بن بشير، عن قتادة، في قوله: " {وينزل عليكم من السماء ماء ليطهركم به} [الانفال: ] ، " وذلك ان المشركين
  [ص: ]
 سبقوا رسول الله صلي الله عليه وسلم الي الماء، فقدم رسول الله صلي الله عليه وسلم، فنزل بحيالهم وبينه وبينهم الوادي، فقذف الشيطان في قلوب اصحاب رسول الله صلي الله عليه وسلم، قال: انتم تزعمون انكم عباد الله وعلي دين الله وانتم تصلون محدثين مجنبين وقد سبقكم المشركون الي الماء؟ فمطروا فطهرهم الله من الاحداث والجنابة "، وامر رسول الله صلي الله عليه وسلم بحياض فشربوا وسقوا، فقال: {ليطهركم به} [الانفال: ] "
 
  قوله تعالي: {ويذهب عنكم رجز الشيطان} 
 [الانفال: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {رجز الشيطان} [الانفال: ] وسوسته، فاطفا بالمطر " وروي عن عكرمة نحو ذلك
 
 اخبرنا العباس بن الوليد بن مزيد، قراءة، انبا ابن شعيب بن شابور، انبا سعيد بن بشير، عن قتادة، قوله: " {ويذهب عنكم رجز الشيطان} [الانفال: ] ما اوقع الشيطان في قلوبهم من الصلاة بغير طهور "
 
  الوجه الثاني
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، اخبرنا ابن زيد يعني عبد الرحمن، قوله: " {ويذهب عنكم رجز الشيطان} [الانفال: ] الذي القي في قلوبهم ليس لكم بهءلاء طاقة "
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، ثنا محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {ويذهب عنكم رجز الشيطان} [الانفال: ] اي ليذهب عنكم شك الشيطان، لتخويفه اياهم عدوهم، واستجلاد الارض لهم حتي انتهوا الي منزلهم الذي سبقوا اليه عدوهم "
 
  قوله تعالي: {وليربط علي قلوبكم} 
 [الانفال: ]
 
 اخبرنا العباس بن الوليد بن مزيد، قراءة، انبا ابن شعيب، انبا سعيد بن بشير، عن قتادة، في قوله: " {وليربط علي قلوبكم} [الانفال: ] ، قال: بالصبر "
 
  قوله تعالي: {ويثبت به الاقدام} 
 [الانفال: ]
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي، " {ويثبت به الاقدام} [الانفال: ] حتي يشتدوا علي الرمل وهو كهيءة الارض " وروي عن قتادة، قال: اقتتلوا علي كثيب اعفر، فلبده الله تعالي بالماء "
 
 حدثنا العباس بن الوليد بن مزيد، انبا ابن شعيب، انبا سعيد بن بشير، عن قتادة، في قوله: " {ويثبت به الاقدام} [الانفال: ] ، قال: كان بطن الوادي دهاسا، فلما مطروا اشتدت الرملة "
 
  قوله تعالي: {اذ يوحي ربك الي الملاءكة} 
 [الانفال: ]
 
 حدثنا ابو بكر بن ابي موسي الكوفي، ثنا محمد بن اسحاق المسيبي، ثنا محمد بن فليح، عن موسي بن عقبة، عن ابن شهاب: " ثم اخبرهم بما اوحي الله الي الملاءكة بنصرهم، فقال: {اذ يوحي ربك الي الملاءكة اني معكم} [الانفال: ] "
 
  قوله تعالي: {اني معكم} 
 [الانفال: ]
 
 اخبرنا ابو بدر عباد بن الوليد الغبري فيما كتب الي، قال: سمعت ابا سعيد يعني احمد بن داود الحداد، يقول: " لم يقل الله عز وجل لشء انه معه الا الملاءكة يوم بدر، قال: " {اني معكم} [الانفال: ] بالنصر "
 
  قوله تعالي: {فثبتوا الذين امنوا} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، ثنا ابو غسان زنيج، ثنا سلمة، عن محمد بن اسحاق، ثنا محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {فثبتوا الذين امنوا} [الانفال: ] اي وازروا الذين امنوا "
 
  قوله تعالي: {سالقي في قلوب الذين كفروا الرعب} 
 [الانفال: ]
 
 اخبرنا محمد بن سعد العوفي، فيما كتب الي، ثنا ابي، ثنا عمي الحسين، عن ابيه، عن جده، عن ابن عباس، قوله: " {سالقي في قلوب الذين كفروا الرعب} [الانفال: ] ، قال: قذف الله في قلب ابي سفيان الرعب فرجع الي مكة، فقال النبي صلي الله عليه وسلم: «ان ابا سفيان قد اصاب منكم طرفا، وقد رجع وقذف الله في قلبه الرعب»
 
  قوله تعالي: {فاضربوا فوق الاعناق} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو موسي الانصاري، ثنا يونس بن بكير، ثنا عيسي بن عبد الله السعدي التميمي يعني ابا جعفر الرازي، عن الربيع بن انس، قال: «كان الناس يوم بدر يعرفون قتلي الملاءكة ممن قتلوهم بضربهم فوق الاعناق وعلي البنان، مثل سمة النار قد احرق به»
 
 حدثنا علي بن الحسين، ثنا محمد بن علي بن حمزة، ثنا علي بن الحسين بن واقد، عن ابيه، عن يزيد النحوي، عن عكرمة، " {فاضربوا فوق الاعناق} [الانفال: ] ، يقول: الرءوس "
 
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ، عن عبيد بن سليمان، عن الضحاك، يقول: «اضربوا الرقاب»
 
  قوله تعالي: {واضربوا منهم كل بنان} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {واضربوا منهم كل بنان} [الانفال: ] ، يعني بالبنان: الاطراف "
 
 حدثنا ابو سعيد الاشج، ثنا ابن ادريس، عن ابيه، عن عطية، " {واضربوا منهم كل بنان} [الانفال: ] ، قال: كل مفصل " وروي عن عكرمة، والضحاك، والسدي، مثل ذلك
 
 حدثنا ابي، ثنا محمد بن وهب بن عطية السلمي، ثنا عبيد بن الوليد بن ابي الساءب، عن هقل بن زياد، عن الاوزاعي، في قوله: " {واضربوا منهم كل بنان} [الانفال: ] ، قال: اضرب منه الوجه والعين، وارمه بشهاب من نار، فاذا اخذته حرم ذلك كله عليك "
 
  قوله تعالي: {فان الله شديد العقاب} 
 [البقرة: ]
 
 حدثنا ابي، ثنا احمد بن عبدة، انبا حماد بن زيد، عن علي بن زيد، قال: «تلا مطرف هذه الاية» {شديد العقاب} [الانفال: ] ، قال: لو يعلم الناس قدر عقوبة الله ونقمة الله وباس الله ونكال الله لما رقي لهم دمع وما قرت اعينهم بشء "
 
  قوله تعالي: {يا ايها الذين امنوا} 
 [البقرة: ]
 
 حدثنا زيد بن اسماعيل الصاءغ، حدثني معاوية بن هشام، عن عيسي بن راشد، عن علي بن بذيمة، عن عكرمة، عن ابن عباس، قال: " ما انزل الله اية في القران {يا ايها الذين امنوا} [الانفال: ] الا ان عليا شريفها واميرها وسيدها، وما من اصحاب محمد احد الا وقد عوتب في القران الا علي بن ابي طالب، فانه لم يعاتب في شء منه "
 
 حدثنا ابو سعيد الاشج، ثنا عبدة بن سليمان، عن الاعمش، عن خيثمة، قال: " ما تقرءون في القران، {يا ايها الذين امنوا} [الانفال: ] ، «فانه في التوراة يا ايها المساكين»
 
 حدثنا ابي، ثنا نعيم بن حماد، ثنا عبد الله بن المبارك، اخبرنا مسعر، ثنا معن، وعون، او احدهما " ان رجلا، اتي عبد الله بن مسعود فقال: اعهد الي، فقال: اذا سمعت الله يقول: {يا ايها الذين امنوا} [الانفال: ] فارعها سمعك فانه خير يامر به، او شر ينهي عنه "
 
 حدثنا علي بن الحسين، ثنا عبد الرحمن بن ابراهيم دحيم، ثنا الوليد، عن الاوزاعي، عن الزهري، قال: " اذا قال الله: {يا ايها الذين امنوا} [الانفال: ] ، افعلوا، فالنبي صلي الله عليه وسلم منهم "
 
  قوله تعالي: {اذا لقيتم الذين كفروا زحفا} 
 [الانفال: ]
 
 حدثنا الاحمسي، ثنا وكيع، عن علي بن صالح، عن عثمان بن المغيرة الثقفي، عن مالك بن جوين الحضرمي، عن علي، رضي الله عنه، قال: «الفرار من الزحف من الكباءر»
 
 حدثنا ابو سعيد الاشج، حدثنا ابو اسامة، عن محمد بن عمرو، عن ابن سلمة، قال: " الموجبات الفرار من الزحف ثم قرا {اذا لقيتم الذين كفروا زحفا} [الانفال: ] "
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {يا ايها الذين امنوا اذا لقيتم الذين كفروا زحفا} [الانفال: ] ، يعني: يوم بدر "
 
  قوله تعالي: {فلا تولوهم الادبار} 
 [الانفال: ]
 
 ذكر عن عفان، ثنا عبد الواحد بن زياد، ثنا الحارث بن حصيرة، عن القاسم بن عبد الرحمن، عن ابيه، قال: قال عبد الله بن مسعود رضي الله عنه، «كنت مع النبي صلي الله عليه وسلم يوم حنين فولي الناس عنه، وبقيت معه في ثمانين رجلا من المهاجرين،» نكصنا علي اقدامنا نحوا من ثمانين قدما ولم نولهم الدبر وهم الذين انزل الله عليهم السكينة "
 
  قوله تعالي: {ومن يولهم يومءذ دبره} 
 [الانفال: ]
 
 حدثنا احمد بن سنان، ثنا زكريا بن يحيي بن صبيح، ثنا عبد الله بن العوام، انبا داود، عن ابي نضرة، عن ابي سعيد، في قوله: " {ومن يولهم يومءذ دبره} [الانفال: ] ، قال: انها لاهل بدر خاصة " وروي عن عمر بن الخطاب، وابن عمر، ونافع، وعكرمة، والحسن، والضحاك، وقتادة، والربيع بن انس، وابي نضرة، ويزيد بن ابي حبيب مثل ذلك
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، " {ومن يولهم يومءذ دبره} [الانفال: ] ، يعني: يوم بدر خاصة منهزما "
 
  قوله تعالي: {الا متحرفا لقتال} 
 [الانفال: ]
 
 وبه عن سعيد بن جبير، " {الا متحرفا لقتال} [الانفال: ] ، يعني مستطردا يريد الكرة علي المشركين " وروي عن السدي انه قال: «الاستطراد يريد العودة»
 
  والوجه الثاني
 
 حدثنا علي بن الحسين، ثنا ابو بكر بن ابي شيبة، ومحمد بن العلاء، قالا: ثنا ابو خالد الاحمر، عن جويبر، عن الضحاك، " {الا متحرفا لقتال} [الانفال: ] ، " وان المتحرف: المتقدم من اصحابه، ان يري عورة من العدو فيصيبها "
 
  قوله تعالي: {او متحيزا} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، " {او متحيزا الي فءة} [الانفال: ] ، يعني: «او ينحاز الي اصحابه من غير هزيمة»
 
  قوله تعالي: {الي فءة} 
 [الانفال: ]
 
 حدثنا ابو سعيد الاشج، ثنا ابن فضيل، عن يزيد بن ابي زياد، عن عبد الرحمن بن ابي ليلي، عن ابن عمر، قال: " كنت في غزوة في بعض مسايح النبي صلي الله عليه وسلم، فلقينا العدو فحاص الناس حيصة فكنت فيمن حاص، فلما اتينا المدينة فاتينا رسول الله قد هممنا بكذا وكذا، قال: " لا، انا فءة المسلمين ثم قرا {الا متحرفا لقتال او متحيزا الي فءة} [الانفال: ] "
 
 حدثنا ابي، ثنا حسان بن عبد الله المصري، ثنا خلاد بن سليمان الحضرمي، حدثنا نافع، انه سال ابن عمر قلت: " انا قوم لا نثبت عند قتال عدونا، ولا ندري من الفءة؟ امامنا او عسكرنا؟ فقال لي: " الفءة رسول الله صلي الله عليه وسلم فقلت: ان الله يقول: {اذا لقيتم الذين كفروا زحفا فلا تولوهم الادبار} [الانفال: ] ، قال: انما انزلت هذه الاية لاهل بدر، لا قبلها ولا بعدها "
 
 حدثنا ابي، ثنا سهل بن عثمان، ثنا يحيي بن ابي زاءدة، عن اسماعيل بن ابراهيم، عن عبد الملك بن عمير، قال: قال عمر بن الخطاب: «لا تغرنكم هذه الاية، فانما كانت يوم بدر، وانا فءة لكل مسلم»
 
 حدثنا علي بن الحسين، ثنا ابو بكر بن ابي شيبة، ومحمد بن العلاء، قالا: ثنا ابو خالد الاحمر، عن جويبر، عن الضحاك، " {او متحيزا الي فءة} [الانفال: ] والمتحيز الفار الي النبي صلي الله عليه وسلم واصحابه، كذلك من فر اليوم الي اميره واصحابه "
 
 حدثنا ابي، ثنا سهل بن عثمان، ثنا يحيي بن ابي زاءدة، عن المبارك، عن الحسن، " {او متحيزا الي فءة} [الانفال: ] ، قال: ذلك يوم بدر، اذا ترك النبي صلي الله عليه وسلم فاين يذهب؟ فمن فاء اليوم الي مصر من الامصار فقد فاء "
 
  قوله تعالي: {فقد باء بغضب} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، " {فقد باء بغضب من الله} [الانفال: ] ، يعني: فقد اوجب بغضب من الله "
 
  قوله تعالي: {بغضب من الله} 
 [البقرة: ]
 
 وبه، عن سعيد بن جبير، في قوله: " {بغضب} [الانفال: ] ، يقول: استوجبوا سخطا "
 
  قوله تعالي: {وماواه جهنم وبءس المصير} 
 [ال عمران: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو، ثنا سلمة بن الفضل، عن محمد بن اسحاق، حدثني محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {فقد باء بغضب من الله وماواه جهنم وبءس المصير} [الانفال: ] تحريضا لهم علي عدوهم لءلا ينكلوا عنهم اذا لقوهم، وقد وعدهم الله ما وعدهم "
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، " {فقد باء بغضب من الله وماواه جهنم وبءس المصير} [الانفال: ] ، «فهذا يوم بدر خاصة، كان الله عز وجل شده علي المسلمين يومءذ ليقطع دابر الكافرين وهو اول قتال قاتل فيه المشركين من اهل مكة»
 
  قوله تعالي: {فلم تقتلوهم ولكن الله قتلهم} 
 [الانفال: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، " {فلم تقتلوهم} [الانفال: ] لاصحاب محمد صلي الله عليه وسلم حين قال هذا قتلت يعني فلانا، وقال هذا: قتلت: يعني فلانا "
 
  قوله عز وجل: {وما رميت اذ رميت ولكن الله رمي} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا عبد الجبار بن سعيد بن نوفل بن مساحق العامري، ثنا يحيي بن محمد بن هاني، عن موسي بن يعقوب الزمعي، عن يزيد بن عبد الله، عن ابي بكر بن سليمان بن ابي حثمة، عن حكيم بن حزام، قال: " لما كان يوم بدر سمعنا صوتا، وقع من السماء الي الارض كانه صوت حصاة وقعت في طست، ورمي رسول الله صلي الله عليه وسلم بتلك الحصيات فانهزموا فذلك قول الله: {وما رميت اذ رميت ولكن الله رمي وليبلي المءمنين منه بلاء حسنا} [الانفال: ] "
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قال: " رفع رسول الله صلي الله عليه وسلم يده، فقال: «يا رب انك ان تهلك هذه العصابة فلن تعبد في الارض ابدا» ، فقال له جبريل عليه السلام: خذ قبضة من التراب فاخذ قبضة من التراب فرمي بها في وجههم، فما بقي من المشركين احد الا اصاب عينه ومنخريه وفمه تراب من تلك القبضة فولوا مدبرين "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، انبا ابن زيد، في قول الله: " {وما رميت اذ رميت} [الانفال: ] ، قال: هذا يوم بدر، " اخذ رسول الله صلي الله عليه وسلم ثلاث حصيات، فرمي بحصاة في ميمنة القوم وحصاة في ميسرة القوم، وحصاة بين اظهرهم، فقال: «شاهت الوجوه فانهزموا» ، فذلك قول الله: {وما رميت اذ رميت ولكن الله رمي} [الانفال: ] "
 
  الوجه الثاني
 
 حدثنا يونس بن عبد الاعلي، انبا عبد الله بن وهب، انبا يونس، عن ابن شهاب، اخبرني ابن المسيب، قال: " لما كان يوم احد اخذ ابي بن خلف يركض فرسه حتي دنا من رسول الله صلي الله عليه وسلم واعترض رجال من المسلمين لابي بن خلف ليقتلوه فقال لهم: فقال رسول الله صلي الله عليه وسلم: «استاخروا» ، فاستاخروا، فاخذ رسول الله صلي الله عليه وسلم حربته في يده فرمي ابي بن خلف وكسر ضلعا من اضلاعه، فرجع ابي بن خلف الي اصحابه ثقيلا فاحتملوه حتي ولوا قافلين فطفقوا يقولون: لا باس، فقال ابي حين قالوا ذلك له: والله لو كانت بالناس لقتلتهم، الم يقل: اني اقتلك، ان شاء الله تعالي؟ فانطلق به اصحابه يتغشونه حتي مات ببعض الطريق، فدفنوه. قال ابن المسيب: وفي ذلك انزل عز وجل {وما رميت اذ رميت} [الانفال: ] " الاية
 
  والوجه الثالث
 
 حدثنا ابو نشيط محمد بن هارون، ثنا ابو المغيرة يعني عبد القدوس بن الحجاج، ثنا صفوان، عن عبد الرحمن بن جبير، " ان رسول الله صلي الله عليه وسلم يوم ابن ابي الحقيق دعا بقوس، فاتي بقوس طويلة، فقال: «جيءوني بقوس غيرها» فجاءه
  [ص: ]
 بقوس كبداء، فرمي رسول الله صلي الله عليه وسلم الحصن، فاقبل السهم يهوي حتي قتل ابن ابي الحقيق في فراشه، فانزل الله عز وجل {وما رميت اذ رميت ولكن الله رمي} [الانفال: ] " قال ابو المغيرة: الكبداء: المعتدلة الجيدة
 
  قوله تعالي: {ولكن الله رمي} 
 [الانفال: ]
 
 حدثنا ابي، ثنا نعيم بن حماد، ومحمد بن عبد الاعلي، قالا: ثنا محمد بن ثور، عن معمر، عن ايوب، عن عكرمة، " {ولكن الله رمي} [الانفال: ] ، قال: ما وقع منها شء الا في عين رجل "
 
 حدثنا محمد بن العباس، ثنا ابو غسان محمد بن عمر زنيج، ثنا سلمة، عن محمد بن اسحاق، قال: وحدثني محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {ولكن الله رمي} [الانفال: ] اي لم يكن ذلك برميتك، لولا الذي جعل الله من نصرك، وما القي في صدور عدوك منها حتي هزمتهم "
 
  قوله تعالي: {وليبلي المءمنين منه بلاء حسنا} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، قال: وحدثني محمد بن الزبير، عن عروة بن الزبير، " {وليبلي المءمنين منه بلاء حسنا} [الانفال: ] اي ليعرف المءمنين من نعمته عليهم في اظهارهم علي عدوهم مع كثرة عدوهم وقلة عددهم ليعرفوا بذلك حقه ويشكروا بذلك نعمته "
 
  قوله تعالي: {ان الله سميع عليم} 
 [البقرة: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا زنيج، ثنا سلمة، ثنا ابن اسحاق، " {عليم} [الانفال: ] ، اي: عليم بما يخفون "
 
  قوله تعالي: {ذلكم وان الله موهن كيد الكفرين}
 
 حدثنا موسي بن ابي موسي الخطمي، ثنا هارون بن حاتم، حدثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك، قوله: " {موهن} [الانفال: ] يعني: ضعيف "
 
  قوله تعالي: {ان تستفتحوا فقد جاءكم الفتح} 
 [الانفال: ]
 
 حدثنا ابو عبيد الله ابن اخي ابن وهب، حدثني شعيب بن الليث، ثنا ابي، اخبرني عقيل، عن ابن شهاب، ان عبد الله بن ثعلبة بن صعير العذري، حليف بني زهرة، حدثه: " ان المستفتح يوم بدر ابو جهل، وانه قال: اللهم اينا اقطع للرحم، واتي بما لا يعرف فاخزه الغداة، فكان ذلك استفتاحه فقال الله تعالي: {ان تستفتحوا فقد جاءكم الفتح} [الانفال: ] " الاية
 
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {ان تستفتحوا فقد جاءكم الفتح} [الانفال: ] ، يعني بذلك: المشركين وان تستنصروا فقد جاءكم المدد "
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو زنيج، ثنا سلمة بن الفضل، عن محمد بن اسحاق، ثنا محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {ان تستفتحوا فقد جاءكم الفتح} [الانفال: ] ، اي: لقول ابي جهل: اللهم اقطعنا للرحم واتانا بما لا يعرف فاحنه الغداة، والاستفتاح: الانصاف في الدعاء "
 
 حدثنا ابو سعيد الاشج، ثنا اسباط، عن مطرف، عن عطية، في قول الله: " {ان تستفتحوا فقد جاءكم الفتح} [الانفال: ] ، قال ابو جهل: اللهم انصر اعز الفءتين واكرم الفرقتين فنزلت: {ان تستفتحوا فقد جاءكم الفتح} [الانفال: ] "
 
  قوله تعالي: {فقد جاءكم الفتح} 
 [الانفال: ]
 
 حدثنا ابي، حدثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، " {فقد جاءكم الفتح} [الانفال: ] ، فقد جاءكم المدد "
 
 اخبرنا العباس بن الوليد بن مزيد، قراءة، اخبرني ابن شعيب، اخبرني عثمان بن عطاء، عن ابيه، " {فقد جاءكم الفتح} [الانفال: ] ، يعني: «اصحاب محمد صلي الله عليه وسلم»
 
  الوجه الثاني
 
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا ابو داود، ثنا سهل بن السراج، قال: سمعت الحسن، في قول الله: " {ان تستفتحوا فقد جاءكم الفتح} [الانفال: ] ، قال: القضاء " وروي عن عكرمة مثل ذلك
 
  قوله تعالي: {وان تنتهوا فهو خير لكم} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، ثنا محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {وان تنتهوا} [الانفال: ] اي لقريش فهو خير لكم "
 
 ذكر عن عمرو العنقزي، ثنا اسباط، عن السدي، " {وان تنتهوا فهو خير لكم} [الانفال: ] ، قال: ان تنتهوا عن قتال محمد صلي الله عليه وسلم "
 
  قوله تعالي: {وان تعودوا نعد} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة، عن ابن اسحاق، حدثني محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {وان تعودوا نعد} [الانفال: ] اي بمثل الواقعة التي اصابكم بها يوم بدر "
 
 اخبرنا احمد بن عثمان الاودي، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، " {وان تعودوا نعد} [الانفال: ] ، يقول: ان تستفتحوا الثانية افتح لمحمد صلي الله عليه وسلم "
 
  قوله تعالي: {ولن تغني عنكم فءتكم شيءا ولو كثرت} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، حدثني محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {ولن تغني عنكم فءتكم شيءا} [الانفال: ] ، اي وان كثر عددكم في انفسكم لم يغن عنكم شيءا "
 
  قوله تعالي: {وان الله مع المءمنين} 
 [الانفال: ]
 
 وبه، عن عروة بن الزبير، " {وان الله مع المءمنين} [الانفال: ] ، وانا مع المءمنين، انصرهم علي من خالفهم "
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، " {وان الله مع المءمنين} [الانفال: ] مع محمد صلي الله عليه وسلم واصحابه رضي الله عنهم "
 
  قوله تعالي: {ولا تولوا عنه وانتم تسمعون} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة، عن ابن اسحاق، حدثني محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {ولا تولوا عنه وانتم تسمعون} [الانفال: ] ، اي: لا تخالفوا امره وانتم تسمعون "
 
  قوله تعالي: {ولا تكونوا كالذين قالوا سمعنا} 
 [الانفال: ]
 
 وبه، عن محمد بن اسحاق، " {ولا تكونوا كالذين قالوا سمعنا وهم، لا يسمعون} [الانفال: ] ، اي: كالمنافقين الذين يظهرون له بالطاعة، ويسرون له المعصية "
 
  قوله تعالي: {وهم لا يسمعون} 
 [الانفال: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {وهم لا يسمعون} [الانفال: ] عاصين "
 
  قوله تعالي: {ان شر الدواب عند الله} 
 [الانفال: ]
 
 حدثنا علي بن الحسين، ثنا احمد بن صالح، ثنا عنبسة بن خالد، عن يونس، عن ابن شهاب، حدثني ابو عثمان بن سنة الخزاعي الكعبي، وهو من اهل دمشق انه " لحق بعلي بن ابي طالب رضي الله عنه، انه كان معه فخلا به يوما وهو يحدثنا فيما انزلت هذه الاية التي قال الله: " {ان شر الدواب عند الله} [الانفال: ] ، ثم قال: «ان هذه الاية انزلت في فلان واصحاب له»
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، انبا ابن زيد، في قوله: " {ان شر الدواب عند الله} [الانفال: ] ، قال: الدواب: الخلق، وقرا {ولو يءاخذ الله الناس بما كسبوا ما ترك علي ظهرها من دابة} [فاطر: ] ، {وما من دابة في الارض الا علي الله رزقها} [هود: ] ، قال: هذا يدخل في هذا "
 
  قوله تعالي: {الصم} 
 [الانفال: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قال: كان ابن عباس يقول: " {الصم البكم الذين لا يعقلون} [الانفال: ] ، نفر من بني عبد الدار "
 
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد، عن قتادة: «صم عن الحق، فهم لا يسمعونه»
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، ثنا ابن زيد عبد الرحمن، في قول الله: " {الصم} [الانفال: ] وليس بالصم في الدنيا ولكن صم القلب "
 
  قوله تعالي: {البكم} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {ان شر الدواب عند الله الصم البكم} [الانفال: ] ، قال: الابكم: الاخرس "
 
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد بن بشير، عن قتادة، قال: «بكم فهم لا ينطقون به»
 
  قوله تعالي: {الذين لا يعقلون} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، ثنا جعفر بن الزبير، عن عروة بن الزبير، " {ان شر الدواب عند الله الصم البكم الذين لا يعقلون} [الانفال: ] اي المنافقين لا يعرفون ما عليهم في ذلك من النقمة والتباعة "
 
 حدثنا ابي، حدثنا ابو حذيفة، ثنا شبل، عن ابن ابي نجيح، عن مجاهد، عن ابن عباس، " {الصم البكم الذين لا يعقلون} [الانفال: ] لا يتبعون الحق "
 
  قوله تعالي: {ولو علم الله فيهم خيرا لاسمعهم} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة بن الفضل، عن محمد بن اسحاق، حدثني محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {ولو علم الله فيهم خيرا لاسمعهم} [الانفال: ] اي لانفذ لهم قولهم الذي قالوا بالسنتهم، ولكن القلوب خالفت ذلك منهم "
 
  قوله تعالي " {ولو اسمعهم} 
 [الانفال: ]
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، حدثني اصبغ، انبا ابن زيد عبد الرحمن، قوله: " {ولو اسمعهم} [الانفال: ] بعد اذ يعلم ان لا خير فيهم ما نفعهم بعد ان ينفذ علمهم بانهم لا ينتفعون به "
 
  قوله تعالي: {لتولوا وهم معرضون} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، حدثني محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {ولو اسمعهم لتولوا وهم معرضون} [الانفال: ] ولو خرجوا معكم لتولوا وهم معرضون ما وفوا لكم بشء مما خرجوا عليه "
 
  قوله تعالي: {استجيبوا لله وللرسول} 
 [الانفال: ]
 
 حدثنا يونس بن حبيب، حدثنا ابو داود، حدثنا شعبة، عن خبيب بن عبد الرحمن، قال: سمعت حفص بن عاصم، يحدث، عن ابي سعيد بن المعلي، " ان رسول الله صلي الله عليه وسلم كان في المسجد وانا اصلي، فدعاني فصليت ثم جءت، فقال: " ما منعك ان تجيب حين دعوتك؟ اما سمعت الله عز وجل يقول: {يا ايها الذين امنوا استجيبوا لله وللرسول اذا دعاكم لما يحييكم} [الانفال: ] "
 
  قوله تعالي: {اذا دعاكم} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، قال: ثنا محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {يا ايها الذين امنوا استجيبوا لله وللرسول اذا دعاكم لما يحييكم} [الانفال: ] اي الحرب التي اعزكم الله بها بعد الذل وقواكم بها بعد الضعف، ومنعكم بها من عدوكم بعد القهر منهم لكم "
 
  قوله تعالي: {لما يحييكم} 
 [الانفال: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {لما يحييكم} [الانفال: ] للحق "
 
  الوجه الثاني
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، عن سعيد، عن قتادة، قوله: " {اذا دعاكم لما يحييكم} [الانفال: ] ، قال: «هو هذا القران، فيه الحياة والثقة والنجاة والعصمة في الدنيا والاخرة»
 
  الوجه الثالث
 
 اخبرنا احمد بن عثمان بن حكيم الودي، فيما كتب الي، ثنا احمد بن مفضل، حدثنا اسباط، عن السدي، " اما {يحييكم} [الانفال: ] «ففي الاسلام، احياهم بعد موتهم بعد كفرهم»
 
  الوجه الرابع
 
 حدثنا ابي، حدثنا الحسن بن الربيع، حدثنا ابن ادريس، عن ابن اسحاق، " {اذا دعاكم لما يحييكم} [الانفال: ] ، يقول: للحرب الذي اعزكم الله بها بعد الذل وقواكم بها بعد الضعف "
 
  قوله تعالي: {واعلموا ان الله يحول بين المرء وقلبه} 
 [الانفال: ]
 
 حدثنا ابي، ثنا احمد بن عبد الرحمن الدشتكي، ثنا عبد الله بن ابي جعفر الرازي، عن ابيه، عن الربيع بن انس، قوله: " {واعلموا ان الله يحول بين المرء وقلبه} [الانفال: ] ، قال: علمه يحول بين المرء وقلبه "
 
  قوله تعالي: {يحول بين المرء وقلبه} 
 [الانفال: ]
 
 حدثنا ابو سعيد الاشج، ثنا ابن فضيل، عن الاعمش، عن عبد الله بن عبد الله الرازي، عن سعيد بن جبير، عن ابن عباس، " {يحول بين المرء وقلبه} [الانفال: ] ، قال: يحول بين المءمن وبين الكفر ومعاصي الله، ويحول بين الكافر وبين الايمان وطاعة الله "
 
 حدثنا علي بن الحسين، ثنا محمد بن سليمان، ثنا اسماعيل بن زكريا، عن محمد بن عون الخراساني، عن ابي غالب الخلجي، قال: سالت ابن عباس عن قول الله: " {يحول بين المرء وقلبه} [الانفال: ] ، قال: يحول بين المءمن وبين معصيته التي يستوجب
  [ص: ]
 بها الهلكة، فلا بد لابن ادم ان يصيب دون ذلك، ولا يدخل علي قلبه الموبقات التي يستوجب بها دار الفاسقين، ويحول بين الكافر وبين طاعته فلا يصيب من طاعته ما يستوجب ما يصيب اولياءه من الخير شيءا وكان ذلك في العلم السابق الذي ينتهي اليه امر الله وتستقر عنده اعمال العباد "
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {يحول بين المرء وقلبه} [الانفال: ] حتي يتركه لا يعقل "
 
 حدثنا ابي، ثنا ابو حذيفة، عن شبل، عن ابن ابي نجيح، عن مجاهد، «حتي يتركه لا يعقل» وروي عن سعيد بن جبير، وعكرمة، وابي صالح، ومجاهد، والسدي انهم قالوا: يحول بين المءمن ان يكفر وبين الكافر ان يءمن وقال الضحاك، وعطية، ومقاتل بن حيان: بين الكافر وبين طاعته، وبين المءمن ومعصيته
 
 حدثنا ابي، ثنا احمد بن عبد الرحمن، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع، في قوله: " {واعلموا ان الله يحول بين المرء وقلبه} [الانفال: ] ، قال: علمه يحول بين المرء وقلبه "
 
  قوله تعالي: {وانه اليه تحشرون} 
 [الانفال: ]
 
 قرات علي محمد بن الفضل بن موسي، ثنا محمد بن الحسن بن شقيق، انبا محمد بن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان، " {وانه اليه تحشرون} [الانفال: ] يعني: اليه ترجعون "
 
  قوله تعالي: {واتقوا فتنة} 
 [الانفال: ]
 
 حدثنا ابي، ثنا محمد بن عبد الرحمن الجعفي، ثنا الحسين الجعفي، عن اسراءيل بن موسي، عن الحسن، قال: «قرا الزبير» {واتقوا فتنة لا تصيبن الذين ظلموا} [الانفال: ] ، قال: البلاء والامر الذي هو كاءن "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ، عن ابن زيد، في قول الله: " {واتقوا فتنة لا تصيبن الذين ظلموا منكم خاصة} [الانفال: ] ، قال: الفتنة: الضلالة "
 
 حدثنا ابي، ثنا قبيصة، ثنا سفيان، عن ابي شعيب الصلت بن دينار، عن عقبة بن صهبان، قال: سمعت الزبير، يقول: " لقد قراناها زمانا وما نري انا من اهلها، فاذا نحن المعنيين بها {واتقوا فتنة لا تصيبن الذين ظلموا منكم خاصة} [الانفال: ] "
 
 حدثنا ابي، واسماعيل بن عبد الله الاصبهاني، قالا: ثنا شهاب بن عباد، ثنا ابراهيم بن حميد، عن اسماعيل بن ابي خالد، عن السدي، " {واتقوا فتنة لا تصيبن الذين ظلموا منكم خاصة} [الانفال: ] ، قال: اخبرت انهم اصحاب الجمل "
 
  الوجه الثاني
 
 حدثنا ابي، ثنا ابو صالح، حدثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، " {واتقوا فتنة لا تصيبن الذين ظلموا منكم خاصة} [الانفال: ] امر الله المءمنين ان لا يقروا المنكر بين اظهرهم فيعمهم الله بالعذاب "
 
  الوجه الثالث
 
 حدثنا ابي، ثنا ابن ابي عمر، ثنا سفيان بن عيينة، عن الضحاك، في قوله: " {واتقوا فتنة لا تصيبن الذين ظلموا منكم خاصة} [الانفال: ] ، قال: تصيب الصالح والظالم عامة " وروي عن حبيب بن ابي ثابت نحو ذلك
 
  قوله تعالي: {واذكروا اذ انتم قليل مستضعفون} 
 [الانفال: ]
 
 اخبرنا موسي بن هارون الطوسي، فيما كتب الي، ثنا الحسين بن محمد المروذي، ثنا شيبان، عن قتادة، قوله: " {واذكروا اذ انتم قليل مستضعفون في الارض} [الانفال: ] ، قال: كان اصحاب النبي صلي الله عليه وسلم يومءذ ثلاثماءة وبضعة عشر، والمشركون الفا يومءذ او راهقوا ذلك، وكان اول قتال قاتله نبي الله صلي الله عليه وسلم يوم بدر "
 
  قوله تعالي: {تخافون ان يتخطفكم الناس} 
 [الانفال: ]
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي، انبا محمد بن ثور، عن معمر، عن قتادة، او رجل نسيه، او كلاهما، " {واذكروا اذ انتم قليل مستضعفون} [الانفال: ] ، انها نزلت في يوم بدر وكانوا يومءذ يخافون ان يتخطفهم الناس "
 
  قوله تعالي: {الناس} 
 [البقرة: ]
 
 اخبرنا ابو عبد الله الطهراني، فيما كتب الي، انبا اسماعيل بن عبد الكريم، حدثنا عبد الصمد بن معقل، انه سمع وهبا، يقول: قرا " {واذكروا اذ انتم قليل مستضعفون في الارض تخافون ان يتخطفكم الناس} [الانفال: ] والناس اذ ذاك فارس والروم "
 
  قوله تعالي: {فاواكم} 
 [الانفال: ]
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {فاواكم} [الانفال: ] ، قال: الي الانصار بالمدينة "
 
  قوله تعالي: {وايدكم بنصره} 
 [الانفال: ]
 
 وبه، عن السدي، قوله: " {وايدكم بنصره} [الانفال: ] هءلاء اصحاب النبي صلي الله عليه وسلم ايدهم بنصره يوم بدر "
 
  قوله تعالي: {ورزقكم من الطيبات} 
 [الانفال: ]
 
 قرات علي محمد بن الفضل، ثنا محمد بن علي، انبا محمد بن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان، قوله: " {من الطيبات} [الانفال: ] ، يعني: الحلال من الرزق "
 
  قوله تعالي: {لعلكم} 
 [البقرة: ]
 
 حدثنا ابو بكر بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك، قوله: " {لعلكم} [الانفال: ] ، يعني كي "
 
  قوله تعالي: {تشكرون} 
 [البقرة: ]
 
 حدثنا محمد بن العباس، ثنا زنيج، ثنا سلمة، قال محمد بن اسحاق، " {لعلكم تشكرون} [الانفال: ] ، اي فاتقوني، فانه شكر نعمتي "
 
  قوله تعالي: {لا تخونوا الله} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {يا ايها الذين امنوا لا تخونوا الله} [الانفال: ] ، يقول: بترك فراءضه "
 
 حدثنا ابي، ثنا ابن ابي عمر العدني، ثنا سفيان، عن اسماعيل بن ابي خالد، عن عبد الله بن ابي قتادة، انه سمعه في مسجد الكوفة يقول: فنزلت هذه الاية: " {يا ايها الذين امنوا لا تخونوا الله والرسول وتخونوا اماناتكم} [الانفال: ] نزلت في ابن لبابة بن عبد المنذر حين اشار الي بني قريظة ان الذبح "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، انبا ابن زيد، في قول الله تعالي: {يا ايها الذين امنوا لا تخونوا الله والرسول} [الانفال: ] ، قال: «نهاهم ان يخونوا الله والرسول، كما صنع المنافقون»
 
  الوجه الثاني
 
 حدثنا ابي، ثنا عبد الرحمن بن الضحاك، ثنا الوليد، ثنا مسلمة بن علي، عن يزيد بن ابي حبيب، في قول الله: " {لا تخونوا الله والرسول} [الانفال: ] ، قال: الاخلال بالسلاح في البعوث "
 
  قوله تعالي: {والرسول} 
 [ال عمران: ]
 
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، " {يا ايها الذين امنوا لا تخونوا الله والرسول} [الانفال: ] ، قال: والرسول يقول: بترك سنته وارتكاب معصيته "
 
 حدثنا محمد بن العباس، حدثنا ابو غسان محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، قال: وحدثني محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {يا ايها الذين امنوا لا تخونوا الله والرسول} [الانفال: ] اي لا تظهروا له من الحق ما يرضي به منكم، ثم تخالفونه في السر الي غيره، فان ذلك هلاك لاماناتكم وخيانة لانفسكم "
 
  قوله تعالي: {وتخونوا اماناتكم} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {وتخونوا اماناتكم} [الانفال: ] والامانة: الاعمال التي اءتمن الله عليها العباد، يعني: الفريضة، يقول: لا تخونوا، يعني: لا تنقصوها "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ، انبا ابن زيد، في قول الله: " {وتخونوا اماناتكم} [الانفال: ] ، قال: اماناتكم: دينكم "
 
  الوجه الثاني
 
 حدثنا ابي، ثنا الوليد، ثنا مسلمة بن علي، عن يزيد بن ابي حبيب، في قوله: " {يا ايها الذين امنوا لا تخونوا الله والرسول وتخونوا اماناتكم} [الانفال: ] ، قال: «هذا الاخلال بالسلاح في البعوث»
 
  قوله تعالي: {وانتم معرضون} 
 [البقرة: ]
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن زيد، في قول الله: " {وتخونوا اماناتكم وانتم تعلمون} [الانفال: ] ، قال: «قد فعل ذلك المنافقون، وهم يعلمون انهم كفار يظهرون الايمان»
 
  قوله تعالي: {واعلموا انما اموالكم واولادكم فتنة} 
 [الانفال: ]
 
 حدثنا ابي، ثنا مقاتل بن محمد، ثنا وكيع، عن المسعودي، عن القاسم، قال: قال عبد الله: " ما منكم من احد الا وهو مشتمل علي فتنة، لان الله تعالي: يقول: {انما اموالكم واولادكم فتنة} [التغابن: ] ، فمن استعاذ منكم، فليستعذ بالله من مضلات الفتن "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ، انبا عبد الرحمن بن زيد بن اسلم، في قول الله: " {انما اموالكم واولادكم فتنة} [التغابن: ] ، قال: اختبارا لهم وقرا قول الله: {ونبلوكم بالشر والخير فتنة والينا ترجعون} [الانبياء: ] "
 
  قوله تعالي: {وان الله عنده اجر عظيم} 
 [الانفال: ]
 
 حدثنا ابي، ثنا محمد بن عبد الله بن نمير، ثنا ابو خالد الاحمر، عن داود بن ابي هند، عن علي بن زيد، عن ابي عثمان، عن ابي هريرة، " {اجر عظيم} [الانفال: ] ، قال: الجنة " وروي عن الحسن، وسعيد بن جبير، وعكرمة، والضحاك، وقتادة نحو ذلك
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا ابن لهيعة، ثنا عطية بن دينار، عن سعيد بن جبير، في قول الله " {اجر عظيم} [الانفال: ] ، يعني جزاء وافرا "
 
  قوله تعالي: {يجعل لكم فرقانا} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {يجعل لكم فرقانا} [الانفال: ] ، يقول: نصرا "
 
  الوجه الثاني
 
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {يا ايها الذين امنوا ان تتقوا الله يجعل لكم فرقانا} [الانفال: ] والفرقان: المخرج " وروي عن مجاهد، وعكرمة، والضحاك، وقتادة، والسدي، ومقاتل بن حيان غير ان مجاهدا قال: «مخرجا في الدنيا والاخرة» وفي احد قولي ابن عباس، والسدي: " نجاة يوم القيامة
 
  الوجه الثالث
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة بن الفضل، عن محمد بن اسحاق، ثنا محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {يجعل لكم فرقانا} [الانفال: ] اي فصلا بين الحق والباطل، يظهر الله به حقكم ويطفء به باطل من خالفكم "
 
  قوله تعالي: {ويكفر عنكم سيءاتكم} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابراهيم بن مهدي، ثنا يحيي بن يعلي، عن منصور او ليث، عن مجاهد، في قوله «يغفر الكثير من الذنوب لمن يشاء» وروي عن الثوري مثل ذلك
 
  قوله تعالي: {والله ذو الفضل العظيم} 
 [البقرة: ]
 
 حدثنا ابي، ثنا عبد الله بن صالح بن مسلم، انبا فضيل بن مرزوق، عن عطية، حدثني ابن عباس، قال:؟ «اذا قال الله للشء عظيم فهو عظيم»
 
 حدثنا ابو زرعة، ثنا ابن بكير، ثنا ابن لهيعة، ثنا عطاء بن دينار، عن سعيد بن جبير، قوله: " {العظيم} [الانفال: ] ، يعني: وافرا "
 
  قوله تعالي: {واذ يمكر بك الذين كفروا} 
 [الانفال: ]
 
 حدثنا علي بن الحسين، ثنا ابراهيم بن سعيد الجوهري، ثنا يحيي بن سعيد الاموي، عن محمد بن اسحاق، عن ابن ابي ليلي، عن مجاهد، عن ابن عباس
 
 : " ان نفرا، من قريش ومن اشراف كل قبيلة، اجتمعوا ليدخلوا دار الندوة واعترضهم ابليس في صورة شيخ جليل، فلما راوه قالوا: من انت؟ قال: شيخ من اهل نجد، سمعت بما اجتمعتم له فاردت ان احضركم ولن يعدمكم مني راي ونصح قالوا: اجل، فادخل، فدخل معهم، قال: انظروا في شان هذا الرجل فوالله ليوشكن ان يواثبكم في امركم بامره، فقال قاءل: احبسوه في وثاق ثم تربصوا به المنون حتي يهلك، كما هلك من كان قبله من الشعراء زهير ونابغة، فانما هو كاحدهم، فقال عدو الله الشيخ النجدي: لا والله، ما هذا لكم براي والله ليخرجن رايه من محبسه الي اصحابه فليوشكن ان يثبوا عليه حتي ياخذوه من ايديكم، ثم يمنعوه منكم فما امن عليكم ان يخرجوكم من بلادكم، فانظروا في غير هذا الراي، فقال قاءل: فاخرجوه من بين اظهركم فاستريحوا منه فانه اذا خرج لم يضركم ما صنع واين وقع واذا غاب عنكم اذاه استرحتم منه وكان امره في غيركم، فقال الشيخ النجدي: والله ما هذا لكم براي، الم تروا حلاوة قوله وطلاقة لسانه واخذه للقلوب بما يستمع من حديثه؟ والله لءن فعلتم ثم استعرض العرب ليجتمعن عليه، ثم ليسيرن اليكم حتي يخرجكم من بلادكم ويقتل اشرافكم، قالوا: صدق والله، فانظروا رايا غير هذا، فقال ابو جهل: والله لاشيرن عليكم براي ما اري ابصرتموه بعد ما اري غيره، قالوا: وما هذا؟ قال: ناخذ من كل قبيلة غلاما سبطا شابا نهدا، ثم نعطي كل غلام منهم سيفا صارما، ثم يضربونه يعني: ضربة رجل واحد، فاذا قتلتموه تفرق دمه في القباءل كلها فلا اظن هذا الحي من بني هاشم يقوون علي حرب قريش كلهم، وانهم اذا راوا ذلك قبلوا العقل واسترحنا وقطعنا عنا اذاه، فقال الشيخ النجدي: هذا والله هو الراي، القول ما قال الفتي لا راي غيره، فتفرعوا علي ذلك وهم مجمعون له، قال: فاتي جبريل رسول الله صلي الله عليه وسلم فامره ان لا يبيت في مضجعه الذي كان يبيت، واخبره بمكر القوم فلم يبت رسول الله صلي الله عليه وسلم في بيته تلك الليلة واذن الله له عند ذلك في الخروج، وانزل عليه بعد قدومه المدينة في الانفال يذكر نعمته عليه وبلاءه عنده، {واذ يمكر بك الذين كفروا ليثبتوك او يقتلوك او يخرجوك ويمكرون ويمكر الله والله خير الماكرين} [الانفال: ] "
 
  قوله تعالي: {ليثبتوك} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {واذ يمكر بك الذين كفروا ليثبتوك} [الانفال: ] ، يعني: ليوثقوك " وروي عن قتادة نحو ذلك
 
  والوجه الثاني
 
 ذكره الحسن بن محمد بن الصباح، ثنا حجاج، عن ابن جريج، قال: وانبا عطاء، وابن كثير، " {ليثبتوك} [الانفال: ] ، انها: ليسجنوك " وروي عن السدي، انه قال: «يحبسوك ويوثقوك»
 
  قوله تعالي: {او يقتلوك} 
 [الانفال: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، " {ليثبتوك او يقتلوك او يخرجوك} [الانفال: ] ، كفار قريش حين ارادوا ذلك بمحمد صلي الله عليه وسلم قبل ان يخرج من مكة "
 
  قوله تعالي: {او يخرجوك} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابراهيم بن موسي، انبا هشام بن يوسف، عن ابن جريج، اخبرني عطاء، عن عبيد بن عمير، " ان ابا طالب، قال للنبي صلي الله عليه وسلم: هل تدري ما اءتمر فيك قومك؟ قال: «نعم، اءتمروا ان يسجنوني او يقتلوني او يخرجوني» ، قال: من اخبرك هذا؟ قال: «ربي» ، قال: نعم الرب ربك فاستوص به خيرا، قال: «انا استوصي به او هو يستوصي بي؟»
 
  قوله تعالي: {ويمكرون ويمكر الله والله خير الماكرين} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو زنيج، حدثنا سلمة، عن محمد بن اسحاق، حدثنا محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {ويمكرون ويمكر الله والله خير الماكرين} [الانفال: ] ، اي فمكرت بهم بكيدي المتين حتي خلصتك منهم "
 
  قوله تعالي: {واذا} 
 [البقرة: ]
 
 حدثنا ابو بكر بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط بن نصر، عن السدي، عن ابي مالك، قوله: " {اذا} [الانفال: ] يعني: لم يكن "
 
  قوله تعالي: {واذا تتلي عليهم اياتنا قالوا قد سمعنا لو نشاء لقلنا مثل هذا} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو مسلم احمد بن ابي شعيب، ثنا مسكين بن بكير، عن شعبة، عن ابي بشر، عن سعيد بن جبير، " {واذا تتلي عليهم اياتنا قالوا قد سمعنا لو نشاء لقلنا مثل هذا} [الانفال: ] ، قال: هو النضر بن الحارث "
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن المفضل، عن اسباط، عن السدي، قال: " كان النضر بن الحارث بن علقمة من بني عبد الدار يختلف في الحيرة، فيسمع سجع اهلها وكلامهم، فلما قدم مكة سمع كلام النبي صلي الله عليه وسلم والقران فقال: {قد سمعنا لو نشاء لقلنا مثل هذا ان هذا الا اساطير الاولين} [الانفال: ] "
 
  قوله تعالي: {ان هذا الا اساطير الاولين} 
 [الانعام: ]
 
 وبه، عن السدي، قوله: " {ان هذا الا اساطير الاولين} [الانفال: ] ، يقول: اساجيع "
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، قوله: " {اساطير الاولين} [الانعام: ] اي احاديث الاولين وباطلهم "
 
  قوله تعالي: {الاولين} 
 [الانعام: ]
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي، قوله: " {ان هذا الا اساطير الاولين} [الانفال: ] ، يقول: اساجيع اهل الحيرة "
 
 حدثنا ابو بكر بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط بن نصر، عن السدي، عن ابي مالك، قوله: " {واذ} [الانفال: ] فقد كان "
 
  قوله تعالي: {واذ قالوا اللهم ان كان هذا هو الحق من عندك} 
 [الانفال: ]
 
 حدثنا ابي، ثنا عبيد الله بن معاذ، حدثنا ابي، ثنا شعبة، عن عبد الحميد، صاحب الزيادي سمع انس بن مالك، قال: " قال ابو جهل: " {اللهم ان كان هذا هو
  [ص: ]
 الحق من عندك فامطر علينا حجارة من السماء او اءتنا بعذاب اليم} [الانفال: ] ، فنزلت: {وما كان الله ليعذبهم وانت فيهم وما كان الله معذبهم وهم يستغفرون} [الانفال: ] الي اخر الاية "
 
  الوجه الثاني
 
 حدثنا ابي، ثنا عيسي بن جعفر، قاضي الري، ثنا سفيان، عن الاعمش، عن رجل، عن سعيد بن جبير، عن ابن عباس، في قوله: " {اللهم ان كان هذا هو الحق من عندك} [الانفال: ] ، قال: هو النضر بن الحارث "
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي، قال: " قال النضر بن الحارث: " اللهم ان كان ما يقول محمد {هو الحق من عندك فامطر علينا حجارة من السماء} [الانفال: ] " وروي عن سعيد بن جبير مثل ذلك
 
  الوجه الثالث
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، عن سعيد، عن قتادة، قوله: " {واذ قالوا اللهم ان كان هذا هو الحق من عندك} [الانفال: ] ، قال: قال ذلك سفهة هذه الامة وجهلتها، فعاد الله بعاءدته علي سفهة هذه الامة وجهلتها "
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، قال: وحدثني محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {واذ قالوا اللهم ان كان هذا هو الحق من عندك} [الانفال: ] اي ما جاء به محمد صلي الله عليه وسلم "
 
  قوله تعالي: {فامطر علينا حجارة من السماء} 
 [الانفال: ]
 
 وبه عن عروة بن الزبير، " ثم ذكر غرة قريش واستفتاحهم علي انفسهم {واذ قالوا اللهم ان كان هذا هو الحق من عندك فامطر علينا حجارة من السماء} [الانفال: ] اي كما امطرتها علي قوم لوط "
 
  قوله تعالي: {او اءتنا بعذاب اليم} 
 [الانفال: ]
 
 حدثنا ابي، ثنا عيسي بن جعفر، قاضي الري، ثنا سفيان، عن الاعمش، عن رجل، عن سعيد بن جبير، عن ابن عباس، في قوله: " {فامطر علينا حجارة من السماء او اءتنا بعذاب اليم} [الانفال: ] ، قال: " هو النضر بن الحارث يعني ابن كلدة، قال: فانزل الله عز وجل: {سال ساءل بعذاب واقع للكافرين ليس له دافع} [المعارج: ] "
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، قال: وحدثني محمد بن جعفر بن الزبير، عن عروة بن الزبير، " {او اءتنا بعذاب اليم} [الانفال: ] ، اي ببعض ما عذبت به الامم قبلنا "
 
  قوله تعالي: {اليم} 
 [البقرة: ]
 
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع بن انس، عن ابي العالية، في قوله: " {اليم} [الانفال: ] ، قال: الاليم: الموجع في القران كله " وروي عن سعيد بن جبير، والضحاك بن مزاحم، وابي مالك، وقتادة، وابي عمران الجوني ومقاتل بن حيان نحو ذلك
 
  قوله تعالي: {وما كان الله ليعذبهم وانت فيهم} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا المثني بن معاذ العنبري، ثنا ابي، عن شعبة، عن عبد الحميد، صاحب الزيادي سمع انس بن مالك، قال: " قال ابو جهل: {اللهم ان كان هذا هو الحق من عندك فامطر علينا حجارة من السماء او اءتنا بعذاب اليم} [الانفال: ] ، فنزلت {وما كان الله ليعذبهم وانت فيهم} [الانفال: ] الاية "
 
 حدثنا ابي، ثنا ابو حذيفة موسي بن مسعود، ثنا عكرمة بن عمار، عن ابي زميل سماك الحنفي، عن ابن عباس، قال: " كان المشركون يطوفون بالبيت ويقولون: لبيك اللهم لبيك، لبيك لا شريك لك، ويقول النبي صلي الله عليه وسلم: «قد قد» ويقولون: لا شريك لك الا شريك هو لك تملكه وما ملك، ويقولون: غفرانك غفرانك، فانزل الله تعالي: {وما كان الله ليعذبهم وانت فيهم وما كان الله معذبهم وهم يستغفرون} [الانفال: ] ، فقال ابن عباس: كان فيهم امانان: نبي الله صلي الله عليه وسلم والاستغفار، فذهب النبي صلي الله عليه وسلم وبقي الاستغفار "
 
 حدثنا ابي، ثنا عبيد الله بن موسي، انبا سلمة بن نبيط، عن الضحاك، في قوله: " {وما كان الله ليعذبهم وانت فيهم} [الانفال: ] ، قال: يعني النبي صلي الله عليه وسلم "
 
 حدثنا محمد بن عمار، ثنا محمد بن عبيد الطنافسي، ثنا سلمة بن نبيط، عن الضحاك، في قوله: " {وما كان الله ليعذبهم وانت فيهم} [الانفال: ] ، قال: المشركون الذين بمكة "
 
  قوله تعالي: {وما كان الله معذبهم وهم يستغفرون} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، " {وما كان الله ليعذبهم وانت فيهم} [الانفال: ] ، يقول: ما كان الله سبحانه ليعذب قوما وانبياءهم بين اظهرهم حتي يخرجهم، ثم قال: {وما كان الله معذبهم وهم يستغفرون} [الانفال: ] ، يقول: وفيهم من قد سبق له من الله الدخول في الايمان وهو الاستغفار فيستغفرون، يعني يصلون يعني بهذا اهل مكة " وروي عن مجاهد، قولان احدهما: " {وهم يستغفرون} [الانفال: ] يصلون، والاخر يستغفرون: مسلمون «وروي عن عكرمة» وهم يدخلون في الاسلام "
 
 حدثنا ابي، ثنا علي بن الجعد، ثنا فضيل بن مرزوق، عن عطية، في قوله: " {وما كان الله معذبهم وهم يستغفرون} [الانفال: ] ، يعني المءمنين "
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي، " {وما كان الله معذبهم وهم يستغفرون} [الانفال: ] ، قال: قال الله تعالي لرسوله، ما كنت معذبهم وهم يستغفرون يقول: لو استغفروا واقروا بالذنوب لكانوا مءمنين "
 
 حدثنا علي بن الحسين، ثنا يزيد بن عبد العزيز، ثنا سليمان بن حسان الشامي، عن ابن لهيعة، عن عطاء بن دينار، قال: " سءل سعيد بن جبير، عن الاستغفار، فقال: قال الله عز وجل: {وما كان الله معذبهم وهم يستغفرون} [الانفال: ] ، يقول: يعملون علي الغفران، وعلمت ان ناسا سيدخلون جهنم ممن يستغفرون بالسنتهم ممن يدعي الاسلام وساءر الملل " وروي عن الضحاك، وابي مالك {وهم يستغفرون} [الانفال: ] ، يعني: المءمنين الذين كانوا بمكة
 
 حدثنا ابي، ثنا عبد الغفار بن داود، ثنا النضر بن عربي، قال: قال ابن عباس " ان الله عز وجل جعل في هذه الامة امانين لا يزالون معصومين مجارين من قوارع العذاب ما داما بين اظهرهم، فامان قبضه الله اليه، وامان بقي فيكم قوله: {وما كان الله ليعذبهم وانت فيهم وما كان الله معذبهم وهم يستغفرون} [الانفال: ] " قال ابو صالح
  [ص: ]
 عبد الغفار: حدثني بعض اصحابنا ان النضر بن عربي حدثه هذا الحديث مجاهد، عن ابن عباس
 
 حدثنا ابي، ثنا ابو صالح، حدثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، " {وما لهم الا يعذبهم الله} [الانفال: ] ، فعذبهم يوم بدر بالسيف "
 
 حدثنا ابي، ثنا يحيي بن عبد الحميد الحماني، ثنا يعقوب القمي، عن جعفر بن ابي المغيرة، عن سعيد بن عبد الرحمن بن ابزي، قال: " كان النبي صلي الله عليه وسلم بمكة فانزل الله: {وما كان الله ليعذبهم وانت فيهم} [الانفال: ] ، فخرج النبي صلي الله عليه وسلم الي المدينة، فانزل الله: {وما كان الله معذبهم وهم يستغفرون} [الانفال: ] ، فكانت بقية من المسلمين بقوا بمكة، فلما خرجوا انزل الله عليه، {وما لهم الا يعذبهم الله وهم يصدون عن المسجد الحرام} [الانفال: ] الاية الي قوله: {المتقون} [الانفال: ] ، فاذن له في فتح مكة وهو العذاب الذي كان وعدهم، وهو قوله: {وما لهم الا يعذبهم الله} [الانفال: ] "
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن مفضل، حدثنا اسباط، عن السدي، " {وما لهم الا يعذبهم الله} [الانفال: ] ، يقول: وكيف لا اعذبهم وهم لا يستغفرون؟ "
 
 حدثنا الحسن بن محمد بن الصباح، ثنا حجاج بن محمد، عن ابن جريج، وعثمان بن عطاء، عن عطاء، عن ابن عباس، " {وما كان الله معذبهم وهم يستغفرون} [الانفال: ] ، ثم استثني اهل الشرك فقال: {وما لهم الا يعذبهم الله وهم يصدون عن المسجد الحرام} [الانفال: ] "
 
 حدثنا ابي، ثنا احمد بن اسماعيل بن ابي ضرار، ثنا ابو تميلة، عن الحسين بن واقد، عن يزيد النحوي، عن عكرمة، والحسن، في قوله: " {وما كان الله معذبهم وهم يستغفرون} [الانفال: ] ، فنسختها الاية التي تليها، {وما لهم الا يعذبهم الله وهم يصدون عن المسجد الحرام} [الانفال: ] ، فقوتلوا بمكة، فاصابهم فيها الجوع والحصر " وروي عن زيد بن اسلم مثل ذلك
 
  قوله تعالي: {وهم يصدون عن المسجد الحرام} 
 [الانفال: ]
 
 حدثنا ابي، حدثنا عبيد الله بن موسي، اخبرنا سلمة بن نبيط، عن الضحاك، في قوله: " {وهم يصدون عن المسجد الحرام،} [الانفال: ] ، يعني به المشركين "
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن المفضل، حدثنا اسباط، عن السدي، قوله: " {وهم يصدون} [الانفال: ] محمدا صلي الله عليه وسلم عن المسجد الحرام "
 
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا ابن ادريس، عن ابن اسحاق، حدثني يحيي بن عباد بن عبد الله بن الزبير، عن ابيه، " {وما لهم الا يعذبهم الله} [الانفال: ] وهم يجحدون ايات الله ويكذبون رسله، وان كان فيهم ما يدعون وهم يصدون عن سبيل الله والمسجد الحرام "
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو زنيج، ثنا سلمة بن الفضل، عن محمد بن اسحاق، حدثني محمد بن جعفر بن الزبير، عن عروة بن الزبير، قوله: " {وهم يصدون عن المسجد الحرام،} [الانفال: ] ، اي من امن بالله وعبده، انت ومن اتبعك "
 
  قوله تعالي: {وما كانوا اولياءه ان اولياءه الا المتقون} 
 [الانفال: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة بن سوار، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {ان اولياءه الا المتقون} [الانفال: ] من كانوا حيث كانوا "
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي، " {وما كانوا اولياءه ان اولياءه الا المتقون} [الانفال: ] ، هم اصحاب النبي صلي الله عليه وسلم ورضي عنهم "
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا ابو غسان محمد بن عمرو، حدثنا سلمة، عن ابن اسحاق، حدثنا محمد بن جعفر بن الزبير، عن عروة بن الزبير
  [ص: ]
 ، " {وما كانوا اولياءه ان اولياءه الا المتقون} [الانفال: ] الذين يخرجون منه ويقيمون الصلاة عنده، اي: انت ومن امن بك "
 
  قوله تعالي: {ولكن اكثرهم لا يعلمون} 
 [الانعام: ]
 
 حدثنا علي بن الحسين، ثنا محمد بن العلاء، ثنا عثمان بن سعيد، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، " {ولكن اكثرهم لا يعلمون} [الانفال: ] ، يقول: لا يعقلون "
 
  قوله تعالي: {وما كان صلاتهم عند البيت} 
 [الانفال: ]
 
 حدثنا ابي، ثنا الحسين بن الربيع، ثنا ابن ادريس، عن ابن اسحاق، " {وما كان صلاتهم عند البيت} [الانفال: ] ، التي يدعون ان يدفع بها عنهم {الا مكاء وتصدية} [الانفال: ] ، وذلك ما لا يرضي الله "
 
  قوله تعالي: {الا مكاء} 
 [الانفال: ]
 
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن ادريس الاودي، عن عطية، عن ابن عمر، قال: " المكاء: الصفير " وروي عن ابن عباس، ونبيط بن شريط الاشجعي، ومجاهد، في احد قوليه، وسعيد بن جبير في احد قوليه، وابي رجاء العطاردي، وحجر بن عنبس، وقتادة، ومحمد بن كعب، وعبد الرحمن بن زيد بن اسلم نحو ذلك
 
 اخبرنا احمد بن عثمان بن حكيم، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، " {الا مكاء} [الانفال: ] ، والمكاء: الصفير علي نحو طير ابيض يقال له: المكاء، يكون بارض الحجاز "
 
  الوجه الثاني
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {مكاء} [الانفال: ] ، ادخال اصابعهم في افواههم "
 
  الوجه الثالث
 
 حدثنا ابو عبد الله الطهراني، انبا حفص بن عمر، ثنا الحكم بن ابان، عن عكرمة، في قوله: " {وما كان صلاتهم عند البيت الا مكاء} [الانفال: ] ، قال: المكاء: مثل نفخ الصور "
 
 حدثنا ابو هارون محمد بن خالد الخزاز، ثنا اسحاق بن سليمان، ثنا طلحة بن عمرو، عن سعيد بن جبير، في قوله: " {وما كان صلاتهم عند البيت الا مكاء} [الانفال: ] ، قال: " كانوا يشبكون اصابعهم، قال: واراني سعيد بن جبير المكان الذي يمكون فيه في ناحية ابي قبيس "
 
  قوله تعالي: {وتصدية} 
 [الانفال: ]
 
 حدثنا ابو خلاد سليمان بن خلاد، ثنا يونس بن محمد المءدب، ثنا يعقوب، يعني ابن عبد الله الاشعري، حدثنا جعفر بن المغيرة، عن سعيد بن جبير، عن ابن عباس، في قوله: " {وما كان صلاتهم عند البيت الا مكاء وتصدية} [الانفال: ] ، قال: كانت قريش تطوف بالكعبة عراة تصفر وتصفق، والمكاء: الصفير، وانما شبهوا بصفير الطير، وتصدية التصفيق " وروي عن ابن عمر، ومجاهد في احدي الروايات وابن ابزي، ومحمد بن كعب، وحجر بن عنبس، وعطية العوفي: انهم قالوا: التصدية: التصفيق وحكي ابن عمر: انهم كانوا يضعون خدودهم علي الارض ويصفقون ويصفرون
 
  الوجه الثاني
 
 حدثنا الحجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {تصدية} [الانفال: ] ، قال: الصفير، يخلطون بذلك كله علي محمد صلي الله عليه وسلم صلاته "
 
 قرء علي يونس بن عبد الاعلي، انبا ابن وهب، اخبرني عبد العزيز بن محمد، عن ابن اخي ابن شهاب، عن ابن شهاب، " {وما كان صلاتهم عند البيت الا مكاء وتصدية} [الانفال: ] ، والتصدية: صفيرهم حين يستهزءون بالمءمنين وهم يصلون، فذكر الله تبارك وتعالي انها لم تكن صلاة الكفار عند البيت الا مكاء وتصدية، حين يستهزءون بالمءمنين وهم يصلون "
 
  الوجه الثالث
 
 حدثنا محمد بن حماد الطهراني، ثنا حفص بن عمر، ثنا الحكم بن ابان، عن عكرمة، في قوله: " {وتصدية} [الانفال: ] ، قال: طوافهم بالبيت علي الشمال "
 
  الوجه الرابع
 
 حدثنا ابو هارون محمد بن خلاد الخراز، ثنا اسحاق بن سليمان، ثنا طلحة بن عمرو، عن سعيد بن جبير، في قوله: " {وتصدية} [الانفال: ] ، قال: صدهم الناس "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قوله: " {مكاء وتصدية} [الانفال: ] ، قال: تصدية عن سبيل الله، وصدهم عن الصلاة، وعن دين الله "
 
  قوله تعالي: {فذوقوا العذاب بما كنتم تكفرون} 
 [ال عمران: ]
 
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ، عن عبيد بن سليمان، عن الضحاك، في قوله: " {فذوقوا العذاب بما كنتم تكفرون} [ال عمران: ] ، يعني: اهل بدر عذبهم الله بالقتل والاسر "
 
 حدثنا ابي، ثنا ابن ابي عمر العدني، ثنا سفيان، عن ابن ابي نجيح، عن مجاهد، قال: «عذاب اهل الاقرار بالسيف، وعذاب اهل التكذيب بالصيحة والزلزلة» 
 
  قوله تعالي: {ان الذين كفروا ينفقون اموالهم} 
 [الانفال: ]
 
 حدثنا ابو سعيد الاشج، ثنا عقبة بن خالد السكوني، ثنا خطاب بن عثمان العصفري، قال: سمعت الحكم بن عتيبة، يقول في قوله: " {ان الذين كفروا ينفقون اموالهم ليصدوا عن سبيل الله} [الانفال: ] ، قال: انزلت في ابي سفيان، انفق علي المشركين اربعين اوقية من ذهب، وكانت الاوقية يومءذ اثنين واربعين مثقالا من ذهب "
 
 حدثنا ابي، ثنا عيسي بن ابي فاطمة، ثنا يعقوب القمي، انبا جعفر بن ابي المغيرة، عن سعيد بن جبير، في قوله: " {ان الذين كفروا ينفقون اموالهم ليصدوا عن سبيل الله فسينفقونها} [الانفال: ] الاية، قال: نزلت في ابي سفيان بن حرب استاجر يوم احد الفين من الاحابيش من كنانة، فقاتل بهم النبي صلي الله عليه وسلم سوي من استجاش من العرب، وهم الذين قال فيهم كعب بن مالك رضي الله عنه «
 [البحر الطويل]
  [ص: ]
 فجءنا الي موج من البحر وسطه ... احابيش منهم حاسر ومقنع
 ثلاثة الاف ونحن نصية ... ثلاث مءين ان كثرن فاربع
 
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا عبد الله بن ادريس، ثنا محمد بن اسحاق، انبا محمد بن مسلم الزهري، وعاصم بن عمرو بن قتادة بن النعمان، ومحمد بن يحيي بن حبان، وحصين بن عبد الرحمن بن عمرو بن سعد بن معاذ، وعبد الله بن ابي بكر بن محمد، وغيرهم من علماءنا قالوا: " لما اصيب اصحاب بدر اصحاب القليب من قريش ورجع ابو سفيان بعيره الي مكة مشي عبد الله بن ابي ربيعة واخوانهم ببدر، فقالوا: يا معشر قريش، ان محمدا قد وتركم وقتل خياركم فاعينونا بهذا المال، لعلنا ندرك منه بعض ما اصاب منا، ففعلوا وفيهم انزل الله تعالي: {ان الذين كفروا ينفقون اموالهم ليصدوا عن سبيل الله} [الانفال: ] ، الاية "
 
  قوله تعالي: {ليصدوا عن سبيل الله} 
 [الانفال: ]
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن المفضل، حدثنا اسباط، عن السدي، " {ليصدوا عن سبيل الله،} [الانفال: ] ، وهو محمد صلي الله عليه وسلم "
 
  قوله تعالي: {فسينفقونها ثم تكون عليهم حسرة} 
 [الانفال: ]
 
 وبه، عن السدي، " {فسينفقونها ثم تكون عليهم حسرة} [الانفال: ] ، يقول: ندامة يوم القيامة "
 
  قوله تعالي: {ثم يغلبون} 
 [الانفال: ]
 
 حدثنا ابي، ثنا احمد بن المقدام، ثنا محمد بن بكر البرساني، ثنا سليم بن نفيع القرشي، عن خلف ابي الفضل القرشي، عن كتاب، عمر بن عبد العزيز، قال: قول الله: " {يغلبون} [الانفال: ] فاخبرهم بعذابهم بالقتل في الدنيا والاخرة بالنار "
 
  قوله تعالي: {والذين كفروا الي جهنم يحشرون} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قال: «هم الكفار الذين خلقهم الله للنار وخلق النار لهم فالت عنهم الدنيا، وحرمت عليهم الجنة»
 
 حدثنا محمد بن العباس، ثنا ابو غسان محمد بن عمرو، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: وحدثني يحيي بن عباد بن عبد الله بن الزبير، عن ابيه عباد، " {والذين كفروا الي جهنم يحشرون} [الانفال: ] ، يعني: النفر الذين مشوا الي ابي سفيان والي من كان لهم مال من قريش في تلك التجارة فسالوهم ان يقووهم بها علي حرب رسول الله صلي الله عليه وسلم ففعلوا "
 
  قوله تعالي: {ليميز الله الخبيث من الطيب} 
 [الانفال: ]
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي، " {ليميز الله الخبيث من الطيب} [الانفال: ] ، يقول: يميز المءمن من الكافر "
 
  الوجه الثاني
 
 حدثنا علي بن الحسين، ثنا ابن ابي حماد، ثنا مهران، عن يعقوب، عن حفص بن حميد، عن شمر بن عطية، " {ليميز الله الخبيث من الطيب} [الانفال: ] ، قال: يميز ما كان لله من عمل صالح من الدنيا، ثم تءخذ الدنيا باسرها فتلقي في جهنم "
 
  قوله عز وجل {فيركمه جميعا فيجعله في جهنم} 
 [الانفال: ]
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ بن الفرج، اخبرنا ابن زيد، في قول الله: " {فيركمه جميعا} [الانفال: ] ، قال: فيجمعه جميعا فيجعله في جهنم "
 
  قوله تعالي: {اولءك هم الخاسرون} 
 [البقرة: ]
 
 حدثنا ابو زرعة، حدثنا صفوان بن صالح، حدثنا الوليد، اخبرني بكير بن معروف، عن مقاتل بن حيان، " {اولءك هم الخاسرون} [البقرة: ] ، قال: في الاخرة "
 
 قرات علي محمد بن الفضل، ثنا محمد بن علي، انبا محمد بن مزاحم، ثنا بكير بن معروف، عن مقاتل بن حيان، في قوله: " {اولءك هم الخاسرون} [البقرة: ] في الاخرة، يقول: هم اهل النار "
 
 قوله تعالي: {قل للذين
  [ص: ]
 كفروا ان ينتهوا يغفر لهم ما قد سلف} [الانفال: ]
 
 اخبرنا يونس بن عبد الاعلي، قراءة، انبا ابن وهب، قال: قال مالك: " لا يءخذ كافر بشء صنعه في كفره اذا اسلم وذلك ان الله تعالي يقول: {قل للذين كفروا ان ينتهوا يغفر لهم ما قد سلف وان يعودوا فقد مضت سنة الاولين} [الانفال: ] "
 
 حدثنا ابو عبيد الله ابن اخي ابن وهب، ثنا ابن وهب، قال: قال مالك بن انس " في طلاق المشركين نساءهم ثم يتناكحون بعد اسلامهم، قال: لا يعد طلاقهم شيءا، لان الله تعالي، قال: {قل للذين كفروا ان ينتهوا يغفر لهم ما قد سلف} [الانفال: ] "
 
  قوله تعالي: {وان يعودوا} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، حدثنا زنيج، ثنا سلمة، عن محمد بن اسحاق، ثنا يحيي بن عباد، عن ابيه: " {وان يعودوا} [الانفال: ] لحربك "
 
  قوله تعالي: {فقد مضت} 
 [الانفال: ]
 
 حدثنا ابو بكر بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك، قوله: " {مضت} [الانفال: ] ، يعني خلت "
 
  قوله تعالي: {سنة الاولين} 
 [الانفال: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {فقد مضت سنة الاولين} [الانفال: ] في قريش وغيرها يوم بدر والامم قبل ذلك "
 
 حدثنا ابي، ثنا ابن ابي عمر، قال سفيان في قوله: " {قل للذين كفروا ان ينتهوا يغفر لهم ما قد سلف وان يعودوا فقد مضت سنة الاولين} [الانفال: ] في اهل بدر وامثالنا "
 
  قوله تعالي: {وقاتلوهم حتي لا تكون فتنة} 
 [البقرة: ]
 
 حدثنا احمد بن سنان، ثنا ابو معاوية، ثنا الاعمش، عن ابي ظبيان، قال: جاء رجل الي سعد، فقال له: الا تخرج تقاتل مع الناس حتي لا تكون فتنة؟ فقال
  [ص: ]
 سعد: «قد قاتلت مع رسول الله صلي الله عليه وسلم حتي لم تكن فتنة، فاما انت وذا البطين تريدون ان اقاتل حتي تكون فتنة» وروي عن ابن عمر مثل ذلك
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، " {وقاتلوهم حتي لا تكون فتنة} [البقرة: ] ، قال: يقول: يعني حتي لا يكون شرك بالله " وروي عن ابي العالية، ومجاهد، والحسن، وقتادة، والربيع بن انس، والسدي، ومقاتل بن حيان، وزيد بن اسلم نحو قول ابن عباس
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، قال: بلغني عن الزهري، عن عروة بن الزبير، وغيره من العلماء " انه انزل عليه، {وقاتلوهم حتي لا تكون فتنة} [البقرة: ] اي حتي لا يفتن مءمن عن دينه "
 
  قوله تعالي: {ويكون الدين كله لله} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {ويكون الدين كله لله} [الانفال: ] ، قال: يخلص التوحيد لله عز وجل "
 
 حدثنا ابي، ثنا محبوب بن موسي الانطاكي، ثنا ابو اسحاق الفزاري، عن سعيد بن ابي عروبة، عن قتادة، في قوله: " {ويكون الدين كله لله} [الانفال: ] ، قال: لا اله الا الله "
 
 قرات علي محمد بن الفضل، ثنا محمد بن علي، ثنا محمد بن مزاحم، حدثنا بكير بن معروف، عن مقاتل بن حيان قوله: " {فان انتهوا} [البقرة: ] عن قتالكم واسلموا "
 
 حدثنا ابي، ثنا ابو حذيفة، ثنا شبابة، عن ابن ابي نجيح، عن مجاهد، قوله: " {فان انتهوا} [البقرة: ] ، قال: فان تابوا "
 
  قوله تعالي: {وان تولوا} 
 [البقرة: ]
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، " {وان تولوا} [البقرة: ] يعني: الكفار، تولوا عن النبي صلي الله عليه وسلم "
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة، عن ابن اسحاق، حدثنا يحيي بن عباد بن عبد الله بن الزبير، عن ابيه، " {فان تولوا} [ال عمران: ] عن امرك، الي ما هم عليه من كفرهم "
 
  قوله تعالي: {فاعلموا ان الله مولاكم نعم المولي ونعم النصير} 
 [الانفال: ]
 
 حدثنا احمد بن سنان، ثنا معاوية، ثنا الاعمش، عن شقيق، قال: قال لي: «يا سليمان نعم الرب ربنا لو اطعناه ما عصانا»
 
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا عبد الله بن ادريس، عن ابن اسحاق، " {فاعلموا ان الله، مولاكم} [الانفال: ] ، الذي اعزكم في اليوم الذي كان قبله يعني: بدرا و {مولاكم نعم المولي ونعم النصير} [الانفال: ] "
 
  قوله تعالي: {واعلموا انما غنمتم من شء} 
 [الانفال: ]
 
 حدثنا ابي، حدثنا الحسن بن الربيع، ثنا ابن ادريس، عن ابن اسحاق، ثنا يحيي بن عباد بن عبد الله بن الزبير، عن ابيه، قال: " ثم وضع مقاسم الفء واعلمه فقال: {واعلموا انما غنمتم من شء} [الانفال: ] بعد الذي مضي من بدر {فان لله خمسه وللرسول} [الانفال: ] الي اخر الاية: يعني: يوم بدر "
 
  قوله تعالي: {من شء} 
 [ال عمران: ]
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا ابن لهيعة، ثنا عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {واعلموا انما غنمتم من شء} [الانفال: ] ، يعني: من المشركين "
 
 حدثنا اسيد بن عاصم، ثنا الحسين بن حفص، ثنا سفيان، عن ليث، عن مجاهد، " {انما غنمتم من شء} [الانفال: ] ، قال: المخيط من الشء "
 
  قوله تعالي: {فان لله خمسه} 
 [الانفال: ]
 
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، وابو نعيم، عن سفيان، عن قيس بن مسلم، قال: سالت الحسن بن محمد بن علي بن ابي طالب، عن قوله: " {واعلموا انما غنمتم من شء فان لله خمسه} [الانفال: ] ، اما قوله: {فان لله خمسه} [الانفال: ] فهذا مفتاح كلام، لله
  [ص: ]
 الاخرة والاولي " وروي عن ابي العالية، وعطاء، وابراهيم النخعي، والحسن البصري، والشعبي نحو ذلك
 
  الوجه الثاني
 
 حدثنا كثير بن شهاب القزويني، ثنا محمد بن سعيد بن سابق، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية، في قوله: " {واعلموا انما غنمتم من شء فان لله خمسه} [الانفال: ] الاية، قال: كان يجاء بالغنيمة فتوضع فيقسمها رسول الله صلي الله عليه وسلم علي خمسة اسهم، فيعزل سهما منها ويقسم اربعة اسهم بين الناس يعني لمن شهد الوقعة، ثم يضرب بيده في جميعه يعني السهم الذي عزله فما قبض من شء جعله للكعبة هو الذي سمي الله، ويقول: لا تجعلوا لله نصيبا فان لله الدنيا والاخرة، ثم يعمد الي بقية السهم فيقسمه علي خمسة اسهم: سهم للنبي صلي الله عليه وسلم، وسهم لذي القربي وسهم لليتامي وسهم للمساكين، وسهم لابن السبيل "
 
  قوله تعالي: {وللرسول} 
 [الانفال: ]
 
 حدثنا يونس بن عبد الاعلي، انبا عبد الله بن وهب، اخبرني يونس، عن ابن شهاب، عن عمر بن محمد بن جبير بن مطعم، عن ابيه، عن جده، رضي الله عنه، عن رسول الله صلي الله عليه وسلم نحو حديثه وفيه، ثم تناول النبي صلي الله عليه وسلم شيءا من الارض او وبرة من بعيره، فقال: والذي نفسي بيده مالي مما افاء الله عليكم، ولا مثل هذه او هذا الا الخمس، والخمس مردود عليكم "
 
 حدثنا ابو سعيد الاشج، ثنا ابن فضيل، عن عبد الملك، عن عطاء، " {واعلموا انما غنمتم من شء فان لله خمسه وللرسول} [الانفال: ] ، قال: خمس الله والرسول واحد يحمل فيه ويصنع فيه ما شاء، يعني النبي صلي الله عليه وسلم " وروي عن ابن عباس مرسل والشعبي، والنخعي، وابن بريدة، والحسن البصري، وقتادة، انهم قالوا: سهم الله وسهم الرسول واحد "
 
  الوجه الثاني انه لازواج النبي صلي الله عليه وسلم
 
 حدثنا ابي، ثنا ابو معمر المنقري، حدثنا عبد الوارث بن سعيد، عن الحسين المعلم، قال: سالت عبد الله بن بريدة، عن قوله: " {واعلموا انما غنمتم من شء فان لله خمسه وللرسول} [الانفال: ] ، فقال: الذي لله فلنبيه، والذي للرسول لازواجه "
 
  الوجه الثالث
 
 حدثنا ابي، ثنا ابو صالح، حدثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، في قول الله: " {واعلموا انما غنمتم من شء فان لله خمسه وللرسول} [الانفال: ] ، قال ابن عباس «كانت الغنيمة تقسم علي خمسة اخماس، فاربعة منها بين من قاتل عليها، وخمس واحد يقسم علي اربعة اخماس فربع لله وللرسول، فما كان لله وللرسول فلقربة النبي صلي الله عليه وسلم، ولم ياخذ النبي صلي الله عليه وسلم من الخمس شيءا»
 
  الوجه الرابع
 
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، وابو نعيم، عن قيس بن مسلم، قال: سالت الحسن بن محمد بن علي، عن قوله: " {فان لله خمسه وللرسول} [الانفال: ] ، فقال: " فان رسول الله صلي الله عليه وسلم لما قبض اختلف اصحابه من بعده، فقال بعضهم: سهم النبي صلي الله عليه وسلم للخليفة واجمعوا رايهم ان يجعلوها في الخيل والعدة في سبيل الله، فكان خلافة ابي بكر، وعمر رضي الله عنهما "
 
  قوله تعالي: {ولذي القربي} 
 [الانفال: ]
 
 حدثنا محمد بن عبد الله بن يزيد المقرء، ثنا سفيان، عن اسماعيل بن امية، عن سعيد المقبري، عن يزيد بن هرمز، قال: " كتب نجدة الي ابن عباس يساله عن ذوي القربي، قال ابن عباس: «واما ذوي القربي فانا نزعم، انا نحن، هم، فيابي ذلك علينا قومنا»
 
 حدثنا ابي، حدثنا ابراهيم بن مهدي المصيصي، ثنا المعتمر بن سليمان، عن ابيه، عن حنش، عن عكرمة، عن ابن عباس قال: قال رسول الله صلي الله عليه وسلم «رغبت لكم عن غسالة الايدي، لان لكم في خمس الخمس ما يغنيكم او يكفيكم»
 
 حدثنا ابي، ثنا سهل بن عثمان، ثنا يحيي بن ابي زاءدة، عن محمد بن اسحاق، عن الزهري، وعبد الله بن ابي بكر، ان النبي صلي الله عليه وسلم " قسم سهم ذي القربي من خيبر علي بني هاشم، وبني المطلب، قال ابن اسحاق: قسم لهم خمس الخمس " وروي عن عبد الله بن بريدة والسدي، قالا: بني عبد المطلب "
 
  الوجه الثاني
 
 حدثنا احمد بن سنان، ثنا عبد الرحمن بن مهدي، ثنا سفيان، عن قيس بن مسلم، قال: سالت الحسن عن قوله: " {واعلموا انما غنمتم من شء فان لله خمسه وللرسول ولذي القربي} [الانفال: ] ، قال: اختلف الناس بعد وفاة رسول الله صلي الله عليه وسلم في هذين السهمين، فقال قاءلون: سهم القرابة لقرابة النبي صلي الله عليه وسلم، وقال قاءلون: لقرابة الخليفة " وروي عن سعيد بن جبير، وعكرمة، قالا: «قرابة النبي صلي الله عليه وسلم»
 
 حدثنا ابي، ثنا هدبة، حدثنا همام، عن قتادة، قال: قال الحسن " في سهم ذي القربي: هو لقرابة الخلفاء «وقال عكرمة هو لقرابة النبي صلي الله عليه وسلم»
 
  قوله تعالي: {واليتامي} 
 [البقرة: ]
 
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، في قول الله: " {واعلموا انما غنمتم من شء فان لله خمسه وللرسول ولذي القربي واليتامي} [الانفال: ] ، فكانت الغنيمة تقسم علي خمسة اخماس، وخمس واحد يقسم علي اربعة اخماس، فربع لله وللرسول ولذي القربي، والربع الثاني لليتامي "
 
  قوله تعالي: {والمساكين} 
 [البقرة: ]
 
 وبه، عن ابن عباس، في قول الله: " {فان لله خمسه وللرسول ولذي القربي واليتامي والمساكين} [الانفال: ] ، قال: كانت الغنيمة تقسم علي خمسة اخماس: فاربعة منها بين من قاتل عليها، وخمس واحد يقسم علي اربعة: فربع لله وللرسول ولذي القربي والربع الثاني: لليتامي والربع الثالث: للمساكين "
 
 وبه، عن ابن عباس، {ولذي القربي واليتامي والمساكين وابن السبيل} [الانفال: ] «والربع الرابع من الخمس لابناء السبيل وهو الضيف الفقير الذي ينزل بالمسلمين»
 
  قوله تعالي: {ان كنتم امنتم بالله} 
 [الانفال: ]
 
 قرات علي محمد بن الفضل، حدثنا محمد بن علي، انبا محمد بن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان، قوله: " {ان كنتم امنتم بالله} [الانفال: ] يقول: اقروا بحكمي "
 
  قوله تعالي: {وما انزلنا علي عبدنا} 
 [الانفال: ]
 
 وبه، عن مقاتل بن حيان، " {وما انزلنا علي عبدنا} [الانفال: ] ، يقول: وما انزلت علي محمد صلي الله عليه وسلم في القسمة "
 
  قوله تعالي: {يوم الفرقان} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {وما انزلنا علي عبدنا يوم الفرقان} [الانفال: ] ، يوم بدر فرق الله فيه بين الحق والباطل " وروي عن مجاهد، ومقسم، وعبيد الله بن عبد الله، والضحاك، وقتادة، ومقاتل بن حيان نحو ذلك
 
  الوجه الثاني
 
 حدثنا علي بن الحسين، قال: قرات علي ابي مصعب، ثنا حاتم بن اسماعيل، عن مصعب بن ثابت، اخبرني عطاء بن دينار ابو ريان، عن يزيد بن ابي حبيب، قال: «في يوم الاثنين ولد النبي صلي الله عليه وسلم، وهو يوم الفرقان»
 
  قوله تعالي: {يوم التقي الجمعان} 
 [ال عمران: ]
 
 اخبرنا محمد بن سعد بن عطية، فيما كتب الي، ثنا ابي، ثنا عمي، عن ابيه، عن جده، عن عبد الله بن عباس، قوله: " {يوم التقي الجمعان} [الانفال: ] ، يقول: يوم بدر، وبدر بين مكة والمدينة "
 
 قرات علي محمد بن الفضل، حدثنا محمد بن علي، حدثنا محمد بن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان، قوله: " {يوم التقي الجمعان} [الانفال: ] ، جمع المءمنين وجمع المشركين "
 
  قوله تعالي: {والله علي كل شء قدير} 
 [البقرة: ]
 
 حدثنا محمد بن العباس، حدثنا محمد بن عمرو، ثنا سلمة، عن ابن اسحاق، " {علي كل شء قدير} [الانفال: ] اي «ان الله علي ما اراد بعباده من نقمة او عفو لقدير»
 
  قوله تعالي: {اذ انتم بالعدوة الدنيا} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قوله: " {اذ انتم بالعدوة الدنيا} [الانفال: ] ، قال: شاطء الوادي " وروي عن قتادة نحو ذلك
 
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا ابن ادريس، عن محمد بن اسحاق، " {اذ انتم بالعدوة الدنيا} [الانفال: ] الي المدينة "
 
  قوله تعالي: {وهم بالعدوة القصوي} 
 [الانفال: ]
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي الصنعاني، انبا محمد بن ثور، عن معمر، عن قتادة، " {وهم بالعدوة القصوي} [الانفال: ] ، وهم بشفير الوادي الاقصي "
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، ثنا يحيي بن عباد بن عبد الله بن الزبير، عن ابيه: " {وهم بالعدوة القصوي} [الانفال: ] ، الوادي الي مكة "
 
  قوله تعالي: {والركب اسفل منكم} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، " {والركب اسفل منكم} [الانفال: ] قال الركب: ابو سفيان "
 
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا ابن ادريس، عن محمد بن اسحاق، ثنا يحيي بن عباد بن عبد الله بن الزبير، عن ابيه: " {والركب اسفل منكم} [الانفال: ] ، يعني ابا سفيان وغيره، وهي اسفل من ذلك نحو الساحل "
 
 حدثنا ابي، ثنا عبد العزيز بن المغيرة، ثنا حماد بن سلمة، عن هشام بن عروة، في قول الله: " {والركب اسفل منكم} [الانفال: ] ، وكان ابو سفيان اسفل الوادي في سبعين راكبا، ونفرت قريش وكانوا تسعماءة وخمسين، فبعث ابو سفيان الي قريش وهم بالجحفة: اني قد جاوزت القوم فارجعوا، قالوا: لا والله لا نرجع حتي ناتي ماء بدر "
 
  قوله تعالي: {ولو تواعدتم لاختلفتم في الميعاد} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، قال: وحدثني يحيي بن عباد بن عبد الله بن الزبير، عن ابيه: " {ولو تواعدتم لاختلفتم في الميعاد} [الانفال: ] ، اي ولو كان ذلك عن ميعاد منكم ومنهم ثم بلغكم كثرة عددهم، وقلة عددكم ما لقيتموهم "
 
  قوله تعالي: {ولكن ليقضي الله امرا كان مفعولا} 
 [الانفال: ]
 
 وبه، عن ابيه: " {ولكن ليقضي الله امرا كان مفعولا} [الانفال: ] ، اي ليقضي ما اراد بقدرته من اعزاز الاسلام واهله، واذلال الكفر واهله، عن غير ملا منكم، ففعل ما اراد من ذلك بلطفه سبحانه "
 
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا عبد الله بن ادريس، عن محمد بن اسحاق، حدثني يحيي بن عباد بن الزبير، عن ابيه: " {ولكن ليقضي الله امرا كان مفعولا} [الانفال: ] ، فاخرجه الله ومن معه الي العير لا يريد غيرها، واخرج قريشا من مكة لا يريدون الا الدفع عن عيرهم، ثم الف بين القوم علي الحرب، وكان لا يريد الا العير، فقال في ذلك: {ليقضي الله امرا كان مفعولا} [الانفال: ] ليفصل بين الحق والباطل ويعز الاسلام واهله، ويذل الشرك واهله "
 
  قوله تعالي: {ليهلك من هلك عن بينة ويحيا من حي عن بينة}
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة، عن ابن اسحاق، وحدثني يحيي بن عباد بن عبد الله بن الزبير، عن ابيه، « {ليهلك من هلك عن بينة ويحيا من حي عن بينة وان الله لسميع عليم} ، اي» ليكفر من كفر بعد الحجة، لما راي من الايات والعبر، ويءمن من امن علي مثل ذلك "
 
  قوله تعالي: {وان الله لسميع عليم} [الانفال: ] قد تقدم تفسيره
 
  قوله تعالي: {اذ يريكهم الله} 
 [الانفال: ]
 
 حدثنا ابو عبد الله محمد بن حماد الطهراني، انبا حفص بن عمر، ثنا الحكم بن ابان، عن عكرمة، " {اذ يريكهم الله في منامك قليلا} [الانفال: ] ، الاية. قال: حرش بينهم "
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي، انبا محمد بن ثور، عن معمر، عن ابن ابي نجيح، عن مجاهد، " {اذ يريكهم الله في منامك قليلا} [الانفال: ] ، قال: اراه اياهم في منامه قليلا، فاخبر النبي صلي الله عليه وسلم اصحابه بذلك، وكان تثبيتا لهم "
 
 حدثنا ابي، ثنا يوسف بن موسي التستري، ثنا ابو قتيبة، عن سهل السراج، عن الحسن، في قوله: " {اذ يريكهم الله في منامك قليلا} [الانفال: ] ، قال: بعينك "
 
  قوله تعالي: {ولو اراكهم كثيرا لفشلتم} 
 [الانفال: ]
 
 حدثنا ابي، ثنا محمد بن ابي عمر العدني، ثنا سفيان، عن ابن ابي نجيح، عن مجاهد، قوله: " {ولو اراكهم كثيرا لفشلتم} [الانفال: ] ، يقول: لفشلت انت، فراي اصحابك في وجهك الفشل ففشلوا "
 
 اخبرنا موسي بن هارون الطوسي، فيما كتب الي، ثنا الحسين بن محمد المروذي، ثنا شيبان بن عبد الرحمن، عن قتادة، في قوله: " {ولو اراكهم كثيرا لفشلتم} [الانفال: ] ، يقول: لجبنتم "
 
  قوله تعالي: {ولتنازعتم في الامر} 
 [الانفال: ]
 
 وبه، عن قتادة، قوله: " {ولتنازعتم في الامر} [الانفال: ] ، قال: لاختلفتم "
 
  قوله تعالي: {ولكن الله سلم} 
 [الانفال: ]
 
 اخبرنا محمد بن سعد بن عطية، فيما كتب الي، ثنا ابي، ثنا عمي، عن ابيه، عن جده، عن عبد الله بن عباس، قوله: " {ولكن الله سلم} [الانفال: ] ، يقول: سلم لهم امرهم حتي اظهرهم علي عدوهم "
 
 حدثنا ابو زرعة
  [ص: ]
 ، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {ولكن الله سلم} [الانفال: ] اي اتم "
 
  قوله تعالي: {انه عليم بذات الصدور} 
 [الانفال: ]
 
 قرات علي محمد بن الفضل بن موسي، ثنا محمد بن علي، انبا محمد بن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان، قوله: " {عليم بذات الصدور} [الانفال: ] بما في قلوبهم "
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة، قال: قال محمد بن اسحاق: " {عليم بذات الصدور} [الانفال: ] ، اي لا يخفي عليه ما في صدورهم مما استخفوا به منكم "
 
  قوله تعالي: {واذ يريكموهم اذ التقيتم في اعينكم قليلا} 
 [الانفال: ]
 
 حدثنا احمد بن سنان، ثنا ابو احمد الزبيري، ثنا اسراءيل، عن ابي اسحاق، عن ابي عبيدة، عن عبد الله، قال: " لقد قللوا في اعيننا يوم بدر حتي قلت لرجل الي جنبي: تراهم سبعين؟ قال: لا، بل هم ماءة، حتي اخذنا رجلا منهم فسالناه، قال: كنا الفا "
 
 حدثنا ابي، ثنا سليمان بن حرب، ثنا حماد بن زيد، عن الزبير بن خريت، عن عكرمة، " {واذ يريكموهم اذ التقيتم في اعينكم قليلا ويقللكم في اعينهم} [الانفال: ] ، قال: حضض بعضهم علي بعض "
 
  قوله تعالي: {ويقللكم في اعينهم} [الانفال: ] الاية
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، قال: ثنا يحيي بن عباد بن عبد الله بن الزبير، عن ابيه، " فكان ما اراه الله عز وجل من ذلك من نعمة الله عليهم شجعهم بها علي عدوهم وكف بها عنهم ما تخوف عليهم من ضعفهم لعلمه بما فيهم {واذ يريكموهم اذ التقيتم في اعينكم قليلا ويقللكم في اعينهم ليقضي الله امرا كان مفعولا} [الانفال: ] اي ليءلف بينهم علي الحرب للنقمة ممن اراد الانتقام منه والانعام علي من اراد تمام النعمة عليه من اهل ولايته "
 
  قوله تعالي: {يا ايها الذين امنوا اذا لقيتم فءة فاثبتوا} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، ثنا يحيي بن عباد بن عبد الله بن الزبير، عن ابيه، قال: " ثم وعظهم وفهمهم
  [ص: ]
 واعلمهم الذي ينبغي لهم ان يسيروا به في حربهم فقال: {يا ايها الذين امنوا اذا لقيتم فءة} [الانفال: ] ، يقاتلونك في الله، {فاثبتوا} [الانفال: ] "
 
  قوله تعالي: {واذكروا الله كثيرا} 
 [الانفال: ]
 
 قرء علي يونس بن عبد الاعلي، انبا ابن وهب، اخبرني عبد الرحمن بن زياد بن انعم، عن ابي عبد الرحمن، الحبلي، عن عبد الله بن عمرو، قال: قال رسول الله صلي الله عليه وسلم: «لا تتمنوا لقاء العدو، وسلوا العافية فان لقيتموهم فاثبتوا، واذكروا الله كثيرا فاذا جلبوا وصيحوا فعليكم بالصمت»
 
 قرء علي يونس بن عبد الاعلي، انبا ابن وهب، اخبرني عبد الله بن عياش، عن يزيد بن قوذر، عن كعب الاحبار، قال: " ما من شء احب الي الله من قراءة القران والذكر، ولولا ذلك ما امر الناس بالصلاة والقتال، الا ترون انه قد امر الناس بالذكر عند القتال؟ فقال: {يا ايها الذين امنوا اذا لقيتم فءة فاثبتوا واذكروا الله كثيرا لعلكم تفلحون} [الانفال: ] "
 
  الوجه الثاني
 
 حدثنا ابي، ثنا عبدة بن سليمان، ثنا ابن المبارك، انبا ابن جريج، عن عطاء، قال: " وجب الانصات والذكر عند الزحف ثم تلا: {اذا لقيتم فءة فاثبتوا واذكروا الله كثيرا} [الانفال: ] ، قلت: يجهرون بالذكر؟ قال: نعم "
 
  قوله تعالي: {لعلكم} 
 [البقرة: ]
 
 حدثنا ابو بكر بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الله بن ابي حماد، عن اسباط بن نصر، عن السدي، عن ابي مالك، قوله: " {لعلكم} [الانفال: ] ، يعني: كي "
 
  قوله تعالي: {تفلحون} 
 [البقرة: ]
 
 حدثنا يونس بن عبد الاعلي، انبا ابن وهب، انبا ابو صخر المديني، عن محمد بن كعب، انه كان يقول في هذه الاية: " {لعلكم تفلحون} [الانفال: ] ، يقول: لعلكم تفلحون غدا اذا لقيتموني "
 
  قوله تعالي: {واطيعوا الله ورسوله} [الانفال: ] قد تقدم تفسيره
 
  قوله تعالي: {ولا تنازعوا فتفشلوا} 
 [الانفال: ]
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، حدثنا سعيد، عن قتادة: " {ولا تنازعوا} [الانفال: ] ، الاية. يقول: لا تختلفوا فتجبنوا ويذهب نصركم "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، حدثنا اصبغ بن الفرج، انبا عبد الرحمن بن زيد بن اسلم، في قول الله: " {ولا تنازعوا فتفشلوا وتذهب ريحكم} [الانفال: ] ، قال: الفشل: الضعف عن جهاد عدوه، والانكسار لهم ذلك الفشل "
 
  قوله تعالي: {وتذهب ريحكم} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو حذيفة، ثنا شبل، عن ابن ابي نجيح، عن مجاهد، " {وتذهب ريحكم} [الانفال: ] ريح اصحاب محمد صلي الله عليه وسلم حين نازعوه يوم بدر "
 
 اخبرنا عمرو بن ثور القيساري، فيما كتب الي، ثنا الفريابي، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، في قوله: " {وتذهب ريحكم} [الانفال: ] ، نصركم فذهبت ريح اصحاب محمد صلي الله عليه وسلم حين نازعوه يوم احد "
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة، " {وتذهب ريحكم} [الانفال: ] ، قال: ريح الحرب "
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، حدثني يحيي بن عباد بن عبد الله بن الزبير، عن ابيه، " {وتذهب ريحكم} [الانفال: ] ، اي ويذهب جدكم "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، ثنا ابن زيد، في قول الله: " {وتذهب ريحكم} [الانفال: ] ، قال: الريح النصر، لم يكن نصر قط الا بريح، ريحا يبعثها الله تضرب وجوه العدو، واذا كان ذلك لم يكن لهم قوام "
 
  قوله تعالي: {واصبروا} 
 [الاعراف: ]
 
 حدثنا يونس بن عبد الاعلي، انبا ابن وهب، انبا ابو صخر المديني، عن محمد بن كعب القرظي، انه كان يقول: " {واصبروا} [الانفال: ] ، يقول: واصبروا علي دينكم "
 
 حدثنا ابو زرعة، ثنا محمد بن عبد الله بن نمير، ثنا بدل بن المحبر، عن عباد بن راشد، عن الحسن، " {واصبروا} [الانفال: ] ، قال: علي الصلوات "
 
 حدثنا يحيي بن حبيب بن اسماعيل بن حبيب بن ابي ثابت، ثنا جعفر بن عون، حدثنا هشام بن سعد، عن زيد بن اسلم، في قوله: " {واصبروا} [الانفال: ] ، قال: علي الجهاد "
 
 حدثنا ابو زرعة، ثنا محمد بن عمرو بن جبلة بن ابي رواد، ثنا محمد بن مروان، عن سعيد، عن قتادة، قوله: " {واصبروا} [الانفال: ] ، قال: علي حق الله "
 
 حدثنا ابي، حدثني ابراهيم بن المنذر، ثنا زكريا بن منظور، عن زيد بن اسلم، في قول الله: " {واصبروا} [الانفال: ] ، اخبرنا ابن المبارك، انبا ابن لهيعة، عن عطاء بن دينار، ان سعيد بن جبير، قال: «الصبر اعتراف العبد لله بما اصاب منه واحتسابه عند الله رجاء ثوابه، وقد يجزع الرجل وهو متجلد لا يري منه الا الصبر»
 
  قوله تعالي: {ان الله مع الصابرين} 
 [البقرة: ]
 
 حدثنا علي بن الحسين، ثنا هارون بن سعيد الايلي، ثنا ابن وهب، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول: " الصبر في بابين: الصبر لله فيما احب وان ثقل علي الانفس والابدان، والصبر لله عما كره، وان نازعت اليه الاهواء، فمن كان هكذا فهو من الصابرين الذين يسلم عليهم ان شاء الله تعالي "
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، حدثني يحيي بن عباد بن عبد الله بن الزبير، عن ابيه: " {واصبروا ان الله مع الصابرين} [الانفال: ] اي اني معكم اذا فعلتم ذلك "
 
  قوله: {ولا تكونوا كالذين خرجوا من ديارهم} 
 [الانفال: ]
 
 اخبرنا محمد بن سعد بن عطية، فيما كتب الي، ثنا ابي، ثنا عمي، عن ابيه، عن جده، عن ابن عباس، قوله: " {ولا تكونوا كالذين خرجوا من ديارهم بطرا ورءاء الناس} [الانفال: ] ، يعني: المشركين الذين قاتلوا رسول الله صلي الله عليه وسلم يوم بدر "
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، حدثني يحيي بن عباد بن عبد الله بن الزبير، عن ابيه عباد
  [ص: ]
 : " {ولا تكونوا كالذين خرجوا من ديارهم بطرا} [الانفال: ] ، اي لا تكونوا كابي جهل واصحابه الذين قالوا: لا نرجع حتي ناتي بدرا فننحر بها الجذور، ونسقي فيه الخمر، وتعزف علينا فيه القيان، ويسمع بنا العرب "
 
  قوله تعالي: {بطرا} 
 [الانفال: ]
 
 حدثنا ابو سعيد الاشج، ثنا عبيد الله، عن اسراءيل، عن ابي يحيي، عن مجاهد، " {كالذين خرجوا من ديارهم بطرا} [الانفال: ] ، قال: كانوا اصحاب بدر يعني: المشركين "
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، عن سعيد، عن قتادة، قوله: " {ولا تكونوا كالذين خرجوا من ديارهم بطرا} [الانفال: ] ، قال: كانوا مشركي قريش الذين قاتلوا النبي صلي الله عليه وسلم يوم بدر، فخرجوا ولهم بغي وفخر، وقد قيل لهم يومءذ: ارجعوا فقد انطلقت عيركم، وقد ظفرتم فقالوا: لا والله، حتي يتحدث اهل الحجاز بمسيرنا وعددنا "
 
  قوله تعالي: {ورءاء الناس} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، حدثنا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، حدثني يحيي بن العباد بن عبد الله بن الزبير، عن ابيه عباد، " {بطرا ورءاء الناس} [الانفال: ] ، اي لا يكون امركم رياء، ولا سمعة، ولا التماس ما عند الناس، واخلصوا لله النية والحسبة في نصر دينكم ومءازرة نبيكم لا تعملوا الا لذلك ولا تطلبوا غيره "
 
  قوله تعالي: {ويصدون عن سبيل الله والله بما يعملون محيط} 
 [الانفال: ]
 
 قرات علي محمد بن الفضل، حدثنا محمد بن علي، انبا ابن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان، قوله: " {والله بما يعملون محيط} [الانفال: ] ، يقول: احاط علمه باعمالهم "
 
  قوله تعالي: {واذ زين لهم الشيطان اعمالهم} 
 [الانفال: ]
 
 اخبرنا محمد بن سعد بن عطية، فيما كتب الي، ثنا ابي، ثنا عمي الحسين، عن ابيه، عن جده، عن عبد الله بن عباس، " {واذ زين لهم الشيطان اعمالهم} [الانفال: ] ، وقد زين لهم الشيطان اعمالهم "
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو زنيج، ثنا سلمة، عن محمد بن اسحاق، حدثني يحيي بن عباد بن عبد الله بن الزبير، عن ابيه عباد، ثم قال: " {واذ زين لهم الشيطان اعمالهم وقال لا غالب لكم اليوم من الناس واني جار لكم} [الانفال: ] : يذكر استدراج ابليس اياهم، وتشبهه بسراقة بن جعشم حين ذكروا ما بينهم وبين ابن عبد مناة بن كنانة من الحرب التي كانت بينهم "
 
  قوله تعالي: {وقال لا غالب لكم اليوم من الناس واني جار لكم} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قال: " جاء ابليس في جند من الشياطين، ومعه راية في صور رجال من بني مدلج، والشيطان في صورة سراقة بن مالك بن جعشم، فقال الشيطان: {لا غالب لكم اليوم من الناس واني جار لكم} [الانفال: ] ، واقبل جبريل عليه الصلاة والسلام علي ابليس، فلما راه وكانت يده في يد رجل من المشركين انتزع ابليس يده وولي مدبرا وشيعته، فقال الرجل: يا سراقة، اتزعم انك لنا جار؟ فقال: {اني اري ما لا ترون اني اخاف الله والله شديد العقاب} [الانفال: ] "
 
 اخبرنا ابو الازهر، فيما كتب الي، ثنا وهب ابن جرير، ثنا ابي، عن علي بن الحكم، عن الضحاك، قوله: " {واذ زين لهم الشيطان اعمالهم وقال لا غالب لكم اليوم من الناس واني جار لكم} [الانفال: ] ، «وان الشيطان سار معهم برايته وجنوده والقي في قلوب المشركين ان احدا لن يغلبكم وانتم تقاتلون علي دينكم ودين اباءكم»
 
  قوله تعالي: {فلما تراءت الفءتان} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو زنيج، حدثنا سلمة، عن ابن اسحاق، حدثني يحيي بن عباد بن عبد الله بن الزبير، عن ابيه عباد: " {فلما تراءت الفءتان} [الانفال: ] نظر عدو الله الي جنود الله من الملاءكة قد ايد الله بهم رسوله والمءمنين علي عدوهم نكص علي عقبيه "
 
  قوله تعالي: {نكص علي عقبيه} 
 [الانفال: ]
 
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، عن عبيد بن سليمان، عن الضحاك: " فلما التقوا نكص علي عقبيه، يقول: رجع مدبرا "
 
 حدثنا محمد بن العباس، ثنا محمد بن عمر، ثنا سلمة، عن محمد بن اسحاق، حدثنا يحيي بن عباد بن عبد الله بن الزبير، عن ابيه، " {نكص علي عقبيه} [الانفال: ] ، قال: التقي الجمعان وكان الذي راه نكص حين نكص الحارث بن هشام او عمير بن وهب الجمحي فذكر احدهما "
 
  قوله تعالي: {وقال اني برء منكم اني اري ما لا ترون} 
 [الانفال: ]
 
 حدثنا ابي، حدثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، " {اني اري ما لا ترون} [الانفال: ] ، وذلك حين راي الملاءكة "
 
 حدثنا يحيي بن عبدك القزويني، ثنا المقرء، ثنا سليمان بن المغيرة، عن حميد بن هلال، عن الحسن، في قوله: " {وقال اني برء منكم اني اري ما لا ترون} [الانفال: ] ، قال: راي جبريل معتجرا برداءه يقود الفرس بين يدي اصحابه ما ركبه "
 
  قوله تعالي: {اني اخاف الله والله شديد العقاب} 
 [الانفال: ]
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، " {وقال اني برء منكم اني اري ما لا ترون اني اخاف الله والله شديد العقاب} [الانفال: ] ، فقال: " ذكر لنا انه راي جبريل صلي الله عليه وسلم ينزل معه الملاءكة، فعلم عدو الله انه لا يدان له بالملاءكة، وقال: {اني اري ما لا ترون اني اخاف الله} [الانفال: ] ، وكذب عدو الله، ما به مخافة الله ولكن علم ان لا قوة له به، ولا منعة له وتلك عادة عدو الله لمن اطاعه وانقاد له حتي اذا التقي الحق والباطل اسلمهم شر مسلم وتبرا منهم عند ذلك "
 
  قوله تعالي: {اذ يقول المنافقون والذين في قلوبهم مرض} 
 [الانفال: ]
 
 اخبرنا محمد بن سعد بن عطية، فيما كتب الي، ثنا ابي، ثنا عمي، عن ابيه، عن جده، عن ابن عباس، " {اذ يقول المنافقون} [الانفال: ] ، وهم يومءذ في المسلمين "
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي، انبا محمد بن ثور، عن معمر، عن الحسن، " {اذ يقول المنافقون والذين في قلوبهم مرض} [الانفال: ] ، قال: هم قوم لم يشهدوا القتال فسموا منافقين "
 
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا ابن ادريس، عن ابن اسحاق، " {اذ يقول المنافقون والذين في قلوبهم مرض} [الانفال: ] ، " وهم الفتية الذين خرجوا مع قريش من مكة احتبسهم
  [ص: ]
 اباءهم فخرجوا وهم علي الارتياب، فلما راوا قلة اصحاب رسول الله صلي الله عليه وسلم، قالوا: {غر هءلاء دينهم} [الانفال: ] ، حين قدموا علي ما قدموا عليه من قلة عددهم وكثرة عدوهم وهم فتية من قريش مسمون خمسة ابو قيس بن الوليد بن المغيرة، وابو قيس بن الفاكه بن المغيرة المخزوميان، والحارث بن زمعة، وعلي بن امية بن خلف، والعاص بن منبه "
 
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، " {اذ يقول المنافقون والذين في قلوبهم مرض} [الانفال: ] ، قال: لما دنا القوم بعضهم من بعض قلل الله المسلمين، في اعين المشركين وقلل المشركين في اعين المسلمين، فقال المشركون: وما هءلاء؟ غر هءلاء دينهم، وانما قالوا ذلك من قلتهم في اعينهم وظنوا انهم سيهزمونهم لا يشكون في انفسهم ذلك، فقال الله تعالي: {ومن يتوكل علي الله فان الله عزيز حكيم} [الانفال: ] "
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد، عن قتادة، قوله: {غر هءلاء دينهم} [الانفال: ] ، قال: " رات عصابة من المءمنين تشددت لامر الله، قال: وذكر لنا ان عدو الله ابا جهل بن هشام لما اشرف علي محمد واصحابه، قال: والله لا يعبد الله بعد اليوم قسوة، وعتوا "
 
  قوله تعالي: {ومن يتوكل علي الله} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو زنيج، ثنا سلمة، قال: قال محمد بن اسحاق: «وعلي الله لا علي الناس فليتوكل»
 
  قوله تعالي: {ولو تري اذ يتوفي الذين كفروا الملاءكة} 
 [الانفال: ]
 
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، عن عبيد بن سليمان، عن الضحاك، " {ولو تري اذ يتوفي الذين كفروا الملاءكة} [الانفال: ] الذين قتلهم الله ببدر من المشركين "
 
 حدثنا علي بن الحسين، ثنا ابو الاصبغ، ثنا عتاب، عن خصيف، عن مقسم، عن ابن عباس، قال: " ايتان يبشر بهما الكافر عند موته، {ولو تري اذ يتوفي الذين كفروا الملاءكة يضربون وجوههم وادبارهم} [الانفال: ] "
 
  قوله تعالي: {يضربون وجوههم وادبارهم} 
 [الانفال: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، " {اذ يتوفي الذين كفروا الملاءكة يضربون وجوههم وادبارهم} [الانفال: ] يوم بدر "
 
 حدثنا ابي، ثنا ابو نعيم، ثنا سفيان، عن ابي هاشم، عن مجاهد، " {يضربون وجوههم وادبارهم} [الانفال: ] ، قال: واستاههم، ولكنه كني " وروي عن سعيد بن جبير وعكرمة وعمر مولي غفرة نحو قول مجاهد في حديث ابي هاشم
 
  قوله تعالي: {وذوقوا عذاب الحريق} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {عذاب} [الانفال: ] ، يقول: نكال "
 
  قوله تعالي: {ذلك بما قدمت ايديكم} 
 [ال عمران: ]
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {ذلك} [الانفال: ] ، يعني: الذي نزل بهم "
 
  قوله تعالي: {كداب ال فرعون} [ال عمران: ] الاية الي اخره
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {كداب ال فرعون} [الانفال: ] ، قال: كصنيع ال فرعون " وروي عن مجاهد، والضحاك، وابي مالك، وعكرمة نحو ذلك
 
  قوله تعالي: {ذلك بان الله لم يك مغيرا نعمة انعمها علي قوم} 
 [الانفال: ]
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، " {ذلك بان الله لم يك مغيرا نعمة انعمها علي قوم حتي يغيروا ما بانفسهم} [الانفال: ] ، يقول: نعمة الله: محمد صلي الله عليه وسلم انعم الله بها علي قريش، فكفروا ونقله الي الانصار "
 
  قوله تعالي: {واغرقنا ال فرعون} 
 [البقرة: ]
 
 اخبرنا محمد بن عبيد الله بن المنادي، فيما كتب الي، ثنا يونس بن محمد المءدب، ثنا شيبان النحوي، عن قتادة، قوله: " {واغرقنا ال فرعون} [البقرة: ] ، قال: اغرق الله ال فرعون عدوهم نعما من الله يعرفهم بها لكي ما يشكروا ويعرفوا حقه "
 
  قوله تعالي: {ان شر الدواب عند الله} 
 [الانفال: ]
 
 حدثنا علي بن الحسين، ثنا عثمان بن ابي شيبة، ثنا ابن نمير، عن ورقاء، عن ابن ابي نجيح، عن مجاهد، " {ان شر الدواب عند الله} [الانفال: ] ، قال ابن عباس: هم نفر من قريش من بني عبد الدار "
 
  قوله تعالي: {الذين عاهدت منهم} 
 [الانفال: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {عاهدت منهم ثم ينقضون عهدهم} [الانفال: ] ، قريظة يوم الخندق مالءوا علي محمد صلي الله عليه وسلم اعداءه "
 
  قوله تعالي: {فاما تثقفنهم في الحرب فشرد بهم} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قوله: " {فشرد بهم من خلفهم} [الانفال: ] يقول: نكل بهم " وروي عن الحسن، والضحاك، والسدي، وعطاء الخراساني، وابن عيينة مثل ذلك
 
  الوجه الثاني
 
 حدثنا ابي، ثنا نعيم بن حماد، ومحمد بن عبد الاعلي الصنعاني، قالا: ثنا محمد بن ثور، عن معمر، عن ايوب، عن سعيد بن جبير، قوله: " {فشرد بهم من خلفهم} [الانفال: ] ، يقول: انذر بهم "
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد النرسي، ثنا يزيد بن زريع، عن سعيد، عن قتادة: " {فشرد بهم من خلفهم} [الانفال: ] ، يقول: عظ بهم "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، انا ابن زيد، في قوله، " {فشرد بهم من خلفهم} [الانفال: ] ، قال: اخفهم بهم، كما تصنع بهءلاء وقرا: {واخرين من دونهم لا تعلمونهم الله يعلمهم} [الانفال: ] "
 
  قوله تعالي: {من} 
 [البقرة: ]
 
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {من خلفهم} [ال عمران: ] ، قال: الذين خلفهم "
 
  قوله تعالي: {من خلفهم} 
 [ال عمران: ]
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {فشرد بهم من خلفهم} [الانفال: ] ، يعني: نكل بهم من بعدهم " وروي عن الحسن، والضحاك، والسدي نحو ذلك
 
  الوجه الثاني
 
 اخبرنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد، عن سعيد، عن قتادة، قوله: " {فشرد بهم من خلفهم} [الانفال: ] ، يقول: من سواهم من الناس "
 
  الوجه الثالث
 
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا ابن ادريس، عن ابن اسحاق، " {فشرد بهم من خلفهم} [الانفال: ] ، يقول: نكل بهم من وراءهم، يعني: العرب كلها "
 
  قوله تعالي: {لعلهم يذكرون} 
 [الاعراف: ]
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، " {لعلهم يذكرون} [الاعراف: ] ، يقول: لعلهم يحذرون ان ينكثوا، فيصنع بهم مثل ذلك "
 
 حدثنا محمد بن العباس، ثنا ابو غسان محمد بن عمرو، ثنا سلمة، عن ابن اسحاق، ثنا يحيي بن عباد بن عبد الله بن الزبير، عن ابيه، " {لعلهم يذكرون} [الاعراف: ] ، لعلهم يعقلون "
 
  قوله تعالي: {واما تخافن من قوم خيانة} 
 [الانفال: ]
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول في قول الله: " {واما تخافن من قوم خيانة فانبذ اليهم علي سواء} [الانفال: ] ، قال: من عاهد رسول الله صلي الله عليه وسلم ان خفت ان يختانوك ويغدروا فتاتيهم، {فانبذ اليهم علي سواء} [الانفال: ] "
 
  قوله تعالي: {فانبذ اليهم علي سواء} 
 [الانفال: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {فانبذ اليهم علي سواء} [الانفال: ] ، قال: قريظة "
 
  قوله تعالي: {ان الله لا يحب الخاءنين} 
 [الانفال: ]
 
 حدثنا الحسن بن علي بن عفان، ثنا الحسن بن عطية، ثنا موسي بن ابي حبيب، عن علي بن حسين، قال: " لا تقاتل عدوك حتي تنبذ اليهم علي سواء، {ان الله لا يحب الخاءنين} [الانفال: ] "
 
  قوله تعالي: {ولا يحسبن الذين كفروا سبقوا انهم لا يعجزون} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، " {سبقوا انهم لا يعجزون} [الانفال: ] ، يقول: لا يفوتونا " وروي عن السدي مثل ذلك
 
  قوله تعالي: {واعدوا لهم} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، حدثني يحيي بن عباد بن عبد الله بن الزبير، عن ابيه، " {واعدوا لهم ما استطعتم من قوة} [الانفال: ] ، قال: امرهم باعداد الخيل "
 
  قوله تعالي: {لهم} 
 [البقرة: ]
 
 قرات علي محمد بن الفضل، ثنا محمد بن علي، ثنا محمد بن مزاحم، ثنا بكير بن معروف، عن مقاتل بن حيان، قوله: " {واعدوا لهم} [الانفال: ] ، قال: الجهاد "
 
  قوله تعالي: {ما استطعتم من قوة} 
 [الانفال: ]
 
 حدثنا يونس بن عبد الاعلي، انبا ابن وهب، اخبرني عمرو بن الحارث، ان ابا علي الهمداني يعني ثمامة بن شفي، حدثه، عن عقبة بن عامر الجهني، قال: سمعت رسول الله صلي الله عليه وسلم يقول وهو علي المنبر: " {واعدوا لهم ما استطعتم من قوة} [الانفال: ] ، الا ان القوة الرمي قالها ثلاثا "
 
  الوجه الثاني
 
 حدثنا محمد بن اسماعيل الاحمسي، ثنا وكيع، عن سفيان، عن شعبة بن دينار، عن عكرمة، في قوله: " {واعدوا لهم ما استطعتم من قوة} [الانفال: ] ، قال: الحصون "
 
  الوجه الثالث
 
 حدثنا ابي، ثنا يحيي بن المغيرة، انا جرير، عن ابي سنان، عن ليث، عن مجاهد، في قوله: " {واعدوا لهم ما استطعتم من قوة} [الانفال: ] ، قال: القوة: ذكور الخيل " وروي عن عكرمة مثل ذلك
 
  الوجه الرابع
 
 حدثنا ابو زرعة، ثنا محمد بن المثني، ثنا عباد بن جويرية العنزي، ثنا الاوزاعي، قال: سالت الزهري عن قول الله: " {واعدوا لهم ما استطعتم من قوة} [الانفال: ] ، قال: قال سعيد بن المسيب " القوة: الفرس الي السهم فما دونه " وروي عن مقاتل بن حيان انه قال: القوة: السلاح، وما سواه من قوة الجهاد " وروي عن السدي، قال: «السلاح» وروي عن ابي صخر حميد بن زياد انه قال " القوة: العدة، اعداد ما استطعت لهم من عدة "
 
 اخبرنا علي بن سهل الرملي، فيما كتب الي، ثنا ضمرة، عن رجاء بن ابي سلمة، قال: لقي رجل مجاهدا وهو " يتجهز الي الغزو ومعه جوالق، فقال مجاهد: وهذا من القوة "
 
  قوله تعالي: {ومن رباط الخيل} 
 [الانفال: ]
 
 حدثنا محمد بن اسماعيل الاحمسي، ثنا وكيع، عن سفيان، عن شعبة بن دينار، عن عكرمة، في قوله: " {ومن رباط الخيل} [الانفال: ] ، قال: الاناث " وروي عن مجاهد وعمرو بن دينار مثل ذلك
 
  الوجه الثاني
 
 قرات علي محمد بن الفضل، حدثنا محمد بن علي، حدثنا محمد بن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان، قوله: " {ومن رباط الخيل} [الانفال: ] ، قال: هي الخيل "
 
  قوله تعالي: {ترهبون به} 
 [الانفال: ]
 
 حدثنا محمد بن اسماعيل الاحمسي، ثنا وكيع، عن اسراءيل، عن عثمان بن المغيرة الثقفي، عن مجاهد، عن ابن عباس، " {ترهبون به عدو الله وعدوكم} [الانفال: ] ، قال: تخزون به عدو الله وعدوكم " وروي عن مجاهد مثل ذلك
 
  قوله تعالي: {عدو الله وعدوكم} 
 [الانفال: ]
 
 قرات علي محمد، ثنا محمد، ثنا محمد، عن بكير، عن مقاتل، قوله: " {ترهبون به عدو الله وعدوكم} [الانفال: ] ، من المشركين "
 
  قوله تعالي: {واخرين من دونهم لا تعلمونهم} 
 [الانفال: ]
 
 حدثنا ابو عتبة بن الفرج الحمصي، ثنا ابو حيوة يعني شريح بن يزيد المقرء، ثنا سعيد بن سنان الكندي، عن ابن عريب يعني يزيد بن عبد الله بن عريب، عن ابيه، عن جده، ان النبي صلي الله عليه وسلم، كان " يقول في قول الله: {واخرين من دونهم لا تعلمونهم} [الانفال: ] ، قال: هم الجن "
 
  الوجه الثاني
 
 حدثنا الحجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {واخرين من دونهم} [الانفال: ] قريظة "
 
  الوجه الثالث
 
 قرات علي محمد بن الفضل، ثنا محمد بن علي، ثنا محمد بن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان، قوله: " {واخرين من دونهم} [الانفال: ] ، قال: يعني: المنافقين "
 
  الوجه الرابع
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي، في قوله: " {واخرين من دونهم لا تعلمونهم} [الانفال: ] ، قال: اهل فارس "
 
  الوجه الخامس
 
 حدثنا ابي، ثنا ابن ابي عمر العدني، ثنا سفيان، في قوله: " {واخرين من دونهم} [الانفال: ] ، قال: قال ابن اليمان: هم الشياطين التي في الدور "
 
  قوله تعالي: {لا تعلمونهم الله يعلمهم} 
 [الانفال: ]
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، انبا ابن زيد يعني عبد الرحمن، في قول الله: " {واخرين من دونهم لا تعلمونهم الله يعلمهم} [الانفال: ] ، قال: هءلاء المنافقون، لا تعلمونهم، لانهم معكم يقولون: لا اله الا الله، ويغزون معكم "
 
  قوله تعالي: {الله يعلمهم} 
 [الانفال: ]
 
 قرات علي محمد، ثنا محمد، ثنا محمد، عن بكير، عن مقاتل، قوله: " {الله يعلمهم} [الانفال: ] ، يقول: الله يعلم ما في قلوب المنافقين من النفاق الذي يسرون "
 
  قوله تعالي: {وما تنفقوا من شء في سبيل الله يوف اليكم} 
 [الانفال: ]
 
 حدثنا احمد بن القاسم بن عطية، ثنا احمد بن عبد الرحمن الدشتكي، ثنا ابي، عن ابيه، حدثنا الاشعث بن اسحاق، عن جعفر، عن سعيد بن جبير، عن ابن عباس، عن النبي صلي الله عليه وسلم، " انه كان يامر بان لا يصدق الا علي اهل الاسلام حتي نزلت: {وما تنفقوا من شء في سبيل الله يوف اليكم} [الانفال: ] ، فامر بالصدقة بعدها علي كل من سالك من كل دين "
 
  قوله تعالي: {وانتم لا تظلمون} 
 [البقرة: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا ابو غسان محمد بن عمرو، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قوله: " {وانتم لا تظلمون} [البقرة: ] ، اي لا يضيع لكم عند الله اجره في الاخرة وعاجل خلفه في الدنيا "
 
  قوله تعالي: {وان جنحوا} 
 [الانفال: ]
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي، " {وان جنحوا} [الانفال: ] ، يقول: ان ارادوا الصلح فارده "
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، " {وان جنحوا للسلم} [الانفال: ] ، قريظة "
 
  قوله تعالي: {للسلم} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {وان جنحوا للسلم} [الانفال: ] ، قال: الطاعة "
 
  الوجه الثاني
 
 حدثنا ابي، ثنا اسماعيل بن رجاء القرشي، ثنا معقل بن عبيد الله، عن عبد الكريم الجزري، عن الضحاك، عن ابن عباس، قوله: " {وان جنحوا للسلم} [الانفال: ] ، يعني: بالخفض، {فاجنح لها} [الانفال: ] فهو الصلح "
 
 حدثنا ابو عامر، اسماعيل بن عمرو الحمصي، ثنا ابراهيم بن العلاء، ثنا عبد الواحد بن ميسرة، ثنا ابو حفص مبشر بن عبيد في قوله: " {وان جنحوا للسلم} [الانفال: ] يعني بفتح السين يعني الصلح " وروي عن عطاء الخراساني، وقتادة، والثوري، قالوا: «الصلح، ولم يءدوا القراءة»
 
 حدثنا الحسن بن محمد بن الصباح، ثنا حجاج بن محمد، انبا ابن جريج، وعثمان بن عطاء، عن عبد الله، " {وان جنحوا للسلم فاجنح لها} [الانفال: ] الاية نسختها هذه الاية، {قاتلوا الذين لا يءمنون بالله ولا باليوم الاخر} [التوبة: ] ، الي قوله: {وهم صاغرون} [التوبة: ] " وروي عن مجاهد، وعكرمة، والحسن، وقتادة، وزيد بن اسلم، وعطاء الخراساني مثل ذلك
 
  قوله تعالي: {فاجنح لها} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو زنيج، ثنا سلمة، عن ابن اسحاق، حدثني يحيي بن عباد بن عبد الله بن الزبير، عن ابيه، قوله
  [ص: ]
 : " {وان جنحوا للسلم فاجنح لها} [الانفال: ] اي «ان دعوك الي السلم علي الاسلام فصالحهم عليه»
 
  قوله تعالي: {وتوكل علي الله انه هو السميع العليم} 
 [الانفال: ]
 
 وبه، عن ابيه، قوله: " {وتوكل علي الله} [الانفال: ] ، ان الله كافيك، انه هو السميع العليم "
 
  قوله تعالي: {وان يريدوا ان يخدعوك} 
 [الانفال: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {وان يريدوا ان يخدعوك} [الانفال: ] قريظة "
 
  قوله تعالي: {ان يخدعوك} 
 [الانفال: ]
 
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا ابن ادريس، عن ابن اسحاق، " {وان يريدوا ان يخدعوك،} [الانفال: ] ، قال: وان كانوا يريدون خديعتك او مكرا بك فان حسبك الله "
 
  قوله تعالي: {فان حسبك الله} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم ثنا ابو غسان محمد بن عمرو، ثنا سلمة بن الفضل، عن محمد بن اسحاق، ثنا يحيي بن عباد بن عبد الله بن الزبير، عن ابيه، " {فان حسبك الله} [الانفال: ] ، هو من وراء ذلك "
 
  قوله تعالي: {هو الذي ايدك بنصره} 
 [الانفال: ]
 
 وبه، عن يحيي بن عباد، عن ابيه، " {هو الذي ايدك بنصره} [الانفال: ] ، يعني: بعد الضعف "
 
  قوله تعالي: {وبالمءمنين} 
 [الانفال: ]
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن المفضل، عن اسباط، عن السدي، " {هو الذي ايدك بنصره وبالمءمنين} [الانفال: ] ، قال: بالانصار " وروي عن بشير بن ثابت الانصاري، مثله
 
  قوله تعالي: {والف بين قلوبهم} 
 [الانفال: ]
 
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا ابن ادريس، عن ابن اسحاق، قوله: " {والف بين قلوبهم} [الانفال: ] ، بالاسلام الذي هداهم له "
 
  قوله تعالي: {لو انفقت ما في الارض جميعا ما الفت بين قلوبهم} 
 [الانفال: ]
 
 حدثنا ابو سعيد الاشج، ثنا ابن فضيل، عن ابيه، وحفص بن غياث، عن فضيل بن غزوان، قال: اتيت ابا اسحاق بعد ما ذهب بصره فقلت: يا ابا اسحاق، تعرفني؟ فقال: اي والله، اني لاعرفك واني لاحبك في الله ولولا الحياء منك لقبلتك، ثم قال: حدثنا ابو الاحوص، عن عبد الله في قوله: " {لو انفقت ما في الارض جميعا ما الفت بين قلوبهم} [الانفال: ] ، قال: نزلت في المتحابين في الله "
 
  قوله تعالي: {ولكن الله الف بينهم} 
 [الانفال: ]
 
 حدثنا ابو عبد الله الطهراني، بالري، انبا عبد الرزاق، عن معمر، عن ابن طاوس، عن ابيه، عن ابن عباس، قال: " ان الله تعالي اذا قارب بين القلوب لم يزحزحها شء ثم تلا: {لو انفقت ما في الارض جميعا ما الفت بين قلوبهم ولكن الله الف بينهم انه عزيز حكيم} [الانفال: ] "
 
 حدثنا احمد بن سنان الواسطي، ثنا ابو احمد الزبيري، ثنا مالك بن مغول، عن طلحة بن مصرف، عن مجاهد، قال: " اذا لقي الرجل اخاه فصافحه تحاتت الذنوب بينهما كما ينثر الريح الورق، فقال رجل: ان هذا من العمل ليسير، فقال: الم تسمع الله قال: {لو انفقت ما في الارض جميعا ما الفت بين قلوبهم ولكن الله الف بينهم} [الانفال: ] ؟ "
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق، حدثنا يحيي بن عباد بن عبد الله بن الزبير، عن ابيه: " {لو انفقت ما في الارض جميعا ما الفت بين قلوبهم ولكن الله الف بينهم} [الانفال: ] ، بدينه الذي جمعهم عليه، يعني: الاوس، والخزرج "
 
  قوله تعالي: {يا ايها النبي حسبك الله ومن اتبعك} 
 [الانفال: ]
 
 حدثنا احمد بن عثمان بن حكيم، ثنا عبيد الله بن موسي، انبا سفيان، عن شوذب، عن الشعبي، في قوله: " {يا ايها النبي حسبك} [الانفال: ] الله ومن اتبعك من المءمنين، قال: حسبك الله وحسب من شهد معك " وروي عن عطاء الخراساني، وعبد الرحمن بن زيد مثله
 
 حدثنا ابي، ثنا يحيي الحماني، ثنا جرير، ثنا يعقوب القمي، عن جعفر بن ابي المغيرة، عن سعيد بن جبير، قال: " لما اسلم مع النبي صلي الله عليه وسلم ثلاثة وثلاثون رجلا وست نسوة ثم اسلم عمر فنزلت: {يا ايها النبي حسبك الله ومن اتبعك من المءمنين} [الانفال: ] " وروي عن سعيد بن المسيب نحو ذلك
 
  الوجه الثاني
 
 حدثنا ابي، ثنا محمد بن حاتم الزمي، ثنا نعيم بن حماد، ثنا ابو تميلة، عن محمد بن اسحاق، عن الزهري، في قول الله: " {حسبك الله ومن اتبعك من المءمنين} [الانفال: ] ، قال: يقال: نزلت في الانصار "
 
  قوله تعالي: {يا ايها النبي حرض المءمنين علي القتال} 
 [الانفال: ]
 
 حدثنا ابي، ثنا المسيب بن واضح، ثنا ابو اسحاق الفزاري، عن ابي رجاء، قال: اخبرني رجل، عن ابي سنان، قوله: " {يا ايها النبي حرض المءمنين علي القتال} [الانفال: ] ، قال: عظهم "
 
  قوله تعالي: {ان يكن منكم عشرون صابرون يغلبوا ماءتين}
 
 حدثنا محمد بن عبد الله بن يزيد المقرء، ويونس بن عبد الاعلي المصري، والسياق، لابن المقرء، قالا: حدثنا سفيان، عن عمرو بن دينار، عن ابن عباس، قال: لما نزلت: " {ان يكن منكم عشرون صابرون يغلبوا ماءتين} ، فكتب عليهم ان لا يفر عشرون من الماءتين ولا يفر واحد من عشرة ثم قال: {الان خفف الله عنكم وعلم ان فيكم ضعفا فان يكن منكم ماءة صابرة يغلبوا ماءتين} ، فكتب عليهم ان لا يفر واحد من اثنين وماءة من الماءتين، فان فر من ثلاثة فلم يفر "
 
 حدثنا ابن المقرء، قال: قال سفيان: قال شبرمة: «ان الامر بالمعروف والنهي عن المنكر مثله»
 
 حدثنا اسحاق بن وهب العلاف الواسطي، ثنا عمر بن يونس اليمامي، ثنا ابي، عن عطاء بن ابي رباح، عن عبد الله بن عباس، قال: " لما نزلت هذه الاية ثقلت علي المسلمين وعظموا ان يقاتل عشرون ماءتين، وماءة الفا فخفف الله عنهم، فنسختها الاية التي بعدها: {الان خفف الله عنكم وعلم ان فيكم ضعفا فان يكن منكم ماءة
  [ص: ]
 صابرة يغلبوا ماءتين وان يكن منكم الف يغلبوا الفين} " وروي عن عطاء، ومجاهد، وعكرمة، والحسن، وزيد بن اسلم، وعطاء الخراساني، والضحاك نحو ذلك
 
 حدثنا احمد بن عصام الانصاري، ثنا وهب بن جرير بن حازم، عن ابيه، عن الزبير بن الخريت، عن عكرمة، عن ابن عباس، قال ابن عباس: «نقصوا من النصر بقدر ما خفف عنهم من العدة»
 
  قوله تعالي: {يغلبوا ماءتين}
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا عبد الله بن لهيعة، ثنا عطاء بن دينار، عن سعيد بن جبير، " {ان يكن منكم عشرون صابرون يغلبوا ماءتين} ، يعني: يقتلوا ماءتين من المشركين "
 
  قوله تعالي: {وان يكن منكم ماءة يغلبوا الفا من الذين كفروا}
 
 وبه، عن سعيد بن جبير، " {وان تكن منكم ماءة يغلبوا الفا من الذين كفروا} ، فكان يوم بدر جعل الله علي المسلمين ان يقاتل الرجل الواحد منهم عشرة من المشركين ليقطع دابرهم فلما هزم الله المشركين، وقطع دابرهم خفف علي المسلمين بعد ذلك فنزلت: {الان خفف الله عنكم} [الانفال: ] ، يعني: بعد قتال بدر، {وعلم ان فيكم ضعفا فان يكن منكم ماءة صابرة يغلبوا} ، يعني: يقاتلوا ماءتين من المشركين "
 
  قوله تعالي: {بانهم قوم لا يفقهون} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، ثنا ابو غسان محمد بن عمرو، ثنا سلمة، عن ابن اسحاق، ثنا يحيي بن عباد بن عبد الله بن الزبير، عن ابيه: " {بانهم قوم لا يفقهون} [الانفال: ] ، لا يقاتلون عن نية ولا حق ولا معرفة لخير ولا شر "
 
  قوله تعالي: {الان خفف الله عنكم وعلم ان فيكم ضعفا} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، ثنا عطاء بن دينار، عن سعيد بن جبير: " فلما هزم الله المشركين وقطع دابرهم، خفف علي المسلمين بعد ذلك فنزلت: {الان خفف الله عنكم} [الانفال: ] ، يعني: بعد قتال بدر "
 
  قوله تعالي: {فان يكن منكم ماءة صابرة}
 
 حدثنا ابي، ثنا ابراهيم بن المنذر الحزامي، ثنا زكريا بن منظور، حدثني محمد بن عقبة، عن عمه ثعلبة بن ابي مالك، قال: «بات رسول الله صلي الله عليه وسلم في مسجد وراء بني حارثة عند الشيخين، ومعه جدي ابو مالك واصيب يوم حنين وكان من الماءة الصابرة»
 
  قوله تعالي: {يغلبوا ماءتين}
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا عبد الله بن لهيعة، ثنا عطاء بن دينار، عن سعيد بن جبير: " {فان يكن منكم ماءة صابرة يغلبوا} ، يعني: يقتلوا ماءتين من المشركين "
 
  قوله تعالي: {وان يكن منكم الف يغلبوا الفين باذن الله} 
 [الانفال: ]
 
 وبه، عن سعيد بن جبير، " {وان يكن منكم الف يغلبوا الفين} [الانفال: ] ، يعني: الف رجل يغلبوا، يعني: يقتلوا الفين من المشركين باذن الله "
 
  قوله تعالي: {والله مع الصابرين} 
 [البقرة: ]
 
 وبه، عن سعيد بن جبير، " {والله مع الصابرين} [البقرة: ] ، يعني من المسلمين في النصر لهم "
 
  قوله تعالي: {ما كان لنبي ان يكون له اسري} 
 [الانفال: ]
 
 حدثنا يزيد بن سنان البصري، ثنا عمر بن يونس، ثنا عكرمة بن عمار، ثنا ابو زميل، حدثنا عبد الله بن عباس، ثنا عمر بن الخطاب: فذكر طاءفة من الحديث، قال ابو زميل، قال ابن عباس: " فلما اسروا الاساري، قال رسول الله صلي الله عليه وسلم: «يا ابا بكر، وعلي، وعمر،» ما ترون في هءلاء الاساري؟ "، فقال له ابو بكر: يا نبي الله بنو العم والعشيرة اري ان تاخذ منهم فدية فتكون لنا قوة علي الكفار فعسي الله ان يهديهم الي الاسلام، فقال رسول الله صلي الله عليه وسلم: «ما تري يا ابن الخطاب؟» ، قال: قلت لا والله ما اري الذي راي ابو بكر، ولكني اري ان تمكنا منهم فنضرب اعناقهم، تمكن عليا من عقيل فيضرب عنقه وتمكني من فلان نسيب لعمر
 
 فاضرب عنقه، فان هءلاء اءمة الكفر وصناديدها وقادتها فهوي رسول الله صلي الله عليه وسلم: «ما قال ابو بكر، ولم يهو ما قلت» ، فلما كان من الغد جءت الي رسول الله صلي الله عليه وسلم وابي بكر قاعدين يبكيان، فقلت: يا رسول الله اخبرني من اي شء تبكي انت وصاحبك؟ فان وجدت بكاء بكيت وان لم اجد بكاء تباكيت لبكاءكما، فقال رسول الله صلي الله عليه وسلم: " ابكي للذي عرض علي اصحابك من اخذهم الفداء لقد عرض علي عذابكم ادني من هذه الشجرة، شجرة قريبة من نبي الله صلي الله عليه وسلم، وانزل الله عز وجل: {ما كان لنبي ان يكون له اسري حتي يثخن في الارض} [الانفال: ] " الاية
 
 حدثنا ابي، ثنا عثمان بن ابي شيبة، ثنا جرير، عن الاعمش، عن عمرو بن مرة، عن ابي عبيدة، عن عبد الله، قال: " لما كان يوم بدر وجء بالاساري، قال رسول الله صلي الله عليه وسلم: «ما تقولون في هءلاء الاساري؟» ، فقال ابو بكر: يا رسول الله قومك واهلك استبقهم واستانهم لعل الله ان يتوب عليهم، فقال عمر: يا رسول الله اخرجوك وكذبوك فاضرب اعناقهم، فقال عبد الله بن رواحة يا رسول الله انظر واديا كثير الحطب فادخلهم فيه ثم اضرمه عليهم نارا، فقال العباس وهو في الاسري يسمع ما يقولون: قطعت رحمك، فسكت رسول الله صلي الله عليه وسلم لم يجبهم شيءا، فقال ناس: ياخذ بقول ابي بكر، وقال ناس: ياخذ بقول عمر وقال ناس: ياخذ بقول ابن رواحة، فخرج عليهم رسول الله صلي الله عليه وسلم، فقال: ان الله لين قلوب رجال فيه حتي تكون الين من اللين، وان الله ليشدد قلوب رجال فيه حتي تكون اشد من الحجارة، وان مثلك يا ابا بكر كمثل ابراهيم قال: {فمن تبعني فانه مني ومن عصاني فانك غفور رحيم} [ابراهيم: ] ومثلك يا ابا بكر كمثل عيسي، قال: {ان تعذبهم فانهم عبادك وان تغفر لهم فانك انت العزيز الحكيم} [الماءدة: ] ومثلك يا عمر كمثل نوح، قال: {رب لا تذر علي الارض من الكافرين ديارا انك ان تذرهم يضلوا
 
 عبادك ولا يلدوا الا فاجرا كفارا} [نوح: ] ، ومثلك يا عمر كمثل موسي، قال: {ربنا اطمس علي اموالهم واشدد علي قلوبهم فلا يءمنوا حتي يروا العذاب الاليم} [يونس: ] ، انتم عالة فلا ينفلتن منهم احد الا بفداء او ضربة عنق، قال عبد الله بن مسعود: فقلت يا رسول الله، الا سهيل بن بيضاء فاني سمعته يذكر الاسلام، فسكت رسول الله صلي الله عليه وسلم فما رايتني في يوم اخوف ان يقع علي حجارة من السماء مني حتي قال رسول الله صلي الله عليه وسلم: «الا سهيل بن بيضاء» ، فنزل القران بقول عمر، {ما كان لنبي ان يكون له اسري حتي يثخن في الارض} [الانفال: ] الي اخر الايات "
 
  قوله تعالي: {اسري} 
 [الانفال: ]
 
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ، ثنا عبيد بن سليمان، عن الضحاك، " {ما كان لنبي ان يكون له اسري} [الانفال: ] ، يعني: الذين اسروا ببدر "
 
  قوله تعالي: {حتي يثخن في الارض} 
 [الانفال: ]
 
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قوله: " {حتي يثخن في الارض} [الانفال: ] ، يقول: حتي يظهر علي الارض "
 
  الوجه الثاني
 
 حدثنا ابي، ثنا سهل بن عثمان، ثنا ابن ابي غنية، عن حبيب بن ابي العالية، عن مجاهد، " {ما كان لنبي ان يكون له اسري حتي يثخن في الارض} [الانفال: ] والاثخان: هو القتل " وروي عن سعيد بن جبير مثل ذلك
 
  الوجه الثالث
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {ما كان لنبي ان يكون له اسري حتي يثخن في الارض} [الانفال: ] وذلك يوم بدر والمسلمون يومءذ قليل فلما كثروا واشتد سلطانهم انزل الله بعد هذا في الاساري، {فاما منا بعد واما فداء حتي تضع الحرب اوزارها} [محمد: ] ، فجعل
  [ص: ]
 الله النبي والمءمنين في امر الاساري بالخيار ان شاءوا قتلوهم وان شاءوا استعبدوهم وان شاءوا فادوهم "
 
  قوله تعالي: {تريدون عرض الدنيا} 
 [الانفال: ]
 
 حدثنا ابو عبد الله الطهراني، انبا حفص بن عمر العدني، ثنا الحكم بن ابان، عن عكرمة، في قوله: " {تريدون عرض الدنيا} [الانفال: ] ، يعني الخراج "
 
  الوجه الثاني
 
 حدثنا علي بن الحسين، ثنا شيبان، ثنا عقبة الرفاعي، ثنا حيان الاعرج، عن جابر بن زيد، كان يقول: " ليس احد يعمل عملا يريد به وجه الله ياخذ عليه شيءا من عرض الدنيا الا كان حظه منه، يعني: قوله: {تريدون عرض الدنيا} [الانفال: ] "
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، " {تريدون عرض الدنيا} [الانفال: ] ، اي المتاع، الفداء ياخذه الرجل "
 
  قوله تعالي: {والله يريد الاخرة} 
 [الانفال: ]
 
 حدثنا ابي، حدثنا احمد بن ابراهيم الدورقي، حدثنا ابو النضر هاشم بن القاسم، حدثنا ابو سعيد المءدب محمد بن مسلم بن ابي الوضاح، حدثنا القاسم بن فايد، عن الحسن، في قوله: " {تريدون عرض الدنيا والله يريد الاخرة} [الانفال: ] ، قال: «لو لم يكن لنا ذنوب نخاف علي انفسنا منها الا حبنا الدنيا لخشينا علي انفسنا، اريدوا ما اراد الله»
 
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق: " {والله يريد الاخرة} [الانفال: ] ، اي بقتلهم لظهور الذي يريدون اطفاءه، الذي به تدرك الاخرة "
 
  قوله تعالي: {لولا كتاب من الله سبق} 
 [الانفال: ]
 
 حدثنا يونس بن حبيب، ثنا ابو داود، ثنا سلام، يعني ابا الاحوص، عن الاعمش، عن ابي صالح، عن ابي هريرة، قال: " لما كان يوم بدر تعجل الناس الي الغناءم فاصابوها، فقال رسول الله صلي الله عليه وسلم: " ان الغنيمة لا تحل لاحد سود الرءوس
  [ص: ]
 غيركم، كان النبي صلي الله عليه وسلم واصحابه، اذا غنموا الغنيمة جمعوها، ونزلت نار من السماء فاكلتها، فانزل الله هذه الاية: {لولا كتاب من الله سبق} [الانفال: ] ، الي اخر الايتين "
 حدثنا ابي، ثنا المسيب بن واضح، ثنا ابو اسحاق، عن زاءدة، عن الاعمش، عن ابي صالح، عن ابي هريرة، قال رسول الله صلي الله عليه وسلم: «فذكر نحوه وزاد فيه، فوقع الناس في الغناءم قبل ان تحل لهم»
 
 حدثنا ابي، ثنا عبد الله بن جعفر الرقي، ثنا عبيد الله بن عمرو، عن زيد بن ابي انيسة، عن عمرو بن مرة، عن خيثمة، قال: كان سعد، جالسا ذات يوم وعنده نفر من اصحابه، اذ ذكر رجلا فنالوا منه، فقال: مهلا عن اصحاب رسول الله صلي الله عليه وسلم فانا اذنبنا مع رسول الله صلي الله عليه وسلم ذنبا، فانزل الله عز وجل، {لولا كتاب من الله سبق} [الانفال: ] الاية، فكنا نري انها رحمة من الله سبقت " وفي احدي الروايات، عن ابن عباس نحو ذلك
 
  الوجه الثاني
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {ما كان لنبي ان يكون له اسري حتي يثخن في الارض} [الانفال: ] ، وذلك يوم بدر اخذ النبي صلي الله عليه وسلم المغانم قبل ان يءمروا به، وكان الله تبارك وتعالي، قد كتب في ام الكتاب: المغنم والاسري حلال لمحمد وامته، ولم يكن احله لامة قبلهم، واخذوا المغانم، واسروا الاساري قبل ان ينزل اليهم في ذلك، قال الله: {لولا كتاب من الله سبق} [الانفال: ] ، يعني في الكتاب الاول ان المغانم والاساري حلال لكم، {لمسكم فيما اخذتم عذاب عظيم} [الانفال: ] " وروي عن قتادة انه قال: باحلال المغانم لهذه الامة. وروي عن سعيد بن جبير قال: سبق علمي اني احللت لكم المغانم، وكذا روي عن عطاء بن ابي رباح
 
 حدثنا عمار بن خالد، ثنا ابو صيفي، قال: سمعت سعيد بن ابي سعيد المقبري، عن ابي هريرة، في قوله: " {لولا كتاب من الله سبق لمسكم فيما اخذتم} [الانفال: ] ، من الاساري {عذاب عظيم} [الانفال: ] ، قال
  [ص: ]
 : يقول الله عز وجل: لولا انه سبق في علمي اني ساحل المغانم، {لمسكم فيما اخذتم عذاب عظيم} [الانفال: ] "
 
  الوجه الثالث
 
 حدثنا ابي، ثنا مالك بن اسماعيل، ثنا شريك، عن سالم، عن سعيد بن جبير، " {لولا كتاب من الله سبق} [الانفال: ] ، قال: ما سبق لاهل بدر من السعادة " وروي عن الحسن: «سبق لاهل بدر ان لا يعذبهم» وروي عن عطاء نحو ذلك
 
  الوجه الرابع
 
 حدثنا احمد بن منصور المروزي، ثنا النضر بن اسماعيل، انبا شعبة، قال: سمعت ابا هاشم، قال: سمعت مجاهدا، يقول: " {لولا كتاب من الله سبق} [الانفال: ] ، قال: سبق لهم المغفرة "
 
 حدثنا ابي، ثنا قبيصة، ثنا سفيان: " {لولا كتاب من الله سبق} [الانفال: ] ، قال: كتاب احل لكم الغنيمة سبق المغفرة "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، انبا عبد الرحمن بن زيد بن اسلم، في قول الله: " {لولا كتاب من الله سبق لمسكم فيما اخذتم عذاب عظيم} [الانفال: ] ، قال: سبق من الله العفو عنهم والرحمة، لهم سبق انه لا يعذب المءمنين لا يعذب رسوله، ومن امن معه وهاجر معه ثم نصر ولم يكن من المءمنين احد ممن حضر الا احب الغناءم الا عمر بن الخطاب، جعل لا يلقي اسيرا الا ضرب عنقه، قال: يا رسول الله، ما لنا وللغناءم انما نحن قوم نجاهد في دين الله حتي يعبد الله، فقال رسول الله صلي الله عليه وسلم: «لو عذبنا في هذا الامر يا عمر ما نجا منه غيرك» ، قال الله: لا تعودوا لا تستحلوا قبل ان احل لكم "
 
  الوجه الخامس
 
 حدثنا ابي، ثنا هارون بن محمد بن بكار، ثنا محمد بن عيسي بن سميع، حدثنا روح بن القاسم، ثنا ابن ابي نجيح، عن مجاهد، انه كان يقول: " {لولا كتاب من الله سبق} [الانفال: ] ، ان لا يعذب احدا حتي يبين له ويتقدم اليه "
 
  قوله تعالي: {لمسكم} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو، ثنا سلمة، عن ابن اسحاق، " {لمسكم فيما اخذتم} [الانفال: ] لعذبتكم فيما صنعتم "
 
  قوله تعالي: {لمسكم فيما اخذتم عذاب عظيم} 
 [الانفال: ]
 
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا ابن ادريس، قال ابن اسحاق، ثنا ابن ابي نجيح، عن عطاء، عن ابن عباس، قوله: " {لمسكم فيما اخذتم عذاب عظيم} [الانفال: ] ، يقول: غناءم بدر قبل ان يحلها لهم يقول: لولا اني لا اعذب من عصاني حتي اتقدم اليه، {لمسكم فيما اخذتم عذاب عظيم} [الانفال: ] "
 
 حدثنا ابي، ثنا عمرو بن عون، واحمد بن عبد الله بن يونس، قالا: ثنا شريك، عن سالم، عن سعيد بن جبير، " {لمسكم فيما اخذتم} [الانفال: ] ، قال: من الفداء {عذاب عظيم} [الانفال: ] "
 
  قوله تعالي: {فكلوا مما غنمتم حلالا طيبا} 
 [الانفال: ]
 
 حدثنا يزيد بن سنان، نزيل مصر، ثنا عمر بن يونس اليمامي، ثنا عكرمة بن عمار، حدثنا ابو زميل، حدثنا عبد الله بن عباس، حدثنا عمر بن الخطاب، قال: " فانزل الله {فكلوا مما غنمتم حلالا طيبا} [الانفال: ] ، فاحل الله الغنيمة لهم "
 
  قوله تعالي: {يا ايها النبي قل لمن في ايديكم من الاسري} 
 [الانفال: ]
 
 حدثنا عمار بن خالد، ثنا ابو صيفي، قال: سمعت سعيد بن ابي سعيد المقبري، عن ابي هريرة، قال: كان العباس بن عبد المطلب يقول: " اعطاني الله هذه الاية: {يا ايها النبي قل لمن في ايديكم من الاسري} [الانفال: ] واعطاني مكان ما اخذ مني اربعون اوقية اربعين عبدا " وروي عن سعيد بن جبير نحو ذلك
 
 حدثنا ابي، ثنا ابو سلمة، ثنا وهيب، عن داود، عن عامر، " {يا ايها النبي قل لمن في ايديكم من الاسري} [الانفال: ] ، فقال عامر: اسر يوم بدر العباس، وعقيل، ونوفل بن الحارث بن عبد المطلب "
 
  قوله تعالي: {ان يعلم الله في قلوبكم خيرا} 
 [الانفال: ]
 
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، ثنا عبيد بن سليمان، عن الضحاك، قوله: " {يا ايها النبي قل لمن في ايديكم من الاسري} [الانفال: ] ، يعني العباس واصحابه، اسروا يوم بدر، يقول الله تعالي: ان عملتم بطاعتي ونصحتم لي ولرسولي اعطيتكم خيرا مما اخذ منكم وغفرت لكم "
 
  قوله تعالي: {يءتكم خيرا مما اخذ منكم} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: " {يا ايها النبي قل لمن في ايديكم من الاسري ان يعلم الله في قلوبكم خيرا يءتكم خيرا مما اخذ منكم} [الانفال: ] ، كان العباس بن عبد المطلب اسر يوم بدر افتدي نفسه باربعين اوقية من ذهب، فقال العباس حين نزلت هذه الاية لقد اعطاني الله خصلتين ما احب ان لي بهما الدنيا: اني اسرت يوم بدر ففديت نفسي باربعين اوقية فاعطاني الله اربعين عبدا وانا ارجو المغفرة التي وعدنا الله "
 
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا ابن ادريس قال: قال ابن اسحاق: حدثنا عبد الله بن ابي نجيح، عن عطاء، عن عبد الله بن عباس: " {ان يعلم الله في قلوبكم خيرا يءتكم خيرا مما اخذ منكم} [الانفال: ] ، فكان العباس يقول: في والله نزلت حين اخبرت رسول الله صلي الله عليه وسلم عن اسلامي وسالته ان يحاسبني بالعشرين اوقية التي اخذ مني، فابي ان يحاسبني بها فاعطاني الله بالعشرين اوقية عشرين عبدا كلهم تاجر بمال في يده مع ما ارجو من مغفرة الله عز وجل "
 
 وقوله تعالي: اخبرنا محمد بن سعد بن عطية فيما كتب الي، ثنا ابي، ثنا عمي، عن ابيه، عن جده، عن عبد الله بن عباس: " {ويغفر لكم والله غفور رحيم} [الانفال: ] ، يعني: غفرت لكم "
 
  قوله تعالي: {وان يريدوا خيانتك} 
 [الانفال: ]
 
 حدثنا محمد بن عبد الله بن ميمون الاسكندراني، ثنا الوليد بن مسلم، حدثنا محمد سعيد بن بشير، عن قتادة، قال: قال الله تبارك وتعالي: " {وان يريدوا خيانتك فقد خانوا الله من قبل فامكن منهم} [الانفال: ] ، قال: ان عبد الله بن سعد بن ابي
 
 سرح، كان يكتب للنبي صلي الله عليه وسلم الوحي فنافق فلحق بالمشركين بمكة وقال: والله ان كان محمد لا يكتب الا ما شءت، فسمع بذلك رجل من الانصار حلف لان امكنه الله منه ليضربه ضربة بالسيف، فلما كان يوم فتح مكة جاء به عثمان بن عفان، فكانت بينهما رضاعة، فقال: يا رسول الله هذا عبد الله قد اقبل نادما فاعرض عنه، واقبل الانصاري معه سيف فاطاف به ثم مد رسول الله صلي الله عليه وسلم يده ليبايعه، وقال للانصاري: لقد تلومت به اليوم، فقال الانصاري: فهلا اومضت؟ قال: لا ينبغي لنبي ان يومض "
 
 حدثنا احمد بن هارون بن الاشعث، ثنا اسحاق بن الحجاج، قال يعقوب الزهري: قوله: " {وان يريدوا خيانتك} [الانفال: ] ، يعني: الاسري "
 
  قوله تعالي: {فقد خانوا الله من قبل} 
 [الانفال: ]
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن مفضل، عن اسباط، عن السدي، " {فقد خانوا الله من قبل فامكن منهم} [الانفال: ] ، يقول: قد كفروا بالله ونقضوا عهده من قبل "
 
 حدثنا احمد بن هارون بن الاشعث، ثنا اسحاق بن الحجاج، ثنا يعقوب الزهري، " {فقد خانوا الله من قبل} [الانفال: ] اي حين غزوك، {فامكن منهم} [الانفال: ] "
 
  قوله تعالي: {فامكن منهم} 
 [الانفال: ]
 
 اخبرنا احمد الاودي، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، " {فامكن منهم} [الانفال: ] ، يقول: ببدر "
 
  قوله تعالي: {ان الذين امنوا وهاجروا وجاهدوا باموالهم وانفسهم في سبيل الله} 
 [الانفال: ]
 
 اخبرنا محمد بن سعد العوفي، فيما كتب الي، ثنا ابي، ثنا عمي، عن ابيه، عن جده، عن عبد الله بن عباس، قوله: " {ان الذين امنوا وهاجروا وجاهدوا باموالهم وانفسهم في سبيل الله} [الانفال: ] ، يقول: لا هجرة بعد الفتح انما هو الشهادة بعد ذلك، وذلك ان المءمنين كانوا علي عهد رسول الله صلي الله عليه وسلم علي ثلاث
  [ص: ]
 منازل: منهم المءمن المهاجر المباين لقومه في الهجرة، خرج الي قوم مءمنين في ديارهم وعقارهم واموالهم "
 
  قوله تعالي: {والذين اووا ونصروا} 
 [الانفال: ]
 
 وبه، عن ابن عباس، قوله: " {والذين اووا ونصروا} [الانفال: ] ، قال: اووا ونصروا واعلنوا ما اعلن اهل الهجرة، وشهروا السيوف علي من كذب وجحد فهذان مءمنان، جعل الله بعضهم اولياء بعض "
 
  قوله تعالي: {اولءك بعضهم اولياء بعض} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، " {اولءك بعضهم اولياء بعض} [الانفال: ] ، يعني: في الميراث، جعل الله الميراث للمهاجرين والانصار دون الارحام "
 
  قوله تعالي: {والذين امنوا ولم يهاجروا} 
 [الانفال: ]
 
 اخبرنا احمد بن عثمان، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي، قوله: " {والذين امنوا ولم يهاجروا} [الانفال: ] هءلاء الاعراب "
 
 اخبرنا محمد بن سعد بن عطية، فيما كتب الي، ثنا ابي، ثنا عمي، عن ابيه، عن جده، عن ابن عباس، " {والذين امنوا ولم يهاجروا} [الانفال: ] ، قال: فكانوا يتوارثون بينهم اذا توفي المءمن المهاجر بالولاية في الدين، وكان الذي امن ولم يهاجر لا يرث من اجل انه لم يهاجر ولم ينصر "
 
 حدثنا ابي، ثنا محمد بن عبد الله بن بكير بن سليمان الصنعاني، ببيت المقدس، ثنا ابو سعيد عبد الرحمن بن عبد الله البصري، مولي بني هاشم، ثنا عمر بن فروخ، ثنا حبيب بن الزبير، عن عكرمة، في قول الله تعالي: " {والذين امنوا ولم يهاجروا} [الانفال: ] ، قال: لبث برهة والاعرابي لا يرث المهاجر، ولا المهاجر يرث الاعرابي، حتي فتحت مكة ودخل الناس في الدين افواجا، فانزل الله تعالي: {واولو الارحام بعضهم اولي ببعض في كتاب الله} [الاحزاب: ] "
 
  قوله تعالي: {ما لكم من ولايتهم من شء حتي يهاجروا} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {ما لكم من ولايتهم من شء} [الانفال: ] ، ما لكم من ميراثهم شء "
 
 اخبرنا محمد بن سعد بن عطية، فيما كتب الي، ثنا ابي، ثنا عمي، عن ابيه، عن جده، عن عبد الله بن عباس، " {ما لكم من ولايتهم من شء حتي يهاجروا} [الانفال: ] ، فبرا الله المءمنين المهاجرين من ميراثهم وهي الولاية التي قال الله: {ما لكم من ولايتهم من شء حتي يهاجروا} [الانفال: ] ، وكان حقا علي المءمنين "
 
  قوله تعالي: {وان استنصروكم في الدين} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {وان استنصروكم} [الانفال: ] ، يعني: ان استنصروا الاعراب المسلمون المهاجرين والانصار علي عدو لهم فعليهم ان ينصروهم، قال: {الا علي قوم بينكم وبينهم ميثاق} [الانفال: ] "
 
 اخبرنا احمد بن عثمان بن حيكم، فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي، قوله: " {وان استنصروكم في الدين} [الانفال: ] ، يقول: بانهم مسلمون "
 
  قوله تعالي: {فعليكم النصر الا علي قوم} [الانفال: ] الاية
 
 اخبرنا محمد بن سعد، فيما كتب الي، ثنا ابي، ثنا عمي، عن ابيه، عن جده، عن ابن عباس، " {فعليكم النصر الا علي قوم بينكم وبينهم ميثاق} [الانفال: ] ، ان استنصروهم في الدين ان ينصروهم ان قوتلوا الا ان يستنصروا علي قوم بينهم وبين النبي صلي الله عليه وسلم ميثاق، ولا نصر لهم عليهم الا علي العدو الذين لا ميثاق لهم "
 
 اخبرنا موسي بن هارون الطوسي، فيما كتب الي، ثنا الحسين بن محمد المروذي، حدثنا شيبان، عن قتادة، قوله: " {وان استنصروكم في الدين فعليكم النصر الا علي قوم بينكم وبينهم ميثاق} [الانفال: ] ، قال: نهي المسلمون عن اهل ميثاقهم فوالله لاخوك المسلم اعظم عليك حرمة وحقا "
 
  قوله تعالي: {والذين كفروا بعضهم اولياء بعض} 
 [الانفال: ]
 
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {والذين كفروا بعضهم اولياء بعض} [الانفال: ] ، يعني: في الميراث "
 
 حدثنا ابي، ثنا قبيصة بن عقبة، ثنا سفيان، عن السدي، عن ابي مالك، قال رجل من المسلمين: " لنورثن ذوي القربي منا من المشركين فنزلت: {والذين كفروا بعضهم اولياء بعض الا تفعلوه تكن فتنة في الارض وفساد كبير} [الانفال: ] ، بين المسلمين والمشركين فيقول: ان ظهر هءلاء كنت معهم وان ظهر هءلاء كنت معهم، فابي الله ذلك عليهم وانزل الله في ذلك فلا تراءي ناران: نار مسلم، ونار مشرك الا صاحب جزية مقر بالخراج "
 
  قوله تعالي: {الا تفعلوه} 
 [الانفال: ]
 
 حدثنا ابي، حدثنا ابو صالح، حدثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {الا تفعلوه} [الانفال: ] ، يعني: الا تاخذوا يعني: في الميراث بما امرتكم به تكن فتنة وفساد كبير "
 
 حدثنا ابي، ثنا احمد بن عبد الرحمن، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع، في قوله: " {الا تفعلوه} [الانفال: ] ، يعني: الا تولي الكافر الكافر "
 
  قوله تعالي: {تكن فتنة في الارض} 
 [الانفال: ]
 
 حدثنا علي بن الحسين، ثنا محمد بن ابي حماد، ثنا مهران، عن سفيان، قوله: " {الا تفعلوه تكن فتنة في الارض} [الانفال: ] ، قال: كفر وفساد كبير، قال سفيان: لا ادري ايتهما قال: الكفر: الفتنة او الفساد؟ "
 
  قوله تعالي: {وفساد كبير} 
 [الانفال: ]
 
 حدثنا ابي، ثنا احمد بن عبد الرحمن الدشتكي، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع، في قوله: " {تكن فتنة في الارض وفساد كبير} [الانفال: ] ، يعني: لا يصلح لمسلم ان يرث الكافر "
 
  قوله تعالي: {والذين امنوا وهاجروا وجاهدوا في سبيل الله والذين اووا ونصروا اولءك هم المءمنون حقا} [الانفال: ] قد تقدم تفسيره والله اعلم
 
  قوله تعالي: {لهم مغفرة ورزق كريم} 
 [الانفال: ]
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ بن الفرج، انبا عبد الرحمن بن زيد بن اسلم، في قول الله: " {مغفرة} [الانفال: ] ، قال: بترك الذنوب، {ورزق كريم} [الانفال: ] ، قال: الاعمال الصالحة "
 
  قوله تعالي: {والذين امنوا من بعد وهاجروا وجاهدوا معكم فاولءك منكم} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا محمد بن عمرو، ثنا سلمة، عن ابن اسحاق، قال: «حض الله المءمنين علي التواصل، فجعل المهاجرين، والانصار اهل ولاية في الدين دون من سواهم»
 
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، ثنا عبيد بن سليمان، عن الضحاك، قوله: " {والذين امنوا من بعد وهاجروا وجاهدوا معكم فاولءك منكم} [الانفال: ] ، فان رسول الله صلي الله عليه وسلم توفي وترك الناس علي اربع منازل: مءمن مهاجر، ومسلم اعرابي والذين اووا، ونصروا، والتابعين باحسان "
 
  قوله تعالي: {واولو الارحام بعضهم اولي ببعض} [الاحزاب: ] الاية
 
 حدثنا ابي، ثنا احمد بن بكر المصعبي، من سكني بغداد، ثنا عبد الرحمن بن ابي الزناد، عن هشام بن عروة، عن ابيه، عن الزبير بن العوام، قال: " انزل الله فينا خاصة معشر قريش، والانصار: {واولو الارحام بعضهم اولي ببعض في كتاب الله} [الاحزاب: ] ، قال: وذلك انا معشر قريش لما قدمنا المدينة ولا اموال لنا، فوجدنا الانصار نعم الاخوان فواخيناهم واورثناهم، فاخي ابو بكر خارجة بن زيد، واخي عمر فلانا واخي عثمان بن عفان رجلا من بني زريق بن سعد الزرقي، ويقول بعض الناس غيره، قال الزبير: وواخيت انا كعب بن مالك، واورثونا واورثناهم، فلما كان يوم احد قيل لي: قد قتل اخوك كعب بن مالك، فجءته فانتقلته، فوجدت السلاح قد ثقله فيما
 
 نري، فوالله يا بني لو مات يومءذ، عن الدنيا ما ورثه غيري، حتي انزل الله هذه الاية فينا معشر قريش والانصار خاصة فرجعنا الي مواريثنا "
 
 حدثنا الحسن بن محمد بن الصباح، ثنا حجاج بن محمد، انبا ابن جريج، وعثمان بن عطاء، عن عطاء الخراساني، عن ابن عباس، " {الذين امنوا وهاجروا وجاهدوا باموالهم وانفسهم} [الانفال: ] في سبيل الله والذين اووا ونصروا اولءك بعضهم اولياء بعض والذين امنوا ولم يهاجروا ما لكم من ولايتهم من شء حتي يهاجروا " فكان المهاجر لا يتولي الاعرابي ولا يرث وهو مءمن ولا يرث الاعرابي المهاجر فنسختها هذه الاية، {واولو الارحام بعضهم اولي ببعض في كتاب الله} [الاحزاب: ] "
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا عبد الله بن لهيعة، ثنا عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {واولو الارحام بعضهم اولي ببعض في كتاب الله ان الله بكل شء عليم} ، فنسخت هذه الاية ما كان قبلها من مواريث العقد والحلف والمواريث بالهجرة وصارت لذوي الارحام، قال: والوالد اولي من الاخ، والاخ والاخت اولي من ابن الاخ، وابن الاخ اولي من العم، والعم اولي من ابن العم، وابن العم اولي من الخال، وليس للخال ولا العمة ولا الخالة من الميراث نصيب في قول زيد رضي الله عنه، وكان عمر بن الخطاب رضي الله عنه يعطي ثلثي المال للعمة والثلث للخالة، اذا لم يكن له وارث وكان علي، وابن مسعود رضي الله عنهما يعني: يردان ما فضل من الميراث علي ذوي الارحام علي قدر سهمانهم غير الزوج والمراة "
 
  الوجه الثاني
 
 حدثنا علي بن حرب الموصلي، ثنا حميد بن عبد الرحمن الرءاسي، عن الحسن بن عبيد الله، عن القاسم، عن ابن عباس، " وقيل له ان ابن مسعود، لا يورث الموالي دون ذوي الارحام، ويقول: ان ذوي الارحام بعضهم اولي ببعض في كتاب الله، فقال ابن عباس: " هيهات هيهات اين ذهب؟ انما كان المهاجرون يتوارثون دون الاعراب فنزلت: {واولو الارحام بعضهم اولي ببعض في كتاب الله} [الاحزاب: ] ، يعني: انه يورث المولي "
 
  الوجه الثالث
 
 حدثنا احمد بن سنان، ثنا عبد الرحمن بن مهدي، عن سفيان، عن نسير بن ذعلوق، قال: قال رجل للربيع: اوص لي بمصحفك " فنظر الي ابن له صغير، فقال: {واولو الارحام بعضهم اولي ببعض في كتاب الله} [الاحزاب: ] "
 
  قوله تعالي: {في كتاب الله} 
 [الانفال: ]
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، قوله: " {كتاب} [الانفال: ] ، قال: القران "
 
  قوله تعالي: {ان الله بكل شء عليم} 
 [الانفال: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا زنيج، ثنا سلمة، ثنا محمد بن اسحاق، " {عليم} [الانفال: ] ، اي: عليم بما يخفون "
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا عبد الله بن لهيعة، ثنا عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {ان الله بكل شء عليم} [الانفال: ] ، يعني: من اعمالكم عليم "
 
  سورة التوبة 
 ومن السورة التي تذكر فيها التوبة
 
  قوله تعالي: {براءة من الله ورسوله} 
 [التوبة: ]
 
 حدثنا احمد بن منصور الرمادي، ثنا عبد الرزاق، انبا معمر، عن الزهري، عن ابن المسيب، عن ابي هريرة في قوله: {براءة من الله ورسوله} [التوبة: ] قال: لما كان النبي صلي الله عليه وسلم زمان حنين اعتمر من الجعرانة ثم امر ابا علي تلك الحجة , قال معمر: قال الزهري: وكان ابو هريرة يحدث: ان ابا بكر امر ابا هريرة ان يءذن ببراءة في حجة ابي بكر بمكة، قال ابو هريرة: ثم اتبعنا النبي صلي الله عليه وسلم عليا، وامره ان يءذن ببراءة وابو بكر علي الموسم كما هو او قال: علي هيءته
 
 حدثنا احمد بن منصور الرمادي، ثنا سعيد بن سليمان الواسطي، ثنا عباد بن عوام، عن سفيان بن الحسين، عن الحكم، عن مقسم، عن ابن عباس: ان رسول الله صلي الله عليه وسلم " بعث ابا بكر رضي الله عنه، وامره ان ينادي بهءلاء الكلمات، ثم اتبعه عليا فبينا ابو بكر في بعض الطريق اذ سمع رغاء ناقة رسول الله صلي الله عليه وسلم القصوي فخرج ابو بكر فزعا ظن انه رسول الله صلي الله عليه وسلم فاذا علي فدفع اليه كتاب النبي صلي الله عليه وسلم فامره علي الموسم وامر عليا ينادي بهءلاء الكلمات فانطلقا فحجا فقام علي ايام التشريق فنادي: ذمة الله ورسوله بريءة من كل مشرك {فسيحوا في الارض اربعة اشهر} [التوبة: ] ولا يحجن بعد هذا العام مشرك ولا يطوفن بالبيت عريان ولا يدخل الجنة الا مءمن فكان علي رضي الله عنه ينادي بها فاذا بح قام ابو هريرة فنادي بها
 
 اخبرنا احمد بن عثمان فيما كتب الي ثنا احمد بن المفضل، ثنا اسباط، عن السدي قوله: {براءة من الله ورسوله الي الذين عاهدتم من المشركين} [التوبة: ] قال: «لما نزلت هذه الاية برء من عهد كل مشرك ولم يعاهد بعدها الا من كان عاهد واجري لكل قوم مدتهم»
 
  قوله تعالي: {الي الذين عاهدتم من المشركين} 
 [التوبة: ]
 
 حدثنا حجاج بن حمزة حدثنا شبابة ثنا ورقاء عن ابن ابي نجيح عن مجاهد في قوله: {براءة من الله ورسوله الي الذين عاهدتم من المشركين} [التوبة: ] الي اهل العهد خزاعة ومدلج ومن كان له عهد وغيرهم اقبل رسول الله صلي الله عليه وسلم من تبوك حين فرغ منها فاراد الحج ثم قال: «انه يحضر البيت مشركون يطوفون عراة فلا احب ان احج حتي لا يكون ذلك» فارسل ابا بكر وعليا فطافا في الناس بذي المجاز وبامكنتهم التي كانوا يبيعون بها وبالموسم كله فاذنوا اصحاب العهد ان يامنوا اربعة اشهر
 
  قوله تعالي {فسيحوا في الارض} 
 [التوبة: ]
 
 حدثنا ابي ثنا ابو صالح ثنا معاوية بن صالح عن علي بن ابي طلحة عن ابن عباس قوله: {فسيحوا في الارض اربعة اشهر} [التوبة: ] قال: «حد الله للذين عاهدوا رسوله اربعة اشهر يسيحون في الارض حيث شاءوا»
 
 حدثنا ابي ثنا احمد بن محمد بن الوليد بن برد ثنا محمد بن جعفر بن محمد عن جعفر بن محمد عن ابيه اما قوله: {فسيحوا في الارض اربعة اشهر} [التوبة: ] «للمشركين ولن يطوف حول البيت عريان»
 
  قوله تعالي: {اربعة اشهر} 
 [البقرة: ]
 
 حدثنا حجاج بن حمزة ثنا شبابة ثنا ورقاء عن ابن ابي نجيح عن مجاهد في قوله: {فسيحوا في الارض اربعة اشهر} [التوبة: ] " وهي الاشهر الحرم المنسلخات المتواليات: عشرون من اخر ذي الحجة الي عشرة تخلو من شهر ربيع الاخر ثم لا عهد لهم " وروي عن السدي والضحاك نحو ذلك
 
  والوجه الثاني
 
 حدثنا ابي حدثنا محمد بن عبد الاعلي حدثنا محمد بن ثور عن معمر عن الزهري {فسيحوا في الارض اربعة اشهر} [التوبة: ] قال: " نزلت في شوال فهي الاربعة اشهر: شوال وذو القعدة وذو الحجة والمحرم "
 
  قوله تعالي: {واعلموا انكم غير معجزي الله وان الله مخزي الكافرين} 
 [التوبة: ]
 
 قرات علي محمد بن الفضل حدثنا محمد بن علي حدثنا محمد بن مزاحم حدثنا بكير بن معروف عن مقاتل بن حيان قال: بلغنا والله اعلم في قوله: {واعلموا انكم غير معجزي الله} [التوبة: ] يقول: «انكم غير سابقي الله في الارض وان الله مخزي الكافرين»
 
  قوله تعالي: {واذان من الله ورسوله} 
 [التوبة: ]
 
 ذكر عن عباد بن يعقوب ثنا علي بن هاشم عن ابي الجارود عن حكيم بن حميد قال: قال لي علي بن الحسين: " ان لعلي في كتاب الله اسما ولكن لا تعرفونه قلت: ما هو؟ قال: الم تسمع قول الله {واذان من الله ورسوله الي الناس يوم الحج الاكبر} [التوبة: ] ؟ هو والله الاذان "
 
  والوجه الثاني
 
