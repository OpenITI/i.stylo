 حدثنا احمد بن سنان، ثنا ابو معاوية، ثنا الاعمش، عن ابي صالح، قال: " لما مرض ابو طالب فقالوا له: لو ارسلت الي ابن اخيك هذا فيرسل اليك بعنقود من جنته لعله ان يشفيك به فجاءه الرسول وابو بكر عند رسول الله صلي الله عليه وسلم، فقال ابو بكر رضي الله عنه: {ان الله حرمهما علي الكافرين} [الاعراف: ] "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول في قوله تعالي: " {ان الله حرمهما علي الكافرين} [الاعراف: ] ، قال: طعام الجنة وشرابها "
 
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا زيد بن الحباب، اخبرني سفيان الثوري، عن عثمان الثقفي، عن سعيد بن جبير، عن ابن عباس، قال: " ينادي الرجل من اهل النار الرجل من اهل الجنة: يا فلان ادركني قد احترقت، فيقول: {ان الله حرمهما علي الكافرين} [الاعراف: ] "
 
  قوله تعالي: {الذين اتخذوا دينهم لهوا ولعبا} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قال: " {الذين اتخذوا دينهم لهوا} [الاعراف: ] ، يقول: لعبا "
 
 حدثنا عبد الرحمن بن محمد بن منصور البصري، ثنا ابي، ثنا جعفر بن سليمان، عن عمر بن نبهان، عن قتادة، قوله: " {اتخذوا دينهم لهوا ولعبا} [الاعراف: ] ، قال: اكلا وشربا "
 
 حدثنا ابي، ثنا قبيصة بن عقبة، ثنا سفيان، عن عبد الكريم، عن مجاهد، قال: «كل لعب لهو»
 
  قوله تعالي: {وغرتهم الحياة الدنيا} 
 [الانعام: ]
 
 حدثنا ابي، ثنا احمد بن عبد الرحمن، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع، قال: «غرهم ما كانوا يفترون»
 
  قوله تعالي: {فاليوم ننساهم} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {فاليوم ننساهم كما نسوا لقاء يومهم هذا} [الاعراف: ] ، يقول: نتركهم في النار كما تركوا لقاء يومهم هذا " وروي عن مجاهد: انه قال: نسوا في العذاب
 
 حدثنا الحسين بن الحسن، ثنا ابراهيم بن عبد الله، ثنا حجاج، عن ابن جريج، عن مجاهد: " {ننساهم} [الاعراف: ] : نءخرهم في النار "
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي: " {فاليوم ننساهم كما نسوا لقاء يومهم هذا} [الاعراف: ] نتركهم من الرحمة "
 
  الوجه الثاني
 
 اخبرنا محمد بن سعد العوفي، فيما كتب الي، حدثني ابي، حدثني عمي، عن ابي، عن ابيه، عن ابن عباس، قوله: " {فاليوم ننساهم كما نسوا لقاء يومهم هذا} [الاعراف: ] ، يقول: نسيهم الله من الخير ولم ينسهم من الشر "
 
  قوله تعالي: {كما نسوا لقاء يومهم هذا} 
 [الاعراف: ]
 
 حدثنا ابو سعيد الاشج، ثنا محمد بن عبيد، عن جويبر، عن الضحاك، " {فاليوم ننساهم كما نسوا لقاء يومهم هذا} [الاعراف: ] ، قال: كما تركتم امري "
 
 اخبرنا احمد بن عثمان، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {فاليوم ننساهم كما نسوا لقاء يومهم هذا} [الاعراف: ] ، قال: كما تركوا ان يعملوا للقاء يومهم هذا " وروي عن مجاهد نحو ذلك
 
  قوله تعالي: {وما كانوا باياتنا يجحدون} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا علي بن نصر، ثنا عمرو بن عاصم، ثنا ابو الاشهب، قال: قال الحسن يعني بقوله: " {يجحدون} [الاعراف: ] ، قال: «جحدوا بعد المعرفة»
 
  قوله تعالي: {ولقد جءناهم بكتاب فصلناه علي علم} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، " {فصلناه} [الاعراف: ] ، يقول: بيناه "
 
  قوله تعالي: {هدي} 
 [البقرة: ]
 
 حدثنا الحسن بن ابي الربيع، عن عبد الرزاق، انبا الثوري، عن بيان، عن الشعبي، في قوله: " {هدي} [الاعراف: ] من الضلالة "
 
  والوجه الثاني
 
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، " واما {هدي} [الاعراف: ] فنور "
 
  الوجه الثالث
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، قوله: " {هدي} [البقرة: ] ، قال: تبيان "
 
  قوله تعالي: {ورحمة} 
 [البقرة: ]
 
 اخبرنا العباس بن الوليد بن مزيد البيروني، قراءة، اخبرني محمد بن شعيب بن شابور، انبا سعيد، عن قتادة، قوله: " {ورحمة} [الاعراف: ] ، قال: القران " وروي عن ابي العالية مثل ذلك
 
  قوله تعالي: {لقوم يءمنون} 
 [الانعام: ]
 
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة بن الفضل، عن ابن اسحاق، " {هدي ورحمة لقوم يءمنون} [الاعراف: ] ، اي مغفرة لما ركبوا "
 
  قوله تعالي: {هل ينظرون الا تاويله} 
 [الاعراف: ]
 
 ذكر عن علي بن نصر، ثنا محمد بن جهضم، عن الفرات، عن معاوية بن قرة، " {هل ينظرون الا تاويله} [الاعراف: ] ، قال: الجزاء به في الاخرة "
 
 حدثنا محمد بن يحيي، انبا العباس، ثنا يزيد، عن سعيد، عن قتادة، قوله: " {هل ينظرون الا تاويله} [الاعراف: ] : اي ثوابه "
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {هل ينظرون الا تاويله} [الاعراف: ] اما «تاويله» : عواقبه مثل وقعة بدر، والقيامة وما وعد فيه من موعد "
 
  قوله تعالي: {يوم ياتي تاويله} 
 [الاعراف: ]
 
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني ابي، حدثني، عمي، عن ابيه، عن ابن عباس، قوله: " {هل ينظرون الا تاويله يوم ياتي تاويله} [الاعراف: ] فهو يوم القيامة "
 
 حدثنا ابي، ثنا احمد بن عبد الرحمن، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع، في قوله: " {يوم ياتي تاويله} [الاعراف: ] ، قال: لا يزال يجء من تاويله امر حتي يوم الحساب، حتي يدخل اهل الجنة الجنة واهل النار النار فتم تاويله يومءذ "
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {تاويله} [الاعراف: ] جزاءه "
 
  الوجه الثاني
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي الصنعاني، ثنا محمد بن ثور، عن معمر، عن قتادة، " {هل ينظرون الا تاويله يوم ياتي تاويله} [الاعراف: ] ، قال: عاقبته "
 
  والوجه الثالث
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول في قوله: " {يوم ياتي تاويله} [الاعراف: ] ، قال: تحقيقه، وقرا قول الله: {هذا تاويل رءياي من قبل} [يوسف: ] ، قال: هذا تحقيقها، وقرا: {وما يعلم تاويله الا الله} [ال عمران: ] ، قال: وما يعلم تحقيقه الا الله "
 
  قوله تعالي: {يقول الذين نسوه من قبل} 
 [الاعراف: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {يقول الذين نسوه من قبل} [الاعراف: ] اعرضوا عنه "
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {يقول الذين نسوه من قبل} [الاعراف: ] اما الذين نسوه، فتركوه "
 
  قوله تعالي: {قد جاءت رسل ربنا بالحق} 
 [الاعراف: ]
 
 وبه عن السدي، قوله: " {قد جاءت رسل ربنا بالحق} [الاعراف: ] فلما راوا ما وعدهم انبياءهم استيقنوا فقالوا: {قد جاءت رسل ربنا بالحق} [الاعراف: ] "
 
  قوله تعالي: {فهل لنا من شفعاء فيشفعوا لنا او نرد فنعمل غير الذي كنا نعمل} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا احمد بن عبد الرحمن، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع، قوله: " {يقول الذين نسوه من قبل قد جاءت رسل ربنا بالحق} [الاعراف: ] فلا يزال يقع من تاويله امر حتي تم تاويله يوم القيامة ففي ذلك انزل {هل ينظرون الا تاويله} [الاعراف: ] حيث اثاب الله اولياءه واعداءه ثواب اعمالهم {يقول} [الاعراف: ] يومءذ {الذين نسوه من قبل قد جاءت رسل ربنا بالحق فهل لنا من شفعاء فيشفعوا لنا او نرد فنعمل غير الذي كنا نعمل} [الاعراف: ] "
 
  قوله تعالي: {قد خسروا انفسهم} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا محمد بن بشار، ثنا يحيي بن سعيد، عن سفيان، عن الاعمش، عن ابي رزين، في قوله: " {قد خسروا انفسهم} [الاعراف: ] ، قال: قد ضلوا "
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {قد خسروا انفسهم} [الاعراف: ] ، اما خسروا انفسهم فبشروها بخسران "
 
  قوله تعالي: {وضل عنهم} 
 [الانعام: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {وضل عنهم ما كانوا يفترون} [الانعام: ] ، قال: ما كانوا يكذبون في الدنيا "
 
  والوجه الثاني
 
 حدثنا محمد بن يحيي، انبا العباس النرسي، ثنا يزيد، ثنا سعيد، عن قتادة، " {ما كانوا يفترون} [الاعراف: ] : اي يشركون "
 
  قوله تعالي: {ان ربكم الله الذي خلق السموات والارض}
 
 حدثنا ابو يونس، محمد بن احمد بن يزيد بن عبد الله بن يزيد الجمحي بمكة، ثنا ابراهيم بن حمزة، عن عبد العزيز بن محمد، عن سعد بن اسحاق بن كعب بن عجرة، انه قال: نزلت هذه الاية: " {ان ربكم الله الذي خلق السموات والارض في ستة ايام} لقي ركب عظيم لا يرون الا انهم من العرب، فقال لهم: من انتم؟ قالوا: من الجن خرجنا من المدينة اخرجتنا هذه الاية "
 
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، ثنا ابن اسحاق، قال: «ابتدع السماوات والارض، ولم يكونا الا بقدرته، ولم يستعن علي ذلك باحد من خلقه، ولم يشركه في شء من امر سلطانه القاهر، وقوله النافذ الذي يقول له لما اراد ان يكون كن فيكون، ففرغ من خلق السماوات والارض في ستة ايام»
 
 اخبرنا محمد بن حماد الطهراني، فيما كتب الي، انبا اسماعيل بن عبد الكريم، اخبرني عبد الصمد بن معقل، انه سمع وهب بن منبه، يقول: " قال عزير: يا رب امرت الماء فجمد علي وسط الهواء فجعلت منه سبعا وسميتها السماوات، ثم امرت الماء ينفتق من التراب، ثم امرت التراب ان يتميز من الماء فكان كذلك فسميت جميع ذلك الارضين وجميع الماء البحار "
 
  قوله تعالي: {في ستة ايام} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {خلق السموات والارض في ستة ايام} ، قال: يوم مقداره الف سنة "
 
  قوله تعالي: {ثم استوي علي العرش} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، عن ابن ابي عروبة، عن قتادة، في قول الله تعالي: " {ثم استوي علي العرش} [الاعراف: ] ، قال: اليوم السابع "
 
 حدثنا يزيد بن سنان البصري، نزيل مصر، ثنا يزيد بن ابي حكيم، حدثني الحكم بن ابان، قال: سمعت عكرمة، يقول: «ان الله بدا خلق السماوات والارض وما بينهما يوم الاحد، ثم استوي علي العرش يوم الجمعة في ثلاث ساعات، فخلق في ساعة منها الشموس كي يرغب الناس الي ربهم في الدعاء والمسالة، وخلق في ساعة النتن الذين يقع علي ابن ادم اذا مات لكي يقبر»
 
  قوله تعالي: {علي العرش} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر، عن ابي روق، عن الضحاك، عن ابن عباس، «وانما سمي العرش عرشا لارتفاعه»
 
 حدثنا حجاج بن حمزة، ثنا ابو اسامة، ثنا اسماعيل بن ابي خالد، قال: سمعت سعدا الطاءي، يقول: «العرش ياقوتة حمراء»
 
 قرء علي بحر بن نصر الخولاني المصري، ثنا اسد بن موسي، ثنا يوسف بن زياد، عن ابو الياس ابن ابنة وهب بن منبه، عن وهب بن منبه، قال: «ان الله خلق العرش من نوره»
 
  قوله تعالي: {يغشي الليل النهار} 
 [الاعراف: ]
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {يغشي الليل النهار} [الاعراف: ] ، قال: يغشي الليل فيذهب بضوءه "
 
  قوله تعالي: {يطلبه حثيثا} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {يطلبه حثيثا} [الاعراف: ] ، يقول: سريعا " وروي عن السدي مثل ذلك
 
  قوله تعالي: {والشمس والقمر والنجوم مسخرات بامره} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا عبد الرحمن بن ابراهيم، ثنا الوليد بن مسلم، عن الاوزاعي، عن حسان بن عطية، قال: «الشمس والقمر والنجوم مسخرات في فلك من السماء والارض»
 
  قوله تعالي: {الا له الخلق والامر} 
 [الاعراف: ]
 
 حدثنا علي بن الحسين، ثنا محمد بن العلاء، ثنا عثمان بن سعيد، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قال: " يوم القيامة يدينهم باعمالهم الا من عفا عنه فالامر امره، ثم قال: {الا له الخلق والامر} [الاعراف: ] "
 
 حدثنا علي بن الحسن الهسنجاني، ثنا يزيد بن خالد الرملي، ثنا اسماعيل بن علية، قال: سمعت رجاء بن ابي سلمة، قال: سمعت يزيد بن عبد الله بن موهب، يقول: سمعت ابا خالد يعني عبد الله بن موهب، قال: قال ابو هريرة رضي الله عنه: «الخلق خلق الله والامر امره»
 
 حدثنا احمد بن اصرم المزني، ثنا يعقوب بن دينار، ثنا بشار بن موسي، قال: كنا عند سفيان بن عيينة، فقال سفيان: " {الا له الخلق والامر} [الاعراف: ] ، فالخلق هو الخلق والامر هو الكلام "
 
 حدثنا ابي، ثنا عمران بن موسي الطرسوسي، ثنا ابو زرعة الخراساني، قال: سمعت سفيان بن عيينة، يقول في قول الله: " {الا له الخلق والامر} [الاعراف: ] ، قال: الخلق ما دون العرش، والامر ما فوق ذلك "
 
  قوله تعالي: {تبارك الله} 
 [الاعراف: ]
 
 حدثنا علي بن الحسين، ثنا محمد بن العلاء، ثنا عثمان بن سعيد الزيات، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، " {تبارك} [الاعراف: ] تفاعل. من البركة "
 
  قوله تعالي: {رب العالمين} 
 [الفاتحة: ]
 
 حدثنا علي بن حرب الموصلي، ثنا زيد بن الحباب، عن حسين بن واقد، عن مطر الوراق، عن قتادة، في قول الله: " {رب العالمين} [الاعراف: ] ، قال: ما وصف من خلقه "
 
  قوله تعالي: {ادعوا ربكم} 
 [الاعراف: ]
 
 حدثنا ابو سعيد الاشج، ثنا ابن ادريس، وابن نمير، ووكيع، وعقبة، عن الاعمش، عن ذر، عن يسيع بن السميط، عن النعمان بن بشير، قال: قال رسول الله صلي الله عليه وسلم: «الدعاء هو العبادة»
 
 اخبرنا موسي بن هارون الطوسي، فيما كتب الي، ثنا الحسين بن محمد، ثنا شيبان، عن قتادة، قوله: " {ان ربكم الله الذي خلق السموات والارض} الي اخر الاية، قال: لما انباكم الله بقدرته وعظمته وجلاله بين لكم كيف تدعونه علي تفءة ذلك، فقال: {ادعوا ربكم تضرعا وخفية انه لا يحب المعتدين} [الاعراف: ] "
 
  قوله تعالي: {تضرعا وخفية} 
 [الانعام: ]
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، قوله: " {ادعوا ربكم تضرعا} [الاعراف: ] ، يعني: مستكينا "
 
  قوله تعالي: {وخفية} 
 [الانعام: ]
 
 وبه عن سعيد، قوله: " {وخفية} [الاعراف: ] يعني في خفض وسكون في حاجاتكم من امر الدنيا والاخرة "
 
 حدثنا ابي، ثنا عبد العزيز بن عبد الله الاويسي، ثنا ابن ابي الرجال، عن زيد بن اسلم، انه قال: في قول الله: {ادعوا ربكم تضرعا وخفية} [الاعراف: ] ، قال زيد: عني بذلك القراءة "
 
  قوله تعالي: {انه لا يحب المعتدين} 
 [الاعراف: ]
 
 حدثنا محمد بن عوف الطاءي الحمصي، ثنا ادم، ثنا شعبة، ثنا زياد بن مخراق البصري، قال: سمعت قيس بن عباية يحدث عن مولي لسعد بن مالك، ان ابنا لسعد بن مالك، دعا فذكر الجنة، فقال: اللهم اني اسالك نعيمها، وازواجها، وثمارها، ونحوها، وذكر النار، قال: اللهم اني اعوذ بك من سلاسلها، واغلالها وسعيرها ونحو هذا. فقال له سعد بن مالك: لقد سالت نعيما طويلا، وتعوذت من شر عظيم، واني سمعت رسول الله صلي الله عليه وسلم يقول: «سيكون بعدي قوم يعتدون في الدعاء» ، وتلا هذه الاية: {ادعوا ربكم تضرعا وخفية انه لا يحب المعتدين} [الاعراف: ] ، ثم قال: " بحسبك ان تقول: اللهم اني اسالك الجنة وما قرب اليها من قول وعمل، واعوذ بك من النار وما قرب اليها من قول وعمل "
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، " {انه لا يحب المعتدين} [الاعراف: ] ، يقول: لا تدعوا علي المءمن والمءمنة بالشر اللهم اخزه والعنه ونحو ذلك. فان ذلك عدوان "
 
 حدثنا ابي، ثنا عبدة، عن المعتمر، عن اسماعيل بن حماد بن ابي سليمان، عن عباد بن عباد بن علقمة، عن ابي مجلز، " {انه لا يحب المعتدين} [الاعراف: ] ، قال: لا تسالوا منازل الانبياء "
 
 وحدثنا ابي، ثنا ابو الجماهر، وسليمان ابن بنت شرحبيل، والحكم بن موسي، قالوا: ثنا عبد الرحمن بن ابي الرجال، عن زيد بن اسلم، في قول الله تعالي: " {ادعوا ربكم تضرعا وخفية انه لا يحب المعتدين} [الاعراف: ] ، قال: كان يري ان الجهر بالدعاء الاعتداء "
 
 اخبرنا العباس بن الوليد بن مزيد البيروتي، قراءة، انبا محمد بن شعيب بن شابور، اخبرني عثمان بن عطاء، عن ابيه، " {انه لا يحب المعتدين} [الاعراف: ] ، قال: لا يحب الاعتداء في الدعاء ولا في غيره "
 
  قوله تعالي: {ولا تفسدوا في الارض} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا اسد بن زيد، ثنا عمرو، قال: ابو محمد هو ابن شمر، عن السدي، عن ابي صالح، " {ولا تفسدوا في الارض بعد اصلاحها} [الاعراف: ] ، قال: بعدما اصلحتها الانبياء واصحابهم "
 
 حدثنا ابي، ثنا عمران بن موسي الطرسوسي، ثنا سنيد، قال: قيل لابي بكر بن عياش: ما قوله في كتابه؟ " {ولا تفسدوا في الارض بعد اصلاحها} [الاعراف: ] ، فقال ابو بكر: ان الله بعث محمدا صلي الله عليه وسلم الي اهل الارض، وهم في فساد فاصلحهم الله بمحمد صلي الله عليه وسلم، فمن دعا الي خلاف ما جاء به محمد فهو من المفسدين في الارض "
 
  قوله تعالي: {وادعوه خوفا} 
 [الاعراف: ]
 
 حدثنا ابو سعيد الاشج، ثنا ابو عبد الرحمن الحارثي، عن جويبر، عن الضحاك، " {خوفا وطمعا} [الاعراف: ] ، قال: الخوف الصواعق "
 
  قوله تعالي: {وطمعا} 
 [الاعراف: ]
 
 وبه، عن الضحاك، " {خوفا وطمعا} [الاعراف: ] ، الطمع الغيث "
 
  قوله تعالي: {ان رحمة الله قريب من المحسنين}
 
 حدثنا ابي، ثنا عبد الله بن ابي زياد، ثنا سيار، ثنا جعفر، قال: سمعت مطر الوراق، يقول: «تنجزوا موعود الله بطاعة الله، فانه قضي ان رحمته قريب من المحسنين»
 
  قوله تعالي: {وهو الذي يرسل الرياح} 
 [الاعراف: ]
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {وهو الذي يرسل الرياح بشرا} [الاعراف: ] ، قال: ان الله يرسل الرياح فتاتي بالسحاب من بين الخافقين طرف السماء والارض من حيث يلتقيان، فيخرجه من ثم، ثم ينشره فيبسطه في السماء كيف يشاء، ثم يفتح ابواب السماء ليسيل الماء علي السحاب، ثم يمطر السحاب بعد ذلك "
 
 اخبرنا ابو عبد الله الطهراني، فيما كتب الي، ثنا اسماعيل بن عبد الكريم، حدثني اسحاق بن محمد المسيبي، عن نافع بن عبد الرحمن بن ابي نعيم، عن جماعة، من التابعين، عن ابن كعب، رضي الله عنه، قال: «كل شء في القران من الرياح فهي رحمة، وكل شء في القران من الريح فهو عذاب»
 
  قوله تعالي: {بشرا بين يدي رحمته} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {وهو الذي يرسل الرياح بشرا بين يدي رحمته} [الاعراف: ] ، قال: فيستبشر بها الناس "
 
 ذكر عبيد الله بن اسماعيل، ثنا خلف، ثنا الخفاف، عن اسماعيل، قال: كان عبد الله اليمامي، يقرءها «بشر من قبل مبشرات»
 
  قوله تعالي: {بين يدي رحمته} 
 [الاعراف: ]
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {بين يدي رحمته} [الاعراف: ] ، واما رحمته فهو المطر "
 
  قوله تعالي: {حتي اذا اقلت سحابا ثقالا سقناه} [الاعراف: ] الاية
 
 حدثنا ابي، ثنا سليمان بن حرب، ثنا حماد بن يزيد، عن عبد الجليل، عن شهر بن حوشب، ان ابا هريرة، رضي الله عنه، قال: «ما نزل مطر الا بميزان»
 
 حدثنا ابي، ثنا محمود بن غيلان، ثنا علي بن الحسن بن شقيق، ثنا الحسين بن واقد، ثنا علباء بن احمر، عن عكرمة، قال: " ينزل الله الماء من السماء السابعة، فتقع القطرة منه علي السحابة مثل: البعير "
 
  قوله تعالي: {فاخرجنا به من كل الثمرات} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو الاشعث، ثنا معتمر، قال: سمعت ابي، عن سيار، عن خالد بن يزيد، قال: كنا عند عبد الملك بن مروان فذكروا الماء، فقال خالد بن يزيد: «منه من السماء، ومنه مما يسقيه الغيم من البحر فيعذبه الرعد والبرق، واما ما كان من البحر فلا يكون له نبات، واما النبات فمما كان من السماء»
 
  قوله تعالي: {كذلك نخرج الموتي لعلكم تذكرون} 
 [الاعراف: ]
 
 حدثنا حجاج بن حمزة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {كذلك نخرج الموتي} [الاعراف: ] ، نمطر السماء حتي تشقق عنهم الارض "
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، كتابة، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {كذلك نخرج الموتي لعلكم تذكرون} [الاعراف: ] ، وكذلك تخرجون، وكذلك النشور كما يخرج الزرع بالماء "
 
  قوله تعالي: {والبلد الطيب يخرج نباته باذن ربه} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {والبلد الطيب يخرج نباته باذن ربه} [الاعراف: ] ، فهذا مثل ضربه الله للمءمنين، يقول: هو طيب وعمله طيب، كما ان البلد الطيب ثمرها طيب "
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {والبلد الطيب} [الاعراف: ] والذي خبث كل ذلك من الارض السباخ وغيرها مثل: ادم وذريته كلهم منهم الخبيث ومنهم الطيب "
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {والبلد الطيب يخرج نباته باذن ربه} [الاعراف: ] ، فذلك مثل ضربه الله يقولون: ينزل الماء، فيخرج البلد الطيب نباته باذن الله، فكذلك القلوب لما نزل القران فالقلب المءمن امن به وثبت الايمان في قلبه، وقلب الكافر لما دخله الايمان لم يتعلق منه شء ينفعه، ولم يثبت فيه من الايمان شء الا ما لا ينفع، كما لم يخرج هذا البلد الا ما لم ينفع من النبات "
 
  قوله تعالي: {باذن ربه} 
 [الاعراف: ]
 
 حدثنا علي بن الحسين، ثنا محمد بن العلاء، ثنا عثمان بن سعيد، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، " {باذن الله} [البقرة: ] ، يقول: بامر الله "
 
  قوله تعالي: {والذي خبث لا يخرج الا نكدا} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله تعالي: " {والذي خبث لا يخرج الا نكدا} [الاعراف: ] ، يقول: ضرب مثلا للكافر كالبلد السبخة المالحة التي لا يخرج منه البركة، والكافر هو الخبيث وعمله خبيث "
 
  قوله تعالي: {الا نكدا} 
 [الاعراف: ]
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، " {لا يخرج الا نكدا} [الاعراف: ] والنكد مفضل "
 
 ثنا اسباط، عن السدي " {لا يخرج الا نكدا} [الاعراف: ] والنكد الشء القليل الذي لا ينفع "
 
  قوله تعالي: {كذلك نصرف الايات لقوم يشكرون} 
 [الاعراف: ]
 
 قرء علي يونس بن عبد الاعلي، انبا ابن وهب، اخبرني حيوة بن شريح، عن زهرة بن معبد القرشي، انه سمع ابا عبد الرحمن الحبلي، يقول: «الصلاة شكر، والصيام شكر، وكل خير تفعله لله شكر، وافضل الشكر الحمد»
 
  قوله تعالي: {لقد ارسلنا نوحا الي قومه} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا ابراهيم بن الفضل بن ابي سويد، ثنا ابو عوانة، عن قتادة، عن انس، ان النبي صلي الله عليه وسلم، قال: «اول نبي ارسل نوح صلي الله عليه وسلم»
 
 واخبرنا يونس بن عبد الاعلي، قراءة، انبا ابن وهب، اخبرني مسلمة بن علي، عن سعيد بن بشير، عن قتادة: «ان نوحا، بعث من الجزيرة»
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة بن الفضل، حدثني محمد بن اسحاق، قال: «كان من حديث نوح، وحديث قومه فيما قص الله علي لسان نبيه صلي الله عليه وسلم، وما يذكر اهل الكتاب من اهل التوراة، وما حفظ من الاحاديث، عن عبد الله بن عباس، وعن عبيد بن عمير» ان الله بعث نوحا االي قومه فلبث فيهم الف سنة الا خمسين عاما يدعوهم الي الله، وقد فشت في الارض المعاصي، وكثرت فيها الجبابرة، وعتوا علي الله عتوا كبيرا، وكان
  [ص: ]
 نوح فيما يذكر اهل العلم حليما صبورا، لم يلق نبي من قومه من البلايا اكثر مما لقي الا نبي قتل "
 
 حدثنا ابو سعيد الاشج، ثنا عبيد الله، عن اسراءيل، عن السدي، عن ابي صالح، قال: «ارسل. بعث»
 
 حدثنا ابو زرعة، ثنا عبد الله بن عمر القرشي، ثنا عباد بن كليب ابو غسان الليثي، ثنا مسلم ابو عبد الله العباداني، عن يزيد الرقاشي، قال: «انما سمي نوح لطول ما ناح علي نفسه»
 
  قوله تعالي: {قال يا قوم اعبدوا الله ما لكم من اله غيره} 
 [الاعراف: ]
 
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس، قوله: " {اعبدوا} [نوح: ] اي وحدوا "
 
  قوله تعالي: {اني اخاف عليكم عذاب يوم عظيم} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {عذاب} [الاعراف: ] ، يقول: نكال "
 
  قوله تعالي: {قال الملا من قومه انا لنراك} 
 [الاعراف: ]
 
 حدثنا ابو بكر بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك، قوله: " {قال الملا} [الاعراف: ] ، يعني الاشراف من قومه "
 
  قوله تعالي: {قال يا قوم ليس بي ضلالة} 
 [الاعراف: ]
 
 حدثني محمد بن العباس، مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة بن الفضل، حدثني محمد بن اسحاق، عن من لا يتهم، عن عبيد بن عمير الليثي، انه كان يحدث انه بلغه " انهم كانوا يبطشون به يعني نوحا فيخنقونه حتي يغشي عليه، فاذا افاق قال: اللهم اغفر لقومي فانهم لا يعلمون حتي اذا تمادوا في المعصية، وعظمت فيهم في الارض الخطيءة، وتطاول عليه وعليهم الشان، واشتد عليه منهم
  [ص: ]
 البلاء، وانتظر الجيل بعد الجيل، فلا ياتي قرن الا كان اخبث من الذي، كان قبله حتي كان الاخر منهم ليقول: قد كان هذا مع اباءنا ومع اجدادنا، هكذا مجنونا لا يقبلون منه شيءا حتي شكا ذلك من امرهم نوح عليه الصلاة والسلام الي الله عز وجل، وقال: كما قص الله علينا في كتابه "
 
 اخبرنا يونس بن عبد الاعلي، قراءة، انبا ابن وهب، ثنا ابن زيد يعني عبد الرحمن، قال: «ما عذب قوم نوح حق ما كان في الارض سهل، ولا جبل الا له عامر يعمره وحايز يحوزه»
 
 اخبرنا يونس بن عبد الاعلي، قراءة، انبا ابن وهب، حدثني مالك، عن زيد بن اسلم، " ان اهل السهل، كان قد ضاق بهم، واهل الجبل حتي ما يقدر اهل السهل ان يرتقوا الي الجبل ولا اهل الجبل ان ينزلوا الي اهل السهل في زمان نوح، قال: حشوا "
 
  قوله تعالي: {ابلغكم رسالات ربي} 
 [الاعراف: ]
 
 حدثني محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا ابن الفضل، حدثني محمد بن اسحاق، قال: " كان من حديث نوح وحديث قومه مما يذكر اهل العلم انه كان حليما صبورا لم يلق نبي من قومه من البلايا اكثر مما لقي الا نبي قتل، وكان يدعوهم، كما قال الله: ليلا ونهارا، سرا وجهارا بالنصيحة لهم، فلم يزدهم ذلك منه الا فرارا، حتي انه ليكلم الرجل منهم فيلف راسه بثوبه، ويجعل اصابعه في اذنيه لءلا يسمع شيءا من قوله "
 
  قوله تعالي: {ولعلكم ترحمون} 
 [الاعراف: ]
 
 اخبرنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، في قوله: " {ولعلكم ترحمون} [الاعراف: ] ، لكي ترحمون فلا تعذبون "
 
  قوله تعالي: {فكذبوه فانجيناه والذين معه في الفلك} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا المءمل بن اهاب، ثنا زيد بن حباب، ثنا الحسين بن واقد، عن ابي نهيك، عن ابن عباس، قال: «كان مع نوح في السفينة ثمانون رجلا احدهم جرهم»
 
 اخبرنا يونس بن عبد الاعلي، انبا ابن وهب، قال: بلغني عن ابن عباس
  [ص: ]
 ، انه قال: «كان في سفينة نوح ثمانون رجلا احدهم جرهم وكان لسانه عربيا»
 
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، قال: فحدثني محمد بن اسحاق، عن الحسن بن دينار، عن علي بن يزيد بن جدعان، عن يوسف بن مهران، عن عبد الله بن العباس، قال: سمعته يقول: " اول ما حمل نوح في السفينة من الدواب الذرة، واخر ما حمل الحمار، فلما دخل الحمار، دخل صدره فتعلق ابليس بذنبه، فلا تستعل رجلاه، فجعل نوح يقول: ويحك ادخل ينهض، فلا يستطيع، حتي قال نوح: ويحك ادخل وان كان الشيطان معك، قال: كلمة زلت علي لسانه "
 
  قوله تعالي: {واغرقنا الذين كذبوا باياتنا} 
 [الاعراف: ]
 
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا ابو زهير، عن رجل، من اصحابه، قال: «بلغني ان قوم نوح عاشوا في ذلك الغرق اربعين يوما»
 
 حدثني محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، قال: حدثني محمد بن اسحاق، قال: «فلقد غرقت الارض وما فيها، وانتهي الماء الي ما انتهي اليه، وما جاوز الماء ركبته، وداب الماء حين ارسله خمسين وماءة كما يزعم اهل التوراة فكان بين ان ارسل الله الطوفان، وبين ان غاض الماء ستة اشهر وعشر ليال، ولما اراد الله ان يكف ذلك ارسل الله ريحا علي وجه الماء فسكن الماء، واشتدت ينابيع الارض الغمر الاكبر، وابواب السماء، فجعل الماء ينقص ويغيض ويدبر فكان استواء الفلك علي الجودي فيما يزعم اهل التوراة في الشهر السابع لسبع عشرة ليلة مضت منه، وفي اول يوم من الشهر العاشر راي رءوس الجبال، فلما مضي بعد ذلك اربعون يوما فتح نوح عليه الصلاة والسلام كوة الفلك التي صنع فيها، ثم ارسل الغراب لينظر له ما فعل الماء، فلم يرجع اليه، فارسل الحمامة فرجعت اليه، فلم يحج لرجلها موضعا فبسط يده للحمامة فاخذها فادخلها، فمكث سبعة ايام ثم ارسلها لتنظر له فرجعت اليه حين امست وفي فمها ورقة زيتونة، فعلم نوح ان الماء قد قل، عن وجه الارض، ثم مكث سبعة ايام ثم ارسلها، فلم ترجع اليه، فعلم نوح ان الارض قد برزت»
 
  قوله تعالي: {انهم كانوا قوما عمين} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {انهم كانوا قوما عمين} [الاعراف: ] ، قال: كفارا "
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: " {انهم كانوا قوما عمين} [الاعراف: ] ، قال: عن الحق "
 
 اخبرنا العباس بن الوليد بن مزيد، اخبرني محمد بن شعيب بن شابور، اخبرنا عثمان بن عطاء، عن ابيه عطاء، " {انهم كانوا قوما عمين} [الاعراف: ] فعماة، عن الخير "
 
 حدثنا علي بن الحسين، ثنا المقدسي، ثنا حسين بن نمير، ثنا سفيان بن حسين، " {انهم كانوا قوما عمين} [الاعراف: ] ، قال: اعموا، عن ذلك الشء ليسوا عمي، انما هم عموا عنه "
 
  قوله تعالي: {والي عاد اخاهم هودا} 
 [الاعراف: ]
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا ابن مفضل، ثنا اسباط، عن السدي، قوله: " {والي عاد اخاهم هودا} [الاعراف: ] ان عادا كانوا باليمن بالاحقاف، والاحقاف هي الرمال، فاتاهم فوعظهم، وذكرهم بما قص الله في القران، فكذبوه وكفروا، وسالوه ان ياتيهم بالعذاب "
 
  قوله تعالي: {يا قوم اعبدوا الله} 
 [الاعراف: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة، حدثني محمد بن اسحاق، قال: «وكان من حديث عاد فيما بلغني والله اعلم، انهم كانوا قوما عربا، فبعث الله اليهم هود، وهو من اوسطهم نسبا، وافضلهم موضعا، فامرهم ان يوحدوا الله عز وجل»
 
  قوله تعالي: {ما لكم من اله غيره} 
 [الاعراف: ]
 
 وبه حدثنا محمد بن اسحاق، قال: " وكان من حديث عاد فيما بلغني والله اعلم انهم كانوا قوما عربا، وكانوا اصحاب اوثان يعبدونها من دون الله، صنم يقال له: صداء، واخر يقال له: صمود، وصنم يقال له: الهباء، فبعث الله عز وجل لهم هودا فامرهم ان يوحدوا الله، ولا يجعلوا معه الها غيره، وان يكفوا، عن ظلم الناس، ولم يامرهم فيما يذكرون والله اعلم بغير ذلك "
 
  قوله تعالي: {قال الملا الذين كفروا} 
 [الاعراف: ]
 
 وبه حدثني محمد بن اسحاق، قال: " وكان من حديث عاد ان الله بعث اليهم هود فامرهم ان يوحدوا الله، ولا يجعلوا معه الها غيره، وان يكفوا، عن ظلم الناس، لم يامرهم فيما يذكر، والله اعلم بغير ذلك، فابوا عليه وكذبوه، وقالوا: من اشد منا قوة، واتبعه منهم اناس، وهم يسير مكتتمون بايمانهم، فكان ممن امن به وصدقه رجل من عاد يقال له مزيد بن مسعد بن عفير، وكان يكتم ايمانه "
 
  قوله تعالي: {رسول من رب العالمين} 
 [الاعراف: ]
 
 حدثنا كثير بن شهاب، ثنا محمد بن سعيد بن سابق، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية، في قوله: " {رب العالمين} [الاعراف: ] ، قال: الجن عالم، والانس عالم وسوي ذلك ثمانية عشر الف عالم من الملاءكة، وعلي الارض في كل زاوية منها اربعة الاف وخمسماءة عالم خلقهم لعبادته تبارك وتعالي "
 
  قوله تعالي: {ابلغكم رسالات ربي وانا لكم ناصح امين} 
 [الاعراف: ]
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قال: " فاتاهم يعني هود فوعظهم وذكرهم بما قص الله في كتابه فكذبوه وكفروا، وسالوه ان ياتيهم بالعذاب، فقال لهم: {انما العلم عند الله وابلغكم ما ارسلت به} [الاحقاف: ] "
 
  قوله تعالي: {اوعجبتم ان جاءكم ذكر من ربكم علي رجل منكم لينذركم} 
 [الاعراف: ]
 
 وبه، عن السدي يعني قوله: " {لينذركم} [الاعراف: ] ، قال: فاتاهم يعني هودا فوعظهم وذكرهم "
 
  قوله تعالي: {واذكروا اذ جعلكم خلفاء من بعد قوم نوح} 
 [الاعراف: ]
 
 وبه، عن السدي، قوله: " {واذكروا اذ جعلكم خلفاء من بعد قوم نوح} [الاعراف: ] ، اما خلفاء فذهب بقوم نوح واستخلفكم بعدهم "
 
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، " {واذكروا اذ جعلكم خلفاء من بعد قوم نوح} [الاعراف: ] الي ساكن الارض من بعد قوم نوح "
 
  قوله تعالي: {وزادكم في الخلق بسطة} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {وزادكم في الخلق بسطة} [الاعراف: ] ، قال: شدة "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قوله: " وزادكم في الخلق بسطة، قال: في القوة قوة عاد "
 
  الوجه الثاني
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {وزادكم في الخلق بسطة} [الاعراف: ] في الطول "
 
  قوله تعالي: {فاذكروا الاء الله} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {فاذكروا الاء الله} [الاعراف: ] ، يقول: اذكروا نعم الله عليكم من الالاء " وروي، عن مجاهد، وقتادة، والسدي، وعبد الرحمن بن زيد بن اسلم نحو ذلك
 
  قوله تعالي: {لعلكم تفلحون} 
 [البقرة: ]
 
 حدثنا يونس بن عبد الاعلي، انبا ابن وهب، انبا ابو صخر المدني، عن محمد بن كعب القرظي، انه كان يقول في هذه الاية، " {لعلكم تفلحون} [الاعراف: ] ، يقول: لعلكم تفلحون غدا اذا لقيتموني "
 
  قوله تعالي: {اجءتنا لنعبد الله وحده ونذر ما كان يعبد اباءنا} [الاعراف: ] الي {الصادقين} 
 [الماءدة: ]
 
 اخبرنا موسي بن هارون الطوسي، فيما كتب الي، ثنا الحسين بن محمد المروذي
  [ص: ]
 ، ثنا شيبان، عن قتادة، في قوله: " {من الصادقين} [الاعراف: ] ، قال: الصدق في النية، والصدق في العمل، والصدق في الليل والنهار، والصدق في السر والعلانية "
 
  قوله تعالي: {قد وقع عليكم من ربكم رجس وغضب} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {قد وقع عليكم من ربكم رجس} [الاعراف: ] ، يقول: سخط "
 
 اخبرنا ابو يزيد، فيما كتب الي، ثنا اصبغ، قال: سمعت ابن زيد، يقول: في قوله: " {قد وقع عليكم من ربكم رجس وغضب} [الاعراف: ] ، قال: جاءهم منه عذاب وغضب، قال: سمي الرجس هاهنا عذاب، وقال: الرجس كله، عذاب في القران "
 
  قوله تعالي: {فانجيناه والذين معه} 
 [الاعراف: ]
 
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، قال: «واعتزل هو فيما ذكر لي ومن معه من المءمنين في حظيرة ما يصيبه ومن معه الا ما تلين عليه الجلود، وتلتذ الانفس، وانها تمر من عاد بالظعن ما بين السماء والارض وندمغهم بالحجارة»
 
  قوله تعالي: {وقطعنا دابر الذين كذبوا باياتنا} 
 [الاعراف: ]
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، قال: سمعت ابن زيد، يقول في قول الله: " {وقطعنا دابر الذين كذبوا باياتنا} [الاعراف: ] ، قال: استاصلناهم "
 
  قوله تعالي: {والي ثمود اخاهم صالحا، قال يا قوم اعبدوا الله} 
 [الاعراف: ]
 
 حدثنا محمد بن عمار، ثنا سهل بن بكار، ثنا داود بن ابي الفرات، عن علباء بن احمر، عن عكرمة، عن ابن عباس: " ان صالحا النبي، صلي الله عليه وسلم بعثه الله الي قومه فامنوا به، ثم انه مات فرجعوا بعده، عن الاسلام، فاحيا الله صالحا وبعثه اليهم فاخبرهم انه صالح فكذبوه وقالوا: قد مات صالح فاتنا باية فاتاهم الله بالناقة فكفروا به وعقروها فاهلكهم الله "
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {والي ثمود اخاهم صالحا} [الاعراف: ] ، قال: ان الله بعث صالحا الي ثمود فدعاهم فكذبوا، فقال لهم: ما ذكر الله في القران "
 
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: «فلما اهلك الله عادا، وانقضي امرها عمرت ثمود بعدها فاستخلفوا في الارض، فربلوا فيها وانتشروا، ثم عتوا علي الله، فلما ظهر فسادهم، وعبدوا غير الله، بعث الله اليهم صالحا، وكانوا قوما عربا، وهو من اوسطهم نسبا وافضلهم موضعا رسولا. وكانت منازلهم الحجر الي قزح وهو وادي القري وبين ذلك ثمانية عشر ميلا فيما بين الحجاز والشام، فبعث الله اليهم غلاما شابا فدعاهم الي الله حتي شمط وكبر لا يتبعه منهم احد الا قليل مستضعفون»
 
  قوله تعالي: {قد جاءتكم بينة من ربكم هذه ناقة الله لكم اية} 
 [الاعراف: ]
 
 اخبرنا محمد بن حماد الطهراني، فيما كتب الي، انبا عبد الرزاق، انبا اسراءيل، عن عبد العزيز بن رفيع، عن ابي الطفيل، قال: " قالت ثمود لصالح: اءتنا باية ان كنت من الصادقين، قال: فقال لهم صالح:، اخرجوا الي هضبة من الارض فخرجوا، فاذا تمخض كما تمخض الحامل، ثم انها تفرجت فخرجت من وسطها الناقة، فقال لهم صالح: {هذه ناقة الله لكم اية فذروها تاكل في ارض الله} [الاعراف: ] الي قوله: {عذاب اليم} [الاعراف: ] ، {لها شرب ولكم شرب يوم معلوم} [الشعراء: ] "
 
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، قال: حدثني محمد بن اسحاق، عن يعقوب بن عتبة بن المغيرة، انه حدث «انهم نظروا الي الهضبة، حين دعا الله صالحا، بما دعا به تمخض بالناقة تمخض النتوج بولدها فتحركت الهضبة، ثم انتفضت فانصدغت، عن ناقة كما وصفوا جوفاء وبراء، نتوجا ما بين جنبيها لا يعلمه الا الله عظما»
 
  قوله تعالي: {فذروها تاكل في ارض الله ولا تمسوها بسوء} 
 [الاعراف: ]
 
 اخبرنا احمد بن عثمان، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، " {فذروها تاكل في ارض الله} [الاعراف: ] ، قال: فسالوا يعني صالحا ان ياتيهم باية
  [ص: ]
 فجاءهم بالناقة، {لها شرب ولكم شرب يوم معلوم} [الشعراء: ] ، وقال: {فذروها تاكل في ارض الله ولا تمسوها بسوء} [الاعراف: ] ، فاقروا بها جميعا فذلك قوله: {فهديناهم فاستحبوا العمي علي الهدي} [فصلت: ] ، فكانوا قد اقروا به علي وجه النفاق "
 
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، قال: " فمكثت الناقة التي اخرج الله لهم معها سبقها في ارض ثمود ترعي الشجر، وتشرب الماء، فقال لهم صالح: {هذه ناقة الله لكم اية فذروها تاكل في ارض الله ولا تمسوها بسوء فياخذكم عذاب اليم} [الاعراف: ] "
 
  قوله تعالي: {عذاب اليم} 
 [البقرة: ]
 
 حدثنا عصام بن رواد العسقلاني، ثنا ادم، ثنا ابو جعفر، عن الربيع بن انس، عن ابي العالية، في قوله: " {عذاب اليم} [الاعراف: ] ، قال: الاليم الموجع في القران كله " وكذلك فسره ابن عباس، وسعيد بن جبير، والضحاك بن مزاحم، وقتادة، وابو مالك، وابو عمران الجوني، ومقاتل بن حيان
 
  قوله تعالي: {واذكروا اذ جعلكم خلفاء من بعد عاد وبواكم في الارض تتخذون من سهولها قصورا وتنحتون الجبال بيوتا} 
 [الاعراف: ]
 
 حدثنا علي بن الحسين، ثنا ابو بكر بن ابي شيبة، وعمرو بن علي، قالا: ثنا وكيع، عن اسماعيل، عن ابي صالح، " {وتنحتون الجبال بيوتا} [الاعراف: ] ، قال: حاذقين بنحتها "
 
 اخبرنا احمد بن عثمان، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {وتنحتون الجبال بيوتا} [الاعراف: ] كانوا ينقبون في الجبال البيوت "
 
  قوله تعالي: {ولا تعثوا في الارض مفسدين} 
 [البقرة: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: " {ولا تعثوا في الارض مفسدين} [الاعراف: ] ، يقول: لا تعثوا في الارض "
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، عن سعيد، عن قتادة، قوله: " {ولا تعثوا في الارض} [البقرة: ] ، يقول: ولا تسيروا في الارض مفسدين "
 
 حدثنا ابو بكر بن ابي موسي الانصاري، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، ثنا اسباط، عن السدي، عن ابي مالك، قوله: " {ولا تعثوا في الارض مفسدين} [البقرة: ] ، يعني لا تمشوا بالمعاصي "
 
  قوله تعالي: {قال الملا الذين استكبروا من قومه} 
 [الاعراف: ]
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا عبد الرحمن بن سلمة، قال: فحدثنا سلمة، قال: فحدثني محمد بن اسحاق، قال: «فامن به مخدع بن عمرو ومن كان معه علي ازد من رهطه واراد اشراف ثمود ان يءمنوا ويصدقوا فنهاهم دءاب بن عمرو بن لبيد، والحباب صاحب اوثانهم، ورباب بن ظمعن بن جلهس، وكان كاهنهم، وكانوا من اشراف ثمود، فردوا ثمود واشرافها، عن الاسلام والدخول فيما دعاهم اليه صالح من الرحمن والنجاة، وكان لجندع ابن عم له يقال له شهاب بن خليفة بن مخلاة بن الوليد بن جواس، فاراد ان يسلم فنهاه اولءك الرهط عن ذلك فاطاعهم، وكان من اشراف ثمود وافاضلها»
 
  قوله تعالي: {قال الذين استكبروا انا} 
 [الاعراف: ]
 
  بيان قوله: {فعقروا الناقة} 
 [الاعراف: ]
 
 حدثنا هارون بن اسحاق الهمداني، ثنا عبدة يعني ابن سليمان الكلابي، عن هشام بن عروة، عن ابيه، عن عبد الله بن زمعة، قال: " سمعت رسول الله صلي الله عليه وسلم يوما يذكر الناقة والذي عقرها، فقال: " {اذ انبعث اشقاها} [الشمس: ] انبعث لها رجل عارم عزيز منيع في رهطه مثل ابي زمعة "
 
 حدثنا ابي، ثنا هشام بن عمار، ثنا الوليد، ثنا خليد بن دعلج، عن قتادة، " ان ثمود، لما عقروا الناقة تغامزوا وقالوا: عليكم الفصيل، فصعد الفصيل القارة جبلا حتي اذا كان يوما استقبل القبلة، وقال: يا رب امي، يا رب امي يا رب امي، فارسلت عليهم الصيحة عند ذلك "
 
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، قال: " فانطلقوا فرصدوا الناقة حتي صدرت، عن الماء، وقد كمن لها قدار في اصل الصخرة علي طريقها، وكمن لها مصدع في اصل اخري
  [ص: ]
 ، فمرت علي مصدع فرماها بسهم فانتظم به عضلة ساقها، قال: فشد يعني قدار علي الناقة بالسيف فكشف عرقوبها فخرت ورغت رغاة واحدا تحذر سقبها، ثم طعن في لبتها فنحرها، وانطلق سقبها حتي اتي جبلا منيعا، ثم اتي صخرة في راس الجبل فرغا ثم لاذ بها، فاتاهم صالح: فلما راي الناقة قد عقرت بكي، ثم قال: انتهكتم حرمة الله. فابشروا بعذاب الله ونقمته "
 
 حدثنا ابي، ثنا عثمان بن ابي شيبة، ثنا يحيي بن يمان، عن سفيان الثوري، عن ابي سنان، عن عبد الله بن ابي الهذيل، قال: «لما عقرت الناقة صعد بكرها فوق الجبل فرغا فما سمعه شء الا همد»
 
  قوله تعالي: {وعتوا} 
 [الاعراف: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {وعتوا} [الاعراف: ] ، قال: غلوا "
 
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، " {وعتوا عن امر ربهم} [الاعراف: ] واجمعوا في عقر الناقة رايهم "
 
  قوله تعالي: {عن امر ربهم} 
 [الاعراف: ]
 
 حدثنا حجاج، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، " {عن امر ربهم} [الاعراف: ] ، قال: غلوا في الباطل "
 
  قوله تعالي: {يا صالح اءتنا بما تعدنا ان كنت من المرسلين} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي الصنعاني، ثنا محمد بن ثور، عن معمر، عن قتادة، " ان صالحا، قال: لهم حين عقروا الناقة، {تمتعوا في داركم ثلاثة ايام} [هود: ] ، قال لهم: ان اية هلاككم ان تصبح وجوهكم غدا مصفرة. ثم تصبح اليوم الثاني محمرة ثم تصبح اليوم الثالث مسودة. فاصبحت كذلك، فلما كان اليوم الثالث ايقنوا فتكفنوا وتحنطوا، ثم اخذتهم الصيحة فاهمدتهم "
 
  قوله تعالي: {فاخذتهم الرجفة} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي الصنعاني، ثنا محمد بن ثور، عن معمر، عن عبد الله بن عثمان بن خثيم، عن جابر، قال: " لما مر الني صلي الله عليه وسلم بالحجر، قال: لا تسالوا الايات فقد سالها قوم صالح، فكانت ترد من هذا الفج وتصدر من هذا الفج، فعتوا، عن امر ربهم، فعقروها، وكانت تشرب ماءهم يوما ويشربون لبنها يوما فعقروها فاخذتهم الصيحة، فهمد الله من تحت اديم السماء منهم الا رجلا واحدا كان في حرم الله. قالوا: من هو يا رسول الله؟ قال: ابو رغال، فلما خرج من الحرم اصابه ما اصاب قومه "
 حدثنا محمد بن عوف الحمصي، ثنا ابو اليمان، ثنا ابن عياش، عن عبد الله بن عثمان بن خثيم، عن ابي الزبير، عن جابر، قال: " لما نزلنا الحجر مغزي النبي صلي الله عليه وسلم، تبوكا قال لنا: ايها الناس لا تسالوا عن الايات " فذكره
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، في قوله: " {فاخذتهم الرجفة} [الاعراف: ] ، قال: الصيحة "
 
  قوله تعالي: {فاصبحوا في دارهم} 
 [الاعراف: ]
 
 حدثنا موسي بن ابي موسي الخطمي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك، قوله: " {في دارهم} [الاعراف: ] يعني المعسكر كله "
 
  قوله تعالي: {جاثمين} 
 [الاعراف: ]
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قوله: " {فاصبحوا في دارهم جاثمين} [الاعراف: ] ، قال: ميتين "
 
  قوله تعالي: {فتولي عنهم وقال يا قوم لقد ابلغتكم رسالة ربي} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد بن بشير، عن قتادة، في قول الله: " {فتولي عنهم وقال يا قوم لقد ابلغتكم رسالة ربي ونصحت لكم} [الاعراف: ] ، قال: ان نبي الله صالحا اسمع قومه كما والله اسمع محمدا صلي الله عليه وسلم قومه "
 
  قوله تعالي: {ولوطا اذ قال لقومه} 
 [الاعراف: ]
 
 حدثنا ابو سعيد الاشج، ثنا اسحاق بن منصور، عن الحكم بن عبد الملك، عن قتادة، قال: «قرية لوط حين رفعها جبريل وفيها اربعماءة الف، فسمع اهل السماء نباح الكلاب، واصوات الديكة، ثم قلب اسفلها اعلاها»
 
 حدثنا ابي، ثنا الليث بن خالد، ثنا خالد بن زياد الترمذي، ثنا قتادة، قال: «كان في مدينة لوط التي جعل عاليها سافلها اربعة الاف الف نفس»
 
 حدثنا ابو زرعة، ثنا ابراهيم بن موسي، انبا ابن ابي زاءدة، عن ابن جريج، عن مجاهد، قال: «كانوا يعني قوم لوط اربعماءة الف بيت في كل بيت عشرة مردة، فذلك اربعة الاف الف»
 
  قوله تعالي: {اتاتون الفاحشة} 
 [الاعراف: ]
 
 حدثنا محمد بن اسماعيل الاحمسي، ثنا وكيع، حدثني الصلت بن بهرام، عن عبد الرحمن بن مسعود العبدي، عن ابي المعتمر او عن ابي الجويرية، شك الصلت، قال: قال علي رضي الله عنه علي المنبر: " سلوا، فقال ابن الكوا: تءتي النساء في اعجازهن؟ فقال علي: سفلت سفل الله بك، الم تسمع الي قوله: {اتاتون الفاحشة ما سبقكم بها من احد من العالمين} [الاعراف: ] "
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {اتاتون الفاحشة} [الاعراف: ] ، قال: يعني الادبار "
 
  قوله تعالي: {ما سبقكم بها من احد من العالمين} 
 [الاعراف: ]
 
 حدثنا علي بن الحسن الهسنجاني، ثنا مسدد، ثنا اسماعيل ابن علية، قال: سمعت ابن ابي نجيح، يقول: " {اتاتون الفاحشة ما سبقكم بها من احد من العالمين} [الاعراف: ] ، قال: قال عمرو بن دينار: ما نزلوا ذكر علي ذكر حتي كان قوم لوط "
 
  قوله تعالي: {انكم لتاتون الرجال شهوة من دون النساء بل انتم قوم مسرفون} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا علي بن محمد الطنافسي، ثنا محمد بن فضيل، عن عمر بن ابي زاءدة، عن جامع بن شداد ابي صخرة، قال: «كانت اللوطية في قوم لوط في النساء قبل ان تكون في الرجال باربعين سنة»
 
 اخبرنا ابو عبد الله محمد بن حماد الطهراني فيما كتب الي، ثنا اسماعيل بن عبد الكريم، حدثني عبد الصمد بن معقل، قال: سمعت وهب بن منبه، يقول: «كان سدوم الذين فيهم لوط قوم سوء قد استغنوا عن النساء بالرجال»
 
  قوله تعالي: {وما كان جواب قومه الا ان قالوا اخرجوهم} 
 [الاعراف: ]
 
 حدثنا حجاج بن حمزة العجلي، ثنا شبابة بن سوار، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {اخرجوهم من قريتكم انهم اناس يتطهرون} [الاعراف: ] ، قال: من ادبار الرجال وادبار النساء استهزا بهم "
 
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب ابي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {اخرجوهم من قريتكم انهم اناس يتطهرون} [الاعراف: ] ، قال: يتحرجون "
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول في قول الله: " {انهم اناس يتطهرون} [الاعراف: ] ، قال: من اعمالهم الخبيثة التي كانوا يعملون اتيانهم الرجال "
 
  قوله تعالي: {فانجيناه واهله الا امراته} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا محمد بن كثير، انبا سليمان يعني ابن كثير اخاه، انبا حصين، عن سعيد بن جبير، عن ابن عباس، قال: " لما ولج رسل الله علي لوط ظن انهم ضيفان، قال: فاخرج بناته بالطريق وجعل ضيفانه بينه وبين بناته، قال: {وجاءه قومه يهرعون اليه} [هود: ] ، فقال: {هءلاء بناتي هن اطهر لكم} [هود: ] ، الي قوله: {او اوي الي ركن شديد} [هود: ] ، قال: فالتفت اليه جبريل، فقال: لا تخف، {انا رسل ربك لن يصلوا
  [ص: ]
 اليك} [هود: ] . قال: فلما دنوا طمس اعينهم فانطلقوا عميا يركب بعضهم بعضا، حتي خرجوا الي الذين بالباب، فقالوا: جءناكم من عند اسحر الناس طمست ابصارنا، قال: فانطلقوا يركب بعضهم بعضا حتي دخلوا المدينة، فكان في جوف الليل، فرفعت حتي انهم ليسمعون صوت الطير في جو السماء، ثم قلبت عليهم فمن اصابته الاءتفاكة اهلكته. قال: ومن خرج منها اتبعه حجر حيث كان فقتله. قال: وخرج لوط منها ببناته وهن ثلاث، فلما بلغ مكانا من الشام ماتت الكبري فدفنها، فخرج عندها عين يقال لها عين الربة، قال: سمعت ابن عباس يقول: ربثا قال: ثم انطلق حتي اذ بلغ مكانا اخر ماتت الصغري فدفنها، فخرج عندها عين يقال لها الزغرية، قال: سمعت ابن عباس يقول: رغرثا قال: ولم يبق غير الوسطي "
 
  قوله تعالي: {كانت من الغابرين} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة، " في الغابرين، قال: في الباقين في عذاب الله "
 
  قوله تعالي: {وامطرنا عليهم مطرا فانظر كيف كان عاقبة المجرمين} 
 [الاعراف: ]
 
 اخبرنا ابو عبد الله محمد بن حماد الطهراني فيما كتب الي، ثنا ابن عبد الكريم، حدثني عبد الصمد بن معقل، عن وهب بن منبه، قال: «فادخل ميكاءيل وهو صاحب العذاب جناحه حتي بلغ اسفل الارض، ثم حمل قراهم فقلبها عليهم، ونزلت حجارة من السماء فتبعث من لم يكن منهم في القرية حيث كانوا، فاهلكهم الله عز وجل ونجا لوط واهله الا امراته»
 
  قوله تعالي: {والي مدين اخاهم شعيبا} 
 [الاعراف: ]
 
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، " {والي مدين اخاهم شعيبا} [الاعراف: ] ، قال: ان الله تبارك وتعالي بعث شعيبا الي مدين، والي اصحاب الايكة، والايكة هي الغيضة من الشجر "
 
  قوله تعالي: {قد جاءتكم بينة من ربكم فاوفوا} 
 [الاعراف: ]
 
 وبه، عن السدي، قال: " ان الله بعث شعيبا الي مدين، فكانوا مع كفرهم يبخسون الكيل والوزن، فدعاهم فكذبوه، فقال لهم: ما ذكر الله في القران، وما ردوا عليه فلما عتوا وكذبوا سالوه العذاب "
 
 حدثنا ابي، ثنا سلمة بن بشير ابو الفضل النيسابوري، ثنا يحيي بن سعيد الحمصي، عن يزيد بن عطا، عن خلف بن حوشب، قال: «هلك قوم شعيب من شعيرة الي شعيرة، كانوا ياخذون بالرزينة، ويعطون بالخفيفة»
 
  قوله تعالي: {ولا تبخسوا الناس اشياءهم} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قوله: " {ولا تبخسوا الناس اشياءهم} [الاعراف: ] ، قال: لا تظلموا الناس اشياءهم " وروي عن قتادة، والسدي نحو ذلك
 
 واخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {ولا تبخسوا الناس اشياءهم} [الاعراف: ] ، قال: لا تنقصوهم قسموا له شيءا وتعطيه غير ذلك "
 
  قوله تعالي: {ولا تفسدوا في الارض بعد اصلاحها} 
 [الاعراف: ]
 
 ذكره ابي، ثنا عبد الرحمن بن حمزة بن اسماعيل، عن يحيي بن الضريس، انبا ابو سنان، في قوله: " {ولا تفسدوا في الارض بعد اصلاحها} [الاعراف: ] ، قال: قد احللت حلالي وحرمت حرامي وحددت حدودي فلا تغيروها "
 
 حدثنا ابي، ثنا عمار بن موسي الطرسوسي، ثنا سنيد بن داود، قال: قيل لابي بكر بن عياش، ما قوله في كتابه: " {ولا تفسدوا في الارض بعد اصلاحها} [الاعراف: ] ، فقال: ابو بكر: ان الله عز وجل بعث محمدا صلي الله عليه وسلم الي اهل الارض وهم في فساد فاصلحهم الله بمحمد صلي الله عليه وسلم فمن دعي الي خلاف ما جاء به محمد صلي الله عليه وسلم فهو من المفسدين في الارض "
 
  قوله تعالي: {ولا تقعدوا} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {ولا تقعدوا بكل صراط توعدون} [الاعراف: ] ، قال: العاشر "
 
  قوله تعالي: {بكل صراط} 
 [الاعراف: ]
 
 اخبرنا محمد بن سعد العوفي، فيما كتب الي، حدثني ابي، حدثني عمي، عن ابيه، عن ابيه، عن ابن عباس، في قوله: " {ولا تقعدوا بكل صراط توعدون} [الاعراف: ] والصراط الطريق "
 
