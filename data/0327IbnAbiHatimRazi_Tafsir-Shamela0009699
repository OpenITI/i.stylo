  قوله تعالي: {يجادلنا في قوم لوط} 
 [هود: ]
 
    
 حدثنا يحيي بن عبدك القزويني، ثنا المقرء، ثنا سليمان بن المغيرة، عن حميد بن هلال، عن جندب بن عبد الله، عن حذيفة بن اليمان: {وجاءته البشري يجادلنا في قوم لوط} [هود: ] قال: " كانت مجادلة الله اياهم ان كان فيهم خمسون من المسلمين اتهلكونهم؟ فقالوا: لا، قال: فاربعون؟ فقالوا: لا، قال: انتهي الي عشرة او خمسة حميد شك
 
 حدثنا ابي، ثنا سليمان بن حرب املاء، ثنا حماد بن سلمة، عن حميد، عن ابي نضرة، عن عبد الرحمن بن سمرة " انه راي من حبيشة شيءا كرهه، فانكره فقال لهم: اتدرون فيكم يكرهون هذا؟ قالوا: نعم قال: فلله الحمد ان ابراهيم عليه السلام لما جاءت الملاءكة فجادلهم في قوم لوط كانوا اربع قريات في كل قرية ماءة الف مقاتل لهم: ارايتم ان كان في هءلاء ماءة يكرهون هذا امهلكوهم انتم؟ قالوا: لا قال: فتسعون قال: لا حتي صار الي عشرة قال: ارايتم ان كان فيهم عشرة يكرهون هذا امهلكوهم انتم؟ قالوا: {نحن اعلم بمن فيها لننجينه واهله الا امراته كانت من الغابرين} [العنكبوت: ] "
 
    
 حدثنا حجاج، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد وقوله: {يجادلنا} [هود: ] «يخاصمنا»
 
    
 حدثنا ابي، ثنا يحيي بن عبد الحميد، ثنا يعقوب بن عبد الله، عن جعفر بن ابي المغيرة، عن سعيد بن جبير في قوله: {يجادلنا في قوم لوط} [هود: ] قال: " لما جاء جبريل الي ابراهيم صلي الله عليه وسلم، واخبره انه مهلك قوم لوط قال: اتهلك قرية فيها اربعماءة مءمن قال: لا، قال: فثلاثماءة مءمن قال: لا، قال: ثمانون مءمنا قال: لا، قال: خمسين قال: فاربعون مءمنا قال: قال فاربعة عشر مءمنا قال: لا وظن ابراهيم انهم اربعة عشر بامراة لوط وكان فيها ثلاثة عشر مءمنا، فاهلكهم الله وقد عرف ذلك جبريل وذلك قوله: {يجادلنا في قوم لوط} [هود: ] "
 
  قوله تعالي: {ان ابراهيم لحليم} 
 [هود: ]
 
    
 ذكره محمد بن يحيي بن عمر الواسطي، حدثني محمد بن الحسين، ثنا يحيي بن اسحاق، ثنا جعفر بن سليمان، عن عمر بن مالك، عن ابي الجوزاء، عن ابن عباس في قوله: {ان ابراهيم لحليم اواه منيب} [هود: ] قال: " كان من حلمه انه كان اذا اذاه الرجل من قومه قال له: هداك الله "
 
    
 حدثنا علي بن الحسين، ثنا سعيد بن عبد الله الطلاس، ثنا عبد الوهاب، عن رجل سماه عن الحسن في قوله: {ان ابراهيم لحليم} [هود: ] قال: " الحليم: الرحيم "
 
  قوله تعالي: {اواه منيب} 
 [هود: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله بن موسي، عن اسراءيل، عن ابي يحيي، عن مجاهد: {اواه} [هود: ] قال: «فقيه موقن»
 
  الوجه الثاني
 
    
 حدثنا علي بن الحسن، ثنا شعيب بن سلمة الانصاري، ثنا ابراهيم بن عيينة، ثنا زكريا، عن الشعبي قال: «الاواه المسبح»
 
  الوجه الثالث
 
    
 حدثنا ابي، ثنا ابن ابي زياد، ثنا سيار، عن جعفر بن سليمان، عن ابي عمران الجوني، عن عبد الله بن رباح، عن كعب في قوله: {ان ابراهيم لحليم اواه} [هود: ] قال: " كان اذا ذكر النار قال: اوه من عذاب الله اوه وقد تقدم القول "
 
  قوله تعالي: {منيب} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {منيب} [هود: ] قال: " المنيب: المقبل الي طاعة الله "
 
    
 حدثنا ابو سعيد الاشج، حدثني عقبة بن خالد، عن اسراءيل، عن جابر، عن مجاهد، وعكرمة قالا: {منيب} [هود: ] : «المخبت»
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة قال: " الله يثني عليه: {ان ابراهيم لحليم اواه منيب} [هود: ] والمنيب: التاءب "
 
  قوله تعالي: {يا ابراهيم اعرض عن هذا انه قد جاء امر ربك} [هود: ] الاية
 
    
 حدثنا ابي، ثنا الحسن بن عمر بن شقيق، ثنا جعفر بن سليمان، عن ابي عمران الجوني، عن عبد الله بن رباح، عن كعب قال: " فكلمهم ابراهيم في امر قوم لوط ان كان فيهم قالوا: {يا ابراهيم اعرض عن هذا انه قد جاء امر ربك} [هود: ] "
 
  قوله تعالي: {ولما جاءت رسلنا لوطا} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو سلمة موسي بن اسماعيل، ثنا حماد، عن عطاء بن الساءب، عن عبد الرحمن بن بشر الانصاري ان رسول الله صلي الله عليه وسلم قال: " ان الناس كانوا قد انذروا قوم لوط فجاءتهم الملاءكة عشية فمروا بناديهم فقال قوم لوط بعضهم لبعض: لا تنفروهم ولم يروا قوما قط احسن من الملاءكة فلما دخلوا علي لوط حاز قوم لوط نحو السماطين فخرج اليهم لوط فراودوه عن ضيفه فلم يزل بهم حتي عرض عليهم بناته فابوا فدخلوا بيته، فقالت الملاءكة: انا رسل ربك لن يصلوا اليك قال: رسل ربي قالوا: نعم، قال: لوط فالان اذا "
 
    
 حدثنا ابي، ثنا سعيد بن سليمان، ثنا سليمان بن المغيرة، عن حميد بن هلال العدوي، عن جندب قال: قال حذيفة: " لما ارسلت الرسل الي قوم لوط ليهلكوهم قيل لهم: لا تهلكوا قوم لوط حتي يشهد عليهم لوط ثلاث مرات قال: فاتوا لوطا في ارض وهو يعمل فيها فحسبهم ضيفان فاقبل حين امسي الي اهله، فمشوا معه فالتفت اليهم فقال: ما ترون ما يصنع هءلاء؟ قالوا: وما يصنعون؟ قال: ما امن الناس احد شر منهم، فمشوا معه حتي قال لوط مثل ذلك ثلاث مرات فانتهي بهم الي اهله فانطلقت العجوز عجوز السوء امراته، فاتت قومه فقالت: لقد تضيف لوط الليلة قوما ما رايت قط احسن ولا اطيب ريحا منهم "
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي قال: " خرجت الملاءكة من عند ابراهيم نحو قرية لوط فاتوها نصف النهار، فلما بلغوا نهر سدوم لقوا بنت لوط تستقي من الماء لاهلها، وكان له ابنتان اسم الكبري: ربا والصغري: زغرنا فقال لها: يا جارية هل من منزل؟ فقالت: نعم مكانكم لا تدخلوا حتي اتيكم؛ فرقت عليهم قومها، فاتت اباها فقالت: يا ابتاه ارادوك فتيان علي باب المدينة ما رايت وجوه قوم في احسن منهم لا ياخذهم قومك فيفضحونهم، وقد كان قومه نهوه ان يضيف رجلا، وقالوا خل عنا فلنضيف الرجال فجاءوا بهم فلم يعلم احد الا اهل بيت لوط وخرجت امراته فاخبرت قومها فقالت: ان في بيت لوط رجالا ما رايت مثلهم قط فجاءه قومه يهرعون اليه قالوا: او لم ننهك ان تضيف الرجال "
 
 قوله تعالي: {سء
  [ص: ]
 بهم} [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله {سء بهم} [هود: ] يقول: «ساء ظنا بقومه»
 
    
 حدثنا ابي، ثنا الحسن بن عمر بن شقيق الجرمي، ثنا جعفر بن سليمان، عن ابي عمران الجوني، عن عبد الله بن رباح، عن كعب: {سء بهم وضاق بهم ذرعا} [هود: ] «ساء مكانهم لما راي منهم من الحال»
 
  قوله تعالي: {وضاق بهم ذرعا} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {وضاق بهم ذرعا} [هود: ] يقول: «ضاق ذرعا باضيافه»
 
  قوله تعالي: {وقال هذا يوم عصيب} 
 [هود: ]
 
    
 وبه عن ابن عباس قوله: {وقال هذا يوم عصيب} [هود: ] يقول: «يوم شديد» وروي عن السدي، وقتادة مثل ذلك "
 
    
 حدثنا ابي، ثنا الحسن بن عمر بن شقيق، ثنا جعفر: {وقال هذا يوم عصيب} [هود: ] قال: «يوم سيء من قومي»
 
    
 حدثنا الحسن، عن زيد بن الحباب، عن موسي بن عبيدة، عن محمد بن كعب القرظي: {وقال هذا يوم عصيب} [هود: ] قال: «يعصب شره»
 
  قوله تعالي: {وجاءه قومه يهرعون اليه} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قوله: {يهرعون اليه} [هود: ] قال: «يسعون اليه»
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن طلحة، عن ابن عباس قوله: {يهرعون اليه} [هود: ] يقول: «مسرعين» وروي عن السدي مثل ذلك
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {يهرعون اليه} [هود: ] " يهرولون: الاسراع في المشي "
 
    
 حدثنا ابي، ثنا عيسي بن زياد، ثنا يعقوب، عن حفص، عن شمر بن عطية قال: " كان لوط قد اخذ علي امراته ان لا تذيع شيءا من امر اضيافه قال: فلما دخل عليه جبريل ومن معه راهم في صورة لم ير مثلها، فانطلقت تسعي الي قومها، فاتت النادي، فقالت بيدها هكذا تصفهم بالجمال، والهيءة قال: واقبلوا يهرعون الي قوم لوط قال لهم لوط: ما قال الله في القران "
 
  قوله تعالي: {ومن قبل كانوا يعملون السيءات} 
 [هود: ]
 
    
 حدثنا ابي، ثنا علي بن محمد الطنافسي، ثنا محمد بن فضل، عن عمر بن ابي زاءدة، عن جامع بن شداد ابي صخرة قال: «كانت اللوطية في قوم لوط في النساء قبل ان تكون في الرجال باربعين سنة»
 
    
 حدثنا عبد الله بن سليمان بن الاشعث، ثنا الحسين بن علي بن معدان الفسوي، ثنا عامر بن الفرات النساءي، عن اسباط، عن السدي: {ومن قبل كانوا يعملون السيءات} [هود: ] يقول: «ينكحون الرجال»
 
  قوله تعالي: {يا قوم هءلاء بناتي هن اطهر لكم} 
 [هود: ]
 
    
 حدثنا ابي، ثنا الحسن بن عمر بن شقيق الجرمي، ثنا جعفر بن سليمان، عن ابي عمران الجوني، عن عبد الله بن رباح، عن كعب: {هءلاء بناتي هن اطهر لكم} [هود: ] قال: «تزوجوهن»
 
    
 حدثنا ابو سعيد الاشج، ثنا وكيع، عن سفيان، عن ليث، عن مجاهد قال: {هءلاء بناتي هن اطهر لكم} [هود: ] قال: «لم يكن بناته، ولكن كن من امته وكل نبي ابو امته»
 
    
 حدثنا ابي، ثنا سليمان بن حرب، ثنا حماد بن زيد، عن محمد بن شبيب، عن جعفر بن ابي، عن سعيد بن جبير في قول الله: {يا قوم هءلاء بناتي هن اطهر لكم} [هود: ] قال: " انما دعاهم الي نساءهم قال: وكل نبي هو ابو امته، وكان في بعض القراءة (النبي اولي بالمءمنين من انفسهم وازواجه امهاتهم، وهو اب لهم)
 
 حدثنا علي بن الحسين، ثنا يعقوب الدورقي، ثنا اسماعيل بن علية قال سمعت ابن ابي نجيح يقول في قوله: {هن اطهر لكم} [هود: ] قال: «ما عرض عليهم لا تناحا ولا سفاحا»
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا خليد، وسعيد، عن قتادة، عن حذيفة بن اليمان قال: يقول: {هءلاء بناتي هن اطهر لكم} [هود: ] عرض بناته عليهم تزويجا، واراد نبي الله صلي الله عليه وسلم ان يفي بتزويج بناته "
 
  قوله تعالي: {فاتقوا الله ولا تخزون في ضيفي} 
 [هود: ]
 
    
 اخبرنا محمد بن حماد الطهراني فيما كتب الي، ثنا اسماعيل بن عبد الكريم الصنعاني، حدثني عبد الصمد بن معقل انه سمع وهب بن منبه قال: " فدخلوا علي لوط يعني: الملاءكة فلما راتهم امراته اعجبها حسنهم، وجمالهم، فارسلت الي اهل القرية، انه قد نزل بنا قوم لم نر قوما احسن منهم، ولا اجمل فتسامعوا بذلك، فغشوا دار لوط من كل ناحية تسوروا عليهم الجدران، فلقيهم لوط فقال: يا قوم لا تفضحوني في ضيفي، واني ازوجكم بناتي فهن اطهر لكم فقالوا: لو كنا نريد بناتك لقد عرفنا مكانهم ولكن لابد لنا من هءلاء القوم الذين نزلوا بك خل بيننا وبينهم "
 
  قوله: {اليس منكم رجل رشيد} 
 [هود: ]
 
    
 حدثنا ابو عبد الله الطهراني، ثنا حفص بن عمر العدني، ثنا الحكم بن ابان، عن عكرمة، عن ابن عباس في قول لوط لقومه: {اليس منكم رجل رشيد} [هود: ] يقول: " اليس منكم واحد، يقول: لا اله الا الله "
 
    
 حدثنا سهل بن يحيي العسكري، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك: {اليس منكم رجل رشيد} [هود: ] قال: «رجل يامر بالمعروف وينهي عن المنكر»
 
  قوله تعالي: {قالوا لقد علمت ما لنا في بناتك من حق} 
 [هود: ]
 
    
 حدثنا محمد بن العباس مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن ابن اسحاق: {قالوا لقد علمت ما لنا في بناتك من حق} [هود: ] «اي من ازواج»
 
  قوله تعالي: {وانك لتعلم ما نريد} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا عمر بن حماد بن طلحة العناد، ثنا اسباط، عن السدي: {وانك لتعلم ما نريد} [هود: ] «انما نريد الرجال»
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق: {وانك لتعلم ما نريد} [هود: ] «ان بغيتنا لغير ذلك»
 
  قوله تعالي: {قال لو ان لي بكم قوة او اوي الي ركن شديد} 
 [هود: ]
 
    
 حدثنا يونس بن عبد الاعلي قراءة، ثنا ابن وهب، اخبرني سليمان بن بلال، عن محمد بن عمرو بن علقمة، عن ابي سلمة بن عبد الرحمن، عن ابي هريرة قال: قال رسول الله صلي الله عليه وسلم: " رحمة الله علي لوط، لقد كان ياوي الي ركن شديد قال لقومه: {لو ان لي بكم قوة او اوي} [هود: ] الي ركن شديد قال: فما بعث الله نبيا الا في ثروة من قومه "
 
    
 حدثنا ابي، ثنا الحسن بن عمر بن شقيق، ثنا جعفر بن سليمان، عن ابي عمران الجوني، عن عبد الله بن رباح، عن كعب: {او اوي الي ركن شديد} [هود: ] قال: «الي عشيرة فتمنعني»
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {او اوي الي ركن شديد} [هود: ] قال «الي غيره»
 
    
 حدثنا ابي، ثنا موسي بن اسماعيل، ثنا مبارك، عن الحسين في قوله: {او اوي الي ركن شديد} [هود: ] " وقال الي ركن من الناس شديد يمنعونه، لا والله وجادلوه حتي قال: {اليس منكم رجل رشيد} [هود: ] "
 
  قوله تعالي: {يا لوط انا رسل ربك لن يصلوا اليك} 
 [هود: ]
 
    
 حدثنا ابي، ثنا محمد بن كثير، ثنا سليمان بن كثير، ثنا حصين، عن سعيد بن جبير، عن ابن عباس قال: " لما ولج رسل الله علي لوط ظن لوط انهم ضيفان قال: فاخرج بناته بالطريق، وجعل ضيفانه بينه وبين بناته قال: وجاءه قومه يهرعون اليه فقال: {هءلاء بناتي هن اطهر لكم فاتقوا الله} [هود: ] الي قوله: {او اوي الي
  [ص: ]
 ركن شديد} [هود: ] فالتفت اليه جبريل فقال: لا تخف انا رسل ربك لن يصلوا اليك قال: فلما دنوا طمس اعينهم فانطلقوا عميا يركب بعضهم بعضا حتي اذا خرجوا الي الذين بالباب، فقالوا: جءناكم من عند اسحر الناس طمست انظارنا قال: فانطلقوا يركب بعضهم بعضا حتي دخلوا المدينة فكان في جوف الليل فوقعت حتي انهم ليسمعون صوت الطير في جو السماء، ثم قلبت عليهم فمن اصابته الانتفاكة اهلكته، ومن خرج منها اتبعته حيث كان فقتلته "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق قالوا: {يا لوط انا رسل ربك لن يصلوا اليك} [هود: ] «الي شء تكرهه»
 
  قوله تعالي: {فاسر باهلك} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: {فاسر باهلك} [هود: ] يقول: «مر بهم واتبع ادبار اهلك»
 
  قوله تعالي: {بقطع من الليل} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {بقطع من الليل} [هود: ] «سواد من الليل»
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة قوله: {بقطع من الليل} [هود: ] " اي: بطاءفة من الليل اي سواد "
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا سعيد بن ابي مريم، ثنا المفضل بن فضالة، عن ابي صخر في قوله: {فاسر باهلك بقطع من الليل} [هود: ] قال: «السحر الاول»
 
  قوله تعالي: {ولا يلتفت منكم احد الا امراتك} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {ولا يلتفت منكم احد} [هود: ] قال: «ولا يتخلف منكم احد»
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {ولا يلتفت منكم احد} [هود: ] قال: «لا ينظر وراءه احد»
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة قوله: {ولا يلتفت منكم احد الا امراتك انه مصيبها ما اصابهم} [هود: ] «وذكر لنا انها كانت مع قوم لوط لما خرج من القرية، فسمعت الصوت، فالتفتت، فارسل عليها حجرا فاهلكها، فهي معلوم مكانها شاذة عن القوم»
 
  قوله تعالي: {انه مصيبها ما اصابهم} 
 [هود: ]
 
    
 حدثنا يحيي بن عبدك القزويني، ثنا المقرء، وسليمان بن المغيرة، عن حميد بن هلال، عن جندب بن عبد الله، عن حذيفة بن اليمان قال: «واستاذن جبريل في هلاكهم، فاذن له فاحتمل الارض التي كانوا عليها واهوي بها حتي سمع اهل سماء الدنيا صغاء كلابهم، واوقد تحتهم نارا، ثم قلبها بهم، فسمعت امراته الوجبة وهي معهم، فالتفتت فاصابها العذاب وتبعت سفارهم بالحجارة»
 
    
 حدثنا محمد بن يحيي، ثنا زنيج، ثنا جرير، عن يعقوب، عن جعفر، عن سعيد بن جبير " فلما اتوا قوم لوط ذكروا ما ارادوا قال قومه: جاءوا قوما لم تروا مثلهم قط، قال: فذهب بعضهم يتناولهم، فقال بعض الملاءكة بيده او بجناحه، فطمس اعينهم فقالوا: سحرنا، فقالوا جءنا في هلكة قوم لوط، قالوا للوط: سر فسار باهله، فلما اصبحوا سمعوا الوجبة فقالت امراته: واقومي فاصابها حجر فقتلها "
 
  قوله تعالي: {الصبح اليس الصبح بقريب} 
 [هود: ]
 
    
 حدثنا ابي، ثنا موسي بن اسماعيل، ثنا حماد بن سلمة، عن عطاء بن الساءب، عن عبد الرحمن بن بشير الانصاري ان رسول الله صلي الله عليه وسلم قال: «ان الناس كانوا قد انذروا قوم لوط فجاءتهم الملاءكة عشية» فقالت: {انا رسل ربك لن يصلوا اليك} [هود: ] قال: رسل ربي قالوا: نعم فقال لوط: فالان اذا فقال جبريل: {ان موعدهم الصبح اليس الصبح بقريب} [هود: ] "
 
    
 حدثنا يحيي بن عبدك القزويني، ثنا محمد بن سعيد بن سابق، ثنا عمرو بن ابي قيس، عن الاسود بن قيس، عن جندب بن سفيان قال: «فخرج ملك
  [ص: ]
 من الملاءكة، فقال كونوا عميا حتي اذا اصبحوا حمل ارضهم علي جناحه، فمضي بها ثم قلبها»
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي قال: " وقال لوط اهلكوهم الساعة، قالوا: انا لم نءمر الا بالصبح {اليس الصبح بقريب} [هود: ] "
 
    
 حدثنا محمد بن يحيي، ثنا يوسف بن واقد، عن يعقوب بن عبد الله، عن جعفر بن ابي المغيرة، عن سعيد بن جبير " قال لهم لوط: اهلكوهم الساعة قال له جبريل {ان موعدهم الصبح اليس الصبح بقريب} [هود: ] ، فانزلت علي لوط: {اليس الصبح بقريب} [هود: ] "
 
    
 حدثنا محمد بن العباس مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق: {ان موعدهم الصبح اليس الصبح بقريب} [هود: ] " اي: انما ينزل بهم العذاب من صبح ليلتك هذه فامض لما تءمر "
 
  قوله تعالي: {فلما جاء امرنا} 
 [هود: ]
 
    
 حدثنا علي بن الحسن، ثنا مسدد، ثنا خالد، ثنا حسين، عن سعيد بن جبير، عن ابن عباس قال: «فلما كان في جوف الليل ادخل جناحيه تحت القرية فرفعها حتي اذا كانت في جو السماء، حتي انهم ليسمعون اصوات الطير قلبها ثم تتبع الشذاذ من خرج منهم بالحجارة»
 
    
 حدثنا ابي، ثنا محمد بن موسي بن ابي نعيم النحوي الواسطي، ثنا محمد بن يزيد، عن محمد بن اسحاق، عن محمد بن كعب القرظي قال: حدثني ان الله تبارك وتعالي بعث جبريل الي المءتفكة مءتفكة قوم لوط فيهم فاحتملها بجناحه، ثم صعد بها حتي ان اهل السماء ليسمعون نباح كلابهم، واصوات دجاجهم، ثم اتبعها الله بالحجارة يقول الله: {جعلنا عاليها سافلها وامطرنا عليها حجارة من سجيل منضود} [هود: ] فاهلكها الله، ومن حولها من المءتفكات وكن خمسا: صيغة، وصغرة، وغمرة، ودوما، وسدوم، وهي القرية العظمي "
 
 حدثنا ابو سعيد الاشج، ثنا اسحاق بن منصور، عن الحكم بن عبد الملك، عن قتادة قال: «قرية لوط حيث رفعها جبريل وفيها اربعماءة الف، فسمع اهل السماء نباح الكلاب واصوات الديك، ثم قلب اسفلها اعلاها»
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة قوله: {فلما جاء امرنا جعلنا عاليها سافلها} [هود: ] ذكر لنا «انها ثلث قري فيها من العدد ما شاء الله ان يكون من الكثرة، ذكر لنا انه كان فيها اربعة الاف الف وهي سدوم قرية بين المدينة، والشام»
 
  قوله تعالي: {وامطرنا عليها} 
 [هود: ]
 
    
 حدثنا ابي، ثنا الحسين بن عمر بن شقيق الجرمي، ثنا جعفر بن سليمان، عن ابي عمران الجوني، عن عبد الله بن رباح، عن كعب: {وامطرنا عليها حجارة من سجيل} [هود: ] قال: «هي علي اهل نواديهم، وعلي دعاتهم وعلي مسافريهم فلم ينفلت منهم احد»
 
  قوله تعالي: {من سجيل} 
 [هود: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا حفص المكتب، عن ادريس، عن عطية، عن عكرمة، عن ابن عباس: {حجارة من سجيل} [هود: ] قال: «سنك وكل»
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {وامطرنا عليها حجارة من سجيل} [هود: ] قال: «بالفارسية او لها حجر، واخرها طين» وروي عن سعيد بن جبير، والسدي، ومطر الوراق نحو ذلك
 
    
 حدثنا ابو زرعة، ثنا سهل بن عثمان، ثنا يحيي بن ابي زايدة، عن اسراءيل، عن عطاء بن الساءب، عن عكرمة في قوله {حجارة من سجيل} [هود: ] قال: «لها اسم بالنبطية واسم بالفارسية»
 
  الوجه الثاني
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {حجارة من سجيل} [هود: ] يقول: «من طين» وروي عن عكرمة، وابن سابط مثل ذلك
 
  قوله تعالي: {منضود} 
 [هود: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة قوله: {منضود} [هود: ]
 
    
 حدثني ابي، ثنا احمد بن عبد الرحمن يعني الدشتكي، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع بن انس قوله: {منضود} [هود: ] «قد نضد بعضه علي بعض»
 
  قوله تعالي: {مسومة عند ربك} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {مسومة} [هود: ] يقول: «معلمة»
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {مسومة} [هود: ] قال: " التسويم: بياض في حمرة "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة قوله: {مسومة} [هود: ] حدثني من راها «انها حجارة مطوقة عليها نصح من حمرة ليست كحجارتهم هذه»
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن قيس، عن قتادة قوله: {مسومة} [هود: ] اي: «مطوقة بسواد وحمرة عند ربك»
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن السعدي، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع: «المسومة عليها سيما خطوط»
 
    
 حدثنا ابي، ثنا ابو عمير بن النحاس، ثنا ضمرة، عن ابن شوذب، عن مطر في قوله: {مسومة عند ربك} [هود: ] «منقطة بحمرة»
 
  قوله تعالي: {وما هي من الظالمين ببعيد} 
 [هود: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {وما هي من الظالمين ببعيد} [هود: ] قال: «يرهب بها قريشا»
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي الصنعاني، ثنا محمد بن ثور، عن معمر، عن قتادة، وعكرمة: {وما هي من الظالمين ببعيد} [هود: ] قال: «لم يبرا منها ظالم بعدهم» 
 
    
 حدثنا ابو زرعة، ثنا عمر بن حماد، ثنا اسباط، عن السدي قوله: {وما هي من الظالمين ببعيد} [هود: ] قال: «لم يبرا منها ظالم بعدهم»
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي قوله: {وما هي من الظالمين ببعيد} [هود: ] يقول: «من ظلمة العرب ان لم يءمنوا فيعذبوا بها»
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع قوله: {وما هي من الظالمين ببعيد} [هود: ] قال: " كل ظالم فيما سمعنا قد جعل بحذاءه حجر ينتظره متي يءمر ان يقع به، فخوف الظلمة فقال: {وما هي من الظالمين ببعيد} [هود: ] "
 
    
 حدثنا ابي، ثنا الحسين بن واقع الرملي، ثنا ضمرة، عن ابن شوذب، عن قتادة في قوله: {وما هي من الظالمين ببعيد} [هود: ] قال: " من ظالمي هذه الامة، ثم يقول: والله ما نجي الله منها ظالما بعده "
 
  قوله تعالي: {والي مدين اخاهم شعيبا قال يا قوم اعبدوا الله} [الاعراف: ] الاية
 
    
 اخبرنا احمد بن عثمان بن حكيم الاودي فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي: {والي مدين اخاهم شعيبا} [الاعراف: ] قال: «ان الله قد بعث شعيبا الي مدين والي اصحاب الايكة هي الغيضة من الشجر»
 
  قوله تعالي: {ولا تنقصوا المكيال والميزان} 
 [هود: ]
 
 حدثنا ابي، ثنا سلمة بن بشير ابو الفضل النيسابوري، ثنا يحيي بن سعيد الحمصي، عن يزيد بن عطاء، عن خلف بن حوشب قال: «هلك قوم شعيب من شعيرة الي شعيرة كانوا ياخذون بالرزينة ويعطون بالخفيفة»
 
    
 اخبرنا احمد بن عثمان بن حكيم فيما كتب الي، احمد بن مفضل، ثنا اسباط، عن السدي قال: " ان الله بعث شعيبا الي مدين فكانوا مع كفرهم يبخسون الكيل والوزن، فدعاهم، فكذبوه، فقال لهم: ما ذكر الله في القران وما ردوا عليه فلما عتوا وكذبوا سالوه العذاب "
 
  قوله تعالي: {اني اراكم بخير واني اخاف عليكم عذاب يوم محيط} 
 [هود: ]
 
    
 حدثنا اسيد بن عاصم، حدثني عبد الصمد بن عبد الوارث، حدثني ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة قوله: {اني اراكم بخير واني اخاف عليكم} [هود: ] «راي عليهم قشرا من قشر الدنيا وزينتها»
 
    
 واخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قول الله: {اني اراكم بخير} [هود: ] قال: " في دنياكم كما قال الله: {ان ترك خيرا} [البقرة: ] فسماه الله خيرا، الا ان الناس يسمون المال خيرا "
 
  قوله تعالي: {ويا قوم اوفوا المكيال والميزان بالقسط} 
 [هود: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {بالقسط} [هود: ] يعني: «بالعدل»
 
  قوله تعالي: {ولا تبخسوا الناس اشياءهم} 
 [الاعراف: ]
 
    
 وبه عن ابن عباس قوله: {ولا تبخسوا الناس اشياءهم} [الاعراف: ] قال: «لا تظلموا الناس اشياءهم» وروي عن قتادة والسدي نحو ذلك
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قوله: {ولا تبخسوا الناس اشياءهم} [الاعراف: ] قال: لا تنقصوهم يسمي له شيءا، ثم يعطيه غير ذلك "
 
  قوله تعالي: {ولا تعثوا في الارض} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قوله: {ولا تعثوا في الارض} [هود: ] يقول: «لا تسعوا في الارض»
 
    
 حدثنا محمد بن يحيي، ثنا العباس بن الوليد النرسي، ثنا يزيد بن زريع، عن سعيد، عن قتادة: {ولا تعثوا في الارض مفسدين} [البقرة: ] قال: «لا تسيروا في الارض مفسدين»
 
  قوله تعالي: {مفسدين} 
 [البقرة: ]
 
    
 حدثنا موسي بن ابي موسي الخطمي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، ثنا اسباط، عن السدي، عن ابي مالك: {ولا تعثوا في الارض مفسدين} [البقرة: ] قال: «لا تمشوا بالمعاصي»
 
  قوله: {بقية الله خير لكم ان كنتم مءمنين} 
 [هود: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {بقية الله خير لكم} [هود: ] قال: «طاعة الله»
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة قوله: {بقية الله خير لكم} [هود: ] يقول: «حظكم من ربكم خير لكم»
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن بن عبد الله بن ابي جعفر، عن ابيه، عن الربيع: {بقية الله خير لكم} [هود: ] قال: «وصية الله خير لكم»
 
    
 حدثنا احمد بن عصام الانصاري، ثنا مءمل بن ربيعة، ثنا حماد بن سلمة، ثنا حميد، عن الحسن في قوله: {بقية الله خير لكم} [هود: ] قال: «رزق الله خير لكم من بخسكم الناس»
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم يقول: في قول الله: {بقية الله خير لكم ان كنتم مءمنين} [هود: ] قال: «الهلاك في العذاب، والبقية في الرحمة»
 
  قوله تعالي: {قالوا يا شعيب اصلاتك تامرك} 
 [هود: ]
 
    
 حدثنا الحسن بن ابي الربيع، ثنا عبد الرزاق، ثنا الثوري، عن الاعمش: {اصلاتك تامرك} [هود: ] : «اقراءتك»
 
  قوله تعالي: {ان نترك ما يعبد اباءنا} 
 [هود: ]
 
    
 حدثنا ابي، ثنا محمد بن ابي عمر العدني، ثنا سفيان بن عيينة، عن رجل، عن الحسن في قوله: {يا شعيب اصلاتك تامرك ان نترك ما يعبد اباءنا} [هود: ] يقول: «اي والله ان صلواته لتامرهم ان يتركوا ما كان يعبد اباءهم»
 
  قوله تعالي: {او ان نفعل في اموالنا ما نشاء} 
 [هود: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا حماد بن خالد، عن داود بن قيس، عن زيد بن اسلم: {او ان نفعل في اموالنا ما نشاء} [هود: ] قال: «كان ينهاهم عن حذف الدراهم، وحذف الدراهم من الفساد في الارض»
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة: {او ان نفعل في اموالنا ما نشاء} [هود: ] اي: «ما نشتهي»
 
    
 حدثنا ابي، ثنا عيسي بن جعفر، ثنا سفيان الثوري في قوله: {او ان نفعل في اموالنا ما نشاء} [هود: ] قال: «الزكاة»
 
  قوله تعالي: {انك لانت الحليم الرشيد} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر، عن ابي روق، عن الضحاك، عن ابن عباس في قول قوم شعيب: {انك لانت الحليم الرشيد} [هود: ] قال: يقولون: «انك لست بحليم ولا برشيد»
 
    
 حدثنا المنذر بن شاذان، ثنا زكريا بن عدي، ثنا ابو المليح، عن ميمون بن مهران في قول الله: {انك لانت الحليم الرشيد} [هود: ] قال: «هزوا»
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة قوله: {انك لانت الحليم الرشيد} [هود: ] قال: «استهزاء بالنبي صلي الله عليه وسلم»
 
  قوله تعالي: {قال يا قوم ارايتم ان كنت علي بينة من ربي} 
 [هود: ]
 
    
 ذكر عن يزيد بن هارون، ثنا جعفر بن سليمان قال: سمعت ابا عمران الجوني قرا هذه الاية: اني {علي بينة من ربي} [الانعام: ] قال: «علي ثقة»
 
  قوله تعالي: {ورزقني منه رزقا حسنا} 
 [هود: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن سلمة بن نشيط، عن الضحاك: {رزقا حسنا} [هود: ] قال: " الرزق الحسن: الحلال "
 
  قوله تعالي: {وما اريد ان اخالفكم الي ما انهاكم عنه} 
 [هود: ]
 
    
 حدثنا يحيي بن ابي طالب، ثنا عبد الوهاب بن عطاء، ثنا سعيد بن ابي عروبة، عن قتادة، عن عزرة، عن الحسن العدني، عن يحيي بن الجزار، عن مسروق " ان امراة جاءت ابن مسعود رضي الله عنه فقالت: اتنهيعن الواصلة؟ قال: نعم، فقالت المراة: فلعله في بعض نساءك فقال: ما حفظت اذا وصية العبد الصالح {وما اريد ان اخالفكم الي ما انهاكم عنه} [هود: ] "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة قوله: {وما اريد ان اخالفكم الي ما انهاكم عنه} [هود: ] يقول: «لم اكن انهاكم عن امر واركبه»
 
  قوله تعالي: {ان اريد الا الاصلاح ما استطعت} [هود: ] الاية
 
    
 ذكر عن عثمان بن ابي شيبة، ثنا جرير، عن ابي سليمان الضبي قال: " كانت تجيءنا كتب عمر بن عبد العزيز الي خراسان فيها الامر والنهي فيكتب في اخرها: وما كنت في ذلك الا كما قال العبد الصالح: {وما توفيقي الا بالله عليه توكلت واليه انيب} [هود: ] "
 
  قوله تعالي: {واليه انيب} 
 [هود: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {واليه انيب} [هود: ] قال: «اليه ارجع»
 
  الوجه الثاني
 
    
 حدثنا احمد بن سنان، ثنا عبد الرحمن بن مهدي، عن عبد الله بن المبارك، عن يحيي بن حسان، عن عبيد بن يعلي قال: " الانابة: الدعاء "
 
  قوله تعالي: {ويا قوم لا يجرمنكم شقاقي} 
 [هود: ]
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا ابو الجماهر، ثنا سعيد بن بشر، عن قتادة: {لا يجرمنكم شقاقي} [هود: ] اي: «لا يحملنكم»
 
  قوله تعالي: {شقاقي} 
 [هود: ]
 
    
 حدثنا ابي، ثنا عمرو بن مرزوق، ثنا عمران يعني القطان قال: سمعت الحسن في قوله: {ويا قوم لا يجرمنكم شقاقي} [هود: ] قال: «ضراري»
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة قوله: {لا يجرمنكم شقاقي} [هود: ] يقول: «لا يحملنكم فراقي»
 
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: {لا يجرمنكم شقاقي} [هود: ] «لا تحملنكم عداوتي»
 
  قوله تعالي: {ان يصيبكم مثل ما اصاب قوم نوح} [هود: ] الاية
 
    
 حدثنا محمد بن عوف الحمصي، ثنا ابو المغيرة عبد القدوس بن الحجاج، ثنا ابن ابي غنية قال: حدثني عبد الملك بن ابي سليمان، عن ابي ليلي الكندي قال: كنت مع مولاي امسك دابته، وقد احاط الناس بعثمان بن عفان رضي الله عنه اذا اشرف علينا من داره فقال: {يا قوم لا يجرمنكم شقاقي ان يصيبكم مثل ما اصاب قوم نوح او قوم هود او قوم صالح} [هود: ] «يا قوم لا تقتلوني، انكم ان قتلتموني كنتم هكذا، وشبك بين اصابعه»
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: {ان يصيبكم مثل ما اصاب قوم نوح او قوم هود او قوم صالح} [هود: ] يقول: «لا تحملنكم عداوتي علي ان تمادوا في الضلال والكفر فيصيبكم من العذاب ما اصابهم»
 
  قوله تعالي: {وما قوم لوط منكم ببعيد} 
 [هود: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة قوله: {لا يجرمنكم شقاقي ان يصيبكم مثل ما اصاب قوم نوح او قوم هود او قوم صالح وما قوم لوط منكم ببعيد} [هود: ] «انما اهلكوا من ايديكم امس»
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة في قوله {وما قوم لوط منكم ببعيد} [هود: ] قال: «انما كانوا حديثي عهد قريب بعد قوم نوح، وعاد، وثمود»
 
  قوله تعالي: {واستغفروا ربكم ثم توبوا اليه} [هود: ] الي قوله: {ودود} 
 [هود: ]
 
    
 حدثنا ابي، ثنا عيسي بن جعفر قاضي الري، ثنا سفيان في قوله: {ان ربي رحيم ودود} [هود: ] : «مجيب»
 
  قوله تعالي: {قالوا يا شعيب ما نفقه كثيرا مما تقول} 
 [هود: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن ابي حماد، ثنا مهران، عن سفيان: {ما نفقه كثيرا مما تقول} [هود: ] : «ما نعرف»
 
  قوله تعالي: {وانا لنراك فينا ضعيفا} 
 [هود: ]
 
    
 حدثنا علي بن الحسين، ثنا يزيد بن عبد العزيز، ثنا عباد، عن شريك، عن سالم، عن سعيد بن جبير، عن ابن عباس في قوله: {وانا لنراك فينا ضعيفا} [هود: ] قال: «كان ضرير البصر»
 
    
 حدثنا ابي، ثنا محمد بن عطاء النخعي، ثنا شريك، عن سالم، عن سعيد بن جبير قوله: {وانا لنراك فينا ضعيفا} [هود: ] قال: «كان اعمي»
 
    
 حدثنا ابي، ثنا الفضل بن دكين، ثنا سفيان: {وانا لنراك فينا ضعيفا} [هود: ] قال: " كان ضعيفا وكان يقال: خطيب الانبياء "
 
  الوجه الثاني
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا رجل، عن السدي في قوله: {وانا لنراك فينا ضعيفا} [هود: ] قال: «انت واحد» 
 
  الوجه الثالث
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق في قوله: {وانا لنراك فينا ضعيفا} [هود: ] قال: " ذليلا قال: قالوا له: ان عشيرتك ليسوا علي دينك فانت ذليل ضعيف "
 
  قوله تعالي: {ولولا رهطك لرجمناك} 
 [هود: ]
 
    
 وبه عن ابي روق: {ولولا رهطك لرجمناك} [هود: ] اي: «ولولا عشيرتك نحفظك فيهم لرجمناك»
 
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قول الله {ولولا رهطك لرجمناك} [هود: ] قال: «لولا قومك ورهطك لرجمناك»
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن ابي روق قوله: {لرجمناك} [هود: ] اي: «لشتمناك واذيناك، ولفعلنا بك»
 
  قوله تعالي: {قال يا قوم ارهطي اعز عليكم من الله} 
 [هود: ]
 
    
 وبه عن ابي روق قال: {قال يا قوم ارهطي اعز عليكم من الله} [هود: ] يقول: «عشيرتي اعز عليكم من الله»
 
    
 اخبرنا محمد بن سعد فيما كتب الي، حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، عن ابن عباس قوله: {قال يا قوم ارهطي اعز عليكم من الله واتخذتموه وراءكم ظهريا} [هود: ] «وذلك ان قوم شعيب ورهطه، كانوا اعز عليهم من الله وصغر شان الله عندهم عز ربنا وجل»
 
  قوله تعالي: {واتخذتموه وراءكم ظهريا} 
 [هود: ]
 
    
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا جعفر بن عوف، ثنا سفيان، عن جابر، عن مجاهد: {واتخذتموه وراءكم ظهريا} [هود: ] قال: «نبذتم امره»
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {واتخذتموه وراءكم ظهريا} [هود: ] يقول: «قضاء قضي»
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {ظهريا} [هود: ] " رهط شعيب: جعلوا الله وراءهم ظهريا "
 
    
 حدثنا ابي هشام بن خالد، ثنا شعيب بن ابي عروبة، عن قتادة قوله: {واتخذتموه وراءكم ظهريا} [هود: ] يقول: " عززتم قومكم، واظهرتم بربكم {ان ربي بما تعملون محيط} [هود: ] "
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة: {واتخذتموه وراءكم ظهريا} [هود: ] : «لا تخافونه»
 
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قول الله: {واتخذتموه وراءكم ظهريا} [هود: ] قال " الظهري: الفضل مثل الجمال، يحتاج معه الي ابل ظهري فضل لا يحمل عليها شيءا الا ان يحتاج اليها فيقول: ان ربكم عندكم هكذا فان احتجتم اليه، وان لم تحتاجوا اليه فليس بشء "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر، عن اسباط، عن السدي قوله: {يا قوم ارهطي اعز عليكم من الله واتخذتموه وراءكم ظهريا} [هود: ] «فجعلتموه خلف ظهوركم، فلم تطيعوه، ولم تخافوه»
 
  قوله تعالي: {ان ربي بما تعملون محيط} 
 [هود: ]
 
    
 وقرات علي محمد بن الفضل بن موسي، ثنا محمد بن علي، ثنا محمد بن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان قوله: {بما تعملون محيط} [هود: ] يقول: «احاط عليه باعمالهم»
 
  قوله تعالي: {ويا قوم اعملوا علي مكانتكم} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {ويا قوم اعملوا علي مكانتكم} [هود: ] قال: «علي ناحيتكم»
 
  قوله تعالي: {اني عامل سوف تعلمون} 
 [هود: ]
 
    
 حدثنا ابو سعيد، ثنا ابن فضيل، عن ابيه، عن اسماعيل بن مسلم، عن الحسن: {سوف تعلمون} [هود: ] قال: «وعيد»
 
  قوله تعالي: {من ياتيه عذاب يخزيه} 
 [هود: ]
 
    
 حدثني ابو عبد الله محمد بن حماد الطهراني، ثنا حفص بن عمر، ثنا الحكم بن ابان، عن عكرمة في قوله: {من ياتيه عذاب يخزيه} [هود: ] قال: «الغرق»
 
  قوله تعالي: {ومن هو كاذب وارتقبوا اني معكم رقيب} [هود: ] بياض
 
  قوله تعالي: {ولما جاء امرنا نجينا شعيبا والذين امنوا معه برحمة منا} 
 [هود: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، حدثني محمد بن اسحاق قال: «بلغني  والله اعلم  ان الله سلط عليهم الحر حتي اذ انضجهم انشا لهم الظلة كالسحابة السوداء، فلما راوها ابتدروها يستغيثون ببردها مما هم فيه، حتي اذا دخلوا تحتها اطبقت، فهلكوا جميعا، ونجي الله شعيبا والذين امنوا معه، فاصابه علي قومه حزن لما نزل بهم من نقمة الله»
 
  قوله تعالي: {واخذت الذين ظلموا الصيحة} 
 [هود: ]
 
    
 حدثنا ابي، ثنا يحيي بن صالح الوساطني، ثنا ابو معشر، عن محمد بن كعب القرظي قال: " ان اهل مدين عذبوا ثلاثة اصناف من العذاب: احدهم الرجفة في دراهم، حتي خرجوا منها، فلما خرجوا منها اصابهم فزع شديد، ففرقوا ان يدخلوا البيوت ان تسقط عليهم، فارسل الله عليهم الظلة، فدخل تحتها رجل فقال: ما رايت كاليوم ظلا اطيب ولا ابرد، هلموا ايها الناس، فدخلوا جميعا تحت الظلة، فصاح فيهم صيحة واحدة فماتوا جميعا "
 
  قوله تعالي: {فاصبحوا في ديارهم جاثمين} 
 [هود: ]
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قول الله: {فاصبحوا في ديارهم جاثمين} [هود: ] قال: «ميتين»
 
  قوله تعالي: {كان لم يغنوا فيها} [الاعراف: ] قد تقدم تفسيره والله اعلم
 
  قوله تعالي: {ولقد ارسلنا} 
 [الانعام: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله بن موسي، عن اسراءيل، عن السدي، عن ابي صالح: {ارسل} [التوبة: ] قال: «بعث»
 
  قوله تعالي: {باياتنا} 
 [البقرة: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {باياتنا} [هود: ] قال: «بالبينات»
 
  قوله تعالي: {وسلطان مبين} 
 [هود: ]
 
    
 حدثنا ابي، ثنا مالك بن اسماعيل، ثنا سفيان بن عيينة، عن عمرو، عن عكرمة، عن ابن عباس قال: «كل سلطان في القران حجة»
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة قوله: {وسلطان مبين} [هود: ] «سلطان من الله وعذر مبين»
 
  قوله تعالي: {الي فرعون وملءه} 
 [الاعراف: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو يحيي الرازي، عن موسي بن عبيدة، عن محمد بن المنكدر قال: «عاش فرعون ثلاثماءة سنة فيها ماءتان وعشرون سنة لم ير فيها ما يقذي عينه، ودعاه موسي ثمانين سنة»
 
    
 حدثنا ابي، ثنا ابراهيم بن سعيد الجوهري، ثنا ابو اسامة، ثنا شبل، عن ابن ابي نجيح، عن مجاهد قال: «كان فرعون فارسيا من اهل اصطخر»
 
    
 قرء علي يونس بن عبد الاعلي المصري، ثنا ابن وهب، اخبرني ابن لهيعة «ان فرعون كان من ابناء مصر»
 
  قوله تعالي: {فاتبعوا امر فرعون وما امر فرعون برشيد} [هود: ] بياض
 
  قوله تعالي: {يقدم قومه يوم القيامة} 
 [هود: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: {يقدم قومه يوم القيامة} [هود: ] يقول: «يقود قومه يوم القيامة»
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة: {يقدم قومه يوم القيامة} [هود: ] «يمضي بين ايديهم يحم بهم علي النار»
 
  قوله تعالي: {فاوردهم النار} 
 [هود: ]
 
    
 اخبرنا محمد بن حماد فيما كتب الي، ثنا عبد الرزاق، ثنا ابن عيينة، عن عمرو بن دينار عمن سمع ابن عباس يقول في قول الله: {فاوردهم النار} [هود: ] قال: «الورد الدخول»
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن مرزوق بن ابي
  [ص: ]
 سلامة، قال نافع بن الازرق لابن عباس: يا ابن عباس " ما الورود؟ قال: الدخول، قال: انما الورود: الوقوف علي شفيرها قال: فقال ابن عباس: والله لاردنها ولتردنها واني لارجوا ان اكون من الذين قال الله {ثم ننجي الذين اتقوا} [مريم: ] وتكون انت من الذين قال الله تعالي: {ونذر الظالمين فيها جثيا} [مريم: ] قال: وكذلك كان يقراها ويحك يا نافع بن الازرق اما تقرا كتاب الله: {وما امر فرعون برشيد يقدم قومه يوم القيامة فاوردهم النار} [هود: ] افتراه ويحك، انما اقامهم علي شفيرها والله تعالي يقول: {ويوم تقوم الساعة ادخلوا ال فرعون اشد العذاب} [غافر: ]
 
  قوله تعالي: {وبءس الورد المورود} 
 [هود: ]
 
    
 اخبرنا احمد بن الازهر ابو الازهر فيما كتب الي، ثنا وهب بن جرير، ثنا ابي، عن علي بن الحكم، عن الضحاك اما قوله: {وبءس الورد المورود} [هود: ] فان ابن عباس كان يقول: «المورود في القران اربعة اوراد، وان منكم الا واردها»
 
  قوله تعالي: {واتبعوا في هذه لعنة ويوم القيامة} 
 [هود: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {واتبعوا في هذه لعنة ويوم القيامة} [هود: ] : «زيدوا بلعنة اخري فتلك لعنتان»
 
    
 حدثنا عبد الله بن سليمان بن الاشعث، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: {واتبعوا في هذه لعنة ويوم القيامة} [هود: ] قال: «لم يبعث نبي بعد فرعون الا لعن علي لسانه، ويوم القيامة ترفد لعنة الله اخري في النار»
 
  قوله تعالي: {الرفد المرفود} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {بءس الرفد المرفود} [هود: ] يقول: «لعنة الدنيا والاخرة»
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة: {بءس الرفد المرفود} [هود: ] يقول: «ترادفت عليه لعنتان من الله، لعنة الدنيا، والاخرة»
 
  قوله تعالي: {ذلك من انباء القري نقصه عليك} 
 [هود: ]
 
    
 حدثنا ابو بكر بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك قوله: {انباء} [ال عمران: ] يعني: «احاديث»
 
  قوله تعالي: {منها قاءم} 
 [هود: ]
 
    
 اخبرنا محمد بن سعيد فيما كتب الي، ثنا ابي، حدثني عمي، حدثني ابي، عن ابيه، عن ابن عباس قوله: {منها قاءم} [هود: ] يعني: «بالقاءم قري عامرة»
 
    
 حدثنا ابي، ثنا يحيي بن صالح الوحاظي، عن ابي معشر، عن محمد بن كعب في قوله: {قاءم وحصيد} [هود: ] قال: «ما كان من بنيانهم قاءم لم يخرب»
 
  قوله تعالي: {وحصيد} 
 [هود: ]
 
 حدثنا ابو بجير محمد بن جابر المحاربي، ثنا عبيد الله بن موسي، عن سفيان، عن الاعمش في قوله: {منها قاءم وحصيد} [هود: ] قال: «خر بنيانه»
 
    
 حدثنا ابو زرعة، ثنا صفوان بن صالح، ثنا الوليد، ثنا سعد بن بشير، عن قتادة في قول الله: {منها قاءم وحصيد} [هود: ] قال: «قري خاوية علي عروشها لاصق بالارض ولا تري فيها اثرا»
 
    
 اخبرنا محمد بن سعد فيما كتب الي، حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، عن ابن عباس قوله: {منها قاءم وحصيد} [هود: ] يعني بالحصيد: «قري خامدة»
 
  قوله تعالي: {وما ظلمناهم} [هود: ] الاية
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم يقول: " ثم اعتذر الي خلقه فقال: {وما ظلمناهم ولكن ظلموا انفسهم فما اغنت عنهم الهتهم} [هود: ] : فما ذكرنا لك من عذاب من عذبناه من الامم ولكن ظلموا انفسهم "
 
  قوله تعالي: {يدعون من دون الله} 
 [الانعام: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة قوله: {يدعون من دون الله} [الانعام: ] قال: «الوثن»
 
 قوله تعالي: {وما زادوهم
  [ص: ]
 غير تتبيب} [هود: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {وما زادوهم غير تتبيب} [هود: ] : «تخسير»
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة قوله: {وما زادوهم غير تتبيب} [هود: ] اي: «هلكة»
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم يقول في قول الله: {وما زادوهم غير تتبيب} [هود: ] قال: " التتبيب: الشر قال: وما زادوهم الا شرا وقرا {تبت يدا ابي لهب وتب} [المسد: ] قال: واما التب: الخسران والشر ما زادوهم الا خسرانا "
 
  قوله تعالي: {وكذلك اخذ ربك اذا اخذ القري وهي ظالمة} 
 [هود: ]
 
    
 حدثنا ابي، ثنا محمد بن عبد الله بن نمير الهمداني ابو معاوية، ثنا بريد بن عبد الله بن ابي بردة، عن ابي بردة، عن ابي موسي قال: قال رسول الله صلي الله عليه وسلم: «ان الله اخذ القري وهي ظالمة، ان اخذه اليم شديد»
 
  قوله تعالي: {ان اخذه اليم شديد} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {ان اخذه اليم شديد} [هود: ] يقول: «موجع»
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم يقول في قوله: {ان في ذلك لاية لمن خاف عذاب الاخرة} [هود: ] «انا سوف نفي لهم بما وعدناهم في الاخرة، كما وفينا للانبياء ان ننصرهم»
 
  قوله تعالي: {ذلك يوم مجموع له الناس وذلك يوم مشهود} 
 [هود: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا حفص المكتب، ثنا ادريس، عن شيخ من بني اسد، عن ابي الضحي، عن الحسن، والحسين بن علي قال: " المشهود: يوم القيامة " وروي عن مجاهد نحو ذلك
 
 حدثنا ابي، ثنا محمد بن مقاتل عن وكيع، عن شعبة، عن علي بن زيد، عن يوسف المكي، عن ابن عباس قال: " الشاهد: محمد صلي الله عليه وسلم، ومشهود: يوم القيامة، ثم قرا {ذلك يوم مجموع له الناس وذلك يوم مشهود} [هود: ] "
 
    
 ذكره ابو زرعة، ثنا محمد بن يحيي بن اسماعيل المصري، ثنا ابن وهب بن الحارث، ثنا عمرو، عن سعيد بن ابي هلال، عن زيد بن ايمن، عن عبادة بن نسي، عن ابي الدرداء قال: قال رسول الله صلي الله عليه وسلم: «اكثروا الصلاة علي يوم الجمعة فانه يوم مشهود، تشهده الملاءكة»
 
  قوله تعالي: {وما نءخره الا لاجل معدود} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {اجل} [هود: ] يعني: «الموت»
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم يقول في قوله: {ذلك يوم مجموع له الناس} [هود: ] ، قال: «مالك يا رب لا تاخذ هءلاء كما اخذت الذين من قبلهم» فقال: ما نءخرهم الا لاجل معدود "
 
  قوله تعالي: {يوم يات لا تكلم نفس الا باذنه} 
 [هود: ]
 
    
 حدثنا ابي، ثنا يحيي بن عبد الحميد الحماني، ثنا هذيل بن عمران الهمداني، ثنا شريك، عن سالم، عن سعيد بن جبير في قوله: {الا باذنه} [البقرة: ] قال: «من يتكلم عنده الا باذنه»
 
  قوله تعالي: {فمنهم شقي وسعيد} 
 [هود: ]
 
    
 حدثنا ابو سعيد القطان، ثنا ابو عامر العقدي، عن سليمان بن سفيان، عن عبد الله بن دينار، عن ابن عمر، عن عمر قال: نزلت: {فمنهم شقي وسعيد} [هود: ] سالت النبي صلي الله عليه وسلم فقلت: يا رسول الله علام نعمل علي شء قد فرغ منه او علي شء لم يفرغ منه؟ فقال النبي صلي الله عليه وسلم: «بلي علي شء قد فرغ منه وجرت به الاقلام يا عمر ولكن كل ميسر»
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو خالد، عن ابن عون، عن شقيق بن سلمة قال: سمعت عبد الله بن مسعود رضي الله عنه يقول: " ايها الناس، انكم
  [ص: ]
 مجموعون في صعيد واحد يسمعكم الداعي وينفذكم البصر، والشقي: من شقي في بطن امه، والسعيد: من وعظ بغيره "
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قال: " هاتان من المغيبات: {فمنهم شقي وسعيد} [هود: ] فهم قوم من اهل الكباءر من اهل هذه القبلة، يعذبهم الله بالنار، ما شاء بذنوبهم، ثم ياذن في الشفاعة لهم فيشفع لهم المءمنون، فيخرجون من النار، فيدخلهم الجنة، فسماهم اشقياء حين عذبهم في النار فقال: {فاما الذين شقوا ففي النار لهم فيها زفير وشهيق} [هود: ] "
 
  قوله تعالي: {فاما الذين شقوا ففي النار} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {لهم فيها زفير وشهيق} [هود: ] يقول: «صوت شديد»
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قوله: {لهم فيها زفير} [هود: ] قال: «الزفير في الحلق» وروي عن الربيع بن انس مثل قول الضحاك، عن ابن عباس
 
  قوله: {وشهيق} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {وشهيق} [هود: ] قال: «صوت ضعيف»
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {لهم فيها زفير وشهيق} [هود: ] قال: «والشهيق في الصدر»
 
  قوله تعالي: {خالدين فيها} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن دينار، عن سعيد بن جبير: {خالدين فيها} [هود: ] يعني: «لا يموتون»
 
  قوله تعالي: {ما دامت السموات والارض}
 
    
 ذكر عن سفيان بن حسين، عن الحكم، عن مجاهد، عن ابن عباس قوله: {ما دامت السموات والارض} قال: «لكل جنة سماء وارض»
 
 ذكر عن مبارك بن فضالة عن الحسن في قوله: {ما دامت السموات والارض} قال: «تبدل سماء غير هذه، وارض غير هذه، فما دامت تلك السماء، وتلك الارض»
 
    
 حدثنا زكريا بن اذد بن بكر النيسابوري، حدثني محمد بن يحيي النيسابوري، حدثني عبد الصمد بن مسعود بن عبد الله، حدثني مبشر بن عبد الله، عن سفيان بن حسين، عن الحسن في قوله: {واما الذين شقوا ففي النار لهم فيها زفير وشهيق خالدين فيها ما دامت السموات والارض} قال: «اذا كان يوم القيامة اخذ الله السماوات السبع والارضين السبع فطهرهن من كل قذر ودنس، فصيرهن ارضا بيضاء فضة نورا تلالا فصيرهن ارضا للجنة والسماوات والارضون اليوم في الجنة كالجنة في الدنيا فصيرهن الله علي عرض الجنة، ويضع الجنة عليها وهي اليوم علي ارض زعفرانية عن يمين العرش فما دامت ارضا للجنة، واهل الشرك خالدين في جهنم ما دامت ارض الجنة»
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، عن عامر بن الفرات، ثنا اسباط، عن السدي قوله: {خالدين فيها ما دامت السموات والارض الا ما شاء ربك} قال: «اما السماء والارض فسماء الجنة وارضها»
 
  قوله تعالي: {الا ما شاء ربك} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قوله: {الا ما شاء ربك} [هود: ] يعني: «الذين كانوا في النار حين اذن في الشفاعة لهم فاخرجهم من النار وادخلهم الجنة»
 
    
 حدثنا زكريا بن داود بن بكر النيسابوري، حدثني محمد بن يحيي النيسابوري، حدثني عبد الصمد بن مسعود بن عبد الله، حدثني مبشر بن عبد الله، عن سفيان بن الحسين، عن الحسن قال: " فاما الاستثناءان جميعا ففي اهل التوحيد الذين يعذبون في البراني: وهو واد يعذب الموحدون فيه، ثم يشفع فيهم النبي صلي الله عليه وسلم ثم يردون الي الجنة، ويقول: {الذين شقوا ففي النار لهم فيها زفير وشهيق} [هود: ] خالدين فيها الا الموحدون الذين يخرجون من البراني "
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن عامر بن جشيب، عن خالد بن معدان قوله: {الا ما شاء ربك} [هود: ] قال: «انه في اهل التوحيد من اهل القبلة» وروي عن مقاتل بن حيان قال: وقع الاستثناء علي من في النار من اهل التوحيد حتي يخرجوا منها
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي الصنعاني، ثنا محمد بن ثور، عن معمر، عن الضحاك بن مزاحم قوله: {الا ما شاء ربك} [هود: ] يقول: «الا ما مكثوا في النار حتي ادخلوا الجنة»
 
    
 حدثنا ابي، ثنا هشام، ثنا ابن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة قوله: {فاما الذين شقوا ففي النار لهم فيها زفير وشهيق خالدين فيها ما دامت السموات والارض الا ما شاء ربك} «الله اعلم بتثنيته علي ما وقعت به»
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي: {الا ما شاء ربك} [هود: ] " فان هذه الاية يوم نزلت كانوا يطمعون في الخروج فنسخها قوله: {خالدين فيها ابدا} [النساء: ] "
 
  قوله تعالي: {ان ربك فعال لما يريد} 
 [هود: ]
 
    
 ذكر عن جعفر بن سليمان، عن الجريري، سمعت ابا نضرة يقول: " ينتهي القران كله الي هذه الاية {ان ربك فعال لما يريد} [هود: ] "
 
  قوله تعالي: {واما الذين سعدوا ففي الجنة} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قوله: {واما الذين سعدوا} [هود: ] «يعني بعد الشقاء الذي كانوا فيه»
 
  قوله تعالي: {خالدين فيها ما دامت السموات والارض} قد تقدم تفسير هذين الحرفين
 
    
 حدثنا زكريا بن داود بن بكر، حدثني محمد بن يحيي، حدثني عبد الصمد بن مسعود بن عبد الله، حدثني مبشر بن عبد الله، عن حسن بن الحسين، عن الحسن
  [ص: ]
 قوله: {واما الذين سعدوا ففي الجنة خالدين فيها ما دامت السموات والارض الا ما شاء ربك} يقول: " اهل السعادة في الجنة خالدين فيها: {الا ما شاء ربك} [هود: ] يقول: الا الموحدون الذين يعودون اليهم من البراني فالاستثناءان جميعا في اهل التوحيد لانه لا يكون في اهل الشرك استثناء واهل الشرك في جهنم خالدين لا يفنون ولا يخرجون "
 
    
 حدثنا ابي، ثنا عبد الله بن الوليد بن مهران المدايني، ثنا بشار بن قيراط، عن بكير بن معروف، عن مقاتل بن حيان في قوله: {واما الذين سعدوا ففي الجنة خالدين فيها} [هود: ] «وقع الاستثناء علي من بقي في النار حتي يخرجوا منها»
 
    
 حدثنا ابي، ثنا سعيد بن عبد الحميد، ثنا يعقوب القمي، عن ابي مالك، عن ابي سنان في قوله: {واما الذين سعدوا ففي الجنة خالدين فيها ما دامت السموات والارض الا ما شاء ربك} «ومشيءته خلودهم فيها» ثم اتبعها {عطاء غير مجذوذ} [هود: ]
 
 حدثني ابي، ثنا محمد بن عبد الاعلي الصنعاني، ثنا محمد بن ثور، عن معمر، عن الضحاك بن مزاحم قوله: {الا ما شاء ربك} [هود: ] قال: " وهي ايضا في الذين يخرجون من النار، فيدخلون الجنة يقول: خالدين في الجنة ما دامت السموات والارض الا ما شاء ربك يقول: الا ما مكثوا في النار حتي ادخلوا الجنة "
 
  قوله تعالي: {عطاء غير مجذوذ} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله {عطاء غير مجذوذ} [هود: ] يقول: «عطاء غير مقطوع» وروي عن ابي العالية، ومجاهد، والربيع بن انس، والنضر بن عربي، وقتادة نحو ذلك "
 
    
 حدثنا ابي، ثنا ابو سلمة موسي بن اسماعيل، ثنا مبارك، عن الحسن: {عطاء غير مجذوذ} [هود: ] قال: «لا ينقص منه شء»
 
  قوله تعالي: {فلا تك في مرية مما يعبد هءلاء ما يعبدون الا كما يعبد اباءهم من قبل} 
 [هود: ]
 
    
 حدثنا محمد بن يحيي، ثنا العباس بن الوليد النرسي، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة قال: «ما يعبد هءلاء الالهة الا ليشفعوا عند الله»
 
  قوله تعالي: {وانا لموفوهم نصيبهم غير منقوص} 
 [هود: ]
 
    
 حدثنا عمرو الاودي، ثنا وكيع، عن سفيان، عن جابر، عن مجاهد، عن ابن عباس: {وانا لموفوهم نصيبهم غير منقوص} [هود: ] قال: «ما وعدوا به من خير او شر»
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا ابو يمان، عن ابي جعفر الرازي، عن الربيع، عن ابي العالية في قوله: {وانا لموفوهم نصيبهم غير منقوص} [هود: ] قال: «من الرزق»
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قول الله: {وانا لموفوهم نصيبهم غير منقوص} [هود: ] قال: «موفوهم نصيبهم من العذاب غير منقوص»
 
  قوله تعالي: {ولقد اتينا موسي الكتاب} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، ثنا العباس بن الوليد، ثنا يزيد، ثنا سعيد، عن قتادة: {ولقد اتينا موسي الكتاب} [هود: ] قال: «التوراة»
 
  قوله تعالي: {فاختلف فيه} 
 [هود: ]
 
    
 حدثنا عصام بن داود، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية، عن ابي بن كعب قوله: {فاختلف فيه} [هود: ] يعني: «اسراءيل»
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة قوله: {ولا تطغوا} [هود: ] قال: «امر محمدا صلي الله عليه وسلم ان يستقيم علي امر الله»
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قول الله: {فاستقم كما امرت ومن تاب معك ولا تطغوا} [هود: ] قال: «الطغيان خلاف وركوب معصية ذلك الطغيان»
 
  قوله تعالي: {ولا تركنوا الي الذين ظلموا} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {ولا تركنوا} [هود: ] يقول: «لا تدنوا»
 
 حدثنا محمد بن الحسين، ثنا اسحاق بن سليمان، ثنا ابو جعفر الرازي، عن الربيع بن انس ح. وحدثني ابي سهل بن عثمان، وعبد الله بن عمران قالا: ثنا يحيي بن يمان، عن ابي جعفر، عن الربيع، عن ابي العالية قوله: ولا تركنوا الي الذين ظلموا قال: «ترضوا اعمالهم»
 
    
 حدثنا ابي، ثنا محمد بن ابي عمر العدني قال: سءل سفيان عن قوله: {ولا تركنوا الي الذين ظلموا} [هود: ] قال: «لا تدنوا منهم» ثم قرا: {لقد كدت تركن اليهم شيءا قليلا} [الاسراء: ]
 
    
 حدثنا ابي، ثنا احمد بن ابي الخوازي، حدثني اخي محمد قال: سالت فضيل بن عياض، عن قول الله: {ولا تركنوا الي الذين ظلموا} [هود: ] قال: «ممن كانوا وحيث كانوا، ومن كانوا وفي اي زمان كانوا»
 
  قوله تعالي: {فتمسكم النار} 
 [هود: ]
 
    
 اخبرنا محمد بن سعد فيما كتب الي، ثنا ابي، حدثني عمي، حدثني ابي، عن ابيه، عن ابن عباس: {ولا تركنوا الي الذين ظلموا فتمسكم النار} [هود: ] يعني: «الركون الي الشرك»
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة قوله: {ولا تركنوا الي الذين ظلموا فتمسكم النار} [هود: ] اي: «لا تلحقوا بالشرك وهو الذنب الذي تابوا منه»
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة قوله: {ولا تركنوا الي الذين ظلموا فتمسكم النار} [هود: ] يقول: «لا تلحقوا بالشرك، وهو الذي خرجتم منه، وليست والله كما تاولها اهل الشبهات والبدع والفراية علي الله وعلي كتابه»
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قوله: {ولا تركنوا الي الذين ظلموا} [هود: ] قال: " لا تركنوا الي المشركين، فتمسكم النار قال: الاركان: الادهان وقرا {تدهن فيدهنون} [القلم: ] قال: تركن اليهم، ولا تنكر عليهم الذي قالوا، والركون ان يقوله بما قال الادهان "
 
 قوله تعالي: {وما لكم
  [ص: ]
 من دون الله من اولياء ثم لا تنصرون} [هود: ] الاية بياض
 
  قوله تعالي: {واقم الصلاة طرفي النهار} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {واقم الصلاة طرفي النهار} [هود: ] «يقول صلاة المغرب، وصلاة الغداة»
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو عبد الرحمن الحارثي، عن قرة بن خالد، عن الحسن: {اقم الصلاة طرفي النهار} [هود: ] قال: الغداء، والظهر، والعصر " وروي عن محمد بن كعب القرظي مثل قول الحسن
 
  قوله: {وزلفا من الليل} 
 [هود: ]
 
    
 حدثنا محمد بن عبد الله بن يزيد المقرء، ثنا سفيان، سمع عبد الله بن ابي يزيد ابن عباس «يستحب تاخير العشاء» ويقرا {وزلفا من الليل} [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: {وزلفا من الليل} [هود: ] يقول: «صلاة القيام»
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن علية، عن ابي رجاء، عن الحسن: وزلفا من الليل قال: «هما زلفتان صلاة المغرب، وصلاة العشاء» وروي عن محمد بن كعب القرظي مثل قول الحسن
 
  الوجه الثاني
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو نعيم، عن سفيان، عن منصور، عن مجاهد: {واقم الصلاة طرفي النهار} [هود: ] وقال: «صلاة الفجر، وصلاة العشاء»
 
  قوله تعالي: {ان الحسنات يذهبن السيءات} 
 [هود: ]
 
    
 حدثنا احمد بن سنان، ثنا يحيي بن سعيد القطان، عن ابي عثمان النهدي، عن عبد الله بن مسعود ان رجلا نال من امراة قبلة، فاتي النبي صلي الله عليه وسلم فساله عن كفارتها قال: فنزلت: {واقم الصلاة طرفي النهار وزلفا من الليل} [هود: ] قال: يا رسول الله هذه لي قال: «لمن عمل من امتي»
 
 حدثنا عبد الله بن محمد بن عمرو الغزي، ثنا الفريابي، ثنا سفيان، عن ابن مسعود قال: " جاء رجل الي النبي صلي الله عليه وسلم فقال: اني اصبت منها كل شء الا الجماع يعني: من امراة فانزل الله: {اقم الصلاة طرفي النهار وزلفا من الليل ان الحسنات يذهبن السيءات} [هود: ] "
 
    
 حدثنا ابو سعيد الاشج، ثنا حفص بن غياث، عن عبد الله بن مسلم، عن سعيد بن جبير، عن ابن عباس قوله: {ان الحسنات يذهبن السيءات} [هود: ] «الصلوات الخمس» وروي عن محمد بن كعب القرظي مثل قول ابن عباس
 
    
 حدثنا سعد بن عبد الله بن عبد الحكم، ثنا ابو زرعة وهب الله بن راشد، اخبرني حيوة، ثنا ابو عقيل زمرة بن معبد انه سمع الحارث مولي عثمان بن عفان قال: جلس عثمان يوما علي المقاعد، وجلسنا معه فلما جاء المءذن دعا بماء اظنه سيكون فيه مد فتوضا، ثم قال: رايت رسول الله صلي الله عليه وسلم يتوضا وضوءي هذا ثم قام فصلي صلاة الظهر غفر له ما كان بينه وما بين صلاة الصبح ثم صلي العصر غفر له ما بينها وبين صلاة الظهر ثم صلي المغرب غفر له ما بينها وبين صلاة العصر ثم صلي العشاء غفر له ما بينها وبين صلاة المغرب ثم لعله يبيت يتمرغ ليلته ثم ان قام فتوضا ثم صلي صلاة الصبح غفر له ما بينهما وبين صلاة العشاء وهن الحسنات، {ان الحسنات يذهبن السيءات ذلك ذكري للذاكرين} [هود: ]
 
    
 حدثنا احمد بن عصام، ثنا ابو عامر العقدي، ثنا عثمان بن بسطاس مولي كثير بن الصلت قال: سمعت عطاء بن دينار في قوله: {ان الحسنات يذهبن السيءات} [هود: ] قال: " وان من الحسنات قوله: سبحان الله، والحمد لله، ولا اله الا الله، ولا حول ولا قوة الا بالله، وهن الباقيات الصالحات "
 
    
 حدثنا محمد بن يحيي الواسطي، ثنا محمد بن بشير، ثنا سهل بن حميد، عن حوشب، عن الحسن قال: " استعينوا علي السيءات القديمات بالحسنات الحديثات، وانكم لن تجدوا شيءا اذهب بسيءة قديمة من حسنة حديثة قال الحسن: وانا اجد تصديق ذلك في كتاب الله: {ان الحسنات يذهبن السيءات} [هود: ] "
 
  قوله تعالي: {ذلك ذكري للذاكرين} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابن عمير، ثنا سفيان بن ابي نجيح، عن مجاهد قال: «لا يكون العبد من الذاكرين الله كثيرا حتي يذكر الله قاءما وقاعدا ومضطجعا»
 
 حدثنا محمد بن يحيي الواسطي، ثنا محمد بن بشير الواعظ، ثنا سهل بن حميد، عن حوشب، عن الحسن: {ذلك ذكري للذاكرين} [هود: ] قال: «هم الذين يذكرون الله في السراء، والضراء، والشدة، والرخاء، والعافية، والبلاء»
 
  قوله تعالي: {واصبر فان الله لا يضيع اجر المحسنين} 
 [هود: ]
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن الدشتكي، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع بن انس قال: " مكتوب في الكتاب الاول ان الحاسد لا يضر بحسده الا نفسه ليس ضارا من حسد، وان الحاسد ينقصه حسده، وان المحسود اذا صبر انجاه تصبره لان الله يقول: {واصبر فان الله لا يضيع اجر المحسنين} [هود: ] "
 
    
 عن الضحاك: {ولو شاء ربك لجعل الناس امة واحدة} [هود: ] «اهل دين واحد اهل ضلالة او اهل هدي»
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير في قول الله: {امة واحدة} [هود: ] «يعني ملة الاسلام وحدها»
 
  قوله تعالي: {ولا يزالون مختلفين} 
 [هود: ]
 
    
 حدثنا ابي، ثنا محمد بن عمران، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {ولا يزالون مختلفين} [هود: ] قال: «اهل الحق، واهل الباطل»
 
    
 حدثنا ابي، ثنا عبد الله بن صالح بن مسلم، ثنا ابو الاحوص، عن سماك، عن عكرمة، عن ابن عباس قوله: {ولا يزالون مختلفين الا من رحم ربك} [هود: ] قال: «لا يزالون مختلفين في الهوي»
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن علية، عن منصور بن عبد الرحمن قال: قلت للحسن: {ولا يزالون مختلفين} [هود: ] قال: «الناس مختلفون علي اديان شتي» وروي عن مجاهد نحو ذلك
 
  الوجه الثاني
 
    
 حدثنا ابي قبيصة، ثنا سفيان، عن طلحة بن عمرو، عن عطاء: {ولا يزالون مختلفين} [هود: ] قال: «اختلاف الملل»
 
    
 ذكر عن ابي سلمة الجوباري، ثنا معتمر، عن ابيه، عن الحسن {ولا يزالون مختلفين} [هود: ] «في الرزق يسخر بعضهم لبعض، وقال مختلفين في المغفرة والرحمة»
 
  قوله تعالي: {الا من رحم ربك} 
 [هود: ]
 
    
 حدثنا ابي، ثنا محمد بن عمران بن ابي ليلي، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {الا من رحم ربك} [هود: ] قال: «اهل الحق»
 
    
 حدثنا ابي، ثنا هشام بن عمارة، ثنا الوليد، عن شعيب بن رزيق، عن عطاء الخراساني، عن عكرمة: {ولا يزالون مختلفين} [هود: ] «ثم استثني من الاختلاف من رحم»
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن علية، عن منصور بن عبد الرحمن قال: قلت للحسن: {الا من رحم ربك} [هود: ] قال: «غير مختلف»
 
 قرء علي يونس بن عبد الاعلي، ثنا ابن وهب، ثنا عبد الرحمن بن مهدي، حدثني طلحة بن عمرو انه سمع عطاء يقول: {ولا يزالون مختلفين الا من رحم ربك} [هود: ] قال: «اليهود، والنصاري، والمجوس، والذين رحم ربك الحنفية»
 
    
 حدثنا الحسن بن عرفة، ثنا يحيي بن يمان، عن ابن جريج، عن عكرمة في قول الله: {الا من رحم ربك} [هود: ] قال: «اهل القبلة» وروي عن مجاهد قال: اهل الاسلام
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا خليد بن علي، وسعيد بن بشير، عن قتادة: {الا من رحم ربك} [هود: ] قال: «اهل رحمة الله اهل الجماعة، وان تفرقت ديارهم وابدانهم، واهل معصيته اهل فرقة، وان اجمعت ديارهم وابدانهم»
 
  قوله تعالي: {ولذلك خلقهم} 
 [هود: ]
 
    
 حدثنا ابي، ثنا محمد بن عمران بن ابي ليلي، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: {ولذلك خلقهم} [هود: ] قال: «للرحمة» وروي عن مجاهد، وقتادة مثل ذلك
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {ولذلك خلقهم} [هود: ] قال: " خلقهم فرقتين، فريقا يرحم فلا يختلف، وفريقا لا يرحم، يختلف، وذلك قوله: {فمنهم شقي وسعيد} [هود: ] "
 
    
 اخبرنا يونس بن عبد الاعلي قراءة ثنا ابن وهب، اخبرني مسلم بن خالد، عن ابن ابي نجيح، عن طاوس " ان رجلين اختصما اليه، فاكثرا فقال طاوس: اختلفتما واكثرتما قال احد الرجلين: لذلك خلقنا، فقال طاوس: كذبت قال: اليس الله يقول: {ولا يزالون مختلفين الا من رحم ربك ولذلك خلقهم} [هود: ] قال: لم يخلقهم ليختلفوا، ولكن خلقهم للجماعة والرحمة "
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا يحيي بن ابي زاءدة، قال ابن جريج، قال مجاهد: «خلق اهل الحق ومن اتبعه لرحمته»
 
    
 حدثنا ابو سعيد الاشج، ثنا اسماعيل بن علية، عن منصور بن عبد الرحمن قال: قلت للحسن: {ولا يزالون مختلفين الا من رحم ربك ولذلك خلقهم} [هود: ] قال: «خلق هءلاء لجنته، وهءلاء للنار، وخلق هءلاء لرحمته، وهءلاء للعذاب»
 
    
 اخبرنا يونس بن عبد الاعلي قراءة عن ابن وهب، اخبرني عبد الله بن يزيد، وحدثني يحيي بن عبدك، ثنا المقرء، ثنا المسعودي قال: سمعت عمر بن عبد العزيز يقول هذه الاية: {ولا يزالون مختلفين الا من رحم ربك ولذلك خلقهم} [هود: ] قال: «خلق اهل رحمته الا يختلفوا»
 
    
 حدثنا حميد بن عباس، ثنا مءمل بن اسماعيل، ثنا حماد بن سلمة، وحماد بن زيد قالا: ثنا خالد الحذاء قال: قلت للحسن قوله: {ولا يزالون مختلفين الا من رحم ربك ولذلك خلقهم} [هود: ] قال: «خلق اهل رحمته للجنة لءلا يختلفوا، وخلق اهل الاختلاف لناره»
 
 حدثنا ابو حميد احمد بن محمد بن سيار، ثنا العباس بن الوليد ابو الفضل المبارك، عن الحسن: {ولذلك خلقهم} [هود: ] قال: «خلقهم للاختلاف»
 
  قوله تعالي: {وتمت كلمة ربك لاملان جهنم من الجنة والناس اجمعين} 
 [هود: ]
 
    
 حدثنا ابو سعيد الاشج، وعلي بن حرب الموصلي قالا: ثنا ابن فضيل، ثنا عطاء بن الساءب، عن عون بن عبد الله، عن ابي هريرة قال: قال رسول الله صلي الله عليه وسلم: " اختصمت الجنة والنار، فقالت الجنة: ما لي لا يدخلني الا الضعفاء والمسكين، وقالت النار: ما لي لا يدخلني الا الجبارون، والمتكبرون والاشراف، واصحاب الاموال، فقال الله جل ذكره للجنة انت رحمتي ادخلك من شءت، وقال للنار: انت عذابي اعذب بك من شءت، وكلاهما ساملا "
 
  قوله تعالي: {وكلا نقص عليك من انباء الرسل} [هود: ] الاية بياض
 
  قوله تعالي: {وجاءك في هذه الحق} 
 [هود: ]
 
 حدثنا ابو سعيد الاشج ثنا ابو اسامة، عن ابي عوانة، عن ابي بشير، عن عمرو قال: خطبنا ابن عباس فقرا: {وجاءك في هذه الحق} [هود: ] قال: «هذه السورة»
 
    
 حدثنا ابي، ثنا محمد بن محمد، عن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن الاعمش، عن سعيد بن جبير قال: سمعت ابن عباس يقرا هذه السورة علي المنبر حتي اذا بلغ: {وجاءك في هذه الحق} [هود: ] قال: «في هذه السورة»
 
    
 حدثنا ابي سهل بن عثمان، ثنا عبيدة بن حميد، عن عطاء بن الساءب، عن سعيد بن جبير قوله: {وجاءك في هذه الحق} [هود: ] قال: «وجاءه في هذه السورة الحق»
 
  الوجه الثاني
 
    
 حدثنا ابو سعيد الاشج، ثنا وكيع، عن شعبة قال: سمعت قتادة: {وجاءك في هذه الحق} [هود: ] قال: «الدنيا»
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة: {وجاءك في هذه الحق} [هود: ] قال الحسن: «في الدنيا»
 
  قوله تعالي: {وموعظة} 
 [البقرة: ]
 
    
 حدثنا الحسن بن ابي الربيع، ثنا عبد الرزاق، اخبرني الثوري، عن بيان، عن الشعبي قوله: {وموعظة} [هود: ] قال: «موعظة من الجهل»
 
  قوله تعالي: {وذكري للمءمنين} 
 [الاعراف: ]
 
    
 حدثنا ابي، ثنا هشام بن عمار، ثنا الوليد بن مسلم، ثنا خليد، عن قتادة قال: المءمنين " هم العجاجون بالليل والنهار والله ما زالوا يقولون: ربنا، حتي استجيب لهم " قد تقدم تفسير المءمن غير مرة
 
  قوله تعالي: {علي مكانتكم} 
 [الانعام: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا الحازمي، عن جويبر، عن الضحاك: {اعملوا علي مكانتكم} [هود: ] «علي ناحيتكم»
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن بشر، عن قتادة قوله: {اعملوا علي مكانتكم} [هود: ] «اي منازلكم»
 
  قوله تعالي: {وانتظروا انا منتظرون} 
 [هود: ]
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن الدشتكي، ثنا عبد الله بن ابي جعفر الرازي، عن ابيه، عن الربيع في قوله: {وانتظروا} [هود: ] قال: «خوفهم عذابه، وعقوبته ونقمته»
 
  قوله تعالي: {ولله غيب السموات والارض واليه يرجع الامر كله}
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع بن انس، عن ابي العالية قال: «يرجعون اليه بعد الحياة»
 
  قوله تعالي: {فاعبده وتوكل عليه وما ربك بغافل عما تعملون} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير في قول الله تعالي: (عما يعملون) يعني: «بما يكون»
 
  سورة يوسف 
 اول السورة التي يذكر فيها يوسف عليه الصلاة والسلام، بسم الله الرحمن الرحيم
 
  قوله عز وجل: {الر} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا ابو غسان، ثنا شريك، ثنا عطاء بن الساءب، قال شريك: لا اراه الا، عن ابي الضحي يعني: مسلم بن صبيح، عن ابن عباس: {الر} [يوسف: ] قال: «انا الله، اري» وروي عن الضحاك، مثله
 
  الوجه الثاني:
 
    
 حدثنا علي بن الحسين، ثنا هدبة بن عبد الوهاب، ثنا علي بن الحسين بن واقد، عن ابيه، عن يزيد النحوي، عن عكرمة، عن ابن عباس: {الر} [يوسف: ] : «حروف الرحمن مفرقه» ، فحدثت به الاعمش فقال: «عندك مثل هذا ولا تخبرناه»
 
    
 حدثنا الحجاج بن حمزة، ثنا يحيي بن ادم، ثنا مندل العنزي، عن عطاء بن الساءب، عن سعيد بن جبير، انه قال: " {الر} [يوسف: ] و {حم} [غافر: ] و {ن} [القلم: ] هو الرحمن مقطع ". وروي عن سالم بن عبد الله، مثله
 
  والوجه الثالث:
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة، قال: " {الر} [يوسف: ] اسم من اسماء القران "
 
  والوجه الرابع:
 
    
 حدثنا ابي، ثنا عثمان، ثنا يحيي بن ابي زاءدة، قال ابن جريج: قال مجاهد: " {الر} [يوسف: ] قال: هذا فواتح يفتتح الله بها القران، قال: قلت: الم تكن تقول هي اسماء؟ قال: لا "
 
  قوله تعالي: {تلك ايات} 
 [البقرة: ]
 
    
 حدثنا ابو بكر بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، ثنا اسباط، عن السدي، عن ابي مالك، قوله: {تلك} [يوسف: ] يعني: هذه "
 
  قوله تعالي: {الكتاب} 
 [البقرة: ]
 
    
 حدثنا الحسن بن محمد الصباح، ثنا اسباط بن محمد، عن ابي بكر الهذلي، عن الحسن، في قول الله: " {الكتاب} [يوسف: ] قال: القران " وروي عن عطية، عن ابن عباس، نحو ذلك
 
  قوله تعالي: {المبين} 
 [الماءدة: ]
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، قوله: " {الر تلك ايات الكتاب المبين} [يوسف: ] اي: والله المبين بركته وهداه، ورشده "
 
  قوله تعالي: {انا انزلناه} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا عبد الله بن رجاء، انا عمران ابو العوام القطان، عن قتادة، عن ابي المليح، عن واثلة بن الاسقع: ان النبي صلي الله عليه وسلم قال: «انزل القران لاربع وعشرين خلت من رمضان»
 
  قوله تعالي: {قرانا عربيا} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا عبد الرحيم الرزيقي، ثنا زيد بن الحباب، حدثني سيف بن سليمان، قال: سمعت مجاهدا، يقول: «نزل القران بلسان قريش، وهو كلامهم»
 
  قوله تعالي: {لعلكم تعقلون} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، قوله: " {لعلكم} [يوسف: ] يعني: لكي "
 
  قوله تعالي: {نحن نقص عليك احسن القصص} 
 [يوسف: ]
 
    
 حدثنا ابو يحيي محمد بن سعيد بن غالب العطار، ثنا عمرو بن محمد العنقزي، ثنا خلاد وهو ابن مسلم الصفار، عن عمرو بن قيس الملاءي، عن عمرو بن مرة، عن مصعب بن سعد، عن سعد، قال: " نزل علي رسول الله صلي الله عليه وسلم
  [ص: ]
 القران، فتلاه عليهم زمانا فقالوا: يا رسول الله، لو قصصت علينا، فانزل الله: {الر تلك ايات الكتاب المبين} [يوسف: ] الي قوله: {نحن نقص عليك احسن القصص} [يوسف: ] فتلاه عليهم زمانا "
 
    
 حدثنا ابي، ثنا اسماعيل بن الخليل، ثنا علي بن مسهر، عن عبد الرحمن بن اسحاق، عن خليفة بن قيس، عن خالد بن عرفطة، قال: كنت عند عمر بن الخطاب اذ اتي برجل من عبد القيس، مسكنه بالسوس، فقال له عمر: انت فلان ابن فلان العبدي؟ قال: نعم، قال: وانت النازل بالسوس، فضربه بقناة معه فقال العبدي: ما لي؟ فقرا عليه: {الر تلك ايات الكتاب المبين} [يوسف: ] الي قوله: {وان كنت من قبله لمن الغافلين} [يوسف: ] فقراها عليه ثلاث مرات فضربه ثلاث مرات، ثم قال له عمر: انت الذي انتسخت كتاب دانيال؟ قال: نعم. قال: اذهب فامحه بالحميم والصوف الابيض، ولا تقراه ولا تقرءه احدا من الناس "
 
    
 حدثنا ابي، ثنا محمد بن ابي عمر العدني، ثنا سفيان، عن المسعودي، عن القاسم، قال: " مل اصحاب رسول الله صلي الله عليه وسلم ملة فقالوا: حدثنا يا رسول الله، فانزل الله: {نحن نقص عليك احسن القصص} [يوسف: ] ثم ملوا ملة. فقالوا: يا رسول الله: حدثنا فنزلت: {الله نزل احسن الحديث} [الزمر: ] ثم ملوا ملة، فقالوا: حدثنا يا رسول الله فانزل الله: {الم يان للذين امنوا ان تخشع قلوبهم لذكر الله} [الحديد: ] "
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انا سعيد بن بشير، عن قتادة، قوله: " {نحن نقص عليك احسن القصص} [يوسف: ] قال: في الكتب الماضية وامور الله السالفة في الامم {بما اوحينا اليك هذا القران} [يوسف: ] "
 
  قوله تعالي: {وان كنت من قبله لمن الغافلين} 
 [يوسف: ]
 
    
 وبه، عن قتادة: {وان كنت من قبله لمن الغافلين} [يوسف: ] اي: من قبل هذا القران "
 
  قوله تعالي: {اذ قال يوسف لابيه يا ابت اني رايت احد عشر كوكبا} 
 [يوسف: ]
 
    
 حدثنا احمد بن سنان الواسطي، ثنا ابو احمد الزبيري، ثنا سفيان، عن سماك، عن سعيد بن جبير، عن ابن عباس، قوله: " {اني رايت احد عشر كوكبا} [يوسف: ] قال: كانت رءيا الانبياء وحيا "
 
  قوله تعالي: {احد عشر كوكبا} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، انا سعيد بن بشير، عن قتادة: قوله: " {اذ قال يوسف لابيه يا ابت اني رايت احد عشر كوكبا} [يوسف: ] اي: اخوته. وروي عن السدي مثل ذلك
 
    
 حدثنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن يزيد بن اسلم، في قوله: " {اني رايت احد عشر كوكبا والشمس والقمر رايتهم لي ساجدين} [يوسف: ] قال: ابواه واخوته فبغاه اخوته، وكانوا انبياء، فقالوا: ما رضي ان يسجد له اخوته، حتي سجد له ابواه، حين بلغهم "
 
  قوله تعالي: {والشمس والقمر} 
 [الانعام: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، قوله: " {والشمس والقمر} [يوسف: ] قال: والشمس: يعقوب، والقمر: ام يوسف، راحيل {رايتهم لي ساجدين} [يوسف: ] " وروي، عن السدي مثل ذلك
 
 قال الحسن بن عرفة، ثنا الحكم بن ظهير، عن السدي، عن عبد الرحمن بن سابط، عن جابر بن عبد الله، قال: اتي النبي صلي الله عليه وسلم، رجل من اليهود، يقال له: بستاني، فقال: يا محمد اخبرني عن الكواكب التي راها يوسف انها ساجدة له ما اسماءها؟ فلم يجبه نبي الله صلي الله عليه وسلم بشء، ونزل جبريل عليه السلام فاخبر النبي صلي الله عليه وسلم باسماءها. قال: فبعث النبي صلي الله عليه وسلم الي بستاني، فلما جاء قال له: «هل انت مءمن ان اخبرتك باسماءها؟» قال: نعم. قال: " جربان وطارق والذيال وذو الكتفين وقابس
 
 ودثاب وعمودان والفليق والمصبح والضروح وذو الفرع والضياء والنور، راها ساجدة له في افق السماء، فلما قصها يوسف علي يعقوب، قال يعقوب: هذا امر مشتت يجمعه الله من بعده. قال: يقول بستاني: اي والله هذه لاسماءها "
 
  قوله تعالي: {قال يا بني لا تقصص رءياك علي اخوتك فيكيدوا لك كيدا} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن سليمان بن الاشعث، ثنا الحسين بن علي بن مهران، ثنا عامر بن الفرات، ثنا اسباط، عن السدي، قال: " فكان الغلامان يوسف وبنيامين في حجر يعقوب، احبهما وعطف عليهما ليتمهما من امهما، وكان احب الخلق اليه يوسف، فلما قدموا نحو الشام قال يعقوب لرعاته وغلمانه: ان اتاكم احد يسالكم: من انتم فقولوا: نحن ليعقوب عبد عيصا، فلقيهم عيصا فقال: من انتم؟ فقالوا نحن ليعقوب عبد عيصا، قال: فكف، عن يعقوب، فذلك حين قال: واذ غلبتني علي الدعوة فلا تغلبني علي القبر، فنزل يعقوب الشام فكان ليس له هم الا يوسف واخاه فحسده اخوته مما راوا من حب ابيه له وراي يوسف في النوم رءيا ان {احد عشر كوكبا والشمس والقمر رايتهم لي ساجدين} [يوسف: ] فحدث اباه بها فقال له يعقوب {يا بني لا تقصص رءياك علي اخوتك فيكيدوا لك كيدا} [يوسف: ] فبلغ اخوة يوسف الرءيا فحسدوه "
 
    
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق: يقول الله عز وجل في كتابه، لمحمد، صلي الله عليه وسلم، وهو يذكر له خبر يوسف واخوته: " {اذ قال يوسف لابيه يا ابت اني رايت احد عشر كوكبا} [يوسف: ] الاية، فعرف يعقوب تاويلها، وخشي عليه بغي اخوته فيما عرف من التاويل ان الشمس والقمر والاحد عشر كوكبا ابوه وامه واخوته، فقال: {يا بني لا تقصص رءياك علي اخوتك فيكيدوا لك كيدا ان الشيطان للانسان عدو مبين} [يوسف: ] "
 
    
 حدثنا محمد بن يحيي، انا العباس بن الوليد النرسي، ثنا يزيد بن
  [ص: ]
 زريع، عن سعيد، عن قتادة، قوله: " {ان الشيطان للانسان عدو مبين} [يوسف: ] قال: عادوه، فانه يحق علي كل مسلم عداوته، وعداوته، ان تعاديه بطاعة الله "
 
  قوله تعالي: {وكذلك} 
 [البقرة: ]
 
    
 حدثنا ابو بكر بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، ثنا اسباط، عن السدي، عن ابي مالك، قوله: " {وكذلك} [يوسف: ] يعني: هكذا "
 
  قوله تعالي: {يجتبيك ربك} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد، عن قتادة، قوله: " {وكذلك يجتبيك ربك} [يوسف: ] قال: يصطفيك بتاويل الاحاديث " قال ابو محمد: ليس عند ابي الجماهر
 
    
 حدثنا ابي، ثنا هشام بن خالد، عن شعيب بن اسحاق، عن ابن ابي عروبة، عن قتادة: " {اجتباه} [النحل: ] : اصطفاه "
 
  قوله تعالي: {ويعلمك من تاويل الاحاديث} 
 [يوسف: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {من تاويل الاحاديث} [يوسف: ] قال: عبارة الرءيا "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب، ثنا ابن ابي عروبة، عن قتادة، قوله: " {ويعلمك من تاويل الاحاديث} [يوسف: ] ففعل وعلمه من عبر الاحاديث، وهي: تاويل الاحاديث "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول في قوله تعالي: " {ويعلمك من تاويل الاحاديث} [يوسف: ] قال: تاويل الكلام: العلم والحكم، وكان يوسف اعبر الناس، وقرا: {ولما بلغ اشده اتيناه حكما وعلما} [يوسف: ] "
 
  قوله تعالي: {ويتم نعمته عليك وعلي ال يعقوب} 
 [يوسف: ]
 
 حدثنا يونس بن حبيب، ثنا ابو داود، ثنا حماد، عن داود بن ابي هند، عن سعيد بن جبير، في قوله: " {ويتم نعمته عليك} [يوسف: ] قال: من تمام النعمة، دخول الجنة ان الله لم يتم علي احد نعمه فيدخله النار "
 
  قوله تعالي: {كما اتمها علي ابويك من قبل ابراهيم واسحاق}
 
  قوله تعالي: {ان ربك عليم حكيم} 
 [يوسف: ]
 
    
 حدثنا محمد بن العباس، ثنا زنيج، ثنا سلمة، ثنا محمد بن اسحاق، قوله: " {عليم} [يوسف: ] اي: عليم بما تخفون "
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع بن انس، عن ابي العالية، في قوله: " {حكيم} [يوسف: ] قال: حكيم في امره "
 
    
 حدثنا محمد بن يحيي، انا ابو غسان، ثنا سلمة، ثنا محمد بن اسحاق، قوله: " {حكيم} [يوسف: ] ، في عذره وحجته الي عباده "
 
  قوله تعالي {لقد كان في يوسف واخوته ايات للساءلين} 
 [يوسف: ]
 
    
 ذكر، عن يحيي بن راشد، ثنا صفوان بن عيسي، ثنا عثمان بن سعد، عن الحسن: " {لقد كان في يوسف واخوته ايات للساءلين} [يوسف: ] قال: عبر "
 
  قوله تعالي: {للساءلين} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: " {لقد كان في يوسف واخوته ايات للساءلين} [يوسف: ] يقول: من سال عن ذلك، فهو هكذا ما قص الله عليكم وانباكم به "
 
  قوله تعالي: {اذ قالوا ليوسف واخوه احب الي ابينا منا} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي، قوله: " {اذ قالوا ليوسف واخوه احب الي ابينا منا} [يوسف: ] واخوه: بنيامين "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي الدامغاني، ثنا عمرو بن
  [ص: ]
 حمران، عن سعيد، عن قتادة: " {اذ قالوا ليوسف واخوه} [يوسف: ] يعني: بنيامين، وهو اخو يوسف لابيه وامه "
 
 قوله تعالي: {ونحن عصبة} [يوسف: ]
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: " {ونحن عصبة} [يوسف: ] قال: العصبة: ما بين العشرة الي الاربعين وروي عن ابي المليح مثل ذلك
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي، " {ونحن عصبة} [يوسف: ] قال: كانوا عشرة "
 
  والوجه الثاني
 
    
 حدثنا علي بن الحسين، ثنا عثمان بن ابي شيبة، ثنا سلمة بن الفضل، ثنا حجاج، عن الحكم، قال: " العصبة: اربعون رجلا "
 
  والوجه الثالث:
 
    
 حدثنا علي بن الحسين، ثنا سعيد بن الربيع، ثنا ابو عوانة، عن ابي بشر، عن سعيد بن جبير، قال: " قلت: كم العصبة؟ قال: ستة او سبعة "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله تعالي: " {ونحن عصبة} [يوسف: ] قال: العصبة: الجماعة "
 
  قوله تعالي: {ان ابانا لفي ضلال مبين} 
 [يوسف: ]
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، ثنا اسباط، عن السدي، " {ان ابانا لفي ضلال مبين} [يوسف: ] قالوا: في ضلال من امرنا "
 
  قوله تعالي: {اقتلوا يوسف او اطرحوه} 
 [يوسف: ]
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، ثنا اسباط، عن السدي، في قوله: " {اقتلوا يوسف او اطرحوه ارضا يخل لكم وجه ابيكم وتكونوا من بعده قوما صالحين} [يوسف: ] يقول: تتوبون مما صنعتم به "
 
  قوله تعالي: {قال قاءل منهم لا تقتلوا يوسف} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، قوله: " {قال قاءل منهم لا تقتلوا يوسف} [يوسف: ] قال: كنا نحدث انه روبيل، وهو اكبر اخوته، وهو ابن خالة يوسف "
 
  والوجه الثاني:
 
 حدثنا عبد الله، ثنا الحسين، انا عامر، عن اسباط، عن السدي، " {قال قاءل منهم لا تقتلوا يوسف} [يوسف: ] وهو: يهوذا "
 
  والوجه الثالث:
 
    
 حدثنا ابي، ثنا ابن ابي عمر، ثنا سفيان، عن رجل، عن مجاهد، قال ابي: وفي كتاب غيري، عن ابن جريج، عن مجاهد، " {قال قاءل منهم لا تقتلوا يوسف} [يوسف: ] قال: هو شمعون "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة بن الفضل، قال: قال محمد بن اسحاق: " {قال قاءل منهم لا تقتلوا يوسف} [يوسف: ] فذكروا والله اعلم ان الذي قال ذلك منهم روبيل الاكبر من بني يعقوب، وكان اقصدهم فيه رايا وكل قد عظم فيه جرمه، وكان ايسرهم جرما، وكفي بجرمه جرما لما اجتمعوا عليه من قطيعة الرحم، وعقوق الوالد، وقلة الرافة بالصغير الضرع، الذي لا ذنب له، وبالكبير الفاني ذي الحق والحرمة والفضل عليهم، وخطره عند الله مع حق الوالد علي ولده , ليفرقوا بينه وبين ولده , وحبيبه علي كبر سنه، ورقة عظمه، مع مكانه من الله وبين من احبه طفلا صغيرا علي ضعف قوته، وصغر سنه، وحاجته الي لطف والده، وسكونه اليه يغفر الله لهم، وهو ارحم الراحمين، فقد احتملوا امرا عظيما "
 
  قوله تعالي: {والقوه في غيابة الجب} 
 [يوسف: ]
 
    
 اخبرنا محمد بن سعد، فيما كتب الي، حدثنا ابي، حدثني عمي، حدثني ابي، عن ابيه، عن ابن عباس، في قوله: " {قال قاءل منهم لا تقتلوا يوسف والقوه في غيابة الجب} [يوسف: ] يعني: الركية "
 
 حدثنا علي بن الحسين، ثنا ابو الجماهر، انا سعيد بن بشير، عن قتادة، قوله " {والقوه في غيابة الجب} [يوسف: ] : في بعض نواحيه اسفله "
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة، في قوله: " {في غيابة الجب} [يوسف: ] قال: بءر ببيت المقدس "
 
    
 حدثنا يونس بن عبد الاعلي، انا ابن وهب، اخبرني ابن زيد، قال: «الجب الذي جعل فيه يوسف بحذاء طبرية بينه وبينها اميال»
 
    
 حدثنا ابي، ثنا احمد بن عبد الله بن يونس، ثنا ابو بكر بن عياش، قال: «كان يوسف في الجب ثلاثة ايام»
 
  قوله تعالي: {يلتقطه بعض السيارة} 
 [يوسف: ]
 
  قوله تعالي: {قالوا يا ابانا ما لك لا تامنا علي يوسف وانا له لناصحون} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي: " فلما اجمعوا امرهم علي ذلك، اتوا اباهم فقالوا: {يا ابانا ما لك لا تامنا علي يوسف وانا له لناصحون} [يوسف: ] "
 
  قوله تعالي: {ارسله معنا غدا} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا شيبان، ثنا قزعة بن سويد، عن مطرف الشقري: " ان يعقوب، لما ارسل ابنه مع بنيه قال: اللهم صافحهم بيمين الرحمة "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " فلم يزالوا ياتونه حتي ارسله معهم علي وجل وتخوف، فذكر لي انه لما ارسله معهم دعاه حين ارادوا الذهاب به، فضمه اليه ثم دعا له، وقال: اللهم اجعل دعاءي جنة مما اتخوف عليه "
 
  قوله تعالي: {يرتع ويلعب وانا له لحافظون} 
 [يوسف: ]
 
    
 حدثنا محمد بن عبد الله بن يزيد المقرء، ثنا سفيان، عن ابن جريج، عن مجاهد، في قوله: " {يرتع ويلعب} [يوسف: ] قال: نتحارس ونتكالا، يحفظ بعضنا بعضا وربما قال: يكلا بعضنا بعضا "
 
 حدثنا ابو سعيد الاشج، ثنا عبيد الله، عن اسراءيل، عن ابي يحيي، عن مجاهد: " {يرتع ويلعب} [يوسف: ] قال: ننشط ونلعب "
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة: " {يرتع} [يوسف: ] قال: يسعي ويلهو ". وروي، عن مقاتل بن حيان، قال: يلهو ويلعب
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {ارسله معنا غدا يرتع ويلعب} [يوسف: ] قال: يرعي غنمه، وينظر، ويعقل ويعرف ما يعرف الرجال "
 
  قوله تعالي: {قال اني ليحزنني ان تذهبوا به} [يوسف: ] الي قوله: {غافلون} 
 [الانعام: ]
 
    
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة، قال: قال محمد بن اسحاق: " {قال اني ليحزنني ان تذهبوا به واخاف ان ياكله الذءب وانتم عنه غافلون} [يوسف: ] فلم يزالوا ياتونه حتي ارسله معهم دعاه حين ارادوا الذهاب به فضمه اليه ودعا له "
 
    
 حدثنا ابي، ثنا ابو ذر محمد بن ثابت بن مهران، ثنا عبد الوهاب بن عطاء، عن عمران بن حدير، عن ابي مجلز، قال: " لا ينبغي لاحد ان يلقن ابنه الشر، فان بني يعقوب لم يدروا ان الذءب ياكل الناس، حتي قال لهم ابوهم: اني اخاف ان ياكله الذءب "
 
  قوله تعالي: {قالوا لءن اكله الذءب ونحن عصبة} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: قال: " لن ارسله معكم، اخاف ان ياكله الذءب: {قالوا لءن اكله الذءب ونحن عصبة انا اذا لخاسرون} [يوسف: ] ، فارسله معهم "
 
  قوله تعالي: {فلما ذهبوا به واجمعوا} 
 [يوسف: ]
 
    
 وبه عن السدي، قوله: " {فلما ذهبوا به} [يوسف: ] ، اخرجوه وبه عليهم كرامة
  [ص: ]
 ، فلما خرجوا به الي البرية اظهروا به، فلما اخرجوه، وبه عليهم كرامة، فلما خرجوا به الي البرية، اظهروا له العداوة، فجعل يضربه احدهم فيستغيث بالاخر فيضربه، فجعل لا يري منهم رحيما فضربوه حتي كادوا يقتلونه، فجعل يصيح، يا ابتاه يا يعقوب، لو تعلم ما صنع بابنك بنو الاماء، فلما كادوا ان يقتلوه قال يهوذا: اليس قد اعطيتموني موثقا الا تقتلوه، فانطلقوا به الي الجب ليطرحوا فيه فجعلوا يدلونه في البءر فيتعلق بشفة البءر فربطوا يديه، ونزعوا قميصه، فقال: يا اخوتاه، ذروا علي قميصي اتواري به في الجب، قالوا له: ادع الاحد عشر كوكبا والشمس والقمر يءنسوك، قال: فاني لم ار شيءا فدلوه في البءر، حتي اذا بلغ نصفها القوه ارادة ان يموت فكان في البءر ماء فسقط فيه فلم يضره، ثم اوي الي صخرة في البءر، فقام عليها فجعل يبكي فناداه اخوته فظن انها رحمة ادركتهم، فاجابهم فارادوا ان يرضخوه، بصخرة فقام يهوذا فمنعهم، وقال: قد اعطيتموني موثقا الا تقتلوه، فكان يهوذا ياتيه بالطعام "
 
  قوله تعالي: {واوحينا اليه لتنبءنهم بامرهم هذا وهم لا يشعرون} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد، عن قتادة، قوله: " {واوحينا اليه لتنبءنهم بامرهم هذا} [يوسف: ] قال: اوحي الله اليه وحيا وهو في الجب، فهون ذلك الوحي عليه ما صنع به "
 
    
 حدثنا علي بن الحسين، ثنا يحيي بن خلف، ثنا ابو عاصم، عن عيسي بن ميمون، عن ابن ابي نجيح، عن مجاهد: {واوحينا اليه} [يوسف: ] قال: الي يوسف "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة، " {واوحينا اليه لتنبءنهم بامرهم هذا} [يوسف: ] اتاه الوحي من الله، وهو في البءر بما يريدون ان يفعلوا به: {وهم لا يشعرون} [يوسف: ] بما اطلع الله عليه رسوله من امرهم "
 
    
 ذكره ابي، عن ابي حذيفة، عن شبل، عن ابن ابي نجيح، عن مجاهد، " {واوحينا اليه} [يوسف: ] الي يوسف: لتنبءن اخوتك "
 
  قوله تعالي: {وهم لا يشعرون} 
 [الاعراف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن ابي حماد، ثنا كنانة، ثنا ابراهيم
  [ص: ]
 بن طهمان، عن عياد بن اسحاق، عن ابن الحويرث وهو ابو الحويرث، عن ابن عباس، " {واوحينا اليه لتنبءنهم بامرهم هذا وهم لا يشعرون} [يوسف: ] قال: فلم يعلموا بوحي الله اليه "
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، " {وهم لا يشعرون} [يوسف: ] اي اخوته "
 
  قوله {وجاءوا اباهم عشاء يبكون}
 
    
 ذكر عن ابي سعيد الاشج، قال: سمعت ابا بكر بن عياش، يذكر عن جراد الضبي، قال: انتهيت الي الحسن وهو يقص وهو يقول: «اتو اباهم كذبة اثمة»
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر، عن اسباط، عن السدي، قال: «ثم انهم رجعوا الي ابيهم فاخذوا جديا من الغنم فذبحوه، ونضحوا دمه علي القميص، ثم اقبلوا علي ابيهم عشاء يبكون»
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، قال: قال محمد بن اسحاق: " فلما انطلقت به العير، وعرف اخوته ان قد ذهب به: {جاءوا اباهم عشاء يبكون} "
 
  قوله تعالي {قالوا يا ابانا انا ذهبنا نستبق} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي، قال: " ثم اقبلوا الي ابيهم عشاء يبكون، فلما سمع اصواتهم، فزع وقال: يا بني ما لكم؟ هل اصابكم في غنمكم شء؟ قالوا: لا، قال: فما فعل يوسف؟ {قالوا يا ابانا انا ذهبنا نستبق وتركنا يوسف عند متاعنا فاكله الذءب} [يوسف: ] "
 
  قوله تعالي: {وما انت بمءمن لنا} 
 [يوسف: ]
 
    
 وبه، عن السدي، قوله: " {وما انت بمءمن لنا} [يوسف: ] قال: وما انت بمصدق لنا، ولو كنا صادقين "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، قال: قال محمد بن اسحاق: " {وما انت بمءمن لنا} [يوسف: ] اي: ما انت بمصدقنا {ولو كنا صادقين} [يوسف: ] وان كنا قد صدقنا "
 
  قوله تعالي: {وجاءوا علي قميصه بدم كذب}
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو احمد الزبيري، عن سفيان، عن سماك، عن سعيد بن جبير، عن ابن عباس، في قوله: " {وجاءوا علي قميصه بدم كذب} قال: لو كان اكله السبع لخرق قميصه "
 
    
 حدثنا الحسن بن ابي الربيع، انا عبد الرزاق، عن اسراءيل، عن سماك، عن عكرمة، عن ابن عباس، في قوله: " {بدم كذب} [يوسف: ] قال: كان دم سخلة " وروي عن مجاهد انه قال: سخلة شاة
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، احسبه عن سماك، عن الشعبي، قال: " كانت في قميص يوسف ثلاث ايات، حيث جاءوا بقميصه الي ابيه فقالوا: اكله الذءب، فقال ابوه: لو اكله الذءب لشق قميصه "
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد، عن قتادة، قوله: " {وجاءوا علي قميصه بدم كذب} قال: صادوا ظبيا فذبحوه فلطخوا به القميص، فجعل يقلب القميص فيقول: ما اري به اثر ناب ولا ظفر، ان هذا لسبع رحيم "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر، عن اسباط، عن السدي، قال: " فبكي الشيخ وصاح باعلي صوته ثم قال: اين القميص؟ فجاءوا بقميصه عليه دم كذب فاخذ القميص، فطرحه علي وجهه، ثم بكي حتي خضب وجهه من دم القميص. ثم قال: ان هذا الذءب يا بني لرحيم، فكيف اكل لحمه ولم يخرق قميصه؟ "
 
  قوله تعالي: {قال بل سولت لكم انفسكم امرا} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قوله: " {بل سولت لكم انفسكم امرا} [يوسف: ] قال: امرتكم انفسكم "
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انا سعيد بن بشير، عن قتادة، قوله: {قال بل سولت لكم انفسكم امرا} [يوسف: ] ، اي: زينت لكم انفسكم امرا فصبر جميل "
 
  قوله تعالي: {فصبر جميل} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابن الطباع، ثنا هشيم، عن عبد الرحمن بن يحيي، عن حبان بن ابي جبلة، قال: سءل النبي صلي الله عليه وسلم عن قوله: " {فصبر جميل} [يوسف: ] قال: لا شكوي فيه "
 
    
 حدثنا عمار بن خالد، ثنا محمد بن زيد، عن ورقاء، عن ابن ابي نجيح، عن مجاهد، في قوله: " {فصبر جميل} [يوسف: ] قال: ليس فيه جزع "
 
    
 حدثنا ابي، ثنا ابن الطباع، ثنا ابو خلف الخزاز، عن يونس، عن الحسن، قال: " الصبر الجميل: الذي ليس فوقه جزع الا الي الله "
 
  قوله تعالي: {والله المستعان علي ما تصفون} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، قوله: " {والله المستعان علي ما تصفون} [يوسف: ] اي: تكذبون "
 
    
 حدثنا محمد بن العباس، مولي بني هاشم ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، قوله: " {والله المستعان علي ما تصفون} [يوسف: ] فعرف، يعني: يعقوب ان قد كادوه واستعان الله علي ما يسمع من قولهم لما بلغ كرب ذلك منه، فنزل البلاء بيعقوب علي كبره بفراق حبيبه قد وله عنه، لا يدري احي هو ام ميت؟ ويوسف علي صغره وضعفه بلا ذنب اجرمه الي من صنع ذلك به اكب علي يعقوب حزنه، وانطلق بيوسف في رقه قد انزله البلاء عبدا، وهو حر ابن احرار، قد اسلمه بغي اخوته عليه الي ما هو فيه، وبعين الله ذلك كله يري ويسمع، ولو شاء ان يكف ذلك من بغيهم، عن يوسف في صغره فعل، وعن يعقوب في كبره فعل، ولكنه اراد ان يبتليه لينظر كيف عزمه "
 
  قوله تعالي: {وجاءت سيارة} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، عن عبيد بن سليمان، عن الضحاك، قوله: " {وجاءت سيارة} [يوسف: ] فنزلوا علي الجب والجب: البءر "
 
 حدثنا محمد العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، قال: «فلما انتهوا به الي المكان الذي ارادوا به ما ارادوا، جردوه من قميصه، وهو يناشدهم الله ورحمه وقلة ذنبه فيما بينه وبينهم، فلم تعطفهم عليه عاطفة، وقذفوه في الجب بغلظة وفظاظة، وقلة رافة، ثم قعدوا فيما بلغني ينظرون بقية يومهم ذلك ما هو صانع في الجب، او مصنوع به، اذ اقبلت سيارة من العرب فارسلوا واردهم فادلي دلوه»
 
  قوله تعالي: {فارسلوا واردهم} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا هشام، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة، قوله: " {فارسلوا واردهم} [يوسف: ] يقول: ارسلوا رسولهم "
 
  قوله تعالي: {فادلي دلوه} 
 [يوسف: ]
 
    
 وبه، عن قتادة، قوله: " {فادلي دلوه} [يوسف: ] فلما ادلي دلوه تشبث به الغلام "
 
    
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، عن عبيد بن سليمان، عن الضحاك، قوله: " {فارسلوا واردهم فادلي دلوه} [يوسف: ] فاستقي من الماء، فاستخرج يوسف "
 
  قوله تعالي: {قال يا بشري هذا غلام} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انا بشر بن عمارة، عن ابي روق، في قوله: " {يا بشري} [يوسف: ] فيقول: يا بشارة "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق: ثنا ابن ابي عروبة، عن قتادة، قوله: " {يا بشري هذا غلام} [يوسف: ] فلما ادلي دلوه تشبث به الغلام، فقال: يا بشري هذا غلام، تباشروا به حين استخرجوه، وهي بءر ببيت المقدس، معلوم مكانها "
 
  الوجه الثاني:
 
    
 حدثنا حجاج بن حمزة، ثنا يحيي بن ادم، ثنا قيس، عن السدي، قال: " كان اسم صاحبه: يعني قوله: {يا بشري} [يوسف: ] "
 
 حدثنا عبد الله بن سليمان بن الاشعث، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي، قال: " {فادلي دلوه} [يوسف: ] فتعلق يوسف بالحبل، فخرج، فلما راه صاحب الدلو، دعا رجلا من اصحابه، يقال له بشري، فقال: يا بشري هذا غلام فسمع به اخوة يوسف، فجاءوا فقالوا: هذا عبد لنا ابق ورطنوا له بلسانهم فقالوا: لءن انكرت انك عبد لنا لنقتلنك، اترانا نرجع بك الي يعقوب، وقد اخبرناه ان الذءب قد اكلك؟ قال: يا اخوتاه: ارجعوا بي الي يعقوب فانا اضمن لكم رضاه ولا اذكركم هذا ابدا. فابوا. فقال الغلام: انا عبد لهم "
 
  قوله تعالي: {واسروه بضاعة} 
 [يوسف: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {واسروه بضاعة} [يوسف: ] صاحب الدلو ومن معه فقالوا لاصحابهم: انا استبضعناه خيفة ان يستشركوهم فيه، ان علموا به، واتبعهم اخوته يقولون للمدلي واصحابه: استوثقوا منه، لا يابقن حتي وافوه بمصر، فقال: من يبتاعني ويبشر فاشتراه الملك، والملك مسلم "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو احمد الزبيري، عن سفيان، عن رجل، عن مجاهد: " {واسروه بضاعة} [يوسف: ] قال: اسروه التجار بعضهم عن بعض قالوا: هو بضاعة "
 
    
 حدثنا ابي، ثنا عبيد بن ادم، حدثنا ابي، ثنا شيبان، عن جابر، عن مجاهد، قوله: " {واسروه بضاعة} [يوسف: ] يقول: استبضعوه اهل الماء، وقد باعوه سرا "
 
    
 اخبرنا العباس بن الوليد بن مزيد، قراءة، اخبرني محمد بن شعيب، اخبرني عثمان بن عطاء، عن ابيه، عطاء: واما قوله: " {واسروه بضاعة} [يوسف: ] فدسوه بينهم بيعا سرا "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي: " فلما اشتراه الرجلان فرقا من الرفقة ان يقولا: اشتريناه
  [ص: ]
 فيسالونهما الشركة، فقالوا: تقول ان سالونا: ما هذا؟ نقول: بضاعة استبضعناها من اهل البءر فذلك قوله: {واسروه بضاعة} [يوسف: ] "
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا عبد الرحمن بن ابي الغمر، ثنا مفضل بن فضالة، قال: سالته يعني: ابا صخر عن قوله: " {واسروه بضاعة} [يوسف: ] قال: انهم لما القوه في الجب، بصروا العير قد اقبلت، فلما ارسل اهل العير واردهم، وادلي دلوه احس بالغلام، فنادي اصحابه فلما اتوا، قال لهم اخوة يوسف: هذا الغلام الذي في الجب غلام لنا مملوك، فهل لكم ان تبتاعوه منا؟ واسروا بيعهم بينهم "
 
  قوله تعالي: {والله عليم بما يعملون} 
 [يوسف: ]
 
    
 حدثنا محمد بن العباس، مولي بني هاشم ثنا زنيج، ثنا سلمة، ثنا محمد بن اسحاق: " {عليم} [يوسف: ] اي: علم بما يخفون "
 
  قوله تعالي: {وشروه بثمن بخس} 
 [يوسف: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن ادريس، عن ابيه، عن عطية، عن ابيه: " {وشروه} [يوسف: ] قال: باعوه "
 
    
 حدثنا ابي، ثنا موسي بن اسماعيل، ثنا مبارك، عن الحسن، في قول الله: " {وشروه} [يوسف: ] قال: لم يبعه اخوته انما باعه التجار "
 
  قوله تعالي: {بثمن بخس} 
 [يوسف: ]
 
    
 حدثنا ابو عبد الله الطهراني، انا حفص بن عمر العدني، ثنا الحكم بن ابان، عن عكرمة، في قول الله تعالي: " {وشروه بثمن بخس دراهم معدودة} [يوسف: ] قال: بخس عنق يوسف حين بيع بعشرين درهما " وروي عن ابي صخر نحوه
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن ادريس، عن ابيه، عن عطية: " {بثمن بخس} [يوسف: ] قال: ظلم "
 
    
 حدثنا الاشج، ثنا هانء بن سعيد، عن جويبر، عن الضحاك: " {بخس} [يوسف: ] : الحرام، كان ثمنه حراما "
 
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب، ثنا سعيد بن ابي عروبة، عن قتادة: " {وشروه بثمن بخس} [يوسف: ] يقول: باعوه بثمن ظلم والبخس: هو الظلم، وكان بيع يوسف حراما عليهم بيعه وثمنه "
 
  قوله تعالي: {دراهم معدودة} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن رجاء، انا اسراءيل، عن مسلم، عن مجاهد، عن ابن عباس، في قوله: " {بثمن بخس دراهم معدودة} [يوسف: ] قال: عشرون درهما "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن ادريس، عن عطية: " {معدودة} [البقرة: ] قال: عشرون درهما قال: كانوا عشرة اقتسموا درهمين درهمين "
 
  الوجه الثاني:
 
    
 حدثنا ابو سعيد الاشج، ثنا عقبة بن خالد، عن اسراءيل، عن جابر، عن عكرمة، يعني قوله: " {دراهم معدودة} [يوسف: ] قال: اربعون "
 
  الوجه الثالث:
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {دراهم معدودة} [يوسف: ] اثنان وعشرون درهما لاخوة يوسف احد عشر رجلا، هم باعوه حين اخرجه المدلي دلوه "
 
    
 حدثنا ابي، ثنا عمرو بن محمد الناقد، ومحمد بن ابي عمر العدني، قالا: ثنا سفيان، عن ابن ابي خالد، قال: سمعت السدي يحلف بالله «لما باعوه الا باثنين وعشرين درهما اشتروا به خفافا وثقالا السياق لمحمد »
 
  قوله تعالي: {وكانوا فيه من الزاهدين} 
 [يوسف: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن ادريس، عن ابيه، عن عطية: " {وكانوا فيه من الزاهدين} [يوسف: ] قال: حين باعوه "
 
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، عن عبيد بن سليمان، عن الضحاك يعني قوله: " {وكانوا فيه من الزاهدين} [يوسف: ] فزهدوا فيه فباعوه، وكان بيعه حراما، وباعوه "
 
    
 حدثنا علي بن الحسين، ثنا القاسم بن خليفة الشيعي، ثنا عمرو بن محمد العنقزي، عن ابي روق، عن جويبر، عن الضحاك: " {وكانوا فيه من الزاهدين} [يوسف: ] قال: لم يعلموا بنبوته، ولا بمنزلته من الله "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي: " {وكانوا فيه من الزاهدين} [يوسف: ] قال: كانوا في يوسف من الزاهدين "
 
  قوله تعالي: {وقال الذي اشتراه من مصر لامراته} 
 [يوسف: ]
 
    
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني ابي، ثنا عمي، حدثني ابي، عن ابيه، عن ابن عباس: يعني قوله: " {وقال الذي اشتراه من مصر لامراته} [يوسف: ] قال: وكان اسم الذي اشتراه قطفيير "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، عن ورقاء، عن ابن ابي نجيح، عن مجاهد، قال: " واتبعهم اخوته يقولون للمدلي واصحابه: استوثقوا منه لا يابقن، حتي اوقفوه بمصر، فقال: من يبتاعني ويبشر؟ فاشتراه الملك، والملك مسلم "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قال: «فانطلقوا به الي مصر فاشتراه العزيز ملك مصر، فانطلق به الي بيته»
 
  قوله تعالي: {لامراته} 
 [يوسف: ]
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: «فلما قبضه قطفيير دفعه الي امراته، وكان اسم امراته راعيل بنت رعاءيل»
 
  قوله تعالي: {اكرمي مثواه} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد، عن قتادة: " {اكرمي مثواه} [يوسف: ] : منزلته "
 
  قوله تعالي: {عسي ان ينفعنا او نتخذه ولدا} 
 [يوسف: ]
 
    
 حدثنا احمد بن سنان، ثنا عبد الرحمن بن مهدي، عن سفيان، عن ابي اسحاق، عن ابي عبيدة، عن عبد الله بن مسعود: " افرس الناس ثلاثة: صاحب يوسف حيث قال: {اكرمي مثواه عسي ان ينفعنا او نتخذه ولدا} [يوسف: ] "
 
  قوله تعالي: {وكذلك مكنا ليوسف في الارض} 
 [يوسف: ]
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قوله: " {عسي ان ينفعنا، او نتخذه ولدا} [يوسف: ] يقول الله: {وكذلك مكنا ليوسف في الارض} [يوسف: ] "
 
  قوله تعالي: {ولنعلمه من تاويل الاحاديث} 
 [يوسف: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {من تاويل الاحاديث} [يوسف: ] قال: عبارة الرءيا "
 
  قوله تعالي: {والله غالب علي امره} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا شيخ سعيد البغدادي، ثنا عبد العزيز، عن اسراءيل، عن ابي حصين، عن سعيد بن جبير، في قوله: " {والله غالب علي امره} [يوسف: ] قال: فعال "
 
    
 حدثنا علي بن الحسين، ثنا سعيد، ثنا عبد العزيز، عن رجل، عن مجاهد: " قال: لغة عربية "
 
  قوله تعالي: {ولما بلغ اشده} 
 [يوسف: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبد الله بن ادريس، عن عبد الله بن عثمان، عن مجاهد، عن ابن عباس: " {حتي اذا بلغ اشده} [الاحقاف: ] قال: ثلاثا وثلاثين " وروي عن مجاهد، وقتادة مثله
 
  والوجه الثاني:
 
    
 حدثنا ابي، ثنا سعيد بن سليمان، ثنا هشيم، عن منصور بن زاذان، عن الحسن، في قوله: " {بلغ اشده} [يوسف: ] قال: اربعين سنة "
 
  والوجه الثالث:
 
    
 حدثنا ابو عبد الله الطهراني، انا حفص بن عمر العدني، ثنا الحكم بن ابان، عن عكرمة، في قوله: " {بلغ اشده} [يوسف: ] قال: خمسا وعشرين سنة "
 
  والوجه الرابع:
 
    
 اخبرنا يونس بن عبد الاعلي، قراءة، انا ابن وهب، حدثني يحيي بن ايوب، عن عمرو بن الحارث، عن ربيعة: " {ولما بلغ اشده} [يوسف: ] قال: الاشد: الحلم
    
 قال ابن وهب: وحدثني عبد الرحمن بن زيد بن اسلم، عن ابيه، مثله وقال مالك مثله
 
    
 حدثنا ابي، ثنا عمرو بن رافع، ثنا هشيم، عن مجالد، عن الشعبي، انه قال: " الاشد: الحلم. اذا كتبت له الحسنات، وكتبت عليه السيءات "
 
  الوجه الخامس:
 
    
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي , قوله: " {اشده} [يوسف: ] ، ثلاثين سنة "
 
  والوجه السادس:
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، عن ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، قوله: " {اشده} [يوسف: ] قال: ثماني عشرة سنة "
 
  قوله تعالي: {اتيناه حكما وعلما} 
 [يوسف: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا وكيع، عن اسماعيل بن مسلم، عن عكرمة، قال: الحكم: اللب
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: " {اتيناه حكما وعلما} [يوسف: ] هو الفقه , والعلم، والعقل , قبل النبوة "
 
  الوجه الثاني
 
 حدثنا علي بن الحسين قال: محمد بن العلاء، ثنا يونس بن بكير، عن مطر بن ميمون، عن عكرمة، عن ابن عباس، قال: " الحكم: العلم "
 
  والوجه الثالث:
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد بن طلحة القناد، ثنا اسباط، عن السدي، قوله: " {حكما} [النساء: ] قال: النبوة "
 
  والوجه الرابع:
 
    
 حدثنا ابو سعيد الاشج، ثنا وكيع، عن سفيان، عن رجل، عن مجاهد، قال: «الحكم هو القران»
 
  قوله تعالي {وكذلك نجزي المحسنين} 
 [الانعام: ]
 
    
 حدثنا محمد بن العباس مولي بني هاشم، ثنا عبد الرحمن بن سلمة، عن محمد بن اسحاق: " {ولما بلغ اشده اتيناه حكما وعلما} [يوسف: ] ، اتاه الله حكما وعلما، يقول الله: {وكذلك نجزي المحسنين} [يوسف: ] "
 
  قوله تعالي: {وراودته التي هو في بيتها، عن نفسه} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة، قوله: " {وراودته التي هو في بيتها، عن نفسه} [يوسف: ] وهي امراة العزيز "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي، قوله: " {وراودته التي هو في بيتها، عن نفسه} [يوسف: ] يقول: احبته التي هو في بيتها "
 
    
 حدثنا يونس بن عبد الاعلي، قراءة، انا ابن وهب، حدثني ابن زيد: " {وراودته التي هو في بيتها، عن نفسه} [يوسف: ] حين بلغ مبلغ الرجال "
 
    
 حدثنا محمد بن العباس مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، قال: " وكان اطيفير فيما ذكر لي رجلا لا ياتي النساء، وكانت امراته راعيل امراة حسناء ناعمة طاعمة في ملك ودنيا، وكان الله قد اعطي يوسف من  الحسن والهيءة ما لم يعطه احدا من الناس قبله ولا بعده، وكان يقال والله اعلم : انه اعطي نصف الحسن، وقسم النصف الاخر بين الناس، فراودته التي هو في بيتها، عن نفسه: امراة العزيز "
 
  قوله تعالي: {وغلقت الابواب وقالت هيت لك} 
 [يوسف: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا احمد بن بشير، عن الاعمش، عن اصحابه، عن سعيد بن جبير، عن ابن عباس: " انه كان يقرا كما يقرا عبد الله يعني {هيت لك} [يوسف: ] وهو كقول احدكم لصاحبه: هلم لك "
 
    
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {هيت لك} [يوسف: ] : هلم لك "
 
    
 ذكر، عن سلمة بن سابور، عن عطية، عن ابن عباس: " {هيت لك} [يوسف: ] قال: هلم لك بالقبطية "
 
    
 حدثنا محمد بن عبد الله بن يزيد المقرء، ثنا سفيان، عن ابن جريج، عن مجاهد: " {هيت لك} [يوسف: ] قال: القت نفسها، ودعته الي نفسها، وهي لغة "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: " {هيت لك} [يوسف: ] لغة عربية تدعوه بها "
 
    
 حدثنا الحسن بن ابي الربيع، انا عبد الرزاق، انا الثوري، عن الاعمش، عن ابي واءل، قال: قال عبد الله بن مسعود: " وقد سمعت القراءة، فسمعتهم متقاربين، فاقرءوا كما علمتم، واياكم والتنطع والاختلاف، وانما هو كقول احدكم: هلم، وتعال. ثم قرا عبد الله: {هيت لك} [يوسف: ] قال: فقلت: يا ابا عبد الرحمن ان ناسا يقرءونها (هءت لك) فقال عبد الله: اني ان اقراها كما علمت احب الي "
 
  والوجه الثاني:
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: (هءت لك) قال: تهيات لك، وكان يقرءها مهموزة: (هءت لك) . وروي عن عكرمة مثل ذلك
 
  والوجه الثالث:
 
    
 حدثنا ابي، ثنا ابو معمر المنقري، ثنا عبد الوارث، عن عمرو، عن الحسن، انه قرا: " {هيت لك} [يوسف: ] يقول: عليك عليك. اي: دونك حاجتك "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق: " {وقالت هيت لك} [يوسف: ] اي: تعال فانا لك "
 
  قوله تعالي: {قال معاذ الله انه ربي} 
 [يوسف: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {انه ربي} [يوسف: ] ، سيدي "
 
  قوله: {احسن مثواي} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان بن صالح، ثنا الوليد، ثنا سعيد بن بشير، عن قتادة، في قول الله: " {انه ربي احسن مثواي} [يوسف: ] قال: منزلتي "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق: " {معاذ الله انه ربي احسن مثواي} [يوسف: ] يقول: انه سيدي، قد احسن مثواي وامنني علي بيته، وهذا الذي تدعوني اليه ظلم "
 
  قوله تعالي: {انه لا يفلح الظالمون} 
 [الانعام: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق، يعني قوله: " {انه لا يفلح الظالمون} [الانعام: ] قال: هذا الذي تدعوني اليه ظلم، ولا يفلح من عمل به "
 
  قوله تعالي: {ولقد همت به وهم بها} 
 [يوسف: ]
 
    
 حدثنا محمد بن عبد الله بن يزيد المقرء، ثنا سفيان، عن عثمان بن ابي سليمان، عن ابن ابي مليكة: سءل ابن عباس، عن هم، يوسف فقال: " حل الهميان، وجلس منها مجلس الخاتن فنودي: يا ابن يعقوب اتزني؟ فيكون مثلك مثل طاءر سقط ريشه، فذهب يطير فلم يستطع "
 
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا زهير بن محمد، عن عبد الله بن ابي مليكة، عن ابن عباس، في قول الله: " {ولقد همت به وهم بها لولا ان راي برهان ربه} [يوسف: ] : قال: لما همت به تزينت ثم استلقت علي فراشها، وهم بها وجلس بين رجليها يحل ثيابه، فنودي من السماء يا ابن يعقوب، لا تكن كطاءر نتف ريشه فبقي لا ريش له، فلم يتعظ علي النداء شيءا، اي: لم يفصم، حتي راي برهان ربه، جبريل في صورة يعقوب، عاضا علي اصبعيه ففزع "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن نمير، وابو معاوية، عن الاعمش، عن مجاهد: " {ولقد همت به وهم بها} [يوسف: ] قال: حل سراويله حتي بلغ ثنته، فمثل له يعقوب فضرب في صدره، فخرجت شهوته من انامله "
 
 حدثنا عبد الله بن سليمان بن الاشعث، ثنا الحسين بن علي بن مهران، ثنا عامر بن الفرات، ثنا اسباط، عن السدي قوله: " {ولقد همت به وهم بها} [يوسف: ] فقالت له: يا يوسف، ما احسن شعرك , قال: هو اول ما يتناثر من جسدي. قالت: يا يوسف ما احسن عينيك. قال: هما اول ما يسيلان الي الارض من جسدي، قالت: يا يوسف ما احسن وجهك. قال: هو للتراب ياكله، فلم تزل به حتي اطمعها فهمت به وهم بها ودخل البيت، وغلقت الابواب فذهب يحل سراويله، فاذا هو بصورة يعقوب قاءما في البيت قد عض علي اصبعه يقول: يا يوسف، لا تواقعها "
 
    
 حدثنا محمد بن العباس، مولي بني هاشم ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، قوله: " {ولقد همت به وهم بها} [يوسف: ] فاكبت عليه تطيعه مرة، وتخيفه مرة اخري، وتدعوه الي لذة وهي من حاجة الرجال، في جمالها وحسنها وملكها، وهو شاب مقتبل يجد من شبق الرجال ما يجد الرجال حتي رق لها مما يري من كلفها به، ولم يتخوف منها حتي هم بها وهمت به، حتي دخلوا في بعض بيوته فلما هم وتهيا لذلك راي برهان ربه فانكشف عنها هاربا "
 
  قوله تعالي: {لولا ان راي برهان ربه} 
 [يوسف: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله، عن اسراءيل، عن ابي حصين، عن سعيد بن جبير، عن ابن عباس: " {لولا ان راي برهان ربه} [يوسف: ] قال: مثل له يعقوب فضرب بيده علي صدره، فخرجت شهوته من انامله "
 
 حدثنا احمد بن عصام، ثنا وهب بن جرير، ثنا ابي قال: سمعت ابن ابي مليكة، قال: قيل لابن عباس: " ما بلغ من هم يوسف؟ قال: اطلق تكة سراويله، وقعد منها ذلك المقعد، فمثل له يعقوب في سقف البيت عاضا علي ابهامه، فانتزع الله كل شهوة كانت في جسده فخرج يسعي الي باب البيت "
 
    
 حدثنا ابو زرعة، ثنا منجاب، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قوله: " {لولا ان راي، برهان ربه} [يوسف: ] قال: راي صورة ابيه، يعقوب في وسط البيت عاضا علي ابهامه فادبر هاربا، قال: وحقك يا ابي، لا اعود ابدا "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن علية، عن يونس، عن الحسن: " {لولا ان راي، برهان ربه} [يوسف: ] قال: راي يعقوب عاضا علي اصابعه يقول: يوسف، يوسف "
 
    
 حدثنا ابي، ثنا محمود بن خالد، ثنا عمر بن عبد الواحد، عن الاوزاعي، قال: كان ابن عباس يقول في هذه الاية: " {ولقد همت به وهم بها لولا ان راي برهان ربه} [يوسف: ] قال: راي اية من كتاب الله نهته مثلت له في جدار، وهو البرهان الذي راي "
 
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة، قوله: " {لولا ان راي، برهان ربه} [يوسف: ] : راي اية من ايات ربه حجزه الله بها، عن معصيته "
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا خليد، وسعيد، عن قتادة، قال: " مثل له يعقوب عاضا علي اصبعيه، وهو يقول له: ايا يوسف اتنهم بعمل السفهاء وانت مكتوب في الانبياء؟ فذلك البرهان، فانتزع الله كل شهوة كانت في مفاصله "
 
    
 حدثنا المنذر بن شاذان، ثنا يعلي بن عبيد، ثنا محمد بن عون الخراساني، قال: سالت محمد بن سيرين عن قول الله: " {لولا ان راي برهان ربه} [يوسف: ] قال: مثل له يعقوب عاضا علي اصبعيه يقول: يوسف بن يعقوب بن اسحاق بن ابراهيم خليل الرحمن اسمك في الانبياء، وتعمل عمل السفهاء "
 
 حدثنا ابي، ثنا الحماني، ثنا يحيي بن يمان، عن سفيان، عن علي بن بذيمة، عن عكرمة، وسعيد بن جبير، في قوله: " {لولا ان راي برهان ربه} [يوسف: ] قال: حل السراويل، وجلس منها مجلس الخاتن، فراي صورة فيها وجه يعقوب عاضا علي اصابعه فدفع صدره فخرجت الشهوة من انامله، فكل ولد يعقوب قد ولد له اثنا عشر الا يوسف فانه نقص بتلك الشهوة ولدا "
 
    
 حدثنا ابي، ثنا ابن نفيل الحراني، ثنا يونس بن راشد، عن خصيف، عن مجاهد: " {ولقد همت به وهم بها} [يوسف: ] قال: تمثل له يعقوب، فضرب في صدر يوسف، فطارت شهوته من اطراف انامله، فولد لكل ولد يعقوب اثنا عشر ذكرا غير يوسف لم يولد له الا غلامان "
 
  الوجه الثاني:
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو ابراهيم الاسدي، عن ابي معشر، عن محمد بن كعب: " {لولا ان راي برهان ربه} [يوسف: ] قال: لولا ان راي ما حرم عليه من القران لرجع عليه "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي: " {لولا ان راي برهان ربه} [يوسف: ] فاذا هو بصورة يعقوب قاءم في البيت قد عض علي اصبعه يقول: يا يوسف، لا تواقعها، انما مثلك مثل الطير في جو السماء لا يطاق، ومثلك اذا وقعت عليها مثله اذا مات فوقع علي الارض، لا يستطيع ان يدفع عن نفسه، ومثلك مثل الثور الصعب الذي لم يعمل عليه ومثلك اذا واقعتها مثله اذا مات، فدخل الماء في اصل قرنيه لا يستطيع ان يدفع، عن نفسه فربط سراويله "
 
    
 اخبرنا يونس بن عبد الاعلي، قراءة، انا ابن وهب، اخبرني نافع بن يزيد، عن ابي صخر، قال: سمعت القرظي، يقول في " البرهان الذي راي يوسف
  [ص: ]
 : ثلاث ايات من كتاب الله: {وان عليكم لحافظين كراما كاتبين، يعلمون ما تفعلون.} [الانفطار: ] وقول الله: {وما تكون في شان وما تتلو منه من قران ولا تعملون من عمل الا كنا عليكم شهودا اذ تفيضون فيه} [يونس: ] وقول الله: {افمن هو قاءم علي كل نفس بما كسبت} [الرعد: ] قال نافع: سمعت ابا هلال يقول مثل القرظي، وزاد اية اخري رابعة: {ولا تقربوا الزنا} "
 
  قوله تعالي: {كذلك لنصرف عنه السوء والفحشاء} 
 [يوسف: ]
 
    
 حدثنا الحسن بن عبد العزيز الجروي، ثنا عبد الملك بن بزيع التنيسي، قال: سمعت عبد الرحمن بن يزيد بن جابر، في قوله: " {كذلك لنصرف عنه السوء والفحشاء} [يوسف: ] قال: الزنا، والثناء القبيح "
 
  قوله تعالي: {انه من عبادنا المخلصين} 
 [يوسف: ]
 
    
 حدثنا يونس بن عبد الاعلي، انا ابن وهب، ثنا سفيان الثوري، عن عبد العزيز بن رفيع، عن ابي ثمامة، قال: " قال الحواريون: يا روح الله، اخبرنا من المخلص لله؟ قال: الذي يعمل لله لا يحب ان يحمده الناس "
 
  قوله تعالي: {واستبقا الباب} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا زهير بن محمد، عن عبد الله بن ابي مليكة، عن عبد الله بن عباس، قال: «فلم يتعظ بالنداء، حتي صكه جبريل في صدره، فطارت كل شهوة في راسه، فخرجت من انامله، فوثب الي الباب، فوجده مغلقا، فرفع يوسف رجله، فضرب بها الباب الادني، فانفرج له، فانفرجت له الابواب التي دونه، واتبعته فادركته عند اخر باب منها»
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة: " {واستبقا الباب} [يوسف: ] قال: واستبق هو والمراة الباب "
 
  قوله تعالي: {وقدت قميصه من دبر} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا زهير، عن عبد الله بن ابي مليكة، عن عبد الله بن عباس، في قوله: " {وقدت قميصه من دبر} [يوسف: ] قال
  [ص: ]
 : فوضعت يداها في قميصه، فشقته حتي بلغت عظمة ساقيه، وسقط عنه، وتبعته فالفيا سيدها لدي الباب "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن زكريا، احسبه، عن سماك بن حرب، عن الشعبي، قال: " كان في قميص يوسف ثلاث ايات: حيث سعي نحو الباب، فادركته، فشق قميصه من خلفه، فعرف الملك انه لو كان هو الذي راودها لكان الشق من بين يديه "
 
  قوله تعالي: {والفيا} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا سهل بن عثمان، قال: قال يحيي بن زكريا بن ابي زاءدة: " وفي قراءة عبد الله: ووجدا سيدها، يعني: {والفيا} [يوسف: ]
 
  قوله: {سيدها} 
 [يوسف: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو احمد الزبيري، عن سفيان، عن رجل، عن مجاهد، ح وحدثنا ابو زرعة، ثنا قبيصة، عن سفيان، عن عيسي، عن مجاهد: " {والفيا سيدها لدي الباب} [يوسف: ] قال: سيدها: زوجها "
 
  قوله تعالي: {لدي الباب} 
 [يوسف: ]
 
    
 وبهما، عن مجاهد، قوله: " {لدي الباب} [يوسف: ] قال: عند الباب " وروي عن عكرمة مثل ذلك
 
  قوله تعالي: {قالت ما جزاء من اراد باهلك سوءا الا ان يسجن} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابو كريب، ثنا معاوية بن هشام، عن شيبان بن عبد الرحمن، عن ابي اسحاق، عن نوف، قال: " ما كان يوسف يريد ان يذكره حتي قالت امراة العزيز: {ما جزاء من اراد باهلك سوءا} [يوسف: ] فغضب يوسف وقال: {هي راودتني عن نفسي} [يوسف: ] "
 
  قوله: {او عذاب} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: " {او عذاب} [يوسف: ] يقول: نكال "
 
  قوله تعالي: {اليم} 
 [البقرة: ]
 
    
 حدثنا احمد بن عمرو بن ابي عاصم النبيل، حدثني ابي عمرو بن الضحاك، ثنا ابي، انا شبيب بن بشر، انا بشر، انا عكرمة، عن ابن عباس، في قول الله: " {عذاب اليم} [يوسف: ] قال: كل شء موجع "
 
  قوله تعالي: {قال هي راودتني، عن نفسي} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: " واشتد نحو الباب والفيا سيدها جالسا عند الباب هو وابن عم المراة فلما راته: {قالت: ما جزاء من اراد باهلك سوءا الا ان يسجن او عذاب اليم} [يوسف: ] انه راودني، عن نفسي، فدفعته عني، فشققت قميصه، فقال يوسف: لا بل هي راودتني، عن نفسي فابيت وفررت منها، فادركتني فاخذت بقميصي فشقته علي "
 
  قوله تعالي: {وشهد شاهد من اهلها} 
 [يوسف: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبدة بن سليمان، عن ابي سعد البقال، عن عكرمة، عن ابن عباس: " {وشهد شاهد من اهلها} [يوسف: ] قال: صبي في المهد " وروي، عن الحسن، وسعيد بن جبير، والضحاك نحو ذلك
 
  والوجه الثاني:
 
    
 حدثنا الحسن بن ابي الربيع، انا عبد الرزاق، انا اسراءيل، عن سماك بن حرب، عن عكرمة، عن ابن عباس: " {وشهد شاهد من اهلها} [يوسف: ] قال: ذو لحية " وروي، عن مجاهد انه كان رجلا
 
  الوجه الثالث:
 
    
 حدثنا ابو سعيد الاشج، ثنا المحاربي، عن ليث، عن مجاهد: " {وشهد شاهد من اهلها} [يوسف: ] قال: ليس من الانس "
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا حفص بن غياث، عن ليث
  [ص: ]
 ، عن مجاهد: " {وشهد شاهد من اهلها} [يوسف: ] قال: ليس بانسي ولا جان، هو: خلق من خلق الله "
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، قوله: " {وشهد شاهد من اهلها} [يوسف: ] قال: ذكر لنا انه رجل حكيم من اهلها " وروي عن عكرمة مثل ذلك
 
    
 حدثنا احمد بن الحسين بن عباد البغدادي، ثنا عفان، ثنا عبد الوارث، عن يونس، عن الحسن: " {وشهد شاهد من اهلها} [يوسف: ] . قال: رجل له فهم وعلم "
 
  قوله تعالي: {من اهلها} 
 [النساء: ]
 
    
 حدثنا محمد بن الوزير، ثنا اسحاق بن يوسف الازرق، عن سفيان، عن جابر، عن عبد الله بن ابي مليكة، عن ابن عباس: " {وشهد شاهد من اهلها} [يوسف: ] قال: كان من خاصة الملك "
 
    
 وحدثنا علي بن الحسين، ثنا محمد بن المثني، ثنا ابراهيم بن سليمان، ثنا محمد بن ابان، قال: سالت زيد بن اسلم، عن قوله: " {وشهد شاهد من اهلها} [يوسف: ] قال: ابن عم كان لها حكيما "
 
  قوله تعالي: {ان كان قميصه قد من قبل فصدقت وهو من الكاذبين} 
 [يوسف: ]
 
    
 حدثنا المنذر بن شاذان، ثنا يعلي، ثنا زكريا، عن سماك بن حرب، عن عامر، قال: " كان في قميص يوسف ثلاث ايات: حين قد قميصه من دبر، وحين القي علي وجه ابيه فارتد بصيرا، وحين جاءوا علي قميصه بدم كذب، عرف ان الذءب لو اكله خرق قميصه "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: " {وشهد شاهد من اهلها} [يوسف: ] : رجل حكيم كان من اهلها، فقال: القميص يقضي بينكما، ان كان قميصه قد من قبل، فصدقت وهو من الكاذبين "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة بن
  [ص: ]
 الفضل، عن محمد بن اسحاق: يقال: " ان الشاهد مشيوا، رجل من اهل اطيفير، كان يستعين برايه ويسمع منه الا انه قال: اشهد ان كان قميصه قد من قبل لقد صدقت، وهو من الكاذبين، وذلك ان الرجل انما يريد المراة مقبلا، وذلك ان الرجل لا ياتي المراة مدبرا، وقال: انه لا ينبغي ان يكون في الحق الا ذلك "
 
  قوله تعالي: {وان كان قميصه قد من دبر فكذبت وهو من الصادقين} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي: " فقال ابن عمها: في القميص تبيان الامر، انظروا ان كان قد من قبل، فصدقت وهو من الكاذبين، وان كان قميصه قد من دبر فكذبت وهو من الصادقين، فلما اتي بالقميص وجد قد قد من دبر "
 
  قوله تعالي: {فلما راي قميصه قد من دبر قال انه من كيدكن ان كيدكن عظيم} 
 [يوسف: ]
 
    
 حدثنا محمد بن العباس، مولي بني هاشم ثنا عبد الرحمن بن سلمة، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: " فلما راي اطيفير قميصه قد من دبر عرف انه من كيدها قال: {انه من كيدكن ان كيدكن عظيم} [يوسف: ] "
 
  قوله تعالي: {يوسف اعرض عن هذا} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، قوله: " {يوسف اعرض عن هذا:} [يوسف: ] : الامر والحديث "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انا اصبغ، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {يوسف اعرض عن هذا} [يوسف: ] قال: لا تذكره "
 
  قوله تعالي: {واستغفري لذنبك انك كنت من الخاطءين} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا نصر بن علي، حدثني ابي، عن قرة، عن الحسن، في قوله: " {واستغفري لذنبك انك كنت من الخاطءين} [يوسف: ] قال: حلما "
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انا سعيد بن بشير، عن قتادة
  [ص: ]
 ، قوله: " {واستغفري لذنبك} [يوسف: ] ايتها المراة {انك كنت من الخاطءين} [يوسف: ] "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي: " {واستغفري لذنبك انك كنت من الخاطءين} [يوسف: ] يقول: لا تعودن لذنبك "
 
  قوله تعالي: {وقال نسوة في المدينة امراة العزيز تراود فتاها، عن نفسه} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " وشاع الحديث في القرية، وتحدث النساء بامره وامرها وقلن: {امراة العزيز تراود فتاها عن نفسه} [يوسف: ] اي: عبدها "
 
  قوله تعالي: {قد شغفها حبا} 
 [يوسف: ]
 
    
 ذكر عن اسراءيل، عن سماك بن حرب، عن عكرمة، عن ابن عباس: " {قد شغفها حبا} [يوسف: ] قال: قد علقها حبا " وروي، عن مجاهد، وقتادة نحو ذلك
 
  والوجه الثاني:
 
    
 حدثنا ابو زرعة، ثنا منجاب، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {قد شغفها حبا} [يوسف: ] حب يوسف، قال: الشغف: الحب القاتل، والشغف: حب دون ذلك، والشغاف شغاف القلب: حجاب القلب "
 
    
 حدثنا ابو سعيد الاشج، ثنا اسماعيل ابن علية، عن ابي رجاء، عن الحسن: " {قد شغفها حبا} [يوسف: ] قال: قد بطنها حبا، قال اهل المدينة يقولون: بطنها حبا "
 
    
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا ابو داود، عن ابي وكيع، عن ايوب بن عاءذ، عن الشعبي، في قوله: " {قد شغفها حبا} [يوسف: ] قال: المشغوف: المجنون، والمشغوف: المحب "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، ثنا اسباط، عن السدي، واما: " {شغفها حبا} [يوسف: ] قال: الشغاف جلدة علي القلب , لباس القلب، يقول: ما دخل ذلك الجلد حتي اصاب القلب "
 
    
 حدثنا علي بن الحسين، ثنا احمد بن صالح، قال سفيان في قول الله
  [ص: ]
 : " {قد شغفها حبا} [يوسف: ] قال: الشغاف: جلدة رقيقة تكون علي القلب بيضاء، حبه خرق ذلك الجلد، حتي وصل الي القلب "
 
    
 حدثنا احمد بن منصور المروزي، انا عبد الله بن المبارك، انا معمر، عن يحيي بن المختار، عن الحسن، في قوله: " {قد شغفها حبا} [يوسف: ] قال: رات العلجة خليقة لم تر مثلها حيث غلبت علي عقلها , ابي قلبها ان يدعها، فانطق الله خليقة من خلقه فقال: {ان كان قميصه} [يوسف: ] "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، قال: سمعت عبد الرحمن بن زيد، يقول في قول الله: " {قد شغفها حبا} [يوسف: ] قال: ان الشغف، والشعف مختلفان، فالشعف في البغض، والشغف في الحب "
 
    
 حدثنا ابي، ثنا عبد الصمد بن محمد العباداني، قال: سمعت ابي يقول: " قال رجل ليوسف يعني النبي صلي الله عليه وسلم اني احبك، فقال له يوسف: لا اريد ان يحبني احد غير الله، من حب ابي القيت في الجب، ومن حب امراة العزيز القيت في السجن "
 
  قوله تعالي: {فلما سمعت بمكرهن} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان بن صالح، ثنا الوليد، ثنا سعيد بن بشير، عن قتادة، في قول الله: " {فلما سمعت بمكرهن:} [يوسف: ] : بحديثهن "
 
    
 حدثنا ابي، ثنا ابن ابي عمر، قال سفيان: " {فلما سمعت بمكرهن:} [يوسف: ] قال: بعملهن، وقال: كل مكر في القران فهو عمل "
 
  قوله تعالي: {ارسلت اليهن واعتدت لهن متكا} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قوله: " {واعتدت لهن متكا} [يوسف: ] قال: وهيات لهن متكا "
 
    
 حدثنا ابي، ثنا احمد بن عبد الله بن يونس، ثنا فضيل بن عياض، عن حصين، عن مجاهد، عن ابن عباس، في قوله: " {واعتدت لهن متكا} [يوسف: ] قال: الاترج "
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا يحيي بن يمان، عن المنهال يعني
  [ص: ]
 : ابن خليفة عن سلمة بن تمام يعني ابا عبد الله الشقري، قال: " {متكا} [يوسف: ] بكلام الحبش يسمون الترنج متكا "
 
    
 حدثنا ابي، ثنا ابن عاءشة، وعلي بن عثمان اللاحقي، قالا: ثنا عبد الواحد يعنيان ابن زياد، ثنا ابو روق، قال: سمعت الضحاك، في قوله: " {واعتدت لهن متكا} [يوسف: ] قال: اترنجا بعد الغذاء. والسياق للاحقي "
 
  الوجه الثاني:
 
    
 حدثنا ابو سعيد الاشج، ثنا اسماعيل ابن علية، عن ابي رجاء، عن الحسن: " {واعتدت لهن متكا} [يوسف: ] قال: طعاما " وروي، عن مجاهد، وسعيد بن جبير، والسدي في احدي الروايات، وقتادة في احدي الروايات، مثل ذلك
 
    
 حدثنا ابو سعيد الاشج، قال: قلت لابن ادريس: ذكرت عن ابيك، عن عطية: " {واعتدت لهن متكا} [يوسف: ] قال: طعاما، وشرابا، وتكا، قلت من؟ قال: سمعت ابي يذكره، عن عطية، قلت في قوله ماذا؟ قال: {واعتدت لهن متكا} [يوسف: ] "
 
    
 حدثنا احمد بن سنان، ثنا عبد الرحمن بن مهدي، عن سفيان، عن منصور، عن مجاهد، قال: " من قراها: {متكا} [يوسف: ] اشدها فهو الطعام، ومن قراها: متكا. خففها، فهو الترنج "
 
  والوجه الثالث:
 
    
 حدثنا ابي، ثنا كثير بن عبيد المذحجي، ثنا معاوية بن حفص، عن ابراهيم التيمي يعني: ابراهيم بن الزبرقان، عن ابي سنان، عن الضحاك: " {واعتدت لهن متكا} [يوسف: ] قال: كنا نقول ونحن غلمان هو: البزماورد "
 
    
 حدثنا ابي، ثنا يحيي الحماني، ثنا معاوية بن حفص، عن ابي روق، عن الضحاك: " {واعتدت لهن متكا} [يوسف: ] قال: البرماورد "
 
  الوجه الرابع:
 
    
 حدثنا ابو عبد الله الطهراني، انا حفص العدني، عن الحكم، عن عكرمة، في قوله: " {واعتدت لهن متكا} [يوسف: ] قال: كل شء يقطع بالسكين " وروي، عن عبيد بن سليمان، وعلي بن الحكم، عن الضحاك، مثل ذلك
 
  الوجه الخامس:
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {واعتدت لهن متكا} [يوسف: ] قال: وهيات لهن مجلسا "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر، ثنا اسباط، عن السدي، قوله: " {واعتدت لهن متكا} [يوسف: ] يتكين عليه {واتت كل واحدة منهن سكينا} [يوسف: ] واترنجا ياكلنه "
 
    
 حدثنا ابي، ثنا هشام بن عمار، ثنا الوليد، ثنا سعيد بن بشير، عن قتادة: " {واعتدت لهن متكا} [يوسف: ] قال قتادة: قال ابن عباس: اما سمعتم بقول الاعاجم: سورا "
 
  قوله تعالي: {واتت كل واحدة منهن سكينا} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انا بشر، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {واتت كل واحدة منهن سكينا} [يوسف: ] قال: كانت سنتهم اذا وضعوا الماءدة اعطي كل انسان منهم سكينا ياكل بها "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد، في قول الله: " {واتت كل واحدة منهن سكينا} [يوسف: ] : واعطتهن ترنج وعسلا، فكن يحززن الترنج بالسكين، وياكلن بالعسل "
 
  قوله: {وقالت اخرج عليهن} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انا بشر، عن ابي روق، عن الضحاك، عن ابن عباس: " {وقالت اخرج عليهن} [يوسف: ] قال: فلما خرج عليهن يوسف، اكبرنه "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي: " وقالت ليوسف {اخرج عليهن} [يوسف: ] "
 
    
 حدثنا محمد بن يحيي الواسطي، قال: حدثني محمد بن حسين البرجلاني، ثنا عبيد الله بن محمد التيمي، ثنا دريد بن مجاشع، عن بعض
  [ص: ]
 اشياخه، قال: " {واعتدت لهن متكا واتت كل واحدة منهن سكينا} [يوسف: ] قال: قالت للقيم: ادخله عليهن والبسه ثيابا بيضاء، فان الجميل احسن ما يكون في البياض، قال: فادخله عليهن، وهن يحززن ما في ايديهن، فلما راينه حززن ايديهن وهن لا يشعرن من النظر اليه، فنظرن اليه مقبلا، ثم اومات اليه ان ارجع فنظرن اليه مدبرا، وهن يحززن ايديهن بالسكاكين، لا يشعرن بالوجع من نظرهن اليه، فلما خرج نظرن الي ايديهن، وجاء الوجع فجعلن يولولن، وقالت لهن: انتن من ساعة واحدة هكذا صنعتن فكيف اصنع انا؟ {قلن حاش لله ما هذا بشرا ان هذا الا ملك كريم} [يوسف: ] "
 
  قوله تعالي: {فلما راينه اكبرنه} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا مسلم بن يحيي بن عبد الحميد الدمشقي، ثنا سويد بن عبد العزيز، حدثني عبد الصمد بن علي بن عبد الله بن عباس، عن ابيه، عن جده ابن عباس: " {فلما راينه اكبرنه} [يوسف: ] قال: لما خرج عليهن يوسف حضن من الفرح، وقال الشاعر:
 ناتي النساء لدي اطهارهن ... ولا ناتي النساء اذا اكبرن اكبارا
 
    
 حدثنا يزداد بن عمر الهمذاني، ثنا العلاء بن عبد الملك بن ابي سوية، ثنا عبد الصمد بن علي الهاشمي، عن ابيه، عن جده، في قول الله عز وجل: " {فلما راينه اكبرنه} [يوسف: ] قال: حضن "
 
  والوجه الثاني:
 
    
 حدثنا ابو زرعة، ثنا منجاب، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: " فلما خرج عليهن يوسف: {اكبرنه} [يوسف: ] قال: اعظمنه " وروي عن السدي مثله
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انا اصبغ، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول: " {فلما راينه اكبرنه} [يوسف: ] : اعظمنه وبهتن "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {فلما راينه اكبرنه} [يوسف: ] وغارت عقولهن، عجبا منه حين راينه "
 
  قوله تعالي: {وقطعن ايديهن} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انا بشر، عن ابي روق، عن الضحاك، عن ابن عباس: " فلما خرج عليهن يوسف ونظرن اليه، اقبلن يحززن ايديهن بالسكاكين، قال: فهو قول الله: {وقطعن ايديهن} [يوسف: ] قال: وكن يحسبن انهن يقطعن طعاما "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {وقطعن ايديهن} [يوسف: ] حزا حزا بالسكين "
 
  قوله تعالي: {وقلن حاش لله} 
 [يوسف: ]
 
    
 وبه، عن مجاهد: " {وقلن حاش لله} [يوسف: ] قال: معاذ الله "
 
  قوله: {ما هذا بشرا} 
 [يوسف: ]
 
    
 حدثنا احمد بن منصور المروزي، ثنا عبد الملك الجدي، ثنا سليمان بن المغيرة، انا ثابت، عن انس بن مالك، قال: «اعطي يوسف شطر الحسن»
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو نعيم، عن سفيان، عن منصور، عن مجاهد، عن ربيعة الجرشي، قال: «قسم الحسن نصفين، فجعل ليوسف وسارة النصف، والنصف الاخر لساءر الناس»
 
    
 حدثني ابي، ثنا ابو غسان النهدي، ثنا زهير، ثنا ابو اسحاق، عن ابي الاحوص، عن عبد الله، قال: " اتي يوسف وامه ثلث حسن خلق الناس، في الوجه والبياض، وغير ذلك، قال: فكانت المراة اذا اتته غطي وجهه مخافة ان تفتتن به "
 
    
 حدثنا العباس بن محمد الدوري، ثنا محمد بن الصلت، ثنا اشعث بن سوار، عن ابي اسحاق، عن ابي الاحوص، عن عبد الله، قال: «كان وجه يوسف مثل البرق»
 
    
 حدثنا ابي، ثنا ابو معمر، ثنا عبد الوارث، عن يونس، عن الحسن، قال: «ان الله تعالي قسم الحسن ثلاثة اجزاء فاعطي يوسف الثلث، وقسم الثلثين بين الناس، فكان احسن الناس»
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انا اصبغ، قال: سمعت
  [ص: ]
 عبد الرحمن بن زيد بن اسلم، يقول: في قول الله: " {ما هذا بشرا} [يوسف: ] قال: ما هكذا يكون البشر، فاقرت لهن "
 
  قوله تعالي: {ان هذا الا ملك كريم} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، انا ابو الجماهر، انا سعيد بن بشير، عن غير قتادة: " {ان هذا الا ملك كريم} [يوسف: ] اي: من حسنه "
 
    
 اخبرنا محمد بن حماد الطهراني، فيما كتب الي، انا عبد الرزاق، انا معمر، عن قتادة: " {ان هذا الا ملك كريم} [يوسف: ] قال: قلن من الملاءكة "
 
  قوله تعالي: {قالت فذلكن الذي لمتنني فيه} 
 [يوسف: ]
 
    
 حدثنا محمد بن يحيي، حدثني محمد بن الحسين، ثنا هشام بن عبيد الله الرازي، ثنا يحيي بن العلاء، عن زيد بن اسلم، قال: " {واعتدت لهن متكا} [يوسف: ] قال: لما تغدين، وطابت انفسهن، قالت لقيمها، ايتهن ترنجا وسكاكين، فاتاهن بهن فجعلن يقطعن وياكلن فقالت لهن: هل لكن في النظر الي يوسف؟ قلن ما شءت فامرت قيمها فادخله عليهن، فلما راينه جعلن يقطعن اصابعهن مع الاترنج، وهن لا يشعرن، ولا يجدن الما مما راين من حسنه، فلما ولي عنهن قالت: هذا الذي لمتنني فيه، فلقد رايتكن تقطعن ايديكن وما تشعرن، قال: فنظرن الي ايديهن فجعلن يصحن ويبكين، قالت: فكيف اصنع انا؟ فقلن: {حاش لله ما هذا بشرا، ان هذا الا ملك كريم} [يوسف: ] وما نري عليك من لوم بعد الذي راينا "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، ثنا اسباط، عن السدي: " وقالت ليوسف اخرج عليهن، فلما خرج راي النسوة يوسف، فجعلن يقطعن الاترنج: {قلن حاش لله ما هذا بشرا ان هذا الا ملك كريم قالت فذلكن الذي لمتنني فيه} [يوسف: ] "
 
  قوله تعالي: {ولقد راودته، عن نفسه فاستعصم} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح , عن علي بن ابي طلحة، عن ابن عباس، قوله: " {فاستعصم} [يوسف: ] يقول: فامتنع "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة، قوله: " {فاستعصم} [يوسف: ] اي فاستعصي "
 
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي: " {ولقد راودته، عن نفسه، فاستعصم} [يوسف: ] بعد ما كان قد حل سراويله، ثم لا ادري ما بدا له "
 
  قوله تعالي: {ولءن لم يفعل ما امره ليسجنن وليكونا من الصاغرين} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، عن عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {صاغرين} [الاعراف: ] يعني: مذلين "
 
  قوله تعالي {قال رب السجن احب الي مما يدعونني اليه} 
 [يوسف: ]
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، ثنا اسباط، عن السدي: قال يوسف: " {رب السجن احب الي مما يدعونني اليه} يقول: الحبس احب الي مما يدعونني اليه من الزنا "
 
    
 حدثنا ابي، ثنا ابو الثلج، ثنا سنيد، قال: قال ابن عيينة: " انما يوفق من الدعاء للمقدور، اما تري يوسف، قال: {رب السجن احب الي} [يوسف: ] فلما قال: {اذكرني عند ربك} [يوسف: ] اتاه جبريل فكشف له، عن الصخرة، فقال: ما تري؟ قال: اري نملة تقضم، قال: يقول: انا لم انس هذه انساك؟ انا حبستك، انت قلت: {رب السجن احب الي} [يوسف: ] لاطيلن حبسك "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق: " {وليكونا من الصاغرين} [يوسف: ] قال: يوسف اضاف الي ربه واستعانه علي ما نزل به: {رب السجن احب الي مما يدعونني اليه} [يوسف: ] اي: السجن احب الي من ان اتي ما تكره "
 
  قوله تعالي: {والا تصرف عني كيدهن} 
 [يوسف: ]
 
    
 وبه، عن اسحاق: " {والا تصرف عني كيدهن} [يوسف: ] اي: ما اتخوف منهن "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انا اصبغ، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول، في قوله: " {والا تصرف عني كيدهن} [يوسف: ] الا يكن منك انت القوي والمنعة، لا يكن مني ولا عندي "
 
  قوله: {اصب اليهن} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: " {اصب اليهن} [يوسف: ] يقول: اتبعهن "
 
  قوله: {واكن من الجاهلين} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، قوله: " {اصب اليهن واكن من الجاهلين} [يوسف: ] اي: جاهلا اذا ركبت معصيتك "
 
  قوله: {فاستجاب له ربه فصرف عنه كيدهن} 
 [يوسف: ]
 
    
 وبه، عن ابن اسحاق، قوله: " {فاستجاب له ربه فصرف عنه كيدهن} [يوسف: ] اي: نجاه من ان يركب المعصية فيهن، وقد نزل به بعض ما حذر منه "
 
  قوله: {انه هو السميع العليم} 
 [الانفال: ]
 
    
 وبه، عن ابن اسحاق: " {السميع} [يوسف: ] اي: سميع ما يقولون: {العليم} [يوسف: ] اي: عليم بما يخفون "
 
  قوله: {ثم بدا لهم من بعد ما راوا الايات} 
 [يوسف: ]
 
    
 حدثنا ابو سعيد عبد الله بن سعيد الكندي الاشج، ثنا عقبة بن خالد، عن اسراءيل، عن جابر، عن عكرمة، قال: سالت ابن عباس، عن قوله: " {ثم بدا لهم من بعد ما راوا الايات} [يوسف: ] قال: ما سالني عنها احد قبلك من الايات: قد القميص، واثر السكين، وقالت امراة العزيز: ان انت لم تسجنه ليصدقنه الناس "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن النضر بن عربي، عن عكرمة: " {ثم بدا لهم من بعد ما راوا الايات} [يوسف: ] قال: شق القميص وخمش الوجوه "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قال: " ثم ان المراة قالت لزوجها، ان العبد العبراني، قد فضحني في الناس، انه يعتذر اليهم ويخبرهم اني راودته، عن نفسه، ولست اطيق ان اعتذر بعذري، فاما ان تاذن لي فاخرج فاعتذر كما يعتذر، واما ان تحبسه كما حبستني، فذلك قوله: {ثم بدا لهم من بعد ما راوا الايات} [يوسف: ] وهو: شق القميص، وقطع الايدي "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، قال: سمعت عبد الرحمن بن زيد، يقول في قوله تعالي: " {من بعد ما راوا الايات} [يوسف: ] : ما قال المرضع في العرصة "
 
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق: " {ثم بدا لهم من بعد ما راوا الايات} [يوسف: ] : المبينة لبراءته مما اتهم به من شق قميصه من دبره، وغيره "
 
  قوله تعالي: {ليسجننه} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا منصور بن ابي مزاحم، ثنا ابو سعيد بن ابي الوضاح، عن خصيف، عن عكرمة، عن ابن عباس، قال: «عوقب يوسف ثلاث مرات اما اول مرة فبالحبس، لما كان من همه بها»
 
    
 اخبرنا ابو عبد الله الطهراني، فيما كتب الي، ثنا اسماعيل بن عبد الكريم الصنعاني، حدثني عبد الصمد بن معقل بن اخي، وهب بن منبه، قال: سمعت عمي وهب بن منبه يقول: " لما اتي جبريل يوسف بالبشري، وهو في السجن، قال: هل تعرفني ايها الصديق؟ قال: اري صورة طاهرة وروحا طيبا، لا يشبه ارواح الخطاءين، قال: فاني رسول رب العالمين، وانا الروح الامين، قال: فما الذي ادخلك مدخل المذنبين وانت اطيب الطيبين، وراس المقربين، وامين رب العالمين؟ قال: الم تعلم يا يوسف ان الله يطهر البيوت بطهر النبيين، وان الارض التي يدخلونها هي اطهر الارضين، وان الله قد طهر بك السجن وما حوله، يا طاهر الطاهرين ويا ابن المتطهرين , انما يتطهر بفضل طهورك وطهر اباءك المخلصين، قال: كيف تسميني باسماء الصديقين، وتعدني مع المخلصين الصالحين، وقد ادخلت مدخل المذنبين، وسميت بالضالين المفسدين؟ قال: لم يفتن قلبك الحزن، ولم يدرس حرمتك الرق، ولم تطع سيدتك في معصية ربك، ولذلك سماك الله باسماء الصديقين، وعدك مع المخلصين والحقك باباءك الصالحين "
 
  قوله تعالي: {حتي حين} 
 [يوسف: ]
 
    
 حدثنا احمد بن سنان، ثنا ابو معاوية، ثنا الاعمش، عن ابي ظبيان، عن ابن عباس، قال: «الحين قد يكون غدوة وعشية»
 
  الوجه الثاني:
 
    
 حدثنا ابو سعيد الاشج، ثنا وكيع، عن ابي مكين، عن عكرمة، قال: " نذر
  [ص: ]
 رجل ان يقطع يد غلامه، ويحبسه حينا، فسالني عمر بن عبد العزيز عنها فقلت: لا تقطع يده، ويحبسه الحين في سنة مرة، ثم قرا: {ليسجننه حتي حين} [يوسف: ] "
 
  الوجه الثالث:
 
    
 حدثنا ابو سعيد الاشج، ثنا وكيع، عن سفيان، عن ابن الاصبهاني، عن عكرمة، وطارق، عن سعيد بن جبير، قالا: " الحين: ستة اشهر "
 
  الوجه الرابع:
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا علي بن مسهر، عن عاصم، عن عكرمة، في قوله: " {حتي حين} [يوسف: ] قال: سبع سنين "
 
  الوجه الخامس:
 
    
 حدثنا عبد الله بن احمد الرازي، حدثني ابي، عن ابيه، عن ابراهيم الصايغ، عن يزيد النحوي، قال: وسالته، يعني عكرمة عن رجل، نذر ليسجنن غلامه حينا فان لم يسجنه حينا فهو عتيق؟ فقال عكرمة: " ان من الاحيان حينا يدرك وحينا لا يدرك فاما الحين الذي لا يدرك قال الله تعالي: {ليسجننه حتي حين} [يوسف: ] "
 
  قوله تعالي: {ودخل معه السجن فتيان} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد بن بشير، ثنا قتادة، عن سعيد بن جبير، عن ابن عباس، في قول الله عز وجل: " {ودخل معه السجن فتيان} [يوسف: ] احدهما خازن الملك علي طعامه، والاخر ساقي الملك علي شرابه "
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، عن عزرة، عن ابن جبير، عن ابن عباس، مثله
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة: " {ودخل معه السجن فتيان} [يوسف: ] قال: كان احدهما: خباز الملك علي طعامه، والاخر: ساقيه علي شرابه "
 
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي، قوله: " {ودخل معه السجن فتيان} [يوسف: ] غضب الملك علي خبازه، بلغه انه سمه فحبسه، وحبس الساقي، وظن انه مالاه علي السم، فذلك قوله: {ودخل معه السجن فتيان} [يوسف: ] "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق: " {ودخل معه السجن فتيان} [يوسف: ] : غلامان كانا للملك الاكبر: الريان بن الوليد، كان احدهما علي شرابه، والاخر علي بعض امره، في سخطة سخطها عليهما، اسم احدهما مجلث، والاخر: نبو، ونبو الذي كان علي الشراب، فلما راياه قالا: يا فتي، والله لقد احببناك حين رايناك "
 
 قال ابن اسحاق: فحدثني عبد الله بن ابي نجيح، عن مجاهد: " ان يوسف قال لهما حين قالا ذلك: انشدكما الله، الا تحباني، فوالله ما احبني احد قط الا دخل علي من حبه بلاء، لقد احبتني عمتي فدخل علي من حبها بلاء، ثم لقد احبني ابي فدخل علي بحبه بلاء، ثم لقد احبتني زوجة صاحبي هذا فدخل علي بحبها اياي بلاء، فلا تحباني بارك الله فيكما، فابيا الا حبه والفه حيث كان، وجعل يعجبهما ما يريان من فهمه وعقله "
 
  قوله تعالي: {قال احدهما اني اراني اعصر خمرا} 
 [يوسف: ]
 
    
 حدثنا احمد بن سنان، ثنا يزيد بن هارون، انا شريك، عن الاعمش، عن زيد بن وهب قال: قرا عبد الله: قال: اني اراني اعصر عنبا
 
    
 اخبرنا ابو الازهر احمد بن الازهر فيما كتب الي، ثنا وهب بن جرير، ثنا ابي، عن علي بن الحكم، عن الضحاك: " {قال احدهما اني اراني اعصر خمرا} [يوسف: ] فالخمر: العنب، وانما يسمي اهل عمان العنب: الخمر "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق، عن ابن ابي نجيح، عن مجاهد: «وقد كانا رايا حين ادخلا السجن رءيا فراي مجلث انه يحمل فوق راسه خبزا ياكل الطير منه، وراي نبو انه يعصر خمرا فاستفتياه فيهما»
 
  قوله تعالي: {وقال الاخر اني اراني احمل فوق راسي خبزا تاكل الطير منه} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي، قال: " وغضب يعني الملك علي خبازه، فبلغه انه سمه فحبسه، وحبس الساقي، وظن انه مالاه علي السم فذلك قوله: {ودخل معه السجن فتيان} [يوسف: ] ، قال يوسف: اني اعبر الاحلام، فقال احد الفتيين: هلم فلنجرب قول هذا العبد العبراني، فتراءيا من غير ان يكونا رايا شيءا ولكنهما خرصا، فعبر لهما يوسف خرصهما فقال الساقي: رايت اني اعصر خمرا، وقال الخباز: رايت اني احمل فوق راسي خبزا تاكل الطير منه "
 
    
 حدثنا محمد بن يحيي، انا عبيد الله بن معاذ، ثنا معتمر، عن ابيه، عن ابي مجلز، قال: " كان احد الذين قصا علي يوسف الرءيا كاذبا، قلت له: فالمصلوب هو الكاذب؟ قال: نعم "
 
  قوله تعالي: {نبءنا بتاويله انا نراك من المحسنين} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق، عن عبد الله بن ابي نجيح، عن مجاهد، قال: " فراي مجلث انه يحمل فوق راسه خبزا تاكل الطير منه، وراي نبو انه يعصر خمرا، فاستفتياه فيها وقالا له: {نبءنا بتاويله انا نراك من المحسنين} [يوسف: ] ان فعلت "
 
    
 حدثنا ابي، ثنا ابراهيم بن زياد الخياط، ثنا خلف بن خليفة، ثنا سلمة بن نبيط، قال: كنت جالسا عند الضحاك بن مزاحم بخراسان اذ جاءه رجل فساله، عن قول الله: " {نبءنا بتاويله انا نراك من المحسنين} [يوسف: ] ما كان احسانه؟ قال: كان يوسف اذا مرض انسان في السجن قام عليه، واذا ضاق عليه المكان اوسع له واذا احتاج سال او جمع له "
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة، قوله: " {انا نراك من المحسنين} [يوسف: ] قال: كان احسانه فيما ذكر لنا انه كان يعزي حزينهم، ويداوي مريضهم، وراوا منه عبادة واجتهادا، فاحبوه علي حظه "
 
  قوله تعالي: {قال لا ياتيكما طعام ترزقانه الا نباتكما بتاويله قبل ان ياتيكما} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن العلاء، ثنا محمد بن يزيد، شيخ له، ثنا رشدين، عن الحسن بن ثوبان، عن عكرمة، عن ابن عباس، قال: " ما ادري لعل يوسف كان يعتاف، وهو كذلك لاني اجد في كتاب الله عز وجل حين قال للرجلين: {لا ياتيكما طعام ترزقانه الا نباتكما بتاويله} [يوسف: ] قال: اذا جاءه الطعام حلوا ومرا اعتاف عند ذلك، وقال: انما علم فعلم "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق، عن عبد الله بن ابي نجيح، عن مجاهد: " فقال لهما، لمجلث ولنبوا: {لا ياتيكما طعام ترزقانه} [يوسف: ] يقول في نومكما: {الا نباتكما بتاويله قبل ان ياتيكما} [يوسف: ] "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي، " قال يوسف: {لا ياتيكما طعام ترزقانه} [يوسف: ] في النوم الا نباتكما بتاويله في اليقظة "
 
  قوله: {ذلكما مما علمني ربي اني تركت ملة قوم لا يءمنون بالله} 
 [يوسف: ]
 
    
 حدثنا موسي بن ابي موسي الانصاري، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك، قوله: " {ذلكما} [يوسف: ] يعني: هذا "
 
  قوله تعالي: {واتبعت ملة اباءي ابراهيم واسحاق ويعقوب}
 
    
 حدثنا ابي، ثنا موسي بن اسماعيل، ثنا حماد بن سلمة، عن محمد بن عمرو، عن ابي سلمة، عن ابي هريرة، قال: قال رسول الله صلي الله عليه وسلم: " ان الكريم بن الكريم بن الكريم: يوسف بن يعقوب بن اسحاق بن ابراهيم "
 
    
 حدثنا احمد بن سنان، ثنا ابو معاوية، عن حجاج، عن عطاء، عن ابن
  [ص: ]
 عباس، انه كان يجعل الجد ابا ويقول: " والله لمن شاء لاعناه عند الحجر ما ذكر الله جدا ولا جدة، قال الله: {واتبعت ملة اباءي ابراهيم واسحاق ويعقوب} "
 
    
 حدثنا يونس بن حبيب، ثنا ابو داود الطيالسي، ثنا شعبة، عن ابي اسحاق، سمع ابا الاحوص، يقول: " فاخر اسماء بن خارجة الفزاري رجلا فقال: انا ابن الاشياخ الكرام، فقال عبد الله بن مسعود: ذاك يوسف بن يعقوب بن اسحاق ذبيح الله بن ابراهيم خليل الله "
 
  قوله تعالي: {ذلك من فضل الله علينا} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: وقول يوسف: " {ذلك من فضل الله علينا} [يوسف: ] يقول: ان بعثنا انبياء "
 
  قوله تعالي: {وعلي الناس} 
 [يوسف: ]
 
    
 وبه، عن ابن عباس، قوله: " {وعلي الناس} [يوسف: ] ان بعثنا اليهم رسلا "
 
  قوله تعالي: {ولكن اكثر الناس لا يشكرون} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: «ذلك من فضل الله علينا وعلي الناس ولكن اكثر الناس لا يشكرون وان المءمن ليشكر نعم الله عليه، وعلي خلقه» . وروي عن قتادة، قال: ذكر لنا ان ابا الدرداء كان يقول: «يا رب شاكر نعمة غير منعم عليه لا يدري، ويا رب حامل فقه غير فقيه»
 
  قوله تعالي: {يا صاحبي السجن} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابو الجماهر محمد بن عثمان الدمشقي، ثنا سعيد بن بشير، عن قتادة، عن عزرة، عن سعيد بن جبير، عن ابن عباس: " {يا صاحبي السجن} [يوسف: ] قال: كان احدهما ساقي الملك، والاخر خبازه علي طعامه "
 
  قوله تعالي: {اارباب متفرقون خير ام الله الواحد القهار} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن
  [ص: ]
 اسحاق، عن عبد الله بن ابي نجيح، عن مجاهد، قال: " دعاهما الي الله والي الاسلام، فقال: {يا صاحبي السجن اارباب متفرقون خير ام الله الواحد القهار} [يوسف: ] . اي: خير ان تعبدوا الها واحدا، ام الهة متفرقة لا تغني عنكم شيءا {ما تعبدون من دونه} [يوسف: ] "
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة، قوله: " {اارباب متفرقون خير} [يوسف: ] الي قوله: {لا يعلمون} [يوسف: ] لما عرف نبي الله صلي الله عليه وسلم ان احدهما مقتول؛ دعاهما الي حظهما والي نصيبهما من اخرتهما ونصح لهما "
 
  قوله: {ما تعبدون من دونه الا اسماء} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابو غسان مالك بن اسماعيل، ثنا سفيان بن عيينة، عن عمرو، عن عكرمة، عن ابن عباس، قال: «كل سلطان في القران حجة» وروي عن ابي مالك، وعكرمة، وسعيد بن جبير، ومحمد بن كعب، والضحاك، والسدي، والنضر بن عربي، مثله
 
  قوله تعالي: {ان الحكم الا لله امر الا تعبدوا الا اياه} 
 [يوسف: ]
 
    
 حدثنا احمد بن عبد الرحمن الدشتكي، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع، عن ابي العالية، قوله: " {ان الحكم الا لله امر الا تعبدوا الا اياه} [يوسف: ] قال: اسس الدين علي الاخلاص لله وحده لا شريك له "
 
  قوله تعالي {ذلك الدين القيم} 
 [التوبة: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {ذلك الدين القيم} [يوسف: ] : ذلك القضاء القيم "
 
  والوجه الثاني:
 
    
 قرات علي محمد بن الفضل بن موسي، ثنا محمد بن علي بن الحسن بن شقيق، ثنا محمد بن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان: " {ذلك الدين القيم} [يوسف: ] يقول: ذلك الحساب القيم "
 
  والوجه الثالث:
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا الوليد، ثنا عمر بن محمد، عن زيد بن اسلم، في قوله: " {الدين القيم} [يوسف: ] قال: الحمد لله رب العالمين "
 
  قوله تعالي: {القيم} 
 [التوبة: ]
 
    
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي، قوله: " {ذلك الدين القيم} [يوسف: ] قال: المستقيم "
 
    
 قرات علي محمد بن الفضل، ثنا محمد، ثنا محمد، ثنا بكير، عن مقاتل بن حيان: " {الدين القيم} [يوسف: ] : الحساب البين "
 
  قوله تعالي: {ولكن اكثر الناس لا يعلمون} 
 [الاعراف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن العلاء، ثنا عثمان بن سعيد الزيات، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: " {ولكن اكثر الناس لا يعلمون} [يوسف: ] يقول: لا يعقلون "
 
  قوله تعالي: {يا صاحبي السجن اما احدكما فيسقي ربه خمرا واما الاخر فيصلب} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق، عن عبد الله بن ابي نجيح، عن مجاهد: " ثم قال لمجلث: اما انت فتصلب فتاكل الطير من راسك، وقال لنبو: اما انت فترد علي عملك، يرضي عنك صاحبك {قضي الامر الذي فيه تستفتيان} [يوسف: ] "
 
    
 حدثنا علي بن الحسين، ثنا اسحاق بن ابراهيم، حدثني هشام بن يوسف، ثنا ابن جريج: {لا ياتيكما طعام ترزقانه} [يوسف: ] زعم محمد بن عباس قال: " كره العبارة لهما، فغدا، فقال: {لا ياتيكما طعام} [يوسف: ] فلم يدعاه استعبراه، فكره العبارة لما وعد فقال: {يا صاحبي السجن اارباب متفرقون خير} [يوسف: ] حتي {يعلمون} [يوسف: ] فلم يدعاه استعبراه، فعبر لهما يا صاحبي السجن {لا ياتيكما طعام} [يوسف: ] زادهما هذا ولم يسالاه عنه، لان يعلما ان عنده علما، وكان الملك اذا اراد قتل احد ارسل اليه بطعام، ولا يرسل به الي احد الا وهو يريد ان يقتله "
 
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: " {يا صاحبي السجن اما احدكما فيسقي ربه خمرا} [يوسف: ] فيعاد علي مكانه: {واما الاخر فيصلب فتاكل الطير من راسه} [يوسف: ] ففزعا، وقالا: مما عبر؟ والله ما راينا شيءا، قال يوسف: {قضي الامر الذي فيه تستفتيان} [يوسف: ] "
 
  قوله تعالي: {قضي الامر الذي فيه تستفتيان} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا شيبان بن عبد الرحمن، ثنا الاعمش، عن عمرو بن مرة، عن ابي عبيدة، عن عبد الله بن مسعود، قال: " لما قصا علي يوسف، فاخبرهما قالا: انا لم نر شيءا، قال: {قضي الامر الذي فيه تستفتيان} [يوسف: ] يقول: وقعت العبارة "
 
    
 حدثنا ابي، ثنا نعيم بن حماد، وعلي بن جعفر بن زياد الاحمر، قالا: ثنا محمد بن فضيل، عن عمارة بن القعقاع، عن ابراهيم، عن علقمة، عن عبد الله، انه قال في الفتيين اللذين اتيا يوسف في الرءيا: " انما كذبا ليجرباه فلما اول رءياهما، قالا: انا كنا نلعب، فقال: {قضي الامر الذي فيه تستفتيان} [يوسف: ] "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، ثنا اسباط، عن السدي، قال يوسف: " {قضي الامر الذي فيه تستفتيان} [يوسف: ] ان هذا كاءن لابد منه "
 
  قوله تعالي: {وقال للذي ظن انه ناج منهما اذكرني عند ربك} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا مسدد، ثنا خالد بن عبد الله، عن محمد بن عمرو، عن ابي سلمة، عن ابي هريرة، قال: قال رسول الله صلي الله عليه وسلم: " يرحم الله يوسف، لولا الكلمة التي قالها: {اذكرني عند ربك} [يوسف: ] ما لبث في السجن ما لبث "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن علية، عن يونس، عن الحسن، قال: قال نبي الله صلي الله عليه وسلم: «رحم الله يوسف، لولا كلمته ما لبث في السجن طول ما لبث» ، قال: ثم يبكي الحسن، ويقول: اذا نزل بنا امر فزعنا الي الناس
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {اذكرني عند ربك} [يوسف: ] للذي نجا من صاحبي السجن، يوسف يقول: اذكرني للملك، فلم يذكره حتي راي الملك الرءيا "
 
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق، عن عبد الله بن ابي نجيح، عن مجاهد: " {اذكرني عند ربك} [يوسف: ] اي: الملك الاعظم، مظلمتي وحبسي في غير شء، قال: افعل "
 
    
 حدثنا ابو زرعة، ثنا عبد السلام بن مطهر، ثنا جعفر بن سليمان، عن بسطام بن مسلم، عن مالك بن دينار، عن الحسن، قال: " لما قال يوسف للساقي: {اذكرني عند ربك} [يوسف: ] قيل له يا يوسف، اتخذت من دوني وكيلا؟ لاطيلن حبسك، فبكي يوسف وقال: «يا رب انسي قلبي من كثرة البلوي فقلت كلمة فويل لاخوتي»
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين، ثنا عامر، ثنا اسباط، عن السدي: " وقال، يوسف للساقي: {اذكرني عند ربك} [يوسف: ] يعني قوله: {وقال للذي ظن انه ناج منهما} [يوسف: ] "
 
  قوله: {فانساه الشيطان ذكر ربه} 
 [يوسف: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {فانساه الشيطان ذكر ربه} [يوسف: ] وذلك ان يوسف: {انساه الشيطان ذكر ربه} وامره بذكر الملك وابتغاء الفرج من عنده فلبث في السجن بضع سنين "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق، عن عبد الله بن ابي نجيح، عن مجاهد، قال: «فلما خرج الساقي رد علي ما كان عليه، ورضي عنه صاحبه، وانساه الشيطان ذكر الملك الذي امره يوسف ان يذكره له، فلبث يوسف بعد ذلك في السجن بضع سنين»
 
  قوله: {فلبث في السجن بضع سنين} 
 [يوسف: ]
 
    
 حدثنا ابي وابو زرعة، قالا: ثنا محمد بن ابي بكر المقدمي، ثنا سلام بن ابي الصهباء، ثنا ثابت، عن انس، قال: " اوحي الي يوسف، يا يوسف، من استنقذك من الجب اذ القوك فيه؟ قال: انت يا رب، قال: من استنقذك من القتل اذ هم اخوتك ان يقتلوك؟ قال: انت يا رب، قال: فما لك نسيتني وذكرت ادميا؟ قال: جزعا
  [ص: ]
 بذنبي، وكلمة تكلم بها لساني، وقال: وعزتي لاخلدنك السجن بضع سنين "، قال: فلبث فيه سبع سنين " وروي عن الثوري مثل ذلك
 
    
 حدثنا ابي، ثنا منصور بن ابي مزاحم، ثنا ابو سعيد بن ابي الوضاح، عن خصيف، عن عكرمة، عن ابن عباس، قال: " عوقب يوسف ثلاث مرات، الثانية: فلقوله: {اذكرني عند ربك} [يوسف: ] : {فلبث في السجن بضع سنين} [يوسف: ] عوقب بطول الحبس "
 
    
 حدثنا ابي، ثنا علي بن محمد الطنافسي، ثنا يحيي بن ادم، عن اسراءيل، عن منصور، عن مجاهد: " فلبث في السجن بضع سنين قال: البضع: من ثلاثة الي تسعة "
 
  الوجه الثاني:
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {فلبث في السجن بضع سنين} [يوسف: ] قال: اثنتا عشرة سنة "
 
  والوجه الثالث
 
    
 حدثنا ابي، ثنا محمد المصفي، ثنا محمد بن حمير، عن محمد بن عمر، عن طاوس، والضحاك بن مزاحم، في قوله: " {فلبث في السجن بضع سنين} [يوسف: ] قالا: اربع عشرة سنة "
 
  قوله تعالي: {وقال الملك اني اري سبع بقرات} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق، عن عبد الله بن ابي نجيح، عن مجاهد: " ثم ان الملك ريان بن الوليد، راي الرءيا التي هالته وعرف انها رءيا واقعة، ولم يدر ما تاويلها، فقال للملا حوله من اهل مملكته: {اني اري سبع بقرات سمان ياكلهن سبع عجاف وسبع سنبلات خضر واخر يابسات} [يوسف: ] "
 
  قوله تعالي: {يا ايها الملا افتوني في رءياي ان كنتم للرءيا تعبرون} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات
  [ص: ]
 ، عن اسباط، عن السدي: " ثم ان الله تعالي اري الملك رءيا في منامه هالته، فراي سبع بقرات سمان ياكلهن سبع عجاف، وسبع سنبلات خضر ياكلهن سبع يابسات، فجمع السحرة والكهنة والعافة وهم: القافة والحاحزة وهم الذين يزجرون الطير فقصها عليهم فقالوا: {اضغاث احلام وما نحن بتاويل الاحلام بعالمين} [يوسف: ] "
 
  قوله تعالي: {اضغاث احلام} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا ابو الجماهر، انبا سعيد بن بشير، ثنا عبادة: " {قالوا اضغاث احلام} [يوسف: ] قال: الاحلام {وما نحن بتاويل الاحلام بعالمين} [يوسف: ] "
 
    
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، عن عبيد بن سليمان، عن الضحاك، قوله: " {اضغاث احلام} [يوسف: ] فهي: الاحلام الكاذبة "
 
  قوله تعالي: {وقال الذي نجا منهما} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق، عن ابن ابي نجيح، عن مجاهد، قال: «فلما سمع نبو، من الملك ما سمع منه ومسالته، عن تاويلها، ذكر يوسف، وما كان عبر له ولصاحبه»
 
  قوله: {وادكر} 
 [يوسف: ]
 
    
 وبه، عن مجاهد، قال: " فلما سمع نبو، من الملك ذكر يوسف، وما كان عبر له ولصاحبه، وما جاء من ذلك علي ما قال من قوله: {انا انبءكم بتاويله} [يوسف: ] "
 
  قوله: {بعد امة} 
 [يوسف: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو نعيم، ثنا سفيان، عن عاصم، عن ابي رزين، عن ابن عباس: " {وادكر بعد امة} [يوسف: ] قال: «بعد حين»
 
    
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر، عن ابي روق، عن الضحاك، عن ابن عباس: " {وادكر بعد امة} [يوسف: ] قال: بعد حين، وهو الاجل الذي يعلمه الله "
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {وادكر بعد امة} [يوسف: ] يقول: بعد سنين "
 
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق، عن ابن ابي نجيح، عن مجاهد، يقول الله: " {وادكر بعد امة} [يوسف: ] اي: بعد حقبة من الدهر "
 
  الوجه الثاني:
 
    
 حدثنا ابي، ثنا هدبة بن خالد، ثنا همام، عن قتادة، عن عكرمة، عن ابن عباس، انه قرا: " {وادكر بعد امة} [يوسف: ] ويفسرها قتادة: «بعد نسيان»
 
    
 حدثنا ابي، ثنا نصر، قال: اخبرني ابي، عن همام، عن قتادة، عن عكرمة، عن ابن عباس، انه قرا: " {بعد امة} [يوسف: ] . قال: بعد نسيان "
 
  والوجه الثالث:
 
    
 حدثنا ابي، ثنا نصر بن علي، اخبرني ابي، عن خالد بن قيس، عن قتادة، عن الحسن، انه قرا: " {وادكر بعد امة} [يوسف: ] قال: بعد امة من الناس "
 
  قوله تعالي: {انا انبءكم بتاويله} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا بشر بن هلال الصواف، ثنا جعفر بن سليمان، قال: قال مالك بن دينار: وكان الحسن يقرا هذه الاية: «انا اتيكم بتاويله» ، فقيل له: يا ابا سعيد {انا انبءكم بتاويله} [يوسف: ] قال: «اهو كان نبيهم»
 
  قوله: {فارسلون} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قوله: {انا انبءكم، بتاويله فارسلون} [يوسف: ] قال ابن عباس: «لم يكن السجن في المدينة فانطلق الساقي الي يوسف»
 
  قوله: {يوسف ايها الصديق افتنا في سبع بقرات سمان} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، انبا سعيد بن بشير، ثنا قتادة، قوله: " {افتنا في سبع بقرات سمان} [يوسف: ] وهي: «السنون المخصبات»
 
  قوله تعالي: {ياكلهن سبع عجاف} 
 [يوسف: ]
 
    
 وبه، ثنا قتادة في قوله: " {ياكلهن سبع عجاف} [يوسف: ] : وهن سنون المحول الجدوب "
 
  قوله: {وسبع سنبلات خضر} 
 [يوسف: ]
 
    
 وبه ثنا قتادة: " {وسبع سنبلات خضر} [يوسف: ] : «وهي السنون المخاصيب تخرج الارض نباتها وزرعها وثمارها»
 
  قوله: {واخر يابسات} 
 [يوسف: ]
 
    
 وبه ثنا قتادة: " {واخر يابسات} [يوسف: ] : «المحول الجدوب، فلا تخرج الارض زرعها، ولا ثمارها»
 
  قوله تعالي: {لعلي ارجع الي الناس لعلهم يعلمون} 
 [يوسف: ]
 
    
 حدثنا موسي بن ابي موسي الانصاري، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك، قوله: " {لعلي} [يوسف: ] يعني: «كي»
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي: " {لعلي ارجع الي الناس لعلهم يعلمون} [يوسف: ] «تاويلها»
 
  قوله تعالي: {تزرعون سبع سنين دابا فما حصدتم فذروه في سنبله} 
 [يوسف: ]
 
    
 وبه، عن السدي: " {قال تزرعون سبع سنين دابا فما حصدتم فذروه في سنبله} [يوسف: ] قال: هو ابقي له "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد، يقول: في قوله: " {انا انبءكم، بتاويله فارسلون. يوسف ايها الصديق افتنا في سبع بقرات سمان} [يوسف: ] فلم يرض ان افتاهم بالتاويل حتي امرهم بالرفق، فقال: {سبع سنين دابا فما حصدتم فذروه في سنبله} [يوسف: ] ، لان الحب اذا كان في سنبله لا يءكل "
 
  قوله تعالي: {الا قليلا مما تاكلون} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة: " قال لهم نبي الله يوسف صلي الله عليه وسلم: {تزرعون سبع سنين دابا} [يوسف: ] الي قوله: {مما تاكلون} [يوسف: ] اراد نبي الله يوسف البقاء "
 
  قوله: {ثم ياتي من بعد ذلك سبع شداد} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد، انبا قتادة: " {ثم ياتي من بعد ذلك سبع شداد ياكلن ما قدمتم لهن} [يوسف: ] : وهن السنون المحول، والجدوب "
 
    
 حدثنا علي بن الحسين، ثنا ابو الطاهر، انبا ابن وهب، اخبرني ابن زيد، عن ابيه،: " ان يوسف، النبي، صلي الله عليه وسلم في زمانه كان يضع لرجل طعام اثنين فيقربه الي الرجل فياكل نصفه ويدع نصفه، حتي اذا كان يوما قربه له فاكله كله، فقال يوسف: «هذا اول يوم من السبع الشداد»
 
  قوله تعالي: {ياكلن ما قدمتم لهن} 
 [يوسف: ]
 
    
 اخبرنا ابو عبد الله محمد بن حماد الطهراني فيما كتب الي، انبا عبد الرزاق، عن معمر، عن قتادة، واما قوله: " {ياكلن ما قدمتم لهن} [يوسف: ] يقول: «ياكلن ما كنتم اتخذتم فيهن من القوت»
 
  قوله: {الا قليلا مما تحصنون} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {الا قليلا مما تحصنون} [يوسف: ] يقول: تخزنون "
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انبا سعيد بن بشير، عن قتادة، قوله: " {الا قليلا مما تحصنون} [يوسف: ] اي: مما تدخرون "
 
  قوله تعالي: {ثم ياتي من بعد ذلك عام فيه يغاث الناس وفيه يعصرون} 
 [يوسف: ]
 
    
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، عن عبد الله بن عباس، قوله: " {ثم ياتي من بعد ذلك عام فيه يغاث الناس وفيه يعصرون} [يوسف: ] يقول: يصيبهم فيه غيث "
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انبا سعيد بن بشير، ثنا قتادة، قوله: " {ثم ياتي من بعد ذلك عام فيه يغاث الناس} [يوسف: ] قال: يغاث الناس بالمطر "
 
  قوله تعالي: {وفيه يعصرون} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {فيه يغاث الناس وفيه يعصرون} [يوسف: ] يقول: الاعناب والدهن "
 
    
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، عن ابن عباس، قوله: " {وفيه يعصرون} [يوسف: ] ، يقول: يعصرون فيه العنب، ويعصرون فيه الزيت، ويعصرون من كل الثمرات "
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انبا سعيد، ثنا قتادة: " {وفيه يعصرون} [يوسف: ] : «الثمار، والاعناب، والزيتون من الخصب، وهذا علم اتاه الله علمه، لم يكن فيما سءل عنه»
 
    
 حدثنا سليمان بن داود القزاز، ثنا ابو داود، ثنا الفرج بن فضالة، عن علي بن ابي طلحة، عن ابن عباس، في قول الله: " {عام فيه يغاث الناس وفيه يعصرون} [يوسف: ] قال: يحلبون "
 
    
 ذكر عن عبدان المروزي، انبا عيسي بن عبيد، سمعت عيسي بن عمر الثقفي، يقرا: " {فيه يغاث الناس وفيه يعصرون} [يوسف: ] يعني: الغياث والمطر، ثم قرا: {وانزلنا من المعصرات ماء ثجاجا} [النبا: ] "
 
  قوله تعالي: {وقال الملك اءتوني به} 
 [يوسف: ]
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي: " فلما اتي الملك الرسول، واخبره، قال: اءتوني به فلما جاءه الرسول، فامره ان يخرج الي الملك، ابي يوسف وقال: {ارجع الي ربك} [يوسف: ] "
 
  قوله تعالي: {فلما جاءه الرسول قال ارجع الي ربك فاساله ما بال النسوة} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا موسي بن اسماعيل، ثنا حماد، عن محمد بن عمرو، عن ابي سلمة، عن ابي هريرة، ان النبي صلي الله عليه وسلم، قال في هذه
  [ص: ]
 الاية: {ارجع الي ربك فاساله ما بال النسوة} [يوسف: ] قال: «لو كنت انا لاسرعت الاجابة، وما ابتغيت العذر»
 
    
 حدثنا ابي، ثنا محمد بن ابي عمر العدني، ثنا سفيان، عن عمرو بن دينار، عن عكرمة، فقال رسول الله صلي الله عليه وسلم: " ولقد عجبت من يوسف وصبره وكرمه والله يغفر له، ولو كنت انا ثم دعيت الي الخروج لبدرت الي الباب، ولكنه احب ان يكون له العذر لقول الله: {فلما جاءه الرسول قال ارجع الي ربك فاساله ما بال النسوة اللاتي قطعن ايديهن ان ربي بكيدهن عليم} [يوسف: ] "
 
  قوله: {قال ما خطبكن اذ راودتن يوسف عن نفسه} 
 [يوسف: ]
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول: " فارسل الي فلانة وفلانة، فقال: {ما خطبكن اذ راودتن يوسف، عن نفسه} [يوسف: ] الاية، فقال: ما امركن؟ قلن: {حاش لله ما علمنا عليه من سوء} [يوسف: ] "
 
  قوله تعالي: {قلن حاش لله ما علمنا عليه من سوء} 
 [يوسف: ]
 
    
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا ابو داود، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {حاش لله} [يوسف: ] : قال: معاذ الله "
 
  قوله تعالي: {قالت امراة العزيز} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق: " {قالت امراة العزيز} [يوسف: ] : " {الان حصحص الحق} [يوسف: ] "
 
    
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {الان حصحص الحق} [يوسف: ] . تقول: تبين الحق "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة: " {قالت امراة العزيز الان حصحص الحق} [يوسف: ] . يقول: «الان تبين الحق»
  [ص: ]
 : {انا راودته عن نفسه وانه لمن الصادقين} [يوسف: ] ، قال: كان الحسن اذا تلا هذه الاية قال: «قاتلها الله ما جراها»
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، قوله: " {الان حصحص الحق} [يوسف: ] . اي: الان برز وتبين، {انا راودته عن نفسه} [يوسف: ] "
 
  قوله تعالي: {انا راودته عن نفسه} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا احمد بن عبدة الضبي، انبا حفص بن جميع، عن سماك بن حرب، عن عكرمة، عن ابن عباس، قال: " لما جمع النسوة قال لهن فرعون مصر: انتن راودتن يوسف، عن نفسه؟، قالت امراة العزيز: اعرفت؟ انا راودته عن نفسه "
 
  قوله تعالي: {وانه لمن الصادقين} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق، قوله: " {وانه لمن الصادقين} [يوسف: ] «فيما كان قال يوسف، انما ادعت عليه»
 
  قوله تعالي: {ذلك ليعلم اني لم اخنه بالغيب} 
 [يوسف: ]
 
    
 اخبرنا محمد بن سعيد، فيما كتب الي، ثنا ابي، ثنا عمي، حدثني ابي، عن ابيه، عن ابن عباس: " {ذلك ليعلم اني لم اخنه بالغيب وان الله لا يهدي كيد الخاءنين} [يوسف: ] : هو قول يوسف لمليكه، حين اراد الله عذره، فذكر انه قد هم بها وهمت به "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قال: " قال يوسف، وقد جء به: {ذلك ليعلم اني لم اخنه بالغيب} [يوسف: ] في اهله: {وان الله لا يهدي كيد الخاءنين} [يوسف: ] "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق: " قال يوسف: {ذلك ليعلم} [يوسف: ] اطيفير سيده: {اني لم اخنه بالغيب} [يوسف: ] ، اي: لم اكن لاخالف الي اهله من حيث لا يعلم: {وان الله لا يهدي كيد الخاءنين} [يوسف: ] "
 
  قوله تعالي: {وما ابرء نفسي} 
 [يوسف: ]
 
    
 حدثنا احمد بن عصام الانصاري، ثنا ابو احمد، ثنا اسراءيل، عن سماك، عن عكرمة، عن ابن عباس، قال: " هذا قول يوسف: {ذلك ليعلم اني لم اخنه بالغيب} [يوسف: ] فغمزه جبريل، فقال: ولا حين هممت؟ فقال: {وما ابرء نفسي ان النفس لامارة بالسوء} [يوسف: ] "
 
    
 حدثنا ابي، ثنا يحيي بن عبد الحميد الحماني، ثنا خالد بن عبد الله، عن بيان، عن حكيم بن جابر، في قوله: " {ذلك ليعلم اني لم اخنه بالغيب} [يوسف: ] . قال: فقال له جبريل: ولا حين حللت السراويل؟ . قال: فقال عند ذلك: {وما ابرء نفسي ان النفس لامارة بالسوء} [يوسف: ] " وروي عن سعيد بن جبير مثل ذلك 
 
    
 حدثنا ابي، ثنا ابو الوليد، ثنا السري بن يحيي، عن الحسن، في قوله: " {ذلك ليعلم اني لم اخنه بالغيب} [يوسف: ] . قال: خشي نبي الله ان يكون زكي نفسه، فقال: {وما ابرء نفسي} [يوسف: ] الاية "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي: " قالت امراة العزيز: يا يوسف ولا حين حللت السراويل؟ قال يوسف: {وما ابرء نفسي} [يوسف: ] "
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة، قال: " ذكر لنا ان الملك الذي مع يوسف، قال: اذكر ما هممت به، قال: {وما ابرء نفسي ان النفس لامارة بالسوء} [يوسف: ] "
 
  قوله: {ان النفس لامارة بالسوء} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا موسي بن اسماعيل، ثنا مبارك، عن الحسن، في قوله: " {وما ابرء نفسي ان النفس لامارة بالسوء} [يوسف: ] " يعني: همته التي هم بها "
 
    
 حدثنا ابي، ثنا احمد بن ابي الحواري، حدثني ابو خزيمة، قال: سمعت عبد العزيز بن عمير، يقول: «ان النفس، امارة بالسوء؛ فاذا جاء العزم من الله كانت هي التي تدعوك الي الحياء»
 
  قوله تعالي: {الا ما رحم ربي ان ربي غفور رحيم} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، قوله: " {غفور} [يوسف: ] لما كان منهم قبل التوبة {رحيم} [يوسف: ] بهم بعد التوبة "
 
  قوله تعالي: {وقال الملك اءتوني به} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، " {قال الملك} [يوسف: ] الريان بن الوليد الاكبر: {اءتوني به استخلصه لنفسي} [يوسف: ] "
 
  قوله تعالي: {استخلصه لنفسي} 
 [يوسف: ]
 
    
 حدثنا احمد بن عصام الانصاري، ثنا ابو عاصم، انا سفيان الثوري، عن ابي سنان، عن عبد الله بن ابي الهذيل، عن ابن عباس، في قول الله: " {اءتوني به استخلصه لنفسي} [يوسف: ] ، قال: قال الملك ليوسف: اني احب ان تخالطني في كل شء، الا في اهلي، وانا انف ان تاكل معي؛ فغضب يوسف، فقال: «انا احق ان انف، ان ابي ابراهيم خليل الله، وابي اسحاق ذبيح الله»
 
    
 حدثنا علي بن الحسين، ثنا ابو كريب، ثنا سفيان بن عقبة، عن حمزة الزيات، عن ابي اسحاق، عن ابي ميسرة، قال: " لما راي العزيز لبق يوسف، وكيسه وظرفه؛ دعاه، فكان يتغدي، ويتعشي معه دون غلمانه، فلما كان بينه وبين المراة ما كان، قالت له مرة: فليتغد ويتعشي مع الغلمان، فقال له يوسف في وجهه: ترغب ان تاكل معي؟ او تنكف ان تاكل معي؟ انا والله يوسف بن يعقوب نبي الله بن اسحاق ذبيح الله بن ابراهيم خليل الله "
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة: " {وقال الملك اءتوني به استخلصه لنفسي} [يوسف: ] قال: «اتخذه لنفسي»
 
  قوله تعالي: {فلما كلمه قال انك اليوم لدينا مكين امين} 
 [يوسف: ]
 
    
 ذكر عن عمر بن حفص بن غياث، حدثني ابي، عن عبد الرحمن بن اسحاق، عن القاسم بن عبد الرحمن، قال: قال عبد الله: " افرس الناس ثلاثة: صاحبة موسي، وصاحب يوسف: {انك اليوم لدينا مكين امين} [يوسف: ] ، وابو بكر الصديق حين استخلف عمر "
 
  قوله تعالي: قال اجعلني علي خزاءن الارض
 
    
 حدثنا ابو سعيد الاشج، ثنا اسحاق بن سليمان، عن ابي جعفر الرازي، عن هشام بن حسان، عن محمد بن سيرين، عن ابي هريرة، قال: " استعملني عمر علي البحرين، ثم نزعني، ثم دعاني بعد الي العمل، فابيت فقال: لم؟ وقد سال يوسف العمل "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن ابي حماد، ثنا ابراهيم بن مختار، عن شيبة بن نعامة الضبي: " {اجعلني علي خزاءن الارض} [يوسف: ] قال: كان لفرعون خزاءن كثيرة غير طعام واسلم سلطانه كله، وجعل القضاء اليه، امره وقضاءه نافذ "
 
  قوله تعالي: {اني حفيظ عليم} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة، قال: " {اجعلني علي خزاءن الارض اني حفيظ} [يوسف: ] لما وليت {عليم} [يوسف: ] بامرها "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق: " {اني حفيظ} [يوسف: ] اي: حافظ لما استودعتني "
 
    
 حدثنا سهل بن بحر العسكري، ثنا حسين بن علي بن الاسود، ثنا عمرو بن محمد العنقزي، ثنا الاشجعي، عن سفيان، في قوله: " {اني حفيظ عليم} [يوسف: ] قال: حفظ للحساب "
 
  قوله: {عليم} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان بن صالح، ثنا الوليد، ثنا سعيد، عن قتادة: " في قول الله {اني حفيظ عليم} [يوسف: ] لما وليت {عليم} [يوسف: ] بامره "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن ابي حماد، ثنا ابراهيم بن مختار، عن شيبة بن نعامة: " {اني حفيظ} [يوسف: ] لما استودعتني {عليم} [يوسف: ] بسنين المجاعة "
 
    
 حدثنا سهل بن بحر، ثنا حسين بن علي الاسود، ثنا عمرو بن محمد، ثنا الاشجعي، عن سفيان، في قوله: " {اني حفيظ عليم} [يوسف: ] قال: حفيظ للحساب، عليم بالالسن "
 
  قوله تعالي: {وكذلك مكنا ليوسف في الارض} 
 [يوسف: ]
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي: " {وكذلك مكنا ليوسف في الارض} [يوسف: ] قال: فاستعمله علي مصر، فكان صاحب امرها هو الذي يلي البيع والامر "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {اني حفيظ عليم} [يوسف: ] بما وليتني، قال: قد فعلت فولاه فيما يذكرون عمل اطيفير، وعزل اطيفير عما كان عليه "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {مكنا ليوسف في الارض} [يوسف: ] قال: ملكناه فيها "
 
  قوله تعالي: {يتبوا منها حيث يشاء} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {يتبوا منها حيث يشاء} [يوسف: ] يقول: ينزل منها حيث يشاء "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، قال: سمعت عبد الرحمن بن زيد، في قول الله: " {يتبوا منها حيث يشاء} [يوسف: ] قال: ملكناه فيها، يكون فيها حيث يشاء من تلك الدنيا، يصنع فيها ما يشاء فوضت اليه، قال: ولو يشاء ان يجعل فرعون من تحت يديه، ويجعله من فوق لفعل "
 
  قوله: {نصيب برحمتنا من نشاء} [يوسف: ] الاية
 
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، قال: فذكروا، والله اعلم، ان اطيفير هلك في تلك الليالي، وان الملك الريان زوج يوسف امراة اطيفير، راعيل، وانها حين ادخلت عليه قال: اليس هذا خيرا مما كنت تريدين؟ قال: فيزعمون انها قالت: ايها الصديق لا تلمني فاني كنت امراة كما تري امراة حسناء جملاء ناعمة في ملك ودنيا، وكان صاحبي لا ياتي النساء، وكنت كما جعلك الله في حسنك وهيءتك فغلبتني نفسي علي ما رايت فيزعمون انه وجدها عذراء فاصابها فولدت له رجلين "
 
 حدثنا محمد بن يحيي الواسطي، حدثنا محمد بن الحسين، حدثني قادم الديلمي العابد، قال: سمعت الفضيل بن عياض، يقول: " وقفت امراة العزيز علي ظهر الطريق، حتي مر يوسف فقالت: الحمد لله الذي جعل العبيد ملوكا بطاعته، وجعل الملوك عبيدا بمعصيته "
 
  قوله: {ولاجر الاخرة خير للذين امنوا} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: " {ولاجر الاخرة خير} [يوسف: ] يقول: باقية "
 
    
 حدثنا ابي، ثنا الهيثم بن يمان، ثنا اسماعيل بن زكريا، قال: حدثني محمد بن عون الخراساني، عن عكرمة، " دار الاخرة يقول: الجنة "
 
  قوله تعالي: {يتقون} 
 [البقرة: ]
 
    
 اخبرنا عمرو بن ثور القيساري، فيما كتب الي، ثنا الفريابي، ثنا سفيان، عن ابن ابي نجيح، عن مجاهد: " {يتقون} [يوسف: ] يطيعونه "
 
    
 حدثنا ابي، ثنا ابو الاسود النضر بن عبد الجبار، ثنا نوح بن عباد، عن مالك بن دينار، قال: سالت الحسن، قلت: يا ابا سعيد: " {ولاجر الاخرة خير للذين امنوا وكانوا يتقون} [يوسف: ] ماهيه؟ قال: يا مالك: اتقوا المحارم، خمصت بطونهم، المحارم تركوا وهم يشتهونها "
 
  قوله تعالي: {وجاء اخوة يوسف فدخلوا عليه} 
 [يوسف: ]
 
    
 حدثنا احمد بن منصور، ثنا يونس بن محمد، ثنا صدقة بن عبادة، حدثني ابي، ثنا ابن عباس، قال: " ان اخوة يوسف لما دخلوا عليه: {فعرفهم وهم له منكرون} [يوسف: ] قال: جاء بصواع الملك الذي كان يشرب فيه فوضعه علي يده فجعل ينقره ويطن، وينقره ويطن، فقال: ان هذا الجام ليخبرني عنكم خبرا، هل كان لكم اخ من ابيكم يقال له يوسف؟ وكان ابوه يحبه دونكم؟ وانكم انطلقتم به فالقيتموه في الجب، واخبرتم اباكم ان الذءب اكله كله، وجءتم علي قميصه بدم كذب؟ قال: فجعل بعضهم ينظر الي بعض، ويعجبون ان هذا الجام ليخبر خبركم فمن اين يعلم هذا؟ "
 
  قوله تعالي: {فعرفهم وهم له منكرون} 
 [يوسف: ]
 
    
 اخبرنا محمد بن عبد الله بن يزيد المقرء، ثنا سفيان، عن ابن ابي الجلد، قال: " قال اخوة يوسف ليوسف حين قال لهم: ان امركم ليريبني، وهو يترقب عليهم، كانكم جواسيس، قالوا ايها العزيز: ان ابانا شيخ صديق، وانا قوم صديقون، وان الله يحيي بكلام الانبياء القلوب، كما يحيي وابل السماء الارض، ويقول لهم وفي يده الاناء وهو يقرعه القرعة، كان هذا يخبر عنكم بانكم جواسيس "
 
    
 اخبرنا محمد بن حماد الطهراني، فيما كتب الي، ثنا عبد الرزاق، عن معمر، عن قتادة، قوله: " {فعرفهم وهم له منكرون} [يوسف: ] قال: لا يعرفونه "
 
    
 ذكر، عن المقدمي، ثنا ازهر، عن ابن عون قال: قلت للحسن: " تري يوسف عرف اخوته؟ قال: لا والله ما عرفهم حتي تعرفوا اليه "
 
  قوله: {ولما جهزهم بجهازهم} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق: «فلما جهزهم فيمن جهز من الناس حمل لكل واحد منهم بعيرا بعدتهم»
 
  قوله تعالي: {قال اءتوني باخ لكم من ابيكم} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة: " {اءتوني باخ لكم من ابيكم} [يوسف: ] يعني: بنيامين، وهو اخو يوسف لابيه وامه "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي، قال: " فاصاب الارض الجوع واصاب بلاد يعقوب التي كان فيها فبعث بنيه الي مصر، وامسك بنيامين، اخا يوسف فلما دخلوا علي يوسف عرفهم وهم له منكرون، فلما نظر اليهم اخذهم فادخلهم الدار، وادخل المكوك، وقال لهم: اخبروني ما امركم فاني انكر شانكم؟ قالوا نحن من ارض الشام، قال: فما جاء بكم؟ قالوا: نمتار طعاما، قال: كذبتم، انتم عيون، كم انتم؟ قالوا: نحن عشرة، قال: انتم عشرة الاف، كل رجل منكم امير الف، فاخبروني خبركم؟ قالوا: انا اخوة بنو رجل واحد، صديق وانا كنا اثني عشر، فكان يحب اخا لنا، وانه ذهب معنا الي البرية فهلك منا فيها، وكان احبنا الي ابينا، قال: فالي من يسكن ابوكم بعده؟
  [ص: ]
 قالوا: الي اخ اصغر منه، قال: كيف تحدثوني ان اباكم صديق وهو يحب الصغير منكم دون الكبير؟ اءتوني باخيكم هذا حتي انظر اليه {فان لم تاتوني به فلا كيل لكم عندي ولا تقربون} [يوسف: ] "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {اءتوني باخ لكم من ابيكم} [يوسف: ] اجعل لكم معه بعيرا اخر، او كما قال "
 
  قوله: {الا ترون اني اوفي الكيل} 
 [يوسف: ]
 
    
 وبه، عن ابن اسحاق: " {الا ترون اني اوفي الكيل} [يوسف: ] اي: لا ابخس الناس شيءا "
 
  قوله: {وانا خير المنزلين} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قوله: " {وانا خير المنزلين} [يوسف: ] قال: خير من يضيف بمصر "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {وانا خير المنزلين} [يوسف: ] اي: خير لكم من غيري، فانكم ان اتيتم به اكرمت منزلتكم، واحسنت اليكم، وازددتم بعيرا مع عدتكم، فاني لا اعطي كل رجل الا بعيرا "
 
  قوله: {فان لم تاتوني به فلا كيل لكم عندي ولا تقربون} 
 [يوسف: ]
 
    
 وبه، عن ابن اسحاق: " {فان لم تاتوني به فلا كيل لكم عندي} [يوسف: ] فان انتم لم تاتوني به فلا تقربوا بلدي، فانه لا كيل لكم عندي ولا تقربون "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي: " {فان لم تاتوني به فلا كيل لكم عندي ولا تقربون} [يوسف: ] قال: فاني اخشي ان لا تاتوني به فضعوا بعضكم رهينة حتي ترجعوا فارتهن شمعون عنده "
 
  قوله تعالي: {قالوا سنراود عنه اباه} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {قالوا سنراود عنه اباه وانا لفاعلون} [يوسف: ] لنجتهدن "
 
  قوله: {وقال لفتيانه} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة: " {وقال لفتيانه} [يوسف: ] اي: لغلمانه "
 
  قوله: {اجعلوا بضاعتهم في رحالهم} 
 [يوسف: ]
 
    
 وبه، عن قتادة، قوله: " {اجعلوا بضاعتهم في رحالهم} [يوسف: ] اي: اوراقهم في رحالهم "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قال: " {وقال لفتيانه} [يوسف: ] وهو يكيل لهم {اجعلوا بضاعتهم في رحالهم} [يوسف: ] "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، قال: «ثم امر ببضاعتهم التي اعطاهم بها من الطعام، فجعلت في رحالهم وهم لا يعلمون»
 
  قوله تعالي: {لعلهم يعرفونها اذا انقلبوا الي اهلهم} 
 [يوسف: ]
 
    
 وبه، عن محمد بن اسحاق، في قوله: " {لعلهم يعرفونها اذا انقلبوا الي اهلهم لعلهم يرجعون} [يوسف: ] قال: ثم خرجوا حتي قدموا علي ابيهم، وكان منزلهم فيما ذكر لي بعض اهل العلم، بالعربات، من ارض فلسطين بغور الشام، وبعض يقول: كان بالاولاج، من ناحية الشعب اسفل من حسمي، وكان صاحب بادية له بها شاء وابل "
 
  قوله: {لعلهم يرجعون} 
 [ال عمران: ]
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قوله: " {لعلهم يرجعون} [يوسف: ] قال: لعلهم يرجعون الي "
 
  قوله تعالي: {فلما رجعوا الي ابيهم} 
 [يوسف: ]
 
    
 وبه، عن السدي، قال: " فلما رجع القوم الي ابيهم، كلموه فقالوا: يا ابانا، ان ملك مصر اكرمنا، لو كان رجلا منا من بني يعقوب ما اكرمنا كرامته، وانه
  [ص: ]
 ارتهن شمعون، وقال: اءتوني باخيكم هذا الذي عطف عليه ابوكم بعد اخيكم الذي هلك حتي انظر اليه فان لم تاتوني به، فلا تقربوا بلادي ابدا "
 
  قوله تعالي: {قال هل امنكم عليه الا كما امنتكم علي اخيه من قبل} 
 [يوسف: ]
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق: " {قال هل امنكم عليه الا كما امنتكم علي اخيه من قبل} [يوسف: ] قالوا: يا ابانا، قدمنا علي خير رجل، انزلنا فاكرم منزلنا، وكال لنا فاوفانا، ولم يبخسنا، وقد امرنا ان ناتيه باخ لنا من ابينا، وقال: ان انتم لم تفعلوا فلا تقربني ولا تدخلن بلدي، فقال لهم يعقوب: {هل امنكم عليه الا كما امنتكم علي اخيه من قبل فالله خير حافظا وهو ارحم الراحمين} [يوسف: ] "
 
  قوله تعالي: {ولما فتحوا متاعهم وجدوا بضاعتهم ردت اليهم} 
 [يوسف: ]
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قوله: {ولما فتحوا متاعهم} [يوسف: ] قال: " لما رجعوا الي ابيهم، وفتحوا رحالهم {وجدوا بضاعتهم ردت اليهم} [يوسف: ] اتوا اباهم: {قالوا يا ابانا ما نبغي هذه بضاعتنا ردت الينا} [يوسف: ] "
 
  قوله تعالي: {قالوا يا ابانا ما نبغي هذه بضاعتنا ردت الينا ونمير اهلنا ونحفظ اخانا} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، انبا سعيد بن بشير، ثنا قتادة، قوله: {قالوا يا ابانا ما نبغي هذه بضاعتنا} [يوسف: ] هذه اوراقنا: {ردت الينا ونمير اهلنا ونحفظ اخانا ونزداد كيل بعير ذلك كيل يسير} [يوسف: ] "
 
    
 حدثنا محمد بن يحيي، انا العباس بن الوليد، ثنا يزيد، ثنا سعيد، عن قتادة، قوله: " {ما نبغي هذه بضاعتنا ردت الينا} [يوسف: ] يقول: ما نبغي وراء هذا، ان بضاعتنا ردت الينا، وقد اوفي لنا الكيل "
 
  قوله: {ونزداد كيل بعير} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: " {ونزداد كيل بعير} [يوسف: ] اي: حمل بعير "
 
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " ونزداد كيل بعير اي: نزداد بعدته بعيرا مع ابلنا: {ذلك كيل يسير} [يوسف: ] "
 
  قوله تعالي: {قال لن ارسله معكم حتي تءتون موثقا من الله} 
 [يوسف: ]
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قال: " قال ابوهم حين راي ذلك: {لن ارسله معكم حتي تءتون موثقا من الله لتاتنني به الا ان يحاط بكم} [يوسف: ] "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، قال: " فلما راي ذلك يعقوب، وراي ان لابد لهم من الميرة لعياله واهله، وكان الناس قد جهدوا جهدا شديدا قال: {لن ارسله معكم حتي تءتون موثقا من الله} [يوسف: ] "
 
  قوله تعالي: {لتاتنني به الا ان يحاط بكم} 
 [يوسف: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {الا ان يحاط بكم} [يوسف: ] تهلكوا جميعا
 
    
 اخبرنا محمد بن حماد الطهراني، فيما كتب الي، انبا عبد الرزاق، انبا معمر، عن قتادة: " {الا ان يحاط بكم} [يوسف: ] قال: الا ان تغلبوا، حتي لا تطيقوا ذلك "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق: " {الا ان يحاط بكم} [يوسف: ] : الا ان يصيبكم امر يذهب بكم جميعا فيكون ذلك عذرا لكم عندي "
 
  قوله تعالي: {فلما اتوه موثقهم} 
 [يوسف: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {موثقهم} [يوسف: ] . قال: عهدهم "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي: " {فلما اتوه موثقهم} [يوسف: ] قال: فحلفوا له "
 
 حدثنا محمد بن العباس، مولي بني هاشم ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن ابن اسحاق: " {فلما اتوه موثقهم} [يوسف: ] خلي سبيله معهم "
 
  قوله تعالي: {قال الله علي ما نقول وكيل} 
 [يوسف: ]
 
    
 حدثنا محمد بن يحيي، ثنا العباس بن الوليد، ثنا يزيد، ثنا سعيد، عن قتادة، قوله: " {وكيل} [يوسف: ] اي: حفيظ "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي، قال: " {فلما اتوه موثقهم} [يوسف: ] قال يعقوب: {الله علي ما نقول وكيل} [يوسف: ] "
 
    
 حدثنا ابو بكر بن ابي موسي، ثنا ابو صالح بن شعيب بن عبد الله الواسطي، عن يزيد بن عبد الله الواسطي، عن يزيد بن هارون، ثنا ورقاء، عن ابن ابي نجيح، في قوله: " {الله علي ما نقول وكيل} [يوسف: ] قال: شهيد "
 
  قوله تعالي: {وقال يا بني لا تدخلوا من باب واحد} 
 [يوسف: ]
 
    
 اخبرنا محمد بن سعد العوفي، فيما كتب الي، حدثني ابي، حدثني عمي، حدثني ابي، ثنا محمد المصفي، ثنا معاوية بن حفص، عن هشيم، عن جويبر، عن الضحاك، وشريك، عن ليث، عن مجاهد: " {لا تدخلوا من باب واحد} [يوسف: ] قال: خاف عليهم العين "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي، قال: " ورهب عليهم ان تصيبهم العين ان دخلوا مصر، فيقال هءلاء لرجل واحد: {وقال يا بني لا تدخلوا من باب واحد} [يوسف: ] يقول: من طريق واحد "
 
  قوله تعالي: {وادخلوا من ابواب متفرقة} 
 [يوسف: ]
 
    
 حدثنا ابي يحيي بن عبد الحميد الحماني، ثنا عبد الرحمن بن محمد المحاربي، عن الحسن بن عمرو، عن فضيل، عن ابراهيم: " {لا تدخلوا من باب واحد وادخلوا من ابواب متفرقة} [يوسف: ] قال: علم انه سيلقي اخوته في بعض الابواب "
 
    
 اخبرنا محمد بن حماد الطهراني، فيما كتب الي، ثنا
  [ص: ]
 عبد الرزاق، ثنا معمر، عن قتادة: " {وادخلوا من ابواب متفرقة} [يوسف: ] قال: كانوا قد اوتوا صورا، وجمالا، فخشي عليهم انفس الناس "
 
  قوله: {وما اغني عنكم من الله من شء ان الحكم الا لله عليه توكلت} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انبا سعيد بن بشير، عن قتادة، قوله: " {وما اغني عنكم من الله من شء ان الحكم الا لله عليه توكلت وعليه فليتوكل المتوكلون} [يوسف: ] قال: خشي نبي الله انفس الناس، علي بنيه وكانوا ذوي صورة وجمال "
 
  قوله تعالي: {ولما دخلوا من حيث امرهم ابوهم} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق، قال: " فلما دخلوا علي يوسف، قالوا: هذا اخونا الذي امرتنا ان ناتيك به وقد جءناك به "
 
  قوله تعالي: {الا حاجة في نفس يعقوب قضاها} 
 [يوسف: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {حاجة في نفس يعقوب قضاها} [يوسف: ] اي: خيفة العين علي بنيه "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، قوله: " {الا حاجة في نفس يعقوب قضاها} [يوسف: ] والحاجة التي كانت في نفس يعقوب ما تخوف علي بنيه من انفس الناس لعدتهم ولهيءتهم "
 
  قوله عز وجل: {وانه لذو علم لما علمناه} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انبا سعيد، ثنا قتادة، قوله: " {وانه لذو علم} [يوسف: ] واعلمه ان خير العلم ما نفع، وان افضل الهدي ما اتبع وان اغوي الضلالة، الضلالة بعد الهدي، وانما ينتفع بالعلم من علمه، ثم عمل به ولا ينتفع به من علمه ثم تركه "
 
    
 حدثنا محمد بن يحيي، ثنا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة، قوله: " {لما علمناه} [يوسف: ] اي: مما علمناه "
 
 حدثنا ابي، ثنا ابو معمر اسماعيل بن ابراهيم القطيعي، ثنا سفيان بن عيينة، عن ابن ابي عروبة، عن قتادة: " {وانه لذو علم لما علمناه} [يوسف: ] قال: عامل لما علم "
 
  قوله تعالي: {ولما دخلوا علي يوسف اوي اليه اخاه} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة: " {ولما دخلوا علي يوسف اوي اليه اخاه} [يوسف: ] ضمه اليه وانزله معه "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي، قوله: " {ولما دخلوا علي يوسف} [يوسف: ] عرف اخاه وانزلهم منزلا، واجري عليهم الطعام والشراب، فلما كان الليل اتاهم بمثل، قال: " لينام كل واحد منكم علي مثال، حتي بقي الغلام وحده، فقال يوسف: هذا ينام معي، علي فراشي «، فبات مع يوسف فجعل يشتم ريحه ويضمه اليه حتي اصبح»
 
    
 حدثني علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " فلما دخلوا علي يوسف قالوا: هذا اخونا الذي امرتنا ان ناتيك به، وقد جءناك به، فذكر لي انه قال لهم: قد احسنتم واصبتم ستجدون ذلك لكم عندي، او كما قال: اراكم رجالا وقد اردت ان اكرمكم، ودعا صاحب ضيافته فقال: انزل كل رجلين علي حده، ثم اكرمهما، واحسن ضيافتهما، ثم قال: اني اري هذا الرجل الذي جءتم به ليس معه ثاني، فساضمه الي، فيكون منزله معي، فانزلهم رجلين رجلين في منازل شتي، وانزل اخاه معه فاواه اليه "
 
  قوله تعالي: {قال اني انا اخوك} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، قال: " فلما خلا به {قال اني انا اخوك} [يوسف: ] انا يوسف "
 
  قوله: {فلا تبتءس بما كانوا يعملون} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انبا سعيد بن بشير، ثنا قتادة، قوله: " {اني انا اخوك، فلا تبتءس بما كانوا يعملون} [يوسف: ] اي: لا تحزن ولا تياس بما كانوا يعملون "
 
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: «فلا تبتءس بشء فعلوه بنا فيما مضي، فان الله قد احسن الينا، ولا تعلمهم شيءا مما اعلمتك»
 
  قوله تعالي: {فلما جهزهم بجهازهم} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انبا سعيد بن بشير، ثنا قتادة، قوله: " {فلما جهزهم بجهازهم} [يوسف: ] لما قضي حاجتهم وكال لهم طعامهم "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، قال: «ثم جهزهم بجهازهم فاكرمهم، واعطاهم فاوفاهم وجعل لهم بعيرا، وجعل لاخيه بعيرا باسمه كما جعل لهم»
 
  قوله: {جعل السقاية} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {جعل السقاية في رحل اخيه} [يوسف: ] قال: هو الصواع، وكل شء يشرب فيه فهو صواع "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {السقاية} [يوسف: ] والصواع يشرب منه يوسف "
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انبا سعيد بن بشير، ثنا قتادة، قوله: " {جعل السقاية في رحل اخيه} [يوسف: ] وهو: اناء الملك الذي يشرب منه "
 
    
 حدثنا علي بن الحسين، ثنا عبيد الله بن سعد بن ابراهيم، ثنا عمي، عن شريك، عن سماك، عن عكرمة، في {السقاية} [يوسف: ] : «اناءه الذي يشرب فيه، وهو من فضة»
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول في قول الله: " {جعل السقاية} [يوسف: ] في رحل اخيه قال: السقاية هي: الصواع وكان كاسا من ذهب فيما يذكرون "
 
  قوله تعالي: {في رحل اخيه} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انبا سعيد، ثنا قتادة، قوله: " {جعل السقاية في رحل اخيه} [يوسف: ] قال: كان اخوه لابيه وامه "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة: " {جعل السقاية في رحل اخيه} [يوسف: ] جعل السقاية في متاع اخيه "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، قال: " فجعل يعني: السقاية في رحل اخيه بنيامين، ثم امهلهم حتي انطلقوا فامعنوا عن القرية، امر بهم فادركوا فاجلسوا "
 
  قوله تعالي: {ثم اذن مءذن} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي: " {جعل السقاية في رحل اخيه} [يوسف: ] وهو لا يشعر بها، وجعل يقول روبيل: ما راينا رجلا مثل هذا ان نحن نجونا منه، فلما ارتحلوا: {اذن مءذن} [يوسف: ] قبل ان ترتحل العير: {ايتها العير انكم لسارقون} [يوسف: ] فانقطعت ظهورهم "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، قال: " ثم امهلهم حتي اذا انطلقوا، فامعنوا عن القرية، امر بهم فاجلسوا، ثم ناداهم مناد: {ايتها العير انكم لسارقون} [يوسف: ] فوقفوا، وانتهي اليهم رسوله، فقال لهم فيما يذكرون: الم نكرم ضيافتكم، ونوفكم كيلكم، ونحسن منزلتكم، ونفعل بكم ما لم نفعل بغيركم، وادخلناكم علينا في بيوتنا ومنازلنا؟ او كما قال لهم، قالوا: بلي، وما ذاك؟ "
 
  قوله: {ايتها العير انكم لسارقون} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابن ابي عمر العدني، ثنا سفيان بن عيينة، عن ابن جريج، عن مجاهد: " {ايتها العير} [يوسف: ] قال: كانت حميرا "
 
  قوله: {قالوا واقبلوا عليهم ماذا تفقدون} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق
  [ص: ]
 ، قال: قالوا: بلي وما ذاك؟ قالوا: " سقاية الملك فقدناها، ولا نتهم عليها غيركم: {قالوا تالله لقد علمتم ما جءنا لنفسد في الارض} [يوسف: ] "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي: " {قالوا واقبلوا عليهم} [يوسف: ] يقولون: ماذا تفقدون "
 
  قوله تعالي: {قالوا نفقد صواع الملك} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا حماد بن زاذان، ثنا توبة بن علوان، ثنا شعبة، عن ابي بشر، عن سعيد بن جبير، عن ابن عباس، في قوله: " {صواع الملك} [يوسف: ] قال: كهيءة المكوك من فضة يشربون فيه "
 
    
 حدثنا ابي، ثنا عمرو بن رافع، ثنا هشيم، عن ابي بشر، عن سعيد بن جبير، انه قرا: «صواغ الملك» وكان اناءه الذي يشرب فيه، وكان الي الطول ما هو
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو عبد الرحمن الحارثي، عن جويبر، عن الضحاك، قال: «اناءه الذي كان يشرب فيه»
 
    
 حدثنا ابي مسدد، ثنا ابو عوانة، عن ابي بشر، عن سعيد بن جبير، قال: " {صواع الملك} [يوسف: ] قال: هو المكوك الفارسي الذي تشرب فيه الاعاجم، تلتقي طرفاه "
 
    
 حدثنا ابي، ثنا ابو عمر الدوري، ثنا ابو تميلة، ثنا عبد المءمن بن خالد، عن غالب الليثي، عن يحيي بن يعمر، انه كان يقرءها «صواغ الملك» بالغين، قال: كان صيغ من ذهب او فضة سقايته التي كان يشرب فيها "
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا ابو بشر الوليد بن محمد هو الموقري، عن الزهري، في قول الله: " (نفقد صواغ الملك) قال: القدح "
 
  قوله تعالي: {ولمن جاء به حمل بعير} 
 [يوسف: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {حمل بعير} [يوسف: ] قال: حمل طعام وهي لغة "
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة: " {ولمن جاء به حمل بعير} [يوسف: ] اي: وقدر بعير "
 
  والوجه الثاني:
 
    
 حدثنا ابي، ثنا الفضل بن يعقوب الرخامي، ثنا الحجاج يعني ابن محمد، عن ابن جريج، عن مجاهد: {ولمن جاء به حمل بعير} [يوسف: ] قال: حمل بعير يعني: حمار , وهي لغة "
 
  قوله تعالي: {وانا به زعيم} 
 [يوسف: ]
 
    
 اخبرنا يونس بن عبد الاعلي، قراءة، انبا عبد الله بن وهب، انبا ابو هاني الخولاني، عن عمرو بن مالك الجنبي، انه سمع فضالة بن عبيد، يقول: سمعت رسول الله، صلي الله عليه وسلم، يقول: «انا زعيم» والزعيم: الحميل
 
    
 حدثنا ابو سعيد الاشج، ثنا عبدة بن سليمان، عن جويبر، عن الضحاك: {وانا به زعيم} [يوسف: ] قال: " الزعيم: الكفيل "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {وانا به زعيم} [يوسف: ] قال: " الزعيم هو المءذن الذي قال: ايتها العير "
 
  قوله تعالي: {قالوا تالله لقد علمتم} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن الدشتكي، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع، في قوله: " {ما جءنا لنفسد في الارض وما كنا سارقين} [يوسف: ] ، يقول: ما جءنا لنعصي في الارض "
 
  قوله تعالي: {قالوا فما جزاءه ان كنتم كاذبين} 
 [يوسف: ]
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول: " {فما جزاءه ان كنتم كاذبين} [يوسف: ] فعرفوا الحكم، في احكامهم، فقالوا: {من وجد في رحله فهو جزاءه} [يوسف: ] "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قوله: " {قالوا جزاءه من وجد في رحله فهو جزاءه} [يوسف: ] قالوا: خذوه، فهو لكم "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق
  [ص: ]
 : " {فما جزاءه ان كنتم كاذبين قالوا جزاءه من وجد في رحله فهو جزاءه} [سورة: يوسف، اية رقم: ] اي: سلم به "
 
  قوله تعالي: {كذلك نجزي الظالمين} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {كذلك نجزي الظالمين} [سورة: يوسف، اية رقم: ] اي: كذلك نصنع بمن سرق منا "
 
  قوله: {فبدا باوعيتهم قبل وعاء اخيه} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انبا سعيد بن بشير، عن قتادة، قوله: " {فبدا باوعيتهم قبل وعاء اخيه} [سورة: يوسف، اية رقم: ] انه كان لا ينظر في وعاء رجل منهم الا استغفر، تاثما مما قذفهم به حتي اذا بقي اخوه وهو اصغر القوم: ما اري هذا اخذ شيءا، قالوا: بلي فاستبرءه، الا وقد علموا حيث وضعوا سقايتهم: {ثم استخرجها من وعاء اخيه} [سورة: يوسف، اية رقم: ] "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، قال لهم الرسول: " لستم ببارحين حتي افتش امتعتكم، واعذر في طلبها قالوا: ما نعلمها فينا ولا معنا. فبدا باوعيتهم وعاء وعاء يفتشها وينظر ما فيها حتي مر علي اخيه ففتش فاستخرجها منه فاخذ برقبته فانصرف به الي يوسف "
 
  قوله تعالي: {ثم استخرجها من وعاء اخيه} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين، ثنا عامر، ثنا اسباط، عن السدي: " {فبدا باوعيتهم قبل وعاء اخيه} [يوسف: ] فلما بقي رحل الغلام، قال: ما كان هذا الغلام لياخذها، قالوا: والله لا ترك حتي تنظر في رحله، وتذهب وقد طابت نفسك فادخل يده في رحله فاستخرجها من رحل اخيه يقول الله تعالي: {كذلك كدنا ليوسف} [يوسف: ] "
 
  قوله: {كذلك} 
 [البقرة: ]
 
    
 حدثنا موسي بن ابي موسي الانصاري، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، ثنا اسباط، عن السدي، عن ابي مالك، قوله: " {كذلك} [يوسف: ] يعني: هكذا "
 
  قوله: {كدنا ليوسف} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا سعيد بن سليمان ابن ابنة نشيط، ثنا عبد الواحد بن زياد، ثنا ابو روق، قال: سمعت الضحاك، في قوله: " {كذلك كدنا ليوسف} [يوسف: ] قال: كذلك صنعنا ليوسف "
 
  قوله تعالي: {ما كان لياخذ اخاه} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، يقول الله: " {كذلك كدنا ليوسف ما كان لياخذ اخاه في دين الملك} [سورة: يوسف، اية رقم: ] اي: بظلم ولكن الله كاد له ليضم اليه اخاه "
 
  قوله تعالي: {في دين الملك} 
 [يوسف: ]
 
    
 اخبرنا محمد بن سعد العوفي، فيما كتب الي، حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، عن عبد الله بن عباس، قوله: " {ما كان لياخذ اخاه في دين الملك} [يوسف: ] يقول: في سلطان الملك "
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انبا سعيد بن بشير، ثنا قتادة، قال: " {ما كان لياخذ اخاه في دين الملك} [يوسف: ] قال: ما كان في قضاء الملك ان يستعبد رجلا يسرقه "
 
    
 حدثنا اسماعيل بن اسحاق بن سهل الكوفي، نزيل مصر، ثنا قيس بن حفص البصري، ثنا عبد الواحد بن زياد، ثنا ابو روق، عن الضحاك، في قوله: {ما كان لياخذ اخاه في دين الملك} [يوسف: ] قال: «كان في دين ملكهم، اذا اخذت السرقة من السارق، اخذت منه ومثلها من ماله، فدفعت للمسروق»
 
  قوله تعالي: {الا ان يشاء الله} 
 [الانعام: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {في دين الملك الا ان يشاء الله} [يوسف: ] الا بعلة كادها الله له فاعتل بها يوسف "
 
  قوله تعالي: {نرفع درجات من نشاء} 
 [الانعام: ]
 
    
 حدثنا ابو زرعة، ثنا عبد الرحمن بن ابي الغمر، ثنا عبد الرحمن بن
  [ص: ]
 القاسم، قال مالك: سمعت زيد بن اسلم، يقول في هذه الاية: {نرفع درجات من نشاء} [الانعام: ] انه: «العلم يرفع الله من يشاء به في الدنيا»
 
  قوله تعالي: {وفوق كل ذي علم عليم} 
 [يوسف: ]
 
    
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انبا الثوري، عن عبد الاعلي، عن سعيد بن جبير، قال: كنا عند ابن عباس فحدث حديثا، فتعجب رجل فقال: " الحمد لله فوق كل ذي علم عليم، فقال ابن عباس: بءس ما قلت الله العليم، وهو فوق كل عالم "
 
    
 حدثنا ابي، ثنا عبد الله بن رجاء، انبا اسراءيل، عن سماك، عن عكرمة، عن ابن عباس، في قوله: {وفوق كل ذي علم عليم} [يوسف: ] قال: «يكون الرجل اعلم من الرجل، والرجل اعلم من الرجل، والله فوق كل ذي علم عليم»
 
    
 حدثنا ابي، ثنا محمد بن المنهال الضرير، ثنا يزيد بن زريع، ثنا خالد الحذاء، عن عكرمة، في قوله: {وفوق كل ذي علم عليم} [يوسف: ] قال: «علم الله فوق علم العباد»
 
    
 حدثنا ابي، ثنا محمد بن وهب بن عطية، ثنا الوليد، ثنا سعيد بن بشير، عن قتادة، في قوله: {نرفع درجات من نشاء وفوق كل ذي علم عليم} [يوسف: ] قال: هكذا «ينتهي العلم الي الله عز وجل، منه بدا، واليه يعود ويرجع»
 
  قوله تعالي: {قالوا ان يسرق فقد سرق اخ له من قبل} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا منصور بن ابي مزاحم، ثنا ابو سعيد بن ابي الوضاح، عن خصيف، عن عكرمة، عن ابن عباس، قال: " عوقب يوسف ثلاث مرات، والثالثة حيث قال: {ايتها العير انكم لسارقون} [يوسف: ] فاستقبل في وجهه: {ان يسرق فقد سرق اخ له من قبل} [يوسف: ] يعنونه "
 
    
 حدثنا اسماعيل بن عبد الله بن مسعود، ثنا الفيض بن الفضل، ثنا مسعر بن كدام، عن ابي حصين، عن سعيد بن جبير: " {ان يسرق فقد سرق اخ له من قبل} [يوسف: ] قال: سرق يوسف صنما لجده ابي امه من ذهب وفضة، كسره ثم القاه في الطريق فعيره بذلك اخوته "
 
 حدثنا ابو عقيل، ثنا يحيي بن حبيب بن اسماعيل، من ولد حبيب بن ابي ثابت، ثنا جعفر بن عون، انا هشام بن سعد، عن زيد بن اسلم في تعيير اخوة يوسف له: " {ان يسرق فقد سرق اخ له من قبل} [يوسف: ] قال: كان يوسف مع امه عند خال له قال: وكان غلاما، يلعب مع الغلمان، فدخلوا كنيسة لهم فوجد تمثالا لهم صغيرا من ذهب فاخذه، فذلك قول اخوته: {ان يسرق فقد سرق اخ له من قبل} [يوسف: ] "
 
  والوجه الثاني:
 
    
 حدثنا المنذر بن شاذان، ثنا زكريا يعني: ابن عدي، ثنا ابن ادريس، عن ابيه، عن عطية، في قول الله: " {ان يسرق فقد سرق اخ له من قبل} [يوسف: ] قال: كان علي الخوان فاجتر عرقا، او قال: خباه "
 
  والوجه الثالث:
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، عن عبد الله بن ابي نجيح، عن مجاهد، قال: " كان اول ما دخل علي يوسف من البلاء فيما بلغني ان عمته بنت اسحاق، وكانت كبري ولد اسحاق، وكانت اليها منطقة اسحاق، وكانوا يتوارثونها بالكبر، فكان من اختانها من وليها، كان له سلما لا ينازع فيه يصنع فيه ما شاء، وكان يعقوب حين ولد له يوسف قد كان حضنته عمته، فكان معها واليها، فلم يحب احد شيءا من الاشياء حبها اياه، حتي اذا ترعرع وبلغ سنوات ووقعت نفس يعقوب عليه اتاها فقال: يا اخية، اسلمي الي يوسف، فوالله ما اقدر ان يغيب عني ساعة، قال: وانا والله ما اقدر علي ان يغيب عني ساعة، قال: فوالله ما انا بتاركه، قالت: دعه عندي اياما حتي انظر اليه، واسكن عنه لعل ذلك يسليني عنه، او كما قالت، فلما خرج من عندها يعقوب عمدت الي منطقة اسحاق فحزمتها علي يوسف تحت ثيابها ثم قالت: فقدت منطقة اسحاق، فانظروا من اخذها ومن اصابها فالتمست، ثم قالت: كشفوا اهل البيت فكشفوهم، فوجدوها مع يوسف، فقالت: والله انه المسلم ما اصنع؟ اصنع فيه ما شءت، قال: واتاها يعقوب، فاخبرته الخبر، فقال: انت وذلك ان كان فعل ذلك فهو سلم لك ما استطيع غير ذلك، فامسكته فما قدر عليه يعقوب حتي ماتت، فهو الذي يقول اخوة يوسف حين صنع باخيه ما صنع
  [ص: ]
 حين اخذه: {ان يسرق فقد سرق اخ له من قبل فاسرها يوسف في نفسه ولم يبدها لهم} [يوسف: ] الي قوله: {والله اعلم بما تصفون} [يوسف: ] "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر، ثنا اسباط، عن السدي، قال: " فلما استخرجها يعني: من الوعاء، انقطعت ظهورهم، وهلكوا وقالوا: ما يزال لنا منكم بلاء يا بني راحيل، متي اخذت هذا الصواع؟ قال بنيامين: بنو راحيل الذي لا يزال لهم منكم بلاء، ذهبتم باخي فاهلكتموه في البرية، وما وضع هذا الصواع في رحلي الا الذي وضع الدراهم في رحالكم، قال: لا تذكر الدراهم، فنءخذ بها فوقعوا فيه وشتموه، فلما ادخلوهم علي يوسف، دعا الصواع، ثم نقر فيه، ثم ادناه من اذنه، ثم قال: «ان صواعي هذا ليخبرني انكم كنتم اثني عشر اخا، وانكم انطلقتم باخ لكم فبعتموه» ، فلما سمعها بنيامين قام فسجد ليوسف، وقال: ايها الملك سل صواعك هذا، احي ذلك ام لا؟ فنقره يوسف، ثم قال: «نعم، هو حي وسوف تراه» ، قال: اصنع بي ما شءت، فانه ان علم بي استنقذني، فدخل يوسف فبكي، ثم توضا فنقر فيه، فقال بنيامين: ايها الملك اني اراك تضرب بصواعك فيخبرك الحق، فسله من صاحبه؟ فنقر فيه، ثم قال: " ان صواعي هذا غضبان، يقول: كيف تسالني من صاحبي وقد رايت مع من كنت "، وكان بنو يعقوب اذا غضبوا لم يطاقوا فغضب روبيل، فقام فقال: يا ايها الملك، والله لتتركنا او لاصيحن صيحة لا تبقي امراة حامل بمصر الا طرحت ما في بطنها، وقامت كل شعرة من جسد روبيل تخرج من ثيابه، فقال يوسف لابنه: مر الي جنب روبيل فمسه، وكان بنو يعقوب اذا غضب احدهم فمسه الاخر ذهب غضبه، فمر الغلام الي جانبه فمسه فذهب غضبه، فقال: من هذا؟ ان في هذا البلاد لبزرا من بزر يعقوب، قال يوسف: «ومن يعقوب» ؟ فغضب روبيل فقال: يا ايها الملك: لا تذكرن يعقوب فانه سري الله ابن ذبيح الله ابن خليل الله، فقال يوسف: «انت اذا ان كنت صادقا»
 
  قوله تعالي: {فاسرها يوسف في نفسه ولم يبدها لهم} 
 [يوسف: ]
 
    
 اخبرنا محمد بن سعد العوفي، فيما كتب الي، حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، عن عبد الله بن عباس، قوله: " {فاسرها يوسف في نفسه ولم يبدها لهم} [يوسف: ] يقول: اسر في نفسه قوله: {انتم شر مكانا والله اعلم بما تصفون} [يوسف: ] "
 
  قوله تعالي: {قال انتم شر مكانا} 
 [يوسف: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {انتم شر مكانا والله اعلم بما تصفون} [يوسف: ] يوسف عليه السلام يقوله "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " فلما سمعها يوسف: {قال انتم شر مكانا} [يوسف: ] سرا في نفسه: {ولم يبدها لهم} [يوسف: ] "
 
  قوله تعالي: {والله اعلم بما تصفون} 
 [يوسف: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {والله اعلم بما تصفون} [يوسف: ] تقولون "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، عن سعيد بن ابي عروبة، عن قتادة، قوله: " {والله اعلم بما تصفون} [يوسف: ] اي: بما تكذبون "
 
  قوله تعالي: {قالوا يا ايها العزيز ان له ابا شيخا كبيرا} 
 [يوسف: ]
 
    
 حدثنا محمد بن العباس، مولي بني هاشم ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، قال: ثم قالوا ليوسف: " {يا ايها العزيز ان له ابا شيخا كبيرا} [يوسف: ] "
 
  قوله تعالي: {فخذ احدنا مكانه انا نراك من المحسنين} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، ثم قالوا: ليوسف: " {ان له ابا شيخا كبيرا فخذ احدنا مكانه انا نراك من المحسنين} [يوسف: ] اي انا نري ذلك منك احسانا ان فعلت "
 
  قوله تعالي: {قال معاذ الله ان ناخذ الا من وجدنا متاعنا عنده انا اذا لظالمون}
 
    
 وبه عن ابن اسحاق: " {قال معاذ الله ان ناخذ الا من وجدنا متاعنا عنده انا اذا لظالمون} قال: ما كنا لناخذ به بريءا بظن فان ذلك لظلم ان فعلنا "
 
  قوله تعالي: {فلما استيءسوا منه}
 
    
 وبه عن ابن اسحاق: " {فلما استيءسوا} اي: فلما يءسوا منه وراوا شدته في امره "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي، فقال لهم يوسف: «اذا اتيتم اباكم فاقرءوا عليه السلام، وقولوا له ان ملك مصر يدعو لك ان لا تموت حتي تري ابنك يوسف حتي يعلم ابوكم ان في الارض صديقين مثله، فلما يءسوا منه واخرج لهم شمعون»
 
  قوله تعالي: {خلصوا نجيا} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: " {خلصوا نجيا} [يوسف: ] قال: خلصوا وحدهم نجيا "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {خلصوا نجيا} [يوسف: ] اي: خلا بعضهم ببعض "
 
  قوله تعالي: {قال كبيرهم الم تعلموا} 
 [يوسف: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {قال كبيرهم} [يوسف: ] شمعون الذي تخلف واكبر منه في الميلاد، روبيل "
 
  الوجه الثاني:
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، انا سعيد بن بشير، ثنا قتادة، قوله: " {قال كبيرهم} [يوسف: ] وهو روبيل، وهو الذي كان نهاهم عن قتله، وكان اكبر القوم "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: " {كبيرهم} [يوسف: ] وهو روبيل اخو يوسف، وهو ابن خالته "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، ثنا اسباط، عن السدي: " {قال كبيرهم} [يوسف: ] وهو روبيل، ولم يكن باكبرهم سنا، ولكن كان كبيرهم في العلم "
 
    
 حدثنا محمد بن العباس، مولي بني هاشم ثنا عبد الرحمن بن سلمة، ثنا
  [ص: ]
 سلمة، عن محمد بن اسحاق: " فقال روبيل كما ذكر لي وكان كبير القوم: {الم تعلموا ان اباكم قد اخذ عليكم موثقا من الله} [يوسف: ] "
 
  قوله تعالي: {فلن ابرح الارض حتي ياذن لي ابي} 
 [يوسف: ]
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن ابن اسحاق، قوله: " {فلن ابرح الارض حتي ياذن لي ابي} [يوسف: ] قال: لن ابرح الارض التي انا بها حتي ياذن لي ابي، اي: بالخروج "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قوله: {فلن ابرح الارض حتي ياذن لي ابي} [يوسف: ] فاقام روبيل بمصر، واقبل النفر الي يعقوب فبكي، وقال: «يا بني ما تذهبون من مرة الا نقصتم واحدا»
 
  قوله تعالي: {او يحكم الله لي} [يوسف: ] الاية
 
    
 حدثنا ابي، ثنا عبد المءمن بن علي، ثنا عبد السلام بن حرب، انبا اسماعيل، عن ابي صالح، في قوله: " {فلن ابرح الارض حتي ياذن لي ابي او يحكم الله لي} [يوسف: ] قال: بالسيف "
 
  قوله تعالي: {ارجعوا الي ابيكم} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {ارجعوا الي ابيكم} [يوسف: ] فاني ماكث لا ارجع حتي ياتيني امره "
 
  قوله تعالي: {فقولوا يا ابانا ان ابنك سرق وما شهدنا الا بما علمنا} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا عفان، ثنا حسام، عن ابي معشر، عن ابراهيم: " انه كره ان يكتب الرجل شهادته، فاذا استشهد شهد، ويقول: {وما شهدنا الا بما علمنا} [يوسف: ] "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {ارجعوا الي ابيكم فقولوا يا ابانا ان ابنك سرق وما شهدنا الا بما علمنا} [يوسف: ] اي قد اخذت السرقة من رحله، ونحن ننظر "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انبا اصبغ، قال: سمعت عبد الرحمن بن زيد، يقول: " {ما شهدنا الا بما علمنا} [يوسف: ] لم نشهد ان السارق يءخذ بسرقته
  [ص: ]
 الا وذلك الذي علمنا، قال: وكان الحكم عند الانبياء: يعقوب وبنيه: ان يءخذ السارق بسرقته عندما يسرق "
 
  قوله تعالي: {وما كنا للغيب حافظين} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا معاذ بن اسد المروزي، ثنا الفضل بن موسي، عن الحسين بن واقد، عن يزيد، عن عكرمة، في قوله: " {وما كنا للغيب حافظين} [يوسف: ] ما كنا نعلم ان ابنك يسرق "
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا ابو الجماهر، انا سعيد بن بشير، ثنا قتادة: " {وما كنا للغيب حافظين} [يوسف: ] اي: ما كنا نشعر ان ابنك يسرق "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {وما كنا للغيب حافظين} [يوسف: ] فلا علم لنا بالغيب "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد، يقول في قوله: " {وما كنا للغيب حافظين} [يوسف: ] قال: ما علمنا من الغيب انه اخذ له شيءا، ولا ظننا ذلك، انما سالنا ما جزاء السارق؟ "
 
  قوله تعالي: {واسال القرية التي كنا فيها} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا ابو الجماهر، انبا سعيد بن بشير، ثنا قتادة قوله: " {واسال القرية التي كنا فيها} [يوسف: ] وهي: مصر "
 
  قوله تعالي: {والعير التي اقبلنا فيها} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابن ابي عمر العدني، ثنا سفيان، عن ابن جريج، عن مجاهد، في قوله: " واسال العير، قال: هي حمير "
 
    
 حدثنا علي بن الحسن، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، قال: " وقد عرف روبيل في رجع قوله لاخوته، انهم اهل تهمة عند ابيهم، لما كانوا صنعوا في يوسف، وقوله: {واسال القرية التي كنا فيها} [يوسف: ] فقد علموا ما علمنا، وشهدوا ما شهدنا، ان كنت لا تصدقنا: {وانا لصادقون} [يوسف: ] "
 
  قوله تعالي: {قال بل سولت لكم انفسكم امرا} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: " {بل سولت لكم انفسكم امرا} [يوسف: ] اي: زينت لكم انفسكم امرا "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن ابن اسحاق، قال: " فلما جاءوا الي يعقوب اتهمهم، وظن انهم كفعلتهم بيوسف، ثم قال: {بل سولت لكم انفسكم امرا فصبر جميل} [يوسف: ] "
 
  قوله تعالي: {فصبر جميل} 
 [يوسف: ]
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قال: واقبل النفر الي يعقوب فاخبروه الخبر، فبكي وقال: " يا بني ما تذهبون من مرة الا نقصتم واحدا، ذهبتم فنقصتم يوسف، ثم ذهبتم الثانية فنقصتم شمعون، ثم ذهبتم الثالثة فنقصتم بنيامين، وروبيل: {فصبر جميل عسي الله ان ياتيني بهم جميعا} [يوسف: ] "
 
  قوله تعالي: {عسي الله ان ياتيني بهم جميعا} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انبا سعيد بن بشير، عن قتادة، قوله: " {عسي الله ان ياتيني بهم جميعا} [يوسف: ] اي: يوسف واخيه وروبيل "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {عسي الله ان ياتيني، بهم جميعا} [يوسف: ] اي بيوسف، واخيه، وروبيل "
 
  قوله تعالي: {انه هو العليم الحكيم} [يوسف: ] قد تقدم تفسيره
 
    
 حدثنا محمد بن يحيي، ثنا ابو غسان، ثنا سلمة، قال: قال محمد بن اسحاق، حدثني محمد بن جعفر بن الزبير، قوله: " {الحكيم} [يوسف: ] قال: الحكيم في عذره وحجته الي عباده "
 
  قوله تعالي: {وتولي عنهم} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق
  [ص: ]
 : " {وتولي عنهم} [يوسف: ] اي: اعرض عنهم، وتتام حزنه وبلغ مجهوده حين لحق بيوسف اخوه، وهيج عليه حزنه علي يوسف "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا ابو زهير، ثنا بعض اصحابنا، عن ابي روق، قال: " لما احتبس يوسف اخاه بسبب السرقة، قال: كتب اليه يعقوب: من يعقوب بن اسحاق بن ابراهيم خليل الله الي يوسف عزيز فرعون، اما بعد: فانا اهل بيت موكل بنا البلاء، ان ابي ابراهيم القي في النار فصبر فجعلها الله عليه بردا وسلاما، وان ابي اسحاق قرب للذبح في الله فصبر، ففداه الله بذبح عظيم، وان الله كان قد وهب لي قرة عين فسلبنيه، لحمي علي عظمي، فلا ليلي ليل ولا نهاري نهار، والاسير الذي في يديك بما ادعي عليه من السرق اخوه لامه فكنت اذا ذكرت اسفي عليه قربته مني فسلا عني بعض ما كنت اجد، وقد بلغني انك حبسته بسبب سرقة فخل سبيله فاني لم الد سارقا، وليس بسارق، والسلام "
 
  قوله تعالي: {وقال يا اسفي علي يوسف} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {يا اسفي علي يوسف} [يوسف: ] قال: يا حزنا علي يوسف " وروي عن الضحاك، وقتادة مثل ذلك
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {يا اسفي علي يوسف} [يوسف: ] يا جزعا "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {وقال يا اسفي علي يوسف} [يوسف: ] قالوا: جهلا وظلما "
 
    
 حدثنا عمرو الاودي، ثنا وكيع، عن سفيان، عن سفيان الاسدي، عن سعيد بن جبير، قال: " ما اعطيت امة مثل ما اعطيت هذه الامة: {الذين اذا اصابتهم مصيبة قالوا انا لله وانا اليه راجعون} [البقرة: ] الم تسمع الي قول يعقوب: {يا اسفي علي يوسف} [يوسف: ] ولو اعطيها احد اعطيها يعقوب "
 
  قوله تعالي: {وابيضت عيناه من الحزن} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابو سلمة، ثنا حماد بن سلمة، عن علي بن زيد، عن الحسن، عن الاحنف بن قيس، ان النبي صلي الله عليه وسلم قال: " ان داود عليه السلام قال: يا رب: ان بني اسراءيل يسالونك بابراهيم، واسحاق، ويعقوب فاجعلني لهم رابعا، فاوحي الله عز وجل اليه، ان يا داود: ان ابراهيم القي في النار بسبب فصبر، وتلك بلية لم تنلك، وان اسحاق بذل مهجة دمه في سبب فصبر، وتلك بلية لم تنلك، وان يعقوب اخذت منه حبيبه حتي ابيضت عيناه من الحزن، فصبر، وتلك بلية لم تنلك "
 
    
 حدثنا ابي، ثنا ابن نفيل الحراني، ثنا نضر بن عربي، قال: " بلغني ان يعقوب، عليه السلام لما طال حزنه علي يوسف ذهبت عيناه من الحزن وهو كظيم جعل العواد يدخلون عليه فيقولون: السلام عليك يا نبي الله، كيف تجدك؟ فيقول شيخ كبير، قد ذهب بصري فاوحي الله عز وجل اليه يا يعقوب شكوتني الي عوادك؟ قال: اي رب هذا ذنب عملته، لا اعود اليه، فلم يزل بعد يقول: {انما اشكو بثي وحزني الي الله واعلم من الله ما لا تعلمون} [يوسف: ] "
 
    
 اخبرنا يونس بن عبد الاعلي، ثنا ابن وهب، اخبرني يزيد بن يونس بن يزيد، عن الحسن بن الحر، عن ليث بن ابي سليم، ان جبريل، دخل علي يوسف في السجن فعرفه فقال له: " ايها الملك الكريم علي ربه هل لك علم بيعقوب؟ قال: نعم، قال: ما فعل؟ قال: {وابيضت عيناه من الحزن} [يوسف: ] عليك، قال: فما بلغ من حزنه؟ قال حزن سبعين، قال: هل له علي ذلك من اجر؟ قال: نعم، اجر ماءة شهيد "
    
 حدثنا اسماعيل بن ابي الحارث، ثنا خلف بن تميم، ثنا محمد بن عبد العزيز التيمي، قال: سمعت السدي يقول نحو ذلك.
    
 حدثنا ابي، ثنا ابو اليمان، ثنا اسماعيل بن عياش، عن محمد بن اسحاق، عن لية بن ابي سليم، عن مجاهد، بنحوه، غير انه قال: ذهب بصره، وقال: له اجر سبعين شهيدا
 
  قوله تعالي: {فهو كظيم} 
 [يوسف: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن شبل، عن ابن ابي نجيح، عن مجاهد: " {فهو كظيم} [يوسف: ] قال: كظيم الحزن وروي عن السدي نحو ذلك "
 
    
 حدثنا ابي، ثنا هشام بن عبيد الله، وعبدة بن سليمان، قالا: ثنا ابن المبارك، انا معمر، عن قتادة: " {وابيضت عيناه من الحزن فهو كظيم} [يوسف: ] قال: كظم علي الحزن، فلم يقل الا خيرا "
 
    
 حدثنا علي بن الحسين، ثنا القاسم بن عيسي الطاءي الواسطي، ثنا هشيم، عن جويبر، عن الضحاك، قال: «الكظيم الكميد»
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، انبا سعيد بن بشير، ثنا قتادة: " {فهو كظيم} [يوسف: ] اي: سكت، يكظم حزنه ويردده في جوفه "
 
  قوله تعالي: {قالوا تالله تفتا تذكر يوسف} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا عبد الله بن رجاء، انبا اسراءيل، عن سماك، عن عكرمة، عن ابن عباس، في قوله: " {تفتا تذكر يوسف} [يوسف: ] قال: لا تزال تذكر يوسف "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {تفتا تذكر يوسف} [يوسف: ] ، تفتء من حبه تزال تذكر يوسف "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قال له بنوه: " {تالله تفتا تذكر يوسف حتي تكون حرضا} [يوسف: ] اما تفتء: فتزال "
 
  قوله تعالي: {حتي تكون حرضا او تكون من الهالكين} 
 [يوسف: ]
 
    
 حدثنا محمد بن اسماعيل الاحمسي، ثنا ابو يحيي الحماني، ثنا عثمان، عن عتبة يعني ابن اليقظان، عن عكرمة، عن ابن عباس: {حتي تكون حرضا} [يوسف: ] قال: دنفا من المرض "
 
 حدثنا ابو سعيد الاشج، ثنا ابن فضيل، عن ليث، عن مجاهد قوله: {حرضا} [يوسف: ] قال: الحرض: ما دون الموت "
 
 حدثنا ابي، ثنا ابن نفيل، ثنا مسكين، عن شعبة، عن السدي، في قوله: " {حتي تكون حرضا} [يوسف: ] قال: حتي تكاد ان تموت "
 
    
 حدثنا ابي، ثنا مسلم بن ابراهيم، ثنا ابو بكر الهذلي، عن الحسن: " {حتي تكون حرضا} [يوسف: ] قال: هرما "
 
    
 حدثنا علي بن الحسين، ثنا ابن ابي مريم، ثنا مفضل، عن ابي صخر، في قوله {حرضا} [يوسف: ] قال: " اما الحرض فيقولون: لا يعقل ولا ينتفع به "
 
    
 حدثنا علي بن الحسين، ثنا ابو بكر بن ابي شيبة، ثنا مروان، عن جويبر، عن الضحاك، قال: الحرض: الشء البالي "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن ابن اسحاق: " {حتي تكون حرضا} [يوسف: ] اي: فاسدا لا عقل لك "
 
  قوله تعالي: {او تكون من الهالكين} 
 [يوسف: ]
 
    
 حدثنا محمد بن اسماعيل الاحمسي، ثنا ابو يحيي الحماني، ثنا عثمان بن سعد، عن عتبة بن اليقظان، عن عكرمة، عن ابن عباس: " {او تكون من الهالكين} [يوسف: ] قال: من الميتين " وروي عن مجاهد، والحسن، والضحاك، والربيع بن انس، وقتادة، والسدي مثل ذلك
 
  قوله تعالي: {قال انما اشكو بثي وحزني الي الله} 
 [يوسف: ]
 
    
 حدثنا الحسن بن عرفة، ثنا يحيي بن عبد الملك بن ابي غنية، عن حفص بن عمر بن ابي الزبير، عن انس، قال: قال رسول الله صلي الله عليه وسلم: " كان ليعقوب النبي اخ مواخ له، فقال ذات يوم: ما الذي اذهب بصرك، وقوس ظهرك؟ قال: اما الذي اذهب بصري، فالبكاء علي يوسف، واما الذي قوس ظهري، فالحزن علي بنيامين، فاتاه جبريل، فقال: يا يعقوب، ان الله يقرءك السلام ويقول: اما تستحي ان تشكوني الي غيري، فقال يعقوب: {انما اشكو بثي وحزني الي الله} [يوسف: ] ، فقال جبريل: الله اعلم بما تشكو "
 
    
 حدثنا ابو سعيد الاشج، ثنا عقبة، عن عبد الرحمن بن زياد الافريقي، عن
  [ص: ]
 مسلم بن يسار، رفع الحديث {انما اشكو بثي} [يوسف: ] قال: «من بث لم يصبر، ثم قرا الاية»
 
    
 حدثنا ابي، ثنا هوذة، ثنا عوف، عن الحسن: " {انما اشكو بثي وحزني الي الله} [يوسف: ] ، قال: حاجتي وحزني "
 
 حدثني ابي، ثنا علي بن محمد الطنافسي، ثنا ابو داود الحفري، عن سفيان، عن اسلم، عن حبيب، قال: كان يعقوب قد بلغ من الكبر حتي كان حاجباه ترفعان بخرقة، فقال له رجل: " ما بلغ لك ما اري؟ قال: طول الزمان، وكثرة الحزن فاوحي الله اليه اتشكوني؟ قال: خطيءة يا رب فاغفر لي "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو احمد الزبيري، عن سفيان، في قوله: " {انما اشكو بثي} [يوسف: ] قال: همي "
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، انبا سعيد بن بشير، ثنا قتادة، قوله: " {انما اشكو بثي وحزني الي الله} [يوسف: ] قال: ذكر لنا ان نبي الله يعقوب صلي الله عليه وسلم لم يزل به شدة بلاء قط الا اتاه حسن ظنه بالله من وراء بلاءه "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، فقال عن علم، بالله: " {انما اشكو بثي وحزني الي الله} [يوسف: ] لما راي من فظاظتهم، وغلظتهم، وسوء لفظهم له، ولم اشك ذلك اليكم: {واعلم من الله ما لا تعلمون} [الاعراف: ] "
 
    
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، عن ابن عباس، في قوله: " {واعلم من الله ما لا تعلمون} [الاعراف: ] يقول: اعلم ان رءيا يوسف صادقة، واني اعلم من الله ما لا تعلمون، يقول: اعلم ان رءيا يوسف صادقة، واني سوف اسجد له "
 
  قوله تعالي: {يا بني اذهبوا فتحسسوا من يوسف واخيه} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابن نفيل الحراني، ثنا النضر بن عربي، قال: " بلغني ان يعقوب، مكث اربعة وعشرين عاما لا يدري احي يوسف ام ميت، حتي تمثل له ملك الموت، فقال له: من انت؟ قال: انا ملك الموت، قال: فقال: انشدك باله يعقوب
  [ص: ]
 هل قبضت روح يوسف؟ قال: لا، فعند ذلك قال: {يا بني اذهبوا فتحسسوا من يوسف واخيه ولا تياسوا من روح الله} [يوسف: ] "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق، ثم ان يعقوب قال لبنيه وهو علي حسن ظنه بربه، مع الذي هو فيه من الحزن: " يا بني اذهبوا الي هذه البلاد التي منها جءتم {فتحسسوا من يوسف واخيه ولا تياسوا من روح الله} [يوسف: ] "
 
  قوله تعالي: {ولا تياسوا من روح الله} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انا سعيد بن بشير، ثنا قتادة: {ولا تياسوا من روح الله} [يوسف: ] اي: من رحمة الله "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، قوله: " {ولا تياسوا من روح الله} [يوسف: ] اي من فرجة الله "
 
  قوله تعالي: {انه لا يياس من روح الله الا القوم الكافرون} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {انه لا يياس من روح الله} [يوسف: ] اي: من فرجة الله: {الا القوم الكافرون} [يوسف: ] "
 
  قوله تعالي: {فلما دخلوا عليه} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي بن مهران، ثنا عامر بن الفرات، عن اسباط، عن السدي، يعني قوله: " {فلما دخلوا عليه} [يوسف: ] قال: فلما رجعوا اليه قالوا: {يا ايها العزيز مسنا واهلنا الضر} [يوسف: ] "
 
  قوله تعالي: {يا ايها العزيز مسنا واهلنا الضر} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انبا سعيد بن بشير، ثنا قتادة: " {يا ايها العزيز مسنا واهلنا الضر} [يوسف: ] اي: الضر في المعيشة "
 
    
 حدثنا ابي، ثنا ابن نفيل الحراني، ثنا النضر بن عربي، قال: بلغني ان يعقوب، قال: " {يا بني اذهبوا فتحسسوا من يوسف واخيه} [يوسف: ] فخرجوا الي مصر، فلما دخلوا عليه لم يجدوا كلاما ارق من كلام استقبلوه به، فقالوا: {يا ايها العزيز مسنا واهلنا الضر} [يوسف: ] "
 
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن ابن اسحاق: " {فلما دخلوا عليه قالوا يا ايها العزيز} [يوسف: ] رجاء ان يرحمهم في شان اخيهم: {مسنا واهلنا الضر} [يوسف: ] "
 
  قوله تعالي: {وجءنا ببضاعة} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: " {وجءنا ببضاعة} [يوسف: ] قال: دراهم "
 
  الوجه الثاني:
 
    
 حدثنا الحسن بن ابي الربيع، انا عبد الرزاق، عن ابن عيينة، عن عثمان بن ابي سليمان، عن ابن ابي مليكة، سمعت ابن عباس، في قوله: " {وجءنا ببضاعة مزجاة} [يوسف: ] قال: رثة، متاع خلق الحبل والغرارة والشء "
 
  والوجه الثالث:
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن ادريس، عن يزيد بن ابي زياد، عن عبد الله بن الحارث: " {وجءنا ببضاعة مزجاة} [يوسف: ] قال: متاع الاعراب الصوف والسمن "
 
  والوجه الرابع:
 
    
 حدثنا ابي، ثنا يوسف الصفار، ثنا مروان بن معاوية الفزاري، حدثني ابو اسماء العدوي، عن مروان بن عمرو العدوي، عن ابي صالح، في قوله: " {وجءنا ببضاعة مزجاة} [يوسف: ] قال: بطم: الحبة الخضراء، وصنوبر "
 
  قوله: {مزجاة} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا عبد الله بن صالح بن مسلم، ثنا اسراءيل، عن سماك، عن عكرمة، عن ابن عباس، قوله: " {ببضاعة مزجاة} [يوسف: ] قال: الورق الرذل: الرديءة التي لا تنفق حتي يوضع منها "
 
    
 حدثنا ابو عبد الله محمد بن حماد الطهراني، انبا حفص بن عمر، ثنا الحكم بن ابان، عن عكرمة، في قول بني يعقوب ليوسف: " {وجءنا ببضاعة مزجاة} [يوسف: ] قال: دراهم زيف "
 
  الوجه الثاني:
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو بكر بن عياش، عن ابي حصين، عن
  [ص: ]
 سعيد بن جبير، وعكرمة: " {وجءنا ببضاعة مزجاة} [يوسف: ] قال احدهما: ناقصة، وقال الاخر فسول "
 
  الوجه الثالث:
 
    
 حدثنا الاشج، ثنا ابن ادريس، عن ابيه، عن عطية: " {وجءنا ببضاعة مزجاة} [يوسف: ] قال: غير طاءل "
 
  الوجه الرابع:
 
    
 حدثنا الاشج، ثنا عمرو العنقزي، عن الهذلي، عن الحسن، في قوله: " {وجءنا ببضاعة مزجاة} [يوسف: ] قال: قليلة " وروي عن عكرمة، وابراهيم مثل ذلك
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {مسنا واهلنا الضر وجءنا ببضاعة مزجاة} [يوسف: ] اي: قليلة لا تبلغ ما كنا نشتري منك الا ان تتجاوز لنا "
 
  قوله تعالي: {فاوف لنا الكيل} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي، قوله: " {فاوف لنا الكيل} [يوسف: ] بها كما تعطينا بالدراهم الجيدة "
 
    
 حدثنا علي بن الحسين، ثنا ابو الطاهر، انبا ابن وهب، عن مالك بن انس، وسءل: " اتري ان يءخذ، اجر الكيالين من المشتري؟ قال مالك: ان الصواب والذي يقع في قلبي ان تكون علي الباءع، وقد قال اخوة يوسف: {فاوف لنا الكيل وتصدق علينا} [يوسف: ] وكان يوسف هو الذي يكيل "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، قوله: " {فاوف لنا الكيل} [يوسف: ] اي: اعطنا ما كنت تعطينا قبل ذلك "
 
    
 حدثنا يونس بن حبيب، ثنا ابو داود، عن قيس، عن ابي حصين، عن سعيد بن جبير، في قول الله: " {فاوف لنا الكيل وتصدق علينا} [يوسف: ] قال: كانت الدراهم فسولا ". وروي عن ابي حصين، عن عكرمة، قال: «ناقصة»
 
  قوله تعالي: {وتصدق علينا} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن ابي بكر المقدمي، ثنا عامر بن
  [ص: ]
 صالح، عن ابي بكر الهذلي، قال: سالت الحسن: " {فاوف لنا الكيل وتصدق علينا} [يوسف: ] قال: بنقصان دراهمنا، فسالت سعيد بن جبير، فقال: الانبياء لا ياكلون الصدقة، كانت نفاية لا تجوز بينهم فقال: تجوز عنا "
 
    
 ذكر عن عمرو بن محمد العنقزي، انا اسباط، عن السدي: " {وتصدق علينا} [يوسف: ] بفضل ما بين الجياد الرديءة "
 
  قوله تعالي: {ان الله يجزي المتصدقين} 
 [يوسف: ]
 
    
 حدثنا مروان بن سالم المكي، ثنا عيسي بن يونس، عن عبد الرحمن بن يزيد بن جابر، عن عبد الرحمن الطويل، قال: " جاء رجل الي عمر بن عبد العزيز، فقال: تصدق علي تصدق الله عليك بالجنة يا امير المءمنين، فقال: ويحك ان الله لا يتصدق، ولكن الله يجزي المتصدقين "
    
 حدثنا ابي، ثنا ابراهيم بن محمد المقدسي، ثنا ايوب بن سويد، عن ابن جابر، قال: قال رجل لعمر بن عبد العزيز تصدق علي. . الحديث
 
  قوله تعالي: {قال هل علمتم ما فعلتم بيوسف واخيه اذ انتم جاهلون} 
 [يوسف: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: " {قال هل علمتم ما فعلتم بيوسف واخيه اذ انتم جاهلون} [يوسف: ] قال: قال لهم يوسف ورحمهم "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، عن محمد بن اسحاق، قال: فذكر لي والله اعلم انهم لما كلموه بهذا الكلام غلبته نفسه فارفض دمعه باكيا، ثم باح لهم بالذي كان يكتم منهم: " {قال هل علمتم ما فعلتم بيوسف واخيه اذ انتم جاهلون} [يوسف: ] "
 
  قال تعالي: {قالوا اءنك لانت يوسف قال انا يوسف وهذا اخي قد من الله علينا}
 
    
 حدثنا ابي، ثنا احمد بن ابراهيم الدورقي، ثنا العلاء بن عبد الجبار، ثنا يزيد بن يزيد، عن ثابت البناني، قال: قيل لبني يعقوب: " ان بمصر رجلا يطعم
  [ص: ]
 المسكين، ويملا حجر اليتيم، قالوا: ينبغي ان يكون هذا منا اهل البيت، فنظروا فاذا هو يوسف بن يعقوب "
 
    
 حدثنا ابي، ثنا ابن ابي عمر العدني، ثنا سفيان، عن ابن ابي الجلد، قال قال له اخوه: " يا ايها العزيز: لقد ذهب لي اخ ما رايت اشبه به احد منك لكانه الشمس، فقال له يوسف: اسال اله يعقوب ان يرحم صباك، وان يرد اليك اخاك "
 
    
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، قال: " فلم يعن بذكر اخيه ما صنع هو فيه حين اخذه، وذلك للتفريق بينه وبين اخوته، اذ صنعوا بيوسف ما صنعوا، فلما قال لهم ذلك كشف لهم الغطاء فعرفوه، فقالوا: {اءنك لانت يوسف قال انا يوسف وهذا اخي قد من الله علينا انه من يتق ويصبر فان الله لا يضيع اجر المحسنين} "
 
  قوله تعالي: {انه من يتق ويصبر} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن، ثنا عبد الله بن ابي جعفر الرازي، عن ابيه، عن الربيع بن انس، قال: " مكتوب في الكتاب الاول: ان الحاسد لا يضر بحسده، وان المحسود اذا صبر نجاه تصبره، لان الله يقول {من يتق ويصبر فان الله لا يضيع اجر المحسنين} [يوسف: ] "
 
    
 ذكر عن يوسف بن موسي، ثنا عاصم بن مضرس، امام مسجد الجامع، ثنا سفيان الثوري، عن منصور، عن ابراهيم: " {انه من يتق ويصبر} [يوسف: ] قال: من يتق الزنا ويصبر علي العزوبة "
 
  قوله تعالي: {قالوا تالله لقد اثرك الله علينا} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: " {قالوا تالله لقد اثرك الله علينا} [يوسف: ] . وذلك بعدما عرفهم نفسه، لقوا رجلا حليما "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {اثرك الله علينا} [يوسف: ] ، اي: فضلك الله علينا "
 
  قوله تعالي: {وان كنا لخاطءين} 
 [سورة: يوسف، اية رقم: ]
 
    
 وبه عن ابن اسحاق: " {وان كنا لخاطءين} [يوسف: ] . اي: فيما صنعنا بك "
 
  قوله تعالي: {لا تثريب عليكم اليوم} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا محمد بن المصفي، ثنا معاوية بن حفص، عن اسراءيل، عن ابي يحيي، عن مجاهد: " {لا تثريب عليكم اليوم} [يوسف: ] قال: لا اباء "
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، انبا سعيد بن بشير، عن قتادة، قوله: " {لا تثريب عليكم اليوم يغفر الله لكم} [يوسف: ] . قال: لقوا رجلا حليما لم يبث، ولم يثرب عليهم اعمالهم "
 
    
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا عبد الرحمن بن سلمة، عن محمد بن اسحاق، قال: " {لا تثريب عليكم اليوم} [يوسف: ] . اي: لا تانيب عليكم اليوم فيما صنعتم "
 
    
 حدثنا ابي، ثنا ابن ابي عمر، قال: قال سفيان في قوله: " {لا تثريب عليكم اليوم} [يوسف: ] . قال: لا تعيير عليكم اليوم "
 
    
 حدثنا موهب بن يزيد بن موهب الرملي، ثنا ضمرة بن ربيعة، عن رجاء بن ابي سلمة، عن عطاء الخراساني، قال: " طلب الحواءج الي الشباب اسهل منها عند الشيوخ، الم تر الي قول يوسف: {لا تثريب عليكم اليوم} [يوسف: ] . وقال يعقوب: {سوف استغفر لكم ربي} [يوسف: ] "
 
  قوله تعالي: {يغفر الله لكم وهو ارحم الراحمين} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا عبد الله بن ابي زياد، ثنا سيار، ثنا جعفر، قال: سمعت ابا عمران الجوني يقول: " اما والله ما سمعنا بعفو قط مثل عفو يوسف، قال: {لا تثريب عليكم اليوم يغفر الله لكم وهو ارحم الراحمين} [يوسف: ] "
 
    
 حدثنا علي بن الحسين، ثنا المقدمي، ثنا دليم بن غزوان، ثنا مالك بن دينار، قال: ارسل رجل الي عشرة من اهل البصرة انا فيهم والحسن، فسلمنا عليه، ثم ان الحسن حمد الله واثني عليه، وذكر ما شاء الله ان يذكر، حتي اتي علي ذكر يوسف وما ارتكب منه اخوته فعرفهم نفسه، ثم استقبلهم بالعفو عنهم: {لا تثريب عليكم اليوم يغفر الله لكم} [يوسف: ] . فرضي الله به منه عملا واثبته في كتابه، ليءخذ به من بعده، فقال الامير: «لو صار ان اجللكم ببردي هذا ما اصابكم شء ابدا»
 
    
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا عبد الرحمن بن سلمة
  [ص: ]
 ، ثنا سلمة بن الفضل، عن محمد بن اسماعيل: " {يغفر الله لكم وهو ارحم الراحمين} [يوسف: ] . قال: حين اعترفوا بذنبهم "
 
  قوله تعالي: {اذهبوا بقميصي هذا فالقوه علي وجه ابي} 
 [يوسف: ]
 
    
 حدثنا المنذر بن شاذان، ثنا يعلي، ثنا زكريا، عن سماك، عن عامر، قال: «كان في قميص يوسف ثلاث ايات، حين قد قميصه من دبر، وحين القي علي وجه ابيه، فارتد بصيرا»
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي، ثم قال لهم: " ما فعل ابي بعدي؟ قالوا: لما فاته بنيامين عمي من الحزن فقال: {اذهبوا بقميصي هذا فالقوه علي وجه ابي يات بصيرا واتوني باهلكم اجمعين} [يوسف: ] . وقال يهوذا: انا ذهبت بالقميص الي يعقوب وهو متلطخ بالدماء، وقلت: ان يوسف قد اكله الذءب، انا اليوم اذهب اليه بالقميص، واخبره ان يوسف حي، فافرحه كما احزنته، فهو كان البشير "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا الحسن بن يحيي الخشني، عن الحكم، عن المطلب بن عبد الله بن حنطب، قال: " لما القي ابراهيم في النار كساه الله قميصا من قمص الجنة، وكساه ابراهيم اسحاق، وكساه اسحاق يعقوب، وكساه يعقوب يوسف، فطواه وجعله في قصبة فضة فجعله في عنقه، وكان في عنقه حين القي في الجب، وحين سجن، وحين دخل عليه اخوته، واخرج القميص من القصبة، فقال: {اذهبوا بقميصي هذا فالقوه علي وجه ابي يات بصيرا} [يوسف: ] فشم يعقوب ريح الجنة وهو بارض كنعان بفلسطين، فقال: {اني لاجد ريح يوسف} [يوسف: ] "
 
  قوله تعالي: {واتوني باهلكم اجمعين} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابن نفيل الحراني، ثنا زهير بن معاوية، ثنا ابو اسحاق، عن عبد الله، قال: «كان اهله حين ارسل اليهم وهو بمصر ثلاثة وتسعين انسانا رجالهم انبياء، ونساءهم صديقات، والله ما خرجوا مع موسي حتي بلغوا ستماءة الف، وسبعين الفا»
 
    
 حدثنا ابي، ثنا عبد الله بن ابي زياد، حدثني سيار، ثنا جعفر بن سليمان، قال: سمعت فرقدا، يقول: " لما بعث يوسف بالقميص الي يعقوب، اخذه
  [ص: ]
 فشمه ثم وضعه علي بصره، فرد الله عليه بصره، ثم حملوه اليه فلما دخلوا ويعقوب متكء علي ابن له يقال له يهوذا استقبله يوسف في الجنود والناس، فقال يعقوب: يا يهوذا هذا فرعون مصر؟ قال: لا يا ابت، ولكن هذا ابنك يوسف قيل له انك قادم فتلقاك في اهل مملكته والناس، قال: فلما لقيه ذهب يوسف ليبداه بالسلام، فمنع ذلك، ليعلم ان يعقوب اكرم علي الله منه فاعتنقه وقبله، وقال: السلام عليك ايها الذاهب الاحزان "
 
  قوله تعالي: {ولما فصلت العير} 
 [يوسف: ]
 
    
 حدثنا احمد بن عصام، ثنا مءمل بن اسماعيل، ثنا اسراءيل، ثنا ابو سنان، عن عبد الله بن ابي الهذيل، عن ابن عباس، في قوله: " {ولما فصلت العير} [يوسف: ] قال: لما خرجت العير "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قال: " {ولما فصلت العير} [يوسف: ] ، من مصر منطلقة الي الشام "
 
  قوله تعالي: {قال ابوهم اني لاجد ريح يوسف} 
 [يوسف: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن فضيل، عن ضرار بن مرة، عن ابن ابي الهذيل، عن ابن عباس، قال: «وجد يعقوب ريح قميص يوسف وهو منه علي مسيرة ثمان ليال»
 
    
 حدثنا ابي، ثنا عبد الله بن رجاء، انبا اسراءيل، عن مسلم الاعور، عن مجاهد، عن ابن عباس، قال: «وجد يعقوب ريح يوسف من مسيرة ستة ايام»
 
    
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {اني لاجد ريح يوسف} [يوسف: ] قال: وجد من مسيرة عشرة ايام "
 
    
 حدثنا ابي، ثنا ابن ابي عمر، ثنا سفيان، عن ابي سنان، عن ابن ابي الهذيل، قال: " سءل ابن عباس، وانا الي، جنبه، من كم وجد يعقوب ريح القميص؟ عن قول الله {اني لاجد ريح يوسف} [يوسف: ] قال: " وجده مسيرة ثمانين فرسخا، قال ابن ابي الهذيل: وهو ما بين البصرة والكوفة "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن
  [ص: ]
 الفرات، عن اسباط، عن السدي: " فلما فصلت العير من مصر منطلقة الي الشام وجد يعقوب ريح يوسف، وهو قوله: {قال ابوهم} [يوسف: ] لبني بنيه {اني لاجد ريح يوسف} [يوسف: ] "
 
  قوله تعالي: {لولا ان تفندون} 
 [يوسف: ]
 
    
 حدثنا احمد بن عصام الانصاري، ثنا مءمل، ثنا اسراءيل، ثنا ابو سنان، عن عبد الله بن ابي الهذيل، عن ابن عباس، في قوله: " {لولا ان تفندون} [يوسف: ] قال: ان تسفهون وروي، عن عطاء مثل ذلك "
 
  الوجه الثاني:
 
    
 حدثنا ابي، ثنا عبد الله بن رجاء، انا اسراءيل، عن مسلم، عن مجاهد، عن ابن عباس، قوله: " {لولا ان تفندون:} [يوسف: ] قال: لولا ان تكذبون "
 
  والوجه الثالث:
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو احمد الزبيري، ثنا اسراءيل، عن ابي يحيي، عن مجاهد، قال: «لولا ان تهرمون»
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انا اصبغ، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {لولا ان تفندون} [يوسف: ] قال: الذي ليس له عقل ذلك المفند، يقولون لا يعقل، قال: وقال الشاعر: مهلا فان من العقول مفندا "
 
  قوله تعالي: {قالوا تالله انك لفي ضلالك القديم} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: " {انك لفي ضلالك القديم} [يوسف: ] يقول في خطءك القديم "
 
  والوجه الثاني:
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {انك لفي ضلالك القديم} [يوسف: ] يقول: في جنونك القديم "
 
    
 حدثنا ابي، ثنا نصر بن علي، اخبرني ابي، عن قرة، عن الحسن، في قول الله: " {تالله انك لفي ضلالك القديم} [يوسف: ] . قال: عقوقا "
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن
  [ص: ]
 قتادة: " {قالوا تالله انك لفي ضلالك القديم} [يوسف: ] من حب يوسف ما تستليه ولا تنساه، فقالوا لابيهم كلمة غليظة لم يكن ينبغي لهم ان يقولوها لنبي الله ولا لابيهم "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، ثنا اسباط، عن السدي، قال: " قال له بنو بنيه: {تالله انك لفي ضلالك القديم} [يوسف: ] من شان يوسف "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، ثنا اسباط، عن السدي، قال: " قال له بنو بنيه: {تالله انك لفي ضلالك القديم} [يوسف: ] . من شان يوسف "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق: " {قالوا تالله انك لفي ضلالك القديم} [يوسف: ] . اي: انك لمن ذكر يوسف في الباطل الذي انت عليه "
 
  قوله تعالي: {فلما ان جاء البشير القاه علي وجهه فارتد بصيرا} 
 [يوسف: ]
 
    
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، عن ابن عباس، قوله: " {فلما ان جاء البشير القاه علي وجهه فارتد بصيرا} [يوسف: ] يقول: البشير البريد "
 
    
 اخبرنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {فلما ان جاء البشير} [يوسف: ] يهوذا بن يعقوب "
 
    
 ذكر، عن جعفر بن سليمان، عن لقمان الحنفي، قال: " بلغنا ان يعقوب، لما اتاه البشير، قال له: ما ادري ما اثيبك اليوم؟ ولكن هون الله عليك سكرة الموت "
 
 حدثنا علي بن الحسين، ثنا سليم بن منصور بن عمار، حدثني محمد بن عبد المجيد، عن الثوري، وعن مخلد بن حسين، عن هشام بن حسان، عن الحسن: " لما ان جاء البشير الي يعقوب فالقي عليه القميص، قال: علي اي دين خلفت يوسف؟ قال: علي الاسلام، قال: الان تمت النعمة "
 
    
 حدثنا ابي، ثنا ابن ابي عمر العدني، ثنا سفيان، قال: " {لما ان جاء البشير} ، قال يهوذا، قال: وكان ابن مسعود يقرا «وجاء البشير من بين يدي العير»
 
  قوله تعالي: {قال الم اقل لكم اني اعلم من الله ما لا تعلمون} 
 [يوسف: ]
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي: " {فلما
  [ص: ]
 ان جاء البشير} [يوسف: ] وهو يهوذا، القي القميص {علي وجهه فارتد بصيرا} [يوسف: ] قال يعقوب لبنيه: {الم اقل لكم اني اعلم من الله ما لا تعلمون} [يوسف: ] "
 
  قوله: {قالوا يا ابانا استغفر لنا ذنوبنا انا كنا خاطءين} 
 [يوسف: ]
 
    
 اخبرنا يونس بن عبد الاعلي، قراءة انا ابن وهب، حدثني الليث بن سعد: " ان يعقوب، واخوة يوسف اقاموا عشرين سنة يطلبون المغفرة مما فعل اخوة يوسف بيوسف لا يقبل ذلك منهم حتي لقي جبريل يعقوب صلي الله عليه وسلم فعلمه هذا الدعاء: «يا رجاء المءمنين لا تخيب رجاءي، ويا غوث المءمنين اغثني ويا عون المءمنين اعني، يا حبيب التوابين تب علي، فاستجيب لهم»
 
  قوله تعالي: {قال سوف استغفر لكم ربي} 
 [يوسف: ]
 
    
 حدثنا احمد بن عصام الانصاري، ثنا ابو احمد الزبيري، ثنا موسي بن محمد الانصاري، عن عبد الرحمن بن اسحاق، عن محارب بن دثار، عن عمه قال: غدوت بسحر فمررت بدار عبد الله بن مسعود، فسمعته يقول: اللهم امرتني فاطعتك ودعوتني فاجبتك، وهذا سحر فاغفر لي، فلما اصبحت اتيته فذكرت ذلك له، فقال: " ان يعقوب حين قال له بنوه: {استغفر لنا} [يوسف: ] اخرهم الي السحر " وروي عن ابراهيم النخعي، وابراهيم التيمي، وعكرمة، وابي جعفر محمد بن علي، وسعيد بن جبير، والسدي، وقتادة نحو ذلك
 
    
 حدثنا علي بن الحسين، ثنا القاسم بن خليفة، انا عمرو بن محمد، عن خلاد الصفار، عن عمرو بن قيس: " {سوف استغفر لكم ربي} [يوسف: ] قال: في صلاة الليل "
 
  قوله تعالي: {انه هو الغفور الرحيم} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، " قوله: {الغفور} [يوسف: ] يعني: غفور الذنوب: {الرحيم} [يوسف: ] يعني: رحيم بالمءمنين "
 
  قوله تعالي: {فلما دخلوا علي يوسف اوي اليه ابويه} 
 [يوسف: ]
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قوله: " {فلما دخلوا علي يوسف اوي اليه ابويه} [يوسف: ] ثم حملوا اهليهم وعيالهم فلما
  [ص: ]
 بلغوا مصر، كلم يوسف الملك فخرج معه , هو والملك يتلقونهم فلما لقيهم قال: {ادخلوا مصر ان شاء الله امنين} [يوسف: ] {فلما دخلوا علي يوسف اوي اليه ابويه} [يوسف: ] واخوته وهما ابوه وخالته "
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة، قوله: " {اوي اليه ابويه} [يوسف: ] قال: ابوه وامه ضمهما وقال: {ادخلوا مصر ان شاء الله امنين} [يوسف: ] "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة بن الفضل، انا ابو جعفر، عن الربيع بن انس، قال: «خرج يعقوب الي يوسف بمصر في اثنين وسبعين من ولده وولد ولده، فخرجوا منها مع موسي وهم ستماءة الف»
 
  قوله تعالي: {وقال ادخلوا مصر ان شاء الله امنين} 
 [يوسف: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، قال: «يعني به مصر فرعون»
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي، قال: " فخرج هو والملك يتلقونهم فلما لقيهم قال: {ادخلوا مصر ان شاء الله امنين} [يوسف: ] "
 
  قوله تعالي: {ورفع ابويه علي العرش} 
 [يوسف: ]
 
 حدثنا ابي، ثنا علي بن صالح بن وسيم الجوسقي، ثنا ابراهيم بن خالد الصنعاني، حدثني عمر بن عبد الرحمن يعني ابن مهرب، انه سمع وهبا، يقول في قوله: " {ورفع ابويه علي العرش} [يوسف: ] قال: ابوه وخالته وكانت توفيت ام يوسف في نفاس اخيه بنيامين "
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي: " {ابويه} [يوسف: ] ابوه وخالته، رفعهما علي العرش "
 
    
 حدثنا ابو زرعة، ثنا منجاب، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {ورفع ابويه علي العرش} [يوسف: ] قال: العرش: السرير، وفي موضع اخر: انما سمي العرش عرشا لارتفاعه "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن فضيل، عن عطاء بن الساءب، عن
  [ص: ]
 مجاهد، عن ابن عمر، قال: " اهتز العرش لحب لقاء الله سعدا، قال: انما يعني السرير: {ورفع ابويه علي العرش} [يوسف: ] "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عمرو بن هارون، ثنا هشام بن عبيد الله، ثنا عبد الرحمن بن زيد بن اسلم، عن ابيه، قوله: " {ورفع ابويه علي العرش} [يوسف: ] قال: مجلسه "
 
  قوله: {وخروا له سجدا} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن سعيد العطار، ثنا عبيدة بن حميد، عن عبد العزيز بن رفيع، عن تميم بن طرفة، عن عدي بن حاتم: " {وخروا له سجدا} [يوسف: ] قال: كانت تحية من كان قبلكم، فاعطاكم الله السلام مكانها "
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة: " {ورفع ابويه علي العرش وخروا له سجدا} [يوسف: ] وكان تحية من كان قبلكم السجود بها يحيي بعضهم بعضا، واعطي الله هذه الامة السلام، تحية اهل الجنة كرامة من الله ونعمة "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، قال: سمعت عبد الرحمن بن زيد، في قول الله تعالي: " {وخروا له سجدا} [يوسف: ] قال: السجود تشرفة، كما سجدت الملاءكة تشرفة لادم، وليس بسجود عبادة "
 
  قوله تعالي: {يا ابت هذا تاويل رءياي من قبل قد جعلها ربي حقا} 
 [يوسف: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبد الوهاب الخفاف، عن سليمان التيمي، عن ابي عثمان، عن سليمان، قال: «كان بين رءيا يوسف وعبارتها اربعون عاما»
 
    
 حدثنا ابو سعيد الاشج، ثنا عبد الوهاب الخفاف، عن سعيد بن ابي عروبة، عن قتادة، قال: «بينهما خمسة وثلاثون عاما»
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة، قوله: " {يا ابت هذا تاويل رءياي من قبل} [يوسف: ] فاراهم الله تاويلها بعد زمان ودهر طويل "
 
    
 حدثنا ابي، ثنا محمد بن عيسي الطباع، ثنا ابن علية، عن يونس، عن الحسن، «ان يوسف، عليه السلام القي في الجب وهو ابن سبع عشرة سنة، وعاش في العبودية والملك ثمانين سنة، ثم جمع الله له شمله فعاش بعد ذلك ثلاثا وعشرين سنة»
 
  قوله تعالي: {وقد احسن بي اذ اخرجني من السجن وجاء بكم من البدو} 
 [يوسف: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا بكر بن يزيد الطويل، عن ابي هريرة الحمصي، عن علي بن ابي طلحة: " {وجاء بكم من البدو} [يوسف: ] قال: من فلسطين "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: " {وجاء بكم من البدو} [يوسف: ] وكان يعقوب وبنوه بارض كنعان اهل مواشي وبرية "
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة: " {وجاء بكم من البدو} [يوسف: ] قال: وجاء باهله من البدو "
 
  قوله تعالي: {من بعد ان نزغ الشيطان بيني وبين اخوتي} 
 [يوسف: ]
 
    
 وبه، عن قتادة: " {من بعد ان نزغ، الشيطان} [يوسف: ] قال: ونزع من قلبه نزغ الشيطان وتحريشه علي اخوته "
 
  قوله تعالي: {ان ربي لطيف لما يشاء} 
 [يوسف: ]
 
    
 وبه، ثنا قتادة: " {ان ربي لطيف لما يشاء} [يوسف: ] لطف بيوسف باخراجه من السجن، وجاء باهله من البدو، ونزع من قلبه نزغ الشيطان "
 
  قوله: {انه هو العليم الحكيم} [يوسف: ] قد تقدم تفسيره
 
  قوله تعالي: {رب قد اتيتني من الملك وعلمتني من تاويل الاحاديث} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا عبد الرحمن بن ابراهيم دحيم ثنا عمر بن عبد الواحد، عن ابن جابر، عن ابي الاعيس، قال: " لما قال يوسف: {رب قد اتيتني من الملك} [يوسف: ] حتي بلغ: {توفني مسلما} [يوسف: ] شكر الله له، فزاده في عمره ثمانين عاما "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن شبل، عن ابن ابي نجيح، عن مجاهد: " {وعلمتني من تاويل الاحاديث} [يوسف: ] قال: عبارة الرءيا "
 
  قوله تعالي: {فاطر السموات والارض}
 
    
 حدثنا محمد بن عمار بن الحارث، ثنا عبد الرحمن الدشتكي، ثنا عمرو بن ابي قيس، عن ابراهيم بن مهاجر، عن مجاهد، عن ابن عباس: " {فاطر السموات والارض} قال: بديع السموات والارض "
 
    
 حدثنا الحسن بن ابي الربيع، انا عبد الرزاق، انا معمر، عن قتادة، في قوله: " {فاطر السموات والارض} قال: خالق السموات والارض "
 
  قوله تعالي: {توفني مسلما} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن بشير، حدث قتادة، عن ابن عباس، قال: " ما سال نبي الوفاة غير يوسف، يعني في قوله: {توفني مسلما} [يوسف: ] "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي: " {توفني مسلما والحقني بالصالحين} [يوسف: ] قال ابن عباس: هذا اول نبي سال الله الموت "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، قال: " ثم ارعوي يوسف، وذكر ان ما فيه من الدنيا باءد وذاهب فقال: {رب قد اتيتني من الملك وعلمتني من تاويل الاحاديث فاطر السموات والارض انت وليي في الدنيا والاخرة توفني مسلما والحقني بالصالحين} "
 
    
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ الفضل بن خالد، عن عبيد بن سليمان، عن الضحاك: " {توفني مسلما} [يوسف: ] قال: علي طاعتك "
 
  قوله تعالي: {والحقني بالصالحين} 
 [يوسف: ]
 
    
 حدثنا محمد بن حماد الطهراني، انا حفص، ثنا الحكم بن ابان، عن عكرمة: " {والحقني بالصالحين} [يوسف: ] قال: يعني اهل الجنة "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: " {توفني مسلما والحقني بالصالحين} [يوسف: ] لما جمع الله شمله، واقر عينه وهو يومءذ مغموس في بيت نعيم من الدنيا وملكها وغضارتها اشتاق الي الصالحين قبله، وانتم فاشتاقوا الي ما اشتاق اليه الصالحون قبلكم بارك الله فيكم "
 
 حدثنا ابي، ثنا سليمان ابن بنت شرحبيل، ثنا الوليد، عن خليد، وسعيد بن بشير، عن قتادة، قال: " لما قدم علي يوسف ابواه واخوته وجمع الله شمله واقر عينه، وهو يومءذ مغموس في بيت نعيم من الدنيا اشتاق الي اباءه الصالحين، ابراهيم واسحاق ويعقوب، فسال الله القبض فقال: {توفني مسلما والحقني بالصالحين} [يوسف: ] "
 
    
 حدثنا ابي ثنا عبد العزيز بن منيب، ثنا ابو معاذ الفضل بن خالد، ثنا عبيد بن سليمان، عن الضحاك، قوله: " {والحقني بالصالحين} [يوسف: ] قال: يقول اغفر لي اذا توفيتني "
 
    
 حدثنا علي بن الحسين، ثنا عبد الرحمن بن ابراهيم دحيم، ثنا ابو مسهر، ثنا سعيد بن عبد العزيز، " ان يوسف صلي الله عليه وسلم لما حضرته الوفاة قال: يا اخوتاه اني لم انتصر من احد ظلمني في الدنيا، واني كنت احب ان اظهر الحسنة واخفي السيءة، فذاك زادي من الدنيا، يا اخوتاه: اني اشركت اباءي في اعمالهم فاشركوني معهم في قبورهم، واخذ عليهم بالميثاق، فلم يفعلوا حتي بعث الله موسي صلي الله عليه وسلم، فسال عن قبره فلم يجد احدا الا امراة يقال لها شارح بنت شير بن يعقوب، فقالت: ادلك عليه علي ان اشترط عليك قال: ذلك لك، قالت: اصير شابة كلما كبرت قال: ذلك لك، قالت: واكون معك في درجتك يوم القيامة فكانه امتنع، فامر ان يمضي لها ذلك ففعل. فدلته عليه فاخرجه قال: فكانت كلما كانت مثل بنت خمسين سنة صارت مثل ابنة ثلاثين سنة حتي عمرت نسرين: الف وستماءة سنة او الف واربعماءة وحتي ادركها سليمان بن داود عليهما السلام فتزوجها "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين، ثنا عامر، عن اسباط، عن السدي: قال: " فلما حضر يعقوب الموت اوصي الي يوسف ان يدفنه عند ابراهيم واسحاق فمات، فنفخ فيه المر، ثم حمله الي الشام، فلما بلغوا ذلك المكان اقبل عيصا، فقال: غلبني علي الدعوة ووالله لا يغلبني علي القبر، فابي ان يتركهم ان يدفنوه فلما احتبسوا، قال: هشام بن دان بن يعقوب، وكان اصم لبعض اخوته: ما بال جدي لا يدفن؟ قالوا: هذا عمك يمنعه قال: ارنيه فلما اراه رفع هشام بن دان يده فوجا بها راس عيصا وجاة سقطت عيناه علي فخذ يعقوب فقتله. فدفنا في قبر واحد "
 
    
 حدثنا ابي، ثنا احمد بن يونس، ثنا ابو بكر بن عياش، عن ادريس بن
  [ص: ]
 وهب بن منبه، عن ابيه، قال: " لما اوتي يوسف من الملك ما اوتي تاقت نفسه الي اباءه فقال: {رب قد اتيتني من الملك} [يوسف: ] الي قوله: {والحقني بالصالحين} [يوسف: ] قال: باباءه ابراهيم واسحاق ويعقوب "
 
  قوله تعالي: {ذلك من انباء الغيب نوحيه اليك} 
 [ال عمران: ]
 
    
 حدثنا موسي بن ابي حماد، عن اسباط بن نصر، عن السدي، عن ابي مالك: قوله: " {ذلك من انباء الغيب} [ال عمران: ] يعني هذا احاديث "
 
    
 حدثنا محمد بن العباس، مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق، " يقول الله لنبيه صلي الله عليه وسلم: {ذلك من انباء الغيب نوحيه اليك} [ال عمران: ] "
 
    
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا عبد الله بن ادريس، ثنا محمد بن اسحاق: " {ذلك من انباء الغيب نوحيه اليك} [ال عمران: ] ثم قد جءتهم بخبر ما غيبوا عنك مما عندهم جءتهم به دليلا علي نبوتك والحجة لك عليهم "
 
  قوله تعالي: {وما كنت لديهم} 
 [ال عمران: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة: " {وما كنت لديهم} [ال عمران: ] يعني محمدا صلي الله عليه وسلم، يقول: ما كنت عندهم "
 
  قوله تعالي: {اذ اجمعوا امرهم} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة: " {وما كنت لديهم اذ اجمعوا امرهم} [يوسف: ] اي القوه في غيابة الجب "
 
  قوله تعالي: {وهم يمكرون} 
 [يوسف: ]
 
    
 وبه، عن قتادة، قوله: " {وهم يمكرون} [يوسف: ] اي: بيوسف "
 
    
 اخبرنا العباس بن الوليد بن مزيد، قراءة، اخبرني ابن شعيب بن شابور، اخبرني عثمان بن عطاء، عن ابيه عطاء الخراساني قوله: " {اذ اجمعوا امرهم وهم يمكرون} [يوسف: ] قال: فهم بنو يعقوب اذ يمكرون بيوسف "
 
  قوله تعالي: {وما اكثر الناس ولو حرصت بمءمنين} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، قوله: " {بمءمنين} [يوسف: ] قال: مصدقين "
 
  قوله تعالي: {وما تسالهم عليه من اجر} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قوله: " {عليه من اجر} [يوسف: ] يقول: عرض من اعراض الدنيا "
 
  قوله تعالي: {ان هو الا ذكر للعالمين} 
 [يوسف: ]
 
    
 حدثنا كثير بن شهاب، ثنا محمد بن سعيد بن سابق، ثنا ابو جعفر الرازي، عن الربيع بن انس، عن ابي العالية، قال: «الانس عالم والجن عالم، وسوي ذلك ثمانية عشر الف عالم من الملاءكة علي الارض والارض اربع زوايا، ففي كل زاوية منها اربعة الاف وخمسماءة عالم، خلقهم الله لعبادته تبارك وتعالي»
 
  قوله تعالي: {وكاين من اية في السموات والارض} الي {معرضون} 
 [البقرة: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة: " {وكاين من اية في السموات والارض يمرون} اي: يمشون عليها في قراءة ابن مسعود، وهم عنها معرضون "
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا خليد، عن قتادة، في قول الله: {وكاين من اية في السموات والارض يمرون عليها وهم عنها معرضون} قال هي في قراءة ابن مسعود: «يمشون عليها» قال: في السماء والارض ايتان عظيمتان
 
  قوله تعالي: {وما يءمن اكثرهم بالله الا وهم مشركون} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا عبد الله بن صالح بن مسلم العجلي، ثنا ابو الاحوص، عن سماك، عن عكرمة، عن ابن عباس، في قوله: " {وما يءمن اكثرهم بالله الا وهم مشركون} [يوسف: ] تسالهم من خلقهم؟ ومن خلق السموات والارض؟ فيقولون: الله فذلك ايمانهم وهم يعبدون غيره "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو خالد الاحمر، عن حجاج، عن القاسم بن ابي بزة، عن مجاهد: " {وما يءمن اكثرهم بالله الا وهم مشركون} [يوسف: ] ، قال: يقولون: الله ربنا، الله يميتنا، الله يرزقنا "
 
    
 حدثنا ابي، ثنا علي بن عثمان اللاحقي، ثنا شعيب بن عبد الله ابو شعبة، صاحب الطيالسة، قال: سءل الحسن، عن هذه الاية: " {وما يءمن اكثرهم بالله
  [ص: ]
 الا وهم مشركون} [يوسف: ] قال: «ذاك المنافق يعمل اذا عمل رياء للناس، وهو مشرك بعمله ذاك»
 
    
 حدثنا ابي، ثنا الحسن بن سوار، ثنا النضر بن عربي، في قوله: " {وما يءمن اكثرهم بالله الا وهم مشركون} [يوسف: ] قال: فمن ايمانهم ان يقال لهم: من ربكم؟ فيقولون: الله. ومن يدبر السموات والارض؟ فيقولون: الله. ومن يرسل عليهم المطر؟ فيقولون: الله. ومن ينبت الارض؟ فيقولون: الله. ثم هم بعد ذلك مشركون، فيقولون: ان لله ولدا، ويقولون: ثالث ثلاثة "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول: في قول الله: " {وما يءمن اكثرهم بالله الا وهم مشركون} [يوسف: ] قال: ليس احد يعبد مع الله غيره، الا وهو يءمن بالله، يعرف ان الله عز وجل ربه، وان الله خلقه ورزقه، وهو مشرك به، الا تري كيف قال ابراهيم: {افرايتم ما كنتم تعبدون، انتم واباءكم الاقدمون، فانهم عدو لي الا رب العالمين} [الشعراء: ] قد عرف انهم يعبدون رب العالمين، مع ما يعبدون، قال: فليس احد يشرك بالله الا وهو مءمن به، الا تري كيف كانت العرب تلبي تقول: لبيك اللهم لبيك، لبيك لا شريك لك لبيك، الا شريكا هو لك، تملكه وما ملك. المشركون كانوا يقولون هذا "
 
    
 حدثنا علي بن الحسين، ثنا المقدمي، ثنا زكريا بن زرارة، ثنا ابي قال: سالت ابا جعفر محمد بن علي، عن قوله: {وما يءمن اكثرهم بالله الا وهم مشركون} [يوسف: ] قال ابو جعفر: " شرك طاعة قول الرجل: لولا الله وفلان، لولا الله وكلب بني فلان "
 
  الوجه الثاني:
 
    
 حدثنا محمد بن الحسين بن ابراهيم بن اشكاب، ثنا يونس بن محمد، ثنا حماد بن سلمة، عن عاصم الاحول، عن عزرة، قال: " دخل حذيفة علي مريض فراي في عضده سيرا فقطعه او انتزعه، ثم قال: {وما يءمن اكثرهم بالله الا وهم مشركون} [يوسف: ] "
 
  قوله تعالي: {افامنوا ان تاتيهم غاشية من عذاب الله} 
 [يوسف: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {غاشية من عذاب الله} [يوسف: ] قال تغشاهم "
 
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: " {افامنوا ان تاتيهم غاشية من عذاب الله} [يوسف: ] اي عقوبة من عذاب الله "
 
    
 اخبرنا محمد بن حماد الطهراني، فيما كتب الي، ثنا عبد الرزاق، عن معمر، عن قتادة: " {غاشية من عذاب الله} [يوسف: ] قال: وقيعة تغشاهم "
 
  قوله تعالي: {او تاتيهم الساعة بغتة وهم لا يشعرون} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابو عون الزيادي، حدثني ابراهيم بن طهمان، حدثني محمد بن زياد، عن ابي هريرة، قال: قال رسول الله صلي الله عليه وسلم: «تقوم الساعة علي رجل اكلته في فيه يلوكها لا يسيغها، ولا يلفظها، وعلي رجلين قد نشرا ثوبا هما يتبايعانه، فلا يطويانه، ولا يتبايعانه»
 
    
 حدثنا ابي، ثنا ابو سلمة موسي بن اسماعيل، ثنا حماد، عن علي بن الحكم، عن عكرمة، انه قال: " لا تقوم الساعة حتي ينادي مناد: يا ايها الناس اتتكم الساعة، اتتكم الساعة ثلاثا "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، عن ابن ابي نجيح، عن مجاهد، قوله: " {بغتة} [يوسف: ] قال: فجاة. امنين "
 
  قوله تعالي: {قل هذه سبيلي} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: " {قل هذه سبيلي ادعو} [يوسف: ] قال: هذه دعوتي "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انا اصبغ، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {قل هذه سبيلي ادعو الي الله} [يوسف: ] قال: هذا امري وسنتي ومنهاجي "
 
  قوله تعالي: {ادعو الي الله علي بصيرة انا ومن اتبعني} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد، عن قتادة، قوله: " {ادعو الي الله علي بصيرة} [يوسف: ] اي: علي هدي {انا ومن اتبعني} [يوسف: ] "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {ادعو الي الله علي بصيرة انا
  [ص: ]
 ومن اتبعني} [يوسف: ] قال: وحق والله علي من اتبعه ان يدعو الي مثل ما دعا اليه ويذكر بالقران والحكمة والموعظة الحسنة، وينهي عن معاصي الله "
 
  قوله تعالي: {وسبحان الله وما انا من المشركين} [يوسف: ] قد تقدم تفسير {سبحان} [الاسراء: ] غير مرة والله اعلم
 
  قوله تعالي: {وما ارسلنا من قبلك الا رجالا نوحي اليهم} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن العلاء ابو كريب، ثنا عثمان بن سعيد، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قال: " {وما ارسلنا من قبلك الا رجالا نوحي اليهم من اهل القري} [يوسف: ] اي: ليسوا من اهل السماء كما قلتم "
 
  قوله تعالي: {من اهل القري} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد، ثنا قتادة، قوله: " {وما ارسلنا من قبلك الا رجالا نوحي اليهم من اهل القري} [يوسف: ] قال: وما نعلم ان الله ارسل رسولا قط الا من اهل القري، لانهم كانوا اعلم واحلم من اهل العمود "
 
  قوله: {افلم يسيروا في الارض فينظروا كيف كان عاقبة الذين من قبلهم} 
 [يوسف: ]
 
    
 حدثنا الحسن بن احمد، ثنا موسي بن محلم، ثنا ابو بكر الحنفي، ثنا عباد بن منصور، عن الحسن، في قوله: " {فينظروا كيف كان عاقبة الذين من قبلهم} [يوسف: ] قال: فينظروا كيف عذب الله قوم نوح، وقوم لوط، وقوم صالح، والامم التي عذب الله "
 
  قوله تعالي: {ولدار الاخرة خير للذين اتقوا افلا تعقلون} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {ولدار الاخرة خير} [يوسف: ] يقول: باقية "
 
    
 حدثنا ابي، ثنا الهيثم بن يمان، ثنا اسماعيل بن زكريا، حدثني محمد بن عون الخراساني، عن عكرمة، قوله: " {ولدار الاخرة} [يوسف: ] يقول: الجنة "
 
  قوله تعالي: {حتي اذا استيءس الرسل}
 
    
 حدثنا احمد بن سنان، ثنا عبد الرحمن بن مهدي، عن سفيان، عن حصين، عن عمران السلمي، عن ابن عباس: « {حتي اذا استيءس الرسل} من قومهم ان يصدقوهم»
 
  قوله تعالي: {وظنوا انهم قد كذبوا} 
 [يوسف: ]
 
    
 وبه الي ابن عباس: " {وظنوا انهم قد كذبوا} [يوسف: ] قال: وظن قومهم ان الرسل قد كذبتهم جاءهم نصرنا "
 
    
 حدثنا احمد بن عصام، ثنا مءمل، ثنا سفيان، عن عطاء بن الساءب، عن سعيد بن جبير، عن ابن عباس، قال: " {حتي اذا استيءس الرسل} من ان يسلم قومهم، وظن قومهم ان الرسل قد كذبوا: {جاءهم نصرنا} [يوسف: ] "
 
    
 حدثنا يونس بن عبد الاعلي، انا ابن وهب، اخبرني ابن لهيعة، عن عقيل بن خالد، عن ابن شهاب، اخبرني عروة بن الزبير، " انه سال عاءشة زوج النبي صلي الله عليه وسلم ورضي الله عنها، قال: ارايت قول الله تعالي: {حتي اذا استيءس الرسل وظنوا انهم قد كذبوا} اكذبوا، ام كذبوا بالتخفيف، فقالت: بل كذبوا، تعني بالتشديد، فقلت: والله لقد استيقنوا ان قومهم قد كذبوهم، وما هو بالظن، فقالت: اجل لعمري لقد استيقنوا ذلك، فقلت: فلعلها: {وظنوا انهم قد كذبوا} [يوسف: ] فقالت: معاذ الله لم تكن الرسل لتظن ذلك بربها، قلت: وما هذه الاية؟ قالت: هم اتباع الرسل الذين امنوا وصدقوهم، وطال عليهم البلاء واستاخر عنهم النصر، حتي اذا استيءس الرسل ممن كذبهم من قومهم، وظن الرسل ان اتباعهم عندما كذبوهم جاءهم نصر الله عند ذلك "
 
    
 حدثنا محمد بن حماد الطهراني، ثنا حفص بن عمر، ثنا الحكم بن ابان، عن عكرمة، قال: سمعت ابن عباس، يقول في قوله: " {حتي اذا استيءس الرسل وظنوا انهم قد كذبوا} قال عكرمة: قلت لابن عباس: اكلم كذب؟ قال: نعم لا ام لك اليس قال نوح: {رب ان ابني من اهلي وان وعدك الحق وانت احكم الحاكمين قال يا نوح انه ليس من اهلك انه عمل غير صالح} [هود: ] "
 
    
 حدثنا ابو زرعة، ثنا منجاب، انا بشر بن عمارة، عن ابي روق، عن
  [ص: ]
 الضحاك، عن ابن عباس، في قوله: " {حتي اذا استيءس الرسل} قال: استيءس الرسل من ايمان قومهم: {وظنوا انهم قد كذبوا} [يوسف: ] وظن قوم الرسل ان الرسل قد كذبت فيما جاءت به: {جاءهم نصرنا} [يوسف: ] قال: جاء الرسل نصرنا "
 
    
 اخبرنا يونس بن عبد الاعلي، قراءة، انا ابن وهب، اخبرني سليمان بن بلال، عن يحيي بن سعيد، قال: " جاء رجل الي القاسم بن محمد، فقال: ان محمد بن كعب القرظي، يقول: هذه الاية: " {حتي اذا استيءس الرسل وظنوا انهم قد كذبوا} فقال القاسم: فاخبره عني، اني سمعت عاءشة زوج النبي صلي الله عليه وسلم تقول: {حتي اذا استيءس الرسل وظنوا انهم قد كذبوا} تقول: «كذبتهم اتباعهم»
 
    
 حدثنا علي بن الحسن، ثنا ابن ابي مريم، ثنا مفضل بن فضالة، عن ابي صخر: " {حتي اذا استيءس الرسل وظنوا انهم قد كذبوا جاءهم نصرنا} يقول: حتي اذا استيءس الرسل من ايمان ما وعدوا به {جاءهم نصرنا} [يوسف: ] الاية "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، انا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {حتي اذا استيءس الرسل وظنوا انهم قد كذبوا} قال: استيءس الرسل ان يءمن لهم قومهم، ظن قومهم المشركون: ان قد كذبوا ما وعدهم الله من نصرهم اياهم عليهم واخلفوا "
 
  قوله تعالي: {جاءهم نصرنا} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {جاءهم نصرنا} [يوسف: ] قال: جاء الرسل نصرنا "
 
    
 حدثنا ابي، ثنا سويد بن سعيد، ثنا علي بن مسهر، عن الاعمش، عن مسلم بن صبيح، عن ابن عباس، في قوله: " {حتي اذا استيءس الرسل} قال: استيءس الرسل من قومهم وظنوا ان قومهم لم يصدقوهم، وظن قومهم ان الرسل قد كذبوهم جاءهم نصرنا قال: العذاب "
 
  قوله تعالي: {فنجي من نشاء} 
 [يوسف: ]
 
    
 اخبرنا محمد بن سعد فيما كتب الي، حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه، عن ابن عباس، قوله: " {فنجي من نشاء} [يوسف: ] قال: فننجي الرسل ومن نشاء "
 
  قوله تعالي: {ولا يرد باسنا، عن القوم المجرمين} 
 [يوسف: ]
 
    
 وبه، عن ابن عباس، قوله: " {ولا يرد باسنا عن القوم المجرمين} [يوسف: ] وذلك ان الله، بعث الرسل فدعوا قومهم واخبروهم انه من اطاع الله نجي، ومن عصاه عذب وغوي "
 
  قوله تعالي: {لقد كان في قصصهم عبرة} 
 [يوسف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {عبرة} [يوسف: ] قال: معرفة لاولي الالباب قال: لذوي العقول "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: " {عبرة لاولي الالباب} [يوسف: ] يعني ليوسف واخوته "
 
  قوله تعالي: {ما كان حديثا يفتري ولكن تصديق الذي بين يديه} 
 [يوسف: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة، قوله: " {ما كان حديثا يفتري ولكن تصديق الذي بين يديه} [يوسف: ] فالقران يصدق الكتب التي قبله ويشهد عليها "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، قوله: " {ولكن تصديق الذي بين يديه} [يونس: ] اي: لما كان قبله من الخبر عنه "
 
  قوله تعالي: {وتفصيل كل شء} 
 [يوسف: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد، عن غير قتادة: قوله: " {وتفصيل كل شء} [يوسف: ] من شانه "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: " {وتفصيل كل شء} [يوسف: ] حلاله وحرامه وطاعته ومعصيته "
 
  قوله تعالي: {وهدي ورحمة} [الانعام: ] تفسير: {هدي} [البقرة: ] قد مر فيما قبل
 
 حدثنا ابو سعيد
  [ص: ]
 الاشج، ثنا ابو معاوية، عن حجاج، عن عطية، عن ابي سعيد، في قوله: " {ورحمة} [يوسف: ] ان جعلكم من اهل القران "
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع بن انس، عن ابي العالية، في قوله: " {ورحمة} [يوسف: ] قال: رحمته القران "
 
  قوله تعالي: {لقوم يءمنون} 
 [الانعام: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: " {وهدي ورحمة لقوم يءمنون} [الاعراف: ] اي: مغفرة لما ارتكبوا "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق: " {وهدي ورحمة لقوم يءمنون} [الاعراف: ] اي: مغفرة لما ارتكبوا فيه من الحدث ولما اختلفوا فيه من الحديث عنه، والقطيعة، ومعرفة بقدر الله ولطفه، وما خلص الي يوسف ويعقوب من رحمته بعد البلاء الذي ابتلاهما به حتي رد كل واحد منهما الي صاحبه، وعرف كل امرء ممن بغي عليه ذنبه وجرمه، واقرارا له بفضله وعلمه وتجاوزه وقلة تثريبه عليهم فيما صنعوا به "
 
  سورة الرعد 
 بسم الله الرحمن الرحيم، تفسير السورة التي يذكر فيها الرعد
 
  قوله عز وجل {المر} 
 [الرعد: ]
 
    
 حدثنا ابي، ثنا ابو نعيم، ثنا شريك، عن عطاء بن الساءب، عن ابي اسيد العجمي، عن ابن عباس: " {المر} [الرعد: ] ، قال: انا الله اري "
 
    
 حدثنا علي بن الحسين، ثنا علي بن زنجة، ثنا علي بن الحسن، عن الحسين بن واقد، عن مطير، في قوله: " {المر} [الرعد: ] قال: {المر} [الرعد: ] التوراة "
 
  قوله تعالي: {تلك ايات الكتاب} 
 [يونس: ]
 
    
 وبه عن مطير قوله: " {تلك ايات} [الرعد: ] قال: الزبور "
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا ابن السماك، عن ابي بكر، عن الحسين، في هذه الاية: " {المر تلك ايات الكتاب} [الرعد: ] قال: التوراة والزبور "
 
    
 حدثنا ابي، ثنا نصر بن علي، اخبرني ابي، عن خالد بن قيس، عن قتادة، في قوله: " {المر تلك ايات الكتاب} [الرعد: ] قال: التوراة والانجيل والزبور "
 
  قوله: {والذي انزل اليك من ربك الحق} 
 [الرعد: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد، عن قتادة، قوله: " {والذي انزل اليك من ربك الحق} [الرعد: ] هذا القران "
 
  قوله: {الحق} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا ابن السماك، عن ابي بكر، عن الحسين: " {والذي انزل اليك من ربك الحق} [الرعد: ] قال: القران الحق كله "
 
  قوله: {الله الذي رفع السموات}
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عاصم، ثنا علي الحنفي، ثنا
  [ص: ]
 علي بن صالح، عن سلمة بن وهرام، عن عكرمة، عن ابن عباس: «السماء علي اربعة املاك، كل زاوية موكل بها ملك»
 
    
 حدثنا علي، ثنا ابن فضيل، ثنا عطاء بن الساءب، عن الشعبي، قال: كتب ابن عباس الي ابي الجلد يساله عن السماء، من اي شء هي، فكتب اليه: «ان السماء من موج مكفوف»
 
  قوله: {بغير عمد} 
 [الرعد: ]
 
    
 حدثنا ابي، ثنا الحكم بن موسي، ثنا معاذ بن معاذ، عن عمران بن حدير، عن عكرمة، قال: " قلت لابن عباس: ان فلانا يقول: انها علي عمد يعني السماء. فقال ابن عباس: يقرءها بغير عمد ترونها "
 
    
 حدثنا جعفر بن محمد بن عوشجة، ثنا الحسن بن موسي الاشيب، ثنا حماد بن سلمة، عن حميد، عن الحسن بن مسلم، عن مجاهد، في قول الله: " {خلق السموات بغير عمد ترونها} قال: هي بعمد لا ترونها "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، في قوله: " {بغير عمد} [الرعد: ] يقول: عمد "
 
  والوجه الثاني:
 
    
 حدثنا علي بن الحسين، ثنا ازهر بن مروان، ثنا عبد الاعلي، ثنا سعيد، عن قتادة، عن الحسن، وهو قول قتادة: " {بغير عمد ترونها} [الرعد: ] انهما كانا يقولان خلقها بغير عمد، قال لها: قومي فقامت "
 
  قوله تعالي: {ثم استوي} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية، في قوله: " {ثم استوي} [الرعد: ] يقول: ارتفع " وروي عن الحسن، والربيع بن انس مثله
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، عن ابن ابي عروبة، عن قتادة، في قول الله: " {ثم استوي علي العرش} [الرعد: ] قال: يوم السابع "
 
    
 حدثنا يزيد بن سنان البصري، نزيل مصر، ثنا يزيد بن ابي حكيم، ثنا
  [ص: ]
 الحكم بن ابان، قال: سمعت عكرمة، يقول: «ان الله خلق السموات والارض وما بينهما يوم الاحد، ثم استوي علي العرش يوم الجمعة في ثلاث»
 
  قوله: {علي العرش} 
 [الاعراف: ]
 
    
 حدثنا ابي، ثنا اسماعيل بن ابي اويس، اخبرني عبد العزيز بن حازم، عن سهيل بن ابي صالح، عن ابيه، عن السلولي، عن كعب الاحبار، قال: " ان الله عز وجل لما خلق الخلق استوي علي العرش فسبحه يعني: العرش ". قد تقدم القول في العرش غير مرة
 
  قوله: {وسخر الشمس والقمر كل يجري لاجل مسمي} 
 [الرعد: ]
 
    
 حدثنا ابي، ثنا سلمة بن شبيب، ثنا ابراهيم بن الحكم بن ابان، حدثني ابي، عن عكرمة، قال: " سعة الشمس سعة الارض كلها، وزيادة ثلث وسعة القمر سعة الارض مرة، وان الشمس اذا غربت دخلت تحت العرش، فسبحت لله، حتي اذا هي اصبحت استعفت ربها من الخروج، فقال لها الرب: «ولم ذاك والرب اعلم» فقالت: اني اذا خرجت عبدت، فقال لها الرب: «اخرجي فليس عليك من ذلك شء حسبهم جهنم، ابعثها عليهم مع ثلاثة عشر الف ملك يقودونها حتي يدخلوهم فيها»
 
  قوله تعالي: {يدبر الامر} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: " {يدبر الامر} [يونس: ] قال: يقضيه وحده "
 
  قوله: {يفصل الايات} 
 [يونس: ]
 
    
 اخبرنا احمد بن عثمان بن حكيم الاودي، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي: " {يفصل الايات} [يونس: ] اما نفصل فنبين "
 
  قوله: {لعلكم بلقاء ربكم توقنون} 
 [الرعد: ]
 
 حدثنا محمد بن يحيي، ثنا العباس بن الوليد، ثنا يزيد بن زريع، قال: سمعت سعيدا، عن قتادة، قوله: " {لعلكم بلقاء ربكم توقنون} [الرعد: ] قال: ان الله تبارك وتعالي، انما انزل كتابه وبعث رسله ليءمن بوعده، وليستيقن بلقاءه "
 
  قوله: {وهو الذي مد الارض} 
 [الرعد: ]
 
    
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني الليث، حدثني خالد بن يزيد، عن سعيد بن ابي هلال، عن عمر بن عبد الله، مولي غفرة، ان كعبا قال لعمر بن الخطاب: " الا احدثك عن علو الجبار، قال عمر: بلي، فقال: ان الله جعل مسيرة ما بين المشرق والمغرب خمسماءة سنة، فماءة سنة في المشرق، لا يسكنها شء من الحيوان، ولا جن، ولا انس، ولا دابة، ولا شجرة، وماءة سنة في المغرب بتلك المنزلة، وثلاثماءة فيما بين المشرق والمغرب يسكنها الحيوان "
 
    
 حدثنا ابي، ثنا الحسن بن واقع، ثنا ضمرة، عن الاوزاعي، قال: قال عبد الله بن عمرو: «الدنيا مسيرة خمسماءة عام اربع ماءة خراب، وماءة عمران , في ايدي المسلمين مدة ذلك مسيرة سنة»
 
    
 حدثنا ابي، ثنا نصر بن علي، انا الاصمعي، ثنا النمر بن هلال، عن قتادة، عن ابي الجلد، قال: «الارض اربعة وعشرون الف فرسخ فالسودان اثنا عشر والروم ثمانية ولفارس ثلاثة وللعرب الف»
 
    
 حدثنا ابي، ثنا ابو نصر التمار، ثنا حماد بن سلمة، عن ابي سنان، عن وهب بن منبه، قال: «ما العمارة في الدنيا في الخراب الا كفسطاط في الصحراء»
 
  قوله تعالي: {وجعل فيها رواسي} 
 [الرعد: ]
 
    
 حدثنا ابي، ثنا عمرو بن محمد الناقد، ثنا يزيد بن هارون، ثنا العوام بن حوشب، عن سليمان بن ابي سليمان، عن انس بن مالك، عن النبي صلي الله عليه وسلم قال: " لما خلق الله الارض جعلت تميد فجعل الجبال فالقاها عليها فاستقرت، فعجبت الملاءكة من خلق الجبال، فقالت: هل من خلقك يا رب اشد من الجبال؟ فقال: الحديد، فقالت: يا رب فهل من خلقك اشد من الحديد؟ قال: نعم، النار، فقالت: فهل من خلقك اشد من النار؟ قال: نعم، الماء. فقالت: يا رب، فهل في خلقك اشد من الماء؟ قال: نعم، الريح، قالت: يا رب فهل من خلقك شء اشد من الريح؟ قال: نعم، ابن ادم يتصدق بيمينه يخفيها من شماله "
 
    
 حدثنا ابي، ثنا ابو نعيم، ثنا طلحة بن عمرو، عن عطاء، قال: «اول جبل وضع علي الارض ابو قبيس»
 
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة، قوله: " {رواسي} [الرعد: ] اي: جبال "
 
  قوله: {وانهارا ومن كل الثمرات جعل فيها زوجين اثنين} 
 [الرعد: ]
 
    
 حدثنا ابي، ثنا عمرو بن علي الصيرفي، ثنا ابو قتيبة، ثنا عقبة بن القطان، عن عكرمة، عن ابن عباس، قال: «ليس في الارض ماء الا ماء نزل من السماء، ولكن عروقا في الارض تغيره، فمن اراد ان يعود الملح عذبا فليصعد الماء من الارض»
 
  قوله: {يغشي الليل النهار} 
 [الاعراف: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد، عن قتادة: " {يغشي الليل النهار} [الرعد: ] : يلبس الليل النهار "
 
  قوله: {ان في ذلك لايات لقوم يتفكرون} 
 [الرعد: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن يمان، ثنا سفيان، عن سماك، عن سعيد بن جبير: " {في ذلك لايات} [الرعد: ] قال: الرجل يبعث ... الي اهله "
 
  قوله تعالي: {لقوم يتفكرون} 
 [يونس: ]
 
    
 حدثنا الحسن بن عرفة، ثنا علي بن ثابت، عن الوازع بن نافع، عن سالم بن عبد الله بن عمر، عن ابيه، قال: قال رسول الله صلي الله عليه وسلم: «تفكروا في الاء الله، ولا تفكروا في الله»
 
  قوله: {وفي الارض قطع متجاورات} 
 [الرعد: ]
 
    
 حدثنا ابي، ثنا عمر بن سعد بن مالك الاوصابي، ثنا ابن جسير، عن ابن لهيعة، عن ابن ابي عمرة، عن عكرمة، عن ابن عباس، في قوله: " {وفي الارض قطع متجاورات} [الرعد: ] : يريد بذلك الطيبة العذبة التي تخرج نباتها باذن ربها، تجاورها السبخة القبيحة المالحة التي لا تخرج، وهما ارض واحدة وماءهما شء ملح عذب. ففضلت احداهما علي الاخري في الاكل "
 
    
 ذكر، عن ابي احمد الزبيري، ثنا اسراءيل، عن عطاء، عن سعيد، عن ابن عباس: " {وفي الارض قطع متجاورات} [الرعد: ] قال: يكون هذا حلو وهذا حامض "
 
    
 حدثنا ابو سعيد الاشج، ثنا المنقري، عن سفيان، عن ليث، عن مجاهد: " {وفي الارض قطع متجاورات} [الرعد: ] قال: ملح وعذوبة "
 
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، ثنا قتادة، عن ابي عياض: " {قطع متجاورات} [الرعد: ] قال: قري "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {قطع متجاورات} [الرعد: ] : طيبها عذبها وخبيثها السباخ "
 
  قوله: {متجاورات} 
 [الرعد: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد، ثنا قتادة، عن ابي عياض: " {وفي الارض قطع متجاورات} [الرعد: ] قال: المتواصلة "
 
 حدثني ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة، قوله " {متجاورات} [الرعد: ] : اي قريب بعضها من بعض "
 
  قوله: {وجنات من اعناب} [الانعام: ] الاية
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: " {وجنات من اعناب} [الانعام: ] قال: جنات وما معها "
 
  قوله تعالي: {صنوان} 
 [الرعد: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عمرو العنقزي، عن سفيان، عن ابي اسحاق، عن البراء: " {صنوان} [الرعد: ] قال: النخلتين الملتزقتين "
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {صنوان} [الرعد: ] قال: الصنوان النخل المجتمع الاصل "
 
    
 حدثنا ابو سعيد الاشج، ثنا هانء بن سعيد، عن جويبر، عن الضحاك: " {صنوان} [الرعد: ] قال: يقول اذا كان الخمس والست اصلهن واحد، وفروعهن شتي، وطلعهن مختلف " وروي عن عكرمة، وعطاء الخرساني مثل ذلك
 
  والوجه الثاني:
 
    
 حدثنا ابي، ثنا النفيلي، ثنا محمد بن سلمة، عن خصيف، في قوله: " {صنوان} [الرعد: ] قال: الصنوان ما كان من الشعر متشعب "
 
  قوله: {وغير صنوان} 
 [الرعد: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عمرو العنقزي، عن سفيان، عن ابي اسحاق، عن البراء: " {وغير صنوان} [الرعد: ] قال: المتفرق "
 
    
 حدثنا ابو سعيد الاشج، ثنا جابر بن سعيد، عن جويبر، عن الضحاك: " {صنوان وغير صنوان} [الرعد: ] قال: يقول: اذا كان الخمس والست اصلهن واحد، وفروعهن شتي، وطلعهن مختلف، وغير صنوان النخلة غير المنفردة "
 
  قوله: {يسقي بماء واحد} 
 [الرعد: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " (تسقي بماء واحد) : ماء السماء، كمثل صالح بني ادم وخبيثهم ابوهم واحد "
 
  قوله: {ونفضل بعضها علي بعض في الاكل} 
 [الرعد: ]
 
    
 حدثنا ابي، ثنا علي بن هاشم بن مرزوق، ثنا اسحاق بن يوسف الازرق، عن سفيان الثوري، عن عطاء بن الساءب، عن سعيد بن جبير، عن ابن عباس، في قوله: " {ونفضل بعضها علي بعض في الاكل} [الرعد: ] قال: هذا حامض، وهذا حلو، وهذا دقل، وهذا فارسي "
 
  قوله: {ان في ذلك لايات لقوم يعقلون} 
 [الرعد: ]
 
    
 اخبرنا احمد بن الازهر، فيما كتب الي، ثنا وهب بن جرير، ثنا ابي، عن علي بن الحكم، عن الضحاك: " {صنوان وغير صنوان} [الرعد: ] فيقول: تسقي بماء واحد بعضها افضل من بعض حملا ففي ذلك اية لقوم يعقلون "
 
  قوله تعالي: {وان تعجب} 
 [الرعد: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، قوله: " {وان تعجب} [الرعد: ] يا محمد {فعجب قولهم} [الرعد: ] ، وكان الحسن يقول: ان تعجب يا محمد من تكذيبهم اياك فعجب قولهم "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله تعالي: " {وان تعجب فعجب قولهم} [الرعد: ] قال: ان تعجب من تكذيبهم وهم راوا من قدرة الله وامره وما ضرب لهم
  [ص: ]
 من الامثال، واراهم من احياء الموتي والارض الميتة ان تعجب من هذا فتعجب من قولهم "
 
  قوله: {فعجب قولهم} 
 [الرعد: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، قوله: " {فعجب قولهم} [الرعد: ] : عجب الرحمن من تكذيبهم بالبعث "
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {وان تعجب فعجب قولهم} [الرعد: ] قال: ان تعجب من تكذيبهم فتعجب من قولهم: اذا كنا ترابا انا لفي خلق جديد. اولا يرون ان خلقهم من نطفة، فالخلق من نطفة اشد من الخلق من التراب واعظم "
 
  قوله: {اءذا كنا ترابا اءنا لفي خلق جديد} 
 [الرعد: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي: " {اءذا كنا ترابا} [الرعد: ] : فكانت اللحوم رفاتا "
 
  قوله: {اولءك الذين كفروا بربهم واولءك الاغلال في اعناقهم} 
 [الرعد: ]
 
    
 حدثني ابي، ثنا عمرو بن رافع، ثنا نعيم بن ميسرة القاري، عن عيينة بن حصين، عن الحسين، قال: «ان الانكال لم تجعل في اعناق اهل النار لانهم اعجزوا الرب، ولكنها جعلت في اعناقهم لكي اذا طفا بهم اللهب ارسبتهم في النار»
 
  قوله: {واولءك اصحاب النار} 
 [البقرة: ]
 
    
 حدثنا موسي بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك، قوله: " {اصحاب النار} [الرعد: ] : يعذبون فيها "
 
  قوله: {هم فيها خالدون} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، ثنا ابو غسان بن سلمة بن الفضل، قال: قال محمد بن اسحاق، حدثني محمد بن ابي محمد، عن سعيد بن جبير، وعكرمة، عن ابن عباس، قوله: " {هم فيها خالدون} [الرعد: ] : اي خالد ابدا " وروي عن السدي نحو ذلك
 
  قوله تعالي: {ويستعجلونك بالسيءة قبل الحسنة} 
 [الرعد: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، قوله: " {ويستعجلونك} [الرعد: ] قال: هءلاء مشركو العرب استعجلوا بالشر قبل الخير. فقالوا: {اللهم ان كان هذا هو الحق من عندك فامطر علينا حجارة من السماء او اءتنا بعذاب اليم} [الانفال: ] "
 
    
 اخبرنا ابو عبد الله الطهراني، فيما كتب الي، ثنا عبد الرزاق، ثنا معمر، عن قتادة: " {ويستعجلونك بالسيءة قبل الحسنة} [الرعد: ] قال: بالعقوبة قبل العافية "
 
    
 حدثنا عبد الله، عن سليمان، ثنا الحسين بن علي، ثنا عامر، ثنا اسباط، عن السدي، قوله: " {ويستعجلونك بالسيءة قبل الحسنة} [الرعد: ] قال: حين سالوا العذاب "
 
  قوله: {وقد خلت من قبلهم} 
 [الرعد: ]
 
    
 حدثنا موسي بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك، قوله: " {خلت} [الرعد: ] يعني مضت "
 
  قوله: {المثلات} 
 [الرعد: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {وقد خلت من قبلهم المثلات} [الرعد: ] قال: ما اصاب القرون الماضية من العذاب "
 
  والوجه الثاني:
 
    
 حدثنا الحجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: " {وقد خلت من قبلهم المثلات} [الرعد: ] قال: الامثال " وروي عن ابي صالح نحو ذلك
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد، في قول الله: " {وقد خلت من قبلهم المثلات} [الرعد: ] قال: المثلات التي مثل الله في الامم من العذاب الذي عذبهم , نزلت بهم المثلات من العذاب , قد خلت من قبلهم، وعرفوا ذلك وانتهي ما مثل الله بهم حين عصوه وعصوا رسله "
 
  قوله: {وان ربك لذو مغفرة للناس علي ظلمهم} 
 [الرعد: ]
 
    
 حدثنا ابي، ثنا محمد بن سفيان الخزاز الكوفي، ثنا عماد بن زيد، عن علي بن زيد، قال: " تلا مطرف هذه الاية: {وان ربك لذو مغفرة للناس علي ظلمهم} [الرعد: ] ثم قال مطرف: لو يعلم الناس قدر رحمة الله، وعفو الله، وتجاوز الله، ومغفرة الله لقرت اعينهم "
 
    
 حدثنا ابي، ثنا موسي بن اسماعيل، ثنا حماد، عن علي بن زيد، عن سعيد بن المسيب، قال: لما نزلت هذه الاية: {وان ربك لذو مغفرة للناس علي ظلمهم وان ربك لشديد العقاب} [الرعد: ] قال رسول الله صلي الله عليه وسلم: «لولا عفو الله وتجاوزه ما هنا احد العيش، ولولا وعيده وعقابه لاتكل كل احد»
 
  قوله: {وان ربك لشديد العقاب} 
 [الرعد: ]
 
    
 حدثنا ابي، ثنا محمد بن سفيان الخزاز الكوفي، ثنا حماد بن زيد، عن علي بن زيد بن جدعان، قال: " تلا مطرف هذه الاية: {وان ربك لذو مغفرة للناس علي ظلمهم وان ربك لشديد العقاب} [الرعد: ] ولو يعلم الناس قدر عقوبة الله، ونقمة الله وباس الله، ونكال الله ما رقي لهم دمع، ولا قرت اعينهم بشء "
 
  قوله: {ويقول الذين كفروا لولا انزل عليه اية من ربه} 
 [الرعد: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة: " {ويقول الذين كفروا لولا انزل عليه اية من ربه} [الرعد: ] قال: قول مشركي العرب "
 
  قوله: {انما انت منذر} 
 [الرعد: ]
 
    
 حدثنا محمد بن عبد الرحمن الهروي، ثنا ابو داود الحفري، عن سفيان الثوري، عن السدي، عن عكرمة، عن ابن عباس: " {انما انت منذر ولكل قوم هاد} [الرعد: ] قال: هو المنذر وهو الهاد، يعني النبي صلي الله عليه وسلم " وروي عن علي بن ابي طالب، وسعيد بن جبير، ومجاهد، وابي صالح، وعكرمة، وابي الضحي، والسدي، والضحاك، وابي جعفر محمد بن علي، وعبد الرحمن بن زيد ان المنذر النبي صلي الله عليه وسلم
 
  قوله: {ولكل قوم هاد} 
 [الرعد: ]
 
    
 حدثنا محمد بن الوزير الواسطي، ثنا اسحاق بن يوسف الازرق، عن
  [ص: ]
 سفيان، عن عطاء بن الساءب، عن سعيد بن جبير، في قوله: " {ولكل قوم هاد} [الرعد: ] قال: الهاد الله عز وجل " ورواه عطية، عن ابن عباس مثله، وروي عن الضحاك ايضا مثله
 
  والوجه الثاني:
 
    
 حدثنا محمد بن عبد الرحمن، ثنا ابو داود الحفري، عن سفيان الثوري، عن السدي، عن عكرمة، عن ابن عباس: " {انما انت منذر ولكل قوم هاد} [الرعد: ] قال: هو المنذر وهو الهاد "
 
    
 حدثنا ابو سعيد الاشج، ثنا يعلي، عن عبد الملك بن قيس، عن مجاهد: " {ولكل قوم هاد} [الرعد: ] قال: نبي ". وروي عن ابي الضحي وعكرمة نحو ذلك
 
  والوجه الثالث:
 
    
 حدثنا علي بن الحسين، ثنا عثمان بن ابي شيبة، ثنا المطلب بن زياد، عن السدي، عن عبد خير، عن علي: " {ولكل قوم هاد} [الرعد: ] قال: الهاد رجل من بني هاشم " قال ابن الجنيد: هو علي بن ابي طالب رضي الله عنه وروي عن عبد الله بن عباس في احدي الروايات، وعن ابي جعفر محمد بن علي، نحو ذلك
 
  والوجه الرابع:
 
    
 حدثنا كثير بن شهاب، ثنا محمد بن سعيد بن سابق، ثنا ابو جعفر الرازي، ثنا ابراهيم بن انس، عن ابي العالية، في قوله: " {انما انت منذر ولكل قوم هاد} [الرعد: ] قال: الهاد: القاءد، والقاءد: الامام، والامام: العمل "
 
    
 حدثني ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {ولكل قوم هاد} [الرعد: ] قال: داع "
 
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن اسماعيل، عن ابي صالح: " {ولكل قوم هاد} [الرعد: ] قال: هاديهم الي خير والي شر "
 
    
 حدثنا ابو سعيد الاشج، ثنا محمد بن عبيد، عن اسماعيل، عن يحيي بن رافع: " {ولكل قوم هاد} [الرعد: ] قال: قاءد "
 
  قوله: {الله يعلم ما تحمل كل انثي} 
 [الرعد: ]
 
 ذكر، عن يحيي بن ادم، عن شريك، عن سالم، عن سعيد: " {يعلم ما تحمل كل انثي} [الرعد: ] قال: يعلم ذكرا هو ام انثي "
 
    
 حدثنا علي بن الحسين، ثنا شبابة، ثنا قزعة، قال: " سالت ابن ابي نجيح، عن هذه الاية: " {يعلم ما تحمل كل انثي} [الرعد: ] قال: من ذكر او انثي "
 
    
 حدثنا ابو سعيد الاشج، ثنا عقبة بن جرير، عن اسراءيل، عن جابر، عن عكرمة، ومجاهد: " {يعلم ما تحمل كل انثي} [الرعد: ] قال: حملها تسعة اشهر "
 
  قوله: {وما تغيض الارحام} 
 [الرعد: ]
 
    
 حدثنا علي بن الحسين، ثنا مسلم بن سلام، ثنا عبد السلام، عن خصيف، عن مجاهد، وسعيد بن جبير، عن ابن عباس، قوله: " {وما تغيض الارحام} [الرعد: ] قال: تغيض الارحام ان تري المراة الدم في حملها فذلك تزداد في التسعة اشهر "
 
    
 حدثنا علي بن الحسين، ثنا علي بن عبد المءمن، ثنا المحاربي، عن ابي خالد الدالاني، عن زريق الجرجاني، عن الضحاك، في قوله: " {يعلم ما تحمل كل انثي وما تغيض الارحام وما تزداد} [الرعد: ] قال ابن عباس: ما تزداد علي تسعة، وما نقص عن التسعة. وقال الضحاك: وضعتني امي وقد حملتني في بطنها سنتين وولدتني، وقد خرجت ثنيتي "
 
    
 حدثنا ابو سعيد الاشج، ثنا عقبة، عن اسراءيل، عن جابر، عن مجاهد، وعكرمة: " {يعلم ما تحمل كل انثي وما تغيض الارحام} [الرعد: ] قال: حملها تسعة اشهر: {وما تغيض الارحام} [الرعد: ] قال: اذا رات الدم حش الولد، واذا لم تر الدم عظم الولد
  [ص: ]
 . وقال عكرمة: الحمل تسعة اشهر، وما تغيض الارحام، وما تزداد، قال: اذا اراقت الدم نقص من العدة، واذا لم ترق الدم وفت العدة "
 
    
 حدثنا الحسن بن علي بن عفان، ثنا معاوية يعني ابن هشام، عن سفيان، عن جويبر، عن الضحاك: " {وما تغيض الارحام} [الرعد: ] قال: ما دون التسعة اشهر فهو غيض "
 
    
 حدثنا ابي، ثنا عبد الصمد بن عبد العزيز العطار الرازي، ثنا جسر، عن الحسن، في قوله: " {وما تغيض الارحام} [الرعد: ] قال: غيضوضتها السقط "
 
  قوله تعالي: {وما تزداد} 
 [الرعد: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن نمير، عن حميد بن سليمان، عن مجاهد: " {وما تزداد} [الرعد: ] قال: ارتفاع الحيض فلا تراه حتي تلد "
 
    
 حدثنا الحسن بن علي بن عفان، ثنا معاوية بن هشام، عن سفيان، عن جويبر، عن الضحاك، قوله: " {وما تزداد} [الرعد: ] قال: ما فوق التسعة فهو زيادة "
 
    
 حدثنا محمد بن عمار بن الحارث، ثنا ابو الوليد، ثنا ابو زيد، عن عاصم، عن عكرمة، في هذه الاية: " {وما تزداد} [الرعد: ] قال: فلها بكل يوم حاضت علي حملها يوما يزداد، وهي في طهرها حتي تستكمل تسعة اشهر طاهرة "
 
    
 حدثنا الحسن بن عرفة، ثنا مروان بن شجاع، عن خصيف، عن سعيد بن جبير، في قول الله: " {يعلم ما تحمل كل انثي وما تغيض الارحام وما تزداد} [الرعد: ] قال: عدد كل يوم تري فيه الدم وهي حامل يكون زيادة في اجل الحمل "
 
    
 حدثنا علي بن الحسين، ثنا نصر بن علي، ثنا عمر بن حمزة، شيخ من بني قيس، ثنا داود بن ابي هند، عن مكحول، قال: " الجنين في بطن امه لا يطلب ولا يحزن ولا يغتم، وانما ياتيه رزقه في بطن امه من دم حيضتها، فمن ثم لا تحيض الحامل، فاذا وقع الي الارض استهل، واستهلاله استنكارا لمكانه فاذا قطعت سرته حول الله رزقه الي ثدي امه، فياكله فاذا هو بلغ، قال: هو الموت او القتل، قال: اني لي بالرزق؟ فيقول مكحول: يا ويحك غذاك، وانت في بطن امك وانت طفل صغير حتي اذا اشتددت وعقلت. قلت: هو الموت او القتل، اين لي بالرزق، ثم قرا مكحول: {يعلم ما تحمل كل انثي وما تغيض الارحام وما تزداد وكل شء عنده بمقدار} [الرعد: ] "
 
  قوله: {وكل شء عنده بمقدار} 
 [الرعد: ]
 
    
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني ابي، حدثني عمي، حدثني ابي، عن ابيه عبد الله بن عباس يعني قوله: " {وكل شء عنده بمقدار} [الرعد: ] : يعني ذلك يعلمه "
 
    
 اخبرنا علي بن الحسن الهسنجاني، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، قوله: " {وكل شء عنده بمقدار} [الرعد: ] اي باجل حفظ ارزاق خلقه واجالهم، وجعل لذلك اجلا معلوما "
 
  قوله: {عالم الغيب والشهادة الكبير المتعال}
 
    
 حدثنا عباس بن محمد الدوري، ثنا محمد بن الصلت، عن بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {عالم الغيب والشهادة} [الرعد: ] قال: السر والعلانية "
 
  قوله: {سواء منكم من اسر القول ومن جهر به} 
 [الرعد: ]
 
    
 حدثنا احمد بن سنان، ثنا يعقوب بن محمد الزهري، ثنا عبد العزيز بن عمران، عن عبد الله بن زيد بن اسلم، عن ابيه، عن عطاء بن يسار، عن ابن عباس، قال: " انزل الله تبارك وتعالي في عامر واربد وما كانا هما به من النبي صلي الله عليه وسلم: {سواء منكم من اسر القول ومن جهر به} [الرعد: ] الاية "
 
    
 حدثنا عمر بن شبة النميري، ثنا عبد الصمد بن عبد الوارث، ثنا مستور بن عباد، عن الحسن: " {سواء منكم من اسر القول ومن جهر به} [الرعد: ] قال: يعلم من السر ما يعلم من العلانية، ويعلم من العلانية ما يعلم من السر "
 
    
 حدثنا علي بن الحسين الهسنجاني، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، قوله: " {سواء منكم من اسر القول ومن جهر به} [الرعد: ] : كل ذلك سواء عنده السر عنده علانية، والظلمة عنده ضوء "
 
  قوله تعالي: {ومن هو مستخف بالليل} 
 [الرعد: ]
 
    
 حدثنا عمر بن شبه، ثنا عبد الصمد بن عبد الوارث، ثنا مستور بن عبادة، عن الحسن، في قوله: " {ومن هو مستخف بالليل} [الرعد: ] قال: يعلم من الليل ما يعلم من النهار، ويعلم من النهار ما يعلم من الليل "
 
 حدثنا ابي، ثنا محمود بن خالد، ثنا الفريابي، عن سفيان، عن خصيف، عن مجاهد، في قوله: " {ومن هو مستخف بالليل} [الرعد: ] قال: راكب راسه بالمعاصي "
 
    
 حدثنا علي بن الحسين الهسنجاني، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة: " {ومن هو مستخف بالليل} [الرعد: ] : اي في ظلمة الليل "
 
  
  قوله 
 تعالي: {وسارب بالنهار} </span>[الرعد: ]
 
    
 حدثنا ابي، ثنا محمد بن عبد الله بن بكر الصنعاني المقدسي، ثنا ابو سعيد، مولي بني هاشم، ثنا سهل بن ابي الصلت، قال: سمعت الحسن، يقول في قوله: " {ومن هو مستخف بالليل وسارب بالنهار} [الرعد: ] والسارب: النادي بالنهار "
 
    
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني ابي، حدثني عمي، حدثني ابي، عن ابن عباس، قوله: " {وسارب بالنهار} [الرعد: ] : قال: اذا خرج بالنهار اري الناس انه برء من الاثم "
 
    
 حدثنا ابي، ثنا محمود بن خالد، ثنا الفريابي، عن سفيان، عن خصيف، عن مجاهد: " {وسارب بالنهار} [الرعد: ] قال: ظاهر بالنهار بالمعاصي "
 
