 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قوله: " {فخذها بقوة} [الاعراف: ] ، قال: بجد وحزم "
 
 حدثنا ابي، ثنا احمد بن عبد الرحمن الدشتكي، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع، قوله: " {فخذها بقوة} [الاعراف: ] بالطاعة "
 
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، قوله: " {فخذها بقوة} [الاعراف: ] ، يعني: بجد واجتهاد "
 
 حدثنا علي بن الحسين، انبا محمد بن ابي حماد، ثنا مهران، عن سفيان
  [ص: ]
 ، " {فخذها بقوة} [الاعراف: ] يقول بعمل وقوله تعالي: {يا يحيي خذ الكتاب بقوة} [مريم: ] ، قال بعمل "
 
  قوله تعالي: {وامر قومك ياخذوا باحسنها} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، قوله: " {وامر قومك ياخذوا باحسنها} [الاعراف: ] ، قال: باحسن ما يجدون منها "
 
  قوله تعالي: {ساريكم} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا محمد بن عبد الرحمن العرزمي، ثنا عمرو بن ثابت، عن ابيه، عن سعيد بن جبير، " {ساريكم دار الفاسقين} [الاعراف: ] ، قال: رفعت لموسي حتي راها "
 
  الوجه الثاني
 
 ذكر لي عبد الله بن احمد الدشتكي، ثنا ابي، ثنا عطاف بن غزوان، ثنا محمد بن مسعر، قال: سالت سفيان بن عيينة، عن قوله: " {ساريكم دار} [الاعراف: ] ، يقول: سابين كيف ذلك "
 
  قوله تعالي: {دار الفاسقين} 
 [الاعراف: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: " {دار الفاسقين} [الاعراف: ] ، قال: مصيرهم في الاخرة "
 
 حدثنا عمر بن شبه، ثنا ابو خلف يعني عبد الله بن عيسي، ثنا يونس، عن الحسن، " {ساريكم دار الفاسقين} [الاعراف: ] ، قال: جهنم "
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة، " {دار الفاسقين} [الاعراف: ] منازلهم "
 
 حدثنا علي بن الحسين، ثنا محمد بن ابي حماد، ثنا مهران، عن سفيان، قوله: " {دار الفاسقين} [الاعراف: ] ، يقول: هلاك الفاسقين "
 
  قوله تعالي: {الفاسقين} 
 [البقرة: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قوله: " {ساريكم دار الفاسقين} [الاعراف: ] ، قال: دار الكفار "
 
  قوله تعالي: {ساصرف عن اياتي} 
 [الاعراف: ]
 
 ذكر عن عمرو العنقزي، عن اسباط، عن السدي، في قوله: " {ساصرف عن اياتي الذين يتكبرون في الارض بغير الحق} [الاعراف: ] ، يقول: ساصرفهم ان يتفكروا في اياتي "
 
 حدثنا احمد بن منصور المروزي، حدثني عبد الرحيم بن الحسن الصفار، قال: قال سفيان بن عيينة في قول الله: " {ساصرف عن اياتي الذين يتكبرون في الارض بغير الحق} [الاعراف: ] ، يقول: انزع عنهم فهم القران فاصرفهم عن اياتي "
 
 حدثنا ابي، حدثني ابن ابي الحواري، ثنا الوليد بن عتبة، قال: سمعت الفريابي، يقول في قول الله: " {ساصرف عن اياتي الذين يتكبرون في الارض بغير الحق} [الاعراف: ] ، قال: امنع قلوبهم من التفكير في امري "
 
  قوله تعالي: {وان يروا كل اية لا يءمنوا بها} 
 [الانعام: ]
 
  قوله تعالي: {والذين كذبوا باياتنا ولقاء الاخرة} 
 [الاعراف: ]
 
 حدثنا ابو بكر بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك، قوله: " {حبطت اعمالهم} [الاعراف: ] ، يعني: بطلت اعمالهم "
 
  قوله تعالي: {واتخذ قوم موسي من بعده من حليهم} 
 [الاعراف: ]
 
 حدثنا عمار بن خالد الواسطي، ثنا محمد بن الحسن، ويزيد بن هارون، واللفظ، لمحمد، عن اصبغ بن يزيد الوراق، عن القاسم بن ابي ايوب، حدثني سعيد بن جبير، عن ابن عباس، قال: " وكان هارون قد خطبهم، فقال: انكم خرجتم من مصر وعندكم وداءع لقوم فرعون، وعواري، ولكم فيهم مثل ذلك واني اري ان تحبسوا مالهم عندكم ولا احل لكم وديعة استودعتموها، او عارية فلسنا برادي شيءا من ذلك اليهم، ولا ممسكيه لانفسنا، فحفر حفيرا فامر كل قوم عندهم شء من ذلك من متاع او حلية ان يقذفوه في تلك الحفرة، ثم اوقد عليه النار فحرقه، فقال: لا يكون لنا ولا لهم، وكان السامري رجلا من قوم يعبدون البقر جيران لهم ليس من بني اسراءيل، فاحتمل مع بني اسراءيل، حين احتملوا، فقضي له انه راي اثرا فاخذ منه قبضة فمر بهارون، فقال له هارون: يا سامري الا تلقي ما في يدك وهو قابض عليه لا يراه احد
  [ص: ]
 طوال ذلك، فقال: هذه قبضة من اثر الرسول الذي جاوز بكم البحر فلا القيها لشء الا ان تدعوا الله اذا القيتها ان تكون ما اريد، قال: فالقها ودعا له هارون، فقال: اريد ان يكون عجلا، فاجتمع ما كان في الحفرة من متاع ونحاس او حلي او حديد فصار عجلا اجوف ليس فيه روح وله خوار "
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قال: " وكان السامري قد ابصر جبريل عليه السلام علي فرس واخذ من اثر الفرس قبضة من تراب، فقال حين مضي ثلاثون ليلة يا بني اسراءيل: ان معكم حليا من حلي ال فرعون، وهذا حرام عليكم، فهاتوا ما عندكم نحرقها فاتوه ما كان عندهم، فاوقدوا نارا فالقي الحلي في النار، فلما ذاب الحلي القي تلك القبضة من تراب في النار فصار عجلا جسدا له خوار فخار خواره لم يثني "
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة، " {من حليهم عجلا} [الاعراف: ] ، قال: استعاروا حليا من ال فرعون فجمعه السامري، فصاغ منه عجلا فجعله الله جسدا لحما ودما له خوار "
 
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، " قال: موسي: " يا رب هذا السامري امرهم ان يتخذوا العجل ارايت الروح من نفخها فيه قال الرب: انا، قال رب: فانت اذا اضللتهم "
 
  قوله: {له خوار} 
 [الاعراف: ]
 
 حدثنا عمار بن خالد، ثنا محمد بن الحسن، ويزيد بن هارون، واللفظ لمحمد، عن اصبغ بن زيد الوراق، عن القاسم بن ابي ايوب، حدثني سعيد بن جبير، " {له خوار} [الاعراف: ] ، قال: والله ما كان له صوت قط ولكن الريح كانت تدخل في دبره وتخرج من فيه فكان ذلك الصوت من ذلك "
 
 حدثنا ابن ابي الثلج، ثنا يزيد بن هارون، انبا حماد بن سلمة، عن فرقد السبخي، عن سعيد بن جبير، عن ابن عباس، قال: «اذا خار سجدوا واذا سكت رفعوا رءوسهم»
 
  قوله تعالي: {الم يروا انه لا يكلمهم} 
 [الاعراف: ]
 
 حدثنا محمد بن عبد الله بن ابي الثلج، ثنا يزيد، انبا جويبر، عن الضحاك بن مزاحم، قال: " في العجل خار خورة لم يثن، الم تر ان الله قال: {الم يروا انه لا يكلمهم} [الاعراف: ] ، و {الا يرجع اليهم قولا} [طه: ] "
 
  قوله تعالي: {ولما سقط في ايديهم وراوا انهم قد ضلوا} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، قال: " فلما اسقط في ايدي بني اسراءيل حين جاء موسي عليه السلام، وراوا انهم قد ضلوا، قالوا: {لءن لم يرحمنا ربنا ويغفر لنا لنكونن من الخاسرين} [الاعراف: ] ، فابي الله عز وجل ان يقبل توبة بني اسراءيل الا بالحال التي كرهوا ان يقاتلوهم حين عبدوا العجل "
 
  قوله تعالي: {ولما رجع موسي الي قومه غضبان اسفا} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {ولما رجع موسي الي قومه غضبان اسفا} [الاعراف: ] يعني: الغضبان الحزين "
 
  قوله تعالي: {اسفا} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {غضبان اسفا} [الاعراف: ] ، قال: حزين " وروي عن الحسن، ومالك بن دينار مثل ذلك
 
 اخبرنا محمد بن سعد العوفي، فيما كتب الي حدثني ابي، حدثني عمي، عن ابيه، عن ابيه، عن ابن عباس، قوله: " {ولما رجع موسي الي قومه غضبان اسفا} [الاعراف: ] ، يقول: اسفا حزينا، وفي الزخرف {فلما اسفونا} [الزخرف: ] ، يقول: اغضبونا، والاسف علي وجهين: الغضب والحزن "
 
  والوجه الثاني
 
 حدثنا علي بن الحسين، ثنا يحيي بن خلف، ثنا ابو عاصم، عن عيسي بن ميمون، عن ابن ابي نجيح، عن مجاهد، " {غضبان اسفا} [الاعراف: ] قال: جزعا "
 
  قوله تعالي: {قال بءسما خلفتموني من بعدي} 
 [الاعراف: ]
 
 حدثنا الحسن بن محمد الصباح، ثنا عفان، ثنا ابو عوانة، عن ابي بشر، عن سعيد بن جبير، عن ابن عباس، قال النبي صلي الله عليه وسلم: «يرحم الله موسي ليس المعاين كالمخبر، اخبره ربه تبارك وتعالي ان قومه فتنوا، فلم يلق الالواح، فلما راها وعاينهم القي الالواح»
 
 حدثنا ابي، ثنا احمد بن ابراهيم الدورقي، ثنا حجاج، عن ابن جريج، اخبرني يعلي بن مسلم، عن سعيد، عن ابن عباس: «انه لما القي موسي الالواح فتكسرت فرفعت الا سدسها»
 
  قوله تعالي: {واخذ براس اخيه يجره اليه} 
 [الاعراف: ]
 
 حدثنا عمار بن خالد الواسطي، ثنا محمد بن الحسن الواسطي، ويزيد بن هارون، واللفظ لمحمد، عن اصبغ بن زيد الوراق، عن القاسم بن ابي ايوب، عن سعيد بن جبير، عن ابن عباس، قال: " {فرجع موسي الي قومه غضبان اسفا} [طه: ] ، فقال لهم: ما سمعتم في القران واخذ براس اخيه يجره اليه والقي الالواح من الغضب، ثم انه عذر اخاه بعذره واستغفر له "
 
  قوله تعالي: {ولا تجعلني مع القوم الظالمين} 
 [الاعراف: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، " {ولا تجعلني مع القوم الظالمين} [الاعراف: ] اصحاب العجل "
 
  قوله تعالي: {قال رب اغفر لي ولاخي} 
 [الاعراف: ]
 
 حدثنا عمار بن خالد، ثنا محمد بن الحسن، ويزيد بن هارون، واللفظ لمحمد، عن اصبغ بن زيد، عن القاسم بن ابي ايوب، حدثني سعيد بن جبير، عن ابن عباس، يعني قوله: " {قال رب اغفر لي ولاخي} [الاعراف: ] ، قال: ثم انه عذر اخاه بعذره واستغفر له "
 
  قوله تعالي: {ان الذين اتخذوا العجل} 
 [الاعراف: ]
 
 حدثنا علي بن الحسين، ثنا هشام بن عمار، ثنا صدقة بن عمرو الغساني، ثنا عباد بن ميسرة المنقري، عن الحسن، قال: «اسم عجل بني اسراءيل الذي عبدوه يهبوث»
 
  قوله تعالي: {سينالهم غضب من ربهم} 
 [الاعراف: ]
 
 حدثنا احمد بن منصور الرمادي، ثنا عبد الرزاق، انبا معمر، عن ايوب، قال: كان ابو قلابة اذا قرا هذه الاية: " {ان الذين اتخذوا العجل سينالهم غضب من ربهم وذلة في الحياة الدنيا} [الاعراف: ] ، قال ابو قلابة: فهو جزاء كل مفتر الي يوم القيامة ان يذله الله "
 
 ذكر لي عبد الله بن احمد الدشتكي، ثنا ابي، ثنا عطاف بن غزوان، ثنا محمد بن مسعر، قال: سالت سفيان بن عيينة، عن قوله: " {ان الذين اتخذوا العجل سينالهم غضب من ربهم} [الاعراف: ] ، قال: ختم من الله الي يوم القيامة "
 
  قوله تعالي: {وكذلك نجزي المفترين} 
 [الاعراف: ]
 
 حدثنا الحسن بن محمد بن الصباح، ثنا عفان، ثنا حماد بن سلمة، انبا ثابت، ان قيس بن عباد، وجارية بن قدامة، قالا: " انا سمعنا الله يقول في كتابه: " {ان الذين اتخذوا العجل سينالهم غضب من ربهم وذلة في الحياة الدنيا وكذلك نجزي المفترين} [الاعراف: ] ، وما نري القوم الا قد افتروا فرية وما اريها الا ستصيبهم "
 
 حدثنا ابي، ثنا سليمان بن حرب، ثنا حماد بن زيد، عن ايوب، عن ابي قلابة، " {ان الذين اتخذوا العجل سينالهم غضب من ربهم وذلة في الحياة الدنيا، وكذلك نجزي المفترين} [الاعراف: ] ، فهي والله لكل مفتر كذب الي يوم القيامة وروي عن سعيد بن جبير نحوه
 
 حدثنا ابي، ثنا محمد بن ابي عمر العدني، " قال سفيان: " {وكذلك نجزي المفترين} [الاعراف: ] ، قال: كل صاحب بدعة ذليل "
 
 حدثنا ابي، ثنا احمد بن ابراهيم الدورقي، ثنا الفيض بن اسحاق، قال
  [ص: ]
 : سمعت الفضيل بن عياض، قال: " كل شء في القران {وكذلك نجزي المفترين} [الاعراف: ] ونحو هذا يقول: كما اهلك الذين من قبل فكذلك يفعل بالمفترين ونحو هذا "
 
  قوله تعالي: {والذين عملوا السيءات ثم تابوا من بعدها} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا مسلم بن ابراهيم، ثنا ابان، انبا قتادة، عن عزرة، عن الحسن العرني، عن علقمة، عن عبد الله بن مسعود، انه سءل، " عن ذلك يعني الرجل يزني بالمراة ثم يتزوجها فتلا هذه الاية: {والذين عملوا السيءات ثم تابوا من بعدها وامنوا ان ربك من بعدها لغفور رحيم} [الاعراف: ] ، فتلاها عبد الله عشر مرات، فلم يامرهم ولم ينههم عنها "
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، قوله تعالي: " {لغفور} [الاعراف: ] لما كان منهم في الشرك "
 
 حدثنا علي بن الحسين، ثنا عباس بن الوليد النرسي، ثنا يزيد بن زريع، عن سعيد، عن قتادة، قوله: " {غفور} [الاعراف: ] يعني الذنوب الكثيرة، او الكبيرة شك يزيد "
 
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا ابن لهيعة، حدثني عطاء، عن سعيد بن جبير، قوله: " {رحيم} [الاعراف: ] ، قال: رحيم بهم بعد التوبة "
 
 حدثنا علي بن الحسين، ثنا عباس بن الوليد، ثنا يزيد، عن سعيد، عن قتادة، قوله: " {رحيم} [البقرة: ] ، قال: بعباده "
 
  قوله تعالي: {ولما سكت عن موسي الغضب} 
 [الاعراف: ]
 
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا يونس بن بكير، حدثني محمد بن اسحاق، حدثني صدقة بن يسار، حدثني سعيد بن جبير، عن ابن عباس، " {ولما سكت عن موسي الغضب،} [الاعراف: ] ، قال: فلما ذهب، عن موسي الغضب، فذلك قول الله: {اخذ الالواح وفي نسختها هدي ورحمة للذين هم لربهم يرهبون} [الاعراف: ] "
 
  قوله تعالي: {وفي نسختها هدي ورحمة} 
 [الاعراف: ]
 
 وبه الي ابن عباس قال: " اعطي الله موسي التوراة في سبعة الواح من
  [ص: ]
 زبرجد فيها تبيان لكل شء وموعظة التوراة مكتوبة، فلما جاء بها فراي بني اسراءيل عكفوا علي العجل، رمي التوراة من يده، فتحطمت، واقبل علي هارون فاخذ براسه فرفع الله منها ستة اسباع وبقي سبع، فلما ذهب عن موسي الغضب، فذلك قول الله: {اخذ الالواح وفي نسختها هدي ورحمة للذين هم لربهم يرهبون} [الاعراف: ] ، قال: فيما بقي منها "
 
  قوله تعالي: {لربهم يرهبون} 
 [الاعراف: ]
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول في قول الله: " {للذين هم لربهم يرهبون} [الاعراف: ] ، قال: يخافون ويتقون "
 
  قوله تعالي: {واختار موسي قومه سبعين رجلا لميقاتنا} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو بكر بن بشار، ثنا يحيي بن سعيد، ثنا سفيان، عن ابي اسحاق، عن عمارة، عن علي، قال: " انطلق موسي، وهارون، وبشر، وبشير، قال: فانطلقوا الي سفح جبل فنام هارون علي سريره فتوفاه الله، فلما رجع موسي الي بني اسراءيل قالوا له: اين هارون؟ قال: توفاه الله، قالوا: انت قتلته، حسدتنا علي خلقه ولينه  او كلمة نحوها  قال: اختاروا من شءتم؟ فاختاروا سبعين رجلا. فذلك قوله: {واختار موسي قومه سبعين رجلا لميقاتنا} [الاعراف: ] فلما انتهوا اليه قالوا: يا هارون من قتلك، قال: ما قتلني احد ولكن توفاني الله، قالوا: يا موسي لن نعصي بعدها فاخذتهم الرجفة "
 
 حدثنا عمار بن خالد الواسطي، ويزيد بن هارون، عن اصبغ بن زيد، عن القاسم بن ابي ايوب، حدثني سعيد بن جبير، عن ابن عباس، قال: " ثم انصرف يعني موسي الي السامري، فقال له: ما حملك علي ما صنعت، قال: قبضت قبضة من اثر رسول الله فطنت وعميت عليكم فقذفتها {وكذلك سولت لي نفسي} [طه: ] الي قوله: {ثم لننسفنه في اليم نسفا} [طه: ] ، ولو كان الها لم يخلص الي ذلك منه فاستيقن بنو اسراءيل
  [ص: ]
 بالفتنة واغتبط الذين كان رايهم فيه راي هارون، قالوا بجماعتهم لموسي: سل ربك ان يفتح لنا باب توبة نصنعها تكفر لنا ما عملنا فاختار موسي من قومه سبعين رجلا لذلك لا يالون الخير خيار بني اسراءيل، ومن لم يشرك في العجل فانطلق يسال ربه عز وجل لقومه التوبة فرجفت به الارض "
 
 حدثنا ابي، ثنا موسي بن اسماعيل، ثنا حماد، عن ابي هارون العبدي، عن نوف البكالي " ان موسي، صلي الله عليه وسلم لما اختار من قومه سبعين رجلا، قال لهم: " فدوا الي الله وسلوه، فكانت لموسي مسالة، ولهم مسالة، فلما انتهي الي الطور المكان الذي وعده الله به قال لهم موسي: سلوا الله قالوا: {ارنا الله جهرة} [النساء: ] ، قال: ويحكم تسالون الله هذا مرتين، قالوا: هي مسالتنا {ارنا الله جهرة} [النساء: ] ، فاخذتهم الرجفة "
 
 حدثنا ابو زرعة، ثنا عبد الله بن بكير، حدثني ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: " {واختار موسي قومه سبعين رجلا} [الاعراف: ] ، قال: اختار موسي من قومه اثني عشر نقيبا من اثني عشر سبطا لكل سبط رجلا يعني بالنقيب النافذ في الامر واخذه له "
 
 حدثنا ابي، ثنا مسدد، ثنا يحيي بن سعيد، عن ابي سلمة، سمعت ابا سعيد الرقاشي، يقول: " {اختار موسي قومه سبعين رجلا لميقاتنا} [الاعراف: ] ، قال: كانوا ايتاما قد جاوزوا العشرين، فلم يبلغوا الاربعين، وذلك ان ابن العشرين قد ذهب جهله، وصباه، وان ابن الاربعين، لم يفقد من عقله شيءا "
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، " {واختار موسي قومه سبعين رجلا لميقاتنا} [الاعراف: ] ، قال: " كان الله عز وجل امره ان يختار من قومه سبعين رجلا فاختار سبعين رجلا، فبرز بهم ليدعوا ربهم تبارك وتعالي، فكان فيما دعوا الله عز وجل ان قالوا: اللهم اعطنا ما لم تعط احدا قبلنا، ولا تعط احدا بعدنا فكره الله جل ثناءه ذلك من دعاءهم فاخذتهم الرجفة "
 
  قوله عز وجل: {فلما اخذتهم الرجفة} 
 [الاعراف: ]
 
 حدثنا عمار بن خالد، ثنا محمد بن الحسين، ويزيد بن هارون، قالا: ثنا اصبغ بن زيد، عن القاسم بن ابي ايوب، حدثني سعيد بن جبير، عن ابن عباس، " {اخذتهم الرجفة} [الاعراف: ] ، «وكان فيهم من قد اطلع الله منه علي ما اشرب قلبه من حب العجل والايمان به، فلذلك رجفت بهم الارض»
 
 حدثنا ابي، ثنا موسي بن اسماعيل، ثنا حماد بن سلمة، عن ابي هارون العبدي، عن نوف البكالي، قال: " {فقالوا: ارنا الله جهرة} [النساء: ] فاخذتهم الرجفة فصعقوا "
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، " {فلما اخذتهم الرجفة} [الاعراف: ] ، ماتوا ثم احياهم "
 
 حدثنا ابي، ثنا ابو توبة، ثنا ابن المبارك، عن عوف، عن سعيد بن حيان، قال: «ان السبعين انما اخذتهم الرجفة لانهم لم يامروا بالعجل، ولم ينهوا عنه»
 
  قوله تعالي: {قال رب لو شءت اهلكتهم من قبل واياي} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا محمد بن بشار، ثنا يحيي بن سعيد، عن سفيان، عن ابي اسحاق، عن عمارة، عن علي، قال: " {اخذتهم الرجفة} [الاعراف: ] ، فجعل موسي يرجع يمينا وشمالا، {قال رب لو شءت اهلكتهم من قبل واياي اتهلكنا بما فعل السفهاء منا ان هي الا فتنتك تضل بها من تشاء وتهدي من تشاء} [الاعراف: ] ، فاحياهم الله وجعلهم انبياء "
 
 حدثنا ابي، ثنا موسي بن اسماعيل، ثنا حماد، عن ابي هارون العبدي، عن نوف البكالي، قال: " فقال موسي: " اي رب جءتك بسبعين من خيار بني اسراءيل، فارجع اليهم وليس معي منهم احد، فكيف اصنع ببني اسراءيل اليس يقتلوني؟ فقيل له: سل مسالتهم ومسالته وجعلت تلك الدعوة لهذه الامة "
 
  قوله تعالي: {ان هي الا فتنتك} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، " {ان هي الا فتنتك} [الاعراف: ] ، يقول: ان هو الا عذابك "
 
 حدثنا محمد بن عمار بن الحارث، ثنا عبد الرحمن الدشتكي، انبا ابو جعفر الرازي، عن الربيع بن انس، في قوله: " {ان هي الا فتنتك} [الاعراف: ] ، يقول: بليتك " وروي عن سعيد بن جبير نحو ذلك
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول: في قول الله: " {ان هي الا فتنتك} [الاعراف: ] ، قال: انت فتنتهم "
 
  قوله تعالي: {تضل بها من تشاء} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: " {تضل بها من تشاء} [الاعراف: ] ، يقول: ان هو الا عذابك تصيب به من تشاء "
 
  قوله تعالي: {وتهدي من تشاء} 
 [الاعراف: ]
 
 وبه عن ابن عباس، قوله: " {ان هي الا فتنتك تضل بها من تشاء وتهدي من تشاء} [الاعراف: ] ، يقول: ان هو الا عذابك تصيب به من تشاء وتصرفه عن من تشاء "
 
  قوله تعالي: {انت ولينا فاغفر لنا} 
 [الاعراف: ]
 
 وبه عن ابن عباس، " {انت ولينا فاغفر لنا} [الاعراف: ] ، يعني قال: ربنا اغفر لنا وارحمنا وانت خير الغافرين "
 
  قوله تعالي: {واكتب لنا في هذه الدنيا} 
 [الاعراف: ]
 
 ذكر عن عبد الرحمن بن بشر بن الحكم النيسابوري، ثنا موسي بن عبد العزيز، حدثني الحكم بن ابان، حدثني عكرمة، في قوله: " {واكتب لنا في هذه الدنيا حسنة وفي الاخرة} [الاعراف: ] ، فكتب الرحمة يومءذ لهذه الامة "
 
  قوله تعالي: {في هذه الدنيا حسنة وفي الاخرة} 
 [الاعراف: ]
 
 حدثنا ابو زرعة، ثنا ابو الاحوص محمد بن حيان، حدثني عباد بن العوام، اخبرني هشام، عن الحسن، قوله: " {ربنا اتنا في الدنيا حسنة} [البقرة: ] ، قال: الحسنة في الدنيا العلم والعبادة "
 
 حدثنا اسيد بن عاصم، ثنا الحسين بن حفص، ثنا سفيان، عن رجل، عن الحسن، قوله: " {في الدنيا حسنة} [الاعراف: ] ، قال: الرزق الطيب، والعلم النافع في الدنيا "
 
  والوجه الثاني
 
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انبا معمر، عن قتادة، " {في الدنيا حسنة} [البقرة: ] ، في الدنيا عافية "
 
  والوجه الثالث
 
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، حدثني عبد الله بن لهيعة، عن يزيد بن ابي حبيب، عن محمد بن كعب القرظي، في هذه الاية " {في الدنيا حسنة} [البقرة: ] ، قال: المراة الصالحة من الحسنات "
 
  قوله تعالي: {انا هدنا اليك} 
 [الاعراف: ]
 
 حدثنا ابو سعيد الاشج، ثنا ابو نعيم، عن اسراءيل، عن ابي يحيي، عن مجاهد، عن ابن عباس، " {هدنا اليك} [الاعراف: ] ، تبنا اليك " وروي عن ابي الطفيل، وابي العالية، ومجاهد، وسعيد بن جبير، وابراهيم التيمي، والنخعي، وعكرمة، وعطاء الخراساني، والربيع بن انس، والضحاك، وقتادة نحو ذلك
 
  الوجه الثاني
 
 حدثنا ابي، ثنا المعلي، عن ابيه، ثنا هارون بن ابي عيسي الشامي، عن محمد بن اسحاق، قال: سمعت ابا وجزة، يقول: (انا هدنا اليك) بكسر الهاء يعني: ملنا "
 
 ذكر عن ابي النضر هاشم بن القاسم، ثنا المسعودي، عن علي بن علي بن السايب، عن ابراهيم، عن عبد الله بن مسعود، قال: " نحن اعلم من حيث تسمت اليهود باليهودية منهم، كلمة موسي صلي الله عليه وسلم: {انا هدنا اليك} [الاعراف: ] ولم تسمت النصاري بالنصرانية، كلمة عيسي صلي الله عليه وسلم: {كونوا انصار الله} [الصف: ] "
 
  قوله تعالي: {قال عذابي اصيب به من اشاء} 
 [الاعراف: ]
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قوله: " {قال عذابي اصيب به من اشاء} [الاعراف: ] للعذاب الذي ذكر الله عز وجل "
 
  قوله تعالي: {ورحمتي} 
 [الاعراف: ]
 
 حدثنا محمد بن عبد الله بن يزيد المقرء، ثنا سفيان، عن عمرو يعني ابن دينار، عن عطاء، قال: «ان الله خلق رحمته ماءة رحمة فقسم بين خلقه رحمة، وادخر لنفسه تسعة وتسعين، فمن تلك الرحمة يتعاطف بها بنو ادم بعضهم علي بعض، والبهاءم بعضها علي بعض، حتي يوجد الطير علي فراخه، فاذا كان يوم القيامة يجمع تلك الرحمة الي التسعة والتسعين فوسعت رحمته كل شء»
 
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول: " {ورحمتي} [الاعراف: ] ، قال: التوبة {فساكتبها للذين يتقون} [الاعراف: ] ، قال: فرحمته التوبة التي سال موسي "
 
  قوله تعالي: {وسعت كل شء} 
 [الاعراف: ]
 
 اخبرنا محمد بن حماد الطهراني، فيما كتب الي، انبا عبد الرزاق، عن معمر، عن الحسن، وقتادة، يعني قوله: " {وسعت كل شء} [الاعراف: ] ، قال: وسعت في الدنيا البر والفاجر وهي يوم القيامة للذين اتقوا خاصة "
 
 حدثنا ابو زرعة، ثنا صفوان، عن الوليد، قال: سالت صدقة بن يزيد الخراساني، عن قول الله: " {ورحمتي وسعت كل شء} [الاعراف: ] ، فقال: حدثني الحسن بن ذكوان، عن الحسن البصري، قال: اشترك في هذه الاية في الدنيا المسلم والكافر، فاذا كان يوم القيامة كانت للمتقين خاصة "
 
 حدثنا ابي، ثنا سلمة بن شبيب، ثنا ابراهيم بن خالد، عن عمر بن عبد الرحمن بن مهرب، قال: ذكرنا عند سماك بن الفضل، اي شء اعظم فذكروا
  [ص: ]
 السماوات والارض وهو ساكت، فقالوا: ما تقول يا ابا الفضل، فقال: " ما من شء اعظم من رحمته قال الله تعالي: {ورحمتي وسعت كل شء} [الاعراف: ] "
 
 حدثنا ابي، ثنا ابن ابي عمر، ثنا سفيان، عن ابي بكر الهذلي، قال: " لما نزلت {ورحمتي وسعت كل شء} [الاعراف: ] ، قال ابليس: يا رب وانا من الشء فنزلت: {فساكتبها للذين يتقون ويءتون الزكاة والذين هم باياتنا يءمنون} [الاعراف: ] فنزعها الله من ابليس "
 
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد بن بشير، عن قتادة، يقول: قوله: " {ورحمتي وسعت كل شء} [الاعراف: ] ، سمعها ناس فقالوا: انا من ذلك الشء فانزل الله: {فساكتبها للذين يتقون ويءتون الزكاة} [الاعراف: ] "
 
  قوله تعالي: {فساكتبها} 
 [الاعراف: ]
 
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قال: " وكان تبارك وتعالي كتب في الالواح ذكر محمد صلي الله عليه وسلم وذكر امته، وما ذخر لهم عنده، وما يسر عليهم في دينهم، وما وسع عليهم فيما احل لهم: {قال عذابي اصيب به من اشاء ورحمتي وسعت كل شء فساكتبها للذين يتقون ويءتون الزكاة والذين هم باياتنا يءمنون، الذين يتبعون الرسول النبي الامي الذي يجدونه مكتوبا عندهم في التوراة والانجيل} [الاعراف: ] "
 
 حدثنا ابو هارون الخزاز، ثنا عبد الله بن الجهم، ثنا عمرو بن ابي قيس، ثنا ليث، عن شهر، عن نوف، قال: " لما اختار موسي قومه سبعين رجلا لميقاتنا، قال الله: يا موسي اني معلم قومك التوراة عن ظهر قلوبهم رجلهم وامراتهم، واجعل السكينة في قلوبهم، واجعل لهم الارض مساجد وطهورا قال: فعرض ذلك موسي علي قومه فقالوا: لا نتعلم التوراة الا نظرا، ولا نصلي الا في الكناءس ولا تكون السكينة الا في التابوت، قال الله عز وجل: {فساكتبها للذين يتقون} [الاعراف: ] الي قوله: {والانجيل} [ال عمران: ] "
 
  قوله تعالي: {للذين يتقون} 
 [الانعام: ]
 
 حدثنا عمار بن خالد الواسطي، ثنا محمد بن الحسن، ويزيد بن هارون
  [ص: ]
 ، عن اصبغ بن زيد، عن القاسم بن ابي ايوب، حدثني سعيد بن جبير، عن ابن عباس: " {ورحمتي وسعت كل شء فساكتبها للذين يتقون ويءتون الزكاة والذين هم باياتنا يءمنون} [الاعراف: ] ، فقال موسي: رب سالتك التوبة لقومي فقلت ان رحمتك كتبتها لقوم غير قومك فليتك اخرتني حتي تخرجني حيا في امة ذلك الرجل المرحومة "
 
 حدثنا محمد بن عبد الرحمن الهروي، ثنا العلاء بن عبد الجبار، ثنا حماد بن سلمة، عن عطاء بن الساءب، عن سعيد بن جبير، ان ابن عباس، قرا: " {ورحمتي وسعت كل شء فساكتبها للذين يتقون} [الاعراف: ] ، قال: جعلها الله لهذه الامة "
 
