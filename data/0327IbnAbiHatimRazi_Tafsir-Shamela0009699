  قوله تعالي: {تلك} 
 [البقرة: ]
 
    
 حدثنا موسي بن ابي موسي الخطمي، ثنا هارون بن حاتم، ثنا عبد
  [ص: ]
 الرحمن بن ابي حماد، ثنا اسباط، عن السدي، عن ابي مالك قوله: " {تلك} [يونس: ] يعني: هذه "
 
  قوله: {ايات} 
 [البقرة: ]
 
    
 حدثنا علي بن الحسين، ثنا علي بن زنجة، ثنا علي بن الحسن، عن ابن الحسين بن واقد، عن مطر قال: " {تلك ايات} [يونس: ] قال: الزبور "
 
  قوله تعالي: {الكتاب الحكيم} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا سهيل بن عثمان، ثنا ابن السماك، عن ابي بكر، عن الحسن في هذه الاية: " {الر تلك ايات الكتاب} [يونس: ] قال: التوراة والزبور "
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا ابو الجماهر، ثنا سعيد، عن قتادة، قوله: " {تلك ايات الكتاب} [يونس: ] قال: الكتب التي خلت قبل القران "
 
  قوله تعالي: {اكان للناس عجبا ان اوحينا الي رجل منهم} 
 [يونس: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو كريب محمد بن العلاء، ثنا عثمان بن سعيد، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قال: " بعث الله محمدا صلي الله عليه وسلم رسولا انكرت العرب ذلك، او من انكر ذلك منهم، قالوا الله اعظم من ان يكون رسوله بشرا مثل محمد، فانزل الله عز وجل: {اكان للناس عجبا ان اوحينا الي رجل منهم} [يونس: ] "
 
  قوله تعالي: {ان انذر الناس وبشر الذين امنوا} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا هشام بن عمار، ثنا الوليد بن مسلم، ثنا خليد، عن قتادة، قال: " المءمنون هم العجاجون بالليل والنهار والله ما زالوا يقولون: ربنا ربنا حتي استجيب لهم "
 
    
 واخبرنا محمود بن ادم المروزي، فيما كتب الي قال: سمعت النضر بن سهل، يقول: تفسير المءمن: «انه امن من عذاب الله»
 
  قوله تعالي: {ان لهم قدم صدق} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي
  [ص: ]
 طلحة، عن ابن عباس قوله: {وبشر الذين امنوا ان لهم قدم صدق عند ربهم} [يونس: ] قال: «تحقق لهم الشهادة في الذكر الاول»
 
  الوجه الثاني
 
    
 حدثنا ابو سعيد، ثنا زيد بن الحباب، عن ابراهيم بن يزيد، عن الوليد بن عبد الله بن ابي مغيث، عن مجاهد، {ان لهم قدم صدق عند ربهم} [يونس: ] قال: «صلاتهم وتسبيحهم»
 
  الوجه الثالث
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد في قول الله: {قدم صدق} [يونس: ] قال: «خيره»
 
  الوجه الرابع
 
    
 حدثنا ابي، حدثني عبد الله بن عمران بن علي الاسدي، ثنا يحيي بن الضريس ثنا خالد بن صبيح البجلي، عن مقاتل بن حيان، في قوله: {ان لهم قدم صدق عند ربهم} [يونس: ] قال محمد: «شفيع صدق»
 
  الوجه الخامس
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا رجل سماه عن السدي: {ان لهم قدم صدق عند ربهم} [يونس: ] قال: «يقدمون عليه عند ربهم»
 
  والوجه السادس
 
    
 حدثنا علي بن الحسين، ثنا الجراح بن مخلد، ثنا عبد الله بن ميمون، ثنا عوف، عن الحسن في قوله: {قدم صدق عند ربهم} [يونس: ] : مصيبتهم في نبيهم صلي الله عليه وسلم
 
  والوجه السابع
 
    
 حدثنا سهل بن بحر العسكري، ثنا جعفر بن حميد الكوفي، ثنا ابن المبارك، عن ابن جريج، عن مجاهد في قوله: {قدم صدق عند ربهم} [يونس: ] قال: «سلف صدق» وروي عن قتادة مثله
 
  والوجه الثامن
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن، ثنا عبد الله بن ابي جعفر، عن
  [ص: ]
 ابيه، عن الربيع بن انس في قوله: {وبشر الذين امنوا ان لهم قدم صدق عند ربهم} [يونس: ] قال: ثواب صدق عند ربهم "
 
  قوله تعالي: {عند ربهم} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا علية بن محمد الطنافسي، ثنا يحيي بن ادم، ثنا فضيل بن مرزوق، عن ملاك بن الجفون يعني عمرا، عن الحسن في قوله: {قدم صدق عند ربهم} [يونس: ] قال: «شفيع لهم يوم القيامة»
 
  قوله تعالي: {قال الكافرون ان هذا لساحر مبين} 
 [يونس: ]
 
    
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني ابي، حدثني عمي، عن ابيه، عن عطية، عن ابن عباس قوله: {قال الكافرون ان هذا لساحر مبين} [يونس: ] «لزادهم ذلك تكذيبا»
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {قال الكافرون ان هذا لساحر مبين} [يونس: ] فنظروا اليه فلم يصدقوا به "
 
  قوله تعالي: {ان ربكم الله الذي خلق السموات والارض}
 
    
 حدثنا ابي يونس بن محمد بن احمد بن يزيد بن عبد الله بن يزيد، بمكة، ثنا ابراهيم بن حمزة، عن عبد العزيز بن محمد، عن سعد بن اسحاق بن كعب بن عجرة: انه قال: نزلت هذه الاية: {ان ربكم الله الذي خلق السموات والارض في ستة ايام} " لقي ركبا عظيما لا يرون الا انهم من العرب فقالوا لهم: من انتم؟ قالوا: من الجن خرجنا من المدينة اخرجتنا هذه الاية "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، ثنا محمد بن اسحاق، قال: " ابتدع السماوات والارض ولم يكونا بقدرته، لم يستعن علي ذلك باحد من خلقه، ولم يشركه في شء من امره، فسلطانه قاهر قوله النافذ الذي يقول به لما اراه ان يقول له: كن فيكون ففرغ من خلق السماوات والارض في ستة ايام "
 
    
 اخبرنا محمد بن حماد الطهراني، فيما كتب الي، ثنا اسماعيل بن عبد الكريم، اخبرني عبد الصمد بن معقل، انه سمع عمه وهب بن منبه، يقول: «قال عزير يا رب امرت الماء فجمد في وسط الهواء، فجعلت منه سبعا وسميته السماوات، ثم امرت
  [ص: ]
 الماء ينفتق من التراب وامرت التراب ان يميز من الماء، فكان كذلك، فسميت جميع ذلك الارضين وجميع البحار»
 
  قوله تعالي: {في ستة ايام} 
 [الاعراف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: {خلق السموات والارض في ستة ايام} قال: «يوم مقداره الف سنة»
 
  قوله تعالي: {ثم استوي} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية، في قوله: {ثم استوي} [يونس: ] يقول: ارتفع وروي عن الحسن، والربيع بن انس مثله
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، عن ابن ابي عروبة، عن قتادة في قول الله: {ثم استوي علي العرش} [يونس: ] : قال: «يوم السابع»
 
    
 وحدث يزيد بن سنان، ثنا يزيد بن ابي حكيم، حدثني الحكم بن ابان، قال: سمعت عكرمة، يقول: «ان الله خلق السماوات والارض وما بينهما يوم الاحد، ثم استوي علي العرش يوم الجمعة في ثلاث ساعات، فخلق في ناحية منها الشموس كي يرغب الناس الي ربهم في الدعاء والمسالة، وخلق في ناحية النتن الذي يسقط علي ابن ادم اذا مات لكي يقبر»
 
  قوله تعالي: {علي العرش} 
 [الاعراف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، «وانما سمي العرش عرشا لارتفاعه»
 
    
 حدثنا حجاج بن حمزة، ثنا ابو اسامة، ثنا اسماعيل بن ابي خالد، قال: سمعت سعدا الطاءي يقول: «العرش ياقوتة حمراء»
 
    
 قرء علي بحر بن نصر الخولاني المصري ثنا اسد بن موسي، ثنا يوسف، عن ابي الياس ابن بنت وهب بن منبه، عن وهب بن منبه قال: ان الله خلق العرش من نور
 
  قوله تعالي: {يدبر الامر} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {يدبر الامر} [يونس: ] قال: يقبضه وحده
 
  قوله تعالي: {ما من شفيع الا من بعد اذنه} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا يحيي بن عبد الحميد الحماني، ثنا المذيل بن عمير الهمذاني، ثنا شريك، عن سالم، عن سعيد بن جبير قال: من يتكلم عنده الا باذنه
 
  قوله تعالي: {ذلكم الله ربكم فاعبدوه} 
 [يونس: ]
 
    
 حدثنا محمد بن يحيي، ثنا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال فيما اخبرني محمد بن ابي محمد، عن عكرمة، عن سعيد بن جبير، عن ابن عباس قال: «اعبدوا اي وحدوا»
 
  قوله تعالي: {افلا تذكرون} 
 [يونس: ]
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ قال: سمعت عبد الرحمن بن زيد بن اسلم في قوله: {افلا تذكرون} [يونس: ] قال: «اهل الذكر هم اهل القران»
 
  قوله تعالي: {اليه مرجعكم جميعا وعد الله حقا} 
 [يونس: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا زيد بن الحباب، عن ابي سنان، عن الضحاك في قوله: {اليه مرجعكم جميعا} [يونس: ] قال: «البر والفاجر»
 
  قوله تعالي: {انه يبدا الخلق ثم يعيده} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {انه يبدا الخلق ثم يعيده} [يونس: ] : «يحييه ثم يميته، ثم يحييه»
 
  قوله تعالي: {ليجزي الذين امنوا وعملوا الصالحات} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا احمد بن اسماعيل، ثنا اسماعيل بن ابي اويس، حدثني عبد الله بن نافع الصاءغ، عن عاصم بن عمر، عن زيد بن اسلم: " {الذين امنوا وعملوا الصالحات} [يونس: ] قال: رسول الله صلي الله عليه وسلم واصحابه رضي الله عنهم "
 
    
 حدثنا ابي، ثنا ابراهيم بن موسي، ثنا هشام بن يوسف، عن ابن جريج عن عطاء، عن ابن عباس قال: الاعمال الصالحات: سبحان الله والحمد لله ولا اله الا الله والله اكبر
 
  قوله تعالي: {بالقسط} 
 [ال عمران: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قوله: {بالقسط} [يونس: ] قال: " بالعدل وروي عن السدي، ومجاهد، وقتادة بمثل ذلك
 
  قوله: {والذين كفروا لهم شراب من حميم} 
 [يونس: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو نعيم، عن سفيان، عن منصور، عن ابراهيم، وابي رزين {حميم} [يونس: ] قالا: «ما يسيل من صديدهم»
 
  قوله تعالي: {وعذاب اليم} 
 [الانعام: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {وعذاب اليم} [يونس: ] قال: نكال موجع
 
  قوله تعالي: {اليم بما كانوا يكفرون} [الانعام: ]   حدثنا احمد بن عمر بن ابي عاصم، حدثنا ابو عمرو، ثنا شبيب بن بشير، انبا عكرمة، عن ابن عباس في قوله عز وجل: {عذاب اليم} [البقرة: ] قال: " اليم: كل شء موجع "
 
  قوله تعالي: {هو الذي جعل الشمس ضياء والقمر نورا وقدره منازل لتعلموا عدد السنين والحساب} 
 [يونس: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي قوله: {جعل الشمس ضياء والقمر نورا} [يونس: ] " فلم يجعل كهيءة القمر لكي يعرف الليل من النهار وهو قوله: {محونا اية الليل وجعلنا اية النهار مبصرة لتبتغوا فضلا من ربكم ولتعلموا عدد السنين والحساب} : في اختلافهما "
 
  قوله تعالي: {ما خلق الله ذلك الا بالحق يفصل} 
 [يونس: ]
 
    
 اخبرنا احمد بن عثمان بن حكيم، فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي قوله: " {يفصل الايات} [يونس: ] اما نفصل: نبين
 
  قوله تعالي: {وما خلق الله في السموات والارض}
 
    
 حدثنا ابي، ثنا يحيي بن عبد الحميد، ثنا يعقوب بن عبد الله، عن جعفر بن ابي المغيرة، عن سعيد بن جبير، عن ابن عباس قال: " اتت قريش اليه صلي الله عليه وسلم فقالوا: ادع لنا ربك يجعل لنا الصفا ذهبا، فدعا ربه فنزلت: {ان في خلق السموات والارض} {لايات لاولي الالباب} [ال عمران: ] فليتفكروا فيها "
 
  قوله تعالي: {لايات لقوم يتقون} 
 [يونس: ]
 
    
 حدثنا عصام بن رواد العسقلاني، ثنا ادم، ثنا ابو صفوان، ثنا القاسم بن يزيد بن عوانة، عن يحيي ابي النضر، عن جويبر، عن الضحاك في قوله: {يتقون} [يونس: ] قال: «يتقون النار بالصلوات الخمس»
 
  قوله تعالي: {ان الذين لا يرجون لقاءنا ورضوا بالحياة الدنيا} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: {ان الذين لا يرجون لقاءنا} [يونس: ] الي قوله: {عن اياتنا غافلون} [يونس: ] قال: «اذا اتيت رايته صاحب دنيا، لها يفرح، ولها يحزن، ولها يرضي، ولها يسخط»
 
  قوله تعالي: {واطمانوا بها} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، عن ورقاء، عن ابن ابي نجيح، عن مجاهد: " {واطمانوا بها} [يونس: ] مثل قوله: {من كان يريد الحياة الدنيا وزينتها نوف} [هود: ] اليهم اعمالهم فيها "
 
    
 حدثنا ابي، ثنا عبد الله بن ابي زياد القطواني، ثنا سيار بن حاتم العنزي، ثنا عبيد الله بن شميط، ثنا حوشب، عن الحسن في قوله: {ان الذين لا يرجون لقاءنا ورضوا بالحياة الدنيا واطمانوا بها} [يونس: ] فقال الحسن: «والله ما زينوها ولا رفعوها حتي رضوا بها»
 
  قوله تعالي: {والذين هم عن اياتنا غافلون} 
 [يونس: ]
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن يزيد بن اسلم، في قوله تعالي: {والذين هم عن اياتنا غافلون} [يونس: ] قال: " هءلاء هم اهل الكفر ثم قال: {اولءك ماواهم النار بما كانوا يكسبون} [يونس: ] "
 
  قوله تعالي: {اولءك ماواهم النار} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {يهديهم ربهم بايمانهم} [يونس: ] : «يكون لهم نور يمشون به»
 
    
 حدثنا ابي، ثنا هشام بن خالد الازرق، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة يعني: قوله: {ان الذين امنوا وعملوا الصالحات يهديهم ربهم بايمانهم} [يونس: ] ثنا الحسن ان رسول الله صلي الله عليه وسلم قال: " ان المءمن اذا خرج من قبره مثل له عمله في صورة حسنة وريح طيبة فيقول له: ما انت؟ فوالله اني لاراك عين امرء صدق، فيقول: انا عملك، فيكون له نورا قاءدا الي الجنة، واما الكافر اذا خرج من قبره مثل له عمله في صورة سيءة وريح منتنة، فيقول: ما انت؟ اني لاراك عين امرء سوء، فيقول: انا عملك فينطلق حتي يدخله النار "
 
  قوله تعالي: {تجري من تحتهم الانهار} 
 [الاعراف: ]
 
    
 حدثنا ابو بكر بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك قوله: {تجري من تحتهم الانهار} [الاعراف: ] يعني: «تحت منازلهم وارضهم»
 
  قوله تعالي: {في جنات النعيم} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا احمد بن ابي الحوادي، ثنا زيد بن الحباب، قال: سمعت ابا عبد الملك قال: قال رسول الله صلي الله عليه وسلم: «نعيم اهل الجنة برضوان الله عنهم افضل من نعيمهم بها في الجنان»
 
  قوله تعالي: {دعواهم فيها} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا عمرو بن رافع البجلي، ثنا سليمان بن عامر، عن الربيع
  [ص: ]
 بن انس قال: اهل الجنة اذا اشتهوا شيءا قالوا: سبحانك اللهم وبحمدك فاذا هو عندهم فذلك قوله: {دعواهم فيها سبحانك اللهم} [يونس: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: {دعواهم فيها سبحانك اللهم} [يونس: ] يقول: «ذلك قولهم فيها وتحيتهم فيها سلام»
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا معتمر بن سليمان قال: سمعت شبيب بن عبد الملك يحدث ان مقاتل بن حيان قال: ان اهل الجنة اذا دعوا بالطعام قالوا: سبحانك اللهم قال: فيقوم علي احدهم عشرة الاف خادم مع كل خادم صحفة من ذهب فيها طعام ليس في الاخري قال: فياكل منهن اكلهن
 
    
 حدثنا ابي، ثنا يعقوب بن ابراهيم الروزقي، ثنا الاشجعي، عن سفيان في قول الله عز وجل: {دعواهم فيها سبحانك اللهم} [يونس: ] قال: اذا اراد الرجل من اهل الجنة ان يدعوا قال: سبحانك اللهم فياتيه الذي دعا به
 
  قوله تعالي: {سبحانك اللهم} 
 [يونس: ]
 
    
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا زيد بن الحباب، ثنا ابو الاشهب، عن الحسن قال: «سبحان الله اسم لا يستطيع الناس ان ينتحلوه»
 
  الوجه الثاني
 
    
 حدثنا ابي، ثنا ابن نفيل، ثنا النضر بن عربي قال: سال رجل ميمون بن عثمان عن سبحان الله فقال: اسم يعظم الله به، ونجانا به من السوء
 
  قوله تعالي: {وتحيتهم فيها سلام} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا محمد بن سعيد الخزامي، ثنا محمد بن مروان العقيلي،، عن الفضل الرقاشي فقال: {وتحيتهم فيها سلام واخر دعواهم ان الحمد لله رب العالمين} [يونس: ] قال: " فيتجلي لهم فيخرون له سجدا ويقولون سبحانك اللهم، وتحيتهم بالسلام، فاذا انصرف عنهم قالوا: الحمد لله رب العالمين "
 
  قوله تعالي: {واخر دعواهم} 
 [يونس: ]
 
    
 ذكر عن ابن ابي عمر، ثنا سفيان، عن ابي سنان، عن ابن ابي المذيل قال: الحمد لله اوله واخره، ثم تلا سفيان واخر دعواهم ان الحمد لله رب العالمين
 
    
 حدثنا ابي، ثنا ابو معمر المقرء، ثنا عبد الوارث، ثنا علي بن زيد بن جدعان، عن يوسف بن مهران، قال: قال ابن عباس: " الحمد لله كلمة الشكر، فاذا قال العبد: الحمد لله، قال: شكرني عبدي "
 
  الوجه الثاني
 
    
 حدثنا ابي، ثنا موسي بن اسماعيل، ثنا وهيب، ثنا سهيل بن ابي صالح، عن ابيه، عن السلولي، عن كعب قال: الحمد لله: ثناء الله
 
  الوجه الثالث
 
    
 حدثنا ابي، ثنا محمد بن عبد الرحمن العرزمي، ثنا بزيع ابو خازم، عن يحيي بن عبد الرحمن يعني ابا بسطام، عن الضحاك قال: الحمد رداء الرحمن
 
  الوجه الرابع
 
    
 حدثنا ابي، ثنا ابو معمر القطيعي، ثنا حفص، عن حجاج، عن ابن ابي مليكة، عن ابن عباس، قال: قال عمر: قد علمنا سبحان الله، فما الحمد لله؟ قال علي: «كلمة رضي الله لنفسه» قال: ابو محمد، رواه ابو معمر القطيعي عن حفص وحدث به الاشج فقال حفص وخالفه فيه فقال فيه: قال عمر لعلي واصحابه عنده، لا اله الا الله، والحمد لله، والله اكبر، قد عرفناها فما سبحان الله؟ فقال علي: كلمة احبها الله لنفسه ورضيها لنفسه واحب ان تقال
 
  قوله تعالي: {رب العالمين} 
 [الفاتحة: ]
 
    
 حدثنا ابي، ثنا هشام، ثنا خالد بن الوليد بن مسلم، ثنا الفرات بن الوليد، عن مغيث بن شمس، عن تبيع، في قوله عز وجل: {رب العالمين} [يونس: ] قال: " العالمين: الف امة، فستماءة في البحر واربعماءة في البر "
 
    
 حدثنا علي بن حرب الموصلي، ثنا زيد بن الحباب، عن حسين بن واقد، عن مطر الوراق، عن قتادة في قول الله: {رب العالمين} [يونس: ] قال: ما وصف من خلقه
 
  الوجه الثاني
 
    
 حدثنا ابو غسان مالك بن اسماعيل، ثنا قيس، عن عطاء بن الساءب، عن سعيد بن جبير، عن ابن عباس قوله: {رب العالمين} [يونس: ] قال: " الجن والانس وروي عن علي باسناد لا يعتمد عليه مثله، وروي عن مجاهد مثله
 
  قوله تعالي: {ولو يعجل الله للناس الشر} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: {ولو يعجل الله للناس الشر استعجالهم بالخير} [يونس: ] " قول الانسان لولده وماله، اذا غضب عليه: اللهم لا تبارك فيه والعنه "
 
    
 حدثنا ابي، ثنا محمد بن الاعلي الصنعاني، ثنا محمد بن ثور، عن معمر، عن قتادة {ولو يعجل الله للناس الشر استعجالهم بالخير} [يونس: ] قال: «هو دعاء الرجل علي نفسه، وماله بما يكره ان يستجاب له»
 
  قوله تعالي: {استعجالهم بالخير} 
 [يونس: ]
 
    
 ذكر عن معاوية بن هشام، عن شريك، عن سالم، عن سعيد، في قوله: {ولو يعجل الله للناس الشر استعجالهم بالخير} [يونس: ] قال: " هو الرجل يدعو علي نفسه: اللهم اخزه اللهم افعل به كذا وكذا فلو عجل الله لهم ذلك كما يعجل الله لهم: اللهم ارزقني لقضي اليهم الاجل "
 
  قوله تعالي: {لقضي اليهم اجلهم} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {لقضي اليهم اجلهم} [يونس: ] «لاهلك من دعا عليه ولاماته»
 
  قوله تعالي: {فنذر الذين لا يرجون لقاءنا} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة {الذين لا يرجون لقاءنا} [يونس: ] «مشركي اهل مكة»
 
  قوله تعالي: {في طغيانهم يعمهون} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع بن انس، عن ابي العالية، {في طغيانهم} [يونس: ] يعني: في ضلالهم وقد تقدم القول فيه
 
  قوله تعالي: {واذا مس الانسان الضر دعانا لجنبه} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة قال: {واذا مس الانسان الضر} [يونس: ] : «خلصوا لله الدعاء»
 
  قوله تعالي: {فلما كشفنا عنه ضره مر كان لم يدعنا الي ضر مسه} [يونس: ] الي قوله: {كذلك زين للمسرفين} [يونس: ] بياض
 
  قوله تعالي: {كذلك زين للمسرفين} 
 [يونس: ]
 
    
 حدثنا الحسن بن احمد، ثنا موسي بن مسلم، ثنا ابو بكر الحنفي، ثنا عباد بن منصور، قال: سالت الحسن عن قوله: {زين} [يونس: ] قال: زين لهم الشيطان
 
  قوله تعالي: {ولقد اهلكنا القرون من قبلكم لما ظلموا} 
 [يونس: ]
 
    
 اخبرنا يونس بن عبد الاعلي قراءة، انبا ابن وهب، ثنا ابن زيد يعني عبد الرحمن قال: «ما عذب قوم نوح حتي ما كان في الارض سهل ولا جبل الا وله عامر يعمره وحايز يحوزه»
 
    
 اخبرنا يونس بن عبد الاعلي، قراءة انبا ابن وهب، حدثني مالك بن انس، عن زيد بن اسلم، " ان اهل السهل كان قد ضاق بهم، واهل الجبل، حتي ما يقدر اهل السهل ان يرتقوا الي الجبل، ولا اهل الجبل ان ينزلوا الي اهل السهل في زمان نوح، قال: حشوا "
 
  قوله تعالي: {وجاءتهم رسلهم بالبينات} 
 [يونس: ]
 
    
 قرات علي محمد بن الفضل بن موسي، ثنا محمد بن علي، ثنا محمد بن مزاحم، ثنا بكير بن معروف، عن مقاتل بن حيان، قوله: {بالبينات} [يونس: ] يعني: بالبينات ما انزل الله من الحلال والحرام
 
  قوله تعالي: {وما كانوا ليءمنوا كذلك} 
 [يونس: ]
 
    
 حدثنا ابو بكر بن موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، ثنا اسباط، عن السدي، عن ابي مالك " قوله: {كذلك} [يونس: ] يعني: هكذا "
 
  قوله تعالي: {ثم جعلناكم خلاءف في الارض} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا ابو سلمة، ثنا حماد، ثنا ثابت البناني، عن عبد الرحمن بن ابي ليلي قال: قال عمر يقول الله تعالي: {ثم جعلناكم خلاءف في الارض من بعدهم لننظر كيف تعملون} [يونس: ] قال: «فقد استخلفت يا ابن ام عمر فانظر كيف تعمل؟»
 
  قوله تعالي: {لننظر كيف تعملون} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا خليد، وسعيد، عن قتادة في قول الله: {ثم جعلناكم خلاءف في الارض من بعدهم لننظر كيف تعملون} [يونس: ] " ذكر لنا ان عمر بن الخطاب قرا هذه الاية فقال: صدق ربنا ما جعلنا خلاءف الارض الا لينظر الي اعمالنا، فادوا الله خير اعمالكم بالليل والنهار، والسر والعلانية "
 
  قوله تعالي: {واذا تتلي عليهم اياتنا بينات قال الذين لا يرجون لقاءنا} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، {واذا تتلي عليهم اياتنا بينات} [يونس: ] الي قوله: {من تلقاء نفسي} [يونس: ] «هذا قول مشركي مكة لنبي الله صلي الله عليه وسلم»
 
  قوله تعالي: {قل ما يكون لي ان ابدله من تلقاء نفسي} 
 [يونس: ]
 
    
 قرات علي محمد بن الفضل ثنا محمد بن علي، ثنا محمد بن مزاحم، ثنا بكير بن معروف، عن مقاتل بن حيان قوله: " {عذاب يوم عظيم} [يونس: ] يعني: عذابا "
 
  قوله تعالي: {قل لو شاء الله ما تلوته عليكم} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة قال: " ثم قال الله تعالي لنبيه صلي الله عليه وسلم: {لو شاء الله ما تلوته عليكم ولا ادراكم به} [يونس: ] "
 
  قوله تعالي: {ولا ادراكم به} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {ولا ادراكم به} [يونس: ] يقول: «اعلمكم به»
 
  الوجه الثاني
 
    
 حدثنا ابي ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة {ولا ادراكم به} [يونس: ] : «اشعركم»
 
  الوجه الثالث
 
    
 ذكر ابي، عن مالك بن اسماعيل، ثنا خالد بن عبد الله، عن حنظلة، عن شهر بن حوشب، قال: {لو شاء الله ما تلوته عليكم ولا ادراكم به} [يونس: ] يعني: «ولا انذركم به»
 
  قوله تعالي: {فقد لبثت فيكم عمرا من قبله افلا تعقلون} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة قوله: {فقد لبثت فيكم عمرا من قبله افلا تعقلون} [يونس: ] قال: «لبث اربعين سنة ضالا وراي رءيا النبوة سنتين واوحي اليه عشر سنين بمكة وعشر سنين بالمدينة وتوفي وهو ابن اثنتين وستين سنة صلي الله عليه وسلم»
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي قوله: {لبثت فيكم عمرا من قبله} [يونس: ] قال: «لم اتلوا عليكم، ولم اذكره افلا تعقلون»
 
  قوله تعالي: {فمن اظلم ممن افتري علي الله كذبا} 
 [الانعام: ]
 
    
 حدثنا ابو عبد الله بن محمد بن حماد الطهراني، انبا حفص بن عمر العدني، ثنا الحكم بن ابان، عن عكرمة، قال: " قال النضر وهو من بني عبد الدار: واذا كان يوم القيامة شفعت لي اللات والعزي فانزل الله عز وجل: {فمن اظلم ممن افتري علي الله كذبا او كذب باياته انه لا يفلح المجرمون} [يونس: ] "
 
  الوجه الثاني
 
    
 حدثنا ابي، ثنا ابن نفيل الحراني، ثنا مسكين بن بكير، عن معاذ بن رفاعة، قال: سمعت ابا خلف الاعمي قال: " كان ابن ابي سرح يكتب للنبي صلي الله عليه وسلم الوحي فاتي اهل مكة فقالوا: يا ابن ابي سرح كيف كتبت لابن ابي كبشة القران؟ قال: كنت اكتب كيف شءت، فانزل الله تعالي: {ومن اظلم ممن افتري علي الله كذبا او كذب باياته انه لا يفلح الظالمون} [الانعام: ] "
 
  قوله تعالي: {ويعبدون من دون الله} [يونس: ] الاية
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قال: الاوثان
 
  قوله تعالي: {ويقولون هءلاء شفعاءنا عند الله} 
 [يونس: ]
 
    
 حدثنا محمد بن حماد الطهراني، ثنا حفص بن عمر العدني، ثنا الحكم بن ابان، عن عكرمة، قال: " قال النضر بن الحارث اذا كان يوم القيامة شفعت لي اللات والعزي قال: فانزل الله: {ويقولون هءلاء شفعاءنا عند الله} [يونس: ] "
 
  قوله تعالي: {قل اتنبءون الله بما لا يعلم في السموات ولا في الارض}
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: {قل اتنبءون الله بما لا يعلم في السموات ولا في الارض} : «ان له شريكا ام بظاهر من القول تقولونه ام تجدونه في القران ان له شريكا»
 
  قوله: {سبحانه وتعالي عما يشركون} 
 [يونس: ]
 
    
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، انبا ابن عيينة، قال: سمعت صدقة يحدث عن السدي: {وتعالي عما يشركون} [يونس: ] يقول: «عما اشرك المشركون»
 
    
 حدثنا الحسين بن الحسن، ثنا ابراهيم بن عبد الله الهروي، ثنا حجاج، عن ابن جريج، عن مجاهد {وتعالي عما يشركون} [يونس: ] قال: " هو الانكاف، انكف نفسه يقول: عظم نفسه، وانكفته الملاءكة وما سبح له "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن ابي حماد، ثنا مهران، عن سفيان، عن السدي، عن ابي مالك: {وتعالي عما يشركون} [يونس: ] قال: هذه لقوم محمد صلي الله عليه وسلم
 
  قوله تعالي: {وما كان الناس الا امة واحدة} 
 [يونس: ]
 
    
 حدثنا محمد بن عبد الرحمن، ثنا ابو داود الحفري، عن سفيان، عن ابن ابي نجيح، عن مجاهد كان الناس امة قال ادم: وروي عن الثوري نحو ذلك قد تقدم القول في الامة في سورة البقرة
 
  قوله تعالي: {فاختلفوا} 
 [يونس: ]
 
    
 حدثنا عصام بن رواد العسقلاني، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية، عن ابي بن كعب في قول الله: {فاختلفوا} [يونس: ] قال: اختلفوا من بعد ادم
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {وما كان الناس الا امة واحدة فاختلفوا} [يونس: ] : حين قتل احد ابني ادم اخاه
 
    
 حدثنا محمد بن يحيي، ثنا الحسن بن عمرو السابري، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة: فاختلفوا فيه قال: «ذكر لنا انه كان بين ادم ونوح عشرة قرون، كلهم علي الهدي، وعلي شريعة من الحق، ثم اختلفوا بعد ذلك فبعث الله نوحا وكان اول رسول ارسله الله الي اهل الارض، وبعث عند الاختلاف من الناس وترك الحق، فبعث الله رسله وانزل كتابه ليحتج به علي خلقه»
 
  قوله تعالي: {ولولا كلمة سبقت من ربك} [يونس: ] الاية
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي قوله: {ولولا كلمة سبقت من ربك لقضي بينهم} [يونس: ] يقول: «كان الناس اهل دين واحد، علي دين ادم فكفروا فلولا ان ربك اجلهم الي يوم القيامة لقضي بينهم»
 
  قوله تعالي: {لولا انزل عليه اية من ربه} [يونس: ] الاية
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن الدشتكي، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع، في قوله: {فانتظروا اني معكم من المنتظرين} [الاعراف: ] قال: «خوفهم عذابه وعقوبته ونقمته»
 
  قوله تعالي: {واذا اذقنا الناس رحمة} 
 [يونس: ]
 
    
 ذكر عن مسلم بن ابراهيم، ثنا مستور بن عباد، قال: سالت الحسن: {واذا اذقنا الناس رحمة من بعد ضراء مستهم} [يونس: ] قال: «ذاك المنافق»
 
  قوله تعالي: {اذا لهم مكر في اياتنا} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، {اذا لهم مكر في اياتنا} [يونس: ] قال: «استهزاء وتكذيب»
 
    
 حدثنا علي بن الحسين، ثنا زياد بن ايوب، ثنا ابو عاصم، عن مستور، قال: سءل الحسن عن هذه الاية: {اذا لهم مكر في اياتنا} [يونس: ] : «منافق والله»
 
  قوله تعالي: {قل الله اسرع مكرا} [يونس: ] الاية
 
    
 حدثنا ابي، ثنا ابن ابي عمر، ثنا سفيان قال: «كل مكر في القران فهو عمل»
 
  قوله تعالي: {هو الذي يسيركم في البر والبحر} 
 [يونس: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو بكير، عن جويبر، عن الضحاك قوله: {في البر والبحر} [يونس: ] قال: «البر بادية الاعراب، والبحر الامصر والقري»
 
  قوله تعالي: {حتي اذا كنتم في الفلك وجرين بهم بريح طيبة} 
 [يونس: ]
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم قال: وقرا {حتي اذا كنتم في الفلك وجرين بهم بريح طيبة} [يونس: ] قال: " وذكر هذا ثم عد الحدث في حديث اخر عنه تغيرهم قال: {وجرين بهم} [يونس: ] ، قال: فعد الحديث عنهم فاول شء كنتم في الفلك، وجرين بهءلاء لا يستطيع يقول: جرين بكم وهو يحدث قوما اخرين، ثم ذكر هذا لتجمعهم وغيرهم، وجرين بهم هءلاء وغيرهم من الخلق بريح طيبة فقرا حتي بلغ مخلصين له الدين "
 
  قوله تعالي: {جاءتها ريح عاصف} 
 [يونس: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا يعلي، عن اسماعيل بن ابي خالد، عن عبد الله بن شداد بن المناد، قال: «الريح من روح الله فاذا رايتموها فاسالوا الله من خيرها وتعوذوا بالله من شرها»
 
  قوله تعالي: {وظنوا انهم احيط بهم} 
 [يونس: ]
 
    
 حدثنا ابو سعيد الاشج، حدثني عقبة، عن اسراءيل، عن جابر، عن مجاهد قال: «ما كان من ظن في القران فهو يقين»
 
  قوله تعالي: {دعوا الله مخلصين له الدين} 
 [يونس: ]
 
    
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، ثنا سفيان، عن الاعمش، عن عمرو بن مرة، عن ابي عبيدة: في قوله: {مخلصين له الدين} [يونس: ] قال: " هنا شراها تفسيره: يا حي يا قيوم "
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي الصنعاني، ثنا محمد بن ثور، عن معمر، عن قتادة {دعوا الله مخلصين له الدين} [يونس: ] : قال: «اذا مسهم الضر في البحر اخلصوا لله الدعاء»
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن اسماعيل بن ابي خالد، عن سعيد بن جبير: {مخلصين له الدين} [يونس: ] قال: " اذا قلت لا اله الا الله فقل علي اثرها: الحمد لله رب العالمين "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو خالد، عن ابن عجلان، عن عباس بن عبد الله بن معبد، عن عكرمة، عن ابن عباس قال: «الاخلاص هكذا واشار ابو خالد باصبعه السبابة»
 
  قوله تعالي: {لءن انجيتنا من هذه لنكونن من الشاكرين} 
 [يونس: ]
 
    
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني ابي، حدثني عمي، عن ابيه، عن عطية، عن ابن عباس قال: " اذا ضل الرجل الطريق دعا الله مخلصا {لءن انجيتنا من هذه لنكونن من الشاكرين} [يونس: ] "
 
  قوله تعالي: {فلما انجاهم اذا هم يبغون في الارض بغير الحق} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: " {يبغون} [يونس: ] قال: يلعبون "
 
  قوله تعالي: {يا ايها الناس} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي ثنا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس: {يا ايها الناس} [يونس: ] اي: «الفريقين جميعا الكفار والمنافقين»
 
  قوله تعالي: {انما بغيكم علي انفسكم} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا ابراهيم بن المنذر، حدثني كثير بن جعفر بن ابي كثير، حدثني زيد بن اسلم، ان النبي صلي الله عليه وسلم قال: " لا يءخر الله عقوبة البغي فان الله قال: انما بغيكم علي انفسكم "
 
    
 حدثني ابي، ثنا عبدة بن سليمان، ثنا ابن المبارك، ثنا يونس، عن الزهري، قال: بلغنا ان رسول الله صلي الله عليه وسلم قال: " لا تبغ ولا تعن باغيا فان الله يقول: {يا ايها الناس انما بغيكم علي انفسكم} [يونس: ] "
 
  قوله تعالي: {متاع الحياة الدنيا} 
 [ال عمران: ]
 
    
 حدثنا ابي، ثنا قبيصة، ثنا سفيان، عن الاعمش: {متاع الحياة الدنيا} [ال عمران: ] قال: «مثل زاد الراعي»
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا عمرو بن حمران، عن سعيد، عن قتادة: متاع الحياة الدنيا قال: «هي متاع متروكة اوشكت والله الذي لا اله الا هو ان تضمحل عن اهلها، فخذوا من هذا المتاع طاعة الله ان استطعتم ولا قوة الا بالله»
 
  قوله تعالي: {ثم الينا مرجعكم} 
 [يونس: ]
 
    
 حدثنا عصام بن الرواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية قال: «يرجعون اليه بعد الحياة»
 
  قوله تعالي: {فننبءكم بما كنتم تعملون} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن الدشتكي، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع بن انس، قال: «يبعثهم الله من بعد الموت فيبعث اولياءه واعداءه فينبءهم باعمالهم»
 
  قوله تعالي: {انما مثل الحياة الدنيا كماء انزلناه من السماء} 
 [يونس: ]
 
    
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني ابي، حدثني عمي، عن ابيه، عن جده، عن ابن عباس قال «ضرب الله مثلا حسنا وكل امثاله حسن، وهو مثل خص به الله المءمن والكافر فيما اوتيا»
 
    
 حدثنا ابي، ثنا سليمان بن حرب، ثنا حماد بن زيد، عن عبد الجليل، عن شهر بن حوشب، ان ابا هريرة قال: «ما نزل قطر الا بميزان»
 
    
 حدثنا ابي، ثنا محمود بن غيلان، ثنا علي بن الحسين بن شقيق، ثنا الحسين بن واقد، ثنا علباء بن احمر، عن عكرمة قال: «ينزل الله الماء من السماء السابعة، فتسع القطرة منه علي السحابة مثل البعير»
 
  قوله تعالي: {فاختلط به نبات الارض} 
 [يونس: ]
 
    
 اخبرنا العباس بن الوليد بن مزيد البيروتي، قراءة اخبرني محمد بن شعيب، اخبرني عثمان بن عطاء، عن ابيه قال: «اما اختلط به نبات الارض، فاختلط فنبت بالماء من كل لون»
 
  قوله تعالي: {مما ياكل الناس والانعام} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي: {الانعام} [النساء: ] قال: " والانعام: الراعية "
 
  قوله تعالي: {حتي اذا اخذت الارض زخرفها} 
 [يونس: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا احمد بن بشير، ثنا شعبة، عن الحكم، عن مجاهد قال: " ما كنت ادري ما الزخرف حتي قرات قراءة عبد الله: «او يكون لك بيت من ذهب»
 
  قوله تعالي: {وازينت} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي الصنعاني، ثنا محمد بن ثور، عن معمر، عن قتادة، {وازينت} [يونس: ] قال: «انبتت وحسنت»
 
  قوله تعالي: {وظن اهلها انهم قادرون} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة: {وظن اهلها انهم قادرون عليها اتاها امرنا ليلا او نهارا} [يونس: ] اي: «والله لمن تشبث بالدنيا، وحدب عليها لتوشك الدنيا ان تلفظه وان تنقص منه وتفارقه اعجب ما تكون اليه»
 
  قوله تعالي: {كان لم تغن بالامس} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة: {كان لم تغن بالامس} [يونس: ] قال: «كان لم تنعم بالامس»
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر، عن اسباط، عن السدي: {كان لم تغن بالامس} [يونس: ] بزينتها "
 
  قوله تعالي: {كذلك نفصل الايات} 
 [الاعراف: ]
 
    
 اخبرنا احمد بن عثمان، فيما كتب الي، احمد بن مفضل، ثنا اسباط، عن السدي: " {كذلك نفصل} [يونس: ] اما نفصل: فنبين "
 
  قوله تعالي: {لقوم يتفكرون} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا ابو صالح كاتب الليث، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {يتفكرون} [يونس: ] يعني: «في زوال الدنيا وفناءها واقبال الاخرة وبقاءها»
 
    
 حدثنا ابي، قال علي بن محمد الطنافسي، ثنا ابو اسامة، عن الصعق التميمي، قال: شهدت الحسن وقرا هذه الاية: {يتفكرون} [يونس: ] قال: «هو والله لمن تفكر فيها يعلم ان الدنيا دار بلاء ثم دار فناء، وليعلم ان دار الاخرة دار جزاء ثم دار بقاء»
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا عمرو بن حمران، ثنا سعيد بن ابي عروبة، عن قتادة، {لقوم يتفكرون} [يونس: ] قال: " هذا مثل خص به الله فاعقلوا عن الله امثاله، فان الله يقول: {وتلك الامثال نضربها للناس وما يعقلها الا العالمون} [العنكبوت: ] "
 
  الوجه الثاني
 
    
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، عن الثوري، قال: قال مجاهد: " {يتفكرون} [يونس: ] يطيعون "
 
  قوله تعالي: {والله يدعو الي دار السلام} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا الحسين بن سلمة بن ابي كبشة، ثنا عبد الملك بن عمرو، ثنا عباد بن راشد، عن قتادة، حدثني خليد بن عبد الله العصري، عن ابي
  [ص: ]
 الدرداء قال: قال رسول الله صلي الله عليه وسلم: " والذي نفس محمد بيده، ما من يوم طلعت فيه شمسه الا وتجليتها ملكان يناديان يسمعه خلق الله كلهم الا الثقلين: يا ايها الناس، هلموا الي ربكم {والله يدعو الي دار السلام ويهدي من يشاء الي صراط مستقيم "} [يونس: ]
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا يحيي بن ابان، عن عمار بن عمير، عن الحسن، قال: " ما من ليلة الا ينادي مناد: يا صاحب الخير هلم ويا صاحب الشر اقصر، فقال رجل للحسن: اتجدها في كتاب الله قال: نعم {والله يدعو الي دار السلام} [يونس: ] "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة: {والله يدعو الي دار السلام ويهدي من يشاء الي صراط مستقيم} [يونس: ] قال: «ذكر لنا ان في التوراة مكتوبا يا باغي الخير هلم ويا باغي الشر انته»
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي الصنعاني، ثنا محمد بن ثور، عن معمر قال: وقال قتادة: " {والله يدعو الي دار السلام} [يونس: ] فداره الجنة "
 
  قوله تعالي: {السلام} 
 [النساء: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو تميلة، عن ابي المنيب، عن ابي الشعثاء، في قوله: {دار السلام} [الانعام: ] قال: «هو السلام وهو اسم من اسماءه عز وجل» وروي عن قتادة، والسدي انهما قالا: السلام هو الله تبارك وتعالي
 
  قوله تعالي: {ويهدي من يشاء} 
 [يونس: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية: في قول الله: {ويهدي من يشاء الي صراط مستقيم} [يونس: ] يقول: «يهديهم للمخرج من الشبهات والضلالات والفتن»
 
  قوله تعالي: {صراط مستقيم} [البقرة: ] قد تقدم تفسير الصراط المستقيم غير مرة
 
    
 حدثنا يحيي بن عبدك، ثنا خالد بن عبد الرحمن المخزومي، ثنا عمر بن ذر، عن مجاهد: في قوله: " {صراط مستقيم} [البقرة: ] قال: الحق
 
  قوله تعالي: {للذين احسنوا} 
 [ال عمران: ]
 
    
 حدثنا ابي، ثنا محمد بن المصفي، ثنا سويد بن عبد العزيز، ثنا زهير بن محمد، عمن سمع ابا العالية، عن ابي بن كعب، قال: سالت رسول الله صلي الله عليه وسلم عن قول الله: {للذين احسنوا} [يونس: ] قال: «اهل التوحيد»
 
  الوجه الثاني
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {للذين احسنوا} [ال عمران: ] قال: «الذين شهدوا ان لا اله الا الله» وروي عن سعيد بن المسيب، وعكرمة مثل ذلك
 
  الوجه الثالث
 
    
 حدثنا ابي، ثنا الحارث بن مسكين، ثنا ابراهيم بن ابي مليح، عن داود بن ابي زنبر، عن مالك بن انس، عن يحيي بن سعيد، عن سعيد بن المسيب في قول الله تعالي: {للذين احسنوا} [يونس: ] قال: «احسنوا عبادة ربهم»
 
  قوله تعالي: {الحسني} 
 [النساء: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان بن صالح الدمشقي، ثنا الوليد بن مسلم، ثنا زهير بن محمد، حدثني من سمع ابا العالية الرياحي، يحدث عن ابي بن كعب: سالت رسول الله صلي الله عليه وسلم عن الزيادتين في كتاب الله {للذين احسنوا الحسني} [يونس: ] قال: " الحسني: الجنة " وروي عن ابي موسي الاشعري، وسعيد بن المسيب، وعبد الرحمن بن ابي ليلي، والحسن، وقتادة، والضحاك وعكرمة مثل ذلك
 
  والوجه الثاني
 
    
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {للذين احسنوا الحسني} [يونس: ] قال: «الحسني مثلها»
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم في قول الله: {للذين احسنوا الحسني} [يونس: ] قال: " الحسني: الجنة "
 
  الوجه الثالث
 
    
 حدثنا ابي، ثنا يحيي بن المغيرة، انبا جرير، عن ليث، عن ابن سابط، في قوله: {للذين احسنوا الحسني} [يونس: ] قال: " الحسني: النضرة "
 
  قوله تعالي: {وزيادة} 
 [يونس: ]
 
    
 حدثنا الحسن بن عرفة العبدي، ثنا يزيد بن هارون، ثنا حماد بن سلمة، عن ثابت البناني، عن عبد الرحمن بن ابي ليلي، عن صهيب رضي الله عنه قال: قال رسول الله صلي الله عليه وسلم: " اذا دخل اهل الجنة الجنة نودوا يا اهل الجنة ان لكم عند الله موعودا لم تروه قال: فيقولون: وما هو؟ الم يبيض وجوهنا ويزحزحنا عن النار، ويدخلنا الجنة قال: فيكشف الحجاب، فينظرون اليه تبارك وتعالي، فوالله ما اعطاهم الله شيءا هو احب اليهم منه، ثم قرا {للذين احسنوا الحسني وزيادة} [يونس: ] "
 
    
 حدثنا ابي، ثنا مسلم بن ابراهيم، ثنا ابو بكر الهذلي، ثنا ابو تميمة، قال: سمعت ابا موسي الاشعري يخطب فتلا هذه الاية: {للذين احسنوا الحسني وزيادة} [يونس: ] قال: " الحسني الجنة والزيادة النظر واذا ادخلوا الجنة فنظروا الي الخلل، فسالوا الله الزيادة فيقول: لكم عندي الزيادة النظر الي وجهي " قال ابو محمد وروي عن ابي بكر الصديق رضي الله عنه وحذيفة بن اليمان وابن عباس وعبد الرحمن بن ابي ليلي وعبد الرحمن بن سابط وعكرمة وعامر بن سعيد والحسن ومجاهد وقتادة وابي اسحاق والضحاك وابي سنان والسدي: ان الزيادة النظر الي وجه الله عز وجل
 
  الوجه الثاني
 
    
 حدثنا كثير بن شهاب، ثنا محمد بن سعيد بن سابق، ثنا عمرو بن ابي قيس، عن منصور، عن الحكم، عن علي بن ابي طالب: في قول الله: {للذين احسنوا الحسني وزيادة} [يونس: ] قال: «فالزيادة غرفة لءلء فيها اربعة ابواب»
 
  الوجه الثالث
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد في قوله: {للذين احسنوا الحسني} [يونس: ] قال: الحسني: «مثلها وزيادة مغفرة ورضوان»
 
  الوجه الرابع
 
    
 حدثنا ابو شيبة بن ابي بكر بن ابي شيبة، ثنا عبيد بن يعيش، ثنا محمد بن الصلت،، عن قيس، عن الاعمش، عن ابي ظبيان، عن علقمة بن قيس: في قوله: {وزيادة} [يونس: ] قال: " الزيادة: العشر من جاء بالحسنة فله عشر امثالها "
 
  الوجه الخامس
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم في قول الله: {للذين احسنوا الحسني وزيادة} [يونس: ] قال: " الزيادة: ما اعطاهم الله في الدنيا لا يحاسبهم به يوم القيامة "
 
  قوله تعالي: {ولا يرهق وجوههم قتر} 
 [يونس: ]
 
    
 حدثنا علي بن الحسين، ثنا ابراهيم بن سعيد الجوهري، ثنا حجاج، ثنا ابن جريج، عن عطاء الخراساني، عن ابن عباس: {ولا يرهق وجوههم قتر} [يونس: ] قال: «سواد الوجه» وروي عن السدي نحو ذلك
 
  الوجه الثاني
 
    
 حدثنا ابي امية بن بسطام الازدي، ثنا يزيد بن زريع، عن روح بن القسم، عن ابن ابي نجيح، عن مجاهد قوله: " {قترة} [عبس: ] قال: خزي "
 
  قوله تعالي: {ولا ذلة} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا احمد بن عبدة، ثنا حماد بن زيد، ثنا ثابت، عن عبد الرحمن بن ابي ليلي، انه تلا هذه الاية: {ولا يرهق وجوههم قتر ولا ذلة} [يونس: ] «بعد نظرهم الي ربهم تبارك وتعالي»
 
  قوله تعالي: {اولءك اصحاب الجنة هم فيها خالدون} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي انبا ابو غسان، ثنا سلمة قال: قال محمد بن اسحاق، حدثني محمد بن ابي محمد، عن سعيد بن جبير او عكرمة، عن ابن عباس: {اولءك اصحاب الجنة هم فيها خالدون} [البقرة: ] «اي من امن بما كفرتم وعمل بما نزله من دينه، فلهم الجنة خالدين، فيها يخبرهم ان الثواب بالخير والشر مقيم علي اهله ابدا لا انقطاع له»
 
  قوله تعالي: {والذين كسبوا السيءات} [يونس: ] الاية
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: قوله: " {سيءة} [يونس: ] قال: الشر "
 
  قوله تعالي: {وترهقهم} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {ما لهم من الله من عاصم} [يونس: ] : «من شافع»
 
  قوله تعالي: {كانما اغشيت وجوههم قطعا من الليل مظلما} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة: {كانما اغشيت وجوههم قطعا من الليل مظلما} [يونس: ] قال: «ظلمة من الليل»
 
  قوله تعالي: {اولءك اصحاب النار} 
 [البقرة: ]
 
    
 حدثنا ابو بكر بن ابي موسي، عن هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، ثنا اسباط، عن السدي، عن ابي مالك، قوله: {اولءك اصحاب النار} [البقرة: ] «فهم اصحاب النار يعذبون فيها»
 
  قوله تعالي: {هم فيها خالدون} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، ثنا ابو غسان، ثنا سلمة، قال محمد بن اسحاق، حدثني محمد بن ابي محمد، عن سعيد بن جبير او عكرمة، عن ابن عباس قوله: {هم فيها خالدون} [يونس: ] اي: «خالدا ابدا»
 
  قوله تعالي: {ويوم نحشرهم} 
 [الانعام: ]
 
    
 حدثنا عمرو بن عبد الله الاودي، ثنا وكيع، عن الاعمش، قال: سمعتهم يذكرون عن مجاهد: ويوم نحشرهم قال: " الحشر: الموت "
 
  قوله تعالي: {جميعا} 
 [البقرة: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن نمير، عن حنظلة القاص، عن الضحاك، عن ابن عباس قال: «يحشر كل شء حتي ان الذباب يحشر»
 
    
 حدثنا ابو سعيد الاشج، ثنا زيد بن الحباب، عن ابي سنان، عن الضحاك، في قوله: {جميعا} [البقرة: ] قال: «البر والفاجر»
 
  قوله تعالي: {ثم نقول للذين اشركوا مكانكم انتم وشركاءكم} 
 [يونس: ]
 
    
 حدثنا محمد بن يحيي، ثنا العباس بن الوليد، ثنا يزيد بن زريع، عن سعيد، عن قتادة: قال: «ما لله من شريك في السماء ولا في الارض»
 
  قوله تعالي: {فزيلنا بينهم} 
 [يونس: ]
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: {فزيلنا بينهم} [يونس: ] قال: «فرقنا بينهم»
 
  قوله تعالي: {وقال شركاءهم} [يونس: ] الاية
 
    
 وبه سمعت عبد الرحمن بن زيد بن اسلم في قول الله: {وقال شركاءهم ما كنتم ايانا تعبدون} [يونس: ] : فقالوا: «بلي قد كنا نعبدكم»
 
  قوله تعالي: {فكفي بالله شهيدا بيننا وبينكم} 
 [يونس: ]
 
    
 وبه في قوله: {فكفي بالله شهيدا بيننا وبينكم} [يونس: ] " ما كنا نسمع، ولا نبصر، ولا نتكلم
 
    
 حدثنا ابي، ثنا عيسي بن جعفر قاضي الري، ثنا مسلم بن خالد، عن ابن ابي نجيح، عن مجاهد، قال: " ياتي علي الناس يوم القيامة ساعة يري فيها اهل الشرك اهل التوحيد يغفر لهم فيقولون: ربنا ما كنا مشركين، فيقول الله تعالي: {انظر كيف كذبوا علي انفسهم وضل عنهم ما كانوا يفترون} [الانعام: ] ، ثم يكون من بعدها ساعة فيها شدة تنصب لهم الالهة التي كانوا يعبدون من دون الله فيقول: هءلاء الذين كنتم تعبدون من دون الله فيقولون: نعم هءلاء الذين كنا نعبد فتقول لهم الالهة: والله ما كنا نسمع ولا نبصر ولا نعقل ولا نعلم انكم تعبدوننا، فيقولون: بلي والله اياكم كنا نعبد قال: فيقول لهم الله: {فكفي بالله شهيدا بيننا وبينكم ان كنا عن عبادتكم لغافلين} [يونس: ] "
 
  قوله تعالي: {ان كنا عن عبادتكم لغافلين} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {عن عبادتكم لغافلين} [يونس: ] يقول: «لكل شء كان يعبد دون الله»
 
    
 حدثنا ابي، ثنا عيسي بن جعفر، ثنا مسلم بن خالد، عن ابن ابي نجيح، عن مجاهد، {كنا عن عبادتكم لغافلين} [يونس: ] " فتقول لهم الالهة: والله ما كنا نسمع، ولا نبصر، ولا نعقل، ولا نعلم انكم كنتم تعبدوننا "
 
  قوله تعالي: {هنالك تبلو كل نفس} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {هنالك تبلو كل نفس ما اسلفت} [يونس: ] قال: «تختبر»
 
  الوجه الثاني
 
    
 حدثنا ابي، ثنا مسلم بن ابراهيم، ثنا الربيع بن عبد الله بن خطاف، قال: سمعت الحسن في قوله: {هنالك تبلو كل نفس ما اسلفت} [يونس: ] قال: «هنالك تسلم كل نفس»
 
  الوجه الثالث
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي قوله: {هنالك تبلو كل نفس} [يونس: ] يقول: «مبتغ كل نفس»
 
  قوله تعالي: {ما اسلفت} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا مسلم بن ابراهيم، ثنا الربيع بن عبد الله بن خطاف، قال: سمعت الحسين في قوله: " {ما اسلفت} [يونس: ] قالا: عملت " وروي عن عبد الرحمن بن زيد بن اسلم نحو ذلك
 
  قوله تعالي: {وردوا الي الله مولاهم الحق} 
 [يونس: ]
 
    
 ذكر لي عن محمد بن عبد الله بن عمر، ثنا يزيد بن هارون، عن قيس، قال: دخل عثمان بن عفان علي عبد الله بن مسعود رضي الله عنهما فقال: كيف تجدك؟ قال: مردود الي مولاي الحق "
 
  قوله تعالي: {وضل عنهم} 
 [الانعام: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قوله: {وضل عنهم ما كانوا يفترون} [الانعام: ] «هذا في القيامة»
 
  قوله تعالي: {ما كانوا يفترون} 
 [ال عمران: ]
 
    
 وبه عن ابن عباس في قوله: {ما كانوا يفترون} [يونس: ] اي: «يشركون»
 
  الوجه الثالث
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم في قوله: {وضل عنهم ما كانوا يفترون} [الانعام: ] وقال: «ما كانوا يدعون معه من الانداد والالهة، وذلك جعلوها اندادا مع الله افتراء وكذبا»
 
  قوله تعالي: {قل من يرزقكم من السماء والارض امن يملك السمع والابصار} [يونس: ] بياض
 
  قوله: {يخرج الحي من الميت ويخرج الميت من الحي} [يونس: ] قد تقدم تفسيره
 
  قوله تعالي: {من يدبر الامر فسيقولون الله} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {يدبر الامر} [يونس: ] قال: «يقضيه وحده»
 
  قوله تعالي: {افلا تتقون} 
 [الاعراف: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو صفوان القاسم بن يزيد بن عوانة، عن يحيي، ثنا جويبر، عن الضحاك، في قوله: {افلا تتقون} [يونس: ] قال: «تتقون النار بالصلوات الخمس»
 
    
 اخبرنا عمر بن ثور القيساري، فيما كتب الي، ثنا الفريابي، ثنا سفيان، عن ابن ابي نجيح، عن مجاهد {تتقون} [يونس: ] : «تستطيعون»
 
  قوله تعالي: {فذلكم الله ربكم الحق فماذا بعد الحق الا الضلال} 
 [يونس: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الطاهر، ثنا حرملة بن عبد العزيز، قال: قلت لمالك بن انس: ما تري في رجل امره يعنيني قال: " ليس ذلك من الحق قال الله: {فماذا بعد الحق الا الضلال} [يونس: ] "
 
    
 قرء علي يونس بن عبد الاعلي، ومحمد بن عبد الله بن عبد الحكم، انبا اشهب، قال: " سءل مالك عن شهادة اللاعب بالشطرنج، والنرد اتري شهادته جاءزة؟ فقال: اما من اتي منها فما اري شهادتهم طاءلة يقول الله عز وجل {فماذا بعد الحق الا الضلال} [يونس: ] فهذا كله من الضلال "
 
  قوله تعالي: {فاني تصرفون} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، في قوله: " {فاني} [يونس: ] قال: كيف "
 
  قوله: {كذلك حقت كلمة ربك علي الذين فسقوا}
 
    
 وبه عن ابن عباس في قوله: {كذلك حقت كلمة ربك علي الذين فسقوا} يقول: «سبقت كلمة ربك»
 
  قوله تعالي: {انهم لا يءمنون} 
 [يونس: ]
 
    
 ذكر الحسن بن محمد بن الصباح، ثنا الحجاج بن محمد، قال ابن جريج، اخبرني ابن كثير، عن مجاهد قوله: {لا يءمنون} [يونس: ] قال: «اذا جاءت بخبر لا يءمنون»
 
  قوله: {هل من شركاءكم من يبدا الخلق ثم يعيده} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {يبدا الخلق ثم يعيده} [يونس: ] : «يحييه ثم يميته، ثم يبديه، ثم يحييه»
 
  قوله تعالي: {قل الله يبدا الخلق ثم يعيده فاني تءفكون} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: في قوله: {فاني تءفكون} [يونس: ] قال: «يكذبون» 
 
  الوجه الثاني
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن الحسن: {فاني تءفكون} [يونس: ] قال: «فاني تصرفون»
 
  قوله تعالي: {قل هل من شركاءكم من يهدي الي الحق} [يونس: ] الاية
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد في قوله: {افمن يهدي الي الحق احق ان يتبع امن لا يهدي الا ان يهدي} [يونس: ] " الاوثان: الله عز وجل يهدي منها ومن غيرها ما شاء "
 
  قوله تعالي: {فما لكم كيف تحكمون} [يونس: ] بياض
 
  قوله: {وما يتبع اكثرهم الا ظنا} [يونس: ] الاية
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قوله: {عليم} [يونس: ] يعني: «عالما بها»
 
    
 حدثنا محمد بن العباس، ثنا زنيج، ثنا سلمة، ثنا محمد، في قوله: {عليم} [يونس: ] اي: «عليم بما يخفون»
 
  قوله تعالي: {وما كان هذا القران ان يفتري من دون الله} [يونس: ] الاية
 
    
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني ابي، ثنا عمي، عن ابيه، عن جده، عن ابن عباس قوله: {بين يديه} [يونس: ] قال: «هو هذا القران شاهدا علي التوراة والانجيل مصدقا بهما»
 
  قوله تعالي: {وتفصيل الكتاب لا ريب فيه} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا ابو اليمان الحكم بن نافع، ثنا حريز بن عثمان، عن عبد الرحمن بن ابي عوف، عن عبد الرحمن بن مسعود الفزاري، عن ابي الدرداء، {ريب} [يونس: ] يعني: «الشك من الكفر» قال ابو محمد: ولا اعلم في هذا الحرف اختلافا بين المفسرين منهم ابن عباس، وسعيد بن جبير، وابو مالك، ونافع، ثنا ابن عمر، وعطاء بن ابي رباح، وابو العالية، والربيع، وقتادة، ومقاتل بن حيان، والسدي، واسماعيل بن ابي خالد
 
  قوله تعالي: {من رب العالمين} [الاعراف: ] قد تقدم تفسير: {رب العالمين} 
 [الفاتحة: ]
 
  قوله تعالي: {ام يقولون افتراه} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا علي بن رستم، ثنا محمد بن الحسن الصنعاني، ثنا منذر بن النعمان الافطس، عن وهب بن منبه، قال: «الكذب هو الفرية وان راس الفرية الكذب علي الله ثم هو ما بين ذلك حتي ياتي كذبا وما بين الكفر بالله كفر ياتي، كفر النعم»
 
  قوله تعالي: {فاتوا بسورة مثله} 
 [يونس: ]
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {فاتوا بسورة مثله} [يونس: ] قال: «مثل هذا القران»
 
    
 حدثنا ابو زرعة، ثنا العباس بن الوليد النرسي، ثنا يزيد بن زريع، ثنا سفيان، عن قتادة قوله: {فاتوا بسورة مثله} [يونس: ] قال: «مثل هذا القران حقا وصدقا لا باطل فيه ولا كذبا»
 
  قوله تعالي: {وادعوا من استطعتم من دون الله ان كنتم صادقين} 
 [يونس: ]
 
    
 حدثنا محمد بن يحيي، ثنا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق، فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس: «وادعوا من استطعتم من اعوانكم علي ما انتم عليه ان كنتم صادقين»
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {وادعوا} [يونس: ] قال: «ناس يشهدون به»
 
  قوله عز وجل: {بل كذبوا بما لم يحيطوا بعلمه ولما ياتهم تاويله} 
 [يونس: ]
 
    
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني ابي، ثنا عمي الحسين حدثني ابي عن ابيه، عن جده، عن ابن عباس قوله: {الظالمين} [يونس: ] «فسماهم الله الظالمين بشركهم»
 
  قوله تعالي: {ومنهم من يءمن به ومنهم من لا يءمن به وربك اعلم بالمفسدين} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا عيسي بن جعفر، ثنا مسلم، عن ابن ابي نجيح، عن مجاهد قال: «ان الله لا يخفي عليه الذين يريدون منك الاصلاح والافساد»
 
  قوله تعالي: {وان كذبوك فقل لي عملي} [يونس: ] الاية
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم في قول الله: {وان كذبوك فقل لي عملي ولكم عملكم انتم بريءون مما اعمل وانا برء مما تعملون} [يونس: ] قال: «امره بهذا ثم نسخه فامره بجهادهم»
 
  قوله تعالي: {ومنهم من يستمعون اليك} [يونس: ] الاية
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {ومنهم من يستمعون اليك} [يونس: ] قال: «قريش»
 
  قوله تعالي: {ومنهم من ينظر اليك افانت تهدي العمي} [يونس: ] الاية
 
    
 حدثنا محمد بن يحيي، ثنا محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، قال: فيما حدثني محمد بن ابي محمد، عن عكرمة، او سعيد بن جبير، عن ابن عباس: {لا يبصرون} [البقرة: ] اي: «لا يبصرون الحق»
 
  قوله تعالي: {ان الله لا يظلم الناس شيءا} [يونس: ] الاية
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قوله: {انفسهم يظلمون} [البقرة: ] قال: «يضرون»
 
  قوله تعالي: {ويوم يحشرهم كان لم يلبثوا الا ساعة من النهار} 
 [يونس: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابراهيم، ثنا سفيان، عن ابيه، عن عكرمة، عن ابن عباس قال: «حشرها الموت»
 
  قوله تعالي: {يتعارفون بينهم} 
 [يونس: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن المثني، ثنا عبد الله الحنفي، ثنا
  [ص: ]
 عمر، عن الحسن: {يتعارفون بينهم} [يونس: ] قال: " يعرف الرجل صاحبه الي جنبه لا يكلمه يعني: يوم القيامة "
 
  قوله تعالي: {قد خسر الذين كذبوا بلقاء الله} 
 [الانعام: ]
 
    
 حدثنا ابي، ثنا ابو بكر بن بشار، ثنا يحيي بن سعيد، عن سفيان، عن الاعمش، عن ابي رزين، في قوله: {قد خسر الذين كذبوا بلقاء الله} [الانعام: ] قال: «قد ضلوا قبل ذلك»
 
  قوله تعالي: {واما نرينك بعض الذي نعدهم} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {واما نرينك بعض الذي نعدهم} [يونس: ] : «من العذاب في حياتك»
 
  قوله تعالي: {او نتوفينك} 
 [يونس: ]
 
    
 وبه عن مجاهد: {ولكل امة رسول فاذا جاء رسولهم} [يونس: ] : «يوم القيامة»
 
  قوله تعالي: {قضي بينهم بالقسط وهم لا يظلمون} 
 [يونس: ]
 
    
 حدثنا علي بن الحسين، ثنا عمرو بن علي، ثنا ابو عاصم، عن عيسي، عن ابن ابي نجيح، عن مجاهد: {القسط} [يونس: ] العدل " وروي عن السدي نحو ذلك
 
  قوله تعالي: {ويقولون متي هذا الوعد ان كنتم صادقين} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة في قوله: {ويقولون متي هذا الوعد ان كنتم صادقين} [يونس: ] قال " اصحاب رسول الله صلي الله عليه وسلم: ان لنا يوما يوشك ان نستريح فيه وننعم فيه فقال المشركون: {ويقولون متي هذا الوعد ان كنتم صادقين} [يونس: ] اي: تكذيبا "
 
  قوله تعالي: {قل لا املك لنفسي ضرا ولا نفعا} [يونس: ] الاية
 
    
 حدثنا ابي، ثنا ابو حذيفة، ثنا شبل، عن ابن ابي نجيح، عن مجاهد قال: {قل لا املك لنفسي ضرا ولا نفعا} [يونس: ] : «ضلالة الا ما شاء الله»
 
  قوله تعالي: {لكل امة اجل اذا جاء اجلهم} [يونس: ] الاية
 
    
 حدثنا عبيد الله بن اسماعيل البغدادي، ثنا عفان، ثنا وهيب، ثنا سعيد
  [ص: ]
 بن ابي عروبة، قال: كان الحسن يقول: " ما حق هءلاء القوم؟ يقولون: اللهم اطل عمره والله يقول: {اذا جاء اجلهم فلا يستاخرون ساعة ولا يستقدمون} [يونس: ] "
 
  قوله تعالي: {قل ارايتم ان اتاكم عذابه بياتا او نهارا} [يونس: ] الاية
 
    
 حدثنا حجاج، عن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {ارايتم ان اتاكم عذابه} [يونس: ] قال: «فجاءة امنين»
 
  قوله تعالي: {اثم اذا ما وقع امنتم به} [يونس: ] الاية
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير في قول الله: {ذوقوا} [يونس: ] يعني: «العقوبة»
 
  قوله تعالي: {هل تجزون الا بما كنتم تكسبون} 
 [يونس: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية قوله: {تكسبون} [يونس: ] يعني: «من الخطيءة»
 
  قوله تعالي: {يستنبءونك احق هو قل اي وربي} [يونس: ] الاية
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قوله: {بمعجزين} [يونس: ] قال: «بمسابقين»
 
  قوله تعالي: {ولو ان لكل نفس ظلمت} [يونس: ] الاية
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، عن انس بن مالك قال: قال رسول الله صلي الله عليه وسلم: " يقال للكافرين يوم القيامة: ارايت لو كان ملء الارض ذهبا اكنت مفتديا به؟ " قال: فيقول: نعم قال: " فيقول: قد كلفت ما هو اهون من ذلك قال الله: لهم جهنم يصلونها وبءس المهاد "
 
  قوله تعالي: {لا يظلمون} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: {وهم لا يظلمون} [يونس: ] يعني: «من اعمالهم فلا ينقص من حسابهم ولا يزاد علي سيءاتهم»
 
  قوله: {الا ان لله ما في السموات والارض} الاية
 
    
 حدثنا علي بن الحسين، ثنا محمد بن العلاء ابو كريب، ثنا عثمان بن سعيد الزيات، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك عن ابن عباس: {لا يعلمون} [يونس: ] يقول: «لا يعقلون»
 
  قوله تعالي: {هو يحيي ويميت واليه ترجعون} 
 [يونس: ]
 
    
 حدثنا محمد بن العباس مولي بني هاشم، ثنا محمد بن عمرو، ثنا سلمة، قال: قال محمد بن اسحاق: {يحيي ويميت} [يونس: ] : «يعجل ما يشاء ويءخر ما يشاء ذلك من اجالهم بقدرته»
 
  قوله تعالي: {يا ايها الناس قد جاءتكم موعظة من ربكم} 
 [يونس: ]
 
    
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، ثنا الثوري، عن بيان، عن الشعبي قوله: {موعظة} [يونس: ] قال: «موعظة من الجهل»
 
  قوله تعالي: {وشفاء لما في الصدور} 
 [يونس: ]
 
    
 ذكره ابو زرعة، ثنا الحسن بن عطية، ثنا اسراءيل، عن ابي اسحاق، عن ابي الاحوص عن عبد الله انه قال: " في القران شفاءان: القران والعسل، فالقران شفاء لما في الصدور، والعسل شفاء من كل داء "
 
    
 حدثنا ابو سعيد الاشج، ثنا المحاربي، عن ليث، عن مجاهد {شفاء} [النحل: ] قال: " الشفاء: القران "
 
  قوله تعالي: {وهدي ورحمة} 
 [الانعام: ]
 
    
 حدثنا الحسن بن ابي الربيع، ثنا عبد الرزاق، ثنا الثوري، عن بيان، عن الشعبي: {هدي} [يونس: ] قال: «هدي من الضلالة»
 
  الوجه الثاني
 
    
 حدثنا الحسن بن احمد، ثنا موسي بن محلم، ثنا ابو بكر الحنفي، ثنا عباد بن منصور، قال: سالت الحسن عن قوله: {وهدي} [يونس: ] قال: «هو القران»
 
  الوجه الثالث
 
    
 حدثنا ابو زرعة، ثنا عمر بن حماد، ثنا اسباط، عن السدي: " {هدي} [يونس: ] قال: نور "
 
  الوجه الرابع
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير: {هدي} [يونس: ] يعني: «تبيانا»
 
  قوله تعالي: {ورحمة للمءمنين} 
 [يونس: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع بن انس، عن ابي العالية، قوله: {ورحمة} [يونس: ] قال: «رحمة القران»
 
  قوله تعالي: {قل بفضل الله} 
 [يونس: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو معاوية، عن حجاج، عن عطية، عن ابي سعيد قال: {بفضل الله وبرحمته} [يونس: ] ، قال: " فضل الله: القران " قال ابو محمد كذا وقال ابو معاوية، عن حجاج، عن عطية، عن ابي سعيد، ورواه عبد الواحد بن زياد، عن حجاج، عن عطية، عن ابن عباس
 
  الوجه الثاني
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو خالد يعني سليمان بن حيان الاحمر، عن حجاج، عن عطية، عن ابن عباس، وحجاج، عن القاسم، عن مجاهد قالا: " فضل الله: الدين " وروي عن ابي العالية، والحسن، وهلال بن يساف، وعكرمة، وقتادة، والربيع بن انس: نحو ذلك
 
  قوله تعالي: {وبرحمته} 
 [يونس: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو معاوية، عن حجاج، عن عطاء، عن ابي سعيد: {وبرحمته} [يونس: ] قال: «برحمته ان جعلكم من اهله»
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو خالد الاحمر، وابو عبد الرحمن الحارثي، عن حجاج، عن عطية، عن ابن عباس قوله: {بفضل الله وبرحمته} [يونس: ] قال: «فضل الله ورحمته ان جعلكم من اهل القران»
 
  الوجه الثاني
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {قل بفضل الله وبرحمته} [يونس: ] قال: " فضله: الاسلام، ورحمته: القران " وروي عن الحسين، وهلال بن يساف، وزيد بن اسلم، وقتادة، وعبد الرحمن بن زيد بن اسلم، مثله وروي عن ابي العالية، وسالم بن ابي الجعد، والضحاك، والربيع بن انس قالوا: الاسلام والقران
 
  الوجه الثالث
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد بن اسلم يقول في قول الله: {قل بفضل الله وبرحمته} [يونس: ] قال: " كان ابي يقول: فضله: القران ورحمته: الاسلام "
 
  قوله تعالي: {فبذلك فليفرحوا} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا سعيد بن سليمان الواسطي، ثنا ابن المبارك، عن الاجلح، عن عبد الله بن عبد الرحمن بن ابزي، عن ابيه، عن ابي بن كعب، قال: قال رسول الله صلي الله عليه وسلم: «اني امرت ان اقرا عليك القران» قال ابي: اوسماني لك؟ قال: نعم قال: فقرا {قل بفضل الله وبرحمته فبذلك فليفرحوا} [يونس: ]
 
    
 حدثنا ابي، ثنا احمد بن جميل المروزي، ثنا ابن المبارك، ثنا شريك، عن ابي معشر، عن محمد بن كعب: {قل بفضل الله وبرحمته فبذلك فليفرحوا} [يونس: ] قال: «اذا عملت خيرا حمدت الله عليه فافرح فهو خير مما تجمعون من الدنيا»
 
    
 وحدثني ابي، ثنا قتيبة بن سعيد، ثنا الوسم بن جميل فبذلك عن ابي سهيل يعني: كثير بن زياد عن الحسن في قول الله: {فبذلك فليفرحوا} [يونس: ] : «بالاسلام والقران» وروي عن القسم بن ابي بزة قال: بالقران
 
  قوله تعالي: {هو خير مما يجمعون} 
 [يونس: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو خالد، عن جويبر، عن الضحاك، قوله: {هو خير مما يجمعون} [يونس: ] قال: «خير مما تجمع الكفار من الاموال» وروي عن الحسن مثله
 
    
 حدثنا احمد بن المروزي، ثنا ابن المبارك، ثنا شريك، عن ابي معشر، عن محمد بن كعب: {فبذلك فليفرحوا هو خير مما يجمعون} [يونس: ] قال: «من الدنيا»
 
    
 ذكره عن بقية، عن صفوان بن عمرو، قال: سمعت ايفع بن عبد الكلاعي، يقول: " لما قدم خراج العراق الي عمر خرج عمر ومولي له، فجعل عمر يعد الابل، فاذا هو اكثر من ذلك، فجعل عمر يقول: الحمد لله ويقول مولاه: يا امير المءمنين، هذا والله من فضل الله ورحمته فقال عمر: كذبت ليس هذا هو , يقول الله: {بفضل الله وبرحمته فبذلك فليفرحوا هو خير مما يجمعون} [يونس: ] وهذا مما تجمعون "
 
  قوله تعالي: {قل ارايتم ما انزل الله لكم من رزق} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا خليد، عن قتادة: {قل ارايتم ما انزل الله لكم من رزق} [يونس: ] يقول: «رزقا لم احرمه عليكم فتحرمونه علي انفسكم من نساءكم واولادكم»
 
    
 حدثنا ابي، ثنا محمود بن خالد ثنا الوليد، ثنا الاوزاعي، ثنا عمر بن عبد العزيز قال: " قول الله عز وجل: {قل ارايتم ما انزل الله لكم من رزق فجعلتم منه حراما وحلالا} [يونس: ]
 
  قوله تعالي: {فجعلتم منه حراما وحلالا} 
 [يونس: ]
 
    
 اخبرنا محمد بن سعد، فيما كتب الي، حدثني عمي، حدثني ابي، عن ابيه، عن عبد الله بن عباس قوله: {قل ارايتم ما انزل الله لكم من رزق فجعلتم منه حراما وحلالا} [يونس: ] قال: «هم اهل الشرك كانوا يحلون الانعام ما شاءوا ويحرمون ما شاءوا»
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {فجعلتم منه حراما وحلالا} [يونس: ] : «في البحيرة الساءبة»
 
    
 حدثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، ثنا عبيد بن سليمان، عن الضحاك، في قوله: " {ارايتم ما انزل الله لكم من رزق فجعلتم منه حراما وحلالا} [يونس: ] : هو الذي قال الله: {وجعلوا لله مما ذرا من الحرث والانعام نصيبا} [الانعام: ] الي قوله: {ساء ما يحكمون} [الانعام: ] "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة، قوله: {فجعلتم منه حراما وحلالا} [يونس: ] يقول: " كل رزقي لم احرم وانتم حرمتموه علي انفسكم من نساءكم واموالكم واولادكم: {قل الله اذن لكم ام علي الله تفترون} [يونس: ] "
 
  قوله تعالي: {قل الله اذن لكم ام علي الله تفترون} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا خليد، عن قتادة: {قل الله اذن لكم ام علي الله تفترون} [يونس: ] «فيما حرم عليكم من ذلك»
 
  قوله تعالي: {وما ظن الذين يفترون علي الله الكذب يوم القيامة} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قوله: {يفترون} [يونس: ] قال: «يكذبون»
 
  الوجه الثاني
 
    
 حدثنا محمد بن يحيي، ثنا العباس بن الوليد النرسي، ثنا يزيد بن زريع، عن سعيد، عن قتادة " قوله: {يفترون} [يونس: ] اي: يشركون "
 
    
 حدثنا ابي، ثنا احمد بن ابي الحواري، ثنا رباح، ثنا عبد الله بن سليمان، ثنا موسي بن ابي الصباح في قول الله: {ان الله لذو فضل علي الناس} [البقرة: ] قال: " اذا كان يوم القيامة يءتي باهل ولاية الله، فيقومون بين يدي الله ثلاث اصناف قال: فيءتي برجل من الصنف الاول، فيقول: عبدي لماذا عملت؟ فيقول: يا رب خلقت الجنة واشجارها، وثمارها، وانهارها، وحورها، ونعيمها، وما اعددت لاهل طاعتك فيها، فاسهرت ليلي واظمات نهاري شوقا اليها قال: فيقول: عبدي انما عملت الجنة هذه الجنة
 
 ، فادخلها، ومن فضلي عليك اعتقك من النار قال: يدخل الجنة هو ومن معه، قال: يءتي بالعبد من الصنف الثاني قال: فيقول: عبدي لماذا عملت؟ فيقول: يا رب خلقت نارا وخلقت اغلالها، وسعيرها، وسمومها، ويحمومها وما اعددت لاهل عذابك فيها، ولاهل معصيتك فيها، فاسهرت ليلي، واظمات نهاري خوفا منها فيقول: عبدي انما عملت خوفا من النار، فاني قد اعتقك من النار، ومن فضلي عليك ادخلتك جنتي، فيدخل الجنة هو ومن معه، ثم يءتي برجل من الصنف الثالث، فيقول: عبدي لماذا عملت؟ فيقول: رب حبا لك وشوقا اليك وعزتك لقد اسهرت ليلي واظمات نهاري شوقا اليك وحبا لك فيقول تبارك وتعالي: عبدي انما عملت حبا لي وشوقا الي، فيتجلي له الرب، فيقول: ها انا ذا انظر الي، ثم يقول: من فضلي عليك ان اعتقك من النار، وادخلك جنتي، وازيرك ملاءكتي، واسلم عليك بنفسي، فيدخل هو ومن معه الجنة "
 
  قوله تعالي: {ولكن اكثرهم لا يشكرون} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد الدمشقي، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة قوله: {ولكن اكثرهم لا يشكرون} [يونس: ] " وان المءمن ليشكر نعم الله عليه وعلي خلقه قال قتادة: وذكر لنا ان ابا الدرداء كان يقول: يا رب شاكر نعمه غيره، ومنهم عليه لا يزيد: ويا رب حامل فقه غير فقيه "
 
  قوله تعالي: {وما تكون في شان وما تتلو منه من قران ولا تعملون من عمل الا كنا عليكم شهودا اذ تفيضون فيه} 
 [يونس: ]
 
    
 حدثنا علي بن الحسين، ثنا اسحاق بن ابراهيم، ثنا عبد الله بن ابراهيم الصنعاني، عن ابيه، قال: " كان بعض العلماء اذا خرج من منزله كتب في يده: {وما تكون في شان وما تتلو منه من قران ولا تعملون من عمل الا كنا عليكم شهودا اذ تفيضون فيه} [يونس: ] الاية "
 
  قوله تعالي: {اذ تفيضون} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن طلحة، عن ابن عباس قوله: {اذ تفيضون فيه} [يونس: ] يقول: «تفعلون»
 
  قوله: {فيه} 
 [البقرة: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله {اذ تفيضون فيه} [يونس: ] «في الحق ما كان»
 
  قوله تعالي: {وما يعزب عن ربك من مثقال ذرة} 
 [يونس: ]
 
    
 حدثنا عبد الله بن سعيد الكندي، ثنا عبيد الله بن موسي، عن اسراءيل، عن ابي يحيي، عن مجاهد، عن ابن عباس: {وما يعزب عن ربك} [يونس: ] قال: «وما يغيب عن ربك تبارك وتعالي»
 
  قوله تعالي: {ولا اصغر من ذلك ولا اكبر الا في كتاب مبين} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة قوله: {في كتاب مبين} [الانعام: ] قال: «كل ذلك في كتاب عند الله مبين»
 
  قوله تعالي: {الا ان اولياء الله} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، حدثني عبد الحميد بن بهرام، عن شهر بن حوشب، عن عبد الرحمن بن غنم، ان ابا مالك الاشعري قال: ان رسول الله صلي الله عليه وسلم لما قضي صلاته اقبل علي الناس، فقال: «ان لله عبادا ليسوا بانبياء، ولا شهداء يغبطهم النبيون والشهداء علي مجالسهم، وقربهم من الله» ، فجثي رجل من الاعراب فقال: يا نبي الله انعتهم لنا علمهم لنا؟ شكلهم لنا، فسر وجه رسول الله صلي الله عليه وسلم لسءال الاعرابي فقال رسول الله صلي الله عليه وسلم: «هم ناس من الناس، ونوازع القباءل، لم تصل بينهم ارحام متقاربة، تحابوا في الله وتصافوا بصفو الله لهم يوم القيامة منابر من نور، فيجلسون عليها، وجوههم نور، وثيابهم نور يفزع الناس يوم القيامة ولا يفزعون وهم اولياء الله، ولا خوف عليهم ولا هم يحزنون»
 
    
 حدثنا ابي، ثنا عثمان بن ابي شيبة، ثنا جرير، عن عمارة بن القعقاع، عن ابي زرعة بن عمرو، عن عمر بن الخطاب، قال: قال رسول الله صلي الله عليه وسلم: «ان من عباد الله لاناسا ما هم بانبياء، ولا شهداء يغبطهم الانبياء، والشهداء يوم القيامة بمكانهم من الله» قالوا: يا رسول الله اخبرنا ما هم وما اعمالهم انا نحبهم لذلك قال: " هو
  [ص: ]
 قوم تحابوا بروح الله علي غير ارحام بينهم ولا اموال يتقاضونها والله ان وجوههم لنور وانهم لعلي نور لا يخافون اذا خاف الناس ولا يحزنون اذا حزن الناس {الا ان اولياء الله لا خوف عليهم ولا هم يحزنون} [يونس: ]
 
    
 حدثنا ابي، ثنا عبد الله بن عمر بن محمد بن ابان، ثنا يحيي بن يمان، عن ابن ابي ليلي عن الحكم عن مقسم، عن ابن عباس قوله: {الا ان اولياء الله لا خوف عليهم ولا هم يحزنون} [يونس: ] قال: «يذكر الله لرءيتهم»
 
    
 حدثنا كثير بن شهاب القزويني، ثنا محمد بن سعيد بن سابق، ثنا يعقوب الاشعري، عن جعفر، عن سعيد بن جبير، عن ابن عباس قال رجل: يا رسول الله من اولياء الله؟ قال: «الذين اذا رءوا ذكر الله عز وجل»
 
    
 حدثنا محمد بن يحيي بن عمر الواسطي، حدثني محمد بن الحسن، ثنا احمد بن محمد هو ابن حنبل، ثنا غوث بن جابر، قال: سمعت محمد بن داود، عن ابيه، عن وهب، قال: قال الحواريون: " يا عيسي من اولياء الله الذين لا خوف عليهم ولا هم يحزنون؟ قال عيسي عليه الصلاة والسلام: الذين نظروا الي باطن الدنيا حين نظر الناس الي ظاهرها، والذين نظروا الي اجل الدنيا حين نظر الناس الي عاجلها، واماتوا منها ما يخشون ان يميتهم، وتركوا ما علموا ان متركهم فصار استكثارهم منها استقلالا، وذكرهم اياها فواتا، وفرحهم بما اصابوا منها حزنا وما عارضهم من ناءلها رفضوه، وما عارضهم من رفعتها بغير الحق وضعوه له، خلت الدنيا عندهم فليسوا يجددونها، وخربت بينهم فليسوا يعمرونها، وماتت في صدورهم، فليسوا يحيونها، يهدمونها فيبنون بها اخرتهم، ويبيعونها فيشترون بها ما يبقي لهم، رفضوها فكانوا برفضها الفرحين، باعوها وكانوا ببيعها هم المربحين، ونظروا الي اهلها صرعي قد خلت فيهم المثلات واحيوا ذكر الموت واماتوا ذكر الحياة يحبون الله تعالي ويستضيءون بنوره ويضيءون به، لهم خبر عجيب، وعندهم الجزاء العجيب، بهم قام الكتاب، وبه قاموا وبهم نطق الكتاب وبه نطقوا، وبهم علم الكتاب وبه علموا، ليسوا يرون ناءلا مع ما نالوا ولا اماني دون ما يرجون، ولا خوفا دون ما يحذرون "
 
 قوله تعالي: {لا خوف
  [ص: ]
 عليهم ولا هم يحزنون} [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، في قول الله: {لا خوف عليهم ولا هم يحزنون} [يونس: ] يعني: " في الاخرة، ولا هم يحزنون يعني: لا يحزنون للموت "
 
  قوله تعالي: {الذين امنوا وكانوا يتقون} 
 [يونس: ]
 
    
 اخبرنا ابو يزيد القراطيسي، فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قول الله: {الا ان اولياء الله لا خوف عليهم ولا هم يحزنون} [يونس: ] قال: قال: " من هم يا رب؟ قال: {الذين امنوا وكانوا يتقون} [يونس: ] اي: لا يقبل الايمان الا بالتقوي "
 
  قوله تعالي: {لهم البشري في الحياة الدنيا} 
 [يونس: ]
 
    
 حدثنا احمد بن سنان، ثنا ابو معاوية، ثنا الاعمش، عن ابي صالح، عن عطاء بن بشار، عن رجل من مصر، عن ابي الدرداء قال: سءل عن هذه الاية: {لهم البشري في الحياة الدنيا وفي الاخرة} [يونس: ] قال: لقد سالت عن شء ما سمعت احدا سال عنه بعد رجل سال النبي صلي الله عليه وسلم، قال رسول الله صلي الله عليه وسلم: «هي الرءيا الصالحة يراها الرجل المسلم او تري له بشراه في الحياة الدنيا وبشراه في الاخرة الجنة»
 
    
 حدثنا محمد بن عبد الله بن يزيد المقرء، ثنا سفيان، عن محمد بن المنكدر، عن عطاء بن دينار، عن رجل من اهل مصر قال: سالت ابا الدرداء عن قوله: {لهم البشري} [يونس: ] قال: لم يسالني عنها احد منذ سالت رسول الله صلي الله عليه وسلم فقال: " ما سالني عنها احد غيرك منذ انزلت هي: الرءيا الصالحة يراها الرجل او تري له "
 
  الوجه الثاني
 
    
 حدثنا المنذر بن شاذان، ثنا يعلي، ثنا ابو بسطام، عن الضحاك، في قوله: {لهم البشري في الحياة الدنيا} [يونس: ] قال: «يعلم اين هو قبل ان يموت» وروي عن زيد بن اسلم نحو ذلك
 
  الوجه الثالث
 
    
 حدثنا ابي، ثنا نعيم بن حماد، ثنا محمد بن ثور، عن عمر، عن الزهري، وقتادة: {لهم البشري في الحياة الدنيا} [يونس: ] قالا: يعني: «الشهادة عند الموت في الحياة الدنيا»
 
  قوله تعالي: {وفي الاخرة} 
 [البقرة: ]
 
    
 حدثنا عمرو بن عبد الله الاودي، ثنا وكيع، عن الاعمش، عن ابي صالح، عن عطاء بن بشار، عن رجل كان يفتي بمصر قال: سالت ابا الدرداء عن هذه الاية: {لهم البشري في الحياة الدنيا وفي الاخرة} [يونس: ] فقال ابو الدرداء: ما سالني عنها احد منذ سالت رسول الله صلي الله عليه وسلم فقال رسول الله صلي الله عليه وسلم: «ما سالني عنها احد قبلك، هي الرءيا الصالحة يراها المءمن او تري له وفي الاخرة الجنة»
 
  قوله: {لا تبديل لكلمات الله} 
 [يونس: ]
 
    
 حدثنا ابو سعيد بن يحيي بن سعيد القطان، ثنا ابراهيم ابو مسلم، انبا السكن موسي بن عبيدة، عن محمد بن كعب القرظي يعني: قوله: {لا تبديل لكلمات الله} [يونس: ] قال: " لا تبديل لشء قاله في الدنيا ولا في الاخرة
 
  قوله: {ذلك} 
 [البقرة: ]
 
    
 حدثني موسي بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، ثنا اسباط، عن السدي، عن ابي مالك " قوله: {ذلك} [يونس: ] يعني: هذا "
 
  قوله: {الفوز} 
 [النساء: ]
 
    
 قرات علي محمد بن الفضل بن موسي، ثنا محمد بن علي، ثنا محمد بن مزاحم، ثنا بكر بن معروف، عن مقاتل بن حيان قوله: {الفوز} [يونس: ] يقول: «نصيبا»
 
  قوله: {العظيم} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير: «عظيما»
 
  قوله: {ولا يحزنك قولهم ان العزة لله جميعا} [يونس: ]
 بياض
 
  قوله: {هو السميع العليم} [الماءدة: ] قد تقدم تفسيره
 
  قوله تعالي: {الا ان لله من في السموات ومن في الارض وما يتبع الذين يدعون من دون الله شركاء}
 
    
 حدثنا ابي هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة: {الذين يدعون من دون الله شركاء} [يونس: ] قال: «ان الذين يدعون من دون الله هذا الوثن وهذا الحجر»
 
  قوله تعالي: {هو الذي جعل لكم الليل لتسكنوا فيه} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان بن صالح، ثنا عن الوليد، عن سعيد بن بشر، عن قتادة في قول الله: {الليل لتسكنوا فيه} [يونس: ] : «يسكن فيه كل طاءر ودابة»
 
  قوله تعالي: {والنهار مبصرا} 
 [يونس: ] ،
 
    
 حدثنا علي بن الحسين، ثنا مسروق، ثنا المرزبان، ثنا ابن ابي زاءدة، قال ابن جريج، قال مجاهد: «الشمس اية النهار»
 
    
 ثنا محمد بن يحيي، ثنا عبد الاعلي بن حماد النرسي، عن يزيد بن زريع، عن سعيد، عن قتادة قوله: {والنهار مبصرا} [يونس: ] اي: «منيرا»
 
  قوله تعالي: {ان في ذلك لايات لقوم يسمعون} 
 [يونس: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا يحيي بن يمان، عن سفيان، عن سماك، عن سعيد بن جبير قوله: {ان في ذلك لايات} [يونس: ] قال: «هو الرجل يبعث بخاتمه الي اهله»
 
  قوله تعالي: {قالوا اتخذ الله ولدا سبحانه} 
 [يونس: ]
 
    
 حدثنا العباس بن يزيد العبدي، ثنا يزيد بن زريع، عن سعيد بن ابي عروبة، عن قتادة قوله: {اتخذ الله ولدا سبحانه} [البقرة: ] قال: «اذ قالوا عليه البهتان عظم نفسه»
 
    
 حدثنا المنذر بن شاذان، ثنا هوذة، ثنا عوف، عن غالب بن عجرة، ثنا رجل من اهل الشام في مسجد مني قال: بلغني ان الله خلق الارض وخلق ما فيها من
  [ص: ]
 الشجر، لم يكن في الارض شجرة ياتيها بنو ادم الا اصابوا فيها منفعة، وقال كان لهم فيها منفعة، ولم تزل الارض والشجر كذلك حتي تكلم فجرة من بني ادم بتلك الكلمة العظيمة بقولهم: اتخذ الله ولدا، فلما تكلموا فيها اقشعرت الارض وشاك الشجر "
 
  قوله تعالي: {هو الغني له ما في السموات وما في الارض}
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا ابو مالك عمرو بن هاشم، عن جويبر، عن الضحاك، عن ابن عباس في قوله: {سبحانه} [يونس: ] يقول: " سبحان: عجب "
 
  قوله تعالي: {ان عندكم من سلطان بهذا} 
 [يونس: ]
 
    
 عن ابن عباس قال: «كل سلطان في القران حجة» وروي عن عكرمة، ومحمد بن كعب، وسعيد بن جبير، والسدي، والضحاك، والنضر بن عدي نحو ذلك
 
  قوله تعالي: {اتقولون علي الله ما لا تعلمون} 
 [الاعراف: ]
 
    
 اخبرنا محمد بن عبيد الله بن المنادي فيما كتب الي، ثنا يونس بن محمد المءدب، ثنا شيبان النحوي، عن قتادة: {اتقولون علي الله ما لا تعلمون} [الاعراف: ] قال: " القول الكذب والباطل، وقالوا: عليه ما لا يعلمون "
 
  قوله تعالي: {قل ان الذين يفترون علي الله الكذب لا يفلحون متاع في الدنيا} 
 [يونس: ]
 
    
 ذكر عن حماد بن زيد، عن هشام بن حسان قال: سمعت الحسن يقول: {متاع الدنيا قليل} [النساء: ] قال: «رحم الله عبدا صاحبها علي ذلك»
 
  قوله تعالي: {واتل عليهم نبا نوح اذ قال لقومه يا قوم ان كان كبر عليكم مقامي} 
 [يونس: ]
 
    
 حدثنا ابو زرعة ثنا ابراهيم بن الفضل بن ابي سويد، ثنا ابو عوانة، عن قتادة، عن انس ان النبي صلي الله عليه وسلم قال: " اول نبي ارسل: نوح عليه السلام "
 
    
 واخبرنا يونس بن عبد الاعلي قراءة، انبا عبد الله بن وهب، ثنا مسلمة بن علي، عن سعيد بن بشير، عن قتادة: «ان نوحا بعث من الجزيرة»
 
    
 حدثنا محمد بن العباس مولي بني هاشم عن عبد الرحمن بن سلمة، ثنا سلمة بن الفضل، حدثني محمد بن اسحاق، قال: «كان من حديث نوح وحديث قومه، فيما قص الله علي لسان نبيه صلي الله عليه وسلم وما يذكر اهل العلم من التوراة، وما حفظ الناس الاحاديث عن عبد الله بن عباس، عن عبيد بن عمير ان الله بعث نوحا الي قومه، فلبث فيهم الف سنة الا خمسين عاما يدعوهم الي الله، وقد فشت في الارض المعاصي، وكثرت فيها الجبابرة، وعتوا علي الله عتوا كبيرا، وكان نوح فيما يذكر اهل العلم حليما صبورا، ولم يلق نبي من قومه من البلاء اكثر مما لقي الا نبي قتل»
 
  قوله تعالي: {فعلي الله توكلت} 
 [يونس: ]
 
    
 حدثنا محمد بن العباس، ثنا محمد بن عمرو زنيج، ثنا سلمة قال، قال محمد بن اسحاق: «وعلي الله لا علي الناس فليتوكل المتوكلون»
 
  قوله تعالي: {فاجمعوا امركم وشركاءكم} 
 [يونس: ]
 
    
 حدثنا عبيد الله بن اسماعيل البغدادي، ثنا خلف بن هشام المقرء، ثنا عبد الوهاب بن عطاء الخفاف، عن هارون، عن اسيد، عن الاعرج: {فاجمعوا امركم وشركاءكم} [يونس: ] يقول: «احكموا امركم وادعوا شركاءكم»
 
    
 حدثنا عبيد الله بن اسماعيل البغدادي، ثنا خلف بن هشام الخفاف، عن هارون، عن الحسن قوله: {فاجمعوا امركم وشركاءكم} [يونس: ] اي: «فليجمعوا امرهم معكم»
 
  قوله تعالي: {ثم لا يكن امركم عليكم} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة: {ثم لا يكن امركم عليكم غمة} [يونس: ] قال: «لا يكثر عليكم امركم»
 
  قوله تعالي: {ثم اقضوا} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {اقضوا الي ولا تنظرون} [يونس: ] : «انهضوا الي»
 
  الوجه الثاني
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، وورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {اقضوا الي ولا تنظرون} [يونس: ] : «اقضوا لي ما في انفسكم»
 
  الوجه الثالث
 
    
 حدثنا ابي محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة: {اقضوا الي ولا تنظرون} [يونس: ] : «الي ما كنتم قاضين»
 
  قوله تعالي: {ولا تنظرون} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، عن بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {ولا تنظرون} [يونس: ] يقول: «ولا تءخرون»
 
  قوله تعالي: {فان توليتم فما سالتكم من اجر} 
 [يونس: ]
 
    
 وبه عن ابن عباس قال: " قل لهم لا اسالكم علي ما ادعوكم اليه اجرا يقول: عرضا من الدنيا "
 
  قوله تعالي: {ان اجري الا علي الله} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، عن ورقاء، عن ابن ابي نجيح، عن مجاهد: {ان اجري} [يونس: ] يقول: «جزاءي»
 
  قوله تعالي: {وامرت ان اكون من المسلمين} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا ابو صالح كاتب الليث، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {المسلمين} [يونس: ] يقول: «الموحدين»
 
  قوله تعالي: {فكذبوه فنجيناه} 
 [يونس: ]
 
    
 اخبرنا يونس بن عبد الاعلي قراءة اخبرني ابن وهب قال: بلغني عن ابن عباس انه قال: «كان في سفينة نوح ثمانون رجلا احدهم كان لسانه عربيا»
 
    
 حدثني محمد بن العباس مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا محمد بن محمد بن اسحاق، عن الحسن بن دينار، عن علي بن زيد بن جدعان، عن يوسف بن مهران، عن عبد الله بن عباس قال: سمعته يقول: " اول ما حمل نوح في
  [ص: ]
 الفلك من الدواب الدرة، واخر ما حمل الحمار قلت: ادخل الحمار ودخل صدره، تعلق ابليس بذنبه، فلم تستقل رجلاه فجعل نوح ويحك ادخل، فينهق فلا يستطيع حتي قال نوح: ويحك ادخل وان كان الشيطان معك قال كلمة زلت علي لسانه "
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله بن موسي، عن اسراءيل، عن السدي، عن ابي مالك {في الفلك} [يونس: ] قال: «سفينة نوح حمل فيها من كل زوجين اثنين»
 
  قوله تعالي: {وجعلناهم خلاءف} 
 [يونس: ]
 
    
 اخبرنا احمد بن عثمان بن حكيم فيما كتب الي احمد بن مفضل، عن اسباط، عن السدي قوله: {خلاءف الارض} [الانعام: ] : «اما خلاءف الارض فاهلك القرون فاستخلفنا فيها بعدهم»
 
    
 واخبرنا ابو يزيد القراطيسي فيما كتب الي قال: سمعت اصبغ بن الفرج، سمعت عبد الرحمن بن زيد يقول: في قوله: {هو الذي جعلكم خلاءف الارض} [الانعام: ] قال: «يستخلف في الارض قوما بعد قوم»
 
  قوله تعالي: {واغرقنا الذين كذبوا باياتنا فانظر كيف كان عاقبة المنذرين} 
 [يونس: ]
 
    
 حدثنا محمد بن العباس مولي بني هاشم ثنا عبد الرحمن بن سلمة ابو زهير، عن رجل من اصحابه قال: بلغني: «ان قوم نوح عاشوا في ذلك الغرق اربعين يوما»
 
    
 حدثنا محمد بن العباس مولي بني هاشم ثنا عبد الرحمن بن سلمة، ثنا سلمة، ثنا محمد بن اسحاق قال: «فلقد غرقت الارض، وما فيها وانتهي الماء الي ما انتهي اليه وما جاور الماء ركبته وداب الماء حين ارسله الله خمسين وماءة يوم كما يزعم اهل التوراة، فكان بين ان ارسل الله الطوفان، وبين ان غاص ستة اشهر وعشر ليال، ولما اراد الله ان يكف ذلك ارسل الله ريحا علي وجه الماء فسكن الماء وانسدت ينابيع الارض الغمر الاكبر وابواب السماء فجعل الماء ينقص، ويغيض، ويدبر، فكان استواء الفلك علي الجودي فيما يزعم اهل التوراة في الشهر السابع لسبع عشرة ليلة مضت منه، وفي اول يوم من الشهر العاشر راي رءوس الجبال فلما مضي بعد
 
 ذلك اربعون يوما فتح نوح كوة الفلك التي صنع فيها، ثم ارسل الغراب لينظر له ما فعل الماء فلم يرجع اليه، فارسل الحمامة، فرجعت اليه، فلم تجد لرجليها موضعا، فبسط يده للحمامة فاخذها، فادخلها فمكث سبعة ايام، ثم ارسلها لتنظر له، فرجعت اليه حين امست وفي فيها ورقة زيتونة فعلم نوح ان الماء قد قل عن وجه الارض، ثم مكث فيها سبعة ايام ثم ارسلها فلم ترجع فعلم نوح ان الارض قد برزت»
 
  قوله تعالي: {ثم بعثنا من بعده رسلا الي قومهم} [يونس: ] الاية
 
    
 حدثنا كثير بن شهاب المذحجي القزويني، ثنا محمد بن سعيد بن سابق، ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية، عن ابي بن كعب في قوله: {ثم بعثنا من بعده رسلا الي قومهم فجاءوهم بالبينات فما كانوا ليءمنوا بما كذبوا به من قبل} : " كان في علمه يوم اقروا من يصدق به، ومن يكذب به فكان عيسي عليه السلام من تلك الازواج التي اخذ عليها العهد والميثاق في زمان ادم
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، عن ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: " {بما كذبوا به من قبل} [يونس: ] قول الله: {ولو ردوا لعادوا لما نهوا عنه} [الانعام: ] "
 
    
 اخبرنا احمد بن عثمان بن حكيم الاودي فيما كتب الي احمد بن مفضل، عن اسباط، عن السدي، قوله: {فما كانوا ليءمنوا بما كذبوا به من قبل} [يونس: ] قال: «ذلك يوم اخذ منهم الميثاق امنوا كرها»
 
  قوله تعالي: {كذلك نطبع علي قلوب المعتدين} 
 [يونس: ]
 
    
 اخبرنا ابو بدر عباد بن الوليد الغبري فيما كتب الي، ثنا رجاء بن اسحاق ابو معشر، عن سعيد المقبري في قول الله: {وطبع} [التوبة: ] : «ختم علي قلوبهم»
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، عن سعيد، عن قتادة قوله: {ونطبع علي قلوبهم} [الاعراف: ] اي: «باعمالهم»
 
  قوله تعالي: {ثم بعثنا من بعدهم موسي، وهارون الي فرعون} [يونس: ] الاية
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو يحيي الرازي، عن موسي بن عبيدة، عن محمد بن المنكدر قال: «عاش فرعون ثلاثماءة سنة، ماءتان وعشرون لم ير فيها ما يقذي عينه، ودعا موسي ثمانين سنة»
 
    
 حدثنا ابي، ثنا ابراهيم بن سعيد الجوهري ابو اسامة، ثنا شبل، عن ابن ابي نجيح، عن مجاهد قال: «كان فرعون فارسيا من اهل اصطخر»
 
    
 قراه علي يونس بن عبد الاعلي، عن ابن وهب، اخبرني ابن لهيعة، «ان فرعون كان من ابناء سحرة»
 
  قوله تعالي: {فلما جاءهم بالحق من عندنا} [غافر: ] الاية
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد عن اسباط، عن السدي قال: «لما جاءهم رسول من عند الله عارضوه وحاصروه»
 
  قوله تعالي: {قال موسي اتقولون للحق لما جاءكم} [يونس: ] الاية. بياض
 
  قوله: {قالوا اجءتنا لتلفتنا عما وجدنا عليه اباءنا} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي الصنعاني، ثنا محمد بن ثور، عن معمر، عن قتادة: {لتلفتنا} [يونس: ] : «لتلوينا عما وجدنا عليه اباءنا»
 
    
 حدثنا عبد الله بن سليمان، عن الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي قوله: {لتلفتنا عما وجدنا عليه اباءنا} [يونس: ] يقول: «لتصدنا عن الهتنا»
 
  قوله تعالي: {وتكون لكما الكبرياء في الارض} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، عن ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {الكبرياء في الارض} [يونس: ] : «الملك»
 
    
 حدثنا ابي، ثنا ابو معمر اسماعيل بن ابراهيم، ثنا سعيد بن محمد الثقفي، عن الاعمش، عن مجاهد: {وتكون لكما الكبرياء في الارض} [يونس: ] قال: «العظمة في الارض»
 
  قوله تعالي: {وما نحن لكما بمءمنين} 
 [يونس: ]
 
    
 حدثنا عطاء بن دينار، عن سعيد بن جبير قوله: {بمءمنين} [يونس: ] قال: «بمصدقين»
 
  قوله تعالي: {وقال فرعون اءتوني بكل ساحر عليم} 
 [يونس: ]
 
    
 حدثنا عمار بن خالد الواسطي، ثنا محمد بن الحسن، ويزيد بن هارون، واللفظ لمحمد بن الحسن، عن اصبغ بن زيد الوراق، عن القاسم بن ابي ايوب، عن سعيد بن جبير، عن ابن عباس يعني: قوله {اءتوني بكل ساحر عليم} [يونس: ] قال: «فحشر له كل ساحر متعالم»
 
  قوله تعالي: {فلما جاء السحرة قال لهم موسي القوا ما انتم ملقون} 
 [يونس: ]
 
    
 وبه عن ابن عباس قال: " اليوم الذي اظهر الله فيه موسي علي فرعون والسحرة هو يوم عاشوراء فلما اجتمعوا في صعيد قال الناس بعضهم لبعض: انطلقوا فلنحضر هذا الامر، ونتبع السحرة ان كانوا هم الغالبين، يعني بذلك: موسي، وهارون صلي الله عليهما وسلم استهزاء بهما قالوا: يا موسي لقدرتهم بسحرهم اما ان تلقي، واما ان نكون نحن الملقين قال: القوا، فالقوا حبالهم وعصيهم، وقالوا بعزة فرعون انا لنحن الغالبون، فراي موسي من سحرهم ما اوجس في نفسه خيفة، فاوحي الله اليه ان الق العصا "
 
  قوله تعالي: {فلما القوا قال موسي ما جءتم به السحر ان الله سيبطله ان الله لا يصلح عمل المفسدين} 
 [يونس: ]
 
    
 حدثنا محمد بن عمار بن الحارث، ثنا عبد الرحمن الدشتكي، ثنا ابو جعفر الرازي، عن ليث قال: " بلغني ان هءلاء الايات شفاء من السحر باذن الله، تقرا في اناء فيه ماء، ثم يصب علي راس المسحور الاية التي في سورة يونس: {فلما القوا قال موسي ما جءتم به السحر ان الله سيبطله ان الله لا يصلح عمل المفسدين ويحق الله الحق بكلماته ولو كره المجرمون} [يونس: ] والاية الاخري: {فوقع الحق وبطل ما كانوا يعملون} [الاعراف: ] الي انتهاء اربع ايات، وقوله: {انما صنعوا كيد ساحر ولا يفلح الساحر حيث اتي} [طه: ] "
 
  قوله: {ويحق الله الحق بكلماته ولو كره المجرمون} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، عن بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {المجرمون} [يونس: ] قال: «الكفار»
 
  قوله تعالي: {فما امن لموسي الا ذرية من قومه} 
 [يونس: ]
 
    
 حدثنا ابي ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {ذرية من قومه} [يونس: ] يقول: «بني اسراءيل»
 
    
 حدثنا ابو زرعة، ثنا صفوان، عن الوليد، عن خليد، عن قتادة، عن عبد الله بن عباس في قوله: {فما امن لموسي الا ذرية من قومه} [يونس: ] قال: «الذرية القليل»
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا ابن وهب، اخبرني ابن زيد يعني عبد الرحمن، عن ابيه زيد بن اسلم انه قال في هذه الاية: {فما امن لموسي الا ذرية من قومه علي خوف من فرعون} [يونس: ] قال: " كان فرعون يذبح الغلمان فلما كان من امر موسي عليه السلام ما كان حين ضرب موسي بالعصا وهو قاعد عبدا عنده اخرجه، ثم قطر عن قتل ذرية من بني اسراءيل، وعرف انه هو الذي كان يقتل في سببه ذرية من بني اسراءيل، فنشات ناشءة فيما بين ذلك الي ان جاء موسي من مدين حين بعثه الله عز وجل رسولا وهي الذرية التي قال الله: {فما امن لموسي الا ذرية من قومه علي خوف من فرعون} [يونس: ] "
 
  قوله تعالي: {علي خوف من فرعون} 
 [يونس: ]
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن يزيد بن اسلم في قول الله: {وملءهم} [يونس: ] قال: " هذا واحد نزل القران علي كلام العرب قوله: {وان فرعون لعال في الارض} [يونس: ] يقول: تجبر في الارض "
 
  قوله تعالي: {وقال موسي يا قوم ان كنتم امنتم بالله فعليه توكلوا ان كنتم مسلمين} 
 [يونس: ]
 
    
 حدثنا محمد بن العباس مولي بني هاشم، ثنا محمد بن عمرو زنيج ثنا سلمة قال، قال محمد بن اسحاق يعني: {فعليه توكلوا} [يونس: ] اي: «ارضي به من العباد»
 
  قوله تعالي: {فقالوا علي الله توكلنا} 
 [يونس: ]
 
    
 وبه قال: قال محمد بن اسحاق: «وعلي الله لا علي الناس فليتوكل المءمنون»
 
  قوله تعالي: {ربنا لا تجعلنا فتنة للقوم الظالمين ونجنا} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: {لا تجعلنا فتنة للقوم الظالمين} [يونس: ] يقول: " لا تعذبنا بايدي قوم فرعون، ولا بعذاب من عندك فيقول قوم فرعون: لو كانوا علي حق ما عذبوا، ولا سلطنا عليهم فيفتنون بنا "
 
    
 حدثنا احمد بن سنان، عن عبد الرحمن بن مهدي، عن سفيان، عن ابيه، عن ابي الضحي: {ربنا لا تجعلنا فتنة للقوم الظالمين} [يونس: ] قال: «ان تسلطهم علينا، فيزدادوا طغيانا» وروي عن ابي قلابة نحو ذلك
 
    
 حدثنا ابي، ثنا ابو سلمة، ثنا حماد بن سلمة، عن عمران بن حدير، عن ابي مجلز في قوله: {لا تجعلنا فتنة للقوم الظالمين} [يونس: ] يقول: «ربنا لا تظهرهم علينا فيروا انهم خير منا» وروي عن عكرمة نحو ذلك
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قوله: {ربنا لا تجعلنا فتنة للقوم الظالمين} [يونس: ] قال: " لا تبتلنا بهم فتجهدنا نحن، ونجعل فتنة لهم هذه الفتنة، وقرا {فتنة للظالمين} [الصافات: ] ، وقال: المشركين حيث كانوا يءذون النبي صلي الله عليه وسلم والمءمنين، ويرمونهم اليس ذلك فتنة لهم وشرا لهم وهي بلية للمءمنين "
 
  قوله تعالي: {واوحينا الي موسي واخيه ان تبوءا لقومكما بمصر بيوتا} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله " {تبوءا لقومكما بمصر بيوتا} [يونس: ] قال: مصر، الاسكندرية "
 
    
 حدثنا حماد بن الحسن بن عنبسة، ثنا ابو داود، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد في قوله: " {بمصر بيوتا} [يونس: ] قال: مصر الاسكندرية "
 
  والوجه الثاني
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو يحيي الرازي، عن ابي سنان، عن ثابت، عن الضحاك: " {واوحينا الي موسي واخيه ان تبوءا لقومكما بمصر بيوتا} [يونس: ] قال: مساجد "
 
  قوله تعالي: {واجعلوا بيوتكم قبلة} 
 [يونس: ]
 
    
 حدثنا احمد بن سنان، ثنا عبد الرحمن بن مهدي، ثنا سفيان، عن خصيف، عن عكرمة، عن ابن عباس: " {واجعلوا بيوتكم قبلة} [يونس: ] قال: مساجد " وروي عن مجاهد في بعض الروايات، والربيع بن انس، وزيد بن اسلم نحو ذلك
 
    
 حدثنا محمد بن عبد الله بن يزيد المقرء، ثنا سفيان، عن منصور، عن ابراهيم قوله: " {واجعلوا بيوتكم قبلة} [يونس: ] قال: كانوا خاءفين فامروا ان يصلوا في بيوتهم "
 
    
 حدثنا ابي، ثنا ابن ابي عمر، ثنا سفيان، عن ابن ابي نجيح، عن مجاهد في قوله: " {واجعلوا بيوتكم قبلة} [يونس: ] قال: كانوا لا يصلون الا في البيت حين خافوا من ال فرعون فامروا ان يصلوا في بيوتهم قال سفيان: اعطوا ما اعطي النبي صلي الله عليه وسلم فابوا ان تجعل لهم الارض مسجدا وطهورا وروي عن ابي مالك، وقتادة نحو ذلك
 
  والوجه الثاني
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا علي بن عامر، عن عطاء بن الساءب، عن سعيد بن جبير، عن ابن عباس في قوله: " {واجعلوا بيوتكم قبلة} [يونس: ] قال: مقابل بعضها بعضا "
 
  والوجه الثالث
 
    
 حدثنا ابي، ثنا عبد الله بن جعفر الرقي، ثنا ابن المبارك، عن ابن ابي ليلي، عن المنهال بن عمرو، عن سعيد بن جبير، عن ابن عباس في قوله: " {واجعلوا بيوتكم قبلة} [يونس: ] قال: الي الكعبة " وروي عن مجاهد، والضحاك نحوه
 
  قوله تعالي: {واقيموا الصلاة} 
 [البقرة: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا مبارك بن فضالة، عن الحسن في قوله: " {واقيموا الصلاة} [يونس: ] قال: فريضة واجبة لا تنفع الاعمال الا بها وبالزكاة " وروي عن عطاء، وقتادة نحو ذلك
 
 قرات علي محمد بن الفضل، ثنا محمد بن علي، ثنا ابو وهب محمد بن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان قوله لاهل الكتاب: " {واقيموا الصلاة} [البقرة: ] امرهم ان يصلوا مع النبي صلي الله عليه وسلم "
 
  قوله تعالي: {وبشر المءمنين} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا عبد الله بن لهيعة، ثنا عطاء بن دينار، عن سعيد بن جبير قوله: " {وبشر المءمنين} [يونس: ] قال: بشرهم بالنصر في الدنيا والجنة في الاخرة "
 
  قوله تعالي: {وقال موسي ربنا انك اتيت فرعون وملاه زينة واموالا في الحياة الدنيا} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي قال: قد " خرج موسي عليه الصلاة والسلام ببني اسراءيل ليلا والقبط يعلمون، وقد دعوا قبل ذلك علي القبط، فقال موسي: ربنا ليضلوا عن سبيلك "
 
  قوله تعالي: {ربنا ليضلوا عن سبيلك} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قوله: " {عن سبيلك} [يونس: ] قال: عن دين الله "
 
    
 حدثنا ابو زرعة، ثنا عمر بن حماد بن طلحة، ثنا اسباط، عن السدي: " {وقال موسي ربنا انك اتيت فرعون وملاه زينة واموالا في الحياة الدنيا ربنا ليضلوا عن سبيلك} [يونس: ] الاية قال الله: قد اجبت دعوتكما، ثم قال لهما: استقيما فخرجا في قومهم والقي علي القبط الموت، فمات كل بكر رجل منهم، فاصبحوا يدفنونهم، فشغلوا عن طلبهم حتي طلعت الشمس "
 
  قوله تعالي: {ربنا اطمس علي اموالهم} 
 [يونس: ]
 
    
 اخبرنا محمد بن سعد فيما كتب الي، حدثني ابي، ثنا عمي، عن ابيه، عن جده، عن ابن عباس في قوله: " {ربنا اطمس علي اموالهم} [يونس: ] يقول: دمر عليهم، واهلك اموالهم "
 
  والوجه الثاني
 
    
 حدثنا ابو سعيد الاشج، ثنا يحيي بن يمان، عن ابي جعفر الرازي، عن الربيع، عن ابي العالية: " {ربنا اطمس علي اموالهم} [يونس: ] قال: صارت حجارة " وروي عن ابي صالح مثله
 
    
 حدثنا ابو سعيد، ثنا يحيي بن يمان، عن رجل، عن الضحاك قال: «صارت حجارة منقوشة»
 
    
 حدثنا اسماعيل بن ابي الحارث، ثنا يحيي بن ابي بكير، عن ابي معشر، حدثني محمد بن قيس، ان محمد بن كعب قرا سورة يونس علي عمر بن عبد العزيز: {وقال موسي ربنا انك اتيت فرعون وملاه زينة واموالا في الحياة الدنيا} [يونس: ] الي قوله: {اطمس علي اموالهم} [يونس: ] الاية الي اخرها فقال له عمر بن عبد العزيز: يا ابا حمزة: اي شء الطمس؟ قال: " عادت اموالهم كلها حجارة فقال عمر بن عبد العزيز لغلام له: اءتني بكيس، فجاء بكيس، فاذا فيه حمص وبيض قد قطع قد حول حجارة "
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي قوله: " {ربنا اطمس علي اموالهم} [يونس: ] فذكر طمس الاموال جعل دنانيرهم ودراهمهم حجارة "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة: " {ربنا اطمس علي اموالهم} [يونس: ] ذكر لنا ان زروعهم، واموالهم تحولت حجارة "
 
  قوله تعالي: {واشدد علي قلوبهم} 
 [يونس: ]
 
    
 اخبرنا محمد بن سعد العوفي فيما كتب الي، حدثني ابي، حدثني عمي، ثنا ابي، عن ابيه، عن ابن عباس قوله: " {واشدد علي قلوبهم} [يونس: ] يعني: اطبع علي قلوبهم "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: " {واشدد علي قلوبهم} [يونس: ] " بالضلالة
 
 حدثني ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، ثنا عبيد بن سليمان، عن الضحاك: " {واشدد علي قلوبهم} [يونس: ] يقول: اهلكهم كفارا "
 
  قوله تعالي: {فلا يءمنوا} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا صالح كاتب الليث، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: " {فلا يءمنوا حتي يروا العذاب الاليم} [يونس: ] فاستجاب الله له، وحال بينه، يعني: فرعون وبين الايمان "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: " {فلا يءمنوا} [يونس: ] بالله فيما يروا من الايات {حتي يروا العذاب الاليم} [يونس: ] "
 
  قوله تعالي: {حتي يروا العذاب الاليم} 
 [يونس: ]
 
    
 اخبرنا محمد بن سعد فيما كتب الي، ثنا ابي، ثنا عمي، ثنا ابي، عن ابيه، عن ابن عباس قوله: " {حتي يروا العذاب الاليم} [يونس: ] وهو الغرق "
 
  قوله: {قد اجيبت دعوتكما} 
 [يونس: ]
 
 حدثنا ابو سعيد الاشج، ثنا الفضل بن دكين، عن ابي جعفر الرازي، عن الربيع بن انس، عن ابي العالية: {قد اجيبت دعوتكما} [يونس: ] فاستبقا قال: دعا موسي، وامن هارون وروي عن ابي صالح مثله وروي عن عكرمة، ومحمد بن كعب القرظي، والربيع بن انس نحو ذلك
 
    
 حدثنا ابي، ثنا اسحاق بن موسي الخطمي، ثنا احمد بن بشير، ثنا سعد بن طريف، عن محمد بن علي بن حسين في قوله: " {قد اجيبت دعوتكما} [يونس: ] قال: قال ذلك ثم اخذ فرعون بعد ذلك باربعين يوما "
 
    
 اخبرنا ابو الازهر احمد بن الازهر فيما كتب الي، ثنا وهب بن جرير، ثنا ابي، عن علي بن الحكم عن الضحاك يقول: " اهلكهم كفارا وذلك قوله: {قد اجيبت دعوتكما} [يونس: ] "
 
  قوله تعالي: {فاستقيما ولا تتبعان سبيل الذين لا يعلمون} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط قال: فزعم السدي ان موسي هو الذي دعا، وامن هارون فذلك حين يقول الله: {قد اجيبت دعوتكما فاستقيما} [يونس: ] فخرجا في قومهم
 
  قوله تعالي: {وجاوزنا ببني اسراءيل البحر} 
 [الاعراف: ]
 
    
 حدثنا عمار بن خالد، ثنا محمد بن الحسن، ويزيد بن هارون، واللفظ لمحمد بن الحسن، عن اصبغ بن زيد الوراق، عن القاسم بن ابي ايوب، حدثني سعيد بن جبير، عن ابن عباس قال: " فدفع الي البحر وله قصة مخافة ان يضربه موسي بعصاه، وهو غافل، فيصير عاصيا له، فلما راي الجمعان وتقاربا قال قوم موسي: انا لمدركون، افعل ما امرك به ربك فانك لم تكذب قال: وعدني اذا انتهيت الي البحر ان يفرق لي حتي اجاوزه، ثم ذكر بعد ذلك العصا فضرب البحر كما امره الله، وكما وعد موسي فلما جازا اصحاب موسي كلهم دخل اصحاب فرعون كلهم فالتقي البحر عليهم كما امر "
 
  قوله تعالي: {البحر} 
 [البقرة: ]
 
    
 حدثنا ابي، ثنا احمد بن عبد الله بن يونس، ثنا طلحة بن زين، عن خالد بن معدان، عن عبد الله بن عمر، وقال: «بلغني ان البحر رق بيد ما كان يغفل عنها الملك لطم علي الارض»
 
  قوله تعالي: {فاتبعهم فرعون وجنوده} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي، وخرج موسي في ستماءة الف وعشرين الفا لا يعدون لصغره ولا ابن ستين لكبره، وانما عدوا فيما بين ذلك سوي الذرية، وتبعهم فرعون، علي مقدمته هامان في الف الف وسبعماءة الف حصان ليس فيها ماذيانة
 
  قوله عز وجل: {بغيا وعدوا} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا يعقوب بن ابراهيم الدورقي، ثنا علي بن الحسن بن شقيق، ثنا الحسن بن واقد، عن يزيد النحوي، عن عكرمة في قوله: " {فاتبعهم فرعون وجنوده بغيا وعدوا} [يونس: ] قال: العدو والعلو والعتو في كتاب الله تجبر "
 
  قوله تعالي: {حتي اذا ادركه الغرق} 
 [يونس: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن محمد بن اسحاق، عن محمد بن كعب، عن عبد الله بن شداد قال: حدثت انه " لما دخل بنو
  [ص: ]
 اسراءيل فلم يبق منهم احد اقبل فرعون وهو علي حصان له من الخيل حتي وقف علي شفير البحر، وهو قاءم علي حاله، فهاب الحصان ان يتقدم فعرض له جبريل علي فرس انثي وديق ففر بها منه فشمها الفحل فلما شمها قدمها، فتقدم معها الحصان عليه فرعون فلما راي جند فرعون قد دخل، دخلوا معه قال: وجبريل امامه يتبعه فرعون، وميكاءيل علي فرس من خلف القوم يشحذهم علي فرسه ذاك يقول: الحقوا بصاحبكم حتي اذا فصل جبريل من البحر ليس امامه احد وقف ميكاءيل علي الناحية الاخري ليس خلفه احد اطبق عليهم البحر "
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة قوله: " {حتي اذا ادركه الغرق} [يونس: ] قال: ما وجد عدو الله طعم الموت واخذ بذنبه "
 
  قوله تعالي: {قال امنت انه لا اله الا الذي امنت به بنو اسراءيل وانا من المسلمين} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا ابو سلمة، ثنا حماد بن سلمة، عن علي بن زيد، عن يوسف بن مهران، عن ابن عباس ان النبي صلي الله عليه وسلم قال: " لما اغرق الله ال فرعون قال: امنت انه لا اله الا الذي امنت به بنو اسراءيل قال جبريل: يا محمد لو رايتني وانا اخذ من حال البحر فادسه في في فرعون مخافة ان تدركه الرحمة "
 
    
 حدثنا يونس بن حبيب، ثنا ابو داود، ثنا شعبة، عن عدي بن ثابت، وعطاء بن الساءب، عن سعيد بن جبير، عن ابن عباس قال: قال رسول الله صلي الله عليه وسلم: «قال لي جبريل لو رايتني وانا اخذ من حال البحر، فادسه في في فرعون مخافة ان تدركه الرحمة»
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو خالد الاحمر، عن عمر بن عبد الله الثقفي، عن سعيد بن جبير، عن ابن عباس قال: " لما اغرق الله فرعون اشار باصبعه ورفع صوته، امنت انه لا اله الا الذي امن به بنو اسراءيل قال: فخاف جبريل عليه السلام ان تسبق رحمة الله فيه غضبه، فجعل ياخذ الحال بجناحيه فيضرب به وجهه فيرفسه "
 
  
  قوله تعالي: {الان 
 وقد عصيت قبل} [يونس: ] الاية</span>
 
    
 حدثنا ابي، ثنا محمد بن عمران بن ابي ليلي، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس " فلما خرج اخر اصحاب موسي ودخل اخر اصحاب فرعون اوحي الي البحر ان اطبق عليهم فخرجت اصبع فرعون بلا اله الا الله الذي امنت به بنو اسراءيل، قال جبريل: فعرفت ان الرب رحيم وخفت ان تدركه الرحمة فدمسته بجناحي وقلت: {الان وقد عصيت قبل وكنت من المفسدين} [يونس: ] "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، ثنا محمد بن اسحاق، عن محمد بن كعب، عن عبد الله بن شداد قال: " ونادي فرعون حين راي من سلطان الله وقدرته ما راي عرف ذله، وخذلته نفسه نادي {امنت انه لا اله الا الذي امنت به بنو اسراءيل وانا من المسلمين} [يونس: ] "
 
  قوله تعالي: {الان} 
 [يونس: ]
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة قوله: " {الان وقد عصيت قبل} [يونس: ] اي لو كان هذا في الرخاء: {وكنت من المفسدين} [يونس: ] "
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد، ثنا اسباط، عن السدي قال: " فبعث الله ميكاءيل يعيره فقال: {الان وقد عصيت قبل وكنت من المفسدين} [يونس: ] "
 
  قوله تعالي: {فاليوم ننجيك ببدنك} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا محمد بن عمران بن ابي ليلي، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس " فلما خرج موسي واصحابه قال من تخلف في المداءن من قوم فرعون: ما غرق فرعون ولا اصحابه، ولكنهم في جزاءر البحر يتصيدون، فاوحي الي البحر ان الفظ فرعون عريانا فلفظه عريانا اصلع اخيبس قصيرا، فهو قوله: {فاليوم ننجيك ببدنك لتكون لمن خلفك اية} [يونس: ] "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: " {فاليوم ننجيك ببدنك} [يونس: ] قال: ننجيك بجسدك "
 
 حدثنا ابو سعيد الاشج، ثنا عمرو العنقزي، عن ابي بكر الهذلي، عن الحسن: " {فاليوم ننجيك ببدنك} [يونس: ] قال: جسمك لا روح فيه وروي عن عبد الله بن شداد انه قال: اي سويا لم يذهب منك شء
 
  الوجه الثاني
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا سعيد بن ابي مريم، ثنا مفضل بن فضالة، حدثني ابو صخر في قول الله: " {فاليوم ننجيك ببدنك} [يونس: ] قال: البدن: الدرع الجديد "
 
    
 حدثنا ابي، قال: ذكر لي عن بدل بن المحبر، ثنا المفضل بن ابي موسي بن سالم، عن ابيه في قول الله: " {فاليوم ننجيك ببدنك} [يونس: ] قال شء كان فرعون يلبسه يقال له: البدن "
 
  قوله تعالي: {لتكون لمن خلفك اية} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا محمد بن عمران بن ابي ليلي، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قوله: " {لتكون لمن خلفك اية} [يونس: ] لمن قال: ان فرعون لم يغرق وكان نجاه عبرة لم يكن نجاه عافية، ثم اوحي الي البحر ان الفظ ما فيك، فلفظهم علي الراجل حتي راهم من قال: ان فرعون لم يغرق واصحابه، وكان البحر لا يلفظ غريقا يبقي في بطنه حتي ياكله السمك، فليس يقبل البحر غريقا الي يوم القيامة "
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة: " {لتكون لمن خلفك اية} [يونس: ] قال: لما اغرق الله فرعون لم يصدق طاءفة من الناس بذلك فاخرجه الله تعالي اية وعظة "
 
    
 حدثنا ابو زرعة، ثنا عمرو بن حماد بن طلحة، ثنا اسباط، عن السدي، قوله " {لتكون لمن خلفك اية} [يونس: ] : لبني اسراءيل اية "
 
    
 حدثنا ابي، ثنا عبد الله بن سعد ابن اخي يعقوب بن ابراهيم بن سعد، ثنا عمي، ثنا ابي، عن محمد بن اسحاق، عن محمد بن كعب، عن عبد الله بن شداد: " {لتكون لمن خلفك اية} [يونس: ] اي عبرة وبينة انك لم تكن كما تقول لنفسك "
 
  قوله تعالي: {وان كثيرا من الناس عن اياتنا لغافلون} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثنا عطاء بن دينار، عن سعيد بن جبير قوله: " {اياتنا} [يونس: ] يعني: القران "
 
  قوله تعالي: {ولقد بوانا بني اسراءيل مبوا صدق} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة: " {مبوا صدق} [يونس: ] قال: بواهم الله الشام وبيت المقدس "
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا مروان الفزاري، عن جويبر، عن الضحاك قوله: " {مبوا صدق} [يونس: ] قال: منازل صدق مصر والشام "
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، انبا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قوله: " {ولقد بوانا بني اسراءيل مبوا صدق} [يونس: ] قال: الشام وقرا: {الارض التي باركنا فيها للعالمين} [الانبياء: ] "
 
  قوله تعالي: {ورزقناهم من الطيبات} [يونس: ] الاية
 
    
 قرات علي محمد بن الفضل، ثنا محمد بن علي، ثنا محمد بن مزاحم، عن بكير بن معروف، عن مقاتل بن حيان قوله: " {الطيبات} [يونس: ] قال: الطيبات: ما حل لهم من كل شء ان يصيبوه، وهو الحلال من الرزق "
 
  قوله تعالي: {فان كنت في شك مما انزلنا اليك فاسال الذين يقرءون الكتاب من قبلك}
 
    
 حدثنا ابي، ثنا ابو محمد اليماني بمصر جارا اي ابي صالح، ثنا النضر بن محمد الجرشي، ثنا عكرمة بن عمار، حدثني ابو زميل سماك الحنفي، ثنا ابن عباس وقلت له: اني اجد في نفسي شيءا لا استطيع ان اتكلم به، قال: لعله شك او شء من شك، قلت: نعم، قال: ما نجي من هذا احد حتي نزل علي النبي صلي الله عليه وسلم: {فان كنت في شك مما انزلنا اليك فاسال الذين يقرءون الكتاب من قبلك} ثم قال اذا وجدت من ذلك فقل: هو الاول والاخر والظاهر والباطن
 
 حدثنا علي بن الحسين، ثنا محمد بن العلاء ثنا سعيد بن شرحبيل، ثنا هشيم، عن ابي بشر، عن سعيد بن جبير، عن ابن عباس في قوله: " {فان كنت في شك مما انزلنا اليك} [يونس: ] قال: لم يشك رسول الله ولم يسال "
 
  قوله: {فاسال الذين يقرءون الكتاب من قبلك}
 
    
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، ثنا عبيد بن سليمان، عن الضحاك قوله: " {فاسال الذين يقرءون الكتاب من قبلك} يعني: اهل التقوي واهل الايمان ممن ادرك النبي صلي الله عليه وسلم "
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم، في قول الله: " {فان كنت في شك مما انزلنا اليك فاسال الذين يقرءون الكتاب من قبلك} قال: هو عبد الله بن سلام رضي الله عنه كان من اهل الكتاب وامن برسول الله صلي الله عليه وسلم "
 
  قوله تعالي: {لقد جاءك الحق من ربك فلا تكونن من الممترين} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا محمد بن خلف، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية قال: " قال الله تعالي لنبيه صلي الله عليه وسلم: {لقد جاءك الحق من ربك فلا تكونن من الممترين} [يونس: ] يقول: فلا تكونن في شك من ذلك "
 
  قوله تعالي: {ولا تكونن من الذين كذبوا بايات الله} [يونس: ] الاية
 
    
 اخبرنا احمد بن عثمان بن حكيم فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي قوله: " {بايات الله} [يونس: ] اما بايات: محمد صلي الله عليه وسلم "
 
  قوله تعالي: {ان الذين حقت عليهم كلمة ربك لا يءمنون}
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: " {حقت عليهم كلمة ربك} يقول: سبقت كلمة ربك "
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة: {ان الذين حقت عليهم كلمة ربك لا يءمنون} «حق عليهم سخط الله بما عصوه»
 
  قوله تعالي: {ولو جاءتهم كل اية حتي يروا العذاب الاليم} [يونس: ] قد تقدم تفسيره
 
  قوله تعالي: {فلولا} 
 [البقرة: ]
 
    
 حدثنا موسي بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك قوله: " {فلولا كانت قرية امنت فنفعها ايمانها} [يونس: ] يقول: فما كانت قرية امنت فنفعها ايمانها "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح عن مجاهد قوله: " {فلولا كانت قرية امنت} [يونس: ] قال فلم تكن قرية امنت "
 
    
 حدثنا ابي، ثنا علي بن نصر، ثنا عبيد بن عقل، ثنا سهل، عن ابن كثير: " {فلولا كانت قرية امنت} [يونس: ] اي: فلم تكن قرية امنت الا قوم يونس ويوسف "
 
  قوله تعالي: {كانت قرية امنت} 
 [يونس: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: " {فلولا كانت قرية امنت فنفعها ايمانها} [يونس: ] قال: كان يونس بن متي عليه السلام من انبياء الله عز وجل بعثه الله الي قرية يقال لها نينوي علي شاطء دجلة "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق: «وكان من حديث يونس بن متي فيها بلغني ان الله تبارك وتعالي بعثه الي اهل قرية اهل نينوي وهي من بلاد الموصل»
 
  قوله تعالي: {امنت فنفعها ايمانها الا قوم يونس} 
 [يونس: ]
 
 حدثنا محمد بن عمار، ثنا هدبة بن خالد، ثنا ابان العطار، ثنا يعلي بن عطاء، ثنا ابو علقمة الهاشمي، او رجل اخر ان علي بن ابي طالب رضي الله عنه قال: " ان الحذر لا يرد القدر، وان الدعاء يرد القدر، وذلك في كتاب الله: {الا قوم يونس لما امنوا كشفنا عنهم} [يونس: ] الاية "
 
 حدثنا ابو سعيد الاشج، ثنا احمد بن الاشقر، عن قيس بن الربيع، عن حجاج، عن عمير بن سعيد، عن علي قال: «تيب علي قوم يونس يوم عاشوراء»
 
    
 حدثنا ابي عبد الله بن رجاء، انبا اسراءيل، عن ابي اسحاق، عن عمرو بن ميمون، ثنا عبد الله بن مسعود «ان يونس النبي صلي الله عليه وسلم وعد قومه العذاب واخبر انه ياتيهم الي ثلاثة ايام ففرقوا بين كل والدة وولدها، ثم خرجوا وصاروا الي الله واستغفروا فكشف الله عنهم العذاب»
 
    
 حدثنا ابو زرعة، ثنا صفوان بن صالح، ثنا الوليد، ثنا خليد، عن قتادة في قول الله: {فلولا كانت قرية امنت فنفعها ايمانها الا قوم يونس لما امنوا كشفنا عنهم} [يونس: ] قال: لم تكن قرية امنت من الامم قبل قوم يونس كفرت، ثم امنت حين عاينت العذاب الا قوم يونس فاستثني الله قوم يونس "
    
 وذكر لنا ان قوم يونس كانوا ببعض ارض الموصل فلما فقدوا نبيهم قذف الله في قلوبهم فلبسوا المسوح واخرجوا المواشي من كل بهيمة وولدها فعجوا الي الله اربعين صباحا فلما عرف الله عز وجل منهم الصدق بقلوبهم والتوبة والندامة علي ما مضي منهم كشف عنهم العذاب بعد ان تدلي عليهم لم يكن بينهم وبين العذاب الا ميل
 
    
 اخبرنا العباس بن الوليد بن مزيد البيروتي قراءة، ثنا محمد بن سعيد بن شابور، اخبرني عثمان بن عطاء، عن ابيه في قول الله: {فلولا كانت قرية امنت فنفعها ايمانها} [يونس: ] «اذ نزل بها باس الله ولم نفعل ذلك بقرية الا قرية يونس»
 
  قوله تعالي: {كشفنا عنهم عذاب الخزي في الحياة الدنيا} 
 [يونس: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق، عن يزيد بن زياد الهاشمي، عن عبد الله بن ابي سلمة، عن سعيد بن جبير، عن ابن عباس قال: " بعثه الله الي اهل قرية، فردوا عليه ما جاءهم به فامتنعوا منه، فلما فعلوا ذلك اوصي الله اليه اني مرسل عليهم العذاب في يوم كذا، فاخرج من بين اظهرهم، فاعلم قومه الذي وعده الله من عذابه اياهم فقالوا: ارمقوه فان هو خرج من بين اظهركم فهو والله كاءن ما وعدكم، فلما كانت الليلة التي وعدوا العذاب في
  [ص: ]
 صبيحتها اندلج فراه القوم فحذروا، فخرجوا من القرية الي براز بين اراضيهم، وفرقوا بين كل دابة وولدها، ثم عجوا الي الله، وانابوا واستقالوا فاقالهم وانتظر يونس الخبر عن القرية واهلها حتي مر به مار فقال: ما فعل اهل القرية قال: فعلوا ان نبيهم لما خرج من بين اظهرهم عرفوا انه قد صدقهم ما وعدهم من العذاب فخرجوا من قريتهم الي براز من الارض ثم فرقوا بين كل ذات والد وولدها ثم عجوا الي الله وتابوا اليه فقبل منهم واخر عنهم العذاب "
 
    
 حدثنا ابي، ثنا عبد الله بن ابي زياد القطوني، ثنا سيار بن حاتم، ثنا صالح المري، عن ابي عمران الجوني، عن ابي الجلد قال: " ان العذاب لما هبط علي قوم يونس جعل يحور علي رءوسهم مثل قطع الليل المظلم فمشي ذو العقول منهم الي شيخ من علماءهم فقالوا: انا قد نزل بنا ما تري، فعلمنا دعاء ندعو الله به عسي ان يرفع عنا عقوبته قال: قولوا يا حي، يا حي، ويا حي محيي الموتي، ويا حي لا اله الا انت، فكشف عنهم العذاب "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو نعيم، عن اسماعيل بن عبد الملك، عن سعيد بن جبير قال: «غشي قوم يونس العذاب كما يغشي الثوب بالقبر»
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد بن مسلم، ثنا خليل بن علج، حدثني معروف الموصلي «ان سحابة غشيتهم تنضح عليهم شرر النار»
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا خليد، عن قتادة: " {كشفنا عنهم عذاب الخزي} [يونس: ] قال: كشف عنهم العذاب بعد ان تدلي عليهم لم يكن بينهم وبين العذاب الا ميل "
 
  قوله تعالي: {ومتعناهم الي حين} 
 [يونس: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله بن موسي، ثنا اسراءيل، عن السدي، عن عكرمة، عن ابن عباس: " {ومتعناهم الي حين} [يونس: ] قال: الحياة "
 
    
 حدثنا ابي، ثنا محمد بن حاتم الزمي، ثنا عبيدة بن حميد، عن عمار الدهني، عن حميد المدني، عن كريب مولي ابن عباس، عن ابن عباس، قوله تعالي: " {الي حين} [يونس: ] قال: حتي نصير الي الجنة او الي النار "
 
 حدثنا عبد الله بن احمد الدشتكي، ثنا ابي، حدثني ابي، عن ابيه، عن ابراهيم الصاءغ، عن يزيد النحوي قال: قال عكرمة " {الي حين} [يونس: ] قال: الحين: الذي لا يدرك "
 
  قوله تعالي: {متعناهم الي حين} 
 [يونس: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو نعيم، عن سفيان، عن عاصم، عن ابي رزين، عن ابن عباس قال: " الحين حينان، فحين يعرف وحين لا يعرف، فاما الذي لا يعرف: {ولتعلمن نباه بعد حين} [ص: ] "
 
    
 حدثنا عبد الله بن سليمان بن الاشعث، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي يقول: " {فامنوا فمتعناهم الي حين} [الصافات: ] يقول: الي اجلهم "
 
  قوله تعالي: {ولو شاء ربك لامن من في الارض كلهم جميعا} [يونس: ] الاية
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني ابن لهيعة، ثنا عطاء بن دينار، عن سعيد بن جبير في قول الله: " {مءمنين} [يونس: ] يقول: مصدقين "
 
  قوله تعالي: {وما كان لنفس ان تءمن الا باذن الله} [يونس: ] الاية
 
    
 حدثنا ابي، ثنا ابو صالح، حدثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: " {حين} [يونس: ] يقول: سخط "
 
  الوجه الثاني
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا عبد الله بن لهيعة، ثنا عطاء بن دينار، عن سعيد بن جبير " قوله: {الرجس} [يونس: ] يعني: اثما "
 
  الوجه الثالث
 
 ذكر حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد " {الرجس} [يونس: ] ما لا خير فيه "
 
  الوجه الرابع
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد، عن قتادة: " {ويجعل الرجس علي الذين لا يعقلون} [يونس: ] قال: الرجس: الشيطان "
 
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قول الله: " {رجس من عمل الشيطان} [الماءدة: ] قال: الرجس: الشر من عمل الشيطان "
 
  قوله تعالي: {قل انظروا ماذا في السموات والارض}
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: " {لا يءمنون} [يونس: ] قال: اوجب عليهم انهم لا يءمنون "
 
  قوله تعالي: {فهل ينتظرون الا مثل ايام الذين خلوا من قبلهم} 
 [يونس: ]
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد، " عن قتادة: {فهل ينتظرون الا مثل ايام الذين خلوا من قبلهم} [يونس: ] اي مثل قوم نوح وعاد وثمود: {قل فانتظروا اني معكم من المنتظرين} [يونس: ] "
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن الدشتكي السعدي، ثنا عبد الله بن ابي جعفر هو المراري، عن الربيع في قوله: " {فهل ينتظرون الا مثل ايام الذين خلوا من قبلهم قل فانتظروا اني معكم من المنتظرين} [يونس: ] : خوفهم عذابه وعقوبته ونقمته "
 
  قوله تعالي: {ثم ننجي رسلنا والذين امنوا كذلك} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا احمد بن عبد الرحمن، ثنا عبد الله بن ابي جعفر، عن ابيه، عن الربيع بن انس قال: ثم اخبرهم " انه اذا وقع من ذلك امر نجي الله رسله والذين امنوا فقال: {ثم ننجي رسلنا والذين امنوا كذلك حقا علينا ننجي المءمنين} "
 
  قوله تعالي: {قل يا ايها الناس ان كنتم في شك من ديني} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا ابن ابي عمر، ثنا سفيان، عن خلف بن حوشب قال: كان مع الربيع بن ابي راشد فسمع رجلا يقرا: " {قل يا ايها الناس ان كنتم في شك من ديني فانا خلقناكم من تراب} قال: لولا اني اخالف من كان قبلي ما زالت مسكني حتي اموت "
 
  قوله تعالي: {فلا اعبد الذين تعبدون من دون الله} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة قوله: " {من دون الله} [البقرة: ] قال: الوثن "
 
 قوله تعالي: {ولكن اعبد
  [ص: ]
 الله الذي يتوفاكم} [يونس: ]
 
    
 حدثنا ابو عبد الله محمد بن حماد الطهراني، ثنا حفص بن عمر، ثنا الحكم بن ابان، عن عكرمة في قوله: " {يتوفاكم} [يونس: ] قال: يتوفي الانفس "
 
  قوله تعالي: {وان اقم وجهك للدين حنيفا} [يونس: ] قد تقدم تفسيره غير مرة
 
    
 حدثنا محمد بن يحيي، انبا العباس بن الوليد، ثنا يزيد بن زريع، عن سعيد، عن قتادة قوله: " {حنيفا} [البقرة: ] قال: الحنفية: الختان، وتحرم الامهات والبنات، والعمات، والخالات، ما حرم الله والمناسك "
 
  قوله: {ولا تدع من دون الله ما لا ينفعك ولا يضرك} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: " ما لا ينفعك ولا يضرك قال: الاوثان "
 
  قوله تعالي: {فان فعلت فانك اذا من الظالمين} 
 [يونس: ]
 
    
 قرات علي محمد بن الفضل، ثنا محمد بن علي، ثنا محمد بن مزاحم، ثنا بكير بن معروف، عن مقاتل بن حيان قوله: " {الظالمين} [يونس: ] يعني: المشركين "
 
  قوله تعالي: {وان يمسسك الله بضر فلا كاشف له الا هو} 
 [الانعام: ]
 
    
 حدثنا الحسين بن الحسن، ثنا ابراهيم بن عبد الله الهروي، ثنا حجاج، عن ابن جريج، عن مجاهد قوله: " {وان يمسسك الله بضر فلا كاشف له الا هو وان يردك بخير فلا راد لفضله} [يونس: ] : هو الحق "
 
  قوله تعالي: {يصيب به من يشاء من عباده وهو الغفور الرحيم} 
 [يونس: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله، حدثني ابن لهيعة، ثنا عطاء، عن سعيد بن جبير قوله: " {الغفور} [يونس: ] يعني: غفور الذنوب رحيم يعني: رحيما بالمءمنين "
 
  قوله تعالي: {قل يا ايها الناس قد جاءكم الحق من ربكم} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا الحسن بن الربيع، ثنا عبد الله بن ادريس، ثنا محمد بن اسحاق " {الحق من ربك} [البقرة: ] قال: ما جاءك من الخير "
 
  قوله تعالي: {فمن اهتدي فانما يهتدي لنفسه ومن ضل فانما يضل عليها وما انا عليكم بوكيل} 
 [يونس: ]
 
    
 اخبرنا احمد بن عثمان بن حكيم فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي قوله: " {عليكم بوكيل} [الانعام: ] اما الوكيل فالحفيظ "
 
  قوله تعالي: {واتبع ما يوحي اليك واصبر حتي يحكم الله وهو خير الحاكمين} 
 [يونس: ]
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قول الله: " {وهو خير الحاكمين} [يونس: ] قال: هذا منسوخ حتي يحكم الله بجهادهم وامره بالغلظة عليهم
 
  سورة هود
 
  تفسير السورة التي يذكر فيها هود صلي الله عليه وسلم بسم الله الرحمن الرحيم
 
  قوله تعالي: {الر} 
 [يونس: ]
 
    
 حدثنا ابي، ثنا ابو عمارة، ثنا شريك، عن عطاء بن الساءب، قال شريك: لا اراه الا عن ابي الضحي يعني مسلم بن صبيح، عن ابن عباس: " {الر} [هود: ] قال: انا الله اري " وروي عن الضحاك مثله
 
  الوجه الثاني
 
    
 حدثنا علي بن الحسين، ثنا هدبة بن عبد الوهاب، ثنا علي بن الحسين بن واقد، عن ابيه، عن يزيد النحوي، عن عكرمة، عن ابن عباس " {الر} [هود: ] حروف الرحمن معروفة " فحدثت به الاعمش فقال: عندك مثل هذا ولا تخبرنا وروي عن سالم بن عبد الله انه قال: {الر} [هود: ] {حم} [فصلت: ] {ن} [القلم: ] اسم الرحمن مقطع
 
  الوجه الثالث
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة: " {الر} [يوسف: ] قال: من اسماء القران "
 
  والوجه الرابع
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا يحيي بن ابي زاءدة، قال ابن جريج، قال مجاهد: " {الر} [يوسف: ] ، قال: هذه فواتح يفتح الله بها القران " قال: قلت: {الر} [يوسف: ] لم تكن تقل هي اسماء قال: لا
 
  قوله تعالي: {كتاب احكمت اياته} 
 [هود: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبد الحميد الحماني ابو يحيي، عن ابي بكر الهذلي، عن الحسن: " {الر كتاب احكمت اياته} [هود: ] قال: احكمت بالامر والنهي "
 
  الوجه الثاني
 
    
 حدثنا ابو زرعة، ثنا صفوان بن صالح، ثنا سعيد، وخليد، عن قتادة في قول الله: " {كتاب احكمت اياته} [هود: ] قال: احكمه الله من الباطل ثم فصله "
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ قال: سمعت عبد الرحمن بن زيد بن اسلم قرا: " {الر كتاب احكمت اياته} [هود: ] قال: هي كلها محكمة يعني: سورة هود "
 
  قوله تعالي: {ثم فصلت} 
 [هود: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد في قوله: " {ثم فصلت} [هود: ] يقول: فسرت "
 
  والوجه الثاني
 
 حدثنا ابو سعيد الاشج، ثنا عبد الحميد الحماني، عن ابي بكر الهذلي، عن الحسن: " {ثم فصلت} [هود: ] قال: بالوعد والوعيد "
 
 حدثنا ابي، ثنا محمد بن ابي عمر العدني، ثنا سفيان، عن رجل، عن الحسن: " {فصلت} [هود: ] قال: بالثواب والعقاب "
 
  الوجه الثالث
 
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد، وخليد، عن قتادة في قول الله: " {كتاب احكمت اياته ثم فصلت من لدن حكيم خبير} [هود: ] قال: ثم فصلت بعلمه فبين حلاله من حرامه، وطاعته من معصيته "
 
  والوجه الرابع
 
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم يعني: قوله: " {فصلت} [هود: ] قال: ثم ذكر محمدا صلي الله عليه وسلم، فحكم فيها بينه وبين من خالفه، وقرا: {مثل الفريقين} [هود: ] الاية كلها ثم ذكر قوم نوح فقال وعذبهم بعد طول نظره، ثم هودا وقرا: {نجينا هودا والذين امنوا معه برحمة منا} [هود: ] فكان هذا تفصيل ذلك وكان اوله محكما " قال: وكان ابي يقول ذلك يعني: زيد بن اسلم
 
  قوله تعالي: {من لدن} 
 [هود: ]
 
 حدثنا محمد بن يحيي، ثنا ابو غسان زنيج، ثنا سلمة قال: يعني محمد بن اسحاق ثنا محمد بن جعفر بن الزبير قوله: " {حكيم} [هود: ] قال: حكيم في عذره وحجته الي عباده "
 
  قوله تعالي: {خبير} 
 [البقرة: ]
 
 حدثنا محمد بن يحيي، ثنا العباس بن الوليد النرسي، ثنا يزيد بن زريع، عن سعيد، عن قتادة قوله: " {حكيم خبير} [هود: ] قال: خبير بخلقه "
 
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع عن ابي العالية قوله: " {حكيم} [هود: ] قال: حكيم في امره "
 
  قوله تعالي: {الا تعبدوا الا الله انني لكم منه نذير وبشير} 
 [هود: ]
 
 حدثنا ابو سعيد الاشج، ثنا ابن نمير ثنا الاعمش، عن عمرو بن مرة، عن سعيد بن جبير، عن ابن عباس قال: قال رسول الله صلي الله عليه وسلم: " يا بني عبد المطلب، يا بني فهر، يا بني لءي ارايتم لو اخبرتكم ان خيلا بسفح هذا الجبل تريد ان تغير عليكم صدقتموني قالوا: نعم قال: فاني نذير لكم بين يدي عذاب شديد "
 
 حدثنا ابي، ثنا عبد الرحمن بن صالح، ثنا عبد الرحمن بن محمد بن عبد الله الفزاري، عن شيبان النحوي، اخبرني قتادة، عن عكرمة، عن ابن عباس قال: " نذير من النار وبشير قال: مبشر بالجنة "
 
  قوله تعالي: {وان استغفروا ربكم ثم توبوا اليه} 
 [هود: ]
 
 حدثنا ابي، ثنا عمر، عن ابن موسي الطرسوسي، ثنا عبد الصمد بن يزيد قال: سمعت الفضيل يقول: " قول العبد: استغفر الله قال: تفسيره: اقبلني "
 
  قوله تعالي: {يمتعكم} 
 [هود: ]
 
    
 ذكره ابي قال: ذكر عن ابي كدينة، عن عطاء بن الساءب، عن سعيد بن جبير، عن ابن عباس: " {يمتعكم متاعا حسنا} [هود: ] قال: يمتعكم في الدنيا "
 
    
 حدثنا عبد الله بن سليمان بن الاشعث، ثنا الحسين بن علي بن مهران، ثنا عامر بن الفرات، عن اسباط، عن السدي، عن ابي مالك، وابي صالح عن ابن عباس، وعن مرة الهمذاني عن ابن مسعود " {يمتعكم متاعا حسنا} [هود: ] يقول: يمتعكم في الدنيا "
 
  قوله تعالي: {متاعا حسنا} 
 [هود: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة: " {يمتعكم متاعا حسنا} [هود: ] فانتم في ذلك المتاع فخذوه بطاعة الله، ومعرفة حقه فان الله منعم يحب الشاكرين، واهل الشكر في مزيد من الله، وذلك قضاءه الذي قضاه "
 
  قوله تعالي: {الي اجل مسمي} 
 [البقرة: ]
 
 حدثنا حجاج بن حمزة، ثنا يحيي بن ادم، ثنا اسراءيل، عن عطاء بن الساءب، عن سعيد بن جبير في قوله: " {اجل مسمي} [هود: ] قال: الي يوم القيامة " وروي عن عكرمة، وعطية، وعطاء الخراساني، والسدي، والربيع بن انس نحو ذلك
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: " {اجل مسمي} [البقرة: ] قال: اجل الساعة "
 
 اخبرنا محمد بن سعد العوفي فيما كتب الي، حدثني ابي، ثنا عمي، عن ابيه، عن عطية، عن ابن عباس قوله: " {اجل مسمي} [البقرة: ] فهو اجل موت الانسان "
 
    
 حدثنا محمد بن يحيي، ثنا العباس بن الوليد، ثنا يزيد بن زريع، ثنا سعيد، عن قتادة قوله: " {اجل} [هود: ] منتهي يقول: اجل حياتك الي ان تموت، واجل موتك الي ان تبعث، فانت بين اجلين من الله " وروي عن خالد بن مهران انه قال: اجل البعث، وعن الحسن ما بين ان يخلق الي ان يموت
 
    
 حدثنا يونس بن حبيب، ثنا ابو داود، عن قيس، عن ابي حصين، عن سعيد بن جبير، عن ابن عباس في قول الله: " {اجل مسمي} [البقرة: ] قال: لا يعلمه الا الله "
 
  قوله تعالي: {ويءت كل ذي فضل فضله} 
 [هود: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة: " {ويءت كل ذي فضل فضله} [هود: ] اي: في الاخرة "
 
  والوجه الثاني
 
 حدثنا حجاج بن حمزة، ثنا شبابة، عن ورقاء، عن ابن ابي نجيح، عن مجاهد: " {ويءت كل ذي فضل فضله} [هود: ] ما احتسب به من مال او عمل بيده، او رجله، او كلامه، وما تطول به من امره كله "
 
  قوله تعالي: {وان تولوا} 
 [البقرة: ]
 
    
 حدثنا ابي ثنا ابو صالح، حدثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس: " {وان تولوا} [البقرة: ] يعني: الكفار، عن النبي صلي الله عليه وسلم: وهذه في المءمنين "
 
  قوله تعالي: {فاني اخاف عليكم عذاب يوم كبير} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: " {عذاب} [هود: ] يقول: نكال "
 
  قوله تعالي: {الي الله مرجعكم} 
 [الماءدة: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا زيد بن الحباب، عن ابي سنان، عن الضحاك في قوله: " {الي الله مرجعكم} [الماءدة: ] قال: البر والفاجر "
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو جعفر، عن الربيع، عن ابي العالية يعني: قوله: " {الي الله مرجعكم} [الماءدة: ] قال: يرجعون اليه بعد الحياة "
 
  قوله تعالي: {وهو علي كل شء قدير} 
 [الماءدة: ]
 
    
 حدثنا محمد بن العباس، ثنا محمد بن عمرو زنيج، ثنا، سلمة قال: قال محمد بن اسحاق: " {وهو علي كل شء قدير} [هود: ] اي: ان الله علي كل ما اراد بعباده من نقمة او عفو قدير "
 
  قوله تعالي: {الا انهم يثنون صدورهم} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابن ابي سريج، ثنا ابو اسامة، عن ابن جريج، عن محمد بن عباد قال: سمعت ابن عباس يقول: " {الا انهم يثنون صدورهم} [هود: ] قال: كانوا لا ياتون النساء ولا الغاءط وهم يفضون الي السماء يتغشون فيما فنزلت هذه الاية "
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: " {الا انهم يثنون صدورهم} [هود: ] يقول: يكنون "
 
    
 اخبرنا محمد بن سعد فيما كتب الي، حدثني ابي، ثنا عمي، ثنا ابي، عن ابيه، عن ابن عباس قوله: " {الا انهم يثنون صدورهم} [هود: ] يقول: يكتمون ما في قلوبهم "
 
  الوجه الثاني
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، قال: اخبرت عن عكرمة، ان ابن عباس قال: " {الا انهم يثنون صدورهم} [هود: ] الشك في الله وعمل السيءات "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: " {يثنون صدورهم} [هود: ] : تضيق شكا وامتراء في الحق "
 
    
 حدثنا ابي، ثنا عمرو بن عون، ثنا هشيم، عن حصين قال: سمعت عبد الله بن شداد في قوله: " {الا انهم يثنون صدورهم} [هود: ] قال: كان اذا مر برسول الله صلي الله عليه وسلم غطي راسه وثني صدره لانه لا يراه "
 
    
 اخبرنا العباس بن الوليد النرسي قراءة، اخبرني محمد بن شعيب بن شابور، اخبرني عثمان بن عطاء، عن ابيه: عطاء بن ابي مسلم الخراساني: " اما يثنون صدورهم فيقال: يطاطءون رءوسهم ويحنون صدورهم "
 
    
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، عن عبيد بن سليمان، عن الضحاك في قوله: " {الا انهم يثنون صدورهم} [هود: ] يقول: تلتوي صدورهم "
 
    
 ذكره ابو زرعة، ثنا نصر بن علي، ثنا ابو هارون النحوي، عن هشام، عن الحسن: " {الا انهم يثنون صدورهم} [هود: ] قال: حديث النفس "
 
  قوله تعالي: {ليستخفوا منه} 
 [هود: ]
 
    
 حدثنا الحسين بن الحسن، ثنا ابراهيم بن عبد الله الهروي، ثنا الحجاج قال: قال ابن جريج: سمعت محمد بن عباد بن جعفر يقول: سمعت ابن عباس يقرا: " {الا انهم يثنون صدورهم} [هود: ] فسالته عنها قال: كان اناس يستحيون ان يتخلوا فيفضوا في السماء، وان يصيبوا نساءهم فيفضوا فنزل ذلك فيهم "
 
  الوجه الثاني
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي
  [ص: ]
 عروبة، عن قتادة قوله: " {الا انهم يثنون صدورهم ليستخفوا منه} [هود: ] قال: كانوا يحنون صدورهم لكي لا يسمعوا كتاب الله، وكما ذكره قال تعالي: {الا حين يستغشون ثيابهم يعلم ما يسرون وما يعلنون} [هود: ] وذلك اخفي ما يكون ابن ادم اذا احني ظهره استفشي ما به واضمر همه في نفسه، فان الله لا يخفي عليه "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسن بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي قوله: " {ليستخفوا منه} [هود: ] ليستتروا "
 
  الوجه الثالث
 
    
 حدثنا ابي، ثنا هوذة بن خليفة، ثنا عوف، عن الحسن في قوله: " {الا انهم يثنون صدورهم ليستخفوا منه} [هود: ] وهو من جهالتهم به "
 
  قوله تعالي: {منه} 
 [البقرة: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: " {ليستخفوا منه} [هود: ] قال: من الله ان استطاعوا "
 
  قوله تعالي: {الا حين يستغشون ثيابهم} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن طلحة، عن ابن عباس قوله: " {يستغشون ثيابهم} [هود: ] يقول: يغطون رءوسهم "
 
 حدثنا ابو سعيد الاشج، ثنا وكيع، عن سفين، عن منصور، عن ابي رزين: " {حين يستغشون ثيابهم} [هود: ] قال: كان يحني ظهره ويتغطي بثوبه "
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي «اما يستغشون ثيابهم فيلبسون ثيابهم استغشوا بها علي رءوسهم»
 
  قوله تعالي: {يعلم ما يسرون وما يعلنون} 
 [البقرة: ]
 
    
 اخبرنا محمد بن سعد العوفي فيما كتب الي، حدثني ابي، ثنا عمي، ثنا ابي، عن ابيه، عن ابن عباس قوله: " {يعلم ما يسرون وما يعلنون} [هود: ] يقول: فاعملوا بالليل والنهار "
 
 حدثنا ابي، ثنا هوذة، ثنا عوف، عن الحسن: " {يعلم ما يسرون وما يعلنون} [هود: ] قال: في ظلمة الليل وفي اجواف بيوتهم "
 
  قوله تعالي: {انه عليم بذات الصدور} 
 [الانفال: ]
 
    
 حدثنا محمد بن العباس، ثنا محمد بن عمرو، ثنا سلمة قال: قال محمد بن اسحاق: " {انه عليم بذات الصدور} [هود: ] اي: لا يخفي عليه ما في صدورهم بما استخفوا به منكم "
 
    
 حدثنا ابي، ثنا هوذة، ثنا عوف، عن الحسن: " {انه عليم بذات الصدور} [هود: ] يعلم تلك الساعة "
 
  قوله تعالي: {وما من دابة في الارض} 
 [الانعام: ]
 
    
 اخبرنا محمد بن سعد فيما كتب الي، ثنا ابي، ثنا عمي، ثنا ابي، عن ابيه، عن ابن عباس قوله: " {وما من دابة في الارض الا علي الله رزقها} [هود: ] يعني: كل دابة " وروي عن الضحاك مثل ذلك
 
  قوله تعالي: {الا علي الله رزقها} 
 [هود: ]
 
    
 حدثنا الحسين بن الحسن، ثنا ابراهيم بن عبد الله الهروي، ثنا حجاج، عن ابن جريج، عن مجاهد " {وما من دابة في الارض الا علي الله رزقها} [هود: ] ما جاءها من رزق فمن الله وربما لم يرزقها حتي تموت جوعا، ولكن ما كان من رزق لها فمن الله "
 
  قوله تعالي: {ويعلم مستقرها} 
 [هود: ]
 
 حدثنا الحسن بن ابي الربيع، ثنا عبد الرزاق، ثنا ابن التيمي، عن ليث، عن الحكم، عن مقسم، عن ابن عباس يعني: قوله: " {ويعلم مستقرها} [هود: ] قال: مستقرها حيث تاوي "
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: " {ويعلم مستقرها} [هود: ] قال: ياتيها رزقها حين كانت "
 
  الوجه الثاني
 
    
 حدثنا ابو عبد الله محمد بن حماد الطهراني، ثنا حفص بن عمر، ثنا الحكم بن ابان، عن عكرمة، عن ابن عباس قال: " المستقر: ما كان في ارحام النساء " وروي عن ابن مسعود، وقيس بن ابي حاتم، وابي عبد الرحمن السلمي، وعطاء، ومجاهد، والنخعي، والضحاك، وقتادة، والسدي، وعطاء الخراساني نحو ذلك
 
  الوجه الثالث
 
    
 حدثنا الحسن بن ابي الربيع، انبا عبد الرزاق، ثنا ابن عيينة، عن اسماعيل بن ابي خالد، عن ابراهيم قال عبد الله: «مستقرها في الدنيا» قال: ابو محمد: رواه الثقات عن ابي خالد، عن النخعي عن ابن مسعود قال: مستقرها في الرحم
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله بن موسي، عن اسراءيل، عن السدي، عمن حدثه، عن ابن عباس: {يعلم مستقرها} [هود: ] قال: «مستقرها في الارض»
 
  الوجه الرابع
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، واحمد بن بشير، عن اسماعيل بن ابي خالد، عن السدي قال: " المستقر: ما فرغ من حلقه "
 
  الوجه الخامس
 
    
 حدثنا علي بن الحسين، ثنا احمد بن منيع، ثنا هشيم، ثنا منصور، عن الحسن في قوله: {مستقرها} [هود: ] قال: " المستقر: الذي قد مات فاستقر به عمله "
 
  الوجه السادس
 
    
 حدثنا ابي، ثنا محمد بن حاتم المءدب، ثنا يونس بن محمد المءدب، ثنا يعقوب الاشعري القمي، ثنا ابراهيم بن محمد ابن الحنفية، وسالته فقلت: مستقرها قال: «المستقر في اصلاب الرجال»
 
  الوجه السابع
 
    
 حدثنا ابي، ثنا ابن نفيل، ثنا اسماعيل بن علية، ثنا كلثوم بن جبير
  [ص: ]
 ، عن سعيد بن جبير في قوله: {فمستقر} [الانعام: ] قال: «اذا اقروا في ارحام النساء وعلي ظهر الارض او في بطنها فقد استقروا»
 
  قوله تعالي: {ومستودعها} 
 [هود: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبيد الله بن موسي، عن اسراءيل، عن السدي، عن مرة، عن عبد الله: فمستقر، ومستودع قال: " المستودع: المكان الذي يموت فيه وروي عن ابن عباس مثل هذا، وروي عن مجاهد في احد قوليه مثله
 
    
 حدثنا محمد بن عمار بن الحارث، ثنا عبد الرحمن الدشتكي، ثنا ابو جعفر الرازي، عن الربيع بن انس في قوله: {يعلم مستقرها ومستودعها} [هود: ] قال: «مستودعها من حيث تموت ومن حيث تبعث»
 
  الوجه الثامن
 
    
 حدثنا محمد بن حماد الطهراني، ثنا حفص بن عمر العدني، ثنا الحكم بن ابان، عن عكرمة، عن ابن عباس: {ومستودع} [الانعام: ] قال: ما كان في اصلاب الرجال " وروي عن قيس، وسعيد بن جبير، ومجاهد، وابي عبد الرحمن السلمي، وعطاء بن ابي رباح، وابراهيم النخعي، ومحمد بن كعب القرظي، وقتادة، والسدي، والضحاك، وعطاء الخراساني نحو ذلك
 
  الوجه التاسع
 
 حدثنا الحسن بن ابي الربيع، ثنا عبد الرزاق، ثنا ابن عيينة، عن اسماعيل بن ابي خالد، عن ابراهيم قال: قال عبد الله: {ومستودعها} [هود: ] «في الاخرة»
 
  الوجه العاشر
 
    
 حدثنا علي بن الحسين، ثنا احمد بن صنيع، ثنا هشيم، ثنا منصور، عن الحسن " ومستودع قال: الرجل "
 
  الوجه الحادي عشر
 
    
 حدثنا ابي، ثنا محمد بن حاتم، ثنا يونس بن محمد المءدب، ثنا يعقوب
  [ص: ]
 الاشعري القمي، ثنا ابراهيم بن محمد ابن الحنفية، وسالته فقلت: ما معني مستقر ومستودع؟ قال: المستودع: في ارحام النساء وهو احد قولي عطاء بن ابي رباح وقول زيد بن علي بن الحسين
 
  قوله تعالي: {في كتاب مبين} 
 [الانعام: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، عن سعيد، عن قتادة قوله: {في كتاب مبين} [الانعام: ] قال: «كل ذلك في كتاب عند الله مبين»
 
  قوله تعالي: {وهو الذي خلق السموات والارض}
 
    
 حدثنا محمد بن يحيي، ثنا العباس بن الوليد النرسي، ثنا يزيد بن زريع، ثنا سعيد بن عروبة، عن قتادة {خلق السموات والارض} قال: «خلق السماوات قبل الارض»
 
    
 اخبرنا ابو عبد الله محمد بن حماد الطهراني فيما كتب الي، ثنا اسماعيل بن عبد الكريم، اخبرني عبد الصمد بن معقل انه سمع عنه وهب بن منبه يقول: " قال عزير: يا رب امرت الماء فجمد في وسط الهواء، فجعلت منه سبعا، وسميتها السماوات، ثم امرت الماء ينفتق من التراب، وامرت التراب يتميز من الماء، وكان كذلك، فسميت جميع ذلك الارضين، وجميع البحار "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة بن الفضل، ثنا محمد بن اسحاق قال: " ابتدع السماوات والارض، ولم يكونا بقدرته لم يستعن علي ذلك باحد من خلقه، ولم يشرك في شء من امره بسلطانه القاهر، وقوله النافذ الذي يقول به لما اراد ان يكون يقول له: كن فيكون، ففرغ من خلق السماوات والارض في ستة ايام "
 
  قوله تعالي: {في ستة ايام} 
 [الاعراف: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {خلق السموات والارض في ستة ايام} قال: «يوم مقداره الف سنة»
 
  قوله تعالي: {وكان عرشه علي الماء} 
 [هود: ]
 
    
 حدثنا احمد بن سنان، ثنا ابو احمد الزبيري، ثنا سفيان، عن الاعمش، عن ابن عمرو، عن سعيد بن جبير، عن ابن عباس: {وكان عرشه علي الماء} [هود: ] " اي شء كان الماء؟ قال: علي متن الريح "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد في قوله: {وكان عرشه علي الماء} [هود: ] «قبل ان يخلق شيءا»
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد، عن قتادة قوله: {وكان عرشه علي الماء} [هود: ] " ينبءكم تبارك وتعالي: كيف كان بدء خلقه قبل ان يخلق السماوات والارض "
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا عبيد الله بن موسي، عن ابي جعفر الرازي، عن الربيع، عن انس: {وكان عرشه علي الماء} [هود: ] قال: " عرشه علي الماء: فلما خلق السماوات والارض قسم ذلك الماء قسمين الذي كان عليه عرشه، فجعل نصفا تحت العرش، وهو البحر المسجور "
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس «وانما سمي العرش عرشا لارتفاعه»
 
    
 حدثنا حجاج بن حمزة، ثنا ابو اسامة، ثنا اسماعيل بن ابي خالد قال: سمعت سعد الطاءي يقول: «العرش ياقوتة حمراء»
 
 قرء علي بحر بن نصر الخولاني المصري، ثنا اسد بن موسي، ثنا، يوسف بن زياد، عن ابي الياس ابن بنت وهب، عن وهب بن منبه قال: «ان الله خلق العرش من نوره»
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة بن الفضل، ثنا محمد بن اسحاق قال: {وهو الذي خلق السموات والارض في ستة ايام وكان عرشه علي الماء} «فكان كما وصف نفسه تبارك وتعالي انه ليس الا الماء عليه العرش، وعلي العرش ذو الجلال والاكرام، والعزة، والسلطان، والملك والقدرة، والحلم، والعلم، والرحمة، والنقمة، الفعال لما يريد»
 
  قوله تعالي: {ليبلوكم ايكم احسن عملا} 
 [هود: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن المتوكل، ثنا داود، ثنا سعيد بن بشير، عن قتادة: {ليبلوكم} [هود: ] يعني: «ليخبركم»
 
  قوله: {ايكم احسن عملا} 
 [هود: ]
 
    
 اخبرنا علي بن المبارك فيما كتب الي، ثنا زيد بن المبارك، ثنا ابو ثور، عن ابن جريج في قوله: {ليبلوكم} [هود: ] قال: «الثقلين»
 
 حدثنا احمد بن يحيي بن مالك، ثنا داود بن المحبر، ثنا عبد الواحد بن زياد، عن كليب بن واءل، عن ابن عمر ان النبي صلي الله عليه وسلم تلا: {ايكم احسن عملا} [هود: ] ثم قال: «ايكم احسن عقلا واورع عن محارم الله واسرعكم في طاعة الله»
 
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا خالد بن نزار، ثنا فضيل بن عياض، عن ابي عجلان قال: قال الله: " {ليبلوكم ايكم احسن عملا} [هود: ] ولم يقل اكثر عملا "
 
    
 حدثنا علي بن الحسين، ثنا حفص بن عمر المهرقاني، ثنا مءمل بن اسماعيل قال: سمعت سفيان يقول: {ليبلوكم ايكم احسن عملا} [هود: ] «ازهدكم في الدنيا»
 
    
 حدثنا علي بن الحسين، ثنا محمد بن المتوكل، ثنا رواد، ثنا سعيد بن بشير، عن قتادة قوله: {ايكم احسن عملا} [هود: ] يعني: «ايكم اتم عملا»
 
  قوله تعالي: {ولءن قلت انكم مبعوثون من بعد الموت} 
 [هود: ]
 
    
 اخبرنا محمد بن سعد فيما كتب الي، ثنا ابي، ثنا عمي، عن ابيه، عن عطية، عن ابن عباس قوله: {لقال الذين كفروا ان هذا الا سحر مبين} [الانعام: ] «لزادهم تكذيبا»
 
  قوله تعالي: {ولءن اخرنا عنهم العذاب} [هود: ] قال: قال اخرنا اي: امسكنا
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قوله: {العذاب} [هود: ] قال: «نكال»
 
  قوله تعالي: {الي امة معدودة} 
 [هود: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو نعيم، عن سفيان ح. وثنا احمد بن سنان، ثنا عبد الرحمن، عن سفيان، عن عاصم، عن ابي رزين، عن ابن عباس: {ولءن اخرنا عنهم العذاب الي امة معدودة} [هود: ] قال: «الي اجل معدود»
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {امة معدودة} [هود: ] قال: «الي حين»
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة {ولءن اخرنا عنهم العذاب الي امة معدودة} [هود: ] يعني بذلك: " اهل النفاق ويقول: {ولءن اخرنا عنهم العذاب الي امة معدودة ليقولن ما يحبسه} [هود: ] قال: الله: {الا يوم ياتيهم ليس مصروفا عنهم} [هود: ] الاية "
 
  قوله تعالي: {ليقولن ما يحبسه} 
 [هود: ]
 
    
 اخبرنا علي بن المبارك باسناده المعروف عن ابن جريج قوله: {ليقولن ما يحبسه} [هود: ] قال: قال اخرون: " ليقولن ما يحبسه للتكذيب وانه ليس بشء بقوله: {الا يوم ياتيهم ليس مصروفا عنهم وحاق بهم ما كانوا به يستهزءون} "
 
    
 اخبرنا احمد بن عثمان بن حكيم فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي قوله: {وحاق بهم ما كانوا به يستهزءون} [الزمر: ] ويقول: «وقع بهم العذاب الذي استهزءوا به»
 
  قوله تعالي: {ولءن اذقنا الانسان منا رحمة ثم نزعناها منه انه ليءوس كفور} 
 [هود: ]
 
    
 اخبرنا علي بن المبارك فيما كتب الي باسناده المذكور عن ابن جريج في قوله: {ولءن اذقنا الانسان منا رحمة ثم نزعناها منه انه ليءوس كفور} [هود: ] يا ابن ادم «اما كانت نعمة من الله عز وجل من السعة والامن والعافية فكفور لما بك منها، واذا نزعت منك يبتغي بك فراغك وعملك، فيءوس من روح الله قنوط من رحمته كذلك اي المنافق والكافر يءوس ان يرجع ما كان به منها، كفور لما كان به»
 
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة، قوله: {انه ليءوس كفور} [هود: ] يقول: «اذا ابتلي ببلاء ثم لم يصبر عليه»
 
  قوله تعالي: {ولءن اذقناه نعماء بعد ضراء مسته ليقولن ذهب السيءات عني انه لفرح فخور} [هود: ] اي ان عليه اخذ ذلك بفرح
 
  قوله تعالي: {الا الذين صبروا وعملوا الصالحات} 
 [هود: ]
 
    
 اخبرنا ابن المبارك باسناده المعروف عن ابن جريج في قوله عز وجل: {الا الذين صبروا} [هود: ] يقول: «عند البلاء»
 
    
 وبه عن ابن جريج في قوله: {وعملوا الصالحات} [هود: ] «عند النعمة»
 
    
 حدثنا ابي، ثنا احمد بن اسماعيل بن ابي ضرار، ثنا اسماعيل بن ابي اويس، ثنا عبد الله بن نافع الصايغ، عن عاصم بن عمر، عن زيد بن اسلم: {وعملوا الصالحات} [هود: ] «رسول الله صلي الله عليه وسلم واصحابه رضي الله عنهم»
 
  قوله تعالي: {اولءك لهم مغفرة} 
 [هود: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة: {اولءك لهم مغفرة} [هود: ] يقول: «مغفرة لذنوبهم»
 
  قوله تعالي: {واجر كبير} 
 [هود: ]
 
    
 وبه عن قتادة قوله: {واجر كبير} [هود: ] «لحسناتهم وهي الجنة»
 
  قوله تعالي: {فلعلك تارك بعض ما يوحي اليك} [هود: ] الي قوله {نذير} 
 [الماءدة: ]
 
    
 اخبرنا علي بن المبارك باسناده المعروف عن ابن جريج في قوله: {فلعلك تارك بعض ما يوحي اليك} [هود: ] «ان تفعل فيه كما امرت وتدعو اليه كما ارسلت»
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن نمير، ثنا الاعمش، عن عمرو بن مرة، عن سعيد بن جبير، عن ابن عباس قال: قال رسول الله صلي الله عليه وسلم: يا بني عبد المطلب، يا بني فهر، يا بني لءي ارايتم لو اخبرتكم ان خيلا بسفح هذا الجبل تريد ان تغير عليكم صدقتموني؟ " قالوا: نعم قال: «فاني نذير لكم بين يدي عذاب شديد»
 
 حدثنا ابي، ثنا عبد الرحمن بن صالح، ثنا عبد الرحمن بن محمد بن عبد الله الفزاري، عن شيبان النحوي، اخبرني قتادة، عن عكرمة، عن ابن عباس قال: «نذير من الناس»
 
  قوله تعالي: {علي كل شء وكيل} 
 [الانعام: ]
 
    
 اخبرنا احمد بن عثمان فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي قوله: {وكيل} [هود: ] " اما الوكيل: فالحفيظ "
 
  قوله تعالي: {ام يقولون افتراه قل فاتوا بعشر سور مثله مفتريات} [هود: ] اخبرنا علي بن المبارك فيما كتب الي باسناده، عن ابن جريج {ام يقولون افتراه} [يونس: ] قد قالوا {قل فاتوا بعشر سور مثله} 
 [هود: ] "
 
    
 حدثنا الحسن بن محمد بن الصباح، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد {سور مثله} [هود: ] قال: «مثل القران»
 
    
 حدثنا ابو زرعة، ثنا العباس بن الوليد النرسي، ثنا يزيد بن زريع، ثنا سعيد بن ابي عروبة، عن قتادة قوله: {سور مثله مفتريات} [هود: ] قال: «مثل هذا القران حقا وصدقا لا باطل فيه ولا كذب»
 
    
 حدثنا الحسن بن احمد، ثنا ابراهيم بن عبد الله بن يسار، ثنا سرور بن المغيرة، عن عباد بن منصور، عن الحسن في قوله: {سور مثله} [هود: ] قال: «فلا يستطيعون والله ان ياتوا بسورة من مثله، ولو حرصوا»
 
  قوله تعالي: {وادعوا من استطعتم من دون الله ان كنتم صادقين} 
 [يونس: ]
 
    
 حدثنا محمد بن يحيي، ثنا ابو غسان زنيج، ثنا سلمة بن الفضل، عن محمد بن اسحاق قال فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس: {وادعوا من استطعتم} [يونس: ] : «من اعوانكم علي ما انتم عليه ان كنتم صادقين»
 
  قوله تعالي: {فالم يستجيبوا لكم}
 
    
 حدثنا الحسين بن الحسن، ثنا ابراهيم بن عبد الله الهروي، ثنا حجاج، عن ابن جريج، عن مجاهد قال: «الاستجابة الطاعة»
 
  قوله تعالي: {فاعلموا انما انزل بعلم الله وان لا اله الا هو} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: {لا اله الا الله} [هود: ] قال: «توحيد»
 
    
 حدثنا عمر بن يحيي، ثنا ابو غسان، ثنا سلمة قال: قال محمد بن اسحاق: {لا اله الا هو} [البقرة: ] قال: «ليس معه غيره شريكا في امره»
 
  قوله تعالي: {فهل انتم مسلمون} 
 [هود: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد، قوله: {فهل انتم مسلمون} [هود: ] لاصحاب محمد صلي الله عليه وسلم "
 
  قوله تعالي: {من كان يريد الحياة الدنيا} 
 [هود: ]
 
    
 حدثنا ابي ثنا موسي بن اسماعيل، ثنا حماد بن سلمة، عن قتادة، عن انس بن مالك في قوله: {من كان يريد الحياة الدنيا وزينتها نوف اليهم اعمالهم فيها} [هود: ] قال: نزلت في اليهود، والنصاري "
 
    
 اخبرنا العباس بن الوليد بن مزيد قراءة، اخبرني ابن شعيب، اخبرني شيبان بن عبد الرحمن، عن منصور انه حدثهم ثم قال: سالت سعيد بن جبير عن هذه الاية في قول الله تعالي: {من كان يريد الحياة الدنيا وزينتها} [هود: ] قال: " هو الرجل يعمل عمل الدنيا لا يريد بها الله، وهي مثل الاية في الروم: {وما اتيتم من ربا ليربو في اموال الناس فلا يربو عند الله} [الروم: ] "
 
    
 حدثنا ابي، ثنا محمود بن خالد الدمشقي، ثنا ابي، ثنا عيسي بن المسيب، عن جابر بن يزيد الجعفي، عن عبد الله بن معبد قال: قام رجل الي علي فقال: اخبرنا عن هذه الاية؟ {من كان يريد الحياة الدنيا وزينتها} [هود: ] الي قوله: {وباطل ما كانوا يعملون} [الاعراف: ] قال له: «نعم ويحك ذاك من كان يريد الدنيا لا يريد الاخرة»
 
    
 اخبرنا محمد بن سعد العوفي فيما كتب الي، حدثني ابي، ثنا عمي، ثنا ابي، عن ابيه، عن ابن عباس قوله: {من كان يريد الحياة الدنيا وزينتها نوف
  [ص: ]
 اليهم اعمالهم فيها وهم فيها لا يبخسون} [هود: ] " وهي الدنيا يعطيهم الله من الدنيا بحسناتهم، وذلك انهم لا يظلمون نفيرا يقول: من عمل صالحا التماس الدنيا صوما او صلاة او تهجد بالليل لا يعمله الا التماس الدنيا "
 
    
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، ثنا عبيد بن سليمان، عن الضحاك قوله: {من كان يريد الحياة الدنيا وزينتها نوف اليهم اعمالهم فيها وهم فيها لا يبخسون} [هود: ] يقول: " من عمل عملا صالحا يريد به وجه الله في غير تقوي يعني: اهل الشرك اعطي علي ذلك اجرا في الدنيا يصل رحما، يعطي ساءلا، يرحم مضطرا في نحو هذا من اعمال البر يعجل الله له ثواب عمله في الدنيا "
 
    
 حدثنا علي بن الحسين، ثنا محمد بن يسار، ثنا محمد بن جعفر، ثنا شعبة، عن ابي رجاء، عن الحسن: {من كان يريد الحياة الدنيا} [هود: ] قال: «من كان يريد ان يعجل له حسناته»
 
    
 حدثنا ابو سعيد الاشج، ثنا اسماعيل بن علية، عن ابي رجاء، عن الحسن، {من كان يريد الحياة الدنيا وزينتها} [هود: ] قال: «طيباتهم»
 
  قوله تعالي: {نوف اليهم اعمالهم فيها} 
 [هود: ]
 
    
 اخبرنا محمد بن سعد فيما كتب الي، ثنا ابي، ثنا عمي، ثنا ابي، عن ابيه، عن ابن عباس: {نوف اليهم اعمالهم فيها} [هود: ] يقول الله تعالي: «وفيه الذي التمس في الدنيا من المثابة»
 
    
 حدثنا ابو سعيد الاشج، ثنا يحيي بن يمان، عن سفيان، عن عيسي الحرشي، عن مجاهد في قوله: {من كان يريد الحياة الدنيا وزينتها نوف} [هود: ] اليهم اعمالهم فيها قال: «نعجل لمن لا يتقبل منه»
 
    
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، ثنا عبيد بن سليمان، عن الضحاك: {نوف اليهم اعمالهم فيها} [هود: ] يقول: «يعجل الله له ثواب عمله في الدنيا، يوسع عليه في المعيشة والرزق، ويقر عينه فيما حوله ويدفع عنه من مكاره الدنيا في نحو هذا، وليس له في الاخرة من نصيب»
 
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة قوله: {من كان يريد الحياة الدنيا وزينتها نوف اليهم اعمالهم فيها وهم فيها لا يبخسون} [هود: ] يقول: «من كانت الدنيا همه، وطلبه ونيته وحاجته جازاه الله بحسناته في الدنيا، ثم يفض الي الاخرة وليس له فيها حسنة واما المءمن فيجازي بحسناته في الدنيا، ويثاب عليها في الاخرة، وهم فيها لا يبخسون»
 
  قوله تعالي: {وهم فيها لا يبخسون} 
 [هود: ]
 
    
 حدثنا ابي، ثنا هشام به، عن قتادة: {وهم فيها لا يبخسون} [هود: ] يقول: «لا يظلمون»
 
    
 حدثنا علي بن الحسين، ثنا ابو بكر بن ابي شيبة، وعثمان قالا: ثنا معاوية بن هشام، ثنا سفيان، عن عيسي بن ميمون، عن مجاهد: {وهم فيها لا يبخسون} [هود: ] قال: «لا ينقصون»
 
  قوله تعالي: {اولءك الذين ليس لهم في الاخرة الا النار} 
 [هود: ]
 
    
 اخبرنا احمد بن الازهر فيما كتب الي، ثنا وهب بن جرير، ثنا ابي، عن علي بن الحكم، عن الضحاك واما قوله: {اولءك الذين ليس لهم في الاخرة الا النار} [هود: ] يقول: «ما عملوا من عمل صالح في شركهم، عجل الله لهم ثوابه في الدنيا، ولم يكن لهم في الاخرة الا النار»
 
  قوله تعالي: {وحبط} 
 [هود: ]
 
    
 حدثنا موسي بن ابي موسي الخطمي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك: {وحبط} [هود: ] يعني: «بطل»
 
  قوله تعالي: {ما صنعوا فيها} 
 [هود: ]
 
    
 حدثنا عبد الله بن سليمان بن الاشعث، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: {وحبط ما صنعوا فيها} [هود: ] قال: «وحبط ما عملوا من خير»
 
 اخبرنا محمد بن سعد فيما كتب الي، ثنا ابي، ثنا عمي، عن ابيه، عن ابيه، عن ابن عباس قوله: {وحبط ما صنعوا فيها} [هود: ] يقول: «وحبط عمله الذي كان يعمل التماس الدنيا، وهو في الاخرة من الخاسرين»
 
    
 اخبرنا علي بن المبارك باسناده المعروف عن ابن جريج عن ابن عباس: {وحبط ما صنعوا فيها} [هود: ] يقول: «حبط ما صنعوا في الدنيا»
 
  قوله تعالي: {وباطل ما كانوا يعملون} 
 [الاعراف: ]
 
    
 حدثنا عبد الله بن سليمان بن الاشعث، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي: {وباطل ما كانوا يعملون} [الاعراف: ] قال: «وباطل في الاخرة ليس لهم فيها جزاء»
 
 وباسناد ابن المبارك، عن ابن جريج، عن ابن عباس: {وباطل ما كانوا يعملون} [الاعراف: ] : «في الدنيا»
 
  قوله تعالي: {افمن كان علي بينة من ربه} 
 [هود: ]
 
    
 حدثنا كثير بن شهاب، ثنا محمد بن سعيد بن سابق، ثنا ابو جعفر، عن الربيع بن انس، عن ابي العالية في قوله: {افمن كان علي بينة من ربه} [هود: ] قال: «محمد صلي الله عليه وسلم» قال ابو محمد وروي عن ابن عباس، ومحمد بن علي ابن الحنفية، ومجاهد، وابي صالح، وابراهيم، وعكرمة، والضحاك، وقتادة، والسدي، وخصيف وابن عيينة نحو ذلك
 
  الوجه الثاني
 
    
 حدثنا علي بن الحسين، ثنا المقدمي، ثنا عامر بن صالح، عن ابيه، عن الحسن: {افمن كان علي بينة من ربه} [هود: ] قال: «المءمن علي بينة من ربه»
 
  الوجه الثالث
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم يقول في قول الله: {افمن كان علي بينة من ربه} [هود: ] قال: «القران»
 
  قوله تعالي: {ويتلوه شاهد منه} 
 [هود: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو اسامة، عن عوف، عن سليمان العلاف، عن الحسين بن علي: {ويتلوه شاهد منه} [هود: ] يعني: محمدا صلي الله عليه وسلم شاهدا من الله "
 
  الوجه الثاني
 
    
 حدثنا ابي، ثنا عمرو بن علي الباهلي، ثنا محمد بن سواء، ثنا سعيد بن ابي عروبة، عن قتادة، عن عروة، عن محمد بن علي قال: قلت لابي: يا ابه: {ويتلوه شاهد منه} [هود: ] " ان الناس يقولون: انك انت هو قال: وددت اني انا هو، لكنه لسانه " وروي عن الحسن، وقتادة نحو ذلك
 
  الوجه الثالث
 
    
 حدثنا ابي، ثنا ابو الجماهر، ثنا سعيد بن بشر، ثنا عمران يعني: القطان، عن قتادة، عن عكرمة، عن ابن عباس قال " جبريل: يعني: قوله: {ويتلوه شاهد منه} [هود: ] وروي عن ابي العالية، وابي صالح، ومجاهد في احدي الروايات، وابراهيم، وعكرمة، والضحاك، وعطاء الخراساني، وخصيف نحو ذلك
 
    
 اخبرنا محمد بن سعد فيما كتب الي، حدثني عمي، ثنا ابي، عن ابيه، عن ابن عباس قوله: {ويتلوه شاهد منه} [هود: ] «فهو جبريل شاهد من الله بالذي يتلو من كتاب الله الذي انزل علي محمد صلي الله عليه وسلم»
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن ادريس، عن ليث، عن مجاهد في قوله: {ويتلوه شاهد منه} [هود: ] قال " جبريل: تلا التوراة، والانجيل والقران، وهو الشاهد من الله عز وجل "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {ويتلوه شاهد منه} [هود: ] «معه حافظ من الله ملك»
 
  والوجه الرابع
 
    
 ذكر عن الحسين بن يزيد الطحان، ثنا اسحاق بن منصور، ثنا قيس
  [ص: ]
 ، عن الاعمش، عن المنهال، عن عباد بن عبد الله قال: قال علي: " ما في قريش من احد الا وقد نزلت فيه اية مثل ما نزل فيك: قال: {ويتلوه شاهد منه} [هود: ] "
 
  الوجه الخامس
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم يقول في قول الله: {افمن كان علي بينة من ربه ويتلوه شاهد منه} [هود: ] قال: رسول الله صلي الله عليه وسلم كان علي بينة من ربه والقران يتلوه شاهد ايضا لانه من رسول الله صلي الله عليه وسلم "
 
  قوله تعالي: {ومن قبله كتاب موسي اماما ورحمة} 
 [هود: ]
 
    
 حدثنا ابي، ثنا مقاتل بن محمد، ثنا وكيع، عن ابيه، عن منصور، عن ابراهيم في قوله: {كتاب موسي} [هود: ] قال: ومن قبله جاء بالكتاب الي موسي "
 
    
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {ومن قبله كتاب موسي اماما ورحمة} [هود: ] قال: «فمن قبله تلا التوراة علي موسي كما تلا القران علي محمد صلي الله عليه وسلم»
 
  قوله تعالي: {اولءك يءمنون} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا ابن لهيعة، ثنا عطاء بن دينار، عن سعيد بن جبير في قول الله: {ليءمنوا} [الانعام: ] قال: «ليصدقوا»
 
 وبه عن سعيد بن جبير في قوله: {به} [هود: ] يعني: «ليصدقوا بالله تعالي ورسوله»
 
  قوله تعالي: {ومن يكفر به من الاحزاب فالنار موعده} 
 [هود: ]
 
 وباسناد ابن المبارك، عن ابن جريج، في قوله: {ومن يكفر به} [البقرة: ] «بالقران من الاحزاب»
 
    
 حدثنا ابي، ثنا ابو بكر بن بشار يعني: محمدا، ثنا عبد الوهاب الثقفي عن ايوب، عن سعيد بن جبير قال: ما بلغني حديث عن رسول الله صلي الله عليه وسلم علي وجهه الا وجدت مصداقه في كتاب الله عز وجل حتي بلغني انه قال: «لا يسمع بي اي احد من هذه الامة لا يهودي، ولا نصراني، ثم لم يءمن بما ارسلت به الا دخل النار» قال سعيد: فقلت اين هذا في كتاب الله؟ حتي اتيت علي هذه الاية: {ومن يكفر به من الاحزاب فالنار موعده} [هود: ] قال: من اهل الملل كلها
 
 حدثنا ابو زرعة، ثنا صفوان ثنا الوليد، ثنا خليد، وسعيد، عن قتادة في قوله: {ومن يكفر به من الاحزاب} [هود: ] قال: «هم اليهود، والنصاري»
 
  قوله تعالي: {فلا تك في مرية منه انه الحق من ربك} 
 [هود: ]
 
    
 حدثنا ابي، ثنا الحسن بن ابي الربيع، ثنا عبد الله بن ادريس، ثنا محمد بن اسحاق: {الحق من ربك} [البقرة: ] قال: «ما جاءك من الخير»
 
  قوله تعالي: {ومن اظلم ممن افتري علي الله كذبا} 
 [الانعام: ]
 
    
 حدثنا ابو عبد الله محمد بن حماد الطهراني ثنا حفص بن عمر العدني، ثنا الحكم بن ابان، عن عكرمة قال: " قال النضر وهو من بني عبد الدار: اذا كان يوم القيامة شفعت لي اللات والعزي فانزل الله تعالي: {ومن اظلم ممن افتري علي الله كذبا} [الانعام: ] "
 
    
 وباسناد علي بن المبارك، عن ابن جريج: {ومن اظلم ممن افتري علي الله كذبا} [الانعام: ] قال: «هم الكفار والمنافقون»
 
  قوله تعالي: {اولءك يعرضون علي ربهم} 
 [هود: ]
 
    
 حدثنا الحسن بن عرفة، ثنا خالد بن الحارث، عن سعيد بن ابي عروبة، عن قتادة، عن صفوان بن محرز قال: قيل لعبد الله بن عمر كيف سمعت رسول الله صلي الله عليه وسلم يذكر في النجوي؟ فقال: سمعته يقول: " يدنو المءمن من ربه عز وجل يوم القيامة حتي يضع عليه كنفه، ثم يقرءه بذنوبه هل تعرف؟ فيقول: يا رب اعرف حتي اذا بلغ منه ما شاء ان يبلغ يقول له تبارك وتعالي: فاني سترتها عليك في الدنيا، وانا اغفر لك اليوم قال ثم يعطي صحيفة حسابه، او قال: كتابه بيمينه واما الكافر والمنافق فينادي علي رءوس الاشهاد {هءلاء الذين كذبوا علي ربهم الا لعنة الله علي الظالمين} [هود: ] "
 
 وباسناد علي بن المبارك، عن ابن جريج في قوله عز وجل: {اولءك يعرضون علي ربهم} [هود: ] «فيسالهم عن اعمالهم»
 
  قوله تعالي: {ويقول الاشهاد} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد بن لهيعة، عن زيد بن اسلم
  [ص: ]
 يعني: قوله: {ويقول الاشهاد} [هود: ] قال " الاشهاد اربعة: الانبياء والملاءكة والمءمنون والاجساد "
 
    
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، عن عبيد بن سليمان، عن الضحاك قوله: {ويقول الاشهاد} [هود: ] يعني: «الانبياء والرسل»
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {ويقول الاشهاد} [هود: ] قال: «هءلاء الملاءكة يشهدون علي بني ادم باعمالهم»
 
  قوله تعالي: {هءلاء الذين كذبوا علي ربهم} 
 [هود: ]
 
    
 وحدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، عن عبيد بن سليمان، عن الضحاك قوله: {ويقول الاشهاد هءلاء الذين كذبوا علي ربهم} [هود: ] يقولون: «يا ربنا اتيناهم بالحق فكذبوا فنحن نشهد انهم كذبوا عليك يا ربنا»
 
  قوله تعالي: {الا لعنة الله علي الظالمين} 
 [هود: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا يونس بن بكير، ثنا محمد بن اسحاق، ثنا عبد الله بن ابي بكر بن محمد بن عمرو بن حزم، عن ابيه قال: هذا كتاب رسول الله صلي الله عليه وسلم عندنا الذي كتبه لعمرو بن حزم حين بعثه الي اليمن فقال: " ان الله كره الظلم، ونهي عنه، وقال: {الا لعنة الله علي الظالمين} [هود: ] "
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو نعيم، عن سفيان، عن منصور، عن ابراهيم قال: " لعن بعض هءلاء الجبابرة الحجاج او غيره فقال: {الا لعنة الله علي الظالمين} [هود: ] "
 
    
 حدثنا ابي، ثنا صالح بن عبيد الله الهاشمي، ثنا ابو المليح، عن ميمون بن مهران قال: " ان الرجل ليصلي ويلعن نفسه في قراءته فيقول: {الا لعنة الله علي الظالمين} [هود: ] وانه لظالم "
 
  قوله تعالي: {الذين يصدون عن سبيل الله} 
 [الاعراف: ]
 
    
 حدثنا عبد الله بن سليمان بن الاشعث، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي قوله: {الذين يصدون عن سبيل الله} [الاعراف: ] قال: «هو محمد صلي الله عليه وسلم صدت قريش عنه الناس»
 
  قوله: {عن سبيل الله} 
 [البقرة: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس قوله: {يصدون عن سبيل الله} [الاعراف: ] قال: «عن دين الله عز وجل»
 
  قوله تعالي: {ويبغونها عوجا وهم بالاخرة هم كافرون} 
 [هود: ]
 
    
 حدثنا ابو بكر بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابن مالك قوله: {ويبغونها عوجا} [الاعراف: ] يعني: «يرجون بمكة غير الاسلام دينا»
 
    
 حدثنا احمد بن عثمان بن حكيم، ثنا احمد بن المفضل، ثنا اسباط، عن السدي: {ويبغونها عوجا} [الاعراف: ] : كانوا اذا سالهم احد هل تجدون محمدا قالوا: لا، فصدوا عنه الناس وبغوا محمدا عوجا هلاكا "
 
  قوله تعالي: {وهم بالاخرة هم كافرون} 
 [هود: ]
 
    
 حدثنا محمد بن يحيي، ثنا العباس، ثنا يزيد، ثنا سعيد، عن قتادة قوله: {وهم بالاخرة هم كافرون} [هود: ] قال: «لا يءمنون بها»
 
  قوله تعالي: {اولءك لم يكونوا معجزين في الارض} [هود: ] الاية
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {معجزين} [هود: ] قال: «مسابقين»
 
  قوله تعالي: {يضاعف لهم العذاب} 
 [هود: ]
 
    
 حدثنا محمد بن يحيي، ثنا العباس، ثنا يزيد قال: سمعت سعيدا عن قتادة، قوله: {يضاعف لهم العذاب} [هود: ] اي: «عذاب الدنيا والاخرة»
 
  قوله تعالي: {ما كانوا يستطيعون السمع} 
 [هود: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة قوله: {ما كانوا يستطيعون السمع} [هود: ] يقول: «صم عن الحق فلا يسمعونه»
 
  قوله تعالي: {وما كانوا يبصرون} 
 [هود: ]
 
    
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة {ما كانوا يستطيعون السمع وما كانوا يبصرون} [هود: ] قال: «ما كانوا يستطيعون ان يسمعوا خيرا، فينتفعوا به، ولا يبصروا خيرا، فياخذوا به»
 
  قوله تعالي: {اولءك الذين خسروا انفسهم} 
 [هود: ]
 
    
 اخبرنا احمد بن عثمان بن حكيم فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي في قوله عز وجل: {اولءك الذين خسروا انفسهم} [هود: ] قال: «غبنوا انفسهم»
 
  قوله تعالي: {وضل عنهم} 
 [الانعام: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر، عن ابي روق، عن الضحاك، عن ابن عباس قوله: {وضل عنهم} [الانعام: ] قال: «في القيامة»
 
  قوله تعالي: {ما كانوا يفترون} 
 [ال عمران: ]
 
    
 وبه عن ابن عباس: {ما كانوا يفترون} [هود: ] «ما كانوا يكذبون في الدنيا»
 
  الوجه الثاني
 
    
 حدثنا محمد بن يحيي، ثنا العباس، ثنا يزيد، ثنا العباس، ثنا يزيد، ثنا سعيد، عن قتادة قوله: {ما كانوا يفترون} [ال عمران: ] «اي يشركون»
 
  قوله تعالي: {لا جرم انهم في الاخرة هم الاخسرون} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، كاتب الليث، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {لا جرم} [هود: ] يقول: «بلي»
 
  قوله تعالي: {واخبتوا الي ربهم} 
 [هود: ]
 
    
 وبه عن ابن عباس قوله: {واخبتوا} [هود: ] يقول: «خافوا»
 
  والوجه الثاني
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {واخبتوا الي ربهم} [هود: ] قال: «اطمانوا»
 
  الوجه الثالث
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، عن سعيد، عن قتادة قوله: {واخبتوا الي ربهم} [هود: ] يقول: «وانابوا الي ربهم»
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر، عن قتادة، {واخبتوا} [هود: ] قال: " الاخبات: الخشوع والتواضع "
 
  قوله تعالي: {اولءك اصحاب الجنة} 
 [البقرة: ]
 
    
 حدثنا محمد بن يحيي، ثنا ابو غسان، ثنا سلمة قال: قال محمد بن اسحاق، ثنا محمد بن ابي محمد، عن سعيد بن جبير، عن عكرمة، عن ابن عباس قوله: {اولءك اصحاب الجنة} [البقرة: ] اي: «من امن بما كفرتم وعمل بما تركتم من دينه فلهم الجنة خالدين فيها»
 
  قوله تعالي: {هم فيها خالدون} 
 [البقرة: ]
 
    
 وبه عن ابن عباس: {هم فيها خالدون} [هود: ] «فلهم الجنة خالدين فيها، يخبرهم ان الثواب بالخير، والسيء مقيم علي اهله ابدا لا انقطاع له»
 
  قوله تعالي: {مثل الفريقين} 
 [هود: ]
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم قال: " ثم ذكر محمدا صلي الله عليه وسلم فقرا فيما بينه وبين خالقه فقرا: {مثل الفريقين} [هود: ] الاية كلها "
 
    
 حدثنا هشام بن خالد، ثنا شعيب بن اسحاق، عن سعيد، عن قتادة، قوله: {مثل الفريقين} [هود: ] «هذا مثل ضربه الله للكافر والمءمن»
 
  قوله تعالي: {كالاعمي والاصم} 
 [هود: ]
 
    
 وبه عن قتادة قوله: {مثل الفريقين كالاعمي والاصم} [هود: ] «هذا مثل ضربه للكافر، والمءمن، اما الكافر فاصم عن الحق فلا يسمع ولا يبصر، ولا يعقل، ولا ينتفع به»
 
  قوله تعالي: {والبصير والسميع} 
 [هود: ]
 
 وبه عن قتادة قوله: {والبصير والسميع} [هود: ] «اما المءمن فسمع الحق فانتفع به ووعاه وحفظه»
 
  قوله تعالي: {هل يستويان مثلا افلا تذكرون} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا عبد الله بن لهيعة، ثنا عطاء بن دينار، عن سعيد بن جبير قال: «لا يستوي في الفضل»
 
  قوله تعالي: {ولقد ارسلنا نوحا الي قومه} 
 [هود: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا عبد الله، عن اسراءيل، عن السدي، عن ابي صالح: " ارسل: اي بعث "
 
    
 حدثنا ابو زرعة، ثنا ابراهيم بن الفضل بن ابي سويد، ثنا ابو عوانة، عن قتادة، عن انس ان النبي صلي الله عليه وسلم قال: «اول نبي ارسل نوح صلي الله عليه وسلم»
 
  قوله تعالي: {اني لكم نذير مبين} 
 [هود: ]
 
    
 حدثنا ابي، ثنا عبد الرحمن بن صالح، ثنا عبد الرحمن بن محمد بن عبيد الله الفزاري، عن شيبان النحوي، اخبرني قتادة، عن عكرمة، عن ابن عباس لما انزلت {نذير} [هود: ] قال: يعني: النبي صلي الله عليه وسلم انزلت عليه: {مبشرا ونذيرا} [الاسراء: ] قال: «نذير من النار»
 
  قوله تعالي: {ان لا تعبدوا الا الله} 
 [هود: ]
 
    
 حدثنا محمد بن يحيي، ثنا ابو غسان، ثنا سلمة بن الفضل، عن محمد بن اسحاق قال: فيما حدثني محمد بن ابي محمد، عن عكرمة او سعيد بن جبير، عن ابن عباس قوله: {اعبدوا} [الاعراف: ] اي: «وحدوا»
 
    
 حدثنا محمد بن العباس مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة بن الفضل، ثنا محمد بن اسحاق قال: " كان من حديث نوح، وحديث قومه، فيما يذكر اهل العلم انه كان حليما صبورا، لم يلق نبي من قومه من البلاء اكثر مما لقي
  [ص: ]
 الا نبي قتل، وكان يدعوهم كما قال الله تعالي: ليلا ونهارا، وسرا وجهارا بالنصيحة لهم، فلم يزدهم ذلك منه الا فرارا، حتي انه ليكلم الرجل منهم فيلف راسه بثوبه، ويجعل اصابعه في اذنيه لكيلا يسمع شيءا من قوله "
 
  قوله تعالي: {اني اخاف عليكم عذاب يوم اليم} 
 [هود: ]
 
    
 حدثنا عصام بن رواد العسقلاني، ثنا ادم، ثنا ابو جعفر الرازي، عن الربيع بن انس، عن ابي العالية في قوله: {عذاب يوم اليم} [هود: ] قال: " الاليم: الموجع في القران كله " وكذلك فسره سعيد بن جبير، والضحاك، وقتادة، وابو مالك، وابو عمران النحوي، ومقاتل بن حيان
 
  قوله تعالي: {فقال الملا الذين كفروا من قومه ما نراك الا بشرا مثلنا} 
 [هود: ]
 
    
 حدثنا ابو بكر بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، ثنا اسباط، عن السدي، عن ابي مالك قوله: {فقال الملا} [هود: ] يعني: «الاشراف من قومه»
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، ثنا محمد بن اسحاق، عمن لا يتهم، عن عبيد بن عمير الليثي انه كان يحدث انه بلغه " انهم كانوا يبطشون به يعني: نوحا فيخنقونه حتي يغشي عليه، فاذا افاق قال: اللهم اغفر لقومي، فانهم لا يعلمون حتي اذا تمادوا في المعصية، وعظمت فيهم في الارض الخطيءة، وتطاول عليه وعليهم الشان، واشتد عليه منهم البلاء، وانتظر النجل بعد النجل، فلا ياتي قرن الا كان اخبث من الذي قبله، حتي ان كان الاخر منهم ليقول: قد كان هذا مع اباءنا، ومع اجدادنا هذا مجنون لا يقبلون منه شيءا، حتي شكا ذلك من امرهم نوح الي الله عز وجل وقال كما قص الله علينا في كتابه "
 
    
 اخبرنا يونس بن عبد الاعلي قراءة ثنا ابن وهب، ثنا ابن زيد يعني عبد الرحمن قال: «ما عذب قوم نوح، حتي ما كان في الارض سهل، ولا جبل الا له عامر يعمره، وحاءز يحوزه»
 
  قوله تعالي: {بادي الراي} 
 [هود: ]
 
    
 اخبرنا العباس بن الوليد بن مزيد قراءة اخبرني محمد بن شعيب، اخبرني عثمان بن عطاء، عن ابيه قال: واما: {بادي الراي} [هود: ] «فما ظهر لنا»
 
  قوله: {وما نري لكم علينا من فضل} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا عبد الله بن لهيعة، ثنا عطاء بن دينار، عن سعيد بن جبير قوله: {من فضل} [الاعراف: ] يعني: «فضيلة»
 
  قوله تعالي: {ارايتم ان كنت علي بينة} 
 [هود: ]
 
    
 ذكر عن يزيد بن هارون، عن جعفر بن سليمان، سمعت ابا عمران الجوني قرا هذه الاية: {ان كنت علي بينة من ربي} [هود: ] قال: «علي ثقة»
 
    
 وباسناد علي بن المبارك، عن ابن جريج، قوله: {ارايتم ان كنت علي بينة من ربي} [هود: ] «عرفته بها وعرفت بها امره ان لا اله الا هو»
 
  قوله تعالي: {فعميت عليكم} [هود: ] الي قوله: {كارهون} 
 [التوبة: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، عن سعيد، عن قتادة قوله: {ارايتم ان كنت علي بينة من ربي} [هود: ] الي قوله: {انلزمكموها وانتم لها كارهون} [هود: ] «اما والله لو استطاع نبي الله لالزمها قومه ولكنه لم يملك تلك، ولم يملكه»
 
    
 حدثنا محمد بن عبد الله بن يزيد المقرء، ثنا سفيان، عن عمر، وقرا ابن عباس {فعميت عليكم انلزمكموها} [هود: ] «من شطر انفسنا»
 
  قوله: {ان اجري الا علي الله} 
 [يونس: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {ان اجري} [هود: ] : «جزاءي»
 
  قوله تعالي: {انهم ملاقو ربهم} [هود: ] الاية
 
    
 حدثنا ابي، ثنا يحيي بن المغيرة، ثنا جرير، عن يعقوب، عن جعفر، عن سعيد في قوله: {انهم ملاقو ربهم} [هود: ] قال: «الذين شروا انفسهم لله، وطمنوها علي الموت»
 
  قوله تعالي: {ويا قوم من ينصرني من الله ان طردتهم} [هود: ] بياض
 
  قوله تعالي: {ولا اقول لكم عندي خزاءن الله} [هود: ] الي اخر الاية
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قول الله: {ولا اقول للذين تزدري اعينكم} [هود: ] قال: حقرتموهم "
 
  قوله تعالي: {يا نوح قد جادلتنا} [هود: ] الاية
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {جادلتنا} [هود: ] «ماديتنا»
 
  قوله تعالي: {وما انتم بمعجزين} 
 [الانعام: ]
 
    
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {بمعجزين} [هود: ] قال: «بمسابقين»
 
  قوله: {ولا ينفعكم نصحي ان اردت ان انصح لكم ان كان الله يريد} [هود: ] الاية
 
    
 حدثنا عصام بن رواد، ثنا ادم ثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية: {اليه ترجعون} [البقرة: ] قال: «اليه يرجعون بعد الحياة»
 
  قوله تعالي: {اجرامي} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد، عن قتادة في قوله تعالي: {فعلي اجرامي} [هود: ] يقول: «فعلي عملي»
 
  قوله تعالي: {وانا برء مما تجرمون} 
 [هود: ]
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة قوله: {وانا برء مما تجرمون} [هود: ] اي «مما تعملون»
 
  قوله تعالي: {واوحي الي نوح} [هود: ] الاية
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة قوله: {واوحي الي نوح انه لن يءمن من قومك الا من قد امن} [هود: ] " وذلك حين دعا عليهم نوح، قال: {رب لا تذر علي الارض من الكافرين ديارا} [نوح: ] "
 
    
 حدثنا ابي، ثنا عوف بن محمد ابو غسان المرادي، ثنا محمد بن مسلم الطنافسي، عن ايوب بن موسي، عن محمد بن كعب، قال: " لما استنقذ الله من اصلاب الرجال وارحام النساء كل مءمن ومءمنة قال: يا نوح {لن يءمن من قومك الا من قد امن فلا تبتءس بما كانوا يفعلون} [هود: ] "
 
  قوله تعالي: {فلا تبتءس} 
 [هود: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {فلا تبتءس} [هود: ] : «فلا تحزن»
 
    
 وباسناد العوفي المشهور وابن عباس قوله: {فلا تبتءس} [هود: ] يقول: لا تحزن ولا تياس
 
  قوله تعالي: {واصنع الفلك} 
 [هود: ]
 
    
 اخبرنا محمد بن سعد فيما كتب الي، حدثني ابي، ثنا عمي، ثنا ابي، عن ابيه، عن ابن عباس قوله: {واصنع الفلك باعيننا ووحينا} [هود: ] «وذلك انه لم يعلم كيف صنعة الفلك، فاوحي الله عز وجل اليه ان يصنعها علي مثل جءجء الطاءر»
 
  قوله تعالي: {الفلك} 
 [الاعراف: ]
 
 حدثنا المنذر بن شاذان، ثنا يعلي، ثنا اسماعيل بن ابي خالد، عن ابي صالح، في قوله: {الفلك} [هود: ] قال: سفينة نوح "
 
    
 حدثنا علي بن الحسين، ثنا عثمان بن ابي شيبة، ثنا شاذان، عن حماد بن سلمة، عن علي بن زيد، عن يوسف بن مهران، عن ابن عباس قال: «كان طول سفينة نوح اربعماءة ذراع وطولها في السماء ثلاثون ذراعا»
 
    
 حدثنا ابي ثنا سليمان بن حرب ثنا جرير بن حازم عن الحسن قال: كان طول سفينة نوح ستماءة ذراع وارتفاعها ثلاثون ذراعا وعرضها ثلاثماءة ذراع وكان بابها في جنبها
 
 حدثنا ابي، ثنا ابو نفيل، ثنا عتاب، عن خصيف «ان سفينة نوح كانت من خشب وكانت ثلاثة ابيات، وكان طول السفينة ثلاثماءة ذراع، وعرضها خمسون ذراعا، وطول الابيات الثلاثة من اسفل الي فوق ثلاثون ذراعا كل بيت منها عشرة اذرع، وكانت مغطاة اعلاها واسفلها الا بابا يدخل منه كل شء، ثم ردمه»
 
    
 حدثنا ابي، ثنا عبد الله بن عمر القراريدي، ثنا نوح بن قيس، عن محمد بن سيف ابو رجاء، عن الحسن قال: «كان طول سفينة نوح الفا وماءة ذراع، وعرضها ستماءة ذراع، وكانت مطبقة»
 
 حدثنا ابي، ثنا موسي بن ايوب النصيبي، ثنا مخلد بن حسين، عن عوف، عن الحسن قال: «كان طول سفينة نوح الفي ذراع، وعرضها ماءة ذراع»
 
  قوله تعالي: {باعيننا} 
 [هود: ]
 
    
 حدثنا محمد بن عبد الله بن المبارك، ثنا حجاج بن محمد، عن ابن ابي نجيح، عن عطاء الخراساني، عن ابن عباس: {واصنع الفلك باعيننا} [هود: ] قال: «بعين الله ووحيه»
 
  قوله تعالي: {ووحينا} 
 [هود: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {ووحينا} [هود: ] «كما نامرك»
 
    
 حدثنا ابي، ثنا عبيد بن ادم، ثنا ابي شعيب ابو شيبة، عن عطاء الخراساني في قوله: {ووحينا} [هود: ] اي «بوحي الله»
 
    
 حدثنا ابي، ثنا محمود بن خالد، ثنا عمر بن عبد الواحد، عن عثمان بن عطاء، عن ابيه، واما قوله {باعيننا ووحينا} [هود: ] فيقال «بعين الله ورحمته»
 
  قوله تعالي: {ولا تخاطبني في الذين ظلموا انهم مغرقون} 
 [هود: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق " فلما شكي ذلك منهم نوح الي الله عز وجل، واستنصر عليهم، اوحي الله اليه: ان {اصنع الفلك باعيننا ووحينا ولا تخاطبني في الذين ظلموا} [هود: ] اي بعد اليوم انهم مغرقون "
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة قوله: {ولا تخاطبني في الذين ظلموا انهم مغرقون} [هود: ] قال: «نهي الله عز وجل نوحا عليه السلام ان يراجعه في احد»
 
  قوله تعالي: {ويصنع الفلك} 
 [هود: ]
 
    
 اخبرنا يونس بن عبد الاعلي قراءة ثنا ابن وهب، ثنا مالك، عن زيد بن اسلم، «ان نوحا عليه السلام مكث يغرس الشجر ويقطعها وييبسها، ثم ماءة عام يعملها»
 
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا ابن وهب، اخبرني ابن لهيعة، عن خالد بن يزيد، عن سعيد بن ابي هلال، عن ابي سهل، عن تبيع، عن كعب الاحبار انه قال " لما استنفذ الله من في الاصلاب، والارحام من المءمنين والكافرين، اوحي الي نوح انه {لن يءمن من قومك الا من قد امن} [هود: ] فاصنع الفلك، قال: يا رب ما انا بنجار، قال: بلي، فان ذلك بعيني، خذ القادوم، فجعلت يده لا تخطء، فجعلوا يمرون به ويقولون: هذا الذي يزعم انه نبي قد صار نجارا، فعملها اربعين سنة "
 
  قوله تعالي: {وكلما مر عليه ملا من قومه سخروا منه} 
 [هود: ]
 
    
 حدثنا ابي، ثنا سعيد بن الحكم بن ابي مريم، ثنا موسي بن يعقوب الزمعي، عن فاءد، مولي عبيد الله بن ابي رافع، ان ابراهيم بن عبد الرحمن بن ابي ربيعة، اخبره ان عاءشة زوج النبي صلي الله عليه وسلم اخبرته ان رسول الله صلي الله عليه وسلم قال: «لو رحم الله عز وجل من قوم نوح احدا، لرحم ام الصبي» قال رسول الله صلي الله عليه وسلم: " كان نوح مكث في قومه الف سنة وغرس ماءة سنة الشجر فعظمت، وذهب كل مذهب ثم قطعها، ثم جعلها سفينة ويمرون عليه، فيسخرون منه، ويقولون: يعمل سفينة في البر، فكيف تجري؟ قال: سوف تعلمون، فلما فرغ ونبع الماء وصار في السكك خشيت ام الصبي عليه، وكانت تحبه حبا شديدا، فخرجت الي الجبل حتي بلغت ثلثه، فلما صار الماء علي الجبل فلما بلغها الماء خرجت به حتي استوت علي الجبل، فلما بلغ الماء رقبتها دفعته بيدها فرقا فلو رحم الله عز وجل منهم احدا لرحم ام الصبي "
 
  قوله تعالي: {قال: ان تسخروا منا فانا نسخر منكم} [هود: ] الاية
 
    
 حدثنا ابي، ثنا ابو تقي هشام بن عبد الملك، ثنا بقية، حدثتني ام عبد الله يعني بنت خالد بن معدان، عن ابيها قال: يقال: " الذين يسخرون من الناس في الدنيا ادخلوا الجنة، فاذا اتوها ردوا وقيل لهم: سخر بكم كما كنتم تسخرون بالناس في الدنيا "
 
  قوله تعالي: {من ياتيه عذاب يخزيه} 
 [هود: ]
 
    
 حدثنا ابو عبد الله الطهراني، ثنا حفص العدني، ثنا الحكم بن ابان، عن عكرمة في قوله: {من ياتيه عذاب يخزيه} [هود: ] قال: «الغرق»
 
 قوله تعالي
  [ص: ]
 : {ويحل عليه عذاب مقيم} [هود: ]
 
    
 حدثنا موسي بن ابي موسي الخطبي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، ثنا اسباط، عن السدي، عن ابي مالك قوله: {عذاب مقيم} [الماءدة: ] يعني: «داءما لا ينقطع»
 
    
 حدثنا ابو عبد الله الطهراني، ثنا حفص العدني، ثنا الحكم بن ابان، عن عكرمة {ويحل عليه عذاب مقيم} [هود: ] قال ": جهنم "
 
  قوله تعالي: {حتي اذا جاء امرنا} 
 [هود: ]
 
    
 حدثنا ابي، ثنا عثمان بن حفص بن عمر بن سليمان الضبي الذراع، ثنا سلمة بن علقمة، ثنا داود بن ابي هند، عن مطرف بن عبد الله بن الشخير في قوله: {حتي اذا جاء امرنا وفار التنور} [هود: ] قال: «كانت علامة بينه وبين ربه اذا رايت التنور يفور بالماء، فاحمل فيها من كل زوجين اثنين»
 
  قوله تعالي: {وفار التنور} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس، قوله: {وفار التنور} [هود: ] يقول: «نبع الماء»
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {وفار التنور} [هود: ] «الماء منه»
 
    
 حدثنا ابي، ثنا عبد الله بن رجاء، ثنا اسراءيل، عن مسلم، عن محمد بن علي قال: «فار التنور من مسجد الكوفة من قبل ابواب كندة» وروي عن حذيفة، والشعبي، ومجاهد نحو ذلك وقد روي عن علي
 
  الوجه الثاني
 
    
 حدثنا ابي، ثنا عمرو الناقد، ثنا محمد بن فضيل بن عزوان، ثنا عبد الرحمن بن اسحاق، عن زياد مولي ابي جحيفة، عن ابي جحيفة، عن علي في قوله: {حتي اذا جاء امرنا وفار التنور} [هود: ] قال: «تنوير الصبح»
 
  الوجه الثالث
 
    
 حدثنا ابي، ثنا يعقوب الدورقي، ثنا هشيم، عن العوام بن حوشب، عن الضحاك، عن ابن عباس في قوله: {وفار التنور} [هود: ] قال: " التنور وجه الارض قيل له اذا رايت الماء علي وجه الارض، فاركب انت ومن اتبعك، قال: العرب تسمي وجه الارض: تنور الارض " وروي عن عكرمة انه قال وجه الارض
 
  الوجه الرابع
 
    
 حدثنا ابي، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة، عن عكرمة، عن ابن عباس في قوله: {وفار التنور} [هود: ] العين التي بالجزيرة عين الوردة "
 
    
 حدثنا علي بن الحسن الهسنجاني، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة قوله: {وفار التنور} [هود: ] قال: «فيفور التنور علم بين نوح وربه، والتنور اشرف الارض واعلاها عين بالجزيرة عين الوردة»
 
  الوجه الخامس
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا ابو يحيي الحماني، عن نصر بن ابي عمر، عن عكرمة، عن ابن عباس في قوله: {وفار التنور} [هود: ] قال: بالهند "
 
  الوجه السادس
 
    
 اخبرنا محمد بن سعد فيما كتب الي، ثنا ابي، ثنا عمي، ثنا ابي، عن ابيه، عن ابن عباس قوله: {وفار التنور} [هود: ] قال: «اذا رايت تنور اهلك يخرج منه الماء فانه هلاك قومك»
 
    
 حدثنا ابي، ثنا سهل بن عثمان، ثنا محبوب القواريري، عن طلحة قال: سمعت عطاء يقول: " بلغني ان نوحا عليه السلام قال لجاريته: اذا فار تنورك ماء فاخبريني قال عطاء: بلغني انها لما فرغت من اخر خبزها فار التنور، فذهبت الي سيدها، فاخبرته فركب هو ومن معه في اعلي السفينة، وفتح الله السماء بماء منهمر، وفجر الارض عيونا "
 
  قوله تعالي: {قلنا احمل فيها من كل زوجين اثنين} 
 [هود: ]
 
    
 حدثنا ابي، ثنا المءمل بن اهاب، ثنا زيد بن حباب، ثنا حسين بن واقد، عن ابي نهيك، عن ابن عباس قال: «كان مع نوح في السفينة ثمانون رجلا احدهم جرهم»
 
    
 حدثنا محمد بن يحيي، ثنا علي بن عثمان، ثنا داود بن ابي الفرات، عن علباء بن احمر، عن عكرمة، عن ابن عباس قال: «كان مع نوح في السفينة ثمانون رجلا منهم اهلوهم، وانهم كانوا في السفينة ماءة وخمسين يوما»
 
    
 حدثنا ابو عبد الله محمد بن حماد الطهراني ثنا حفص بن عمر، عن الحكم، عن عكرمة في قوله: {احمل فيها من كل زوجين اثنين} [هود: ] " خلقته ذكرا وانثي قال: الذكر زوج، والانثي زوج "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {من كل زوجين اثنين} [هود: ] «ذكر وانثي من كل صنف»
 
    
 حدثنا حماد بن الحسن بن عنبسة، ثنا ابو داود، ثنا مبارك، عن عبد الله بن مسلم بن يسار، عن ابيه: {من كل زوجين اثنين} [هود: ] قال: " امر نوح عليه السلام ان يحمل معه من كل زوجين اثنين، وملك معه، فجعل يقبض زوجا زوجا، وبقي العنب، فجاء ابليس فقال هذا كله لي، فنظر نوح الي الملك فقال: انه شريكك فاحسن شركته فقال لي النصف، وله النصف قال ابليس: هذا كله لي فنظر الي الملك فقال: انه شريكك فاحسن شركته قال: نعم لي الثلث وله الثلثان قال: اخفت وانت بحساب انك تاكله عنبا وتاكله ذبيبا وتشربه عصيرا ثلاثة ايام " قال: مسلم: فكانوا يرون انه اذا شربه كذلك، فليس للشيطان فيه نصيب "
 
    
 حدثنا ابو سعيد الاشج، عن ابي معاوية، عن ابن ابي خالد، عن ابي عبيدة قال: «لما امر نوح عليه السلام ان يحمل معه في السفينة من كل زوجين اثنين لم يستطع يحمل معه الاسد حتي القيت عليه الحمي فحمله فادخله»
 
    
 حدثنا ابي، ثنا بشر بن ادم، ثنا عفان بن مسلم، ثنا مبارك، قال: سمعت بكرا يقول: «لما حمل نوح الاسد في السفينة اشتهي اللحم فزاد مخافة اهل السفينة، فشكوا ذلك الي نوح، فدعا عليه، فالقيت عليه الحمي فمر به نوح»
 
 حدثنا ابي، ثنا ابو صالح كاتب الليث، ثنا الليث، ثنا همام بن سعيد، عن زيد بن اسلم، عن ابيه، ان رسول الله صلي الله عليه وسلم قال: " لما حمل نوح في السفينة من كل زوجين اثنين، قال اصحابه: وكيف نطمان او تطمءن المواشي، ومعنا الاسد فسلط الله عليه الحمي، فكانت اول حمي نزلت في الارض ثم شكوا الفارة فقالوا الفويسقة تفسد علينا طعامنا ومتاعنا، فاوحي الله الي الاسد فعطس، فخرجت الهرة، فتخبات الفارة منها
 
    
 حدثنا احمد بن عصام، ثنا ابو احمد الزبيري، ثنا سفيان، عن علي بن زيد بن جدعان، عن يوسف بن مهران، عن ابن عباس قال: «لما كان نوح في السفينة قرط الفار حبال السفينة فشكي ذلك، فاوحي اليه فمسح ذنب الاسد فخرج سنوران، وكان في السفينة عذرة فشكي فاوحي اليه فمسح ذنب الفيل، فخرج خنزيران»
 
  قوله تعالي: {واهلك} 
 [هود: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة قوله: {واهلك} [هود: ] ذكر لنا انه لم ينج ممن في السفينة الا نوح، وثلاثة بنين له ونساءهم فجمعهم ثمانية "
 
 حدثنا ابي، ثنا احمد بن هاشم الرملي، ثنا ضمرة بن ربيعة، عن مطر قال: «كان في السفينة سبعة نوح وثلاثة اولاده وكنانيه ثلاثة»
 
  قوله تعالي: {الا من سبق عليه القول} 
 [هود: ]
 
    
 حدثنا علي بن الحسين ابو الجماهر، ثنا سعيد بن بشير، عن قتادة قوله: {واهلك الا من سبق عليه القول} [هود: ] : «انه مغرق»
 
  قوله تعالي: {ومن امن وما امن معه الا قليل} 
 [هود: ]
 
    
 حدثنا العباس بن يزيد العبدي، ثنا يزيد بن زريع، عن سعيد بن ابي عروبة، عن قتادة، عن الحسن، عن سمرة ان رسول الله صلي الله عليه وسلم قال: «سام ابو العرب وويغث ابو الروم وحام ابو الحبش»
 
    
 حدثنا ابو سعيد الاشج، ثنا ابن ابي غنية، عن ابيه، عن الحكم: {ومن امن وما امن معه الا قليل} [هود: ] قال: كان نوح وثلاثة بنيه واربع كنانيه "
 
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا ابن وهب، اخبرني ابن لهيعة، عن خالد بن يزيد، عن سعيد بن ابي هلال، عن تبيع، عن كعب الاحبار انه قال: «والمءمنون يومءذ اثنان وسبعون، فارسل الله الماء من السماء وفتح الارض»
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا ابن وهب، عن ابن زيد بن اسلم، عن ابيه «انه كان مع نوح يوم اغرق قومه ثمانون من اهل الايمان»
 
  قوله تعالي: {وقال اركبوا فيها} 
 [هود: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد الازرق، ثنا الوليد بن مسلم، عن سعيد، عن قتادة قال: «ركب في السفينة في عشر خلت من رجب، ونزل عنها في عشر خلت من المحرم، فصام هو واهله من الليل الي الليل»
 
    
 حدثنا علي بن الحسين، ثنا اسحاق بن ابراهيم، ثنا هشام بن يوسف، ثنا ابن جريج، في حديث محمد بن عباد بن جعفر: {وقال اركبوا فيها} [هود: ] ان ابا صالح، اخبره ان نوحا عليه السلام حمل معه بنيه الثلاثة، وامراة نوح، والثلاثة نسوة نساء بنيه الثلاث، فهم ثمانية وازواجهم، فاسماء بنيه يافث، وحام، وسام، فاصاب حام امراته في السفينة فدعا نوح ان يغير لطفته فجاء السودان "
 
    
 حدثنا محمد بن يحيي، ثنا علي بن عثمان ثنا داود بن ابي الفرات، عن علباء بن احمر، عن عكرمة، عن ابن عباس قال: «كان مع نوح في السفينة ثمانون رجلا معهم اهلوههم، وانهم كانوا في السفينة ماءة وخمسين يوما وان الله وجه السفينة الي مكة فدارت بالبيت اربعين يوما، ثم وجهها الي الجودي، فاستقرت عليه فبعث نوح الغراب لياتيه بخبر الارض، فذهب فوقع علي الجيف فابطا عليه فبعث الحمامة، فاتته بورق الزيتون، ولطخت رجلها بالطين فعرف نوح ان الماء قد نضب، فهبط الي اسفل الجودي فبني قرية وسماها ثمانين، فاصبحوا ذات يوم وقد تبلبلت السنتهم علي ثمانين لغة احدها اللسان العربي فكان لا يفقه بعضهم كلام بعض، وكان نوح عليه السلام يعبر عنهم»
 
  قوله تعالي: {بسم الله} 
 [الفاتحة: ]
 
    
 حدثنا عصام بن رواد، ثنا ادم، ثنا ابو هلال الراسي، ثنا حيان الاعرج، عن ابي الشعثاء جابر بن زيد قوله: {بسم الله} [الفاتحة: ] قال: «اسم الله الاعظم هو الله، الا تري انه في جميع القران يبدا قبل كل اسم»
 
    
 حدثنا ابي، ثنا محمد بن عبد الرحمن بن بنت عبد الملك بن ابي سليمان، ثنا ابي، عن جويبر، عن الضحاك في قوله: {بسم الله} [الفاتحة: ] قال: «الباء من بهاء الله، والسين من سناء الله، والميم من ملك الله، والله يا اله الخلق»
 
    
 حدثنا ابو هارون الخزاز، ثنا علي بن الجهم، ثنا عمر بن ابي قيس، عن عاصم، عن الشعبي قال: " كتب رسول الله صلي الله عليه وسلم اربعة كتب اولها باسمك اللهم قال: فنزلت سورة هود: {بسم الله مجراها ومرساها} [هود: ] "
 
  قوله تعالي: {بسم الله مجراها ومرساها} 
 [هود: ]
 
    
 حدثنا ابي، ثنا سلمة بن بشير النيسابوري سنة اثني عشر وماءتين، ثنا يحيي، عن جابر، عن ابي روق، عن الضحاك في قوله: {بسم الله مجراها ومرساها} [هود: ] قال: " كان اذا ارد ان تجري قال: بسم الله مجراها جرت واذا اراد ان تقف قال: بسم الله مرساها وقفت "
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {بسم الله} [الفاتحة: ] «حين تركبون يعني مجراها ومرساها حين تجرون»
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير قال: " اذا ركبت في السفينة تذكر نعمة الله، وان شاء قال: كما قال نوح صلي الله عليه وسلم: {بسم الله مجراها ومرساها ان ربي لغفور رحيم} [هود: ] فمن ركب دابة لم يذكر اسم الله جاء الشيطان فيقول: تغني فان لم يتغني يقول له: تمشي "
 
    
 حدثنا ابي، ثنا عمرو بن رافع، ثنا محمد بن عبيد، عن توبة ابي سالم قال: رايت زر بن حبيش يصلي في الزاوية حين تدخل من ابواب كندة عن يمينك فسالته انك لكثير الصلاة يوم الجمعة قال: «بلغني ان سفينة نوح ارسيت من ها هنا»
 
  قوله تعالي: {ان ربي لغفور رحيم} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، حدثني عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير، قوله: {غفور رحيم} [البقرة: ] «لما كان منهم في الشرك، رحيم بهم بعد التوبة»
 
  قوله تعالي: {وهي تجري بهم في موج كالجبال} 
 [هود: ]
 
    
 حدثنا علي بن الحسين ابو الجماهر، ثنا ابن وهب، اخبرني ابن لهيعة، عن خالد بن يزيد، عن سعيد بن ابي هلال، عن ابي سهل، عن تبيع انه قال: «لما استنفذ من في الاصلاب والارحام من المءمنين والكافرين اوحي الله عز وجل الي نوح ان لو كنت اريد ان ارحم من قومك احدا اذا لرحمت المراة وولدها، فهاجت به الفلك ما بين المشرق والمغرب، فمرت بالطور، فنقرت علي الجبل»
 
  قوله تعالي: {ونادي نوح ابنه وكان في معزل} 
 [هود: ]
 
    
 حدثنا الحسن بن ابي الربيع، ثنا عبد الرزاق، انبا معمر، عن قتادة، وغيره عن عكرمة، عن ابن عباس يعني: قوله: {ونادي نوح ابنه} [هود: ] قال: «ابنه غير انه خالفه في العمل والنية»
 
    
 حدثنا الحسن بن ابي الربيع، ثنا عبد الرزاق، ثنا الثوري، عن ابي عامر الهمداني، عن الضحاك بن مزاحم، عن ابن عباس قال: «ما بعث امراة نبي قط» وروي عن عكرمة، ومجاهد، وسعيد بن جبير، والضحاك انه ابنه
 
  الوجه الثاني
 
    
 حدثنا ابو سعيد الاشج، ثنا عقبة بن خالد، ثنا اسراءيل، عن جابر، عن محمد بن علي، {ونادي نوح ابنه} [هود: ] قال: " يعني بلغة طيء: ابن امراته "
 
  الوجه الثالث
 
    
 حدثنا ابو زرعة، ثنا صفوان بن صالح، ثنا الوليد، ثنا خليد، وسعيد، عن قتادة، عن الحسن قال: «ليس بابنه»
 
    
 حدثنا الحسن بن عرفة، ثنا علي بن ثابت الجزري، عن جعفر بن برقان، عن ثابت بن الحجاج الكلابي في قول الله: {ونادي نوح ابنه} [هود: ] قال: «ولد علي فراشه»
 
 حدثنا ابي، ثنا عبد الحميد المعني، ثنا ابو زيد عبد الرحمن بن مصعب المعني، عن سفيان، عن ليث، عن مجاهد قال: «كل نبي ابو امته»
 
    
 حدثنا علي بن الحسن، ثنا ابو الجماهر، ثنا سعيد قال: قال عن قتادة: «كان اسم ابن نوح الذي غرق كنعان»
 
  قوله تعالي: {يا بني اركب معنا ولا تكن مع الكافرين} 
 [هود: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي قوله: {يا بني اركب معنا ولا تكن مع الكافرين} [هود: ] قال: " نادي نوح الغلام، وكان قد ولد علي فراشه وكان نوح ظن انه ابنه، فناداه نوح: يا بني اركب معنا ولا تكن مع الكافرين، ولا يعلم نوح الا انه ابنه، وكان ولده، وكان كافرا "
 
  قوله تعالي: {قال ساوي الي جبل يعصمني من الماء} 
 [هود: ]
 
    
 حدثنا ابي، ثنا عبيد بن ادم، ثنا ابي، ثنا ابو شيبة، عن عطاء الخراساني في قوله: {ساوي الي جبل يعصمني من الماء} [هود: ] يقول: «الجبل يعصمني»
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق " اذا كان فظن ان ذلك لما كان يكون قوله تعالي: {لا عاصم اليوم من امر الله الا من رحم} [هود: ] "
 
    
 حدثنا ابو عبد الله الطبراني، ثنا حفص بن عمر العدني، عن الحكم بن ابان، عن عكرمة في قوله: {لا عاصم اليوم من امر الله الا من رحم} [هود: ] قال: «لا ناج الا اهل السفينة»
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي: {ساوي الي جبل يعصمني من الماء} [هود: ] " فقال نوح: {لا عاصم اليوم من امر الله الا من رحم} [هود: ] ، ففتح الله عليه السماء "
 
  قوله تعالي: {وحال بينهما الموج} 
 [هود: ]
 
    
 حدثنا ابي، ثنا سليمان بن عبد الجبار، ثنا ابو عاصم، عن المثني بن الصباح، عن القسم بن ابي مرة: {وحال بينهما الموج} [هود: ] قال: «بين نوح وبين الجبل»
 
  قوله تعالي: {فكان من المغرقين} 
 [هود: ]
 
    
 حدثنا ابي، ثنا سهل بن غياث، ثنا حفص بن عثمان، عن الاعمش، عن مجاهد قال: " لما اصاب قوم نوح الغرق قال: قام الماء علي راس كل جبل خمسة عشر راسا قال: اصاب الغرق امراة فيمن اصاب لها صبي، فوضعته علي صدرها فلما بلغها الماء وضعته علي منكبيها، فلما بلغها الماء وضعته علي يديها قال: فقال تبارك وتعالي: لو رحمت احدا من اهل الارض لرحمتها "
 
    
 حدثنا ابي، ثنا نصر بن علي، ثنا نوح بن قيس، عن عون بن ابي شراد قال: «اغرق الماء الجبال فوقها ثمانين ميلا»
 
  قوله تعالي: {وقيل يا ارض ابلعي ماءك} 
 [هود: ]
 
 حدثنا ابي، ثنا محمد بن عباد المزني، ثنا عبد الله بن سنان، عن نوح بن المختار، عن ابي سعيد، {وغيض} [هود: ] قال: خرجت اريد ان اشرب ماء، فمررت بالفرات، فاذا الحسن، والحسين فقالا: يا ابا سعيد اين تريد؟ قلت: اشرب ماء المر قال: لا تشرب ماء المر، فانه لما كان زمن الطوفان امر الله الارض ان تبلع ماءها وامر السماء ان تقلع فاستعصي علي بعض البقاع فلعنه فصار ماءه مرا وترابه سبخا لا ينبت شيءا "
 
    
 اخبرنا ابو عبد الله الطهراني فيما كتب الي، ثنا اسماعيل بن عبد الكريم، حدثني عبد الصمد بن معقل قال: سمعت وهب بن منبه: {وقيل يا ارض ابلعي ماءك} [هود: ] " يقول بالحبشية: ازرديه "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا ابن ابي عروبة، عن قتادة، قوله: {يا ارض ابلعي ماءك} [هود: ] يقول: «ابلعي ما كان عليك»
 
    
 حدثنا ابي، ثنا ابو صالح، حدثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {ويا سماء اقلعي} [هود: ] يقول: «اسكني» وروي عن قتادة نحو ذلك "
 
  قوله تعالي: {وغيض الماء} 
 [هود: ]
 
    
 وبه عن ابن عباس قوله: {وغيض الماء} [هود: ] يقول: «ذهب الماء» وروي عن قتادة نحو ذلك
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {وغيض الماء} [هود: ] : «نقص» وروي عن عطاء الخراساني مثله
 
  قوله تعالي: {وقضي الامر} 
 [البقرة: ]
 
    
 وبه عن مجاهد قوله: {وقضي الامر} [البقرة: ] قال: «هلك قوم نوح»
 
  قوله تعالي: {واستوت علي الجودي} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا خليد، عن قتادة يعني قوله: {واستوت علي الجودي} [هود: ] «فاستقرت علي الجودي شهرا»
 
  قوله تعالي: {الجودي} 
 [هود: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {واستوت علي الجودي} [هود: ] قوله: " {الجودي} [هود: ] جبل بالجزيرة تشامخت الجبال يومءذ من الغرق، وتطاولت، وتواضع هو لله، فلم يغرق وارست عليه سفينة نوح "
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب، ثنا ابن ابي عروبة، عن قتادة: {واستوت علي الجودي} [هود: ] «ابقاها الله من ارض الجزيرة عبروا به حتي راها اواءل هذه الامة، وكم من سفينة قد كانت بعدها، فهلكت بعدها وصارت رمزا»
 
    
 حدثنا ابي، ثنا محمود بن خالد، ثنا الوليد، حدثني ابن جابر، وعبد الرحمن بن ثابت بن ثوبان، عن عمير بن هاني العنسي انه حدثه ان شيوخا من عبس، انهم حدثوه، انهم لما كانوا بصفين اتوا الجودي ينظرون الي موضع السفينة فيه
 
    
 اخبرنا ابو الازهر احمد بن الازهر فيما كتب الي، ثنا وهب بن جرير، ثنا ابي، عن علي بن الحكم، عن الضحاك واما قوله: {الجودي} [هود: ] «فجبل بالموصل»
 
    
 حدثنا عمار، ثنا سهل بن بكار، وسليمان بن حرب قال: ثنا داود بن ابي الفرات، عن علباء بن احمر، عن عكرمة، عن ابن عباس قال: «كان مع نوح في السفينة ثمانون رجلا، معهم اهلوهم، وانهم كانوا في السفينة ماءة وخمسين يوما، وان الله وجه السفينة الي مكة فزارت البيت اربعين يوما، ثم وجهها الله الي الجودي فاستقرت عليه فبعث نوح الغراب لياتيه بخبر الارض، فذهب فوقع الي الجيف يعني فابطا عليه فبعث الحمامة، فاتته بورق الزيتون ولطخت رجليها بالطين، فعرف نوح ان الماء
  [ص: ]
 قد نضب، فهبط الي اسفل الجودي فاتي قرية وسماها ثمانين، فاصبحوا ذات يوم وقد تبلبلت السنتهم علي ثمانين لغة احدها اللسان العربي، فكان بعضهم لا يفقه كلام بعض وكان نوح يعبر عنهم»
 
    
 حدثنا ابي، ثنا ابو يوسف الصيدفاني محمد بن احمد بن الحجاج، ثنا مطرف، ثنا المنذر بن النعمان، سمعت وهب بن منبه يقول: " ان نوحا عليه السلام لما ركب في السفينة فلما اتي الجودي وهو جبل بالجزيرة ارست عليه، فاصاب جءجءها الجبل، فارست فكشفنا غطاءها، فطلعت الشمس، فبعث الغراب والحمامة ياتيانه بالخبر، فاتته الحمامة بمقدار من الماء الي ركبتيها، فدعا لها قال: فتلك الحمرة في رجليها من ذلك قال: واحتبس الغراب علي جيفة ياكل منها ثم اخذ نوح من قضبان كان في السفينة من العنب، فاغرس فنبت، واثمر ونضج من ساعته، فعصر منه فشرب، ثم نام في الشمس، فتكشف واتيا سام ويافث بشء يستران عليه، وضحك حام ومشيا القهقري علي ادبارهما، فانتبه نوح من نومه، فاوحي اليه ما كان من امرهما فدعا لسام ويافث ان يكون النبوة والعز في اولادهما ودعا ان يكون السواد والعبودة في ولد حام "
 
  قوله تعالي: {وقيل بعدا للقوم الظالمين} 
 [هود: ]
 
 قرات علي محمد بن الفضل بن موسي، ثنا محمد بن علي، ثنا محمد بن مزاحم، ثنا بكير بن معروف، عن مقاتل بن حيان قوله: {الظالمين} [هود: ] يعني: «المشركين»
 
  قوله تعالي: {ونادي نوح ربه فقال رب ان ابني من اهلي} 
 [هود: ]
 
    
 حدثنا المنذر بن شاذان، ثنا احمد بن اسحاق، ثنا ابو الاشهب، عن الحسن في قوله: {ونادي نوح ربه فقال رب ان ابني من اهلي} [هود: ] «وانك قد وعدتني ان تنجي لي اهلي، وان ابني من اهلي»
 
    
 حدثنا ابي، ثنا القاسم بن سلام بن مسكين، حدثني ابي قال: سمعت عاصما الجحدري يقول في قول الله: {ونادي نوح ربه فقال رب ان ابني من اهلي} [هود: ] قال: «كان ابن عباس يحلف بالله انه لابنه»
 
  قوله تعالي: {وان وعدك الحق وانت احكم الحاكمين} 
 [هود: ]
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج، قال: سمعت عبد الرحمن بن زيد، يقول في قول الله: {وانت احكم الحاكمين} [هود: ] قال: «بالحق»
 
  قوله تعالي: {قال يا نوح انه ليس من اهلك} 
 [هود: ]
 
    
 حدثنا الحسن بن ابي الربيع، ثنا عبد الرزاق، اخبرني الثوري، عن ابي عامر الهمذاني، عن الضحاك بن مزاحم، عن ابن عباس قوله: {ليس من اهلك} [هود: ] «ولو كان من اهلك لنجيته لك كما انجيتك ولكنه عمل غير صالح»
 
    
 اخبرنا احمد بن الازهر فيما كتب الي، ثنا وهب بن جرير، ثنا ابي، عن علي بن الحكم، عن الضحاك {انه ليس من اهلك} [هود: ] يقول: «ليس من اهلك، ولا ابنك، ولا بدينك، ولا ممن وعدتك ان انجي من اهلك»
 
  الوجه الثاني
 
    
 حدثنا ابي، ثنا عمر بن عون، ثنا هشيم، عن عون، ومنصور، عن الحسن في قوله: {انه ليس من اهلك} [هود: ] قال: «لم يكن ابيه»
 
  قوله تعالي: {انه عمل غير صالح} [هود: ] من قرا عمل غير صالح
 
    
 حدثني الحسن بن ابي الربيع، ثنا عبد الرزاق، ثنا معمر، عن قتادة، وغيره عن عكرمة، عن ابن عباس يعني: {عمل غير صالح} [هود: ] قال: «هو ابنه غير انه خالفه في العمل والنية» قال عكرمة في بعض الحروف: انه عمل غير صالح قال: والخيانة تكون علي غير باب
 
    
 حدثنا ابو الفضل بن اسلام، ثنا يحيي بن سعيد، حدثني يعقوب بن قيس قال: سمعت سعيد بن جبير يقرا هذا الحرف اية: {عمل غير صالح} [هود: ] قال: «معصية نبي الله، وانه لامه»
 
  ومن قرا عمل غير صالح
 
    
 حدثنا المنذر بن شاذان، ثنا هوذة، ثنا عون، عن الحسن انه قرا {عمل غير صالح} [هود: ] قال: كان ولد زنية، وكان ينسب اليه فنفاه الله منذ يوم الغرق "
 
  الوجه الثاني
 
 حدثنا ابو زرعة، ثنا منجاب بن الحارث، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {انه عمل غير صالح} [هود: ] قال: " ان نساء الانبياء لا يزنين، وكان يقراها {عمل غير صالح} [هود: ] قال: يقول: مسالتك اياي يا نوح عمل غير صالح لا ارضاه لك "
 
  قوله: {فلا تسالني ما ليس لك به علم}
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: (فلا تسالني ما ليس لك به علم) " قال الله لنوح: انه ليس بابنه "
 
  قوله تعالي: {اني اعظك ان تكون من الجاهلين} 
 [هود: ]
 
    
 واخبرنا ابو يزيد القراطيسي فيما كتب الي، اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم يقول في قوله: {اني اعظك ان تكون من الجاهلين} [هود: ] " ان تبلغ بك الجهالة لافي لك بوعد وعدتك حتي تسالني ما ليس لك به علم قال: فانها خطيءة رب اني اعوذ بك ان اسالك ما ليس لي به علم والا تغفر لي، وترحمني اكن من الخاسرين "
 
  قوله تعالي: {والا تغفر لي وترحمني اكن من الخاسرين} 
 [هود: ]
 
    
 حدثنا ابي، ثنا الفضل بن دكين قال: جاءنا كتاب عمر بن عبد العزيز في زحف كان في ولاية: اما بعد فانه بلغني ان هذا الزحف شء يعاقب الله به خلقه، فقولوا كما قال نوح: {والا تغفر لي وترحمني اكن من الخاسرين} [هود: ]
 
  قوله تعالي: {قيل يا نوح اهبط بسلام منا} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا صفوان، ثنا الوليد، ثنا سعيد، عن قتادة قال: «هبط الي الارض يوم عاشوراء وصام نوح ومن معه من المغرب الي المغرب»
 
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: قال: سمعت عبد الرحمن بن زيد بن اسلم يقول في قول الله: {اهبط بسلام منا} [هود: ] قال: «هبطوا والله عنهم راض، هبطوا بسلام من الله، كانوا اهل رحمته من اهل ذلك الدهر»
 
    
 حدثنا ابي، ثنا محمد بن عبد الرحمن الجعفي ابن اخي الحسين الجعفي، ثنا عبد الحميد بن عبد الرحمن الحماني، عن النضر ابي عمر الخزاز، عن عكرمة، عن ابن عباس «اول شء غرس نوح حين خرج من السفينة الاس»
 
    
 حدثنا ابي، ثنا سعيد بن سليمان الواسطي، ثنا صالح بن عمر، عن داود بن ابي هند قال: سمعت الحسن يقول في قوله: {قيل يا نوح اهبط بسلام منا وبركات عليك وعلي امم ممن معك} [هود: ] قال: «فانجي الله نوحا والذين معه، واهلك المتمنعين، ثم استقر الانبياء هود، وشعيب، وصالح، واهلك المتمنعين»
 
    
 اخبرنا احمد بن الازهر فيما كتب الي، ثنا وهب بن جرير، ثنا ابي، عن علي بن الحكم، عن الضحاك في قوله: {بسلام منا وبركات عليك وعلي امم ممن معك} [هود: ] يعني: " امما ممن معك: يعني ممن لم يولد قد مضي لمن سبق في كلام الله السعادة، واما من سبق له في قضاء الله وكلمته الشقوة، فيمتعهم قليلا، ثم يضطرهم الي عذاب غليظ "
 
  قوله تعالي: {وبركات عليك وعلي امم ممن معك} 
 [هود: ]
 
    
 حدثنا ابو سعيد الاشج، ثنا ابو يحيي الرازي اسحاق بن سليمان، عن موسي بن عبيدة، عن محمد بن كعب {قيل يا نوح اهبط بسلام منا وبركات عليك وعلي امم ممن معك} [هود: ] قال: فما بقي مءمن ولا مءمنة الا دخل في ذلك السلام، وفي تلك البركات الي يوم القيامة "
 
    
 حدثنا ابي، ثنا سعيد بن سليمان، ثنا صالح بن عمر، عن داود بن ابي هند، قال: سمعت الحسن يقول في قوله: {يا نوح اهبط بسلام منا وبركات عليك وعلي امم ممن معك} [هود: ] قال: «نجي الله نوحا والذين امنوا معه واهلك المتمنعين، ثم استقر الانبياء هود، وشعيب، وصالح، فانجاهم واهلك المتمنعين»
 
  قوله تعالي: {وامم سنمتعهم} 
 [هود: ]
 
    
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ، عن عبيد بن سليمان، عن الضحاك في قوله: {وامم سنمتعهم} [هود: ] يعني: «متاع الحياة الدنيا»
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي قوله: {وامم سنمتعهم ثم يمسهم منا عذاب اليم} [هود: ] قال: «هءلاء الامم من ابناء من كان في السفينة مثل عاد، وثمود، وتلك القرون»
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قول الله: {وامم سنمتعهم} [هود: ] ثم اخرج منهم نسلا بعد ذلك امما منهم من رحم، ومنهم من عذب قال: انما افترقت الامم من العصابة التي اخرجت من الماء وسلمت "
 
    
 اخبرنا ابي، ثنا عبد الصمد بن عبد العزيز الرازي، ثنا جسر، عن الحسن في قوله: {يا نوح اهبط بسلام منا وبركات عليك وعلي امم ممن معك وامم سنمتعهم} [هود: ] «فما زال الله ياخذ لنا بسهمنا، وحفظنا ويذكرنا من حيث لا نذكر انفسنا، كلما هلكت امة خلصنا في اصلاب من نجوا بلطفه حتي جعلنا في خير امة اخرجت للناس»
 
    
 اخبرنا عمرو بن عبد الله الاودي، ثنا وكيع، عن موسي بن عبيدة، عن محمد بن كعب قوله: {ثم يمسهم منا عذاب اليم} [هود: ] قال: «فدخل في ذلك البركة والسلام كل مءمن ومءمنة، ودخل في ذلك العذاب الاليم كل كافر وكافرة الي يوم القيامة»
 
    
 حدثنا ابي، ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، عن عبيد بن سليمان، عن الضحاك قوله: {ثم يمسهم منا عذاب اليم} [هود: ] «لما سبق لهم في علم الله من الشقاوة»
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قوله: {ثم يمسهم منا عذاب اليم} [هود: ] قال: «بعد الرحمة»
 
  قوله تعالي: {عذاب اليم} 
 [البقرة: ]
 
 ثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس: {عذاب اليم} [هود: ] يقول: «نكال موجع»
 
  قوله تعالي: {تلك} 
 [البقرة: ]
 
    
 حدثنا موسي بن ابي موسي، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، ثنا اسباط، عن السدي، عن ابي مالك قوله: {تلك} [هود: ] يعني: «هذه»
 
  قوله تعالي: {من انباء الغيب} 
 [ال عمران: ]
 
 وبه عن ابي مالك قوله: {انباء} [ال عمران: ] يعني: «احاديث»
 
  قوله تعالي: {نوحيها اليك} 
 [هود: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، ثنا اسباط، عن السدي قال: " ثم رجع الي محمد صلي الله عليه وسلم فقال: {تلك من انباء الغيب نوحيها اليك} [هود: ] "
 
  قوله تعالي: {ما كنت تعلمها انت} 
 [هود: ]
 
    
 حدثنا علي بن الحسين، ثنا عمر بن علي، ثنا ابو قتيبة، ثنا ورقاء بن عمر، ثنا عطاء بن الساءب، عن ابي عبد الرحمن السلمي في قوله: {ما كنت تعلمها انت ولا قومك من قبل هذا} [هود: ] قال: «هذا الذي قصصت عليك»
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد، عن قتادة قوله: {ما كنت تعلمها انت ولا قومك من قبل هذا} [هود: ] اي: «ما علم محمد صلي الله عليه وسلم ولا قومه بما صنع نوح وقومه لولا بيان الله عز وجل»
 
  قوله تعالي: {ولا قومك} 
 [هود: ]
 
    
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي قوله: {ما كنت تعلمها انت ولا قومك} [هود: ] يعني: «العرب»
 
  قوله تعالي: {من قبل هذا} 
 [هود: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد الدمشقي، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة قوله: {انت ولا قومك من قبل هذا فاصبر ان العاقبة للمتقين} [هود: ] "
 
 حدثنا محمد بن يحيي، ثنا ابو غسان محمد بن عمرو، ثنا سلمة، عن محمد بن اسحاق، فيما حدثني محمد مولي زيد بن ثابت، عن عكرمة او سعيد بن جبير، عن ابن عباس «يقول الله سبحانه وبحمده للمتقين اي الذين يحذرون من الله عقوبته في ترك ما يعرفون من الهدي، ويرجون رحمته بالتصديق بما جاء به»
 
  قوله تعالي: {والي عاد اخاهم هودا} 
 [الاعراف: ]
 
    
 اخبرنا احمد بن عثمان بن حكيم الاودي فيما كتب الي، ثنا احمد بن المفضل، ثنا اسباط، عن السدي قوله: {والي عاد اخاهم هودا قال يا قوم اعبدوا الله ما لكم من اله غيره} [الاعراف: ] " ان عادا كانوا باليمن والاحقاف هي: الرمال فاتاهم فوعظهم، وذكرهم بما قص الله في القران، فكذبوه، وكفروا وسالوه ان ياتيهم بالعذاب "
 
  قوله تعالي: {قال يا قوم اعبدوا الله ما لكم من اله غيره} 
 [الاعراف: ]
 
    
 حدثنا محمد بن العباس مولي بني هاشم، ثنا عبد الرحمن بن سلمة، حدثني سلمة، حدثني محمد بن اسحاق «وكان من حديث عاد فيما بلغني والله اعلم، انهم كانوا قوما عربا، فبعث الله اليهم هودا وهو من اوسطهم نسبا وافضلهم موضعا فامرهم ان يوحدوا الله عز وجل»
 
  قوله تعالي: {يا قوم لا اسالكم عليه اجرا} 
 [هود: ]
 
 حدثنا ابو زرعة، ثنا منجاب، ثنا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس في قوله: {لا اسالكم عليه اجرا} [الانعام: ] قال: " لا اسالكم علي ما ادعوكم اليه اجرا يقول: عرضا من عرض الدنيا "
 
    
 واخبرنا يونس بن عبد الاعلي قراءة ثنا ابن وهب، اخبرني سعيد بن ابي ايوب، عن عطاء بن دينار في قول الله: {لا اسالكم} [الانعام: ] «علي ما جءتكم به اجرا»
 
  قوله تعالي: {ان اجري الا علي الذي فطرني} 
 [هود: ]
 
    
 حدثنا علي بن الحسين، ثنا ابو الجماهر، ثنا سعيد بن بشير، عن قتادة: {ان اجري الا علي الذي فطرني} [هود: ] «اي خلقني»
 
 قوله تعالي: {ويا قوم
  [ص: ]
 استغفروا ربكم} [هود: ]
 
    
 اخبرنا يونس بن عبد الاعلي، ثنا سفيان بن عيينة، عن مطرف، عن الشعبي قال: خرج عمر بن الخطاب يستسقي فما زاد علي الاستغفار حتي رجع قالوا: ما رايناك استسقيت قال: " لقد طلبت المطر بمجاديح السماء التي يستنزل بها المطر ثم قرا: {ويا قوم استغفروا ربكم ثم توبوا اليه يرسل السماء عليكم مدرارا ويزدكم قوة الي قوتكم} [هود: ] "
 
  قوله تعالي: {يرسل السماء عليكم مدرارا} 
 [هود: ]
 
    
 حدثنا سليمان بن داود القزاز، ثنا اسحاق بن سليمان قال: سمعت ابا عيش، عن هارون التيمي في قوله: {يرسل السماء عليكم مدرارا} [هود: ] قال: «المطر»
 
  قوله تعالي: {مدرارا} 
 [الانعام: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {مدرارا} [الانعام: ] قال: «يتبع بعضه بعضا»
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن يزيد بن اسلم يقول في قول الله: {يرسل السماء عليكم مدرارا} [هود: ] قال: «يدر ذلك عليهم مطرا مطرا»
 
  قوله تعالي: {ويزدكم قوة الي قوتكم} [هود: ] الاية
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {ويزدكم قوة الي قوتكم} [هود: ] قال: «شدة الي شدتكم»
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قوله: {ويزدكم قوة الي قوتكم} [هود: ] قال: «جعل لهم قوة فلو انهم اطاعوه زادهم قوة الي قوتهم»
 
  الوجه الثاني
 
    
 حدثنا ابي، ثنا محمد بن عبد الرحمن الجعفي اخي حسين الجعفي، ثنا طلق بن غنام، عن قيس بن الربيع، عن خصيف، عن عكرمة في قوله: {الي قوتكم} [هود: ] قال: «ولد الولد»
 
  قوله تعالي: {قالوا يا هود ما جءتنا ببينة وما نحن بتاركي الهتنا عن قولك وما نحن لك بمءمنين} 
 [هود: ]
 
    
 حدثنا ابو زرعة، ثنا يحيي بن عبد الله بن بكير، ثنا ابن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير قوله: {بمءمنين} [هود: ] قال: «بمصدقين»
 
  قوله تعالي: {الا اعتراك بعض الهتنا بسوء} 
 [هود: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {الا اعتراك بعض الهتنا بسوء} [هود: ] «اصابتك الاوثان بجنون»
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة قوله: {ان نقول الا اعتراك بعض الهتنا بسوء} [هود: ] قالوا: «انما تصنع هذا من اجل ان بعض الهتنا اصابك بسوء»
 
  قوله تعالي: {قال اني اشهد الله واشهدوا اني برء مما تشركون من دونه} 
 [هود: ]
 
    
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة بن الفضل، عن محمد بن اسحاق قال: {قال اني اشهد الله واشهدوا اني برء مما تشركون من دونه} [هود: ] اي: «اني قد كفرت بالهتكم التي تزعمون انها اصابتني بالجنون، فلتصبني بما هو اعظم من ذلك، اني قد كفرت بها»
 
  قوله تعالي: {فكيدوني جميعا ثم لا تنظرون} 
 [هود: ]
 
    
 حدثنا ابي، ثنا عبد الرحمن بن ابراهيم دحيم، ثنا ايوب بن حسان ابو حسان الجرسي، عن محمد بن مهاجر قال: " كان عمر جالسا وهو يشق عليه الجلوس فكان متكءا وعنده يومءذ سعيد بن خالد وعنبسة بن سعيد، واناس من بني عمه فقال: يا بني عم اسالكم صنع اما لكم كذا؟ قالوا: بلي قال سعيد بن خالد: وكانت فيه اعرابية والله انك لتريد امرا لا تناله حتي تنال السماء قال: فاستوي قاعدا ثم قال: {فكيدوني جميعا ثم لا تنظرون} [هود: ] قال: فقال عنبسة بن سعيد: يا امير المءمنين اما لنا قرابة؟ اما لنا حق؟ قال: بلي ولكني والله ما لكم فيه الا كالرجل في حضرموت راعي غنم قال: فلما سمعوها افترقوا ولحقوا بمنازلهم "
 
 حدثنا علي بن الحسين، ثنا محمد بن عيسي، ثنا سلمة، عن ابن اسحاق قوله: {فكيدوني جميعا} [هود: ] اي «فكيدوني انتم ومن معكم جميعا»
 
  قوله تعالي: {ما من دابة الا هو اخذ بناصيتها} 
 [هود: ]
 
    
 حدثنا ابي، ثنا ابو صفوان بن صالح المءذن، ثنا الوليد بن مسلم، عن صفوان بن عمرو، عن ايفع بن عبد الكلاعي انه قال في قوله: {ما من دابة الا هو اخذ بناصيتها} [هود: ] ان ربي علي صراط مستقيم قال: " فياخذ بنواصي عباده فيلين للمءمن حتي يكون لهم الين من الوالد بولده، ويقال للكافر: {ما غرك بربك الكريم} [الانفطار: ] "
 
  قوله تعالي: {صراط مستقيم} [البقرة: ] قد تقدم تفسير {صراط مستقيم} [البقرة: ] غير مرة
 
  قوله تعالي: {فان تولوا} 
 [ال عمران: ]
 
    
 حدثنا ابي، ثنا ابو صالح، حدثني معاوية بن صالح، عن علي بن طلحة، عن ابن عباس: {فان تولوا} [ال عمران: ] يعني: «الكفار»
 
  قوله تعالي: {ويستخلف ربي} [هود: ] الاية
 
    
 حدثنا يحيي بن عبدك القزويني، ثنا سعيد بن ابي ايوب، حدثني بشير بن ابي عمرو الخولاني، عن الوليد بن قيس، عن ابي سعيد الخدري قال: «الخلف من بعد ستين سنة»
 
  قوله تعالي: {ولما جاء امرنا نجينا هودا والذين امنوا معه برحمة منا} [هود: ] قد تقدم تفسيره في سورة الاعراف والله اعلم
 
  قوله تعالي: {ونجيناهم من عذاب غليظ} 
 [هود: ]
 
    
 حدثنا موسي بن ابي موسي الانصاري، ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك قوله: {غليظ} [هود: ] يعني: «شديدا»
 
  قوله تعالي: {واتبعوا امر كل جبار عنيد} 
 [هود: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة قوله: {واتبعوا امر كل جبار عنيد} [هود: ] " والعنيد: المشرك "
 
 حدثنا عبد الله بن سليمان، ثنا الحسين بن علي، ثنا عامر بن الفرات، عن اسباط، عن السدي قوله: {امر كل جبار عنيد} [هود: ] قال: «المشاق»
 
  قوله تعالي: {واتبعوا في هذه الدنيا لعنة} 
 [هود: ]
 
    
 وبه الي السدي قوله: {واتبعوا في هذه الدنيا لعنة} [هود: ] قال: «واتبعناهم في هذه لعنة لم يبعث نبي بعد عاد الا لعنت عاد علي لسانه»
 
  قوله تعالي: {والي ثمود اخاهم صالحا} 
 [الاعراف: ]
 
    
 اخبرنا سلمة بن علي، عن سعيد بن بشير، عن قتادة «ان صالحا بعث من الحجر»
 
  قوله تعالي: {هو انشاكم من الارض} 
 [هود: ]
 
    
 حدثنا عبد الله، ثنا الحسين، ثنا عباس، ثنا اسباط، عن السدي {انشاكم من الارض} [هود: ] يقول: «خلقكم من الارض»
 
  قوله تعالي: {واستعمركم فيها} 
 [هود: ]
 
    
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {واستعمركم فيها} [هود: ] قال: «اعمركم فيها»
 
    
 اخبرنا ابو يزيد القراطيسي فيما كتب الي، ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم: {واستعمركم فيها} [هود: ] قال: «استخلفكم فيها»
 
  قوله تعالي: {فاستغفروه ثم توبوا اليه} [هود: ] تقدم تفسيره
 
  قوله تعالي: {قالوا يا صالح قد كنت فينا مرجوا قبل هذا} 
 [هود: ]
 
    
 حدثنا ابي، ثنا هشام بن خالد، ثنا شعيب بن اسحاق، ثنا سعيد بن ابي عروبة، عن قتادة قوله: {واننا لفي شك مما تدعونا اليه مريب} [هود: ] «وكذبوا، والله ما في الله شك في من فطر السماء والارض، وانزل من السماء ماء فاخرج به من الثمرات رزقا لكم، واظهر لكم من الالاء والنعم المتظاهرة ما لا يشك في الله»
 
  قوله تعالي: {ارايتم ان كنت علي بينة من ربي} [هود: ] تقدم تفسيره
 
  قوله تعالي: {واتاني منه رحمة فمن ينصرني من الله ان عصيته فما تزيدونني غير تخسير} 
 [هود: ]
 
    
 اخبرنا العباس بن الوليد بن مزيد البيروتي قراءة ثنا محمد بن شعيب بن شابور، حدثني عثمان بن عطاء، عن عطاء الخراساني: {فما تزيدونني غير تخسير} [هود: ] فقال: «ما يزيدونني الا شرا وخسرانا تخسرونه»
 
  قوله تعالي: {ويا قوم هذه ناقة الله لكم} [هود: ] تقدم تفسيره في سورة الاعراف
 
    
 حدثنا محمد بن العباس مولي بني هاشم، ثنا عبد الرحمن بن سلمة، ثنا سلمة، قال محمد: ثنا محمد بن اسحاق، عن يعقوب بن عتبة بن المغيرة، حدث " انهم نظروا الي الهضبة حين دعا الله صالح بما دعا به تمخض الناقة تمخض الفتوج بولدها، فتحركت الهضبة، ثم انقضت فانصدعت عن ناقة كما وصفوا جوفاء، وبرا، تثوج ما بين جنبيها مالا يعلمه الا الله قال محمد بن اسحاق: ثم قال له جندع بن جراش بن عمرو بن الرميل وكان يومءذ سيد ثمود وعظيمها: يا صالح اخرج لنا من هذه الصخرة ناقة مخترجة، جوفاء، وبراء، والمخترجة: ما شاكل البخت من الابل، وقالت ثمود لصالح مثل ما قال جندع بن عمرو لصخرة منفردة في ناحية الحجر، يقال لها الكاتبة فان فعلت امنا بك، وصدقناك وشهدنا ان ما جءت به هو الحق، فاخذ عليهم صالح مواثيقهم لءن فعلت، وفعل الله لتصدقني ولتءمنن لي قالوا: نعم واعطوه علي ذلك عهودهم فدعا صالح ربه عز وجل بان يخرجها لهم من تلك الهضبة كما وصفوا "
 
  قوله تعالي: {فذروها تاكل في ارض الله} [الاعراف: ] قد تقدم تفسيره
 
  قوله تعالي: {فعقروها} 
 [هود: ]
 
    
 حدثنا ابي، ثنا هشام بن عمار، ثنا الوليد، ثنا خليد بن دعلج، عن قتادة " ان ثمود لما عقروا الناقة تغامزوا وقالوا: عليكم الفصيل فصعد الفصيل القارة جبلا حتي اذا كان يوما استقبل القبلة وقال: يا رب امي، يا رب امي، يا رب امي قال: فارسلت عليهم الصيحة عند ذلك "
 
    
 حدثنا محمد بن العباس، ثنا عبد الرحمن بن سلمة، ثنا سلمة، عن محمد بن اسحاق قال: " فرصدوا الناقة حين صدرت عن الماء وقد كمن لها قدار في اصل الصخرة علي طريقها وكمن لها مصدع في اصل اخري، فمرت علي مصدع فرماها بسهم فانتظم به عضلة ساقها قال: فشد يعني: قدارا علي الناقة بالسيف، فكشف عرقوبها فخرت ورغت رغاة واحدة فحترت ساقيها، ثم طعن في لبتها فنحرها، وانظلم سقيها حتي اتي جبلا، ثم اتي صخرة في راس الجبل فرغا ثم لاذ بها فاتاهم صالح فلما راي الناقة عقرت بكي ثم قال: انتهكتم حرمة الله فابشروا بعذاب الله ونقمته
 
    
 حدثنا ابي، ثنا عثمان بن ابي شيبة، ثنا يحيي بن يمان، عن سفيان الثوري، عن ابي سنان، عن عبد الله بن ابي الهذيل قال: «لما عقرت الناقة صعد بكرها فوق جبل فرغا فما سمعه شء الا هو»
 
  قوله تعالي: {فقال تمتعوا في داركم} 
 [هود: ]
 
    
 حدثنا محمد بن عوف الحمصي، ثنا ابو اليمان، ثنا ابن عباس، عن عبد الله بن عثمان بن خثيم، عن ابي الزبير، عن جابر قال: لما نزلنا الحجر مغزي رسول الله صلي الله عليه وسلم تبوكا قال لنا: " انهي الناس عن الايات هءلاء قوم صالح سالوا نبيهم ان يبعث لهم اية فبعث الله لهم الناقة، وكانت ترد من ذلك الفج فتشرب ماءهم يوم وردها، ويحتلبون منها الذي كانوا يشربون منها يوم عبها، وتصدر من ذلك فعتوا عن امر ربهم فعقروها فوعدهم الله ان يمكثوا في دارهم ثلاثة ايام فكان من الله وعد غير مكذوب، فجاءتهم الصيحة، فاهلك الذين كانوا منه تحت مشارق الارض ومغاربها الا رجلا كان في حرم الله فمنعه حرم الله من عذاب الله فقيل: يا رسول الله من هو؟ فقال ابو رغال قالوا: ومن ابو رغال قال ابو ثقيف "
 
    
