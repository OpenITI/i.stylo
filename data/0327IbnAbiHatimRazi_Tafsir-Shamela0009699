 [التوبة: ]
 
 حدثنا محمد بن يحيي انبا العباس بن الوليد ثنا يزيد عن سعيد عن قتادة {فخلوا سبيلهم} [التوبة: ] كان قتادة يقول: " خلوا سبيل من امركم الله ان تخلوا سبيله فانما الناس ثلاثة رهط: مسلم عليه الزكاة ومشرك عليه الجزية وصاحب حرب يامن بتجارته في المسلمين اذا اعطي عشور ماله "
 
 حدثنا ابي ثنا عبيد بن ادم ثنا ادم ثنا ابو شيبة عن عطاء الخراساني {فان تابوا واقاموا الصلاة واتوا الزكاة فخلوا سبيلهم} [التوبة: ] قال: «ثم خلطهم بالمءمنين» 
 
  قوله تعالي: {ان الله غفور رحيم} 
 [البقرة: ]
 
 حدثنا علي بن الحسين ثنا العباس بن الوليد ثنا يزيد عن سعيد عن قتادة قوله: {ان الله غفور} [التوبة: ] قال: " غفور للذنوب الكثيرة او الكبيرة  شك يزيد : {رحيم} [التوبة: ] قال: بعباده رحيم "
 
  قوله تعالي: {وان احد من المشركين استجارك فاجره} 
 [التوبة: ]
 
 حدثنا ابي ثنا ابو حذيفة ثنا شبل عن ابن ابي نجيح عن مجاهد {وان احد من المشركين استجارك فاجره} [التوبة: ] يقول: «من جاءك واستمع ما تقول واستمع ما انزل اليك فهو امن حتي ياتيك»
 
  قوله تعالي: {فاجره} 
 [التوبة: ]
 
 حدثنا حجاج بن حمزة ثنا شبابة حدثنا ورقاء عن ابن ابي نجيح عن مجاهد قوله: {فاجره} [التوبة: ] يقول: «فهو امن حتي ياتيه فيسمع كلام الله»
 
  قوله تعالي: {حتي يسمع كلام الله} 
 [التوبة: ]
 
 حدثنا ابي ثنا الحسين بن الاسود ثنا عمرو بن محمد العنقزي ثنا اسباط عن السدي عن اصحابه في قول الله {وان احد من المشركين استجارك فاجره حتي يسمع كلام الله} [التوبة: ] قال: " كلام الله: القران " وروي عن قتادة نحو ذلك
 
  قوله تعالي: {ثم ابلغه مامنه} 
 [التوبة: ]
 
 حدثنا حجاج بن حمزة ثنا شبابة ثنا ورقاء عن ابن ابي نجيح عن مجاهد قوله: {ثم ابلغه مامنه} [التوبة: ] «من حيث جاء»
 
 حدثنا ابي ثنا سهل بن عثمان ثنا يحيي قال قال ابن جريج: قال عطاء في الرجل من اهل الشرك ياتي المسلمين بغير عهد قال: «يخيره اما ان يقره واما ان يبلغه مامنه»
 
 اخبرنا ابو يزيد القراطيسي فيما كتب الي انبا اصبغ ثنا ابن زيد في قوله {ثم ابلغه مامنه} [التوبة: ] قال: «ان لم يوافقه ما يقص عليه ويحدثه فابلغه مامنه، وليس هذا بمنسوخ»
 
  قوله تعالي: {ذلك بانهم قوم لا يعلمون} 
 [التوبة: ]
 
 حدثنا علي بن الحسين ثنا محمد بن العلاء، ثنا، عثمان بن سعيد ثنا بشر بن عمارة عن ابي روق عن الضحاك عن ابن عباس {لا يعلمون} [التوبة: ] يقول: «لا يعقلون»
 
  قوله تعالي: {كيف يكون للمشركين عهد عند الله وعند رسوله} 
 [التوبة: ]
 
 قرات علي محمد بن الفضل ثنا محمد بن علي ثنا محمد بن مزاحم ثنا، بكير بن معروف، عن مقاتل بن حيان ثم قال: كان النبي صلي الله عليه وسلم قد عاهده اناس من المشركين وعاهد ايضا اناسا من بني ضمرة بن بكر، وكنانة خاصة عاهدهم عند المسجد الحرام وجعل مدتهم اربعة اشهر وهم الذين ذكر الله: {الا الذين عاهدتم عند المسجد الحرام} [التوبة: ]
 
 اخبرنا احمد بن عثمان بن حكيم فيما كتب الي ثنا احمد بن المفضل ثنا اسباط، عن السدي قوله: {كيف يكون للمشركين عهد عند الله وعند رسوله الا الذين عاهدتم عند المسجد الحرام فما استقاموا لكم فاستقيموا لهم} [التوبة: ] " هم: بنو جذيمة بن فلان "
 
  قوله تعالي: {الا الذين عاهدتم عند المسجد الحرام} 
 [التوبة: ]
 
 حدثنا ابي ثنا ابو صالح ثنا معاوية بن صالح عن علي بن ابي طلحة عن ابن عباس قوله: {الا الذين عاهدتم عند المسجد الحرام} [التوبة: ] يعني: «اهل مكة»
 
 اخبرنا ابو يزيد القراطيسي فيما كتب الي ثنا اصبغ بن الفرج قال: سمعت عبد الرحمن بن زيد بن اسلم في قوله {الا الذين عاهدتم عند المسجد الحرام فما استقاموا لكم فاستقيموا لهم} [التوبة: ] قال: «هءلاء قريش»
 
 حدثنا ابي ثنا محمد بن عبد الاعلي ثنا ابن ثور عن معمر عن قتادة قوله: {الا الذين عاهدتم عند المسجد الحرام فما استقاموا لكم فاستقيموا لهم} [التوبة: ] قال: " هو يوم الحديبية قال: فلم يستقيموا ونقضوا عهدهم اعانوا بني بكر حلف قريش علي خزاعة حلفاء النبي صلي الله عليه وسلم "
 
  قوله تعالي {فما استقاموا لكم} 
 [التوبة: ]
 
 قرات علي محمد ثنا محمد ثنا محمد عن بكير، عن مقاتل قوله: {فما استقاموا لكم} [التوبة: ] يقول: «ما وفوا لكم بالعهد»
 
  قوله تعالي: {فاستقيموا لهم} 
 [التوبة: ]
 
 وبه عن مقاتل قوله: {فاستقيموا لهم} [التوبة: ] قال: «فوفوا لهم»
 
  قوله تعالي: {كيف وان يظهروا عليكم} 
 [التوبة: ]
 
 اخبرنا احمد بن عثمان بن حكيم فيما كتب الي ثنا احمد بن مفضل ثنا اسباط، عن السدي قوله: {كيف وان يظهروا عليكم لا يرقبوا فيكم الا ولا ذمة} [التوبة: ] يقول: {كيف وان يظهروا عليكم} [التوبة: ] " المشركون {لا يرقبوا فيكم} [التوبة: ] "
 
  قوله تعالي: {لا يرقبوا فيكم} 
 [التوبة: ]
 
 حدثنا ابي ثنا ابو حذيفة، ثنا، شبل، عن ابن ابي نجيح، عن مجاهد في قوله: {لا يرقبوا فيكم} [التوبة: ] «لا يرقبوا في محمد صلي الله عليه وسلم الا»
 
 حدثنا ابي ثنا نعيم بن حماد ثنا محمد بن ثور عن معمر عن ابن ابي نجيح، عن، مجاهد: {لا يرقبوا فيكم الا ولا ذمة} [التوبة: ] «لا يراقبون الله ولا غيره»
 
  قوله تعالي: {الا} 
 [البقرة: ]
 
 حدثنا ابو زرعة ثنا منجاب بن الحارث انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن، ابن عباس قوله: {لا يرقبوا فيكم الا ولا ذمة} [التوبة: ] قال: «الال القرابة» وروي عن الضحاك مثله
 
  الوجه الثاني
 
 حدثنا احمد بن سنان ثنا عبد الرحمن بن مهدي، عن سفيان عن ابن ابي نجيح، عن مجاهد {الا} [البقرة: ] قال: «الله عز وجل» وروي عن سعيد بن جبير قال: الها
 
  والوجه الثالث
 
 حدثنا حجاج بن حمزة ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد {الا} [البقرة: ] قال: «عهدا» وروي عن عبد الرحمن بن زيد بن اسلم نحو ذلك
 
  والوجه الرابع
 
 حدثنا ابي , ثنا محمد بن عبد الاعلي , انبا محمد بن ثور , عن معمر , عن قتادة: {الا} [البقرة: ] قال: " الال: الحلف "
 
  قوله تعالي: {ولا ذمة} 
 [التوبة: ]
 
 حدثنا ابو زرعة ثنا منجاب بن الحارث، انبا بشر بن عمارة، عن ابي روق، عن الضحاك عن ابن عباس: {الا ولا ذمة} [التوبة: ] قال: " الذمة: العهد " وروي عن مجاهد في احدي الروايات وقتادة والضحاك في احد قوليه مثله
 
  والوجه الثاني
 
 اخبرنا احمد بن عثمان فيما كتب الي، ثنا احمد بن مفضل، ثنا اسباط، عن السدي: قوله {لا يرقبوا فيكم الا ولا ذمة} [التوبة: ] يقول: «عهدا ولا قرابة ولا ميثاقا» وروي عن سعيد بن جبير انه قال: العقد
 
  والوجه الثالث
 
 حدثنا ابي، ثنا نصر بن علي الجضهمي، ثنا معتمر، عن محمد بن الهيصم، عن بديل، عن الضحاك بن مزاحم، {لا يرقبون في مءمن الا ولا ذمة} [التوبة: ] قال: " الذمة: الحلف "
 
  قوله تعالي: {يرضونكم بافواههم وتابي قلوبهم} [التوبة: ] بياض لم يذكر فيه شء
 
  قوله تعالي: {واكثرهم فاسقون} 
 [التوبة: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {واكثرهم فاسقون} [التوبة: ] قال: «القرون الماضية»
 
 حدثنا محمد بن يحيي انبا العباس بن الوليد، حدثنا يزيد بن زريع، حدثنا سعيد، عن قتادة قوله: {واكثرهم فاسقون} [التوبة: ] قال: «ذم الله تعالي اكثر الناس»
 
  قول تعالي: {اشتروا بايات الله} 
 [التوبة: ]
 
 حدثنا حجاج بن حمزة، ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد قوله: {اشتروا بايات الله ثمنا قليلا} [التوبة: ] قال «ابو سفيان بن حرب اطعم حلفاءه وترك حلفاء محمد صلي الله عليه وسلم»
 
  قوله تعالي: {ثمنا قليلا} 
 [البقرة: ]
 
 حدثنا علي بن الحسين، ثنا محمد بن علي بن حمزة، انبا علي بن الحسين، انبا عبد الله بن المبارك، انبا عبد الرحمن بن يزيد بن جابر، عن هارون بن يزيد قال: سءل الحسن عن قوله: {ثمنا قليلا} [البقرة: ] قال: " الثمن القليل: الدنيا بحذافيرها "
 
 حدثنا الحسن بن احمد، ثنا ابراهيم بن عبد الله بن بشار، ثنا سرور بن المغيرة، عن عباد بن منصور، عن الحسن: قوله {ثمنا قليلا} [البقرة: ] «كذبا وفجورا»
 
  قوله تعالي: {فصدوا عن سبيله} 
 [التوبة: ]
 
 اخبرنا، احمد بن عثمان بن حكيم فيما كتب الي ثنا احمد بن مفضل، ثنا، اسباط، عن السدي قوله: {عن سبيله} [الانعام: ] قال: «عن الاسلام»
 
  قوله تعالي: {انهم ساء ما كانوا يعملون} [التوبة: ] بياض
 
  قوله تعالي: {لا يرقبون} [التوبة: ] قد تقدم تفسيره
 
  قوله تعالي: {فان تابوا واقاموا الصلاة واتوا الزكاة} 
 [التوبة: ]
 
 حدثنا محمد بن يحيي، انبا العباس بن الوليد ثنا يزيد بن زريع، عن سعيد، عن قتادة قوله: {فان تابوا واقاموا الصلاة واتوا الزكاة فاخوانكم في الدين} [التوبة: ] يقول: " ان تركوا اللات والعزي وشهدوا ان لا اله الا الله وان محمدا رسول الله {فاخوانكم في الدين} [التوبة: ] "
 
  قوله تعالي: {فاخوانكم في الدين} 
 [التوبة: ]
 
 اخبرنا موسي بن هارون الطوسي فيما كتب الي ثنا الحسين بن محمد المروذي، ثنا شيبان بن عبد الرحمن، عن قتادة: قوله {فاخوانكم في الدين} [التوبة: ] قال: «فكونوا من اخوة الاسلام ممن يرعاهم ويعاهد عليها ويعظم حقها فان افضل المسلمين اوصلهم لاخوة الاسلام»
 
  قوله تعالي: {ونفصل الايات لقوم يعلمون} 
 [التوبة: ]
 
 اخبرنا احمد بن عثمان فيما كتب الي ثنا احمد بن مفضل، ثنا اسباط، عن السدي: قوله: {ونفصل الايات لقوم يعلمون} [التوبة: ] " اما نفصل: فنبين "
 
  قوله تعالي: {وان نكثوا ايمانهم من بعد عهدهم وطعنوا في دينكم} 
 [التوبة: ]
 
 اخبرنا محمد بن سعد فيما كتب الي ثنا ابي، ثنا عمي الحسين، عن ابيه، عن جده، عن ابن عباس قوله: {وان نكثوا} [التوبة: ] ايمانهم من بعد عهدهم وطعنوا في دينكم فقاتلوا اءمة الكفر «سماهم اءمة الكفر بينك وبينهم قاتلهم، انهم اءمة الكفر»
 
  قوله تعالي: {فقاتلوا اءمة الكفر} 
 [التوبة: ]
 
 حدثنا محمد بن عبد الله بن ميمون الاسكندراني، ثنا الوليد بن مسلم، ثنا صفوان بن عمرو، عن عبد الرحمن بن جبير بن نفير، انه كان في عهد ابي بكر رضي الله عنه الي الناس حين وجههم الي الشام قال: " انكم ستجدون قوما محوقة رءوسهم فاضربوا مقاعد الشيطان منهم بالسيوف فوالله لان اقتل رجلا منهم احب الي من ان اقتل سبعين من غيرهم وذلك بان الله يقول: {فقاتلوا اءمة الكفر} [التوبة: ] "
 
  والوجه الثاني
 
 حدثنا يونس بن حبيب، ثنا ابو داود، ثنا شعبة، عن ابي بشر، سمع مجاهدا يحدث، عن ابن عمر: في قول الله {فقاتلوا اءمة الكفر انهم لا ايمان لهم} [التوبة: ] قال: «ابو سفيان بن حرب منهم» قال ابو محمد: يعني قبل ان يسلم وروي عن سعيد بن جبير مثله
 
 حدثنا ابي، ثنا محمد بن عبد الاعلي، ثنا محمد بن ثور، عن معمر قال: قال قتادة: " {اءمة الكفر} [التوبة: ] ابو سفيان وابو جهل، وامية بن خلف، وسهيل بن عمرو، وعتبة بن ربيعة "
 
 حدثنا ابي ثنا عبد العزيز بن منيب، ثنا ابو معاذ النحوي، عن عبيد بن سليمان، عن الضحاك {فقاتلوا اءمة الكفر} [التوبة: ] يعني: «رءوس المشركين من اهل مكة»
 
  والوجه الثالث
 
 حدثنا احمد بن سنان، ثنا ابو معاوية، ثنا الاعمش، عن زيد بن وهب، عن حذيفة قال: ذكروا عنده هذه الاية {فقاتلوا اءمة الكفر} [التوبة: ] قال: «ما قوتل اهل هذه الاية بعد»
 
  الوجه الرابع
 
 اخبرنا محمد بن سعد العوفي فيما كتب الي ثنا ابي ثنا عمي الحسين عن ابيه عن جده عن ابن عباس {فقاتلوا اءمة الكفر} [التوبة: ] يعني: «اهل العهد من المشركين سماهم اءمة الكفر»
 
  قوله تعالي: {انهم لا ايمان لهم} 
 [التوبة: ]
 
 حدثنا احمد بن سنان ثنا عبد الرحمن بن مهدي، ثنا سفيان عن ابي اسحاق عن صلة بن زفر، عن عمار {فقاتلوا اءمة الكفر انهم لا ايمان لهم} [التوبة: ] قال: «لا عهود لهم» وروي عن حذيفة نحو ذلك
 
  قوله تعالي {لعلهم ينتهون} 
 [التوبة: ]
 
 اخبرنا محمد بن سعد فيما كتب الي ثنا ابي، ثنا عمي عن ابيه عن جده، عن ابن عباس {لعلهم ينتهون} [التوبة: ] يعني: «اهل العهد من المشركين»
 
  قوله تعالي: {الا تقاتلون قوما نكثوا ايمانهم} 
 [التوبة: ]
 
 حدثنا ابي ثنا عفان، ثنا حماد بن زيد، ثنا ايوب، عن عكرمة في حديث فتح مكة ان رسول الله صلي الله عليه وسلم قال: " من اغلق بابه فهو امن ومن القي سلاحه فهو امن قال: فقاتلهم خزاعة الي نصف النهار وانزل الله تعالي {الا تقاتلون قوما نكثوا ايمانهم وهموا باخراج الرسول} [التوبة: ] "
 
  قوله تعالي: {وهموا باخراج الرسول} 
 [التوبة: ]
 
 حدثنا حجاج بن حمزة ثنا شبابة، ثنا ورقاء، عن ابن ابي نجيح، عن مجاهد {وهموا باخراج الرسول} [التوبة: ] «ياثر ذلك الله تبارك وتعالي»
 
 اخبرنا احمد بن عثمان فيما كتب الي ثنا احمد بن مفضل ثنا اسباط عن السدي {وهموا باخراج الرسول} [التوبة: ] يقول: «هموا باخراجه فاخرجوه»
 
  قوله تعالي: {وهم بدءوكم اول مرة}
 
 حدثنا حجاج بن حمزة ثنا شبابة ثنا ورقاء عن ابن ابي نجيح، عن مجاهد قوله {وهم بدءوكم اول مرة} «قتال قريش حلفاء محمد صلي الله عليه وسلم» وروي عن عكرمة نحو ذلك
 
  قوله تعالي: {اتخشونهم فالله احق ان تخشوه} 
 [التوبة: ]
 
 حدثنا ابو زرعة ثنا يحيي بن عبد الله بن بكير، ثنا عبد الله بن لهيعة، حدثني عطاء بن دينار، عن سعيد بن جبير قوله {مءمنين} [التوبة: ] قال: «مصدقين»
 
  قوله تعالي: {قاتلوهم يعذبهم الله بايديكم} 
 [التوبة: ]
 
 اخبرنا احمد بن عثمان فيما كتب الي ثنا احمد بن مفضل، ثنا اسباط، عن السدي قوله {وهم بدءوكم اول مرة} «بالقتال» يقول: {قاتلوهم يعذبهم الله بايديكم ويخزهم وينصركم عليهم} [التوبة: ]
 
  قوله تعالي: {ويخزهم وينصركم عليهم} 
 [التوبة: ]
 
 حدثنا ابي ثنا ابو الربيع الزهراني، ثنا حماد بن زيد، ثنا ايوب، عن عكرمة في قوله: {ويخزهم وينصركم عليهم} [التوبة: ] قال: «نزلت في خزاعة»
 
  قوله تعالي: {ويشف صدور قوم مءمنين} 
 [التوبة: ]
 
 حدثنا ابو سعيد الاشج ثنا عقبة بن خالد، عن شعبة، عن مجاهد: {ويشف صدور قوم مءمنين} [التوبة: ] قال: " خزاعة وروي عن عكرمة نحو ذلك
 
 حدثنا حجاج بن حمزة ثنا شبابة، حدثنا ورقاء، عن ابن ابي نجيح، عن مجاهد: {ويشف صدور قوم مءمنين} [التوبة: ] «خزاعة حلفاء رسول الله صلي الله عليه وسلم»
 
 اخبرنا احمد بن عثمان فيما كتب الي ثنا احمد بن مفضل، ثنا اسباط، عن السدي قوله: {ويشف صدور قوم مءمنين} [التوبة: ] قال: " هم خزاعة، يشفي صدورهم من بني بكر
 
  قوله تعالي: {ويذهب غيظ قلوبهم} 
 [التوبة: ]
 
 حدثنا ابي ثنا عفان، ثنا حماد بن زيد، ثنا ايوب، عن عكرمة {ويذهب غيظ قلوبهم} [سورة: التوبة، اية رقم: ] قال: " خزاعة
 
 اخبرنا احمد بن عثمان فيما كتب الي ثنا احمد بن مفضل، ثنا اسباط، عن السدي، {ويذهب غيظ قلوبهم} [التوبة: ] قال: «هذا حين قتلهم بنو بكر واعانهم قريش»
 
  قوله تعالي: {ويتوب الله علي من يشاء} 
 [التوبة: ]
 
 حدثنا ابي، حدثنا عفان بن مسلم، ثنا حماد بن زيد ثنا ايوب عن عكرمة، {ويتوب الله علي من يشاء} [التوبة: ] : «خزاعة»
 
  قوله تعالي: {والله عليم} 
 [البقرة: ]
 
 حدثنا محمد بن العباس مولي بني هاشم، ثنا محمد بن عمرو، ثنا سلمة ثنا محمد بن اسحاق، {عليم} [التوبة: ] اي «عليم بما يخفون»
 
 حدثنا عصام بن رواد ثنا ادم، حدثنا ابو جعفر الرازي، عن الربيع، عن ابي العالية قوله: {حكيم} [التوبة: ] قال: «حكيم في امره»
 
 حدثنا محمد بن يحيي، انبا ابو غسان، ثنا سلمة، قال محمد بن اسحاق: حدثني محمد بن جعفر بن الزبير قوله: {حكيم} [التوبة: ] قال: «الحكيم في عذره وحجته الي عباده»
 
  قوله تعالي: {ام حسبتم ان تتركوا ولما يعلم الله الذين جاهدوا} 
 [التوبة: ]
 
 حدثنا محمد بن العباس ثنا محمد بن عمرو ثنا سلمة قال: قال محمد بن اسحاق: قوله {ولما يعلم الله الذين جاهدوا منكم} [ال عمران: ] يقول: «ولم اختبركم بالشدة وابتلكم بالمكاره»
 
 اخبرنا ابو يزيد القراطيسي فيما كتب الي انبا اصبغ قال: سمعت عبد الرحمن بن زيد بن اسلم، يقول في قول الله {ام حسبتم ان تتركوا ولما يعلم الله الذين جاهدوا منكم} [التوبة: ] قال: " ابي ان يدعهم دون التمحيص وقرا {ام حسبتم ان تتركوا ولما يعلم الله الذين جاهدوا منكم} [التوبة: ] "
 
  قوله تعالي: {ولم يتخذوا من دون الله ولا رسوله ولا المءمنين وليجة} 
 [التوبة: ]
 
 حدثنا ابو زرعة، ثنا منجاب، انبا بشر بن عمارة، عن ابي روق، عن الضحاك، عن ابن عباس، قوله: {وليجة} [التوبة: ] قال: " الوليجة: البطانة من غير دينهم "
 
 حدثنا ابي ثنا محمد بن عبد الاعلي الصنعاني، ثنا محمد بن ثور عن معمر، عن الحسن: {وليجة} [التوبة: ] قال " هو الكفر والنفاق او قال: احدهما "
 
 حدثنا كثير بن شهاب القزويني ثنا محمد بن سعيد، ثنا ابو جعفر عن الربيع في قوله: {وليجة} [التوبة: ] قال: «دخلاء»
 
 اخبرنا احمد بن عثمان بن حكيم فيما كتب الي ثنا احمد بن مفضل، ثنا اسباط، عن السدي قوله: {ولا المءمنين وليجة} [التوبة: ] قال: «يتولجها من الولاية للمشركين»
 
  قوله تعالي: {ما كان للمشركين} 
 [التوبة: ]
 
 وبه عن السدي قوله: {ما كان للمشركين ان يعمروا مساجد الله} [التوبة: ] يقول: «ما ينبغي لهم ان يعمروه»
 
  قوله تعالي: {ان يعمروا مساجد الله} 
 [التوبة: ]
 
 حدثنا علي بن الحسين، ثنا مسدد حدثنا معتمر عن عمران بن حدير، عن عكرمة في قوله: {ما كان للمشركين ان يعمروا مساجد الله} [التوبة: ] قال: «انما هو مسجد واحد» ، قال: وقال: «ان الصفا والمروة من مساجد الله»
 
  قوله تعالي: {شاهدين علي انفسهم بالكفر} 
 [التوبة: ]
 
 اخبرنا احمد بن عثمان فيما كتب الي ثنا احمد بن مفضل ثنا اسباط، عن السدي قوله: شاهدين علي انفسهم بالكفر " فان النصراني يسال: ما انت؟ فيقول: نصراني، واليهودي يقول: يهودي، والصابء يقول: صابء والمشرك يقول: اذا سالته ما دينك؟ فيقول: مشرك لم يكن ليقوله احد الا العرب "
 
  قوله تعالي: {اولءك حبطت اعمالهم} 
 [التوبة: ]
 
 حدثنا ابو بكر بن ابي موسي ثنا هارون بن حاتم ثنا عبد الرحمن بن ابي حماد عن اسباط عن السدي، عن ابي مالك، قوله {حبطت اعمالهم} [التوبة: ] يعني: «بطلت اعمالهم»
 
  قوله تعالي: {وفي النار هم خالدون} 
 [التوبة: ]
 
 حدثنا محمد بن يحيي انبا ابو غسان، ثنا سلمة قال: قال محمد بن اسحاق: ثنا محمد بن ابي محمد، عن سعيد بن جبير او عكرمة، عن ابن عباس قوله: {هم خالدون} [التوبة: ] «اي خالدا ابدا» وروي عن السدي نحو ذلك
 
  قوله تعالي: {انما يعمر مساجد الله} 
 [التوبة: ]
 
 حدثنا يونس بن عبد الاعلي ثنا عبد الله بن وهب، انبا عمرو بن الحارث عن دراج، حدثنا عن ابي الهيثم، عن ابي سعيد الخدري قال: قال رسول الله صلي الله عليه وسلم: «اذا رايتم الرجل يعتاد المساجد فاشهدوا عليه بالايمان» قال الله: {انما يعمر مساجد الله من امن بالله} [التوبة: ]
 
  قوله تعالي: {من امن بالله} 
 [البقرة: ]
 
 حدثنا ابي ثنا ابو صالح، ثنا معاوية بن صالح، عن علي بن ابي طلحة، عن ابن عباس قوله: {من امن بالله} [البقرة: ] يعني: «من وحد الله عز وجل»
 
  قوله تعالي: {واليوم الاخر} 
 [البقرة: ]
 
 وبه عن ابن عباس قوله {واليوم الاخر} [التوبة: ] يعني: «امن بالله وامن بما انزل الله تبارك وتعالي»
 
  قوله تعالي: {واقام الصلاة} 
 [البقرة: ]
 
 وبه عن ابن عباس {واقام الصلاة} [البقرة: ] «يعني الصلوات الخمس»
 
  قوله تعالي: {ولم يخش الا الله} 
 [التوبة: ]
 
 وبه عن ابن عباس يقول: «ولم يعبد الا الله»
 
  قوله تعالي: {فعسي اولءك ان يكونوا من المهتدين}
 
 وبه عن ابن عباس يقول: " ان اولءك هم المفلحون كقوله لنبيه صلي الله عليه وسلم {عسي ان يبعثك ربك مقاما محمودا} [الاسراء: ] يقول: ان ربك سيبعثك مقاما محمودا وهي الشفاعة، وكل عسي في القران واجبة "
 
  قوله تعالي: {اجعلتم سقاية الحاج} 
 [التوبة: ]
 
 حدثنا ابي ثنا سعيد بن سليمان الواسطي ثنا سنان بن هارون عن حجاج، عن عطاء {اجعلتم سقاية الحاج} [التوبة: ] قال: «زمزم»
 
  قوله تعالي: {وعمارة المسجد الحرام} 
 [التوبة: ]
 
 اخبرنا محمد بن سعد فيما كتب الي ثنا ابي، ثنا عمي عن ابيه عن جده عن ابن عباس قوله: {اجعلتم سقاية الحاج وعمارة المسجد الحرام} [التوبة: ] " وذلك ان المشركين قالوا: عمارة بيت الله وقيام علي السقاية خير ممن امن وجاهد فكانوا يفخرون بالحرم ويستكبرون به من اجل انهم اهله وعماره فذكر الله تعالي استكبارهم واعراضهم فقال لاهل الحرم من المشركين {قد كانت اياتي تتلي عليكم فكنتم علي اعقابكم تنكصون مستكبرين به سامرا تهجرون} [المءمنون: ]
 
  قوله تعالي: {كمن امن بالله واليوم الاخر وجاهد في سبيل الله} 
 [التوبة: ]
 
 حدثنا ابي ثنا ابو توبة الربيع بن نافع ثنا معاوية بن سلام عن زيد بن سلام انه سمع ابا سلام يقول: حدثني النعمان بن بشير قال: كنت عند منبر رسول الله صلي الله عليه وسلم فقال رجل: لا ابالي ان لا اعمل عملا بعد الاسلام الا ان اسقي الحاج، وقال الاخر: الا ان اعمر المسجد الحرام، وقال اخر: الجهاد في سبيل الله افضل مما قلتم فزجرهم عمر بن الخطاب وقال: لا ترفعوا اصواتكم عند منبر رسول الله صلي الله عليه وسلم وهو يوم الجمعة ولكن اذا صليت الجمعة دخلت فاستفتيته فيما اختلفتم فيه فانزل الله تعالي {اجعلتم سقاية الحاج وعمارة المسجد الحرام كمن امن بالله واليوم الاخر} [التوبة: ] الي اخر الاية
 
 حدثنا ابي ثنا ابن ابي عمر العدني ثنا سفيان عن ابن ابي خالد وزكريا عن الشعبي قال: تكلم علي والعباس وشيبة في السقاية والحجابة فانزل الله تعالي: {اجعلتم سقاية الحاج وعمارة المسجد الحرام كمن امن بالله واليوم الاخر وجاهد في سبيل الله} [التوبة: ]
 
 حدثنا الحسن بن محمد بن الصباح ثنا مروان بن معاوية الفزاري عن اسماعيل بن ابي خالد قال: قال الشعبي: " نزلت {سقاية الحاج} [التوبة: ] في عباس وعلي رضي الله عنهما "
 
  والوجه الثاني
 
 حدثنا ابي، ثنا ابو صالح كاتب الليث ثنا معاوية بن صالح عن علي بن ابي طلحة، عن ابن عباس في قوله: {اجعلتم سقاية الحاج وعمارة المسجد الحرام كمن امن بالله واليوم الاخر} [التوبة: ] قال العباس بن عبد المطلب حين اسر يوم بدر: لءن كنتم سبقتمونا بالاسلام والهجرة والجهاد لقد كنا نعمر المسجد الحرام ونسقي الحاج ونفك العاني قال الله تبارك وتعالي: {اجعلتم سقاية الحاج وعمارة المسجد الحرام كمن امن بالله واليوم الاخر} [التوبة: ]
 
  والوجه الثالث
 
 حدثنا الحجاج بن حمزة ثنا شبابة ثنا ورقاء عن ابن ابي نجيح، عن مجاهد، قوله: {سقاية الحاج وعمارة المسجد الحرام} [التوبة: ] قال: " امروا بالهجرة فقال العباس بن عبد المطلب: انا اسقي الحاج وقال طلحة اخو بني عبد الدار: انا احجب الكعبة فلا اهاجر
 
  قوله تعالي: {لا يستوون عند الله} 
 [التوبة: ]
 
 اخبرنا محمد بن سعد فيما كتب الي ثنا ابي ثنا عمي عن ابيه عن جده، عن ابن عباس قوله {لا يستوون عند الله والله لا يهدي القوم الظالمين} [التوبة: ] يعني: «الذين زعموا انهم اهل العمارة»
 
  قوله تعالي: {والله لا يهدي القوم الظالمين} 
 [البقرة: ]
 
 حدثنا ابي ثنا ابو صالح ثنا معاوية بن صالح عن علي بن ابي طلحة، عن ابن عباس {والله لا يهدي القوم الظالمين} [التوبة: ] ، «يعني ان ذلك كان في الشرك ولا اقبل ما كان في الشرك»
 
 اخبرنا محمد بن سعد فيما كتب الي ثنا ابي ثنا عمي عن ابيه عن جده، عن ابن عباس قوله {والله لا يهدي القوم الظالمين} [البقرة: ] «فسماهم الله ظالمين بشركهم فلم تغن عنهم العمارة شيءا»
 
  قوله تعالي: {الذين امنوا وهاجروا} 
 [الانفال: ]
 
 وبه عن ابن عباس قوله: {الذين امنوا وهاجروا وجاهدوا في سبيل الله باموالهم وانفسهم} [التوبة: ] يقول: " لا هجرة بعد الفتح انما هو الشهادة بعد ذلك وذلك ان المءمنين كانوا علي عهد رسول الله صلي الله عليه وسلم علي ثلاث منازل منهم: المءمن المهاجر المباين لقومه في الهجرة خرج الي قوم مءمنين في ديارهم وعقارهم واموالهم "
 
  قوله تعالي: {اعظم درجة} 
 [التوبة: ]
 
 حدثنا ابي ثنا سهل بن عثمان ثنا يحيي هو ابن ابي زاءدة، ثنا موسي بن عبيدة، عن عبد الله بن عبيدة قال: " قال علي للعباس: لو هاجرت الي المدينة قال: اولست في افضل الهجرة؟ الست اسقي الحاج واعمر المسجد الحرام؟ فنزلت هذه الاية يعني قوله: {اعظم درجة عند الله} [التوبة: ] فجعل الله للمدينة فضل درجة علي مكة
 
  قوله تعالي: {واولءك هم الفاءزون} 
 [التوبة: ]
 
 اخبرنا احمد بن عثمان بن حكيم فيما كتب الي ثنا احمد بن مفضل، حدثنا اسباط، عن السدي قوله: {واولءك هم الفاءزون} [التوبة: ] قال: «الي نعيم مقيم»
 
  قوله تعالي: {يبشرهم ربهم برحمة منه ورضوان} [التوبة: ] الي قوله: {مقيم} 
 [الماءدة: ]
 
 حدثنا ابو بكر بن ابي موسي الانصاري ثنا هارون بن حاتم ثنا عبد الرحمن بن ابي حماد حدثنا اسباط، عن السدي قوله: {مقيم} [الماءدة: ] يعني: «داءما لا ينقطع»
 
  قوله تعالي: {خالدين فيها ابدا} 
 [النساء: ]
 
 حدثنا محمد بن يحيي ثنا ابو غسان ثنا سلمة قال: قال محمد بن اسحاق: ثنا محمد بن ابي محمد ثنا عكرمة او سعيد بن جبير عن ابن عباس، {خالدين فيها} [التوبة: ] : «يخبرهم ان الثواب بالخير مقيم علي اهله لا انقطاع له ابدا»
 
  قوله تعالي: {ان الله عنده اجر عظيم} 
 [التوبة: ]
 
 حدثنا عبد الرحمن بن خلف بن عبد الرحمن بن الضحاك النصري الحمصي، ثنا محمد بن شعيب بن شابور، عن الاوزاعي، ثنا يحيي بن ابي كثير، {اجر عظيم} [التوبة: ] قال: " الاجر العظيم: الجنة "
 
 حدثنا ابو زرعة ثنا يحيي بن عبد الله بن بكير عن عبد الله بن لهيعة ثنا عطاء بن دينار، عن سعيد بن جبير {اجر عظيم} [التوبة: ] يعني: «جزاء وافرا في الجنة»
 
  قوله تعالي: {يا ايها الذين امنوا لا تتخذوا اباءكم واخوانكم اولياء} 
 [التوبة: ]
 
 حدثنا حجاج بن حمزة ثنا شبابة ثنا ورقاء عن ابن ابي نجيح، عن مجاهد قوله: {سقاية الحاج} [التوبة: ] : " امروا بالهجرة فقال العباس بن عبد المطلب: انا اسقي الحاج وقال طلحة اخو بني عبد الدار: انا احجب الكعبة فلا نهاجر فانزلت {لا تتخذوا اباءكم واخوانكم اولياء ان استحبوا الكفر علي الايمان} [التوبة: ]
 
 قرات علي محمد بن الفضل بن موسي ثنا محمد بن علي بن الحسين انبا محمد بن مزاحم، حدثنا بكير بن معروف، عن مقاتل بن حيان قوله: {لا تتخذوا اباءكم واخوانكم اولياء ان استحبوا الكفر علي الايمان ومن يتولهم منكم فاولءك هم الظالمون} [التوبة: ] يعني: " الهجرة يقول: هاجروا الي النبي صلي الله عليه وسلم "
 
  قوله تعالي: {ان استحبوا الكفر} [التوبة: ] حدثنا ابو بكر بن ابي موسي ثنا هارون بن حاتم، ثنا عبد الرحمن بن ابي حماد، عن اسباط، عن السدي، عن ابي مالك قوله: {استحبوا} [التوبة: ] قال: «اختاروا»
 
  قوله تعالي: {قل ان كان اباءكم وابناءكم} 
 [التوبة: ]
 
 حدثنا ابي ثنا ابو صالح كاتب الليث ثنا الليث بن سعد ثنا ابراهيم بن نشيط الوعلاني عن علي بن بحير المعافري، ان رجلا اراد الجهاد في سبيل الله فمنعته امه فاتي عمرو بن يزيد الخولاني يساله عن ذلك فقال له عمرو بن يزيد: {قل ان كان اباءكم وابناءكم واخوانكم وازواجكم وعشيرتكم واموال اقترفتموها وتجارة تخشون كسادها} [التوبة: ] الاية
 
 حدثنا ابي ثنا القاسم بن عثمان الجوعي ثنا عبيد بن عياش عن علي بن بكار عن ابن عون قال: " كان اذا شاوره احد في الغزو وله ابوان فتلا عليه هذه الاية {قل ان كان اباءكم وابناءكم} [التوبة: ] الي اخر الاية ثم سكت فلا يقول له: اخرج ولا اقم "
 
  قوله تعالي: {واموال اقترفتموها} 
 [التوبة: ]
 
