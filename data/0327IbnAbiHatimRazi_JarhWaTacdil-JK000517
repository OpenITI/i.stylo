  عنبسة بن سعيد بن العاص القرشي الاموي كان بالشام يكني بابي خالد سمع ابا هريرة سمع منه الزهري واسماء بن عبيد وضمرة بن حبيب سمعت ابي يقول ذلك وسالته عنه فقال لا باس به 
  عنبسة بن سعيد بن الضريس الاسدي ابو بكر قاضي الري علي اهل الذمة كوفي سكن الري روي عن ابي اسحاق الهمداني والاعمش والزبير بن عدي وعاصم بن عبيد الله روي عنه بن المبارك وجرير وحكام واسحاق بن سليمان وهارون بن المغيرة سمعت ابي يقول ذلك نا عبد الرحمن قال نا ابي قال كان احمد بن حنبل يقدمه علي ابي جعفر الرازي نا عبد الرحمن انا عبد الله بن احمد بن محمد بن حنبل فيما كتب الي قال سمعت ابي يقول عنبسة بن سعيد اصح حديثا من ابي جعفر الرازي حدث عنه بن المبارك نا عبد الرحمن انا علي بن ابي طاهر فيما كتب الي نا ابو بكر الاثرم قال سمعت ابا عبد الله احمد بن حنبل يقول عنبسة قاضي الري ثقة نا عبد الرحمن انا يعقوب بن اسحاق فيما كتب الي قال نا عثمان بن سعيد قال قلت ليحيي بن معين عنبسة بن سعيد قال ثقة نا عبد الرحمن قال سالت ابي عن عنبسة قاضي الري قال ثقة لا باس به نا عبد الرحمن قال سالت ابا زرعة عن عنبسة قاضي ثقة كان كوفي الاصل
  عنبسة بن سعيد الواسطي اخو ابي الربيع السمان روي عن الحسن روي عنه علي الصيرفي بان عنبسة القطان اخا ابي الربيع كان مختلطا لا يروي عنه قد سمعت منه وجلست اليه نا عبد الرحمن قال سالت ابي عن عنبسة اخي ابي الربيع فقال ضعيف الحديث ياتي بالطامات
  عنبسة بن سعيد البصري روي عن حنظلة عن انس روي عنه عقبة بن خالد السكوني ومحمد بن عيسي بن الطباع سمعت ابي يقول ذلك وسالته عنه فقال هو ضعيف الحديث نا عبد الرحمن قال سءل ابو زرعة عن عنبسة بن سعيد البصري هذا فقال ضعيف الحديث
  عنبسة بن سعيد البصري روي عن الزهري روي عنه ابو عاصم النبيل سمعت ابي يقول ذلك ويقول هو ضعيف الحديث 
  عنبسة بن سعيد بن ابان القرشي الاموي الكوفي ابو خالد اخو يحيي بن سعيد الاموي واخو محمد بن سعيد وعبيد بن سعيد روي عن شريك وابن المبارك وكان صاحب حديث الكوفة هو ونوفل ويحيي بن ادم سمعت ابي يقول ذلك ويقول كان من حفاظ اهل الكوفة وكان من اصدق اخوته واحفظهم روي عنه احمد الدورقي
  عنبسة بن سعيد بن غنيم الكلاعي روي عن مكحول روي عنه اسماعيل بن عياش والوليد بن مسلم وعمرو بن بشر بن السرح سمعت ابي يقول ذلك وسالته عنه فقال ليس بالقوي نا عبد الرحمن قال سءل ابو زرعة عن عنبسة بن سعيد بن غنيم فقال احاديثه منكرة ولم يسمع من عكرمة شيءا
  عنبسة بن سعيد بن كثير بن عبيد وجده كثير بن عبيد رضيع عاءشة مولي ابي بكر الصديق رضي الله عنه وهو بن ابي العنبس روي عن جده عن ابي هريرة روي عنه عبد الرحمن بن مهدي والانصاري وابو الوليد الطيالسي سمعت ابي يقول ذلك نا عبد الرحمن نا ابي نا ابو الوليد نا عنبسة بن سعيد القرشي وكان ثقة نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال عنبسة بن سعيد بن كثير بن عبيد ثقة نا عبد الرحمن قال سءل ابي عن عنبسة بن سعيد الذي روي عنه ابو الوليد فقال ثقة
  عنبسة بن ابي راءطة الغنوي الاعور روي عن الحسن روي عنه وهيب وعبد الوهاب الثقفي سمعت ابي يقول ذلك نا عبد الرحمن نا محمد بن احمد بن البراء قال قال علي بن المديني عنبسة الغنوي ضعيف نا عبد الرحمن قال سالت ابي عن عنبسة الاعور فقال هو عنبسة بن ابي راءطة الاعور وهو عنبسة الغنوي شيخ روي عنه عبد الوهاب الثقفي احاديث حسانا وروي عنه وهيب وليس بحديثه باس
  عنبسة بن ابي سفيان اخو ام حبيبة ابو عامر روي عن ام حبيبة روي عنه مكحول وعمرو بن اوس الثقفي سمعت ابي يقول ذلك 
  عنبسة بن ابي عمرو ويقال عنبسة عن بن ابي عمرو ويقال عنبسة عن بن عمر وروي عن النبي صلي الله عليه وسلم مرسل روي عنه ايمن بن نابل سمعت ابي يقول ذلك وسالته عنه فقال هو شيخ مجهول قلت ايهما اصح قال الله اعلم
  عنبسة ابو نافع الليثي راي انس بن مالك يصلي الجمعة روي عنه عبد الصمد بن عبد الوارث وابو الوليد سمعت ابي يقول ذلك قال ابو محمد روي عنه مسلم بن ابراهيم
  عنبسة بن الازهر الشيباني ابو يحيي قاضي جوزجان كوفي روي عن سلمة بن كهيل وسماك بن حرب روي عنه يونس بن بكير وابراهيم بن المختار واحمد بن ابي طيبة سمعت ابي يقول ذلك وسالته عنه فقال لا باس به يكتب حديثه ولا يحتج به
  عنبسة بن عبد الواحد وهو بن امية بن عبد الله بن سعيد بن العاص الاموي القرشي ابو خالد الاعور كوفي سمع بيانا وعبد الملك بن عمير وعوفا وسعيدا الجريري سمعت ابي يقول ذلك قال ابو محمد وروي عن منصور بن عبد الرحمن روي عنه منصور بن ابي مزاحم نا عبد الرحمن قال سمعت ابي يقول روي عنه محمد بن بكار بن الريان وابراهيم بن موسي الرازي وابراهيم بن مهدي نا عبد الرحمن انا علي بن ابي طاهر فيما كتب الي قال انا ابو بكر الاثرم قال قلت لابي عبد الله احمد بن حنبل عنبسة بن عبد الواحد القرشي كيف هو قال ما اري به باسا نا عبد الرحمن انا ابو بكر بن ابي خيثمة فيما كتب الي قال سمعت يحيي بن معين يقول عنبسة بن عبد الواحد القرشي ثقة نا عبد الرحمن سالت ابي عن عنبسة بن عبد الواحد فقال ثقة ليس به باس نا عبد الرحمن قال سال ابو زرعة عن عنبسة بن عبد الواحد فقال لا باس به 
  عنبسة بن عمار الدوسي ويقال القرشي سمع بن عمرو وعكرمة وحميد بن عبد الرحمن وابا سلمة روي عنه عيسي بن يونس ومروان بن معاوية وابو معاوية وسعيد بن محمد الوراق سمعت ابي يقول ذلك
  عنبسة الحداد وهو عنبسة بن مهران وفرق بينهما بعض الناس وهما واحد ري عن الزهري ومكحول روي عنه عبد الله بن رجاء المكي وابو عاصم النبيل ومكي بن ابراهيم سمعت ابي يقول ذلك قال ابو محمد وروي عن السدي نا عبد الرحمن قال سالت ابي عنه فقال منكر الحديث ثنا عبد الرحمن انا يعقوب بن اسحاق فيما كتب الي قال انا عثمان بن سعيد الدارمي قال قلت ليحيي بن معين عنبسة بن مهران عن الزهري من عنبسة الذي يروي عنه يحيي بن المتوكل فقال لا اعرفه قال ابو محمد لانه مجهول
  عنبسة الوزان سمع ابا لبابة روي عنه يحيي بن سعيد القطان سمعت ابي يقول ذلك نا عبد الرحمن قال سالت ابي عنه فقال لا باس به
  عنبسة بن خالد بن يزيد الايلي بن اخي يونس بن يزيد روي عن عمه يونس بن يزيد روي عنه احمد بن صالح سمعت ابي يقول ذلك نا عبد الرحمن قال سمعت محمد بن مسلم يقول روي بن وهب عن عنبسة بن خالد قلت لمحمد بن مسلم فعنبسة بن خالد احب اليك او وهب الله بن راشد فقال سبحان الله ومن يقرن عنبسة الي وهب الله ما سمعت بوهب الله الا الان منكم ثنا عبد الرحمن قال سالت ابي عن عنبسة بن خالد فقال كان علي خراج مصر وكان يعلق النساء بالثدي
  عنبسة بن عبد الرحمن بن عنبسة القرشي من ال سعيد بن العاص روي عن شبيب بن بشر صاحب انس وعن عبد الله بن عبد الواحد ومحمد بن زاذان روي عنه الوليد بن مسلم ومحمد بن عبد الله الخزاعي سمعت ابي يقول ذلك نا عبد الرحمن انا ابو بكر بن ابي خيثمة فيما كتب الي قال سمعت يحيي بن معين يقول عنبسة بن عبد الرحمن الذي يحدث عن محمد بن زاذان وحدث عنه الوليد بن مسلم لا شء نا عبد الرحمن قال سالت ابي عن عنبسة بن عبد الرحمن القرشي فقال هو متروك الحديث كان يضع الحديث وكان عند احمد بن يونس عنه شء فلم نكتب عنه علي العمد 
  عنبسة بن هبيرة الطاءي روي عن عكرمة مولي بن عباس روي عنه عثمان بن عبد الرحمن الحراني الطاءفي نا عبد الرحمن قال سالت ابي عنه فقال مجهول
  عنبسة بن عبد الرحمن روي عن عقبة بن ابي صالح وعلي بن سعيد روي عنه سعيد بن زكريا المداءني سمعت ابي يقول ذلك قال ابو محمد روي عن علاق بن مسلم عن انس روي عنه اسماعيل بن ابان نا عبد الرحمن قال سالت ابي عنه فقال هو ضعيف الحديث نا عبد الرحمن قال سءل ابو زرعة عنه فقال هو منكر الحديث واهي الحديث قلت احسب ان عنبسة بن عبد الرحمن هذا هو القرشي الذي يحدث عن شبيب بن بشر
  عنبسة بن هلال العنزي روي عن الحجاج الجزري عن انس بن مالك روي عنه عبد الله بن عمر بن محمد بن ابان المعروف بالمشك
  عنبسة روي عن زيد بن اسلم روي عنه محمد بن القاسم الاسدي نا عبد الرحمن قال سالت ابي عنه فقال هو ضعيف الحديث
  عنبسة بن الفضل روي عن عبيد الله بن ابي بكر بن انس روي عنه محمد بن سعيد بن زياد الاثرم
  عنبسة بن نجاد العابد سمع جعفر بن محمد وجابرا الجعفي وعبد الله بن الحسن روي عنه زيد بن حباب وابو غسان النهدي وعثمان بن ابي شيبة سمعت ابي يقول ذلك قال ابو محمد وروي عن حسين بن علي بن حسين بن علي بن ابي طالب وهو الذي يقال له حسين الاصغر 
  عنبسة بن حميد روي عن عامر الشعبي روي عنه شريك بن عبد الله
   ( باب من روي عنه العلم ممن يسمي علقمة )
  علقمة بن الفغواء الخزاعي ازدي حجازي سمع النبي صلي الله عليه وسلم وروي عن عمر رضي الله عنه روي عنه ابنه عبد الله سمعت ابي يقول ذلك
  علقمة بن الحويرث الغفاري فيما رواه شباب العصفري خليفة بن خياط ولا يعتمد علي روايته رواه عن فضيل بن سليمان النميري عن محمد بن مطرف عن جدته عن علقمة بن الحويرث من اصحاب النبي صلي الله عليه وسلم عن النبي صلي الله عليه وسلم قال زنا العينين النظر حدثنا عبد الرحمن سمعت ابي يقول بعض ذلك وبعضه من قبلي
  علقمة بن رمثة البلوي مصري له صحبة روي عنه زهير بن قيس البلوي سمعت ابي يقول ذلك
  علقمة بن قيس النخعي ابو شبل روي عن عمر رضي الله عنه وعلي رضي الله عنه وسمع منه الشعبي وابراهيم النخعي سمعت ابي يقول ذلك وسمعته يقول سمعت احمد بن حنبل يقول قال يحيي بن سعيد القطان علقمة عم الاسود بن يزيد والاسود خال ابراهيم نا عبد الرحمن حدثنا محمد بن حمويه بن الحسن قال سمعت ابا طالب يقول قال لاحمد بن حنبل علقمة بن قيس فقال ثقة من اهل الخير نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال علقمة يعني بن قيس ثقة نا عبد الرحمن قال سمعت ابي يقول ابطن الناس بعبد الله بن مسعود علقمة نا عبد الرحمن اخبرنا يعقوب بن اسحاق فيما كتب الي قال انا عثمان بن سعيد قال سالت يحيي بن معين قلت علقمة احب اليك عن عبد الله او عبيدة فلم يخبر قال عثمان كلاهما ثقتان وعلقمة اعلم بعبد الله نا عبد الرحمن نا احمد بن سنان نا عبد الرحمن بن مهدي نا سفيان عن الاعمش عن عمارة عن بن معمر قال كنا جلوسا عند عمرو بن شرحبيل فقال قوموا بنا الي ابطن الناس بعبد الله فذهب الي علقمة نا عبد الرحمن نا محمد بن عبد الله بن يزيد المقري نا سفيان عن ابي اسحاق قال كان علقمة من الربانيين نا عبد الرحمن نا احمد بن سنان نا ابو معاوية نا الاعمش عن ابراهيم قال كان علقمة يشبه بعبد الله يعني بن مسعود 
  علقمة بن وقاص الليثي العتواري سمع عمر بن الخطاب وعاءشة سمع منه الزهري ومحمد بن ابراهيم التيمي وابناه عمرو وعبد الله سمعت ابي يقول ذلك
  علقمة بن واءل الحضرمي الكندي الكوفي روي عن ابيه والمغيرة بن شعبة وطارق بن زياد سمع منه سماك بن حرب وعبد الملك بن عمير وجامع بن مطر وموسي بن عمير العنبري سمعت ابي يقول ذلك قال هبة الله الطبري بدل موسي بن عمير العنبري له اهو قيس بن مسلم العنبري الذي روي عن علقمة روي عنه ابو نعيم
  علقمة بن نضلة بن عبد الرحمن بن علقمة الكناني روي عن عمر رضي الله عنه مرسل روي عنه عثمان بن ابي سليمان المكي سمعت ابي يقول ذلك
  علقمة والد نافع حجازي سمع كعب بن مالك روي عنه بن القاري سمعت ابي يقول ذلك
  علقمة بن سفيان بن عبد الله الثقفي الطاءفي سمع ابا ايوب وعقبة بن عامر روي عنه ابو الزبير سمعت ابي يقول ذلك
  علقمة بن الغرق سمع ابا هريرة وابن عباس روي عنه سعيد بن زياد الشيباني سمعت ابي يقول ذلك
  علقمة بن بجالة بن الزبرقان سمع ابا هريرة قوله روي عنه عكرمة بن عمار سمعت ابي يقول ذلك 
  علقمة بن ابي علقمة وهو بن بلال مديني مولي عاءشة سمع من انس ومن امه مرجانة ومن الاعرج روي عنه مالك بن انس وسليمان بن بلال وعبد العزيز بن محمد وعبد الرحمن بن ابي الزناد سمعت ابي يقول ذلك نا عبد الرحمن قال قرء علي العباس بن محمد الدوري قال سمعت يحيي بن معين يقول علقمة بن ابي علقمة ثقة نا عبد الرحمن قال سالت ابي عن علقمة فقال صالح الحديث لا باس به ذكره ابي عن اسحاق بن منصور عن يحيي بن معين يقول علقمة بن ابي علقمة ثقة
  علقمة بن شهاب القشيري روي عن معاذ بن جبل ولا يعلم له سماع من معاذ روي عنه ابنه محفوظ بن علقمة وسعيد بن عبد العزيز سمعت ابي يقول ذلك
  علقمة بن يزيد ويقال حرام بن معاوية قال كتب الينا عمر رضي الله عنه لا يجاورنكم الخنازير روي عنه زيد بن رفيع سمعت ابي يقول ذلك وسالته عنه فقال ليس بمشهور
  علقمة بن مرثد الحضرمي الكوفي روي عن سعيد بن عبيدة وسليمان بن بريدة روي عنه سفيان وشعبة سمعت ابي يقول ذلك نا عبد الرحمن اخبرنا عبد الله بن احمد بن محمد بن حنبل فيما كتب الي قال سمعت ابي يقول علقمة بن مرثد ثقة ثبت في الحديث نا عبد الرحمن قال سالت ابي عن علقمة بن مرثد صالح الحديث
  علقمة بن عبد الله المزني اخو بكر بن عبد الله المزني روي عن ابيه روي عنه بكر بن عبد الله المزني وفضاء والد محمد بن فضاء سمعت ابي يقول ذلك نا عبد الرحمن نا محمد بن احمد بن البراء قال قال علي بن عبد الله المديني علقمة بن عبد الله المزني ثقة روي عنه قتادة وحميد يعني الطويل وعوف يعني الاعرابي
  علقمة بن هلال الكلبي من بني تم الله روي عن ابيه عن جده انه قدم علي النبي صلي الله عليه وسلم الحديبية روي الوليد بن مسلم عمن سمع علقمة سمعت ابي يقول ذلك نا عبد الرحمن قال سالت ابي عنه فقال علقمة وابوه مجهولان 
  علقمة روي عن عاصم روي عنه معتمر بن سليمان سمعت ابي يقول ذلك وسءل عنه فقال شيخ لمعتمر
   ( باب تسمية من روي عنه العلم ممن يسمي عياضا )
  عياض والد عبد الله بن عياض له صحبة روي ان النبي صلي الله عليه وسلم اتي هوازن في اثني عشر الفا روي عنه ابنه عبد الله بن عياض سمعت ابي يقول ذلك
  عياض بن حمار المجاشعي دارمي بصري له صحبة سمعت ابي يقول ذلك قال ابو محمد روي عنه مطرف بن عبد الله بن الشخير والحسن البصري
  عياض بن غنم القرشي الفهري مصري له صحبة عامل عمر مات في زمن عمر رضي الله عنه عروة بن الزبير وجبير بن نفير وشهر بن حوشب وشريح بن عبيد سمعت ابي يقول ذلك
  عياض الاشعري روي عن النبي صلي الله عليه وسلم مرسل انه قرا فسوف ياتي الله بقوم يحبهم ويحبونه وهو تابعي وروي عن ابي موسي الاشعري عن النبي صلي الله عليه وسلم روي بعضهم عن شعبة عن سماك عن عياض عن النبي صلي الله عليه وسلم ومنهم من يروي عن شعبة عن سماك عن عياض عن ابي موسي عن النبي صلي الله عليه وسلم وراي ابا عبيدة سمع منه سماك بن حرب سمعت ابي يقول ذلك
  عياض بن خليفة سمع عمر وعليا رضي الله عنهما روي عنه الزهري ويعقوب بن عتبة وعمر بن عبد الرحمن سمعت ابي يقول ذلك 
  عياض بن صبري الكلبي بن عم اسامة بن زيد وختنه علي ابنته روي عن اسامة بن زيد روي الزهري عن مسافع عنه سمعت ابي يقول ذلك
  عياض بن نضلة سمع عليا وابا موسي روي عنه ابنه عباس وابو العلاء يزيد بن عبد الله بن الشخير سمعت ابي يقول ذلك
  عياض بن هلال الانصاري ويقال هلال بن عياض وعياض بن هلال اشبه سمع ابا سعيد الخدري سمع منه يحيي بن ابي كثير سمعت ابي يقول ذلك
  عياض بن غطيف ويقال غطيف بن الحارث الشامي والصحيح غطيف بن الحارث قال اتينا ابا عبيدة بن الجراح روي عنه الوليد بن عبد الرحمن وسليم بن عامر سمعت ابي يقول ذلك
  عياض بن وهب بن عبيد الله بن ابي حبيبة سمع خثيما القاري روي عنه سعيد بن حسان سمعت ابي يقول ذلك
  عياض بن عبد الرحمن الحجبي روي عن بن ابي ليلي عن ابيه عن علي رضي الله عنه القضاة ثلاثة روي عنه
  عياض بن عبد الله بن سعد بن ابي سرح روي عن ابي هريرة وابي سعيد الخدري روي عنه المقبري وكعب بن علقمة وزيد بن اسلم والحارث بن ابي ذباب ومحمد بن عجلان وعبيد الله بن عمر وداود بن قيس سمعت ابي يقول ذلك نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال عياض بن عبد الله بن سعد بن ابي سرح ثقة 
  عياض بن عبد الله القرشي الفهري روي عن مخرمة بن سليمان وابراهيم بن عبيد بن رفاعة ومحمد بن المنكدر روي عنه الليث بن سعد وابن لهيعة وصدقة السمين سمعت ابي يقول ذلك وسالته عنه فقال ليس بقوي
  عياض ابو خالد بصري سمع معقل بن يسار سمع منه شعبة سمعت ابي يقول ذلك
  عياض بن مسلم روي عن بن عمر روي عنه يحيي بن سعيد الانصاري سمعت ابي يقول ذلك
  عياض بن عمرو بن عبد القاري حجازي روي عن علي رضي الله عنه روي عنه ابنه عبيد الله بن عياض سمعت ابي يقول ذلك
  عياض بن عياض ابو قيلة كوفي روي عن ابيه عن ابي مسعود الانصاري روي عنه سلمة بن كهيل وموسي بن قيس الحضرمي سمعت ابي يقول ذلك
  عياض بن جريبة الكلبي مصري روي عن عمر بن عبد العزيز روي عنه عمرو بن الحارث والليث بن سعد سمعت ابي يقول ذلك
  عياض بن مرة روي عن ابي الفيض عن معن بن علي عن معاوية روي عنه زيد بن ابي انيسة سمعت ابي يقول ذلك
  عياض بن يزيد الكلابي روي عن رجل من قومه روي عنه عاصم بن كليب سمعت ابي يقول ذلك وسمعته يقول هو مجهول
  عياض بن يزيد الكلبي سمع عبد الرحمن بن نباتة سمع بن عمر سمع النبي صلي الله عليه وسلم يقول الحرير حرام علي ذكور امتي روي عنه يحيي بن صالح الوحاظي سمعت ابي يقول ذلك
  عياض بن بكر بن واءل روي عن جده واءل عم عاءشة ام المءمنين من الرضاعة روي عن بكير بن الاشج 
  بسم الله الرحمن الرحيم
   ( باب من روي عنه العلم ممن يسمي عديا )
  عدي بن حاتم الطاءي ابو طريف له صحبة روي عنه تميم بن طرفة وعبد الله بن معقل ومري بن قطري ومحل بن خليفة وابو اسحاق الهمداني وهمام بن الحارث وعامر الشعبي وخيثمة بن عبد الرحمن سمعت ابي يقول بعض ذلك وبعضه من قبلي
  عدي بن عميرة الكندي ويقال الحضرمي له صحبة روي عنه قيس بن ابي حازم والعرس بن عميرة سمعت ابي يقول ذلك
  عدي بن فروة ويقال ابو فروة له صحبة روي عنه عدي بن عدي الكندي سمعت ابي يقول ذلك
  عدي الجذامي له صحبة روي عنه عبد الرحمن بن حرملة مرسل لم يلقه سمعت ابي يقول ذلك
  عدي بن ثابت الانصاري وجده ابو امه عبد الله بن يزيد سمع البراء بن عازب سمع منه يحيي بن سعيد الانصاري ومسعر وشعبه سمعت ابي يقول ذلك نا عبد الرحمن انا عبد الله بن احمد بن محمد بن حنبل فيما كتب الي قال قال ابي عدي بن ثابت ثقة نا عبد الرحمن قال سالت ابي عن عدي بن ثابت الانصاري فقال هو صدوق وكان امام مسجد الشيعة وقاصهم 
  عدي بن عدي بن عميرة الكندي ابو فروة ولابيه صحبة روي عن ابيه مرسل لم يسمع من ابيه يدخل بينهما العرس بن عميرة وكان عامل عمر بن عبد العزيز علي الموصل روي عنه عيسي بن عاصم سمعت ابي يقول ذلك نا عبد الرحمن انا عبد الله بن احمد بن محمد بن حنبل فيما كتب الي قال سمعت ابي يقول عدي بن عدي بن عميرة ابوه من اصحاب النبي صلي الله عليه وسلم يسال عن مثل هذا نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال عدي بن عدي ثقة نا عبد الرحمن قال سالت ابي عن عدي بن عدي فقال ثقة
  عدي بن دينار مولي ام قيس بنت محصن روي عن ام قيس بنت محصن روي عنه ابو المقدام ثابت بن هرمز سمعت ابي يقول ذلك
  عدي بن ارطاة اخو زيد بن ارطاة الفزاري روي عن سقط روي عنه بكر بن عبد الله المزني وعقبة بن قبيصة سمعت ابي يقول ذلك
  عدي بن حنظلة بن نعيم ابو طلق الزهري الاعمي روي عن جدته وابراهيم التيمي روي عنه سفيان الثوري وعبد الواحد بن زياد وبشر بن السري وحفص بن غياث ومحمد بن ربيعة وعبد الله بن داود الخريبي سمعت ابي يقول ذلك
  عدي بن عبد الرحمن والد الهيثم بن عدي الطاءي روي عن محمد بن عبد الرحمن بن ابي ليلي وعن سعيد الطاحي ويقال سعيد هذا هو بن يزيد ابو مسلمة روي عنه عبد الوارث بن سعيد ووكيع بن الجراح سمعت ابي يقول ذلك قال ابو محمد روي ابو روح الربيع بن روح عن محمد بن حرب عن الزبيدي عن عدي بن عبد الرحمن الطاءي عن داود بن ابي هند بنسخة حدثنا عبد الرحمن قال فسالت ابي عن الزبيدي هذا من هو فقال هو سعيد بن عبد الجبار الزبيدي قال ابو محمد سعيد بن عبد الجبار هذا هو الذي قدم الري ضعيف وسعيد بن عبد الجبار ابو شيبة قوي 
  عدي بن الفضل مولي بني تيم بن مرة روي عن ابي جعفر الخطمي وعلي بن الحكم وعلي بن زيد روي عنه علي بن الجعد وسعيد بن سليمان الواسطي ومحمد بن بكار سمعت ابي يقول ذلك قال ابو محمد وروي عن الحارث بن حصيرة ومحمد بن الزبير روي عنه مسلم بن ابراهيم نا عبد الرحمن ثنا عباس بن محمد الدوري قال سءل يحيي بن معين عن عدي بن الفضل يكتب حديثه قال لا ولا كرامة ليس بشء نا عبد الرحمن قال سالت ابي عن عدي بن الفضل فقال متروك الحديث وترك ابو زرعة حديث عدي بن الفضل وكان في كتابه عن عبد الواحد بن غياث عنه فلم يقرا علينا وقال ليس بقوي
  عدي بن الفضل سمع عمر بن عبد العزيز قوله سمع منه المعتمر بن سليمان سمعت ابي يقول ذلك
  عدي بن عبد الحميد سمع عروة بن محمد روي عنه معمر سمعت ابي يقول ذلك
  عدي بن ابي القلوص روي عن سقط روي عنه عمرو بن ميمون العبسي نا عبد الرحمن قال سالت ابي عنه فقال مجهول
  عدي بن ابي عماره الذارع الجرمي القسام الوراق سمع قتادة وزيادا النميري ومعاوية بن قرة سمع منه علي بن المديني وابراهيم بن موسي وابنه سمعت ابي ذلك حدثنا عبد الرحمن انا عبد الله بن احمد بن محمد بن حنبل فيما كتب الي قال سمعت ابي يقول وقلت له كيف عدي بن ابي عمارة الجرمي فقال هو شيخ نا عبد الرحمن قال سالت ابي عن عن عدي بن ابي عمارة فقال ليس به باس
  عدي بن ابي ثابت الكوفي نا عبد الرحمن قال سءل ابي عنه فقال هو كوفي روي عن سقط روي عنه سقط روي حديثين لا باس بحديثه 
   ( باب من روي عنه العلم ممن يسمي عياشا )
  عياش بن ابي ربيعة القرشي المخزومي ابو عبد الله واسم ابي ربيعة عمرو بن المغيرة بن عبد الله بن مخزوم مات بالشام في فتح عمر رضي الله عنه الشام وهو اخو عبد الله بن ابي ربيعة وله صحبة روي عنه ابنه عبد الله بن عياش سماعا منه روي عنه نافع مرسل وعبد الرحمن بن سابط مرسل سمعت ابي يقول ذلك
  عياش بن ابي مسلم راي عمر بن الخطاب رضي الله عنه سمع منه محمد بن موسي سمعت ابي يقول ذلك
  عياش بن عبد الله بن ابي ثور حجازي روي عن اسماعيل بن ابراهيم روي عنه محمد بن اسحاق سمعت ابي يقول فيه نظر
  عياش بن عبد الله وقال بعضهم عباس وعياش اصح قال كتب عثمان رضي الله عنه وروي عن ابي قتادة العدوي روي عنه قتادة سمعت ابي يقول ذلك
  عياش بن عبد الله روي عن عمرو بن سلمة روي عنه ابنه عبد الله بن عياش سمعت ابي يقول ذلك
  عياش بن سعيد بن ابي معلي الانصاري سمعت ابي يقول ذلك ويقول هو مجهول
  عياش بن مءنس ابو معاذ روي عن شداد بن شرحبيل الانصاري وسمع منه نمران بن مخمر وروي عنه حبيب بن صالح سمعت ابي يقول ذلك
  عياش الكليبي روي عن عبد الله بن باباه روي عنه شعبة سمعت ابي يقول ذلك
  عياش بن عقبة الحضرمي عم عبد الله بن لهيعة روي عن يحيي بن ميمون الحضرمي وموسي بن وردان وجوثة بن عبيد المديني روي عنه بكر بن مضر وابن المبارك وابن وهب والمقري وزيد بن حباب سمعت ابي يقول ذلك نا عبد الرحمن انا عبد الله بن احمد بن محمد بن حنبل فيما كتب الي قال وجدت في كتاب ابي بخط يده قال ناابو عبد الرحمن يعني المقري نا عياش بن عقبة الحضرمي عم بن لهيعة شيخ صدوق 
  عياش بن سنان العتكي الصيرفي سمع ابا الحلال وابا نضرة روي عنه مسلم بن ابراهيم وابو قتيبة وابو الوليد الطيالسي سمعت ابي يقول ذلك قال ابو محمد وروي عن شميسة
  عياش بن عمرو العامري روي عن عبد الله بن شداد بن الهاد روي عنه سفيان الثوري وشريك سمعت ابي يقول ذلك نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين قال عياش العامري ثقة نا عبد الرحمن قال سالت ابي عن عياش العامري فقال صالح
  عياش بن سليمان روي عن عمر بن عبد العزيز قوله روي ابو القاسم بن ابي الزناد عن اسحاق بن حازم عنه سمعت ابي يقول ذلك
  عياش بن عباس القتباني ابو عبد الرحمن المصري روي عن ابي عبد الرحمن الحبلي وابي سلمة بن عبد الرحمن روي عنه الليث والمفضل بن فضالة وابنه عبد الله بن سمعت ابي ابي يقول ذلك قال ابو محمد روي عنه عبد الله بن لهيعة نا عبد الرحمن انا يعقوب بن اسحاق فيما كتب الي نا عثمان بن سعيد قال قلت ليحيي بن معين عياش بن عباس فقال ثقة نا عبد الرحمن قال سءل ابي عن عياش بن عباس فقال صالح
  عياش بن الوليد الرقام القطان ابو الوليد روي عن عبد الاعلي ومحمد بن يزيد الواسطي روي عنه ابي وابو زرعة قال ابو محمد روي عن مسلمة بن علقمة نا عبد الرحمن قال سالت ابي عنه فقال هو من الثقات
   ( باب من روي عنه العلم ممن يسمي عكرمة )
  عكرمة بن ابي جهل القرشي المخزومي له صحبة قتل يوم اجنادين في عهد عمر رضي الله عنه روي عنه مصعب بن سعد سمعت ابي يقول ذلك قال ابو محمد قلت له سمع مصعب بن سعد منه قال لا اظنه 
  عكرمة مولي بن عباس سمع بن عباس وابن عمرو وابا سعيد الخدري وابا هريرة وعاءشة قيل لابي سمع من عاءشة فقال نعم روي عنه عمرو بن دينار وقتادة وابو اسحاق وايوب السختياني سمعت ابي يقول ذلك وسمعته يقول روي عن عكرمة من اهل المدينة يحيي بن سعيد الانصاري والعلاء بن عبد الرحمن الحرقي ومحمد بن عبد الرحمن بن نوفل ابو الاسود وسعيد بن عبد الرحمن بن حسان بن ثابت ومحمد بن طلحة بن يزيد بن ركانة وسلمة بن بخت وثور بن زيد الديلي وداود بن حصين والحسين بن عبد الله بن عبيد الله بن عباس ومن اهل مكة عمرو بن دينار وابو صالح باذان والقاسم بن ابي بزة وحميد بن قيس الاعرج وابن ابي نجيح وعبد الله بن كثير وعبد العزيز بن ابي رواد ومن اهل اليمن عمرو بن مسلم والحكم بن ابان وهمام بن نافع واسحاق بن جابر العدني ويعلي بن حكيم وكان بصري الاصل ووهب بن نافع عم عبد الرزاق وسلمة بن وهرام واسماعيل بن شروس ومن اهل الكوفة ابو اسحاق الهمداني والشعبي وحماد بن ابي سليمان وسلمة بن كهيل وحبيب بن ابي ثابت والاعمش واسماعيل بن ابي خالد والحكم بن عتيبة وابو الزعراء عمرو بن عمرو وميسرة وابو حصين وسماك بن حرب والسدي وعلي بن الاقمر وسعيد بن مسروق ومغيرة بن مقسم وحصين بن عبد الرحمن وعطاء بن الساءب وليث بن ابي سليم والحارث بن حصيرة والوليد بن العيزار وزياد بن فياض ويزيد بن ابي زياد وعبد الرحمن بن الاصبهاني وابو اسحاق الشيباني وعطية العوفي واشعث بن سوار والعلاء بن المسيب وفضيل بن غزوان وهلال بن خباب وبدر بن عثمان وفطر بن خليفة وابو بكير وعمران بن سليمان ومحمد بن عبد الرحمن مولي ال طلحة وسفيان بن زياد العصفري وعصام بن قدامة وزيد الحجام ومن اهل البصرة جابر بن زيد وعاصم الاحول وايوب السختياني  وقتادة ويونس بن عبيد وداود بن ابي هند وخالد الحذاء وحميد الطويل وهشام بن حسان والزبير بن خريت وحنظلة السدوسي وعمرو بن ابي حكيم وابو يزيد المديني وسعيد بن عبيد الله الثقفي وابو مكين وعمران بن حدير ويزيد بن حازم وعبد الكريم ابو امية وشبيب بن بشر وابان بن صمعة وابو الاشهب ومطر الوراق وفضيل بن ميمون وعباد بن منصور ومهدي الهجري وابو بكر الهذلي ومن اهل واسط ابو بشر جعفر بن ابي وحشية وحسين بن قيس هو ابو علي الرحبي وهو حنش ومن اهل مصر يزيد بن ابي حبيب وبشير بن ابي عمر وجعفر بن ربيعة ومن اهل الشام صفوان بن عمرو وثور بن يزيد ومن اهل ايلة عقيل بن خالد ويونس بن يزيد ومن اهل الجزيرة عبد الكريم بن مالك وخصيف وعلي بن بذيمة وعثمان المشاهد ومن اهل اليمامة يحيي بن ابي كثير وابو يزيد ومن اهل سجستان عبد الله بن الحسين قاضيها ومن اهل خراسان عطاء الخراساني وابو المنيب العتكي وعلباء بن احمر ويزيد النحوي والحسين بن واقد ونعيم بن ميسرة النحوي نا عبد الرحمن نا محمد بن عبد الله بن يزيد المقري نا سفيان عن عمرو بن دينار قال قال جابر يعني بن زيد هذا عكرمة مولي بن عباس هذا اعلم الناس نا عبد الرحمن نا حجاج بن حمزة ناعلي بن الحسين بن شقيق نا ابو حمزة يعني السكري نا يزيد النحوي عن عكرمة قال قال بن عباس انطلق فافت الناس وانا لك عون قال قلت لو كان مع الناس مثلهم افتيتهم قال انطلق فافت الناس فمن سالك عما يعنيه فافته ومن سالك عما لا يعنيه فلا تفته فانك تطرح عنك ثلثي مءنة الناس نا عبد الرحمن انا ابو بكر بن ابي خيثمة فيما كتب الي قال نا يحيي بن معين قال حدثني من سمع حماد بن زيد يقول سمعت ايوب وسءل عن عكرمة كيف هو قال لو لم يكن عندي ثقة لم اكتب عنه نا عبد الرحمن قال سالت ابي عن عكرمة مولي بن عباس فقال هو ثقة قلت يحتج بحديثه قال نعم اذا روي عنه الثقات والذي انكر عليه يحيي بن سعيد الانصاري ومالك فلسبب رايه نا عبد الرحمن قال قيل لابي فموالي بن عباس فقال كريب وسميع وشعبة وعكرمة وعكرمة اعلاهم حدثنا عبد الرحمن قال وسءل ابي عن عكرمة وسعيد بن جبير ايهما اعلم بالتفسير فقال اصحاب بن عباس عيال علي عكرمة نا عبد الرحمن انا يعقوب بن اسحاق فيما كتب الي قال انا عثمان بن سعيد قال سالت يحيي بن معين قلت عكرمة احب اليك عن بن عباس او عبيد الله بن عبد الله فقال كليهما ولم يخير قلت فعكرمة او سعيد بن جبير فقال ثقة وثقة ولم يخير 
  عكرمة سمع ابا هريرة روي عنه العوام بن حوشب نا عبد الرحمن قال سالت ابي عنه فقال يقال ان هذا ايضا هو مولي لابن عباس نا عبد الرحمن ناالعباس بن محمد الدوري قال سمعت يحيي بن معين يقول قد سمع عكرمة يعني مولي بن عباس من ابي هريرة
  عكرمة بن خالد بن سعيد بن العاص المخزومي روي عن بن عمر وابن عباس روي عنه عمرو بن دينار وابراهيم بن المهاجر وحنظلة بن ابي سفيان وابن جريج وعباد بن منصور سمعت ابي يقول ذلك قال ابو محمد روي عنه محمد بن شريك وعبد الله بن طاوس وعامر الاحول نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال عكرمة بن خالد ثقة نا عبد الرحمن قال سءل ابو زرعة عن عكرمة بن خالد الذي روي عن بن عباس فقال هو مخزومي مكي ثقة
  عكرمة بن خالد بن سلمة المخزومي قرشي روي عن ابيه روي عنه مسلم بن ابراهيم ونصر بن علي سمعت ابي يقول ذلك نا عبد الرحمن قال سالت ابي عن عكرمة بن خالد بن سلمة المخزومي فقال منكر الحديث
  عكرمة بن يعلي بن امية الثقفي حجازي سمع بن عمر ومعاوية روي عنه ابراهيم بن عكرمة ونافع بن جبير سمعت ابي يقول ذلك 
  عكرمة بن عبد الرحمن بن الحارث بن هشام المخزومي روي عن عمر رضي الله عنه مرسل روي عنه الزهري وابنه محمد بن عكرمة سمعت ابي يقول ذلك قال ابو محمد وروي عن عبد الرحمن الاعرج وابيه روي عنه ابراهيم بن سعد
  عكرمة بن حنبص سمع عليا روي عنه ابراهيم بن عبد الاعلي الكوفي سمعت ابي يقول ذلك
  عكرمة بن محمد الدءلي سمع ابا هريرة قوله روي عنه الزهري سمعت ابي يقول ذلك
  عكرمة بن مصعب من بني عبد الدار روي عن محرر بن ابي هريرة روي عنه ابراهيم بن محمد بن ثابت سالت ابي عنه فقال هو مجهول
  عكرمة بن عمار ابو عمار اليمامي العجلي بصري الدار سمع اياس بن سلمة بن الاكوع وشداد بن عبد الله وسماك بن الوليد ابا زيل وابا كثير السحيمي روي عنه الثوري وشعبة وعمر بن يونس والنضر بن محمد وابو الوليد وعمرو بن مرزوق وهلال بن فياض سمعت ابي يقول ذلك قال ابو محمد روي عن سالم بن عبد الله والقاسم بن محمد وطيسلة بن علي الهذلي نا عبد الرحمن حدثني ابي نا علي الطنافسي نا وكيع عن عكرمة عمار وكان ثقة نا عبد الرحمن نا صالح بن احمد بن محمد بن حنبل نا علي بن المديني قال سالت يحيي بن سعيد عن احاديث عكرمة بن عمار عن يحيي بن ابي كثير فضعفها وقال ليس بصحاح نا عبد الرحمن انا عبد الله بن احمد بن محمد بن حنبل فيما كتب الي قال قال ابي عكرمة بن عمار مضطرب الحديث عن غير اياس بن سلمة وكان حديثه عن اياس بن سلمة صالح وحديثه عن يحيي بن ابي كثير مضطرب نا عبد الرحمن انا يعقوب بن اسحاق فيما كتب الي قال نا عثمان بن سعيد قال سالت يحيي بن معين قلت ايوب بن عتبة احب اليك او عكرمة بن عمار قال عكرمة احب الي ايوب ضعيف نا عبد الرحمن انا ابو بكر بن ابي خيثمة فيما كتب الي قال سمعت يحيي بن معين يقول عكرمة بن عمار صدوق ليس به باس نا عبد الرحمن قال سمعت ابي يقول قال يحيي بن معين كان عكرمة بن عمار اميا وكان حافظا سالت ابي عن عكرمة بن عمار فقال كان صدوقا وربما وهم في حديثه وربما دلس وفي حديثه عن يحيي بن ابي كثير بعض الاغاليط 
  عكرمة بن ابراهيم الازدي الموصلي ابو عبد الله قاضي الري روي عن عاصم وعبد الملك بن عمير وادريس بن يزيد روي عنه عمرو بن الربيع بن طارق والنفيلي وهشام بن عبيد الله سمعت ابي يقول ذلك نا عبد الرحمن نا عباس بن محمد الدوري قال سمعت يحيي بن معين يقول عكرمة بن ابراهيم بصري ليس بشء
  عكرمة بن سليمان بن كثير بن عامر مولي بني شيبة روي عن اسماعيل بن عبد الله بن قسطنطين روي عنه احمد بن محمد بن عبد الله بن القاسم بن نافع بن ابي بزة المكي
  عكرمة بن طارق روي عنه ابو عقيل المروزي شاه بن حاجب
  عكرمة بن قتادة بن يحيي بن عبد الله بن ابي قتادة الانصاري ابو الوليد روي عن ابيه قتادة بن يحيي روي عنه احمد بن منصور الرمادي
