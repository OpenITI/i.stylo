  مخارق والد قابوس بن المخارق روي عن النبي صلي الله عليه وسلم انه اتاه رجل فقال ارايت ان اتاني رجل يريد اخذ مالي روي عنه ابنه قابوس بن المخارق سمعت ابي يقول ذلك
  مخارق بن سليم الشيباني روي عن علي وعمار روي عنه ابو اسحاق الشيباني سمعت ابي يقول ذلك
  مخارق بن ابي المخارق روي عن بن عمر روي عنه عمر بن عمرو بن عبد الاحموسي سمعت ابي يقول ذلك
  مخارق بن احمر الكلابي روي عن حذيفة روي عنه ابو حسان مسلم الاحرد سمعت ابي يقول ذلك
  مخارق روي عن ابي ذر روي عنه ابو اسحاق سمعت ابي يقول ذلك
  مخارق بن عبد الله بن جابر الاحمسي ويقال مخارق بن خليفة كوفي روي عن طارق بن شهاب روي عنه الثوري وشعبة وحسن بن صالح وشريك وحصين بن عمر الاحمسي واسراءيل وابو يحيي التيمي اسماعيل بن ابراهيم سمعت ابي يقول ذلك نا عبد الرحمن انا عبد الله بن احمد بن محمد بن حنبل فيما كتب الي قال سمعت ابي يقول مخارق بن خليفة الاحمسي ثقة ثقة قال عبد الله وسالت يحيي بن معين قلت مخارق الاحمسي فقال ثقة نا عبد الرحمن قال سالت ابي عن مخارق بن عبد الله الاحمسي فقال ثقة 
  مخارق بن عبد الرحمن السلمي كان ينزل الدفينة روي عن عمه حبان بن جزء روي عنه ابو سلمة موسي بن اسماعيل سمعت ابي يقول ذلك 
   ( باب تسمية من روي عنه العلم ممن يسمي مقاتل )
  مقاتل بن بشير العجلي كوفي روي عن شريح بن هانء وموسي بن ابي موسي روي عنه مالك بن مغول سمعت ابي يقول ذلك
  مقاتل العطار بصري روي عن انس روي عنه سعيد بن ابي عروبة سمعت ابي يقول ذلك
  مقاتل بن همام روي عن ابي خيرة الصباحي روي عنه داود بن مساور سمعت ابي يقول ذلك
  مقاتل بن حيان ابو بسطام مولي لبكر بن واءل كان يكون ببلخ روي عن سالم بن عبد الله ومجاهد والضحاك والحسن وشهر بن حوشب وعكرمة وقتادة وابن بريدة وعمته عمرة سمعت ابي يقول ذلك نا عبد الرحمن قال سمعت ابي وابا زرعة يقولان روي عنه علقمة بن مرثد وعتاب بن محمد بن شوذب بن اخي بن شوذب وابو جعفر الرازي وشبيب بن عبد الملك وعمر بن صبح الخراساني وصالح بن سعيد وخالد بن زياد الترمذي وبكير بن معروف الدامغاني وابراهيم بن ادهم وعبد الوهاب بن معاوية النحوي السعدي المروزي واسراءيل بن حاتم المروزي وعيسي بن موسي التيمي البخاري المعروف بالغنجار ومصاد بن عقبة الزهراني قال ابو محمد روي عنه عبد الله بن سعد الدشتكي نا عبد الرحمن حدثني ابي نا عبد السلام بن عتيق قال نا مروان بن محمد الطاطري انه ذكر مقاتل بن حيان فقال ثقة ثنا عبد الرحمن ثنا محمد بن سعيد المقرء قال سءل عبد الرحمن يعني بن الحكم بن بشير عن مقاتل بن حيان البلخي فقال ذاك مرتفع مرتفع نا عبد الرحمن قال ذكره ابي عن اسحاق عن منصور بن يحيي بن معين انه قال مقاتل بن حيان ثقة 
  مقاتل بن سليمان البلخي صاحب التفسير والمناكير روي عن الضحاك ومجاهد والزهري وابن بريدة روي عنه عبد الرزاق وحرمي بن عمارة وعلي بن الجعد وعيسي بن صبيح ابي فاطمة ابو فاطمة اسمه صبيح سمعت ابي يقول ذلك نا عبد الرحمن نا ابو سعيد الاشج ثنا ابو خالد يعني الاحمر عن جويبر قال لقد والله مات الضحاك وان مقاتل يعني بن سليمان له قرطان وهو في الكتاب نا عبد الرحمن انا محمود بن ادم المروزي فيما كتب الي قال حضرت وكيعا وسءل عن كتاب التفسير عن مقاتل بن سليمان فقال لا تنظر فيه قال ما اصنع به قال ادفنه ثم قال اليس زعموا انه كان يحفظ كنا ناتيه فيحدثنا ثم ناتيه بعد ايام فيقلب الاسناد والحديث نا عبد الرحمن انا محمود بن ادم المروزي فيما كتب الي قال اخبرت عن وكيع انه قال كان مقاتل بن سليمان كذابا ثنا عبد الرحمن قال ذكره ابي قال نا محمود بن غيلان قال سءل وكيع عن مقاتل بن سليمان فقال سمعنا منه والله المستعان نا عبد الرحمن انا العباس بن الوليد بن مزيد البيروتي قراءة قال سمعت بعض مشيختنا يقول جلس مقاتل بن سليمان في مسجد بيروت فقال لا تسالوني عن شء ما دون العرش الا انباتكم عنه فقال الاوزاعي لرجل قم اليه فسله ما ميراثه من جدتيه فحار ولم يكن عنده جواب فما بات فيها الا ليلة ثم خرج بالغداة نا عبد الرحمن نا صالح بن احمد بن محمد بن حنبل قال قال ابي مقاتل بن سليمان صاحب التفسير ما يعجبني ان اروي عنه شيءا نا عبد الرحمن نا محمد بن سعيد المقرء قال سءل عبد الرحمن يعني بن الحكم بن بشير عن مقاتل بن سليمان فقال كان قاصا ترك الناس حديثه نا عبد الرحمن قال قرء علي العباس بن محمد الدوري قال سمعت يحيي بن معين يقول مقاتل بن سليمان ليس حديثه بشء نا عبد الرحمن قال سمعت ابي يقول هو متروك الحديث 
  مقاتل بن الفضل اليماني روي عن مجاهد عن بن عباس عن النبي صلي الله عليه وسلم من اكل الطين فقد اعان علي قتل نفسه روي عنه صالح بن محمد الترمذي فدل حديثه علي انه ليس بصدوق
  مقاتل بن اعين الهذلي روي عن الحسن وابن سيرين روي عنه نعيم بن حماد
  مقاتل بن محمد النصراباذي الرازي روي عن ابي بكر بن عياش وجرير واسماعيل بن علية وابي زهير وسلمة بن الفضل ومحمد بن المعلي اليامي وعبد الرحمن المحاربي والصباح بن محارب والوليد بن مسلم وابو داود واسحاق بن سليمان وعبد الله بن ادريس ويحيي بن الضريس ووكيع بن الجراح وبهز بن اسد روي عنه علي بن محمد الطنافسي وابي وابو زرعة نا عبد الرحمن قال سمعت ابي يقول ثنا مقاتل بن محمد وكان ثقة فقيها نا عبد الرحمن قال سمعت ابا زرعة يقول وذكر مقاتل بن محمد فقال كان ثقة مامونا نا عبد الرحمن قال سمعت ابي يقول سمعت مقاتل بن محمد يقول قدم ابراهيم بن رستم الري فاتيته وكان عنده عن الحسين بن واقد وابي حمزة السكري فدخلت عليه وهو مستلقي وفي يده كتاب فقال رايت مسالة حسناء عجبت به قلت ما هي قال قال محمد بن الحسن في المراة يخرج من قبلها الريح ان عليها الوضوء قال مقاتل فقلت هذا قد قاله محمد النبي صلي الله عليه وسلم لا ينصرفن حتي يسمع صوتا او يجد ريحا فقد امر بالوضوء من الريح من القبل والدبر لانه اذا وجد الريح من قبل كان او دبر فقد وجد الريح وعليه الوضوء قال فبقي نا عبد الرحمن نا علي بن الحسن الهرثمي قال سمعت ابا زرعة يقول ما خلفت بالعراق مثل مقاتل بن محمد 
   ( باب تسمية من روي عنه العلم ممن يسمي منهال )
  منهال بن عمرو الاسدي مولي لبني عمرو بن اسد بن خزيمة كوفي روي عن زر بن حبيش وسعيد بن جبير وعبد الرحمن بن ابي ليلي وعباد بن عبد الله وقيس بن السكن روي عنه منصور والاعمش وميسرة بن حبيب وعبد ربه بن سعيد وابو خالد الدالاني والقاسم بن الوليد الهمداني والحجاج بن ارطاة وابن ابي ليلي والصبي بن اشعث السلولي سمعت ابي يقول ذلك نا عبد الرحمن انا عبد الله بن احمد بن محمد بن حنبل فيما كتب الي قال سمعت ابي يقول ترك شعبة المنهال بن عمرو علي عمد قال ابو محمد لانه سمع من داره صوت قراءة بالتطريب نا عبد الرحمن قال ذكره ابي عن اسحاق بن منصور عن يحيي بن معين انه قال المنهال بن عمرو ثقة 
  منهال روي عن بن مسعود روي عنه ابو اسحاق نا عبد الرحمن قال سمعت ابي يقول لا اعرفه ان لم يكن منهال بن عمرو
  منهال الذي روي عنه ليث بن ابي سليم نا عبد الرحمن قال قرء علي العباس بن محمد الدوري قال قيل ليحيي بن معين المنهال الذي يروي عنه ليث بن ابي سليم فقال شيخ
  منهال بن خليفة روي عن ثابت البناني وعلي بن زيد وسلمة بن تمام روي عنه ابو معاوية الضرير وابو احمد الزبيري ومخلد بن يزيد ومعاوية بن هشام وعبيد بن سعيد وعثمان بن سعيد بن مرة وعبد الله بن رجاء سمعت ابي يقول ذلك قال ابو محمد روي عن الحجاج بن ارطاة روي عنه يحيي بن اليمان ثنا عبد الرحمن قال قرء علي العباس بن محمد الدوري عن يحيي بن معين انه قال المنهال بن خليفة ضعيف الحديث نا عبد الرحمن قال سالت ابي عن المنهال بن خليفة فقال صالح يكتب حديثه
  منهال بن بحر ابو سلمة العقيلي القشيري روي عن حماد بن سلمة والاسود بن شيبان وعبد المجيد روي عنه ابو الوليد الطيالسي وعلي بن المديني وعمرو بن علي وسمع منه ابي نا عبد الرحمن قال سالت ابي عنه فقال ثقة قال ابو محمد روي عن بن عون وهشام بن حسان وسعيد بن ابي عروبة وابي خلدة وقرة بن خالد وشعبة ومسلمة بن علقمة 
  منهال بن الجراح قال لنا ابو محمد قال ابو زرعة وابي جميعا انما هو الجراح بن المنهال ابو العطوف واخطا فيه البخاري
  منهال بن عيسي العبدي روي عن معان روي عنه مسلم بن ابراهيم
   ( باب تسمية من روي عنه العلم ممن يسمي مطلب )
  مطلب بن ابي وداعة بن صبيرة احد بني سهم بن عمرو بن هصيص يعد في اهل مكة وكان ينزل المدينة له صحبة وله بمني دار روي عنه ابناه كثير وجعفر سمعت ابي يقول ذلك
  مطلب بن ربيعة بن الحارث بن عبد المطلب روي عنه عبد الله بن الحارث سمعت ابي يقول ذلك 
  مطلب بن عبد الله بن حنطب القرشي المخزومي ابو الحكم مديني وقال بعضهم عبد الله بن المطلب روي عن عمر رضي الله عنه روي عنه محمد بن عباد بن جعفر سمعت ابي يقول ذلك
  مطلب بن عبد الله بن المطلب بن عبد الله بن حنطب روي عن بن عباس مرسل وابن عمر مرسل وابي موسي مرسل وام سلمة مرسل وعاءشة مرسل ولم يدركها وابي قتادة مرسل وابي هريرة مرسل وابي رافع مرسل وجابر يشبه ان يكون ادركه عامة حديثه مراسيل غير اني رايت حديثا يقول حدثني خالي ابو سلمة روي عنه عمرو بن ابي عمرو والاوزاعي وكثير بن زيد ومسلم بن الوليد بن رباح وعبد الله بن عبد الرحمن بن يعلي بن كعب الثقفي وابناه الحكم وعبد العزيز سمعت ابي يقول ذلك نا عبد الرحمن قال سءل ابو زرعة عن المطلب بن عبد الله بن حنطب فقال مديني ثقة نا عبد الرحمن قال وسءل ابو زرعة هل سمع المطلب بن عبد الله بن حنطب من عاءشة فقال نرجو ان يكون سمع منها
  مطلب بن الساءب بن ابي وداعة بن صبيرة بن سعيد بن سعد بن سهم الجمحي القرشي السهمي روي عنه محمد بن عجلان وعبيد بن سلمان وزهير بن محمد وابنه ابراهيم بن المطلب سمعت ابي يقول ذلك
  مطلب بن عبد الله بن قيس بن مخرمة بن المطلب القرشي حجازي روي عن ابيه وسعيد بن ابي هند روي عنه محمد بن اسحاق سمعت ابي يقول ذلك 
  مطلب بن زياد الكوفي الثقفي مولي لهم ويقال مولي لجابر بن سمرة وكان جابر حليفا لبني زهرة فلذلك قيل المطلب بن زياد القرشي روي عن زياد بن علاقة وابي اسحاق الهمداني وليث بن ابي سليم وعبد الله بن عيسي وعبد الله بن محمد بن عقيل روي عنه بن المبارك ويوسف بن عدي وابو الوليد الطيالسي وعبد الله وعثمان ابنا ابي شيبة ومحمد بن عبد الله بن نمير وابراهيم بن موسي سمعت ابي يقول ذلك قال ابو محمد روي عنه احمد بن حنبل نا عبد الرحمن انا عبد الله بن احمد بن محمد بن حنبل فيما كتب الي قال قال ابي المطلب بن زياد ثقة نا عبد الرحمن انا ابو بكر بن ابي خيثمة فيما كتب الي قال سمعت يحيي بن معين يقول المطلب بن زياد ثقة نا عبد الرحمن قال وسءل ابي عن المطلب بن زياد فقال يكتب حديثه ولا يحتج به
   ( باب تسمية من روي عنه العلم ممن يسمي مجالد )
  مجالد بن مسعود السلمي اخو مجاشع له صحبة قتل يوم الجمل روي عنه ابو عثمان النهدي ويحيي بن ابي اسحاق مرسل سمعت ابي يقول ذلك
  مجالد بن عوف الحضرمي سمع زيد بن ثابت في قوله عز وجل ومن يقتل مءمنا متعمدا روي عنه ابو الزناد
  مجالد بن ابي راشد كوفي قال دخلنا علي عبد الله بن مسعود روي عنه ابو اسحاق السبيعي سمعت ابي يقول ذلك
  مجالد ابو عبد العزيز روي عن ابي هريرة روي عنه ابو التياح سمعت ابي يقول ذلك 
  مجالد بن نعيم او نعيم بن مجالد روي عن بن عمر روي عنه ابو التياح سمعت ابي يقول ذلك
  مجالد بن سعيد الهمداني الكوفي وهو بن سعيد بن عمير ذي قران روي عن قيس بن ابي حازم ومرة الهمداني والشعبي وابي الوداك ووبرة روي عنه الثوري وشعبة وحماد بن زيد وجرير بن حازم وعباد بن عباد المهلبي وسفيان بن عيينة ويحيي بن سعيد القطان وحفص بن غياث وابراهيم بن سليمان المءدب وابنه اسماعيل سمعت ابي يقول ذلك نا عبد الرحمن نا احمد بن سنان قال سمعت عبد الرحمن بن مهدي يقول حديث مجالد عند الاحداث يحيي بن سعيد وابي اسامة ليس بشء ولكن حديث شعبة وحماد بن زيد وهشيم وهءلاء القدماء قال ابو محمد يعني انه تغير حفظه في اخر عمره نا عبد الرحمن نا صالح بن احمد بن محمد بن حنبل حدثنا علي يعني بن المديني قال قلت ليحيي يعني بن سعيد القطان مجالد قال في نفسي منه شء نا عبد الرحمن نا محمد بن ابراهيم بن شعيب نا عمرو بن علي الصيرفي قال سمعت يحيي بن سعيد القطان يقول لعبد الله اين تذهب قال اذهب الي وهب بن جرير اكتب السيرة يعني عن مجالد قال تكتب كذبا كثيرا لو شءت ان يجعلها لي مجالد كلها عن الشعبي عن مسروق عن عبد الله فعل نا عبد الرحمن نا محمد بن حمويه بن الحسن قال سمعت ابا طالب قال سالت احمد بن حنبل عن مجالد فقال ليس بشء يرفع حديثا كثيرا لا يرفعه الناس وقد احتمله الناس نا عبد الرحمن قال قرء علي العباس بن محمد الدوري عن يحيي بن معين انه قال مجالد لا يحتج بحديثه نا عبد الرحمن انا ابو بكر بن ابي خيثمة فيما كتب الي قال سمعت يحيي بن معين يقول مجالد ضعيف واهي الحديث قال ابو بكر قلت ليحيي بن معين كان يحيي بن سعيد القطان يقول لو اردت ان يرفع لي مجالد حديثه كله رفعه قال نعم قلت ولم يرفع حديثه قال لضعفه نا عبد الرحمن قال سءل ابي عن مجالد بن سعيد يحتج بحديثه قال لا وهو احب الي من بشر بن حرب وابي هارون العبدي وشهر بن حوشب واحب الي من داود الاودي وعيسي الحناط وليس مجالد بقوي الحديث 
  مجالد بن محارب بن دثار السدوسي بصري روي عن كبشة امراة ابي بكرة روي عنه جعفر بن حيان نا عبد الرحمن سمعت ابي يقول لا اعرف هذا الاسناد
  مجالد القصاب الرازي روي عن عمرو بن ابي قيس روي عنه جرير بن عبد الحميد ويحيي بن المغيرة نا عبد الرحمن قال قرء علي العباس بن محمد الدوري قال سمعت يحيي بن معين يقول مجالد القصاب ثقة يروي عنه جرير الضبي
   ( باب تسمية من روي عنه العلم ممن يسمي مخرمة )
  مخرمة بن نوفل بن عبد مناف بن زهرة والد المسور بن مخرمة القرشي له صحبة مات بالمدينة وهو بن ماءة وخمس عشرة سنة سنة اربع وخمسين روي عنه ابنه المسور بن مخرمة نا عبد الرحمن قال سمعت ابي يقول ذلك
  مخرمة بن شريح الحضرمي روي الساءب بن يزيد انه ذكر عند رسول الله صلي الله عليه وسلم مخرمة بن شريح فقال النبي صلي الله عليه وسلم ذاك رجل لا يتوسد القران سمعت ابي يقول ذلك 
  مخرمة بن ربيعة الكوفي سمع الاشتر يقول حدثني خالد بن الوليد قال قال النبي صلي الله عليه وسلم من سب عمارا سبه الله سمعت ابي يقول ذلك
  مخرمة بن سليمان الاسدي اسد خزيمة مديني يقال انه قتل بقديد سنة ثلاثين وماءة روي عن كريب روي عنه مالك بن انس والضحاك بن عثمان سمعت ابي يقول ذلك حدثنا عبد الرحمن قال قرء علي العباس بن محمد الدوري قال سءل يحيي بن معين عن مخرمة بن سليمان فقال يحدث عنه مالك وهو ثقة نا عبد الرحمن قال سمعت ابي يقول مخرمة بن سليمان مديني يروي عن كريب صالح الحديث ثقة
  مخرمة بن بكير بن عبد الله بن الاشج روي عن ابيه روي عنه بن لهيعة وابن المبارك وابن وهب ومعن بن عيسي وميمون بن يحيي وقدامة بن محمد وحماد بن خالد الخياط والقعنبي سمعت ابي يقول ذلك نا عبد الرحمن نا محمد بن حمويه بن الحسن قال سمعت ابا طالب قال سالت احمد بن حنبل عن مخرمة بن بكير فقال هو ثقة لم يسمع من ابيه شيءا انما يروي من كتاب ابيه نا عبد الرحمن نا ابي قال سالت اسماعيل بن ابي اويس قلت هذا الذي يقول مالك بن انس حدثني الثقة من هو قال مخرمة بن بكير بن الاشج ثنا عبد الرحمن انا ابو بكر بن ابي خيثمة فيما كتب الي قال سمعت يحيي بن معين يقول مخرمة بن بكير يقال انه وقع اليه كتاب ابيه ولم يسمعه نا عبد الرحمن قال قرء علي العباس بن محمد الدوري عن يحيي بن معين انه قال مخرمة بن بكير ضعيف وحديثه عن ابيه كتاب ولم يسمعه من ابيه حدثنا عبد الرحمن نا علي بن الحسن الهسنجاني نا سعيد بن ابي مريم قال انا موسي بن سلمة خالي قال اتيت مخرمة بن بكير فقلت له حدثك ابوك قال لم ادرك ابي ولكن هذه كتبه نا عبد الرحمن قال سءل ابي عن مخرمة بن بكير فقال صالح الحديث وقال قال بن ابي اويس وجدت في ظهر كتاب مالك سالت مخرمة عما يحدث به عن ابيه سمعها من ابيه فحلف لي وقال ورب هذه البنية يعني المسجد سمعت من ابي قال ابي ان كان سمعها من ابيه فكل حديثه عن ابيه الا حديثا يحدث به عن عامر بن عبد الله بن الزبير 
   ( باب تسمية من روي عنه العلم ممن يسمي مستورد )
  مستورد بن شداد الفهري القرشي مديني سكن مصر يقال انه كان غلاما يوم قبض النبي صلي الله عليه وسلم له صحبة روي عنه قيس بن ابي حازم وعبد الرحمن بن جبير وحديج بن ابي عمرو وعلي بن رباح سمعت ابي يقول ذلك قال ابو محمد روي عنه حارثة بن وهب وابو عبد الرحمن الحبلي 
  مستورد بن الاحنف روي عن بن مسعود وحذيفة ومعبد بن عامر وصلة بن زفر روي عنه سلمة بن كهيل وسعد بن عبيدة وابو حصين سمعت ابي يقول ذلك نا عبد الرحمن نا محمد بن احمد بن البراء قال قال علي بن المديني مستورد الذي روي عنه سلمة وسعد بن عبيدة وعلقمة بن مرثد ثقة
  مستورد بن عباد العبدي روي عن الحسن روي عنه عثمان بن عمر بن فارس سمعت ابي يقول ذلك
  مستورد بن الجارود جارود عبد القيس روي عن سقط روي عنه سقط سمعت ابي يقول ذلك وسمعته يقول هو مجهول
  مستورد بن سابق الغزال ويقال العصاب روي عن عبيد المكتب روي نه يحيي بن يحيي وصالح بن عبد الله الترمذي وعلي بن الحسن الرازي المعروف بالكراع سمعت ابي يقول ذلك نا عبد الرحمن قال سالت ابي عنه فقال هو شيخ
