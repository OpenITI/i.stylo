 ليالي التشريق الا بها وهي ليلة الحادي عشر والثاني عشر والثالث عشر للاخبار والاجماع علي ما في المنتهي ولا ينافيه ما في بعض الكتب من جعله من السنة او حصر واجبات الحج في غيره او الحكم بانه اذا طاف للنساء تمت مناسكه او حجه لجواز خروجه عنه وان وجب ونص الحلبي علي كونه من مناسكه ولذا اتفقوا ظاهرا علي وجوب الفداء علي من احل به ويجب النية كما في الدروس وفي اللمعة الحلية يستحب فينوي كما في الفخرية ابيت هذه الليلة بمني الحج المتمتع حج الاسلام مثلا لوجوبه قرنة الي الله فان احل بالنية عمدا اثم وفي الفدية وجهان كما في المسالك ووجوبه في الليالي الثلاثة لغير من اتقي ويجوز لمن اتقي النساء والصيد في حجة النفر يوم الثاني عشر اما جوازه في الجملة فعليه العلماء كافة كما في المنتهي وظاهر الاية واما كون الاتقاء الذي فيها بهذا المعني فيوافق للنهاية والمبسوط والوسيلة والمهذب والنافع والشرايع ودليله قول الصادق عليه السلام في خبر حماد اذا اصاب المحرم الصيد فليس له ان ينفر في النفر الاول ومن نفر في النفر الاول فليس له ان يصيب الصيد حتي ينفر الناس وهو قول الله عز وجل فمن تعجل في يومين فلا اثم عليه لمن اتقي قال اتقي الصيد وفي خبر محمد بن المستنير من اتي النساء في احرامه لم يكن له ان ينفر في النفر الاول واتيان النساء حقيقة عرفية في وطيهن وقد يلحق به مقدماته حتي النكاح واتقاء الصيد ظاهر في اتقاء قتله واخذ ولم يذكر في التبيان والمجمع وروض الجنان واحكام القران للراوندي سوي رواية الصيد وزاد ابن سعيد عليهما ساير ما حرم عليه في احرامه لقول ابي جعفر عليه السلام في خبر سلام بن المستنير لمن اتقي الرفث والفسوق والجدال وما حرم الله في احرامه لقول ابي جعفر عليه السلام وابن ابي المجد وابن ادريس في موضع ساير ما يوجب الكفارة وقد يعطي المختلف التردد بينه وبين ما في الكتاب والظاهر انه يكفي الاتقاء في الحج واحتمل فيه وفي العمرة التي تمتع بها وهل ارتكاب الصيد وغيره سهوا كالعمد هنا اوجه ثالثها ان الصيد كذلك لايجابه الكفارة وفي الكافي والغنية والاصباح ان الضرورة كغير المتقي ولو بات الليلتين بغير مني وجب عليه عن كل ليلة شاة وفاقا للمشهور لقول الصادق عليه السلام في صحيح جميل من زار فنام في الطريق فان بات بمكة فعليه دم وخبر علي سال ابا ابراهيم عليه السلام عن رجل زار البيت فطاف بالبيت وبالصفا والمروة ثم رجع فغلبته عينه في الطريق فنام حتي اصبح قال عليه شاة وقوله عليه السلام لصفوان في الصحيح سءلني بعضهم عن رجل بات ليلة من ليالي مني بمكة فقلت لا ادري قال صفوان فقلت له جعلت فداك ما تقول فيها قال عليه دم اذا بات واطلاقه قوله عليه السلام اذ سءله علي بن جعفر في الصحيح عن رجل بات بمكة في ليالي مني حتي اصبح فقال ان كان اتاها نهارا فبات حتي اصبح فعليه دم يهريقه وقول الصادق عليه السلام في صحيح معاوية لا تبيت ليالي التشريق الا بمني فان بت في غيرا فعليك دم لان اطلاقهما يفيد شاة لليلة فلليلتين شاتان وعليه منع ولما سياتي من خبر ثلاثة لثلث وفي الخلاف والغنية وظاهر المنتهي الاجماع عليه وفي المقنعة والهداية والمراسم والكافي وجمل العلم والعمل ان علي من بات ليالي بغيرها دما وهو مطلق كصحيح علي بن جعفر ومعوية فيحتمل الوفاق ولعله اظهر والخلاف اما بالتسوية بين ليلة وليلتين وثلثا وبان لا يجب الدم الا بثلث واطلاق النصوص والفتاوي يشمل الجاهل والناسي والمضطر فيكون جبرانا لا كفارة وعن الشهيد لا شء علي الجاهل وسال العيص الصادق عليه السلام في الصحيح عن رجل فاتته ليلة من ليالي مني قال ليس عليه شء وقد اساء وهو يحتمل الجهل والثالثة وما في التهذيب والاستبصار من الخروج بعد انتصاف الليل او الاشتغال بالطاعة في مكة وساله عليه السلام سعيد بن يسار في الصحيح فابتني ليلة المبيت بمني في شغل فقال لا باس وهو يحتمل ما فيهما والنسيان والضرورة والثالثة يحتملان ان يكون غلبته عينه بمكة او في الطريق بعد ما يخرج منها الي مني كخبر ابي البختري الذي رواه الحميري في قرب الاسناد عن الصادق عليه السلام عن ابيه عن علي عليه السلام في رجل افاض الي البيت فغلبته عيناه حتي اصبح قال لا باس عليه و يستغفر الله ولا يعود بل هنا اخبار بجواز النوم في الطريق اختيارا فقال الصادق عليه السلام في صحيح جميل من زار فنام في الطريق فان بات بمكة فعليه دم وان كان قد خرج منها فليس عليه شء وان اصبح دون مني وفي حسن هشام بن الحكم اذا زار الحاج من مني فخرج من مكة فجاوز بيوت مكة فنام ثم اصبح قبل ان ياتي مني فلا شء عليه وقال ابو الحسن عليه السلام في صحيح محمد بن اسماعيل اذا جاز عقبة المدينين فلا باس ان ينام وافتي به ابو علي والشيخ في كتابي الاخبار وعن عبد الغفار الجازي انه سءل الصادق عليه السلام عن رجل خرج من مني يريد البيت قبل نصف الليل فاصبح بمكة قال لا يصلح له حتي يتصدق بها صدقة او يهريق دما وهو مع جهل الطريق يحتمل الترديد من الراوي وكذا غير المتقي لو بات الثالثة بغيرها كان عليه شاة كما في الجامع والنافع والشرايع لاطلاق ما مر ولخبر جعفر بن ناجية سءل الصادق عليه السلام عمن باته ليالي مني بمكة قال ثلاثة من الغنم يذبحهن فان عم الاتقا المحرمات او موجبات الكفارة كان علي من احل بالمبيت في الثلث ثلث من الشياة كما في النهاية والسراير وان اتقي ساير المحرمات والا فشاتان كما في المبسوط والجواهر الا ان يبيتا اي التقي وغيره او المخل بالثالثة وبما قبلها بمكة مشتغلين بالطاعة وفاقا للمعظم لنحو قول الصادق عليه السلام في صحيح معاوية اذا فرغت من طوافك للحج وطواف النساء فلا تبت الا بمني الا ان يكون شغلك في نسك وصحيحه ايضا صحيح معاوية ساله عليه السلام عن رجل زار البيت فلم يزل في طوافه ودعاءه والسعي والدعاء حتي طلع الفجر فقال ليس عليه شء كان في طاعة الله عز وجل وهو يفيد العموم لكل عبادة واجبة او مندوبة ولزوم استيعاب الليل بها قال الشهيد الا ما يضطر اليه من غذاء او شراب او نوم يغلب عليه ولي فيه نظر قال ويحتمل ان القدر الواجب هو ما كان يجب عليه بمني وهو ان يتجاوز نصف الليل وهو عندي ضعيف نعم له المضي في الليل الي مني لاطلاق الثلاثة الاخبار المتقدمة في النوم في الطريق بل ظهورها فيه بل تضافر الاخبار بالامر به كقول احدهما عليهما السلام في صحيح ابن مسلم اذا خرجت من مني قبل غروب الشمس فلا تصح الا بمني ونحوه صحيح جميل عن الصادق وقول الصادق عليه السلام في صحيح العيص ان زار بالنهار او عشاء فلا ينفجر الصبح الا وهو بمني وفي صحيح معاوية ان خرجت اول الليل فلا ينتصف الليل الا وانت بمني الا ان يكون شغلك نسك او قد خرجت من مكة ونحوه خبر جعفر بن ناجية عنه وصحيح صفوان سال ابا الحسن عليه السلام بعد ما مر ان كان انما حبسه شانه اذا كان فيه من طوافه وسعيه لم يكن لنوم ولا لذة اعليه مثل ما علي هذا فقال ما هذا بمنزلة هذا وما احب ان ينشق له الفجر الا وهو بمني وخالف ابن ادريس فاستظهر ان عليه الدم وان بات بمكة مشتغلا بالعبادة عملا بالعمومات او يخرجا من مني بعد نصف الليل لقول الصادق عليه السلام في خبر عبد الغفار الجازي فان خرج من مني بعد نصف الليل لم يضره شء وفي خبر جعفر بن ناجية اذا خرج الرجل من مني اول الليل فلا ينتصف له الليل الا وهو بمني واذا خرج بعد نصف الليل فلا باس ان يصبح بغيرها وفي صحيح العيص ان زار بالنهار او عشاء فلا ينفجر الصبح الا وهو بمني وان زار بعد نصف الليل او السحر فلا باس عليه ان ينفجر الصبح وهو بمكة ويحتمله قوله عليه السلام في صحيح ابن عمار لا يبيت ليالي التشريق الا بمني فان بات في غيرها فعليك دم فان خرجت اول الليل فلا ينتصف الليل الا وانت في مني الا ان يكون شغلك نسك او قد خرجت من مكة وان خرجت بعد نصف الليل فلا يضرك ان تصبح في غيرها والافضل الكون الي الفجر كما في النهاية والمبسوط والكافي والسراير والجامع لصحاح ابن مسلم وجميل والعيص المتقدمة انفا ولخبر ابي الصحاح انه سءل الصادق عليه السلام عن الذبحة الي مكة ايام مني وهو يريد ان يزور البيت قال لا حتي ينشق الفجر كراهية ان يبيت الرجل بغير مني وهو يعطي كراهية الخروج كما في الوسيلة 
 وفي المختلف ان الخبر الجازي ينفعها وان كان الافضل المبيت بها الي الفجر ثم ان خبر ابني ناجية وعمار يفيد ان تساوي نصفي الليل في تحصيل الامتثال كما في الكافي ثم في النهاية والمبسوط والوسيلة والجامع انه اذا خرج من مني بعد الانتصاف فلا يدخل مكة قبل الفجر وفي الدروس انه لم نقف لهم علي ماخذ قلت ولعلهم استندوا الي امر من الاخبار الناطق بان الخارج من مكة ليلا الي مني يجوز له النوم في الطريق اذا جاز بيوت مكة لدلالتها علي ان الطريق في حكم مني فيجوز ان يزيد والفضل لما مر من ان الفضل الكون الي الفجر والوجوب اقتصارا علي اليقين وهو جواز الخروج بعد الانتصاف من مني لا من حكمه ولا يعارضه ما في قرب الاسناد من قول الكاظم عليه السلام لعلي بن جعفر وان كان خرج من مني بعد نصف الليل فاصبح بمكة فليس عليه شء ولصحيح العيص المتقدم لاحتمالهما بل يمكن ان يكونوا استظهروا منهما ما ذكروه نعم يبقي الكلام في ان الاصل هو المبيت جميع الليل فلا يستثني منه الا ما قطع باستثناءه ويبقي الباقي علي الوجوب ام الاصل الكون بها ليلا فلا يجب الا ما قطع بوجوبه وهو النصف وهو مبني علي معني البيتوتة فعن الفراء بات الليل اذا سهر الليل كله في طاعة او معصية وفي العين البيتوتة دخولك في الليل تقول بت اصنع كذا اذا كان بالليل وبالنهار ظللت وعن الزجاج كل من ادرك الليل فقد بات وعن ابن عباس من صلي بعد العشاء الاخرة ركعتين فقد بات لله ساجدا وقاءما وفي الكشاف في تفسير قوله تعالي والذين يبيتون لربهم سجدا وقياما البيتوتة خلاف الظلول وهو ان يدركك الليل نمت او لم تنم وقالوا من قرا شيءا من القران في صلاة وان قل فقد بات ساجدا وقاءما وقيل هما الركعتان بعد المغرب والركعتان بعد العشاء والظاهر انهم وصف لهم بحياء الليل او اكثره يقال فلان يظل صاءما ويبيت قاءما وانتهي ويجوز ان يكون انما استظهر هذا للمقام وكلام المنتهي يعطي فهم الاستيعاب لقوله لان المتجاوز عن النصف هو معظم ذلك الشء ويطلق عليه اسمه وقال امرء القيس فبات عليه سرجه ولجامه وبات بعيني قاءما غير مرسل وظاهر الاستيعاب وعلي كل فالظاهر انه لا اشكال في ان الواجب هذا استيعاب النصف من الليل او كله ولا يكفي المسمي فلذا وجبت مقارنة النية لاول الليل كما في المسالك ويجوز لذوي الاعذار المبيت حتي يضطرون اليه اذ لا حرج في الدين وفي وجوب الدم نظر من التردد في كونه كفارة او جبرانا والغنية تعطي العدم ومنهم الرعاة واهل السقاية فروي العامة ترخصهم ونفي عنه الخلاف والمنتهي وخصص مالك وابو حنيفة الرخصة للسقاية باولاد عباس وفي التذكرة والمنتهي انه قيل للرعاة ترك المبيت ما لم يغرب الشمس عليهم بمني فان غربت الشمس وجب عليهم بخلاف السقاة لاختصاص شغل الرعاة بالنهار بخلاف السقاة وافتي بهذا الفرق في التحرير والدروس وهو حسن وفي الخلاف واما من له مريض يخاف عليه او مال يخاف ضياعه فعندنا يجوز له ذلك لقوله تعالي ما جعل عليكم في الدين من حرج والزام المبيت والحال ما وصفناه حرج وللشافعي فيه وجهان ونحوه المنتهي وهو فتوي التحرير والدروس ومقرب التذكرة وفي الدروس وكذا لو منع من المبيت منعا او خاصا او عاما كنفر الحجيج ليلا قال ولا اثم في هذه المواضع وتسقط الفدية عن اهل السقاية والرعاة وفي سقوطها عن الباقين نظر قلت وجه الفرق بعض العامة بان شغل الاولين الحجيج عامة وشغل يخصهم ولو غربت الشمس يوم الثاني عشر بمني وجب علي المتقي المبيت ايضا لقول الصادق عليه السلام في حسن الحلبي فان ادركه المساء بات ولم ينفر وفي خبر ابن عمار اذا جاء الليل بعد النفر الاول فبت بمني وليس لك ان تخرج منها حتي تصبح وفي خبر ابي بصير فان هو لم ينفر حتي يكون عند غروبها فلا ينفر ولتبت بمني حتي اذا اصبح وطلعت الشمس فتنفر متي شاء ولان الاية انما سوغت التعجيل في يومين وبالغروب ينقضي اليومان وللاجماع كما في المنتهي وظاهر التذكرة فان رحل فغربت الشمس قبل خروجه من مني ففي المنتهي لم يلزمه المقام علي اشكال وفي التذكرة الاقرب ذلك مسندا فيهما الي المشقة في الحط و الرحال وفي الدروس الاشبه المقام وهو اولي وقد يمكن ان يسترشد الي الاول من قوله احدهما عليهما السلام في خبر علي في رجل بعث بنقله يوم النفر الاول واقام هو الي الاخير انه ممن يعجل في يومين اما لو غربت وهو مشغول بالتاهب فالوجه اللزوم كما في التحرير والمنتهي وفي التذكرة انه الاقرب واذا وجب عليه المبيت في ليلة الثالث عشر فان اخل به فشاة كالليلتين المتقدمتين لما تقدم ويجب ان يرمي الجمار الثلاث في كل يوم من الحادي عشر والثاني عشر لقول الصادق عليه السلام في حسن ابن اذينة الحج الاكبر الوقوف بعرفة ورمي الجمار وفي خبر عبد الله بن جبلة من ترك رمي الجمار متعمدا لم يحل له النساء وعليه الحج من قابل وفي التذكرة والمنتهي انه لا نعلم فيه خلافا وفي الخلاف الاجماع علي وجوب الترتيب بين رمي الجما