 الانتظار حتي تقام الصلاة لزمهم ذلك وان لحقهم مشقة لم يلزمهم انتهي قال ابن ادريس لان العذر وخص له يعني المعذور في التاخر فاذا حضر زالت الرخصة ولزم الفرض انتهي وستسمع النص عليه وقد يحتمل في غير البعيد اذا حضر عموم الرخصة لعموم الوضع عنهم واستثناءهم من الوجوب في الاخبار مع الاصل وقد يحتمل العزيمة وان بعدت عن لفظ الوضع ثم الظاهر ان المراد الوجوب عينا كما هو صريح يب وفي والغنية ويرء ونهاية الاحكام ويحتمل التخيير دفعا لاحتمال العزيمة وعدم الانعقاد وقال القاضي في المهذب ويجب صلاتها علي العقلاء من هءلاء اذا دخلوا فيها وصلوها عن صلاة الظهر وفي شرح جمل العلم والعمل وجميع من ذكرنا سقوطها عنهم فاولوا العقل اذا دخلوا فيها وجبت عليهم الدخول فيها؟ صلاتها عن صلاة الظهر وقد يفهم منهما عدم تحتم الدخول وفي المبسوط ان حضروا الجمعة وتم بهم العدد وجبت عليهم ونحوه الاصباح والظاهر انه اذا وجب العقد عليهم فاولي ان يجب الفعل اذا انعقدت ولما وجبت عليهم انعقدت بهم كما في الغنية ويرء والشراءع لعموم الادلة الا غير المكلف للصغر او الجنون والمراة والعبد علي راي فلا يجب عليهم عينا ولا تنعقد بهم اما الانعقاد بمن عداهم فكانه لا خلاف فيه الا الهم الذي لا حراك به فلم يعد في شء من المبسوط ولة والاصباح ممن تنعقد بهم مع تعرضهم لعدم الوجوب عليه وحصر الشيخ الناس فيمن يجب عليه وتنعقد به ومن لا يجب عليه ولا تنعقد به ومن اختلف فيه وعدم ادخاله له في شء من الاقسام وحصر ابن حمزة لهم فيمن يجب عليه وتصح به ومنه ومن تجب عليه ولا تصح به ولا منه ومن لا تجب عليه وتصح به ومنه ومن لا تجب عليه ولا تصح به وتصح منه ولعدم ادخاله له في شء فلعلهم ادرجوه في المريض او جعلوا صلاته لانه لا حراك به مما لا عبرة بها لعدم الركوع والسجود فيها الا ايماء واعدام الوجوب والانعقاد بالطفل والمجنون فكانه لا خلاف فيه عندنا وعن الشافعي قول بالانعقاد بالصبي المميز وفي المبسوط نفي ف عن العدم منا ومن العامة واما المراة ففي التذكرة الاجماع علي عدم الانعقاد بها ويءيده اختصاص الرهط والنفر والقوم والخمسة والسبعة بالرجال ومضت عبارة الغنية وفي يب ويه وفي والغنية والاشارة ويرء والتحرير والمنتهي الوجوب عليها اذا حضرت لخبر حفص بن غياث انه سمع بعض مواليهم يسال ابن ابي ليلي عن الجمعة هل تجيب علي العبد والمراة والمسافر قال لا قال فان حضر واحد منهم الجمعة مع الامام فصلاها هل تجزيه بذلك الصلاة عن ظهر يومه قال نعم قال وكيف يجزء ما لم يفرضه الله عليه عما فرضه عليه الي ان قال فما كان عند ابي ليلي جواب وطلب اليه ان يفسرها له فابي ثم فسرها الحفص فقال الجواب عن ذلك ان الله عز وجل فرض علي جميع المءمنين والمءمنات ورخص للمراة والعبد والمسافر ان لا ياتوها فلما حضروا سقطت الرخصة ولزمهم الفرض الاول فمن اجل ذلك اجزء عنهم قال حفص فقلت عمن هذا فقال عن مولانا ابي عبد الله (ع) وما في قرب الاسناد للحميري عن عبد الله بن الحسن عن جده علي بن جعفر انه سال اخاه عن عن النساء هل عليهن من صلاة العيدين والجمعة ما علي الرجال قال نعم وتردد الفاضلان في المعتبر والتذكرة للاصل وضعف خبر حفص وارساله وجهل الثاني واستحباب التستر لهن والصلاة في بيوتهن وقول ابي الحسن (ع) في خبر ابي همام اذا صلت المراة في المسجد مع الامام يوم الجمعة ركعتين فقد نقضت صلاتها وان ضلت في المسجد اربعا نقضت صلاتها لتصل في بيتها اربعا افضل والمراد الوجوب عينا والا فلا خلاف في جواز صلاتهن الجمعة اذا من الافتتان والافتضاح واذن لهن من عليهن استيذانه واذا صليتها كانت احد الواجبين تخييرا واما العبد والمسافر ففي الخلاف والغنية ويرء والمعتبر والمنتهي والارشاد والتلخيص الانعقاد بهما للعموم وخبر حفص وفي الغنية الاجماع وفي المبسوط ولة والاصباح والمختلف العدم لان الاعتداد بالعبد يوجب التصرف في ملك الغير بغير اذنه وهو قبيح ولا فارق من الاصحاب بينه وبين المسافر مع انها لو انعقدت بالمسافر لزم تعينا عليه لا ان العدد ان اجتمعوا مسافرين انعقدت بهم واذا انعقدت وحيت وقد يمنع الوجوب عينا ولا يجدي التخيير والتصرف في ملك الغير بغير اذنه لا يتم مع الاذن وايضا فلا اعتبار بالاذن في الفراءض وللعبد صلاة الفريضة اول وقتها اينما ادركته اذا لم يخل بحق المولي ولم ينهه وفي المبسوط نفي الخلاف عن عدم الوجوب والانعقاد وفي لة والاصباح ايضا عدم الوجوب ولكنها تحتمل عدم وجوب الحضور وفي يب ويه وفي ويرء والغنية والارشاد والتلخيص والنافع وشرحه والجامع الوجوب للخبر وفي الشراءع في العبد تردد يحتمله في الوجوب وفي الانعقاد وفيهما وفي المنتهي انه لا خلاف في اجزاءها لهما قلت وقال ابو جعفر (ع) في خبر سماعة الذي رواه الصدوق في الامالي وثواب الاعمال ايما سافر صلي الجمعة رغبة فيها وحبا لها اعطاه الله عز وجل اجر ماءة جمعة للمقيم ولكن قال الصادق (ع) في صحيح ربعي والفضل ليس في السفر جمعة ولا فطر ولا اضحي وفي صحيح ابن مسلم صلوا في السفر صلاة الجمعة جماعة بغير خطبة وفي صحيحة ايضا ويصنعون كما يصنعون في الظهر في غير يوم الجمعة وتحتمل الرخصة وتجب اذا اجتمعت الشرايط علي اهل السواد اي القري وسكان الخيم في البوادي مع الاستيطان فيها عندنا للعمومات وخصوص ما مضي من خبر الفضل بن عبد الملك عن الصادق عن ومفهوم قول احدهما (ع) في خبر ابن مسلم في اناس في قرية يصلون اربعا اذا لم يكن من يخطب ولا علم علي خبر حفص بن غياث عن الصادق (ع) عن ابيه (ع) ليس علي اهل القري جمعة ولا خروج في العيدين وخبر طلحة بن زيد عنه عن ابيه عن امير المءمنين (ع (لا جمعة الا في مصر تقام في الحدود ولضعفهما مع الاحتمال الاول انه ليس عليهم ذلك لان العامة يرون السقوط عنهم فالعامة من اهل القري لا يفعلون فليس علي المءمنين منهم تقية والثاني ان الجمعة لا تقبل ولا تكمل اذا اخل باقامة الحدود واكثر الجمهور واشترطوا في وجوبها القرية المبنية مما جرت العادة ببناءها منه من الحجر والطين واللبن والقصب والشجر ولم يوجبوها علي سكان الخيام وبيوت الشعر وتردد الشيخ في المبسوط من عدم الدليل ومن عموم الاخبار ولم يوجبها ابو حنيفة علي اهل القري ومن بعد عن الجمعة بفرسخين فما دون يجب عليه الحضور او صلاتها في موطنه اذا بعد عن الاولي بفرسخ وفاقا؟ للعموم وخصوص نحو قول الصادق ع في حسن ابن مسلم يجب علي من كان منها علي راس فرسخين فان زاد علي ذلك فليس عليه شء وقول ابي جعفر ع في حسنه مع زرارة تجب الجمعة علي من كان منها علي فرسخين واسقطها الصدوق وابن حمزة عمن علي راس فرسخين لما مضي من قوله (ع) في صحيح زرارة وحسنه وضعها عن تسعة الي قوله ومن كان علي فرسخين وقول امير المءمنين (ع) في الخطبة مثل ذلك واجاب في المنتهي بالحمل علي من زاد بقليل قال اذ الحصول علي نفس الفرسخين ممتنع وفي المختلف علي السهو وانما تعتبر المسافة بين الموضع الذي هو فيه وموضع الصلاة لا البلدين ولا مكانه والجامع كما في التذكرة ونهاية الاحكام ولو كان بينه وبين بعض الجماعة اقل من فرسخين وبينه وبين الاخرين اكثر وجب عليه الحضور فان المفهوم من كونه منها علي فرسخين واكثر ولو نقص البعد او بعده عن فرسخ وجب عليه الحضور او التباعد لعقد جمعة اخري ولو زاد علي الفرسخين وحصلت الشراءط صلاها في موطنه او حضر فضلا عن الفرسخين فما دونهما ولو فقد احدهما اي الشروط والبعيد اكثر من فرسخين سقطت وفاقا للمعظم للاخبار واوجب الحسن الحضور علي من اذا غدا من اهله بعد صلاة الغداة ادرك الجمعة وابو علي علي من يصلي الي منزله بعد الصلاة في نهاره ومعناهما متقاربان وبهما صحيح زرارة عن ابي جعفر ع وحمل علي الاستحباب جمعا والمسافر ان وجب عليه التمام وجبت عليه لخروج كثير السفر عن اسمه والعصيان عن سبب الرخصة وفي المنتهي لم اقف لعلماءنا علي قول في اشتراط الطاعة في السفر والا فلا تجب عليه تحتم عليه القصر ام لا واحتمل في نهاية الاحكام الوجوب علي من يستحب له الاتمام ويحرم السفر بعد الزوال قبلها علي من تجب عليه الي غير جهتها لان سبب الاخلال بها حرام كالاخلال ولقول امير المءمنين ع المروي في نهج البلاغة لا تسافر يوم الجمعة حتي تشهد الصلاة الا فاضلا في سبيل الله او في امر تعذر به وفي التذكرة والمنتهي الاجماع وقد تجب بحج او جهاد او تحصيل علم او اتباع؟ او ابق او رقيق او غير ذلك اما في سفر البعيد الي جهة الجمعة او عن جمعة الاخري فوجهان من انتفاء علة الحرمة من حرمانها ومن عموم النهي وان جوازه يقتضي حرمانها فيحرم فلا يحرم فيجوز فيحرم وفيه انه مشترك فانه لو حرم لم يحرم فلم يحرم فيحرم علي ان اقتضاء الحرمان تتم فانما يقتضي جواز الترك بل تمنع ايضا قال الشهيد ويحتمل 
 ان يقال ان كانت في محل الترخص لم يجز لان فيه اسقاط الوجوب الجمعة وحضوره فيما بعد تجديد الوجوب الا ان يق يتعين عليه الحضور وان كان مسافرا لان اباحة سفره مشروطة بفعل الجمعة ومثله لو كان بعيدا بفرسخين فما دون عن الجمعة فخرج مسافرا في صوب الجمعة فانه يمكن ان يق يجب عليه الحضور عينا وان صار في محل الترخص لانه لولاه لحرم عليه السفر قال ويلزم من هذين تخصيص قاعدة عدم الوجوب العيني علي المسافر قال ويحتمل عدم كون هذا القدر محسوبا من المسافة لوجوب قطعة علي كل تقدير اما عينا كما في هذه الصورة واما تخييرا كما في الصورة الاولي ويجري مجري الملك في اثناء المسافة ويلزم من هذا خروج قطعة من السفر عن اسمه بغير موجب مش قال وان كانت قبل محل الترخص كموضع يري الجدار او يسمع الاذان ان امكن هذا الفرض جاز ويكره بعد الفجر قبل الزوال لقول الهادي (ع) في خبر السري يكره السفر والسعي في الحواءج يوم الجمعة بكرة من اجل الصلاة ومن العامة ممن حرمه وتسقط عن المكاتب والمدبر والمعتق بعضه وان هاياه مولاه واتفقت في يومه وفاقا لابني سعيد للعموم وخلافا للمط قال لانه ملك نفسه في ذلك اليوم قال الشهيد ويلزمه مثله في المكاتب وخصوص المطلق وهو بعيد لان مثله في شغل شاغل اذ هو مدفوع في يوم نفس الي الخد في المكسب لنصف الحر فالزامه بالجمعة خرج عليه قلت مضي عن المبسوط وغيره السقوط المثل التجهيز والمطر وقد لا يقصر عنها ما ذكر فلا يلزمه بها قال لو قلنا بوجوبها علي قول الشيخ ففي انعقادها به الوجهان السالفان ويصلي من سقطت عنه الجمعة الظهر في وقت الجمعة وليس عليه التاخير عنه ولا يستحب له للاصل وعموم فضل اول الوقت واستحب الشافعي للمعذور والتاخير الي اخر الوقت ومن العامة من اوجب التاخير الي فراغ الامام واستحبه في نهاية الاحكام لمن يرجوا زوال عذره الي الباس عن ادراك الجمعة وهو رفع الامام راسه من ركوع الثانية فان حضرها اي الجمعة بعد صلاته اي الظهر لم تجب عليه للاصل خلافا لابي حنيفة وان زال المانع كعتق العبد ونية الاقامة كما اذا قصر ثم نوي الاقامة اما الصبي فتجب عليه اذا بلغ بعد صلاة الظهر فانها لم تكن فرضه وكذا الخنثي اذا وضحت ذكوريته المطلب الثالث في ماهيتها وادابها وفيه اداب ليومها فان ايقاع الظهر في الجامع لمن لا تجب عليه ليس من ادب صلاة الجمعة وكذا التنفل ان كان لليوم وكذا حلق الراس وما بعده ولكن يمكن جعلها من ادابها وان استحب لليوم ايضا وهي ركعتان عوض الاربع فرض الظهر ويستحب فيهما الجهر كما في مصباح الشيخ والاصباح والنافع وشرحه اجماعا وفي المعتبر لا يختلف فيه اهل العلم قلت ظ قول الصادق عن في صحيح عمر بن يزيد ويجهر بالقراءة او في خبر عبد الرحمن العزرمي اذا ادركت الامام يوم الجمعة وقد سبقك بركعة فاضف اليها ركعة اخري واجهر فيها الوجوب واكثر الاصحاب ذكروا الجهر فيها علي وجه يحتمل الوجوب وفي المنتهي اجمع كل من يحفظ عنه العلم علي انه يجهر بالقراءة في صولة الجمعة ولم اقف علي قول الاصحاب في الوجوب وعدمه والاصل عدمه ويدل علي الجهر ما رواه الشيخ في الصحيح عن جميل عن ابي عبد الله ع انما يجهر اذا كانت خطبة ومثله روي في الصحيح عن محمد بن مسلم ثم ذكر الخبرين والاذان الثاني بدعة كما في فقه القران للراوندي والنافع والشراءع ولة وحكي عن الخلاف ابتدعه عثمان وقال الساءب بن يزيد كان لرسول الله ص مءذن واحد بلال وكان اذا جلس علي المنبر اذن علي باب المسجد فاذا نزل قال للصلاة ثم كان ابو بكر وعمر كك اذا كان عثمان وكثر الناس وتباعدت المنازل؟ فامر بالتاذين الاول علي سطح دار له بالسوق يق له الزوراء وكان يءذن لها عليها فاذا جلس عثمان علي المنبر اذن مءذنه فاذا نزل اقام للصلاة فلم يعب ذلك عليه وفي المبسوط عن عطاء المبتدع معاوية وفي يرء ثم ينزل الامام علي المنبر بعد فراغه من اكمال الخطبتين ويبتدء المءذن الذي بين يديه بالاقامة وينادي باقي المءذنين والمكبرين الصلاة ولا يجوز الاذان بعد نزوله مضافا الي الاذان الاول الذي عند الزوال فهذا هو الاذان المنهي عنه ويسميه بعض اصحابنا الاذان الثالث وسماه ثالثا لانضمام الاقامة اليها فكانها اذان اخر انتهي وفي المعتبر الاذان الثاني بدعة وبعض اصحابنا يسميه الثالث لان النبي ص شرع الصلاة اذانا واقامة فالزيادة ثالثا وسميناه ثانيا لانه يقع عقيب الاذان الاول وما بعده يكون اقامة والتفاوت لفظي انتهي والبدعة وان لم يكن نصا في الحرمة لكن المختلف والمنتهي كالسراءر صريحان في التحريم ودليله انه بدعة كالاذان لغير اليومية من الصلاة او قول ابي جعفر (ع) في خبر حفص بن غياث الاذان الثالث يوم الجمعة بدعه وفي المبسوط والاصباح والمعتبر انه مكروه وللاصل وضعف الخبر وعموم البدعة للحرام وغيره وحس الذكر والدعاء الي المعروف وتكريرهما قال المحقق لكن من حيث لم يفعله النبي ص ولم يامر به كان؟ بوصف الكراهية انتهي والحق الحرمة ان فعله علي انه وظيفة والجواز ان لم ينو الا الذكر والتنبيه والدعاء الي الصلاة كما تحرم الشهادة بالولاية ان نواها جزء الاذان ويجوزان لم ينوها جزء ويحرم الاذان لغير اليومية ان نواه وظيفة لها وبذلك يمكن رفع الخلاف من البين وفي مساءل من الخلاف لا باس ان يءذن اثنان واحد بعد اخر وان اتيا بذلك موضعا واحد كان افضل ولا ينبغي ان يزاد علي ذلك وقال الشافعي المستحب ان يءذن واحد ويجوز ان يكونوا اكثر من اثنين فان كرر وخيف فوات اول الوقت قطع الامام بينهم الاذان وصلي دليلنا اجماع الفرقة علي ما رواه ان الاذان الثالث بدعة فدل ذلك علي جواز الاثنين والمنع عما زاد علي ذلك انتهي وهو صريح في مغايرة الثالث للثاني وفي الذكري ينبغي ان يكون اذان المءذن بعد صعود الامام علي المنبر والامام جالس لقول الباقر (ع) فيما رواه عبد الله بن ميمون كان رسول الله ص اذا خرج الي الجمعة قعد علي المنبر حتي يفرغ المءذنون وبه افتي ابن الجنيد وابن ابي عقيل والاكثر وقال ابو الصلاح اذا زالت الشمس امر مءذنه بالاذان فاذا فرغوا منه صعد المنبر وخطب ورواه محمد بن مسلم قال سالته عن الجمعة فقال اذان واقامة يخرج الامام بعد الاذان فيصعد المنبر ويتفرع علي الخلاف ان الاذان الثاني الموصوف بالبدعة او الكراهية ما هو وابن ادريس يقول الاذان المنهي عنه هو الاذان بعد نزوله مضافا الي الاذان الذي عند النزول انتهي يعني ان الاذان المشروع للجمعة اما قبل صعود الامام المنبر او بعده عند جلوسه عليه فالجمع بينهما بدعة او مكروه وعلي الاول فالبدعة او المكروه الثاني وعلي الثاني الا ولي وسمي ثانيا لحدوثه بعد الثاني قال في البيان واختلف في وقت الاذان فالمشهور انه حال جلوس الامام علي المنبر وقال ابو الصلاح قبل الصعود وكلامهما مرويان فلو جمع بينهما امكن نسبة البدعة الي الثاني زمانا والي غير الشرعي فنزل علي القولين قال وزعم ابن ادريس ان المنهي عنه هو الاذان بعد نزول الخطيب مضافا الي الاقامة وهو غريب قال وليقم المءذن الذي بين يدي الامام وباقي المءذنين ينادون الصلاة الصلاة وهو اغرب قال وعن الباقر (ع) الاذان الثالث يوم الجمعة بدعة ويمكن حمله علي هذا بالنظر الي الا قامة وعلي اذن العصر يوم الجمعة سواء صلوها جمعة او ظهر او قال ابن البراج وابن ادريس يءذن للعصر ان صلاها طهر او الاقرب كراهية اذان العصر هنا مط انتهي ويب يعطي ان الاذان الثالث في خبر حفص اذان العصر ونص في المبسوط علي كراهية لها وفي نهاية الاحكام علي عدم الجواز ونص ابن ادريس علي انتفاء الاذان للعصر ان صلي الجمعة لا ان اصلي الظهر وانه مراد الشيخ وهو موافق للكامل والمهذب ونص الحلبي علي انتفاءه لها علي التقديرين علي اثباته لها عليهما لكن الشيخ في التهذيب حكي عنه الاسقاط اذا صلي الجمعة واستدل ابن ادريس بان الاذان مندوب لكل صلاة الا ما خرج بالاجماع ويحرم البيع اتفاقا بعد الاذان للجمعة كما في المبسوط والخلاف ويغرهما حين يقعد الامام علي المنبر علي ما فيهما وفي الاصباح والجامع والمنتهي ونهاية الاحكام الا ان الثلاثة الاولي اقدمت الاذان والخطبة علي الزوال كما تقدم دون الباقية ولا يحرم قبله وان زالت الشمس كما في التبيان وفقه القران للراوندي للاصل وكون العطف علي؟ اظهر والنداء هو الاذان وفي؟
