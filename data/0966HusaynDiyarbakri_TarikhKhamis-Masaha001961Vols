 واحمد مصطفي فينا مطاع ~ فلا تغشوه بالقول العنيف

 فلا والله نسلمه لقوم ~ ولما نقض فيهم بالسيوف

 وعند غير ابن اسحاق ان كلام ابي جهل للنبي (صلي الله عليه وسلم) كان عند الحجون وانه صب التراب علي راس رسول الله (صلي الله عليه وسلم) ووطء برجله علي عاتقه وان المراة التي اخبرت حمزة سلمي مولاة صفية بنت عبد المطلب وانه قال لها انت رايت هذا الذي تقولين قالت نعم فدخل سريعا فنظر الي الخلق لا يتكلم يعرف في وجهه الغضب حتي وقف علي ابي جهل فحمل عليه بالقوس فضربه ضربة اوضحت في راسه وذكر ما مضي بعده وقال قال حمزة اشهد ان لا اله الا الله واشهد ان محمدا عبده ورسوله والله لا انزع فامنعوني ان كنتم صادقين* وخرج صاحب الصفوة ذكر الايضاح بالقوس حين بلغه ما نال ابو جهل من رسول الله (صلي الله عليه وسلم) لا غير وكان اسلامه في السنة الثانية من المبعث وقيل كان اسلامه بعد دخول النبي (صلي الله عليه وسلم) دار الا رقم في السنة السادسة من المبعث ولم يذكر في الصفوة غيره وذكر الحافظ ابو القاسم الدمشقي ان اسلامه كان يوم ضرب ابو بكر حين ظهر النبي (صلي الله عليه وسلم) قبل اسلام عمر من دار الا رقم وروي ان ذلك كان قبل اسلام عمر بثلاثة ايام والتوفيق بين الاحاديث كلها ممكن كذا في ذخاءر العقبي وفي المنتقي وكان حمزة بن عبد المطلب اسلم يوم ضرب ابو بكر وذلك ان اصحاب رسول الله (صلي الله عليه وسلم) ورضي عنهم لما اجتمعوا وكانوا تسعة وثلاثين رجلا الح ابو بكر علي رسول الله (صلي الله عليه وسلم) في الظهور فقال يا ابا بكر انا قليل فلم يزل يلح عليه حتي ظهر رسول الله (صلي الله عليه وسلم) في نواحي المسجد وقام ابو بكر في الناس خطيبا ورسول الله (صلي الله عليه وسلم) جالس وكان اول خطيب دعا الي الله عز وجل والي رسوله (صلي الله عليه وسلم) وثار المشركون علي ابي بكر وعلي المسلمين يضربونهم في نواحي المسجد ضربا شديدا ووطء ابو بكر وضرب ضربا شديدا ودنا منه الفاسق عتبة بن ربيعة فجعل يضربه بنعلين مخصوفتين ويحرفهما بوجهه واثر علي وجه ابي بكر حتي ما يعرف انفسه من وجهه وجاءت بنو تيم تتعادي فاجلوا المشركين عن ابي بكر وحملوا ابا بكر في ثوب حتي ادخلوه بيته ولا يشكون في موته ورجعت بنو تيم فدخلوا المسجد فقالوا والله لءن مات ابو بكر لنقتلن عتبة ورجعوا الي ابي بكر فجعل ابو قحافة وبنو تيم يكلمون ابا بكر حتي اجابهم فتكلم اخر النهار فقال ما فعل برسول الله (صلي الله عليه وسلم) فمسوه بالسنتهم وعذلوه ثم قاموا وقالوا لام الخير انظري ان تطعميه شيءا او تسقيه اياه فلما خلت به والحت عليه جعل يقول ما فعل برسول الله (صلي الله عليه وسلم) قالت والله ما لي علم بصاحبك قال فاذهبي الي ام جميل بنت الخطاب فاسالها عنه فخرجت حتي جاءت الي ام جميل فقالت ان ابا بكر يسالك عن محمد بن عبد الله قالت ما اعرف ابا بكر ولا محمد بن عبد الله وان تحبي ان امضي معك الي ابنك فعلت قالت نعم فمضت معها حتي وجدت ابا بكر صريعا دنفا فرنت ام جميل واعلنت بالضياح وقالت ان قوما نالوا منك هذا لاهل فسق واني لارجو ان ينتقم الله لك قال فما فعل رسول الله (صلي الله عليه وسلم) قالت هذه امك تسمع قال فلا عين عليك منها قالت سالم صالح قال فاين هو قالت في دار الا رقم قال فان لله تبارك وتعالي علي الية ان لا اذوق طعاما او شرابا او اتي رسول الله (صلي الله عليه وسلم) في الصحاح الالية اليمين علي وزن فعيلة والجمع الا يا قال الشاعر

 قليل الا لا يا حافظ ليمينه ~ وان سبقت منه الالية برت

 فامهلنا حتي هدات الرجل وسكن الناس خرجنا به يتكء علينا حتي ادخلناه علي النبي (صلي الله عليه وسلم) فاكب عليه فقبله واكب عليه المسلمون ورق رسول الله (صلي الله عليه وسلم) رقة شديدة فقال



 ابو بكر رضي الله عنه بابي وامي ليس بي الا ما نال الفاسق من وجهي هذه امي بره بوالديها وانت مبارك فادعها الي الله تعالي وادع الله لها عسي ان يستنقذها بك من النار فدعا لها رسول الله (صلي الله عليه وسلم) ثم دعاها الي الله عز وجل فاسلمت فاقاموا علي رسول الله (صلي الله عليه وسلم) شهرا وهم تسعة وثلاثون رجلا قال وكان اسلم حمزة يومءذ يوم ضرب ابو بكر كما مر*

  (ذكر اسلام عمر)

 * في الاكتفاء قال ابن اسحاق كان اسلام عمر بعد خروج من خرج من اصحاب رسول الله (صلي الله عليه وسلم) الي الحبشة وبعد حمزة بثلاثة ايام فيما قاله ابو نعيم كذا في سيرة مغلطاي* وفي سبب اسلام عمر اقوال اشهرها ما روي ان قريشا اجتمعت فتشاورت في امر النبي (صلي الله عليه وسلم) فقالوا اي رحل يقتل محمدا فقال عمر بن الخطاب انا لها فقالوا انت لها يا عمر فخرج متقلدا السيف في طلب النبي (صلي الله عليه وسلم) وكان رسول الله (صلي الله عليه وسلم) مع اصحابه في منزل حمزة في الدار التي في اصل الصفا فلما خرج عمر الي الصفالقية سعد بن ابي وقاص الزهري فقال اين تريد يا عمر فقال اريد ان اقتل محمدا قال انت احقر واصغر من ذلك فكيف تامن في بني هاشم وبني زهرة وقد قتلت محمدا* وفي رواية قال له سعد اتريد ان تقتل محمدا ويدعك بنو عبد مناف ان تمشي علي الارض فقال له عمر ما اراك الا قد صبات وتركت الدين الذي انت عليه وفي رواية قال له عمر لعلك قد صبات الي محمد فابدا بك فاقتلك وعند ذلك قال سعدا علم اني امنت بمحمد واشهد ان لا اله الا الله وان محمدا رسول الله فسل عمر سيفه وكشف سعد عن سيفه فشد كل واحد منهما علي الاخر حتي كاد ان يختلطا فقال سعد مالك يا عمر لا تصنع هذا باختك امنة بنت الخطاب وفي المواهب اللدنية فاطمة بنت الخطاب وزوجها سعيد ابن زيد بن عمرو بن نفيل فقال اسلما قال نعم فتركه عمر وسار الي منزل امنة وفي الصفوة قال سعد افلا ادلك علي العجب يا عمران اختك وختنك قد صبيا وتركا دينك الذي انت عليه فمشي عمر مسرعا حتي اتاهما وعندهما رجل من الانصار يقال له خباب بن الارت وهم يقرءون سورة طه فلما سمع خباب حس عمر تواري في البيت فدخل عمر عليهما فقال ما هذه الهينمة التي سمعتها عندكم فقالا ما عدا حديثا حدثناه بيننا قال فلعلكما قد صباتما فقال له ختنه ارايت يا عمر ان كان الحق في غير دينك فوثب عمر علي ختنه سعيد وبطش بلحيته فتواثبا وكان عمر رجلا شديدا قويا فضرب بسعيد الارض وجلس علي صدره فجاءت اخته فدفعته عن زوجها فلطمها عمر لطمة شج بها وجهها وفي الصفوة فنفحها نفحة بيده فدمي وجهها فلما نظرت الي الدم علي وجهها غضبت وقالت يا عدو الله اتضربني علي ان اوحد الله قال نعم او قالت يا عمران كان الحق في غير دينك اشهد ان لا اله الا الله وان محمدا رسول الله لقد اسلمنا علي رغم انفك فاصنع ما انت صانع فلما سمعها عمر ندم وقام من صدر زوجها فقعد ناحية ثم قال اعرضوا علي الصحيفة التي كنتم تدرسونها* وفي الصفوة اعطوني هذا الكتاب الذي عندكم فاقراه وكان عمر يقرا الكتب قالت اخته لا افعل قال ويحك قد وقع في قلبي ما قلت فاعطنيها انظر اليها واعطيك من المواثيق ان لا اخونك حتي تحرزيها حيث شءت قالت له اخته انك رجس فانطلق فاغتسل او توضا فانه كتاب لا يمسه الا المطهرون فخرج عمر ليغتسل وخرج اليها خباب بن الارت فقال اتدفعين كتاب الله الي عمر وهو كافر قالت نعم اني ارجو ان يهدي الله اخي فدخل خباب البيت وجاء عمر فدفعت اليه الصحيفة فاذا فيها بسم الله الرحمن الرحيم طه ما انزلنا عليك القران لتشقي الي قوله انني انا الله لا اله الا انا فاعبدني واقم الصلاة لذكري فقال عمر عند هذه ينبغي لمن يقول هذا ان لا يعبد معه غيره فقال عمر دلوني علي محمد فلما سمع خباب قول عمر خرج من البيت فقال ابشر يا عمر فاني ارجو ان يكون قد سبقت فيك دعوة رسول الله (صلي الله عليه وسلم) البارحة قال اللهم اعز الاسلام بعمر بن الخطاب او بابي جهل بن



 هشام* وفي سيرة مغلطاي اللهم ايد الاسلام بابي جهل بن هشام او بعمر بن الخطاب وفي كتاب الحاكم اللهم ايد الاسلام بعمر بن الخطاب ولم يذكر ابا جهل* ذكر الدارقطني ان عاءشة قالت انما قال النبي (صلي الله عليه وسلم) اللهم عز عمر بالاسلام لان الاسلام يعز ولا يعز فقال عمر يا خباب انطلق بنا الي رسول الله (صلي الله عليه وسلم) فقام خباب وسعيد معه حتي اتوا منزل حمزة دار الا رقم التي باصل الصفا فدقوا الباب فخرج بعض الاصحاب فنظر في شق الباب فرجع الي رسول الله (صلي الله عليه وسلم) فقال يا رسول الله هذا عمر نعوذ بالله من شره فقال افتحوا له الباب فان جاء بخير قبلناه وان جاء بشر قتلناه وفي الصفوة فانطلق عمر حتي اتي الدار وعلي الباب حمزة وطلحة وناس من اصحاب رسول الله (صلي الله عليه وسلم) فلما راي حمزة وجل القوم من عمر قال نعم هذا عمر فان يرد الله بعمر خيرا يسلم ويتبع النبي (صلي الله عليه وسلم) وان يرد غير ذلك يكن قتله علينا هينا قال والنبي (صلي الله عليه وسلم) داخل يوحي اليه ففتح لعمر الباب فدخل فاستقبله رسول الله (صلي الله عليه وسلم) في صحن الدار فاخذ بمجامع ثوبه وحماءل سيفه وفي المنتقي اخذ ساعده وانتهزه فارتعد عمر هيبة لرسول الله (صلي الله عليه وسلم) وجلس فقال اما انت منتهيا يا عمر حتي ينزل الله بك ما انزل بالوليد بن المغيرة يعني الخزي والنكال اللهم هذا عمر بن الخطاب اللهم اعز الدين بعمر بن الخطاب فقال عمر اشهد انك رسول الله وقال اخرج يا رسول الله وعن ابن عباس سءل عمر عن وجه تسميته الفاروق فاخبر ان حمزة اسلم قبله بثلاثة ايام ثم شرح الله صدره للاسلام فقال الله لا اله الا هو له الاسماء الحسني فما في الارض نسمة احب اليه من نسمة رسول الله (صلي الله عليه وسلم) فقال لاخته اين رسول الله (صلي الله عليه وسلم) قالت في دار الا رقم عند الصفا فاتي عمر الدار وحمزة في اصحابه جلوس في الدار ورسول الله (صلي الله عليه وسلم) في البيت فضرب عمر الباب فاستجمع القوم فقال لهم حمزة ما لكم قالوا عمر بن الخطاب فخرج اليه رسول الله (صلي الله عليه وسلم) فاخذ بمجامع ثيابه ثم نثره نثرة فما تمالك عمران وقع علي ركبتيه فقال ما انت بمنته يا عمر فقال اشهد ان لا اله الا الله وحده لا شريك له واشهد ان محمدا عبده ورسوله فكبر اهل الدار تكبيرة سمعها اهل المسجد فقال يا رسول الله السنا علي الحق ان متنا وان حيينا قال بلي والذي نفسي بيده انكم علي الحق ان متم وان حييتم فقال ففيم الاخفاء* وفي المنتقي قال يا رسول الله علام نخفي ديننا ونحن علي الحق وهم علي الباطل فقال يا عمر انا قليل فقد رايت ما لقينا فقال عمر والذي بعثك بالحق لا يبقي مجلس جلست فيه بالكفر الا جلست فيه بالايمان ثم خرج في صفين حمزة في احدهما وعمر في الاخر له كديد ككديد الطحين حتي دخلوا المسجد فنظر قريش الي عمر والي حمزة فاصابتهم كابة لم يصبهم مثلها فسماه رسول الله (صلي الله عليه وسلم) يومءذ الفاروق* وفي المنتقي ولما اسلم عمر قال يا رسول الله لا ينبغي ان نكتم هذا الدين اظهر دينك يا محمد فخرج رسول الله (صلي الله عليه وسلم) ومعه المسلمون وعمر امامهم ومعه سيفه ينادي لا اله الا الله محمد رسول الله حتي دخل المسجد الحرام فنظرت قريش فقالوا لقد اتاكم عمر مسرورا قالوا ما وراءك يا عمر قال وراءي لا اله الا الله محمد رسول الله فان تحرك احد منكم لامكنن سيفي منه ثم تقدم امام رسول الله (صلي الله عليه وسلم) يطوف ويحميه حتي فرغ رسول الله (صلي الله عليه وسلم) من طوافه* وفي المواهب اللدنية قال عمر بعد ما اسلم ثم خرجت فذهبت الي رجل لم يكن يكتم السر فقلت له اني صبات قال فرفع صوته باعلاه الا ان ابن الخطاب قد صبا فما زال الناس يضربوني واضربهم فقال خالي ما هذا قيل ابن الخطاب فقام علي الحجر واشار بكمه فقال الا اني قد اجرت ابن اختي فانكشف الناس

 عني فما زلت اضرب واضرب حتي اعز الله الاسلام* وفي الصفوة عن ابن عمر ان النبي (صلي الله عليه وسلم) دعا لعمر فقال اللهم اعز الاسلام



 باحب الرجلين اليك بعمر بن الخطاب او بابي جهل بن هشام* وفي المنتقي كانت الدعوة يوم الاربعاء فسبقت في عمر فاسلم يوم الخميس ثم خرج عمر وطاف بالبيت ثم مر بقريش وهي تنظره فقال ابو جهل ابن هشام زعم فلان انك صبات فقال عمر اشهد ان لا اله الا الله وان محمدا عبده ورسوله فوثب المشركون عليه فوثب عمر علي عتبة بن ربيعة وبرك عليه وجعل يضربه وادخل اصبعيه في عينيه فجعل عتبة يصيح فتنحي الناس عنه فقام عمر فجعل لا يدنو منه الا احد شريف وجعل حمزة يكشف الناس عنه ويضرب فيهم حتي احجم الناس عنه واتبع عمر المجالس التي كان يجلس فيها فاظهر الايمان غير هاءب ولا خاءف فخرج رسول الله (صلي الله عليه وسلم) وعمر امامه وحمزة بن عبد المطلب رضي الله عنهما حتي طاف بالبيت وصلي الظهر معلنا ثم انصرف رسول الله (صلي الله عليه وسلم) الي دار الارقم* وفي الصفوة اسلم عمر وهو ابن ست وعشرين سنة بعد اربعين وفي العمدة قيل كان اسلم ثلاثة وثلاثون رجلا وست نسوة ثم اسلم عمر وقال سعيد بن المسيب بعد اربعين رجلا وعشر نسوة وقال عبد الله بن ثعلبة بعد خمسة واربعين رجلا واحدي عشرة امراة* وفي المواهب اللدنية وكان المسلمون اذ ذاك بضعة واربعين رجلا واحدي عشرة امراة* وعن داود ابن الحصين والزهري قالا لما اسلم عمر نزل جبريل فقال يا محمد استبشر اهل السماء باسلام عمر رواه ابن ماجه كذا في المواهب اللدنية الا ان فيه روي عن ابن عباس* وقال ابن مسعود ما زلنا اعزة منذ اسلم عمر* وقال صهيب لما اسلم عمر جلسنا حول البيت حلقا وطفنا وانتصفنا ممن غلظ علينا* وفي المواهب اللدنية اسلم عمر بن الخطاب بعد حمزة بثلاثة ايام فيما قاله ابو نعيم بدعوته (صلي الله عليه وسلم) اللهم اعز الاسلام بابي جهل او بعمر بن الخطاب*

  وقعة بعاث

 وفي السنة السابعة من النبوة وقعت وقعة بعاث في القاموس بعاث بالعين والغين موضع قرب المدينة ويومه معروف وفي شرح الكرماني لصحيح البخاري بعاث بضم الموحدة وتخفيف المهملة وبالمثلثة اسم بقعة بقرب المدينة وقع فيها حرب بين الاوس والخزرج وسببه قتل مجدر بن زياد سويد بن الصامت كما سيجء في الموطن الثالث في غزوة احد قيل هاجر رسول الله (صلي الله عليه وسلم) الي المدينة بعد بعاث بست سنين وقيل بخمس

  * تقاسم قريش علي معاداة بني هاشم وبني المطلب

 وفي السنة السابعة من النبوة كما في حياة الحيوان او الثامنة منها علي ما في المنتقي تقاسمت قريش وتعاهدت علي معاداة بني هاشم وبني المطلب وفي الاستيعاب بعد المبعث بست سنين وقيل بخمس وفي المناسك للكرماني وكان اجتماعهم وتحالفهم في خيف بني كنانة بالابطح ويسمي محصبا وهو باعلا مكة عند المقابر* وفي المواهب اللدنية ولما رات قريش عز النبي (صلي الله عليه وسلم) بمن معه وعز اصحابه بالحبشة واسلام عمر وفشو الاسلام في القباءل اجمعوا علي ان يقتلوا النبي (صلي الله عليه وسلم) فبلغ ذلك ابا طالب فجمع بني هاشم وبني المطلب وادخلوا رسول الله (صلي الله عليه وسلم) شعبهم ومنعوه ممن اراد قتله فاجابوه لذلك حتي كفارهم فعلوا ذلك حمية علي عادة الجاهلية فلما رات قريش ذلك اجتمعوا واءتمروا ان يكتبوا كتابا يتعاقدون فيه علي بني هاشم وبني المطلب ان لا يناكحوهم ولا يبايعوهم ولا يخالطوهم ولا يقبلوا منهم صلحا ابدا حتي يسلموا رسول الله (صلي الله عليه وسلم) للقتل وكتبوا في صحيفة بخط منصور بن عكرمة بن هشام وقيل بغيض بن عامر فشلت يده وعلقوا الصحيفة في جوف الكعبة هلال المحرم سنة سبع من النبوة وانحاز بنو هاشم وبنو المطلب الي ابي طالب ودخلوا معه شعبه الا ابا لهب فكان مع قريش واقاموا علي ذلك سنتين او ثلاثا* وقال ابو سعد سنتين حتي جهدوا وكانت قريش قد قطعت عنهم الميرة والمادة وكان لا يصل اليهم شء الا سرا وكانوا لا يخرجون الا من موسم الي موسم* وفي المواهب اللدنية ثم قام رجال في نقض الصحيفة



 فاطلع الله نبيه علي امر الصحيفة علي ان الارضة اكلت جميع ما فيها من القطيعة والظلم فلم تدع الا اسم الله فقط فاخبرهم ابو طالب بذلك فلما انزلت لتمزق وجدت كما قال (عليه السلام) فاخرجوهم من الشعب وذلك في السنة العاشرة* واورد في المنتقي تقاسم قريش علي معاداة بني هاشم وبني المطلب في السنة الثامنة من النبوة* وفي سيرة اليعمري حاصره اهل مكة في الشعب فاقام محصورا دون ثلاث سنين هو واهل بيته وخرج من الشعب وله تسع واربعون سنة* وفي الاستيعاب حصرتهم قريش في الشعب بعد المبعث بست سنين ومكثوا في ذلك الحصار ثلاث سنين وخرجوا منه في اول سنة خمسين من عام الفيل وتوفي ابو طالب بعد ذلك بستة اشهر وتوفيت خديجة بعده بثلاثة ايام وقد قيل غير ذلك وولد عبد الله بن عباس في الشعب قبل خروج بني هاشم منه وقيل انه ولد قبل الهجرة بثلاث سنين وكان ابن ثلاث عشرة سنة يوم مات رسول الله (صلي الله عليه وسلم)*

  نزول سورة الروم

 وفي السنة الثامنة من النبوة نزلت الم غلبت الروم الاية روي انه بعث قيصر رجلا يسمي قطمة بجيش الروم وبعث كسري برويز شهريزاد فالتقيا باذرعات وبصري وهي بادني الشام فغلب فارس علي الروم فبلغ الخبر مكة فشق ذلك علي المسلمين وكرهوه لان فارس مجوس لا كتاب لهم وكانوا يجحدون البعث ويعبدون الاصنام والروم اهل كتاب وفرح المشركون بذلك وقالوا انتم والنصاري اهل كتاب ونحن وفارس اميون وقد ظهر اخواننا من فارس علي اخوانكم من الروم فان قاتلتمونا لنظهرن نحن عليكم فنزلت الم غلبت الروم في ادني الارض الي قوله في بضع سنين فخرج بها ابو بكر الي المشركين وقال لتظهرن الروم علي فارس بعد بضع سنين فقال ابي بن خلف كذبت فتراهنا علي عشر قلاءص من كل واحد منهما وجعلا الاجل ثلاث سنين فاخبر ابو بكر رسول الله (صلي الله عليه وسلم) بذلك فقال زد في الخطر وابعد في الاجل فجعلا ماءة قلوص الي تسع سنين فلما خشي ابي ان يخرج ابو بكر من مكة اتاه فلزمه وقال اني اخاف ان تخرج من مكة فاقم لي كفيلا فكفل له ابنه عبد الرحمن بن ابي بكر فلما اراد ابي ان يخرج الي احد اتاه عبد الرحمن بن ابي بكر فلزمه قال لا والله لا ادعك تخرج حتي تعطيني كفيلا فاعطاه كفيلا ثم خرج الي احد فقتل بيد رسول الله (صلي الله عليه وسلم) اي مات من جرح جرحه رسول الله (صلي الله عليه وسلم) له في احد وغلبت الروم علي فارس يوم الحديبية فاخذ ابو بكر مال الخطر من كفيل ابي وورثته وجاء به الي رسول الله (صلي الله عليه وسلم) فقال تصدق به وكان ذلك قبل تحريم القمار* وهذه اية بينة علي صحة نبوته (صلي الله عليه وسلم) وعلي ان القران من عند الله تعالي لانها نبا عن الغيب كذا ذكره في المنتقي*

  انشقاق القمر

 وفي السنة التاسعة من المبعث كان انشقاق القمر* في المواهب اللدنية ان انشقاق القمر كان بمكة قبل الهجرة بنحو خمس سنين قال العلامة ابن السبكي في شرحه لمختصر ابن الحاجب الصحيح عندي ان انشقاق القمر متواتر منصوص عليه في القران مروي في الصحيحين وغيرهما من طرق حديث شعبة بن سليمان عن ابراهيم عن ابي معمر عن ابن مسعود ثم قال وله طرق اخر شتي بحيث لا يمتري في تواتره انتهي وجاءت احاديث انشقاق القمر في روايات صحيحة من جماعة من الصحابة منهم ابن مسعود وعلي وحذيفة بن جبير بن مطعم وابن عمر وانس وابن عباس وغيرهم* وفي الصحيحين من حديث انس ان اهل مكة سالوا رسول الله (صلي الله عليه وسلم) ان يريهم اية فاراهم انشقاق القمر شقتين حتي راوا حراء بينهما قوله شقتين بكسر الشين المعجمة اي نصفين وانس وان لم يشاهد القصة لانه اذ ذاك كان ابن اربع سنين او خمس بالمدينة لكن يجوز ان يكون حمل الحديث عمن شاهدها* ومن حديث ابن مسعود قال انشق القمر علي عهد رسول الله (صلي الله عليه وسلم) فرقتين فرقة فوق الجبل وفرقة دونه فقال رسول الله (صلي الله عليه وسلم) اشهدوا* وفي رواية الترمذي من حديث ابن عمر



 في قوله تعالي اقتربت الساعة وانشق القمر قال قد كان ذلك علي عهد رسول الله (صلي الله عليه وسلم) انشق فلقتين فلقة دون الجبل وفلقة خلف الجبل فقال رسول الله (صلي الله عليه وسلم) اشهدوا* وقال مجاهد انشق القمر فبقيت فرقة وذهبت فرقة من وراء الجبل* وقال ابن زيد لما انشق القمر كان يري نصفه علي فعيفعان والنصف الاخر علي ابي قبيس كذا في دلاءل النبوة وعند الامام احمد من حديث جبير بن مطعم فصار فرقتين فرقة علي هذا الجبل وفرقة علي هذا الجبل فقالوا سحرنا محمدا فقالوا ان كان سحرنا فانه لا يستطيع ان يسحر الناس* وعن عبد الله بن مسعود انه قال فقال كفار قريش هذا سحر ابن ابي كبشة قال فقالوا انظروا ما ياتيكم به السفار فان محمدا لا يستطيع ان يسحر الناس كلهم قال فجاء السفار فاخبروهم بذلك رواه ابو داود والطيالسي ورواه البيهقي بلفظ انشق القمر بمكة فقالوا اسحركم ابن ابي كبشة فسالوا السفار وقد قدموا من كل وجه فقالوا رايناه وعند ابي نعيم عن ابن عباس قال لما اجتمع المشركون الي رسول الله (صلي الله عليه وسلم) منهم الوليد بن المغيرة وابو جهل ابن هشام والعاص بن واءل والاسود بن المطلب والنضر بن الحارث ونظراءهم فقالوا للنبي (صلي الله عليه وسلم) ان كنت صادقا فشق لنا القمر فرقتين فسال ربه فانشق* وعند البخاري مختصرا من حديث ابن عباس بلفظ ان القمر انشق علي عهد رسول الله (صلي الله عليه وسلم) وابن عباس وان لم يشاهد القصة لانه لم يولد اذ ذاك ففي بعض طرقه انه حمل الحديث عن ابن مسعود وعند مسلم من حديث شعبة عن قتادة بلفظ فاراهم انشقاق القمر مرتين وكذا في مصنف عبد الرزاق عن معمر بلفظ مرتين واتفق الشيخان عليه من رواية شعبة عن قتادة بلفظ فرقتين كما في حديث جبير عند احمد وفي حديث ابن عمر فلقتين باللام كما مر وفي لفظ في حديث جبير فانشق باثنتين* وفي رواية عن ابن عباس عند ابي نعيم في الدلاءل فصار قمرين ووقع في نظم السيرة للحافظ ابي الفضل العراقي وانشق مرتين بالاجماع* قال الحافظ ابن حجر واظن قوله بالاجماع يتعلق بالشق لا بمرتين فاني لا اعلم من جزم من علماء الحديث بتعدد الانشقاق في زمنه (صلي الله عليه وسلم) ولعل قاءل مرتين اراد فرقتين وقد وقع في رواية البخاري من حديث ابن مسعود ونحن بمني وهذا لا يعارض قول انس ان ذلك كان بمكة لانه لم يصرح بانه (عليه السلام) كان ليلتءذ بمكة فالمراد ان الانشقاق كان وهم بمكة قبل ان يهاجروا الي المدينة هذا ما وقع في المواهب اللدنية* وفي شواهد النبوة انشق القمر بحيث كانت فلقة منه علي ابي قبيس وفلقة علي الجبل الاخر* وفي المواهب اللدنية وما يذكره بعض القصاص ان القمر دخل في جيب النبي (صلي الله عليه وسلم) وخرج من كمه فليس له اصل كما حكاه الشيخ بدر الدين الزركشي عن شيخه العماد بن كثير*

  وفاة ابي طالب

 وفي السنة العاشرة من النبوة اول ذي القعدة وقيل للنصف من شوال السنة الثامنة كذا في الاستيعاب مات ابو طالب بعد ما خرج من الحصار بالشعب بثمانية اشهر واحد وعشرين يوما كذا في سيرة اليعمري* وفي حياة الحيوان مات ابو طالب وكان النبي (صلي الله عليه وسلم) ابن تسع واربعين سنة وثمانية اشهر واحد عشر يوما وابو طالب ابن بضع وثمانين سنة* وفي المواهب اللدنية ابن سبع وثمانين سنة وقيل مات في نصف شوال من السنة العاشرة* وقال ابن الجوزي قبل هجرته (عليه السلام) بثلاث سنين انتهي* وروي عن سعيد بن المسيب عن ابيه انه قال لما حضر ابا طالب الوفاة جاءه رسول الله (صلي الله عليه وسلم) فوحد عنده عبد الله بن امية وابا جهل بن هشام فقال يا عم قل لا اله الا الله كلمة اشهد لك بها عند الله فقال له ابو جهل يا ابا طالب اترغب عن ملة عبد المطلب فلم يزل رسول الله (صلي الله عليه وسلم) يعرضها عليه ويقول يا عم قل لا اله الا الله اشهد لك بها عند الله ويقولان له يا ابا طالب اترغب عن ملة عبد المطلب حتي كان اخر



 كلمة تكلم بها ابو طالب انا اموت علي ملة عبد المطلب ثم مات* وفي المواهب اللدنية روي انه (عليه السلام) كان يقول له عند موته يا عم قل لا اله الا الله كلمة استحل لك بها الشفاعة يوم القيامة فلما راي ابو طالب حرص رسول الله (صلي الله عليه وسلم) قال له يا ابن اخي والله لو لا مخافة قريش يقولون اني انما قلتها جزعا من الموت لقلتها لا اقولها الا لاسرك بها فلما تقارب من ابي طالب الموت نظر العباس اليه يحرك شفتيه فاصغي اليه باذنه فقال يا ابن اخي والله لقد قال اخي الكلمة التي امرته بها فقال (صلي الله عليه وسلم) اني لم اسمعه قال ولم يكن العباس حينءذ مسلما كذا في رواية ابن اسحاق انه اسلم عند الموت ورواه البيهقي في الدلاءل من طريق يونس بن بكير عن ابن اسحاق وقال البيهقي انه منقطع والصحيح من الحديث قد اثبت لابي طالب الوفاة علي الكفر والشرك كما رويناه في صحيح البخاري من حديث سعيد بن المسيب حتي قال ابو طالب اخر ما كلمهم علي ملة عبد المطلب وابي ان يقول لا اله الا الله قال رسول الله (صلي الله عليه وسلم) لاستغفرن لك ما لم انه عنه فانزل الله تعالي ما كان للنبي والذين امنوا ان يستغفروا للمشركين ولو كانوا اولي قربي وانزل الله في ابي طالب فقال لرسول الله (صلي الله عليه وسلم) انك لا تهدي من احببت ولكن الله يهدي من يشاء* واجيب ايضا بان ابا طالب لو قال كلمة التوحيد لما نهي الله نبيه عن الاستغفار له* وفي انوار التنزيل الجمهور علي ان قوله تعالي انك لا تهدي من احببت ولكن الله يهدي من يشاء نزلت في ابي طالب فانه لما احتضر جاءه رسول الله (صلي الله عليه وسلم) وقال يا عم قل لا اله الا الله كلمة احجاج لك بها عند الله قال يا ابن اخي لقد علمت انك لصادق ولكن اكره ان يقال جزع عند الموت فقال رسول الله (صلي الله عليه وسلم) لاستغفرن لك ما لم انه عنه فاستغفر له بعد موته حتي نزلت ما كان للنبي والذين امنوا ان يستغفروا للمشركين ولو كانوا اولي قربي من بعد ما تبين لهم انهم اصحاب الجحيم وقيل اراد ان يستغفر لامه فنهي عن ذلك كذا في العمدة* وفي المواهب اللدنية وفي الصحيح عن ابن عباس انه قال لرسول الله (صلي الله عليه وسلم) ان ابا طالب كان يحوطك وينصرك فهل نفعه ذلك قال نعم وجدته في غمرات من النار فاخرجته الي ضحضاح وفي رواية يونس عن ابن اسحاق زيادة قال يغلي منها دماغه حتي يسيل علي قدميه انتهي* وعن ابي سعيد الخدري ان رسول الله (صلي الله عليه وسلم) ذكر عنده عمه ابو طالب فقال لعله تنفعه شفاعتي يوم القيامة فيجعل في ضحضاح يبلغ كعبه ويغلي منه دماغه* وعن ابن عباس ان رسول الله (صلي الله عليه وسلم) قال اهون اهل النار عذابا ابو طالب وهو منتعل بنعلين يغلي منهما دماغه* روي الاحاديث الثلاثة مسلم وروي البخاري ايضا حديث الضحضاح ولفظه ما اغنيت عن عمك فانه كان يحوطك ويغضب لك قال نعم هو في ضحضاح من النار ولو لا انا لكان في الدرك الاسفل من النار قيل ان النبي (صلي الله عليه وسلم) مسح ابا طالب بعد موته وانسي تحت قدميه ولذا ينتعل بنعلين من النار

  وصية ابي طالب

 وفي المواهب اللدنية* حكي عن هشام بن الساءب الكلبي او ابنه انه قال لما حضر ابا طالب الوفاة جمع اليه وجوه قريش فاوصاهم فقال يا معشر قريش انتم صفوة الله من خلقه الي ان قال واني اوصيكم بمحمد خيرا فانه الامين في قريش والصديق في العرب وهو الجامع لكل ما اوصيكم به وقد جاء بامر قبله الجنان وانكره اللسان مخافة الشنان وايم الله كاني انظر الي صعاليك العرب واهل الوبر والاطراف والمستضعفين من الناس قد اجابوا دعوته وصدقوا كلمته واعظموا امره فخاض بهم غمرات الموت وصارت رءساء قريش وصناديدها اذنابا ودورها خرابا وضعفاءها اربابا وان اعظمهم عليه احوجهم اليه وابعدهم منه احظاهم عنده قد محضته العرب ودادها واصفت له فءادها واعطته قيادها يا معشر قريش كونوا له ولاة ولحزبه حماة والله لا يسلك احد سبيله الارشد



 ولا ياخذ احد بهديه الا سعد ولو كان لنفسي مدة ولا جلي تاخر لكففت عنه الهزاهز ولدفعت عنه الدواهي ثم هلك* وروي عن علي انه قال لما مات ابو طالب اخبرت رسول الله (صلي الله عليه وسلم) بموته فبكي ثم قال اذهب فاغسله وكفنه وواره غفر الله له ورحمه ففعلت وجعل رسول الله (صلي الله عليه وسلم) يستغفر له اياما ولا يخرج من بيته حتي نزل جبريل بهذه الاية ما كان للنبي والذين امنوا الاية وقال علي فامرني رسول الله (صلي الله عليه وسلم) فاغتسلت وكان علي اذا غسل الميت اغتسل* قال ابن عباس عارض رسول الله (صلي الله عليه وسلم) جنازة ابي طالب وقال وصلتك رحم وجزاك الله خيرا يا عم* وفي معالم التنزيل الكفر علي اربعة انواع كفر الانكار وكفر الجحود وكفر النفاق وكفر العناد اما كفر الانكار فهو ان لا يعرف الله بالقلب ولا يعترف باللسان واما كفر الجحود فهو ان يعرف الله بقلبه ولكن لا يقر بلسانه ككفر ابليس وكفر اليهود بمحمد (صلي الله عليه وسلم) من هذا القبيل قال الله تعالي فلما جاءهم ما عرفوا كفروا به اي جحودا واما كفر النفاق فهو ان يقر باللسان ولم يعتقد بالقلب واما كفر العناد فهو ان يعرف الله بقلبه ويعترف بلسانه ولكن لا يدين به ولا يكون منقادا ومطيعا له ككفر ابي طالب فانه قال

 ولقد علمت بان دين محمد ~ من خير اديان البرية دينا

 لو لا الملامة او حذار مسبة ~ لوجدتني سمحا بذاك مبينا

 ودعوتني وعرفت انك ناصحي ~ ولقد صدقت وكنت فيه امينا

 وجميع الانواع الاربعة المذكورة سواء في ان الله تبارك وتعالي لا يغفر لاصحابها اذا ماتوا عليها نعوذ بالله منها*

  وفاة خديجة الكبري

 وفي هذه السنة العاشرة من النبوة كانت وفاة خديجة الكبري رضي الله عنها* روي ان خديجة لما مرضت مرض الموت دخل عليها رسول الله (صلي الله عليه وسلم) فقال لها يا خديجة اما علمت ان الله قد زوجني معك في الجنة مريم بنت عمران وكلثوم اخت موسي واسية امراة فرعون قالت فعل ذلك يا رسول الله قال نعم قالت بالرفاء والبنين* قال ابو حاتم وابو عمرو والدولابي ماتت خديجة بمكة قبل هجرة المصطفي الي المدينة بثلاث سنين* وفي سيرة مغلطاي بخمس سنين وقيل باربع وقيل بعد الاسراء فكان (عليه السلام) يسمي ذلك العام عام الحزن انتهي وحكي ابو عمرو ان خديجة توفيت في شهر رمضان ودفنت بالحجون وهي ابنة خمس وستين سنة وستة اشهر كذا في الصفوة* وقال الطبري في السمط الثمين وهي ابنة اربع وستين سنة وستة اشهر وللنبي (صلي الله عليه وسلم) عند وفاتها تسع واربعون سنة وثمانية اشهر واربعة عشر يوما* وقال صاحب الصفوة ونزل (صلي الله عليه وسلم) في حفرتها ولم يكن يومءذ سنة الجنازة الصلاة عليها* قال ابن اسحاق هلكت خديجة وابو طالب في عام واحد وكان هلاكهما بعد عشر سنين مضت من مبعث النبي (صلي الله عليه وسلم)* وعن عروة ابن الزبير قال توفيت خديجة قبل ان تفرض الصلاة وذكر الملا في سيرته ان موت خديجة بعد موت ابي طالب بثلاثة ايام وكذا في سيرة اليعمري وحياة الحيوان والسمط الثمين واسد الغابة وزاد فيه وقيل بعده بشهر وقيل كان بينهما شهر وخمسة ايام وقيل خمسون يوما وقيل انها ماتت قبل ابي طالب انتهي ما في اسد الغابة وقيل بخمسة اشهر في رمضان بعد المبعث بعشر سنين علي الصحيح ماتت خديجة وكانت مدة اقامتها معه (صلي الله عليه وسلم) بعد ما تزوجها خمسا وعشرين سنة علي الصحيح كذا في المواهب اللدنية او قيل اربعا وعشرين سنة وستة اشهر وكان موتها قبل الهجرة بثلاث سنين وثلاثة اشهر ونصف وقيل قبل الهجرة بسنة والله اعلم* وقال عروة ما ماتت خديجة الا بعد الاسراء وبعد ان صلت الفريصة مع رسول الله (صلي الله عليه وسلم) كذا في اسد الغابة* وفي كتاب الغزي توفيت خديجة في دارها التي



 تسمي دار خزيمة وكانت مسكن رسول الله (صلي الله عليه وسلم) وفيها ولدت خديجة اولادها من رسول الله (صلي الله عليه وسلم) ولم يزل النبي (صلي الله عليه وسلم) مقيما فيها حتي هاجر فاخذها عقيل ثم اشتراها معاوية وهو خليفة فجعلها مسجدا يصلي فيه ويعرف اليوم بمولد فاطمة وهو افضل موضع بمكة بعد المسجد الحرام* ثم بعد ايام من موت خديجة تزوجه (عليه السلام) بسودة كذا في المواهب اللدنية روي عن عبد الله بن ثعلبة قال لما توفي ابو طالب وخديجة وكان بينهما ثلاثة ايام كما مر وهو المشهور وقيل شهر وخمسة ايام اجتمعت علي رسول الله (صلي الله عليه وسلم) مصيبتان فلزم بيته وقل الخروج ونالت قريش منه ما لم تسكن تنال فبلغ ذلك ابا لهب فجاءه فقال يا محمد امض لما اردت واصنع ما كنت صانعا حين كان ابو طالب حيا فقام ابو لهب بحمايته ومعونته ولم يتعرض له احد من خوف ابي لهب حتي جاء عقبة بن ابي معيط وابو جهل الي ابي لهب فقالا له اخبرك ابن اخيك اين مدخل ابيك فقال له ابو لهب يا محمد اين مدخل عبد المطلب قال مع قومه فخرج ابو لهب اليهما فقال سالته فقال مع قومه فقالا يزعم انه في النار فقال ابو لهب يا محمد ايدخل عبد المطلب النار فقال نعم ومن مات علي مثل ما مات عليه عبد المطلب دخل النار فقال ابو لهب يا محمد والله لا برحت لك عدوا ابدا وانت تزعم ان عبد المطلب في النار فاشتد عليه ابو لهب وساءر قريش لما عرفوا وظاهر قوله فقام ابو لهب بحمايته ومعاونته يخالف ما مر في السنة الرابعة من النبوة من قوله تبا لك الهذا دعوتنا الي اخره*

  خروجه (عليه السلام) الي الطاءف والي ثقيف

 وفي هذه السنة خرج رسول الله (صلي الله عليه وسلم) الي الطاءف والي ثقيف بعد ثلاثة اشهر من موت خديجة في ليال يستنصرهم* وفي رواية لثلاث بقين من شوال سنة عشر من النبوة لما ناله من قريش بعد موت ابي طالب وخديجة وهو مكروب فلا جرم جعل الله الطاءف متنفسا لاهل الاسلام ممن ضاق بمكة الي يوم القيامة فهي راحة الامة ومتنفس كل ذي ضيق وغمة سنة الله في الذين خلوا من قبل ولن تجد لسنة الله تبديلا* وروي عن محمد بن جبير بن مطعم قال لما توفي ابو طالب بالغت قريش في ايذاء رسول الله (صلي الله عليه وسلم) فخرج رسول الله (صلي الله عليه وسلم) حينءذ الي الطاءف ومعه زيد بن حارثة وفي معالم التنزيل خرج وحده وذلك في ليال بقين من شوال السنة العاشرة من النبوة فاقام بالطاءف شهرا كذا في حياة الحيوان* وقال ابن سعد عشرة ايام كذا في المواهب اللدنية لا يدع احدا من اشراف ثقيف الا جاءه وكلمه ودعاه الي الله فلم يجيبوه الي طلبته وقالوا يا محمدا خرج من بلدنا والحق بمحابك من الارض قال محمد بن كعب القرظي لما انتهي رسول الله (صلي الله عليه وسلم) الي الطاءف عمد الي نفر من ثقيف هم يومءذ سادة ثقيف واشرافهم وهم اخوة ثلاثة عبد يا ليل بمثناة تحتية بعدها الف ثم لام مكسورة ثم مثناة تحتية ساكنة ثم لام ومسعود وحبيب بنو عمرو بن عمير كذا في المنتقي وفي المواهب اللدنية غير هذا وعند احدهم امراة من قريش من بني جمح فجلس اليهم فدعاهم الي الله عز وجل وكلمهم بما جاءهم به من نصرته علي الاسلام والقيام معه علي من خالفه من قومه فقال احدهم هو يمرط ثياب الكعبة ان كان الله ارسلك وقال الاخر اما وجد الله احدا يرسله غيرك وقال الثالث والله لا اكلمك كلمة ابدا لءن كنت رسولا من الله كما تقول لانت اعظم خطرا من ان اردد عليك الكلام وان كنت تكذب ما ينبغي لي ان اكلمك فقام رسول الله (صلي الله عليه وسلم) من عندهم وقد يءس من حير ثقيف فقال لهم اذ فعلتم ما فعلتم فاكتموا علي وكره رسول الله (صلي الله عليه وسلم) ان يبلغ قومه ذلك فلم يفعلوا واغروا به سفهاءهم وعبيدهم يسبونه ويصيحون به حتي اجتمع الناس عليه فجعلوا يرمونه بالحجارة حتي ان رجليه لتدميان* وفي المواهب اللدنية قال موسي بن عقبة رجموا عراقيبه بالحجارة حتي اختضبت نعلاه بالدماء وزاد غيره وكان اذا اذلقته الحجارة قعد الي الارض



 فياخذونه بعضديه فيقيمونه فاذا مشي رجموه وهم يضحكون وزيد بن حارثة يقيه بنفسه حتي لقد شج في راسه شجاجا والجءوا النبي (صلي الله عليه وسلم) الي حاءط لعتبة وشيبة ابني ربيعة ورجع عنه من كان يتبعه من سفهاء ثقيف وعمد النبي (صلي الله عليه وسلم) الي ظل شجرة فجلس فيه محزونا وابنا ربيعة كانا في الحاءط ينظران اليه فلما رايا ما لقيه من سفهاء ثقيف تحركت له رحمهما فدعوا غلاما لهما نصرانيا يقال له عداس فقالا له خذ قطفا من هذا العنب وضعه في ذلك الطبق ثم اذهب به الي ذلك الرجل وقل له ياكل منه ففعل عداس ثم اقبل به حتي وضعه بين يدي رسول الله (صلي الله عليه وسلم) فلما وضع رسول الله (صلي الله عليه وسلم) يده قال بسم الله الرحمن الرحيم ثم اكل فنظر عداس الي وجهه ثم قال ان هذا الكلام ما يقوله اهل هذا البلد فقال رسول الله (صلي الله عليه وسلم) ومن اي البلاد انت وما دينك قال انا نصراني وانا رجل من اهل نينوي فقال رسول الله (صلي الله عليه وسلم) امن قرية الرجل الصالح يونس بن متي قال وما يدريك ما يونس بن متي قال ذلك اخي كان نبيا وانا نبي فاكب عداس علي رسول الله (صلي الله عليه وسلم) يقبل راسه ويديه وقدميه واسلم وينظر اليه ابنا ربيعة فيقول احدهما للاخر اما غلامك فقد افسده عليك فلما جاءهما عداس قالا له ويلك يا عداس مالك تقبل راس هذا الرجل ويديه وقدميه قال يا سيدي ما في الارض خير من هذا الرجل لقد اخبرني بامر لا يعلمه الا نبي ثم انصرف رسول الله (صلي الله عليه وسلم) من الطاءف حين يءس من خير ثقيف*

  ذكر وفود الجن

 ولما نزل نخلة وهو موضع علي ليلة من مكة صرف اليه سبعة من جن نصيبين مدينة بالشام وقد قام في جوف الليل يصلي وفي الصحيح ان الذي اذنه (صلي الله عليه وسلم) بالجن ليلة الجن شجرة كذا في المواهب اللدنية واقام بنخلة اياما ثم دخل مكة في جوار مطعم بن عدي* وفي اسد الغابة ولما عاد من الطاءف ارسل الي مطعم بن عدي يطلب منه ان يجيره فاجاره فدخل المسجد معه وكان رسول الله (صلي الله عليه وسلم) يشكرها له وكان دخوله من الطاءف لثلاث وعشرين ليلة خلت من ذي القعدة* وفي هذه السنة جاءت وفود الجن الي رسول الله (صلي الله عليه وسلم)* في حياة الحيوان لما بلغ عمره خمسين سنة وفي سيرة اليعمري خمسين سنة وثلاثة اشهر قدم عليه جن نصيبين فاسلموا* وفي الاستيعاب كان رجوعه من الطاءف الي مكة سنة احدي وخمسين من الفيل وفيها قدم عليه جن نصيبين بعد ثلاثة اشهر* وعن ابن عباس قال انطلق رسول الله (صلي الله عليه وسلم) في طاءفة من اصحابه عامدين سوق عكاظ وقد حيل بين الشياطين وبين خبر السماء وارسلت عليهم الشهب فرجعت الشياطين الي قومهم فقالوا ما لكم قالوا حيل بيننا وبين خبر السماء وارسلت علينا الشهب قالوا ما حال بينكم وبين خبر السماء الا شء حدث فاضربوا مشارق الارض ومغاربها فانظروا ما هذا الذي حال بينكم وبين خبر السماء فنهض سبعة نفر من اشراف جن نصيبين او نينوي منهم زوبعة امير الجن فضربوا حتي بلغوا تهامة ثم اندفعوا الي وادي نخلة فوافوا رسول الله (صلي الله عليه وسلم) وهو يصلي باصحابه صلاة الفجر* وفي المدارك وهو قاءم في جوف الليل يصلي او في صلاة الفجر* وفي انوار التنزيل روي انهم وافوا رسول الله (صلي الله عليه وسلم) بوادي نخلة وهو موضع علي ليلة من مكة عند منصرفه من الطاءف يقرا في تهجده انتهي* فلما سمعوا القران استمعوا له وهو يقرا سورة الجن كذا في سيرة مغلطاي فاولءك حين رجعوا الي قومهم قالوا انا سمعنا قرانا عجبا يهدي الي الرشد فامنا به ولن نشرك بربنا احدا وانزل الله علي نبيه قل اوحي الي انه استمع نفر من الجن كذا في الصحيحين* وفي المواهب اللدنية قال الحافظ ابن كثير هذا صحيح لكن قوله ان الجن كان استماعهم تلك الليلة فيه نظر فان الجن كان استماعهم في ابتداء الايحاء* وفي انوار التنزيل في سورة الاحقاف في قوله تعالي قالوا يا قومنا انا سمعنا كتابا انزل من بعد موسي قيل انما قالوا ذلك



 لانهم كانوا يهودا وما سمعوا بامر عيسي وعن عاءشة انها سمعت رسول الله (صلي الله عليه وسلم) يقول ان الملاءكة تنزل في العنان وهو السحاب فتذكر الامر قضي في السماء فتسترق الشياطين السمع فتوحيه الي الكفار فيكذبون معها ماءة كذبة من عند انفسهم رواه البخاري* وعن ابن عباس قال كان الجن يستمعون الوحي فيسمعون الكلمة فيزيدون فيها عشرا فيكون ما سمعوه حقا وما زادوه باطلا كذا قاله احمد وكانت النجوم لا يرمي بها قبل ذلك فلما بعث النبي (صلي الله عليه وسلم) كان احدهم لا يقعد مقعدا الا رمي بشهاب يحرق ما اصاب فشكوا ذلك الي ابليس فقال ما هذا الامن امر حدث فبعث جنوده فاذا هم بالنبي (صلي الله عليه وسلم) يصلي بين جبلي نخلة فاتوه فاخبروه فقال ما هذا الحدث الذي حدث في الارض كذا في الصفوة* وفي معالم التنزيل روي انهم لما رجموا بالشهب بعث ابليس سراياه ليعرف الخبر فكان اول بعث بعث ركب من اهل نصيبين وهم اشراف الجن وسادتهم وبعث الي تهامة يقال انهم كانوا من بني الشيصبان وهم اكثر الجن عددا وهم عامة جنود ابليس فلما رجعوا قالوا انا سمعنا قرانا عجبا* واختلفوا في عدد اولءك النفر فقال ابن عباس كانوا سبعة من جن نصيبين فجعلهم رسول الله (صلي الله عليه وسلم) رسلا الي قومهم* وفي العمدة ثلاثة من اهل نجران واربعة من اهل نصيبين وقال قوم كانوا تسعة وكان زوبعة من التسعة الذين استمعوا القران وفي العمدة ايضا وهم تسعة من جن نصيبين استمعوا القران واجابوا دعوة النبي (صلي الله عليه وسلم) واسماءهم حسا وبسا وشاصرا وناصرا وازد وانين واحتب وصخب وزوبعة* وفي الصفوة وهذا الحديث اي حديث رجم الشياطين بالشهب يدل علي ان النجوم ولم يرم بها الا لمبعث نبينا (صلي الله عليه وسلم) وقد روي الزهري انه كان يرمي بها قبل ذلك ولكنها غلظت حين بعث النبي (صلي الله عليه وسلم) وقد مر مثله في هذا الركن الثاني في مبعثه (صلي الله عليه وسلم)* وفي المدارك عن سعيد ابن جبير ما قرا رسول الله (صلي الله عليه وسلم) علي الجن ولا راهم وانما كان يتلو في صلاته فمروا به فوقفوا مستمعين وهو لا يشعر فانباه الله باستماعهم وقيل بل امر الله رسوله ان ينذرهم ويقرا عليهم فصرف اليه نفرا منهم وقال اني امرت ان اقرا علي الجن وكان ذلك بمكة بشعب الحجون الي اخر الحديث المروي عن عبد الله بن مسعود كما سيجء الان* وفي المنتقي قال العلماء ان الجن اتوا النبي (صلي الله عليه وسلم) مرتين احداهما بنخلة كما مر انفا والثانية بمكة وهي ما روي ان رسول الله (صلي الله عليه وسلم) امر ان ينذر الجن ويدعوهم الي الله ويقرا عليهم القران فصرف الله اليه نفرا من الجن من نينوي وجمعوهم له فقال رسول الله (صلي الله عليه وسلم) اني امرت ان اقرا علي الجن الليلة فايكم يتبعني قالها ثلاثا فالصحابة اطرقوا فاتبعه عبد الله بن مسعود وقال عبد الله ولم يحضر معنا احد فانطلقنا حتي اذا كنا باعلا مكة دخل النبي (صلي الله عليه وسلم) شعبا يقال له شعب الحجون وخط لي خطا وقال لي لا تخرج عنه حتي اعود اليك ثم انطلق حتي قام فافتتح القران فجعلت اري مثل النسور تهوي وسمعت لغطا شديدا حتي خفت علي رسول الله (صلي الله عليه وسلم) وغشيته اسودة كثيرة حالت بيني وبينه حتي ما اسمع صوته ثم طفقوا يتقطعون كقطع السحاب ذاهبين ففرغ رسول الله (صلي الله عليه وسلم) مع الفجر ثم انطلق الي وقال انمت قلت لا يا رسول الله ولقد هممت مرارا ان استغيث بالناس حين سمعتك تقرع بعصاك تقول اجلسوا قال ولو خرجت لم امن عليك ان يختطفك بعضهم ثم قال هل رايت شيءا قلت نعم رايت رجالا سودا مستثفري ثياب بيض فقال اولءك جن نصيبين* وفي المدارك كانوا اثني عشر الفا والسورة التي قراها عليهم اقرا باسم ربك انتهي قال (صلي الله عليه وسلم) سالوني المتاع والمتاع الزاد فمتعتهم بكل عظم حاءل وورثة وبعرة فقالوا يا رسول الله يقذرها الناس فنهي صلي الله عليه



 وسلم ان يستنجي بالعظم والروث قال فقلت يا رسول الله وما يغني ذلك عنهم قال انهم لا يجدون عظما الا وجدوا عليه لحمه يوم اكل ولا روثة الا وجدوا فيها حبها يوم اكلت فقلت يا رسول الله سمعت لغطا شديدا قال ان الجن تدارات في قتيل قتل بينهم فتحاكموا الي فقضيت بينهم بالحق ثم تبرز رسول الله (صلي الله عليه وسلم) ثم اتاني فقال هل معك ماء فقلت يا رسول الله ليس معي الا اداوة فيها شء من نبيذ التمر فاستدعاه فصببت علي يده فتوضا فقال تمرة طيبة وماء طهور كذا في المنتقي وفي كتاب الغزي باعلا مكة مسجد يقال له مسجد الجن ومسجد البيعة ايضا يقال ان الجن بايعوا رسول الله (صلي الله عليه وسلم) هناك وفي مقابل مسجد الجن مسجد يقال له مسجد الشجرة يقال ان النبي (صلي الله عليه وسلم) دعا شجرة كانت في ذلك المسجد فاقبلت تخط الارض حتي وقفت بين يديه ثم امرها فرجعت

  * تزوجه (صلي الله عليه وسلم) سودة وعاءشة

 وفي شوال هذه السنة تزوج رسول الله (صلي الله عليه وسلم) سودة وعاءشة في اسد الغابة لابن الاثير تزوج (صلي الله عليه وسلم) بعد خديجة سودة بنت زمعة قال الزهري تزوجها قبل عاءشة وهو بمكة وبني بها بمكة ايضا وقال غيره تزوج عاءشة قبل سودة وانما ابتني بسودة قبل عاءشة لصغر عاءشة وتزوج عاءشة بمكة وبني بها بالمدينة سنة اثنتين* وفي المواهب اللدنية تزوج سودة بمكة بعد موت خديجة قبل ان يعقد علي عاءشة هذا قول قتادة وابي عبيدة ولم يذكر ابن قتيبة غيره ويقال تزوجها بعد عاءشة ويجمع بين القولين بانه (صلي الله عليه وسلم) عقد علي عاءشة قبل سودة ودخل بسودة قبل عاءشة والتزويج يطلق علي كل واحد من العقد والدخول وان كان المتبادر الي الفهم من التزويج العقد دون الدخول وفي سيرة اليعمري تزوج عاءشة بمكة قبل الهجرة بسنتين وقيل بثلاث وهي بنت ست او سبع وللبخاري توفيت خديجة قبل مخرج النبي (صلي الله عليه وسلم) بثلاث سنين فلبث سنتين او قريبا من ذلك ونكح عاءشة وهي بنت ست ثم بني بها وهي بنت تسع سنين روي انه لما ماتت خديجة جاءت خولة بنت حكيم امراة عثمان بن مظعون فقالت يا رسول الله الا تزوج قال من قالت ان شءت بكرا وان شءت ثيبا قال فمن البكر قالت ابنة احب خلق الله اليك بنت ابي بكر قال ومن الثيب قالت سودة بنت زمعة قد امنت بك واتبعتك علي ما تقول قال فاذهبي فاذكريهما علي فدخلت بيت ابي بكر وقالت يا ام رومان ما ذا ادخل الله عليكم من الخير والبركة قالت وما ذاك قالت ارسلني رسول الله (صلي الله عليه وسلم) اخطب عليه عاءشة قالت انتظري ابا بكر حتي ياتي فجاء ابو بكر فقالت ما ذا ادخل الله عليكم من الخير والبركة قال وما ذاك قالت ارسلني رسول الله (صلي الله عليه وسلم) اخطب عليه عاءشة قال وهل تصلح له انما هي ابنة اخيه فرجعت الي رسول الله (صلي الله عليه وسلم) فذكرت له ذلك قال ارجعي اليه فقولي له انا اخوك وانت اخي في الاسلام وابنتك تصلح لي فرجعت فذكرت ذلك له فقال انتظري قالت ام رومان ان مطعم بن عدي قد كان ذكرها علي ابنه فو الله ما وعد وعدا قط فاخلفه قط تعني ابا بكر فدخل ابو بكر علي مطعم بن عدي وعنده امراته ام الفتي فقالت يا ابن ابي قحافة لعلك مصبء صاحبنا تدخله في دينك الذي انت عليه ان تزوج ابنه ابنتك فقال ابو بكر لمطعم بن عدي اقول هذه تقول قال انها تقول ذلك فخرج من عنده وقد اذهب الله ما كان في نفسه من عدته التي وعده فرجع فقال لخولة ادعي لي رسول الله (صلي الله عليه وسلم) فدعته فزوجها اياه وعاءشة يومءذ بنت ست سنين كما مر ثم خرجت خولة فدخلت علي سودة بنت زمعة فقالت ما ذا ادخل الله عليك من الخير والبركة قالت وما ذاك قالت ارسلني رسول الله (صلي الله عليه وسلم) اخطبك عليه قالت وددت ان يكون ذلك ادخلي علي ابي واذكري ذلك له وكان شيخا كبيرا وقد تخلف عن الحج فدخلت عليه فذكرت له ذلك قال كفء كريم فدعا رسول الله (صلي الله عليه وسلم) فزوجها اياه فجاء اخوها عبد الله بن زمعة من الحج فجعل



 يحثي في راسه التراب فقال بعد ان اسلم لعمري اني سفيه يوم احثي في راسي التراب ان تزوج رسول الله (صلي الله عليه وسلم) سودة بنت زمعة كذا في المنتقي* روي ان سودة بنت زمعة بن قيس بن عبد شمس كانت قد اسلمت بمكة في اواءل البعثة وكانت قبل النبي (صلي الله عليه وسلم) زوجة ابن عمها سكران بن عمرو بن عبد شمس وولدت له ابنا اسمه عبد الرحمن قتل في حرب جلولا وهو اسم قرية من قري فارس وتلك الحرب وقعت هناك وسكران عد من الصحابة وكانت سودة هاجرت مع زوجها سكران الي الحبشة وبعد مدة عادت الي مكة ورات في المنام ان النبي (صلي الله عليه وسلم) اتاها ووضع رجله علي رقبتها فلما انتبهت اخبرت زوجها قال ان صدقت فانا اموت ويتزوجك محمد ثم رات في المنام انها اتكات ووقع عليها القمر من السماء فاخبرت بها زوجها قال ان كنت صدقت فانا اموت قريبا وتتزوجين زوجا اخر فمرض في ذلك اليوم ومات بعد ايام ثم تزوجها النبي (صلي الله عليه وسلم) في السنة العاشرة من النبوة بعد وفاة خديجة مرويات سودة في الكتب المتداولة خمس احاديث واحد منها في البخاري والباقية مروية في السنن الاربع وتوفيت في اخر خلافة عمر وقيل في زمان معاوية والاول اشهر*

  ابتداء اسلام الانصار وبيعة العقبة الاولي

 وفي السنة الحادية عشر من النبوة كان ابتداء اسلام الانصار روي ان رسول الله (صلي الله عليه وسلم) كان يخرج ويتبع اثار الناس في منازلهم بعكاظ ومجنة وذي المجاز في الموسم ويقول من يءويني من ينصرني حتي ابلغ رسالة ربي فله الجنة وفي سيرة مغلطاي فلا يجد احدا ينصره ولا يجيبه حتي انه ليسال عن القباءل ومنازلها قبيلة قبيلة فيردونه اقبح رد ويءذونه ويقولون قومك اعلم بك وكان ممن سمي لنا من تلك القباءل بنو عامر بن صعصعة ومحارب بن حفصة وفزارة وغسان ومرة وحنيفة وسلم وعبس وبنو نضر والبكاء وكندة وكعب والحارث بن كعب وعذرة والحضارمة الي ان اراد الله اطهار دينه فساقه عليه الصلاة والسلام الي هذا الحي من الانصار وهو لقب اسلامي لنصرتهم النبي (صلي الله عليه وسلم) وانما كانوا يسمون اولاد قيلة والاوس والخزرج فاسلم اثنان اسعد بن زرارة وقيس بن ذكوان انتهي كلام مغلطاي فخرج في هذا الموسم يعرض نفسه علي القباءل كما كان يصنع في كل موسم فبينا هو عند العقبة اذ لقي جماعة من الخزرج فقال من انتم قالوا من الخزرج قال افلا تجلسون حتي اكملكم قالوا بلي فجلسوا معه فدعاهم الي الله عز وجل وعرض عليهم الاسلام وتلا عليهم القران وكان اولءك قد سمعوا من اليهود انه قد اظلنا زمان نبي يبعث* وفي المواهب اللدنية كان من صنع الله ان اليهود كانوا معهم في بلادهم وكانوا اهل كتاب وكان الاوس والخزرج اكثر منهم فكانوا اذا كان بينهم شء قالوا ان نبيا سيبعث الان قد اظل زمانه نتبعه فنقتلكم معه فلما كلمهم قال بعضهم لبعض والله انه النبي الذي يعدكم به اليهود فلا يسبقنكم اليه فاسلم منهم ستة نفر كلهم من الخزرج وهم ابو امامة اسعد بن زرارة وعوف بن الحارث بن رفاعة وهو ابن عفراء ورافع بن مالك بن العجلان وقطبة بن عامر بن حديدة وعقبة بن عامر بن نابي وجابر بن عبد الله بن ذءاب فقال لهم النبي (صلي الله عليه وسلم) تمنعون ظهري حتي ابلغ رسالة ربي فقالوا يا رسول الله انما كانت بعاث العام الاول يوم من ايامنا اقتتلنا به وان تقدم ونحن كذلك لا يكون لنا عليك اجتماع فدعنا حتي نرجع الي عشاءرنا لعل الله يصلح ذات بيننا وندعوهم الي ما دعوتنا وموعدنا وموعدك الموسم العام القابل وانصرفوا الي بلادهم ويسمي هذا ابتداء اسلام الانصار ومقتضي ما سنذكره بعد المعراج ان تسمي هذه بيعة العقبة الاولي كذا في الوفاء ولما قدموا المدينة علي قومهم ذكروا لهم رسول الله (صلي الله عليه وسلم) ودعوهم الي الاسلام حتي فشافيهم الاسلام فلم يبق دار من دور الانصار الا فيها ذكر رسول الله (صلي الله عليه وسلم)*

  ذكر قصة المعراج 

 وفي السنة الثانية عشر من النبوة وقع المعراج وما تضمنه وفرضت الصلوات الخمس في الاسراء وستجء كيفيتها وفي الاستيعاب



 وسيرة مغلطاي بعد سنة ونصف من حين رجوعه من الطاءف قاله ابن قتيبة* وقال ابن شهاب عن ابن المسيب قبل خروجه الي المدينة بسنة* وفي المواهب اللدنية لما كان في شهر ربيع الاول اسري بروحه وجسده يقظة من المسجد الحرام الي المسجد الاقصي ثم عرج به من المسجد الاقصي الي فوق سبع سماوات وراي ربه بعين راسه واوحي اليه ما اوحي وفرض عليه الصلوات الخمس ثم انصرف في ليلته الي مكة فاخبر بذلك فصدقه الصديق وكل من امن بالله وكذبه الكفار واستوصفوه مسجد بيت المقدس فمثله الله له فجعل ينظر اليه ويصفه وسيجء تفصيل ذلك كله* اختلف العلماء في الاسراء هل هو اسراء واحد في ليلة واحدة يقظة او مناما او اسراءان كل واحد في ليلة مرة بروحه وبدنه يقظة ومرة مناما او يقظة بروحه وجسده من المسجد الحرام الي المسجد الاقصي ثم مناما من المسجد الاقصي الي العرش او هي اربع اسراءات* وفي سيرة مغلطاي اختلف في المعراج والاسراء هل كانا في ليلة واحدة ام لا وهل كانا او احدهما يقظة او مناما وهل كان المعراج مرة او مرات والصحيح ان الاسراء كان في اليقظة بجسده وانه مرات متعددة وانه راي ربه بعين راسه (صلي الله عليه وسلم)* واختلف في تاريخ الاسراء في اي سنة كان وفي اي شهر وفي اي يوم من الشهر وفي اي ليلة من الاسبوع فاما سنة الاسراء فقال الزهري كان ذلك بعد المبعث بخمس سنين حكاه القاضي عياض ورجحه القرطبي والنووي وقيل قبل الهجرة بسنة قاله ابن حزم وادعي فيه الاجماع رواه ابن الاثير في اسد الغابة عن ابن عباس وانس وحكاه البغوي في معالم التنزيل عن مقاتل وقيل قبل الهجرة بسنة وخمسة اشهر قاله السدي واخرجه من طريق الطبري والبيهقي فعلي هذا يكون في شوال وفي اسد الغابة قال السدي قبل الهجرة بستة اشهر وقيل كان قبل الهجرة بسنة وثلاثة اشهر فعلي هذا يكون في ذي الحجة وبه جزم ابن فارس وقيل قبل الهجرة بثلاث سنين ذكره ابن الاثير كذا في المواهب اللدنية* واما شهر الاسراء فقيل ربيع الاول قاله ابن الاثير والنووي في شرح مسلم وقيل ربيع الاخر قاله الحربي والنووي في فتاويه وقيل رجب حكاه ابن عبد البر وقبله ابن قتيبة وبه جزم النووي في الروضة وعن الواقدي رمضان وعن السدي والماوردي شوال وعن ابن فارس ذو الحجة كما مر واما ان الاسراء في اي يوم من الشهر كان فعن ابن الاثير ليلة سبع من ربيع الاول وعن الحربي في ثالث عشري ربيع الاخر وقيل ليلة سبع وعشرين من ربيع الاخر وعن الواقدي في سابع عشر من رمضان واما ليلة الاسراء فقيل ليلة الجمعة وقيل ليلة السبت وعن ابن الاثير ليلة الاثنين وقال ابن دحية ان شاء الله يكون ليلة الاثنين ليوافق المولد والمبعث والمعراج والهجرة والوفاة فان هذه اطوار الانتقالات وجودا ونبوة ومعراجا وهجرة ووفاة كذا في المواهب اللدنية* وفي سيرة اليعمري ولما بلغ احدي وخمسين سنة وتسعة اشهر اسري به من بين زمزم والمقام وكذا في حياة الحيوان وانما كان ليلا لتظهر الخصوصية بين جليس الملك ليلا وجليسه نهارا واختلف في الموضع الذي اسري به منه (صلي الله عليه وسلم) فقيل اسري به من بيته وقيل من بيت ام هانء بنت ابي طالب لما روي انه (صلي الله عليه وسلم) كان ناءما في بيت ام هانء بعد صلاة العشاء فاسري به ورجع من ليلته وقص القصة عليها وقال مثل لي النبيون فصليت بهم وبيتها بين الصفا والمروة ومن قال هذين القولين قال الحرم كله مسجد والمراد بالمسجد الحرام في الاية الحرم وعن ابن عباس الحرم كله مسجد وقيل اسري به من المسجد الحرام والمراد بالمسجد في الاية هو المسجد نفسه وهو ظاهر فقد قال (صلي الله عليه وسلم) بينا انا في المسجد الحرام في الحجر عند البيت بين الناءم واليقظان اذ اتاني جبريل بالبراق وقد عرج بي الي السماء في تلك الليلة قيل الحكمة في المعراج ان الله تعالي اراد ان يشرف

 بانوار محمد (صلي الله عليه وسلم) السموات كما شرف ببركاته الارضين فسري به الي المعراج وسءل



 ابو العباس الدينوري لم اسري بالنبي (صلي الله عليه وسلم) الي البيت المقدس قبل ان عرج به الي السماء فقال لان الله تعالي كان يعلم ان كفار قريش كانوا يكذبونه فيما يخبرهم به من اخبار السموات فاراد ان يخبرهم من الارض قد بلغوها وعاينوها وعلموا ان النبي (صلي الله عليه وسلم) لم يدخل بيت المقدس قط فلما اخبرهم باخبار بيت المقدس علي ما هو عليه لم يمكنهم ان يكذبوه في اخبار السماء بعد ان صدقوه في اخبار الارض* واختلف السلف والعلماء في انه هل كان اسراء بروحه او جسده علي ثلاثة اقوال احدها انه ذهبت طاءفة الي انه اسراء بالروح وانه رءيا منام مع اتفاقهم علي ان رءيا الانبياء وحي وحق والي هذا ذهب معاوية وحكي عن الحسن في غير المشهور وحجتهم قوله تعالي وما جعلنا الرءيا التي اريناك الاية وما حكوا عن عاءشة ما فقدت جسد رسول الله (صلي الله عليه وسلم) وقوله (صلي الله عليه وسلم) بينا انا ناءم وقول انس وهو ناءم في المسجد الحرام وذكر القصة ثم قال في اخرها فاستيقظت وانا بالمسجد الحرام* وفي العروة الوثقي وحديث عاءشة صحيح في المعراج الذي اتفق للنبي (صلي الله عليه وسلم) علي فراشها في المدينة وقالت ما فقدت جسد رسول الله (صلي الله عليه وسلم) وقول ابن عباس ايضا صحيح في المعراج المكي الذي اخبر به نص التنزيل بقوله سبحان الذي اسري بعبده الاية لقوله تعالي ثم دنا فتدلي فكان قاب قوسين او ادني* والثاني انه ذهب معظم السلف والمسلمين الي انه اسري بروحه وجسده وفي اليقظة وهذا هو الحق وهو قول ابن عباس وجابر وانس وحذيفة وعمر وابي هريرة ومالك بن صعصعة وابي حبة البدري وابن مسعود والضحاك وسعيد بن جبير وقتادة وابن المسيب وابن شهاب وابن زيد والحسن في المشهور وابراهيم ومسروق ومجاهد وعكرمة وابن جريج وهو قول الطبري وابن حنبل وجماعة عظيمة من المسلمين وهذا قول اكثر المتاخرين من الفقهاء والمحدثين والمتكلمين والمفسرين* والثالث انه في المنام قالت طاءفة كان الاسراء بالجسد يقظة الي بيت المقدس والي السماء بالروح في المنام قال القاضي عياض الحق والصحيح انه اسراء بالجسد والروح في القصة كلها وعليه تدل الاية وصحيح الاخبار ولا يعدل عن الظاهر والحقيقة الي التاويل الا عند الاستحالة وليس في الاسراء بجسده وحال يقظته استحالة اذ لو كان منا ما لقال بروح عبده ولم يقل بعبده وقوله ما زاع البصر وما طغي ولو كان منا ما لما كان فيه اية ولا معجزة ولما استبعده الكفار ولا كذبوه فيه ولا ارتد به ضعفاء من اسلم وافتتنوا به اذ مثل هذا من المنامات لا ينكر بل لم يكن ذلك منهم الا وقد علموا ان خبره انما كان عن جسمه وحال يقظته الي ما ذكر في الحديث من ذكر صلاته بالانبياء ببيت المقدس في رواية انس او في السماء علي ما روي غيره وذكر مجء جبريل له بالبراق وخبر المعراج واستفتاح السماء فيقال من معك فيقول محمد ولقاءه الانبياء فيها وخبرهم معه وترحيبهم به وشانه في فرض الصلاة ومراجعته مع موسي في ذلك ووصوله الي سدرة المنتهي ودخوله الجنة ورءيته فيها ما ذكره* قال ابن عباس هي رءيا عين راها النبي (صلي الله عليه وسلم) لا رءيا منام* وعن الحسن بينا انا جالس في الحجر جاءني جبريل فهمزني بعقبه فقمت فجلست فلم ار شيءا فعدت لمضجعي وذكر ذلك ثلاثا فقال في الثالثة فاخذ بعضدي فجرني الي باب المسجد فاذا بدابة وذكر خبر البراق* وعن ام هانء قالت ما اسري برسول الله (صلي الله عليه وسلم) الا وهو في بيتي تلك الليلة صلي العشاء الاخرة ونام فلما كان قبيل الفجر اهبنا رسول الله (صلي الله عليه وسلم) فلما صلي الصبح وصلينا معه قال يا ام هانء لقد صليت معكم العشاء الاخرة كما رايت بهذا الوادي ثم جءت بيت المقدس وصليت فيه ثم صليت الغداة معكم الان كما ترون فهذا كله بين في انه بجسمه صلي الله عليه

 وسلم* وعن ابي بكر من رواية شداد بن اوس عنه انه قال للنبي (صلي الله عليه وسلم) ليلة اسري به طلبتك يا رسول الله البارحة في مكانك فلم اجدك فاجابه ان جبريل حمله الي المسجد الاقصي



 وعن عمر قال قال رسول الله (صلي الله عليه وسلم) صليت ليلة اسري بي مقدم المسجد ثم دخلت الصخرة فاذا بملك قاءم معه انية ثلاث وذكر الحديث وهذه التصريحات ظاهرة غير مستحيلة فتحمل علي ظواهرها وعن ابي ذر عنه (صلي الله عليه وسلم) فرج سقف بيتي وانا بمكة فنزل جبريل فشرح صدري ثم غسله بماء زمزم الي اخر القصة ثم اخذ بيدي فعرج بي قيل الحق ان المعراج مرتان مرة في النوم واخري في اليقظة قال محيي السنة وما اراه الله في النوم قبل الوحي ثم عرج به في اليقظة بعد الوحي بسنة تحقيقا لرءياه كما انه راي فتح مكة في المنام سنة ست من الهجرة ثم كان تحقيقه سنة ثمان كذا في شرح المشكاة للطيبي روي ان النبي (صلي الله عليه وسلم) حدث عن ليلة اسري به قال بينا هو يصلي في الحطيم او في الحجر مضطجعا اذ اتاه ات فشق ما بين ثغرة نحره الي شعر عانته فاستخرج قلبه ثم اتي بطست من ذهب مملوءة ايمانا فغسل قلبه ثم حشي ثم اعيد الي مكانه* قيل الحكمة في شق الصدر مرتين اما في الصغر فليصير قلبه كقلوب الانبياء في الانشراح واما في الاسراء فليصير حاله كحال الملاءكة وقيل شرح الصدر في صباه لاستخراج الهوي منه وفي الاسراء لاستدخال الايمان فيه ثم اتي بدابة طويلة بيضاء تسمي البراق وفي حياة الحيوان كان البراق ابيض وبغلته شهباء وهي التي اكثرها بياض اشارة الي تخصيصه باشرف الالوان وسمي براقا لنصوع لونه وشدة بريقه وقيل لسرعة حركته تشبيها ببرق السحاب* وقال القاضي غياض لكونها ذات لونين وفي الصحيح انه دابة دون البغل وفوق الحمار ابيض بضع خطوه عند اقصي طرفه* قال صاحب المنتقي الحكمة في كونه علي هيءة بغل ولم يكن علي هيءة فرس التنبيه علي ان الركوب في سلم وامن لا في حرب وخوف او لاظهار الاية في الاسراع العجيب في دابة لا يوصف شكلها بالاسراع ويءخذ من قوله يضع خطوه عند اقصي طرفه انه اخذ من الارض الي السماء في خطوة واحدة والي السموات السبع في سبع خطوات وبه يرد علي من استبعد من المتكلمين احضار عرش بلقيس في لحظة واحدة وقال انه اعدم ثم اوجد وعلله بان المسافة البعيدة لا يمكن قطعها في هذه اللحظة وهذا اوضح دليل علي الرد عليه وكانت مضطربة الاذنين وجهها كوجه الانسان وجسدها كجسد الفرس ناصيتها من ياقوت احمر عيناها كالزهرة اذناها من زمرد اخضر* وفي رواية اذناها كاذن الفيل وعنقها كعنق البعير وصدرها كصدر البغل* وفي رواية وصدرها كانه من ياقوت احمر وظهرها كانه صفرة البيضة يبرق من غاية صفاءه لها جناحان كجناح النسر فيهما من كل لون نصفها الاول من كافور والاخر من مسك وقواءمها كقواءم الثور وفي رواية كقواءم الفرس وفي رواية كقواءم البعير وحوافرها كحوافر الثور وفي رواية اظلافها كظلف البقر وذنبها كذنب البقر وفي رواية كذنب البعير وفي رواية كذنب الغزال لا ذكر ولا انثي عدوها كالريح وخطوها كالبرق لجامها وسرجها من در مضروب علي سرجها حجلة من نور كانها ياقوت احمر وفي رواية عليها سرج من سروج الجنة وفي رواية وعلي فخذيها ريشتان يستران ساقيها* وفي زبدة الاعمال لها جناحان في فخذيها قيل هي البراق التي ركبها جبريل والانبياء (عليهم السلام) يركبونها* وفي حياة الحيوان روي ان ابراهيم (عليه السلام) كان يزور ولده اسماعيل علي البراق وانه ركب هو واسماعيل وهاجر حين اتي بهما الي البيت الحرام ومن غاية سرعته وخفة مشيه يضع قدميه او خطوه عند اقصي طرفه وفي رواية يقع حافره عند اقصي طرفه وفي رواية عند منتهي طرفه وفي رواية خطوها عند منتهي البصر لا تمر بشء ولا يجد ريحها شء الا حيي ثم ان البراق وان كان يركبها الانبياء لكن لم تتصف بوضع الحافر عند منتهي طرفها الا عند ركوب النبي (صلي الله عليه وسلم) كذا في المنتقي* وفي رواية اتاه جبريل ومعه خمسون الف ملك لهم زجل بالتسبيح ورسول الله (صلي الله عليه وسلم) في بيت ام هانء ومعه



 ميكاءيل فقال قم يا محمد فان الجبار يدعوك واخذ جبريل بيده واخرجه من المسجد الحرام فاذا هو بالبراق واقفا بين الصفا والمروة فقال له جبريل اركب يا محمد هذه براق ابراهيم التي كان يجء عليها الي طواف الكعبة فاخذ جبريل ركابها وميكاءيل عنانها فاراد النبي (صلي الله عليه وسلم) ان يركبها وفي رواية فذهب يركبها فاستصعبت عليه قيل استصعابها لبعد العهد بالانبياء لطول الفترة بين عيسي ومحمد وهذا مبني علي ان الانبياء (عليهم السلام) ركبوها وفيه خلاف وقيل لانها لم تذلل قبل ذلك ولم يركبها احد وقيل تيها وزهوا بركوب النبي (صلي الله عليه وسلم) كذا في مزيل الخفاء فقال لها جبريل اسكني فو الله ما ركبك عبد اكرم علي الله من محمد وفي رواية قال لها جبريل ابمحمد تفعلي هذا فارفض عرقا كذا في الشفاء فركبها النبي (صلي الله عليه وسلم)* وفي حياة الحيوان اختلف الناس هل ركب جبريل معه عليه فقيل نعم كان رديفه (صلي الله عليه وسلم) وقيل لا لان النبي (صلي الله عليه وسلم) المخصوص بشرف الاسراء وانطلق به جبريل حتي اتي به بيت المقدس فربطها بالحلقة التي ربط بها الانبياء دوابهم ثم دخل المسجد الاقصي فصلي بهم ركعتين فانطلق به جبريل الي الصخرة فصعد به عليها فاذا معراج الي السماء لم ير مثله حسنا ومنه تعرج الملاءكة وقيل تعرج منه الارواح اذا قبضت فليس شء احسن منه اذا راه ارواح المءمنين لم تتمالك ان تخرج وهو الذي يمد اليه ميتكم عينيه اذا احتضر كذا في سيرة ابن هشام اصله وفي رواية احد طرفيه علي صخرة بيت المقدس واعلاه ملصق وفي رواية والاخر ملصق بالسماء احدي جنبتيه ياقوتة حمراء والاخري زبرجدة خضراء درجة له من فضة ودرجة من ذهب ودرجة من زمرد مكال بالدر واليواقيت* وفي كيفية عروجه الي السماء اختلاف قيل عرج به الي السماء علي البراق اظهارا لكرامته ولم يزل راكبا اظهارا لقدرته تعالي وقيل نزل ايضا راكبا علي البراق كما روي عن حذيفة ما زايل ظهر البراق حتي رجع وقيل احتمله جبريل علي جناحه ثم ارتفع به الي السماء من ذلك المعراج حتي اتي السماء الدنيا فاستفتح قيل من هذا قال جبريل قيل ومن معك قال محمد قيل وقد ارسل اليه قال نعم قيل مرحبا فنعم المجء جاء ففتح فلما دخل فاذا رجل قاعد علي يمينه اسودة وعلي يساره اسودة اذا نظر قبل يمينه ضحك واذا نظر قبل يساره بكي فقال جبريل هذا ابوك ادم فسلم عليه فسلم فرد (عليه السلام) ثم قال مرحبا بالابن الصالح والنبي الصالح ثم قال جبريل هذا ادم وهذه الاسودة عن يمينه وشماله نسم بنيه فاهل اليمين هم اهل الجنة والاسودة التي عن شماله اهل النار ثم صعد الي السماء الثانية وهكذا كان يستفتح جبريل في كل سماء فيفتح فيدخل فيري فيها نبيا ففي الثانية يحيي وعيسي وهما ابنا خالة وفي الثالثة يوسف وفي الرابعة ادريس وفي الخامسة هارون وفي السادسة موسي فلما اجتاز عنه النبي (صلي الله عليه وسلم) بكي قيل له ما يبكيك قال ابكي لان غلاما بعث بعدي يدخل الله الجنة من امته اكثر ممن يدخلها من امتي ثم صعد الي السماء السابعة فراي فيها ابراهيم ثم رفعت له سدرة المنتهي فاذا نبقها مثل قلال هجر وورقها كاذان الفيلة فاذا اربعة انهار نهران باطنان ونهران ظاهران قال جبريل اما الباطنان فنهران في الجنة واما الظاهران فالنيل والفرات* وفي الكشاف سدرة المنتهي هي شجرة نبق في السماء السابعة عن يمين العرش ثمرها كقلال هجر وورقها كاذان الفيول تتبع من اصلها الانهار التي ذكرها الله في كتابه يسير الراكب في ظلها سبعين عاما لا يقطعها* وفي المدارك وجه تسميتها كانها في منتهي الجنة واخرها وقيل لم يجاوزها احد واليها ينتهي علم الملاءكة وغيرهم ولا يعلم احد ما وراءها وقيل تنتهي اليها ارواح الشهداء* وفي بعض الروايات انها في السماء السادسة* قال القاضي عياض كونها في السابعة هو الاصح وقال النووي يمكن الجمع بان اصلها في السادسة ومعظمها في السابعة ثم رفع له البيت المعمور وهو بيت في السماء السابعة محاذ



 للكعبة يدخله كل يوم سبعون الف ملك ولا يعودون اليه هكذا في الصحيحين وغيرهما من كتب الاحاديث يذكر البيت المعمور بعد سدرة المنتهي واما في الكشاف وغيره من كتب التفاسير فالبيت المعمور الضراح في السماء الرابعة حيال الكعبة وقيل في الاولي وقيل في السادسة ولمسلم في صحيحه بعد صعوده الي السماء السابعة راي فيها ابراهيم مسند اظهره الي البيت المعمور وسلم علي كل منهم اذا راه وهو يرد ثم يقول مرحبا بالاخ الصالح والنبي الصالح الا ادم وابراهيم فانهما قالا بالابن الصالح كما مر في السماء الدنيا* وفي رواية عن طريق ابن عباس ثم عرج به حتي ظهر مستوي يسمع فيه صريف الاقلام ثم اتي باناء من خمر واناء من عسل واناء من لبن فاخذ اللبن فقال جبريل هي الفطرة التي انت عليها وامتك* وفي رواية بعد استصعاب البراق فركبها حتي اتي الحجاب الذي يلي الرحمن تعالي فبينا هو كذلك اذ خرج ملك من الحجاب فقال رسول الله (صلي الله عليه وسلم) يا جبريل من هذا قال والذي بعثك بالحق اني لا قرب الخلق مكانا وان هذا الملك ما رايته منذ خلقت قبل ساعتي هذه ولما جاوز سدرة المنتهي قال له جبريل تقدم يا محمد فقال له النبي (صلي الله عليه وسلم) تقدم انت يا جبريل او كما قال قال جبريل يا محمد تقدم فانك اكرم علي الله مني فتقدم النبي (صلي الله عليه وسلم) وجبريل علي اثره حتي بلغه الي حجاب منسوج بالذهب فحركه جبريل فقيل من هذا قال جبريل قيل ومن معه قال محمد قال ملك من وراء الحجاب الله اكبر الله اكبر قيل من وراء الحجاب صدق عبدي انا اكبر انا اكبر فقال ملك اشهد ان لا اله الا الله فقيل من وراء الحجاب صدق عبدي انا الله لا اله الا انا فقال ملك اشهد ان محمدا رسول الله فقيل من وراء الحجاب صدق عبدي انا ارسلت محمدا فقال ملك حي علي الصلاة حي علي الفلاح فقيل من وراء الحجاب صدق عبدي دعا الي عبدي فاخرج ملك يده من وراء الحجاب فرفعه فتخلف جبريل عنه هناك* وفي رواية فما زال يقطع مقاما بعد مقام وحجابا بعد حجاب حتي انتهي الي مقام تخلف عنه فيه جبريل فقال يا جبريل لم تخلفت عني قال يا محمد وما منا الا له مقام معلوم لو دنوت انملة لاحترقت وفي هذه الليلة بسبب احترامك وصلت الي هذا المقام والا فمقامي المعهود عند السدرة فمضي النبي (صلي الله عليه وسلم) وحده وكان يقطع الحجب الظلمانية حتي جاوز سبعين الف حجاب غلظ كل حجاب مسيرة خمسماءة سنة وما بين كل حجاب ايضا مسيرة خمسماءة سنة فوقف البراق عن المسير فظهر له رفرف اخضر غلب نوره علي نور الشمس فرفع النبي (صلي الله عليه وسلم) علي ذلك الرفرف وذهب به الي قرب العرش* وفي رواية كان يقال له ادن مني ادن مني حتي قيل له في تلك الليلة الف مرة يا محمد ادن مني ففي كل مرة منها كان يترقي حتي بلغ مرتبة دنا ومنها ترقي الي مرتبة فتدلي ومنها ترقي حتي وصل الي منزله قاب قوسين او ادني كما قال تعالي ثم دنا اي دنا محمد الي ربه تعالي اي قرب بالمنزلة والمرتبة لا بالمكان فانه تعالي منزه عنه وانما هو قرب المنزلة والدرجة والكرامة والرافة فتدلي اي سجد له تعالي لانه كان قد وجد تلك المرتبة بالخدمة فزاد في الخدمة وفي السجدة عدة القرب ولهذا قال (صلي الله عليه وسلم) اقرب ما يكون العبد من ربه ان يكون ساجدا قال بعض اهل التحقيق ثم دنا اشارة الي مقام نفسه الزكية فتدلي اشارة الي مقام قلبه المطهر فكان قاب قوسين اشارة الي مقام روحه الطيب او ادني اشارة الي مقام سره المنور نفسه في مقام الخدمة وقلبه في مقام المحبة وروحه في مقام القربة وسره في مقام المشاهدة حياة نفسه بالخدمة وصفاء قلبه بالمحبة وبقاء روحه بالقربة وغذاء سره بالمشاهدة لو نظرت نفسه الي وجوده لبقيت بلا خدمة ولو نظر قلبه الي نفسه لبقي بلا محبة ولو نظرت روحه الي قلبه لبقي بلا قربة ولو نظر سره الي روحه لبقي بلا مشاهدة وسءل ابو الحسين النوري عن معني هذه الاية اجاب بانه لم يسعه جبريل فمن النوري ثم قال

 (دنا) في الافهام



 القاصرة يقال اذا كان لشخص بعد عن شء ولا بعد ثمة (فتدلي) يقال اذا كان مكان ولا مكان ثمة (فكان) عبارة عن الزمان ولا عبارة ولا زمان ثمة (قاب قوسين) اشارة الي المقدار ولا اشارة ولا مقدار ثمة (او) كلمة شك ولا شك ثمة (ادني) مبالغة في ان قرب شخص اقرب من الاخر ولا ادني معه ثمة فان العبارة والافهام قاصرة من ادراك تقرير ذلك ولم يعبر اهل المعرفة عن ذلك المقام الا بهذا المقدار دنا عبدا فتدلي فردا دنا مكيا فتدلي ملكيا دنا قرشيا فتدلي عرشيا دنا مجاهدا فتدلي مشاهدا دنا طالبا فتدلي واصلا دنا ومعه الرحمة فتدلي ومعه المرحمة دنا افتقارا فتدلي افتخارا دنا مناديا فتدلي مناجيا دنا مادحا فتدلي ممدوحا دنا شاكرا فتدلي مشكورا وقيل احدهما صفة الله والاخري صفة محمد (صلي الله عليه وسلم) ومعناه كان هو يتقرب الي الله والله يقربه وكان هو يتكلم والله يسمعه وكان هو يساله والله يعطيه وكان هو يشفع والله يشفعه فكان قاب قوسين او ادني كناية عن تاكيد القرية وتقرير المحبة وبسبب التقريب الي الفهم ادي في صورة التمثيل وهذا مقام ليس فوقه مقام وللسالكين من الامة المرحومة المحمدية من هذا المقام نصيب كما ورد بيانه في الحديث القدسي لا يزال عبدي يتقرب الي بالنوافل حتي احبه فاذا احببته كنت سمعه الذي يسمع به وبصره الذي يبصر به ويده التي يبطش بها ورجله التي يمشي بها ولهذا كان النبي (صلي الله عليه وسلم) اذا ضجر وضاق صدره عن الخلق يقول ارحنا يا بلال ويقول جعلت قرة عيني في الصلاة ولذا قيل الصلاة معراج المءمن كذا في روضة الاحباب* واختلف في مناجاته تعالي وكلامه مع النبي (صلي الله عليه وسلم) فقوله تعالي فاوحي الي عبده ما اوحي الي ما تضمنته الاحاديث فاكثر المفسرين علي ان الموحي الله الي جبريل وجبريل الي محمد* وذكر عن جعفر بن محمد الصادق انه قال اوحي الله اليه بلا واسطة ونحوه عن الواسطي وعلي هذا ذهب بعض المتكلمين الي ان محمدا (صلي الله عليه وسلم) كلم ربه في الاسراء وحكي عن الاشعري وعن ابن مسعود وذكر النقاش عن ابن عباس في قصة الاسراء عنه (صلي الله عليه وسلم) في قوله دنا فتدلي قال فارقني جبريل فانقطعت الاصوات عني فسمعت كلام ربي وهو يقول ليهدا روعك يا محمد ادن ادن وفي قوله تعالي وما كان لبشر ان يكلمه الله الاية قالوا هي علي ثلاثة اقسام من وراء حجاب كتكليم موسي وبارسال الملاءكة كحال جميع الانبياء واكثر احوال نبينا عليه و(عليهم السلام)* الثالث قوله وحيا ولم يبق من اقسام الكلام الا المشافهة مع المشاهدة ثم انه تعالي اخفي من الخلق كل ما نسب اليه في تلك الليلة اشارة الي انه حبيبه الخاص فقال في حال مشاهدته لسدرة المنتهي اذ يغشي السدرة ما يغشي وفي الايات التي اراه لقد راي من ايات ربه الكبري وفي التكلم معه فاوحي الي عبده ما اوحي اي اوحي الي عبده محمد في ذلك المقام* وللعلماء في بيان ما اوحي خلاف قال بعضهم وهم اهل الاحتياط الاقرب الي الصواب ان لا يعين لانه لو كانت الحكمة والمصلحة في اظهاره وتعيينه لما ابهمه وقال الاخرون لا باس بذكر ما بلغنا في خبر او اثر او من جهة الاستدلال والاستنباط ومن ذلك ما ورد في حديث صحيح ثلاثة اشياء احدها فريضة الصلوات الخمس وهذا دليل علي ان افضل الاعمال الصلوات الخمس لانها فرضت في ليلة المعراج بغير واسطة جبريل والثاني خواتيم سورة البقرة والثالث ان يغفر لامة محمد (صلي الله عليه وسلم) كل الذنوب غير الشرك* وورد في حديث اخر رايت ربي في احسن صورة اي صفة فقال فيم يختصم الملا الا علي يا محمد قلت انت اعلم اي رب فتجلي لي بالتجلي الخاص الذي عبر عنه (صلي الله عليه وسلم) بهذه العبارة فوضع كفه بين كتفي فوجدت بردها بين ثديي فعلمت ما في السماء والارض ثم قال فيم يختصم الملا الاعلي يا محمد قلت في الكفارات والدرجات قال وما الكفارات قلت المشي علي الاقدام الي الجماعات والجلوس في المساجد خلف الصلوات وابلاغ الوضوء اماكنه في المكاره من يفعل ذلك



 يعش بخير ويمت بخير ويخرج من خطيءته كيوم ولدته امه ثم قيل له اذا صليت الصلاة قل اللهم اني اسالك الطيبات وترك المنكرات وفعل الخيرات وحب المساكين وان تغفر لي وترحمني وتتوب علي واذا اردت بقوم او بعبادك فتنة فتوفني او فاقبضني غير مفتون ثم قال وما الدرجات يا محمد قلت افشاء السلام واطعام الطعام والصلاة بالليل والناس نيام وفي حديث اخر ان النبي (صلي الله عليه وسلم) لما فاز بالقرب والكرامة في تلك الليلة قيل يا محمد انا وانت وما سوي ذلك خلقتها لاجلك فقال النبي (صلي الله عليه وسلم) انت وانا وما سوي ذلك تركتها لاجلك وقيل اوحي الله اليه كن ايسا من الخلق فليس بايديهم شء واجعل صحبتك معي فان مرجعك الي ولا تجعل قلبك متعلقا بالدنيا فما خلقتك لها* وفي المدارك الذي اوحي اليه ان الجنة محرمة علي الانبياء حتي تدخلها انت وعلي الامم حتي تدخلها امتك* وفي رواية عنه (صلي الله عليه وسلم) بعد ما تخلف عنه جبريل انه تجاوز ذلك المقام مقدار خمسماءة عام حتي سمع داعيا يقول تقدم يا اكرم الخلق علي الله فتقدم حتي بلغ امام العرش وراي عظمته فاعتراه خوف واستولي عليه رعب فسمع النداء يقول ادن يا محمد فدنا فقطرت عليه من العرش قطرة ما اخطات فمه فوقعت علي لسانه فكانت احلي من كل شء فاراه الله بها علم الاولين والاخرين فحصلت للسانه طلاقة بعد ما اعتراه عي وكلالة من مشاهدة عظمة الله وهيبته ثم سمع النداء يقول حي ربك فالهمه الله تعالي ان قال* التحيات المباركات الصلوات الطيبات لله وفي رواية التحيات لله والصلوات والطيبات فسمع الله يقول السلام عليك ايها النبي ورحمة الله وبركاته قال النبي (صلي الله عليه وسلم) السلام علينا وعلي عباد الله الصالحين فقالت الملاءكة اشهد ان لا اله الا الله واشهد ان محمدا عبده ورسوله* وفي رواية وحده لا شريك له واشهد ان محمدا عبده ورسوله ثم اعطي خواتيم سورة البقرة ووقع له في تلك الليلة كلمات ومقالات مع ربه تعالي يطول الكلام بذكرها فاقتصرنا علي نبذ منها* وفي الشفاء عن ابي حمراء قال قال رسول الله (صلي الله عليه وسلم) لما اسري بي الي السماء اذا علي العرش مكتوب لا اله الا الله محمد رسول الله ايدته بعلي ثم فرضت عليه وعلي امته في كل يوم وليلة خمسين صلاة وستجء كيفيتها* واختلف ايضا في رءية النبي (صلي الله عليه وسلم) ربه تعالي فانكرتها عاءشة* روي عن مسروق انه قال لعاءشة يا ام المءمنين هل راي محمد (صلي الله عليه وسلم) ربه قالت لقد قف شعري مما قلت ثم قرات لا تدركه الابصار الاية وقال جماعة بقول عاءشة وهو المشهور عن ابن مسعود ومثله عن ابي هريرة في قوله ما كذب الفءاد ما راي انه راي جبريل له ستماءة جناح ويءيد ذلك ما قال ابو ذر سالت رسول الله (صلي الله عليه وسلم) هل رايت ربك قال نور اني اراه* وفي العروة الوثقي قال ابو ذر سالته عن رءية ربه ليلة المعراج قال لا بل نورا اري* وفي معالم التنزيل والمدارك ان جبريل كان ياتي النبي صلي الله عليهما وسلم في صورة الادميين كما كان ياتي النبيين فساله رسول الله (صلي الله عليه وسلم) ان يريه نفسه علي صورته التي جبل عليها فاراه نفسه مرتين مرة في الارض ومرة في السماء اما ما في الارض ففي الافق الاعلي والمراد بالاعلي جانب المشرق* وفي المشكاة برواية الترمذي ومرة في اجياد* وفي نهاية الجزري الاجياد موضع باسفل مكة معروف من شعابها انتهي وذلك اي بيان رءيته في الافق الاعلي ان محمدا (صلي الله عليه وسلم) كان بحراء فطلع له جبريل من المشرق وله ستماءة جناح فسد الافق الي المغرب فخر رسول الله (صلي الله عليه وسلم) مغشيا عليه فنزل جبريل في صورة الادميين فضمه الي نفسه وجعل يمسح الغبار عن وجهه وهو قوله ثم دنا فتدلي واما ما في السماء فعند سدرة المنتهي ولم يره احد من الانبياء علي تلك الصورة الا محمد (صلي الله عليه وسلم)* وفي المدارك وذلك ليلة المعراج وقال بامتناع

 رءيته



 في الدنيا جماعة من الفقهاء والمحدثين والمتكلمين* وعن ابن عباس انه راه سبحانه بعين راسه* وروي عطاء عنه انه راه بقلبه كذا ذكرهما في المدارك* وعن ابي العالية انه راه بفءاده مرتين* وذكر ابن اسحاق ان ابن عمر ارسل الي ابن عباس يساله هل راي محمد ربه فقال نعم والاشهر عنه انه راي ربه بعينه* قال الماوردي قيل ان الله تعالي قسم كلامه ورءيته بين موسي ومحمد فراه محمد مرتين وكلمه موسي مرتين* قال عبد الله بن الحارث اجتمع ابن عباس وكعب بعرفة فقال ابن عباس اما نحن بني هاشم فنقول ان محمدا راي ربه مرتين فكبر كعب حتي جاوبته الجبال وقال ان الله قسم رءيته وكلامه بين محمد وموسي فكلمه موسي وراه محمد بقلبه* وروي شريك عن ابي ذر في تفسير الاية ما كذب الفءاد ما راي قال راي النبي (صلي الله عليه وسلم) ربه* وحكي السمرقندي عن محمد بن كعب القرظي وربيع بن انس ان النبي (صلي الله عليه وسلم) سءل هل رايت ربك قال رايته بفءادي ولم اره بعيني* وحكي عبد الرزاق ان الحسن كان يحلف بالله لقد راي محمد ربه* وحكي ابن اسحاق ان مروان سال ابا هريرة هل راي محمد ربه فقال نعم* وحكي النقاش عن احمد بن حنبل انه قال انا اقول بحديث ابن عباس بعينه راه راه حتي انقطع نفسه يعني نفس احمد* وقال سعيد بن جبير لا اقول راه ولا لم يره* وقال ابو الحسن علي بن اسماعيل الاشعري وجماعة من اصحابه انه راي الله ببصره وعيني راسه ووقف بعض المشايخ في هذا كما وقف ابن جبير وقال ليس عليه دليل واضح ولكنه جاءز* قال القاضي ابو الفضل والحق الذي لا امتراء فيه ان رءيته تعالي في الدنيا جاءزة عقلا اذ كل موجود فرءيته جاءزة غير مستحيلة وليس في الشرع دليل قاطع علي استحالتها ولكن وقوعه ومشاهدته من الغيب الذي لا يعلمه الا من علمه الله تعالي ثم بعد ما فرضت عليه خمسون صلاة اذن له بالرجوع فرجع من حيث جاء حتي بلغ منزل جبريل فقال له جبريل ابشر يا محمد فانك خير خلق الله ومصطفاه بلغك الليلة الي مرتبة لم يبلغها احدا من خلقه قط لا ملكا مقربا ولا نبيا مرسلا هنيءا لك هذه الكرامة ثم ذهب به جبريل الي الجنة والنار. واراه منازلهما وما في الجنة من الحور والقصور والغلمان والولدان والاشجار والاثمار والازهار والانهار والبساتين والرياحين والرياض والحياض والغرف والشرف وما في النار من السلاسل والاغلال والانكال والحيات والعقارب والزفير والشهيق والغساق واليحموم وتفاصيلها تءدي الي التطويل* ثم رجع فمر بموسي فساله بما امرت قال امرت بخمسين صلاة كل يوم وليلة قال ان امتك لا تستطيع واني والله قد جربت الناس قبلك وعالجت بني اسراءيل اشد المعالجة فارجع الي ربك فسله التخفيف لامتك فرجع وقال يا رب خفف عن امتي فوضع عنه ربه عشرا فرجع الي موسي فقال مثله فرجع الي ربه فوضع عنه عشرا فلم يزل يرجع بين ربه وبين موسي حتي قال يا محمد انهن خمس صلوات كل يوم وليلة لكل صلاة عشر فذلك خمسون صلاة ومن هم بحسنة فلم يعملها كتبت له حسنة فان عملها كتبت له عشرا ومن هم بسيءة فلم يعملها لم نكتب شيءا فان عملها كتبت سيءة واحدة* فرجع الي موسي فقال بم امرت قال بخمس صلوات كل يوم قال ان امتك لا تستطيع خمس صلوات فارجع الي ربك فسله التخفيف قال سالت ربي حتي استحييت ولكني ارضي واسلم ولما جاوز عن موسي سمع مناديا ينادي فيقول امضيت فريضتي وخففت عن عبادي وهي خمس وهن خمسون ثم يقول يا محمد قد جعلت صلاتك وصلاة امتك قياما وركوعا وسجودا وتشهدا وقراءة وتسبيحا وتهليلا تشتمل عبادتهم علي ساءر عبادات الملاءكة من لدن عرشي الي منتهي الثري فيكون لهم بالقيام ثواب القاءمين وبالركوع ثواب الراكعين وبالسجود ثواب الساجدين وبالتشهد ثواب المتشهدين ولهم بالقراءة والتسبيح ثواب المسبحين والقارءين



 وبالتهليل ثواب المهللين ولدي مزيد كذا في المنتقي* وروي انه (صلي الله عليه وسلم) لما رجع كان جبريل (عليه السلام) رفيقه حتي دخل بيت ام هانء* وروي عمر بن الخطاب عن النبي (صلي الله عليه وسلم) انه قال ثم رجعت الي خديجة وما تحولت عن جانبها* وفي رواية عاد (صلي الله عليه وسلم) الي بيت المقدس ومعه جبريل حتي اتي به مكة الي فراشه وبقيت من الليل ساعات* وفي زين القصص عن عمار كان زمان ذهابه ومجيءه ثلاث ساعات* وعن وهب بن منبه ومحمد بن اسحاق اربع ساعات والله اعلم* وعن عاءشة انها قالت لما اسري بالنبي (صلي الله عليه وسلم) اصبح يحدث بذلك فارتد ناس ممن كان امن به وضعف ايمانهم واليه اشار قوله تعالي وما جعلنا الرءيا التي اريناك الا فتنة للناس وسبب ارتدادهم انهم كانوا يرون العير تذهب شهرا من مكة الي الشام مدبرة وتجء شهرا مقبلة فاستحالوا عند عقولهم القاصرة قطع تلك المسافة البعيدة في زمان قليل ببعض الليل فارتدوا والاستحالة مدفوعة لما ثبت في الهندسة ان ما بين طرفي قرص الشمس ضعف ما بين طرفي كرة الارض ماءة ونيفا وستين مرة ثم ان طرفها الاسفل يصل موضع طرفها الاعلي في اقل من ثانية وقد برهن في الكلام ان الاجسام متساوية في قبول الاعراض والله تعالي قادر علي كل الممكنات فيقدر ان يخلق مثل هذه الحركة السريعة في بدن النبي (صلي الله عليه وسلم) او فيما يحمله والتعجب من لوازم المعجزات كذا في انوار التنزيل وايضا قال اهل الهيءة ان الفلك الاعظم في مقدار زمان يتلفظ الانسان بلفظة واحدة يقطع الفا واثنين وثلاثين فرسخا* وروي انه لما رجع رسول الله (صلي الله عليه وسلم) ليلة اسري به وكان بذي طوي قال يا جبريل ان قومي لا يصدقوني قال يصدقك ابو بكر وهو الصديق* وعن ابن عباس ان النبي (صلي الله عليه وسلم) لما اصبح جلس في الحجر معتزلا حزينا لما انه كان يعلم ان قومه يكذبونه فبينما هو جالس كذلك اذ مر به ابو جهل فجلس اليه فقال له كالمستهزء يا محمد هل استفدت من شء جديد قال نعم سافرت البارحة* وفي رواية اسري بي الليلة الي بيت المقدس ومنه الي السموات قال ابو جهل سافرت الليلة الي بيت المقدس واصبحت بين اظهرنا بمكة قال نعم فلم ير ابو جهل انه ينكر ذلك مخافة ان يجحده الحديث قال اتحدث قومك بما حدثتني قال نعم فصاح ابو جهل يا معشر بني كعب بن لءي هلموا فانتقضت المجالس فجاءوا حتي جلسوا اليهما قال فحدث قومك بما حدثتني قال نعم اسري بي الليلة قالوا الي اين قال الي بيت المقدس قالوا ثم اصبحت بين اظهرنا قال نعم فوقعوا في التعجب والاستغراب وقالوا ان هذا لشء عجاب وبعضهم من كثرة انكارهم يصفقون وبعضهم من قلة اعتبارهم يضحكون وبعضهم يضعون ايديهم علي رءوسهم تعجبا فان هذا الامر يري عندهم محالا وعجبا وارتد ناس ممن كان قد امن به وصدقه* وعن عاءشة رضي الله عنها سعي رجال من المشركين وهم ابو جهل واتباعه الي ابي بكر فقالوا له هل لك في صاحبك يزعم انه اسري به الي بيت المقدس ومنه الي السموات فقال او قال ذلك قالوا نعم قال لءن قال ذلك لقد صدق قالوا اتصدقه انه ذهب الي الشام ورجع قبل ان يصبح قال نعم اني اصدقه فيما هو ابعد من ذلك اصدقه بخبر السماء في غدوة وروحة* قال بعضهم فمن ذلك اليوم سمي ابو بكر صديقا* وعن ابي هريرة انه قال قال رسول الله (صلي الله عليه وسلم) لقد رايتني في الحجر وقريش تسالني عن مسراي فسالتني عن اشياء من بيت المقدس لم اثبتها فكربت كربا ما كربت مثله قط فرفعه الله لي انظر اليه فما يسالونني عن شء الا انباتهم ونحوه عن جابر كذا في الشفاء* وعن عاءشة قالوا يا محمد هل تستطيع ان تنعت لنا المسجد الاقصي فشرع ينعت حتي اذا التبس قال فجء بالمسجد وانا انظر اليه حتي وضع دون دار عقيل فنعت المسجد وانا انظر اليه فقال القوم اما النعت فو الله لقد اصاب فيه وهذا ابلغ في المعجزة ولا استحالة فيه فقد احضر عرش بلقيس في طرفة عين فقالوا

 اخبرنا



 عن عيرنا فهي اهم الينا من ذلك هل لقيت منها شيءا قال نعم مررت علي عير بني فلان وهي بالروحاء وقد اضلوا بعيرا لهم وهم في طلبه وفي رحالهم قدح من ماء فعطشت فاخذته وشربته ثم وضعته فسلوهم هل وجدوا الماء في القدح حين رجعوا قالوا هذه اية* قال ومررت بعير بني فلان وفلان راكبان قلوصا لهما* وفي رواية قعودا لهما بذي مر فنفر البعير مني فرمي بفلان فانكسرت يده فسلوهما عن ذلك فقالوا هذه اية اخري قالوا اخبرنا عن عيرنا قال مررت بها بالتنعيم قالوا فما عدتها واجمالها وهيءتها فقال كنت في شغل عن ذلك ثم مثل لي بعدتها واجمالها ومن كان فيها وكانوا بالجرورة قال نعم هيءتها كذا وكذا وفيها فلان وفلان يقدمها جمل اورق عليه غرارتان مخططتان يطلع عند طلوع الشمس* وفي المواهب اللدنية يقدمهم جمل ادم عليه مسح اسود وغرارتان سودا وان قالوا هذه اية اخري ثم خرجوا نحو ثنية كداء حتي يكذبونه فاذا بقاءل يقول هذه الشمس قد طلعت وقال الاخر هذه العير قد اقبلت كما قال محمد يقدمها فلان وفلان كذا في المنتقي* وفي رواية البيهقي اشرف الناس ينتظرون حتي اذا كان قريب من نصف النهار اقبلت العير فلم يءمنوا وقالوا ما سمعنا بمثل هذا قط ان هذا الا سحر مبين* وفي رواية سالوه ايضا عن عير الشام ليستدل به علي تكذيبه او تصديقه فيما قال (عليه السلام) فوصفهم وقال يقدمون يوم الاربعاء فكان ذلك اليوم وما قدموا حتي كادت الشمس ان تغرب فدعا الله تعالي فحبسها حتي قدموا مكة فعلموا صدقه ومع ذلك لم يصدقوه في الخبر وما امنوا كذا في سيرة مغلطاي* وفي حياة الحيوان حبست الشمس مرتين لنبينا (صلي الله عليه وسلم) احداهما يوم الخندق حين شغلوا عن صلاة العصر حتي غربت الشمس فردها الله عليه كما رواه الطحاوي وغيره والثانية صبيحة الاسراء حين انتظروا العير التي اخبر بوصولها مع شروق الشمس ذكره القاضي عياض في غير الشفاء وحبست ليوشع بن نون وحبست لداود ذكره الخطيب في كتاب النجوم وضعف رواية وحبست لسليمان ذكره البغوي في معالم التنزيل في سورة ص كذا في مزيل الخفاء* وفي سيرة مغلطاي ذكر الطحاوي ان الشمس ردت له في بيت اسماء بنت عميس حين شغل عن صلاة العصر* اعلم انه ليس لاحد من اهل القبلة اختلاف في وقوع المعراج للنبي (صلي الله عليه وسلم) فمن انكر المعراج يكفر لانه انكار لنص القران قال الله تعالي سبحان الذي اسري بعبده ليلا من المسجد الحرام الي المسجد الاقصي وايضا ورد فيه الاحاديث الصريحة المشهورة القريبة من حد التواتر واما منكر المعراج الي السموات فمبتدع ضال عند اءمة الدين* وفي هذه السنة فرضت الصلوات الخمس ليلة الاسراء وقد مر كيفيتها*

  ذكر بيعة العقبة الثانية

 وفي هذه السنة الثانية عشر وقعت بيعة العقبة الاولي ومقتضي ما قدمناه قبل المعراج ان تكون هذه الثانية كذا في الوفاء والمواهب اللدنية* ولما كان العام المقبل الموعد خرج رسول الله (صلي الله عليه وسلم) عامءذ الي الموسم فلقيه اثنا عشر رجلا* وفي الاكليل احد عشر رجلا وهي العقبة الثانية فيهم خمسة من الستة المذكورة وهم ابو امامة وعوف بن عفراء ورافع بن مالك وقطبة ابن عامر بن حديدة وعقبة بن عامر بن نابي ولم يكن فيهم جابر بن عبد الله بن ذءاب لم يحضرها والسبعة تتمة الاثني عشر هم معاذ بن الحارث ورفاعة وهو ابن عفراء اخو عوف المذكور وذكوان بن عبد القيس الزرقي وقيل انه رحل الي رسول الله (صلي الله عليه وسلم) الي مكة فسكنها معه فهو مهاجري انصاري قتل يوم احد وعبادة بن الصامت بن قيس وابو عبد الرحمن يزيد بن ثعلبة البلوي والعباس بن عبادة بن نضلة وهءلاء من الخزرج ومن الاوس رجلان ابو الهيثم بن التيهان من بني عبد الاشهل وعويمر بن ساعدة فاسلموا وبايعوا علي بيعة النساء اي وفق بيعتهن التي نزلت بعد فتح مكة وهي ان لا نشرك بالله شيءا ولا نسرق ولا نزني ولا نقتل اولادنا ولا ناتي ببهتان نفتريه بين ايدينا وارجلنا



 ولا نعصيه في معروف والسمع والطاعة في العسر واليسر والمنشط والمكره واثرة علينا وان لا ننازع الامر اهله وان نقول بالحق حيث كنا لا نخاف في الله لومة لاءم قال (عليه السلام) فان وفيتم فلكم الجنة ومن غشني وفعل من ذلك شيءا كان امره الي الله ان شاء عذبه وان شاء عفا عنه ولم يفرض يومءذ القتال ثم انصرفوا الي المدينة وبعث رسول الله (صلي الله عليه وسلم) معهم مصعب بن عمير الي المدينة يعلم اهلها الاحكام ويقرء القران فنزل علي اسعد بن زرارة وفي المواهب اللدنية اظهر الله الاسلام اي في المدينة وكان اسعد بن زرارة يجتمع بالمدينة بمن اسلم وكتبت الاوس والخزرج الي النبي (صلي الله عليه وسلم) ابعث الينا من يقرءنا القران فبعث اليهم مصعب بن عمير فاسلم خلق كثير وفشا الاسلام فيهم وكتب الي رسول الله (صلي الله عليه وسلم) يستاذنه ان يجمع بهم فاذن له فجمع بهم في دار سعد بن خيثمة وكان اول من جمع الجمعة بالمدينة بالمسلمين قبل ان يقدمها رسول الله (صلي الله عليه وسلم) ثم قدم مصعب علي رسول الله (صلي الله عليه وسلم) مع السبعين الذين وافوه كما سيجء في العقبة الثانية فاقام مصعب بمكة قليلا ثم قدم قبل رسول الله (صلي الله عليه وسلم) المدينة مهاجرا فهو اول من قدمها والله اعلم*

  (ذكر صفة مصعب بن عمير)

 * كان رقيق البشرة ليس بالطويل ولا بالقصير قتل يوم احد وهو ابن اربعين سنة او يزيد شيءا كذا في الصفوة وسيجء في الموطن الثالث في غزوة احد*

  ذكر بيعة العقبة الكبري

 وفي ذي الحجة من السنة الثالثة عشر من النبوة قبل الهجرة بثلاثة اشهر وقعت بيعة العقبة الكبري وبعضهم يسميها العقبة الثانية ومقتضي ما قدمناه ان تسمي الثالثة كذا في الوفاء وفي التاريخ الاوسط للبخاري ان اهل مكة سمعوا هاتفا يهتف قبل اسلام سعد بن معاذ وهو يقول

 فان يسلم السعدان يصبح محمد ~ بمكة لا يخشي خلاف مخالف

 وفي رواية من الامن لا يخشي خلاف مخالف فقالت قريش لو علمنا من السعدان قال عند ذلك

 ايا سعد سعد الاوس ان كنت ناصرا ~ ويا سعد سعد الخزرجين الغطارف

 اجيبا الي داعي الهدي وتمنيا ~ علي الله في الفردوس منية عارف

 قال اهل السير في السنة الثالثة عشر من النبوة قدم مكة في موسم الحج قريب من خمسماءة نفر وفي رواية ثلاثماءة نفر من الاوس والخزرج وخرج معهم مصعب بن عمير الي مكة واتفق منهم سبعون رجلا قال ابن سعد يزيدون رجلا او رجلين وامراتان نسيبة بنت كعب ام عمارة واسماء بنت عمر وقال ابن اسحاق ثلاثة وسبعون رجلا وامراتان وقال الحاكم خمس وسبعون نفسا لاقوا رسول الله (صلي الله عليه وسلم) فواعدهم ان يحضروا شعب العقبة في الليلة الثالثة من ليالي التشريق للمبايعة* وفي الصفوة جاء قوم من اهل العقبة يطلبون رسول الله (صلي الله عليه وسلم) فقيل لهم هو في بيت العباس فدخلوا عليه فقال لهم العباس ان معكم من قومكم هو مخالف لكم فاخفوا امركم حتي يتصدع هذا الحاج ونلتقي نحن وانتم فنوضح لكم هذا الامر فتدخلون فيه علي امر بين فوعدهم رسول الله (صلي الله عليه وسلم) الليلة التي في صبيحتها النفر الاخر وفي رواية فواعدوه العقبة من اوسط ايام التشريق والمعني واحد ان يوافيهم اسفل العقبة وامرهم ان لا ينبهوا ناءما ولا ينتظروا غاءبا ولما فرغوا من الحج وكانت الليلة الموعودة خرج القوم بعد هدء الناس* وفي المنتقي باتوا تلك الليلة في رحالهم حتي اذا مضي ثلث الليل خرجوا من رحالهم لميعاد رسول الله (صلي الله عليه وسلم) يتسللون مستخفين تسلل القطا حتي اجتمعوا في الشعب عند العقبة ثلاثة وسبعين رجلا ومعهم امراتان ام عمارة بنت كعب احدي نساء بني مازن واسماء بنت عمرو بن عدي احدي نساء بني سليم وقد سبقهم رسول الله (صلي الله عليه وسلم) ومعه العباس



 وليس معه غيره وهو يومءذ علي دين قومه الا انه يحب ان يحضر امر ابن اخيه ويوثق له فلما جلس واجتمعوا له كان اول من تكلم العباس فقال يا معشر الخزرج وكانت الاوس والخزرج تدعي الخزرج قد دعوتم محمدا الي ما دعوتموه ومحمد من اعز الناس في عشيرته يمنعه والله من كان علي قوله ومن لم يكن كذلك منعه للحسب والشرف وقد ابي محمد الناس كلهم غيركم* وفي وفاء الوفاء وقد ابي الا الانحياز اليكم فان كنتم اهل قوة وجلد ونظر بالحرب واستقلال بعداوة العرب قاطبة فانها سترميكم عن قوس واحدة فارتءوا رايكم واءتمروا امركم فلا تفرقوا الا عن اجتماع فان احسن الحديث اصدقه واخري صفوا لي الحرب كيف تقاتلون عدوكم فاسكت القوم وتكلم عبد الله بن عمرو بن حزام فقال نحن والله اهل الحرب غذينا بها ومرينا وورثناها عن اباءنا كابرا عن كابر نرمي بالنسل حتي تفني ثم نطاعن بالرماح حتي تكسر ثم نمشي بالسيوف فنضرب بها حتي يموت الاعجل منا او من عدونا فقال العباس هل فيكم دروع قالوا نعم شاملة وقال البراء بن معرور قد سمعنا ما قلت والله لو كان في انفسنا غير ما ننطق به لقلناه ولكن نريد الوفاء والصدق ويذل المهج وانفسنا دون رسول الله (صلي الله عليه وسلم) وعن الشعبي قال انطلق رسول الله (صلي الله عليه وسلم) بالعباس الي السبعين عند العقبة تحت الشجرة فقال العباس ليتكلم متكلمكم ولا يطيل الخطبة فان عليكم من المشركين عينا وان يعلموا بكم فيفضحوكم فقال قاءلهم وهو اسعد يا محمد سل لربك ما شءت ثم سل لنفسك واصحابك ما شءت ثم اخبرنا مالنا من الثواب علي الله اذا فعلنا ذلك فقال اسالكم لربي ان تعبدوه ولا تشركوا به شيءا واسالكم لنفسي ولاصحابي ان تءوونا وتنصرونا وتمنعونا مما تمنعون منه انفسكم قالوا فما لنا اذا فعلنا ذلك قال الجنة قالوا فلك ذلك* وفي المنتقي تكلم رسول الله (صلي الله عليه وسلم) فتلا القران ودعا الي الله ورغب في الاسلام ثم قال ابايعكم او قال بايعوني قالوا علي اي شء نبايعك يا رسول الله قال بايعوني علي السمع والطاعة في النشاط والكسل والنفقة في العسر واليسر وعلي الامر بالمعروف والنهي عن المنكر وان تقولوا في الله ولا تخافوا لومة لاءم وعلي ان تمنعوني مما تمنعون منه انفسكم وابناءكم وازواجكم فاخذ البراء بن معرور بيده ثم قال والذي بعثك بالحق نبيا لنمنعنك مما نمنع منه العزيز فينا فبايعوا رسول الله (صلي الله عليه وسلم) والعباس اخذ بيد رسول الله يءكد له البيعة علي الانصار وقالوا فنحن والله اهل الحرب والحلقة ورثناها كابرا عن كابر فعرض في الحديث ابو الهيثم بن التيهان فقال يا رسول الله ان بيننا وبين الناس يعني اليهود حبالا وانا قاطعوها فهل عسيت ان نحن فعلنا ذلك ثم اظهرك الله ان ترجع الي قومك وتدعنا فتبسم رسول الله (صلي الله عليه وسلم) ثم قال بل الدم الدم والهدم الهدم وفي رواية المحيا محياكم والممات مماتكم انتم مني وانا منكم احارب من حاربتم واسالم من سالمتم وقال اخرجوا منكم اثني عشر رجلا نقيبا يكونون علي قومهم فاخرجوا اثني عشر نقيبا تسعة من الخزرج وثلاثة من الاوس وقال رسول الله (صلي الله عليه وسلم) للنقباء انتم علي قومكم بما فيهم كفلاء كفالة الحواريين لعيسي ابن مريم قالوا نعم روي عن عاصم بن عمرو بن قتادة ان القوم لما اجتمعوا لبيعة رسول الله (صلي الله عليه وسلم) قال العباس ابن عبادة بن نضلة الانصاري يا معشر الخزرج هل تدرون علي ما تبايعون هذا الرجل قالوا نعم قال انكم تبايعونه علي حرب الاسود والاحمر من الناس فان كنتم ترون انكم اذا نهكت اموالكم مصيبة واشرافكم قتل اسلمتموه فمن الان وهو والله خزي الدنيا والاخرة ان فعلتم وان كنتم ترون انكم وافون له بما دعوتموه اليه علي نهك الاموال وقتل الاشراف فخذوه فهو والله خير الدنيا والاخرة قالوا فانا ناخذه علي مصيبة الاموال وقتل الاشراف فما لنا بذلك يا رسول الله ان نحن وفينا قال الجنة قالوا ابسط



 يدك فبسط يده فبايعوه قال عاصم بن عمرو والله ما قال العباس ذلك الا ليشد العقد لرسول الله (صلي الله عليه وسلم) في اعناقهم وقال عبد الله بن ابي بكر والله ما قال العباس ذلك الا ليءخر القوم تلك الليلة رجاء ان يحضرها عبد الله بن ابي بن سلول فيكون اقوي لامر القوم فالله اعلم اي ذلك كان فبنو النجار يزعمون ان ابا امامة اسعد بن زرارة كان اول من ضرب علي يده وبنو عبد الاشهل يقولون بل ابو الهيثم ابن التيهان قال كعب بن مالك اول من ضرب علي يدي رسول الله (صلي الله عليه وسلم) البراء بن معرور ثم تتابع القوم قال كعب فلما بايعنا رسول الله (صلي الله عليه وسلم) صرخ الشيطان من راس العقبة بانفذ صوت سمعته قط يا اهل الجباجب هل لكم في مذمم والصباة معه قد جمعوا علي حربكم فقال رسول الله (صلي الله عليه وسلم) هذا ازب العقبة وفي رواية ابن ازب العقبة لافرغن لك اي عدو الله ارجعوا الي رحالكم نصركم الله فقال له العباس بن عبادة بن نضلة والذي بعثك بالحق لءن شءت لنميلن غدا علي اهل مني باسيافنا فقال رسول الله (صلي الله عليه وسلم) لم نءمر بذلك ولكن ارجعوا الي رحالكم فرجعنا الي مضاجعنا فنمنا عليها فلما اصبحنا غدت علينا جلة قريش حتي جاءونا في منازلنا فقالوا يا معشر الخزرج انا قد بلغنا انكم جءتم الي صاحبنا هذا فتستخرجونه من بين اظهرنا وتبايعون علي حربنا والله ما من حي من العرب ابغض الينا ان تنشب الحرب بيننا وبينهم منكم قال فانبعث من هناك من مشركي قومنا يحلفون لهم بالله ما كان من هذا شء وما علمناه وقد صدقوا لم يعلموا ثم ان قريشا اتوا عبد الله بن ابي بن سلول فذكروا له ما قد سمعوا من اصحابه فقال وما كان قومي ليتفوتوا علي بمثل هذا وما علمته ثم انهم قالوا لرسول الله (صلي الله عليه وسلم) اتخرج معنا قال ما امرت به قال رزين وقد قيل وقع بين قريش والانصار كلام في سبب خروج النبي (صلي الله عليه وسلم) معهم ثم القي الرعب في قلوب قريش فقالوا ليس يخرج معكم الا في بعض اشهر السنة ولا تتحدث العرب بانكم غلبتمونا فقالت الانصار الامر في ذلك لرسول الله (صلي الله عليه وسلم) ونحن سامعون لامره فانزل الله علي رسوله وان يريدوا ان يخدعوك فان حسبك الله اي ان كان كفار قريش يريدون المكر بك فسيمكر الله بهم فانصرفت الانصار الي المدينة* وفي سيرة ابن هشام قال ونفر الناس من مني فتفتش القوم الخبر فوجدوه قد كان قال ابن اسحاق وخرجوا في طلب القوم فادركوا سعد بن عبادة باذاخر والمنذر بن عمر واخا بني ساعدة ابن كعب بن الخزرج وكلاهما كان نقيبا وقيل ان قريشا بدا لهم فخرجوا في اثارهم فادركوا منهم رجلين كانا تخلفا في امر فردوهما الي مكة المنذر والعباس بن عبادة فادركهما جبير بن مطعم والحارث ابن امية فخلصاهما فلحقا باصحابهما وفي رواية ان الرجلين هما المنذر وسعد بن عبادة فاما المنذر فاعجز القوم ونجا واما سعد فاخذوه وربطوا يديه الي عنقه بشسع رحله ثم اقبلوا به حتي ادخلوه مكة يضربونه ويجذبونه بجمته وكان ذا شعر كثير ثم خلصه منهم جبير بن مطعم والحارث بن امية لانه كان يجير لهما تجارتهما ويمنعهم ان يظلموا ببلده*

  هجرة ابي بكر الي الحبشة

 وفي هذه السنة هاجر ابو بكر الي الحبشة روي انه لما ابتلي المسلمون وكثر ايذاء المشركين واضرارهم استاذن ابو بكر رسول الله (صلي الله عليه وسلم) وخرج نحو ارض الحبشة ولما بلغ برك الغماد لقي ابن الدغنة اسمه ربيعة وهو سيد القارة قال ابن تريد يا ابا بكر فقال ابو بكر اخرجني قومي فاريد ان اسيح في الارض فاعبد ربي فقال ابن الدغنة فان مثلك يا ابا بكر لا يخرج فانك تكسب المعدوم وتصل الرحم وتحمل الكل وتقري الضيف وتعين علي نواءب الحق فانا لك جار ارجع فاعبد ربك ببلدك فرجع ابو بكر في جوار ابن الدغنة ومكث بمكة يعبد ربه في داره ويصلي فيها ويقرا ما يشاء ولا يستعلن بصلاة ولا يقرا في غير داره ثم بدا له فبني مسجدا بفناء داره وكان يصلي فيه ويقرا القران فتنقذف عليه نساء المشركين وابناءهم يعجبون منه وينظرون اليه وكان



 ابو بكر رجلا بكاء لا يملك عينيه اذا قرا القران فافزع ذلك اشراف قريش من المشركين وخافوا ان تفتن نساءهم وابناءهم فارسلوا الي ابن الدغنة ان قل لابي بكر ان يقتصر علي ان يعبد ربه في داره ولا يعلن بالصلاة فانا قد خشينا ان تفتن نساءنا وابناءنا فانهه فان قبل فعل وان ابي الا ان يعلن بذلك فسله ان يرد اليك ذمتك ولسنا مقرين لابي بكر الاستعلان فاتي ابن الدغنة ابا بكر وقال له ما قال له المشركون قال ابو بكر اني ارد اليك جوارك وارضي بجوار الله تعالي والنبي (صلي الله عليه وسلم) يومءذ بمكة*

  (ذكر هجرة اصحابه الي المدينة)

 * قال اهل السير لما ابرم عقد المبايعة بين النبي (صلي الله عليه وسلم) وبين اهل المدينة ولم يقدر اصحابه ان يقيموا بمكة من ايذاء المشركين ولم يصبروا علي جفوتهم رخص لهم في الهجرة الي المدينة* وفي الصحيحين قال (عليه السلام) رايت اني مهاجر من مكة الي ارض بها نخل فذهب وهلي الي اليمامة او هجر فاذا هي المدينة يثرب ووقع للبيهقي من حديث صهيب رايت دار هجرتكم سبخة بين ظهراني حرتين فاما ان تكون هجر او يثرب ولم يذكر اليمامة* قال بعض العلماء اري النبي (صلي الله عليه وسلم) دار هجرته بصفة تجمع المدينة وغيرها ثم اري الصفة المختصة بالمدينة فتعينت ثم اذن النبي (صلي الله عليه وسلم) لاصحابه في الهجرة الي المدينة واقام بمكة ينتظر ان يءذن له في الخروج فتوجه بين العقبتين جماعة منهم ابن ام مكتوم ثم عمار بن ياسر ثم بلال وسعد ابن ابي وقاص ويقال ان اول من هاجر الي المدينة ابو سلمة بن عبد الاسد المخزومي زوج ام سلمة وذلك انه اوذي لما رجع من الحبشة فعزم علي الرجوع اليها ثم بلغه قصة الاثني عشر من الانصار فتوجه الي المدينة فقدمها بكرة وقدم بعده عامر بن ربيعة عشية ثم توجه مصعب بن عمير ليفقه من اسلم من الانصار ثم توالي خروجهم بعد العقبة الاخيرة فخرجوا ارسالا منهم عمر بن الخطاب واخوه زيد ابن الخطاب وطلحة بن عبيد الله وصهيب وحمزة بن عبد المطلب وزيد بن حارثة وعبيدة بن الحارث وعبد الرحمن بن عوف والزبير بن العوام وعثمان بن عفان وغيرهم لم يبق معه (صلي الله عليه وسلم) الا ابو بكر الصديق وعلي بن ابي طالب كذا قال ابن اسحاق وغيره* وفي بعض كتب السير اول من هاجر الي المدينة ابو سلمة بن عبد الاسد المخزومي قبل بيعة العقبة بسنة ثم قدم المدينة بعد ابي سلمة عامر ابن ربيعة مع امراته ليلي ثم عبد الله بن جحش ثم ابو احمد بن جحش ثم تتابع الاصحاب الي المدينة ارسالا* وفي سيرة مغلطاي عن ابن اسحاق ثم عمر بن الخطاب واخوه زيد بن الخطاب وعباس بن ابي ربيعة وطلحة بن عبيد الله وصهيب وزيد بن حارثة وابو مرثد كناز بن الحصين وابنه مرثد وانسة وابو كبيشة وعبيدة بن الحارث واخوه الطفيل وحصين ومسطح بن اثاثة وسويبط وعبد الرحمن بن عوف والزبير ابن العوام وابو سبرة وابو حذيفة بن عتبة وسالم مولاه وعتبة بن غزوان وعثمان بن عفان انتهي وبقي رسول الله (صلي الله عليه وسلم) وابو بكر وعلي بمكة وكان رسول الله (صلي الله عليه وسلم) ينتظر ان يءذن له في الهجرة ولم يتخلف معه بمكة احد من المسلمين الا اخذ وحبس او فتن الا علي بن ابي طالب وابو بكر وابو بكر كثيرا ما كان يستاذن رسول الله (صلي الله عليه وسلم) في الهجرة فيقول له رسول الله (صلي الله عليه وسلم) لا تعجل لعل الله ان يجعل لك صاحبا فرجا ابو بكر ان يكون ذلك الصاحب رسول الله (صلي الله عليه وسلم)* وفي صحيح البخاري تجهز ابو بكر قبل المدينة فقال له رسول الله (صلي الله عليه وسلم) علي رسلك فاني لارجو ان يءذن لي فقال له ابو بكر وهل ترجو ذلك بابي انت وامي قال نعم فحبس ابو بكر نفسه علي رسول الله (صلي الله عليه وسلم) ليصحبه وعلف راحلتين كانتا عنده ورق السمر وهو الخبط اربعة اشهر لتسمنا وينتظر انه (صلي الله عليه وسلم) متي يءمر بالهجرة الي المدينة روي ان ابا بكر راي في المنام في بعض تلك الايام ان القمر نزل من السماء بطحاء مكة ودخل البلد الحرام فاضاءت منه ام القري



 وما حولها ثم صعد الي السماء فنزل المدينة واشرقت ارض يثرب بنوره وكثير من الكواكب تحركت موافقات له ثم ان ذلك القمر مع تلك الكواكب الجمة صعدت الي الهواء وهبطت في حرم مكة وارض يثرب مضيءة بعد كما كانت الا ثلاثماءة وستين بيتا وفي رواية اربعماءة بيت* ولما انتهي ذلك القمر الي البلد الحرام استنار ما حول الحرم ايضا ثم سار القمر نحو المدينة ودخل منزل عاءشة فانشقت الارض وتواري فيها فلما انتبه ابو بكر غلبة البكاء اذ كان ماهرا في معرفة تعبير الرءيا ومشهورا بين العرب بهذا الفن فنظر بنظر الاعتبار في تعبير تلك الرءيا فعلم ان ذلك القمر شمس فلك الرسالة وان تلك الكواكب اللوامع اصحابه واقر باءه الذين يختارون الغربة بموافقته ويهاجرون الي المدينة ورجوع ذلك القمر مع تلك الكواكب الي مكة دليل علي ان فتح مكة سيحصل له ودخوله منزل عاءشة علامة انها تشرف بشرف فراشه في المدينة وانشقاق الارض وتواري القمر فيها مشير الي ان وفاته (صلي الله عليه وسلم) تكون بالمدينة ويدفن في بيت عاءشة فاعتري ابا بكر من هذه الرءية غمان احدهما غم الهجرة من دياره وترك وطنه المالوف والثاني غم مفارقة النبي (صلي الله عليه وسلم) فتفكر في نفسه فقال اما مفارقة النبي (صلي الله عليه وسلم) فامر صعب واما الغربة فلا اباليها اذا كنت معه (صلي الله عليه وسلم) كما قيل

 لو ضمني بيت نمل والحبيب به ~ لكان ذلك لي روض وبستان

 واطيب الارض ما للقلب فيه هوي ~ سم الخياط مع المحبوب ميدان

 وقيل

 رحب الفلاة مع الاعداء ضيقة ~ سم الخياط مع الاحباب ميدان

 فترصد رفاقته وانتظر صحبته (صلي الله عليه وسلم)* ومن تعبيرات ابي بكر ما ذكر في حياة الحيوان ان عاءشة رضي الله عنها رات ثلاثة اقمار سقطن في حجرها فقال لها ابو بكر ان صدقت رءياك فانه يدفن في بيتك ثلاثة من خيار اهل الارض فلما دفن النبي (صلي الله عليه وسلم) في بيتها قال لها ابو بكر هذا احد اقمارك وهو خيرها والله اعلم*

  (ذكر مشاورة قريش في اخراجه او حبسه او قتله واخبار جبريل بذلك اياه (صلي الله عليه وسلم) واذنه له بالهجرة)

 * قال اصحاب السير لما رات قريش ان رسول الله (صلي الله عليه وسلم) اصابوا منعة واصحابا بغير بلدهم ونزلوا دارا ووجدوا مهاجرا قريبا يهاجر اليه بقية اصحابه عرفوا انه قد عزم ان يلحق بهم وسيحميه المدنيون فخافوا خروجه اليهم وحذروا تفاقم امره فاجتمعوا بدار الندوة للمشاورة وهي دار قصي بن كلاب وكانت قريش لا تقضي امرا الا فيها وفيها يتشاورون وحجبوا الناس عن الدخول اليهم لءلا يدخل احد من بني هاشم فيطلع علي حالهم فزعم ابن دريد في الوشاح انهم كانوا خمسة عشر رجلا* وفي المولد لابن دحية كانوا ماءة رجل ولما قعدوا للتشاور تبدي لهم ابليس في صورة شيخ نجدي جليل فوقف علي باب الدار فلما راوه قالوا من الشيخ قال شيخ من اهل نجد سمع بالذي تواعدتم له فحضر معكم ليسمع ما تقولون وعسي ان لا يعدمكم منه راي ونصح* وفي معالم التنزيل سمعت باجتماعكم فاردت ان احضركم ولن تعدموا مني رايا ونصحا قالوا ادخل فدخل معهم وقد اجتمع فيها اشراف قريش من كل قبيلة وفي رواية تبدي لهم الشيطان في صورة شيخ نجدي لابس مرقع وجلس* وفي المواهب اللدنية تمثل لهم الشيطان في صورة شيخ نجدي لانهم قالوا كما ذكره بعض اهل السير لا يدخلن في المشاورة معكم احد من اهل تهامة لان هواهم مع محمد فلذلك تمثل في صورة شيخ نجدي قالوا من الشيخ ومن ادخلك في خلوتنا هذه بغير اذننا قال انا شيخ من قبيلة نجد وجدت وجوهكم مليحة وراءحتكم طيبة اردت ان اسمع كلامكم واقتبس منه شيءا ولقد اعرف مقصودكم وان كنتم



 تكرهون جلوسي معكم فاخرج قالت قريش بعضهم لبعض هذا رجل من نجد لا من مكة فلا يضركم حضوره معكم فشرعوا في الكلام وقال بعضهم لبعض ان هذا الرجل يعني محمدا (صلي الله عليه وسلم) قد كان من امره ما كان وانا والله لا نامن منه الوثوب علينا بمن اتبعوه فاجمعوا فيه رايا فقال ابو البختري ابن هشام* وفي رواية قال هشام بن عمرو رايي ان تحبسوه في بيت وتشدوا وثاقه وتسدوا بابه غير كوة تلقون اليه طعامه وشرابه منها وتربصوا به ريب المنون حتي يهلك فيه كما هلك من الشعراء من كان قبله كزهير والنابغة فصرخ عدو الله الشيخ النجدي فقال بءس الراي رايتم والله لو حبستموه لخرج امره من وراء الباب الي اصحابه فوثبوا وانتزعوه من ايديكم قالوا صدق الشيخ* وقال هشام بن عمرو وفي رواية ابو البختري رايي ان تحملوه علي جمل وتخرجوه من بين اظهركم فلا يضركم ما صنع واسترحتم فقال الشيخ النجدي والله ما هذا لكم براي الم تروا حسن حديثه وحلاوة منطقه وغلبته علي قلوب الرجال بما ياتي به فو الله لو فعلتم ذلك ما امنتم ان يحل علي حي من العرب فيغلب عليهم بذلك من قوله وحديثه حتي يبايعوه ثم يسير بهم حتي يطاكم بهم فقالوا صدق والله الشيخ فقال ابو جهل والله ان لي فيه لرايا ما اراكم وقعتم عليه بعد قالوا وما هو يا ابا الحكم فقال رايي ان ناخذ من كل قبيلة فتي شابا جلدا نسيبا وسيطا فينا ثم نعطي كل فتي سيفا صار ما ثم يعمدون اليه فيضربونه ضربة رجل واحد فيقتلونه فنستريح منه فانهم اذا فعلوا ذلك تفرق دمه في القباءل كلها فلا تقدر بنو عبد مناف علي حرب قومهم جميعا فرضوا منا بالعقل فعقلناه لهم قال الشيخ النجدي القول ما قال هذا الفتي هو اجودكم رايا لا راي لكم غيره* وفي خلاصة الوفاء وصوب ابليس قول ابي جهل لما اختلفوا فيما يفعلون بالنبي (صلي الله عليه وسلم) اري ان يعطي خمسة رجال من خمسة قباءل سيفا سيفا فيضربونه ضربة رجل واحد فيتفرق دمه في هذه البطون فلا يقدر لكم بنو هاشم علي شء فتفرقوا علي راي ابي جهل مجمعين علي قتله فاخبر جبريل بذلك رسول الله (صلي الله عليه وسلم)* وفي سيرة ابن هشام قال ابن اسحاق وكان مما انزل الله في ذلك اليوم وما كانوا اجمعوا له واذ يمكر بك الذين كفروا ليثبتوك او يقتلوك او يخرجوك ويمكرون ويمكر الله والله خير الماكرين وقوله عز وجل ام يقولون شاعر نتربص به ريب المنون قال ابن هشام المنون الموت وريب المنون ما يريب ويعرض منها قال ابو ذءب الهذلي

