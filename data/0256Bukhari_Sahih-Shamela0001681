  [ص: ]
 ، {وللبسنا} [الانعام: ]: «لشبهنا»، {لانذركم به} [الانعام: ]: «اهل مكة» {يناون} [الانعام: ]: «يتباعدون». {تبسل} [الانعام: ]: «تفضح». {ابسلوا} [الانعام: ]: «افضحوا»، {باسطو ايديهم}: «البسط الضرب»، وقوله: {استكثرتم من الانس} [الانعام: ]: «اضللتم كثيرا»، {مما ذرا من الحرث "} [الانعام: ]: «جعلوا لله من ثمراتهم ومالهم نصيبا، وللشيطان والاوثان نصيبا»، {اكنة} [الانعام: ]: «واحدها كنان»، {اما اشتملت} [الانعام: ]: «يعني هل تشتمل الا علي ذكر او انثي، فلم تحرمون بعضا وتحلون بعضا؟» {مسفوحا} [الانعام: ]: مهراقا، {صدف} [الانعام: ]: " اعرض، ابلسوا: اويسوا "، و {ابسلوا} [الانعام: ]: «اسلموا»، {سرمدا} [القصص: ]: «داءما»، {استهوته} [الانعام: ]: «اضلته»، {تمترون} [الانعام: ]: «تشكون»، {وقر} [فصلت: ]: " صمم، واما الوقر: فانه الحمل "، {اساطير} [الانعام: ]: «واحدها اسطورة واسطارة، وهي الترهات»، {الباساء} [البقرة: ]: «من الباس، ويكون من البءس». {جهرة} [البقرة: ]: «معاينة»، {الصور} [الانعام: ]: «جماعة صورة، كقوله سورة وسور» {ملكوت} [الانعام: ]: " ملك، مثل: رهبوت خير من رحموت، ويقول: ترهب خير من ان ترحم "، {وان تعدل} [الانعام: ]: «تقسط، لا يقبل منها في ذلك اليوم»، {جن} [الانعام: ]: «اظلم»، {تعالي} [النحل: ]: " علا، يقال: علي الله حسبانه اي حسابه "، ويقال: {حسبانا} [الانعام: ]: «مرامي»، و {رجوما للشياطين} [الملك: ]، {مستقر} [البقرة: ]: «في الصلب»، {ومستودع} [الانعام: ]: «في الرحم، القنو العذق، والاثنان قنوان، والجماعة ايضا قنوان مثل صنو» و {صنوان} [الرعد: ] 
  باب {وعنده مفاتح الغيب لا يعلمها الا هو} [الانعام: ]
 
    
 حدثنا عبد العزيز بن عبد الله، حدثنا ابراهيم بن سعد، عن ابن شهاب، عن سالم بن عبد الله، عن ابيه، ان رسول الله صلي الله عليه وسلم قال: " {مفاتح الغيب} [الانعام: ] خمس: (ان الله عنده علم الساعة وينزل الغيث ويعلم ما في الارحام وما تدري نفس ماذا تكسب غدا وما تدري نفس باي ارض تموت ان الله عليم خبير) " 
  باب قوله: {قل: هو القادر علي ان يبعث عليكم عذابا من فوقكم او من تحت ارجلكم} [الانعام: ] الاية
 
 {يلبسكم} [الانعام: ]: «يخلطكم من الالتباس»، {يلبسوا} [الانعام: ]: «يخلطوا»، {شيعا} [الانعام: ]: «فرقا»
 
    
 حدثنا ابو النعمان، حدثنا حماد بن زيد، عن عمرو بن دينار، عن جابر رضي الله عنه، قال: لما نزلت هذه الاية: {قل هو القادر علي ان يبعث عليكم عذابا من فوقكم} [الانعام: ]، قال رسول الله صلي الله عليه وسلم: «اعوذ بوجهك»، قال: {او من تحت ارجلكم} [الانعام: ]، قال: «اعوذ بوجهك» {او يلبسكم شيعا ويذيق بعضكم باس بعض} [الانعام: ] قال رسول الله صلي الله عليه وسلم: «هذا اهون  او هذا ايسر » 
  باب {ولم يلبسوا ايمانهم بظلم} [الانعام: ]
 
    
 حدثني محمد بن بشار، حدثنا ابن ابي عدي، عن شعبة، عن سليمان، عن ابراهيم، عن علقمة، عن عبد الله
  [ص: ]
 رضي الله عنه، قال: " لما نزلت: {ولم يلبسوا} [الانعام: ] ايمانهم بظلم قال اصحابه: واينا لم يظلم؟ فنزلت: {ان الشرك} [لقمان: ] لظلم عظيم " 
  باب قوله: {ويونس، ولوطا وكلا فضلنا علي العالمين} [الانعام: ]
 
    
 حدثنا محمد بن بشار، حدثنا ابن مهدي، حدثنا شعبة، عن قتادة، عن ابي العالية، قال: حدثني ابن عم نبيكم، يعني ابن عباس رضي الله عنهما، عن النبي صلي الله عليه وسلم قال: " ما ينبغي لعبد ان يقول: انا خير من يونس بن متي " 
    
 حدثنا ادم بن ابي اياس، حدثنا شعبة، اخبرنا سعد بن ابراهيم، قال: سمعت حميد بن عبد الرحمن بن عوف، عن ابي هريرة رضي الله عنه، عن النبي صلي الله عليه وسلم قال: " ما ينبغي لعبد ان يقول: انا خير من يونس بن متي " 
  باب قوله: {اولءك الذين هدي الله فبهداهم اقتده} [الانعام: ]
 
    
 حدثني ابراهيم بن موسي، اخبرنا هشام، ان ابن جريج اخبرهم، قال: اخبرني سليمان الاحول، ان مجاهدا اخبره، انه سال ابن عباس: افي ص سجدة؟ فقال: «نعم»، ثم تلا: {ووهبنا له اسحاق ويعقوب} [الانعام: ] الي قوله {فبهداهم اقتده} [الانعام: ]، ثم قال: «هو منهم»، زاد يزيد بن هارون، ومحمد بن عبيد، وسهل بن يوسف، عن العوام، عن مجاهد، قلت لابن عباس، فقال: «نبيكم صلي الله عليه وسلم ممن امر ان يقتدي بهم» 
  باب قوله: {وعلي الذين هادوا حرمنا كل ذي ظفر، ومن البقر والغنم حرمنا عليهم شحومهما} [الانعام: ] الاية
 
