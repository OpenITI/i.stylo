ناء مبينا يوم تسليم البناء الي الباءع فان كان المشتري بني بالجص والاجر والساج والذهب فانه يرجع بقيم البناء علي الباءع يوم يسلم الي الباءع فان كان المشتري انفق في البناء عشرة الاف درهم وسكن فيها زمانا حتي خلق البناء وتغير وانهدم بعضه ثم استحقت الدار لم يكن للمشتري ان يرجع علي الباءع الا بقيمته يوم يسلم البناء الي الباءع فان كان المشتري انفق في البناء عشرة الاف درهم ثم الا الجص والاجر والساج ثم استحقت الدار ومثل ذلك يوم الاستحقاق لا يوجد الا بعشرين الفا او اكثر فانه يرجع علي الباءع بقيمة البناء يوم يسلم ولا ينظر الي ما كان انفق فيه * وان استحقت الدار بعد البناء والباءع غاءب والمستحق اخذ المشتري بهدم البناء فقال المشتري ان الباءع قد غرني وهو غاءب قال ابو حنيفة رحمه الله تعالي لا يلتفت الي قول المشتري بل يءمر بهدم البناء ويدفع الدار الي المستحق فان حضر الباءع بعد الهدم لا يرجع المشتري علي الباءع بقيمة البناء انما يرجع عليه اذا كان البناء قاءما فيسلم المشتري البناء الي الباءع فيهدم الباءع وياخذ النقض واما اذا هدمه فلا شء له علي الباءع وان حضر <> الباءع وقد هدم المشتري بعض البناء وبقي بالبعض كان للمشتري ان ياخذ الباءع بقيمة ما بقي من البناء قاءما ويسلمه اليه فيهدم الباءع ما بقي ويكون النقض له وان شاء المشتري نقض كله ويكون النقض له ولا يسلم البناء وهذا كله قول ابي حنيفة وابي يوسف رحمهما الله تعالي في ظاهر الرواية * وروي محمد عن ابي حنيفة رحمهما الله تعالي وهو قول الحسن ان القاضي يبعث من يقوم البناء ثم يقول للمشتري انقضه واحفظ النقض فاذا ظفرت بالباءع فسلم النقض اليه ويقضي لك عليه بقيمة البناء * وذكر الطحاوي رحمه الله تعالي ان المشتري اذا نقض عليه البناء فسلم النقض الي الباءع فانه يرجع علي الباءع بالثمن وبقية البناء مبينا وان لم يسلم النقض الي الباءع لا يرجع الا بالثمن الاول وهذا اقرب علي النظر * رجل اشتري دارا ثم باعها من اخر فبني المشتري الثاني فيها بناء ثم استحقت الدار دون البناء فان المقضي عليه وهو المشتري الثاني يرجع بالثمن علي باءعه وبقيمة البناء والباءع الثاني يرجع بالثمن علي باءعه ولا يرجع بقيمة البناء في قول ابي حنيفة رحمه الله تعالي وعلي هذا اذا اشتري جارية وقبضها فباعها من غيره فولدت من الثاني ثم استحق الجارية فان المشتري الثاني يرجع بالثمن علي باءعه وبقيمة الولد والباءع الثاني لا يرجع علي الباءع الاول بقيمة الولد في قول ابي حنيفة رحمه الله تعالي * وعلي هذا الخلاف اذا اشتري عبدا وباعه من اخر فتداولته الايدي ثم وجد المشتري الاخر به عيبا قديما كالاصبع الزاءدة وقد تعيب العبد عنده بعيب حادث كان له ان يرجع علي باءعه بنقصان العيب وليس للباءع الثاني ان يرجع علي الباءع الاول بالنقصان في قول ابي حنيفة رحمه الله تعالي * رجل اشتري دارا فبني فيها بناء وغاب ثم ان الباءع باعها من رجل اخر ونقض المشتري الثاني بناء الاول وبني فيها بناء اخر ثم جاء المشتري الاول واستحقها فان كان المشتري الثاني بني فيها لالات نفسه فان المشتري الثاني يضمن للمشتري الاول ضمان ما انتقض من بناء الدار العامرة بنقضه بناء الاول ويكون النقض للمشتري الاول ان كان قاءما وان كان المشتري الثاني استهلك ذلك النقض يضمن له قيمة النقض ايضا ويدفع <> المشتري الثاني البناء الذي احدثه وليس للاول ان يمنعه من ذلك ولان البناء الحادث ملك الثاني وان كان الثاني بني البناء الحادث ينقض الاول فان المشتري الثاني يضمن للاول ما قلنا وللاول ان يمسك البناء الثاني وليس للثاني ان يرفعه ولانه البناء الثاني اذا كان ينقض الاول كان ملكا للمشتري الاول فان كان المشتري الثاني زاد في ذلك اعطاه المشتري الاول قيمة الزيادة ولا يعيطه اجر العمل لان العمل لا يتقوم الا بعقد ولم يوجد العقد ام الزيادة عين مال متقوم * وعن ابي يوسف رحمه الله تعالي اذا اشتري دارا فبني فيها بناء ثم استحقت  الدار فنقض المشتري البناء كان للمشتري ان يرجع علي باءعه بالنقصان يقوم الدار مبنيا وغير مبني ويرجع بالنقصان * وكذلك الارض اذا غرسها المشتري ثم استحقت فقلع المشتري الشجر كان له ان يرجع علي باءع بالنقصان * رجل اشتري ارضا فغرس فيها شجرا فنبت الشجر ثم استحقت الارض يقال للمشتري اقلع الشجر فان كان قلعه يضر بالارض يقال المستحق ان شءت تدفع اليه قيمة الشجر مقلوعا ويكون الشجر لك وان شءت فخذه حتي يقل الشجر ويضمن ذلك نقصان ارضك فان خمره بقلع الشجر وقلع المشتري ثم ظفر بالباءع بعد القلع فان المشتري يرجع علي الباءع بالثمن ولا يرجع بقيمة الشجر ولا بما ضمن من نقصان الارض وان اختار المستحق ان يدفع الي المشتري قيمة الشجر مقولعا ويمسك الشجر واعطاه القيمة ثم ظفر المشتري بالباءع فانه يرجع علي الباءع بالثمن ولا يرجع بقيمة الشجر ولا يكون للمستحق ان يرجع علي الباءع ولا علي المشتري بنقصان الارض لانه لما ختار دفع قيمة الشجر صار كان المستحق هو الذي غرس الشجر وهذا كله قول ابي حنيفة وابي يوسف رحمهما الله تعالي * وقال الحسن رحمه الله تعالي القاضي يبعث امينا ليقوم النابت في الارض ثم يقول القاضي للمشتري اقلع الشجر واحفظه حتي ان ظفرت بالباءع فسلمه اليه وتاخذه بقيمة نابته وان لم تستحق الارض حتي اثمر الشجر وبلغ الثمن او لم يبلغ حتي جاء مستحق واستحق الارض وطاب المشتري بقلع الشجر كان له ذل فان كان باءع الارض حاضرا كان للمشتري ان يرجع علي الباءع بقيمة الشجر <> نابتا في الارض ويسلم الشجر قاءما الي الباءع ولا يرجع علي الباءع بقيمة الثمر ويجبر المشتري علي قطع الثمر بلغ الثمر او لم يبلغ ويجبر الباءع علي قلع الشجر وان كان المشتري زرع في الارض حنطة او شيءا من اصناف الرياحين والحبوب والبقول ثم استحقت الارض قال ابو يوسف رحمه الله تعالي يءمر المشتري حتي قلع الزرع ان كان الباءع غاءبا ولا يرجع علي باءع ه بشء وان كن الزرع اضر بالارض فللمستحق ان يضمنه نقصان الارض ثم لا يرجع المشتري علي باءعه الا بالثمن وان كان المشتري قد كري في الارض نهرا او حفر ساقية او قنطرة علي النهر قنطرة ثم استحقت الارض فان المشتري يرجع علي الباءع بالثمن وبقيمة ما احدث في الارض من بناء القنطرة ولا يرجع بما انفق في كري النهر وحفر الساقية ولا في مسناة جعلها من التراب وان جعل المسناة من اجر او لبن او قصب او شء له قيمة فانه يرجع علي باءعه بقيمة ذلك وهو قاءم في الارض ثم يءمر الباءع يقلع ذلك * رجل ورث جارية من ابيه واستولدها ثم جاء مستحق استحقها كان الولد حرا بالقيمة ثم يرج المستولد بثمن الجارية وبقيمة الولد علي من باع من ورثه ويحلف الوارث باءع المورث في ضمان الغرور كما لو وجد بها عيبا كان له ان يرده علي باءع المورث والموصي له بالجارية اذا استولد الجارية ثم استحقت فانه لا يرجع علي باءع الموصي لا بالثمن ولا بقيمة الولد كما لا يردها بعيب وجد بها * رجل اشتري دارا فجاء رجل واستحق العرصة وفيها بناء فقال المشتري للباءع اشتريت منك العرض ثم بنيت البناء ولي حق الرجوع عليك بقيمة البناء بحكم الغرور وقال الباءع لا بل بعتك العرصة والبناء جميعا فليس لك ان ترجع علي بقيمة البناء كان القول فيه قول الباءع لانه منكر حق الرجوع * ولو اشترط الباءع في البيع ضمان ما احدثه المشتري فسد البيع لان المشتري اذا حفر فيها بءرا وما يشبه ذلك لا يكون له ان يرجع بذلك علي الباءع عند الاستحقاق وانما يرجع بالبناء والزرع والغرس فاذا شرط عليه ضمان ما احدثه مطلقا فسد البيع وان قيد الضمان فقال انا ضامن ما احدثه المشتري من بناء او غرس <> او زرع او نحو ذلك جاز ويكون ضامنا * رجل استولد جارية كانت له استحقت فقال المستولد اشتريتها من فلان بكذا وصدقة فلان وكذبه المستحق كان القول قول المستحق لان المشتري يدعي عليه حرية الولد بحكم الغرور وهو ينكر فيكون القول قوله ولو انكر الباءع ذلك وصدقه المستحق كان الولد حرا بالقيمة ولا يرجع احدهما علي الباءع بشء * رجل اشتري جارية وقبضها ووهبها من رجل ثم اشتراها من الموهوب له فولدت له ولدا ثم جاء رجل واستحقها فان المشتري يرجع علي الباءع وهو الموهوب له بالثمن وبقيمة الولد لانه مغرور * رجل اشتري دارا وبني فيها ثم استحق رجل نصفها ورد المشتري ما بقي علي الباءع كان له ان يرجع علي الباءع بالثمن وبنصف قيمة البناء لانه مغرور في النصف ولو استحق منها نصف بعينه فان كان البناء في النصف المستحق خاصة رجع المشتري بقيمة البناء وان كان في النصف الذي لم يستحق كان له ان يرد الباقي ولا يرجعه بشء من قيمة البناء * رجل اشتري جارية فادعاها اخر فاشتراها منه ايضا ثم استحقت الامة وقد ولدت للمشتري ولدا قال محمد رحمه الله تعالي رجع المشتري بالثمنين علي الباءعين فان كانت  ولدت لاكثر من ستة اشهر من وقت البيع الثاني لا يرجع بقيمة الولد علي احدهما * رجل اشتري جارية من صبي غير ماذون او من عبد محجور واستولدها ثم جاء رجل واستحقها كان الولد ثابت النسب من المشتري ويكون رقيقا ولا يكون هذا ولد المغرور والله اعلم {باب ما يدخل في البيع من غير ذكره وما لا يدخل} في الباب فصول خمسة * الاول في الدار والثاني في الحمام والحانوت والثالث في الكرم والنخل والرابع في الارض والخامس في المنقول (اما الاول) رجل اشتري دارا يدخل فيه الطريق من غير ذكر فان لم يكن للدار طريق فاشتراها علي ظن ان لها طريا قد ذكرنا قبل هذا في باب العيوب وان باع دارا وقال بحقوقها ومرافقها او قال بكل قليل وكثير له داخل فيها او خارج عنها كان له الطريق وكذا لو اقر الانسان بدار او صالح علي دار او اوصي بدار ولم يذكر الطريق ولم يذكر بحقوقها ومرافقها لا يدخل فيه الطريق ولو <> اشتري دارا فيها بستان دخل البستان في البيع صغيرا كان البستان او كبيرا فان كان البستان خارجا منه الدار لا يدخل البستان في البيع وان كان له باب في الدار كذا قال ابو سليمان * وقال الفقيه ابو جعفر رحمه اله تعالي ان كان البستان اصغر من الدار ومفتحها الي الدار يدخل في بيع الدار وان كان البستان اكبر من الدار او مصل الدار لا يدخل في بيع الدار والمسالة قد مرت في باب اليمين في الخروج والدخول * رجل باع دارا بكل حق هو لها وفيها رحي الابل فان الرحي ومتتاع الرحا والالة تكون للباءع ولا تكون للمشتري لان الرحا ومتا الرحا ليس من حقوق الدار * ولو باع ضيعة بكل حق هو لها وفيها رحي ماء فان الرحي تكون للمشتري لان ذلك يعد من توابع الضيعة * رجل له دار فيها بيوت باع بعض البيوت بعينها بمرافقها ثم اراد الباءع ان يرفع باب الدار الاعظم وابي المشتري لم يكن للباءع ان يرفع لانه باع بعض البيوت بمرافقها وباب الدار الاعظم من مرافق البيوت وكذا لو باع بعض البيوت بمرافقها وحقوقها * ولو باع بيتا بعينه من منزل بحقوقه وحدوده فاراد المشتري ان يدخل المنزل وصاحب المنزل يمنعه عن الدخول ويامره بفتح الباب الي لسكة فان كان الباءع بين للبيت الذي باعه طريقا معلوما في المنزل ليس له ان يمنعه عن الدخول في المنزل وان لم يبين له طريقا معلوما اختلف المشايخ فيه قال بعضهم له ان يمنعه عن الدخول وليس له ان يمنعه عن المرور في السكة وقال بعضهم ليس له ان يمنعه عن الدخول في المنزل وهو الصحيح لان عند ذكر الحقوق والمرافق يدخل الباب الاعظم فيما اذا باع بعض البيوت فههنا يدخل الطريق في المنزل * رجل له دار كان لها في القديم طريق فسد ذلك الطريق وجعله لها طريقا اخر ثم باعها بحقوقها كان للمشتري الطريق الثاني دون الاول لان ذكر الحقوق في البيع فيدخل فيه ما كان له طريق وقت البيع * رجل باع دارا احد حدودها سور الجاهلية يقال له سور المدينة ولا يدري لانه كان ملكا في الاصل او لم يكن والسور في وسط المدينة وداخلها وخارجها دور كثيرة فذكر في البيع ثلاثة حدود علي الوجه الصحيح وذكر الحد الرابع دور الجيران التي وراء السور وقبض الثمن وسلم الدار الي المشتري <> فمات الباءع وادعي ورثته فساد البيع بحكم ادخال السور في البيع فادعي المشتري ان السور له وعند الناس هو مشهور بسور المدينة * قالوا ههنا فتوي وحكم في الحكم لا يجوز هذا البيع لان مثل هذا الحاءط لا يكون من حيطات الدار وادخاله في البيع يكون مفسدا للبيع وان كان مثل هذا الحاءط قد يكون من حيات الدور والقصور كان ذلك للمشتري لانه في يده واما في الفتوي ان اضاف البيع علي هذه الدار مشاهدة او اشار الي الدار وهما قد عرفاها جميعا جاز البيع فيما بينهما وبين الله تعالي * رجل باع دارا ليس فيها بناء وفيها مخرج وبءر مطوي بالاجر وغيره كلها متصلة بالبءر دخل الكل في البيع لانها داخلة في الحدود فكانت داخلة في البيع وان باع دارا فيها بءر وعليها بكرة وحبل ولو فان باعه الدار بمرافقها يدخل الدلو والحبل لانهما من المرافق وان لم يقل بمرافقها لا يدخل الدلو والحبل وتدخل البكرة في البيع علي كل حال لانهال مركبة بالبءر * اشتري دارا واختلفا في باب الدار فقال الباءع هو لي وقال المشتري لا بل هو لي ان كان الباب مركبا متصلا بالبناء كان القول قول المشتري سواء كانت الدار في يد الباءع او في او في يد المشتري لان ما كان مركبا يكون من جملة الدار وان لم يكن الباب مركبا وكان مقلوعا فان كانت الدار في يد الباءع كان القول قوله وان كانت في يد المشتري كان القول قول المشتري لان الباب اذا لم يكن مركبا يكون بمنزلة المتاع الموضوع في الدار ولا يكون من جملة الدار فيكون القول فيه قول صاحب اليد ينج رجل اشتري دارا فوجد في جذعها دراهم ان قال الباءع هي لي كانت له ويردها المشتري عليه لانها وصلت الي المشتري من يد الباءع وان قال الباءع ليست لي  كانت بمنزلة اللقطة * رجل له علو وسفل فقال لرجل بعت منك علو هذا السفل بكذا جاز البيع ويكون سطع السفل لصاحب السفل وللمشتري حق القرار عليه وكذا لو انهدم هذا العلو كان للمشتري ان يبني عليه علوا اخر مثل الاول لان السفل اسم لمبني مسقف فكان سطح السفل سقفا للسفل * ويدخل في بيع الدار السترة الي تكون علي السطح كانت من اجر او خشب لانها مركبة في الدار فتدخل في بيع الدار ويدخل السلاليم <> في بيع البيت والدار ان كانت مركبة لانها من جملة الدار فان لم تكن مركبة اختلفوا فيه والصحيح انها لا تدخل ومفتاح البيت والدار يدخل في البيع استحسانا والقياس ان لا يدخل * والغلق يدخل قياسا واستحسانا لانه مركب وان كان باب البيع والدار مقفلا لا يدخل القفل في البيع والتنور تدخل في بيع الدار ان كانت مركبة وان لم تكن مركبة لا تدخل * والاجار اي السطح يدخل فيبيع الدار سواء كان من قصب او من لبن لانه مركب ولا يدخل في بيع البيت كما لا يدخل فيه العلو * بيت له علو وسفل فقال رجل اشتريت منك هذا البيت ولم يزد عليه لا يدخل فيه العلو وكذا لو قال بكل حق هو له الا ان يقول اشتريت منك هذا البيت مع البيع الذي في علوه * ولو اشتري دارا يدخل فيها علوها وسفلها وان لم يقل بحقوقها ومرافقها * وان اشتري منزلا ان قال اشتريت منك هذا المنزل لا يدخل فيه علوه ولو قال اشتريت منك هذا المنزل بكل حق هو له يدخل فيه العلو وان لم يقل بكل حق هو له لا يدخل فيه العلو قالوا هذا في عرفهم اما في عرفنا العلو يدخل في البيع من غير ذكر الحقوق في المساءل الثالث لان هفي عرفنا كل مسكن يسمي خانة صغيرا او كبيرا * ولو اشتري دارا لها ظلة يعني ساباطا احد جانبيه علي الدار والاخر علي اسطوانات في السكة او علي دار الجار الذي يقابله ان اشتري الدار بكل حق هو لها تدخل الظلة في البيع وان لم يقل بكل حق هو لها لا تدخل الظلة في قول ابي حنيفة رحمه الله تعالي وقال صاحباه تدخل الظلة في البيع ان كان مفتحها في الدار وان لم يكن مفتحها في الدار لا تدخل الظلة في بيع الدار في قولهم الا بذكر الظلة والكنيف الشارع في الدار يدخل في بيع الدار وان لم يذكر الحقوق والمرافق * دار لها طريقان احدهما الي الشارع والاخر خاص في دار رجل اخر فباع الدار ان لم يقل بكل حق هو لها لا يدخل فيه الطريق الخاص وان قال بكل حق هو لها يدخل فيه الطريقان الطريق الظاهر لكونه الي الشارع والاخر بذكر الحقوق * ولو اشتري دارا <> فيها مطبخ ومخرج ومربط وبءر ماء ولم يذكر الحقوق والمرافق دخل الكل في البيع وان اشتري منزلا لا يدخل فيه المربط والمخرج وبءر الماء وان قال بكل حق هو له ما لم يذكر هذه الاشياء وذكر المرافق في هذه المساءل كذكر الحقوق والقرية مثل الدار فان كان في القرية وفي الدار والمرافق فلا تدخل في البيع كما لا يدخل فيه المتاع الموضوع وكذا لو اشتري دارا وقال بكل قليل او كثير هو فيها او منها لا يدخل شء مما ذكرنا في البيع لان المراد من قوله هو فيها او منها ما كان متصلا بها وهذه الاشياء غير متصلة بالدار * ولو اشتري بيت الرحي بكل حق هو له او بكل قليل او كثير هو فيه ذكر محمد رحمه الله تعالي في الشروط ان له الحجر الاعلي والاسفل وكذا لو كان فيه قدر نحاس موصولا بالارض وقيل الحجر الاعلي لا يدخل في البيع نجح درب بين خمسة نفر باع احدهم نصيبه من الطريق قال ابو حنيفة رحمه الله تعالي ليس لاصحاب السكة او يبيعوها فان اجتمعوا علي بيع هذه السكة وقسمتها امنعوا من ذكرك لان للناس حقا في هذه السكة فان الطريق الاعظم اذا كثر فيها الزحام كان للناس ان يدخلوا هذه السكة التي هي غير نافذة حتي يقل الزحام ومن العلماء من قال اذا باع واحد من اصحاب السكة نصيبه من الطريق الذي هو غير نافذ يجوز البيع وليس للمشتري ان يمر في هذا الطريق الا ان يشتري دارا كانت للباءع في هذه السكة * رجل اشتري دارا بابها في الشارع وظهر الدار الي السكة غير نافذة وللمشتري في هذه السكة دار اخري ليس للمشتري ان يجعل للدار المشتراة طريقا في هذه السكة فان رضي بذلك جميع اهل السكة الا واحدا كان لهذا الواحد ان يمنعه عن ذلك وان رضي الكل كان ذلك اعارة ويكون لهم ان يرجعوا وكذا لو رجع واحد كان لهذا الواحد ان يمنعه عن ذلك * زقيقة فيها داران لرجلين لكل واحد منهما دار اراد احدهما ان يغلق بابا علي راس السكة كان للاخر ان يمنعه ولو رفع احدهما الباب القديم ثم وضعه ليس <> للاخر ان يمنعه * رجل باع دارا بجميع حقوقها والدار في السكة نافذة وباب هذه الدار في القديم كان في سكة غير نافذة الا ان صاحب الدار قد سد بابه القديم فاراد المشتري ان يفتح بابه القديم ومنعه جيران السكة عن ذلك ذكر محمد رحمه الله تعالي في النوادر فقال ان اقر هل تلك السكة ببابه القديم كان له ان يفتح  بابا في هذه السكة وان شاء يفتح بابين او اكثر وان جحد اصاب السكة كان القول قول اصحاب السكة مع ايمانهم اذا لم يكن له بينة علي ذلك وان نكلوا صاروا مقرين فيثبت له الطريق وان حلف واحد من اهل تلك السكة ليس له ان يفتح باب في السكة وسقط اليمين عن الباقين وان نكل واحد كان له ان يحلف الثاني فان نكل الثاني كان له ان يحلف الثالث وهكذا فان نكل الكل غير واحد منهم ليس له ان يفتح بابا لحق هذا الواحد وان كانت السكة واسعة فاقر بعضهم بحق المدعي وجميع انصباءهم يجعل انصباءهم في ناحية ويجعل لهذا المدعي طريقا في ذلك الجانب * دار لرجل فيها ابيات فباع بعض الابيات بمرافقها ثم اراد الباءع ان يمنع المشتري عن الدخول من باب الدار قال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي ليس له ذلك لانه باع بعض الابيات بمرافقها وباب الدار من مرافقها وكذا لو قال بمرافقها من حقوق لان بقوله من حقوقها دخل الطريق في البيع فاذا دخل الطريق في البيع دخل الباب لان الباب منصوب علي الطريق * ولو باع بيتا من منزل بحدوده وحقوقه وصاحب المنزل يمنعه عن الدخول ويامره بفتح الباب الي السكة قال الشيخ الامام هذا ان بين صاحب المنزل له طريقا معلوما لم يكن له ان يمنعه عن الدخول وان لم يبين كان له ان يمنعه ويفتح المشتري لبيته الذي اشتراه بابا الي السكة وليس له ان يفسخ البيع وقوله بحقوقه ينصرف الي حقوق هذا البيت في السكة * رجل وضع راس خشبة علي حاءط جاره او حفر سردابا تحت دار جاره ثم ان جاره باع تلك الدار وطلب المشتري رفع الخشب والسرداب قال بعض العلماء للمشتري ان يفعل ما كان لباءع ان يفعل الا ان يشترط في البيع تركه فليس للمشتري ان يغير شيءا من ذلك * رجل باع دارا وللاخر فيها مسيل <> ماء فرضي صاحب المسيل ببيع الدار قالوا ان كان له رقبة المسيل كان لصاحب المسيل حصته من الثمن وان كان له حق جري الماء فقط فلا قسط لصاحب المسيل من الثمن وبطل حقه اذا رضي بالبيع كمن اوصي بسكني داره لرجل فبيعت الدار ورضي الموصي له بالبيع بطلت وصيته ولو لم يبع الدار ولكن قال صاحب المسيل ابطلت حقي في المسيل بطل حقه ان كان له حق جري الماء فقط وان كان له الرقبة لا يبطل حقه لان قوله ابطلت حقي لا يزيل ملكه * حاءط مشترك بين رجلين ولاحدهما في بيته ثلاث طاقات من اللبين وراس الطاقات علي هذا الحاءط المشترك فباع صاحب الطاقات داره من رجل ثم اراد المشتري ان يرفع الطاقات ويضع مكانها سطحا من الخشب قال ابو القاسم ان كان ثقل الثاني مثل الاول او اقل وضرره كذلك ليس للجار ان يمنعه وان كان ثقل الثاني اكثر من الاول كان له ان يمنعه الا ان يضع الجار علي الحاءط مثل ما وضع هو فيستويان في الحمل * زقيقة غير نافذة لاقوام ففتح جار لهم بابا من داره في سكة اخري في هذه السكة باذن اهلها ورضاهم ثم اشتري رجل اخر دارا في تلك الزقيقة عن فتح ذلك الباب قال الشيخ امام ابو بكر محمد بن الفضل رحمه الله تعالي للمشتري ان يمنع الجار عن المرور في هذه الزقيقة وليس له ان يامره برفع الباب * دار بين رجلين باع احدهما نصفا شاءعا من بيت معين من هذه الدار لرجل قال ابو حنيفة رحمه الله تعالي لا يجوز البيع لان شريكه يتضرر بذلك عند القسمة وكذا لو كان بين الورثة دار مشتملة علي بيوت فباع احدهم بيتا من تلك الدار لا يجوز ولو كان بين رجلين عشرة اغنام او عشرة اثواب هروية فباع احدهما من ثوب معين نصفا شاءعا من رجل جاز البيع وهذا لا يشبه الدار ولو كان بينهما ارض ونخل فباع احدهما نصف شجرة بعينها لا يجوز * امراة لها حجرتان ومستراح احدي الحجرتين في الحجرة الاخري ومفتح المستراح وراسه من الحجرة الثانية فباعت الحجرة التي فيها المستراح وليس راس المستراح فيها ثم باعت بعد ذلك الحجرة الاخري التي راس <> المستراح فيها وقد كتبت لكل واحد منهما صكا قال ابو بكر البلخي رحمه الله تعالي ان كانت كتبت في الصك الاول انه اشتراها بسفلها وعلوها ولم تكتب فيه دون المستراح الذي راسه في الحجرة الاخري فالمستراح في هذه الحجرة لمشتريها علي حاله وان كان المكتوب في الصك الاول دون المستراح الذي راسه في الحجرة الاخري فلمشتري الحجرة الاولي ان يرفع المستراح عن حجرته او يسد مفتحه والمشتري الثاني بالخيار ان شاء اخذ حجرته بحصتها من الثمن وان شاء ترك وان كانت الباءعة شرطت له بالمستراح في البيع * رجل باع ثلثي كرمه من رجل علي ان لا يكون له الطريق في الثلث الباقي وكتب في الصك وطرقه التي هي له قال الشيخ امام ابو بكر البلخي ان اتفق المتبايعان علي انهما شرطا في البيع ان لا يكون له طريق في هذا الثلث كان كذلك وان انكر الباءع الطريق كان القول قول المشتري وله ان يمر فيه رجل اشتري حجرة سطحها مع سطح جاره يستويان فاخذ المشتري جاره حتي يتخذ حاءطا بينه وبين الجار  قالوا ليس له ذلك لان انسان لا يجبر علي البناء في ملكه ولو اراد ان يمنع جاره من صعود السطح حتي يتخذ سترة قالوا ان كان في صعوده يقع بصره في دار الجار كان له ان يمنع وان كان لا يقع بصره في داره لكن يقع عليهم اذا كانوا علي السطح لا يمنعه عن الصعود لانه كما يتضرر هو يتضرر الاخر * رجل له في داره شجرة فرصاد فباع اغصانها ولو ارتقاها المشتري يقع بصره علي عورات الجار قالوا يرفعه الجار الي القاضي والمختار فيه ان يخبرهم وقت الارتقاء في اليوم مرة او مرتين حتي بستروا انفسهم مراعات للحقين جميعا فان لم يفعل ذلك يرفعه الجار الي القاضي فان راي القاضي ان يمنعه عن الصعود والارتقاء فعل * رجل باع ضيعة فيها اغصان اشجار الجار متدلية كان للمشتري ان ياخذ الجار بتفريغ الضيعة عن اغصان اشجاره لان المشتري يقوم مقام الباءع فيما كان للباءع وكان للباءع ذلك فيثبت للمشتري وكذا لو مات صاحب الضيعة كان لوارثه ان ياخذ الجار بازالة الضرر وتفريغ الضيعة عن الاغصان * رجل استاذن جارا له في وضع جذوع له علي حاءط الجار او في حفر سرداب تحت داره فاذن له بذلك ففعل ثم ان الجار باع داره وطلب المشتري رفع الجذوع والسرداب كان له ذلك الا اذا شرط في البيع ترك ذلك فحينءذ لا يكون للمشتري ان يطلب ذلك * رجل له دار ان في سكة غير نافذة اسكن كل واحدة منهما رجلا فبيني احد الساكنين ساباطا ووضع خشبة علي حاءط الدار التي هب فيها وعلي حاءط الدار التي يسكنها الساكن الاخر وجعل باب الساباط الي الدار التي هو فيها لا غير ورب الدار يعلم ذلك ثم ان الباني طلب من رب الدار ان يبيع منه هذه الدار التي هو فيها فباعه بحقوقها ومرافقها ثم طلب الساكن الثاني من الباءع ان يبيع منه الدار التي هو فيها كذلك فباع ثم اختصم المشتريان فاراد المشتري الثاني ان يرفع خشب الساباط عن حاءطه كان له ذلك لان الباني وان بني الساباط باذن صاحب الدار لم يصر ذلك من حقوق الدار فلا يستحق بالبيع <> * رحل احدث بناء او غرفة علي سكة غير نافذة ورضي بها اهل السكة فجاء رجل من غير اهل السكة اشتري دار من هذه السكة كان للمشتري ان يامر صاحب الغرفة برفع الغرفة * رجل اشتري ارضا بمجاريها ثم اشتري ماء فاراد ان يجري الماء في ذلك المجري الي ارضه ان اراد ان يجري فيه الماء م نهر قرية اخري لا يجوز في قولهم وان اراد ان يجري من نهر هذه القرية اختلفوا فيه قال محمد بن سلمة رحمه الله تعالي له ذلك والمختار انه ليس له ذلك وهو قول العامة لان بهذا يزداد مقدار شرب هذه الارض فلا يجوز * اذا طلب المشتري من الباءع ان يكتب له صكا للشراء وابي الباءع ذلك لم يجبر عليه لانه ليس عليه ان يكتب بمال نفسه صكا وطلب من الباءع ان يخرج الي الشهود ليشهدهم لا يجبر الباءع علي ان يخرج وان جاء المشتري بشهود الي الباءع وطلب منه ان يشهدهم فامتنع الباءع عن ذلك فان المشتري يرفع الامر الي القاضي فان اقر الباءع عند القاضي له سجلا ويشهد الشهود علي ذلك ولب منه ان يشهدهم فامتنع الباءع عن ذلك فان المشتري يرفع الامر الي القاضي فان اقر الباءع عند القاضي له سجلا ويشهد الشهود علي ذلك وان طلب المشتري من الباءع الصك القديم ولم يعطه لا يجبر عليه فان احتاط المشتري يكتب من صك الباءع لنفسه صكا مثل ذلك ويثبت فيه اسامي الشهود الذين نزلوا خطوطهم في الصك القديم حتي لو جاء الباءع الاول يوما وجحد البيع او جاز وارثه واراد ان ياخذ المبيع من يدي المشتري سيعرف المشتري شهود البيع فيستشهده ويدفع الخصومة فان كان شهود الصك القديم اثنين او ثلاثة يكتب شهادتهم ويامرهم بالاشهاد علي شهادتهم فان الاشهاد علي الشهادة من غير عذر بالشهود جاءز فان ابي الباءع ان يعرض الصك القديم ليكتب المشتري من ذلك صكا هل يجبر الباءع علي ذلك اختلفوا فيه قال الفقيه ابو جعفر في مثل هذا انه يجبر عليه * حكي ان رجلا اشتري ضيعة ثم غصبها الباءع وجحد البيع وكان صك البيع وديعة عند رجل اودعه رجل غير المشتري فجاء المشتري الي شهود البيع وطلب منهم الشهادة علي البيع فقالوا الا نشهد حتي نري خطوطنا وجاء المشتري الي الذي في يده الصك وطلب منه الصك فابي المودع ان يدفع اليه وقال اودعنيه غيرك فلا ادفع اليك فتحير المشتري ورجع الي اءمة زمانه فاختلفوا في ذلك قال بعضهم يجبر المودع علي دفع الصك اليه صيانة الحق المشتري قال بعضهم لا يجبر المودع لانه اودعه غيره وقال الفقيه ابو جعفر رحمه الله تعالي يءمر المودع ان يعرض الصك علي الشهود حتي يروا خطوطهم ولا يدفع الي المشتري فاخذ العلماء بقوله لان فيه صيانة حق المشتري من غير ان يتضرر به غيره فكذلك المشتري اذا طلب من الباءع ان يعرض الصك القديم ليكتب من ذلك صكا * وههنا مسالة اخري الشاهد اذا امتنع عن اداء الشهادة هل يسعه ذلك قالوا ان كانوا صاحب الحق يجد سواه شاهدين يقبل القاضي شهادتهما لا باس  للشاهد ان يمتنع عن اداء الشهادة وان كان لا يجد شاهدين <> يقبل القاضي شهادتهما لا يحل له ان يمتنع عن اداء الشهادة وان كان المدعي يجد سوي هذا الشاهد شاهدين يقبل القاضي شهادتهما الا ان شهادة هذا الشاهد عند القاضي تكون اسرع قبولا من شهادة غيره لا يسعه ان يمتنع عن اداء الشهادة * دار لها طريق ومسيل ماء الي دار الجار فباع صاحب الدار داره مطلقا ولم يقل بحقوقها ولا بمرافقها ولا بكل قليل وكثير هو لها لم يدخل الطريق والمسيل الذي كان في دار الجار في رواية الاصل وفي نوادر ابن سماعة يدخل مسيل الماء في البيع ولا يدخل الطريق الذي في سكة غير نافذة * وقال الحسن بن زياد رحمه الله تعالي اذا باع بكل قليل وكثير هو له فيها ولم يقل منها يدخل في البيع العبيد والجواري وما كان فيها من الحيوانات ولا يدخل الاحرار وقال زفر رحمه الله تعالي يدخل في الاحرار ايضا وفسد البيع ولو قال منها لا يدخل وفي رواية هشام لا يدخل شء في ذلك * رجل اشتري دارا ولم يقل بحقوقها وليس لها طريق ذكر الناطفي ان له الخيار ان شاء اخذ وان شاء ترك وقد مرت المسالة قبل هذا {فصل فيما يدخل في بيع الحمام والحانوت} * رجل باع حانوتا وذكر الحقوق والمرافق او لم يذكر يدخل فيه الواح الحانوت وان لم يذكر * ولو باع الحانوت بمرافقه وللحانوت ظلة كما تكون للحوانيت في الاسواق يدخل فيه الظلة وان لم يذكر المرافق لا تدخل ولا يدخل القفل في بيع الحانوت والدور والبيوت وان كان الباب مقفلا ذكر الحقوق والمرافق الم يذكر ويدخل فيه مفتاح الغلق استحسانا * ولو باع الحداد حانوته يدخل كور الحداد مركب متصل وكور الصاءغ لا يكون مركبا ولا متصلا بالمبيع وزق الحداد الذي ينفخ فيه لا يدخل وكذلك قدر القصار الذي يطبخ فيه الثوب لا يدخل في البيع لانه ليس بمركب متصل ولا من الحقوق ايضا لان حق الشء ما يكون متصلا به ومقلاة السواقين التي يقلي فيها السواقين التي يقلي فيها السويق من الحديد او من النحاس لا تدخل في البيع لانها ليست من جملة المبيع * وقصاع الحمام لا تدخل في البيع وان ذكر المرافق لانها منفصلة عن الحمام {فصل فيما يدخل في مبيع الكرم والاراضي وما لا يدخل} * رجل باع ارضا فيها زرع ولم يذكر الحقوق والمرافق لا يدخل الزرع في البيع من غير ذكر قال الشيخ الامام ابو بكر محمد بن الفضل رحمه لله تعالي هذا اذا صار الزرع متقوما فان لم يكن متقوما يدخل الزرع من غير ذكر قال وانما يعرف قيمته ان تقوم الارض مبذورة وغير مبذورة فان كانت قيمتها مبذورة اكثر من قيمتها غير مبذورة علم انه صار متقوما وان كانت قيمتها مبذورة مثل قيمتها غير مبذورة علم انه لم يصر متقوما فيدخل في البيع من غير ذكر كما يدخل اوراق الشجر والصحيح ما ذكر في ظاهر الرواية وذكر محمد رحمه الله تعالي في النوادر اذا باع ارضا مبذورة بكل حق هو لها لا يدخل الزرع في البيع وكذر الفقيه ابو الليث رحمه الله تعالي <> اذا بذر ارضه ولم يصر له قيمة لا يدخل في البيع المطلق كما قال محمد رحمه الله تعالي في النوادر وكذا لو باع الارض بعد القاء البذر قبل النبات لا يدخل الزرع في البيع ولا يدخل الشرب والطريق في بيع الارض مطلقا ويدخل في الاجارة والقسمة والرهن والوقف * رجل اشتري ارضا فيها اشجار ولم يذكر شيءا دخل الاشجار المثمرة في البيع واختلفوا في غير المثمرة والصحيح انها تدخل * ولو باع ارضا فيها اشجار صغار تحول في فصل الربيع وتباع فان كانت تقلع من اصلها تدخل في البيع وتكون للمشتري وان كانت تقلع من وجه الارض لا تدخل في البيع من غير شرط * رجل اشتري ارضا فيها رطبة او زعفران او خلاف يقطع في كل ثلاث سنين او رياحين او بقول ولم يذكر في البيع ما فيها قال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي ما علامتها علي وجه الارض يكون بمنزلة الثمر لا يدخل في البيع من غير شرط وما كان من اصولها في الارض يدخل في البيع لن اصولها تكون للبقاء بمنزلة البناء وكذا اذا كان فيها قصب او حشيش او اصولها في الارض يدخل في البيع لان اصولها تكون للبقاء بمنزلة البناء وكذا اذا كان فيها قصب او حشيش او حطب نابت ما هو علي وجه الارض لا يدخل في البيع من غير ذكر وما اصولها في الارض يدخل واختلفوا في قواءم الخلاف قال بعضهم تدخل لانها شجر والمختار انها لا تدخل لانها تعد من الثمر * وان كان في الارض شجر قطن فبيعت الارض لا يدخل ما عليها من القطن * واختلفوا في اصل القطن وهو الشجر والصحيح انه لا يدخل في البيع وان كان في الارض كراث فبيع الارض مطلقا فما كان علي ظاهر الارض لا يدخل في البيع المطلق واختلفوا فيما كان مغيبا منه في الارض والصحيح انه يدخل لانه يبقي سنين فيكون بمنزلة الشجر * واما قواءم الباذنجان قال الشيخ الامام شمس الاءمة السرخسي انها تدخل في  البيع المطلق من غير ذكر وقال الشيخ الامام المعروف بخواهرزاده ينبغي ان يكون علي الاختلاف الذي ذكرنا في قواءم شجر القطن * ولو باع الارض وقال بمرافقها لا يدخل الزرع والثمر في البيع في ظاهر الرواية وعن ابي يوسف رحمه الله تعالي انه يدخل ولو قال بكل قليل او كثير هو له فيها او منها يدخل ما كان فيها من الزرع والثمر ولا يدخل فيه الطريق والشرب وان كان فيها زروع قد حصلت وثمار قد صرمت وقال بكل قليل او كثير هو له فيها ومنها لا دخل ذلك ف البيع ولو قال بكل قليل او كثير هو له فيها او منها او من حقوقها لا يدخل فيه الزرع والثمر * ولو اشتري ارضا فيها اشجار وعليها ثمار وقال في البيع بثمارها وان شاء ترك وذكر في بعض الكتب انه لا يخير في قول ابي حنيفة رحمه الله تعالي كما لو اشتري شاة بعشرة فولدت الشاة عند الباءع ولدا قيمته خمسة فاكله الباءع قال ابو حنيفة رحمه الله تعالي يلزمه الشاة بخمسة دراهم ولا خيار له والصحيح ان في مسالة الثمار يخير <> لانه لما قال بثمارها صار الثمر مبيعا مقصودا فاذا اكل الباءع تفرقت عليه الصفقة فيخير * ولو كان في الارض زرع فباع الارض بدون الزرع او الزرع بدون الارض جاز وكذا لو باع نصف الارض بدون الزرع وان باع نصف الزرع من اجنبي بدون الارض لا يجوز وكذا لو باع رب الارض نصف الزرع من المزارع لا يجوز وان باع المزارع نصيبه من رب الارض جاز * ولو باع احدهما نصيبه من اجنبي لا يجوز * رجل امر غيره ببيع ارض فيها اشجار وباع الوكيل الارض باشجارها فقال الموكل ما امرته ببيع الاشجار قال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي القول قول الموكل والمشتري ياخذ الارض بحصتها من الثمن ان شاء وكذا لو كان مكان الاشجار بناء * رجل اشتري ارضا بشربها وللباءع في القناة التي يسقي منها الارض بحصتها من الثمن ان شاء وكذا لو كان مكان الاشجار بناء * رجل اشتري ارضا بشربها وللباءع في القناة التي يسقي منها الارض ماء كثير ذكر في النوادر انه يقضي للمشتري من الماء بقدر ما يكفي هذه الارض فيكون ذلك شراء مع الارض * رجل اشتري ارضا الي جنبها اقذف وبين الاقذف والارض مسناة عليها الاشجار وجعل حدود الارض في البيع الاقذف كانت المسناة وما عليها من الاشجار للمشتري * رجل باع ارضا بشربها جاز البيع وان لم يبين مقدار الشرب لان الشرب تبع للارض فاذا كانت الارض معلومة فجهالة التبع لا تمنع الجواز * ولو اشتري نخلة بطريقها في الارض ولم يبين موضع الطريق وليس لها طريق معروف في ناحية معلومة قال ابو يوسف رحمه الله تعالي يجوز البيع وياخذ للنخلة طريقا من اي نواح شاء لانه لا يتفاوت فان كان متفاوتا لا يجوز البيع * رجل باع كرما بمجري ماءه وبكل حق هو له ومجري ماءه في سكة غير نافذة بينه وبين رجلين وعلي ضفة النهر اشجار فان كانت رقبة المجري ملكا للباءع كانت الاشجار للمشتري لان رقبة المجري دخلت في البيع فتدخل الاشجار تبعا للرقبة فان لم تكن رقبة المجري ملكا للباءع بل كان له حق مسيل الماء فان الاشجار تكون للباءع هذا اذا كان الغارس هو الباءع او لم يكن الغارس معلوما فان كان الغارس غير الباءع كانت الاشجار للغارس * رجل اشتري كرما فيها اشجار الفرصاد وشجر الورد وعلي شجر الفرصاد توت واوراق وعلي شجر الورد ورد وقال بكل حق هو له لا يدخل التوت واوراق الفرصاد في البيع وكذلك الورد لانه بمنزلة الثمر * رجل اشتري شجرة بشرط ان يقلها تكلموا في جوازه والصحيح انه يجوز وللمشتري ان يقلعها من اصلها وان اشتري الشجرة بشرط القطع قال بعضهم ان بين موضع القطع او كان موضع القطع معلوما عند الناس جاز البيع والا فلا وقال بعضهم يجوز البيع علي كل حال وهو الصحيح وله ان يقطعها من وجه الارض فاما عروقها في الارض لا يكون الا بالشرط واذا جاز البيع هل يدخل في البيع ما تحتها من الارض ان اشتراها بشرط القطع لا تدخل وان اشتراها بشرط القلع او اشتراها مطلقا قال ابو يوسف رحمه الله تعالي تدخل الشجرة بعروقها ولا يدخل قي البيع ما تحتها من <> الارض وقال محمد رحمه الله تعالي يدخل من الارض مقدار ما تستقر عليه الشجرة ولا يدخل مقدار طول العروق واجمعوا علي ان في القسمة والاقرار بالشجرة والوصية بالشجرة وهبة الشجرة يدخل من الارض مقدار ما تستقر عليه الشجرة ولا يدخل مقدار متتنا هي اليه العروق والاغصان وفي الموضع الذي يدخل الارض انما يدخل مقدار غلظ الشجرة وقت هذه انتصر فات حتي اذا زاد غلظ الشجرة بعدها كان لصاحب الارض ان يامره بنحت الزيادة * وان اشتري شجرة للترك ولاجل الثمر ورضي به الباءع جاز ولو اشتري الة صغيرة وتركها باذن الباءع حتي كبرت وصارت عظيمة كان للباءع ان يامره بقلعها ويكون الكل للمشتري وان تركها بغير اذن الباءع حتي اثمرت يتصدق المشتري  بالثمر * ولو اشتري اشجارا مثمرة او غير مثمرة ليقلعها فقلعها ثم نبت من اصل عروقها اشجار فان النابت يكون للمشتري لانه نماء ملكه فيكن له * وان اشتري شجرة باصلها وقد نبت من عروقها اشجار ان كان الاشجار بحيث لو قطعت الشجرة التي بيعت تيبس بقطع الشجرة كان الكل للمشتري لانها اذا كانت تيبس بقطع تلك الشجرة تكون نابتة من عروقها والا فلا * رجل اشتري شجرة ليقطعها فتاخر قطعها حتي جاء الصيف واشتد الحر ان كان قطعها لا يضر بالارض ولا باصل الشجرة كان له ان يقطعها وان كان القطع يضر بالارض او باصل الشجرة اختلفوا في ذلك قال بعضهم له ان يقطعها وقال الفقيه ابو جعفر رحمه الله تعالي يخير المشتري ان شاء تركها الي وقت القطع وان شاء لم يترك فان لم يترك يخير الباءع ان شاء تركها الي وقت القطع وان شاء يدفع اليه قيمتها قاءمة والمشايخ اخذوا بقوله وقال بعضهم الصحيح انه يخير ان شاء رضي بالقطع وان شاء يفسخ البيع لانه عجز عن تسليم المبيع من غير ضرر فكان له ان يفسخ البيع كما في نظاءرها قال المصنف رحمه الله تعالي وينبغي ان يكون الجواب علي التفصيل ان كان ذلك قبل القبض كان له ان يفسخ البيع لان الحادث قبل القبض بمنزلة المقارن للعقد وان كان بعد القبض ليس له ان يفسخ كما قال بعض المشايخ ند مشجرة بين رجلين باع احدهما نصيبه من رجل بغير اذن الشريك بدون ارضها قالوا ان كانت الاشجار بلغت او ان القطع جاز البيع وان لم تبلغ او ان قطعها لم يجز كما لو باع نصيبه من الزرع المشتري قبل الحصاد * رجل له مشجرة جعل علي بعض اشجارها علامة فباع المشجرة الا الاشجار التي عليها العلامة فقطع المشتري الاشجار فادعي الباءع علي المشتري انه قطع بعض الاشجار التي لم تدخل في البيع وافسد اغصان بعضها وانكر المشتري ذلك وقال لم اقطع شيءا من اشجارك ولم اكن متعمدا في افساد الاغصان قال الفقيه ابو جعفر رحمه الله تعالي القول قول المشتري في انكاره قطع الاشجار التي لم تدخل في البيع وفي نقصان الاغصان ينظر الي نقصان الشجر ان كان مما لا يمكن الاحتراز عن ذلك فلا ضمان عليه ايضا ويكون ماذونا <> بذلك دلالة * شجرة اصلها واحد ولها فرعان فباع صاحبها احد الفرعين ان بين موضع القطع وقطعها لا يضر بالاخر جاز * رجل باع شجرة عليها ثمر قد ادرك او لم يدرك جاز البيع وعلي الباءع ان يقطع الثمر من ساعته اذا انقده الثمن لانه ملكها من المشتري فكان عليه تسليمها فارغة عليها وكذا لو اوصي بنخلة فمات الموصي وعليها البسر يجبر الوارث علي قطع البسر هو الصحيح * رجل طلب من رجل ان يبيع منه اشجارا في ارض للحطب فاتفق الباءع والمشتري علي رجال من اهل البصر يعرفون انها كم تكون وقر من الحطب فاتفقوا علي انها تكون خمسة وعشرين وقرا فاشتراها المشتري بثمن علوم وقطعها فكانت اكثر من خمسة وعشرين فاراد الباءع ان يمنع الزيادة ليس له ذلك لان القدر في الاشجار وصف بمنزلة الذرع في المذروعات فيسلم الزيادة للمشتري * مشجرة بين قوم فباع احدهم نصيبه مشاعا ان كانت الاشجار تناهت وبلغت اوان القطع جاز وللمشتري ان يقطع * رجلان اشتريا نخلة وتواضعا علي ان يكون لاحدهما النخلة وللاخر الرطب جاز ويقسم الثمن عليهما علي قيمتهما * وكذا لو اشتريا ايضا فيها شجر علي ان يكون لاحدهما الشجر وللاخر الارض جاز ولصاحب الشجر ان يقلع الشجر ان لم يكن في قلعة ضرر ظاهر والا كان الكل بينهما لانه صار بمنزلة شيءين لا يمكن نزع احدهما الا بضرر فيكون الكل بينهما كالفص مع الخاتم والسيف مع الحلية * رجلان بينهما نخلة عليها ثمر او ارض فيها زرع فباع احد الشريكين نصيبه من الثمر والنخل او من الارض والزرع قال الناطفي رحمه الله تعالي لا ذكر لها في الاصل وينبغي ان يجز لان المشتري قام مقام الباءع في جميع ذلك ولا يتضرر به الشريك * رجل دفع ارضه الي رجل معاملة بالنصف مدة معلومة علي ان يغرس فيها فيكون الغراس بينهما فغرس ومضت المدة ثم باع صاحب الارض ارضه مع نصييه من الغراس جاز وان باع المشتري من اخر قالوا لا يجوز البيع لانها مشغولة بنصيب العامل فيكون البيع قبل القبض قبل هذا قول محمد رحمه الله تعالي اما علي قولهما يجوز البيع لان عندهما بيع العقار قبل القبض جاءز * رجل اشتري شجرة باصلها ليقلعها قال بعضهم لا يجوز هذا البيع والصحيح انه يجوز ثم اذا اشترها علي هذا الوجه ثم استاجر ارضها صحت الاجار وهذا دليل علي دخول ما تحتها من الارض في البيع * نهر في الشارع علي حافتيه اشجار قال الفقيه ابو جعفر ان كانت حافتاه للشاربة كان الاشجار لهم وان كانت للعامة كانت الاشجار لصاحب الدار التي يقابلها الاشجار الا ان يعلم شراءه بعد غرس الاشجار * وقال المصنف رحمه الله تعالي هذا اذا لم يكن الغارس معلوما فان كان معلوما كانت الاشجار {فصل فيما يدخل في بيع المنقول من غير ذكر} * رجل باع  عبدا او جارية كان علي الباءع من الكسوة قدر ما يواري عورته فان بيعت في ثياب مثلها دخل الثياب في البيع وللباءع ان يمسك تلك الثياب ويدفع <> غيرها من ثياب مثلها يستحق ذلك علي الباءع ولا يكون للثياب قسط من الثمن حتي لو استحق الثوب او وجد بالثوب عيبا لا يجرع علي الباءع بشء ولا يرد عليه الثوب ولو هلكت الثياب عند المشتري او تعيبت ثم وجد بالجارية عيبا ردهما بجميع الثمن لانه لم يملك الثوب بالبيع فلا يكون له قسط من الثمن * باع اتانا لها جحش او بقرة لها عجول اختلفوا في ذلك قال بعضهم العجول يدخل في البيع من غير ذكره والجحش لا يدخل الا بذكر * قال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي هما سواء ولا يدخلان في البيع من غير ذكر * ولو باع حمارا قال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي لا يدخل الاكاف في البيع من غير شرط ولا يستحق ذلك علي الباءع ولم يفصل بين ما اذا كان الحمار موكفا او لم يكن وهو الظاهر لان الحمار اذا بيع مع الاكاف يقال باجامه مي فر وشم فكان الاكاف فيه بمنزلة السرج في الفرس وقال غيره من المشايخ يدخل الاكاف والبرذعة في البيع كان الحمار موكفا وقت البيع او لم يكن واذا دخل الاكاف والبرذعة في البيع من غير ذكر كان الحكم فيه ما قلنا في ثوب العبد والجارية ويدخل العذار في بيع الفرس من غير ذكر وكذا الزمام في بيع البعير ولا يدخل المقود في بيع الحمار من غير ذكر لان الفرس لا ينقاد الا بمقود والبعير كذا بخلاف الحمار * باع عبدا له مال ان لم يكر المال في البيع فما له لمولاه الذي باعه لانه كسب عبده وان باع العبد مع ماله فقال بعته مع ماله بكذا ولم يبين المال فسد البيع وكذا لو سمي المال وهو دين علي الناس او بعضه دين فسد البيع وان كان المال عينا جاز البيع ان لم يكن من الاثمان فان كان مال العبد دراهم والثمن كذلك فان كان الثمن اكثر جاز وان كان مثله او اقل منه لا يجوز وان لم يكن الثمن من جنس مال العبد بان كان الثمن دراهم ومال العبد دنانير او علي العكس جاز اذا تقابضا في المجلس * وكذا لو قبض مال العبد ونقد حصته من الثمن فان افترقا قبل القبض بطل العقد في مال العبد * رجل اشتري سمكة فوجد في بطنها لءلءة لان كان اللءلءة في الصدف تكون للمشتري وان لم تكن في الصدف فان كان الباءع اصطاد السكة يردها المشتري علي الباءع وتكون عند الباءع بمنزلة اللقطة يعرفها حولا ثم يتصدق * وان اشتري دجاجة فوجد في بطنها لءلءة يردها علي الباءع وان اشتري سمكة فوجد في بنها سمكة تكون للمشتري {فصل في بيع الزروع والثمار} * رجل قال لغيره اين خيار زار بتوفر وختم بده ودم وكان ذلك قبل ان يخرج الحدجة قال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي يجوز البيع ويكون البيع علي شجرة البطيخ دون ما يخرج من الحدجة فان خرجت الحدجة بعد ذلك كانت الحدجة للمشتري لانها نماء ملكه وان كان البيع بشرط الترك لا يجوز البيع فان كانت المبطخة مشتركة فباع احدهما نصيبه من المبطخة <> لا يجوز كما لا يجوز بيع النصيب من الشجرة المشتركة فان باع نصيبه من المبطخة وسلم علي المشتري كان نصيب الباءع للمشتري ما لم ينتقض البيع * ولو اجاز الشريك الذي لم يبع بيع صاحبه ورضي به كان له ان لا يرضي بعد ذلك لان الانسان لا يجبر علي تحمل الضرر * رجل اشتري الثمار علي رءوس الاشجار ان اشتراها مجازفة كان القطع علي المشتري * ولو اشتري اوراق فرصاد بعد ما ظهرت علي الشجر ولم يقطعها حتي ذهب وقته قال الفقيه ابو جعفر رحمه الله تعالي ان اشتري الاوراق باغصانها وبين موضع القطع لا يكون للمشتري ان يرد البيع بحكم ذهاب الوقت ويجبر علي القطع الا ان يكون قطع الاغصان يضر بالشجر فحينءذ يخير الباءع ان اشتراها علي ان ياخذ شيءا فشيءا لا يجوز لانه يزداد فيختلط المبيع بغير المبيع وكذا لو اشتراها علي ان يتركها علي الشجر وان اشتراها ولم يشترط شيءا فان اخذها في اليوم جاز وان لم ياخذها حتي مضي اليوم فسد البيع لان ما يحدث بعد البيع بمضي الساعات لا يمكن الاحتراز عنها فجعل عفوا وان اراد المشتري ان يحتاط في ذلك ينبغي ان يشتري الشجرة باصلها حتي لو حدثت الشجرة بعد البيع كانت الزيادة للمشتري * وان اشتري الاوراق او الثمار وستاجر الاشجار مدة معلومة لترك الثمار عليها كان الاجارة باطلة ونصير اعارة فكان له ان يرجع بعد ذلك * وقال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي بيع اوراق الفرصاد لا يجوز ما زاد في الزيادة وانما يجوز اذا تناهي وامسك عن الزيادة ولا يدخل اوراق الفرصاد في بيع الشجرة لانه بمنزلة الثمر وقواءم الخلاف * رجل اشتري رطبة من البقول او قثاء او شيءا ينمو ساعة فساعة لا يجوز كما لا يجوز بيع الصور والوبر علي ظهر الغنم الا ان يجزهما من ساعته والقياس في بيع  الخلاف كذلك وانما جاز لمكان التعامل ولانه ينمو من اعلاه لا من اسفله * وبيع الكراث جاءز وان كان ينمو من اسفله لمكان التعامل فاما ما لا تعامل فيه وهو ينمو ساعة فساعة لا يجوز * اذا اشتري انزال الكرم وهو حصر جاز وهل للباءع ان يامر بقطع العنب في الحال قال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي ان اشتراه مطلقا كان له ان يامره وان اشتري بشرط الترك الي النضج فسد البيع وان اشتري انزال الكرم وبعض النزل نء والبعض قد نضج فان كان البعض من كل نوع نضيجا جاز وان كان بعض الانزال نيءا وبعضها نضيجا كالخوخ والجوز والكمثري قالوا لا يجوز هذا البيع * ولو اشتري الخوخ او الكمثري قبل النضج قال الفقيه ابو جعفر رحمه الله تعالي لا يجوز البيع الا ان يكون بعضه قد نضج فيجعل البيع تبعا للبعض فيجوز كما قال ابو يوسف رحمه الله تعالي فيمن باع الفيلق وبعضه فيلق وبعضد دود يجوز ويجعل البعض <> تبعا للبعض * ولو باع التين فان باع بعد ما نضج جاز البيع فان لم يقبض المشتري حتي خرج تين اخر يفسد البيع لاختلاط المبيع بغير المبيع * وعام المشايخ لم يجوزوا بيع الثمار قبل ان تصير منتفعا لنهي النبي عليه الصلاة والسلام عن بيع الثمار قبل ان يبدو صلاحها * وقال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي جاز بيعها بعد ظهورها فقيل له اليس ان النبي عليه الصلاة والسلام نهي عن ذلك فقال ذلك محمول علي بيعها قبل خروجها وظهور صلاحها لانتفاع بها في الزمان الثاني هكذا ذكر محمد رحمه الله تعالي في الجامع والقدوري كذلك * رجل اشتري الثمار علي رءوس الاشجار فتركها حتي اخرجت ثمرة اخري قبل التخلية ولا يمكن التمييز بينهما فسد العقد فان كان ذلك بعد التخلية لا يفسد ويكون الثمر بين الباءع والمشتري والقول في الزيادة قول المشتري * رجل قال لغيره بعت منك عنب هذا الكرم كل وقر بكذا قالوا ان كان وقر العنب معلوما عندهم والعنب جنس واحد ينبغي ان يجوز البيع في وقر واحد عند ابي حنيفة رحمه الله تعالي وعند صاحبيه يجوز البيع في الكل وجعلوا هذه المسالة فرعا لرجل باع صبرة حنطة فقال بعت منك هذه الصبرة كل قفيز بدرهم عند ابي حنيفة رحمه الله تعالي يجوز البيع في قفيز واحد وعندهما يجوز في الكل وحنيفة رحمه الله تعالي يجوز البيع في قفيز واحد وعندهما يجوز في الكل ون كان عند الكرم اجناسا قالوا ينبغي ان لا يجوز البيع في شء في قول ابي حنيفة رحمه الله تعالي وان كان الوقر معروفا وعودهما يجوز في الكل كما لو قال بعت منك هذا القطيع من الغنم كل شاة بكذا عند ابي حنيفة رحمه الله تعالي لا يجوز البيع اصلا وعندهما يجوز البيع في الكل والفتوي علي قولهما تيسيرا علي الناس * ولو انتهي الي رجل يبيع وقر بطيخ فقال بكم عشر بطيخات من هذا البطيخ فقال الباءع بكذا فاشتري عشر بطيخات بغير عينها ثم عزل الباءع عشر بطيخات فقبلها المشتري ومضيا علي ذلك القول والبطيخ متفاوت جاز البيع استحسانا * وكذا الرمان وهذا بمنزلة رجل قال لقصاب بعني من هذا اللحم بكذا فباعه منه وقطع له منا واحدا علي ذلك كان له الخيار ان شاء اخذ بعد القطع وان شاء لم ياخذه فكذلك ههنا * ولو انتهي علي ماءة شاة وقال بكم عشر منها فقال بكذا فهذا باطل كانه اعتبر التعامل وفي البطيخ والرمان تعامل ولا تعامل في الغنم والرقيق * رجل اشتري خوخا وفيه خوخ نء لا يفسد البيع وكذلك الكمثري * وهذا علي قول من لا يجوز بيع الثمر قبل ان يصير منتفعا * كرم بين رجلين باع احدهما نصيبه من نزلة وهو حصر لا يجوز كما لو باع نصيبه من الزرع المشتري * رجل اشتري مبطخة فاراد الصحة وكل ما يخرج منها يكون للمشتري ينبغي ان يشتري اشجار البطيخ باصولها ببعض الثمن ويستاجر الارض ببقية الثمن مدة معلومة ويقدم بيع الاشجار ويءخر الاجارة فان قدم الاجارة لا يجوز لان الارض تكون مشغولة باشجار الاجر قبل البيع فلا <> نصح الاجارة وينبغي ان يشتري الشجار باصولها لهذا *ولو باع اشجار البطيخ واعار الارض يجوز ايضا الا ان الاعارة لا تكون لازمة ويكون له ان يرجع بعدها* اكار له عمارة في ضيعة رجل فباع العمارة ان كانت العمارة او جرا جاز البيع اذا لم يشترط الترك في الارض وان كانت كرابا او كري انهار ونحو ذلك لا يجوز لان ذلك ليس بعين مال متقوم * رجل في ارضه حشيش فباعه ان كان الحشيش نبت بانباته بان سقاها لاجل الحشيش جاز البيع كما لو اخذ سمكة والقاها في الماء ثم باعها وهو يقدر علي اخذها من غير صيد وان كان الحشيش نبت بنفسه لا يجوز بيعه لانه ليس بمملوك بل هو مباح يجوز لغيره ان ياخذه * رجل باع زرعا وهو بقل فان باع علي ان يقطعه او يرسل دابته فيه جاز البيع وان باعه علي ان يتركه حتي يدرك لا يجوز وكذا الرطبة  البقول* رجل باع نصيبه من الزرع المشترك لا يجوز فان لم يفسخ البيع حتي ادرك الزرع جاز لزوال المانع كما لو باع الجذع في السقف ولم يفسخ البيع حتي اخرجه من البناء جاز* قطن بين شريكين في ارض رجل فباع احدهما نصيبه من شريكه او من اجني قبل ان يدرك لا يجوز كما قلنا في الزرع * ولو كان القطن بين الاكار وصاحب الارض فهو علي التفصيل ان باع الاكار نصيبه من صاحب الارض جاز ولو باع صاحب الارض نصيبه من الا كار لا يجوز ذكر في الفتاوي رجل لشبري ارضا فيه زرع بزرعها والزرع بقل فدفعها المشتري قبل القبض مزارعة بالنصف الي الباءع قال لا يجوز لان هذا بمنزلة اجارة الارض المشتراة قبل القبض وقيل هذا ليس بصحيح لان دفع الزرع بالنصف يكون معاملة وفي المعاملة صاحب الارض يكون مستاجرا للعامل ولا يكون مءجرا للارض * رجل اشتري الثمار علي رءوس الاشجار فراي من كل شجرة بعضها يثبت له خيار الرءية حتي لو رضي به يلزمه * وان باع ما هو مغيب في الارض كالجزر والبصل وبصل الزعفران والثوم والفجل والشلجم ان باع بعدما الي في الارض قبل النبات او نبت الا انه غير معلوم لا يجوز البيع وان باع بعد ما نبت نباتا معلوما يعلم وجوده تحت الارض يجو البيع ويكون مشتريا شيءا لم يره عند ابي حنيفة رحمه الله تعالي لا يبطل خياره ما لم ير الكل ويرضي به وعلي قول صاحبيه لا يتوقف خيار الرءية علي رءية الكل وعليه الفتوي فان كان ذلك مما يكال او يوزن بعد القلع كالجزر والثوم والبصل فاذا قلع الباءع شيءا من ذلك او قلعه المشتري باذن الباءع ينظر ان كان المقلوع يدخل تحت الكيل والوزن ثبت للمشتري خيار الرءية حتي لو رضي به يلزمه الكل وان رد بطل البيع وان كان المشتري قلعه بغير اذن الباءع فان كان المقلوع شيءا له قيمة لزمه الكل لانه قبل القلع كان ينمو وبعد القلع لا ينمو والعيب الحادث عند المشتري يمنع الرد <> بخيار الرءية وان كان المقلوع يسير الا قيمة له لا يعتبر ذلك والقلع وعدم القلع سواء وان كان المغيب مما يباع بعد القلع عددا كالفجل فقلع الباءع بعضه او قلع المشتري باذن الباءع لا يلزمه ما لم ير الكل لانه من العدديات المتفاوتة بمنزلة الثياب والعبيد ونحو ذلك وان قلع المشتري بغير اذن الباءع لزمه الكل الا ان يكون ذلك شيءا يسيرا وان اختصم الباءع والمشتري قبل القلع فقال المشتري اخاف ان قلعته لا يصلح لي فيلزمني وقال الباءع اخاف ان قلعته لا ترضي به فترده فاتضرر بذلك قالوا يتطوع انسان بالقلع وغلا يفسخ القاضي العقد بينهما {باب الصرف} الدراهم التي غشها غالب بان كان ثلثها صفرا وثلثها فضة كالدراهم التي تروج في ديارنا يجوز بيع الواحد بالاثنين منها باعيانها لكن يشترط التقابض في المجلس كما في الصرف * وان كان نصفها صفرا ونصفها فضة لا يجوز فيه التفاضل * وان اشتري الفضة الخالصة بالدراهم التي غشها غالب لا يجوز الا ان تكون الفضة الخالصة اكثر من الفضة التي تكون في الدراهم المغشوشة والدراهم تتعين للرد في البيع الفاسد من الاصل ولا تتعين فيما يفسد العقد بعد الصحة ويفسد الصرف بالافتراق قبل القبض ولا يبطل * واذا فسد الصرف بالافتراق قبل قبض احد البدلين هل يتعين المقبوض للرد فيه روايتان والا ظهر انه يتعين كما يتعين في الغصب * رجلان باعا الفضة بالفضة كفه بكفة جاز وان لم يعلم مقدار وزنها * وان تبايعا الدراهم بالدراهم ولا يعرفان وزنهما او يعرفان وزن احدهما لا يجوز لوجود المساواة في الفصل الاول دون الثاني فان عرف المساواة في الفصل الثاني في المجلس جاز وان عرف بعد المجلس لا يجوز عندنا * ويجوز بيع الدراهم بالدنانير مجازفة * رجل له علي رجل ماءة درهم لا بعقد الصرف والسلم ولمديونه عليه ماءة دينار قرضا او غصبا لا تقع المقاصة بينهما ما لم يتقاضا فاذا تقاضا تصير الدراهم قصاصا بماءة من قيمة الدنانير ويبقي لصاحب الجنانير علي صاحب الدراهم تسعون دينارا وكذلك رجل له علي رجل ماشة دينار ولعبده المديون علي صاحب دين المولي ماءة درهم لا تقع المقاصة ما لم يتقاضا فاذا تقاضا يصير من الدنانير بمقدار ماءة درهم قصاصا بماءة درهم ويبقي تسعون دينارا * رجل هل علي رجل دراهم فظفر بدراه مديونه كان له ان اخذ دراهم المديون اذا لم تكن دراهم المديون اجود او لم يكن مءجلا وان ظفر بدنانير مديونه في ظاهر الرواية كان له ان ياخذ دراهم المديون اذا لم تكن دراهم المديون اجود او لم يكن مءجلا وان ظفر بدنانير مديونه في ظاهر الرواية ليس له ان ياخذ الدنانير وذكر في كتاب العين والدين ان له ان ياخذ والصحيح هو الاول * المديون اذا قضي الدين اجود مما عليه لا يجير رب الدين علي القبول كما لو دفع اليه انقص مما عليه وان قبل جاز كما لو اعطاه خلاف الجنس وذكر في بعض الكتب انه اذا اعطاه اجود مما عليه يجبر علي القبول عندنا خلافا لزفر رحمه الله تعالي والصحيح هو الاول *

 ولو كان الدين <> مءجلا فقضاه قبل حلول الاجل يجر علي القبول * ان اعطاه المديون اكثر مما عليه وزنا فان كانت الزيادة زيادة تجرن بين الوزنين جاز وما روي عن رسول الله صلي الله عليه وسلم انه اوفي الدين اكثر وقال انا معاشر الانبياء هكذا نزن محمول علي ما اذا كانت الزيادة زيادة تجري بين الوزنين واجمعوا علي ان الدانق في الماءة يسير يجري بين الوزنين وقدر الدرهم والدرهمين كثير لا يجوز واختلفوا في نصف الدرهم قال ابو نصر الدبوسي نصف الدرهم في الماءة كثير يرد علي صاحبه فان كانت الزيادة كثيرة لا تجري بين الوزنين ان لم يعلم المديون بالزيادة يرد الزيادة علي صاحبها وان علم المديون بالزيادة فاعطاه الزيادة اختيارا هل تحل الزيادة للقابض ان كانت الدراهم المدفوعة مكسرة او صحاحا لا يضره التبعيض لا يجوز اذا علم الدافع والقابض وتكونه هذه هبة المشاع فيما يحتمل القسمة وان كان المدفوع مما يره التبعيض وعلم الدافع والقابض جاز وتكون هذه هبة المشاع فيما لا يحتمل القسمة * رجل اشتري بالفلوس الراءجة والعدالي في زماننا شيءا وكسدت الفلوس قبل القبض وصارت لا تروج رواج الاثمان في عامة البلدان في قول محمد رحمه الله تعالي تكوهن كاسدة وعندهما اذا كانت لا تروج رواج الاثمان في بلدهما تكون كاسدة وعند الكساد يفسد العقد في قول ابي حنيفة رحمه الله تعالي فير المشتري المبيع ان كان قاءما وقيمته ان كان هالكا وان غلا ان رخص لا يفسد العقد ولا خيار لاحدهما في ظاهر الرواية * واذا اشتري بالدراهم الراءجة شيءا ونقد بعض الثمن ثم كسدت فسد العقد بقدر ما لم ينقد في قول ابي حنيفة رحمه الله تعالي لان هذا ساد طارء بمنزلة الهلاك فيتقدر بقدره * ولو اشتري شيءا بالدراهم الكاسدة فان كانت الدراهم بعينها جاز لانها بعد الفساد صارت سلعة فان لم تكن بعينها قالوا لا يجوز البيع * قال المصنف رحمه الله تعالي وينبغي ان يجوز لانها ان كانت بعد الكساد تباع وزنا فقد باع بموزون في الذمة وان كانت تباع عددا فقد باع بعددي في الذمة عددا معلوما * ولو تزوج امراة علي الدراهم الكاسدة فان كانت قيمتها عشرة دراهم لم يكن لها غلا ذلك وان كانت قيمتها دون العشرة بكمل لها العشرة كما لو تزوج امراة علي ثوب قيمته خمسة كان لها الثوب وخمسة اخري وان تزوجها علي الدراهم الراءجة فكسدت قال بعضهم عليه مهر مثلها * وقال الفقيه ابو جعفر رحمه الله تعالي لها قيمة الدراهم من الذهب والفضة قبل الكساد وهو الصحيح لان النكاح اذا اوجب المسمي وقت العقد لا ينقلب موجبا مهرا المثل كما لو تزوج امراة علي عبد او ثوب فهلك ذلك قبل القبض كان لها قيمة الثوب او العبد ولا يصار علي مهر المثل * ولو استقرض الفلوس الراءجة او العدالي فكسدت قال ابو حنيفة رحمه الله تعالي يجب عليه مثلها كاسدة ولا يغرم قيمتها وقال ابو يوسف رحمه الله تعالي قيمتها يوم القبض وقال محمد رحمه الله تعالي يغرم قيمتها في اخر يوم كانت راءجة وعليه الفتوي وكذا لو غصب الفلوس <> الراءجة فكسدت فهو علي هذا الخلاف * ولو اشتري شيءا بالدراهم الراءجة وتقابضا ثم كسدت ثم تقايلا البيع صحت الاقالة ان كان المبيع قاءما وكان علي الباءع رد مثل تلك الدراهم كاسدة في قول ابي حنيفة رحمه الله تعالي كما في الاستقراض * رجل اقرض دراهمه البخارية ببخارا ثم لقي المستقرض في بلد لا يقد علي تلك الدراهم قال ابو يوسف وهو قول اب حنيفة رحمه الله تعالي يمهله قدر المسافة ذاهبا وجاءيا فاما اذا كانت لا تنفق في هذا البلد فانه يغرم قيمتها وكذا لو باع لو باع بالدراهم البخارية شيءا ثم التقيا في بلدة اخري لا توجد فيها تلك الدراهم * ولو ان رجلا استقرض الدراهم المكسرة علي ان يءدي صحاحا كان باطلا وكان عليه مثل ما قبض ويكره السفتجة الا ان يستقرض مطلقا فيوفي بعد ذلك في بلد اخر من غير شرط * وتاجيل القرض باطل سواء كان التاجيل في القرض او بعدما اقرضه * ولا يجوز القرض الا فيما كان مثليا فلا يجوز قرض الخبز والدقيق في قول ابي حنيفة رحمه الله تعالي وقال ابو يوسف ومحمد رحمهما الله تعالي يجوز وزنا وقيل الثلاث يجوز عددا ولا تجوز الزيادة وان اقرض الحنطة وزنا لا يجوز فان استقرضها واكلها قبل الكيل كان علي المستقرض مثلها من الكيل فان اختلفا في مقدارها كيلا وقفيزا كان القول قول المستقرض مع يمينه ولو استهلك علي انسان حنطة في سنبلها كان عليه قيمتها * ويجوز استقراض الكاغد فانه عددي كالجوز والبيض * واستقراض اللحم وزنا جاءز في قول محمد رحمه الله تعالي وهكذا روي عن ابي حنيفة رحمه الله تعالي اما عند محمد رحمه الله تتعالي فلانه مثلي يباع  وزنا ويجوز السلم فيه عنده واما عند ابي حنيفة رحمه الله تعالي فلان القرض يكون حالا غير مءجل فلا يقضي الي المنازعة بخلاف السلم قالا محمد رحمه الله تعالي كل ما يكال او يوزن او يعد بجوز قرضه * رجل له علي رجل جياد فاخذ منه زيوفا او نبهرجة او ستوقة ورضي بها جاز وان انفقها كره وان بين ذلك وعن ابي يوسف رحمه الله تعالي انه يكره استقراض الستوقة والمزيفة والنبهرجة وعلي المستقرض مثلها فان كسدت كان عليه قيمتها * رجل اشتري م رجل كر حنطة بعينه ثم قال للباءع اقرضني قفيز حنطة او قال اقرضني هذا القفيز واخلط به الكر الذي اشتريته منك ففعل وصب الشراء علي القرض او القرض علي الشراء قال ابو يوسف رحمه الله تعالي يصير قابضا لهما جميعا وهكذا روي عن محمد رحمه الله تعالي * رجل اقر فقال استقرضت من فلان الفا زيوفا او قال الفا نبهرجة وانفقها وادعي المرض انها كان جيادا قال ابو يوسف رحمه الله تعالي القول قول المستقرض في النبهرجة والزيوف اذا وصل ولا يصدق اذا فصل ند رجل قال لغيره استقرض لي من فلان عشرة دراهم فاستقرض المامور وبض وقال دفعتها الي الامر وجحد الامر ذلك فان المال يكون علي المامور <> ولا يصدق المامور علي الامر* ولو بعث رجل بكتاب مع رسول الي رجل ان ابعث الي كذا درهما قرضا لك علي فبعث مع الذي اوصل الكتاب روي ابو سليمان عن ابي يوسف رحمهما الله تعالي انه لم يكن ذلك من مال الامر حتي يصل اليه * ولو ارسل رسولا الي رجل فقال ابعث الي بعشرة دراهم قرضا فقال نعم وبعث بها مع رسوله كان الامر ضامنا لها اذا اقران رسوله قبضها * الوكيل بالاستقراض من رجل معين اذا استقرض ان قال الوكيل للمقرض علي وجه الرسالة ان فلانا يقول لك اقرضني كذا كان القرض للموكل وان لم يقل الوكيل ذلك واستقرض كان القرض علي الوكيل * رجل في يده دنانير فقال اشهدوا اني اشتريت هذه الدنانير من ابني الصغير بماءة درهم وقام قبل ان يزن الدراهم كان باطلا لانه هو العاقد فيعتبر قبضه قبل الافتراق كذا روي عن محمد رحمه الله تعالي * رجل استقرض من رجل دراهم فاتاه المقرض بالدراهم فقال له المستقرض القاها في الماء فالقاها قال محمد رحمه الله تعالي لاشء علي المستقرض * رجل استقرض طعاما بالعراق فاخذه صاحب القرض بمكة قال ابو يوسف رحمه الله تعالي عليه قمته بالعراق يوم اقرضة وقال محمد رحمه الله تعالي عليه قيمته بالعراق يوم اختصما وليس عليه ان يرجع معه الي العراق فياخذ طعامه * رجل له علي رجل الف درهم قرض فصالحه علي ماءة منها علي اجل صح الحط والماءة حالة وان كان المستقرض من رجل طعاما في بلد العام فيه رخيص فلقيه المقرض في بلد الطعام فيه ال فاخذه الطالب بحقه فليس له ان يحبس المطلوب فيءمر المطلوب بان يوثق له كفيلا حتي يعطي طعامه اياه في البلد الذي استقرض فيه * جل استقرض طعاما له حمل ومءتة او غصب فالتقيا في بلدة اخلي فيها الطعام اغلي او ارخص روي ابو يوسف عن ابي حنيفة رحمهما الله تعالي ان كان الغصب قاءما في يده ي يءمر بالتسليم اليه ان كانت قيمته في الموضعين سواء او كانت قيمته في هذا الموضع اكثر وان كانت قيمته في هذا البلد اقل ان شاء طلبه بقيمته مكان الغصب وان شاء اخذ الغصب وان شاء ينتظر حتي يسلم اليه في مكان الغصب فان لم يكن الغصب قاءما في يده وقيمته في البلدة التي التقيا اقل من قيمته في بلد الغصب كان للمغصوب منه خيارات ثلاثة ان شاء اخذ مثله ههنا ان كان مثليا وان شاء اخذ قيمته يوم الغصب ببلد الغصب وان شاء ينتظر لياخذه ببلد الغصب وان كان قيمته في هذا المكان اكثر خير الغاصب ان شاء اعطي مثله وان شاء اعطي قيمته في بلد الغصب وان كانت قيمته في الموضعين سواء فللمغصوب منه ان يطالبه بالمثل * رجل استقرض شيءا من الفواكه كيلا او وزنا فلم يقبضه حتي انقطع فانه يجبر صاحب القرض علي تاخيره الي ان يجء الحديث الا ان يتراضيا علي القيمة ولا يشبه هذا الفلوس اذا كسدت لان هذا مما لا يوجد بخلاف الفلوس الكاسدة * رجل عليه عشرة دراهم من قرض او بيع او <> غصب وله علي صاحب العشرة ماءة دينار فتبايعا الدينار بالعشرة وافترقا جاز البيع لان البيع وقع علي ما في ذمة كل واحد منهما وما في ذمة كل واحد في يده حكما فلا يبطل بالافتراق الا تري انهما لو تقاصا الدنانير بالدراهم جاز والمقاصة بخلاف الجنس لا تكون الا مبادلة وكذا لو كان عليه كر حنطة لرجل ثم انه اقرض صاحب الكر كرا من شعير ثم تبايعا الكر بالكر جاز ولا يبطل العقد بالافتراق * رجل اقرض رجلا كرا من حنطة ثم ان المستقرض اشتري القرض من المقرض بدراهمه جاز سواء كان القرض قاءما في يد المستقرض او لم يكن اما اذا لم يكن قاءما فهو قول الكل وان كان  قاءما فكذلك في قول ابي حنيفة ومحمد رحمهما الله تعالي وقال ابو يوسف رحمه الله تعالي لا يجوز شراءه لان عندهما ملك القرض بنفس القبض وعند ابي يوسف رحمه الله تعالي لا يملكه مادام قاءما فلا يجوز شراءه ولا يكون شراءه ولا يكون شراءه فسخا للقرض بخلاف ما لو اشتري شيءا بالدنانير ثم اشتراه بالدراهم فان البيع الثاني يكون فسخا للاول لان القرض مما لا يحتمل الفسخ لان سبب الملك في القرض القبض وهو قاءم فلا يفسخ القرض * اذا قال المستقرض وجدت القبض زيوفا او نبهرجة وكان ذلك بعدما استهلكها لاا يرجع علي المقرض بشء ولكنه يرد مثلها * اذا اقرض الجوز كيلا جاز لانه يكال مرة ويعد اخري * رجل اقرض صبيا او معتوها فاستهلكه الصبي او المعتوه لا يضمن في قول ابي حنيفة ومحمد رحمهما الله تعالي وقال ابو يوسف رحمه الله تعالي يضمن * وان اقرض عبدا محجورا فاستهلكه لا يءاخذه به قبل العتق عندهما وهذا والوديعة سواء * رجل عليه الف درهم لرجل فدفع الي الطالب دنانير فقال اصرفها وخذ حقك منها فاخذها فهلكت في يده قبل ان يصرفها هلكت من مال الدافع وكذا لو صرفها وقبض الدراهم فهلكت الدراهم في يده قبل ان ياخذ منها حقه هلكت من مال الدافع وان اخذ منها حقه ثم ضاع كان ذلك من مال المدفوع اليه ولو دفع المطلوب الي الطالب دنانير وقال خذها قضاء لحقك فاخذ كان داخلا في ضمانه ولو دفع المطلوب الي الطالب دنانير وقال بعها بحقك فباعها بدراهم مثل حقه واخذها يصير قابضا حقه بالقبض بعد البيع * رجلان تصارفا الدراهم بالدنانير وتقابضا ثم تقايلا وافترقا قبل القبض بطلت الاقالة ويعود الصرف لان الاقالة بمنزلة البيع فيعتبر القبض قبل الافتراق {باب في قبض المبيع وما يجوز من التصرف قبل القبض وما لا يجوز} * الباءع اذا خلي بين المبيع وبين المشتري بحيث يتمكن المشتري من قبضه يصير المشتري قابضا للمبيع حتي لو هلك قبل ان يقبضه حقيقة يهلك عليه وكذا لو خلي المشتري بين الباءع والثمن * ولو قبض المشتري المبيع بغير اذن الباءع قبل نقد الثمن كان للباءع ان يسترده فان خلي المشتري بين المبيع وبين الباءع لا يصير الباءع فابضا مال لم يقبضه حقيقة اجمعوا علي ان التخلية في البيع <> الجاءز تكون قبضا وفي البيع الفاسد روايتان والصحيح انه قبض وفي الهبة الفاسدة كالهبة في المشاع الذي يحتمل القسمة لا تكون قبضا باتفاق الروايات واختلفوا في الهبة الجاءزة ذكر الفقيه ابو الليث انه لا يصير قابضا بالتخلية في قول ابي يوسف رحمه الله تعالي وذكر شمس الاءمة الحلواني رحمه الله تعالي انه يصير قابضا ولم يذكر فيه خلافا * ولو باع تمرا علي النخيل وخلي بينه وبين المشتري صار قابضا * ولو وهب تمرا علي النخيل وخلي بينه وبين الموهوب له لا يصير قابضا لانه في معني المشاع الذي يحتمل القسمة * ولو باع دارا وسلمها غلي المشتري وفيها قليل متاع للباءع لم يكن ذلك تسليما حتي يسلمها فارغة وان اودع المتاع عند المشتري واذن للمشتري بقبض الدار والمتاع جميعا صح التسليم لان الكل صار في يد المشتري * ولو باع دارا من رجل ليست بحضرتهما فقال الباءع سلمتها اليك وقال المشتري قبلت ذكر في ظاهر الرواية ان التخلية في الدور والعقار لا تكون قبضا الا بدنو منهما * وكر في النوادر اذا قال الباءع للمشتري سلمتها اليك وقال المشتري قبلت والدار ليست بحضرتهما يصير المشتري قابضا في قول ابي حنيفة رحمه الله تعالي وقال ابو يوسف ومحمد رحمهما الله تعالي ان كانت الدار بقرب منهما بحيث يقدر علي لدخول والاغلاق يصير قابضا وغلا فلا وفي ظاهر الرواية اعتبر القرب ولم يذكر فيه خلافا والصحيح ما ذكر في ظاهر الرواية لانه اذا كان قريبا يتصور فيه القبض الحقيقي في الحال فتقام التخلية مقام القبض اما اذا كان بعيدا لا يتصور القبض الحقيقي في الحال فلا تقام التخلية مقام القبض وكذلك في الهبة والصدقة * ولو باع الدار وسلم المفتاح فقبض المفتاح ولم يذهب غلي الدار يكون قابضا قيل هذا غذ دفع اليه مفتاح هذا الغلق اما اذا لم يكن ذلك لم يكن تسليما لانه لا يقدر علي الدخول بهذا المفتاح فلا يكون قبض المفتاح كقبض الدار وان دفع اليه المفتاح ولم يقل خليت بينك وبين الدار فاقبضه لم يكن ذلك قبضا * رجل اشتري وقر حطب في مصر وذهب المشتري مع الباءع الي بيت المشتري فاغصب الحطب انسان فان ذلك يكون من مال الباءع لا من مال المشتري لان علي الباءع ان ياتي به غلي منزل المشتري * رجل باع من رجل ساجة ملقاة في طريق والمشتري قاءم عليها وخلي الباءع بينه وبينها فلم يحركها * رجل اشتري عبدا بالف ولم يقبضه حتي رهنه الباءع بماءة دينار او اجره او اودعه فمات ينفسخ البيع ولا يكون للمشتري ان يضمن احدا من  هءلاء لانه ان ضمنهم رجعوا علي الباءع * ولو اعاره او وهبه فمات عند المستعير او الموهوب له او اودعه فاستعمله المودع فمات من ذلك المشتري بالخيار ان شاء امضي البيع وضمن المستعير والودع والموهوب له وان شاء فسخ البيع لانه ان ضمن هءلاء ليس للضامن ان يرجع علي <> الباءع * ولو كان الباءع باعه من رجل فمات عند المشتري الثاني من عمله او من غير عمله كان المشتري الاول بالخيار ان شاء فسخ البيع وان شاء ضمن المشتري ثم يرجع المشتري الثاني علي الباءع بالثمن ان كان نقده الثمن وان لم ينقده لا يرجع بشء * ولو اشتري عبدا فامر الباءع رجلا فقتله كان للمشتري ان يضمن القاتل قيمته الا ان القاتل اذا ضمن لا يرجع علي الباءع * ولو باع شاة ثم امر الباءع رجلا فذبحها فان كان الذابح يعلم بالبيع فللمشتري ان يشمن الذابح ولا يرجع الذابح علي الامر * ولو ان رجلا له شاة امر رجلا ان يذبحها ثم باع الشاة قبل ان يذبح ثم ذبحها المامور كان للمشتري ان يضمن الذابح ولا يرجع بذلك علي الامر وان لم يعلم المامور بالبيع * قال ابو حنيفة رحمه الله تعالي التخلية بين المبيع والمشتري تكون قبضا بشراءط ثلاثة احدها ان يقول الباءع خليت بينك وبين المبيع فاقبضه ويقول المشتري قد قبضت * والثاني ان يكون المبيع بحضرة المشتري بحيث يصل الي اخذه من غير مانع * والثالث ان يكون المبيع مفرزا غير مشغول بحق الغير فان كان شاغلا حق الغي كالحنطة في جوالق الباءع وما اشبه ذلك فذلك لا يمنع التخلية واختلف ابو يوسف ومحمد رحمهما الله تعالي في التخلية في دار الباءع قال ابو يوسف رحمه الله تعالي لا يكون تخلية وقال محمد رحمه الله تعالي يكون تخلية * ومن لك رجل باع خادما فقال الباءع خليت بينك وبين الخادم فاقبضها والخادم في منزل الباءع بحضرتهما يصل غلي قبضها فقال المشتري دعها الي الغد وابي ان يقبض فهلك الخادم فانها تموت من مال المشتري عند محمد ومن مال الباءع في قول ابي يوسف رحمه الله تعالي * ولو اشتري غلاما او جارية فقال المشتري للغلام تعال معي او امش معي فتخطي معه فهو قبض ننج ولو قال الباءع للمشتري بعد البيع خذا لا يكون قبضا * ولو قال خذه يكون تخلية اذا كان يصل غلي اخذه * ولو اشتري شيءا فنقد بعض الثمن ثم قال للباءع تركته رهنا عندك ببقية الثمن او قال تركته وديعة عندك لا يكون ذلك قبضا * رجل اشتري شاتين فنطحت احداهم الاخري قبل القبض فهلك خير المشتري ان شاء قبض الباقي بحصتها من الثمن وان شاء ترك وكذا لو اشتري حمارا وشعيرا فاكل الحمال الشعير قبل القض لان فعل العجماء جبار فصار كانها هلكت لافة سماوية * ولو اشتري عبدين فقتل احدهما الاخر قبل القبض خير المشتري شاء اخذ الباقي بجميع الثمن وان شاء بفعل الاول * ولو باع عبدا برغيف بعينه فلم يتقابضا حتي اكل العبد الرغيف يصير الباءع مستوفيا الثمن لان جناية العبد في يد الباءع مضمونة علي الباءع فصار الباءع قابضا الثمن بفعل العبد * ولو باع حمارا بشعير بعينه فلم يتقابضا حتي اكل الحمار الشعير ينفسخ البيع ولا يكون الباءع * <> مستوفيا الثمن لان فعل الحمار هدر غير مضمون فيصير الشعير هالكا قبل القبض بافة سماوية فينفسخ البيع * ولو رهن دابة وقفيز شعير عند رجل قاكلت الدابة الشعير لا يصير المرتهن مستوفيا شيءا من دينه لان علف الدابة الرهن لا يكون علي المرتهن اما علف دابة المبيع قبل القبض يكون علي الباءع فيصير الباءع متلفا بفعل الدابة * اشتري عبدا ولم يقبضه ثم ان المشتري قال للباءع قبل القبض مرة ليعمل اي كذا فامر الباءع بذلك فعمل وعطب في العمل فانه يهلك علي المشتري كما لو امره المشتري ليعمل له كذا فعمل * المشتري اذا احدث في المبيع عيبا قبل القبض يصير قابضا وكذا لو امر الباءع بذلك فعمله الباءع * اذا اشتري حنطة وامر الباءع بطحنها فطحن فان الدقيق يكون للمشتري ويصير المشتري قابضا للمبيع * رجل اشتري خفين او نعلين او نعلين او مصراعي باب فقبض احدهما فهلك المقبوض عند المشتري والاخر عند الباءع كان علي المشتري حصة ما هلك عنده وما هلك عند الباءع يهلك علي الباءع ولا يصير المشتري بقبض احدهما قابضا لهما جميعا * ولو احدث المشتري باحدهما عيبا قبل القبض يصير المشتري قابضا لهما جميعا ولو احدث الباءع باحدهما عيبا بامر المشتري يصير المشتري قابضا لهما جميعا ولو قبض المشتري احدهما واستهلكه واحدث به عيبا ثم هلك الاخر عند الباءع كان المشتري قابضا لهما جميعا ويلزمه جميع الثمن ولو لم يكن هناك بيع فاستهلك اجنبي احدهما كان للمالك ان يسلم اليه الباقي وياخذ قيمتهما * رجل اشتري دهنا معينا ودفع اليه الانية وامر الباءع يزن فيه فوزن فيه ثم هلك ان كان الباءع وزنه بحضرة المشتري فانه يهلك علي المشتري لان المشتري صار  قابضا يوزن الباءع وان كان ذلك في بيت الباءع او حانوته فان كان الباءع وزن الدهن في غيبة المشتري فهلك يهلك علي الباءع لان الواحد لا يصلح ان يكون مسلما ومتسلما فاذا كان المشتري حاضرا امكن جعله قابضا يوزن الباءع بامر المشتري فلا يصير الباءع مسلما ومتسلما اما اذا كان المشتري غاءبا وان صح امر المشتري يوزن الدهن في الانية لا يمكن جعله قابضا تقديرا فلا يصير المشتري قابضا هذا اذا اشتري دهنا بعينه * فان كان بغير عينه لا يكون المشتري قابضا سواء كان المشتري حاضرا او غاءبا لان الدهن اذا لم يكن معينا كان امر المشتري بالوزن مصادفا ملك الباءع فلا يصح ولا يكون وزنه كوزن المشتري هذا كما لو استقرض من اخر حنطة ودفع اليه الجوالق وامره بان يكيل فيها فانه لا يصير قابضا في الوجهين * ولو اشتري من الدهان عشرة ارطال دهن معين بدرهم ودفع القارورة اليه وامره بان يزن فيها الدهن فلما وزن رطلا منها انكسرت القارورة وسال الدهن وهما لا يعلمان بانكسارها قصب الباءع الباقي فيها فما وزن قبل الانكسار يكون علي المشتري وما وزن بعد الانكسار فهلاكه يكون علي الباءع ويضمن الباءع للمشتري ما وزن قبل الانكسار بصب الباقي وان بقي في القارورة شء مما وزن قبل الانكسار كان ذلك للمشتري هذا اذا دفع اليه قارورة صحيحة فانكسرت وان كانت منكسرة وهو لا يعلم بذلك ومر الدهان بصب <> الدهن فيها فصب والباءع ايضا لا يعلم بالانكسار فذلك كله علي المشتري * وان لم يدفع القارورة الي الدهان وكانت القارورة في يده وامر الباءع بصب الدهن فيها كان الهلاك في جميع ذلك علي المشتري * وذكر قي المنتقي رجل اشتري سمنا ودفع الي الباءع ظرفا وامره بان يزن فيه وفي الظرف خرق لا يعلم به المشتري والباءع يعلم به فتلف كان التلف علي الباءع ولا شء علي المشتري وان كان المشتري يعلم بذلك والباءع لا يعلم او كانا يعلمان جميعا يكون المشتري قابضا وكذا لو قال للباءع اعرني جوالقك هذا وكله لي فيه * ولو قال اعرني جوالقك ولم يقل هذا وكله لي ففعل فليس هذا بقبض من المشتري * وذكر القدوري رحمه الله تعالي ان كان المشتري حاضرا يكون قابضا والا فلا وقال محمد رحمه الله تعالي لا يكون قابضا في الوجهين الا ان ياخذ الجوالق ثم يدفعه الي الباءع وامره بان يكيل فيه * ولو اشتري دهنا ودفع القارورة غلي الدهان وقال للدهان ابعث القارورة الي منزلي فبعث فانكسرت في الطريق قال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي ان كان قال للدهان ابعث علي يد غلامي ففعل فانكسرت القارورة في الطريق فانها تهلك علي المشتري ولو قال ابعث علي يد غلامك فبعث فهلكت في الطريق فالهلاك يكون علي الباءع لان حضرة غلام المشتري تكون كحضرة المشتري واما غلام الباءع بمنزلة الباءع * ومن مساءل التخلية رجل له رماك في حظيرة فباع منها واحدة بعينها لرجل وقبض الثمن وقال للمشتري ادخل الحظيرة واقبضها فقد خليت بينك وبينها فدخل ليقبضها فعالجها فانفلتت وخرجت من باب الحظيرة وذهبت قال محمد رحمه الله تعالي ان سلم الرمكة الي المشتري في موضع يقدر علي اخذها بوهق ومعه وهق والرمكة لا تقدر علي الخروج من ذلك المكان فهو قبض وان كانت تقدر علي ان تنفلت منه ولا يضبطها الباءع فليس بقبض وكذا لو كان المشتري يقدر علي اخذها بوهق ولا يقدر بغير وهق وليس معه وهق او كان يقدر علي اخذها ان كان معه اعوان ولا يقدر علي اخذها وحده وليس معه اعوان فانفلتت لا يكون ذلك قبضا وان كان المشتري يقدر علي اخذها بغير حل ولا اعوان فخلي الباءع بينه وبينها فانفلتت كان المشتري قابضا وان كانت الرمكة في يد الباءع فامسكها بعنانه فاشتراها رجل ونقد الثمن فقال له الباءع هاك الرمكة فوضعها في يده فانفلتت من المشتري بعد ما صارت في يده فهي من مال المشتري وان كانت الرمكة في ي الباءع والمشتري جميعا فقال الباءع خليت بينك وبينها ولست امسكها منعا ببذلها وانما امسكها حتي تضبطها فانفلتت من ايديهما فهو قبض من المشتري وان كانت الرمكة في يد الباءع ولم تصل الي يد المشتري فقال الباءع خليت بينك وبينها فاقبضها فاني امسكها لك فانفلتت من يد الباءع قبل قبض المشتري الا ان المشتري كان يقدر علي <> اخذها من يد الباءع وضبطها فليس هذا بقبض من المشتري * ولو اشتري فرسا او دابة والباءع راكبها فقال له المشتري احملني معك فحمله فعطبت الدابة هلكت من مال المشتري * ولو كانت الرماك كثيرة في حظيرة عليها باب مغلق لا تقدر الرماك علي الخروج فباعها من رجل وخلي بينه وبين الرماك ففتح المشتري الباب فغلبت الرماك وخرجت الرماك ينظران كان المشتري لو دخل الحظيرة يقدر علي اخذها يكون قابضا والا فلا * وان اشتري طيرا يطير في بيت عظيم الا انه لا يقدر علي الخروج الا بفتح الباب والمشتري لا يقدر علي اخذه لطيرانه وخلي  الباءع بينه وبين البيت ففتح المشتري الباب فخرج الطير ذكر الناطفي انه يكون قابضا؟ للطير ولو فتح الباب غير المشتري او فتحه الريح لا يكنون المشتري قابضا وان كان الطير لا يقدر علي الخروج الا بفتح الباب * رجل باع خلا في دن في بيته وخلي بينه وبين المشتري فختم المشتري علي الدن وتركه في بيت الباءع فهلك بعد ذلك فانه يهلك من مال المشتري في قول محمد رحمه الله تعالي وعليه الفتوي * ولو اشتري ثوبا وامره الباءع بقبضه فلم يقبضه حتي غصبه انسان فان كان حين امره الباءع بالقبض امكنه ان يمد يده ويقبض من غير قيام صح التسليم والا فلا * رجل باع فصا في خاتم بدينار ودفع الخاتم الي المشتري وامره ان ينزع الفص فهلك الخاتم عند المشتري ان كان المشتري يقدر علي نزعه من غير ضرر كان علي المشتري ثمن الفص لا غير لان المشتري كان امينا في الخاتم فاذا كان يقدر علي نزع الفص من غير ضرر صح التسليم وان كان لا يقدر علي نزع الفص من غير ضرر صح التسليم وان كان لا يقدر علي نزع الفص الا بضرر لا شء علي المشتري لان تسليم المبيع لم يصح وان لم يهلك الخاتم خير المشتري ان شاء تربص حتي ينزعه الباءع وان شاء نقض البيع * ولو اشتري صوفا في فراش وابي الباءع ان يفتقه فان لم يكن في فتقه ضرر يجبر الباءع علي ان يفتق مقدار ما ينظر المشتري في الصوف فان رضيه يجبر علي فتق الكل وان كان في فتقه فان لم يكن في فتقه ضرر يجبر الباءع علي ان يفتق مقدار مقدار ما ينظر المشتري في الصوف فان رضيه يجبر علي فتق الكل وان كان في فتقه ضرر لا يجبر الباءع علي الفتق لانه لا يجبر علي تحمل الضرر * رجل باع حبابا في بيت لا يمكن اخراجها غلا بقلع الباب فان الباءع يجبر علي تسليمه خارج البيت فان كان لا يقدر علي تسليمه الا بضرر كان له ان ينقض البيع * رجل اشتري بقرة وقال للباءع سقها الي منزلك حتي اجء خلفك غلي منزلك واسوقها غلي منزلي فماتت البقرة في بيت الباءع فانها تهلك علي الباءع * فان ادعي الباءع تسليم البقرة كان القول قول المشتري مع يمينه * رجل دفع غلي قصاب درهما وقال اعطني بهذا الدرهم لحما وزنه وضعه في هذا الزنبيل في حانوتك حتي اجيءك بعد ساعة ففعل القصاب ذلك فاكلته الهرة قال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي ان لم يبين موضع اللحم كان الهلاك علي القصاب وان بين فقال من الجنب او من الذراع او غير ذلك يكون الهلاك علي المشتري وهو نظير ما ذكرنا عن القدوري * رجل اشتري حنطة <>بعينها ودفع الغرارة الي الباءع وقال ضع كلها فيها ففعل صار المشتري قابضا ولو كانت الحنطة بغير عينها بان كان سلما او ثمنا ودفع الغرارة الي المسلم اليه وامره بكيلها فيها لا يصير قابضا الا ان يكن رب السلم حاضرا قال مولانا رحمه الله تعالي وكذا لو اشتري ذراعا من ثوب ولم يبين الجانب فقطعه الباءع ولم يرض به المشتري لا يلزم المشتري * ولو بين الجانب فقال من هذا الجانب فقلعه الباءع لزم المشتري ولا يكون للمشتري ان يرد * رجل اشتري عبدا فقتله انسان عمدا قبل القبض قال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي خير المشتري في قول ابي حنيفة رحمه الله تعالي ان اختار امضاء البيع كان القصاص له وان نقض البيع كان القصاص للباءع وعند ابي يوسف رحمه الله تعالي ان اختار امضاء البيع كان القصاص للمشتري وان اختار نقض البيع فلا قصاص وتكون القيمة للباءع ومحمد رحمه الله تعالي استحسن فقال تجب القيمة في الحالين ولا يجب القصاص وهو بمنزلة ما لو كان القتل خطا وذكر المسالة في النوادر علي هذا الوجه كما قال الشيخ الامام رحمه الله تعالي * رجل اشتري عبدا ولم يقبضه فامر الباءع ان يهبه من فلان ففعل الباءع ذلك ودفعه الي الموهوب له جازت الهبة ويصير المشتري قابضا وكذا لو امر الباءع ان يءاجره من فلان فعين او لم يعين ففعل جاز وصار المستاجر قابضا للمشتري اولا ثم يصير قابضا لنفسه والاجر الذي ياخذه الباءع من المستاجر يحسب من الثمن ان كان من جنسه وكذا لو اعار الباءع العبد من رجل قبل التسليم الي المشتري او وهب او رهن فاجاز المشتري ذلك جاز ويصير قابضا ولو ان المشتري اعار العبد المشتري قبل القبض او وهبه او تصدق به علي رجل او رهنه عند انسان وقبضه المرتهن جاز ولو باع او اجر قبل البقض لا يجوز قال محمد كل تصرف يجوز من غير قبض اذا فعله المشتري قبل القبض لا يجوز وكل ما لا يجوز الا بالقبض كالهبة والرهن ونحوهما اذا فعله المشتري قبل القبض جاز لان المشتري بالرهن والهبة يصير مسلطا للمرتهن والموهوب له علي لقبض فيصير المشتري قابضا بقبضه * رجل اشتري ثوبا ولم يقبضه ولم ينقد الثمن فقال للباءع لا تمسك عليه ادفعه الي فلان فيكون عنده حتي ادفع اليك الثمن فدفعه الباءع الي فلان فهلك  عنده كان الهلاك علي الباءع لان المدفوع اليه يمسكه بالثمن لاجل الباءعه فتكون يده كيد الباءع * رجل اشتري جارية ولم يقبضا فقال للباءع بعها اوطءها فباعها او وطءها او كان طعاما فقال كله ففعل فان ذلك يكون فسخا للبيع وما لم يفعل الباع ذلك لا يكون فسخا اما الاكل والوطء فان الباءع لا يصلح ناءبا عن المشتري في ذلك فيجعل مجازا عن الفسخ حتي يكون واطءا واكلا مال نفسه * واما البيع فهو علي وجوه ثلاثة ان قال بعه لنفسك فباعه يكون فسخا ولو قال بعه لي لا يجوز البيع ولا يكون فسخا ولو قال بعه او بعه ممن شءت فباعه كان فسخا ويجوز البيع الثاني للمامور في قول محمد رحمه الله تعالي وقال ابو حنيفة رحمه الله تعالي لا يكون فسخا وهو كقوله بعه لي <> * ولو اشتري ثوبا او حنطة فقال للباءع بعه قال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي ان كان ذلك قبل القبض المشتري وقبل الرءية يكون فسخا وان لم يقل الباءع نعم لان المشتري ينفرد بالفسخ في خيار الرءية وان قال بعه لي او كن وكيلي في الفسخ فما لم يقبل الباءع ولم يقل نعم لا يكون فسخا وان كان ذلك بعد القبض والرءية لا يكون فسخا ويكون توكيلا بالبيع سواء قال بعه او قال بعه لي * باع المبيع من الباءع قبل القبض لا يجوز البيع الثاني ولا ينفسخ الاول * ولو وهب من الباءع لا تجوز الهبة وينفسخ البيع اذا قبل * ولو اشتري عبدا وقبضه ثم تقايلا البيع ولم يتقابضا حتي اشتراه من الباءع جاز شراءه * ولو باعه الباءع بعد الاقالة من غير المشتري لا يجوز بيعه * اشتري دارا او عقارا فرهنها قبل القبض من غير الباءع يجوز عند الكل ولو باع يجوز في قول ابي حنيفة وابي يوسف رحمهما الله تعالي ولا يجوز في قول محمد رحمه الله تعالي * ولو اجرها قبل القبض من الباءع او غيره لا يجوز عند الكل وكذا لو اشتري ارضا فيها زرع زرعها والزرع بقل فدفعها الي الباءع معاملة بالنصف قبل القبض لا يجوز لانه اجر الارض فان دفع الارض معاملة يكون استءجارا للعامل ولا يكو اجارة للارض وانما لا يجوز لانه باع نصف الزرع قبل القبض * رجل اشتري فحما في بيت الباءع في جوالقه فوضع المشتري يده عليها وقال قبضت ثم باعه من غيره قبل الاخراج قالوا يجوز بيعه لانه باع بعد القبض وهذا قول محمد رحمه الله تعالي وتاويله اذا كان الباءع خلي بينه وبين الفحم * رجل اشتري دابة مريضة في اصطبل الباءع فقال المشتري تكون ههنا الليلة فان ماتت ماتت لي فهلكت هلكت من مال الباءع لا من مال المشتري * رجل باع مكيلا في بيت مكايلة او موزونا موازنة وقال للمشتري خليت بينك وبينه ودفع اليه المفتاح ولم يكله ولم يزنه صار المشتري قابضا ولو انه دفع المفتاح غلي المشتري ولم يقل خليت بينك وبينه فاقبضه لا يكون قابضا * باع مكيلا مكايلة او موزونا موازنة او معدودا او مذروعا كان اجر الكيال والوزان والذراع والعداد علي الباءع لان ذلك من باب التسليم ولهذا صار المشتري قابضا بكيل الباءع عند حضرته * ولو اشتري الثمار علي رءوس الاشجار كان اجرة الجذاذ علي لمشتري لانه ثم يتحقق التسليم بالتخلية * ووزن الثمن يكون علي المشتري وكذلك اجرة الناقد في ظاهر الرواية وقال بعضهم ان قال المشتري دراهمي منتقدة كان اجرة الناقد علي الباءع وان قال غير منتقد فاجرة الناقد تكون علي المشتري والصحيح انها تكون علي المشتري علي كل حال * ولو اشتري حنطة او ثيابا في جراب كان فتح الجراب علي الباءع واخراج الثياب علي المشتري وقيل كما يجب الكيل علي الباءع فالصب في وعاء المشتري يكون عليه ايضا وكذا لو اشتري ماء من سقاء في قربة كان صب الماء علي السقاء والمعتبر في هذا العرف * ولو اشتري حنطة في سنبلها جاز وكانت التذرية والكدس والتخليص علي الباءع * ولو اشتري عنبا جزافا كان القطف علي المشتري وكذا <> ولو اشتري شيءا مغيبا في الارض كالثوم والجزر والبصل ونحو ذلك كلما اشتراه جزافا فاخراج ذلك يكون علي المشتري * ولو اشتري كيليا مكايلة او موزونا موازنة فكان الباءع بحضرة المشتري قال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي يكفيه كيل الباءع ويجوز له ان يتصرف فيه قبل ان يكيله * وقوله عليه الصلاة والسلام حتي يجري فيه صاعان محمول علي ما اذا كانت الحنطة سلما او ثمنا علي رجل فاشتري المديون كرا من رجل اخر وامر صاحب الدين بقبض الكر من غريمه فان صاحب الدين يحتاج الي الكيل مرتين مرة لباءعه ومرة لنفسه * ولو كان هذا في الذرعيات اذا باع مذارعة فلم يذرع الباءع وقبض المشتري بغير ذرع جاز له ان يتصرف فيه من غير ذرع وفي العدديات روايتان في رواية عن ابي حنيفة رحمه الله تعالي هو والذرعي سواء وفي رواية هو والكيلي والوزني سواء * ولو اشتري حنطة علي انها  كر فقال له الباءع هي كر كلتها الان لفلان فلم ياخذها فخذها بعشرة فاخذها علي ذلك قالوا لا يجوز له ان يتصرف فيه حتي يكيل مرة اخري وكذلك الموزون فان لم يكله حتي باع من غيره بعد القبض او طحنها واكل الخبز قالوا لا يطيب له لنهي النبي عليه الصلاة والسلام وقال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي النهي محمول علي ما اذا لم يكن المشتري حاضرا وقت كيل الباءع فان كان حاضرا وراي راي العين لا يحتاج الي الكيل بعد ذلك قال وكذلك الجواب في القصاب والخيار اذا قال وزنت الان لفلان ان لم يكن المشتري حاضرا يحتاج الي الوزن مرة اخري وان كان حاضرا حين وزن الباءع كفه ذك * في الذرعات اذا اشتري ثوبا قال له الباءع هو عشرة اذرع ذرعته الان وصدقه المشتري في ذلك كفاه في العدديات هو علي الروايتين {فصل في المقبوض علي سوم الشراء} * رجل ساوم رجلا بقدح وقال لصاحب القدح ارم الي فدفعه اليه فوقع من يده علي الاقداح فانكسرت لا يضمن القابض القدح المدفوع اليه لانه قبضه علي سوم الشراء من غير بيان الثمن فلا يضمن وعليه ضمان الاقداح التي انكسرت بفعله * رجل جاء الي زجاج فقال ادفع الي هذه القارورة فقال الزجاج بكذا فقال اخذها فاراها فقال الزجاج نعم فرفعها فوقعت من يده وانكسرت كان عليه قيمتها ولو وقعت علي اقداح اخري فانكسرت الاقداح كان عليه ضمان تلك الاقداح بين الثمن او لم يبين هذا اذا اخذها باذن صاحبها فان اخذها بغير اذنه كان ضامنا بين الثمن او لم يبين * رجل اشتري خلا فنظر في دن الخل فوقعت قطرة دم من انفه <> في الدن ينجس ولا ضان عليه ان نظر باذن الخلال وان نظر بغير اذنه كان ضامنا * اشتري فقاعا او شرابا واخذ القدح او الكوز من الفقاعي فوقع من يده فانكسر لا يضمهن لانه اعار منه الكوز * رجل اخذ من البزاز ثوبا فقال اذهب به فان رضيته اشتريته فضاع من يده لا يضمن ولو قال ان رضيته اشتريته بعشرة كان ضامنا * الوكيل بالشراء اذا اخذ السلعة علي سوم الشراء بعد بيان الثمن فاراها الموكل فلم يرض بها الموكل فردها علي الوكيل فهلكت عند الوكيل كان علي الوكيل قيمتها لانه اخذها علي سوم الشراء وبين الثمن ثم يرجع الوكيل بما ضمن علي موكله ان كان امره الموكل بالاخذ علي سوم الشراء وان لم يكن امره بذلك لا يرجع لان الامر بالشراء لا يكون امرا بالاخذ علي سوم الشراء * رجل يبيع سلعة فقال لغيره انظر فيها فاخذها لينظر فيها فهلكت في يده لا يضمن وان قال الناظر بعد ما نظر بكم تبيع قالوا يكون ضامنا والصحيح انه لا يضمن غلا اذا قال صاحب السلعة بكذا * رجل قال لغيره هذا الثوب لك بعشرة وقال هات حتي انظر فيه او قال حتي اريه غيري فاخذه علي هذا فضاع في يده ذكر في المنتقي انه لا يضمن في قول ابي حنيفة وابي يوسف رحمهما الله تعالي * ولو قال هات فان رضيت اخذته فضاع كان عليه الثمن * رجل اخذ متاعا ليذهب به الي منزله فان رضي اشتراه وان لم يرض رده عليه فهلك في يده قال ابو الليث الكبير رحمه الله تعالي لا يضمن لانه اخذه علي وجه الامانة لا علي وجه المساومة * وان اشتري متاعا علي انه بالخيار الي ان يذهب به الي منزله فهلك في يده كان عليه القيمة لانه لم يوقت للخيار وقتا فيفسد البيع الا انه ان هلك في ثلاثة ايام كان عليه الثمن وان هلك بعدها كان عليه القيمة * رجل دفع السلعة الي مناد لينادي عليها فطولب منه بدراهم معلومة فوضعه عند الذي طلبه وقال ضاعت مني او وقعت مني كان عليه قيمته لانه اخذه علي وجه السوم بعد بيان الثمن قالوا ولا شء علي المنادي وهذا اذا كان ماذونا بالدفع الي من يريد شراءه قبل البيع فان لم يكن ماذونا بذلك كان ضامنا والله اعلم {فصل في قبض الثمن} * رجل باع متاعا بالف درهم فوزن له المشتري الفا وماءتي درهم ودفعها اليه فضاعت عند كان الباءع مستوفيا حقه بالالف والزيادة امانة في يده ولا يلزمه شء بهلاكها وان ضاع نصفها كان الباقي بين الباءع والمشتري علي ستة لان المال المقبوض كان مشتركا بينهما علي ستة خمسة اسداسه للباءع والسدس للمشتري فما هلك يهلك علي الشركة وما بقي يبقي علي لشركة ولو ان الباءع عزل منها ماءتي درهم ليردها فضاع الماءتان عنده وبقي الالف كان الالف بينهما علي ستة ولو جعل الالف في كمه ودفع الماءتين الي غلامه ليردها فسرق الماءتان وسرق الالف من يده لا يرجع احدهما علي صاحبه بشء * رجل اشتري جارية بالف درهم ودفع الي الباءع كيسا علي ظن ان فيه الف درهم فذهب به الباءع الي منزله فاذا <> فيه دنانير فحملها ليردها الي المشتري فهلكت في الطريق لا يضمن الباءع شيءا لانه قبض باذن المشتري ما ليس من جنس حقه فكان امينا * ولو ان المشتري دفع الي الباءع دراهم صحاحا فكسرها الباءع فوجدها نبهرجة كان له ان يردها علي المشتري ولا يضمن بالكسر لان الصحاح والمكسرة فيه سواء *

 الدراهم انواع جياد وزيوف ونبهرجة وستوقة * واختلفوا في تفسر هذه الدراهم قال بعضهم النبهرجة هي التي تضرب في غير دار السلطان والزيوف هي الدراهم المغشوشة والستوقة هي صفر مموه بالفض وقال عامة المشايخ الجياد فضة خالصة تروج في التجارات وتءخذ في بيت المال والزيوف مازيفه بيت المال وياخذها التجار في التجارات ولا باس بالشراء بها لكن يبين للباءع انها زيوف والنبهرج ما يبرهجه التجار ولا يروج في التجارات ولها حكم الدراهم في الشرع حتي لو تجوز بها في السلم والصرف يجوز * والستوقة فارسي معرب سه تاقه وهو ان يكون الطاق الاعلي فضة والاسفل كذلك وبينهما صفر ليس لها حكم الدراهم في الشرع حتي لو تجوز بها في الصرف والسلم لا يجوز وانما لا يضمن كاسر النبهرجة لانه لا قيمة لهذه الصنعة فيدها علي المشتري بغير شء وكذا لو دفع النبهرجة الي انسان لينظر فيه فكسره لا يضمن * ولو باع شيءا بدراهم جياد وقبض الدراهم واراها رجلا فانتقدها فوجد فيها قليل نبهرجة واستبدل النبهرجة ثم اراد الباءع صرف الكل في حاجته فلم ياخذها احد وقالوا كلها نبهرجة قالوا ان كان الباءع اقر بقبض الجياد او اقر بقبض حقه او باستيفاء الثمن لا يرد شيءا ولا تسمع دعواه اهنها نبهرجة الا اذا صدقه المشتري انها نبهرجة فيدها عليه وان لم يكن الباءع اقر بما قلنا ثم ادعي انها نبهرجة سمع دعواه فكان له ان يرد * ولو اشتري شيءا بدراهم نقد البلد ولم يقبض حتي تغيرت فان كانت لا تروج في التجارات فسد البيع وهو بمنزلة ما لوز اشتري شيءا بالفلوس الراءجة فكسدت قبل القبض وقد مر قبل ذلك وان كانت الدراهم بعد التغير تروج في التجارات الا انه انتقصت قيمتها لا يفسد البيع ولم يكن له الا ذلك وعن ابي يوسف رحمه الله تعالي له ان يفسخ البيع في نقصان القيمة ايضا * وان انقطعت تلك الدراهم اليوم كان عليه قيمة تلك الدراهم قبل الانقطاع عند محمد رحمه الله تعالي وعليه الفتوي * وكذا لو اشتري بالفلوس شيءا فكسدت فسد البيع عند ابي حنيفة رحمه الله تعالي وان غلت او رخصت لا يفسد * ولو باع عرضا بالدراهم وسلم العرض ولم يقبض الدراهم حتي صارت لا تنفق ولا تروج في التجارات فان كانت لا تنفق في هذه البلدة وتنفق في غيرها علي قول محمد رحمه الله تعالي لا يكون ذل كساد لكن يثبت الخيار للباءع ان شاء اخذ تلك الدراهم وان شاء اخذ قيمتها في قول ابي حنيفة رحمه الله تعالي وان كانت لا تنفق في هذه البلدة ولا في غيرها من البلدان كان ذلك كسادا عند الكل يفسد العقد عند ابي حنيفة <> رحمه الله تعالي وعندهما يثبت الخيار ولا يفسد العقد * رجل اشتري شيءا بدوانق فلس ولم يذكر العدد في القياس لا يجوز البيع ويجوز استحسانا وعليه الفتوي * ولو اشتري بدرهم فلس في القياس لا يجوز وفي الاستحسان يجوز يءخذ بالقياس ههنا وقيل فيه خلاف بين ابي يوسف ومحمد رحمهما الله تعالي القياس قول محمد رحمه الله تعالي والاستحسان قول ابي يوسف رحمه الله تعالي واخذوا بقول محمد رحمه الله تعالي في درهم فلس انه لا يجوز * ولو اشتري شيءا بدانق او بدانقين ولم يذكر شيءا لا الدراهم ولا الفلوس قالوا يصرف ذلك الي الدانق من الفلوس وهذا اذا كان المشتري شيءا خسيسا يشتري بدوانق فلس وعن ابي يوسف رحمه الله تعالي اذا اشتري دارا بعشرة ولم يزد علي ذلك فهو عشرة دنانير وان اشتري ثوبا بعشرة فهي عشرة دراهم وان اشتري بطيخا بعشرة فهي عشرة افلس المعتبر في هذا عرف الناس من يباع بالدناينر كانت العشرة من الدنانير وما يباع بالدراهم كانت العشرة من الدراهم * رجل اشتري الف درهم بماءة دينار ولم يسلم كل واحد منهما شيءا فلكل واحد منهما نقد الناس في البلد ان كانا بالكوفة فهي علي دنانير الكوفة لان الدنانير تختلف باختلاف البلاد من حيث العيار * واهل الشروط ذكروا في شروطهم في الدراهم وزن سبعة وارادوا بذلك ان يكون وزن عشرة دراهم سبعة مثاقيل واصل ذلك ان الدراهم كانت مختلفة في عهد عمر رضي الله عنه بعضها خفاف يزن الواحد منها عشرة قراريط وبعضها ثقال يزن الواحد منها عشرين قيراطا وبعضها بين الخفاف والثقال يزن الواحد منها اثني عشر قيراطا وبسبب ذلك تقع الخصومة بين الناس في تجاراتهم فشاور عمر الصحابة رضي الله عنهم في ذلك فاتفقوا علي ان يءخذ من كل نوع ثلاثة فاخذوا ثلث العشرة وثلث العشرين وثلث اثني عشر فبلغ ذلك اربعة عشر قيراطا فضربوا درهما وزنه اربعة عشرة قيراطا ووزن الدينار عشرون قيراطا وكان وزن الدينار عشرون قيراطا وكان وزن عشرة دراهم سبعة مثاقيل * رجل قال لغيره بعت منك هذا الثوب بعشرة دراهم صحاح ومكسرة جاز ويكون النصف من هذا والنصف من ذاك * ولو باعه بعشرة دراهم بعضها ن الصحاح  وبعضها من المكسرة فسد البيع * باع عبدا بثوب موصوف في الذمة ان ذكر للثوب اجلا جاز وان لم يذكر له اجلا لا يجوز لان الثوب لا يجب في الذمة بعقد المعاوضة الا سلما والسلم لا بذله من الاجل فان ذكر للثوب اجلا فافترقا قبل قبض العبد لا يفسد العقد وهذا العقد يعتبر بيعا في حق العبد سلما في الثوب ويجوز ان يكون للعقد الواحد حكم عقدين كالهبة بشرط العوض وتعليق العتق باداء المال * رجل باع ثوبا ثم لقيه المشتري فقال انك قد اغليت علي وبعتني باكثر مما يساوي وقد كان باعه بعشرين فقال الباءع قد بعتك بعشرة لا بعشرين فهو جاءز وهو حط وكذا لو قال الباءع للمشتري قد ارخصت عليك وبعتك بنصف الثمن فقال المشتري اشتريته بعشرين جاز ويكون زيادة في الثمن * ولو لقيه الباءع فقال بعد ما قبل المشتري بعتك ثانية <> بعشرة فقبل المشتري اشتريت منك ثانية بعشرين وتراضيا علي ذلك ينتقض البيع الاول وينعقد الثاني ولا يشبه هذا اذا ذكر الغلاء والرخص فان ذلك زيادة وحط * رجل اشتري شيءا بالف درهم فقال المشتري بعد البيع نويت في قلبي نقد كذا وقال بالباءع نويت نقد كذا لا جود من ذلك فهو باطل وله نقد البلد فان كان نقدهم مختلفا كان ذلك علي الغالب وان استويا فسد البيع {فصل في الاجل} * رجل اشتري متاعا بالف درهم الي عشرة اشهر علي ان يعطيه الثمن اي نقد كان يومءذ كان البيع فاسدا *رجل باع شيءا بالف درهم علي ان يعطيه علي التفاريق ان كان ذلك شرطا في البيع لا يجوز البيع وان لم يكن ذلك شرطا في البيع وانما ذكر ذلك بعد البيع كان للباءع ان ياخذه بالثمن جملة * رجل باع عبدا بالف علي ان ينقده كل اسبوع بعض الثمن حتي ينقده خمسماءة عند مضي الشهر كان فاسدا * رجل اشتري من القصاب كل يوم لحما بدرهم وكان القصاب يقطع له اللحم ويضعه في الميزان ويزن والمشتري يظن انه من لان اللحم يباع في البلد منا بدرهم فوزن المشتري اللحم يوما فوجده ثلاثين استارا وصدقه القصاب في ذلك قالوا ان كان المشتري من اهل البلد يرجع علي القصاب بحصة النقصان من الثمن ولا يرجع بحصة النقصان من اللحم لان الباع اخذ حصة النقصان من الثمن بغير عوض فيرجع عليه بذلك وان كان المشتري من غير اهل البلد او كان القصاب ينكر انه دفع اليه علي انه من فان المشتري لا يرجع علي القصاب بشء لان سعر البلد لا يظهر في حق الغرباء * بلدة اصطلح اهلها علي سعر اللحم والخبز وشاع ذلك فجاء رجل غريب الي الخباز فقال اعطني خبزا بدرهم او جاء الي قصاب وقال اعطني لحما بدرهم فاعطاه اقل مما يباع في البلد والمشتري لا يعلم بذلك ثم علم قالوا يرجع في الخبز بحصة النقصان من الثمن لان البيع وقع علي الوزن الذي شاع في البلد فاذا اوجده اقل يرجع بالنقصان لان في قدر النقصان باع خبزا غير معين ولم يوجد التعاطي وفي اللحم لا يرجع بشء لان سعر اللحم لا يشيع كما يشيع سعر الخبز فلا يظهر في حق الغرباء * رجل اشتري شيءا بثمن الي النيروز ذكر في الاصل انه لا يجوز قالوا هذا اذا لم يعلم الباءع والمشتري بما بقي غلي النيروز فان علما جاز * اشتري شيءا بثمن الي سنة كان علي الباءع تسليم المبيع في الحال فان لم يسلم حتي مضت السنة قال ابو حنيفة رحمه الله تعالي يعتبر الاجل من وقت التسليم وكذا لو كان في البيع خيار يعتبر الاجل من وقت سقوط الخيار عنده واجمعوا علي انه لا يكون للباءع ان يحبس المبيع لاستيفاء الثمن بعد السنة من وقت البيع * ولو باع شيءا بثمن غلي رمضان ولم يسلم حتي جاء رمضان لا يبقي الاجل ويجب الثمن علي المشتري في قولهم * رجل عليه الف درهم من ثمن بيع طالبه الطالب فقال ليس عندي شء فقال الطالب اذهب واعطني كل شهر عشرة لم يكن ذلك تاجيلا وكان له <> ياخذه بجميع الثمن في الحال * رجل قال لغيره بعت منك هذا الثوب بعشرة علي ان تعطيني كل يوم درهما وكل يومين درهمين فانه يعطي العشرة في ستة ايام درهما في اليوم الاول وثلاثة في اليوم الثاني ودرهما في اليوم الثالث وثلاثة في اليوم الرابع ودرهما في اليوم الخامس ودرهما في اليوم السادس * اما في الاول يعطيه درهما فظاهر وفي الثاني يعطيه ثلاثة لانه جعل اليوم اجلا للدرهم الواحد بكلمة توجب التكرار فكلما جاء يوم يلزمه درهم فيلزمه درهم في اليوم الثاني بمجء اليوم الثاني ودرهمان بمضي يومين ودرهم في اليوم الثالث بحلول نجم اخر ولم يحل للدرهمين اجل اخر وفي اليوم الرابع يلزمه ثلاثة دراهم بمجء اليوم الرابع ودرهما بمجء اجل اخر للدرهمين وفي اليوم الخامس يلزمه درهم بمجء اليوم الخامس ولم يحل للدرهمين اجل اخر بقي من العشرة درهم واحد يعطيه في اليوم السادس * من عليه الدين المءجل اذا قال برءت من الاجل او قال لا حاجة لي في الاجل لهذا الدين لم يكن ذلك ابطالا للاجل ولو قال ابطلت الاجل او قال تركت الاجل يصير الدين حالا وكذا لو قال جعلت هذا الدين  المءجل حالا يصير حالا علي هذا قالوا لو قال صاحب الدين لمديونه تركت ديني عليك او قال بالفارسية حق خويش تبودادم يكون ابراء * من عليه الدين المءجل اذا قضي الدين قبل حلول الاجل فاستحق المقبوض علي القابض او وجد المقبوض زيوفا فرده كان الدين عليه الي اجله * ولو اشتري صاحب الدين المءجل من مديونه بالدين المءجل شيءا وقبضه ثم تقايلا البيع لا يعود الاجل * ولو وجد صاحب الدين المءجل بالمشتري عيبا فرده بقضاء عاد الاجل * ولو كان بهذا الدين المءجل كفيل لا تعود الكفالة في الوجهين * صاحب الدين اذا وهب الدين من مديونه وبالدين كفيل فرد المديون الهبة عاد الدين علي المديون ولا تعود الكفالة * ولو ابرا المكفول عن الدين فرد الابراء بطل الابراء في حق الاصيل واختلف المشايخ رحمهم الله تعالي في براءة الكفيل التاخير ولو اخر الدين عن الاصيل فرد التاخير بطل * في حق الاصيل والكفيل جميعا {ويتصل بمساءل الثمن مساءل المرابحة} رجل اشتري دنانير بدراهم ثم باع الدنانير مرابحة لا يجوز لان الدنانير لا تتعين في البيع فم يكن المقبوض بعقد الصرف مبيعا في البيع الاول * ولو اشتري متاعا بالف درهم ببخارا ثم باعه بسمرقند بربح ماءة درهم كان راس ماله نقد بخاري والربح نقد سمرقند لان راس المال يصير مذكرا في عقد المرابحة فينصرف البيع الي ذلك اما الربح ماءة مطلقة فينصرف غلي نقد البلد الذي باع فيه مرابحة وان باعه بسمرقند بربح ديازده كان راس المال والربح من نقد بخارا لانه جعل الربح الجزء الحادي عشر فكان الكل من نقد واحد * ولو اشتري ثوبا بدراهم جياد ونقد الزيوف مكان الجياد ثم باعه مرابحة كان راس ماله الجياد لان البيع الاول كان بالجياد <> * رجل غصب عبدا فابق من يده فقضي القاضي عليه بقيمة العبد ثم عاد العبد من الاباق كان للغاصب ان يبيعه مرابحة علي القيمة التي غرم لانه ملك العبد بتلك القيمة لكن لا يقول اشتريته بكذا وانما يقول قام علي بكذا وان اشتري عبدا بخمر وقبضه فابق من يده وقضي القاضي عليه للباءع بقيمة العبد بحكم فساد البيع يكون له ان يبيعه مرابحة علي قيمته ويقول قام علي بكذا * ولو اشتري دابة او عبدا وقبضه واجره واخذ الاجرة ثم باعه مرابحة علي الثمن الذي اشتراه جاز وان لم يبين انه اجره واخذ الاجرة لان الاجرة بدل عن المنفعة لا عن شء من الذات الذي اشتراه وقد باع جميع ما اشتراه * رجل اشتري دحاجة وقبضها فباضت عنده عشرين بيضة او اكثر وباع البيض بدرهم ثم اراد ان يبيع الدجاجة مرابحة علي الثمن الذي اشتراها قالوا ان كان انفق علي الدجاجة بمقدار الثمن الذي باع به البيع جاز ويجعل ثمن البيض عوضا عما انفق وان لم ينفق لا يجوز لان البيض من اجزاء الدجاجة بخلاف الاجر {فصل في الاقالة والاستحقاق} * رجل باع امة فانكر المشتري الشراء لا يحل للباءع ان يطا الجارية ما لم يعزم علي ترك الخصومة لان البيع لا ينفسخ بجحود المشتري فان عزم الباءع علي ترك الخصومة جاز له ان يطاها لان جحود المشتري فسخ في حقه واذا عزم الباءع علي ترك الخصوم ثم انفسخ بتراضيهما حل له الوطء وكذا لو باع جارية ثم انكر البيع والمشتري يدعي لا يحل للباءع ان يطاها فان ترك المشتري الدعوي وسمع الباءع انه ترك الخصومة حل له الوطء وهذا كما لو اشتري جارية علي انه بالخيار ثلاثة ايام وقبض الجارية ثم ان المشتري رد علي الباءع في ايام الخيار جارية اخري وقال هي التي اشتريتها وقبضها كان القول قوله لانه انكر قبض غيرها فان رضي الباءع بها حل للباءع ان يطاها لان المشتري لما رد غير ما اشتري فقد رضي بتملك الباءع الثانية بالاولي فاذا رضي الباءع بذلك تم البيع بينهما بالتعاطي وكذا القصار اذا رد علي صاحب الثوب ثوبا له غير ثوبه ورضي به صاحب الثوب وكذا الاسكاف وغيرهما * رجل باع شيءا ثم قال للمشتري اقلني البيع فقال قد اقلتك لم يكن ذلك اقالة في قول ابي حنيفة ومحمد رحمهما الله تعالي في ظاهر الرواية حتي يقول الباءع بعد ذلك قبلت وعن ابي يوسف رحمه الله تعالي انه تتم الاقالة بقول المشتري قد اقلتك بعد ما قال له الباءع اقلني * باع من اخذ ثوبا فقال له المشتري قد اقلتك البيع في هذا الثوب فاقطعه قميصا فقطع الباءع قميصا قبل ان يتفرقا ولم يتكلم بشء كانت اقالة * رجل اشتري وقر حنطة بدراهم معلومة وقبض الحنطة وسلم بعض الثمن فجاء الباءع بعد ذلك يطب منه الباقي فقال له المشتري قام علي بثمن غال فرد الباءع ما قبض منه ولم يقل شيءا واخذ المشتري قالوا لا ينتقض البيع بينهما مال لم يرد المشتري المبيع علي الباءع * رجل اشتري حمارا وقبضه ثم جاء بعد ايام ورده علي الباءع فلم يقبل الباءع رده وقال لا اقبل ثم استعمله <>بعد ذلك اياما ثم اراد ان يرده علي المشتري ولا يرد الثمن كان له ذلك لانه لما قال لا اقبل بطل رد المشتري واقالته فلا ينفسخ  البيع بينهما باستعمال الباءع بعد ذلك لان الاستعمال وان كان دليلا علي الرضا غلا انه دون الصريح فلا يبطل به صريح الرد * رجل اشتري من رجل صابونا رطبا وقبضه فجف عند وانتقص وزنه بالجفاف ثم انهما تفاسخا البيع صح الفسخ ولا يجل علي المشتري شء من الثمن لاجل النقصان لانه ما فات شء من اجزاء المبيع * رجل اشتري لحما او سمكا او شيءا يتسارع اليه الفساد فذهب المشتري الي بيته ليجء بالثمن فطال مكثه وخاف الباءع ان يفسد كان للباءع ان يبيعه من غيره استحسانا وللمشتري الثاني ان يشتري من الباءع وان كان يعلم بذلك لان الباءع رضي بانفساخ البيع الاول والمشتري الاول كذلك ظاهرا ثم ينظر ان كان الثمن الثاني اكثر من الثمن الاول كان عليه ان يتصدق بالزيادة وان كان انقص فالنقصان يكون من مال الباءع ولا يكون علي المشتري الاول * رجل اشتري عبدا ثم ادعي انه باعه من الباءع باقل مما اشتراه قبل نقد الثمن وفسد البيع وادعي الباءع انه اقاله البيع كان القول قول المشتري في انكار الاقالة مع يمينه * ولو كان الباءع يدعي انه اشتراه من المشتري باقل مما باعه والمشتري يدعي الاقالة يحلف كل واحد منهما علي دعوي صاحبه * الاقالة فسخ في حق المتعاقدين عند ابي حنيفة رحمه الله تعالي * تقايلا باكثر من الثمن الاول او باقل او بجنس اخر كانت الاقالة بالثمن الاول ويبطل ذكر الثمن الثاني * ولا تصح الاقالة بعد الزيادة الحادثة بعد القبض ولا تصير الاقالة بيعا وعلي قول ابي يوسف رحمه الله تعالي الاقالة بيع فان تعذر جعلها بيعا بان كان المبيع منقولا وتقايلا قبل القبض يصير فسخا وعلي قول محمد رحمه الله تعالي الاقالة فسخ فان تعذر جعلها فسخا بان تقايلا بعد حدوث الزيادة عند المشتري يصير بيعا * الوكيل بالبيع يملك الاقالة قبل قبض الثمن في قول ابي حنيفة ومحمد رحمهما الله تعالي واما الوكيل بالشراء ذكر الشيخ الامام شمس الاءمة السرخسي والشيخ الامام المعروف بخواهر زاده بانه لا يملك الاقالة * اما الوكيل بالاجارة اذا ناقض الاجارة مع المستاجر قبل استيفاء المنفعة وقبل قبض الاجر صح ذلك منهما سواء كان الاجر عينا او دينا ولو وهب الوكيل الاجر من المستاجر او ابراه عن ذلك فان كان الاجر شيءا بغير عينه او كان دينا ولم يشترط التعجيل جازت هبته وابراءه ويكون ضامنا للامر في قول ابي حنيفة ومحمد رحمهما الله تعالي كما في الوكيل بالبيع وان كان الاجر شيءا بعينه لا يصح ابراء الوكيل وهبته بعد استيفاء المنفعة وبعد التعجيل * رجل اشتري عبدا بالف درهم ودفع الثمن ولم يقبض العبد فقال للباءع بعد ما لقيه وهبت لك العبد والثمن كان ذلك نقضا للبيع ولا تصح هبة الثمن * رجل اشتري من رجل عبدا بامة وتقابضا ثم ان اشتري العبد باع نصف العبد من رجل ثم اقال البيع في الامة بعد ذلك جازت الاقالة وكان عليه لباءع العبد قيمة العبد وكذا لو لم يبع لكن قطعت <> يد العبد واخذ الارض ثم اقال البيع في الامة {مساءل الاستحقاق} رجل اشتري جارية وباعها من غيره فتداولتها الايدي فادعت عند المشتري الرابع انها حرة فردها الرابع علي الثالث بقولها والثالث علي الثاني وابي الباءع الاول ان يقبلها قالوا ان كانت الجارية ادعت العتق فله ان لا يقبل الجارية بقولها وان كانت ادعت انها حرة الاصل وقد انقادت للبيع والتسليم بان يبعث وسلمت الي المشتري وهي ساكتة فللباءع ايضا ان لا يقبلها لان انقيادها علي هذا الوجه بمنزلة الاقرار بالرق * ولو اقرت بالرق ثم ادعت العتق لا يقبل قولها الا ببينة وان انكرت البيع والتسليم ليس للباءع الاول ان لا يقبلها لانها اذا لم تقر بالرق فالقول قولها في الحرية وكان للمشتري ان يرجع علي الباءع بالثمن كما لا ثبتت الحرية بالبينة * وقال بعضهم اذا ادعت الحرية لم يكن له ان يردها علي الباءع بقولها لكن ينبغي ان يتزوجها احتياطا حتي يحل له وطءها اما بملك اليمين ان كانت امة او بملك النكاح ان كانت حرة وكذا كل من اشتري جارية ينبغي له ان يتزوجها احتياطا * رجل اشتري عبدا شراء صحيحا فجاء رجل وادعي انه كان له اعتقه منذ سنة فان القاضي يسال المدعي البينة علي ما يدعي من الملك ولا يساله البينة علي الاعتاق لانه اذا ثبت الملك يثبت العتق باقراره وان لم يكن له بينة علي الملك كان له ان يستحلف المشتري علي دعوي الملك * رجل اشتري عبدا واختلفا في الثمن وحلف كل واحد منهما بعتقه فقال الباءع ان بعته الا بالف درهم فهو حر وقال المشتري ان اشتريته الا بخمساءة درهم فهو حر لزم العبد للمشتري ويجبر المشتري علي الثمن الذي اقر به ولا يعتق العبد لان الباءع يدعي ان المشتري حنث في يمينه وعتق عليه العبد فتعذر عليه فسخ البيع ولا يعتق علي المشتري باقرار الباءع وكان علي المشتري الذي اقر به لانه ينكر الزيادة *

 رجل اشتري ارضين من رجل فاذا احدهما لغير الباءع ولم يعلم المشتي بذلك قبل البيع فان علم قبل القبض كان له الخيار ان شاء نقض البيع ويرجع بجميع الثمن وان شاء اخذ غير المستحق بحصتها من الثمن لان الصفقة تفرقت قبل التمام وان علم بذلك بعد القبض يلزم غير المستحق بحصتها من الثمن ولا خيار له لان الارضين بمنزلة شيءين مختلفين كالثوبين والعبدين * مستاجر حانوت في يده كر دار حانوت يدعي انه له فباع الكر دار من رجل وسلم الكردار وقبض الثمن ثم جاء صاحب الحانوت وادعي ان الكردار له ولم يكن للمستاجر وحال بين المبيع وبين المشتري قالوا ان كان الكردار من الالات التي يحتاج المستاجر اليها في صناعته وتجارته لم يكن للمشتري ان يرجع علي الباءع بالثمن ويكون القول في ذلك قول المستاجر وان كان الكردار بناء بان كان علوا علي سفل الحانوت وكان ذلك في يد المستاجر كان القول فيه ايضا قول المستاجر ولا يرجع المشتري علي الباءع بالثمن لعدم استحقاق المبيع وان كان المبيع بناء متصلا ببناء الحانوت كان القول فيه قول صاحب الحانوت لان ما يكون متصلا ببناء الحانوت قاءما <> لا يكون حادثا فلا يكون القول فيه قول المستاجر واذا جعل القول في ذلك قول صاحب الحانوت صار المبيع مستحقا فيرجع المشتري بالثمن علي الباءع * رجل اشتري عبدين من رجل بالف درهم وقبضهما ثم استحق نصف احدهما فان العبد الثاني يكون لازما للمشتري بحصته من الثمن وله الخيار في العبد الذي استحق يصفه في قول ابي حنيفة رحمه الله تعالي * رجل اشتري امة وقبضها ونقد الثمن ثم استحقها رجل بالبينة فاراد المشتري ان يرجل علي الباءع بالثمن فقال له الباءع قد علمت انهم شهود زور شهدوا بالباطل وان الامة لي فقال المشتري انا اشهد ان الامة لك وانهم شهدوا بزور لا يبطل رجوعه بالثمن علي الباءع باقراره ذلك الا ان الجارية لو وصلت اليه يوما من الدهر بوجه من الوجوه يءمر بالرد علي الباءع * رجل في يديه عبد باع نصفه من رجل ولم يسلم حتي باع نصفه من اخر وسلم النصف اليه ثم جاء رجل استحق نصف العبد بالبينة كان المستحق من البيعين جميعا وان كان المشتري الاول قبض المبيع ولم يقبض الثاني ينصرف الاستحقاق الي الثاني دون الاول وان قبضاه جميعا كان المستحق منهما جميعا * رجل له ثلاثة اقفزة حنطة باع منها قفيزا من رجل اخر ثم باع منها قفيزا من ثالث ثم كال لهم الاقفزة الثلاثة ثم جاء رجل واستحق من الكل قفيزا فان المستحق ياخذ القفيز الثالث لان صاحب اليد حين باع القفيز الاول باع ما يملكه وباع القفيز الثاني وهو يملكه وباع القفيز الثالث وهو لا يملكه * رجل اشتري دارا وقبضها ثم جاء وادعي نصفها فاقام المشتري البينة انه اشتراها من المستحق ولم يءقت قال محمد رحمه الله تعالي لا يرجع المشتري علي الباءع بنصف الثمن وانما هو هذا * رجل اشتري دارا من رجل فادعاه اخر واشتراها منه ايضا فانه لا يرجع علي الباءع بالثمن ولو اقام المشتري البينة انه اشتراها منه بعد الاستحقاق فان المشتري يرجع علي الباءع بنصف الثمن * رجل اشتري من رجل عبدا وقبضه ثم وهبه من اخر فاستحق من يد الموهوب له قال ابو يوسف رحمه الله تعالي للمشتري ان يرجع علي الباءع بالثمن والصدقة بمنزلة الهبة ولم يذكر في الكتاب خلافا في هذه المسالة * وكذا لو اشتري عبدا وقبضه ثم وهبه لرجل فوهبه الموهوب له من رجل اخر وسلمه اليه فاستحق من يد الموهوب له الثاني كان للمشتري ان يرجع بالثمن علي باءعه حتي يرجع المشتري الثاني علي الموهوب له فاذا رجع حينءذ يرجع المشتري الاول علي باءعه * رجل استحق من يده شء بشهادة شاهدين عدلهما المشهود عليه قال ابو يوسف رحمه الله تعالي اسال عن الشاهدين فان عدلا رجع المقضي عليه بالثمن علي باءعه وان لم يعدلا فانه يقضي علي المشهود عليه لانه عدلهما ولا يرجع هو بالثمن علي باءعه وهو بمنزلة الاقرار * وكذا لو وكل رجلا بالخصومة فزكي الوكيل الشاهدين وهذا <> ظاهر فيما اذا وكل بالخصومة استثني في التوكيل تعديل الشهود * رجل اشتري غلاما وقبضه فاستحقه رجل بالبين وقبضه ثم ان المستحق اجاز الشراء جازت اجازته حتي لا يرجع المشتري علي الباءع بالثمن وكان للمستحق ان يرجع علي الباءع بالثمن لان البيع الماضي لا يبطل بالاستحقاق فاذا اجاز صحت اجازته يصير الباءع وكيلا في البيع وهذه مسالة اختلفت فيها الروايات * قال الشيخ الغمام شمس الامة الحلواني رحمه الله تعالي ظاهر المذهب من اصحابنا ان البيع لا يبطل بالاستحقاق بل يبقي موقوفا ما لم يرجع المقضي عليه بالثمن علي باءعه * رجلان اشتريا عبدا فاستحق نصفه كان لهما لخيار فان رضي احد المشتريين واسقط الخيار سلم له ربع العبد يرجع بربع الثمن وللمشتري الاخر ان يرد ربع العبد علي باءعه ويرجع بنصف الثمن وهو قول ابي يوسف ومحمد  رحمهما الله تعالي اما في قياس قول ابي حنيفة رحمه الله تعالي اذا اسقط احدهما الخيار لم يكن للاخر ان يرد لان عند ابي حنيفة رحمه الله تعالي من له الخيار في العبد لا يرد النصف واحد المشتريين بشرط الخيار لا ينفرد بالرد * رجل ادعي علي رجل ان المدعي باع من المدعي عليه وفلانا الغاءب عبدا بالف درهم بحضرة العبد واقام البينة فان القاضي يقضي للمدعي علي لحاضر بنصف الثمن ولا يقضي ببيع الكل لان الحاضر ليس بخصم عن الغاءب فان حضر الغاءب بعد ذلك ان اعاد المدعي البينة بحضرته يقضي للمدعي علي الحاضر بنصف الثمن غلا اذا كان كل واحد منهما كفيلا بالثمن عن صاحبه بامره فيكون القضاء علي احدهما قضاء علي الاخر * رجل باع عقارا وسلم امراته او ولده او بعض اقاربه حاضر ولم يقل شيءا ثم ادعي علي المشتري من كان حاضرا وقت البيع ان العقار له اختلف المشايخ فيه قال مشايخ سمرقند لا تسمع دعواه * وقال مشايخنا تسمع دعواه فينظر المفتي في ذلك ان كان في رايه ان لا يسمع هذه الدعوي وافتي بذلك كان حسنا ليكون سدا لباب التزوير وان لم يكن له راي في ذلك يفتي بقول مشايخنا رحمهم الله تعالي لان الفضولي اذا باع مال الغير وصاحب المال حاضر ولم يقل شيءا لم يكن سكوته اجازة وهذا اذا لم يكن السلطان استثني في تقليد القاضي سماع هذه الدعوي * رجل باع عقارا ثم ادعي انه باع ما هو وقف اختلف المشايخ فيه * والصحيح انه لا تسمع دعواه * بخلاف ما لو اشتري عبدا ثم ادعي ان حر حيث تسمع دعوي المشتري لان الوقف لا يزيل الملك ولا يخرجه من ان يكون محلا للبيع اما الحر ليس بمحل للبيع وثمنه لا يملك فكان المشتري مدعيا دينا علي الباءع * ولهذا لو جمع بين الوقف وغير الوقف وباع الكل صفقة واحد فانه يجوز البيع في غير الوقف * ولو جمع بين حر وعبد وباعهما صفقة واحدة لا يجوز البيع في القن * عبد اشتري نفسه من مولاه ومعه رجل اخر بالف درهم صفقة واحدة ذكر في المنتقي انه يجوز البيع في حصة العبد <> وفي حصة الشريك باطل * ولا يشبه هذا الاب الا اشتري ولده من رجل اجنبي فانه يجوز العقد في الكل {باب في بيع مال الربا بعضه ببعض} في الباب فصلان فصل في البيع وفصل اخر في الاحتراز عن الربا والخارج عنه * اما الاول قالوا لا تباع المسبية وهي الغالب عليها الصفر في الغطريفي واحد باثنين * وذكر محمد رحمه الله تعالي في الكتاب انه يجوز بيع الدراهم التي ثلثاها صفر وثلثها فضة واحد باثنين وقال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي في عرفنا لا يجوز بيع المسبية من الغطريفي بالمسبيتين لانها صارت ثمنا لجميع الاشياء بمنزلة الذهب والفضة ولهذا قلنا بوجوب الزكاة في الماءتين منها ولا يجوز بيع المحلوج من القطن بغير المحلوج الا مثلا بمثل وكذا بيع الثمر المشقوق الذي استخرج منه النوي بغير المشقوق وكذا بيع الدقيق المنخول بغير المنخول * وبيع النخالة بالدقيق عند ابي يوسف رحمه الله تعالي لا يجوز الا بطريق الاعتبار وهو ان تكون النخالة الخالصة اكثر من النخالة في الدقيق وعند محمد رحمه الله تعالي اذا تساويا وزنا يجوز * وبيع الخبز بالحنطة والحنطة بالخبز وبيع الدقيق بالخبز والخبز بالدقيق قال بعض مشايخنا رحمهم الله تعالي لا يجوز لا متساويا ولا متفاضلا قبل هذا قول ابي حنيفة رحمه الله تعالي كما قال في بيع الحنطة بالدقيق هكذا ذكر الطحاوي رحمه الله تعالي قال بعضهم يجوز متساويا ومتفاضلا وعليه الفتوي لان الحنطة كيلي وكذا الدقيق والخبز وزني فيجوز بيع احدهما بالاخر متساويا ومفاضلا اذا كانا نقدين فان كان احدهما نسيءة ان كان الخبز نقد اجاز عند اصحابنا وان كانت الحنطة او الدقيق نقدا والخبز نسيءة لا يجوز في قول ابي حنيفة رحمه الله تعالي لانه لا يجوز السلم في الخبز وعند ابي يوسف رحمه الله تعالي يجوز وهو رواية عن ابي حنيفة رحمه الله تعالي لانه يجوز السلم في الخبز * والفتوي في بيع الحنطة والدقيق بالخبز علي قول ابي يوسف رحمه الله تعالي ولا يجوز بيع الحنطة بالحنطة وزنا وان تساويا لان الحنطة كيلي فلا يجوز بيعها بجنسها الا بشرط التماثل في الكيل فان بيع وزنا وعلم انهما يتماثلان في كيل قيل بانه يجوز * وكذا بيع الدقيق بالدقيق وزنا لان الدقيق كيلي ولهذا لا يجوز بيع الحنطة بالدقيق وزنا ولو كان وزنيا جاز هذا اذا باع من الحنطة قدر ما يدخل تحت الكيل وزنا فان كانت الحنطة قليلا لا يدخل تحت الكيل جاز كما لو باع الحفنة بالحفنتين وادني ما يدخل تحت الكيل نصف صاع فان باع صاعا من الحنطة الرديءة بنصف صاع جيد من الحنطة او باع نصف صاع من الحنطة بما دون نصف صاع منها لا يجوز اذا كان في احد  الجانبين مقدار ما يدخل تحت الكيل وان باع ما دون نصف صاع من الحنطة بما دون نصف صاع واحدهما اكثر من الاخر جاز كما لو باع الحفنة بالحفنتين * ولو باع الحنطة بالشعير متفضلا يدا بيد جاز وان كان في الشعير حبات الحنطة قدر ما يكون في الشعير <> وكدا لو بيعت الحنطة بالحنطة لا يجوز الا متساويا ولو كان في كل واحد من الجانبين حبان شعير لان مالا يخلو عنها الحنطة من حبات الشعير مغلوب بالحنطة فكان مستهلكا * باع الخل بالعصير متفاضلا لا يجوز لان العير يصير خلا في الحال الثاني فيكون بينهما شبهة المجانسة في الحال * القز مع الابريسم بمنزلة الدقيق مع الحنطة ولا باس بيع شاة علي ظهرها صوف بصوف اذا كان الصوف المجزوز اكثر مما كان علي ظهر الشاة وكذا الشاة التي في ضرعها لبن بلبن وعن ابي يوسف رحمه الله تعالي انه في اللبن يجوز لا بطريق الاعتبار والصحيح هو الاول * وان كان اشتري شاة بلحمها فهو علي وجوه ثلاثة ان اشتري بلحم الشاة مذبوحة مسلوخة واستخرج شحمها وامعاءها ان تساويا وزنا جاز والا فلا وان اشتري بلحم الشاة مذبوحة غيرة مسلوخة ان حان اللحم اقل مما في المذبوحة او مثله او لا يدري لا يجوز وان كان اللحم اكثر مما في المذبوحة جاز * وان اشتري باللحم شاة حية في القياس لا يجوز الا ان يعلم ان اللحم اكثر من لحم الشاة وهو قول محمد رحمه الله تعالي وفي الاستحسان علي كل حال وهو قولهما * ولو باع قفيزا من حنطة مبلولة بقفيز من مثلها او اشتري قفيزا من الرطبة التي خرجت من سنبلها بمثلها او المبلولة باليابسة او الرطبة باليابسة او باع قفيزا من التمر الذي اصابه ماء او انتفخ بمثله او الزبيب الذي اصابه ماء بمثله جاز البيع في جميع ذلك في قول ابي حنيفة رحمه الله تعالي ولا يعتبر التفاوت الذي يكون بينهما عند الجفاف وكذلك عند ابي يوسف رحمه الله تعالي الا في الحنطة الرطبة باليابسة فان ذلك لا يجوز عنده كما لا يجوز بيع الرطب بالتمر عنده وعند محمد رحمه الله تعالي لا يجوز بيع الرطبة بالرطبة ولا المبلولة بالمبلولة ولا الزبيب المنتفخ او التمر المنتفخ بغير المنتفخ ولا الرطبة باليابسة ولا المبلولة باليابسة غلا ان يعلم تساويهما في الكيل بعد الجفاف الا بيع الرطب بالرطب قفيزا بقفيز فانه يجوز ذلك وان كان احدهما اكثر نقصانا من الاخر عند الجفاف ولا باس ببيع الناطف بالتمر متفاضلا الا ان يكون ذلك في موضع يباع التمر فيه وزنا فانه لا يجوز بيع البعض بالبعض الا مثلا بمثل * ولا باس ببيع لحوم الطير واحدا باثنين يدا بيد ولا خير فيه نسيءة * وكذا الالية واللحم وشحم البطن اجناس مختلفة يجوز بيع البعض بالبعض متفاضلا يدا بيد ولا خير فيه نسيءة * والسمن جنس * اللحم لا يباع باللحم الا متساويا * لحم المعز والضان ولبنهما جنس واحد لا يجوز البيع فيه غلا مثلا بمثل * صوف الغ