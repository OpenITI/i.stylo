 [فصل في اجارة الدواب والضمان فيما يجب وفيما لا يجب ]  رجل تكاري ابلا مسمي بغير عينها من كوفة الي مكة باجر معلوم ذكر في الكتاب انه يجوز قالوا لم يرد بهذا ان يءجر ابلا بغير عينها فان ذلك لا يجوز وانما اراد به ان ينقل المكاري الحمولة فقال له المستكري احملني الي مكة علي ابل فيكون المعقود عليه في الذمة وبعضهم اجروا الجواب علي اطلاق الكتاب وجوزوا ذلك لمكان العادة * رجل استاجر دابة ليطحن بها كل يوم بدرهم وبين ما يطحن من الحنطة او الشعير ونحو ذلك ذكر في الكتاب انه يجوز وان لم يبين مقدار ما يطحن وهكذا قال بعض المشايخ وقال الشيخ الامام المعروف بخواهر زاده لا بد من بيان مقدار ما يطحن كل يوم وعليه الفتوي *رجل اكتري ابلا من بخارا الي بغداد او للحج ثم اختلفا في وقت الخروج من بخارا فالقول في ذلك قول من يريد الخروج في الوقت المعروف للخروج لاهل بخارا * رجل اكتري ابلا من الكوفة الي مكة للحج ذاهبا وجاءيا كان له ان يركبها يوم التروية ويوم عرفة ويوم النحر وثلاثة ايام التشريق *رجل استاجر اجيرا يوما ليعمل له كذا قالوا ان كان العرف بينهم انهم يعملون من طلوع الشمس الي العصر فهو علي ذلك وان كان العرف انهم يعملون من طلوع الشمس الي غروب الشمس فهو علي ذلك وان كان العرف مشتركا فهو علي طلوع الشمس الي غروبها اعتبارا لذكر اليوم * رجل استاجر بعيرا للحمل فحمل البعير في العرف هو الوسق وهو بالامناء ماءتان واربعون منا *رجل استاجر دابة الي سمرقند او غيرها من الامصار فاذا دخلها كان له ان ياتي بها الي منزله استحسانا* رجل استاجر دابة او عبدا فان مءنة الرد بعد الفراغ علي صاحب الدابة والعبد وكذا مءنة رد الرهن تكون علي الراهن ومءنة رد الوديعة علي صاحبها ومءنة رد المستعار علي المستعير ومءنة رد الغصب تكون علي الغاصب وكذا مءنة رد المبيع بيعا فاسدا بعد الفسخ تكون علي القابض* رجل استاجر دابة ليحمل عليها حملا مقدرا وحمل ثم اراد صاحب الدابة ان يضع عليها شيءا من متاعه مع حمل المستاجر كان للمستاجر ان يمنعه فان وضع مع ذلك وبلغت الدابة الي الموضع الذي سماه كان علي المستاجر جميع الاجر المسمي وليس هذا كصاحب الدار اذا شغل بعض الدار المستاجرة سقطت حصة ذلك الموضع الذي شغله صاحب الدار من الاجر *رجل استاجر دابة وقبضها كان له ان يءاجرها ويعيرها ويودعها هكذا قال في الكتاب وهذا انما يستقيم فيما لا يتفاوت فيه الناس اما اذا استاجرها لركوب نفسه ليس له ان يركب غيره *رجل استاجر دابة ليركبها الي مكان معلوم فركب وحمل مع نفسه حملا فعطبت الدابة يضمن من قيمتها مقدار الزيادة وطريق معرفة مقدار الزيادة الرجوع الي اهل البصر ان هذا الحمل كم يزيد علي ركوبه في الثقل هذا اذا ركب ووضع الحمل في غير الموضع الذي يركب وان ركب علي موضع الحمل يضمن جميع القيمة *رجل استاجر دابة ليذهب بها الي موضع كذا فركبها في المصر في حواءجه يكون مخالفا حتي لو عطبت الدابة من ركوبه يضمن قيمتها *رجل استكري دابة لمسيرة فرسخ فسار عليها سبعة فراسخ كان عليه الاجر المسمي للفرسخ وفيما زاد علي الفرسخ يكون غاصبا ولا اجر عليه وان ارضي المستاجر صاحب الدابة بشء كان افضل *رجل استاجر حمارا ليحمل عليه وقر حنطة الي المدينة فحمل عليها الحنطة الي المدينة فلما انصرف من المدينة حمل في انصرافه علي الحمار قفيزا من ملح فمرض الحمار[] في الطريق وهلك يضمن قيمة الحمار اذا حمل عليه الملح بغير اذنه *ولو استاجر دابة ليحمل عليها حنطة من موضع معلوم الي منزله يوما الي الليل فكان يحمل الحنطة الي منزله وفي الذهاب الي موضع الحنطة ثانيا يركب الدابة فعطبت الدابة قال بعضهم يضمن قيمة الدابة لانه استاجرها للحمل دون الركوب فيصير غاصبا بالركوب* وقال الفقيه ابو الليث رحمه الله تعالي لا يضمن لان العادة فيما بين الناس الركوب في هذا الموضع حتي لو لم يكن ذلك عادة لهم كان ضامنا *رجل استاجر حمارا ليحمل عليه اثني عشر وقرا من التراب الي ارضه بدرهم وصاحب الدابة يعرف ارضه فكلما عاد المستاجر من ارضه يحمل عليه وقرا من اللبن ان سلمت الدابة حتي فرغ من العمل وجب الاجر ولا يجب الضمان وان هلك الحمار وقالوا ان هلك في الرجوع مع اللبن يضمن قيمة الحمار ولا يجب الاجر لانهما لا يجتمعان قال المصنف رحمه الله تعالي وعندي يجب نصف دانق للوقر الاول مع قيمته لانه لم يكن غاصبا في ذلك الوقت وانما صار غاصبا بعده فيجب الاجر للوقر الاول كما في مسالة الفراسخ وبعد ما صار غاصبا لا يجب الاجر اذا هلك الحمار وان سلم يجب كل الاجر لانه وان صار مخالفا لكن اذا سلمت الدابة يجب الاجر كما لو استاجر دابة الي موضع معين فجاوز ذلك الموضع وهلكت يضمن قيمتها وان سلمت الدابة يجب تمام الاجر * وكذا لو استاجر دابة ليركبها بنفسه فركبها واردف غيره فعطبت الدابة يضمن نصف القيمة وعليه نصف الاجر ان كانت الدابة تطيق ذلك وان سلمت كان عليه كل الاجر *رجل استاجر دابة للركوب الي الكوفة فجاوز  بها عن الكوفة مقدار ما لا يسامح فيه الناس وركب في تلك الزيادة او لم يركب ثم ردها الي الكوفة فتكون الدابة مضمونة عليه ما لم يردها الي صاحبها حتي لو هلكت في طريق الكوفة يضمن قيمتها ولا يسقط عنه شء من الاجر وهذا قول ابي حنيفة الاخر وهو قول صاحبيه رحمهما الله تعالي وكان ابو حنيفة رحمه الله تعالي يقول اولا اذا ردها الي الكوفة برء من الضمان ثم قال لا يبرا عن الضمان بازالة التعدي * وكذا المستعير بخلاف المودع وقال بعضهم برء في الكل عن الضمان بازالة التعدي وقال بعضهم اذا استاجرها ذاهبا وجاءيا برء وكذا المستعير وان استاجرها ذاهبا لا جاءيا لا يبرا عن الضمان في كل حال الا المودع *وذكر في الاصل اذا استاجرت المراة درعا لتلبسه ثلاثة ايام ان كان ثوب بذلة لها ان تلبسه قي الايام والليالي وان كان ثوب صيانة تلبسه في النهار وفي اول الليل وفي اخره وليس لها ان تلبسه كل الليل فان لبسته كل الليل ونامت فيه حتي جاء النهار برءت عن الضمان اذا لم يتخرق الثوب والفرق بين مسالة الثوب ومسالة اجارة الدابة علي القول المختار ما عرف في الاصل * وان استاجر دابة ليركبها الي مكان معلوم فلما سار بعض الطريق جحد الاجارة وادعي ان الدابة له يصير ضامنا حتي لو عطبت بعد الجحود قبل ان يركبها يضمن قيمتها وان جحد ثم ركبها بعد ذلك برء عن الضمان وكان عليه جميع الاجر *وقال ابو يوسف رحمه الله تعالي لا يجب الاجر للركوب بعد الجحود لانه صار غاصبا بالجحود * رجل استاجر دابة يوما للركوب كان له ان يركبها من طلوع الفجر الثاني الي غروب الشمس لان اليوم حقيقة اسم لما بعد طلوع الفجر الثاني الي غروب الشمس وليس ههنا عرف خلاف الحقيقة وفيما اذا استاجر اجيرا يوما تركت الحقيقة بحكم العرف *رجل تكاري دابة ليلا فانه يركبها عند غروب الشمس ويردها عند طلوع الفجر الثاني وان تكاري دابة نهارا لم يذكر هذا في الكتاب قال بعضهم يركبها من طلوع الشمس الي غروبها لا النهار اسم للبياض * وقال بعضهم هذا اذا []***كانا من اهل اللغة يفرقان بين اليوم والنهار اما العوام لا يفرقون بين ذلك يكون الجواب فيه كالجواب في اليوم * وان استاجر الي العشي تنقضي الاجارة بدخول وقت الظهر * رجل استاجر دابة ليركبها انسانا فاركبها امراة ثقيلة بسرج او رحل فعطبت لا يجب عليه الضمان ولا علي المراة الا ان يعلم ان مثل تلك الدابة لا تطيق حملها فيضمن قيمتها اذا عطبت * رجل استاجر دابة الي موضع معلوم ليركبها بنفسه فلم يركب واركب غيره وسلمت الدابة لا يجب الا جر وان عطبت يضمن قيمتها وان ركب بنفسه واردف غيره كان عليه كل الاجر ولا ضمان عليه اذا سلمت وان عطبت الدابة من ركوبهما بعدما بلغت المكان المشروط يضمن تثف القيمة وعليه جميع الاجر سواء كمان الرديف اخف منه او اثقل انكانت الدابة تطيق نثلهما وان كانت لا تطيق يضمن جميع القيمة اما اذا كانت تطيق مثلهما ذكر انه يضمن نصف القيمة اذا عطبت وقال بعض الناس يضمن قدر الزيادة وذكر شمس الاءمة الحلواني رحمه الله تعالي هذا اذا كان الرديف كبيرا او صغيرا يستمسك علي الجابة وان كان لا يستمسك فهو بمنزلة الحمل يضمن قدر الزيادة كما لو ركب وحمل شيا وبعضهم سوي بين الصغير الذي يستمسك والصغير الذي لا يستمسك فقال يضمن نصف القيمة فان اراد صاحب الدابة ان يضمن الرديف نصف القيمة كان له ذلك لانه في حق المالك غاصب نصفها ولا يرجع الرديف بذلك علي المستاجر لانه في حق المستاجر بمنزلة المستعير وان ضمن المستاجر لا يرجع المستاجر بما ضمن علي الرديف لانه بمنزلة المستعير * ولو استاجر دابة ليركبها الي موضع معلوم فحمل عليها صبيا صغيرا فعطبت الدابة كان ضامنا قيمتها كما لو حمل عليها مكان الصبي حملا اخر * رجل استاجر دابة للحمل ولم يبين ما يحمل عليها فسدت الاجارة فان لم ينقض الاجارة حتي حمل عليها شيءا جازت الجارة ويصير كانه استاجرها لذلك ابتداء * كذا لو لم يحمل عليها شيءا ولكن ركبها او اركب غيره جازت الاجارة ايضا لان الحمل يتناول الركوب * قال الله تعالي " ولا علي الذين اذا ما اتوك لتحملهم" فلو انه حمل عليها او اركب غيره حتي جازت الجارة يصير كان العقد ورد عليه حتي لو فعل بعد ذلك شيءا يخالف الاول بان اركب انسانا او لا او ركب بنفسه ثم اركب غير الاول او كان الاول حملا ثم ركب او اركب يصير غاصبا ضامنا * ولو استاجر دابة ليحمل عليها شيءا سماه فحمل عليها غيره فهو علي وجوه ان حمل عليها من جنس المسمي الا انه خالف المشروط بان استاجر دابة ليحمل عليها عشرة مخاتيم من هذه الحنطة فحمل عليها عشرة مخاتيم من غير تلك الحنطة او حمل عليها حنطة رجل اخر لا يكون مخالفا * وكذا لو استاجر ليحمل عليها ثوبا هرويا فحمل عليها ثوبا مرويا مثل ذلك وزنا* والثاني ان يخالف في الجنس بان استاجر ليحمل عليها عشرة اقفزة حنطة فحمل عليها عشرة اقفزة شعير في القياس يكون ضامنا مخالفا وفي الاستحسان  لا يكون ضامنا لان المعتبر هو الضرر ولا ضرر ههنا لان مثل ذلك من الشعير يكون اخف علي الجبة فان سلمت الدابة يجب الاجر المسمي ولا يكون مخالفا وان عطبت الدابة من ذلك يضمن قيمتها ولا يجب الاجر وان استاجرها ليحمل عليها عشرة اقفزة شعير فحمل عليها عشرة اقفزة حنطة مثل كيل الشعير قال الفقيه ابو الليث الحافظ رحمه الله تعالي يضمن قيمة الدابة لان الحنطة اشد من الشعير واثقل فيضمن كما لو حمل عليها مكان الحنطة حديدا *ولو سمي من الحنطة ومزنا معلوما فحمل عليها من الشعير مثل ذلك الوزن وعطبت الدابة يضمن قيمتها وان استاجر دابة ليحمل عليها شعيرا فحمل عليها في احد الجوالقين شعيرا وفي الاخر حنطة فعطبت الدابة يضمن نصف قيمتها وعليه نصف اجرها في النصف موافق وفي النصف مخالف والثالث ان يخالف الي ما هو اضر بالدابة بان استاجر لحمل الحنطة فحمل عليها حديد او اجرا او قطنا او حطبا او تينا , طينا مثل وزن الحنطة فعطبت يضمن قيمتها وان سلمت لا يجب الاجر وان استاجرها ليحمل عليها مختبم حنطة فحمل عليها خمسة عشر مختوما من الحنطة وجاء بالحمار سليما فهلك قبل ان يرده الي صاحبه ان كان يعلم ان الحمار يطيق ذلك كان عليه ثلث القيمة وكمال الاجر المسمي * وان كان لا يطيق يضمن جميع القيمة ولا يجب الاجر * وان تكاري بعيرا ليحمل عليه محملا فحمل زاملة قالوا يكون ضامنا لان الزاملة تكون اضر بالدابة * وهو كما لو استاجر ليكب فحمل عليها يكون ضامنا * وان استاجر دابة ليسرج بسرج فاوكفها فعطبت كان ضامننا قدر ما زاد لثقل كما لو زاد في الحمل وعن ابي يوسف رحمه الله تعالي انه يضمن جميع القيمةو لو استاجر حمارا بسرج ليركبه فاسرجه سرجا اخر فان ايرجه بسرج يسرج بمثله الحمار لا يضمن * وان اسرجه بسرج لا يسرج بمثله الحمار كان ضامنا قيمته في قول ابي حنيفة رحمه الله تعالي * وان اوكفه باكاف يوكف بمثله الحمار كان ضامنا قيمته في قول ابي حنيفة رحمه الله تعالي وقال ابو يوسف ومحمد رحمهما الله تعالي يضمن فعلي هذا في السرج ينبغي ان يكون كذلك عند ابي حنيفة رحمه الله تعالي يضمن جميع القيمة وعنجهما يضمن بقدر ما زاد من الثقل هذا اذا كان الحمار موكفا حين استاجره فان كان عريانا حين استاجره فاسرجه وركب ذكر في الكتاب انه يضمن ومشايخنا رحمهم الله تعالي قالوا هذا علي وجوه ان استاجره من بلد اليبلد لا يضمن لان الحمار لا يركب من بلد الي بلد عادة الا بسرج او اكاف * وان استاجره ليركب في المصر فان كان من ذوي الهيءات فكذلك لان مثله لا يركب في المصر عريانا * وان كان من العوام الذين يركبون في المصر عريانا فاذا اسرجه يكون ضامنا * م ان استاجر دابة بغير لجام فالجمها او كانت ملجمة فنزع وبدله بلجام مثله وركب لا يضمن وان كانت تركب بغير لجام فالجمها او كانت ملجمة فالجمها بلجام لا يلجم مثلها كان ضامنا * رجل استاجر بعيرا ليعمل عليه بالنصف او بالثلث فهو فاسد ثم ينظر ان كان العامل يءاجر الدابة من الناس وياخذ الاجر بصاحب البعير وللعامل اجر مثل عمله * وان كان العامل ينقل عليها الطعام ويبيع كان الكسب للعامل ولصاحب البعير اجر مثل البعير * رجل استاجر دابة ليركبها فامسكها ولم يركب ان استاجرها ليركبها خارج المصر الي مكان معلوم فامسكها في المصر لا يجب الاجر ويكون ضامنا وان استاجرها ليركبها في المصر يوما الي الليل فامسك ولم يركب كان عليه الاجر ولا يكون ضامنا * رجل تكاري دابة الي بغداد علي ان يعطيه الاجر اذا رجع من بغداد لم يكن لصاحب الدابة ان يطالبه بالكراء ما لم يرجع من بغداد فان مات المستاجر في بغداد كان لصاب الدابة اجر الذهاب من تركته هكذا ذكر في المنتقي وفي الاصل رجل تكاري دابة الي موضع معلوم فلما سار بعض الطريق نتجت الدابة وضعفت عن المسير فان كان المستاجر استاجر دابة بعينها كان للمستاجر الخيار ان شاء نقض الاجرة وان شاء تربص الي ان تقوي الدابة وليس له ان يطالبه بدابة اخري وان كان المستاجر تكاري منه حمولة بغير عينها لتحمله الي ذلك المكان فاذا ضعفت الاولي كان له ان يطالبه بدابة اخري لان المعقود عليه حمله الي ذلك المكان (فصل فيما يكون تضييعا للدابة والمال ) رجل استاجر حمارا مشاهرة وامره ان يوكف الحمار فاوكفه وتر ك الحمار علي باب المنزل ليرفع خشب الحمار فلما خرج لم يجد الحمار ان كان الحمار غاب عن بصره حين دخل الدار كان ضامنا والا فلا الا ان يكون في موضع لا يعد هذا القدر من الذهاب تضييعا بان كان في سكة غير نافذة او يكون ذلك في بعض القري * رجل استاجر حمارا فربطه علي ارية في سكة نافذة وثم اقوام نيام ليسوا من عيال المستاجر ولا من اجراءه فسرق الحمار قالوا ان كان المستاجر لم يستحفظهم يكون ضامنا يترك الحفظ وان كان استحفظهم او استحفظ بعضهم وقبلوا منه الحفظ ولم يكن في عقد الاجارة شرط ركوب المستاجر بنفسه وكان ذلك في موضع لا يعد النوم ممن يحفظ الدواب تضييعا لا  يضمن وان كان ذلك في موضع يعد النوم من الحافظ تضييعا ولم يستحفظهم ضمن وان استحفظهم وقبلوا منه الحفظ كان الضمان علي الذي قبل الحفظ اذا لم يحفظ وان كان المستاجر شرط في الاجارة ان يركبها بنفسه يضمن الستاجر علي كل حال لانه اذا شرط ذلك لم بكن له ان يءاجرها غيره ولا ان يعيرها ولا ان يودعها * رجل استاجر حمارا ليحمل عليه الي المدينة فحمل عليه وساقه في طريق المدينة ثم تخلف في الطريق لبول او غاءط او اشتغل بالحديث مع غيره فذهب الحمار وضاع ان لم يغب الحمار وضاع ان لم يغب الحمار عن بصره لا يضمن وان غاب ضمن *وان استاجر حمارا فاوقفه وصلي الفجر فذهب الحمار او انتهبه انسان فان راه ينتهب او يذهب ولم يقطع الصلاة ضمن لانه ترك الحفظ مع القدرة عليه لان خوف ذهاب المال يبيح قطع الصلاة وان كان درهما * رجل استاجر مكاريا ليحمل له علي دابته عصيرا الي موضع معلوم فلما اراد المكاري ان يضع العصير علي الدابة اخذ احد العدلين من جانب ورمي بالعدلين جميعا من الجانب الاخر فانشق الزق من رميه وذهب العصير ضمن المكاري نقصان الزق والعصير * رجل دفع حملا الي المكاري ليحمله الي موضع معلوم عليه ان يسير ليلا ففقدت الدابة مع الحمل ان ضاعت الدابة من غير تضييع من المكاري لا يضمن في قول ابي حنيفة رحمه الله تعالي ويضمن في قول صاحبيه رحمهما الله تعالي * مكار حمل كرابيس رجل فاستقبله اللصوص فطرح الكرابيس جميعا وذهب بحماره قالوا ان كان يعلم انه لو لم يطرح الكرابيس اخذوا الحمار والكرابيس جميعا ولا يمكنه دفعهم لا يضمن الكرابيس * رجل استاجر مكاريا او حمالا ليحمل له طعاما في الطريق كذا فاخذ في طريق اخر يسلكه الناس فهلك المتاع ذكر في الكتاب انه لا يضمن قالوا هذا اذا كان الطريقان متقاربين اما اذا كان بينهما تفاوت فاحش في الطول والقصر او السهولة والصعوبة يضمن كما لو شرط ان لا يحمله في البحر فحمله في البحر كان ضامنا * رجل دفع الي رجل فرسا ليذهب به الي قريته ويدفعه الي والده فذهب به المامور ونسيه في رباط في الطريق ومضي بوجهه ثم مر رجل من اهل قريته وعرف الفرس واستاجر من يذهب بالفرس الي منزله فعطب الفرس في الطريق قال الشيخ الامام ابو بكر محمد بن الفضل الذي نسي الفرس في الرباط يكون ضامنا للفرس وهذا المستاجر ان لم يكن اخذ الفرس لا يضمن وان اخذ ثم دفعه الي الاجيران اشهد حين اخذه انه انما ياخذه ليرده علي صاحبه وكان الاجير في عياله لا يضمن وان كان الاجير اجنبيا ضمن وان ترك الاشهاد حين اخذه يضمن علي كل حال كان الاجير في عياله او لم يكن ويكون الاجير ضامنا ايضا علي كل حال لاثبات اليد علي مال الغير فقيل له لو ان صاحب الفرس ضمن الاجير هل يرجع الاجير علي الذي استاجره قال لا يرجع قيل له المودع اذا لحقه ضمان يرجع قال نعم لان الموجع يمسك لصاحبه فاما الاجير انما يمسك لنفسه لانه بالامساك يستحق الاجر فكان بمنزلة المستعير والمستعير اذا ضمن لا يرجع علي المعير * ولو ان رجلا كان علي دابة بالعارية او بالاجار فنزل عنها في السكة ودخل المسجد ليصلي وخلي عنها فضاعت كان ضامنا قالوا هذا اذا لم يربطها بشء اما اذا ربطها لا يضمن لان المستعير والمستاجر لا يجدان بدا من ذلك وقال الشيخ الامام شمس الاءمة السرخسي رحمه الله تعالي الصحيح عندي انه اذا غيبها عن بصره ضمن فانه لو كان في الصحراء فنزل للصلاة وامسكها فانفلتت منه لا يضمن فتبين بهذا ان المعتبر ان لا يغيبها عن بصره لانه اذا غيبها لا يكون حافظا لها وان رطها بشء * رجل دفع الي اخر بعيرا وامره ان يكريه ويشتري له به شيءا فعمي البعير وباعه واخذ الثمن فهلك الثمن في يده قال الفقيه ابو جعفر ان باع في موضع لم يكن هناك حاكم حتي يرفع الامر اليه لا يضمن * وان كان في موضع يقدر علي ان يرفع الامر الي الحاكم فلم يرفع كان ضامنا وكذا لو كان يمكنه ان يمسكه ويرده مع العمي الي صاحبه ضمن ايضا * رجل دفع الي وراق كاغدا واستاجره ليكتب له مصحفا وينقطه ويعجمه ويعشره بكذا فاخطا في بعض النقط والعواشر قال الفقيه ابو جعفر ان فعل ذلك في كل ورقة كان المستاجر بالخيار ان شاء اخذ واعطاه اجر مثله لا يجاوز يه ما سمي وان شاء رده عليه واسترد منه ما اعطاه * وان وافقه في البعض دون البعض اعطاه من المسمي حصة ما وافق من المسمي ولما خالف اعطاه اجر المثل * رجل استاجر رجلا ودفع اليه حمارا وخمسين درهما ليذهب به الي بلد كذا ويشتري له شيءا فذهب المامور فاخذ السلطان حمر القافلة فذهب بعبض اصحاب الحمر في طلب حمرهم واستردوا من السلطان حمرهم ولم يذهب هذا الاجير قالوا ان كان الذين ذهبوا في طلب حمرهم منهم من وجد حماره ومنهم من لم يجد فمن وجد لم ياخذ حماره الا بمءنة ومشقة لا يضمن الاجير بترك طلب الحمار * جماعة اجر كل واحد منهم حماره من رجل وسلموا اليه الحمر ثم قال اصحاب الحمر لواحد منهم اذهب انت معه تتعاهد الحمر فانا لا تعرفه فذهب  الرجل مع المستاجر فقال له المستاجر قف ههنا حتي اذهب انا بالحمار ولم يقدر عليه قالوا لا يضمن المتعاهد لان اصحابه امروه بتعاهد ما كان في يد غيرهم فلم يكن ذلك ايداعا * رجل اكتري حمارا من كش الي بخارا فعيي الحمار في الطريق وصاحب الحمار كان ببخارا فامر المكتري رجلا رجلا ان ينفق علي الحمار في علفه كل يوم مقدارا معلوما وسمي له الاجر الي ان يصل اليه صاحب الحمار فامسك الاجير الحمار اياما فانفق عليه وهلك في يده قالوا ان كان المكتري اكتراه لركوب نفسه ضمن وان كان اكتراه ولم يسم الراكب لا يضمن لانه اا اكتراه لركوب نفسه لا يكون له ان يءاجره ولا ان يعيره فاذا لم يملك الاعارة والجارة لا يملك الايداع فيضمن* رجل استاجر حمارا لينقل عليه التراب من خربة فاخذ في نقل التراب فانهدمت الخربة وهرب المستاجر لا يضمن ان لم يكن اوقف الحمار علي وهن لاقراره معه * رجل استاجر حمارا لينقل عليه الشوك فذهب في سكة فيها نهر جار فبلغ موضعا ضيقا فضرب الحمار فوقع الحمار في النهر مع الحمل واشتغل المستاجر بقطع الحبل فهلك الحمار قالوا ان كان الموضع ضيقا لا يسير فيه الحمار مع الحمل كان ضامنا لان سوق الحمار في مثل هذا يكون استهلاكا وان لم يكن كذلك وكان موضعا يسير فيه الحمار ويتجاوز فان عنف عليه المستاجر وضربه حتي وثب الحمار من ضربه كان ضامنا وان وقع الحمار لا من ضربه ولا بعنفه لم يضمن * رجل استاجر حمارا لينقل عليه الحطب من كرمه فاوقره بما يوقر مثله وقرا معتادا فاصاب الحمار حاءطا او شجرا فوقع في النهر فمات ان كان المستاجر ساقه سوقا معتادا في الطريق الذي يسلكه الناس ولم يعنف لا يضمن * رجل استاجر حمارا وقبضه فارسله في كرمه فسرقت برذعته فاصابه البرد فمرض فرده علي صاحبه فمات من ذلكالمرض قالوا ان كان الكرم حصينا ولم يكن البرد بحال يضر الحمار لو كانت عليه البرذعة لا يضمن لانه لم يقصر لا في حفظ الحمار ولا في حفظ البرذعةاما في حفظ الحمار فلانه محفوظ بالبرذعة والبرذعة محفوظة بالكرم الحصين وان لم يكن الكرم حصينا وكان البرد بحال يضر بالحمار مع البرذعة يضمن قيمتهما لانه ضيع البرذعة بتركها في غير الحصين وضيع الحمار بالترك في البرد المهلك واذا دخل الحمار في ضمانه لا يبرا الا بالرد علي المالك سليما وان كان الكرم حصينا الا ان البرد كان بحال يضر بالحمار مع البرذعة يضمن قيمة الحمار دون البرعة لانه اتلف الخمار ولم يتلف البرذعة وان لم يكن الكرم حصينا ولكن لم يكن البرد بحال يخاف منه تلف الحمار مع البرذعة يضمنقيمة البرذعة وعليه تقصان الحمار لانه لما ارسل الحمار في غير الحصين دخل الحمار في ضمانه فيبرابقدر ما رد علي المالك ويتقررعليه ضمان النقصان لانه لم يوجد البرد بقدر ما انتقص * رجل استاجر قدر الوليمة او لطبخ عصير فلما فرغ حمل القدر علي الحمار ليرده علي صاحبه فزلق الحمار وانكسر القدر قالوا ان حمله علي حمار يطيق مثله حمل ذلك القدر ل يضممن المستاجر لان ءدد القددر وان لم يكمن علي المستاجر شرعا الا ان المستاجر لو تحمل ذلك يكون الاجر راضيا بهو لان المستاجر هو الذي يرده عادة فكان ماذونا فيه فلا يضمن الا ان ذلك الحمار اذا لم يكن يطيق حمل لك القدر كان ذلك استهلا كا فيكون ضامنا * زروع بين ثلاثة حصدوها ثم استاجر واحد من الثلاثة حمارا لينقل عليه الحصاءد فقبض المستاجر الحمار ودفعه الي شريكه ليتقل عليه الحصاءد فعطب الحمار عند المستعمل وكان المعتاد فيما بينهم ان يستاجر احدهم الحمار او البقر ويستعمله هو او شريكه لا يضمن المستاجر لان هذا المستاجر يكون بمنزلة المعير من شريكه وللمستاجر ان يعير فيما لا يتفاوت فيه الناس وحمل الحصاءد مما لا يتفاوت فيه الناس * رجل استقرض من رجل دراهم ودفع الي المقرض حماره ليستعمله المقرض ويكون عنده الي ان يوفيه المستقرض دينه فبعثه المقرض الي السرح وسلمه الي بقار ليعتلف فعقره الذءب ضمن المقرض قيمة الحمار لان المقرض في هذا بمنزلة المستاجر اجارة فاسدة فلا يكون له ان يبعث الي السرح ليعتلف *رجل استاجر قبانا ليزن به شيا فوزن وكان في عمود القبان عيب ولم يعلم به المستاجر فانكسر القبان قالوا ان كان مثل ذلك الحمل يوزن بمثل هذا القبان مع هذا العيب لا يضمن * رجل استاجر فاسا واستاجر اجيرا ليعمل به ودفع اليه الفاس فذهب الاجير بالفاس اختلفوا فيه قال تعضهم يضمن المستاجر لانه صار مخالفا بالدفع الي الاجير * وقال بعضهم ان كان مستاجر الفاس استاجر الاجير اولا ثم استاجر الفاس ودفع اليه لا يضمن وان استاجر الفاس اولا ثم استاجر الاجير ضمن والاصح انه اذا استاجر الفاس اولا لعمل لا يختلف فيه الناس بالاستعمال لا يضمن الا ان يكون الاجير معروفا بالخيانة وان استاجر الفاس لما يختلف فيه الناس فان استاجر ليعمل هو بنفسه ضمن بالدفع الي غيره * وان استاجر الفاس ولم يعين المستعمل فدفعنه الي الاجخير قبل ان يستعمل هو بنفسه  لا يضمن وان استعمل هو اولا ثم دفع الي الاجير ضمن * رجل استاجر مرا من رجل وجعله في الطين ثم صرف وجهه عن الطين ولم يبرح مكانه وجعا اجيره ثم نظر الي المر فلم يجده قالوا ان كان تحويل وجهه عن المر قليلا لا يعد ذلك تضيييعا عند الناس لا يضمن وان كان طويلا يعد تضييعا عند الناس ضمن * حخمال استاجر من رجل جوالقا ليحمل فيها شيا فاخذ الجوالق فاخه السلطان ليحمل له حملا فهب الحمال واشتغل بما امره السلطان فسرق الجوالق ان لم يجد الحمال بدا من ان يشتغل بما امره وخاف علي نفسه العقوبة بترك ذلك لا يضمن لانه مضطر فلا يجب عليه حفظ الجوالق في هذه الحالة وان كان يجد بدا من ان لا يشتغل بذلك الحمل كان ضامنا بترك الحفظ* رجل شق راوية رجل كان عليه ضمان ما شق وما سال منه وما عطب بما سال يعني اذا زلق رجل بذلك ولم يره ولم يعلم فمات يضمن الشاق ديته * ولو ان صاحب البعير بعد ما شق هذا راويته علم بذلك وساق البعير فما عطب من سيلا نه لا يكون علي الشاق لان صاحب البعير لما ساق البعير بعد العلم انقطعت جناية الشاق وعلق في الكتاب انقطاع الجناية عن الشاق بان يسوق وهو يري ذلك او يحمل الراوية وهو يري ذلك وقال القاضي الامام او زيد اذا ساق البعير تنقطع جناية الشاق علم ساءق البعير بذلك او لم يعلم فاعتبر الحقيقة وفي الحقيقة هذذا اثر فعل الاول ولامختار هو الفرق بين العلم والجهل فان من حفر بءرا في الطريق وجاء انسان ولم يعلم به ووقع البءر فمات ضمن الحافر * وان علم الماشي في الطريق بالبءر يهدر دمه لان الجناية وجدت من الاول وانما تضاف الي الثالني اذا كان الثاني متعديا في ذلك تدون العلم لا يكون متعيا فلا ينقطع عن الاول* واذا شق راوية رجل فلم يزل يسيل ما فيها حتي مال الجانب الاخر ووقع فانخرق ضمن الشاق قيمتهما جميعا الا ان يكون صاحب البعير علم بذلك وساق البعير مع ذلك فلا يجب علي الشاق ضمان ما يحدث بعد السوق * ولو شقها شقا صغيرا وقال صاحبها بءسما صنعت ثم ساق البعير فزلق رجل بما سال منه لا يضمن * طاحونة تطحن والبر يتسفل من حلق الطاحونة في الماء قالوا لا يضمن صاحب الطاحونة لان الحنطة في يد صاحبها فكان عليه حفظها* قال المصنف وينبغي ان يكون الجواب علي التفصيل ان استاجر الطاحونة ليطحن هو بها لا يضمن صاحب الطاحونة وان استاجر الطحان ليطحن له فطحن الطحان ضمن الطحان. (فصل في توابع الاجارة ) رجل استاجر خياطا ليخيط له ثوبا كان السلك والابرة علي الخياط وهذا في عرفهم اما في عرفنا السلك علي صاحب الثوب* ولو كان الثوب حريرا فالابريسم الذي يخاط به الثوب يكون علي صاحب الثوب وفي استءجار اللبان اللبن يكون علي اللبان والتراب علي المستاجر وفي نسج الثوب الدقيق يكون علي صاحب الثوب واخراج الخبز من التنور يكون علي الخباز وجعل المرقة في القصاع يكون علي الطباخ اذا استءجر لطبخ عرس او وليمة * وان استءجر لطبخ قدر خاص لا يكون ذلك علي الطباخ* وارخال الحمل في المنزل يكون علي الحمال ولا يكون عليه ان يصعد به علي السطح او الغرفة الا ان يشترط عليه ذلك وكذلك صب الطم في الخنيق لا يكون علي الحمال الا بالشرط * ولو تكاري دابة ليحمل عليها صاحب الدابة الحمل فانزال الحمل عن الدابة يكون علي المكاري وارخال الحمل فقي المنزل لا يكون عليه الا ان يكون في موضع يكون لك عليه في عرفهم * وفي استءجار الدابة للحمل الاكاف يكون علي المكاري والحبل والجوالق يكون علي المكاري اذا استاجره ليحمل المكاري الحمل علي دابة نفسه * وان استاجر الحمال ليحمل الحنطة علي ظهره او علي دواب المستاجر فالحبل والجوالق يكون علي المستاجر * وقال الفقيه ابو الليث رحمه الله تعالي في عرفنا الجولق يكون علي صاحب الحمل في الاحوال كلها الا ان يشترط ذلك علي الحمال والحبل يكون علي الحمال لان الحبل يكون لصيانة الحمل عن الوقوع * ولو استاجر وراقا فان شرط علنيه الحبر والبياض فشرط الحبر جاءز وشرط البياض فاسد* ولو استاجر قصارا ليقصر له الف ثوب قالوا حمل الثياب يكون علي القصار الا ان يشترط ذذلك علي صاحب الثوب * ولو ان رجلا استاجر []حمالا ليحمل له الاحمال الي موضع كذا فلما بلغ الحمال لك الموضع نزل في دار ووضع الاحمال في موضع من الدار ثم وزنها علي صاحبها وسلمها اليه فلم يرفعها صاحبها اياما ثم اختصموا في اجر ذلك الموضع ورب الدار يطالب الحمال بالكراء قالوا ان كان احدهما استاجر ذلك الموضع لوضع الاحمال فيه كان الكراء علي من استاجر وان وضع الاحمال من غير ان يستاجر احدهما ذلك المرضع فالكراء بعد الوزن والتسليم يكون علي صاحب الاحتمال وقبل لك يكون علي الحمال وان طلب صاحب الاحمال من الحمال ان يزن ثانيا لا يجبر عليه* وفي اجارة الدار عمارة الدار وتطيينها واصلاح الميزاب وما كان من البناء يكون علي رب الدار وكذا كل سترة تركها يخل بالسكني يكون علي رب الدار فان ابي صاحب الدار ان يفعل كان للمستاجر ان  يخرج منها الا ان يكون استاجرها وهي كذلك وقد راها فحينءذ يكون راضيا بالعيب فلا يردها لاجله واصلاح بءر الماء والبالوعة المخرج بكون علي صاحب الدار * وان كان امتلا من قبل المستاجر لكن لا يجبر رب الدار علي ذلك ولا يكون علي المستاجر ايضا فان فعل المستاجر ذلك يكون متبرعا ولا يحتسب له من الاجر وله ان يخرج من الدار اذا لم يفعل ذلك رب الدار وكذا الغلق والسلم * وفي اجارة الحمام نقل الرماد والسرقين وتفريغ موضع الغسالة يكون علي المستاجر سواء كان المسيل ظاهرا او مسقفا فان شرط ذلك علي الاجر فسدت الاجارة * وان شرط علي المستاجر جازت الاجارة والشرط لان ذلك يكون علي المستاجر بدون الشرط والشرط لا يزيده الا وكادة فان انكر المستاجر ان يكون الرماد من فعله كان القول فيه قوله لانه ينكر ان يكون نقله عليه.
 *(فصل فيما تنتقض به الاجارة وما لا تنتقض به)*

 الاجارة تنتقض بالاعذار عندنا وذلك علي وجوه اما ان كان من قبل احد المتعاقدين او من قبل المعقود عليه واذا تحقق العذر ذكر في بعض الروايات ان الاجارة تنتقض في بعضها قال لا تنتقض ومشايخنا رحمهم الله تعالي وفقوا فقالوا ان كانت الاجارة لغرض فلم يبق ذلك الغرض او كان عذرا يمنعه من الجري علي موجب العقد شرعنا تنتقض الاجارة من غير نقض كما لو استاجر انسانا لقطعن يده عند وقوع الاكلة او لقلع السن عند الوجع فبرات الاكلة وزال الوجع تنتقض الاجارة لانه لا يمكنه الجري علي موجب العقد شرعا* وان استاجر دابة بعينها الي بغداد لطلب غريم له او لطلب عبد ابق ثم حضر الغريم او عاد العبد من الاباق تنتقض الاجارة لانها وقعت لغرض وقد فات ذلك الغرض * وكذا لو ظن ان في بناء داره خللا فاستاجر رجلا لهدم البناء هم ظهر انه ليس في البناء خلل او استاجر طباخا لوليمة العرس فمات العروس بطلت الاجارة * واذا تحقق العذر ومست الحاجة الي النقض هل ينفرد صاحب العذر بالنقض او يحتاج الي القضاء او الي الرضاء اختلفت الروايات فيه والصحيح ان العذر اذا كان ظاهرا ينفرد وان كان مشتبها لا ينفرد اما العذر الذي يكون من قبل الاجر اذا لحقه دين لا وفاء له الا بثمن المستاجر فان الجر لا ينفرد بالنقض ويفوض ذلك الي راي القاضي لتعارض الضررين فيرجح القاضي احدهما علي الاخر ولان هذا العذر مشتبه يحتمل ان يكون قادرا علي قضاء الدين بدون هذا المال فلا يتحقق العذر الا بالقضاء كما في خيار البلوغ وغير ذلك وتكون الاجارة بينهما علي حالها فيجب علي المستاجر اجرة الدار الي ان يفسخ القاضي العقد بينهما واذا اراد القاضي فسخ الاجارة لاجل الدين اختلفوا فيه قال بعضهم يبيع الدار فينفذ بيعه فتنفسخ التجارة وقال بعضهم يفسخ الاجارة[] اولا ثم يبيع هذا اذا كان الدين ظاهرا فان لم يكن ولكن صاحب الدار اقر بالدين علي نفسه وكذبه المستاجر قال ابو حنيفة رحمه الله تعالي يصح اقراره ويفسخ القاضي الاجارة بينهما باقراره بالدين وقال صاحباه لا يصح اقراره * وهذه ثلاث مساءل احداها هذه * والثانية المراة اذا اقرت علي نفسها بالدين لغير الزوج وكذبها الزوج صح اقرارها ويكون للغريم ان يحبسها بالدين* والثالثة الحبوس بالدين اذا اقر ببعض ماله لرجل يثق به او لبعض ورثته عند ابي حنيفة رحمه الله تعالي يصح اقراره حتي يقضي القاضي بعسرته ويخرجه من الحبس* رجل اجر داره ثم صار معسرا ولا يجد نفقة نفسه ولا عياله كان له ان يفسخ الاجارة كما لو لحقه دين فادح* ولو انهدم المنزل الذي يسكنه الاجر وليس له مسكن اخر سوي الذي اجره لم يمن له ان يفسخ الاجارة* وكذا لو اراد ان يبيع المنزل الي اجره لربح ظهر له في بيع المنزل لم يكن له ان يفسخ الاجارة وكذا لو اراد الاجر ان يتحول نعن مصره لم يكن ذلك عذرا* وان اجر دابة بغير عينها فمرضت دابته لم يكن عذرا* وان اجر الاب او الوصي او القاضي ارض اليتيم فبلغ اليتيم في مدة الاجارة لم يكن له ان ينقض الاجارة * وان اجر الاب نفس الصغير فبلغ الصغير في مدة الاجارة كان له ان يفسخ وكذا لو اجر المولي عبده ثم اعتقه في مدة الاجارة كان للعبد ان يفسخ الاجارة عندنا* ولو اظهر المستاجر في الدار شيءا من اعمال الشر كشرب الخمر واكل الربا او الزنا او اللواطة فانه يءمر بالمعروف وليس للاجر ولا للجيران ان يخرجوه من الدار وكذا لو اتخذ داره ماوي اللصوص * وان ارتد والعياذ بالله لا تفسخ الاجارة ولكن يجبر علي الاسلام فان ابي قتل وان اراد المستاجر ان يجعل الدار بيعة او كنيسة فانه يمنع عن ذلك وامااهل الذمة اذا ارادوا احداث البيعة والكنيسة في امصار المسلمين وفي افنية المصر منعوا عن ذلك وان ارادوا احداث ذلك في السواد والقري فان كان اكثر سكانها اهل الذمة لا يمنعون وفي القري التي يسكنها المسلمون واهل الذمة اختلف المشايخ فيه لاختلاف الروايات ذكر في الاجارات انهم لا يمنعون وذكر في السير انهم يمنعون من احداث البيع والكناءس في المواضع كلها وهكذا روي الحسن بن زياد عن ابي حنيفة رحمه الله تعالي وبه اخذ عامة المشايخ منهم محمد بن سلمة رحمه الله تعالي ولا يمنعون عن عمارة البيعة والكنيسة القديمة في الامصار والقري ولا عن استءجار الدار في المواضع كلها ولا عن شراء الدار في القري وفي شراء الدار في الامصار روايتان* العذر الذي تنفسخ به الاجارة من جانب المستاجر ان لا يمكنه المضي الا بضرر وذلك قد يكون لمعني مباين عما استاجره وقد يكون لمعني في المعقود عليه* منها اذا انهدم البيت المستاجر او انهدم ما ينقص السكني كالحاءط ونحو ذلك فله ان يخرج عن الدار ويفسخ الجارة بحضرة الاجر لانه بمنزلة العيب الحادث في المبيع قبل القبض ومن ذلك اذا كان المستاجر يبيع ويشتري في هذا البيت او في الحانوت فافلس واراد التحول الي تجارة اخري او اراد ترك التجارة اصلا كان له ان يفسخ الاجارة وان وجد بيتا اخر او حانوتا اخر  ارخص من الاول فان ذلك لا يكون عذرا وقال بعضهم ان تهيا له ان يعمل التجارة الثانية او الحرفة الثانية في ذلك الحانوت ليس له ان ينقض الاجارة وان لم يتهيا كان له ان ينقض * وان اشتري منزلا فاراد التحول اليه لم يكن عذرا* وفي النوازل اذا تكاري ابلا من الكوفة الي بغداد ثم بدا له ان تتكاري بغلا لا يكون عذرا وان اشتري بعيرا او دابة كان عذرا لانه استغني عن الاجارة* ولو استاجر حانوتا او بيتا ثم بدا له السفر كان عذرا* ولو[] استاجر دابة الي بغداد ثم بدا له ان يقعد عن السفر او اكتري ابلا للحج ثم بدا له ان لا يحج عامه ذلك او مرض وعجز عن السفر كان عذرا ولو اكتري ابلا للحج فلما سار بعض المراحل مات المكاري كان للمستاجر ان يركب الي مكة * ولو استاجر ارضا ليزرعها ثم بدا له ان يترك الزراعة اصلا كان عذرا وان لم يترك الزراعة ولكنه اراد ان يزرع ارضا اخري لا يكون عذرا وان نزت الارض او غرقت كان عذرا* وان استاجر عبدا للخدمة فمرض العبد كان للمستاجر ان يفسخ الاجارة وان رضي المستاجر بذلك ليس للاجر ان يفسخ الاجارة وان وجد المستاجر العبد غير حاذق في الخدمة لا يكون عذرا وان استاجر عبدا للخدمة فبدا له ان يسافر كان عذرا لان من استاجر للخدمة لا يكون له ان يخرجه الي السفر ولو وجد العبد سارقا كان عذرا ولو استاجر اجيرا يوما كان علي الاجير ان يعمل كل اليوم ولا يشتغل بشء سوي الصلوات المكتوبة * رجل استاجر ارضا للزراعة فخرب النهر الاعظم وعجز عن السقي كان له ان يفسخ الاجارة فان لم يفسخ حتي مضت المدة كان عليه اجرها اذا كان بحال ان يحتال بحيلة فيزرع فيها شيءا وان كان لا يقدر علي ذلك بوجه من الوجوه فلا اجر عليه وكذا لو لم ينقطع الماء ولكن سال فيها الماء حتي عجز عن الزراعة فلا اجر عليه * رجل استاجر ارضا فانقطع الماء ان كانت تسقي بماء النهر وماء المطر لكن انقطع المطر ايضا لا اجر عليه * رجل استاجر ارضا فغرقت قبل ان يزرعها فمضت المدة فلا اجر عليه كما لو غصبها غلاصب وان زرعها فاصاب الزرع افة فهلك الزرع او غرقت بعد الزرع ولم تنبت فعن محمد رحمه الله تعالي في رواية كان عليه الاجر كاملا وعنه في رواية اذا استاجر ارضا فزرعها فقل ماءها او انقطع فله ان يخاصم الاجر الي القاضي حتي يترك الارض في يده باجر المثل الي ان يدرك فان سقي زرعه بعد ذلك لم يكن له ان ينقض الاجارة والمختار للفتوي انه اذاهلك الزرع لم يكن عليه لما بقي من المدة بعد هلاك الزرع اجر الا اذا كان متمكنا من ان يزرع مثل ذلك ضررا بالارض اواقل ضررا من الاول وان اختل الزرع وانتقضت غلته كان عليه الاحر كاملا وان لم يسقه اذا لم يكن رفعه الي الحاكم ولو استاجر ارضا من اراضي الجبل فزرعها فلم يمطر عامه ولم ينبت حتي مضت المدة ثم مطرت السماء ونبت الزرع قال محمد رحمه الله تعالي الزرع كله للمستاجر وليس عليه من كراء الارض ولا من نقصانها شء* رجل استاجر رجلا ليذهب بحمولته الي موضع كذا فلما سار بعض الطريق بدا له ان لا يذهب ويترك الاجارة وطلب من الاجير نصف الاجر قالوا ان كان النصف الباقي من الطريق مثل الاول في السهولة والصعوبة كان له ذلك والا يسترد بقدره* رجل استاجر من رجل طاحونتين علي ماء في موضع يكون الحفر علي المءاجر في عرفهم واحتاج النهر الي الكري وصار بحال لا يعمل الا احدي الرحيين فان كان بحال لو صرف الماء اليهما جميعا عملا عملا ناقصا كان للمستاجر ان يفسخ الاجارة لاختلال المطلوب فلن لم يفسخ الاجارة فعليه اجرهما جميعا لانه يتمكن من الانتفاع بهما بصفة النقصان وان كان بحال لو صرف الماء اليهما لم يعملا كان عليه اجر احداهما اذالم يفسخ الاجارة لانه لم ينمكن من الانتفاع الا باحداهما فان تفاوت اجرهما فعليه اجر اكثرهما اذا كان الماء يكفي لاكثرهما اجرا وان كان ذلك في موضع يكون كري النهر علي المستاجر في عرفهم كان عليه كل الاجر لان العجز والخلل كان لمعني من قبله وهو بمنزلة ما لو استاجر خيمة وانكسرت اوتادها لا يسقط الاجر لان الاوتاد تكون علي المستاجر وان انقطعت اطنابها لا يجب علي المستاجر لان الاطناب []تكون علي المءجر* رجل استاجر رحي فانقطع ماءه كان له ان يرد فان لم يرد حتي مضت السنة لا اجر علي المستاجر وان قل الماء ويدور الرحي ويطحن نصف ما كان يطحن كان للمستاجر ان يرده فان لم يرد حتي طحن كان ذلك رضا وليس له ان يرده بعد ذلك لانه رضي بالعيب * رجل استاجر بيتا فيه رحي وذكر بكل حق هو له ولم يسم الرحي لا يدخل فيه الرحي وللمءجر ان يرفع الرحي فان استاجرها بالرحي والحجرين فله حقوق الرحي فان انقطع الماء ولم يرد حتي مضت السنة فان كان البيت مما ينتفع به بدون الرحي يقسم الاجر عليهما تسقط حصة الحجرين ويلزمه حصة البيت وان لم يكن البيت منتفعا الا بمنفعة الرحي لا شء علي المستاجر وان لم يرد البيت* رجل في قرية استاجر ارضا في قرية اخري ثم بدا له ان يترك هذه الارض  التي استاجرها ويزرع ارضا في قرية اخري قالوا ان كان بينهما مسيرة ثلاثة ايام كان له ذلك وان كان اقل من ذلك لم يكن له ذلك لان في المسافة البعيدة يلحقه كثير ضرر وفي القصيرة لا يلحقه كثير ضرر والفاصل بينهما مسافة السفر* المءجر اذا انقض الدار المستاجرة وهو كما لو غصبه غاصب كان له ان يفسخ الاجارة ولا يلزمه الاجر ولا تنتقض الاجارة اليه اشار في الاصل وعن محمد رحمه الله تعالي انه اا انهدمت الدار المستاجرة وبناها الاجر فاراد المستاجر ان يسكن بقية المدة لم يكن للاجر ان يمنعه اراد بذلك اذا بناها الاجر فبل ان يفسخ المستاجر الاجارة وفيما اذا انهدمت الدار المستاجرة كان للمستاجر ان يفسخ الاجارة ويخرج منها كان الاجر حاضرا او غاءبا وفيما اذا سقط حاءط من الدار فان كان ذلك لا يضر بالسكني لا يكون للمستاجر ان يفسخ العنقد كما لو استاجر عبدا للخدمة فاعور العبد لا يكون للمستاجر ان يفسخ العقد اذا كان ذلك لا ينقص الخدمة وان كان سقوط الحاءط يضر بالسكني كان للمستاجر ان يفسخ اذا كان الاجر حاضرا ولا يفسخ اذا كان غاءبا كما لو وجد المشتري بالمبيع عيبا قبل القبض لا يكون له ان يفسخ البيع الا بحضرة الباءع* اذا بني المستاجر في الدار المستاجرة من التراب الذي كان فيها بغير امر صاحب الدار ثم خرج بعد انقضاء مدة الاجارة قالوا ان كان البناء من لبن اتحذه من تراب كان في الدار فان المستاجر يرفع البناء ويغرم قيمة التراب لصاحب الدار وان كان البناء من طين لا ينقض البناء لانه لو نقض يعود ترابا * ولو بني المستاجر غرفة في حانوت الوقف لينتفع به من غير ان يزيد في الاجر قالوا ليس له ذلك الا اذا زاد في الاجر ويبني مقدار ما لا يخاف علي البناء وان كان الحانوت بهذه الزيادة يصير مرغوبا فيه يطلق له ذلك بغير زيادة الاجر * طحان ركب في الطاحونة حجرا من ماله او حديدا او نحو ذلك قالوا ان فعل ذلك بامر صاحب الطاحونة ليرجع عليه كان له ان يرجع بذلك علي صاحب الطاحونة وان فعل بغير امر فان امكن رفعه من غير ضرر يرفعه وان كان مركبا لا يمكن رفعه الا بضرر كان لصاحب الطاحونة ان يدفع اليه قيمته ويمنعه من الرفع وان احدث المستاجر في المستاجر بناء او غرسا ثم انقضت مدة الاجارة كان للاجر ان يامره بالرفع قلت قيمته او كثرت وان شاء منعه من الرفع واعطاه القيمة اذالم يمكن رفعه الا بضرر وان كان فعل ذلك باذن المالك فكذلك اذا لم يكن امره ان يفعل ذلك ليرجعن به عليه * واذا غرس المستاجر في الارض اشجارا كان لصاحب الارض ان ياخذ الاشجار بقيمتها مقطوعة اذا كان قطعها يضر بالارض * واذا استاحر ارضا فغلب علنها الرمل او صارت سبخة بطلت [] الاحارة وللمستاحر ان يبني بيتا او اريا في الدار المستاجرة اذا كان لا يضر بالدار * واذا مات الاجر او المستاجر تنفسخ الاجارة * ولو كان الاجر اثنين والمستاجر واحدا فمات احد الاجرين بطلت الاجارة في حصته وتبقي في حصة الاخر وكذلك لو كان المستاجر اثنين والاجر واحدا فمات احد المستاجرين بطلت الاجارة في حصته وتبقي في حصة الاخر وتبطل الاجارة بموت الموكل ولا تبطل بموت الوكيل ولا بموت الوصي والاب والقاضي في اجارة مال اليتيم ولا بموت قيم الوقف في اجارة الوقف واذا جرت الاجارة بين وكيل الاجر وبين وكيل المستاجر فمات الوكيلان لا تبطل الاجارة * واذا ملك المستاجر العين المستاجرة بميراث او هبة او نحو لك بطلت الاجارة * ولو كانت الاجمرة عينا فوهته من المستاجر قبل القبض بطلت الاجارة في قول محمد رحمه الله تعالي ولو كانت الاجرة دينا فوهبها من المستاجر قبل القبض او ابراه جازت الهبة والابراء ولا تبطل الاجارة وقال ابو يوسف رحمه الله تعالي الابراء باطل في الوجوه كلها والاجارة باقية* العبد الماذون اذا اجر شيءا من اكسابه ثم حجر عليه المولي تطلت الاجارة وكذلك المكاتب اذا اجر شيءا من اكسابه ثم عجز بطلت الاجارة ولو اجر المكاتب نفسه ثم عجز لا تبطل الاجارة في قول محمد رحمه الله تعالي وكذا العبد الماذون اذا اجر نفسه ثم جدر عليه المرلية لا تبطل الجارة في قول محمد رحمه الله تعالي* واذا استاتمجر دارا ثم اجرها من الاجر او اعارها منه ذكر الشيخ المام ابو بكر محمد بن الفضل ان ذلك يكون نقضا للاجارة وهكذا ذكر في المنتقي وجمع التفاريق وقال الفقيه ابو الليث اذا اجر من الاجر لا تصح الاجارة الثانية والاجارة الاولي علي حالها * ولو استاجر ارضا ثم دفعنها الي صاحمبها مزارعة ان كان البذر من قبل رب الارض لا يجوز ويكون ذلك نقضا للاجارة في ظاهر الرواية وان كان البذذر من قبل المستاجر جازت المزارعة ولا تبطل الاجارة لان البذر اذا كان من قبل المستاجمر يكون هو مستاجرا لصاحب الارض اما اذا كان البذر من قبل صاحب الارض كان صاحب الارض مستاجرا للارض فلا يصح ويكون ذلك نقضا للاجارة * رجل استاجر ارضا ثم اشتراها المستاجر مع رجل اخر ذكر في المنتقي ان الاجارة تبطل  ويترك الزرع في الارض حتي يستحصد ويكون للشريك في الشراء علي صاحب الزرع مثل اجر نصف الارض* وذكر فيه ايضا رجل استاجر دارا او ارضا بني فيها ثم اجرها من رب الدار فان الاجارة الثانية تكون نقضا للاولي ويكون علي رب الدار حصة بناء المستاجر من الاجر * رجل اجر نفسه في ختان او حجامة وصناعة من الاعمال ثم قال انا ارغب عن هذا العمل واستحي من الناس واريد التحول منه الي غيره من الاعمال قال محمد رحمه الله تعالي لا اقبل ذلك منه واقول له اوفه العمل ثم تحول الي ما شءت* واذا اجرت المراة نفسها بما تعاب به كان لاهلها ان يخرجوها من تلك الاجارة والله اعلم.
 *(فصل في اجارة الظءر)*

 رجل استاجر ظءرا لترضع ولده سنة فارضعته شهورا ثم مات الاب فقالت عمة الصغير ارضعيه حتي نعطيك الاجرة فارضعته شهورا بعد ذلك قالوا ان لم يكن للصغير مال حين استاجر الاب الظءر كانت المجتارة عليه من ماله واذا مات بطلت بلك الاجارة فاا قالت العمة بعد المرت ارضعيه حتي نعطيك الاجر ولم تكن العمة وصية كان ذلك استءجارا من العمة فيكون الاجر عليها وان كانت العمة وصية من قبل الاب ترجع بذلك الاجر علي الصغير اذا استفاد الصغير مالا* ولو كان للصغير مال حين استاجرها الاب لا تبطل الجارة بموت الاب ويكون الاب عاقدا لولده[] فلا تبطل الاجارة بموته * رجل استاجر ظءرا شهرا فلما مضي الشهر ابت الظءر ان ترضعه والصبي لا ياخذ ثدي غيرها قال محمد رحمه الله تعالي تجبر الظءر علي ان ترضعه باجر مثلها قيل هذا اذا لم يكن لها زوج او كان لها زوج واذن لها بالاجارة فان كان لها زوج ولم ياذن كان للزوج ان يمنعها وان خيف الهلاك علي الصغير * صغير ليس له مال ولا لابيه وامتنعت الام عن ارضاعه وهو لا يقبل ثدي غيرها قال شمس الاءمة الحلواني رحنه الله تعالي لا تجبر الام علي الارضاع في ظاهر الرواية وعن ابي حنيفة وابي يوسف رحمهما الله تعالي في النوادر انها تتتتتجبر وفال شمس الاءمة السرخسي رحمه الله تعالي تجبر وعليه الفتوي الا اذا كانت الام مريضة يضرها الارضاع * رجل استاجر ظءرا لترضع ولده سنة بماءة درهم علي انه ان مات الصغير قبل سنة فالدراهم كلها تكون للظءر فسدت الاجارة لان موجب الشرع ان يرد اجر ما بقي من المدة بعد موت الصبي فاذا شرط بخلاف ذلك كان شرطا فاسدا والاجارة تبطل بالشروط الفاسدة* رجل استاجر ظءرا لترضع ولده سنة بماءتي درهم علي ان يكون كل الاجر بمقابلة الشهر الاول وما بعده الي تمام السنة ترضع بغير اجر فارضعت شهرين ونصفا فمات الصبي قالوا يقسم اجر مثلها سنة علي الشهور فما اصاب شهرين ونصفا من ذلك كان لها لك وترد الباقي لان هذه الاجارة اجارة فاسدة وكان لها اجر المثل لكن لا يزاد علي المسمي* رجل استاجر امراة لترضع ولده منها فارضعت ذكر القدوري وشمس الاءمة السرخسي رحمهما الله تعالي انه لا اجر لها لان ذلك مستحق عليها ديانة قال الله تعالي "والوالدات يرضعن اولادهن" الاية وان كانت ابت لا تجبر علي ذلك ولا تستوجب الاجر كما لو استاجرها علي كنس البيت والطبخ والغسل وغير ذلك * والمعتدة عن طلاق رجعي في هذا كالمنكوحة وان كانت العدة عن طلاق باءن او ثلاث في ظاهر الرواية تصح الاجارة وتستحق الاجر المسمي كما لو استاجرها بعد انقضاء العدة وعن ابي حنيفة رحمه الله تعالي في رواية لا اجر لها كما لو استاجرها قبل الطلاق لوجوب نفقة العدة عليه هذا اذا استاجر امراته لترضع ولده منها علي ان يكون الاجر علي الاب من ماله فان كان للصغير مال فاستاجرها الاب علي ارضاع ولده منها روي ابن رستم عن محمد رحممهما الله تعالي انه تصح الاجارة وتكون لها الاجرة لان الارضاع بمنزلة النفقة واذا كان للصغير مال لا تجب النفقة علي والديه وكان لها الاجرة في مال الصغير وبعض المشايخ اخذوا بهذه الرواية* وان استاجر الرجل امراته لارضاع ولده من غيرها جازت الاجارة وكان لها الاجر لان ذلك غير مستحق عليها ديانة* وان استاجر الرجل خادمة امراته لترضع ولده منها لا يجب الاجر وان استاجر مكاتبتها جاز ولا باس للمسلمة بان ترضع ولد الكافر باجر لان من الصحابة رضي الله عنهم من عمل للكافر باجر واذا استاجر الرجل امه او اخته او بنته لترضع ولده جاز ويجب الاجر لانه ليس عليهن ارضاع ولده لا شرعا ولا عرفا* ومن سوي الاب والجد والوصي والقاضي اذا استاجر ظءرا لليتيم كان اجنبيا كساءر الاجانب واذا لم تكن لليتيم ام ترضعه ولا مال له فاجر ارضاعه يكون علي اقاربه بقدر ميراثهم عنه لان اجر الرضاع بمنزلة النفقة ولا يجب علي من لا تجب عليه النفقة * وليس علي الظءر ان تعمل لابوي اليتيم شيءا وعليها غسل الصبي والقيام بمصالحه من اصلاح دهنه وطعامه ولا يجب عليها ثمن شء من ذلك * وقال بعضهم عليها ان تتكلف الدهن والرياحين وانما قال ذلك في عرفهم والمعتبر في هذا العرف واذا ظهرت الظءر كافرة او زانية او مجنونة او حمقاء كان لهم ان يفسخوا الاجارة وكذا اذا ارادوا سفرا او ابت الظءر ان تخرج معهم لا تجبر علي السفر وكان لهم ان يفسخون الاجارة* ولو كان لها زوج ولم ياذن لها بالاجارة وكان للزوج[] ان يفسخ الاجارة وهذا اذا كان النكاح ظاهرا فان لم يكن واقرت المراة بالنكاح لرجل لم يكن للمقر له ان يفسخ الاجارة ولو لم تكن المراة معروفة بالظءرة وكانت ممن تعير بذلك كان لها ان تفسخ الاجارة وكذا لو كان قوم الصغير يءذنها كان لها ان تفسخ الاجارة* وان اجرت نفسها باذن زوجها لم يكن لهم ان يمنعوا الزوج من غشيانها ولهم ان يمنعوه من غشيانها في منزلهم ولهم ان يمنعوا اقرباءها من المكث معها في بيتهم اما الزيارة فينظر ان كان  يءدي ذلك الي الاخلال بتعهد الصبي كان لهم حق المنع وليس عليها ان تمكث في بيتهم اذا لم يشترطوا ذلك في عقد الاجارة وللامة الماذونة ان تءاجر نفسها ظءرا وكذا المكاتبة*
 فصل في اختلاف الاجر والمستاجر
 رجل استاجر دارا او دابة او عبدا ولم يتصرف المستاجر بعد حتي اختلفا فادعي المستاجر ان الاجر خمسة دراهم وقال الاجر عسرة دراهم فانهما يتحالفان فايهما نكل لزمه دعوي الاخر ويبدا بيمين المستاجر فاذا حلفا فسخ القاضي العقد بينهما وايهما اقام البينة قبلت بينته وان اقاما يقضي ببينة الاجر لانه يثبت حق تفسه وكذا لو اختلفا في المدة او في المسافة فقال المستاجر اجرتني شهرين بعشرة دراهم وقال الاجر لا بل شهرا واحدا بعشرة دراهم او قال المستاجر اجرتني الدابة الي الكوفة بخمسة دراهم وقال صاحب الدابة لا بل الي القصر بخمسة دراهم فهذا وما لو اختلفا في الاجر سواء لا انهما اذا اختلفا في المسافة او في المدة يبدا بيمين الاجر وايهما اقام البينة قبلت بينته وان اقاما جميعا في المسافة والمدة يقضي ببينة المستاجر كما لو اختلفا في البيع فقال الباءع بعتك هذا العبد بالف درهم وقال المشتري بعت هذذا العبد وهذا العبد الاخر بالف درهم واقاما البيتة فانه يقضي ببيتة المشتري * وان اختلفا في الاجر والمدة جميعا او في الاجرة والمسافة جميعا فقال الاجر ادجرتك الي القصر بعشرة درلاهم وقال المستاجر لا بل الي الكوفة بخمسة دراهم فانهما يتحالفان واذا حلفا يفسخ العقد وايهما اقام البينة قبلت بينته وان اقاما يقضي بالبينتين جميعا فيقضي بزيادة الاجر ببينة الاجر وبزيادة المدة والمسافة ببينة المستاجر وايهما بدا بالدعوي يحلف صاحبه اولا هذا اذا اتفقا ان الجر كله دراهم او دنانير فان اختلفا في الجنس فقال الاجر اجر تلك الدابة الي القصر بدينار وقال المستاجر بل الي الكوفة بعشرة دراهم فانهما يتحالفان وايهما نكل لزمه دعوي الاخر وانهما اقام البينة قبلت وان اقاما البينة فانه يقضي الي الكوفة بدينار وخمسة دراهم اذا كان القصر علي النصف من بغداد الي الكوفة ويقضي الي القصر بدينار ببينة الاجر ومن القصر الي الكوفة بخمسة دراهم ببينة المستاجر * ولو استاجر دارا سنة فادعي المستاجر انه استاجمرها احد عشر شهرا بدرهم وشهرا بتسعة دراهم وادعي الاجر انه اجرها سنة بعشرة دراهم فاقام كل واحد منهما بينة علي ما ادعي ذكر في المنتقة عن ابي يوسف رحمه الله تعالي انه يقضي ببينة رب الدار ووجه ذلك ان رب الدار ادعي زيادة اجر لاحد عشر شهرا فيقضي ببينته بقي شهر واحد فالمستاجر اقر له بزيادة اجر لهذا الشهر فان شاء صدقه واخذ وان شاء كذبه * وان اختلفا في هذه الوجوه بعد ما مضت مدة الاجارة عند المستاجر او بعد ما وصل الي المكان الذي يدعي اليه الاجارة كان القول قول المستاجر مع يمينه ولا يتحالفان عندهم اما علي قول ابي حنيفة وابي يوسف رحمهما الله تعالي فلان هذا بمنزلة ما لو اختلفا في البيع بعد هلاك السلعة وثمة عندهما لا يتحالفان واما عند محمد رحمه الله فلان في فصل الاجارة لو حلفا لا يثبت احد العقدين فتبقي المنفعة مستوفاة بغير عقد والمنفعة لا تتقوم بدون العقد فلا يجب شء فلا يفيد التحليف اما في البيع اذا حلفا فلم يثبت العقد تبقي العين مقبوضة بدون الثمن وقد عجز عن رده فيغرم قيمته[] فان اختلفا في الاجر بعدما مضي بعض المدة او بعدما سار بعض الطريق فانهما يتحالفان واذا حلفا تفسخ الاجارة فيما بقي ويكون القول قول المستاجر في حصة ما مضي * ولو استاجر دارا شهرا ثم ادعي المستاجر ان الاجر باعها منه بعد الاجارة وانكر الاجر ثم مضت مدة بعد ذلك قالوا الاجارة تكون لازمةفيما مضي لانهما تصادقا علي الاجارة والبيع لم يثبت بخلاف ما لو جحد الاجارة فيما مضي فان ذلك يكون فسخا للاجارة لانه لما جحد الاجارة فقد انكر الاجارة اصلا اما ههنا تصادقا علي الاجارة ومدعي البيع يدعي الابطال ولم يثبت فتبقي الاجارة * وذكر في المنتقي رجل امر رجلا ان يستاجر دار فلان بعينه ثم ان الامر اشتراها من صاحبها بعد ما استاجرها وكيله ولم يعلم هو بعقد الوكيل ثم علم فانه لا يكون له ان يردها وتكون في يده بحكم الاجارة * وذكر فيه ايضا اذا استاجر عبدا سنة فجحد الاجارةبعدما مضي نصف السنة وقيمته يوم الجحود الفا درهم فلم يرد العبد حتي مضت السنة وقيمته الف درهم ثم مات العبد قبل ان يرد ذكر هشام عن محمد رحمه الله تعالي ان الاجارة لازمة ويضمن قيمة العبد بعد السنة قال هشام رحمه الله تعالي قلت لمحمد رحمه الله تعالي كيف يجتمع الاجر والضمان قال لم يجتمع قال هشام اراد بذلك انه انما لزمه الاجر لان المدة تمت والعبد في يده بحكم الاجارة فيلزم الاجر وبعد انتهاء المدة يعتبر جحود فكان عليه رده فاذا لم يرده تلزمه قيمته* رجل تكاري دابة من رجلين فاختلف المكاريان فقال احدهما اكريناكها بعشرة دراهم وقال الاخر لا بل اكريناكها بخمسة  عشر والمستكري يقول اكريتماني بعشرة قال في الكتاب ان كان قبل الركوب كان القول قول المكاري الذي يدعي خمسة عشر في نصيبه وان كان بعد الركوب فالقول قول المستكري* رجل ركب دابة رجل الي بغداد ثم فال اعرتنيها وقال رب الدابة اجرتها بدرهمو نصف فان القول يكون قول الراكب لان صاحب الدابة يدعي تقوم المنفعة وهو ينكر فان اقام صاحب الدابة شاهدين فشهد شاهد بدرهم وشاهد بدرهم ونصف فانه يقضي له بدرهم واحد ولو كان الاجر يدعي الاجارة بدرهمين فشهد شاهد بدرهمين لا يقبل في قول ابي حنيفة رحمه الله تعالي والمسالة معروفة* ولو ركب دابة رجل الي الحيرة فادعي انه اعارها الي الحيرة وقال صاحبها بل اكريتها الي الجبانة الي اطراف البيوت بدرهم فان سلمت الدابة كان القول قول الراكب ولا يلزمه شء وان هلكت كان القول قول صاحب الدابة ويضمن الركب قيمتها لان الراكب اقر بالمجاوزة عن الجبانة وادعي الاذن وصاحبها انكر الاذن فان اقام صاحب الدابة البينة بعد ذلك انه اكراها الي الحيرة بدرهم لا تقبل بينته لانه زعم اولا انه جاوز الجبانة بغير كراء فكان متناقضا في دعواه بعد ذلك*ولو استكري دابة فقال له المكاري استكر غلاما يتبعك ويتبع الدابة واعطه نفقته ونفقة الدابة من الكراء جاز ذلك فان اعطي الغلام نفقته ونفقة الدابة فسرقت منه ان اقر صاحب الدابة بذلك برء المستكري وان اختلفا في الامر باستكراء الغلام او في الامر بدفع النفقة الي الغلام وانكر الدقع فاقر الغلام انه اعطاه قبل قول الغلام* رجل دقع الي حاءك غزلا لينسجه فجحد الحاءك دفع الغزل اليه وحلف ثم اقر وجاء بالثوب منسوجا قالوا ان كان نسجه قبل الجحود كان له الاجر وان كان نسجه بعد الجحود فالثوب للحاءك وعليه مثل ذلك الغزل لصاحبه *ولو دفع الي صباغ ثوبا ليصبغه ثم جحد الصباغ وحلف ثم جاء بالثوب مصبوغا ان[] كان صبغه قبل الجحود فالثوب لصاحبه وله الاجر وان صبغه بعد الجحود يخير صاحب الثوب ان شاء اخذ الثوب واعطاه ما زاد الصبغ فيه وان شاء ترك الثوب عليه وضمنه قيمة ثوب ابيض كما في الغصب * ولو دقع الي قصار ثوبا ليقصره فجحد القصار ثم اقر وجاء بالثوب مقصورا فان كان قصره قبل الجحود كان له الاجر وان كان قصره بعد الجحود فلا اجر له والثوب لصاحبه علي كل حال* ولو اختلف الخياط مع صاحب الثوب فقال الخياط انا خطته وقال رب الثوب انا خطته فان كان الثوب في يد رب الثوب او في بيته فالقول قوله مع يمينه ولا اجر للخياط وان كان الثوب في يد الخياط او في يدهما كان القول قول الخياط مع يمينه وله الاجر * ولو اختلف الخياط مع رب الثوب فقال رب الثوب امرتك ان تقطعه قباء وقد خطته قميصا وقال الخياط لا بل امرتني ان اقطعه قميصا كان القول قول رب الثوب مع يمينه وهو بالخيار ان شاء اخذ القميص واعطاه اجر مثله وانشاء ضمنه قيمة ثوبه غير مقطوع*ولو دفع شبها الي صفار ليضرب له طستا ووصف له فضربه كوزا كان له الخيار ان شاء اخذ الكوز واعطاه اجر مثله لا يجاوز ما سمي وان شاء ضمنه مثل ذلك الشبه * ولو دفع الي صباغ ثوبا ليصبغه احمر بالعصفر ففعل ثم اختلفا في الاجر فقال الصباغ عملته بدرهم وقال صاحب الثوب بدانقين فايهما اقام البينة قبلت وان اقاما يءخذ ببينة الصباغ وان لم يكن لهما بينة ينظر الي ما زاد الصبغ في قيمة الثوب فان كان درهما او اكثر يءخذ بقول الصباغ ويعطي له درهم بعد يمينه بالله ما صبغه بدانقين وان كان ما زاد الصبغ فيه افل من دانقين كان القول قول رب الثوب مع يمينه علي ما ادعي الصباغ وان كان يزيد في قيمة الثوب نصف درهم بعد يمينه ما صبغه بدانقين وان كان الصبغ مما ينقض الثوب كان القول قول صاحب الثوب* وان دفع الي خياط ثوبا ليقطعه قباء محشوا ودفع اليه البطانة والقطن ففعل الخياط ذلك ثم اختلفا فقال رب الثوب ليس هذا بطانتي كان القول قول الخياط مع يمينه* ولو دفع الي قصار ثوبا ليقصره بدرهم فاعطاه القصار ثوبا فقلال هذا ثوبك وقال صاحب الثوب ليس هذا ثوبي كان القول قول القصار في قول ابي حنيفة رحمه الله تعالي وكذا لو كان القصار يدعي رد الثوب لان في قول ابي حنيفة رحمه الله تعالي القصار امين وكذلك كل اجير مشترك والفتوي علي قوله * ولو ان القصار اعطاه ثوبا وقال هذا ثوبك وهو ينكر فاخذ الثوب ونوي ان يكون عوضا عن ثوبه قال محمد رحمه الله تعالي لا يسعه ان يلبس الثوب ولا ان يبيع الا ان يقول للقصار اخذته عوضا عن ثوبي فيقول القصار نعم* ولو دفع متاعا الي حمال ليحمله الي موضع كذا فحمل فقال رب المتاع ليس هذا متاعي وقال الحمال هو متاعك قال ابو يوسف رحمه الله تعالي القول قول الحمال مع يمينه ولا اجر له الا ان يصدقه الاجر وبه ناخذ قال والنوع الواحد والنوعان فيه سواء الا انه في النوع الواحد افحش واقبح ان لا يلزمه الاجر *ولو حمل طعاما او زيتا فقال الحمال هذا طعامك وقال رب الطعام كان طعامي اجود من هذا قال هذا افحش ان ياخذ الطعام  ولا يعطي الاجر فاما في النوعين المختلفين فلا اجر للحمال الا ان يصدقه وياخذه رجل دفع الي الخياط ثوبا ليخيطه له ولم يذكر له اجرا فخاطه فاعطاه اكثر من اجر مثله زيادة علي ما يتغابن فيه الناس قالوا يطيب له في قول ابي حنيفة رحمه الله تعالي * رجل قال لرجل اني اركبتك بغلا من ترمذا الي بلخ بعشرة دراهم وقال المدعي عليه لا بل استاجرتني لابلغه الي فلان ببلخ بخمس دراهم فانه يحلف كل واحد منهما فان حلفا لا يجب شء وان اقاما البينة كانت البينة بينة صاحب البغل لان البغل واجب علي المستاجر فلا تجوز الاجارة علي ذلك* رجل اجر ارضا ثم اختلفا فقال المستاجر استاجرتها وهي فارغة وفال رب الارض كانت مشغولة مزروعة قال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي القول قول صاحب الارض بخلاف المتبايعين اذا اختلفا في الصحة والفساد بحكم الشرط فان ثوة كان القول قول مدعي الصحة لان في هذا الوجه صاحب الارض منكر الاجارة اصلا وقال القاضي الامام علي السغدي رحمه الله تعالي في الاجارة يحكم الحال ان كانت فارغة كان القول قول مدعي الفراغ وقت العقد وان كانت مشعولة كان القول قول صاحب الارض كما في مسءلة الطاحونة اذا اختلفا في جريان الماء وانقطاعه * قال المصنف وينبغي ان يكون القول قول منكر الشغل لان في صحة اجارة المشغول روايتين والصحيح انها جاءزة ويءمر بالتفريغ والتسليم *رجل اجر داره سنة فلما مضت السنة اخذ صاحب الدار الدار وكنسها فقال المستاجر كان لي فيها دراهم وانك كنستها والقيتها في الطريق ولي عليك ضمانها فان انكر صاحب الدار ذلك كان القول قوله *رجل دفع الي صاءغ عشرة دراهم فضة وقال زد عليها درهمين يكون قرضا علي وصفه قلبا واجرك درهم فصاغه وجاء به محشوا وقال زدت عليها درهمين وقال صاحب الفضة لم تزد عليها شيءا فانه يحلف كل واحد منهما فان حلفا يخير الصاءغ ان شاء دفع القلب اليه واخذ منه خمسة دوانق درهم اجر العشرة وان شاء دفع اليه عشرة دراهم فضة واخذ القلب لان الصاءغ يدعي علي صاحب الفضة قرض درهمين وهو ينكر وصاحب القلب يدعي علي الصاءغ استحقاق القلب بغير شء وهو ينكر فيحلف كل واحد منهما * ولو دفع الي حاءك غزلا وامره ان يزيد في الغزل رطلا من عنده علي ان يعطيه ثمن الغزل واجر الثوب دراهم معلومة جاز ذلك وان اختلفا بعد النسج فقال الحاءك زدت وقال صاحب الغزل لم تزد فان كان وزن غزل صاحب الغزل معلوما بان اتفقا علي ان غزله كان منا فان كان الثوب قاءما في يده يوزن فان وزن فوجد منوين فقال رب الثوب هذا من الدقيق وقال الحاءك هذا من الدقيق وزيادة رطل غزل زدته قالوا القول قول الحاءك لان الدقيق لا يزيد هذا القدر ظاهرا وان رجع القاضي الي علماء الحوكة في ذلك كان احسن فان رجع اليهم وقالوا الدقيق لا يزيد هذا القدر كان القول قول الحاءك مع يمينه فاذا حلف يجبر رب الثوب علي ان يعطيه ما سمي له وياخذ الثوب وان قال اهل العلم الدقيق يزيد هذا القدر كان القول قول رب الثوب مع يمينه فان حلف يخير صاحب الثوب ان شاء ضمنه مثل غزله وترك الثوب عليه وان شاء اخذ الثوب واعطاه من الاجر بحساب ما اقام من العمل وان كان الثوب مستهلكا عند صاحب الثوب قبل ان يعلم وزنه كان القول رب الثوب مع يمينه علي علمه انه ما يعلم ان الحاك زاد في الغزل فان حلف كان عليه اجر الثوب دون ثمن الغزل فيقسم المسمي علي عمل ثوب مثله وعلي قيمة رطل من الغزل فيطرح عنه ما اصاب قيمة الغزل * وقال الحاكم الشهيد رحمه الله تعالي لصواب ان يطرح عنه ايضا حصة ما ترك من زيادة العمل في النسج لانه التزم الاجر المسمي بمقابلة العمل في ثلاثة ارطال غزل وهو امنا عمل في رطلين هذا اذا اختلفا ووزن غزل الدافع كان معلوما فان لم يكن معلوما كان القول قول الدافع وهو رب الثوب مع يمينه سواء كان الثوب قاءما او هالكا ولا يرجع في هذا الي قول الحوكة لانه لا تمكن معرفة الصادق من الكاذب وفي مسالة الصاءغ والقلب يجب ان يرجع في معرفة الزيادة الي اهل العلم ان كانوا يعرفون ذلك وقد ذكرنا مثل ذلك في النداف اذا دفع اليه ثوبا وامره ان يزيد في قطنه* رجل حمل رجلا كرها فذهب به الي بعض البلاد قالوا عليه الكراء حتي يرده الي المكان [] الذي منه وكذا كل شء له حمل ومءنة* صاحب حانوت امر اجيرا له ليرش الماء في طريق المسلمين ففعل وعطب به انسان قال ابو يوسف رحمه الله تعالي يضمن الامر * ولو امره بالوضوء فتوضا كان الضمان علي الاجير لان منفعة الوضوء تكون للمتوضء ومنفعة الرش تكون للامر * رجل ركب سفينة رجل من ترمذا الي امل ثم اختلفا فقال صاحب السفينة للراكب حملتك الي امل بخمسة دراهم وقال الراكب استاجرتني لاحفظ السكان الي امل بعشرة دراهم يحلف كل واحد منهما وليست البداءة بيمين احدهما باولي من الاخر وكان للقاضي ان يبدا بايهما شاء وان اقرع للبداءة كان حسنا فان حلفا لا اجر لاحدهما علي صاحبه وان اقاما البينة كانت  البينة بينة الراكب وهو الملاح يقضي له بالاجر علي صاحب السفينة ولا اجر عليه لصاحب السفينة لانهما لما اقاما البينة يجعل كان الامرين كانا فبطلت اجارة صاحب السفينة من الراكب لانه لا بد للملاح من ان يكون في السفينة والله اعلم بالصواب
 *(كتاب الدعوي والبينات)*
 وانه مشتمل علي ابواب كل باب مشتمل علي فصول * الباب الاول منه في اداب القاضي* الفصل الاول منه في معرفة اهل القضاء والدخول في القضاء والتحرز عنه * فاهله من يكون اهلا للشهادة ومن لا يكون اهلا للشهادة كالعبد والصبي والاعمي والمراة والكافر لا يكون اهلا للقضاء حتي لو قلد فقضي لا ينفذ قضاءه وكذا الحدود في القذف وبعض العلماء منهم الخصاف والطحاوي رحمهما الله تعالي الحقوا بهءلاء الفاسق والمرتشي وعندهما اذا قلد الفاسق لا يكون قاضيا واذا فسق ينعزل وكذا المرتشي واختلفت الروايات عن اصحابنا المتقدمين رحمهم الله تعالي والصحيح ما قال عامة المشايخ رحمهم الله تعالي انه اذا قلد وهو عدل ثم فسق يستحق العزل ولاينعزل حتي لو قضي بعد الفسق جاز قضاءه سواء كان القاضي مرتزقا من بيت المال او لم يكن* واجمعوا انه اذا ارتشي لا ينفذ قضاءه فيما ارتشي* القاضي اذا ارتد والعياذ بالله ثم اسلم كان علي قضاءه * وكذا اذا عمي ثم ابصر ولا ينفذ ما قضي في حال ردته * الوالي اذا فسق فهو بمنزلة القاضي يستحق العزل ولا ينعزل ومع اهلية الشهادة لا بد ان يكون عالما ورعا فان كان جاهلا عدلا او عالما غير عدل لا ينبغي له ان يتقلد ولا يقلد لقول عليه السلام القضاة ثلاثة واحد في الجنة واثنان في النار واراد بالاثنين الجاهل وغير العدل*والجاهل التقي اولي بالقضاء من العالم الفاسق * وعلي قول الشافعي رحمه الله تعالي اذا قلد الجاهل لا يصير قاضيا * وعند استجماع الشراءط يكره الدخول في القضاء عن اختيار * وان قلد من غير طلبه فان كثر امثاله في البلد لاختلفوا فيه قال بعضهم يكره له الدخول وعند الاكثر لا باس بالدخول وان تعين هو من البلدة قالوا يفترض عليه الدخول ولو امتنع ياثم لان القضاء فرض كفاية بمنزلة صلاة الجنازة اذا تعين الواحد لاقامتها يفترض عليه فان قلدو ا غيره افضل منه كان الافضل اولي * وكذا الوالي فاما الخليفة فليس لهم ان يولوا الا افضلهم * الامام اذا لم يكن عدلا جاز احكامه وحكامه لان الصحابة رضي الله عنهم تقلدوا الاعمال من معاوية والحق في نوبته كان مع علي رضي الله عنه واذا ارتشي ولد القاضي او كاتبه او بعض اعوانه ليعين الراشي عند القاضي ففعل ان لم يعلم القاضي بذلك تفذ قضاءه وكان علي المرتشي رد ما قبض وان علم القاضي بذلك كان قضاءه مردودا* واذا تقلد القضاء بالرشوة لا يصير قاضيا وتكون الرشوة حراما علي القاضي والاخذ * ثم الرشوة علي وجوه اربعة منها ما هو حرام من الجانبين احدها هذه والثاني اذا دفع الرشوة الي القاضي ليقضي له وهذه الرشوة حرام من [] الجانبين سواء كان العشاء بحق او بغير حق * ومنها اذا دفع الرشوة لخوف علي نفسه او ماله وهذه الرشوة حرام علي الاخذ غير حرام علي الدافع * وكذا اذا طمع في ماله فرشاه بعض المال * ومنها اذا دفع الرشوة ليستوي امره عند السلطان حل له الدفع ولا يحل للاخذ ان ياخذ * وان اراد ان يحل للاخذ يستاجر الاخذ يوما الي الليل بما يريد ان يدفع اليه فانه تجوز هذه الجارة ثم المستاجر ان شاء استعمله في هذا العمل وان شاء استعمله في غيره هذا اذا اعطي الرشوة اولا ليستوي امره عند السلطن وان طلب منه ان يستوي امره ولنم يذكر له الرشوة ثم اعطاه بعد ما سوي اختلفوا فيه قال بعضهم لا يحل له ان ياخذه وقال قعضهم يحل وهو الصحيح لانه بر ومجازاة الاحسان فيحل كما لو جمعوا للامام والمءذن شيا واعطوه من غير شرط كان حسنا* وكما لا يخحل للقاضي اخذ الرشوة لا يحل له قبول الهدية من الاجنبي الذي لم يكن يهدي اليه قبل القضاء وكذا الاستقراض والاستعارة * وان اهدي اليه من كان يهدي اليه قبل القضاء فان كان له خصومة لا يحل له ان يقبل وان لم يكن له خصومة فان كانت هذه الهدية مثل ما يهدي اليه قبل القضاء او دونها لا باس بان يقبل وان كانت اكثر من ذلك رد الزيادة *

 ولا باس بان يقبل الهدية من القريب الذي لم يكن له خصومة * وكما لا يقبل الهدية ممن كان لا يهدي اليه قبل القضاء لا يجيب الدعوة الخاصة ويجيب الدعوة العامة * وانما يعرف الخاص من العام ان ينظر ان كان بحال لو لم يجب القاضي دعوته لا يتخذ الدعوة فهي خاصة* وان كان يتخذ الدعوة وان لم يجبه القاضي فهي عامة * وهذا اذا لم يكن بينهما قرابة* وان كان بينهما قرابة يجيب وان كانت خاصة * ولا باس للقاضي ان يرتزق من بيت المال وان استعف فهو افضل وللعلماء والقضاة والمعلمين حظ في بيت المال * ويجوز للامام والمفتي قبول الهدية واجابة الدعوة الخاصة لان ذلك من حقوق المسلم علي المسلم وانما يمنع عنه القاضي* ويصح تعليق تقليد القضاء والامارة بالشرط كتعليق الوكالة * وكذا الاضافة الي وقت في المستقبل بان قال له الخليفة اذا قدمت بلدة كذا فانت قاض وانت اميرها او قال اذا قدم فلان فانت قاض * تعليق عزل القاضي بالشرط صحيح ذكر الخصاف ان الخليفة اذا كتب الي القاضي اا وصل اليك كتابي فانت معزول فوصل اليه الكتاب يصير معزولا وتعليق التحكيم لانسان بين اثنين والاضافة الي وقت في المستقبل علي قول محمد يصح وعلي قول ابو يوسف رحمه الله تعالي لا يصح وعليه الفتوي * ولو كان في البلدة قاضيان كل واحد منهما علي محلة علي حدة جاز فان وقعت الخصومة بين رجلين احدهما من كحلة والاخر من محلة اخري وامدعي يريد ان يخاصمه الي قاضي محلته والاخر يابي اختلف فيها ابو يوسف ومحمد رحمهما الله تعالي والصحيح ان العبرة لمكان المدعي عليه* وكذا لو كان احدهما من اهل العسكر والاخر من اهل البلدة فاراد العسكري ان يخاصمه الي قاضي العسكر فهو علي هذا الخلاف * واذا مات الخليفة لا تنعزل قضاته وعماله * وكذا لو كان القاضي ماذونا بالاستخلاف فاستخلف غيره فمات القاضي لا ينعزل خليفته واذا قلد الامام رجلا القضاء يوما او مجلسا جاز ويتوقف بالمكان والزمان* واذا قلد السلطان ردلا قضاء بلدة كا لا يدخل فيه السواد والقري ما لم يكتب في منشوره البلدة والسواد * ولو فوض السلطان قضاء بلدة الي اثنين لا ينفرد احدهما بالقضاء منا لو وكل رجلين بالبيع * القاضي اذا لم يكن ماذونا بالاستخلاف فاستخلف فحكم الخليفة في مجلس القاضي بين يديه جاز كالوكيل بالبيع اذا لم يكن ماذونا بالتوكيل فوكل غيره فباع الثاني[] بحضرة الاول جاز * ولو ان الخليفة لم يحكم بين يدي القاضي فحكم في غيبته ورفع قضاءه الي القاضي فاجاز قضاءه ينفذ عندنا استحسانا ولا ينفذ قياسا وهو قول زفر رحمه الله تعالي كالوكيل اذا لم يكن ماذونا بالتوكيل فوكل غيره وباع الثاني عند غيبته فاجاز الاول بيعه جاز عندنا* وكذلك القاضي اذا اجاز حكم الحكم في المجتهدات وهذا اذا كان الخليفة ممن يجوز حكمه فان كان ذميا او مجنونا او صبيا او عبدا فاجاز القاضي حكمه لا يجوز* ويجوز قضاء المراة فيما خلا الحدود والقصاص لانها تصلح شاهدة فيما خلا الحدود والقصاص ولا تصلح شاهد فيهما * القاضي اذا قضي زمانا ثم ظهر انه عبد او محدود في قذف او اعمي او فاسق اومرتش فانه يرد قضاءه ولا ينفذ منه شء كذا ذكر الخصاف * اما غير الفاسق والمرتشي ممن ذكرنا فظاهر لانهم ليسوا من اهل الشهادة* واما الفاسق والمرتشي فهو قول الخصاف وهو اختيار الطحاوي * وعندنا الفاسق من اهل الشهادةو فيما ارتشي اذا وقع بحق ذكر الشيخ الامام علي بن محمد البزدوي رحمه الله تعالي انه ينفذ* الخوارج واهل البغي اذا قلدوا رجلا من اهل البغي قضاء بلدة غلبوا عليها لا ينفذ قضاءه لان شهادتهم علي اهل العدل غير مقبولة لانهم يسحلون اموالنا ودماءنا فلا ينفذ قضاءه وان قلدوا رجلا من اهل العدل صح تقليدهم ونفذ قضاءه * القاضي اذا كان ماذونا بالاستخلاف فاستخلف رجلا صح استخلافه فان عزله لا يضح عزله الا اذا قال له الخليفة استخلف من شءت واستبدل من شءت فحينءذ يملك العزل والتقليد* (فرق بين القضاء والامامة )* الامير اذا استخلف رجلا في الجمعة جاز وان لم يامره الخليفة بذلك لان ثم لو لم يصح الاستخلاف تفوت الجمعة كذلك وصي الاب يملك الايصاء وان لم يامره الميت بالايصاء * ولو ان الامام قلد رجلا القضاء واذن له بالستخلاف فامر القاضي رجلا ليسمع الدعوي والشهادة في حاثة ويسال عن الشهود ويسمع الاقرار ولا يحكم هو بذلك لكنه يكتب بذلك الي القاضي وينهي حتي يقضي القاضي بنفسه لم يكن لهذا الخليفة ان يحكم وانما يفعل ما امره القاضي * واذا رفع الامر الي القاضي فان القاضي لا يقضي بتلك الشهادة ولا بذلك الاقرار بل يجمع بين المدعي والمدعي عليه ويامره باعادة البينة فاذا شهدوا بذلك بحضرة الخصمين فحينءذ يقضي القاضي بتلك الشهادة* قالوا هذه المسالة يغلط فيها القضاة فان القاضي يستخلف رجلا ليسمع الشهادة في حادثة ثم يكتب اليه بكتاب فيفعل الخليفة ذلك ثم يكتب الي القاضي انهم شهدوا عندي بكذا ويكتب الفاظ الشهادة او يكتب ان المدعي  عليه اقر عندي بكذا فيقضي القاضي بذلك عن غير اعادة البينة عنده فلا يصح هذا القضاء لان القاضي لم يسمع تلك الضهادة ولم يسمع ذلك الاقرار فكيف يقضي بتلك الشهادة وبذلك الاقرار باقرار الخليفة الا ان يشهد الخليفة مع اخر عند القاضي علي اقراره وتكون فاءدة هذا الستخلاف ان ينظر الخليفة هل للمدعي شهود او يكذب فلعل له شهودا الا انهم غير عدول او قج لا تتفق الفاظهم فيفوض القاضي النظر في ذلك الي الخليفة.
 (فصل فيما يستحق علي القاضي وما ينبغي له ان يفعل وما لا يفعل)  لا ينبغي للقاضي ان يبيع ويشتري بنفسه بل يفوض ذلك الي غيره* وعن محمد رحمه الله تعالي انه لا باس بان يفعل ذلك في غير مجلس القضاء * والصحيح انه لا يفعل لا في مجلس القضاء ولا في غيره لان الناس يساهلونه لاجل القضاء ولا ينبغي لمن يدخل مجلس القضاء لاجل الخصومة ان يسلم علي القاضي ولو سلم لا يجب علي القاضي رد سلامه فان اراد القاضي جوابه ينبغي ان لا يزيد علي قوله وعليكم * ويسلم [] الشاهد علي القاضي ويرد عليه ولا باس للقاضي ان يفتي من لم يخاصم اليه ولا يفتي احد الخصمين فيما خوصم اليه*واذا خاصم رجل السلطان الي القاضي فجلس السلطان مع القاضي في مجلسه وخصمه علي الارض ينبغي للقاضي ان يقوم من مقامه ويجلس فيه خصم السلطان حتي لا يكون مفضلا احد الخصمين علي الاخر في الجلوس وهذه المسالة تدل علي ان القاضي يصلح قاضيا علي السلطان الذي قلده والدليل عليه قصة علي رضي الله تعالي عنه عند شريح رضي الله تعالي عنه * ويقضي القاضي وهو مستوف حظه من الطعام والشراب * ولا يقضي وهو جاءع ولا شبعان ولا غضبان ولا كظيظ من الطعام ولا ماخوذ احد الاخبثين ولا به نعاس او نوم ولا يشار احد الخصمين ولا يضم احدهما الي نفسه ولا يضحك* وصاحب مجلسه يقيم الخصوم بين يديه من العبد والشهود تقرب من القاضي ويخرج للقضاء في احسن ثيابه واعدل احواله* وياخذ كاتبا عالما ورعا فان كان القاضي فقيرا محتاجا الاولي له ان ياخذ رزقه من بيت المال بل يفترض عليه وان كان غنيا تكلموا فيه والاولي له ان لا ياخذ من بيت المال * ويجلس للقضاء في مسجد حيه والمسجد الجامع افضل اذا كان المسجد الجامع في وسط البلدة فان كان في طرف من البلدة يختار مسجدا اخر في وسط البلدة* وله ان يقضي فيداره اذا كانت داره في وسط البلدة ويختار الجلوس في مسجد السوق ليكون اشهر * وعند الشافعي رحمه الله تعالي ليس للقاضي ان يقضي في المسجد* فاذا جلس القاضي في المسجد او في داره ياخذ بوابا ليمنع الخصوم من الازدحام * ولا يباح للبواب ان ياخذ شيا لياذن بالدخول* ومتي دخل القاضي المسجد يصلي ركعتين او اربعا ثم يجلس مستدبرا القبلة كما يجلس المدرس والخطيب*ولا تدخل فيه الحاءض والنفساء ولكن القاضي يخرج اليهن او يجلس القاضي في المسجد وهي خارجه بحيث يسمع كلامها والمشرك يدخل المسجد هذا في عرفنا * اما في عرفهم كان القاضي يجلس مستقبل القبلة* واذا جلس الخصوم بين يديه هل يستنطقهم قال ابو يوسف رحمه الله تعالي يستنطقهم فيقول ايكما المدعي فاذا عرف المدعي يقول له ماذا تدعي * وقال محمد رحمه الله تعالي لا يفعل ذلك وقول ابي يوسف رحمه الله تعالي اوفق* واذا ادعي المدعي شيا علي المدعي عليه يكتب القاضي علي بياض صورة الدعوي ثم يقول للمدعي عليه ماذا تقول فان اقر بما ادعاه المدعي اثبت اقراره في كتابه ويامر المدعي عليه بايفاء الحق وان انكر يكتب انكاره في ذلك ثم يامر المدعي باقامة البينة هذا كان في عرفهم اما في عرفنا المدعي يجء الي كاتب القاضي فيخبره بكيفية دعواه ويصور عنده صورة الدعوي فيكتب الكاتب ذلك ثم يجء الي القاضي مع خصمه ويدعي عليه فان اقر خصمه اثبت القاضي اقراره في الكتاب ويامره بقضاء الحق وان انكر امر المدعي باقامة البينة فان جاء المدعي بشهود فشهدوا عنده علي الترتيب يكتب القاضي شهادة كل شاهد ويكتب اسمه واسم ابيه وجده ويترك بين كل خطين بياضا بيانا لشهادة كل واحد منهم* واذا جاء رجل الي القاضي وذكر ان له علي فلان ابن فلن دعوي فان كان المدعي عليه غاءبا يدفع القاضي اليه طية عليها ختم القاضي مكتوبا فيها اجب خصمك الي مجلس الحكم وان كان المدعي عليه حاضرا في المصر احضره القاضي بمجرد دعوي المدعي وكذا اذا كان قريبا من المصر فان كان بعيدا لا يعدي خصمه بمجرد قول المدعي حتي يقيم البينة ان له علي فلان حقا فان اقام البينة اعداه القاضي استحسانا وفي القياس لا يعدي كما لو كان بعيدا والفاصل بين القريب والبعيد ما قال الخصاف انه ان كان في موضع يمكنه ان يحضر مجلس[] القاضي ويجيب خصمه ويعود الي منزله في ذلك اليوم ولا يفسد عشاءه فهو قريب والا فهو بعيد* وعلي هذا الشهادة علي الشهادة ان كان شاهد الاصل في مكان قريب علي هذا التفسير لا تجوز الشهادة علي الشهادة وان كان بعيدا بهذا التفسير تجوز الشهادة علي الشهادة وعن محمد رحمه الله تعالي انه يجب علي الامام ان ينصب قضاة في الكور فيما دون مدة السفر احترازا عن مشقة الاعداء ويسقط الاعداء بعذر المرض وكذا اذا كانت المراة مخدرة وذكر الشيخ الامام علي بن محمد البزدوي رحمه الله تعالي المخدرة هي التي لا تكون برزة بكرا كانت او ثيبا لا يراها غير المحارم من الرجال اما التي جلست علي المنصة فراها رجال اجانب كما هو عادة بعض البلاد لا تكون مخدرة * والمراة التي تخرج الي حواءجها يعديها القاضي * وفي المخدرة يبعث القاضي اليها امينا اذا لم تثبت الوكالة عنها  ليستحلفها* وكذا في المريض فان نكلت ثلاثا اشهد علي ذلك شهودا وياخذ وكيلا فاذا شهدوا به عند القاضي قضي بذلك علي الوكيل ولا يقضي الامين الا ان يكون القاضي ماذونا بالاستخلاف فبعث الامين واستخلفه وفي هذا وجه اخر ان يحكما بينهما حكما ليحكم بينهما ثم يرفع حكمه الي القاضي فيجيزه القاضي ان راه جاءزا * وان كان المدعي عليه غاءبا بعيدا عن المصر علي التفسير الذي ذكرنا لا يشخصه القاضي ما لم يقم المدعي البينة علي ما ادعي فاذا اقام قبلت بينته للاشخاص لا للقضاء والمستور في هذا يكفي* وان سال المدعي من القاضي ختما لاحضار خصمه اعطاه القاضي فاذا ذهب به الي الخصم اراه ذلك واخبر انه ختم القاضي ليدعوه في وقت كذا فان امتنع ورد ذلك اشهد عليه شاهدين فاذا شهدا بذلك عند القاضي يستحضره القاضي باعوانه ان قدر والا يسال الوالي ان يستحضره * ومءنة المستحضر علي المتمرد هو الصحيح وقيل تكو في بيت المال فاذا احضر يحبسه القاضي عقوبة وكذا اذا سكت المدعي عليه بعد ما راي الختم ولم يرد لانه ظهر تعنته وكذا اذا وعد ثم خالف الا ان هذا دون الاول في العقوبة * ولو ادعي علي صبي محجور حقا فان لم يكن له بينة علي ما ادعي لم يحضره القاضي * وان اخبر القاضي ان فلانا طلق امرانه ثلاثا او استرق الحر ان اخبره بذلك عدلان كان علي القاضي ان يطلبه اشد الطلب وان كان المخبر عدلا واحدا او لم يكن عدلا وغلب علي ظن القاضي انه صادق فالاولي ان يطلبه وان لم يغعلب علي ظنه انه صادق لم يكن عليه ان يطلبه * ولو ان رجلا قال للقاضي ان لي علي فلان حقا وهو في منزله يتواري عني ولا يحضر معي فان القاضي يستحضره فان لم يقدر يكتب الي الوالي في احضاره فالن قال الوالي لا اظفر به وسال المدعي من القاضي تسمير الباب والختم عليه فان القاضي لا يجيبه الي ذلك الا ان ياتي بشاهدين انه في منزله فان شهدا بذلك سالهما القاضي من اين علمتما فان قالا لانا رايناه في منزله اليوم او امس او ما اشبه ذلك فان القاضي يختم علي بابه ويجعل بيته حبسا عليه ويسد اعلاه واسفله حتي يضيق المر فيخرج* وان قالا ما رايناه منذ شهر لا يلتفت الي كلامهما لانه قد يغيب اذا طالت المدة وقدر ذلك بثلاثة ايام وان ختم القاضي علي بابه ولم يخرج قال ابو يوسف رحمه الله تعالي يبعث القاضي رسولا ومعه شاهدان فينادي الرسول علي بابه يا فلان ابن فلان ان القاضي فلان ابن ابن فلان يقول لك احضر مع فلان بمجلس الحكم والا انصب لك وكيلا واقبل بينة المدعي عليك هكذا يفعل القاضي ثلاثة ايام فان لم يحضر يفعل ما قال ويقضي علي وكيله بما يدعي عليه الخصم* قال شمس الاءمة الحلواني رحمه الله تعالي كان الامام الاستاذ يقول رايت في النوادر هذا عن ابي حنيفة ومحمد رحمهما الله تعالي فكان ذلك منهم اتفاقا قال ابو يوسف رحمه الله تعالي وكذا لو كتب القاضي الي القاضي كتابا في حادثة فلم يقدر القاضي المكتوب اليه علي الخصم فان القاضي يوكل عنه علي نحو ما قلنا * قال شمس الاءمة الحلواني رحمه الله تعالي واصحابنا لم يجوزوا الهجوم وصورته ان يبعث القاضي نساء يطلبنه في البيت واعوانا ياخذون السفل والعلو كيلا يهرب وقال السيخ الامام علي بن محمد البزدوي رحمهما الله تعالي والمشهور من قول ابي حنيفة رحمه الله تعالي ان القاضي لا ينصب وكيلا بعد ختم الباب ولكنه يهجم عليه صورته ما قلنا انهيبعث نساء ورجالا تدخل النساء منزل المدعي عليه وتجعل النساء الخدم من جانب ثم تفتش امراة ثقة حرمه وخدمه كيلا يكون فيهن رجل يتشبه بالمراة فان وجد المدعي عليه يءخذ وان لم يوجد يطلب فيما بقي من البيت قال وهذا استحسان فعله عمر رضي الله تعالي عنه والصالحون بعده وتركوا فيه القياس فان كان المديون يسكن دارا باجارة وامتنع من الحضور الي باب القاضي هل يسمر القاضي بابه اختلفوا فيه والصحيح انه يسمر وان كان ساكنا في دار مشتركة لا يسمر بابه * والرجل الذي توجه عليه الحكم بالبينة اذا اختفي لا يقضي القاضي عليه في قول ابي حنيفة رحمه الله تعالي وقال محمد رحمه الله تعالي يعذر ثلاثة ايام فينادي علي بابه ثلاثة ايام علي نحو ما قلنا فان خرج والا يقضي عليه وان لم يختف ولكنه غاب لا يقضي عليه* وذكر الخصاف اذا غاب المدعي عليه بعد ما سمع القاضي عليه البينة او غاب الوكيل بالخصومة بعد قبول البينة قبل التعديل او مات الوكيل ثم عدلت تلك البينة لا يقضي بتلك البينة وقال ابو يوسف رحمه الله تعالي يقضي وقال شمس الاءمة الحلواني رحمه الله تعالي وهذا ارفق بالناس * ولو اقر المدعي عليه ثم غاب فانه يقضي عليه باقراره في قولهم وان غاب الوكيل او مات بعد ما اقيمت عليه البينة ثم حضر الموكل يقضي عليه بتلك البينة كذا ذكر في الزيادات وكذا لو غاب الموكل ثم حضر الوكيل فانه يقضي عليه بتلك البينة وكذا لو مات المدعي عليه بعد ما اقيمت عليه البينة يقضي بتلك البينة علي الوارث* وكذا لو اقيمت البينة علي احد  الورثة ثم غاب فانه يقضي بتلك البينة علي الوارث الاخر وكذا لو اقيمت البينة علي الصغير ثم بلغ الصغير يقضي عليه بتلك البينة ولا يكلف باعادة البينة.
 *(باب الدعوي)*
 رجل ادعي عند القاضي علي رجل حقا فهو علي وجوه اما ان يدعي دينا او عينا والعين لا تخلو اما ان تكون منقولا او غير منقول والمنقول لا يخلو اما ان يكون قاءما او هالكا والقاءم لا يخلوا اما ان يكون غالءبا او حاضرا فيجعل لكل قسم فصل علي حدة * اما اذا كان المدعي به دينا لا تصح الدعوي الا بعد بيان القدر والجنس والصفة فان كان المدعي عاجزا عن الدعوي عن ظهر القلب يكتب دعواه في صحيفة ويدعي منها فيسمع دعواه ولو كان لسانه غير لسان القاضي ياخذ مترجما وكذا الشاهد * والعدد في المترجم ليس بشرط في قول ابي عنيفة وابي يوسف رحمها الله تعالي وكذا الاختلاف في رسول القاضي* واشارة الاخرس فيما لا يسقط بالشبهات وفيما يسقط كعبارة غيره حتي يستوفي القاضي باشارته واشارته في ذلك تكون كعبارته الا في الحدود الخالصة لله تعالي* وان ذكر المدعي جميع ذلك ولم يذكر السبب فقال المدعي عليه سله من اي وجه يدعي يساله القاضي عن ذلك فان ابي ان يبين ذكر في عامة الروايات ان القاضي لا يجبره علي بيان السبب وذكر الشيخ الاما علي بن محمد البزدوي رحمهما الله تعالي ان القاضي اذا ساله عن السبب لا يجب عليه ان يجيب لان المدعي قد يستحي عن بيان السبب او يشق عليه بيان ذلك * فان[] بين المدعي عليه وقال هذا المال الذي يدعي علي من ثمن خمر او ميتة قال ابو حنيفة رحنه الله تعالي يصير مقرا بالمال اذا كذبه المعي في السبب وقال ابو يوسف ومحمد رحمهما الله ان بين مفصولا فكما قال ابو حنيفة رحمه الله تعالي وان ين موصولا لا يصح بيانه * واصل المسالة اذا قال لغيره لك علي الف درهم من ثمن جارية بعتنيها الا اني لم اقبض قال ابو حنيفة رحمه الله تعالي يءخذ المال وقالا كذلك ان فصل وان وصل لا يلزمه شء* ولو ابتدا بالسبب وقال انه باعني الخمر او الميتة بكذا لا يصير مقرا بالمال * وان قال المدعي عليه علي الف درهم يقيم البينة ان ياخذ القاضي من المدعي عليه كفيلا بنفسه فان القاضي يقول للمدعي الك بينة ان قال لا لم يكفل خصمه وانقال نعم لكنها غاءبة فكذلك لا يكفله وان قال لي بينة حاضرة في المصر كفله القاضي يطلب الخصم وعن محمد رحمه الله تعالي ان طلب المدعي ليس بشرط وقيل ان كان المدعي عليه رجلا مجهولا يتواري مثله غالبا كفله القاضي من غير طلب وان كان رجلا شريفا لا يكفله وقال بعضهم ان كان المدعي مهتديا الي الخصومات لا يكفله من غير طلب المدعي وان كان به عجمة لا باس بان يرشده القاضي الي طلب الكفيل فيكفل خصمه واذا اعطاه كفيلا ثلاثة ايام بنفسه فمضت الايام الثلاثة خرج الكفيل من الكفالة ولو فال كفلت الي ثلاثة ايام في ظاهر الرواية يصير كفيلا بعد الايام الثلاثة كما لو قال لامراته انت طالق الي ثلاثة ايام فانه يقع الطلاق بعد الايام الثلاثة* وعن ابي يوسف رحمه الله تعالي اذا قال كفلت الي ثلاثة ايام يطالب الكفيل في الايام الثلاثة ولا يطالب بعدها * وقال شمس الاءمة الحلواني رحمه الله تعالي هذا عرف الناس * وعن ابي يوسف رحمه الله تعالي في رواية اخري اذا قال انا كفيل ثلاثة ايام يصير كفيلا في الحال واذا مضت الايام الثلاثة لا تبقي الكفالة * ولو قال اني كفيل الي ثلاثة ايام يصير كفيلا بعد الايام الثلاثة وعن الشيخ الامام ابي بكر محمد بن الفضل رحمه الله تعالي انه كان ياخذ بهذه الرواية ويقول هذا اشبه بعرف الناس وحكي عنه انه لو قال بالفارسية بذير فتم تن فلا نراده روز يكون كفيلا في الحال* واذا مضت عشرة ايام لا تبقي الكفالة * ولو قال بذير فتم تن فلا نراتاده روز يصير كفيلا بعد عشرة ايام * ولو قال انا كفيل بنفس فلان الي عشرة ايام واذا مضت عشرة فانا برء من الكفالة ذكر الخصاف رحمه الله تعالي في الحيل انه لا يطالب بهذه الكفالة اصلا لا في العشرة ولا بعدها * وذكر في جمع التفاريق لو قال انا كفيل الي شهر يصير كفيلا بعد الشهر الا انه لو سلم نفسه قبل الشهر برء عن الكفالة لانه سلم بعد السبب* ولو قال كفلت بنفس فلان شهرا يصير كفيلا ابدا قبل الشهر وبعده واعتماد اهل زماننا علي انه لو قال بالعربية كفلت بنفس فلا شهرا يكون كفيلا في الحال واذا مضي الشهر لا تبعي الكفالة * ولو قال الي شهر يخرجه القاضي عن الكفالة بعد الشهر * ولو قال كفلت بنفس فلا ن من اليوم الي عشرةايام يصير كفيلا في الحال واذا مضت العشرة لا تبقي الكفالة * ولو كفل بنفس رجل علي انه ان لم يسلم اليه النفس فهو كفيل بالمال الذي له عليه فيطالب الكفيل بتسليم النفس * والمكفول بنفسه بالسواد هل تلزم الكفالة بالمال او يمهله القاضي حتي يذهب بالسواد ويجء به قال الشيخ الامام الاجل ظهير الدين رحمه الله تعالي تلزمه الكفالة بالمال ولا يكون هذا مستثني عن الكفالة واذا ثبت  ان القاضي ياخذ كفيلا من المدعي عليه بنفسه بطلب[] المدعي ينبغي ان لا بجيره علي اعطاءه الكفيل لو امتنع فان اعطاه كفيلا ينبغي ان يكون الكفيل معروف الدار معروف التجارة وبعضهم شرطوا ان لا يكون لجوجا معروفا بالخصومة وان يكون من اهل المصر ولا يكون غريبا * وان كفله كفله مدة مءقتة واختلفت الروايات في تلك المدة والصحيح انه يكفله القاضي الي المجلس الثاني فان كان القاضي يجلس كل ثلاثة ايام او اكثر يكفله بلك المجة وقال شمس الاءمة الحلواني رحمه الله تعالي ذلك مفوض الي راي القاضي هذا اذا كان المدعي عليه رجلا من اهل المصر فان كان مسافرا لا يكفله ولكن يءجل المدعي الي اخر المجلس فان اقام بينة والا خلي القاضي سبيله * وان ادعي الخصم انه مسافر وانكر المدعي ذلك كان القول قول المدعي لان الاقامة في الامصار اصل دل عليه مسالة ذكرها في النوادر رجل دخل مسجدا من المساجد في المصر فام قوما في صلاة الظهر او العصر فلما صلي ركعتين سلم وخرج من المسجد ولم يعرف انه كان مسافرا لااو مقيما فسدت صلا القوم وعليهم الاعادة لان الاقامة في المصر اصل فيبني الحكم علي ذلك فكذلك ههنا وقيل القول قول المدعي مع يمينه علي علمه وقال بعضهم القول قول المدعي عليه انه مسافر لانه ينكر اعطاء الكفيل * وقال بعضهم يتعرف القاضي من رفقاءه فان كان مقيما وامتنع عن اعطاء الكفيل امر المدعي بالملازمة وله ان يلازمه بنفسه واعوانه واجراءه يطوف معه اينما طاف ولا يمنعه من التصرف وقيل يجلسه المدعي في بيته فيكفيه مءنته من الطعام والشراب فان لم سكفه مءنته تركه ليقضي حاجته وان كان الخصم امراة اجنبية لا يخلو بها ولا باس بان يطوف معها في السكك فاذا دخلت دارا ارسل امراة ثقة معها كيلا تغيب* واذا ادعي رجل انه وصي فلان الميت وادعي دينا للميت علي رجل وجحد الخصم الوصاية والدين فان القاضي لا ياخذ من المدعي عليه كفيلا حتي يثبت الوصاية وكذا لو ادعي انه وكيل فلان الغاءب او وارث فلان الميت وجحد الخصم الوراثة والوكالة والموت فاقام المدعي بينة علي ذلك ثم ان المدعي احضر رجلا اخر قبل تزكية الشهود وادعي علي الثاني حقا للميت فان القاضي لا يكفل الثاني حتي تظهر عدالة بينة الوكالة والوصاية فان شهدوا علي الامرين جميعا معا علي الوصاية والدين او الوكالة والدين فالقياس ان لا تقبل البينة علي الدين حتي يقضي بالوصاية والوكالة لتثبت خصومته اولا ثم تسمع البينة علي الحق بعد ذلك وهو قول ابي حنيفة رحمه الله تعالي وفي الاستحسان تقبل فاذا ظهرت عدالة الشهود يقضي بها لكن يقدم القضاء بالوصاية والوكالة والوراثة علي القضاء بالدين وان عدلت بينة الوصاية والوكالة خاصة يقضي بها وان عدلت بينة الدين خاصة لا يقضي به * ولو ادعي رجل علي رجل انه وصي فلا ن الميت وان لي علي الميت هذا كذا تسمع دعواه وكذا لو ادعي الوكالة من غاءب اذا عرف الميت او الغاءب باسمه واسم ابيه وجده ولقبه ان كان لا تحصل المعرفة الا باللقب واذا سمع دعواه وطلب تكفيله فان القاضي لا يكفله لانه لم يثبت خصومته معه فان اقر المدعي عليه بالوصاية وانكر ان يكون في يده شء من المال لم يكن عليه شء * وان طلب المعي من القاضي تكفيله حتي يقيم البينة علي المدعي به ياخذ منه كفيلا * وان كانت هذه الخصومة مع الوارث والوارث ينكر النسب والارث والموت جميعا فاراد ان ياخذ منه كفيلا ليحضر البينة لاثبات النسب والموت والارث فان القاضي يكفله * ولو ان رجلين لهما علي رجل الف درهم هما شريكان فيه والمديون يجحد الدين فحضر احدهما فاقام البينة علي دينهما والشريك الاخر غاءب ذكر في المنتقي ان علي قول ابي حنيفة رحمه [] الله تعالي يقضي للحاضر بخمسماءة واذا حضر الغاءب كلف اعادة البينة ولا يجعل الحاضر خصما عن الغاءب في وجه من الوجوه الا ان يكون الالف ميراثا بينهما من شخص واحد فان حضر الغاءب ولم يقدر علي اعادة البينة دخل مع شريكه في الخمسماءة التي قبض الشريك * وقال ابو يوسف رحمه الله تعالي اي الشريكين حضر فهو خصم عن الاخر في الميراث وغيره وقال محمد رحمه الله تعالي القياس ما قال ابو حنيفة رحمه الله تعالي والاستحسان ما قاله ابو يوسف رحمه الله تعالي * اذا ادعي رجل علي رجل دينا ولم يبين السبب فشهد الشهود بالسبب جازت شهلادتهم وان ادعي دينا بسبب فشهد الشهود بالدين المطلق قيل لا تقبل شهادتهم كما لو ادعي ملكا بسبب فشهد الشهود بالملك المطلق والصحيح انها تقبل * ذكر في كفالة الاصل رجل ادعي علي رجل الفا وقال خمسماءة منها ثمن متاع قد قبضه جازت شهادتهما فيقضي للمدعي بالف وان لم يكن علي كل خمسماءة الا شهادة شاهد واحد وبشهادة الفرد لا يثبت السبب وكذا لو شهد احدهما بالالف بذلك السبب وشهد الاخر بالالف مطلقا وكذا لو شهدا علي اقراره بالف مطلق او شهد احدهما علي اقراره بالف بذلك السبب وشهد الاخر علي اقراره بالف مطلق جازت شهادتهما * ولو ادعي  الفا فشهد احد الشاهدين بالف قرض واخر بالف ثمن متاع لا تقبل لانه لا يمكنه تصديق الشاهدين اذا صدق احدهما فقد كذب الاخر * ولو ادعي علي رجل ماءة وخمسين درهما وشهدا علي اقراره بماءة وخمسة واربعين درهما جازت شهادتهما* ولو ادعي الفا فشهد احد الشاهدين بالف وشهد الاخر علي اقرار المدعي عليه بالف جازت شهادتهما* ولو ادعي الفا فقال المدعي عليه ما كان لك علي شء قط فاقام المدعي بينة علي المال ثم اقام المدعي عليه بينة علي القضاء او الابراء قبلت وكذا لو ادعي الفا فقال امدعي عليه ليس لك علي شء فاقام المدعي بينة علي المال ثم اقام المعي عليه بينة علي القضاء او الابراء قبلت* وان ادعي الفا فقال المدعي عليه ما كان لك علي شء قط ولا اعرفك فاقام امدعي البينة علي المال ثم اقام المدعي عليه البينة علي القضاء او الابراء ذكر في الجامع الصغير انها تقبل وذكر القدوري عن اصحابنا انها لا تقبل * رجل ادعي علي رجل مالا فانكر المدعي عليه فاخرج المدعي خطايا قرار المدعي عليه بذلك المال وقال هذا خط المدعي عليه فانكر المدعي عليه ان يكون خطه فاستكتب فكتب وكان بين الخطين مشابهة ظاهرة اختلفوا فيه قال بعضهم يقصي القاضي علي المدعي عليه يذلك المال وقال بعضهم لا يقضي وهو الصحيح * ولو قال المدعي عليه هذا خطي لكن ليس علي هذا المال ان كان الخط علي وجه الرسالة ولكن كان علي وجه يكتب الصك والاقرار فان اشهد علي نفسه بما فيه يكون اقرارا يلزمه* وان كتب الخط بين يدي الشهود وقرا عليهم كان عقرارا وحل لهم ان يشهدوا عليه سواء قال اشهدوا علي او لم يقل* وان كتب بين يدي الشهود ولم يقرا عليهم ولكن قال لهم اشهدوا علي بما فيه ان علموا بما فيه كان اقرارا حل لهم ان يشهدوا عليه بما فيه وان لم يعلموا لا يحل لهم ان يشهدوا عليه بما فيه * رجل ادعي دينا علي ميت بحضرة احد الورثة فاقر هذا الوارث صح اقراره ويلزم[ ] جميع ذلك في حصته من الميراث وقال شمس الاءمة الحلواني رحمه الله تعالي هذا اذا قضي القاضي علي هذا الوارث باقراره اما بمجرد اقراره لا يلزمه الدين في نصيبه بدليل انه لو اقر بالدين ثم شهد هو مع اخر بذلك الدين علي الميت جازت شهادته ولو كان الدين واجبا في نصيبه قبل القضاء لكان لا تقبل شهادته لانه يكون محولا للديه عن خصته خاصة الي جميع التركة فلا تقبل كما لو شهد بذلك بعد ما قضي القاضي باقراره* رجل ادعي علي ميت دينا فخصمه في ذلك وارث الميت او وصي الميت ولا تسمع دعواه علي غريم الميت الذي عليه دين ولا علي الذي له علي الميت دين ولا علي الموصي له * وذكر في المنتقي ان الموصي له بجميع المال عند عدم الوارث والوصي يكون خصما لمن يدعي دينا علي الميت* ولو ادعي رجل ان الميت اوصي اليه واحضر غريما للميت عليه دين تسمع دعواه كما تسمع دعوي الوكيل في حياة الموكل علي غريم الموكل * ولو ادعي رجل انه وصي فلان الميت لا تسمع دعواه الا علي خصم جاحد وخصمه وارث الميت او رجل عليه للميت دين او رجل اوصي له الميت بوصية لان للموصي له حقا في الميراث فكان بمنزلة الوارث*وان احضر رجلا له علي الميت دين اختلفوا فيه قال بعضهم لا يكون هذا الرجل خصما لمن ثدعي انه وصي الميت لان الوصي لا يدعي قبله حقا ومنهم من قال يكون خصما وهو الصحيح * رجل قال لرجل لي عليك الف درهم فقال المدعي عليه ان حلفت انها لك علي اديتها اليك فحلف فاداها اليه هل له ان يستردها منه بعد ذلك ذكر في المنتقي انه ان دفعها اليه علي الشرط الذي شرط كان له اتن يستردها منه *ولصاحب الدين ان يلازم المديون بعج وجوب الدين وان لنم يامره القاضي بالملازمة اذا لم يكن القاضي فله فان قال الغريم احبسني وصاحب الدين يريد الملازمة كان له ان يلازمه وان طلب صاحب الدين من القاضي ان يامر واحدا من اعوانه حتي يلازمه لاستخراج المال ففعل القاضي ذلك اختلفوا في جعل من يلازمه فال بعضهم يكون علي صاحب المال وقال القاضي الامام صدر الاسلام يكون علي المديون لانه انما احتاج الي الملازمة لمطله فيكون عليه كالسارق اذا قطعت يده كان ثمن الدهن الذي تحسم به العروق واجر الجلاد علي السارق * رجل ادعي دينا علي الميت بحضرة وارثه او وصيه ذكر في الجامع في الوصايا انه لا تسمع دعواه لان الولارث لا يكون خصما لمن يدعي دينا عليالميت اذا لم يترك الميت شيا * رجل ادعي دينا علي الميت بحضرة وارثه وقال ان الميت قد خلف من التركة من جنس هذا الدين في يد هذا الوارث من به وفاء بالدين واقام البينة علي ذلك لا شك ان هذا القدر يكفي لامر الوارث باحضار هذا المال حتي تشهد الشهود بحضرة المال ان هذا المال مال الميت ولو اكتفي بهذا القدر للقضاء علي الوارث بالمال كان جاءزا وله وجه لان القضاء بملك الدراهم والدنانير ممكن حال غيبتهما فان محمدا رحمه الله تعالي ذكر في بالاباق ان القاضي اذا باع الابق وقبض الثمن ان مولي الابق رفع الامر الي قاضي بلده ليكتب  كتابا حكميا الي القاضي الذي باع الابق وقبض الثمن واقام البينة علي ذلك فان القاضي يجيبه ويقبل بينته وان كان في هذا استحقاق الدراهم التي هي امانة عند القاضي المكتوب اليه حال غيبتها وهذه المسالة نص في مسالة اخري ان الكتاب الحكمي في المنقول جاءز رقيقا كان او لم يكن * رجل ادعي علي غاءب دينا بحضرة رجل يدعي انه وكيل الغاءب في الخصومة فاقر المدعي عليه بالوكالة لم يصح اقراره حتي لو اقام المدعي بينة بالدين علي الغاءب لم تقبل بينته وكذا لو ادعي دينا علي ميت بحضرة رجل يدعي انه وصي الميت فاقر المدعي عليه بالوصاية * رجل يدعي علي رجل فوكل المدعي عليه رجلين [] بالخصومة فاقام المدعي شاهدا علي احد الوكيلين وشاهدا علي الوكيل الاخر جاز وكذا لو اقام شاهدا علي الموكل وشاهدا علي الوكيل او اقام علي المدعي عليه شاهدا وعلي وصية او وارثه بعد موته شاهدا * ولو كان للميت وصيان فاقام المدعي علي احدهما شاهدا وعلي الاخر شاهدا جاز ذكره في المنتقي* ولو قامت البينة علي رجل بحق ثم مات المدعي عليه قبل ان يقضي عليه او غاب او قامت البينة علي الوكيل بالخصومة فمات الوكيل قبل القضاء او غاب ثم عدلت تلك البينة لا يقضي بتلك البينة في قول ابي حنيفة ومحمد رحمهما الله تعالي ويقضي في قول اي يوسف رحمه الله تعالي واختار الخصاف رحمه الله تعالي قول ابي يوسف رحمه الله تعالي * رجل مات في بلدة وله ورثة في بلدة اخري فجاء رجل وادعي علي الميت دينا فاراد ان يثبت دينه علي الميت وطلب من القاضي ان ينصب وصيا للميت حتي يقيم عليه البينة ان كان الوارث غاءبا غيبة منقطعة نصب القاضي وصيا فاذا اقام المدعي عليه بينة قضي القاضي له بدينه وان لم تكن الغيبة منقطعة لا بنصب القاضي وصيا * ولو كانت الورثة كبارا غيبا وله وارث صغير في المصر فان القاضي يجعل للصغير وكيلا يقيم المدعي البينة علي الوكيل ويقضي له بدينه ويكون ذلك قضاء علي جميع الورثة كما لو كان هذا الصغير كبيرا فقضي القاضي عليه كان قضاء علي جميع الورثة* ولو كان الورث الحاضر كبيرا فاقر الوارث بالدين علي مورثه فاراد الطالب ان يقيم البينة عليه مع اقراره ليكون حقه في جميع التركة فان القاضي يقبل بينته علي المقر ويقضي ويكون ذلك قضاء علي الكل وكذا لو ادعي علي وصي الميت فاقر الوصي بالتدين فاراد المدعي ان يقيم البينة عليه بالدين كان له ذلك وقبلت بينته وكذا لو اقام البينة علي الوكيل بالخصومة بعد الاقرار * رجل ادعي علي رجل ماءة درهم فقال المدعي عليه قد قضيتك ماءة بعد ماءة فلا حق لك علي لم يكن ذلك اقرارا وكذا لو ادعي عليه الف درهم فقال قضيتك خمسين درهما لم يكن ذلك اقرارا وكذا لو قال المدعي لي عليك الف درهم فقال المدعي عليه لي عليك الف درهم لم يكن اقرارا * ولو قال المدعي عليه ولي عليك الف درهم او قال ولي عليك مثلها او قال ولي عليك ايضا الف درهم فيه روايتان في رواية يكون اقرارا وفي اخري لا يكون اقرارا * رجل ادعي دينا علي رجل فاقام البينة عليه بعد الجحود فقال القاضي ثبت عندي ان لهذا الرجل علي هذا الرجل كذا اختلف المشايخ فيه قال بعضهم لا يكون هذا حكما من القاضي وقال شمس الاءمة الحلواني والقاضي ابو عاصم رحمه الله تعالي يكون حكما وعليه الفتوي* وذكر في كتاب الرجوع ولو قال القاضي بعد ما شهد الشهود بحق او دار لرجل وعدلوا اري ان الحق للمشهود له لم يكن ذلك قضاء حتي يقول انفذت عليك القضاء في كذا وكذا لان قوله اري بمنزلة قوله اظن ولو قال اظن لم يكن ذلك قضاء * اذا قال القاضي لرجل جعلتك وكيلا في تركة فلان الميت كان وكيلا في الحفظ خاصة الا ان يقول له تشتري وتبيع * ولو قال جعلتك وصيا كان وصيا * واذا تقدم الغرماء والورثة الي القاضي وزعموا ان فلانا مات ولم يوص الي احد والقاضي لا يعلم به فقال ان كنتم صادقين فقد جعلت هذا وصيا قالوا يرجي ان يكون القاضي في سعة من ذلك فان كانوا صادقين كان وصيا * رجل جاء الي القاضي فقال فد مات ابي في بعض الاطراف وعليه ديون وترك عروضا ورقيقا ودواب ولم يوص الي احد وانا لا استطيع ان اثبت ذلك بالبينة لان اهل تلك الناحية لا يعرفونني قالوا لا باس للقاضي ان يقول له ان كنت صادقا فيما تقول فبع الحيوان واقض الديون فان كان صادقا [] صح امر القاضي والا فلا * واذا اوصي الرجل الي رجل فقال في وجهه لا اقبل بطل الايصاء حتي لو بل بعد ذلك في حياته او بعد وفاته لا يصح * ولو قبل في وجهه ثمرد لم يصح رده ما لم يعلم الموصي وقي والوكللة سواء بخلاف ما لو اوصي للانسان بوصية فرد في وجهه في حياته ثم قبل بعد وفاته او قبل في حياته ثم رد بعد وفاته فانه يصح رده وقبوله والمسالة معروفة * واذا توجه الحبس علي المديون فان القاضي لا يسال المديون الك مال ولا يسال المدعي اله مال في ظاهر الرواية فان سال المديون من القاضي ان يسال صاحب الدين اله مال ساله القاضي بالاجماع فان قال الطالب هو  معسر لا يحبسه لانه لو اقر بعسرته بعد الحبس اخرجه فقبل الحبس لا يحبسه فان قال الطالب هو موسر قادر علي القضاء وقال المديون انا بعسر تكلموا فيه قال بعضهم القول قول المديون انه معسر وقال بعضهم ان كان الدين واجبا بدلا عما هو مال كالقرض وثمن المبيع القول قول مدعي اليسار مروي ذلك عن ابي حنيفة رحمه الله تعالي وعليه الفتوي لان قدرته كانت ثابتة بالمبدل ولا يقبل قوله في زوال تلك القدرة وان لم يكن الدين بدلا عما هو مال كان القول فيه قول المديون والذي يءيد هذا القول مسالتان * (احداهما ) احد الشريكين اذا اعتق العبد المشترك وادعي انه معسر كان القول فيه قوله لان الضمانة فيه وجب بدلا عما هو ليس بمال والاصل في الادمي هو العسرة * (والثانية) ان المراة اذا طلبت نفقة الموسرين والزوج يدعي العسرة كان القول قول الزوج * وقال بعضهم كل مال وجب بعقدة لا يقبل قول المديون انه معسر وان لم يكن ذلك بدلا عما هو مال * الديون اذا اقام البينة علي الافلاس قبل الحبس فيه روايتان قال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي الصحيح انها تقبل وقال المصنف رحمه الله تعالي وينبغي ان يكون ذلك مفوضا الي القاضي انه وقح لا يقبل بينته قبل الحبس وان علم القاضي انه لين قبل بينته ولو اقام المديون بينته علي العسار وصاحب الدين علي اليسار كانت بينته اليسار اولي فان شهدوا انه موسر قادر علي قضاء الدين جاز ذلك وكفي ولا يشترط تعيين المال * ان اقام المديون البينة علي العسار بعد الحبس في الروايات الظاهرة لا تقبل البينة الا بعد مضي المدة واختلفت الروايات في تلك المدة وروي محمد عن ابي حنيفة رحمهما الله تعالي انه مقدر بشهرين او ثلاثة وروي الحسن عن ابي حنيفة رحمهما الله تعالي انها من اربعة اشهر الي ستة اشهر وعن ابي جعفر الطحاوي رحمه الله تعالي انها مقدرة بشهر وقال شمس الاءمة الحلواني رحمه الله تعالي وهذا ارفق الاقاويل وقال بعضهم ان كان المحبوس رجلا لينا صاحب عيال يشكو عياله الي القاضي ان وقع عند القاضي بعد مضي ستة اشهر انه متمرد يديم الحبس وان وقع عنده قبل تمام شهر واحد انه عاجز اطلقه وهذا اذا كان امره مشكلا اما اذا كان امره ظاهرا يسال القاضي عنه عاجلا ويقبل البينة علي الافلاس ويخلي سبيله بحضرة خصمه وانما يسال عن عسرته من جيرانه واصدقاءه واهل سوقه من الثقات دون الفساق فاذا قالوا لا تعرف له مالا كفي ذلك ولا يشترط في هذا لفظة الشهادة وبعد ما خلي سبيله هل لصاحب الدين ان يلازمه اختلفوا فيه والصحيح ان له ان يلازمه للحديث المشهور لصاحب الحق يد ولسان قالوا المراد من اليد الملازمة* قال الشسخ الامام شمس الاءمة الحلواني رحمه الله تعالي احسن الاقاويل في الملازمة ما روي عن محمد رحمه الله[] تعالي قال يلازمه في فناءه ولا يمنعه من الدخول الي اهله ولا من الغداء والعشاء ولا من الوضوء والخلاء فان اراد الطالب ان يمنعه عن ذلك فانه يكفيه مءنة الغداء والعشاء وما يحتاج اليه مما لا بد منه وله ان يلازمه بنفسه واجراءه وولده ممن احب فان قال المديون لا اجلس مع غلامك واجلس معك قلا بعضهم كان له ذلك وقيل هذا اقول ابي حنيفة رحمه الله تعالي اما علي قولهما ليس للمديون ذلك وجعلوا هذه المسالة فرعا لمسالة التوكيل بالخصومة من غير رضا الخصم علي قول ابي حنيفة رحمه الله تعالي لا يصح توكيله فكذلك في الملازمة والصحيح ان في الملازمة الراي فيه الي صاحب الدين لا الي المديون ان شاء لازنه بنفسه وانشاء بغيره لان المقصود حصول الدين وملازمة الغير عسي ان تكون اقرب الي ذلك * اذا كان للمحبوس مال فان القاضي لا يبيع ماله في الدين عند ابي حنيفة رحمه الله تعالي وعند صاحبيه رحمهما الله تعالي يبيع * وقال الشيخ الامام شمس الاءمة الالحلوني رحمه الله تعالي ان كان ماله من جنس الدين كالدراهم والدنانير والمكيل والموزون من جنس الدين اخذ القاضي ماله وقضي دينه وان كان الدين دراهم والمال دنانير او علي العكس القياس ان لا يبيع في قول ابي حنيفة رحمه الله تعالي كما في ساءر الاموال وفي الاستحسان يبيع ويقضي دينه لانهما جنس واحد حكما كالصحاح مع المكسرة*ولا يبيع العروض عند ابي حنيفة رحمه الله تعالي وفي العقار عنهما روايتان * الحر والعبد والبالغ والصبي والماذون في الحبس سواء وكذا الاقارب والاجانب الا الوالدين والاجداد والجدات فانهم لا يحبسون في ديون فروعهم ال في النفقة وغيرهم يحبسون بعضهم بدين بعض والمكاتب يحبس مولاه فيما كان من جنس الكتابة * والمولي لا يحبس المكاتب في الدين الكتابة وغيرها وفي رواية ابن سماعة رحمه الله تعالي يحبسه في غير مال الكتابة والصحيح هو الاول * رجل وكل رجلا بالخصومة وبقبض كل حق له علي الناس وكذا وكذا وكتب في ذكر الوكالة وكيلا مخاصما مخاصما فادعي قوم قبل الموكل مالا حال غيبت فاقر الوكيل عند القاضي انه وكيله فاقام اصحاب الديون البينة  بديونهم علي الموكل وطلبوا حبس الوكيل فانه لا يحبس لان الحبس جزاء الظلم والوكيل بالخصومة اذا لم يكن كفيلا بالمال ولا مامورا بقضاء الدين من مال في يده لا يجب عليه المال فلا يكون ظالما * اذا اراد المحبوس ان يحترف اختلفوا فيه قال شمس الاءمة السرخسي رحمه الله تعالي الصحيح انه يمنع وقال غيره لا يمنع لان نفقته ومفقة عياله عسي تكون في ذلك ويمنع من الحمام ويتنور في السجن ولا يمنع من دخول الزوار عليه ولا من اللبس والطيب والطعام والبيع والشراء * ولو احتاج الي الجماع لا باس بان تدخل عليه زوجته او جاريته فيطءها في موضع لا يطلع عليه غيره وعن ابي يوسف عن ابي حنيفة رحمهما الله تعالي انه يمنع من الوطء الحراءر والماء لان المنع عن ذلك لا يفضي الي الهلاك عسي يكون ذلك سببا لزيادة ضجر يحمله علي قضاء الدين ولا يخرجه لجمعة ولا عيد ولا لجنازة قريب وقيل بانه يخرج بكفيل لجنازة الوالدين والاجداد والجدات والاولاد وفي غيرهم لا يخرج وعليه الفتوي وعن محمد رحمه الله تعالي اذا مات ولده او والده لا يخرج الا ان لا يوجد من يغسله ويدفنه * واذا عجز المحبوس عن نفقة المراة ليس لها ان تطالبه بالنفقة ولكنها تستدين علي الزوج بامر القاضي * ولو كان للمحبوس ديون علي الناس فان القاضي يخرجه من السجن حتي يخاصم ثم يحبسه * فاذا مرض في السجن واضناه المرض فان لم يكن هناك من يمرضه اخرجه القاضي من السجن بكفيل * واذا علم القاضي ان المحبوس يحتال [] للخروج والهرب بنفسه وبالرجوع الي الظلمة ليخرجوه ادبه القاضي بالسياط * وان خلف القاضي عليه ان يفر من حبسه حوله القاضي الي سجن اللصوص اذا كان لا يخاف عليه من اللصوص فان خاف عليه بان كان بينه وبين اللصوص عداوة لا يحوله * واذا سال القاضي عن المحبوس بعد مدة فاخبر انه مفلس وصاحب الدين غاءب فان القاضي ياخذ منه كفيلا بنفسه ويخرجه عن الحبس * ولو قال المحبوس نقدت المال وصاحب المال غاءب يريد تطويل الحبس عليه فان كان القاضي يعلم انه حبس بدين فلان لا غير ويعلم مقدار الدين الذي حبس به بان كان القاضي حين حبسه كتب انه حبس بدين فلان بكذا كان القاضي بالخيار ان شاء اخذ المال منه وخلي سبيله كيلا يتهمه الناس وقال بعضهم يتركه في الحبس حتي يقضي الدين * رجل ادعي علي رجل الفا وشهد شاهدان انه كان لهذا المدعي علي هذا المدعي عليه الف درهم ولكنه ابراه منها وقال المدعي ما ابراته منها فقال المشهود عليه ما كان له علي شء ولا ابراني عن شء ذكر في المنتقي ان المدعي عليه اذا لم اذا يدع شهادتهما علي البراءة يقضي عليه بالف درهم * رجل ادعي علي رجل خمسة دنانير فقال المدعي عليه اوفيتكها وجاء بشهود فشهد شهوده ان هذا المدعي عليه دفع الي هذا المدعي خمسة دنانير الا انا لا ندري من اي مال دفعها اليه من هذا الدين او من دين اخر جازت شهادتهما وبرء المدعي عليه * رجل باع من رجلين متاعا بالف درهم وكل واحد منهما كفيل عن صاحبه ولقي الباءع احدهما واقام البينة ان له علي هذا وعلي فلان بن فلان الغاءب الف درهم وكل وحج منهما كفيل عن صاحبه بامره فانه يقضي له علي الحاضر بالف درهم واذا حضر الغاءب لم يكن للمدعي ان ياخذه الا بخمسماءة وهي الاصيلة لان القضاء علي الكفيل بالف قضاء علي الاصيل اما القضاء علي الاصيل لا يكون قضاء علي الكفيل وفي مسالتنا القضاء علي الاول في النصف الذي كان قضاء علي الغاءب اما القضاء عليه فيما كان اصيلا لا يكون قضاء علي الغاءب * ولو ادعي علي رجل انه كفل له وفلان بن فلان الغاءب عن فلان بن فلان بالف درهم وكل واحد منهما كفيل عن صاحبه فقضي له علي الحاضر بالف درهم ثم حضر الغاءب كان له ان ياخذ بجميع الالف لانه حين قضي علي الحاضر بالف درهم قضي بها عليه بجهة الكفالة عن كل واحد منهما علي الكفيل والمطلوب فكان كل الالف عليه بجهة الكفالة * رجل ادعي علي رجل الف درهم فجحد المدعي عليه واقام المدعي شاهدين شهد احدهما ان المدعي عليه اقر ان لهذا المدعي عليه الف درهم لانهما اجمعا علي اقراره انه وصل اليه الف درهم من قبل امدعي وقد جحد الوديعة فكان ضامنا * رجل ادعي علي رجل انه اخذ منه الفا ووصف الالف فاقام المدعي عليه البينة ان امدعي اقر ان هذا المال المفسر المسمي اخذ منه فلان اخر وانكر المدعي الاول اقراره قال محمد رحمه الله تعالي لا تبطل بهذا الدعوي المدعي الاول ولا تبطل بينته لان الوقت غير مذكور في الشهادتين فيجعل كان فلانا اخذا اولا ثم ردها علي المدعي ثم اخذها منه المدعي عليه* ولو ادعي المدعي اولا ان هذا اخذ منه الفا واقام البينة ثم ان المدعي عليه اقام البينة ان هذا المدعي اقر ان فلان بن فلان وكيل المدعي عليه اخذ منه هذا المال كان ذلك ابطالا لدعوي المدعي الاول وتكذيبا لبينته لانه لما اقر بقبض الوكيل ثم ادعي الاخذ علي الموكل كان هذا الاخذ الذي يدعي [] عين الاخذ الذي ادعاه علي وكيله لان اخذ  الوكيل يضاف الي الموكل فيجعل كذلك كيلا يلزمنا اثبات اخذ اخر مع امكان حمل الثاني علي الاول فيكون دعواه الاخذ علي الوكيل ابراء المدعي عليه عن دعوي الاخذ بطريق الاصالة اما في المسالة الاولي اذا لم يكن اح\هما وكيلا عن الاخر في الاخذ كان الثابت بكل شهادة احذا اخر وعند القضاء بلاخذين كان له ان يطالب المدعي عليه * رجل ادعي دينا لابيه الميت علي رجل فشهدا الشهود انه كان لابي المدعي علي المدعي عليه كذا جازت الشهادة كما لو شهدوا في دار علي اقرار المدعي عليه انها كانت لابي المدعي * رجل ادعي علي رجل عند القاضي واحرج صكا وقال ان الدين الذي في هذا الضك علي المدعي عليه باسم فلان الغاءب المذكور في هذا الصك وان اسم الغاءب فيه عارية وان الغاءب المذكور في هذا الصك قد وكلني بقبض هذا الدين من المدعي عليه هذا فان القاضي يسمع دعواه لان الانسان قد يكون وكيلا عن الغير في بيع ماله فيكون الثمن للموكل والعاقد يكتب الصك باسم نفسه الا انه ينبغي ان يقول وان فلانا الغاءب وكلني بالقبض لان الظاهر ان الدين انما يكتب باسم رجل اذا كان حق القبض له فاذا سمع دعواه يقبل بينته ويقضي بالمال وان اقر المدعي عليه بالمال والوكالة امر بتسليم المال الي المدعي ولا ينفذ اقراره علي الغاءب وان اقر المدعي عليه بالمال وانكر الوكالة يقال له اثبت الوكالة بالبينة ولو اقام البينة علي اقرار الغاءب ان المال للمدعي هذا ولم يقم البينة علي الوكالة لا تقبل بينته.
 *(فصل في الدعوي تخالف الشهادة وما يصير به متناقضا وما لا يصير)*

 رجل ادعي علي رجل الفا وخمسماءة فشهد الشهود بالف جازت الشهادة من غير توفيق وكذا لو ادعي الفا فشهدوا بخمسماءة * ولو ادعي الفا فشهد احدهما بالف والاخر بخمسماءة لا بقضي بشء في قول ابي حنيفة رحمه الله تعالي وكذا لو ادعي خمسة عشر فشهد احدهما بخمسة عشر والاخر بعشرة * ولو ادعي الفا وخمسماءة فشهد احدهما بالف والاخر بالف وخمسماءة جازت شهادتهما علي الالف * وان ادعي الفا فشهدوا بالف وخمسماءة او بالفي درهم لا تقبل من غير توفيق لانه كذب الشهود الا اني ابراته واستوفيت خمسماءة وام يعلم به الشهود فاذا رفق علي هذا الوجه قبلت لان ما اتي به من التوفيق تحتمله الدعوي والشهادة فيقبل ولا يحتاج الي اقامة البينة علي التوفيق وقال بعضهم تشترط الشهادة علي التوفيق والصحيح هو الاول وانما يحتاج الي اثبات التوفيق بالبينة اذا كان التوفيق لا يتم ولا ينفرد باثباته كما لو ادعي الملك بالشراء فشهد الشهود بالملك بالهبة * اما الابراء فيتم به وكذا الستيفاء فانه اذا ظفر بجنس حقه كان له ان ياخذ فلا يحتاج الي اثبات التوفيق بالبينة والقياس انه اذا احتمل التوفيق يوفق وان لم يدع التوفيق ويحمل الشهادة علي الصحة وذكر محمد رحمه الله تعالي في كثير من المواضع واثبت التوفيق وان لم يدع حملا للشهادة علي الصحة * منها اذا ادعي دينا فانكر المدعي عليه وقال ما كان لك علي شء فلما اقام المدعي البينة علي الدين اقام المدعي عليه البينة علي الايفاء او الابراء قال تقبل وذكر الشيخ الامام المعروف بخواهر زاده رحمه الله تعالي في الشهادات ان محمدا رحمه الله تعالي شرط في بعض المواضع دعوي التوفيق ولم يشترط في البعض فذلك محمول علي ما اذا ادعي [] التوفيق فانه لا بد من دعوي التوفيق وكذا لو ادعي الفا فشهد الشاهدان بالالف الا ان احدهما شهد انه قضي الطلب منها خمسماءة وانكر الطالب القضاء قبلت شهادتهما علي الالف وعن ابي يوسف رحمه الله تعالي انه لا تقبل شهادة من شهد بقضاء خمسماءة وبه اخذ الطحاوي رحمه الله تعالي * ولو ادعي الفا فشهد الشهود بالالف والقضاء فقال المدعي ما قضاني شيءا او قال صدقا في الشهادة علي الدين واوهما في القضاء ان عدلا جازت شهادتهما علي الالف وان قال المدعي شهدا بالدين بحخق والقضاء بباطل او بزور لا تجوز شهادتهما وكذا لو شهدا للمدعي بالف وشهدا ان للمدعي عليه علي المدعي ماءة دينار والمدعي ينكر الدنانير ان قال المدعي شهدا بالالف بحق واوهما في الدنانير جازت شهادتهما * ولو ادعي الفا فشهد الشهود انه كان لهذا المدعي علي المدعي عليه الف ولكنه ابرامنها وقال المدعي ما ابراته منها فقال المشهود عليه ما كان له علي شء ولا ابراني عن شء قالوا اذا لم يدع البراءة يقصي عليه بالالف * ولو ادعي الفا فشهد احدهما ان له عليه الف درهم وشهد الاخر علي اقراره بالالف ذكر في غصب الاصل وفي الجامع انها لا تقبل لان احدهما شهد بالقول والاخر بالفعل فلم يتفقا علي شء وقال ابو يوسف رحمه الله تعالي تقبل * ولو اتفق الشاهدان علي انه اقر بالف واختلفا في المكان او في الزمان جازت شهادتهما لان القول مما يعاد ويكرر* ولو ادعي دارا في يد رجل انها له منذ سنة فشهد الشهود انها له منذ عشرين سنة ذكر الناطفي رحمه الله تعالي انها لا بقبل * ولو ادعي انها له منذ سنة جازت شهادتهما لانه كذب الشهود في الصورة الاولي دون الثانية* ولو ادعي ثوبا في يد رجل انه له واقام شاهدين فشهد احدهما علي اقرار ذي اليد ان المدعي اودعه اياه وشهد الاخر علي اقراره انه اغتصبه من المدعي فقال المدعي قد اقر بما قالا ولكنه اغتصبه مني جازت شهادتهما ويجعل الذي في يده الثوب مقرا بملكه للمدعي حتي لو ادعاه بعد ذلك لا تقبل * ولو شهد احد شاهدي المدعي علي اقرار ذي اليد انه اغتصبه من المدعي وشهد الاخر علي اقراره انه اخذه من المدعي فانه يقضي به للمدي ويكون لمدعي عليه علي حجته لان الاقرار بالاخذ لا يكون اقرارا بالملك للماخوذ منه فان الانسان قد ياخذ ماله من الغير ولا يغتصب ماله من غيره * ولو شهد احد شاهدي المدعي علي اقرار المدعي عليه ان المدعي اودعه اياه وشهد الاخر علي اقراره انه اخذ من المدعي فقال المدعي قد اقر بما قالا ولكني اودعته اياه لا تقبل هذه الشهادة لانهما لم بجتمعا علي اقراره بملكه ولا علي اقراره بالاخذ لان الذي شهد علي قراره بالوديعة لم يشهد علي قراره بالاخذ من المدعي * رجل ادعي عينا في يد انسان واقام البينة انها له ثم ان المدعي عليه اقام البينة ان الشهود قد ادعو هذه بالعين جازت شهادتهم وبطلت بينة المدعي * رجلان شهدا ان فلنا قد مات وهذه كانت امراته وشهد اخران انه كان طلقها قبل الموت قال الشيخ المام ابو بكر محمد بن الفضل رحمه الله تعالي شهود الزوجية اولي وقال القاضي الامام علي السغدي رحمه الله تعالي شهود الطلاق اولي لان الطلق يكون بعد النكاح ثم قال القاضي الامام وما قاله  الشيخ الامام فله وجه يجعل كانه طلق ثم تزوج * اذا ادعي اربعة دارا في يد رجل ان هذه الدار كانت لابيهم فلان مات وتركها ميراثا لهم وهم بنوه لا وارث لا وارث له سواهم واقاموا البينة علي الوجه ثم ظهر ان واحدا منهم ما كان ابن للميت وانما كان ابمال لبينته تصادقوا علي ذلك ذكر في المنتقي انه تبطل بينتهم ودعواهم فلو ان البنين الثلاثة بعد ذلك اقاموا شهودا اخرين غير [] الاولين وادعوا ان الدار كانت لابيهم مات وتركها ميراثا لهم وهم بنوه الثلاثة لا وارث له سواهم صح دعواهم وقبلت بينتهم* المدعي عليه الدين اذا ادعي البراءة عن الدين ان قال لي بينة حاضرة في المصر فانه يءجله القاضي الي المجلس الثاني ولو قال المدعي عليه بعد الانكار ان المدعي ابراني عن هذه الدعوي واراد استحلاف المدعي علي البراءة قال الشيخ الامام ابو بكر محمد بن الفضل رحمه الله تعالي يحلف المدعي عليه اولا علي الدين فان تكل حينءذ يحلف المدعي علي البراءة .
 (فصل في دعوي المنقول وفيه مساءل النتاج ودعوي الرجلين)  رجل خاصم رجلا في عين فهو علي وجهين اما ان كان العين هالكا او قاءما فالقاءم لا يخلو اما ان يكون حاضرا في المجلس او غاءبا * فان ادعي انه هالك فهذا ودعوي الدين سواء لانه بعد الهلاك يدعي الضمان وهو المثل في ذوات الامثال والقيمة في ذوات القيم فلا تصح هذه الدعوي الا بعد بيان القدر والجنس لان دعوي المجهول فاسدة فان المدعي لو قال ان هذا استهلك مالي او قال كان هذا شريكي خان في الربح ولا ادري قدره لا يلتفت اليه وكذا لو قال بلغني ان فلنلا الميت اوصي لي ولا ادري قدره او قال المديون قضيت بعض ديني ونسيت قدره او قال لا ادري قدره لا يلتفت اليه * وذكر الخصاف رحمه الله تعالي ان القاضي اذا اتهم وصي اليتم او قيم الوقت ولا يدعي عليه شيا معلوما فان علي قول اكثر المشايخ رحمهم الله تعالي يستحلفه القاضي نظرا للصغير والوقف فان كان العين الذي يدعيه المدعي قاءما حاضرا في المجلس لا بد ان يشير اليه باليد فيقول هذا العين لي ولا بد للشهود ايضا ان يشهدوا بالملك واشاروا بايديهم الي المدعي والعين المدعي به والاشارة بالراس لا تكفي الا اذا علم باشارتهم الاشارة الي العين المدعي به* ولو قالا مشهد ان هذا العين المدعي به وقالوا بالفارسية اين ان مدعي است لا يكتفي بذلك ما لم يصرحوا بالملك لان الشء كما ينسب الي الانسان بجهة الملك ينسب بالاجارة فلا بد من التصريح بالملك لقطع الاحتمال* وان كان العين غاءبا وادعي انه في يد المدعي عليه فانكر ان بين المدعي قيمته وصفته تسمع دعواه وتقبل بينته وان لم يبين القيمة فقال غصب مني عين كذا ولا ادري انه عابك ام قاءم ولا ادري كم كانت قيمته ذكر في عامة الروايات انه تسمع دعواه فانه ذكر في كتاب الرهن اذا ادعي رجل علي رجل انه رهن عنده ثوبا بكذا قال تسمع دعواه وذكر في الغصب اذا ادعي علي اخر انه غصب منه عبدا او ادعي انه غصب منه جاريه وغيبها واقام البينة علي ذلك تقبل بينته ويحبس حتي يجء بها ويردها علي صاحبها وان لم يبين قيمتها فان قال الغاصب بعد ذلك فاتت الجارية او بعتها ولا اقدر عليها قال يتلوم القاضي في ذلك زمانا ومقدار ذلك الزمان مفوض الي القاضي فان لم يقدر عليها قضي عليه بالقيمة والقول في مقدار القيمة قول الغاصب * وذكر في الوديعة رجل قال لغيره اودعتك عبدا وامة وقال المستودع ما اودعتني الا امة وقد هلكت فاقام رب الوديعة البينة علي ما ادعي يضمن المستودع قيمة العبد وقال ابو بكر البلخي لا تسمع الدعوي الا بعد بيان القيمة قال وما ذكر محمد رحمه الله تعالي في الكتاب محمول علي ما اذا ادعي اقرار المدعي عليه بذلك وعامة المشايخ قالوا تصح الدعوي من غير دعوي الاقرار لان محمدا رحمه الله تعالي لم يذكر الاقرار في شء من المواضع لكن ينبغي للقاضي ان يكلف المدعي ببيان القيمة جدا فان لم يبين يسمع دعواه ويقبل بينته ويامر المدعي عليه باحضار ذلك العين فان ابي حبسه شهرين فان احضر عينا من ذلك الجنس يقال للمدعي اهذا الذي ادعيته فان صدقه اخذه وان كذبه كلف المدعي عليه باحضار عين اخر الي ان يوافقه المدعي في ذلك فان عجز المدعي عليه وظهر عجزه يقضي[] عليه بالقيمة والقول في مقدار القيمة قول المدعي عليه * ولو ادعي عينا حاضرا في يد رجل انه له وانكر المدعي عليه فاقام المدعي بينة علي ما ادعي فسال المدعي من القاضي ان ياخذ منه كفيلا بنفسه الي ان تظهر عدالة الشهود في القياس لا يكلفه القاضي وفي الاستحسان يجبره علي اعطاء الكفيل واذا اعطاه كفيلا بنفسه ينبغي ان ياخذ منه وكيلا بالخصومة ايضا حتي لو غاب المدعي عليه يمكنه القضاء علي الوكيل وياخذ منه كفيلا بعين المدعي به لان القاضي لا يتمكن من القضاء لا بحضرة المدعي عليه وحضرة العين ويجوز ان يكون الكفيل والوكيل واحدا وامنا يفعل القاضي ذلك عند طلب الحصم فان ابي ان يعطي كفيلا بنفسه امر المدعي ان يلازمه اناء الليل واطراف النهار اما بنفسه وبغيره هذا اذا اقام المدعي البينة فاما اذا ادعي وام يقم البينة وطلب من القاضي تكفيله فهو علي وجهين ان قال بينتي غاءبة لا يكفله وان قال حضور في المصر في القياس لا يكفله وفي الاستحسان يكفله الي المجلس الثاني وكذا لو اقام المدعي شاهدا واحدا فانه ياخذا منه كفيلا بنفسه وبالعين المدعي به ووكيلا بالخصومة وكفيلا بنفس الوكيل فان اعطاه الوكيل دون الكفيل او الكفيل دون الوكيل لا يقبل القاضي ذلك منه الا ان يرضي به الخصم* ولو كان المدعي به نقليا فقال المدعي به لا ارضي بالكفيل بالنفس وبالكفيل بالعين وطلب من القاضي ان يضعه علي يدي عدل ان كان المدعي عليه عدلا لا يخشي عليه تغييب العين لا يجيبه القاضي الي ذلك وان كان فاسقا يخشي عليه يجيبه القاضي الي ذلك وان كان التدعي به عقارا وطلب من القاضي ان يضعه علي يدي عدل لا يجيبه القاضي الي ذلك الا ان يكون اشجارا عليها ثمار وان كان المدعي به دابة او جارية يحتاج الي النفقة وابي المدعي  لا يقدر علي الملازمة فطلب من القاضي ان يضعه علي يدي عدل فان القاضي يقول للمدعي ان شءت وضعته علي يدي عدل وتون النفقة عليك عدلت بينتك او لم اقض فان رضي المدعي بذلك وضعها علي يدي عدل وان لم يرض لا يضع ويلازم ان شاء * ولو طلب المدعي من القاضيالحيلولة بين المدعي به والمدعي عليه ان كان ذلك قبل اقامة البينة لا يجيبه القاضي الي ذلك* وكذا لو اقام شاهدا فاسقا او شاهدين فاسقين لان قول الفاسق لا يعتبر الا يري انه لو اخبر بنجاسة الماء وطهارته لا بعتبر قوله في ذلك في ظاهر الجواب وان اقام المدعي شاهدا عدلا او امراتين مستورتين فان كان ذلك من باب الفرج بان شهدا علي امة انها لهذا الرجل حيل بينها وبين المدعي عليه وتوضع عند عدل وكذا لو ادعت حرية او عتقا او شهدا بطلاق باءن اثلاث يحال بينها وبين الزوج وذلك بان يجعل القاضي بينهما امراة عدلة ولا تخرج عن منزل الزوج فان حيل بين الامة وبين المدعي عليه فلم يعدل البينة وقال المدعي لي بينة اخري حاضرة قالوا لا ترفع الحيلولة ولا تءخذ من العدل الي اخر المجلس وقيل يءجل اياما كما لو ادعي القاتل بينة علي العفو فانه يءجل اياما وراء المجلس استحسانا* ولو ادعي رجلا نكاح امراة وهي في يد غيره فاقام المدعي البينة فان سال المدعي الحيلولة او التعديل في مدة مسالته عن الشهود فعل القاضي ذلك والا فللا وكذا المراة اذا ادعت فساد النكاح واقامت البينة وسالت الحيلولة وكذا رجل ادعي امة في يد رجل وقال بعتها من الذي في يديه بيعا فاسدا وقال المدعي عليه اشتريتها منه شراء جاءزا فهو بمنزلة ما لو ادعت المراة فساد النكاح * وان كان الدعوي في غير المفرج واقام المدعي بينته فانه ياخذ كفيلا من المدعي عليه بنفسه وبالمدعي به ووكيلا بالخصومة ولا يحتاج الي التعديل والحيلولة الا ان يكون المدعي شيءا يخاف تغييبه واتلافه * ولو كانت []الجارية في يد رجلين يدعي كل واحد منهما انها له فان القاضي يدعها في ايديهما ويقول لكل واحد منهما اقم البينة فان اراد كل واحد منهما ان تكون الجارية عنده وتنازعا في ذلك امرهما القاضي ان يتفقا علي رجل تكون عنده الي ان تقوم لهما بينة قطعا للمنازعة فان اقام احدهما البينة علي دعواه ولم يقم الاخر وضعها القاضي عند رجل عدل الي ان يسال الشهود * ولو ادعي رجل نكاح امراة كبيرة ليست في يد رجل وهي تجحد دعواه فاقام البينة وطلب من القاضي ان يضعها علي يد عدل الي ان يسال عن الشهود فان القاضي لا يضعه ولكن ياخذ منها كفيلا وكذا لو ادعي نكاح بكر هي في بيت ابيها لا يعزلها * وان كان المدعي به منقولا عظيما لا يمكن نقله الا بمءنة وضرر نحو الخشب العظيم والحجر والرحي والصنم الكبير والمكيل والموزون اختلفوا فيه قال بعضهم ينقل الي مجلس القاضي ومءنة النقل تكون علي المدعي عليه والصحيح ان القاضي يبعث رجلا يسمع الشهادة بحضرة المدعي به وشهودا معه فيشهدون عند القاضي ان شهود المدعي شهدوا للمدعي وحينءذ يقضي القاضي للمدعي والذي بعثه القاضي لسماع الشهادة لا يكون قاضيا فلا بد من القضاء بتلك الشهادة * واذا وقعت الدعوي في دابة لا باس بارخالها في المسجد للخصومة اذا كان القاضي يجلس في المسجد لان الشهادة بالمنقول لا تقبل الا بالاشارة اليه * واذا ادعي رجل جارية او عبدا او دابة او عرضا في يد رجل فشهد احد شاهدي المدعي انها جاريته وشهد الاخر انها كانت جاريته ذكر الشيخ الامام المعروف بخواهر زاده رحمه الله تعالي في شرح الغصب انها بقبل ويقضي للمدعي وكذا لو شهد احدهما انها ملكه وشهد الاخر انها كانت ملكه* ولو شهد احدهما انها كانت في يده وشهد الاخر انها في يده لا تقبل ولو ادعي المدعي كانت له وشهد الشهود انها له ذكر الشيخ الامام المعروف بخواهر زاده رحمه الله تعالي انها لا تقبل * ولو شهد الشهود انها كانت في يد المدعي امس او قالوا منذ شهر او سنة لا يقضي بهذه الشهادة وعن ابي يوسف رحمه الله تعالي انها تقبل ويءمر بالتسليم الي المدعي*ولو شهدوا علي اقرار المدعي عليه انها كانت في يد المدعي امس يءمر بالاعادة الي المدعي في قولهم وكذا لو شهدوا انها كان في يد المدعي وان المدعي عليه هذا اخذها منه او غصبها منه او انتزعها من يده او ابق العبد من يد امدعي فاخذه المدعي عليه او ارسله المدعي في حاجته فاخذه المدعي عليه او اودعه عند المدعي عليه او اعاره اياه تقبل وان لم يشهدوا علي ملك المدعي* ولو شهد الشهود فقالوا نشهد ان هذا العين لهذا المدعي ولم يشهدوا انه ملك المدعي او قالوا نشهد ان المدعي مالك لهذا او شهدوا علي اقرار صاحب اليد ان هذا العين لهذا المدي يجوز ويعضي به للمدعي وكذا لو شهدوا انه له ملكه منذ عشرين سنة او ذكروا وقتا اقل من ذلك او اكثر يجوز ويقضي به للمدعي وما ذكرنا قبل هذا انه لا بد من التصريح علي الملك فذاك قول البعض وهو اختيار الشيخ الامام علي بن محمد البزدوي رحمه الله تعالي واما  علي قول العامة اذا شهدوا انه له تقبل * المدعي اذا قال للقاضي ان المدعي عليه اقر ان هذا الشء لي فمره بالتسليم الي قال عامة المشايخ تسمع دعواه واذا اقام البينة علي هذا يامره بالتسليم اليه * اذا شهدوا بشء ينقل ان هذا الشء ملك المدعي تجوز شهادتهم وان لم يشهدوا انه في يد المدعي عليه بغير حق لانهم لما شهدوا له بالملك وملك الانسان لا يكون في يد غيره الا بعارض فالبينة تكون علي مدعي العارض ولا تكون علي صاخب الاصل وقال بعضهم ما لم يشهدوا انه في يد المعي عليه بغير حق لا يقطع يد المدعي عليه والاول اصح وفيما سوي العقار لا يشترط ان يشهدوا انه في يد المدعي[] عليه لان القاضي يراه في يد ه فلا حاجة الي البيان بخلاف العقار * رجلان تنازعا في عين كل واحد منهما يدعي انه له فان كان العين في يد غيرهما ينكر دعواهما فاقام المدعيان البينة علي الملك المطلق ان لم يءرخا او ارخا وتاريخهما سواء يقضي بينهما نصفان فان ارخا واحدهما اسبق في ظاهر الرواية عن ابي حنيفة وابي يوسف الاخر ومحمد الاول يقضي لاسبقهما وان ارخ احدهما واطلق الاخر في ظاهر الرواية عن ابي حنيفة رحمه الله تعالي يقضي بينهما وهو الصحيح ولا يعتبر التاريخ عند الانفراد * واختلفت الروايات عن صاحبيه في ذلك قال الشيخ الامام المعروف بخواهر زاده رحمه الله تعالي الصحيح ان علي قول ابي يوسف الاول ومحمد الاخر يقضي بينهما نصفان كما قال ابو حنيفة رحمه الله تعالي وان كان العين في يد احدهما فان لم يءرخا او ارخا تاريخما سواء فالخارج اولي وان ارخا واحدهما اسبق يقضي لاسبقهما سواء كان خارجا او صاحب يد وهو قول ابي يوسف الاخر وفي قول محمد الاخر الخارج اولي فان ارخ احدهما ولم يءرخ الاخر كان الخارج اولي في قول ابي حنيفة ومحمد الاخر وابي يوسف الاول * ولو تنازع رجلان في شء فاقام احدهما البينة انه كان في يده منذ شهر واقام الاخر البينة انه كان في يده منذ جمعة جعله القاضي في يد مدعي الجمعة * عبد في يد رجل اقام البينة انه كان عبده منذ عشرين سنة واقام اخر البينة انه عبده وكان في يده منذ سنة حتي اغتصبه الذي في يده فهو لمن في يده * رجل قال لغيره هذا العبد لك فقال المقر له ليس هو لي ثم قال بلي هو لي لا يقبل قوله *ولو اقام البينة انه لي لا بقبل بينته * وقال الناطفي رحمه الله تعالي اذا قال ليست هذه الدار لي ثم اقام البينة انها له تقبل بينته لانه لم يقربها لمعروف حتي لو كانت الدار في يد رجل يدعيها لنفسه فقال رجل اخر ليست الدار لي ثم ادعاها لنفسه لا تسمع دعواه * ولو اقام البينة لا تقبل بينته لانه لما قال ليست لي صار مقرا بالملك لذي اليد فاذا ادعاه لنفسه بعد ذلك لا تسمع *رجل في يده عبد يقر بالرق فادعي العبد ان فلانا الغاءب اشتراه من مولاه هذا بالف ونقده الثمن لا يقبل قوله وان ادعي ان فلانا الغاءب اشتراه من مولاه ووكله بالخصومة وبقبض نفسه من صاحب اليد قبلت بينته لان القبد يصلح خصما في قبض نفسه ويصلح وكيلا في شراء نفسه ولو قال العبد كنت عبدا لفلان فباعني منك بالف درهم ووكلني بقبض الثمن واقام البينة علي ذلك قبلت بينته الا ان لمولاه ان يمنعه عن الخصومة وان لم يمنعه فالوكالة جاءزة وله ان يقبض الثمن ويبرا منه المولي * ولو قال انا عبد فلان قد وكلني بخصومتك في نفسي واقام البينة قبلت بينته * رجل جاء الي امراة رجل او بنته وهي صغيرة فخدعها واخرجها من منزل ابيها او زوجها كان للاب والزوج ان يخاصمه في ذلك ويحبس حتي ياتي بها او يعلم انها قد ماتت* رجل ادعي عبدا في يد رجل فطولب لابينة فلما قاما من عند القاضي باعه صاحب اليد من رجل بالف وتقابضا ثم اودعه المشتري عند الباءع وغاب ثم جاء المدعي بالبينة فان كان القاضي يعلم بما صنع ذو اليد او اقر به المدعي لا يسمع بينة المدعي علي ذي اليد وان لم يعلم به القاضي ولا اقر به المدعي تقبل بينة المجعي ولا تقبل بينة صاحب اليد انه باعه من فلان ثم اودعه فلان عنده وان اقام البينة علي اقرار المدعي بذلك قبلت بينته وتندفع عنه الخصومة * والهبة والصدقة اذا اتصل بهما لالقبض بمنزلة البيع في ذلك * رجل ادعي عبدا في يد رجل فقبل [ان يقيم البينة باعه المدعي عليه من رجل بمحضر من الشهود ثم اقام المدعي البينة علي المدعي عليه ان العبد له فان القاضي يقضي به للمدعي ولا تقبل بينة المدعي عليه انه باعه فان جاء المشتري بعد ذلك واقام البينة علي المقضي له ان العبد عبده وهو في يده بغير حق يقضي به للمشتري فلو باعه المشتري او وهبه من المقضي عليه الاول جاز ويعود العبد الي ملكه وهذه حيلة يحتال بها لدفع الاستحقاق *ولو ادعي عبدا في يد رجل فقبل ان يقيم المدعي البينة باعة بيعا صحيحا بمحضر من الشهود ثم اقام المدعي البينة علي ان العبد له فانه يقضي به للمدعي فان حضر المشتري بعد ذلك واقام البينة علي المقضي له اوان 