  (باب الامر بقتال الناس حتي يقولوا لا اله الا الله 
 محمد رسول الله (ويقيموا الصلاة ويءتوا الزكاة ويءمنوا بجميع ما جاء به النبي صلي الله عليه وسلم) (وان من فعل ذلك عصم نفسه وماله الا بحقها ووكلت سريرته الي الله تعالي) (وقتال من منع الزكاة او غيرها من حقوق الاسلام واهتمام الامام بشعاءر الاسلام) اما اسماء الرواة ففيه عقيل عن الزهري هو بضم العين وتقدم في الفصول بيانه وفيه يونس وقد تقدم بيانه وان فيه ستة اوجه ضم النون وكسرها وفتحها مع الهمز وتركه وفيه سعيد بن المسيب وقد قدمنا ان المسيب بفتح الياء علي المشهور وقيل بكسرها وفيه احمد بن عبدة باسكان الباء وفيه امية بن بسطام تقدم بيانه في الباب قبله وفيه حفص بن غياث عن الاعمش عن ابي سفيان عن جابر وعن ابي صالح عن ابي هريرة فقوله وعن ابي صالح يعني رواه الاعمش)
 
 ايضا عن ابي صالح وقد تقدم ان اسم ابي هريرة عبد الرحمن بن صخر علي الاصح من نحو ثلاثين قولا وان اسم ابي صالح ذكوان السمان وان اسم ابي سفيان طلحة بن نافع وان اسم الاعمش سليمان بن مهران واما غياث فبالغين المعجمة واخره مثلثة وفيه ابو الزبير وقد تقدم في كتاب الايمان ان اسمه محمد بن مسلم بن تدرس بفتح المثناة فوق وفيه ابوغسان المسمعي مالك بن عبد الواحد هو بكسر الميم الاولي وفتح الثانية واسكان المهملة بينهما منسوب الي مسمع بن ربيعة وتقدم بيان صرف غسان وعدمه وانه يجوز الوجهان فيه وفيه واقد بن محمد وهو بالقاف وقد قدمنا في الفصول انه ليس في الصحيحين وافد بالفاء بل كله بالقاف وفيه ابو خالد الاحمر وابومالك عن ابيه فابو مالك اسمه سعد بن طارق وطارق الصحابي وقد تقدم ذكرهما في باب اركان الاسلام وتقدم فيه ايضا ان ابا خالد اسمه سليمان بن حيان بالمثناة وفيه عبد العزيز الدراوردي وهو بفتح الدال المهملة وبعدها راء ثم الف ثم واو مفتوحة ثم راء اخري ساكنة ثم دال اخري ثم ياء النسب واختلف في وجه نسبته فالاصح الذي قاله المحققون انه نسبة الي داربجرد بفتح الدال الاولي وبعدها راء ثم الف ثم باء موحدة مفتوحة ثم جيم مكسورة ثم راء ساكنة ثم دال فهذا قول جماعات من اهل العربية واللغة منهم الاصمعي وابو حاتم السجستاني وقاله من المحدثين ابو عبد الله البخاري الامام وابو حاتم بن حبان البستي وابو نصر الكلاباذي وغيرهم قالوا وهو من شواذ النسب قال ابو حاتم واصله درابي او جردي ودرابي اجود قالوا ودرابجرد مدينة بفارس قال البخاري والكلاباذي كان جد عبد العزيز هذا منها وقال البستي كان ابوه منها وقال بن قتيبة وجماعة من اهل الحديث هو منسوب الي دارورد ثم قيل دراورد هي درابحرد وقيل بل هي قرية بخراسان وقال السمعاني في كتاب الانساب قيل انه من اندرابه يعني بفتح الهمزة وبعدها نون ساكنة ثم دال مهملة مفتوحة ثم راء ثم الف ثم باء موحدة ثم هاء وهي مدينة من عمل بلخ وهذا الذي قاله السمعاني لاءق بقول من يقول فيه الاندراوردي واما فقهه ومعانيه قوله
 [] (لما توفي رسول الله صلي الله عليه وسلم واستخلف ابو بكر رضي الله عنه بعده وكفر من كفر
 
 من العرب) قال الخطابي رحمه الله في شرح هذا الكلام كلاما حسنا لا بد من ذكره لما فيه من الفواءد قال رحمه الله مما يجب تقديمه في هذا ان يعلم ان اهل الردة كانوا صنفين صنف ارتدوا عن الدين ونابذوا الملة وعادوا الي الكفر وهم الذين عناهم ابو هريرة بقوله وكفر من كفر من العرب وهذه الفرقة طاءفتان احداهما اصحاب مسيلمة من بني حنيفة وغيرهم الذين صدقوه علي دعواه في النبوة واصحاب الاسود العنسي ومن كان من مستجيبيه من اهل اليمن وغيرهم وهذه الفرقة باسرها منكرة لنبوة نبينا محمد صلي الله عليه وسلم مدعية النبوة لغيره فقاتلهم ابو بكر رضي الله عنه حتي قتل الله مسيلمة باليمامة والعنسي بصنعاء وانفضت جموعهم وهلك اكثرهم والطاءفة الاخري ارتدوا عن الدين وانكروا الشراءع وتركوا الصلاة والزكاة وغيرها من امور الدين وعادوا الي ما كانوا عليه في الجاهلية فلم يكن يسجد لله تعالي في بسيط الارض الا في ثلاثة مساجد مسجد مكة ومسجد المدينة ومسجد عبد القيس في البحرين في قرية يقال لها جواثا ففي ذلك يقول الاعور الشني يفتخر بذلك ... والمسجد الثالث الشرقي كان لنا ... والمنبران وفصل القول في الخطب ... ايام لامنبر للناس نعرفه ... الا بطيبة والمحجوب ذي الحجب ...
  (وكان هءلاء المتمسكون بدينهم من الازد محصورين 
 بجواثا الي ان فتح الله سبحانه علي المسلمين اليمامة فقال بعضهم وهو رجل من بني ابي بكر بن كلاب يستنجد ابا بكر الصديق رضي الله عنه ... الا ابلغ ابا بكر رسولا ... وفتيان المدينة اجمعينا ... فهل لكم الي قوم كرام ... قعود في جواثا محصرينا ... كان دماءهم في كل فج ... دماء البدن تغشي الناظرينا ... توكلنا علي الرحمن انا ... وجدنا النصر للمتوكلينا)
 والصنف الاخر هم الذين فرقوا بين الصلاة والزكاة فاقروا بالصلاة وانكروا فرض الزكاة ووجوب اداءها الي الامام وهءلاء علي الحقيقة اهل بغي وانما لم يدعوا بهذا الاسم في ذلك
 
 الزمان خصوصا لدخولهم في غمار اهل الردة فاضيف الاسم في الجملة الي الردة اذ كانت اعظم الامرين واهمهما وارخ قتال اهل البغي في زمن علي بن ابي طالب رضي الله عنه اذ كانوا منفردين في زمانه لم يختلطوا باهل الشرك وقد كان في ضمن هءلاء المانعين للزكاة من كان يسمح بالزكاة ولا يمنعها الا ان رءساءهم صدوهم عن ذلك الراي وقبضوا علي ايديهم في ذلك كبني يربوع فانهم قد جمعوا صدقاتهم وارادوا ان يبعثوا بها الي ابي بكر رضي الله عنه فمنعهم مالك بن نويرة من ذلك وفرقها فيهم وفي امر هءلاء عرض الخلاف ووقعت الشبهة لعمر رضي الله عنه فراجع ابا بكر رضي الله عنه وناظره واحتج عليه بقول النبي صلي الله عليه وسلم امرت ان اقاتل الناس حتي يقولوا لا اله الا الله فمن قال لا اله الا الله فقد عصم نفسه وماله وكان هذا من عمر رضي الله عنه تعلقا بظاهر الكلام قبل ان ينظر في اخره ويتامل شراءطه فقال له ابو بكر رضي الله عنه ان الزكاة حق المال يريد ان القضية قد تضمنت عصمة دم ومال معلقة بايفاء شراءطها والحكم المعلق بشرطين لا يحصل باحدهما والاخر معدوم ثم قايسه بالصلاة ورد الزكاة اليها وكان في ذلك من قوله دليل علي ان قتال الممتنع من الصلاة كان اجماعا من الصحابة وكذلك رد المختلف فيه الي المتفق عليه فاجتمع في هذه القضية الاحتجاج من عمر رضي الله عنه بالعموم ومن ابي بكر رضي الله عنه بالقياس ودل ذلك علي ان العموم يخص بالقياس وان جميع ما تضمنه الخطاب الوارد في الحكم الواحد من شرط واستثناء مراعي فيه ومعتبر صحته به فلما استقر عند عمر صحة راي ابي بكر رضي الله عنهما وبان له صوابه تابعه علي قتال القوم وهو معني قوله فلما رايت الله قد شرح صدر ابي بكر للقتال عرفت انه الحق يشير الي انشراح صدره بالحجة التي ادلي بها والبرهان الذي اقامه نصا ودلالة وقد زعم زاعمون من الرافضة ان ابا بكر رضي الله عنه اول من سبي المسلمون وان القوم كانوا متاولين في منع الصدقة وكانوا يزعمون ان الخطاب في قوله تعالي خذ من اموالهم صدقة تطهرهم وتزكيهم بها وصل عليهم ان صلاتك سكن لهم خطاب خاص في مواجهة النبي صلي الله عليه وسلم دون غيره وانه مقيد بشراءط لا توجد فيمن سواه وذلك انه ليس لاحد من التطهير والتزكية والصلاة عليالمتصدق ما للنبي صلي الله عليه وسلم ومثل هذه الشبهة اذا وجد كان مما يعذر فيه امثالهم ويرفع به السيف عنهم وزعموا ان قتالهم كان عسفا قال الخطابي رحمه الله وهءلاء الذين زعموا ما ذكرناه قوم لاخلاق لهم في الدين
 
 وانما راس مالهم البهت والتكذيب والوقيعة في السلف وقد بينا ان اهل الردة كانوا اصنافا منهم من ارتد عن الملة ودعا الي نبوة مسيلمة وغيره ومنهم من ترك الصلاة والزكاة وانكر الشراءع كلها وهءلاء هم الذين سماهم الصحابة كفارا ولذلك راي ابو بكر رضي الله عنه سبي ذراريهم وساعده علي ذلك اكثر الصحابة واستولد علي بن ابي طالب رضي الله عنه جارية من سبي بني حنيفة فولدت له محمد الذي يدعي بن الحنفية ثم لم ينقض عصر الصحابة حتي اجمعوا علي ان المرتد لا يسبي فاما مانعو الزكاة منهم المقيمون علي اصل الدين فانهم اهل بغي ولم يسموا علي الانفراد منهم كفارا وان كانت الردة قد اضيفت اليهم لمشاركتهم المرتدين في منع بعض ما منعوه من حقوق الدين وذلك ان الردة اسم لغوي وكل من انصرف عن امر كان مقبلا عليه فقد ارتد عنه وقد وجد من هءلاء القوم الانصراف عن الطاعة ومنع الحق وانقطع عنهم اسم الثناء والمدح بالدين وعلق بهم الاسم القبيح لمشاركتهم القوم الذين كان ارتدادهم حقا واما قوله تعالي خذ من اموالهم صدقة وما ادعوه من كون الخطاب خاصا لرسول الله صلي الله عليه وسلم فان خطاب كتاب الله تعالي علي ثلاثة اوجه خطاب عام كقوله تعالي يا ايها الذين امنوا اذا قمتم الي الصلاة الاية وكقوله تعالي يا ايها الذين امنوا كتب عليكم الصيام وخطاب خاص للنبي صلي الله عليه وسلم لا يشركه فيه غيره وهو ما ابين به عن غيره بسمة التخصيص وقطع التشريك كقوله تعالي ومن الليل فتهجد به نافلة لك وكقوله تعالي خالصة لك من دون المءمنين وخطاب مواجهة للنبي صلي الله عليه وسلم وهو وجميع امته في المراد به سواء كقوله تعالي اقم الصلاة لدلوك الشمس وكقوله تعالي فاذا قرات القران فاستعذ بالله من الشيطان الرجيم وكقوله تعالي واذا كنت فيهم فاقمت لهم الصلاة ونحو ذلك من خطاب المواجهة فكل ذلك غير مختص برسول الله صلي الله عليه وسلم بل تشاركه فيه الامة فكذا قوله تعالي خذ من اموالهم صدقة فعلي القاءم بعده صلي الله عليه وسلم بامر الامة ان يحتذي حذوه في اخذها منهم وانما الفاءدة في مواجهة النبي صلي الله عليه وسلم بالخطاب انه هو الداعي الي الله تعالي والمبين عنه معني ما اراد فقدم اسمه في الخطاب ليكون سلوك الامر في شراءع الدين علي حسب ما ينهجه ويبينه لهم وعلي هذا المعني قوله تعالي يا ايها النبي اذا طلقتم النساء فطلقوهن لعدتهن فافتتح الخطاب بالنبوة باسمه خصوصا ثم خاطبه وساءر امته بالحكم عموما وربما كان الخطاب له مواجهة والمراد غيره كقوله تعالي فان كنت في شك مما انزلنا اليك
 
 فاسءل الذين يقرءن الكتاب من قبلك الي قوله فلا تكونن من الممترين ولا يجوز ان يكون صلي الله عليه وسلم قد شك قط في شء مما انزل اليه فاما التطهير والتزكية والدعاء من الامام لصاحب الصدقة فان الفاعل فيها قد ينال ذلك كله بطاعة الله وطاعة رسوله صلي الله عليه وسلم فيها وكل ثواب موعود علي عمل بر كان في زمنه صلي الله عليه وسلم فانه باق غير منقطع ويستحب للامام وعامل الصدقة ان يدعو للمصدق بالنماء والبركة في ماله ويرجي ان يستجيب الله ذلك ولا يخيب مسالته فان قيل كيف تاولت امر الطاءفة التي منعت الزكاة علي الوجه الذي ذهبت اليه وجعلتهم اهل بغي وهل اذا انكرت طاءفة من المسلمين في زماننا فرض الزكاة وامتنعوا من اداءها يكون حكمهم حكم اهل البغي قلنا لا فان من انكر فرض الزكاة في هذه الازمان كان كافرا باجماع المسلمين والفرق بين هءلاء واولءك انهم انما عذروا لاسباب وامور لا يحدث مثلها في هذا الزمان منها قرب العهد بزمان الشريعة الذي كان يقع فيه تبديل الاحكام بالنسخ ومنها ان القوم كانوا جهالا بامور الدين وكان عهدهم بالاسلام قريبا فدخلتهم الشبهة فعذروا فاما اليوم وقد شاع دين الاسلام واستفاض في المسلمين علم وجوب الزكاة حتي عرفها الخاص والعام واشترك فيه العالم والجاهل فلا يعذر احد بتاويل يتاوله في انكارها وكذلك الامر في كل من انكر شيءا مما اجمعت الامة عليه من امور الدين اذا كان علمه منتشرا كالصلوات الخمس وصوم شهر رمضان والاغتسال من الجنابة وتحريم الزني والخمر ونكاح ذوات المحارم ونحوها من الاحكام الا ان يكون رجلا حديث عهد بالاسلام ولا يعرف حدوده فانه اذا انكر شيءا منها جهلا به لم يكفر وكان سبيله سبيل اولءك القوم في بقاء اسم الدين عليه فاما ما كان الاجماع فيه معلوما من طريق علم الخاصة كتحريم نكاح المراة علي عمتها وخالتها وان القاتل عمدا لا يرث وان للجدة السدس وما اشبه ذلك من الاحكام فان من انكرها لا يكفر بل يعذر فيها لعدم استفاضة علمها في العامة قال الخطابي رحمه الله وانما عرضت الشبهة لمن تاوله علي الوجه الذي حكيناه عنه لكثرة ما دخله من الحذف في رواية ابي هريرة وذلك لان القصد به لم يكن سياق الحديث علي وجهه وذكر القصة في كيفية الردة منهم وانما قصد به حكاية ما جري بين ابي بكر وعمر رضي الله عنهما وما تنازعاه في استباحة قتالهم ويشبه ان يكون ابو هريرة انما لم يعن بذكر جميع القصة اعتمادا علي معرفة المخاطبين بها اذ كانوا قد علموا كيفية القصة ويبين لك ان حديث ابي هريرة مختصر ان عبد الله
 
 بن عمر وانسا رضي الله عنهم روياه بزيادة لم يذكرها ابو هريرة ففي حديث بن عمر رضي الله عنهما عن رسول الله صلي الله عليه وسلم قال امرت ان اقاتل الناس حتي يشهدوا ان لا اله الا الله وان محمدا رسول الله ويقيموا الصلاة ويءتوا الزكاة فاذا فعلوا ذلك عصموا مني دماءهم واموالهم الا بحق الاسلام وحسابهم علي الله وفي رواية انس رضي الله عنه ان اقاتل الناس حتي يشهدوا ان لا اله الا الله وان محمدا عبده ورسوله وان يستقبلوا قبلتنا وان ياكلوا ذبيحتنا وان يصلوا صلاتنا فاذا فعلوا ذلك حرمت علينا دماءهم واموالهم الا بحقها لهم ما للمسلمين وعليهم ما علي المسلمين والله اعلم هذا اخر كلام الخطابي رحمه الله قلت وقد ثبت في الطريق الثالث المذكور في الكتاب من رواية ابي هريرة ان رسول الله صلي الله عليه وسلم قال اقاتل الناس حتي يشهدوا ان لا اله الا الله ويءمنوا بي وبما جءت به فاذا فعلوا ذلك عصموا مني دماءهم واموالهم الا بحقها وفي استدلال ابي بكر واعتراض عمر رضي الله عنهما دليل علي انهما لم يحفظا عن رسول الله صلي الله عليه وسلم ما رواه بن عمر وانس وابو هريرة وكان هءلاء الثلاثة سمعوا هذه الزيادات التي في رواياتهم في مجلس اخر فان عمر رضي الله عنه لو سمع ذلك لما خالف ولما كان احتج بالحديث فانه بهذه الزيادة حجة عليه ولو سمع ابو بكر رضي الله عنه هذه الزيادة لاحتج بها ولما احتج بالقياس والعموم والله اعلم قوله (امرت ان اقاتل الناس حتي يقولوا لا اله الا الله فمن قال لا اله الا الله فقد عصم مني ماله ونفسه الا بحقه وحسابه علي الله) قال الخطابي رحمه الله معلوم ان المراد بهذا اهل الاوثان دون اهل الكتاب لانهم يقولون لا اله الا الله ثم يقاتلون ولا يرفع عنهم السيف قال ومعني وحسابه علي الله اي فيما يستسرون به ويخفونه دون ما يخلون به في الظاهر من الاحكام الواجبة قال ففيه ان من اظهر الاسلام واسر الكفر قبل اسلامه في الظاهر وهذا قول اكثر العلماء وذهب مالك الي ان توبة الزنديق لاتقبل ويحكي ذلك ايضا عن احمد بن حنبل رضي الله عنهما هذا كلام الخطابي وذكر القاضي عياض معني هذا وزاد عليه واوضحه فقال اختصاص عصمة
 
 المال والنفس بمن قال لا اله الا الله تعبير عن الاجابة الي الايمان وان المراد بهذا مشركو العرب واهل الاوثان ومن لا يوحد وهم كانوا اول من دعي الي الاسلام وقوتل عليه فاما غيرهم ممن يقر بالتوحيد فلا يكتفي في عصمته بقوله لا اله الا الله اذ كان يقولها في كفره وهي من اعتقاده فلذلك جاء في الحديث الاخر واني رسول الله ويقيم الصلاة ويءتي الزكاة هذا كلام القاضي قلت ولا بد مع هذا من الايمان بجميع ما جاء به رسول الله صلي الله عليه وسلم كما جاء في الرواية الاخري لابي هريرة هي مذكورة في الكتاب حتي يشهدوا ان لا اله الا الله ويءمنوا بي وبما جءت به والله اعلم قلت اختلف اصحابنا في قبول توبة الزنديق وهو الذي ينكر الشرع جملة فذكروا فيه خمسة اوجه لاصحابنا اصحها والاصوب منها قبولها مطلقا للاحاديث الصحيحة المطلقة والثاني لا تقبل ويتحتم قتله لكنه ان صدق في توبته نفعه ذلك في الدار الاخرة وكان من اهل الجنة والثالث ان تاب مرة واحدة قبلت توبته فان تكرر ذلك منه لم تقبل والرابع ان اسلم ابتداء من غير طلب قبل منه وان كان تحت السيف فلا والخامس ان كان داعيا الي الضلال لم يقبل منه والا قبل منه والله اعلم قوله رضي الله عنه (والله لاقاتلن من فرق بين الصلاة والزكاة) ضبطنا بوجهين فرق وفرق بتشديد الراء وتخفيفها ومعناه من اطاع في الصلاة وجحد الزكاة او منعها وفيه جواز الحلف وان كان في غير مجلس الحاكم وانه ليس مكروها اذا كان لحاجة من تفخيم امر ونحوه قوله (والله لو منعوني عقالا كانوا يءدونه الي رسول الله صلي الله عليه وسلم لقاتلتهم علي منعه) هكذا في مسلم عقالا وكذا في بعض روايات البخاري وفي بعضها عناقا بفتح العين وبالنون وهي الانثي من ولد المعز وكلاهما صحيح وهو محمول علي انه كرر الكلام مرتين فقال في مرة عقالا وفي الاخري عناقا فروي عنه اللفظان فاما رواية العناق فهي محمولة علي ما اذا كانت الغنم صغارا كلها بان ماتت اماتها في بعض الحول فاذا حال حول الامات زكي السخال الصغار بحول الامات سواء بقي من الامات شء
 
 ام لا هذا هو الصحيح المشهور وقال ابو القاسم الانماطي من اصحابنا لا يزكي الاولاد بحول الامات الا ان يبقي من الامات نصاب وقال بعض اصحابنا الا ان يبقي من الامهات شء ويتصور ذلك فيما اذا مات معظم الكبار وحدثت صغار فحال حول الكبار علي بقيتها وعلي الصغار والله اعلم واما رواية عقالا فقد اختلف العلماء قديما وحديثا فيها فذهب جماعة منهم الي ان المراد بالعقال زكاة عام وهو معروف في اللغة بذلك وهذا قول النساءي والنضر بن شميل وابي عبيدة والمبرد وغيرهم من اهل اللغة وهو قول جماعة من الفقهاء واحتج هءلاء علي ان العقال يطلق علي زكاة العام بقول عمرو بن العداء سعي عقالا فلم يترك لنا سبدا ... فكيف لو قد سعي عمرو عقالين ...
  (اراد مدة عقال فنصبه علي الظرف وعمرو هذا الساعي هو 
 عمرو بن عتبة بن ابي سفيان ولاه عمه معاوية بن ابي سفيان رضي الله عنهما صدقات كلب فقال فيه قاءلهم ذلك قالوا ولان العقال الذي هو الحبل الذي يعقل به البعير لا يجب دفعه في الزكاة فلا يجوز القتال عليه فلا يصح حمل الحديث عليه وذهب كثيرون من المحققين الي ان المراد بالعقال الحبل الذي يعقل به البعير وهذا القول يحكي عن مالك وبن ابي ذءب وغيرهما وهو اختيار صاحب التحرير وجماعة من حذاق المتاخرين قال صاحب التحرير قول من قال المراد صدقة عام تعسف وذهاب عن طريقة العرب لان الكلام خرج مخرج التضييق والتشديد والمبالغة فتقتضي قلة ما علق به القتال وحقارته واذا حمل علي صدقة العام لم يحصل هذا المعني قال ولست اشبه هذا الا بتعسف من قال في قوله صلي الله عليه وسلم لعن الله السارق يسرق البيضة فتقطع يده ويسرق الحبل فتقطع يده ان المراد بالبيضة بيضة الحديد التي يغطي بها الراس في الحرب وبالحبل الواحد من حبال السفينة وكل واحد من هذين يبلغ دنانير كثيرة قال بعض المحققين ان هذا القول لا يجوز عند من يعرف اللغة ومخارج كلام العرب لان هذا ليس موضع تكثير لما يسرقه فيصرف اليه بيضة تساوي دنانير وحبل لا يقدر السارق علي حمله وليس من عادة العرب والعجم ان يقولوا قبح الله فلانا عرض نفسه للضرب في عقد جوهر وتعرض لعقوبة الغلول في جراب مسك وانما العادة في مثل هذا ان يقال لعنه الله تعرض لقطع اليد في حبل رث او في كبة شعر وكل ما كان من هذا احقر كان ابلغ فالصحيح هنا انه اراد به العقال الذي يعقل به البعير ولم يرد)
 
 عينه وانما اراد قدر قيمته والدليل علي هذا ان المراد به المبالغة ولهذا قال في الرواية الاخري عناقا وفي بعضها لو منعوني جديا اذوط والاذوط صغير الفك والذقن هذا اخر كلام صاحب التحرير وهذا الذي اختاره هو الصحيح الذي لا ينبغي غيره وعلي هذا اختلفوا في المراد بمنعوني عقالا فقيل قدر قيمته وهو ظاهر متصور في زكاة الذهب والفضة والمعشرات والمعدن والزكاة وزكاة الفطر وفي المواشي ايضا في بعض احوالها كما اذا وجب عليه سن فلم يكن عنده ونزل الي سن دونها واختار ان يرد عشرين درهما فمنع من العشرين قيمة عقال وكما اذا كانت غنمه سخالا وفيها سخلة فمنعها وهي تساوي عقالا ونظاءر ما ذكرته كثيرة معروفة في كتب الفقه وانما ذكرت هذه الصورة تنبيها بها علي غيرها وعلي انه متصور ليس بصعب فاني رايت كثيرين ممن لم يعان الفقه يستصعب تصوره حتي حمله بعضهم وربما وافقه بعض المتقدمين علي ان ذلك للمبالغة وليس متصورا وهذا غلط قبيح وجهل صريح وحكي الخطابي عن بعض العلماء ان معناه منعوني زكاة لعقال اذا كان من عروض التجارة وهذا تاويل صحيح ايضا ويجوز ان يراد منعوني عقالا اي منعوني الحبل نفسه علي مذهب من يجوز القيمة ويتصور علي مذهب الشافعي رحمه الله علي احد اقواله فان للشافعي في الواجب في عروض التجارة ثلاثة اقوال احدها يتعين ان ياخذ منها عرضا حبلا او غيره كما ياخذ من الماشية من جنسها والثاني انه لا ياخذ الا دراهم او دنانير ربع عشر قيمته كالذهب والفضة والثالث يتخير بين العرض والنقد والله اعلم وحكي الخطابي عن بعض اهل العلم ان العقال يءخذ مع الفريضة لان علي صاحبها تسليمها وانما يقع قبضها التام برباطها قال الخطابي قال بن عاءشة كان من عادة المصدق اذا اخذ الصدقة ان يعمد الي قرن وهو بفتح القاف والراء وهو حبل فيقرن به بين بعيرين اي يشده في اعناقهما لءلا تشرد الابل وقال ابو عبيد وقد بعث النبي صلي الله عليه وسلم محمد بن مسلمة علي الصدقة فكان ياخذ مع كل فريضتين عقالهما وقرانهما وكان عمر رضي الله عنه ايضا ياخذ مع كل فريضة عقالا والله اعلم قوله (فما هو الا ان رايت الله تعالي قد شرح صدر ابي بكر للقتال
 
 فعرفت انه الحق) معني رايت علمت وايقنت ومعني شرح فتح ووسع ولين ومعناه علمت بانه جازم بالقتال لما القي الله سبحانه وتعالي في قلبه من الطمانينة لذلك واستصوابه ذلك ومعني قوله عرفت انه الحق اي بما اظهر من الدليل واقامه من الحجة فعرفت بذلك ان ما ذهب اليه هو الحق لا ان عمر قلد ابا بكر رضي الله عنهما فان المجتهد لا يقلد المجتهد وقد زعمت الرافضة ان عمر رضي الله عنه انما وافق ابا بكر تقليدا وبنوه علي مذهبهم الفاسد في وجوب عصمة الاءمة وهذه جهالة ظاهرة منهم والله اعلم قوله صلي الله عليه وسلم في الرواية الاخري (اقاتل الناس حتي يشهدوا ان لا اله الا الله ويءمنوا بي وبما جءت به) فيه بيان ما اختصر في الروايات الاخر من الاقتصار علي قول لا اله الا الله وقد تقدم بيان هذا وفيه دلالة ظاهرة لمذهب المحققين والجماهير من السلف والخلف ان الانسان اذا اعتقد دين الاسلام اعتقادا جازما لا تردد فيه كفاه ذلك وهو مءمن من الموحدين ولا يجب عليه تعلم ادلة المتكلمين ومعرفة الله تعالي بها خلافا لمن اوجب ذلك وجعله شرطا في كونه من
 
 اهل القبلة وزعم انه لا يكون له حكم المسلمين الا به وهذا المذهب هو قول كثير من المعتزلة وبعض اصحابنا المتكلمين وهو خطا ظاهر فان المراد التصديق الجازم وقد حصل ولان النبي صلي الله عليه وسلم اكتفي بالتصديق بما جاء به صلي الله عليه وسلم ولم يشترط المعرفة بالدليل فقد تظاهرت بهذا احاديث في الصحيحين يحصل بمجموعها التواتر باصلها والعلم القطعي وقد تقدم ذكر هذه القاعدة في اول الايمان والله اعلم قوله (ثم قرا انما انت مذكر لست عليهم بمسيطر) قال المفسرون معناه انما انت واعظ ولم يكن صلي الله عليه وسلم امر اذ ذاك الا بالتذكير ثم امر بعد بالقتال والمسيطر المسلط وقيل الجبار وقيل الرب والله اعلم واعلم ان هذا الحديث بطرقه مشتمل علي انواع من العلوم وجمل من القواعد وانا اشير الي اطراف منها مختصرة ففيه ادل دليل علي شجاعة ابي بكر رضي الله عنه وتقدمه في الشجاعة والعلم علي غيره فانه ثبت للقتال في هذا الموطن العظيم الذي هو اكبر نعمة انعم الله تعالي بها علي المسلمين بعد رسول الله صلي الله عليه وسلم واستنبط رضي الله عنه من العلم بدقيق نظره ورصانة فكره
 
 ما لم يشاركه في الابتداء به غيره فلهذا وغيره مما اكرمه الله تعالي به اجمع اهل الحق علي انه افضل امة رسول الله صلي الله عليه وسلم وقد صنف العلماء رضي الله عنهم في معرفة رجحانه اشياء كثيرة مشهورة في الاصول وغيرها ومن احسنها كتاب فضاءل الصحابة رضي الله عنهم للامام ابي المظفر منصور بن محمد السمعاني الشافعي وفيه جواز مراجعة الاءمة والاكابر ومناظرتهم لاظهار الحق وفيه ان الايمان شرطه الاقرار بالشهادتين مع اعتقادهما واعتقاد جميع ما اتي به رسول الله صلي الله عليه وسلم وقد جمع ذلك صلي الله عليه وسلم بقوله اقاتل الناس حتي يقولوا لا اله الا الله ويءمنوا بي وبما جءت به وفيه وجوب الجهاد وفيه صيانة مال من اتي بكلمة التوحيد ونفسه ولو كان عند السيف وفيه ان الاحكام تجري علي الظاهر والله تعالي يتولي السراء وفيه جواز القياس والعمل به وفيه وجوب قتال ما نعي الزكاة او الصلاة او غيرهما من واجبات الاسلام قليلا كان او كثيرا لقوله رضي الله عنه لو منعوني عقالا او عناقا وفيه جواز التمسك بالعموم لقوله
 
 فان الزكاة حق المال وفيه وجوب قتال اهل البغي وفيه وجوب الزكاة في السخال تبعا لامهاتها وفيه اجتهاد الاءمة في النوازل وردها الي الاصول ومناظرة اهل العلم فيها ورجوع من ظهر له الحق الي قول صاحبه وفيه ترك تخطءة المجتهدين المختلفين في الفروع بعضهم بعضا وفيه ان الاجماع لا ينعقد اذا خالف من اهل الحل والعقد واحد وهذا هو الصحيح المشهور وخالف فيه اصحاب الاصول وفيه قبول توبة الزنديق وقد قدمت الخلاف فيه واضحا والله سبحانه وتعالي اعلم بالصواب وله الحمد والنعمة والفضل والمنة وبه التوفيق والعصمة
 []
  (باب الدليل علي صحة اسلام من حضره الموت (ما لم يشرع 
 في النزع وهو الغرغرة ونسخ جواز الاستغفار للمشركين والدليل علي ان) (من مات علي الشرك فهو من اصحاب الجحيم ولا ينقذه من ذلك شء من الوساءل) فيه حديث وفاة ابي طالب وهو حديث اتفق البخاري ومسلم علي اخراجه في صحيحيهما من رواية سعيد بن المسيب عن ابيه عن رسول الله صلي الله عليه وسلم ولم يروه عن المسيب الا ابنه سعيد كذا قاله الحفاظ وفي هذا رد علي الحاكم ابي عبد الله بن البيع الحافظ رحمه الله في قوله لم يخرج البخاري ولا مسلم رحمهما الله عن احد ممن لم يرو عنه الا راو واحد ولعله اراد من غير الصحابة والله اعلم اما اسماء رواة الباب ففيه حرملة التجيبي وقد تقدم بيانه في المقدمة وان الاشهر فيه ضم التاء ويقال بفتحها واختاره بعضهم وتقدمت اللغات الست في يونس فيها وتقدم فيها الخلاف في فتح الياء من المسيب والد سعيد هذا خاصة وكسرها وان الاشهر الفتح واسم ابي طالب عبد مناف واسم ابي جهل عمرو بن هشام وفيه صالح عن الزهري عن بن المسيب هو صالح بن كيسان وكان اكبر سنا من الزهري وابتدا بالتعلم من الزهري ولصالح تسعون سنة مات بعد الاربعين وماءة واجتمع في الاسناد طرفتان احداهما رواية الاكابر عن الاصاغر والاخري ثلاثة تابعيون بعضهم عن بعض وفيه ابو حازم عن سهل عن ابي هريرة وقد تقدم ان ابا حازم الراوي عن ابي هريرة اسمه سلمان مولي عزة)
 
 واما ابو حازم عن سهل بن سعد فاسمه سلمة بن دينار واما قوله (لما حضرت ابا طالب الوفاة) فالمراد قربت وفاته وحضرت دلاءلها وذلك قبل المعاينة والنزع ولو كان في حال المعاينة والنزع لما نفعه الايمان ولقول الله تعالي وليست التوبة للذين يعملون السيءات حتي اذا حضر احدهم الموت قال اني تبت الان ويدل علي انه قبل المعاينة محاورته للنبي صلي الله عليه وسلم ومع كفار قريش قال القاضي عياض رحمه الله وقد رايت بعض المتكلمين علي هذا الحديث جعل الحضور هنا علي حقيقة الاحتضار وان النبي صلي الله عليه وسلم رجا بقوله ذلك حينءذ ان تناله الرحمة ببركته صلي الله عليه وسلم قال القاضي رحمه الله وليس هذا بصحيح لما قدمناه واما قوله (فلم يزل رسول الله صلي الله عليه وسلم يعرضها عليه ويعيد له تلك المقالة) فهكذا وقع في جميع الاصول ويعيد له يعني ابا طالب وكذا نقله القاضي رحمه الله عن جميع الاصول والشيوخ قال وفي نسخة ويعيدان له علي التثنية لابي جهل وبن ابي امية قال القاضي وهذا اشبه وقوله يعرضها بفتح الياء وكسر الراء واما قوله (قال ابو طالب اخر ما كلمهم به هو علي ملة عبد المطلب) فهذا من احسن الاداب والتصرفات وهو ان من حكي قول غيره القبيح اتي به بضمير الغيبة لقبح صورة لفظه الواقع واما قوله صلي الله عليه وسلم (ام والله لاستغفرن
 
 لك) فهكذا ضبطناه ام من غير الف بعد الميم وفي كثير من الاصول او اكثرها اما والله بالف بعد الميم وكلاهما صحيح قال الامام ابو السعادات هبة الله بن علي بن محمد العلوي الحسني المعروف بابن الشجري في كتابه الامالي ما المزيدة للتوكيد ركبوها مع همزة الاستفهام واستعملوا مجموعهما علي وجهين احدهما ان يراد به معني حقا في قولهم اما والله لافعلن والاخر ان يكون افتتاحا للكلام بمنزلة الا كقولك اما ان زيدا منطلق واكثر ما تحذف الفها اذا وقع بعدها القسم ليدلوا علي شدة اتصال الثاني بالاول لان الكلمة اذا بقيت علي حرف واحد لم تقم بنفسها فعلم بحذف الف ما افتقارها الي الاتصال بالهمزة والله تعالي اعلم وفيه جواز الحلف من غير استحلاف وكان الحلف هنا لتوكيد العزم علي الاستغفار وتطييبا لنفس ابي طالب وكانت وفاة ابي طالب بمكة قبل الهجرة بقليل قال بن فارس مات ابو طالب ولرسول الله صلي الله عليه وسلم تسع واربعون سنة وثمانية اشهر واحد عشر يوما وتوفيت خديجة ام المءمنين رضي الله عنها بعد موت ابي طالب بثلاثة ايام واما قول الله تعالي ما كان للنبي والذين امنوا ان يستغفروا للمشركين فقال المفسرون واهل المعاني معناه ما ينبغي لهم قالوا وهو نهي والواو في قوله تعالي ولو كانوا اولي قربي واو الحال والله اعلم واما قوله عز وجل انك لا تهدي من احببت ولكن الله يهدي من يشاء وهو اعلم بالمهتدين فقد اجمع المفسرون علي انها نزلت في ابي طالب وكذا نقل اجماعهم علي هذا الزجاج وغيره وهي عامة فانه لا يهدي ولا يضل الا الله تعالي قال الفراء وغيره قوله تعالي من احببت يكون علي وجهين احدهما معناه من احببته لقرابته والثاني من احببت ان يهتدي
 
 قال بن عباس ومجاهد ومقاتل وغيرهم وهو اعلم بالمهتدين اي بمن قدر له الهدي والله اعلم اما قوله (يقولون انما حمله علي ذلك الجزع لاقررت بها عينك) فهكذا هو في جميع الاصول وجميع روايات المحدثين في مسلم وغيره الجزع بالجيم والزاي وكذا نقله القاضي عياض وغيره عن جميع روايات المحدثين واصحاب الاخبار اي التواريخ والسير وذهب جماعات من اهل اللغة الي انه الخرع بالخاء المعجمة والراء المفتوحتين ايضا وممن نص عليه كذلك الهروي في الغريبين ونقله الخطابي عن ثعلب مختارا له وقاله ايضا شمر ومن المتاخرين ابو القاسم الزمخشري قال القاضي عياض رحمه الله ونبهنا غير واحد من شيوخنا علي انه الصواب قالوا والخرع هو الضعف والخور قال الازهري وقيل الخرع الدهش قال شمر كل رخو ضعيف خريع وخرع
 
 قال والخرع الدهش قال ومنه قول ابي طالب والله اعلم واما قوله لاقررت بها عينك فاحسن ما يقال فيه ما قاله ابو العباس ثعلب قال معني اقر الله عينه اي بلغه الله امنيته حتي ترضي نفسه وتقر عينه فلا تستشرف لشء وقال الاصمعي معناه ابرد الله دمعته لان دمعة الفرح باردة وقيل معناه اراه الله ما يسره والله اعلم
