 الضرع وانزل علينا من بركات السماء وانبت لنا من بركات الارض واكشف عنا من البلاء ما لا يكشفه غيرك اللهم انا نستغفرك من المعاصي التي تزيل النعم ونستغفرك من المعاصي التي بها تحل النقم ونستغفرك من المعاصي التي بها تثير الاذي ونستغفرك من المعاصي التي بها تحبس غيث السماء لا اله الا الله الحليم الكريم لا اله الا الله العلي العظيم سبحان الله رب العرش العظيم الحمد لله رب العالمين اسالك اللهم موجبات رحمتك وعزاءم مغفرتك والغنيمة من كل بر والسلامة من كل اثم والعصمة من كل ذنب والفوز بالجنة والنجاة من النار اللهم لا تدع لنا ذنبا الا غفرته ولا هما الا فرجته ولا عيبا الا سترته ولا مريضا الا شفيته ولا حاجة هي لك رضي ولنا فيها صلاح الا قضيتها يا ارحم الراحمين جاء في الحديث الشريف عن النبي  صلي الله عليه وسلم  انه قال «من انقطع الي الله عز وجل كفاه الله مءنته ورزقه من حيث لا يحتسب ومن انقطع الي الدنيا وكله الله عز وجل اليها» اه.
 (قوله ويقول في الخطبة الاولي) هذا مستانف لا معطوف علي الاستثناء
 (قوله ايضا ويقول في الخطبة الاولي الخ) زاد حج بادعيته  صلي الله عليه وسلم  الواردة عنه وهي كثيرة ومنها «اللهم اسقنا غيثا» الخ اه. ع ش علي م ر
 (قوله اللهم اسقنا) بقطع الهمزة من اسقي ووصلها من سقي ح ل فقد ورد الماضي ثلاثيا ورباعيا قال تعالي {وسقاهم ربهم} [الانسان: ] وقال {لاسقيناهم ماء غدقا} [الجن: ] اه. شيخنا
 (قوله مريعا) هو بضم فكسر وبالتحتية ما ياتي بالريع والزيادة وفي المختار الريع بالفتح النماء والزيادة وارض مريعة بالفتح بوزن وسيعة اي مخصبة اه. وروي بالموحدة من اربع البعير اذا اكل الريع وبالفوقية من رتعت الماشية اذا اكلت ما شاءت وكل صحيح مناسب هنا اه. ايعاب اه. شوبري
 (قوله غدقا) في المصباح غدقت العين غدقا من باب تعب كثر ماءها فهي غدقة وفي التنزيل {لاسقيناهم ماء غدقا} [الجن: ] اي كثيرا واغدقت اغداقا اي كثيرا واغدقت اغداقا كذلك وغدق المطر غدقا واغدق اغداقا مثله وغدقت الارض تغدق من باب ضرب ابتلت بالغدق اه
 (قوله اي انتهاء الحاجة) اي الفرض الشامل للزيادة النافعة والا فربما كان دوامه من العذاب وقوله من القانطين اي الايسين من رحمتك اه. ح ل اي بسبب تاخير المطر عنا اه. شيخنا ح ف
 (قوله انك كنت غفارا) اي كثير المغفرة
 (فاءدة) ذكر الثعلبي في تفسير قوله تعالي {ان الله كان علي كل شء حسيبا} [النساء: ] ان كل موضع وجد فيه ذكر كان موصولا بالله يصلح للماضي والمستقبل واذا كان موصولا بغيره يكون علي خلاف هذا المعني اه. برماوي
 (قوله المحمود العاقبة) زاد حج فالهنء النافع ظاهرا والمرء النافع باطنا اه. ع ش علي م ر
 (قوله كجل الفرس) اي كسوته اه. برماوي
 (قوله شديد الوقع علي الارض) اي ليغوص فيها يقال سح الماء يسح اذا سال من اعلي الي اسفل وساح يسيح اذا جري علي وجه الارض اه. برماوي
 (قوله ما يطبق) بضم الياء وفتح الطاء وتشديد الباء المكسورة وبضم الياء وسكون الطاء وكسر الباء مخففة ففيه وجهان اه. شيخنا وفي المختار واطبق الشء غطاه وفي القاموس وطبق الشء تطبيقا عم، والسحاب الجو غشاه، والماء وجه الارض غطاه انتهي اه. ع ش علي م ر
 (قوله كالطبق عليها) يقال هذا مطابق لهذا اي مساو له وبقية الحديث اللهم ان بالعباد والبلاد من اللاواء والجهد والضنك ما لا نشكو الا اليك اللهم انبت لنا الزرع وادر لنا الضرع واسقنا من بركات السماء وانبت لنا من بركات الارض اللهم ادفع عنا الجهد والجوع والعري واكشف عنا من البلاء ما لا يكشفه غيرك اللهم سقيا رحمة ولا سقيا عذاب ولا محق ولا هدم ولا غرق ولا بلاء والعباد جمع عبد وهو يشمل الذكر والانثي والحر والرقيق والبالغ والصبي المسلم والكافر والبلاد عطف علي العباد من عطف المحل علي الحال اي الاراضي من كل ما يتصور قيام الامور المذكورة به ولعلة احتراز عن نحو اهل السماء واللاواء بفتح اللام المشددة والهمز الساكن مع المد شدة الجوع والجهد بفتح الجيم وضمها التعب او قلة الخير وسوء الحال والضنك بفتح الضاد المعجمة وسكون النون اي الضيق او شدة التعب ونشكو بالنون او الياء التحتية اي اشياء لا نشكوها او لا يشكوها الا اليك اي لا يزيل شكواها الا انت وانبت بفتح الهمز وسكون النون من الانبات والزرع بفتح الزاي وسكون الراء وادر بفتح
 
 <span class="matn">(ويتوجه) للقبلة (من نحو ثلث) الخطبة (الثانية) وهو مراد الاصل بقوله بعد صدر الخطبة الثانية (وحينءذ يبالغ في الدعاء سرا وجهرا) قال تعالي {ادعوا ربكم تضرعا وخفية} [الاعراف: ] ويرفع الحاضرون ايديهم في الدعاء مشيرين بظهور اكفهم الي السماء للاتباع رواه مسلم والحكمة فيه ان القصد رفع البلاء بخلاف القاصد حصول شء كما مر بيانه في صفة الصلاة (ويجعل يمين رداءه يساره وعكسه و) يجعل (اعلاه اسفله وعكسه) والاول تحويل والثاني تنكيس وذلك للاتباع في الاول رواه ابو داود وغيره «ولهمه  صلي الله عليه وسلم  بالثاني فيه فانه استسقي وعليه خميصة سوداء فاراد ان ياخذ باسفلها فيجعله اعلاها فلما ثقلت عليه قلبها علي عاتقه»
