  محمد بن يحيي عن احمد بن محمد عن ابن محبوب عن ابن رءاب عن ضريس عن ابي جعفر ع قال العبد اذا اقر علي نفسه عند الامام مرة انه قد سرق قطعه والامة اذا اقرت علي نفسها بالسرقة قطعها

  علي بن ابراهيم عن ابيه عن ابن محبوب عن عبد الله بن سنان عن ابي عبد الله ع قال السارق اذا جاء من قبل نفسه تاءبا الي الله عز وجل ورد سرقته علي صاحبها فلا قطع عليه

  ابن محبوب عن ابي ايوب عن الفضيل بن يسار عن ابي عبد الله ع قال قال من اقر علي نفسه عند الامام بحق احد من حقوق المسلمين فليس علي الامام ان يقيم عليه الحد الذي اقر به عنده حتي يحضر صاحب حق الحد او وليه فيطلبه بحقه



 

 

 باب قيمة ما يقطع فيه السارق

  علي بن ابراهيم عن محمد بن عيسي بن عبيد عن يونس عن سماعة بن مهران عن ابي عبد الله ع قال قطع امير المءمنين ع في بيضة قلت وما بيضة قال بيضة قيمتها ربع دينار وقلت هو ادني حد السارق فسكت

  عنه عن عبد الله بن سنان عن ابي عبد الله ع قال لا يقطع يد السارق الا في شي ء تبلغ قيمته مجنا وهو ربع دينار

  عدة من اصحابنا عن احمد بن محمد عن الحسين بن سعيد عن القاسم بن محمد عن علي بن ابي حمزة عن ابي عبد الله ع قال لا يقطع يد السارق حتي تبلغ سرقته ربع دينار وقد قطع علي ص في بيضة حديد قال علي وقال ابو بصير سالت ابا عبد الله ع عن ادني ما يقطع فيه السارق فقال في بيضة حديد قلت وكم ثمنها قال ربع دينار

  علي عن محمد بن عيسي عن يونس عن محمد بن حمران وعن ابيه عن ابن ابي عمير عن جميل بن دراج جميعا عن محمد بن مسلم عن ابي جعفر ع قال ادني ما يقطع فيه يد السارق خمس دينار

  محمد بن يحيي عن احمد بن محمد عن بعض اصحابه عن ابان بن عثمان عن زرارة عن ابي جعفر ع قال اقل ما يقطع فيه الرجل خمس دينار

  محمد بن يحيي عن احمد بن محمد عن ابن محبوب عن ابي ايوب عن محمد بن



 

 

 مسلم قال قلت لابي عبد الله ع في كم يقطع السارق فقال في ربع دينار قال قلت له في درهمين فقال في ربع دينار بلغ الدينار ما بلغ قال فقلت له ارايت من سرق اقل من ربع دينار هل يقع عليه حين سرق اسم السارق وهل هو عند الله سارق في تلك الحال فقال كل من سرق من مسلم شيءا قد حواه واحرزه فهو يقع عليه اسم السارق وهو عند الله سارق ولكن لا يقطع الا في ربع دينار او اكثر ولو قطعت ايدي السراق فيما هو اقل من ربع دينار لالفيت عامة الناس مقطعين

 باب حد القطع وكيف هو

  علي بن ابراهيم عن ابيه ومحمد بن يحيي عن احمد بن محمد جميعا عن ابن ابي عمير عن حماد عن الحلبي عن ابي عبد الله ع قال قلت له من اين يجب القطع فبسط اصابعه وقال من هاهنا يعني من مفصل الكف

  محمد بن يحيي عن احمد بن محمد عن علي بن الحكم عن علي بن ابي حمزة عن ابي بصير عن ابي عبد الله ع قال القطع من وسط الكف ولا يقطع الابهام واذا قطعت الرجل ترك العقب لم يقطع

  حميد بن زياد عن الحسن بن محمد بن سماعة عن غير واحد عن ابان بن عثمان عن زرارة عن ابي جعفر ع قال كان علي ص لا يزيد علي قطع اليد والرجل ويقول اني لاستحيي من ربي ان ادعه ليس له ما يستنجي به او يتطهر به قال وسالته ان هو سرق بعد قطع اليد والرجل فقال استودعه السجن ابدا واغني عن الناس شره

  علي بن ابراهيم عن ابيه وعدة من اصحابنا عن سهل بن زياد جميعا عن



 

 ابن ابي نجران عن عاصم بن حميد عن محمد بن قيس عن ابي جعفر ع قال قضي امير المءمنين ع في السارق اذا سرق قطعت يمينه واذا سرق مرة اخري قطعت رجله اليسري ثم اذا سرق مرة اخري سجنته وتركت رجله اليمني يمشي عليها الي الغاءط ويده اليسري ياكل بها ويستنجي بها وقال اني لاستحيي من الله ان اتركه لا ينتفع بشي ء ولكني اسجنه حتي يموت في السجن وقال ما قطع رسول الله (صلي الله عليه واله وسلم) من سارق بعد يده ورجله

  عدة من اصحابنا عن احمد بن محمد عن الحسين بن سعيد عن النضر بن سويد عن القاسم عن ابي عبد الله ع قال سالته عن رجل سرق فقال سمعت ابي يقول اتي علي ع في زمانه برجل قد سرق فقطع يده ثم اتي به ثانية فقطع رجله من خلاف ثم اتي به ثالثة فخلده في السجن وانفق عليه من بيت مال المسلمين وقال هكذا صنع رسول الله (صلي الله عليه واله وسلم) لا اخالفه

  محمد بن يحيي عن محمد بن الحسين عن صفوان بن يحيي عن شعيب عن ابي بصير عن ابي عبد الله ع قال قطع رجل السارق بعد قطع اليد ثم لا يقطع بعد فان عاد حبس في السجن وانفق عليه من بيت مال المسلمين

  علي بن ابراهيم عن ابيه وعدة من اصحابنا عن سهل بن زياد جميعا عن ابن ابي نجران عن عاصم بن حميد عن محمد بن قيس عن ابي جعفر ع قال قضي امير المءمنين ع في رجل امر به ان يقطع يمينه فقدمت شماله فقطعوها وحسبوها يمينه وقالوا انما قطعنا شماله اتقطع يمينه قال فقال لا يقطع يمينه وقد قطعت شماله وقال في رجل اخذ بيضة من المغنم وقالوا قد سرق اقطعه فقال اني لم اقطع احدا له فيما اخذ شرك

  عدة من اصحابنا عن احمد بن محمد بن خالد عن عثمان بن عيسي عن سماعة بن مهران قال قال اذا اخذ السارق قطعت يده من وسط الكف فان عاد قطعت رجله من وسط القدم فان عاد استودع السجن فان سرق في السجن قتل

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن هشام بن سالم عن سليمان بن خالد قال سالت ابا عبد الله ع عن رجل سرق سرقة فكابر عنها فضرب فجاء بها



 

 بعينها هل يجب عليه القطع قال نعم ولكن لو اعترف ولم يجء بالسرقة لم تقطع يده لانه اعترف علي العذاب

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن حماد عن الحلبي قال سالت ابا عبد الله ع عن رجل ثقب بيتا فاخذ قبل ان يصل الي شي ء قال يعاقب فان اخذ وقد اخرج متاعا فعليه القطع قال وسالته عن رجل اخذوه وقد حمل كارة من ثياب وقال صاحب البيت اعطانيها قال يدرا عنه القطع الا ان يقوم عليه البينة فان قامت البينة عليه قطع قال ويقطع اليد والرجل ثم لا يقطع بعد ولكن ان عاد حبس وانفق عليه من بيت مال المسلمين

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال قال امير المءمنين ع في السارق اذا اخذ وقد اخذ المتاع وهو في البيت لم يخرج بعد فقال ليس عليه القطع حتي يخرج به من الدار

  عدة من اصحابنا عن سهل بن زياد وعلي بن ابراهيم عن ابيه جميعا عن ابن محبوب عن عبد الرحمن بن الحجاج عن بكير بن اعين عن ابي جعفر ع في رجل سرق فلم يقدر عليه ثم سرق مرة اخري فلم يقدر عليه وسرق مرة اخري فاخذ فجاءت البينة فشهدوا عليه بالسرقة الاولي والسرقة الاخيرة فقال تقطع يده بالسرقة الاولي ولا تقطع رجله بالسرقة الاخيرة فقيل كيف ذاك فقال لان الشهود شهدوا جميعا في مقام واحد بالسرقة الاولي والاخيرة قبل ان يقطع بالسرقة الاولي ولو ان الشهود شهدوا عليه بالسرقة الاولي ثم امسكوا حتي يقطع ثم شهدوا عليه بالسرقة الاخيرة قطعت رجله اليسري

  ابو علي الاشعري عن محمد بن عبد الجبار عن صفوان عن اسحاق بن عمار عن ابي ابراهيم ع قال تقطع يد السارق ويترك ابهامه وصدر راحته وتقطع رجله وتترك له عقبه يمشي عليها

  عدة من اصحابنا عن احمد بن ابي عبد الله عن عثمان بن عيسي عن سماعة قال قال ابو عبد الله ع اتي امير المءمنين ع برجال قد سرقوا فقطع ايديهم ثم قال



 

 ان الذي بان من اجسادكم قد وصل الي النار فان تتوبوا تجروها وان لم تتوبوا تجركم

  علي بن ابراهيم عن محمد بن عيسي عن يونس عن منصور بن حازم عن سليمان بن خالد قال قال ابو عبد الله ع اذا سرق السارق قطعت يده وغرم ما اخذ

  محمد بن يحيي عن احمد بن محمد بن عيسي عن ابن محبوب عن عبد الله بن سنان عن ابي عبد الله ع في رجل اشل اليد اليمني او اشل اليد الشمال سرق قال تقطع يده اليمني علي كل حال

  محمد بن يحيي عن محمد بن الحسين عن محمد بن عبد الله بن هلال عن ابيه عن ابي عبد الله ع قال قلت له اخبرني عن السارق لم تقطع يده اليمني ورجله اليسري ولا تقطع يده اليمني ورجله اليمني فقال ع ما احسن ما سالت اذا قطعت يده اليمني ورجله اليمني سقط علي جانبه الايسر ولم يقدر علي القيام فاذا قطعت يده اليمني ورجله اليسري اعتدل واستوي قاءما قلت له جعلت فداك وكيف يقوم وقد قطعت رجله قال ان القطع ليس من حيث رايت يقطع انما يقطع الرجل من الكعب ويترك من قدمه ما يقوم عليه يصلي ويعبد الله قلت له من اين تقطع اليد قال تقطع الاربع اصابع وتترك الابهام يعتمد عليها في الصلاة ويغسل بها وجهه للصلاة قلت فهذا القطع من اول من قطع قال قد كان عثمان بن عفان حسن ذلك لمعاوية

 باب ما يجب علي الطرار والمختلس من الحد

  ابو علي الاشعري عن محمد بن عبد الجبار عن صفوان بن يحيي عن اسحاق بن عمار عن ابي بصير عن احدهما ع قال سمعته يقول قال امير المءمنين ع لا



 

 اقطع في الدغارة المعلنة وهي الخلسة ولكن اعزره

  علي بن ابراهيم عن ابيه وعدة من اصحابنا عن سهل بن زياد جميعا عن ابن ابي نجران عن عاصم بن حميد عن محمد بن قيس عن ابي جعفر ع قال قضي امير المءمنين ع في رجل اختلس ثوبا من السوق فقالوا قد سرق هذا الرجل فقال اني لا اقطع في الدغارة المعلنة ولكن اقطع يد من ياخذ ثم يخفي

  حميد بن زياد عن الحسن بن محمد بن سماعة عن عدة من اصحابنا عن ابان بن عثمان عن عبد الرحمن بن ابي عبد الله عن ابي عبد الله ع قال ليس علي الذي يستلب قطع وليس علي الذي يطر الدراهم من ثوب الرجل قطع

  عدة من اصحابنا عن احمد بن محمد بن خالد عن عثمان بن عيسي عن سماعة قال قال من سرق خلسة اختلسها لم يقطع ولكن يضرب ضربا شديدا

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال اتي امير المءمنين ع بطرار قد طر دراهم من كم رجل قال فقال ان كان قد طر من قميصه الاعلي لم اقطعه وان كان طر من قميصه الداخل قطعته

  علي عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال قال امير المءمنين ع اربعة لا قطع عليهم المختلس والغلول ومن سرق من الغنيمة وسرقة الاجير فانها خيانة

  وبهذا الاسناد ان امير المءمنين ع اتي برجل اختلس درة من اذن جارية قال هذه الدغارة المعلنة فضربه وحبسه

  عدة من اصحابنا عن سهل بن زياد عن محمد بن الحسن بن شمون عن عبد الله بن عبد الرحمن عن مسمع ابي سيار عن ابي عبد الله ع ان امير المءمنين ع اتي



 

 بطرار قد طر من رجل من ردنه دراهم قال ان كان طر من قميصه الاعلي لم نقطعه وان كان طر من قميصه الاسفل قطعناه

 باب الاجير والضيف

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن حماد عن الحلبي عن ابي عبد الله ع انه قال في رجل استاجر اجيرا فاقعده علي متاعه فسرقه قال هو مءتمن وقال في رجل اتي رجلا فقال ارسلني فلان اليك لترسل اليه بكذا وكذا فاعطاه وصدقه فلقي صاحبه فقال له ان رسولك اتاني فبعثت اليك معه بكذا وكذا فقال ما ارسلته اليك وما اتاني بشي ء وزعم الرسول انه قد ارسله وقد دفعه اليه فقال ان وجد عليه بينة انه لم يرسله قطعت يده ومعني ذلك ان يكون الرسول قد اقر مرة انه لم يرسله وان لم يجد بينة فيمينه بالله ما ارسله ويستوفي الاخر من الرسول المال قلت ارايت ان زعم انه انما حمله علي ذلك الحاجة فقال يقطع لانه سرق مال الرجل

  محمد بن يحيي عن احمد بن محمد عن علي بن الحكم عن موسي بن بكر عن علي بن سعيد قال سالت ابا عبد الله ع عن رجل اكتري حمارا ثم اقبل به الي اصحاب الثياب فابتاع منهم ثوبا او ثوبين وترك الحمار فقال يرد الحمار علي صاحبه ويتبع الذي ذهب بالثوبين وليس عليه قطع انما هي خيانة

  محمد بن يحيي عن احمد بن محمد عن ابن محبوب عن ابي ايوب الخزاز عن سليمان بن خالد قال سالت ابا عبد الله ع عن الرجل يستاجر اجيرا فيسرق من بيته هل تقطع يده قال هذا مءتمن ليس بسارق هذا خاءن



 

  عدة من اصحابنا عن سهل بن زياد وعلي بن ابراهيم عن ابيه جميعا عن ابن محبوب عن علي بن رءاب عن محمد بن قيس عن ابي جعفر ع قال الضيف اذا سرق لم يقطع وان اضاف الضيف ضيفا فسرق قطع ضيف الضيف

  عدة من اصحابنا عن احمد بن محمد عن عثمان بن عيسي عن سماعة قال سالته عن رجل استاجر اجيرا فاخذ الاجير متاعه فسرقه فقال هو مءتمن ثم قال الاجير والضيف امناء ليس يقع عليهم حد السرقة

  علي بن ابراهيم عن ابيه عن ابن محبوب عن ابي ايوب عن ابي بصير قال سالت ابا جعفر ع عن قوم اصطحبوا في سفر رفقاء فسرق بعضهم متاع بعض فقال هذا خاءن لا يقطع ولكن يتبع بسرقته وخيانته قيل له فان سرق من منزل ابيه فقال لا يقطع لان ابن الرجل لا يحجب عن الدخول الي منزل ابيه هذا خاءن وكذلك ان سرق من منزل اخيه واخته اذا كان يدخل عليهم لا يحجبانه عن الدخول

 باب حد النباش

  علي بن ابراهيم عن ابيه ومحمد بن اسماعيل عن الفضل بن شاذان جميعا عن ابن ابي عمير عن حفص بن البختري قال سمعت ابا عبد الله ع يقول حد النباش حد السارق

  علي بن ابراهيم عن ابيه عن ادم بن اسحاق عن عبد الله بن محمد الجعفي قال كنت عند ابي جعفر ع وجاءه كتاب هشام بن عبد الملك في رجل نبش امراة فسلبها ثيابها ثم نكحها فان الناس قد اختلفوا علينا هاهنا فطاءفة قالوا اقتلوه وطاءفة قالوا احرقوه فكتب اليه ابو جعفر ع ان حرمة الميت كحرمة الحي حده ان تقطع يده لنبشه وسلبه الثياب ويقام عليه الحد في الزني ان احصن رجم وان لم يكن احصن جلد ماءة



 

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن غير واحد من اصحابنا قال اتي امير المءمنين ع برجل نباش فاخذ امير المءمنين ع بشعره فضرب به الارض ثم امر الناس ان يطءوه بارجلهم فوطءوه حتي مات

  حبيب بن الحسن عن محمد بن الوليد عن عمرو بن ثابت عن ابي الجارود عن ابي جعفر ع قال قال امير المءمنين ع يقطع سارق الموتي كما يقطع سارق الاحياء

  عنه عن محمد بن عبد الحميد العطار عن سيار عن زيد الشحام عن ابي عبد الله ع قال اخذ نباش في زمن معاوية فقال لاصحابه ما ترون فقالوا تعاقبه وتخلي سبيله فقال رجل من القوم ما هكذا فعل علي بن ابي طالب ع قال وما فعل قال فقال يقطع النباش وقال هو سارق وهتاك للموتي

  محمد بن جعفر الكوفي عن محمد بن عبد الحميد عن سيف بن عميرة عن منصور بن حازم قال سمعت ابا عبد الله ع يقول يقطع النباش والطرار ولا يقطع المختلس

 باب حد من سرق حرا فباعه

  محمد بن يحيي عن محمد بن الحسين عن حنان عن معاوية بن طريف عن سفيان الثوري قال سالت جعفر بن محمد ع عن رجل سرق حرة فباعها قال فقال فيها اربعة حدود اما اولها فسارق تقطع يده والثانية ان كان وطءها جلد الحد وعلي الذي اشتري ان كان وطءها وقد علم ان كان محصنا رجم وان كان غير محصن جلد الحد وان كان لم يعلم فلا شي ء عليه وعليها هي ان كان استكرهها فلا شي ء عليها وان كانت اطاعته جلدت الحد

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع ان امير المءمنين ع اتي برجل قد باع حرا فقطع يده

  علي بن ابراهيم عن ابيه عن محمد بن حفص عن عبد الله بن طلحة قال سالت



 ابا عبد الله ع عن الرجل يبيع الرجل وهما حران يبيع هذا هذا وهذا هذا ويفران من بلد الي بلد فيبيعان انفسهما ويفران باموال الناس فقال تقطع يديهما لانهما سارقان انفسهما واموال الناس

 باب نفي السارق

  محمد بن يحيي عن احمد بن محمد بن عيسي عن ابن محبوب عن علي بن الحسن بن رباط عن ابن مسكان عن الحلبي عن ابي عبد الله ع قال اذا اقيم علي السارق الحد نفي الي بلدة اخري

 باب ما لا يقطع فيه السارق

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال قال امير المءمنين ع لا قطع في ريش يعني الطير كله

  وبهذا الاسناد قال قال النبي ص لا قطع علي من سرق الحجارة يعني الرخام واشباه ذلك

  وبهذا الاسناد قال قضي النبي ص فيمن سرق الثمار في كمه فما اكل منه فلا شي ء عليه وما حمل فيعزر ويغرم قيمته مرتين

  محمد بن يحيي عن احمد بن محمد بن عيسي عن محمد بن يحيي الخزاز عن غياث بن ابراهيم عن ابي عبد الله ع ان عليا ص اتي بالكوفة برجل سرق



  

 حماما فلم يقطعه وقال لا قطع في الطير

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال قال امير المءمنين ع كل مدخل يدخل فيه بغير اذن صاحبه فسرق منه السارق فلا قطع عليه يعني الحمامات والخانات والارحية

  عدة من اصحابنا عن سهل بن زياد عن محمد بن الحسن بن شمون عن عبد الله بن عبد الرحمن الاصم عن مسمع بن عبد الملك عن ابي عبد الله ع ان عليا ع اتي برجل سرق من بيت المال فقال لا يقطع فان له فيه نصيبا

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال قال رسول الله (صلي الله عليه واله وسلم) لا قطع في ثمر ولا كثر والكثر شحم النخل

 باب انه لا يقطع السارق في المجاعة

  محمد بن يحيي وغيره عن محمد بن احمد عن محمد بن عيسي بن عبيد عن زياد القندي عمن ذكره عن ابي عبد الله ع قال لا يقطع السارق في سنة المحل في كل شي ء يءكل مثل الخبز واللحم واشباه ذلك

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال قال لا يقطع السارق في عام سنة يعني في عام مجاعة

  عدة من اصحابنا عن سهل بن زياد ومحمد بن يحيي عن احمد بن محمد جميعا عن علي بن الحكم عن عاصم بن حميد عمن اخبره عن ابي عبد الله ع قال كان امير المءمنين ع لا يقطع السارق في ايام المجاعة



 

 باب حد الصبيان في السرقة

  علي بن ابراهيم عن محمد بن عيسي بن عبيد عن يونس عن عبد الله بن سنان قال سالت ابا عبد الله ع عن الصبي يسرق قال يعفي عنه مرة ومرتين ويعزر في الثالثة فان عاد قطعت اطراف اصابعه فان عاد قطع اسفل من ذلك

  ابو علي الاشعري عن محمد بن عبد الجبار عن صفوان عن العلاء بن رزين عن محمد بن مسلم عن احدهما ع قال سالته عن الصبي يسرق قال اذا سرق مرة وهو صغير عفي عنه فان عاد عفي عنه فان عاد قطع بنانه فان عاد قطع اسفل من ذلك

  عنه عن صفوان عن اسحاق بن عمار قال قلت لابي ابراهيم ع الصبيان اذا اتي بهم علي ع قطع اناملهم من اين قطع فقال من المفصل مفصل الانامل

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن حماد بن عثمان عن الحلبي عن ابي عبد الله ع قال اذا سرق الصبي عفي عنه فان عاد عزر فان عاد قطع اطراف الاصابع فان عاد قطع اسفل من ذلك وقال اتي علي بغلام يشك في احتلامه فقطع اطراف الاصابع

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال اتي علي ع بجارية لم تحض قد سرقت فضربها اسواطا ولم يقطعها



 

  عدة من اصحابنا عن سهل بن زياد ومحمد بن يحيي عن احمد بن محمد جميعا عن ابن محبوب عن عبد الله بن سنان عن ابي عبد الله ع في الصبي يسرق قال يعفي عنه مرة فان عاد قطعت انامله او حكت حتي تدمي فان عاد قطعت اصابعه فان عاد قطع اسفل من ذلك

  حميد بن زياد عن ابن سماعة عن غير واحد من اصحابه عن ابان بن عثمان عن زرارة قال سمعت ابا جعفر ع يقول اتي علي ع بغلام قد سرق فطرف اصابعه ثم قال اما لءن عدت لاقطعنها ثم قال اما انه ما عمله الا رسول الله (صلي الله عليه واله وسلم) وانا

  ابان عن عبد الرحمن بن ابي عبد الله عن ابي عبد الله ع قال اذا سرق الصبي ولم يحتلم قطعت اطراف اصابعه قال وقال ]علي ع[ لم يصنعه الا رسول الله (صلي الله عليه واله وسلم) وانا

  محمد بن يحيي عن محمد بن الحسين عن بعض اصحابه عن العلاء بن رزين عن محمد بن مسلم قال سالت ابا جعفر ع عن الصبي يسرق فقال ان كان له تسع سنين قطعت يده ولا يضيع حد من حدود الله عز وجل

  الحسين بن محمد عن معلي بن محمد عن الوشاء عن ابان عن زرارة قال سمعت ابا جعفر ع يقول اتي علي ع بغلام قد سرق فطرف اصابعه ثم قال اما لءن عدت لاقطعنها قال ثم قال اما انه ما عمله الا رسول الله (صلي الله عليه واله وسلم) وانا

  حميد بن زياد عن عبيد الله بن احمد النهيكي عن ابن ابي عمير عن عدة من اصحابنا عن محمد بن خالد بن عبد الله القسري قال كنت علي المدينة فاتيت بغلام قد سرق فسالت ابا عبد الله ع عنه فقال سله حيث سرق كان يعلم ان عليه في السرقة عقوبة



 فان قال نعم قيل له اي شي ء تلك العقوبة فان لم يعلم ان عليه في السرقة قطعا فخل عنه قال فاخذت الغلام فسالته وقلت له اكنت تعلم ان في السرقة عقوبة قال نعم قلت اي شي ء هو قال الضرب فخليت عنه

 باب ما يجب علي المماليك والمكاتبين من الحد

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن حماد بن عثمان عن الحلبي عن ابي عبد الله ع قال اذا قذف العبد الحر جلد ثمانين وقال هذا من حقوق الناس

  عدة من اصحابنا عن احمد بن محمد عن عثمان بن عيسي عن سماعة قال سالته عن المملوك يفتري علي الحر قال يجلد ثمانين قلت فانه زني قال يجلد خمسين

  محمد بن يحيي عن احمد بن محمد بن عيسي عن محمد بن اسماعيل عن محمد بن الفضيل عن ابي الصباح الكناني عن ابي عبد الله ع قال سالته عن عبد افتري علي حر قال يجلد ثمانين

  محمد بن يحيي عن احمد بن محمد عن ابن محبوب عن الحارث بن الاحول عن بريد عن ابي جعفر ع في الامة تزني قال تجلد نصف حد الحر كان لها زوج او لم يكن

  عدة من اصحابنا عن سهل بن زياد وعلي بن ابراهيم عن ابيه جميعا عن عبد الرحمن بن ابي نجران عن عاصم بن حميد عن محمد بن قيس عن ابي جعفر ع قال قضي امير المءمنين ع في عبد سرق واختان من مال مولاه قال ليس عليه قطع



 

  محمد بن يحيي عن احمد بن محمد عن علي بن الحكم عن العلاء بن رزين عن محمد بن مسلم عن احدهما ع قال سالته عن قول الله تعالي فاذا احصن قال احصانهن ان يدخل بهن قلت ان لم يدخل بهن اما عليهن حد قال بلي

  علي بن ابراهيم عن ابيه عن الاصبغ بن الاصبغ عن محمد بن سليمان عن مروان بن مسلم عن عبيد بن زرارة او عن بريد العجلي الشك من محمد قال قلت لابي عبد الله ع امة زنت قال تجلد خمسين قلت فان عادت قال تجلد خمسين قلت فيجب عليها الرجم في شي ء من الحالات قال اذا زنت ثمان مرات يجب عليها الرجم قلت كيف صار في ثمان مرات قال لان الحر اذا زني اربع مرات واقيم عليه الحد قتل فاذا زنت الامة ثمان مرات رجمت في التاسعة قلت وما العلة في ذلك فقال ان الله رحمها ان يجمع عليها ربق الرق وحد الحر ثم قال وعلي امام المسلمين ان يدفع ثمنه الي مولاه من سهم الرقاب

  محمد بن يحيي عن احمد بن محمد عن ابن محبوب عن ابن بكير عن عنبسة بن مصعب العابد قال قلت لابي عبد الله ع كانت لي جارية فزنت احدها قال نعم ولكن ليكون ذلك في سر لحال السلطان

  محمد بن يحيي عن احمد بن محمد عن علي بن الحكم عن موسي بن بكر عن زرارة عن ابي جعفر ع في مملوك قذف محصنة حرة قال يجلد ثمانين لانه انما يجلد لحقها

  علي بن ابراهيم عن ابيه عن ابن ابي نصر عن حميد بن زياد عن ابي عبد الله ع قال اذا زني العبد ضرب خمسين فان عاد ضرب خمسين فان عاد ضرب خمسين الي ثماني مرات فان زني ثماني مرات قتل وادي الامام قيمته الي مولاه من بيت المال

  علي بن ابراهيم عن ابيه عن ابن ابي نجران عن عاصم بن حميد عن محمد بن قيس عن ابي جعفر ع قال قضي امير المءمنين ع في مملوك طلق امراته تطليقتين



 ثم جامعها بعد فامر رجلا يضربهما ويفرق ما بينهما يجلد كل واحد منهما خمسين جلدة

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن حماد عن الحلبي عن ابي عبد الله ع في المكاتب يزني قال يجلد في الحد بقدر ما اعتق منه

  عدة من اصحابنا عن احمد بن محمد بن خالد عن عثمان بن عيسي عن سماعة قال يجلد المكاتب اذا زني علي قدر ما اعتق منه فان قذف المحصنة فعليه ان يجلد ثمانين حرا كان او مملوكا

  علي بن ابراهيم عن ابيه عن حماد بن عيسي عن حريز عن محمد بن مسلم عن ابي جعفر ع قال يجلد المكاتب علي قدر ما اعتق منه وذكر انه يجلد ببعض السوط ولا يجلد به كله

  محمد بن يحيي عن محمد بن احمد عن محمد بن عيسي عن يوسف بن عقيل عن محمد بن قيس عن ابي جعفر ع قال قضي امير المءمنين ع في مكاتبة زنت قال ينظر ما اخذ من مكاتبتها فيكون فيها حد الحرة وما لم يقض فيكون فيه حد الامة وقال في مكاتبة زنت وقد اعتق منها ثلاثة ارباع وبقي ربع فجلدت ثلاثة ارباع الحد حساب الحرة علي ماءة فذلك خمسة وسبعون سوطا وجلد ربعها حساب خمسين من الامة اثني عشر سوطا ونصفا فذلك سبع وثمانون جلدة ونصف وابي ان يرجمها وان ينفيها قبل ان يبين عتقها

  علي بن ابراهيم عن محمد بن عيسي عن يونس وعن ابيه عن ابن ابي نجران جميعا عن عاصم بن حميد عن محمد بن قيس عن ابي جعفر ع مثله الا ان يونس قال يءخذ السوط من نصفه فيضرب به وكذلك الاقل والاكثر

  علي بن ابراهيم عن ابيه عن ابن محبوب عن حماد عن سليمان بن خالد عن ابي عبد الله ع انه سءل عن المكاتب افتري علي رجل مسلم قال يضرب حد الحر ثمانين ان ادي من مكاتبته شيءا او لم يءد قيل له فان زني وهو مكاتب ولم يءد شيءا من



 مكاتبته قال هو حق الله يطرح عنه من الحد خمسون جلدة ويضرب خمسين

  محمد بن يحيي عن احمد بن محمد عن ابن محبوب عن ابن رءاب عن ضريس الكناسي عن ابي جعفر ع قال العبد اذا اقر علي نفسه عند الامام مرة انه سرق قطعه والامة اذا اقرت علي نفسها عند الامام بالسرقة قطعها

  محمد بن يحيي عن احمد بن محمد عن الحسن بن محبوب عن سيف بن عميرة عن ابي بكر الحضرمي قال سالت ابا عبد الله ع عن عبد مملوك قذف حرا قال يجلد ثمانين هذا من حقوق الناس فاما ما كان من حقوق الله عز وجل فانه يضرب نصف الحد قلت الذي من حقوق الله عز وجل ما هو قال اذا زني او شرب خمرا فهذا من الحقوق التي يضرب فيها نصف الحد

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال قال امير المءمنين ع عبدي اذا سرقني لم اقطعه وعبدي اذا سرق غيري قطعته وعبد الامارة اذا سرق لم اقطعه لانه في ء

  علي بن ابراهيم عن ابيه عن صالح بن سعيد عن الحسين بن خالد عن ابي عبد الله ع انه سءل عن رجل كانت له امة فكاتبها فقالت ما اديت من مكاتبتي فانا به حرة علي حساب ذلك فقال لها نعم فادت بعض مكاتبتها وجامعها مولاها بعد ذلك فقال ان كان استكرهها علي ذلك ضرب من الحد بقدر ما ادت من مكاتبتها ودرء عنه من الحد بقدر ما بقي من مكاتبتها وان كانت تابعته كانت شريكته في الحد ضربت مثل ما يضرب

  علي عن ابيه عن صالح بن سعيد عن يونس عن بعض اصحابنا عن



 ابي عبد الله ع قال المملوك اذا سرق من مواليه لم يقطع فاذا سرق من غير مواليه قطع

  علي عن ابيه عن ابن ابي نجران عن عاصم بن حميد عن محمد بن قيس عن ابي جعفر ع قال قضي امير المءمنين ع في العبيد والاماء اذا زني احدهم ان يجلد خمسين جلدة ان كان مسلما او كافرا او نصرانيا ولا يرجم ولا ينفي

 باب ما يجب علي اهل الذمة من الحدود

  عدة من اصحابنا عن احمد بن محمد بن خالد عن عثمان بن عيسي عن سماعة قال كان امير المءمنين ع يجلد الحر والعبد واليهودي والنصراني في الخمر ومسكر النبيذ ثمانين فقيل ما بال اليهودي والنصراني قال اذا اظهروا ذلك في مصر من الامصار لانهم ليس لهم ان يظهروه

  محمد بن يحيي عن محمد بن احمد عن جعفر بن رزق الله او رجل عن جعفر بن رزق الله قال قدم الي المتوكل رجل نصراني فجر بامراة مسلمة فاراد ان يقيم عليه الحد فاسلم فقال يحيي بن اكثم قد هدم ايمانه شركه وفعله وقال بعضهم يضرب ثلاثة حدود وقال بعضهم يفعل به كذا وكذا فامر المتوكل بالكتاب الي ابي الحسن الثالث ع وسءاله عن ذلك فلما قرا الكتاب كتب يضرب حتي يموت فانكر يحيي بن اكثم وانكر فقهاء العسكر ذلك وقالوا يا امير المءمنين سل عن هذا فانه شي ء لم ينطق به كتاب ولم تجء به سنة فكتب اليه ان فقهاء المسلمين قد انكروا هذا وقالوا لم يجء به سنة ولم ينطق به كتاب فبين لنا لم اوجبت عليه الضرب حتي يموت فكتب بسم الله الرحمن الرحيم ]فلما احسوا[ فلما راوا باسنا قالوا امنا بالله وحده وكفرنا بما كنا به مشركين فلم يك ينفعهم



 ايمانهم لما راوا باسنا سنت الله التي قد خلت في عباده وخسر هنالك الكافرون قال فامر به المتوكل فضرب حتي مات

  محمد بن يحيي عن محمد بن الحسين عن حنان بن سدير عن ابي عبد الله ع قال سالته عن يهودي فجر بمسلمة قال يقتل

  علي بن ابراهيم عن محمد بن عيسي عن يونس عن ابن مسكان عن ابي بصير قال قال حد اليهودي والنصراني والمملوك في الخمر والفرية سواء وانما صولح اهل الذمة علي ان يشربوها في بيوتهم

  يونس عن سماعة قال سالته عن اليهودي والنصراني يقذف صاحبه ملة علي ملة والمجوسي يقذف المسلم قال يجلد الحد

  محمد بن يحيي عن احمد بن محمد عن ابن محبوب عن عباد بن صهيب قال سءل ابو عبد الله ع عن نصراني قذف مسلما فقال له يا زان فقال يجلد ثمانين جلدة لحق المسلم وثمانين سوطا الا سوطا لحرمة الاسلام ويحلق راسه ويطاف به في اهل دينه لكي ينكل غيره

  علي بن ابراهيم عن ابيه عن الوشاء عن عاصم بن حميد عن محمد بن قيس عن ابي جعفر ع قال قضي امير المءمنين ع ان يجلد اليهودي والنصراني في الخمر والنبيذ المسكر ثمانين جلدة اذا اظهروا شربه في مصر من امصار المسلمين وكذلك المجوسي ولم يعرض لهم اذا شربوها في منازلهم وكناءسهم حتي يصيروا بين المسلمين

 باب كراهية قذف من ليس علي الاسلام

  علي بن ابراهيم عن محمد بن عيسي عن يونس عن عبد الله بن سنان عن



 ابي عبد الله ع انه نهي عن قذف من ليس علي الاسلام الا ان يطلع علي ذلك منهم وقال ايسر ما يكون ان يكون قد كذب

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن حماد عن الحلبي عن ابي عبد الله ع انه نهي عن قذف من كان علي غير الاسلام الا ان يكون قد اطلعت علي ذلك منه

  علي عن ابيه عن ابن ابي عمير عن ابي الحسن الحذاء قال كنت عند ابي عبد الله ع فسالني رجل ما فعل غريمك قلت ذاك ابن الفاعلة فنظر الي ابو عبد الله ع نظرا شديدا قال فقلت جعلت فداك انه مجوسي امه اخته فقال اوليس ذلك في دينهم نكاحا

 باب ما يجب فيه التعزير في جميع الحدود

  ابو علي الاشعري عن محمد بن عبد الجبار عن صفوان بن يحيي عن اسحاق بن عمار قال سالت ابا عبد الله ع عن التعزير كم هو قال بضعة عشر سوطا ما بين العشرة الي العشرين

  علي بن ابراهيم عن محمد بن عيسي عن يونس عن عبد الله بن سنان قال سالت ابا عبد الله ع عن رجلين افتري كل واحد منهما علي صاحبه فقال يدرا عنهما الحد ويعزران

  عنه عن عبد الرحمن بن ابي عبد الله قال سالت ابا عبد الله ع عن رجل سب رجلا بغير قذف يعرض به هل يجلد قال عليه تعزير

  حميد بن زياد عن الحسن بن محمد بن سماعة عن جعفر بن سماعة عن ابان بن



 

 عثمان عن اسماعيل بن الفضل قال سالت ابا عبد الله ع عن الافتراء علي اهل الذمة واهل الكتاب هل يجلد المسلم الحد في الافتراء عليهم قال لا ولكن يعزر

  الحسين بن محمد عن معلي بن محمد عن الحسن بن علي عن حماد بن عثمان قال قلت لابي عبد الله ع كم التعزير فقال دون الحد قال قلت دون ثمانين قال فقال لا ولكن دون الاربعين فانه حد المملوك قال قلت وكم ذلك قال قال علي قدر ما يري الوالي من ذنب الرجل وقوة بدنه

  عدة من اصحابنا عن احمد بن محمد بن عيسي عن الحسين بن سعيد عن النضر بن سويد عن القاسم بن سليمان عن جراح المداءني عن ابي عبد الله ع قال اذا قال الرجل للرجل انت خبيث وانت خنزير فليس فيه حد ولكن فيه موعظة وبعض العقوبة

  علي بن ابراهيم عن محمد بن عيسي عن يونس عن زرعة عن سماعة قال سالته عن شهود الزور قال فقال يجلدون حدا ليس له وقت وذلك الي الامام ويطاف بهم حتي يعرفهم الناس واما قول الله عز وجل ولا تقبلوا لهم شهادة ابدا... الا الذين تابوا قال قلت كيف تعرف توبته قال يكذب نفسه علي رءوس الناس حتي يضرب ويستغفر ربه واذا فعل ذلك فقد ظهرت توبته

  علي بن ابراهيم عن ابيه عن صالح بن سعيد عن بعض اصحابه عن منصور بن حازم عن ابي عبد الله ع قال سالته عن رجل تزوج ذمية علي مسلمة ولم يستامرها قال ويفرق بينهما قال فقلت فعليه ادب قال نعم اثنا عشر سوطا ونصف ثمن حد الزاني وهو صاغر قلت فان رضيت المراة الحرة المسلمة بفعله بعد ما كان فعل قال لا يضرب ولا يفرق بينهما يبقيان علي النكاح الاول

  محمد بن يحيي عن محمد بن احمد عن يعقوب بن يزيد عن يحيي بن المبارك عن عبد الله بن جبلة عن ابي جميلة عن اسحاق بن عمار وسماعة عن ابي بصير قال قلت



 

 اكل الربا بعد البينة قال يءدب فان عاد ادب فان عاد قتل

  وبهذا الاسناد عن اسحاق بن عمار عن ابي عبد الله ع انه قال اكل الميتة والدم ولحم الخنزير عليه ادب فان عاد ادب فان عاد ادب وليس عليه حد

  علي بن ابراهيم عن صالح بن السندي عن جعفر بن بشير عن الحسين بن ابي العلاء عن ابي مخلد السراج عن ابي عبد الله ع انه قال قضي امير المءمنين ع في رجل دعا اخر ابن المجنون فقال له الاخر انت ابن المجنون فامر الاول ان يجلد صاحبه عشرين جلدة وقال له اعلم انه مستحق مثلها عشرين فلما جلده اعطي المجلود السوط فجلده نكالا ينكل بهما

  علي بن محمد بن بندار عن ابراهيم بن اسحاق الاحمر عن عبد الله بن حماد الانصاري عن مفضل بن عمر عن ابي عبد الله ع في رجل اتي امراته وهي صاءمة وهو صاءم قال ان كان قد استكرهها فعليه كفارتان وان لم يستكرهها فعليه كفارة وعليها كفارة وان كان اكرهها فعليه ضرب خمسين سوطا نصف الحد وان كانت طاوعته ضرب خمسة وعشرين سوطا وضربت خمسة وعشرين سوطا

  علي بن ابراهيم عن ابيه عن صالح بن سعيد عن اسماعيل بن الفضل الهاشمي قال سالت ابا الحسن ع عن رجل اتي اهله وهي حاءض قال يستغفر الله ولا يعود قلت فعليه ادب قال نعم خمسة وعشرين سوطا ربع حد الزاني وهو صاغر لانه اتي سفاحا

  محمد بن يحيي عن احمد بن محمد بن عيسي عن ابن محبوب عن ابي ولاد الحناط قال سمعت ابا عبد الله ع يقول اتي امير المءمنين ع برجلين قد قذف كل واحد منهما صاحبه بالزني في بدنه فدرا عنهما الحد وعزرهما

  علي بن ابراهيم عن ابيه عن القاسم بن محمد المنقري عن النعمان بن عبد السلام عن ابي حنيفة قال سالت ابا عبد الله ع عن رجل قال لاخر يا فاسق قال لا حد عليه ويعزر



 

  محمد بن يحيي عن احمد بن محمد عن ابن محبوب عن ابي ايوب عن سماعة قال شهود الزور يجلدون حدا ليس له وقت ذلك الي الامام ويطاف بهم حتي يعرفوا فلا يعودوا قلت له فان تابوا واصلحوا تقبل شهادتهم بعد قال اذا تابوا تاب الله عليهم وقبلت شهادتهم بعد

  الحسين بن محمد عن معلي بن محمد عن الوشاء عن ابان عن عبد الرحمن بن ابي عبد الله عن ابي عبد الله ع في رجل سب رجلا بغير قذف عرض به هل عليه حد قال عليه تعزير

  حميد بن زياد عن الحسن بن محمد بن سماعة عن احمد بن الحسن الميثمي عن ابان بن عثمان عن اسماعيل بن الفضل قال سالت ابا عبد الله ع عن الافتراء علي اهل الذمة هل يجلد المسلم الحد في الافتراء عليهم قال لا ولكن يعزر

  علي بن ابراهيم عن ابيه عن ابن فضال عن يونس بن يعقوب عن ابي مريم عن ابي جعفر ع قال قضي امير المءمنين ع في الهجاء التعزير

  علي بن ابراهيم عن ابيه عن محمد بن جعفر عن ابي حبيب عن محمد بن مسلم قال سالت ابا جعفر ع عن الرجل ياتي المراة وهي حاءض قال يجب عليه في استقبال الحيض دينار وفي استدباره نصف دينار قال قلت جعلت فداك يجب عليه شي ء من الحد قال نعم خمسة وعشرين سوطا ربع حد الزاني لانه اتي سفاحا

 باب الرجل يجب عليه الحد وهو مريض او به قروح

  محمد بن يحيي عن احمد بن محمد بن عيسي عن ابن محبوب ومحمد بن اسماعيل بن بزيع عن حنان بن سدير عن يحيي بن عباد المكي قال قال لي سفيان الثوري اني اري لك من ابي عبد الله ع منزلة فسله عن رجل زني وهو مريض ان اقيم عليه الحد مات ما تقول فيه فسالته فقال هذه المسالة من تلقاء نفسك او قال لك انسان ان تسالني عنها فقلت سفيان الثوري سالني ان اسالك فقال ابو عبد الله ع ان رسول الله ص



 اتي برجل احتبن مستسقي البطن قد بدت عروق فخذيه وقد زني بامراة مريضة فامر رسول الله (صلي الله عليه واله وسلم) بعذق فيه ماءة شمراخ فضرب به الرجل ضربة وضربت به المراة ضربة ثم خلي سبيلهما ثم قرا هذه الاية وخذ بيدك ضغثا فاضرب به ولا تحنث

  علي بن ابراهيم عن ابيه عن يحيي بن ابي عمران عن يونس عن اسحاق بن عمار قال سالت احدهما ع عن حد الاخرس والاصم والاعمي فقال عليهم الحدود اذا كانوا يعقلون ما ياتون

  محمد بن يحيي عن احمد بن محمد عن ابي همام عن محمد بن سعيد عن السكوني عن ابي عبد الله ع قال اتي امير المءمنين ع برجل اصاب حدا وبه قروح في جسده كثيرة فقال امير المءمنين ع اخروه حتي يبرا لا تنكءوها عليه فتقتلوه

  علي بن ابراهيم عن محمد بن عيسي عن يونس عن ابان بن عثمان عن ابي العباس عن ابي عبد الله ع قال قال اتي رسول الله (صلي الله عليه واله وسلم) برجل دميم قصير قد سقي بطنه وقد درت عروق بطنه قد فجر بامراة فقالت المراة ما علمت به الا وقد دخل علي فقال له رسول الله (صلي الله عليه واله وسلم) ازنيت فقال نعم ولم يكن احصن فصعد رسول الله (صلي الله عليه واله وسلم) بصره وخفضه ثم دعا بعذق فعده ماءة ثم ضربه بشماريخه

  عدة من اصحابنا عن سهل بن زياد عن محمد بن الحسن بن شمون عن عبد الله بن عبد الرحمن الاصم عن مسمع بن عبد الملك عن ابي عبد الله ع ان امير المءمنين ع اتي برجل اصاب حدا وبه قروح ومرض واشباه ذلك فقال امير المءمنين ع اخروه حتي يبرا لا تنكا قروحه عليه فيموت ولكن اذا برا حددناه



 باب حد المحارب

  محمد بن يحيي عن احمد بن محمد عن علي بن الحكم وحميد بن زياد عن ابن سماعة عن غير واحد من اصحابه جميعا عن ابان بن عثمان عن ابي صالح عن ابي عبد الله ع قال قدم علي رسول الله قوم من بني ضبة مرضي فقال لهم رسول الله (صلي الله عليه واله وسلم) اقيموا عندي فاذا براتم بعثتكم في سرية فقالوا اخرجنا من المدينة فبعث بهم الي ابل الصدقة يشربون من ابوالها وياكلون من البانها فلما برءوا واشتدوا قتلوا ثلاثة ممن كانوا في الابل فبلغ رسول الله ص فبعث اليهم عليا ع فهم في واد قد تحيروا ليس يقدرون ان يخرجوا منه قريبا من ارض اليمن فاسرهم وجاء بهم الي رسول الله ص فنزلت هذه الاية عليه انما جزاء الذين يحاربون الله ورسوله ويسعون في الارض فسادا ان يقتلوا او يصلبوا او تقطع ايديهم وارجلهم من خلاف او ينفوا من الارض فاختار رسول الله (صلي الله عليه واله وسلم) القطع فقطع ايديهم وارجلهم من خلاف

  علي بن ابراهيم عن ابيه وابو علي الاشعري عن محمد بن عبد الجبار جميعا عن صفوان بن يحيي عن طلحة النهدي عن سورة بن كليب قال قلت لابي عبد الله ع رجل يخرج من منزله يريد المسجد او يريد الحاجة فيلقاه رجل او يستقفيه فيضربه وياخذ ثوبه قال اي شي ء يقول فيه من قبلكم قلت يقولون هذه دغارة معلنة وانما المحارب في قري مشركية فقال ايهما اعظم حرمة دار الاسلام او دار الشرك قال فقلت دار الاسلام فقال هءلاء من اهل هذه الاية انما جزاء الذين يحاربون الله ورسوله الي اخر الاية

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن جميل بن دراج قال سالت ابا عبد الله ع عن قول الله عز وجل انما جزاء الذين يحاربون الله ورسوله ويسعون



 في الارض فسادا ان يقتلوا او يصلبوا او تقطع ايديهم الي اخر الاية فقلت اي شي ء عليهم من هذه الحدود التي سمي الله عز وجل قال ذلك الي الامام ان شاء قطع وان شاء صلب وان شاء نفي وان شاء قتل قلت النفي الي اين قال ينفي من مصر الي مصر اخر وقال ان عليا ع نفي رجلين من الكوفة الي البصرة

  علي بن ابراهيم عن ابيه عن حنان عن ابي عبد الله ع في قول الله عز وجل انما جزاء الذين يحاربون الله ورسوله الي اخر الاية قال لا يبايع ولا يءوي ولا يتصدق عليه

  عنه عن محمد بن عيسي عن يونس عن يحيي الحلبي عن بريد بن معاوية قال سال رجل ابا عبد الله ع عن قول الله عز وجل انما جزاء الذين يحاربون الله ورسوله قال ذلك الي الامام يفعل به ما يشاء قلت فمفوض ذلك اليه قال لا ولكن نحو الجناية

  عدة من اصحابنا عن سهل بن زياد عن الحسن بن محبوب عن علي بن رءاب عن ضريس الكناسي عن ابي جعفر ع قال من حمل السلاح بالليل فهو محارب الا ان يكون رجلا ليس من اهل الريبة

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع ان امير المءمنين ع صلب رجلا بالحيرة ثلاثة ايام ثم انزله يوم الرابع فصلي عليه ودفنه

  علي عن ابيه عن عمرو بن عثمان عن عبيد الله بن اسحاق المداءني عن ابي الحسن الرضا ع قال سءل عن قول الله عز وجل انما جزاء الذين يحاربون الله ورسوله ويسعون في الارض فسادا ان يقتلوا الاية فما الذي اذا فعله استوجب واحدة من هذه



 الاربع فقال اذا حارب الله ورسوله وسعي في الارض فسادا فقتل قتل به وان قتل واخذ المال قتل وصلب وان اخذ المال ولم يقتل قطعت يده ورجله من خلاف وان شهر السيف فحارب الله ورسوله وسعي في الارض فسادا ولم يقتل ولم ياخذ المال ينفي من الارض قلت كيف ينفي وما حد نفيه قال ينفي من المصر الذي فعل فيه ما فعل الي مصر غيره ويكتب الي اهل ذلك المصر انه منفي فلا تجالسوه ولا تبايعوه ولا تناكحوه ولا تءاكلوه ولا تشاربوه فيفعل ذلك به سنة فان خرج من ذلك المصر الي غيره كتب اليهم بمثل ذلك حتي تتم السنة قلت فان توجه الي ارض الشرك ليدخلها قال ان توجه الي ارض الشرك ليدخلها قوتل اهلها

  علي عن محمد بن عيسي عن يونس عن محمد بن سليمان عن عبيد الله بن اسحاق عن ابي الحسن ع مثله الا انه قال في اخره يفعل به ذلك سنة فانه سيتوب قبل ذلك وهو صاغر قال قلت فان ام ارض الشرك يدخلها قال يقتل

  علي بن ابراهيم عن ابيه عن محمد بن حفص عن عبد الله بن طلحة عن ابي عبد الله ع في قول الله عز وجل انما جزاء الذين يحاربون الله ورسوله ويسعون في الارض فسادا ان يقتلوا الاية هذا نفي المحاربة غير هذا النفي قال يحكم عليه الحاكم بقدر ما عمل وينفي ويحمل في البحر ثم يقذف به لو كان النفي من بلد الي بلد كان يكون اخراجه من بلد الي بلد اخر عدل القتل والصلب والقطع ولكن يكون حدا يوافق القطع والصلب

  علي بن محمد عن علي بن الحسن التيمي عن علي بن اسباط عن داود بن ابي يزيد عن عبيدة بن بشير الخثعمي قال سالت ابا عبد الله ع عن قاطع الطريق وقلت ان الناس يقولون ان الامام فيه مخير اي شي ء شاء صنع قال ليس اي شي ء شاء صنع ولكنه يصنع بهم علي قدر جناياتهم من قطع الطريق فقتل واخذ المال قطعت يده ورجله وصلب ومن قطع الطريق فقتل ولم ياخذ المال قتل ومن قطع الطريق واخذ المال ولم يقتل قطعت يده ورجله ]من خلافه[ ومن قطع الطريق ولم ياخذ مالا ولم يقتل نفي من الارض



 

 

  محمد بن يحيي عن احمد بن محمد عن ابن محبوب عن ابي ايوب عن محمد بن مسلم عن ابي جعفر ع قال من شهر السلاح في مصر من الامصار فعقر اقتص منه ونفي من تلك البلدة ومن شهر السلاح في غير الامصار وضرب وعقر واخذ المال ولم يقتل فهو محارب فجزاءه جزاء المحارب وامره الي الامام ان شاء قتله و]ان شاء[ صلبه وان شاء قطع يده ورجله قال وان ضرب وقتل واخذ المال فعلي الامام ان يقطع يده اليمني بالسرقة ثم يدفعه الي اولياء المقتول فيتبعونه بالمال ثم يقتلونه قال فقال ابو عبيدة اصلحك الله ارايت ان عفا عنه اولياء المقتول قال فقال ابو جعفر ع ان عفوا عنه فان علي الامام ان يقتله لانه قد حارب وقتل وسرق قال فقال ابو عبيدة ارايت ان اراد اولياء المقتول ان ياخذوا منه الدية ويدعونه الهم ذلك قال فقال لا عليه القتل

  عدة من اصحابنا عن سهل بن زياد عن احمد بن محمد بن ابي نصر عن داود الطاءي عن رجل من اصحابنا عن ابي عبد الله ع قال سالته عن المحارب فقلت له ان اصحابنا يقولون ان الامام مخير فيه ان شاء قطع وان شاء صلب وان شاء قتل فقال لا ان هذه اشياء محدودة في كتاب الله عز وجل فاذا ما هو قتل واخذ قتل وصلب واذا قتل ولم ياخذ قتل واذا اخذ ولم يقتل قطع واذا هو فر ولم يقدر عليه ثم اخذ قطع الا ان يتوب فان تاب لم يقطع

 باب من زني او سرق او شرب الخمر بجهالة لا يعلم انها محرمة

  علي بن ابراهيم عن محمد بن عيسي بن عبيد عن يونس عن ابي ايوب الخزاز عن محمد بن مسلم قال قلت لابي جعفر ع رجل دعوناه الي جملة ما نحن عليه من جملة الاسلام فاقر به ثم شرب الخمر وزني واكل الربا ولم يتبين له شي ء من الحلال والحرام اقيم عليه الحد اذا جهله قال لا الا ان تقوم عليه بينة انه قد كان اقر بتحريمها



 

  علي عن ابيه عن ابن ابي عمير عمن رواه عن ابي عبيدة الحذاء قال قال ابو جعفر ع لو وجدت رجلا من العجم اقر بجملة الاسلام لم ياته شي ء من التفسير زني او سرق او شرب الخمر لم اقم عليه الحد اذا جهله الا ان تقوم عليه بينة انه قد اقر بذلك وعرفه

  علي عن ابيه عن ابن ابي عمير عن جميل عن بعض اصحابه عن احدهما ع في رجل دخل في الاسلام فشرب خمرا وهو جاهل قال لم اكن اقيم عليه الحد اذا كان جاهلا ولكن اخبره بذلك واعلمه فان عاد اقمت عليه الحد

  عدة من اصحابنا عن احمد بن ابي عبد الله عن عمرو بن عثمان عن علي بن ابي حمزة عن ابي بصير عن ابي عبد الله ع قال لقد قضي امير المءمنين ص بقضية ما قضي بها احد كان قبله وكانت اول قضية قضي بها بعد رسول الله ص وذلك انه لما قبض رسول الله (صلي الله عليه واله وسلم) وافضي الامر الي ابي بكر اتي برجل قد شرب الخمر فقال له ابو بكر اشربت الخمر فقال الرجل نعم فقال ولم شربتها وهي محرمة فقال انني لما اسلمت ومنزلي بين ظهراني قوم يشربون الخمر ويستحلونها ولو اعلم انها حرام فاجتنبها قال فالتفت ابو بكر الي عمر فقال ما تقول يا ابا حفص في امر هذا الرجل فقال معضلة وابو الحسن لها فقال ابو بكر يا غلام ادع لنا عليا قال عمر بل يءتي الحكم في منزله فاتوه ومعه سلمان الفارسي فاخبره بقصة الرجل فاقتص عليه قصته فقال علي ع لابي بكر ابعث معه من يدور به علي مجالس المهاجرين والانصار فمن كان تلا عليه اية التحريم فليشهد عليه فان لم يكن تلا عليه اية التحريم فلا شي ء عليه ففعل ابو بكر بالرجل ما قال علي ع فلم يشهد عليه احد فخلي سبيله فقال سلمان لعلي ع لقد ارشدتهم فقال علي ع انما اردت ان اجدد تاكيد هذه الاية في وفيهم افمن يهدي الي الحق احق ان يتبع امن لا يهدي الا ان يهدي فما لكم كيف تحكمون



 باب من وجبت عليه حدود احدها القتل

  محمد بن يحيي عن احمد بن محمد عن علي بن الحكم عن العلاء بن رزين عن محمد بن مسلم عن ابي عبد الله ع في الرجل يءخذ وعليه حدود احدها القتل فقال كان علي ع يقيم عليه الحدود ثم يقتله ولا يخالف علي ع

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن حماد بن عثمان عن ابي عبد الله ع في الرجل يكون عليه الحدود منها القتل قال تقام عليه الحدود ثم يقتل

  عدة من اصحابنا عن احمد بن محمد بن عيسي عن الحسين بن سعيد عن اخيه الحسن عن زرعة بن محمد عن سماعة عن ابي عبد الله ع قال قضي امير المءمنين ع فيمن قتل وشرب خمرا وسرق فاقام عليه الحد فجلده لشربه الخمر وقطع يده في سرقته وقتله بقتله

  علي بن ابراهيم عن ابيه عن ابن محبوب عن عبد الله بن سنان وابن بكير عن ابي عبد الله ع في رجل اجتمعت عليه حدود فيها القتل قال يبدا بالحدود التي هي دون القتل ثم يقتل بعد

 باب من اتي حدا فلم يقم عليه الحد حتي تاب

  محمد بن يحيي عن احمد بن محمد عن علي بن حديد وابن ابي عمير جميعا عن جميل بن دراج عن رجل عن احدهما ع في رجل سرق او شرب الخمر او زني فلم يعلم بذلك منه ولم يءخذ حتي تاب وصلح فقال اذا صلح وعرف منه امر جميل لم يقم عليه الحد



 

 قال محمد بن ابي عمير قلت فان كان امرا قريبا لم يقم قال لو كان خمسة اشهر او اقل منه وقد ظهر امر جميل لم يقم عليه الحدود

 وروي ذلك عن بعض اصحابنا عن احدهما ع

  ابو علي الاشعري عن محمد بن عبد الجبار عن صفوان بن يحيي عن بعض اصحابه عن ابي بصير عن ابي عبد الله ع في رجل اقيمت عليه البينة بانه زني ثم هرب قبل ان يضرب قال ان تاب فما عليه شي ء وان وقع في يد الامام اقام عليه الحد وان علم مكانه بعث اليه

 باب العفو عن الحدود

  عدة من اصحابنا عن احمد بن محمد بن خالد عن عثمان بن عيسي عن سماعة بن مهران عن ابي عبد الله ع قال من اخذ سارقا فعفا عنه فذاك له فان رفع الي الامام قطعه فان قال الذي سرق منه انا اهب له لم يدعه الامام حتي يقطعه اذا رفع اليه وانما الهبة قبل ان يرفع الي الامام وذلك قول الله عز وجل والحافظون لحدود الله فاذا انتهي الحد الي الامام فليس لاحد ان يتركه

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن حماد عن الحلبي عن ابي عبد الله ع قال سالته عن الرجل ياخذ اللص يرفعه او يتركه فقال ان صفوان بن امية كان مضطجعا في المسجد الحرام فوضع رداءه وخرج يهريق الماء فوجد رداءه قد سرق حين رجع اليه فقال من ذهب برداءي فذهب يطلبه فاخذ صاحبه فرفعه الي النبي ص فقال النبي ص اقطعوا يده فقال صفوان اتقطع يده من اجل رداءي يا رسول الله قال نعم قال فانا اهبه له فقال رسول الله (صلي الله عليه واله وسلم) فهلا كان هذا قبل ان ترفعه الي قلت فالامام بمنزلته اذا رفع اليه قال نعم قال وسالته عن العفو قبل ان ينتهي الي الامام فقال حسن



 

  محمد بن يحيي عن احمد بن محمد بن عيسي عن علي بن الحكم عن الحسين بن ابي العلاء قال سالت ابا عبد الله ع عن الرجل ياخذ اللص يدعه افضل ام يرفعه فقال ان صفوان بن امية كان متكءا في المسجد علي رداءه فقام يبول فرجع وقد ذهب به فطلب صاحبه فوجده فقدمه الي رسول الله ص فقال اقطعوا يده فقال صفوان يا رسول الله انا اهب ذلك له فقال له رسول الله (صلي الله عليه واله وسلم) الا كان ذلك قبل ان تنتهي به الي قال وسالته عن العفو عن الحدود قبل ان ينتهي الي الامام فقال حسن

  عدة من اصحابنا عن سهل بن زياد وعلي بن ابراهيم عن ابيه جميعا عن ابن محبوب عن ابن رءاب عن ضريس الكناسي عن ابي جعفر ع قال لا يعفي عن الحدود التي لله دون الامام فاما ما كان من حق الناس في حد فلا باس ان يعفي عنه دون الامام

  محمد بن يحيي عن احمد بن محمد عن ابن محبوب عن العلاء عن محمد بن مسلم عن ابي جعفر ع قال قلت له رجل جني علي اعفو عنه او ارفعه الي السلطان قال هو حقك ان عفوت عنه فحسن وان رفعته الي الامام فانما طلبت حقك وكيف لك بالامام

  ابن محبوب عن ابي ايوب عن سماعة قال سالت ابا عبد الله ع عن الرجل يقذف الرجل بالزني فيعفو عنه ويجعله من ذلك في حل ثم انه بعد يبدو له في ان يقدمه حتي يجلده قال فقال ليس له حد بعد العفو فقلت له ارايت ان هو قال يا ابن الزانية فعفا عنه وترك ذلك لله فقال ان كانت امه حية فليس له ان يعفو العفو الي امه متي شاءت اخذت بحقها قال فان كانت امه قد ماتت فانه ولي امرها يجوز عفوه



 باب الرجل يعفو عن الحد ثم يرجع فيه والرجل يقول للرجل يا ابن الفاعلة ولامه وليان

  عدة من اصحابنا عن احمد بن محمد بن عيسي عن الحسين بن سعيد عن اخيه الحسن عن زرعة بن محمد عن سماعة بن مهران عن ابي عبد الله ع قال سالته عن الرجل يفتري علي الرجل فيعفو عنه ثم يريد ان يجلده بعد العفو قال ليس له ان يجلده بعد العفو

  علي بن ابراهيم عن ابيه ومحمد بن يحيي عن احمد بن محمد بن عيسي جميعا عن الحسن بن محبوب عن هشام بن سالم عن عمار الساباطي قال قلت لابي عبد الله ع لو ان رجلا قال لرجل يا ابن الفاعلة يعني الزني وكان للمقذوف اخ لابيه وامه فعفا احدهما عن القاذف واراد احدهما ان يقدمه الي الوالي ويجلده اكان ذلك له فقال اليس امه هي ام الذي عفا قلت نعم ثم قال ان العفو اليهما جميعا اذا كانت امهما ميتة فالامر اليهما في العفو فان كانت حية فالامر اليها في العفو

 باب انه لا حد لمن لا حد عليه

  علي بن ابراهيم عن ابيه عن ابن محبوب عن اسحاق بن عمار عن ابي عبد الله ع قال لا حد لمن لا حد عليه

 وتفسير ذلك لو ان مجنونا قذف رجلا لم يكن عليه شي ء ولو قذفه رجل لم يكن عليه حد

  ابن محبوب عن ابي ايوب عن فضيل بن يسار قال سمعت ابا عبد الله ع



 يقول لا حد لمن لا حد عليه يعني لو ان مجنونا قذف رجلا لم ار عليه شيءا ولو قذفه رجل فقال له يا زان لم يكن عليه حد

 باب انه لا يشفع في حد

  محمد بن يحيي عن احمد بن محمد عن علي بن الحكم عن ابان بن عثمان عن سلمة عن ابي عبد الله ع قال كان اسامة بن زيد يشفع في الشي ء الذي لا حد فيه فاتي رسول الله (صلي الله عليه واله وسلم) بانسان قد وجب عليه حد فشفع له اسامة فقال له رسول الله (صلي الله عليه واله وسلم) لا يشفع في حد

  عدة من اصحابنا عن سهل بن زياد ومحمد بن يحيي عن احمد بن محمد بن عيسي وعلي بن ابراهيم عن ابيه جميعا عن ابن محبوب عن ابن رءاب عن محمد بن قيس عن ابي جعفر ع قال كان لام سلمة زوجة النبي ص امة فسرقت من قوم فاتي بها النبي ص فكلمته ام سلمة فيها فقال النبي ص يا ام سلمة هذا حد من حدود الله عز وجل لا يضيع فقطعها رسول الله (صلي الله عليه واله وسلم)

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال قال امير المءمنين ع لا يشفعن احد في حد اذا بلغ الامام فانه يملكه واشفع فيما لم يبلغ الامام اذا رايت الندم واشفع عند الامام في غير الحد مع الرجوع من المشفوع له ولا تشفع في حق امرء مسلم ولا غيره الا باذنه

  عدة من اصحابنا عن سهل بن زياد عن ابن ابي نجران عن مثني الحناط عن ابي عبد الله ع قال قال رسول الله (صلي الله عليه واله وسلم) لاسامة بن زيد يا اسامة لا تشفع في حد



 باب انه لا كفالة في حد

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال قال رسول الله (صلي الله عليه واله وسلم) لا كفالة في حد

 باب ان الحد لا يورث

  محمد بن يحيي عن احمد بن محمد بن عيسي عن ابن محبوب عن هشام بن سالم عن عمار الساباطي عن ابي عبد الله ع قال سمعته يقول ان الحد لا يورث كما تورث الدية والمال والعقار ولكن من قام به من الورثة فطلبه فهو وليه ومن تركه فلم يطلبه فلا حق له وذلك مثل رجل قذف رجلا وللمقذوف اخ فان عفا عنه احدهما كان للاخر ان يطلبه بحقه لانها امهما جميعا والعفو لهما جميعا

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال الحد لا يورث

 باب انه لا يمين في حد

  عدة من اصحابنا عن سهل بن زياد عن احمد بن محمد بن ابي نصر عن بعض اصحابنا عن ابي عبد الله ع قال اتي رجل امير المءمنين ع برجل فقال هذا قد قذفني ولم تكن له بينة فقال يا امير المءمنين استحلفه فقال لا يمين في حد ولا قصاص في عظم



 باب حد المرتد

  علي بن ابراهيم عن ابيه وعدة من اصحابنا عن سهل بن زياد جميعا عن ابن محبوب عن العلاء بن رزين عن محمد بن مسلم قال سالت ابا جعفر ع عن المرتد فقال من رغب عن الاسلام وكفر بما انزل الله علي محمد ص بعد اسلامه فلا توبة له وقد وجب قتله وبانت منه امراته ويقسم ما ترك علي ولده

  محمد بن يحيي عن احمد بن محمد عن علي بن الحكم عن موسي بن بكر عن الفضيل بن يسار عن ابي عبد الله ع ان رجلا من المسلمين تنصر فاتي به امير المءمنين ع فاستتابه فابي عليه فقبض علي شعره ثم قال طءوا يا عباد الله فوطء حتي مات

  علي بن ابراهيم عن ابيه عن ابن محبوب عن غير واحد من اصحابنا عن ابي جعفر وابي عبد الله ع في المرتد يستتاب فان تاب والا قتل والمراة اذا ارتدت عن الاسلام استتيبت فان تابت ورجعت والا خلدت في السجن وضيق عليها في حبسها

  عدة من اصحابنا عن احمد بن محمد بن عيسي عن الحسين بن سعيد عن النضر بن سويد عن القاسم بن سليمان عن عبيد بن زرارة عن ابي عبد الله ع في الصبي يختار الشرك وهو بين ابويه قال لا يترك وذلك اذا كان احد ابويه نصرانيا

  محمد بن يحيي عن احمد بن محمد بن عيسي عن علي بن حديد عن جميل بن دراج وغيره عن احدهما ع في رجل رجع عن الاسلام قال يستتاب فان تاب والا قتل قيل لجميل فما تقول ان تاب ثم رجع عن الاسلام قال يستتاب قيل فما تقول ان تاب ثم رجع قال لم اسمع في هذا شيءا ولكنه عندي بمنزلة الزاني الذي يقام عليه الحد مرتين ثم يقتل بعد ذلك وقال روي اصحابنا ان الزاني يقتل في المرة الثالثة



 

  عدة من اصحابنا عن سهل بن زياد عن محمد بن الحسن بن شمون عن عبد الله بن عبد الرحمن الاصم عن مسمع عن ابي عبد الله ع ان امير المءمنين ع اتي بزنديق فضرب علاوته

  حميد بن زياد عن الحسن بن محمد بن سماعة عن غير واحد من اصحابه عن ابان بن عثمان عن بعض اصحابه عن ابي عبد الله ع في الصبي اذا شب فاختار النصرانية واحد ابويه نصراني او مسلمين قال لا يترك ولكن يضرب علي الاسلام

  محمد بن يحيي عن احمد بن محمد عن ابن ابي عمير عن هشام بن سالم عن ابي عبد الله قال اتي قوم امير المءمنين ع فقالوا السلام عليك يا ربنا فاستتابهم فلم يتوبوا فحفر لهم حفيرة واوقد فيها نارا وحفر حفيرة اخري الي جانبها وافضي بينهما فلما لم يتوبوا القاهم في الحفيرة واوقد في الحفيرة الاخري حتي ماتوا

  ابو علي الاشعري عن محمد بن سالم عن احمد بن النضر عن عمرو بن شمر عن جابر عن ابي عبد الله ع قال اتي امير المءمنين ص برجل من بني ثعلبة قد تنصر بعد اسلامه فشهدوا عليه فقال له امير المءمنين ع ما يقول هءلاء الشهود قال صدقوا وانا ارجع الي الاسلام فقال اما انك لو كذبت الشهود لضربت عنقك وقد قبلت منك ولا تعد فانك ان رجعت لم اقبل منك رجوعا بعده

  محمد بن يحيي عن العمركي بن علي النيسابوري عن علي بن جعفر عن اخيه ابي الحسن ع قال سالته عن مسلم تنصر قال يقتل ولا يستتاب قلت فنصراني اسلم ثم ارتد عن الاسلام قال يستتاب فان رجع والا قتل

  عدة من اصحابنا عن سهل بن زياد وعلي بن ابراهيم عن ابيه ومحمد بن



 يحيي عن احمد بن محمد جميعا عن ابن محبوب عن هشام بن سالم عن عمار الساباطي قال سمعت ابا عبد الله ع يقول كل مسلم بين مسلمين ارتد عن الاسلام وجحد محمدا ص نبوته وكذبه فان دمه مباح لكل من سمع ذلك منه وامراته باءنة منه يوم ارتد فلا تقربه ويقسم ماله علي ورثته وتعتد امراته ]بعد[ عدة المتوفي عنها زوجها وعلي الامام ان يقتله ولا يستتيبه

  علي بن ابراهيم عن محمد بن عيسي عن يونس عن ابي بصير عن ابي عبد الله ع قال من اخذ في شهر رمضان وقد افطر فرفع الي الامام يقتل في الثالثة

  محمد بن يحيي عن احمد بن محمد عن ابن فضال عن حماد بن عثمان عن ابن ابي يعفور قال قلت لابي عبد الله ع ان بزيعا يزعم انه نبي فقال ان سمعته يقول ذلك فاقتله قال فجلست له غير مرة فلم يمكني ذلك

  علي بن ابراهيم عن محمد بن عيسي عن عبد الرحمن الابزاري الكناسي عن الحارث بن المغيرة قال قلت لابي عبد الله ع ارايت لو ان رجلا اتي النبي ص فقال والله ما ادري انبي انت ام لا كان يقبل منه قال لا ولكن كان يقتله انه لو قبل ذلك منه ما اسلم منافق ابدا

  عدة من اصحابنا عن سهل بن زياد عن محمد بن الحسن بن شمون عن عبد الله بن عبد الرحمن عن مسمع بن عبد الملك عن ابي عبد الله ع قال اتي امير المءمنين ع بزنديق فضرب علاوته فقيل له ان له مالا كثيرا فلمن يجعل ماله قال لولده ولورثته ولزوجته

  وبهذا الاسناد ان امير المءمنين ص كان يحكم في زنديق اذا شهد عليه رجلان عدلان مرضيان وشهد له الف بالبراءة جازت شهادة الرجلين وابطل شهادة الالف لانه دين مكتوم

  وبهذا الاسناد قال قال امير المءمنين ع المرتد تعزل عنه امراته ولا تءكل ذبيحته ويستتاب ثلاثة ايام فان تاب والا قتل يوم الرابع

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن هشام بن سالم عن



 ابي عبد الله ع قال اتي قوم امير المءمنين ع فقالوا السلام عليك يا ربنا فاستتابهم فلم يتوبوا فحفر لهم حفيرة واوقد فيها نارا وحفر حفيرة اخري الي جانبها وافضي ما بينهما فلما لم يتوبوا القاهم في الحفيرة واوقد في الحفيرة الاخري ]نارا[ حتي ماتوا

  عدة من اصحابنا عن سهل بن زياد ومحمد بن يحيي عن احمد بن محمد جميعا عن ابن محبوب عن ابن رءاب عن ابي عبيدة عن ابي عبد الله ع قال العبد اذا ابق من مواليه ثم سرق لم يقطع وهو ابق لانه مرتد عن الاسلام ولكن يدعي الي الرجوع الي مواليه والدخول في الاسلام فان ابي ان يرجع الي مواليه قطعت يده بالسرقة ثم قتل والمرتد اذا سرق بمنزلته

  ابن محبوب عن هشام بن سالم عن بريد العجلي قال سءل ابو جعفر ع عن رجل شهد عليه شهود انه افطر من شهر رمضان ثلاثة ايام فقال يسال هل عليك في افطارك اثم فان قال لا فان علي الامام ان يقتله وان هو قال نعم فان علي الامام ان ينهكه ضربا

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن هشام بن سالم عن ابي عبد الله ع انه سال عمن شتم رسول الله ص فقال يقتله الادني فالادني قبل ان يرفعه الي الامام

  محمد بن يحيي عن احمد بن محمد عن ابن فضال عن حماد بن عثمان عن ابن ابي يعفور قال قلت لابي عبد الله ع ان بزيعا يزعم انه نبي قال فان سمعته يقول ذلك فاقتله قال فجلست غير مرة فلم يمكني ذلك

  محمد بن يحيي عن احمد بن محمد بن عيسي عن ابن محبوب عن صالح بن سهل عن كردين عن رجل عن ابي عبد الله وابي جعفر ع قال ان امير المءمنين ع لما فرغ من اهل البصرة اتاه سبعون رجلا من الزط فسلموا عليه وكلموه بلسانهم فرد عليهم بلسانهم ثم قال لهم اني لست كما قلتم انا عبد الله مخلوق فابوا عليه وقالوا انت هو فقال لهم لءن لم تنتهوا وترجعوا عما قلتم في وتتوبوا الي الله عز وجل



 لاقتلنكم فابوا ان يرجعوا ويتوبوا فامر ان تحفر لهم ابار فحفرت ثم خرق بعضها الي بعض ثم قذفهم فيها ثم خمر رءوسها ثم الهبت النار في بءر منها ليس فيها احد منهم فدخل الدخان عليهم فيها فماتوا

 باب حد الساحر

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال قال رسول الله (صلي الله عليه واله وسلم) ساحر المسلمين يقتل وساحر الكفار لا يقتل قيل يا رسول الله ولم لا يقتل ساحر الكفار قال لان الكفر اعظم من السحر ولان السحر والشرك مقرونان

  محمد بن يحيي ومحمد بن الحسين وحبيب بن الحسن عن محمد بن عبد الحميد العطار عن بشار عن زيد الشحام عن ابي عبد الله ع قال الساحر يضرب بالسيف ضربة واحدة علي ]ام[ راسه

 باب النوادر

  محمد بن يحيي عن احمد بن محمد عن ابن محبوب عن الحسن بن صالح الثوري عن ابي جعفر ع قال ان امير المءمنين ع امر قنبر ان يضرب رجلا حدا فغلظ قنبر فزاده ثلاثة اسواط فاقاده علي ع من قنبر ثلاثة اسواط

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال قال رسول الله (صلي الله عليه واله وسلم) ان ابغض الناس الي الله عز وجل رجل جرد ظهر مسلم بغير حق

  علي بن ابراهيم عن ابيه عن علي بن اسباط عن بعض اصحابنا قال نهي رسول الله (صلي الله عليه واله وسلم) عن الادب عند الغضب

  محمد بن يحيي عن محمد بن احمد عن محمد بن عيسي عن احمد بن عمر الحلال قال قال ياسر عن بعض الغلمان عن ابي الحسن ع انه قال لا يزال العبد يسرق حتي



 

 اذا استوفي ثمن يده اظهرها الله عليه

  عدة من اصحابنا عن احمد بن محمد في مساءل اسماعيل بن عيسي عن الاخير في مملوك يعصي صاحبه ايحل ضربه ام لا فقال لا يحل لك ان تضربه ان وافقك فامسكه والا فخل عنه

  علي بن محمد بن بندار عن احمد بن ابي عبد الله عن ابيه عن ابي البختري عن ابي عبد الله ع ان امير المءمنين ع قال من اقر عند تجريد او تخويف او حبس او تهديد فلا حد عليه

  محمد بن يحيي عن محمد بن الحسين عن محمد بن اسلم الجبلي عن عاصم بن حميد عن محمد بن قيس عن ابي جعفر ع قال سالته عن امراة ذات بعل زنت فحبلت فلما ولدت قتلت ولدها سرا قال تجلد ماءة ]جلدة[ لقتلها ولدها وترجم لانها محصنة قال وسالته عن امراة غير ذات بعل زنت فحبلت فقتلت ولدها سرا قال تجلد ماءة لانها زنت وتجلد ماءة لانها قتلت ولدها

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع ان امير المءمنين ع قال من اقر بولد ثم نفاه جلد الحد والزم الولد

  علي عن ابيه عن صالح بن سعيد رفعه عن احدهما ع قال سالته عن رجل يسرق فتقطع يده باقامة البينة عليه ولم يرد ما سرق كيف يصنع به في مال الرجل الذي سرق منه اوليس عليه رده وان ادعي انه ليس عنده قليل ولا كثير وعلم ذلك منه قال يستسعي حتي يءدي اخر درهم سرقه

  علي عن ابيه عن محمد بن سليمان عن عبد الله بن سنان قال قلت لابي عبد الله ع اخبرني عن القواد ما حده قال لا حد علي القواد اليس انما يعطي الاجر



 

 علي ان يقود قلت جعلت فداك انما يجمع بين الذكر والانثي حراما قال ذاك المءلف بين الذكر والانثي حراما فقلت هو ذاك جعلت فداك قال يضرب ثلاثة ارباع حد الزاني خمسة وسبعين سوطا وينفي من المصر الذي هو فيه فقلت جعلت فداك فما علي رجل الذي وثب علي امراة فحلق راسها قال يضرب ضربا وجيعا ويحبس في سجن المسلمين حتي يستبرا شعرها فان نبت اخذ منه مهر نساءها وان لم ينبت اخذت منه الدية كاملة خمسة الاف درهم فقلت فكيف صار مهر نساءها ان نبت شعرها قال يا ابن سنان ان شعر المراة وعذرتها يشتركان في الجمال فاذا ذهب باحدهما وجب لها المهر كاملا

  محمد بن يحيي عن محمد بن احمد عن محمد بن عيسي عن محمد بن سنان عن العلاء بن الفضيل عن ابي عبد الله ع قال قلت له الرجل ينتفي من ولده وقد اقر به فقال ان كان الولد من حرة جلد الحد خمسين سوطا حد المملوك وان كان من امة فلا شي ء عليه

  محمد بن احمد عن ابي عبد الله الرازي عن الحسن بن علي بن ابي حمزة عن ابي عبد الله المءمن عن اسحاق بن عمار قال قلت لابي عبد الله ع الزني اشر او شرب الخمر وكيف صار في الخمر ثمانين وفي الزني ماءة فقال يا اسحاق الحد واحد ولكن زيد هذا لتضييعه النطفة ولوضعه اياها في غير موضعها الذي امره الله عز وجل به

  محمد بن احمد عن بعض اصحابه عن ابراهيم بن محمد الثقفي عن ابراهيم بن يحيي الثوري عن هيثم بن بشير عن ابي بشير عن ابي روح ان امراة تشبهت بامة لرجل وذلك ليلا فواقعها وهو يري انها جاريته فرفع الي عمر فارسل الي علي ع فقال اضرب الرجل حدا في السر واضرب المراة حدا في العلانية

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال لا يقام الحد علي المستحاضة حتي ينقطع الدم عنها

  علي بن محمد عن محمد بن احمد المحمودي عن ابيه عن يونس عن الحسين بن خالد عن ابي عبد الله ع قال سمعته يقول الواجب علي الامام اذا نظر الي رجل يزني او يشرب الخمر ان يقيم عليه الحد ولا يحتاج الي بينة مع نظره لانه امين الله



 في خلقه واذا نظر الي رجل يسرق فالواجب عليه ان يزبره وينهاه ويمضي ويدعه قلت كيف ذاك قال لان الحق اذا كان لله فالواجب علي الامام اقامته واذا كان للناس فهو للناس

  محمد بن يحيي عن احمد بن محمد رفعه قال كان امير المءمنين ع يولي الشهود الحدود

  محمد بن يحيي عن احمد بن محمد عن ابن محبوب عن هشام بن سالم عن ابي بصير عن ابي جعفر ع قال من ضرب مملوكا حدا من الحدود من غير حد اوجبه المملوك علي نفسه لم يكن لضاربه كفارة الا عتقه

  حميد بن زياد عن الحسن بن محمد بن سماعة عن احمد بن الحسن الميثمي عن ابان بن عثمان عن ابن ابي يعفور عن ابي عبد الله ع قال جاء رجل الي النبي ص فقال يا رسول الله انني سالت رجلا بوجه الله فضربني خمسة اسواط فضربه النبي ص خمسة اسواط اخري وقال سل بوجهك اللءيم

  عدة من اصحابنا عن احمد بن محمد عن عثمان بن عيسي عن سماعة قال قال ان رجلا قال لرجل علي عهد امير المءمنين ع اني احتلمت بامك فرفعه الي امير المءمنين ع قال ان هذا افتري علي امي فقال له وما قال لك قال زعم انه احتلم بامي فقال له امير المءمنين ع في العدل ان شءت اقمته لك في الشمس فاجلد ظله فان الحلم مثل الظل ولكن سنضربه حتي لا يعود يءذي المسلمين

 وفي رواية اخري ضربه ضربا وجيعا 

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن هشام بن سالم عن ابي عبد الله ع قال ان امير المءمنين ع راي قاصا في المسجد فضربه بالدرة وطرده

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن عبد الرحمن بن الحجاج رفعه ان امير المءمنين ع كان لا يري الحبس الا في ثلاث رجل اكل مال اليتيم او غصبه او رجل اءتمن علي امانة فذهب بها



 

 

  الحسين بن محمد عن معلي بن محمد عن علي بن مرداس عن سعدان بن مسلم عن بعض اصحابنا عن الحارث بن حصيرة قال مررت بحبشي وهو يستسقي بالمدينة واذا هو اقطع فقلت له من قطعك فقال قطعني خير الناس انا اخذنا في سرقة ونحن ثمانية نفر فذهب بنا الي علي بن ابي طالب ع فاقررنا بالسرقة فقال لنا تعرفون انها حرام قلنا نعم فامر بنا فقطعت اصابعنا من الراحة وخليت الابهام ثم امر بنا فحبسنا في بيت يطعمنا فيه السمن والعسل حتي برات ايدينا ثم امر بنا فاخرجنا وكسانا فاحسن كسوتنا ثم قال لنا ان تتوبوا وتصلحوا فهو خير لكم يلحقكم الله بايديكم في الجنة وان لا تفعلوا يلحقكم الله بايديكم في النار

  علي بن ابراهيم عن ابيه عن ابن ابي نجران عن عاصم بن حميد عن محمد بن قيس عن ابي جعفر ع قال قضي امير المءمنين ع في رجل جاء به رجلان وقالا ان هذا سرق درعا فجعل الرجل يناشده لما نظر في البينة وجعل يقول والله لو كان رسول الله (صلي الله عليه واله وسلم) ما قطع يدي ابدا قال ولم قال يخبره ربه اني بري ء فيبرءني ببراءتي فلما راي مناشدته اياه دعا الشاهدين وقال اتقيا الله ولا تقطعا يد الرجل ظلما وناشدهما ثم قال ليقطع احدكما يده ويمسك الاخر يده فلما تقدما الي المصطبة ليقطع يده ضرب الناس حتي اختلطوا فلما اختلطوا ارسلا الرجل في غمار الناس حتي اختلطا بالناس فجاء الذي شهدا عليه فقال يا امير المءمنين شهد علي الرجلان ظلما فلما ضرب الناس واختلطوا ارسلاني وفرا ولو كانا صادقين لم يرسلاني فقال امير المءمنين ع من يدلني علي هذين انكلهما

  علي بن ابراهيم عن ابيه عن الوشاء عن عاصم بن حميد عن محمد بن قيس عن ابي جعفر ع قال قضي امير المءمنين ع في رجلين سرقا من مال الله احدهما عبد لمال الله والاخر من عرض الناس فقال اما هذا فمن مال الله ليس عليه شي ء من مال الله اكل بعضه بعضا واما الاخر فقدمه فقطع يده ثم امر ان يطعم السمن واللحم حتي برات منه



 

  محمد بن يحيي عن احمد بن محمد عن محمد بن سنان عن طلحة بن زيد عن ابي عبد الله ع قال ان امير المءمنين ع اتي برجل عبث بذكره فضرب يده حتي احمرت ثم زوجه من بيت المال

  علي بن ابراهيم عن ابيه عن محمد بن الوليد عن محمد بن الفرات عن الاصبغ بن نباتة رفعه قال اتي عمر بخمسة نفر اخذوا في الزني فامر ان يقام علي كل واحد منهم الحد وكان امير المءمنين ع حاضرا فقال يا عمر ليس هذا حكمهم قال فاقم انت عليهم الحكم فقدم واحدا منهم فضرب عنقه وقدم الثاني فرجمه وقدم الثالث فضربه الحد وقدم الرابع فضربه نصف الحد وقدم الخامس فعزره فتحير عمر وتعجب الناس من فعله فقال عمر يا ابا الحسن خمسة نفر في قضية واحدة اقمت عليهم خمس حدود ليس شي ء منها يشبه الاخر فقال امير المءمنين ع اما الاول فكان ذميا خرج عن ذمته لم يكن له حكم الا السيف واما الثاني فرجل محصن كان حده الرجم واما الثالث فغير محصن جلد الحد واما الرابع فعبد ضربناه نصف الحد واما الخامس فمجنون مغلوب علي عقله

  علي بن ابراهيم عن ابيه عن ابن ابي عمير عن ابن بكير عن زرارة عن حمران قال سالت ابا عبد الله او ابا جعفر ع عن رجل اقيم عليه الحد في الدنيا ايعاقب في الاخرة فقال الله اكرم من ذلك

  علي بن ابراهيم عن ابيه عن بعض اصحابنا عن ابي الصباح الكناني عن ابي عبد الله ع قال من احدث في الكعبة حدثا قتل

  علي بن ابراهيم عن ابيه عن الحجال عن علي بن محمد بن عبد الرحمن عن النوفلي عن السكوني عن ابي عبد الله ع قال اتي امير المءمنين ع برجل نصراني كان اسلم ومعه خنزير قد شواه وادرجه بريحان قال ما حملك علي هذا قال الرجل مرضت فقرمت الي اللحم فقال اين انت من لحم المعز وكان خلفا منه ثم



 قال لو انك اكلته لاقمت عليك الحد ولكن ساضربك ضربا فلا تعد فضربه حتي شغر ببوله

  الحسين بن محمد عن علي بن محمد عن الحسن بن علي الوشاء قال سمعت ابا الحسن ع يقول شتم رجل علي عهد جعفر بن محمد ع رسول الله ص فاتي به عامل المدينة فجمع الناس فدخل عليه ابو عبد الله ع وهو قريب العهد بالعلة وعليه رداء له مورد فاجلسه في صدر المجلس واستاذنه في الاتكاء وقال لهم ما ترون فقال له عبد الله بن الحسن والحسن بن زيد وغيرهما نري ان يقطع لسانه فالتفت العامل الي ربيعة الراي واصحابه فقال ما ترون فقال يءدب فقال له ابو عبد الله ع سبحان الله فليس بين رسول الله ص وبين اصحابه فرق

  عدة من اصحابنا عن سهل بن زياد عن محمد بن سليمان الديلمي عن هارون بن الجهم عن محمد بن مسلم عن ابي جعفر ع قال اتي امير المءمنين ع بقوم لصوص قد سرقوا فقطع ايديهم من نصف الكف وترك الابهام ولم يقطعها وامرهم ان يدخلوا دار الضيافة وامر بايديهم ان تعالج فاطعمهم السمن والعسل واللحم حتي برءوا فدعاهم وقال يا هءلاء ان ايديكم قد سبقت الي النار فان تبتم وعلم الله منكم صدق النية تاب الله عليكم وجررتم ايديكم الي الجنة وان لم تقلعوا ولم تنتهوا عما انتم عليه جرتكم ايديكم الي النار

  عدة من اصحابنا عن سهل بن زياد عن علي بن اسباط عن علي بن جعفر قال اخبرني اخي موسي ع قال كنت واقفا علي راس ابي حين اتاه رسول زياد بن عبيد الله الحارثي عامل المدينة قال يقول لك الامير انهض الي فاعتل بعلة فعاد اليه الرسول فقال له قد امرت ان يفتح لك باب المقصورة فهو اقرب لخطوتك قال فنهض ابي واعتمد علي ودخل علي الوالي وقد جمع فقهاء المدينة كلهم وبين يديه كتاب فيه شهادة علي رجل من اهل وادي القري فذكر النبي ص فنال منه فقال له الوالي



 يا ابا عبد الله انظر في الكتاب قال حتي انظر ما قالوا فالتفت اليهم فقال ما قلتم قالوا قلنا يءدب ويضرب ويعزر ويحبس قال فقال لهم ارايتم لو ذكر رجلا من اصحاب النبي ص بمثل ما ذكر به النبي ص ما كان الحكم فيه قالوا مثل هذا قال سبحان الله فقال فليس بين النبي ص وبين رجل من اصحابه فرق قال فقال الوالي دع هءلاء يا ابا عبد الله لو اردنا هءلاء لم نرسل اليك فقال ابو عبد الله ع اخبرني ابي ع ان رسول الله ع قال ]ان[ الناس في اسوة سواء من سمع احدا يذكرني فالواجب عليه ان يقتل من شتمني ولا يرفع الي السلطان والواجب علي السلطان اذا رفع اليه ان يقتل من نال مني فقال زياد بن عبيد الله اخرجوا الرجل فاقتلوه بحكم ابي عبد الله ع

  علي بن ابراهيم عن ابيه عن حماد بن عيسي عن ربعي عن محمد بن مسلم عن ابي جعفر ع قال ان رجلا من هذيل كان يسب رسول الله ص فبلغ ذلك النبي ص فقال من لهذا فقام رجلان من الانصار فقالا نحن يا رسول الله فانطلقا حتي اتيا عربة فسالا عنه فاذا هو يتلقي غنمه فلحقاه بين اهله وغنمه فلم يسلما عليه فقال من انتما وما اسمكما فقالا له انت فلان بن فلان فقال نعم فنزلا وضربا عنقه قال محمد بن مسلم فقلت لابي جعفر ع ارايت لو ان رجلا الان سب النبي ص ايقتل قال ان لم تخف علي نفسك فاقتله

  عدة من اصحابنا عن احمد بن محمد عن عثمان بن عيسي عن اسحاق بن عمار قال قلت لابي عبد الله ع ربما ضربت الغلام في بعض ما يحرم فقال وكم تضربه فقلت ربما ضربته ماءة فقال ماءة ماءة فاعاد ذلك مرتين ثم قال حد الزني اتق الله فقلت جعلت فداك فكم ينبغي لي ان اضربه فقال واحدا فقلت والله لو علم اني لا اضربه الا واحدا ما ترك لي شيءا الا افسده فقال فاثنتين فقلت جعلت فداك هذا هو هلاكي اذا قال فلم ازل اماكسه حتي بلغ خمسة ثم غضب فقال يا اسحاق ان كنت تدري حد ما اجرم فاقم الحد فيه ولا تعد حدود الله



 

  الحسين بن محمد عن معلي بن محمد عن الحسن بن علي عن حماد بن عثمان قال قلت لابي عبد الله ع في ادب الصبي والمملوك فقال خمسة او ستة وارفق

  علي بن ابراهيم عن ابيه عن النوفلي عن السكوني عن ابي عبد الله ع قال قال امير المءمنين ع اذا كان الرجل كلامه كلام النساء ومشيته مشية النساء ويمكن من نفسه فينكح كما تنكح المراة فارجموه ولا تستحيوه

  وبهذا الاسناد قال قال رسول الله (صلي الله عليه واله وسلم) من بلغ حدا في غير حد فهو من المعتدين

  وبهذا الاسناد ان امير المءمنين ع القي صبيان الكتاب الواحهم بين يديه ليخير بينهم فقال اما انها حكومة والجور فيها كالجور في الحكم ابلغوا معلمكم ان ضربكم فوق ثلاث ضربات في الادب اقتص منه

  وبهذا الاسناد ان رسول الله ص قال لا تدعوا المصلوب بعد ثلاثة ايام حتي ينزل فيدفن

  عدة من اصحابنا عن سهل بن زياد عن ابن محبوب عن بعض اصحابه عن ابي عبد الله ع قال بعث امير المءمنين ع الي بشر بن عطارد التميمي في كلام بلغه فمر به رسول امير المءمنين ع في بني اسد واخذه فقام اليه نعيم بن دجاجة الاسدي فافلته فبعث اليه امير المءمنين ع فاتوه به وامر به ان يضرب فقال له نعيم اما والله ان المقام معك لذل وان فراقك لكفر قال فلما سمع ذلك منه قال له يا نعيم قد عفونا عنك ان الله عز وجل يقول ادفع بالتي هي احسن السيءة اما قولك ان المقام معك لذل فسيءة اكتسبتها واما قولك ان فراقك لكفر فحسنة اكتسبتها فهذه بهذه ثم امر ان يخلي عنه

  الحسين بن محمد الاشعري عن معلي بن محمد عن الحسن بن علي الوشاء عن ابان عن علي بن اسماعيل عن عمرو بن ابي المقدام عن رجل عن رزين قال كنت اتوضا



 في ميضاة الكوفة فاذا رجل قد جاء فوضع نعليه ووضع درته فوقها ثم دنا فتوضا معي فزحمته فوقع علي يديه فقام فتوضا فلما فرغ ضرب راسي بالدرة ثلاثا ثم قال اياك ان تدفع فتكسر فتغرم فقلت من هذا فقالوا امير المءمنين ع فذهبت اعتذر اليه فمضي ولم يلتفت الي

  محمد بن يحيي عن احمد بن محمد بن عيسي عن ابن محبوب عن يونس بن يعقوب عن مطر بن ارقم قال سمعت ابا عبد الله ع يقول ان عبد العزيز بن عمر الوالي بعث الي فاتيته وبين يديه رجلان قد تناول احدهما صاحبه فمرش وجهه وقال ما تقول يا ابا عبد الله في هذين الرجلين قلت وما قالا قال قال احدهما ليس لرسول الله ص فضل علي احد من بني امية في الحسب وقال الاخر له الفضل علي الناس كلهم في كل حين وغضب الذي نصر رسول الله ص فصنع بوجهه ما تري فهل عليه شي ء فقلت له اني اظنك قد سالت من حولك فاخبروك فقال اقسمت عليك لما قلت فقلت له كان ينبغي للذي زعم ان احدا مثل رسول الله ص في الفضل ان يقتل ولا يستحيا قال فقال اوما الحسب بواحد فقلت ان الحسب ليس النسب الا تري لو نزلت برجل من بعض هذه الاجناس فقراك فقلت ان هذا الحسب ]لجاز ذلك[ فقال اوما النسب بواحد قلت اذا اجتمعا الي ادم ع فان النسب واحد ان رسول الله ص لم يخلطه شرك ولا بغي فامر به الوالي فقتل

  عنه عن احمد بن محمد عن علي بن الحكم عن ربيع بن محمد عن عبد الله بن سليمان العامري قال قلت لابي عبد الله ع اي شي ء تقول في رجل سمعته يشتم عليا ع ويتبرا منه قال فقال لي والله حلال الدم وما الف منهم برجل منكم دعه لا تعرض له الا ان تامن علي نفسك

  وعنه عن احمد بن محمد عن علي بن الحكم عن هشام بن سالم قال قلت لابي عبد الله ع ما تقول في رجل سبابة لعلي ع قال فقال لي حلال الدم والله



 لو لا ان تعم به بريءا قال فقلت فما تقول في رجل مءذ لنا قال فقال فيما ذا قلت مءذينا فيك بذكرك قال فقال لي له في علي ع نصيب قلت انه ليقول ذاك ويظهره قال لا تعرض له

  علي بن ابراهيم عن ابيه عن بعض اصحابه عن حماد عن ابي عبد الله ع قال لا يخلد في السجن الا ثلاثة الذي يمثل والمراة ترتد عن الاسلام والسارق بعد قطع اليد والرجل

