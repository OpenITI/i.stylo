  ابراهيم بن عطية الثقفي عن يونس بن خباب وغيره قال البخاري عنده  مناكير وقال النساءي متروك وقال احمد لا يكتب حديثه وقال يحيي لا يساوي شيءا وقيل احاديثه دون العشرة منها ما روي عن عثمان بن مخلد الواسطي ثنا ابراهيم بن عطية ثنا يونس بن خباب ثنا مهاجر مولي بن عمر عن بن عمر رضي الله عنهما عن النبي صلي الله عليه وسلم في قوله تعالي من ذا الذي يقرض الله قرضا حسنا فيضاعفه له اضعافا كثيرة قال الف الف ضعف قيل مات بعد هشيم بواسط وقد روي هشيم عنه قال احمد كان يلي السواد وكنا نكتب عنه قال ولا ينبغي ان يروي عنه وقال البخاري مات سنة احدي وثمانين وماءة انتهي وقال ابو حاتم هو شيخ وقال الساجي لا يكتب عنه ولا يروي عنه ليس حديثه بشء وقال بن عدي قليل الحديث وقال العقيلي عنده مناكير عن يونس بن خباب ومغيرة ونسبه واسطيا ثقفيا ونقل عن البخاري ان هشيما كان يدلسه وعن يزيد بن هارون انه كان يروي حديثين عن مغيرة فبلغاهما هشيم فروي احدهما عن مغيرة واسقط ابراهيم وهو حديث النظر في مراة الحجام دناءة قال يزيد والحديث يعني الثاني لا ادري ما هو ونقل بن عدي عن عباس الدوري سالت احمد وابن معين عن احاديث يرويها عن هشيم عن مغيرة عن ابراهيم النظر في مراة الحجام دناءة واذا بلي المصحف دفن واشباه هذه فقال سمعها هشيم من ابراهيم بن عطية عن مغيرة وابراهبم لا يساوي شيءا واخرج من طريق اسحاق بن شاهين انا بعض اصحابنا عن مغيرة بحديث الحجام قال اسحاق وانا ابراهيم بن عطية به ثم قال بن عدي حدثنا احمد بن حمدون النيسابوري ثنا ابراهيم بن اسماعيل الرقي ثنا ابي ثنا ابراهيم بن عطية الواسطي ثقة فذكر حديثا وقال ابو احمد الحاكم ليس بالقوي عندهم وقال بن حبان ابراهيم بن عطية الواسطي خراساني الاصل منكر الحديث جدا روي عن مغيرة عن ابراهيم النظر في مراة الحجام دناءة وسمعه هشيم منه فدلسه عن مغيرة قلت وهذه القصة نقلت عن بن معين انه سءل عن احاديث يرويها هشيم عن مغيرة عن ابراهيم فقال سمعها هشيم عن ابراهيم بن عطية قال وابراهيم لا يساوي شيءا 
  ابراهيم بن عقبة عن كبشة بنت كعب وعنه حماد بن زيد لا يعرف وقال ابو حاتم مجهول انتهي وقد خلط المءلف رحمه الله هنا ترجمتين فجعلهما واحدا اما الراوي عن كبشة فقال البخاري في تاريخه ابراهيم بن عقبة بن رزام الراسبي البصري سمع عطاء سمع منه موسي بن اسماعيل وقال لي مسدد ثنا ابراهيم بن عقبة سمع كبشة بنت كعب وقال ابو حاتم روي عن كشبة قالت قال لي انس بن مالك سمعت ابي يقول ذلك هذا جميع ما ذكره به واما الذي روي عنه حماد بن زيد فقال البخاري ابراهيم بن عقبة قال زكريا ثنا الحكم بن المبارك ثنا حماد بن زيد عن ابراهيم بن عقبة مولي ابي امامة عن ابي امامة قال الحارث ما كان من النصف الاسفل حديثه في البصريين وقال بن ابي حاتم روي بن عقبة مولي ابي امامة عن ابي امامة واما البخاري فذكر انه روي عن مولي ابي امامة وكذا قال بن حبان لما ذكره في الثقات في اتباع التابعين وممن يسمي ابراهيم بن عقبة ثلاثة الاول اسم جده طلق بن علي روي عن قيس بن طلق والثاني اسم جده ابو عاءشة روي عن ابيه وعن اهل المدينة ذكرهما بن حبان في الثقات والثالث اخو موسي بن عقبة مذكور في التهذيب
  ابراهيم بن عقيل بن حبيش القرشي النحوي ويعرف بابن الكبري حدث عنه ابو بكر الخطيب قال هبة الله بن الاكفاني كان يركب الاسناد انتهي وقد قال الخطيب كان صدوقا فرد ذلك بن الكفاني وقص قصة طويلة في ادعاءه سماع تعليقه ابي الاسود الدءلي التي القاها عليه علي بن ابي طالب وانه كان وعد المحدثين بها الي ان رفعها الي بن الاكفاني الفقيه ابو العباس احمد بن منصور المالكي فاذا هو قد ركب لها اسنادا عن شيخ له عن يحيي بن ابي بكر الكرماني عن اسراءيل قال فبينت ذلك للفقيه ابي العباس وقلت له ان بن ابي بكر مات سنة  فكيف يمكن ان يكون بين هذا وبينه رجل واحد فرجع عنه ومات صاحب الترجمة سنة اربع وسبعين واربع ماءة وترجمته مبسوطة في تاريخ دمشق قال بن الاكفاني ولم يقع امر هذا الاسناد وهذه التعليقة للشيخ الخطيب ولا وقف عليه لان بن عقيل كان لا يظهر ذلك وهذه التي سماها التعليقة في اول امالي ابي القاسم الزجاجي نحوا من عشرة اسطر فجعلها هذا الشيخ قريبا من عشرة اوراق وصورة الاسناد قال حدثني ابو طالب عبيد الله بن احمد بن نصر بن يعقوب بالبصرة حدثني يحيي بن ابي بكر الكرماني حدثني اسراءيل عن محمد بن عبيد الله بن ابي رافع عن ابيه قال وحدثني محمد بن عبيد الله عن الحسن بن عياش عن عمه عن عبيد الله بن ابي رافع عن ابيه قال وحدثني محمد بن عبيد الله بن الحسن بن عياش عن عمه عن عبيد الله بن ابي رافع ابا الاسود دخل علي علي فذكرها 
  ابراهيم بن عكاشة عن الثوري لا يعرف والخبر منكر وعنه كاتب الليث انتهي قال بن ابي حاتم وحديث الخبر الذي رواه منكر ادل علي ان الرجل ليس بصدوق انتهي وسياتي ابراهيم بن محمد العكاشي وكانهما واحد
  ابراهيم بن العلاء ابو هارون الغنوي عن حطان الرقاشي وثقه جماعة ووهاه شعبة فيما قيل ولم يصح بل صح انه حدث عنه وقد وثقه يحيي بن معين وهو بصري صدوق قال بن معين هو الي الصدق اقرب ولم يحدث عنه القطان وابن مهدي وقال بن عدي متماسك انتهي وقال ابو حاتم لا باس به وقال ابو زرعة وابو داود والنساءي وابن سعد والفلاس والعجلي وابن المديني والفسوي ثقة وذكره بن حبان وابن شاهين في الثقات وقال بن عبد البر اجمعوا علي انه ثقة قلت لكن قال الساجي فيه ضعف وهذا جرح لين مردود واما قول المءلف ووهاه شعبة فيما قيل فاجاد في تمريض هذا القول ولا اصل لذلك عن شعبة وانما قال بن الجوزي في الضعفاء له قال شعبة لان اقدم فتضرب عنقي احب الي من ان اقول حدثنا ابو هارون الغنوي كذا نقل بن الجوزي وهذا خطا نشا عن تصحيف وانما هو ابو هارون العبدي وهو عمارة بن جوين مجمع علي ضعفه وقد نقل بن الجوزي هذا القول عن شعبة في ترجمة ابي هارون العبدي ايضا وهو الصواب 
