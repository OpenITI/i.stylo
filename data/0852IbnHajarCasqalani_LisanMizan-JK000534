  ابراهيم بن عيسي القنطري عن احمد بن ابي الحواري قال الخطيب مجهول قلت وخبره باطل فروي عن بن ابي الحواري ثنا الوليد ثنا الليث بن سعد عن الزهري عن الاعرج عن ابي هريرة رضي الله عنه مرفوعا غمسني جبريل عند سدرة المنتهي في النور وقال انت من الله ادني من القاب الي القوس واتاني الملك فقال ان الرحمن يسبح نفسه وذكر الحديث فافته القنطري قال الخطيب رجاله موثقون الا القنطري انتهي وله كتاب في الطب لابي نعيم في الرحلة باطل واورد حديثه الحاكم في كتاب الرقاق من المستدرك وقال صحيح وتعقبه الذهبي في تلخيصه فقال بل منكر او موضوع 
  ابراهيم بن عيسي ابو ايوب الخزاز الكوفي ذكره علي بن الحكم وغيره في رجال الشيعة وقال روي عن الصادق والكاظم روي عنه الحسن بن محبوب وغيره
  ابراهيم بن عيسي الزاهد ابو اسحاق الاصبهاني روي عن داود الطيالسي وشبابة بن سوار وغيرهما وصحب معروفا الكرخي قال ابو نعيم كان من العباد والفضلاء وقال ابو الشيخ كان خيرا عابدا فاضلا لم يكن ببلدنا مثله في زماننا وما راينا احدا يحدث عنه الا ابو العباس احمد بن محمد البزار قلت قد ذكر بن ابي حاتم انه روي عنه النظر بن محمد بن هشام الاصبهاني وفي كتاب ابي الشيخ رواية احمد بن نعيم بن ناصح وعبد الله بن محمد بن زكريا عنه في حكايتين رواهما انتهي وما ادري لم ذكره شيخنا في ذيل الميزان فانه لم ينقل عن احد انه ضعفه ولا قال انه مجهول فان كان ظن ان قول ابي الشيخ ما راينا الي اخره انه لم يرو عنه غير واحد فيكون مجهولا فليس كما ظن فان مراد ابي الشيخ الرواية الحقيقة اي لم يحدثنا عنه بغير واسطة احد لا انه نفي ان يكون وجد له راويا اخر ويدل علي ذلك ما اورده ابو الشيخ عن راويين عنه لكن بينه وبين كل منهما واسطة والله اعلم 
  ابراهيم بن عيسي السبني الرازي ذكره في ترجمة محمد بن الحسين الهروي
  ابراهيم بن غريب الكوفي ذكره الطوسي في رجال الشيعة وقال روي عن جعفر الصادق
  ابراهيم بن الغطريف بن سالم عن ابيه وعنه اسحاق بن سويد الرملي وقع ذكره في حديث اخرجه بن مندة في المعرفة في ترجمة جده قال العلاءي في الوشي رجال هذا السند لا يعرفون
  ابراهيم بن ابي فاطمة ذكره الطوسي في رجال الشيعة وقال روي عن الصادق
  ابراهيم بن الفضل الاصبهاني الحافظ ابو نصر البار له جزء مروي قال بن طاهر كذاب وقال بن السمعاني قال لي ابو القاسم التيمي اشكر الله تعالي حيث لم تدرك البار قال بن السمعاني رحل وطوف ولحقه الادبار وكان يقف في سوق اصبهان ويروي من حفظه باسناده وسمعت انه كان يضع في الحال سمع ابا الحسين بن النقور وعبد الرحمن بن مندة وقال السلفي يعرف بدعلج سمعنا بقراءة كثيرا وغيره ارضي منه وقال معمر بن المفاخر رايته في السوق وقد روي مناكير باسانيد الصحاح فكنت اتامله تاملا مفرطا اظن ان الشيطان تبدي علي صورته قلت مات سنة ثلاثين وخمس ماءة انتهي وقال بن طاهر كان ابوه يحفر الابار ورحل هو في صغره فسمع ببغداد ورجع منها الي اصبهان ولم يتجاوز بها ثم رحل الي خراسان وادرك الاسناد ولم يقتصر علي ذلك حتي مد يده الي من لم يره من بلدان شتي فافسد الاول والاخر ولما كان بهراة فصدني وطلب مني شيءا من حديث المكيين والمصريين فاخرجت له ثم بلغني انه يحدث عن المشاءخ الذين حدثت عنهم وبلغ القصة شيخ البلد الهروي يعني ابا اسماعيل الانصاري فساله عن لقيه لهءلاء الشيوخ فقال سمعت مع هذا المقدسي منهم فسالني الشيخ فقلت ما رايته قط الا في هذا البلد فقال له الشيخ احججت قال نعم قال فما علامة عرفة قال دخلنا ليلا قال يجوز فما علامة مني قال كنا بها بالليل فقال ثلاثة ايام وثلاث ليال ما طلع عليكم الصبح لا بارك الله وامر باخراجه من البلد وقال هذا دجال من الدجاجة انكشف امره بعد ذلك ولحقه شوم الكذب وعقوق المشاءخ حتي صار اية في الكذب وكان يكذب لنفسه ولغيره في الاجازات حتي كان له جز استدعي اجازات كل حين يلحق فيه اسماء اقوام من اهل الثروة ويكتب لهم عن اولءك المشاءخ احاديث تقرء عليهم ويحدثهم بها فقال لي ابو محمد السمرقندي قد عزمت علي ان اخذ منه الجزء ولا ارده اليه ففعل ذلك فوجدته الحق علي الهوامش اسماء جماعة لم يكن لهم ذكر في صدر الاستدعاء فحبسه السمرقندي ولم يرده اليه ثم ترك الاشتغال بالحديث واشتغل بالكذبة وكشف قناع الوقاحة حتي كان يدخل في التهاني والتعازي ويروي الحديث ويقنع منهم بالنزر اليسير ذكر ذلك كله بن النجار في ترجمته ومن طريق حمزة بن حسين الروذباري ان ابراهيم اعترف بحضرته بوضع الحديث وارخ بن السمعاني ومعمر بن المفاخر وفاته سنة  
  ابراهيم بن الفضل بن ابي سويد عن حماد بن سلمة صدوق قيل كان كثير التصحيف واما ابو حاتم فقال كان من ثقات المسلمين رضي انتهي والقاءل فيه كان كثير التصحيف هو يحيي بن معين وقد روي ابراهيم ايضا عن عمارة بن زاذان وابي عوانة وعبد الواحد بن زياد وعنه بندار وابو حاتم وابو زرعة 
  ابراهيم بن فروخ مولي عمر روي عن ابيه عن بن عباس رضي الله عنهما قال بت عند خالتي ميمونة فذكر حديثا طويلا فيه نضح الفرج عقب الوضوء قال بن ابي حاتم في العلل قال ابي هذا حديث منكر وابراهيم هذا مجهول
  ابراهيم بن فهد بن حكيم البصري عن قرة بن حبيب وغيره قال بن عدي ساءر احاديثه مناكير وهو مظلم الامر كان بن صاعد اذا حدثنا عنه ينسبه الي جده لضعفه اخبرني احمد بن عبد الرحمن انا جعفر الهمداني انا السلفي اخبرتنا لامعة بنت السعيد انا ابو سعيد بن حسنويه الكاتب انا احمد بن ابراهيم بن افرجه ثنا ابراهيم بن فهد بن حكيم ثنا محمد بن عبيد بن حساب ثنا سفيان بن موسي ثنا ايوب عن نافع عن بن عمر رضي الله عنهما مرفوعا من زارني في المدينة فمات بها كنت له شهيدا او شفيعا يوم القيامة اخرجه الترمذي من حديث ايوب وصححه دون لفظة زارني انتهي قال الترمذي ثنا محمد بن بشار ثنا معاذ بن هشام حدثني ابي عن ايوب عن نافع عن بن عمر رضي الله عنهما قال قال رسول الله صلي الله عليه وسلم من استطاع ان يموت بالمدينة فليمت بها فاني اشفع لمن يموت بها ورواه الصلت بن مسعود الجحدري ومحمد بن عبد الله الرقاشي عن سفيان بن موسي بلفظ هشام فالظاهر ان الزيادة من مفردات بن فهد وليس بعمدة مع ان بن حبان قال في الثقات ابراهيم بن فهد بن حكيم الناجي من اهل البصرة يروي عن ابي عاصم روي عنه البصريون ولكن قال ابو نعيم في تاريخ اصبهان ابراهيم بن فهد بن حكيم بن ابراهيم بن قدامة بن ماهان البصري ابو اسحاق قدم اصبهان وحدث بها توفي سنة اثنين وثمانين وماءتين وقيل توفي سنة خمس وسبعين وماءتين ضعفه البردعي ذهبت كتبه وكثر خطاءه لرداءة حفظه حدث عنه اسحاق بن ابراهيم بن جميل وغيره وقال ابو الشيخ قال البردعي ما رايت اكذب منه قال ابو الشيخ وكان مشاءخنا يضعفونه وروي الدارقطني في غراءب مالك عن محمد بن بكر بن داسة اجازة انا ابو داود وابراهيم بن فهد قالا ثنا القعنبي عن مالك عن نافع عن بن عمر رفعه لا يحل لمسلم ان يهجر اخاه فوق ثلاثة ايام وقال هذا باطل بهذا الاسناد وابن داسة ثقة ولعله دخل عليه حديث في حديث او توهمه فمر فيه انتهي والظاهر انه اخطا في ضم ابي داود الي بن فهد 
  ابراهيم بن فهد الكوفي ذكره الطوسي في رجال الشيعة وقال روي عن محمد بن عقبة روي عنه عبد العزيز بن يحيي
  ابراهيم بن فورويه في ابراهيم بن ناصح
  ابراهيم بن ابي الفياض المصري قال ابو سعيد بن يونس روي عن اشهب مناكير انتهي قال بن ابي يونس واسم ابي الفياض عبد الرحمن بن عمرو من اهل برقة توفي ابراهيم بمصر في شعبان سنة خمس واربعين وماءتين قلت وروي عنه محمد بن عبد السلام الخشني فقال ثنا الشيخ الصالح ابراهيم وله ذكر في ترجمة سليمان بن بزيع سياتي ان شاء الله تعالي
  ابراهيم بن القاسم بن علي بن حسن بن ابي بكر بن هارون بن نفيع السكاكي ذكره ابو الحسن بن بابويه في تاريخ الري وقال كان من شيوخ المعتزلة روي عن الحسين بن محمد المءدب روي عنه عبد الرحمن بن الحسن بن احمد الخزاعي ويحيي بن الحسين بن اسماعيل وغيرهما
  ابراهيم بن قتيبة الاصفهاني ذكره الطوسي في مصنفي الشيعة الامامية
  ابراهيم بن قدامة الجمحي مدني لا يعرف عن الاغر عن ابي هريرة رضي الله عنه مرفوعا كان يقلم اظفاره ويقص شاربه قبل ان يخرج الي الجمعة رواه البزار من رواية عتيق بن يعقوب عنه وهو خبر منكر قال البزار ابراهيم ليس بحجة انتهي وذكره بن القطان فقال ابراهيم لا يعرف البتة وقد ذكره بن حبان في الثقات وقال روي عنه بن ابي فديك 
  ابراهيم بن قطن القيرواني المهدي ذكره الزبيدي في طبقات النحاة وقال كان يري راي الخوارج الاباضية
  ابراهيم بن قعيس عن نافع مدني قال ابو حاتم ضعيف الحديث انتهي وذكر البخاري فلم يجرحه وذكره بن حبان في الثقات وقال كنيته ابو اسماعيل روي عنه سليمان التيمي واخرج حديثه في صحيحه وقال بن ابي حاتم رايت ابي قد جعل ابراهيم صاحب مطبخ عبد الحميد وابراهيم الكوفي ابو اسماعيل الذي يروي عن ابي واءل وابراهيم قعيس كل هءلاء واحد قلت وقعيس لقب ابراهيم وهو ابراهيم بن اسماعيل واما بن ابي حاتم في ابراهيم الذين لا ينسبون وسمي اباه اسماعيل ابو احمد الحاكم وابن حبان واما البخاري فقال ابراهيم بن قعيس ويقال ابراهيم قعيس قلت فلعله كان يلقب قعيسا وكذلك ابوه فيجتمع الاقوال
  ابراهيم بن ابي المكرم الجعفري ذكره النجاشي في رجال الشيعة وقال روي عن علي بن موسي الرضا
  ابراهيم بن ابي الليث حدث ببغداد عن عبيد الله الاشجعي متروك الحديث قال صالح جزرة كان يكذب عشرين سنة واشكل امره علي احمد وعلي حتي ظهر بعد وقال ابو حاتم كان بن معين يحمل عليه والقواريري احب الي منه وقال بن معين ثقة لكنه احمق وقال زكريا الساجي متروك قلت توفي سنة اربع وثلاثين وماءتين انتهي وبقية كلام بن ابي حاتم وكان احمد بن حنبل يحمل القول فيه وقال ابراهيم بن الجنيد عن بن معين كذاب خبيث وقال عبد الله بن احمد بن ابراهيم الدورقي اول من فطن له انه يكذب ابي وقال يعقوب بن شيبة كان اصحابنا كتبوا عنه ثم تركوه وكانت عنده حتي تخطي الي احاديث موضوعة وقال النساءي ليس بثقة وقال بن سعد كان صاحب سنة ويضعف في الحديث وقال ابو داود عن يحيي بن معين افسد نفسه بخمسة احاديث ثم فسرها ابو داود وهي حديث هشيم عن يعلي بن عطاء في الرءية وحديث شريك عن سالم عن سعيد موقوف وحديث ابراهيم بن سعد في الرءية وحديث هشيم عن منصور عن الحسن عن ابي بكرة الحياء من الايمان وحديث تفترق هذه الامة علي بضع وسبعين فرقة اشرها قوم يقيسون الامور باراءهم الحديث قلت واسم ابيه نصر وذكره بن حبان في الثقات وقال ثنا ابو يعلي 
  ابراهيم بن مالك الانصاري البصري عن حماد بن سلمة وغيره قال بن عدي احاديثه موضوعة ثنا احمد بن عيسي الخشاب وليس بعمدة ثنا ابراهيم بن مالك ثنا حماد بن زيد عن ايوب عن الحسن عن ابي هريرة رضي الله عنه مرفوعا هذا جبراءيل يخبرني عن الله ما احب ابا بكر وعمر الا مءمن تقي ولا ابغضهما الا منافق شقي ثم ساق له حديثين من هذا الجنس وعندي ان ابراهيم هذا هو بن البراء المذكور دلسوه ونسبوه الي الجد الاعلي انتهي وقد ذكره الخطيب في الموضح ان بن عدي فرق بين ابراهيم بن البراء وابراهيم بن مالك فوهم وهما واحد قال وكذا فعل الدارقطني في الرواة عن مالك فوهم ايضا
  ابراهيم بن مالك عن ابي واءل عن حذيفة مرفوعا اتاني جبراءيل بمراة الحديث بطوله وهذا لا يدري من هو
  ابراهيم بن المتوكل الكوفي ذكره الطوسي في رجال الشيعة من اصحاب جعفر الصادق 
  ابراهيم بن المثني الكوفي ذكره الليثي في رجال الشيعة من اصحاب جعفر الصادق
  ابراهيم بن محشر البغدادي روي عن جرير بن عبد الحميد وغيره قال بن عدي له احاديث منكرة من قبل الاسناد منها ثنا ابو معاوية عن الاعمش عن ابي صالح عن ابي هريرة مرفوعا الرهن محلوب ومركوب فتفرد برفعه ومنها ما حدثنا وكيع عن سعيد بن بشير عن قتادة عن ابي الشعثاء عن بن عباس رضي الله عنهما الختان سنة للرجال ومكرمة للنساء ذكره بن عدي وهو صويلح في نفسه انتهي حديثه عال في جزء هلال الحفار توفي سنة اربع وخمسين وماءتين وقال بن حبان في الثقات يخطء وقال ابو العباس السراج سمعت الفضل بن سهل يتكلم فيه ويكذبه وقال بن عقدة فيه نظر وقال ابو احمد الحاكم سكتوا عنه وقال بن عدي في ترجمة الحسن بن عبد الرحمن الاحتياطي ضعيف يسرق الحديث
  ابراهيم بن ابي محذورة ياتي في الاواخر
  ابراهيم بن محرز الجعفي ذكره الطوسي في رجال الشيعة من اصحاب جعفر
  ابراهيم بن محمد بن هارون التميمي همداني سكن عبادان كتبت عنه شيءا يسيرا وكان ضعيفا متشيعا يجالس اهل البدع وكان صدوقا قاله مسلمة بن قاسم في كتاب الصلة
  ابراهيم بن محمد بن ابراهيم بن الحارث التيمي عن ابيه وعنه موسي بن عبيدة قال ابو حاتم منكر الحديث وقال البخاري لم يثبت حديثه وقال الدارقطني وغير ضعيف انتهي واشار البخاري الي ان سبب ضعفه ضعف موسي بن عبيدة وكذا قال بن حبان في الضعفاء لا ادري البلية منه او من موسي واورد له العقيلي عن ابيه عن جابر يرفعه لا تجعلوني كقدح الراكب
  ابراهيم بن محمد بن ايوب الخراساني قال مسلمة في الصلة مجهول 
  ابراهيم بن محمد بن ابان روي عنه ابو معشر يوسف بن يزيد قال الازدي منكر الحديث
  ابراهيم بن محمد بن ابراهيم البزار بغدادي عن يعقوب الدورقي قال الحسن بن علي الزهري ليس بالمرضي انتهي واعاده المءلف في اواخر الاباره وقال نقل حمزة السهمي كذا لعله جميع ابراهيم تلبيسه وحمزة انما نقله عن الحسن الزهري المذكور
  ابراهيم بن محمد بن عاصم لا يعرف له في تلقين الميت لا اله الا الله عن ابيه عن حذيفة وعنه عبد الرحمن بن الوليد ولا يعرف ايضا انتهي قال العقيلي مجهول في النقل وحديثه غير محفوظ
  ابراهيم بن محمد بن ابي عاصم عن موسي بن وردان ذكره الساجي في المكيين من الضعفاء وقال بن المبارك قال البناني في الحافل اخطا فيه الساجي والصواب انه بن عطاء بدل بن ابي عاصم وهو الاسلمي المشهور وحديثه عن موسي بن وردان من رواية بن جريج عنه معروف وكان بن جريج يقول في ابراهيم بن محمد بن ابي يحيي بن ابي عطاء بغير كنية جده تدليسا فوقع في نسخة الساجي بن ابي عاصم فظنه اخر فترجم له في المكيين لرواية بن جريج عنه وذكره في المدنيين علي الصواب في الكتب والبلد
  ابراهيم بن محمد بن مروان عرف بالعتيق عن يعلي بن عبيد وطبقته وعنه بن صاعد وابن مخلد قال البرقاني سمعت الدارقطني يقول غمزوه قلت مات سنة ثلاث وستين وماءتين 
  ابراهيم بن محمد بن يوسف الانصاري الخزرجي الاندلسي يعرف بالقطيعي روي عن بن ابي محمد بن السيد وشريح بن محمد وابي بكر بن العربي وابي الحسن بن مغيث وغيرهم واجاز له ابو عمران بن ابي تليد وابو بكر بن غالب بن عطية وابو الوليد بن رشد قال بن الابار رحل حاجا فلقيه علي ما زعم ابو القاسم عيسي بن عبد العزيز المعروف بالوجيه السريشي وادعي الاكثار عنه في السماع منه ووقفت علي ذلك برنامجه وانا برء من عهدته لعدم الاحاطة بما فيه من المناكير ولهذا الشيخ من التخليط والغلط الذي لا يقع فيه احد ممن يزاول هذه الصناعة ادني مزاولة عفا الله تعالي عنه وسمح له انتهي كلامه وهو يوهم ان الجرح في الشيخ وليس كذلك وانما هو في الذي ادعي الرواية عنه وهو عيسي وسياتي في ترجمته ايضاح ذلك وانما ذكرته لرفع الوهم المذكور
  ابراهيم بن محمد بن اسماعيل المسمعي بصري عن ابي الوليد ومسلم وعنه ابو بكر الشافعي قال الدارقطني ضعيف
  ابراهيم بن محمد بن اسماعيل بن ابي عبادة عن مسلم بن ابراهيم وابراهيم بن محمد بن صدقة العامري عن مروان بن معاوية ضعفه الدارقطني انتهي وقد كرر المءلف الراوي عن مسلم
  ابراهيم بن محمد الاشعري القمي ذكره ابو جعفر الطوسي في مصنفي الشيعة الامامية روي عن جعفر الصادق وغيره روي عنه الحسن بن علي بن فضال وغيره
  ابراهيم بن محمد بن شهاب ابو الطيب ذكره النديم في مصنفي المعتزلة وقال مات في حدود سنة خمسين وثلاث ماءة
  ابراهيم بن ابي ثابت محمد بن عبد العزيز بن عمر الزهري المدني عن ابيه واه قال بن عدي عامة حديثه مناكير وقال البخاري سكتوا عنه وبمشورته جلد مالك حدثنا عنه ابراهيم بن المنذر وقال الزبير بن بكار حدثني ابراهيم عن ابيه عن الزهري عن عروة عن عاءشة رضي الله عنها قالت دثر مكان البيت فلم يحجه هود ولا صالح حتي بواه الله لابراهيم حدثنا الزبير ثنا ابراهيم بن محمد بن عبد العزيز بن عمر بن عبد الرحمن بن عوف ابو اسحاق عن ابيه عن محمد بن عبد الله بن عمرو عثمان عن سهيل عن ابيه عن ابي هريرة رضي الله عنه رفعه اذا وجد احدكم لاخيه بن نصحا في قلبه فليذكره له انتهي وقال بن عدي هو ابراهيم بن محمد بن عبد العزيز بن عمر بن عبد الرحمن بن عوف وقال بن حبان هو الذي يقال له بن ابي ثابت تفرد باشياء لا يعرف حتي خرج عن حد الاحتجاج به مع قلة تيقظ وقال بن عدي لا يشبه حديثه حديث اهل الصدق 
  ابراهيم بن محمد بن ثابت الانصاري شيخ لعمرو بن ابي سلمة التنيسي روي مناكير انتهي ذكره بن عدي فقال مدني روي عنه مناكير وساق له ثلاثة ثم قال وله غير ذلك واحاديثه صالحة محتملة واخرج الطبراني في الصغير من طريق عمرو بن ابي سلمة عن ابراهيم بن محمد البصري عن علي بن ثابت عن بن سيرين عن ابي هريرة رفعه يا ابا هريرة اذا توضات فقل بسم الله والحمد لله الحديث وهو منكر وذكره بن حبان في الثقات وقال صديق عمرو بن ابي سلمة روي عن محمد بن مالك عن البراء وسياتي في ابراهيم بن محمد المقدسي
  ابراهيم بن محمد بن عبد الله بن محمد بن علي بن عبد الله بن عباس بن عبد المطلب المعروف بابن شكله وابوه هو الخليفة المهدي بن المنصور وكان يلقب التنين لعظم جثته روي عن المبارك بن فضالة وحماد بن يحيي الابح وغيرهما روي عنه بن هبة الله وخليفة بن خياط وحميد بن فروة واحمد بن الهيثم وغيرهم وكان مولده في سنة  وساق بن عساكر من طريق ابي القاسم التنوخي اظنه من كتاب الطوالات له بسند له الي احمد بن الهيثم قصة لابراهيم فمنها انه حكي في سبب ولاية اخيه الرشيد له امرة دمشق في منام زعم ان كلا منهما راي المهدي في النوم واخبرهما بما وقع بعد ذلك ومن جملتها انه استاذن الرشيد ان يسافر معه الي الشام باناس كان يانس بهم منهم ديبة المدني وكان راوية لربيعة ومالك وابن ابي ذيب ومنهم عبد الله بن منازة مولي المنصور وولد اشعب فذكر الخبر كله لما ولي المامون ولاية العهد بعده لعلي بن موسي الرضا انف بنو العباس من ذلك وبايعوا ابراهيم بالخلافة عوض المامون وذلك في المحرم سنة  ولقب المرضي وقيل المبارك واقام مدة ثم ادبر امره وجاء المامون من خراسان الي بغداد فصلي ابراهيم صلاة العصر ووافي جيش المامون فتغيب ابراهيم وكانت مدته دون السنة ثم ظفر به فعفا عنه وذلك في سنة عشرة وكان قد تعلم الغنا ففاق فيه اقرانه فاستمر يخدم المامون ومن بعده واستمر بزي المغنيين وله في ذلك اخبار كثيرة واورد منها ابو الفرج في الاغاني شيءا كثيرا وقال المرزباني كان شاعرا مطبوعا مكثرا من احسن الناس غناء واعلمهم به وقال يعقوب بن سفيان في تاريخه انه حج بالناس سنة  في خلافة اخيه الرشيد قال ابو حسان الزيادي في تاريخه مات ابراهيم بن المهدي في خلافة المعتصم في شهر رمضان سنة اربع وعشرين وماءتين 
  ابراهيم بن محمد الامدي الخواص احد الزهاد قال بن طاهر احاديثه موضوعه قلت روي عن الحسن الزعفراني حديثا باطلا انتهي وروي الحاكم من طريقه عن احمد بن محمد السوسي عن الليث عن مالك وربيعة عن نافع عن بن عمر رضي الله عنهما حديث فيم يختصم الملا الاعلي بطوله وقال لم يكتبه من  هذا الوجه الا بهذا الاسناد والحمل فيه علي ابراهيم بن محمد الخواص قلت ليس الخواص هذا هو الزاهد المشهور كما افهمه كلام الذهبي فان اسم والد الزاهد احمد وقرر نسبه علي ذلك بن الجوزي في الموضوعات وقال ان الزاهد ثقة وان هذا سمي نفسه الخواص تلبيسا والله اعلم لكن قال الحاكم في سءالات مسعود ابراهيم بن محمد الخواص شيخ من اهل امد مذكور بالزهد متروك في الحديث والرواية والله اعلم وقال مسلمة في الصلة مات ابراهيم الخواص بالري سنة خمس وثمانين وماءتين وقال حمزة السهمي حدثنا ابو القاسم اسماعيل بن احمد بن محمد الاجري برباط دهستان وكان ثقة ثنا ابو اسحاق ابراهيم بن محمد الخواص برباط امد ثنا الزعفراني ثنا الشافعي حدثني مالك عن ربيعة عن نافع عن بن عمر رضي الله عنهما قال لما انزل الله تعالي اقرا باسم ربك قال رسول الله صلي الله عليه وسلم لمعاذ اكتبها يا معاذ فاخذ معاذ اللوح والقلم والنون وهم يقولون اللهم ارفع به ذكرا اللهم احطط به وزرا اللهم اغفر به ذنبا قال معاذ فسجدت واخبرت رسول الله صلي الله عليه وسلم فسجد قال بن ماكولا في ترجمة الاجري روي عن الخواص عن الزعفراني حديثا منكرا الحمل فيه علي الخواص لان رجاله كلهم ثقات واختصر ذلك من كلام الخطيب بعد سياقه من طريق حمزة وساق معه حديثا اخر بالسند المذكور في سءال العفو والعافية وقال الحمل فيها علي الخواص قلت وروينا في كتاب الماءتين لابي عثمان اسماعيل بن عبد الرحمن الصابوني النيسابوري انا ابو القاسم بن حبيب المفسر انا ابو الحسين محمد بن محمد بن علي بن الشاه المروزي ثنا ابو اسحاق ابراهيم بن محمد الخواص بامد ثنا ابو بكر محمد بن عبد الملك بن زنجويه ثنا عبد الرزاق عن معمر عن الزهري عن انس سمعت رسول الله صلي الله عليه وسلم يقول اذا كان يوم القيامة شققت القبور عن قوم فخلع عليهم الخلع وقدم لهم النجاءب علي ظهورها زرابي الدر مفروشة بالعبقري فذكر حديثا طويلا في نحو ورقتين وقال في اخر قال الخواص قلت لابي بكر بن زنجويه انت سمعت من عبد الرزاق هذا الحديث قال اي والله الذي لا اله الا هو وقال ابو عثمان هذا الحديث غريب عجيب مضطرب ان كان له اصل معتمد فان رواته كلهم ثقات الا الخواص فانه لا يعتمد ولا يقبل منه ما ينفرد به وله مناكير كثيرة وهذا منها وان كان استاذنا ابو القاسم بن حبيب يعجب بهذا الحديث ولعله لم يعرف انه لا اصل له والله اعلم 
  ابراهيم بن محمد بن معروف ابو اسحاق الراسبي حدث عن سمنون المحبر وعنه القاضي ابو الحسن الشرواني وهذا كذاب فكانه اختلق اسم هذا
  ابراهيم بن محمد بن جبير بن مطعم عن ابيه عن جده مجهول الحال له عند الطبراني في الكبير حديث واحد وقال ليس له غيره
  ابراهيم بن محمد بن الحسن الاصبهاني الطيان حدث عن حسين بن القاسم الزاهد الاصبهاني حدث بهمدان فانكروا عليه واتهموه واخرج انتهي وقال بن الجوزي في الموضوعات قال بعض الحفاظ لا تجوز الرواية عنه والملقب به واسم جده فيره بالكسر وفتح الراء الخفيفة روي ايضا عن محمد بن اسماعيل البخاري قاله شيرويه قال وروي عن سمويه ورسته وهناد بن السري وغيرهم وروي عن الحسين بن القاسم الزاهد الاصبهاني قال ابو جعفر سالت عنه باصبهان فلم يعرفوه ولا شيخه الحسين ولا التفسير الذي رواه قال الشيرازي في الالقاب حدثني ابو علي احمد بن علي بن عبد الرحيم انا علي بن حفص الاردبيلي حدثني ابراهيم بن محمد الطيان الاصبهاني وكتبت في ابراهيم الي محمد بن يحيي بن مندة وسالت عنه فلم يحمده قال ثنا محمد بن اسماعيل البخاري فذكر حديثا 
  ابراهيم بن محمد بن الحسن بن يعقوب بن خالد بن رفاعة بن ابي فريعة السلمي عن اخيه سوار بن محمد وعنه محمد بن عمرو المكي ياتي في جده الاعلي خالد بن رفاعة بن ابي فريعة
  ابراهيم بن محمد الثقفي عن يونس بن عبيد قال بن ابي حاتم هو مجهول وقال البخاري لم يصح حديثه قلت يعني ما رواه بن وهب انبانا سعيد بن ابي ايوب عن ابراهيم بن محمد عن هشام بن ابي هشام عن امه عن عاءشة رضي الله عنها في الاسترجاع لتذكر المصيبة انتهي قال البخاري في التاريخ قال لي احمد بن صالح ثنا بن وهب فذكر الحديث وقال بعده وهشام هذا ابو المقدام لم يصح حديثه فالضمير يعود الي هشام لا الي ابراهيم كما يفهم من كلام المصنف والله اعلم وقال بن حبان في الثقات ابراهيم بن محمد الثقفي يروي عن هشام بن عروة روي عنه سعيد بن ابي ايوب قلت وقوله بن عروة وهم والله اعلم وقال بن عدي ابراهيم بن محمد الثقفي عن يونس بن عبيد لم يصح حديثه قال البخاري قال بن عدي ولم ار له رواية انكرها
  ابراهيم بن محمد بن سعيد بن هلال بن عاصم بن سعد الثقفي يروي عن اسماعيل بن ابان وغيره قال ابو نعيم في تاريخ اصبهان كان غاليا في الرفض ترك حديثه وذكره الطوسي في رجال الشيعة وقال كان اولا زيد ياثم صار اماميا قال وكان سبب خروجه من الكوفة الي اصبهان انه صنف كتاب المناقب والمثالب فاشار عليه بعض اهل الكوفة ان يخفيه ولا يظهره فقال اي البلاد ابعد عن التشيع فقالوا له اصبهان فحلف الا يخرجه ويحدث به الا باصبهان تقع منه بصحة ما اخرج فيه فتحول الي اصبهان وحدث به فيها قال ومات باصبهان سنة ثمانين وماءتين حدث عن ابي نعيم وعباد بن يعقوب والعباس بن بكار وهذه الطبقة ومن تصانيفه كتاب المغازي كتاب السقيفة كتاب الردة كتاب الشوري كتاب مقتل عثمان كتاب صفين كتاب الحكمين كتاب النهروان كتاب مقتل علي كتاب مقتل الحسين كتاب التوابين كتاب اخبار المختار كتاب السراءر كتاب المعرفة كتاب الجامع الكبير في الفقه كتاب فضل الكوفة ومن نزلها من الصحابة كتاب الدلاءل كتاب من قتل من ال محمد كتاب التفسير وغير ذلك روي عنه احمد بن علي الاصبهاني والحسين بن علي بن محمد الزعفراني ومحمد بن زيد الرطال واخرون وكان اخوه علي قد هجره وباينه بسبب الرفض قلت ارخ الطوسي وفاته سنة ثلاث وثمانين وماءتين 
  ابراهيم بن محمد المقدسي شيخ روي عنه عبد الله بن محمد المسندي ضعفه ابو حاتم انتهي قال بن ابي حاتم روي عن محمد بن مالك خادم البراء بن عازب روي عنه محمد بن عوف الحمصي سالت ابي عنه فقال كان يسكن بيت المقدس ضعيف الحديث مجهول قلت وذكره بن حبان في الثقات والبخاري في تاريخه ووصفاه بانه صديق ابي حفص التنيسي وزاد البخاري ان التنيسي وثقه وما وري عنه الجعفي الا بواسطة التنيسي
  ابراهيم بن محمد بن عبد الرحمن بن وثيق الاردبيلي ولد سنة سبع وستين وخمس ماءة وارخه بن مهدي عنه سنة خمسين واخذ القراءات عن اصحاب شريح وحدث بالتيسير عن بن زرقون اجازة عن الخولاني اجازة عن الداني وتصدي للاقراء وكان اماما مجودا اقرا عليه العماد بن ابي زهران الموصلي والثور بن ظهير الكفتي وجماعة منهم الفخر التوزري واخرهم محمد بن علي الزبير الجبلي شيخ شيوخنا بالاجازة الذي مات سنة احدي وسبعين وسبع ماءة قال ابو بكر بن مهدي كان ظاهر السلامة متحريا ثم اخبرت عنه بخلاف ذلك ثم رايت له تخليطا وتخاريج بمعزل عن الصدق والاتقان ثم قال انشدنا بن وثيق قبل ان يختلط ومات بالاسكندرية في ربيع الاخر سنة اربع وخمسين وست ماءة قلت واجازه بوجهه بنت الصعيدي شيخة شيوخنا 
  ابراهيم بن محمد العكاشي قال احمد بن صالح والفريابي كان كذابا نقله بن الجوزي انتهي وقد تقدم ابراهيم بن عكاشة فكانه هذا
  ابراهيم بن محمد العمري الكوفي عن ابي كريب قال ابو احمد الحاكم فيه نظر وقال الخطيب هو ابراهيم بن محمد بن ابراهيم بن محمد بن ابراهيم بن واقد بن محمد بن زيد بن عبد الله بن عمر بن الخطاب كوفي يروي عن جماعة وعنه بن المظفر والدارقطني قال محمد بن احمد بن حماد الحافظ كان احد الوجوه تكلم فيه بالكوفة وببغداد مات سنة عشرين وثلاث ماءة
