  AUTO الواو مع الجيم

 " الوجاء" (¬) هو نوع من الخصاء، وهو رض الانثيين. وقيل: غمز عروقهما.
 و"الخصاء" (¬): شق الخصيتين واستخراجهما، والجب: قطع ذلك من اصله، شبه الصوم في قطعه غلمة النكاح وكسره لشهوته بالوجاء الذي يقطع مثل ذلك (¬) من الموجوء.
 قوله (): "فوجات في عنقها" (¬) (اي: دفعت) (¬).
 "وحديدته في يده، يجا بها" (¬) اي: يطعن ويشق، وقال الخليل: وجاه: ضرب عنقه.
 قوله في التمر: "فليجاهن بنواهن" (¬) اي: يدقهن.
 قوله: "فاذا وجب فلا تبكين باكية" (¬)، فسره في الحديث: "اذا مات".
 قوله: "فقد اوجب" (¬) اي: وجبت له الجنة او النار. (وكذلك:



 "موجبات رحمتك" (¬) اي: ما اوجب الله عليه الجنة) (¬) وكذلك موجبات نقمتك.
 قوله: "ان (¬) صاحبنا اوجب" (¬) اي: كسب خطيءة يستوجب بها عقوبة النار. قال ابو عبيد: هذا من اعجب ما يجء من الكلام، يقال للرجل: قد اوجب، وللحسنة والسيءة: قد اوجبت (¬).
 قوله في الذي قرا: {قل هو الله احد} [الاخلاص: ] "وجبت" (¬) يعني: الجنة، وكذلك في الميت الذي (¬) اثني عليه: "وجبت" (¬) اي: الجنة.
 وقيل: الشهادة، اي: حقت وثبتت.
 قوله: "اذا سمع وجبة" (¬) هي الوقعة والهدة. وقيل: سقوطها، من قوله: {فاذا وجبت جنوبها} [الحج: ].



 و"وجوب الشمس" (¬): سقوطها في المغرب، ووجب الشء وجوبا: لزم، والواجب من اوامر الله ورسوله ما توعد علي تركه بالعقاب.
 و"غسل الجمعة (¬) واجب كغسل الجنابة" (¬) اي: كصفة غسل الجنابة لا كوجوبه في الالزام.
 و"الوتر واجب" (¬) اي: مءكد الامر عند مالك، وعلي ظاهره عند اهل العراق، والدليل عند مالك مقارنته (¬) للسواك والطيب وعطفهما عليه، ووجوب البيع والنكاح انعقادهما ولزومهما، يقال: وجب البيع والحق جبة ووجوبا: لزوما (¬)، (والشء وجب: سقط) (¬).
 قوله: "وكنت اوجد عليه" (¬) يقال: وجدت (¬) عليه وجدا وموجدة (في نفسي) (¬) اذا غضبت عليه، ووجدت عليه وجدا: حزنت، ووجدت من الحب وجدا، كله بالفتح، ووجد من الغني جدة، ووجدا بالضم،   ووجدانا لغة، وقد (¬) قرء: (حيث سكنتم من وجدكم) [الطلاق: ] بالكسر (¬)، ومنه: "لي الواجد" (¬) يعني (¬): الغني. ووجدت ما طلبت وجدانا ووجودا، ومنه: "ايها الناشد غيرك الواجد" (¬).
 ومعني "كنت اوجد عليه": اكثر موجدة.
 قوله في الانصار: "وكانهم وجدوا اذ لم يصبهم ما اصاب الناس" (¬) (اي: غضبوا) ()، كذا (عند كافتهم) (¬): وكرر الكلام مرتين، وعند ابي ذر (في الاولي) (¬): "كانهم وجد" (¬) اي: غضاب، وبه (¬) تظهر فاءدة التكرار.
 قوله (¬): "فمن وجد منكم شيءا بماله فليبعه" (¬) معناه: اغتبط به واحبه.



 قوله: "من شدة (¬) موجدة امه" اي: من حبها اياه وحزنها لبكاءه، وروي: "من وجد امه" (¬).
 قوله: "فاوجروها" (¬) الوجور: ما صب في فم (¬) المريض، كما ان اللدود: ما صب في احد جانبي فمه، يقال منه: وجرت واوجرت.
 و"الواجم" (¬): المهتم، وجم يجم وجوما: هو ظهور الحزن، وتقطيب الوجه مع ترك الكلام.
 و"مشرف الوجنتين" (¬) اي: عالي عظام الخدين، يقال: وجنة ووجنة ووجنة ووجنة ووجنة، واجنة بهمزة مضمومة.
 قولها: "يريبني في وجعي" (¬) العرب تسمي كل مرض وجعا، ومنه قولها: "ان ابن اختي وجع" (¬) كذا لاكثرهم، وعند ابن السكن في باب استعمال فضل وضوء الناس: "وقع" (¬)، وهو بمعني: "وجع" اي: مشتك مريض.



 قوله: "مما لم يوجف عليه" (¬) اي: لم يءخذ بغلبة جيش، واصله من الايجاف في السير وهو الاسراع.
 قوله: "والطاءفة الاخري وجاه العدو (¬) " (¬) بالضم والكسر، وهي المقابلة.
 قوله: "وعمر ثجاهه" (¬) اي: مقابلته وتلقاء وجهه، والجهة: النحو والمقصد الذي يستقبله.
 قوله: "وجهت لي ارض" (¬) اي: اريت وجهها وامرت باستقبالها وقصدها، ووجهت الي الشء: استقبلته، ومنه: وجه نحو الكعبة.
 قوله: "وجه هاهنا" (¬) اي: توجه، وقيده بعض شيوخنا: "وجه" بسكون الجيم، اي: هذه الجهة، ورجحه بعضهم.
 قوله: "اين توجه؟ " (¬) اي: تصلي وتوجه وجهك.
 قوله: "هذا وجهي اليه" (¬) اي: قصدي.



 قوله: "ذو الوجهين لا يكون وجيها عند الله" (¬) هو الذي يظهر لكل طاءفة وجها؛ يرضيها به، ويوهمها انه عدو للاخري، ويبدي لهم مساوءها، والوجيه: ذو القدر والمنزلة، يقال منه: وجه الرجل  بالضم  وجاهة، بالفتح.
 قوله: "وكان لعلي وجه في الناس" (¬) اي: جاء زاءد علي قدره لاجلها، ومنه: "نري لك وجها عند هذا الامير" (¬).
 قوله: "ما يشاء احد منا ان (¬) يقتل احدا الا قتله، ما احد منهم يوجه الينا شيءا (¬) " (¬) اي: ياتينا به، ويقصدنا من مراجعة او قتال.



 "حيث توجهت" (¬): حيث قصدت واستقبلت بوجهها، ومنه في اشعار البدن: "وهو موجه الي القبلة" كذا لابي عيسي، وعند غيره من شيوخنا: "وهو موجه" بالفتح (¬).
 قوله: "واخبرهم بوجهه الذي يريد" (¬) اي: بقصده (¬)، ويروي: "بوجهتهم" وهما سواء.

  AUTO الاختلاف

 قوله (¬): "ما احد اشد عليه الوجع من رسول الله  صلي الله عليه وسلم " (¬) ثم قال: "في رواية عثمان، مكان الوجع: وجعا" (¬) كذا جاء وفيه اشكال، وصوابه: "مكان [عليه] (¬) الوجع: وجعا" وبه يستقل الكلام وينفهم، فيكون: "ما احد (¬) اشد وجعا من رسول الله  صلي الله عليه وسلم  ".
 قوله: "اذا تواجه المسلمان" (¬) اي: ضرب كل واحد منهما (¬) وجه   صاحبه، (كذا الرواية المعروفة، وعند العذري: "اذا توجه" اي: قصد وجه صاحبه) (¬) واستقبله بوجهه.
 قوله (¬): "فقالوا خرج وجه هنا" (¬) كذا لاكثرهم، اي: توجه، وقيدناه عن الاسدي: "وجه" بالسكون، وقد تقدم تفسيره.
