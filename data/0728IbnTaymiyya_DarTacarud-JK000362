 وفي الصحيحين وغيرهما في حديث التجلي الطويل المشهور الذي  روي عن النبي صلي الله عليه وسلم من وجوه متعددة فهو في الصحيحين من حديث ابي هريرة وابي سعيد وفي مسلم من حديث جابر ورواه احمد من حديث ابن مسعود وغيره قال في حديث ابي هريرة قال او لست قد اعطيت العهود والمواثيق ان لا تسال غير الذي اعطيت فيقول يا رب لا تجعلني اشقي خلقك فيضحك الله تبارك وتعالي منه ثم ياذن له في دخول الجنة $ وفي صحيح مسلم عن ابن مسعود عن النبي صلي الله عليه وسلم قال فيقول الله يا ابن ادم اترضي ان اعطيك الدنيا ومثلها معها فيقول اي رب اتستهزء بي وانت رب العالمين وضحك رسول الله صلي الله عليه وسلم فقال الا تسالوني مم ضحكت فقالوا مم ضحكت يا رسول الله فقال من ضحك رب العالمين  حين قال اتستهزء بي وانت رب العالمين فيقول اني لا استهزء بك ولكني علي ما اشاء قادر
 وفي الصحيحين عن النبي صلي الله عليه وسلم قال يضحك الله الي رجلين يقتل احدهما الاخر كلاهما يدخل الجنة قالوا كيف يا رسول الله قال يقتل هذا فيلج الجنة ثم يتوب الله علي الاخر فيهديه الي الاسلام ثم يجاهد في سبيل الله فيستشهد
 وفي الصحيح ايضا عنه صلي الله عليه وسلم قال عجب الله من قوم يقادون الي الجنة في السلاسل
 وفي حديث معروف لا يتوضا احدكم فيحسن وضوءه ويسبغه ثم ياتي المسجد لا يريد الا الصلاه فيه الا تبشبش الله به كما يتبشبش اهل الغاءب بطلعته
 وفي الصحيح عنه صلي الله عليه وسلم ايضا انه قال الدنيا حلوة خضرة وان الله مستخلفكم فيها فناظر كيف تعملون وفي لفظ  مستخلفكم فيها لينظر كيف تعملو فاتقوا الدنيا واتقوا النساء
 وفي الصحيح ايضا عنه صلي الله عليه وسلم انه قال ان الله لا ينظر صوركم واموالكم ولكن ينظر الي قلوبكم واعمالكم
 وفي الصحيحين عن ابي واقد الليثي ان رسول الله صلي الله عليه وسلم كان قاعدا في اصحابه اذ جاء ثلاثة نفر فاما رجل فوجد فرجة في الحلقة فجلس واما رجل فجلس يعني خلفهم واما رجل فانطلق فقال النبي صلي الله عليه وسلم الا اخبركم عن هءلاء النفر اما الرجل الذي جلس في الحلقة فرجل اوي الي الله فاواه الله واما الرجل الذي جلس خلف الحلقة فاستحيا فاستحيا الله منه واما الرجل الذي انطلق فاعرض فاعرض الله عنه
 وعن سلمان الفرسي موقوفا ومرفوعا قال ان الله يستحي ان  يبسط العبد يديه اليه ويساله فيهما خيرا فيردهما صفرا خاءبتين
 وفي الصحيح عنه فيما يروي عن ربه تبارك وتعالي لا يزال عبدي يتقرب الي بالنوافل حتي احبه فاذا احببته كنت سمعه الذي يسمع به وبصره الذي يبصر به ويده التي يبطش بها ورجله التي يمشي بها فبي يسمع وبي يبصر وبي يبطش وبي يمشي ولءن سالني لاعطينه ولءن استعاذني لاعيذنه وما ترددت عن شيء انا فاعله ترددي عن قبض نفس عبدي المءمن يكره الموت واكره مساءته ولا بد له منه
 وفي الحديث الصحيح عن عبادة بن الصامت عن النبي صلي الله عليه وسلم قال من احب لقاء الله احب الله لقاءه ومن كره لقاء الله كره الله لقاءه فقالت عاءشة انا لنكره الموت قال ليس ذاك ولكن المءمن اذا حضره الموت يبشر برضوان الله وكرامته واذا بشر بذلك احب لقاء الله واحب الله لقاءه وان الكافر اذا حضره  الموت يبشر بعذاب الله وسخطه فكره لقاء الله وكره الله لقاءه
 وفي الصحيحين عن البراء بن عازب عن النبي صلي الله عليه وسلم قال الانصار لا يحبهم الا مءمن ولا يبغضهم الا منافق من احبهم احبه الله ومن ابغضهم ابغضه الله
 وفي الصحيحين عن ابي سعيد عن النبي صلي الله عليه وسلم قال ان الله تبارك وتعالي يقول لاهل الجنة يا اهل الجنة فيقولون لبيك وسعديك فيقول هل رضيتم فيقولون وما لمنا لا نرضي وقد اعطيتنا ما لم تعط احدا من خلقك فيقول عز وجل انا اعطيكم افضل من ذلك قالوا يا رب واي شء افضل من ذلك قال  احل عليكم رضواني فلا اسخط عليكم بعده ابدا
 وفي الصحيحين عن انس قال انزل علينا ثم كان من المنسوخ ابلغوا قومنا انا قد لقينا ربنا فرضي عنا وارضانا
 وفي حديث عمرو بن مالك الرواسي قال اتيت النبي صلي الله عليه وسلم فقلت يا رسول الله ارض عني قال فاعرض عني ثلاثا قال قلت يا رسول الله ان الرب ليرضي فيرضي فارض عني فرضي عني
 وفي الصحيحين عن ابن مسعود قال قال رسول الله صلي الله عليه وسلم من حلف علي يمين صبر ليقتطع بها مال امرء مسلم وهو فيها فاجر لقي الله وهو عليه غضبان 
 وفي الصحيحين عن ابي هريرة عن النبي صلي الله عليه وسلم قال اشتد غضب الله علي قوم فعلوا هذا برسول الله وهو حينءذ يشير الي رباعيته
 وقال اشتد غضب الله علي رجل يقتله رسولالله في سبيل الله
 وفي صحيح مسلم عن حذيفة بن اسيد عن النبي صلي الله عليه وسلم قال اذا مر بالنطفة ثنتان واربعون ليلة بعث الله اليها ملكا فصورها وخلق سمعها وبصرها وجلدها ولحمها وعظامها ثم قال يا رب ذكر ام انثي فيقضي ربك ما شاء ويكتب الملك ثم يقول يا رب اجله فيقضي ربك ما شاء ويكتب الملك فيقول يا رب رزقه فيقضي ربك ما شاء ويكتب الملك ثم  يخرج الملك الصحيفة في يده فلا يزيد علي ما امر ولا ينقص
 وفي الصحيح عن عاءشة ان النبي صلي الله عليه وسلم كان يقول في سجوده اعوذ برضاك من سخطك وبمعافاتك من عقوبتك واعوذ بك منك لا احصي ثناء عليك انت كما اثنيت علي نفسك
 وفي حديث اخر اعوذ بكلمات الله التامة من غضبه وعقابه وشر عباده وفي الصحيحين عن انس في حديث الشفاعة عن النبي صلي الله عليه وسلم قال فاذا رايت ربي وقعت له ساجدا فيدعني ما شاء اله ان يدعني ثم يقول لي يامحمد ارفع راسك سل تعطه واشفع تشفع وذكر مثل هذا ثلاث مرات 
 وفي الصحيحين عن ابي هريرة قال قال رسول الله صلي الله عليه وسلم يتعاقبون فيكم ملاءكة بالليل وملاءكة بالنهار ويجتمعون في صلاة الفجر وصلاة العصر ثم يعرج اليه الذين باتوا فيكم فيسالهم وهو اعلم بهم كيف تركتم عبادي قالوا تركناهم وهم يصلون واتيناهم وهم يصلون
 وفي الصحيحين ايضا عن ابي هريرة عن النبي صلي الله عليه وسلم قال ان لله ملاءكة سيارة فضلا عن كتاب الناس سياحين في الارض فاذا وجدوا قوما يذكرون الله تنادوا هلموا الي حاجتكم قال فيجيءون حتي يحفون بهم الي السماء الدنيا قال فيقول الله عز وجل اي شء تركتم عبادي  يصنعون قال فيقولون تركناهم يحمدونك ويسبحونك ويمجدونك قال فيقول هل راوني قال فيقولون لا قال كيف لو راوني قال قال فكيف لو راوك لكانو اشد ذكرا قال فيقول فاي شء يطلبون قالوا الجنة قال فيقول هل راوها قال فيقولون لا قال فيقول كيف لو راوها قال فيقولون لو راوها كانوا اشد عليها حرصا واشد لها طلبا قال فيقول من اي شء يتعوذون قال فيقولون يتعوذون من النار قال فيقول وهل راوها قال فيقولون لا لو راوها كانوا اشد منها تعوذا واشد منها هربا قال فيقول اني اشهدكم اني قد غفرت لهم قال فيقولون ان فيهم فلانا الخطاء لم يردهم انما جاء في حاجة قال فيقول هم القوم لا يشقي بهم جليسهم
 وفي الصحيحين عن النبي صلي الله عليه وسلم قال ان الله  اذا احب عبدا نادي جبريل اني قد احببت فلانا فاحبه قال فيحبه جبريل ثم ينادي في السماء ان الله يحب فلانا فاحبوه فيحبه اهل السماء ثم يوضع له القبول في الارض وقال في البغض مثل ذلك
 وفي الصحيحين عنه عن النبي صلي الله عليه وسلم قال يقول الله تعالي انا عند ظن عبدي بي وانا معه حين يذكرني فان ذكرني في نفسه ذكرته في نفسي وان ذكرني في ملاء ذكرته في ملاء خير منهم وان اقترب الي شبرا اقتربت اليه ذراعا وان اقترب الي ذراعا اقتربت اليه باعا وان اتاني يمشي اتيته هرولة
 وفي صحيح مسلم عن ابي هريرة وابي سعيد انهما شهدا علي رسول الله صلي الله عليه وسلم انه قال ما جلس قوم يذكرون الله الا حفت  بهم الملاءكة وغشيتهم الرحمة وذكرهم الله فيمن عنده
 وفي الصحيحين عن ابي هريرة عن النبي صلي الله عليه وسلم ان رجلا اصاب ذنبا فقال رب اني قد اصبت ذنبا فاغفره لي فقال ربه علم عبدي ان له ربا يغفر الذنب وياخذ به قد غفرت لعبدي ثم مكث ما شاء الله ثم اذنب ذنبا اخر فقال اي رب اني قد اذنبت ذنبا فاغفره لي فقال ربه علم عبدي ان له ربا يغفر الذنب وياخذ به قد غفرت لعبدي فليعمل ما يشاء
 وفي الصحيحين عن ابي هريرة عن النبي صلي الله عليه وسلم قال يقبض الله الارض يطوي السماء بيمينه ثم يقول انا الملك اين ملوك الارض 
 وفي الصحيحين عنه عن النبي صلي الله عليه وسلم انه قال ما منكم احد الا سيكلمه ربه ليس بينه وبينه حاجب ولا ترجمان فينظر ايمن منه فلا يري الا شيءا قدمه وينظر اشام منه فلا يري الا شيءا قدمه ونظر امامه فتستقبله النار فمن استطاع منكم ان يتقي النار ولو بشق تمرة فليفعل فان لم يجد فبكلمة طيبة
 وفي صحيح مسلم عن ابي هريرة عن النبي صلي الله عليه وسلم في حديث الرءية قال فيه فيلقي العبد القول اي فل الم اكرمك واسودك وازوجك واسخر لك الخيل والابل واذرك تراس وتربع فيقول بلي يا رب قال فيقول افظننت انك ملاقي فيقول لا فيقول اني انساك كما نسيتني ثم يلقي الثاني فيقول اي فل فذكر مثل ما قال الاول ويلقي الثالث فيقول امنت بك وبكتابك وبرسولك وصليت وصمت وتصدقت ويثني بخير ما استطاع قال فيقول فههنا اذن قال ثم يقال الا نبعث شاهدنا عليك فيفكر في نفسه من الذي يشهد علي فيختم علي فيه ويقال لفخذه انطقي فتنطق فخذه ولحمه وعظامه بعمله ما كان ذلك ليعذر من نفسه وذلك المنافق وذكر الحديث 
 وفي صحيح مسلم عن انس قال كنا مع رسول الله صلي الله عليه وسلم فضحك قال هل تدرون مم اضحك قال قلنا الله ورسوله اعلم قال من مخاطبه العبد ربه يقول يا رب الم تجرني من الظلم قال فيقول بلي قال فيقول فاني لا اجيز علي نفسي الا شاهدا مني قال فيقول فكفي بنفسك عليك شهيدا وبالكرام الكاتبين شهودا قال فيختم علي فيه ويقال للاركانه انطقي فتنطق باعماله قال ثم يخلي بينه وبين الكلام قال فيقول بعدا لكن وسحقا فعنكن كنت اناضل وفي الصحيحين عن انس ان النبي صلي الله عليه وسلم قال يقول الله لاهون اهل النار عذابا يوم القيامة لو كان لك ما علي الارض من شء اكنت تفتدي به فيقول نعم فيقول له قد اردت منك ما هو اهون من هذا وانت في صلب ادم ان لا تشرك بي فابيت الا ان تشرك  وفي الصحيحين عن ابن عمر عن النبي صلي الله عليه وسلم قال يدنو احدكم من ربه حتي يضع كنفه عليه فيقول عملت كذا وكذا فيقول نعم يا رب فيقرره ثم يقول قد سترت عليك في الدنيا وانا اغفرها لك اليوم قال ثم يعطي كتاب حسناته وهو قول @QB@ هاءم اقرءوا كتابيه @QE@ سورة الحاقة  واما الكفار والمنافقون فينادون هءلاء الذين كذبوا علي ربهم الا لعنة الله علي الظالمين
 وفي صحيح مسلم وغيره عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال يقول الله يوم القيامة يا ابن ادم مرضت فلم تعدني فيقول يا رب كيف اعودك وانت رب العالمين فيقول اما علمت ان عبدي فلانا مرض فلم تعده اما علمت انك لو عدته لوجدتني عنده ويقول يا ابن ادم استسقيتك فلم تسقني فيقول اي رب وكيف اسقيك وانت رب العالمين فيقول تبارك وتعالي اما علمت ان عبدي فلان استسقاك فلم تسقه اما علمت انك لو سقيته لوجدت ذلك عندي قال ويقول يا ابن ادم استطعمتك فم تطعمني فيقول اي رب وكيف اطعمك وانت  رب العالمين فيقول اما علمت ان عبدي فلانا استطعمك فلم تطعمه اما انك لو اطعمته لوجدت ذلك عندي
 وفي الصحيحين عن ابي سعيد الخدري رضي الله عنه ان رسول الله صلي الله عليه وسلم قال ان الله يقول لهل الجنة يا اهل الجنة فيقولون لبيك ربنا وسعديك والخير في يديك فيقول هل رضيتم فيقولون ربنا وما لنا لا نرضي وقد اعطيتنا ما لم تعط احدا من خلقك فيقول ال اعطيكم افضل من ذلك قال احل عليكم رضواني فلا اسخط عليكم بعده ابدا وهذا فيه ذكر المخاطبة وذكر الرضوان جميعا
 وفي الصحيحين عن عبد الله بن مسعود عن النبي صلي الله عليه وسلم قال اخر اهل الجنة دخولا الجنة واخر اهل النار خروجا من النار رجل يخرج حبوا فيقول له ادخل الجنة فيقول ان الجنة ملاي فيقول له ذلك ثلاث مرات كل ذلك يعيد الجنة ملاي فيقال ان لك مثل الدنيا عشر مرات 
