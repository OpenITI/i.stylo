عده وهي ان كل من دفع اليه شء من قراض او وديعه علي يد بينه بقصد التوثق لا يصدق في دعوءي ( ( ( دعوي ) ) ) رده الا بينه ( ( ( ببينة ) ) ) والمراد بالبينه المقصودة للتوثق هي التي يقول شهدها ( ( ( مشهدها ) ) ) اشهدوا اني انما اشهدت خوف دعوي الرد او الحجد ( ( ( الجحد ) ) ) واما اشهادها خوف الموت او خوف دعوي التلف وما اشبهه مما يعلم انه لم يقصد به التوثق فانه يصدق في دعواه الرد وظاهر كلام المصنف كغيره انه يكفي في كونها مقصوده للتوثق قصد المودع بالكسر ولا يتوقف علي علم المودع بالفتح ان المودع بالكسر اشهد تلك البينه بقصد التوثق واما لو اشهد من قصده وفي الخطاب ( ( ( الحطاب ) ) ) ان ه يشترط في كونها للتوثق علم المودع بالفتح ان المودع بالكسر قصد بها التوثق واما لو اشهد من هي عنده ان عنده وديعه لزيد مثلا قاصدا اشهادها علي قبضها ففيه قولان احدهما انه كاشهادها المودع بالكسر فلا يصدق في دعوي الرد والثاني انه ليس كاشهادها فيصدق في دعوي الرد تنبيه مفهوم قول المصنف رددتها عليك انه لو قال رددتها لوالدك مثلا فانه لا يصدق لان دعوي الرد لليد التي لم تدفع لا تنفع قال خليل وبدعوي الرد علي وارثك والضابط ان صاحب اليد المءتمنه اذا كانت دعوي الدفع منه لليد التي اءتمنه فانه يضدق ( ( ( يصدق ) ) ) سواء كانت دعوي الدفع منه او من وارثه علي ذي اليد التي اءتمنه ( ( ( اءتمنته ) ) ) او علي وارثها وفيما عد ( ( ( عدا ) ) ) ذلك الضمان ولما كانت الدعوي ( ( ( دعوي ) ) ) التلف او الضياع مخالفة لدعوي الرد قال وان قال من عنده الوديعه ذهبت او ضاعت او هلكت بغير تقصير مني في حفظها فهو مصدق فيما ادعاه بيمنه ( ( ( بيمينه ) ) ) ان كان منهما او حقق عليه المودع بالكسر الدعوي والمتهم يغرم بمجرد نكوله وفي دعوي التحقيق لا يغرم الا بعد حلف صاحب الوديعه ومعني قوله بكل حال سواء قبضها ببينه مقصوده للتوثق ام لا كانت مما يغاب عليها ام لا قال خليل لا بدعوي التلف او الضياع او قال لا ادري متي تلفت او قال ضاعت من سنين وكنت ارجوها ولو كان صاحبها حاضرا فانه لا ضمان عليه في جميع ذلك وقيدنا بغير تقصير للاحتراز عما لو هلكت بتقصيره فانه يضكن ( ( ( يضمن ) ) ) لوجوب حفظها عليه بمجرد قبولها ولو اذن له ربها في اتلافها او كان المودع بالكسر صبيا او سفيها ونظيرها في الضمان مع الاذن من قال لاخر اقتلني او اقتل ولدي بخلاف من قال لاخر احرق ثوبي واقطع يدي فانه لا ضمان عليه مع الاذن والفرق بين ما ذكر وبين الوديعه ان الوديعه التزام حفظها بمجرد قبولها فلا يسقط عنه الاذن ولما كانت العارية  تخالف الوديعة فيما ذكر قال والعارية مخالفة للوديعة لان المستعير لا يصدق في دعوي هلاكها او ضياعها فيما يغاب عليه منها لما تقدم من ان العارية مءداه اي مضمونه وانما اعاد المصنف هذه وان قدمها في العارية لينبه علي الفرق بين الوديعة والعارية ثم شرع فيما تشترك فيه الوديعه والعارية بقوله ومن تعدي علي وديعة بان حرقها او دل لصا عليها علي المعتمد ضمنها لصاحبها ومن التعدي عليها اطلاق الفحل عليها بغير اذن صاحبها وتموت من ذلك وان عند الولاده ومنه نقلها من محل الي اخر لغير مصلحة او لها ولكن لم ينقلها نقل امثالها قال خليل لا ان انكسرت في نقل مثلها ويخلطها الا كقمح بمثله او دراهم بدنانير حيث وقع الخلط بالمثل او غيره للاحراز ولا مفهوم لقوله وديعة اذا غيرها احري في الضمان بالتعدي من عارية ورهن وغيرهما
 تنبيهان الاول علم مما ذكرنا في بيان التعدي انه لا يشترط قصد الاتلاف خلافا لظاهر لفظ المصنف بل متي حصل الاتلاف بسبب من عنده الوديعه ضمنها ولو خطا قال خليل تضمن بسقوط شء عليها من الموجع ( ( ( المودع ) ) ) بالكسر كما قاله اشهب في الذي ياتي لباءغ ( ( ( لباءع ) ) ) الخار ( ( ( الفخار ) ) ) ويقول له قلب ما يعجبك فياخذ شيءا يقلبه فيسقط من يده قهرا علي شء فيتلفه فانه يضمن قيمته ( ( ( قيمة ) ) ) المسقوط عليه من ان السقوط بغير اختياره لان الخطا والعمد في اموال الناس سواء كان يضمن ببعثها لصاحبه بغير اذنه وتضيع ( ( ( وتضييع ) ) ) من الرسول وبنسيانها في موضع ايداعها وبدخوله الحمام بها وبخروجه بها يظنها له او سافر بها او يستعملها بغير اذن صاحبه فتتلف او امره بوضعها في محل فخالف ووضعها في محل غير حرز لها او تكون في موضع فيه اغراء للسارق كوضعها في محل عليه قفلان الثاني لا يجوز لمن عنده الوديعة ايداعها عند غيره لان رب الوديعة لم يرض الا بامانته الا ان يكون ذلك الغير ممن اعتاد الايداع عنده كزوجته او امته او الا ان يحصل عذر يقتضي الايداع عند الغير ويجب عليه الاشهاد علي العذر لانه لا يكفي ان يقول اودعتها لعذر كما لا يكفي ان يقول للشهود اشهدوا اني انما اودعتها لعذر بل يجب عليه ان يشهدهم علي عين العذر ثم شرع يتكلم علي ما اذا تصرف في الوديعة بغير اذن ربها بقوله وان كانت اي الوديعة شيءا مثليا دنانيرا ( ( ( دنانير ) ) ) او دراهم وتصرف فيها بغير اذن ربها فردها في صرتها المراد مثلها ثم هلكت بعد دعواه ردها فقد اختلف في تضمينه وعدمه علي قولين المشهور منهما القول بعدم الضمان لانه قول ابن القاسم واشهب وجماعه حيث كان تصرفه في الوديعة مكروها بان كان مليا حين تصرفه فيها واما لو كان معدما لحرم عليه التصرف فيها الا باذن من ربها كما يحرم عليه التصرف في الوديعة المقومه كعرض او حيوان الا باذن ربها فالحاصل ان التصرف في الوديعة علي ثلاثة احوال جاءز ومكروه وحرام فالجاءز التصرف بالاذن مطلقا والحرام التصرف بغير اذن حيث كنت مقومه مطلقا او مثيله ( ( ( مثلية ) ) ) وهو معدم واذا ادعي ردها الي موضعها فانه يصدق في قسم المكروه ولايصدق في الجاءز والحرام الا ببينه تشهد علي ردها ليد صاحبها ولا يكفي شهادتها علي ردها الي موضعها قال خليل وبرء ان رد غير المحرم وهو المكروه فقط واما الجاءز والمحرم فلا يصدق في دعواه الرد لانهما صارا كالسلف الحقيقي فلا بد من بينه تشهد علي ردهما ليد صاحبهما
 تنبيهان الاول علم مما قررنا في كلام المصنف اجمالا لما عرفت من انه لا يصدق بمجرد دعوي الرد الي محل الوديعه الا في قسم المكروه بخلاف قسمي الجاءز والحرام وقد بينا الفرق بان الجاءز والمحرم صارا بمنزلة القرض في ذمة المقترض لا يبرا منه الا ببينه تشهد علي رده الي يد صاحبه الثاني لم يبين المصنف المضمون وهو المثل ان كانت مثليه والقيمة ان كانت مقومه والضمان لها في ذمة الحر الرشيد واما لو كان المودع عبدا فان كان ماذونا له في التجارة فيضمنها في ذمته ايضا لكن يدفعها من غير خراجه وكسبه من هبة او صدقة وان كان غير ماذون وقبل الوديعة بغير اذن سيده فانها تكون في ذمته اذا عتق لا في رقبته الا ان يسقط سيده عنه ضمانها بان يقول اسقطتها عن عبدي فلا يتبع بها ولو عتق لانه عيب اسقطه عن عبده واما لو كان صبيا سفيها فلا ضمان عليه لان صاحبها هو المسلط لهما عليه ( ( ( عليها ) ) ) ولو كان قبولها ( ( ( قبولهما ) ) ) باذن وليهما اللهم ان يصونا بها مالهما فيضمنان الاقل من قيمتها ومما صوناه لا ان تلف ما صوناه واستفادا غيره ثم شرع في بيان حكم الاتجار بالوديعه ( ( ( الوديعة ) ) ) بغير اذن مالكها بقوله ومن اتجر بوديعه عنده بغير اذن مالكها فذلك الاتجار مكروه سواء كانت مما يحرم تسلفهما كالمقوم مطلقا والمثلي للمعدم او يكره كالمثلي للملء للفرق بين السلف والتجارة بان المتسلف قصد تملكها بصرفها في مصالحة والمتجر قصد تحريكها لياخذ ربحها ويحبس راس المال لصاحبه واذا اتجر بالوديعة ( ( ( الوديعة ) ) ) ف البرح ( ( ( الربح ) ) ) له  والخسارة عليه ان كانت عينا دراهم او دنانير لان ضمانها زمن الاتجار منه والقاعدة ان من عليه الضمان يستحق الربح وعلم مما قررنا من تناول الكراهة لما يحرم تسلفه ان قوله ان كانت عينا ليس شرطا في الكراهة وانما هو شرط في قوله والربح له واشار الي حكم غير العين بقوله وان باع المودع بالفتح الوديعه بغير اذن مالكها وهي عرض اي غير غين ( ( ( عين ) ) ) فربها مخير عند عدم فواتها في اجارة ( ( ( اجازة ) ) ) البيع واخذ الثمن الذي بيعت به وعند فواتها يجب له الاكثر من الثمن او القيمة يوم التعدي لانه فضولي فالحاصل انه عند قيامها له الاجازة واخذ الثمن وله رد البيع واخذ سلعته واما عند فواتها فيقضي له باخذ الاكثر من الثمن او قيمتها يوم التعدي ومثله كل متعد بالبيع علي سلعة غيره ولو غاصبا وهكذا حكم بيع الوديعة من غير اتجار في ثمنها واما لو باعها علي وجه التجارة ففي بيعها تفصيل محصلة ان باعها بعرض والعرض بعرض وهلم در ( ( ( جرا ) ) ) فلا ربح له وله الاجر وان باعها بدراهم فالربح الكاءن في ثمنها لربها مثال ذلك ان يودعه سلعة اشتراها بعشرة قباعها ( ( ( فباعها ) ) ) بعشرين فربها له اجازة البيع واخذ العشرين او رد البيع واخذ سلعته وبعد الفوات يخير بين الاجازة واخذ ما بيعت به او تضمننه ( ( ( تضمينه ) ) ) القيمة يوم بيعها والمراد ان له الاكثر من الثمن والقيمة والظاهر من كلام اهل المذهب انه لا اجر له في البيع لانه متعد به والعل ( ( ( ولعل ) ) ) الفرق بين هذا وبين المتجر في العرض بعرض له الاجران المتجر انما فعل مكروها بخلاف هذا تنبيه مثل المودع في استحقاق الربح عند الاتجار بالعين الوصي يتجر باموال اليتامي له الربح وعليه الخسر ومثلهما ايضا ناظر الوقف يتجر في مال الوقف الا ان الوصي والناظر يحرم عليهما الصرف ( ( ( التصرف ) ) ) فيما تحت ايديهما ومثل من ذكر تالغصب ( ( ( الغاصب ) ) ) لدراهم واتجر فيها فانما عليه راس المال والربح له لان الضمان عليه لو كان صاحب الدراهم تاجرا علي المعتمد لان كل ما ذكر لم يقبض المال تنميه لربه بخلاف المبعض معه والمقارض اذا اتجرا بما في ايديهما فلا ربح لهما بل لرب المال واما لو حصل خسر فهو عليهما بتعذيهما ( ( ( بتعديهما ) ) ) تنبيه اخر محل تخير صاحب الوديعة في الاجازة والرد الخ ما لم يحضر عقد البيع او يبلعغه ( ( ( يبلغه ) ) ) البيع ويسكت مدة بحيث يعد راضيا والزامه للبيع واخذ ما بيعت به من قليل او كثير كما قالوه في هذا المحل ثم شرع في التالي للوديعه في الترجمه وهو باب اللفطة ( ( ( اللقطة ) ) ) بضم اللام وفتح القاف ما يلتقط والالتقاط وجود الشء من غير طلب وعرفها ابن عرفه بقوله ما وجد بغير حرز محترما ليس حيوانا ناطقا ولا نعما بل عينا او عرضا او رقيقا صغير ( ( ( صغيرا ) ) ) وساء ( ( ( وسواء ) ) ) وجدت في العمار او الخراب او بساحل البحر وعليها علامة المسلمين لا نحو عنبر وعقيق فلواجده وخرج بقوله مال اللقيط وخرج بمحترما مال الحربي فليس يلقطه بل اما فء او غنيمة وخرج الابق الكبير فلا يسمي لقطة كما خرج اخذ الابل والبقر فانه يسمي ضاله الشء فالشء المعرض للضياع اربعة اشياء لقطة او لقيط او ابق او ضاله فاللقطة تقدم حدها واما اللقيط فهو صغير ادمي لم يعلم ابوه ولا رقه اما لو علم رقه فان كان صغير ( ( ( صغيرا ) ) ) فهو اللقطه وان كان كبير ( ( ( كبيرا ) ) ) فهو الابق وجده رقيق كبير محترم وجد بغير حرز واما الضاله فحدها نعم محترم وجد بغير حرز فيخرج ما كان يحرزه او مع من يحفظه فليس بضالة فقال ومن وجد من المكلفين لقطه وقد مر تعريفها لان ( ( ( لابن ) ) ) عرفه وعرفها خليل بقوله اللقطه مال معصوم عرض للضياع وان كلبا وفرسا التقطها فليعرفها وجوبا بنفسه او بمن يثق به ولو باجره منها ان لم يعرف مثله سنة حيث كانت من ذوات البال واما ان كانت مسفاسف الامور كدلو مخلاه ( ( ( ومخلاة ) ) ) ودريهمات فانها تعرف اياما لا سنة علي الراجح واما الشء الحقير جدا بحيث لا تلتفت اليه النفوس كالعصا والسوط فلا يجب تعريفه اصلا ويجوز لواجده اكله لا شء عليه حيث لم يعلم ربه والا لم يجز له اكله بل يجب عليه دفعه لربه فان اكله ضمنه ومثله ما يفسد بالتاخير كلحم ورطب وبين محل التعريف بقوله بموضع يرجو التعريف بها اي بموضع يرجو وجود صاحبها وهو الموضع الذي يظن ان صاحبها يطلبها في ولذا قال خليل وتعريفهاسنة ( ( ( وتعريفها ) ) ) بظمان ( ( ( سنة ) ) ) طلبها كابواب المساجد والاسواق ويكون التعريف اثر الالتقاط في كل يوم واذا تقادم الزمان ففي كل يومين مرة وتعريفها في البلدين ان وجدت بينهم ( ( ( بينهما ) ) ) ويطلب منه الابهام عند التعريف فلا يذكر نوعها ويظن التوصل به الي معرفتها وان وجدت بقريه من قري اهل الشرك فالافضل له دفعها العالم اهل الذمه وان عرفها بنفسه لم ياثم فان اخر تعريفها حتي تلفت فانه يضمنها بدفعها لغيره لغير عذر لان اللقطه لم ياتمنه ربها عليها بخلاف الوديعه
 تنبيهان الاول تكلم المصنف علي التعريف وترك الكلام علي حكم الالتقاط لعله لما فيه من التفصيل المنافي لغرضه من الاختصار ومحصلة انه يجب بشرطين علم امانه نفسه وخوف الخاءن فان علم خيانة نفسه حرم عليه الالتقاط واما ان  لم يخف عليها فيكره له الالتقاط مع علمه امانه نفسه او شك فيها ولو خاف الخاءن قال خليل ووجب اخذها لخوف خاءن لا ان علم خيانة نفسه هو فيحرم والا كره وفاءدة الوجوب انه لو تركها او ردها بعد اخذها للحفظ وضاعت فانه يضمنها وفاءدة الحرمة انه ان اخذها يضمنها ان تلفت او ضاعت قبل ردها لمحلها بحالها واما في المكروه فلا يضمنها بتركها وانما يضمنها اذا اخذها وردها لموضعها بعد مدة طويله وضاعت الثاني لو تلفت عند الملتقط زمن تعريفها لا ضمان عيه الا اذا تعدي عليها او فرط في حفظها كما اذا اخذها ليتملكها فانه يخاطب بضمانها بمجرد وضع يده عليها لشبهه بالغاصب فلو تنازع مع ربها بعد ضياعها او تلفها بغير تفريط وادعي انه اخذها ليعرفها وادعي ربها انه اخذها بقصد تملكها فالقول للملتقط بلا يمين لان الشرع اوجب عليه اخذها ولانه امر لايعلم الا منه فان تمت اي انقضت سنة او ايام فيما يعرف اياما والحال انه لم يات اي لم يظهر لها اجد يستحق اخذها بوصفها علي الوجه الاتي في كلام المصنف فانه يخير بين ثلاثة امور بينها بقوله فان شاء الملتقط ( ( ( المتلقط ) ) ) بعد تلك المدة حبسها لربها وان شاء ( ( ( شاء ) ) ) تصدق بها عن ربها وضمنها لربها ان جاء فوجده تصدق بها وقد فاتت عند الفقير واما ان وجدها قاءمة فانه ياخذها وان اخذ صاحبها قيمتها من الملتقط فللملتقط الرجوع علي الفقير بها الا ان يكون الملتقط ( ( ( المتلقط ) ) ) تصدق بها عن نفسه فلا رجوع له علي الفقير بشء وان شاء تملكها وتصدق بها عن نفسه ضمانا ( ( ( ضامنا ) ) ) لها في الصورتين قال خليل وله حبسها بعدها او التصدق او التملك ولو بمكة ضامنا فيهما وما ورد من قوله عليه الصلاة والسلام لا تحل لقطة مكة الا لمنشد وقوله عليه الصلاة والسلام لاتحل لقطة الحاج فمحمول علي انها لا تحل لمن يريد تملكها من غير تعريف بل لا تءخذ الا لتعرف وسبب تنبيه الشارع علي خصوص لقطة مكه مع ان هذا الحكم عاد حتي في غيرها ان لقطة مكة توجد كثيرا في الحرم عند اجتماع الناس من كل قطر والغلب ( ( ( والغالب ) ) ) ان الذي قطره بعيد لا يمكنه الرجوع مرة اخري فعند ذلك يكثر اخذها بنية التملك فنيبه ( ( ( فنبه ) ) ) عليهالصلاة والسلام علي انه لا يحل اخذها بهذا القصد وان كان غيرها كذلك ومحل التخيير المذكور اذا كان الملتقط غير الامام واما لو كانت اللقطه بيده فليس له الا حبسها لربها او بيعها وحبس ثمنها في بيت المال لربها ولا يجوز له التصدق بها ولا تملكها ولعل الفرق بينه وبين الامام مشقة تخليص ما في ذمة الامام بخلاف غيره ولذلك لا يجوز لمن ابق منه عبد وبلغه انه بيد الامام بيعه حتي يقبضه منه بخلاف ما اذا بلغه انه بيد غيره ممن يقدر عليه فانه لا يجوز بيعه ولو قبل قبضه ولو كان من بيده عاصبا ( ( ( غاصبا ) ) ) ولكن اقربه ويقدر عيه انظر شراح خليل
 تنبيهان الاول ظهر مما قررنا ان الملتقط يضمن اللقطه في التصدق بها ولو عن ربها وفي حالة تملكها لا في حالة حبسها لربها فان ضمنانها ( ( ( ضمانها ) ) ) فيها من ربها لانها تحت يده كالوديعة الثاني لم يعلم من كلامه مستحق غلة اللقظه ( ( ( اللقطة ) ) ) وفي خليل وله كراء بقر ونحوها في علفها كراء مضمونا اي مامونا وله ركوب دابه من موضع التقاطها الي موضعه وان لم يتعذر قودها عليه وان فعل شيءا من هذه الا علي هذا الوجه وتلفت ضمنها وللملتقط غلاتها من لبن وجبن لا صوفها ولا نسلها ولا كراءها الزاءد علي علقها ( ( ( علفها ) ) ) فانه لصاحبها وان كلفها الملتقط ولم يكن لها غلة فان صاحبها يخير في اخذها رفع ( ( ( ودفع ) ) ) كلفتها وله تسليمها للملتقط في كلفتها ولو زادت علي قيمتها الان ربها لا يلزمه الزاءد علي قيمتها ولو ظعر ( ( ( ظهر ) ) ) علي صاحبها دين لقدم الملتقط بنفقته علي ذي الدين كالمرتهن ولما كانت اللقطه كالوديعة في عدم جواز الانتفاع بها بين حكم ما اذا تعدي وانتفع بها فقال وان انتفع الملتقط بها في غير ركوبها لموضعه وتلفت ضمنها واما لو لم يحصل تلف فانما يلزمه كراءها لمالكها ان كان مثله يكري الدواب واما لو هلكت لا بسبب انتفاعه فاشار اليه بقوله وان هلكت اي اللقطه سواء كان قبل السنة او بعدها بغير تحريك اي بغير سبب من الملتقط ولم يضمنها لما قدمنا من ان اللقطه تحت يده كالوديعة والمودع لا يضمن الوديعه الا بتعذيه ( ( ( بتعديه ) ) ) واما لو تعدي عليها الملتقط بالبيع ففيه تفصيل في بيعها بعد السنة فليس لربها الا الثمن وقبل السنة يخير ربها بين امضاء البيع واخذ الثمن ورده واخذها ان كانت قاءمة او قيمتها ان فاتت قال خليل وان باعها بعدها فما لربها الا الثمن بخلاف لو وجدها بيد المسكين او مبتاع منه فله اخذها وللملتقط الرجوع عليه ان اخذ منه قيمتها الا ان يتصدق بها عن نفسه وان نقصت بعد نيه تملكها فلربها اخذها او قيمتها ثم شرع في بيان ذكر الاوصاف التي تستحق بها بقوله واذا عرف طالبها اي اللقطه العقاص ( ( ( العفاص ) ) ) وهو الخرقه المربوطه فيها المال وعرف ايضا الوكاء بالمد وهو الخليط ( ( ( الخيط ) ) ) الذي يربط به طرف  المال اخذها بلفظ الماضي اي استحق اخذها من غير يمين واحري لو عرفهما وعرف العدد قال خليل ورد بمعرفة مشدود فيه وبه وعدده بلا يمين وظاهر كلام المصنف انه لو لم يعلم الا العفاص او الوكاء فقط لا ياخذها وليس كذلك بل ياخذها لكن بعد الاستيفاء مدة الاحتمال ( ( ( لاحتمال ) ) ) ان ياتي من يعرف الوصفين قال خليل واستءني في الواحده ان جهل غيرها لا غلط بان قال العفاص كذا فيوجد بخلافه فلا تدفع له كما لو غلط في صفة المال بان قال محمديه فاذا هي يزيديه بخلاف ما لو اخبر بعدد فيوجد اقل منه فانه ياخذها الاحتمال ( ( ( لاحتمال ) ) ) اغتيال الملتقط عليها واما لو غلط بالنقص اي اخبر به فتوجد اكثر ففيه قولان وفهم من تعويله علي معرفة العفاص والوكلاء ( ( ( والوكاء ) ) ) انه لا يضر جهله بقدرها وهو كذلك والاصل فيما قال المصنف ما في الموطا والصحيحين من حديث زيد من ( ( ( بن ) ) ) خالد الجهني ان رجلا جاء الي النبي صلي الله عليه وسلم فساله عن اللقطه فقال له اعرف عفاصها ووكاءها ثم عرفها سنة فان جاء صاحبها ولاا فشانك بها قال فضاله الغنم قال هي لك او لاخيك او للذءب قال فضالة الابل قال مالك ولها معها حذاءها وسقاءها ترد الماء وتاكل الشجر حتي يلقاها ربها وفي رواية فان جاء احد يخبرك بعددها ووعاءها ووكاءها ( ( ( ووكاءها ) ) ) فاعطاها اياه والا فهي كسبيل مالك
 فروع الاول لو عرف شخص عفاصها ووكاءها وعرف اخر عددها ووزنها لقضي بها لمن عرفهما لكن بعد يمينه علي من عرف العدد والوزن كما يقضي لمن عرف العفاص والعدد علي من عرف العفاص والوكاء بيمين وكذا يقضي بهما لمن عرف اوصافايقوي بها الظن علي انه صاحبها علي من وصف اوصافا دونها الثاني لو وصفها ثان مثل او فان كان الاول لم ينفصل بها حلفا وقتسمنت ( ( ( وقسمت ) ) ) بينهما بخلاف لو انفصل بها انفصالا بينا بحيث يمكن وصول العلم للثاني من الاول فانها لا تكون للاول الثالث لو اخذها شخص بالوصف وانفصل بها ثم جاء اخر واقام بينه انها له فلا ضمان علي دافعها للاول وتنزع منه وتدفع للثاني لان البينه اقوي من الوصف الرابع لو اقام كل من شخصين بينه فتعطي لذي البينه الزاءده في العداله فان استوتا في لعداله ( ( ( العدالة ) ) ) قدمت المءرخه او السابقه تاريخا وان استوتا في الجميع قسمت بينهما بعد حلفهما تنبيه لم يعلم من كلام الصنف حكم اللقطه التي لا عقاص ( ( ( عفاص ) ) ) لها ولا وكاء والحكم انها تدفع لمن ياتي باوصاف يغلب معها الظن بصدق الاتي بها ولما فرغ من الكلام علي اللفطه ( ( ( اللقطة ) ) ) شرع في الكلام علي الضاله وتقدم احدها بانها نعم محترم وجد بغير حرزه بقوله ولا يجوز ان ياخذ الرجل او المراة ضاله الابل من الصحراء ولو كانت في موضع يخاف عليها من السباع او بقوله الجوع او العطش لخبر دعها فان معها حذاءها وسقاءها ترد الماء وتاكل الشجر فان تعدي واخذها فانه يعرفها سنة ثم يتركها بمحلها ومحل عدم دجواز ( ( ( جواز ) ) ) اخذ ضاله الابل ما لم يخف عليها الخاءن والا وجبت ( ( ( وجب ) ) ) التقاطها ولعل هذا هو سبب تخصيص عدم اخذها بكونها في الصحراء لان الضاله في العمران يخاف عليها من الخاءن خلافا لمن قال التقييد بالصحراء بالنظر للغالب ولا يحلق ( ( ( يلحق ) ) ) بضاله الابل الخيل والحمير بل هي داخله في اللقطه ولذا قال خليل اللقطه مال معصوم عرض للضياع وان كلبا وفرسا وله اي مريد الالتقاط اخذ الشاه واكلها ان كانت بفيفاء بالمدا ( ( ( بالمد ) ) ) اي بارض لا عمارة فيها ولا شء عليها لربها وجواز ذبحها واكلها ولو مع تيسير ( ( ( تيسر ) ) ) سوقها للعمران علي ظاهر المدونه واما لو اتي بها حية للعمران لوجب عليها تعريفها لانها صارت كاللقطه واما لو ذبحها في الفيفاء ولم ياكلها حتي دخل العمران فلا يجوز له اكلها الا اذا لم يعرف ربها ولم يكن يتيسر بيعا قال خليل وله اكل ما يفسد ولو بقره وشاه ولو بفيفاء اي علي التفصيل الذي بيناه تنبيه سكت المصنف عن ضاله البقر وحكمها انها ان كانت بمحل بحيث يخاف عليها منالسباع او الجوع فان حكمها كالشاه توجد بالفيفاء فان ذبحها فيها جاز له اكلها لكن بشرط ان لا يمكن سوقها للعمران والا وجب فليست كالشاه في هذه الحالة واما ان كانت بمحل لا يخاف عليها من سباع ولا جوع فانها تترك فان اخذها وجب عليه تعريفها وهذا حيث لم يخف عليها من السارق والا وجب التقاطها فالحاصل ان الابل والبقر عند خوف السارق سيان في وجوب الالتقاط ويفترقان عند الخوف من الجوع او السباع فالابل تترك والققر ( ( ( والبقر ) ) ) يجوز اكلها بالفيفاء ان تعذر سوقها للعمران ومفهوم قول المصنف في الصحراء ان الابل والبقر والشاه الموجودة في العمران يجب التقاطها عند خوف الخاءن كالخيل والحمير والطيور والعروض والنقود خاتمه اسقط المصنف الكلام علي اللقيط وهو صغير ادمي لم يعلم ابوه ولا امه ولا رقه والحكم فيه انه يجب لقطه كفاية ولو علم خيانه نفسه وان لم يوجد سواء تعين عليه قال خليل ووجب لقط طفل نبذ كفاية وشرط الوجوب كون الواجد رجلا رشيدا او حرة خاليه من الازواج او ذات زوج اذن لها زوجها الرقيق ولو مكاتبا فلا يلتقط الا باذن سيده ويجب عينا علي  الملتقط للطفل نفقه ( ( ( نفقته ) ) ) وحضانهته ( ( ( وحضانته ) ) ) الذكر حتي يبلغ عاقلا قادرا علي الكسب والانثي حتي يدخل بها الزوج الموسر كولد الصلب واسقط الكلام علي الابق وهو رقيق محترم وجد بغير حرز والحكم فيها انه يندب لمن يعرف سيده اخذه وان لم يعرف ( ( ( يعرفه ) ) ) لا يندب له وان اخذه من غير معرفه فله رفعه للحاكم وله ارساله ولما فرغ من الكلام علي اللقطه شرع في الكلام علي التعدي علي مال الغير بقاعدة كليه فقال وكل من استعلك ( ( ( استهلك ) ) ) عرضا المراد شيءا غير مثلي بقريبة ( ( ( بقرينة ) ) ) ذكر المثلي فعليه غرم قيمته لربه ولو استهلكه خطا ولو غير بالغ ولو ومكدها ( ( ( مكرها ) ) ) لان الضمان من باب خطاب الوضع وتعتبر قيمته بمحل الاتلاف وتكون تلك القيمة في ذمة الحر وفي رقبه العبد الغير الماذون وغير المءتمن والمراد باستهلك اي تسبب في الاهلاك ولو لم يباشر ومحل ضمان الصبي والسفيه اذا لم يءمنا علي ما اتلفا والا فلا ضمان عليهما الا ان يصونا به مالهما فيضمنان في المصون فقط واما العبد الماذون له التجاره والمءن ( ( ( والمءمن ) ) ) فانهما يضمان ( ( ( يضمنان ) ) ) في ذمتهما يتبعان ان عتقا كما قدمنا ذلك واشار الي مفهوم عرضا علي فسرنا بقوله وكل ما يوزن كسمن وعسل ونحاس او يكال كقمح او بعد ( ( ( يعد ) ) ) ولا تختلف افراده واتلفه شخص او تسبب في اتلافه فعليه غرم مثله في موضع اتلافه لمالكه لان المثلي بقوم ( ( ( تقوم ) ) ) مقام مثله وظاهره ولو استهلكه في الغلاء وقدر عليه في الرخاء وعكسه علي مشهور المذهب قال خليل في بيان مفعول وضمن الغاصب بالاستيلاء المثلي ولو بغلاء وصبر لودجوه ( ( ( لوجوده ) ) ) واشعر قوله غرم مثله او وزنه او كيله معلوم واما لو جهل كيله او وزنه او عدده فانما يضمن قيمته لعدم معرفة مثله لان الجزاف كالمقوم الواجب علي متلفه قيمته بعد تحريمه حيث كان متلفه غير مالكه واما المالك يبيع صبره علي الكيل ثم يتلفها قبل كيلها فالواجب عليه مثلها ليوفيه للمشتري
 تنبيهان الاول كلام المصنف فيمن اتلف بغير اذن مالكه اما لو كان باذنه فلا ضمان حيث كان المالك ممن يعتبر اذنه بان كان رشيد ( ( ( رشيدا ) ) ) حيث لم يكن المتلف مءتمنا علي ما اتلفه والا ضمنه ولو اذن له المالك كما قدمنا التنبيه عليه في باب الوديعه ومن الاذن المريض ياذن للطيب ( ( ( للطبيب ) ) ) الحاذق في طبه فيحبه ( ( ( فيطبه ) ) ) فيموت من غير تقصيره ومءدب الاطفال ياذن له الولي في التاديب والحاكم يقيم الحد علي مستوجبه فيموت منه فلا ضمان علي واحد من هءلاء حيث فعل كل المطلوب مع ظنه السلامه الثاني ما ذكره امصنف من ان الواجب في المقوم القيمه وفي المثلي المثل قاعده اغلبيه لا كليه خلافا فالظاهر لفظه لان المقوم قد يجب مثله وذلك فيمن اتلف سلعة وقفت علي ثمن الواجب مثل الثمن لا غرم قيمتها والمثلي قد يغرم قيمته كالجزاف قبل معرفة كمية ( ( ( كميته ) ) ) يجب علي متلفه غرم قيمته كما قدمنا ثم شرع في بعض مساءل تتعلق بالغصب وهو اخذ المال قهرا تعديلا ( ( ( تعديا ) ) ) بلا حرابه بقوله والغاصب وهو الذي ياخذ المال من صاحبه قهرا عليه علي وجه التعدي ضامن لما اي لكل شء غصب ومعني ضمانه تعلق الضمان به لا انه تضمنه بالفعل بدليل قوله فان رد الغاصب ذلك الذي عصب ( ( ( غصب ) ) ) قاءما بحاله اي لم يتغير ينقص ( ( ( بنقص ) ) ) في بدنه اذ لا تعتبر حواله اسواقه فلا شء عليه لربه وانما يجب عليه التوبه والاستغفار ويجب علي الحاكم تادتبه ( ( ( تاديبه ) ) ) ولو صبيا استصلاحا لحالة ولو عفي ( ( ( عفا ) ) ) عنه رب الشء المغصوب لان الادب حق لله دفعا للفساد لحرمه الغصب كتابا وسنة واجماعا فالكتاب @QB@ ولا تاكلوا اموالكم بينكم بالباطل @QE@ @QB@ ولا تعتدوا @QE@ الاية واما السنة فما رواه الشيخان من قوله صلي الله عليه وسلم من اخذ شبرا من ارض ظلما فانه يطوقه يوم القيامه من سبع ارضين واما الاجماع فمعلوم من الدين بالضرورة حتي قال ابن عبد السلام اجمع كل الملل علي حرمته واشار الي مفهوم قوله فان رده بحالة بقوله وان تغير الشء المغصوب عند غاصبه في يده بامر سماوي لا صنع لاحد فيه فربه مخير بين اخذه بنقصه من غير ارش ولو كان النقص كثيرا او تضمينه اي الغاصب القيمة يوم الاستيلاء عليه واشار الي مفهوم التغير بالسماوي بقوله ولو كان النقص الحاصل في بدن الشء المغصوب بتعديه اي الغاصب اي بفعله ولو خطا لانه كالعمد في اموال الناس كذابه ( ( ( كدابة ) ) ) غصبها فاستعملها في طحن او ركوب لو لم يخرق فيه فتعيب ( ( ( فتعيبت ) ) ) في بدنها خير ربه ايضا في اخذه ناقصا واخذ اي مع اخذ ما نقصه اي ارش نقصه بان يقوم سالما من هذا النقص وان كان ناقصا قبل ذلك بغيره فان قيل قيمته عشرة يقال ما قيمته  معيبا بما احدثه الغاصب فيقال ثمانيه ياخذ من الغاصب درهمين وفي تركه للغاصب واخذ قيمته يوم الغصب والمصنف حذف احد شقي التخيير هذا هو المشهور ومقابل المشهور يجعله كالسماوي يخير ين اخذه ناقصا من غير ارش او ياخذه ( ( ( ياخذ ) ) ) قيمته واشار اليه بقوله وقد اختلف في ذلك وانما نص علي هذه الجمله ودفعا ( ( ( دفعا ) ) ) لما يتوهم من الاتفاق علي الحكم السابق فبين ان المسالة ذات خلاف واما لو كان الجاني اجنبيا لخير بين تضمين الغاصب القيمه يوم الغصب ويتبع الغاصب الجاني بالارش لانه غرم قيمته سالما وبين اخذه شيءه معيبا ويتبع الجاني الارض وليس له اخذ شيءه قال خليل وخير في الاجنبي فانه تبعه تبع هو الجاني فان اخذه ( ( ( اخذ ) ) ) ربه اقل فله الزاءد من الغاصب فقط فالحاصل ان اسماوي ( ( ( السماوي ) ) ) الحاصل عند الغاصب يخير فيه بين اخذه ناقصا وتركه وياخذ قيمته وفي جنايه الغاصب بين اخذه مع الارش او تركه واخذ قيمته يوم غصبه وفي جناية الاجنبي يخير بين تضمين الغاصب وبين اخذه معيبا ويتبع الجاني بالارش فالصور ثلاث تنبيه ذكر المصنف حكم النقص ولم يتكلم علي حكم ما لو احدث في الذات شيءا لم يكن فيها كما لو عصب ( ( ( غصب ) ) ) ثوبا وخاطه او صبعه ( ( ( صبغه ) ) ) فحكمه انه يخير صاحبه بين اخذه ودفع قيمته ( ( ( قيمة ) ) ) ما زيد فيه ولا فرق بين ان يزيد ما احدثه في قيمته او لم يزد فيها ولم ينقصها وبين اخذ قيمته خالصا من تلك الزياده وتركه للغاصب واما لو حدث فيه شيءا فنقص بسبب ذلك كما لو صبغه فنقص فانه ينزل منزلة العيب السماوي فيخير ربه بين اخذه من غير ارش وبين اخذ قيمته سالما من هذا النقص قال خليل مشبها في التخيير كصبغة في قيمته واخذ ثوبه ودفع قيمته ( ( ( قيمة ) ) ) الصبغ بالكسر اي المصبوغ به وفي بناءه في اخذه ودفع قيمتة ( ( ( قيمة ) ) ) نقضه بعد سقوط كلفة لم يتولها وبين ان يامر الغاصب باخذ بناءه وتسوية الارض كما كانت ولما كان الغاصب ظالما والظالم لا يربح قال ولا غله مستحقه للغاصب ويجب عليه ان يرد جميع ما اكل من غله المغصوب او قيمة ما انتفع به والمعني انه من غصب رقبة عبدا او دابه او دارا واستغله بنفسه او اكره ( ( ( اكراه ) ) ) لغيره فانه يغرم لمالك عوض ذلك وظاهر كلام المصنف كخليل انه يجب علي الغاصب رد الغله سواء كانت غله ربع او حيوان او غيرهما وهو رواية اشهب وابن زياد عن مالك والذي في المدونه ان هذا في الغله الناشءه من غير تحريك الغاصب كثمرة ونسل حيوان ولبن وصوف ومنفعه العقار هذا هو الذي يرد المدونه ان هذا في العلة الناشءه من غير تحريك الغاصب كثمرة نسل حيوان ولبن وصوف ومنفعة العقار هذا هو الذي يرد لربه ان كان موجودا او مثله ان كان مثليا وعلم والا فقيمته واما ما نشا عن تحريكه كربح المال المغصوب ونماء البذر المغصوب فهذا للغاصب وظاهر قول المصنف وترد ما اكل من غلة الخ انه استعمل الذات المغصوبه وهو كذلك ولذا قال خليل عاطفا علي ما هو للغاصب وغله مستعمل ومفهومه انه لو عطل لا يغرم للمغصوب منه شيءا كالدار يغلقها والدابة يحبسها والارض يبورها والعبد لا يستخدمه ولا يشكل علي هذا ما ياتي في كلام خليل من انه يضمن بتفويت الانتفاع ولو لم يستعمل لانه محمول علي غصب المنفعة ويقال له التعدي والمتعدي يضمن قيمتة ( ( ( قيمة ) ) ) المنفعة ولو لم يستعمل اذا المنفعة بل عطله فتلخص ان نحو الثمرة والنسل والصوف واللبن ومنفعة العقار لرب الشء المغصوب واما ربح الدراهم ونماء البذر فهو للغاصب وانما يرد راس المال واما منفعة الحيوان والرقيق فظاهر المصنف خليل انها لرب المغصوب لاللغاصب تنبيه سكت المصنف عن نفقة الحيوان المغصوب وفي خليل انها في غلته حيث قال وما انفق في الغلة فلو لم يكن له غله ضاعت عليه ومثله في الاحكام السابقه السارق وفي كلام ابن عرفه ما يفيد ان المعتمد ان الغاسب ( ( ( الغاصب ) ) ) لا رجوع له بالنفقه لا في لبن ولا صوف ولا نسل ولا ثمر ( ( ( ثمرة ) ) ) فلعل مراد خليل بقوله وما انفق في الغلة نحو ركوب الدابه او طحنها لا نسله ( ( ( نسلها ) ) ) ولا صوفها ولا لبنها فافهم ثم شرع في الكلام علي الامة المغصوبه يطءها الغاصب بقوله ومن غصب امة لاشبهة له فيها فيجب عليه الحد ان وطء حيث كان مكلفا لانه زان ويغرم لسيدها نقصها ولو كان صبيا او مجنونا ولا يلزم من وطءها صداق بخلاف الحر ( ( ( الحرة ) ) ) فاللازم الصادق ( ( ( الصداق ) ) ) في وطءها حيث وطءها قهرا عليها وكان مكلفا وولده اي الغاصب من تلك الامه رقيق لرب الامه لان ولد الامه من غير سيدها الحر رقيق ولو كان من زني او زوج وقيدنا بقوله لا شبهة له فيها للاحتراز عن الاب يطا جاريه فرعه فلا حد عليه وان سفل الفرع ويجب عليه غرم قيمتها لمالكها بمجرد التلذذ قال خليل وملك اب جاريه ابنه بتلذذه بالقيمة تنبيه لم يذكر المصنف حكم ما اذا ولدت ومات ولدها او ماتت وبقي الولد ومحصل الكلام في ذلك انه ان مات الولد قبل السيد يكون بمنزلة العدم وانما له امته واما ان ماتت الام وبقي كان له الخيار في اخذه او تركه وياخذ قيمتة ( ( ( قيمة ) ) ) امه فقط لانها المغصوبه كما لو ماتا معا وان وجدهما حيين اخذهما ولما قدم ان الغاصب يجب عليه  رد غلة المغصوب الناشءه من غير تحريكه والناشءه عن تحريكه يملكها بين هنا انه لا يجوز له الانتفاع بها حتي يرد الاصل بقوله ولا يطيب اي لا يحل لغاصب المال اذا اتجر فيه وربح اكل ربحه حتي يرد راس المال علي ربه وانما لم يحل له اكل الربح وان ملكه لاشتغال ذمته براس المال وفسرنا لا يطيب بلا يحل لصدقه بالكراهة والحرمه وهما قولان والراحد ( ( ( والراجح ) ) ) منهما الحرمه ولما كان يتوهم من طيبه بعد رد راس المال عدم ندب التصدق به قال كالمستدرك عليه ولو تصدق الغاصب بالربح بعد رد راس المال كان اي التصدق به احب الي بعض اصحاب الامام مالك رضي الله عنه من اكله والمراد بذلك البعض الامام اشهب ولعل وجه ندب التصدق مع براءة ذمته برد راس المال ليكون ذلك كفالارة ( ( ( كفارة ) ) ) لما اقترفه من الاثم الحاصل بالغصب لما ورد في الحديث من قوله صلي الله عليه وسلم الصدقة تطفء ( ( ( تطفء ) ) ) الخطيءة كما تطفء الماء النار فان قيل ندب الصدقه مطلوب من كل اجد لانها خير وقال تعالي @QB@ وافعلوا الخير @QE@ ولا مفهوم لربح هذا المال ولعلم ( ( ( ولعل ) ) ) الجواب ان المراد يتاكد الندب في حق هذا دون غيره ممن لم يغصب فلا ينافي ندب التصدق لكل مالك رشيد متسع فافهم ولما كانت فروع باب الغصب كثيرة قال وفي باب الاقضيه شء من هذا المعني وهو الغصب ولعل تاخيره لمناسبه اقتضت ذلك قال بعض شراح هذا الكتاب ولما انقضي الكلام علي ثلاثة ارباع هذا الكتاب شرع في رابعها فقال  $ باب في بيان احكام الدماء وما في معناها من الجراحات من قصاص وديه وفي بيان موجبات الحدود كالزنا والقذف والشرب والسرقه
 والحدود جمع حد وهو لغة المنع وشرعا ما وضع لمنع الجاني من عوده لمثل فعله وزجر غيره وفي معني الحدود التعاذير واحدها تعذير وهو اسم لنوع من العذاب موكول قدره لاجتهاد الامام بخلاف الحدود فان تعددها ( ( ( تعدادها ) ) ) محدود من الشارع وحكمه مشروعيتها الزجر عن اتلاف ما حكي الاصوليون اجماع الملل علي وجوب حفظه من العقول والنقوس ( ( ( والنفوس ) ) ) والاديان والاعراض والاموال والانساب فان في القصاص حفظا للدماء وفي القطع للسرقه لحفظ ( ( ( الحفظ ) ) ) للاموال وفي الحد للزنا حفظ الانساب وفي الحد للشرب حفظ العقول وفي الحد للقذف حفظ الاعراض وفي القتل للرده حفظ الدين وقيل ان الحدود جواءز اي كفارت ( ( ( كفارات ) ) ) قال بعضهم وهو الاصح وبدا المصنف من هذه المذكورات بقتل النفس لانه اشد الذنوب واعظمها بعد الكفر للايات والاحاديث واجماع ساءر الملل علي حرمة قتل النفس بغير حق فمن ذلك حديث لو ان اهل السماء والارض اشتركوا في دم مءمن لاكبهم الله في النار وحديث لزوال الدنيا اهون علي الله من قبل ( ( ( قتل ) ) ) رجل مسلم وحديث من اشترك في دم امرء ( ( ( امرء ) ) ) مسلم بشطر كلمه جاء يوم القيامه بين عينه ( ( ( عينيه ) ) ) مكتوب ايس ومن رحمه الله حتي لا اختلف في قبول توبه القاتل فاية الفرقان ظاهرها له التوبه ظهر ( ( ( وظاهر ) ) ) اية النساء لا توبه له وهو قول مالك لان شرط التوبه من مظالم العباد تحللهم منها ورد تبعاتهم ولا سبيل للقاتل لذلك الا ان يدرك المقتول حيا فيعفو عنه ويحلله من دمه مع اتفاق اهل السنة ممن قال بتفيذ ( ( ( بتنفيذ ) ) ) الوعيد ومن لم يقل به انه لا يخلد في النار ولما كان القتل وغيره من موجبات القصاص او الدية لا يثبت بمجرد الدعاوي شرع في بيان ما يثبت به بقوله ولا يحل ان تقتل نفس بنفس اي بسبب قتل نفس مكافءة لها الا بعد الثبوت ببينه عادله اقلها رجلان اذا لا تكفي شهادة النساء قال في الجواهر ولا يثبت القتل الموجب للقصاص برجل وامراتين ويثبت ذلك بموجب ( ( ( موجب ) ) ) الدية ويشترط في صحة الشهادة الاتفاق علي صفة القتل فلو اختلف الشاهدان في صفته بان قال احدهما ذبحه وقال الاخر حرقه او جرحه بغير ذبح والحال ان المشهود عليه منكر للشهادتين فان قام الاولياء بالشهادين ( ( ( بالشاهدين ) ) ) بطل الدم وان قاموا باحدهما اقسموا معه واقتصوا وسقطت شهادة الاخر لاجتماع القاتل والاولياء علي تكذيبها وان اعترف القاتل بالذبح وقام الاولياء بشهاد ( ( ( بشاهد ) ) ) التحريق فان كان اعدل اقسموا معه وحرقوه علي القول بالقصاص بالتحريق وهو المعتمد وان كان الاخر اعدل حلف معه القاتل وقتل ذبحا لا بالحرق او الا بعد الثبوت باعتراف اي اقرار من الجاني المكلف علي نفسه في حال اختياره بالقتل فيجوز قتله حينءذ لان المكلف مءاخذ باقراره علي نفسه في حال اختياره لا ان اكره علي الاقرار فلا يلزمه شء لعدم تكليفه في تلك احالة ( ( ( الحالة ) ) ) كاقرار الصبي والمجنون او الا ان يحثل ( ( ( يحصل ) ) ) ثبوت القتل بالقسامه وهي خمسون يمينا اذا اوجبت ( ( ( وجبت ) ) ) اي القسامه وذلك فيما اذا كان القاتل عاقلا بالغا مكافءا للمقتول في الدين والحرية غير ب ( ( ( اب ) ) ) ولم توجد بينه يثبت بها القتل ولا اعترف ( ( ( اعتراف ) ) ) من الجاني وانما وجد لوث الالعلامة ليل ( ( ( العلامة ) ) ) والقسامه سببها قتل الحر المسلم في محل اللوث وحقيقة اللوث امر ينشا عنه غلبه الظن بصدق المدعي فوجوب القسامه بسبعة شروط احدها ان يدعي القتل من لا يعرف قاتله ببينه وباقرار المدعي عليه وثانيها ان يكون المقتول حرا مسلما ثالثها ان يكون المدعي به قتلا لا جرحا رابعها ان تتفق الاولياء علي القتل خامسها ان تعكون ( ( ( تكون ) ) ) ولاة الدم في العمد اثني ( ( ( اثنين ) ) ) فصاعدا سادسها ان تكون الاولياء في العمد رجالا عقلاء بالغين سابعها ان يكون مع الاولياء لوث يقوي دعواهم كالشاهد العدل رءية القتل او  رءيته للمقتول يتشحط في دمه والمتهم قربه وعليه اثر القتل وسيبين المصنف محل وجوب القسامه بقوله وانما تجب القسامه بقول الميت دمي عند فلان وصفتها
 تنبيهات الاول لم يتعرض المصنف لشروط القصاص وهي كون الجاني مكلفا وغير حربي ولا زاءد حرية ولا اسلام وقصده الضرب وعصمه المجني عليه اما بالايمان او الامان او بحط الجزية والكفاءة في الدين والحرية فلا قصاص علي صبي ولا مجنون ولا مجطء ( ( ( مخطء ) ) ) ولا علي حربي لانه ان لم يسلم يقتل وان لم يقتل اجدا ( ( ( احدا ) ) ) الا ان قتله ليس للقصاص وانما هو لعدم عصمته وان اسلم عصم دمه ولا يقتل حر بعبد ولا مسلم بكافر لان الاعلي لا يقتل بالادني بخلاف العكس الا لغيله فيقتل الاعلي بالادني الثاني لم يبين المصنف حكم القتل بعد الثبوت هل يتعين او موكول الي ختيار ( ( ( اختيار ) ) ) الولي وفيه قولان الاول لابن القاسم وهو المشهور ومشي عليه خليل حيث قال فالقول عينا بمعني انه ليس له اخذ الديه من الجاني قهرا عليه فلا ينافي ان العقو ( ( ( العفو ) ) ) مجانا وقال اشهب يخير الولي بين القصاص واخذ الديه ولو جبرا علي الجاني الثالث تلخص مما مر ان القصاص يثبت بواحد من ثلاثة اشياء البينه العادله واعتراف الجاني علي نفسه طاءعا وهذان لا خلاف فيهما والثالث القسامه وفيها خلاف الذي اختاره مالك انه يثبت به القود في العمد والدية في الخطا فانه قال الذي اجتمعت عليه الامه في القديم والحديث القتل بالقسامه وهي السنة التي لا اختلاف فيها وتبعه علي ذلك جماعه كثيره ومنهم ابن حنبل رضي الله تعالي عنه وقال الشافعي في مشهور مذهبه وابو حنيفه ومن وافقهما لا يثبت بها القود وانا يستحق بها الديه فقط ودليل مالك رضي الله عنه ما في مسلم ان رسول الله صلي الله عليه وسلم اقر القسامه علي ما كانت في الجاهلية وما في الصحيح عن سهل بن ابي خيثمه عن رجل من كبراء قومه ان عبد الله بن سهل ومحيصه خرجا الي خيبر من جهد اصابهم فاتي محيصه فاخبر ان عبد الله بن سهل قد قتل وطرح في عين او بءر فاتي يهود فقال انتم والله قتلتموه قالوا والله ما قتلناه ثم اقبل حتي قدم علي قومه فذكر لهم ذلك ثم اقبل هو واخوه حويصه وهو اكبر منه وعبد الرحمن بن سهل فذهب محيصة ليتكلم هو الذي كان بخيبر فقال رسول الله صلي الله عليه وسلم لمحيصه كبر كبر يريد السن فتكلم حويصه ثم تكلم محيصة فقال رسول الله صلي الله عليه وسلم اما ان يدوا صاحبكم واما ان يءذنوا بحرب فكتب لهم رسول الله صلي الله عليه وسلم بذلك فكتبوا انا والله ما قتلناه فقال رسول الله صلي الله عليه وسلم لحويصه ومحيصه وعبد الرحمن اتحلفون وتستحقون دم صاحبكم قالوا لا قال فتحلف لكم يهود قالو ( ( ( قالوا ) ) ) ليسوا بمسلمين فوداه رسول الله صلي الله عليه وسلم من عنده فبعث اليهم رسول الله صلي الله عليه وسلم ماءة ناقه حتي ادخلت عليهم الدار قال العلامة وابو ( ( ( ابو ) ) ) عمر بن عبد البر هذه قصه لم يحكم فيها رسول الله صلي الله عليه وسلم بشء لابايه المدعين من الايمان ومن قبول ايمان اليهود وتبرع بان جعل الديه من مال الله عز وجل لءلا يبطل دم المسلم وقال القرافي قوله عليه الصلاة والسلام اما ان يدوا صاحبكم يحتمل اعطاء الديه لانهم لم يدعوا قتله عمدا ولم يعينوا القاتل فلا يلزم القاصا ( ( ( القصاص ) ) ) كالقتيل بين الصفين وقوله عليه الصلاة والسلام اتحلفون وتستحقون دم صاحبكم يحتم ( ( ( يحتمل ) ) ) انهم اتوا بلوث او يحمل علي ان ايتتم ( ( ( اتيتم ) ) ) بما يوجب ذلك في الحديث دليل علي ثبوت رد اليمين اذا نكل من توجهت عليه اليمين وانه لا يقضي بالنكول الرابع محيصه بضم الميم وفتح الحاء المهملة ثم باء ( ( ( ياء ) ) ) اخر الحروف ساكنه وحويصه بضم الحاء المهملة وفتح الواو وسكون الياء اخر الحروف وفتح الصاد المهملة ويقال بتشديد الياء وكسرها فيها ( ( ( فيهما ) ) ) وهما ابناء عم القتيل وعبد الرحمن اخوه ثم بين صفه القسامه وحقيقتها بقوله يقسم اي يحلف الولاة جمع ولي خمسين يمينا قال خليل وهي خمسون يمينا متواليه بتا وان كان الحالف غاءبا او اعمي لان العلم لا يتوقف علي المعاينة وبعد حلفها يستحقون الدم في العمد والديه في الخطا وكيفيه الحلف ان كانو ( ( ( كانوا ) ) ) خمسين ان يحلف كل واحد يمينا وان نقص عدد الاولياء او طاع اثنان من الخمسين يحلفا فانهم يحلفونها متواليه في العمد بان يحلف هذا يمينا وهذا يمينا حتي تتم الايمان وفي الخطا يحلف كل واجد حصته وبعد فرغه ( ( ( فراغه ) ) ) يحلف الاخر حصته وجه الفرق انه في العمد يبطل الدم بنكول واحد بخلاف الخطا لا يبطل حق الحالف بنكول الناكل وصريح كلام المصنف كحديث حويصه ومحيصه ان اولياء المقتول يبدءون ( ( ( يبدءون ) ) ) باليمين وهو المذهب قال مالك الذي سمعت ممن ارض ( ( ( ارضي ) ) ) في القسامه واجمعت عليه الامة في القديم والحديث ان يبدا المدعون بالايمان في القسامه فيحلفوا قال في المدونه يحلفون بالله الذي لا اله الا هو ان فلانا قتله او مات من ضربه ان كان عاش ولا يزاد الرحمن الرحيم قال في شرح الجلاب وان قال والله فقط لا يقبل حتي يقول الذي لا اله الا هو وفي شراح خليل اليمين في كل حق بالله الذي لا اله الا هو الا في موضعين اللعان والقسامه فانه يقول في  اللعان اشهد بالله لرايتها تزني او ما هذا الحمل مني وفي القسامة اقسم بالله لمن ضربة مات فقط والذي يظهر تقديم مافي المدونة وكلام خليل لا ياباه لان قسامة اليمين في كل حق بالله الذي لا اله الا هو يشمل القسامة ودعوي الاستثناء بمجردها غير مقبولة ولما كانت صفة القسامة مختلفة لانه يحلفها في الخطا من يرث وان واجدا او امراة ولا يحلفها في العمد اقل من رجلين عصبة قال ( ولا يحلف في ) قلت ( ( ( قتل ) ) ) ( العمد اقل من رجلين ) من عصبة المقتول نسبا والا فمن الموالي لان ايمان الاولياء اقيمت مع اللوث مقام البينة فلما لم يكتف في البيته ( ( ( البينة ) ) ) بشهادة واجد فكذلك هنا لايكفي في الايمان واحد ولانه عليه السلام عرض الايمان علي جماعة حيث قال اتحلفون وتستحقون دم صاحبكم واقل الجماعة اثنان ويكتفي بحلفها ( ( ( بحلفهما ) ) ) ولم يرثا بالفعل ومعهوم ( ( ( ومفهوم ) ) ) رجلين ان النساء لا يحلفن في العمد لعدم شهادتهن فيه وان انفردن صار المقتول بمنزلة من لا وراث ( ( ( وارث ) ) ) له فترد الايمان علي المدعي عليه وسكت عن اكثر من يحلف في العمد لانه لا حد له فلما كان الاقل محدودا عينه ولما لم يكن الاكثر محدودا سكت عنه ولما قدم ان القسامة يجب بها القود في العمد بين من يقتل بها بقوله ( ولا يقتل بالقسامة اكثر من رجل واحد ) والمعني انه اذا كان المدعي عليهم بالقتل عمدا جماعة ولم يثبت عليهم جميعا مباشرة قتله ولا التمالء علي قتله فان الاولياء عينون ( ( ( يعينون ) ) ) واحدا باختيارهم ويقسمون علي عينه ويقولون هم القسامة لمات من ضربه لا من ضربهم ففي الموطا لم تعلم قسامة الا علي واجحد وذلك لضعفها ولانه لا يعلم هل قتله الكل او البعض فالمحقق واحد والذي ترك من هءلاء الجماعة يضرب ماءة ويحبس سنة هذا هو المشهور من المذهب ومقابله لاشهب يقسمون علي الجماعة ويقتلون واحد بعد القسامة ولا شء علي غيره سوي ضرب ماءة وحبس سنة واحترزنا فلم يثبت عليهم عما اذا ثبت عليهم قتله فانهم يقتلون جميعا وهو الذي ياتي في قول المصنف والنفر يقتلون رجالا ( ( ( رجلا ) ) ) فانهم يقتلون به قال ( ( ( وقال ) ) ) خليل ويقتل الجمع بواحد والمتمالءون وان بسوط سوط ولما قدم ان القتل يحل بالقسامة اذا وجبت بين هنا محل الوجوب بقوله ( وانما تجب القسامة ) في قتل الحر المسلم ( يقول ( ( ( بقول ) ) ) الميت ) البالغ الحر المسلم قبل موته ( دمي عند فلان ) سواء كان فلان القاتل بالغا او غير بالغ حرا او رقيقا فتلخص ان المقتول لا يقبل قوله الا ان كان حرا مسلما بالغا بخلاف القاتل ويشترط في العمل بقول المقتول ان يشهد علي قوله عدلان وان يتمادي علي اقراه ( ( ( اقراره ) ) ) حتي يموت والا لم يقبل قوله ويبطل الدم وهذا اول امثلة اللوث واشار اليه خليل بعد قوله والقسامة سببها قتل الحر المسلم في محل اللوث بقوله كان يقول بالغ حر مسلم قتلني فلان ولو خطا او مسخوطا علي ورع او ولدا علي والده انه ذبحه او زوجته ( ( ( زوجة ) ) ) علي زوجها او كان القاتل عدوا للمقتول قال في الذخيرة لان العدواة ( ( ( العداوة ) ) ) تءكد صدق المدعي لانها مظنة القتل بخلاف ساءر الدعوي واما لو كان المقتول صبيا او عبدا او كافرا فلا يقبل قوله وما ذكرناه من انه لابد من شاهدين علي قوله قتلني فلان هو نص الرواية كما في التوضيح وابن عرفة ولا يكفي الواحد الا في شهادة علي معاينة القتل او الجرح او علي اقرار المقتول بالجرد ( ( ( بالجرح ) ) ) او الضرب عمدا لا خطا فلا بد من شاهدين علي اقراره ان المقر بجرح الخطا بمنزلة الشاهد علي العاقلة والشاهد علي اقراره ناقل شهادة ( ( ( شهادته ) ) ) ولا ينقل عن الشهادة ( ( ( الشاهد ) ) ) الا اثنان وسنذكره ايضا ( تنبيه ) اذا علمت ما ذكرنا من تقييد قبلو ( ( ( قبول ) ) ) قول الميت بما ذكرنا ظهر لك مافي كلام المصنف من الاجمال وبقي عليه شرطان اخران احدهما ثبوت الموت والثاني ان يكون هناك جرح او ما يقوم مقامه كاثر ضرب او سم لان التدمية البيضاء لايعمل بها علي المشهور وانما يعمل بالحمراء وهي التي صحبها جرح واشار الي مثال ثان من امثلة اللوث بقوله ( او بشاهد ) اي وتجب القسامة ايضا بسبب شهادة ( علي ) معاينة القتل اي مع يمين تكملة للنصاب وسواء تاخر الموت في هذين المثالين ام لا بخلاف المثال الثالث المشار اليه بقوله او بشاهدين اي وكذا تجب القسامة بسبب شهادة عدلين علي معاينة الجرح بالفتح لان المراد الفعل او الضرب عمدا او خطا ولم ينفذ شء من مقاتله ثم يعيش بعد ذلك الجرح او الضرب والحال انه ياكل ويشرب وهذا ليس بقيد كما في خليل وانما المراد يتاخر موته اذا لو مات سريعا بعد جرحه او ضربه او انفذ مقتل من مقاتله بالجرح او الضرب لثبت القتل من غير توقف علي قسامة وتستحق الاولياء القصاص في العمد والدية في الخطا وقولنا علي معاينة الجرح احتراز عن شهادة الشاهدين علي اقرار المقتول بان فلانان ( ( ( فلانا ) ) ) جرحه او ضربه فلا بد من القسامة ولو لم يتاخر الموت لضعف امر الاقرار بخلاف المعاينة ويجب في حال حلفهم ان ياتوا بما يدل علي الحصر بان يقولوا لمن جرحه او ضربه مات او انما مات من جرحه او ضربه  تنبيهان الاول مثل شهادة العدل علي معاينة القتل في انه لوث شهادته علي معاينة الجرح او الضرب فقول الصنف او بشهادة ( ( ( بشاهد ) ) ) علي القتل مثل ذلك شهاته ( ( ( شهادته ) ) ) علي معاينة الحرج ( ( ( الجرح ) ) ) او الضرب عمدا او خطا او علي اقرار المقتول ان فلانا جرحه او ضربه عمدا لا خطا فلا تكفي شهادة الواحد فيه ووجه الفرق ان اقراره في الخطا جار مجري الشهادة علي العاقلة بالدية والشاهد علي اقراره ناقل ويشترط ان ينقل عن كل واحد اثنان كما لو قال قتلني فلان فلا بد من شهادة عدلين علي قوله ولا يكفي الواجد ( ( ( الواحد ) ) ) لان القتل لا يثبت الا بعدلين في العمد والخطا والجرح يثبت عند مالك بالشاهد واليمين ومثله ايضا في انه لوث لو اجتمع اقرار من القاتل بانه قتله خطا وشهادة شاهد علي معاينة ذلك القتل لان القسامة تجب وان تعدد اللوث ومن مثله ( ( ( امثلة ) ) ) اللوث رءية العدل المقتول يتشحط في دمه ويضطرب فيه والشخص المتهم بقربه وعليه اثر القتل بان كان معه الالة ملطخة بالدم فهذه جملة امثلة اللوث الا انه لابد منع ( ( ( بد ) ) ) شهادة العدل الواحد علي الجرح او الضرب من يمين مكملة للنصاب ومثل شهادة العدل شهادة المراتين في كل ما يكفي فيه شهادة العدل وصفة اليمين المكملة للنصاب فيها خلاف فقيل يحلفها قبل ايمان القسامة وقيل يحلفها مع كل يمين من ايمان القسامة بان يقول في الشهادة علي الجرح مع كل خلاف فقيل يحلفها قبل ايمان القسامة وقيل يحلفها مع كل يمين من ايمان القسامة بان يقول في الشهادة علي الحرج مع كل يمين من الخمسين لقد حرجه ( ( ( جرحه ) ) ) ولقد مات من جرحه بخلاف شهادته علي القتل فانهم يحلفون ويقولون في كل يمين لقد قتله فقط وتجب القسامة وان تعدد اللوث وليس من اللوث وجود المقتول في قرية قوم او دارهم حيث كان يخالطهم غيرهم واما ان لم يكن يدخل فريتهم ( ( ( قريتهم ) ) ) سواهم ووجد قتيل من غيرهم فيها فانه يكون لوثا كما في قضية عبد الله بن سهل فانه عليه الصلاة والسلام جعل في القسامة لابني عمه حويصة ومحيضة ( ( ( ومحيصة ) ) ) واخيه عبد الرحمن وانما امتنعوا من الحلف لعدم مشاهدتهم احدا يقتله فدل ذلك علي ان من امثلة اللوث وجود المقتول بمحله قوم او دارهم بشرط كونه غير مطروق ومعلوم ان خيبر اذا ذاك لم يدخلها الا اليهود الثاني حقيقة اللوث امر ينشا عنه غلبة الظن بصدق المدعي وقد مرت امثلته وقال ابن عبد السلام اضعفها اولها لان يشتمل علي قبول دعوي المدعي مت غير بينة او بينة ( ( ( ببينة ) ) ) ضعيفة لان الشاهدين فيه انما شهدا علي قوله قتلني فلان فقط وقد تقدم ان الدماء اعظم حرمة من الاموال ولا يقبل قول المدعي فيها ولو بفلس فكيف يقبل قول المدعي بالقتل بهذه الحجة الضعيفة وايضا في الصحيح من حديث ابن عباس لو يعطي الناس بدعواهم لادعي اناس دماء رجال واموالهم ولكن البينة علي المدعي واليمين علي المدعي عليه وكل ما يحاوله اهل المذهب في هذا ( ( ( هذه ) ) ) المسالة من الحجج ضعيف ولا اعلم من وافق الامام علي قوله في قبول قول المقتول قتلني فلان سوي الليث وجمهور العلماء علي خلافه هكذا حكي عن بعض كبار شيوخ المذهب وقال علامة ( ( ( العلامة ) ) ) البساطي قد اكثر التشنيع علي المالكية فيه هذه المسالة قال الشاذلي في الجواب الدافع لاشكال هذه المسالة واقول قوله عليه الصلاة والسلام المتفق عليه اتحلفون خمسين يمينا الخ صريح قي قبول قول المدعي في الدماء وقال الفاكهاني واستدلال الجمهور لمذهبهم بعدم قبول قول المقتول بحديث لو يعطي الناس الخ لا دليل الهم ( ( ( لهم ) ) ) فيه لان المدعي للدم الطالب له ليس هو المقتول وانما هو الولي ولم ونعطه ( ( ( نعطه ) ) ) بمجرد دعواه بل بما انضم لدعواه من قول المقتول الذي يغلب معه غلبة الظن بصدقه واما قولهم اذا لم يقبل قوله في قليل المال فكيف يقبل في الدماء فلا يلتفت اليه لوجود الفارق وهو ان مشروعية القسامة انما هي لحراسة الانفس فتكفي فيها الشبهة واللطخ لايجاب القصاص الذي هو حياة الانفس قال تعالي @QB@ ولكم في القصاص حياة يا اولي الالباب @QE@ فالعمل بها من المصالح العامة التي بني عليها الامام مذهبه حتي نقل ( ( ( ترتب ) ) ) عنه العلامة خليل في التوضيح انه قال يجوز قتل ثلث المفسدين من المسلمين لاصلاح الثلثين حيث تعين القتل طريقا للاصلاح لا ان كان يحصل بنحو الحبس او الضرب ويعلم ذلك بقراءن الاحوال وانما اطلنا في ذلك لاقتضاء المقام الاختلاف في المسالة كما عرفت ولما قدم ان القتل او الدية انما يتحق ( ( ( يستحق ) ) ) بتمام الحلف شرع في الكلام علي ما اذا لم تحلف الاولياء فقال واذا نكل مدعوا ( ( ( مدعو ) ) ) الدم عن حلف ايمان القسامة ولو بعضهم حيث كان مساويا للحالف في الدرجة حلف كل واحد من المدعي عليهم خمسين يمينا لان كل واحد منهم علي البدل مرتهن بالقتل ومثل نكول البعض عفوه فاذا حلفوا سقط القصاص واذا اراد الناكل الرجوع الي الحلف لم يجب الي ذلك قال خليل فترد علي المدعي عليهم فيحلف كل خمسين ومن نكل حبس حتي يحلف وقال في الجلاب اذا نكل  المدعون للدم عن القسامة وردت الايمان علي المدعي عليهم فنكلوا ( ( ( وربعت ) ) ) حبسوا حتي يحلفوا فان طال حبسهم تركوا وعلي كل واحد منهم جلد ماءة جلدة وحبس سنة انتهي وقال بعض وان كان المحبوس متمردا فانه يخلد في السجن وانما قلت علي البدل لان القسامة لايقل بها اكثر من واحد والاصل في ذلك قصة حويصة ومحيصة وعبد الرحمن بن سهل لما قتل اخوه عبد الله ووجد مقتولا في خيبر لما نكلوا عن اليمين قال صلي الله عليه وسلم افتبرءكم يهود بخمسين يمينا هذا حكم الدعوي علي جماعة واما لو كان المدعي عليه بالقتل واحد فاشار اليه بقول فان لم يجد المدعي عليه بالقتل من يحلف من ولاته اي وان نكل حبس حتي يحلف ولا يطلق ولو طال حبسه ومفهوم كلام المصنف يقتضي انه لو وجد المدعي عليه من يستعين به من عصبته فانه يستعين به علي حلف ايمان القسامة وهو قول ضعيف والمعتمد ما عليه مالك وابن القاسم ان المدعي عليه ليس له الاستعانة باحد من عصبته قال خليل فترد علي المدعي عليهم فيحلف كل خمسين الي قوله والاستعانة بخلاف ولي الدم فان له الاستعانة قال خليل وللولي الاستعانة بعاصبة والفرق بين اولياء الدم وبين المدعي عليهم ان ايمان العصبة موجبه وقد يحلف فيها من يوجب لغيره كولي المحجور في بعض الصور وايمان المدعي عليهم دافعة وليس لاحد ان يدفع بيمينه عن غيره فاللام قول خليل وللولي للاختصاص تنبيه في قول المصنف غير المدعي عليه الاظهار موضع الاضمار فكان المناسب ان لو قال ان لم يجد من يحلف معه من ولاته غيره بل كان الاحسن ان لو قال فان لم يجد من يخلف معه حلف الخمسين وحده ولو ادعي بالبناء للمجهول وناءب الفاعل القتل علي جماعة ونكل المدعون عن القسامة حلف كل واحد من الجماعة المدعي عليهم بالقتل خمسين يمينا لان كل واحد منهم علي البدل مرهون بالقتل فلا يبرا منه لا بحلف خمسين يمينا وظاهره ولو كانوا اكثر من من خمسين رجلا وهو كذلك علي الصحيح ومن نكل من المدعي عليهم بالقتل عن الحبس فانه يحبس حتي يحلف فان طال حبسه اطلق الا ان يكون متمردا فيخلد في السجن
 تنبيهان الاول ما ذكره المصنف حكم النكول في دعوي قتل العمد ولم يتكلم علي اذا ما نكلت الاولياء في دعوي قتل الخطا واشار اليه خليل بقوله وان نكلوا او بعض حلف العاقلة فمن نكل فحصته علي الاظهر ان يحلف كل واحد يمينا واحدا ولو كانوا عشرة الاف فمن حلف برء ومن نكل غرم حصته من الدية والقاتل كواحد عنهم فان لم يكن للمدعي عليه بقتل الخطا عاقله حلف الخمسين وحده وبرء وان نكل غرم جميع الدية ان لم يكن بيت مال او حصته التي تخصه ان لو كانت عاقلة ان كان هناك بيت مال لما تقرر من انه ان لم توجد عاقلة للقاتل تكون الدية علي بيت المال والقاتل كواحد وان لم يكن بيت مال او كان ولا يمكن الوصول اليه يغرم جميعها القاتل وتدفع في تلك الحالة للحالف والناكل من ورثة المقتول الا في صورة وهي ما اذا حلف بعض الاولياء جميع ايمان القسامة لغيبة بقية الاولياء واخذ نصيبه من الدية ثم قدم الباقون ونكلوا وردت الايمان علي العاقلة فان حصة الناكل منهم تدجفع ( ( ( تدفع ) ) ) للناكلين من اولياء المقتول فقط ولا ياخذ الحالف منها شيءا والحاصل ان حالف بعض الايمان والناكل ومثلها ( ( ( ومثلهما ) ) ) من قال من الاولياء لا ادري يدخلون في المال الذي يغرمه الناكل من عاقله المدعي عليه الثاني قول المصنف ولو ادعي القتل علي جماعة الخل ( ( ( الخ ) ) ) محض تكرار مع قوله فيما سبق واذا نكل مدعو الدم حلف كل واحد خمسين يمينا وما اجاب عض الشراح من حمل ما سبق علي دعوي القتل علي واحد بعيد من كلامه ثم شرع في بيان صفة حلف ايمان القسامة ومن يحلفها اذا وجبت بقوله ويحلف من الولاة جمع ولي وهم عصبة المقتول ولو بالولاء في طلب الدم خمسون رجلا خمسين يمينا كل واحد يحلف يمينا وهذا واضح ان وجد من العصبة عدد ايمان القسامة وان كانوا اي الولاة اقل من الخمسين قسمت عليهم تلك الايمان فان كانوا خمسة حلف كل واجد عشر ايمان وان كانا اثنين حلف كل واحد خمسا وعشرين يمينا وان حصل انكسار بان زادوا علي اثنين ونقصوا عن الخمسين فانه يجدب تكميل الكسور عند تساويها وتكميل الاكبر عند اختلافها قال خليل وهيرت ( ( ( وجبرت ) ) ) اليمنين ( ( ( اليمين ) ) ) علي اكبر كسرها والا فعلي الجميع ولا ياخذ احد الا بعدها تنبيه ظاهر كلام المصنف انه اذا بلغ عدد الاولياء عدد ايمان القسامة وكانوا اكثر لابد من حلف خمسين منهم ولا يكفي حلف اقل من خمسين رجلا وليس كذلك بل يكفي حلف اثنين طاعا من اكثر قال خليل واحري باثنين طاعا من اكثر فقول المصنف ويحلف في طلب الدم خمسون رجلا معناه يجوز لا انه يجب  فلا ينافي جواز حلف اقل ولذلك بين خليل اقل من يحلف في العمد حيث قال ولا يحلف في العمد اقل من رجلين عصبة والا فموال ولذلك قال المصنف ولا تحلف امراة في اثبات قتل العمد لعدم صحة شهادة النساء فيه وان انفردن قال خليل ولا يحلف في العمد اقل من رجلين عصبة والا فموال فان لم يوجد للمقتول الا عاصب فيلزمه الاستعانة بعاصبه الاجنبي من المقتول كما اذا قتلت امه فان له الاستعانة بعمه فان لم يستعن او لم يجد من يستعين به فالايمان ترد علي الجاني فان حلف برء وان نكل حبس ولا يطلق ولو طال حبسه وعند انفراد النساء يصير المقتول بمنزلة من لا وارث له فترد الايمان علي المدعي عليه والاصل في ذلك قوله @QB@ ومن قتل مظلوما فقد جعلنا لوليه سلطانا @QE@ والوالي ( ( ( والولي ) ) ) رجل لقوله عليه الصلاة والسلام لا نكاح الا بولي ولانه عليه الصلاة والسلام خاطب الرجال بقوله اتحلف لكم يهودا ( ( ( يهود ) ) ) في حديث حويصة ومحيصة المتقدم ولم يسال النساء واما الخطا فيحلف فيه كل من يرث ولو امراة ولذلك قال وتحلف الورثة في اثبات قتل الخطا بقدر ما يرثون من الدية من رجل او امراة قال خليل ويحلفها في الخطا من يرث وان واجد او امراة وتحلف الايمان كلها ولا تاخذ الا فرضها ومثلها الاخ للام ويسقط ما علي الجاني مما زاد علي نصيب الحالف لتعذر الحلف من بيت المال ولكن ترد الايمان علي العاقلة بمنزلة نكول اولياء المقتول وان نكلت غرمت لبيت المال ولما كانت الايمان في الخطا يحلفا ( ( ( يحلفها ) ) ) كل من يرث وقد يختلف الميراث فيحصل كسر الايمان بين حكم ذلك بقوله وان انكسرت يمين عليهم اي الورثة كابن وبنت فالمسالة من ثلاثة لان الذكر براسين فيخصه من الخمسين ثلاث وثلاثون وثلث يمين ويخص البنت ست عشرة وثلثا يمين حلفها اي اليمين المنكسر ( ( ( المنكسرة ) ) ) اكثرهم نصيبا منها اي من اليمين المنكسرة وهو البنت فتحلف سبع عشرة يمينا وانما قال منها بالضمير العاءد علي اليمين المنكسرة لءلا يتوهم ان الضمير يرجع للاكثر من الايمان قال خليل وجبرت اليمين علي اكثر كسرها والا فعلي الجميع ولما كان الاخذ من دية الخطا يتوقف علي جميع ايمان القسامة قال واذا حضر بعض ورثة دية الخطا وغاب الباقي او كان صغيرا او مجنونا لم يكن له اي لذلك الحاضر بد بضم الموحدة وشد الدال المهملة اي مهرب من ان يحلف جميع الايمان حتي يستحق نصيبه من الدية فاذا حلف الخمسين يمينا اخذ حصته لان الدية لا تلزم الا بعد ثبوت القتل وهو لايثبت الا بعد حلف جميع الايمان ثم بعد حلف الحاضر جميع الايما ( ( ( الايمان ) ) ) يحلف من ياتي من غيبته او من بلغ بعده اي بعد حلف الحاضر جميع الايمان بقدر نصيبه من الميراث قال خليل ولا ياخذ احد الا بعدها ثم حلف من حضر حصته وظاهر كلام المصنف كغيره ان القادم لا يلزه ( ( ( يلزمه ) ) ) الا قدر حصته ولو رجع الحالف اولا عن جميع الايمان التي حلفها وهو كذلك وانما طلب من الغاءب الحلف بعد حلف الحاضر جميع الايمان لانه لا يثبت الدم في حق كل احد الا بعد حلفه واما لو مات الغاءب او من كان صبيا وورثه الذي حلف جميع الايمان فقيل لابد من حلفه حتي يستحق حصت ( ( ( حصة ) ) ) الميت وقيل لا يلزمه يمين لحلفه جميع الايمان اولا ثم بين صفة تغليظها بقوله ويحلفون اي الاولياء في القسامة حالة كونهم قياما تغليظا عليهم وكذا غيرها من ايمان ساءر الحقوق قال خليل وغلظت في ربع دينار بجامع كالكنيسة وبيت النار وبالقيام لا بالاستقبال ولا بالزمان وحكم التغليظ الوجوب فمن امتنع منه عدنا ( ( ( عد ) ) ) كلا ( ( ( ناكلا ) ) ) وهو من حق الخصم وكا ( ( ( وكما ) ) ) يحصل التغليظ بالقيام وما ذكر يحصل بما اشار اليه بقوله ويجلب ابالبناء ( ( ( بالبناء ) ) ) للمفعول الي مكة والمدينة وبيت المقدس وناءب فاعل يجلب اهل اعمالها اي اهل طاعة هذه الاماكن الذين يءدون لها الزكاة والكفارة وبيت ( ( ( وبين ) ) ) علة الجلب الي تلك الاماكن بقوله للقسامة ولو كان موضع من توجهت عليه القسامة علي عشرة ايام لفضل هذه الاماكن وتغليظا وردعا للكاذب ومفهوم القسامة ( ( ( للقسامة ) ) ) انه لايجلب احد الي تلك الاماكن في حلف غير القسامة لعظم امر القسامة باعتبار ما يترتب عليها ولا يجلب للقسامة في اي الي غيرها اي المواضع الثلاثة المذكورة من مسجد او غيره من الاماكن المعظمة عند الحالف الا ان يكون الجلب من الاميال اليسيرة كالثلاثة وقيل كالعشر وحاصل المعني ان من توجهت عليه القسامة وهو من غير اهل اعمال الاماكن الثلاثة لايجلب من منحله ( ( ( محله ) ) ) الي حلفها في مسجد او غيره الا اذا كان  المسجد قريبا من بلدة بان كان بينه وبيت ( ( ( وبينه ) ) ) الاميال اليسيرة والفرق بين تلك القسامة قتل الحر المسلم شرع من مفاهيم تلك الاوصاف بقوله ولا قسامة مشروعة في جرح بالضم لان المراد الاسم وهذا مفهوم قتل وانما لم تشرع القسامة في الجرح لانه صلي الله تعالي عليه واله وسلم انما حكم بها في النفس واذا قلنا بنفي القسامة في الجرح فتارة يكون عمدا وتارة يكون خطا وفي كل اما ان يثبت بشاهدين او يوجد شاهد فقط فان ثبت بشاهدين فادية ( ( ( فالدية ) ) ) في الخطا او القصاص في العمد وان لم يشهد به الا واحد فانه يحلف مع الشاهد يمينا واحدا وياخذ الدية في الخطا ويقتص في العمد وهي احدي مستحسنات الامام مالك رضي الله تعالي عنه وان تجردت الدعوي عن الشاهد فقيل يحلف المدعي عليه وقيل لايحلف واشار الي مفهوم قولنا حر بقوله ولا قسامة في عبد وجد منفوذ المقاتل وهو يقول دمي عند فلان ولو شهد علي قوله عدلان لانه مال فان ثبت ان فلانا قتله بشاهدين غرم قيمته في العمد والخطا وان شهد عدل او امراتان حلف سيدة يمينا واخذ قيمته ايضا ويضرب القاتل ماءة ويحبس سنة واشار الي مفهوم المسلم بقوله ولا قسامة ايضا بين اهل الكتاب وبين المدعي عليه المسلم والمعني ان الذمي اذا وجد منفوذ المقتاتل ( ( ( المقاتل ) ) ) وهو يقول دمي عند فلان المسلم وشهد علي اقراره عدلان فانه لاقسامة فيه لان القسامة سببها قتل الحر المسلم واذا قلنا بعدم القسامة في القتل ( ( ( قتل ) ) ) الكافر فان ثبت ان المسلم قتله بشاهدين فانه يغرم ديته في العمد من ماله ومع العاقلة في قتل الخطا وان لم يوجد الا شاهد فان وليه يحلف يمينا واجدة وياخذ ديته ويضرب الجاني ماءة في العمد ويحبس سنة فان لم يكن الا دعوي ولي الكافر علي المسلم فانه لايلتفت اليه قال العلامة خليل ومن اقام شاهدا علي جرح او قتل كافر او عبد او حلف واحد واخذ الدية في الخطا والمراد الدية اللغوية وهي المال الءدي ( ( ( المءدي ) ) ) فيشمل دية الجرح وقيمة العبد الغرة ( ( ( والغرة ) ) ) في الجنين والدية الحقيقية ان استهل والحاصل ان حكم قتل الكافر والعبد والجنين الحر حكم الجراح فمن اقام شاهدا علي جرح عمدا او خطا او علي قتل كافر عمدا او خطا او علي قتل عبد عمدا او خطا او علم قتل حنين ( ( ( جنين ) ) ) حر عمدا او خطا يريد ونزل الجنين ميتا فانه يحلف يمينا واحدة وياخذ دية ذلك ويقتص في جراح العمد لانه لا قسامة في الجرح ومعلوم انه لا يقتص في الجرح الا عند المكافاة فان لم يحلف المدعي برء الجارح ان حلف والا حبس في جرح العمد وغرم في غيره واما لو قال الكافر المنفوذ المقاتل دمي عند فلان الكافر وترافعوا الينا فلا نزاع في انا لا توجب ( ( ( نوجب ) ) ) عليهم قسامة بخلاف ما اذا قال المسلم دمي عند فلان الكافر فان فيه القسامة ويستحقون القصاص في العمد والدية في الخطا لانه لا يثقبت ( ( ( يثبت ) ) ) دم مسلم بالقسامة في محلها ولا قسامة ايضا في قتيل وجد مطروحا بين الصفين من المسلمين الباغي كل منهما علي الاخر ويكون دمه هدرا ولو قال ذلك المقتول دمي عند فلان وهذا هو المعتمد من اقوال ثلاثة اشار اليها خليل بقوله وان انفصلت بغاة عن قتلي ولم يعلم القاتل فهل لا قسامة ولا قود مطلقا او ان تجرد عن تدميه وشاهد او عن الشاهد فقط تاويلات ومفهموه ( ( ( ومفهومه ) ) ) انه لو علم القاتل بينه ( ( ( ببينة ) ) ) شهدت علي عينه لا قتص منه قال مالك وقيدنا الصفين بالمسلمين لاخراج من وجد مطروحا بين الكفار والمحاربين فليس الحكم فيه كذلك وقيدنا بقولنا الباغي كل منهما للاحتراز عن قتال احدهما مع تاويل شبهة المشار اليه بقول خليل وان تاولوا فهدر كزاحفة علي دافعة لكن ان كان التاويل من الجانبين بان ظنت كل طاءفة جواز قتالها للاخري لكونها اخذت مالها او نحو ذلك فدم منهما هدر واما ان كان في الازدحام في نحو السوق او المسجد او عند دفع الناس من عرفة فان هذا يكون هدرا لانه لم يعلم له قاتل يتبع مع الاذن في الاجتماع في تلك الاماكن خلافا لبعض الاءمة او اي وكذا لا قسامة في قتيل وجد مطروحا في محله قوم اي قريتهم والحال انه ليس عنده احد متهم بالقتل قال خليل وليس منه اي اللوث وجوده بقرية قوم او دراهم ( ( ( دارهم ) ) ) لانا لو جعلناه لوثا لكان كل من اراد اذية غيره يقتل شخصا ويطرحه في داره او قريته ولان الشان والعادة ان من يقتل سخضا ( ( ( شخصا ) ) ) لا يبقيه في محله ومحل كلام المصنف كخليل حيث كان المحل الذي وجد فيه المقتول مطروقا لمرور الناس فيه غير اهله واما لو كان لا يمر فيه الا اهله ووجد فيه شخص مقتول من غيرهم فانه يكون لوثا كما تقدم في قضية عبد الله بن سهل فانه وجد مقتولا في خيبر وخير صلي لله عليه وسلم خويصة ( ( ( حويصة ) ) ) ومحيصة ابني عمه مع اخيه عبد الرحمن في القسامة وما ذاك الا لان خيبر لم يدخلها اذا ذاك الا اليهود كما اوضحنا ذلك فيما مر واحترزنا بقولنا والحال انه ليس عنده الخ عن بعض امثلة اللوث المتقدمة كرءيته يتشحط في دمه  والمتهم قربه عليه اثار القتل او راه خارجا من محل المقتول وليس فيه سواه فان ذلك يكون لوثا تحلف الولاة معه خمسين يمينا ويستحقون القود في العمد والدية ف الخطا ولما كان الحق للاولياء عند ثبوت القتل في القصاص والعفو وكان قتل اغيلة ( ( ( الغيلة ) ) ) لا حق فيه للولي بل لله تعالي اشار بقوله وقتل الغيلة بكسر الغين المعجمة وهو القتل لاكثر المال لا عفو فيه لا للاولياء ولا للسلطان ولا للمقتول ايضا ولو بعد انفاذ مقاتله ولو كان المقتول كافرا والقاتل حرا مسلما لان قتله علي هذا الوجه في معني الحرابة والمحارب بالقتل يجب قتله ولو بعبد وكافر وانما لم يجز العفو عن قاتل الغيلة لان قتل القاتل المذكور مع دفع الفساد في الارض فالقتل حق الله لا للادمي وعلي هذا فيقتل حدا ولا قودا ( ( ( قود ) ) ) وفسر الغيلة بالقتل لاخذ المال للاحتراز عن القتل لناثره اي لعدواة ( ( ( لعداوة ) ) ) بين القاتل والمقتول فان فيه القصاص ويجوز للولي العفو فيه وعن القتل لطلب الامارة ايضا فانه يصير من البغاة وليس من المحاربين وذلك لان من قاتل لطلب الامارة قصد ( ( ( قصده ) ) ) في الغالب خلع الامام ولما كان يتوهم من كون الحق للاولياء في قتل غير الغيلة عدم صحة عفو المقتول عن دم نفسه دفع هذا الايهام بقوله ويجوز للرجل المراد المقتول ولو انثي او صغيرا او سفيها العفو عن دمه اي دم نفسه في قتل العمد حيث وقع العفو منه بعد انفاذ مقاتله وقبل زهوق روحه لانه لا كلام للولي في شانه في تلك الحالة ولا لذي دين عليه قال القرافي لان للقصاص سببا وهو انفاذ المقاتل وشرطا وهو زهوق الروح فان عفا المقتول عن القصاص قبلهما لم يعتبر عفوه وعفوه بعدهما متعذر لعدم الحياة المانع من التصرف فلم يبق الا ما بينهم ( ( ( بينهما ) ) ) فينفذ اجماعا وبهذا علمت انه لا منافاة بين كلام المصنف وقول خليل مبالغا علي وجوب القصاص ولو قال ان قتلتني ابراتك فلا يعتبر كلامه ولا ابراءه ولا بد من القصاص لان العفو قبل انفاذ المقاتل عن شء لم يجب له وبعد انفاذ شء منها وقبل خروج روحه الحق له في القتل فيصح عفوه عن قاتله ويسقط قتل القاتل ونظير ذلك من قال لاخر اقطع يده ( ( ( يدي ) ) ) او احرق ثوبي فيفعل فلا شء علي الفاعل والحاصل ان الحق انما يكون للاولياء حيث لا عفو منه في تلك الحالة والتقييد بقوله ان لم يكن قتله غيله بان كان لعدواة ( ( ( لعداوة ) ) ) وهذا مستغني عنه لفهمه من قوله وقتل الغيلة لا عفو فيه الا ان يقال صرح به دفعا لما قد يتوهم من ان لا عفو فيه لغير المقتول واشار الي مفهوم العمد بقوله وعفوه اي المقتول ولو قبل انفاذ شء من مقاتله عن قاتله علي وجه الخطا جاءز ويكون منه وصية بالدية للعاقله فتكون في ثلثه فان حملها نفذت قهرا علي الورثة مثل ان يكون عنده الفان من الدنانير وديته الفا فان الدية تسقط عن عاقله القاتل وان لم يكن عنده مال سقط عن القاتل مع عاقلته ثلث الدية الا ان تحيز الورثة الزاءدة ( ( ( الزاءد ) ) ) كساءر الوصايا بالمال ولما فرغ من الكلام علي عفو المقتول عمن قتله شرح ( ( ( شرع ) ) ) في الكلام علي عفو بعض اولياءه فقال وان عفا عن القاتل احد البنين وما في حكمهم من كل شخصين او ثلاثة مشتركين في الاستحقاق لتساويهم كاحد عمين او اخوين او معتقين فلا قتل لسقوطه بالعفو قال خليل وسقط ان عفا رجل كالباقي واما لو لم يكن العافي مساويا لغيره ففيه تفصيل فان كان غير العافي اقرب منه فان لا عبرة بعفوه كا ( ( ( كما ) ) ) لو عفا العم مع وجود الاخ واما لو كان العافي اقرب فسقوط القتل اولي من عفو المساوي واما سقط القتل بعفو بعض المستحقين لان الدم لا يتبعض فاذا سقط بعضه سقط جميعه ثم فرع علي سقوطه قوله ولمن بقي من مستحقي الدم وامتنعوا من العفو نصيبهم من الدية اي دية عمدا ( ( ( عمد ) ) ) قال خليل ومهما اسقط البعض فلمن بقي نصيبه من دية عمد كارثة ولو قسطا من نفسه والمعني ان القتل اذا كان عمدا وعفا عن القصاص بعض المستحقين المستويين ( ( ( المستوين ) ) ) في الدرجة بعد ترتب الدم وثبوته ببينه او اقرار او قسامة فان القود يسقط ولمن لم يعف نصيبه من دية عمد ومقتضي قوله فلمن بقي ان العافي لا شء له الا ان يكون قد عفا عليها صريحا او يظهر منه ارادتها قال خليل ولا دية لعاف مطلق الا ان تظهر منه ارادتها فيحلف ويبقي علي حقه
 تنبيهان الاول محل سقوط القتل بعفو بعض المستحقين اذا كان ممن يعتبر عفوه بان كان بالغا عاقلا الثاني محل اسقاط الباقي نصيبه من الدية اذا كان له التكلم في العفو وعدمه او مع من له التكلم مثال الاول عفو اجد البنين الذكور ومثال اثاني ( ( ( الثاني ) ) ) لو عفا احد البنين ومعهم بنت واما لو عفت البنت مجانا ومعها اخت فلا شء للاخت لانها لا تكلم لهما لان البنت اولي من الاخت في عفو وضده حيث كان القصاص ثابتا ببينة او اعتراف من الجاني واما لو اجتاج ( ( ( احتاج ) ) ) الي قسامة فلا  تقسم النساء وانما تقسم العصبة فالقول لهم في القتل وان ارادوا العفو فلا بد من اجتماع الفريقين او بعض من كل لقول خليل وفي رجال ونساء لم يسقط الا بهما او ببعضهما الثالث في قول المصنف نصيبهم بالجمع العاءد علي من المفردة لفظا مراعاة المعني كما لا يخفي وهو جاءز نحو @QB@ ومنهم من يستمعون @QE@ بخلاف الاية الاخري نحو @QB@ ومنهم من يستمع @QE@ بافراده بالنظر للفظهما ( ( ( للفظها ) ) ) ولما قدم حكم عفو بعض الذكور المتساويين في الدرجة شرع في حكم اجتماع الذكور والاناث وفيه صورتان احداهما ان تكون الاناث في درجة الذكور واشار اليها بقوله ولا عفو معتبر للبنات مع البنين ولا للاخوات مع الاخوة وامما العفو الاستيفاء ( ( ( والاستيفاء ) ) ) للعاصب دون من معه من الاناث المتساويات والصورة الثانية ان تكون النساء علي درجة الذكور فان كان القتل ثابتا ببينه او اعتراف الجاني فستيفاء ( ( ( فالاستيفاء ) ) ) للنساء لقول خليل بعد قوله والاستيفاء للغاصب ( ( ( للعاصب ) ) ) وللنساء ان ورثن ولم يساوهن عاصب واما لو اجتاج ( ( ( احتاج ) ) ) الثبوت الي قسامة فلا يقسم في العمد الا الرجال العصبة وبعد ذلك لكل القتل ولا عفو الا باجماع الفريقين او البعض من كل فتلخص ان اولياء الدم اما رجال فقط او نساء فقط واما رجال ونساء وقد علمت حكم الجميع تنبيه الاناث اللاتي لهن مدخل في الدم علي المشهور البنات دون بناتهن وبنات الابناء الذكور وان سفلوا دون بناتهن والاخوات الاشقاء او الاب ( ( ( لاب ) ) ) والام عند ابن القاسم وان عفت احدي المتساويات بعد ثبوت الدم بالبينة والاعتراف فانظر ( ( ( فالنظر ) ) ) للامام العادل في العفو او القتل وان لم يجد ( ( ( يوجد ) ) ) امام عادل فجماعة المسلمين وان تنازعت بنت واخت فالبنت احق في عفو وضده حيث لا حاجة الي القسامة ثم شرع فيما يترتب علي قاتل العمد العدوان اذا لم يقتص منه فقال ومن عفي عنه في قتل العمد العدوان او سقط عنه القصاص لعدم المكافاة بان كان القاتل اعلي بان كان زاءدا في الحرية او الاسلام او ورث دم نفسه ول قسطا منه مثل ان يقتل احد ابنين اباه عمدا ثم مات الابن الاخر فان القاتل قد ورث جميع دم نفسه ومثال ارث القسط ان يقتل احد الاولاد باه ( ( ( اباه ) ) ) عمدا وثبت القصاص عليه لجميع اخواته ( ( ( اخوته ) ) ) ثم يموت احداهم ( ( ( احدهم ) ) ) فان القصاص يسقط عن القاتل لانه ورث بعض دم نفسه ولبقية اخوته حظهم من دية العمد لان الارث كالعفو ضرب بالبناء للمجهول وناءب الفاعل الضمير علي من الشرطية وهذا جوابها ماءة سوط ردعا وزجرا له وماءة بالنصب نيابة عن المفعول المطلق وحبس عاما قال خليل وعليه اي القاتل مطلقا جلد ماءة ثم حبس سنة وان يقتل ( ( ( بقتل ) ) ) مجوسي او عبد ويستفاد من كلام العلامة خليل ان الضرب مقدم علي الحبس ولا فرق بين كون القاتل ذكرا او انثي او حرا او عبدا وانما يشترط في تاديبه تكليفه فان عمل الصحابة رضي الله عنهم مضي علي ذلك وقد خرج الدارقطني ان رجلا قتل عبده فجلده صلي الله عليه وسلم ماءة جلدة ونفاه سنة ومحا سهمه من المسلمين وصحح هذا الحديث ابن القطان فينبغي للمالكي التعويل عليه لانه حجة للمذهب في قاتل العبد العدوان اذا سقط عنه القتل بعفوا ( ( ( بعفو ) ) ) او عدم مكافاة ولعل قول بعض شراح خليل وبعض شراح هذا الكتاب من غير تغريب وانما يحبس في بلده مبني علي عدم التعويل علي هذا الحديث وعدم الوقوف عليه ولما كان قتل العمد العدوان انما فيه القصاص او العفو مجانا الا ان يتراضيا علي الدية واما الخطا فليس فيه الا الدية اشار اليها بقوله والديه بالدال المهملة المشددة والياء المخففه واحدة الديات ماخوذه من الودي الذي هو الهلاك وحقيقتها الاصطلاحية الشاملة للعمد والخطا مقدار معلوم من المال علي عاقله القاتل في الخطا وعليه في العمد بسبب قتل ادمي حر معصوم ولو بالنسبة لقاتله عوضا عن دمه دل علي وجوبها الكتاب والسنة واجماع الامة اما الكتاب فقوله تعالي @QB@ فتحرير رقبة مءمنة ودية مسلمة الي اهله @QE@ واما السنة ففي الموطا ان رسول الله صلي الله عليه وسلم كتب لعمرو بن حزم ان في النفس ماءة من الابل واما الاجماع فقد حكاه القرافي ولما كانت دية الخطا تختلف باختلاف القاتل قال علي اهل الابل ماءة من الابل كان المحل للضمير بان يقول منها والمعني ان القاتل اذا كان من اهل الابل يجب عليه مع عاقلته دفعها من الابل ولو كان القتول ( ( ( المقتول ) ) ) من اصحاب الذهب او الورق وسياتي صفة دفعها وبيان سن الابل ويحب علي القتل ( ( ( القاتل ) ) ) اذا كان من اهل الذهب كاهل مصر والشام الف دينار من الذهب وزنه اثنان وسبعون شعيرة متسوطات ( ( ( متوسطات ) ) ) وعلي القاتل اذا كان من اهل الورق كاهل العراق وفارس والروم اثنا عشر الف الدرهم وزن الدهم خمسون وخمسا ( ( ( وخمس ) ) ) شعيرة فصرف دينار الدية اثنا عشر درهما كدينار السرقة والنكاح بخلاف دينار الجزية والزكاه فصرفه عشرة دراهم واما دينار الصرف فلا ينضبط والي تلك المسالة الاشارة  بقول خليل وعلي الشامي والمصري والمغربي الف دينار وعلي العراقي اثنا عشر الف درهم الا في المثلثة فيزداد ( ( ( فيزاد ) ) ) نسبه ما بين الديتين تنبيهان الاول اعلم ان اهل الوادي ( ( ( البوادي ) ) ) في كل اقليم من اهل الابل فان لم يوجد عندهم الا الخيل والبقر فلا نص والظاهر تكليفهم بما يجب علي حاضرتهم من ذهب او فضة الثاني علم مما قررنا ان كلام المصنف في دية الحر المسلم الذكر في قتل الخطا كما يدل عليه قوله بعد ودية العمد وكون دية العمد وكون دية الخطا علي عاقلة القاتل من سنة رسول الله صلي الله عليه وسلم فلا خلاف فيها بين العلماء وهذا امر كان في الجاهلية فاقره النبي صلي الله عليه وسلم في الاسلام وان كان القياس خلاف ذلك اذا لا يحمل احد جناية احد لقوله تعالي @QB@ لها ما كسبت وعليها ما اكتسبت @QE@ @QB@ ولا تكسب كل نفس الا عليها ولا تزر وازرة وزر اخري @QE@ والجاعل لها ماءة من الابل النبي صلي الله عليه وسلم حيث كتب لعمرو بن حزم ان في النفس ماءة من الابل والجاعل لها الف دينار اثني ( ( ( واثني ) ) ) عشر الف درهم عمر بن الخطاب وروي عن النبي صلي الله عليه وسلم ايضا انه كتب لعمر ( ( ( لعمرو ) ) ) بن حزم ان علي اهل الذهب الف دينار وفي الموطا للامام مالك رضي الله عنه الامر المجمع عليه عندنا انه لا يقبل من اهل القري في الدية ابل ولا من اهل العمود ذهب ولا ورق ولا من اهل الذهب ورق ولا ابل اي فدفعها من تلك الانواع واجب ولعل هذا عند الامكان كما يءخذ مما قدمناه في التنبيه الاول ولما كان الكلام المتقدم في دية الخطا قال ودية والحسر ( ( ( الحر ) ) ) المسلم الذكر العمد اذا قبلت بان حصل عفو عليها او تعذر القصاص لفقد المماثلة فانها تءخذ من اربعة انواع خمس وعشرون حقه وهي بنت اربع سنين وخمس وعشرون جذعة وهي بنت خمس سنين وخمس وعشرون بنت لبون وهي بنت ثلاث سنين وخمس وعشرون بنت مخاض وهي بنت سنتين قال خليل وربعت في عمد بحذف ابن اللبون فهي ناقصه عن دية الخطا بالنسبة للانواع وان كانت العدة واحدة وانما اخذت من الاربعة انواع تغليظا عن القاتل
 تنبيهان الاول ظاهر كلام المصنف ان دية العمد لا تغلظ بالتربيع الا علي اهل الابل وهو كذلك علي المشهور فلا تغلظ علي اهل الذهب ولا الورق ومقابل المشهور تغلظ وصفه تغليظها ان تقوم دية العمد من الابل علي انها من اربعة انواع وحالة وعلي انها من خمسة انواع ومءجله فاذا قيل قيمة دية الخطا المخمسة ماءة والمغلظه لمربعة قيمتها ماءة وعشرون فبتلك النسبة يزداد ( ( ( يزاد ) ) ) علي قاتل العمد فيزاد علي الدية من الذهب او الورق مثل خمسها الثاني انما قال اذا قبلت لما تقدم من ان قتل العمد لا شء فيه الا القصاص او العفو مجانا الا ان يطيع الجاني يدفع ( ( ( بدفع ) ) ) الدية ويقبلها المستحق لدم القاتل لان الولي اذا طلبها وامتنع القاتل من دفعها لا يجير ( ( ( يجبر ) ) ) علي دفعها خلافا لاشهب ولما فرغ من الكلام علي دية العمد شرع في دية الخطا فقال ودية الذكر الحر المسلم الخطا علي القاتل البادي مخمسة ( ( ( خمسة ) ) ) اي تءخذ من خمسة انواع عشرون من كل ما ذكرناه من الاسنان فيجب عشرون حقه حذعة ( ( ( وعشرون ) ) ) وعشرون بنت مخاض وعشرون بنت لبون ويزداد علي ذلك عشرون ابن لبون ذكرا قال خليل ودية الخطا علي البادء ( ( ( البادء ) ) ) مخمسة بنت مخاض وولد لبون وحقه وجذعه وانما خمست دية الخطا رفقا بمءديها واول من سنها ماءة من الابل علي الاطلاق عبد المطلب وقيل النضر بن كنانة واقره صلي الله عليه وسلم في الاسلام فقد كتب لعمرة ( ( ( لعمرو ) ) ) بن حزم ان كل نفس ادمي ماءة ولما كانت الدية علي ثلاثة اقسام مخمسة وهي دية الخطا ومربعة وهي دية العمد اذا قبلت وكان القاتل ليس اصلا للمقتول ومثلثه وذلك فيما اذا قتل الاصل وان علا فرعه وان سفل ولما فرغ من الكلام علي القسمين الاولين شرع في الثالث ( ( ( الاول ) ) ) بقوله وانما تغلظ الدية في الاب المراد الاصل وان علا فيشمل الاجداد والجدات يرمي ابنه اي فرعه وان سفل بحديدة او غيرها فيقتله من غير قصد منه لقتله فلا يقتل به لحرمه الابوة ولكن تغلظ عليه الدية بالتثليث قال خليل وثلثت في الاب ولو مجوسيا في عمد لم يقتل به وذلك بان لا يقصد ازهاق روحه بفعل ليس شانه القتل لا ان قتله خطا فتكون ديته مخمسة كغيره من الاجانب ولا ان قصدت ( ( ( قصد ) ) ) قتله او فعل به شيءا شانه القتل بان ذبحه او  شق جوفه والا قتل به والحاصل ان الاصل لا يقتل بفرعه الا اذا اعترف بقصده ( ( ( بقصد ) ) ) قتله او فعل به فعلا شانه القتل بان ذبحه او شق جوفه وبين صفة التثليث بقوله وحيث قلنا لا يقتل به يكون عليه اي الاصل دون عاقلته لوارث فرعه المقتول ثلاثون جذعة وثلاثون حقه واربعون خلفة بكسر اللام وفسرها بقوله في بطونها اولادها فهذه جملة الماءة وانما غلظنا علي الاب بالتثليث ولم يقتل بفرعه لان حالة متوسط بين العمد والخطا لا تعمد الرمي يناسب ( ( ( يناسبه ) ) ) التغليظ وما عنده من الحنان والشفقة يناسبه اسقاط القتل كالخطا وقيل ذلك المذكور من الانواع الثلاثة المذكورة في دية الفرع علي عاقلته اي عاقلة الاصل وهي عصبته ولو بالولاء ولو كان له مال وانما عليه كواحد منهم وقيل ذلك في ماله ان كان له مال والا فعلي عاقلته فجملة الاقوال ثلاثة والراحد ( ( ( والراجح ) ) ) الاول لان العاقلة لا تحمل العمد والدليل عل وجوب تثليثها ما في المعطا ( ( ( الموطا ) ) ) ان رجلا من بني مدلج يقال له قتادة حذف ابنه بسيف فاصاب ساقه فنزا جرحه حتي مات فقدم سراقة بن جعشم علي عمر بن الخطاب فذكر ذلك له فقال لعمر ( ( ( عمر ) ) ) المدد ( ( ( اعدد ) ) ) لي علي ماء قديد عشرين وماءة بعير حتي اقدم عليك فلما قدم عمر اخذ من تلك الابل ثلاثين حقة وثلاثين دذعة ( ( ( جذعة ) ) ) واربعين خلفة ثم قال اين اخو المقتول فقال ها انا ذا فقال خذها فان رسول الله صلي الله عليه وسلم قال ليس للقاتل من مقتوله شء وفي غير الموطا دعا ام المقتول واخاه فدفعها اليهما ثم قال عمر سمعت رسول الله صلي الله عليه وسلم يقول لايرث القاتل شيءا ممن قتل
 تنبيهان الاول تكلم المصنف علي تغليظها بالتثليث علي الاصل اذا كان من اهل الابل ولم يتكلم علي ما اذا كان الاب من اهل النقد وفي تغعليظها ( ( ( تغليظها ) ) ) عليه خلاف والمعتمد انها تغلظ عليه ايضا ومشي عليه خليل حيث قال وعلي الشامي والمصري والمغربي الف دينار وعلي العراقي اثنا عشر الف درهم ولا يزاد علي ذلك الا في المثلثة فيزاد نسبة ما بين الديتين لانه لا طريق لنا الي معرفة التغليظ من الذهب والورق الا هذا الميزان فتقوم المثلثة حالة والمخمسة علي تاجيلها ويءخذ اما زادته المثلثة علي المخمسة وينسب الي المخمسة فما بلغ بالنسبة يزاد علي الدية بتلك النسبة فاذا قيل المخمسة علي اجلها تساوي ماءة والمثلثة علي حلولها تساوي ماءة وعشرين فانه يزادا ( ( ( يزداد ) ) ) علي الدية المخمسة مثل خمسها فتكون من الذهب الفا وماءتين من الورق اربعة عشر الف درهم واربعماءة درهم وتقدم ان المربعة لا تغلظ الا من الابل لا ان كانت دية العمد من العين فلا تغلظ علي المعتمد وانما يدفع الجاني الف دينار او الاثني ( ( ( الاثنا ) ) ) عشر الف درهم الثاني علم مما ذكرنا من نص خليل ان ما ذكره المصنف لا يختص بالمسلم بل لو فعله الكافر بابنه وترافعوا الينا لغلظت علي الاب الدية ولو كان مجوسيا ولفظ خليل وتثلث في الاب ولو مجوسيا في عمد لم يقتل به ولما فرغ من الكلام علي دية الحر الذكر المسلم شرع في بيان مقدار دية المراة فقال ودية المراة الحرة المسلمة علي النصف من دية الرجل الحر مالمسلم ( ( ( المسلم ) ) ) وتكون مخمسة في الخطا علي اهل الابل عشرة من كل صنف وفي العمد اثنا عشر ونصف وفي المغلظة خمسة عشر من كل صنف وعشرون خلفة وعلي اهل الذهب خمساءة ( ( ( خمسماءة ) ) ) دينار وعلي اهل الورق ستة الاف درهم وكذلك دية الكتابين ( ( ( الكتابيين ) ) ) علي النصف من دية رجال المسلمين لقوله صلي الله عليه وسلم عقل الكافر نصف عقل المءمن واهل الكتاب هم اليهود والنصاري ونساءهم في الدية علي النصف من ذلك اي من دية رجالهم قال خليل وانثي كل كنصفة فدية الحرة المسلمة خمسة من الابل وخمساءة ( ( ( وخمسماءة ) ) ) دينار من الذهب وستة الاف درهم من الورق وهكذا دية نساء اهل الكتاب علي النصف من دية رجالهم واما غير اهل الكتاب فاشار اليه بقوله والمجوسي ومثله المرتد ديته ثمانماءة درهم ونساءهم علي النصف من ذلك المذكور من دية الرجل من المجوس قال خليل والمجوس والمرتد ثلث خمس الدية الحر المسلم وثلث الخمس من الذهب ستة وستون دينارا وثلثا دينار ومن الابل ستة ابعرة وثلثا بعيرة ( ( ( بعير ) ) ) فتكون دية المرتدة ومثلها المجوسية من الورق اربعماءة درهم ومن الذهب ثلاث ( ( ( ثلاثة ) ) ) وثلاثون ( ( ( وثلاثين ) ) ) دينارا وثلث دينار ومن الابل ثلاثة ابعرة وثلث بعيرة ( ( ( بعير ) ) ) وقوله ودية جراحهم كذلك قصرة بعض الشراح علي نساء المجوس وذكر الضمير لتاولهم بالاشخاص ومعني كذلك انها علي النصف من دية جراج ( ( ( جراح ) ) ) الذكر المجوسي وهذا يقتضي عدم مساواة الانثي للذكر منهم فيما دون الثلث وهو مخالف لقولة فيما ياتي وتعاقل الرجل المراة الي ثلث دية الرجل فاذا بلغتها رجعت الي علقها ( ( ( عقلها ) ) ) فان ظاهرة كما نصف ( ( ( نص ) ) ) عليه الشراح ان كل امراة تساوي الرجل من اهل دينها في دية الجراج ( ( ( الجراح ) ) ) الي بلوغ الثلث فاذا  بلغت ثلث درية ( ( ( دية ) ) ) الرجل ترجع لديتها فتاخذ نصف ما ياخذه الرجل من غير استثناء مجوسية ولا كتابية فلعل مراد المصنف يقول ودية جراحهم كذلك اي في الجملة فلا ينافي انها تساويه فيما دون الثلث ويكون قوله كذلك اي علي النصف محمولا علي ما اذا لم يبلغ الواجب ثلث دية الرجل وحينءذ لا وجه لقصر كلامه علي نساء المجوس بل يكون كلامه عاما في جرح نساء كل فريق من المسلمين وغيرهم واخراج نساء المجوس من عموم تعاقل المراة الخ يحتاج الي لا نقل صريح قال خليل وساوت المراة الرجل لثلث دينة ( ( ( ديته ) ) ) فترجع لديتها قال شراحة اي ان المراه تساوي الرجل من اهل دينها الي ثلث ديته فترجع حينءذالي ديتها ولما فرغ من الكلام علي دية النفس شرع في الكلام علي دية الاطراف والمعاني فقال وتجب في اليدين الدية كاملة بسبب قطعهما خطا او عمدا وسقط القصاص بما يسقطه سواء قطعهما الجاني من الكوعين او المرفقين او المنكبين وكذلك تجب الدية في الرجلين قطعهما من الكعب والورك ومثل القطع ازالة المنفعة من اليدين او الرجلين ولو انزل بهما الرعشة او كذلك تجب الدية في العينين قلعهما او ازالة ( ( ( ازال ) ) ) نورهما والعضو الضعيف كالصحيح في القصاص والدية قال خليل والضعيف من عين ورجل ونحوهما خلقه كغيره وكذا المجني عليها ان لم ياخذ عقلا والا فبحسابه ويجب في كل واجده منهما اي من اليدين والرجلين نصفهما ( ( ( نصفها ) ) ) اي الدية فمن قطع يدا او رجلا وسقط القصاص فعليه نصف الدية في ماله او عاقلته في الخطا وكذا كل مزدوجين الا في عين الاعوار ( ( ( الاعور ) ) ) فان فيها الدية كما ياتي في كلام المصنف وكذلك يحب ( ( ( كذلك ) ) ) في الانف يقطع ماونه ( ( ( مارنه ) ) ) وهو ما لا ( ( ( لان ) ) ) منه ويسمي بالارنبة الدية وفي قطع بعضه بحسبابه ( ( ( بحسابه ) ) ) ويقاس من الماران ( ( ( المارن ) ) ) لا من اصل الانف وكذا يحب ( ( ( كذا ) ) ) في اذهاب السمع الدية واذا اذهبه من احدي الاذنين لزمه نصف الدية واذا لم يكن المجني عليه يسمع الا باذن واذهبه انسان فانما عليه نصف الدية لان الاذن الواحدة في السمع ليست كعين الاعور وكذلك يجب في ازالة العقل الدية سواء زال بجناية عمدا او خطا فلو فعل به فعلا فصار يجن في الشهر يوما مع ليلته فانه يجب له من الدية جزء من ثلاثين جزءا وان كان يجن النهار فقط او الليل فقط مرة في الشهر فانه يكون له جزء من ستين جزءا او محل العقل القلب علي المشهور لا الراس فاذا ضربه واضحه فذهب عقله فيلزمه دية كاملة للعقل ونصف عشر الدية وهو دية الموضحه علي المشهور وعلي الاخر لا يلزمه الا دية العقل لقول خليل الا المنفعة بمحلها وكذلك يجب في الصلب اي الظهر يكسر الدية ظاهر كلامه لزوم الدية في كسر الصلب ولو قدر علي الجلوس وهو كذلك ومن باب اولي لو فعل به فعلا اذهب قيامه وجلوسه واما لو ذهب مع ذلك قوة الجماع للزمه ديتان ويلزم في الانثيين يقطعهما خطا او يرضهما مطلقا الدية وان قطعهما مع الذكر لزمه ديتان واما لو قطع اورض واجدة ( ( ( رض ) ) ) من الانثيين للزمة نصف الدية واما لو قطع الانثيين عمدا لوجب القصاص ويلزم في قطع الحشفة وهي راس الذكر الدية وفي قطع بعضها بالحساب ويقاس من طرف الحشفة كما تقدم في المارن لا من اصل الذكر وظاهر كلام المصنف لزوم الدية في قطع الحشفة وحدها او مع الذكر ولو ذكر عنين وهو من لايستطيع الجماع لصغره او اعتراضه ولو لشيخ فان واما ذكر الخنثي المشكل فيلزم فيه نصف دية ونصف حكومه وفهم من لزوم الدية في قطع الحشقة ( ( ( الحشفة ) ) ) انه لو كان له عسيب بلا حشفة وقطعه شخص فلا يلزمه الا الحكومة كقعطع ( ( ( كقطع ) ) ) كف مجرد عن الاصابع وكذا يلزم في اللسان الناطق صاحبه الدية كاملة وكذا يلزم في اي بسبب عل ( ( ( فعل ) ) ) ما منع منه اي من اللسان الكلام الدية فان قطع منه شيءا ولم يمنع نطقه فانه يلزمه حكومة لان الدية للنطق ولذلك لو قطع لسان اخرس انما تلزمه حكومة تنبيه ظاهر قول المصنف وفي اللسان الدية انه لا يلزمه دية الذوق وهو كذالك ( ( ( كذلك ) ) ) بخلاف ما اذا ذهب منه الذوق مع بقاءه او ذهب صوته فانه يلزمه دية ذلك الذاهب واما لو قطع اللسان فذهب ذوقه وصوته فانما يلزمه دية واحدة لانه المحل الذاهب بالجناية انما تجب ديته لا دية ما فيه وكذا يلزم في ثدي ( ( ( ثديي ) ) ) المراة المراد الانثي الكبيرة الدية في قطعهما ولو كانت عجوزا فانية لان الثدي فيه جمال لصدرها واما لو قطع الحلمتين فانه لايلزمه الدية الا اذا بطل اللبن او افسده واما لو قطع حلمتي امراة صغيرة فتحب ( ( ( فتجب ) ) ) الدية ان يحقق ( ( ( تحقق ) ) ) انقطاع اللبن وان لم يتحقق ابطال اللبن فانه يستناني ( ( ( يستاني ) ) ) بهما فان لم يجر لها لبن وجبت الدية فان برء الثدي بعد اخذ ديته فان الدية  ترد وان ماتت زمن الاستيناء وجبت الدية لان الاصل فيما ذهب عدم العود ومفهوم ثديي المراة ان ثديي الرجل لا دية فيهما وانما فيهما حكومة وكذا تجب في عين الاعور الدية كاملة طمسها او ذهب نورها وفرق ابن القاسم بين عين الاعور وبين نحو اليد او الرجل بالنسبة ( ( ( بالسنة ) ) ) وبحث في كلامه ابن عبد السلام قاءلا السنة مع المخالف وان فيها وفي العين خمسين ولذا قال في التوضيح اراد بالسنة قول ابن شهاب هي السنة وبه قضي عمر وعثمان وغيرهما لا لانتقال البصر اليها لان خلاف مذهب اهل السنة لان البصر عرض والاعراض لاتنتقل والدليل علي ما ذكره المصنف من لوزم ( ( ( لزوم ) ) ) الدية في تلك الاعضاء والمنافع المذكورة ما في الموطا للامام ان في الكتاب الذي كتبه رسول الله صلي الله عليه وسلم لعمرو بن حزم ان في النفس ماءة من الابل وفي الانف اذا اوعب جدعه ماءة من الابل وفي المامومة ثلث الدية وفي الجاءفة مثلها وفي العين خمسون من الابل وفي اليد خمسون وفي الرجل خمسون وفي كل اصبع مما هناك عشر من الابل وفي السن خمس من الابل وفي الموضحه خمس من الابل وفي صحيح ابن حيان ( ( ( حبان ) ) ) وغيره في الكتاب الذي بعثه رسول الله صلي الله عليه وسلم الي اهل اليمن مع عمرو بن حزم ان في النفس ماءة من الابل وفي الانف اذا اوعب جدعه الدية وفي اللسان الدية وفي الشفتين الدية وفي البيضتين الدية وفي الذكر الدية وفي الصدر الدية وفي العينين الدية وفي الرجل الواحده نصف الدية وفي المامومه ثلث الدية وفي الجاءفه ثلث الدية وفي المنقله خمس عشرة من الابل وفي كل اصبع من اصابع اليد او الرجل عشر من الابل وفي السن خمس من الابل وفي الموضحه خمس من الابل وفي رواية غير الموطا وفي العقل الدية وفي النساءي وفي البيضتين الدية وفي الذكر الجية ( ( ( الدية ) ) ) وبعض الطرف ( ( ( الطرق ) ) ) وفي الشحفة ( ( ( الحشفة ) ) ) الدية
 تتمة لو دفعت الدية في نحو العقل او السمع او البصر او غيرهما من المنافع ثم رجع المعني الذي كان قد ذهب فان الدية ترد قال خليل ورد في عود البصر وقوة الجماع ومنفعة اللبن وفي الاذن ان ثبتت تاويلان ولما فرغ من الكلام علي دية الاعضاء والمنافع شرع في دية الجراحات فقال ويجب في الموضحة الخطا نصف عشر الدية وهو خمس من الابل واما عمدها ففيه القصاص وسياتي تفسيرها في كلامه ويجب في السن بقلعها او تصييرها مضطربة جدا او تسويدها او تحميرها او تصفيرها حيث كان تصفيرها يذهب جمالها كالسواد خمس من سواء كانت من مقدم الفم او مءخرة فلو ردت السن وثبتت فان كانت سن كبير وهو من بلغ حد الاثغار فانه لا يسقط عقلها كالجراحات الاربعة المقرر فيها شء من الشارع من موضحه وجاءفة ومنقلة وتبرا علي غير شين فلا يسقط عقلها واما سن الصغير فانه يوقف عقلها حتي يحصل الياس كالقود ممن قلعها عمدا ووجوب الخمس في السن من السنة ويجب في كل اصبع عشر من الابل وفي الاصبع الزاءدة ما في الاصلية حيث كانت مساوية للاصل في القوة سواء قطعها وحدها او مع غيرها بخلاف الضعيفة ففيها حكومة ان قطعت وحدها واما لو قطعت مع الكف فلا شء فيها والظاهر ان اليد الزاءدة فيها هذا التفصيل ولا فرق في ذلك بين اصابع اليدين او الرجلين ولا بين اصابع ذكر وانثي حتي تبلغ الثلث لما سياتي من انها تعاقل الرجل الي ثلث الدية وهذا في اصابع المسلم واما غيره ففي كل اصبع من اصابعه عشر ديته ويجب في الانملة من غير الابهام من انامل المسلم وهي العقدة ثلاث وثلث من الابل ويجب في كل انملة من الابهامين للرجل واليد خمس من الابل وهي نصف دية الاصبع ومعلوم ان هذا كله في حالة الخطا واما اذهاب تلك المذكورات بجناية عمدا فالواجب فيها القصاص ويجب في المنقلة بضم الميم والنون المفتوحة والقاف المشددة مع فتحها او كسرها ويقال لها الهاشمة ايضا عشر الدية ونصف عشر ها وهو خمس ( ( ( خمسة ) ) ) عشر بعيرا من الذهب ماءة وخمسون ومن الورق الف وثمانماءة درهم وعمدها وخطءها سواء لانها من المتالف حيث كانت بالراس او باللحي الاعلي ويقتص من عمدها ان كانت بالجسد ولما قدم الموضحة والمنقله شرع في تفسيرهما فقال والموضحة بضم الميم وكسر الضاد المعجمة هي ما اوضح اي اظهر العظم بان ازال ما عليه من الجلد واللحم ويختص بالراس والجبهة والخدين ولا تنضبط بحد بل يجب عقلها المذكور في الخطا ويقتص من عمدها ولو كانت مساحتها قد ر راس ابرة وحقيقة المنقلة وهي الهاشمة ما طار فراشها بفتح الفاء وكسرها اي زال ما تحتها من العظم ولم تصل الي الدماغ قال القرافي المنقلة هي التي ينقل منها الطيب ( ( ( الطبيب ) ) ) العظام الصغار لتلتءم الجراح فتلك العظام هي التي يقال  لها الفراش قال الاصمعي الفراش العظام الرقاق يركب بعضها علي بعض في اعلي الخياشيم كشقشر ( ( ( كقشر ) ) ) البصر ( ( ( البصل ) ) ) تطير عن العظم اذا ضرب فمن كلام المصنف بيانية فان المعني الفراش الذي هو العظم واشار الي محترز قوله ولم يصل الي الدماغ بقوله واما ما وصل اليه اي الي الدماغ ولم يخرق خريطته اي جلدته فهي المامومة ففيها ثلث الدية ثلاثة وثلاثون بعيرا وثلث بعير ومن الذهب ثلاثماءة وثلاثة وثلاثون دينار ( ( ( دينارا ) ) ) وثلث دينار ومن الفضة اربعة الاف درهم وكذلك الجاءفة فيها ثلث الدية وهي ما وصلت الي الجوف من الظهر او البطن ولو قدر مدخل الابرة واما الضربة التي تخرق البطن ولم تصل الي الجوف ففيها الحكومة فان نفدت ( ( ( نفذت ) ) ) الي الجانب الاخر تعددت قال خليل وتعدد الواجب بجاءفة نفذت كتعدد الموضحه والمنقلة الامة ( ( ( والامة ) ) ) ان لم تتصل والا فلا وان بغور في ضربات ومثل المامومة والجاءفة الدامغة وهي التي تخرق خريطة الدماغ تنبيه كل ما فيه شء مقرر عن الشارع يجب دفع واجبه ولو برء علي غير شين بخلاف ما لم يقرر فيه شيءا فلا شء فيه الا اذا برء علي شين واليه الاشارة بقوله وليس فيما دون الموضحة من الجراحات الست اذا كانت خطا الا الاجتهاد وهو الحكومة بان يقوم المجني عليه بعد برءة خوف ان يترامي الي النفس او الي ما تحمله العاقلة عبدا سالما من ذلك الجرح علي صفته التي هو عليها يوم الجناية من حسن او قبح بعشرة مثلا ثم يقوم ثانيا معيبا بتسعة مثلا فالتفاوت بين القيمتين بالعشر فيجب علي الجاني بتلك النسبة من الدية وهو عشر الدية في هذا المثال فالحكومة المراد به المحكوم به قال خليل وفي الجراح حكومة بنسبة نقصان الجناية اذ برء من قيمته عبدا فرضا من الدية وفي عمدها القصاص قال خليل واقتص من موضحه او ضحت عظم الراس والجبهة والخدين وان كابرة وسابقها من دامية وحارصة شقت الجلد وسمحاق كشطته وباطحة شقت اللحم ومتلاحمة غاصت فيه بتعدد وملطاة قربت للعظم فالثلاث الاول متعلقة بالجلد والثلاث الذي بعدها باللحم وكذلك ليس في بقية جراح الجسد الخطا الا الاجتهاد لان الشارع لم يسم لها شيءا لان الذي قرر الشارع فيه شيءا يجب دفعه من غير حكومة ولما كان يتوهم لزوم واجب الجناية سريعا وكانت الواقعة فيما دون النفس مخالفة قال ولا يعقل بلفظ المبني للمفغول ( ( ( للمفعول ) ) ) وناءب الفاعل جرح ومعني لا يعقل لايءخذ له دية ولا حكومة الا بعد البرء خوفا من موت المجروح فيءول الامر الي النفس وليظهر هل يبرا علي شين ام لا لان البرء علي غير شين فيه تفصيل اشار اليه ققوله وما برء من الجراحات علي غير شين اي قبح مما دون الموضحة اي من سوء ( ( ( سوي ) ) ) الموضحة وغيرها ما لم يقدر فيه الشارع شيءا ويدخل فيه سابق الموضحة من الجراحات الست لان الشارع لم يجعل لها شيءا معلوما فلا شء فيه واما ما قرر الشارع فيه شيءا فالواجب المقرر برءت علي شين ام لا قال خليل الا الجاءفة والامة فثلث والموضحة فنصف عشر والمنقلة والهاشمة فعشر ونصفة وان بشين فيهم ( ( ( فيهن ) ) ) اي فلا يلزم في الشين حكومة الا الموضحة فانها اذا برءت علي شين وهي في الوجه او الراس يجب دفع ديتها وحكومة علي المشهور وقال ( ( ( وقاله ) ) ) في المدونة ولما فرغ من الكلام علي الجراحات الواقعة خطا الدال عليه وجوب الاجتهاد والعقل فانهما يكونان في الخطا غالبا شرع في حكم العمد بقوله والواجب في الجراح الواقعة في الراس او غيره من باقي الجسد القصاص في العمد بالمساحة ان اتحد المحل فقياس الجرح طولا وعرضا وعمقا فقد تكون الجراحة نصف عضوا ( ( ( عضو ) ) ) المجني عليه وهي جل عضوا ( ( ( عضو ) ) ) الجاني او كله وكذلك لو عظم عضوا ( ( ( عضو ) ) ) المجني عليه بحيث يزيد شعلي عضوا ( ( ( عضو ) ) ) الجاني فانه لايكمل من غيره بل يسقط قال خليل واقتص من موضحة الي ان قال وجراح الجسد طولا وان منقلة بالمساحة ان الحد ( ( ( اتحد ) ) ) المحل كطبيب زاد عمدا والا فالعقل وان لم يتحد محل الجناية او لم يتعمد الطبيب فالواجب علي الجاني العقل ومفهوم الجراح من اللطمة والضربة بالة لا تجرح ولم ينشا عنها جرح لا قصاص فيها وانما فيها التاديب بما يراه الامام ومثل ذلك نتف اللحية او الشارب او شعر الحاجب فان عمد هذه وخطاها سواء في عدم القصاص وانما فيها الحكومة اذا لم تعد لهيءتها والا فلا شء فيها سوء الادب في العمد ولما كان القصاص في عمد جراحات الجسد مقيدا بعدم خوف هلاك النفس قال الا في الجراحات المتالف اي يغلب معها الموت سريعا فلا قصاص في عمدها بل الواجب العقل في عمدها كخطءها مع الادب في العمد مثل المامومة وتقدم انا ( ( ( انها ) ) ) ما افضت للدماغ والجاءفة وهي ما افضت للجوف ولو قدر مدخل ابرة والمنقلة وهي  الهاشمة كما قدمنا ومثل كسر الفخد ( ( ( الفخذ ) ) ) ورض الانثيين بخلاف قطعهما فان في عنده القصاصفان في عمدة القصاص لان الامام قال اخاف في رض الانثيين ان يتلف ومثل كسر الصلب اي الظهر ونحوه من كل ما يعظم فيه الخطر اي الاشراف علي الهلاك ككسر عظم الصدر او العنق ففي عمد كل ذلك الدية وهي كل ما قدره الشارع مع الادب والمراد الدية في كل جناية سواء كانت كاملة كدية رض الانثيين او ناقصة كدية الامة والجاءفة فالمراد بالدية المال المءدي حيث كان قدر الثلث لان العاقلة لا تحمل ما نقص عن الثلث ولما كانت عاقلة الجاني اي عصبته لا تشاركه في حمل الدية الا بشروط اشار اليه ( ( ( اليها ) ) ) بقوله ولا تحمل العاقلة شيءا من الدية مع الجاني في قتل عمد سقط فيه القصاص بعفوا ( ( ( بعفو ) ) ) او بغيره من المسقطات وانما تكون حالة في ما الجاني ولا تحمل اعترافا به اي لا تحمل ما ثبت باقرار الجاني علي نفسه لان المكلف انما يءخذ باقراره اذا كان المقربة يطلب من المقر وما هنا ليس كذلك وظاهر كلام المصنف كخليل ان العاقلة لا تحمل الاعتراف ولو كان الاتعتراف ( ( ( الاعتراف ) ) ) من عدل ثقة لا يتهم في اغناء ورثة المقتول وهو المعتمد ويغربمها ( ( ( ويغرمها ) ) ) الجاني من ماله ولو اقسم اوليساء ( ( ( اولياء ) ) ) المقتول كما اصلح سحنون المدونة عليه خلافا لمن فصل ويظهر لي انا ( ( ( انها ) ) ) تنجم علي الجاني كما تنجم علي العاقلة عند الثبوت بغير الاعتراف وحرر الحكم ثم شرع في بيان اقل ما تحمله العاقلة بقوله وتحمل العاقلة من جراح الخطا ما كان واجبه قدر الثلث فاكثر من دية الجاني او المجني عليه هذا هو المشهور واقتصر عليه خليل حيث قال ان بلغ ثلث الدية المحسني ( ( ( المجني ) ) ) عليه او الجاني وفاعل بلغ الواجب لمن اعتبر دية المجني عليه وتظهر ثمرة الخلاف فيما اذا كان الجاني امراة علي رجل فقطعت له اصبعين فعقلهما عشرون من الابل وهي اكثر من ثلث دية المراة واقل من ثلث دية الرجل فعلي المشهور تحمله العاقلة وعلي مقابله لا تحمله وما كان من الجراح دون الثلث اي فيه اقل من ثلث دية كل من الجاني والمجني عليه ففي مال الجاني قال العلامة خليل ونجمت دية الحر الخطا بلا اعتراف علي العاقلة والجاني ان بلغ اي الواجب ثلث دية المجني عليه او الجاني وما لم يبلغ فحال عليه كعند ( ( ( كعمد ) ) ) ودية غلظت وساقط لعدمه وما ذكره من عدم حملها ما نقص عن الثلث قال به الفقهاء السبعة وقال الشافعي تحمل القليل كالكثير ودليلنا حدييث ( ( ( حديث ) ) ) قريش والانصار وياتي ان شاء الله تعالي ولما جري خلاف في حملها دية ما لا قصاص له فيه لكونه من المتالف اشار اليه بقوله وماما المامومة والجاءفة ومثلهما بالدامغة ( ( ( الدامغة ) ) ) وكسر عظم الصدر والعنق والفخد ( ( ( والفخذ ) ) ) اذا كانت الجانية ( ( ( الجناية ) ) ) علي جميع ما ذكر عمدا فقال مالك رضي الله عنه ذلك اي الواجب فيها موزع علي عاقلته معه وهذا هو المعتمد ولذلك اقتصر عليه خليل حيث قال علي طريق الاستثناء من العمد الذي لا تحمل ( ( ( تحمله ) ) ) العاقلة الا ما لا يقتص منه من الجراح لاتلافه فعليها ودخل فيه كل ما لا قصاص فيه لعظم خطره حيث كان الواجب فيه قدر ثلث الدية سواء كان فيه شء معلوم عن الشارع ام لا لتدخل الحكومة اذا بلغت الثلث فان العاقلة تحملها وقال اي الامام مالك ايضا قولا مقابلا المعتمد المتقدم ان واجب ذلك المذكور من الماموموة ( ( ( المامومة ) ) ) وما معها في ماله اي الجاني وحده الا ان يكون عديما لايستطيع دفعها فتحمله العاقلة ثم علل حمل العاقلة علي القولين بقوله لانهما لا يقاد من عندهما ( ( ( عمدهما ) ) ) وللامام قول ثالث ارجحها اولها لانه الذي رجع اليه الامام واقتصر عليه خليل وهي كوهنها ( ( ( كونها ) ) ) علي العاقلة مطلقا ثانيهما في مال الجاني الملء ( ( ( الملء ) ) ) ثالثها علي الجاني مطلقا ولما خص الكلام السابق بالمامومة والجاءفة وكان غيرهما مما هو من المتالف كذلك قال وكذلك ما بلغ واجبه ثلث الدية كالدامغة او غيرها مما لايقاد منه لانه متلف ولما كان من شرط حمل العاقلة ان لا يكون الجاني جني علي نفسه قال ولا تعقل العاقلة دية من قتل نفسه عمدا او خطا بل يكون دمه هدرا في العمد اتفاقا وفي الخطا علي المشهور فتلخص ان العاقلة لاتحمل عن الجاني الا بشروط خمسة حرية المجني عليه وكونه ( ( ( وكون ) ) ) الجناية خطا اوففي حكم الخطا وثبتوت ( ( ( وثبوت ) ) ) الجناية ببينة او قسامة لا باعتراف وبلوغ الواجب ثلث دية الجاني او المجحني ( ( ( المجني ) ) ) عليه وان لاتكون الجناية من الجاني علي نفسه والدليل علي ذلك كله قوله صلي الله عليه وسلم لاتحمل العاقلة عمدا ولا عبدا ولا اعتبرافا ( ( ( اعترافا ) ) ) ولا صلحا ولا مادون الموضحة وفي بعض العبارات ولا مادون الثلث وهي الصواب لموافقته لما تقدم ولما روي عنه عليه الصلاة والسلام تحمل العاقلة  الثلث فصاعدا وعنه صلي الله عليه وسلم انه عاقل بين قريش والانصار فجعل ثلث الدية علي العاقلة ورواه ( ( ( رواه ) ) ) مالك ولما كان يتوهم من قوله فيما سيق ( ( ( سبق ) ) ) وكل انثي علي النصف من دية الرجل شموله لدية الاطراف مطلقا والواقع ليس كذلك قال وتعاقل المراة اي تساوي الرجل من اهل دينها فتاخذ في اطرافها مثلما ياخذ الرجل وتستمر مساوية له الي ان تبلغ ثلث دية الرجل والغاية خارجة كما هو الاصل في المغيا بالي فاذا بلغتها اي درية الرجل اي ثلثها رجعت الي عقلها فاذا قطع لها ثلاثة اصابع فيها ( ( ( فلها ) ) ) ثلاثون من الابل كالرجل فاذا قطع لها بعد ذلك انمله رجعت الي عقلها وكذا اذا قطع لها اربعة اصابع او ثلاثة وانملة فانها تاخذ نصف ما ياخذه الرجل فلها في المنقلة والهاشمة وفيما نقص من الاصابع عن الثلاثة وانملة كالرجل واما في قطع ثلاثة وانملة او الجاءفة او الدمغة ( ( ( الدامغة ) ) ) او الامة نصف ما للرجل فيكون لها فيما ذكر ستة عشر بعيرا وثلثا بعير وقد قال ربيعة لابن المسيب كم في ثلاثة اصابع من المراة فقال ثلاثون فقلت كم في اربعة فقال عشرون فقتل ( ( ( فقلت ) ) ) حين عظم جرمها واشتدت بليتها نقص عقلها فقال اعراقي انت قلت بل عالم متثبت او جاهل متعلم فقال هي السنة يا ابن اخي قال ابن شاس وهو اجماع اهل المدينة والفقهاء السبعة ولما كان من المجمع عليه لنص الكتاب والسنة النفس بالنفس وهو يوهم عدم قتل الجماعة بالواحده ( ( ( بالواحد ) ) ) قال والنفر وهم الجماعة من الناس يقتلون رجلا او امراة عمدا عدوانا من غير تمالء علي قتله ولم تتميز ضرباتهم ومات مكانه او انفذت مقاتله ولو تاخر موته فانهم يقتلون به قال خليل ويقتل الجمع بواحد حيث ثبت القتل ببينة او اعتراف من القاتلين لا ان احتاج الي قسامة فلا يقتل الا واحد تعين لها وقيدنا بعدم التمالء لقول خليل والمتمالءون وان بسوط سوط بل وان لم يباشر القتل الا بعضهم حيث كان غيره بحيث لو استعان به القاتل لاعانه وقيدنا بعدم تميز الضربات للاحتراز عما لو تميزت فانه يقتص من كل كفعلة وقيدنا بموته مكانه او انفاذ مقتله للاحتراز عما لو ينفذ مقتله بل دفع حيا وعاش واكل وشرب ثم مات فانهم لايقتلون به جميعا بل لايقتل به الا واجد تعينه الاوياء ( ( ( الاولياء ) ) ) ويقسمون عليه وقيدنا بالعمد العدوان لان المقتول عمدا غير عدوان لا شء فيه كالبغاة والمقتول خطا يغرم ديته اتحد او تعدد ويفهم من قول المصنف يقتلون به انهم مكلفون مكافءون للمقتول او ادني منه لا ان كانوا اعلي منه بحرية او اسلام لان الاعلي لا يقتل بالادني بخلاف العكس الا في قتل الغيلة فيقتل الاعلي بالادني كما تقدم ولا ان كانوا غير مكلفين كصبية او مجانين فلا يقتلون بما قتلوه والدليل علي قتل الجماعة بالواحد ما في الموطا ان عمر بن الخطاب رضي الله عنه قتل نفرا خمسة او سبعة ولما كان شرط القاص ( ( ( القصاص ) ) ) تكليف الجاني وكان زوال العقل بالسكر الحرام لايزيل التكليف بالنسبة للجنايات والحدود والطلاق والعتق قال والسكران سكر ( ( ( سكرا ) ) ) حراما لشربه المسكر غير ظان انه غيره ان قتل معصوما مكافءا له او اعلي منه قتل حيث كان بالغا ولا يعذر بغيبوبة عقله لانه ادخله علي نفسه كما لا يعذر بذلك اذا طلق او قذف او اعتق او زنا ( ( ( زني ) ) ) ولو كان طافحا بخلاف لو اقر او باع او اشتري فلا يلزمه واما لو سكر سكر غير حرام كشربه المسكر يظنه لبنا او عسرلا ( ( ( عسلا ) ) ) او غالطا او لغصه فلا يقتل لانه في تلك الحالة كالمجحنون ( ( ( كالمجنون ) ) ) واما ان قتل مجنون حال جنونه رجلا المراد شخصا مكافءا له او ادني فالدية علي عاقلته لان عمده كخطءه ويلحق به كل من زال عقله بغير تعمد استعمال المزيل كما قدمناه والفرق بين من ذكر وبين السكران سكرا حراما رفع القلم عن هذا الزوال لمحل الخطاب وهو العقل من غير تسببه بخلاف ذلك وقيدنا بحال جنونه للاحتراز عما لو قتل متقطع الجنون في حال افاقته فانه يقتص منه كالصحيح لكن بعد افاقته فان ايس من افاقته فالدية في ماله وقال المغيرة يسلم الي اولياء المقتول فيقتلونه ان شاءوا ( ( ( شاءوا ) ) ) فان افاق بعد اخذ الدية اقتص منه وترد الدية وبقيت مسالة وهي ما اذا شك هل قتل في حال صحوه او في جنونه فجزم بعض القرويين بسقوط القصاص واما الدية فلازمة من قبل لعاقلته وقيل له ولا سبيل لاسقاطها وعمد الصبي المراد كل من لم يبلغ ولو انثي كالخطا فلا يقتص لقوله صلي الله عليه وسلم رفع القلم عن ثلاثة عن الناءم حتي يستيقظ وعن الغلام حتي يحتلم وعن المجنون حتي يفيق ولعل ( ( ( لعل ) ) ) المراد باحتلامه رءية علامة البلوغ وذلك اي واجب جنايته كاءن علي  عاقلته بشرط اشار اليه بقوله ان كان اي واجب جناية يبلغ ثلث الدية فاكثر كما تقدم في كل ما تحمله العاقلة والا بان لم يبلغ واجب جنايته ثلث دية الجاني ولا المجني عليه ففي ماله يءخذ منه علي الحلول ويتبع به ان اعدم واختلف اذا اشترك بالغ عاقل مع صبي او مجنون في قتل شخص علي ثلاثة اقوال اشهرها ان شريك الصبي يقتل بخلاف شريك المجنون قال خليل وعلي شريك الصبي القصاص ان تمالا علي قتله واما ان لم يكن تمالء فان كان الكبير متعمدا وحده او الصبي كذلك فنصف دية مقتولهما في ما الكبير والنصف الاخر علي عاقله الصبي وان اخطا الكبير فنصف ديته علي عاقلة الكبير ونصفها الاخر علي عاقلة الصغير واما شريك المخطء والمجنون فلا قصاص عليه ولا تعمد للشك فيمن مات بفعله وعلي عاقلة المخطء او المجنون نصف ديته وعلي شريكه المتعمد نصف ديته ولا ينظر لقوله ( ( ( لقول ) ) ) الاولياء انما قتله العاقل المشارك للمخطء او المجنون لو اقسموا ولما كان شرط القصاص المساواة في الحرية والاسلام او شرف المجني عليه علي الجاني فقط وتقتل المراة بالرجل والرجل بها حيث كانا حرين او رقيقين او كان القاتل رقيقا والمقتول حرا والدليل علي قوله تعالي @QB@ وكتبنا عليهم فيها ان النفس بالنفس @QE@ الاية فانها ناسخة لاية @QB@ الحر بالحر والعبد بالعبد والانثي بالانثي @QE@ وقوله عليه الصلاة والسلام يقتل الرجل بالمراة ويقتص لبعضهم اي من ذكر من الرجال والنساء من بعض في الجراح فيقتص للمراة من الرجل وعكسه لقوله تعالي @QB@ والجروح قصاص @QE@ خلافا لابي حنيفة في قوله لاتقطع يد الرجل في يد المراة ولا عكسه ولما كان الاعلي لا يقتل بالادني بخلاف العسك ( ( ( العكس ) ) ) قال ولا يقتل حر مسلم بعبد مسلم لان الحر المسلم اشرف من العبد المسلم سواء كان عبده او عبد غيره سواء كان قنا او فيه شاءبة حرية فقد روي عن علي بن ابي طالب رضي الله عنه انه قال من السنة ان لايقتل مسلم بذمي عهد ولا حر بعبد ونقل الباجي اجماع الصحابة علي ذلك وقيدنا الحر بالمسلم لنتحرز عن الحر غير المسلم فانه يقتل بالعبد المسلم قال ابن الحاجب ويقتل الحر الذمي بالعبد المسلم وهذا كله ما لم يكن قتله غيله والا قتل القاتل ولا يشترط مكافاة والواجب علي الحر قاتل الرقيق قيمته في غير الغيلة وفي جرحه ما نقص قيمته كالجناية علي الدابة المملوكة لغير الجاني لان العبد ما قال خليل وفي الرق ( ( ( الرقيق ) ) ) قيمته وان زادت اي علي دية الحر وتجب قيمته علي انه قن ولا مبعضا او ام ولد كان قتله خطا او عمدا الا ان يكون الجاني مكافءا له فيقتل به ويقتل به اي بالحر المسلم العبد لانه اذا قتل العبد بالعبد فاولي الحر بالمسم ( ( ( المسلم ) ) ) ومعني يقتل به انه يقضي بقتله ان طلبه الولي فلا ينافي للولي الخيار بين قتله واستحياءه لكن استحياءه يثبت لسيده الخيار بين اسلامه او دفع دية الحر المقتول كما انه يخير اذا قتل العبد حرا مسلما خطا بين تسليمه لولي المقتول او فداءه بدية المقتول وماما لو وقعت من رقيق علي رقيق فان كانت عمدا فالقصاص ولو كان المقتول قنا مخصا ( ( ( محضا ) ) ) والقاتل فيه شاءبة حرية حكم ما فيه شاءبة علي الرق حتي يخرد ( ( ( يخرج ) ) ) حرا وفي الخطا جنايته في رقبته فيخير سيده بين فداءه واسلامه ولا يقتل مسلم ولو رقيقا بكافر ولو حرا لان الاعلي لايقتل بادني ( ( ( يقتل ) ) ) بخلاف العكس قال خليل وقتل الادني بالاعلي كحر كتابي بعبد مسلم لان الحر الكتابي ادني من العبد المسلم اذا حرمه الاسلام لا يعادلها حرية الكتابي وهذا كله في غير قتل اغيلة ( ( ( الغيلة ) ) ) فقد قتل صلي الله عليه وسلم يوم خيبر مسلما بكافر قتل ( ( ( قتله ) ) ) الغيلة ( ( ( غيلة ) ) ) واشار الي مفهوم ولا يقتل مسلم بكافر بقوله ويقتل به اي المسلم ولو رقيقا الكافر ولو حرا لان حرية الكافر لا تعادل شرف الاسلام تنبيه لم يتكلم المصنف علي حكم ما لو كان القاتل مكافءا للمقتول حين القتل ثم زالت المساواه قبل القصاص واشار اليه خليل بقوله ولايسقط القتل عند المساواه بزوالها بعتق او اسلام فاذا قتل كافر كافرا ثم اسلم الكافر القاتل او قتل عبد عبدا ثم عتق القاتل فانه يقتل القاتل في الصورتين لان الشرط المساواه عند القتل وقد وجدت ولما قدم ان الادني يقتل بالاعلي بخلاف العكس في الغيلة وكان حكم الجراح ليس كالدماء قال ولا قصاص مشروع بين حر وعبد في جرح حصل من احدهما في الاخر سواء كان الجارح الحر او العبد وحينءذ فان كان العبد هو الذي جرح الحر فالعبد فيما جني سواء جني عمدا او خطا وان كان الجارح الحر فان كانت علي عضول فيه عقل مسمي بالنسبة للحر  فينسب ذلك للعقل لقيمته ففي قطع يده نصف قيمته وفي موضحته نصف عشر قيمته وفي جاءفته او امنه ( ( ( امته ) ) ) ثلث قيمته وفي منقلته وهاشمته عشر قيمته ونصف عشرها وان لم يكن فيها شء مسمي فيلزم فيها ما نقص من قيمته وفهم من قوله ولا قصاص بين حر وعبد انه يقتص للحر من الحر ومن الرقيق للرقيق ولو بشاءبة وقال خليل عاطفا علي ما يقتص لبعضهم من بعض كذوي الروق ويقتص لذكر كل من انثاه كما يقتص للضعيف من الصحيح وعكسه قال وذكر صحيح ( ( ( وصحيح ) ) ) وضدهما اي يقتص لك ( ( ( لكل ) ) ) من الاخر ولا قصاص ايضا في جرح وقع بين مسلم وكافر وحينءذ فان كان الجارح المسلم فعليه دية عضو الكافر وان وقعت في شء لا عقل له ففيه حكومة وان كان الجارح الكافر عليه ( ( ( فعليه ) ) ) الدية او الحكومة قال خليل والجرح كالنفس في الفعل والفاعل والمفعول الا ناقضا ( ( ( ناقصا ) ) ) جرح كاملا فلا قصاص وعلي كافر جرح مسلما ولا علي عبد جرح حرا مسلما وان كان يقتص منهما بقتل النفس هذا هو مشهور المذهب وبه قال الفقهاء السبعة وعليه عمل اهل المدينة وتلزم الدية تنبيه فهم من قول المصنف ولا قصاص بين مسلم وكافر يقتص لبعضهم من بعض قال خليل والكفار بعضهم من بعض كتابي ومجوسي ومءمن لان الكفر كله ملة واحده في هذا الباب فيقتص لليهودي او النصراني من المجوسي وعابد النار والمءمن الكافر الداخل بلد الاسلام بامان ولما كان ما اتلفته الدابة ذات القاءد او الراكب او الساءق متعلقا به ناسب ذكرها عقب جناية الشخص بقوله والساءق للدابة المفهومة من المقام وهو الحارث لها علي السير متعلقا به ناسب ذكرها عقب جناية الشخص بقوله والساءق للدابة المفهومة من المقام وهو الحاث لها علي السير والقاءد وهو الذي يتقدم امامها وتسير بسيرة والراكب المستولي علي ظهرها ضامنون لما وطءت اي اصابته واتلفته برجليها ( ( ( برجلها ) ) ) الدابة وكيفية الضمان ان كل واحد من الثلاثة مخاطب به عند انفراده واما عند اجتماع الثلاثة فالضمان علي القاءد والساءق ولا شء علي الراكب لانه بمنزلة المتاع الكاءن علي ظهرا ( ( ( ظهرها ) ) ) الا ان يكون اتلافها بسبب الراكب فيختص به الضمان الا ان يحصل منه ( ( ( منهما ) ) ) مشاركة في التسبب ومثل ما وطءته ما لو طارت حصاة من تحت حافرها فكسرت انية مثلا فضمانها من قاءدها او ساءقها او راكبها علي نحو ما مر خلافا لابن زرب في ذلك ومفهوم وطءت الجابة ( ( ( الدابة ) ) ) ان ما اتلفه ولد الدابة المسوقة او المركوبه او المقاجدة ( ( ( المقادة ) ) ) لا ضمان علي واحد من هءلاء الثلاثة فيه وهو كذلك ولم يذكر المصنف ما لو ركبها سخصا ( ( ( شخصان ) ) ) وطءت ( ( ( ووطءت ) ) ) شيءا فاتلفته والحكم فيه انهما ان كانا علي ظهرا ( ( ( ظهرها ) ) ) فالضمان علي المقدم الا ان يكون المءخر حركها فيضمنان معا الا ان يكون من المخءر ( ( ( المءخر ) ) ) مثل ان يضربها المءخر فترمح بضربها ( ( ( بضربه ) ) ) بحيث لايقدر المقد ( ( ( يقدر ) ) ) علي منعها وتقتل رجلا فديته علي عاقلة المخر ( ( ( المءخر ) ) ) خاصة واما لو كان كل واحد من الراكبين في جنبها لا شتركا في الضمان واما لو ركبها ثلاثة واحد علي ظهرها واثنان في جنبيها فيظهر ان الضمان علي الثلاث الا ان يكون سبب الاتلاف من واحد فيختص به وحرره هذا ما يتعلق بما وطءته برجلها واما ما كدمته بفمها او اتلفته بذنبها او نفخها فلا شء فيه علي واحد من الساءق والقاءد والراكب الا ان يتسبب واحد منهم فالضمان عليه ومثل تسببه لو راها اصابت شءا ( ( ( شيءا ) ) ) بفهمها ( ( ( بفمها ) ) ) وتمكن من تخليصه قبل اتلافه ولم يصرفها لان حفظ ما الغير واجب وكذا يضمن صاحبها جميع ما اتلفته بفيها اذا كان شانها الاتلاف به ولو عجز عن تخليصه الان لانه يجب عليه وضع شء علي فيها حيث اشتهرت بذلك لا ان عجز عن تخليصه او لم تشتهر بذلك فلا ضمان عليه كما لو اتلفت شيءا وضع شء علي فيها حيث اشتهرت بذلك لا ان عجز عن تخليصه او لم تشتهر بذلك فلا ضمان عليه كما لو اتلفت شيءا وهي في محل الرعي اي في محل وقوفها المعتاد لها او في السوق او في باب المسجد كما ياتي في كلام المصنف بخلاف ايقافها بمحل غير ذلك فيضمن ما اتلفته بجلها ( ( ( برجلها ) ) ) وبقي ما لو ظهرت ( ( ( ظهر ) ) ) تلف شء من الدابة ولم يعلم هل هو بما يوجب الضمان ام لا ويظهر عدم الضمان لان الاصل عدم التسبب وبقي مساءل اخر منها من قاد قطار ( ( ( قطارا ) ) ) فهو ضامن لما وطء البعير سواء كان في اوله او اخره واما لو كان مع القاءد ساءق فانهما يكونان شريكين فيما وطء الاخر وحده والمراد به الذي حصل فيه السوق ولا يضمن الساءق ما اصاب الذي يلي الاخر لان السوق ينفع في الاخر وما قبله ومنها ما في الكتاب عن مالك في حمال حمل عدلين علي بعير لغيره باذنه وهو اجير فسار به وسط السوق فانقطع الحبل وسقط عدل علي شخص فتله ( ( ( فقتله ) ) ) ضمن الجمال دون صاحب البعير ومنها من سقط من فوق دابة علي شخص فقتله فالسقط ( ( ( فالساقط ) ) ) ضامن وذلك علي عاقلته ومنها ما قاله ابن المواز من انفلتت دابته فنادي رجلا يحبسها له فلما ذهب ليحبسها له ضربته فمات فلا شء عليه وهو من فعل العجماء الا ان يكون المامور عبدا او صغيرا فدية الحر علي عاقلته وفيمة ( ( ( وقيمة ) ) ) العبد في ماله ومنها من دفع لصبي دابته او سلاحه ليمسكه فعطب بذلك فديته علي عاقلة الدافع ومثل ذلك الدابة يسقيها له وان كان عبدا ولو كبيرا فان قيمته تكون علي  الدافع من ماله واما لو امر حرا كبيرا بمسكها فقتله ( ( ( فقتلته ) ) ) فلا ضمان علي الامر كما لو اتلفت بعد انفلاتها من مربطها الحافظ من الهروب شخصا غير مامور بمسكها فلا شء فيه بخلاف لو افلتت من يد انسان فاتلفت شيءا فانه يضمن ضمان فعل الخطا ومن المساءل لو حمل صبيا علي دابته بمسكها ( ( ( يمسكها ) ) ) له او بسقيها ( ( ( يسقيها ) ) ) فوطءت رجلا فقتلته فالدية علي عاقله الصغير ولا رجوع لعاقلته علي عاقلة الرجل ولعل المراج ( ( ( المراد ) ) ) بالصغير المراهق وهذا اذا كان المحمول حرا واما لو كان عبدا صغيرا وحمله دابة فوطءت رجلا فقتله ( ( ( فقتلته ) ) ) فان سيده يخير بين ان يفديه بدية الحر او يسلمه لولي المقتول ولا يرجع سيد العبد علي الحامل له بشء ومنها لو نخس ادنبي ( ( ( اجنبي ) ) ) دابته ( ( ( دابة ) ) ) لها ساءق او قاءد او راكب ونشا عن نخسها شء فعلي الناخس دون من معها من ساءق او قاءد او راكب حتي لو قتلت شخصا بنخسها لو ( ( ( لوجبت ) ) ) جبت ( ( ( ديته ) ) ) دية علي عاقله ذلك الناخس ومن هذا المعني ان الهارب الخاءف اذا وطء او صدم شء ( ( ( شيءا ) ) ) فذلك علي الذي فعل به ولما كان ضمان ما وطءته الدابة واتلفته من الساءق او القاءد لتسببه ذكر هنا حكم ما اذا حصل من غير تسببهم بقوله وما كان منها اي والاتلاف الحاصل من الدابة من غير فعلهم اي الراكب والساءق والقاءد بان اتلفته بذنبها او كدمته بفمها ولم تكم ( ( ( تكن ) ) ) معروفة بذلك ولم يتمكن ساءقها او قاءدها او راكبها من متها ( ( ( منعها ) ) ) او اتلفته وهي وافقه ( ( ( واقفة ) ) ) في محلها المعد لها او الماذون فيه شرعا كباب المسجد او السوق ولم تكن معروفة بالعداء وحصل الاتلاف منها لغير شء فعل بها فذلك هدر اي ساقط عن صاحبها وهو بفتح الهاء والدال وقد تسكن الدال واما لو اتلفت من اجل شء فعل بها فضمانه علي الفعال ( ( ( الفاعل ) ) ) كما لو ضربها شخص فضربت برجلها او بقرنها اخر فقتلته هذا كله فيما اتلفته من غير الزروع وسياتي حكم ما اذا اتلفت شيءا من الزروع والحواءط في غير هذا الباب وما مات في بءر اي والذي ما ( ( ( مات ) ) ) بسبب انهدام بءر عليه استءجر علي حفرها او بناءها او غوصها او مات في معدن استءجر علي العمل فيه والحال ان موت من ذكر من غير فعل احد فهو هدر خبر ما الواقعة مبتدا اي لاضمان علي المساجر ( ( ( المستاجر ) ) ) له لاقود ولا دية وموضوع كلام المصنف ان الحفر في محل يجوز الحفر فيه والاصل في جميع ذلك قوله صلي الله عليه وسلم فعل العجماء جبار والبءر جبار والمعدن جبار وفي الركاز الخمس والعجماء المد ( ( ( بالمد ) ) ) كل حيوان غير الادمي وسميت البهيمة بالعدماء ( ( ( بالعجماء ) ) ) لانها لاتتكلم والجبار بضم الجيم وتخفيف الموحدة الذي لاشء فيه واحترز بقوله من غير فعل احد عما لو كانا اثنين فماتا فان نصف دية كل علي عاقلة الاخر وان كانوا ثلاثة فثلث دية كل علي عاقلة الاخر وهكذا لو كثر والتسبب كل في قتله وقتل صاحبه فماتا به ساقط كقتل نفسه وتءخذ عاقلته بما تسبب في غيره وكذا لو حفر بءرا في محل لايجوز له الحفر فيه فما تلف فيه يضمنه المال في مالهوالدية علي عاقلته ان بلغت الثلث ولما قدم ان دية العمد وما في حمها ( ( ( حكمها ) ) ) مما لاتحمله العاقلة لنقصه عن الثلث حالة في ما الجاني ذكر هنا ان دية الخطا تنجم علي العاقلة بقوله وتنجم اي تقسط الدية الكاملة علي العاقلة في قتل الخطا في ثلاث سنين قال خليل ونجمت دية الحر بلا اعتراف علي العاقلة والجاني الكاملة في ثلاث سنين تحل باواخرها من يوم الحكم والمعني ان دية الحر المقتول خطا اذا ثبتت بغير اعتراف القاتل تفرق علي عاقلة القاتل ثلاث ( ( ( ثلاثة ) ) ) اقساط سواء كان الحر المال لكن عند وجود الجميع المتدالا ( ( ( المبدا ) ) ) اهل الديوان القاءم العطاء فان لم يكن كذلك فعصبته نسبا والا قالموالي ( ( ( فالموالي ) ) ) الاعلون ثم الاعلون ثم الاسفلون فان لم يكن موال فبيت المال ان كان الجاني مسلما ويضرب عليه لو كان مع العاقلة وان لم يكن او لم يمكن الوصول اليه فتءخذ من مال الجاني ويظهر لي انها تقسط عليه لانه احق بالرفق من العاقلة وحرره واما الذمي اذا لم يكن من اهل ديوان ولا عصبة له فيعقل عنه اهل ديته من كورته فلا يعقل نصاني ( ( ( نصراني ) ) ) عن يهودي ولا عكسه والصلحي اهل صلحة وختلف ( ( ( واختلف ) ) ) في عددها فقيل سبعماءة رجل ينتسبون الي اب واحد وقيل الزاءد علي الاف ( ( ( الالف ) ) ) وعلي الاول ان نقصوا عن السبعماءة كملوا من غيرهم وعلي الثاني كذلك ويضرب علي كل واجد مالا يضربه فيءخذ من المتسع في المغني ( ( ( الغني ) ) ) بقدره وممن دونه بقدره والصبي والمجنون والمراة والفقير والغارم يعقل عنهم ولا يعقلون عن غيرهم والمعتبر حالهم وقت توزيع الدية فمن كان غاءبا عن محل القاتل غيبة انقطاع او فيرا ( ( ( فقيرا ) ) ) او صبيا او مجنونا لم يضرب عليه شء ولو قدم الغاءب بعد ذلك او بلغ الصبي او افاق المجنون او ايسر الفقير كما انه لايسقط شء ( ( ( يسقط ) ) ) من المضروب بزوال الغني او بالموت وتكون الاقساط متساوية ويعطي كل ثلث في اخر السنة كما قضي بذلك عمر وعلي بن ابي طالب رضي الله عنهما  وعن جميع الصحابة لانها مواساة من العاقلة فتخفف عنهم بتاجيلها لاخر العام وسميت عاقلة لانها تعقل عن القاتل او تحمل عنه وقيل لانها تعقل لسان الطالب عن الجاني وقيل لانهم كانو ( ( ( كانوا ) ) ) يعقلون الابل عند دار المقتول وهكذا كانت في الجاهلية فاقرها رسول الله صلي الله عليه وسلم في الاسلام وان كان الواجب ثلثها بان كان الجرح جاءفة او امة او دامغة فانه يقبض من العاقلة في اخر سنة لانه لايحل الا بانقضاءها وايداءها ( ( ( وابداءها ) ) ) من يوم الحكم والثلثان في سنتين وكان كان الواجب نصفها كما لو قطع يد او رجل شخص خطا فانها تءخذ في سنتين يحل في اخر السنة الاولي ثلثها وفي الثانية سدسها هكذا يفهم من قوله ونصفها في سنتين وهو الموافق لابن الحاجب وخليل ولفظ خليل والثلث والثلثان بالنسبة ونجم في النصف والثلاثة الارباع بالتثليث ثم للزاءد سنة وفي الاجهوري ما يقتضي ان هذا خلاف المشهور وان المشهور ان النصف يجعل شطرين لك ( ( ( لكل ) ) ) سنة شطر فانه صوب كلام خليل يقوله ولو قال ونجم في المصنف والثلاثة ارباع بالتربيع ربع باخر كل عام لوافق الراجح واقول لعل كلام الاجهوري مبني علي ان الكاملة تنجم علي اربع سنين علي القول الشاذ المقابل لما عليه المصنف وخليل وبان ( ( ( وابن ) ) ) الحاجب من جعل الكاملة في ثلاث ثم شرع في بيان مستحق دية المقتول بقول والدية وهي المال المءدي في نظير دم المقتول موروثة علي افراءض ( ( ( الفراءض ) ) ) سواء كانت دية عمد او خطا فهي كمال الميت فياخذ كل واحد من ورثة المقتول نصيبه المقدر له في ماله بنص كتاب الله الا القاتل والدليل ( ( ( الدليل ) ) ) علي ذلك ما في الموطا من انه صلي الله عليه وسلم كتب الي بعض اصحابه ان يورث امراة من دية زوجها المقتول خطا وفي قوله موروثة مناقشة لما ان الارث انما يطلع ( ( ( يطلق ) ) ) علي المال الذي كان مملوكا للموروث في حال حياته والدية انما استحقتها الورثة بعد موتها ويمكن الجواب بان هذا مبني علي القول بان يملكها باخر جزء من حيانه ( ( ( حياته ) ) ) بدليل ان ديته يقضي منها وتنفذ وصاياه منها واذا عفا عن قاتله خطا فان عفوه يكو وصية للعاقلة بديته فان حملها ثلثه سقطت عنهم مع ان الوصية انما تكون من ثلث ما علم به من ماله في حياته ثم شرع في بيان ما يجب في الجنين بقوله والواجب في حنين ( ( ( جنين ) ) ) اي حمل الحرة مسلمة او كافرة اذا انفصل عنها غير مستهل وهي حية بسبب ضربة او تخويف او شم راءحة سمك من عند من يعلم حملها وان عدم اطعامها يسقطه غرة وهي عبد او وليد ( ( ( وليدة ) ) ) اي جارية صغيرة بلغت حد الاثغار بحيث تقوم تلك الرقبة بخمسين دينار ( ( ( دينارا ) ) ) او ستماءة درهم وذلك نصف عشر دية ابيه وعشر دية امه قال خليل وفي الحنيني ( ( ( الجنين ) ) ) وان علقهل ( ( ( علقة ) ) ) عشرة ( ( ( عشر ) ) ) امه ولو امه نقدا او غرة عبدا او وليد ( ( ( وليدة ) ) ) تساوي ( ( ( تساويه ) ) ) اي العشر لان مشهور المذهب ان الغرة لاتكون من الابل والمعني ان كل ما تسبب في انزال حنينيمن ( ( ( جنين ) ) ) بطن امه ونزل غير مستهل كما قدمنا فانه يلزمه لمن يرثه عشر واجب امه من النقد الحال او يدفع في حنيني ( ( ( جنين ) ) ) الحرة عبد ( ( ( عبدا ) ) ) او جارية تساوي عشر دية امه ولو كان سبب نزوله شمها راءحة حيث طلبت من ذي الراءحة شيءا ولز ( ( ( ولم ) ) ) يعطها او علم بحملها وبان عدم تناولها منه يسقط جنينها والقت ما في بطنها فانه يضمن ولو لم تطلب منه ولو كان الجنين دما مجتمعا بحيث اذا صب عليه الماء الحار لايذوب لان العلقة عندنا في باب الغرة والعدة وام الولد حكم المتخلق لكن يشترط في لزوم الغرة شهادة البينة ان انزال الجنين من هذا السبب بان عاينتها لزمنتت ( ( ( لزمت ) ) ) الفراش الي ان انفصل منها غير مستهل وهي حية واما لو نزل مستهل ( ( ( مستهلا ) ) ) فان الواجب فيه الدية كاملة بشرط القسامة ولو مات عاجلا وقولنها ( ( ( وقولنا ) ) ) وهي حية للاحتراز عما لو انفصل عنها غير مستهل بعد موتها او بعضه في حياتها ة ( ( ( وبعضه ) ) ) بعضه بعد موتها فانه يندرج فيها والدليل علي ما ذكرنا في الموطا ان رسول الله صلي الله عليه وسلم قض