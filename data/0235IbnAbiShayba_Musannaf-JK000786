  حدثنا ابو بكر قال حدثنا علي بن هاشم عن بن ابي ليلي عن بن ابي مليكة عن عبد الله بن عمرو قال قال رسول الله صلي الله عليه وسلم اتي جبريل ابراهيم فراح به الي مني فصلي به الصلوات جميعا ثم صلي به الفجر ثم غدا به الي عرفة فنزل به حيث ينزل الناس ثم صلي به الصلوات جميعا ثم اتي الموقف حتي اذا كان كاعجل ما يصلي انسان المغرب افاض به فاتي جمعا فصلي به الصلاتين ثم بات بها حتي اذا كان كاعجل ما يصلي احد من الناس الفجر صلي به ثم وقف حتي اذا كان كابطا ما يصلي احد من الناس الفجر افاض به الي مني فرمي الجمرة ثم ذبح وحلق ثم افاض به ثم اوحي الله تعالي الي نبيه صلي الله عليه وسلم @QB@ ان اتبع ملة ابراهيم حنيفا @QE@ 
  حدثنا ابو بكر قال حدثنا يزيد بن هارون عن التيمي عن ابي مجلز في قوله تعالي @QB@ واذ يرفع ابراهيم القواعد من البيت @QE@  جاءه جبريل فاراه الطواف بالبيت واحسبه قال والصفا والمروة ثم انطلقا الي العقبة فعرض لهم الشيطان قال فاخذ جبريل سبع حصيات واعطي ابراهيم سبع حصيات فرمي وكبر وقال لابراهيم ارم وكبر قال فرميا وكبرا مع كل رمية حتي اقبل الشيطان ثم انطلقا الي الجمرة الوسطي فعرض لهما الشيطان فاخذ جبريل سبع حصيات واعطي ابراهيم سبع حصيات فرميا وكبرا مع كل رمية حتي اقبل الشيطان ثم اتيا الجمرة القصوي قال فعرض لهما الشيطان قال فاخذ جبريل سبع حصيات واعطي ابراهيم سبع حصيات وقال ارم وكبر فرميا وكبرا مع كل رمية حتي اقبل ثم اتي به مني فقال ها هنا يحلق الناس رءوسهم ثم اتي جمعا فقال ها هنا يجمع الناس الصلاة ثم اتي به عرفات فقال عرفت قال نعم قال فمن ثم سميت عرفات
  حدثنا ابو بكر قال حدثنا يزيد بن هارون قال اخبرنا داود بن ابي هند عن محمد بن موسي في قوله @QB@ ومن يعظم شعاءر الله فانها من تقوي القلوب @QE@  قال الوقوف بعرفة من شعاءر الله والجمع من شعاءر الله والجمار من شعاءر الله والبدن من شعاءر الله والحلق من شعاءر الله فمن يعظمها فانها من تقوي القلوب قال في قوله @QB@ لكم فيها منافع الي اجل مسمي @QE@  قال لكم في كل مشعر منافع ان تخرجوا منه الي غيره فالاجل المسمي الخروج منه الي غيره @QB@ ثم محلها الي البيت العتيق @QE@  قال محل هذه الشعاءر كلها الطواف بالبيت
  حدثنا ابو بكر قال حدثنا بن عيينة عن بن ابي نجيح عن مجاهد @QB@ واتخذوا من مقام ابراهيم مصلي @QE@  هو الحج كله
  حدثنا ابو بكر قال حدثنا اسماعيل بن علية عن التيمي عن ابي مجلز قال كان مع بن عمر فلما طلعت الشمس امر براحلته فرحلت وارتحل من مني فسار قال فانه كان عجيبا اليه اسفهنا رجل كان يحدثه عن النساء ويضحكه قال فلما صلي العصر وقف بعرفة فجعل يرفع يديه او قال يمد قال ولا ادري لعله قد قال دون اذنيه وجعل يقول الله اكبر  ولله الحمد الله اكبر ولله الحمد لا اله الا الله وحده له الملك وله الحمد اللهم اهدني بالهدي ووفقني بالتقوي واغفر لي في الاخرة والاولي ثم يرد يديه فيسكت كقدر ما كان انسان قارءا بفاتحة الكتاب ثم يعود فيرفع يديه ويقول مثل ذلك فلم يزل يفعل ذلك حتي افاض
 قال فكان سيره اذا راي سعة العنق واذا راي مضيقا امسك واذا اتي جبلا من تلك الجبال وقف عند كل جبل منها بقدر ما اقول او يقول القاءل يداها ولم تقف رجلاها ثم نزل نزلة بالطريق فانطلق واتبعته فقلت لعله يفعل شيءا من السنة فقال انما اذهب حيث تعلم فجاء فتوضا علي رسله ثم ركب ولم يصل حتي اتي جمعا فاقام فصلي المغرب ثم انفتل الينا فقال الصلاة جامعة او قال اذان الا ذلك قال لا ثم صلي العشاء ركعتين فصلي خمس ركعات للمغرب والعشاء ولم يتطوع او قال لم يتجوز بينهما بشء ثم دعا بطعام فقال من كان يسمع صوتنا فلياتنا قال كانه يري ان ذاك كذاك سعي ثم باتوا ثم صلي بنا الصبح بسور وفي السماء نجم اعرفه لا اراه وقرا بعبس وتولي ولم يقنت قبل الركوع ولا بعده ثم وقف فذكر من دعاءه في هذا الموقف كما فعل في موقفه بالامس ثم امضي سيره اذا راي سعة العنق واذا راي مضيقا امسك
 قال وكان بن عباس اخبرني ان الوادي الذي بين يديه مني الذي يدعي محسرا يوضع فلما اتي عليه ركض برجله فعرفت انه اراد ان يوضع فاعيته راحلته فاوضعته فرمي الجمرة فلما كان الغد رمي الجمرة قال احسبه قال لي يقال لها حرة ثم تقدم حتي كان بينهما وبين الوسطي فذكر من دعاءه نحو ذلك في الموقفين الا انه زاد واصلح لي او قال واتمم لنا مناسكنا قال وكان قيامه كقدر ما كان انسان فيما يري قارءا سورة يوسف ثم رمي الجمرة الوسطي ثم تقدم فذكر من دعاءه نحو ذلك من قيامه قال فقلت لسالم او نافع هل كان يقول في سكوته شيءا قال اما من السنة فلا
  حدثنا ابو بكر قال حدثنا حاتم بن اسماعيل عن جعفر عن ابيه قال دخلنا علي جابر بن عبد الله فقال من القوم حتي انتهي الي فقلت انا محمد بن علي بن حسين فاهوي بيده الي راسي فنزع زري الاعلي ثم نزع زري الاسفل ثم وضع كفه بين ثديي وانا يومءذ غلام شاب فقال مرحبا بك يا بان اخي سل عم شءت فسالته وهو اعمي وجاء وقت الصلاة فقام في نساجة (  ) ملتحفا بها كلما وضعها علي منكبه رجع طرفاها اليه من صغرها ورداءه الي جنبه علي المشجب فصلي بنا فقلت اخبرني عن حجة رسول الله صلي الله عليه وسلم
 فقال بيده فعقد تسعا فقال ان رسول الله صلي الله عليه وسلم مكث تسع سنين لايحج ثم اذن في  الناس بالحج في العاشرة ان رسول الله صلي الله عليه وسلم حاج فقدم المدينة بشر كثير كلهم يلتمس ان ياتم برسول الله صلي الله عليه وسلم ويعمل مثل عمله فخرجنا معه حتي اتينا ذا الحليفة فولدت اسماء بنت عميس محمد بن ابي بكر فارسلت الي رسول الله صلي الله عليه وسلم كيف اصنع قال اغتسلي واستذفري بثوب واحرمي
 فصلي رسول الله صلي الله عليه سلم في المسجد ثم ركب القصواء حتي اذا استوت به ناقته علي البيداء نظرت الي مدي بصري من بين يديه من راكب وماش وعن يمينه مثل ذلك وعن يساره مثل ذلك ومن خلفه مثل ذلك ) ورسول الله صلي الله عليه وسلم بين اظهرنا وعليه ينزل القران وهو يعرف تاويله وما عمل به من شء عملنا به فاهل بالتوحيد لبيك اللهم لبيك لبيك لا شريك لك لبيك ان الحمد والنعمة لك والملك لا شريك لك واهل الناس بهذا الذي يهلون به فلم يرد عليهم رسول الله صلي الله عليه وسلم شيءا منه ولزم رسول الله صلي الله عليه وسلم تلبيته
 وقال جابر لسنا ننوي الا الحج لسنا نعرف العمرة حتي اذا اتينا البيت معه استلم الركن فرمل ثلاثا ومشي اربعا ثم تقدم الي مقام ابراهيم فقرا @QB@ واتخذوا من مقام ابراهيم مصلي @QE@  فجعل المقام بينه وبين البيت
 فكان ابي يقول ولا اعلمه ذكره الا عن النبي صلي الله عليه وسلم كان يقرا في الركعتين @QB@ قل هو الله احد @QE@ و @QB@ قل يا ايها الكافرون @QE@ ثم رجع الي الركن فاستلمه ثم خرج من الباب الي الصفا فلما دنا من الصفا قرا @QB@ ان الصفا والمروة من شعاءر الله @QE@  ابدا بما بدا الله به فبدا بالصفا فرقي عليه حتي راي البيت فاستقبل البيت ووحد الله وكبره وقال لا اله الا الله وحده لا شريك له له الملك وله الحمد وهو علي كل شء قدير لا اله الا الله وحده نصر عبده وهزم الاحزاب وحده ثم دعا بين ذلك قال مثل ذلك ثلاث مرات ثم نزل الي المروة حتي اذا انصبت قدماه الي بطن الوادي حتي اذا صعدنا مشي حتي اتي المروة ففعل علي المروة كما فعل علي الصفا حتي اذا كان اخر طوافه علي المروة قال اني لو استقبلت من امري ما استدبرت لم اسق الهدي وجعلتها عمرة فمن كان منكم ليس معه هدي فليحل وليجعلها عمرة فقام سراقة بن مالك بن جعشم فقال يا رسول الله لعامنا هذا او لابد ابد فشبك رسول الله صلي الله عليه وسلم اصابعه واحدة في الاخري وقال دخلت العمرة في الحج مرتين لا بل لابد ابد
 وقدم علي من اليمن ببدن النبي صلي الله عليه وسلم فوجد فاطمة ممن حل ولبست ثيابا صبيغا واكتحلت فانكر ذلك عليها فقالت ابي امرني بهذا قال فكان علي يقول بالعراق فذهبت الي رسول الله صلي الله عليه وسلم محرشا علي فاطمة للذي صنعت مستفتيا لرسول الله فيما ذكرت عنه قال فاخبرته  اني انكرت ذلك عليها فقال صدقت صدقت قال ما قلت حين فرضت الحج قال قلت اللهم اني اهل بما اهل به رسولك قال فان معي الهدي فلا تحل
 قال فكان جماعة الهدي الذي قدم به علي من اليمن والذي اتي به النبي صلي الله عليه وسلم ماءة قال فحل الناس كلهم وقصروا الا النبي صلي الله عليه وسلم ومن كان معه هدي فلما كان يوم التروية توجهوا الي مني فاهلوا بالحج وركب رسول الله صلي الله عليه وسلم فصلي بها الظهر والعصر والمغرب والعشاء والصبح ثم مكث قليلا حتي طلعت الشمس وامر بقبة من شعر تضرب له بنمرة فسار رسول الله صلي الله عليه وسلم ولا تشك قريش الا انه واقف عند المشعر الحرام كما كانت قريش تصنع في الجاهلية فاجاز رسول الله صلي الله عليه وسلم حتي اتي عرفة فوجد القبة قد ضربت له بنمرة فنزل بها حتي اذا زاغت الشمس امر بالقصواء فرحلت له فاتي بطن الوادي فخطب الناس فقال
 ان دماءكم واموالكم حرام عليكم كحرمة يومكم هذا في شهركم هذا في بلدكم هذا الا كل شء من امر الجاهلية تحت قدمي موضوع ودماء الجاهلية موضوعة وان اول دم اضع من دماءنا دم بن ربيعة بن الحارث كان مسترضعا في بني سعد فقتلته هذيل وربا اهل الجاهلية موضوع واول ربا اضع ربا عباس بن عبد المطلب فانه كله موضوع فاتقوا الله في النساء فانكم اخذتموهن بامان الله واستحللتم فروجهن بكلمة الله ولكم عليهن الا يوطءن فرشكم احدا تكرهونه فان فعلن ذلك فاضربوهن ضربا غير مبرح ولهن عليكم رزقهن وكسوتهن بالمعروف وقد تركت فيكم ما لن تضلوا بعده ان اعتصمتم به كتاب الله وانتم تسالون عني فما انتم قاءلون قالوا نشهد ان قد بلغت واديت ونصحت وقال باصبعه السبابة يرفعها الي السماء وينكتها الي الناس اللهم اشهد اللهم اشهد ثلاث مرات
 ثم اذن ثم اقام الظهر والعصر ولم يصل بينهما شيءا ثم ركب رسول الله صلي الله عليه وسلم حتي اتي الموقف فجعل بطن ناقته القصواء الي الصخرات وجعل حبل المشاة بين يديه واستقبل القبلة فلم يزل واقفا حتي غربت الشمس وذهبت الصفرة قليلا حتي غاب القرص واردف اسامة خلفه ودفع رسول الله صلي الله عليه وسلم وقد شنق للقصواء الزمام حتي ان راسها ليصيب مورك رحله ويقول بيده اليمني ايها الناس السكينة السكينة كلما اتي جبلا من الجبال ارخي لها قليلا حتي تصعد حتي اتي المزدلفة فصلي بها المغرب والعشاء باذان واحد واقامتين ولم يسبح بينهما شيءا ثم اضطجع رسول الله صلي الله عليه وسلم حتي طلع الفجر وصلي حين تبين له الصبح باذان واقامة ثم ركب القصواء حتي اتي المشعر الحرام فاستقبل القبلة فدعاه وكبره وهلله ووحده فلم يزل واقفا حتي اسفر جدا فدفع قبل ان تطلع الشمس  واردف الفضل بن عباس وكان رجلا حسن الشعر ابيض وسيما فلما دفع رسول الله صلي الله عليه وسلم مرت ظعن يجرين فطفق الفضل ينظر اليهن فوضع رسول الله صلي الله عليه وسلم يده علي وجهه فحول الفضل وجهه الي الشق الاخر ينظر فحول رسول الله صلي الله عليه وسلم يده من الشق الاخر علي وجه الفضل يصرف وجهه من الشق الاخر ينظر حتي اتي ( بطن محسر فحرك ) قليلا ثم سلك الطريق الوسطي التي تخرج الي الجمرة الكبري حتي اتي الجمرة التي عند الشجرة فرماها بسبع حصيات يكبر مع كل حصاة منها مثل حصي الخذف رمي بطن الوادي
 ثم انصرف المنحر فنحر ثلاثا وستين بيده ثم اعطي عليا فنحر ما غبر منها واشركه في هديه وامر عن كل بدنة ببضعة فجعلت في قدر فطبخت فاكلا من لحمها وشربا من مرقها ثم ركب رسول الله صلي الله عليه وسلم فافاض الي البيت فصلي بمكة الظهر فاتي بني عبد المطلب يسقون علي زمزم فقال انزعوا بني عبد المطلب فلولا ان تغلبكم الناس علي سقايتكم لنزعت معكم فناولوه دلوا فشرب منه
  حدثنا ابو بكر قال حدثنا ابو الاحوص عن ابي اسحاق عن مسروق قال امرتم في الكتاب باقامة اربع باقامة الصلاة وايتاء الزكاة واقامة الحج والعمرة
  حدثنا ابو بكر قال حدثنا عبد الله بن نمير عن عبد الملك عن عطاء انه سءل عن الدجاجة السندية يخرج بها من الحرم فقال لا هي صيد
  حدثنا ابو بكر قال حدثنا ابو اسامة عن بن جريج عن عطاء ان ازواج النبي صلي الله عليه وسلم كن يطفن مع الرجال قال عطاء وقالت امراة لعاءشة تعالي الي الحجر فاستلميه قالت الفدي عنك
  (  ) في المحرم يحتش )
  حدثنا ابو بكر قال حدثنا روح بن عبادة عن اشعث عن الحسن انه كان لا يري باسا ان يحتش المحرم
  حدثنا ابو بكر قال حدثنا روح بن عبادة عن بن جريج عن عطاء قال لا باس به
  (  ) في المحرم يضطر الي الصيد والميتة )
  حدثنا ابو بكر قال حدثنا ابو اسامة عن اشعث عن الحسن قال كان يقول فيمن اضطر الي ميتة وصيد ياكل الميتة ولا ياكل الصيد ولا يعرض له يعني المحرم 
  (  ) من قال يلبي عن الاخرس )
  حدثنا ابو بكر قال حدثنا هشيم عن حجاج عن عطاء قال يلبي عن الاخرس والصبي
  (  ) في امراة قدمت معتمرة وهي حاءض )
  حدثنا ابو بكر قال حدثنا حفص عن عمرو وهشام عن الحسن في امراة قدمت معتمرة وهي حاءض قال تهل بالحج علي عمرتها وتمضي الي عرفات وهي قارن
  حدثنا ابو بكر قال حدثنا حفص عن هشام عن عطاء مثله
  (  ) في رجل اراد ان يلبي فكبر )
  حدثنا ابو بكر قال حدثنا معاوية بن هشام قال حدثنا سفيان عن ابراهيم بن نافع عن طاوس قال سمعته سءل عن رجل اراد ان يلبي فكبر قال يجزيه
  حدثنا ابو بكر قال حدثنا معاوية بن هشام قال حدثنا سفيان عن عبد الملك عن عطاء قال يرجع
  حدثنا ابو بكر قال حدثنا سفيان عن بن جريج عن عطاء قال يجزيه
  (  ) في المراة تحرم في الحج بغير اذن زوجها )
  حدثنا ابو بكر قال حدثنا عبد العزيز العمي قال سءل مطر وانا اسمع عن امراة استاذنت زوجها في الحج فلم ياذن لها فاستاذنته ان تزور فاذن لها فضمت عليها ثيابا لها بيضا فصرخت بالحج قال فاتوا الحسن فسالوه فقال الحسن ليس لها ذاك قال مطر وسءل قتادة فقال هي محرمة قال مطر فانطلقت الي مكة فسالت الحكم بن عتيبة فقال هي محرمة قال مطر فامرت رجلا فسال عطاء بن ابي رباح فقال لا ولا نعمت عين ليس لها ذلك
  حدثنا ابو بكر قال حدثنا ابو عوانة عن منصورعن ابراهيم قال اذا كانت الفريضة وكان لها محرم فلا باس ان تخرج ولا تستاذن زوجها 
  حدثنا ابو بكر قال حدثنا فضيل بن عياض عن هشام عن الحسن في المراة التي لم تحج قال تستاذن زوجها فاذا اذن لها فذاك احب الي وان لم ياذن لها خرجت مع ذي محرم فان ذلك فريضة من فراءض الله ليس له عليها فيها طاعة
  (  ) في اعتناق البيت )
  حدثنا ابو بكر قال حدثنا بن مهدي عن سفيان عن الزبير بن عدي عن ابراهيم قال ما كان اصحابنا يعتنقون البيت
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن ابراهيم بن عبد الاعلي عن سويد بن غفلة ان عمر التزم الحجر وقبله
  (  ) في المعتمر يطوف بالبيت ايقع علي اهله )
  حدثنا ابو بكر قال حدثنا بن عيينة عن عمرو قال سالت جابر بن عبد الله عن رجل اعتمر فطاف بالبيت ثم اراد ان يقع علي اهله قبل ان يطوف بين الصفا والمروة فقال لا حتي يطوف بين الصفا والمروة
  (  ) في الميت يحج عنه )
  حدثنا ابو بكر قال حدثنا وكيع عن شعبة عن ابي بشر عن سعيد بن جبير عن بن عباس قال جاء رجل الي النبي صلي الله عليه وسلم فقال ان اختي ماتت ولم تحج افاحج عنها قال ارايت لو كان عليها دين فقضيته والله احق بالوفاء والقضاء
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن منصور عن مجاهد عن رجل يقال له يوسف عن بن الزبير قال اتي النبي صلي الله عليه وسلم رجل فقال يا رسول الله ان ابني مات ولم يحج فاحج عنه قال انه اكبر ولدك قال نعم قال فحج عن ابنك ارايت لو كان علي ابنك دين فقضيته
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن اسلم عن عطاء قال يحج عن الميت وان لم يوص به 
  (  ) في الاشتراط في الحج )
  حدثنا ابو محمد عبد الله بن يونس قال حدثنا ابو عبد الرحمن بقي بن مخلد قال حدثنا ابو بكر عبد الله بن محمد بن ابي شيبة العبسي قال حدثنا بن فضيل عن هشام عن ابيه عن ضباعة قالت دخل علي النبي صلي الله عليه وسلم وانا اشتكي فقال ما تريدين الحج العام قالت اني لمعتلة يا رسول الله قال حجي وقولي محلي من الارض حيث حبستني
  حدثنا ابو بكر قال حدثنا بن فضيل عن عطاء بن ميسرة عن علي انه كان يقول اللهم حجة ان تيسرت او عمرة ان اراد العمرة والا فلا حرج
  حدثنا ابو بكر قال حدثنا يزيد بن هارون قال اخبرنا سفيان بن حسين عن ابي بشر عن عكرمة عن بن عباس ان رسول الله صلي الله عليه وسلم دخل علي ضباعة ابنة الزبير وهي تريد الحج فقال لها اشترطي عند احرامك وقولي ) ومحلي حيث حبستني فان ذلك لك
  حدثنا ابو بكر قال حدثنا بن فضيل عن هشام عن ابيه عن عاءشة انها قالت اذا حججت فاشترط قل اللهم الحج عمدت واياه اردت فان تيسر الحج فهو الحج فان حبست فعمرة
  حدثنا ابو بكر قال حدثنا ابو معاوية عن الاعمش عن ابراهيم عن علقمة قال رايته وضع رجله في الغرز ثم قال اللهم اني اريد حجة ان تيسرت والا فعمرة ان تيسرت
  حدثنا ابو بكر قال حدثنا سلام عن مغيرة عن ابراهيم قال كان الاسود تعادله راحلته فاذا اتي جناية نحر دما واذا اراد ان يركب قال اللهم حجة ان تيسرت والا عمرة ان تيسرت ثم يلبي بالحج
  حدثنا ابو بكر قال حدثنا ابو اسامة عن هشام بن عروة قال كان ابي لا يري الاشتراط في الحج شيءا
  حدثنا ابو بكر قال حدثنا ابو معاوية عن الاعمش عن ابراهيم وسلام عن مغيرة عن ابراهيم قال كانوا لا يشترطون ولا يرون الشرط فيه شيءا قال سلام في حديثه لو ان رجلا ابتلي
  حدثنا ابو بكر قال حدثنا بن مبارك عن هشام عن بن سيرين قال راي عثمان رجلا واقفا بعرفة فقال له اشترطت قال نعم 
  حدثنا ابو بكر قال حدثنا الفضل بن دكين عن سعيد بن عبد الرحمن عن بن سيرين عن عبد الله بن عتبة عن عثمان نحوه
  حدثنا ابو بكر قال حدثنا وكيع عن ربيع بن صبيح عن الحسن وعطاء في المحرم يشترط قالا له شرطه
  حدثنا ابو بكر قال حدثنا ابو معاوية عن الاعمش عن عمارة ان شريحا كان يشترط في الحج فيقول انك قد عرفت بنيتي وما اريد فان امرا فاتممه فهو احب الي وان كان غير ذلك فلا حرج قال بلغني ان ابا معاوية رجع عن هذا الحديث
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن حبيب بن ابي ثابت عن طاوس قال الاشتراط في الحج ليس بشء
  حدثنا ابو بكر قال حدثنا عباد بن العوام عن هلال بن خباب قال قلت لسعيد بن جبير ارايت الاشتراط في الحج قال انما الاشتراط في الحج فيما بين الناس
  حدثنا ابو بكر قال حدثنا غندر عن شعبة عن الحكم وحماد في الاشتراط قال ليس بشء
  حدثنا ابو بكر قال حدثنا ابو خالد الاحمر عن شعبة عن ابراهيم بن مهاجر عن ابراهيم التيمي قال كان علقمة يشترط في الحج ولا يراه شيءا
  حدثنا ابو بكر قال حدثنا يزيد بن هارون عن داود بن ابي هند عن سعيد بن جبير قال المستثني وغير المستثني سواء
  حدثنا ابو بكر قال حدثنا عباد بن العوام عن هلال بن خباب عن عكرمة عن بن عباس ان النبي صلي الله عليه وسلم دخل علي ضباعة فقال لها ما تريدين الحج العام قالت يا رسول الله اني معتلة قال حجي واشترطي قالت كيف اقول قال قولي لبيك اللهم لبيك محلي من الارض حيث حبستني
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن ابي اسحاق عن عمير بن زياد عن عبد الله قال اذا حججت فاشترطه
  حدثنا ابو بكر قال حدثنا حماد بن خالد عن محمد بن هلال عن ابيه عن ابي بكر بن عبد الله الحارث انه كان يشترط في العمرة 
  (  ) في العبد يعتق عشية عرفة )
  حدثنا ابو بكر قال حدثنا يزيد بن هارون عن هشام عن الحسن وعطاء قالا في العبد يعتق بعد ما ينفر الناس من عرفات او قال يحتلم الغلام او تحيض الجارية او يجمع فرجعوا الي عرفات فوقفوا قبل طلوع الفجر فقد اجزات عنهم حجة الاسلام
  (  ) في الرجل يحج عن الرجل فيفضل معه الفضلة )
  حدثنا ابو بكر قال حدثنا بن ادريس عن هشام عن الحسن في الرجل يحج عن الرجل فيفضل معه قال يعلمهم فان سلموه والا رده
  (  ) من قال اذا قبل الحجر سجد عليه )
  حدثنا ابو بكر قال حدثنا وكيع عن بن جريج عن محمد بن عباد بن جعفر قال رايت بن عباس جاء يوم التروية فقبل الحجر ثم سجد عليه فعل ذلك ثلاثا
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن حسين بن عبد الله عن عكرمة ان بن عباس سجد عليه
  حدثنا ابو بكر قال حدثنا ابو معاوية عن الاعمش عن ابراهيم عن عابس بن ربيعة قال رايت عمر بن الخطاب استلم الحجر وقبله وقال لولا اني رايت رسول الله صلي الله عليه وسلم يقبلك ما قبلتك
  حدثنا ابو بكر قال حدثنا حميد بن عبد الرحمن عن حنظلة عن طاوس ان عمر قبل الحجر ثلاثا وسجد عليه لكل قبلة وذكر ان النبي صلي الله عليه وسلم فعله
  حدثنا ابو بكر قال حدثنا ابو معاوية عن عصام عن عبد الله بن نرجس قال رايت الاصلع عمر قبل الحجر وقال اني لاعلم انك حجر لا تضر ولا تنفع ولولا اني رايت رسول الله صلي الله عليه وسلم يقبلك ما قبلتك
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن ابراهيم بن عبد الاعلي عن سويد بن غفلة قال رايت عمر بن الخطاب قبل الحجر والتزمه وقال كان بك رسول الله صلي الله عليه وسلم حفيا 
  حدثنا ابو بكر قال حدثنا وكيع عن حنظلة قال رايت طاوسا فعله يعني سجد عليه
  (  ) في المشعر الحرام اي موضع هو )
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن السدي عن سعيد بن جبير قال ما بين جبلي مزدلفة فهو المشعر الحرام
  حدثنا ابو بكر قال حدثنا وكيع عن اسراءيل عن جابر عن عبد الرحمن بن الاسود قال لم اجد احدا يخبرني عن المشعر الحرام
  حدثنا ابو بكر قال حدثنا وكيع عن اسراءيل عن ابي اسحاق عن عمرو بن ميمون قال سالت عبد الله بن عمر عن المشعر الحرام فسكت حتي اذا تهبطت ايدي رواحلنا بالمزدلفة قال اين الساءل عن المشعر الحرام
  حدثنا ابو بكر قال حدثنا اسحاق الازرق عن مثني عن عطاء في قوله @QB@ المشعر الحرام @QE@  قال هو قزح هو المزدلفة كلها
  (  ) في فضل النظر الي البيت )
  حدثنا ابو بكر قال حدثنا حفص عن ليث عن طاوس قال النظر الي البيت عبادة والطواف بالبيت صلاة
  حدثنا ابو بكر قال حدثنا حفص عن ليث عن مجاهد قال النظر الي البيت عبادة
  حدثنا ابو بكر قال حدثنا وكيع وعبد الله عن ابان بن عبد الله البجلي عن عطاء قال النظر الي البيت عبادة
  حدثنا ابو بكر قال حدثنا عبيد الله بن موسي قال اخبرني ابو نعيم النخعي عن عبد الرحمن بن الاسود قال النظر الي البيت عبادة 
  (  ) في الرجل يدخل البيت بحذاء او نعل )
  حدثنا ابو بكر قال حدثنا عبد الرحمن بن محمد المحاربي عن ليث عن طاوس ومجاهد كانوا يكرهون ان يدخل البيت رجل عليه حذاء
  (  ) في المحرم يصيب القطاة ما عليه )
  حدثنا ابو بكر قال حدثنا عبد الصمد بن عبد الوارث عن عبد الله بن بكر المزني ان عطاء وطاوسا ومجاهدا قالوا في المحرم يصيب القطاة قالوا فيها شاة
  حدثنا ابو بكر قال حدثنا ابو اسامة قال حدثنا عبد الله بن عمر قال سال رجل سالما والقاسم عن قطاة اصابها وهو محرم قال احدهما يتصدق بنصف مد وقال الاخر نصف مد خير من قطاة
  حدثنا ابو بكر قال حدثنا حماد بن خالد عن عبد الله بن مءمل عن بن ابي مليكة عن بن عمر وبن عباس في محرم قتل قطاة فقالا ثلثا مد وثلثا مد خير من قطاة
  حدثنا ابو بكر قال حدثنا ابو معاوية عن صالح الفزاري عن عكرمة بن خالد سءل عن محرم قتل قطاة قال يتصدق بمد
  (  ) من كره ان ياخذ من شعره اذا اراد الحج )
  حدثنا ابو بكر قال حدثنا وكيع قال حدثنا بن ابي ذءب عن خاله الحارث عن ابي سلمة عن ام سلمة قالت اذا دخل العشر فلا ياخذ من شعره ولا من اظفاره
  حدثنا ابو بكر قال حدثنا حاتم بن اسماعيل عن عبد الرحمن بن حرملة عن سعيد بن المسيب انه قال من كان يريد ان يضحي فلا ياخذ من شعره ولا من اظفاره شيءا اذا اهل ذو الحجة
  حدثنا ابو بكر قال حدثنا شريك عن الاحلافي عن سعيد بن المسيب انه كره ان ياخذ من شعره اذا اراد الحج قال فسالت عكرمة قال افلا تدع النساء
  حدثنا ابو بكر قال حدثنا حفص عن بن جريج عن عطاء انه كره ان ياخذ من شعره اذا تقارب الحج 
  حدثنا ابو بكر قال حدثنا ابو بكر بن عياش عن اسحاق بن يحيي عن مجاهد عن بن عمر قال من اراد الحج فلا ياخذ من شعره شيءا
  حدثنا ابو بكر قال حدثنا وكيع عن محمد بن شريك عن عطاء انه سءل عن الرجل ياخذ من شعره وهو يريد الحج قال لا باس به
  حدثنا ابو بكر قال حدثنا ابو معاوية عن عبيد الله بن عمر عن ابي بكر بن سالم عن سالم انه كان يجز راسه في النصف من شعبان ثم يخرج حاجا
  حدثنا ابو بكر قال حدثنا بن علية عن يونس عن الحسن انه كان يحب ان يكف في العشر عن شعره واظفاره وكان لا يري بالتنور باسا
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن جابر قال سالت سالما وعطاء وطاوسا والقاسم فقالوا لا باس به
  حدثنا ابو بكر قال حدثنا بن فضيل عن محمد بن ابي اسماعيل قال حدثتني امي عن جدتها انها سمعت ام سلمة ام المءمنين تقول من كان يضحي عنه فهل هلال ذي الحجة فلا ياخذ من شعره شيءا حتي يضحي فذكرت ذلك لابراهيم فقال ما سمعت بهذا
  حدثنا ابو بكر قال حدثنا وكيع قال حدثنا سفيان عن مغيرة عن ابراهيم قال كانوا يستحبون توفير الشعر اذا ارادوا ان يحرموا
  حدثنا ابو بكر قال حدثنا وكيع قال حدثنا بن ابي ذءب عن عثمان بن عبيد الله بن ابي رافع عن عبد الرحمن بن هرمز الاعرج ان عمر بن الخطاب اخذ من راس رجل من قريش يقال له محمد بن ابي ربيعة كان ذا شعر بالشجرة قبل ان يحرم
  حدثنا ابو بكر قال حدثنا وكيع قال حدثنا بن ابي ذءب عن يزيد بن عبد الله بن قسيط عن ابي بكر بن عبد الرحمن بن الحارث بن هشام وعطاء بن يسار وابي بكر بن سليمان بن ابي خيثمة قالوا لا باس ان ياخذ الرجل من شعره واظفاره في العشر
  حدثنا ابو بكر قال حدثنا بن عيينة عن عمرو ان جابر بن زيد طلا في العشر
  حدثنا ابو بكر قال حدثنا وكيع عن محمد بن شريك عن عطاء قال لا باس بالتنور في العشر 
  حدثنا ابو بكر قال حدثنا بن يمان عن معمر عن قتادة عن بن المسيب انه كان يستحب توفير الشعر عند الاحرام
  (  ) في المحرم يبدل ثيابه )
  حدثنا ابو بكر قال حدثنا اسماعيل بن عياش عن سعيد بن يوسف عن يحيي بن ابي كثير عن عكرمة مولي بن عباس قال غير رسول الله صلي الله عليه وسلم بالتنعيم وهو محرم
  حدثنا ابو بكر قال حدثنا جرير عن مغيرة عن ابراهيم قال بغير المحرم من ثيابه ما شاء بعد ان يلبس ثياب المحرم
  حدثنا ابو بكر قال حدثنا وكيع عن الصباح بن ثابت قال سالت بن جبير ايبيع المحرم ثيابه قال نعم
  حدثنا ابو بكر قال حدثنا علي بن مسهر عن الصباح عن سعيد بنحوه
  حدثنا ابو بكر قال حدثنا هشيم عن مغيرة عن ابراهيم ويونس عن الحسن وحجاج وعبدالملك عن عطاء انهم لم يروا باسا ان يبدل المحرم ثيابه او ما سوي ذلك
  حدثنا ابو بكر قال حدثنا بن مهدي عن زمعة عن بن طاوس عن ابيه قال للمحرم ان يبدل من الثياب ما شاء
  (  ) في المحرم يدخل الحمام )
  حدثنا ابو بكر قال حدثنا بن علية عن ايوب عن عكرمة عن بن عباس انه دخل حمام الجحفة وهو محرم فقال ان الله لا يصنع باوساخكم شيءا
  حدثنا ابو بكر قال حدثنا عبد الاعلي عن هشام عن الحسن انه كان يكره ان يدخل المحرم الحمام ويقول انه لفي شغل من دخول الحمام
  حدثنا ابو بكر قال حدثنا بن نمير عن حجاج عن عطاء انه كره للمحرم ان يدخل الحمام 
  (  ) في الاقران بين الاسباع من رخص فيه )
  حدثنا ابو بكر قال حدثنا بن فضيل عن ليث عن طاوس عن عاءشة انها كانت لا تري باسا ان يطوف الرجل ثلاثة اسباع او خمسة ثم يصلي
  حدثنا ابو بكر قال حدثنا بن ادريس عن بن جريج عن عطاء عن عاءشة انها كانت تقرن بين الاسابيع
  حدثنا ابو بكر قال حدثنا ليث عن عطاء عن عاءشة قالت لا باس ان يطوف الرجل ثلاثة اسباع او خمسة ثم يصلي الركعتين
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن بن ابي نجيح عن مجاهد انه قرن مرة
  حدثنا ابو بكر قال حدثنا وكيع عن عمر بن ذر عن مجاهد انه انكره وقال ما فعله احد الا رجل من قريش المسور بن مخرمة
  حدثنا ابو بكر قال حدثنا عبيد الله عن حنظلة عن طاوس انه طاف ثلاثة اسباع ثم صلي ست ركعات
  حدثنا ابو بكر قال حدثنا يحيي بن سعيد عن بن جريج عن عطاء ان طاوسا والمسور بن مخرمة كانا يقرنان بين الاسابيع وكان عطاء لا يري بذلك باسا
  حدثنا ابو بكر قال حدثنا حفص عن عبد الملك قال جاورت بمكة وثمة سعيد بن جبير وعلي بن حسين فطاف علي بن حسين ثلاثة اسابيع وصلي لكل اسبوع ركعتين ثم اتي الحجر فاستلمه وكان سعيد بن جبير يفعله بالنهار
  حدثنا ابو بكر قال حدثنا حفص عن عبد الله بن مسلم قال ذكروا عند القاسم ان عاءشة كانت تقرن بين الاسابيع فقال اتقوا الله ولا تقولوا علي ام المءمنين ما لم تكن تفعل
  حدثنا ابو بكر قال حدثنا يحيي بن سليم عن اسماعيل بن امية عن الزهري قال مضت السنة ان مع كل اسبوع ركعتين
  حدثنا ابو بكر قال حدثنا معن بن عيسي عن خالد بن ابي بكر قال رايت القاسم بن محمد وسالما وعبيد الله بن عبد الله يصلون عند كل اسبوع ركعتين ولا يقرنون بين السبوع 
  حدثنا ابو بكر قال حدثنا معن عن مالك بن انس عن هشام بن عروة عن ابيه انه كان لا يقرن بين السبوع ويصلي لكل اسبوع ركعتين
  حدثنا ابو بكر قال حدثنا معن بن عيسي عن ثابت بن قيس قال رايت عراك بن مالك يصلي عند كل اسبوع ركعتين لا يجزء منها تطوع ولا فريضة
  (  ) في الصيد يوجد في الحل فيدخل الحرم فيذبح فيه )
  حدثنا ابو بكر قال حدثنا وكيع عن بن ابي ليلي قال سءل عطاء عن الصيد يوجد في الحل فيذبح في الحرم فقال كان الحسن بن علي وعاءشة وبن عمر يكرهونه
  حدثنا ابو بكر قال حدثنا حفص عن ليث عن عطاء وطاوس انهما كان يكرهان ان يدخل الصيد الحرم ثم يذبح فيه
  حدثنا ابو بكر قال حدثنا ابو داود عن هشام الدستواءي عن ابي الزبير عن جابر انه لم ير باسا بالصيد يصطاده الحلال في الحل ان ياكله الحلال في الحرم قال كان بن عباس يكرهه
  (  ) في الهدي يعطب من قال لا باس ان يبيعه ويستعين بثمنه )
  حدثنا ابو بكر قال حدثنا جرير عن مغيرة عن ابراهيم وليث عن عطاء قال لا باس بالهدي اذا عطب ان يبيعه ويستعين بثمنه في هدي اخر
  (  ) في رجل اهل بعمرة ثم وقع بامراته )
  حدثنا ابو بكر قال حدثنا عبد الاعلي عن معمر عن الزهري انه قال في رجل لبي بعمرة ثم وقع بامراته قبل ان يقضي عمرته قال يعيد عمرة ويهدي بدنة
  حدثنا ابو بكر قال حدثنا محمد بن يزيد عن ابي العلاء عن قتادة في رجل اهل بعمرة ثم وقع باهله قبل ان يطوف بالبيت قال يرجع الي حيث احرم فيحرم من ثم ويهريق دما 
  حدثنا ابو بكر قال حدثنا جرير عن مغيرة عن ابراهيم قال اذا واقع المحرم بعمرة امراته وهي محرمة بعمرة قال يهدي في كل واحد منهما هديا ويمضيان لعمرتهما
  حدثنا ابو بكر قال حدثنا غندر عن شعبة عن قتادة انه سءل عن رجل اهل بعمرة ثم غشي امراته قبل ان يصل الي البيت انه قال يرجعان الي حدهما فيهلان بعمرة ويتفرقان حتي يقضيا العمرة وعليهما هديان
  حدثنا ابو بكر قال حدثنا عبد الاعلي عن هشام عن الحسن وعطاء قالا عليه ان يرجع الي الوقت فيهل بعمرة ويهريق دما
  (  ) من كان يدهن بالزيت )
  حدثنا ابو بكر قال حدثنا شريك عن عمار عن مسلم البطين ان الحسن بن علي كان اذا احرم ادهن بالزيت وادهن اصحابه بالطيب او يدهن بالطيب
  حدثنا ابو بكر قال حدثنا وكيع عن موسي بن عبيدة عن بعض اصحابه عن بن عمر انه كان يدهن بالزيت قبل ان يحرم
  حدثنا ابو بكر قال حدثنا وكيع قال حدثنا سفيان عن منصور عن سعيد بن جبير عن بن عمر انه كان يدهن بالزيت عند الاحرام
  حدثنا ابو بكر قال حدثنا وكيع قال حدثنا قيس عن ابي اسحاق عن الحارث عن علي انه كان يدهن عند الاحرام من الدية يعني بالزيت
  حدثنا ابو بكر قال حدثنا وكيع قال حدثنا حماد بن سلمة عن فرقد السبخي عن سعيد بن جبير عن بن عمر ان النبي صلي الله عليه وسلم كان يدهن بالزيت عند الاحرام غير المقتت يعني الطيب
  (  ) ما يقتل المحرم )
  حدثنا ابو بكر قال حدثنا علي بن مسهر عن عبيد الله بن عمر عن نافع عن بن جبير عن بن عمر قال قال رسول الله صلي الله عليه وسلم خمس من الدواب لا جناح علي من قتلهن وهو حرام الفارة والعقرب والغراب والحداة والكلب العقور
  حدثنا ابو بكر قال حدثنا سلام ابو الاحوص عن زيد بن جبير قال سال رجل بن عمر ما يقتل المحرم من الدواب فقال حدثتني احدي نسوة النبي عن رسول الله صلي الله عليه وسلم  انه امر بقتل الفارة والعقرب والكلب العقور والحداة والغراب
  حدثنا ابو بكر قال حدثنا حاتم بن اسماعيل عن عبد الرحمن بن حرملة قال قال سعيد بن المسيب خمس يقتلهن المحرم العقرب والحية والذءب والغراب والكلب
  حدثنا ابو بكر قال حدثنا معاذ بن معاذ قال حدثنا عمران بن حدير عن منقر ابي بشامة عن بن عباس قال لا باس بقتل الافعي ورمي الحداة قال ابو عبد الرحمن ووجدت في كتابي بشر ابي اسامة بهذا الاسناد وقال يعني المحرم
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن حماد قال سالت ابراهيم يقتل المحرم الفارة قال لا
  حدثنا ابو بكر قال حدثنا وكيع عن بن عون عن القاسم قال الفويسقة
  حدثنا ابو بكر قال حدثنا جرير عن ليث عن مجاهد وعن مغيرة عن ابراهيم قالا لا يقتل المحرم من السباع الا ما عدا عليه
  حدثنا ابو بكر قال حدثنا حفص عن بن جريج عن عطاء قال كل عدو عدا عليك فاقتله وانت محرم
  حدثنا ابو بكر قال حدثنا سلام عن مخارق بن عبد الرحمن عن طارق بن شهاب قال مررت بحيات وانا محرم فقتلتهن بعصا كانت معي فلما اتيت عمر سالته عن قتلهن فقال اقتلهن فانهن عدو
  حدثنا ابو بكر قال حدثنا بن عيينة عن الزهري عن سالم عن بن عمر قال سءل عمر عن قتل الحية وهو محرم فقال اقتلوهن
  حدثنا ابو بكر قال حدثنا وكيع عن اسامة عن نافع قال كنا مع بن عمر ونحن محرمون فراينا حية فبدرنا سالم فقتلها
  حدثنا ابو بكر قال حدثنا بن نمير عن حجاج عن بن ابي نجيح عن مجاهد عن علي في الضبع اذا عدا علي المحرم فيقتله فان قتله من قبل ان يعدو عليه فعليه شاة مسنة
  حدثنا ابو بكر قال حدثنا بن فضيل عن يزيد بن ابي زياد عن بن ابي نعم عن ابي سعيد انه قال يقتل المحرم الحية والعقرب والسبع العاد والكلب العقور والفارة الفويسقة فقيل له لم قيل الفويسقة قال لان النبي صلي الله عليه وسلم استيقظ بها وقد اخذت فتيلة تحرق بها البيت 
  حدثنا ابو بكر قال حدثنا محبوب عن بكير بن عامر عن ابراهيم قال يقتل المحرم الفارة والغراب العقعق
  حدثنا ابو بكر قال حدثنا بن نمير قال حدثنا هشيم عن ابيه عن عاءشة قالت قال رسول الله صلي الله عليه وسلم ليقتل المحرم الفارة والعقرب والحداة والغراب والكلب العقور
  حدثنا ابو بكر قال حدثنا غندر عن شعبة عن قتادة عن سعيد بن المسيب عن عاءشة عن النبي صلي الله عليه وسلم وزادت ويقتل الحية
  حدثنا ابو بكر قال حدثنا عبد الله بن نمير عن حنظلة عن القاسم عن عاءشة قالت سمعته يقول خمس فواسق فاقتلوهن في الحرم الحداة والغراب والكلب العقور والفارة والعقرب
  حدثنا ابو بكر قال حدثنا بن نمير عن حنظلة عن القاسم قال سمعت بن عمير يقول لا جناح عليكم ان تقتلوهن وانتم حرم
  حدثنا ابو بكر قال حدثنا حميد بن عبد الرحمن عن حسن بن صالح عن ابراهيم بن عبد الاعلي عن سويد بن غفلة قال امرنا عمر بقتل الحية والزنبور ونحن محرمون
  (  ) من كان يقول اذا اردت الحج فلا تسم شيءا )
  حدثنا ابو بكر قال حدثنا وكيع عن شعبة عن سلمة بن كهيل عن طاوس قال لا عليك ان لا تسمي حجا ولا عمرة يكفيك النية
  حدثنا ابو بكر قال حدثنا جرير عن مغيرة عن ابراهيم قال اذا اردت ان تحرم فلا تقل شيءا انما عليك ما عقدت عليه بنيتك من حج او عمرة
  حدثنا ابو بكر قال حدثنا ابو معاوية عن عبيد الله عن نافع عن بن عمر قال يكفيك النية في الحج والعمرة اذا اردت ان تحرم
  حدثنا ابو بكر قال حدثنا شريك عن سالم عن سعيد قال حججت مع ناس من اصحاب عبد الله فلم يكونوا يسمون حتي يشارفوا 
  حدثنا ابو بكر قال حدثنا وكيع عن مسعر عن عطاء قال تجزيه النية
  حدثنا ابو بكر قال حدثنا وكيع قال حدثنا سفيان عن اسحاق مولي ال عمر عن سعيد بن جبير قال تكفيه النية
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن منصور عن ابراهيم قال تكفيه النية
  (  ) في المحرم يغسل ثيابه )
  حدثنا ابو بكر قال حدثنا جرير عن ليث عن مجاهد وشهر قالا لا باس ان يغسل المحرم ثيابه ويامر بها ويكرهان ان يغسلها هو
  حدثنا ابو بكر قال حدثنا بن فضيل عن يزيد عن مجاهد عن بن عباس قال لا باس ان يغسل ثيابه
  حدثنا ابو بكر قال حدثنا جرير عن مغيرة عن ابراهيم قال لا باس ان يغتسل المحرم من غير جنابة ويغسل ثيابه
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن منصور عن بن عمر قال ان الله لا يصنع بدرنك شيءا
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن ابي الزبير عن جابر قال لا باس ان يغتسل المحرم ويغسل ثيابه
  حدثنا ابو بكر قال حدثنا بن نمير عن عبد الملك عن عطاء قيل ايغسل المحرم ثيابه قال نعم
  (  ) في الكحل للمحرم والمحرمة )
  حدثنا ابو بكر قال حدثنا عبد الله بن نمير عن عبيد الله عن نافع عن بن عمر قال يكتحل المحرم باي كحل شاء ما لم يكن فيه طيب
  حدثنا ابو بكر قال حدثنا ابو معاوية عن حجاج عن عاءشة ابنة طلحة عن عاءشة ام المءمنين انها كرهت للمحرمة ان تكتحل بالاثمد 
  حدثنا ابو بكر قال حدثنا سلام عن ابي اسحاق عن الضحاك عن بن عباس قال اذا رمد المحرم فليكتحل بشء فيه طيب
  حدثنا ابو بكر قال حدثنا جرير عن منصور قال قلت لمجاهد اتكتحل المحرمة بالاثمد قال لا قلت انه ليس فيه طيب قال انه فيه زينة
  حدثنا ابو بكر قال حدثنا محمد بن عبيد عن محمد بن عبد العزيز عن جابر بن زيد قال تلبس المحرمة ما شاءت من الثياب من شريفها وغريبها ولا تكتحل بالاثمد فكرهه
  حدثنا ابو بكر قال حدثنا بن مهدي قال حدثنا يزيد بن ابراهيم عن قتادة قال سالت امراة عبد الرحمن بن ابي بكر وبن عمر عن امراة محرمة اكتحلت باثمد فامرها عبد الرحمن بن ابي بكر تهريق دما
  حدثنا ابو بكر قال حدثنا بن فضيل عن يزيد عن مجاهد قال لا تكتحل الا من رمد ولا تكتحل بكحل فيه طيب
  (  ) في الرجل يبلغ الوقت وهو مغمي عليه )
  حدثنا ابو بكر قال حدثنا جرير عن مغيرة عن ابراهيم في الرجل يبلغ الوقت وهو مغمي عليه قال يلبي عنه
  حدثنا ابو بكر قال حدثنا حفص عن بن جريج عن عطاء قال يهل عنه
  (  ) في المحرم يهل وعنده الصيد )
  حدثنا ابو بكر قال حدثنا عبد السلام بن حرب عن ليث عن مجاهد ان عليا راي مع بعض اصحابه داجنا من الصيد وهم محرمون فلم يامرهم بارساله
  حدثنا ابو بكر قال حدثنا ابو بكر بن عياش عن ليث عن مجاهد قال اذا احرمت ومعك شء من الصيد فخل سبيله
  حدثنا ابو بكر قال حدثنا ابو بكر بن عياش عن يزيد بن ابي زياد عن عبد الله بن الحارث قال كنا نحج ونترك عند اهلنا اشياء من الصيد ما نرسلها
  حدثنا ابو بكر قال حدثنا حفص قال سالت بن جريج ما كان عطاء يقول في الرجل يخرج وقد خلف في منزله شيءا من الصيد فيصيبه شء قال يضمن 
  حدثنا ابو بكر قال حدثنا بن ادريس عن يزيد عن حسن بن مسلم عن مجاهد عن بن عباس قال اذا احرم وبيده شء من الصيد فليرسله
  حدثنا ابو بكر قال حدثنا عبدة عن سعيد عن ابي معشر عن ابراهيم قال اذا احرم وفي يده طير فليرسله
  (  ) في الصبي والعبد والاعرابي يحج )
  حدثنا ابو بكر قال حدثنا علي بن هاشم عن اسماعيل عن الحسن قال الصبي ان يحج والمملوك ان حج والاعرابي ان حج ثم هاجر الاعرابي واحتلم الصبي واعتق العبد فعليهم الحج
  حدثنا ابو بكر قال حدثنا علي بن هاشم عن اسماعيل عن ابي معشر عن ابراهيم قال ان حج المملوك كذا وكذا ثم اعتق فعليه الحج
  حدثنا ابو بكر قال حدثنا علي بن هاشم عن اسماعيل عن عطاء قال الصبي والعبد عليهما الحج والاعرابي يجزيه حجة لان الحج مكتوب عليه حيث كان ومن حج من الاعراب
  حدثنا ابو بكر قال حدثنا وكيع عن يونس بن ابي اسحاق قال سمع شيخا يحدث ابا اسحاق عن محمد بن كعب القرظي قال قال رسول الله صلي الله عليه وسلم اني اريد ان اجدد في صدور المءمنين ايما صبي حج به اهله ثم مات اجزا عنه فان ادرك فعليه الحج وايما مملوك حج به اهله ثم مات اجزا عنه وان اعتق فعليه الحج
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن ابراهيم ومحمد ابني عقبة عن كريب ان امراة قامت الي النبي صلي الله عليه وسلم بصبي فقالت يا رسول الله الهذا حج قال نعم ولك اجر
  حدثنا ابو بكر قال حدثنا وكيع عن سفيان عن بن جريج عن عطاء قال اعرابي يجزء عنه حجة
  حدثنا ابو بكر قال حدثنا وكيع عن المسعودي عن القاسم بن عبد الرحمن قال كان يقال حجوا بهم صغارا فان ماتوا كانوا قد حجوا وان عاشوا حجوا 
  حدثنا ابو بكر قال حدثنا ابو معاوية عن الاعمش عن ابي ظبيان عن بن عباس قال احفظوا عني ولا تقولوا قال بن عباس ايما عبد حج به اهله ثم اعتق فعليه الحج وايما صبي حج به اهله صبيا ثم ادرك فعليه حجة الرجل وايما اعرابي حج اعرابيا ثم هاجر فعليه حجة المهاجرين
  حدثنا ابو بكر قال حدثنا حفص عن اشعث عن عبد الملك عن بن سيرين قال كانوا يرون اذا حجت وفي بطنها ولد ان له حج
  حدثنا ابو بكر قال حدثنا زيد بن الحباب عن ابراهيم بن نافع عن بن ابي نجيح عن مجاهد قال اذا حج وهو اعرابي اجزات عنه من حجة الاسلام
