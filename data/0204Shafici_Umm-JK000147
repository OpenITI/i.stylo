قبل منهم الجرحة الا بان يبينوا ما يجرحون به مما يراه هو جرحا فان من الشهود من يجرح بالتاويل وبالامر الذي لا جرح في مثله فلا يقبل حتي يثبتوا ما يراه هو جرحا كان الجارح من شاء ان يكون في فقه او فضل واذا شهد الوصي للوارث الكبير علي الميت بدين او صدقة في دار او هبة او شراء فان ابا حنيفة رحمه الله كان يقول لا يجوز ذلك وكان بن ابي ليلي يقول هو جاءز وبه ياخذ ( قال الشافعي ) رحمه الله تعالي واذا مات الرجل فاوصي الي رجل فشهد الوصي لمن لا يلي امره من وارث كبير رشيد او اجنبي او وارث يليه غير الوصي فشهادته جاءزة وليس فيها شء ترد له وكذلك اذا شهد لمن لا يلي امره علي اجنبي واذا شهد الوصي علي غير الميت للوارث الكبير بشء له خاصة فشهادته جاءزة في قولهما جميعا ( قال الشافعي ) وكذلك اذا شهد لمن لا يلي امره علي اجنبي واذا ادعي رجل دينا علي ميت فشهد له شاهدان علي حقه وشهد هو واخر علي وصية ودين لرجل عليه فان ابا حنيفة رضي الله عنه كان يقول شهادتهم جاءزة لان الغريم يضر نفسه بشهادته وبه ياخذ وكان بن ابي ليلي يقول لا تجوز شهادته واذا شهد اصحاب الوصايا بعضهم لبعض لم تجز لانهم شركاء في الوصية الثلث بينهم وقال ابو يوسف اصحاب الوصايا والغرماء سواء لا تجوز شهادة بعضهم لبعض ( قال الشافعي ) رضي الله تعالي عنه واذا كان لرجل دين ببينة علي ميت ثم شهد هو واخر معه لرجل بوصية فشهادتهما جاءزة ولا شء فيها مما ترد له انما ترد بان يجرا الي انفسهما بها وهذان لم يجرا الي انفسهما بها ( قال الشافعي ) رحمه الله تعالي واذا شهد اصحاب الوصايا بعضهم لبعض لم يجز لانهم شركاء في الوصية الثلث بينهم واذا شهد الرجل لامراته فان ابا حنيفة رضي الله عنه كان يقول لا تجوز شهادته لها وكذلك بلغنا عن شريح وبهذا ياخذ وكان بن ابي ليلي يقول شهادته لها جاءزة ( قال الشافعي ) رضي الله تعالي عنه ترد شهادة الرجل لوالديه واجداده وان بعدوا ( ( ( يعدوا ) ) ) من قبل ابيه وامه ولولده وان سفلوا ولا ترد لاحد سواهم زوجة ولا اخ ولا عم ولا خال واذا شهد الرجل علي شهادة وهو صحيح البصر ثم عمي فذهب بصره فان ابا حنيفة  رحمه الله تعالي كان يقول لا تجوز شهادته تلك اذا شهد بها بلغنا عن علي بن ابي طالب رضي الله عنه رد شهادة اعمي شهد عنده وكان بن ابي ليلي يقول شهادته جاءزة وبه ياخذ اذا كان شء لا يحتاج ان يقف عليه ( قال الشافعي ) رحمه الله واذا شهد الرجل وهو بصير ثم ادي الشهادة وهو اعمي جازت شهادته من قبل ان اكثر ما في الشهادة السمع والبصر وكلاهما كان فيه يوم شهد فان قال قاءل ليسا فيه يوم يشهد قيل انما احتجنا الي الشهادة يوم كانت فاما يوم تقام فانما هي تعاد بحكم شء قد اثبته بصيرا ولو رددناها اذا لم يكن بصيرا لانه لا يري المشهود عليه حين يشهد لزمنا ان لا نجيز شهادة بصير علي ميت ولا علي غاءب لان الشاهد لا يري الميت ولا الغاءب والذي يزعم انه لا يجيز شهادته بعد العمي وقد اثبتها بصيرا يجيز شهادة البصير علي الميت والغاءب واذا اقر الرجل بالزني اربع مرات في مقام واحد عند القاضي فان ابا حنيفة رحمه الله كان يقول هذا عندي بمنزلة مرة واحدة ولا حد عليه في هذا وبه ياخذ بلغنا عن رسول الله صلي الله عليه وسلم ان ماعز بن مالك اتاه فاقر عنده بالزني فرده ثم اتاه الثانية فاقر عنده فرده ثم اتاه الثالثة فاقر عنده فرده ثم اتاه الرابعة فاقر عنده فسال قومه هل تنكرون من عقله شيءا قالوا لا فامر به فرجم وبه ياخذ وكان بن ابي ليلي يقيم الحد اذا اقر اربع مرات في مقام واحد ( قال الشافعي ) رحمه الله تعالي واذا اقر الرجل بالزني ووصفه الصفة التي توجب الحد في مجلس اربع مرات فسواء هو والذي اقر به في مجالس متفرقة ان كنا انما احتجنا الي ان يقر اربع مرات قياسا علي اربعة شهود فالذي لم يقم عليه في اربع مرات في مقام واحد واقامها عليه في اربع مرات في مقامات مختلفة ترك اصل قوله لانه يزعم ان الشهود الاربعة لا يقبلون الا في مقام واحد ( قال ) ولو تفرقوا حدهم فكان ينبغي له ان يقول الاقرار اربع مرات في مقام اثبت منه في اربعة مقامات فان قال انما اخذت بحديث ماعز فليس حديث ماعز كما وصف ولو كان كما وصف ان ماعزا اقر في اربعة امكنة متفرقة اربع مرات ما كان قبول اقراره في مجلس اربع مرات خلافا لهذا لانا لم ننظر الي المجالس انما نظرنا الي اللفظ وليس الامر كما قالا جميعا واقراره مرة عند الحاكم يوجب الحد اذا ثبت عليه حتي يرجم الا تري الي قول النبي صلي الله عليه وسلم اغد يا انيس الي امراة هذا فان اعترفت فارجمها وحديث ماعز يدل حين سال ابه جنة انه رده اربع مرات لانكار عقله واذا اقر الرجل بالزني عند غير قاض اربع مرات فان ابا حنيفة رضي الله تعالي عنه كان لا يري ذلك شيءا ولا يحده وبه ياخذ وكان بن ابي ليلي يقول اذا قامت عليه الشهود بذلك احده ( قال الشافعي ) رضي الله عنه واذا اقر الرجل عند غير قاض بالزني فينبغي للقاضي ان لا يرجمه حتي يقر عنده وذلك انه يقر عنده ويقضي برجمه فيرجع فيقبل رجوعه فاذا كان اصل القول في الاقرار هكذا لم ينبغ ان يرجمه حتي يقر عنده وينبغي اذا بعث به ليرجم ان يقول لهم متي رجع فاتركوه بعد وقوع الحجارة وقبلها وما قال النبي صلي الله عليه وسلم في ماعز فهلا تركتموه الا بعد وقوع الحجارة واذا رجع الرجل عن شهادته بالزني وقد رجم صاحبه بها فان ابا حنيفة رضي الله عنه كان يقول يضرب الحد ويغرم ربع الدية وبه ياخذ وكان بن ابي ليلي يقول اقتله فان رجعوا اربعتهم قتلتهم ولا نغرمهم الدية فان رجع ثلاثة في قول ابي حنيفة رحمه الله تعالي ضربوا الحد وغرم كل واحد منهم ربع الدية ( قال الشافعي ) رحمه الله تعالي واذا شهد اربعة علي رجل بالزني فرجم فرجع احدهم عن شهادته ساله القاضي عن رجوعه فان قال عمدت ان اشهد بزور قال له القاضي علمت انك اذا شهدت مع غيرك قتل فان قال نعم دفعه الي اولياء المقتول فان شاءوا قتلوا وان شاءوا عفوا فان قالوا نترك القتل وناخذ الدية كان لهم عليه ربع الدية وعليه الحد في هذا كله وان قال شهدت ولا اعلم ما يكون عليه القتل او غيره  احلف ما عمد القتل وكان عليه ربع الدية والحد وهكذا الشهود معه كلهم اذا رجعوا واذا شهد الشهود عند القاضي علي عبد وحلوه ووصفوه وهو في بلدة اخري فكتب القاضي شهادتهم علي ذلك فان ابا حنيفة رضي الله عنه كان يقول لا اقبل ذلك ولا ادفع اليه العبد لان الحلية قد توافق الحلية وهو ينتفع بالعبد حتي ياتي به الي القاضي الذي كتب له ارايت لو كانت جارية جميلة والرجل غير امين اكنت ابعث بها معه وكان بن ابي ليلي يختم في عنق العبد وياخذ من الذي جاء بالكتاب كفيلا ثم يبعث به الي القاضي فاذا جاءه العبد والكتاب الثاني دعا الشهود فان شهدوا انه عبده ابرا كفيله وقضي بالعبد انه له وكتب له بذلك كتابا الي القاضي الذي اخذ منه الكفيل حتي يبرء ( ( ( يبرء ) ) ) كفيله وبه ياخذ ( قال الشافعي ) رحمه الله تعالي واذا شهد الشهود لرجل علي دابة غاءبة فوصفوها وحلوها فالقياس ان لا يكلف صاحب الدابة ان يدفعها من قبل ان الحلية قد تشبه الحلية واذا ختم القاضي الذي هو ببلده في عنقها وبعث بها الي القاضي المشهود عنده فان زعم ان ضمانها من الذي هي في يديه فقد اخرجها من يديه ولم يبرءه من ضمانها ويقطع عنه منفعتها الي البلد الذي تصير اليه فان لم يثبت عليه الشهود او ماتوا قبل ان تصل الي ذلك البلد فردت اليه كان قد انقطعت منفعتها عنه ولم يعط لها اجارة عوضت تلفا غير مضمون له ولو جعل ضمانها من المدفوعة له وجعل عليه كراءها في مغيبها ان ردت كان قد الزم ضمانها وانما يضمن المتعدي وهذا لم يتعد وانما ذهب بن ابي ليلي وغيره ممن ذهب مذهبه الي ان قال لا سبيل الي اخذ هذه الدابة الا بان يءتي بها الي الشهود او يذهب بالشهود اليها وليس علي الشهود ان يكلفوا الذهاب من بلدانهم والاتيان بالدابة اخف ولرب الدابة في الدابة مثل ما للشهود في انفسهم من ان لا يكلف الخروج بشء لم يستحق عليه وهكذا العبد مثل الدابة وجميع الحيوان واذا شهد الرجل من اهل الكوفة شهادة فعدل ( ( ( بعدل ) ) ) بمكة وكتب بها قاضي مكة الي قاضي مصر في مصر غير مصره بالشهادة وزكي هناك وكتب بذلك الي قاضي الكوفة فشهد قوم من اهل الكوفة ان هذا الشاهد فاسق فان ابا حنيفة رضي الله عنه كان يقول شهادتهم لا تقبل عليه انه فاسق وبه ياخذ وكان بن ابي ليلي يقول ترد شهادته ويقبل قولهم وقال ابو حنيفة رضي الله عنه لا ينبغي للقاضي ان يفعل ذلك لانه قد غاب عن الكوفة سنين فلا يدري ما احدث ولعله قد تاب ( قال الشافعي ) رضي الله عنه واذا شهد الرجلان من اهل مصر بشهادة فعدلا بمكة وكتب قاضي مكة الي قاضي مصر فسال المشهود عليه قاضي مصر ان ياتيه بشهود علي جرحهما فان كان جرحهما بعداوة او ظنة او ما ترد به شهادة العدل قبل ذلك منه وردهما عنه وان جرحهما بسوء حال في انفسهما نظر الي المدة التي قد زايلا فيها مصر وصارا بها الي مكة فان كانت مدة تتغير الحال في مثلها التغير الذي لو كانا بمصرهما مجروحين فتغيرا اليها قبلت شهادتهما قبل القاضي شهادتهما ولم يلتفت الي الجرح لان الجرح متقدم وقد حدثت لهما حال بعد الجرح صارا بها غير مجروحين وان لم تكن اتت عليهما مدة تقبل فيها شهادتهما اذا تغيرا قبل عليهما الجرح وكان اهل بلدهما اعلم بهما ممن عدلهما غريبا او من اهل بلدهما لان الجرح اولي من التعديل ( قال الشافعي ) رحمه الله تعالي قال الله عز وجل @QB@ واشهدوا ذوي عدل منكم @QE@ وقال ممن ترضون من الشهداء ( اخبرنا الربيع ) قال ( اخبرنا الشافعي ) قال اخبرنا مسلم بن خالد عن بن ابي نجيح عن مجاهد انه قال عدلان حران مسلمان ثم لم اعلم من اهل العلم مخالفا في ان هذا معني الاية واذا لم يختلفوا فقد زعموا ان الشهادة لا تتم الا باربع ان يكون الشاهدان حرين مسلمين عدلين بالغين وان عبدا لو كان مسلما عدلا لم تجز شهادته بانه ناقص الحرية وهي احد الشروط الاربعة فاذا زعموا هذا فنقص الاسلام اولي ان لا تجوز معه الشهادة من نقص الحرية فان زعموا ان هذه الاية التي جمعت هذه الاربع الخصال حتم ان لا يجوز من الشهود  الا من كانت فيه هذه الخصال الاربعة المجتمعة فقد خالفوا ما زعموا من معني كتاب الله حين اجازوا شهادة كافر بحال وان زعموا انها دلالة وانها غير مانعة ان يجوز غير من جمع هذه الشروط الاربعة فقد ظلموا من اجاز شهادة العبيد وقد سالتهم فكان اعلي من زعموا انه اجاز شهادة اهل الذمة بعضهم علي بعض شريح وقد اجاز شريح شهادة العبد ( ( ( العبيد ) ) ) فقال له المشهود عليه اتجيز علي شهادة عبد فقال قم فكلكم سواء عبيد واماء فان زعم انه يخالف شريحا لقول اهل التفسير ان في الاية شرط الحرية فليس في الاية بعينها بيان الحرية وهي محتملة لها وفي الاية بيان شرط الاسلام فلم وافق شريحا مرة وخالفه اخري وقد كتبنا هذا في كتاب الاقضية ولا تجوز شهادة ذكر ولا انثي في شء من الدنيا لاحد ولا علي احد حتي يكون بالغا عاقلا حرا مسلما عدلا ولا تجوز شهادة ذمي ولا من خالف ما وصفنا بوجه من الوجوه واذا شهد الشاهدان من اليهود علي رجل من النصاري وشهد شاهدان من النصاري علي رجل من اليهود فان ابا حنيفة رضي الله تعالي عنه كان يقول ذلك جاءز لان الكفر كله ملة واحدة وبه ياخذ وكان بن ابي ليلي لا يجيز ذلك ويقول لانهما ملتان مختلفتان وكان ابو حنيفة يورث اليهودي من النصراني والنصراني من اليهودي ويقول اهل الكفر بعضهم من بعض وان اختلفت مللهم وبه ياخذ وكان بن ابي ليلي لا يورث بعضهم من بعض ( قال الشافعي ) رحمه الله تعالي واذا تحاكم اهل الملل الينا فحكمنا بينهم لم يورث مسلما من كافر ولا كافرا من مسلم وورثنا الكفار بعضهم من بعض فنورث اليهودي النصراني والنصراني اليهودي ونجعل الكفر ملة واحدة كما جعلنا الاسلام ملة لان الاصل انما هو ايمان او كفر واذا شهد الشهود عند قاضي الكوفة علي عبد وحلوه ووصفوه انه لرجل فان ابا حنيفة رحمه الله تعالي قال لا اكتب له وقال بن ابي ليلي اكتب شهادتهم الي قاضي البلد الذي فيه العبد فيجمع القاضي الذي العبد في بلده بين الذي جاء بالكتاب وبين الذي عنده العبد فان كان للذي عنده العبد حجة والا بعث بالعبد مع الرجل الذي جاء بالكتاب مختوما في عنقه واخذ منه كفيلا بقيمته ويكتب الي القاضي بجواب كتابه بذلك فيجمع قاضي الكوفة بين البينة وبين العبد حتي يشهدوا عليه بعينه ثم يرده مع الذي جاء به الي قاضي البلد الذي كان فيه العبد حتي يجمع بينه وبين خصمه ثم يمضي عليه القضاء ويبرا كفيله وبه ياخذ قال ابو يوسف رحمه الله تعالي ما لم تجء ( ( ( تجء ) ) ) تهمة او امر يستريبه من الغلام واذا سافر الرجل المسلم فحضره الموت فاشهد علي وصيته رجلين من اهل الكتاب فان ابا حنيفة رحمه الله تعالي كان يقول لا تجوز شهادتهما وبه ياخذ لقول الله عز وجل @QB@ واشهدوا ذوي عدل منكم @QE@ وكان بن ابي ليلي يقول ذلك جاءز ( قال الشافعي ) رحمه الله تعالي واذا سافر المسلم فاشهد علي وصيته ذميين لم نقبلهما لما وصفنا من شرط الله عز وجل في الشهود وكان ابو حنيفة رحمه الله تعالي لا يري علي شاهد الزور تعزيرا غير انه يبعث به الي سوقه ان كان سوقيا والي مسجد قومه ان كان من العرب فيقول القاضي يقرءكم السلام ويقول انا وجدنا هذا شاهد زور فاحذروه وحذروه الناس وذكر ذلك ابو حنيفة عن القاسم عن شريح وكان بن ابي ليلي يقول عليه التعزير ولا يبعث به ويضربه خمسة وسبعين سوطا قال ابو يوسف رحمه الله اعزره ولا ابلغ به اربعين سوطا ويطاف به وقال ابو يوسف بعد ذلك ابلغ به خمسة وسبعين سوطا ( قال الشافعي ) رحمه الله تعالي واذا اقر الرجل بان قد شهد بزور او علم القاضي يقينا انه قد شهد بزور عزره ولا يبلغ به اربعين ويشهر بامره فان كان من اهل المسجد وقفه في المسجد وان كان من اهل القبيلة وقفه في قبيلته وان كان سوقيا وقفه في سوقه وقال انا وجدنا هذا شاهد زور فاعرفوه واحذروه واذا امكن بحال ان لا يكون شاهد زور او شبه عليه بما يغلط به  مثله قيل له لا تقدمن علي شهادة الا بعد اثبات ولم يعزره واذا شهد شاهدان لرجل علي رجل بحق فاكذبهما المشهود له ردت شهادتهما لانه ابطل حقه في شهادتهما ولم يعزرا ولا واحد منهما لانا لا ندري ايهما الكاذب فاما الاولان فقد يمكن ان يكونا صادقين والذي اكذبهما كاذب فاذا امكن ان يصدق احدهما ويكذب الاخر لم يعزر واحد منهما من قبل انا لا ندري ايهما الكاذب ( قال الشافعي ) رحمه الله تعالي وكذلك لو شهد رجلان لرجل باكثر مما ادعي لم يعزرا لانه قد يمكن ان يكونا ( ( ( يكون ) ) ) صادقين واذا اختلف الشاهدان في الموطن الذي شهدا فيه فان ابا حنيفة رضي الله عنه كان يقول لا نعزرهما ويقول لاني لا ادري ايهما الصادق من الكاذب اذا كانا شهدا علي فعل فان كانا شهدا علي اقرار فانه كان يقول لا ادري لعلهما صادقان جميعا وان اختلفا في الاقرار وبه ياخذ وكان بن ابي ليلي يرد الشاهدين وربما ضربهما وعاقبهما وكذلك لو خالف المدعي الشاهدين في قول ابي حنيفة رحمه الله فشهدا باكثر مما ادعي فان ابا حنيفة رحمه الله كان يقول لا نضربهما ونتهم المدعي عليهما وكان بن ابي ليلي ربما عزرهما وضربهما وربما لم يفعل ( قال الشافعي ) رضي الله عنه لا نعزرهما اذا امكن صدقهما واذا لم يطعن الخصم في الشاهد فان ابا حنيفة رضي الله عنه كان يقول لا يسال عن الشاهد وكان بن ابي ليلي يقول يسال عنه وبهذا ياخذ وكان ابو حنيفة رحمه الله لا يجيز شهادة الصبيان بعضهم علي بعض وبه ياخذ وكان بن ابي ليلي يجيز شهادة الصبيان بعضهم علي بعض ( قال الشافعي ) رحمه الله تعالي ولا يقبل القاضي شهادة شاهد حتي يعرف عدله طعن فيه الخصم او لم يطعن ولا تجوز شهادة الصبيان بعضهم علي بعض في الجراح ولا غيرها قبل ان يتفرقوا ولا بعد ان يتفرقوا لانهم ليسوا من شرط الله الذي شرطه في قوله @QB@ ممن ترضون من الشهداء @QE@ وهذا قول بن عباس رضي الله عنهما وخالفه بن الزبير وقال نجيز شهادتهم اذا لم يتفرقوا وقول بن عباس رضي الله عنهما اشبه بالقران والقياس لا اعرف شاهدا يكون مقبولا علي صبي ولا يكون مقبولا علي بالغ ويكون مقبولا في مقامه ومردودا بعد مقامه والله سبحانه وتعالي الموفق
   * باب في الايمان
  * ( قال الشافعي ) رحمه الله تعالي واذا ادعي الرجل علي الرجل دعوي وجاء بالبينة فان ابا حنيفة رضي الله عنه كان يقول لا نري عليه يمينا مع شهوده ومن حجته في ذلك انه قال بلغنا عن رسول الله صلي الله عليه وسلم انه قال اليمين علي المدعي عليه والبينة علي المدعي فلا نجعل علي المدعي ما لم يجعل عليه رسول الله صلي الله عليه وسلم لا تحول اليمين عن الموضع الذي وضعها عليه النبي صلي الله عليه وسلم وبه ياخذ وكان بن ابي ليلي يقول علي المدعي اليمين مع شهوده واذا لم يكن له شهود لم يستحلفه وجعل اليمين علي المدعي عليه فان قال المدعي عليه انا ارد اليمين عليه فانه لا يرد اليمين عليه الا ان يتهمه فيرد اليمين عليه اذا كان كذلك وهذا في الدين ( قال الشافعي ) رحمه الله تعالي واذا جاء الرجل بشاهدين علي رجل بحق فلا يمين عليه مع شاهديه ولو جعلنا عليه اليمين مع شاهديه لم يكن لاحلافنا مع الشاهد معني وكان خلافا لقول النبي صلي الله عليه وسلم البينة علي المدعي واليمين علي المدعي عليه واذا ادعي رجل علي رجل دعوي ولا بينة له احلفنا المدعي عليه فان حلف برء وان نكل قلنا لصاحب الدعوي لسنا نعطيك ينكوله ( ( ( بنكوله ) ) ) شيءا الا ان تحلف مع نكوله فان حلفت اعطيناك وان امتنعت لم نعطك ولهذا كتاب في كتاب الاقضية واذا ورث الرجل ميراثا دارا او ارضا او غير ذلك فادعي رجل فيها دعوي ولم تكن له بينة فاراد ان يستحلف الذي ذلك في يديه فان ابا حنيفة رضي الله عنه كان يقول اليمين علي علمه انه لا يعلم لهذا فيه حقا وكذلك كان بن ابي ليلي يقول ايضا  وانما جعل ابو حنيفة رضي الله عنه علي هذا اليمين علي علمه لان الميراث لزمه ان شاء وان ابي والبيع لا يلزمه الا بقبول واذا كان الشء لا يلزمه الا بفعله وقبول منه مثل البيع والهبة والصدقة فاليمين في ذلك البتة والميراث لو قال لا اقبله كان قوله ذلك باطلا وكان الميراث له لازما فلذلك كانت اليمين علي علمه في الميراث وبه ياخذ وكان بن ابي ليلي يقول اليمين عليه علي علمه في جميع ما ذكرت لك من بيع وغير ذلك ( قال الشافعي ) رحمه الله تعالي واذا ورث الرجل دارا او غيرها فادعي رجل فيها دعوي سالناه عن دعواه فان ادعي شيءا كان في يدي الميت احلفنا الوارث علي علمه ما يعلم له فيها حقا ثم ابراناه وان ادعي فيها شيءا كان في يدي الوارث احلفناه علي البت نحلفه في كل ما كان في يديه علي البت وما كان في يدي غيره فورثه علي العلم واذا استحلف المدعي عليه علي دعواه فحلفه القاضي علي ذلك ثم اتي بالبينة بعد ذلك علي تلك الدعوي فان ابا حنيفة رحمه الله كان يقبل منه ذلك لانه بلغنا عن عمر بن الخطاب رضي الله عنه وشريح انهما كانا يقولان اليمين الفاجرة احق ان ترد من البينة العادلة وبهذا ياخذ وكان بن ابي ليلي يقول لا اقبل منه البينة بعد اليمين وبعد فصل القضاء ( قال الشافعي ) رحمه الله تعالي واذا ادعي الرجل علي الرجل الدعوي ولم يات عليه ببينة واحلفه القاضي فحلف ثم جاء المدعي ببينة قبلتها وقضيت له بها ولم امنع البينة العادلة التي حكم المسلمون بالاعطاء بها باليمين الفاجرة
   * باب الوصايا
  * واذا اوصي الرجل للرجل بسكني دار او بخدمة عبد او بغلة بستان او ارض وذلك ثلثه او اقل فان ابا حنيفة رضي الله عنه كان يقول ذلك جاءز وبه ياخذ وكان بن ابي ليلي يقول لا يجوز ذلك والوقت في ذلك وغير الوقت في قول بن ابي ليلي سواء ( قال الشافعي ) رضي الله عنه واذا اوصي الرجل للرجل بغلة داره او ثمرة بستانه والثلث يحمله فذلك جاءز واذا اوصي له بخدمة عبده والثلث يحمل العبد فذلك جاءز وان لم يحمل الثلث العبد جاز له منه ما حمل الثلث ورد ما لم يحمل واذا اوصي الرجل للرجل باكثر من ثلثه فاجاز ذلك الورثة في حياته وهم كبار ثم ردوا ذلك بعد موته فان ابا حنيفة رضي الله عنه كان يقول لا تجوز عليهم تلك الوصية ولهم ان يردوها لانهم اجازوا وهم لا يملكون الاجازة ولا يملكون المال وكذلك بلغنا عن عبد الله بن مسعود رضي الله عنه وشريح وبهذا ياخذ وكان بن ابي ليلي يقول اجازتهم جاءزة عليهم لا يستطيعون ان يرجعوا الي شء منها ولو اجازوها بعد موته ثم ارادوا ان يرجعوا فيها قبل ان تنفذ الوصية لم يكن ذلك لهم وكانت اجازتهم جاءزة في هذا الموضع في قولهما جميعا ( قال الشافعي ) رحمه الله تعالي واذا اوصي الرجل للرجل باكثر من ثلث ماله فاجاز ذلك الورثة وهو حي ثم ارادوا الرجوع فيه بعد ان مات فذلك جاءز لهم لانهم اجازوا ما لم يملكوا ولو مات فاجازوها بعد موته ثم ارادوا الرجوع قبل القسم لم يكن ذلك لهم من قبل انهم اجازوا ما ملكوا فاذا اجازوا ذلك قبل موته كانت الوصية وصاحبهم مريض او صحيح كان لهم الرجوع لانهم في الحالين جميعا غير مالكين اجازوا ما لم يملكوا ( قال ) واذا اوصي رجل بثلث ماله لرجل وبماله كله لاخر فرد ذلك الورثة كله الي الثلث فان ابا حنيفة رضي الله عنه كان يقول الثلث بينهما نصفان لا يضرب صاحب الجميع بحصة الورثة من المال وكان بن ابي ليلي يقول الثلث بينهما علي اربعة اسهم يضرب صاحب المال بثلاثة اسهم ويضرب صاحب الثلث بسهم واحد وبه ياخذ ( قال الشافعي ) رحمه الله تعالي واذا اوصي الرجل لرجل بثلث ماله ولاخر بماله كله ولم يجز ذلك الورثة اقسم الوصية علي اربعة  اسهم لصاحب الكل ثلاثة ولصاحب الثلث واحد قياسا علي عول الفراءض ومعقول في الوصية انه اراد هذا بثلاثة وهذا بواحد
   * باب المواريث
  * ( اخبرنا الربيع ) قال ( قال الشافعي ) رحمه الله تعالي واذا مات الرجل وترك اخاه لابيه وامه وجده فان ابا حنيفة رحمه الله تعالي كان يقول المال كله للجد وهو بمنزلة الاب في كل ميراث وكذلك بلغنا عن ابي بكر الصديق وعن عبد الله بن عباس وعن عاءشة ام المءمنين وعن عبد الله بن الزبير رضي الله تعالي عنهم انهم كانوا يقولون الجد بمنزلة الاب اذا لم يكن له اب وكان بن ابي ليلي يقول في الجد بقول علي بن ابي طالب رضي الله عنه للاخ النصف وللجد النصف وكذلك قال زيد بن ثابت وعبد الله بن مسعود في هذه المنزلة ( قال الشافعي ) رحمه الله تعالي واذا هلك الرجل وترك جده واخاه لابيه وامه فالمال بينهما نصفان وهكذا قال زيد بن ثابت وعلي وعبد الله بن مسعود وروي عن عثمان رضي الله عنهم وخالفهم ابو بكر الصديق رضي الله عنه فجعل المال للجد وقالته معه عاءشة وبن عباس وبن الزبير وعبد الله بن عتبة رضي الله عنهم وهو مذهب اهل الكلام في الفراءض وذلك انهم يتوهمون انه القياس وليس واحد من القولين بقياس غير ان طرح الاخ بالجد ابعد من القياس من اثبات الاخ معه وقد قال بعض من يذهب هذا المذهب انما طرحنا الاخ بالجد لثلاث خصال انتم مجتمعون معنا عليها انكم تحجبون به بني الام وكذلك منزلة الاب ولا تنقصونه من السدس وكذلك منزلة الاب وانكم تسمونه ابا ( قال الشافعي ) رحمه الله تعالي قلت انما حجبنا به بني الام خبرا لا قياسا علي الاب قال وكيف ذلك قلت نحن نحجب بني الام ببنت بن ابن متسفلة وهذه وان وافقت منزلة الاب في هذا الموضع فلم نحكم لها نحن وانت بان تكون تقوم مقام الاب في غيره واذا وافقه في معني وان خالفه في غيره واما ان لا ننقصه من السدس فانا لم ننقصه خبرا ونحن لا ننقص الجدة من السدس افرايتنا واياك اقمناها مقام الاب ان وافقته في معني واما اسم الابوة فنحن وانت نلزم من بيننا وبين ادم اسم الابوة واذا كان ذلك ودون احدهم اب اقرب منه لم يرث وكذلك لو كان كافرا والموروث مسلما او قاتلا والموروث مقتولا او كان الموروث حرا والاب مملوكا فلو كان انما ورثنا باسم الابوة فقط ورثنا هءلاء الذين حرمناهم كلهم ولكنا انما ورثناهم خبرا لا بالاسم قال فاي القولين اشبه بالقياس قلت ما فيهما قياس والقول الذي اخترت ابعد من القياس والعقل قال فاين ذلك قلت ارايت الجد والاخ اذا طلبا ميراث الميت ايدليان بقرابة انفسهما ام بقرابة غيرهما قال وما ذلك قلت اليس انما يقول الجد انا ابو ابي الميت ويقول الاخ انا بن ابي الميت قال بلي قلت فبقرابة ابي الميت يدليان معا الي الميت قلت فاجعل ابا الميت هو الميت ايهما اولي بكثرة ميراثه ابنه او ابوه قال بل ابنه لان له خمسة اسداس ولابيه السدس قلت فكيف حجبت الاخ بالجد والاخ اذا مات الاب اولي بكثرة ميراثه من الجد لو كنت حاجبا احدهما بالاخر انبغي ان تحجب الجد بالاخ قال وكيف يكون القياس فيه قلت لا معني للقياس فيهما معا يجوز ولو كان له معني انبغي ان نجعل للاخ ابدا حيث كان مع الجد خمسة اسداس وللجد السدس وقلت ارايت الاخوة امثبتي الفرض في كتاب الله قال نعم قلت فهل للجد في كتاب الله فرض قال لا قلت وكذلك السنة هم مثبتون فيها ولا اعلم للجد في السنة فرضا الا من وجه واحد لا يثبته اهل الحديث كل التثبيت فلا اعلمك الا طرحت الاقوي من كل وجه بالاضعف واذا اقرت الاخت وهي لاب وام وقد ورث معها العصبة باخ لاب فان ابا حنيفة رضي الله عنه كان يقول نعطيه نصف ما في يدها لانها اقرت ان المال كله بينهما نصفان فما كان في يدها منه فهو بينهما نصفان  وبه ياخذ وكان بن ابي ليلي يقول لا نعطيه مما في يدها شيءا لانها اقرت بما في يدي العصبة (  ) وهو سواء في الورثة كلهم ما قالا جميعا ( قال الشافعي ) واذا مات الرجل وترك اخته لابيه وامه وعصبته فاقرت الاخت باخ فالقياس انه لا ياخذ شيءا وهكذا كل من اقر به وهو وارث فكان اقراره لا يثبت نسبه فالقياس ان لا ياخذ شيءا من قبل انه انما اقر له بحق عليه في ذلك الحق مثل الذي اقر له به لانه اذا كان وارثا بالنسب كان موروثا به واذا لم يثبت النسب حتي يكون موروثا به لم يجز ان يكون وارثا به وذلك مثل الرجل يقر انه باع داره من رجل بالف فجحده المقر له بالبيع لم نعطه الدار وان كان باءعها قد كان اقر بانها قد صارت ملكا له وذلك انه لم يقر انها كانت ملكا له الا وهو مملوك عليه بها شء فلما سقط ان تكون مملوكة عليه سقط الاقرار له وذلك مثل الرجلين يتبايعان العبد فيختلفان في ثمنه وقد تصادقا علي انه قد خرج من ملك المالك الي ملك المشتري فلما لم يسلم للمشتري ما زعم انه ملكه به سقط الاقرار فلا يجوز ان يثبت للمقر له بالنسب حق وقد احطنا انه لم يقر له به من دين ولا وصية ولا حق علي المقر له الا الميراث الذي اذا ثبت له ثبت ان يكون موروثا به واذا لم يثبت له ان يكون موروثا بالنسب لم يثبت له ان يكون وارثا به واذا مات الرجل وترك امراة وولدها ولم يقر بحبل امراته ثم جاءت بولد بعد موته وجاءت بامراة تشهد علي الولادة فان ابا حنيفة رحمه الله تعالي كان يقول لا اقبل هذا ولا اثبت نسبه ولا اورثه بشهادة امراة وكان بن ابي ليلي يقول اثبت نسبه واورثه بشهادتها وحدها وبه ياخذ ( قال الشافعي ) رحمه الله تعالي واذا مات الرجل وترك ولدا وزوجة فولدت فانكر ابنه ولدها فجاءت باربع نسوة يشهدن بانها ولدته كان نسبه ثابتا وكان وارثا ولا اقبل فيه اقل من اربع نسوة قياسا علي القران لان الله عز وجل ذكر شاهدين وشاهدا وامراتين فاقام امراتين حيث اجازهما مقام رجل فلما اجزنا النساء فيما يغيب عنه الرجال لم يجز ان نجيز منهن الا اربعا قياسا علي ما وصفت وجملة هذا القول قول عطاء بن ابي رباح واذا كان للرجل عبدان ولدا في ملكه كل واحد منهما من امه فاقر في صحته ان احدهما ابنه ثم مات ولم يبين ذلك فان ابا حنيفة رحمه الله تعالي كان يقول لا يثبت نسب واحد منهما ويعتق من كل منهما نصفه ويسعي في نصف قيمته وكذلك امهاتهما وبه ياخذ وكان بن ابي ليلي يثبت نسب احدهما ويرثان ميراث بن ويسعي كل واحد منهما في نصف قيمته وكذلك امهاتهما ( قال الشافعي ) رحمه الله تعالي واذا كان لرجل امتان لا زوج لواحدة منهما فولدتا ولدين فاقر السيد بان احدهما ابنه ومات ولا يعرف ايهما اقر به فانا نريهما القافة فان الحقوا به احدهما جعلناه ابنه وورثناه منه وجعلنا امه ام ولد تعتق بموته وارققنا الاخر وان لم تكن قافة او كانت فاشكل عليهم لم نجعل ابنه واحدا منهما واقرعنا بينهما فايهما خرج سهمه اعتقناه وامه بانها ام ولد وارققنا الاخر وامه واصل هذا مكتوب في كتاب العتق واذا كانت الدار في يدي رجل فاقام بن عم له البينة انها دار جدهما والذي هي في يديه منكر لذلك فان ابا حنيفة رضي الله عنه كان يقول لا اقضي بشهادتهم حتي يشهدوا ان الجد تركها ميراثا لابيه ولابي صاحبه لا يعلمون له وارثا غيرهما ثم توفي ابو هذا وترك نصيبه منها ميراثا لهذا لا يعلمون له وارثا غيره وكان بن ابي ليلي يقول اقضي له بشهادتهم واسكنه في الدار مع الذي هي في يديه ولا يقتسمان حتي تقوم البينة علي المواريث كما وصفت لك في قول ابي حنيفة ولا يقولان لا نعلم في قول بن ابي ليلي لكن يقولان لا وارث له غيرهما في قول بن ابي ليلي وقال ابو يوسف اسكنه ولا يقتسمان ( قال الشافعي ) رحمه الله تعالي واذا كانت الدار في يدي الرجل فاقام بن عمه البينة انها دار جدهما ابي ابيهما  ولم تقل البينة اكثر من ذلك والذي في يديه الدار ينكر قضيت بها دارا لجدهما ولم اقسمها بينهما حتي تثبت البينة علي من ورث جدهما ومن ورث اباهما لاني لا ادري لعل معهما ورثة او اصحاب دين او وصايا واقبل البينة اذا قالوا مات جدهما وتركها ميراثا لا وارث له غيرهما ولا يكونون بهذا شهودا علي ما لا يعلمون لانهم في هذا كله انما يشهدون علي الظاهر كشهادتهم علي النسب وكشهادتهم علي الملك وكشهادتهم علي العدل ولا اقبلهم اذا قالوا لا نعلم وارثا غير فلان وفلان الا ان يكونوا من اهل الخبرة بالمشهود عليه الذين يكون الاغلب منهم انه لا يخفي عليهم وارث لو كان له وذلك ان يكونوا ذوي قرابة او مودة او خلطة او خبرة بجوار او غيره فاذا كانوا هكذا قبلتهم علي العلم لان معني البت معني العلم ومعني العلم معني البت واذا توفي الرجل وترك امراته وترك في بيته متاعا فان ابا حنيفة رضي الله عنه كان يحدث عن حماد عن ابراهيم انه قال ما كان للرجال من المتاع فهو للرجل وما كان للنساء فهو للمراة وما كان للرجال والنساء فهو للباقي منهما المراة كانت او الرجل وكذلك الزوج اذا طلق والباقي الزوج في الطلاق وبه كان ياخذ ابو حنيفة وابو يوسف ثم قال بعد ذلك لا يكون للمراة الا ما يجهز به مثلها في ذلك كله لانه يكون رجل تاجر عنده متاع النساء من تجارته او صانع او تكون رهونا عند رجل وكان بن ابي ليلي يقول اذا مات الرجل او طلق فمتاع البيت كله متاع الرجل الا الدرع والخمار وشبهه الا ان تقوم لاحدهما بينة علي دعواه ولو طلقها في دارها كان امرهما علي ما وصفت في قولهما جميعا ( قال الشافعي ) واذا اختلف الزوجان في متاع البيت يسكنانه قبل ان يتفرقا او بعد ما تفرقا كان البيت للمراة او الرجل او بعد ما يموتان واختلفت في ذلك ورثتهما بعد موتهما او ورثة الميت منهما والباقي كان الباقي الزوج او الزوجة فسواء ذلك كله فمن اقام البينة علي شء من ذلك فهو له ومن لم يقم بينة فالقياس الذي لا يعذر احد عندي بالغفلة عنه علي الاجماع ان هذا المتاع في ايديهما معا فهو بينهما نصفان كما يختلف الرجلان في المتاع بايديهما جميعا فيكون بينهما نصفين بعد الايمان فان قال قاءل فكيف يكون للرجل النضوح والخلوق والدرع ( ( ( والدروع ) ) ) والخمر ويكون للمراة السيف والرمح والدرع قيل قد يملك الرجال متاع النساء والنساء متاع الرجال ارايت لو اقام الرجل البينة علي متاع النساء والمراة البينة علي متاع الرجال اليس يقضي لكل بما اقام عليه البينة فاذا قال بلي قيل افليس قد زعمت وزعم الناس ان كينونة الشء في يدي المتنازعين تثبت لكل النصف فان قال بلي قيل كما تثبت له البينة فان قال بلي قيل فلم لم تجعل الزوجين هكذا وهي في ايديهما فان استعملت عليهم الظنون وتركت الظاهر قيل لك فما تقول في عطار ودباغ في ايديهما عطر ومتاع الدباغ تداعياه معا فان زعمت انك تعطي الدباغ متاع الدباغين والعطار متاع العطارين قيل فما تقول في رجل غير موسر ورجل موسر تداعيا ياقوتا ولءلءا فان زعمت انك تجعله للموسر وهو بايديهما معا خالفت مذهب العامة وان زعمت انك تقسمه بينهما ولا تستعمل عليهما الظن فهكذا ينبغي لك ان تقول في متاع الرجل والمراة ( قال ) واذا اسلم الرجل علي يدي الرجل ووالاه وعاقده ثم مات ولا وارث له فان ابا حنيفة رحمه الله تعالي كان يقول ميراثه له بلغنا ذلك عن رسول الله صلي الله عليه وسلم وعن عمر بن الخطاب رضي الله عنه وعن بن مسعود رضي الله عنه وبهذا ياخذ وكان بن ابي ليلي لا يورثه شيءا مطرف عن الشعبي انه قال لا ولاء الا لذي نعمة الليث بن ابي سليم عن ابي الاشعث الصنعاني عن عمن عمر بن الخطاب رضي الله عنه انه سءل عن الرجل يسلم علي يدي الرجل فيموت ويترك مالا فهو له وان ابي فلبيت المال ابو حنيفة رحمه الله تعالي عن ابراهيم بن محمد عن ابيه عن مسروق ان رجلا من اهل الارض والي بن عم له فمات وترك مالا فسالوا بن مسعود عن ذلك  فقال ماله له ( قال الشافعي ( ( ( فالشافعي ) ) ) ) رحمه الله تعالي واذا اسلم الرجل علي يدي رجل ووالاه ثم مات لم يكن له ميراثه من قبل قول النبي صلي الله عليه وسلم فانما الولاء لمن اعتق وهذا يدل علي معنيين احدهما ان الولاء لا يكون الا لمن اعتق والاخر انه لا يتحول الولاء عمن اعتق وهذا مكتوب في كتاب الولاء
   * باب في الاوصياء
  * ( قال الشافعي ) رحمه الله ولو ان رجلا اوصي الي رجل فمات الموصي اليه فاوصي الي اخر فان ابا حنيفة رضي الله تعالي عنه كان يقول هذا الاخر وصي الرجلين جميعا وبهذا ياخذ وكذلك بلغنا عن ابراهيم وكان بن ابي ليلي رحمه الله تعالي يقول هذا الاخر وصي الذي اوصي اليه ولا يكون وصيا للاول الا ان يكون الاخر اوصي اليه بوصية الاول فيكون وصيهما جميعا وقال ابو يوسف رحمه الله تعالي بعد لا يكون وصيا للاول الا ان يقول الثاني قد اوصيت اليك في كل شء او يذكر وصية الاخر ( قال الشافعي ) رحمه الله واذا اوصي الرجل الي رجل ثم حضرت الوصي الوفاة فاوصي بماله وولده ووصية الذي اوصي اليه الي رجل اخر فلا يكون الاخر بوصية الاوسط وصيا للاول ويكون وصيا للاوسط الموصي اليه وذلك ان الاول رضي بامانة الاوسط ولم يرض امانة الذي بعده والوصي اضعف حالا في اكثر امره من الوكيل ولو ان رجلا وكل رجلا بشء لم يكن للوكيل ان يوكل غيره بالذي وكله به ليستوجب الحق ولو كان الميت الاول اوصي الي الوصي ان لك ان توصي بما اوصيت به اليك الي من رايت فاوصي الي رجل بتركة نفسه لم يكن وصيا للاول ولا يكون وصيا للاول حتي يقول قد اوصيت اليك بتركة فلان فيكون حينءذ وصيا له ولو ان وصيا لايتام تجر لهم باموالهم او دفعها مضاربة فان ابا حنيفة رضي الله عنه كان يقول هو جاءز عليهم ولهم بلغنا ذلك عن ابراهيم النخعي وكان بن ابي ليلي يقول لا تجوز عليهم والوصي ضامن لذلك وقال بن ابي ليلي ايضا علي اليتامي الزكاة في اموالهم فان اداها الوصي عنهم فهو ضامن وقال ابو حنيفة رضي الله عنه ليس علي يتيم زكاة حتي يبلغ الا تري انه لا صلاة عليه ولا فريضة عليه وبهذا ياخذ ( قال الشافعي ) رضي الله عنه واذا كان الرجل وصيا بتركة ميت يلي اموالهم كان احب الي ان يتجر لهم بها لم تكن التجارة بها عندي تعديا واذا لم تكن تعديا لم يكن ضامنا ان تلفت وقد اتجر عمر بن الخطاب رضي الله عنه بمال يتيم كان يليه وكانت عاءشة رضي الله تعالي عنها تبضع باموال بني محمد بن ابي بكر في البحر وهم ايتام وتليهم وتءدي منها الزكاة وعلي ولي اليتيم ان يءدي الزكاة عنه في جميع ماله كما يءديها عن نفسه لا فرق بينه وبين الكبير البالغ فيما يجب عليهما كما علي ولي اليتيم ان يعطي من مال اليتيم ما لزمه من جناية لو جناها او نفقة له من صلاحه ( قال الشافعي ) رحمه الله تعالي اخبرنا عبد المجيد بن عبد العزيز عن معمر بن راشد عن ايوب بن ابي تميمة عن محمد بن سيرين ان عمر بن الخطاب رضي الله عنه قال لرجل ان عندنا مالا ليتيم قد اسرعت فيه الزكاة وذكر انه دفعه الي رجل يتجر فيه ( قال الشافعي ) رحمه الله تعالي اما قال مضاربة واما قال بضاعة وقال بعض الناس لا زكاة في مال اليتيم الناض وفي زرعه الزكاة وعليه زكاة الفطر تءدي عنه وجناياته التي تلزم من ماله واحتج بانه لا صلاة عليه وانه لو كان سقوط الصلاة عنه يسقط عنه الزكاة كان قد فارق قوله اذ زعم ان عليه زكاة الفطر وزكاة الزرع وقد كتب هذا في كتاب الزكاة ( قال ) ولو ان وصي ميت ورثته كبار وصغار ولا دين علي الميت ولم يوص بشء باع عقارا من عقار الميت فان ابا حنيفة رحمه الله تعالي كان يقول في ذلك بيعه جاءز علي الصغار والكبار وكان بن ابي ليلي يقول يجوز علي الصغار والكبار اذا كان ذلك مما لا بد منه وقال ابو يوسف رحمه الله تعالي بيعه علي الصغار جاءز  في كل شء كان منه بدا ولم يكن ولا يجوز علي الكبار في شء من بيع العقار اذا لم يكن الميت اوصي بشء يباع فيه او يكون عليه دين ( قال الشافعي ) رحمه الله تعالي ولو ان رجلا مات واوصي الي رجل وترك ورثه بالغين اهل رشد وصغارا ولم يوص بوصية ولم يكن عليه دين فباع الوصي عقارا مما ترك الميت كان بيعه علي الكبار باطلا ونظر في بيعه علي الصغار فان كان باع عليهم فيما لا صلاح لمعاشهم الا به او باع عليهم نظرا لهم بيع غبطة كان بيعا جاءزا وان لم يبع في واحد من الوجهين ولا امر لزمهم كان بيعه مردودا واذا امرناه اذا كان في يده الناض ان يشتري لهم به العقار الذي هو خير لهم من الناض لم نجز له ان يبيع العقار الا ببعض ما وصفت من العذر
   * باب في الشركة والعتق وغيره
  * ( قال الشافعي ) رحمه الله تعالي واذا اشترك الرجلان شركة مفاوضة ولاحدهما الف درهم وللاخر اكثر من ذلك فان ابا حنيفة رحمه الله تعالي كان يقول ليست هذه بمفاوضة وبهذا ياخذ وكان بن ابي ليلي يقول هذه مفاوضة جاءزة والمال بينهما نصفان ( قال الشافعي ) رحمه الله تعالي وشركة المفاوضة باطلة ولا اعرف شيءا من الدنيا يكون باطلا ان لم تكن شركة المفاوضة باطلة الا ان يكونا شريكين يعدان المفاوضة خلط المال بالمال والعمل فيه واقتسام الربح فهذا لا باس به وهذه الشركة التي يقول بعض المشرقيين لها شركة عنان فاذا اشتركا مفاوضة وتشارطا ان المفاوضة عندهما هذا المعني فالشركة صحيحة وما رزق احدهما من غير هذا المال الذي اشتركا فيه معا من تجارة او اجارة او كنز او هبة او غير ذلك فهو له دون صاحبه وان زعما بان المفاوضة عندهما بان يكونا شريكين في كل ما افادا بوجه من الوجوه بسبب المال وغيره فالشركة فيه فاسدة ولا اعرف القمار الا في هذا او اقل منه ان يشترك الرجلان بماءتي درهم فيجد احدهما كنزا فيكون بينهما ارايت لو تشارطا علي هذا من غير ان يتخالطا بمال كان يجوز فان قال لا يجوز لانه عطية ما لم يكن للمعطي ولا للمعطي وما لم يعلمه واحد منهما افتجيزه علي ماءتي درهم اشتركا بها فان عدوه بيعا فبيع ما لم يكن لا يجوز ارايت رجلا وهب له هبة او اجر نفسه في عمل فافاد مالا من عمل او هبة ايكون الاخر فيها شريكا لقد انكروا اقل من هذا ( قال ) ولو ان عبدا بين رجلين اعتق احدهما نصيبه وهو موسر كان الخيار للاخر في قول ابي حنيفة رضي الله عنه فان شاء اعتق العبد كما اعتق صاحبه وان شاء استسعي العبد في نصف قيمته فيكون الولاء بينهما وان شاء ضمن شريكه نصف قيمته ويرجع الشريك بما ضمن من ذلك علي العبد ويكون الولاء للشريك كله وهو عبد ما بقي عليه من السعاية شء وكان بن ابي ليلي رحمه الله تعالي يقول هو حر كله يوم اعتقه الاول والاول ضامن لنصف القيمة ولا يرجع بها علي العبد وله الولاء ولا يخير صاحبه في ان يعتق العبد او يستسعيه ولو كان الذي اعتق العبد معسرا كان الخيار في قول ابي حنيفة للشريك الاخر ان شاء ضمن العبد نصف قيمته يسعي فيها والولاء بينهما وان شاء اعتقه كما اعتق صاحبه والولاء بينهما وكان بن ابي ليلي يقول اذا كان معسرا سعي العبد للشريك الذي لم يعتق في نصف قيمته ويرجع بذلك العبد علي الذي اعتقه والولاء كله للذي اعتقه وليس للاخر ان يعتق منه شيءا وكان يقول اذا اعتق شقصا في مملوك فقد اعتقه كله ولا يتبعض العبد فيكون بعضه رقيقا وبعضه حرا وبه ياخذ ارايت ما اعتق منه ايكون رقيقا فان كان ما اعتق منه يكون رقيقا فقد عتق فكيف يجتمع في معتق واحد عتق ورق الا تري انه لا يجتمع في امراة بعضها طالق وبعضها غير طالق وبعضها امراة للزوج علي حالها وكذلك الرقيق وبهذا ياخذ الا خصلة لا يرجع العبد بما سعي فيه علي الذي اعتقه وقال ابو حنيفة رحمه الله تعالي لا يعتق بعضه وبعضه رقيق وهذا كله بمنزلة العبد ما دام  منه شء رقيق او يسعي في قيمته ارايت لو ان الشريك قال نصيب شريكي منه حر واما نصيبي فلا هل كان يعتق منه ما لا يملك واذا اعتق منه ما يملك فكيف يعتق منه ما لا يملك وهل يقع عتق فيما لا يملك الرجل ( قال الشافعي ) رحمه الله واذا كان العبد بين الرجلين فاعتق احدهما نصيبه منه فان كان موسرا بان يءدي نصف قيمته فالعبد حر كله والولاء للمعتق الاول ولا خيار لسيد العبد الاخر وان كان معسرا فالنصف الاول حر والنصف الثاني لمالكه ولا سعاية عليه وهذا مكتوب في كتاب العتق بحججه الا انا وجدنا في هذا الكتاب زيادة حرف لم نسمع به في حججهم كان مما احتجوا به في هذا الكتاب ان قال قاءلهم كيف تكون نفس واحدة بعضها حر وبعضها مملوك لا يكون كما لا تكون المراة بعضها طالق وبعضها غير طالق فان زعم ان العبد يكون فيه الرق والحرية قياسا علي المراة قيل له ايجوز للرجل ان ينكح بعض امراة فان قال لا لا تكون الا منكوحة كلها او غير منكوحة قيل له افيجوز ان يشتري بعض عبد فان قال نعم قيل له فاين العبد من المراة وقيل له ايجوز له ان يكاتب المراة علي الطلاق ويكون ممنوعا حتي تءدي الكتابة او تعجز فان قال لا قيل افيجوز هذا له في العبد فان قال نعم قيل فلم تجمع بينهما فان قال لا يجتمعان قيل وكذلك لا يجتمعان حيث جمعت بينهما ويقال له ايضا اتكون المراة لاثنين كما يكون العبد مملوكا لاثنين ويكون لزوج المراة ان يهبها للرجل فتكون زوجة له كما يكون العبد اذا وهبه صار عبدا لمن وهبه له فان قال لا قيل فما بال المراة تقاس علي المملوك ويقال له ارايت العبد اذا عتق مرة ايكون لسيده ان يسترقه كما يكون له اذا طلق المراة مرة ان يكون له رجعتها فان قال لا قيل فما نعلم شيءا ابعد مما قاسه به منه ( قال ) ولو ان عبدا بين رجلين كاتبه احدهما بغير اذن صاحبه ولا رضاه فانكر ذلك صاحبه قبل ان يءدي المكاتب شيءا فان ابا حنيفة رضي الله تعالي عنه كان يقول المكاتبة باطلة ولصاحبه ان يردها لانها منفعة تصل اليه وليس ذلك له دون صاحبه وبه ياخذ وكان بن ابي ليلي يقول المكاتبة جاءزة وليس للشريك ان يردها ولو ان الشريك اعتق العبد كان العتق باطلا في قول بن ابي ليلي حتي ينظر ما يصنع في المكاتبة فان اداها الي صاحبها عتق وكان الذي كاتب ضامنا لنصف القيمة والولاء كله له وكان ابو حنيفة رحمه الله تعالي يقول عتق ذلك جاءز ويخير المكاتب فان شاء الغي الكتابة وعجز عنها وان شاء سعي فيها فان عجز عنها كان الشريك الذي كاتب بالخيار ان شاء ضمن الذي اعتق ان كان موسرا وان شاء استسعي العبد في نصف قيمته وان شاء اعتق العبد فان ضمن الذي اعتق كان له ان يرجع علي العبد بما ضمن ( قال الشافعي ) رحمه الله تعالي واذا كان العبد بين رجلين فكاتب احدهما نصيبه بغير اذن شريكه فالكتابة مفسوخة وما اخذ منه بينهما نصفان ما لم يءد جميع الكتابة فان ادي جميع الكتابة عتق نصف المكاتب وكان كمن ابتدا العتق في عبد بينه وبين رجل ان كان موسرا عتق عليه كله وان معسرا عتق منه ما عتق ولو ردت الكتابة قبل الاداء كان مملوكا بينهما ولو اعتقه مالك النصف الذي لم يكاتبه قبل الاداء كان نصفه منه حرا فان كان موسرا ضمن نصفه الباقي لان الكتابة كانت فيه باطلة ولا اخير العبد لان عقد الكتابة كان فاسدا وان كان معسرا عتق منه ما عتق وكانت الكتابة بينهما باطلة الا ان يشاء مالك العبد ان يجددها ( قال ) ولو ان مملوكا بين اثنين دبره احدهما فان ابا حنيفة رضي الله عنه كان يقول ليس للاخر ان يبيعه لما دخل فيه من العتق وبه ياخذ وكان بن ابي ليلي يقول له ان يبيع حصته واذا ورث احد المتفاوضين ميراثا فان ابا حنيفة رحمه الله كان يقول هو له خاصة وبهذا ياخذ قال وتنتقض المفاوضة اذا قبض ذلك وكان بن ابي ليلي يقول هو بينهما نصفان ( قال الشافعي ) رحمه الله تعالي واذا كان العبد بين رجلين  فدبره احدهما فللاخر بيع نصيبه لان التدبير عندي وصية وكذلك للذي دبره ان يبيعه وهذا مكتوب في كتاب المدبر ومن زعم انه ليس للمدبر ان يبيع المدبر لزمه ان يزعم ان علي السيد المدبر نصف القيمة لشريكه ان كان موسرا ويكون مدبرا كله كما يلزمه هذا في العتق اذا جعل هذا عتقا يكون له بكل حال فان قال فالعتق الذي الزمته فيه نصف القيمة عتق واقع مكانه قيل فانت تزعم في الجارية بين الرجلين يطءها احدهما فتلد انها ام ولد وعليه نصف القيمة وهذا عتق ليس بواقع مكانه انما هو واقع بعد مدة كعتق المدبر يقع بعد مدة وان كان العبد بين اثنين فدبره احدهما ثم اعتقه الاخر البتة فان ابا حنيفة رحمه الله تعالي كان يقول الذي دبره بالخيار ان شاء اعتق وان شاء استسعي العبد في نصف قيمته مدبرا وان شاء ضمن المعتق نصف قيمته مدبرا ان كان موسرا ويرجع به المعتق علي العبد والولاء بينهما نصفان وكان بن ابي ليلي يقول التدبير باطل والعتق جاءز والمعتق ضامن لنصف قيمته ان كان موسرا وان كان معسرا سعي فيه العبد ثم يرجع علي المعتق والولاء كله للمعتق وقال ابو يوسف اذا دبره احدهما فهو مدبر كله وهو ضامن نصف قيمته وعتق الاخر باطل لا يجوز فيه ( قال الشافعي ) رحمه الله تعالي واذا كان العبد بين اثنين فدبر احدهما نصيبه واعتق الاخر بتاتا فان كان موسرا فالعبد حر كله وعليه نصف قيمته وله ولاءه وان كان معسرا فنصيبه منه حر ونصيب شريكه مدبر ومن زعم انه لا يبيع المدبر فيلزمه ان يبطل العتق الاخر ويجعله مدبرا كله اذا كان المدبر الاول موسرا لان تدبير الاول عتق والعتق الاول اولي من الاخر قال وهكذا قال اهل القياس الذين لم يبيعوا المدبر
   * باب في المكاتب
  * ( قال الشافعي ) رحمه الله تعالي واذا كاتب الرجل المكاتب علي نفسه فان ابا حنيفة رحمه الله كان يقول ماله لمولاة اذا لم يشترط المكاتب ذلك وبه ياخذ وكان بن ابي ليلي يقول المكاتب له المال وان لم يشترط ( قال الشافعي ) رحمه الله تعالي واذا كاتب الرجل عبده وبيد العبد مال فالمال للسيد لانه لا مال للعبد الا ان يشترط المكاتب علي السيد ماله فيكون له بالشرط وهذا معني السنة نصا قال رسول الله صلي الله عليه وسلم من باع عبدا وله مال فماله للباءع الا ان يشترط المبتاع ولا يعدو المكاتب ان يكون مشتريا لنفسه فرب المكاتب باءع وقد جعل له رسول الله صلي الله عليه وسلم المال او يكون غير خارج من ملك مولاه فيكون معه كالمعلق فذلك احري ان لا يملك علي مولاه مالا كان لمولاه قبل الكتابة والمشتري الذي اعطي ماله في العبد اولي ان يكون مالكا لمال العبد بشراء العبد لانه لو مات مكانه مات من ماله من المكاتب الذي لو مات لم يلزمه شء واذا قال المكاتب قد عجزت وكسر مكاتبته ورده مولاه في الرق فان ابا حنيفة رحمه الله كان يقول ذلك جاءز وبهذا ياخذ وقد بلغنا عن عبد الله بن عمر انه رد مكاتبا له حين عجز وكسر مكاتبته عند غير قاض وكان بن ابي ليلي يقول لا يجوز ذلك الا عند قاض وكذلك لو اتي القاضي فقال قد عجزت فان ابا حنيفة رضي الله عنه كان يرده وبهذا ياخذ وكان بن ابي ليلي يقول لا ارده حتي يجتمع عليه نجمان قد حلا عليه في يوم خاصم اليه ثم قال ابو يوسف بعد لا ارده حتي انظر فان كان نجمه قريبا وكان يرجي لم يعجل عليه ( قال الشافعي ) رحمه الله تعالي واذا قال المكاتب قد عجزت عند محل نجم من نجومه فهو كما قال وهو كمن لم يكاتب يبيعه سيده ويصنع به ما شاء كان ذلك عند قاض او لم يكن ( قال الشافعي ) رحمه الله تعالي اخبرنا الثقفي وبن علية عن ايوب عن نافع عن بن عمر رضي الله تعالي عنهما انه رد مكاتبا له عجز في الرق ( قال الشافعي ) اخبرنا سفيان بن عيينة عن شبيب بن غرقدة انه شهد شريحا رد مكاتبا عجز في الرق واذا تزوج  المكاتب او وهب هبة او اعتق عبدا او كفل بكفالة او كفل عنه رجل لمولاه بالذي عليه فان ابا حنيفة رحمه الله تعالي كان يقول هذا كله باطل لا يجوز وبه ياخذ وكان بن ابي ليلي يقول نكاحه وكفالته باطل وما تكفل به رجل عنه لمولاه فهو جاءز واما عتقه وهبته فهو موقوف فان عتق امضي ذلك وان رجع مملوكا فذلك كله مردود وقال ابو حنيفة رحمه الله تعالي كيف يجوز عتقه وهبته وكيف تجوز الكفالة عنه لمولاه ارايت رجلا كفل لرجل عن عبده كفالة اليست باطلا فكذلك مكاتبه وبهذا ياخذ وبلغنا عن ابراهيم النخعي انه قال لا يجوز ان يكفل الرجل للرجل بمكاتبة عبده لانه عبده وانما كفل له بماله وقال ابو حنيفة رحمه الله اذا كان له مال حاضر فقال اءديه اليوم او غدا فانه كان يقول يءجله ثلاثة ايام ( قال الشافعي ) رحمه الله تعالي واذا تزوج المكاتب او وهب او اعتق او كفل عن احد بكفالة فذلك كله باطل لان في هذا اتلافا لماله وهو غير مسلط علي المال اما التزوج فابطلناه بالعبودية التي فيه انه لا يكون للعبد ان ينكح الا باذن سيده ولو كفل رجل لرب المكاتب بالكتابة كانت الكفالة باطلة من قبل انه انما تكفل له بماله عن ماله
   * باب في الايمان
  * ( قال الشافعي ) رحمه الله تعالي واذا قال الرجل لعبده ان بعتك فانت حر ثم باعه فان ابا حنيفة رحمه الله كان يقول لا يعتق لان العتق انما وقع عليه بعد البيع وبعد ما خرج من ملكه وصار لغيره وبهذا ياخذ وكان بن ابي ليلي يقول يقع العتق من مال الباءع ويرد الثمن علي المشتري لانه حلف يوم حلف وهو في ملكه وكذلك لو قال الباءع ان كلمت فلانا فانت حر فباعه ثم كلم فلانا فان ابا حنيفة رحمه الله تعالي كان يقول لا يعتق الا تري انه قد خرج من ملك الباءع الحالف ارايت لو اعتقه المشتري ايرجع الي الحالف وقد صار مولي للمشتري ارايت لو ان المشتري ادعاه وزعم انه ابنه فاثبت القاضي نسبه وهو رجل من العرب وجعله ابنه ثم كلم الباءع ذلك الرجل الذي حلف عليه ان لا يكلمه ابطل دعوي هذا ونسبه ويرجع الولاء الي الاول وكان بن ابي ليلي يقول في هذا يرجع الولاء الي الاول ويرد الثمن ويبطل النسب ( قال الشافعي ) رحمه الله تعالي واذا قال الرجل لعبده ان بعتك فانت حر فباعه بيعا ليس ببيع خيار بشرط فهو حر حين عقد البيع وانما زعمت انه يعتق من قبل ان النبي صلي الله عليه وسلم قال المتبايعان بالخيار ما لم يتفرقا ( قال الشافعي ) وتفرقهما تفرقهما عن مقامهما الذي تبايعا فيه فلما كان لمالك العبد الحالف بعتقه اجازة البيع ورده كان لم ينقطع ملكه عنه الانقطاع كله ولو ابتدا العتق في هذه الحال لعبده الذي باعه عتق فعتق بالحنث ولو كان باعه بيع خيار كان هكذا عندي لاني ازعم ان الخيار انما هو بعد البيع ومن زعم ان الخيار يجوز مع عقد البيع لم يعتق لان الصفقة اخرجته من ملك الحالف خروجا لا خيار له فيه فوقع العتق عليه وهو خارج من ملكه ( قال الشافعي ) رحمه الله تعالي وهكذا لو قال رجل لغلامه انت حر لو كلمت فلانا او دخلت الدار فباعه وفارق المشتري ثم كلم فلانا او دخل الدار لم يعتق لان الحنث وقع وهو خارج من ملكه واذا قال الرجل لامراته انت طالق ان كلمت فلانا ثم طلقها واحدة باءنة او واحدة يملك الرجعة وانقضت عدتها ثم كلم فلانا فان ابا حنيفة رحمه الله تعالي كان يقول لا يقع عليه الطلاق الذي حلف به لانها قد خرجت من ملكه الا تري انها لو تزوجت زوجا غيره ثم كلم الاول فلانا وهي عند هذا الرجل لم يقع عليها الطلاق وهي تحت غيره وبه ياخذ وكان بن ابي ليلي يقول يقع عليها الطلاق لانه حلف بذلك وهي في ملكه ( قال الشافعي ) رحمه الله تعالي ولو قال لامراته انت طالق ان كلمت فلانا ثم خالعها ثم كلمت  فلانا لم يقع عليها طلاق من قبل ان الطلاق وقع وهي خارجة من ملكه وهكذا لو طلقها واحدة فانقضت عدتها ثم كلم فلانا لم يقع عليه الطلاق لان الطلاق لا يقع الا علي زوجة وهي ليست بزوجة ولو نكحها نكاحا جديدا لم يحنث بهذا الطلاق وان كلمه كلاما جديدا لان الحنث لا يقع الا مرة وقد وقع وهي خارجة من ملكه ( قال ) واذا قال الرجل كل امراة اتزوجها ابدا فهي طالق ثلاثا وكل مملوك املكه فهو حر لوجه الله تعالي فاشتري مملوكا وتزوج امراة فان ابا حنيفة رحمه الله تعالي كان يقول يقع العتق علي المملوك والطلاق علي المراة الا تري انه طلق بعد ما ملك واعتق بعد ما ملك وقد بلغنا عن علي رضي الله عنه انه كان يقول لا طلاق الا بعد نكاح ولا عتق الا بعد ملك فهذا انما وقع بعد الملك كله الا تري انه لو قال اذا تزوجتها او ملكتها فهي طالق صارت طالقا وبهذا ياخذ الا تري ان رجلا لو قال لامته كل ولد تلدينه فهو حر ثم ولدت بعد عشر سنين كان حرا فهذا عتق ما لم يملك الا تري ان رجلا لو كانت عنده امراة فقال لها ان تزوجتك فانت طالق ثلاثا ثم طلقها واحدة باءنة ثم تزوجها في العدة او بعدها ان ذلك واقع عليها لانه حلف وهو يملكها ووقع الطلاق وهو يملكها ارايت لو قال لعبد له ان اشتريتك فانت حر فباعه ثم اشتراه اما كان يعتق وكان بن ابي ليلي يقول لا يقع في ذلك عتق ولا طلاق الا ان يوقت وقتا فان وقت وقتا في سنين معلومة او قال ما عاش فلان او فلانة او وقت مصرا من الامصار او مدينة او قبيلة لا يتزوج ولا يشتري منها مملوكا فان بن ابي ليلي يوقع علي هذا الطلاق واما قول ابي حنيفة رحمه الله تعالي فانه يوقع في الوقت وغير الوقت وقد بلغنا عن عبد الله بن مسعود رضي الله تعالي عنه انه قال اذا وقت وقتا او قبيلة او ما عاشت فلانة وقع واذا قال الرجل ان وطءت فلانة فهي حرة فاشتراها فوطءها فان ابا حنيفة رضي الله عنه كان يقول لا تعتق من قبل انه حلف وهو لا يملكها وبه ياخذ وكان بن ابي ليلي رحمه الله تعالي يقول تعتق فان قال ان اشتريتك فوطءتك فانت حرة فاشتراها فوطءها فهي حرة في قولهما جميعا ( قال الربيع ) للشافعي رحمه الله تعالي ها هنا جواب
   * باب في العارية واكل الغلة
  * ( قال الشافعي ) رحمه الله تعالي واذا اعار الرجل الرجل ارضا يبني فيها ولم يوقت وقتا ثم بدا له ان يخرجه بعد ما بني فان ابا حنيفة رحمه الله تعالي كان يقول نخرجه ويقال للذي بني انقض بناءك وبهذا ياخذ وكان بن ابي ليلي يقول الذي اعاره ضامن لقيمة البنيان والبناء للمعير وكذلك بلغنا عن شريح فان وقت له وقتا فاخرجه قبل ان يبلغ ذلك الوقت فهو ضامن لقيمة البناء في قولهما جميعا ( قال الشافعي ) رحمه الله تعالي واذا اعار الرجل الرجل بقعة من الارض يبني فيها بناء فبناه لم يكن لصاحب البقعة ان يخرجه من بناءه حتي يعطيه قيمته قاءما يوم يخرجه ولو وقت له وقتا وقال اعرتكها عشر سنين واذنت لك في البناء مطلقا كان هكذا ولكنه لو قال فان انقضت العشر السنين كان عليك ان تنقض بناءك كان ذلك عليه لانه لم يغر انما هو غر نفسه ( قال ) واذا اقام الرجل البينة علي ارض ونخل انها له وقد اصاب الذي هو في يديه من غلة النخل والارض فان ابا حنيفة رحمه الله تعالي كان يقول الذي كانت في يديه ضامن لما اخذ من الثمر وبه ياخذ وكان بن ابي ليلي يقول لا ضمان عليه في ذلك ( قال الشافعي ) رحمه الله تعالي واذا كانت النخل والارض في يدي الرجل فاقام رجل عليها البينة انها له منذ عشر سنين وقد اصاب الذي هي في يديه ثمرها منذ عشر سنين اخرجت من يديه وضمن ثمرها وما اصاب منها من شء فدفعه الي صاحب البينة فان كانت الارض تزرع فزرعها للزارع وعليه كراء مثل الارض وان كان لم يزرعها فعليه كراء مثل الارض ( قال ) واذا زرع الرجل الارض فان ابا حنيفة رحمه الله تعالي كان يقول الزرع للذي كانت في يديه وهو ضامن لما نقص الارض في قول ابي حنيفة ويتصدق بالفضل وكان بن ابي ليلي يقول لا يتصدق بشء وليس عليه  ضمان ( قال ) واذا اخذ الرجل ارض رجل اجارة سنة وعملها واقام فيها سنتين فان ابا حنيفة رحمه الله تعالي كان يقول هو ضامن لما نقص الارض في السنة الثانية ويتصدق بالفضل ويعطي اجر السنة الاولي وكان بن ابي ليلي يقول عليه اجر مثلها في السنة الثانية ( قال الشافعي ) رحمه الله تعالي واذا تكاري الرجل الارض ليزرعها سنة فزرعها سنتين فعليه كراءها الذي تشارطا عليه في السنة الاولي وكراء مثلها في السنة الثانية ولو حدث عليها في السنة الثانية حدث ينقصها كان ضامنا وهكذا الدور والعبيد والدواب وكل شء استءجر ( قال ) واذا وجد الرجل كنزا قديما في ارض رجل او داره فان ابا حنيفة رضي الله عنه كان يقول هو لرب الدار وعليه الخمس وليس للذي وجده منه شء وكان بن ابي ليلي يقول هو للذي وجده وعليه الخمس ولا شء لصاحب الدار والارض فيه وبه ياخذ ( قال الشافعي ) رحمه الله تعالي واذا وجد الرجل كنزا جاهليا في دار رجل فالكنز لرب الدار وفيه الخمس وانما يكون الكنز لمن وجده اذا وجده في موضع لا يملكه احد واذا كان الكنز اسلاميا ولم يوجد في ملك احد فهو لقطة يعرفه سنة ثم هو له
   * باب في الاجير والاجارة
  * ( قال الشافعي ) رحمه الله تعالي واذا اختلف الاجير والمستاجر في الاجرة فان ابا حنيفة رضي الله عنه كان يقول القول قول المستاجر مع يمينه اذا عمل العمل وبهذا ياخذ وكان بن ابي ليلي يقول القول قول الاجير فيما بينه وبين اجر مثله الا ان يكون الذي ادعي اقل فيعطيه اياه وان لم يكن عمل العمل تحالفا وترادا في قول ابي حنيفة وينبغي كذلك في قول بن ابي ليلي وقال ابو يوسف بعد اذا كان شء متقارب قبلت قول المستاجر واحلفته واذا تفاوت لم اقبل واجعل للعامل اجر مثله اذا حلف قال الشافعي رحمه الله تعالي واذا استاجر الرجل اجيرا فتصادقا علي الاجارة واختلفا كم هي فان كان لم يعمل تحالفا وترادا الاجارة وان كان عمل تحالفا وترادا اجر مثله كان اكثر مما ادعي او اقل مما اقر به المستاجر اذا ابطلت العقدة وزعمت انها مفسوخة لم يجز ان استدل بالمفسوخ علي شء ولو استدللت به كنت لم اعمل المفسوخ ولا الصحيح علي شء ( قال ) واذا استاجر الرجل بيتا شهرا يسكنه فسكنه شهرين او استاجر دابة الي مكان فجاوز ذلك المكان فان ابا حنيفة رحمه الله تعالي كان يقول الاجر فيما سمي ولا اجر له فيما لم يسم لانه قد خالف وهو ضامن حين خالف ولا يجتمع عليه الضمان والاجرة وبهذا ياخذ وكان بن ابي ليلي يقول له الاجر فيما سمي وفيما خالف ان سلم وان لم يسلم ذلك ضمن ولا نجعل عليه اجرا في الخلاف اذا ضمنه ( قال الشافعي ) رحمه الله تعالي واذا تكاري الرجل الدابة الي موضع فجاوزه الي غيره فعليه كراء الموضع الذي تكاراها اليه الكراء الذي تكاراها به وعليه من حين تعدي الي ان ردها كراء مثلها من ذلك الموضع واذا عطبت لزمه الكراء الي الموضع الذي عطبت فيه وقيمتها وهذا مكتوب في كتاب الاجارات ( قال ) واذا تكاري الرجل دابة ليحمل عليها عشرة مخاتيم فحمل عليها اكثر من ذلك فعطبت الدابة فان ابا حنيفة رضي الله عنه كان يقول هو ضامن قيمة الدابة بحساب ما زاد عليها وعليه الاجر تاما اذا كانت قد بلغت المكان وبه ياخذ وكان بن ابي ليلي يقول عليه قيمتها تامة ولا اجر عليه ( قال الشافعي ) رحمه الله تعالي واذا تكاري الرجل الدابة علي ان يحمل عليها عشرة مكاييل مسماة فحمل عليها احد عشر مكيالا فعطبت فهو ضامن لقيمة الدابة كلها وعليه الكراء وكان ابو حنيفة رحمه الله تعالي يجعل عليه الضمان بقدر الزيادة كانه تكاراها علي ان يحمل عليها عشرة مكاييل فحمل عليها احد عشر فيضمنه سهما من احد عشر سهما ويجعل الاحد عشر كلها  قتلتها ثم يزعم ابو حنيفة رحمه الله تعالي انه تكاراها ماءة ميل فتعدي بها علي الماءة ميلا او بعض ميل فعطبت ضمن الدابة كلها وكان ينبغي في اصل قوله ان يجعل الماءة والزيادة علي الماءة قتلتها فيضمنه بقدر الزيادة لانه يزعم انه ضامن للدابة حين تعدي بها حتي يردها ولو كان الكراء مقبلا ومدبرا فماتت في الماءة ميل واذا غرقت سفينة الملاح فغرق الذي فيها وقد حمله باجر فغرقت من مده او معالجته السفينة فان ابا حنيفة رضي الله عنه كان يقول هو ضامن وبه ياخذ وكان بن ابي ليلي يقول لا ضمان عليه في المد خاصة ( قال الشافعي ) رحمه الله واذا فعل من ذلك الفعل الذي يفعل بمثلها في ذلك الوقت الذي فعل لم يضمن واذا تعدي ذلك ضمن والله سبحانه وتعالي الموفق
   * باب القسمة
  * ( قال الشافعي ) رحمه الله تعالي واذا كانت الدار صغيرة بين اثنين او شقص قليل في دار لا يكون بيتا فان ابا حنيفة رضي الله عنه كان يقول ايهما طلب القسمة وابي صاحبه قسمت له الا تري ان صاحب القليل ينتفع بنصيب صاحب الكثير وبهذا ياخذ وكان بن ابي ليلي يقول لا يقسم شء منها ( قال الشافعي ) واذا كانت الدار او البيت بين شركاء فسال احدهم القسمة ولم يسال ذلك من بقي فان كان يصل اليه بالقسم شء ينتفع به وان قلت المنفعة قسم له وان كره اصابه وان كان لا يصل اليه منفعة ولا الي احد لم يقسم له
   * باب الصلاة
  * ( قال الشافعي ) رحمه الله تعالي واذا اتي الرجل الي الامام في ايام التشريق وقد سبقه بركعة فسلم الامام عند فراغه فان ابا حنيفة رضي الله عنه كان يقول يقوم الرجل فيقضي ولا يكبر معه لان التكبير ليس من الصلاة انما هو بعدها وبه ياخذ وكان بن ابي ليلي يقول يكبر ثم يقوم فيقضي ( قال ) واذا صلي الرجل في ايام التشريق وحده او المراة فان ابا حنيفة رحمه الله كان يقول لا تكبير عليه ولا تكبير علي من صلي في جماعة في غير مصر جامع ولا تكبير علي المسافرين وكان بن ابي ليلي يقول عليهم التكبير ابو يوسف عن عبيدة عن ابراهيم انه قال التكبير علي المسافرين وعلي المقيمين وعلي الذي يصلي وحده وفي جماعة وعلي المراة وبه ياخذ مجالد عن عامر مثله ( قال الشافعي ) رحمه الله تعالي واذا سبق الرجل بشء من الصلاة في ايام التشريق فسلم الامام وكبر لم يكبر المسبوق بشء من الصلاة وقضي الذي عليه فاذا سلم كبر وذلك ان التكبير ايام التشريق ليس من الصلاة انما هو ذكر بعدها وانما يتبع الامام فيما كان من الصلاة وهذا ليس من الصلاة ويكبر في ايام التشريق المراة والعبد والمسافر والمصلي منفردا وغير منفرد والرجل قاءما وقاعدا ومضطجعا وعلي كل حال واذا ادرك الامام وهو راكع فكبر معه ثم لم يركع حتي رفع الامام راسه فان ابا حنيفة رضي الله عنه كان يقول يسجد معه ولا يعتد بتلك الركعة اخبرنا بذلك عن الحسن عن الحكم عن ابراهيم وبه ياخذ وكان بن ابي ليلي يقول يركع ويسجد ويحتسب بذلك من صلاته وكان ابو حنيفة رحمه الله تعالي ينهي عن القنوت في الفجر وبه ياخذ ويحدث به عن رسول الله صلي الله عليه وسلم انه لم يقنت الا شهرا واحدا حارب حيا من المشركين فقنت يدعو عليهم وان ابا بكر رضي الله عنه لم يقنت حتي لحق بالله عز وجل وان بن مسعود رضي الله عنه لم يقنت في سفر ولا في حضر وان عمر بن الخطاب لم يقنت وان بن عباس رضي الله عنه لم يقنت وان عبد الله بن عمر رضي الله عنهما لم يقنت وقال يا اهل العراق انبءت ان امامكم يقوم لا قارء قران ولا راكع يعني بذلك القنوت وان عليا رضي الله عنه قنت في حرب يدعو علي معاوية فاخذ اهل الكوفة عنه ذلك وقنت معاوية بالشام يدعو علي علي رضي الله عنه فاخذ اهل الشام عنه ذلك  وكان بن ابي ليلي رحمه الله تعالي يري القنوت في الركعة الاخيرة بعد القراءة وقبل الركوع في الفجر ويروي ذلك عن عمر بن الخطاب رضي الله عنه انه قنت بهاتين (  ) السورتين اللهم انا نستعينك ونستغفرك ونثني عليك الخير نشكرك ولا نكفرك ونخلع ونترك من يفجرك اللهم اياك نعبد ولك نصلي ونسجد واليك نسعي ونحفد نرجو رحمتك ونخشي عذابك ان عذابك بالكفار ملحق وكان يحدث عن بن عباس رضي الله عنهما عن عمر رضي الله عنه بهذا الحديث ويحدث عن علي رضي الله عنه انه قنت ( قال الشافعي ) رحمه الله تعالي ومن ادرك الامام راكعا فكبر ولم يركع حتي يرفع الامام راسه سجد مع الامام ولم يعتد بذلك السجود لانه لم يدرك ركوعه ولو ركع بعد رفع الامام راسه لم يعتد بتلك الركعة لانه لم يدركها مع الامام ولم يقرا لها فيكون صلي لنفسه فقرا ولا صلي مع الامام فيما ادرك مع الامام ويقنت في صلاة الصبح بعد الركعة الثانية قنت رسول الله صلي الله عليه وسلم ولم يترك علمناه القنوت في الصبح قط وانما قنت النبي صلي الله عليه وسلم حين جاءه قتل اهل بءر معونة خمس عشر ليلة يدعو علي قوم من المشركين في الصلوات كلها ثم ترك القنوت في الصلوات كلها فاما في صلاة الصبح فلا اعلم انه تركه بل نعلم انه قنت في الصبح قبل قتل اهل بءر معونة وبعد وقد قنت بعد رسول الله صلي الله عليه وسلم ابو بكر وعمر وعلي بن ابي طالب رضي الله عنهم كلهم بعد الركوع وعثمان رضي الله عنه في بعض امارته ثم قدم القنوت علي الركوع وقال ليدرك من سبق بالصلاة الركعة
   * باب صلاة الخوف
  * ( قال ) وكان ابو حنيفة رحمه الله يقول في صلاة الخوف يقوم الامام وتقوم معه طاءفة فيكبرون مع الامام ركعة وسجدتين ويسجدون معه فينفلتون من غير ان يتكلموا حتي يقفوا بازاء العدو ثم تاتي الطاءفة التي كانت بازاء العدو فيستقبلون التكبير ثم يصلي بهم الامام ركعة اخري وسجدتين ويسلم الامام فينفلتون هم من غير تسليم ولا يتكلموا فيقوموا بازاء العدو وتاتي الاخري فيصلون ركعة وحدانا ثم يسلمون وذلك لقول الله عز وجل @QB@ ولتات طاءفة اخري لم يصلوا فليصلوا معك @QE@ وكذلك بلغنا عن عبد الله بن عباس وابراهيم النخعي وكان بن ابي ليلي يقول يقوم الامام والطاءفتان جميعا اذا كان العدو بينهم وبين القبلة فيكبر ويكبرون ويركع ويركعون جميعا ويسجد الامام والصف الاول ويقوم الصف الاخر في وجوه العدو فاذا رفع الامام رفع الصف الاول رءوسهم ( ( ( رءوسهم ) ) ) وقاموا وسجد الصف المءخر فاذا فرغوا من سجودهم قاموا ثم تقدم الصف المءخر ويتاخر الصف الاول فيصلي بهم الامام الركعة الاخري كذلك ويحدث بذلك بن ابي ليلي عن عطاء بن ابي رباح عن جابر بن عبد الله عن رسول الله صلي الله عليه وسلم وكان بن ابي ليلي يقول اذا كان العدو في دبر القبلة قام الامام وصف معه مستقبل القبلة والصف الاخر مستقبل العدو ويكبر ويكبرون جميعا ويركع ويركعون جميعا ثم يسجد الصف الذي مع الامام سجدتين ثم ينفتلون فيستقبلون العدو ويجء الاخرون فيسجدون ويصلي بهم الامام الركعة الثانية فيركعون جميعا ويسجد معه الصف الذي معه ثم ينفتلون فيستقبلون العدو ويجء الاخرون فيسجدون ويفرغون ثم يسلم الامام وهم جميعا ( قال الشافعي ) واذا صلي الامام صلاة الخوف مسافرا جعل طاءفة من اصحابه بينه وبين العدو وصلي بطاءفة ركعة ثم ثبت قاءما يقرا وصلوا لانفسهم الركعة التي بقيت عليهم وتشهدوا وسلموا ثم انصرفوا وقاموا بازاء العدو وجاءت الطاءفة التي كانت بازاء العدو فكبروا لانفسهم وصلي بهم الركعة التي كانت بقيت عليه فاذا جلس في التشهد قاموا فصلوا الركعة التي بقيت عليهم ثم جلسوا فتشهدوا فاذا راي الامام ان قد قضوا تشهدهم سلم بهم وبهذا المعني صلي النبي  صلي الله عليه وسلم صلاة الخوف يوم ذات الرقاع وقد روي عنه في صلاة الخوف خلاف هذا وهذا مكتوب في كتاب الصلاة ( قال الشافعي ) رحمه الله تعالي واذا كان العدو بينه وبين القبلة لا حاءل بينه وبينهم ولا سترة وحيث لا يناله النبل وكان العدو قليلا مامونين واصحابه كثيرا وكانوا بعيدا منه لا يقدرون في السجود علي الغارة عليه قبل ان يصيروا الي الركوب والامتناع صلي باصحابه كلهم فاذا ركع ركعوا كلهم واذا رفع رفعوا كلهم واذا سجد سجدوا كلهم الا صفا يكونون علي راسه قياما فاذا رفع راسه من السجدتين فاستوي قاءما او قاعدا في مثني اتبعوه فسجدوا ثم قاموا بقيامه وقعدوا بقعوده وهكذا صلي رسول الله صلي الله عليه وسلم في غزوة الحديبية بعسفان وخالد بن الوليد بينه وبين القبلة وكان خالد في ماءتي فارس منتبذا من النبي صلي الله عليه وسلم في صحراء ملساء ليس فيها جبل ولا شجر والنبي صلي الله عليه وسلم في الف واربعماءة ولم يكن خالد فيما نري يطمع بقتالهم وانما كان طليعة ياتي بخبرهم ( قال الشافعي ) رحمه الله تعالي واذا جهر الامام في صلاة لا يجهر فيها بالقراءة عمدا فان ابا حنيفة رحمه الله تعالي كان يقول قد اساء وصلاته تامة وكان بن ابي ليلي يقول يعيد بهم الصلاة ( قال الشافعي ) رحمه الله تعالي واذا جهر الامام في الظهر او العصر او خافت في المغرب او العشاء فليس عليه اعادة وقد اساء ان كان عمدا واذا صلي الرجل اربع ركعات بالليل ولم يسلم فيها فان ابا حنيفة رحمه الله تعالي كان يقول لا باس بذلك وكان بن ابي ليلي يقول اكره ذلك له حتي يسلم في كل ركعتين وبه ياخذ ( قال الشافعي ) رحمه الله تعالي صلاة الليل والنهار من النافلة سواء يسلم في كل ركعتين وهكذا جاء الخبر عن النبي صلي الله عليه وسلم في صلاة الليل وقد يروي عنه خبر يثبت اهل الحديث مثله في صلاة النهار ولو لم يثبت كان اذ امر رسول الله صلي الله عليه وسلم في صلاة الليل ان يسلم من كل ركعتين كان معقولا في الخبر عنه انه اراد والله تعالي اعلم الفرق بين الفريضة والنافلة ولا تختلف النافلة في الليل والنهار كما لا تختلف المكتوبة في الليل والنهار لانها موصولة كلها ( قال ) وهكذا ينبغي ان تكون النافلة في الليل والنهار ( قال الشافعي ) رحمه الله تعالي والتكبير علي الجناءز اربع وما علمت احدا حفظ عن النبي صلي الله عليه وسلم من وجه يثبت مثله انه كبر الا اربعا وكان ابو حنيفة يكبر علي الجناءز اربعا وكان بن ابي ليلي يكبر خمسا علي الجناءز ( قال الشافعي ) ويجهر في الصلاة ب بسم الله الرحمن الرحيم قبل ام القران وقبل السورة التي بعدها فان جمع في ركعة سورا جهر ب بسم الله الرحمن الرحيم قبل كل سورة وكان ابو حنيفة رحمه الله تعالي يكره ان يجهر ب بسم الله الرحمن الرحيم وكان بن ابي ليلي يقول اذا جهرت فحسن واذا اخفيت فحسن ( قال ) وذكر عن بن ابي ليلي عن رجل توضا ومسح علي خفيه من حدث ثم نزع الخفين قال يصلي كما هو وحدث بذلك عن الحكم عن ابراهيم وذكر ابو حنيفة رحمه الله تعالي عن حماد عن ابراهيم انه قال لا يصلي حتي يغسل رجليه وبه ياخذ قال الشافعي رحمه الله تعالي واذا صلي الرجل وقد مسح علي خفيه ثم نزعهما احببت له ان لا يصلي حتي يستانف الوضوء لان الطهارة اذا انتقضت عن عضو احتملت ان تكون علي الاعضاء كلها فاذا لم يزد علي غسل رجليه اجزاه وقد روي عن بن عمر انه توضا وخرج الي السوق ثم دعي لجنازة فمسح علي خفيه وصلي وذكر عن الحكم ايضا عن ابراهيم انه قال لا باس بعد الاي في الصلاة ( قال ) ولو ترك عد الاي في الصلاة كان احب الي وان كان انما يعدها عقدا ولا يلفظ بعددها لفظا لم يكن عليه شء وان لفظ بشء من ذلك لفظا فقال واحدة وثنتان وهو ذاكر لصلاته انتقضت صلاته وكان عليه الاستءناف قال واذا توضا الرجل بعض وضوءه ثم لم يتمه حتي جف ما قد غسل فان ابا حنيفة رحمه الله تعالي كان يقول يتم ما قد بقي ولا يعيد علي ما مضي وبه ياخذ وكان بن ابي ليلي يقول ان كان في طلب  الماء او في الوضوء فانه يتم ما بقي وان كان قد اخذ في عمل غير ذلك اعاده علي ما جف ( قال الشافعي ) رحمه الله تعالي ورايت المسلمين جاءوا بالوضوء متتابعا نسقا علي مثل ما توضا به النبي صلي الله عليه وسلم فمن جاء به كذلك ولم يقطعه لغير عذر من انقطاع الماء وطلبه بني علي وضوءه ومن قطعه بغير عذر حتي يتطاول ذلك فيكون معروفا انه اخذ في عمل غيره فاحب الي ان يستانف وان اتم ما بقي اجزاه اخبرنا بن ابي ليلي عن الحكم عن سعيد بن جبير عن بن عباس انه قال لا يمسح وجهه من التراب في الصلاة حتي يتشهد ويسلم وبه ياخذ ابو حنيفة عن حماد عن ابراهيم انه كان يمسح التراب عن وجهه في الصلاة قبل ان يسلم وكان ابو حنيفة رحمه الله تعالي لا يري بذلك باسا وبه ياخذ ( قال الشافعي ) رحمه الله تعالي ولو ترك المصلي مسح وجهه من التراب حتي يسلم كان احب الي فان فعل فلا شء عليه
   * باب الزكاة
  * ( قال الشافعي ) رحمه الله تعالي واذا كان علي رجل دين الف درهم وله علي الناس دين الف درهم وفي يده الف درهم فان ابا حنيفة رضي الله تعالي عنه كان يقول ليس عليه زكاة فيما في يديه حتي يخرج دينه فيزكيه وكان بن ابي ليلي يقول عليه فيما في يديه الزكاة ( قال الشافعي ) رحمه الله تعالي واذا كانت في يدي رجل الف درهم وعليه مثلها فلا زكاة عليه وان كانت المسالة بحالها وله دين الف درهم فلو عجل الزكاة كان احب الي وله ان يءخرها حتي يقبض ماله فان قبضه زكي مما في يديه وان تلف لم يكن عليه فيه زكاة ( قال الربيع ) اخر قول الشافعي اذا كانت في يديه الف وعليه الف فعليه الزكاة قال الربيع من قبل ان الذي في يديه ان تلف كان منه وان شاء وهبها وان شاء تصدق بها فلما كانت في جميع احكامها مالا من ماله وقد قال الله عز وجل @QB@ خذ من اموالهم صدقة @QE@ كانت عليه فيها الزكاة قال وكان بن ابي ليلي يقول زكاة الدين علي الذي هو عليه فقال ابو حنيفة رحمه الله تعالي بل هي علي صاحبه الذي هو له اذا خرج كذلك بلغنا عن علي بن ابي طالب رضي الله عنه وبهذا ياخذ ( قال الشافعي ) رحمه الله تعالي واذا كان للرجل دين علي الناس فان كان حالا وقد حال عليه الحول في يدي الذي هو عليه او اكثر من حول فان كان يقدر علي اخذه منه فتركه فعليه فيه الزكاة وهو كمال له وديعة في يدي رجل عليه ان يزكيه اذا كان قادرا عليه وان كان لا يدري لعله سيفلس له به او كان متغيبا عنه فعليه اذا كان حاضرا طلبه منه بالح ما يقدر عليه فاذا نض في يديه فعليه الزكاة لما مضي في يديه من السنين فان تلف قبل ان يقبضه فلا زكاة عليه فيه وهكذا اذا كان صاحب الدين متغيبا عنه قال واذا كانت ارض من ارض الخراج فان ابا حنيفة رحمه الله تعالي كان يقول ليس فيها عشر لا يجتمع عشر وخراج وبه ياخذ وكان بن ابي ليلي يقول عليه فيها العشر مع الخراج ( قال الشافعي ) رحمه الله تعالي واذا زرع الرجل ارضا من ارض الخراج فعليه في زرعها العشر كما يكون عليه في زرع ارض لرجل تكاراها منه وهي لذلك الرجل او هي صدقة موقوفة قال واذا كانت الارض من ارض العشر فان ابا حنيفة رحمه الله تعالي كان يقول في كل قليل وكثير اخرجت من الحنطة والشعير والزبيب والتمر والذرة وغير ذلك من اصناف الغلة العشر ونصف العشر والقليل والكثير في ذلك سواء وان كانت حزمة من بقل وكذلك حدثنا ابو حنيفة عن حماد عن ابراهيم وكان بن ابي ليلي يقول ليس في شء من ذلك عشر الا في الحنطة والشعير والتمر ( ( ( والثمر ) ) ) والزبيب ولا يكون فيه العشر حتي يبلغ خمسة اوسق فصاعدا والوسق عندنا ستون صاعا والصاع مختوم بالحجاجي وهو ربع بالهاشمي الكبير وهو ثمانية ارطال والمد رطلان وبه ياخذ وقال ابو يوسف رحمه الله تعالي ليس في البقول والخضراوات عشر ولا اري في شء من ذلك عشرا الا الحنطة والشعير والحبوب وليس فيه شء حتي يبلغ خمسة اوسق ( قال الشافعي ) رحمه الله تعالي  واذا زرع الرجل ارضا من ارض العشر فلا زكاة عليه حتي يخرج منها خمسة اوسق من كل صنف مما اخرجت مما فيه الزكاة وذلك ثلاثماءة صاع بصاع النبي صلي الله عليه وسلم ( قال الشافعي ) رحمه الله تعالي وليس في الخضر زكاة والزكاة فيما اقتيت ويبس وادخر مثل الحنطة والذرة والشعير والزبيب والحبوب التي في هذا المعني التي ينبت الناس قال واذا كان لرجل احدي واربعون بقرة فان ابا حنيفة رحمه الله تعالي كان يقول اذا حال عليها الحول ففيها مسنة وربع عشر مسنة وما زاد فبحساب ذلك الي ان تبلغ ستين بقرة واظنه حدثه ابو حنيفة عن حماد عن ابراهيم وكان بن ابي ليلي يقول لا شء في الزيادة علي الاربعين حتي تبلغ ستين بقرة وبه ياخذ وبلغنا عن رسول الله صلي الله عليه وسلم انه قال لا شء في الاوقاص والاوقاص عندنا ما بين الفريضتين وبه ياخذ ( قال الشافعي ) رحمه الله تعالي وليس في البقر صدقة حتي تبلغ ثلاثين فاذا بلغت ثلاثين ففيها تبيع ثم ليس في الزيادة علي الثلاثين صدقة حتي تبلغ اربعين فاذا بلغت اربعين ففيها مسنة ثم ليس في زيادتها شء حتي تبلغ ستين فاذا بلغت ستين ففيها تبيعان ثم ليس في الفضل علي الستين صدقة حتي تبلغ سبعين فاذا بلغت سبعين ففيها تبيع ومسنة ثم ليس في الفضل علي السبعين صدقة حتي تبلغ ثمانين فاذا بلغت الثمانين ففيها مسنتان ثم هكذا صدقتها وكل صدقة من الماشية فلا شء فيها فيما بين الفريضتين وكل ما كان فوق الفرض الاسفل لم يبلغ الفرض الاعلي فالفضل فيه عفو صدقته صدقة الاسفل قال واذا كان للرجل عشرة مثاقيل ذهب وماءة درهم فحال عليها الحول فان ابا حنيفة رحمه الله تعالي كان يقول في الزكاة يضيف اقل الصنفين الي اكثرهما ثم يزكيه ان كانت الدنانير اقل من عشرة دراهم بدينار تقوم الدراهم دنانير ثم يجمعها جميعا فتكون اكثر من عشرين مثقالا من الذهب فيزكيها في كل عشرين مثقالا نصف مثقال فما زاد فليس فيه شء من الزكاة حتي يبلغ اربعة مثاقيل فيكون فيها عشر مثقال واذا كانت الدنانير اكثر من عشرة دراهم بدينار قوم الدنانير دراهم واضافها الي الدراهم فتكون اكثر من ماءتي درهم ففي كل ماءتين خمسة دراهم ولا شء فيما زاد علي الماءتين حتي يبلغ اربعين درهما فاذا بلغت ففي كل اربعين زادت بعد الماءتين درهم وكان بن ابي ليلي يقول لا زكاة في شء من ذلك حتي يبلغ الذهب عشرين مثقالا وتبلغ الفضة ماءتي درهم ولا يضيف بعضها الي بعض ويقول هذا مال مختلف بمنزلة رجل له ثلاثون شاة وعشرون بقرة واربعة ابعرة فلا يضاف بعضها الي بعض وقال بن ابي ليلي ما زاد علي الماءتي الدرهم والعشرين المثقال من شء فبحساب ذلك ما كان من قليل او كثير وبهذا ياخذ في الزيادة وقال ابو حنيفة رضي الله تعالي عنه ليس فيما زاد علي الماءتين شء حتي يبلغ اربعين درهما وكذلك بلغنا عن عمر بن الخطاب رضي الله عنه وقال ابو يوسف رحمه الله تعالي لا يقوم الذهب ولا الفضة انما الزكاة علي وزنه جاءت بذلك السنة ان كان له منها خمسة عشر مثقالا ذهبا لم يكن عليه فيها زكاة ولو كان قيمتها الف درهم لان الحديث انما جاء في عشرين مثقالا ولو كان له مع ذلك اربعون درهما لم يزكه حتي يكون خمسين درهما فاذا كمل من الاخري اوجبت فيه الزكاة وكذلك لو كان نصف من هذا ونصف من هذا ففيه الزكاة فيضيف بعضه الي بعض ويخرجه دراهم او دنانير وان شاء زكي الذهب والفضة بحصتهما اي ذلك فعل اجزاه ولو كان له ماءتا درهم وعشرة مثاقيل زكي الماءتي الدرهم بخمسة دراهم وزكي العشرة مثاقيل بربع مثقال ( قال الشافعي ) رحمه الله تعالي واذا كانت لرجل عشرة مثاقيل ذهب وماءة درهم فحال عليها الحول فلا زكاة فيها ولا يضم الذهب الي الورق وهو صنف غيرها يحل الفضل في بعضها علي بعض يدا بيد كما لا يضم التمر الي الزبيب وللتمر بالزبيب اشبه من الفضة بالذهب واقرب ثمنا بعضه من بعض وكما لا تضم الابل الي البقر ولا البقر الي الغنم قال ولو ان رجلا له ماءتا درهم وعشرة مثاقيل ذهبا فان ابا حنيفة رضي الله عنه كان يقول اذا حال عليها الحول يضيف بعضه الي بعض ويزكيه كله وقال بن ابي ليلي هذان مالان  مختلفان تجب الزكاة علي الدراهم ولا تجب علي الذهب وقال ابو يوسف فيه الزكاة كله الا تري ان التاجر يكون له المتاع للتجارة وهو مختلف فيقومه ويضيف بعضه الي بعض ويزكيه وكذلك الذهب والفضة وقد بلغنا عن عمر بن الخطاب رضي الله عنه انه امر رجلا تاجرا ان يقوم تجارته عند الحول فيزكيها ( قال الشافعي ) رحمه الله تعالي ولو كان له ماءتا درهم وتسعة عشر مثقالا زكي الماءتين ولم يزك التسعة عشر مثقالا كما يكون له خمسة اوسق تمرا وخمسة اوسق زبيبا الا صاعا فيزكي التمر ولا يزكي الزبيب
   * باب الصيام
  * ( قال الشافعي ) رحمه الله تعالي واذا اكتحل الرجل في شهر رمضان او غير رمضان وهو صاءم فان ابا حنيفة رحمه الله تعالي كان يقول لا باس بذلك وبه ياخذ وكان بن ابي ليلي يكره ذلك ويكره ان يدهن شاربه بدهن يجد طعمه وهو صاءم ( قال الشافعي ) رحمه الله تعالي لا باس ان يكتحل الصاءم ويدهن شاربه وراسه ووجهه وقدميه وجميع بدنه باي دهن شاء غالية او غير غالية واذا صام الرجل يوما من شهر رمضان فشك انه من شهر رمضان ثم علم بعد ذلك انه من رمضان فان ابا حنيفة رحمه الله تعالي قال يجزيه وبه ياخذ وكان بن ابي ليلي يقول لا يجزيه ذلك وعليه قضاء يوم مكانه ( قال الشافعي ) رحمه الله تعالي واذا اصبح الرجل يوم الشك من رمضان وقد بيت الصوم من الليل علي انه من رمضان فهذه نية كاملة تءدي عنه ذلك اليوم ان كان من شهر رمضان وان لم يكن من شهر رمضان افطر ( قال الربيع ) قال الشافعي في موضع ( ( ( موضح ) ) ) اخر لا يجزيه لانه صام علي الشك واذا افطرت المراة يوما من رمضان متعمدة ثم حاضت من اخر النهار فان ابا حنيفة رحمه الله تعالي كان يقول ليس عليها كفارة وعليها القضاء وبه ياخذ وكان بن ابي ليلي يقول عليها الكفارة وعليها القضاء ( قال الشافعي ) رحمه الله تعالي واذا اصاب الرجل امراته في شهر رمضان ثم مرض الرجل في اخر يومه فذهب عقله او حاضت المراة فقد قيل علي الرجل عتق رقبة وقيل لا شء عليه فاما اذا سافر فان عليه عتق رقبة وذلك ان السفر شء يحدثه فلا يسقط عنه ما وجب عليه بشء يحدثه ( قال ) واذا وجب علي الرجل صوم شهرين من كفارة افطار من رمضان فان ابا حنيفة رحمه الله تعالي كان يقول ذانك الشهران متتابعان ليس له ان يصومهما الا متتابعين وذكر ابو حنيفة نحوا من ذلك عن النبي صلي الله عليه وسلم وبه ياخذ وكان بن ابي ليلي يقول ليسا بمتتابعين ( قال الشافعي ) رحمه الله تعالي واذا لم يجد المجامع في شهر رمضان عتقا فصام لم يجز عنه الا شهران متتابعان وكفارته كفارة الظهار ولا يجزء عنه الصوم ولا الصدقة وهو يجد عتقا ( قال ) واذا توضا الرجل للصلاة المكتوبة فدخل الماء حلقه وهو صاءم في رمضان ذاكرا لصومه فان ابا حنيفة رحمه الله تعالي كان يقول ان كان ذاكرا لصومه حين توضا فدخل الماء حلقه فعليه القضاء وان كان ناسيا لصومه فلا قضاء عليه وذكر ذلك ابو حنيفة عن حماد عن ابراهيم وكان بن ابي ليلي يقول لا قضاء عليه اذا توضا لصلاة مكتوبة وان كان ذاكرا لصومه وقد ذكر عن عطاء عن بن عباس رضي الله عنهما انه قال اذا توضا لصلاة مكتوبة وهو صاءم فدخل الماء حلقه فلا شء عليه وان كان توضا لصلاة تطوع فعليه القضاء ( قال الشافعي ) رحمه الله تعالي واذا توضا الرجل للصلاة وهو صاءم فتمضمض ودخل الماء جوفه وهو ناس لصومه فلا شء عليه ولو شرب وهو ناس لم ينقض ذلك صومه واذا كان ذاكرا لصومه فدخل الماء جوفه فاحب الي ان يعيد الصوم احتياطا واما الذي يلزمه فلا يلزمه ان يعيد حتي يكون احدث شيءا من ازدراد او فعل فعلا ليس له دخل به الماء جوفه فاما اذا كان انما اراد المضمضة فسبقه شء في حلقه بلا احداث ازدراد تعمد به الماء الا ادخال النفس واخراجه فلا يجب عليه ان يعيد الصوم وهذا خطا في معني النسيان او اخف منه 
   * باب في الحج
  * ( قال الشافعي ) رحمه الله تعالي وكان ابو حنيفة رحمه الله تعالي يقول لا تشعر البدن ويقول الاشعار مثلة وكان بن ابي ليلي يقول الاشعار في السنام من الجانب الايسر وبه ياخذ ( قال الشافعي ) رحمه الله تعالي وتشعر البدن في اسنمتها والبقر في اسنمتها او مواضع الاسنمة ولا تشعر الغنم والاشعار في الصفحة اليمني وكذلك اشعر رسول الله صلي الله عليه وسلم وروي عن بن عباس رضي الله تعالي عنهما عن النبي صلي الله عليه وسلم انه اشعر في الشق الايمن وبذلك تركنا قول من قال لا يشعر الا في الشق الايسر وقد روي ان بن عمر اشعر في الشق الايسر اخبرنا مسلم بن خالد عن بن جريج عن نافع ان عبد الله بن عمر رضي الله تعالي عنهما كان لا يبالي في اي الشقين اشعر في الايمن او الايسر قال واذا اهل الرجل بعمرة فافسدها فقدم مكة وقضاها فان ابا حنيفة رضي الله تعالي عنه كان يقول يجزيه ان يقضيها من التنعيم وبه ياخذ وكان بن ابي ليلي يقول لا يجزيه ان يقضيها الا من ميقات بلاده ( قال الشافعي ) رحمه الله تعالي واذا اهل الرجل بعمرة من ميقات فافسدها فلا يجزيه ان يقضيها الا من الميقات الذي ابتدا منه العمرة التي افسدها ولا نعلم القضاء في شء من الاعمال الا بعمل مثله فاما عمل اقل منه فهذا قضاء لبعض دون الكل وانما يجزء قضاء الكل لا البعض ومن قال له ان يقضيها خارجا من الحرم دخل عليه خلاف ما وصفنا من القياس وخلاف الاثار وقد ظننت انه انما ذهب الي ان عاءشة رضي الله تعالي عنها انما كانت مهلة بعمرة وانها رفضت العمرة وامرها النبي صلي الله عليه وسلم بان تقضيها من التنعيم وهذا ليس كما روي انما امرها النبي صلي الله عليه وسلم ان تدخل الحج علي العمرة فكانت قارنة وانما كانت عمرتها شيءا استحبته فامرها النبي صلي الله عليه وسلم بها فاعتمرت لا ان عمرتها كانت قضاء واذا اصاب الرجل من صيد البحر شيءا سوي السمك فان ابا حنيفة رضي الله تعالي عنه كان يقول لا خير في شء من صيد البحر سوي السمك وبه ياخذ وكان بن ابي ليلي يقول لا باس بصيد البحر كله ( قال الشافعي ) رضي الله تعالي عنه ولا باس بان يصيد المحرم جميع ما كان معاشه في الماء من السمك وغيره قال الله عز وجل @QB@ احل لكم صيد البحر وطعامه متاعا لكم وللسيارة وحرم عليكم صيد البر ما دمتم حرما @QE@ فقال بعض اهل العلم بالتفسير طعامه كل ما كان فيه وهو يشبه ( ( ( شبه ) ) ) ما قال والله تعالي اعلم وقال ابو يوسف رحمه الله سالت ابا حنيفة رضي الله تعالي عنه عن حشيش الحرم فقال اكره ان يرعي من حشيش الحرم شيءا او يحتش منه قال وسالت بن ابي ليلي عن ذلك فقال لا باس ان يحتش من الحرم ويرعي منه قال وسالت الحجاج بن ارطاة فاخبرني انه سال عطاء بن ابي رباح فقال لا باس ان يرعي وكره ان يحتش وبه ياخذ ( قال الشافعي ) رحمه الله تعالي ولا باس ان يرعي نبات الحرم شجره ومرعاه ولا خير في ان يحتش منه شء لان الذي حرم رسول الله صلي الله عليه وسلم من مكة ان يختلي خلاها الا الاذخر والاختلاء الاحتشاش نتفا وقطعا وحرم ان يعضد شجرها ولم يحرم ان يرعي قال ابو يوسف رحمه الله تعالي سالت ابا حنيفة رضي الله عنه قال لا باس ان يخرج من تراب الحرم وحجارته الي الحل وبه ياخذ قال وسمعت بن ابي ليلي يحدث عن عطاء بن ابي رباح عن بن عباس وبن عمر رضي الله تعالي عنهم انهما كرها ان يخرج من تراب الحرم وحجارته الي الحل شيءا وحدثنا شيخ عن رزين مولي علي بن عبد الله بن عباس ان علي بن عبد الله كتب اليه ان يبعث اليه بقطعة من المروة يتخذها مصلي يسجد عليه ( قال الشافعي ) رحمه الله تعالي لا خير في ان يخرج من حجارة الحرم ولا ترابه شء الي الحل لان له حرمة ثبتت باين بها ما سواها من البلدان ولا اري والله تعالي اعلم ان جاءزا لاحد ان يزيله  من الموضع الذي باين به البلدان الي ان يصير كغيره ( قال الشافعي ) وقد اخبرنا عبد الرحمن بن الحسن بن القاسم الازرق عن ابيه عن عبد الاعلي بن عبد الله بن عامر قال قدمت مع امي او قال جدتي مكة فاتتها صفية بنت شيبة فاكرمتها وفعلت بها فقالت صفية ما ادري ما اكافءها به فارسلت اليها بقطعة من الركن فخرجت بها فنزلنا اول منزل فذكر من مرضهم وعلتهم جميعا قال فقالت امي او جدتي ما ارانا اتينا الا انا اخرجنا هذه القطعة من الحرم فقالت لي وكنت امثلهم انطلق بهذه القطعة الي صفية فردها وقل لها ان الله جل وعلا وضع في حرمه شيءا فلا ينبغي ان يخرج منه قال عبد الاعلي فقالوا لي فما هو الا ان تحينا ( ( ( تجينا ) ) ) دخولك الحرم فكانما انشطنا من عقل ( قال الشافعي ) رحمه الله تعالي وقال غير واحد من اهل العلم لا ينبغي ان يخرج من الحرم شء الي غيره واذا اصاب الرجل حماما من حمام الحرم فان ابا حنيفة رحمه الله كان يقول عليه قيمته وبه ياخذ وكان بن ابي ليلي يقول عليه شاة وسمعت بن ابي ليلي يقول في حمام الحرم عن عطاء بن ابي رباح شاة ( قال الشافعي ) رحمه الله تعالي واذا اصاب الرجل بمكة حماما من حمامها فعليه شاة اتباعا لعمر وعثمان وبن عباس وبن عمر ونافع بن عبد الحارث وعاصم بن عمر وعطاء وبن المسيب وغيرهم رضوان الله تعالي عليهم اجمعين وقد زعم الذي قال فيه قيمة انه لا يخالف واحدا من اصحاب رسول الله صلي الله عليه وسلم وقد خالف اربعة في حمام مكة وسءل ابو حنيفة رحمه الله تعالي عن المحرم يصيب الصيد فيحكم عليه فيه عناق او جفرة او شبه ذلك فقال لا يجزء في هدي الصيد الا ما يجزء في هدي المتعة الجذع من ( ( ( بن ) ) ) الضان اذا كان عظيما او الثني من المعز والبقر والابل فما فوق ذلك لا يجزء ما دون ذلك الا تري الي قول الله عز وجل في كتابه في جزاء الصيد @QB@ هديا بالغ الكعبة @QE@ وسالت بن ابي ليلي عن ذلك فقال يبعث به وان كان عناقا او حملا قال ابو يوسف رحمه الله اخذ بالاثر في العناق والجفرة وقال ابو حنيفة رحمه الله في ذلك كله قيمته وبه ياخذ ( قال الشافعي ) رحمه الله تعالي واذا اصاب الرجل صيدا صغيرا فداه بشاة صغيرة لان الله عز وجل يقول مثل والمثل مثل الذي يفدي فاذا كان كبيرا كان كبيرا واذا كان الذي يفدي صغيرا كان صغيرا ولا اعلم من قال لا يجوز ان يفدي الصيد الصغير بصغير مثله من الغنم الا خالف القران والاثار والقياس والمعقول واذا كان يزعم ان الصيد محرم كله فزعم انه تفدي الجرادة بتمرة او اقل من تمرة لصغرها وقلة قيمتها وتفدي بقرة الوحش ببقرة لكبرها فكيف لم يزعم انه يفدي الصغير بالصغير وقد فدي الصغير بصغير والكبير بكبير وقد قال الله عز وجل @QB@ فجزاء مثل ما قتل من النعم @QE@ وانما رفع وخفض بالمثل عنده فكيف يفدي بتمرة ولا يفدي بعناق وما للضحايا وهدي المتعة وجزاء الصيد هل راه قياس جزاء الصيد حين اصاب المحرم البقرة بان قال يكفيه شاة كما يكفي المتمتع او المضحي او قاسه حين اصاب المحرم جرادة بان قال لا يجزء المحرم الا شاة كما لا يجزء المضحي والمتمتع الا شاة فان قال لا قيل الان جزاء الصيد كما قال الله تبارك وتعالي مثل وانما المثل صغيرا او كبيرا علي قدر المصاب فان قال نعم قيل فما اضلك عن الجفرة اذا كانت مثل ما اصيب وان كنت تقلد عمر بن الخطاب رضي الله تعالي عنه وحده في اقضية لا حجة لك في شء منها الا تقليده فكيف خالفته ومعه القران والقياس والمعقول وغيره من اصحاب النبي صلي الله عليه وسلم وقد قضي عمر رضي الله عنه في الارنب بعناق وفي اليربوع بجفرة وقضي في الضب بجدي قد جمع الماء والشجر وقضي بن مسعود رضي الله عنه في اليربوع بجفرة او جفر وقضي عثمان رضي الله عنه في ام حبين بحلان من الغنم يعني حملا وذكر عن خصيف الجزري عن ابي عبيدة عن عبد الله بن مسعود انه قال في بيض النعامة يصيبه المحرم ثمنه واخبرنا داود بن ابي هند عن عامر مثله وسمعت بن ابي ليلي يقول عن عطاء بن ابي رباح في البيضة  درهم وقال ابو حنيفة رحمه الله قيمتها ( قال الشافعي ) رحمه الله تعالي واذا اصاب المحرم بيض نعام او بيض حمام او بيضا من الصيد ففيه قيمته قياسا علي الجرادة وعلي ما لم يكن له مثل من النعم
   * باب الديات
  * ( قال الشافعي ) رحمه الله تعالي واذا قتل الرجل الرجل عمدا وللمقتول ورثة صغار وكبار فان ابا حنيفة رحمه الله تعالي كان يقول للكبار ان يقتلوا صاحبهم ان شاءوا وكان بن ابي ليلي يقول ليس لهم ان يقتلوا حتي يكبر الاصاغر وبه ياخذ حدثنا ابو يوسف عن رجل عن ابي جعفر ان الحسن بن علي رضي الله عنهما قتل بن ملجم بعلي وقال ابو يوسف وكان لعلي رضي الله عنه اولاد صغار ( قال الشافعي ) رحمه الله تعالي واذا قتل الرجل الرجل عمدا وله ورثة صغار وكبار او كبار غيب فليس لاحد منهم ان يقتل حتي تبلغ الصغار وتحضر الغيب ويجتمع من له سهم في ميراثه من زوجة او ام او جدة علي القتل فاذا اجتمعوا كان لهم ان يقتلوا فاذا لم يجتمعوا لم يكن لهم ان يقتلوا واذا كان هذا هكذا فلايهم شاء من البالغين الحضور ان ياخذ حصته من الدية من مال الجاني بقدر ميراثه من المقتول واذا فعل كان لاولياء الغيب وعلي اولياء الصغار ان ياخذوا لهم حصصهم من الدية لان القتل قد حال وصار مالا فلا يكون لولي الصغير ان يدعه وقد امكنه اخذه فان قال قاءل كيف ذهبت الي هذا دون غيره من الاقاويل وقد قال بعض اهل العلم اي ولاة الدم قام به قتل وان عفا الاخرون فانزله بمنزلة الحد وقال غيره من اهل العلم يقتل البالغون ولا ينتظرون الصغار وقال غيره يقتل الولد ولا ينتظرون الزوجة قيل ذهبنا اليه انه السنة التي لا ينبغي ان تخالف او في مثل معني السنة والقياس علي الاجماع فان قال فاين السنة فيه قيل قال رسول الله صلي الله عليه وسلم من قتل له قتيل فاهله بين خيرتين ان احبوا اخذوا القصاص وان احبوا فالدية فلما كان من حكم رسول الله صلي الله عليه وسلم ان لولاة الدم ان يقتلوا ولهم ان ياخذوا المال وكان اجماع المسلمين ان الدية موروثة لم يحل لوارث ان يمنع الميراث من ورث معه حتي يكون الوارث يمنع نفسه من الميراث وهذا معني القران في قول الله عز وجل @QB@ فمن عفي له من اخيه شء فاتباع بالمعروف واداء اليه باحسان @QE@ وهذا مكتوب في كتاب الديات ووجدنا ما خالفه من الاقاويل لا حجة فيه لما وصفت من السنة بخلافهم ووجدت مع ذلك قولهم متناقضا اذ زعموا انهم امتنعوا من ان ياخذوا الدية من القاتل لانه انما عليه دم لا مال فلو زعموا ان واحدا من الورثة لو عفا حال الدم مالا ما لزموا قولهم ولقد نقضوه فاما الذين قالوا هو كالحد يقوم به اي الورثة شاء وان عفا غيره فقد خالفوا بينه وبين الحد من اجل انهم يزعمون ان للورثة العفو عن القتل ويزعمون انه لا عفو لهم عن الحد ويزعمون انهم لو اصطلحوا في القتل علي الدية جاز ذلك ويزعمون انهم لو اصطلحوا علي مال في الحد لم يجز واذا اقتتل القوم فانجلوا عن قتيل لم يدر ايهم اصابه فان ابا حنيفة رحمه الله تعالي كان يقول هو علي عاقلة القبيلة التي وجد فيها اذا لم يدع ذلك اولياء القتيل علي غيرهم وكان بن ابي ليلي رحمه الله تعالي يقول هو علي عاقلة الذين اقتتلوا جميعا الا ان يدعي اولياء القتيل علي غير اولءك وبهذا ياخذ ( قال الشافعي ) رحمه الله تعالي واذا اقتتل القوم فانجلوا عن قتيل فادعي اولياءه علي احد بعينه او علي طاءفة بعينها او قالوا قد قتلته احدي الطاءفتين لا يدري ايتهما قتلته قيل لهم ان جءتم بما يوجب القسامة علي احدي الطاءفتين او بعضهم او واحد بعينه او اكثر قيل لكم اقسموا علي واحد فان لم تاتوا مالك فلا عقل ولا قود ومن شءتم ان نحلفه لكم علي قتله احلفناه ومن احلفناه ابراناه وهكذا ان كان جريحا ثم مات ادعي علي احد او لم يدع عليه اذا لم اقبل دعواه فيما هو اقل من الدم لم اقبلها في الدم وما اعرف اصلا ولا فرعا لقول  من قال تجب القسامة بدعوي الميت وما القسامة التي قضي فيها رسول الله صلي الله عليه وسلم في عبد الله بن سهل الا علي خلاف ما قال فيها دعوي ولا لوث من بينة واذا اصيب الرجل وبه جراحة فاحتمل فلم يزل مريضا حتي مات فان ابا حنيفة رضي الله تعالي عنه كان يقول ديته علي تلك القبيلة التي اصيب فيهم وبه ياخذ وكان بن ابي ليلي يقول ليس عليهم شء وكان ابو حنيفة رحمه الله تعالي يقول القصاص لكل وارث وبه ياخذ وكان بن ابي ليلي يجعل لكل وارث قصاصا الا الزوج والمراة ( قال الشافعي ) رحمه الله تعالي الزوج والمراة الحرة والجدة وبنت الابن وكل وارث من ذكر او انثي فله حق في القصاص وفي الدية واذا وجد القتيل في قبيلة فان ابا حنيفة رحمه الله تعالي كان يقول القسامة علي اهل الخطة والعقل عليهم وليس علي السكان ولا علي المشترين شء وبه ياخذ ثم قال ابو يوسف رحمه الله تعالي بعد علي المشترين والسكان واهل الخطة وكان بن ابي ليلي يقول الدية علي السكان والمشترين معهم واهل الخطة وكذلك اذا وجد في الدار فهو علي اهل القبيلة قبيلة تلك الدار والسكان الذين فيها في قول بن ابي ليلي وكان ابو حنيفة رحمه الله تعالي يقول علي عاقلة ارباب الدور خاصة وان كانوا مشترين واما السكان فلا وبهذا ياخذ رجع ابو يوسف رحمه الله تعالي الي قول بن ابي ليلي وقول ابي حنيفة المعروف ما بقي من اهل الخطة رجل فليس علي المشتري شء ( قال الشافعي ) رحمه الله تعالي واذا وجد الرجل قتيلا في دار رجل او اهل خطة او سكان او صحراء او عسكر فكلهم سواء لا عقل ولا قود الا ببينة تقوم او بما يوجب القسامة فيقسم الاولياء فاذا ادعي الاولياء علي واحد والف احلفناهم وابراناهم لان النبي صلي الله عليه وسلم قال للانصاريين فتبرءكم يهود بخمسين يمينا فلما ابوا ان يقبلوا ايمانهم لم يجعل علي يهود شيءا وقد وجد القتيل بين اظهرهم ووداه النبي صلي الله عليه وسلم من عنده متطوعا واذا قطع رجل يد امراة او امراة يد رجل فان ابا حنيفة رضي الله عنه كان يقول ليس في هذا قصاصا ( ( ( القصاص ) ) ) ولا قصاص فيما بين الرجال والنساء فيما دون النفس ولا فيما بين الاحرار والعبيد فيما دون النفس ولا قصاص بين الصبيان في النفس ولا غيرها وكذلك حدثنا ابو حنيفة عن حماد عن ابراهيم وبه ياخذ وكان بن ابي ليلي يقول القصاص بينهم في ذلك وفي جميع الجراحات التي يستطاع فيها القصاص ( قال الشافعي ) رحمه الله تعالي القصاص بين الرجل والمراة في الجراح وفي النفس وكذلك العبيد بعضهم من بعض واذا كانوا يقولون القصاص بينهم في النفس وهي الاكثر كان الجرح الذي هو الاقل اولي لان الله عز وجل ذكر النفس والجراح في كتابه ذكرا واحدا واما الصبيان فلا قصاص بينهم واذا قتل الرجل رجلا بعصا او بحجر فضربه ضربات حتي مات من ذلك فان ابا حنيفة رحمه الله تعالي كان يقول لا قصاص بينهما وكان بن ابي ليلي يقول بينهما القصاص وبه ياخذ ( قال الشافعي ) رحمه الله تعالي واذا اصاب الرجل الرجل بحديدة تمور او بشء يمور فمار فيه موران الحديد فمات من ذلك ففيه القصاص واذا اصابه بعصا او بحجر او ما لا يمور موران السلاح فاصله شيءان ان كان ضربه بالحجر العظيم والخشبة العظيمة التي الاغلب منها انه لا يعاش من مثلها وذلك ان يشدخ بها راسه او يضرب بها جوفه او خاصرته او مقتلا من مقاتله او حمل عليه الضرب بشء اخف من ذلك حتي بلغ من ضربه ما الاغلب عند الناس ان لا يعاش من مثله قتل به وكان هذا عمد القتل وزيادة انه اشد من القتل بالحديد لان القتل بالحديد اوحي وان ضربه بالعصا او السوط ( ( ( السوق ) ) ) او الحجر الضرب الذي الاغلب منه انه يعاش من مثله فهذا الخطا شبه العمد ففيه الدية مغلظة ولا قود فيه واذا عض الرجل يد الرجل فانتزع المعضوض يده فقلع سنا من اسنان العاض فان ابا حنيفة رحمه الله تعالي كان يقول لا ضمان عليه في السن لانه قد كان له ان ينزع يده من فيه وبه ياخذ وقد بلغنا عن رسول الله صلي الله عليه وسلم ان رجلا عض يد رجل فانتزع  يده من فيه فنزع ثنيته فابطلها رسول الله صلي الله عليه وسلم وقال ايعض احدكم اخاه عض الفحل وكان بن ابي ليلي يقول هو ضامن لدية السن وهما يتفقان فيما سوي ذلك مما يجني في الجسد سواء في الضمان ( قال الشافعي ) رحمه الله تعالي واذا عض الرجل يد الرجل او رجله او بعض جسده فانتزع المعضوض ما عض منه من في العاض فسقط بعض ثغره او كله فلا شء عليه لانه كان للمعضوض ان ينزع يده من في العاض ولم يكن متعديا بالانتزاع فيضمن وقد قضي رسول الله صلي الله عليه وسلم في مثل هذا ( قال الشافعي ) رحمه الله تعالي اخبرنا مسلم بن خالد عن بن جريج عن عطاء عن صفوان بن يعلي بن امية عن ابيه ان رجلا عض يد رجل فانتزع المعضوض يده من في العاض فسقطت ثنيته او ثنيتاه فاهدرها رسول الله صلي الله عليه وسلم وقال ايدع يده في فيك تقضمها كانها في فحل واذا نفحت الدابة برجلها وهي تسير فان ابا حنيفة رحمه الله تعالي كان يقول لا ضمان علي صاحبها لانه بلغنا عن رسول الله صلي الله عليه وسلم انه قال الرجل جبار وبه ياخذ وكان بن ابي ليلي يقول هو ضامن في هذا لما اصابت ( قال الشافعي ) رحمه الله تعالي يضمن قاءد الدابة وساءقها وراكبها ما اصابت بيد او فم او رجل او ذنب ولا يجوز الا هذا (  ) ولا يضمن شيءا الا ان يحملها علي ان تطا شيءا فيضمن لان وطاها من فعله فتكون ( ( ( فنكون ) ) ) حينءذ كاداة من اداته جني بها فاما ان نقول يضمن عن يدها ولا يضمن عن رجلها فهذا تحكم فان قال لا يري رجلها فهو اذا كان ساءقا لا يري يدها فينبغي ان يقول في الساءق يضمن عن الرجل ولا يضمن عن اليد وليس هكذا بقول فاما ما روي عن رسول الله صلي الله عليه وسلم من ان الرجل جبار فهو والله تعالي اعلم غلط لان الحفاظ لم يحفظوا هكذا وكان ابو حنيفة رحمه الله يقول في الرجل اذا قتل العبد ان قيمته علي عاقلة القاتل وبه ياخذ وكان بن ابي ليلي يقول لا تعقله العاقلة ثم رجع ابو يوسف فقال هو مال لا تعقله العاقلة وعلي القاتل قيمته ما بلغ حالا ( قال الشافعي ) رحمه الله تعالي واذا قتل الرجل العبد خطا عقلته عاقلته لانها انما تعقل جناية حر في نفس محرمة قد يكون فيها القود قال ويكون فيها الكفارة كما تكون في الحر بكل حال فهو بالنفوس اشبه منه بالاموال هو لا يجامع الاموال في معني الا في ان ديته قيمته فاما ما سوي ذلك فهو مفارق للاموال مجامع للنفوس في اكثر احكامه وبالله تعالي التوفيق
   * باب السرقة
  * ( قال الشافعي ) رحمه الله تعالي واذا اقر الرجل بالسرقة مرة واحدة والسرقة تساوي عشرة دراهم فصاعدا فان ابا حنيفة رحمه الله تعالي كان يقول اقطعه ويقول ان لم اقطعه جعلته عليه دينا ولا قطع في الدين وكان بن ابي ليلي يقول لا اقطعه حتي يقر مرتين وبهذا ياخذ ثم رجع الي قول ابي حنيفة ( قال الشافعي ) رحمه الله تعالي واذا اقر الرجل بالسرقة مرة واحدة وثبت علي الاقرار وكانت مما تقطع فيه اليد قطع وسواء اقراره مرة او اكثر فان قال قاءل كما لا اقطعه الا بشاهدين فهو اذا شهد عليه شاهدان قطعه ولم يلتفت الي رجوعه لو كان اقر وهو لو اقر عنده ماءة مرة ثم رجع لم يقطعه فان قال قاءل فهكذا لو رجعت الشهود لم نقطعه قيل لو رجع الشهود عن الشهادة عليه ثم عادوا فشهدوا عليه بما رجعوا عنه لم تقبل شهادتهم ولو اقر ثم رجع ثم اقر قبل منه فالاقرار مخالف للشهادات في البدء والمتعقب وان كان المسروق منه غاءبا فان ابا حنيفة رحمه الله تعالي قال لا اقطعه وبهذا ياخذ وكان بن ابي ليلي يقول اقطعه اذا اقر مرتين وان كان المسروق منه غاءبا  ( قال الشافعي ) رحمه الله تعالي واذا كان المسروق منه غاءبا حبس السارق حتي يحضر المسروق منه لانه لعله ان ياتي له بمخرج يسقط عنه القطع او القطع والضمان وان كانت السرقة تساوي خمسة دراهم فان ابا حنيفة رحمه الله تعالي كان يقول لا قطع فيها بلغنا عن رسول الله صلي الله عليه وسلم وعن علي رضي الله عنه وعن بن مسعود انهم قالوا لا تقطع اليد الا في عشرة دراهم وبهذا ياخذ وكان بن ابي ليلي يقول تقطع اليد في خمسة دراهم ولا تقطع في دونها ( قال الشافعي ) رحمه الله تعالي اخبرنا الثقة عن عبد الله بن عمر بن حفص وسفيان بن عيينة عن الزهري عن عمرة عن عاءشة رضي الله عنها ان رسول الله صلي الله عليه وسلم قال القطع في ربع دينار فصاعدا وبه ناخذ ( قال الشافعي ) رحمه الله تعالي فاما ما ذهب اليه ابو حنيفة من الرواية عن النبي صلي الله عليه وسلم التي تخالف هذا فانها ليست من وجه يثبت مثله لو انفرد واما ما روي عن علي رضي الله عنه وبن مسعود فليست في احد مع النبي صلي الله عليه وسلم حجة ولا اعلمه ثابتا عن واحد منهما وقد اخبرنا سفيان بن عيينة عن حميد الطويل انه سمع قتادة يسال انس بن مالك رحمه الله تعالي عنه عن القطع فقال حضرت ابا بكر الصديق رضي الله عنه قطع سارقا في شء ما يسوي ثلاثة دراهم او قال ما يسرني انه لي بثلاثة دراهم وثبت عن عاءشة رضي الله عنها انها قالت القطع في ربع دينار فصاعدا وهو مكتوب في كتاب السرقة ( قال ) واذا شهد الشاهدان علي رجل بالسرقة والمسروق منه غاءب فان ابا حنيفة رحمه الله كان يقول لا اقبل الشهادة والمسروق منه غاءب ارايت لو قال لم يسرق مني شيءا اكنت اقطع السارق وبه ياخذ وكان بن ابي ليلي يقول اقبل الشهادة عليه واقطع السارق ( قال الشافعي ) رحمه الله تعالي واذا شهد شاهدان علي رجل بسرقة والمسروق منه غاءب قبلت الشهادة وسالت عن الشهود واخرت القطع الي ان يقدم المسروق منه ( قال ) واذا اعترف الرجل بالسرقة مرتين وبالزنا اربع مرات ثم انكر بعد ذلك فان ابا حنيفة رحمه الله تعالي كان يقول ندرا عنه الحد فيهما جميعا ونضمنه السرقة وقد بلغنا عن رسول الله صلي الله عليه وسلم حين اعترف عنده ماعز بن مالك وامر به ان يرجم هرب حين اصابته الحجارة فقال رسول الله صلي الله عليه وسلم فهلا خليتم سبيله حدثنا بذلك ابو حنيفة رحمه الله يرفعه الي النبي صلي الله عليه وسلم وبه ياخذ وكان بن ابي ليلي يقول لا اقبل رجوعه فيهما جميعا وامضي عليه الحد ( قال الشافعي ) رحمه الله تعالي واذا اقر الرجل بالزني او بشرب الخمر او بالسرقة ثم رجع قبلت رجوعه قبل ان تاخذه السياط او الحجارة او الحديد وبعد جاء بسبب او لم يات به عير او لم يعير قياسا علي ان النبي صلي الله عليه وسلم قال في ماعز فهلا تركتموه وهكذا كل حد لله فاما ما كان للادميين فيه حق فيلزمه ولا يقبل رجوعه فيه واغرمه السرقة لانها حق للادميين واذا دخل الرجل من اهل الحرب الينا بامان فسرق عندنا سرقة فان ابا حنيفة رحمه الله كان يقول يضمن السرقة ولا يقطع لانه لم ياخذ الامان لتجري عليه الاحكام وكان بن ابي ليلي يقول تقطع يده وبه ياخذ ثم رجع الي قول ابي حنيفة رضي الله عنه ( قال الشافعي ) رحمه الله تعالي واذا دخل الحربي دار الاسلام بامان فسرق ضمن السرقة ولا يقطع ويقال له ننبذ اليك عهدك ونبلغك مامنك لان هذه دار لا يصلح ان يقيم فيها الا من يجري عليه الحكم ( قال الربيع ) لا يقطع اذا كان جاهلا فان كان عالما قطع ( قال الشافعي ) رحمه الله تعالي لا ينبغي لاحد ان يعطي احدا امانا علي ان لا يجري عليه حكم الاسلام ما دام مقيما في دار الاسلام 
   * باب القضاء
  * ( قال الشافعي ) رحمه الله تعالي واذا اثبت القاضي في ديوانه الاقرار وشهادة الشهود ثم رفع اليه ذلك وهو لا يذكره فان ابا حنيفة رحمه الله كان يقول لا ينبغي له ان يجيزه وكان بن ابي ليلي رحمه الله يجيز ذلك وبه ياخذ قال ابو حنيفة رحمه الله تعالي ان كان يذكره ولم يثبته عنده اجازه وبه ياخذ وكان بن ابي ليلي يقول لا يجيزه حتي يثبته عنده وان ذكره ( قال الشافعي ) رحمه الله واذا وجد القاضي في ديوانه خطا لا يشك انه خطه او خط كاتبه باقرار رجل لاخر او بثبت حق عليه بوجه لم يكن له ان يقضي به حتي يذكر منه او يشهد به عنده كما لا يجوز اذا عرف خطه ولم يذكر الشهادة ان يشهد واذا جاء رجل بكتاب قاض الي قاض والقاضي لا يعرف كتابه ولا خاتمه فان ابا حنيفة رحمه الله كان يقول لا ينبغي للقاضي الذي اتاه الكتاب ان يقبله حتي يشهد شاهدا عدل علي خاتم القاضي وعلي ما في الكتاب كله اذا قرء عليه عرف القاضي الكتاب والخاتم او لم يعرفه ولا يقبله الا بشاهدين علي ما وصفت لانه حق وهو مثل شهادة علي شهادة ثم رجع ابو يوسف رحمه الله وقال لا يقبل الكتاب حتي يشهد الشهود انه قراه عليهم واعطاهم نسخة معهم يحضرونها هذا القاضي مع كتاب القاضي وكان بن ابي ليلي يقول اذا شهدوا علي خاتم القاضي قبل ذلك منهم وبه ياخذ قال الشافعي رحمه الله تعالي واذا شهد الشاهدان علي كتاب القاضي الي القاضي عرف المكتوب اليه كتاب القاضي وخاتمه او لم يعرفه فهو سواء في الحكم ولا يقبل الا بشاهدين عدلين يشهدان ان هذا كتاب فلان قاضي بلد كذا الي فلان قاضي بلد كذا ويشهدان علي ما في الكتاب اما بحفظ له واما بنسخة معهما توافق ما فيه ولا اري ان يقبله مختوما وهما يقولان لا ندري ما فيه لان الخاتم قد يصنع علي الخاتم ويبدل الكتاب واذا قال الخصم للقاضي لا اقر ولا انكر فان ابا حنيفة رحمه الله كان يقول لا اجبره علي ذلك ولكنه يدعو المدعي بشهوده بهذا ياخذ ( قال ) وكان بن ابي ليلي لا يدعه حتي يقر او ينكر وكان ابو يوسف اذا سكت يقول له احلف مرارا فان لم يحلف قضي عليه ( قال الشافعي ) رحمه الله تعالي واذا تنازع الرجلان وادعي احدهما علي الاخر دعوي فقال المدعي عليه لا اقر ولا انكر قيل للمدعي ان اردت ان نحلفه عرضنا عليه اليمين فان حلف برء الا ان تاتي ببينة وان نكل قلنا لك احلف علي دعواك وخذ فان ابيت لم نعطك بنكوله شيءا دون يمينك مع نكوله واذا انكر الخصم الدعوي ثم جاء بشهادة الشهود علي المخرج منه فان ابا حنيفة رحمه الله كان يقول اقبل ذلك منه وبهذا ياخذ وكان بن ابي ليلي يقول لا اقبل منه بعد الانكار مخرجا وتفسير ذلك ان الرجل يدعي قبل الرجل الدين فيقول ماله قبلي شء فيقيم الطالب البينة علي ماله ويقيم الاخر البينة انه قد اوفاه اياه وقال ابو حنيفة المطلوب صادق بما قال ليس قبلي شء وليس قوله هذا باكذاب لشهوده علي البراءة ( قال الشافعي ) رحمه الله واذا ادعي الرجل علي الرجل دينا فانكر المدعي عليه فاقام عليه المدعي بينة فجاء المشهود عليه بمخرج مما شهد به عليه قبلته منه وليس انكاره الدين اكذابا للبينة فهو صادق لانه ليس عليه شء في الظاهر اذا جاء بالمخرج منه ولعله اراد اولا ان يقطع عنه المءنة واذا ادعي رجل قبل رجل دعوي فقال عندي المخرج فان ابا حنيفة رحمه الله كان يقول ليس هذا عندي باقرار انما يقول عندي البراءة وقد تكون عنده ( ( ( عند ) ) ) البراءة من الحق ومن الباطل وبهذا ياخذ وكان بن ابي ليلي يقول هذا اقرار فان جاء بمخرج والا الزمه الدعوي وابو حنيفة يقول ان لم يات بالمخرج لم تلزمه الدعوي الا ببينة ( قال الشافعي ) رحمه الله تعالي واذا ادعي الرجل علي الرجل حقا فقال المدعي عليه عندي منها المخرج فسال المدعي القاضي ان يجعل هذا اقرارا ياخذه به الا ان يجء منه بالمخرج فليس هذا  باقرار لانه قد يكون عنده المخرج بان لا يقر به ولا يوجد عليه بينة ولا ياخذ المدعي الا ببينة يثبتها ويقبل من المدعي عليه المخرج وان شهد عليه قال واذا اقر الرجل عند القاضي بشء فلم يقض به القاضي عليه ولم يثبته في ديوانه ثم خاصمه اليه فيه بعد ذلك فان ابا حنيفة رحمه الله قال اذا ذكر القاضي ذلك امضاه عليه وبهذا ياخذ وكان بن ابي ليلي رحمه الله يقول لا يمضي ذلك عليه وان كان ذاكرا له حتي يثبته في ديوانه ( قال الشافعي ) رحمه الله تعالي واذا اقر الرجل عند الحاكم فاثبت الحاكم اقراره في ديوانه او كان ذاكرا لاقراره ولم يثبت في ديوانه فسواء فان كان ممن ياخذ بالاقرار عنده اخذه به ولا معني للديوان الا الذكر واذا كان القاضي ذاكرا فسواء كان في الديوان او لم يكن ( قال الربيع ) وكان الشافعي يجيز الاقرار عند القاضي وانما كره ان يتكلم باجازته لحال ظلم بعض القضاة
   * باب الفرية
  * ( قال الشافعي ) رحمه الله تعالي واذا قال رجل لرجل من العرب يا نبطي او لست بني فلان لقبيلة فان ابا حنيفة رحمه الله كان يقول لا حد عليه في ذلك وانما قوله هذا مثل قوله يا كوفي يا بصري يا شامي حدثنا ابو يوسف عمن حدثه عن عطاء بن ابي رباح عن بن عباس بذلك واما قوله لست من بني فلان فهو صادق ليس هو من ولد فلان لصلبه وانما هو من ولد الولد ان القذف ها هنا انما وقع علي اهل الشرك الذين كانوا في الجاهلية وبهذا ياخذ وكان بن ابي ليلي يقول فيهما جميعا الحد ( قال الشافعي ) رحمه الله تعالي واذا قال رجل لرجل من العرب يا نبطي وقفته فان قال عنيت نبطي الدار او نبطي اللسان احلفته بالله ما اراد ان ينفيه وينسبه الي النبط فان حلف نهيته عن ان يقول ذلك القول وادبته علي الاذي وان ابي ان يحلف احلفت المقول له لقد اراد نفيك فاذا حلف سالت القاءل عمن نفي فاذا قال ما نفيته ولا قلت ما قال جعلت القذف واقعا علي ام المقول له فان كانت حرة مسلمة حددته ان طلبت الحد فان عفت فلا حد لها وان كانت ميتة فلابنها القيام بالحد وان قال عنيت بالقذف الاب الجاهلي احلفته ما عني به احدا من اهل الاسلام وعزرته ولم احده وان قال لست من بني فلان لجده ثم قال انما عنيت لست من بنيه لصلبه انما انت من بني بنيه لم اقبل ذلك منه وجعلته قاذفا لامه فان طلبت الحد وهي حرة كان لها ذلك الا ان يقول نفيت الجد الاعلي الذي هو جاهلي فاعزره ولا احده لان القذف وقع علي مشركة واذا قال الرجل لرجل لست بن فلان وامه امة او نصرانية وابوه مسلم فان ابا حنيفة رحمه الله تعالي كان يقول لا حد علي القاذف انما وقع القذف ها هنا علي الام ولا حد علي قاذفها وبه ياخذ وكان بن ابي ليلي يقول في ذلك عليه الحد ( قال الشافعي ) رحمه الله تعالي واذا نفي الرجل الرجل من ابيه وام المنفي ذمية او امة فلا حد عليه لان القذف انما وقع علي من لا حد له ولكنه ينكل عن اذي الناس بتعزير لا حد قال واذا قذف رجل رجلا فقال يا بن الزانيين وقد مات الابوان فان ابا حنيفة رحمه الله تعالي كان يقول انما عليه حد واحد لانها كلمة واحدة وبهذا ياخذ قلت ان فرق القول او جمعه فهو سواء وعليه حد واحد وكان بن ابي ليلي يقول عليه حدان ويضربه الحدين في مقام واحد وقد فعل ذلك في المسجد ( قال الشافعي ) رحمه الله واذا قال الرجل للرجل يا بن الزانيين وابواه حران مسلمان ميتان فعليه حدان ولا يضربهما في موقف واحد ولكنه يحد ثم يحبس حتي اذا برا جلده حد حدا ثانيا وكذلك لو فرق القول او جمعه او قذف جماعة بكلمة واحدة او بكلام متفرق فلكل واحد منهم حده الا تري انه لو قذف ثلاثة بالزني فلم يطلب واحد الحد واقر اخر بالزني حد للطالب الثالث حدا تاما ولو كانوا شركاء في الحد ما كان ينبغي ان يضرب الا ثلث حد لان حدين قد سقطا عنه احدهما باعتراف صاحبه والاخر بترك صاحبه الطلب وعفوه واذا كان الحد حقا لمسلم  فكيف يبطل بحال ارايت لو قتل رجل ثلاثة او عشرة معا اما كان عليه لكل واحد منهم دية ان قتلهم خطا وعليه القود ان قتلهم عمدا ودية لكل من لم يقد منه لانهم لا يجدون الي القود سبيلا واذا قال الرجل للرجل يا بن الزانيين او قالت المراة للرجل يا بن الزانيين والابوان حيان فان ابا حنيفة رحمه الله تعالي كان يقول اذا كانا حيين بالكوفة لم يكن علي قاذفهما الحد الا ان ياتيا يطلبان ذلك ولا يضرب الرجل حدين في مقام واحد وان وجبا عليه جميعا وبه ياخذ قال ولا يكون في هذا ابدا الا حد واحد وكان بن ابي ليلي يضربهما جميعا حدين في مقام واحد ويضرب المراة قاءمة ويضربهما حدين في كلمة واحدة ويقيم الحدود في المسجد اظن ابا حنيفة رحمه الله تعالي قال لا ولا يكون علي من قذف بكلمة واحدة او كلمتين او جماعة او فرادي الا حد واحد فان اخذه بعضهم فحد له كان لجميع ما قذف بلغنا عن رسول الله صلي الله عليه وسلم وبه ياخذ وقال لا تقام الحدود في المساجد ( قال الشافعي ) ولا يقام علي رجل حدان وجبا عليه في مقام واحد ولكنه يحد احدهما ثم يحبس حتي يبرا ثم يحد الاخر ولا يحد في مسجد ومن قذف ابا رجل وابوه حي لم يحد له حتي يكون الاب الذي يطلب واذا مات كان للابن ان يقوم بالحد وان كان له عدد بنين فايهم قام به حد له وقال ابو حنيفة رحمه الله لا يضرب الرجل حدين في مقام واحد وان وجبا عليه جميعا ولكنه يقيم عليه احدهما ثم يحبس حتي يخف الضرب ثم يضرب الحد الاخر وانما الحدان في شرب وقذف او زنا وقذف او زنا وشرب فاما قذف كله وشرب كله مرارا او زنا مرارا فانما عليه حد واحد قال ولو كان الابوان المقذوفان حيين كانا بمنزلة الميتين في قول بن ابي ليلي واما في قول ابي حنيفة فلا حق للولد حتي يجء الوالدان او احدهما يطلب قذفه وانما عليه حد واحد في ذلك كله ( قال الشافعي ) رحمه الله تعالي وتضرب الرجال في الحدود قياما وفي التعزير وتترك لهم ايديهم يتقون بها ولا تربط ولا يمدون وتضرب النساء جلوسا وتضم عليهن ثيابهن ويربطن لءلا ينكشفن ويلين رباط ثيابهن او تليه منهن امراة واذا قذف الرجل رجلا ميتا فان ابا حنيفة رحمه الله تعالي كان يقول لا ياخذ بحد الميت الا الولد او الوالد وبهذا ياخذ وكان بن ابي ليلي رحمه الله تعالي يقول ياخذ ايضا الاخ والاخت واما غير هءلاء فلا ( قال الشافعي ) رحمه الله تعالي ياخذ حد الميت ولده وعصبته من كانوا واذا قذف الرجل امراته وشهد عليه الشهود بذلك وهو يجحد فان ابا حنيفة رحمه الله تعالي كان يقول اذا رفع الي الامام خبره حبسه حتي يلاعن وبهذا ياخذ وكان بن ابي ليلي يقول اذا جحد ضربته الحد ولا اجبره علي اللعان منها اذا جحد ( قال الشافعي ) رحمه الله تعالي واذا شهد الشاهدان علي رجل انه قذف امراته مسلمة وطلبت ان يحد لها وجحد شهادتهما قيل له ان لاعنت خرجت من الحد وان لم تلاعن حددناك
   * باب النكاح
  * ( قال الشافعي ) رحمه الله تعالي واذا تزوج المراة بغير مهر مسمي فدخل بها فان لها مهر مثلها من نساءها لا وكس ولا شطط وقال ابو حنيفة رحمه الله تعالي نساءها اخواتها وبنات عمها وبه ياخذ وكان بن ابي ليلي يقول نساءها امها وخالاتها ( قال الشافعي ) واذا تزوج الرجل المراة بغير مهر فدخل بها فلها صداق مثلها من نساءها ونساءها نساء عصبتها الاخوات وبنات العم وليس الام ولا الخالات اذا لم يكن بنات عصبتها من الرجال ونساءها اللاتي يعتبر عليها بهن من كان مثلها من اهل بلدها وفي سنها وجمالها ومالها وادبها وصراحتها لان المهر يختلف باختلاف هذه الحالات واذا زوج الرجل ابنته وهي صغيرة بن اخيه وهو صغير يتيم في حجره فان ابا حنيفة رحمه الله تعالي كان يقول النكاح جاءز وله الخيار اذا ادرك وبه ياخذ وكان ابن ابي ليلي يقول لا يجوز ذلك عليه حتي  يدرك ثم رجع ابو يوسف وقال اذا زوج الولي فلا خيار وهو مثل الاب ( قال الشافعي ) رحمه الله ولا يجوز نكاح الصغار من الرجال ولا من النساء الا ان يزوجهن الاباء والاجداد اذا لم يكن لهن اباء فانهم اباء واذا زوجهن احد سواهم فالنكاح مفسوخ ولا يتوارثان فيه وان كبرا فان دخل عليها فاصابها فلها المهر ويفرق بينهما ولو طلقها قبل ان يفسخ النكاح لم يقع طلاقه ولا ظهاره ولا ايلاءه لانها لم تكن زوجة قط واذا تزوج الرجل المراة وامراة ابيها فان ابا حنيفة رحمه الله تعالي كان يقول هو جاءز بلغنا ذلك عن عبد الله بن جعفر انه فعل ذلك وبه ياخذ تزوج عبد الله بن جعفر امراة علي رضي الله عنه وابنته جميعا وكان بن ابي ليلي يقول لا يجوز النكاح وقال كل امراتين لو كانت احداهما رجلا لم يحل لها نكاح صاحبتها فلا ينبغي للرجل ان يجمع بينهما ( قال الشافعي ) رحمه الله تعالي لا باس ان يجمع بين امراة رجل وابنته من غيرها ( قال الشافعي ) فان قال قاءل لم زعمت ان الاباء يزوجون الصغار قيل زوج ابو بكر رسول الله صلي الله عليه وسلم عاءشة وهي بنت ست او سبع وبني بها النبي صلي الله عليه وسلم وهي بنت تسع فالحالان اللذان كان فيهما النكاح والدخول كانا وعاءشة صغيرة ممن لا امر لها في نفسها وزوج غير واحد من اصحاب رسول الله صلي الله عليه وسلم ابنته صغيرة فان قال قاءل فاذا اجزت هذا للاباء ولم تلتفت الي القياس في انه لا يجوز ان يعقد علي حرة صغيرة نكاح ثم يكون لها الخيار لان اصل النكاح لا يجوز ان يكون فيه خيار الا في الاماء اذا تحولت حالهن والحراءر لا تحول حالهن ولا يجوز ان يعقد عليهن ما لهن منه بد ثم يلزمهن فكيف لم تجعل الاولياء قياسا علي الاباء قيل لافتراق الاباء والاولياء وان الاب يملك من العقد علي ولده ما لا يملكه منه غيره الا تري انه يعقد علي البكر بالغا ولا يرد عنها وان كرهت ولا يكون ذلك للعم ولا للاخ ولا ولي غيره فان قال قاءل فانا لا نجيز للاب ان يعقد علي البكر بالغا ونجعله فيها وفي الثيب مثل غيره من الاولياء قيل فانت تجعل قبضه لمهر البكر قبضا ولا تجعل ذلك لولي غيره الا وصي بمال وتجعل عقده عليها صغيرة جاءزا لا خيار لها فيه وتجعل لها الخيار ان عقد عليها ولي غيره ولو كان مثل ساءر الاولياء ما كنت قد فرقت بينه وبين الاولياء وهذا مكتوب في كتاب النكاح واذا نظر الرجل الي فرج المراة من شهوة فان ابا حنيفة رحمه الله كان يقول تحرم علي ابنه وعلي ابيه وتحرم عليه امها وابنتها بلغنا ذلك عن ابراهيم وبلغنا عن عمر بن الخطاب رضي الله تعالي عنه انه خلا بجارية له فجردها وان ابنا له استوهبها منه فقال له انها لا تحل لك وبلغنا عن عمر بن الخطاب رضي الله تعالي عنه انه قال ملعون من نظر الي فرج وامها وبه ياخذ وكان بن ابي ليلي يقول لا يحرم من ذلك شء ما لم يلمسه ( قال الشافعي ) رحمه الله تعالي اذا لمس الرجل الجارية حرمت علي ابيه وابنه ولا تحرم عليه بالنظر دون اللمس ( قال الشافعي ) رحمه الله تعالي ولا باس ان يتزوج الرجل ابنة الرجل وامراة الرجل فيجمع بينهما لان الله عز وجل انما حرم الجمع بين الاختين وهاتان ليستا باختين وحرم الام والبنت احداهما بعد الاخري وهذه ليست بام ولا بنت وقد جمع عبد الله بن جعفر بين امراة علي رضي الله عنه وابنته وعبد الله بن صفوان بين امراة رجل وابنته واذا نظر الرجل الي فرج امته من شهوة فان ابا حنيفة رحمه الله تعالي كان يقول لا تحل لابيه ولا لابنه ولا تحل له امها ولا بنتها وبه ياخذ وكان بن ابي ليلي رضي الله عنه يقول هي له حلال حتي يلمسها ( قال الشافعي ) رحمه الله تعالي واذا زنا ( ( ( زني ) ) ) الرجل بالمراة فلا تحرم عليه هي ان اراد ان ينكحها ولا امها ولا ابنتها لان الله عز وجل انما حرم بالحلال والحرام ضد الحلال وهذا مكتوب في كتاب النكاح من احكام القران واذا تزوج الرجل المراة بشاهدين من غير ان يزوجها ولي والزوج كفء لها فان ابا حنيفة رحمه الله كان يقول النكاح  جاءز الا تري انها لو رفعت امرها الي الحاكم وابي وليها ان يزوجها كان للحاكم ان يزوجها ولا يسعه الا ذلك ولا ينبغي له غيره فكيف يكون ذلك من الحاكم والولي جاءزا ولا يجوز ذلك منها وهي قد وضعت نفسها في الكفاءة بلغنا عن علي بن ابي طالب رضي الله تعالي عنه ان امراة زوجت ابنتها فجاء اولياءها فخاصموا الزوج الي علي رضي الله تعالي عنه فاجاز علي النكاح وكان ابن ابي ليلي لا يجيز ذلك وقال ابو يوسف هو موقوف وان رفع الي الحاكم وهو كفء ( ( ( كفء ) ) ) اجزت ذلك كان القاضي ها هنا ولي بلغه ان ابنته قد تزوجت فاجاز ذلك ( قال الشافعي ) رحمه الله تعالي كل نكاح بغير ولي فهو باطل لقول النبي صلي الله عليه وسلم ايما امراة نكحت بغير اذن وليها فنكاحها باطل ثلاثا واذا تزوج الرجل المراة فاعلن المهر وقد كان اسر قبل ذلك مهرا واشهد شهودا عليه واعلم الشهود ان المهر الذي يظهره فهو كذا وكذا سمعة يسمع بها القوم ( ( ( لقوم ) ) ) وان اصل المهر هو كذا وكذا الذي في السر ثم تزوج فاعلن الذي قال فان ابا حنيفة رضي الله عنه كان يقول المهر هو الاول وهو المهر الذي في السر والسمعة باطل الذي اظهر للقوم وبه ياخذ وكان بن ابي ليلي يقول السمعة هي المهر والذي اسر باطل ابو يوسف عن مطرف عن عامر قال اذا اسر الرجل مهرا واعلن اكثر من ذلك اخذ بالعلانية ابو يوسف عن الحسن بن عمارة عن الحكم عن شريح وابراهيم مثله ( قال الشافعي ) رحمه الله تعالي واذا تزوج الرجل امراة بمهر علانية واسر قبل ذلك مهرا اقل منه فالمهر مهر العلانية الذي وقعت عليه عقدة النكاح الا ان يكون شهود المهرين واحدا فيثبتون علي ان المهر مهر السر وان المراة والزوج عقدا النكاح عليه واعلنا الخطبة بمهر غيره او يشهدون ان المراة بعد العقد اقرت بان ما شهد لها به منه سمعة لا مهر ( قال الشافعي ) رحمه الله تعالي ولا يجوز النكاح الا بولي وشاهدي عدل ورضا المنكوحة والناكح الا في الامة فان سيدها يزوجها والبكر فان اباها يزوجها ومن لم يبلغ فان الاباء يزوجونهم وهذا مكتوب في كتاب النكاح ( قال ) واذا زوج الرجل ابنته وقد ادركت فان ابا حنيفة رحمه الله تعالي كان يقول اذا كرهت ذلك لم يجز النكاح عليها لانها قد ادركت وملكت امرها فلا تكره علي ذلك بلغنا عن رسول الله صلي الله عليه وسلم انه قال البكر تستامر في نفسها واذنها صماتها فلو كانت اذا كرهت اجبرت علي ذلك لم تستامر وبه ياخذ وكان بن ابي ليلي يقول النكاح جاءز عليها وان كرهت ( قال الشافعي ) رحمه الله تعالي انكاح الاب خاصة جاءز علي البكر بالغة وغير بالغة والدلالة علي ذلك قول رسول الله صلي الله عليه وسلم الايم احق بنفسها من وليها والبكر تستامر في نفسها ففرق رسول الله صلي الله عليه وسلم بينهما فجعل الايم احق بنفسها وامر في هذه بالمءامرة والمءامرة قد تكون علي استطابة النفس لانه روي ان النبي صلي الله عليه وسلم قال وامروا النساء في بناتهن ولقول الله عز وجل @QB@ وشاورهم في الامر @QE@ ولو كان الامر فيهن واحدا لقال الايم والبكر احق بنفسيهما وهذا كله مستقصي بحججه في كتاب النكاح واذا تزوج الرجل المراة ثم اختلفا في المهر فدخل بها وليس بينهما بينة فان ابا حنيفة رحمه الله تعالي كان يقول في ذلك لها مهر مثلها الا ان يكون ما ادعت اقل من ذلك فيكون لها ما ادعت وكان بن ابي ليلي يقول انما لها ما سمي لها الزوج وليس لها شء غير ذلك وبه ياخذ ثم قال ابو يوسف بعد ان اقر الزوج بما يكون مهر مثلها او قريبا منه قبل منه والا لم يقبل منه ( قال الشافعي ) رحمه الله تعالي واذا تزوج الرجل المراة دخل بها او لم يدخل بها فاختلفا في المهر تحالفا وكان لها مهر مثلها كان اقل مما ادعت او اقل مما اقر به الزوج او اكثر كالقول في البيوع الفاءتة الا انا لا نرد العقد في النكاح بما يرد به العقد في البيوع ونحكم له حكم البيوع الفاءتة لان  البيوع الفاءتة يحكم فيها بالقيمة وهذا يحكم فيه بالقيمة والقيمة فيه مهر مثلها كما هي في البيوع قيمة مثل السلعة واذا اعتقت الامة وزوجها حر فان ابا حنيفة رحمه الله تعالي كان يجعل لها الخيار ان شاءت اختارت نفسها وان شاءت اقامت مع زوجها وكان بن ابي ليلي يقول لا خيار لها ومن حجة بن ابي ليلي في بريرة انه يقول كان زوجها عبدا ومن حجة ابي حنيفة في ذلك انه يقول ان الامة لا تملك نفسها ولا نكاحها وقد بلغنا عن رسول الله صلي الله عليه وسلم انه خير بريرة حين عتقت وقد بلغنا عن عاءشة رضي الله عنها ان زوج بريرة كان حرا ( قال الشافعي ) رحمه الله تعالي واذا اعتقت الامة فان كانت تحت عبد فلها الخيار وان كانت تحت حر فلا خيار لها وذلك ان زوج بريرة كان عبدا وهذا مكتوب في كتاب النكاح واذا تزوجت وزوجها غاءب كان قد نعي اليها فولدت من زوجها الاخر ثم جاء زوجها الاول فان ابا حنيفة رضي الله تعالي عنه كان يقول الولد للاول وهو صاحب الفراش وقد بلغنا عن رسول الله صلي الله عليه وسلم انه قال الولد للفراش وللعاهر الحجر وكان بن ابي ليلي يقول الولد للاخر لانه ليس بعاهر والعاهر الزاني لانه متزوج وكذلك بلغنا عن علي بن ابي طالب رضي الله عنه وبه ياخذ ( قال الشافعي ) رحمه الله تعالي واذا بلغ المراة وفاة زوجها فاعتدت ثم نكحت فولدت اولادا ثم جاء زوجها المنعي حيا فسخ النكاح الاخر واعتدت منه وكانت زوجة الاول كما هي وكان الولد للاخر لانه نكحها نكاحا حلالا في الظاهر حكمه حكم الفراش ( قال الشافعي ) رحمه الله تعالي واذا لمس الرجل الجارية حرمت علي ابيه وابنه ولا تحرم علي ابيه وابنه بالنظر دون اللمس
   * باب الطلاق
  * قال ابو يوسف عن الاشعث بن سوار عن الحكم عن ابراهيم عن بن مسعود انه كان يقول في الحرام ان نوي يمينا فيمين وان نوي طلاقا فطلاق وهو ما نوي من ذلك واذا قال الرجل كل حل علي حرام فان ابا حنيفة رحمه الله تعالي كان يقول القول قول الزوج فان لم يعن طلاقا فليس بطلاق وانما هي يمين يكفرها وان عني الطلاق ونوي ثلاثا فثلاث وان نوي واحدة فواحدة باءنة وان نوي طلاقا ولم ينو عددا فهي واحدة باءنة وكذلك اذا قال لامراته هي علي حرام وكذلك اذا قال لامراته خلية او برية او باءن او بتة فالقول قول الزوج وهو ما نوي ان نوي واحدة فهي واحدة باءنة وان نوي ثلاثا فثلاث بلغنا ذلك عن شريح وان نوي اثنتين فهي واحدة باءنة وان لم ينو طلاقا فليس بطلاق غير ان عليه اليمين ما نوي طلاقا وبه ياخذ وكان بن ابي ليلي يقول في جميع ما ذكرت هي ثلاث تطليقات لا ندينه في شء منها ولا نجعل القول قوله في شء من ذلك ( قال الشافعي ) رحمه الله تعالي واذا قال الرجل لامراته انت علي حرام فان نوي طلاقا فهو طلاق وهو ما اراد من عدد الطلاق والقول في ذلك قوله مع يمينه وان لم يرد طلاقا فليس بطلاق ويكفر كفارة يمين قياسا علي الذي يحرم امته فيكون عليه فيها الكفارة لان رسول الله صلي الله عليه وسلم حرم امته فانزل الله عز وجل @QB@ لم تحرم ما احل الله لك تبتغي مرضات ( ( ( مرضاة ) ) ) ازواجك @QE@ وجعلها الله يمينا فقال @QB@ قد فرض الله لكم تحلة ايمانكم @QE@ واذا قال الرجل لامراته امرك في يدك فقالت قد طلقت نفسي ثلاثا فان ابا حنيفة رحمه الله تعالي كان يقول اذا كان الزوج نوي ثلاثا فهي ثلاث وان كان نوي واحدة فهي واحدة باءنة وبه ياخذ وكان بن ابي ليلي يقول هي ثلاث ولا يسال الزوج عن شء ( قال الشافعي ) واذا خير الرجل امراته او ملكها امرها فطلقت نفسها تطليقة فهو يملك الرجعة فيها كما يملكها لو ابتدا طلاقها وكان ابو حنيفة يقول  في الخيار ان اختارت نفسها فواحدة باءنة وان اختارت زوجها فلا شء وبه ياخذ وكان بن ابي ليلي يقول ان اختارت نفسها فواحدة يملك بها الرجعة وان اختارت زوجها فلا شء ( قال الشافعي ) رحمه الله تعالي واذا قال الرجل لامراته ولم يدخل بها انت طالق انت طالق انت طالق بانت بالاولي ولم يكن عليها عدة فتلزمها الثنتان وانما احدث كل واحدة منهما لها وهي باءن منه حلال لغيره وهكذا قال ابو بكر بن عبد الرحمن بن الحرث بن هشام واذا قال الرجل لامراته ولم يدخل بها انت طالق انت طالق انت طالق طلقت بالتطليقة الاولي ولم يقع عليها التطليقتان الباقيتان وهذا قول ابي حنيفة بلغنا عن عمر بن الخطاب وعن علي وعبد الله بن مسعود وزيد بن ثابت وابراهيم بذلك لان امراته ليست عليها عدة فقد بانت منه بالتطليقة الاولي وحلت للرجال الا تري انها لو تزوجت بعد التطليقة الاولي قبل ان يتكلم بالثانية زوجا كان نكاحها جاءزا فكيف يقع عليها الطلاق وهي ليست بامراته وهي امراة غيره وبه ياخذ وكان بن ابي ليلي يقول عليها الثلاث التطليقات اذا كانت من الرجل في مجلس واحد علي ما وصفت لك واذا شهد شاهد علي رجل انه طلق امراته واحدة وشهد اخر انه طلقها اثنتين فان ابا حنيفة رحمه الله تعالي كان يقول شهادتهما باطلة لانهما قد اختلفا وكان بن ابي ليلي يقول يقع عليها من ذلك تطليقة لانهما قد اجتمعا عليها وبهذا ياخذ ( قال الشافعي ) رحمه الله تعالي واذا شهد الرجل انه سمع رجلا يقول لامراته انت طالق واحدة وشهد اخر انه سمعه يقول لها انت طالق ثنتين فهذه شهادة مختلفة فلا تجوز ولو شهدا فقالا نشهد انه طلق امراته وقال احدهما قد اثبت الطلاق ولم اثبت عدده وقال الاخر قد اثبت الطلاق وهو اثنتان ( ( ( ثنتان ) ) ) لزمته واحدة لانهما يجتمعان عليها واذا طلق الرجل امراته ثلاثا وقد دخل بها فان ابا حنيفة رحمه الله تعالي كان يقول في ذلك لها السكني والنفقة حتي تنقضي عدتها وبه ياخذ وكان بن ابي ليلي يقول لها السكني وليس لها النفقة وقال ابو حنيفة لم وقد قال الله عز وجل في كتابه @QB@ فانفقوا عليهن حتي يضعن حملهن @QE@ وبلغنا عن عمر بن الخطاب رضي الله تعالي عنه انه جعل للمطلقة ثلاثا السكني والنفقة ( قال الشافعي ) رحمه الله تعالي واذا طلق الرجل امراته ثلاثا ولا حبل بها فلها السكني وليس لها نفقة وهذا مكتوب في كتاب الطلاق واذا الي الرجل من امراته فحلف لا يقربها شهرا او شهرين او ثلاثا لم يقع عليه بذلك ايلاء ولا طلاق لان يمينه كانت علي اقل من اربعة اشهر حدثنا سعيد بن ابي عروبة عن عامر الاحول عن عطاء بن ابي رباح عن بن عباس رضي الله عنهما وهو قول ابي حنيفة وبه ياخذ وكان بن ابي ليلي يقول هو مول منها ان تركها اربعة اشهر بانت بالايلاء والايلاء تطليقة باءنة ( قال الشافعي ) رحمه الله تعالي واذا حلف الرجل لا يطا امراته اربعة اشهر او اقل لم يقم عليه حكم الايلاء لان حكم الايلاء انما يكون بعد مضي الاربعة الاشهر فيوم يكون حكم الايلاء يكون الزوج لا يمين عليه واذا لم يكن عليه يمين فليس عليه حكم الايلاء وهكذا مكتوب في كتاب الايلاء واذا حلف الرجل لا يقرب امراته في هذا البيت اربعة اشهر فتركها اربعة اشهر فلم يقربها فيه ولا في غيره فان ابا حنيفة رحمه الله كان يقول ليس عليه في هذا ايلاء الا تري ان له ان يقربها في غير ذلك البيت ولا تجب عليه الكفارة وانما الايلاء كل يمين تمنع الجماع اربعة اشهر لا يستطيع ان يقربها الا ان يكفر يمينه وبه ياخذ وكان بن ابي ليلي يقول في هذا هو مول ان تركها اربعة اشهر بانت بالايلاء والايلاء تطليقة باءنة ( قال الشافعي ) رحمه الله تعالي واذا حلف الرجل لا يقرب امراته في هذا البيت او في هذه الغرفة او في موضع يسميه فليس علي هذا حكم الايلاء انما حكم الايلاء علي من كان لا يصل الي ان يصيب امراته بحال الا لزمه الحنث فاما من يقدر علي اصابة امراته بلا حنث فلا حكم للايلاء عليه واذا ظاهر الرجل من امراته فقال  انت علي كظهر امي يوما او وقت وقتا اكثر من ذلك فان ابا حنيفة رضي الله عنه كان يقول هو مظاهر منها لا يقربها في ذلك الوقت حتي يكفر كفارة الظهار فاذا مضي ذلك الوقت سقطت عنه الكفارة وكان له ان يقربها بغير كفارة وبه ياخذ وكان بن ابي ليلي يقول هو مظاهر منها ابدا وان مضي ذلك الوقت فهو مظاهر لا يقربها حتي يكفر كفارة الظهار ( قال الشافعي ) رحمه الله تعالي واذا ظاهر الرجل من امراته يوما فاراد ان يقربها في ذلك اليوم كفر كفارة الظهار وان مضي ذلك اليوم ولم يقربها فيه فلا كفارة للظهار عليه كما قلنا في المسالة في الايلاء اذا سقطت اليمين سقط حكم اليمين والظهار يمين لا طلاق واذا ارتد الزوج عن الاسلام وكفر فان ابا حنيفة رحمه الله كان يقول بانت منه امراته اذا ارتد لا تكون مسلمة تحت كافر وبه ياخذ وكان بن ابي ليلي يقول هي امراته علي حالها حتي يستتاب فان تاب فهي امراته وان ابي قتل وكان لها ميراثها منه ( قال الشافعي ) رحمه الله تعالي واذا ارتد الرجل عن الاسلام فنكاح امراته موقوف فان رجع الي الاسلام قبل ان تنقضي عدتها فهما علي النكاح الاول وان انقضت عدتها قبل رجوعه الي الاسلام فقد بانت منه والبينونة فسخ بلا طلاق وان رجع الي الاسلام فخطبها لم يكن هذا طلاقا وهذا مكتوب في كتاب المرتد ( قال ) واذا رجعت المراة من اهل الاسلام الي الشرك كان هذا والباب الاول سواء في قولهما جميعا غير ان ابا حنيفة كان يقول يعرض علي المراة الاسلام فان اسلمت خلي سبيلها وان ابت حبست في السجن حتي تتوب ولا تقتل بلغنا ذلك عن بن عباس رضي الله عنهما وكان بن ابي ليلي يقول ان لم تتب قتلت وبه ياخذ ثم رجع الي قول ابي حنيفة وكيف تقتل وقد نهي رسول الله صلي الله عليه وسلم عن قتل النساء في الحروب من اهل الشرك فهذه مثلهم ( قال الشافعي ) رحمه الله تعالي واذا ارتدت المراة عن الاسلام فلا فرق بينها وبين الرجل تستتاب فان تابت والا قتلت كما يصنع بالرجل فخالفنا في هذا بعض الناس فقال يقتل الرجل اذا ارتد ولا تقتل المراة واحتج بشء رواه عن بن عباس لا يثبت اهل الحديث مثله وقد روي شبيه بذلك الاسناد عن ابي بكر الصديق رضي الله عنه انه قتل نسوة ارتددن عن الاسلام فلم نر ان نحتج به اذا كان اسناده مما لا يثبته اهل الحديث واحتج من خالفنا بان النبي صلي الله عليه وسلم نهي عن قتل النساء في دار الحرب وقال اذا نهي عن قتل المشركات اللاتي لم يءمن فالمءمنة التي ارتدت عن الاسلام اولي ان لا تقتل قيل لبعض من يقول هذا القول قد رويت ان النبي صلي الله عليه وسلم نهي عن قتل الكبير الفاني وعن قتل الاجير ورويت ان ابا بكر الصديق نهي عن قتل الرهبان افرايت ان ارتد شيخ فان او اجير اتدع قتلهما او ارتد رجل راهب اتدع قتله قال لا قيل ولم الان حكم القتل علي الردة حكم قتل حد لا يسع الوالي تعطيله مخالف لحكم قتل المشركين في دار الحرب قال نعم قلت فكيف احتججت بحكم دار الحرب في قتل المراة ولم تره حجة في قتل الكبير الفاني والاجير والراهب ثم قلت لنا ان ندع اهل الحرب بعد القدرة عليهم ولا نقتلهم وليس لنا ان ندع مرتدا فكيف ذهب عليك افتراقهما في المراة فان المراة تقتل حيث يقتل الرجل في الزني والقتل واذا قال الرجل كل امراة اتزوجها فهي طالق فان ابا حنيفة كان يقول هو كما قال واي امراة تزوجها فهي طالق واحدة وبهذا ياخذ وكان بن ابي ليلي يقول لا يقع عليه الطلاق لانه عمم فقال كل امراة اتزوجها فاذا سمي امراة مسماة او مصرا بعينه او جعل ذلك الي اجل فقولهما فيه سواء ويقع به الطلاق ( قال الربيع ) للشافعي فيه جواب ( قال ) واذا قال الرجل لامراة ان تزوجتك فانت طالق او قال اذا تزوجت الي كذا وكذا من الاجل امراة فهي طالق او قال كل امراة اتزوجها من قرية كذا وكذا فهي طالق او من بني فلان فهي طالق فهما جميعا كانا يقولان اذا تزوج تلك فهي طالق وان  دخل بها فان ابا حنيفة كان يقول لها مهر ونصف مهر مهر بالدخول ونصف مهر بالطلاق الذي وقع عليها قبل الدخول وبه ياخذ وكان بن ابي ليلي يقول لها نصف مهر ويفرق بينهما في قولهما جميعا ( قال ) واذا قذف الرجل امراته وقد وطءت وطءا حراما قبل ذلك فان ابا حنيفة كان يقول لا حد عليه ولا لعان وبه ياخذ وكان بن ابي ليلي يقول عليه الحد ولو قذفها غير زوجها لم يكن عليه حد في قول ابي حنيفة وكان بن ابي ليلي يقول عليه الحد ينبغي في قول بن ابي ليلي ان يكون مكان الحد اللعان ( قال الشافعي ) واذا وطءت المراة وطءا حراما مما يدرا عنها الحد فيه ثم قذفها زوجها سءل فان قذفها حاملا وانتفي من ولدها لوعن بينهما لان الولد لا ينفي الا بلعان وان قذفها غير حامل بالوطء الاول او بزنا غيره فلا حد عليه وعليه التعزير وكذلك ان قذفها باجنبي فقال عنيت ذلك الوطء الذي هو محرم فلا حد عليه وعليه التعزير واذا قال الرجل لامراته لا حاجة لي فيك فان ابا حنيفة كان يقول ليس هذا بطلاق وان اراد به الطلاق وبه ياخذ وقال ابو حنيفة وكيف يكون هذا طلاقا وهو بمنزلة لا اشتهيك ولا اريدك ولا اهواك ولا احبك فليس في شء من هذا طلاق ( قال الشافعي ) واذا قال الرجل لامراته لا حاجة لي فيك فان قال لم ارد طلاقا فليس بطلاق وان قال اردت طلاقا فهو طلاق وهي واحدة الا ان يكون اراد اكثر منها ولا يكون طلاقا الا ان يكون اراد به ايقاع طلاق فان كان انما قال لا حاجة لي فيك ساوقع عليك الطلاق فلا طلاق حتي يوقعه بطلاق غير هذا واذا قذف الرجل وهو عبد امراته وهي حرة وقد اعتق نصف العبد احد الشريكين وهو يسعي للاخر في نصف قيمته فان ابا حنيفة رضي الله تعالي عنه كان يقول هو عبد ما بقي عليه شء من السعاية وعليه حد العبد وكان بن ابي ليلي يقول هو حر وعليه اللعان وبه ياخذ وكذلك لو شهد شهادة ابطلها ابو حنيفة واجازها بن ابي ليلي ( قال الشافعي ) رحمه الله تعالي ويحد العبد والامة في كل شء حد العبد والامة حتي تكمل فيهما جميعا الحرية ولو بقي سهم من الف سهم فهو رقيق ( قال الشافعي ) وكذلك لا يحد له حتي تكمل فيه الحرية ولا يقص له من جرح حتي يستكمل العبد الحرية ولو قذف رجل هذا العبد الذي يسعي في نصف قيمته لم يكن عليه حد في قول ابي حنيفة لانه بمنزلة العبد وكان علي قاذفه الحد في قول بن ابي ليلي وبه ياخذ ولو قطع هذا العبد يد رجل متعمدا لم يكن عليه القصاص في قول ابي حنيفة وبه ياخذ وهو بمنزلة العبد وكان عليه القصاص في قول بن ابي ليلي وهو بمنزلة الحر في كل قليل او كثير او حد او شهادة او غير ذلك وهو في قول ابي حنيفة بمنزلة العبد ما دام عليه درهم من قيمته وكذلك هو في قولهما جميعا لو اعتق جزءا من ماءة جزء او بقي عليه جزء من ماءة جزء من كتابته ان شاء الله تعالي واذا كانت امة بين اثنين ولها زوج عبد اعتقها احد مولييها ( ( ( موليها ) ) ) وقضي عليها بالسعاية للاخر لم يكن لها خيار في النكاح في قول ابي حنيفة حتي تفرغ من السعاية وتعتق وكان لها الخيار في قول بن ابي ليلي يوم يقع العتق عليها وبه ياخذ ولو طلقت يومءذ كانت عدتها وطلاقها في قول ابي حنيفة عدة امة وطلاق امة وكانت عدتها وطلاقها في بن ابي ليلي عدة حرة وطلاق حرة ولو لم يكن لها زوج وارادت ان تتزوج لم يكن لها ذلك حتي ياذن الذي له عليها السعاية فهي في قول ابي حنيفة بمنزلة الامة وفي قول بن ابي ليلي بمنزلة الحرة ( قال الشافعي ) رحمه الله تعالي واذا كانت امة تحت عبد لم يكن لها الخيار حتي تكمل فيها الحرية فيوم تكمل فيها الحرية فلها الخيار فان طلقت وهي لم تكمل فيها الحرية كانت عدتها عدة امة وحكمها في كل شء حكم امة واذا قال الرجل لامراته انت طالق ان شاء فلان وفلان غاءب لا يدري احي هو او ميت او فلان ميت قد علم بذلك فان ابا حنيفة رحمه الله تعالي كان يقول لا يقع عليها الطلاق وبهذا ياخذ وكان بن ابي ليلي يقول  يقع عليها الطلاق قال ابو حنيفة وكيف يقع عليها الطلاق ولم يشا فلان ( قال الشافعي ) رحمه الله تعالي واذا قال الرجل لامراته انت طالق ان شاء فلان وفلان ميت قبل ذلك او مات فلان بعد ما قال ذلك وقبل ان يشاء فلا تكون طالقا ابدا بهذا الطلاق اذ لو كان فلان حاضرا حيا ولم يشا لم تطلق وانما يتم الطلاق بمشيءته فاذا مات قبل ان يشاء علمنا انه لا يشاء ابدا ولم يشا قبل فتطلق بمشيءته واذا قذف الرجل امراته وقامت لها البينة وهو يجحد فان ابا حنيفة كان يقول يلاعن وبه ياخذ وكان بن ابي ليلي يقول لا يلاعن ويضرب الحد واذا تزوج العبد بغير اذن مولاه فقال له مولاه طلقها فان ابا حنيفة كان يقول ليس هذا باقرار بالنكاح انما امره بان يفارقها فكيف يكون هذا اقرارا بالنكاح وبه ياخذ وكان بن ابي ليلي يقول هذا اقرار بالنكاح ( قال الشافعي ) واذا تزوج العبد بغير اذن مولاه فقال له مولاه طلقها فليس هذا باقرار بالنكاح من مولاه في قول من يقول ان اجازه مولاه فالنكاح يجوز واما في قولنا فلو اجازه له المولي لم يجز لان اصل ما نذهب اليه ان كل عقدة نكاح وقعت والجماع لا يحل ان يكون فيها او لاحد فسخها فهي فاسدة لا نجيزها الا ان تجدد ومن اجازها باجازة احد بعدها فان لم يجزها كانت مفسوخة دخل عليه ان يجيز ان ينكح الرجل المراة علي انه بالخيار وعلي انها بالخيار والخيار لا يجوز عنده في النكاح كما يجوز في البيوع واذا طلق الرجل امراته تطليقة باءنة فاراد ان يتزوج في عدتها خامسة فان ابا حنيفة رحمه الله تعالي كان يقول لا اجيز ذلك واكرهه له وكان بن ابي ليلي يقول هو جاءز وبه ياخذ ( قال الشافعي ) رحمه الله تعالي واذا فارق الرجل امراته بخلع او فسخ نكاح كان له ان ينكح اربعا وهي في العدة وكان له ان كان لا يجد طولا لحرة وخاف العنت علي نفسه ان ينكح امة مسلمة لان المفارقة التي لا رجعة له عليها غير زوجة واذا طلق الرجل امراة ثلاثا وهو مريض فان ابا حنيفة رضي الله تعالي عنه كان يقول ان مات بعد انقضاء العدة فلا ميراث لها منه وبه ياخذ وكان بن ابي ليلي يقول لها الميراث ما لم تتزوج ( قال الشافعي ) رحمه الله تعالي واذا طلق الرجل امراته ثلاثا او تطليقة لم يكن بقي له عليها غيرها وهو مريض ثم مات بعد انقضاء عدتها فان عامة اصحابنا يذهبون الي ان لها منه الميراث ما لم تتزوج وقد خالفنا في هذا بعض الناس باقاويل فقال احدهم لا يكون لها الميراث في عدة ولا في غير عدة وهذا قول بن الزبير وقال غيره هي ترثه ما لم تنقض العدة ورواه عن عمر باسناد لا يثبت مثله عند اهل العلم بالحديث وهو مكتوب في كتاب الطلاق وقال غيره ترثه وان تزوجت ( قال الشافعي ) رحمه الله تعالي لا ترث مبتوتة في عدة كانت او غير عدة وهو قول بن الزبير وعبد الرحمن طلق امراته ان شاء الله علي انها لا ترث واجمع المسلمون انه اذا طلقها ثلاثا ثم الي منها لم يكن موليا وان تظاهر لم يكن متظاهرا واذا قذفها لم يكن له ان يلاعنها ويبرا من الحد وان ماتت لم يرثها فلما اجمعوا جميعا انها خارجة من معاني الازواج لم ترثه واذا طلق الرجل امراته في صحته ثلاثا فجحد ذلك الزوج وادعته عليه المراة ثم مات الرجل بعد ان استحلفه القاضي فان ابا حنيفة رضي الله عنه كان يقول لا ميراث لها وبه ياخذ وكان بن ابي ليلي يقول لها الميراث الا ان تقر بعد موته انه كان طلقها ثلاثا ( قال الشافعي ) رحمه الله تعالي واذا ادعت المراة علي زوجها انه طلقها ثلاثا البتة فاحلفه القاضي بعد انكاره وردها عليه ثم مات لم يحل لها ان ترث منه شيءا ان كانت تعلم انها صادقة ولا في الحكم بحال لانها تقر انها غير زوجة فان كانت تعلم انها كاذبة حل لها فيما بينها وبين الله ان ترثه واذا خلا الرجل بامراته وهي حاءض او وهي مريضة ثم طلقها قبل ان يدخل بها فان ابا حنيفة رحمه الله تعالي كان يقول  لها نصف المهر وبه ياخذ وكان بن ابي ليلي يقول لها المهر كاملا واذا قال الرجل لامراته ان ضممت اليك امراة فانت طالق واحدة فطلقها فبانت منه وانقضت العدة ثم تزوج امراة اخري ثم تزوج تلك المراة التي حلف عليها فان ابا حنيفة كان يقول لا يقع عليها الطلاق من قبل انه لم يضمها اليها وبه ياخذ وكان بن ابي ليلي يقول يقع عليها الطلاق ( قال الشافعي ) رحمه الله تعالي واذا قال الرجل لامراته ان ضممت اليك امراة فانت طالق ثلاثا فطلقها وانقضت عدتها ثم نكح غيرها ثم نكحها بعد نكاحا جديدا فلا طلاق عليها وهو لم يضم اليها امراة انما ضمها هي الي امراة واذا قال الرجل ان تزوجت فلانة فهي طالق فتزوجها علي مهر مسمي ودخل بها فان ابا حنيفة رضي الله تعالي عنه كان يقول هي طالق واحدة باءنة وعليها العدة ولها مهر ونصف نصف من ذلك بالطلاق ومهر بالدخول وبه ياخذ وكان بن ابي ليلي يقول لها نصف مهر بالطلاق وليس لها بالدخول شء ومن حجته في ذلك ان رجلا الي من امراته فقدم بعد اربعة اشهر فدخل بامراته ثم اتي بن مسعود فامره ان يخطبها فخطبها واصدقها صداقا مستقبلا ولم يبلغنا انه جعل في ذلك الوطء صداقا ومن حجة ابي حنيفة انه قال قد وقع الطلاق قبل الجماع فوجب لها نصف المهر وجامعها بشبهة فعليه المهر ولو لم اجعل عليه المهر جعلت عليه الحد وقال ابو حنيفة كل جماع يدرا فيه الحد ففيه صداق لا بد من الصداق اذا درات الحد وجب الصداق واذا لم اجعل الصداق فلا بد من الحد قال ابو يوسف حدثني محدث عن حماد عن ابراهيم انه قال فيه لها مهر ونصف مهر مثل قول ابي حنيفة واذا قال الرجل لامراته ان دخلت الدار فانت طالق ان شاء الله فدخلت الدار فان ابا حنيفة وبن ابي ليلي قالا لا يقع الطلاق ولو قال انت طالق ان شاء الله ولم يقل ان دخلت الدار فان ابا حنيفة رضي الله عنه قال لا يقع الطلاق وقال هذا والاول سواء وبه ياخذ ابو حنيفة عن حماد عن ابراهيم انه قال في ذلك لا يقع الطلاق ولا العتاق واخبرنا عبد الملك بن ابي سليمان عن عطاء بن ابي رباح انه قال لا يقع الطلاق ( قال الشافعي ) رحمه الله تعالي واذا قال الرجل لامراته انت طالق ان شاء الله تعالي فلا طلاق ولا عتاق واذا طلق الرجل امراته واحدة فانقضت عدتها فتزوجت زوجا ودخل بها ثم طلقها ثم تزوجها الاول فان ابا حنيفة قال هي علي الطلاق كله وبه ياخذ وقال بن ابي ليلي هي علي ما بقي ( قال الشافعي ) واذا طلق الرجل امراته واحدة او اثنتين فانقضت عدتها ونكحت زوجا غيره ثم اصابها ثم طلقها او مات عنها فانقضت عدتها فنكحت الزوج الاول فهي عنده علي ما بقي من الطلاق يهدم الزوج الثاني الثلاث ولا يهدم الواحدة ولا الثنتين وقولنا هذا قول عمر بن الخطاب رضي الله تعالي عنه وعدد من كبار اصحاب النبي صلي الله عليه وسلم وقد خالفنا في بعض هذا بعض الناس فقال اذا هدم الزوج ثلاثا هدم واحدة واثنتين واحتج بقول بن عمر وبن عباس رضي الله عنهم وسالنا فقال من اين زعمتم ان الزوج يهدم الثلاث ولا يهدم ما هو اقل منها قلنا زعمناه بالامر الذي لا ينبغي لاحد ان يدفعه قال وما هو قلنا حرمها الله بعد الثلاث حتي تنكح زوجا غيره وبين رسول الله صلي الله عليه وسلم عن الله عز وجل ان النكاح الذي احلها الله به بعد الثلاث اصابة الزوج وكانت محرمة قبل الزوج لا تحل بحال الا بالزوج فكان للزوج حكم هدم الثلاث لهذا المعني وكانت في الواحدة والثنتين حلالا فلم يكن للزوج ها هنا حكم فزعمنا انه يهدم حيث كانت لا تحل له الا به وكان حكمه قاءما ولا يهدم حيث لا حكم له وحيث كانت حلالا بغيره وكان اصل المعقول ان احدا لا يحل له بفعل غيره شء فلما احل الله له بفعل غيره احللنا له حيث احل الله له ولم يجز ان نقيس عليه ما خالفه لو كان الاصل للمعقول فيه وقد رجع الي هذا القول محمد بن الحسن بعد ما كان يقول بقول ابي حنيفة والله اعلم 
   * باب الحدود
  * ( قال الشافعي ) رحمه الله تعالي واذا اقيم الحد علي البكر وجلد ماءة جلدة فان ابا حنيفة رحمه الله تعالي كان يقول لا انفيه من قبل انه بلغنا عن علي بن ابي طالب انه نهي عن ذلك وقال كفي بالنفي فتنة وبه ياخذ وكان بن ابي ليلي يقول ينفي سنة الي بلد غير البلد الذي فجر به وروي ذلك عن رسول الله صلي الله عليه وسلم وعن ابي بكر وعلي رضي الله عنهما ( قال الشافعي ) وينفي الزانيان البكران من موضعهما الذي زنيا به الي بلد غيره بعد ضرب ماءة وقد نفي النبي صلي الله عليه وسلم الزاني ونفي ابو بكر وعمر وعثمان وعلي رضي الله تعالي عنهم وقد خالف هذا بعض الناس وهذا مكتوب في كتاب الحدود بحججه واذا زني المشركان وهما ثيبان فان ابا حنيفة رضي الله عنه قال ليس علي واحد منهما الرجم وكان بن ابي ليلي يقول عليهما الرجم ويروي ذلك عن نافع عن بن عمر رضي الله تعالي عنهما عن رسول الله صلي الله عليه وسلم انه رجم يهوديا ويهودية وبه ياخذ ابو يوسف قال ابو حنيفة لا تقام الحدود في المساجد وروي ذلك عن رسول الله صلي الله عليه وسلم وبه ياخذ وكان بن ابي ليلي يقول نقيم الحدود في المساجد وقد فعل ذلك ( قال الشافعي ) رحمه الله تعالي واذا تحاكم الينا اهل الكتاب ورضوا ان نحكم بينهم فترافعوا في الزني واقروا به رجمنا الثيب وضربنا البكر ماءة ونفيناه سنة وقد رجم رسول الله صلي الله عليه وسلم يهوديين زنيا وهو معني كتاب الله تبارك وتعالي فان الله عز وجل يقول لنبيه صلي الله عليه وسلم @QB@ وان حكمت فاحكم بينهم بالقسط @QE@ وقال @QB@ وان احكم بينهم بما انزل الله @QE@ ولا يجوز ان يحكم بينهم في شء من الدنيا الا بحكم المسلمين لان حكم الله واحد لا يختلف ( قال الشافعي ) رحمه الله تعالي ولا تقام الحدود في المساجد واذا وطء الرجل جارية امه فقال ظننت انها تحل لي فان ابا حنيفة كان يقول يدرا عنه الحد فاذا اقر بذلك في مقام واحد اربع مرات لم يحد وبه ياخذوا عليه المهر وقال بن ابي ليلي وانا اسمع اقر عندي رجل انه وطء جارية امه فقال له اوطءتها ( ( ( وطءتها ) ) ) قال نعم فقال له اوطءتها قال نعم فقال له اوطءتها قال نعم قال له الرابعة وطءتها قال نعم قال بن ابي ليلي فامرت به فجلد الحد وامرت الجلواز فاخذه بيده فاخرجه من باب الجسر نفيا ( قال الشافعي ) رحمه الله تعالي واذا اصاب الرجل جارية امه وقال ظننتها تحل لي احلف ما وطءها الا وهو يراها حلالا ثم درء عنه الحد واغرم المهر فان قال قد علمت انها حرام علي قبل الوطء ثم وطءتها حد ولا يقبل هذا الا ممن امكن فيه انه يجهل مثل هذا فاما من اهل الفقه فلا قال ابو حنيفة ليس ينبغي للحاكم ان يقول له افعلت ولا نوجب عليه الحد باقرار اربع مرات في مقام واحد ولو قال وطءت جارية امي في اربعة مواطن لم يكن عليه حد لان الوطء قد يكون حلالا وحراما فلم يقر هذا بالزني والله اعلم
   * اختلاف علي وعبد الله بن مسعود رضي الله عنهما ابواب الوضوء والغسل والتيمم
  * ( اخبرنا الربيع بن سليمان ) قال اخبرنا الشافعي قال اخبرنا بن علية عن شعبة عن عمرو بن مرة عن زاذان قال سال رجل عليا رضي الله عنه عن الغسل فقال اغتسل كل يوم ان شءت فقال لا الغسل الذي هو الغسل قال يوم الجمعة ويوم عرفة ويوم النحر ويوم الفطر وهم لا يرون شيءا من هذا واجبا اخبرنا الربيع قال اخبرنا الشافعي قال اخبرنا هشيم عن خالد عن ابي اسحاق ان عليا رضي الله عنه قال في التيمم ضربة للوجه وضربة للكفين هكذا يقولون ضربة للوجه وضربة لليدين الي المرفقين 
   * باب الوضوء
  * ( قال الشافعي ) اخبرنا بن عيينة عن ابي السوداء عن بن عبد خير ( ( ( خبير ) ) ) عن ابيه قال توضا علي رضي الله تعالي عنه فغسل ظهر قدميه وقال لولا اني رايت رسول الله صلي الله عليه وسلم يمسح ظهر قدميه لظننت ان باطنهما احق ابو معاوية عن الاعمش عن ابي ظبيان قال رايت عليا رضي الله عنه بال ثم توضا ومسح علي النعلين ثم دخل المسجد فخلع نعليه وصلي بن مهدي عن سفيان عن حبيب عن زيد بن وهب انه راي عليا رضي الله عنه فعل ذلك بن مهدي عن سفيان عن الزبير بن عدي عن اكتل بن سويد بن غفلة ان عليا رضي الله عنه فعل ذلك محمد بن عبيد عن محمد بن ابي اسماعيل عن معقل الخثعمي ان عليا فعل ذلك ( قال الشافعي ) رحمه الله تعالي ولسنا ولا اياهم ولا احد نعلمه يقول بهذا من المفتين خالد بن عبد الله الواسطي عن عطاء بن الساءب عن ابي البحتري عن علي رضي الله عنه في الفارة تقع في البءر فتموت قال تنزح حتي تغلبهم قال ولسنا ولا اياهم نقول بهذا اما نحن فنقول بما روينا عن رسول الله صلي الله عليه وسلم اذا كان الماء قلتين لم يحمل نجسا واما هم فيقولون ينزح منها عشرون او ثلاثون دلوا عمرو بن الهيثم عن شعبة عن ابي اسحاق عن ناجية بن كعب عن علي رضي الله عنه قال قلت يا رسول الله بابي انت وامي ان ابي قد مات قال اذهب فواره فقلت انه مات مشركا قال اذهب فواره فواريته ثم اتيته قال اذهب فاغتسل وهم لا يقولون بهذا هم يزعمون انه ليس علي من مس ميتا مشركا غسل ولا وضوء عمرو بن الهيثم عن الاعمش عن ابراهيم بن ابي عبيدة عن عبد الله قال القبلة من اللمس وفيها الوضوء عن شعبة عن مخارق عن طارق عن عبد الله مثله وهم يخالفون هذا فيقولون لا وضوء من القبلة ونحن ناخذ بان في القبلة الوضوء وقال ذلك بن عمر وغيره وعن الاعمش عن ابراهيم التيمي عن ابيه عن عبد الله انه قال الماء من الماء ( قال الشافعي ) ولسنا ولا اياهم نقول بهذا نقول اذا مس الختان الختان فقد وجب الغسل وهذا القول كان في اول الاسلام ثم نسخ ( قال الشافعي ) اخبرنا ابو معاوية عن الاعمش عن شقيق عن عبد الله قال الجنب لا يتيمم وليسوا يقولون بهذا ويقولون لا نعلم احدا يقول به ونحن نروي عن النبي صلي الله عليه وسلم انه امر الجنب ان يتيمم ورواه بن علية عن عوف الاعرابي عن ابي رجاء عن عمران بن حصين عن النبي صلي الله عليه وسلم انه امر رجلا اصابته جنابة ان يتيمم ويصلي ( قال الشافعي ) اخبرنا سفيان عن ابي اسحاق عن الحرث بن الازمع قال سمعت بن مسعود يقول اذا غسل الجنب راسه بالخطمي فلا يعيد له غسلا وليسوا يقولون بهذا يقولون ليس الخطمي بطهور وان خالطه الماء الطهور انما الطهور الماء محضا فاما غسل راسه بالماء بعد الخطمي او قبله فاما الخطمي فلا يطهر وحده
   * ابواب الصلاة
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا سعيد بن سالم عن سفيان الثوري عن عبد الله بن محمد عن عقيل عن بن الحنفية ان عليا رضي الله تعالي عنه اخبره ان رسول الله صلي الله عليه وسلم قال مفتاح الصلاة الوضوء وتحريمها التكبير وتحليلها التسليم وبهذا نقول نحن لا يحرم بالصلاة الا بالتكبير وقال صاحبهم يحرم بها بغير التكبير بالتسبيح ورجع صاحباه الي قولنا وقولنا لا تنقضي الصلاة الا بالتسليم فمن عمل عملا مما يفسد الصلاة فيما بين ان يكبر الي ان يسلم فقد افسدها لا فيما بين ان يكبر الي ان يجلس قدر التشهد ( قال الشافعي ) اخبرنا بن علية عن شعبة عن ابي اسحاق عن عاصم بن ضمرة عن علي رضي الله تعالي عنه قال اذا وجد احدكم في صلاته في بطنه رزا او قيءا او رعافا  فلينصرف فليتوضا فان تكلم استقبل الصلاة وان لم يتكلم احتسب بما صلي وليسوا يقولون بهذا يقولون ينصرف من الرز وان انصرف من الرعاف فصلاته تامة ويخالفونه في بعض قوله ويوافقونه في بعضه وان كانوا يثبتون هذه الرواية فيلزمهم ان يقولوا في الرز ما يقولون في الرعاف لانه لم يخالفه في الرز غيره من اصحاب النبي صلي الله عليه وسلم علمته ( قال الشافعي ) رحمه الله تعالي اخبرنا هشيم عن حصين قال حدثنا ابو ظبيان قال كان علي رضي الله عنه يخرج الينا ونحن ننظر الي تباشير الصبح فيقول الصلاة الصلاة فاذا قام الناس قال نعم ساعة الوتر هذه فاذا طلع الفجر صلي ركعتين ثم اقيمت الصلاة ( قال الشافعي ) رحمه الله اخبرنا بن عيينة عن شبيب بن غرقدة عن حبان بن الحرث قال اتيت عليا رضي الله عنه وهو معسكر بدير ابي موسي فوجدته يطعم فقال ادن فكل فقلت اني اريد الصوم فقال وانا اريده فدنوت فاكلت فلما فرغ قال يا بن التياح اقم الصلاة وهذان خبران عن علي رضي الله عنه كلاهما يثبت انه كان يغلس باقصي غاية التغليس وهم يخالفونه فيقولون يسفر بالفجر اشد الاسفار ونحن نقول بالتغليس به وهو يوافق ما روينا من حديث النبي صلي الله عليه وسلم في التغليس ( قال الشافعي ) رحمه الله تعالي اخبرنا هشيم وغيره عن بن حبان التيمي عن ابيه عن علي رضي الله عنه قال لا صلاة لجار المسجد الا في المسجد قيل ومن جار المسجد قال من اسمعه المنادي ونحن وهم نقول يحب لمن لا عذر له ان لا يتخلف عن المسجد فان صلي فصلاته تجزي عنه الا انه قد ترك موضع الفضل ( قال الشافعي ) رحمه الله تعالي اخبرنا وكيع عن الاعمش عن عمرو بن مرة عن زاذان ان عليا رضي الله عنه كان يغتسل من الحجامة ولسنا ولا اياهم نقول بهذا ( قال الشافعي ) اخبرنا شريك عن عمران بن ظبيان عن حكيم بن سعد ان رجلا من الخوارج قال لعلي رضي الله عنه @QB@ ولقد اوحي اليك والي الذين من قبلك @QE@ الاية فقال علي رضي الله عنه @QB@ فاصبر ان وعد الله حق ولا يستخفنك الذين لا يوقنون @QE@ وهو راكع وهم يقولون من فعل هذا يريد به الجواب فصلاته فاسدة ( قال الشافعي ) اخبرنا بن علية عن شعبة عن ابي اسحاق عن عاصم بن ضمرة عن علي رضي الله عنه قال اذا ركعت فقلت اللهم لك ركعت ولك خشعت ولك اسلمت وبك امنت وعليك توكلت فقد تم ركوعك وهذا عندهم كلام يفسد الصلاة وهم يكرهون هذا وهذا عندي كلام حسن وقد روي عن النبي صلي الله عليه وسلم شبيه به ونحن نامر بالقول به وهم يكرهونه ( قال الشافعي ) اخبرنا بن علية عن خالد الحذاء عن عبد الله بن الحرث عن الحرث الهمداني عن علي رضي الله تعالي عنه كان يقول بين السجدتين اللهم اغفر لي وارحمني واهدني واجبرني وزاد بن علية عن شعبة عن ابي اسحاق ونسي اسناده وهم يكرهون هذا ولا يقولون به ( قال الشافعي ) اخبرنا هشيم عن مغيرة عن ابي رزين ان عليا رضي الله عنه كان يسلم عن يمينه وعن شماله سلام عليكم سلام عليكم ( قال الشافعي ) اخبرنا بن علية عن شعبة عن الاعمش عن ابي رزين عن علي رضي الله عنه مثله سواء وليسوا ياخذون به ويزيدون فيه ورحمه الله وبركاته ( قال الشافعي ) اخبرنا بن مهدي عن سفيان عن سلمة بن كهيل عن عبد الله بن معقل ان عليا رضي الله عنه قنت في المغرب يدعو علي قوم باسماءهم واشياعهم فقلنا امين هشيم عن رجل عن بن معقل ان عليا رضي الله عنه قنت بهم فدعا علي قوم يقول اللهم العن فلانا بادءا وفلانا حتي عد نفرا وهم يفسدون صلاة من دعا لرجل باسمه او دعا علي رجل فسماه باسمه ونحن لا نفسد بهذا صلاته لانه يشبه ما روينا عن النبي صلي الله عليه وسلم زيد بن الحباب عن سفيان عن ابي اسحاق عن الحرث عن علي رضي الله عنه ان رجلا قال اني صليت ولم اقرا قال اتممت الركوع والسجود قال نعم قال تمت صلاتك وهم لا يقولون بهذا ويزعمون ان عليه اعادة الصلاة هشيم عن منصور عن الحسن عن علي رضي الله تعالي عنه قال اقرا فيما ادركت مع  الامام وهم لا يقولون بهذا يقولون انما يقرا فيما يقضي لنفسه فاما وهو وراء الامام فلا قراءة عليه ونحن نقول كل صلاة صليت خلف الامام والامام يقرا قراءة لا يسمع فيها قرا فيها هشيم ويزيد عن حجاج عن ابي اسحاق عن الحرث عن علي رضي الله تعالي عنه في امام صلي بغير وضوء قال يعيد ولا يعيدون وهذا موافق للسنة وما روينا عن عمر بن الخطاب وعثمان بن عفان وبن عمر رضي الله تعالي عنهم ( قال الشافعي ) رحمه الله تعالي عنه اخبرنا مالك عن اسماعيل بن ابي حكيم عن عطاء بن يسار ان رسول الله صلي الله عليه وسلم كبر في صلاة من الصلوات ثم اشار اليهم ثم رجع وعلي جلده اثر الماء ( قال الشافعي ) اخبرنا وكيع عن اسامة بن زيد عن عبد الله بن يزيد مولي الاسود بن سفيان عن محمد بن عبد الرحمن بن ثوبان عن ابي هريرة عن النبي صلي الله عليه وسلم نحوه ( قال الشافعي ) اخبرنا حماد بن سلمة عن زياد الاعلم عن الحسن عن ابي بكرة عن النبي صلي الله عليه وسلم نحوه ( قال الشافعي ) اخبرنا بن علية عن بن عون عن بن سيرين عن النبي صلي الله عليه وسلم نحوه وقال اني كنت جنبا فنسيت ( قال الشافعي ) اخبرنا وكيع عن اسراءيل عن ابي اسحاق عن عاصم بن ضمرة عن علي رضي الله تعالي عنه قال اذا احدث في صلاة بعد السجدة فقد تمت صلاته ولسنا ولا اياهم نقول بهذا اما نحن فنقول انقضاء الصلاة بالتسليم للحديث الذي رويناه عن رسول الله صلي الله عليه وسلم واما هم فيقولون كل حدث يفسد الصلاة الا حدثا كان بعد التشهد او ان يجلس مقدار التشهد فلا يفسد الصلاة ( قال الشافعي ) اخبرنا هشيم عن اصحابه عن ابي اسحاق عن ابي الخليل عن علي رضي الله عنه كان اذا افتتح الصلاة قال لا اله الا انت سبحانك ظلمت نفسي فاغفر لي فانه لا يغفر الذنوب الا انت وجهت وجهي للذي فطر السماوات والارض حنيفا وما انا من المشركين ان صلاتي ونسكي ومحياي ومماتي لله رب العالمين لا شريك له وبذلك امرت وانا من المسلمين وقد روينا من حديثنا عن علي رضي الله عنه عن النبي صلي الله عليه وسلم انه كان يقول هذا الكلام اذا افتتح الصلاة وبهذا ابتدا يقول وجهت وجهي للذي فطر السماوات والارض ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا مسلم بن خالد عن بن جريج عن موسي بن عقبة عن عبد الله بن الفضيل عن الاعرج عن عبيد الله بن ابي رافع عن علي رضي الله تعالي عنه عن رسول الله صلي الله عليه وسلم مثله وهم يخالفونه ولا يقولون منه بحرف يقولون ان سبحانك اللهم وبحمدك كلام ( اخبرنا الربيع ) قال اخبرنا الشافعي عن وكيع عن الاعمش عن ابي اسحاق عن الحرث عن علي رضي الله تعالي عنه كان اذا تشهد قال بسم الله وبالله وليسوا يقولون بهذا وقد روي عن علي رضي الله عنه فيه كلام كثير هم يكرهونه ( اخبرنا الربيع ) قال ( اخبرنا الشافعي ) قال اخبرنا بن مهدي عن سفيان عن السدي عن عبد خير ان عليا رضي الله عنه قرا في الصبح ب @QB@ سبح اسم ربك الاعلي @QE@ فقال سبحان ربي الاعلي وهم يكرهون هذا ونحن نستحبه وروي عن رسول الله صلي الله عليه وسلم شء يشبهه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن منصور عن الحسن عن علي رضي الله عنه كره الصلاة في جلود الثعالب ولسنا ولا اياهم نقول بهذا بل نقول نحن واياهم لا باس بالصلاة في جلود الثعالب اذا دبغت ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن علية عن ايوب عن سعيد بن جبير عن علي رضي الله عنه في المستحاضة تغتسل لكل صلاة ولسنا ولا اياهم نقول بهذا ولا احد علمته اخبرنا الربيع قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان عن منصور عن هلال عن وهب بن الاجدع عن علي رضي الله عنه عن رسول الله صلي الله عليه وسلم قال لا تصلوا بعد العصر الا ان تصلوا والشمس مرتفعة ولسنا ولا اياهم ولا احد علمناه يقول بهذا بل نكره جميعا الصلاة بعد العصر والصبح نافلة بن مهدي  عن سفيان عن ابي اسحاق عن عاصم عن علي رضي الله عنه قال كان رسول الله صلي الله عليه وسلم يصلي دبر كل صلاة ركعتين الا العصر والصبح وهذا يخالف الحديث الاول ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن شعبة عن ابي اسحاق عن عاصم بن ضمرة قال كنا مع علي رضي الله تعالي عنه في سفر فصلي العصر ثم دخل فسطاطه فصلي ركعتين وهذه الاحاديث يخالف بعضها بعضا اذا كان علي يروي عن رسول الله صلي الله عليه وسلم انه كان لا يصلي بعد العصر ولا الصبح فلا يشبه هذا ان يكون صلي ركعتين بعد العصر وهو يروي ان النبي صلي الله عليه وسلم كان لا يصليهما
   * باب الجمعة والعيدين
  * ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان عن ابي اسحاق قال رايت عليا رضي الله عنه يخطب نصف النهار يوم الجمعة ولسنا ولا اياهم نقول بهذا نقول لا يخطب الا بعد زوال الشمس وكذلك روينا عن عمر وعن غيره ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا حميد بن عبد الرحمن الرءاسي عن الحسن بن صالح عن ابي اسحاق قال رايت عليا رضي الله عنه يخطب يوم الجمعة ثم لم يجلس حتي فرغ ولسنا ولا اياهم نقول بهذا نقول يجلس الامام بين الخطبتين ونقول يجلس علي المنبر قبل الخطبة وكذلك فعل رسول الله صلي الله عليه وسلم والاءمة بعده اخبرنا الربيع قال اخبرنا الشافعي قال اخبرنا شريك عن العباس بن ذريح عن الحرث بن ثور ان عليا رضي الله عنه صلي الجمعة ركعتين ثم التفت الي القوم فقال اتموا ولسنا ولا اياهم ولا احد يقول بهذا ولست اعرف وجه هذا الا ان يكون يري ان الجمعة عليه هو ركعتان لانه يخطب وعليهم اربع لانهم لا يخطبون فان كان هذا مذهبه فليس يقول بهذا احد من الناس ( قال الربيع ) اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان عن ابي حصين عن ابي عبد الرحمن ان عليا رضي الله عنه قال من كان منكم مصليا بعد الجمعة فليصل بعدها ست ركعات ولسنا ولا اياهم نقول بهذا اما نحن فنقول يصلي اربعا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا ابو معاوية عن الاعمش عن منهال عن عباد بن عبد الله ان عليا كان يخطب علي منبر من اجر فجاء الاشعث وقد امتلا المسجد واخذوا مجالسهم فجعل يتخطي حتي دنا وقال غلبتنا عليك هذه (  ) الحمراء فقال علي ما بال هذه الضياطرة يتخلف احدهم ثم ذكر كلاما وهم يكرهون للامام ان يتكلم في خطبته ويكرهون ان يتكلم احد والامام يخطب وقد تكلم الاشعث ولم ينهه علي رضي الله عنه وتكلم علي واحسبهم يقولون يبتدء الخطبة ولسنا نري باسا بالكلام في الخطبة تكلم فيها رسول الله صلي الله عليه وسلم وعمر وعثمان رضي الله تعالي عنهما ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن شعبة عن محمد بن النعمان عن ابي قيس الاودي عن هذيل ان عليا رضي الله عنه امر رجلا ان يصلي بضعفة الناس يوم العيد اربع ركعات في المسجد ( اخبرنا الربيع ) قال اخبرنا الشافعي اخبرنا ابو احمد عن سفيان عن ابي قيس الاودي عن هذيل عن علي مثله ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن علية عن ليث عن الحكم عن حنش بن المعتمر ان عليا رضي الله عنه قال صلوا يوم العيد في المسجد اربع ركعات ركعتان للسنة وركعتان للخروج ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان عن ابي اسحاق ان عليا رضي الله تعالي عنه امر رجلا ان يصلي بضعفة الناس  يوم العيد في المسجد ركعتين وهذان حديثان مختلفان ولسنا ولا اياهم نقول بواحد منهما يقولون الصلاة مع الامام ولا جماعة الا حيث هو فان صلي قوم جماعة في موضع فليست بصلاة العيد ولا قضاء منها وهي كنافلة لو تطوع بها رجل في جماعة ونحن نقول اذا صلاها احد صلاها وقرا وفعل كما يفعل الامام فيكبر في الاولي سبعا قبل القراءة وفي الاخرة خمسا قبل القراءة ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا ابو بكر بن عياش عن ابي اسحاق عن علي رضي الله تعالي عنه في الفطر احدي عشرة تكبيرة وفي الاضحي خمس وليسوا ياخذون بهذا
   * باب الوتر والقنوت والايات
  * ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبر ( ( ( اخبرنا ) ) ) هشيم عن عبد الملك بن ابي سليمان عن عبد الرحيم عن زاذان ان عليا رضي الله تعالي عنه كان يوتر بثلاث يقرا في كل ركعة بتسع سور من المفصل وهم يقولون يقرا ب @QB@ سبح اسم ربك الاعلي @QE@ والثانية ب @QB@ قل يا ايها الكافرون @QE@ وفي الثالثة يقرا بفاتحة الكتاب و @QB@ قل هو الله احد @QE@ واما نحن فنقول يقرا فيها ب @QB@ قل هو الله احد @QE@ و @QB@ قل اعوذ برب الفلق @QE@ و @QB@ قل اعوذ برب الناس @QE@ يفصل بين كل ركعتين والركعة بالتسليم ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن عطاء بن الساءب عن ابي عبد الرحمن السلمي ان عليا رضي الله عنه كان يقنت في الوتر بعد الركوع وهم لا ياخذون بهذا يقولون يقنت قبل الركوع فان لم يقنت قبل الركوع لم يقنت بعده وعليه سجدتا السهو ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن عطاء عن ابي عبد الرحمن ان عليا رضي الله تعالي عنه كان يقنت في صلاة الصبح قبل الركوع ( اخبرنا الربيع ) قال ( اخبرنا الشافعي ) قال اخبرنا هشيم عن معقل ان عليا رضي الله عنه قنت في صلاة الصبح وهم لا يرون القنوت في الصبح ونحن نراه للسنة الثابتة عن رسول الله صلي الله عليه وسلم انه قنت في الصبح اخبرنا بذلك سفيان عن الزهري عن سعيد عن ابي هريرة رضي الله تعالي عنه ان رسول الله صلي الله عليه وسلم قنت في الصبح فقال اللهم انج الوليد بن الوليد وسلمة بن هشام وعياش بن ابي ربيعة وذكر الحديث ونقول من اوتر اول الليل صلي مثني مثني حتي يصبح ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن علية عن ابي هارون الغنوي عن حطان بن عبد الله قال قال علي رضي الله عنه الوتر ثلاثة انواع فمن شاء ان يوتر اول الليل اوتر ثم ان استيقظ فشاء ان يشفعها بركعة يصلي ركعتين ركعتين حتي يصبح ثم يوتر فعل وان شاء صلي ركعتين ركعتين حتي يصبح وان شاء اوتر اخر الليل وهم يكرهون ان ينقض الرجل وتره ويقولون اذا اوتر صلي مثني مثني ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا يزيد بن هارون عن حماد عن عاصم عن ابي عبد الرحمن ان عليا رضي الله عنه خرج حين ثوب المءذن فقال اين الساءل عن الوتر نعم ساعة الوتر هذه ثم قرا @QB@ والليل اذا عسعس والصبح اذا تنفس @QE@ وهم لا ياخذون بهذا ويقولون ليست هذه من ساعات الوتر ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا عباد عن عاصم الاحول عن قزعة عن علي رضي الله تعالي عنه انه صلي في زلزلة ست ركعات في اربع سجدات خمس ركعات وسجدتين في ركعة وركعة وسجدتين في ركعة ولسنا نقول بهذا نقول لا يصلي في شء من الايات الا في كسوف الشمس والقمر ولو ثبت هذا الحديث عندنا عن علي رضي الله تعالي عنه لقلنا به وهم يثبتونه ولا ياخذون به ويقولون يصلي ركعتين في الزلزلة في كل ركعة ركعة ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن يونس عن الحسن ان عليا رضي الله تعالي عنه صلي في كسوف الشمس خمس ركعات واربع سجدات ولسنا ولا اياهم نقول بهذا اما نحن فنقول بالذي روينا عن رسول الله صلي الله عليه وسلم اربع ركعات واربع سجدات اخبرنا بذلك مالك عن يحيي عن عمرة  عن عاءشة ان النبي صلي الله عليه وسلم صلي في كسوف الشمس ركعتين وسجدتين في كل ركعة ركعتين ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا مالك عن هشام عن ابيه عن عاءشة بمثله ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا مالك عن زيد بن اسلم عن عطاء بن يسار عن بن عباس عن النبي صلي الله عليه وسلم بمثله وقالوا هم يصلي ركعتين كما يصلي ساءر الصلوات ولا يركع في كل ركعة ركعتين فخالفوا سنة رسول الله صلي الله عليه وسلم وخالفوا ما رووه عن علي رضي الله تعالي عنه
   * الجناءز
  * ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا محمد بن يزيد عن اسماعيل عن الشعبي عن عبد الله بن معقل قال صلي علي علي سهل بن حنيف فكبر عليه ستا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا ابو معاوية عن الاعمش عن بن ابي زياد عن عبد الله بن معقل ان عليا رضي الله تعالي عنه كبر علي سهل بن حنيف خمسا ثم التفت الينا وقال انه بدري وهذا خلاف الحديث الاول ولسنا ولا اياهم ناخذ بهذا التكبير عندنا وعندهم علي الجناءز اربع وذلك الثابت عن النبي صلي الله عليه وسلم ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا ابو معاوية عن الاعمش عن عمير بن سعيد ان عليا رضي الله عنه كبر (  ) علي بن المكفف اربعا وهذا خلاف الحديثين قبله ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن اشعث عن الشعبي عن قرظة ان عليا رضي الله تعالي عنه امره ان يصلي علي قبر سهل بن حنيف وهم لا ياخذون بهذا ولا يقولون به يقولون لا يصلي علي قبر واما نحن فناخذ به لانه موافق ما روينا عن رسول الله صلي الله عليه وسلم انه صلي علي قبر ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا مالك وسفيان عن الزهري عن ابي امامة بن سهل ان النبي صلي الله عليه وسلم صلي علي قبر امراة ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن عثمان بن حكيم عن خارجة بن زيد عن عمه يزيد بن ثابت وكان اكبر من زيد بن ثابت الشيباني عن الشعبي عن بن عباس رضي الله تعالي عنهما ان النبي صلي الله عليه وسلم صلي علي قبر
   * سجود القران
  * ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن شعبة عن عاصم عن زر عن علي رضي الله تعالي عنه قال عزاءم السجود @QB@ الم تنزيل @QE@ و @QB@ حم تنزيل @QE@ و @QB@ النجم @QE@ و @QB@ اقرا باسم ربك الذي خلق @QE@ ولسنا ولا اياهم نقول بهذا نقول في القران عدد سجود مثل هذه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن ابي عبد الله الجعفي عن ابي عبد الرحمن السلمي عن علي رضي الله تعالي عنه قال كان يسجد في الحج سجدتين وبهذا نقول وهذا قول العامة قبلنا يروي عن عمر وبن عمر وبن عباس وهم ينكرون السجدة الاخرة في الحج وهذا الحديث عن علي رضي الله تعالي عنه يخالفونه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان عن محمد بن قيس عن ابي موسي ان عليا رضي الله تعالي عنه لما اتي بالمخدج خر ساجدا ونحن نقول لا باس بسجدة الشكر ونستحبها ويروي عن النبي صلي الله عليه وسلم انه سجدها وعن ابي بكر وعمر رضي الله تعالي عنهما وهم ينكرونها ويكرهونها ونحن نقول لا باس بالسجدة لله تبارك وتعالي في الشكر 
   * الصيام
  * ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان عن ابي اسحاق عن عبيد بن عمرو ان عليا رضي الله تعالي عنه نهي عن القبلة للصاءم فقال ما يريد الي خلوف فمها ولسنا ولا اياهم نقول بهذا نقول لا باس بقبلة الصاءم ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان وغيره عن اسماعيل عن ابي السفر عن علي رضي الله تعالي عنه انه صلي الصبح ثم قال هذا حين يبين الخيط الابيض من الخيط الاسود ولسنا ولا اياهم ولا احد علمناه يقول بهذا انما السحور قبل طلوع الفجر فاذا طلع الفجر حرم الطعام والشراب علي الصاءم
   * ابواب الزكاة
  * ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان عن حبيب بن ابي ثابت عن بن ابي رافع ان عليا رضي الله تعالي عنه كان يزكي اموالهم وهم ايتام في حجره وبهذا ناخذ وهو موافق لما روينا عن عمر وبن عمر وعاءشة في زكاة اموال اليتامي وهم يخالفونه فيقولون ليس علي مال اليتيم زكاة ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان عن ابي اسحاق عن عاصم بن ضمرة عن علي رضي الله عنه انه قال في خمس وعشرين من الابل خمس من الغنم ولسنا ولا اياهم ولا احد علمناه ناخذ بهذا والثابت عندنا من حديث رسول الله صلي الله عليه وسلم ان في خمس وعشرين بنت مخاض فان لم تكن بنت مخاض فابن لبون ذكر ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا عباد بن محمد عن محمد بن يزيد عن سفيان بن حسين عن الزهري عن سالم عن ابيه ان رسول الله صلي الله عليه وسلم كتب في خمس وعشرين بنت مخاض فان لم تكن بنت مخاض فابن لبون ذكر وكان عمر يامر عماله بذلك ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا ابو كامل وغيره عن حماد بن سلمة عن ثمامة عن انس قال اعطاني ابي كتابا كتبه له ابو بكر فقال هذه فريضة الله وسنة رسول الله صلي الله عليه وسلم في خمس وعشرين بنت مخاض فان لم تكن فابن لبون ذكر اخبرنا الشافعي قال اخبرنا شريك عن ابي اسحاق عن عاصم بن ضمرة عن علي رضي الله تعالي عنه قال اذا زادت الابل علي عشرين وماءة ففي كل خمسين حقة وفي كل اربعين بنت لبون ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا عمرو بن الهيثم وغيره عن شعبة عن ابي اسحاق عن عاصم عن علي رضي الله تعالي عنه مثله وبهذا نقول وهو موافق للسنة ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا عباد ومحمد بن يزيد عن سفيان بن حسين عن الزهري عن سالم عن ابيه ان رسول الله صلي الله عليه وسلم كتب فاذا زادت علي عشرين وماءة ففي كل خمسين حقة وفي كل اربعين ابنة لبون اخبرنا الشافعي قال اخبرنا ابو كامل عن حماد بن سلمة عن ثمامة عن انس عن (  ) ابي زكريا انه كتب له السنة فذكر هذا وهم لا ياخذون بهذا يقولون اذا زادت علي عشرين وماءة استقبل بالفراءض اولها وكان في كل خمس شاة الي ان يبلغ بها خمسين وماءة ثم في كل خمسين حقة وهذا قول متناقض لا اثر ولا قياس فيخالفون ما رووا عن رسول الله صلي الله عليه وسلم وابي بكر وعمر والثابت عن علي عندهم الي قول ابراهيم وشء يغلط به عن علي رضي الله تعالي عنه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا ابو معاوية عن الاعمش عن عبد الرحمن بن زياد عن عبد الله بن الحرث ان عثمان اهديت له حجل وهو محرم فاكل القوم الا عليا فانه كره ذلك ولسنا  ولا اياهم نقول بهذا اما نحن فنقول بحديث ابي قتادة ان النبي صلي الله عليه وسلم امرهم ان ياكلوا لحم الصيد وهم حرم اخبرنا بذلك مالك عن زيد بن اسلم عن عطاء بن يسار عن ابي قتادة ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا سفيان عن صالح بن كيسان عن ابي محمد عن ابي قتادة نحوه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن منصور عن الحسن عن علي رضي الله تعالي عنه فيمن اصاب بيض نعام قال يضرب بقدرهن نوقا قيل له فان اربعت منهن ناقة قال فان من البيض ما يكون مارقا ولسنا ولا اياهم ولا احد علمناه ناخذ بهذا نقول يغرم ثمنه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن علية عن سعيد عن قتادة عن الحسن عن علي فيمن يجعل عليه المشي قال يمشي فان عجز ركب واهدي بدنة وهم يقولون يمشي ان احب وكان مطيقا والا ركب واهدي شاة ونحن نقول ليس لاحد ان يركب وهو يستطيع ان يمشي بحال وان عجز ركب واهدي فان صح مشي الذي ركب وركب الذي مشي حتي اتي به كما نذر ( قال الربيع ) وقد قال الشافعي غير هذا قال عليه كفارة يمين ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا وكيع عن شعبة عن عمرو بن مرة عن عبد الله بن سلمة عن علي في هذه الاية @QB@ واتموا الحج والعمرة لله @QE@ قال ان يحرم الرجل من دويرة اهله وهم يقولون احب الينا ان يحرم من الميقات ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا شعبة عن ابي اسحاق عن عاصم بن ضمرة عن علي مثله بهذا نقول وهو موافق للسنة ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن علية عن بن ابي نجيح عن مجاهد عن علي رضي الله تعالي عنه في الضبع كبش ( اخبرنا الشافعي ) قال اخبرنا بن ابان عن سفيان عن سماك عن عكرمة ان عليا رضي الله تعالي عنه قضي في الضبع بكبش وبهذا نقول ( ( ( يقول ) ) ) وهو يوافق ما ذكرنا عن عمر وعن غيره من اصحاب رسول الله صلي الله عليه وسلم واما هم فيقولون يغرم قيمتها في الموضع الذي اصابها فيه لا يجعلون فيها شيءا موقتا
   * ابواب الطلاق والنكاح
  * ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا وكيع عن سفيان عن سلمة بن كهيل عن معاوية بن سويد بن مقرن انه وجد في كتاب ابيه عن علي رضي الله تعالي عنه ان لا نكاح الا بولي فاذا بلغ الحقاءق النص فالعصبة احق وبهذا نقول لانه يوافق ما روينا عن رسول الله صلي الله عليه وسلم انه قال ايما امراة لم ينكحها الولاة فنكاحها باطل فان اشتجروا فالسلطان ولي من لا ولي له اخبرنا بذلك الزنجي عن بن جريج عن سليمان بن موسي عن بن شهاب عن عروة عن عاءشة رضي الله تعالي عنها وهم يقولون اذا كان الزوج كفوا واخذت صداق مثلها جاز النكاح وان كان غير ولي ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا وكيع عن سفيان عن سماك بن حرب عن حنش ان رجلا تزوج امراة فزني بها قبل ان يدخل بها فرفع الي علي ففرق بينهما وجلده الحد واعطاها نصف الصداق ولسنا ولا اياهم ولا احد علمناه يقول بهذا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا وكيع عن سفيان عن رجل عن الشعبي عن علي رضي الله تعالي عنه في رجل تزوج امراة بها جنون او جذام او برص قال اذا لم يدخل بها فرق بينهما فان كان دخل بها فهي امراته ان شاء طلقها وان شاء امسك وهم يقولون هي امراته علي كل حال ان شاء طلق وان شاء امسك ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن مطرف عن الشعبي عن علي رضي الله تعالي عنه في النصراني تسلم امراته قال هو احق بها ما لم يخرجها من دار الهجرة ولسنا ولا اياهم ولا احد علمناه يقول بهذا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال  اخبرنا سفيان عن عطاء بن الساءب عن عبد خير عن علي رضي الله تعالي عنه في الرجل يتزوج المراة ثم يموت ولم يدخل بها ولم يفرض لها صداقا ان لها الميراث وعليها العدة ولا صداق لها وبهذا نقول الا ان يثبت حديث بروع وقد رويناه عن بن عمر وبن عباس وزيد بن ثابت رضي الله عنهم وهم يخالفونه ويقولون لها صداق نساءها ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا يحيي بن عباد عن حماد بن سلمة عن بديل عن ميسرة عن ابي الوضي ( ( ( الوضء ) ) ) ان اخوين تزوجا اختين فاهديت كل واحدة منهما الي اخي زوجها فاصابها فقضي علي رضي الله عنه علي كل واحد منهما صداق وجعله يرجع به علي الذي غره وهم يخالفونه ويقولون لا يرجع بالصداق وبه يقول الشافعي لا يرجع بالصداق ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن علية عن جرير بن حازم عن عيسي عن عاصم الاسدي عن زاذان عن علي رضي الله عنه يقول في الخيار ان اختارت زوجها فواحدة وهو احق بها ولسنا ولا اياهم نقول بهذا القول اما نحن فنقول ان اختارت زوجها فلا شء ويروي عن عاءشة رضي الله تعالي عنها قالت خيرنا رسول الله صلي الله عليه وسلم فاخترناه فلم يعد ذلك طلاقا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن منصور عن الحكم عن ابراهيم ان عليا رضي الله تعالي عنه قال في الخلية والبرية والحرام ثلاثا ثلاثا ولسنا ولا اياهم نقول بهذا اما نحن فنقول ان نوي الطلاق فهو ما نوي من الطلاق ان كانت واحدة فواحدة وان اراد اثنتين فاثنتين ويملك الرجعة واما هم فيقولون ان نوي واحدة فواحدة وان نوي اثنتين فلا يكون اثنتين ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن علية عن داود عن الشعبي عن علي رضي الله عنه في الحرام ثلاث ولسنا ولا اياهم نقول بهذا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا محمد بن يزيد ومحمد بن عبيد وغيرهما عن اسماعيل عن الشعبي عن رياش بن عدي الطاءي قال اشهد ان عليا رضي الله عنه جعل البته ثلاثا ولسنا ولا اياهم نقول بهذا اخبرنا الربيع قال اخبرنا الشافعي قال اخبرنا هشيم وسفيان بن عيينة عن الشيباني عن الشعبي عن عمرو بن سلمة ان عليا رضي الله عنه وقف المولي ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن الشيباني عن بكير بن الاخنس عن مجاهد عن عبد الرحمن بن ابي ليلي ان عليا رضي الله تعالي عنه وقف المولي ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا سفيان عن ليث عن مجاهد عن مروان شهد عليا رضي الله عنه وقف المولي وهكذا نقول وهو موافق لما روينا عن عمر وبن عمر وعاءشة وعثمان وزيد بن ثابت وبضعة عشر من اصحاب رسول الله صلي الله عليه وسلم انهم وقفوا المولي وهم يخالفونه ويقولون لا يوقف اذا مضت اربعة اشهر بانت منه اخبرنا الشافعي قال اخبرنا محمد بن عبيد عن اسماعيل عن الشعبي ان عليا رضي الله عنه كان يءجل المتوفي عنها لا ينظر بها ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان عن فراس عن الشعبي قال نقل علي رضي الله تعالي عنه ام كلثوم بعد قتل عمر بسبع ليال ولسنا ولا اياهم نقول بهذا نقول بحديث فريعة ابنة مالك ان رسول الله صلي الله عليه وسلم امرها ان تمكث في بيتها حتي يبلغ الكتاب اجله ونحن نقول بهذا وهم في المتوفي عنها والمبتوتة وهم يروون عن علي رضي الله عنه انه نقل ابنته في عدتها من عمر ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن اشعث عن الحكم عن ابي صادق عن ربيعة بن ناجد عن علي رضي الله عنه قال العدة من يوم يموت او يطلق وبهذا نقول ويقولون بقولنا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عمن سمع الحكم يحدث عن ابي صادق عن ربيعة بن ناجد عن علي رضي الله تعالي عنه قال الحامل المتوفي عنها لها النفقة من جميع المال وليسوا يقولون بهذا وينكرون هذا القول فيقولون ما نقول بهذا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا ابو معاوية عن الاعمش  عن ابي الضحي عن علي رضي الله تعالي عنه قال الحامل المتوفي عنها زوجها تعتد باخر الاجلين وليسوا يقولون بهذا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا مالك عن عبد ربه بن سعيد عن ابي سلمة قال سالت بن عباس وابا هريرة عن المتوفي عنها زوجها وهي حامل فقال بن عباس اخر الاجلين وقال ابو هريرة اذا ولدت فقد حلت قال ابو سلمة فدخلت علي ام سلمة فسالتها عن ذلك فقالت ولدت سبيعة الاسلمية بعد وفاة زوجها بنصف شهر فخطبها رجلان احدهما شاب والاخر شيخ فخطبت الي الشاب فقال الكهل لم تحلل وكان اهلها غيبا فرجا اذا جاء اهلها ان يءثروه بها فجاءت رسول الله صلي الله عليه وسلم فقال قد حللت فانكحي من شءت فبهذا نقول وهم يقولون بقولنا فيه وينكرون ما روي عن علي رضي الله عنه ويخالفونه وعن صالح بن مسلم عن الشعبي ان عليا رضي الله عنه قال في التي تتزوج في عدتها قال تتم ما بقي من عدتها من الاول وتستانف من الاخر عدة جديدة وكذلك نقول وهو موافق لما روينا عن عمر وهم يقولون عليها عدة واحدة وينكرون ما روي عن علي رضي الله عنه ويخالفونه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم وابو معاوية ومحمد بن يزيد عن اسماعيل عن الشعبي عن شريح ان رجلا طلق امراته فذكرت انها قد حاضت في شهر ثلاث حيض ( ( ( تبتت ) ) ) فقال علي رضي الله عنه لشريح قل فيها فقال ان جاءت ببينة من بطانة اهلها يشهدون صدقت فقال له علي قالون وقالون بالرومية اصبت وهم لا ياخذون بهذا ويخالفونه اما بعضهم فيقول لا تنقضي العدة في اقل من اربعة وخمسين يوما ( قال الربيع ) قول الشافعي اقل ما تنقضي العدة فيمن تحيض ثلاثة وثلاثون يوما لان اقل الحيض يوم وليلة واقل الطهر خمس عشرة ليلة وقال بعضهم اقل ما تنقضي منه تسعة وثلاثون يوما (  ) واما نحن فنقول بما روي عن علي رضي الله عنه لانه موافق ما روي عن النبي صلي الله عليه وسلم انه لم يجعل للحيض وقتا ( قال الشافعي ) رحمه الله تعالي انه لا تنقضي عدتها في اقل من ثلاثة وثلاثين يوما ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا مالك عن هشام بن عروة عن ابيه عن عاءشة رضي الله عنها قالت قالت فاطمة بنت ابي حبيش لرسول الله صلي الله عليه وسلم اني لا اطهر افادع الصلاة فقال النبي صلي الله عليه وسلم انما ذلك عرق وليست بالحيضة فاذا اقبلت الحيضة فاتركي الصلاة فاذا ذهب قدرها فاغسلي عنك الدم وصلي فلم يوقت النبي صلي الله عليه وسلم لها وقتا في الحيضة فيقول كذا وكذا يوما ولكنه قال اذا اقبلت واذا ادبرت وروي عن سليمان التيمي عن ابي عمرو الشيباني عن بن مسعود في العزل قال هو الواد الخفي ولسنا نقول بهذا لا يرون بالعزل باسا وروي عن عمرو بن الهيثم عن شعبة عن عاصم عن زر عن علي رضي الله عنه انه كره العزل وليسوا ياخذون بهذا ولا يرون بالعزل باسا ونحن نروي عن عدد من اصحاب النبي صلي الله عليه وسلم انه سءل عنه فلم يذكر عنه نهيا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا سفيان عن عمرو عن عطاء بن ابي رباح عن جابر قال كنا نعزل والقران ينزل ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا يزيد بن هارون عن الاشعث عن ابي اسحاق عن عاصم بن ضمرة عن علي رضي الله عنه قال اكتموا الصبيان النكاح فان كل طلاق جاءز الا طلاق المعتوه ولسنا ناخذ بهذا ونقول لا طلاق لصغير حتي يبلغ ولا نجيز طلاق المعتوه ولا المبرسم ولا الناءم ويروي عن حماد بن سلمة عن حميد عن الحسن ان عليا رضي الله عنه قال لا طلاق لمكره وهم يخالفون هذا ويقولون طلاق المكره جاءز وحماد عن قتادة عن خلاس ان رجلا طلق امراته فاشهد علي طلاقها وراجعها واشهد علي رجعتها واستكتم الشاهدين حتي انقضت عدتها فرفع ذلك الي علي رضي الله عنه ففرق بينهما ولم يجعل له عليها رجعة وعزر الشاهدين وهم يخالفون  هذا ويجعلون الرجعة ثابتة ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن داود عن سماك عن ابي عطية الاسدي انه تزوج امراة اخيه وهي ترضع بن اخيه فقال والله لا اقربها حتي تفطمه فسال عليا رضي الله عنه عن ذلك فقال علي ان كنت انما تريد الاصلاح لك ولابن اخيك فلا ايلاء عليك وانما الايلاء ما كان في الغضب والله اعلم
   * المتعة
  * ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا سفيان عن اسماعيل عن قيس بن ابي حازم قال سمعت بن مسعود يقول كنا نغزو مع النبي صلي الله عليه وسلم وليس معنا نساء فاردنا ان نختصي فنهانا عن ذلك ثم رخص لنا ان ننكح المراة الي اجل بالشء وليسوا ياخذون بهذا ويخالفون ما روي عن عبد الله ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا سفيان عن الزهري قال حدثني حسن وعبد الله ابنا محمد بن علي عن ابيهما عن علي رضي الله عنه انه قال لابن عباس ان رسول الله صلي الله عليه وسلم نهي عن نكاح المتعة ولحوم الحمر الاهلية زمن خيبر ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا مالك عن بن شهاب عن عبد الله والحسن ابني محمد بن علي عن ابيهما عن علي رضي الله عنه ان النبي صلي الله عليه وسلم نهي عن متعة النساء يوم خيبر ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا سفيان عن الزهري قال اخبرني الربيع بن سبرة عن ابيه ان رسول الله صلي الله عليه وسلم نهي عن نكاح المتعة وبهذا يقول الشافعي ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا مغيرة عن ابراهيم عن عبد الله قال بيع الامة طلاقها وهم يثبتون مرسل ابراهيم عن عبد الله ويروون عنه انه قال اذا قلت قال عبد الله فقد حدثني غير واحد من اصحابه وهم لا يقولون بقول عبد الله هذا ويقولون لا يكون بيع الامة طلاقها وهكذا نقول ونحتج بحديث بريرة ان عاءشة رضي الله عنها اشترتها ولها زوج ثم اعتقتها فجعل لها النبي صلي الله عليه وسلم الخيار ولو كان بيعها طلاقها لم يكن للخيار معني وكانت قد بانت من زوجها بالشراء وروينا عن عثمان وعبد الرحمن بن عوف انهما لم يريا بيع الامة طلاقها اخبرنا بذلك سفيان عن الزهري عن ابي سلمة بن عبد الرحمن بن عوف اشتري من عاصم بن عدي جارية فاخبر ان لها زوجا فردها ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا عمرو بن الهيثم عن شعبة عن الحكم عن سالم بن ابي الجعد عن ابيه عن بن مسعود في الرجل يزني بامراة ثم يتزوجها قال لا يزالان زانيين ولسنا ولا اياهم نقول بهذا هما اثمان حين زنيا ومصيبان الحلال حين تناكحا غير زانيين وقد قال عمر وبن عباس نحو هذا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا شريك عن ابي حصين عن يحيي بن وثاب عن مسروق عن عبد الله قال اذا قال الرجل لامراته استلحقي باهلك او وهبها لاهلها فقبلوها فهي تطليقة وهو احق بها وبهذا نقول اذا اراد الطلاق وهم يخالفونه ويزعمون انها تطليقة باءنة عبد الله بن موسي عن بن ابي ليلي عن طلحة عن ابراهيم عن علقمة عن عبد الله قال لا يكون طلاق باءن الا خلع او ايلاء وهم يخالفونه في عامة الطلاق فيجعلونه باءنا واما نحن فنجعل الطلاق كله يملك الرجعة الا طلاق الخلع وروي عن رسول الله صلي الله عليه وسلم وعن عمر في البتة انها واحدة يملك فيها الرجعة ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا عمي محمد بن علي عن عبد الله بن علي بن الساءب عن نافع بن عجير عن ركانة انه طلق امراته البتة فقال له رسول الله صلي الله عليه وسلم ما اردت فقال والله ما اردت الا واحدة فردها اليه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا سفيان عن عمرو بن دينار عن محمد بن عباد عن المطلب قال قال لي عمر وطلقت امراتي البتة امسك عليك امراتك فان الواحدة تبت وروي عن زيد بن ثابت في التمليك وطلقت نفسها واحدة يملك الرجعة ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن  اسماعيل بن ابي خالد عن الشعبي ومغيرة عن ابراهيم عن عبد الله في الخيار ان اختارت نفسها فواحدة وهو احق بها وهكذا نقول نحن وهم يخالفونه ويرون الطلاق فيه باءنا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا حفص عن الاعمش عن ابراهيم في اختاري وامرك بيدك سواء وبهذا نقول وهم يخالفونه فيفرقون بينهما ابو معاوية ويعلي عن الاعمش عن ابراهيم عن مسروق ان امراة قالت لزوجها لو ان الامر الذي بيدك بيدي طلقت نفسي فقال قد جعلت الامر اليك فطلقت نفسها ثلاثا فسال عمر عبد الله عن ذلك فقال هي واحدة وهو احق بها فقال عمر وانا اري ذلك وبهذا نقول اذا جعل الامر اليها ثم قال لم ارد الا واحدة فالقول قوله وهي تطليقة يملك الرجعة وهم يخالفون هذا فيجعلونها واحدة باءنة ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن سيار ابي الحكم وابي حيان عن الشعبي ان رجلا قال من يذبح للقوم شاة وازوجه اول بنت تولد لي فذبح لهم رجل من القوم فاجاز عبد الله النكاح ولسنا ولا اياهم ولا احد من الناس علمته يقول بهذا يجعلون للذابح اجر مثله ولا يكون هذا نكاحا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن منصور عن ابراهيم عن بن مسعود قال يكره ان يطا الرجل امراته اذا فجرت او يطاها وهي مشركة وهم لا يقولون بهذا ويقولون لا باس ان يطاها قبل الفجور وبعده ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن بن ابي ليلي عن الشعبي عن عبد الله في الحامل المتوفي عنها لها النفقة من جميع المال ولسنا ولا احد يقول بهذا اذا مات الميت وجب الميراث لاهله والله اعلم
   * ما جاء في البيوع
  * ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا اسماعيل عن الشعبي عن عبيدة قال قال علي رضي الله تعالي عنه استشارني عمر في بيع امهات الاولاد فرايت انا وهو انها عتيقة فقضي به عمر حياته وعثمان بعده فلما وليت رايت انها رقيق ولسنا ولا اياهم نقول بهذا نقول بقول عمر لا تباع ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان عن نسير بن ذعلوق عن عمرو بن راشد الاشجعي ان رجلا باع نجيبة واشترط (  ) ثنياها فرغب فيها فاختصما الي عمر فقال اذهبا الي علي رضي الله عنه فقال علي اذهبا بها الي السوق فاذا بلغت اقصي ثمنها فاعطوه حساب ثنياها من ثمنها وليسوا يقولون بهذا وهو عندهم بيع فاسد فخالفوا عليا ولا نعلم له مخالفا في هذا من اصحاب النبي صلي الله عليه وسلم وهم يثبتون هذه الرواية عن علي رضي الله عنه فان يثبتوها فيلزمهم ان يقولوا به لانه ليس له دافع عندهم ونحن نقول هذا فاسد ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن علية عن عثمان البتي عن الحسن ان عليا رضي الله عنه قضي بالخلاص وليسوا يقولون بهذا يقولون ان استحق رد الباءع الثمن الذي قبض ولم يكن عليه ان يخلصها بثمن ولا غير ذلك وليسوا يروون خلاف هذا عن احد من اصحاب النبي صلي الله عليه وسلم فيلزمهم اذا ثبتوا هذا في اصل قولهم ان يقولوا به ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا حماد بن سلمة عن عطاء الخرساني ( ( ( الخراساني ) ) ) عن عبد الله بن ضمرة عن علي رضي الله تعالي عنه قال كسب الحجام من السحت وليسوا ياخذون بهذا ولا يرون بكسب الحجام باسا ونحن لا نري بذلك باسا ونروي عن النبي صلي الله عليه وسلم انه اعطي الحجام اجره ولو كان سحتا لم يعطه اياه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم وحفص وغيرهما عن الحجاج عن بن عمرو بن حريث عن ابيه انه باع عليا رضي الله عنه درعا منسوجة بالذهب باربعة الاف درهم الي العطاء  وليسوا يقولون بهذا هذا عندهم بيع مفسوخ لانه الي غير اجل ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا حماد بن سلمة عن قتادة عن خلاس بن عمر وعن علي رضي الله عنه فيمن اشتري ما احرز العدو قال هو جاءز وهم يقولون ان صاحبه اذا جاء بالخيار ان احب اخذه بالثمن اخذه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا ابو معاوية عن الاعمش عن ابراهيم التيمي عن ابيه عن عبد الله قال لا باس بالدرهم بالدرهمين ولسنا ولا اياهم نقول بهذا نقول بالاحاديث التي رويت عن رسول الله صلي الله عليه وسلم انه نهي عن الفضة بالفضة الا مثلا بمثل وعن الذهب بالذهب الا مثلا بمثل وقد كان عبد الله لقي اصحاب النبي صلي الله عليه وسلم فنهوه فلما رجع قال ما اري به باسا وما انا بفاعله ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن سليمان التيمي عن ابي عثمان عن بن مسعود قال من ابتاع مصراة فهو بالخيار ان شاء ردها وصاعا من طعام وهكذا نقول وبهذا مضت السنة وهم يزعمون انه اذا حلبها فليس له ردها لانه قد اخذ منها شيءا اخبرنا الربيع قال اخبرنا الشافعي قال اخبرنا ابو معاوية عن الاعمش عن زيد بن وهب عن عبد الله انه قال في ام الولد تعتق من نصيب ولدها ولسنا ولا اياهم نقول بهذا نقول بحديث عمر انه اعتق امهات الاولاد اذا مات ساداتهن ويقولون جميعا تعتق من راس المال ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن علية عن حماد عن ابراهيم عن علقمة عن عبد الله انه كره شراء المصاحف وبيعها وليسوا يقولون بهذا لا يرون باسا ببيعها وشراءها ومن الناس من لا يري بشراءها باسا ونحن نكره بيعها ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا وكيع ان عليا رضي الله عنه قال لا يحل اكل الثوم الا مطبوخا وليسوا يقولون بهذا بل ينكرونه ويقولون ما يقول بهذا احد ويروي عن النبي صلي الله عليه وسلم انه قال من اكل من هذه الشجرة فلا يقربن مساجدنا يءذينا بريح الثوم وهذا الذي ناخذ به
   * باب الديات
  * ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان الثوري عن ابي اسحاق عن عاصم بن ضمرة عن علي رضي الله عنه قال الخطا شبه العمد بالخشبة والحجر الضخم ثلث حقاق وثلث جذاع وثلث ما بين ثنية الي بازل عامها كلها خلفة وفي الخطا خمس وعشرون بنت مخاض وخمس وعشرون حقة وخمس وعشرون جذعة وخمس وعشرون بنت لبون ونحن نروي عن النبي صلي الله عليه وسلم في شبه العمد اربعون خلفة في بطونها اولادها وروي عن عمر انه قضي به ثلاثين حقة وثلاثين جذعة واربعين خلفة وبهذا نقول وهم يقولون بخلاف هذا ويقولون في الحجر الضخم والخشبة هذا عمد فيه القود ويعيبون مذهب صاحبهم بانه يقول هو خطا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا الطنافسي عن عبد الله بن حبيب بن ابي ثابت عن الشعبي عن مسروق قال كنت عند علي رضي الله عنه فاتاه ثلاثة فشهدوا علي اثنين انهما غرقا صبيا وشهد الاثنان علي الثلاثة انهم غرقوه فقضي علي رضي الله عنه علي الثلاثة بخمسي الدية وقضي علي الاثنين بثلاثة اخماس الدية ولسنا ولا احد علمناه يقول بهذا يقولون لولي الدم ان يدعي علي احدي الطاءفتين ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا جرير عن مغيرة عن الشعبي عن علي رضي الله عنه في الرجل يقتل المراة قال ان اراد اولياء المراة ان يقتصوا لم يكن ذلك لهم حتي يعطوا نصف الدية وليسوا يقولون بهذا يقولون بينهما القصاص في النفس وينكرون هذا القول ويقولون ما نعلم احدا يقوله ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا يزيد بن هارون عن هشام عن الحسن ان عليا رضي الله عنه قضي  بالدية اثني عشر الفا وهم يقولون الدية عشرة الاف ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن ابي زاءدة عن مجالد عن الشعبي عن علي رضي الله تعالي عنه انه قضي في القامصة والقارصة والواقصة جارية ركبت جارية فقرصتها جارية فقمصت فوقصت المحمولة فاندق عنقها فجعلها اثلاثا وليسوا يقولون بهذا وينكرون الحكم به ويقولون ما يقول هذا احد ويزعمون ان ليس علي الموقوصة شء وان ديتها علي العاقلة ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا عباد بن العوام عن عمرو بن عامر عن قتادة عن خلاس عن علي رضي الله عنه ان غلامين كانا يلعبان بقلة فقال احدهما حذار وقال الاخر حذار فاصابت ثنيته فكسرتها فرفع الي علي رضي الله عنه فلم يضمنه وهم يضمنون هذا ويخالفون ما رووا فيه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا حماد عن قتادة عن خلاس عن علي قال اذا امر الرجل عبده ان يقتل رجلا فانما هو كسيفه او سوطه يقتل المولي ويحبس العبد في السجن اخبرنا الربيع قال اخبرنا الشافعي قال اخبرنا سفيان عن مطرف عن الشعبي عن ابي جحيفة قال قلت لعلي رضي الله عنه هل عندكم من النبي صلي الله عليه وسلم غير ما في ايدي الناس قال لا الا ان يءتي الله عبدا فهما في القران وما في الصحيفة قلت وما في الصحيفة قال العقل وفكاك الاسير وان لا يقتل مءمن بكافر وهم يخالفون هذا ويقولون يقتل المءمن بالكافر ويخالفون ما رووا عن علي رضي الله عنه عن النبي صلي الله عليه وسلم ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا حماد بن سلمة عن سماك بن حرب عن عبيد بن القعقاع قال كنت رابع اربعة نشرب الخمر فتطاعنا بمدية كانت معنا فرفعنا الي علي رضي الله عنه فسجننا فمات منا اثنان فقال اولياء المتوفيين اقدنا من الباقيين فسال علي رضي الله عنه القوم ما تقولون فقالوا نري ان تقيدهما قال فلعل احدهما قتل صاحبه قالوا لا ندري قال وانا لا ادري وسال الحسن بن علي رضي الله تعالي عنهما فقال مثل مقالة القوم فاجابه بمثل ذلك فجعل دية المقتولين علي قباءل الاربعة ثم اخذ دية جراح الباقيين ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا حماد بن سلمة عن سماك عن حنش بن المعتمر ان ناسا حفروا بءرا لاسد فازدحم الناس عليها فتردي فيها رجل فتعلق برجل وتعلق الاخر باخر فجرحهم الاسد فاستخرجوا منها فماتوا فتشاجروا في ذلك حتي اخذوا السلاح فقال علي رضي الله تعالي عنه لم تقتلون ماءتين من اجل اربعة تعالوا فلنقض بينكم بقضاء ان رضيتم والا فارتفعوا الي رسول الله صلي الله عليه وسلم قال للاول ربع الدية وللثاني ثلث الدية وللثالث نصف الدية وللرابع الدية كاملة وجعل الدية علي قباءل الذين ازدحموا علي البءر فمنهم من رضي ومنهم من لم يرض فترافعوا الي رسول الله صلي الله عليه وسلم فقصوا عليه القصة وقالوا ان عليا رضي الله عنه قضي بكذا وكذا فامضي قضاء علي رضي الله تعالي عنه وهم لا ياخذون بهذا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا شعبة عن الاعمش عن شقيق عن عبد الله في جراحات الرجال والنساء تستوي في السن والموضحة وما خلا فعلي النصف وهم يخالفون هذا فيقولون علي النصف من كل شء ( اخبرنا الربيع ) قال اخبرنا سعيد عن ابي معشر عن ابراهيم عن عبد الله في الذي يقتص منه فيموت قال علي الذي اقتص منه الدية ويرفع عنه بقدر جراحته وليسوا يقولون بهذا بل نقول نحن وهم لا شء علي المقتص لانه فعل فعلا كان له ان يفعله
   * باب الاقضية
  * ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا سفيان عن الاجلح عن الشعبي عن علي رضي الله عنه اختصم اليه ناس ثلاثة يدعون ولدا فسالهم ان يسلم بعضهم لبعض فابوا فقال انتم شركاء متشاكسون ثم اقرع  بينهم فجعله لواحد منهم خرج سهمه وقضي عليه بثلثي الدية فذكر ذلك للنبي صلي الله عليه وسلم فقال اصبت واحسنت ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا شعبة عن سلمة بن كهيل قال سمعت الشعبي يحدث عن ابي الخليل او بن الخليل ان ثلاثة نفر اشتركوا في طهر فلم يدر لمن الولد فاختصموا الي علي رضي الله عنه فامرهم ان يقترعوا وامر الذي اصابته القرعة ان يعطي للاخرين ثلثي الدية وليسوا يقولون بهذا وهم يثبتون هذا عن علي رضي الله عنه عن النبي صلي الله عليه وسلم وهم يخالفونه والذي يقولونه هم ما يثبت عن النبي صلي الله عليه وسلم فليس لاحد ان يخالفه ولو ثبت عندنا عن النبي صلي الله عليه وسلم قلنا به ونحن نقول ندعو القافة له فان الحقوه باحدهم فهو ابنه وان الحقوه بكلهم او لم يلحقوه باحدهم فلا يكون له ويوقف حتي يبلغ فينتسب الي ايهم شاء ولا يكون له ابوان في الاسلام وهم يقولون هو ابنهم يرثهم ويرثونه وهو للباقي منهم ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا شعبة عن سماك عن ابي عبيد بن الابرص ان رجلا استاجر نجارا يضرب له مسمارا فانكسر المسمار فخاصمه الي علي رضي الله عنه فقال اعطه درهما مكسورا وهم يخالفون هذا ولا يقولون به ونحن لا نقول به ومن ضمن الاجير ضمنه قيمة المسمار ولم يجعل له شيءا اذا لم يتم العمل فان تم العمل فله ما استاجره عليه ان كانت الاجارة صحيحة وان كانت الاجارة فاسدة فله اجر مثله ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا ابو بكر بن عياش عن عبد العزيز بن رفيع عن موسي بن طريف الاسدي قال دخل علي رضي الله عنه بيت المال (  ) فاضرط به وقال لا امسي وفيك درهم فامر رجلا من بني اسد فقسمه الي الليل فقال الناس لو عوضته فقال ان شاء ولكنه سحت وهم يخالفون هذا ويقولون لا باس بالجعل علي القسم وهم يقولون قال علي سحت وهم يروون عن علي رضي الله عنه ان شاء اعطيته وهو سحت ونحن وهم نقول لا يحل لاحد ان يعطي السحت كما لا يحل لاحد ان ياخذه ولا نري عليا رضي الله عنه يعطي شيءا يراه سحتا ان شاء الله تعالي ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن علية عن اسماعيل بن ابي خالد عن الشعبي قال اتي علي رضي الله عنه في بعض الامر فقال ما اراه الا جورا ولولا انه صلح لرددته وهم يخالفون هذا ويقولون اذا كان جورا فهو مردود ونحن نروي عن النبي صلي الله عليه وسلم ان من اصطلح علي شء غير جاءز فهو رد ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا حفص بن غياث عن بن ابي ليلي عن الحكم عن حنش ان عليا رضي الله عنه راي الحلف مع البينة وهم يخالفون هذا ولا يستحلفون احدا مع بينته وهم يروون عن شريح انه استحلف مع البينة ولا نعلمهم يروون عن احد من اصحاب النبي صلي الله عليه وسلم خلافهما
   * باب اللقطة
  * ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا رجل عن شعبة عن ابي قيس قال سمعت هذيلا يقول رايت عبد الله اتاه رجل بصرة مختومة فقال قد عرفتها ولم اجد من يعرفها فقال استمتع بها وهذا قولنا اذا عرفها سنة فلم يجد من يعرفها فله ان يستمتع بها وهكذا السنة الثابتة عن النبي صلي الله عليه وسلم وحديث بن مسعود اشبه بالسنة وقد خالفوا هذا كله ورووا حديثا عن عامر عن ابيه عن عبد الله انه اشتري جارية فذهب صاحبها فتصدق بثمنها وقال اللهم عن صاحبها فان كره فلي وعلي الغرم ثم قال هكذا نفعل باللقطة فخالفوا السنة  في اللقطة التي لا حجة فيها وخالفوا حديث عبد الله بن مسعود الذي يوافق السنة وهو عندهم ثابت واحتجوا بهذا الحديث الذي عن عامر وهم يخالفونه فيما هو فيه بعينه يقولون ان ذهب الباءع فليس للمشتري ان يتصدق بثمنها ولكنه يحبسه حتي ياتي صاحبها متي جاء
   * باب الفراءض
  * ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا رجل عن شعبة عن عمرو بن مرة عن عبد الله بن سلمة عن علي رضي الله عنه انه كان يشرك بين الجد والاخوة حتي يكون سادسا وليسوا يقولون بهذا اما صاحبهم فيقول الجد اب فيطرح الاخوة واما هم ونحن فنقول بقول زيد يقاسم الاخوة ما كانت المقاسمة خيرا له ولا ينقص من الثلث من راس المال وهم ينكرون قول علي ويقولون ما يقول هذا احد ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا ابو معاوية عن الاعمش عن ابراهيم قال كان عمر وعبد الله يورثان الارحام دون الموالي (  ) وكان علي رضي الله عنه اشدهم في ذلك وليسوا يقولون بهذا يقولون اذا لم يكن اهل فراءض مسماة ولا عصبة ورثنا الموالي ونقول نحن لا نورث احدا غير من سميت له فريضة او عصبة وهم يورثون الارحام وليسوا بعصبة ولا مسمي لهم اذا لم تكن اموال وقالوا القول قول زيد والقياس عليه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا رجل عن بن ابي ليلي عن الشعبي عن الحرث عن علي رضي الله عنه انه ورث نفرا بعضهم من بعض ويقولون في هذا بقولنا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا رجل عن سفيان الثوري عن ابي قيس عن هذيل عن عبد الله انه لم يشرك ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا وكيع عن سفيان عن منصور عن ابراهيم ان عبد الله اشرك ونحن نقول يشرك وهم يخالفونه ويقولون لا نشرك ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا رجل عن سفيان الثوري عن معبد بن خالد عن مسروق عن عبد الله في ابنتين وبنات بن وبني بن للبنتين الثلثان وما بقي فلبني الابن دون البنات وكذلك قال في الاخوة والاخوات للاب مع الاخوات لاب وام ولسنا ولا احد علمته يقول بهذا انما يقول الناس للبنات او الاخوات الثلثان وما بقي فلبني الابن وبنات الابن او الاخوة والاخوات من الاب للذكر مثل حظ الانثيين ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا ابو معاوية عن الاعمش عن ابراهيم قال كان عبد الله يشرك الجد مع الاخوة فاذا كثروا اوفاه السدس ولسنا ولا احد يقول بهذا اما نحن فنقول انه اذا كان مع الاخوة لم ننقصه من الثلث واما بعضهم فكان يطرح الاخوة ويجعل المال للجد وبذلك يقولون ( اخبرنا الربيع ) قال اخبر الشافعي قال اخبرنا ابو معاوية عن الاعمش عن ابراهيم قال كان عبد الله يجعل الاكدرية من ثمانية للام سهم وللجد سهم وللاخت ثلاثة اسهم وللزوج ثلاثة اسهم ولسنا ولا احد يقول بهذا ولكنهم يقولون بما روي عن زيد بن ثابت نجعلها من تسعة للام سهمان وللجد سهم وللاخت ثلاثة اسهم وللزوج ثلاثة اسهم ثم يقاسم الجد الاخت فيجعل بينهما للذكر مثل حظ الانثيين ( اخبرنا الربيع ) قال اخبرنا الشافعي عن رجل عن الثوري عن اسماعيل بن رجاء عن ابراهيم ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا سفيان عمن سمع الشعبي يقول في جد وام واخت فللاخت ثلاثة اسهم وللام سهم وللجد سهمان وليسوا يقولون بهذا انما يقولون بقول زيد يجعلها من تسعة للام ثلاثة اسهم وللجد اربعة اسهم وللاخت سهمان ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا رجل عن شعبة عن الحكم عن ابراهيم عن عبد الله قال اهل الكتاب والمملوكون يحجبون ولا يورثون وليسوا يقولون بهذا يقولون بقول زيد لا يحجبون ولا يرثون  وهم يقولون في هذا بقولنا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن يونس عن بن سيرين ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا سفيان الثوري عن الاعمش عن ابراهيم ان عبد الله سءل عن رجل مات وترك اباه مملوكا ولم يدع وارثا قال يشتري من ماله فيعتق ثم يدفع اليه ما ترك وليسوا يقولون بهذا يقولون لا يرث المملوك ولا يورث ونحن نقول ماله في بيت المال وكذلك يقولون هم ان لم يوص به
   * باب المكاتب
  * ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان عن طارق عن الشعبي ان عليا رضي الله تعالي عنه قال في المكاتب يعتق منه بحساب وقال بن عمر وزيد بن ثابت هو عبد ما بقي عليه شء وروي ذلك عمرو بن شعيب وبذلك نقول ويقولون به معنا وهم يخالفون الذي رووا عن علي رضي الله تعالي عنه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا حجاج عن يونس بن ابي اسحاق عن ابيه عن الحارث عن علي رضي الله تعالي عنه يعتق من المكاتب بقدر ما ادي ويرث بقدر ما ادي وليسوا يقولون بهذا ( اخبرنا الربيع ) قال ( اخبرنا الشافعي ) قال اخبرنا رجل عن حماد عن قتادة عن خلاس عن علي رضي الله تعالي عنه قال يستسعي المكاتب بعد العجز وليسوا ولا احد من الناس يقول بهذا انما نقول اذا عجز فهو رقيق وحدثنا ان عليا رضي الله تعالي عنه قال لا نعجز المكاتب حتي يدخل نجما في نجم وليسوا ولا احد من المفتين يقول بهذا نحن وهم نقول اذا حلت نجومه فان لم يجد فهو عاجز رقيق ولا ينتظر بتعجيزه النجم الاخر وكذلك يقول مفتو الناس لا اعلمهم يختلفون فيه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا حماد بن خالد الخياط عن يونس بن ابي اسحاق عن ابيه عن ابي الاحوص قال قال عبد الله اذا ادي المكاتب قيمته فهو حر ونحن نروي عن زيد بن ثابت وبن عمر وعاءشة انه عبد ما بقي عليه شء وبه نقول
   * باب الحدود
  * ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا رجل عن شعبة عن سلمة بن كهيل عن الشعبي ان عليا رضي الله تعالي عنه جلد سراحه ( ( ( شراحة ) ) ) يوم الخميس ورجمها يوم الجمعة وقال اجلدها بكتاب الله وارجمها بسنة رسول الله صلي الله عليه وسلم وليسوا يقولون بهذا يقولون ترجم ولا تجلد والسنة الثابتة ان تجلد البكر ولا ترجم وترجم الثيب ولا تجلد وقد رجم رسول الله صلي الله عليه وسلم ماعزا ولم يجلده وقال لانيس اغد يا انيس علي امراة هذا فان اعترفت فارجمها فغدا انيس فاعترفت فرجمها ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان عن ابي اسحاق عن اشياخه ان عليا رضي الله تعالي عنه جلد امراة في الزني وعليها درع قيل لي جديد وكذلك يقول المفتون ولا اعلمهم يختلفون في ذلك هشيم عن الشيباني عن الشعبي ان عليا نفي الي البصرة بن مهدي عن سفيان عن ابي اسحاق عن اشياخه ان عليا رضي الله تعالي عنه نفي الي البصرة وليسوا ياخذون بهذا ويزعمون انه لا نفي علي احد ( ( ( احدا ) ) ) واما نحن فناخذ به لانه موافق لسنة رسول الله صلي الله عليه وسلم الثابتة ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا مالك وسفيان عن بن شهاب عن عبيد الله عن ابي هريرة وزيد بن خالد ان النبي صلي الله عليه وسلم قال للرجلين اللذين اختصما اليه لاقضين بينكما بكتاب الله عز وجل علي ابنك جلد ماءة وتغريب عام بن مهدي عن سفيان عن نسير بن ذعلوق عن خليد الثوري ان رجلا اقر عند علي بحد فجهد عليه ان يخبره  ما هو فابي فقال اضربوه حتي ينهاكم وهم يخالفون هذا ولا يقولون به ولا اعلمهم يروون عن احد من اصحاب النبي خلاف هذا فان كانوا يثبتون مثل هذه الرواية عن علي رضي الله تعالي عنه فيلزمهم ان يقولوا بهذا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان واسراءيل عن عبد الاعلي عن ابي جميلة عن علي رضي الله تعالي عنه قال قال رسول الله صلي الله عليه وسلم اقيموا الحدود علي ما ملكت ايمانكم وهم يخالفون هذا الي غير فعل احد علمته من اصحاب النبي صلي الله عليه وسلم ونحن نقول به وهو السنة الثابتة عن النبي صلي الله عليه وسلم ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بذلك مالك عن بن شهاب عن عبيد الله بن عبد الله عن ابي هريرة وزيد بن خالد ان النبي صلي الله عليه وسلم سءل عن الامة اذا زنت فقال اذا زنت امة احدكم فاجلدوها ثم ان زنت فاجلدوها ثم ان زنت فاجلدوها ثم بيعوها في الرابعة ولو بضفير حبل قال بن شهاب لا ادري بعد الثالثة او الرابعة والضفير الحبل ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن عيينة عن الزهري عن عبيد الله عن ابي هريرة وزيد بن خالد نحوه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا سفيان عن ايوب بن موسي عن سعيد بن ابي سعيد عن ابي هريرة رضي الله تعالي عنه ان النبي صلي الله عليه وسلم قال اذا زنت امة احدكم فتبين زناها فليجلدها الحد ولا يثرب عليها ثم ان عادت فزنت فتبين زناها فليجلدها الحد ولا يثرب عليها فان عادت زناها فليبعها ولو بضفير من شعر يعني الحبل وهم يخالفون ما رووا عن علي رضي الله تعالي عنه عن النبي صلي الله عليه وسلم وما روينا نحن عن النبي صلي الله عليه وسلم ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان الثوري عن علقمة بن مرثد عن حجر بن عنبس قال شهد رجلان علي رجل عند علي رضي الله تعالي عنه انه سرق فقال السارق لو كان رسول الله صلي الله عليه وسلم حيا لنزل عذري فامر بالناس فضربوا حتي اختلطوا ثم دعا الشاهدين فلم ياتيا فدرا الحد وليسوا ياخذون بهذا يقولون لا نسترهب الشهود يقولون نقف الشاهدين فان شهدا وكانا عدلين قطع وان لم يكونا عدلين لم تجز الشهادة وما علمت احدا ياخذ بقولهم هذا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا سفيان عن عاصم بن كليب عن ابيه قال لم ار السراق ( ( ( السارق ) ) ) قط اكثر منهم في زمان علي رضي الله تعالي عنه ولا رايته قطع احدا منهم قلت وكيف كان يصنع قال كان يامر الشهود ان يقطعوا وليسوا ياخذون بهذا يقولون اذا شهد الشهود فمن شاء الحاكم ان يامر بقطعه قطع ولا يامر بذلك الشهود ونحن نقول بهذا ولم نعلم رسول الله صلي الله عليه وسلم والاءمة بعده امروا شاهدين بقطع ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا سفيان عن مطرف عن الشعبي ان رجلين اتيا عليا رضي الله تعالي عنه فشهدا علي رجل انه سرق فقطع يده ثم اتياه باخر فقالا هذا الذي سرق واخطانا علي الاول فلم يجز شهادتهما علي الاخر وغرمهما دية يد الاول وقال لو اعلمكما تعمدتما لقطعتكما وبهذا نقول اذا قالا اخطانا علي الاول غرمتهما دية يد المقطوع وان قالا عمدنا ان نشهد عليه بباطل قطعت ايديهما بيده قودا وهذا اشبه بالقياس ان كان يجوز ان يقتل اثنان بواحد فلم لا تقطع يدان بيد واليد اقل من النفس واذا جاز الكثير فلم لا يجوز القليل وهم يخالفون عليا رضي الله عنه في الشاهدين اذا تعمدا ويقولون لا تقطع ايديهما بيد ولا تقطع يدان بيد وهم يقولون يقتل اثنان بواحد ولا تقطع يدان بيد ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا رجل عن رجل عن علي بن عبد الاعلي عن ابيه عن ابي جحيفة ( ( ( حنيفة ) ) ) ان عليا رضي الله عنه اتي بصبي قد سرق بيضة فشك في احتلامه فامر به فقطعت بطون انامله وليسوا ولا احد علمته يقول بهذا يقولون ليس علي الصبي حد حتي يحتلم  او يبلغ خمس عشرة ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن حماد بن زيد عن عمرو بن دينار ان عليا رضي الله تعالي عنه قطع من شطر القدم ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا هشيم عن مغيرة عن الشعبي ان عليا كان يقطع الرجل من القدم ويدع العقب يعتمد عليه وليسوا ولا احد علمناه يقول بهذا القول بل يقولون تقطع الرجل من الكعب الذي فيه المفصل بين الساق والقدم ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا ابو بكر بن عياش عن بن حصين عن سويد بن غفلة ان عليا رضي الله عنه اتي بزنادقة فخرج بهم الي السوق فحفر لهم حفرا فقتلهم ثم رمي بهم في الحفر فحرقهم بالنار وهم يخالفون هذا فيقولون لا يحرق بالنار احد اما نحن فروينا عن النبي صلي الله عليه وسلم انه نهي ان يعذب احد بعذاب الله فقلنا به ولا نحرق حيا ولا ميتا بن علية عن سليمان التيمي عن ابي عمرو الشيباني ان رجلا تنصر بعد اسلامه فاتي به الي علي رضي الله تعالي عنه فجعل يعرض عليه فقال لا ادري ما تقول غير انه يشهد ان المسيح بن الله فوثب اليه علي رضي الله تعالي عنه فوطءه وامر الناس ان يطءوه ( ( ( يطءوه ) ) ) ثم قال كفوا فكفوا عنه فاذا هو قد مات وهم لا ياخذون بهذا يقولون لا يقتل الامام احدا بهذه القتلة ولا يقتل الا بالسيف ابو بكر بن عياش عن عاصم عن ابي المغيرة في قوم دخلوا علي امراة في دار قوم فخرج اليهم بعض اهل الدار فقتلوهم فاصبحوا وقد جاءت عشاءرهم الي علي رضي الله تعالي عنه فرفعوهم اليه فقال علي رضي الله تعالي عنه وما جمع هءلاء في دار واحدة ليلا وقال بيده فقلبها ظهرا لبطن ثم قال لصوص قتل بعضهم بعضا قوموا فقد اهدرت دماءهم فقال الحسن انا اضمن هذه الدماء فقال انت اعلم بنفسك وليسوا يقولون بهذا اما نحن فنروي عن علي رضي الله عنه ان رجلا وجد مع امراته رجلا فقتله فسءل علي رضي الله تعالي عنه فقال ان لم يات باربعة شهداء فليعط برمته اخبرنا بذلك مالك عن يحيي بن سعيد عن بن المسيب وبهذا نقول نحن وهم الا انهم يقولون في اللص يدخل دار رجل فيقتله ينظر الي المقتول فان لم يكن يعرف باللصوصية قتل القاتل وان كان يعرف باللصوصية درء عن القاتل القتل وكانت عليه الدية وهذا خلاف ما رووا عن علي رضي الله تعالي عنه بن مهدي عن سفيان عن الشيباني عن بعض اصحابه ان رجلا اتي عليا رضي الله تعالي عنه برجل فقال ان هذا يزعم انه احتلم علي ام الاخر فقال اقمه في الشمس واضرب ظله وليسوا يقولون بهذا ( اخبرنا الربيع ) قال اخبرنا الشافعي قال حدثنا يزيد بن هارون عن حماد بن سلمة عن ابي بشر عن شبيب بن ابي روح ان رجلا كان تواعد جارية له مكانا في خلاء فعلمت جارية بذلك فاتته فحسبها جاريته فوطءها ثم علم فاتي عمر فقال اءت عليا فسال عليا رضي الله تعالي عنه فقال اري ان تضرب الحد في خلاء وتعتق رقبة وعلي المراة الحد وليسوا يقولون بهذا يقولون يدرا عنه الحد بالشبهة فاما نحن فنقول في المراة تحد كما رووا عن علي رضي الله تعالي عنه لانها زنت وهي تعلم ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن مهدي عن سفيان عن سلمة بن كهيل عن حجية بن عدي قال كنت عند علي رضي الله تعالي عنه فاتته امراة فقالت ان زوجي وقع علي جاريتي فقال ان تكوني صادقة نرجمه وان تكوني كاذبة نجلدك وبهذا ناخذ لان زناه بجارية امراته كزناه بغيرها الا ان يكون ممن يعذر بالجهالة ويقول كنت اري انها لي حلال وهم يخالفون هذا ويدرءون عنه الحد كان جاهلا او عالما وعن عمرو بن شعيب قال رايت رجلا يستقي علي بءر قد قطعت يده وتركت ابهامه فقلت من قطعك فقال علي وهم يخالفون هذا ويقولون تقطع من مفصل الكف ويروي ذلك عن النبي صلي الله عليه وسلم ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بن علية عن سعيد بن عبد الله عن حصين بن المنذر ان عليا رضي الله تعالي عنه جلد الوليد في الخمر اربعين وهم يخالفون  هذا ويقولون يجلد ثمانين ونحن نروي عن علي رضي الله تعالي عنه انه جلد الوليد بالمدينة بسوط له طرفان اربعين فذلك ثمانون وبه نقول ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا بذلك سفيان بن عيينة عن عمرو بن دينار عن محمد بن علي عن علي رضي الله تعالي عنه ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا رجل عن بن ابي ذءب عن القاسم بن الوليد عن يزيد اراه بن مذكور ان عليا رضي الله تعالي عنه رجم لوطيا وبهذا ناخذ نرجم اللوطي محصنا كان او غير محصن وهذا قول بن عباس وسعيد بن المسيب يقول السنة ان يرجم اللوطي احصن او لم يحصن رجع الشافعي فقال لا يرجم الا ان يكون قد احصن وعكرمة يرويه عن بن عباس عن النبي صلي الله عليه وسلم وصاحبهم يقول ليس علي اللوطي حد ولو تلوط وهو محرم لم يفسد احرامه ولا غسل عليه ما لم يمن وقد خالفه بعض اصحابه فقال اللوطي مثل الزاني يرجم ان احصن ويجلد ان لم يحصن ولا يكون اللوطي اشد حالا من الزاني وقد بين الله عز وجل فرقا بينهما فاباح جماع النساء بوجهين احدهما النكاح والاخر ملك اليمين وحرم هذا من كل الوجوه فمن اين يشتبهان ( اخبرنا الربيع ) قال اخبرنا الشافعي قال اخبرنا الاعمش عن القاسم بن عبد الرحمن عن ابيه قال جاء رجل الي علي رضي الله عنه فقال اني سرقت فطرده ثم قال اني سرقت فقطع يده وقال انك شهدت علي نفسك مرتين وهم يخالفون هذا ويقولون حتي يقول اربع مرات وانما تركنا نحن ان نقول الاعتراف بمنزلة الشهادة لان النبي صلي الله عليه وسلم امر انيسا الاسلمي ان يغدو علي امراة فان اعترفت رجمها ولم يقل اربع مرات ولو كان الاقرار يشبه الشهادة كان لو اقر اربع مرات ثم رجع بطل عنه الحد وهم يقولون في الزني لا يحد الزاني حتي يقر اربعا قياسا علي الشهادات ويخالفون ما رووا عن علي رضي الله تعالي عنه ويقولون في السرقة اقراره مرة واكثر سواء ويخالفون ما رووا عن علي رضي الله عنه وروينا عن النبي صلي الله عليه وسلم ويدعون القياس فيه وكيع عن سفيان الثوري عن سماك عن قابوس بن مخارق ان محمد بن ابي بكر كتب الي علي يساله عن مسلم زني بنصرانية فكتب اليه ان اقم الحد علي المسلم وادفع النصرانية الي اهل دينها وهم يقولون ايضا يقام الحد علي النصرانية ويخالفون هذا الحديث يزيد بن هارون عن ايوب عن قتادة عن خلاس عن علي رضي الله عنه في حرين باع احدهما صاحبه فقطعهما علي جميعا وهم يخالفون هذا وينكرون القول فيه ابو بكر بن عياش قال حدثني ابو حصين عن عامر الكاهلي قال كنت عند علي رضي الله عنه اذ اتي برجل فقال ما شان هذا فقالوا يا امير المءمنين وجدناه تحت فراش امراة فقال لقد وجدتموه علي نتن فانطلقوا به الي نتن مثله فمرغوه فيه فمرغوه في عذرة وخلي سبيله وهم يخالفون هذا ويقولون يضرب ويرسل وكذلك قول المفتين لا يختلفون في ذلك سفيان عن مطرف عن الشعبي عن بن مسعود انه كان يقول لا نري علي الذي يصيب وليدة امراته حدا ولا عقرا رجل عن شعبة عن منصور عن ربعي بن خراش عن عبد الله ان رجلا اتاه فذكر له انه اصاب جارية امراته فقال استغفر الله ولا تعد وهم يخالفون هذا ويقولون يعزر واما نحن فنقول ان كان من اهل الجهالة وقال قد كنت اري انها حلال لي فانا ندرا عنه الحد وعزرناه وان كان عالما حددناه حد الزاني بن مهدي عن سفيان عن عيسي بن ابي عزة عن الشعبي عن بن مسعود ان رسول الله صلي الله عليه وسلم قطع سارقا في قيمة خمسة دراهم ونحن ناخذ بهذا الا انا نقطع في ربع دينار وخمسة دراهم في عهد النبي صلي الله عليه وسلم اكثر من ربع دينار وهم يخالفون هذا ويقولون لا قطع في اقل من عشرة دراهم رجل عن شعبة عن الاعمش عن القاسم بن عبد الرحمن عن ابيه عن عبد الله انه وجد امراة مع رجل في لحافها علي فراشها فضربه خمسين فذهبوا فشكوا ذلك الي عمر رضي الله عنه فقال لم فعلت ذلك قال  لاني اري ذلك قال وانا اري ذلك واصحابنا يذهبون الي انه يبلغ بالتعزير هذا واكثر منه الي ما دون الثمانين بقدر الذنوب وهم يقولون لا يبلغ بالتعزير في شء اربعين فيخالفون ما رووا عن عمر وبن مسعود رضي الله عنهما يزيد بن هارون عن بن ابي عروبة عن حماد عن ابراهيم عن عبد الله في ام الولد تزني بعد موت سيدها تجلد وتنفي وهم لا يقولون بهذا يقولون لا ينفي احد زان ولا غيره ونحن نقول ينفي الزاني بسنة رسول الله صلي الله عليه وسلم وما روي عن ابي بكر وعمر وعثمان وعلي وعبد الله بن مسعود وابي بن كعب وابي الدرداء وعمر بن عبد العزيز رضي الله عنهم كلهم قد راوا النفي جرير عن منصور عن زيد بن وهب ان عبد الله دخل المسجد والامام راكع فركع ثم دب راكعا بن عيينة عن عمرو عن ابي عبيدة عن رجل عن مجالد عن الشعبي عن عمه قيس بن عبد عن عبد الله مثله وهكذا نقول نحن وقد فعل هذا زيد بن ثابت وهم ينهون عن هذا ويخالفونه بن عيينة عن عمرو بن دينار عن ابي عبيدة قال كان عبد الله يصلي الصبح نحوا من صلاة امير المءمنين يعني بن الزبير وكان بن الزبير يغلس رجل عن شعبة عن سلمة بن كهيل عن ابي عمرو الشيباني ( ( ( والشيباني ) ) ) قال كان عبد الله يصلي بنا الصبح بسواد او قال بغلس فيقرا بسورتين وبهذا جاءت السنة وهو قولنا وهم يخالفونه ويقولون بل يسفر والذي اخذنا به ان سفيان اخبرنا عن الزهري عن عروة عن عاءشة رضي الله عنها قالت كان رسول الله صلي الله عليه وسلم يصلي الصبح فتنصرف النساء متلفعات بمروطهن ما يعرفن من الغلس مالك عن يحيي بن سعيد عن عمرة عن عاءشة مثله بن علية عن عوف عن سيار بن سلمة ابي المنهال عن ابي برزة الاسلمي انه سمعه يصف صلاة رسول الله صلي الله عليه وسلم فقال كان يصلي الصبح ثم ينصرف وما يعرف الرجل منا جليسه وكان يقرا بالستين الي الماءة بن ادريس عن الحسن بن عبيد الله عن ابراهيم عن علقمة عن عبد الله ان رسول الله صلي الله عليه وسلم صلي الظهر خمسا فقيل له زيد في الصلاة او قالوا صليت خمسا فاستقبل القبلة فسجد سجدتين رجل عن شعبة عن الحكم عن ابراهيم عن علقمة عن عبد الله عن النبي صلي الله عليه وسلم مثله وبهذا ناخذ وهو يوافق ما روينا عن ابي هريرة وبن عمر رضي الله تعالي عنهم عن النبي صلي الله عليه وسلم في قصة ذي اليدين وهم لا ياخذون بهذا ويزعمون انه ان لم يكن جلس في الرابعة قدر التشهد فسدت صلاته ابو معاوية وحفص عن الاعمش عن ابراهيم عن علقمة عن عبد الله ان رسول الله صلي الله عليه وسلم تكلم ثم سجد سجدتي السهو بعد السلام ( قال الشافعي ) رحمه الله تعالي وذلك لانه انما ذكر السهو بعد السلام فسءل فلما استيقن انه قد سها سجد سجدتي السهو ونحن ناخذ بهذا مالك عن داود بن الحصين عن ابي سفيان مولي بن ابي احمد عن ابي هريرة عن ابي اسامة عن عبيد الله عن نافع عن بن عمر بن علية وهشيم عن خالد الحذاء عن ابي قلابة عن ابي المهلب عن عمران بن الحصين ان النبي صلي الله عليه وسلم قال ابو هريرة وبن عمر في ركعتين وقال عمران في ثلاث فقال له ذو اليدين اقصرت الصلاة ام نسيت فقال كل ذلك لم يكن ثم اقبل علي الناس فقال اكما يقول ذو اليدين فقالوا نعم فاستقبل القبلة فاتم ما بقي من صلاته ثم سجد سجدتي السهو وهم يخالفون هذا كله ويقولون لا يسجد للسهو بعد الكلام رجل عن الاعمش عن عمارة بن عمير عن عبد الرحمن بن يزيد عن عبد الله قال ما رايت رسول الله صلي الله عليه وسلم صلي صلاة قط الا لوقتها الا بالمزدلفة فانه جمع بين المغرب والعشاء وصلي الصبح يومءذ قبل وقتها ( قال الشافعي ) رحمه الله تعالي ولو كان صلاها بعد الفجر لم يقل قبل وقتها ولقال في وقتها الاول بن مهدي عن شعبة عن ابي اسحاق عن عبد الرحمن بن يزيد قال كان عبد الله يصلي الصبح بجمع ولو ان متسحرا تسحر لجاز ذلك ( قال الشافعي ) ولم يختلف احد في ان لا يصلي احد الصبح غداة جمع ولا في غيرها الا بعد الفجر وهم  يخالفونه ايضا في قوله ان النبي صلي الله عليه وسلم لم يجمع الا بين المغرب والعشاء فيزعمون ان الامام يجمع بين الظهر والعصر بعرفة وكذلك نقوله نحن للسنة التي جاءت عن النبي صلي الله عليه وسلم وقد روي ذلك حاتم بن اسماعيل عن جعفر بن محمد عن ابيه عن جابر قال فراح النبي صلي الله عليه وسلم يوم عرفة حين زالت الشمس فخطب ثم صلي الظهر والعصر معا وروينا ان النبي صلي الله عليه وسلم جمع بين الصلاتين في غير ذلك الموطن مالك عن نافع عن بن عمر قال كان رسول الله صلي الله عليه وسلم اذا عجل به السير يجمع بين المغرب والعشاء مالك عن ابي الزبير عن ابي الطفيل عن معاذ بن جبل ان النبي صلي الله عليه وسلم كان يجمع بين الظهر والعصر وبين المغرب والعشاء في سفره الي تبوك اخبرنا الليث عن عقيل بن خالد عن الزهري عن انس بن مالك قال كان النبي صلي الله عليه وسلم اذا ارتحل قبل ان تزول الشمس اخر الظهر حتي يدخل اول وقت العصر ثم ينزل فيصليهما معا اخبرنا ابو خالد الاحمر عن بن عجلان عن حسين بن عبد الله عن كريب مولي بن عباس عن بن عباس انه قال الا اخبركم عن صلاة رسول الله صلي الله عليه وسلم في السفر كان رسول الله صلي الله عليه وسلم اذا زالت الشمس وهو في المنزل جمع بين الظهر والعصر في وقت الظهر واذا ارتحل قبل الزوال اخر الظهر حتي يصليها في وقت العصر وهذه مواطن قد جمع النبي صلي الله عليه وسلم فيها غير عشية عرفة وليلة جمع بن علية عن ايوب عن محمد بن عجلان ان بن مسعود كان يقرا في الاخرتين بفاتحة الكتاب وبهذا نقول ولا يجزيه الا ان يقراها فان نسي اعاد وهم يقولون ان شاء قرا وان شاء لم يقرا وان شاء سبح محمد بن عبيد عن محمد بن اسحاق عن عبد الرحمن بن الاسود عن ابيه ان عبد الله صلي به وبعلقمة فاقام احدهما عن يمينه والاخر عن يساره وقال هكذا كان يفعل النبي صلي الله عليه وسلم وليسوا يقولون بهذا ونحن معهم يكونان خلف الامام فاما نحن فناخذ بحديث مالك عن اسحاق بن عبد الله عن انس ان النبي صلي الله عليه وسلم قال قوموا لاصلي لكم فقمت الي حصير فنضحته بماء فقام عليه رسول الله صلي الله عليه وسلم وصففت انا واليتيم وراءه والعجوز من وراءنا فصلي بنا ركعتين ثم انصرف اخبرنا مالك عن بن شهاب عن عبيد الله بن عبد الله عن ابيه قال دخلت علي عمر بالهاجرة فوجدته يسبح فقمت وراءه فقربني حتي جعلني حذاءه عن يمينه فلما جاء يرفا تاخرت فصففنا وراءه اخبرنا الاعمش عن ابراهيم عن علقمة والاسود قالا دخلنا علي عبد الله في داره فصلي بنا فلما ركع طبق بين كفيه فجعلهما بين فخذيه فلما انصرف قال كاني انظر الي اختلاف اصابع رسول الله صلي الله عليه وسلم بين فخذيه واقام احدنا عن يمينه والاخر عن يساره وليسوا يقولون بهذا ولا نحن اما نحن فناخذ بحديث رواه يحيي القطان عن عبد الحميد بن جعفر قال حدثني محمد بن عمرو بن عطاء عن ابي حميد الساعدي انه سمعه في عدة من اصحاب النبي صلي الله عليه وسلم احدهم ابو قتادة يقول كان رسول الله صلي الله عليه وسلم اذا ركع وضع يديه علي ركبتيه اخبرنا بن علية عن محمد بن اسحاق قال حدثني علي بن يحيي بن خلاد الزرقي عن ابيه عن عمه رفاعة عن رافع ان رسول الله صلي الله عليه وسلم قال لرجل اذا ركعت فضع يديك علي ركبتيك اخبرنا شعبة عن عمرو بن مرة عن عبد الله بن سلمة قال صلي عبد الله باصحابه الجمعة ضحي وقال خشيت الحر عليكم وليسوا يقولون بهذا ولا يقول به احد صلي النبي صلي الله عليه وسلم وابو بكر وعمر وعثمان والاءمة بعد في كل جمعة بعد زوال الشمس اخبرنا يحيي بن عباد عن شعبة عن ابراهيم بن مهاجر عن ابراهيم النخعي عن الاسود عن عبد الله انه كان يوتر بخمس او سبع سفيان عن الاعمش عن ابراهيم عن عبد الله انه كان يكره ان يكون ثلاثا وتر  ولكن خمسا او سبعا وليسوا يقولون بهذا يقولون صلاة الليل مثني مثني الا الوتر فانها ثلاث متصلات لا يصلي الوتر اكثر من ثلاث واما نحن فنقول بالسنة الثابتة اخبرنا مالك عن نافع وعبد الله بن دينار عن بن عمر ان رجلا سال رسول الله صلي الله عليه وسلم عن صلاة الليل فقال رسول الله صلي الله عليه وسلم صلاة الليل مثني مثني فاذا خشي احدكم الصبح صلي ركعة واحدة توتر له ما قد صلي اخبرنا سفيان عن عبد الله بن دينار عن بن عمر مثله اخبرنا سفيان عن الزهري عن سالم عن ابيه قال سمعت رسول الله صلي الله عليه وسلم يقول صلاة الليل مثني مثني فاذا خشي احدكم الصبح فليوتر بواحدة سفيان عن عمرو بن دينار عن طاوس عن بن عمر عن النبي صلي الله عليه وسلم مثله هشيم وابو معاوية وبن علية وغير واحد عن بن عون وعاصم عن بن سيرين عن يحيي بن الجزار اظنه عن عبد الله انه صلي وعلي بطنه فرث ودم وليسوا يقولون بهذا يقولون اذا كان علي بطنه مقدار الدرهم الكبير اعاد الصلاة وان كان اقل لم يعد ولم نعلم احدا ممن مضي قال اذا كان الدم في الثوب او علي الجسد مقدار الدرهم اعاد الصلاة وان كان اقل لم يعد اخبرنا هشيم عن حصين عن خارجة بن الصلت ان بن مسعود ركع فمر به رجل فقال السلام عليك يا ابا عبد الرحمن فقال عبد الله صدق الله ورسوله فلما قضي صلاته قيل له كان الرجل راعك قال اجل اني سمعت رسول الله صلي الله عليه وسلم يقول لا تقوم الساعة حتي تتخذ المساجد طرقا وحتي يسلم الرجل علي الرجل للمعرفة وليسوا يقولون بهذا وهو عندهم نقض للصلاة اذا تكلم بمثل هذا حين يريد به الجواب وهم لا يروون خلاف هذا عن احد من اصحاب النبي صلي الله عليه وسلم وبن مسعود روي عن النبي صلي الله عليه وسلم انه نهي عن الكلام في الصلاة ولو كان هذا عنده من الكلام المنهي عنه لم يتكلم به اخبرنا يزيد بن هارون عن محمد بن اسحاق عن عبد الرحمن بن الاسود عن ابيه قال رايت بن مسعود اذا مر بين يديه رجل وهو يصلي التزمه حتي يرده ونحن نقول بهذا وهو يوافق ما روينا عن النبي صلي الله عليه وسلم وهم لا ياخذون به واحسبهم يقولون ان هذا ينقض الصلاة ولا يروون قولهم هذا عن احد من اصحاب رسول الله صلي الله عليه وسلم ويدعون قول عبد الله وهو موافق السنة اخبرنا ابو معاوية عن الاعمش عن ابي اسحاق عن ابي الاحوص عن عبد الله قال اذا ادركت ركعة من الجمعة فاضف اليها اخري واذا فاتك الركوع فصل اربعا وبهذا نقول لانه موافق معني ما روينا عن رسول الله صلي الله عليه وسلم وقد خالف هذا بعضهم فزعم انه اذا لم يدرك الخطبة صلي اربعا رجع بعضهم الي ان قال مثل قولنا وقال بعضهم اذا ادرك الامام في شء من الصلاة وان كان جالسا صلي ركعتين فخالف هذا الحديث والذي قبله اخبرنا رجل عن الاعمش عن المسيب بن رافع عن عامر بن عبدة قال قال عبد الله هيءت عظام بن ادم للسجود فاسجدوا حتي بالمرافق وليسوا يقولون بهذا ولا نعلم احدا يقول بهذا فاما نحن فاخبرنا سفيان عن داود بن قيس عن عبيد الله بن عبد الله بن اقرم الخزاعي عن ابيه قال رايت رسول الله صلي الله عليه وسلم بالقاع من نمرة ساجدا فرايت بياض ابطيه اخبرنا سفيان قال اخبرنا عبد الله بن اخي يزيد بن الاصم عن عمه يزيد بن الاصم عن ميمونة انها قالت كان النبي صلي الله عليه وسلم اذا سجد لو ارادت بهيمة ان تمر من تحته لمرت مما يجافي ابو معاوية عن الاعمش عن ابراهيم قال خبط عبد الله الحصا بيده خبطة في المسجد فقال لبيك وسعديك رجل عن الشيباني عن عبد الرحمن بن الاسود عن عمه عبد الرحمن بن يزيد عن عبد الله نحوه وهذا عندهم فيما اعلم كلام في الصلاة يكرهونه واما نحن فنقول كل شء من الكلام خاطبت به الله عز وجل ودعوته به فلا باس به وذلك لان سفيان حدثنا عن الزهري عن سعيد بن المسيب عن ابي هريرة رضي الله عنه ان  رسول الله صلي الله عليه وسلم لما رفع راسه من الركعة الاخرة من صلاة الصبح قال اللهم انج الوليد بن الوليد وسلمة بن هشام وعياش بن ابي ربيعة والمستضعفين بمكة اللهم اشدد وطاتك علي مضر واجعلها عليهم سنين كسني يوسف وهم يخالفون هذا كله ويقولون القنوت قبل الركوع بن مهدي عن سفيان الثوري عن الاعمش عن عمارة عن الاسود قال كان عبد الله لا يقصر الصلاة الا في حج او عمرة وهم يخالفون هذا ويقولون تقصر الصلاة في كل سفر بلغ ثلاثا وغيرهم يقول كل سفر بلغ ليلتين اخبرنا اسحاق بن يوسف وغيره عن محمد بن قيس عن عمران بن عمير مولي بن مسعود عن ابيه قال سافرت مع بن مسعود الي ضيعة بالقادسية فقصر الصلاة بالنجف وليسوا ولا احد علمته من المفتين يقول بهذا اما هم فيقولون تقصر الصلاة في اقل من مسيرة ثلاث ليال قواصد ولا اعلمهم يروون هذا عن احد ممن مضي ممن قوله حجة بل يروون عن حذيفة خلاف قولهم رواه ابو معاوية عن الاعمش عن ابراهيم التيمي عن ابيه قال استاذنت حذيفة من المداءن فقال اذن لك علي ان لا تقصر حتي ترجع وهم يخالفون هذا ويقولون يقصر من الكوفة الي المداءن واما نحن فناخذ في القصر بقول بن عمر وبن عباس تقصر الصلاة في مسيرة اربع برد اخبرنا بذلك بن عيينة عن عمرو بن دينار عن عطاء بن يسار عن بن عباس قال تقصر الصلاة الي عسفان والي الطاءف وجدة وهذا كله من مكة علي اربعة برد ونحو من ذلك اخبرنا مالك عن نافع عن سالم عن بن عمر انه خرج الي ذات النصب ( ( ( النصيب ) ) ) فقصر الصلاة قال مالك وهي اربع برد وهم يخالفون روايتهم عن حذيفة وبن مسعود وروايتنا عن بن عباس وبن عمر رضي الله عنهم بن مهدي عن سفيان الثوري عن قيس بن مسلم عن طارق بن شهاب قال قال عبد الله لا تغيروا بسوادكم فانما سوادكم من كوفتكم يعني لا تقصروا الصلاة الي السواد وهم يقولون ان اراد من السواد مسيرة ثلاث قصر اليه الصلاة وهذه احاديث يروونها في صلاة السفر مختلفة يخالفونها كلها بن مهدي عن سفيان عن اشعث بن سليم عن عبد الله بن زياد قال سمعت عبد الله يقرا في الظهر والعصر وهذا عندنا لا يوجب سهوا ولا نري باسا ان تعمد الجهر بالقراءة ليعلم من خلفه انه يقرا وهم يكرهون هذا يكرهون ان يجهر بشء من القراءة في الظهر والعصر ويوجبون السهو علي من فعله ونحن نوافق هذا وهم يخالفونه بن مهدي عن سفيان عن ابي اسحاق عن الاسود ان عبد الله كان يكبر من صلاة الصبح من يوم عرفة الي صلاة العصر من يوم النحر بن مهدي عن سفيان الثوري عن غيلان بن جامع عن عمرو بن مرة عن ابي واءل عن عبد الله مثله وليسوا يقولون بهذا يقولون يكبر من صلاة الصبح يوم عرفة الي صلاة العصر من اخر ايام التشريق واما نحن فنقول بما روي عن بن عمر وبن عباس يكبر من صلاة الظهر من يوم النحر الي صلاة الصبح من اخر ايام التشريق فنترك قول بن مسعود لقول بن عباس وبن عمر واما هم فيخالفون قول من سمينا وما رووا عن بن مسعود معا والذي قلنا اشبه الاقاويل والله تعالي اعلم بما يعرف اهل العلم وذلك ان للتلبية وقتا تنقضي اليه وذلك يوم النحر وان التكبير انما يكون خلف الصلاة واول صلاة تكون بعد انقضاء التلبية يوم النحر صلاة الظهر واخر صلاة تكون بمني صلاة الصبح من اخر ايام التشريق بن مهدي عن سفيان عن ابي اسحاق عن سليم بن حنظلة قال قرات السجدة عند عبد الله فنظرت اليه فقال انت اعلم فاذا سجدت سجدنا وبهذا نقول ليست السجدة بواجبة علي من قرا وعلي من سمع واحب الينا ان يسجد واذا سجد القارء احببنا للسامع ان يسجد وقد روينا هذا عن النبي صلي الله عليه وسلم وعن عمر ورووا ذلك عن بن مسعود وهم يخالفون هذا ويزعمون انها واجبة علي السامع ان يسجد وان لم يسجد الامام فيخالفون روايتهم عن بن مسعود وروايتنا عن النبي صلي الله عليه وسلم  وعن عمر بن عيينة عن عبدة عن زر بن حبيش عن بن مسعود انه كان لا يسجد في ص ويقول انما هي توبة نبي بن عيينة عن ايوب عن عكرمة عن بن عباس عن النبي صلي الله عليه وسلم انه سجدها وهم يخالفون بن مسعود ويقولون هي واجبة بن علية عن داود بن ابي هند عن الشعبي عن علقمة عن عبد الله في الصلاة علي الجناءز لا وقت ولا عدد رجل عن شعبة عن رجل قال سمعت زر بن حبيش يقول صلي عبد الله علي رجل ميت فكبر عليه خمسا ونحن نروي عن النبي صلي الله عليه وسلم انه كبر اربعا مالك عن بن شهاب عن سعيد عن ابي هريرة عن النبي صلي الله عليه وسلم انه كبر علي النجاشي اربعا ولم يرو عن النبي صلي الله عليه وسلم قط انه كبر علي ميت الا اربعا وهم يقولون قولنا ونقول التكبير علي الجناءز اربعا اربعا لا يزاد فيها ولا ينقص فخالفوا بن مسعود وقالوا في هذا بروايتنا اخبرنا هشيم عن يزيد بن ابي زياد عن ابي جحيفة عن عبد الله انه كان اذا رفع راسه من الركوع قال اللهم ربنا لك الحمد ملء السماوات وملء الارض وملء ما شءت من شء بعد ونحن نستحب هذا ونقول به لانه موافق ما روي عن النبي صلي الله عليه وسلم وهم يكرهون هذا كراهة شديدة اخبرنا اسحاق بن يوسف الازرق عن سفيان عن ابي اسحاق عن علقمة عن عبد الله قال صلي العصر قدر ما يسير الراكب فرسخين وهم يقولون تءخر العصر قدر ما يسير الراكب فرسخا فيخالفون ما رووا ما لم يدخل الشمس صفرة واما نحن فنقول يصلي العصر في اول وقتها لانا روينا ان النبي صلي الله عليه وسلم كان يصلي العصر ثم يذهب الذاهب الي قباء فياتيهم والشمس بيضاء نقية هشيم عن منصور عن الحسن عن رجل من هذيل ان بن مسعود كان يقرا بفاتحة الكتاب في الجناءز وهم يخالفون هذا ولا يقرءون ( ( ( يقرءون ) ) ) علي الجناءز واما نحن فنقول بهذا نقول يقرا الامام بفاتحة الكتاب اخبرنا بذلك ابراهيم بن سعد عن ابيه عن طلحة بن عبد الله بن عوف قال صليت خلف بن عباس علي جنازة فقرا بفاتحة الكتاب وسورة وجهر حتي اسمعنا فلما فرغ اخذت بيده فسالته عن ذلك فقال سنة وحق اخبرنا بن علية عن بن عجلان عن سعيد بن ابي سعيد قال سمعت بن عباس يجهر بفاتحة الكتاب علي الجناءز ويقول انما فعلت لتعلموا انها سنة اخبرنا اسحاق بن يوسف عن سفيان الثوري عن ابي اسحاق عن ابي الاحوص عن عبد الله قال التكبير تحريم الصلاة وانقضاءها التسليم وليسوا يقولون بهذا يزعمون ان من جلس مقدار التشهد فقد تمت صلاته ولا شء عليه واما نحن فنقول تحريم الصلاة التكبير وانقضاءها التسليم لانه يوافق ما روينا عن النبي صلي الله عليه وسلم اخبرنا سعيد بن سالم عن سفيان الثوري عن عبد الله بن محمد بن عقيل عن محمد بن الحنفية عن علي عن النبي صلي الله عليه وسلم قال مفتاح الصلاة الوضوء وتحريمها التكبير وتحليلها التسليم وهكذا نقول لا يخرج من الصلاة حتي يسلم لان النبي صلي الله عليه وسلم جعل حد الخروج من التسليم فكل حدث كان يفسد الصلاة فيما بين التكبير الي التسليم فهو يفسدها لان من الدخول فيها الي الخروج منها صلاة فلا يجوز ان يكون في صلاة فيعمل ما يفسدها ولا تفسد هشيم عن حصين قال اخبرني الهيثم انه سمع بن مسعود يقول لان اجلس علي الرضف احب الي من ان اتربع في الصلاة وهم يقولون قيام صلاة الجالس التربع ونحن نكره ما يكره بن مسعود من تربع الرجل في الصلاة وهم يخالفون بن مسعود ويستحبون التربع في الصلاة اخبرنا ابو معاوية عن الاعمش عن ابراهيم عن عبد الرحمن بن يزيد قال صلي عثمان بمني اربعا فقال عبد الله صليت مع النبي صلي الله عليه وسلم ركعتين ومع ابي بكر ركعتين ومع عمر ركعتين ثم تفرقت بكم الطرق قال الاعمش فحدثني معاوية بن قرة ان عبد الله صلاها بعد اربعا فقيل له عبت علي عثمان وتصلي اربعا قال الخلاف شر وهم يقولون لا يصلح للمسافر ان يصلي اربعا فان صلي اربعا فلم يجلس في  الثانية مقدار التشهد فسدت صلاته فيروون عن عبد الله انه فعل ما ان فعله احد فسدت صلاته اخبرنا حفص عن الاعمش عن ابراهيم عن عبد الرحمن بن يزيد قال كان عبد الله يكره ان يقرا القران في اقل من ثلاث وهم يستحبون ان يقرا في اقل من ثلاث اخبرنا وكيع عن سفيان الثوري عن ابي اسحاق عن عبد الرحمن بن يزيد قال رايت عبد الله يحك المعوذتين من المصحف ويقول لا تخلطوا به ما ليس منه وهم يروون عن النبي صلي الله عليه وسلم انه قرا بهما في صلاة الصبح وهما مكتوبتان في المصحف الذي جمع علي عهد ابي بكر ثم كان عند عمر ثم عند حفصة ثم جمع عثمان عليه الناس وهما من كتاب الله عز وجل وانا احب ان اقرا بهما في صلاتي اخبرنا بن مهدي وغيره عن سفيان الثوري عن ابي اسحاق عن هبيرة بن (  ) يريم قال كان عبد الله يعطينا العطاء في زبل صغار ثم ياخذ منها زكاة وهم يقولون لا زكاة في مال حتي يحول عليه الحول ولا ناخذ من العطاء ونحن نروي عن ابي بكر انه كان لا ياخذ من العطاء زكاة وعن عمر وعثمان ونحن نقول بذلك اخبرنا بن علية وبن ابي زاءدة عن ليث عن مجاهد عن بن مسعود انه كان يقول لولي اليتيم احص ما مر من السنين فاذا دفعت اليه ماله قلت له قد اتي عليه كذا وكذا فان شاء زكي وان شاء ترك ولو كان بن مسعود لا يري عليه زكاة لم يامره بالاحصاء لان من لم تجب عليه زكاة لا يءمر باحصاء السنين كما لا يءمر الصبي باحصاء سنيه في صغره للصلاة ولكن كان بن مسعود يري عليه الزكاة وكان لا يري ان يزكيها الولي وكان يقول يحسب الولي السنين التي وجبت علي الصبي فيها الزكاة فاذا بلغ الصبي ودفع اليه ماله اعلمه ذلك وهم يقولون ليس في مال الصبي زكاة ونحن نقول يزكي لانا روينا ذلك عن عمر وعلي وعاءشة وبن عمر وروينا ذلك عن النبي صلي الله عليه وسلم اخبرنا بذلك عبد المجيد عن بن جريج عن يوسف بن ماهك ان النبي صلي الله عليه وسلم قال ابتغوا في اموال اليتامي لءلا تذهبها او تستهلكها الصدقة
   * باب الصيام
  * اخبرنا بن مهدي عن سفيان الثوري عن ابي اسحاق عن عبيد بن عمير ان عليا سءل عن القبلة للصاءم فقال ما يريد الي خلوف فمها وليسوا يقولون بهذا يقولون لا باس بقبلة الصاءم اخبرنا اسماعيل بن ابي خالد عن ابي السفر عن علي رضي الله عنه انه صلي الصبح ثم قال هذا حين يتبين لكم الخيط الابيض من الخيط الاسود وليسوا ولا احد علمناه يقول بهذا انما السحور قبل طلوع الفجر فاذا طلع الفجر فقد حرم الطعام والشراب علي الصاءم اخبرنا رجل عن الشيباني عن ابي ماوية ان عليا رضي الله عنه خرج يستسقي يوم عاشوراء فقال من كان منكم اصبح صاءما فليتم صيامه ومن كان مفطرا فلا ياكل وليسوا يقولون بهذا يقولون من اصبح مفطرا فلا يصوم اخبرنا رجل عن شعبة عن ابي اسحاق عن عبد الله بن مرة عن الحرث عن علي رضي الله عنه انه كره صوم يوم الجمعة وهم يستحبون صوم يوم الجمعة فيخالفون عليا رضي الله تعالي عنه اخبرنا رجل عن شعبة عن منصور عن هلال بن يساف عن عبد الله انه كره القبلة للصاءم وليسوا ياخذون بهذا واما نحن فنروي عن النبي صلي الله عليه وسلم انه قبل وهو صاءم وعن غير واحد من اصحابه ونقول لا باس ان يقبل الصاءم اخبرنا بن مهدي واسحاق الازرق عن سفيان الثوري عن سلمة بن كهيل عن المستورد بن الاحنف قال جاء رجل فصلي معه الظهر فقال اني ظللت اليوم لا صاءم ولا مفطر كنت اتقاضي غريما لي فماذا تري قال ان شءت صمت وان شءت افطرت اخبرنا رجل بشر بن السري وغيره عن سفيان الثوري عن الاعمش عن طلحة عن سعد بن عبيدة عن ابي عبد الرحمن ان حذيفة بدا له  بعد ما زالت الشمس فصام وهم لا يرون هذا ويزعمون انه لا يكون صاءما حتي ينوي الصوم قبل الزوال اخبرنا ابو معاوية عن الاعمش عن عمارة عن عبد الرحمن بن يزيد عن عبد الله قال احدكم بالخيار ما لم ياكل او يشرب واما نحن فنقول المتطوع بالصوم متي شاء نوي الصيام فاما من عليه صوم واجب فعليه ان ينويه قبل الفجر والله اعلم
   * باب الحج
  * ( قال الشافعي ) رحمه الله اخبرنا ابو معاوية عن الاعمش عن قيس بن مسلم عن طارق بن شهاب عن عبد الله قال الحج اشهر معلومات ليس فيها عمرة وليسوا ياخذون بذلك ويزعمون ان رسول الله صلي الله عليه وسلم قرن الحج والعمرة في اشهر الحج واما نحن فروينا ان اصحاب النبي صلي الله عليه وسلم الذين خرجوا معه في حجته منهم من قرن الحج مع العمرة ومنهم من تمتع بالعمرة الي الحج ومنهم من افرد الحج اخبرنا بذلك مالك عن بن شهاب عن عروة عن عاءشة رضي الله تعالي عنها قالت وافرد رسول الله صلي الله عليه وسلم الحج فبهذا قلنا لا باس بالعمرة في اشهر الحج وقد كان بن مسعود فيمن شهد تلك الحجة فيما علمنا اخبرنا بن مهدي عن سفيان عن ابراهيم بن عبد الاعلي عن سويد بن غفلة قال قال لي عمر يا ابا امية حج واشترط فان لك ما شرطت ولله عليك ما اشترطت وهم يخالفون هذا ولا يرون الشرط شيءا واما نحن فنقول يشترط وله الشرط لانه موافق ما روي عن النبي صلي الله عليه وسلم انه امر ضباعة بنت الزبير بالشرط وما روي عن عاءشة اخبرنا سفيان عن هشام بن عروة عن ابيه ان النبي صلي الله عليه وسلم امر ضباعة بنت الزبير فقال اما تريدين الحج فقالت اني شاكية فقال حجي واشترطي ان محلي حيث حبستني اخبرنا سفيان عن هشام بن عروة عن ابيه قال قالت لي عاءشة يا بن اختي هل تستثني اذا حججت قلت ماذا اقول قالت قل اللهم الحج اردت وله عمدت فان يسرته فهو الحج وان حبسني حابس فهي عمرة اخبرنا بن عيينة عن منصور عن ابي واءل عن مسروق عن عبد الله انه لبي علي الصفا في عمرة بعد ما طاف بالبيت وليسوا ولا احد من الناس علمناه يقول بهذا وانما اختلف الناس عندنا فمنهم من قال يقطع التلبية في العمرة اذا دخل الحرم وهو قول بن عمر ومنهم من قال اذا استلم الركن وهو قول بن عباس وبهذا نقول اخبرنا رجل عن بن جريج عن عطاء عن بن عباس وبه يقولون هم ايضا فاما بعد الطواف بالبيت فلا يلبي احد اخبرنا بن مهدي عن شعبة عن ابي اسحاق عن عبد الرحمن بن يزيد عن عبد الله قال كانت تلبية رسول الله صلي الله عليه وسلم لبيك اللهم لبيك لبيك لا شريك لك لبيك ان الحمد والنعمة لك وليسوا ولا احد علمناه يقول هذا فخالفوه لان تلبية رسول الله صلي الله عليه وسلم ثم المسلمين الي اليوم زيادة علي هذه التلبية والملك لا شريك لك اخبرنا بن مهدي عن سفيان الثوري عن ابي اسحاق عن عبد الرحمن بن يزيد ان عبد الله تنفل بين المغرب والعشاء بجمع وليسوا يقولون بهذا بل ثبت عن النبي صلي الله عليه وسلم انه صلاهما ولم يصل بينهما شيءا اخبرنا الوليد بن مسلم عن بن ابي ذءب عن الزهري عن سالم عن ابيه ان رسول الله صلي الله عليه وسلم جمع بين المغرب والعشاء ولم يتطوع بينهما ولا علي اثر واحدة منهما وبهذا نقول اخبرنا بن علية عن ابي حمزة ميمون عن ابراهيم عن الاسود عن عبد الله قال نسكان احب الي ان يكون لكل منهما شعث وسفر وهم يزعمون ان القران افضل وبه يفتون من استفتاهم وعبد الله كان يكره القران اخبرنا سفيان عن عبد الكريم الجزري عن ابي عبيدة عن عبد الله انه حكم في اليربوع جفرا او جفرة وهم يخالفونه ويقولون نحكم فيه بقيمته في الموضع الذي يصاب فيه ولو يبلغ ان يكون غير جفرة لم يهد الا الثني فصاعدا ما يكون اضحية فيخالفونه من وجهين  ولا يقولون علمته في قولهم هذا بقول احد من السلف واما نحن فنقول به لانه مثل ما روينا عن عمر وهو قول عوام فقهاءنا والله اعلم
   * كتاب اختلاف مالك والشافعي رضي الله عنهما
  * اخبرنا ابو محمد الربيع بن سليمان المرادي المءذن صاحب الشافعي رحمه الله تعالي قال سالت الشافعي باي شء تثبت الخبر عن رسول الله صلي الله عليه وسلم فقال قد كتبت هذه الحجة في كتاب جماع العلم فقلت اعد من هذا مذهبك ولا تبال ان يكون فيه في هذا الموضع فقال الشافعي اذا حدث الثقة عن الثقة حتي ينتهي الي رسول الله صلي الله عليه وسلم فهو ثابت عن رسول الله صلي الله عليه وسلم ولا نترك لرسول الله حديثا ابدا الا حديثا وجد عن رسول الله حديث يخالفه واذا اختلفت الاحاديث عنه فالاختلاف فيها وجهان احدهما ان يكون بها ناسخ ومنسوخ فنعمل بالناسخ ونترك المنسوخ والاخر ان تختلف ولا دلالة علي ايها الناسخ فنذهب الي اثبت الروايتين فان تكافاتا ذهبت الي اشبه الحديثين بكتاب الله وسنة نبيه فيما سوي ما اختلف فيه الحديثان من سنته ولا يعدو حديثان اختلفا عن النبي صلي الله عليه وسلم ان يوجد فيهما هذا او غيره مما يدل علي الاثبت من الرواية عن رسول الله صلي الله عليه وسلم فاذا كان الحديث عن رسول الله صلي الله عليه وسلم لا مخالف له عنه وكان يروي عمن دون رسول الله صلي الله عليه وسلم حديث يوافقه لم يزده قوة وحديث النبي صلي الله عليه وسلم مستغن بنفسه وان كان يروي عمن دون رسول الله حديث يخالفه لم التفت الي ما خالفه وحديث رسول الله اولي ان يءخذ به ولو علم من روي عنه خلاف سنة رسول الله صلي الله عليه وسلم سنته اتبعها ان شاء الله فقلت للشافعي افيذهب صاحبنا هذا المذهب قال نعم في بعض العلم وتركه في بعض قلت فاذكر ما ذهب اليه صاحبنا من حديث النبي صلي الله عليه وسلم مما لم يرو عن الاءمة ابي بكر ولا عمر ولا عثمان ولا علي شيءا يوافقه فقال نعم ساذكر من ذلك ان شاء الله ما يدل علي ما وصفت واذكر ايضا ما ذهب اليه من حديث رسول الله وفيه عن بعض الاءمة ما يخالفه ليكون اثبت للحجة عليكم في اختلاف اقاويلكم فتستغنون مرة بالحديث عن النبي دون غيره وتدعون له ما خالفه ثم تدعون الحديث مرة اخري بغير حديث يخالفه ( قال الشافعي ) رحمه الله تعالي ومن ذلك انه اخبرنا مالك عن زيد بن اسلم عن عطاء بن يسار عن عبد الله بن عباس قال واخبرنا مالك عن يحيي بن سعيد عن عمرة عن عاءشة كلاهما قالا ان الشمس خسفت فصلي النبي صلي الله عليه وسلم ركعتين ووصفاهما في كل ركعة ركعتين ( قال الشافعي ) رحمه الله تعالي فاخذنا نحن وانتم به وخالفنا غيركم من الناس فقال تصلي ركعتين كصلاة الناس وروي حديثا عن النبي صلي الله عليه وسلم مثل قوله وخالفنا غيرهم من الناس فقال تصلي ركعتين في كل ركعة ثلاث ركعات واحتج علينا بان بن عباس صلي في زلزلة ركعتين في كل ركعة ثلاث ركعات واحتج علينا غيره بان علي بن ابي طالب صلي ركعتين في كل ركعة اربع ركعات او خمس وكانت حجتنا عليهم ان الحديث اذا ثبت عن رسول الله صلي الله عليه وسلم لم يكن في احد بعده حجة لو جاء عنه شء يخالفه ( قال الشافعي ) رحمه الله واخبرنا مالك عن زيد بن اسلم عن عطاء بن يسار وعن بسر ( ( ( يسر ) ) ) بن سعيد وعن الاعرج يحدثونه عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال من ادرك ركعة من الصبح قبل ان تطلع الشمس فقد ادرك الصبح ومن ادرك ركعة من العصر قبل ان تغرب الشمس فقد ادرك العصر فقلنا نحن وانتم بهذا وخالفنا بعض الناس فيه فقال هو مدرك العصر وصلاته الصبح فاءتة من قبل انه خرج الي وقت نهي فيه رسول الله صلي الله عليه وسلم عن الصلاة ( قال الشافعي ) رحمه الله تعالي فكانت حجتنا عليه ان النبي صلي الله عليه وسلم انما نهي عما لا يلزم من الصلوات وهذه صلاة لازمة قد بينها  واخبر انه مدرك في الحالين معا افرايتم لو احتج عليكم رجل فقال كيف ثبتم حديث ابي هريرة وحده عن النبي صلي الله عليه وسلم ولم يروه احد علمته عن النبي صلي الله عليه وسلم غير ابي هريرة ولم تردوه بان هذا لم يرو عن ابي بكر ولا عمر ولا عثمان ولا علي ولا احد من اصحاب رسول الله صلي الله عليه وسلم قلت ما كانت حجتنا عليه الا انه اذا ثبت الحديث عن رسول الله صلي الله عليه وسلم استغني به عمن سواه ( قال الشافعي ) اخبرنا مالك عن ابي الزناد عن الاعرج عن ابي هريرة عن رسول الله صلي الله عليه وسلم قال اذا اشتد الحر فابردوا عن الصلاة فان شدة الحر من فيح جهنم فاخذنا نحن وانتم به افرايتم ان قال لنا قاءل ان الحر والبرد لم يحدثا بعد ولم يذهبا بعد فلما لم يات عن ابي بكر ولا عمر ولا عثمان ولا علي انهم امروا بالابراد ولم ترووه عن واحد منهم وكان النبي صلي الله عليه وسلم يحض علي اول الوقت وذلك في الحر والبرد سواء هل الحجة الا ثبوت هذا عن النبي صلي الله عليه وسلم وان حضه علي اول الوقت لا يدفع امره بتاخير الظهر في شدة الحرة ولو لم يرو عن احد من اصحاب النبي صلي الله عليه وسلم استغني فيه بالخبر عن رسول الله صلي الله عليه وسلم ( قال الشافعي ) اخبرنا مالك عن اسحاق بن عبد الله بن ابي طلحة عن حميدة ابنة ( ( ( بنت ) ) ) عبيد بن رفاعة عن كبشة بنت كعب بن مالك عن ابي قتادة ان رسول الله صلي الله عليه وسلم قال في الهرة انها ليست بنجس قال فاخذنا نحن وانتم به فقلنا لا باس بالوضوء بفضل الهرة وخالفنا بعض الناس فكره الوضوء بفضلها واحتج بان بن عمر كره الوضوء بفضلها افرايتم ان قال لكم قاءل حديث حميدة عن كبشة لا يثبت مثله والهرة لم تزل عند الناس بعد النبي صلي الله عليه وسلم فنحن نوهنه بان لم يرو عن ابي بكر ولا عمر ولا عثمان ولا علي ما يوافق ما روي عن النبي صلي الله عليه وسلم واحتج ايضا بان النبي صلي الله عليه وسلم قال اذا شرب الكلب من اناء احدكم فليغسله سبع مرات والكلب لا يءكل لحمه ولا الهرة فلا اتوضا بفضلها فهل الحجة عليه الا ان المراتين ان كانتا معروفتين ثبت حديثهما وان الهر غير الكلب الكلب نجس مامور بغسل الاناء منه سبعا ولا نتوضا بفضله وفي الهرة حديث انها ليست بنجس فنتوضا بفضلها ونكتفي بالخبر عن النبي صلي الله عليه وسلم من ان يكون احد بعده قال به ولا يكون في احد قال بخلاف ما روي عن النبي صلي الله عليه وسلم حجة ولا في ان لم يرو الا من وجه واحد اذا كان الوجه معروفا ( قال الشافعي ) اخبرنا مالك عن عبد الله بن ابي بكر عن عروة عن مروان عن بسرة بنت صفوان انها سمعت النبي صلي الله عليه وسلم يقول اذا مس احدكم ذكره فليتوضا فقلنا نحن وانتم به وخالفنا بعض الناس فقال لا يتوضا من مس الذكر واحتج بحديث رواه عن النبي صلي الله عليه وسلم يوافق قوله فكانت حجتنا عليه ان حديثه مجهول لا يثبت مثله وحديثنا معروف واحتج علينا بان حذيفة وعلي بن ابي طالب وبن مسعود وبن عباس وعمران بن الحصين وعمار بن ياسر وسعد بن ابي وقاص قالوا ليس في مس الذكر وضوء وقالوا رويتم عن سعد قولكم وروينا عنه خلافه ورويتموه عن بن عمر ومن رويناه عنه اكثر لا توضءون لو مسستم انجس منه فكانت حجتنا ان ما ثبت عن النبي صلي الله عليه وسلم لم يكن في قول احد خالفه حجة علي قوله فقال منهم قاءل افلا نتهم الرواية عن رسول الله اذا جاء عن مثل من وصفت وكان من مس ما هو انجس منه لا يجب عليه عندكم وضوء فقلت لا يجوز لعالم في دينه ان يحتج بما يري الحجة في غيره قال ولم لا تكون الحجة فيه والغلط يمكن فيمن يروي فقلت له ارايت ان قال لك قاءل اتهم جميع ما رويت عمن رويته عنه فاخاف غلط كل محدث منهم عمن حدث عنه اذا روي عن النبي صلي الله عليه وسلم خلافه قال لا يجوز ان يتهم حديث اهل الثقة قلت فهل رواه عن احد منهم الا واحد عن واحد قال نعم قلت ورواه عن النبي صلي الله عليه وسلم واحد عن  واحد قال نعم قلت فاننا علمنا ان النبي صلي الله عليه وسلم قاله بصدق المحدث عندي وعلمنا ان من سمينا قاله بحديث الواحد عن الواحد قال نعم قلت وعلمنا بان النبي صلي الله عليه وسلم قاله علمنا بان من سمينا قاله قال نعم قلت فاذا استوي العلمان من خبر الصادقين ايهما كان اولي بنا ان نصير اليه الخبر عن رسول الله صلي الله عليه وسلم اولي بان ناخذ به او الخبر عمن دونه قال بل الخبر عن رسول الله صلي الله عليه وسلم ان ثبت قلت ثبوتهما واحد قال فالخبر عن رسول الله صلي الله عليه وسلم اولي ان يصار اليه وان ادخلتم علي المخبرين عنه انهم يمكن فيهم الغلط دخل عليكم في كل حديث روي مخالف الحديث الذي جاء عن رسول الله صلي الله عليه وسلم فان قلتم ثبت خبر الصادقين فما ثبت عن النبي صلي الله عليه وسلم اولي عندنا ان يءخذ به ( قال الشافعي ) اخبرنا مالك عن ابي الزبير المكي عن ابي الطفيل عامر بن واثلة عن معاذ بن جبل ان النبي صلي الله عليه وسلم كان يجمع بين الظهر والعصر والمغرب والعشاء في سفره الي تبوك فاخذنا نحن وانتم به وخالفنا فيه غيرنا فروي عن بن مسعود ان النبي صلي الله عليه وسلم لم يجمع الا بالمزدلفة وروي عن عمر انه كتب ان الجمع بين الصلاتين الا من عذر من الكباءر فكانت حجتنا عليه ان بن مسعود وان قال لم يفعل فقال غيره فعل فقول من قال فعل اولي ان يءخذ به لانه شاهد والذي قال لم يفعل غير شاهد وليس في قول احد خالف ما روي عن النبي صلي الله عليه وسلم حجة لما وصفت من انا اذا علمنا ان النبي صلي الله عليه وسلم قال شيءا وغيره قال غيره فلا يشك مسلم في ان ما جاء عن النبي صلي الله عليه وسلم كان اولي ان يءخذ به وان ادخلت ان الرجال المحدثين يمكن فيهم الغلط في حديث النبي صلي الله عليه وسلم ادخلنا ذلك في حديث من روي عنه ما يخالف ما جاء عن النبي صلي الله عليه وسلم وكان ذلك في حديث من روي عن بعض اصحاب النبي صلي الله عليه وسلم امكن لانه لا يروي عن النبي عليه السلام شيءا سماعا الا اصحابه واصحابه خير ممن بعدهم وعامة من يروي عمن دونه التابعون فكيف يتهم حديث الافضل ولا يتهم حديث الذي هو دونه ولسنا نتهم منهم واحدا ولكنا نقبلهما معا والحجة فيما قاله رسول الله صلي الله عليه وسلم دون ما قال غيره ولا يوهن الجمع في السفر بان يقول رجل سافر ابو بكر غازيا وحاجا وعمر حاجا وغازيا وعثمان غازيا وحاجا ولم يثبت ان احدا منهم جمع في سفر بل يكتفي بما جاء عن النبي صلي الله عليه وسلم فلا يوهنه ان لم يحفظ انه عمل به بعده ولا يزيده قوة ان يكون عمل به بعده ولو خولف بعد ما اوهنه وكانت الحجة فيما روي عنه دون ما خالفه ( قال الشافعي ) اخبرنا مالك عن داود بن الحصين عن ابي سفيان مولي بن ابي احمد عن ابي هريرة قال صلي لنا رسول الله صلي الله عليه وسلم صلاة العصر فسلم من ركعتين فقام ذو اليدين فقال قصرت الصلاة ام نسيت يا رسول الله فقال النبي صلي الله عليه وسلم كل ذلك لم يكن ثم اقبل علي الناس فقال اصدق ذو اليدين فقالوا نعم فاتم رسول الله صلي الله عليه وسلم ما بقي من الصلاة ثم سجد سجدتين وهو جالس فقلنا نحن وانتم بهذا وخالفنا غيرنا فقال الكلام في الصلاة عامدا يقطعها وكذلك يقطعها الكلام وان ظن المصلي انه قد اكمل ثم تكلم وروي عن بن مسعود ان رسول الله صلي الله عليه وسلم قال ان الله يحدث من امره ما شاء وان مما احدث الله ان لا تكلموا في الصلاة فقلنا هذا لا يخالف حديثنا نهي عن الكلام عامدا فاما الكلام ساهيا فلم ينه عنه والدليل علي ذلك ان حديث بن مسعود بمكة قبل الهجرة وحديث ابي هريرة بالمدينة بعد حديث بن مسعود بزمان فلم نوهن نحن وانتم هذا الحديث بان لم يرو عن ابي بكر ولا عمر ولا عثمان ولا علي انهم فعلوا مثل هذا ولا قالوا من فعل مثل هذا جاز له واكتفينا بالخبر لما ثبت عن  رسول الله صلي الله عليه وسلم ولم نحتج فيه الي ان يعمل به بعده غيره ( قال الشافعي ) اخبرنا مالك عن بن شهاب عن عبد الرحمن الاعرج عن عبد الله بن بحينة قال صلي لنا رسول الله صلي الله عليه وسلم ركعتين ثم قام فلم يجلس وقام الناس معه فلما قضي صلاته ونظرنا تسليمه كبر فسجد سجدتين وهو جالس قبل التسليم فاخذنا نحن وانتم بهذا وقلنا وقلتم يسجد للسهو في النقص من الصلاة قبل التسليم فخالفنا بعض الناس وقال تسجدان بعد التسليم واحتج بروايتنا فقال من احتج عن مالك سجدهما النبي صلي الله عليه وسلم في الزيادة بعد السلام فسجدتهما كذلك وسجدهما في النقص قبل السلام فسجدتهما كذلك ولم نوهن هذا بان لم يرو عن احد من الاءمة فيه شء يخالفه ولا يوافقه واكتفينا بحديث النبي صلي الله عليه وسلم ( قال الشافعي ) اخبرنا مالك عن يزيد بن رومان عن صالح بن خوات عمن صلي مع النبي صلي الله عليه وسلم يوم ذات الرقاع صلاة الخوف ان طاءفة صفت معه وطاءفة وجاه العدو فصلي بالذين معه ركعة ثم ثبت قاءما فاتموا لانفسهم ثم انصرفوا فصفوا وجاه العدو وجاءت الطاءفة الاخري فصلي بهم الركعة التي بقيت من صلاته ثم ثبت جالسا واتموا لانفسهم ثم سلم بهم ( قال الشافعي ) اخبرنا بعض اصحابنا عن عبد الله (  ) بن عمر عن اخيه عبيد الله بن عمر عن القاسم عن صالح بن خوات عن خوات بن جبير عن النبي صلي الله عليه وسلم مثل معناه فاخذنا نحن وهو بهذا حتي حكي لنا عنه غير ما عرضنا عليه وخالفنا بعض الناس فقال فيه بخلاف قولنا فقال لا تصلي صلاة الخوف اليوم فكانت حجتنا عليه ما ثبت عن رسول الله صلي الله عليه وسلم وكان من حجته ان قال قد اختلفت الاحاديث في صلاة الخوف عن النبي صلي الله عليه وسلم ولم نعلم ان ابا بكر ولا عمر ولا عثمان ولا ثبت عن علي ان واحدا منهم صلي صلاة الخوف ولا امروا بها والصلاة خلف النبي صلي الله عليه وسلم في الفضل ليست كهي خلف غيره وبان لم يرو عن خلفاءه حديث يثبت بصلاتها ولم يزالوا محاربين ومحاربا في زمانهم فهذا يدل علي انه كان للنبي صلي الله عليه وسلم خاصة فكانت حجتنا عليه انه اذا ثبت عن رسول الله صلي الله عليه وسلم فهو عام الا بدلالة لانه لا يكون شء من فعله خاصا حتي تاتينا الدلالة من كتاب او سنة او اجماع انه خاص والا اكتفينا بالحديث عن النبي صلي الله عليه وسلم عمن بعده كما قلنا فيما قبله
   * باب ما جاء في الصدقات
  * ( قال الشافعي ) اخبرنا مالك بن انس عن عمرو بن يحيي المازني عن ابيه عن ابي سعيد الخدري ان النبي صلي الله عليه وسلم قال ليس فيما دون خمسة اوسق صدقة وليس فيما دون خمس اواق صدقة فاخذنا نحن وانتم بهذا وخالفنا فيه بعض الناس فقال قال الله تبارك وتعالي لنبيه عليه السلام خذ من اموالهم صدقة وقال النبي صلي الله عليه وسلم فيما سقت السماء العشر لم يخصص الله عز وجل مالا دون مال ولم يخصص رسول الله صلي الله عليه وسلم في هذا الحديث مالا دون مال فهذا الحديث يوافق كتاب الله والقياس عليه وقال لا يكون مال فيه صدقة واخر لا صدقة فيه وكل ما اخرجت الارض من شء وان حزمه بقل ففيه العشر فكانت حجتنا عليه ان رسول الله صلي الله عليه وسلم المبين عن الله معني ما اراد اذ ابان ما يءخذ منه من الاموال دون ما لم يرد والحديث عن رسول الله صلي الله عليه وسلم فيما سقت السماء جملة والمفسر يدل علي الجملة ( قال الشافعي ) وقد سمعت من يحتج عنه فيقول كلاما يريد به قد قام بالامر بعد النبي صلي الله عليه وسلم ابو بكر وعمر وعثمان وعلي واخذوا الصدقات  في البلدان اخذا عاما وزمانا طويلا فما روي عنهم ولا عن واحد منهم انه قال ليس فيما دون خمسة اوسق صدقة قال وللنبي صلي الله عليه وسلم عهود ما هذا في واحد منها وما رواه عن النبي صلي الله عليه وسلم الا ابو سعيد الخدري ( قال الشافعي ) فكانت حجتنا عليه ان المحدث به لما كان ثقة اكتفي بخبره ولم نرده بتاويل ولا بانه لم يروه غيره ولا بانه لم يرو عن احد من الاءمة مثله اكتفاء بسنة رسول الله صلي الله عليه وسلم عما دونها وبانها اذا كانت منصوصة بينة لم يدخل عليها تاويل كتاب اذ النبي صلي الله عليه وسلم اعلم بمعني الكتاب ولا تاويل حديث جملة يحتمل ان يوافق قول النبي صلي الله عليه وسلم المنصوص ويخالفه وكان اذا احتمل المعنيين اولي ان يكون موافقا له ولا يكون مخالفا فيه ولم يوهنه ان لم يروه الا واحد عن النبي صلي الله عليه وسلم اذا كان ثقة ( قال الشافعي ) اخبرنا مالك عن نافع عن عبد الله بن عمر ان النبي صلي الله عليه وسلم قال من باع نخلا قد ابرت فثمرتها للباءع الا ان يشترط المبتاع فقلنا نحن وانتم بهذا وقلنا في هذا دليل علي انه من باع نخلا لم تءبر فالثمرة للمشتري فخالفنا بعض الناس في هذا فقال اذا قضي النبي صلي الله عليه وسلم بالثمرة اذا ابرت للباءع الا ان يشترط المبتاع علمناه اذا ابر فقد زايل ان يكون مغيبا في شجره لم يظهر كما يكون الحمل مغيبا لم يظهر وكذلك اذا زايلها وان لم يءبر فهو للباءع وقال هكذا تقولون في الامة تباع حاملا حملها للمشتري فاذا فارقها فولدها للباءع والثمر اذا خرج من النخلة فقد فارقها ( قال الشافعي ) رحمه الله تعالي فكانت حجتنا عليهم ان قلنا ان الثمرة كانت خارجة من النخل فحكم فيها رسول الله صلي الله عليه وسلم حكما بعد الابار دل علي فرقة بين حكم حال الثمرة قبل الابار وبعده اتبعنا امر رسول الله صلي الله عليه وسلم كما امر به ولم نجعل احدهما قياسا علي الاخر ونسوي بينهما ان ظهرا فيها ولم نقسهما علي ولد الامة ولا نقيس سنة علي سنة ولكن نمضي كل سنة علي وجهها ما وجدنا السبيل الي امضاءها ولم نوهن هذا الحديث بقياس ولا شء مما وصفت ولا بان اجتمع هذا فيه وان لم يرو فيه عن ابي بكر ولا عمر ولا عثمان ولا علي قول ولا حكم ولا امر يوافقه واستغنينا بالخبر عن النبي صلي الله عليه وسلم فيه عما سواه
   * باب في بيع الثمار
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع عن بن عمر ان رسول الله صلي الله عليه وسلم نهي عن بيع الثمار حتي يبدو صلاحها نهي الباءع والمشتري ( قال الشافعي ) اخبرنا مالك عن حميد الطويل عن انس بن مالك ان رسول الله صلي الله عليه وسلم نهي عن بيع الثمار حتي تزهي فقيل يا رسول الله وما تزهي قال حتي تحمر وقال ارايت اذا منع الله الثمرة فبم ياخذ احدكم مال اخيه قال فاخذنا بهذا الحديث نحن وانتم وقلنا قول النبي صلي الله عليه وسلم يدل علي معنيين احدهما ان بدو صلاحها الحمرة ومثلها الصفرة وان قوله اذا منع الله الثمرة فبم ياخذ احدكم مال اخيه انه انما يمنع من الثمرة ما يترك الي مدة يكون في مثلها التلف فقلنا كل من ابتاع ثمرة قد بدا صلاحها فله تركها حتي تجد وخالفنا بعض الناس في هذا فقال من اشتري ثمرة قد بدا صلاحها لم يكن له تركها وذلك ان ملك النخل والماء الذي به صلاح النخل للباءع يستبقي نخله وماءه ولا يجوز ان يشترطه لانه لا يعرف حصة الثمرة من الثمن من حصة الاجارة فكانت حجتنا عليه ان قول النبي صلي الله عليه وسلم اذا منع الله الثمرة فبم ياخذ احدكم مال اخيه يدل علي انه انما يمنع ما يترك لا ما يكون علي مشتريه ان يقطفه مكانه وراينا ان من خالفنا فيه قد ترك السنة وترك ما تدل عليه السنة لو احتج علينا بانه لم يرو عن ابي بكر ولا عمر ولا عثمان ولا علي قول ولا قضاء يوافق هذا استغنينا بالخبر عن رسول الله صلي الله عليه وسلم عما سواه ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن عبد الله بن يزيد  مولي الاسود بن سفيان ان زيدا ابا عياش اخبره عن سعد بن ابي وقاص اخبره عن النبي صلي الله عليه وسلم انه نهي عن بيع الرطب بالتمر ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع عن بن عمر ان رسول الله صلي الله عليه وسلم نهي عن المزابنة والمزابنة بيع الثمر بالتمر كيلا وبيع الكرم بالزبيب كيلا ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع عن بن عمر عن زيد بن ثابت ان رسول الله صلي الله عليه وسلم ارخص لصاحب العرية ان يبيعها بخرصها قال فاخذنا نحن وانتم بالاحاديث كلها حين وجدنا لها كلها مخرجا فقلنا المزابنة بيع الجزاف كله بشء من صنفه كيلا والرطب بالتمر اذا كان الرطب ينقص شء واحد متفاضل او مجهول فقد حرم ان يباع الا مستويا وذلك اذا كان موضوعا بالارض واحللنا بيع العرايا بخرصها تمرا وهي داخلة في معني المزابنة والرطب بالتمر اذا كان لهما وجه معا وخالفنا في هذا بعض الناس فلم يجز بيع العرايا وردها بالحديثين وقال روي عن النبي صلي الله عليه وسلم حديثان مختلفان فاخذنا باحدهما وكان الذي اخذنا به اشبه بسنته في النهي عن التمر بالتمر الا كيلا بكيل فراينا لنا الحجة ثابتة بما قلنا علي من خالفنا اذا وجدنا للحديثين وجها نمضيهما فيه معا ( قال الشافعي ) رحمه الله تعالي فاذا كانت لنا حجة كانت عليكم في الحديثين يكونان هكذا فتنسبهما الي الاختلاف وقد يوجد لهما وجه يمضيان فيه معا فلم ندعه بما وصفنا من حجة غيرنا بحديثنا ولا بان لم يرو عن ابي بكر ولا عمر ولا عثمان ولا علي واستغنينا بالخبر عن النبي صلي الله عليه وسلم ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن زيد بن اسلم عن عطاء بن يسار عن ابي رافع مولي النبي صلي الله عليه وسلم قال استسلف رسول الله صلي الله عليه وسلم من رجل بكرا فجاءته ابل فقال ابو رافع فامرني رسول الله صلي الله عليه وسلم ان اقضي الرجل بكره فقلت لم اجد في الابل الا جملا خيارا رباعيا فقال اعطه اياه فان خيار الناس احسنهم قضاء فاخذنا نحن وانتم بهذا وقلنا لا باس ان يستسلف الحيوان الا الولاءد وان يسلف في الحيوان كله قياسا علي هذا وخالفنا بعض الناس في هذا لا يستسلف الحيوان ولا يسلف فيه وروي عن بن مسعود انه كره السلف فيه وعن غيره من اصحاب النبي صلي الله عليه وسلم فلم نر في واحد دون النبي صلي الله عليه وسلم حجة مع قول رسول الله صلي الله عليه وسلم ( قال الربيع ) معني قول الشافعي في هذا الذي نهي عنه ها هنا قرض الامة خاصة (  ) لان له اخذها منه فاما العبد فيجوز وقال هذا قول الشافعي
   * باب في الاقضية
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن جعفر بن محمد عن ابيه ان رسول الله صلي الله عليه وسلم قضي باليمين مع الشاهد ( قال الشافعي ) رحمه الله تعالي فاخذنا نحن وانتم به وانما اخذنا نحن به من قبل انا رويناه من حديث المكيين متصلا صحيحا وخالفنا فيه بعض الناس فما احتج في شء منه قط علمته اكثر من حججه فيه وفي ثلاث مساءل معه فزعم ان القران يدل علي ان لا يجوز اقل من شاهدين او شاهد وامراتين وزعم ان النبي صلي الله عليه وسلم قال واليمين علي المدعي عليه وقاله عمر فكان هذا دلالة علي ان لا تجوز يمين الا علي المدعي عليه ولا يحلف مدع واحتج بابن شهاب وعطاء وعروة وهما رجلا مكة والمدينة في زمانهما انكراه غاية النكرة واحتج بان لم يحفظ عن ابي بكر ولا عمر ولا عثمان فيه شء يوافقه ولا عن علي من وجه يصح عنده ولا عن واحد من اصحاب رسول الله صلي الله عليه وسلم من وجه يصح ولا عن بن المسيب ولا القاسم ولا اكثر التابعين وبانا احلفنا  في المال ولم نحلف في غيره وان ربيعة بن ابي عبد الرحمن قال انما اخذنا باليمين مع الشاهد انا وجدناه في كتب سعد وقال تاخذون بيمين وشاهد بان وجدتموهما في كتاب وتردون الاحاديث القاءمة ( قال الشافعي ) رحمه الله تعالي فكانت حجتي عليه ان قلت الرواية عن رسول الله صلي الله عليه وسلم ثابتة وما ثبت عن رسول الله لم يوهنه ان لا يوجد عند غيره ولم يتاول معه قران ولم يدفعه ان انكره عروة وبن شهاب وعطاء لانه ليس في الانكار حجة انما الحجة في الخبر لا في الانكار وراينا هذا لنا حجة ثابتة فاذا كان مثل هذا يكون لنا حجة فعليك مثله واحري واولي ان لا يوجد عليه ما يوهنه منه ( قال الشافعي ) رحمه الله اخبرنا مالك عن هاشم بن هاشم بن عتبة بن ابي وقاص عن عبد الله بن نسطاس عن جابر بن عبد الله ان رسول الله صلي الله عليه وسلم قال من حلف علي منبري هذا بيمين اثمة تبوا مقعده من النار فاخذنا نحن وانتم بهذا الحديث وقلنا فيه دلالة علي ان امرءا لا يحلف علي منبر رسول الله صلي الله عليه وسلم الا مجبورا علي اليمين لا متطوعا بها وانما يجبر الناس علي الايمان الحكام وخالفنا بعض الناس في هذا واحتج فيه بان قال هاشم بن هاشم ليس بالمشهور بالحفظ وعبد الله بن نسطاس ليس بالمعروف ولو احتججنا عليكم بمثل هذا رددتموه وليس فيه ان النبي صلي الله عليه وسلم احلف علي المنبر وقد يتطوع الرجل فيحلف علي المنبر كما يتطوع فيحلف بطلاق وعتاق ولم يستحلف ولم ( ( ( لم ) ) ) تحفظوا عن النبي صلي الله عليه وسلم ولا غيره انه احلف احدا علي منبر في غرم ولا غيره واحتج بان النبي صلي الله عليه وسلم لاعن بين الزوجين فحكي اللعان ولم يحك انه كان علي منبر رسول الله صلي الله عليه وسلم وقال اورايت اهل البلدان ايجلبون الي المدينة او يحلفون ببلدانهم فكيف تكون الايمان علي الناس مختلفة فلم نر له في هذا حجة وقلنا قول النبي صلي الله عليه وسلم علي ظاهره انه لا يحلف احد علي منبر الا مجبورا كما وصفنا
   * كتاب العتق
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع عن بن عمر ان رسول الله صلي الله عليه وسلم قال من اعتق شركا له في عبد فكان له مال يبلغ ثمن العبد قوم عليه قيمة العدل فاعطي شركاءه حصصهم وعتق عليه العبد والا فقد عتق منه ما عتق فاخذنا نحن وانتم بهذا الحديث وابطلنا به الاستسعاء وشركنا الرق والحرية في العبد اذا كان المعتق للعبد مفلسا وخالفنا فيه بعض الناس ووهنه بان قال رواه سالم عن بن عمر فلم يقل فيه والا فقد عتق منه ما عتق ورواه ايوب عن نافع عن بن عمر وقال ايوب وربما قال نافع والا فقد عتق منه ما عتق وربما لم يقل واكثر ظني انه شء كان يقوله نافع برايه ووهنه بان قال حديث رواه بن عمر وحده وقد روي عن ابي هريرة عن النبي صلي الله عليه وسلم خلافه وعن غير ابي هريرة عن النبي صلي الله عليه وسلم فيه الاستسعاء ووهنه بان قال لم يرو عن ابي بكر ولا عمر ولا عثمان ولا علي ما يوافقه بل روينا عن عمر خلافه ( قال الشافعي ) رحمه الله تعالي فكانت حجتنا عليه ان سالما وان لم يروه فنافع ثقة وليس في قول ايوب ربما قاله وربما لم يقله اذا قاله عنه غيره حجة وما روي عن ابي هريرة عن النبي صلي الله عليه وسلم مختلف فيه فالحفاظ يروونه ( ( ( يرونه ) ) ) لا يخالف حديثنا وغيرهم يروونه ( ( ( يرونه ) ) ) يخالف حديثنا ولو خالفه كان حديثنا اثبت منه والحديث الذي ذكره يخالف حديثنا لا يثبت ولا يرويه الحفاظ يخالف حديثنا واذا كانت لنا الحجة بهذا علي من خالفنا فهكذا ينبغي لنا ان نلزم انفسنا في الحديث كله وان نستغني بخبر الصادقين عن رسول الله صلي الله عليه وسلم وان لم يات عن احد من خلفاءه ما يوافقه ( قال الشافعي ) رحمه الله تعالي وادخلوا علينا فيه ان عبدا يكون نصفه حرا ونصفه عبدا فلا يكون له بالحرية ان يرث ولا يورث وتكون حقوق الحرية كلها فيه معطلة الا انه يترك لنفسه يوما ثم يكسب في يومه فيمنع ان يهب ماله  فقلنا لا نترك الحديث عن رسول الله صلي الله عليه وسلم بان يدخله من القياس ما وصفت ولا اكثر ولا موضع للقياس مع السنة فقلت للشافعي قد فهمت ما كتبت مما اخذت واخذنا به من حديث رسول الله ووجدت فيها ما وصفت من انا ثبتنا احاديث كثيرة لم تات الا من وجه واحد وليس فيه عن احد من خلفاءه شء يوافقه ولا يخالفه ووجدنا فيه ما نثبته عن النبي صلي الله عليه وسلم وفيه عن بعض خلفاءه شء يخالفه فذهبنا الي الحديث عن النبي صلي الله عليه وسلم وتركنا ما خالفه (  ) في القسامة وقد روينا عن عمر في القسامة خلاف ما روينا عن النبي صلي الله عليه وسلم ثم صرنا الي حديث النبي صلي الله عليه وسلم وكذلك روينا عن عمر في الضرس وغيرها وذهبنا الي حديث النبي صلي الله عليه وسلم دون ما روينا عن عمر وعن بن عمر في اشياء وغيرهما من اصحاب النبي صلي الله عليه وسلم قلت للشافعي افتبين لي انا روينا عن النبي صلي الله عليه وسلم شيءا ثم تركناه لغيره فقال كثير فقلت للشافعي فما حجة فعل هذا فقال قد جهدت ان اجد لكم شيءا يكون عندي او عند احد من اهل العلم حجة يعذر بها فلم اجده وذلك ان الذين رويتم عنهم ما اخذتم من حديث رسول الله صلي الله عليه وسلم وثقتموهم والذين رويتم عنهم ما تركتم من حديث رسول الله صلي الله عليه وسلم فلا يجوز لكم ان تقولوا هم متهمون فان قلتم قد يغلطون فقد يجوز لغيركم ان يقول لا ناخذ من اهل الغلط وان قلتم يغلطون في بعض ويحفظون في بعض جاز لغيركم ان يقول انما يدل علي غلط المحدث ان يخالفه غيره ممن هو احفظ منه او اكثر منه فان قلتم فيه لا يخالف به عن النبي صلي الله عليه وسلم ان صاحبه غلط مرة وحفظ جاز عليك ان يقال غلط حيث زعمت انه حفظ وحفظ حيث ( ( ( حين ) ) ) زعمت انه غلط وجاز عليك وعلي غيرك ان يقال كله يحتمل الغلط فندعه ونطلب العلم من حديث غيرهم ( قال الشافعي ) رحمه الله تعالي وهذا لا يوجد الا من حديث اهل الصدق ولا يجوز فيه الا ان يقبل فلا يترك شء روي عن النبي صلي الله عليه وسلم الا بما روي عن النبي نفسه وبالناس الحاجة الي رسول الله صلي الله عليه وسلم بما الزمهم الله من اتباع امره فقلت للشافعي فاذكر مما روي شيءا فقال الشافعي لا ارب لي في ذكره وان سالتني عن قولي لاوضح الحجة فيما جبيتك انت نفسك في قولك وقد اعطيتك جملة تغنيك ان شاء الله لا تدع لرسول الله صلي الله عليه وسلم حديثا ابدا الا ان ياتي عن رسول الله خلافه فتفعل فيه بما قلت لك في الاحاديث اذا اختلفت فقلت للشافعي فلست اريد مسالتك ما كرهت من ذكر احد ولكني اسالك في امر احب ان توضح لي فيه الحجة قال فسل
   * باب صلاة الامام اذا كان مريضا بالمامومين جالسا وصلاتهم خلفه قياما
  * سالت الشافعي هل للامام ان يءم الناس جالسا وكيف يصلون وراءه ايصلون قعودا او قياما فقال يامر من يقوم فيصلي بهم احب الي وان امهم جالسا وصلوا خلفه قياما كان صلاتهم وصلاته مجزية عنهم معا وكان كل صلي فرضه كما يصلي الامام اذا كان صحيحا قاءما ويصلي خلفه من لم يقدر علي القيام جالسا فيكون كل صلي فرضه وانما اخترت ان يوكل الامام اذا مرض رجلا صحيحا يصلي بالناس قاءما ان مرض رسول الله صلي الله عليه وسلم كان اياما كثيرة وانا لم نعلمه صلي بالناس جالسا في مرضه الا مرة لم يصل بهم بعدها علمته حتي لقي الله فدل ذلك علي ان التوكيل بهم والصلاة قاعدا جاءزان عنده معا وكان صلاتهم مع غيره بامره اكثر منه فقلت للشافعي فهل حفظت ان رسول الله صلي الله عليه وسلم صلي جالسا وصلي وراءه قوم قياما فاشار اليهم ان اقعدوا ثم امرهم حين فرغ من الصلاة اذا صلي الامام قاعدا ان يصلوا قعودا اجمعون فقال نعم ( قال الشافعي ) اخبرنا مالك عن بن شهاب  عن انس بن مالك ان رسول الله صلي الله عليه وسلم ركب فرسا فصرع عنه فجحش شقه الايمن فصلي في بيته قاعدا وصلي خلفه قوم قياما فاشار اليهم ان اجلسوا انما جعل الامام ليءتم به فاذا صلي جالسا فصلوا جلوسا اجمعون ( قال الشافعي ) اخبرنا مالك عن هشام يعني بن عروة عن ابيه عن عاءشة قالت صلي رسول الله صلي الله عليه وسلم في بيته وهو شاك فصلي جالسا وصلي خلفه قوم قياما فاشار اليهم ان اجلسوا فلما انصرف قال انما جعل الامام ليءتم به فاذا ركع فاركعوا واذا رفع فارفعوا واذا صلي جالسا فصلوا جلوسا فقلت للشافعي فقد رويت هذا فكيف لم تاخذ به فقال هذا منسوخ بفعل رسول الله صلي الله عليه وسلم فقلت وما نسخه فقال الحديث الذي ذكرت لك يدلك علي ان هذا كان في صرعة صرعها رسول الله صلي الله عليه وسلم فقلت فما نسخه فقال صلي رسول الله صلي الله عليه وسلم بالناس في مرضه الذي مات فيه جالسا والناس خلفه قياما لم يامرهم بجلوس ولم يجلسوا ولولا انه منسوخ صاروا الي الجلوس بمتقدم امره اياهم بالجلوس ولو ذهب ذلك عليهم لامرهم بالجلوس وقد صلي ابو بكر الي جنبه بصلاته قاءما ومرضه الذي مات فيه اخر فعله وبعد سقطته لانه لم يركب في مرضه الذي مات فيه حتي قبضه الله بابي هو وامي قلت فاذكر الحديث الذي رويته في هذا فقال اخبرنا مالك عن هشام بن عروة عن ابيه ان رسول الله صلي الله عليه وسلم خرج في مرضه فاتي ابا بكر وهو قاءم يصلي بالناس فاستاخر ابو بكر فاشار اليه رسول الله صلي الله عليه وسلم ان كما انت فجلس رسول الله الي جنب ابي بكر وكان ابو بكر يصلي بصلاة النبي صلي الله عليه وسلم وكان الناس يصلون بصلاة ابي بكر ( قال الشافعي ) رحمه الله تعالي اخبرنا الثقة عن حماد بن سلمة عن هشام بن عروة عن ابيه عن عاءشة بمثل معناه لا يخالفه واوضح منه قال وصلي ابو بكر الي جنبه قاءما ( قال الشافعي ) رحمه الله تعالي اخبرنا الثقة عن يحيي بن سعيد عن بن ابي مليكة عن عبيد بن عمير قال اخبرتني الثقة كانه يعني عاءشة ثم ذكر صلاة النبي صلي الله عليه وسلم وابو بكر الي جانبه بمثل معني حديث هشام بن عروة عن ابيه قال وروي عن ابراهيم النخعي عن الاسود بن يزيد عن عاءشة بمثل معني حديث هشام وعبيد بن عمير فقلت للشافعي فانا نقول لا يصلي احد بالناس جالسا ونحتج بانا روينا عن ربيعة ان ابا بكر صلي برسول الله صلي الله عليه وسلم ( قال الشافعي ) فان كان هذا ثابتا فليس فيه خلاف لما اخذنا به ولا ما تركنا من هذه الاحاديث قلت ولم قال قد مرض رسول الله صلي الله عليه وسلم اياما وليالي لم يبلغنا انه صلي بالناس الا صلاة واحدة وكان ابو بكر يصلي بالناس في ايامه تلك وصلاة النبي صلي الله عليه وسلم بالناس مرة لا تمنع ان يكون صلي ابو بكر غير تلك الصلاة بالناس مرة ومرات وكذلك لو صلي رسول الله صلي الله عليه وسلم خلف ابي بكر مرة ومرات لم يمنع ذلك ان يكون صلي خلفه ابو بكر اخري كما كان ابو بكر يصلي خلف رسول الله صلي الله عليه وسلم اكثر عمره فقلت للشافعي فقد ذهبنا الي توهين حديث هشام بن عروة بحديث ربيعة قال فانما ذهبتم اليه لجهالتكم بالحديث والحجج حديث ربيعة مرسل لا يثبت مثله ونحن لم نثبت حديث هشام بن عروة عن ابيه حتي اسنده هشام بن عروة عن ابيه عن عاءشة والاسود عن عاءشة عن النبي صلي الله عليه وسلم ووافقه عبيد بن عمير فكيف احتججتم بما لا يثبت من الحديث علي ما ثبت وهو اذا ثبت حتي يكون اثبت حديث يكون كما وصفت لا يخالف حديث عروة ولا انس ولا موافقة ولا بمعني فيوهن حديثنا وهذا منكم جهالة بالحديث وبالحجة ( قال الشافعي ) رحمه الله تعالي او رايت اذ جهلتم الحديث والحجة فلو كان حديث هشام بن عروة عن ابيه في صلاة النبي صلي الله عليه وسلم بابي بكر غير ثابت فيكون ناسخا لحديث انس وعاءشة عن النبي يامره ( ( ( بامره ) ) ) اذا صلي جالسا يصلي من خلفه جلوسا اما كنتم خالفتم حديثين ثابتين عن النبي صلي الله عليه وسلم الي غير  حديث ثابت عنه وهو لا يحل خلاف رسول الله صلي الله عليه وسلم الا الي حديث عنه ينسخ حديثه الذي خالفه اليه او يكون اثبت منه فلو لم يثبت حديث هشام حتي يكون ناسخا للحديثين لزمكم ان تامروا من صلي خلف الامام قاءما ان يجلس اذا جلس كما روي انس وعاءشة ان النبي صلي الله عليه وسلم امره وان كان حديث هشام ناسخا فقد خالفتم الناسخ والمنسوخ الي قول انفسكم وخلاف السنة ضيق علي كل مسلم فقلت للشافعي فهل خالفك في هذا غيرنا فقال نعم بعض الناس روي عن جابر الجعفي عن الشعبي ان رسول الله صلي الله عليه وسلم قال لا يءم احد بعدي جالسا قلت فما كانت حجتك عليه فقال الشافعي قد علم الذي احتج بهذا ان ليست فيه حجة وان هذا حديث لا يثبت مثله بحال علي شء ولو لم يخالفه غيره فقلت للشافعي فان قلت لم يعمل بهذا احد بعد النبي صلي الله عليه وسلم فقال الشافعي قد بينا لك قبل هذا ما نري انا وانتم نثبت الحديث عن النبي صلي الله عليه وسلم وان لم يعمل به بعده استغناه بالخبر عن رسول الله صلي الله عليه وسلم عما سواه فلا حاجة لنا باعادته فقلت للشافعي فهل قال قولك هذا احد من المشرقيين فقال نعم ابو حنيفة يقول فيه بقولنا ويخالفه صاحباه فقلت للشافعي افرايت حديثهم عندهم في هذا يثبت فقال لا فقلت فلم يحتجون به قال الله اعلم فاما الذي احتج به علينا ( ( ( عليها ) ) ) فسالناه عنه فقال لا يثبت لانه مرسل ولانه عن رجل يرغب الناس عن الرواية عنه فقلت فهذا سوء نصفه ( قال ( ( ( فقال ) ) ) الشافعي ) رحمه الله تعالي اجل وانتم اسوا منه نصفه حين لا تعتدون بحديثهم الذي هو ثابت عندهم وتخالفون ما رويتم عن رسول الله صلي الله عليه وسلم لا مخالف له عنه والله اعلم
   * باب رفع اليدين في الصلاة
  * قال سالت الشافعي اين ترفع الايدي في الصلاة قال يرفع المصلي يديه في اول ركعة ثلاث مرات وفيما سواها من الصلاة مرتين مرتين يرفع يديه حين يفتتح الصلاة مع تكبيرة الافتتاح حذو منكبيه ويفعل ذلك عند تكبيرة الركوع وعند قوله سمع الله لمن حمده حين يرفع راسه من الركوع ولا تكبيرة للافتتاح الا في الاولي ( ( ( الاول ) ) ) وفي كل ركعة تكبير ركوع وقول سمع الله لمن حمده عند رفع راسه من الركوع فيرفع يديه في هذين الموضعين في كل صلاة والحجة في هذا ان مالكا اخبرنا عن بن شهاب عن سالم عن ابيه ان رسول الله صلي الله عليه وسلم كان اذا افتتح الصلاة رفع يديه حذو منكبيه واذا رفع راسه من الركوع رفعهما كذلك وكان لا يفعل ذلك في السجود ( قال الشافعي ) رحمه الله تعالي اخبرنا سفيان عن الزهري عن سالم بن عبد الله بن عمر عن ابيه ان رسول الله صلي الله عليه وسلم كان يرفع يديه اذا افتتح الصلاة واذا اراد ان يركع واذا اراد رفع راسه من الركوع ولا يرفع في السجود قال وروي هذا عن النبي صلي الله عليه وسلم بضعة عشر رجلا ( قال الشافعي ) رحمه الله تعالي اخبرنا سفيان عن عاصم بن كليب عن ابيه عن واءل بن حجر قال رايت رسول الله صلي الله عليه وسلم يرفع يديه عند افتتاح الصلاة وحين يريد ان يركع واذا رفع من الركوع قال ثم قدمت عليهم في الشتاء فرايتهم يرفعون ايديهم في البرانس ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع عن بن عمر انه كان اذا ابتدا الصلاة رفع يديه حذو منكبيه واذا رفع راسه من الركوع رفعهما دون ذلك فقلت للشافعي فانا نقول يرفع يديه حين يفتتح الصلاة ثم لا يعود لرفعهما ( قال الشافعي ) رحمه الله تعالي فانتم اذا تتركون ما روي مالك عن رسول الله ثم عن بن عمر فكيف جاز لكم لو لم تعلموا علما الا ان تكونوا رويتم رفع اليدين في الصلاة عن النبي صلي الله عليه وسلم مرتين او ثلاثا وعن  بن عمر مرتين فاتبعتم النبي صلي الله عليه وسلم في احداهما وتركتم اتباعه في الاخري ولو جاز ان يتبع احد امريه دون الاخر جاز لرجل ان يتبع امر النبي صلي الله عليه وسلم حيث تركتموه ويتركه حيث اتبعتموه ولكن لا يجوز لاحد علمه من المسلمين عندي ان يتركه الا ناسيا او ساهيا فقلت للشافعي فما معني رفع اليدين عند الركوع فقال مثل معني رفعهما عند الافتتاح تعظيما لله وسنة متبعة يرجي فيها ثواب الله ومثل رفع اليدين علي الصفا والمروة وغيرهما ( قال الشافعي ) رحمه الله تعالي ارايت اذا كنتم تروون عن بن عمر شيءا فتتخذونه اصلا يبني عليه فوجدتم بن عمر يفعل شيءا في الصلاة فتركتموه عليه وهو موافق ما روي عن النبي صلي الله عليه وسلم افيجوز لاحد ان يفعل ما وصفتم من اتخاذ قول بن عمر منفردا حجة ثم تتركون معه سنة رسول الله لا مخالف له من اصحاب رسول الله صلي الله عليه وسلم ولا غيرهم ممن تثبت روايته من جهل هذا انبغي ان لا يجوز له ان يتكلم فيما هو ادق من العلم قلت فهل خالفك في هذا غيرنا قال نعم بعض المشرقيين وخالفوكم فقالوا يرفع يديه حذو اذنيه في ابتداء الصلاة فقلت هل رووا فيه شيءا قال نعم ما لا نثبت نحن ولا انتم ولا اهل الحديث منهم مثله واهل الحديث من اهل المشرق يذهبون مذهبنا في رفع الايدي ثلاث مرات في الصلاة فتخالفهم مع خلافكم السنة وامر العامة من اصحاب رسول الله صلي الله عليه وسلم
   * باب الجهر بامين
  * سالت الشافعي عن الامام اذا قال غير المغضوب عليهم ولا الضالين هل يرفع صوته بامين قال نعم ويرفع بها من خلفه اصواتهم فقلت وما الحجة فيما قلت من هذا فقال اخبرنا مالك عن بن شهاب عن بن المسيب وابي سلمة بن عبد الرحمن انهما اخبراه عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال اذا امن الامام فامنوا فانه من وافق تامينه تامين الملاءكة غفر له ما تقدم من ذنبه قال بن شهاب وكان رسول الله صلي الله عليه وسلم يقول امين قال وفي قول رسول الله اذا امن الامام فامنوا دلالة علي انه امر الامام ان يجهر بامين لان من خلفه لا يعرف وقت تامينه الا بان يسمع تامينه ثم بينه بن شهاب فقال كان رسول الله يقول امين فقلت للشافعي فانا نكره للامام ان يرفع صوته بامين فقال هذا خلاف ما روي صاحبنا وصاحبكم عن رسول الله صلي الله عليه وسلم ولو لم يكن عندنا وعندكم علم الا هذا الحديث الذي ذكرنا عن مالك انبغي ان نستدل بان رسول الله صلي الله عليه وسلم كان يجهر بامين وانه امر الامام ان يجهر بها فكيف ولم يزل اهل العلم عليه وروي واءل بن حجر ان النبي صلي الله عليه وسلم كان يقول امين يجهر بها صوته ويحكي مطه اياها وكان ابو هريرة يقول للامام لا تسبقني بامين وكان يءذن له ( قال الشافعي ) رحمه الله تعالي اخبرنا مسلم بن خالد عن بن جريج عن عطاء قال كنت اسمع الاءمة بن الزبير ومن بعده يقولون امين ومن خلفهم امين حتي ان للمسجد للجة ( قال الشافعي ) رايتك في مسالة امامة القاعد ومسالة رفع اليدين في الصلاة ومسالة قول الامام امين خرجت من السنة والاثار ووافقت منفردا من بعض المشرقيين الذين ترغب فيما يظهر عن اقاويلهم 
   * باب سجود القران
  * سالت الشافعي عن السجود في @QB@ اذا السماء انشقت @QE@ فقال فيها سجدة فقلت وما الحجة ان فيها سجدة ( قال الشافعي ) اخبرنا مالك عن عبد الله بن يزيد مولي الاسود بن سفيان عن ابي سلمة بن عبد الرحمن ان ابا هريرة قرا لهم @QB@ اذا السماء انشقت @QE@ فسجد فيها فلما انصرف اخبرهم ان رسول الله صلي الله عليه وسلم سجد فيها ( قال الشافعي ) واخبرنا مالك عن بن شهاب عن الاعرج ان عمر بن الخطاب قرا @QB@ والنجم اذا هوي @QE@ فسجد فيها ثم قام فقرا بسورة اخري ( قال الشافعي ) واخبرنا بعض اصحابنا عن مالك ان عمر بن عبد العزيز امر محمد بن مسلم ان يامر القراء ان يسجدوا في @QB@ اذا السماء انشقت @QE@ وسالت الشافعي عن السجود في سورة الحج فقال فيها سجدتان فقلت وما الحجة في ذلك قال اخبرنا مالك عن نافع ان بن عمر سجد في سورة الحج سجدتين ( قال الشافعي ) اخبرنا مالك عن نافع عن رجل من اهل مصر ان عمر بن الخطاب سجد في سورة الحج سجدتين ثم قال ان هذه السورة فضلت بسجدتين فقلت للشافعي فانا نقول اجتمع الناس علي ان سجود القران احدي عشرة سجدة ليس في المفصل منها شء فقال الشافعي انه يجب عليكم ان لا تقولوا اجتمع الناس الا لما اذا لقي اهل العلم فقيل لهم اجتمع الناس علي ما قلتم انهم اجتمعوا عليه قالوا نعم وكان اقل قولهم لك ان يقولوا لا نعلم من اهل العلم مخالفا فيما قلتم اجتمع الناس عليه فاما ان تقولوا اجتمع الناس واهل المدينة معكم يقولون ما اجتمع الناس علي ما زعمتم انهم اجتمعوا عليه فامران اساتم النظر بهما لانفسكم في التحفظ في الحديث وان تجعلوا السبيل لمن سمع قولكم اجتمع الناس الي رد قولكم ولا سيما اذ كنتم انما انتم معتضدون علي علم مالك رحمه الله واياه وكنتم تروون عن النبي صلي الله عليه وسلم انه سجد في @QB@ اذا السماء انشقت @QE@ وان ابا هريرة سجد فيها ثم تروون عن عمر بن عبد العزيز انه امر من يامر القراء ان يسجدوا فيها ( قال ) وانتم تجعلون قول عمر بن عبد العزيز اصلا من اصول العلم فتقولون كان لا يحلف الرجل للمدعي عليه الا ان يكون بينهما مخالطة فتركتم قول النبي صلي الله عليه وسلم البينة علي المدعي واليمين علي المدعي عليه لقول عمر ثم تجدون عمر يامر بالسجود في @QB@ اذا السماء انشقت @QE@ ومعه سنة رسول الله صلي الله عليه وسلم وراي ابي هريرة فتتركونه ولم تسموا احدا خالف هذا وهذا عندكم العلم لان النبي صلي الله عليه وسلم في زمانه ثم ابو هريرة في الصحابة ثم عمر بن عبد العزيز في التابعين والعمل يكون عندكم بقول عمر وحده واقل ما يءخذ عليكم في هذا ان يقال كيف زعمتم ان ابا هريرة سجد في @QB@ اذا السماء انشقت @QE@ وان عمر امر بالسجود فيها وان عمر بن الخطاب سجد في @QB@ النجم @QE@ ثم زعمتم ان الناس اجتمعوا ان لا سجود في المفصل وهذا من اصحاب رسول الله وهذا من علماء التابعين فيقال قولكم اجتمع الناس لما تحكون فيه غير ما قلتم بين في قولكم ان ليس كما قلتم ثم رويتم عن عمر بن الخطاب انه سجد في @QB@ النجم @QE@ ثم لا تروون عن غيره خلافه ثم رويتم عن عمر وبن عمر انهما سجدا في سورة الحج سجدتين وتقولون ليس فيها الا واحدة وتزعمون ان الناس اجمعوا ان ليس فيها الا واحدة ثم تقولون اجمع الناس وانتم تروون خلاف ما تقولون وهذا لا يعذر احد بان يجهله ولا يرضي احد ان يكون موجودا عليه لما فيه مما لا يخفي علي احد يعقل اذا سمعه ارايت اذا قيل لكم اي الناس اجمع علي ان لا سجود في المفصل وانتم تروون عن اءمة الناس السجود فيه ولا تروون عن غيرهم خلافهم اليس تقولون اجمع الناس ان في المفصل سجودا اولي بكم من ان تقولوا اجمع الناس ان لا سجود في المفصل فان قلتم لا يجوز اذا لم نعلمهم اجمعوا ان نقول اجمعوا فقد قلتم اجمعوا ولم ترووا عن واحد من الاءمة قولكم ولا ادري من الناس عندكم اخلق كانوا لم يسم واحد منهم وما ذهبنا بالحجة عليكم  الا من قول اهل المدينة وما جعلنا الاجماع الا اجماعهم فاحسنوا النظر لانفسكم واعلموا انه لا يجوز ان تقولوا اجمع الناس بالمدينة حتي لا يكون بالمدينة مخالف من اهل العلم ولكن قولوا فيما اختلفوا فيه اخترنا كذا ولا تدعوا الاجماع فتدعوا ما يوجد علي السنتكم خلافه فما اعلمه يءخذ علي احد نسب الي علم اقبح من هذا قلت للشافعي ارايت ان كان قولي اجتمع الناس عليه اعني من رضيت من اهل المدينة وان كانوا مختلفين فقال الشافعي افرايتم ان قال من يخالفكم ويذهب الي قول من خالف قول من اخذت بقوله اجمع الناس ايكون صادقا فان كان صادقا وكان بالمدينة قول ثالث يخالفكما اجمع الناس علي قول فان كنتم صادقين معا بالتاويل فبالمدينة اجماع من ثلاثة وجوه مختلفة وان قلتم الاجماع هو ضد الخلاف فلا يقال اجماع الا لما لا خلاف فيه بالمدينة قلت هذا الصدق المحض فلا تفارقه ولا تدعوا الاجماع ابدا الا فيما لا يوجد بالمدينة فيه اختلاف وهو لا يوجد بالمدينة الا وجد بجميع البلدان عند اهل العلم متفقين فيه لم يخالف اهل البلدان اهل المدينة الا ما اختلف فيه اهل المدينة بينهم ( قال الشافعي ) رحمه الله تعالي واجعل ما وصفنا علي هذا الباب كافيا لك دالا علي ما سواه اذا اردت ان تقول اجمع الناس فان كانوا لم يختلفوا فيه فقله وان كانوا اختلفوا فيه فلا تقله فان الصدق في غيره
   * باب الصلاة في الكعبة
  * وسالت الشافعي عن الرجل يصلي في الكعبة المكتوبة فقال يصلي فيها المكتوبة والنافلة واذا صلي الرجل وحده فلا موضع يصلي فيه افضل من الكعبة فقلت افيصلي فوق ظهرها فقال ان كان بقي فوق ظهرها من البناء شء يكون سترة صلي فوق ظهرها المكتوبة والنافلة وان لم يكن بقي عليه بناء يستر المصلي لم يصل الي غير شء من البيت فقلت للشافعي فما الحجة فيما ذكرت فقال اخبرنا مالك عن نافع عن بن عمر عن بلال ان النبي صلي الله عليه وسلم صلي في الكعبة فقلت للشافعي فهل خالفك في هذا غيرك فقال نعم دخل اسامة وبلال وعثمان بن طلحة فقال اسامة نظر فاذا هو اذا صلي في البيت في ناحية ترك شيءا من البيت لظهره فكره ان يدع شيءا من البيت لظهره فكبر في نواحي البيت ولم يصل فقال قوم لا تصلح الصلاة في الكعبة بهذا الحديث وهذه العلة فقلت للشافعي فما حجتك عليهم فقال قال بلال صلي وكان من قال صلي شاهدا ومن قال لم يصل ليس بشاهد فاخذنا بقول بلال وكانت الحجة الثابتة عندنا ان المصلي خارجا من البيت انما يستقبل منه موضع متوجهه لا كل جدرانه فكذلك الذي في بطنه يستقبل موضع متوجهه لا كل جدرانه ومن كان البيت مشتملا عليه فكان يستقبل موضع متوجهه كما يستقبل الخارج منه موضع متوجهه كان في هذا الموضع افضل من موضع الخارج منه اين كان فقلت للشافعي فانا نقول يصلي فيه النافلة ولا يصلي فيه المكتوبة ( قال الشافعي ) رحمه الله تعالي هذا القول غاية في الجهل ان كان كما قال من خالفنا لا تصلي فيه النافلة ولا تصلي فيه المكتوبة وان كان كما رويتم فان النافلة في الارض لا تصلح الا حيث تصلح المكتوبة والمكتوبة الا حيث تصلح النافلة او رايت المواضع التي صلي فيها رسول الله صلي الله عليه وسلم النوافل حول المدينة وبين المدينة ومكة وبالمحصب ولم يصل هنالك مكتوبة ايحرم ان يصلي هنالك مكتوبة وان صلاته النافلة في موضع من الارض تدل علي ان الصلاة المكتوبة تجوز فيه 
   * باب ما جاء في الوتر بركعة واحدة
  * سالت الشافعي عن الوتر ايجوز ان يوتر الرجل بواحدة ليس قبلها شء قال نعم والذي اختار ان اصلي عشر ركعات ثم اوتر بواحدة فقلت للشافعي فما الحجة في ان يجوز بواحدة فقال الحجة فيه السنة والاثار ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع وعبد الله بن دينار عن بن عمر ان رسول الله صلي الله عليه وسلم قال صلاة الليل مثني مثني فاذا خشي احدكم الصبح صلي ركعة توتر له ما قد صلي ( قال الشافعي ) اخبرنا مالك عن بن شهاب عن عروة عن عاءشة ان رسول الله صلي الله عليه وسلم كان يصلي بالليل احدي عشرة ركعة يوتر منها بواحدة ( قال الشافعي ) اخبرنا مالك عن بن شهاب ان سعد بن ابي وقاص كان يوتر بركعة اخبرنا مالك عن نافع ان بن عمر كان يسلم من الركعة والركعتين من الوتر حتي يامر ببعض حاجته قال وكان عثمان يحيي الليل بركعة هي وتره واوتر معاوية بواحدة فقال بن عباس اصاب به فقلت للشافعي فانا نقول لا نحب لاحد ان يوتر باقل من ثلاث ويسلم بين الركعة والركعتين من الوتر فقال الشافعي لست اعرف لما تقول وجها والله المستعان ان كنتم ذهبتم الي انكم تكرهون ان يصلي ركعة منفردة فانتم اذا صلي ركعتين قبلها ثم سلم تامرونه بافراد الركعة لان من سلم من الصلاة فقد فصلها مما بعدها الا تري ان الرجل يصلي النافلة ركعات فيسلم في كل ركعتين فيكون كل ركعتين يسلم منهما منقطعتين من الركعتين اللتين قبلهما وبعدهما وان السلام افضل للفصل الا تري ان رجلا لو فاتته صلوات فقضاهن في مقام يفصل بينهن بسلام كانت كل صلاة غير الصلاة التي قبلها وبعدها لخروجه من كل صلاة بالسلام فان كان انما اردتم انكم كرهتم ان يصلي واحدة لان النبي صلي الله عليه وسلم صلي اكثر منها فانما نستحب ان يصلي احدي عشر ( ( ( عشرة ) ) ) ركعة يوتر منها بواحدة وان كان اردتم ان النبي صلي الله عليه وسلم قال صلاة الليل مثني مثني فاقل مثني اربع فصاعدا وواحدة غير مثني وقد امر بواحدة في الوتر كما امر بمثني ( قال الشافعي ) رحمه الله تعالي وقد اخبرنا عبد المجيد عن بن جريج عن هشام بن عروة عن ابيه عن عاءشة ان النبي صلي الله عليه وسلم كان يوتر بخمس ركعات لا يجلس ولا يسلم الا في الاخرة منهن فقلت للشافعي فما معني هذا قال هذه نافلة يسع ان نوتر بواحدة واكثر ونختار ما وصفت من غير ان نضيق غيره وقولكم والله يغفر لنا ولكم لا يوافق سنة ولا اثرا ولا قياسا ولا معقولا قولكم خارج من كل شء من هذا واقاويل الناس اما ان يقولوا لا يوتر الا بثلاث كما قال بعض المشرقيين ولا يسلم في واحدة منهن لءلا يكون الوتر واحدة (  ) وانتم تامرون بالسلام فيها فاذا امرتم به فهي واحدة وان قلتم كرهناه لان النبي صلي الله عليه وسلم لم يوتر بواحدة ليس قبلها شء فلم يوتر النبي صلي الله عليه وسلم بثلاث ليس قبلهن شء وقد استحسنتم ان توتروا بثلاث
   * باب القراءة في العيدين والجمعة
  * سالت الشافعي باي شء تحب ان يقرا في العيدين فقال ب @QB@ ق @QE@ و @QB@ اقتربت الساعة @QE@ وسالته باي شء تستحب ان يقرا في الجمعة فقال في الركعة الاولي بالجمعة واختار في الثانية @QB@ اذا جاءك المنافقون @QE@ ولو قرا @QB@ هل اتاك حديث الغاشية @QE@ او @QB@ سبح اسم ربك الاعلي @QE@ كان حسنا لانه قد روي عن النبي صلي الله عليه وسلم انه قراها كلها فقلت وما الحجة في ذلك فقال ابراهيم وغيره عن جعفر عن ابيه عن عبيد الله بن ابي رافع عن ابي هريرة ان النبي صلي الله عليه وسلم قرا في اثر سورة الجمعة @QB@ اذا جاءك المنافقون @QE@ قال الشافعي رحمه الله تعالي واخبرنا مالك عن ضمرة بن سعيد المازني عن  عبيد الله بن عبد الله بن عتبة ان الضحاك بن قيس سال النعمان بن بشير ما كان النبي صلي الله عليه وسلم يقرا يوم الجمعة علي اثر سورة الجمعة فقال كان يقرا ب @QB@ هل اتاك حديث الغاشية @QE@ قال الشافعي رحمه الله تعالي اخبرنا مالك عن ضمرة بن سعيد المازني عن عبيد الله بن عبد الله بن عتبة ان عمر بن الخطاب سال ابا واقد الليثي ماذا كان النبي صلي الله عليه وسلم يقرا به في الاضحي والفطر فقال كان يقرا ب @QB@ ق والقران المجيد @QE@ و @QB@ اقتربت الساعة @QE@ فقلت للشافعي فانا لا نبالي باي سورة قرا فقال ولم لا تبالون وهذه روايتكم عن النبي صلي الله عليه وسلم فقلت لانه يجزيه فقال او رايتم اذ امرنا بالغسل للاهلال والصلاة في المعرس وغير ذلك اقتداء بامر النبي صلي الله عليه وسلم لو قال قاءل لا نستحبه او لا نبالي ان لا نفعله لانه ليس بواجب هل الحجة عليه الا كهي عليكم او رايتم اذا استحببنا ركعتي الفجر والوتر وركعتين بعد المغرب وان يطيل في الصبح والظهر ويخفف في المغرب لو قال قاءل لا ابالي ان لا افعل من هذا شيءا هل الحجة عليه الا ان تقول قولكم لا ابالي جهالة وترك للسنة ينبغي ان تستحبوا ما صنع رسول الله بكل حال
   * باب الجمع بين الظهر والعصر والمغرب والعشاء
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن ابي الزبير المكي عن سعيد بن جبير عن بن عباس قال صلي رسول الله صلي الله عليه وسلم الظهر والعصر جميعا والمغرب والعشاء جميعا في غير خوف ولا سفر قال مالك اري ذلك في مطر ( قال الشافعي ) فزعمتم ان رسول الله صلي الله عليه وسلم جمع بالمدينة الظهر والعصر والمغرب والعشاء ولم يكن له وجه عندكم الا ان ذلك في مطر ثم زعمتم انتم انكم تجمعون بين المغرب والعشاء بالمدينة وكل بلد جامع ولا تجمعون بين الظهر والعصر في المطر ( قال الشافعي ) وانما ذهب الناس في هذا مذاهب فمنهم من قال جمع بالمدينة توسعة علي امته لءلا يحرج منهم احد ان جمع بحال وليس ( ( ( ليس ) ) ) لاحد ان يتاول في الحديث ما ليس فيه وقالت فرقة نوهن هذا لان النبي صلي الله عليه وسلم وقت المواقيت في الصلاة فكان هذا خلافا لما رووا من امر المواقيت فردوا ان يجمع احد في الحضر في مطر او غيره وامتنعوا من تثبيته وقالوا خالفه ما هو اقوي منه وقالوا لو ثبتناه لزمنا مثل قول من قال يجمع لانه ليس في الحديث ذكر مطر ولا غيره بل قال من حمل الحديث اراد ان لا تحرج امته ( قال الشافعي ) رحمه الله تعالي فذهبتم ومن ذهب مذهبكم المذهب الذي وصفت من الاحتجاج في الجمع في المطر وراي ان وجه الحديث هو الجمع في المطر ثم خالفتموه في الجمع في الظهر والعصر في المطر ارايتم ان قال لكم قاءل بل نجمع بين الظهر والعصر في المطر ولا نجمع بين المغرب والعشاء في المطر هل الحجة عليه الا ان الحديث اذا كانت فيه الحجة لم يجز ان يءخذ ببعضه دون بعض فكذلك هي علي من قال يجمع بين المغرب والعشاء ولا يجمع بين الظهر والعصر وقلما نجد لكم قولا يصح والله المستعان ارايتم اذا رويتم عن النبي صلي الله عليه وسلم انه جمع بين الظهر والعصر والمغرب والعشاء فاحتججتم علي من خالفكم بهذا الحديث في الجمع بين المغرب والعشاء هل تعدون ان يكون لكم بهذا حجة فان كانت لكم به حجة فعليكم فيه حجة في ترككم الجمع بين الظهر والعصر وان لم تكن لكم بهذا حجة علي من خالفكم فلا تجمعوا بين ظهر ولا عصر ولا مغرب ولا عشاء لا يجوز غير هذا وانتم خارجون من الحديث ومن معاني مذاهب اهل العلم كلها والله المستعان او رايتم اذ رويتم الجمع في السفر لو قال قاءل كما قلتم اجمع بين المغرب والعشاء لان اكثر الاحاديث جاءت فيه ولا اجمع بين الظهر والعصر لانهما في النهار والليل اهول من النهار هل الحجة عليه الا ان الجمع رخصة فيها فلا يجوز ان يمنع احد من بعضها دون بعض فكذلك هي عليكم والله اعلم 
   * باب اعادة المكتوبة مع الامام
  * سالت الشافعي عن الرجل يصلي في بيته ثم يدرك الصلاة مع الامام قال يصلي معه ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن زيد بن اسلم عن رجل من بني الديل يقال له بسر بن محجن عن ابيه انه كان في مجلس مع رسول الله صلي الله عليه وسلم فاذن بالصلاة فقام رسول الله فصلي ومحجن في مجلسه فقال له رسول الله صلي الله عليه وسلم ما منعك ان تصلي مع الناس الست برجل مسلم قال بلي يا رسول الله ولكني قد صليت في اهلي فقال رسول الله صلي الله عليه وسلم اذا جءت فصل مع الناس وان كنت قد صليت ( قال الشافعي ) واخبرنا مالك عن نافع عن بن عمر انه كان يقول من صلي المغرب او الصبح ثم ادركهما مع الامام فلا يعدلهما ( ( ( يعدهما ) ) ) فقلت للشافعي فانا نقول يعيد كل صلاة الا المغرب فانه اذا اعاد لها صارت شفعا ( قال الشافعي ) وقد رويتم الحديث عن النبي صلي الله عليه وسلم لم يخص فيه صلاة دون صلاة فلم يحتمل الحديث الا وجهين احدهما وهو اظهرهما ان يعيد كل صلاة بطاعة النبي صلي الله عليه وسلم وسعة الله ان يوفيه اجر الجماعة والانفراد وقد روي مالك عن بن عمر وبن المسيب انهما امرا من صلي في بيته ان يعود لصلاته مع الامام وقال الساءل ايتهما اجعل صلاتي فقال او ذلك اليك انما ذلك الي الله وروي عن ابي ايوب الانصاري انه امر بذلك وقال من فعل ذلك فله سهم جمع او مثل سهم جمع وانما قلنا بهذا لما وصفنا من ان حديث النبي صلي الله عليه وسلم جملة وانه بلغنا ان الصلاة التي امر النبي صلي الله عليه وسلم الرجلين ان يعودا لها صلاة الصبح او يقول رجل ان ادرك العصر او الصبح لم يعد لهما لانه لا نافلة بعد واحدة منهما فهكذا قال بعض المشرقيين واما ما قلتم فخلاف حديث النبي صلي الله عليه وسلم من الوجهين وخلاف بن عمر وبن المسيب واين العمل وقولكم اذا اعاد المغرب صارت شفعا فكيف تصير شفعا وقد فصل بينهما بسلام اتري العصر حين صليت بعدها المغرب شفعا او العصر وترا او تري كذلك العشاء اذا صليت بعد المغرب او تري ركعتين بعد او قبل المغرب تصيران وترا بان المغرب قبلهما او بعدهما ام كل صلاة فصلت بسلام مفارقة للصلاة قبلها وبعدها ولو كنتم قلتم يعود للمغرب ويشفعها بركعة فيكون تطوع باربع كان مذهبا فاما ما قلتم فليس له وجه
   * باب القراءة في المغرب
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن بن شهاب عن محمد بن جبير بن مطعم عن ابيه قال سمعت رسول الله صلي الله عليه وسلم قرا بالطور في المغرب ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن بن شهاب عن عبيد الله بن عبد الله بن عتبة عن بن عباس عن ام الفضل بنت الحرث سمعته يقرا @QB@ والمرسلات عرفا @QE@ فقالت يا بني لقد ذكرتني بقراءتك هذه السورة انها لاخر ما سمعت رسول الله صلي الله عليه وسلم يقرا بها في المغرب فقلت للشافعي فانا نكره ان يقرا في المغرب بالطور والمرسلات ونقول يقرا باقصر منهما فقال وكيف تكرهون ما رويتم ان رسول الله صلي الله عليه وسلم فعله الامر رويتم عن النبي صلي الله عليه وسلم يخالفه فاخترتم احدي الروايتين علي الاخري او رايتم لو لم استدل علي ضعف مذهبكم في كل شء الا انكم تروون عن النبي صلي الله عليه وسلم شيءا ثم تقولون نكرهه ولم ترووا غيره فاقول انكم اخترتم غيره عن النبي صلي الله عليه وسلم لا اعلم الا ان احسن حالكم انكم قليلوا ( ( ( قليلو ) ) ) العلم ضعفاء المذهب 
   * باب القراءة في الركعتين الاخيرتين
  * سالت الشافعي اتقرا خلف الامام ام القران في الركعة الاخيرة تسر فقال الشافعي احب ذلك وليس بواجب عليه فقلت وما الحجة فيه فقال اخبرنا مالك عن ابي عبيد مولي سليمان بن عبد الملك ان عبادة بن نسي اخبره انه سمع قيس بن الحرث يقول اخبرني عبد الله الصنابحي انه قدم المدينة في خلافة ابي بكر الصديق فصلي وراء ابي بكر المغرب فقرا في الركعتين الاوليين بام القران وسورة من قصار المفصل ثم قام في الركعة الثالثة فدنوت منه حتي ان ثيابي لتكاد ان تمس ثيابه فسمعته قرا بام القران وبهذه الاية @QB@ ربنا لا تزغ قلوبنا بعد اذ هديتنا وهب لنا من لدنك رحمة انك انت الوهاب @QE@ فقلت للشافعي فانا نكره هذه ونقول ليس عليه العمل لا يقرا علي اثر ام القران في الركعة الثالثة بشء فقال الشافعي وقال سفيان بن عيينة لما سمع عمر بن عبد العزيز بهذا عن ابي بكر الصديق قال ان كنت لعلي غير هذا حتي سمعت بهذا فاخذت به قال فهل تركتم للعمل عمل ابي بكر وبن عمر وعمر بن عبد العزيز ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع عن عبد الله انه كان اذا صلي وحده يقرا في الاربع جميعا في كل ركعة بام القران وبسورة من القران قال وكان يقرا احيانا بالسورتين والثلاث في الركعة الواحدة في صلاة الفريضة فقلت للشافعي فانا نخالف هذا كله ونقول لا يزاد في الركعتين الاخيرتين علي ام القران ( قال الشافعي ) هذا خلاف ابي بكر وبن عمر من روايتكم وخلاف عمر بن عبد العزيز من رواية سفيان وقولكم لا يجمع السورتين في الركعتين الاوليين هو خلاف بن عمر من روايتكم وخلاف عمر من روايتكم لانكم اخبرتم ان عمر قرا بالنجم فسجد فيها ثم قام فقرا بسورة اخري وخلاف غيرهما من رواية غيركم فاين العمل ما نراكم رويتم في القراءة في الصلاة في هذا الباب شيءا الا خالفتموه فمن اتبعتم ما اراكم قلتم بمعني نعرفه اذا كنتم تروون عن احد الشء مرة فتبنون عليه ايسعكم ان تخلفوهم ( ( ( تخالفوهم ) ) ) مجتمعين ( ( ( مجمعين ) ) ) ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن هشام بن عروة عن ابيه ان ابا بكر صلي الصبح فقرا فيها بسورة البقرة في الركعتين كلتاهما فقلت للشافعي انا نخالف هذا نقول يقرا في الصبح باقل من هذا لان هذا تثقيل علي الناس ( قال الشافعي ) اخبرنا مالك عن هشام بن عروة انه سمع عبد الله بن عامر بن ربيعة يقول صلينا وراء عمر بن الخطاب الصبح فقرا فيها بسورة يوسف وسورة الحج قراءة بطيءة فقلت والله لقد كان اذا يقوم حين يطلع الفجر قال اجل فقلت للشافعي فانا نقول لا يقرا في الصبح بهذا ولا بقدر نصف هذا لانه تثقيل ( قال الشافعي ) اخبرنا مالك عن يحيي بن سعيد وربيعة بن ابي عبد الرحمن ان الفرافصة بن عمير الحنفي قال ما اخذت سورة يوسف الا من قراءة عثمان بن عفان اياها في الصبح من كثرة ما كان يرددها فقلت للشافعي فانا نقول لا يقرا بهذا هذا تثقيل ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع عن بن عمر انه كان يقرا في الصبح في السفر بالعشر الاول من المفصل ( ( ( الفصل ) ) ) في كل ركعة سورة قلت للشافعي فانا نقول لا يقرا بهذا في السفر هذا تثقيل قال الشافعي رحمه الله تعالي فقد خالفتم في القراءة في الصلاة كل ما رويتم عن النبي صلي الله عليه وسلم ثم ابي بكر ثم عمر ثم عثمان ثم بن عمر ولم ترووا شيءا يخالف ما خالفتم عن احد علمته من الناس فاين العمل خالفتموهم من جهتين من جهة التثقيل وجهة التخفيف وقد خالفتم بعد النبي صلي الله عليه وسلم جميع ما رويتم عن الاءمة بالمدينة بلا رواية رويتموها عن احد منهم هذا مما يبين ضعف مذهبكم اذ رويتم هذا ثم خالفتموه ولم يكن عندكم فيه حجة فقد خالفتم الاءمة والعمل وفي هذا دليل علي انكم لم تجدوا من خلق الله خلقا قط يروي عن النبي صلي الله عليه وسلم ثم ابي بكر وعمر وعثمان وبن عمر في القراءة في الصلاة ولا في امر واحد شيءا  ثم يخالفه غيركم وانه لا خلق اشد خلافا لاهل المدينة منكم ثم خلافكم ما رويتم عن رسول الله صلي الله عليه وسلم الذي فرض الله طاعته وما رويتم عن الاءمة الذين لا تجدون مثلهم فلو قال لكم قاءل انتم اشد الناس معاندة لاهل المدينة وجد السبيل الي ان يقول ذلك لكم علي لسانكم لا تقدرون علي دفعه عنكم ثم الحجة عليكم في خلافكم اعظم منها علي غيركم لانكم ادعيتم القيام بعلمهم واتباعهم دون غيركم ثم خالفتموهم باكثر مما خالفهم به من لم يدع من اتباعهم ما ادعيتم فلءن كان هذا خفي عليكم من انفسكم ان فيكم لغفلة ما يجوز لكم معها ان تفتوا خلقا والله المستعان واراكم قد تكلفتم الفتيا وتطاولتم علي غيركم ممن هو اقصد واحسن مذهبا منكم
   * باب المستحاضة
  * سالت الشافعي عن المستحاضة يطبق عليها الدم دهرها فقال ان الاستحاضة وجهان احدهما ان تستحاض المراة فيكون دمها مشتبها لا ينفصل اما ثخين كله واما رقيق كله واذا كان هكذا نظرت عدد الليالي والايام التي كانت تحيضهن من الشهر قبل ان يصيبها الذي اصابها فتركت الصلاة فيهن ان كانت تحيض خمسا من اول الشهر تركت الصلاة خمسا من اوله ثم اغتسلت عند مضي ايام حيضها كما تغتسل الحاءض عند طهرها ثم توضا لكل صلاة وتصلي وليس عليها ان تعيد الغسل مرة اخري ولو اغتسلت من طهر الي طهر كان احب الي وليس ذلك بواجب عليها عندي والمستحاضة الثانية المراة لا تري الطهر فيكون لها ايام من الشهر ودمها احمر الي السواد محتدم ثم يصير بعد تلك الايام رقيقا الي الصفرة غير محتدم فايام حيض هذه ايام احتدام دمها وسواده وكثرته فاذا مضت اغتسلت كغسلها لو طهرت من الحيضة وتوضات لكل صلاة وصلت فقلت للشافعي وما الحجة فيما ذكرته من هذا فقال الشافعي اخبرنا مالك عن هشام بن عروة عن ابيه عن عاءشة انها قالت قالت فاطمة بنت ابي حبيش يا رسول الله اني لا اطهر افادع الصلاة فقال النبي صلي الله عليه وسلم انما ذلك عرق وليس بالحيضة فاذا اقبلت الحيضة فاتركي الصلاة فاذا هب قدرها فاغسلي الدم عنك وصلي ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع عن سليمان بن يسار عن ام سلمة زوج النبي صلي الله عليه وسلم ان امراة كانت تهراق الدم علي عهد رسول الله صلي الله عليه وسلم فاستفتت لها ام سلمة رسول الله صلي الله عليه وسلم فقال لتنظر عدة الليالي والايام التي كانت تحيضهن من الشهر قبل ان يصيبها الذي اصابها فلتترك الصلاة قدر ذلك من الشهر فاذا خلفت ذلك فلتغتسل ثم لتستثفر بثوب ثم لتصلي قال فدل جواب رسول الله صلي الله عليه وسلم علي ما وصفت من انفراق حال المستحاضتين وفي قوله دليل علي انه ليس للحاءض ان تستظهر بطرفة عين وذلك انه امر احداهما اذا ذهبت مدة الحيض ان تغسل عنها الدم وتصلي وامر الاخري ان تربص عدد الليالي والايام التي كانت تحيضهن ثم تغتسل وتصلي والحديثان جميعا ينفيان الاستظهار فقلت للشافعي فانا نقول تستظهر الحاءض بثلاثة ايام ثم تغتسل وتصلي ونقول تتوضا لكل صلاة ( قال الشافعي ) فحديثاكم اللذان تعتمدون عليهما عن رسول الله يخالفان الاستظهار والاستظهار خارج من السنة والاثار والمعقول والقياس واقاويل اكثر اهل العلم فقلت ومن اين فقال الشافعي ارايتم استظهارها امن ايام حيضها ام ايام طهرها فقلت هي من ايام حيضها فقال فاسمعكم عمدتم الي امراة كانت ايام حيضها خمسا فطبق عليها الدم فقلتم نجعلها ثمانيا ورسول الله صلي الله عليه وسلم امرها اذا مضت ايام حيضها قبل الاستحاضة ان تغتسل وتصلي وجعلتم لها وقتا غير وقتها الذي كانت تعرف فامرتموها ان تدع الصلاة في الايام التي امرها رسول الله صلي الله عليه وسلم ان تصلي فيها قال افرايتم ان قال لكم قاءل لا يعرف السنة تستظهر بساعة او يوم او يومين او تستظهر بعشرة  ايام او ست او سبع باي شء انتم اولي بالصواب من احد ان قال ببعض هذا القول هل يصلح ان يوقت العدد الا بخبر عن رسول الله او اجماع من المسلمين ولقد وقتموه بخلاف ما رويتم عن رسول الله واكثر اقاويل المسلمين ثم قلتم فيه قولا متناقضا فزعمتم ان ايام حيضها ان كانت ثلاثا استظهرت بمثل ايام حيضها وذلك ثلاث وان كانت ايام حيضها اثني عشر استظهرت بمثل ربع ايام حيضها وذلك ثلاث وان كانت ايام حيضها خمسة عشر لم تستظهر بشء وان كانت اربعة عشر استظهرت بيوم وان كانت ثلاثة عشر استظهرت بيومين فجعلتم الاستظهار مرة ثلاثا ومرة يومين ومرة يوما ومرة لا شء فقلت للشافعي فهل رويتم في المستحاضة عن صاحبنا شيءا غير هذا فقال نعم شيءا عن سعيد بن المسيب وشيءا عن عروة بن الزبير ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن سمي مولي ابي بكر ان القعقاع بن حكيم وزيد بن اسلم ارسلاه الي سعيد بن المسيب ليساله كيف تغتسل المستحاضة فقال تغتسل من طهر الي طهر وتتوضا لكل صلاة فان غلبها الدم استثفرت ( قال الشافعي ) اخبرنا مالك عن هشام بن عروة عن ابيه انه قال ليس علي المستحاضة الا ان تغتسل غسلا واحدا ثم تتوضا بعد ذلك لكل صلاة قال مالك الامر عندنا علي حديث هشام بن عروة فقلت للشافعي فانا نقول بقول عروة وندع قول بن المسيب فقال الشافعي اما قول بن المسيب فتركتموه كله ثم ادعيتم قول عروة وانتم تخالفونه في بعضه فقلت واين قال قال عروة تغتسل غسلا واحدا يعني كما تغتسل المتطهرة وتتوضا لكل صلاة يعني توضا ( ( ( توضءا ) ) ) من الدم للصلاة لا تغتسل من الدم انما القي عنها الغسل بعد الغسل الاول والغسل انما يكون من الدم وجعل عليها الوضوء ثم زعمتم انه لا وضوء عليها فخالفتم الاحاديث التي رواها صاحبنا وصاحبكم عن النبي صلي الله عليه وسلم وبن المسيب وعروة وانتم تدعون انكم تتبعون اهل المدينة وقد خالفتم ما روي صاحبنا عنهم كله انه لبين في قولكم انه ليس احد اترك علي اهل المدينة لجميع اقاويلهم منكم مع ما تبين في غيره ثم ما اعلمكم ذهبتم الي قول اهل بلد غيرهم فاذا انسلختم من قولهم وقول اهل البلدان ومما رويتم وروي غيركم والقياس والمعقول فاي موضع تكونون به علماء وانتم تخطءون مثل هذا وتخالفون فيه اكثر الناس
   * باب الكلب يلغ في الاناء او غيره
  * سالت الشافعي عن الكلب يلغ في الاناء في الماء لا يكون فيه قلتان او في اللبن او المرق قال يهراق الماء واللبن والمرق ولا ينتفعون به ويغسل الاناء سبع مرات وما مس ذلك الماء واللبن من ثوب وجب غسله لانه نجس فقلت وما الحجة في ذلك فقال اخبرنا مالك عن ابي الزناد عن الاعرج عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال اذا شرب الكلب في اناء احدكم فليغسله سبع مرات ( قال الشافعي ) فكان بينا في سنة رسول الله صلي الله عليه وسلم اذا كان الكلب يشرب الماء في الاناء فينجس الاناء حتي يجب غسله سبعا انه انما ينجس بمماسة الماء اياه فكان الماء اولي بالنجاسة من الاناء الذي انما نجس بمماسته وكان الماء الذي هو طهور اذا نجس فاللبن والمرق الذي ليس بطهور اولي ان ينجس بما نجس الماء فقلت للشافعي فانا نزعم ان الكلب اذا شرب في الاناء فيه اللبن بالبادية شرب اللبن وغسل الاناء سبعا لان الكلاب لم تزل بالبادية فقال الشافعي هذا الكلام المحال ايعدو الكلب ان يكون ينجس ما يشرب منه ولا يحل شرب النجس ولا اكله او لا ينجسه فلا يغسل الاناء منه ولا يكون بالبادية فرض من النجاسة الا وبالقرية مثله وهذا خلاف السنة والقياس والمعقول والعلة الضعيفة واري قولكم لم تزل الكلاب بالبادية حجة  عليكم فاذا سن رسول الله صلي الله عليه وسلم ان يغسل الاناء من شرب الكلب سبعا والكلاب في البادية في زمانه وقبله وبعده الي اليوم فهل زعمتم عن النبي صلي الله عليه وسلم ان ذلك علي اهل القرية دون اهل البادية او اهل البادية دون اهل القرية او زعم لكم ذلك احد من اءمة المسلمين او فرق الله بين ما ينجس بالبادية والقرية اورايت اهل البادية هل زعموا لكم انهم يلقون البانهم للكلاب ما تكون الكلاب مع اهل البادية الا ليلا لانها تسرح مع مواشيهم ولهم اشح علي البانهم واشد لها ابقاء من ان يخلوا بينها وبين الكلاب وهل قال لكم احد من اهل البادية ليس يتنجس بالكلب وهم اشد تحفظا من غيرهم او مثلهم او لو قاله لكم منهم قاءل ايءخذ الفقه من اهل البادية وان اعتللتم بان الكلاب مع اهل البادية افرايتم ان اعتل عليكم مثلكم من اهل الغباوة بان يقول الفار والوزغان واللحكاء والدواب لاهل القرية الزم من الكلاب لاهل البادية واهل القرية اقل امتناعا من الفار ودواب البيوت من اهل البادية من الكلاب فاذا ماتت فارة او دابة في ماء رجل قليل او زيته او لبنه او مرقه لم تنجسه هل الحجة عليه الا ان يقال الذي ينجس في الحال التي ينجس فيها ينجس ما وقع فيه كان كثيرا بقرية او بادية او قليلا فكذلك الكلاب بالبادية والفار والدواب بالقرية اولي ان لا تنجس ان كان فيما ذكرتم حجة وما علمت احدا روي عنه من اصحاب رسول الله صلي الله عليه وسلم ولا التابعين انه قال فيه الا بمثل قولنا الا ان من اهل زماننا من قال يغسل الاناء من الكلب مرة واحدة وكلهم قال ينجس جميع ما يشرب منه الكلب من ماء ولبن ومرق وغيره ( قال الشافعي ) رحمه الله تعالي ان ممن تكلم في العلم من يختال فيه فيشبه والذي رايتكم تختالونه لا شبهة فيه ولا مءنة علي من سمعه في انه خطا انما يكفي سامع قولكم ان يسمعه فيعلم انه خطا لا ينكشف بتكلف ( ( ( يتكلف ) ) ) ولا بقياس ياتي به فان ذهبتم الي ان النبي صلي الله عليه وسلم امر اذا ماتت الفارة في السمن الجامد ان تطرح وما حولها فدل ذلك علي نجاستها فقد اخبر ان النجاسة تكون من الفارة وهي في البيوت وانما قال في الفارة قولا عاما وفي الكلب قولا عاما فان ذهبتم الي ان الفارة تنجس علي اهل القرية ولا تنجس علي اهل البادية فقد سويتم بين قوليكم وزدتم في الخطا وان قلتم ان ما لم يسم من الدواب غير الفارة والكلب لا ينجس فاجعل الوزغ لا ينجس لانه لم يذكر فاما ان تقولوا الوزغ ينجس ولا خبر ( ( ( خير ) ) ) فيه قياسا وتزعمون ان الكلب ينجس مرة ولا ينجس اخري فلا يجوز هذا القول
   * باب ما جاء في الجناءز
  * سالت الشافعي عن الصلاة علي الميت الغاءب وعلي القبر فقال استحبها فقلت له وما الحجة فيها قال اخبرنا مالك عن بن شهاب عن سعيد بن المسيب عن ابي هريرة قال نعي رسول الله صلي الله عليه وسلم للناس النجاشي اليوم الذي مات فيه وخرج بهم الي المصلي فصف وكبر اربع تكبيرات ( قال الشافعي ) رحمه الله اخبرنا مالك عن بن شهاب عن ابي امامة ان رسول الله صلي الله عليه وسلم صلي علي قبر مسكينة توفيت من الليل قال وقد روي عطاء ان النبي صلي الله عليه وسلم صلي علي قوم ببلد اخر قلت للشافعي نحن نكره الصلاة علي ميت غاءب وعلي القبر فقال فقد رويتم عن النبي صلي الله عليه وسلم الصلاة علي النجاشي وهو غاءب ورويتم عن النبي صلي الله عليه وسلم انه صلي علي ميت وهو في القبر غاءب فكيف كرهتم ما فعل رسول الله صلي الله عليه وسلم ولقد حفظ عن رسول الله صلي الله عليه وسلم باسناد موصول من وجوه انه صلي علي قبور وصلت عاءشة علي قبر اخيها وغير واحد من اصحاب النبي صلي الله عليه وسلم من حديث الثقات غير مالك وانما الصلاة دعاء للميت وهو اذا كان ملففا بيننا يصلي عليه فانما ندعو بالصلاة بوجه علمنا فكيف لا ندعو له غاءبا وهو في القبر بذلك الوجه 
   * باب الصلاة علي الميت في المسجد
  * ( قال الشافعي ) اخبرنا مالك عن ابي النضر مولي عمر بن عبيد الله عن عاءشة ام المءمنين انها قالت ما صلي رسول الله صلي الله عليه وسلم علي سهيل بن بيضاء الا في المسجد قلت للشافعي فانا نكره الصلاة علي الميت في المسجد فقال ارويتم هذا انه صلي علي عمر في المسجد فكيف كرهتم الامر فيه وقد ذكره صاحبكم اذكر حديثا خالفه عن النبي صلي الله عليه وسلم فاخترتم احد الحديثين علي الاخر فقلت ما ذكر فيه شيءا علمناه ( قال الشافعي ) رحمه الله تعالي فكيف يجوز ان تدعوا ما رويتم عن النبي صلي الله عليه وسلم وعن اصحاب النبي انهم فعلوه بعمر وهذا عندكم عمل مجتمع عليه لانا لا نري من اصحاب النبي صلي الله عليه وسلم احدا حضرموت عمر فتخلف عن جنازته فتركتم هذا بغير شء رويتموه وكيف اجزتم ان ينام في المسجد ويمر فيه الجنب طريقا ولا يجوز ان يصلي فيه علي ميت ( اخبرنا الربيع ) مات سعيد فخرج ابو يعقوب البويطي وخرجنا معه فصف بنا وكبر اربعا وصلينا عليه وكان ابو يعقوب الامام فانكر الناس ذلك علينا وما بالينا
   * باب في فوت الحج
  * سالت الشافعي هل يحج احد عن احد قال نعم يحج عمن لا يقدر ان يثبت علي المركب والميت قلت وما الحجة قال اخبرنا مالك عن بن شهاب عن سليمان بن يسار عن بن عباس ان الفضل بن العباس كان رديف رسول الله صلي الله عليه وسلم فجاءته امراة من خثعم فقالت يا رسول الله ان فريضة الله في الحج ادركت ابي شيخا كبيرا لا يستطيع ان يثبت علي الراحلة افاحج عنه قال نعم وذلك في حجة الوداع ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن ايوب عن بن سيرين ان رجلا جعل علي نفسه ان لا يبلغ احد من ولده الحلب فيحلب فيشرب ويسقيه الا حج وحج به معه فبلغ رجل من ولده الذي قال الشيخ وقد كبر الشيخ فجاء ابنه الي رسول الله صلي الله عليه وسلم فاخبره الخبر فقال ان ابي قد كبر ولا يستطيع ان يحج افاحج عنه فقال رسول الله صلي الله عليه وسلم نعم قال الشافعي رحمه الله تعالي وذكر مالك او غيره عن ايوب عن بن سيرين عن بن عباس ان رجلا اتي النبي صلي الله عليه وسلم فقال يا رسول الله ان امي عجوز كبيرة لا تستطيع ان نركبها علي البعير وان ربطتها خفت ان تموت افاحج عنها قال نعم فقلت للشافعي فانا نقول ليس علي هذا العمل فقال خالفتم ما رويتم عن النبي صلي الله عليه وسلم من روايتكم ومن رواية غيركم علي بن ابي طالب يروي هذا عن النبي صلي الله عليه وسلم وبن المسيب والحسن عن النبي صلي الله عليه وسلم مثل معني هذه الاحاديث وعلي وبن عباس وبن المسيب وبن شهاب وربيعة بالمدينة يفتون بان يحج الرجل عن الرجل وهذا اشبه شء يكون مثله عندكم عملا فتخالفونه كله لغير قول احد من خلق الله علمته من اصحاب رسول الله صلي الله عليه وسلم وجميع من عدا اهل المدينة من اهل مكة والمشرق واليمن من اهل الفقه يفتون بان يحج الرجل عن الرجل فقلت للشافعي فان من حجة بعض من قال هذا القول انه قال انه روي عن بن عمر لا يصوم احد عن احد ولا يصلي احد عن احد فجعل الحج في معني الصيام والصلاة فقال الشافعي وهذا قول الضعف فيه بين من كل وجه قال ارايتم لو قال بن عمر لا يحج احد عن احد وقد امر النبي صلي الله عليه وسلم احدا ان يحج عن احد كان في قول احد حجة مع رسول الله صلي الله عليه وسلم وانتم تتركون قول بن عمر لراي انفسكم ولراي مثلكم ولراي بعض التابعين فتجعلونه لا حجة في قوله اذا شءتم لانكم لو كنتم ترون في قوله حجة لم تخالفوه لراي انفسكم ثم  تقيمون قوله مقاما تردون به السنة والاثار ثم تدعون في قوله ما ليس فيه من النهي عن الحج قياسا وما للحج والصلاة والصيام هذا شريعة وهذا شريعة فان قلتم قد يشتبهان لانه عمل علي البدن افرايتم ان قال لكم قاءل انتم تزعمون ان الحج في معني الصلاة والصوم وقد امر النبي صلي الله عليه وسلم امراة ان تحج عن ابيها فانا امر الرجل ان يصلي عن الرجل ويصوم عنه هل الحجة عليه الا انه لا تقاس شريعة علي شريعة فكذلك الحجة عليكم اورايتم ما فرقت بينه السنة مما هو اشد تقاربا منها فكيف فرقتم بينه فان قلتم ما هو قلت نهي النبي صلي الله عليه وسلم عن بيع الرطب بالتمر ونهي عن المزابنة واجاز بيع العرايا وهي داخلة في المزابنة وداخلة في بيع الرطب بالتمر لو لم يجزها فلما اجازها فرقنا بينهما بالسنة وقلنا تجوز العرايا وهي رطب بتمر وكيل بجزاف ولا يجوز ذلك اذا وضع بالارض فكان التمر والرطب في الارض معا فهذا اولي ان لا يفرق بينه بانه شء واحد (  ) بعضه حلال بما احله به رسول الله صلي الله عليه وسلم وبعضه منهي عنه بما نهي عنه رسول الله وقد خالف هذا بعض المشرقيين فراينا لنا عليهم بهذا حجة فالحجة عليكم بنصه ان يحج احد عن احد وانتم تروونه عن النبي صلي الله عليه وسلم ولا تروون عن احد من اصحابه خلافه ( قال الشافعي ) رحمه الله تعالي وكيف تقيسونه بالصوم والصلاة افرايتم اذا كنتم تجيزون ان يحج احد عن احد اذا ( ( ( اذ ) ) ) اوصي بذلك فخالفتم ما قلتم من ان لا يحج احد عن احد واجزتم مثل ما رددتم فيه السنة افيجوز لو اوصي ان يصلي عنه او يصام عنه فان اجزتموه فقد دخلتم فيما كرهتم من ان يكون عمل اخر لغيره وان لم تجيزوه فقد فرقتم بين الصلاة والصوم والحج والله اعلم
   * باب الحجامة للمحرم
  * سالت الشافعي عن الحجامة للمحرم فقال يحتجم ولا يحلق شعرا ويحتجم من غير ضرورة فقلت وما الحجة فقال اخبرنا مالك عن يحيي بن سعيد عن سليمان بن يسار ان النبي صلي الله عليه وسلم احتجم وهو محرم وهو يومءذ بلحي جمل ( قال الشافعي ) اخبرنا سفيان عن عمرو بن دينار عن عطاء وطاوس احدهما او كلاهما عن بن عباس ان النبي صلي الله عليه وسلم احتجم وهو محرم فقلت للشافعي فانا نقول لا يحتجم المحرم الا من ضرورة ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع عن بن عمر انه كان يقول لا يحتجم المحرم الا ان يضطر اليه مما لا بد له منه وقال مالك مثل ذلك قال الشافعي ما روي مالك عن النبي صلي الله عليه وسلم انه لم يذكر في حجامة النبي صلي الله عليه وسلم هو ولا غيره ضرورة اولي بنا من الذي رواه عن بن عمر ولعل بن عمر كره ذلك ولم يحرمه ولعل بن عمر ان لا يكون سمع هذا عن النبي صلي الله عليه وسلم ولو سمعه ما خالفه ان شاء الله فقال برايه فكيف اذا سمعت هذا عن النبي صلي الله عليه وسلم قلت بخلاف ما سمعت عنه لقول بن عمر وانتم لم تثبتوا ان بن عمر كرهه للناس قد يتوقي المرء في نفسه ما لا يكره لغيره وانتم تتركون قول بن عمر لراي انفسكم افرايتم ان كرهتم الحجامة الا من ضرورة اتعدو الحجامة من ان تكون مباحة له كما يباح له الاغتسال والاكل والشرب فلا يبالي كيف احتجم اذا لم يقطع الشعر او تكون محظورة عليه كحلاق الشعر وغيره فالذي لا يجوز له الا لضرورة فهو اذا فعله بحلق الشعر او فعل ذلك من ضرورة افتدي فينبغي ان تقولوا اذا احتجم من ضرورة ان يفتدي والا فانتم تخالفون ما جاء عن النبي صلي الله عليه وسلم وتقولون في الحجامة قولا متناقضا 
   * باب ما يقتل المحرم من الدواب
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع عن بن عمر ان رسول الله صلي الله عليه وسلم قال خمس من الدواب ليس علي المحرم في قتلهن جناح الغراب والحداة والعقرب والفارة والكلب العقور ( قال الشافعي ) رحمه الله تعالي وبهذا ناخذ وهو عندنا جواب علي المسالة فكل ما جمع من الوحش ان يكون غير مباح اللحم في الاحلال وان يكون مضرا قتله المحرم لان النبي صلي الله عليه وسلم اذا امر المحرم ان يقتل الفارة والغراب والحداة مع ضعف ضرها اذ كانت مما لا يءكل لحمه كان ما جمع ان لا يءكل لحمه وضره اكثر من ضرها اولي ان يكون قتله مباحا في الاحرام قلت قد قال مالك لا يقتل المحرم من الطير ما ضر الا ما سمي وقال بعض اصحابه كان قول النبي صلي الله عليه وسلم خمس من الدواب ليس علي المحرم في قتلهم جناح يدل علي ان ما سواهن علي المحرم في قتله جناح ( قال الشافعي ) رحمه الله افرايتم الحية اسميت فقد زعم مالك عن بن شهاب ان عمر امر بقتل الحيات في الحرم قلت فيراها كلبا عقورا قال او تعرف العرب ان الحية كلب عقور انما الكلب عندها السبع والكلاب التي خلقها الله متقاربة كخلق الكلب فان قلتم انها قد تضر فتقتل قيل غير مكابرة كما زعم صاحبكم ان الكلب العقور ما عدا علي الناس فاخافهم وهي لا تعدو مكابرة وان ذهبتم الي انها تضر هكذا فقد امر عمر بن الخطاب ان يقتل الزنبور في الاحرام والزنبور انما هو كالنحلة فكيف لم تامروا بقتل الزنبور وقد امر به عمر وامرتم بقتل الحية اذ امر بها عمر ما اسمعكم تاخذون من الاحاديث الا ما هويتم ( قال الشافعي ) رحمه الله تعالي وقلتم يقتل المحرم الفارة الصغيرة ولا يقتل الغراب الصغير واذا قلتم هذا فقد اباحه النبي صلي الله عليه وسلم ومنعتموه فان قلتم انما اباح قتله علي معني انه يضر والصغير لا يضر في حاله تلك فالفارة الصغيرة لا تضر في حالها تلك فلا بد ان تخالفوا النبي صلي الله عليه وسلم في الغراب الصغير والفارة الصغيرة وهذا حجة عليكم اذ ( ( ( ازعمتم ) ) ) زعمتم ان الغراب يقتل لمعني ضرره فينبغي ان تقتل العقاب لانها اضر منه فان قال لا بل الحديث جملة لا لمعني ( ( ( المعني ) ) ) قيل فلم لا يقتل الغراب الصغير لانه غراب سالت الشافعي عمن حلق قبل ان ينحر او نحر قبل ان يرمي قال يفعل ولا فدية ولا حرج وكذلك كل ما كان يعمل في ذلك اليوم فقدم منه شيءا قبل شء ناسيا او جاهلا عمل ما يبقي عليه ولا حرج فقلت وما الحجة في ذلك فقال اخبرنا مالك عن بن شهاب عن عيسي بن طلحة بن عبيد الله عن عبد ( ( ( عبيد ) ) ) الله بن عمرو بن العاص قال وقف رسول الله صلي الله عليه وسلم في حجة الوداع للناس بمني يسالونه فجاءه رجل فقال يا رسول الله لم اشعر فحلقت قبل ان اذبح قال اذبح ولا حرج فجاء رجل فقال يا رسول الله لم اشعر فنحرت قبل ان ارمي فقال ارم ولا حرج فما سءل رسول الله صلي الله عليه وسلم عن شء قدم ولا اخر الا قال افعل ولا حرج ( قال الشافعي ) رحمه الله وبهذا كله ناخذ
   * باب الشركة في البدنة
  * سالت الشافعي هل يشتري السبعة جزورا فينحرونها عن هدي احصار او تمتع قال نعم قلت وما الحجة في ذلك فقال اخبرنا مالك عن ابي الزبير المكي عن جابر قال نحرنا مع رسول الله صلي الله عليه وسلم بالحديبية البدنة عن سبعة والبقرة عن سبعة ( قال الشافعي ) رحمه الله تعالي واذا نحروا مع رسول الله صلي الله عليه وسلم عام الحديبية بدنة عن سبعة وبقرة عن سبعة والعلم يحيط انهم من اهل بيوتات شتي لا من اهل بيت  واحد فتجزء البدنة والبقرة عن سبعة متمتعين ومحصورين وعن كل سبعة وجبت علي كل واحد منهم شاة اذا لم يجدوا شاة وسواء اشتروها واخرج كل واحد منهم حصته من ثمنها او ملكوها باي وجه ما كان ملك ومن زعم انها تجزء عن سبعة لو وهبت لهم او ملكوها بوجه غير الشراء كانت المشتراة اولي ان تجزء عنهم قلت للشافعي فانا نقول لا تذبح البدنة الا عن واحد ولا البقرة وانما يذبحها الرجل عن نفسه واهل بيته فاما ان يخرج كل انسان منهم حصته من ثمنها ويكون له حصة من لحمها فلا وانما سمعنا لا يشترك في البدنة في النسك ( قال الشافعي ) رحمه الله تعالي وقد يجوز ان يقال لا يشترك في النسك ان يوجب الرجل النسيكة ثم يشرك فيها غيره وليس في هذا لاحد حجة لانه كلام عربي ولا حجة مع النبي صلي الله عليه وسلم وهذا فعل النبي صلي الله عليه وسلم واصحابه اهل ( ( ( واهل ) ) ) الحديبية فكان ينبغي ان يكون هذا العمل عندكم لا تخالفونه لانه فعل النبي صلي الله عليه وسلم والف واربعماءة من اصحابه ( قال الشافعي ) اخبرنا سفيان عن عمرو عن جابر بن عبد الله قال كنا يوم الحديبية الفا واربعماءة وقال لنا النبي صلي الله عليه وسلم انتم اليوم خير اهل الارض قال جابر لو كنت ابصر لاريتكم موضع الشجرة وانتم تجعلون قول الواحد وفعله حجة في بعض الاشياء فاذا وجدتم السنة وفعل الف واربعماءة من اصحاب النبي صلي الله عليه وسلم فهو اوجب عليكم ان تجعلوه حجة
   * باب التمتع في الحج
  * سالت الشافعي عن التمتع بالعمرة الي الحج فقال حسن غير مكروه وقد فعل ذلك بامر النبي صلي الله عليه وسلم وانما اخترنا الافراد لانه ثبت ان النبي صلي الله عليه وسلم افرد غير كراهية للتمتع ولا يجوز اذا كان فعل التمتع بامر النبي صلي الله عليه وسلم ان يكون مكروها فقلت للشافعي وما الحجة فيما ذكرت قال الاحاديث الثابتة من غير وجه وقد حدثنا مالك بعضها ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن بن شهاب عن محمد بن عبد الله بن الحرث بن نوفل انه سمع سعد بن ابي وقاص والضحاك بن قيس عام حج معاوية بن ابي سفيان وهما يتذاكران التمتع بالعمرة الي الحج فقال الضحاك لا يصنع ذلك الا من جهل امر الله فقال سعد بءسما قلت يا بن اخي فقال الضحاك فان عمر قد نهي عن ذلك فقال سعد قد صنعها رسول الله وصنعناها معه فقلت للشافعي قد قال مالك قول الضحاك احب الي من قول سعد وعمر اعلم برسول الله صلي الله عليه وسلم من سعد ( قال الشافعي ) عمر وسعد عالمان برسول الله وما قال عمر عن رسول الله شيءا يخالف ما قال سعد انما روي مالك عن عمر انه قال افصلوا بين حجكم وعمرتكم فانه اتم لحج احدكم وعمرته ان يعتمر في غير اشهر الحج ولم يرو عنه انه نهي عن العمرة في اشهر الحج ( قال الشافعي ) اخبرنا مالك عن بن شهاب عن عروة عن عاءشة انها قالت خرجنا مع رسول الله عام حجة الوداع فمنا من اهل بحج ومنا من اهل بعمرة ومنا من جمع الحج والعمرة وكنت ممن اهل بعمرة ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر عن حفصة انها قالت للنبي صلي الله عليه وسلم ما شان الناس حلوا ولم تحل انت من عمرتك قال اني لبدت راسي وقلدت هديي فلا احل حتي انحر هديي ( قال الشافعي ) اخبرنا مالك عن صدقة بن يسار عن بن عمر انه قال لان اعتمر قبل الحج واهدي احب الي من ان اعتمر بعد الحج في ذي الحجة ( قال الشافعي ) رحمه الله تعالي فهذان الحديثان من حديث مالك موافقان ما قال سعد من انه عمل بالعمرة مع رسول الله صلي الله عليه وسلم في اشهر الحج فكيف جاز لكم وانتم ترون هذا ان تكرهوا العمرة فيه وانتم ( ( ( وان ) ) ) تثبتون ( ( ( تثبتوا ) ) ) عن النبي صلي الله عليه وسلم فيما وصفت وادعيتم من خلاف عمر وسعد وعمر لم يخالف سعدا عن  النبي صلي الله عليه وسلم انما اختار شيءا غير مخالف لما جاء عن النبي صلي الله عليه وسلم وقد تتركون انتم علي عمر اختياره وحكمه الذي هو اكثر من الاختيار لما جاء عن النبي صلي الله عليه وسلم ثم تتركونه لما جاء عن رجل من اصحاب رسول الله صلي الله عليه وسلم ثم تتركونه لقولكم فاذا جاز لكم هذا فكيف يجوز لكم ان تحتجوا بقوله علي السنة وانكم تدعون انه خالفها وهو لا يخالفها وما رويتم عنه يدل علي انه لا يخالفها فادعيتم خلاف ما رويتم وتخالفون اختياره
   * باب الطيب للمحرم
  * سالت الشافعي عن الطيب قبل الاحرام بما يبقي ريحه بعد الاحرام وبعد رمي الجمرة والحلاق قبل الافاضة فقال جاءز واحبه ولا اكرهه لثبوت السنة فيه عن رسول الله صلي الله عليه وسلم والاخبار عن غير واحد من اصحابه فقلت وما الحجة فيه فقال اخبرنا مالك عن عبد الرحمن بن القاسم عن ابيه عن عاءشة انها قالت كنت اطيب رسول الله صلي الله عليه وسلم لاحرامه قبل ان يحرم ولحله قبل ان يطوف بالبيت فقلت للشافعي فانا نكره الطيب للمحرم ونكره الطيب قبل الاحرام وبعد الاحلال قبل ان يطوف بالبيت ونروي ذلك عن عمر بن الخطاب فقال الشافعي اني اراكم لا تدرون ما تقولون فقلت ومن اين فقال ارايتم نحن وانتم باي شء عرفنا ان عمر قاله اليس انما عرفنا بان بن عمر رواه عن عمر فقلت بلي فقال وعرفنا ان النبي صلي الله عليه وسلم تطيب بخبر عاءشة فقلت بلي قال وكلاهما صادق فقلت نعم فاذا علمنا بان النبي صلي الله عليه وسلم تطيب وان عمر نهي عن الطيب علما واحدا هو خبر الصادقين عنهما معا فلا احسب احدا من اهل العلم يقدر ان يترك ما جاء عن النبي صلي الله عليه وسلم لغيره فان جاز ان يتهم الغلط علي بعض من بيننا وبين النبي صلي الله عليه وسلم ممن حدثنا جاز مثل ذلك علي من بيننا وبين عمر ممن حدثنا بل من روي عن عاءشة تطيب النبي صلي الله عليه وسلم اكثر ممن روي عن بن عمر نهي عمر عن الطيب روي عن عاءشة سالم والقاسم وعروة والاسود بن يزيد وغيرهم ( قال الشافعي ) رحمه الله تعالي فاراكم اذا اصبتم لم تعقلوا من اين اصبتم واذا اخطاتم لم تعرفوا سنة تذهبون اليها فتعذروا بان تكونوا ذهبتم الي مذهب بل اراكم انما ترسلون ما جاء علي السنتكم عن غير معرفة انما كان ينبغي ان تقولوا من كره الطيب للمحرم انما نهي عن الطيب انه حضر النبي صلي الله عليه وسلم بالجعرانة حين ساله اعرابي احرم وعليه جبة وحلوق ( ( ( وخلوق ) ) ) فامره بنزع الجبة وغسل الصفرة فقلت للشافعي افتري لنا بهذا حجة او انما هذا شبهة وما الحجة علي من قال هذا قال ان كان قاله بهذا فقد ذهب عليه ان النبي صلي الله عليه وسلم تطيب فقال بما حضر وتطيب النبي صلي الله عليه وسلم في حجة الاسلام سنة عشر وامر الاعرابي قبل ذلك بسنتين في سنة ثمان فلو كانا مختلفين كان اباحته التطيب ناسخا لمنعه وليسا بمختلفين انما نهي النبي صلي الله عليه وسلم ان يتزعفر الرجل ( قال الشافعي ) رحمه الله تعالي اخبرنا بن علية عن عبد العزيز بن صهيب عن انس بن مالك ان النبي صلي الله عليه وسلم نهي ان يتزعفر الرجل ( قال الشافعي ) وامر الرجل ان يغسل الزعفران عنه وقد تطيب سعد بن ابي وقاص وبن عباس للاحرام وكانت الغالية تري في مفارق بن عباس مثل الرب ( قال الشافعي ) رحمه الله تعالي اخبرنا بن عيينة عن عمرو ( ( ( عمر ) ) ) بن دينار عن سالم بن عبد الله قال قال عمر من رمي الجمرة فقد حل ما حرم عليه الا النساء والطيب وقال سالم قالت عاءشة طيبت رسول الله صلي الله عليه وسلم بيدي وسنة رسول الله صلي الله عليه وسلم احق ان تتبع ( قال الشافعي ) رحمه الله تعالي وهكذا ينبغي ان يكون الصالحون من اهل العلم فاما ما تذهبون اليه من ترك  السنة لغيرها وترك ذلك الغير لراي انفسكم فالعلم اذا اليكم تاتون منه ما شءتم وتدعون منه ما شءتم تاخذون بلا تبصر لما تقولون ولا حسن روية فيه ارايتم اذا خالفتم السنة هل عرفتم ما قلتم كرهتم الطيب قبل الاحرام لانه يبقي بعد الاحرام وقد كان الطيب حلالا فاذا كرهتموه اذا كان يبقي بعد الاحرام فلا وجه لقولكم الا ان تقولوا وجدناه اذا كان محرما ممنوعا ان يبتدء طيبا فاذا تطيب قبل ان يحرم فما يبقي كان كابتداء الطيب في الاحرام قلت فانتم تجيزون بان يدهن المحرم بما يبقي لينه وذهابه الشعث ويرجل الشعر قال وما هو قلت ما لا طيب فيه مثل الزيت والشيرق وغيره قال هذا لا يصلح للمحرم ان يبتدء الادهان به ولو فعل وجبت عليه كفارة المتطيب عندنا وعندكم وانما كان ينبغي ان تقولوا لا يدهن بشء يبقي في راسه لينه ساعة او تجيزوا الطيب اذا كان قبل الاحرام ولو لم يكن في هذا سنة تتبع انبغي ان لا يقال الا واحد من هذين القولين
   * باب في العمري
  * قال سالت الشافعي عمن اعمر عمري له ولعقبه فقال هي للذي يعطاها لا ترجع الي الذي اعطاها فقلت وما الحجة فقال السنة الثابتة من حديث الناس وحديث مالك عن النبي صلي الله عليه وسلم قال اخبرنا مالك عن بن شهاب عن ابي سلمة بن عبد الرحمن عن جابر ان رسول الله صلي الله عليه وسلم قال ايما رجل اعمر عمري له ولعقبه فانما هي للذي يعطاها لا ترجع الي الذي اعطي لانه اعطي عطاء وقعت فيه المواريث قال وبها ناخذ وياخذ عامة اهل العلم في جميع الامصار بغير المدينة واكابر اهل العلم وقد روي هذا مع جابر بن عبد الله زيد بن ثابت عن النبي صلي الله عليه وسلم فقلت للشافعي فانا نخالف هذا فقال اتخالونه ( ( ( اتخافونه ) ) ) وانتم تروونه عن رسول الله صلي الله عليه وسلم فقلت ان حجتنا فيه ان مالكا قال اخبرنا يحيي بن سعيد عن عبد الرحمن بن القاسم انه سمع مكحولا الدمشقي يسال القاسم بن محمد عن العمري وما يقول الناس فيها فقال له القاسم ما ادركت الناس الا وهم علي شروطهم في اموالهم وفيما اعطوا ( قال الشافعي ) رحمه الله تعالي ما اجابه القاسم عن العمري بشء وما اخبره الا ان الناس علي شروطهم فان ذهب الي ان يقول العمري من المال والشرط فيها جاءز فقد شرط الناس في اموالهم شروطا لا تجوز لهم فان قال قاءل وما هي قيل الرجل يشتري العبد علي ان يعتقه والولاء للباءع فيعتقه فهو حر والولاء للمعتق والشرط باطل فان قال السنة تدل علي ابطال هذا الشرط قلنا والسنة تدل علي ابطال الشرط في العمري فلم اخذت بالسنة مرة وتركتها مرة قول القاسم لو كان قصد به قصد العمري فقال انهم علي شروطهم فيها لم يكن في هذا ما يرد به الحديث عن النبي صلي الله عليه وسلم فان قال قاءل ولم قيل نحن لا نعلم ان القاسم قال هذا الا بخبر يحيي عن عبد الرحمن عنه وكذلك علمنا قول النبي صلي الله عليه وسلم في العمري بخبر بن شهاب عن ابي سلمة عن جابر عن النبي صلي الله عليه وسلم وغيره فاذا قبلنا خبر الصادقين فمن روي هذا عن النبي صلي الله عليه وسلم ارجح ممن روي هذا عن القاسم لا يشك عالم ان ما ثبت عن رسول الله صلي الله عليه وسلم اولي ان يقال به مما قاله اناس بعده قد يمكن ان لا يكونوا سمعوا من رسول الله ولا بلغهم عنه شء وانهم لناس لا نعرفهم فان قال قاءل لا يقول القاسم قال الناس الا لجماعة من اصحاب رسول الله او من اهل العلم لا يجهلون للنبي صلي الله عليه وسلم سنة ولا يجمعون ابدا من جهة الراي ولا يجمعون الا من جهة السنة قيل له اخبرنا مالك عن يحيي بن سعيد عن القاسم بن محمد ان رجلا كانت عنده وليدة لقوم فقال لاهلها شانكم بها فراي الناس انها تطليقة وانتم تزعمون انها ثلاثة فاذا قيل لكم تتركون قول القاسم والناس انها تطليقة قلتم لا ندري من الناس الذين يروي هذا عنهم القاسم فان لم يكن قول القاسم والناس حجة  عليكم في راي انفسكم لهو عن ان يكون علي رسول الله صلي الله عليه وسلم حجة ابعد ولءن كان حجة لعله اخطاتم بخلافكم اياه برايكم وانا لنحفظ عن بن عمر في العمري مثل قول رسول الله صلي الله عليه وسلم ( قال الشافعي ) رحمه الله اخبرنا سفيان عن عمرو بن دينار وحميد الاعرج عن حبيب بن ابي ثابت قال كنت عند بن عمر فجاءه رجل من اهل البادية فقال اني وهبت لابني ناقة حياته وانها تناتجت ابلا فقال بن عمر هي له حياته وموته فقال اني تصدقت عليه بها قال ذلك ابعد لك منها ( قال الشافعي ) رحمه الله تعالي اخبرنا سفيان بن عيينة عن بن ابي نجيح عن حبيب بن ابي ثابت مثله الا انه قال اضنت واضطربت يعني كبرت واضطربت ( قال الشافعي ) اخبرنا سفيان عن عمرو عن سليمان بن يسار ان طارقا قضي بالمدينة بالعمري عن قول جابر بن عبد الله عن النبي صلي الله عليه وسلم ( قال الشافعي ) اخبرنا سفيان عن عمرو ( ( ( عمرة ) ) ) عن طاوس عن حجر المدري عن زيد بن ثابت ان النبي صلي الله عليه وسلم قال العمري للوارث ( قال الشافعي ) اخبرنا سفيان عن بن جريج عن عطاء بن ابي رباح عن جابر ان رسول الله صلي الله عليه وسلم قال لا تعمروا ولا ترقبوا فمن اعمر شيءا او ارقبه فسبيله سبيل الميراث ( قال الشافعي ) رحمه الله تعالي اخبرنا سفيان عن ايوب عن بن سيرين قال حضرت شريحا قضي لاعمي بالعمري فقال له الاعمي يا ابا امية بما قضيت لي فقال له شريح لست انا قضيت لك ولكن محمد صلي الله عليه وسلم قضي لك منذ اربعين سنة قال من ( ( ( ومن ) ) ) اعمر شيءا حياته فهو لورثته اذا مات ( قال الشافعي ) فتتركون ما وصفت من العمري مع ثبوته عن رسول الله صلي الله عليه وسلم وقول زيد بن ثابت وجابر بن عبد الله وبن عمر وسليمان بن يسار وعروة بن الزبير وهذا عندكم عمل بعد النبي صلي الله عليه وسلم لتوهم في قول القاسم وانتم تجدون في قول القاسم افتي في رجل قال لامة قوم شانكم بها فراي الناس انها تطليقة ثم تخالفونه برايكم وما روي القاسم عن الناس والله اعلم
   * باب ما جاء في العقيقة
  * ( قال الشافعي ) اخبرنا مالك عن يحيي بن سعيد عن محمد بن ابراهيم بن الحرث التيمي قال تستحب العقيقة ولو بعصفور قلت للشافعي فانا نقول ليس عليه العمل ولا نلتفت الي قول تستحب قال قد يمكن ان لا يكون استحبها الا اهل العلم بالمدينة ( قال الشافعي ) اخبرنا الثقفي عن يحيي بن سعيد عن سليمان بن يسار ان الناس كانوا يقضون في المجوس بثمانماءة درهم وان اليهود والنصاري اذا اصيبوا يقضي لهم بقدر ما يعقلهم قومهم فيما بينهم قلت فانا نقول في اليهودي والنصراني نصف دية المسلم ولا نلتفت الي رواية سليمان بن يسار ان الناس ( قال الشافعي ) سليمان مثل القاسم في السن او اسن منه فان كانت لكم حجة بقول القاسم الناس فهي عليكم بقول سليمان بن يسار الزم لانه لا يثبت عن النبي صلي الله عليه وسلم في اليهودي والنصراني قول
   * باب في الحربي يسلم
  * سالت الشافعي عن المشركين الوثنيين الحربيين يسلم الزوج قبل المراة او المراة قبل الزوج اقام المسلم منهما في دار الاسلام او خرج فقال ذلك كله سواء ولا يحل للزوج اصابتها (  ) ولا له ان يصيبها اذا كان واحدا ( ( ( واحد ) ) ) منهما مسلما ونظرتهما انقضاء العدة فان انقضت عدة المراة قبل ان يسلم الزوج انقطعت العصمة بينهما وكذلك ولو كان  الزوج المسلم فانقضت عدة المراة قبل ان تسلم هي انقطعت العصمة بينهما لا اختلاف بين الزوج والمراة في ذلك فقلت له علام اعتمدت في هذا فقال علي ما لا اعلم من اهل العلم بالمغازي في هذا اختلافا من ان ابا سفيان اسلم قبل امراته وان امراة صفوان وعكرمة اسلمتا قبلهما ثم استقروا علي النكاح وذلك ان اخرهم اسلاما اسلم قبل انقضاء عدة المراة وفيه احاديث لا يحضرني ذكرها وقد حضرني منها حديث مرسل وذلك ان مالكا اخبرنا عن بن شهاب ان صفوان بن امية هرب من الاسلام ثم اتي النبي صلي الله عليه وسلم وشهد حنينا والطاءف مشركا وامراته مسلمة واستقرا علي النكاح قال بن شهاب فكان بين اسلام صفوان وامراته نحو من شهر فقلت له ارايت ان قلت مثل اذا اسلمت قبل زوجها خرجت من الدار او لم تخرج ثم اسلم الزوج فهما علي النكاح ما لم تنقض العدة واذا اسلم الزوج قبل المراة وقعت الفرقة بينهما اذا عرض عليها الاسلام فلم تسلم لان الله تبارك وتعالي يقول @QB@ ولا تمسكوا بعصم الكوافر @QE@ قال الشافعي اذا يدخل عليكم والله اعلم خلاف التاويل والاحاديث والقياس وما القول في رجل يسلم قبل امراته والمراة قبل زوجها الا واحد من قولين انتم قوم لم تعرفوا فيه الاحاديث او عرفتموها فرددتموها بتاويل القران فاذا تاولتم قول الله @QB@ ولا تمسكوا بعصم الكوافر @QE@ لم تعدوا ان تكونوا اردتم بقوله تبارك وتعالي انه اذا اسلم الزوج انقطعت العصمة بينهما مكانه وانتم لم تقولوا بهذا وزعمتم ان العصمة انما تنقطع ( ( ( تقطع ) ) ) بينهما اذا عرض علي الزوجة الاسلام فابت وقد يعرض عليها الاسلام من ساعتها ويعرض عليها بعد سنة واكثر فليس هذا بظاهر الاية ولم تقولوا في هذا بخبر ولا يجوز ان يقال بغير ظاهر الاية الا بخبر لازم فقلت فان قلت يعرض عليها الاسلام من ساعتها ( قال الشافعي ) افليس يقيم بعد اسلامه قبل يفرق بينهما او رايتم ان كانت غاءبة عن موضع اسلامه او بكماء لا تكلم او مغمي عليها فان قلتم تطلق فقد تركتم العرض وان قلتم ينتظر بها فقد اقامت في حباله وهي كافرة ( قال الشافعي ) رحمه الله تعالي والاية في الممتحنة مثلها قال الله تعالي @QB@ فان علمتموهن مءمنات فلا ترجعوهن الي الكفار لا هن حل لهم ولا هم يحلون لهن @QE@ فسوي بينهما وكيف فرقتم بينهما ( قال الشافعي ) هذه الاية في معني تلك لا تعدو هاتان الايتان ان تكونا تدلان علي انه اذا اختلف دينا الزوجين فكان لا يحل للزوج جماع زوجته لاختلاف الدينين فقد انقطعت العصمة بينهما او يكون لا يحل له في تلك الحال ويتم انقطاع العصمة ان جاءت عليها مدة ولم يسلم المتخلف عن الاسلام منهما فان كان هذا المعني لم يصلح ان تكون المدة الا بخبر يلزم لان رجلا لو قال مدتهما ستة اشهر او يوم لم يجز هذا من قبل الراي انما يجوز من جهة الاخبار اللازمة فلما سن رسول الله صلي الله عليه وسلم في امراة ابي سفيان وكان ابو سفيان قد اسلم هو وامراته هند مقيمة بمكة وهي دار حرب لم تسلم وامرت بقتله ثم اسلمت بعد ايام فاستقرا علي النكاح وهرب عكرمة بن ابي جهل وصفوان بن امية من الاسلام واسلمت زوجتاهما ثم اسلما فاستقرا علي النكاح وكان بن شهاب حمل احد الحديثين او هما معا فذكر فيه توقيت العدة دل ذلك علي انقطاع العصمة بين الزوجين ان انقضت العدة قبل ان يسلم المتخلف عن الاسلام منهما لا ان انقطاع العصمة هو ان يكون احدهما مسلما ويكون الفرج ممنوعا حين يسلم ( قال الشافعي ) رحمه الله تعالي فقيل لبعض من يذهب الي التفريق بين الزوج يسلم قبل المراة والمراة تسلم قبل الزوج اتجهلون امراة ابي سفيان قالوا لا ولكن كان الذي بين اسلامهما يسيرا قيل اما علمتم ان ابا سفيان قد اسلم وقد اقامت هند علي الكفر ثم اسلمت فاستقرا ( ( ( فاستقر ) ) ) علي النكاح قال بلي قيل او ليس بقيت عقدته عليها وقد اسلم قبلها قال بلي قيل فلو كان معني الاية @QB@ ولا تمسكوا بعصم الكوافر @QE@ علي انه متي اسلم حرمت كنتم قد خالفتم الاية وقولكم وعلمتم ان السنة في هند علي غير ما قلتم واذا كان @QB@ ولا تمسكوا بعصم الكوافر @QE@  الكوافر جاءت عليهم مدة لم تسلم فيها فالمدة لا تجوز الا بخبر يلزم مثله ( قال الشافعي ) وانتم اذا قلتم لا يفسخ بينهما حتي يعرض عليها الاسلام فتاباه فاذا عرض عليها الاسلام فابته انفسخ النكاح قيل فاذا كانت ببلاد ناءية فاذا انقضت عدتها انفسخ النكاح وان لم يعرض عليها الاسلام وهذا خارج من الوجهين والمعقول ان كان يقطع العصمة ان يسلم الزوج قبلها انبغي ان نخرجها من يده قبل عرض الاسلام وان كان ذلك بمدة فالمدة التي نذهب اليها نحن وانتم العدة
   * باب في اهل دار الحرب
  * سالت الشافعي عن اهل الدار من اهل الحرب يقتسمون الدار ( ( ( الدور ) ) ) ويملك بعضهم علي بعض علي ذلك القسم ويسلمون ثم يريد بعضهم ان ينقض ذلك القسم ويقسمه علي قسم الاسلام فقال ليس ذلك له قلت ما الحجة في ذلك قال الاستدلال بمعني الاجماع والسنة قلت واين ذلك قال ارايت اهل دار الحرب اذا سبي بعضهم بعضا وغصب بعضهم بعضا وقتل بعضهم بعضا ثم اسلموا اهدرت الدماء واقررت الارقاء في يدي من اسلموا وهم رقيق لهم والاموال لانهم ملكوها عليهم قبل الاسلام فاذا ملكوا بقسم الجاهلية فما ذلك الملك باحق واولي ان يثبت لمن ملكه من ملك الغصب والاسترقاق لمن كان حرا ( ( ( جرا ) ) ) مع انه اخبرنا مالك عن ثور بن يزيد الديلي انه قال بلغني ان رسول الله صلي الله عليه وسلم قال ايما دار او ارض قسمت في الجاهلية فهي علي قسم الجاهلية وايما دار او ارض ادركها الاسلام لم تقسم فهي علي قسم الاسلام ( قال الشافعي ) نحن نروي فيه حديثا اثبت من هذا بمثل معناه
   * باب البيوع
  * سالت الشافعي عن الرجل ياتي بذهب الي دار الضرب فيعطيها الضراب بدنانير مضروبة ويزيده علي وزنها قال هذا الربا بعينه المعجل قلت وما الحجة قال اخبرنا مالك عن موسي بن ابي تميم عن سعيد بن يسار عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال الدينار بالدينار والدرهم بالدرهم لا فضل بينهما ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع عن بن عمر ان عمر قال لا تبيعوا الذهب بالذهب الا مثلا بمثل ولا تشفوا بعضها علي بعض ولا تبيعوا الورق بالورق الا مثلا بمثل ولا تشفوا بعضها علي بعض فقلت للشافعي فانا نزعم انه لا باس بهذا قال فهذا الذي نهي عنه النبي صلي الله عليه وسلم بعينه فكيف اجزتموه قال هذا من ضرب قولكم في اللحم انه لا باس ان يباع بعضه ببعض بغير وزن بالبادية وحيث ليس موازين فان كان اللحم من الطعام الذي نهي عنه الا مثلا بمثل فقد اجزتموه وان لم يكن منه فلم تحرمونه في القرية وتجيزونه في البادية وانتم لا تجيزون بالبادية تمرا بتمر الا مثلا بمثل وان لم يكن في البادية مكيال واجزتم هذا في الخبز ان يباع بعضه ببعض بغير وزن اذا تحري في القرية والبادية وفي البيض وما اشبهه
   * باب متي يجب البيع
  * سالت الشافعي متي يجب البيع حتي لا يكون للباءع نقضه ولا للمشتري نقضه الا من عيب قال اذا تفرق المتبايعان بعد عقدة البيع من المقام الذي تبايعا فيه فقلت وما الحجة في ذلك قال اخبرنا مالك عن نافع عن بن عمر ان رسول الله صلي الله عليه وسلم قال المتبايعان كل واحد منهما بالخيار علي صاحبه ما لم يتفرقا الا ببيع ( ( ( بيع ) ) ) الخيار فقلت له فانا نقول  ليس لذلك عندنا حد معروف ولا امر معمول به فيه ( قال الشافعي ) الحديث بين لا يحتاج الي تاويل ولكني احسبكم التمستم العذر من الخروج منه بتجاهل كيف وجه الحديث واي شء فيه يخفي عليه قد زعمتم ان عمر قال لمالك بن اوس حين اصطرف من طلحة بن عبيد الله بماءة دينار فقال له طلحة انظرني حتي ياتي خازني من الغابة فقال لا والله لا تفارقه حتي تقبض منه فزعمتم ان الفراق فراق الابدان فكيف لم تعلموا ان النبي صلي الله عليه وسلم قال المتبايعان بالخيار ما لم يتفرقا ان الفراق فراق الابدان فان قلتم ليس هذا اردنا انما اردنا ان يكون عمل به بعده فابن عمر الذي سمعه من النبي صلي الله عليه وسلم كان اذا ابتاع الشء يعجبه ان يجب له فارق صاحبه فمشي قليلا ثم رجع اخبرنا بذلك سفيان عن بن جريج عن نافع عن بن عمر وقد خالفتم النبي صلي الله عليه وسلم وبن عمر جميعا
   * باب بيع البرنامج 
  * سالت الشافعي عن بيع الساج المدرج والقبطية وبيع الاعدال علي البرنامج علي انه واجب بصفة او غير صفة قال لا يجوز من هذا شء الا لمشتريه الخيار اذا راه قلت وما الحجة في ذلك قال اخبرنا مالك عن محمد بن يحيي بن حبان وعن ابي الزناد عن الاعرج عن ابي هريرة ان رسول الله صلي الله عليه وسلم نهي عن الملامسة والمنابذة فقلت للشافعي فانا نقول في الساج المدرج والقبطي المدرج لا يجوز بيعهما لانهما في معني الملامسة ونزعم ان بيع الاعدال علي البرنامج يجوز ( قال الشافعي ) رحمه الله تعالي فالاعدال التي لا تري ادخل في معني الغرر المحرم من القبطية والساج يري بعضه دون بعض ولانه لا يري من الاعدال شء وان الصفقة تقع منها علي ثياب مختلفة فقلت للشافعي انما نفرق بين ذلك لان الناس اجازوه ( قال الشافعي ) رحمه الله تعالي ما علمت احدا يقتدي به في العلم اجازه فان قلتم انما اجزناه علي الصفة ( ( ( الصفقة ) ) ) فبيوع الصفات ( ( ( الصفقات ) ) ) لا تجوز الا مضمونة علي صاحبها بصفة يكون عليه ان ياتي بها بكل حال وليس هكذا بيع البرنامج ارايت لو هلك المبيع ايكون علي باءعه ان ياتي بصفة مثله فان قلتم لا فهذا لا بيع عين ولا بيع صفة
   * باب بيع الثمر
  * سالت الشافعي عن بيع الثمر حتي يبدو صلاحه فقال اخبرنا مالك عن نافع عن بن عمر ان النبي صلي الله عليه وسلم نهي عن بيع الثمر حتي يبدو صلاحه نهي الباءع والمشتري ( قال الشافعي ) وبهذا ناخذ وفيه دلاءل بينة منها ان رسول الله صلي الله عليه وسلم اذ نهي عن بيع الثمر حتي يبدو صلاحه قال وصلاحه ان تري فيه الحمرة او الصفرة لان الافة قد تاتي عليه او علي بعضه قبل بلوغه او يجد بسرا وهو في الحال التي نهي عنها ظاهر يراه الباءع والمشتري كما كانا يريانه اذا رءيت فيه الحمرة بما وصفنا من معني ان الافة ربما كانت فقطعته او نقصته كانت كل ثمرة مثله لا يحل ان تباع ابدا حتي تزهي وتنضج منها ذلك وبهذا قلنا وقد قلتم بالجملة وقلنا لا يحل بيع القثاء ولا الخربز وان ظهر وعظم حتي يري فيه النضج ( قال الشافعي ) وقلنا فاذا لم يحل بيع القثاء والخربز حتي يري فيه النضج كان بيع ما لم يخرج من القثاء والخربز احرم لانه لم يبد صلاحه ولم يخلق ولا يدري لعله لا يكون فقلت للشافعي فانا نقول اذا ظهر شء من القثاء حل ان تباع ثمرته تلك وما خلق من القثاء ما نبت اصله ( قال الشافعي ) وقد نهي رسول الله صلي الله عليه وسلم عن بيع الثمر حتي يبدو صلاحه فلم اجزتم بيع شء لم يخلق بعد ونهي رسول الله  صلي الله عليه وسلم عن بيع السنين وبيع السنين بيع الثمر سنين فان زعمتم انه يجوز في النخل اذا طابت العام ان ثمرته قابلا فقد خالفتم ما روي عن النبي صلي الله عليه وسلم من الوجهين وان زعمتم ان بيع ثمرة لم تات لا يحل فكذلك كان ينبغي ان تقولوا في القثاء والخربز سالت الشافعي عن القثاء والخربز والفجل يشتري ايكون لمشتريه ان يبيعه قبل ان يقبضه فقال لا ولا يباع شء منه بشء منه متفاضلا يدا بيد قلت للشافعي وما الحجة في ذلك فقال اخبرنا مالك عن نافع عن بن عمر فقلت للشافعي فانا نقول كما قلت لا يباع حتي يقبض ولا باس بالفضل في بعضها علي بعض يدا بيد ولا خير فيه نسيءة ( قال الشافعي ) رحمه الله تعالي هذا خلاف السنة في بعض القول قلت ومن اين قال زعمتم انه لا يباع حتي يقبض وزعمتم انه لا يباع بعضها ببعض نسيءة وهذا في حكم الطعام من التمر والحنطة ثم زعمتم انه لا باس بالفضل في بعضها علي بعض يدا بيد وهذا خلاف حكم الطعام وهذا قول لا يقبل من احد من الناس اما ان تكون خارجة من الطعام فلا باس عندكم ان تباع قبل ان تقبض ويباع منها واحد بعشرة من صنفه نسيءة او تكون طعاما فلا يجوز الفضل في الصنف منها علي الاخر من صنفه يدا بيد
   * باب ما جاء في ثمن الكلب
  * سالت الشافعي عن الرجل يقتل الكلب للرجل فقال ليس عليه غرم فقلت وما الحجة في ذلك فقال اخبرنا مالك عن بن شهاب عن ابي بكر بن عبد الرحمن بن الحرث بن هشام عن ابي مسعود الانصاري ان النبي صلي الله عليه وسلم نهي عن الكلب ومهر البغي وحلوان الكاهن قال مالك وانما اكره بيع الكلاب الضواري وغير الضواري لنهي النبي صلي الله عليه وسلم عن ثمن الكلب ( قال الشافعي ) نحن نجيز للرجل ان يتخذ الكلاب الضواري ولا نجيز له ان يبيعها لنهي النبي صلي الله عليه وسلم واذا حرمنا ثمنها في الحال التي يحل اتخاذها فيه اتباعا لامر النبي صلي الله عليه وسلم لم يحل ان يكون لها ثمن بحال قلت للشافعي فانا نقول لو قتل رجل لرجل كلبا غرم له ثمنه فقال الشافعي هذا خلاف حديث رسول الله صلي الله عليه وسلم والقياس عليه وخلاف اصل قولكم كيف يجوز ان تغرموه ثمنه في الحال التي تفوت فيها نفسه وانتم لا تجعلون له ثمنا في الحال التي يحل ان ينتفع به فيها فان قال قاءل فان من المشرقيين من زعم انه اذا قتل ففيه ثمنه ويروي فيه اثرا ( ( ( اثر ) ) ) فاولءك يجيزون بيعه حيا ويردون الحديث الذي في النهي عن ثمنه ويزعمون ان الكلب سلعة من السلع يحل ثمنه كما يحل ثمن الحمار والبغل وان لم يءكل لحمهما للمنفعة فيهما ويقولون لو زعمنا ان ثمنه لا يحل زعمنا انه لا شء علي من قتله ويقولون اشباها لهذا كثيرة فيزعمون ان ماشية لرجل لو ماتت كان له ان يسلخ جلودها فيدبغها فاذا دبغت حل بيعها ولو استهلكها رجل قبل الدباغ لم يضمن لصاحبها شيءا لانه لا يحل ثمنها حتي تدبغ ويقولون في المسلم يرث الخمر او توهب له لا تحل له الا بان يفسدها فيجعلها خلا فاذا صارت خلا حل ثمنها ولو استهلكها مستهلك وهي خمر او بعد ما افسدت وقبل ان تصير خلا لم يضمن ثمنها في تلك الحال لان اصلها محرم ولم تصر خلا لانهم يعقلون ما يقولون وانما صاروا محجوجين بخلاف الحديث الذي ثبتناه نحن وانتم من ان رسول الله صلي الله عليه وسلم نهي عن ثمن الكلب وهم لا يثبتونه وانتم محجوجون بانكم لم تتبعوه وانتم تثبتونه ولا تجعلون للكلب ثمنا اذا كان حيا وتجعلون فيه ثمنا اذا كان ميتا او رايتم لو قال لكم قاءل لا اجعل له ثمنا اذا قتل لانه قد ذهبت منفعته واجيز ان يباع حيا ما كانت المنفعة فيه وكان حلالا ان يتخذ هل الحجة عليه الا ان يقال ما كان له مالك وكان له ثمن في حياته كان له ثمن وما لم يكن له ثمن في احدي الحالين لم يكن له ثمن في الاخري 
   * باب في الزكاة
  * ( قال الشافعي ) رحمه الله اخبرنا مالك بن انس عن عمرو بن يحيي عن ابيه عن ابي سعيد الخدري ان النبي صلي الله عليه وسلم قال ليس فيما دون خمسة اوسق صدقة قال وبهذا نقول وتقولون في الجملة ثم خالفتموه في معان وقد زعمتم وزعمنا ان لا يضم صنف طعام الي غيره لانا اذا ضممناها فقد اخذنا فيما دون خمسة اوسق فان في حديث النبي صلي الله عليه وسلم ما يبين انه لا يكون في خمسة اوسق صدقة حتي تكون من صنف واحد ثم زعمتم انكم تضمون الحنطة والسلت والشعير معا لان سعدا لم يجز الحنطة بالشعير الا مثلا بمثل ( قال الشافعي ) وقد قال النبي صلي الله عليه وسلم بيعوا الحنطة بالشعير كيف شءتم يدا بيد ولم يقل في السلت شيءا علمته والسلت غير الحنطة والتمر من الزبيب اقرب من السلت من الحنطة وانتم لا تضمون احدهما الي الاخر وزعمتم انكم تضمون القطنية كلها بعضها الي بعض وتزعمون ان حجتكم فيها ان عمر اخذ من القطنية العشر ونحن وانتم ناخذ من القطنية والحنطة والتمر والعشور افيضم بعض ذلك الي بعض واخذ عمر من الحنطة والزبيب نصف العشر افيضم الزبيب الي الحنطة ان هذا لاحالة عما جاء عن عمر وخلافه هذا قول متناقض انتم تحلون التفاضل اذا اختلف الصنفان فكيف حل لكم ان تضموها وهي عندكم مختلفة وكيف جاز لكم ان يحل فيها التفاضل وهي عندكم طعام من صنف واحد ما اعلم قولكم في القطنية والسلت والشعير الا خلافا للسنة والاثار والقياس
   * باب النكاح بولي
  * سالت الشافعي عن النكاح فقال كل نكاح بغير ولي فهو باطل فقلت وما الحجة في ذلك قال احاديث ثابتة فاما من حديث مالك فان مالكا اخبرنا عن عبد الله بن الفضل عن نافع بن جبير عن بن عباس عن النبي صلي الله عليه وسلم قال الايم احق بنفسها من وليها والبكر تستاذن في نفسها واذنها صماتها ( قال الشافعي ) اخبرنا مالك انه بلغه ان بن المسيب كان يقول قال عمر بن الخطاب لا تنكح المراة الا باذن وليها او ذي الراي من اهلها او السلطان ( قال الشافعي ) وثبتم هذا وقلتم لا يجوز نكاح الا بولي ونحن نقول فيه باحاديث من احاديث الناس اثبت من احاديثه وابين ( قال الشافعي ) اخبرنا مسلم بن خالد وعبد المجيد عن بن جريج عن سليمان بن موسي عن بن شهاب عن عروة عن عاءشة عن النبي صلي الله عليه وسلم انه قال ايما امراة نكحت بغير اذن وليها فنكاحها باطل ثلاثا ( قال الشافعي ) رحمه الله تعالي اخبرنا مسلم وسعيد عن بن جريج عن عكرمة قال جمع الطريق ركبا فيهم امراة ثيب فجعلت امرها بيد رجل فزوجها رجلا فجلد عمر الناكح والمنكح وفرق بينهما ( قال الشافعي ) اخبرنا مسلم عن بن خثيم عن سعيد بن جبير عن بن عباس قال لا نكاح الا بولي مرشد وشاهدي عدل ( قال الشافعي ) وهذا قول العامة بالمدينة ومكة قلت للشافعي نحن نقول في الدنية لا باس بان تنكح بغير ولي ونفسخه في الشريفة فقال الشافعي عدتم لما سددتم من امر الاولياء فنقضتموه فقلتم ( ( ( قلتم ) ) ) لا باس ان تنكح الدنية بغير ولي فاما الشريفة فلا ( قال الشافعي ) السنة والاثار علي كل امراة فمن امركم ان تخصوا الشريفة بالحياطة لها واتباع الحديث فيها وتخالفون الحديث عن النبي صلي الله عليه وسلم وعمن بعده في الدنية ارايتم لو قال لكم قاءل بل لا اجيز نكاح الدنية الا بولي لانها اقرب من ان تدلس بالنكاح وتصير الي المكروه من الشريفة التي تستحيي علي شرفها وتخاف من يمنعها اما كان اقرب الي ان يكون اصاب منكم فان الخطا في هذا القول لابين من ان يحتاج الي تبيينه ( ( ( تبينه ) ) ) باكثر من حكايته ( قال الشافعي ) النساء محرمات الفروج الا بما ابيحت به الفروج من النكاح بالاولياء والشهود والرضا  ولا فرق بين ما يحرم منهن وعليهن في شريفة ولا وضيعة وحق الله عليهن وفيهن كلهن واحد لا يحل لواحدة ( ( ( لواحد ) ) ) منهن ولا يحرم منها الا بما حل للاخري وحرم منها
   * باب ما جاء في الصداق
  * سالت الشافعي عن اقل ما يجوز من الصداق فقال الصداق ثمن من الاثمان فما تراضي به الاهلون في الصداق مما له قيمة فهو جاءز كما ما تراضي به المتبايعان مما له قيمة جاز قلت وما الحجة في ذلك قال السنة الثابتة والقياس والمعقول والاثار فاما من حديث مالك فاخبرنا مالك عن ابي حازم عن سهل بن سعد ان رجلا سال النبي صلي الله عليه وسلم ان يزوجه امراة فقال النبي صلي الله عليه وسلم التمس ولو خاتما من حديد فقال لا اجد فزوجه اياها بما معه من القران قلت للشافعي فانا نقول لا يكون صداق اقل من ربع دينار ونحتج فيه ان الله تبارك وتعالي يقول @QB@ وان طلقتموهن من قبل ان تمسوهن وقد فرضتم لهن فريضة فنصف ما فرضتم @QE@ وقال @QB@ واتوا النساء صدقاتهن نحلة @QE@ فاي شء يعطيها لو اصدقها درهما قلنا نصف درهم وكذلك لو اصدقها اقل من درهم كان لها نصفه قلت فهذا قليل ( قال الشافعي ) هذا شء خالفتم فيه السنة والعمل والاثار بالمدينة ولم يقله احد قبلكم بالمدينة علمناه وعمر بن الخطاب يقول ثلاث قبضات زبيب مهر وسعيد بن المسيب يقول لو اصدقها سوطا فما فوقه جاز وربيعة بن ابي عبد الرحمن يجيز النكاح علي نصف درهم واقل وانما تعلمتم هذا فيما نري من ابي حنيفة ثم اخطاتم قوله لان ابا حنيفة قال لا يكون الصداق اقل مما تقطع ( ( ( نقطع ) ) ) فيه اليد وذلك عشرة دراهم فقيل لبعض من يذهب مذهب ابي حنيفة او خالفتم ما روينا عن النبي صلي الله عليه وسلم ومن بعده فالي قول من ذهبتم فروي عن علي فيه شيءا لا يثبت مثله لو لم يخالفه غيره لا يكون مهر اقل من عشرة دراهم فانتم خالفتموه فقلتم يكون الصداق ربع دينار قال وقال بعض اصحاب ابي حنيفة انا استقبحنا ان يباح الفرج بشء يسير قلنا افرايت ان اشتري رجل جارية بدرهم يحل له فرجها قالوا نعم قلنا فقد ابحتم فرجا وزيادة رقبة بشء يسير فجعلتموها تملك رقبتها ويباح فرجها بدرهم واقل وزعمتم انه لا يباح فرجها منكوحة الا بعشرة دراهم او رايت عشرة دراهم لسوداء فقيرة ينكحها شريف اليست باكثر لقدرها من عشرة دراهم لشريفة غنية نكحها دنء فقير او رايتم وحين ذهبتم الي ما تقطع فيه اليد فجعلتم الصداق قياسا عليه اليس الصداق بالصداق اشبه منه بالقطع فقالوا الصداق خبر والقطع خبر لا ان احدهما قياس علي الاخر ولكنهما اتفقا علي العدد هذا تقطع فيه اليد وهذا يجوز مهرا فلو قال رجل لا يجوز صداق اقل من خمسماءة درهم لان ذلك صداق النبي صلي الله عليه وسلم وصداق بناته الا يكون اقرب منكم او قال رجل لا يحل ان يكون الصداق اقل من ماءتي درهم لان الزكاة لا تجب في اقل من ماءتي درهم الا يكون اقرب الي الصواب منكم وان كان كل واحد منكما غير مصيب واذا كان لا ينبغي هذا وما قلتم فلا ينبغي فيه الا اتباع السنة والقياس ارايتم ان كان الرجل يصدق المراة صداق مثلها عشرة دراهم الف درهم فيجوز ولا يكون له رده ويصدق المراة عشرة وصداق مثلها الاف فيجوز ولا يكون لها رد ذلك كما تكون البيوع يجوز فيها التغابن برضا المتبايعين فلم يكون هكذا فيما فوق عشرة دراهم ولا يكون هكذا فيما دون عشرة دراهم ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن يحيي بن سعيد عن سعيد بن المسيب ان عمر بن الخطاب قضي في المراة يتزوجها الرجل انه اذا ارخيت الستور فقد وجب الصداق ( قال الشافعي ) اخبرنا مالك عن بن شهاب ان زيد بن ثابت قال اذا دخل الرجل بامراته فارخيت عليهما الستور فقد وجب الصداق ( قال الشافعي ) ليس ارخاء الستور يوجب الصداق عندي لقول الله جل ثناءه @QB@ اذا نكحتم المءمنات ثم طلقتموهن من قبل ان تمسوهن @QE@ ولا نوجب الصداق الا بالمسيس قال وكذا روي عن بن عباس وشريح وهو معني القران 
   * باب في الرضاع
  * ( قال الشافعي ) اخبرنا مالك عن بن شهاب عن عروة بن الزبير ان رسول الله صلي الله عليه وسلم امر سهلة ابنة سهيل ان ترضع سالما خمس رضعات فيحرم بهن ( قال الشافعي ) اخبرنا مالك عن عبد الله بن ابي بكر بن محمد بن عمرو بن حزم عن عمرة عن عاءشة انها قالت كان فيما انزل الله في القران < عشر رضعات معلومات يحرمن > ثم نسخن بخمس معلومات فتوفي رسول الله صلي الله عليه وسلم وهن مما يقرا من القران ( قال الشافعي ) اخبرنا مالك عن نافع ان سالم بن عبد الله اخبره ان عاءشة زوج النبي صلي الله عليه وسلم ارسلت به وهو يرضع الي اختها ام كلثوم فارضعته ثلاث رضعات ثم مرضت فلم ترضعه غير ثلاث رضعات فلم يكن يدخل علي عاءشة من اجل ان ام كلثوم لم تكمل له عشر رضعات ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع عن صفية بنت ابي عبيد انها اخبرته ان حفصة ام المءمنين ارسلت بعاصم بن عبد الله بن سعد الي اختها فاطمة بنت عمر ترضعه عشر رضعات ليدخل عليها وهو صغير يرضع ففعلت فكان يدخل عليها ( قال الشافعي ) فرويتم عن عاءشة ان الله انزل كتابا ان يحرم من الرضاع بعشر رضعات ثم نسخن بخمس رضعات وان النبي صلي الله عليه وسلم توفي وهي مما يقرا من القران وروي عن النبي صلي الله عليه وسلم انه امر بان يرضع سالم خمس رضعات يحرم بهن ورويتم عن عاءشة وحفصة امي المءمنين مثل ما روت عاءشة وخالفتموه ورويتم عن بن المسيب ان المصة الواحدة تحرم فتركتم رواية عاءشة ورايها وراي حفصة بقول بن المسيب وانتم تتركون علي سعيد بن المسيب رايه براي انفسكم مع انه روي عن النبي صلي الله عليه وسلم مثل ما روت عاءشة وبن الزبير ووافق ذلك راي ابي هريرة وهكذا ينبغي لكم ان يكون عندكم العمل ( قال الشافعي ) اخبرنا انس بن عياض عن هشام بن عروة عن ابيه عن عبد الله بن الزبير ان النبي صلي الله عليه وسلم قال لا تحرم المصة ولا المصتان فقلت للشافعي اسمع بن الزبير من النبي صلي الله عليه وسلم فقال نعم وحفظه عنه وكان يوم توفي النبي بن تسع سنين
   * باب ما جاء في الولاء
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن هشام بن عروة عن ابيه عن عاءشة ان رسول الله صلي الله عليه وسلم قال انما الولاء لمن اعتق ( قال الشافعي ) اخبرنا مالك عن عبد الله بن دينار عن عبد الله بن عمر ان رسول الله صلي الله عليه وسلم نهي عن بيع الولاء وعن هبته ( قال الشافعي ) رحمه الله تعالي وبهذا اقول فقلت للشافعي انا نقول في الساءبة ولاءه للمسلمين وفي النصراني يعتق المسلم ولاءه للمسلمين ( قال الشافعي ) وتقولون في الرجل يسلم علي يدي الرجل او يلتقطه او يواليه لا يكون لواحد من هءلاء ولاء لان واحدا من هءلاء لم يعتق والعتق يقوم مقام النسب ثم تعودون فتخرجون من الحديثين واصل قولكم فتقولون اذا اعتق الرجل عبده ساءبة لم يكن له ولاءه واذا اعتق الذمي عبده المسلم لم يكن له ولاءه ( قال الشافعي ) رحمه الله تعالي ولا يعدو المعتق عبده ساءبة والنصراني يعتق عبده مسلما ان يكونا مالكين يجوز عتقهما فقد قال رسول الله صلي الله عليه وسلم الولاء لمن اعتق فمن قال لا ولاء لهذين فقد خالف ما جاء عن رسول الله صلي الله عليه وسلم واخرج الولاء من المعتق الذي جعله له رسول الله او يكون كل واحد منهما في حكم من لا يجوز له العتق اذا كانا لا يثبت لهما الولاء فاذا اعتق الرجل عبده ساءبة او النصراني عبده مسلما لم يكن واحد منهما حرا لانه لا يثبت لهما الولاء وانتم والله يعافينا واياكم  لا تعرفون ما تتركون ولا ما تاخذون فقد تركتم علي عمر انه قال للذي التقط المنبوذ ولاءه لك وتركتم علي ميمونة زوج النبي صلي الله عليه وسلم وبن عباس انها وهبته ولاء سليمان بن يسار وتركتم حديث عبد العزيز بن عمر عن النبي صلي الله عليه وسلم في الرجل يسلم علي يدي الرجل له ولاءه وقلتم الولاء لا يكون الا لمعتق ولا يزول بهبة ولا شرط عن معتق ثم زعمتم في الساءبة وله معتق وفي النصراني يعتق المسلم وهو معتق ان لا ولاء لهما فلو اخذتم ما اصبتم فيه بتبصر كان الساءبة والنصراني اولي ان تقولوا ولاء الساءبة لمن اعتقه والمسلم للنصراني اذا اعتقه وقد فرقتم بينهما كان ما خالفتموه لما خالف حديث النبي صلي الله عليه وسلم الولاء لمن اعتق اولي ان تتبعوه لان فيه اثارا مما لا اثر فيه
   * باب الافطار في شهر رمضان
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن بن شهاب عن حميد بن عبد الرحمن عن ابي هريرة ان رجلا افطر في رمضان فامره رسول الله صلي الله عليه وسلم ان يكفر بعتق رقبة او صيام شهرين او اطعام ستين مسكينا فقال اني لا اجد فاتي النبي صلي الله عليه وسلم بعرق فقال له خذ هذا فتصدق به فقال يا رسول الله ما اجد احوج مني فضحك رسول الله صلي الله عليه وسلم حتي بدت انيابه ثم قال كله ( قال الشافعي ) اخبرنا مالك عن عطاء الخرساني ( ( ( الخراساني ) ) ) عن سعيد بن المسيب ان اعرابيا جاء الي النبي صلي الله عليه وسلم فقال اصبت اهلي في رمضان وانا صاءم فقال رسول الله هل تستطيع ان تعتق رقبة قال لا قال فهل تستطيع ان تهدي بدنة قال لا قال فاجلس فاتي النبي صلي الله عليه وسلم بعرق فاعطاه اياه ( قال الشافعي ) رحمه الله بهذا نقول يعتق رقبة لا يجزيه غيرها اذا وجدها وكفارته كفارة الظهار وزعمتم ان احب اليكم ان لا تكفروا الا باطعام يا سبحان الله العظيم كيف تروون عن رسول الله صلي الله عليه وسلم شيءا تخالفونه ولا تخالفون الي قول احد من خلق الله ما راينا احدا قط في شرق ولا غرب قبلكم ولا بلغنا عنه انه قال مثل هذا وما لاحد خلاف رسول الله صلي الله عليه وسلم
   * باب في اللقطة
  * سالت الشافعي عمن وجد لقطة فقال يعرفها سنة ثم ياكلها ان شاء موسرا كان او معسرا فاذا جاء صاحبها ضمنها له فقلت له وما الحجة في ذلك قال السنة الثابتة وروي هذا عن رسول الله صلي الله عليه وسلم ابي بن كعب وامره النبي صلي الله عليه وسلم باكلها وابي من مياسير الناس يومءذ وقبل وبعد ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك بن انس عن ربيعة بن ابي عبد الرحمن عن يزيد مولي المنبعث عن زيد بن خالد الجهني انه قال جاء رجل الي رسول الله صلي الله عليه وسلم فساله عن اللقطة فقال اعرف عفاصها ووكاءها ثم عرفها سنة فان جاء صاحبها والا فشانك بها ( قال الشافعي ) اخبرنا مالك عن ايوب بن موسي عن معاوية بن عبد الله بن بدر الجهني ان اباه اخبره انه نزل منزل قوم بطريق الشام فوجد صرة فيها ثمانون دينارا فذكر ذلك لعمر بن الخطاب فقال له عمر عرفها علي ابواب المساجد واذكرها لمن يقدم من الشام سنة فاذا مضت السنة فشانك بها ( قال الشافعي ) فرويتم عن النبي صلي الله عليه وسلم ثم عن عمر انه اباح بعد سنة اكل اللقطة ثم خالفتم ذلك وقلتم نكره اكل  اللقطة (  ) للغني والمسكين ( قال الشافعي ) اخبرنا مالك عن نافع ان رجلا وجد لقطة فجاء الي عبد الله بن عمر فقال اني وجدت لقطة فماذا تري فقال له بن عمر عرفها قال قد فعلت قال زد قال قد فعلت قال لا امرك ان تاكلها ولو شءت لم تاخذها ( قال الشافعي ) فابن عمر لم يوقت في التعريف وقتا وانتم توقنون ( ( ( توقتون ) ) ) في التعريف سنة وبن عمر كره للذي وجد اللقطة اكلها غنيا كان او فقيرا وانتم ليس هكذا تقولون وبن عمر كره له اخذها وبن عمر كره له ان يتصدق بها وانتم لا تكرهون له اخذها بل تستحبونه وتقولون لو تركها ضاعت
   * باب المسح علي الخفين
  * سالت الشافعي عن المسح علي الخفين فقال يمسح المسافر والمقيم اذا لبسا علي كمال الطهارة فقلت وما الحجة قال السنة الثابتة وقد اخبرنا مالك عن بن شهاب عن عباد بن زياد وهو من ولد المغيرة بن شعبة عن المغيرة بن شعبة ان رسول الله صلي الله عليه وسلم ذهب لحاجته في غزوة تبوك ثم توضا ومسح علي الخفين وصلي ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع وعبد الله بن دينار انهما اخبراه ان عبد الله بن عمر قدم الكوفة علي سعد بن ابي وقاص وهو اميرها فراه يمسح علي الخفين فانكر ذلك عليه عبد الله بن عمر فقال له سعد خل اباك فساله فقال له عمر اذا ادخلت رجليك في الخفين وهما طاهرتان فامسح عليهما قال بن عمر وان جاء احدنا من الغاءط قال وان جاء احدكم من الغاءط اخبرنا مالك عن نافع ان بن عمر بال في السوق ثم توضا ومسح علي خفيه ثم صلي ( قال الشافعي ) اخبرنا مالك عن سعيد بن عبد الرحمن بن رقيش قال رايت انس بن مالك اتي قباء فبال وتوضا ومسح علي الخفين ثم صلي ( قال الشافعي ) فخالفتم ما روي صاحبكم عن عمر بن الخطاب وسعد بن ابي وقاص وعبد الله بن عمر وانس بن مالك وعروة بن الزبير وبن شهاب فقلتم لا يمسح المقيم وقد اخبرنا مالك عن هشام انه راي اباه يمسح علي الخفين ( قال الشافعي ) اخبرنا مالك عن بن شهاب قال يضع الذي يمسح علي الخفين يدا من فوق الخفين ويدا من تحت الخفين ثم يمسح فقلت للشافعي فانا نكره المسح في الحضر والسفر قال هذا خلاف ما رويتم عن النبي صلي الله عليه وسلم وخلاف العمل من اصحابه والتابعين بعدهم فكيف تزعمون انكم تذهبون الي العمل والسنة جميعا ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن بن شهاب عن بن المسيب ان رسول الله صلي الله عليه وسلم قال لليهود حين افتتح خيبر اقركم ما اقركم الله علي ان الثمر بيننا وبينكم فكان رسول الله صلي الله عليه وسلم يبعث بن رواحة فيخرص بينه وبينهم ثم يقول ان شءتم فلكم وان شءتم فلي
   * باب ما جاء في الجهاد
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن يحيي بن سعيد عن عمر بن كثير بن افلح عن ابي محمد مولي ابي قتادة الانصاري عن ابي قتادة الانصاري قال خرجنا مع رسول الله صلي الله عليه وسلم عام حنين فلما التقينا كانت للمسلمين جولة فرايت رجلا من المشركين قد علا رجلا من المسلمين قال فاستدرت له حتي اتيته من وراءه فضربته علي حبل عاتقه ضربة فاقبل علي فضمني ضمة وجدت منها ريح الموت ثم ادركه الموت فارسلني فلحقت عمر بن الخطاب فقلت له ما بال الناس فقال امر الله ثم ان الناس رجعوا فقال رسول الله صلي الله عليه وسلم من قتل قتيلا له عليه بينة فله سلبه فقمت فقلت من يشهد لي ثم جلست ثم قال النبي صلي الله عليه وسلم من قتل قتيلا له عليه بينة  في الثالثة فقمت فقال رسول الله صلي الله عليه وسلم ما لك يا ابا قتادة فاقتصصت عليه القصة فقال رجل صدق يا رسول الله وسلب ذلك القتيل عندي فارضه منه فقال ابو بكر لاها الله اذا لا يعمد الي اسد من اسد يقاتل عن الله فيعطيك سلبه فقال رسول الله صلي الله عليه وسلم صدق فاعطه اياه قال ابو قتادة فاعطانيه فبعت الدرع فابتعت به مخرفا في بني سلمة فانه لاول مال تاثلته في الاسلام قال مالك المخرف النخيل ( قال الشافعي ) وبهذا نقول السلب للقاتل في الاقبال وليس للامام ان يمنعه بحال لان اعطاء النبي صلي الله عليه وسلم السلب حكم منه وقد اعطي رسول الله السلب يوم حنين واعطاه ببدر واعطاه في غير موطن فقلت للشافعي فانا نقول انما ذلك علي الاجتهاد من الامام فقال تدعون ما روي عن النبي صلي الله عليه وسلم وهو يدل علي ان هذا حكم من النبي صلي الله عليه وسلم للقاتل فكيف ذهبتم الي انه ليس بحكم او رايتم ما روي عن النبي صلي الله عليه وسلم من انه اعطي من حضر اربعة اخماس الغنيمة فلو قال قاءل هذا من الامام علي الاجتهاد هل كانت الحجة عليه الا ان يقال اعطاء النبي صلي الله عليه وسلم علي العام والحكم حتي تاتي دلالة عن النبي صلي الله عليه وسلم بان قوله خاص فيتبع قول النبي صلي الله عليه وسلم فاما ان يتحكم متحكم فيدعي ان قولي النبي صلي الله عليه وسلم احدهما حكم والاخر اجتهاد بلا دلالة فان جاز هذا خرجت السنن من ايدي الناس فان قلتم لم يبلغنا ان النبي صلي الله عليه وسلم قال هذا الا يوم حنين ( قال الشافعي ) ولو لم يقله الا يوم حنين او اخر غزوة غزاها او اولي لكان اولي ما اخذ به والقول الواحد منه يلزم لزوم الاقاويل مع انه قد قال واعطاه ببدر وحنين وغيرهما وقولكم ذلك من الامام علي الاجتهاد فان لم يكن للقاتل وكان لمن حضر فكيف كان له ان يجتهد مرة فيعطيه ويجتهد اخري فيعطيه غيره واي شء يجتهد اذا ترك السنة انما الاجتهاد قياس علي السنة فاذا لزم الاجتهاد له صار تبعا للسنة وكانت السنة الزم له او كان يجوز له في هذا شء الا ما سن رسول الله او اجمع المسلمون عليه او كان قياسا عليه فقلت فهل خالفك في هذا غيرنا فقال نعم بعض الناس قلت فما احتج به ( قال الشافعي ) قال اذا قال الامام قبل لقاء العدو من قتل قتيلا فله سلبه فهو له وان لم يقله فالسلب من الغنيمة بين من حضر الوقعة اذا اخذ خمسة فقلت للشافعي فما كانت حجتك قال الحديث الذي روينا ان النبي صلي الله عليه وسلم قاله بعد تقضي حرب حنين لا قبل الوقعة فقلت قد خالف الحديث ( قال الشافعي ) وانتم قد خالفتموه فان كان له عذر بخلافه فهو اقرب للعذر منكم فان قلتم تاوله فكيف جاز له ان يتاول فيقول فلعل النبي انما اعطاه اياه من قبل انه قال ذلك قبل الوقعة فان قلت هذا تاويل قيل والذي قلت تاويل ابعد منه وقلت للشافعي ما رايت ما وصفت لك انا اخذنا به من الحديث المروي عن رسول الله صلي الله عليه وسلم اهو اصح رجالا واثبت عند اهل الحديث او ما سالناك عنه مما كنا نتركه من حديث رسول الله صلي الله عليه وسلم قبل نلقاك ( قال الشافعي ) عقل فيما زعمتم انكم تتركون من حديث النبي صلي الله عليه وسلم ما هو اثبت من الاكثر مما كنتم تاخذون به واولي ففي ما تركتم مثل ما اخذتم به والذي اخذتم به ما لا يثبته اهل الحديث فقلت مثل ماذا فقال مثل احاديث ارسلها عن النبي صلي الله عليه وسلم من حديث عمرو بن شعيب وغيره ومثل احاديث منقطعة فقلت فكيف اخذت بها قال ما اخذت بها الا لثبوتها من غير وجه من روايتكم ورواية اهل الصدق فقلت للشافعي ارجو ان اكون قد فهمت ما ذكرت من الحديث وصرت الي ما امرت به ورايت الرشد فيما دعيت اليه وعلمت ان بالعباد كما قلت الحاجة الي رسول الله صلي الله عليه وسلم ورايت في مذاهبنا ما وصفت من تناقضها والله اساله التوفيق وانا اسالك عما روينا في كتابنا الذي قدمنا علي الكتب عن اصحاب رسول الله صلي الله عليه وسلم ( قال الشافعي ) فسل منه عما حضرك وفقنا الله واياك لما يرضي وعصمنا  واياك بالتقوي وجعلنا نريده بما نقول ونصمت عنه انه علي ذلك قادر ( قال الشافعي ) رحمه الله اخبرنا مالك عن هشام بن عروة عن ابيه ان ابا بكر صلي الصبح فقرا فيها بسورة البقرة في الركعتين كلتاهما فقلت للشافعي فانا نكره للامام ان يقرا بقريب من هذا لان هذا يثقل قال افرايت ان قال لكم قاءل ابو بكر يقرا بسورة البقرة في الصبح في روايتكم في الركعتين معا واقل امره انه قسمها في الركعتين وانك تكره هذا فكيف رغبت عن قراءة ابي بكر واصحابه متوافرون صلي الله عليه وسلم وابو بكر من الاسلام واهله بالوضع الذي هو به وقد اخبرنا بن عيينة عن بن شهاب عن انس ان ابا بكر صلي بالناس الصبح فقرا بسورة البقرة فقال له عمر كربت الشمس ان تطلع فقال لو طلعت لم تجدنا غافلين ورويت عن عمر وعثمان تطويل القراءة وكرهتها كلها ( قال الشافعي ) اخبرنا مالك عن ابي عبيد مولي سليمان بن عبد الملك ان عبادة بن نسي اخبره انه سمع قيسا يقول اخبرني ابو عبد الله الصنابحي انه قدم المدينة في خلافة ابي بكر فصلي وراء ابي بكر المغرب فقرا في الركعتين الاوليين بام القران وسورة سورة من قصار المفصل ثم قام في الركعة الثالثة قد ( ( ( فدنوت ) ) ) دنوت منه حتي ان ثيابي لتكاد ان تمس ثيابه فسمعته قرا بام القران وهذه الاية @QB@ ربنا لا تزغ قلوبنا بعد اذ هديتنا @QE@ الاية قلت للشافعي فانا نكره القراءة في الركعتين الاخرتين ( ( ( الاخيرتين ) ) ) والركعة الاخري بشء غير ام القران فهل تستحبه انت فقال نعم وقال لي الشافعي فكيف تكرهونه وقد رويتموه عن ابي بكر وروي بن عيينة عن عمر بن عبد العزيز انه حين بلغه عن ابي بكر اخذ به ( قال الشافعي ) رحمه الله وقد اخبرنا مالك عن نافع عن بن عمر انه كان يقرا في الركعتين الاخيرتين بام القران وسورة ويجمع الاحيان السور في الركعة الواحدة فقلت للشافعي فهذا ايضا مما نكرهه فقال ارويتم عن بن عمر عن عمر انه قرا بالنجم فسجد فيها ثم قام فقرا سورة اخري فكيف كرهتم هذا وخالفتموهما معا فقلت للشافعي اتستحب انت هذا قال نعم وافعله
   * باب ما جاء في الرقية
  * سالت الشافعي عن الرقية فقال لا باس ان يرقي الرجل بكتاب الله وما يعرف من ذكر الله قلت ايرقي اهل الكتاب المسلمين فقال نعم اذا رقوا بما يعرف من كتاب الله او ذكر الله فقلت وما الحجة في ذلك قال غير حجة فاما رواية صاحبنا وصاحبك فان مالكا اخبرنا عن يحيي بن سعيد عن عمرة بنت عبد الرحمن ان ابا بكر دخل علي عاءشة وهي تشتكي ويهودية ترقيها فقال ابو بكر ارقيها بكتاب الله فقلت للشافعي فانا نكره رقية اهل الكتاب فقال ولم وانتم تروون هذا عن ابي بكر ولا اعلمكم تروون عن غيره من اصحاب النبي صلي الله عليه وسلم خلافه وقد احل الله جل ذكره طعام اهل الكتاب ونساءهم واحسب الرقية اذا رقوا بكتاب الله مثل هذا او اخف
   * باب في الجهاد
  * سالت الشافعي عن القوم يدخلون بلاد الحرب ايخربون العامر ويقطعون الشجر المثمر ويحرقونه والنخل والبهاءم او يكره ذلك كله ( قال الشافعي ) رحمه الله تعالي اما كل ما لا روح فيه من شجر مثمر وبناء عامر وغيره فيخربونه ويهدمونه ويقطعونه واما ذوات الارواح فلا يقتل منها شء الا ما كان يحل بالذبح ليءكل فقلت له وما الحجة في ذلك وقد كره ابو بكر الصديق ان يخرب عامرا او يقطع مثمرا او يحرق نخلا او يعقر شاة او بعيرا الا لماكلة  وانت اخبرتنا بذلك عن مالك عن يحيي بن سعيد ان ابا بكر الصديق اوصي يزيد بن ابي سفيان حين بعثه الي الشام فقال الشافعي هذا من حديث مالك منقطع وقد يعرفه اهل الشام باسناد احسن من هذا فقلت للشافعي وقد روي اصحابنا سوي هذا عن ابي بكر فباي شء تخالفه انت فقال بالثابت عن رسول الله صلي الله عليه وسلم انه حرق اموال بني النضير وقطع وهدم لهم وحرق وقطع بخيبر ثم قطع بالطاءف وهي اخر غزاة غزاها رسول الله صلي الله عليه وسلم فقاتل بها فقلت للشافعي فكيف كرهت عقر ذوات الارواح وتحريقها الا لتءكل فقال بالسنة ان رسول الله صلي الله عليه وسلم قال من قتل عصفورا بغير حقها حوسب بها قيل وما حقها قال يذبحها فياكلها ولا يقطع راسها فيلقيه فرايت اباحة قتل البهاءم الماكولة غير العدو منها في الكتاب والسنة انما هو ان تصاد فتءكل او تذبح فتءكل وقد نهي عن تعذيب ذوات الارواح ( قال الشافعي ) رحمه الله (  ) فقال فانا نقول شبيها بما قلت قلت قد خالفتم ما رويتم عن ابي بكر فقد خالفتموه بما وصفت فما اعرف ما ذهب اليه الذي اتبعناه فقلت ان كان خالفه لما وصفت مما روي عن ابي بكر لانه راي انه ليس لاحد ان يخالف ما روي عن النبي صلي الله عليه وسلم فهكذا ينبغي ان يقول ابدا يترك مرة حديث رسول الله بقول الواحد من اصحاب رسول الله ثم يترك قول ذلك الواحد لراي نفسه فالعمل اذا اليه يفعل فيه ما شاء وليس ذلك لاحد من اهل دهرنا سالت الشافعي عن الرجل يقر بوطء امته فتاتي بولد فينكره فيقول قد كنت اعزل عنها ولم اكن احبسها في بيتي فقال يلحق به الولد اذا اقر بالوطء ولم يدع استبراء بعد الوطء ولا التفت الي قوله كنت اعزل عنها لانها قد تحبل وهو يعزل ولا الي تضييعه اياها بترك التحصين لها وان من اصحابنا لمن يريه القافة مع قوله فقلت فما الحجة فيما ذكرت قال اخبرنا مالك عن بن شهاب عن سالم بن عبد الله عن ابيه ان عمر بن الخطاب قال ما بال رجال يطءون ولاءدهم ثم يعزلون لا تاتيني وليدة يعترف سيدها ان قد الم بها الا الحقت به ولدها فاعزلوا بعد او اتركوا فقلت للشافعي صاحبنا يقول لا نلحق ولد الامة وان اقر بالوطء بحال حتي يدعي الولد ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع عن صفية عن عمر في ارسال الولاءد يوطان بمثل معني حديث بن شهاب عن سالم ( قال الشافعي ) فهذه رواية صاحبنا وصاحبكم عن عمر من وجهين ورواه غيره عنه ولم ترووا ان احدا خالفه من اصحاب رسول الله صلي الله عليه وسلم ولا التابعين فكيف جاز ان يترك ما روي عن عمر لا الي قول احد من اصحابه فقلت للشافعي فهل خالفك في هذا غيرنا قال نعم بعض المشرقيين قلت فما كانت حجتهم قال كانت حجتهم ان قالوا انتفي عمر من ولد جارية له وانتفي زيد بن ثابت من ولد جاريته وانتفي بن عباس من ولد جارية له فقلت فما حجتك عليهم فقال اما عمر فروي عنه انه انكر حمل جارية له فاقرت بالمكروه واما زيد وبن عباس فانما انكرا ان كانا فعلا ان ولد جاريتين عرفا ان ليس منهما فحلال لهما فكذلك ينبغي لهما في الامة وكذلك ينبغي لزوج الحرة اذا علم انها حبلت من زنا ان يدفع ولدها ولا يلحق بنفسه من ليس منه وانما قلت هذا فيما بينه وبين الله كما تعلم المراة ان زوجها قد طلقها ثلاثا فلا ينبغي لها الا الامتناع منه بجهدها وعلي الامام ان يحلفها ثم يردها فالحكم غير ما بين العبد وبين الله ( قال الشافعي ) رحمه الله تعالي فكانت حجتنا عليهم من قولهم انهم زعموا ان ولد الامة لا يلحق الا بدعوة حادثة وان للرجل بعد ما يحصن الامة وتلد منه اولادا يقر بهم ان ينفي بعدهم ولدا او يقر باخر بعده وانما جعلوا له النفي انهم زعموا انه لا يلحق ولد الامة بحال الا بدعوة حادثة ثم قالوا ان اقر بولد جارية ثم حدث بعد اولاد ثم مات ولم يدعهم ولم ينفهم لحقوا به وكان الذي اعتدوا في هذا ان قالوا القياس ان لا يلحق  ولكنا استحسنا ( قال الشافعي ) اذا تركوا القياس فجاز لهم فقد كان لغيرهم ترك القياس حيث قاسوا والقياس حيث تركوا وترك القياس عندنا لا يجوز وما يجوز في ولد الامة الا واحد من قولين اما قولنا واما لا يلحق به الا بدعوة فيكون لو حصن سرية واقر بولدها ثم ولدت بعد عشرة عنده ثم مات ولم تقم بينة باعتراف بهم نفوا معا عنه
   * باب فيمن احيا ارضا مواتا
  * سالت الشافعي عمن احيا ارضا مواتا فقال اذا لم يكن للموات مالك فمن احيا من اهل الاسلام فهو له دون غيره ولا ابالي اعطاه اياه السلطان او لم يعطه لان النبي صلي الله عليه وسلم اعطاه واعطاء النبي صلي الله عليه وسلم احق ان يتم لمن اعطاه من عطاء السلطان فقلت فما الحجة فيما قلت قال ما رواه مالك عن النبي صلي الله عليه وسلم وعن بعض اصحابه ( قال الشافعي ) اخبرنا مالك عن هشام عن ابيه ان النبي صلي الله عليه وسلم قال من احيا ارضا ميتة فهي له وليس لعرق ظالم حق ( قال الشافعي ) اخبرنا مالك عن بن شهاب عن سالم عن ابيه ان عمر بن الخطاب قال من احيا ارضا ميتة فهي له ( قال الشافعي ) واخبرنا سفيان وغيره باسناد غير هذا عن النبي صلي الله عليه وسلم مثل معناه ( قال الشافعي ) وبهذا ناخذ وعطية رسول الله صلي الله عليه وسلم من احيا ارضا مواتا انها له اكثر له من عطية الوالي فقلت للشافعي فانا نكره ان يحيي الرجل ارضا ميتة الا باذن الوالي ( قال الشافعي ) رحمه الله فكيف خالفتم ما رويتم عن النبي صلي الله عليه وسلم وعمر وهذا عندكم سنة وعمل بعدهما واثبتم للوالي ان يعطي وليس للوالي ان يعطي احدا ما ليس له ولا يمنعه ماله ولا علي احد حرج ان ياخذ ماله واذا احيا ارضا ميتة فقد اخذ ماله ولا دافع عنها فيقال للرجل فيما لا دافع عنه وله اخذه لا تاخذ الا باذن سلطان فان قال قاءل (  ) للرجل فيما لا بد للسلطان ان يكشف امره فهو لا يكشف الا وهو معه خصم والظاهر عنده انه لا مالك لها فاذا اعطاها رجلا ثم جاءه من يستحقها دونه ردها الي مستحقها وكذلك لو اخذها واحياها بغير اذنه فلا اثبتم للسلطان فيها معني انما كان له معني لو كان اذا اعطاه لم يكن لاحد استحقها اخذها من يديه فاما ما كان لاحد لو استحقها بعد اعطاء السلطان اياها اخذها من يديه فلا معني له الا بمعني اخذ الرجل اياها لنفسه ( قال الشافعي ) وهذا التحكم في العلم تدعون ما تروون عن النبي صلي الله عليه وسلم وعمر لا يخالفهما احد علمناه من اصحاب النبي صلي الله عليه وسلم لرايكم وتضيقون علي غيركم اوسع من هذا فقلت للشافعي فهل خالفك في هذا غيرنا فقال ما علمت احدا من الناس خالف في هذا غيركم وغير من رويتم هذا عنه الا ابا حنيفة فاني اراكم سمعتم قوله فقلتم به ولقد خالفه ابو يوسف فقال فيه مثل قولنا وعاب قول ابي حنيفة بخلاف السنة ( قال الشافعي ) رحمه الله تعالي ومما في معني ما خالفتم فيه ما رويتم فيه عن النبي صلي الله عليه وسلم وعمن بعده لا مخالف له ان مالكا اخبرنا عن عمرو بن يحيي المازني عن ابيه ان رسول الله صلي الله عليه وسلم قال لا ضرر ولا ضرار قال ثم اتبعه في كتابه حديثا كانه يري انه تفسيره ( قال الشافعي ) اخبرنا مالك عن بن شهاب عن الاعرج عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال لا يمنع احدكم جاره ان يغرز خشبه في جداره قال ثم يقول ابو هريرة مالي اراكم عنها معرضين والله لارمين بها بين اكتافكم ( قال الشافعي ) ثم اتبعهما حديثين لعمر كانه يراهما من صنفه ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن عمرو بن يحيي المازني عن ابيه ان الضحاك بن خليفة ساق خليجا له من العريض فاراد ان يمر به في ارض لمحمد بن مسلمة فابي محمد فكلم فيه الضحاك عمر بن الخطاب فدعا بمحمد بن مسلمة وامره ان يخلي سبيله فقال  بن مسلمة لا فقال عمر لم تمنع اخاك ما ينفعه وهو لك نافع تشرب به اولا واخرا ولا يضرك فقال محمد لا فقال عمر والله ليمرن به ولو علي بطنك ( قال الشافعي ) اخبرنا مالك عن عمرو بن يحيي المازني عن ابيه انه كان في حاءط جده ربيع لعبد الرحمن بن عوف فاراد عبد الرحمن ان يحوله الي ناحية من الحاءط هي اقرب الي ارضه فمنعه صاحب الحاءط فكلم عبد الرحمن عمر فقضي عمر ان يمر به فمر به ( قال الشافعي ) رحمه الله تعالي فرويتم في هذا الكتاب عن النبي صلي الله عليه وسلم حديثا صحيحا ثابتا وحديثين عن عمر بن الخطاب ثم خالفتموها كلها فقلتم في كل واحد منها لا يقضي بها علي الناس وليس عليها العمل ولم ترووا عن احد من الناس علمته خلافها ولا خلاف واحد منها فعمل من تعني تخالف به سنة رسول الله صلي الله عليه وسلم فينبغي ان يكون ذلك العمل مردودا عندنا وتخالف عمر مع السنة لانه يضيق خلاف عمر وحده فاذا كانت معه السنة كان خلافه اضيق مع انك احلت علي العمل وما عرفنا ما تريد بالعمل الي يومنا هذا وما ارانا نعرفه ما بقينا والله اعلم
   * باب في الاقضية
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن هشام بن عروة عن ابيه عن يحيي بن عبد الرحمن بن حاطب ان رقيقا لحاطب سرقوا ناقة لرجل من مزينة فانتحروها فرفع ذلك الي عمر بن الخطاب فامر كثير بن الصلت ان يقطع ايديهم ثم قال عمر اني اراك تجيعهم والله لاغرمنك غرما يشق عليك ثم قال للمزني كم ثمن ناقتك قال اربعماءة درهم قال عمر اعطه ثمانماءة قال مالك في كتابه ليس عليه العمل ولا تضعف عليهم الغرامة ولا يقضي بها علي مولاهم وهي في رقابهم ولا يقبل قول صاحب الناقة فقلت للشافعي بما قال مالك نقول ولا ناخذ بهذا الحديث ( قال الشافعي ) رحمه الله تعالي فهذا حديث ثابت عن عمر يقضي به بالمدينة بين المهاجرين والانصار (  ) فان خالفه غيره لازم لنا فتدعون لقول عمر السنة والاثار لان حكمه عندكم حكم مشهور ظاهر لا يكون الا عن مشورة من اصحاب رسول الله فاذا حكم كان حكمه عندكم قولهم او قول الاكثر منهم فان كان كما تقولون فقد حكم بين اصحاب النبي صلي الله عليه وسلم بقوله في ناقة المزني وانتم تقولون حكمه بالمدينة كالاجماع من عامتهم فان كان قضاء عمر رحمه الله عندكم كما تقولون فقد خالفتموه في هذا وغيره وان لم يكن كما تقولون فلا ينبغي ان يظهر منكم خلاف ما تقولون انتم وانتم لا تروون عن احد انه خالفه فتخالفون بغير شء رويتموه عن غيره ولا اسمعكم الا وضعتم انفسكم موضعا تردون وتقبلون ما شءتم علي غير معني ولا حجة فان كان يجوز ان يعمل بخلاف قضاء عمر فكيف لم تجيزوا لغيركم ما اجزتم لانفسكم وكيف انكرنا وانكرتم علي من خالف قول عمر والواحد من اصحاب رسول الله صلي الله عليه وسلم في غير هذا
   * باب في الامة تغر بنفسها
  * ( قال الشافعي ) اخبرنا مالك انه بلغه ان عمر او عثمان قضي احدهما في امة غرت بنفسها رجلا فذكرت انها حرة فولدت اولادا فقضي ان يفدي ولده بمثلهم قال مالك وذلك يرجع الي القيمة قلت للشافعي فنحن نقول بقول مالك ( قال الشافعي ) فرويتم هذا عن عمر او عثمان ثم خالفتم ايهما قاله ولم نعلمكم رويتم عن احد من الناس خلافه ولا تركة بعمل ولا اجماع ادعاه فلم تركتم هذا ولم ترووا عن احد من اصحاب النبي صلي الله عليه وسلم  خلافه ارايتم اذ اتبعتم عمر في ان في الضبع كبشا وفي الغزال عنزا وقيمتهما تخالف قيمة الضبع والغزال فقلتم البدن قريب من البدن فكيف لم تتبعوا قول عمر او عثمان في مثلهم في البدن كما جعلتم المثل في هذين الموضعين بالبدن
   * باب القضاء في المنبوذ
  * ( قال الشافعي ) رحمه الله اخبرنا مالك عن بن شهاب عن سنين ابي جميلة رجل من بني سليم انه وجد منبوذا في زمان عمر بن الخطاب فجاء به الي عمر فقال ما حملك علي اخذ هذه النسمة قال وجدتها ضاءعة فاخذتها فقال له عريفه يا امير المءمنين انه رجل صالح فقال اكذلك قال نعم فقال عمر اذهب فهو حر ولك ولاءه وعلينا نفقته قال مالك الامر المجتمع عليه عندنا في المنبوذ انه حر وان ولاءه للمسلمين فقلت للشافعي فبقول مالك ناخذ ( قال الشافعي ) تركتم ما روي عن عمر في المنبوذ فان كنتم تركتموه لان النبي صلي الله عليه وسلم قال الولاء لمن اعتق فزعمتم ان في ذلك دليلا علي ان لا يكون الولاء الا لمن اعتق ولا يزول عن معتق فقد خالفتم عمر استدلالا بالسنة ثم خالفتم السنة فزعمتم ان الساءبة لا يكون ولاءه للذي اعتقه وهو معتق فخالفتموهما جميعا وخالفتم السنة في النصراني يعتق العبد المسلم فزعمتم ان لا ولاء له وهو معتق وخالفتم السنة في المنبوذ اذ كان النبي صلي الله عليه وسلم يقول انما الولاء لمن اعتق وهذا نفي ان يكون الولاء الا لمعتق والمنبوذ غير معتق فلا ولاء له فمن اجمع علي ترك السنة والخلاف لعمر فياليت شعري من هءلاء المجتمعون الذين لا يسمعون فانا لا نعرفهم والله المستعان ولم يكلف الله احدا ان ياخذ دينه عمن لا يعرفه ولو كلفه افيجوز له ان يقبل عمن لا يعرف ان هذه لغفلة طويلة ولا اعرف احدا يءخذ عنه العلم يءخذ عليه مثل هذا في قوله واجده يترك ما يروي في اللقيط عن عمر للسنة ويدع السنة فيه وفي موضع اخر في الساءبة والنصراني يعتق المسلم ( قال الشافعي ) رحمه الله تعالي وقد خالفنا بعض الناس في هذا فكان قوله اسد توجيها من قولكم قالوا نتبع ما جاء عن عمر في اللقيط لانه قد يحتمل ان لا يكون خلافا للسنة وان تكون السنة في المعتق من لا ولاء له ويجعل ولاء الرجل المسلم علي يدي الرجل المسلم بحديث عبد العزيز بن عمر بن عبد العزيز عن النبي صلي الله عليه وسلم وقال في الساءبة والنصراني يعتق المسلم قولنا فزعمنا ان عليهم حجة بان قول النبي صلي الله عليه وسلم فانما الولاء لمن اعتق ان لا يكون الولاء الا لمعتق ولا يزول عن معتق فان كانت لنا عليهم بذلك حجة فهي عليكم ابين لانكم خالفتموه حيث ينبغي لكم ان توافقوه ووافقتموه حيث كانت لكم شبهة لو خالفتموه
   * باب القضاء في الهبات
  * ( قال الشافعي ) اخبرنا مالك بن انس عن داود بن الحصين عن ابي غطفان بن طريف المري عن مروان بن الحكم ان عمر بن الخطاب قال من وهب هبة لصلة رحم او علي وجه صدقة فانه لا يرجع فيها ومن وهب هبة يري انه انما اراد الثواب فهو علي هبته يرجع فيها ان لم يرض منها وقال مالك ان الهبة اذا تغيرت عند الموهوب له للثواب بزيادة او نقصان فان علي الموهوب له ان يعطي الواهب قيمتها يوم قبضها فقلت للشافعي فانا نقول بقول صاحبنا ( قال الشافعي ) فقد ذهب عمر في الهبة يراد ثوابها ان الواهب علي هبته ان لم يرض منها ان للواهب الخيار حتي يرضي من هبته ولو اعطي اضعافها في مذهبه والله اعلم كان له ان يرجع فيها ولو تغيرت عند الموهوب له بزيادة  كان له اخذها وكان كالرجل يبيع الشء وله فيه الخيار عبدا او امة فيزيد عند المشتري فيختار الباءع نقض البيع فيكون له نقضه وان زاد العبد المبيع او الامة المبيعة وكثرت زيادته ومذهبكم خلاف ما رويتم عن عمر ( قال الشافعي ) اخبرنا مالك عن نافع ان عبدا كان يقوم علي رقيق الخمس وانه استكره جارية من ذلك الرقيق فوقع بها فجلده عمر ونفاه ولم يجلد الوليدة لانه استكرهها قال مالك لا تنفي العبيد فقلت للشافعي نحن لا ننفي العبيد قال ولم ولم ترووا عن احد من اصحاب النبي صلي الله عليه وسلم ولا التابعين علمته خلاف ما رويتم عن عمر افيجوز لاحد يعقل شيءا من الفقه ان يترك قول عمر ولا يعلم له مخالفا من اصحاب النبي صلي الله عليه وسلم لراي نفسه او مثله ويجعله مرة اخري حجة علي السنة وحجة فيما ليست فيه سنة وهو اذا كان مرة حجة كان كذلك اخري فان جاز ان يكون الخيار الي من سمع قوله يقبل منه مرة ويترك اخري جاز لغيركم تركه حيث اخذتم به واخذه حيث تركتموه فلم يقم الناس من العلم علي شء تعرفونه وهذا لا يسع احدا عندنا والله اعلم ( قال الشافعي ) اخبرنا مالك عن بن شهاب عن الساءب بن يزيد ان عبد الله بن عمرو الحضرمي جاء بغلام له الي عمر بن الخطاب فقال له اقطع يد هذا فانه سرق فقال له عمر وماذا سرق قال سرق مراة لامراتي ثمنها ستون درهما فقال عمر ارسله فليس عليه قطع خادمكم سرق متاعكم ( قال الشافعي ) بهذا ناخذ لان العبد ملك لسيده اخذ من ملكه فلا يقطع مالك من سرق من ملك من كان معه في بيته يامنه او كان خارجا فكذلك لا يقطع من سرق من ملك امراته بحال بخلطة امراته زوجها وهذا معني قول عمر لانه لم يساله اتامنونه او لا تامنونه قال وهذا مما خالفتم فيه عمر لا مخالف له علمناه فقلتم بقطع العبد فيما سرق لامراة سيده ان كان لا يكون معهم في منزل يامنونه
   * باب في ارخاء الستور
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن يحيي بن سعيد عن بن المسيب ان عمر بن الخطاب قضي في المراة يتزوجها الرجل انها اذا ارخيت الستور فقد وجب الصداق ( قال الشافعي ) اخبرنا مالك عن بن شهاب ان زيد بن ثابت قال اذا دخل بامراته فارخيت الستور فقد وجب الصداق ( قال الشافعي ) وروي عن بن عباس وشريح ان لا صداق الا بالمسيس واحتجا او احدهما بقول الله تعالي @QB@ وان طلقتموهن من قبل ان تمسوهن @QE@ قال بهذا ناس من اهل الفقه فقالوا لا يلتفت الي الاغلاق وانما يجب المهر كاملا بالمسيس والقول في المسيس قول الزوج وقال غيرهم يجب المهر باغلاق الباب وارخاء الستور وروي ذلك عن عمر بن الخطاب وان عمر قال ما ذنبهن ان جاء العجز من قبلكم فخالفتم ما قال بن عباس وشريح وما ذهبا اليه من تاويل الايتين وهما قول الله تبارك وتعالي @QB@ وان طلقتموهن من قبل ان تمسوهن @QE@ وقوله @QB@ ثم طلقتموهن من قبل ان تمسوهن فما لكم عليهن من عدة تعتدونها @QE@ وخالفتم ما رويتم عن عمر وزيد وذلك ان نصف المهر يجب بالعقد ونصفه الثاني بالدخول ووجه قولهما الذي لا وجه له غيره انها اذا خلت بينه وبين نفسها واختلي بها فهو كالقبض في البيوع فقد وجب نصف المهر الاخر ولم يذهبا الي مسيس وعمر يدين ثم يقضي بالمهر وان لم يدع المسيس لقوله ما ذنبهن ان كان العجز من قبلكم ثم زعمتم انه لا يجب المهر بالغلق والارخاء اذا لم تدع المراة جماعا وانما يجب بالجماع ثم عدتم فابطلتم الجماع ودعوي الجماع فقلتم اذا كان استمتع بها سنة حتي تبلي ثيابها وجب المهر ومن حد لكم سنة ومن حد لكم ابلاء الثياب وان بليت الثياب قبل السنة فكيف لم يجب المهر ارايت ان قال انسان اذا استمتع بها يوما وقال اخر يومين وقال اخر شهرا وقال اخر عشر سنين  او ثلاثين سنة ما الحجة فيه الا ان يقال هذا توقيت لم يوقته عمر ولا زيد وهما اللذان انتهينا الي قولهما ولا يوقت الا بخبر يلزم فهكذا انتم فما اعرف لما تقولون من هذا الا انه خروج من جميع اقاويل اهل العلم في القديم والحديث وما علمت احدا سبقكم به فالله المستعان فان قلتم انما يءجل العنين سنة فهذا ليس بعنين والعنين عندكم انما يءجل سنة من يوم ترافعه امراته الي السلطان ولو اقام معها قبل ذلك دهرا
   * باب في القسامة والعقل
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن بن شهاب عن سليمان بن يسار وعراك بن مالك ان رجلا من بني سعد بن ليث اجري فرسا فوطء ( ( ( فوطء ) ) ) علي اصبع رجل من جهينة فنزا منها فمات فقال عمر بن الخطاب للذين ادعي عليهم اتحلفون بالله خمسين يمينا ما مات منها فابوا وتحرجوا من الايمان فقال للاخرين احلفوا انتم فابوا فقضي عمر بن الخطاب بشطر الدية علي السعديين ( قال الشافعي ) فخالفتم في هذا الحكم كله عمر بن الخطاب فقلتم يبدا المدعون بل زعمتم انه اذا لم يحلف واحد من الفريقين فليس فيه شطر دية ولا اقل ولا اكثر ( قال الشافعي ) رحمه الله تعالي فان كنتم ذهبتم الي ما ذهبنا اليه من ان النبي صلي الله عليه وسلم بدا المدعين فلما لم يحلفوا رد الايمان علي المدعي عليهم فلما لم يقبل المدعون ايمانهم لم يجعل لهم عليهم شيءا فالي هذا ذهبنا وهكذا يجب عليكم في كل امر وجدتم لرسول الله صلي الله عليه وسلم فيه سنة ان تصيروا الي سنة رسول الله صلي الله عليه وسلم دون ما خالفها من الاشياء كلها وما كان شء من الاشياء اولي ان تاخذوا فيه بحكم عمر من هذا لان الحكم في هذا اشهر من غيره وانه قد كان يمكنكم ان تقولوا هذا دم خطا والذي حكم فيه رسول الله صلي الله عليه وسلم دم عمد فنتبع ما حكم به النبي صلي الله عليه وسلم كما حكم في العمد وما حكم به عمر كما حكم في الخطا وليس واحد منهما خلاف الاخر فان صرتم الي ان تقولوا انهما يجتمعان انهما قسامة فنصير الي قول النبي صلي الله عليه وسلم ونجعل الخطا قياسا علي العمد فما كان لا يتوجه من حديث يخالف ما جاء عن النبي صلي الله عليه وسلم الا علي خلافه اولي ان تصيروا فيه الي حكم رسول الله صلي الله عليه وسلم ولا ينبغي ان تختلف اقاويلكم
   * باب القضاء في الضرس والترقوة والضلع
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن زيد بن اسلم عن مسلم بن جندب عن اسلم مولي عمر بن الخطاب ان عمر قضي في الضرس بجمل وفي الترقوة بجمل وفي الضلع بجمل ( قال الشافعي ) اخبرنا مالك عن يحيي بن سعيد انه سمع سعيد بن المسيب يقول قضي عمر في الاضراس ببعير بعير وقضي معاوية في الاضراس بخمسة ابعرة خمسة ابعرة قال سعيد بن المسيب فالدية تنقص في قضاء عمر وتزيد في قضاء معاوية فلو كنت انا لجعلت في الاضراس بعيرين بعيرين فتلك الدية سواء فقلت للشافعي فانا نقول في الاضراس خمس خمس ونزعم انه ليس في الترقوة وفي الضلع حكم معروف وانما فيها حكومة باجتهاد قال فقد خالفتم حديث زيد بن اسلم عن عمر كله فقلتم في الاضراس خمس خمس وهكذا نقول لما جاء عن النبي صلي الله عليه وسلم في السن خمس كانت الضرس سنا قال فهذا كما قلنا في المسالة قبلها وقد يحتمل ان يكون النبي صلي الله عليه وسلم قال في السن خمس مما اقبل من الفم مما اسمه سن فاذا كانت لنا ولكم حجة بان نقول الضرس سن ونذهب الي حديث النبي صلي الله عليه وسلم فيها ونخالف غيره لظاهر حديث النبي صلي الله عليه وسلم وان توجه لغيره ان لا يكون خلاف قول النبي صلي الله عليه وسلم فهكذا ينبغي لنا ان لا نترك عن رسول الله صلي الله عليه وسلم شيءا ابدا لقول غيره فاما ان تتركوا  قول عمر لقول النبي صلي الله عليه وسلم مرة وتتركوا قول النبي صلي الله عليه وسلم لقول عمر مرة فهذا ما لا يجهل عالم انه ليس لاحد ان شاء الله قال وخالفتم عمر في الترقوة والضلع فقلتم ليس فيهما شء موقت ( قال الشافعي ) وانا اقول بقول عمر فيهما معا لانه لم يخالفه واحد من اصحاب النبي صلي الله عليه وسلم فيما علمته ( ( ( علمت ) ) ) فلم ار ان اذهب الي رايي واخالفه ( قال الشافعي ) وروي مالك عن سعيد انه روي عن عمر في الاضراس بعير بعير وعن معاوية خمسة ابعرة وقال فيهما بعيرين بعيرين فاذا كان سعيد يعرف عن عمر شيءا ثم يخالفه ولم يذهب ايضا الي ما ذهبنا اليه من الحديث وكنتم تخالفون عمر ثم تخالفون سعيدا فاين ما تدعون ان سعيدا اذا قال قولا لم يقل به الا عن علم وتحتجون بقوله في شء وها انتم تخالفونه في هذا وغيره فاين ما زعمتم من ان العلم بالمدينة كالوراثة لا يختلفون فيه وحكايتهم اذا حكوا وحكيتم عنهم اختلافا فكذلك حكاية غيركم في اكثر الاشياء انما الاجماع عندهم فيما يوجد الاجماع فيه عند غيرهم وان اولي علم الناس بعد الصلاة ان يكون عليه اجماع بالمدينة الديات لان بن طاوس قال عن ابيه ما قضي به النبي صلي الله عليه وسلم من عقل وصدقات فانما نزل به الوحي وعمر من الاسلام بموضعه الذي هو به من الناس فقد خالفتموه في الديات وخالفتم بن المسيب بعده فيها ولا اري دعواكم الموروث كما ادعيتم وما اراكم قبلتم عن عمر هذا وما اجدكم تقبلون العلم الا عن انفسكم
   * باب في النكاح
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن ابي الزبير ان عمر بن الخطاب اتي بنكاح لم يشهد عليه الا رجل وامراة فقال هذا نكاح السر ولا اجيزه ولو كنت تقدمت فيه لرجمت ( قال الشافعي ) وقد خالفتم هذا وقلتم النكاح مفسوخ ولا حد عليه فخالفتم عمر وعمر لو تقدم فيه لرجم يعني لو اعلمت الناس انه لا يجوز النكاح بشاهد وامراة حتي يعرفوا ذلك لرجمت فيه من فعله بعد تقدمي
   * باب ما جاء في المتعة
  * ( قال الشافعي ) اخبرنا مالك عن بن شهاب عن عروة ان خولة بنت حكيم دخلت علي عمر بن الخطاب فقالت ان ربيعة بن امية استمتع بامراة مولدة فحملت منه فخرج عمر يجر رداءه فزعا وقال هذه المتعة ولو كنت تقدمت فيها لرجمت ( قال الشافعي ) رحمه الله تعالي يشبه قوله في الاول ومذهب عمر في هذا ان المتعة اذا كانت محرمة عنده وكان الناس يفعلونها مستحلين او جاهلين وهو اسم نكاح فيدرا عنهم بالاستحلال انه لو كان تقدم فيها حتي يعلمهم ان حكمه انها محرمة ففعلوها رجمهم وحملهم علي حكمه وان كانوا يستحلون منها ما حرم كما قال يستحل قوم الدينار بالدينارين يدا بيد فيفسخه عليهم من يراه حراما فخالفتم عمر في المسالتين معا وقلتم لا حد علي من نكح بشاهد وامراة ولا من نكح نكاح متعة كما زعمت فيهما ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن يحيي بن سعيد عن سعيد بن المسيب انه قال قال عمر بن الخطاب ايما رجل تزوج امراة وبها جنون او جذام او برص فمسها فلها صداقها كاملا وذلك لزوجها غرم علي وليها قال مالك وانما يكون ذلك لزوجها غرما علي وليها اذا كان الذي انكحها هو ابوها او اخوها او من يري انه يعلم ذلك منها والا فليس عليه غرم وترد المراة ما اخذت من صداق نفسها ويترك لها قدر ما استحلها به اذا مسها فقلت للشافعي فانا نقول بقول مالك وسالت عن قوله في ذلك فقال انما حكم عمر ان لها المهر بالمسيس وان المهر علي وليها لانه غار والغار علم او لم يعلم يغرم ارايت رجلا باع عبدا ولم يعلم انه حر اليس  يرجع عليه بقيمته او باع متاعا لنفسه او لغيره فاستحق او فسد البيع او كان لمشتريه الخيار فاختار رده الا يرجع بقيمة ما غرم علي من غره علم او لم يعلم قال ورويتم الحديث عن عمر وخالفتموه فيه بما وصفته فلو ذهبتم فيه الي امر يعقل فقلتم اذا كان الصداق ثمنا للمسيس لم يرجع به الزوج عليها ولا علي ولي لانه قد اخذ المسيس كما ذهب بعض المشرقيين الي هذا كان مذهبا فاما ما ذهبتم اليه فليس بمذهب وهو خلاف عمر ( قال الشافعي ) اخبرنا مالك انه كتب الي عمر بن الخطاب من العراق في رجل قال لامراته حبلك علي غاربك فكتب عمر الي عامله ان مره يوافيني في الموسم فبينا عمر يطوف بالبيت اذ لقيه الرجل فسلم عليه فقال من انت فقال انا الذي امرت ان اجلب عليك فقال عمر انشدك برب هذه البنية هل اردت بقولك حبلك علي غاربك الطلاق فقال الرجل لو استحلفتني في غير هذا المكان ما صدقتك اردت الفراق فقال عمر هو ما اردت ( قال الشافعي ) رحمه الله تعالي فبهذا نقول وفيه دلالة علي ان كل كلام اشبه الطلاق لم نحكم به طلاقا حتي يسال قاءله فان كان اراد طلاقا فهو طلاق وان لم يرد طلاقا لم يكن طلاقا ولم نستعمل الاغلب من الكلام علي رجل احتمل غير الاغلب فخالفتم عمر في هذا فزعمتم انه طلاق وانه لا يسال عما اراد
   * باب في المفقود
  * ( قال الشافعي ) اخبرنا مالك عن يحيي بن سعيد عن سعيد بن المسيب ان عمر بن الخطاب قال ايما امراة فقدت زوجها فلم تدر اين هو فانها تنتظر اربع سنين ثم تنتظر اربعة اشهر وعشرا قال والحديث الثابت عن عمر وعثمان في امراة المفقود مثل ما روي مالك عن بن المسيب عن عمر وزيادة فاذا تزوجت فقدم زوجها قبل ان يدخل بها زوجها الاخر كان احق بها فان دخل بها زوجها الاخر فالاول المفقود بالخيار بين امراته والمهر ومن قال بقوله في المفقود قال بهذا كله اتباعا لقول عمر وعثمان وانتم تخالفون ما روي عن عمر وعثمان معا فتزعمون انها اذا نكحت لم يكن لزوجها الاول فيها خيار هي من الاخر فقلت للشافعي فان صاحبنا قال ادركت من ينكر ما قال بعض الناس عن عمر فقال الشافعي قد راينا من ينكر قضية عمر كلها في المفقود ويقول هذا لا يشبه ان يكون من قضاء عمر فهل كانت الحجة عليه الا ان الثقات اذا حملوا ذلك عن عمر لم يتهموا فكذلك الحجة عليك وكيف جاز ان يروي الثقات عن عمر حديثا واحدا فتاخذ ببعضه وتدع بعضا ارايت ان قال لك قاءل اخذ بالذي تركت منه واترك الذي اخذت به هل الحجة عليه الا ان يقال من جعل قوله غاية ينتهي اليها اخذ بقوله كما قال فاما قولك فانما جعلت الغاية في نفسك لا فيمن روي عنه الثقات فهكذا الحجة عليك لانك تركت بعض قضية عمر واخذت ببعضها ( قال الربيع ) لا تتزوج امراة المفقود حتي ياتي يقين موته لان الله قال @QB@ والذين يتوفون منكم ويذرون ازواجا @QE@ فجعل علي المتوفي عدة وكذلك جعل علي المطلقة عدة لم يبحها الا بموت او طلاق وهي معني حديث النبي صلي الله عليه وسلم اذ قال ان الشيطان ينقر عند عجز احدكم حتي يخيل اليه انه قد احدث فلا ينصرف احدكم حتي يسمع صوتا او يجد ريحا فاخبر انه اذا كان علي يقين من الطهارة فلا تزول الطهارة الا بيقين الحدث وكذلك هذه المراة لها زوج بيقين فلا يزول قيد نكاحها بالشك ولا يزول الا بيقين وهذا قول علي بن ابي طالب
   * باب في الزكاة
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن بن شهاب عن سليمان بن يسار ان اهل الشام قالوا لابي عبيدة بن الجراح خذ منا من خيلنا ومن رقيقنا صدقة فابي ثم كتب الي عمر فابي ثم كلموه ايضا فكتب الي عمر  فكتب اليه ان احبوا فخذها منهم وارددها عليهم قال مالك يعني ردها الي فقراءهم ( قال الشافعي ) وقد اخبرنا بن عيينة عن الزهري عن الساءب بن يزيد ان عمر امر ان يءخذ في الفرس شاتين ( ( ( شاتان ) ) ) او عشرة او عشرين ( ( ( عشرون ) ) ) درهما فقلت للشافعي فانا نقول لا تءخذ في الخيل صدقة لان النبي صلي الله عليه وسلم قال ليس علي المسلم في عبده ولا فرسه صدقة ( قال الشافعي ) فقد رويتم وروي غيركم عن عمر هذا فان كنتم تركتموه لشء رويتموه عن النبي صلي الله عليه وسلم جملة فهكذا فاصنعوا في كل من روي عن احد شيءا يخالف ما جاء عن النبي صلي الله عليه وسلم فيه وانكم لتخالفون ما جاء عن النبي صلي الله عليه وسلم فيما هو ابين من هذا وتعملون فيه بان الرجل من اصحابه لا يقول قولا يخالفه وتقولون لا يخفي علي الرجل من اصحابه قوله ثم ياتي موضع اخر فيختلف كلامكم ولو شاء رجل قال قال النبي صلي الله عليه وسلم ليس علي مسلم في عبده وفرسه صدقة اذا كان فرسه مربوطا له مطية فاما خيل تتناتج فناخذ منها كما اخذ عمر بن الخطاب فقد ذهب هذا المذهب بعض المفتين ولو ذهبتم هذا المذهب لكان له وجه يحتمل فان لم تقولوا وصرتم الي اتباع ما جاء عن النبي صلي الله عليه وسلم جملة وجملة كل شء عليه فهكذا فاصنعوا في كل شء ولا تختلف اقاويلكم ان شاء الله
   * باب في الصلاة
  * ( قال الشافعي ) اخبرنا مالك عن يحيي بن سعيد عن محمد بن ابراهيم التيمي عن ابي سلمة بن عبد الرحمن ان عمر بن الخطاب صلي بالناس المغرب فلم يقرا فيها فلما انصرف قيل له ما قرات قال فكيف كان الركوع والسجود قالوا حسنا قال فلا باس قلت للشافعي فانا نقول من نسي القراءة في الصلاة اعاد الصلاة ولا تجزء صلاة الا بقراءة قال فقد رويتم هذا عن عمر وصلاته بالمهاجرين والانصار فزعمتم انه لم ير اذا كان الركوع والسجود حسنا باسا ولا تجدون عنه شيءا احري ان يكون اجماعا منه ومن المهاجرين والانصار عليه عادة من هذا اذا كان علم الصلاة ظاهرا فكيف خالفتموه فان كنتم انما ذهبتم الي ان النبي صلي الله عليه وسلم قال لا صلاة الا بقراءة فينبغي ان تذهبوا في كل شء هذا المذهب فاذا جاء شء عن النبي صلي الله عليه وسلم لم تدعوه لشء ان خالفه غيره كما قلتم ها هنا وهذا موضع لكم فيه شهود لانه شبهة لو ذهبتم اليه بان تقولوا لا صلاة الا بقراءة لمن كان ذاكرا والنسيان موضوع كما ان نسيان الكلام عندكم موضوع في الصلاة فاذا امكنكم ان تقولوا هذا في الصلاة فلم تقولوه وصرتم الي جملة ما روي عن النبي صلي الله عليه وسلم وتركتم ما رويتم عن عمر ومن خلفه من المهاجرين والانصار لجملة حديث النبي صلي الله عليه وسلم فكيف لم تصنعوا هذا فيما جاء عن رسول الله صلي الله عليه وسلم منصوصا بينا لا يحتمل ما خالفه مثل ما احتمل هذا من التاويل بالنسيان
   * باب في قتل الدواب التي لا جزاء فيها في الحج
  * سالت الشافعي عن قتل القراد والحلمة في الاحرام فقال لا باس بقتله ولا فدية فيه وانما يفدي المحرم ما قتل مما يءكل لحمه فقلت له ما الحجة فيه فقال اخبرنا مالك عن يحيي بن سعيد عن محمد بن ابراهيم بن الحرث التميمي ( ( ( التيمي ) ) ) عن ربيعة بن عبد الله انه راي عمر يقرد بعيرا له في طين بالسقيا فقلت للشافعي فان صاحبنا يقول لا ينزع الحرام قرادا ولا حلمة  ويحتج بان بن عمر كره ان ينزع المحرم قرادا او حلمه من بعير قال وكيف تركتم قول عمر وهو يوافق السنة بقول بن عمر ومع عمر بن عباس وغيره فان كنتم ذهبتم الي التقليد فلعمر بمكانه من الاسلام وفضل علمه ومعه بن عباس وموافقة السنة اولي ان تقلدوه ( قال ) وقد تتركون قول بن عمر لراي انفسكم ولراي غير بن عمر فاذا تركتم ما روي عن النبي صلي الله عليه وسلم من طيب المحرم لقول عمر وتركتم علي عمر تقريد البعير لقول بن عمر وعلي بن عمر فيما لا يحصي لراي انفسكم فالعلم اليكم عند انفسكم صار فلا تتبعون منه الا ما شءتم ولا تقبلون الا ما هويتم وهذا لا يجوز عند احد من اهل العلم فاذا زعمتم ان بن عمر يخالف عمر في هذا وغيره فكيف زعمتم ان الفقهاء بالمدينة لا يختلفون وانتم تروون عنهم الاختلاف وغيركم يرويه عنهم في اكثر خاص الفقه ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر قال لا يصدرن احد من الحاج حتي يطوف بالبيت فان اخر النسك الطواف بالبيت قال مالك وذلك فيما نري والله اعلم لقول الله جل ثناءه @QB@ ثم محلها الي البيت العتيق @QE@ فمحل الشعاءر وانقضاءها الي البيت العتيق ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن يحيي بن سعيد ان عمر بن الخطاب رد رجلا من مر الظهران لم يكن ودع البيت ( قال ) وقال مالك من جهل ان يكون اخر عهده الطواف بالبيت لم يكن عليه شء الا ان يكون قريبا فيرجع فلا انتم عذرتموه بالجهالة فلا تردونه من قريب ولا بعيد ولا انتم اتبعتم قول عمر وما تاول صاحبكم من القران ان الوداع من نسكه فيجعل عليه دما وهو قول بن عباس من نسي من نسكه شيءا فليهرق دما وهو يقول في مواضع كثيرة بقول بن عباس وحده من نسي من نسكه شيءا فليهرق دما ثم تتركونه حيث شءتم وتدعونه ومعه عمر وما تاولتم من القران
   * باب ما جاء في الصيد
  * سالت الشافعي عمن قتل من الصيد شيءا وهو محرم فقال من قتل من دواب الصيد شيءا جزاه بمثله من النعم لان الله تبارك وتعالي يقول @QB@ فجزاء مثل ما قتل من النعم @QE@ والمثل لا يكون الا لدواب الصيد فاما الطير فلا مثل له ومثله قيمته الا ان في حمام مكة اتباعا للاثار شاة ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك ان ابا الزبير حدثه عن جابر بن عبد الله ان عمر بن الخطاب قضي في الضبع بكبش وفي الغزال بعنز وفي الارنب بعناق وفي اليربوع بجفرة فقلت للشافعي فانا نخالف ما روينا عن عمر في الارنب واليربوع فنقول ( ( ( فيقول ) ) ) لا يفديان بجفرة ولا بعناق ( قال الشافعي ) هذا الجهل البين وخلاف كتاب الله عندنا وامر عمر وامر عثمان بن عفان وبن مسعود وهم اعلم بمعاني كتاب الله منكم مع انه ليس في تنزيل الكتاب شء يحتاج الي تاويل لان الله جل ثناءه اذ حكم في الصيد بمثله من النعم فليس يعدم المثل ابدا فما له مثل من النعم ان ينظر الي الصيد اذا قتل باي النعم كان اقرب بها شبها في البدن فدي به وهذا اذا كان كذا فدي الكبير بالكبير والصغير بالصغير او يكون المثل القيمة كما قال بعض المشرقيين وقولكم لا القيمة ولا المثل من البدن بل هو خارج منهما مع خروجه مما وصفنا من الاثار وتزعمون في كل ما كان فيه ثنية فصاعدا انه مثل النعم فترفعون وتخفضون فاذا جاء ما دون ثنية قلتم مثل من القيمة وهذا قول لا يقبل من احد لو لم يخالف الاثار فكيف وقد خالفها وكل ما فدي فانما القدر قيمته والقيمة تكون قليلة وكثيرة واقاويلكم فيها متناقضة فكيف تجاوز الثنية التي تجوز ضحية في البقرة فتفديها ويكون يصيد صيدا صغيرا دون الثنية فلا تفدية بصغير دون الثنية ( قال الشافعي ) فتصيرون الي قول عمر في النهي عن الطيب قبل الاحرام  وتتركون فيه ما روي عن النبي صلي الله عليه وسلم وتصيرون الي ترك قوله في كثير وتدعون لقوله ما وصفت من سنن تروونها عن النبي صلي الله عليه وسلم ثم تخالفون عمر ولا مخالف له من اصحاب النبي صلي الله عليه وسلم ولا التابعين بل معه من اصحاب النبي صلي الله عليه وسلم عثمان وبن مسعود ومن التابعين عطاء واصحابه ( قال الشافعي ) وقد جهدت ان اجد احدا يخبرني الي اي شء ذهبتم في ترككم ما رويتم عن عمر في اليربوع والارنب فما وجدت احدا يزيدني علي ان بن عمر قال الضحايا والبدن الثني ( ( ( والثني ) ) ) فما فوقه ( قال الشافعي ) وانتم ايضا تخالفون في هذا لان قول بن عمر لا يعدو ان يكون لا يجيز من الضحايا والبدن الا الثني فما فوقه فان كان هذا فانتم تجيزون الجذعة من الضان ضحية وان كان قول بن عمر ان الثني فما فوقه وفاء ولا يسع ذلك ما دونه ان يكون ضحية فقد تاولتم قول بن عمر علي غير وجهه وضيقتم علي غيركم ما دخلتم في مثله ( قال الشافعي ) وقد اخطا من جعل الصيد من معني الضحايا والبدن بسبيل ما نجد احدا منكم يعرف عنه في هذا شء يجوز لاحد ان يحكيه لضعف مذهبكم به وخروجه من معني القران والاثر عن عمر وعثمان وبن مسعود والقياس والمعقول ثم تناقضه فان قال قاءل فجزاء الصيد ضحايا قلنا معاذ الله ان يكون ضحايا جزاء الصيد بدل من الصيد (  ) والبدل يكون منه ما يكون بقرة مثله فارفع واخفض منها تمرة والتمرتين وذلك ان من جزاء الصيد ما يكون بتمرة ومنه ما يكون ببدنة ومنه ما يكون بين ذلك فان قال قاءل فما فرق بين جزاء الصيد والضحايا والبدن قيل ارايت الضحايا ايكون علي احد فيها اكثر من شاة فان قال لا قيل افرايت البدن اليست تطوعا او نذرا او شيءا وجب بافساد حج فان قال بلي قيل افرايت جزاء الصيد اليس انما هو غرم وغرمه من قتله بانه محرم القتل في تلك الحال وحكم الله به عليه هديا بالغ الكعبة للمساكين الحاضري الكعبة فان قال بلي قيل فكما تحكم لمالك الصيد علي رجل لو قتله بالبدن منه فان قال نعم قيل فاذا قتل نعامة كانت فيها بدنة او بقرة وحش كانت فيها شاة فان قال نعم قيل افتري هذا كالاضاحي او كالهدي التطوع او البدن او افساد الحج فان قال قد يفترقان قيل اليس اذا اصيبت نعامة كانت فيها بدنة لانها اقرب الاشياء من المثل وكذلك البقر والغزال فان قال نعم قيل فاذا كان هذا بدلا لشء اتلف فكان علي ان اغرم اكثر من الضحية فيه لم لا يكون لي ان اعطي دون الضحية فيه وانت قد تجعل ذلك لي فتجعل في الجرادة تمرة ( قال الشافعي ) فان قال فانما اجعل عليك القيمة اذا كانت القيمة دون ما يكون ضحية قيل فمن قال لك ان شيءا يكون بدلا من شء فتجعل علي من قتله المثل ما كان ضحية فاعلي ولا تجعل الضحية تجزي فيما قتل منه مما هو اعلي منها واذا كان شء دون الضحية لم تطرحه عني بل تجعله علي بمثل من الثمن لانه لا يجوز ضحية فهو في قولك ليس من معاني الضحايا فان قال افيجوز ان يكون هذا ناقصا وضحية قيل نعم فكما يجوز ان يكون تمرة وقبضة من طعام ودرهم ودرهمان هديا ولو لم يجز كنت قد اخطات اذ زعمت انه اذا اصبت صيدا مريضا او اعور او منقوصا قوم علي في مثل تلك الحال ناقصا ولم تقل يقوم علي وافيا فمثلت الصيد الصغير مرة بالانسان الحر ( ( ( الحي ) ) ) يقتل منقوصا فيكون فيه دية تامة وزعمت اخري انه اذا قوم الصيد المقتول قومه منقوصا وهذا قول يختلف ان كان قياسا علي الانسان الحر فلا يفرق بين قيمته منقوصا وصغيرا وكبيرا لان الانسان يقتل مريضا ومنقوصا كهيءته صحيحا وافرا وان كان قياسا علي المال يتلف فيقومه بالحال التي اتلف فيها لا بغيرها ( قال الشافعي ) رحمه الله تعالي فان قال ما معني قول الله هديا قلت الهدي شء فصلته من مالك الي  من امرت بفصله اليه كالهدية تخرجها من مالك الي غيرك فيقع اسم الهدي علي تمرة وبعير وما بينهما من كل ثمر ( ( ( ثمرة ) ) ) وماكول يقع عليه اسم الهدية علي ما قل وكثر فان قال افيجوز ان تذبح صغيرة من الغنم فتتصدق بها قلت نعم كما يجوز ان تتصدق بتمرة والهدي غير الضحية والضحية غير الهدي الهدي بدل والبدل يقوم مقام ما اتلف والضحية ليست بدلا من شء ( قال الشافعي ) وقد قال هذا مع عمر بن الخطاب عثمان بن عفان وبن مسعود وغيرهما فخالفتم الي غير قول اخر مثلهم ولا من سلف من الاءمة علمته ( قال الشافعي ) اخبرنا سفيان عن عبد الكريم الجزري عن ابي عبيدة بن عبد الله بن مسعود ان محرما القي جوالقا فاصاب يربوعا فقتله فقضي فيه بن مسعود بجفرة مجفرة ( قال الشافعي ) اخبرنا بن عيينة عن بن ابي نجيح عن مجاهد ان بن مسعود حكم في اليربوع بجفرة او جفرة ( قال الشافعي ) اخبرنا سفيان عن مطرف عن ابي السفر ان عثمان قضي في ام حيين بحلان من الغنم ( قال الشافعي ) اخبرنا سفيان عن مخارق عن طارق قال خرجنا حجيجا فاوطا رجل منا يقال له اربد ضبا ففزر ظهره فقدمنا علي عمر فساله اربد فقال عمر احكم فيه فقال انت خير مني يا امير المءمنين واعلم فقال له عمر انما امرتك ان تحكم فيه ولم امرك ان تزكيني فقال اربد اري فيه جديا قد جمع الماء والشجر فقال عمر فذاك فيه ( قال الشافعي ) لا اعلم مذهبا اضعف من مذهبكم رويتم عن عمر تءجل امراة المفقود ثم تعتد عدة الوفاة وتنكح وروي المشرقيون عن علي لتصبر حتي ياتيها يقين موته وجعل الله عدة الوفاة علي المراة يتوفي عنها زوجها فقال المشرقيون لا يجوز ان تعتد عدة الوفاة الا من جعل الله ذلك عليها ولم يجعل الله ذلك الا علي التي توفي عنها زوجها يقينا فقلتم عمر اعلم بمعني كتاب الله فاذا قيل لكم وعلي عالم بكتاب الله وانتم لا تقسمون مال المفقود علي ورثته ولا تحكمون عليه بحكم الوفاة حتي تعلموا انه مات ببينة تقوم علي موته فكيف حكمتم عليه حكم الوفاة في امراته فقط قلتم لا يقال لما روي عن عمر لم ولا كيف ولا يتاول معه القران ثم وجدتم عمر يقول في الصيد بمعني كتاب الله ومع عمر عثمان وبن مسعود وعطاء وغيرهم فخالفتموهم لا مخالف لهم من الناس الا انفسكم لقول متناقض ضعيف والله المستعان ( قال الشافعي ) رحمه الله تعالي اخبرنا مسلم بن خالد عن بن جريج عن عطاء انه قال من اصاب ولد ظبي صغيرا فداه بولد شاة مثله وان اصاب صيدا اعور فداه باعور مثله او منقوصا فداه بمنقوص مثله او مريضا فداه بمريض واحب الي لو فداه بواف ( قال الشافعي ) اخبرنا مالك عن عبد الملك بن قرير عن محمد بن سيرين ان رجلا جاء الي عمر بن الخطاب فقال اني اجريت انا وصاحبي فرسين نستبق الي ثغرة ثنية فاصبنا ظبيا ونحن محرمان فماذا تري فقال عمر لرجل الي جنبه تعال ( ( ( تعالي ) ) ) نحكم انا وانت فحكما عليه بعنز وذكر في الحديث ان عمر قال هذا عبد الرحمن بن عوف ( قال الشافعي ) اخبرنا الثقفي عن ايوب عن بن سيرين عن شريح انه قال لو كان معي حاكم لحكمت في الثعلب بجدي قلت للشافعي فان صاحبنا يقول ان الرجلين اذا اصابا ظبيا حكم عليهما بعنزين وبهذا نقول ( قال الشافعي ) وهذا خلاف قول عمر وعبد الرحمن بن عوف في روايتكم وبن عمر في رواية غيركم الي قول غير احد من اصحاب النبي صلي الله عليه وسلم فاذا جاز لكم ان تخالفوهم فكيف تجعلون قول الواحد منهم حجة علي السنة ولا تجعلونه حجة علي انفسكم قال ثم اردتم ان تقيسوا فاخطاتم القياس فلو لم تكونوا خالفتم احدا كنتم قد اخطاتم القياس قستم بالرجلين يقتلان النفس فيكون علي كل واحد منهما كفارة عتق رقبة وفي النفس شيءان احدهما بدل والبدل كالثمن وهو الدية في الحر والثمن في العبد والابدال لا يزاد فيها عندنا وعندكم لو ان ماءة رجل قتلوا رجلا حرا او عبدا لم يغرموا الا دية او قيمة فان قال قاءل فالظبي يقتل بالقيمة والدية اشبه ام الكفارة قيل بالقيمة والدية فان قال ومن اين قيل تفدي النعامة ببدنة والجرادة بتمرة وهذا مثل  قيمة العبد المرتفع والمنخفض والكفارة شء لا يزاد فيها ولا ينقص منها ان كان طعاما او كسوة او عتقا وقول عمر وعبد الرحمن معني القران لان الله جل ثناءه يقول @QB@ فجزاء مثل ما قتل من النعم @QE@ فجعل فيه المثل فمن جعل فيه مثلين فقد خالف قول الله والله اعلم ثم لا تمتنعون من رد قول عمر لراي انفسكم ومعه عبد الرحمن بن عوف ( قال الشافعي ) اخبرنا مسلم بن خالد عن بن جريج عن عطاء في نفر اصابوا صيدا قال عليهم كلهم جزاء واحد ( قال الشافعي ) اخبرنا الثقة عن حماد بن سلمة عن عمار مولي بني هاشم قال سءل بن عباس عن نفر اصابوا صيدا قال عليهم جزاء قيل علي كل واحد منهم جزاء قال انه لمغرر بكم بل عليكم كلكم جزاء واحد والله اعلم
   * باب الامان لاهل دار الحرب
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك انه بلغه ان عمر بن الخطاب كتب الي عامل جيش كان بعثه انه بلغني ان الرجل منكم يطلب العلج حتي اذا اسند في الجبل وامتنع قال له الرجل مترس يقول لا تخف فاذا ادركه قتله واني والذي نفسي بيده لا يبلغني ان احدا فعل ذلك الا ضربت عنقه قال مالك وليس هذا بالامر المجتمع عليه ولا يقتل به فقلت للشافعي فانا نقول بقول مالك ( قال الشافعي ) قد خالفتم ما رويتم عن عمر ولم ترووا عن احد من اصحاب النبي صلي الله عليه وسلم خلافه علمناه واما قوله ليس هذا بالامر المجتمع عليه فليس في مثل هذا اجتماع وهو لا يروي شيءا يخالفه ولا يوافقه فاين الاجماع فيما لا رواية فيه فان كان ذهب الي ان النبي صلي الله عليه وسلم قال لا يقتل مسلم بكافر وهذا كافر لزمه اذا جاء شء عن النبي صلي الله عليه وسلم ان يترك كل ما خالفه اما ان يترك ما جاء عن النبي صلي الله عليه وسلم مرة ويلزمه اخري فهذا لا يجوز لاحد
   * باب ما روي مالك عن عثمان بن عفان وخالفه في تخمير المحرم وجهه
  * سالت الشافعي ايخمر المحرم وجهه فقال نعم ولا يخمر راسه وسالته عن المحرم يصطاد من اجله الصيد قال لا ياكله فان اكله فقد اساء ولا فدية عليه فقلت وما الحجة فقال اخبرنا مالك عن عبد الله بن ابي بكر عن عبد الله بن عامر بن ربيعة قال رايت عثمان بن عفان بالعرج في يوم صاءف وهو محرم وقد غطي وجهه بقطيفة ارجوان ثم اتي بلحم صيد فقال لاصحابه كلوا فقالوا الا تاكل انت قال اني لست كهيءتكم انما صيد من اجلي فقلت انا نكره تخمير الوجه للمحرم ويكرهه صاحبنا ويروي فيه عن بن عمر انه قال ما فوق الذقن من الراس فلا يخمره المحرم ( قال الشافعي ) رحمه الله تعالي اخبرنا سفيان عن عبد الرحمن بن القاسم عن ابيه ان عثمان بن عفان وزيد بن ثابت ومروان كانوا يخمرون وجوههم وهم محرمون فان كنت ذهبت الي ان عثمان وبن عمر اختلفا في تخمير الوجه فكيف اخذت بقول بن عمر دون قول عثمان ومع عثمان زيد بن ثابت ومروان وما هو اقوي من هذا كله قلت وما هو قال امر النبي صلي الله عليه وسلم بميت مات محرما ان يكشف عن راسه دون وجهه ولا يقرب طيبا ويكفن في ثوبيه اللذين مات فيهما فدلت السنة علي ان للمحرم تخمير وجهه وعثمان وزيد رجلان وبن عمر واحد ومعهما مروان فكان ينبغي عندك ان يكون هذا اشبه بالعمل وبدلالة السنة وعثمان الخليفة وزيد ثم مروان بعدهما وقد اختلف عثمان وبن عمر في العبد يباع ويتبرا صاحبه من العيب فقضي عثمان علي بن عمر ان يحلف ما كان به داء علمه وقد راي بن عمر ان التبرء يبرءه مما علم لم يعلم فاخترت قول بن عمر وسمعت من اصحابك من يقول عثمان الخليفة (  ) عن قضاه بين المهاجرين والانصار كانه قول عامتهم وقوله بهذا كله اولي ان يتبع من بن عمر فعثمان اذ كان معه ما وصفت  في تخمير المحرم وجهه من دلالة السنة ومن قول زيد ومروان اولي ان يصار الي قوله مع انه قول عامة المفتين بالبلدان فقلت للشافعي فانا نقول ما فوق الذقن من الراس قال الشافعي ينبغي ان يكون من شانك الصمت حين تسمع كلام الناس حتي تعرف منه فاني اراك تكثر ان تكلم بغير روية فقلت وما ذلك فقال وما تعني بقولك وما فوق الذقن من الراس اتعني ان حكمة حكم الراس في الاحرام فقلت نعم فقال افتخمر المراة المحرمة ما فوق ذقنها فان للمحرمة ان تخمر راسها فقلت لا قال افيجب علي الرجل اذا لبد راسه حلقه او تقصيره فقلت نعم قال افيجب عليه ان ياخذ من شعر ما فوق الذقن من وجهه فقلت لا فقال لي الشافعي وفرق الله بين حكم الوجه والراس فقال اغسلوا وجوهكم فعلمنا ان الوجه ما دون الراس وان الذقن من الوجه وقال امسحوا برءوسكم فكان الراس غير الوجه فقلت نعم قال وقولك لا كراهة لتخمير الوجه بكماله ولا اباحة تخميره بكماله انه يجب علي من وضع نفسه معلما ان يبدا فيعرف ما يقول قبل ان يقوله ولا ينطق بما لا يعلم وهذه سبيل لا اراك تعرفها فاتق الله وامسك عن ان تقول بغير علم ولم ار من ادب من ذهب مذهبك الا ان يقول القول ثم يصمت وذلك انه قال فيما نري يعلم انه لا يصنع شيءا بمناظرة غيره الا بما ان صمت امثل به قلت للشافعي فمن اين قلت اي صيد صيد من اجل محرم فاكل منه لم يغرم فيه فقال لان الله جل ثناءه انما اوجب غرمه علي من قتله فقال عز وجل @QB@ ومن قتله منكم متعمدا فجزاء مثل ما قتل من النعم @QE@ فلما كان القتل غير محرم لم يكن علي المحرم فيما جني غيره فدية كما لو قتل من اجله مسلما لم يكن علي المقتول من اجله عقل ولا كفارة ولا قود فان الله قضي ان لا تزر وازرة وزر اخري قال ولما كان الصيد مقتولا فامسك المحرم عن اكله ومن اجله صيد لم يكن عليه فيه فدية بان صيد من اجله لم يجز ان يكون صيدا مقتولا لا فدية فيه حين قتل وياكله بشر لا فدية عليهم فاذا اكله واحد فداه وانما نقطع الفدية فيه بالقتل فاذا كان القتل ولا فدية لم يجز ان تكون فدية لانه لم يحدث بعدها قتلا يوجب فدية قلت ان الاكل غير جاءز للمحرم وانما امرته بالفدية لذلك قال وكذلك لا يجوز للمحرم اكل ميتة ولا شرب خمر ولا محرم ولا فدية عليه في شء من هذا وهو اثم بالاكل والفدية في الصيد انما تكون بالقتل فقلت للشافعي فهل خالفك في هذا غيرنا فقال ما علمت احدا غيركم زعم ان من اكل لحم صيد صيد من اجله فداه بل علمت ان من المشرقيين من قال له ان ياكله لانه مال لغيره اطعمه اياه ولولا اتباع الحديث فيه لكان القول عندنا قوله ولكنه خالف الحديث فخالفناه فان كانت لنا عليه حجة بخلاف بعض الحديث فهي لنا عليك بخلافك بعضه وهو يعرف ما يقول وان زل عندنا ولستم والله يعافينا واياكم تعرفون كثيرا مما تقولون ارايت لو ان رجلا اعطي رجلا سلاحا ليقويه علي قتل حر او عبد فقتله المعطي كان علي المعطي عقل او قود قال لا ولكنه مسء اثم بتقوية القاتل قلت وكذلك لو قتله ولا علم له بجناية علي قتله ورضيه قال نعم ( قال الشافعي ) رحمه الله تعالي افلا تري هذا اولي ان يكون عليه عقل او قود او كفارة ممن قتل من اجله صيد لا يعلمه فاكله فاذا قلت انما جعل العقل والقود بالقتل فهذا غير قاتل ( قال الشافعي ) اخبرنا مالك ان ابا ايوب الانصاري قال كان الرجل يضحي بالشاة الواحدة عنه وعن اهله ثم تباهي الناس فصارت مباهاة
   * باب ما جاء في خلاف عاءشة في لغو اليمين
  * فقلت للشافعي ما لغو اليمين قال الله اعلم اما الذي نذهب اليه فهو ما قالت عاءشة ( قال الشافعي ) اخبرنا مالك عن هشام بن عروة عن ابيه عن عاءشة انها قالت لغو اليمين قول الانسان لا والله وبلي والله فقلت للشافعي وما الحجة فيما قلت قال الله اعلم اللغو في لسان العرب الكلام غير المعقود عليه وجماع اللغو يكون الخطا  ( قال الشافعي ) فخالفتموه وزعمتم ان اللغو حلف الانسان علي الشء يستيقن انه كما حلف عليه ثم يوجد علي خلافه ( قال الشافعي ) وهذا ضد اللغو هذا هو الاثبات في اليمين يقصدها يحلف لا يفعله يمنعه السبب لقول الله تبارك وتعالي @QB@ ولكن يءاخذكم بما عقدتم الايمان @QE@ ما عقدتم ما عقدتم به عقد الايمان عليه ولو احتمل اللسان ما ذهبتم اليه ما منع احتماله ما ذهبت اليه عاءشة وكانت اولي ان تتبع منكم لانها اعلم باللسان منكم مع علمها بالفقه ( قال الشافعي ) اخبرنا مالك عن يحيي بن سعيد عن القاسم بن محمد عن عاءشة التشهد قال فخالفتموها فيه الي قول عمر
   * باب في بيع المدبر
  * ( قال الشافعي ) اخبرنا مالك عن ابي الرجال محمد بن عبد الرحمن عن امه عمرة ان عاءشة دبرت جارية لها فسحرتها فاعترفت بالسحر فامرت بها عاءشة ان تباع من الاعراب ممن يسء ملكتها فبيعت قال فخالفتموها فقلتم لا يباع مدبر ولا مدبرة ونحن نقول بقول عاءشة وغيرها
   * باب ما جاء في لبس الخز
  * فقلت للشافعي فما تقول في لبس الخز قال لا باس به الا ان يدعه رجل لياخذ باقصد منه فاما لان لبس الخز حرام فلا ( قال الشافعي ) رحمه الله اخبرنا مالك عن هشام عن ابيه عن عاءشة انها كست عبد الله بن الزبير مطرف خز كانت تلبسه ( قال الشافعي ) وروينا ان القاسم دخل عليها في غداة باردة ( ( ( بادرة ) ) ) وعليه مطرف خز فالقاه عليها فلم تنكره فقلت للشافعي فانا نكره لبس الخز فقال اوما رويتم هذا عن عاءشة فقلت بلي فقال لاي شء خالفتموها ومعها بشر لا يرون به باسا فلم يزل القاسم يلبسه حتي بيع في ميراثه فيما بلغنا فاذا شءتم جعلتم قول القاسم حجة واذا شءتم تركتم ذلك علي عاءشة والقاسم ومن شءتم والله المستعان
   * باب خلاف بن عباس في البيوع
  * ( قال الشافعي ) اخبرنا مالك بن انس عن يحيي بن سعيد عن القاسم بن محمد قال سمعت بن عباس ورجل يساله عن رجل سلف في سباءب فاراد ان يبيعها فقال بن عباس تلك الورق بالورق وكره ذلك قال مالك وذلك فيما نري لانه اراد بيعها من صاحبه الذي اشتراها منه باكثر من الثمن الذي ابتاعها به ولو باعها من غير الذي اشتراها منه لم يكن ببيعه باس وقلتم به وليس هذا قول بن عباس ولا تاويل حديث ( قال الشافعي ) رحمه الله تعالي اخبرنا سفيان عن عمرو بن دينار عن طاوس عن بن عباس قال اما الذي نهي عنه رسول الله صلي الله عليه وسلم فهو الطعام ان يباع حتي يقبض قال بن عباس برايه ولا احسب كل شء الا مثله ( قال الشافعي ) وبقول بن عباس ناخذ لانه اذا باع شيءا اشتراه قبل ان يقبضه فقد باع مضمونا له علي غيره واصل البيع لم يبرا اليه منه واكل ربح ما لم يضمن وخالفتموه فاجزتم بيع ما لم يقبض سوي الطعام من غير صاحبه الذي اتبع به ( قال الشافعي ) رحمه الله تعالي ولا اعلم بين صاحبه الذي ابتيع منه وغيره فرقا لءن لم يكن ذلك فهل الحجة عليه الا ان يقال مخرج قول النبي صلي الله عليه وسلم عام فلا يصلح ان يكون خاصا فكيف نهي عنه بن عباس وانتم لا تروون خلاف هذا عن احد علمته وعن بن عباس ان امراة جعلت علي نفسها مشيا الي مسجد قباء فماتت قبل ان تقضي فامر ابنتها ان تمشي عنها  فقلت للشافعي فانا نقول لا يمشي احد عن احد ( قال الشافعي ) احسب بن عباس انما ذهب الي ان المشي الي قباء نسك فامرها ان تنسك عنها وكيف خالفتموه ولا اعلمكم رويتم عن احد اصحاب النبي صلي الله عليه وسلم خلافه
   * باب
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن ابي الزبير عن عطاء بن ابي رباح عن بن عباس انه سءل عن رجل وقع علي اهله وهو محرم وهو بمني قبل ان يفيض فامره ان ينحر بدنة ( قال الشافعي ) وبهذا ناخذ قال مالك عليه عمرة وبدنة وحجة تامة ورواه عن ربيعة فترك قول بن عباس بخبر ربيعة ورواه عن ثور بن يزيد عن عكرمة يظنه عن بن عباس ( قال الشافعي ) وهو سء ( ( ( سيء ) ) ) القول في عكرمة لا يري لاحد ان يقبل حديثه وهو يروي سفيان عن عطاء عن بن عباس خلافه وعطاء ثقة عنده وعند الناس قال والعجب له ان يقول في عكرمة ما يقول ثم يحتاج الي شء من علمه يوافق قوله ويسميه مرة ويروي عنه ظنا ويسكت عنه مرة فيروي عن ثور بن يزيد عن بن عباس في الرضاع وذباءح نصاري العرب وغيره وسكت عن عكرمة وانما حدث به ثور عن عكرمة وهذا من الامور التي ينبغي لاهل العلم ان يتحفظوا منها فياخذ بقول بن عباس من نسي من نسكه شيءا او تركه فليهرق دما فيقيس عليه ما شاء الله من الكثرة ويترك قوله في غير هذا منصوصا لغير معني هل راي احدا قط تم حجة يعمل في الحج بشء ما لا ينبغي له فقضاه بعمرة فكيف يعتمر عنده وهو في بقية من حجه فان قلتم نعمره بعد الحج فكيف يكون حج قد خرج منه كله وقضي عنه حجة الاسلام وقد خرج من احرامه في الحج ثم نقول احرم بعمرة عن حج ما علمت احدا من مفتي الامصار قال هذا قبل ربيعة الا ما روي عن عكرمة وهذا من قول ربيعة عفا الله عنا وعنه من ( ( ( ومن ) ) ) ضرب من افطر يوما من رمضان قضي باثني عشر يوما ومن قبل امراته وهو صاءم اعتكف ثلاثة ايام وما اشبه هذا من اقاويل كان يقولها قال والعجب لكم وانتم لا تستوحشون من الترك علي ربيعة ما هو احسن من هذا فكيف تتبعونه فيه
   * باب خلاف زيد بن ثابت في الطلاق
  * سالت الشافعي عن الرجل يملك امراته امرها فتطلق نفسها ثلاثا فقال القول قول الزوج فان قال انما ملكتها امرها في واحدة لا في ثلاث كان القول قوله وهي واحدة وهو احق بها فقلت له ما الحجة في ذلك قال اخبرنا مالك عن سعيد بن سليمان بن زيد بن ثابت عن خارجة بن زيد بن ثابت انه اخبره انه كان جالسا عند زيد بن ثابت فاتاه محمد بن ابي عتيق وعيناه تدمعان فقال له زيد ما شانك فقال ملكت امراتي امرها ففارقتني فقال له زيد ارتجعها ان شءت فانما هي واحدة وانت احق بها فقلت للشافعي فانا نقول هي ثلاث الا ان يناكرها وروي شبيها بذلك عن بن عمر ومروان بن الحكم ( قال الشافعي ) ما اراكم تبالون من خالفتم فان ذهبتم الي قول بن عمر ومروان دون قول زيد فباي وجه ذهبتم اليه فهل يعدو المملك امراته امرها اذا طلقت نفسها ثلاثا ان يكون اصل التمليك اخراج جميع ما في يده من طلاقها اليها فاذا طلقت نفسها لزمه ولم تنفعه مناكرتها او لا يكون اخراج جميعه فيكون محتملا لاخراج الجميع والبعض فيكون القول قوله فيه واذا كان القول قول الزوج فلو ملكها واحدة فطلقت نفسها ثلاثا لم يكن لها ان تطلق الا واحدة واسمعكم اذا اخترتم والله يغفر لنا ولكم لا تعرفون كيف موضع الاختيار وما موضع المناكرة فيه الا ما وصفت والله اعلم 
   * باب في عين الاعور
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن يحيي بن سعيد عن بكير بن الاشج عن سليمان بن يسار ان زيد بن ثابت قضي في العين القاءمة اذا اطفءت او قال بخقت بماءة دينار قال مالك ليس بهذا العمل انما فيها الاجتهاد لا شء مءقت ( قال الشافعي ) اخبرنا مالك ان انس بن مالك كبر حتي لا يقدر علي الصيام فكان يفتدي وخالفه مالك فقال ليس عليه بواجب ( قال الشافعي ) اخبرنا مالك عن ربيعة عن ابي بكر بن حزم انه كان يصلي في قميص فقلت انا نكره هذا فقال كيف كرهتم ما استحب ابو بكر ( قال الشافعي ) اخبرنا مالك عن ربيعة ان القاسم يعني بن محمد كان يبيع ثمر حاءطه ويستثني منه ( قال الشافعي ) اخبرنا مالك عن ابي الرجال محمد بن عبد الرحمن عن عمرة بنت عبد الرحمن انها كانت تبيع ثمارها وتستثني منها ( قال الشافعي ) اخبرنا مالك عن يحيي بن سعيد عن القاسم بن محمد ان رجلا كانت عنده وليدة قوم فقال لاهلها شانكم بها فراي الناس انها تطليقة قال مالك الامر المجتمع عليه عندنا ان الرجل اذا باع ثمر حاءط فلا باس ان يستثني منه ما بينه وبين ثلث الثمر لا يجاوزه ( قال الشافعي ) ايضا يروي عن القاسم وعمرة الاستثناء ولم يرو عنهما حد الاستثناء ولو جاز ان يستثني منه سهما من الف سهم ليجوز تسعة اعشاره واكثر ولا ادري من اجتمع لكم علي هذا والذي يروي خلاف ما يقول ( قال الشافعي ) ولا يجوز الاستثناء الا ان يكون البيع واقعا علي شء والمستثني خارج من البيع وذلك ان يقول ابيعك ثمر حاءطي الا كذا وكذا نخلة فيكون النصف خارجا من البيع او ابيعك ثمره الا نصفه او الا ثلثه فيكون ما استثني خارجا من البيع ( قال الشافعي ) اخبرنا مالك عن ربيعة ان رجلا اتي القاسم فقال اني افضت وافضت معي باهلي فعدلت الي شعب فذهبت لادنو منها فقالت امراتي لم اقصر من شعر راسي بعد فاخذت من شعر راسها باسناني ثم وقعت بها قال فضحك القاسم ثم قال فمرها فلتاخذ من راسها بالجلمين ( قال الشافعي ) وهذا كما قال القاسم اذا قصر من راسها باسنانه اجزا عنها من الجلمين قال مالك يهريق دما وخالف القاسم لقول نفسه ( قال الشافعي ) اخبرنا مالك انه سال عبد الرحمن بن القاسم من اين القاسم يرمي جمرة العقبة قال من حيث تيسر قال مالك لا احب ان يرميها الا من بطن المسيل ولم يرو فيها خلافا عن احد
   * باب خلاف عمر بن عبد العزيز في عشور اهل الذمة
  * ( قال الشافعي ) اخبرنا مالك عن يحيي بن سعيد عن زريق بن حيان وكان زريق علي جواز مصر في زمان الوليد وسليمان وعمر بن عبد العزيز فذكر ان عمر بن عبد العزيز كتب اليه ان انظر من مر بك من المسلمين فخذ مما ظهر من اموالهم مما يديرون للتجارات من كل اربعين دينارا دينارا فما نقص فبحساب ذلك حتي يبلغ عشرين دينارا فان نقص من عشرين دينارا ثلث دينار فدعها ولا تاخذ منها شيءا ومن مر بك من اهل الذمة فخذ مما يديرون من التجارات من اموالهم من كل عشرين دينارا دينارا فما نقص فبحساب ذلك حتي يبلغ عشرة دنانير فان نقصت ثلث دينار فدعها ولا تاخذ منها شيءا واكتب لهم بما تاخذ منهم كتابا الي مثله من الحول ( قال الشافعي ) وبقول عمر ناخذ لا يءخذ منهم الا مرة في الحول وخالفتموه ان اختلفوا في السنة مرارا وخالفتم عمر بن عبد العزيز في عشرين دينارا ان نقص ثلث دينار فاخبرت عنه انه قال ان جازت جواز الوازنة اخذت منه الزكاة ولو نقصت اكثر وان لم تجز جواز الوازنة وهي تنقص ثلث دينار او اكثر او اقل لم يءخذ منها  زكاة وزعمتم ان الدراهم ان نقصت عن ماءتي درهم وهي تجوز جواز الوازنة اخذت منها الزكاة ( قال الشافعي ) لسنا نقول بهذا اذا قال رسول الله صلي الله عليه وسلم ليس فيما دون خمس اواق صدقة فهو كما قال رسول الله صلي الله عليه وسلم فلو نقصت حبة لم يكن فيها صدقة لان ذلك دون خمس اواق وانتم لم تقولوا بحديث النبي صلي الله عليه وسلم الذي روي ليس فيما دون خمس اواق صدقة وهو سنة ولا بقول عمر بن عبد العزيز ( قال الشافعي ) اخبرنا مالك انه سال بن شهاب عن الزيتون فقال فيه العشر وخالفه مالك فقال لا يءخذ العشر الا من زيته وجواب بن شهاب علي حبه ( قال الشافعي ) اخبرنا مالك ان عمر بن عبد العزيز كتب انما الصدقة في العين والحرث والماشية قال مالك لا صدقة الا في عين او حرث او ماشية وقال مالك في العرض الذي يدار صدقة ( قال الشافعي ) اخبرنا مالك انه بلغه ان سعيدا يعني بن المسيب وسليمان بن يسار سءلا هل في الشفعة سنة فقالا جميعا نعم الشفعة في الدور والارضين ولا تكون الشفعة الا بين القوم الشركاء ( قال الشافعي ) وبهذا ناخذ وتاخذون في الجملة وفي هذا يعني ان تكون الشفعة الا فيما كانت له ارض فانه يقسم وقد روي مالك عن عثمان انه قال لا شفعة في بءر ولا فحل نخل وقال مالك لا شفعة في طريق ولا عرصة دار وان صلح فيها القسم وقال فيمن اشتري شقصا من دار او حيوان او عرض الشفعة في الشقص بقدر ما يصيبه من الثمن ثم خالفتم معني هذا في المكاتب فجعلتم نجومه تباع وجعلتموه احق بما يباع منه بالشفعة
   * باب خلاف سعيد وابي بكر في الايلاء
  * ( قال الشافعي ) اخبرنا مالك عن بن شهاب عن سعيد يعني بن المسيب وابي بكر بن عبد الرحمن انهما كانا يقولان في الرجل يولي من امراته اذا مضت اربعة اشهر فهي تطليقة ولزوجها عليها الرجعة ما كانت في العدة وقال مالك ان مروان كان يقضي في الرجل اذا الي من امراته انها اذا مضت الاربعة الاشهر فهي تطليقة وله عليها الرجعة ما كانت في العدة قال مالك وعلي ذلك راي بن شهاب ( قال الشافعي ) اخبرنا مالك عن يحيي بن سعيد عن سعيد بن المسيب انه سءل عن المراة يطلقها زوجها في بيت بكراء علي من الكراء فقال سعيد علي زوجها قال فان لم يكن عند زوجها قال فعلي الامير
   * باب في سجود القران
  * سالت الشافعي عن السجود في سورة الحج فقال فيها سجدتان فقلت وما الحجة في ذلك فقال اخبرنا مالك عن نافع ان رجلا من اهل مصر اخبره ان عمر بن الخطاب سجد في سورة الحج سجدتين ثم قال ان هذه السورة فضلت بسجدتين ( قال الشافعي ) اخبرنا ابراهيم بن سعد عن الزهري عن عبد الله بن ثعلبة بن صغير ان عمر بن الخطاب صلي بهم بالجابية بسورة الحج فسجد فيها سجدتين فقلت للشافعي فانا لا نسجد فيها الا سجدة واحدة ( قال الشافعي ) فقد خالفتم ما رويتم عن عمر بن الخطاب وعبد الله بن عمر معا الي غير قول احد من اصحاب النبي صلي الله عليه وسلم فكيف تتخذون قول عمر وحده حجة وبن عمر وحده حجة حتي تردوا بكل واحد منهما السنة وتبنون عليهما عددا من الفقه ثم تخرجون من قولهما لراي انفسكم هل تعلمون يستدرك علي احد قول العورة فيه ابين منها فيما وصفت من اقاويلكم وسالت الشافعي عما روي صاحبنا وحده في المحصب فقال اخبرنا مالك عن بن عمر قال كان يصلي الظهر والعصر والمغرب والعشاء بالمحصب ثم يدخل مكه من الليل فيطوف بالبيت قلت للشافعي  نحن نقول لا ينبغي لعالم ان يفعله ( قال الشافعي ) ما علي العالم من النسك ما ليس علي غيره قلت هو العالم والجاهل ( قال الشافعي ) فان تركاه قلت لا فدية علي واحد منهما قال ولكنكم من اصل مذهبكم ان من ترك من نسكه شيءا اهراق دما فان كان نسكا فقد تركتم اصل قولكم وان كان منزل سفر لا منزل نسك فلا تامر عالما ولا جاهلا ان ينزله
   * باب غسل الجنابة
  * ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر انه كان اذا اغتسل من الجنابة نضح في عينيه الماء قال مالك ليس عليه العمل ( قال الشافعي ) هذا مما تركتم علي بن عمر ولم ترووا عن احد خلافه فاذا وسعكم الترك علي بن عمر لغير قول مثله لم يجز لكم ان تقولوا قوله حجة علي مثله وانتم تدعون عليه لانفسكم وان جاز لكم ان تحتجوا به علي مثله لم يجز تركه لانفسكم
   * باب في الرعاف
  * ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر انه كان اذا رعف انصرف فتوضا ثم رجع ولم يتكلم ( قال الشافعي ) فمالك روي عن بن المسيب وبن عباس مثله ( قال الشافعي ) اخبرنا عبد المجيد بن عبد العزيز عن بن جريج عن الزهري عن سالم عن ابيه انه كان يقول من اصابه رعاف او من وجد رعافا او مذيا او قيءا انصرف فتوضا ثم رجع فبني وقال المسور بن مخرمة يستانف ثم زعمتم انه انما يغسل الدم وعبيدالله بن عمر يروي عن نافع انه كان ينصرف فيغسل الدم ويتوضا للصلاة والوضوء في الظاهر في روايتكم انما هو وضوء الصلاة وهذا يشبه الترك لما رويتم عن بن عمر وبن عباس وبن المسيب في رواية غيركم انه يبني في المذي وزعمتم انكم لا تبنون في المذي
   * باب الغسل بفضل الجنب والحاءض
  * ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر انه كان يقول لا باس بفضل المراة ما لم تكن حاءضا او جنبا قال مالك لا باس ان يغتسل بفضل الجنب والحاءض قلت للشافعي انت تقول بقول مالك قال نعم ولست اري قول احد مع قول النبي صلي الله عليه وسلم حجة انما تركته لان النبي صلي الله عليه وسلم كان يغتسل وعاءشة فاذا اغتسلا معا كان كل واحد منهما يغتسل بفضل صاحبه وانتم تجعلون قول بن عمر حجة علي السنة وتجعلون سنة اخري حجة عليه ان كنتم تركتموه علي بن عمر فلعلكم لا تكونون تركتموه عليه الا بشء عرفتموه
   * باب التيمم
  * ( قال الشافعي ) اخبرنا مالك عن نافع انه اقبل هو وبن عمر من الجرف حتي اذا كانوا بالمربد نزل فتيمم صعيدا فمسح بوجهه ويديه الي المرفقين ثم صلي ( قال الشافعي ) اخبرنا سفيان عن بن عجلان عن نافع عن بن عمر انه تيمم بمربد الغنم وصلي العصر ثم دخل المدينة والشمس مرتفعة فلم يعد العصر قلت للشافعي فانا نقول اذا كان المسافر يطمع بالماء فلا يتيمم الا في اخر الوقت فان تيمم قبل اخر الوقت وصلي ثم وجد الماء قبل ذهاب الوقت توضا واعاد ( قال الشافعي ) رحمه الله تعالي هذا خلاف قول بن عمر المربد بطرف المدينة وقد تيمم به بن عمر ودخل  وعليه من الوقت شء صالح فلم يعد الصلاة فكيف خالفتموه في الامرين معا ولا اعلم احدا مثله قال بخلافه فلو قلتم بقوله ثم خالفه غيركم كنتم شبيها ان تقولوا تخالف بن عمر لغير قول مثله ثم تخالفه ايضا في الصلاة وبن عمر الي ان يصلي ما ليس عليه اقرب منه الي ان يدع صلاة عليه
   * باب الوتر
  * ( قال الشافعي ) اخبرنا مالك عن نافع قال كنت مع بن عمر بمكة والسماء متغيمة فخشي بن عمر الصبح فاوتر بواحدة ثم انكشف الغيم فراي عليه ليلا فشفع بواحدة ( قال الشافعي ) وانتم تخالفون بن عمر من هذا في موضعين فتقولون لا يوتر بواحدة ومن اوتر لا يشفع وتره ولا اعلمكم تحفظون عن احد انه قال لا يشفع وتره فقلت للشافعي ما تقول انت في هذا قال بقول بن عمر انه يوتر بركعة قلت افتقول يشفع وتره فقال لا فقلت وما حجتك فيه قال روينا عن بن عباس انه كره لابن عمر ان يشفع وتره وقال اذا اوترت فاشفع من اخره ولا تعد وترا ولا تشفعه وانتم زعمتم انكم لا تقبلون الا حديث صاحبكم وليس من حديث صاحبكم خلاف بن عمر
   * باب الصلاة بمني والنافلة في السفر
  * ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر انه كان يصلي وراء الامام بمني اربعا فاذا صلي لنفسه صلي ركعتين ( قال الشافعي ) هذا يدل علي ان الامام اذا ( ( ( اذ ) ) ) كان من اهل مكة صلي بمني اربعا لانه لا يحتمل الا هذا او يكون الامام من غير اهل مكة يتم بمني لان الامام في زمان بن عمر من بني امية وقد اتموا باتمام عثمان قال وهذا يدل علي ان المسافر لو اتم بقوم لم تفسد صلاتهم عند بن عمر لان صلاته لو كانت تفسد لم يصل معه ( قال الشافعي ) وبهذا نقول وانتم تخالفون ما رويتم عن بن عمر لغير راي احد رويتموه يخالف بن عمر بل مع بن عمر فيه غيره من اصحاب النبي صلي الله عليه وسلم يوافقه وتخالفونه بن مسعود عاب اتمام الصلاة بمني ثم قام فاتمها فقيل له في ذلك فقال الخلاف شر ولو كان ذلك يفسد صلاته لم يتم وخالف فيه ولكنه راه واسعا فاتم وان كان الفضل عنده في القصر ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر انه لم يكن يصلي مع الفريضة في السفر شيءا قبلها ولا بعدها الا من جوف الليل ( قال الشافعي ) ومعروف عن بن عمر عيب النافلة في النهار في السفر قال مالك لا باس بالنافلة في السفر نهارا قال فقلت للشافعي فانا نقول بقول صاحبنا فقال الشافعي كيف خالفتم بن عمر واستحببتم ما كره ولم اعلمكم تحفظون فيه شيءا يخالف هذا يدل علي ان احتجاجكم بقول بن عمر استتار من الناس لانه لا ينبغي لاحد ان يخالف الحجة عنده
   * باب القنوت
  * ( قال الشافعي ) اخبرنا مالك عن نافع ان بن عمر كان لا يقنت في شء من الصلوات ( قال الشافعي ) وانتم ترون القنوت في الصبح ( قال الشافعي ) اخبرنا مالك عن هشام بن عروة اظنه عن ابيه ( الشك من الربيع ) انه كان لا يقنت في شء من الصلاة ولا في الوتر الا انه كان يقنت في صلاة الفجر قبل ان يركع الركعة الاخرة اذا قضي قراءته ( قال الشافعي ) وانتم تخالفون عروة فتقولون يقنت بعد الركوع فقلت للشافعي فانت تقنت ( ( ( تيقنت ) ) ) في الصبح بعد الركوع فقال نعم لان النبي صلي الله عليه وسلم قنت ثم ابو بكر ثم عمر ثم عثمان قلت فقد وافقناك قال اجل من حيث لا تعلمون وموافقتكم في هذا حجة عليكم في غيره فقلت من اين قال انتم تتركون الحديث عن النبي صلي الله عليه وسلم  في الحج عن الرجل بقياس علي قول بن عمر وتقولون لا يجهل بن عمر قول النبي صلي الله عليه وسلم فقلت للشافعي قد يذهب علي بن عمر بعض السنن ويذهب عليه حفظ ما شاهد منها فقال الشافعي اويخفي عليه القنوت والنبي صلي الله عليه وسلم يقنت عمره وابو بكر او يذهب عليه حفظه فقلت نعم ( قال الشافعي ) اقاويلكم مختلفة كيف نجدكم تروون عنه انكار القنوت ويروي غيركم من المدنيين القنوت عن النبي صلي الله عليه وسلم وخلفاءه فهذا يبطل ان العمل كما تقول في كل امر ويبطل قولكم لا يخفي علي بن عمر سنة واذا جاز عليه ان ينسي او يذهب عليه ما شاهد كان ان النبي صلي الله عليه وسلم امر امراة ان تحج عن ابيها من العلم من هذا اولي ان يذهب عليه ولا يجعل قوله حجة علي السنة وانها عليك في رد الحديث زعمت ان يكون لا يذهب علي بن عمر ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر في التشهد ( قال الشافعي ) وخالفته الي قول عمر فاذا كان التشهد وهو من الصلاة وعلم العامة مختلف فيه بالمدينة تخالف فيه بن عمر وعمر وعاءشة فاين الاجتماع والعمل ما كان ينبغي لشء ان يكون اولي ان يكون مجتمعا عليه من التشهد وما روي فيه مالك صاحبك الا ثلاثة احاديث مختلفة كلها حديثا ( ( ( حديثان ) ) ) منها يخالفان (  ) فيها عمر وعمر يعلمهم التشهد علي المنبر ثم تخالف فيها ابنه وعاءشة فكيف اذا ادعي ان يكون الحاكم اذا حكم ثم قال او عمل اجمع عليه بالمدينة وما يجوز ادعاء الاجماع الا بخبر ولو ذهب ذاهب يجيزه كانت الاحاديث ردا لاجازته
   * باب الصلاة قبل الفطر وبعده
  * ( قال الشافعي ) اخبرنا مالك عن نافع ان بن عمر لم يكن يصلي يوم الفطر قبل الصلاة ولا بعدها ( قال الشافعي ) اخبرنا مالك عن هشام بن عروة عن ابيه انه كان يصلي يوم الفطر قبل الصلاة وبعدها ( قال الشافعي ) اخبرنا مالك عن عبد الرحمن بن القاسم ان اباه كان يصلي قبل ان يغدو الي المصلي اربع ركعات ( قال الشافعي ) والذي يروي الاختلاف فاين الاجماع اذا كانوا يختلفون في مثل هذا من الصلاة وما تقولون انتم قالوا لا نري باسا ان يصلي قبل الصلاة وبعدها ( قال الشافعي ) فاذا خالفتم بن عمر واذا جاز خلاف بن عمر في هذا لقول الرجل من التابعين ايجوز لغيركم خلافه لقول رجل من التابعين او تضيقون علي غيركم ما توسعون علي انفسكم فتكونون غير منصفين ويكون هذا غير مقبول من احد ويجوز ان تدع علي بن عمر لرجل من التابعين ولراي صاحبك وتجعل قول بن عمر حجة علي السنة في موضع اخر ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر في صلاة الخوف بشء خالفتموه فيه ومالك يقول لا اراه حكي الا عن النبي صلي الله عليه وسلم وبن ابي ذءب يرويه عن الزهري عن سالم عن بن عمر عن النبي صلي الله عليه وسلم لا يشك فيه ( قال الشافعي ) فاذا تركتم علي بن عمر رايه وروايته في صلاة الخوف بحديث يزيد بن رومان عن النبي صلي الله عليه وسلم فكيف تتركون حديثا عن النبي صلي الله عليه وسلم اثبت من حديث يزيد بن رومان لراي بن عمر ثم تدعون حديث يزيد بن رومان لقول سهل بن ابي حثمة فتدعون السنة لقول سهل فما اعرف لكم في العلم مذهبا يصح والله المستعان
   * باب نوم الجالس والمضطجع
  * ( قال الشافعي ) اخبرنا مالك عن نافع ان بن عمر كان ينام وهو قاعد ثم يصلي ولا يتوضا ( قال الشافعي ) وهكذا نقول وان طال ذلك لا فرق بين طويله وقصيره اذا كان جالسا مستويا علي الارض ونقول اذا كان مضطجعا  اعاد الوضوء ( قال الشافعي ) اخبرنا الثقة عن عبيد الله بن عمر عن نافع عن بن عمر انه قال من نام مضطجعا وجب عليه الوضوء ومن نام جالسا فلا وضوء عليه فقلت للشافعي فانا نقول ان نام قليلا قاعدا لم ينتقض وضوءه وان تطاول ذلك توضا ( قال الشافعي ) ولا يجوز في النوم قاعدا الا ان يكون حكمه حكم المضطجع قليله وكثيره سواء او خارجا من ذلك الحكم فلا ينقض الوضوء قليله ولا كثيره فقلت للشافعي فانا نقول ان نام قليلا قاعدا لم ينتقض وضوءه وان تطاول ذلك توضا ( قال الشافعي ) فهذا خلاف بن عمر وخلاف غيره والخروج من اقاويل الناس قول بن عمر كما حكي مالك وهو لا يري في النوم قاعدا وضوءا وقول الحسن من خالط النوم قلبه جالسا وغير جالس فعليه الوضوء وقولكم خارج منهما ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر انه بال في السوق فتوضا فغسل وجهه ويديه ومسح براسه ثم دخل المسجد فدعا للجنازة فمسح علي خفيه ثم صلي قلت للشافعي فانا نقول لا يجوز هذا انما يمسح ( ( ( يسمح ) ) ) بحضرة ذلك ومن صنع مثل هذا استانف فقال الشافعي اني لاري خلاف بن عمر عليكم خفيفا لراي انفسكم لا بل لا نعلمكم تروون في هذا عن احد شيءا يخالف قول بن عمر وان جاز زلل بن عمر عندكم وانما زعمتم ان الحجة في قول انفسكم فلم تكلفتم الرواية عن غيركم وقد جعلتم انفسكم بالخيار تقبلون ما شءتم بلا حجة
   * باب اسراع المشي الي الصلاة
  * ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر انه سمع الاقامة وهو بالبقيع فاسرع المشي الي المسجد ( قال الشافعي ) وكرهتم زعمتم اسراع المشي الي المسجد فقلت للشافعي نحن نكره الاسراع الي المسجد اذا اقيمت الصلاة ( قال الشافعي ) فان كنتم كرهتموه لقول النبي صلي الله عليه وسلم اذا اتيتم الصلاة فلا تاتوها وانتم تسعون واءتوها تمشون وعليكم السكينة فقد اصبتم وهكذا ينبغي لكم في كل امر لرسول الله فيه سنة فاما ان قياس قول بن عمر ويخطء القياس عليه حجة علي ان رسول الله صلي الله عليه وسلم امر امراة تحج عن ابيها ورجلا يحج عن ابيه فقال لا يحج احد عن احد لان بن عمر قال لا يصلي احد عن احد فكيف يجوز لمسلم ان يدع ما يروي عن رسول الله الي ما يروي عن غيره ثم يدعه لقياس يخطء فيه وهو هنا يصيب في ترك ما روي عن بن عمر اذ روي عن النبي صلي الله عليه وسلم خلافه ثم يزيد فيخرج الي خلاف بن عمر معه سنة رسول الله صلي الله عليه وسلم في غير هذا الموضع
   * باب رفع الايدي في التكبير
  * سالت الشافعي عن رفع الايدي في الصلاة فقال يرفع المصلي يديه اذا افتتح الصلاة حذو منكبيه واذا اراد ان يركع واذا رفع راسه من الركوع رفعهما كذلك ولا يفعل ذلك في السجود فقلت للشافعي فما الحجة في ذلك فقال اخبرنا هذا بن عيينة عن الزهري عن سالم عن ابيه عن النبي صلي الله عليه وسلم مثل قولنا فقلت فانا نقول يرفع في الابتداء ثم لا يعود ( قال الشافعي ) اخبرنا مالك عن نافع ان بن عمر كان اذا ابتدا الصلاة يرفع يديه حذو منكبيه واذا رفع من الركوع رفعهما كذلك وهو يري عن النبي صلي الله عليه وسلم انه كان اذا افتتح الصلاة رفع يديه حذو منكبيه واذا رفع راسه من الركوع رفعهما كذلك ثم خالفتم رسول الله صلي الله عليه وسلم وبن عمر فقلتم لا يرفع يديه الا في ابتداء الصلاة وقد رويتم عنهما انهما رفعا في الابتداء وعند الرفع من الركوع  ( قال الشافعي ) افيجوز لعالم ان يترك علي النبي صلي الله عليه وسلم وبن عمر لراي نفسه او علي النبي صلي الله عليه وسلم لراي بن عمر ثم القياس علي قول بن عمر ثم ياتي موضع اخر ويصيب فيه يترك علي بن عمر لما روي عن النبي صلي الله عليه وسلم فكيف لم ينهه بعض هذا عن بعض ارايت ان جاز له ان يروي عن النبي صلي الله عليه وسلم انه رفع يديه في الصلاة مرتين او ثلاثا وعن بن عمر فيه اثنتين وياخذ بواحدة ويترك واحدة ايجوز لغيره ترك الذي اخذ به واخذ الذي ترك او يجوز لغيره تركه عليه ( قال الشافعي ) لا يجوز له ولا لغيره ترك ما روي عن النبي صلي الله عليه وسلم فقلت للشافعي فان صاحبنا قال ما معني رفع الايدي ( قال الشافعي ) هذه الحجة غاية من الجهل معناه تعظيم الله واتباع السنة معني الرفع في الاول معني الرفع الذي خالف فيه النبي صلي الله عليه وسلم عند الركوع وبعد رفع الراس من الركوع ثم خالفتم فيه روايتكم عن النبي صلي الله عليه وسلم وبن عمر معا لغير قول واحد روي عنه رفع الايدي في الصلاة تثبت روايته يروي ذلك عن رسول الله ثلاثة عشر او اربعة عشر رجلا ويروي عن اصحاب النبي صلي الله عليه وسلم من غير وجه فقد ترك السنة
   * باب وضع الايدي في السجود
  * ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر انه كان اذا سجد يضع كفيه علي الذي يضع عليه وجهه قال ولقد رايته في يوم شديد البرد يخرج يديه من تحت برنس له ( قال الشافعي ) وبهذا ناخذ وهذا يشبه سنة النبي صلي الله عليه وسلم ( قال الشافعي ) اخبرنا سفيان عن بن طاوس عن ابيه عن بن عباس قال امر النبي صلي الله عليه وسلم ان يسجد علي سبع فذكر منها كفيه وركبتيه ( قال الشافعي ) ففعل في هذا بما امر به ففعل النبي صلي الله عليه وسلم فافضي بيده الي الارض وان كان البرد شديدا كما يفضي بجبهته الي الارض فان كان فبهذا كله نقول وخالفتم هذا عن بن عمر حيث وافق سنة النبي صلي الله عليه وسلم فقلتم لا يفضي بيديه الي الارض في حر ولا برد ان شاء الله
   * باب من الصيام
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع ان بن عمر سءل عن المراة الحامل اذا خافت علي ولدها فقال تفطر وتطعم مكان كل يوم مسكينا مدا من حنطة قال مالك واهل العلم يرون عليها من ذلك القضاء قال مالك عليها القضاء لان الله عز وجل يقول @QB@ فمن كان منكم مريضا او علي سفر فعدة من ايام اخر @QE@ قال الشافعي واذا كان له ان يخالف بن عمر لقول القاسم ويتاول في خلاف بن عمر القران ولا يقلده فيقول هذا اعلم بالقران منا ومذهب بن عمر يتوجه لان الحامل ليست بمريضة المريض يخاف علي نفسه والحامل خافت علي غيرها لا علي نفسها فكيف ينبغي ان يجعل قول بن عمر في موضع حجة ثم القياس علي قوله حجة علي النبي صلي الله عليه وسلم ويخطء القياس فيقول حين قال بن عمر لا يصلي احد عن احد لا يحج احد عن احد قياسا علي قول بن عمر وترك قول النبي صلي الله عليه وسلم له (  ) وكيف جاز ان يترك من استقاء في رمضان فقال عليه  القضاء ولا كفارة عليه ومن ذرعه القء فلا قضاء عليه ولا كفارة فقلت وما الحجة في ذلك فقال اخبرنا مالك عن نافع عن بن عمر انه قال من استقاء وهو صاءم فعليه القضاء ومن ذرعه القء فليس عليه القضاء فقلت للشافعي فانا نقول ذلك من استقاء فعليه القضاء ولا كفارة عليه ( قال الشافعي ) فما رويتم من هذا عن عمر انه افطر وهو يري الشمس غربت ثم طلعت الشمس فقال الخطب يسير وقد اجتهدنا يعني قضاء يوم مكان يوم الحجة لنا عليكم وانتم ان وافقتموهما في هذا الموضع ( ( ( الموضوع ) ) ) تخالفونهما فيما هو مثل معناه قال فقلت للشافعي وما هذا الموضع الذي نخالفهما في مثل معناه فقال روينا عن رسول الله صلي الله عليه وسلم انه امر رجلا جامع امراته نهارا في رمضان ان يعتق او يصوم او يتصدق لا يجزيه الا بعد ان لا يجد عتقا ولا يستطيع الصوم فقلتم لا يعتق ولا يصوم ويتصدق فخالفتموه في اثنتين ووافقتموه في واحدة ثم زعمتم ان من افطر بغير جماع فعليه كفارة ومن استقاء او افطر وهو يري ان الليل قد جاء فلم كانا عندكم مفطرين ثم زعمتم ان ليس عليهما كفارة بالاجماع فلم تحسنوا الاتباع ولا القياس والله يغفر لنا ولكم فقلت للشافعي فكيف كان يكون القياس علي ما روي عن النبي صلي الله عليه وسلم في المجامع نهارا فقال ما قلنا من ان لا يقاس عليه شء غيره وذلك انا لا نعلم احدا خالف في ان لا كفارة علي من تقيا ولا من اكل بعد الفجر وهو يري الفجر لم يطلع ولا قبل تغيب الشمس وهو يري ان الشمس غربت ولم يجز ان يجمع الناس علي خلاف قول النبي صلي الله عليه وسلم وليس يجوز فيه الا ما قلنا من ان لا كفارة الا في الجماع استدلالا بما وصفت من الامر الذي لا اعلم فيه مخالفا وان انظر فاي حال جعلت فيها الصاءم مفطرا يجب عليه القضاء جعلت عليه الكفارة فاقول ذلك في المحتقن والمستعط والمزدرد الحصي والمفطر قبل تغيب الشمس والمتسحر بعد الفجر وهو يري ان الفجر لم يطلع والمستقء وغيره ويلزمك في الاكل الناسي ان يكون عليه كفارة لانك تجعل ذلك فطرا له وانت تترك الحديث نفسه ثم تدعي فيه القياس ثم لا تقوم من القياس علي شء تعرفه
   * باب في الحج
  * قال سالت الشافعي هل يغسل المحرم راسه من غير جنابة فقال نعم والماء يزيده شعثا وقال الحجة فيه ان النبي صلي الله عليه وسلم غسل راسه ثم غسله عمر قلت كيف ذكر مالك عن بن عمر قال اخبرنا مالك عن نافع عن بن عمر انه كان لا يغسل راسه وهو محرم الا من الاحتلام قال ونحن ومالك لا نري باسا ان يغسل المحرم راسه في غير احتلام ويروي عن النبي صلي الله عليه وسلم انه اغتسل وهو محرم قلت فهكذا نقول ( قال الشافعي ) واذا ترك قول بن عمر لما روي عن النبي صلي الله عليه وسلم وعمر فهكذا ينبغي ان تتركوا عليه لكل ما روي عن النبي صلي الله عليه وسلم خلافه واذا وجد في الرواية عن بن عمر ما يخالف ما يروي عن النبي صلي الله عليه وسلم وعمر فينبغي في مرة اخري ان لا تنكروا ان يذهب علي بن عمر للنبي صلي الله عليه وسلم سنة وقد يذهب عليه وعلي غيره السنن ولو علمها ما خالفها ولا رغب عنها ان شاء الله فلا تغفل في العلم وتختلف اقاويلك فيه بلا حجة ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع ان بن عمر كان يكره لبس المنطقة للمحرم فقلت للشافعي فانه يخالف بن عمر ويقول بقول بن المسيب فقال الشافعي ان من استجاز خلاف بن عمر ولم يرو خلافه الا عن بن المسيب حقيق ان لا يخالف سنة رسول الله صلي الله عليه وسلم لقول بن عمر ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع عن بن عمر انه كان يقول ما استيسر من الهدي بعير او بقرة ( قال الشافعي ) ونحن وانت نقول ما استيسر من الهدي شاة وترويه ( ( ( ويرويه ) ) ) عن بن عباس واذا جاز لنا ان نترك علي بن عمر لابن عباس كان الترك  عليه للنبي صلي الله عليه وسلم واجبا ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر كان اذا افطر من رمضان وهو يريد الحج لم ياخذ من راسه ولا من لحيته شيءا حتي يحج قال مالك ليس يضيق ان ياخذ الرجل من راسه قبل ان يحج ( قال الشافعي ) واخبرنا مالك عن نافع ان بن عمر كان اذا حلق في حج او عمرة اخذ من لحيته وشاربه قلت فانا نقول ليس علي احد الاخذ من لحيته وشاربه انما النسك في الراس ( قال الشافعي ) وهذا مما تركتم عليه بغير رواية عن غيره عندكم علمتها ( قال الشافعي ) اخبرنا مالك عن نافع ان بن عمر كان اذا خرج حاجا او معتمرا قصر الصلاة بذي الحليفة قلت فانا نقول يقصر الصلاة اذا جاوز البيوت ( قال الشافعي ) فهذا مما تركتم علي بن عمر ( قال الشافعي ) اخبرنا مالك عن محمد بن ابي بكر الثقفي انه سال انس بن مالك وهما غاديان من مني الي عرفة كيف كنتم تصنعون في هذا اليوم مع رسول الله قال كان يهل المهل منا فلا ينكر عليه ويكبر المكبر منا فلا ينكر عليه ( قال الشافعي ) اخبرنا مالك عن بن شهاب ان بن عمر قال كل ذلك قد رايت الناس يفعلونه واما نحن فنكبر قلت للشافعي فانا نقول يلبي حتي تزول الشمس ويلبي وهو غاد من مني الي عرفة ولا يكبر اذا زالت الشمس من يوم عرفة ( قال الشافعي ) فهذا خلاف ما روي صاحبكم عن بن عمر من اختيار التكبير وكراهتكم التكبير مع خلاف بن عمر خلاف ما زعمتم انه كان يصنع مع النبي صلي الله عليه وسلم فلا ينكر عليه فقد كانوا يختلفون في النسك وبعده فكيف ادعيت الاجماع في كل امر وانت تروي الاختلاف في النسك زمان النبي وبعد النبي صلي الله عليه وسلم وتروي الاختلاف في الصوم مع النبي صلي الله عليه وسلم وبعده فتقول عن انس سافرنا مع النبي صلي الله عليه وسلم فلم يعب الصيام علي المفطرين ولا المفطرون علي الصاءمين وقد اختلف بعض اصحاب النبي صلي الله عليه وسلم بعده في غير شء قلت للشافعي فما تقول انت فيه فقال اقول ان هذا خير وامر يتقرب به الي الله جل وعز الامر فيه والاختلاف واسع وليس الاجماع كما ادعيتم اذا كان بالمدينة اجماع فهو بالبلدان واذا كان بها اختلاف اختلف البلدان فاما حيث تدعون الاجماع فليس بموجود قال وسالت الشافعي عن العمرة في اشهر الحج فقال حسنة استحسنها وهي احب منها بعد الحج لقول الله عز وجل @QB@ فمن تمتع بالعمرة الي الحج @QE@ ولقول رسول الله دخلت العمرة في الحج ولان النبي صلي الله عليه وسلم امر اصحابه من لم يكن معه هدي ان يجعل احرامه عمرة ( قال الشافعي ) اخبرنا مالك عن صدقة بن يسار عن بن عمر انه قال والله لان اعتمر قبل ان احج واهدي احب الي من ان اعتمر بعد الحج في ذي الحجة فقلت للشافعي فانا نكره العمرة قبل الحج ( قال الشافعي ) فقد كرهتم ما رويتم عن بن عمر انه احبه منها وما رويتم عن عاءشة انها قالت خرجنا مع رسول الله فمنا من اهل بعمرة ومنا من جمع الحج والعمرة ومنا من اهل بحج فلم كرهتم ما روي انه فعل مع النبي صلي الله عليه وسلم وما بن عمر استحسنه وما اذن الله فيه من التمتع ان هذا لسوء الاختيار والله المستعان
   * باب الاهلال من دون الميقات
  * قال سالت الشافعي عن الاهلال من دون الميقات فقال حسن قلت له وما الحجة فيه قال اخبرنا مالك عن نافع عن بن عمر انه اهل من ايلياء واذا كان بن عمر روي عن النبي صلي الله عليه وسلم انه وقت المواقيت واهل من ايلياء وانما روي عطاء عن النبي صلي الله عليه وسلم انه لما وقت المواقيت قال يستمتع الرجل من اهله وثيابه حتي ياتي ميقاته فدل هذا علي انه لم يحظر ان يحرم من وراءه ولكنه امر ان لا يجاوزه حاج ولا معتمر الا باحرام  ( قال الشافعي ) اخبرنا مسلم بن خالد عن بن جريج عن عطاء عن النبي صلي الله عليه وسلم قال قلت للشافعي فانا نكره ان يهل احد من وراء الميقات ( قال الشافعي ) وكيف كرهتم ما اختار بن عمر لنفسه وقاله معه علي بن ابي طالب وعمر بن الخطاب في رجل من اهل العراق اتمام العمرة ان تحرم من دويرة اهلك ما اعلمه يءخذ علي احد اكثر مما يءخذ عليكم من خلاف ما رويت وروي غيرك عن السلف
   * باب في الغدو من مني الي عرفة
  * قال سالت الشافعي عن الغدو من مني الي عرفة يوم عرفة فقال ليس فيه ضيق والذي اختار ان يغدو اذا طلعت الشمس ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر انه كان يغدو من مني الي عرفه اذا طلعت الشمس قال فقلت للشافعي فانا نكره هذا ونقول يغدو من مني اذا صلي الصبح قبل ان تطلع الشمس ( قال الشافعي ) فكيف لم تتبعوا بن عمر وقد حج مع النبي صلي الله عليه وسلم وخلفاءه وكان الحج خاصة مما ينسب بن عمر عندهم الي العلم به وقد روي عن النبي صلي الله عليه وسلم من وجه اخر انه غدا من مني حين طلعت الشمس وقال محمد بن علي السنة ان يغدو الامام من مني اذا طلعت الشمس فعمن رويتم كراهية هذا
   * باب قطع التلبية
  * ( قال الشافعي ) رحمه الله تعالي اخبرنا مالك عن نافع عن بن عمر انه كان يقطع التلبية في الحج اذا انتهي الي الحرم ( قال الشافعي ) اخبرنا مالك عن نافع ان بن عمر حج في الفتنة فاهل ثم نظر فقال ما امرهما الا واحد اشهدكم اني قد اوجبت الحج مع العمرة ونحن لا نري بهذا باسا فقلت للشافعي فانا نكره ان يقرن الحج مع العمرة فقال الشافعي فكيف كرهتم غير مكروه وخالفتم من لا ينبغي لكم خلافه وما نراكم تبالون من خالفتم اذا شءتم
   * باب النكاح
  * ( قال الشافعي ) اخبرنا مالك انه بلغه ان بن عباس وبن عمر سءلا عن رجل كانت تحته امراة حرة فاراد ان ينكح عليها امة فكرها ان يجمع بينهما ( قال الشافعي ) اخبرنا مالك عن يحيي بن سعيد عن بن المسيب انه كان يقول لا تنكح الامة علي الحرة فان اطاعت فلها الثلثان ( قال الشافعي ) وهذا مما تركتم بغير رواية عن غيره عندكم علمتها فقلت للشافعي فانا نكره ان ينكح احد امة وهو يجد طولا لحرة ( قال الشافعي ) فقد خالفتم ما رويتم عن بن عباس وبن عمر لانهما لم يكرها في روايتكم الا الجمع بين الحرة والامة لا انهما كرها ما كرهتم وهكذا خالفتم ما رويتم عن بن المسيب وهل رويتم في قولكم شيءا عن احد من اصحاب رسول الله صلي الله عليه وسلم بخلافه فقلت ما علمت فقال فكيف استجزتم خلاف من شءتم لقول انفسكم
   * باب التمليك
  * ( قال الشافعي ) اخبرنا مالك عن نافع ان بن عمر كان يقول اذا ملك الرجل امراته فالقضاء ما قضت الا ان يناكرها الرجل فيقول لها لم ارد الا تطليقة واحدة فيحلف علي ذلك ويكون املك بها ما كانت في عدتها ( قال الشافعي ) اخبرنا مالك عن سعيد بن سليمان بن زيد بن ثابت عن خارجة بن زيد انه اخبره انه كان  جالسا عند زيد بن ثابت فاتاه محمد بن ابي عتيق وعيناه تدمعان فقال له زيد ما شانك قال ملكت امراتي امرها ففارقتني فقال له زيد ما حملك علي ذلك فقال له القدر فقال له زيد ارتجعها ان شءت وانما هي واحدة وانت املك بها ( قال الشافعي ) اخبرنا مالك عن عبد الرحمن بن القاسم عن ابيه القاسم بن محمد ان رجلا من ثقيف ملك امراته امرها فقالت انت الطلاق فسكت ثم قالت انت الطلاق فقال بفيك الحجر فقالت انت الطلاق فقال بفيك الحجر فاختصما الي مروان بن الحكم فاستحلفه ما ملكها الا واحدة وردها اليه قال عبد الرحمن فكان القاسم يعجبه هذا القضاء ويراه احسن ما سمع في ذلك قلت للشافعي انا نقول في المخيرة اذا اختارت نفسها هي ثلاث وفي التي يجعل امرها بيدها او تملك امرها ايما تملك القضاء ما قضت الا ان يناكرها زوجها ( قال الشافعي ) هذا خلاف ما رويتم عن زيد بن ثابت وخلاف ما روي غيركم عن علي بن ابي طالب وبن مسعود وغيرهما فاجعلك اخترت قول بن عمر علي قول من خالفه في المملكة فالي قول من ذهبت في المخيرة وعمن تقول ان اختاري وامرك بيدك سواء وانت لا نعلمك رويت في المخيرة عن واحد من اصحاب رسول الله صلي الله عليه وسلم قولا يوافق قولك فان رويت في هذا اختلافا عن اصحاب رسول الله صلي الله عليه وسلم فكيف ادعيت الاجماع واذا حكيت فاكثر ما تحكي الاختلاف
   * باب المتعة
  * ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر انه كان يقول لكل مطلقة متعة الا التي تطلق وقد فرض لها الصداق ولم تمس فحسبها ما فرض لها ( قال الشافعي ) اخبرنا مالك عن القاسم بن محمد مثله ( قال الشافعي ) اخبرنا مالك عن بن شهاب انه كان يقول لكل مطلقة متعة فقلت للشافعي فانا نقول خلاف قول بن شهاب لقول بن عمر ( قال الشافعي ) فبقول بن عمر قلتم وانتم تخالفونه قال فقلت للشافعي واين قال زعمتم ان بن عمر قال لكل مطلقة متعة الا التي فرض لها ولم تمس فحسبها نصف الصداق وهذا يوافق القران فيه وقوله فيمن سواها من المطلقات ان لها متعة يوافق القران لقول الله جل ثناءه @QB@ لا جناح عليكم ان طلقتم النساء ما لم تمسوهن او تفرضوا لهن فريضة ومتعوهن @QE@ وقال الله جل ذكره @QB@ وللمطلقات متاع بالمعروف @QE@ قلت فانما ذهبنا الي ان هذا انما هو لمن ابتدا الزوج طلاقه فيها ارايت المختلعة والمملكة فان هاتين طلقتا انفسهما قال اليس الزوج ملكها ذلك وملكه التي حلف ان لا تخرج فخرجت وملكه رجلا يطلق امراته ثم فرقت بينهن وبين المطلقات في المتعة ثم فرقت بين انفسهن وكلهن طلقها غير الزوج الا ان ابتداء الطلاق الذي به كان من الزوج فان قلت لان الله انما ذكر المطلقات والمطلقات المراة يطلقها زوجها فان اختلعت عندك فليس الزوج هو المطلق لانه ادخل قبل الطلاق شيءا لزمك ان تخالف معني القران لان الله عز وجل يقول @QB@ والمطلقات يتربصن بانفسهن ثلاثة قروء @QE@ فان زعمت ان المملكة والمختلعة ومن سمينا من النساء يتربصن بانفسهن ثلاثة قروء مطلقات لان الطلاق جاء من الزوج اذا قبل الخلع وجعل اليهن الطلاق والي غيرهن فطلقهن فهو المطلق وعليه يحرمن فكذلك المختلعات ومن سمينا منهن مطلقات لهن المتعة في كتاب الله ثم قول بن عمر والله اعلم 
   * باب الخلية والبرية
  * ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر انه قال في الخلية والبرية ثلاثا ثلاثا ( قال الشافعي ) مذهب بن عمر فيه ومن ذهب مذهبه ان الخلية والبرية تقوم مقام قوله لامراته انت طالق ثلاثا ولا ينويه شيءا من ذلك ومن قال لمدخول بها وغير مدخول بها انت طالق ثلاثا وقعت عليه عندنا وعند عامة المفتين وعندكم ( قال الشافعي ) لنا قد خالفتم بن عمر في بعض هذا القول ووافقتموه في بعض فقلتم الخلية والبرية ثلاث في المدخول بها فلا يدين ويدين في التي لم يدخل بها ثلاثا اراد او واحدة فلا انتم قلتم كما قال بن عمر ومن قال قوله فيقول لا التفت ان يدين المطلق واستعمل عليها الاغلب ولا انتم ذهبتم اذ كان الكلام منه يحتمل معنيين الي ان يجعل القول قوله مع يمينه ولكنكم خالفتم هذا معا في معني ووافقتموه معا في معني وما للناس فيها قول الا قد خرجتم منه انما قال الناس قولين احدهما ان قال بعضهم قول بن عمر اولءك استعملوا الاغلب فجعلوا الخلية والبرية والبتة ثلاثا كقوله انت طالق ثلاثا واخرون قالوا بقول عمر في البتة يدين فان اراد ثلاثا فثلاث وان اراد واحدة فواحدة واخرون ذهبوا الي ان الكلمة احتملت معنيين فجعلوا عليه الاقل فجعلوا الخلية والبرية واحدة اذا اراد بها الطلاق وقولكم خارج من هذا مخالف لما رويتم وجميع الاثار في بعضه وزدتم قولا ثالثا هو داخل في احد القولين وهو ان يملك الرجل امراته امرها فرويتم عن بن عمر القضاء ما قضت الا ان يناكرها ثم زعمتم انه ان ملك امراته امرها وهي مدخول بها فهكذا وان كانت غير مدخول بها نويتموه والبتة ليست مذهبكم انما البتة مذهب من لا يوقع عليها الطلاق اذا احتمل الكلام الطلاق وغيره الا بارادة الطلاق كما روينا عن النبي صلي الله عليه وسلم ثم عمر وغيرهما
   * باب في بيع الحيوان
  * قد سالت الشافعي عن بيع الحيوان فقال لا ربا في الحيوان يدا بيد ونسيءة ولا يعدو الربا في زيادة الذهب والورق والماكول والمشروب فقلت وما الحجة فيه فقال فيه حديث عن النبي صلي الله عليه وسلم ثابت وعن بن عباس وغيره من رواية اهل البصرة ومن حديث مالك احاديث ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر انه اشتري راحلة باربعة ابعرة مضمونة عليه بالربذة ( قال الشافعي ) اخبرنا مالك عن صالح بن كيسان عن الحسن بن محمد بن علي ان عليا باع جملا له يقال له عصيفير بعشرين بعيرا الي اجل ( قال الشافعي ) اخبرنا مالك عن بن شهاب عن بن المسيب كان يقول لا ربا في الحيوان وانما نهي من الحيوان عن ثلاث المضامين والملاقيح وحبل الحبلة ( قال الشافعي ) اخبرنا مالك انه سال بن شهاب عن بيع الحيوان اثنين بواحد الي اجل قال لا باس به ( قال الشافعي ) وبهذا كله نقول وخالفتم هذا كله ومثل هذا يكون عندكم العمل لانكم رويتم عن رجلين من اصحاب النبي صلي الله عليه وسلم ورجلين من التابعين احدهما اسن من الاخر وقلتم لا يجوز البعير بالبعيرين الا ان تختلف رحلتهما ونجابتهما فيجوز فان اردتم بها قياسا علي التمر بالتمر فذلك لا يصلح الا كيلا بكيل ولو كان احد التمرين خيرا من الاخر ولا يصلح شء من الطعام بشء من الطعام نسيءة وانتم تجيزون بعض الحيوان ببعض نسيءة فلم تتبعوا فيه من رويتم عنه اجازته ممن سميت ولم تجعلوه قياسا علي غيره وقلتم فيه قولا متناقضا خارجا من السنة والاثار والقياس والمعقول لعمري ان حرم البعير بالبعيرين مثله في الرحلة والنجابة ما يعدو ان يحرم خبرا والخبر يدل علي احلاله  وقد خالفتموه ولو حرمتموه قياسا علي ما الزيادة في بعضه علي بعض الربا لقد خالفتم القياس واجزتم البعير بالبعيرين مثله وزيادة دراهم وليس يجوز التمر بالتمر وزيادة دراهم ولا شء من الاشياء وما علمت احدا من اصحاب رسول الله صلي الله عليه وسلم قال قولكم وان عامة المفتين بمكة والامصار لعلي خلاف قولكم وان قولكم لخارج من الاثار يخالفها كلها ما رويتم منها وروي غيركم خارج من القياس والمعقول فكيف جاز لاحد قول يستدرك فيه ما وصفت ثم لا يستدرك في قليل من قوله بل في كثير والله المستعان ( قال الشافعي ) اخبرنا مالك عن بن شهاب عن عروة بن اذينة قال خرجت مع جدة لي عليها مشي الي بيت الله حتي اذا كانت ببعض الطريق عجزت فسالت عبد الله بن عمر فقال عبد الله مرها فلتركب ثم لتمش من حيث عجزت قال مالك وعليها الهدي ( قال الشافعي ) اخبرنا مالك عن يحيي بن سعيد انه قال كان علي مشي فاصابتني خاصرة فركبت حتي اتيت مكة فسالت عطاء بن ابي رباح وغيره فقالوا عليك هدي فلما قدمت المدينة سالت فامروني ان امشي من حيث عجزت فمشيت مرة اخري ( قال الشافعي ) فرويتم عن بن عمر انه امرها ان تمشي ورويتم ذلك عمن سال بالمدينة ولم ترووا عنهم انهم امروها بهدي فخالفتم في امرها بهدي وهذا عندكم اجماع بالمدينة ورويتم ان عطاء وغيره امروه بهدي ولم يامروه بمشي فخالف في رواية نفسه عطاء وبن عمر والمدنيين ولا ادري اين العمل الذي تدعون من قولكم ولا اين الاجماع منه هذا خلافهما فيما رويتم وخلاف رواية غيركم عن بن عمر وغيره وما يجوز من هذا الا واحد من قولين اما قول بن عمر يمشي ما ركب حتي يكون بالمشي كله واما ان لا يكون عليه عودة لانه قد جاء بحج او عمرة وعليه هدي مكان ركوبه واما ان يمشي ويهدي فقد كلفه الامرين معا وانما ينبغي ان يكون عليه احدهما والله اعلم
   * باب الكفارات
  * ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر قال من حلف علي يمين فوكدها فعليه عتق رقبة ( قال الشافعي ) فخالفتم بن عمر فقلتم التوكيد وغيره سواء يجزيه فيه اطعام عشرة مساكين نراكم تستوحشون من خلاف بن عمر بحال وما نعرف لكم مذهبا غير انا رايناكم اذا وافقتم قول بن عمر او غيره من الصحابة او من بعدهم من التابعين قلتم هم اشد تقدما في العلم واحدث برسول الله صلي الله عليه وسلم واصحابه عهدا فاحري ان لا نقول الا بما يعملون واءمتنا المقتدي بهم فكيف تخالفونهم وعظمتم خلافهم غاية التعظيم ولعل من خالفهم ممن عبتم عليه خلاف من وافقكم منه ان يكون خلافه لان من رواه عن مثلهم لم تعرفوه لضيق علمكم ( ( ( عليكم ) ) ) ثم تخالفونهم لغير قول احد من الناس مثلهم ولا يسمع روايتكم وتتركون ما شءتم لغير حجة فيما اخذتم ولا ما تركتم وما صنعتم من هذا غير جاءز لغيركم عندكم وكذلك هو غير جاءز لكم عند احد من المسلمين لانه اذا لم يجز لمن يخالف بعض الاثر فيحسن الاحتجاج والقياس كان ان يكون لكم اذا كنتم لا تحسنون عند الناس حجة ولا قياسا ابعد قلتم ان زكاة الفطر وصدقة الطعام وجميع الكفارات بمد النبي صلي الله عليه وسلم الا كفارة الظهار فانها بمد هشام ( قال الشافعي ) وما علمته قال هذا القول قبلكم احد من الناس وما ادري الي اي شء ذهبتم الي عظم ذنب المتظاهر فالقاتل اعظم من المتظاهر ذنبا فكيف رايتم ان كفارة القاتل بمد النبي صلي الله عليه وسلم وكفارة المتظاهر بمد هشام ومن شرع لكم مد هشام وقد انزل الله الكفارات علي رسوله قبل ان يولد ابو هشام فكيف تري المسلمين كفروا في زمان النبي صلي الله عليه وسلم قبل ان يكون مد  هشام فان زعمت انهم كفروا بمد رسول الله صلي الله عليه وسلم واخذوا به الصدقات واخرجوا به الزكاة لان الله عز وجل انزل الكفارات فقد ابان رسول الله صلي الله عليه وسلم كم قدر كيلها كما ابان ذلك في زكاة الفطر وفي الصدقات فكيف اخذتم مد هشام وهو غير ما ابان رسول الله صلي الله عليه وسلم للناس وكفر به السلف الي ان كان لهشام مد وان زعمت ان ذلك غير معروف فمن عرفهم ان الكفارة بمد هشام ومن زعم ان الكفارات مختلفة ارايت لو قال قاءل كل كفارة بمد هشام الا كفارة الظهار فانما بمد النبي صلي الله عليه وسلم هل الحجة عليه الا ان نقول لا يفرق بينهما الا كتاب او سنة او اجماع او خبر لازم فقلت ( ( ( فقال ) ) ) للشافعي فهل خالفك في ان الكفارات بمد النبي صلي الله عليه وسلم احد فقال معاذ الله ان يكون زعمنا ان مسلما قط غيركم قال ان شيءا من الكفارات بمد غير النبي صلي الله عليه وسلم قال فما شء يقوله بعض المشرقيين قلت قول متوجه وان خالفناه قال وما هو قلت قالوا الكفارات بمد النبي صلي الله عليه وسلم يطعم المسكين مدين مدين قياسا علي ان النبي صلي الله عليه وسلم امر كعب بن عجرة ان يطعم في فدية الاذي كل مسكين مدين مدين ولم تبلغ جهالتهم ولا جهالة احد ان يقول ان كفارة بغير مد النبي صلي الله عليه وسلم فقلت للشافعي فلعل مد هشام مدان بمد النبي صلي الله عليه وسلم فقال الشافعي لا هو مد وثلث او مد ونصف فقلت للشافعي افتعرف لقولنا وجها فقال لا وجه لكم يعذر احد من العالمين بان يقول مثله ولا يفرق مسلم غيركم بين مكيلة الكفارات الا انا نقول هي مد مد بمد النبي صلي الله عليه وسلم لكل مسكين وقال بعض المشرقيين مدان مدان فاما ان يفرق احد بين مكيلة شء من الكفارات فلا
   * باب زكاة الفطر
  * ( قال الشافعي ) رحمه الله اخبرنا مالك عن نافع عن بن عمر انه كان يبعث بزكاة الفطر الي الذي تجمع عنده قبل الفطر بيومين او ثلاثة ( قال الشافعي ) هذا حسن واستحسنه لمن فعله والحجة بان النبي صلي الله عليه وسلم تسلف صدقة العباس قبل ان تحل وبقول ( ( ( ويقول ) ) ) بن عمر وغيره فقلت للشافعي فانا نكره لاحد ان يءدي زكاة الفطر الا مع الغدو يوم الفطر وذلك حين يحل بعد الفجر ( قال الشافعي ) قد خالفتم بن عمر في روايتكم وما روي غيركم عن النبي صلي الله عليه وسلم انه تسلف صدقه العباس بن عبد المطلب قبل محلها لغير قول واحد علمتكم رويتموه عنه من اصحاب النبي صلي الله عليه وسلم ولا التابعين فلست ادري لاي معني تحملون ما حملتم من الحديث ان كنتم حملتموه لتعلموا الناس انكم قد عرفتموه فخالفتموه بعد المعرفة فقد وقعتم بالذي اردتم واظهرتم للناس خلاف السلف وان كنتم حملتموه لتاخذوا به فقد اخطاتم ما تركتم منه وما تركتم منه كثير في قليل ما رويتم وان كانت الحجة عندكم ليست في الحديث فلم تكلفتم روايته واحتججتم بما وافقتم منه علي من خالفه ما تخرجون من قلة النصفة والخطا فيما صح اذ تركتم مثله واخذتم بمثله ولا يجوز ان يكون شء مرة حجة ومرة غير حجة
   * باب في قطع العبد
  * ( قال الشافعي ) اخبرنا مالك عن نافع عن بن عمر ان عبدا له سرق وهو ابق فابي سعيد بن العاص ان يقطعه فامر به بن عمر فقطعت يده فقلت للشافعي فانا نقول لا يقطع السيد يد عبده اذا ابي السلطان يقطعه فقال الشافعي قد كان سعيد بن العاص من صالحي ولاة اهل المدينة فلما لم ير ان يقطع الابق امر بن عمر بقطعه وفي هذا دليل علي ان ولاة اهل المدينة كانوا يقضون باراءهم ويخالفون فقهاءهم وان فقهاء اهل المدينة كانوا يختلفون  فياخذ امراءهم براي بعضهم دون بعض وهذا ايضا العمل لانكم كنتم توهمون ان قضاء من هو اسوا حالا من سعيد ومثله لا يقضي الا بقول الفقهاء وان فقهاءهم زعمتم لا يختلفون وليس هو كما توهمتم في قول فقهاءهم ولا قضاء امراءهم وقد خالفتم راي سعيد وهو الوالي وبن عمر وهو المفتي فاين العمل ان كان العمل فيما عمل به الوالي فسعيد لم يكن يري قطع الابق وانتم ترون قطعه وان كان العمل في قول بن عمر فقد قطعه وانتم ترون ان ليس لنا ان نقطعه وما درينا ما معني قولكم العمل ولا تدرون فيما خبرنا وما وجدنا لكم منه مخرجا الا ان تكونوا سميتم اقاويلكم العمل والاجماع فتقولون علي هذا العمل وعلي هذا الاجماع تعنون اقاويلكم واما غير هذا فلا مخرج لقولكم فيه عمل ولا اجماع لان ما نجد عندكم من روايتكم ورواية غيركم اختلاف لا اجماع الناس معكم فيه لا يخالفونكم قلت للشافعي قد فهمت ما ذكرت انا لم نصر الي الاخذ به من الحديث عن النبي صلي الله عليه وسلم والاثار عن اصحاب النبي صلي الله عليه وسلم وما تركنا من الاثار عن التابعين بالمدينة من رواية صاحبنا نفسه وتركنا مما روي وخالفنا فيه فهل تجد فيما روي غيرنا شيءا تركناه قال نعم اكثر من هذا في رواية صاحبكم لغير قليل فقلت له فلنا ( ( ( قلنا ) ) ) علم ندخله مع علم المدنيين قال اي علم هو قلت علم المصريين وعلم غير صاحبنا من المدنيين ( قال الشافعي ) ولم ادخلتم علم المصريين دون علم غيرهم مع علم اهل المدينة فقلت ادخلت منه ما اخذوا عن اهل المدينة قال ومن ذلك علم خالد بن ابي عمران قلت نعم ( قال الشافعي ) فقد وجدتك تروي عن خالد بن ابي عمران انه سال سالم بن عبد الله والقاسم بن محمد وسليمان بن يسار فنظرت فيما ثبت انت عن هءلاء النفر فرايت فيه اقاويل تخالفها ووجدتك تروي عن بن شهاب وربيعة ويحيي بن سعيد فوجدتك تخالفهم ولست ادري من تبعتم اذا كنت تروي انت وغيرك عن النبي صلي الله عليه وسلم اشياء تخالفها ثم عمن رويت عنه هذا من اصحاب النبي صلي الله عليه وسلم ثم عن التابعين ثم عمن بعدهم فقد اوسعت القرون الخالية والباقية خلافا ووضعت نفسك بموضع ان لا تقبل الا اذا شءت وانت تعيب علي غيرك ما هو اقل من هذا وعند من عبت عليه عقل صحيح ومعرفة يحتج بها عما يقول ولم نر ذلك عندك والله يغفر لنا ولك قال ويدخل عليك من هذا خصلتان فان كان علم اهل المدينة اجماعا كله او الاكثر منه فقد خالفته لا بل قد خالفت اعلام اهل المدينة من كل قرن في بعض اقاويلهم وان كان في علمهم افتراق فلم ادعيت لهم الاجماع ( قال الشافعي ) رحمه الله تعالي وما حفظت لك مذهبا واحدا في شء من العلم استقام لك فيه قول ولا حفظت انك ادعيت الحجة في شء الا تركتها في مثل الذي ادعيتها فيه وزعمت انك تثبت السنة من وجهين احدهما ان تجد الاءمة من اصحاب النبي صلي الله عليه وسلم قالوا بما يوافقها والاخر ان لا تجد الناس اختلفوا فيها وتردها ان لم تجد للاءمة فيها قولا وتجد الناس اختلفوا فيها ثم تثبت تحريم كل ذي ناب من السباع واليمين مع الشاهد والقسامة وغير ذلك مما ذكرنا هذا كله لا تروي فيه عن احد من الاءمة شيءا يوافقه بل انت تروي في القسامة عن عمر خلاف حديثك عن النبي صلي الله عليه وسلم وتروي فيها عن النبي صلي الله عليه وسلم خلاف حديثك الذي اخذت به ويخالفك فيها سعيد بن المسيب برايه وروايته ويخالفك فيها كثير من اهل المدينة ويردها عليك اهل البلدان ردا عنيفا وكذلك اكثر اهل البلدان ردوا عليك اليمين مع الشاهد ويدعون فيها انها تخالف القران ويردها عليك بالمدينة عروة والزهري وغيرهما وبمكة عطاء وغيره ويرد كل ذي ناب من السباع عاءشة وبن عباس وغيرهما ثم رددت ان النبي صلي الله عليه وسلم تطيب للاحرام وبمني قبل الطواف بن ابي وقاص وبن عباس كما تطيب النبي صلي الله عليه وسلم وعلي هذا اكثر المفتين بالبلدان فتترك هذا لان رويت ان عمر كره ذلك ولا يجوز لعالم ان يدع قول النبي صلي الله عليه وسلم  لقول احد سواه فان قلت قد يمكن الغلط فيمن روي هذا عن النبي صلي الله عليه وسلم فهكذا يمكن الغلط فيمن روي ما رويت عن عمر فان جعلت الروايتين ثابتتين معا فما روي عن النبي صلي الله عليه وسلم اولي ان يقال به وان ادخلت التهمة علي الراويين معا فلا تدع الرواية عن احد اخذت عنه وانت تتهمه قلت للشافعي افيجوز ان تتهم الرواية قال لا الا ان يروي حديثان عن رجل واحد مختلفان فذهب الي احدهما فاما رواية عن واحد لا معارض لها فلا يجوز ان تتهم ولو جاز ان تتهم لم يجز ان نحتج بحديث المتهمين بغير معارض روايته فاما ان يروي رجل عن رجل عن النبي صلي الله عليه وسلم شيءا ويروي اخر عن رجل من اصحاب النبي صلي الله عليه وسلم شيءا يخالفه فليس هذه معارضة هذه رواية عن رجل وهذه عن اخر وكل واحد منهما غير صاحبه ثم لم تثبت علي ما وصفت من مذهبك حتي تركت قول عمر في المنبوذ هو حر ولك ولاءه وعلينا نفقته فقلت لا يكون للذي التقطه ولاءه ولا احسب حجة لك في هذا الا ان تقول قال النبي صلي الله عليه وسلم الولاء لمن اعتق وهذا غير معتق ورويت عن عمر انه بدا في القسامة المدعي عليهم فابوا فردها علي المدعين فابوا الايمان فاغرم المدعي عليهم نصف الدية فخالفته انت فقلت يبدا المدعون ولا نغرم المدعي عليهم اذا لم يحلف من انه بدا المدعين ولم يجعل علي المدعي عليهم غرامة حين لم يقبل المدعون ايمانهم ورويت عن عمر انه قال في المءمن يءمن العلج ثم يقتله لا يبلغني ان احدا فعل ذلك الا قتلته فخالفته وقلت لا يقتل مءمن بكافر مع ما وصفنا مما تركت علي عمر والرجل من الصحابة ثم تتخلص الي ان تترك عليه لراي نفسك ولا يجوز اذا كانت السنة حجة علي قول من تركها ان لا يوافقها الا ان تكون كذلك ابدا ولا يجوز هذا القول المختلط المتناقض ورويت عن عمر في الضرس جمل وعن بن المسيب في الضرس جملان ثم تركت عليهما معا قولهما ولا اعلم لك حجة في هذا اقوي من ان النبي صلي الله عليه وسلم قال في السن خمس وان الضرس قد يسمي سنا ثم صرت الي ان رويت ان النبي صلي الله عليه وسلم امر امراة ان تحج عن ابيها وهذا قول علي بن ابي طالب وبن عباس وبن المسيب وربيعة وكل من عرفت قوله من كل اهل بلد غير اصحابك لا اعلمهم يختلفون فيه فتركته لقياس زعمت علي قول بن عمر لا يصلي احد عن احد ولا يصوم احد عن احد فقلت والحج يشبههما ( قال الشافعي ) رحمه الله تعالي ورويت عن بن عمر انه سمع الاقامة فاسرع المشي الي المسجد فتركته عليه لا اعلم لك حجة في تركه عليه الا ان النبي صلي الله عليه وسلم قال لا تاتوها تسعون واءتوها تمشون وعليكم السكينة ورويت عن بن عمر انه كان ينضح في عينيه الماء اذا اغتسل من الجنابة وخالفته ولم ترو عن احد من الناس خلافه ورويت عن بن عمر انه كان يرفع يديه اذا رفع راسه من الركوع ورويت عن النبي صلي الله عليه وسلم مثله ثم خالفته وهو يوافق سنة رسول الله صلي الله عليه وسلم لغير قول احد من الناس رويته عنه ورويت عن بن عمر انه كان اذا سجد يضع كفيه علي الذي يضع عليه وجهه حتي يخرجهما في شدة البرد وتروي عن النبي صلي الله عليه وسلم انه امر ان يسجد علي سبع فيها الكفان فخالفت بن عمر فيما يوافق فيه النبي صلي الله عليه وسلم فاذا كنت تخالف ما رويت عن النبي صلي الله عليه وسلم في الطيب للمحرم لقول عمر وما رويت عن عمر في تقريد البعير وهو محرم لقول بن عمر وما رويت عن بن عمر فيما وصفنا وغيره لقول نفسك فلا اسمع العلم اذا الا علمك ولا اعلمك تدري لاي شء تحمل الحديث اذا كنت تاخذ منه ما شءت وتترك منه ما شءت ورويت عن النبي صلي الله عليه وسلم ولم تعتمدوا علي امر تعرفونه فقلت للشافعي انما ذهبنا الي ان نثبت ما اجتمع عليه اهل المدينة دون البلدان كلها فقال الشافعي هذه طريق الذين ابطلوا الاحاديث كلها وقالوا ناخذ بالاجماع الا انهم ادعوا اجماع الناس وادعيتم انتم اجماع بلد  هم يختلفون علي لسانكم والذي يدخل عليهم يدخل عليك معهم للصمت كان اولي بكم من هذا القول قلت ولم قال لانه كلام ترسلونه لا بمعرفة فاذا سءلتم عنه لم تقفوا منه علي شء ينبغي لاحد ان يقبله ارايتم اذا سءلتم من الذين اجتمعوا بالمدينة اهم الذين ثبت لهم الحديث وثبت لهم ما اجتمعوا عليه وان لم يكن فيه حديث من اصحاب رسول الله صلي الله عليه وسلم فان قلتم نعم قلت يدخل عليكم في هذا امران احدهما انه لو كان لهم اجماع لم تكونوا وصلتم الي الخبر عنهم الا من جهة خبر الانفراد الذي رددتم مثله في الخبر عن رسول الله فان ثبت خبر الانفراد فما ثبت عن النبي صلي الله عليه وسلم احق ان يءخذ به والاخر انكم لا تحفظون في قول واحد غيركم شيءا متفقا فكيف تسمون اجماعا لا تجدون فيه عن غيركم قولا واحدا وكيف تقولون اجمع اصحاب رسول الله صلي الله عليه وسلم وهم مختلفون علي لسانكم وعند اهل العلم فان قلتم انا ذهبنا الي ان اجماعهم ان يحكم احد الاءمة ابو بكر او عمر او عثمان رضي الله عنهم بالمدينة بحكم او يقول القول فقال الشافعي انه قد احتج لكم بعض المشرقيين بان قال ما قلتم وكان حكم الحاكم وقول القاءل من الاءمة لا يكون بالمدينة الا علما ظاهرا غير مستتر وهم يجمعون انهم اعلم الناس بسنن رسول الله صلي الله عليه وسلم واطلب الناس لما ذهب علمه عنهم منها يسالون عنها علي المنبر وعلي المواسم وفي المساجد وفي عوام ( ( ( عرام ) ) ) الناس ويبتدءون فيخبرون بما لم يسالوا عنه فيقبلون ممن اخبرهم ما اخبرهم اذا ثبت لهم فاذا حكم احدهم الحكم لم نجوز ( ( ( تجوز ) ) ) ان يكون حكم به الا وهو موافق سنة رسول الله صلي الله عليه وسلم وغير مخالف لها فان جاء حديث عن النبي صلي الله عليه وسلم فخالفه من وجهة الانفراد اتهم لما وصفت فقلت للشافعي هذا المعني الذي ذهبنا اليه باي شء احتججت عليه ( قال الشافعي ) اول ما نحتج به عليكم من هذا انكم لا تعرفون حكم الحاكم منهم ولا قول القاءل الا بخبر الانفراد الذي رددتم مثله اذا روي عن النبي صلي الله عليه وسلم الفرض من الله وما روي عمن دونه لا يحل محل قول النبي صلي الله عليه وسلم ابدا فكيف اجزتم خبر الانفراد عن بعض اصحاب النبي صلي الله عليه وسلم ورددتموه عن النبي صلي الله عليه وسلم فقلت للشافعي فما رد عليك فقال ما كان عنده في هذا شء اكثر من الخروج منه وانا اعلم ان شاء الله انه يعلم انه يلزمه فهل عندكم في هذا حجة فقلت ما يحضرني قال فقلت للشافعي وما حجتك عليه سوي هذا فقال الشافعي قد اوجدتكم ان عمر مع فضل علمه وصحبته وطول عمره وكثرة مسالته وتقواه قد حكم احكاما بلغه بعضها عن النبي صلي الله عليه وسلم شء فرجع عن حكمه الي ما بلغه عن رسول الله ورجع الناس عن بعض حكمه بعده الي ما بلغهم عن النبي صلي الله عليه وسلم فانه قد يعزب عن الكثير الصحبة الشء من العلم يحفظه الاقل علما وصحبة منه فلا يمنعه ذلك من قبوله واكتفيت من ترديد هذا بما وصفت في كتاب هذا وكتاب جماع العلم ( قال الشافعي ) ولو لم يكن هذا هكذا ما كان علي الارض احد اعلمه اترك لما زعم ان الصواب فيه منكم قلت فكيف قال قد تركتم علي عمر بن الخطاب من روايتكم منها ما تركتموه وزعمتم لان الحديث عن النبي صلي الله عليه وسلم جاء يخالفه ومنها ما تركتموه لان بن عمر خالفه ومنها ما تركتموه لراي انفسكم لا يخالف عمر فيه احد يحفظ عنه فلو كان حكم الحاكم وقوله يقوم المقام الذي قلت كنت خارجا منه فيما وصفنا وفيما روي الثقات عن عمر انكم لتخالفون عنه اكثر من ماءة قول منها ما هو لراي انفسكم ومثلكم وحفظت انك تروي عن ابي بكر ستة اقاويل تركتم عليه منها خمسة اثنين في القراءة في الصلاة واخري في نهيه عن عقر الشجر وتخريب العامر وعقر ذوات الارواح الا لماكلة وحفظت انك تركت علي عثمان انه كان يخمر وجهه وهو محرم من روايتكم وغير ذلك وما تركت عليهم من رواية الثقات من اهل المدينة اضعاف ما تركتم عليهم من روايتكم  لغفلة ولقلة روايتكم وكثرة روايتهم فان ذهبتم الي غيرهم من اصحاب النبي صلي الله عليه وسلم فلم ترووا عن احد قط شيءا علمته الا تركتم بعض ما رويتم وان ذهبتم الي التابعين فقد خالفتم كثيرا من اقاويلهم وان ذهبتم الي تابعي التابعين فقد خالفتم اقاويلهم مما رويتم وروي غيركم ما كتبنا منه في هذا الكتاب شيءا يدل علي ما رويتم وما تركنا من رواية غيركم اضعاف ما كتبنا فان انصفتم باقاويلكم فلا تشكوا في انكم لم تذهبوا مذهبا علمناه الا فارقتموه فان ( ( ( كان ) ) ) كانت حجتكم لازمة فحالكم بفراقها غير محمودة وان كانت غير لازمة دخل عليكم فراقها والضعف في الحجة بما لا يلزم قال فقلت للشافعي فقد سمعتك تحكي ان بعض المشرقيين قام بحجتنا فيما ذكرنا من الاجماع فاحب ان تحكي لي ما قلت وقال لك فقال لي الشافعي فيما حكيت الكفاية مما لم احك وما تصنع بما لم تقله انت في حجتك فقلت للشافعي قد ذكرت الذي قام بالعذر في بعض ترك الحديث ووصفت انه منسوب الي البصرة فقال لي الشافعي هو كما ذكرت وقد جاء منه علي ما لم تات عليه لنفسك ولو لم ار في مذهبه شيءا تقوم به حجة فقلت فاذكر منه ما حضرك ( قال الشافعي ) قلت له ارايت الفرض علينا وعلي من قبلنا في اتباع سنة رسول الله صلي الله عليه وسلم اليس واحدا قال بلي فقلت اذا كان ابو بكر خليفة النبي صلي الله عليه وسلم والعامل بعده فورد عليه خبر واحد عن النبي صلي الله عليه وسلم وابو بكر لا مدة بينه وبين النبي صلي الله عليه وسلم يمكنه فيها ان يعمل بالخبر فلا يترك ما تقول فيه قال اقول انه يقبله ويعمل به فقلت قد ثبت اذا بالخبر ولم يتقدمه عمل من احد بعد عن النبي صلي الله عليه وسلم يثبته لانه لم يكن بينهما امام فيعمل بالخبر ولا يدعه وهو مخالف في هذا حال من بعده ( قال الشافعي ) فقلت ارايت اذا جاء الخبر في اخر عمره ولا يعمل به ولا بما يخالفه في اول عمره وقد عاش اكثر من سنة يعمل فما تقول فيه قال يقبله فقلت فقد قبل خبرا لم يتقدمه عمل ( قال الشافعي ) لو اجبت الي النصفة علي اصل قولك يلزمك ان لا يكون علي الناس العمل بما جاء عن النبي صلي الله عليه وسلم الا بان يعمل به من بعده او يترك العمل لانه اذا كان للامام الاول ان يدعه لم يعمل به كان جميع من بعده من الاءمة في مثل حاله لانه لا بد ان يبتدء العمل به الامام الاول او الثاني او من بعده قال فلا اقول هذا ( قال الشافعي ) فما تقول في عمر وابو بكر امام قبله اذا ورد عليه خبر الواحد لم يعمل به ابو بكر ولم يخالفه قال يقبله قلت ايقبله ولم يعمل به ابو بكر قال نعم ولم يخالفه قلت افيثبت ولم يتقدمه عمل قال نعم قلت وهكذا عمر في اخر خلافته واولها قال نعم قلت وهكذا عثمان قال نعم قلت زعمت ان الخبر عن النبي صلي الله عليه وسلم يلزم ولم يتقدمه عمل قبله وقد ولي الاءمة ولم يعملوا به ولم يدعوه قال فلا يمكن ان تكون للنبي صلي الله عليه وسلم سنة الا عمل بها الاءمة بعده ( قال الشافعي ) فقلت له وقد حفظ عن النبي صلي الله عليه وسلم اشياء لا يحفظ عن احد من خلفاءه فيها شء فقال نعم سنن كثيرة ولكن من اين تري ذلك ( قال الشافعي ) فقلت استغني فيها بالخبر ( ( ( فالخبر ) ) ) عن رسول الله صلي الله عليه وسلم عمن بعده وذلك ان بالخلق الحاجة الي الخبر عنه وان عليهم اتباعه ولعل منها ما لم يرد علي من بعده قال فمثل لي ما علمت انه ورد علي من بعده من خلفاءه فلم يحك عنه فيه شء قلت قول النبي صلي الله عليه وسلم ليس فيما دون خمسة اوسق صدقة لا اشك ان قد ورد علي جميع خلفاءه لانهم كانوا القاءمين باخذ العشر من الناس ولم يحفظ عن واحد منهم فيها شء قال صدقت هذا بين قلت وله امثال كثيرة قد كتبناها في غير هذا الموضع فقلت اذا كان يرد علينا الخبر عن بعض خلفاءه ويرد علينا الخبر عنه يخالفه فنصير الي الخبر عن النبي صلي الله عليه وسلم لان لكل غاية وغاية العلم كتاب الله عز وجل وسنة رسوله صلي الله عليه وسلم اتعلم ان السنة ما كانت موجودة مستغني بها  عن غيرها قال نعم وقد سمعتك ذكرت ما لا اجهل من انه قد يرد عن غير واحد من اصحاب النبي صلي الله عليه وسلم القول يقوله توجد السنة بخلافه فان وجدها رجع اليها وان وجدها من بعده صار اليها فهذا يدل علي ما ذكرت من استغناء السنة عما سواها وبالمدينة من اصحاب النبي صلي الله عليه وسلم نحو من ثلاثين الف رجل ان لم يزيدوا لعلك لا تروي عنهم قولا واحدا عن ستة نعم انما تروي القول عن الواحد والاثنين والثلاثة والاربعة متفرقين فيه او مجتمعين والاكثر التفرق فاين الاجماع ( قال الشافعي ) رحمه الله قلت له ضع لقولك اذا كان الاكثر مثالا قال نعم كان خمسة نفر من اصحاب النبي صلي الله عليه وسلم قالوا قولا متفقين عليه وقال ثلاثة قولا مخالفا لقولهم فالاكثر اولي ان يتبع فقلت هذا قلما يوجد وان وجد ايجوز ان تعده اجماعا وقد تفرقوا موافقة قال نعم علي معني ان الاكثر مجتمعون قلت فاذا كان اصحاب النبي صلي الله عليه وسلم من العدد علي ما وصفت فهل فيمن لم ترووا عنه من اصحاب النبي صلي الله عليه وسلم دلالة موافقة الاكثر فيكونون اكثر بعددهم ومن وافقهم ( ( ( موافقتهم ) ) ) او موافقة الثلاثة الاقلين فيكون الاقلون الاكثرين بمن وافقهم لا تدري لعلهم متفرقون ولا تدري اين الاقل واصحاب النبي صلي الله عليه وسلم كلهم ممن له ان يقول في العلم قال ما ادري كيف قولهم لو قالوا وان لهم ان يقولوا قلت والصدق فيه ابدا ان لا يقول احد شيءا لم يقله احد انه قاله ولو قلت وافقوا بعضهم قال غيرك بل خالفوه قال ولا ليس الصدق ان تقول وافقوا ولا خالفوا بالصمت قلت هذا الصدق قلت فتري ادعاء الاجماع يصح لمن ادعاه في شء من خاص العلم ( قال الشافعي ) وقلت له فهكذا التابعون بعدهم وتابعو التابعين وقال وكيف تقول انت قلت ما علمت بالمدينة ولا بافق من افاق الدنيا احدا من اهل العلم ادعي طريق الاجماع (  ) الا بالفرض وخاص من العلم الا حدثنا ذلك الذي فيه اجماع يوجد فيه الاجماع بكل بلد ولقد ادعاه بعض اصحاب المشرقيين فانكر عليه جميع من سمع قوله من اهل العلم دعواه الاجماع حيث ادعاه وقالوا اومن قال ذلك منهم لو ان شيءا روي عن نفر من اصحاب النبي صلي الله عليه وسلم ثم عن نفر من التابعين فلم يرو عن مثلهم خلافهم ولا موافقتهم ما دل علي اجماع من لم يرو عنه منهم لانه لا يدري مجتمعون ام مفترقون لو قالوا وسمعت بعضهم يقول لو كان بيننا من السلف ماءة رجل واجمع منهم عشرة علي قول ايجوز ان ندعي ان التسعين مجتمعون معهم وقد نجدهم يختلفون في بعض الامور ولو جاز لنا اذا قال لنا قاءل شيءا اخذنا به لم نحفظ عن غيره قولا يخالفه ولا يوافقه ان ندعي موافقته جاز لغيرنا ممن خالفنا ان يدعي موافقته له ومخالفته لنا ولكن لا يجوز ان يدعي علي احد فيما لم يقل فيه شء ( قال الشافعي ) رحمه الله تعالي فقال لي فكيف يصح ان تقول اجماعا قلت يصح في الفرض الذي لا يسع جهله من الصلوات والزكاة وتحريم الحرام واما علم الخاصة في الاحكام الذي لا يضير جهله علي العوام والذي انما علمه عند الخواص من سبيل خبر الخواص وقليل ما يوجد من هذا فنقول فيه واحدا من قولين نقول لا نعلمهم اختلفوا فيما لا نعلمهم اختلفوا فيه ونقول فيما اختلفوا فيه اختلفوا واجتهدوا فاخذنا اشبه اقاويلهم بالكتاب والسنة وان لم يوجد عليه دلالة من واحد منهما وقلما يكون الا ان يوجد او احسنها عند اهل العلم في ابتداء التصرف والمعقب ويصح اذا اختلفوا كما وصفت ان نقول روي هذا القول عن نفر اختلفوا فيه فذهبنا الي قول ثلاثة دون اثنين واربعة دون ثلاثة ولا نقول هذا اجماع فان الاجماع قضاء علي من لم يقل ممن لا ندري ما يقول لو قال وادعاء رواية الاجماع وقد يوجد مخالف فيما ادعي فيه الاجماع  ( قال الشافعي ) رحمه الله تعالي فقال قد علمت انهم اختلفوا في الراي الذي لا متقدم فيه من كتاب ولا سنة افيوجد فيما اختلفوا فيه كتاب وسنة قلت نعم قال واين قلت قال الله عز وجل @QB@ والمطلقات يتربصن بانفسهن ثلاثة قروء @QE@ وقال عمر بن الخطاب وعلي وبن مسعود وابو موسي الاشعري لا تحل المراة حتي تغتسل من الحيضة الثالثة وذهبوا الي ان الاقراء الحيض وقال هذا بن المسيب وعطاء وجماعة من التابعين والمفتين بعدهم الي اليوم وقالت عاءشة وزيد بن ثابت وبن عمر الاقراء الاطهار فاذا طعنت في الدم من الحيضة الثالثة فقد حلت وقال هذا القول بعض التابعين وبعض المفتين الي اليوم وقال الله تعالي @QB@ واولات الاحمال اجلهن ان يضعن حملهن @QE@ فقال علي بن ابي طالب تعتد اخر الاجلين وروي عن بن عباس مثل قوله وقال عمر بن الخطاب اذا وضعت ذا بطنها فقد حلت وفي هذا كتاب وسنة وفي الاقراء قبله كتاب ودلالة من سنة وقال الله جل ثناءه @QB@ للذين يءلون من نساءهم تربص اربعة اشهر @QE@ فهي تطليقة وروي عن عثمان وزيد بن ثابت خلافه وقال علي بن ابي طالب وبن عمر ونفر من اصحاب النبي صلي الله عليه وسلم من الانصار لا يقع عليها طلاق ويوقف فاما ان يفء واما ان يطلق ومسح رسول الله صلي الله عليه وسلم علي الخفين فانكر المسح علي بن ابي طالب وعاءشة وبن عباس وابو هريرة وهءلاء اهل علم بالنبي صلي الله عليه وسلم ومسح عمر وسعد وبن عمر وانس بن مالك وهءلاء اهل علم به والناس مختلفون في هذه الاشياء وفي كل واحد منها كتاب او كتاب وسنة قال ومن اين تري ذلك فقلت تحتمل الاية المعنيين فيقول اهل اللسان باحدهما ويقول غيرهم منهم بالمعني الاخر الذي يخالفه والاية محتملة لقولهما معا لاتساع لسان العرب واما السنة فتذهب علي بعضهم وكل من ثبتت عنده السنة قال بها ان شاء الله ولم يخالفها لان كثيرا منها ياتي واضحا ليس فيه تاويل ( قال الشافعي ) وذكرت له مس الذكر فان عليا وبن عباس وعمار بن ياسر وحذيفة وبن مسعود لا يرون فيه الوضوء وبن المسيب وغيره بالمدينة لا يرون منه الوضوء وسعدا وبن عمر يريان فيه الوضوء وبعض التابعين بالمدينة وفيه للنبي صلي الله عليه وسلم سنة بان يتوضا منه اخذنا بها وقد يروي عن سعيد انه لا يري منه الوضوء ( قال الشافعي ) رحمه الله وقلت الاجماع من اقوام مما يقدر عليه فكيف تكلف من ادعي الاجماع من المشرقيين حكاية خبر الواحد الذي لا يقوم به حجة فنظمه فقال حدثني فلان عن فلان وترك ان يتكلف هذا في الاجماع فيقول حدثني فلان عن فلان لنص الاجماع الذي يلزم اولي به من نص الحديث الذي لا يلزم عنده قال انه يقول يكثر هذا عن ان ينص فقلت له فينص منه اربعة وجوه او خمسة فقد طلبنا ان نجد ما يقول فما وجدنا اكثر من دعواه بل وجدنا بعض ما يقول الاجماع متفرقا فيه ( قال الشافعي ) فقال فان قلت اذا وجدت قرنا من اهل العلم ببلد علم يقولون القول يكون اكثرهم متفقين عليه سميت ذلك اجماعا وافقه من قبله او خالفه فاما من قبلهم فلا يكون الاكثر منهم يتفقون علي شء بجهالة ما كان قبلهم ولا يتركون ما قبلهم ابدا الا بانه منسوخ او عندهم ما هو اثبت منه وان لم يذكروه قلت افرايت اذا اجزت لهم خلاف من فوقهم وهم لم يحكوا لك انهم تركوا علي من قبلهم قولهم لشء علموه اتجيز ذلك بتوهمك عليهم انهم لا يدعونه الا بحجة ثابتة وان لم يذكروها وقد يمكن ان لا يكونوا علموا قول من قبلهم فقالوا باراءهم اتجيز لمن بعدهم ان يدعوا عليهم اقاويلهم التي قبلتها منهم ثم يقولون لمن بعدهم ما قلت لهم هم لا يدعونها الا بحجة وان لم يذكروها قال فان قلت نعم قلت اذا تجعل العلم ابدا للاخرين كما قلت او لا قال فان قلت لا قلت  فلا تجعل لهم ان يخالفوا من قبلهم قال فان قلت اجيز بعض ذلك دون بعض قلت فانما زعمت انك انت العلم فما اجزت جاز وما رددت رد افتجعل هذا لغيرك في البلدان فما من بلاد المسلمين بلد الا وفيه علم قد صار اهله الي اتباع قول رجل من اهله في اكثر اقاويله افتري لاهل مكة حجة ان قلدوا عطاء فما وافقه من الحديث وافقوه وما خالفه خالفوه في الاكثر من قوله او تري لاهل البصرة حجة بمثل هذا في الحسن او بن سيرين او لاهل الكوفة في الشعبي وابراهيم ولاهل الشام وكل من وصفنا اهل علم وامامة في دهره وفوق من بعدهم وانما العلم اللازم الكتاب والسنة وعلي كل مسلم اتباعهما قال فتقول انت ماذا قلت اقول ما كان الكتاب والسنة موجودين فالعذر عمن سمعهما مقطوع الا باتباعهما فاذا لم يكن ذلك صرنا الي اقاويل اصحاب رسول الله صلي الله عليه وسلم او واحد منهم ثم كان قول الاءمة ابي بكر او عمر او عثمان اذا صرنا فيه الي التقليد احب الينا وذلك اذا لم نجد دلالة في الاختلاف تدل علي اقرب الاختلاف من الكتاب والسنة فنتبع ( ( ( فيتبع ) ) ) القول الذي معه الدلالة لان قول الامام مشهور بانه يلزمه الناس ومن لزم قوله الناس كان اشهر ممن يفتي الرجل او النفر وقد ياخذ بفتياه او يدعها واكثر المفتين يفتون للخاصة في بيوتهم ومجالسهم ولا تعني العامة بما قالوا عنايتهم بما قال الامام وقد وجدنا الاءمة يبتدءون فيسالون عن العلم من الكتاب والسنة فيما ارادوا ان يقولوا فيه ويقولون فيخبرون بخلاف قولهم فيقبلون من المخبر ولا يستنكفون علي ان يرجعوا لتقواهم الله وفضلهم في حالاتهم فاذا لم يوجد عن الاءمة فاصحاب رسول الله صلي الله عليه وسلم من الدين في موضع اخذنا بقولهم وكان اتباعهم اولي بنا من اتباع من بعدهم والعلم طبقات شتي الاولي الكتاب والسنة اذا ثبتت السنة ثم الثانية الاجماع فيما ليس فيه كتاب ولا سنة والثالثة ان يقول بعض اصحاب النبي صلي الله عليه وسلم ولا نعلم له مخالفا منهم والرابعة اختلاف اصحاب النبي صلي الله عليه وسلم في ذلك الخامسة القياس علي بعض الطبقات ولا يصار الي شء غير الكتاب والسنة وهما موجودان وانما يءخذ العلم من اعلي وبعض ما ذهبتم اليه خلاف هذا ذهبت الي اخذ العلم من اسفل قال فتوجدني بالمدينة قول نفر من التابعين متابعا الاغلب الاكثر من قول من قال فيه نتابعهم وان خالفهم احد منهم كان اقل عددا منهم فنترك قول الاغلب الاكثر لمتقدم قبله او لاحد في دهرهم او بعدهم قلت نعم قال فاذكر منه واحدا قلت ان لبن الفحل لا يحرم قال فمن قاله من التابعين او السابقين ( قال الشافعي ) اخبرنا عبد الوهاب الثقفي عن يحيي بن سعيد قال اخبرني مروان بن عثمان بن ابي سعيد بن المعلي الانصاري ان رجلا ارضعته ام ولد رجل من مزينة وللمزني امراة اخري سوي المراة التي ارضعت الرجل وانها ولدت من المزني جارية فلما بلغ بن الرجل وبلغت بنت الرجل خطبها فقال له الناس ويلك انها اختك فرفع ذلك الي هشام بن اسماعيل فكتب فيه الي عبد الملك فكتب اليه عبد الملك انه ليس ذلك برضاع اخبرنا الشافعي اخبرنا الدراوردي عن محمد بن عمرو عن عبد الرحمن بن القاسم انه كان يقول كان يدخل علي عاءشة من ارضعه بنات ابي بكر ولا يدخل عليها من ارضعه نساء بني ابي بكر ( قال ) اخبرنا عبد العزيز بن محمد بن عبيد عن محمد بن عمرو بن علقمة عن ابي عبيدة بن عبد الله بن زمعة ان امه زينب بنت ابي سلمة ارضعتها اسماء بنت ابي بكر امراة الزبير فقالت زينب بنت ابي سلمة فكان الزبير يدخل علي وانا امتشط فياخذ بقرن من قرون راسي فيقول اقبلي علي فحدثيني اراه انه ابي وما ولد فهم اخوتي ثم ان عبد الله بن الزبير قبل الحرة ارسل الي فخطب ام كلثوم بنتي علي حمزة بن الزبير وكان حمزة للكلبية فقلت لرسوله وهل تحل له انما هي بنت اخته فارسل الي عبد الله انما اردت بهذا المنع لما قبلك ليس لك باخ انا وما ولدت اسماء فهم اخوتك وما كان من ولد الزبير من  غير اسماء فليسوا لك باخوة فارسلي فسلي عن هذا فارسلت فسالت واصحاب النبي صلي الله عليه وسلم متوافرون وامهات المءمنين فقالوا لها ان الرضاعة من قبل الرجال لا تحرم شيءا فانكحتها اياه فلم تزل عنده حتي هلك ( قال الشافعي ) رحمه الله اخبرنا عبد العزيز بن محمد عن محمد بن عمرو بن علقمة عن بعض ال رافع بن خديج ان رافع بن خديج كان يقول الرضاعة من قبل الرجال لا تحرم شيءا ( قال الشافعي ) واخبرنا عبد العزيز بن محمد عن محمد بن عمرو بن علقمة عن يزيد بن عبد الله بن قسيط عن بن المسيب وعن ابي سلمة بن عبد الرحمن وعن سليمان بن يسار وعن عطاء بن يسار ان الرضاعة من قبل الرجال لا تحرم شيءا ( قال الشافعي ) واخبرنا عبد العزيز بن محمد عن مروان بن عثمان بن ابي المعلي ان عبد الملك كان يري الرضاعة من قبل الرجال لا تحرم شيءا قلت لعبدالعزيز ( ( ( لعبد ) ) ) من ( ( ( العزيز ) ) ) عبد الملك قال بن مروان ( قال الشافعي ) اخبرنا عبد العزيز بن محمد عن سليمان بن بلال عن ربيعة بن ابي عبد الرحمن ان بن عباس كان لا يري الرضاعة من قبل الرجال تحرم شيءا قال عبد العزيز وذلك كان راي ربيعة وراي فقهاءنا وابو بكر حدث عمرو بن الشريد عن بن عباس في اللقاح واحد وقال حديث رجل من اهل الطاءف وما رايت من فقهاء اهل المدينة احدا يشك في هذا الا انه روي عن الزهري خلافهم فما التفتم اليه وهءلاء اكثر واعلم ( قال الشافعي ) اخبرنا سفيان بن عيينة عن الزهري عن عروة عن عاءشة قالت جاء عمي من الرضاعة افلح بن ابي القعيس يستاذن علي بعد ما ضرب الحجاب فلم اذن له فلما جاء النبي صلي الله عليه وسلم اخبرته فقال انه عمك فاذنوا له فقال وما في هذا حديثها ام ابي بكر ارضعته فليس هذا برضاع من قبل الرجل ولو كان من قبل الرجل لكانت عاءشة اعلم بمعني ما تركت وكان اصحاب رسول الله والتابعون ومن ادركنا متفقين او اكثرهم علي ما قلنا ولا يتفق هءلاء علي خلاف سنة ولا يدعون شيءا الا لما هو اقوي منه قال قد كان القاسم بن محمد ينكر حديث ابي القعيس ويدفعه دفعا شديدا ويحتج فيه ان راي عاءشة خلافه ( قال الشافعي ) فقلت له اتجد بالمدينة من علم الخاصة اولي ان يكون علما ظاهرا عند اكثرهم من ترك تحريم لبن الفحل فقد تركناه وتركتموه ومن يحتج بقوله اذا كنا نجد في الخبر عن النبي صلي الله عليه وسلم كالدلالة علي ما نقول افيجوز لاحد ترك هذا العام المتصل ممن سمينا من ازواج النبي صلي الله عليه وسلم واصحابه والتابعين من بعدهم بالمدينة ان يقبل ابدا عمل اكثر من روي عنه بالمدينة اذا خالف حديثا عن النبي صلي الله عليه وسلم نصا ليس من هذا الحديث لعلمهم بحديث النبي صلي الله عليه وسلم قال لا قلت فقد ترك من تحتج بقوله هذا ولا اعلم له حجة في تركه الا ما ثبت عن النبي صلي الله عليه وسلم انه يحرم من الرضاعة ما يحرم من الولاد فقال لي فلذلك تركته فقلت نعم فانا لم يختلف بنعمة الله قولي في انه لا اذهب اذا ثبت عن النبي صلي الله عليه وسلم شء الي ان ادعه لاكثر او اقل مما خالفنا في لبن الفحل وقد يمكن ان يتاول حديث النبي صلي الله عليه وسلم اذا كان من النساء دون الرجال فاخذت باظهر معانيه وان امكن فيه باطن وتركتم قول الاكثر ممن روي عنه بالمدينة ولو ذهبت الي الاكثر وتركت خبر الواحد عن النبي صلي الله عليه وسلم ما عدوت ما قال الاكثر من المدنيين ان لا يحرم لبن الفحل ( قال الشافعي ) وقد وصفت حديث الليث بن سعد عن الزهري عن بن المسيب انه قال عقل العبد في ثمنه كجراح الحر في ديته وقال الزهري وان ناسا ليقولون يقوم سلعة فالزهري قد جمع قول اهل المدينة بن المسيب ومن خالفه فخرج صاحبكم من جميع ذلك وهذا عندكم كالاجماع ما هو دونه عندكم اجماع بالمدينة وقلتم قولا خارجا من قول اهل العلم بالمدينة واقاويل بني ادم وذلك انكم قلتم مرة كما قال بن المسيب جراحه في ثمنه كجراح الحر في ديته في الموضحة والمامومة والمنقلة ثم خالفتم ما قال بن المسيب اخري فقلتم يقوم سلعة فيكون  فيها نقصه فلم تمحضوا قول واحد منهم ( قال الشافعي ) وقد اخبرنا مالك عن ابي حازم بن دينار عن سهل بن سعد الساعدي ان رجلا خطب الي النبي صلي الله عليه وسلم امراة فقال له النبي صلي الله عليه وسلم في صداقها التمس ولو خاتما من حديد وحفظنا عن عمر قال في ثلاث قبضات من زبيب فهو مهر ( قال الشافعي ) واخبرنا سفيان بن عيينة عن ايوب بن موسي عن يزيد بن عبد الله بن قسيط عن بن المسيب انه قال لم تحل الموهوبة لاحد بعد النبي صلي الله عليه وسلم ولو اصدقها سوطا حلت له اخبرنا بن ابي يحيي قال سالت ربيعة كم اقل الصداق قال ما تراضي به الاهلون فقلت وان كان درهما قال وان كان نصف درهم قلت وان كان اقل قال لو كان قبضة حنطة او حبة حنطة قال فهذا حديث ثابت عن النبي صلي الله عليه وسلم وخبر عن عمر وعن بن المسيب وعن ربيعة وهذا عندكم كالاجماع وقد سالت الدراوردي هل قال احد بالمدينة لا يكون الصداق اقل من ربع دينار فقال لا والله ما علمت احدا قاله قبل مالك وقال الدراوردي اراه اخذه عن ابي حنيفة قلت للشافعي فقد فهمت ما ذكرت وما كنت اذهب في العلم الا الي قول اهل المدينة فقال الشافعي ما علمت احدا انتحل قول اهل العلم من اهل المدينة اشد خلافا لاهل المدينة منكم ولو شءت ان اعد عليكم ما املا به ورقا كثيرا مما خالفتم فيه كثيرا من اهل المدينة عددتها عليكم وفيما ذكرت لك ما دلك علي ما وراءه ان شاء الله فقلت للشافعي ان لنا كتابا قد صرنا الي اتباعه وفيه ذكر ان الناس اجتمعوا وفيه الامر المجتمع عليه عندنا وفيه الامر عندنا ( قال الشافعي ) فقد اوضحنا لكم ما يدلكم علي ان ادعاء الاجماع بالمدينة وفي غيرها لا يجوز ان يكون وفي القول الذي ادعيتم فيه الاجماع اختلاف واكثر ما قلتم الامر المجتمع عليه مختلف فيه وان شءتم مثلت لكم شيءا اجمع واقصر واحري ان تحفظه مما فرغت منه قلت فاذكر ذلك قال تعرفون انكم قلتم اجتمع الناس ان سجود القران احد عشر ليس في المفصل منها شء قلت نعم ( قال الشافعي ) وقد رويتم عن ابي هريرة انه سجد في @QB@ اذا السماء انشقت @QE@ واخبرهم ان النبي سجد فيها وان عمر بن عبد العزيز امر محمد بن مسلمة مر القراء ان يسجدوا في @QB@ اذا السماء انشقت @QE@ وان عمر سجد في النجم قلت نعم وان عمر وبن عمر سجدا في سورة الحج سجدتين قلت نعم قال فقد رويتم السجود في المفصل عن النبي صلي الله عليه وسلم وعمر وابي هريرة وعمر بن عبد العزيز فمن الناس الذين اجمعوا علي السجود دون المفصل وهءلاء الاءمة الذين ينتهي الي اقاويلهم ما حفظنا نحن وانتم في كتابكم عن احد الا سجودا في المفصل ولو رواه عن رجل او اثنين او ثلاثة ما جاز ان يقول اجمع الناس وهم مختلفون قلت فتقول انت اجمع الناس ان المفصل فيه سجود قال لا اقول اجتمعوا ولكن اعزي ذلك الي من قاله وذلك الصدق ولا ادعي الاجماع الا حيث لا يدفع احد انه اجماع افتري قولكم اجتمع الناس ان سجود القران احدي عشرة ليس في المفصل منها شء يصح لكم ابدا قلت فعلي اي شء اكثر الفقهاء قال علي ان في المفصل سجودا واكثر اصحابنا علي ان في سورة الحج سجدتين وهم يروون ذلك عن عمر وبن عمر وهذا مما ادخل في قوله اجتمع الناس لانكم لا تعدون في الحج الا سجدة وتزعمون ان الناس اجتمعوا علي ذلك فاي الناس يجتمعون وهو يروي عن عمر وبن عمر انهما سجدا في الحج سجدتين اوتعرفون انكم احتججتم في اليمين مع الشاهد علي من خالفه وقد احتجوا عليكم بالقران فقلتم ارايتم الرجل يدعي علي الرجل الحق اليس يحلف له فان لم يحلف رد اليمين علي المدعي فحلف واخذ حقه وقلتم هذا ما لا شك فيه عند احد من الناس ولا في بلد من البلدان فاذا اقر بهذا فليقر باليمين مع الشاهد وانه ليكتفي من هذا بثبوت السنة ولكن الانسان يحب ( ( ( يجب ) ) ) ان يعرف وجه الصواب فهذا تبيان ما اشكل من ذلك ان شاء الله تعالي قال بلي وهكذا نقول ( قال الشافعي ) افتعرفون الذين خالفوكم في اليمين ( ( ( اليمن ) ) )  مع الشاهد يقولون بما قلتم قلت مماذا ( ( ( ماذا ) ) ) قال اتعرفونهم يحلفون المدعي عليه فان نكل رد اليمين علي المدعي فان حلف اخذ حقه قلت لا ( قال الشافعي ) رحمه الله تعالي وانتم تعلمون انهم لا يردون اليمين ابدا وانهم يزعمون ان رد اليمين خطا وان المدعي عليه اذا نكل عن اليمين اخذ منه الحق قلت بلي قال فقد رويتم عليهم ما لا يقولون قلت نعم ولكن لعله زلل ( قال الشافعي ) رحمه الله تعالي او يجوز الزلل ( ( ( لزلل ) ) ) في الرواية عن الناس ثم عن الناس كافة وان جاز الزلل في الاكثر جاز في الاقل وفيما قلتم المجتمع عليه وقولكم المجتمع عليه اكثر من هذا الزلل لانكم اذا زللتم في ان ترووا عن الناس عامة فعلي اهل المدينة لانهم اقل من الناس كلهم ( قال الشافعي ) وقولكم في اليمين مع الشاهد نكتفي منها بثبوت السنة حجة عليكم وانتم لا تروون فيها الا حديث جعفر عن ابيه منقطعا ولا تروون فيها حديثا يصح عن احد من اصحاب رسول الله صلي الله عليه وسلم والزهري وعروة ينكرانها بالمدينة وعطاء ينكرها بمكة فان كانت تثبت السنة فلن يعمل بهذا اصحاب النبي صلي الله عليه وسلم وانتم لا تحفظون ان احدا من اصحاب النبي صلي الله عليه وسلم عمل باليمين مع الشاهد فان كنتم ثبتموها باجماع التابعين بالمدينة فقد اختلفوا فيها وان كنتم ثبتموها بخبر منقطع كان الخبر المتصل اولي ان نثبتها به قلت فانت تثبتها قال من غير الطريق الذي ثبتموها بحديث متصل عن النبي صلي الله عليه وسلم لا بعمل ( ( ( يعمل ) ) ) به ولا اجماع ولو لم تثبت الا بعمل واجماع كان بعيدا من ان تثبت وهم يحتجون عليها بقران وسنة ( قال الشافعي ) وزعمت ان ما اشكل فيما احتججتم به مما رويتم علي الناس انهم في البلدان لا يخالفون فيه والذين يخالفونكم في اليمين مع الشاهد يقولون نحن اعطينا بالنكول عن اليمين فبالسنة اعطينا ليس في القران ذكر يمين ولا نكول عنها وهذا سنة غير القران وغير الشهادات زعمنا ان القران يدل علي ان لا يعطي احد من جهة الشهادات الا بشاهدين او شاهد وامراتين والنكول ليس في معني الشهادات والذي احتججتم به عليهم ليست عليهم فيه حجة والله المستعان انما الحجة عليهم في غير ما احتججتم به واذا احتججتم بغير حجة فهو اشكال ما بان من الحجة لا بيان ( ( ( يبان ) ) ) ما اشكل منها ( قال الشافعي ) اخبرنا الثقة عن عبد الله بن الحرث ان لم اكن سمعته من عبد الله عن مالك بن انس عن يزيد بن عبد الله بن قسيط عن سعيد بن المسيب ان عمر بن الخطاب وعثمان بن عفان قضيا في الملطاة بنصف دية الموضحة ( قال الشافعي ) اخبرنا مسلم بن خالد عن بن جريج عن الثوري عن يزيد بن قسيط عن بن المسيب عن عمر وعثمان مثله او مثل معناه ( قال الشافعي ) واخبرني من سمع بن نافع يذكر عن مالك بهذا الاسناد مثله ( قال الشافعي ) وقرانا علي مالك انا لم نعلم احدا من الاءمة في القديم ولا في الحديث افتي فيما دون الموضحة بشء ( قال الشافعي ) فنفيتم ان يكون احد من الاءمة في قديم او حديث قضي دون الموضحة بشء وانتم والله يغفر لنا ولكم تروون عن امامين عظيمين من المسلمين عمر وعثمان انهما قضيا فيما دون الموضحة بشء موقت ولست اعرف لمن قال هذا مع روايته وجها ذهب اليه والله المستعان وما عليه ان يسكت عن رواية ما روي من هذا او اذا رواه فلم يكن عنده كما رواه ان يتركه وذلك كثير في كتابه ولا ينبغي ان يكون علم ما قد اخبر انه علمه ارايت لو وجد كل وال من الدنيا شيءا ترك يقضي فيما دون الموضحة بشء كان جاءزا له ان يقول لم نعلم احدا من الاءمة قضي فيها بشء وقد روي عن امامين عظيمين من اءمة المسلمين انهما قضيا مع انه لم يرو عن احد من الناس امام ولا امير ترك ان قضي فيما دون الموضحة بشء ولا نجد وقد روينا ان زيد بن ثابت قد قضي فيما دون الموضحة حتي في الدامية فان قال رويت فيه حديثا واحدا افرايت جميع ما ثبت مما اخذ به انما روي فيه حديثا واحدا هل يستقيم ان يكون يثبت بحديث واحد فلم  يكن له ان يقول ما علمنا اولا يثبت بحديث واحد فينبغي ان تدع عامة ما رويت وثبت من حديث واحد قال سالت الشافعي من اي شء يجب الوضوء قال من ان ينام الرجل مضطجعا او يحدث من ذكر او دبر او يقبل امراته او يلمسها او يمس ذكره قلت فهل قال قاءل ذلك ( قال الشافعي ) نعم قد قرانا ذلك علي صاحبنا والله يغفر لنا وله قلت ونحن نقوله ( قال الشافعي ) انكم مجمعون انكم توضءون من مس الذكر والمس والجس للمراة فقلت نعم قال فتعلم من اهل الدنيا خلقا ينفي عن نفسه ان يوجب الوضوء الا من ثلاث فانت توجب الوضوء من اثنين او ثلاث سواء من اضطركم الي ان تقولوا هذا الذي لا يوجد في قول احد من بني ادم غيركم والله المستعان ثم تءكدونه بان تقولوا الامر عندنا قال فان كان الامر عندكم اجماع اهل المدينة فقد خالفتموهم وان كانت كلمة لا معني لها فلم تكلفتموها فما علمت قبلك احدا تكلم بها وما كلمت منكم احدا قط فرايته يعرف معناها وما ينبغي لكم ان تجهلوا اذا كان يوجد فيه ما ترون والله اعلم   @ 
