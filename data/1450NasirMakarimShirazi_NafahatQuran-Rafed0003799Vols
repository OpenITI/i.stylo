 ( @QUR@ في جنة عالية ). (الغاشية / )
 ( @QUR@ فيها عين جارية ). (الغاشية / )
 ( @QUR@ فيها سرر مرفوعة ). (الغاشية / )
 ( @QUR@ واكواب موضوعة ). (الغاشية / )
 ( @QUR@ ونمارق مصفوفة ). (الغاشية / )
