 وقال صلي الله عليه وسلم الدعاء بين الاذان والاقامة لا يرد + حديث الدعاء بين الاذان والاقامة لايرد اخرجه ابو داود والنساءي في اليوم والليلة والترمذي وحسنه من حديث انس وضعفه ابن عدي وابن القطان ورواه في اليوم والليلة باسناد اخر جيد وابن حبان والحاكم وصححه + وقال صلي الله عليه وسلم ايضا الصاءم لا ترد دعوته + حديث الصاءم لا ترد دعوته اخرجه الترمذي وقال حسن وابن ماجه من حديث ابي هريرة بزيادة فيه + وبالحقيقة يرجع شرف الاوقات الي شرف الحالات ايضا اذ وقت السحر وقت صفاء القلب واخلاصه وفراغه من المشوشات ويوم عرفة ويوم الجمعة وقت اجتماع الهمم وتعاون القلوب علي استدرار رحمة الله عز وجل فهذا احد اسباب شرف الاوقات سوي ما فيها من اسرار لا يطلع البشر عليها
 وحالة السجود ايضا اجدر بالاجابة قال ابو هريرة رضي الله عنه قال النبي  صلي الله عليه وسلم اقرب ما يكون العبد من ربه عز وجل وهو ساجد فاكثروا فيه من الدعاء + حديث ابي هريرة اقرب ما يكون العبد من ربه وهو ساجد فاكثروا من الدعاء رواه مسلم + وروي ابن عباس رضي الله عنهما عن النبي صلي الله عليه وسلم انه قال اني نهيت ان اقرا القران راكعا او ساجدا فاما الركوع فعظموا فيه الرب تعالي واما السجود فاجتهدوا فيه بالدعاء فانه قمن ان يستجاب لكم + حديث ابن عباس انني نهيت ان اقرا القران راكعا او ساجدا الحديث اخرجه مسلم ايضا +
 الثالث ان يدعو مستقبل القبلة ويرفع يديه بحيث يري بياض ابطيه وروي جابر بن عبد الله ان رسول الله صلي الله عليه وسلم اتي الموقف بعرفة واستقبل القبلة ولم يزل يدعو حتي غربت الشمس + حديث جابر ان رسول الله صلي الله عليه وسلم اتي الموقف بعرفة واستقبل القبلة ولم يزل يدعو حتي غربت الشمس الحديث اخرجه مسلم دون قوله يدعو فقال مكانها واقفا والنساءي من حديث اسامة بن زيد كنت ردفه بعرفات فرفع يديه يدعو ورجاله ثقات +
 وقال سلمان قال رسول الله صلي الله عليه وسلم ان ربكم حيي كريم يستحي من عبيده اذا رفعوا ايديهم اليه ان يردها صفرا + حديث سلمان ان ربكم حيي كريم يستحي من عبده اذا رفع يديه ان يردهما صفرا اخرجه ابو داود والترمذي وحسنه وابن ماجه والحاكم وقال اسناده صحيح علي شرطهما +
 وروي انس انه صلي الله عليه وسلم كان يرفع يديه حتي يري بياض ابطيه في الدعاء ولا يشير باصبعيه + حديث انس كان يرفع يديه حتي يري بياض ابطيه في الدعاء ولا يشير باصبعه اخرجه مسلم دون قوله ولا يشير باصبعه والحديث متفق عليه لكن مقيد بالاستسقاء +
 وروي ابو هريرة رضي الله عنه انه صلي الله عليه وسلم مر علي انسان يدعو ويشير باصبعيه السبابتين فقال صلي الله عليه وسلم احد احد + حديث ابي هريرة مر علي انسان يدعو باصبعيه السبابتين فقال رسول الله صلي الله عليه وسلم احد احد اخرجه النساءي وقال حسن وابن ماجه والحاكم وقال صحيح الاسناد + اي اقتصر علي الواحدة
 وقال ابو الدرداء رضي الله عنه ارفعوا هذه الايدي قبل ان تغل بالاغلال ثم ينبغي ان يمسح بهما وجهه في اخر الدعاء قال عمر رضي الله عنه كان رسول الله صلي الله عليه وسلم اذا مد يديه في الدعاء لم يردهما حتي يمسح بهما وجهه + حديث عمر كان رسول الله صلي الله عليه وسلم اذا مد يديه في الدعاء لم يردهما حتي يمسح بهما وجهه اخرجه الترمذي وقال غريب والحاكم في المستدرك وسكت عليه وهو ضعيف +
 وقال ابن عباس كان صلي الله عليه وسلم اذا دعا ضم كفيه وجعل بطونهما مما يلي وجهه + حديث ابن عباس كان صلي الله عليه وسلم اذا دعا ضم كفيه وجعل بطونهما مما يلي وجهه اخرجه الطبراني في الكبير بسند ضعيف +
 فهذه هيءات اليد ولا يرفع بصره الي السماء قال صلي الله عليه وسلم لينتهين اقوام عن رفع ابصارهم الي السماء عند الدعاء او لتخطفن ابصارهم + حديث لينتهين اقوام عن رفع ابصارهم الي السماء عند الدعاء او لتخطفن ابصارهم اخرجه مسلم من حديث ابي هريرة وقال عند الدعاء في الصلاة +
 الرابع خفض الصوت بين المخافتة والجهر لما روي ان ابا موسي الاشعري قال قدمنا مع رسول الله فلما دنونا من المدينة كبر وكبر الناس ورفعوا اصواتهم فقال النبي صلي الله عليه وسلم يا ايها الناس ان الذي تدعون ليس باصم ولا غاءب ان الذي تدعون بينكم وبين اعناق ركابكم + حديث ابي موسي الاشعري يا ايها الناس ان الذي تدعون ليس باصم ولا غاءب متفق عليه مع اختلاف واللفظ الذي ذكره المصنف لابي داود +
 وقالت عاءشة رضي الله عنه في قوله عز وجل @QB@ ولا تجهر بصلاتك ولا تخافت بها @QE@ + حديث عاءشة في قوله تعالي @QB@ ولا تجهر بصلاتك ولا تخافت بها @QE@ اي بدعاءك متفق عليه + اي بدعاءك وقد اثني الله عز وجل علي نبيه زكرياء عليه السلام حيث قال @QB@ اذ نادي ربه نداء خفيا @QE@ وقال عز وجل @QB@ ادعوا ربكم تضرعا وخفية @QE@
 الخامس ان لا يتكلف السجع في الدعاء فان حال الداعي ينبغي ان يكون حال متضرع والتكلف لا يناسبه قال صلي الله عليه وسلم سيكون قوم يعتدون في الدعاء + حديث سيكون قوم يعتدون في الدعاء وفي رواية والطهور اخرجه ابو داود وابن ماجه وابن حبان والحاكم من حديث عبد الله بن مغفل + وقد قال عز وجل @QB@ ادعوا ربكم تضرعا وخفية انه @QE@  @QB@ لا يحب المعتدين @QE@ قيل معناه التكلف للاسجاع والاولي ان لا يجاوز الدعوات الماثورة فانه قد يعتدي في دعاءه فيسال ما لا تقتضيه مصلحته فما كل احد يحسن الدعاء ولذلك روي عن معاذ رضي الله عنه ان العلماء يحتاج اليهم في الجنة اذ يقال لاهل الجنة تمنوا فلا يدرون كيف يتمنون حتي يتعلموا من العلماء وقد قال صلي الله عليه وسلم اياكم والسجع في الدعاء حسب احدكم ان يقول اللهم اني اسالك الجنة وما قرب اليها من قول وعمل واعوذ بك من النار وما قرب اليها من قول وعمل + حديث اياكم والسجع في الدعاء بحسب احدكم ان يقول اللهم اني اسالك الجنة وما قرب اليها من قول وعمل واعوذ بك من النار وما قرب اليها من قول وعمل غريب بهذا السياق وللبخاري عن ابن عباس وانظر السجع من الدعاء فاجتنبه فاني عهدت اصحاب رسول الله صلي الله عليه وسلم لا يفعلون الا ذلك وابن ماجه والحاكم واللفظ له وقال صحيح الاسناد من حديث عاءشة عليك بالكوامل وفيه واسالك الجنة الي اخره + وفي الخبر سياتي قوم يعتدون في الدعاء والطهور ومر بعض السلف بقاص يدعو بسجع فقال له اعلي الله تبالغ اشهد لقد رايت حبيبا العجمي يدعو وما يزيد علي قوله اللهم اجعلنا جيدين اللهم لا تفضحنا يوم القيامة اللهم وفقنا للخير والناس يدعون من كل ناحية وراءه وكان يعرف بركة دعاءه
 وقال بعضهم ادع بلسان الذلة والافتقار لا بلسان الفصاحة والانطلاق
 ويقال ان العلماء الابدال لا يزيدون في الدعاء علي سبع كلمات فما دونها ويشهد له اخر سورة البقرة فان الله تعالي لم يخبر في موضع من ادعية عبادة اكثر من ذلك
 واعلم ان المراد بالسجع هو المتكلف من الكلام فان ذلك لا يلاءم الضراعة والذلة والا ففي الادعية الماثورة عن رسول الله صلي الله عليه وسلم كلمات متوازنة لكنها غير متكلفة كقوله صلي الله عليه وسلم اسالك الامن من يوم الوعيد والجنة يوم الخلود مع المقربين الشهود والركع السجود الموفين بالعهود انك رحيم ودود وانك تفعل ما تريد + حديث اسالك الامن يوم الوعيد والجنة يوم الخلود مع المقربين الشهود والركع السجود الموفين بالعهود انك رحيم ودود وانك تفعل ما تريد اخرجه الترمذي من حديث ابن عباس سمعت رسول الله صلي الله عليه وسلم يقول ليلة حين فرغ من صلاته فذكر حديثا طويلا مع جملته هذا وقال حديث غريب انتهي وفيه محمد بن عبد الرحمن بن ابي ليلي سيء الحفظ + وامثال ذلك فليقتصر علي الماثور من الدعوات او ليلتمس بلسان التضرع والخشوع من غير سجع وتكلف فالتضرع هو المحبوب عند الله عز وجل
 السادس التضرع والخشوع والرغبة والرهبة قال الله تعالي @QB@ انهم كانوا يسارعون في الخيرات ويدعوننا رغبا ورهبا @QE@ وقال عز وجل @QB@ ادعوا ربكم تضرعا وخفية @QE@ وقال صلي الله عليه وسلم اذا احب الله عبدا ابتلاه حتي يسمع تضرعه + حديث اذا احب الله عبدا ابتلاه حتي يسمع تضرعه اخرجه ابو منصور الديلمي في مسند الفردوس من حديث انس اذا احب الله عبدا صب عليه البلاء صبا الحديث وفيه دعه فاني احب ان اسمع صوته وللطبراني من حديث ابي امامة ان الله يقول للملاءكة انطلقوا الي عبدي فصبوا عليه البلاء الحديث @QB@ وفيه @QE@ فاني احب ان اسمع صوته وسندهما ضعيف +
 السابع ان يجزم الدعاء ويوقن بالاجابة ويصدق رجاءه فيه
 قال رسول الله صلي الله عليه وسلم لا يقل احدكم اذا دعا اللهم اغفر لي ان شءت اللهم ارحمني ان شءت ليعزم المسالة فانه لا مكره له + حديث لا يقل احدكم اللهم اغفر لي ان شءت اللهم ارحمني ان شءت ليعزم المسالة فانه لا مكره له متفق عليه من حديث ابي هريرة + وقال رسول الله صلي الله عليه وسلم اذا دعا احدكم فليعظم الرغبة فان الله لا يتعاظمه شء + حديث اذا دعا احدكم فليعظم الرغبة فان الله لا يتعاظمه شء اخرجه ابن حبان من حديث ابي هريرة + وقال صلي الله عليه وسلم ادعوا الله وانتم موقنون بالاجابة واعلموا ان الله عز وجل لا يستجيب دعاء من قلب غافل + حديث ادعوا الله وانتم موقنون بالاجابة واعلموا ان الله لا يستجيب دعاء من قلب غافل اخرجه الترمذي من حديث ابي هريرة وقال غريب والحاكم وقال مستقيم الاسناد وتفرد به صالح المري وهو احد زهاد البصرة قلت لكنه ضعيف في الحديث + وقال سفيان بن عيينة لا يمنعن احدكم من الدعاء ما يعلم من نفسه فان الله عز وجل اجاب دعاء شر الخلق ابليس لعنه الله اذ قال رب فانظرني الي يوم يبعثون قال انك من المنظرين
 الثامن ان يلح في الدعاء ويكرره ثلاثا قال ابن مسعود  كان صلي الله عليه وسلم اذا دعا دعا ثلاثا واذا سال سال ثلاثا + حديث ابن مسعود كان صلي الله عليه وسلم اذا دعا دعا ثلاثا واذا سال سال ثلاثا رواه مسلم واصله متفق عليه + وينبغي ان لا يستبطء الاجابة لقوله صلي الله عليه وسلم يستجاب لاحدكم ما لم يعجل فيقول قد دعوت فلم يستجب لي فاذا دعوت فاسال الله كثيرا فانك تدعو كريما + حديث يستجاب لاحدكم ما لم يعجل فيقول دعوت فلم يستجب لي متفق عليه من حديث ابي هريرة + وقال بعضهم اني اسال الله عز وجل منذ عشرين سنة حاجة وما اجابني وانا ارجو الاجابة سالت الله تعالي ان يوفقني لترك ما لا يعنيني
 وقال صلي الله عليه وسلم اذا سال احدكم ربه مسالة فتعرف الاجابة فليقل الحمد لله الذي بنعمته تتم الصالحات ومن ابطا عنه من ذلك فليقل الحمد لله علي كل حال + حديث اذا سال احدكم مسالة فتعرف الاجابة فليقل الحمد لله الذي بنعمته تتم الصالحات ومن ابطا عنه من ذلك شء فليقل الحمد لله علي كل حال اخرجه البيهقي في الدعوات من حديث ابي هريرة وللحاكم نحوه من حديث عاءشة مختصرا باسناد ضعيف +
 التاسع ان يفتتح الدعاء بذكر الله عز وجل فلا يبدا بالسءال قال سلمة بن الاكوع ما سمعت رسول الله صلي الله عليه وسلم يستفتح الدعاء الا استفتحه بقول سبحان ربي العلي الاعلي الوهاب + حديث سلمة بن الاكوع ما سمعت رسول الله صلي الله عليه وسلم يستفتح الدعاء الا استفتحه وقال سبحان ربي العلي الاعلي الوهاب اخرجه احمد والحاكم وقال صحيح الاسناد قلت فيه عمر بن راشد اليماني ضعفه الجمهور + قال ابو سليمان الداراني رحمه الله من اراد ان يسال الله حاجة فليبدا بالصلاة علي النبي صلي الله عليه وسلم ثم يساله حاجته ثم يختم بالصلاة علي النبي صلي الله عليه وسلم فان الله عز وجل يقبل الصلاتين وهو اكرم من ان يدع ما بينهما وروي في الخبر عن رسول الله صلي الله عليه وسلم انه قال اذا سالتم الله عز وجل حاجة فابتدءوا بالصلاة علي فان الله تعالي اكرم من ان يسءل حاجتين فيقضي احداهما ويرد الاخري + حديث اذا سالتم الله حاجة فابدءوا بالصلاة علي فان الله تعالي اكرم من ان يسال حاجتين فيعطي احداهما ويرد الاخري لم اجده مرفوعا وانما هو موقوف علي ابي الدرداء + رواه ابو طالب المكي
 العاشر وهو الادب الباطن وهو الاصل في الاجابة التوبة ورد المظالم والاقبال علي الله عز وجل بكنه الهمة فذلك هو السبب القريب في الاجابة فيروي عن كعب الاحبار انه قال اصاب الناس قحط شديد علي عهد موسي رسول الله صلي الله عليه وسلم فخرج موسي ببني اسراءيل يستسقي بهم فلم يسقوا حتي خرج ثلاث مرات ولم يسقوا فاوحي الله عز وجل الي موسي عليه السلام اني لا استجيب لك ولا لمن معك وفيكم نمام فقال موسي يا رب ومن هو حتي نخرجه من بيننا فاوحي الله عز وجل اليه يا موسي انهاكم عن النميمة واكون نماما فقال موسي لبني اسراءيل توبوا الي ربكم باجمعكم عن النميمة فتابوا فارسل الله تعالي عليهم الغيث
 وقال سعيد بن جبير قحط الناس في زمن ملك من ملوك بني اسراءيل فاستسقوا فقال الملك لبني اسراءيل ليرسلن الله تعالي علينا السماء او لنءذينه قيل له وكيف تقدر ان تءذيه وهو في السماء فقال اقتل اولياءه واهل طاعته فيكون ذلك اذي له فارسل الله تعالي عليهم السماء
 وقال سفيان الثوري بلغني ان بني اسراءيل قحطوا سبع سنين حتي اكلوا الميتة من المزابل واكلوا الاطفال وكانوا كذلك يخرجون الي الجبال يبكون ويتضرعون فاوحي الله عز وجل الي انبياءهم عليهم السلام لو مشيتم الي باقدامكم حتي تحفي ركبكم وتبلغ ايديكم عنان السماء وتكل السنتكم عن الدعاء فاني لا اجيب لكم داعيا ولا ارحم لكم باكيا حتي تردوا المظالم الي اهلها ففعلوا فمطروا من يومهم
 وقال مالك بن دينار اصاب الناس في بني اسراءيل قحط فخرجوا مرارا فاوحي الله عز وجل الي نبيهم ان اخبرهم انكم تخرجون الي بابدان نجسة وترفعون الي اكفا قد سفكتم بها الدماء وملاتم بطونكم من الحرام الان قد اشتد غضبي عليكم ولن تزدادوا مني الا بعدا وقال ابو الصديق الناجي خرج سليمان عليه السلام يستسقي فمر بنملة ملقاة علي ظهرها رافعة قواءمها  الي السماء وهي تقول اللهم انا خلق من خلقك ولا غني بنا عن رزقك فلا تهلكنا بذنوب غيرنا فقال سليمان عليه السلام ارجعوا فقد سقيتم بدعوة غيركم
 وقال الاوزاعي خرج الناس يستسقون فقام فيهم بلال بن سعد فحمد الله واثني عليه ثم قال يا معشر من حضر الستم مقرين بالاساءة فقالوا اللهم نعم فقال اللهم انا قد سمعناك تقول ما علي المحسنين من سبيل وقد اقررنا بالاساءة فهل تكون مغفرتك الا لمثلنا اللهم فاغفر لنا وارحمنا واسقنا فرفع يديه ورفعوا ايديهم فسقوا
 وقيل لمالك بن دينار ادع لنا ربك فقال انكم تستبطءون المطر وانا استبطء الحجارة وروي ان عيسي صلوات الله عليه وسلامه خرج يستسقي فلما ضجروا قال لهم عيسي عليه السلام من اصاب منكم ذنبا فليرجع فرجعوا كلهم ولم يبق معه في المفازة الا واحد فقال له عيسي عليهم السلام اما لك من ذنب فقال والله ما علمت من شء غير اني كنت ذات يوم اصلي فمرت بي امراة فنظرت اليها بعيني هذه فلما جاوزتني ادخلت اصبعي في عيني فانتزعتها وتبعت المراة بها فقال له عيسي عليه السلام فادع الله حتي اءمن علي دعاءك قال فدعا فتجللت السماء سحابا ثم صبت فسقوا وقال يحيي الغساني اصاب الناس قحط علي عهد داود عليه السلام فاختاروا ثلاثة من علماءهم فخرجوا حتي يستسقوا بهم فقال احدهم اللهم انك انزلت في توراتك ان نعفو عمن ظلمنا اللهم انا قد ظلمنا انفسنا فاعف عنا وقال الثاني اللهم انك انزلت في توراتك ان نعتق ارقاءنا اللهم انا ارقاءك فاعتقنا وقال الثالث اللهم انك انزلت في توراتك ان لا نرد المساكين اذا وقفوا بابوابنا اللهم انا مساكينك وقفنا ببابك فلا ترد دعاءنا فسقوا وقال عطاء السلمي منعنا الغيث فخرجنا نستسقي فاذا نحن بسعدون المجنون في المقابر فنظر الي فقال يا عطاء اهذا يوم النشور اوبعثر ما في القبور فقلت لا ولكنا منعنا الغيث فخرجنا نستسقي فقال يا عطاء بقلوب ارضية ام بقلوب سماوية فقلت بل بقلوب سماوية فقال هيهات يا عطاء قل للمتبهرجين لا تتبهرجوا فان الناقد بصير ثم رمق السماء بطرفه وقال الهي وسيدي ومولاي لا تهلك بلادك بذنوب عبادك ولكن بالسر المكنون من اسماءك وما وارت الحجب من الاءك الا ما سقيتنا ماء غدقا فراتا تحيي به العباد وتروي به البلاد يا من هو علي كل شء قدير قال عطاء فما استتم الكلام حتي ارعدت السماء وابرقت وجادت بمطر كافواه القرب فولي وهو يقول
 افلح الزاهدون والعابدونا  اذ لمولاهم اجاعوا البطونا
 اسهروا الاعين العليلة حبا  فانقضي ليلهم وهم ساهرونا
 شغلتهم عبادة الله حتي  حسب الناس ان فيهم جنونا
 وقال ابن المبارك قدمت المدينة في عام شديد القحط فخرج الناس يستسقون فخرجت معهم اذ اقبل غلام اسود عليه قطعتا خيش قد اتزر باحداهما والقي الاخري علي عاتقه فجلس الي جنبي فسمعته يقول الهي اخلقت الوجوه عندك كثرة الذنوب ومساوي الاعمال وقد حبست عنا غيث السماء لتءدب عبادك بذلك فاسالك يا حليما ذا اناة يا من لا يعرف عباده منه الا الجميل ان تسقيهم الساعة الساعة فلم يزل يقول الساعة الساعة حتي اكتست السماء بالغمام واقبل المطر من كل جانب قال ابن المبارك فجءت الي الفضيل فقال ما لي اراك كءيبا فقلت امر سبقنا اليه غيرنا فتولاه دوننا وقصصت عليه القصة فصاح الفضيل وخر مغشيا عليه
 ويروي ان عمر بن الخطاب رضي الله عنه استسقي بالعباس رضي الله عنه فلما فرغ عمر من دعاءه قال العباس اللهم انه لم ينزل بلاء من السماء الا بذنب ولم يكشف الا بتوبة وقد توجه بي القوم اليك لمكاني من نبيك صلي الله عليه وسلم وهذه ايدينا اليك بالذنوب ونواصينا بالتوبة وانت  الراعي لا تهمل الضالة ولا تدع الكبير بدار مضيعة فقد ضرع الصغير ورق الكبير وارتفعت الاصوات بالشكوي وانت تعلم السر واخفي اللهم فاغثهم بغياثك قبل ان يقنطوا فيهلكوا فانه لا يياس من روح الله الا القوم الكافرون قال فما تم كلامه حتي ارتفعت السماء مثل الجبال فضيلة الصلاة علي رسول الله صلي الله عليه وسلم وفضله صلي الله عليه وسلم
 قال الله تعالي @QB@ ان الله وملاءكته يصلون علي النبي يا ايها الذين امنوا صلوا عليه وسلموا تسليما @QE@ وروي انه صلي الله عليه وسلم جاء ذات يوم والبشري تري في وجهه فقال صلي الله عليه وسلم انه جاءني جبريل عليه السلام فقال اما ترضي يا محمد ان لا يصلي عليك احد من امتك صلاة واحدة الا صليت عليه عشرا ولا يسلم عليك احد من امتك الا سلمت عليه عشرا + حديث انه صلي الله عليه وسلم جاء ذات يوم والبشري تري في وجهه فقال انه جاءني جبريل عليه الصلاة والسلام فقال اما ترضي يا محمد ان لا يصلي عليك احد من امتك الا صليت عليه عشرا ولا يسلم عليك احد من امتك الا سلمت عليه عشرا اخرجه النساءي وابن حبان من حديث ابي طلحة باسناد جيد + وقال صلي الله عليه وسلم من صلي علي صلت عليه الملاءكة ما صلي علي فليقلل عند ذلك او ليكثر + حديث من صلي علي صلت عليه الملاءكة ما صلي فليقلل عبد من ذلك او ليكثر اخرجه ابن ماجه من حديث عامر بن ربيعة باسناد ضعيف والطبراني في الاوسط باسناد حسن + وقال صلي الله عليه وسلم ان اولي الناس بي اكثرهم علي صلاة + حديث ان اولي الناس بي اكثرهم علي صلاة اخرجه الترمذي من حديث ابن مسعود وقال حسن غريب وابن حبان + وقال صلي الله عليه وسلم بحسب المءمن من البخل ان اذكر عنده فلا يصلي علي + حديث بحسب امرء من البخل ان اذكر عنده فلا يصلي علي اخرجه قاسم بن اصبغ من حديث الحسن بن علي هكذا والنساءي وابن حبان من حديث اخيه الحسين البخيل من ذكرت عنده فلم يصل علي ورواه الترمذي من رواية الحسين بن علي عن ابيه وقال حسن صحيح + وقال صلي الله عليه وسلم اكثروا من الصلاة علي يوم الجمعة + حديث اكثروا علي من الصلاة يوم الجمعة اخرجه ابو داود والنساءي وابن ماجه وابن حبان والحاكم وقال صحيح علي شرط البخاري من حديث اوس بن اوس وذكره ابن ابي حاتم في العلل وحكي عن ابيه انه حديث منكر + وقال صلي الله عليه وسلم من صلي علي من امتي كتبت له عشر حسنات ومحيت عنه عشر سيءات + حديث من صلي علي من امتي كتبت له عشر حسنات ومحيت عنه عشر سيءات اخرجه النساءي في اليوم والليلة من حديث عمرو بن دينار وزاد فيه مخلصا من قلبه صلي الله عليه بها عشر صلوات ورفعه بها عشر درجات وله في السير ولابن حبان من حديث انس نحوه دون قوله مخلصا من قلبه ودون ذكر محو السيءات ولم يذكر ابن حبان ايضا رفع الدرجات + وقال صلي الله عليه وسلم من قال حين يسمع الاذان والاقامة اللهم رب هذه الدعوة التامة والصلاة القاءمة صل علي محمد عبدك ورسولك واعطه الوسيلة والفضيلة والدرجة الرفيعة والشفاعة يوم القيامة حلت له شفاعتي + حديث من قال حين يسمع الاذان والاقامة اللهم رب هذه الدعوة التامة والصلاة القاءمة صل علي محمد عبدك ورسولك واعطه الوسيلة والفضيلة والشفاعة يوم القيامة حلت له شفاعتي اخرجه البخاري من حديث جابر دون ذكر الاقامة والشفاعة والصلاة علي النبي صلي الله عليه وسلم وقال النداء وللمستغفري في الدعوات حين يسمع الدعاء للصلاة وزاد ابن وهب ذكر الصلاة والشفاعة فيه بسند ضعيف وزاد الحسن بن علي المعمري في اليوم والليلة من حديث ابي الدرداء ذكر الصلاة فيه وله وللمستغفري في الدعوات سند ضعيف من حديث ابي رافع كان رسول الله صلي الله عليه وسلم اذا سمع الاذان فذكر حديثا فيه واذا قال قد قامت الصلاة قال اللهم رب هذه الدعوة التامة الحديث وزاد وتقبل شفاعته في امته ولمسلم من حديث عبد الله بن عمرو اذا سمعتم المءذن فقولوا مثل ما يقول ثم صلوا علي ثم سلوا الله لي الوسيلة وفيه فمن سال الوسيلة حلت عليه الشفاعة + وقال رسول الله صلي الله عليه وسلم من صلي علي في كتاب لم تزل الملاءكة يستغفرون له ما دام اسمي في ذلك الكتاب + حديث من صلي علي في كتاب لم تزل الملاءكة تستغفر له ما دام اسمي في ذلك الكتاب اخرجه الطبراني في الاوسط وابو الشيج في الثواب والمستغفري في الدعوات من حديث ابي هريرة بسند ضعيف + وقال صلي الله عليه وسلم ان في الارض ملاءكة سياحين يبلغوني عن امتي السلام + حديث ان في الارض ملاءكة سياحين يبلغوني عن امتي السلام تقدم في اخر الحج + وقال صلي الله عليه وسلم  ليس احد يسلم علي الا رد الله علي روحي حتي ارد عليه السلام + حديث ليس احد يسلم علي الا رد الله علي روحي حتي ارد عليه السلام اخرجه ابو داود من حديث ابي هريرة بسند جيد + و قيل له يا رسول الله كيف نصلي عليك فقال قولوا اللهم صل علي محمد عبدك وعلي اله وازواجه وذريته كما صليت علي ابراهيم وال ابراهيم وبارك علي محمد وازواجه وذريته كما باركت علي ابراهيم وال ابراهيم انك حميد مجيد + حديث قيل له يا رسول الله كيف نصلي عليك قال قولوا اللهم صل علي محمد وعلي اله وازواجه وذريته الحديث متفق عليه من حديث ابي حميد الساعدي + وروي ان عمر بن الخطاب رضي الله عنه سمع بعد موت رسول الله صلي الله عليه وسلم يبكي ويقول بابي انت وامي يا رسول الله لقد كان جذع تخطب الناس عليه فلما كثر الناس اتخذت منبرا لتسمعهم فحن الجذع لفراقك حتي جعلت يدك عليه فسكن فامتك كانت اولي بالحنين اليك لما فارقتهم بابي انت وامي يا رسول الله لقد بلغ من فضيلتك عنده ان جعل طاعتك طاعته فقال عز وجل من يطع الرسول فقد اطاع الله بابي انت وامي يا رسول الله لقد بلغ من فضيلتك عنده ان اخبرك بالعفو عنك قبل ان يخبرك بالذنب فقال تعالي عفا الله عنك لم اذنت لهم بابي انت وامي يا رسول الله لقد بلغ من فضيلتك عنده ان بعثك اخر الانبياء وذكرك في اولهم فقال عز وجل واذ اخذنا من النبيين ميثاقهم ومنك ومن نوح وابراهيم الاية بابي انت وامي يا رسول الله لقد بلغ من فضيلتك عنده ان اهل النار يودون ان يكونوا قد اطاعوك وهم بين اطباقها يعذبون يقولون يا ليتنا اطعنا الله واطعنا الرسولا بابي انت وامي يا رسول الله لءن كان موسي بن عمران اعطاه الله حجرا تنفجر منه الانهار فماذا باعجب من اصابعك حين نبع منها الماء صلي الله عليك بابي انت وامي يا رسول الله لءن كان سليمان بن داود اعطاه الله الريح غدوها شهر ورواحها شهر فماذا باعجب من البراق حين سريت عليه الي السماء السابعة ثم صليت الصبح من ليلتك بالابطح صلي الله عليك بابي انت وامي يا رسول الله لءن كان عيسي بن مريم اعطاه الله احياء الموتي فماذا باعجب من الشاة المسمومة حين كلمتك وهي مشوية فقالت لك الذراع لا تاكلني فاني مسمومة بابي انت وامي يا رسول الله لقد دعا نوح علي قومه فقال رب لا تذر علي الارض من الكافرين ديارا ولو دعوت علينا بمثلها لهلكنا فلقد وطء ظهرك وادمي وجهك وكسرت رباعيتك فابيت ان تقول الا خيرا فقلت اللهم اغفر لقومي فانهم لا يعلمون بابي انت وامي يا رسول الله لقد اتبعك في قلة سنك وقصر عمرك ما لم يتبع نوحا في كثرة سنه وطول عمره ولقد امن بك الكثير وما امن معه الا القليل بابي انت وامي يا رسول الله لو لم تجالس الا كفءا لك ما جالستنا ولو لم تنكح الا كفءا لك ما نكحت الينا ولو لم تءاكل الا كفءا لك ما واكلتنا فلقد والله جالستنا ونكحت الينا وواكلتنا ولبست الصوف وركبت الحمار واردفت خلفك ووضعت طعامك علي الارض ولعقت اصابعك تواضعا منك صلي الله عليه وسلم + حديث عمر في حنين الجذع ونبع الماء من بين اصابعه والاسراء به علي البراق الي السماء السابعة ثم صلاة الصبح من ليلته بالابطح وكلام الشاة المسمومة وانه دمي وجهه وكسرت رباعيته فقال اللهم اغفر لقومي فانهم لا يعلمون وانه لبس الصوف وركب الحمار واردف خلفه ووضع طعامه بالارض ولعق اصابعه وهو غريب بطوله من حديث عمر وهو معروف من اوجه اخري فحديث حنين الجذع متفق عليه من حديث جابر وابن عمر وحديث نبع الماء من بين اصابعه متفق عليه من حديث انس وغيره وحديث الاسراء متفق عليه من حديث انس دون ذكر صلاة الصبح بالابطح وحديث كلام الشاة المسمومة رواه ابو داود من حديث جابر وفيه انقطاع وحديث انه دمي وجهه وكسرت رباعيته متفق عليه من حديث سهل بن سعد في غزوة احد وحديث اللهم اغفر لقومي فانهم لا يعلمون رواه البيهقي في دلاءل النبوة والحديث في الصحيح من حديث ابن مسعود انه صلي الله عليه وسلم حكاه عن نبي من الانبياء ضربه قومه وحديث لبس الصوف رواه الطيالسي من حديث سهل بن سعد وحديث ركوبه الحمار واردافه خلفه متفق عليه من حديث اسامة بن زيد وحديث وضع طعامه بالارض رواه احمد في الزهد من حديث الحسن مرسلا وللبخاري من حديث انس ما اكل رسول الله صلي الله عليه وسلم علي خوان قط وحديث لعقه اصابعه رواه مسلم من حديث كعب بن مالك وانس بن مالك + وقال بعضهم كنت اكتب  الحديث واصلي علي النبي صلي الله عليه وسلم فيه ولا اسلم فرايت النبي صلي الله عليه وسلم في المنام فقال لي اما تتم الصلاة علي في كتابك فما كتبت بعد ذلك الا صليت وسلمت عليه
 وروي عن ابي الحسن قال رايت النبي صلي الله عليه وسلم في المنام فقلت يا رسول الله بم جوزي الشافعي عنك حيث يقول في كتابه الرسالة وصلي الله علي محمد كلما ذكره الذاكرون وغفل عن ذكره الغافلون فقال صلي الله عليه وسلم جوزي عني انه لا يوقف للحساب فضيلة الاستغفار
 قال عز وجل والذين اذا فعلوا فاحشة او ظلموا انفسهم ذكروا الله فاستغفروا لذنوبهم وقال علقمة والاسود قال عبد الله بن مسعود رضي الله عنهم في كتاب الله عز وجل ايتان ما اذنب عبد ذنبا فقراهما واستغفر الله عز وجل الا غفر الله تعالي له والذين اذا فعلوا فاحشة او ظلموا انفسهم الاية وقوله عز وجل ومن يعمل سوءا او يظلم به ثم يستغفر الله يجد الله غفورا رحيما وقال عز وجل فسبح بحمد ربك واستغفره انه كان توابا وقال تعالي والمستغفرين بالاسحار وكان صلي الله عليه وسلم يكثر ان يقول سبحانك اللهم وبحمدك اللهم اغفر لي انك انت التواب الرحيم + حديث كان النبي صلي الله عليه وسلم يكثر ان يقول سبحانك اللهم وبحمدك اللهم اغفر لي انك انت التواب الرحيم اخرجه الحاكم من حديث ابن مسعود وقال صحيح ان كان ابو عبيدة سمع من ابيه والحديث متفق عليه من حديث عاءشة انه كان يكثر ان يقول ذلك في ركوعه وسجوده دون قوله انك انت التواب الرحيم + وقال صلي الله عليه وسلم من اكثر من الاستغفار جعل الله عز وجل له من كل هم فرجا ومن كل ضيق مخرجا وارزقه من حيث لا يحتسب + حديث من اكثر من الاستغفار جعل الله له من كل هم فرجا ومن كل غم مخرجا ورزقه من حيث لا يحتسب اخرجه ابو داود والنساءي في اليوم والليلة وابن ماجه والحاكم وقال صحيح الاسناد من حديث ابن عباس وضعفه ابن حبان + وقال صلي الله عليه وسلم اني لاستغفر الله تعالي واتوب اليه في اليوم سبعين مرة + حديث اني لاستغفر الله واتوب اليه في اليوم سبعين مرة اخرجه البخاري من حديث ابي هريرة الا انه قال اكثر من سبعين وهو في الدعاء للطبراني كما ذكره المصنف + هذا مع انه صلي الله عليه وسلم غفر له ما تقدم من ذنبه وما تاخر وقال صلي الله عليه وسلم انه ليغان علي قلبي حتي اني لاستغفر الله تعالي في كل يوم ماءة مرة + حديث انه ليغان علي قلبي حتي اني لاستغفر الله في كل يوم ماءة مرة اخرجه مسلم من حديث الاغر + وقال صلي الله عليه وسلم من قال حين ياوي الي فراشه استغفر الله العظيم الذي لا اله الا هو الحي القيوم واتوب اليه ثلاث مرات غفر الله له ذنوبه وان كانت مثل زبد البحر او عدد رمل عالج او عدد ورق الشجر او عدد ايام الدنيا + حديث من قال حين ياوي الي فراشه استغفر الله العظيم الذي لا اله الا هو الحي القيوم واتوب اليه ثلاث مرات غفر الله له ذنوبه وان كانت مثل زبد البحر الحديث اخرجه الترمذي من حديث ابي سعيد وقال غريب لا نعرفه الا من حديث عبد الله بن الوليد الوصافي قلت الوصافي وان كان ضعيفا فقد تابعه عليه عصام بن قدامة وهو ثقة ورواه البخاري في التاريخ دون قوله حين ياوي الي فراشه وقوله ثلاث مرات + وقال صلي الله عليه وسلم في حديث اخر من قال ذلك غفرت ذنوبه وان كان فارا من الزحف + حديث من قال ذلك غفرت ذنوبه وان كان فارا من الزحف اخرجه ابو داود والترمذي من حديث زيد مولي النبي صلي الله عليه وسلم وقال غريب قلت ورجاله موثقون ورواه ابن مسعود والحاكم من حديث ابن مسعود وقال صحيح علي شرط الشيخين + وقال حذيفة كنت ذرب اللسان علي اهلي فقلت يا رسول الله لقد خشيت ان يدخلني لساني النار فقال النبي صلي الله عليه وسلم فاين انت من الاستغفار فاني لاستغفر الله في اليوم ماءة مرة + حديث حذيفة كنت ذرب اللسان علي اهلي الحديث وفيه اين انت من الاستغفار اخرجه النساءي في اليوم والليلة وابن ماجه والحاكم وقال صحيح علي شرط الشيخين + وقالت عاءشة رضي الله عنها قال لي رسول الله صلي الله عليه وسلم ان كنت الممت بذنب فاستغفري الله وتوبي اليه فان التوبة من الذنب الندم والاستغفار + حديث عاءشة ان كنت الممت بذنب فاستغفري الله فان التوبة من الذنب الندم والاستغفار متفق عليه دون قوله فان التوبة الخ وزاد او توبي اليه فان العبد اذا اعترف بذنبه ثم تاب تاب الله عليه وللطبراني في الدعاء فان العبد اذا اذنب ثم استغفر الله غفر له + وكان صلي الله عليه وسلم  يقول في الاستغفار اللهم اغفر لي خطيءتي وجهلي واسرافي في امري وما انت اعلم به مني اللهم اغفر لي هزلي وجدي وخطءي وعمدي وكل ذلك عندي اللهم اغفر لي ما قدمت وما اخرت وما اسررت وما اعلنت وما انت اعلم به مني انت المقدم وانت المءخر وانت علي كل شء قدير + حديث كان يقول اللهم اغفر لي خطيءتي وجهلي واسرافي في امري وما انت اعلم به مني اللهم اغفر لي جدي وهزلي متفق عليه من حديث ابي موسي واللفظ لمسلم + وقال علي رضي الله عنه كنت رجلا اذا سمعت من رسول الله صلي الله عليه وسلم حديثا نفعني الله عز وجل بما شاء ان ينفعني منه واذا حدثني احد من اصحابه استحلفته فاذا حلف صدقته قال وحدثني ابو بكر وصدق ابو بكر رضي الله عنه قال سمعت رسول الله صلي الله عليه وسلم يقول ما من عبد يذنب ذنبا فيحسن الطهور ثم يقوم فيصلي ركعتين ثم يستغفر الله عز وجل الا غفر له ثم تلا قوله عز وجل والذين اذا فعلوا فاحشة او ظلموا انفسهم + حديث علي عن ابي بكر ما من عبد يذنب ذنبا فيحسن الطهور ثم يقوم فيصلي ركعتين ثم يستغفر الله الا غفر الله له اخرجه اصحاب السنن وحسنه الترمذي + الاية وروي ابو هريرة عن النبي صلي الله عليه وسلم انه قال ان المءمن اذا اذنب ذنبا كانت نكتة سوداء في قلبه فان تاب ونزع واستغفر صقل قلبه منها فان زاد زادت حتي تغلف قلبه + حديث ابي هريرة ان المءمن اذا اذنب ذنبا كانت نكتة سوداء في قلبه فان تاب ونزع واستغفر صقل قلبه الحديث اخرجه الترمذي وصححه والنساءي في اليوم والليلة وابن ماجه وابن حبان والحاكم + فذلك الران الذي ذكره الله عز وجل في كتابه @QB@ كلا بل ران علي قلوبهم ما كانوا يكسبون @QE@ وروي ابو هريرة رضي الله عنه انه صلي الله عليه وسلم قال ان الله سبحانه ليرفع الدرجة للعبد في الجنة فيقول يا رب اني لي هذه فيقول عز وجل باستغفار ولدك لك + حديث ابي هريرة ان الله ليرفع العبد الدرجة في الجنة فيقول يا رب اني لي هذه فيقول باستغفار ولدك لك رواه احمد باسناد حسن + وروت عاءشة رضي الله عنها انه صلي الله عليه وسلم قال اللهم اجعلني من الذين اذا احسنوا استبشروا واذا اساءوا استغفروا + حديث عاءشة اللهم اجعلني من الذين اذا احسنوا استبشروا واذا اساءوا استغفروا اخرجه ابن ماجه وفيه علي بن زيد بن جدعان مختلف فيه + وقال صلي الله عليه وسلم اذا اذنب العبد ذنبا فقال اللهم اغفر لي فيقول الله عز وجل اذنب عبدي ذنبا فعلم ان له ربا ياخذ بالذنب ويغفر الذنب عبدي اعمل ما شءت فقد غفرت لك + حديث اذا اذنب العبد فقال اللهم اغفر لي يقول الله اذنب عبدي ذنبا فعلم ان له ربا ياخذ بالذنب ويغفر الذنب الحديث متفق عليه من حديث ابي هريرة + وقال صلي الله عليه وسلم ما اصر من استغفر وان عاد في اليوم سبعين مرة + حديث ما اصر من استغفر وان عاد في اليوم سبعين مرة اخرجه ابو داود والترمذي من حديث ابي بكر وقال غريب وليس اسناده بالقوي + وقال صلي الله عليه وسلم ان رجلا لم يعمل خيرا قط نظر الي السماء فقال ان لي ربا يا رب فاغفر لي فقال الله عز وجل قد غفرت لك + حديث ان رجلا لم يعمل خيرا قط نظر الي السماء فقال ان لي ربا يا رب اغفر لي فقال الله تعالي قد غفرت لك لم اقف له علي اصل + وقال صلي الله عليه وسلم من اذنب ذنبا فعلم ان الله قد اطلع عليه غفر له وان لم يستغفر + حديث من اذنب فعلم ان الله قد اطلع عليه غفر له وان لم يستغفر اخرجه الطبراني في الاوسط من حديث ابن مسعود بسند ضعيف + وقال صلي الله عليه وسلم يقول الله تعالي يا عبادي كلكم مذنب الا من عافيته فاستغفروني اغفر لكم ومن علم اني ذو قدرة علي ان اغفر له غفرت له ولا ابالي + حديث يقول الله يا عبادي كلكم مذنب الا من عافيته فاستغفروني اغفر لكم ومن علم اني ذو قدرة علي ان اغفر له غفرت له ولا ابالي اخرجه الترمذي وابن ماجه من حديث ابي ذر وقال الترمذي حسن واصله عند مسلم بلفظ اخر + وقال صلي الله عليه وسلم من قال سبحانك ظلمت نفسي وعملت سوءا فاغفر لي فانه لا يغفر الذنوب الا انت غفرت له ذنوبه ولو كانت كمدب النمل + حديث من قال سبحانك ظلمت نفسي وعملت سوءا فاغفر لي انه لا يغفر الذنوب الا انت غفرت ذنوبه وان كانت كمدب النمل اخرجه البيهقي في الدعوات من حديث علي ان رسول الله صلي الله عليه وسلم قال الا اعلمك كلمات تقولهن لو كان عليك كعدد النمل او كعدد الذر ذنوبا غفرها الله لك فذكره بزيادة لا اله الا انت في اوله وفيه ابن لهيعة + وروي  ان افضل الاستغفار اللهم انت ربي وانا عبدك خلقتني وانا علي عهدك ووعدك ما استطعت اعوذ بك من شر ما صنعت ابوء لك بنعمتك علي وابوء علي نفسي بذنبي فقد ظلمت نفسي واعترفت بذنبي فاغفر لي ذنوبي ما قدمت منها وما اخرت فانه لا يغفر الذنوب جميعا الا انت + حديث افضل الاستغفار اللهم انت ربي وانا عبدك وانا علي عهدك ووعدك ما استطعت الحديث اخرجه البخاري من حديث شداد بن اوس دون قوله وقد ظلمت نفسي واعترفت بذنبي ودون قوله ذنوبي ما قدمت منها وما اخرت ودون قوله جميعا + والاثار قال خالد بن معدان يقول الله عز وجل ان احب عبادي الي المتحابون بحبي والمتعلقة قلوبهم بالمساجد والمستغفرون بالاسحار اولءك الذين اذا اردت اهل الارض بعقوبة ذكرتهم فتركتهم وصرفت العقوبة عنهم
 وقال قتادة رحمه الله القران يدلكم عن داءكم ودواءكم اما داءكم فالذنوب واما دواءكم فالاستغفار وقال علي كرم الله وجهه العجب ممن يهلك ومعه النجاة قيل وما هي قال الاستغفار وكان يقول ما الهم الله سبحانه عبدا الاستغفار وهو يريد ان يعذبه
 وقال الفضيل قول العبد استغفر الله تفسيرها اقلني وقال بعض العلماء العبد بين ذنب ونعمة لا يصلحهما الا الحمد والاستغفار وقال الربيع بن خيثم رحمه الله لا يقولن احدكم استغفر الله واتوب اليه فيكون ذنبا وكذبا ان لم يفعل ولكن ليقل اللهم اغفر لي وتب علي
 قال الفضيل رحمه الله الاستغفار بلا اقلاع توبة الكذابين وقالت رابعة العدوية رحمها الله استغفارنا يحتاج الي استغفار كثير
 قال بعض الحكماء من قدم الاستغفار علي الندم كان مستهزءا بالله عز وجل وهو لا يعلم وسمع اعرابي وهو متعلق باستار الكعبة يقول اللهم ان استغفاري مع اصراري للءم وان تركي استغفارك مع علمي بسعة عفوك لعجز فكم تتحبب الي بالنعم مع غناك عني وكم اتبغض اليك بالمعاصي مع فقري اليك يا من اذا وعد وفي واذا اوعد عفا ادخل عظيم جرمي في عظيم عفوك يا ارحم الراحمين وقال ابو عبد الله الوراق لو كان عليك مثل عدد القطر وزبد البحر ذنوبا لمحيت عنك اذا دعوت ربك بهذا الدعاء مخلصا ان شاء الله تعالي اللهم اني استغفرك من كل ذنب تبت اليك منه ثم عدت فيه واستغفرك من كل ما وعدتك به من نفسي ولم اوف لك به واستغفرك من كل عمل ارد به وجهك فخالطه غيرك واستغفرك من كل نعمة انعمت بها علي فاستعنت بها علي معصيتك واستغفرك يا عالم الغيب والشهادة من كل ذنب اتيته في ضياء النهار وسواد الليل في ملا او خلاء وسر وعلانية يا حليم ويقال انه استغفار ادم عليه السلام وقيل الخضر عليه الصلاة والسلام
  الباب الثالث في ادعية ماثورة ومعزية الي اسبابها واربابها مما يستحب
 ان يدعو بها المرء صباحا ومساء وبعقب كل صلاة
 فمنها دعاء رسول الله صلي الله عليه وسلم بعد ركعتي الفجر قال ابن عباس رضي الله عنهما بعثني العباس الي رسول الله صلي الله عليه وسلم فاتيته ممسيا وهو في بيت خالتي ميمونة فقام يصلي من الليل فلما صلي ركعتي الفجر قبل صلاة الصبح قال اللهم اني اسالك رحمة من عندك تهدي بها قلبي وتجمع بها شملي وتلم بها شعثي وترد بها الفتن عني وتصلح بها ديني وتحفظ بها غاءبي وترفع بها شاهدي وتزكي بها عملي وتبيض بها وجهي وتلهمني بها رشدي وتعصمني بها من كل سوء
 اللهم اعطني ايمانا صادقا ويقينا ليس بعده كفر ورحمة انال بها شرف كرامتك في الدنيا والاخرة
 اللهم اني اسالك الفوز عند القضاء ومنازل الشهداء وعيش السعداء والنصر علي الاعداء ومرافقة الانبياء
 اللهم اني  انزل بك حاجتي وان ضعف رايي وقلت حيلتي وقصر عملي وافتقرت الي رحمتك فاسالك يا كافي الامور ويا شافي الصدور كما تجير بين البحور ان تجيرني من عذاب السعير ومن دعوة الثبور ومن فتنة القبور
 اللهم ما قصر عنه رايي وضعف عنه عملي ولم تبلغه نيتي وامنيتي من خير وعدته احدا من عبادك او خير انت معطيه احدا من خلقك فاني ارغب اليك فيه واسالكه يا رب العالمين
 اللهم اجعلنا هادين مهتدين غير ضالين ولا مضلين حربا لاعداءك وسلما لاولياءك نحبب بحبك من اطاعك من خلقك ونعادي بعداوتك من خالفك من خلقك
 اللهم هذا الدعاء وعليك الاجابة وهذا الجهد وعليك التكلان وانا لله وانا اليه راجعون ولا حول ولا قوة الا بالله العلي العظيم ذي الحبل الشديد والامر الرشيد اسالك الامن يوم الوعيد والجنة يوم الخلود مع المقربين الشهود والركع السجود الموفين بالعهود انك رحيم ودود وانت تفعل ما تريد
 سبحان الذي لبس العز وقال به سبحان الذي تعطف بالمجد وتكرم به سبحان الذي لا ينبغي التسبيح الا له سبحان ذي الفضل والنعم سبحان ذي العزة والكرم سبحان الذي احصي كل شء بعلمه
 اللهم اجعل لي نورا في قلبي ونورا في قبري ونورا في سمعي ونورا في بصري ونورا في شعري ونورا في بشري ونورا في لحمي ونورا في دمي ونورا في عظامي ونورا من بين يدي ونورا من خلفي ونورا عن يميني ونورا عن شمالي ونورا من فوقي ونورا من تحتي اللهم زدني نورا واعطني نورا واجعل لي نورا + حديث ابن عباس اللهم اني اسالك رحمة من عندك تهدي بها قلبي وتجمع بها شملي وتلم بها شعثي الحديث اخرجه الترمذي وقال غريب ولم يذكر في اوله بعث العباس لابنه عبد الله ولا نومه في بيت ميمونة وهو بهذه الزيادة في الدعاء للطبراني + دعاء عاءشة رضي الله عنها
 قال رسول الله صلي الله عليه وسلم لعاءشة رضي الله عنها عليك بالجوامع الكوامل قولي اللهم اني اسالك من الخير كله عاجله واجله ما علمت منه وما لم اعلم واعوذ بك من الشر كله عاجله واجله ما علمت وما لم اعلم واسالك الجنة وما قرب اليها من قول وعمل واعوذ بك من النار وما قرب اليها من قول وعمل واسالك من الخير ما سالك عبدك ورسولك محمد صلي الله عليه وسلم واستعيذك مما استعاذك منه عبدك ورسولك محمد صلي الله عليه وسلم واسالك ما قضيت لي من امر ان تجعل عاقبته رشدا برحمتك يا ارحم الراحمين + حديث قوله لعاءشة عليك بالجوامع الكوامل قولي اللهم اني اسالك من الخير كله عاجله واجله ما علمت منه وما لم اعلم الحديث اخرجه ابن ماجه والحاكم وصححه من حديثها + دعاء فاطمة رضي الله عنها
  قال رسول الله صلي الله عليه وسلم يا فاطمة ما يمنعك ان تسمعي ما اوصيك به ان تقولي يا
 حي يا قيوم برحمتك استغيث لا تكلني الي نفسي طرفة عين واصلح لي شاني كله + حديث يا فاطمة ما يمنعك ان تسمعي ما اوصيك به ان تقولي يا حي يا قيوم برحمتك استغيث لا تكلني الي نفسي طرفة عين واصلح لي شاني كله اخرجه النساءي في اليوم والليلة والحاكم من حديث انس وقال صحيح علي شرط الشيخين + دعاء ابي بكر الصديق رضي الله عنه
 علم رسول الله صلي الله عليه وسلم ابا بكر الصديق رضي الله عنه ان يقول اللهم اني اسالك بمحمد نبيك وابراهيم خليلك وموسي نجيك وعيسي كلمتك وروحك وبتوراة موسي وانجيل عيسي وزبور داود وفرقان محمد صلي الله عليه وسلم  وعليهم اجمعين وبكل وحي اوحيته او قضاء قضيته او ساءل اعطيته او غني افقرته او فقير اغنيته او ضال هديته واسالك باسمك الذي انزلته علي موسي صلي الله عليه وسلم واسالك باسمك الذي بثثت به ارزاق العباد واسالك باسمك الذي وضعته علي الارض فاستقرت واسالك باسمك الذي وضعته علي السموات فاستقلت واسالك باسمك الذي وضعته علي الجبال فرست واسالك باسمك الذي استقل به عرشك واسالك باسمك الطهر الطاهر الاحد الصمد الوتر المنزل في كتابك من لدنك من النور المبين واسالك باسمك الذي وضعته علي النهار فاستنار وعلي الليل فاظلم وبعظمتك وكبرياءك وبنور وجهك الكريم ان ترزقني القران والعلم به وتخلطه بلحمي ودمي وسمعي وبصري وتستعمل به جسدي بحولك وقوتك فانه لا حول ولا قوة الا بك يا ارحم الراحمين + حديث علم رسول الله صلي الله عليه وسلم ابا بكر الصديق رضي الله عنه ان يقول اللهم اني اسالك بمحمد نبيك وابراهيم خليلك وموسي نجيك وعيسي كلمتك الحديث في الدعاء لحفظ القران رواه ابو الشيخ ابن حبان في كتاب الثواب من رواية عبد الملك بن هارون بن عبثرة عن ابيه ان ابا بكر اتي النبي صلي الله عليه وسلم فقال اني اتعلم القران وينفلت مني فذكره وعبد الملك وابوه ضعيفان وهو منقطع بين هارون وابي بكر + دعاء بريدة الاسلمي رضي الله عنه
 وروي انه قال له رسول الله صلي الله عليه وسلم يا بريدة الا اعلمك كلمات من اراد بهن خيرا علمهن اياه ثم لم ينسهن اياه ابدا قال فقلت بلي يا رسول الله قال قل اللهم اني ضعيف فقو في رضاك ضعفي وخذ الي الخير بناصيتي واجعل الاسلام منتهي رضاي اللهم اني ضعيف فقوني واني ذليل فاعزني واني فقير فاغنني يا ارحم الراحمين + حديث يا بريدة الا اعلمك كلمات من اراد الله به خيرا علمهن اياه الحديث اخرجه الحاكم من حديث بريدة وقال صحيح الاسناد + دعاء قبيصة بن المخارق
 اذ قال لرسول الله صلي الله عليه وسلم علمني كلمات ينفعني الله عز وجل بها فقد كبر سني وعجزت عن اشياء كثيرة كنت اعملها فقال صلي الله عليه وسلم اما لدنياك فاذا صليت الغداة فقل ثلاث مرات سبحان الله وبحمده سبحان الله العظيم لا حول ولا قوة الا بالله العلي العظيم فانك اذا قلتهن امنت من الغم والجذام والبرص والفالج واما لاخرتك فقل اللهم اهدني من عندك وافض علي من فضلك وانشر علي من رحمتك وانزل علي من بركاتك ثم قال صلي الله عليه وسلم اما انه اذا وافي بهن عبد يوم القيامة لم يدعهن فتح له اربعة ابواب من الجنة يدخل من ايها شاء + حديث ان قبيصة بن المخارق قال لرسول الله صلي الله عليه وسلم علمني كلمات ينفعني الله بها فقد كبرت سني وعجزت الحديث اخرجه ابن السني في اليوم والليلة من حديث ابن عباس وهو عند احمد في المسند مختصرا من حديث قبيصة نفسه وفيه رجل لم يسم + دعاء ابي الدرداء رضي الله عنه
 قيل لابي الدرداء رضي الله عنه قد احترقت دارك وكانت النار قد وقعت في محلته فقال ما كان الله ليفعل ذلك فقيل له ذلك ثلاثا وهو يقول ما كان الله ليفعل ذلك ثم اتاه ات فقال يا ابا الدرداء ان النار حين دنت من دارك طفءت قال قد علمت ذلك فقيل له ما ندري اي قوليك اعجب قال اني سمعت رسول الله صلي الله عليه وسلم قال من يقول هءلاء الكلمات في ليل او نهار لم يضره شء وقد قلتهن وهي اللهم انت ربي لا اله الا انت عليك توكلت وانت رب العرش العظيم لا حول ولا قوة الا بالله العلي العظيم ما شاء الله كان وما لم يشا لم يكن اعلم ان الله علي كل شء قدير وان الله قد احاط بكل شء علما واحصي كل شء عددا اللهم اني اعوذ بك من شر نفسي  ومن شر كل دابة انت اخذ بناصيتها ان ربي علي صراط مستقيم + حديث قيل لابي الدرداء احرقت دارك فقال ما كان الله ليفعل ذلك الحديث اخرجه الطبراني في الدعاء من حديث ابي الدرداء ضعيف + دعاء الخليل ابراهيم عليه الصلاة والسلام
 كان يقول اذا اصبح اللهم ان هذا خلق جديد فافتحه علي بطاعتك واختمه لي بمغفرتك ورضوانك وارزقني فيه حسنة تقبلها مني وزكها وضعفها لي وما عملت فيه من سيءة فاغفرها لي انك غفور رحيم ودود كريم قال ومن دعا بهذا الدعاء اذا اصبح فقد ادي شكر يومه دعاء عيسي عليه الصلاة والسلام
 كان يقول اللهم اني اصبحت لا استطيع دفع ما اكره ولا املك نفع ما ارجو واصبح الامر بيد غيري واصبحت مرتهنا بعملي فلا فقير افقر مني اللهم لا تشمت بي عدوي ولا تسء بي صديقي ولا تجعل مصيبتي في ديني ولا تجعل الدنيا اكبر همي ولا تسلط علي من لا يرحمني يا حي يا قيوم دعاء الخضر عليه السلام
 يقال ان الخضر والياس عليهما السلام اذا التقيا في كل موسم لم يفترقا الا عن هذه الكلمات بسم الله ما شاء الله لا قوة الا بالله ما شاء الله كل نعمة من الله ما شاء الله الخير كله بيد الله ما شاء الله لا يصرف السوء الا الله فمن قالها ثلاث مرات اذا اصبح امن من الحرق والغرق والسرق ان شاء الله تعالي دعاء معروف الكرخي رضي الله عنه
 قال محمد بن حسان قال لي معروف الكرخي رحمه الله الا اعلمك عشر كلمات خمس للدنيا وخمس للاخرة من دعا الله عز وجل بهن وجد الله تعالي عندهن قلت اكتبها لي قال لا ولكن ارددها عليك كما رددها علي بكر بن خنيس رحمه الله حسبي الله لديني حسبي الله لدنياي حسبي الله الكريم لما اهمني حسبي الله الحليم القوي لمن بغي علي حسبي الله الشديد لمن كادني بسوء حسبي الله الرحيم عند الموت حسبي الله الرءوف عند المسالة في القبر حسبي الله الكريم عند الحساب حسبي الله اللطيف عند الميزان حسبي الله القدير عند الصراط حسبي الله لا اله الا هو عليه توكلت وهو رب العرش العظيم وقد روي عن ابي الدرداء انه قال من قال في كل يوم سبع مرات فان تولوا فقل حسبي الله لا اله الا هو عليه توكلت وهو رب العرش العظيم كفاه الله عز وجل ما اهمه من امر اخرته صادقا كان او كاذبا دعاء عتبة الغلام
 وقد رءي في المنام بعد موته فقال دخلت الجنة بهذه الكلمات اللهم يا هادي المضلين ويا راحم المذنبين ويا مقيل عثرات العاثرين ارحم عبدك ذا الخطر العظيم والمسلمين كلهم اجمعين واجعلنا مع الاخيار المرزوقين الذين انعمت عليهم من النبيين والصديقين والشهداء والصالحين امين يا رب العالمين دعاء ادم عليه الصلاة والسلام
 قالت عاءشة رضي الله عنها لما اراد الله عز وجل ان يتوب علي ادم صلي الله عليه وسلم طاف بالبيت سبعا  وهو يومءذ ليس بمبني ربوة حمراء ثم قام فصلي ركعتين ثم قال اللهم انك تعلم سري وعلانيتي فاقبل معذرتي وتعلم حاجتي فاعطني سءلي وتعلم ما في نفسي فاغفر لي ذنوبي اللهم اني اسالك ايمانا يباشر قلبي ويقينا صادقا حتي اعلم انه لن يصيبني الا ما كتبته علي والرضا بما قسمته لي يا ذا الجلال والاكرام فاوحي الله عز وجل اليه اني قد غفرت لك ولم ياتني احد من ذريتك فيدعوني بمثل الذي دعوتني به الا غفرت له وكشفت غمومه وهمومه ونزعت الفقر من بين عينيه واتجرت له من وراء كل تاجر وجاءته الدنيا وهي راغمة وان كان لا يريدها دعاء علي بن ابي طالب رضي الله عنه
 رواه عن النبي صلي الله عليه وسلم انه قال ان الله تعالي يمجد نفسه كل يوم ويقول اني انا الله رب العالمين اني انا الله لا اله الا انا الحي القيوم اني انا الله لا اله الا انا العلي العظيم اني انا الله لا اله الا انا لم الد ولم اولد اني انا الله لا اله الا انا العفو الغفور اني انا الله لا اله الا انا مبدء كل شء والي يعود العزيز الحكيم الرحمن الرحيم مالك يوم الدين خالق الخير والشر خالق الجنة والنار الواحد الاحد الفرد الصمد الذي لم يتخذ صاحبة ولا ولدا الفرد الوتر عالم الغيب والشهادة الملك القدوس السلام المءمن المهيمن العزيز الجبار المتكبر الخالق البارء المصور الكبير المتعال المقتدر القهار الحليم الكريم اهل الثناء والمجد اعلم السر واخفي القادر الرزاق فوق الخلق والخليقة + حديث علي ان الله تعالي يمجد نفسه كل يوم فيقول اني انا الله رب العالمين اني انا الله لا اله الا انا الحي القيوم الحديث بطوله لم اجد له اصلا + وذكر قبل كل كلمة اني انا الله لا اله الا انا كما اوردناه في الاول فمن دعا بهذه الاسماء فليقل انك انت الله لا اله الا انت كذا وكذا فمن دعا بهن كتب من الساجدين المخبتين الذين يجاورون محمدا وابراهيم وموسي وعيسي والنبيين صلوات الله عليهم في دار الجلال وله ثواب العابدين في السموات والارضين وصلي الله علي محمد وعلي كل عبد مصطفي دعاء ابن المعتمر وهو سليمان التيمي وتسبيحاته رضي الله عنه
 روي ان يونس بن عبيد راي رجلا في المنام ممن قتل شهيدا ببلاد الروم فقال ما افضل ما رايت ثم من الاعمال قال رايت تسبيحات ابن المعتمر من الله عز وجل بمكان وهي هذه سبحان الله والحمد لله ولا اله الا الله والله اكبر ولا حول ولا قوة الا بالله العلي العظيم عد ما خلق وعدد ما هو خالق وزنة ما خلق وزنة ما هو خالق وملء ما خلق وملء ما هو خالق وملء سمواته وملء ارضه ومثل ذلك واضعاف ذلك وعدد خلقه وزنة عرشه ومنتهي رحمته ومداد كلماته ومبلغ رضاه حتي يرضي واذا رضي وعدد ما ذكره به خلقه في جميع ما مضي وعدد ما هم ذاكروه فيما بقي في كل سنة وشهر وجمعة ويوم وليلة وساعة من الساعات وشم ونفس من الانفاس وابد من الاباد من ابد الي ابد ابد الدنيا وابد الاخرة واكثر من ذلك لا ينقطع اوله ولاينفد اخره دعاء ابراهيم بن ادهم رضي الله عنه
