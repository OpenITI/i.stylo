 واذا كان مثل الصديق رضي الله عنه في كماله يحذر من الدنيا ووجودها فكيف يشك في ان فقد المال اصلح من وجوده هذا مع ان احسن احوال الغني ان ياخذ حلالا وينفق طيبا ومع ذلك فيطول حسابه في عرصات القيامة ويطول انتظاره ومن نوقش الحساب فقد عذب ولهذا تاخر عبد الرحمن بن عوف عن الجنة اذ كان مشغولا بالحساب كما راه رسول الله صلي الله عليه وسلم ولهذا قال ابو الدرداء رضي الله عنه ما احب ان لي حانوتا علي باب المسجد ولا تخطءني فيه صلاة وذكر واربح كل يوم خمسين دينارا واتصدق بها في سبيل الله تعالي قيل وما تكره قال سوء الحساب ولذلك قال سفيان رحمه الله اختار الفقراء ثلاثة اشياء واختار الاغنياء ثلاثة اشياء اختار الفقراء راحة النفس وفراغ القلب وخفة الحساب واختار الاغنياء تعب النفس وشغل القلب وشدة الحساب وما ذكره ابن عطاء من ان الغني وصف الحق فهو بذلك افضل فهو صحيح ولكن اذا كان العبد غنيا عن وجود المال وعدمه جميعا بان يستوي عنده كلاهما فاما اذا كان غنيا بوجوده ومفتقرا الي بقاءه فلا يضاهي غناه غني الله تعالي لان الله تعالي غني بذاته لا بما يتصور زواله والمال يتصور زواله بان يسرق وما ذكر من الرد عليه بان الله ليس غنيا بالاعراض والاسباب صحيح في ذم غني يريد بقاء المال وما ذكر من ان صفات الحق لا تليق بالعبد غير صحيح بل العلم من صفاته وهو افضل شء للعبد بل منتهي العبد ان يتخلق باخلاق الله تعالي وقد سمعت بعض المشايخ يقول ان سالك الطريق الي الله تعالي قبل ان يقطع الطريق تصير الاسماء التسعة والتسعون اوصافا له اي يكون له من كل واحد نصيب واما التكبر فلا يليق بالعبد فان التكبر علي من لا يستحق التكبر عليه ليس من صفات الله تعالي واما التكبر علي من يستحقه كتكبر المءمن علي الكافر وتكبر العالم علي الجاهل والمطيع علي العاصي فيليق به نعم قد يراد بالتكبر الزهو والصلف والايذاء وليس ذلك من وصف الله تعالي وانما وصف الله تعالي انه اكبر من كل شء وانه يعلم انه كذلك والعبد مامور بانه بانه يطلب اعلي المراتب ان قدر عليه ولكن بالاستحقاق كما هو حقه لا بالباطل والتلبيس فعلي العبد ان يعلم ان المءمن اكبر من الكافر والمطيع اكبر من العاصي والعالم اكبر من الجاهل والانسان اكبر من البهيمة والجماد والنبات واقرب الي الله تعالي منها فلو راي نفسه بهذه الصفة رءية محققة لا شك فيها لكانت صفة التكبر حاصلة له ولاءقة به وفضيلة في حقه الا انه لا سبيل له الي معرفته فان ذلك موقوف علي الخاتمة وليس يدري الخاتمة كيف تكون وكيف تتفق فلجهله بذلك وجب ان لا يعتقد لنفسه رتبة فوق رتبة الكافر اذ ربما يختم للكافر بالايمان وقد يختم له بالكفر فلم يكن ذلك لاءقا به لقصور علمه عن معرفة العاقبة ولما تصور ان يعلم الشء علي ما هو به كان العلم كمالا في حقه لانه  في صفات الله تعالي ولما كانت معرفة بعض الاشياء قد تضره صار ذلك العلم نقصانا في حقه اذ ليس من اوصاف الله تعالي علم يضره فمعرفة الامور التي لا ضرر فيها هي التي تتصور في العبد من صفات الله تعالي فلا جرم هو منتهي الفضيلة وبه فضل الانبياء والاولياء والعلماء فاذن لو استوي عنده وجود المال وعدمه فهذا نوع من الغني يضاهي بوجه من الوجوه الغني الذي يوصف به الله سبحانه وتعالي فهو فضيلة اما الغني بوجود المال فلا فضيلة فيه اصلا فهذا بيان نسبة حال الفقير القانع الي حال الغني الشاكر
