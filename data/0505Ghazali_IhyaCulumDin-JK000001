فا من اصناف الجوهر الحديث اخرجه ابو نعيم من رواية الحسن عن جابر + يعني اليهود والنصاري والمجوس
 وسءل رسول الله صلي الله عليه وسلم عن قوله @QB@ ومساكن طيبة في جنات عدن @QE@ قال قصور من لءلء في كل قصر سبعون دارا من ياقوت احمر في كل دارسبعون بيتا من زمرد اخضر في كل بيت سرير علي كل سرير سبعون فراشا من كل لون علي كل فراش زوجة من الحور العين في كل بيت سبعون ماءدة علي كل ماءدة سبعون لونا من الطعام في كل بيت سبعون وصيفة ويعطي المءمن في كل غداة يعني من القوة ما ياتي علي ذلك اجمع + حديث سءل عن قوله تعالي @QB@ ومساكن طيبة في جنات عدن @QE@ قال قصور من لءلء الحديث اخرجه ابو الشيخ ابن حبان في كتاب العظمة والاجري في كتاب النصيحة من رواية الحسن بن خليفة عن الحسن قال سالت ابا هريرة وعمران بن حصين في هذه الاية ولا يصح والحسن ابن خليفة لم يعرفه ابن ابي حاتم والحسن البصري لم يسمع من ابي هريرة علي قول الجمهور +  صفة حاءط الجنة واراضيها واشجارها وانهارها
 تامل في صورة الجنة وتفكر في غبطة سكانها وفي حسرة من حرمها لقناعته بالدنيا عوضا عنها فقد قال ابو هريرة قال رسول الله صلي الله عليه وسلم ان حاءط الجنة لبنة من فضة ولبنة من ذهب ترابها زعفران وطينها مسك + حديث ابي هريرة ان حاءط الجنة لبنة من فضة ولبنة من ذهب ترابها زعفران وطينها مسك اخرجه الترمذي بلفظ وملاطها المسك وقال ليس اسناده بذلك القوي وليس عندي بمتصل ورواه البزار من حديث ابي سعيد باسناد فيه مقال ورواه موقوفا عليه باسناد صحيح + وسءل صلي الله عليه وسلم عن تربه الجنة فقال درمكة بيضاء مسك خالص + حديث سءل عن تربة الجنة فقال درمكة بيضاء مسك خالص اخرجه مسلم من حديث ابي سعيد ان ابن صياد سال النبي صلي الله عليه وسلم عن ذلك فذكره + وقال ابو هريرة قال رسول الله صلي الله عليه وسلم من سره ان يسقيه الله عز وجل الخمر في الاخرة فليتركها في الدنيا ومن سره ان يكسوه الله الحرير في الاخرة فليتركه في الدنيا + حديث ابي هريرة من سره ان يسقيه الله الخمر في الاخرة فليتركها في الدنيا ومن سره ان يكسوه الله الحرير في الاخرة فليتركه في الدنيا اخرجه الطبراني في الاوسط باسناد حسن وللنساءي باسناد صحيح من لبس الحرير في الدنيا لم يلبسه في الاخرة ومن شرب الخمر في الدنيا لم يشربها في الاخرة + وقال انهار الجنة تتفجر من تحت تلال او تحت جبال المسك + حديث انهار الجنة تتفجر من تحت تلال او تحت جبال المسك اخرجه العقيلي في الضعفاء من حديث ابي هريرة + ولو كان ادني اهل الجنة حلية عدلت بحلية اهل الدنيا جميعها لكان ما يحليه الله عز وجل به في الاخرة افضل من حلية الدنيا جميعها + حديث لو كان ادني اهل الجنة حلية عدلت بحلية اهل الدنيا جميعها لكان ما يحليه الله به في الاخرة افضل من حليه اهل الدنيا جميعها اخرجه الطبراني في الاوسط من حديث ابي هريرة باسناد حسن + وقال ابو هريرة قال رسول الله صلي الله عليه وسلم ان في الجنة شجرة يسير الراكب في ظلها ماءة عام لا يقطعها اقرءوا ان شءتم @QB@ وظل ممدود @QE@ + حديث ان في الجنة شجرة يسير الراكب في ظلها ماءة عام لا يقطعها الحديث متفق عليه من حديث ابي هريرة + وقال ابو امامة كان اصحاب رسول الله صلي الله عليه وسلم يقولون ان الله عز وجل ينفعنا بالاعراب ومساءلهم اقبل اعرابي فقال يا رسول الله قد ذكر الله في القران شجرة مءذية وما كنت ادري ان في الجنة شجرة تءذي صاحبها فقال رسول الله صلي الله عليه وسلم @QB@ ما هي @QE@ قال السدر فان لها شوكا فقال قد قال الله تعالي في سدر مخضود يخضد الله شوكه فيجعل مكان كل شوكة ثمرة ثم تنفتق الثمرة منها عن اثنين وسبعين لونا من الطعام ما منها لون يشبه الاخر + حديث ابي امامة اقبل اعرابي فقال يا رسول الله قد ذكر الله في القران شجرة مءذية قال ما هي قال السدر الحديث اخرجه ابن المبارك في الزهد عن صفوان بن عمرو عن سليم بن عامر مرسلا من غير ذكر لابي امامة + وقال جرير بن عبد الله نزلنا الصفاح فاذا رجل ناءم تحت شجرة قد كادت الشمس ان تبلغه فقلت للغلام انطلق بهذا النطع فاظله فانطلق فاظله فلما استيقظ فاذا هو سلمان فاتيته اسلم عليه فقال يا جرير تواضع لله فان من تواضع لله في الدنيا رفعه الله يوم القيامة هل تدري ما الظلمات يوم القيامة قلت لا ادري قال ظلم الناس بعضهم بعضا ثم اخذ عويدا لا اكاد اراه من صغره فقال يا جرير لو طلبت مثل هذا في الجنة لم تجده قلت يا ابا عبد الله فاين النخل والشجر قال اصولها اللءلء والذهب واعلاها الثمر صفة لباس اهل الجنة وفرشهم وسررهم واراءكهم وخيامهم
 قال الله يحلون فيها من اساور من ذهب ولءلءا ولباسهم فيها حرير والايات في ذلك كثيرة وانما تفصيله في الاخبار فقد روي ابو هريرة ان النبي صلي الله عليه وسلم قال من يدخل الجنة ينعم لا يباس لا تبلي  ثيابه ولا يفني شبابه في الجنة ما لا عين رات ولا اذن سمعت ولا خطر عن قلب بشر + حديث ابي هريرة من يدخل الجنة ينعم ولا يباس لا تبلي ثيابه الحديث رواه مسلم دون قوله في الجنة مالا عين رات الخ فاتفق عليه الشيخان من حديث اخر لابي هريرة قال الله تعالي اعددت لعبادي الصالحين ما لا عين رات الحديث + وقال رجل يا رسول الله اخبرنا عن ثياب اهل الجنة اخلق تخلق ام نسج تنسج فسكت رسول الله صلي الله عليه وسلم وضحك بعض القوم فقال رسول الله صلي الله عليه وسلم مم تضحكون من جاهل سال عالما ثم قال رسول الله صلي الله عليه وسلم بل ينشق عنها ثمر الجنة مرتين + حديث قال رجل يا رسول الله اخبرنا عن ثياب اهل الجنة اتخلق خلقا ام تنسج نسجا الحديث اخرجه النساءي من حديث عبد الله بن عمرو + وقال ابو هريرة قال رسول الله صلي الله عليه وسلم ان اول زمرة تلج الجنة صورتهم علي صورة القمر ليلة البدر لا يبصقون فيها ولا يمتخطون ولا يتغوطون انيتهم وامشاطهم من الذهب والفضة ورشحهم المسك لكل واحد منهم زوجتان يري مخ ساقها من وراء اللحم من الحسن لا اختلاف بينهم ولا تباغض قلوبهم علي قلب واحد يسبحون الله بكرة وعشية وفي رواية علي كل زوجة سبعون حلة + حديث ابي هريرة اول زمرة تدخل الجنة صورتهم علي صورة القمر ليلة البدر الحديث متفق عليه + وقال صلي الله عليه وسلم في قوله تعالي يحلون فيها من اساور من ذهب قال ان عليهم التيجان ان ادني لءلءة فيها تضء ما بين المشرق والمغرب + حديث في قوله تعالي يحلون فيها من اساور من ذهب قال ان عليهم التيجان ادني لءلءة فيها تضء ما بين المشرق والمغرب اخرجه الترمذي من حديث ابي سعيد دون ذكر الاية وقال لا نعرفه الا من حديث رشد بن سعد + وقال صلي الله عليه وسلم الخيمة درة مجوفة طولها في السماء ستون ميلا في كل زاوية منها للمءمن اهل لا يراهم الاخرون + حديث الخيمة درة مجوفة طولها في السماء ستون ميلا الحديث عزاه المصنف للبخاري وهو متفق عليه من حديث ابي موسي الاشعري + رواه البخاري في الصحيح قال ابن عباس الخيمة درة مجوفة فرسخ في فرسخ لها اربعة الاف مصراع من ذهب وقال ابو سعيد الخدري قال رسول الله صلي الله عليه وسلم في قوله تعالي @QB@ وفرش مرفوعة @QE@ قال ما بين الفراشين كما بين السماء والارض + حديث ابي سعيد في قوله تعالي @QB@ وفرش مرفوعة @QE@ قال ما بين الفراشين كما بين السماء والارض اخرجه الترمذي بلفظ ارتفاعها لكما بين السماء والارض وقال غريب لا نعرفه الا من حديث رشد بن سعد + صفة طعام اهل الجنة
 بيان طعام اهل الجنة مذكور في القران من الفواكه والطيور السمان والمن والسلوي والعسل واللبن واصناف كثيرة لا تحصي قال الله تعالي كلما رزقوا فيها من ثمرة رزقا قالوا هذا الذي رزقنا من قبل واتوا به متشابها وذكر الله تعالي شراب اهل الجنة في مواضع كثيرة وقد قال ثوبان مولي رسول الله صلي الله عليه وسلم كنت قاءما عند رسول الله صلي الله عليه وسلم فجاءه حبر من احبار اليهود فذكر اسءلة الي ان قال فمن اول اجازه يعني علي الصراط فقال فقراء المهاجرين قال اليهودي فما تحفتهم حين يدخلون الجنة قال زيادة كبد الحوت قال فما غداءهم علي اثرها قال ينحر لهم ثور الجنة الذي كان ياكل في اطرافها قال فما شرابهم عليه قال من عين فيها تسمي سلسبيلا فقال صدقت + حديث ثوبان جاء حبر من احبار اليهود فذكر سءاله الي ان قال فمن اول الناس اجازة يعني علي الصراط فقال فقراء المهاجرين قال اليهودي فما تحفتهم حين يدخلون الجنة قال زيادة كبد النون الحديث رواه مسلم بزيادة في اوله واخره + وقال زيد بن ارقم جاء رجل من اليهود الي رسول الله صلي الله عليه وسلم وقال يا اباالقاسم الست تزعم ان اهل الجنة ياكلون فيها ويشربون وقال لاصحابه ان اقرلي بها خصمته فقال رسول الله صلي الله عليه وسلم بلي والذي نفسي بيده ان احدهم ليعطي قوة ماءة رجل في المطعم  والمشرب والجماع فقال اليهودي فان الذي ياكل ويشرب يكون له الحاجة فقال رسول الله صلي الله عليه وسلم حاجتهم عرق يفيض من جلودهم مثل المسك فاذا البطن قد ضمر + حديث زيد بن ارقم جاء رجل من اليهود فقال يا ابا القاسم الست تزعم ان اهل الجنة ياكلون فيها ويشربون الحديث وفيه حاجتهم عرق يفيض من جلودهم مثل المسك اخرجه النساءي في الكبري باسناد صحيح + وقال ابن مسعود قال رسول الله صلي الله عليه وسلم انك لتنظر الي الطير في الجنة فتشتهيه فيخر بين يديك مشويا + حديث ابن مسعود انك لتنظر الي الطير في الجنة فتشتهيه فيخر بين يديك مشويا اخرجه البزار باسناد صحيح + وقال حذيفة قال رسول الله صلي الله عليه وسلم ان في الجنة طيرا مثل البخاتي قال ابو بكر رضي الله عنه انها لناعمة يا رسول الله قال انعم منها من ياكلها وانت ممن ياكلها يا ابا بكر + حديث حذيفة ان في الجنة طيرا امثال البخاتي الحديث غريب من حديث حذيفة ولاحمد من حديث انس باسناد صحيح ان طير الجنة كامثال البخت ترعي في شجر الجنة قال ابو بكر يا رسول الله ان هذه الطير ناعمة قال اكلتها انعم منها قالها ثلاثا واني ارجو ان تكون ممن ياكل منها وهو عند الترمذي من وجه اخر ذكر فيه نهر الكوثر وقال فيه طير اعناقها كاعناق الجزر قال عمر ان هذه لناعمة الحديث وليس فيه ذكر لابي بكر وقال حسن + وقال عبد الله بن عمر في قوله تعالي يطاف عليهم بصحاف قال يطاف عليهم بسبعين صحفة من ذهب كل صحفة فيها لون ليس في الاخري مثله وقال عبد الله ابن مسعود رضي الله عنه ومزاجه من تسنيم قال يمزج لاصحاب اليمين ويشربه المقربون صرفا وقال لو ان رجلا من اهل الدنيا ادخل يده فيه ثم اخرجها لم يبق ذو روح الا وجد ريح طيبها صفة الحور العين والولدان
 قد تكرر في القران وصفهم ووردت الاخبار بزيادة شرح فيه
 روي انس رضي الله عنه ان رسول الله صلي الله عليه وسلم قال غدوة في سبيل الله او روحه خير من الدنيا وما فيها ولقاب قوس احدكم او موضع قدمه من الجنة خير من الدنيا وما فيها ولو ان امراة من نساء اهل الجنة اطلعت الي الارض لاضاءت ولملات ما بينهما راءحة ولنصيفها علي راسها خير من الدنيا بما فيها + حديث غدوة في سبيل الله او روحه خير من الدنيا وما فيها الحديث اخرجه البخاري من حديث انس + يعني الخمار وقال ابو سعيد الخدري قال رسول الله صلي الله عليه وسلم في قوله تعالي @QB@ كانهن الياقوت والمرجان @QE@ قال تنظر الي وجهها في خدرها اصفي من المراة وان ادني لءلءة عليها لتضء ما بين المشرق والمغرب وانه يكون عليها سبعون ثوبا ينفذها بصره حتي يري مخ ساقها من وراء ذلك + حديث ابي سعيد الخدري في قوله تعالي @QB@ كانهن الياقوت والمرجان @QE@ قال تنظر الي وجهها في خمرها اصفي من المراة الحديث اخرجه ابو يعلي من رواية ابي الهيثم عن ابي سعيد باسناد حسن ورواه احمد وفيه ابن لهيعة ورواه ابن المبارك في الزهد والرقاءق من رواية ابي الهيثم عن النبي صلي الله عليه وسلم مرسلا دون ذكر ابي سعيد وللترمذي من حديث ابن مسعود ان المراة من نساء اهل الجنة ليري بياض مخ ساقها من وراء سبعين حلة الحديث ورواه عنه موقوفا قال وهذا اصح وفي الصحيحين من حديث ابي هريرة لكل امرء منهم زوجتان اثنتان يري مخ سوقهما من وراء اللحم + وقال انس قال رسول الله صلي الله عليه وسلم لما اسري بي دخلت في الجنة موضعا يسمي البيدخ عليه خيام اللءلء والزبرجد الاخضر والياقوت الاحمر فقلن السلام عليك يا رسول الله فقلت يا جبريل ما هذا النداء قال هءلاء المقصورات في الخيام استاذن ربهن في السلام عليك فاذن لهن فطفقن يقلن نحن الراضيات فلا نسخط ابدا ونحن الخالدات فلا نظعن ابدا وقرا رسول الله صلي الله عليه وسلم قوله تعالي حور مقصورات في الخيام + حديث انس لما اسري بي دخلت في الجنة موضعا يسمي الصرح عليه خيام اللءلء والزبرجد الاخضر والياقوت الاحمر الحديث وفيه ان جبريل قال هءلاء المقصورات في الخيام وفيه فطفقن يقلن نحن الراضيات فلا نسخط لم اجده هكذا  بتمامه وللترمذي من حديث علي ان في الجنة لمجتمعا للحور العين يرفعن اصواتا لم تسمع الخلاءق مثلها يقلن نحن الخالدات فلا نبيد ونحن الناعمات فلا نباس ونحن الراضيات فلا نسخط طوبي لمن كان لنا وكنا له وقال غريب ولابي الشيخ في كتاب العظمة حديث ابن ابي اوفي بسند ضعيف فيجتمعن في كل سبعة ايام فيقلن باصوات الحديث
 وقال مجاهد في قوله تعالي @QB@ وازواج مطهرة @QE@ قال من الحيض والغاءط والبول والبصاق والنخامة والمني والولد
 وقال الاوزاعي @QB@ في شغل فاكهون @QE@ قال شغلهم افتضاض الابكار وقال رجل يا رسول الله ايباضع اهل الجنة قال يعطي الرجل منهم من القوة في اليوم الواحد افضل من سبعين منكم + حديث قال رجل يا رسول الله ايباضع اهل الجنة قال يعطي الرجل منهم من القوة في اليوم الواحد افضل من سبعين منكم اخرجه الترمذي وصححه وابن حبان من حديث انس يعطي المءمن في الجنة قوة كذا وكذا من الجماع فقيل او يطيق ذلك قال يعطي قوة ماءة + وقال عبد الله بن عمر ان ادني اهل الجنة منزلة من يسعي له الف خادم كل خادم علي عمل ليس عليه صاحبه وقال رسول الله صلي الله عليه وسلم ان الرجل من اهل الجنة ليتزوج خمسماءة حوراء واربعة الاف بكر وثمانية الاف ثيب يعانق كل واحدة منهن مقدار عمره في الدنيا + حديث ان الرجل من اهل الجنة ليتزوج خمسماءة حوراء واربعة الاف بكر وثمانية الالف ثيب يعانق كل واحدة منهن مقدار عمره في الدنيا اخرجه ابو الشيخ في طبقات المحدثين وفي كتاب العظمة من حديث ابن ابي اوفي الا انه قال ماءة حوراء ولم يذكر فيه عناقه لهن واسناده ضعيف وتقدم قبله بحديث + وقال النبي صلي الله عليه وسلم ان في الجنة سوقا ما فيها بيع ولا شراء الا الصور من الرجال والنساء فاذا اشتهي الرجل صورة دخل فيها وان فيها لمجتمع الحور العين يرفعن باصوات لم تسمع الخلاءق مثلها يقلن نحن الخالدات فلا نبيد ونحن الناعمات فلا نباس ونحن الراضيات فلا نسخط فطوبي لمن كان لنا وكنا له + حديث ان في الجنة سوقا ما فيها بيع ولا شراء الا الصور من الرجال والنساء الحديث اخرجه الترمذي فرقة في موضعين من حديث علي وقد تقدم بعضه قبل هذا بحديثين + وقال انس رضي الله عنه قال رسول الله صلي الله عليه وسلم ان الحور العين في الجنة يتغنين نحن الحور الحسان خبءنا لازواج كرام + حديث انس ان الحور في الجنة يتغنين فيقلن نحن الحور الحسان خبءنا لازواج كرام اخرجه الطبراني في الاوسط وفيه الحسن بن داود بن المنكدر قال البخاري يتكلمون فيه وقال ابن عدي ارجو انه لا باس به + وقال يحيي بن كثير في قوله تعالي @QB@ في روضة يحبرون @QE@ قال السماع في الجنة وقال ابو امامة الباهلي قال رسول الله صلي الله عليه وسلم ما من عبد يدخل الجنة الا ويجلس عند راسه وعند رجليه ثنتان من الحور العين يغنيانه باحسن صوت سمعه الانس والجن وليس بمزمار الشيطان ولكن بتحميد الله وتقديسه + حديث ابي امامة ما من عبد يدخل الجنة الا ويجلس عند راسه وعند رجليه ثنتان من الحور العين يغنيانه باحسن صوت سمعه الانس والجن وليس بمزمار الشيطان ولكن بتحميد الله وتقديسه اخرجه الطبراني باسناد حسن +
  بيان جمل مفرقة من اوصاف اهل الجنة وردت بها الاخبار
 روي اسامة بن زيد ان رسول الله صلي الله عليه وسلم قال لاصحابه الا هل من مشمر للجنة ان الجنة لا خطر  لها هي ورب الكعبة نور يتلالا وريحانة تهتز وقصر مشيد ونهر مطرد وفاكهة كثيرة نضيجة وزوجة وزوجة حسناء جميلة في حبرة ونعمة في مقام ابدا ونضرة في دار عالية بهية سليمة قالوا نحن المشمرون لها يا رسول الله قال قولوا ان شاء الله تعالي ثم ذكر الجهاد وحقه عليه + حديث اسامة بن زيد الا هل من مشمر للجنة ان الجنة لا خطر لها الحديث اخرجه ابن ماجه وابن حبان + وجاء رجل الي رسول الله صلي الله عليه وسلم وقال هل في الجنة خيل فانها تعجبني قال ان احببت ذلك اتيت بفرس من ياقوتة حمراء فتطير بك في الجنة حيث شءت وقال له رجل ان الابل تعجبني فهل في الجنة من ابل فقال يا عبد الله ان ادخلت الجنة فلك فيها ما اشتهت نفسك ولذت  عيناك + حديث جاء رجل الي النبي صلي الله عليه وسلم فقال له هل في الجنة خيل فانها تعجبني الحديث اخرجه الترمذي من حديث بريدة مع اختلاف لفظ وفيه المسعودي مختلف فيه ورواه ابن المبارك في الزهد بلفظ المصنف من رواية عبد الرحمن بن سابط مرسلا قال الترمذي وهذا اصح وقد ذكر ابو موسي المديني عبد الرحمن بن سابط في ذيله علي ابن منده في الصحابة ولا يصح له صحبة + وعن ابي سعيد الخدري قال قال رسول الله صلي الله عليه وسلم ان الرجل من اهل الجنة ليولد له الولد كما يشتهي يكون حمله وفصاله وشبابه في ساعة واحدة + حديث ابي سعيد ان الرجل من اهل الجنة ليولد له الولد كما يشتهي ويكون حمله وفصاله ونشاته في ساعة واحدة اخرجه ابن ماجة والترمذي وقال حسن غريب قال وقد اختلف اهل العلم في هذا فقال بعضهم في الجنة جماع ولا يكون ولد انتهي ولاحمد من حديث لابي رزين يلذ ويلم مثل لذاتكم في الدنيا ويتلذذن بكم غير ان لا توالد + وقال رسول الله صلي الله عليه وسلم اذا استقر اهل الجنة في الجنة اشتاق الاخوان الي الاخوان فيسير سرير هذا الي سرير هذا فيلتقيان ويتحدثان ما كان بينهما في دار الدنيا فيقول يا اخي تذكر يوم كذا في مجلس كذا فدعونا الله عز وجل فغفر لنا + حديث اذا استقر اهل الجنة اشتاق الاخوان الي الاخوان فيسير سرير هذا الي سرير هذا اخرجه البزار من رواية الربيع بن صبيح عن الحسن عن انس وقال لا نعلمه يروي عن النبي صلي الله عليه وسلم الا بهذا الاسناد تفرد به انس انتهي والربيع بن صبيح ضعيف جدا ورواه الاصفهاني في الترغيب والترهيب مرسلا دون ذكر انس + وقال رسول الله صلي الله عليه وسلم ان اهل الجنة جرد مرد جعاد مكحولون ابناء ثلاث وثلاثين علي خلق ادم طولهم ستون ذراعا في عرض سبعة اذرع + حديث اهل الجنة جرد مرد بيض جعاد مكحلون ابناء ثلاث وثلاثين الحديث اخرجه الترمذي من حديث معاذ وحسنه دون قوله بيض جعاد ودون قوله علي خلق ادم الي اخره ورواه ايضا من حديث ابي هريرة مختصرا اهل الجنة جرد مرد كحل وقال غريب وفي الصحيحين من حديث ابي هريرة علي صورة ابيهم ادم ستون ذراعا + وقال رسول الله صلي الله عليه وسلم ادني اهل الجنة الذي له ثمانون الف خادم وثنتان وسبعون زوجة وينصب له قبة من لءلء وزبرجد وياقوت كما بين الجابية الي صنعاء وان عليهم التيجان وان ادني لءلءة منها لتضء ما بين المشرق والمغرب + حديث ادني اهل الجنة منزلة الذي له ثمانون الف خادم الحديث اخرجه الترمذي من حديث ابي سعيد منقطعا من اوله الي قوله وان عليهم التيجان ومن هنا باسناده ايضا وقال لا نعرفه الا من حديث رشد بن سعد + وقال صلي الله عليه وسلم نظرت الي الجنة فاذا الرمانة من رمانها كجلد البعير المقتب واذا طيرها كالبخت واذا فيها جارية فقلت يا جارية لمن انت فقالت لزيد بن حارثة واذا في الجنة ما لا عين رات ولا اذن سمعت ولا خطر علي قلب بشر + حديث نظرت الي الجنة فاذا الرمانة من رمانها كجلد البعير المقتب واذا طيرها كالبخت الحديث رواه الثعلبي في تفسيره من رواية ابي هرون العبدي عن ابي سعيد وابو هرون اسمه عمارة بن حريث ضعيف جدا وفي الصحيحين من حديث ابي هريرة يقول الله اعددت لعبادي الصالحين ما لا عين رات ولا اذن سمعت ولا خطر علي قلب بشر + وقال كعب خلق الله تعالي ادم عليه السلام بيده وكتب التوراة بيده وغرس الجنة بيده ثم قال لها تكلمي فقالت قد افلح المءمنون فهذه صفات الجنة ذكرناها جملة ثم نقلناها تفصيلا
 وقد ذكر الحسن البصري رحمه الله جملتها فقال ان رمانها مثل الدلاء وان انهارها لمن ماء غير اسن وانهار من لبن لم يتغير طعمه وانهار من عسل مصفي لم يصفه الرجال وانها من خمر لذة للشاربين لا تسفه الاحلام ولا تصدع منها الرءوس وان فيها ما لا عين رات ولا اذن سمعت ولا خطر علي قلب بشر ملوك ناعمون ابناء ثلاث وثلاثون في سن واحد طولهم ستون ذراعا في السماء كحل جرد مرد قد امنوا العذاب واطمانت بهم الدار وان انهارها لتجري علي رضراض من ياقوت وزبرجد وان عروقها ونخلها وكرمها اللءلء وثمارها لا يعلم علمها الا الله تعالي وان ريحها ليوجد من مسيرة خمسماءة سنة وان لهم فيها خيلا وابلا هفافة رحالها وازمتها وسروجها من ياقوت يتزاورون فيها وازواجهم الحور العين كانهن بيض مكنون وان المراة لتاخذ بين اصبعيها سبعين حلة فتلبسها فيري  مخ ساقها من وراء تلك السبعين حلة قد طهر الله الاخلاق من السوء والاجساد من الموت لا يمتخطون فيها ولا يبولون ولا يتغوطون وانما هو حبشاء ورشح مسك لهم رزقهم فيها بكرة وعشيا اما انه ليس ليل يكر الغدو علي الرواح والرواح علي الغدو وان اخر من يدخل الجنة وادناهم منزلة ليمد له في بصره وملكه مسيرة ماءة عام في قصور من الذهب والفضة وخيام اللءلء ويفسح له في بصره حتي ينظر الي اقصاه كما ينظر الي ادناه يغدي عليهم بسبعين الف صحفة من ذهب ويراح عليهم بمثلها في كل صحفة لون ليس في الاخري مثله ويجد طعم اخره كما يجد طعم اوله وان في الجنة لياقوتة فيها سبعون الف دار في كل دار سبعون الف بيت ليس فيها صدع ولا ثقب
 وقال مجاهد ان ادني اهل الجنة منزلة لمن يسير في ملكه الف سنة يري اقصاه كما يري ادناه وارفعهم الذي ينظر الي ربه بالغداة والعشي وقال سعيد ابن المسيب ليس احد من اهل الجنة الا وفي يده ثلاثة اسورة سوار من ذهب وسوار من لءلء وسوار من فضة
 وقال ابو هريرة رضي الله عنه ان في الجنة حوراء يقال لها العيناء اذا مشت مشي عن يمينها ويسارها سبعون الف وصيفة وهي تقول اين الامرون بالمعروف والناهون عن المنكر وقال يحيي بن معاذ ترك الدنيا شديد وفوت الجنة اشد وترك الدنيا مهر الاخرة وقال ايضا في طلب الدنيا ذل النفوس وفي طلب الاخرة عز النفوس فيا عجبا لمن يختار المذلة في طلب ما يفني ويترك العز في طلب ما يبقي صفة الرءية والنظر الي وجه الله تبارك تعالي
 قال الله تعالي للذين احسنوا الحسني وزيادة وهذه الزيادة هي النظر الي وجه الله تعالي وهي اللذة الكبري التي ينسي فيها نعيم اهل الجنة وقد ذكرناه حقيقتها في كتاب المحبة وقد شهد لها الكتاب والسنة علي خلاف ما يعتقده اهل البدعة قال جرير بن عبد الله البجلي كنا جلوسا عند رسول الله صلي الله عليه وسلم فراي القمر ليلة البدر فقال انكم ترون ربكم كما ترون القمر لا تضامون في رءيته فان استطعتم ان لا تغلبوا علي صلاة قبل طلوع الشمس وقبل غروبها فافعلوا ثم قرا @QB@ وسبح بحمد ربك قبل طلوع الشمس وقبل غروبها @QE@ + حديث جرير كنا جلوسا عند رسول الله صلي الله عليه وسلم فراي القمر ليلة البدر فقال انكم ترون ربكم الحديث هو في الصحيحين كما ذكر المصنف + وهو مخرج في الصحيحين وروي مسلم في الصحيح عن صهيب قال قرا رسول الله صلي الله عليه وسلم قوله تعالي للذين احسنوا الحسني وزيادة @QB@ قال @QE@ اذا دخل اهل الجنة الجنة واهل النار النار نادي مناد يا اهل الجنة ان لكم عند الله موعدا يريد ان ينجزكموه قالوا ما هذا الموعد الم يثقل موازيننا ويبيض وجوهنا ويدخلنا الجنة ويجرنا من النار قال فيرفع الحجاب وينظرون الي وجه الله عز وجل فما اعطوا شيءا احب اليهم من النظر اليه + حديث صهيب في قوله تعالي للذين احسنوا الحسني وزيادة رواه مسلم كما ذكره المصنف + وقد روي حديث الرءيا جماعة من الصحابة وهذه هي غاية الحسني ونهاية النعمي وكل ما فصلناه من التنعم عند هذه النعمة ينسي وليس لسرور اهل الجنة عند سعادة اللقاء منتهي بل لا نسبة لشء من لذات الجنة الي لذة اللقاء وقد اوجزنا في الكلام هنا لما فصلناه في كتاب المحبة والشوق والرضا فلا ينبغي ان تكون همة العبد من الجنة بشء سوي لقاء المولي واما ساءر نعيم الجنة فانه يشارك فيه البهيمة المسرحة في المرعي  نختم الكتاب بباب في سعة رحمة الله تعالي علي سبيل التفاءل بذلك
 فقد كان رسول الله صلي الله عليه وسلم واله وسلم يحب الفال + حديث كان رسول الله صلي الله عليه وسلم يحب التفاءل متفق عليه من حديث انس في اثناء حديث ويعجبني الفال الصالح والكلمة الحسنة ولهما من حديث ابي هريرة وخيرهما الفال قال الكلمة الصالحة يسمعها احدكم + وليس لنا من الاعمال ما نرجو به المغفرة فنقتدي برسول الله صلي الله عليه وسلم في التفاءل ونرجو ان يختم عاقبتنا بالخير في الدنيا والاخرة كما ختمنا الكتاب بذكر رحمه الله تعالي
 فقد قال الله تعالي ان الله لا يغفر ان يشرك به ويغفر ما دون ذلك لمن يشاء وقال تعالي قل يا عبادي الذين اسرفوا علي انفسهم لا تقنطوا من رحمة الله ان الله يغفر الذنوب جميعا انه هو الغفور الرحيم وقال تعالي ومن يعمل سوءا او يظلم نفسه ثم يستغفر الله يجد الله غفورا رحيما
 ونحن نستغفر الله تعالي من كل ما زلت به القدم او طغي به القلم في كتابنا هذا وفي ساءر كتبنا ونستغفره من اقوالنا التي لا توافقها اعمالنا ونستغفره مما ادعيناه واظهرناه من العلم والبصيرة بدين الله تعالي مع التقصير فيه ونستغفره من كل علم وعمل قصدنا به وجهه الكريم ثم خالطه غيره ونستغفره من كل وعد وعدناه به من انفسنا ثم قصرنا في الوفاء به ونستغفره من كل نعمة انعم بها علينا فاستعملناها في معصيته ونستغفره من كل تصريح وتعريض بنقصان ناقص وتقصير مقصر كنا متصفين به ونستغفره من كل خطرة دعتنا الي تصنع وتكلف تزينا للناس في كتاب سطرناه او كلام نظمناه او علم افدناه او استفدناه ونرجو بعد الاستغفار من جميع ذلك كله لنا ولمن طالع كتابنا هذا او كتبه او سمعه ان نكرم بالمغفرة والرحمة والتجاوز عن جميع السيءات ظاهرا وباطنا فان الكرم عميم والرحمة واسعة والجود علي اصناف الخلاءق فاءض
