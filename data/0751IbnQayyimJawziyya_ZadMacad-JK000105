 قالوا وتحريمه لا يمنع ترتب اثره وحكمه عليه كالظهار فانه منكر من القول وزور وهو محرم بلا شك وترتب اثره عليه وهو تحريم الزوجة الي ان يكفر فهكذا الطلاق البدعي محرم ويترتب عليه اثره الي ان يراجع ولا فرق بينهما
 قالوا وهذا ابن عمر يقول للمطلق ثلاثا حرمت عليك حتي تنكح زوجا غيرك وعصيت ربك فيما امرك به من طلاق امراتك فاوقع عليه الطلاق الذي عصي به المطلق ربه عز وجل 
 قالوا وكذلك القذف محرم وترتب عليه اثره من الحد ورد الشهادة وغيرهما
 قالوا والفرق بين النكاح المحرم والطلاق المحرم ان النكاح عقد يتضمن حل الزوجة وملك بضعها فلا يكون الا علي الوجه الماذون فيه شرعا فان الابضاع في الاصل علي التحريم ولا يباح منها الا ما اباحه الشارع بخلاف الطلاق فانه اسقاط لحقه وازالة لملكه وذلك لا يتوقف علي كون السبب المزيل ماذونا فيه شرعا كما يزول ملكه عن العين بالاتلاف المحرم وبالاقرار الكاذب وبالتبرع المحرم كهبتها لمن يعلم انه يستعين بها علي المعاصي والاثام
 قالوا والايمان اصل العقود واجلها واشرفها يزول بالكلام المحرم اذا كان كفرا فكيف لا يزول عقد النكاح بالطلاق المحرم الذي وضع لازالته
 قالوا ولو لم يكن معنا في المسالة الا طلاق الهازل فانه يقع مع تحريمه لانه لا يحل له الهزل بايات الله وقد قال النبي صلي الله عليه وسلم ما بال اقوام يتخذون ايات الله هزوا طلقتك راجعتك طلقتك راجعتك فاذا وقع طلاق الهازل مع تحريمه فطلاق الجاد اولي ان يقع مع تحريمه
 قالوا وفرق اخر بين النكاح المحرم والطلاق المحرم ان النكاح نعمة فلا تستباح بالمحرمات وازالته وخروج البضع عن ملكه نقمة فيجوز ان يكون سببها محرما
 قالوا وايضا فان الفروج يحتاط لها والاحتياط يقتضي وقوع الطلاق وتجديد الرجعة والعقد
 قالوا وقد عهدنا النكاح لا يدخل فيه الا بالتشديد والتاكيد من الايجاب  والقبول والولي والشاهدين ورضي الزوجة المعتبر رضاها ويخرج منه بايسر شء فلا يحتاج الخروج منه الي شء من ذلك بل يدخل فيه بالعزيمة ويخرج منه بالشبهة فاين احدهما من الاخر حتي يقاس عليه
 قالوا ولو لم يكن بايدينا الا قول حملة الشرع كلهم قديما وحديثا طلق امراته وهي حاءض والطلاق نوعان طلاق سنة وطلاق بدعة وقول ابن عباس رضي الله عنه الطلاق علي اربعة اوجه وجهان حلال ووجهان حرام فهذا الاطلاق والتقسيم دليل علي انه عندهم طلاق حقيقة وشمول اسم الطلاق له كشموله للطلاق الحلال ولو كان لفظا مجردا لغوا لم يكن له حقيقة ولا قيل طلق امراته فان هذا اللفظ اذا كان لغوا كان وجوده كعدمه ومثل هذا لا يقال فيه طلق ولا يقسم الطلاق وهو غير واقع اليه والي الواقع فان الالفاظ اللاغية التي ليس لها معان ثابتة لا تكون هي ومعانيها قسما من الحقيقة الثابتة لفظا فهذا اقصي ما تمسك به الموقعون وربما ادعي بعضهم الاجماع لعدم علمه بالنزاع
 قال المانعون من الوقوع الكلام معكم في ثلاث مقامات بها يستبين الحق في المسالة
 المقام الاول بطلان ما زعمتم من الاجماع وانه لا سبيل لكم الي اثباته البتة بل العلم بانتفاءه معلوم
 المقام الثاني ان فتوي الجمهور بالقول لا يدل علي صحته وقول الجمهور ليس بحجة 
 المقام الثالث ان الطلاق المحرم لا يدخل تحت نصوص الطلاق المطلقة التي رتب الشارع عليها احكام الطلاق فان ثبتت لنا هذه المقامات الثلاث كنا اسعد بالصواب منكم في المسالة
 فنقول اما المقام الاول فقد تقدم من حكاية النزاع ما يعلم معه بطلان دعوي الاجماع كيف ولو لم يعلم ذلك لم يكن لكم سبيل الي اثبات الاجماع الذي تقوم به الحجة وتنقطع معه المعذرة وتحرم معه المخالفة فان الاجماع الذي يوجب ذلك هو الاجماع القطعي المعلوم
 واما المقام الثاني وهو ان الجمهور علي هذا القول فاوجدونا في الادلة الشرعية ان قول الجمهور حجة مضافة الي كتاب الله وسنة رسوله واجماع امته
 ومن تامل مذاهب العلماء قديما وحديثا من عهد الصحابة والي الان واستقرا احوالهم وجدهم مجمعين علي تسويغ خلاف الجمهور ووجد لكل منهم اقوالا عديدة انفرد بها عن الجمهور ولا يستثني من ذلك احد قط ولكن مستقل ومستكثر فمن شءتم سميتموه من الاءمة تتبعوا ما له من الاقوال التي خالف فيها الجمهور ولو تتبعنا ذلك وعددناه لطال الكتاب به جدا ونحن نحيلكم علي الكتب المتضمنة لمذاهب العلماء واختلافهم ومن له معرفة بمذاهبهم وطراءقهم ياخذ اجماعهم علي ذلك من اختلافهم ولكن هذا في المساءل التي يسوغ فيها الاجتهاد ولا تدفعها السنة الصحيحة الصريحة واما ما كان هذا سبيله فانهم كالمتفقين علي انكاره ورده وهذا هو المعلوم من مذاهبهم في الموضعين
 واما المقام الثالث وهو دعواكم دخول الطلاق المحرم تحت نصوص الطلاق وشمولها للنوعين الي اخر كلامكم فنسالكم ما تقولون فيمن  ادعي دخول انواع البيع المحرم والنكاح المحرم تحت نصوص البيع والنكاح وقال شمول الاسم للصحيح من ذلك والفاسد سواء بل وكذلك ساءر العقود المحرمة اذا ادعي دخولها تحت الفاظ العقود الشرعية وكذلك العبادات المحرمة المنهي عنها اذا ادعي دخولها تحت الالفاظ الشرعية وحكم لها بالصحة لشمول الاسم لها هل تكون دعواه صحيحة او باطلة فان قلتم صحيحة ولا سبيل لكم الي ذلك كان قولا معلوم الفساد بالضرورة من الدين وان قلتم دعواه باطلة تركتم قولكم ورجعتم الي ما قلناه وان قلتم تقبل في موضع وترد في موضع قيل لكم ففرقوا بفرقان صحيح مطرد منعكس معكم به برهان من الله بين ما يدخل من العقود المحرمة تحت الفاظ النصوص فيثبت له حكم الصحة وبين ما لا يدخل تحتها فيثبت له حكم البطلان وان عجزتم عن ذلك فاعلموا انه ليس بايديكم سوي الدعوي التي يحسن كل احد مقابلتها بمثلها او الاعتماد علي من يحتج لقوله لا بقوله واذا كشف الغطاء عما قررتموه في هذه الطريق وجد عين محل النزاع فقد جعلتموه مقدمة في الدليل وذلك عين المصادرة علي المطلوب فهل وقع النزاع الا في دخول الطلاق المحرم المنهي عنه تحت قوله @QB@ وللمطلقات متاع @QE@ وتحت قوله @QB@ والمطلقات يتربصن بانفسهن ثلاثة قروء @QE@ وامثال ذلك وهل سلم لكم منازعوكم قط ذلك حتي تجعلوه مقدمة لدليلكم
 قالوا واما استدلالكم بحديث ابن عمر فهو الي ان يكون حجة عليكم اقرب منه الي ان يكون حجة لكم من وجوه
 احدها صريح قوله فردها علي ولم يرها شيءا وقد تقدم بيان صحته قالوا فهذا الصريح الصحيح ليس بايديكم ما يقاومه في الموضعين بل جميع تلك الالفاظ اما صحيحة غير صريحة واما صريحة غير صحيحة كما ستقفون عليه 
 الثاني انه قد صح عن ابن عمر رضي الله عنه باسناد كالشمس من رواية عبيدالله عن نافع عنه في الرجل يطلق امراته وهي حاءض قال لا يعتد بذلك وقد تقدم
 الثالث انه لو كان صريحا في الاعتداد به لما عدل به الي مجرد الراي وقوله للساءل ارايت
 الرابع ان الالفاظ قد اضطربت عن ابن عمر في ذلك اضطرابا شديدا وكلها صحيحة عنه وهذا يدل علي انه لم يكن عنده نص صريح عن رسول الله صلي الله عليه وسلم في وقوع تلك الطلقة والاعتداد بها واذا تعارضت تلك الالفاظ نظرنا الي مذهب ابن عمر وفتواه فوجدناه صريحا في عدم الوقوع ووجدنا احد الفاظ حديثه صريحا في ذلك فقد اجتمع صريح روايته وفتواه علي عدم الاعتداد وخالف في ذلك الفاظ مجملة مضطربة كما تقدم بيانه
 واما قول ابن عمر رضي الله عنه ومالي لا اعتد بها وقوله ارايت ان عجز واستحمق فغاية هذا ان يكون رواية صريحة عنه بالوقوع ويكون عنه روايتان
 وقولكم كيف يفتي بالوقوع وهو يعلم ان رسول الله صلي الله عليه وسلم قد ردها عليه ولم يعتد عليه بها فليس هذا باول حديث خالفه راويه وله بغيره من الاحاديث التي خالفها راويها اسوة حسنة في تقديم رواية الصحابي ومن بعده علي رايه
 وقد روي ابن عباس حديث بريرة وان بيع الامة ليس بطلاقها وافتي بخلافه فاخذ الناس بروايته وتركوا رايه وهذا هو الصواب فان الرواية معصومة عن معصوم والراي بخلافها كيف واصرح الروايتين  عنه موافقته لما رواه من عدم الوقوع علي ان في هذا فقها دقيقا انما يعرفه من له غور علي اقوال الصحابة ومذاهبهم وفهمهم عن الله ورسوله واحتياطهم للامة ولعلك تراه قريبا عند الكلام علي حكمه صلي الله عليه وسلم في ايقاع الطلاق الثلاث جملة
 واما قوله في حديث ابن وهب عن ابن ابي ذءب في اخره وهي واحدة فلعمر الله لو كانت هذه اللفظة من كلام رسول الله صلي الله عليه وسلم ما قدمنا عليها شيءا ولصرنا اليها باول وهلة ولكن لا ندري اقالها ابن وهب من عنده ام ابن ابي ذءب ام نافع فلا يجوز ان يضاف الي رسول الله صلي الله عليه وسلم ما لا يتيقن انه من كلامه ويشهد به عليه وترتب عليه الاحكام ويقال هذا من عند الله بالوهم والاحتمال والظاهر انها من قول من دون ابن عمر رضي الله عنه ومراده بها ان ابن عمر انما طلقها طلقة واحدة ولم يكن ذلك منه ثلاثا اي طلق ابن عمر رضي الله عنه امراته واحدة علي عهد رسول الله صلي الله عليه وسلم فذكره
 واما حديث ابن جريج عن عطاء عن نافع ان تطليقة عبدالله حسبت عليه فهذا غايته ان يكون من كلام نافع ولا يعرف من الذي حسبها اهو عبدالله نفسه او ابوه عمر او رسول الله صلي الله عليه وسلم ولا يجوز ان يشهد علي رسول الله صلي الله عليه وسلم بالوهم والحسبان وكيف يعارض صريح قوله ولم يرها شيءا بهذا المجمل والله يشهد وكفي بالله شهيدا انا لو تيقنا ان رسول الله صلي الله عليه وسلم هو الذي حسبها عليه لم نتعد ذلك ولم نذهب الي سواه
 واما حديث انس من طلق في بدعة الزمناه بدعته فحديث باطل علي رسول الله صلي الله عليه وسلم ونحن نشهد بالله انه حديث باطل عليه ولم يروه احد من الثقات من اصحاب حماد بن زيد وانما هو من حديث اسماعيل  بن امية الذارع الكذاب الذي يذرع ويفصل ثم الراوي له عنه عبدالباقي بن قانع وقد ضعفه البرقاني وغيره وكان قد اختلط في اخر عمره وقال الدارقطني يخطء كثيرا ومثل هذا اذا تفرد بحديث لم يكن حديثه حجة
 واما افتاء عثمان بن عفان وزيد بن ثابت رضي الله عنهما بالوقوع فلو صح ذلك ولا يصح ابدا فان اثر عثمان فيه كذاب عن مجهول لا يعرف عينه ولا حاله فانه من رواية ابن سمعان عن رجل واثر زيد فيه مجهول عن مجهول قيس بن سعد عن رجل سماه عن زيد فيالله العجب اين هاتان الروايتان من رواية عبدالوهاب بن عبدالمجيد الثقفي عن عبيدالله حافظ الامة عن نافع عن ابن عمر انه قال لا يعتد بها فلو كان هذا الاثر من قبلكم لصلتم به وجلتم
 واما قولكم ان تحريمه لا يمنع ترتب اثره عليه كالظهار فيقال اولا هذا قياس يدفعه ما ذكرناه من النص وساءر تلك الادلة التي هي ارجح منه ثم يقال ثانيا هذا معارض بمثله سواء معارضة القلب بان يقال تحريمه يمنع ترتب اثره عليه كالنكاح ويقال ثالثا ليس للظهار جهتان جهة حل وجهة حرمة بل كله حرام فانه منكر من القول وزور فلا يمكن ان ينقسم الي حلال جاءز وحرام باطل بل هو بمنزلة القذف من الاجنبي والردة فاذا وجد لم يوجد الا مع مفسدته فلا يتصور ان يقال منه حلال صحيح وحرام باطل بخلاف النكاح والطلاق والبيع فالظهار نظير الافعال المحرمة التي اذا وقعت قارنتها مفاسدها  فترتبت عليها احكامها والحاق الطلاق بالنكاح والبيع والاجازة والعقود المنقسمة الي حلال وحرام وصحيح وباطل اولي
 واما قولكم ان النكاح عقد يملك به البضع والطلاق عقد يخرج به فنعم من اين لكم برهان من الله ورسوله بالفرق بين العقدين في اعتبار حكم احدهما والالزام به وتنفيذه والغاء الاخر وابطاله
 واما زوال ملكه عن العين بالاتلاف المحرم فذلك ملك قد زال حسا ولم يبق له محل واما زواله بالاقرار الكاذب فابعد وابعد فانا صدقناه ظاهرا في اقراره وازلنا ملكه بالاقرار المصدق فيه وان كان كاذبا
 واما زوال الايمان بالكلام الذي هو كفر فقد تقدم جوابه وانه ليس في الكفر حلال وحرام
 واما طلاق الهازل فانما وقع لانه صادف محلا وهو طهر لم يجامع فيه فنفذ وكونه هزل به ارادة منه ان لا يترتب اثره عليه وذلك ليس اليه بل الي الشارع فهو قد اتي بالسبب التام واراد الا يكون سببه فلم ينفعه ذلك بخلاف من طلق في غير زمن الطلاق فانه لم يات بالسبب الذي نصبه الله سبحانه مفضيا الي وقوع الطلاق وانما اتي بسبب من عنده وجعله هو مفضيا الي حكمه وذلك ليس اليه
