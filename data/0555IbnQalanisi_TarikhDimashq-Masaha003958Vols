  احمد بن هلاكو بن قاان بن جنكز خان ملك التتار

 ، كان ملكا شهما خبيرا بامور الرعايا، سالكا احسن المسالك، متبعا دين الاسلام، لا يصدر



 عنه الا ما يوافق الشريعة النبوية صلوات الله وسلامه علي صاحبها وانقياده اليها، واعتماده عليها في جميع حركاته بطريق الشيخ عبد الرحمن فانه كان قد اقبل عليه، وانقاد اليه، وامتثل ما يامره به، فكان يامره بمصالحة المسلمين والدخول في طاعتهم، والعمل علي مراضيهم، وان يكونوا كلهم شيءا واحدا، ولم يزل به علي ذلك الي ان اجاب الي مصالحة الملك المنصور سيف الدين قلاوون (رحمه الله) فكتب علي يد الشيخ عبد الرحمن كتبا بديعة دالة علي دخوله في الاسلام، واتباعه اوامر الله تعالي في الحلال والحرام، وتوجه بها الشيخ عبد الرحمن، فلما وصل الشام بلغه خبر وفاة الملك احمد، فبطل ما كان جاء بسببه وما كان اسسه، لكن وقع اجرهما علي الله تعالي، وبقي الشيخ عبد الرحمن (رحمه الله تعالي) مدة يسيرة وتوفي الي رحمة الله تعالي.

 ولما مات ابغا، وقع الاختلاف فيمن يقعد في التخت، فتعصب جماعة لاحمد المشار اليه، واسمه الحقيقي تكدار، واسم امه قنقو خاتون نصرانية، واتفقوا علي اقعاده في تخت الملك، وما هان علي بعض المغل قعود احمد لانه ادعي انه مسلم، فحضر اخوه قنقرطاي، وقال لارغون: ان ابغا شرط في الياسة انه اذا مات ملك ما يقعد عوضه الا الاكبر من اولاده، وقد رتبنا احمد، ومن خالف يموت، فاطاعوه وسيروا الي الالجية لاحضار الملوك ليكتبوا خطوطهم بالارتضاء بملك احمد، ولما جري ذلك تحدثوا فيما بينهم في ان قدرتهم قد ضعفت، ورجالهم قتلت، وان المسلمين كلما راحوا هزموهم وانه لا حيلة في هذا الوقت اتم من اظهار الاسلام، والتقرب الي مراضي مولانا السلطان، واكتفاء باسه بذلك، وسير في سبب ذلك رسلا الي الملك المنصور سيف الدين قلاوون يلتمس الصلح، وكان بين الملك (رحمه الله) وبين ارغون بن ابغا عداوة شديدة، فسير احمد عسكرا نحو ارغون مقدار احد عشر الف فارس، وقدم عليهم علي نياق احد خواصه، فقصدوا



 ارغون، ونزلوا قريبا منه، فركب ارغون، وكبسهم، فقتل منهم الفي فارس، وبلغ الملك احمد، فركب في اربعين الف فارس، وقصد جهة خراسان، فالتقي هو وارغون، فقتل من عسكر ارغون اكثر من النصف، وضربت البشاءر في بلاد العجم، وامسك خمسة من الامراء من المصاف وقررهم، فاعترفوا ان ارغون طلب العبور الي ايلخان، فمنعه جماعة من اصحاب الملك احمد، ومنعوه من الدخول في طاعة احمد، فامسك اثني عشر اميرا من كبراء المغل، وقيدهم، فعند ذلك قام المغل عليه، وجاهروه، فهرب، ثم اخذ، واحضر الي ارغون، فقتله، واستبد ارغون بالملك، وقيل في كيفية قتله غير ذلك والله اعلم ...

  عبد الرحمن بن عبد الله رسول الملك احمد بن هولاكو

 ، حدثني الشيخ عبد الله الموصلي المتصوف، وكان ممن قدم معه، وله خبرة بحاله، ان المذكور كان من مماليك الخليفة المستعصم بالله، (رحمه الله)، وكان يسمي قراجا، فلما ملك التتر بغداد وتلك البلاد تزهد، وتسمي بعبد الرحمن، واتصل بالملك احمد بن هولاكو، وعظم شانه لديه، وحصل له من المكانة عنده ما يقصر عنه الوصف بحيث كان الملك يحضر الي زيارته، واذا شاهده من بعد ترجل، فاذا وصل اليه قبل يده، وقعد بين يديه، وامتثل جميع ما يشير به، وكان معظم ما يصدر من الملك احمد من الافعال الجميلة، والمبالغة في الميل الي المسلمين بطريقه، واشار اليه ان يتفق مع الملك المنصور سيف الدين قلاوون، (رحمه الله)، ويجمع كلمتهم، فندبه لذلك، وسير في خدمته جماعة كثيرة من المغل والاعيان من اهل الموصل، وماردين وغيرهما، من صدور تلك البلاد، فحضر الي دمشق في العشر الاوسط من ذي الحجة سنة اثنتين وثمانين وست ماءة، واقام هو ومن معه في دار رضوان بقلعة دمشق، ورتب لهم من الاقامات ما لا مزيد عليه، وبولغ في اكرامهم، وخدمتهم بكل طريق، وقدم السلطان الملك المنصور الي الشام في هذه السنة، اعني ثلاث



 وثمانين وست ماءة، ومن اعظم اسباب قدومه الاجتماع به، وابرام ما قدم بسببه، فبلغ الملك المنصور عند وصوله الي الشام ان الملك احمد قتل، وتملك بعده ارغون بن ابغا بن هولاكو، فاستحضر الشيخ عبد الرحمن بقلعة دمشق ليلا، واجتمع به، وسمع رسالته، ووعاها ثم اخبره بما اتصل به من قتل الملك احمد مرسله، وعرفه ان رسالته انتقض حكمها بوفاة صاحبها، ثم ان الملك المنصور قضي اربه من سفرته تلك، وعاد الي الديار المصرية، والشيخ عبد الرحمن ومن معه بقلعة دمشق في مكانهم، لكن اختصر شء كثير مما كان يحضر اليهم، ورتب لهم قدر الكفاية التامة، فلما كان يوم الجمعة ثامن عشرين شهر رمضان المعظم من هذه السنة اعني سنة ثلاث وثمانين، توفي الشيخ عبد الرحمن المذكور (رحمه الله تعالي) بقلعة دمشق، فجهز وغسل بعد ان وقف عليه الامير حسام الدين ناءب السلطنة وغيره من الاعيان، ودفن بعد العصر بمقابر الصوفية، وقد نيف علي الستين سنة من العمر، وبقي من معه علي حالهم، وتطاول بهم الاعتقال، واهمل جانبهم بالكلية، وضاق بهم الحال في المطعم والملبس، وكان معظمهم من اهل الموصل ...

  عبد الملك بن اسماعيل بن ابي بكر بن شاذي

 ، ابو محمد الملك السعيد فتح الدين بن الملك الصالح عماد الدين بن الملك العادل سيف الدين، كان من اعيان اولاد الملوك واماثلهم، له الحرمة الوافرة، والمكانة الرفيعة، وكان حسن العشرة، دمث الاخلاق، وافر الحشمة، عنده رياسة، وقعدد، ومكارم اخلاق، وتانق فيما يعانيه من الماكل والملابس وغير ذلك، وتوفي ليلة الاثنين ثالث شهر رمضان المعظم سنة ثلاث وثمانين وست ماءة، ودفن عند جدته ام والده بتربتها داخل مدينة دمشق، وهو في عشر الخمسين. روي عن ابن اللتي، ومكرم بن ابي الصقر، وغيرهما، وحدث (رحمه الله تعالي) بموطا يحيي ابن بكير عن مالك وغيره، ومولده تقريبا سنة ثلاثين وست ماءة، وصنف كتابا في الماكل والوانها (رحمه الله تعالي).



  عطاء ملك بن محمد علاء الدين الجويني

 ، صاحب الديوان ببغداد والبلاد الشرقية، كان اماما عالما فاضلا، فقيها حنفيا، متبحرا في العلوم، نقالا لمذهب ابي حنيفة (رحمه الله) يعرف العربية، واللغة، والمعاني، وله استقلال بفن الادب مع الرياسة العظيمة والوجاهة التامة، وله الامر والنهي علي ساءر المملكة، يتصرف في الاموال والاقطاعات وغير ذلك، والناس يترددون الي بابه وخدمته، ويحضر مجلسه ساءر فضلاء بغداد وغيرها، ويجاريهم في العلوم، ويبالغ في الاحسان اليهم، ويمد لهم السماطات الهاءلة، وله اموال كثيرة، والات نفيسة، وكتب عظيمة، وكان مسكنه اخر وقت في دار الدوادار الصغير علي الجسر الجديد، وله يد في النظم والنثر، وكان بين يديه من امكنات الفضلاء جماعة كثيرة، وتفضلات علي ساءر الناس، ومكارم اخلاق، وطلاقه وجه، لا يعسف احدا ولا يظلمه، والناس في ايامه كايام الخلفاء، واهل بغداد وغيرها عاكفون علي محبته والدعاء له، وعمل في جامع الكوفة بركة عظيمة، ينزل اليها بدرج، وعمل في مشهد علي (رضوان الله عليه) رباطا مزخرفا، وساق اليه المياه العظيمة من النهر الذي حفره من الفرات مبداه من الانبار، واوصله الي المشهد، وعمر عليه نحو ماءة وخمسين قرية، وغرم عليه من الاموال ما لا يحصي، وحصل بذلك للناس رفق عظيم، فانهم كانوا يردون الماء قبل عمله من مسافة بعيدة كالصالحية من دمشق، وابعد، وزرع علي هذه المياه النخيل العظيمة، والبساتين، والكروم، والبقول، وكانت اولا كارض الحجاز، وكانت سيرته من احسن السير واجملها، واعدلها بالرعية، وانصفها للمظلوم. عمر البلاد جميعها، واسقط عن المزارعين مغارم كثيرة كانت من زمن الخلفاء. وكان اخوه الصاحب شمس الدين وزير البلاد في خدمة الملك حيث كان، وكان من صدور الاسلام، وله الكلمة النافذة والامر المطاع، اماما عالما فقيها في مذهب الشافعي رحمة الله عليه وكانت جواءزهما للعلماء الماءة دينار فما فوقها الي الالف.



 وكان قد عيد ابغا بن هولاكو بالعراق، وحضر علاء الدين، وشمس الدين اخوه الي بغداد، فاحصيت الجواءز، والانعامات، والوظاءف للعلماء والشعراء، وارباب البيوت، فكانت فوق الالف جاءزة، وكان كل فاضل يصنف كتابا، وينسبه اليهما تكون جاءزته الف دينار، واجازوا للشيخ شمس الدين بن الصيقل الجزري الف دينار علي تصنيفه خمسين مقامة فضلوها علي مقامات الحريري، وكان لهما حسن الظن في الفقراء والصالحين، وكذلك الاشراف، وكانت لهما عناية عظيمة باوامر الشريعة، مدح بعض الشعراء لعلاء الدين صاحب الديوان بقصيدة احسن نظمها، واكثر فيها المعاني، والجناس اللفظي، والخطي، ثم شرع يمت بقصيدته، ويقول: لم يمدح في هذه الملة الاسلامية احد بمثلها، ثم قال: اليس هذا احسن من @QUR@ قل يا ايها الكافرون ؟ فلما سمع علاء الدين منه ذلك، امر بعض غلمانه ان ياخذه بصورة ان يخلع عليه، فاذا خرج به ضرب عنقه، واحضر راسه الي السماط، ففعل ذلك، ثم انه شرع يعظم النبي (صلي الله عليه وسلم) وما جاء به، وقال: ما لكل مبتدع عندي الا قتله، وكان في زمن هولاكو، فما برح الصاحب علاء الدين اخو شمس الدين يعمل عليه حتي قتله، وكان قد قدم مجد الملك من ناحية العجم الي بغداد قبل توجه العسكر المخذول صحبة منكوتمر بن هولاكو الي الشام سنة ثمانين وست ماءة بنحو من شهرين، فاخذ صاحب الديوان علاء الدين عطاء ملك ابن الصاحب بهاء الدين الجويني، وعزله وغله وعاقبه، فقال صاحب الديوان في ذلك:

 لا تياسن لما جري فالخير فيه لعله ~ قد كان عبدا ابقا يعصي الاله فغله

 فلما عاد العسكر مكسورا، حمل صاحب الديوان في صحبتهم الي همذان، وهناك مات ابغا بن هولاكو، واخوه منكوتمر، فولي الامر الملك احمد باتفاق من صاحب الديوان علاء الدين، واخيه الصاحب شمس الدين محمد بن محمد الجويني، فبعد اشهر يسيرة دون السنة هلك احمد،



 وولي ارغون بن ابغا، وطلب صاحبي الديوان، فاختفيا عنه، وتوفي علاء الدين بعد اشهر من ذلك مختفيا، وطلب شمس الدين، فاخذ له امانا من ارغون واحضر عنده فغدر به، وقتله بعد موت اخيه بمدة يسيرة، وكان لهذا شمس الدين ولدان رءساء، لهم مكارم، واحتفال بالوظاءف التي يعملوها، والناس علي ابوابهم وهم في سعة صدورهم والاحسان الوافر، واذا عملوا دعوة غرموا عليها الالوف، ودعوا اليها كل فقير وغني، ولم يكن مثلهم في رياستهم، فلما قتل ابوهم، فوض امر العراق الي جماعة مشتركين، وهم: سعد الدين العجمي، ومجد الدين ابن الاثير، والامير المعروف بشكسان.

 فتعلق احد اولاد شمس الدين المذكور الذي قتل وهو الامير هارون علي ارق وزير ارغون، وصاحب حساب العراق، فلما كان بعد سنة، حضر الجماعة عند الوزير ارق في منزلهم من تبريز، وعمل حسابهم، واوجب عليهم القتل، وفعل ذلك بهم، وطلب كي خاتو اخو ارغون، وهو الذي كان قاتل مجد الدين ابن الاثير، لانه كان متعلقا به، فاعتذر ارق اليه بان هارون هو الذي فعل ذلك بالجماعة، وقتلهم، فاوجب الحال قتل هارون واولاده مع صغارهم، ومن كان عمره دون التمييز فقتلوا كلهم.

 واتفق لعلاء الدين صاحب الديوان سعادات عظيمة، ونزلت به امور عظيمة سلمه الله منها، فمن ذلك انه كان معه ببغداد شحنة من تحت يده يعمل ما يامره به، يقال له الطرغيا، وحديث الاموال، والمناصب، والامر، والنهي في البلاد كلها راجع الي علاء الدين، والشحنة ليس له من الامر الا اذا حضر بخدمة علاء الدين في دار العدل، ووجب قتل احد شرعا امره بقتله فامتثل، او بتاديبه فادبه، لا امر له سوي ذلك، فحسد علاء الدين علي ما هو فيه من انفاذ الكلمة، والاستقلال بالمملكة، ورام اخذ موضعه بمكيدة يعملها في حقه، فكتب علي لسان



 علاء الدين كتابا الي الملك المنصور قلاوون يذكر فيه ذلك مناصحة له، وانه ليحضر هو او احد عسكره ليملكه البلاد، وما يناسب هذا الكلام ليدل علي مواطاته، وسير الكتاب مع شخص يتوجه به الي الشام، ويعبر به في طريقه علي جماعة من المغل لياخذوه اذا راوه، فلما توجه الي ذلك المكان، وجده القراغون، فامسكوه وقالوا له: ايش معك؟ وقرروه، فقر انه رسول صاحب الديوان الي ملك مصر، فاحضروه الي بغداد الي الشحنة الذي كان ارسله، فاعطاه الف دينار علي توجهه به، فقرروه، واخذ الكتاب منه، وجهزه مع القراغون الي الملك ابغا، فطلب علاء الدين مقيدا مغلغلا، وكان اخوه شمس الدين عند ابغا وزيره، فعندما بلغه الخبر، ارسل غلمانه من طريق اقرب من طريق الرسل الواصلين باحضار اخيه بكتاب يقول فيه: يا اخي! يدك في الكتاب، ورجلك في الركاب، وتطوي المنازل، وكان لم يبرح عنده في الدهليز فرس مشدود، فمجرد ما وصله الكتاب، ركب ودخل البريدية الواصلين بسببه فلم يجدوه، وساق الليل والنهار الي ان وصل الي ابغا، وسال المحاقة علي ما قيل عنه، وطلب الرسول بالكتاب، وحاقه وساله من غير ضرب، فقر علي الشحنة، وانه اعطاه الف دينار علي تادية الكتاب الي ذلك المكان الذي امسكوه فيه، فرسم له بالبلاد علي عادته، وتضاعف شكره، وخلع عليه، وتسليم الشحنة اليه، وحكموه في البلاد اكثر مما كان، واما الذي حمل الكتاب المزور، فاخذه، وعاد به الي بغداد، وتنوع في عذابه وصلبه وسمله، ودور به البلد، ثم ارمي بعد ذلك في الدجلة، وكتب الي اهل بغداد كتابا يقول فيه بعد البسملة: «ان لله تعالي الطافا خفية، يري صورتها حسنة، يحسبها الجاهل بجهله نقمة، فاذا انتهت ونمت، عرف انها نعمة»، وما هذا معناه، وعاد الي بغداد، فاحتفلوا بدخوله احتفالا عظيما، وزين البلد، وعملت المغاني في الشوارع، والقباب المزينة، وكان يوم دخوله يوما مشهودا ...



  عيسي بن مهنا ابو مهنا

 الامير شرف الدين امير ال فضل، ملك العرب في وقته، والمشار اليه منهم، كان له منزلة عظيمة عند الملك الظاهر، ثم تضاعفت عند الملك المنصور سيف الدين قلاوون بحيث ضاعف حرمته واقطاعه، وملكه مدينة تدمر بعقد البيع والشراء، واورد عنه لبيت المال ليامن غاءلة ذلك فيما بعد، وكان المشار اليه كريم الاخلاق، حسن الجوار، مكفوف الشر، مبذول الخير، لم يكن في العرب وملوكها من يضاهيه، وعنده ديانة، وصدق لهجة، لا يسلك مسالك العرب في النهب وغيره، ولما توفي اقر الملك المنصور سيف الدين قلاوون (رحمه الله) ولده الامير حسام الدين مهنا علي امرته واقطاعه وزاده، وضاعف حرمته، وبسطته، وكان بين وفاته ووفاة الامير احمد بن حجي دون السنة، وكان بينهما من المنافسة ما يكون بين النظراء، فكان اجلهما متقارب، وصلي علي عيسي (رحمه الله) بجامع دمشق بالنية يوم الجمعة تاسع ربيع الاول سنة ثلاث وثمانين (رحمه الله تعالي) ...

  محمد بن محمود بن محمد

 بن عمر بن شاهنشاه بن ايوب بن شاذي ابو المعالي الملك المنصور ناصر الدين ابن الملك المظفر تقي الدين ابن الملك المنصور صاحب حماة والمعرة، تملك حماة وما معها عند وفاة والده في يوم السبت لثمان مضين من جمادي الاولي سنة اثنتين واربعين وست ماءة، ووالدته الصاحبة غازية خاتون ابنة الملك الكامل ابن العادل، ومولده في الساعة الخامسة من يوم الخميس لليلتين بقيتا من ربيع الاول سنة اثنتين وثلاثين وست ماءة بقلعة حماة، وعملت عقيقة عظيمة بقلعة حماة في اليوم السابع من مولده، وتقلد الملك بعد وفاة والده، وعمره عشر سنين وشهر واحد وثلاثة عشر يوما، وقام بتدبير ملكه الامير سيف الدين طغريل استاذدار والده، والمشير في الدولة الشيخ شرف الدين عبد العزيز الانصاري، والطواشي مرشد، والوزير بهاء الدين ابن تاج الدين، والجميع يرجعون الي ما تامر به الصاحبة غازية خاتون والدته ...



  نصر الله بن محمد بن نصر الله صفي الدين وزير حماة

 ، وليها بعد وفاة اخيه علاء الدين سنة اربع وسبعين وست ماءة، وكان حسن المعاملة للناس، لين الكلمة، توفي بحماة سلخ رجب (رحمه الله) وايانا ...

  السنة الرابعة والثمانون وستماءة

 استهلت هذه السنة، والخليفة والملوك علي القاعدة في السنة الخالية سوي الملك احمد بن هولاكو، فانه قتل، وترتب مكانه ارغون بن ابغا، وسوي الملك المنصور صاحب حماة، فانه توفي في السنة الخالية علي ما تقدم، واستقر عوضه ولده الملك المظفر تقي الدين محمود،

  [توجه السلطان قلاوون ضد المرقب وفتحه له]

 والملك سيف الدين قلاوون قد خرج من الديار المصرية الي الشام، ودخل دمشق يوم السبت ثاني وعشرين من المحرم بالعساكر المصرية، وعرض العسكر الشامي مدة ايام، وخرجوا جميعا يوم الاثنين ثاني صفر قاصدين المرقب، وكان قد بقي في يد الامير شمس الدين سنقر الاشقر قطعة من البلاد، منها: صهيون وبلاطنس وبرزية وغير ذلك، والعمل في الباطن علي انتزاع ما يمكن انتزاعه من يده، وافساد نوابه، فاتفق الحال بين من ببلاطنس من النواب وبين نواب الملك المنصور علي تسليم بلاطنس، فسلمت في اول صفر، ووافي الملك المنصور البشري بتسليمها، وهو علي عيون القصب متوجه الي حصار المرقب، فسر بذلك واستبشر بنيل مقصوده من المرقب، وقد تقدم ذكر ما فعله اهل المرقب بالعسكر النازل لهم، فاثر ذلك في نفس السلطان الملك المنصور سيف الدين قلاوون (رحمه الله) وحضر بنية قصدهم، فلما كان في مستهل صفر، خرج من دمشق بالعساكر المنصورة لقصده، وتقدمته المجانيق، ونازل الحصن المذكور يوم الاربعاء العاشر منه، وشرع العسكر في عمل الستاءر للمجانيق، فلما انتهت الستارة للمجانيق المقابل لباب الحصن، سقطت الي بركة كبيرة فيها ماء مجتمع، وكان عليها جماعة كبيرة من اصحاب الامير علم الدين الدواداري، منهم: شمس الدين سنقر استاذداره، وعدة من مماليكه، فاستشهدوا رحمهم الله تعالي.



 وفي يوم الاحد رابع عشرة، راسل الفرنج من بيت الاسبتار، وسالوا السلطان الامان لاهل المرقب علي انفسهم واموالهم، ويسلمون الحصن المذكور، فلم يجبهم السلطان في ذلك، وكمل نصب المجانيق، ورمي بها، وشعث الحصن، وهدم معظم احد ابراجه، واستمر الحال الي سادس عشر ربيع الاول، زحف السلطان علي الحصن، فاذعن من فيه بالتسليم، وحصلت المراسلة في معني ذلك، فلما كان يوم الجمعة ثامن عشر الشهر المذكور سلم ورفعت عليه الاعلام الاسلامية، ونزل من به بالامان علي ارواحهم، فركبوا، وجهز معهم من اوصلهم الي انطرسوس، وبالقرب من هذا الحصن مرقية، وهي بلدة صغيرة علي البحر، وكان صاحبها قد بني في البحر برجا عظيما لا يرام، ولا يصله النشاب، ولا حجر المنجنيق، وحصنه، واتفق حضور رسل صاحب طرابلس الي السلطان يطلب مراضيه، فاقترح عليه خراب هذا البرج واحضار من كان فيه اسيرا من الجبليين الذين كانوا مع صاحب جبيل، فاحضر من بقي في قيد الحياة منهم، واعتذر عن البرج انه ليس له، فلم يقبل اعتذاره عن ذلك، وصمم علي طلبه منه، فقيل: انه اشتراه من صاحبه بعدة قري وذهب كثير، وهدمه، وحصل الاستيلاء في هذه الغزوة علي المرقب، واعماله، ومن فيه، وبلنياس، وهذا المرقب هو من الحصون المشهورة بالمنعة والحصانة، وهو كبير جدا، ولم يفتحه السلطان الشهيد صلاح الدين (رحمه الله) بل ادخره الله تعالي للملك المنصور (رحمه الله) فحاز اجره وشكره، ولو لم يكن من ضرورة الا ما فعل اهله بالمسلمين في شهور هذه السنة لكفي، وضرره لا يحد، وابقاه الملك المنصور، ورم ما تشعث منه، واستناب فيه، ورتب احواله، وهو لبيت الاسبتار، وانشءت الكتب بالبشاءر بفتحه، فمن ذلك كتاب من السلطان الي ولده الملك الاشرف صلاح الدين خليل بخط المولي تاج الدين احمد بن الاثير تغمده الله برحمته ومن انشاءه وهو:



 «اعز الله نصرة الجناب العالي الملكي الاشرفي الصلاحي، ولا زالت جيوشه تفتتح من الممالك حصونها، وتبتذل مضمونها، وتستثمر من العادة غصونها، وتطوي لهم الارض، فلا يبعد عليهم مرمي، يعملون العزاءم المهمة ويصينونها، وتحدث السنة العالم بنعم الله التي يرونها في ايامه ويروونها، ويقصون اجنحتها بالشكر ويقصونها، تهدي له كل ساعة خبر عن جنوده وما ملكت، وخيوله وما سلكت، وسيوفه وما قتلت، ومهابتها وما اخذت، ومواهبها وما تركت، هذه البشري تقص عليه من غزوتنا احسن القصص، وتمثل صورة الفتح التي انتهزنا فرصته، وقلما تنتهز الفرص، ونبدي لعلمه الكريم، ان الهمم بها تنال الممالك، وترتقي المسالك، وتجتني ثمرات النصر، وتطفء جمرات الغدر، وقلما ظفر بالمراد واودع، وكل انف لا يانف المساءة فهو احق الاعضاء ان يجدع، ولم نزل نمثل في افكارنا الصورة التي اقدم عليها اهل حصن المرقب في مبدا الامر عند اضطراب النيات وضعف البينات، وغرور الامال الكاذبة، واشتمالات الخيالات الجاذبة، حتي نالوا من عسكرنا بحصن الاكراد ما نالوه، وتخيلوا ان عزمنا قد صرفوه عن قصدهم، او امالوه باخذ امرهم في الظاهر بالرخصة دون العزيمة، ويعمل علي ما لو تمثل لهم صورة لجروا منه ذيل الهزيمة، ويغضون من نواميس المجاوزة، ويغضي ويمضون بما يبدو منهم، وتنزل المحاورة وتمضي، ويستر ما يسدده الي نحورهم من سهم، ويريهم انا ندفع في صدر الحقيقة بالوهم، ونعرض عن مناقشتهم في الحساب، ونمسك عنهم، @QUR@ وتري الجبال تحسبها جامدة وهي تمر مر السحاب ()، ومن لم يءاخذ المسء بفعله، ويعرف مقدار حمله، استدام طمعه، واستقام طلقه، وحركته دواعي الشره للشرة، والحيل السلامة في كل مرة، فلم يزل يتربص لهم ريب المنون، وينزل ما كان منهم في جنب ما يكون، ويرتقب فيهم الوقت



 المنتظر، ويدب لهم الضراء، وتمشي لهم الحمر الي ان ان مكان الفرصة، جمعنا لهم بين الشرقة والغصة، فابعدنا اليهم المدني، واعتدنا مسعانا في طاعة الله عما اذا كانت مساعي الملوك عزما، ووصلنا المسير بالسري، وطرقناهم كما يطرق الطيف الكري، واوطانا بهم حوافر الخيل، وجءناهم مجء السيل، وظللنا عليهم ظلل الغم، وغشيهم منا ما غشي فرعون وجنوده من اليم، مع كون مكانهم قد جمع له منعة البر والبحر، وحل منهم بين السحر والنحر، تحامت قصده الملوك، وحتمه الاعادة، فلم تبق الاماني اليه طريق مسلوك، ولم يظفر به ملك من الملوك في الاسلام، ولا طرقته خيلهم في اليقظة، ولا خيالهم في المنام، يصد الرياح الهوج عنه مخافة، ويرجع عنه الطرف حسيرا لبعد المسافة باسرع من ان فاجاناه، وحللنا بعرصته، وهاجمناه، واحاطت به رجال الحرب، وشافهته بخطاب بالخطب، وعسكرنا بحمد الله تعالي مثل البحر اذا طما، والغيث اذا هما، والطود اذا سما، والليث اذا حمي.

 قد ملا الفجاج، واستعذب الاجاج، وقاسمهم الرياج، فاعطاهم الاسنة، وابقي له الزجاج، يتعرض ابطاله المنايا، ولو كانت عرضا، ويقول كل منهم: @QUR@ وعجلت اليك رب لترضي ()، فلم يزل القتال ينوبهم، وسهام المنون تصيبهم، وسحابهم يصوبهم، والسيوف تغمد في الطلي، والرماح توكف في الكلي، والمجانيق تدلك سورتهم، وتسلك فورتهم بنجومها. وتصميهم برجومها، ونقذفهم من كل جانب دحورا، ونعيد كلا منهم مذموما مدحورا، وتشير اليهم اصابعها بالتسليم لا بالتسلم، وببنانهم فما تذر من شء اتت عليه الا جعلته كالرميم، الي ان فتحناها، ولله الحمد عنوة، وحللنا مكايدهم فيها عقدة عقدة، ونقضنا عروة عروة، وسطرنا هذه البشري، واعلام النصر قد خفقت بنودها، وذلت لها علوج الكفر وكنودها، والسيف من دماءهم يقطر، والصليب



 خزيان ينظر، والاذان مكان الناقوس، والقراء موضع القسوس، والكنيسة قد عادت محرابا، والجنة قد فتحت للمجاهدين، فكانت ابوابا، وكنا نود ان الولد معنا في هذه المشاهد، وان ينظرها بعين المشاهد، ونرجو ان يكون ممن يستكين المرقد، وان لم يحضر هذه الغزوة فيتاهب للاخري، فكان قذفا لهمم تجعل ثمار النصر دانية القطوف، والسعيد من لا يستظل الا بسيفه، فان «الجنة تحت ظلال السيوف».

 وكتب المولي تاج الدين (رحمه الله) عن السلطان (رحمه الله) في المعني الي الامير علم الدين الشجاعي يقول:

 «اذ امر الله بهاءي المجلس العلمي، واحل البشاءر بساحته، وسره باستيلاءنا علي كل ثغر واستباحته، واسمعه من انباءنا الجميلة ما يعجز عن التعبير عنه لسان القلم علي فصاحته، ولا زال مهنا بايامنا التي تءرخ بالفتوح، وتنجد في مواقف الحرب بالملاءكة والروح، وتختص بالمدح دون كل ممدوح، وتري ما يطوي بجيوشنا من الارض، ولا يبعد عليها مكان به طروح، قد علم المجلس حركتنا الي الشام، وانا انشاناها عجالا، وجءنا بها علي البديهة، فلو كانت قصيدة لانشدناها ارتجالا، وكانت مباديها توجد باطراف الانامل، ومناديها يعود بخيبة الامل، ومهامها متلقاة بالهمم القاصرة، وعزاءمنا فيها كلها توقدت جمراتها، صادفت نيات ان لم تكن باردة فهي قارة، واذا مر ذكرها بمن له غرض او في قلبه مرض، ظن الظنون، وخيل له ان امرها لا يتم، وسرعتها لا تكون، ونحن نوسع للجهال حلما، ونزداد بعواقب التدبير علما، وكان الباعث عليها امور مهمة، ومراي تستفرغ قوي الافكار المستجمة، وكل وقت نصعد النظر ونصوبه، ونتصفح وجه الراي ونقبله، ونرتاد جهات القصد التي كان منها منشا المفاسد، وبها لشياطين النفاق نفاق، وكل سوق كاسد، فلما اخذت الاناة ماخذها ونفذت الاراء منها منافذها، وتمحضت زبدة الحلب، واسفر وجه الطلب، ولم يبق الا ان تزم



 الركاءب، وتسري الكتاءب، وتشرع الاسنة، وتبدو ضماءر النفوس المستكنة، اخلصنا النية لله عز وجل في نصرة الاسلام، وتقاضينا ديونه علي الانام، وجعلنا منهم مقدما علي ما عداه، وصممنا علي جهاد من نازعه رداء ملكه وعاداه، تركنا حظ النفس بمعزل. وكان في عزمنا ان نرتاد منزلا، فعرجنا عن ذلك المنزل، وقلنا: يا خيل الله اركبي، ويا ملاءكة النصر اصحبي، ويا اقلام البشري اكتبي، وصلنا الي الشام في جنود تقبل مثل قطع الليل، وتندفع اندفاع السيل، وكلما مررنا بمملكة سالت بجموعنا اوديتها، وغصت بعساكرنا انديتها، وانضم الينا جنودها، وخفقت علينا بنودها، ولم نزل نطوي المراحل، ونتجاوز الخصب والماحل، الي ان نزلنا بعيون القصب من عمل حمص، فوافاها البشير بما كان من امر بلاطنس التي تقدمت بها البشري، وفتت في عضد من كان بها قد استطار شرر طمعه واستسري، ولم تزل بعد السير، وتود لو استعرنا اجنحة الطير، الي ان وافينا المرقب، وهي المقصد ومناخ ركاءب العزم الذي هو لها مرصد، فكانت محط رحلنا، واليها مطارح امالنا، واصحابها الذين بداوا بالسنان، وقعقعوا لنا بالشنان، وامتدت لهم الايدي والالسنة، وجعلوا السيءة مكان الحسنة، وطمعوا بالبلاد وارتجاعها، وارتادوا موارد الحرب علي بعد اشجاعها، واستلانوا من عسكر حصن الاكراد جانبا ظنوا به الغلب، وفعلوا امرا عادوا منه بسوء منقلب، وصاروا يتكلمون من رءوس ملاي من الجهل، وياخذون في الحزن اذا اخذتهم الي السهل، ونحن نعمل علي الامر الذي يلف العماء، ويعيرهم اذنا سميعة، لا اذنا صماء، ونرتاد منهم امكنة الفرص، ونوحي لهم جمالة القنص، فلما رجمتهم الظنون، وتمحضت لهم المنون. وثبنا لهم وثبة الليث المغضب، واوردناهم باسيافنا ماء لا ينزح قليبه ولا ينضب، وما وردنا حتي قامت جيوش الجو علي ساق، وجاءت بعوث الغماءم من الافاق، ورشقت سهام السحاءب، وتغلغت ريح الصبا والحباءب، ورجفت الرعود بجنودها، وجردت البروق



 بيضها من غمودها، والقطر يرسل الحجارة الا انها من برد البحر اذا مرت به الريح صار كانه درع موضونة الزرد، فنزلناها ونازلناها، وامطنا حجب المهابة وازلناها، واحدقنا بها احداق السوار واحطنا بها، كما يحيط باليد السوار، وكانوا يغترون بمنعهم، ويعتزون بما يجري من سيل قلعتهم، ويعتقدون ان المعتصم بمكانهم واثق بان يمس السماء بكفه، ويري النجم دونه اذا لمحه بطرفه، فلم تزل تغاديهم الفتك وتراوحهم، وتماسيهم الحرب وتصابحهم، وترسل اليهم رسل المنايا، وتوقر سهامهم الا انها من الحبايا، ونرميهم بعذاب واصب، ونكلهم الي هم ناصب، والمنجنيقات تفوق اليهم سهامها وقسيها وتخيل لهم انها تسعي اليهم حبالها وعصيها، وهي للحصون من الد الخصوم، واذا امت معصما، حكم انه ليس بامام معصوم، ومتي افتري خلق في الات الفتوح لم يكن فيها احد من الممترين، واذا نزلت بساحة قوم @QUR@ فساء صباح المنذرين () تدعي الي الوغي، فتكلم، وما اقيمت صلاة حرب عند حصن الا كان ذلك الحصن من يسجد لها، ويسلم الي ان اقوت ربوعهم، وصبت علي مثل جمر الغضا ضلوعهم، واخذناهم اخذا وبيلا، واوردناهم مهاوي المهالك، وساءت سبيلا، وخسرت صفقة غدوهم وتراوحهم، وتحللت اعقد اجسامهم من ارواحهم، ووجدوا من انفسهم حدا كليلا، وجدا عثورا، وقدمنا الي ما عملوا من عمل فجعلناه هباء منثورا، وملكناها بالامان وهو في المعني بالسيف، وهجمناها هجوم الطيف، وكانت هي التي قد بقيت للاسبتار رحلة شتاءهم وصيفهم، فلم يبق لهم رحلة شتاء ولا صيف، وسطرنا هذه البشري والحرب قد وضعت اوزارها، والنفوس قد قضت منهم اوطارها، والبلاء قد دهم بلادهم واقطارها، والعلم يبني علي العلم، والسيف يملي علي القلم، والثغر قد جدد علي ايدينا اسلامه، وابدلنا بعد قطوبه ابتسامه، والدهر



 لمن عادانا عادي، ولمن ولانا وال، وسيوفنا قد اصبحت مفاتح المعاقل، فاذا ملكناها عادت لها اقفالا، والبشاءر مخترقة الامصار، والعساكر التي هجرت اوطانها، ونصرة الله قد كتبت من المهاجرين والانصار». 

 وكتب الامير حسام الدين لاجين (رحمه الله) ناءب السلطنة بالشام اذ ذاك كتابا الي الملك الصالح علاء الدين علي ابن السلطان الملك المنصور رحمهما الله تعالي يهنءه بفتح المرقب، وهو من انشاء المولي شهاب الدين محمود كاتب الدرج رحمهما الله تعالي، من مضمونه:

 «لا زالت ايات النصر تتلي علي سمعه من صحف البشاءر، ونفاءس الظفر تجلي علي سره في اسعد طالع، وايمن طاءر، وفواتح الفتح تملي لديه بما تزهي به الاسرة، وتزهر بنوره المنابر، ومحكمات التاييد تنهي اليه بما تجد مثل الدجي عليه سواد المحابر، وينهي انه سطرها والنصر قد لمعت بوارقه، ونصب بعد النصب علي فرق الفرقد سرادقه، والظفر قد اسفر عن الفتح المبين صباحه، والتاييد وقد طار به محلق البشاءر، فخفق في الخافقين جناحه، والاسلام وقد وطء هام الكفر بقدمه، والدين وقد عز بفتكات سيفه، فانف ان يكون الشرك من خدمه، والافلاك وقد علم انه لهذا الفتح افترقت كواكبها، والاملاك وقد نزلت لتشهد اخت النصرة البدرية في صفوفها ومواكبها، وحصن المرقب وقد الفت عليه الملة الاسلامية اشعر سعدها، وانجزت الاقدار التي ذللته للاسلام ان تتطاول اليه يد الحوادث من بعدها، وقد احاطت العلوم الشريفة بان هذا الحصن طالما شحت الاحلام ان تخيل فتحه لمن سلف في المنام، فما حدثت الملوك انفسها بقصده الا وتناهي بها الخجل، ولا خطبته ببذل النفس والنفاءس الا وكانت من روعة الحرمان علي وجل، وحوله من الجبال كل شامخ يهيب عقاب الجو قطع عقابه، ولفف الرياح حسري دون التوقل في هضابه، ومن الاولي به خنادق لا تعلم منها الشهور الا بانصافها، ولا تعرف فيها الاهلة الا باوصافها، وهو مع ذلك قد تقرط



 بالنجوم، وتقرطف بالغيوم، وسما فرعه الي السماء ورسا اصله في النجوم، تخال الشمس اذا علت انها تنتقل في ابراجه، ويظن من سها الي السها انه ذبالة في سراجه، فكم ذي جيوش قد امات بعضه، وذي سطوات اعمل الحيل علي رءيته، فلم يفز من نظره علي البعيد بغرضه، لا يعلوه من الطير سوي نسر الفلك ومرزمه، ولا يرمق متبرجات ابراجه غير عين شمسه، والمقل التي تطرق من انجمه، وقد نصبت عليه من المجانيق ما سهامه اقتل من سهام الجفون، وخطراته اسرع من لحظات العيون، لا يخاطب الا بواسطة رسله الصم الصلاب، ولا يري لسان سهمه الا كما يري خطفات البرق اذا تالق في علو السحاب، فنزلت عليه الجيوش المنصورة نزول القضاء، وصدمته بهممها التي تستعير فيها الصوارم سرعة المضاء وروعة الانتضاء، فنظرت منه حصنا قد رد عليه الجو جيب عمامه، وافتر بعزة، كلما حذر عليه البرق، فاضل لثامه، فذللت صعابه، وسهلت عقابه، وركزت الخبويات في سفحه، وطالما رامت الطير ادناه، فلم يقومها القوادم، وكم همت العواصف ان تبتسم رباه، فاصبحت محلقة تبكي عليها الغماءم، فعاد مصفحا بصفاحها، مشرفا بما علا من اسنة رماحها، وارسلت الي ارجاءها ما اربي علي الغماءم، وزاد في لفحه علي السماءم، وكان بها مثل الجنوب فاصبحت، ومن حيث القتلي عليها تماءم، ونصبت امامه المجانيق المنصورة، فلم ترع حق حبسها، وسطت علي نظراءها، فاصبح غدها في التحامل ابعد من امسها، واستنهضها العدي، واعلمتهم انها لا تطيق الدفاع عن غيرها، بعد ان عجزت عن نفسها، وبسطت اكفها امارة علي الاذعان، ورفعت اصابعها، اما اجابة الي بذل التشهد، واما انابة الي طلب الامان، فخوفوا من ظهور هذا الاستظهار، وعلموا ان المجانيق المنصورة فحول لا تثبت لها الاناث التي عريت من النفع بايديهم، واستعانوا عليهن مع العري بطول الحذار، فعند ذلك غدت تكمن كمون الاساود، ووثبت وثبات الاسود، وتباري بها الحصن السماء،



 فكلما قذفت هذه بكواكبها الزهر، قذف هذا بكواكبه السود، ولم يكسر لهم منجنيق الا نصبوا عشرا مكانه، ولا قطعت لاحدها اصبع الا ومد الاخر بنانه، فتطلب بتجارب مثل الكماة، وتتحايل تحايل الرماة، حتي فتحت وفسحت الرجال مجالا، ونالت ونيل منها، وكذلك الحرب تكون سجالا، هذا، والنقوب قد دبت في بواطنه دبيب السقام، وتمشت في مفاصله كما يتمشي في مفاصل شاربها المدام، وحشت اضالعه نارا تشبه نار الهوي، تحرق الاحشاء، ولا يبدو لها ضرام، فقد احل من حلة الوجل، وتحققوا حلول الاجل، وايقن الحصن بالانتظام في سلك ممالك الاسلام، وكاد يرقصه ممن فيه فرط الجدل، وزاد شوقه الي التشريف بوسمها، وما صابه مشتاق علي امل من اللقاء كمشتاق بلا امل، لكنهم اظهروا الجلد، واحفظوا اضرام نار الكمد، وكيف يخفي وقد انحلوا في اشرك اشراكهم، لعلمهم انه لا مقاض من يد اهل التوحيد لاهل الاحد، وتدفقت اليهم الجيوش المنصورة، فملات الافق، واحاطت بهم احاطة الطوق بالعنق، ونهضت اليهم مسندة من عزمات سلطانها، مستعدة لانتزاح ارواح العدي علي يدها من اوطانها فانقطعت بهم الظنون، ودارت عليهم رحي المنون، وامطرت عليهم المجانيق احجارها، فوقع الحق وبطل ما كانوا يعملون، لمن بها من اللهب تلك الاحجار، فهدمت العماءر والاعمار، واجرت في نواحيها انهار الدماء، فهلكوا بالسيف والسيل والنار، ولما ركب مولانا السلطان خلد الله ملكه وسلطانه لاول الزحف في جيوشه التي كاثرت البحر بامواجه، وسقت العدي علي ريها بالخوف كءوسا امر من اجاجه، تزلزل الحصن لشدة ركضه، وتضعضع من خوف غضبه، فلحقت سماءه بارضه، وتحللت قواعد ما شيد من اركانه، فانحلت وانشقت سماءه من الجزع، فالقت الارض ما فيها وتخلت، ومشت النار من تحتهم وهم لا يشعرون، ونفخ في الصور بل في السور فاذا هم قيام ينظرون، وما كان الا ان قابل مولانا السلطان خلد الله سلطانه ما شمخ من ابراجه



 حتي اهوي يلثم بين يديه التراب، وتادب باداب الطاعة حين نظرت اليه، فخر راكعا واناب، فهاجمتهم الجيوش المنصورة مهاجمة الحتوف، واسرعت المصاف الانتضاء. فلم يدر العدو اهم ام الذي في ايديهم السيوف، فحل بهم الذل ونزل، وخافوا فتكات تلك السيوف التي تسبق العذل، وثبت من لم يجد وراءه مجالا، وهو يقول: مكره اخاك لا بطل. فلجاوا الي الامان، وتمسك ذل كفرهم بعد الايمان، تشبثوا بساحل العفو حين ظنوا انهم احيط بهم، وجاءهم الموج من كل مكان، فسالوا ان يكون العفو عن مولانا السلطان من بعض الصناءع، وتضرعوا في ان يجعل ارواحهم لسيوفه من جملة الوداءع، فتصدق عليهم بنفوسهم كرما، وظلوا علي معني الخبر الماثور يرون الموت يقظة، والحياة حلما، واطلقتهم اليد التي لا يخيب لديها الامل، واعتقتهم اليمني التي فجاج الارض قبضتها، فمتي تشاء تجمع عليهم الانامل، وخرجوا بنفوس قد تجردت حتي من الاجسام، ومقل طلقت الكري خوفا من سيوفه التي تسلها عليهم الاحلام، وسطرت والنصر قد يتسنم اعلاها، وشعار الايمان قد جردها من وحشة لباس الكفر واغرارها، والاعلام المنصورة قد سلكت الي ذلك المرقب اعلي مرتقي، والسعادة قد بدلت بيعه مساجد، ومحاريبه قبلة، وكان شرقا فاصبح يرفل في حلل الايمان، واذعن بالطاعة، فاجرس جرس الحرس به صوت الاذان، وعاد سهما مسددا في كنانة الاسلام، ودرا منضدا في عقد المملكة فحسن به فتم النظام، لا يسلك البحر طاغ الا ويقذفه الموج اليه، لا يختلس اكبر باغ الا وتوقعه ضيق مسالكه في يديه، فهو احسن من ارم، واوضح من علم، وانكي في الاصابة علي البعد من السهم الذي اصاب وراميه بذي سلم، فياخذ مولانا حظه من هذا النصر الذي هو اليه، وان بعد منسوب، والفتح الذي عددت الفتوح علي كثرتها فهو بجميعها محسوب».



 وكتب المولي كمال الدين احمد بن العطار عن الامير حسام الدين لاجين ناءب السلطنة اذ ذاك بالشام الي الامير علم الدين الشجاعي يهنءه بالفتح المذكور، يقول:

 «@QUR@ نصر من الله وفتح قريب يسره الله بعزاءم الجناب العالي، لا زالت عزاءمه تسهل من النصر مرادا، وهممه تفسح من الفتح مرادا، وسطوته تستاصل من الاعداء مرادا، ومسامعه الكريمة تستعذب معادا من حديث البشاءر اذا كان معادا معاذا، قد احاط العلم الكريم بالحركة المباركة، والنزول علي المرقب الذي كم تحته من مربا زاد علوه علي علو الرصد، وما حل احد بواديه، ورام رءية الهلال في مغربه، والشمس في مشرقه الا وصده عما قصد، فما تري الهلال منه الا بدار، ولا تشاهد الشمس المنيرة الا ظهرا، ونازلنا منه القلعة التي مسامتة السماء، فزاحمت البروج منها البروج، وحلت الجوزاء لسوارها المحكمة، متي اتصلت بدناءتها بمنازل الكوكب، وما لها من خروج، واذا رام القطر سقي اهلها، عرج عن قصد النزول، واخذ في تعاريج العروج، ولربما حاول منازلتها من تقدم من الملوك، فصده عنها قسي الرعود، ونبل الوبل، واسوار الثلوج، وارخت السماء عزاليها علي جيشه، وحال بينهما الموج فكان من المغرقين، والتفت عليه اشجارها فبات من المدبقين، واصبح من الموبقين، واعادت كل من قصد الصعود اليها يمشي علي اربع بعد ان كان يمشي علي رجلين، وردته عقابه ناكصا علي عقبيه، وكان يحجل في حجلين، فاستدارت عليها جنوباتنا، فشاهدنا منها منطقة البروج، واستجنت بها الجيوش من سهام الجروخ، فابقت كل سريع الخروج عن بدناتها الي الابدان سريع الولوج، وقامت المجانيق بسفراء من الحجارة عن السهام، واشارت اليها باصابع كفوفها بالانتقال عن ذل الكفر الي عز الاسلام، وفي اول الحال عجل منجنيق الواحد كسر مناجيقهم الثلاثة، ونقل من صورة الحال بسرعة، نصر الواحد علي من يدين



 بالثلاثة، ولم تزل مناجيقنا ترقي القلعة بحجارة تطير محلقة نحوها كالطيور، وتعلو نسور احجارها طالبة قبة قلتها، والجبال الشاهقة، وكور النسور، فما رمت حجرا الا اثر بها اثرا، ولا راجعتها ضربا الا اسمع واري بظاهرها وباطنها ندبا، لكنها علي مراجعة الحرب، ومعاودة الضرب، كانها تضرب من حجارة اسوارها في حديد بارد، وهي وان لم تكن حديدا، فانها حجارة حديدة لا تعمل فيها المعاول، ولا تءثر فيها المبارد، الا ان نوازلها مصيبة فيها نازلة، وما اشبه سهامها بسهام العيون تقضي بالمنون، ولا تفارق الجفون، او بالنجوم في الرجوم تصيب وهي بمكانها المعلوم، ودامت ذمة حسناتها مطالبة المحاصرة بما في يدها للملة الاسلامية من الاعتصاب والفرض، والنقابة تعمل من خوارجها في داخل بنيانها عمل الخلد في الارض حتي اخلد الله الارض، وتقضت النقوب نظام اساساتها فانحلت، والقيت النار في احشاءها، فالقت ما فيها وتخلت، هذا، والمجانيق منا ومنهم تارة وتارة، واكفها ترمي من النفط اصابعها بشرر كالقصر، وقودها الناس والحجارة، الي ان تمكن الهد من احد ابراجها، فهدم بناءه المنظم، ولما اراد جداره ينقض، سارع الي تقبيل الارض، وبادر الي الخدمة فسلم، وزحفت عليها الجيوش المنصورة من جوانبها، واحاطت بها احاطة الاغماد بقواضبها، وضمتها ضم الاطواق للاعناق، واطبقت بها اطباق الجفون علي الاحداق، الا ان الله سبحانه وتعالي سهل امرها، واذل للاسلام كفرها، وسلط المجانيق المسلمة علي المجانيق الكافرة، فكفي المءمنين شرها، فلم يزل كل منها يرميهم باحجاره، حتي استنزلهم علي اختياره، وسالوا الاجارة من الحجارة، وطلبوا الامان من الايمان.

 واذعنوا بالاستسلام الي الاسلام، وكتابنا هذا، وقد علت علي قلعتها اعلام الايمان، وصرح بها اعلان الاذان، ورمي بالخرس جرس الحرس، واذهب ظهر الايمان منها رجس النجس، وافترت عن فتحها ثغور



 الايام، وغدت مغلقة بمسك المداد اصداغ الاقلام، فلياخذ حظه من هذه البشري التي شرحت للاسلام صدرا، وجددت لكل صباح من تباشيره بشرا، وخلدت لايام هذه الدولة فخرا، يبدو في صبيحة كل نهار فجرا، وهذا الفتح المبين وان لم يكن الجناب من حضار حصارها، ولا تضمخ درعه بردعه، ولا تمسك ذيله بعثاره، فانه مجهز جيش كتاءبه التي فتح الله علي يدها، واجراها من النصرة علي جميل عواءدها، فله اجر الغازي وهو المقيم، والسهم اذا اصاب الغرض فراميه المصيب وهو بمكانه لا يريم» ...

