 الايات لعلكم بلقاء ربكم توقنون وهو الذي مد الارض وجعل فيها رواسي وانهارا ومن كل الثمرات جعل فيها زوجين اثنين يغشي الليل النهار ان في ذلك لايات لقوم يتفكرون وفي الارض قطع متجاورات وجنات من اعناب وزرع ونخيل صنوان وغير صنوان يسقي بماء واحد ونفضل بعضها علي بعض في الاكل ان في ذلك لايات لقوم يعقلون :   وقال تعالي امن خلق السماوات والارض وانزل لكم من السماء ماء فانبتنا به حداءق ذات بهجة ما كان لكم ان تنبتوا شجرها االه مع الله بل هم قوم يعدلون امن جعل الارض قرارا وجعل خلالها انهارا وجعل لها رواسي وجعل بين البحرين حاجزا االه مع الله بل اكثرهم لا يعلمون :   وقال تعالي __________ [ () ] النيل قبل يوم الصليب بيوم وقد تهيا اهل مصر للجلاء والخروج منها لانه لا يقوم بمصلحتهم فيها الا النيل فاصبحوا يوم الصليب وقد اجراه الله ستة عشر ذراعا. وقد زال تلك السنة السوء عن اهل مصر انتهي [] بلدة بين حلب والرقة لها وقاءع تاريخية مذكورة في معجم البلدان (محمود الامام) 
 هو الذي انزل من السماء ماء لكم منه شراب ومنه شجر فيه تسيمون ينبت لكم به الزرع والزيتون والنخيل والاعناب ومن كل الثمرات ان في ذلك لاية لقوم يتفكرون وسخر لكم الليل والنهار والشمس والقمر والنجوم مسخرات بامره ان في ذلك لايات لقوم يعقلون :   فذكر تعالي ما خلق في الارض من الجبال والاشجار والثمار والسهول والاوعار وما خلق من صنوف المخلوقات من الجمادات والحيوانات في البراري والقفار والبر والبحار ما يدل علي عظمته وقدرته وحكمته ورحمته بخلقه وما سهل لكل دابة من الرزق الذي هي محتاجة اليه في ليلها ونهارها وصيفها وشتاءها وصباحها ومساءها كما قال تعالي وما من دابة في الارض الا علي الله رزقها ويعلم مستقرها ومستودعها كل في كتاب مبين :  وقد روي الحافظ ابو يعلي عن محمد بن المثني عن عبيد بن واقد عن محمد بن عيسي بن كيسان عن محمد بن المنكدر عن جابر عن عمر بن الخطاب قال سمعت رسول الله صلي الله عليه وسلم يقول خلق الله الف امة منها ستماءة في البحر واربعماءة في البر. واول شء يهلك من هذه الامم الجراد فاذا هلك تتابعت مثل النظام اذا قطع سلكه. (عبيد بن واقد) ابو عباد البصري ضعفه ابو حاتم وقال بن عدي عامة ما يرويه لا يتابع عليه وشيخه اضعف منه. قال الفلاس والبخاري منكر الحديث، وقال ابو زرعة لا ينبغي ان يحدث عنه. وضعفه ابن حبان والدارقطني وانكر عليه ابن عدي هذا الحديث بعينه وغيره والله اعلم وقال تعالي وما من دابة في الارض ولا طاءر يطير بجناحيه الا امم امثالكم ما فرطنا في الكتاب من شء ثم الي ربهم يحشرون : 
  AUT باب ذكر ما يتعلق بخلق السموات وما فيهن من الايات
 قد قدمنا ان خلق الارض قبل خلق السماء كما قال تعالي هو الذي خلق لكم ما في الارض جميعا ثم استوي الي السماء فسواهن سبع سماوات وهو بكل شء عليم :  وقال تعالي قل اانكم لتكفرون بالذي خلق الارض في يومين وتجعلون له اندادا ذلك رب العالمين وجعل فيها رواسي من فوقها وبارك فيها وقدر فيها اقواتها في اربعة ايام سواء للساءلين ثم استوي الي السماء وهي دخان فقال لها وللارض اءتيا طوعا او كرها قالتا اتينا طاءعين فقضاهن سبع سماوات في يومين واوحي في كل سماء امرها وزينا السماء الدنيا بمصابيح وحفظا ذلك تقدير العزيز العليم :   وقال تعالي اانتم اشد خلقا ام السماء بناها رفع سمكها فسواها واغطش ليلها واخرج ضحاها والارض بعد ذلك دحاها :   فان الدحي غير الخلق وهو بعد خلق السماء وقال تعالي تبارك الذي بيده الملك وهو علي كل شء قدير الذي خلق الموت والحياة ليبلوكم ايكم احسن عملا وهو العزيز الغفور الذي خلق سبع سماوات طباقا ما تري في خلق 
 الرحمن من تفاوت فارجع البصر هل تري من فطور ثم ارجع البصر كرتين ينقلب اليك البصر خاسءا وهو حسير ولقد زينا السماء الدنيا بمصابيح وجعلناها رجوما للشياطين واعتدنا لهم عذاب السعير :   وقال تعالي وبنينا فوقكم سبعا شدادا وجعلنا سراجا وهاجا :   وقال تعالي الم تروا كيف خلق الله سبع سماوات طباقا وجعل القمر فيهن نورا وجعل الشمس سراجا :   وقال تعالي الله الذي خلق سبع سماوات ومن الارض مثلهن يتنزل الامر بينهن لتعلموا ان الله علي كل شء قدير وان الله قد احاط بكل شء علما :  وقال تعالي تبارك الذي جعل في السماء بروجا وجعل فيها سراجا وقمرا منيرا. وهو الذي جعل الليل والنهار خلفة لمن اراد ان يذكر او اراد شكورا :   وقال تعالي انا زينا السماء الدنيا بزينة الكواكب وحفظا من كل شيطان مارد لا يسمعون الي الملا الاعلي ويقذفون من كل جانب دحورا ولهم عذاب واصب. الا من خطف الخطفة فاتبعه شهاب ثاقب :   وقال تعالي ولقد جعلنا في السماء بروجا وزيناها للناظرين وحفظناها من كل شيطان رجيم. الا من استرق السمع فاتبعه شهاب مبين :   وقال تعالي والسماء بنيناها بايد وانا لموسعون :  وقال تعالي وجعلنا السماء سقفا محفوظا وهم عن اياتها معرضون وهو الذي خلق الليل والنهار والشمس والقمر كل في فلك يسبحون :   وقال تعالي واية لهم الليل نسلخ منه النهار فاذا هم مظلمون. والشمس تجري لمستقر لها ذلك تقدير العزيز العليم. والقمر قدرناه منازل حتي عاد كالعرجون القديم لا الشمس ينبغي لها ان تدرك القمر ولا الليل سابق النهار وكل في فلك يسبحون :   وقال تعالي فالق الاصباح وجعل الليل سكنا والشمس والقمر حسبانا ذلك تقدير العزيز العليم. وهو الذي جعل لكم النجوم لتهتدوا بها في ظلمات البر والبحر قد فصلنا الايات لقوم يعلمون :   وقال تعالي ان ربكم الله الذي خلق السماوات والارض في ستة ايام ثم استوي علي العرش يغشي الليل النهار يطلبه حثيثا والشمس والقمر والنجوم مسخرات بامره الا له الخلق والامر تبارك الله رب العالمين :  والايات في هذا كثيرة جدا وقد تكلمنا علي كل منها في التفسير والمقصود انه تعالي يخبر عن خلق السموات وعظمة اتساعها وارتفاعها وانها في غاية الحسن والبهاء والكمال والسناء كما قال تعالي والسماء ذات الحبك :  اي الخلق الحسن وقال تعالي فارجع البصر هل تري من فطور. ثم ارجع البصر كرتين ينقلب اليك البصر خاسءا وهو حسير :   اي خاسءا عن ان يري فيها نقصا او خللا وهو حسير اي كليل ضعيف ولو نظر حتي يعي ويكل ويضعف لما اطلع علي نقص فيها ولا عيب لانه تعالي قد احكم خلقها وزين بالكواكب افقها كما قال والسماء ذات البروج :  اي النجوم وقيل محال الحرس التي يرمي منها بالشهب لمسترق السمع ولا منافاة بين القولين وقال تعالي ولقد جعلنا في السماء بروجا وزيناها للناظرين وحفظناها من كل شيطان رجيم :   فذكر انه زين منظرها بالكواكب الثوابت والسيارات (الشمس والقمر والنجوم الزاهرات) وانه صان حوزتها عن حلول 
 الشياطين بها وهذا زينة معني فقال وحفظناها من كل شيطان رجيم كما قال انا زينا السماء الدنيا بزينة الكواكب وحفظا من كل شيطان مارد لا يسمعون الي الملا الاعلي :  . قال البخاري في كتاب بدء الخلق وقال قتادة ولقد زينا السماء الدنيا بمصابيح :  خلق هذه النجوم الثلاث جعلها زينة للسماء ورجوما للشياطين وعلامات يهتدي بها فمن تاول بغير ذلك فقد اخطا واضاع نصيبه وتكلف ما لا علم له به وهذا الذي قاله قتادة مصرح به في قوله تعالي ولقد زينا السماء الدنيا بمصابيح وجعلناها رجوما للشياطين :  وقال تعالي وهو الذي جعل لكم النجوم لتهتدوا بها في ظلمات البر والبحر :  فمن تكلف غير هذه الثلاث اي من علم احكام ما تدل عليه حركاتها ومقارناتها في سيرها وان ذلك يدل علي حوادث ارضية فقد اخطا. وذلك ان اكثر كلامهم في هذا الباب ليس فيه الا حدس وظنون كاذبة ودعاوي باطلة. وذكر تعالي انه خلق سبع سماوات طباقا :  اي واحدة فوق واحدة واختلف اصحاب الهيءة هل هن متراكمات او متفاصلات بينهن خلاء علي قولين. والصحيح الثاني لما قدمنا من حديث عبد الله بن عميرة عن الاحنف عن العباس في حديث الاوعال ان رسول الله صلي الله عليه وسلم قال اتدرون كم بين السماء والارض قلنا الله ورسوله اعلم. قال بينهما مسيرة خمسماءة عام. ومن كل سماء الي سماء خمسماءة سنة وكثف كل سماء خمسماءة سنة الحديث بتمامه رواه احمد وابو داود وابن ماجه والترمذي وحسنه وفي الصحيحين من حديث انس في حديث الاسراء قال فيه ووجد في السماء الدنيا ادم فقال له جبريل هذا ابوك ادم فسلم عليه فرد عليه السلام. وقال مرحبا واهلا بابني نعم الابن انت الي ان قال ثم عرج الي السماء الثانية وكذا ذكر في الثالثة والرابعة والخامسة والسادسة والسابعة فدل علي التفاصل بينها لقوله ثم عرج بنا حتي اتينا السماء الثانية فاستفتح فقيل من هذا الحديث وهذا يدل علي ما قلناه والله اعلم. وقد حكي ابن حزم وابن المنير وابو الفرج ابن الجوزي وغير واحد من العلماء الاجماع علي ان السموات كرة مستديرة واستدل علي ذلك بقوله كل في فلك يسبحون : . قال الحسن يدورون، وقال ابن عباس في فلكة مثل فلكة المغزل. قالوا ويدل علي ذلك ان الشمس تغرب كل ليلة من المغرب ثم تطلع في اخرها من المشرق كما قال امية ابن ابي الصلت. والشمس تطلع كل اخر ليلة حمراء مطلع لونها متورد تابي فلا تبدو لنا في رسلها الا معذبة والا تجلد فاما الحديث الذي رواه البخاري حيث قال حدثنا محمد ابن يوسف حدثنا سفيان عن الاعمش عن ابراهيم التيمي عن ابيه عن ابي ذر قال قال رسول الله صلي الله عليه وسلم لابي ذر حين غربت الشمس تدري اين تذهب قلت الله ورسوله اعلم قال فانها تذهب حتي تسجد تحت العرش فتستاذن فيءذن لها ويوشك ان تسجد فلا يقبل منها وتستاذن فلا يءذن لها. يقال لها ارجعي من حيث جءت فتطلع من مغربها فذلك 
 قوله تعالي والشمس تجري لمستقر لها ذلك تقدير العزيز العليم :  هذا لفظه في بدء الخلق ورواه في التفسير وفي التوحيد من حديث الاعمش ايضا ورواه مسلم في الايمان من طريق الاعمش ومن طريق يونس بن عبيد وابو داود من طريق الحكم بن عتبة كلهم عن ابراهيم بن يزيد بن شريك عن ابيه عن ابي ذر به نحوه. وقال الترمذي حسن صحيح اذا علم هذا فانه حديث لا يعارض ما ذكرناه من استدارة الافلاك التي هي السموات علي اشهر القولين ولا يدل علي كرية العرش كما زعمه زاعمون. قد ابطلنا قولهم فيما سلف ولا يدل علي انها تصعد الي فوق السموات من جهتنا حتي تسجد تحت العرش بل هي تغرب عن اعيننا وهي مستمرة في فلكها الذي هي فيه وهو الرابع فيما قاله غير واحد من علماء التفسير. وليس في الشرع ما ينفيه بل في الحس وهو الكسوفات ما يدل عليه ويقتضيه فاذا ذهبت فيه حتي تتوسطه وهو وقت نصف الليل مثلا في اعتدال الزمان بحيث يكون بين القطبين الجنوبي والشمالي فانها تكون ابعد ما يكون من العرش لانه مقبب من جهة وجه العالم وهذا محل سجودها كما يناسبها كما انها اقرب ما تكون من العرش وقت الزوال من جهتنا فاذا كانت في محل سجودها استاذنت الرب جل جلاله في طلوعها من الشرق فيءذن لها فتبدو من جهة الشرق وهي مع ذلك كارهة لعصاة بني ادم ان تطلع عليهم ولهذا قال امية تابي فلا تبدو لنا في رسلها الا معذبة والا تجلد فاذا كان الوقت الذي يريد الله طلوعها من جهة مغربها تسجد علي عادتها وتستاذن في الطلوع من عادتها فلا يءذن لها فجاء انها تسجد ايضا ثم تستاذن فلا يءذن لها ثم تسجد فلا يءذن لها وتطول تلك الليلة كما ذكرنا في التفسير، فتقول يا رب ان الفجر قد اقترب وان المدي بعيد فيقال لها ارجعي من حيث جءت فتطلع من مغربها فاذا راها الناس امنوا جميعا وذلك حين لا ينفع نفسا ايمانها لم تكن امنت من قبل او كسبت في ايمانها خيرا، وفسروا بذلك قوله تعالي والشمس تجري لمستقر لها :  قيل لوقتها الذي تءمر فيه تطلع من مغربها وقيل مستقرها موضعها الذي تسجد فيه تحت العرش وقيل منتهي سيرها وهو اخر الدنيا. وعن ابن عباس انه قرا؟ والشمس تجري لا مستقر لها : ؟ اي ليست تستقر فعلي هذا تسجد وهي ساءرة. ولهذا قال تعالي لا الشمس ينبغي لها ان تدرك القمر ولا الليل سابق النهار وكل في فلك يسبحون :  اي لا تدرك الشمس القمر فتطلع في سلطانه ودولته ولا هو ايضا ولا الليل سابق النهار اي ليس سابقه بمسافة يتاخر ذاك عنه فيها بل اذا ذهب النهار جاء الليل في اثره متعقبا له كما قال في الاية الاخري يغشي الليل النهار يطلبه حثيثا والشمس والقمر والنجوم مسخرات بامره الا له الخلق والامر تبارك الله رب العالمين :  وقال تعالي وهو الذي جعل الليل والنهار خلفة لمن اراد ان يذكر او اراد شكورا :  اي يخلف هذا لهذا وهذا لهذا كما قال رسول الله صلي الله عليه وسلم «اذا اقبل الليل من هاهنا وادبر النهار من هاهنا وغربت 
 الشمس فقد افطر الصاءم» فالزمان المحقق ينقسم الي ليل ونهار وليس بينهما غيرهما ولهذا قال تعالي يولج الليل في النهار ويولج النهار في الليل وسخر الشمس والقمر كل يجري لاجل مسمي :  فيولج من هذا في هذا، اي ياخذ من طول هذا في قصر هذا فيعتدلان كما في اول فصل الربيع يكون الليل قبل ذلك طويلا والنهار قصيرا فلا يزال الليل ينقص والنهار يتزايد حتي يعتدلا وهو اول الربيع ثم يشرع النهار يطول ويتزايد والليل يتناقص حتي يعتدلا ايضا في اول فصل الخريف ثم يشرع الليل يطول ويقصر النهار الي اخر فصل الخريف ثم يترجح النهار قليلا قليلا ويتناقص الليل شيءا فشيءا حتي يعتدلا في اول فصل الربيع كما قدمنا، وهكذا في كل عام. ولهذا قال تعالي وله اختلاف الليل والنهار :  اي هو المتصرف في ذلك كله الحاكم الذي لا يخالف ولا يمانع ولهذا يقول في ثلاث ايات عند ذكر السموات والنجوم والليل والنهار ذلك تقدير العزيز العليم :  اي العزيز الذي قد قهر كل شء ودان له كل شء فلا يمانع ولا يغالب العليم بكل شء فقدر كل شء تقديرا علي نظام لا يختلف ولا يضطرب. وقد ثبت في الصحيحين من حديث سفيان بن عيينة عن الزهري عن سعيد بن المسيب عن ابي هريرة قال قال رسول الله صلي الله عليه وسلم «قال الله يءذيني ابن ادم يسب الدهر وانا الدهر بيدي الامر اقلب الليل والنهار» وفي رواية فانا الدهر اقلب ليله ونهاره قال العلماء كالشافعي وابي عبيد القاسم بن سلام وغيرهما يسب الدهر اي يقول فعل بنا الدهر كذا يا خيبة الدهر، ايتم الاولاد، ارمل النساء. قال الله تعالي (وانا الدهر) اي انا الدهر الذي يعنيه فانه فاعل ذلك الذي اسنده الي الدهر والدهر مخلوق، وانما فعل هذا هو الله فهو يسب فاعل ذلك ويعتقده الدهر. والله هو الفاعل لذلك الخالق لكل شء المتصرف في كل شء كما قال وانا الدهر بيدي الامر اقلب ليله ونهاره وكما قال تعالي قل اللهم مالك الملك تءتي الملك من تشاء وتنزع الملك ممن تشاء وتعز من تشاء وتذل من تشاء بيدك الخير انك علي كل شء قدير تولج الليل في النهار وتولج النهار في الليل وتخرج الحي من الميت وتخرج الميت من الحي وترزق من تشاء بغير حساب :   وقال تعالي هو الذي جعل الشمس ضياء والقمر نورا وقدره منازل لتعلموا عدد السنين والحساب. ما خلق الله ذلك الا بالحق. يفصل الايات لقوم يعلمون ان في اختلاف الليل والنهار وما خلق الله في السماوات والارض لايات لقوم يتقون :   اي فاوت بين الشمس والقمر في نورهما وفي شكلهما وفي وقتهما وفي سيرهما فجعل هذا ضياء وهو شعاع الشمس برهان ساطع وضوء باهر والقمر نورا اي اضعف من برهان الشمس وجعله مستفادا من ضوءها وقدره منازل اي يطلع اول ليلة من الشهر صغيرا ضءيلا قليل النور لقربه من الشمس وقلة مقابلته لها فبقدر مقابلته لها يكون نوره ولهذا في الليلة الثانية يكون ابعد منها بضعف ما كان في الليلة الاولي فيكون نوره بضعف النور اول ليلة ثم كلما بعد ازداد نوره حتي يتكامل ابداره ليلة 
 مقابلته اياها من المشرق وذلك ليلة اربع عشرة من الشهر ثم يشرع في النقص لاقترابه اليها من الجهة الاخري الي اخر الشهر فيستتر حتي يعود كما بدا في اول الشهر الثاني. فبه تعرف الشهور وبالشمس تعرف الليالي والايام وبذلك تعرف السنين والاعوام ولهذا قال تعالي هو الذي جعل الشمس ضياء والقمر نورا وقدره منازل لتعلموا عدد السنين والحساب :  وقال تعالي وجعلنا الليل والنهار ايتين فمحونا اية الليل وجعلنا اية النهار مبصرة لتبتغوا فضلا من ربكم ولتعلموا عدد السنين والحساب وكل شء فصلناه تفصيلا :  وقال تعالي يسءلونك عن الاهلة قل هي مواقيت للناس والحج :  وقد بسطنا القول علي هذا كله في التفسير. فالكواكب التي في السماء منها سيارات وهي المتحيرة في اصطلاح علماء التفسير وهو علم غالبه صحيح بخلاف علم الاحكام فان غالبه باطل ودعوي ما لا دليل عليه وهي سبعة. القمر في سماء الدنيا وعطارد في الثانية والزهرة في الثالثة والشمس في الرابعة والمريخ في الخامسة والمشتري في السادسة وزحل في السابعة. وبقية الكواكب يسمونها الثوابت وهي عندهم في الفلك الثامن وهو الكرسي في اصطلاح كثير من المتاخرين. وقال اخرون بل الكواكب كلها في السماء الدنيا ولا مانع من كون بعضها فوق بعض وقد يستدل علي هذا بقوله تعالي ولقد زينا السماء الدنيا بمصابيح وجعلناها رجوما للشياطين :  وبقوله فقضاهن سبع سماوات في يومين واوحي في كل سماء امرها وزينا السماء الدنيا بمصابيح وحفظا ذلك تقدير العزيز العليم :  فخص سماء الدنيا من بينهن بزينة الكواكب فان دل هذا علي كونها مرصعة فيها فذاك والا فلا مانع مما قاله الاخرون والله اعلم. وعندهم ان الافلاك السبعة بل الثمانية تدور بما فيها من الكواكب الثوابت والسيارات تدور علي خلاف فلكه من المغرب الي المشرق. فالقمر يقطع فلكه في شهر والشمس تقطع فلكها وهو الرابع في سنة. فاذا كان السيران ليس بينهما تفاوت وحركاتهما متقاربة كان قدر السماء الرابعة بقدر السماء الدنيا ثنتي عشرة مرة وزحل يقطع فلكه وهو السابع في ثلاثين سنة فعلي هذا يكون بقدر السماء الدنيا ثلاثماءة وستين مرة وقد تكلموا علي مقادير اجرام هذه الكواكب وسيرها وحركاتها وتوسعوا في هذه الاشياء حتي تعدوا الي علم الاحكام وما يترتب علي ذلك من الحوادث الارضية ومما لا علم لكثير منهم به. وقد كان اليونانيون الذين كانوا يسكنون الشام قبل زمن المسيح عليه السلام بدهور لهم في هذا كلام كثير يطول بسطه، وهم الذين بنوا مدينة دمشق وجعلوا لها ابوابا سبعة وجعلوا علي راس كل باب هيكلا علي صفة الكواكب السبعة. يعبدون كل واحد في هيكله، ويدعونه بدعاء ياثره عنهم غير واحد من اهل التواريخ وغيرهم. وذكره صاحب السر المكتوم في مخاطبة الشمس والقمر والنجوم 
 وغيره من علماء الحرنانيين [] (فلاسفة حران في قديم الزمان) . وقد كانوا مشركين يعبدون الكواكب السبعة وهم طاءفة من الصابءين ولهذا قال الله تعالي ومن اياته الليل والنهار والشمس والقمر لا تسجدوا للشمس ولا للقمر واسجدوا لله الذي خلقهن ان كنتم اياه تعبدون :  وقال تعالي اخبارا عن الهدهد انه قال لسليمان عليه السلام مخبرا عن بلقيس وجنودها ملكة سبا في اليمن وما والاها اني وجدت امراة تملكهم واوتيت من كل شء ولها عرش عظيم وجدتها وقومها يسجدون للشمس من دون الله وزين لهم الشيطان اعمالهم فصدهم عن السبيل فهم لا يهتدون. الا يسجدوا لله الذي يخرج الخبء في السماوات والارض ويعلم ما تخفون وما تعلنون. الله لا اله الا هو رب العرش العظيم :   وقال تعالي الم تر ان الله يسجد له من في السماوات ومن في الارض والشمس والقمر والنجوم والجبال والشجر والدواب وكثير من الناس وكثير حق عليه العذاب ومن يهن الله فما له من مكرم ان الله يفعل ما يشاء :  وقال تعالي اولم يروا الي ما خلق الله من شء يتفيءا ظلاله عن اليمين والشماءل سجدا لله وهم داخرون ولله يسجد ما في السماوات وما في الارض من دابة والملاءكة وهم لا يستكبرون يخافون ربهم من فوقهم ويفعلون ما يءمرون :   وقال تعالي ولله يسجد من في السماوات والارض طوعا وكرها وظلالهم بالغدو والاصال :  وقال تعالي تسبح له السماوات السبع والارض ومن فيهن وان من شء الا يسبح بحمده ولكن لا تفقهون تسبيحهم انه كان حليما غفورا :  والايات في هذا كثيرة جدا ولما كان اشرف الاجرام المشاهدة في السموات والارض هي الكواكب واشرفهن منظرا واشرفهن معتبرا الشمس والقمر استدل الخليل علي بطلان الهية شء منهن. وذلك في قوله تعالي فلما جن عليه الليل راي كوكبا قال هذا ربي فلما افل قال لا احب الافلين :  اي الغاءبين فلما راي القمر بازغا قال هذا ربي فلما افل قال لءن لم يهدني ربي لاكونن من القوم الضالين. فلما راي الشمس بازغة قال هذا ربي هذا اكبر فلما افلت قال يا قوم اني برء مما تشركون. اني وجهت وجهي للذي فطر السماوات والارض حنيفا وما انا من المشركين :   فبين بطريق البرهان القطعي ان هذه الاجرام المشاهدات من الكواكب والقمر والشمس لا يصلح شء منها للالهية لانها كلها مخلوقة مربوبة مدبرة مسخرة في سيرها لا تحيد عما خلقت له ولا تزيغ عنه الا بتقدير متقن محرر لا تضطرب ولا تختلف __________ [] قال في معجم البلدان (حران) بتشديد الراء واخره نون يجوز ان يكون (فعالا) من حرن الفرس اذا لم ينقد ويجوز ان يكون (فعلان) من الحر. يقال رجل حران اي عطشان واصله من الحر وامراة حري وهو حران يران. والنسبة اليها حرناني بعد الراء الساكنة نون علي غير قياس كما قالوا مناني في النسبة الي ماني. والقياس مانوي وحراني والعامة عليهما (محمود الامام) . 
 وذلك دليل علي كونها مربوبة مصنوعة مسخرة مقهورة ولهذا قال تعالي ومن اياته الليل والنهار والشمس والقمر لا تسجدوا للشمس ولا للقمر واسجدوا لله الذي خلقهن ان كنتم اياه تعبدون :  وثبت في الصحيحين في صلاة الكسوف من حديث ابن عمر وابن عباس وعاءشة وغيرهم من الصحابة ان رسول الله صلي الله عليه وسلم قال في خطبته يومءذ ان الشمس والقمر ايتان من ايات الله عز وجل وانهما لا ينكسفان لموت احد ولا لحياته» . وقال البخاري في بدء الخلق حدثنا مسدد حدثنا عبد العزيز بن المختار حدثنا عبد الله الداناج حدثني ابو سلمة عن ابي هريرة عن النبي صلي الله عليه وسلم قال الشمس والقمر مكوران يوم القيامة انفرد به البخاري وقد رواه الحافظ ابو بكر البزار بابسط من هذا السياق، فقال حدثنا ابراهيم بن زياد البغدادي حدثنا يونس بن محمد حدثنا عبد العزيز بن المختار عن عبد الله الداناج سمعت ابا سلمة بن عبد الرحمن زمن خالد بن عبد الله القسري في هذا المسجد مسجد الكوفة وجاء الحسن فجلس اليه فحدث قال حدثنا ابو هريرة ان رسول الله صلي الله عليه وسلم قال «ان الشمس والقمر ثوران في النار يوم القيامة فقال الحسن وما دينهما فقال احدثك عن رسول الله صلي الله عليه وسلم وتقول وما دينهما ثم قال البزار لا يروي عن ابي هريرة الا من هذا الوجه ولم يرو عبد الله الداناج عن ابي سلمة سوي هذا الحديث وروي الحافظ ابو يعلي الموصلي من طريق يزيد الرقاشي وهو ضعيف عن انس قال قال رسول الله صلي الله عليه وسلم الشمس والقمر ثوران عقيران في النار. وقال ابن ابي حاتم حدثنا ابو سعيد الاشج وعمر بن عبد الله الازدي حدثنا ابو اسامة عن مجالد عن شيخ من بجيلة عن ابن عباس اذا الشمس كورت : . قال يكور الله الشمس والقمر والنجوم يوم القيامة في البحر ويبعث الله ريحا دبورا فتضرمها نارا. فدلت هذه الاثار علي ان الشمس والقمر من مخلوقات الله خلقها الله لما اراد ثم يفعل فيها ما يشاء، وله الحجة الدافعة والحكمة البالغة فلا يسال عما يفعل لعلمه وحكمته وقدرته ومشيءته النافذة وحكمه الذي لا يرد ولا يمانع ولا يغالب وما احسن ما اورده الامام محمد بن اسحاق بن يسار في اول كتاب السيرة من الشعر لزيد بن عمرو بن نفيل في خلق السماء والارض والشمس والقمر وغير ذلك قال ابن هشام هي لامية ابن ابي الصلت الي الله اهدي مدحتي وثناءيا ... وقولا رضيا [] لا يني الدهر باقيا الي الملك الاعلي الذي ليس فوقه ... اله ولا رب يكون مدانيا الا ايها الانسان اياك والردي ... فانك لا تخفي من الله خافيا واياك لا تجعل مع الله غيره ... فان سبيل الرشد اصبح باديا __________ [] قوله رضيا نعت لقولا وفي نسخة رصينا والرصين الثابت (محمود الامام) . 
 حنانيك ان الجن كانت رجاءهم ... وانت الهي ربنا ورجاءيا رضيت بك اللهم ربا فلن اري ... ادين الها غيرك الله ثانيا وانت الذي من فضل من ورحمة ... بعثت الي موسي رسولا مناديا فقلت له اذهب وهارون فادعوا ... الي الله فرعون الذي كان طاغيا وقولا له اانت سويت هذه ... بلا وتد حتي اطمانت كما هيا وقولا له اانت رفعت هذه ... بلا عمد ارفق اذا بك بانيا وقولا له انت سويت وسطها ... منيرا اذا ما جنه الليل هاديا وقولا له من يرسل الشمس غدوة ... فيصبح ما مست من الارض ضاحيا وقولا له من ينبت الحب في الثري ... فيصبح منه البقل يهتز رابيا ويخرج منه حبه في رءوسه ... وفي ذاك ايات لمن كان واعيا وانت بفضل منك نجيت يونسا ... وقد بات في اضعاف حوت لياليا واني لو سبحت باسمك ربنا ... لاكثر الا ما غفرت خطاءيا [] فرب الق سيبا ورحمة ... علي وبارك في بني وماليا فاذا علم هذا فالكواكب التي في السماء من الثوابت والسيارات الجميع مخلوقة خلقها الله تعالي كما قال واوحي في كل سماء امرها وزينا السماء الدنيا بمصابيح وحفظا ذلك تقدير العزيز العليم :  واما ما يذكره كثير من المفسرين في قصة هاروت وماروت من ان الزهرة كانت امراة فراوداها علي نفسها فابت الا ان يعلماها الاسم الاعظم فعلماها فقالته فرفعت كوكبا الي السماء فهذا اظنه من وضع الاسراءيليين وان كان قد اخرجه كعب الاحبار وتلقاه عنه طاءفة من السلف فذكروه علي سبيل الحكاية والتحديث عن بني اسراءيل. وقد روي الامام احمد وابن حبان في صحيحه في ذلك حديثا رواه احمد عن يحيي ابن بكير عن زهير بن محمد عن موسي بن جبير عن نافع عن ابن عمر عن النبي صلي الله عليه وسلم وذكر القصة بطولها وفيه فمثلت لهما الزهرة امراة من احسن البشر فجاءتهما فسالاها نفسها وذكر القصة. وقد رواه عبد الرزاق في تفسيره عن الثوري عن موسي بن عقبة عن سالم عن كعب __________ [] قوله واني ولو سبحت الخ معني البيت اني لاكثر من هذا الدعاء الذي هو باسمك ربنا الا ما غفرت الخ. وما بعد الا زاءدة. وان سبحت اعتراض بين اسم ان وخبرها كما تقول اني لاكثر من هذا الدعاء الذي هو باسمك ربنا الا والله يغفر لي فعل كذا والتسبيح هنا بمعني الصلاة اي لا اعتمد وان صليت الاعلي دعاءك واستغفارك من خطاياي (محمود الامام) . 
 الاحبار به. وهذا اصح واثبت. وقد روي الحاكم في مستدركه وابن ابي حاتم في تفسيره عن ابن عباس فذكره وقال فيه وفي ذلك الزمان امراة حسنها في النساء كحسن الزهرة في ساءر الكواكب وذكر تمامه وهذا احسن لفظ روي في هذه القصة والله اعلم وهكذا الحديث الذي رواه الحافظ ابو بكر البزار حدثنا محمد بن عبد الملك الواسطي حدثنا يزيد ابن هارون حدثنا مبشر بن عبيد عن يزيد بن اسلم عن ابن عمر عن النبي صلي الله عليه وسلم. وحدثنا عمرو بن عيسي حدثنا عبد الاعلي حدثنا ابراهيم بن يزيد عن عمرو بن دينار عن ابن عمر ان رسول الله صلي الله عليه وسلم ذكر سهيلا فقال كان عشارا ظلوما فمسخه الله شهابا ثم قال لم يروه عن زيد بن اسلم الا مبشر بن عبيد وهو ضعيف الحديث ولا عن عمرو بن دينار الا ابراهيم بن يزيد وهو لين الحديث وانما ذكرناه علي ما فيه من علة لانا لم نحفظه الا من هذين الوجهين (قلت) اما مبشر بن عبيد القرشي فهو ابو حفص الحمصي واصله من الكوفة. فقد ضعفه الجميع وقال فيه الامام احمد والدارقطني كان يضع الحديث ويكذب واما ابراهيم بن يزيد فهو الخوزي وهو ضعيف باتفاقهم قال فيه احمد والنساءي متروك. وقال ابن معين ليس بثقة وليس بشء وقال البخاري سكتوا عنه. وقال ابو حاتم وابو زرعة منكر الحديث ضعيف الحديث. ومثل هذا الاسناد لا يثبت به شء بالكلية. واذا احسنا الظن قلنا هذا من اخبار بني اسراءيل كما تقدم من رواية بن عمر عن كعب الاحبار. ويكون من خرافاتهم التي لا يعول عليها والله اعلم
  AUT الكلام علي المجرة وقوس قزح
 قال ابو القاسم الطبراني حدثنا علي بن عبد العزيز حدثنا عارم ابو النعمان حدثنا ابو عوانة عن ابي بشر عن سعيد ابن جبير عن ابن عباس ان هرقل كتب الي معاوية وقال ان كان بقي فيهم شء من النبوة فسيخبرني عما اسالهم عنه. قال فكتب اليه يساله عن المجرة وعن القوس وعن بقعة لم تصبها الشمس الا ساعة واجدة قال فلما اتي معاوية الكتاب والرسول قال ان هذا الشء ما كنت ابه له ان اسال عنه الي يومي هذا من لهذا؟ قيل ابن عباس فطوي معاوية كتاب هرقل فبعث به الي ابن عباس فكتب اليه «ان القوس امان لاهل الارض من الغرق. والمجرة باب السماء الذي تنشق منه الارض. واما البقعة التي لم تصبها الشمس الا ساعة من النهار فالبحر الذي افرج عن بني اسراءيل وهذا اسناد صحيح الي ابن عباس رضي الله عنه فاما الحديث الذي رواه الطبراني حدثنا ابو الزنباع روح بن الفرج 
 حدثنا ابراهيم بن مخلد حدثنا الفضل بن المختار عن محمد بن مسلم الطاءفي عن ابن ابي يحيي [] عن مجاهد عن جابر بن عبد الله قال قال رسول الله صلي الله عليه وسلم «يا معاذ اني مرسلك الي قوم اهل كتاب فاذا سءلت عن المجرة التي في السماء فقل هي لعاب حية تحت العرش» فانه حديث منكر جدا بل الاشبه انه موضوع وراويه الفضل بن المختار هذا ابو سهل البصري ثم انتقل الي مصر قال فيه ابو حاتم الرازي هو مجهول حدث بالاباطيل. وقال الحافظ ابو الفتح الازدي منكر الحديث جدا. وقال ابن عدي لا يتابع علي احاديثه لا متنا ولا اسنادا وقال الله تعالي هو الذي يريكم البرق خوفا وطمعا وينشء السحاب الثقال ويسبح الرعد بحمده والملاءكة من خيفته ويرسل الصواعق فيصيب بها من يشاء وهم يجادلون في الله وهو شديد المحال :   وقال تعالي ان في خلق السماوات والارض واختلاف الليل والنهار والفلك التي تجري في البحر بما ينفع الناس وما انزل الله من السماء من ماء فاحيا به الارض بعد موتها وبث فيها من كل دابة وتصريف الرياح والسحاب المسخر بين السماء والارض لايات لقوم يعقلون :  وروي الامام احمد عن يزيد بن هارون عن ابراهيم بن سعد عن ابيه عن شيخ من بني غفار قال سمعت رسول الله صلي الله عليه وسلم يقول ان الله ينشء السحاب فينطق احسن النطق ويضحك احسن الضحك وروي موسي بن عبيدة بن سعد بن ابراهيم انه قال ان نطقه الرعد وضحكه البرق. وقال ابن ابي حاتم حدثنا ابي حدثنا هشام عن عبيد الله الرازي عن محمد بن مسلم قال بلغنا ان البرق ملك له اربعة وجوه وجه انسان ووجه ثور ووجه نسر ووجه اسد فاذا مصع بذنبه فذاك البرق وقد روي الامام احمد والترمذي والنساءي والبخاري في كتاب الادب والحاكم في مستدركه من حديث الحجاج بن ارطاة حدثني ابن مطر عن سالم عن ابيه قال كان رسول الله اذا سمع الرعد والصواعق قال اللهم لا تقتلنا بغضبك ولا تهلكنا بعذابك وعافنا قبل ذلك وروي ابن جرير من حديث ليث عن رجل عن ابي هريرة رفعه كان اذا سمع الرعد قال سبحان من يسبح الرعد بحمده وعن علي انه كان يقول سبحان من سبحت له وكذا عن ابن عباس والاسود بن يزيد وطاوس وغيرهم وروي مالك عن عبد الله ابن عمر انه كان اذا سمع الرعد ترك الحديث وقال سبحان من يسبح الرعد بحمده والملاءكة من خيفته ويقول (ان هذا وعيد شديد لاهل الارض وروي الامام احمد عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال قال ربكم لو ان عبيدي اطاعوني لاسقيتهم المطر بالليل واطلعت عليهم الشمس بالنهار ولما اسمعتهم صوت الرعد فاذكروا الله فانه لا يصيب ذاكرا وكل هذا مبسوط في التفسير ولله الحمد والمنة __________ [] قوله ابن ابي يحي المعروف من شيوخه انه يحي بن يحي. 

  AUT باب ذكر خلق الملاءكة وصفاتهم عليهم السلام
 قال الله تعالي وقالوا اتخذ الرحمن ولدا سبحانه بل عباد مكرمون لا يسبقونه بالقول وهم بامره يعملون. يعلم ما بين ايديهم وما خلفهم ولا يشفعون الا لمن ارتضي وهم من خشيته مشفقون ومن يقل منهم اني اله من دونه فذلك نجزيه جهنم كذلك نجزي الظالمين :   وقال تعالي تكاد السماوات يتفطرن من فوقهن والملاءكة يسبحون بحمد ربهم ويستغفرون لمن في الارض الا ان الله هو الغفور الرحيم :  وقال تعالي الذين يحملون العرش ومن حوله يسبحون بحمد ربهم ويءمنون به ويستغفرون للذين امنوا ربنا وسعت كل شء رحمة وعلما فاغفر للذين تابوا واتبعوا سبيلك وقهم عذاب الجحيم ربنا وادخلهم جنات عدن التي وعدتهم ومن صلح من اباءهم وازواجهم وذرياتهم انك انت العزيز الحكيم :   وقال تعالي فان استكبروا فالذين عند ربك يسبحون له بالليل والنهار وهم لا يسامون :  وقال ومن عنده لا يستكبرون. عن عبادته ولا يستحسرون يسبحون الليل والنهار لا يفترون :   وقال تعالي وما منا الا له مقام معلوم. وانا لنحن الصافون وانا لنحن المسبحون :   وقال تعالي وما نتنزل الا بامر ربك له ما بين ايدينا وما خلفنا وما بين ذلك وما كان ربك نسيا :  وقال تعالي وان عليكم لحافظين كراما كاتبين يعلمون ما تفعلون :   وقال تعالي وما يعلم جنود ربك الا هو :  وقال تعالي والملاءكة يدخلون عليهم من كل باب سلام عليكم بما صبرتم فنعم عقبي الدار :   وقال تعالي الحمد لله فاطر السماوات والارض جاعل الملاءكة رسلا اولي اجنحة مثني وثلاث ورباع يزيد في الخلق ما يشاء ان الله علي كل شء قدير :  وقال تعالي يوم تشقق السماء بالغمام ونزل الملاءكة تنزيلا الملك يومءذ الحق للرحمن وكان يوما علي الكافرين عسيرا :   وقال تعالي وقال الذين لا يرجون لقاءنا لولا انزل علينا الملاءكة او نري ربنا لقد استكبروا في انفسهم وعتوا عتوا كبيرا يوم يرون الملاءكة لا بشري يومءذ للمجرمين ويقولون حجرا محجورا :   وقال تعالي من كان عدوا لله وملاءكته ورسله وجبريل وميكال فان الله عدو للكافرين :  وقال تعالي يا ايها الذين امنوا قوا انفسكم واهليكم نارا وقودها الناس والحجارة عليها ملاءكة غلاظ شداد لا يعصون الله ما امرهم ويفعلون ما يءمرون :  والايات في ذكر الملاءكة كثيرة جدا يصفهم تعالي بالقوة في العبادة وفي الخلق وحسن المنظر وعظمة الاشكال وقوة الشكل في الصور المتعددة كما قال تعالي ولما جاءت رسلنا لوطا سء بهم وضاق بهم ذرعا وقال هذا يوم عصيب وجاءه قومه يهرعون اليه ومن قبل كانوا يعملون السيءات :   الايات فذكرنا في التفسير ما ذكره غير واحد من العلماء من ان الملاءكة تبدو لهم في صورة شباب حسان امتحانا واختبارا حتي قامت علي قوم لوط الحجة واخذهم الله اخذ عزيز مقتدر وكذلك كان جبريل ياتي الي 
 النبي صلي الله عليه وسلم في صفات متعددة فتارة ياتي في صورة دحية بن خليفة الكلبي وتارة في صورة اعرابي وتارة في صورته التي خلق عليها. له ستماءة جناح ما بين كل جناحين كما بين المشرق والمغرب كما راه علي هذه الصفة مرتين. مرة منهبطا من السماء الي الارض. وتارة عند سدرة المنتهي عندها جنة الماوي. وهو قوله تعالي علمه شديد القوي. ذو مرة فاستوي. وهو بالافق الاعلي. ثم دنا فتدلي :   اي جبريل كما ذكرناه عن غير واحد من الصحابة منهم ابن مسعود وابو هريرة وابو ذر وعاءشة فكان قاب قوسين او ادني. فاوحي الي عبده ما اوحي :   اي الي عبد الله محمد صلي الله عليه وسلم ثم قال ولقد راه نزلة اخري. عند سدرة المنتهي. عندها جنة الماوي. اذ يغشي السدرة ما يغشي. ما زاغ البصر وما طغي :   وقد ذكرنا في احاديث الاسراء في سورة سبحان ان سدرة المنتهي في السماء السابعة وفي رواية في السادسة اي اصلها وفروعها في السابعة فلما غشيها من امر الله ما غشيها قيل غشيها نور الرب جل جلاله وقيل غشيها فراش من ذهب وقيل غشيها الوان متعددة كثيرة غير منحصرة وقيل غشيها الملاءكة مثل الغربان وقيل غشيها من نور الله تعالي فلا يستطيع احد ان ينعتها اي من حسنها وبهاءها. ولا منافاة بين هذه الاقوال اذ الجميع ممكن حصوله في حال واحدة وذكرنا ان رسول الله صلي الله عليه وسلم قال. ثم رفعت لي سدرة المنتهي فاذا نبقها كالقلال وفي رواية كقلال هجر واذا ورقها كاذان الفيلة واذا يخرج من اصلها نهران باطنان ونهران ظاهران. فاما الباطنان ففي الجنة. واما الظاهران فالنيل والفرات وتقدم الكلام علي هذا في ذكر خلق الارض وما فيها من البحار والانهار وفيه ثم رفع لي البيت المعمور واذا هو يدخله في كل يوم سبعون الف مالك ثم لا يعودون اليه اخر ما عليهم وذكر انه وجد ابراهيم الخليل عليه السلام مستندا ظهره الي البيت المعمور. وذكرنا وجه المناسبة في هذا ان البيت المعمور هو في السماء السابعة بمنزلة الكعبة في الارض وقد روي سفيان الثوري وشعبة وابو الاحوص عن سماك بن حرب عن خالد بن عرعرة ان ابن الكواء سال علي بن ابي طالب عن البيت المعمور فقال هو مسجد في السماء يقال له الضراح، وهو بحيال الكعبة من فوقها. حرمته في السماء كحرمة البيت في الارض يصلي فيه كل يوم سبعون الفا من الملاءكة لا يعودون اليه ابدا وهكذا روي علي بن ربيعة وابو الطفيل عن علي مثله وقال الطبراني انبانا الحسن بن علويه القطان حدثنا اسماعيل بن عيسي العطار حدثنا اسحاق بن بشر ابو حذيفة حدثنا ابن جريج عن صفوان بن سليم عن كريب عن ابن عباس قال قال رسول الله صلي الله عليه وسلم البيت المعمور في السماء يقال له الضراح وهو علي مثل البيت الحرام بحياله لو سقط لسقط عليه يدخله كل يوم سبعون الف ملك ثم لا يرونه قط فان له في السماء حرمة علي قدر حرمة مكة. يعني في الارض وهكذا قال العوفي عن ابن عباس ومجاهد وعكرمة والربيع بن انس والسدي وغير واحد وقال قتادة ذكر لنا ان رسول الله صلي الله عليه وسلم قال 
 يوما لاصحابه هل تدرون ما البيت المعمور قالوا الله ورسوله اعلم قال قال مسجد في السماء بحيال الكعبة لو خر لخر عليها يصلي فيه كل يوم سبعون الف ملك اذا خرجوا منه لم يعودوا اخر ما عليهم وزعم الضحاك انه تعمره طاءفة من الملاءكة يقال لهم الجن من قبيلة ابليس لعنه الله كان يقول سدنته وخدامه منهم والله اعلم وقال اخرون. في كل سماء بيت يعمره ملاءكته بالعبادة فيه ويفدون اليه بالنوبة والبدل كما يعمر اهل الارض البيت العتيق بالحج في كل عام والاعتمار في كل وقت والطواف والصلاة في كل ان قال سعيد بن يحيي بن سعيد الاموي في اواءل كتابه المغازي حدثنا ابو عبيد في حديث مجاهد «ان الحرم حرم مناه (يعني قدره) من السموات السبع والارضين السبع وانه رابع اربعة عشر بيتا في كل سماء بيت وفي كل ارض بيت لو سقطت سقط بعضها علي بعض» ثم روي مجاهد قال مناه اي مقابله وهو حرف مقصور. ثم قال حدثنا ابو معاوية حدثنا الاعمش عن ابي سليمان مءذن الحجاج سمعت عبد الله بن عمرو يقول «ان الحرم محرم في السموات السبع مقداره من الارض وان بيت المقدس مقدس في السموات السبع مقداره من الارض كما قال بعض الشعراء ان الذي سمك السماء بني لها ... بيتا دعاءمه اشد واطول واسم البيت الذي في السماء بيت العزة واسم الملك الذي هو مقدم الملاءكة فيها اسماعيل فعلي هذا يكون السبعون الفا من الملاءكة الذين يدخلون في كل يوم الي البيت المعمور ثم لا يعودون اليه. اخر ما عليهم (اي لا يحصل لهم نوبة فيه الي اخر الدهر) يكونون من سكان السماء السابعة وحدها. ولهذا قال تعالي وما يعلم جنود ربك الا هو :  وقال الامام احمد حدثنا اسود بن عامر حدثنا اسراءيل عن ابراهيم بن مهاجر عن مجاهد عن مورق عن ابي ذر قال قال رسول الله صلي الله عليه وسلم «اني اري ما لا ترون واسمع ما لا تسمعون اطت السماء وحق لها ان تءط ما فيها موضع اربع اصابع الا عليه ملك ساجد لو علمتم ما اعلم لضحكتم قليلا ولبكيتم كثيرا ولما تلذذتم بالنساء علي الفرشات ولخرجتم الي الصعدات تجارون الي الله عز وجل» فقال ابو ذر (والله لوددت اني شجرة تعضد) ورواه الترمذي وابن ماجه من حديث اسراءيل فقال الترمذي حسن غريب ويروي عن ابي ذر موقوفا وقال الحافظ ابو القاسم الطبراني حدثنا حسين بن عرفة المصري حدثنا عروة بن عمران الرقي حدثنا عبيد الله بن عمرو عن عبد الكريم ابن مالك عن عطاء بن ابي رباح عن جابر بن عبد الله قال قال رسول الله صلي الله عليه وسلم ما في السموات السبع موضع قدم ولا شبر ولا كف الا وفيه ملك قاءم او ملك ساجد او ملك راكع فاذا كان يوم القيامة قالوا جميعا ما عبدناك حق عبادتك الا انا لا نشرك بك شيءا فدل هذان الحديثان علي انه ما من موضع في السموات السبع الا وهو مشغول بالملاءكة وهم في صنوف من العبادة. منهم من هو قاءم ابدا. ومنهم 
 من هو راكع ابدا ومنهم من هو ساجد ابدا ومنهم من هو في صنوف اخر والله اعلم بها. وهم داءمون في عبادتهم وتسبيحهم واذكارهم واعمالهم التي امرهم الله بها، ولهم منازل عند ربهم كما قال تعالي وما منا الا له مقام معلوم وانا لنحن الصافون وانا لنحن المسبحون :   وقال صلي الله عليه وسلم الا تصفون كما تصف الملاءكة عند ربها قالوا وكيف يصفون عند ربهم قال يكملون الصف الاول ويتراصون في الصف وقال فضلنا علي الناس بثلاث جعلت لنا الارض مسجدا وتربتها لنا طهورا وجعلت صفوفنا كصفوف الملاءكة وكذلك ياتون يوم القيامة بين يدي الرب جل جلاله صفوفا كما قال تعالي وجاء ربك والملك صفا صفا :  ويقفون صفوفا بين يدي ربهم عز وجل يوم القيامة كما قال تعالي يوم يقوم الروح والملاءكة صفا لا يتكلمون الا من اذن له الرحمن وقال صوابا :  والمراد بالروح هاهنا بنو ادم قاله ابن عباس والحسن وقتادة وقيل ضرب من الملاءكة يشبهون بني ادم في الشكل قاله ابن عباس ومجاهد وابو صالح والاعمش وقيل جبريل قاله الشعبي وسعيد بن جبير والضحاك وقيل ملك يقال له الروح بقدر جميع المخلوقات قال علي بن ابي طلحة عن ابن عباس قوله يوم يقوم الروح قال هو ملك من اعظم الملاءكة خلقا وقال ابن جرير حدثني محمد بن خلف العسقلاني حدثنا داود ابن الجراح عن ابي حمزة عن الشعبي عن علقمة عن ابن مسعود قال الروح في السماء الرابعة هو اعظم السموات والجبال ومن الملاءكة يسبح كل يوم اثني عشر الف تسبيحة يخلق الله من كل تسبيحة ملكا من الملاءكة يحيي يوم القيامة صفا وحده وهذا غريب جدا وقال الطبراني حدثنا محمد بن عبد الله بن عبد الحكيم المصري حدثنا ابن وهب بن رزق ابو هبيرة حدثنا بشر بن بكر حدثنا الاوزاعي حدثني عطاء عن عبد الله بن عباس قال سمعت رسول الله صلي الله عليه وسلم يقول «ان لله ملكا لو قيل له التقم السموات والارضين بلقمة واحدة لفعل. تسبيحه سبحانك حيث كنت» وهذا ايضا حديث غريب جدا وقد يكون موقوفا وذكرنا في صفة حملة العرش عن جابر بن عبد الله قال رسول الله صلي الله عليه وسلم «اذن لي ان احدث عن ملك من ملاءكة الله من حملة العرش ان ما بين شحمة اذنه الي عاتقه مسيرة سبعماءة عام» رواه ابو داود وابن ابي حاتم ولفظه مخفق الطير سبعماءة عام وقد ورد في صفة جبريل عليه السلام امر عظيم قال الله تعالي علمه شديد القوي :  قالوا كان من شدة قوته انه رفع مداءن قوم لوط وكن سبعا بمن فيها من الامم وكانوا قريبا من اربعماءة الف وما معهم من الدواب والحيوانات وما لتلك المدن من الاراضي والمعتملات والعمارات وغير ذلك رفع ذلك كله علي طرف جناحه حتي بلغ بهن عنان السماء حتي سمعت الملاءكة نباح الكلاب وصياح ديكتهم ثم قلبها فجعل عاليها سافلها فهذا هو شديد القوي. وقوله ذو مرة اي خلق حسن وبهاء وسناء كما قال في الاية الاخري انه لقول رسول كريم :  اي جبريل رسول من الله كريم اي حسن المنظر 
 ذي قوة اي له قوة وباس شديد عند ذي العرش مكين اي له مكانة ومنزلة عالية رفيعة عند الله ذي العرش المجيد مطاع ثم اي مطاع في الملا الاعلي امين اي ذي امانة عظيمة ولهذا كان هو السفير بين الله وبين انبياءه عليهم السلام الذي ينزل عليهم بالوحي. فيه الاخبار الصادقة والشراءع العادلة وقد كان ياتي الي رسول الله صلي الله عليه وسلم وينزل عليه في صفات متعددة كما قدمنا. وقد راه علي صفته التي خلقه الله عليها مرتين له ستماءة جناح كما روي البخاري عن طلق بن غنام عن زاءدة الشيباني قال سالت زرا عن قوله فكان قاب قوسين او ادني فاوحي الي عبده ما اوحي قال حدثنا عبد الله يعني ابن مسعود ان محمدا صلي الله عليه وسلم راي جبريل له ستماءة جناح وقال الامام احمد حدثنا يحيي ابن ادم حدثنا شريك عن جامع بن راشد عن ابي واءل عن عبد الله قال راي رسول الله صلي الله عليه وسلم جبريل في صورته وله ستماءة جناح كل جناح منها قد سد الافق يسقط من جناحه التهاويل [] من الدر والياقوت ما الله به عليم. وقال احمد ايضا حدثنا حسن بن موسي حدثنا حماد بن سلمة عن عاصم بن بهدلة عن زر بن حبيش عن ابن مسعود في هذه الاية ولقد راه نزلة اخري عند سدرة المنتهي :   قال قال رسول الله صلي الله عليه وسلم رايت جبريل وله ستماءة جناح ينتشر من ريشه التهاويل الدر والياقوت وقال احمد حدثنا زيد بن الحباب حدثنا الحسين [] حدثني عاصم ابن بهدلة سمعت شقيق بن سلمة يقول سمعت ابن مسعود يقول قال رسول الله صلي الله عليه وسلم وسلم رايت جبريل علي السدرة المنتهي وله ستماءة جناح فسالت عاصما عن الاجنحة فابي ان يخبرني قال فاخبرني بعض اصحابه ان الجناح ما بين المشرق والمغرب وهذه اسانيد جيدة قوية انفرد بها احمد وقال احمد حدثنا زيد بن الحباب حدثني حسين حدثني حصين حدثني شقيق سمعت ابن مسعود قال قال رسول الله صلي الله عليه وسلم اتاني جبريل في خضر [] تعلق به الدر اسناده صحيح وقال ابن جرير حدثنا ابن بزيع البغدادي قال حدثنا اسحاق بن منصور قال حدثنا اسراءيل عن ابي اسحاق عن عبد الرحمن ابن يزيد عن عبد الله (ما كذب الفءاد ما راي) قال راي رسول الله صلي الله عليه وسلم جبريل عليه حلتا رفرف قد ملا ما بين السماء والارض اسناد جيد قوي وفي الصحيحين من حديث عامر الشعبي عن مسروق قال كنت عند عاءشة فقلت اليس الله يقول «ولقد راه بالافق المبين :  ولقد راه نزلة اخري : » فقالت انا اول هذه الامة سال رسول الله صلي الله عليه وسلم عنها فقال انما ذاك جبريل لم يره في صورته التي خلق عليها الا مرتين __________ [] قوله التهاويل اي الاشياء المختلفة الالوان والرواية علي ما في النهاية راي جبريل ينتشر من جناحه الدر والتهاويل [] قوله الحسين هو ابن واقد مولي عبد الله بن عامر بن كريز ابو عبد الله المروزي قاضيها انتهي [] قوله في خضر بفتح فكسر لباس اخضر والضمير في به لخضر محمود الامام. 
 راه منهبطا من السماء الي الارض سادا عظم خلقه ما بين السماء والارض وقال البخاري حدثنا ابو نعيم حدثنا عمر بن ذر (ح) وحدثني يحيي بن جعفر حدثنا وكيع عن عمر ابن ذر عن ابيه عن سعيد بن جبير عن ابن عباس قال قال رسول الله صلي الله عليه وسلم لجبريل الا تزورنا اكثر مما تزورنا قال فنزلت وما نتنزل الا بامر ربك له ما بين ايدينا وما خلفنا :  الاية وروي البخاري من حديث الزهري عن عبيد الله بن عبد الله عن ابن عباس قال كان رسول الله صلي الله عليه وسلم اجود الناس وكان اجود ما يكون في رمضان حين يلقاه جبريل وكان يلقاه في كل ليلة من رمضان فيدارسه القران فلرسول الله صلي الله عليه وسلم اجود بالخير من الريح المرسلة وقال البخاري [] حدثنا قتيبة حدثنا الليث عن ابن شهاب ان عمر بن عبد العزيز اخر العصر شيءا فقال له عروة اما ان جبريل قد نزل فصلي امام رسول الله صلي الله عليه وسلم فقال عمر اعلم ما تقول يا عروة قال سمعت بشير بن ابي مسعود يقول سمعت ابا مسعود يقول سمعت رسول الله صلي الله عليه وسلم يقول نزل جبريل فامني فصليت معه ثم صليت معه ثم صليت معه ثم صليت معه ثم صليت معه يحسب باصابعه خمس صلوات ومن صفة اسرافيل عليه السلام وهو احد حملة العرش وهو الذي ينفخ في الصور بامر ربه نفخات ثلاثة اولاهن نفخة الفزع والثانية نفخة الصعق والثالثة نفخة البعث كما سياتي بيانه في موضعه من كتابنا هذا بحول الله وقوته وحسن توفيقه والصور قرن ينفخ فيه. كل دارة منه كما بين السماء والارض. وفيه موضع ارواح العباد حين يامره الله بالنفخ للبعث فاذا نفخ تخرج الارواح تتوهج فيقول الرب جل جلاله وعزتي وجلالي لترجعن كل روح الي البدن الذي كانت تعمره في الدنيا فتدخل علي الاجساد في قبورها فتدب فيها كما يدب السم في اللديغ فتحيي الاجساد وتنشق عنهم الاجداث فيخرجون منها سراعا الي مقام المحشر كما سياتي تفصيله في موضعه ولهذا قال رسول الله صلي الله عليه وسلم «كيف انعم وصاحب القرن قد التقم القرن وحني جبهته وانتظر ان يءذن له قالوا كيف نقول يا رسول الله قال قولوا حسبنا الله ونعم الوكيل : . علي الله توكلنا رواه احمد والترمذي من حديث عطية العوفي عن ابي سعيد الخدري وقال الامام احمد حدثنا ابو معاوية حدثنا الاعمش عن سعد الطاءي عن عطية العوفي عن ابي سعيد قال ذكر رسول الله صلي الله عليه وسلم صاحب الصور فقال عن يمينه جبريل وعن يساره ميكاءيل عليهم السلام. وقال الحافظ ابو القاسم الطبراني حدثنا محمد بن عبد الله الحضرمي حدثنا محمد بن عمر ان ابن ابي ليلي حدثني عن ابي ليلي عن الحكم عن مقسم عن ابن عباس قال بينا رسول الله صلي الله عليه وسلم ومعه جبريل بناحية اذا انشق افق السماء فاقبل __________ [] في كتاب بدء الخلق (محمود الامام) . 
 اسرافيل يدنو من الارض ويتمايل فاذا ملك قد مثل بين يدي النبي صلي الله عليه وسلم فقال يا محمد ان الله يامرك ان تختار بين نبي عبد او ملك نبي قال فاشار جبريل الي بيده (ان تواضع) فعرفت انه لي ناصح فقلت عبد نبي فعرج ذلك الملك الي السماء فقلت يا جبريل قد كنت اردت ان اسالك عن هذا فرايت من حالك ما شغلني عن المسالة فمن هذا يا جبريل؟ فقال هذا اسرافيل عليه السلام خلقه الله يوم خلقه بين يديه صافا قدميه لا يرفع طرفه بينه وبين الرب سبعون نورا ما منها من نور يكاد يدنو منه الا احترق بين يديه لوح فاذا اذن الله في شء من السماء او في الارض ارتفع ذلك اللوح فضرب جبهته فينظر فان كان من عملي امرني به وان كان من عمل ميكاءيل امره به وان كان من عمل ملك الموت امره به قلت يا جبريل وعلي اي شء انت قال علي الريح والجنود قلت وعلي اي شء ميكاءيل قال علي النبات والقطر قلت وعلي اي شء ملك الموت قال علي قبض الانفس وما ظننت انه نزل الا لقيام الساعة وما الذي رايت مني الا خوفا من قيام الساعة هذا حديث غريب من هذا الوجه وفي صحيح مسلم عن عاءشة ان رسول الله صلي الله عليه وسلم كان اذا قام من الليل يصلي يقول اللهم رب جبريل وميكاءيل واسرافيل فاطر السموات والارض عالم الغيب والشهادة انت تحكم بين عبادك فيما كانوا فيه يختلفون اهدني لما اختلف فيه من الحق باذنك انك تهدي من تشاء الي صراط مستقيم وفي حديث الصور ان اسرافيل اول من يبعثه الله بعد الصعق لينفخ في الصور وذكر محمد بن الحسن النقاش ان اسرافيل اول من سجد من الملاءكة فجوزي بولاية اللوح المحفوظ حكاه ابو القاسم السهيلي في كتابه (التعريف والاعلام. بما ابهم في القران من الاعلام) وقال تعالي من كان عدوا لله وملاءكته ورسله وجبريل وميكال :  عطفهما علي الملاءكة لشرفهما فجبريل ملك عظيم قد تقدم ذكره واما ميكاءيل فموكل بالقطر والنبات وهو ذو مكانة من ربه عز وجل ومن اشراف الملاءكة المقربين وقد قال الامام احمد حدثنا ابو اليمان حدثا ابن عباس عن عمارة بن غزنة الانصاري انه سمع حميد بن عبيد مولي بني المعلي يقول سمعت ثابتا البناني يحدث عن انس بن مالك عن رسول الله صلي الله عليه وسلم انه قال لجبريل ما لي لم ار ميكاءيل ضاحكا قط فقال ما ضحك ميكاءيل منذ خلقت النار فهءلاء الملاءكة المصرح بذكرهم في القران وفي الصحاح هم المذكورون في الدعاء النبوي «اللهم رب جبريل وميكاءيل واسرافيل فجبريل ينزل بالهدي علي الرسل لتبليغ الامم. وميكاءيل موكل بالقطر والنبات اللذين يخلق منهما الارزاق في هذه الدار وله اعوان يفعلون ما يامرهم به بامر ربه. يصرفون الرياح والسحاب كما يشاء الرب جل جلاله. وقد روينا انه ما من قطرة تنزل من السماء الا ومعها ملك يقررها في موضعها من الارض «واسرافيل موكل بالنفخ في الصور للقيام من القبور. والحضور يوم البعث والنشور ليفوز الشكور. ويجازي الكفور. فذاك ذنبه مغفور. وسعيه مشكور وهذا قد صار عمله كالهباء المنثور. وهو يدعو بالويل والثبور «فجبريل عليه السلام 
 يحصل بما ينزل به الهدي وميكاءيل يحصل بما هو موكل به الرزق. واسرافيل يحصل بما هو موكل به النصر والجزاء واما ملك الموت فليس بمصرح باسمه في القران ولا في الاحاديث الصحاح. وقد جاء تسميته في بعض الاثار بعزراءيل والله اعلم وقد قال الله تعالي قل يتوفاكم ملك الموت الذي وكل بكم ثم الي ربكم ترجعون :  وله اعوان يستخرجون روح العبد من جثته حتي تبلغ الحلقوم فيتناولها ملك الموت بيده فاذا اخذها لم يدعوها في يده طرفة عين حتي ياخذوها منه فيلقوها في اكفان تليق بها كما قد بسط عند قوله «يثبت الله الذين امنوا بالقول الثابت في الحياة الدنيا وفي الاخرة» :  ثم يصعدون بها فان كانت صالحة فتحت لها ابواب السماء والا غلقت دونها والقي بها الي الارض قال الله تعالي وهو القاهر فوق عباده ويرسل عليكم حفظة حتي اذا جاء احدكم الموت توفته رسلنا وهم لا يفرطون ثم ردوا الي الله مولاهم الحق الا له الحكم وهو اسرع الحاسبين :   وعن ابن عباس ومجاهد وغير واحد انهم قالوا ان الارض بين يدي ملك الموت مثل الطست يتناول منها حيث يشاء وقد ذكرنا ان ملاءكة الموت ياتون الانسان علي حسب عمله ان كان مءمنا اتاه ملاءكة بيض الوجوه بيض الثياب طيبة الارواح. وان كان كافرا فبالضد من ذلك عياذا بالله العظيم من ذلك وقد قال ابن ابي حاتم حدثنا ابي حدثنا يحيي بن ابي يحيي المقري حدثنا عمرو بن شمر قال سمعت جعفر بن محمد قال سمعت ابي يقول نظر رسول الله صلي الله عليه وسلم الي ملك الموت عند راس رجل من الانصار فقال له النبي صلي الله عليه وسلم يا ملك الموت ارفق بصاحبي فانه مءمن فقال ملك الموت يا محمد طب نفسا وقر عينا فاني بكل مءمن رفيق واعلم ان ما في الارض بيت مدر ولا شعر في بر ولا بحر الا وانا اتفحصهم في كل يوم خمس مرات حتي اني اعرف بصغيرهم وكبيرهم بانفسهم والله يا محمد لو اني اردت ان اقبض روح بعوضة ما قدرت علي ذلك حتي يكون الله هو الامر بقبضها. قال جعفر بن محمد ابي هو الصادق بلغني بتفحصهم عند مواقيت الصلاة فاذا حضر عند الموت فاذا كان ممن يحافظ علي الصلاة دنا منه الملك ودفع عنه الشيطان ولقنه الملك (لا اله الا الله محمد رسول الله) في تلك الحال العظيمة. هذا حديث مرسل وفيه نظر وذكرنا في حديث الصور من طريق اسماعيل بن رافع المدني القاص عن محمد بن زياد عن محمد بن كعب القرظي عن ابي هريرة عن رسول الله صلي الله عليه وسلم (الحديث) بطوله. وفيه ويامر الله اسرافيل بنفخة الصعق فينفخ نفحة الصعق فيصعق اهل السموات واهل الارض الا من شاء الله فاذا هم قد خمدوا جاء ملك الموت الي الجبار عز وجل فيقول يا رب قد مات اهل السموات والارض الا من شءت فيقول الله وهو اعلم بمن بقي (فمن بقي) فيقول بقيت انت الحي الذي لا يموت وبقيت حملة عرشك وبقي جبريل وميكاءيل فيقول ليمت جبريل وميكاءيل فينطق الله العرش فيقول يا رب يموت جبريل 
 وميكاءيل فيقول اسكت فاني كتبت الموت علي كل من كان تحت عرشي فيموتان «ثم ياتي ملك الموت الي الجبار عز وجل فيقول يا رب قد مات جبريل وميكاءيل فيقول الله وهو اعلم بمن بقي فمن بقي؟ فيقول بقيت انت الحي الذي لا يموت وبقيت حملة عرشك وبقيت انا فيقول الله لتمت حملة عرشي. فتموت. ويامر الله العرش فيقبض الصور من اسرافيل ثم ياتي ملك الموت فيقول يا رب قد مات حملت عرشك فيقول الله وهو اعلم بمن بقي (فمن بقي) فيقول بقيت انت الحي الذي لا يموت وبقيت انا فيقول الله انت خلق من خلقي خلقتك لما اردت فمت فيموت فاذا لم يبق الا الله الواحد القهار الاحد الصمد الذي لم يلد ولم يولد ولم يكن له كفوا احد :   كان اخرا كما كان اولا وذكر تمام الحديث بطوله رواه الطبراني وابن جرير والبيهقي ورواه الحافظ ابو موسي المديني في كتاب (الطوالات) [] وعنده زيادة غريبة وهي قوله فيقول الله له انت خلق من خلقي خلقتك لما اردت فمت موتا لا تحيي بعده ابداه ومن الملاءكة المنصوص علي اسماءهم في القران هاروت وماروت في قول جماعة كثيرة من السلف وقد ورد في قصتهما وما كان من امرهما اثار كثيرة غالبها اسراءيليات وروي الامام احمد حديثا مرفوعا عن ابن عمر وصححه ابن حبان في تقاسيمه. وفي صحته عندي نظر والاشبه انه موقوف علي عبد الله بن عمر ويكون مما تلقاه عن كعب الاحبار كما سياتي بيانه والله اعلم وفيه انه تمثلت لهما الزهرة امراة من احسن البشر وعن علي وابن عباس وابن عمر ايضا ان الزهرة كانت امراة وانهما لما طلبا منها ما ذكر ابت الا ان يعلماها الاسم الاعظم فعلماها فقالته فارتفعت الي السماء فصارت كوكبا وروي الحاكم في مستدركه عن ابن عباس قال وفي ذلك الزمان امراة حسنها في النساء كحسن الزهرة في ساءر الكواكب. وهذا اللفظ احسن ما ورد في شان الزهرة ثم قيل كان امرهما وقصتهما في زمان ادريس وقيل في زمان سليمان بن داود كما حررنا ذلك في التفسير وبالجملة فهو خبر اسراءيلي مرجعه الي كعب الاحبار كما رواه عبد الرزاق في تفسيره عن الثوري عن موسي بن عقبة عن سالم عن ابن عمر عن كعب الاحبار بالقصة وهذا اصح اسنادا واثبت رجالا والله اعلم ثم قد قيل ان المراد بقوله وما انزل علي الملكين ببابل هاروت وماروت :  قبيلان من الجان قاله ابن حزم وهذا غريب وبعيد من اللفظ ومن الناس من قرا وما انزل علي الملكين بالكسر ويجعلهما علجين من اهل فارس. قاله الضحاك. ومن الناس من يقول هما ملكان من السماء ولكن __________ [] قال في كشف الظنون الطوالات للحافظ الكبير ابي موسي محمد بن ابي بكر عمر المديني المتوفي سنة  وهي في مجلدين. وفيها الواهي والموضوع (محمود الامام) 
 سبق في قدر الله لهما ما ذكره من امرهما ان صح به الخبر ويكون حكمهما كحكم ابليس ان قيل انه من الملاءكة لكن الصحيح انه من الجن كما سياتي تقريره ومن الملاءكة المسمين في الحديث منكر ونكير عليهما السلام. وقد استفاض في الاحاديث ذكرهما في سءال القبر. وقد اوردناها عند قوله تعالي يثبت الله الذين امنوا بالقول الثابت في الحياة الدنيا وفي الاخرة ويضل الله الظالمين ويفعل الله ما يشاء :  وهما فتانا القبر موكلان بسءال الميت في قبره عن ربه ودينه ونبيه ويمتحنان البر والفاجر وهما ازرقان افرقان لهما انياب واشكال مزعجة واصوات مفزعة اجارنا الله من عذاب القبر وثبتنا بالقول الثابت امين وقال البخاري حدثنا عبد الله بن يوسف حدثنا ابن وهب حدثني يونس عن ابن شهاب حدثني عروة ان عاءشة زوج النبي صلي الله عليه وسلم حدثته انها قالت للنبي صلي الله عليه وسلم (هل اتي عليك يوم كان اشد من يوم احد. قال لقد لقيت من قومك وكان اشد ما لقيت منهم يوم العقبة اذ عرضت نفسي علي ابن عبد ياليل بن عبد كلال فلم يجبني الي ما اردت فانطلقت وانا مهموم علي وجهي فلم استفق الا وانا بقرن الثعالب فرفعت راسي فاذا انا بسحابة قد اظلتني فنظرت فاذا فيها جبريل فناداني فقال ان الله قد سمع قول قومك لك وما ردوا به عليك وقد بعث لك ملك الجبال لتامره بما شءت فيهم فناداني ملك الجبال فسلم علي ثم قال يا محمد فقال ذلك فما شءت ان شءت ان اطبق عليهم الاخشبين فقال النبي صلي الله عليه وسلم بل ارجو ان يخرج الله من اصلابهم من يعبد الله وحده ولا يشرك به شيءا ورواه مسلم من حديث ابن وهب به
