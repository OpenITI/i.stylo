ما هلك ربيعة بن نصر رجع ملك اليمن كله الي حسان بن تبان اسعد ابي كرب وتبان اسعد تبع الاخر ابن كلكيكرب بن زيد وزيد تبع الاول بن عمرو ذي الاذعار بن ابرهة ذي المنار بن الراءش بن عدي بن صيفي بن سبا الاصغر بن كعب كهف الظلم بن زيد بن سهل بن عمرو بن قس بن معاوية بن جشم بن عبد شمس بن واءل بن الغوث بن قطن بن عريب بن زهير 
 ابن انس بن الهميسع بن العربحج والعربحج هو حمير بن سبا الاكبر بن يعرب بن يشجب بن قحطان. قال عبد الملك بن هشام سبا بن يشجب بن يعرب بن قحطان. قال ابن اسحاق وتبان اسعد ابو كرب هو الذي قدم المدينة وساق الحبرين من اليهود الي اليمن وعمر البيت الحرام وكساه وكان ملكه قبل ملك ربيعة بن نصر وكان قد جعل طريقه حين رجع من غزوة بلاد المشرق علي المدينة وكان قد مر بها في بداته فلم يهج اهلها وخلف بين اظهرهم ابنا له فقتل غيلة فقدمها وهو مجمع لاخرابها واستءصال اهلها وقطع نخلها فجمع له هذا الحي من الانصار ورءيسهم عمرو بن طلحة اخو بني النجار ثم احد بني عمرو بن مبذول واسم مبذول عامر بن مالك بن النجار واسم النجار تيم الله بن ثعلبة بن عمرو بن الخزرج بن حارثة بن ثعلبة عمرو بن عامر وقال ابن هشام عمرو بن طلحة هو عمرو بن معاوية بن عمرو بن عامر بن مالك بن النجار وطلة امه وهي بنت عامر بن زريق الخزرجية. قال ابن اسحاق وقد كان رجل من بني عدي بن النجار يقال له احمر عدا علي رجل من اصحاب تبع وجده يجد عذقا له فضربه بمنجله فقتله وقال انما التمر لمن ابره فزاد ذلك تبعا حنقا عليهم فاقتتلوا فتزعم الانصار انهم كانوا يقاتلونه بالنهار ويقرونه بالليل فيعجبه ذلك منهم ويقول والله ان قومنا لكرام وحكي ابن اسحاق عن الانصار ان تبعا انما كان حنقه علي اليهود انهم منعوهم منه. قال السهيلي ويقال انه انما جاء لنصرة الانصار ابناء عمه علي اليهود الذين نزلوا عندهم في المدينة علي شروط فلم يفوا بها واستطالوا عليهم والله اعلم. قال ابن اسحاق فبينا تبع علي ذلك من قتالهم اذ جاءه حبران من احبار اليهود من بني قريظة عالمان راسخان حين سمعا بما يريد من اهلاك المدينة واهلها فقالوا له ايها الملك لا تفعل فانك ان ابيت الا ما تريد حيل بينك وبينها ولم نامن عليك جل العقوبة فقال لهما ولم ذلك قالا هي مهاجر نبي يخرج من هذا الحرم من قريش في اخر الزمان تكون داره وقراره فتناهي وراي ان لهما علما واعجبه ما سمع منهما فانصرف عن المدينة واتبعهما علي دينهما. قال ابن اسحاق وكان تبع وقومه اصحاب اوثان يعبدونها فتوجه الي مكة وهي طريقه الي اليمن حتي اذا كان بين عسفان وامج اتاه نفر من هذيل ابن مدركة بن الياس بن مضر بن بزار بن معد بن عدنان فقالوا له ايها الملك الا ندلك علي بيت مال داثرا غفلته الملوك قبلك فيه اللءلء والزبرجد والياقوت والذهب والفضة قال بلي قالوا بيت بمكة يعبده اهله ويصلون عنده وانما اراد الهذليون هلاكه بذلك لما عرفوا من هلاك من اراده من الملوك وبغي عنده فلما اجمع لما قالوا ارسل الي الحبرين فسالهما عن ذلك فقالا له ما اراد القوم الا هلاكك وهلاك جندك ما نعلم بيتا لله عز وجل اتخذه في الارض لنفسه غيره ولءن فعلت ما دعوك اليه لتهلكن وليهلكن من معك جميعا قال 
 فماذا تامرانني ان اصنع اذا انا قدمت عليه قالا تصنع عنده ما يصنع اهله تطوف به وتعظمه وتكرمه وتحلق راسك عنده وتذلل له حتي تخرج من عنده قال فما يمنعكما انتما من ذلك قالا اما والله انه لبيت ابينا ابراهيم عليه السلام وانه لكما اخبرناك ولكن اهله حالوا بيننا وبينه بالاوثان التي نصبوها حوله وبالدماء التي يهريقون عنده وهم نجس اهل شرك او كما قالا له فعرف نصحهما وصدق حديثهما وقرب النفر من هذيل فقطع ايديهم وارجلهم ثم مضي حتي قدم مكة فطاف بالبيت ونحر عنده وحلق راسه واقام بمكة ستة ايام فيما يذكرون ينحر بها للناس ويطعم اهلها ويسقيهم العسل واري في المنام ان يكسوا البيت فكساء الخصف ثم اري في المنام ان يكسوه احسن من ذلك فكساء المعافر ثم اري ان يكسوء احسن من ذلك فكساء الملاء والوصاءل وكان تبع فيما يزعمون اول من كسا البيت واوصي به ولاته من جرهم وامرهم بتطهيره وان لا يقربوه دما ولا ميتة ولا مءلاة وهي المحايض وجعل له بابا ومفتاحا ففي ذلك قالت سبيعة بنت الاحب تذكر ابنها خالد بن عبد مناف بن كعب بن سعد بن تيم بن مرة بن كعب بن لءي بن غالب وتنهاه عن البغي بمكة وتذكر له ما كان من امر تبع فيها. ابني لا تظلم بمكة ... لا الصغير ولا الكبير واحفظ محارمها بني ... ولا يغرنك الغرور ابني من يظلم بمكة ... يلق اطراف الشرور ابني يضرب وجهه ... ويلج بخديه السعير ابني قد جربتها ... فوجدت ظالمها يبور الله امنها وما ... بنيت بعرصتها قصور والله امن طيرها ... والعصم تامن في ثبير ولقد غزاها تبع ... فكسا بنيتها الحبير واذل ربي ملكه ... فيها فاوفي بالنذور يمشي اليها حافيا ... بفناءها الفا بعير ويظل يطعم اهلها ... لحم المهاري والجزور يسقيهم العسل المصفي ... والرحيض من الشعير والفيل اهلك جيشه ... يرمون فيها بالصخور والملك في اقصي البلاد ... وفي الاعاجم والخزور فاسمع اذا حدثت وافهم ... كيف عاقبة الامور قال ابن اسحاق ثم خرج تبع متوجها الي اليمن بمن معه من الجنود وبالحبرين حتي اذا دخل اليمن 
 دعا قومه الي الدخول فيما دخل فيه فابوا عليه حتي يحاكموه الي النار التي كانت باليمن قال ابن اسحاق حدثني ابو مالك بن ثعلبة بن ابي مالك القرظي قال سمعت ابراهيم بن محمد بن طلحة بن عبيد الله يحدث ان تبعا لما دنا من اليمن ليدخلها حالت حمير بينه وبين ذلك وقالوا لا تدخلها علينا وقد فارقت ديننا فدعاهم الي دينه وقال انه خير من دينكم قالوا تحاكمنا الي النار قال نعم قال وكانت باليمن فيما يزعم اهل اليمن نار تحكم بينهم فيما يختلفون فيه تاخذ الظالم ولا تضر المظلوم فخرج قومه باوثانهم وما يتقربون به في دينهم وخرج الحبران بمصاحفهما في اعناقهما متقلديها حتي قعدوا للنار عند مخرجها الذي تخرج منه فخرجت النار اليهم فلما اقلبت نحوهم حادوا عنها وهابوها فزجرهم من حضرهم من الناس وامروهم بالصبر لها فصبروا حتي غشيتهم فاكلت الاوثان وما قربوا معها ومن حمل ذلك من رجال حمير وخرج الحبران بمصاحفهما في اعناقهما تعرق جباههما ولم تضرهما فاصفقت عند ذلك حمير علي دينهما فمن هنالك كان اصل اليهودية باليمن. قال ابن اسحاق وقد حدثني محدث ان الحبرين ومن خرج من حمير انما اتبعوا النار ليردوها وقالوا من ردها فهو اولي بالحق فدنا منها رجال حمير باوثانهم ليردوها فدنت منهم لتاكلهم فحادوا عنها ولم يستطيعوا ردها فدنا منها الحبران بعد ذلك وجعلا يتلوان التوراة وهي تنقص عنهما حتي رداها لي مخرجها الذي خرجت منه فاصفقت عند ذلك حمير علي دينهما والله اعلم اي ذلك كان. قال ابن اسحاق وكان رءام بيتا لهم يعظمونه وينحرون عنده ويكلمون فيه اذ كانوا علي شركهم فقال الحبران لتبع انما هو شيطان يفتنهم بذلك فخل بيننا وبينه قال فشانكما به فاستخرجا منه فيما يزعم اهل اليمن كلبا اسود فذبحاه ثم هدما ذلك البيت فبقاياه اليوم كما ذكر لي بها اثار الدماء التي كانت تهراق عليه وقد ذكرنا في التفسير الحديث الذي ورد عن النبي صلي الله عليه وسلم (لا تسبوا تبعا فانه قد كان اسلم) قال السهيلي وروي معمر عن همام بن منبه عن ابي هريرة ان رسول الله صلي الله عليه وسلم قال (لا تسبوا اسعد الحميري فانه اول من كسي الكعبة) . قال السهيلي وقد قال تبع حين اخبره الحبران عن رسول الله صلي الله عليه وسلم شعرا شهدت علي احمد انه ... رسول من الله باري النسم فلو مد عمري الي عمره ... لكنت وزيرا له وابن عم وجاهدت بالسيف اعداءه ... وفرجت عن صدره كل هم قال ولم يزل هذا الشعر تتوارثه الانصار ويحفظونه بينهم وكان عند ابي ايوب الانصاري رضي الله عنه وارضاه قال السهيلي وذكر ابن ابي الدنيا في كتاب القبور ان قبرا حفر بصنعاء فوجد فيه امراتان معهما لوح من فضة مكتوب بالذهب وفيه هذا قبر لميس وحبي ابنتي تبع ماتا وهما تشهد ان 
 لا اله الا الله وحده لا شريك له وعلي ذلك مات الصالحون قبلهما. ثم صار الملك فيما بعد الي حسان بن تبان اسعد وهو اخو اليمامة الزرقاء التي صلبت علي باب مدينة جو فسميت من يومءذ اليمامة. قال ابن اسحاق فلما ملك ابنه حسان بن ابي كرب تبان اسعد سار باهل اليمن يريد ان يطاء بهم ارض العرب وارض الاعاجم حتي اذا كانوا ببعض ارض العراق كرهت حمير وقباءل اليمن السير معه وارادوا الرجعة الي بلادهم واهليهم فكلموا اخا له يقال له عمرو وكان معه في جيشه فقالوا له اقتل اخاك حسان ونملكك علينا وترجع بنا الي بلادنا فاجابهم فاجتمعوا علي ذلك الا ذا رعين الحميري فانه نهي عمرا عن ذلك فلم يقبل منه فكتب ذو رعين رقعة فيها هذان البيتان: الا من يشتري سهرا بنوم ... سعيد من يبيت قرير عين فاما حمير غدرت وخانت ... فمعذرة الاله لذي رعين ثم استودعها عمرا. فلما قتل عمرو اخاه حسان ورجع الي اليمن منع منه النوم وسلط عليه السهر فسال الاطباء والحذاق من الكهان والعرافين عما به فقيل له انه والله ما قتل رجل اخاه قط او ذا رحم بغيا الا ذهب نومه وسلط عليه السهر فعند ذلك جعل يقتل كل من امره بقتل اخيه فلما خلص الي ذي رعين قال له ان لي عندك براءة قال وما هي قال الكتاب الذي دفعته اليك فاخرجه فاذا فيه البيتان فتركه وراي انه قد نصحه وهلك عمرو فمرج امر حمير عند ذلك وتفرقوا
  AUT وثوب لخنيعة [] ذي شناتر علي ملك اليمن
 وقد ملكها سبعا وعشرين سنة. قال ابن اسحاق فوثب عليهم رجل من حمير لم يكن من بيوت الملك يقال له لخنيعة ينوف ذو شناتر فقتل خيارهم وعبث ببيوت اهل المملكة منهم وكان مع ذلك امرا فاسقا يعمل عمل قوم لوط فكان يرسل الي الغلام من ابناء الملوك فيقع عليه في مشربة له قد صنعها لذلك لءلا يملك بعد ذلك ثم يطلع من شربته تلك الي حرسه ومن حضر من جنده قد اخذ مسواكا فجعله في فيه ليعلمهم انه قد فرغ منه حتي بعث الي زرعة ذي نواس بن تبان اسعد اخي حسان وكان صبيا صغيرا حين قتل اخوه حسان ثم شب غلاما جميلا وسيما ذا هيءة وعقل فلما اتاه رسوله عرف ما يريد منه فاخذ سكينا جديدا لطيفا فخباه بين قدميه ونعله ثم اتاه فلما خلا معه وثب اليه فواثبه ذو نواس فوجاه حتي قتله ثم حز راسه فوضعه في الكوة التي كان يشرف منها ووضع مسواكه في فيه ثم خرج علي الناس فقالوا له ذا نواس ارطب ام يباس فقال سل نحماس استرطبان ذو نواس استرطبان لا باس [] فنظروا الي الكوة __________ [] قوله لخنيعة بالنون وهو كذلك في سيرة ابن هشام والذي في مادة شنطرة من القاموس بالتاء المثناة من فوق [] قال ابو ذر الخشني قالوا في تفسير استرطبان ان معناه اخذته النار بالفارسية انتهي وقال السهيلي وقوله 
 فاذا راس لخنيعة مقطوع فخرجوا في اثر ذي نواس حتي ادركوه فقالوا ما ينبغي ان يملكنا غيرك اذ ارحتنا من هذا الخبيث فملكوه عليهم واجتمعت عليه حمير وقباءل اليمن فكان اخر ملوك حمير وتسمي يوسف فاقام في ملكه زمانا، وبنجران بقايا من اهل دين عيسي بن مريم عليه السلام علي الانجيل اهل فضل واستقامة من اهل دينهم لهم راس يقال له عبد الله بن الثامر. ثم ذكر ابن اسحاق سبب دخول اهل نجران في دين النصاري وان ذلك كان علي يدي رجل يقال له فيميون كان من عباد النصاري باطراف الشام وكان مجاب الدعوة وصحبه رجل يقال له صالح فكان يتعبدان يوم الاحد ويعمل فيميون بقية الجمعة في البناء وكان يدعوا للمرضي والزمني واهل العاهات فيشفون ثم استاسره وصاحبه بعض الاعراب فباعوهما بنجران فكان الذي اشتري فيميون يراه اذا قام في مصلاه بالبيت الذي هو فيه في الليل يمتلي عليه البيت نورا فاعجبه ذلك من امره وكان اهل نجران يعبدون نخلة طويلة يعلقون عليها حلي نساءهم ويعكفون عندها فقال فيميون لسيده ارايت ان دعوت الله علي هذه الشجرة فهلكت اتعلمون ان الذي انتم عليه باطل. قال نعم فجمع له اهل نجران وقام فيميون الي مصلاه فدعا الله عليها فارسل الله عليها قاصفا فجعفها من اصلها ورماها الي الارض فاتبعه اهل نجران علي دين النصرانية وحملهم علي شريعة الانجيل حتي حدثت فيهم الاحداث التي دخلت علي اهل دينهم بكل ارض فمن هنالك كانت النصرانية بنجران من ارض العرب ثم ذكر ابن اسحاق قصة عبد الله بن الثامر حين تنصر علي يدي فيميون وكيف قتله واصحابه ذو نواس وخد لهم الاخدود وقال ابن هشام وهو الحفر المستطيل في الارض مثل الخندق واجج فيه النار وحرقهم بها وقتل اخرين حتي قتل قريبا من عشرين الفا كما قدمنا ذلك مبسوطا في اخبار بني اسراءيل وكما هو مستقصي في تفسير سورة (والسماء ذات البروج) :  من كتابنا التفسير ولله الحمد.
