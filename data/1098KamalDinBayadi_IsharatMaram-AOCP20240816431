 بالنوم كالبقظة( ، فالقول بان الرءيا خيال باطا ، ظاهره عن التحقيق عاطا ، والتاويل بان المراد ان كون ما بتخيله الناس ادرا كا بالبصر رءبة ، وكون مايتخيله ادرا كا بانسمع سمعا باطل ، فلا ينافي حقته بمعني كونه امارة ليعة الاشياء لايقيد حمعة لا محدي في المقام تفعا ، اذ لم يقل احد بكون الرءيا ادرا كا بالحواس الظهرة حتي بنة
 الوجه الثاني : انه لو كان الكفر م ادا لله تعالي لكان فعله والانيان نه موافقة ذ اد الله ، فيكون طاعة مثابا به ، وانه باطل بالضرورة الدينية كما في المواتف ، ونشر الي جوابه بالمنع فيما قال (وقال في الفقه الابسط : ومن عمل بمشبءة الله تعالي وطاعته وم اء به) ن الطاعات (فقد عمل برضاه وعدله ومن عما بمشيءة الله وبغير ما امر نه) من المعاصي فلم يعمل برضاه لكن عمل بمعصبته ومعصيته عير رضاه! فاشار الي منع كون الانيان بالمراد مطلقا طاعة ، مستندا بان الطاعة موافقة الامر ، والامر غير الارادة كما مر ، والضاعة تدور مع الاعر ، علمت الارادة اولم تملم ؛ واليه اشار بعضف ماامر به علي الطعة علي



![image filename](./KamalDinBayyadi.UsulMunifa_V_.png)
 طريق التفسير ، فان الفعل لو وفع علي وفق ارادة المريد ولا شعور للفاعل بارادته لابعد منه طاعة له ، كيف والارادة كامنة والامر ظاهر ، ولذا بقنل عرقا قلان مطاع الامر ، ولا يقال مطاع الارادة وبينه بقوله (ويعذب الله العباد) العاصين الذين تعلق مشيءته تعالي بتعديهم (علي ما لارضي) من المعاصي (لانه تعد مهم علي الكفر ؛ حت كما ثبت عقلا وتقلا (والمعنصي) معلقا بمشيءته ، فيعذب من شاء بحقيقا لاوعيد والعدل، ويغفر لمن شاء بحقيتا للعفو والفضل كما ثبت نقلا (ولايرضي به) اي بذلك من الكقر والمعاصي (ولكن برصي ان يعدبهم وينتهم سهم بتركهم الطاعة) التي امروا بها ومخالفتهم لاعره تعالي (واخذهم بالمعصية) التي نهوا عنها ومخالفتهم لنهيه تعالي بصرفهم الاستطاعه والقدرة الي المعصية (ويعدبهم علي مايشاء) اي بخصص (لهم) «لانه بعدبهم علي الكفر وامعاصي وشاءها لهم» اي خعصها وقدرها عليهم لعلمه في الازل بانهم يختاروها فما لا يزال وفيه اشارات :
 الاولي : ان الارادة لاتستلزم الرضا وكذا المحية ، واليه اشار بقوله : «ومن عمل بمشبءة الله وبغير ما امر به فلم يعمل برضاه» فان الرضا برك الاعتراض علي الشء لارادة وفوعه ، والمحبة استحماده ، والارادة اعم كما اختاره عامة اهل السنه ، ودل عليه النصوص القرا نية ، وخالف فيه بعض الاشاعرة وبسب الي الاشعري اايضا؛ قال امام الحرمين في الارشاد : ان من حقق لم يكع عن تهويل المعيزلة ، وقال : المحبة تمعني الارادة وكذلك الرضا ، فالرب تعالي يحب الكفر ويرضاه كفرا معاقبا عليه . قال اين الهمام في المسايرة ، وهدا خلاف كلمة ا كثر اهل السنة.
 وخلاف النصوص القرا نيه ، قال الله تعالي : «ولا برضي لعباده الكفر » وقال : «والله لايحت الفساد» وقال: «انها لايحت المعتدين» وان كان لايلزمهم به ضرر في الاعتقاد اذا كان مناط العقاب مخالفة النهي ، ولو فزض متعلقه محبوبا .



![image filename](./KamalDinBayyadi.UsulMunifa_V_.png)

 الثانيه : ان مقارنة الارادة له في بعض الصور اتفافي ، واليه اشار بقوله : ومن عمل مشيءة الله وطاعته وبما امر به فقد عمل برضاه . قال الامام اين الهمام قد تتعلق الارادة بالحبوب المطلوب وجوده ، فتقارن الارادة المحبة في متعنقها اتفاقيا لالزوما ، فعن هذا وللغلبة ظن اللزوم وهو بعيد عن التامل : فكثيرا مابحد الانسان من نفسه ارادة ما بكره وجوده لامر ما ، ولو فرض ان ذلك لمصلحة احها كارادة الكي تداويا لم يخرجه عن كونه مكروها في نفسه ، وكذا لايريد وجود مايحبه ، وهو وان كان لضرر يلزم وجوده لايخرجه من كونه محبوبا في نفسه ، وانما يستلزم الارادة الاطلاق في وجود ما بكرهه .
 الثالثة : انه تعالي اطلق واجري وجود ما تكرهه في ملكه وهو الملك القهار ليتم وجه التكليف بلازميه ، وهما الثواب بالفعل والعقاب بالترك كما في المسايرة ، واليه اشار قوله : لانه بعدهم علي الكفر والمعاصي وشاء لهم .
 الوحه التالث : انه لايرضي اعباده الكفر بالنص والرضا هو الارادة
 والوجه الرابع( : انه لوكان الكفر مرادا لله تعالي نكان واقعابقضاءه، والرضا بالقضاء واحب اجماعا فكان الرضا بالكفر واحما واللازم باطل لان الرضا بالكفر كفر اجماعا كما في شرح المواقف ، واليه اشار الي جوابهما بالمنع في قوله فيه (ويعذب الكفار علي ارضي ان بخلق) فيهم من الكفر الذي اختاروه (لانه يعدمهم علي الكفر) لاختبارهم اياه وصرفهم القدرة اليه، ورضي ان بخلق الكفر فيهم مجازاة علي سوء اختيارهم ، اذ لولا رضاه بخلقه لما خلقه ، لانه غالب علي امره ، والرضا بنفس الخلق لايستلزم الرضا بالخلوق



