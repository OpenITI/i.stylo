 وهي مكية باجماعهم وقال مقاتل مكية غير اية سيهزم الجمع القمر  وحكي عنه انه قال الا ثلاث ايات اولها ام يقولون نحن جميع منتصر الي قوله وامر القمر   قال ابن عباس اجتمع المشركون الي رسول الله صلي الله عليه وسلم فقالوا ان كت صادقا فشق لنا القمر فرقتين فقال لهم رسول الله صلي الله عليه وسلم ان فعلت تءمنون قالوا نعم فسال رسول الله صلي الله عليه وسلم ربه ان يعطيه ما قالوا فانشق القمر فرقتين ورسول الله صلي الله عليه وسلم ينادي يا فلان يا فلان اشهدوا وذلك بمكة قبل الهجرة وقد روي البخاري ومسلم في صحيحيهما من حديث ابن مسعود قال انشق القمر علي عهد رسول الله صلي الله عليه وسلم شقتين فقال رسول الله صلي الله عليه وسلم  اشهدوا وقد روي حديث الانشقاق جماعة منهم عبد الله بن عمر وحذيفة وجبير بن مطعم وابن عباس وانس بن مالك وعلي هذا جميع المفسرين الا ان قوما شذوا فقالوا سينشق يوم القيامة وقد روي عثمان بن عطاء عن ابيه نحو ذلك وهذا القول الشاذ لا يقاوم الاجماع ولان قوله وانشق لفظ ماض وحمل لفظ الماضي علي المستقبل يفتقر الي قرينة تنقله ودليل وليس ذلك موجودا وفي قوله وان يروا اية يعرضوا دليل علي انه قد كان ذلك < <
  القمر : (  ) اقتربت الساعة وانشق . . . . .
 > > ومعني اقتربت دنت والساعة القيامة وقال الفراء فيه تقديم وتاخير تقديره انشق القمر واقتربت الساعة وقال مجاهد انشق القمر فصار فرقتين فثبتت فرقة وذهبت فرقة وراء الجبل وقال ابن زيد لما انشق القمر كان يري نصفه علي قعيقعان والنصف الاخر علي ابي قبيس قال ابن مسعود لما انشق القمر قالت قريش سحركم ابن ابي كبشة فاسالوا السفار فسالوهم فقالوا نعم قد رايناه فانزل الله عز وجل اقتربت الساعة وانشق القمر 
 < <
  القمر : (  ) وان يروا اية . . . . .
 > > قوله تعالي وان يروا اية اي اية تدلهم علي صدق الرسول والمراد بها ها هنا انشقاق القمر يعرضوا عن التصديق ويقولوا سحر مستمر فيه ثلاثة اقوال
 احدها ذاهب من قولهم مر الشء واستمر اذا ذهب قاله مجاهد وقتادة والكساءي والفراء فعلي هذا يكون المعني هذا سحر والسحر يذهب ولا يثبت
 والثاني شديد قوي قاله ابو العالية والضحاك وابن قتيبة قال وهو ماخوذ من المرة والمرة الفتل والثالث داءم حكاه الزجاج
 < <
  القمر : (  ) وكذبوا واتبعوا اهواءهم . . . . .
 > > قوله تعالي وكذبوا يعني كذبوا النبي صلي الله عليه وسلم وما عاينوا من قدرة الله تعالي واتبعوا اهواءهم ما زين لهم الشيطان وكل امر مستقر فيه ثلاثة اقوال
 احدها ان كل امر مستقر باهله فالخير يستقر باهل الخير والشر يستقر باهل الشر قاله قتادة
 والثاني لكل حديث منتهي وحقيقة قاله مقاتل
 والثالث ان قرار تكذيبهم مستقر وقرار تصديق المصدقين مستقر حتي يعلموا حقيقته بالثواب والعقاب قاله الفراء
 < <
  القمر : (  ) ولقد جاءهم من . . . . .
 > > قوله تعالي ولقد جاءهم يعني اهل مكة من الانباء اي من اخبار الامم المكذبة في القران ما فيه مزدجر قال ابن قتيبة اي متعظ ومنتهي
 < <
  القمر : (  ) حكمة بالغة فما . . . . .
 > > قوله تعالي حكمة بالغة قال الزجاج هي مرفوعة لانها بدل من  ما فالمعني ولقد جاءهم حكمة بالغة وان شءت رفعتهما باضمار هو حكمة بالغة وما في قوله فما تغن النذر جاءز ان يكون استفهاما بمعني التوبيخ فيكون المعني اي شء تغني النذر وجاءز ان يكون نفيا علي معني فليست تغني النذر قال المفسرون والمعني جاءهم القران وهو حكمة تامة قد بلغت الغاية فما تغني النذر اذا لم يءمنوا @QB@ فتول عنهم يوم يدع الداع الي شء نكر خشعا ابصارهم يخرجون من الاجداث كانهم جراد منتشر مهطعين الي الداع يقول الكافرون هذا يوم عسر @QE@
 < <
  القمر : (  ) فتول عنهم يوم . . . . .
 > > فتول عنهم قال الزجاج هذا وقف التمام ويوم منصوب بقوله يخرجون من الاجداث وقال مقاتل فتول عنهم الي يوم يدع الداعي اثبت هذه الياء في الحالين يعقوب وافقه ابو جعفر وابو عمرو في الوصل وحذفها الاكثرون في الحالين والداعي اسرافيل ينفخ النفخة الثانية الي شء نكر وقرا ابن كثير نكر خفيفة اي الي امر فظيع وقال مقاتل النكر بمعني المنكر وهو القيامة وانما ينكرونه اعظاما له والتولي المذكور في الاية منسوخ عند المفسرين باية السيف
 < <
  القمر : (  ) خشعا ابصارهم يخرجون . . . . .
 > > قوله تعالي خشعا ابصارهم قرا اهل الحجاز وابن عامر وعاصم خشعا بضم الخاء وتشديد الشين من غير الف وقرا ابو عمرو وحمزة والكساءي خاشعا بفتح الخاء والف بعدها وتخفيف الشين قال الزجاج المعني يخرجون خشعا وخاشعا منصوب علي الحال وقرا ابن مسعود خاشعة ولك في اسماء الفاعلين اذا تقدمت علي الجماعة التوحيد والتانيث  والجمع تقول مررت بشبان حسن اوجههم وحسان اوجههم وحسنة اوجههم قال الشاعر  وشباب حسن اوجههم   من اياد بن نزار بن معد  <
 >
 قال المفسرون والمعني ان ابصارهم ذليلة خاضعة عند رءية العذاب والاجداث القبور وانما شبههم بالجراد المنتشر لان الجراد لا جهة له يقصدها فهو ابدا مختلف بعضه في بعض فهم يخرجون فزعين ليس لاحد منهم جهة يقصدها والداعي اسرافيل وقد اثبت ياء الداعي في الحالين ابن كثير ويعقوب تابعهما في الوصل نافع وابو عمرو والباقون بحذفها في الحالين < <
  القمر : (  ) مهطعين الي الداع . . . . .
 > > وقد بينا معني مهطعين في سورة ابراهيم  والعسر الصعب الشديد
 @QB@ كذبت قبلهم قوم نوح فكذبوا عبدنا وقالوا مجنون وازدجر فدعا ربه اني مغلوب فانتصر ففتحنا ابواب السماء بماء منهمر وفجرنا الارض عيونا فالتقي الماء علي امر قد قدر وحملناه علي ذات الواح ودسر تجري باعيننا جزاء لمن كان كفر ولقد تركناها اية فهل من مدكر فكيف كان عذابي ونذر ولقد يسرنا القران للذكر فهل من مدكر كذبت عاد فكيف كان عذابي ونذر انا ارسلنا عليهم ريحا صرصرا في يوم نحس مستمر تنزع الناس كانهم اعجاز نخل منقعر فكيف كان عذابي ونذر ولقد يسرنا القران للذكر فهل من مدكر @QE@  < <
  القمر : (  ) كذبت قبلهم قوم . . . . .
 > > قوله تعالي كذبت قبلهم اي قبل اهل مكة قوم نوح فكذبوا عبدنا نوحا وقالوا مجنون وازدجر قال ابو عبيدة افتعل من زجر قال المفسرون زجروه عن مقالته < <
  القمر : (  ) فدعا ربه اني . . . . .
 > > فدعا عليهم نوح ربه ب اني مغلوب فانتصر اي فانتقم لي ممن كذبني قال الزجاج وقرا عيسي بن عمر النحوي اني بكسر الالف وفسرها سيبويه فقال هذا علي ارادة القول فالمعني قال اني مغلوب ومن فتح وهو الوجه فالمعني دعا ربه اني مغلوب
 < <
  القمر : (  ) ففتحنا ابواب السماء . . . . .
 > > قوله تعالي ففتحنا ابواب المساء قرا ابن عامر ففتحنا بالتشديد فاما المنهمر فقال ابن قتيبة هو الكثير السريع الانصباب ومنه يقال همر الرجل اذا اكثر من الكلام واسرع وروي علي رضي الله عنه ان ابواب السماء فتحت بالماء من المجرة وهي شرج السماء وعلي ما ذكرنا من القصة في هود  ان المطر جاءهم يكون هو المراد بقوله ففتحنا ابواب السماء قال المفسرون جاءهم الماء من فوقهم اربعين يوما وفجرت الارض من تحتهم عيونا اربعين يوما
 < <
  القمر : (  ) وفجرنا الارض عيونا . . . . .
 > > فالتقي الماء وقرا ابي بن كعب وابو رجاء وعاصم الجحدري الماءان بهمزة والف ونون مكسورة وقرا ابن مسعود المايان بياء والف ونون مكسورة من غير همز وقرا الحسن وابو عمران الماوان بواو والف وكسر النون قال الزجاج يعني بالماء ماء السماء وماء الارض ويجوز الماءان لان اسم الماء اسم يجمع ماء الارض وماء السماء
 قوله تعالي علي امر قد قدر فيه قولان
 احدهما كان قدر ماء السماء كقدر ماء الارض قاله مقاتل 
 والثاني قد قدر في اللوح المحفوظ قاله الزجاج فيكون المعني علي امر قد قضي عليهم وهو الغرق < <
  القمر : (  ) وحملناه علي ذات . . . . .
 > > قوله تعالي وحملناه يعني نوحا علي ذات الواح ودسر قال الزجاج اي علي سفينة ذات الواح قال المفسرون الواحها خشباتها العريضة التي منها جمعت وفي الدسر اربعة اقوال
 احدها انها المسامير رواه الوالبي عن ابن عباس وبه قال قتادة والقرظي وابن زيد وقال الزجاج الدسر المسامير والشرط التي تشد بها الالواح وكل شء نحو السمر او ادخال شء في شء بقوة وشدة قهر فهو دسر يقال دسرت المسمار ادسره وادسره والدسر واحدها دسار نحو حمار وحمر
 والثاني انه صدر السفينة سمي بذلك لانه يدسر الماء اي يدفعه رواه العوفي عن ابن عباس وبه قال الحسن وعكرمة ومنه الحديث في العنبر انه شء دسره البحر اي دفعه
 والثالث ان الدسر اضلاع السفينة قاله مجاهد
 والرابع ان الدسر طرفاها واصلها والالواح جانباها قاله الضحاك
 < <
  القمر : (  ) تجري باعيننا جزاء . . . . .
 > > قوله تعالي تجري باعيننا اي بمنظر ومراي منا جزاء قال الفراء فعلنا به وبهم ما فعلنا من انجاءه واغراقهم ثوابا لمن كفر به
 وفي المراد ب من ثلاثة اقوال
 احدها انه الله عز وجل وهو مذهب مجاهد فيكون المعني عوقبوا لله ولكفرهم به 
 والثاني انه نوح كفر به وجحد امره قاله الفراء
 والثالث ان من بمعني ما فالمعني جزاء لما كان كفر من نعم الله عند الذين اغرقهم حكاه ابن جرير وقرا قتادة لمن كان كفر بفتح الكاف والفاء
 < <
  القمر : (  ) ولقد تركناها اية . . . . .
 > > قوله تعالي ولقد تركناها في المشار اليها قولان
 احدهما انها السفينة قال قتادة ابقاها الله علي الجودي حتي ادركها اواءل هذه الامة
 والثاني انها الفعلة فالمعني تركنا هذه الفعلة وامر سفينة نوح اية اي علامة ليعتبر بها فهل من مدكر واصله مدتكر فابدلت التاء دالا علي ما بينا في قوله وادكر بعد امة يوسف  قال ابن قتيبة اصله مذتكر فادغمت التاء في الذال ثم قلبت دالا مشددة قال المفسرون والمعني هل من متذكر يعتبر بذلك < <
  القمر : (  ) فكيف كان عذابي . . . . .
 > > فكيف كان عذابي ونذر وفي هذه السورة ونذر ستة مواضع اثبت الياء فيهن في الحالين يعقوب تابعه في الوصل ورش والباقون بحذفها في الحالين وقوله فكيف كان عذابي استفهام عن تلك الحالة ومعناه التعظيم لذلك العذاب قال ابن قتيبة والنذر ها هنا جمع نذير وهو بمعني الانذار ومثله النكير بمعني الانكار قال المفسرون وهذا تخويف لمشركي مكة
 < <
  القمر : (  ) ولقد يسرنا القران . . . . .
 > > ولقد يسرنا القران اي سهلناه للذكر اي للحفظ والقراءة فهل من مدكر اي من ذاكر يذكره ويقرءه والمعني هو الحث علي  قراءته وتعلمه قال سعيد بن جبير ليس من كتب الله كتاب يقرا كله ظاهرا الا القران واما الريح الصرصر فقد ذكرناها في حم السجدة 
 < <
  القمر : (  ) انا ارسلنا عليهم . . . . .
 > > قوله تعالي في يوم نحس مستمر قرا الحسن في يوم بالتنوين علي ان اليوم منعوت بالنحس والمستمر الداءم الشءم استمر عليهم بنحوسه وقال ابن عباس كانوا يتشاءمون بذلك اليوم وقيل انه كان يوم اربعاء في اخر الشهر
 < <
  القمر : (  ) تنزع الناس كانهم . . . . .
 > > تنزع الناس اي تقلعهم من الارض من تحت اقدامهم فتصرعهم علي رقابهم فتدق رقابهم فتبين الراس عن الجسد ف كانهم اعجاز نخل وقرا ابي بن كعب وابن السميفع اعجز نخل برفع الجيم من غير الف بعد الجيم وقرا ابن مسعود وابو مجلز وابو عمران كانهم عجز نخل بضم العين والجيم ومعني الكلام كانهم اصول نخل منقعر اي منقلع وقال الفراء المنقعر المنصرع من النخل قال ابن قتيبة يقال قعرته فانقعر اي قلته فسقط قال ابو عبيدة والنخل يذكر ويءنث فهذه الاية علي لغة من ذكر وقوله اعجاز نخل خاوية الحاقة  علي  لغة من انث وقال مقاتل شبههم حين وقعوا من شدة العذاب بالنخل الساقطة التي لا رءوس لها وانما شبههم بالنخل لطولهم وكان طول كل واحد منهم اثني عشر ذراعا
 @QB@ كذبت ثمود بالنذر فقالوا ابشرا منا واحدا نتبعه انا اذا لفي ضلال وسعر اءلقي الذكر عليه من بيننا بل هو كذاب اشر سيعلمون غدا من الكذاب الاشر انا مرسلو الناقة فتنة لهم فارتقبهم واصطبر ونبءهم ان الماء قسمة بينهم كل شرب محتضر فنادوا صاحبهم فتعاطي فعقر فكيف كان عذابي ونذر انا ارسلنا عليهم صيحة واحدة فكانوا كهشيم المحتظر ولقد يسرنا القران للذكر فهل من مدكر @QE@
 < <
  القمر : (  ) كذبت ثمود بالنذر
 > > قوله تعالي كذبت ثمود بالنذر فيه قولان
 احدهما انه جمع نذير وقد بينا ان من كذب نبيا واحدا فقد كذب الكل
 والثاني ان النذر بمعني الانذار كما بينا في قوله فكيف كان عذابي ونذر فكانهم كذبوا الانذار الذي جاءهم به صالح < <
  القمر : (  ) فقالوا ابشرا منا . . . . .
 > > قالوا ابشرا منا قال الزجاج هو منصوب بفعل مضمر والذي ظهر تفسيره المعني انتبع بشرا منا واحدا قال المفسرون قالوا هو ادمي مثلنا وهو واحد فلا نكون له تبعا انا اذا ان فعلنا ذلك لفي ضلال اي خطا وذهاب عن الصواب وسعر قال ابن عباس اي جنون قال ابن قتيبة هو من تسعرت النار اذا التهبت يقال ناقة مسعورة اي كانها مجنونة من النشاط وقال غيره لفي شقاء وعناء لاجل ما يلزمنا من طاعته 
 ثم انكروا ان يكون الوحي ياتيه فقالوا < <
  القمر : (  ) اءلقي الذكر عليه . . . . .
 > > االقي الذكر اي انزل الوحي عليه من بيننا اي كيف خص من بيننا بالنبوة والوحي بل هو كذاب اشر وفيه قولان
 احدهما انه المرح المتكبر قاله ابن قتيبة
 والثاني البطر قاله الزجاج
 < <
  القمر : (  ) سيعلمون غدا من . . . . .
 > > قوله تعالي سيعلمون غدا قرا ابن عامر وحمزة ستعلمون بالتاء غدا فيه قولان
 احدهما يوم القيام قاله ابن الساءب
 والثاني عند نزول العذاب بهم قاله مقاتل
 < <
  القمر : (  ) انا مرسلو الناقة . . . . .
 > > قوله تعالي انا مرسلو الناقة وذلك انهم سالوا صالحا ان يظهر لهم ناقة من صخرة فقال الله تعالي انا مرسلو الناقة اي مخرجوها كما ارادوا فتنة لهم اي محنة واختبارا فارتقبهم اي فانتظر ما هم صانعون واصطبر علي ما يصيبك من الاذي < <
  القمر : (  ) ونبءهم ان الماء . . . . .
 > > ونبءهم ان الماء قسمة بينهم اي بين ثمود وبين الناقة يوم لها ويوم لهم فذلك قوله كل شرب محتضر يحضره صاحبه ويستحقه
